# CrossEngin .gitignore
# NOVA compiles to native x86-64; the launcher emits intermediate .s/.o to a
# temp dir and links a binary. We keep source only; build artifacts stay out.

# Build output
/bin/
*.o
*.bin
*.out
# Per-scenario driver build logs (test harness artifacts)
**/_scenario_*_drivers/*_build.log
# NOVA emits assembly when building to a file; never commit generated asm.
/build/
*.s
!boot/*.s          # (none here, but never ignore a hand-written bootstrap if added)

# NOVA package manager local cache
/nova_packages/

# Local runtime / persistence artifacts produced by the agent at run time
/var/
*.cesnap          # CrossEngin substrate snapshots (ADR-0048)
*.celog           # CrossEngin decision-log files (ADR-0043)

# Editor / OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store

# Scratch
/tmp/
/scratch/

# Python compile cache
__pycache__/
*.pyc

# built example binaries
examples/crossengin_chat
