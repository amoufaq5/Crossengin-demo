// CrossEngin scenario_ff legacy-load driver.
//
// Purpose
//   Confirms forward compatibility: a v2 snapshot WITHOUT the new
//   `episodic.atoms.*` sub-block still parses cleanly and rehydrates to
//   3 sub-lists (the third one empty). The path comes from the
//   CE_EPI_LEGACY_SNAP env var.

import "std/syscall"
import "std/string"
import "std/io"
import "../src/persistence/snapshot_disk.nova"
import "../src/persistence/snapshot_reader.nova"

fn _resolve_path() {
    let env = getenv("CE_EPI_LEGACY_SNAP")
    if env == 0 { return "/tmp/ce_int_scenario_ff_legacy.snap" }
    if len(env) == 0 { return "/tmp/ce_int_scenario_ff_legacy.snap" }
    return env
}

fn main() {
    let path = _resolve_path()
    let s = snap_load(path)
    if s == 0 {
        io_println("legacy_load=0")
        exit(1)
    }
    io_println("legacy_load=1")
    io_println("legacy_ver=" + int_to_str(snap_version(s)))
    let eb = snap_section(s, SEC_EPISODIC)
    io_println("legacy_sublists=" + int_to_str(len(eb)))
    if len(eb) >= 3 {
        io_println("legacy_atoms_records=" + int_to_str(len(eb[2])))
    }
    exit(0)
}

main()
