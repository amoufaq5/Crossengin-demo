// CrossEngin episodic-memory consolidation demo / scenario_ff driver.
//
// Purpose
//   One-shot driver that exercises src/kg/episodic.nova: capture 5
//   (1,2,3) triplets into the moment stream, run the consolidation
//   pass, and persist the resulting episodic atom through the v2
//   snapshot format (ADR-0048). Stdout reports each step's result so
//   the shell scenario can assert on the values.
//
//   Paths via env vars (CE_EPI_DEMO_SNAP) -- same convention as
//   migrate_snap.nova (NOVA doesn't expose argc/argv to programs).
//
// NOVA dependencies: builtins + io (plus std/syscall + std/string,
// pulled in because snapshot_disk uses both -- without the explicit
// imports the runtime entrypoint can segfault before main() runs,
// same workaround as examples/migrate_snap.nova). CrossEngin
// dependencies: src/kg/episodic.nova, src/persistence/snapshot_disk.nova,
// src/persistence/snapshot_reader.nova.

import "std/syscall"
import "std/string"
import "std/io"
import "../src/kg/episodic.nova"
import "../src/persistence/snapshot_disk.nova"
import "../src/persistence/snapshot_reader.nova"

fn capture(stream, ts, a, b, c) {
    let m = ms_capture(stream, ts, MODALITY_TEXT, "x", 600, 0)
    moment_add_trace(m, a)
    moment_add_trace(m, b)
    moment_add_trace(m, c)
    return m
}

fn _path_default() { return "/tmp/ce_int_scenario_ff.snap" }

fn _resolve_path() {
    let env = getenv("CE_EPI_DEMO_SNAP")
    if env == 0 { return _path_default() }
    if len(env) == 0 { return _path_default() }
    return env
}

fn main() {
    let path = _resolve_path()
    let stream = ms_new()
    let em = em_new()
    let eas = episodic_atoms_new()

    let i = 0
    while i < 5 {
        capture(stream, i * 10, 1, 2, 3)
        em_record(em, i, 600, i * 10)
        i = i + 1
    }
    let minted = episodic_consolidate(eas, stream, 0, 0)
    io_println("minted=" + int_to_str(minted))
    io_println("atoms_count=" + int_to_str(episodic_atoms_count(eas)))

    let s = snap_new(1, 1700000000)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 0)
    push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    let eb = episodic_section_build_with_atoms(stream, em, eas)
    snap_put_section(s, SEC_EPISODIC, eb)

    let ok = snap_save(s, path)
    io_println("save_ok=" + int_to_str(ok))

    let s2 = snap_load(path)
    if s2 == 0 {
        io_println("reload_ok=0")
        exit(1)
    }
    io_println("reload_ok=1")
    io_println("reload_ver=" + int_to_str(snap_version(s2)))

    let eb2 = snap_section(s2, SEC_EPISODIC)
    io_println("reload_sublists=" + int_to_str(len(eb2)))
    if len(eb2) >= 3 {
        io_println("reload_atoms_records=" + int_to_str(len(eb2[2])))
    }

    let stream2 = ms_new()
    let em2 = em_new()
    let eas2 = episodic_atoms_new()
    episodic_section_apply_with_atoms(stream2, em2, eas2, eb2)
    io_println("reload_atoms=" + int_to_str(episodic_atoms_count(eas2)))

    let ep = episodic_atoms_get(eas2, 0)
    io_println("reload_member_count=" + int_to_str(len(episodic_atom_members(ep))))
    io_println("reload_first_ns=" + int_to_str(episodic_atom_first_seen(ep)))
    io_println("reload_last_ns=" + int_to_str(episodic_atom_last_seen(ep)))
    io_println("reload_count=" + int_to_str(episodic_atom_count(ep)))
    io_println("reload_alpha=" + int_to_str(episodic_atom_alpha(ep)))
    io_println("reload_beta=" + int_to_str(episodic_atom_beta(ep)))
    exit(0)
}

main()
