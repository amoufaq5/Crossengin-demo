// CrossEngin /communities scenario driver (R11F).
//
// Purpose
//   Stand-alone driver for the R11F label-propagation community
//   detection in src/kg/graph_clustering.nova. Builds a synthetic KG
//   with TWO disjoint 4-cliques connected by a single bridge edge
//   (the "barbell" graph: a canonical LPA / modularity benchmark) and
//   runs gc_label_propagation + gc_modularity + gc_communities_cmd on
//   it. Stdout carries headlines the shell scenario asserts on.
//
//   The fixture mirrors the unit-test barbell: atoms 0-3 form one
//   clique, atoms 4-7 form another, and the bridge edge 3-4 joins
//   them. LPA finds 2 communities (one per clique), with modularity
//   well above the 200-milli "well-separated" threshold from the
//   brief.
//
//   We also drive the empty-graph edge case (a freshly-spawned KG
//   with no atoms) so the shell asserts on the 0-communities path
//   too.
//
// NOVA dependencies: builtins + std/io. CrossEngin dependencies:
//   src/kg/graph_clustering.nova (the LPA module under test) +
//   transitively atom_store, multi_kg_manager, cross_kg_references.

import "std/syscall"
import "std/string"
import "std/io"
import "../src/kg/atom_store.nova"
import "../src/kg/multi_kg_manager.nova"
import "../src/kg/cross_kg_references.nova"
import "../src/kg/graph_clustering.nova"

fn _add_atom(kg, label) {
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    return atom_id(a)
}

fn _link(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    let y = xref_new(b, a, XREF_SIMILAR, 900, 0)
    atom_add_xref(b, y)
    return 1
}

fn _clique(kg, start, size) {
    let i = 0
    while i < size {
        let j = i + 1
        while j < size {
            _link(kg, start + i, start + j)
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

fn _build_barbell(reg) {
    let kg = kg_spawn(reg, "barbell")
    let i = 0
    while i < 8 {
        _add_atom(kg, "barbell_atom_" + int_to_str(i))
        i = i + 1
    }
    _clique(kg, 0, 4)   // left clique: 0,1,2,3
    _clique(kg, 4, 4)   // right clique: 4,5,6,7
    _link(kg, 3, 4)     // bridge edge
    return kg
}

fn _build_three_triangles(reg) {
    let kg = kg_spawn(reg, "three_triangles")
    let i = 0
    while i < 9 {
        _add_atom(kg, "tri_atom_" + int_to_str(i))
        i = i + 1
    }
    _clique(kg, 0, 3)
    _clique(kg, 3, 3)
    _clique(kg, 6, 3)
    return kg
}

fn _build_empty(reg) {
    let kg = kg_spawn(reg, "empty_kg")
    return kg
}

fn main() {
    let reg = kg_registry_new()

    // --- empty graph -------------------------------------------------------
    let empty_kg = _build_empty(reg)
    let r_empty = gc_label_propagation(empty_kg, 20)
    io_println("DRIVER empty_n=" + int_to_str(gc_community_count(r_empty)))
    io_println("DRIVER empty_edges=" + int_to_str(gc_total_edges(r_empty)))

    // --- barbell graph -----------------------------------------------------
    let kg = _build_barbell(reg)
    io_println("DRIVER atoms=" + int_to_str(kg_atom_count(kg)))

    let r = gc_label_propagation(kg, 20)
    let n_comm = gc_community_count(r)
    let big = gc_largest_community(r)
    let q = gc_modularity(kg, r)
    io_println("DRIVER barbell_n=" + int_to_str(n_comm))
    io_println("DRIVER barbell_largest=" + int_to_str(big[1]))
    io_println("DRIVER barbell_modularity=" + int_to_str(q))
    io_println("DRIVER barbell_edges=" + int_to_str(gc_total_edges(r)))
    io_println("DRIVER barbell_iter=" + int_to_str(gc_iterations(r)))

    // Drive the chat dispatch directly: gc_communities_cmd emits the
    // canonical COMMUNITIES line the chat /communities admin prints.
    gc_communities_cmd(kg)

    // --- three triangles ---------------------------------------------------
    let kg3 = _build_three_triangles(reg)
    let r3 = gc_label_propagation(kg3, 20)
    io_println("DRIVER tri_n=" + int_to_str(gc_community_count(r3)))
    io_println("DRIVER tri_largest=" + int_to_str(gc_largest_community(r3)[1]))
    io_println("DRIVER tri_modularity=" + int_to_str(gc_modularity(kg3, r3)))
    io_println("DRIVER tri_edges=" + int_to_str(gc_total_edges(r3)))

    return 0
}

main()
