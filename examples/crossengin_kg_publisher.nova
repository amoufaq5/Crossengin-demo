// CrossEngin KG sync publisher (Phase 20 / Tier 4 #2 distributed-substrate seam).
//
// Purpose
//   Minimum-viable publisher half of the kg-sync demo: open a localhost TCP
//   listener, wait for ONE subscriber to dial in, then read labels from
//   stdin. Each label becomes a new concept atom in the local language KG;
//   each atom-birth is also pushed to the subscriber over the wire so the
//   two processes converge their knowledge state. The protocol is defined
//   in src/io/transducers/kg_sync.nova (text, one op per line).
//
//   This is the *seam*, not the unified daemon -- bin/crossengin is unchanged;
//   the demo runs as two distinct processes (bin/crossengin-kg-publisher and
//   bin/crossengin-kg-subscriber). A future enhancement may roll the
//   accept/send_atom loop into the main daemon's idle path.
//
//   Run with: ./bin/crossengin-kg-publisher
//     (typically piped: `printf 'widget\ngadget\nfever\n' | ./bin/...`)
//   Env:
//     CE_KGSYNC_PORT  -- listen port  (default 8766)
//     CE_KGSYNC_BIND  -- bind address (default 127.0.0.1)
//   stdin -> one label per line. `bye` or empty line / EOF -> graceful close.
//
// ADRs exercised: ADR-0014 (no LLM, no cognition on the wire), ADR-0016
//   (atom birth is the unit). NOVA dependencies: socket builtins,
//   `read_line`, `getenv`. CrossEngin dependencies:
//   src/io/transducers/kg_sync.nova, src/kg/multi_kg_manager.nova.

import "../src/io/transducers/kg_sync.nova"
import "../src/kg/multi_kg_manager.nova"

let CE_KGSYNC_MAX_ATOMS = 1024   // defensive runaway-input cap

fn main() {
    let port = kgsync_port_from_env()
    println("kg-publisher: starting on port " + int_to_str(port))

    // 1. BOOT: own a small language KG. The publisher's local state evolves
    // exactly the same way the subscriber's will -- one atom per label.
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "language")
    println("kg-publisher: boot kg=language atoms=" + int_to_str(kg_atom_count(kg)))

    // 2. LISTEN + ACCEPT one subscriber. accept_conn blocks until the dial-in
    // arrives -- that's by design (NOVA gotcha: blocking accept is fine here
    // because this binary's whole purpose is to publish).
    let server_fd = sync_pub_listen(port)
    if server_fd < 0 {
        println("kg-publisher: ERROR cannot bind / listen on port "
            + int_to_str(port))
        exit(1)
    }
    println("kg-publisher: listening, awaiting subscriber HELLO ...")
    let sub_fd = sync_pub_accept(server_fd)
    if sub_fd < 0 {
        println("kg-publisher: ERROR handshake failed")
        sync_close(server_fd)
        exit(1)
    }
    println("kg-publisher: subscriber attached, accepting labels on stdin")

    // 3. PUMP: read stdin -> create atom -> publish.
    let pumped = 0
    let go = 1
    while go == 1 {
        let line = read_line()
        if len(line) == 0 {
            // EOF (read_line returns the empty string on closed stdin).
            go = 0
        } else {
            let label = str_trim(line)
            if len(label) == 0 {
                // Blank line -> graceful close (matches the brief's "bye/EOF
                // exits" contract; an interactive user could leave it open
                // by feeding a non-blank line).
                go = 0
            } else {
                if str_eq(label, "bye") == 1 {
                    go = 0
                } else {
                    if pumped >= CE_KGSYNC_MAX_ATOMS {
                        println("kg-publisher: max atoms reached, closing")
                        go = 0
                    } else {
                        // Local birth: a new concept atom in the publisher's
                        // own KG (the SIMPLEST KG API -- kg_add_atom).
                        let a = kg_add_atom(kg, ATOM_CONCEPT, label, 0)
                        let b = atom_belief(a)
                        // Send the atom-birth over the wire. The subscriber
                        // will install an identical local atom and ACK.
                        let ok = sync_pub_send_atom(sub_fd,
                            kg_label(kg), atom_id(a), atom_kind(a),
                            b[0], b[1], label)
                        if ok == 0 {
                            println("kg-publisher: send failed (subscriber gone)")
                            go = 0
                        } else {
                            println("send kg=" + kg_label(kg)
                                + " id=" + int_to_str(atom_id(a))
                                + " label=" + label)
                            pumped = pumped + 1
                        }
                    }
                }
            }
        }
    }

    // 4. CLOSE: BYE, drop subscriber, drop server.
    sync_pub_bye(sub_fd)
    sync_close(sub_fd)
    sync_close(server_fd)
    println("kg-publisher: closed (published " + int_to_str(pumped)
        + " atom(s), local kg=" + int_to_str(kg_atom_count(kg)) + ")")
}
main()
