// CrossEngin substrate self-check.
//
// Purpose
//   The runnable artifact for v0.1. There is no end-user cognitive agent yet;
//   this program boots the implemented substrate kernel, wires a small slice of
//   it together, drives it for several ticks, and prints a liveness report. It
//   exercises every Phase 1 module end-to-end:
//     part_registry + part_lifecycle  (parts, KG spawn)
//     node_pool_manager + first_nodes  (nodes, first-node blocks)
//     synapse_graph + resonance_engine (connections, assemblies)
//     signal_dispatch + gate_router    (typed signals, routing)
//     tick_driver                      (the substrate tick)
//
//   Run with:  bash scripts/run.sh        (or  make install && ./bin/...)
//
// ADRs exercised: ADR-0001, 0002, 0006, 0007, 0008, 0009, 0010.
// CrossEngin dependencies: the full src/substrate/ tree (via tick_driver,
//   gate_router, resonance_engine).

import "../src/substrate/tick_driver.nova"
import "../src/substrate/gate_router.nova"
import "../src/substrate/resonance_engine.nova"
import "../src/substrate/part_lifecycle.nova"

let SC_CAP = 128
let SC_FIRST  = 8

fn line() { println("------------------------------------------------------------") }

fn main() {
    println("=== CrossEngin substrate self-check (v0.1) ===")
    line()

    // 1. Boot the substrate: seven fixed parts plus a spawned KG domain.
    let reg = part_registry_new()
    registry_spawn_fixed(reg, SC_CAP, SC_FIRST)
    let kg = pl_spawn_kg(reg, "medicine", SC_CAP, SC_FIRST)
    println("parts spawned        : " + int_to_str(registry_count(reg))
        + " (" + int_to_str(registry_live_count(reg)) + " active)")
    println("  fixed: perception episodic soul reasoning imagination action meta")
    println("  dynamic KG: " + part_name(registry_get(reg, kg)))

    // 2. Wire a slice of the perception part: a feedforward chain off first
    //    node 0 into an interior node, and a reciprocal (resonant) pair.
    let perception = registry_find(reg, "perception")
    let ppart = registry_get(reg, perception)
    let pool = part_pool(ppart)
    let g = part_syn(ppart)
    let interior = npm_node_create_default(pool, NTYPE_KNOWER)
    syn_new(g, 0, interior, 900, 0)          // first node 0 -> interior
    res_reinforce_pair(g, 1, 2, 400)         // resonant pair among first nodes
    println("perception nodes     : " + int_to_str(part_node_count(ppart))
        + "   synapses: " + int_to_str(syn_live(g)))

    // 3. Routing: a SENSORY percept routes to perception; a constitutional
    //    signal broadcasts to every part (privileged, non-learnable).
    let gate = gate_new(reg)
    gate_seed_from_parts(gate, reg)
    let sensory = sig_new(XSIG_SENSORY, -1, -1, 700, 0, 0)
    let dests = gate_route(gate, sensory)
    println("SENSORY routes to    : " + int_to_str(len(dests)) + " part(s); perception in set = "
        + int_to_str(contains(dests, perception)))
    let constsig = sig_new(XSIG_CONST, -1, -1, 1000, 0, 0)
    println("CONST broadcasts to  : " + int_to_str(len(gate_route(gate, constsig))) + " part(s) (all)")

    // 4. Deliver the percept to perception's first-node block and run ticks.
    part_inject(reg, perception, 700)
    let e = td_engine_new(reg)
    let total_fires = 0
    let t = 0
    while t < 8 {
        total_fires = total_fires + td_step(e, TD_MOD_NEUTRAL, 0)
        t = t + 1
    }
    line()
    println("ticks run            : " + int_to_str(td_now(e)))
    println("total node fires     : " + int_to_str(total_fires))
    println("first node 0 fired   : tick " + int_to_str(npm_last_fired(pool, 0)))
    println("interior fired       : tick " + int_to_str(npm_last_fired(pool, interior))
        + "  (propagation across ticks)")
    println("resonant pair {1,2}  : strength " + int_to_str(res_pair_strength(g, 1, 2)))
    line()

    // 5. Liveness assertions (defensive; the program fails loudly if the
    //    substrate did not behave).
    if registry_live_count(reg) < 8 { println("SELFCHECK FAILED: parts"); exit(1) }
    if npm_last_fired(pool, 0) < 1 { println("SELFCHECK FAILED: stimulus did not fire"); exit(1) }
    if npm_last_fired(pool, interior) <= npm_last_fired(pool, 0) {
        println("SELFCHECK FAILED: no cross-tick propagation"); exit(1)
    }
    println("substrate self-check: OK")
}

main()
