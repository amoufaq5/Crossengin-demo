// CrossEngin Phase 6 pt2a: standalone MCP stdio server binary.
//
// Minimum viable MCP server a Claude Desktop / Cursor / Zed instance
// can connect to over stdio. Registers two canned tools (hello, echo)
// so the handshake + tool-list + tool-call paths can be exercised
// with a scripted stdin. pt2b will wire the chat REPL's own MCP
// registry through so /mcp register in-chat adds a tool the
// external MCP client sees.
//
// Run with:
//     ./bin/crossengin-mcp
// Or from Claude Desktop's claude_desktop_config.json:
//     { "mcpServers": { "crossengin": { "command": "/abs/path/to/bin/crossengin-mcp" } } }

import "../src/io/effectors/mcp_server_stdio.nova"

fn main() {
    let srv = mcp_srv_new()
    mcp_srv_register_tool(srv,
        "hello",
        "Returns a canned greeting",
        "hello from crossengin-mcp pt2a",
        "allow")
    mcp_srv_register_tool(srv,
        "echo",
        "Returns a canned echo string",
        "echo-canned-reply",
        "allow")
    mcp_srv_run(srv)
}

main()
