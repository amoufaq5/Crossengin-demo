// CrossEngin Phase 6: standalone MCP server binary.
//
// Serves the hello + echo fixtures plus every tool in the chat-written
// registry file ($CE_MCP_REGISTRY, default ~/.crossengin/mcp-tools.registry).
//
// Transport:
//   stdio (default)              ./bin/crossengin-mcp
//     Claude Desktop claude_desktop_config.json:
//       { "mcpServers": { "crossengin": { "command": "/abs/path/to/bin/crossengin-mcp" } } }
//   HTTP (Streamable HTTP)       CE_MCP_HTTP_PORT=8765 ./bin/crossengin-mcp
//     Claude Code:
//       claude mcp add --transport http crossengin http://127.0.0.1:8765/mcp

import "../src/io/effectors/mcp_server_stdio.nova"
import "../src/io/effectors/mcp_server_http.nova"

fn main() {
    let srv = mcp_srv_new()
    mcp_srv_register_tool(srv,
        "hello",
        "Returns a canned greeting",
        "hello from crossengin-mcp pt2a",
        "allow",
        "")
    mcp_srv_register_tool(srv,
        "echo",
        "Returns a canned echo string",
        "echo-canned-reply",
        "allow",
        "")
    let port_s = getenv("CE_MCP_HTTP_PORT")
    if len(port_s) > 0 {
        let port = str_to_int(port_s)
        if mcp_http_run(srv, port) == 0 {
            println("crossengin-mcp: cannot listen on 127.0.0.1:" + port_s)
            exit(1)
        }
        return 0
    }
    mcp_srv_run(srv)
}

main()
