// CrossEngin interactive chat.
//
// Purpose
//   The unified daemon's per-message logic, but driven from an stdin REPL
//   instead of a fixed scripted episode. Boot once, then loop: read a line,
//   post it as an EV_MESSAGE event, drain the scheduler to consume it, print
//   the agent's reply. Because the agent stays alive across turns, learned
//   vocabulary and decision-log entries PERSIST -- a follow-up message can use
//   words taught earlier in the same conversation.
//
//   This is what the chat experience should be, and it's possible because the
//   NOVA std/io fix (str_new + NUL-terminated string format) made io_input()
//   return whole lines reliably. Before that fix, the bash-shim chat.sh was
//   the only way to talk to the agent and each turn was a fresh boot.
//
//   Run with:  $NOVA_ROOT/nova run examples/crossengin_chat.nova
//   Quit:      type "quit" / "exit" / Ctrl-D / an empty line at the prompt.
//
// ADRs exercised: same as examples/crossengin_daemon.nova -- this differs only
//   in driving the loop from real stdin.

import "std/syscall"
import "std/string"
import "std/io"

import "../src/substrate/gate_router.nova"
import "../src/substrate/part_lifecycle.nova"
import "../src/scheduler/hybrid_scheduler.nova"
import "../src/agent/loop_perception.nova"
import "../src/agent/loop_memory.nova"
import "../src/agent/loop_reasoning.nova"
import "../src/agent/loop_emotion.nova"
import "../src/agent/loop_goals.nova"
import "../src/agent/loop_imagination_idle.nova"
import "../src/parts/emotion/plasticity_mod.nova"
import "../src/learning/predictive_coding_runtime.nova"
import "../src/learning/self_learning_triggers.nova"
import "../src/learning/ask_user_to_teach.nova"
import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/output_generation.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/seed/first_atoms.nova"
import "../src/parts/meta/reflection_loop.nova"
import "../src/persistence/snapshot_disk.nova"

let CE_CAP   = 128
let CE_FIRST = 8

// Default snapshot path for /save and /load. Set CE_SNAP_PATH to override.
let CE_DEFAULT_SNAP_PATH = "/tmp/crossengin.snap"

// Admin / safety flag. `/halt` flips it; effector_speak_governed honours the
// halted bit and drains without speaking (ADR-0044 hard stop), `/resume`
// clears it. Lives outside the REPL loop so commands can mutate it.
let halted = 0

// ---- buffered line reader ------------------------------------------------
// io_input() returns whatever sys_read drained -- on a terminal in line mode
// that's one line, but on a pipe (or after a paste) it can be several lines
// in one call. Buffer reads so the REPL always processes ONE line per turn.
let _buf = ""

fn _take_line() {
    let i = 0
    while i < len(_buf) {
        if char_at(_buf, i) == 10 {
            let line = substr(_buf, 0, i)
            _buf = substr(_buf, i + 1, len(_buf) - i - 1)
            return line
        }
        i = i + 1
    }
    let chunk = io_input()
    if len(chunk) == 0 {
        let line = _buf
        _buf = ""
        return line
    }
    _buf = _buf + chunk + "\n"
    return _take_line()
}

fn _intent1(role, lemma) {
    let it = list_new()
    let a = list_new() push(a, role) push(a, lemma)
    push(it, a)
    return it
}

// Build a gated signal and inject its strength into every routed destination
// part (ADR-0009 path from event to substrate stimulus).
fn _route_and_inject(reg, gate, stype, strength, moment) {
    let s = sig_new(stype, 0 - 1, 0 - 1, strength, moment, 0)
    let dests = gate_route(gate, s)
    let i = 0
    while i < len(dests) {
        part_inject(reg, dests[i], strength)
        i = i + 1
    }
    return dests
}

// Submit one trigger per unknown surface form (ADR-0026).
fn _submit_curiosity(arb, lang, input_text) {
    let toks = split(input_text, " ")
    let ti = 0
    while ti < len(toks) {
        let tok = str_trim(toks[ti])
        if len(tok) > 0 {
            if word_find(lang, tok) == 0 {
                slt_submit(arb, trigger_new(SLT_UNKNOWN_QUERY, tok, 800, 500))
            }
        }
        ti = ti + 1
    }
    return 1
}

// Drain the trigger arbiter, ingesting up to 4 unknowns into the KGs at idle.
// Returns how many were taught this cycle.
fn _drain_and_teach(arb, kg, lang, now) {
    let go = 1
    let taught = 0
    while go == 1 {
        if slt_queue_size(arb) == 0 { go = 0 }
        if go == 1 {
            if taught >= 4 { go = 0 }
        }
        if go == 1 {
            let trig = slt_arbiter_step(arb)
            if trig != 0 {
                let target = slt_target(trig)
                au_ingest(lang, kg, target, "u:" + target, now)
                taught = taught + 1
            }
            slt_clear_active(arb)
        }
    }
    return taught
}

// ---- admin commands ------------------------------------------------------
// All `/`-prefixed input is intercepted before it reaches the agent. Each
// handler does its thing and returns -- the input is never processed as a user
// message, so the agent's state is only what the admin explicitly changes.

// Split "/cmd rest of line" into [cmd, args]. args is "" if there was no space.
fn _split_cmd(msg) {
    let i = 0
    while i < len(msg) {
        if char_at(msg, i) == 32 {
            let pair = list_new()
            push(pair, substr(msg, 0, i))
            push(pair, str_trim(substr(msg, i + 1, len(msg) - i - 1)))
            return pair
        }
        i = i + 1
    }
    let pair = list_new()
    push(pair, msg)
    push(pair, "")
    return pair
}

fn _admin_help() {
    io_println("admin commands:")
    io_println("  /help               this listing")
    io_println("  /status             soul / mood / goal / KG / scheduler state")
    io_println("  /history [N]        last N decision-log entries (default 5)")
    io_println("  /why                explain the most recent decision")
    io_println("  /teach W            ingest W as a new word + concept binding")
    io_println("  /learn TOPIC        ingest /tmp/crossengin_learn_<TOPIC>.txt")
    io_println("                      (populate first with scripts/learn.sh TOPIC)")
    io_println("  /reflect [DEPTH]    forward-simulate from current conclusions; record")
    io_println("                      tentative inferences into the reflection KG (no act)")
    io_println("  /pin W C            pin word W's belief to confidence C (0..1000)")
    io_println("  /save [PATH]        durably write a snapshot to disk")
    io_println("                      (default: $CE_SNAP_PATH or /tmp/crossengin.snap)")
    io_println("  /load [PATH]        read a snapshot from disk and print its sections")
    io_println("                      (does not replace the live substrate)")
    io_println("  /halt               stop the effector (input keeps flowing)")
    io_println("  /resume             un-halt")
    io_println("  /quit  /exit        exit chat")
    return 1
}

fn _admin_status(sl, kg, refl_kg, log, engine, hs) {
    io_println("soul     : " + soul_name(sl) + " (purpose: " + soul_purpose(sl) + ")")
    io_println("mood     : valence=" + int_to_str(soul_mood_valence(sl))
        + " arousal=" + int_to_str(soul_mood_arousal(sl)))
    io_println("knowledge: " + int_to_str(kg_atom_count(kg)) + " atoms in shared KG, "
        + int_to_str(refl_size(refl_kg)) + " tentative reflections")
    io_println("audit    : " + int_to_str(dl_count(log)) + " decision-log entries")
    io_println("scheduler: tick=" + int_to_str(hs_now(hs)) + " rate=" + int_to_str(hs_rate(hs)) + "Hz")
    let g = goal_arbitrate(engine)
    if g >= 0 {
        io_println("goal     : #" + int_to_str(g) + " " + goal_name(engine, g))
    } else {
        io_println("goal     : (none active)")
    }
    if halted == 1 { io_println("effector : HALTED") }
    return 1
}

fn _admin_history(log, n) {
    let total = dl_count(log)
    if total == 0 { io_println("(no decisions yet)") return 1 }
    let from = total - n
    if from < 0 { from = 0 }
    let i = from
    while i < total {
        let e = dl_get(log, i)
        io_println("  #" + int_to_str(dl_seq(e)) + " " + dlk_name(dl_kind(e))
            + " " + act_name(dl_action_type(e))
            + " tier=" + perm_tier_name(dl_perm_tier(e))
            + " outcome=" + out_name(dl_outcome(e)))
        i = i + 1
    }
    return 1
}

fn _admin_why(log) {
    let n = dl_count(log)
    if n == 0 { io_println("(no decisions yet)") return 1 }
    let e = dl_get(log, n - 1)
    io_println("most recent: #" + int_to_str(dl_seq(e)) + " " + act_name(dl_action_type(e))
        + " (" + rev_class_name(dl_rev_class(e)) + ")")
    io_println("  tier    : " + perm_tier_name(dl_perm_tier(e)))
    io_println("  outcome : " + out_name(dl_outcome(e)))
    io_println("  trace   : " + int_to_str(len(dl_trace(e))) + " node(s)")
    return 1
}

// Run one reflection cycle on the agent's current reasoning conclusions.
// Forward-simulates them in ikg (depth 4 by default), accumulates derived
// labels into refl_kg as Beta(2,1) tentative atoms, and prints what came up.
// The live blackboard / ctx is not touched.
fn _admin_reflect(ctx, kg, ikg, refl_kg, arg, moment) {
    let concs = ctx_conclusions(ctx)
    if len(concs) == 0 {
        io_println("(nothing recent to reflect on -- send a non-trivial message first)")
        return 1
    }
    let depth = 4
    if len(arg) > 0 {
        let d = rt_str_to_int(arg)
        if d > 0 { depth = d }
    }
    // min_confidence=0: accept every forward-simulated candidate; refl_kg
    // records each as Beta(2,1) so the prior gates premature belief, and
    // promotion still requires crossing the 750 corroboration threshold.
    let labels = refl_run(kg, ikg, refl_kg, refl_seed_from_ids(concs), depth, 0, moment)
    let n = len(labels)
    if n == 0 {
        io_println("(reflected on " + int_to_str(len(concs)) + " concept(s); no new inferences)")
        return 1
    }
    let line = "(reflected on " + int_to_str(len(concs)) + " concept(s); "
        + int_to_str(n) + " tentative inference(s):"
    let i = 0
    while i < n {
        line = line + " " + labels[i]
        if i < n - 1 { line = line + "," }
        i = i + 1
    }
    io_println(line + ")  refl_kg=" + int_to_str(refl_size(refl_kg)))
    return 1
}

fn _admin_teach(lang, kg, word, now) {
    if len(word) == 0 { io_println("(/teach needs a word)") return 1 }
    au_ingest(lang, kg, word, "u:" + word, now)
    io_println("(ingested '" + word + "' -- " + int_to_str(kg_atom_count(kg)) + " atoms now)")
    return 1
}

// Split one "S|R|O" line into a 3-element list. Returns 0 on malformed lines
// (missing/extra pipes, empty fields). Pipe (|) is U+007C = 124.
fn _split_triple(line) {
    let n = len(line)
    let p1 = -1
    let p2 = -1
    let i = 0
    while i < n {
        if char_at(line, i) == 124 {
            if p1 < 0 { p1 = i } else { if p2 < 0 { p2 = i } }
        }
        i = i + 1
    }
    if p1 < 0 { return 0 }
    if p2 < 0 { return 0 }
    if p2 <= p1 + 1 { return 0 }
    let s = str_trim(substr(line, 0, p1))
    let r = str_trim(substr(line, p1 + 1, p2 - p1 - 1))
    let o = str_trim(substr(line, p2 + 1, n - p2 - 1))
    if len(s) == 0 { return 0 }
    if len(r) == 0 { return 0 }
    if len(o) == 0 { return 0 }
    let out = list_new()
    push(out, s)
    push(out, r)
    push(out, o)
    return out
}

// Map a textual relation tag to an ROP_* kind, or 0 if unrecognised.
fn _rel_to_op_kind(r) {
    if str_eq(r, "causal") == 1 { return ROP_CAUSAL }
    if str_eq(r, "has")    == 1 { return ROP_CAUSAL }
    if str_eq(r, "is_a")   == 1 { return ROP_IMPLY }
    return 0
}

// Ingest the triples sidecar file: one "S|R|O" per line. For each triple
// whose subject AND object are both real atoms in `kg` (either from seed
// or from the vocabulary just ingested), spawn a reasoning operator atom
// linking premise -> conclusion under the appropriate ROP_* kind. Triples
// referring to unknown atoms are silently dropped -- the bash extractor is
// permissive on purpose; this is the ground-truth filter.
fn _admin_learn_triples(kg, topic, now) {
    let path = "/tmp/crossengin_learn_" + topic + "_triples.txt"
    let content = read_file(path)
    if content == 0 { return 0 }
    if len(content) == 0 { return 0 }
    let ops = 0
    let i = 0
    let line_start = 0
    let n = len(content)
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let line = str_trim(substr(content, line_start, i - line_start))
                if len(line) > 0 {
                    let parts = _split_triple(line)
                    if parts != 0 {
                        let s_atom = kg_find_atom(kg, parts[0])
                        let o_atom = kg_find_atom(kg, parts[2])
                        if s_atom != 0 {
                            if o_atom != 0 {
                                let kind = _rel_to_op_kind(parts[1])
                                if kind != 0 {
                                    let label = "wiki:" + topic + ":"
                                        + parts[0] + "-" + parts[1] + "->" + parts[2]
                                    rop_new(kg, kind, atom_id(s_atom),
                                            atom_id(o_atom), label, now)
                                    ops = ops + 1
                                }
                            }
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    return ops
}

// Read /tmp/crossengin_learn_<topic>.txt (one word per line, populated by
// scripts/learn.sh which does the actual web fetch + text extraction) and
// ingest each word via the same au_ingest path /teach uses. NOVA has no
// fork/exec, so the network fetch lives in bash; the agent only reads.
//
// After vocabulary, also try the structural sidecar
// /tmp/crossengin_learn_<topic>_triples.txt -- one "S|R|O" per line -- and
// turn each S/R/O whose endpoints are now real atoms into a reasoning
// operator (ADR-0031), giving the agent STRUCTURE on top of vocabulary.
fn _admin_learn(lang, kg, topic, now) {
    if len(topic) == 0 {
        io_println("(/learn needs a topic; first run: scripts/learn.sh <topic>)")
        return 1
    }
    let path = "/tmp/crossengin_learn_" + topic + ".txt"
    let content = read_file(path)
    if content == 0 {
        io_println("(no cache for '" + topic + "' at " + path + ")")
        io_println("  run first:  scripts/learn.sh " + topic)
        return 1
    }
    if len(content) == 0 {
        io_println("(empty cache for '" + topic + "')")
        return 1
    }
    let before = kg_atom_count(kg)
    let count = 0
    let i = 0
    let line_start = 0
    let n = len(content)
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let word = str_trim(substr(content, line_start, i - line_start))
                if len(word) > 0 {
                    au_ingest(lang, kg, word, "wiki:" + topic, now)
                    count = count + 1
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    let ops = _admin_learn_triples(kg, topic, now)
    let after = kg_atom_count(kg)
    io_println("(learned about '" + topic + "': " + int_to_str(count)
        + " word(s), " + int_to_str(ops) + " operator(s) ingested, KG="
        + int_to_str(after) + ")")
    return 1
}

fn _admin_pin(lang, word, conf_str) {
    if len(word) == 0 {
        io_println("(usage: /pin WORD CONFIDENCE  -- confidence is 0..1000)")
        return 1
    }
    if len(conf_str) == 0 {
        io_println("(usage: /pin " + word + " CONFIDENCE  -- confidence is 0..1000)")
        return 1
    }
    let w = word_find(lang, word)
    if w == 0 { io_println("(no such word: '" + word + "')") return 1 }
    let conf = rt_str_to_int(conf_str)
    if conf < 0 { conf = 0 }
    if conf > 1000 { conf = 1000 }
    let b = atom_belief(w)
    list_set(b, 0, conf * 10)
    list_set(b, 1, (1000 - conf) * 10)
    atom_payload_set(w, "pinned", 1)
    io_println("(pinned '" + word + "' to confidence " + int_to_str(conf) + "/1000)")
    return 1
}

fn _admin_halt() {
    halted = 1
    io_println("(halted -- effector will drain; constitution still applies)")
    return 1
}

fn _admin_resume() {
    halted = 0
    io_println("(resumed)")
    return 1
}

// Build a snapshot from the live substrate (mirrors crossengin_daemon's
// _checkpoint). Keep this here so the chat doesn't have to import the daemon.
fn _build_snapshot(sl, kg, now) {
    let snap = snap_new(1, now)
    let sb = list_new() push(sb, soul_name(sl)) push(sb, soul_constitution_count(sl))
    snap_put_section(snap, SEC_SOUL, sb)
    let kb = list_new() push(kb, kg_atom_count(kg))
    snap_put_section(snap, SEC_KGS, kb)
    return snap
}

// Resolve the snapshot path: explicit arg overrides everything; otherwise
// CE_SNAP_PATH env; otherwise the default. Empty/missing fall through.
fn _snap_path(arg) {
    if len(arg) > 0 { return arg }
    let env = getenv("CE_SNAP_PATH")
    if len(env) > 0 { return env }
    return CE_DEFAULT_SNAP_PATH
}

// /save [PATH]: durably write a snapshot of the live soul + KG to disk.
// Uses write_tmp -> fsync -> atomic_rename -> fsync(parent) so a crash mid-
// write never corrupts the last good image.
fn _admin_save(sl, kg, arg, now) {
    let path = _snap_path(arg)
    let snap = _build_snapshot(sl, kg, now)
    let ok = snap_save(snap, path)
    if ok == 1 {
        io_println("(saved soul=" + soul_name(sl) + " kg=" + int_to_str(kg_atom_count(kg))
            + " atom(s) -> " + path + " durably)")
    } else {
        io_println("(save FAILED: could not write " + path + " -- check directory exists / permissions)")
    }
    return 1
}

// /load [PATH]: read a snapshot from disk and print what's in it. Does not
// mutate the live substrate (the running KG / soul are not replaced); this
// surface is for inspecting saved checkpoints. A future enhancement will
// rehydrate by replaying section blobs through subsystem-specific loaders.
fn _admin_load(arg) {
    let path = _snap_path(arg)
    let snap = snap_load(path)
    if snap == 0 {
        io_println("(load FAILED: " + path + " missing, unreadable, or not a snapshot)")
        return 1
    }
    let soul_p = snap_has_section(snap, SEC_SOUL)
    let kgs_p = snap_has_section(snap, SEC_KGS)
    io_println("(loaded " + path + ":"
        + " ver=" + int_to_str(snap_version(snap))
        + " instance=" + int_to_str(snap_instance(snap))
        + " ts=" + int_to_str(snap_timestamp(snap)) + ")")
    if soul_p == 1 {
        let sb = snap_section(snap, SEC_SOUL)
        io_println("  soul: name=" + sb[0] + " constcount=" + int_to_str(sb[1]))
    }
    if kgs_p == 1 {
        let kb = snap_section(snap, SEC_KGS)
        io_println("  kgs: atoms=" + int_to_str(kb[0]))
    }
    io_println("  episodic.present=" + int_to_str(snap_has_section(snap, SEC_EPISODIC))
        + " synapses.present=" + int_to_str(snap_has_section(snap, SEC_SYNAPSES))
        + " selfmodel.present=" + int_to_str(snap_has_section(snap, SEC_SELFMODEL)))
    io_println("  (read-only: live substrate not replaced; see /help for details)")
    return 1
}

// Returns 1 if the line was an admin command (and was handled), 0 otherwise.
fn _try_admin(msg, sl, kg, lang, ikg, refl_kg, ctx, log, engine, hs, now) {
    if len(msg) == 0 { return 0 }
    if char_at(msg, 0) != 47 { return 0 }   // not '/'
    let parts = _split_cmd(msg)
    let cmd = parts[0]
    let arg = parts[1]
    if str_eq(cmd, "/quit") == 1 { io_println("bye.") exit(0) }
    if str_eq(cmd, "/exit") == 1 { io_println("bye.") exit(0) }
    if str_eq(cmd, "/help")    == 1 { return _admin_help() }
    if str_eq(cmd, "/status")  == 1 { return _admin_status(sl, kg, refl_kg, log, engine, hs) }
    if str_eq(cmd, "/why")     == 1 { return _admin_why(log) }
    if str_eq(cmd, "/halt")    == 1 { return _admin_halt() }
    if str_eq(cmd, "/resume")  == 1 { return _admin_resume() }
    if str_eq(cmd, "/teach")   == 1 { return _admin_teach(lang, kg, arg, now) }
    if str_eq(cmd, "/learn")   == 1 { return _admin_learn(lang, kg, arg, now) }
    if str_eq(cmd, "/reflect") == 1 { return _admin_reflect(ctx, kg, ikg, refl_kg, arg, now) }
    if str_eq(cmd, "/save")    == 1 { return _admin_save(sl, kg, arg, now) }
    if str_eq(cmd, "/load")    == 1 { return _admin_load(arg) }
    if str_eq(cmd, "/history") == 1 {
        let n = 5
        if len(arg) > 0 { n = rt_str_to_int(arg) }
        if n <= 0 { n = 5 }
        return _admin_history(log, n)
    }
    if str_eq(cmd, "/pin") == 1 {
        let ap = _split_cmd(arg)
        return _admin_pin(lang, ap[0], ap[1])
    }
    io_println("(unknown command: " + cmd + " -- try /help)")
    return 1
}

fn main() {
    io_println("=== CrossEngin chat ===")
    io_println("state persists across turns; type 'quit' / 'exit' / empty / Ctrl-D to leave")
    io_println("type /help for admin commands (/teach, /pin, /status, /halt, ...)")
    io_println("")

    // Boot: soul, substrate, ONE shared concept KG (seed installs core +
    // medical demo), scheduler, learning arbiter.
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)
    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "world", CE_CAP, CE_FIRST)
    let kgreg = kg_registry_new()
    let kg = reasoning_kg_init(kgreg)
    let lang = lang_kg_init(kgreg)
    let ikg = imagination_kg_init(kgreg)
    seed_apply(kg, lang, ikg, 0)
    let world_kg_id = atom_kg(kg_find_atom(kg, "fever"))
    let reader = reader_new(kgreg, lang, 0)
    let stream = ms_new()
    let em = em_new()
    let cands = list_new()
    push(cands, syntax_find(lang, "ack"))
    push(cands, syntax_find(lang, "see_topic"))
    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)
    let log = dl_new()
    let ctx = ctx_new()
    let hs = hs_new(reg)
    let gate = gate_new(reg)
    gate_seed_from_parts(gate, reg)
    let arb = slt_arbiter_new()
    let refl_kg = refl_kg_init(kgreg)
    let modulator = 1000
    let error = 0
    let predicted = 300
    let turn = 0

    io_println("(seed: " + int_to_str(kg_atom_count(kg)) + " atoms, "
        + soul_name(sl) + " ready)")
    io_println("")

    while 1 == 1 {
        io_print("> ")
        let msg = _take_line()
        if len(msg) == 0 {
            io_println("bye.")
            return 0
        }
        if str_eq(msg, "quit") == 1 {
            io_println("bye.")
            return 0
        }
        if str_eq(msg, "exit") == 1 {
            io_println("bye.")
            return 0
        }

        if _try_admin(msg, sl, kg, lang, ikg, refl_kg, ctx, log, engine, hs, hs_now(hs)) == 1 {
            // Admin command handled; do not feed to the agent.
        } else {

        hs_post_event(hs, EV_MESSAGE, msg)
        let reply = ""

        // Drain: each hs_step pops <=1 event and ticks once. Stop when the
        // event has been processed (idle counter starts climbing).
        let drained = 0
        let drain_steps = 0
        while drained == 0 {
            let ev = hs_step(hs, modulator, error)
            drain_steps = drain_steps + 1
            if ev != 0 {
                let raw = event_payload(ev)
                let p = transduce(IN_TEXT, raw)
                ctx_set_input(ctx, percept_text(p))
                ctx_set_idle(ctx, 0)
                ctx_set_tick(ctx, hs_now(hs))
                let matched = loop_perception_step(ctx, reader)
                // Reflection corroboration: percept tokens whose label is
                // already in refl_kg confirm prior speculation (ADR-0023).
                let corroborated = refl_corroborate_percept(kg, refl_kg, ctx_percept(ctx))
                loop_memory_step(ctx, stream, em)
                let nconcl = loop_reasoning_step(ctx, kg)

                _route_and_inject(reg, gate, XSIG_SENSORY, 700, hs_now(hs))
                let unk = ctx_unknown(ctx)
                if unk > 0 {
                    _route_and_inject(reg, gate, XSIG_CURIOSITY, 600, hs_now(hs))
                    _submit_curiosity(arb, lang, ctx_input(ctx))
                }

                // Affect from comprehension -> mood -> tick modulation.
                let des = matched * 300 - unk * 150
                loop_emotion_step(ctx, sl, des, 0, matched * 100)
                let val = ctx_valence(ctx)
                let aro = ctx_arousal(ctx)
                modulator = emotion_modulate_plasticity(val, aro, val)
                error = pc_residual(aro, predicted)
                predicted = aro

                let gap = 200
                if unk > 0 { gap = 700 }
                loop_goals_step(ctx, engine, gap, turn, 0, 300)

                if str_find(ctx_input(ctx), "exfiltrate") >= 0 {
                    effector_speak_governed(log, sl, ctx_input(ctx), halted, 0 - 1, list_new(), 0, hs_now(hs))
                    reply = "[refused]"
                } else {
                    // Output emerges from cognition: pick the first NEW
                    // conclusion, reverse-look up its naming word, speak it.
                    let percept = ctx_percept(ctx)
                    let concs = ctx_conclusions(ctx)
                    let intent = _intent1("ACK", "okay")
                    let derived = ""
                    let ck = 0
                    while ck < len(concs) {
                        if len(derived) == 0 {
                            let cid = concs[ck]
                            let in_p = 0
                            let pi = 0
                            while pi < len(percept) {
                                if percept[pi][1] == cid { in_p = 1 }
                                pi = pi + 1
                            }
                            if in_p == 0 {
                                let w = gen_word_for_concept(lang, world_kg_id, cid)
                                if w != 0 { derived = word_form(w) }
                            }
                        }
                        ck = ck + 1
                    }
                    if len(derived) > 0 {
                        let it = list_new()
                        let a = list_new() push(a, "SEE") push(a, "see")
                        let b = list_new() push(b, "TOPIC") push(b, derived)
                        push(it, a) push(it, b)
                        intent = it
                    }
                    let resp = gen_from_intent(lang, cands, intent, hs_now(hs))
                    let said = effector_speak_governed(log, sl, resp, halted, 0 - 1, list_new(), 0, hs_now(hs))
                    ctx_set_output(ctx, said)
                    _route_and_inject(reg, gate, XSIG_GOAL, 800, hs_now(hs))
                    reply = said
                    if len(reply) == 0 { reply = "[silent]" }
                }
                drained = 1
            } else {
                // Empty step; if we've burned many empty ticks without the
                // event being drained, bail out (defensive).
                if drain_steps > 10 { drained = 1 }
            }
        }

        // Idle-style: if curiosity triggers were submitted, drain + teach now
        // so the agent grows its KGs mid-conversation.
        let taught = _drain_and_teach(arb, kg, lang, hs_now(hs))

        // Any refl_kg atom whose belief crossed the promotion threshold this
        // turn graduates to a real concept now -- reflective speculation that
        // perception corroborated becomes accepted knowledge.
        let promoted = refl_drain_promotions(kg, lang, refl_kg, hs_now(hs))

        if len(reply) == 0 { reply = "[no response]" }
        io_println("agent> " + reply)
        if taught > 0 {
            io_println("       (learned " + int_to_str(taught) + " new word(s) -- "
                + int_to_str(kg_atom_count(kg)) + " atoms total)")
        }
        if len(promoted) > 0 {
            let line = "       (promoted from reflection:"
            let k = 0
            while k < len(promoted) {
                line = line + " " + promoted[k]
                if k < len(promoted) - 1 { line = line + "," }
                k = k + 1
            }
            io_println(line + ")")
        }
        turn = turn + 1
        } // end else: regular agent message
    }
    return 0
}
main()
