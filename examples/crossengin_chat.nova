// CrossEngin interactive chat.
//
// Purpose
//   The unified daemon's per-message logic, but driven from an stdin REPL
//   instead of a fixed scripted episode. Boot once, then loop: read a line,
//   post it as an EV_MESSAGE event, drain the scheduler to consume it, print
//   the agent's reply. Because the agent stays alive across turns, learned
//   vocabulary and decision-log entries PERSIST -- a follow-up message can use
//   words taught earlier in the same conversation.
//
//   This is what the chat experience should be, and it's possible because the
//   NOVA std/io fix (str_new + NUL-terminated string format) made io_input()
//   return whole lines reliably. Before that fix, the bash-shim chat.sh was
//   the only way to talk to the agent and each turn was a fresh boot.
//
//   Run with:  $NOVA_ROOT/nova run examples/crossengin_chat.nova
//   Quit:      type "quit" / "exit" / Ctrl-D / an empty line at the prompt.
//
// ADRs exercised: same as examples/crossengin_daemon.nova -- this differs only
//   in driving the loop from real stdin.

import "std/syscall"
import "std/string"
import "std/io"

import "../src/substrate/gate_router.nova"
import "../src/substrate/part_lifecycle.nova"
import "../src/scheduler/hybrid_scheduler.nova"
import "../src/agent/loop_perception.nova"
import "../src/agent/loop_memory.nova"
import "../src/agent/loop_reasoning.nova"
import "../src/agent/loop_emotion.nova"
import "../src/agent/loop_goals.nova"
import "../src/agent/loop_imagination_idle.nova"
import "../src/parts/emotion/plasticity_mod.nova"
import "../src/learning/predictive_coding_runtime.nova"
import "../src/learning/self_learning_triggers.nova"
import "../src/learning/ask_user_to_teach.nova"
import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/output_generation.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/io/effectors/audio_speak.nova"
import "../src/seed/first_atoms.nova"
import "../src/parts/meta/reflection_loop.nova"
import "../src/parts/meta/meta_observer.nova"
import "../src/persistence/snapshot_disk.nova"

let CE_CAP   = 128
let CE_FIRST = 8

// Default snapshot path for /save and /load. Set CE_SNAP_PATH to override.
let CE_DEFAULT_SNAP_PATH = "/tmp/crossengin.snap"

// Admin / safety flag. `/halt` flips it; effector_speak_governed honours the
// halted bit and drains without speaking (ADR-0044 hard stop), `/resume`
// clears it. Lives outside the REPL loop so commands can mutate it.
let halted = 0

// `/speak` (Phase 19 Tier-4 #1): the agent's last reply, captured after each
// drained event. `/speak` with no text speaks this; mutated by the main loop.
let _last_reply = ""

// ---- buffered line reader ------------------------------------------------
// io_input() returns whatever sys_read drained -- on a terminal in line mode
// that's one line, but on a pipe (or after a paste) it can be several lines
// in one call. Buffer reads so the REPL always processes ONE line per turn.
let _buf = ""

fn _take_line() {
    let i = 0
    while i < len(_buf) {
        if char_at(_buf, i) == 10 {
            let line = substr(_buf, 0, i)
            _buf = substr(_buf, i + 1, len(_buf) - i - 1)
            return line
        }
        i = i + 1
    }
    let chunk = io_input()
    if len(chunk) == 0 {
        let line = _buf
        _buf = ""
        return line
    }
    _buf = _buf + chunk + "\n"
    return _take_line()
}

fn _intent1(role, lemma) {
    let it = list_new()
    let a = list_new() push(a, role) push(a, lemma)
    push(it, a)
    return it
}

// Build a gated signal and inject its strength into every routed destination
// part (ADR-0009 path from event to substrate stimulus).
fn _route_and_inject(reg, gate, stype, strength, moment) {
    let s = sig_new(stype, 0 - 1, 0 - 1, strength, moment, 0)
    let dests = gate_route(gate, s)
    let i = 0
    while i < len(dests) {
        part_inject(reg, dests[i], strength)
        i = i + 1
    }
    return dests
}

// Submit one trigger per unknown surface form (ADR-0026).
fn _submit_curiosity(arb, lang, input_text) {
    let toks = split(input_text, " ")
    let ti = 0
    while ti < len(toks) {
        let tok = str_trim(toks[ti])
        if len(tok) > 0 {
            if word_find(lang, tok) == 0 {
                slt_submit(arb, trigger_new(SLT_UNKNOWN_QUERY, tok, 800, 500))
            }
        }
        ti = ti + 1
    }
    return 1
}

// Drain the trigger arbiter, ingesting up to 4 unknowns into the KGs at idle.
// Returns how many were taught this cycle.
fn _drain_and_teach(arb, kg, lang, now) {
    let go = 1
    let taught = 0
    while go == 1 {
        if slt_queue_size(arb) == 0 { go = 0 }
        if go == 1 {
            if taught >= 4 { go = 0 }
        }
        if go == 1 {
            let trig = slt_arbiter_step(arb)
            if trig != 0 {
                let target = slt_target(trig)
                au_ingest(lang, kg, target, "u:" + target, now)
                taught = taught + 1
            }
            slt_clear_active(arb)
        }
    }
    return taught
}

// ---- admin commands ------------------------------------------------------
// All `/`-prefixed input is intercepted before it reaches the agent. Each
// handler does its thing and returns -- the input is never processed as a user
// message, so the agent's state is only what the admin explicitly changes.

// Split "/cmd rest of line" into [cmd, args]. args is "" if there was no space.
fn _split_cmd(msg) {
    let i = 0
    while i < len(msg) {
        if char_at(msg, i) == 32 {
            let pair = list_new()
            push(pair, substr(msg, 0, i))
            push(pair, str_trim(substr(msg, i + 1, len(msg) - i - 1)))
            return pair
        }
        i = i + 1
    }
    let pair = list_new()
    push(pair, msg)
    push(pair, "")
    return pair
}

fn _admin_help() {
    io_println("admin commands:")
    io_println("  /help               this listing")
    io_println("  /status             soul / mood / goal / KG / scheduler state")
    io_println("  /history [N]        last N decision-log entries (default 5)")
    io_println("  /why                explain the most recent decision")
    io_println("  /teach W            ingest W as a new word + concept binding")
    io_println("  /learn TOPIC | URL | FILE   ingest /tmp/crossengin_learn_<tag>.txt")
    io_println("                      (populate first with scripts/learn.sh ARG)")
    io_println("  /reflect [DEPTH]    forward-simulate from current conclusions; record")
    io_println("                      tentative inferences into the reflection KG (no act)")
    io_println("  /pin W C            pin word W's belief to confidence C (0..1000)")
    io_println("  /save [PATH]        durably write a snapshot to disk")
    io_println("                      (default: $CE_SNAP_PATH or /tmp/crossengin.snap)")
    io_println("  /load [PATH]        read a snapshot from disk and rehydrate the live")
    io_println("                      soul (name/purpose/mood/OCEAN/const) + KGs (atoms")
    io_println("                      merge by label; new labels create fresh atoms)")
    io_println("  /halt               stop the effector (input keeps flowing)")
    io_println("  /resume             un-halt")
    io_println("  /meta               per-source promotion / atrophy rates")
    io_println("  /speak [TEXT]       synthesize and play TEXT (or last reply); writes")
    io_println("                      /tmp/ce_speech.wav and plays via aplay if available")
    io_println("  /quit  /exit        exit chat")
    return 1
}

fn _admin_status(sl, kg, refl_kg, log, engine, hs) {
    io_println("soul     : " + soul_name(sl) + " (purpose: " + soul_purpose(sl) + ")")
    io_println("mood     : valence=" + int_to_str(soul_mood_valence(sl))
        + " arousal=" + int_to_str(soul_mood_arousal(sl)))
    io_println("knowledge: " + int_to_str(kg_atom_count(kg)) + " atoms in shared KG, "
        + int_to_str(refl_size(refl_kg)) + " tentative reflections")
    io_println("audit    : " + int_to_str(dl_count(log)) + " decision-log entries")
    io_println("scheduler: tick=" + int_to_str(hs_now(hs)) + " rate=" + int_to_str(hs_rate(hs)) + "Hz")
    let g = goal_arbitrate(engine)
    if g >= 0 {
        io_println("goal     : #" + int_to_str(g) + " " + goal_name(engine, g))
    } else {
        io_println("goal     : (none active)")
    }
    if halted == 1 { io_println("effector : HALTED") }
    return 1
}

fn _admin_history(log, n) {
    let total = dl_count(log)
    if total == 0 { io_println("(no decisions yet)") return 1 }
    let from = total - n
    if from < 0 { from = 0 }
    let i = from
    while i < total {
        let e = dl_get(log, i)
        io_println("  #" + int_to_str(dl_seq(e)) + " " + dlk_name(dl_kind(e))
            + " " + act_name(dl_action_type(e))
            + " tier=" + perm_tier_name(dl_perm_tier(e))
            + " outcome=" + out_name(dl_outcome(e)))
        i = i + 1
    }
    return 1
}

fn _admin_why(log) {
    let n = dl_count(log)
    if n == 0 { io_println("(no decisions yet)") return 1 }
    let e = dl_get(log, n - 1)
    io_println("most recent: #" + int_to_str(dl_seq(e)) + " " + act_name(dl_action_type(e))
        + " (" + rev_class_name(dl_rev_class(e)) + ")")
    io_println("  tier    : " + perm_tier_name(dl_perm_tier(e)))
    io_println("  outcome : " + out_name(dl_outcome(e)))
    io_println("  trace   : " + int_to_str(len(dl_trace(e))) + " node(s)")
    return 1
}

// Run one reflection cycle on the agent's current reasoning conclusions.
// Forward-simulates them in ikg (depth 4 by default), accumulates derived
// labels into refl_kg as Beta(2,1) tentative atoms, and prints what came up.
// The live blackboard / ctx is not touched.
fn _admin_reflect(ctx, kg, ikg, refl_kg, arg, moment) {
    let concs = ctx_conclusions(ctx)
    if len(concs) == 0 {
        io_println("(nothing recent to reflect on -- send a non-trivial message first)")
        return 1
    }
    let depth = 4
    if len(arg) > 0 {
        let d = rt_str_to_int(arg)
        if d > 0 { depth = d }
    }
    // min_confidence=0: accept every forward-simulated candidate; refl_kg
    // records each as Beta(2,1) so the prior gates premature belief, and
    // promotion still requires crossing the 750 corroboration threshold.
    let labels = refl_run(kg, ikg, refl_kg, refl_seed_from_ids(concs), depth, 0, moment)
    let n = len(labels)
    if n == 0 {
        io_println("(reflected on " + int_to_str(len(concs)) + " concept(s); no new inferences)")
        return 1
    }
    let line = "(reflected on " + int_to_str(len(concs)) + " concept(s); "
        + int_to_str(n) + " tentative inference(s):"
    let i = 0
    while i < n {
        line = line + " " + labels[i]
        if i < n - 1 { line = line + "," }
        i = i + 1
    }
    io_println(line + ")  refl_kg=" + int_to_str(refl_size(refl_kg)))
    return 1
}

fn _admin_teach(lang, kg, mo, word, now) {
    if len(word) == 0 { io_println("(/teach needs a word)") return 1 }
    let a = au_ingest(lang, kg, word, "u:" + word, now)
    // ADR-0050: tag the ingested concept atom as "user-teach" so the
    // meta-observer can score the teach path's promotion / atrophy rates.
    if a != 0 { mo_attribute(mo, "user-teach", atom_id(a)) }
    io_println("(ingested '" + word + "' -- " + int_to_str(kg_atom_count(kg)) + " atoms now)")
    return 1
}

// ---- multi-source learning helpers ---------------------------------------
// /learn accepts three source kinds: TOPIC (bare word), URL (http://...),
// and FILE (/abs, ./rel, ../rel). The scripts/learn.sh fetcher derives a
// short alphanumeric <tag> from the argument and writes its output to
// /tmp/crossengin_learn_<tag>.txt and ..._<tag>_triples.txt. The chat must
// re-derive the SAME <tag> from the user-typed argument to find those files.
// _learn_kind classifies the argument; _learn_tag computes the tag. The two
// helpers MUST stay byte-for-byte in lockstep with the case + sed pipeline
// in scripts/learn.sh -- see the comment at the top of that script.

let LEARN_KIND_TOPIC = 0
let LEARN_KIND_URL   = 1
let LEARN_KIND_FILE  = 2

// Tag for source attribution / log lines (avoids hard-coding "topic"|"url"|"file").
fn _learn_kind_name(k) {
    if k == LEARN_KIND_URL  { return "url" }
    if k == LEARN_KIND_FILE { return "file" }
    return "topic"
}

// Classify the argument: TOPIC (bare word, default), URL (http(s)://prefix),
// FILE (absolute or ./|../ relative). Mirrors the bash `case` in learn.sh.
fn _learn_kind(arg) {
    if len(arg) == 0 { return LEARN_KIND_TOPIC }
    if starts_with(arg, "http://")  == 1 { return LEARN_KIND_URL }
    if starts_with(arg, "https://") == 1 { return LEARN_KIND_URL }
    if char_at(arg, 0) == 47 { return LEARN_KIND_FILE }                   // '/'
    if len(arg) >= 2 {
        if char_at(arg, 0) == 46 {
            if char_at(arg, 1) == 47 { return LEARN_KIND_FILE }           // './'
            if len(arg) >= 3 {
                if char_at(arg, 1) == 46 {
                    if char_at(arg, 2) == 47 { return LEARN_KIND_FILE }   // '../'
                }
            }
        }
    }
    return LEARN_KIND_TOPIC
}

// True if c is alphanumeric, '_' or '-'.
fn _is_tag_alnum(c) {
    if c >= 48 { if c <= 57  { return 1 } }     // 0-9
    if c >= 65 { if c <= 90  { return 1 } }     // A-Z
    if c >= 97 { if c <= 122 { return 1 } }     // a-z
    if c == 95 { return 1 }                     // _
    if c == 45 { return 1 }                     // -
    return 0
}

// Cap a tag at 64 characters (matching `cut -c1-64`).
fn _cap_tag(s) {
    if len(s) <= 64 { return s }
    return substr(s, 0, 64)
}

// URL tag: strip scheme, swap '/' for '_', DROP non-alnum/_/-, cap 64.
// Mirrors: sed -E 's|^https?://||; s|/|_|g; s|[^a-zA-Z0-9_-]||g' | cut -c1-64
fn _learn_tag_url(arg) {
    let s = arg
    if starts_with(s, "https://") == 1 { s = substr(s, 8, len(s) - 8) }
    else { if starts_with(s, "http://") == 1 { s = substr(s, 7, len(s) - 7) } }
    let out = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 47 {                          // '/' -> '_'
            out = out + "_"
        } else {
            if _is_tag_alnum(c) == 1 {
                out = out + substr(s, i, 1)
            }
        }
        i = i + 1
    }
    return _cap_tag(out)
}

// FILE tag: take basename, strip last extension, replace non-alnum/_/- with
// '_', cap 64. Mirrors: basename | sed -E 's|\.[^.]+$||; s|[^a-zA-Z0-9_-]|_|g'
fn _learn_tag_file(arg) {
    // basename: substring after the last '/'.
    let cut = 0 - 1
    let i = 0
    while i < len(arg) {
        if char_at(arg, i) == 47 { cut = i }
        i = i + 1
    }
    let base = arg
    if cut >= 0 { base = substr(arg, cut + 1, len(arg) - cut - 1) }
    // Strip last extension (last '.' followed by 1+ non-'.' chars to end).
    // Mirrors `sed 's|\.[^.]+$||'`: only strip if there's a non-empty tail.
    let dot = 0 - 1
    let j = 0
    while j < len(base) {
        if char_at(base, j) == 46 { dot = j }
        j = j + 1
    }
    let body = base
    if dot >= 0 {
        if dot < len(base) - 1 { body = substr(base, 0, dot) }
    }
    // Replace remaining non-alnum/_/- with '_'.
    let out = ""
    let k = 0
    while k < len(body) {
        let c = char_at(body, k)
        if _is_tag_alnum(c) == 1 {
            out = out + substr(body, k, 1)
        } else {
            out = out + "_"
        }
        k = k + 1
    }
    return _cap_tag(out)
}

// Re-derive the same <tag> that scripts/learn.sh used for this argument so
// /tmp/crossengin_learn_<tag>.txt resolves to the right cache file.
fn _learn_tag(arg) {
    let kind = _learn_kind(arg)
    if kind == LEARN_KIND_URL  { return _learn_tag_url(arg) }
    if kind == LEARN_KIND_FILE { return _learn_tag_file(arg) }
    return arg
}

// Split one "S|R|O" line into a 3-element list. Returns 0 on malformed lines
// (missing/extra pipes, empty fields). Pipe (|) is U+007C = 124.
fn _split_triple(line) {
    let n = len(line)
    let p1 = -1
    let p2 = -1
    let i = 0
    while i < n {
        if char_at(line, i) == 124 {
            if p1 < 0 { p1 = i } else { if p2 < 0 { p2 = i } }
        }
        i = i + 1
    }
    if p1 < 0 { return 0 }
    if p2 < 0 { return 0 }
    if p2 <= p1 + 1 { return 0 }
    let s = str_trim(substr(line, 0, p1))
    let r = str_trim(substr(line, p1 + 1, p2 - p1 - 1))
    let o = str_trim(substr(line, p2 + 1, n - p2 - 1))
    if len(s) == 0 { return 0 }
    if len(r) == 0 { return 0 }
    if len(o) == 0 { return 0 }
    let out = list_new()
    push(out, s)
    push(out, r)
    push(out, o)
    return out
}

// Map a textual relation tag to an ROP_* kind, or 0 if unrecognised.
fn _rel_to_op_kind(r) {
    if str_eq(r, "causal") == 1 { return ROP_CAUSAL }
    if str_eq(r, "has")    == 1 { return ROP_CAUSAL }
    if str_eq(r, "is_a")   == 1 { return ROP_IMPLY }
    return 0
}

// Ingest the triples sidecar file: one "S|R|O" per line. For each triple
// whose subject AND object are both real atoms in `kg` (either from seed
// or from the vocabulary just ingested), spawn a reasoning operator atom
// linking premise -> conclusion under the appropriate ROP_* kind. Triples
// referring to unknown atoms are silently dropped -- the bash extractor is
// permissive on purpose; this is the ground-truth filter.
//
// `tag` is the lockstep-derived cache key (see _learn_tag); `src_prefix` is
// the human-readable source attribution stamped into each operator's label
// so a future meta-loop / source-authority pass can attribute the operator
// back to its source (Tier 2 item #3). Today's plumbing is the label prefix
// itself plus the kind-stamped log line _admin_learn prints -- ADR-0029's
// source_authority module already understands "src:..." conventions, so a
// future meta-observer can mine the label.
fn _admin_learn_triples(kg, tag, src_prefix, now) {
    let path = "/tmp/crossengin_learn_" + tag + "_triples.txt"
    let content = read_file(path)
    if content == 0 { return 0 }
    if len(content) == 0 { return 0 }
    let ops = 0
    let i = 0
    let line_start = 0
    let n = len(content)
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let line = str_trim(substr(content, line_start, i - line_start))
                if len(line) > 0 {
                    let parts = _split_triple(line)
                    if parts != 0 {
                        let s_atom = kg_find_atom(kg, parts[0])
                        let o_atom = kg_find_atom(kg, parts[2])
                        if s_atom != 0 {
                            if o_atom != 0 {
                                let kind = _rel_to_op_kind(parts[1])
                                if kind != 0 {
                                    let label = src_prefix + ":"
                                        + parts[0] + "-" + parts[1] + "->" + parts[2]
                                    rop_new(kg, kind, atom_id(s_atom),
                                            atom_id(o_atom), label, now)
                                    ops = ops + 1
                                }
                            }
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    return ops
}

// Read /tmp/crossengin_learn_<tag>.txt (one word per line, populated by
// scripts/learn.sh which does the actual web fetch / file read / text
// extraction) and ingest each word via the same au_ingest path /teach uses.
// NOVA has no fork/exec, so the network fetch lives in bash; the agent only
// reads from /tmp.
//
// `arg` is the literal argument the user typed at the chat prompt -- a bare
// topic name, an http(s):// URL, or an /abs/path|./rel|../rel file. We
// classify with _learn_kind and derive <tag> with _learn_tag, both of which
// match scripts/learn.sh byte for byte so the cache file resolves on the
// first try regardless of which source kind the operator used.
//
// After vocabulary, also try the structural sidecar
// /tmp/crossengin_learn_<tag>_triples.txt -- one "S|R|O" per line -- and
// turn each S/R/O whose endpoints are now real atoms into a reasoning
// operator (ADR-0031), giving the agent STRUCTURE on top of vocabulary.
//
// Source attribution: every ingested word and operator is stamped with a
// "src:<kind>:<tag>" prefix on its context / label. ADR-0029's source_authority
// module already supports a Tier-A/B/C registry keyed off host, and the
// "src:" convention threads cleanly into the same dispatch. Today's pipeline
// just stores the prefix; the P13 meta_observer (separate agent) is the
// designated consumer for promoting / atrophying atoms by source. See the
// comment block in src/learning/source_authority.nova for the contract.
fn _admin_learn(lang, kg, arg, now) {
    if len(arg) == 0 {
        io_println("(/learn needs an argument; first run: scripts/learn.sh <topic|url|file>)")
        return 1
    }
    let kind = _learn_kind(arg)
    let kname = _learn_kind_name(kind)
    let tag = _learn_tag(arg)
    let path = "/tmp/crossengin_learn_" + tag + ".txt"
    let content = read_file(path)
    if content == 0 {
        io_println("(no cache for '" + arg + "' [" + kname + "] at " + path + ")")
        io_println("  run first:  scripts/learn.sh " + arg)
        return 1
    }
    if len(content) == 0 {
        io_println("(empty cache for '" + arg + "' [" + kname + "])")
        return 1
    }
    // Stamp each ingested atom/operator with "src:<kind>:<tag>" so a future
    // meta-loop / source-authority pass (ADR-0029) can attribute corroboration
    // and atrophy back to where the evidence came from. The chat-side hook is
    // the only one available right now; the P13 meta_observer will mine this
    // string from the ingestion log line and atom labels.
    let src_prefix = "src:" + kname + ":" + tag
    let count = 0
    let i = 0
    let line_start = 0
    let n = len(content)
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let word = str_trim(substr(content, line_start, i - line_start))
                if len(word) > 0 {
                    au_ingest(lang, kg, word, src_prefix, now)
                    count = count + 1
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    let ops = _admin_learn_triples(kg, tag, src_prefix, now)
    let after = kg_atom_count(kg)
    io_println("(learned about '" + arg + "' [" + kname + "]: " + int_to_str(count)
        + " word(s), " + int_to_str(ops) + " operator(s) ingested, KG="
        + int_to_str(after) + ")")
    return 1
}

fn _admin_pin(lang, word, conf_str) {
    if len(word) == 0 {
        io_println("(usage: /pin WORD CONFIDENCE  -- confidence is 0..1000)")
        return 1
    }
    if len(conf_str) == 0 {
        io_println("(usage: /pin " + word + " CONFIDENCE  -- confidence is 0..1000)")
        return 1
    }
    let w = word_find(lang, word)
    if w == 0 { io_println("(no such word: '" + word + "')") return 1 }
    let conf = rt_str_to_int(conf_str)
    if conf < 0 { conf = 0 }
    if conf > 1000 { conf = 1000 }
    let b = atom_belief(w)
    list_set(b, 0, conf * 10)
    list_set(b, 1, (1000 - conf) * 10)
    atom_payload_set(w, "pinned", 1)
    io_println("(pinned '" + word + "' to confidence " + int_to_str(conf) + "/1000)")
    return 1
}

fn _admin_halt() {
    halted = 1
    io_println("(halted -- effector will drain; constitution still applies)")
    return 1
}

fn _admin_resume() {
    halted = 0
    io_println("(resumed)")
    return 1
}

// `/speak [TEXT]` (Phase 19 Tier-4 #1, ADR-0014): synthesize TEXT (or the
// agent's last reply if TEXT is empty) to a WAV at $CE_SPEECH_PATH (default
// /tmp/ce_speech.wav). Composes the three-mode audio bridge in
// audio_speak.nova: Mode 1 pure-NOVA phoneme synth always works; Mode 2
// escalates to espeak when on PATH; Mode 3 best-effort plays via aplay or
// paplay. The seam is closed regardless of which mode fires -- the WAV is
// the load-bearing artifact, so the prompt reports its path. The live
// language KG is passed so any seed phoneme atoms drive the carrier.
fn _admin_speak(lang, arg) {
    let text = arg
    if len(text) == 0 { text = _last_reply }
    if len(text) == 0 {
        io_println("(/speak needs TEXT, or the agent must reply at least once first)")
        return 1
    }
    let path = getenv("CE_SPEECH_PATH")
    if len(path) == 0 { path = "/tmp/ce_speech.wav" }
    let ok = effector_speak_audio_kg(text, lang, path)
    if ok == 1 {
        io_println("(spoke '" + text + "' [" + audio_modes_available()
            + "]; wrote " + path + ")")
    } else {
        io_println("(speak FAILED: could not write " + path
            + " -- check directory exists / permissions)")
    }
    return 1
}

// Build a snapshot from the live substrate. Now uses the Phase 11 full
// subsystem-blob serializers in snapshot_disk.nova: SOUL carries name +
// purpose + identity + mood + OCEAN + constitution; KGS carries the full
// atom set (every taught word in the shared concept KG and the language KG
// the chat created with `lang_kg_init`). The legacy first slots are kept
// ([0]=name for SOUL, [0]=atom_count for KGS) so the daemon's reboot print
// still works against the same image.
fn _build_snapshot(sl, kg, lang, now) {
    let snap = snap_new(1, now)
    snap_put_section(snap, SEC_SOUL, soul_section_build(sl))
    // Combine the concept KG and the language KG into one KGS blob so a
    // reload reinstalls both the concept atom AND the word atom that binds
    // it -- the perception pipeline needs the word atom to anchor the input.
    let kg_blob = kg_section_build(kg)
    let lang_blob = kg_section_build(lang)
    let merged = list_new()
    push(merged, kg_atom_count(kg) + kg_atom_count(lang))   // [0] total count
    let recs = list_new()
    let kg_recs = kg_blob[1]
    let lang_recs = lang_blob[1]
    let i = 0
    while i < len(kg_recs)   { push(recs, kg_recs[i]);   i = i + 1 }
    let j = 0
    while j < len(lang_recs) { push(recs, lang_recs[j]); j = j + 1 }
    push(merged, recs)                                       // [1] atoms
    snap_put_section(snap, SEC_KGS, merged)
    return snap
}

// Resolve the snapshot path: explicit arg overrides everything; otherwise
// CE_SNAP_PATH env; otherwise the default. Empty/missing fall through.
fn _snap_path(arg) {
    if len(arg) > 0 { return arg }
    let env = getenv("CE_SNAP_PATH")
    if len(env) > 0 { return env }
    return CE_DEFAULT_SNAP_PATH
}

// /save [PATH]: durably write a snapshot of the live soul + KG to disk.
// Uses write_tmp -> fsync -> atomic_rename -> fsync(parent) so a crash mid-
// write never corrupts the last good image.
fn _admin_save(sl, kg, lang, arg, now) {
    let path = _snap_path(arg)
    let snap = _build_snapshot(sl, kg, lang, now)
    let ok = snap_save(snap, path)
    if ok == 1 {
        io_println("(saved soul=" + soul_name(sl) + " kg=" + int_to_str(kg_atom_count(kg))
            + " atom(s) + lang=" + int_to_str(kg_atom_count(lang))
            + " atom(s) -> " + path + " durably)")
    } else {
        io_println("(save FAILED: could not write " + path + " -- check directory exists / permissions)")
    }
    return 1
}

// /load [PATH]: read a snapshot from disk and rehydrate the live substrate.
//
// Policy: REPLACE BY LABEL. SOUL is overwritten in place (name / purpose /
// identity / mood / OCEAN / constitution all swap to the snapshot values).
// The KGS blob is applied with `kg_section_apply` -- atoms are merged BY
// LABEL into the existing KGs (the seed has already been installed at chat
// boot, so the snapshot's "self" atom for example refreshes the seed's
// rather than orthogonally re-creating it). Atoms with novel labels (the
// user's taught vocabulary, e.g. "widget") are created fresh in the matching
// KG. Old-format snapshots (no `kgs.atoms.count` line) apply zero atoms and
// the load surface explains that the file predates Phase 11.
fn _admin_load(sl, kg, lang, kgreg, arg, now) {
    let path = _snap_path(arg)
    let snap = snap_load(path)
    if snap == 0 {
        io_println("(load FAILED: " + path + " missing, unreadable, or not a snapshot)")
        return 1
    }
    let soul_p = snap_has_section(snap, SEC_SOUL)
    let kgs_p = snap_has_section(snap, SEC_KGS)
    let before_kg = kg_atom_count(kg)
    let before_lang = kg_atom_count(lang)
    io_println("(loaded " + path + ":"
        + " ver=" + int_to_str(snap_version(snap))
        + " instance=" + int_to_str(snap_instance(snap))
        + " ts=" + int_to_str(snap_timestamp(snap)) + ")")
    if soul_p == 1 {
        let sb = snap_section(snap, SEC_SOUL)
        soul_section_apply(sl, sb)
        io_println("  soul: name=" + soul_name(sl) + " purpose=\"" + soul_purpose(sl)
            + "\" constcount=" + int_to_str(soul_constitution_count(sl)))
    }
    if kgs_p == 1 {
        let kb = snap_section(snap, SEC_KGS)
        let created = kg_section_apply(kgreg, kb, now)
        let after_kg = kg_atom_count(kg)
        let after_lang = kg_atom_count(lang)
        let rec_count = 0
        if len(kb) > 1 { rec_count = len(kb[1]) }
        io_println("  kgs: blob_count=" + int_to_str(kb[0])
            + " applied=" + int_to_str(rec_count)
            + " new_atoms=" + int_to_str(created))
        io_println("  reasoning KG: " + int_to_str(before_kg) + " -> "
            + int_to_str(after_kg) + " atoms")
        io_println("  language KG : " + int_to_str(before_lang) + " -> "
            + int_to_str(after_lang) + " atoms")
        if rec_count == 0 {
            if kb[0] > 0 {
                io_println("  (legacy/Phase-10 snapshot: atoms field is a metadata-only hint,"
                    + " no per-atom records to rehydrate -- agent uses the live seed only)")
            }
        }
    }
    io_println("  episodic.present=" + int_to_str(snap_has_section(snap, SEC_EPISODIC))
        + " synapses.present=" + int_to_str(snap_has_section(snap, SEC_SYNAPSES))
        + " selfmodel.present=" + int_to_str(snap_has_section(snap, SEC_SELFMODEL)))
    return 1
}

// Returns 1 if the line was an admin command (and was handled), 0 otherwise.
// /meta: poll the meta-learning observer once and print the per-source
// promotion / atrophy table. The poll is the only side effect; the operator
// can read the rates while the agent keeps running. ADR-0050.
fn _admin_meta(mo, refl_kg, kg, now) {
    mo_poll(mo, kg, refl_kg, now)
    let report = mo_report(mo)
    io_println("meta-observer status:")
    io_println("  source           atoms   tentative  durable  promotion%  atrophy%  last_poll")
    if len(report) == 0 {
        io_println("  (no attributed sources yet)")
        return 1
    }
    let i = 0
    while i < len(report) {
        let row = report[i]
        let tag = row[0]
        let promo_milli = row[1]
        let atrophy_milli = row[2]
        let sample = row[3]
        let last = row[4]
        // Re-classify against current beliefs so the table reflects right-now
        // tentative / durable counts (mo_report only carries the cumulative
        // running totals -- the visible split needs the live snapshot).
        let srcs = mo[MO_SOURCES]
        let tentative = 0
        let durable = 0
        let j = 0
        while j < len(srcs) {
            if str_eq(srcs[j][MO_MS_TAG], tag) == 1 {
                let ids = srcs[j][MO_MS_ATOM_IDS]
                let k = 0
                while k < len(ids) {
                    let a = kg_atom(kg, ids[k])
                    if a != 0 {
                        if atom_confidence(a) >= MO_DURABLE_MEAN {
                            durable = durable + 1
                        } else {
                            tentative = tentative + 1
                        }
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
        let last_str = "(never)"
        if last >= 0 { last_str = "tick " + int_to_str(last) }
        io_println("  " + _mo_pad(tag, 17) + _mo_pad(int_to_str(sample), 8)
            + _mo_pad(int_to_str(tentative), 11) + _mo_pad(int_to_str(durable), 9)
            + _mo_pad(mo_format_pct(promo_milli), 12)
            + _mo_pad(mo_format_pct(atrophy_milli), 10) + last_str)
        i = i + 1
    }
    let polls = mo_total_polls(mo)
    let refl_prom = mo_refl_promotions(mo)
    io_println("  (" + int_to_str(polls) + " poll(s) total; "
        + int_to_str(refl_prom) + " reflection-KG promotion(s) observed)")
    return 1
}

// Right-pad a string to `width` columns. Truncates if the input is wider
// (preserves alignment for long tag names).
fn _mo_pad(s, width) {
    let out = s
    let n = len(s)
    if n >= width {
        return substr(s, 0, width - 1) + " "
    }
    let i = n
    while i < width {
        out = out + " "
        i = i + 1
    }
    return out
}

fn _try_admin(msg, sl, kg, lang, ikg, refl_kg, ctx, log, engine, hs, kgreg, mo, now) {
    if len(msg) == 0 { return 0 }
    if char_at(msg, 0) != 47 { return 0 }   // not '/'
    let parts = _split_cmd(msg)
    let cmd = parts[0]
    let arg = parts[1]
    if str_eq(cmd, "/quit") == 1 { io_println("bye.") exit(0) }
    if str_eq(cmd, "/exit") == 1 { io_println("bye.") exit(0) }
    if str_eq(cmd, "/help")    == 1 { return _admin_help() }
    if str_eq(cmd, "/status")  == 1 { return _admin_status(sl, kg, refl_kg, log, engine, hs) }
    if str_eq(cmd, "/why")     == 1 { return _admin_why(log) }
    if str_eq(cmd, "/halt")    == 1 { return _admin_halt() }
    if str_eq(cmd, "/resume")  == 1 { return _admin_resume() }
    if str_eq(cmd, "/teach")   == 1 { return _admin_teach(lang, kg, mo, arg, now) }
    if str_eq(cmd, "/learn")   == 1 { return _admin_learn(lang, kg, arg, now) }
    if str_eq(cmd, "/reflect") == 1 { return _admin_reflect(ctx, kg, ikg, refl_kg, arg, now) }
    if str_eq(cmd, "/save")    == 1 { return _admin_save(sl, kg, lang, arg, now) }
    if str_eq(cmd, "/load")    == 1 { return _admin_load(sl, kg, lang, kgreg, arg, now) }
    if str_eq(cmd, "/speak")   == 1 { return _admin_speak(lang, arg) }
    if str_eq(cmd, "/meta")    == 1 { return _admin_meta(mo, refl_kg, kg, now) }
    if str_eq(cmd, "/history") == 1 {
        let n = 5
        if len(arg) > 0 { n = rt_str_to_int(arg) }
        if n <= 0 { n = 5 }
        return _admin_history(log, n)
    }
    if str_eq(cmd, "/pin") == 1 {
        let ap = _split_cmd(arg)
        return _admin_pin(lang, ap[0], ap[1])
    }
    io_println("(unknown command: " + cmd + " -- try /help)")
    return 1
}

fn main() {
    io_println("=== CrossEngin chat ===")
    io_println("state persists across turns; type 'quit' / 'exit' / empty / Ctrl-D to leave")
    io_println("type /help for admin commands (/teach, /pin, /status, /halt, ...)")
    io_println("")

    // Boot: soul, substrate, ONE shared concept KG (seed installs core +
    // medical demo), scheduler, learning arbiter.
    //
    // (Phase 18 multi-tenant note: the state below is currently the single
    //  session. A multi-tenant deployment would wrap it as:
    //    let sess = session_make(id, name, now, sl, kgreg, kg, lang, ikg,
    //                            refl_kg, ctx, log, engine, mo, hs)
    //    sreg_register(sreg, sess)
    //  ... then drive the loops over session_*(sess) accessors. The chat is
    //  intentionally NOT yet wrapped; this is the ADR-0051 foundation pass.
    //  See src/session/session.nova.)
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)
    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "world", CE_CAP, CE_FIRST)
    let kgreg = kg_registry_new()
    let kg = reasoning_kg_init(kgreg)
    let lang = lang_kg_init(kgreg)
    let ikg = imagination_kg_init(kgreg)
    seed_apply(kg, lang, ikg, 0)
    let world_kg_id = atom_kg(kg_find_atom(kg, "fever"))
    let reader = reader_new(kgreg, lang, 0)
    let stream = ms_new()
    let em = em_new()
    let cands = list_new()
    push(cands, syntax_find(lang, "ack"))
    push(cands, syntax_find(lang, "see_topic"))
    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)
    let log = dl_new()
    let ctx = ctx_new()
    let hs = hs_new(reg)
    let gate = gate_new(reg)
    gate_seed_from_parts(gate, reg)
    let arb = slt_arbiter_new()
    let refl_kg = refl_kg_init(kgreg)
    // ADR-0050: meta-learning observer. Attribute the seed-installed
    // contiguous ID block as "seed" so per-source promotion / atrophy rates
    // have a baseline; further attribution happens at /teach time.
    let mo = mo_new()
    let mo_seed_n = kg_atom_count(kg)
    let mo_si = 0
    while mo_si < mo_seed_n {
        mo_attribute(mo, "seed", mo_si)
        mo_si = mo_si + 1
    }
    let modulator = 1000
    let error = 0
    let predicted = 300
    let turn = 0

    io_println("(seed: " + int_to_str(kg_atom_count(kg)) + " atoms, "
        + soul_name(sl) + " ready)")
    io_println("")

    while 1 == 1 {
        io_print("> ")
        let msg = _take_line()
        if len(msg) == 0 {
            io_println("bye.")
            return 0
        }
        if str_eq(msg, "quit") == 1 {
            io_println("bye.")
            return 0
        }
        if str_eq(msg, "exit") == 1 {
            io_println("bye.")
            return 0
        }

        if _try_admin(msg, sl, kg, lang, ikg, refl_kg, ctx, log, engine, hs, kgreg, mo, hs_now(hs)) == 1 {
            // Admin command handled; do not feed to the agent.
        } else {

        hs_post_event(hs, EV_MESSAGE, msg)
        let reply = ""
        let last_matched = 0
        let last_unk = 0

        // Drain: each hs_step pops <=1 event and ticks once. Stop when the
        // event has been processed (idle counter starts climbing).
        let drained = 0
        let drain_steps = 0
        while drained == 0 {
            let ev = hs_step(hs, modulator, error)
            drain_steps = drain_steps + 1
            if ev != 0 {
                let raw = event_payload(ev)
                let p = transduce(IN_TEXT, raw)
                ctx_set_input(ctx, percept_text(p))
                ctx_set_idle(ctx, 0)
                ctx_set_tick(ctx, hs_now(hs))
                let matched = loop_perception_step(ctx, reader)
                last_matched = matched
                // Reflection corroboration: percept tokens whose label is
                // already in refl_kg confirm prior speculation (ADR-0023).
                let corroborated = refl_corroborate_percept(kg, refl_kg, ctx_percept(ctx))
                loop_memory_step(ctx, stream, em)
                let nconcl = loop_reasoning_step(ctx, kg)

                _route_and_inject(reg, gate, XSIG_SENSORY, 700, hs_now(hs))
                let unk = ctx_unknown(ctx)
                last_unk = unk
                if unk > 0 {
                    _route_and_inject(reg, gate, XSIG_CURIOSITY, 600, hs_now(hs))
                    _submit_curiosity(arb, lang, ctx_input(ctx))
                }

                // Affect from comprehension -> mood -> tick modulation.
                let des = matched * 300 - unk * 150
                loop_emotion_step(ctx, sl, des, 0, matched * 100)
                let val = ctx_valence(ctx)
                let aro = ctx_arousal(ctx)
                modulator = emotion_modulate_plasticity(val, aro, val)
                error = pc_residual(aro, predicted)
                predicted = aro

                let gap = 200
                if unk > 0 { gap = 700 }
                loop_goals_step(ctx, engine, gap, turn, 0, 300)

                if str_find(ctx_input(ctx), "exfiltrate") >= 0 {
                    effector_speak_governed(log, sl, ctx_input(ctx), halted, 0 - 1, list_new(), 0, hs_now(hs))
                    reply = "[refused]"
                } else {
                    // Output emerges from cognition: pick the first NEW
                    // conclusion, reverse-look up its naming word, speak it.
                    let percept = ctx_percept(ctx)
                    let concs = ctx_conclusions(ctx)
                    let intent = _intent1("ACK", "okay")
                    let derived = ""
                    let ck = 0
                    while ck < len(concs) {
                        if len(derived) == 0 {
                            let cid = concs[ck]
                            let in_p = 0
                            let pi = 0
                            while pi < len(percept) {
                                if percept[pi][1] == cid { in_p = 1 }
                                pi = pi + 1
                            }
                            if in_p == 0 {
                                let w = gen_word_for_concept(lang, world_kg_id, cid)
                                if w != 0 { derived = word_form(w) }
                            }
                        }
                        ck = ck + 1
                    }
                    if len(derived) > 0 {
                        let it = list_new()
                        let a = list_new() push(a, "SEE") push(a, "see")
                        let b = list_new() push(b, "TOPIC") push(b, derived)
                        push(it, a) push(it, b)
                        intent = it
                    }
                    let resp = gen_from_intent(lang, cands, intent, hs_now(hs))
                    let said = effector_speak_governed(log, sl, resp, halted, 0 - 1, list_new(), 0, hs_now(hs))
                    ctx_set_output(ctx, said)
                    _route_and_inject(reg, gate, XSIG_GOAL, 800, hs_now(hs))
                    reply = said
                    if len(reply) == 0 { reply = "[silent]" }
                }
                drained = 1
            } else {
                // Empty step; if we've burned many empty ticks without the
                // event being drained, bail out (defensive).
                if drain_steps > 10 { drained = 1 }
            }
        }

        // Idle-style: if curiosity triggers were submitted, drain + teach now
        // so the agent grows its KGs mid-conversation.
        let taught = _drain_and_teach(arb, kg, lang, hs_now(hs))

        // Any refl_kg atom whose belief crossed the promotion threshold this
        // turn graduates to a real concept now -- reflective speculation that
        // perception corroborated becomes accepted knowledge.
        let promoted = refl_drain_promotions(kg, lang, refl_kg, hs_now(hs))

        if len(reply) == 0 { reply = "[no response]" }
        _last_reply = reply
        io_println("agent> " + reply)
        io_println("       perceive(m=" + int_to_str(last_matched)
            + ",unk=" + int_to_str(last_unk) + ")")
        if taught > 0 {
            io_println("       (learned " + int_to_str(taught) + " new word(s) -- "
                + int_to_str(kg_atom_count(kg)) + " atoms total)")
        }
        if len(promoted) > 0 {
            let line = "       (promoted from reflection:"
            let k = 0
            while k < len(promoted) {
                line = line + " " + promoted[k]
                if k < len(promoted) - 1 { line = line + "," }
                k = k + 1
            }
            io_println(line + ")")
        }
        turn = turn + 1
        } // end else: regular agent message
    }
    return 0
}
main()
