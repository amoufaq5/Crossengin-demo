let CE_CAP   = 128
let CE_FIRST = 8

// Default snapshot path for /save and /load. Set CE_SNAP_PATH to override.
let CE_DEFAULT_SNAP_PATH = "/tmp/crossengin.snap"

// Admin / safety flag. `/halt` flips it; effector_speak_governed honours the
// halted bit and drains without speaking (ADR-0044 hard stop), `/resume`
// clears it. Lives outside the REPL loop so commands can mutate it.
let halted = 0

// `/speak` (Phase 19 Tier-4 #1): the agent's last reply, captured after each
// drained event. `/speak` with no text speaks this; mutated by the main loop.
let _last_reply = ""

// Phase 18 (Half A): in-process multi-tenant routing. `sreg` is the
// SessionRegistry (built at boot); `active_id` is the id of the session every
// turn currently dispatches into. `/switch <id>` flips `active_id` (creating
// a fresh session under that id if it does not yet exist). The default
// session is "default" with display-name "Aurora" -- existing
// ./bin/crossengin-chat invocations stay bit-identical to before because no
// /switch is ever issued.
let sreg = sreg_new()
let active_id = "default"

// P1.1: process-shared source_authority registry. `/meta-feedback` and
// `/meta-apply` read / mutate this to surface or commit tier changes derived
// from the per-session meta-observer's promotion / atrophy rates. Built once
// at boot with the ADR-0029 default host set; observer feedback can promote
// or demote synthetic hosts (`learned:topic:fever`, `learned:builtin:seed`,
// etc.) one tier at a time. See `mo_apply_feedback` in
// `src/parts/meta/meta_observer.nova` for the threshold logic.
let sauth = sa_default()

// P2.10 -- per-active-session pending compacted snapshot. When non-zero,
// `_pending_compact_snap` holds a snapshot value produced by /compact; the
// next /save reads it (instead of rebuilding from live state) and clears
// the slot. We also track `_pending_compact_session` so a /switch into a
// different session invalidates the buffer. The buffer is a single global
// -- /compact only operates on the active session.
let _pending_compact_snap = 0
let _pending_compact_session = ""

// ---- buffered line reader ------------------------------------------------
// io_input() returns whatever sys_read drained -- on a terminal in line mode
// that's one line, but on a pipe (or after a paste) it can be several lines
// in one call. Buffer reads so the REPL always processes ONE line per turn.
let _buf = ""

fn _take_line() {
    let i = 0
    while i < len(_buf) {
        if char_at(_buf, i) == 10 {
            let line = substr(_buf, 0, i)
            _buf = substr(_buf, i + 1, len(_buf) - i - 1)
            return line
        }
        i = i + 1
    }
    let chunk = io_input()
    if len(chunk) == 0 {
        let line = _buf
        _buf = ""
        return line
    }
    _buf = _buf + chunk + "\n"
    return _take_line()
}

// _intent1(role, lemma) -- extracted to src/chat/helpers.nova in P1.8 for
// unit-test reach.

// Build a gated signal and inject its strength into every routed destination
// part (ADR-0009 path from event to substrate stimulus).
fn _route_and_inject(reg, gate, stype, strength, moment) {
    let s = sig_new(stype, 0 - 1, 0 - 1, strength, moment, 0)
    let dests = gate_route(gate, s)
    let i = 0
    while i < len(dests) {
        part_inject(reg, dests[i], strength)
        i = i + 1
    }
    return dests
}

// Submit one trigger per unknown surface form (ADR-0026).
fn _submit_curiosity(arb, lang, input_text) {
    let toks = split(input_text, " ")
    let ti = 0
    while ti < len(toks) {
        let tok = str_trim(toks[ti])
        if len(tok) > 0 {
            if word_find(lang, tok) == 0 {
                slt_submit(arb, trigger_new(SLT_UNKNOWN_QUERY, tok, 800, 500))
            }
        }
        ti = ti + 1
    }
    return 1
}

// Drain the trigger arbiter, ingesting up to 4 unknowns into the KGs at idle.
// Returns how many were taught this cycle.
fn _drain_and_teach(arb, kg, lang, now) {
    let go = 1
    let taught = 0
    while go == 1 {
        if slt_queue_size(arb) == 0 { go = 0 }
        if go == 1 {
            if taught >= 4 { go = 0 }
        }
        if go == 1 {
            let trig = slt_arbiter_step(arb)
            if trig != 0 {
                let target = slt_target(trig)
                au_ingest(lang, kg, target, "u:" + target, now)
                taught = taught + 1
            }
            slt_clear_active(arb)
        }
    }
    return taught
}

// ---- admin commands ------------------------------------------------------
// All `/`-prefixed input is intercepted before it reaches the agent. Each
// handler does its thing and returns -- the input is never processed as a user
// message, so the agent's state is only what the admin explicitly changes.

// _split_cmd("/cmd rest of line") -> ["/cmd", "args"] -- extracted to
// src/chat/helpers.nova in P1.8 for unit-test reach.

fn _admin_help() {
    io_println("admin commands:")
    io_println("  /help               this listing")
    io_println("  /status             soul / mood / goal / KG / scheduler state")
    io_println("  /history [N]        last N decision-log entries (default 5)")
    io_println("  /why                explain the most recent decision")
    io_println("  /teach W            ingest W as a new word + concept binding")
    io_println("  /learn TOPIC | URL | FILE | @batch | rss:URL | dir:PATH")
    io_println("                      ingest /tmp/crossengin_learn_<tag>.txt")
    io_println("                      (populate first with scripts/learn.sh ARG)")
    io_println("  /reflect [DEPTH]    forward-simulate from current conclusions; record")
    io_println("                      tentative inferences into the reflection KG (no act)")
    io_println("  /pin W C            pin word W's belief to confidence C (0..1000)")
    io_println("  /save [PATH]        durably write a snapshot to disk")
    io_println("                      (default: $CE_SNAP_PATH or /tmp/crossengin.snap)")
    io_println("  /load [PATH]        read a snapshot from disk and rehydrate the live")
    io_println("                      soul (name/purpose/mood/OCEAN/const) + KGs (atoms")
    io_println("                      merge by label; new labels create fresh atoms)")
    io_println("  /halt               stop the effector (input keeps flowing)")
    io_println("  /resume             un-halt")
    io_println("  /meta               per-source promotion / atrophy rates")
    io_println("  /meta-feedback      dry-run: what source_authority tier changes the")
    io_println("                      observer's feedback WOULD apply right now")
    io_println("  /meta-apply         commit those source_authority tier changes")
    io_println("  /speak [TEXT]       synthesize and play TEXT (or last reply); writes")
    io_println("                      /tmp/ce_speech.wav and plays via aplay if available")
    io_println("  /switch [ID]        list sessions (no arg) or activate/create ID")
    io_println("  /seed [PACK]        list domain seed packs (no arg) or install PACK")
    io_println("  /compact [--dry-run] compact the in-memory snapshot: drop dead atoms")
    io_println("                      (mean<0.05), archived episodes, old moments, and")
    io_println("                      sub-threshold synapses; next /save writes the")
    io_println("                      compacted form. Knobs: CE_COMPACT_DEAD_BELIEF /")
    io_println("                      _MOMENT_MAX_AGE_NS / _SYNAPSE_THRESHOLD")
    io_println("  /__metrics__        (internal) machine-readable key=value lines for")
    io_println("                      scripts/web.py's /metrics Prometheus scraper")
    io_println("  /ann_query LABEL    (debug) top-5 nearest atoms by LSH-bucketed cosine")
    io_println("  /prove P C [DEPTH]  find an operator-chain proof from atom labelled P")
    io_println("                      to atom labelled C (bounded BFS, default depth 6)")
    io_println("  /dp_status          print the session's differential-privacy budget")
    io_println("  /dp_query TARGET    run a DP-noised KG query (TARGET=atoms; 0.1 eps)")
    io_println("  /quit  /exit        exit chat")
    return 1
}

fn _admin_status(sl, kg, refl_kg, log, engine, hs, stream, em, syn_g, sm) {
    io_println("soul     : " + soul_name(sl) + " (purpose: " + soul_purpose(sl) + ")")
    io_println("mood     : valence=" + int_to_str(soul_mood_valence(sl))
        + " arousal=" + int_to_str(soul_mood_arousal(sl)))
    io_println("knowledge: " + int_to_str(kg_atom_count(kg)) + " atoms in shared KG, "
        + int_to_str(refl_size(refl_kg)) + " tentative reflections")
    io_println("audit    : " + int_to_str(dl_count(log)) + " decision-log entries")
    // P0.1 follow-up: surface the durable-snapshot subsystems so a /load can
    // be verified post-restart by reading /status. The headline acceptance
    // test asserts moments/synapses survive a round-trip.
    io_println("moments  : " + int_to_str(ms_count(stream)) + " moment(s), "
        + int_to_str(em_count(em)) + " episode(s)")
    io_println("synapses : " + int_to_str(syn_live(syn_g)) + " live edge(s) (reasoning part)")
    io_println("selfmodel: " + int_to_str(self_model_count(sm)) + " competence record(s)")
    io_println("scheduler: tick=" + int_to_str(hs_now(hs)) + " rate=" + int_to_str(hs_rate(hs)) + "Hz")
    let g = goal_arbitrate(engine)
    if g >= 0 {
        io_println("goal     : #" + int_to_str(g) + " " + goal_name(engine, g))
    } else {
        io_println("goal     : (none active)")
    }
    if halted == 1 { io_println("effector : HALTED") }
    return 1
}

fn _admin_history(log, n) {
    let total = dl_count(log)
    if total == 0 { io_println("(no decisions yet)") return 1 }
    let from = total - n
    if from < 0 { from = 0 }
    let i = from
    while i < total {
        let e = dl_get(log, i)
        io_println("  #" + int_to_str(dl_seq(e)) + " " + dlk_name(dl_kind(e))
            + " " + act_name(dl_action_type(e))
            + " tier=" + perm_tier_name(dl_perm_tier(e))
            + " outcome=" + out_name(dl_outcome(e)))
        i = i + 1
    }
    return 1
}

fn _admin_why(log) {
    let n = dl_count(log)
    if n == 0 { io_println("(no decisions yet)") return 1 }
    let e = dl_get(log, n - 1)
    io_println("most recent: #" + int_to_str(dl_seq(e)) + " " + act_name(dl_action_type(e))
        + " (" + rev_class_name(dl_rev_class(e)) + ")")
    io_println("  tier    : " + perm_tier_name(dl_perm_tier(e)))
    io_println("  outcome : " + out_name(dl_outcome(e)))
    io_println("  trace   : " + int_to_str(len(dl_trace(e))) + " node(s)")
    return 1
}

// Run one reflection cycle on the agent's current reasoning conclusions.
// Forward-simulates them in ikg (depth 4 by default), accumulates derived
// labels into refl_kg as Beta(2,1) tentative atoms, and prints what came up.
// The live blackboard / ctx is not touched.
fn _admin_reflect(ctx, kg, ikg, refl_kg, arg, moment) {
    let concs = ctx_conclusions(ctx)
    if len(concs) == 0 {
        io_println("(nothing recent to reflect on -- send a non-trivial message first)")
        return 1
    }
    let depth = 4
    if len(arg) > 0 {
        let d = rt_str_to_int(arg)
        if d > 0 { depth = d }
    }
    // min_confidence=0: accept every forward-simulated candidate; refl_kg
    // records each as Beta(2,1) so the prior gates premature belief, and
    // promotion still requires crossing the 750 corroboration threshold.
    let labels = refl_run(kg, ikg, refl_kg, refl_seed_from_ids(concs), depth, 0, moment)
    let n = len(labels)
    if n == 0 {
        io_println("(reflected on " + int_to_str(len(concs)) + " concept(s); no new inferences)")
        return 1
    }
    let line = "(reflected on " + int_to_str(len(concs)) + " concept(s); "
        + int_to_str(n) + " tentative inference(s):"
    let i = 0
    while i < n {
        line = line + " " + labels[i]
        if i < n - 1 { line = line + "," }
        i = i + 1
    }
    io_println(line + ")  refl_kg=" + int_to_str(refl_size(refl_kg)))
    return 1
}

fn _admin_teach(lang, kg, mo, word, now) {
    if len(word) == 0 { io_println("(/teach needs a word)") return 1 }
    let a = au_ingest(lang, kg, word, "u:" + word, now)
    // ADR-0050: tag the ingested concept atom as "user-teach" so the
    // meta-observer can score the teach path's promotion / atrophy rates.
    if a != 0 { mo_attribute(mo, "user-teach", atom_id(a)) }
    io_println("(ingested '" + word + "' -- " + int_to_str(kg_atom_count(kg)) + " atoms now)")
    return 1
}

// ---- multi-source learning helpers ---------------------------------------
// /learn accepts SIX source kinds: TOPIC (bare word), URL (http://...),
// FILE (/abs, ./rel, ../rel) and three new composite kinds (P1.5):
// BATCH (@/path/urls.txt -- one URL per line), RSS (rss:URL -- feed of links),
// DIR (dir:/path -- recursive .txt+.md walk). The scripts/learn.sh fetcher
// derives a short alphanumeric <tag> from the argument and writes its output
// to /tmp/crossengin_learn_<tag>.txt and ..._<tag>_triples.txt; for composite
// kinds it also writes per-item caches (per-URL or per-file) under their own
// tags and concatenates them into the combined cache for the composite tag.
// The chat must re-derive the SAME <tag> from the user-typed argument to
// find those files. _learn_kind classifies the argument; _learn_tag computes
// the tag. The two helpers MUST stay byte-for-byte in lockstep with the
// case + sed pipeline in scripts/learn.sh -- see the comment at the top of
// that script.


// LEARN_KIND_* constants, _learn_kind, _learn_kind_name, _is_tag_alnum,
// _cap_tag, _learn_tag_url, _learn_tag_file, _tag_sanitise, _learn_tag_batch,
// _learn_tag_rss, _basename, _learn_tag_dir, _learn_tag, _split_triple --
// all extracted to src/chat/helpers.nova in P1.8 for unit-test reach (see
// tests/unit/test_chat_helpers.nova).

// Map a textual relation tag to an ROP_* kind, or 0 if unrecognised.
fn _rel_to_op_kind(r) {
    if str_eq(r, "causal") == 1 { return ROP_CAUSAL }
    if str_eq(r, "has")    == 1 { return ROP_CAUSAL }
    if str_eq(r, "is_a")   == 1 { return ROP_IMPLY }
    return 0
}

// Ingest the triples sidecar file: one "S|R|O" per line. For each triple
// whose subject AND object are both real atoms in `kg` (either from seed
// or from the vocabulary just ingested), spawn a reasoning operator atom
// linking premise -> conclusion under the appropriate ROP_* kind. Triples
// referring to unknown atoms are silently dropped -- the bash extractor is
// permissive on purpose; this is the ground-truth filter.
//
// `tag` is the lockstep-derived cache key (see _learn_tag); `src_prefix` is
// the human-readable source attribution stamped into each operator's label
// so a future meta-loop / source-authority pass can attribute the operator
// back to its source (Tier 2 item #3). Today's plumbing is the label prefix
// itself plus the kind-stamped log line _admin_learn prints -- ADR-0029's
// source_authority module already understands "src:..." conventions, so a
// future meta-observer can mine the label.
fn _admin_learn_triples(kg, tag, src_prefix, now) {
    let path = "/tmp/crossengin_learn_" + tag + "_triples.txt"
    let content = read_file(path)
    if content == 0 { return 0 }
    if len(content) == 0 { return 0 }
    let ops = 0
    let i = 0
    let line_start = 0
    let n = len(content)
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let line = str_trim(substr(content, line_start, i - line_start))
                if len(line) > 0 {
                    let parts = _split_triple(line)
                    if parts != 0 {
                        let s_atom = kg_find_atom(kg, parts[0])
                        let o_atom = kg_find_atom(kg, parts[2])
                        if s_atom != 0 {
                            if o_atom != 0 {
                                let kind = _rel_to_op_kind(parts[1])
                                if kind != 0 {
                                    let label = src_prefix + ":"
                                        + parts[0] + "-" + parts[1] + "->" + parts[2]
                                    rop_new(kg, kind, atom_id(s_atom),
                                            atom_id(o_atom), label, now)
                                    ops = ops + 1
                                }
                            }
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    return ops
}

// Ingest a single /tmp/crossengin_learn_<tag>.txt + the matching triples
// sidecar. Returns a 2-element list [words_ingested, ops_ingested], or 0 if
// no cache exists at the given tag. Factored out so the P1.5 BATCH dispatch
// can call it once per URL after the combined-cache ingestion.
fn _learn_ingest_one(lang, kg, tag, src_prefix, now) {
    let path = "/tmp/crossengin_learn_" + tag + ".txt"
    let content = read_file(path)
    if content == 0 { return 0 }
    if len(content) == 0 {
        let zero = list_new()
        push(zero, 0)
        push(zero, 0)
        return zero
    }
    let count = 0
    let i = 0
    let line_start = 0
    let n = len(content)
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let word = str_trim(substr(content, line_start, i - line_start))
                if len(word) > 0 {
                    au_ingest(lang, kg, word, src_prefix, now)
                    count = count + 1
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    let ops = _admin_learn_triples(kg, tag, src_prefix, now)
    let res = list_new()
    push(res, count)
    push(res, ops)
    return res
}

// Walk a BATCH list file (the @arg points at a local text file with one URL
// per line) and call ingest_one for each per-URL tag. The combined cache was
// already ingested by the caller; this pass attributes each per-URL cache
// back to its own URL-derived tag so the P13 meta_observer can score URLs
// individually. Blank lines and '#' comments are skipped, matching the bash
// loop in scripts/learn.sh. Returns [words_added, ops_added, urls_seen].
fn _learn_ingest_batch_per_url(lang, kg, list_path, now) {
    let words = 0
    let ops = 0
    let urls = 0
    let content = read_file(list_path)
    if content == 0 {
        let res = list_new()
        push(res, 0) push(res, 0) push(res, 0)
        return res
    }
    let n = len(content)
    let i = 0
    let line_start = 0
    while i <= n {
        let bound = 0
        if i == n {
            bound = 1
        } else {
            if char_at(content, i) == 10 { bound = 1 }
        }
        if bound == 1 {
            if i > line_start {
                let url = str_trim(substr(content, line_start, i - line_start))
                // Skip blanks and '#' comments (comment char is U+0023 = 35).
                let skip = 0
                if len(url) == 0 { skip = 1 }
                if skip == 0 {
                    if char_at(url, 0) == 35 { skip = 1 }
                }
                if skip == 0 {
                    urls = urls + 1
                    // Each URL gets its own tag via _learn_tag (which dispatches
                    // to _learn_tag_url for http(s):// inputs) and its own
                    // attribution prefix so the meta-observer can promote /
                    // atrophy per URL, not per batch.
                    let url_tag = _learn_tag(url)
                    let url_prefix = "src:url:" + url_tag
                    let pair = _learn_ingest_one(lang, kg, url_tag, url_prefix, now)
                    if pair != 0 {
                        words = words + pair[0]
                        ops = ops + pair[1]
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    let res = list_new()
    push(res, words) push(res, ops) push(res, urls)
    return res
}

// Read /tmp/crossengin_learn_<tag>.txt (one word per line, populated by
// scripts/learn.sh which does the actual web fetch / file read / text
// extraction) and ingest each word via the same au_ingest path /teach uses.
// NOVA has no fork/exec, so the network fetch lives in bash; the agent only
// reads from /tmp.
//
// `arg` is the literal argument the user typed at the chat prompt. We
// classify with _learn_kind and derive <tag> with _learn_tag, both of which
// match scripts/learn.sh byte for byte so the cache file resolves on the
// first try regardless of which source kind the operator used:
//   - TOPIC / URL / FILE: single cache file
//   - BATCH (@list):      combined cache + per-URL caches iterated here
//   - RSS  (rss:URL):     combined cache only (per-link caches are already
//                         merged into the combined cache by bash)
//   - DIR  (dir:PATH):    combined cache only (per-file caches are already
//                         merged into the combined cache by bash)
//
// After vocabulary, also try the structural sidecar
// /tmp/crossengin_learn_<tag>_triples.txt -- one "S|R|O" per line -- and
// turn each S/R/O whose endpoints are now real atoms into a reasoning
// operator (ADR-0031), giving the agent STRUCTURE on top of vocabulary.
//
// Source attribution: every ingested word and operator is stamped with a
// "src:<kind>:<tag>" prefix on its context / label. ADR-0029's source_authority
// module already supports a Tier-A/B/C registry keyed off host, and the
// "src:" convention threads cleanly into the same dispatch. Today's pipeline
// just stores the prefix; the P13 meta_observer (separate agent) is the
// designated consumer for promoting / atrophying atoms by source. See the
// comment block in src/learning/source_authority.nova for the contract.
fn _admin_learn(lang, kg, arg, now) {
    if len(arg) == 0 {
        io_println("(/learn needs an argument; first run: scripts/learn.sh <topic|url|file|@batch|rss:URL|dir:PATH>)")
        return 1
    }
    let kind = _learn_kind(arg)
    let kname = _learn_kind_name(kind)
    let tag = _learn_tag(arg)
    let path = "/tmp/crossengin_learn_" + tag + ".txt"
    // Stamp each ingested atom/operator with "src:<kind>:<tag>" so a future
    // meta-loop / source-authority pass (ADR-0029) can attribute corroboration
    // and atrophy back to where the evidence came from. The chat-side hook is
    // the only one available right now; the P13 meta_observer will mine this
    // string from the ingestion log line and atom labels.
    let src_prefix = "src:" + kname + ":" + tag
    // First, ingest the (combined or single) cache the same way for all kinds.
    let primary = _learn_ingest_one(lang, kg, tag, src_prefix, now)
    if primary == 0 {
        io_println("(no cache for '" + arg + "' [" + kname + "] at " + path + ")")
        io_println("  run first:  scripts/learn.sh " + arg)
        return 1
    }
    let count = primary[0]
    let ops = primary[1]
    if count == 0 {
        if ops == 0 {
            io_println("(empty cache for '" + arg + "' [" + kname + "])")
            return 1
        }
    }
    // BATCH adds a per-URL pass on top of the combined ingestion: the chat
    // reads the same urls.txt the bash batch loop read, derives each URL's
    // tag with _learn_tag, and pulls /tmp/crossengin_learn_<url-tag>.txt
    // separately so each URL gets its own src: attribution. Per-URL caches
    // that don't exist on disk are silently skipped (matches bash batch's
    // tolerance for individual fetch failures).
    if kind == LEARN_KIND_BATCH {
        let list_path = arg
        if len(list_path) >= 1 {
            if char_at(list_path, 0) == 64 {
                list_path = substr(list_path, 1, len(list_path) - 1)
            }
        }
        let extra = _learn_ingest_batch_per_url(lang, kg, list_path, now)
        let after = kg_atom_count(kg)
        io_println("(learned about '" + arg + "' [" + kname + "]: combined "
            + int_to_str(count) + " word(s) " + int_to_str(ops)
            + " op(s); per-URL " + int_to_str(extra[0]) + " word(s) "
            + int_to_str(extra[1]) + " op(s) across " + int_to_str(extra[2])
            + " URL(s), KG=" + int_to_str(after) + ")")
        return 1
    }
    let after = kg_atom_count(kg)
    io_println("(learned about '" + arg + "' [" + kname + "]: " + int_to_str(count)
        + " word(s), " + int_to_str(ops) + " operator(s) ingested, KG="
        + int_to_str(after) + ")")
    return 1
}

fn _admin_pin(lang, word, conf_str) {
    if len(word) == 0 {
        io_println("(usage: /pin WORD CONFIDENCE  -- confidence is 0..1000)")
        return 1
    }
    if len(conf_str) == 0 {
        io_println("(usage: /pin " + word + " CONFIDENCE  -- confidence is 0..1000)")
        return 1
    }
    let w = word_find(lang, word)
    if w == 0 { io_println("(no such word: '" + word + "')") return 1 }
    let conf = rt_str_to_int(conf_str)
    if conf < 0 { conf = 0 }
    if conf > 1000 { conf = 1000 }
    let b = atom_belief(w)
    list_set(b, 0, conf * 10)
    list_set(b, 1, (1000 - conf) * 10)
    atom_payload_set(w, "pinned", 1)
    io_println("(pinned '" + word + "' to confidence " + int_to_str(conf) + "/1000)")
    return 1
}

fn _admin_halt() {
    halted = 1
    io_println("(halted -- effector will drain; constitution still applies)")
    return 1
}

fn _admin_resume() {
    halted = 0
    io_println("(resumed)")
    return 1
}

// `/speak [TEXT]` (Phase 19 Tier-4 #1, ADR-0014): synthesize TEXT (or the
// agent's last reply if TEXT is empty) to a WAV at $CE_SPEECH_PATH (default
// /tmp/ce_speech.wav). Composes the three-mode audio bridge in
// audio_speak.nova: Mode 1 pure-NOVA phoneme synth always works; Mode 2
// escalates to espeak when on PATH; Mode 3 best-effort plays via aplay or
// paplay. The seam is closed regardless of which mode fires -- the WAV is
// the load-bearing artifact, so the prompt reports its path. The live
// language KG is passed so any seed phoneme atoms drive the carrier.
fn _admin_speak(lang, arg) {
    let text = arg
    if len(text) == 0 { text = _last_reply }
    if len(text) == 0 {
        io_println("(/speak needs TEXT, or the agent must reply at least once first)")
        return 1
    }
    let path = getenv("CE_SPEECH_PATH")
    if len(path) == 0 { path = "/tmp/ce_speech.wav" }
    let ok = effector_speak_audio_kg(text, lang, path)
    if ok == 1 {
        io_println("(spoke '" + text + "' [" + audio_modes_available()
            + "]; wrote " + path + ")")
    } else {
        io_println("(speak FAILED: could not write " + path
            + " -- check directory exists / permissions)")
    }
    return 1
}

// Build a snapshot from the live substrate. Now uses the Phase 11 full
// subsystem-blob serializers in snapshot_disk.nova: SOUL carries name +
// purpose + identity + mood + OCEAN + constitution; KGS carries the full
// atom set (every taught word in the shared concept KG and the language KG
// the chat created with `lang_kg_init`). The legacy first slots are kept
// ([0]=name for SOUL, [0]=atom_count for KGS) so the daemon's reboot print
// still works against the same image.
fn _build_snapshot(sl, kg, lang, stream, em, syn_g, sm, now) {
    let snap = snap_new(1, now)
    snap_put_section(snap, SEC_SOUL, soul_section_build(sl))
    // Combine the concept KG and the language KG into one KGS blob so a
    // reload reinstalls both the concept atom AND the word atom that binds
    // it -- the perception pipeline needs the word atom to anchor the input.
    let kg_blob = kg_section_build(kg)
    let lang_blob = kg_section_build(lang)
    let merged = list_new()
    push(merged, kg_atom_count(kg) + kg_atom_count(lang))   // [0] total count
    let recs = list_new()
    let kg_recs = kg_blob[1]
    let lang_recs = lang_blob[1]
    let i = 0
    while i < len(kg_recs)   { push(recs, kg_recs[i]);   i = i + 1 }
    let j = 0
    while j < len(lang_recs) { push(recs, lang_recs[j]); j = j + 1 }
    push(merged, recs)                                       // [1] atoms
    snap_put_section(snap, SEC_KGS, merged)
    // P0.1 (this edit): EPISODIC / SYNAPSES / SELFMODEL also carry full
    // payloads. EPISODIC persists moment timestamps/lifecycle/traces and
    // episode tiers via `stream` + `em`. SYNAPSES persists the reasoning
    // part's synapse graph (chosen as the most learning-bearing graph --
    // multi-part synapse capture is a separate phase). SELFMODEL persists
    // the per-domain competence record list.
    snap_put_section(snap, SEC_EPISODIC,  episodic_section_build(stream, em))
    snap_put_section(snap, SEC_SYNAPSES,  synapses_section_build(syn_g))
    snap_put_section(snap, SEC_SELFMODEL, selfmodel_section_build(sm))
    return snap
}

// Resolve the snapshot path for /save and /load.
//
// Precedence (P1.2):
//   1. an explicit path argument typed at the prompt (`/save /tmp/x.snap`).
//   2. `$CE_SNAP_PATH` (legacy single-file mode -- back-compat with pre-P1.2
//      operator scripts that pin one path for the whole process).
//   3. `$CE_SNAP_DIR/crossengin.<session_id>.snap` (default
//      `$CE_SNAP_DIR=/tmp`) -- the per-tenant on-disk image; the active
//      session id is threaded in by the caller.
//
// Steps 2 + 3 are delegated to `session_snap_path(session_id)` so the chat
// and the daemon resolve the SAME path for the same session, regardless of
// which binary writes first.
fn _snap_path(arg, session_id) {
    if len(arg) > 0 { return arg }
    return session_snap_path(session_id)
}

// /save [PATH]: durably write a snapshot of the live soul + KG to disk.
// Uses write_tmp -> fsync -> atomic_rename -> fsync(parent) so a crash mid-
// write never corrupts the last good image. Path resolution: an explicit
// PATH wins; otherwise the active session's per-session file under
// `$CE_SNAP_DIR/crossengin.<session_id>.snap` (legacy `$CE_SNAP_PATH` still
// honoured) -- so a `/switch alice` then `/save` writes alice's image,
// leaving the default tenant's snapshot at its own path untouched (P1.2).
fn _admin_save(sl, kg, lang, stream, em, syn_g, sm, arg, session_id, now) {
    let path = _snap_path(arg, session_id)
    // P2.10: if /compact stashed a compacted snapshot for this session, write
    // THAT instead of rebuilding from live state.
    let snap = 0
    let used_pending = 0
    if _pending_compact_snap != 0 {
        if str_eq(_pending_compact_session, session_id) == 1 {
            snap = _pending_compact_snap
            used_pending = 1
        }
    }
    if snap == 0 {
        snap = _build_snapshot(sl, kg, lang, stream, em, syn_g, sm, now)
    }
    let ok = snap_save(snap, path)
    if ok == 1 {
        if used_pending == 1 {
            let kgs_recs = 0
            let kgs_blob = snap_section(snap, SEC_KGS)
            if kgs_blob != 0 {
                if len(kgs_blob) > 1 { kgs_recs = len(kgs_blob[1]) }
            }
            let mom_count = ms_count(stream)
            let ep_blob = snap_section(snap, SEC_EPISODIC)
            if ep_blob != 0 {
                if len(ep_blob) > 0 { mom_count = len(ep_blob[0]) }
            }
            let syn_count = syn_live(syn_g)
            let syn_blob = snap_section(snap, SEC_SYNAPSES)
            if syn_blob != 0 {
                if len(syn_blob) > 1 { syn_count = len(syn_blob[1]) }
            }
            io_println("(saved compacted snapshot: kg=" + int_to_str(kgs_recs)
                + " atom(s), " + int_to_str(mom_count)
                + " moment(s), " + int_to_str(syn_count)
                + " syn(s) -> " + path + " durably)")
        } else {
            io_println("(saved soul=" + soul_name(sl) + " kg=" + int_to_str(kg_atom_count(kg))
                + " atom(s) + lang=" + int_to_str(kg_atom_count(lang))
                + " atom(s) + " + int_to_str(ms_count(stream))
                + " moment(s) + " + int_to_str(syn_live(syn_g))
                + " syn(s) + " + int_to_str(self_model_count(sm))
                + " competence record(s) -> " + path + " durably)")
        }
    } else {
        io_println("(save FAILED: could not write " + path + " -- check directory exists / permissions)")
    }
    _pending_compact_snap = 0
    _pending_compact_session = ""
    return 1
}

// /load [PATH]: read a snapshot from disk and rehydrate the live substrate.
//
// Policy: REPLACE BY LABEL for KGS atoms (idempotent merge). For EPISODIC /
// SYNAPSES / SELFMODEL the policy is straight REPLACE -- the snapshot is the
// new ground truth, and a /load is "boot from this state", not "merge". The
// live `stream` / `em` get wiped to length zero before reinstalling moments
// + episodes; the reasoning part's synapse graph gets each pre->post edge
// overwritten (idempotent on a second /load); the self-model gets cleared
// + reinstalled. Path resolution follows the same per-session contract as
// /save (P1.2): explicit PATH wins, else per-session file derived from the
// active session id.
fn _admin_load(sl, kg, lang, kgreg, stream, em, syn_g, sm, arg, session_id, now) {
    let path = _snap_path(arg, session_id)
    let snap = snap_load(path)
    if snap == 0 {
        io_println("(load FAILED: " + path + " missing, unreadable, or not a snapshot)")
        return 1
    }
    let soul_p = snap_has_section(snap, SEC_SOUL)
    let kgs_p = snap_has_section(snap, SEC_KGS)
    let ep_p  = snap_has_section(snap, SEC_EPISODIC)
    let syn_p = snap_has_section(snap, SEC_SYNAPSES)
    let sm_p  = snap_has_section(snap, SEC_SELFMODEL)
    let before_kg = kg_atom_count(kg)
    let before_lang = kg_atom_count(lang)
    io_println("(loaded " + path + ":"
        + " ver=" + int_to_str(snap_version(snap))
        + " instance=" + int_to_str(snap_instance(snap))
        + " ts=" + int_to_str(snap_timestamp(snap)) + ")")
    if soul_p == 1 {
        let sb = snap_section(snap, SEC_SOUL)
        soul_section_apply(sl, sb)
        io_println("  soul: name=" + soul_name(sl) + " purpose=\"" + soul_purpose(sl)
            + "\" constcount=" + int_to_str(soul_constitution_count(sl)))
    }
    if kgs_p == 1 {
        let kb = snap_section(snap, SEC_KGS)
        let created = kg_section_apply(kgreg, kb, now)
        let after_kg = kg_atom_count(kg)
        let after_lang = kg_atom_count(lang)
        let rec_count = 0
        if len(kb) > 1 { rec_count = len(kb[1]) }
        io_println("  kgs: blob_count=" + int_to_str(kb[0])
            + " applied=" + int_to_str(rec_count)
            + " new_atoms=" + int_to_str(created))
        io_println("  reasoning KG: " + int_to_str(before_kg) + " -> "
            + int_to_str(after_kg) + " atoms")
        io_println("  language KG : " + int_to_str(before_lang) + " -> "
            + int_to_str(after_lang) + " atoms")
        if rec_count == 0 {
            if kb[0] > 0 {
                io_println("  (legacy/Phase-10 snapshot: atoms field is a metadata-only hint,"
                    + " no per-atom records to rehydrate -- agent uses the live seed only)")
            }
        }
    }
    if ep_p == 1 {
        let eb = snap_section(snap, SEC_EPISODIC)
        let restored = episodic_section_apply(stream, em, eb)
        io_println("  episodic: " + int_to_str(restored) + " moment(s) + "
            + int_to_str(em_count(em)) + " episode(s) restored")
    }
    if syn_p == 1 {
        let sb = snap_section(snap, SEC_SYNAPSES)
        let n = synapses_section_apply(syn_g, sb)
        io_println("  synapses: " + int_to_str(n) + " edge(s) restored (threshold="
            + int_to_str(sb[0]) + " milli)")
    }
    if sm_p == 1 {
        let mb = snap_section(snap, SEC_SELFMODEL)
        let n = selfmodel_section_apply(sm, mb)
        io_println("  selfmodel: " + int_to_str(n) + " competence record(s) restored")
    }
    return 1
}

// /compact [--dry-run] (P2.10): run a compaction pass over the active
// session's live state and either (a) cache the compacted snapshot for the
// next /save (default) or (b) print the would-be stats without mutating the
// pending-snapshot slot (--dry-run). Stats reported:
//   - dead atoms dropped (mean < CE_COMPACT_DEAD_BELIEF, default 0.05)
//   - archived episodes dropped (tier == EP_ARCHIVED)
//   - moments older than CE_COMPACT_MOMENT_MAX_AGE_NS dropped
//   - synapses with |weight| below CE_COMPACT_SYNAPSE_THRESHOLD (default
//     0.2 milli, tighter than the wire-format default of 0.1) dropped
//   - on-disk size delta: live-state snapshot size vs compacted size
//
// The "live state snapshot" is built fresh here (via _build_snapshot) so
// the size delta reflects what /save WOULD have written without /compact
// vs what it WILL write with the compaction cached. On a non-dry run, the
// compacted snapshot is stashed in `_pending_compact_snap` keyed by the
// active session id; _admin_save consumes it.
//
// Bytes -> KB rounding uses integer arithmetic (1000-based, matches `du
// --si`).
fn _admin_compact(sl, kg, lang, stream, em, syn_g, sm, arg, session_id, now) {
    let dry = 0
    if str_eq(arg, "--dry-run") == 1 { dry = 1 }
    let live_snap = _build_snapshot(sl, kg, lang, stream, em, syn_g, sm, now)
    let opts = compact_opts_from_env()
    let stats = snap_compact_stats(live_snap, opts)
    let dead_drop = stats[0]
    let ep_drop = stats[1]
    let m_drop = stats[2]
    let syn_drop = stats[3]
    let before_text = snap_to_text(live_snap)
    let before_bytes = len(before_text)
    let compacted = snap_compact(live_snap, opts)
    let after_text = snap_to_text(compacted)
    let after_bytes = len(after_text)
    let before_kb = before_bytes / 1000
    let after_kb = after_bytes / 1000
    let mode_str = ""
    if dry == 1 { mode_str = " (dry-run)" }
    io_println("(compacted" + mode_str + ": "
        + int_to_str(dead_drop) + " dead atoms dropped, "
        + int_to_str(ep_drop) + " archived episodes dropped, "
        + int_to_str(m_drop) + " old moments dropped, "
        + int_to_str(syn_drop) + " synapses below new threshold dropped; "
        + "snapshot " + int_to_str(before_kb) + "KB -> "
        + int_to_str(after_kb) + "KB)")
    if dry == 0 {
        _pending_compact_snap = compacted
        _pending_compact_session = session_id
        io_println("(in-memory snapshot replaced; next /save writes the compacted form)")
    }
    return 1
}

// Returns 1 if the line was an admin command (and was handled), 0 otherwise.
// /meta: poll the meta-learning observer once and print the per-source
// promotion / atrophy table. The poll is the only side effect; the operator
// can read the rates while the agent keeps running. ADR-0050.
fn _admin_meta(mo, refl_kg, kg, now) {
    mo_poll(mo, kg, refl_kg, now)
    let report = mo_report(mo)
    io_println("meta-observer status:")
    io_println("  source           atoms   tentative  durable  promotion%  atrophy%  last_poll")
    if len(report) == 0 {
        io_println("  (no attributed sources yet)")
        return 1
    }
    let i = 0
    while i < len(report) {
        let row = report[i]
        let tag = row[0]
        let promo_milli = row[1]
        let atrophy_milli = row[2]
        let sample = row[3]
        let last = row[4]
        // Re-classify against current beliefs so the table reflects right-now
        // tentative / durable counts (mo_report only carries the cumulative
        // running totals -- the visible split needs the live snapshot).
        let srcs = mo[MO_SOURCES]
        let tentative = 0
        let durable = 0
        let j = 0
        while j < len(srcs) {
            if str_eq(srcs[j][MO_MS_TAG], tag) == 1 {
                let ids = srcs[j][MO_MS_ATOM_IDS]
                let k = 0
                while k < len(ids) {
                    let a = kg_atom(kg, ids[k])
                    if a != 0 {
                        if atom_confidence(a) >= MO_DURABLE_MEAN {
                            durable = durable + 1
                        } else {
                            tentative = tentative + 1
                        }
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
        let last_str = "(never)"
        if last >= 0 { last_str = "tick " + int_to_str(last) }
        io_println("  " + _mo_pad(tag, 17) + _mo_pad(int_to_str(sample), 8)
            + _mo_pad(int_to_str(tentative), 11) + _mo_pad(int_to_str(durable), 9)
            + _mo_pad(mo_format_pct(promo_milli), 12)
            + _mo_pad(mo_format_pct(atrophy_milli), 10) + last_str)
        i = i + 1
    }
    let polls = mo_total_polls(mo)
    let refl_prom = mo_refl_promotions(mo)
    io_println("  (" + int_to_str(polls) + " poll(s) total; "
        + int_to_str(refl_prom) + " reflection-KG promotion(s) observed)")
    return 1
}

// /meta-feedback: dry-run of mo_apply_feedback. Prints which sources WOULD
// be promoted or demoted in source_authority right now, with their rates and
// the current vs proposed tier. ADR-0050 P1.1. Pair with /meta-apply which
// actually mutates `sauth`.
fn _admin_meta_feedback(mo, sa) {
    let rows = mo_feedback_dryrun(mo, sa)
    io_println("meta-feedback (dry run):")
    io_println("  tag             host                          promo%  atrophy%  sample  current  proposed  action")
    if len(rows) == 0 {
        io_println("  (no attributed sources yet)")
        return 1
    }
    let i = 0
    let pending = 0
    while i < len(rows) {
        let r = rows[i]
        let tag = r[MO_FB_TAG]
        let host = r[MO_FB_HOST]
        let act = r[MO_FB_ACTION]
        let old_t = r[MO_FB_OLD_TIER]
        let new_t = r[MO_FB_NEW_TIER]
        let promo = r[MO_FB_PROMO]
        let atrophy = r[MO_FB_ATROPHY]
        let sample = r[MO_FB_SAMPLE]
        let act_str = mo_fb_action_name(act)
        if act == MO_FB_NONE {
            if sample < MO_FB_WINDOW {
                act_str = "skip(window)"
            }
        }
        if new_t != old_t { pending = pending + 1 }
        io_println("  " + _mo_pad(tag, 16) + _mo_pad(host, 30)
            + _mo_pad(mo_format_pct(promo), 8)
            + _mo_pad(mo_format_pct(atrophy), 10)
            + _mo_pad(int_to_str(sample), 8)
            + _mo_pad(mo_tier_name(old_t), 9)
            + _mo_pad(mo_tier_name(new_t), 10)
            + act_str)
        i = i + 1
    }
    if pending == 0 {
        io_println("  (no tier changes pending -- /meta-apply would be a no-op)")
    } else {
        io_println("  (" + int_to_str(pending) + " tier change(s) pending; run /meta-apply to commit)")
    }
    return 1
}

// /meta-apply: invoke mo_apply_feedback, which COMMITS tier promotions /
// demotions into the shared `sauth` host registry. Prints exactly the rows
// where a tier ACTUALLY changed (other rows surface only via /meta-feedback).
// ADR-0050 P1.1. One-line confirmation up front.
fn _admin_meta_apply(mo, sa) {
    io_println("meta-apply: committing source_authority tier changes derived from meta-observer feedback")
    let rows = mo_apply_feedback(mo, sa)
    let committed = 0
    let i = 0
    while i < len(rows) {
        let r = rows[i]
        let old_t = r[MO_FB_OLD_TIER]
        let new_t = r[MO_FB_NEW_TIER]
        if new_t != old_t {
            io_println("  (" + r[MO_FB_TAG]
                + " -> host '" + r[MO_FB_HOST]
                + "' " + mo_fb_action_name(r[MO_FB_ACTION])
                + " tier " + mo_tier_name(old_t)
                + " -> " + mo_tier_name(new_t)
                + " | promo=" + mo_format_pct(r[MO_FB_PROMO])
                + "% atrophy=" + mo_format_pct(r[MO_FB_ATROPHY])
                + "% sample=" + int_to_str(r[MO_FB_SAMPLE]) + ")")
            committed = committed + 1
        }
        i = i + 1
    }
    if committed == 0 {
        io_println("  (no changes applied -- /meta-feedback would have shown the same)")
    } else {
        io_println("  (" + int_to_str(committed) + " tier change(s) committed)")
    }
    return 1
}

// _mo_pad(s, width) -- right-pad helper, extracted to src/chat/helpers.nova
// in P1.8 for unit-test reach.

// /__metrics__: machine-readable metrics dump for scripts/web.py's Prometheus
// scrape endpoint. Emits one `key=value` line per metric, framed by a
// `METRICS_BEGIN`/`METRICS_END` pair so the python parser can locate the block
// without depending on log-line ordering. Underscore-prefixed + listed as
// (internal) in /help so an end user typing /help sees it but won't usually
// reach for it. Read-only: polls mo_poll once (the same operation /meta does)
// and reads kg_atom_count / dl_count / soul mood / scheduler rate. ADR-0050
// promotion/atrophy rates are reported in milli-percent (0..1000) so the
// Prometheus side can divide by 10 for a real percent.
fn _admin_metrics(sl, kg, lang, refl_kg, log, hs, mo, now) {
    mo_poll(mo, kg, refl_kg, now)
    io_println("METRICS_BEGIN")
    io_println("atom_count_reasoning=" + int_to_str(kg_atom_count(kg)))
    io_println("atom_count_language=" + int_to_str(kg_atom_count(lang)))
    io_println("refl_atom_count=" + int_to_str(refl_size(refl_kg)))
    io_println("dlog_entries=" + int_to_str(dl_count(log)))
    io_println("soul_mood_valence=" + int_to_str(soul_mood_valence(sl)))
    io_println("soul_mood_arousal=" + int_to_str(soul_mood_arousal(sl)))
    io_println("scheduler_tick=" + int_to_str(hs_now(hs)))
    io_println("scheduler_rate_hz=" + int_to_str(hs_rate(hs)))
    // Pacer overruns are daemon-only today (chat doesn't bind a pacer); 0 is
    // the honest value the Prometheus side should display.
    io_println("scheduler_overruns=0")
    let report = mo_report(mo)
    let mi = 0
    while mi < len(report) {
        let row = report[mi]
        let tag = row[0]
        let promo_milli = row[1]
        let atrophy_milli = row[2]
        io_println("promotion_milli_" + tag + "=" + int_to_str(promo_milli))
        io_println("atrophy_milli_" + tag + "=" + int_to_str(atrophy_milli))
        mi = mi + 1
    }
    io_println("METRICS_END")
    return 1
}

// ---- session bootstrap helper --------------------------------------------
// Build a fresh Session value with a default-shaped soul, KG registry, all
// three KGs with the seed applied, reflection KG, ctx, decision log, goal
// engine, meta-observer (seeded sources attributed), and a per-tenant
// hybrid scheduler attached to the SHARED substrate `reg`. Returns the
// constructed Session ready for sreg_register. Mirrors the boot block in
// main() byte-for-byte so a /switch into a brand-new id is indistinguishable
// from a fresh process boot.
fn _new_session_for(reg, id, name, now) {
    let sl = soul_new(name)
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)
    let kgreg = kg_registry_new()
    let kg = reasoning_kg_init(kgreg)
    let lang = lang_kg_init(kgreg)
    let ikg = imagination_kg_init(kgreg)
    seed_apply(kg, lang, ikg, 0)
    let ctx = ctx_new()
    let log = dl_new()
    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)
    let refl_kg = refl_kg_init(kgreg)
    let mo = mo_new()
    let mo_seed_n = kg_atom_count(kg)
    let mo_si = 0
    while mo_si < mo_seed_n {
        mo_attribute(mo, "seed", mo_si)
        mo_si = mo_si + 1
    }
    let hs = hs_new(reg)
    let sess = session_make(id, name, now, sl, kgreg, kg, lang, ikg, refl_kg,
                            ctx, log, engine, mo, hs)
    // P3.6 (ADR-0053): per-session differential-privacy state. Each
    // tenant has its own epsilon budget so one session's noisy queries
    // cannot drain another's. Default 10000 milli-eps; the env override
    // CE_DP_EPSILON_BUDGET shifts the floor up or down.
    session_attach_dp(sess, dp_new(dp_budget_from_env()))
    return sess
}

// ---- /switch: in-process tenant routing ----------------------------------
// `/switch <id>` activates an existing session under that id, or creates one
// fresh if absent. `/switch` (no arg) lists all known sessions with a `*`
// marker on the active row. Mutates `active_id` (the top-level mutable that
// the main loop reads at the top of every turn -- same NOVA pattern the
// `halted` flag uses).
fn _admin_switch(reg, arg, now) {
    if len(arg) == 0 {
        // List mode.
        let ids = sreg_ids(sreg)
        let n = len(ids)
        io_println("sessions (" + int_to_str(n) + " total):")
        let i = 0
        while i < n {
            let id = ids[i]
            let s = sreg_lookup(sreg, id)
            let marker = " "
            if str_eq(id, active_id) == 1 { marker = "*" }
            let atoms = kg_atom_count(session_kg(s))
            let last = now - session_last_active(s)
            io_println("  " + marker + _mo_pad(id, 14)
                + "\"" + session_name(s) + "\""
                + _mo_pad("", 4)
                + int_to_str(atoms) + " atoms"
                + _mo_pad("", 3)
                + "last " + int_to_str(last) + "s ago")
            i = i + 1
        }
        io_println("(* = active)")
        return 1
    }
    // Activate or create.
    let existing = sreg_lookup(sreg, arg)
    if existing != 0 {
        active_id = arg
        session_touch(existing, now)
        let atoms = kg_atom_count(session_kg(existing))
        io_println("(switched to session '" + arg + "' ("
            + session_name(existing) + ", " + int_to_str(atoms) + " atoms))")
        return 1
    }
    // Create a fresh session under this id. Default display name = "Default"
    // (consistent with the brief's example output line).
    let fresh = _new_session_for(reg, arg, "Default", now)
    sreg_register(sreg, fresh)
    active_id = arg
    let atoms = kg_atom_count(session_kg(fresh))
    io_println("(created and switched to new session '" + arg
        + "' (Default, " + int_to_str(atoms) + " atoms))")
    return 1
}

// ---- /seed: domain seed packs (P1.9) -------------------------------------
// `/seed` (no arg) lists the available packs via pack_list() and marks any
// that are already installed in the active session's reasoning KG.
// `/seed <pack>` installs the named pack into the active session's KGs,
// reporting (atoms, operators, KG size). `/seed --reset <pack>` (or
// `/seed <pack> --reset`) forces re-install even if the pack's canary atom
// is already present.
fn _admin_seed(lang, kg, ikg, mo, arg, now) {
    // Parse out a possible --reset flag and the pack name. Accepts both
    // `/seed --reset medical` and `/seed medical --reset` orderings.
    let force = 0
    let name = arg
    if str_eq(arg, "--reset") == 1 {
        io_println("(/seed --reset needs a pack name -- try /seed)")
        return 1
    }
    if len(arg) > 0 {
        let parts = _split_cmd(arg)
        if str_eq(parts[0], "--reset") == 1 {
            force = 1
            name = parts[1]
        } else {
            if str_eq(parts[1], "--reset") == 1 {
                force = 1
                name = parts[0]
            } else {
                name = arg
            }
        }
    }
    if len(name) == 0 {
        // List mode.
        let packs = pack_list()
        io_println("domain seed packs (" + int_to_str(len(packs)) + " available):")
        let i = 0
        while i < len(packs) {
            let e = packs[i]
            let nm = pack_entry_name(e)
            let desc = pack_entry_description(e)
            let cnt = pack_entry_atom_count(e)
            let marker = ""
            if pack_already_installed(kg, nm) == 1 { marker = " [installed]" }
            io_println("  " + nm + " (~" + int_to_str(cnt) + " atoms)"
                + marker + " -- " + desc)
            i = i + 1
        }
        io_println("(usage: /seed <name>  or  /seed --reset <name>)")
        return 1
    }
    if force == 1 {
        if len(name) == 0 {
            io_println("(/seed --reset needs a pack name -- try /seed)")
            return 1
        }
    }
    let result = pack_install_with_force(name, lang, kg, ikg, mo, force, now)
    let atoms = result[0]
    let ops = result[1]
    let status = result[2]
    if str_eq(status, "unknown") == 1 {
        io_println("(unknown pack: " + name + " -- try /seed)")
        return 1
    }
    if str_eq(status, "already") == 1 {
        io_println("(seed pack '" + name + "' already installed; use /seed --reset "
            + name + " to re-apply)")
        return 1
    }
    let after = kg_atom_count(kg)
    io_println("(seed pack '" + name + "' installed: "
        + int_to_str(atoms) + " atoms + "
        + int_to_str(ops) + " operators; KG now "
        + int_to_str(after) + " atoms)")
    return 1
}

// ---- /ann_query: P3.4 ANN debugging --------------------------------------
// Find the atom with `label`, run an ANN query with its embedding, print the
// top 5 nearest atoms by label. Lazy-attaches an LSH index to the world KG
// on first use so the command works out of the box without the user having
// to wire one up. Debug-only -- the underscore prefix flags that.
fn _admin_ann_query(kg, arg) {
    if len(arg) == 0 {
        io_println("(usage: /ann_query LABEL  -- find atom by label, list nearest neighbors)")
        return 1
    }
    let probe = kg_find_atom(kg, arg)
    if probe == 0 {
        io_println("(no atom with label '" + arg + "')")
        return 1
    }
    // Lazy-init: attach an ANN if the KG doesn't have one yet. ann_rebuild
    // inside kg_set_ann re-buckets all existing atoms so the index is hot
    // immediately. Idempotent: re-running /ann_query reuses the existing ann.
    let ann = kg_ann(kg)
    if ann == 0 {
        ann = ann_new(ATOM_EMBED_DIMS, 8)
        kg_set_ann(kg, ann)
        io_println("(attached LSH index to '" + atom_kg(probe) + "': "
            + int_to_str(kg_atom_count(kg)) + " atoms across "
            + int_to_str(ann_bucket_total(ann)) + " buckets)")
    }
    let q = atom_embed(probe)
    let results = ann_query(ann, kg_atoms(kg), q, 5)
    let bid = ann_hash(ann, q)
    let bsz = ann_bucket_count(ann, bid)
    io_println("ann_query '" + arg + "' -> bucket " + int_to_str(bid)
        + " (" + int_to_str(bsz) + " atom(s) scanned, "
        + int_to_str(kg_atom_count(kg)) + " total in KG):")
    if len(results) == 0 {
        io_println("  (no neighbors in bucket)")
        return 1
    }
    let i = 0
    while i < len(results) {
        let entry = results[i]
        let aid = entry[0]
        let cos = entry[1]
        let a = kg_atom(kg, aid)
        let lbl = "(missing)"
        if a != 0 { lbl = atom_label(a) }
        io_println("  " + int_to_str(i + 1) + ". " + lbl
            + "  cosine=" + int_to_str(cos) + " milli")
        i = i + 1
    }
    return 1
}

// ---- /prove: P3.5 / ADR-0052 minimum-viable proof checker ---------------
// Look up two atom labels in the reasoning KG and run a bounded BFS over
// the operator graph between them. Prints either the operator-chain proof
// (one line per hop) and the composed strength, or a "no proof" line with
// the visit counter so the operator can tell whether the search was depth-
// bound or graph-bound. Optional third token overrides the default depth.
fn _admin_prove(kg, arg) {
    if len(arg) == 0 {
        io_println("(usage: /prove PREMISE CONCLUSION [DEPTH] -- both labels must exist in the reasoning KG)")
        return 1
    }
    let parts = _split_cmd(arg)
    let premise_label = parts[0]
    let rest = parts[1]
    if len(premise_label) == 0 {
        io_println("(/prove needs a PREMISE label -- try /prove)")
        return 1
    }
    if len(rest) == 0 {
        io_println("(/prove needs a CONCLUSION label -- try /prove)")
        return 1
    }
    let rest_parts = _split_cmd(rest)
    let conclusion_label = rest_parts[0]
    let depth_str = rest_parts[1]
    let depth = PROOF_DEFAULT_DEPTH
    if len(depth_str) > 0 {
        let d = rt_str_to_int(depth_str)
        if d > 0 { depth = d }
    }
    let p_atom = kg_find_atom(kg, premise_label)
    if p_atom == 0 {
        io_println("(no atom with label '" + premise_label + "' in the reasoning KG)")
        return 1
    }
    let c_atom = kg_find_atom(kg, conclusion_label)
    if c_atom == 0 {
        io_println("(no atom with label '" + conclusion_label + "' in the reasoning KG)")
        return 1
    }
    let r = proof_check(atom_id(p_atom), atom_id(c_atom), kg, depth, PROOF_DEFAULT_VISITS)
    let valid = proof_result_valid(r)
    let chain = proof_result_chain(r)
    let strength = proof_result_strength(r)
    let visited = proof_result_visited(r)
    if valid == 0 {
        io_println("no proof: " + premise_label + " -> " + conclusion_label
            + " within depth " + int_to_str(depth)
            + " (visited " + int_to_str(visited) + " of " + int_to_str(PROOF_DEFAULT_VISITS) + ")")
        return 1
    }
    // Either trivial or a real chain. proof_format handles both shapes.
    io_println(proof_format(chain, kg))
    io_println("visited " + int_to_str(visited) + " state(s); depth budget "
        + int_to_str(depth) + ", visit budget " + int_to_str(PROOF_DEFAULT_VISITS))
    return 1
}

// ---- P3.6: /dp_status + /dp_query (ADR-0053) ----------------------------
// `/dp_status` prints the active session's DP budget (consumed / remaining
// / total) -- the privacy bookkeeping for noisy KG queries.
// `/dp_query atoms` runs `kg_atom_count_dp` with epsilon = 100 milli
// (= 0.1 eps), printing BOTH the true count (admin-context only -- in a
// production tenant context the true count would be gated behind a role
// check) AND the noisy count, so an operator can see the noise envelope
// at a glance. Other targets ("belief LABEL") are reserved for future
// iterations; today only `atoms` is wired.
fn _admin_dp_status(dp) {
    if dp == 0 {
        io_println("(DP not configured for this session)")
        return 1
    }
    let total = dp_budget(dp)
    let rem = dp_remaining_budget(dp)
    let used = dp_consumed(dp)
    let queries = dp_query_count(dp)
    io_println("dp budget: " + int_to_str(used) + " / " + int_to_str(total)
        + " milli-eps consumed (remaining " + int_to_str(rem) + " milli-eps over "
        + int_to_str(queries) + " quer" + _admin_dp_plural(queries) + ")")
    return 1
}

// Tiny pluralizer for the dp_status line ("0 queries" / "1 query" / "N queries").
fn _admin_dp_plural(n) {
    if n == 1 { return "y" }
    return "ies"
}

fn _admin_dp_query(kg, dp, arg) {
    if dp == 0 {
        io_println("(DP not configured for this session)")
        return 1
    }
    let target = arg
    if len(target) == 0 { target = "atoms" }
    if str_eq(target, "atoms") == 1 {
        let true_count = kg_atom_count(kg)
        let noisy = kg_atom_count_dp(kg, dp, 100)
        if dp_is_refused(noisy) == 1 {
            io_println("dp_query atoms: budget exhausted (remaining "
                + int_to_str(dp_remaining_budget(dp)) + " milli-eps)")
            return 1
        }
        io_println("dp_query atoms: true=" + int_to_str(true_count)
            + " noisy=" + int_to_str(noisy)
            + " (epsilon=100 milli, remaining "
            + int_to_str(dp_remaining_budget(dp)) + ")")
        return 1
    }
    io_println("(dp_query: unknown target '" + target + "' -- try 'atoms')")
    return 1
}

fn _try_admin(msg, sl, kg, lang, ikg, refl_kg, ctx, log, engine, hs, kgreg, mo, reg, stream, em, syn_g, sm, now) {
    if len(msg) == 0 { return 0 }
    if char_at(msg, 0) != 47 { return 0 }   // not '/'
    let parts = _split_cmd(msg)
    let cmd = parts[0]
    let arg = parts[1]
    // P0.7: shutdown lines. dl_close flushes any pending dlog batch so a
    // clean /quit doesn't lose the last entries; the daemon's atexit-style
    // path is the main-loop fall-through.
    if str_eq(cmd, "/quit") == 1 { io_println("bye.") dl_close(log) exit(0) }
    if str_eq(cmd, "/exit") == 1 { io_println("bye.") dl_close(log) exit(0) }
    if str_eq(cmd, "/help")    == 1 { return _admin_help() }
    if str_eq(cmd, "/status")  == 1 { return _admin_status(sl, kg, refl_kg, log, engine, hs, stream, em, syn_g, sm) }
    if str_eq(cmd, "/why")     == 1 { return _admin_why(log) }
    if str_eq(cmd, "/halt")    == 1 { return _admin_halt() }
    if str_eq(cmd, "/resume")  == 1 { return _admin_resume() }
    if str_eq(cmd, "/teach")   == 1 { return _admin_teach(lang, kg, mo, arg, now) }
    if str_eq(cmd, "/learn")   == 1 { return _admin_learn(lang, kg, arg, now) }
    if str_eq(cmd, "/reflect") == 1 { return _admin_reflect(ctx, kg, ikg, refl_kg, arg, now) }
    if str_eq(cmd, "/save")    == 1 { return _admin_save(sl, kg, lang, stream, em, syn_g, sm, arg, active_id, now) }
    if str_eq(cmd, "/load")    == 1 { return _admin_load(sl, kg, lang, kgreg, stream, em, syn_g, sm, arg, active_id, now) }
    if str_eq(cmd, "/compact") == 1 { return _admin_compact(sl, kg, lang, stream, em, syn_g, sm, arg, active_id, now) }
    if str_eq(cmd, "/speak")   == 1 { return _admin_speak(lang, arg) }
    if str_eq(cmd, "/meta")    == 1 { return _admin_meta(mo, refl_kg, kg, now) }
    if str_eq(cmd, "/meta-feedback") == 1 { return _admin_meta_feedback(mo, sauth) }
    if str_eq(cmd, "/meta-apply")    == 1 { return _admin_meta_apply(mo, sauth) }
    if str_eq(cmd, "/switch")  == 1 { return _admin_switch(reg, arg, now) }
    if str_eq(cmd, "/seed")    == 1 { return _admin_seed(lang, kg, ikg, mo, arg, now) }
    if str_eq(cmd, "/__metrics__") == 1 { return _admin_metrics(sl, kg, lang, refl_kg, log, hs, mo, now) }
    if str_eq(cmd, "/ann_query")   == 1 { return _admin_ann_query(kg, arg) }
    if str_eq(cmd, "/prove")       == 1 { return _admin_prove(kg, arg) }
    if str_eq(cmd, "/dp_status")   == 1 { return _admin_dp_status(session_dp(sreg_lookup(sreg, active_id))) }
    if str_eq(cmd, "/dp_query")    == 1 { return _admin_dp_query(kg, session_dp(sreg_lookup(sreg, active_id)), arg) }
    if str_eq(cmd, "/history") == 1 {
        let n = 5
        if len(arg) > 0 { n = rt_str_to_int(arg) }
        if n <= 0 { n = 5 }
        return _admin_history(log, n)
    }
    if str_eq(cmd, "/pin") == 1 {
        let ap = _split_cmd(arg)
        return _admin_pin(lang, ap[0], ap[1])
    }
    io_println("(unknown command: " + cmd + " -- try /help)")
    return 1
}

fn main() {
    io_println("=== CrossEngin chat ===")
    io_println("state persists across turns; type 'quit' / 'exit' / empty / Ctrl-D to leave")
    io_println("type /help for admin commands (/teach, /pin, /status, /halt, ...)")
    io_println("")

    // Substrate-side, PROCESS-SHARED state. The part registry, gate router,
    // and learning trigger arbiter route activation across all tenants --
    // they are not part of the per-session bundle (see ADR-0051; the Session
    // struct holds COGNITIVE state -- soul, KGs, ctx, log, engine, mo, hs --
    // not substrate plumbing). `stream` (moment stream) and `em` (episodic
    // memory) are also shared today; the Session shape can grow slots for
    // them later if cross-tenant bleed becomes observable.
    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "world", CE_CAP, CE_FIRST)
    let gate = gate_new(reg)
    gate_seed_from_parts(gate, reg)
    let arb = slt_arbiter_new()
    let stream = ms_new()
    let em = em_new()
    // P2.1 + P2.2: cofire + slot similarity side-indices. Initialized at
    // boot; the cofire index accumulates pairs of co-firing atoms when
    // moments settle (via ms_settle_old_with_cofire), and the slot index
    // accumulates pattern fillers each time gen_from_intent_with_slot
    // runs. These feed the reader's find_neighbors_full surface (Phase 14
    // / Tier-2 #2 P2.1/P2.2 follow-up).
    let ci = ci_new()
    let si = si_new()
    // P0.1 (this edit): synapse graph + self-model are also shared across
    // sessions for now. We choose the "reasoning" part's synapse graph as the
    // persistence target -- it's the part where Hebbian learning between
    // concept neurons happens, so it's the most learning-bearing graph.
    // (Multi-part synapse capture is a separate phase; the wire format does
    // not yet carry a part id.) The self-model starts empty; competence
    // assessment is run on demand from the live KGs.
    let reasoning_part = registry_get(reg, registry_find(reg, "reasoning"))
    let syn_g = part_syn(reasoning_part)
    let sm = self_model_new()

    // Phase 18 Half A: install the default session ("default" / "Aurora") in
    // the registry. Every subsequent turn looks up the active session via
    // `active_id` and re-binds the cognitive locals. Bit-identical behaviour
    // for vanilla ./bin/crossengin-chat (no /switch issued) because the only
    // registered session at boot is the default and `active_id` starts at
    // "default".
    sreg_register(sreg, _new_session_for(reg, "default", "Aurora", 0))

    // P0.7: wire the default session's dlog to its durable file. Path comes
    // from CE_DLOG_PATH (default /tmp/crossengin.dlog); a failed open leaves
    // the dlog in-memory (a warning prints) so the chat still boots. The
    // existing /history admin reads dl_get; that surface is unchanged.
    let _dlog_env = getenv("CE_DLOG_PATH")
    let _dlog_path = "/tmp/crossengin.dlog"
    if _dlog_env != 0 {
        if len(_dlog_env) > 0 { _dlog_path = _dlog_env }
    }
    let _boot_log = session_log(sreg_lookup(sreg, active_id))
    let _dlog_ok = dl_open(_boot_log, _dlog_path)
    if _dlog_ok == 0 {
        io_println("(warning: dlog could not be opened at " + _dlog_path + " -- in-memory only)")
    } else {
        if dl_count(_boot_log) > 0 {
            io_println("(dlog: " + dl_path(_boot_log) + " loaded "
                + int_to_str(dl_count(_boot_log)) + " prior entries)")
        }
    }

    let modulator = 1000
    let error = 0
    let predicted = 300
    let turn = 0

    // For the boot banner, peek at the default session's KG.
    let _boot_sess = sreg_lookup(sreg, active_id)
    io_println("(seed: " + int_to_str(kg_atom_count(session_kg(_boot_sess))) + " atoms, "
        + soul_name(session_soul(_boot_sess)) + " ready)")
    io_println("")

    while 1 == 1 {
        io_print("> ")
        let msg = _take_line()
        if len(msg) == 0 {
            io_println("bye.")
            dl_close(_boot_log)
            return 0
        }
        if str_eq(msg, "quit") == 1 {
            io_println("bye.")
            dl_close(_boot_log)
            return 0
        }
        if str_eq(msg, "exit") == 1 {
            io_println("bye.")
            dl_close(_boot_log)
            return 0
        }

        // ---- per-turn: bind cognitive locals from the active session ----
        // This is the load-bearing re-bind: `/switch` mutates `active_id`,
        // so the NEXT iteration picks up the new session's soul / KG / ctx
        // / log automatically. Per-session reader / world_kg_id / cands are
        // re-derived here too so they reflect the active session's KGs.
        let sess = sreg_lookup(sreg, active_id)
        let sl = session_soul(sess)
        let kgreg = session_kgreg(sess)
        let kg = session_kg(sess)
        let lang = session_lang(sess)
        let ikg = session_ikg(sess)
        let refl_kg = session_refl_kg(sess)
        let ctx = session_ctx(sess)
        let log = session_log(sess)
        let engine = session_engine(sess)
        let mo = session_mo(sess)
        let hs = session_hs(sess)
        let world_kg_id = atom_kg(kg_find_atom(kg, "fever"))
        let reader = reader_new(kgreg, lang, 0)
        // Build syntax candidates from the active session's language KG.
        // Skip nulls defensively: a stale snapshot loaded over the seed can
        // forcibly overwrite the syntax atom's `ltype` to LWORD inside
        // kg_section_apply, after which syntax_find returns 0. Dropping the
        // null keeps gen_best_pattern's loop from dereferencing it; the
        // fallback path (_gen_emit_intent) still produces a reply.
        let cands = list_new()
        let _ack = syntax_find(lang, "ack")
        if _ack != 0 { push(cands, _ack) }
        let _see = syntax_find(lang, "see_topic")
        if _see != 0 { push(cands, _see) }
        session_touch(sess, hs_now(hs))

        if _try_admin(msg, sl, kg, lang, ikg, refl_kg, ctx, log, engine, hs, kgreg, mo, reg, stream, em, syn_g, sm, hs_now(hs)) == 1 {
            // Admin command handled; do not feed to the agent.
        } else {

        hs_post_event(hs, EV_MESSAGE, msg)
        let reply = ""
        let last_matched = 0
        let last_unk = 0

        // Drain: each hs_step pops <=1 event and ticks once. Stop when the
        // event has been processed (idle counter starts climbing).
        let drained = 0
        let drain_steps = 0
        while drained == 0 {
            let ev = hs_step(hs, modulator, error)
            drain_steps = drain_steps + 1
            if ev != 0 {
                let raw = event_payload(ev)
                let p = transduce(IN_TEXT, raw)
                ctx_set_input(ctx, percept_text(p))
                ctx_set_idle(ctx, 0)
                ctx_set_tick(ctx, hs_now(hs))
                let matched = loop_perception_step(ctx, reader)
                last_matched = matched
                // Reflection corroboration: percept tokens whose label is
                // already in refl_kg confirm prior speculation (ADR-0023).
                let corroborated = refl_corroborate_percept(kg, refl_kg, ctx_percept(ctx))
                loop_memory_step(ctx, stream, em)
                let nconcl = loop_reasoning_step(ctx, kg)

                _route_and_inject(reg, gate, XSIG_SENSORY, 700, hs_now(hs))
                let unk = ctx_unknown(ctx)
                last_unk = unk
                if unk > 0 {
                    _route_and_inject(reg, gate, XSIG_CURIOSITY, 600, hs_now(hs))
                    _submit_curiosity(arb, lang, ctx_input(ctx))
                }

                // Affect from comprehension -> mood -> tick modulation.
                let des = matched * 300 - unk * 150
                loop_emotion_step(ctx, sl, des, 0, matched * 100)
                let val = ctx_valence(ctx)
                let aro = ctx_arousal(ctx)
                modulator = emotion_modulate_plasticity(val, aro, val)
                error = pc_residual(aro, predicted)
                predicted = aro

                let gap = 200
                if unk > 0 { gap = 700 }
                loop_goals_step(ctx, engine, gap, turn, 0, 300)

                if str_find(ctx_input(ctx), "exfiltrate") >= 0 {
                    effector_speak_governed(log, sl, ctx_input(ctx), halted, 0 - 1, list_new(), 0, hs_now(hs))
                    reply = "[refused]"
                } else {
                    // Output emerges from cognition: pick the first NEW
                    // conclusion, reverse-look up its naming word, speak it.
                    let percept = ctx_percept(ctx)
                    let concs = ctx_conclusions(ctx)
                    let intent = _intent1("ACK", "okay")
                    let derived = ""
                    let ck = 0
                    while ck < len(concs) {
                        if len(derived) == 0 {
                            let cid = concs[ck]
                            let in_p = 0
                            let pi = 0
                            while pi < len(percept) {
                                if percept[pi][1] == cid { in_p = 1 }
                                pi = pi + 1
                            }
                            if in_p == 0 {
                                let w = gen_word_for_concept(lang, world_kg_id, cid)
                                if w != 0 { derived = word_form(w) }
                            }
                        }
                        ck = ck + 1
                    }
                    if len(derived) > 0 {
                        let it = list_new()
                        let a = list_new() push(a, "SEE") push(a, "see")
                        let b = list_new() push(b, "TOPIC") push(b, derived)
                        push(it, a) push(it, b)
                        intent = it
                    }
                    let resp = gen_from_intent_with_slot(lang, cands, intent, hs_now(hs), si)
                    let said = effector_speak_governed(log, sl, resp, halted, 0 - 1, list_new(), 0, hs_now(hs))
                    ctx_set_output(ctx, said)
                    _route_and_inject(reg, gate, XSIG_GOAL, 800, hs_now(hs))
                    reply = said
                    if len(reply) == 0 { reply = "[silent]" }
                }
                drained = 1
            } else {
                // Empty step; if we've burned many empty ticks without the
                // event being drained, bail out (defensive).
                if drain_steps > 10 { drained = 1 }
            }
        }

        // Idle-style: if curiosity triggers were submitted, drain + teach now
        // so the agent grows its KGs mid-conversation.
        let taught = _drain_and_teach(arb, kg, lang, hs_now(hs))

        // Any refl_kg atom whose belief crossed the promotion threshold this
        // turn graduates to a real concept now -- reflective speculation that
        // perception corroborated becomes accepted knowledge.
        let promoted = refl_drain_promotions(kg, lang, refl_kg, hs_now(hs))

        if len(reply) == 0 { reply = "[no response]" }
        _last_reply = reply
        io_println("agent> " + reply)
        io_println("       perceive(m=" + int_to_str(last_matched)
            + ",unk=" + int_to_str(last_unk) + ")")
        if taught > 0 {
            io_println("       (learned " + int_to_str(taught) + " new word(s) -- "
                + int_to_str(kg_atom_count(kg)) + " atoms total)")
        }
        if len(promoted) > 0 {
            let line = "       (promoted from reflection:"
            let k = 0
            while k < len(promoted) {
                line = line + " " + promoted[k]
                if k < len(promoted) - 1 { line = line + "," }
                k = k + 1
            }
            io_println(line + ")")
        }
        turn = turn + 1
        } // end else: regular agent message
    }
    return 0
}
main()
