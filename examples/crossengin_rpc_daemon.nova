// CrossEngin JSON-RPC daemon (R49, ADR-0104 §Component 5).
//
// A tiny standalone TCP daemon that binds a socket, accepts one
// connection at a time, reads ONE JSON-RPC request per connection,
// dispatches through src/nl/rpc_server.rpc_server_handle_line, writes
// the response line back, and closes. The dispatcher's 12 verbs are
// documented in src/nl/rpc_verbs.nova; the wire is documented in
// src/nl/rpc_server.nova.
//
// Configuration (env vars, all optional):
//   CE_RPC_PORT   TCP port to bind. Required to start; without it the
//                 daemon prints a hint and exits.
//   CE_RPC_BIND   Bind IP. Defaults to 127.0.0.1 (loopback). Change
//                 ONLY if you understand the security implication --
//                 the wire executes named skills.
//   CE_RPC_MAX_REQUEST  Bytes cap per request (default 65536). Requests
//                 exceeding this are truncated to force a parse error.
//
// State on boot:
//   * kg_registry:      empty (spawn one "world" KG for skills that
//                       need a target). Operators can /skill install
//                       research to grow the KG via wire-driven skill
//                       runs, or preload from a snapshot with a
//                       separate script that populates the registry
//                       before invoking rpc_dispatch.
//   * capsule_registry: empty (packs can be registered here by other
//                       tooling that shares the process; for a
//                       standalone daemon the registry stays empty).
//   * skill_registry:   pre-registers the two reference skills
//                       (echo, research). Not installed by default;
//                       an installer script or the wire can install.
//   * persona_registry: empty. persona.show returns "no persona" for
//                       any user_id until one is created via the
//                       chat REPL's /persona commands.
//   * meta_observer:    a fresh observer.
//
// The daemon is DELIBERATELY minimal -- it exists to prove the RPC
// path works end-to-end. R50 (ship as app) will layer a full boot
// scaffold on top: snapshot loading, session slots, dp accounting,
// same audit hooks the chat has.
//
// Usage:
//   CE_RPC_PORT=9876 ./bin/crossengin-rpc-daemon
//   echo '{"verb":"kg.list"}' | nc 127.0.0.1 9876
//     -> {"ok":true,"result":["world"],"error":""}
//
// NOVA dependencies: builtins (socket / bind_socket / listen_socket /
//   accept_conn / recv_data / send_data / close_fd / make_sockaddr_in /
//   alloc / load8 / getenv).
// CrossEngin dependencies:
//   src/nl/rpc_server.nova
//   src/nl/rpc_verbs.nova
//   src/kg/multi_kg_manager.nova
//   src/capsules/capsule_registry.nova
//   src/persona/persona_registry.nova
//   src/skills/skill_registry.nova
//   src/skills/skills/echo_skill.nova
//   src/skills/skills/research_skill.nova
//   src/parts/meta/meta_observer.nova
//   src/util/str_safe.nova.

import "../src/nl/rpc_server.nova"
import "../src/nl/rpc_verbs.nova"
import "../src/nl/nl_metrics.nova"
import "../src/sandbox/capability.nova"
import "../src/sandbox/skill_signature.nova"
import "../src/kg/multi_kg_manager.nova"
import "../src/capsules/capsule_registry.nova"
import "../src/persona/persona_registry.nova"
import "../src/skills/skill_registry.nova"
import "../src/skills/skills/echo_skill.nova"
import "../src/skills/skills/research_skill.nova"
import "../src/parts/meta/meta_observer.nova"
import "../src/net/tls/tls_wire_hook.nova"
import "../src/net/tls/tls_config.nova"
import "../src/net/tls/base64.nova"
import "../src/safety/rng.nova"
import "../src/factory/child_mode.nova"
import "../src/sandbox/session_snapshot.nova"
import "../src/sandbox/ownership.nova"
import "../src/preference/user_preference.nova"
import "../src/ingest/policy.nova"
// R109 (Phase J, ADR-0210 tier 2): agent registry so agent.compose /
// agent.list / agent.run / agent.retire operate against a live store
// (and #AGENT v1 snapshot section round-trips through session.save/load).
import "../src/agents/agent_registry.nova"
// R103 (Phase F part 1, ADR-0206): gaps register for self.gaps
// introspection wiring.
import "../src/parts/meta/gaps_register.nova"
// R111 (Phase K part 2 / Phase F part 2, ADR-0206): volitional-layer
// override registry for self.override + self.override.list wiring.
import "../src/parts/meta/override_wire.nova"
import "../src/util/str_safe.nova"

// ---- socket constants (mirror stream_http.nova) --------------------------
let RPCD_AF_INET     = 2
let RPCD_SOCK_STREAM = 1
let RPCD_F_SETFL     = 4
let RPCD_O_NONBLOCK  = 2048
let RPCD_RECV_CHUNK  = 4096
let RPCD_DEFAULT_MAX_REQUEST = 65536
let RPCD_DEFAULT_BIND = "127.0.0.1"
let RPCD_LISTEN_BACKLOG = 32

// ---- env parsing ---------------------------------------------------------

fn _rpcd_is_digits(s) {
    if len(s) == 0 { return 0 }
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c < 48 { return 0 }
        if c > 57 { return 0 }
        i = i + 1
    }
    return 1
}

fn _rpcd_port_from_env() {
    let env = getenv("CE_RPC_PORT")
    if env == 0 { return 0 }
    if len(env) == 0 { return 0 }
    if _rpcd_is_digits(env) == 0 { return 0 }
    let v = str_to_int(env)
    if v <= 0 { return 0 }
    if v > 65535 { return 0 }
    return v
}

fn _rpcd_bind_from_env() {
    let env = getenv("CE_RPC_BIND")
    if env == 0 { return RPCD_DEFAULT_BIND }
    if len(env) == 0 { return RPCD_DEFAULT_BIND }
    return env
}

fn _rpcd_max_request_from_env() {
    let env = getenv("CE_RPC_MAX_REQUEST")
    if env == 0 { return RPCD_DEFAULT_MAX_REQUEST }
    if _rpcd_is_digits(env) == 0 { return RPCD_DEFAULT_MAX_REQUEST }
    let v = str_to_int(env)
    if v <= 0 { return RPCD_DEFAULT_MAX_REQUEST }
    return v
}

// R54 sandbox: is enforcement requested? CE_RPC_REQUIRE_TOKEN=1 turns
// it on. Any other value (unset / "0" / other) leaves it off, preserving
// R49/R50 wire behavior for existing deployments.
fn _rpcd_enforcement_from_env() {
    let env = getenv("CE_RPC_REQUIRE_TOKEN")
    if env == 0 { return 0 }
    if len(env) == 0 { return 0 }
    if str_eq_bytes(env, "1") == 1 { return 1 }
    return 0
}

// R55.1: same shape for signed-skill enforcement.
// CE_RPC_REQUIRE_SIGNED_SKILL=1 requires every wire skill.install to
// carry a signed SkillPackage against a trust anchor. Absent this,
// skill.install accepts pre-registered manifests by name (built-ins
// like echo + research the daemon compiles in).
fn _rpcd_signed_skill_from_env() {
    let env = getenv("CE_RPC_REQUIRE_SIGNED_SKILL")
    if env == 0 { return 0 }
    if len(env) == 0 { return 0 }
    if str_eq_bytes(env, "1") == 1 { return 1 }
    return 0
}

// R94 TLS bootstrap: opt-in via CROSSENGIN_TLS=1. When enabled, three
// env vars carry base64-encoded DER material to the daemon:
//   CROSSENGIN_TLS_LEAF_DER      base64(leaf.der)
//   CROSSENGIN_TLS_LEAF_PRIV     base64(32-byte Ed25519 seed)
//   CROSSENGIN_TLS_ROOT_DER      base64(root.der)
// See docs/SHIP_AS_APP.md §7.44 for the sidecar recipe.
fn _rpcd_tls_enabled_from_env() {
    let env = getenv("CROSSENGIN_TLS")
    if env == 0 { return 0 }
    if len(env) == 0 { return 0 }
    if str_eq_bytes(env, "1") == 1 { return 1 }
    return 0
}

// Decode a single base64 env-var into a byte list. Returns 0 on any
// failure (missing env-var, empty, malformed base64).
fn _rpcd_env_b64_bytes(name) {
    let env = getenv(name)
    if env == 0 { return 0 }
    if len(env) == 0 { return 0 }
    let res = base64_decode(env)
    if res[0] != 1 { return 0 }
    return res[1]
}

// Attempt to build a server-role tls_config from the three env vars.
// Returns [ok, cfg]. ok = 1 populates cfg with a ready-to-use config;
// ok = 0 leaves cfg empty and the caller should either refuse to boot
// or fall back to cleartext depending on operator preference. We
// choose "refuse to boot" when CROSSENGIN_TLS=1 is set but the
// material is missing/malformed -- silent fallback would demote
// confidentiality without the operator noticing.
fn daemon_load_tls_config_from_sidecar(cfg_out) {
    let leaf_der = _rpcd_env_b64_bytes("CROSSENGIN_TLS_LEAF_DER")
    if leaf_der == 0 { return 0 }
    let leaf_priv = _rpcd_env_b64_bytes("CROSSENGIN_TLS_LEAF_PRIV")
    if leaf_priv == 0 { return 0 }
    let root_der = _rpcd_env_b64_bytes("CROSSENGIN_TLS_ROOT_DER")
    if root_der == 0 { return 0 }
    return tls_config_new_server(cfg_out, leaf_der, len(leaf_der),
                                  leaf_priv, root_der, len(root_der))
}

// RNG mode selection.
//   CROSSENGIN_RNG_MODE=os        -- attempt Backend A (secure_random).
//                                    Fails in seccomp-restricted
//                                    containers (this one included --
//                                    R91 probe finding).
//   CROSSENGIN_RNG_MODE=test      -- deterministic Backend B seeded
//                                    from CROSSENGIN_RNG_SEED (string).
//                                    NOT PRODUCTION SAFE.
//   CROSSENGIN_RNG_MODE=callback  -- Backend C. R94 wires this to a
//                                    named FIFO at CROSSENGIN_RNG_FIFO
//                                    that the operator's sidecar
//                                    keeps supplied with 32-byte
//                                    entropy chunks.
// Returns 0 on any failure (missing env var, missing seed for test,
// missing fifo for callback, OS backend unavailable).
fn _rpcd_rng_mode_from_env() {
    let env = getenv("CROSSENGIN_RNG_MODE")
    if env == 0 { return "" }
    return env
}

// Callback backend: the operator's sidecar writes 32-byte chunks to
// CROSSENGIN_RNG_FIFO; we read from it on demand. R94 opens the FIFO
// once at boot; a real integrator can enrich this to reopen on EOF,
// add framing, etc. When the FIFO env-var is not set OR the file
// can't be opened, the callback refuses (returns 0), which propagates
// as "handshake failure" -- deliberate loud failure over silent
// weak-entropy.
let _RPCD_RNG_FIFO_FD = 0 - 1

fn _rpcd_rng_fifo_callback(out_buf, out_len) {
    if _RPCD_RNG_FIFO_FD < 0 { return 0 }
    let got = 0
    while got < out_len {
        let n = sys_read(_RPCD_RNG_FIFO_FD, out_buf + got, out_len - got)
        if n <= 0 { return 0 }
        got = got + n
    }
    return 1
}

fn daemon_build_rng_ctx(mode) {
    let ctx = list_new()
    if str_eq_bytes(mode, "os") == 1 {
        if rng_os_new(ctx) == 1 { return ctx }
        return 0
    }
    if str_eq_bytes(mode, "test") == 1 {
        let seed = getenv("CROSSENGIN_RNG_SEED")
        if seed == 0 { return 0 }
        if len(seed) == 0 { return 0 }
        let n = len(seed)
        let buf = alloc(n + 1)
        let i = 0
        while i < n {
            store8(buf + i, char_at(seed, i))
            i = i + 1
        }
        store8(buf + n, 0)
        if rng_test_new(ctx, buf, n) == 1 { return ctx }
        return 0
    }
    if str_eq_bytes(mode, "callback") == 1 {
        let fifo = getenv("CROSSENGIN_RNG_FIFO")
        if fifo == 0 { return 0 }
        if len(fifo) == 0 { return 0 }
        let fd = sys_open(fifo, O_RDONLY, 0)
        if fd < 0 { return 0 }
        _RPCD_RNG_FIFO_FD = fd
        if rng_callback_new(ctx, _rpcd_rng_fifo_callback) == 1 { return ctx }
        return 0
    }
    return 0
}

// R55.3: snapshot directory for session.save / session.load.
// CE_RPC_SNAPSHOT_DIR=<abs-path> enables session persistence. Absent
// or empty, both verbs refuse cleanly with "no snapshot directory
// configured". Operator is responsible for chmod 0700 on the dir.
fn _rpcd_snapshot_dir_from_env() {
    let env = getenv("CE_RPC_SNAPSHOT_DIR")
    if env == 0 { return "" }
    return env
}

// Read the admin-bootstrap token file (a single line, trimmed). Empty
// path / missing file / empty file -> "" (no admin token; enforcement
// will refuse every request until an admin token is minted some other
// way). Returns the token id string on success.
fn _rpcd_read_admin_token() {
    let path = getenv("CE_RPC_ADMIN_TOKEN_FILE")
    if path == 0 { return "" }
    if len(path) == 0 { return "" }
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return "" }
    // 256 bytes is a comfortable ceiling for a hex-encoded 128-bit
    // token + trailing newline + a bit of slack.
    let buf = alloc(257)
    let n = sys_read(fd, buf, 256)
    sys_close(fd)
    if n <= 0 { return "" }
    let s = ""
    let i = 0
    while i < n {
        s = s + chr(load8(buf + i))
        i = i + 1
    }
    // Trim trailing whitespace / newline.
    let trimmed = str_trim(s)
    return trimmed
}

// ---- IP dotted-quad -> int (mirrors stream_http._stream_http_ip_to_int) --

fn _rpcd_ip_to_int(ip) {
    let toks = list_new()
    let i = 0
    let start = 0
    while i < len(ip) {
        if char_at(ip, i) == 46 {
            push(toks, substr(ip, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(toks, substr(ip, start, len(ip) - start))
    if len(toks) != 4 { return 0 - 1 }
    let j = 0
    while j < 4 {
        if _rpcd_is_digits(toks[j]) == 0 { return 0 - 1 }
        let v = str_to_int(toks[j])
        if v < 0    { return 0 - 1 }
        if v > 255  { return 0 - 1 }
        j = j + 1
    }
    let a = str_to_int(toks[0])
    let b = str_to_int(toks[1])
    let c = str_to_int(toks[2])
    let d = str_to_int(toks[3])
    // Same NOVA-codegen-bug-#11 workaround stream_http.nova uses:
    // avoid the smart-op dispatch mis-routing operands >= 0x100000
    // into string-concat by going through the int_* escape hatch.
    let b_p = int_mul(b, 256)
    let c_p = int_mul(c, 65536)
    let d_p = int_mul(d, 16777216)
    return int_add(int_add(int_add(a, b_p), c_p), d_p)
}

// ---- fcntl shim ----------------------------------------------------------
// Kept blocking on the listen fd: this daemon accepts one connection at
// a time in a serial loop, so blocking accept is the natural fit (no
// idle tick to poll from). Non-blocking mode would need an event loop
// which R49 does not build.

// ---- byte -> string ------------------------------------------------------

fn _rpcd_bytes_to_str(buf, n) {
    if n <= 0 { return "" }
    let out = ""
    let i = 0
    while i < n {
        out = out + chr(load8(buf + i))
        i = i + 1
    }
    return out
}

// ---- per-connection read: one line-terminated OR full-body request ------
//
// Reads until the first '\n' OR the client closes the connection OR we
// hit the per-request byte cap. Returns the collected string (with the
// trailing newline stripped, if any). Empty string means the client
// closed without sending anything.
fn _rpcd_read_request(conn_fd, max_bytes) {
    let acc = ""
    let done = 0
    while done == 0 {
        if len(acc) >= max_bytes { done = 1 }
        else {
            let buf = alloc(RPCD_RECV_CHUNK)
            let n = recv_data(conn_fd, buf, RPCD_RECV_CHUNK)
            if n <= 0 { done = 1 }
            else {
                let chunk = _rpcd_bytes_to_str(buf, n)
                acc = acc + chunk
                // Look for first '\n' -- one JSON object per line.
                let nl = 0
                let found = 0 - 1
                while nl < len(acc) {
                    if char_at(acc, nl) == 10 {
                        if found < 0 { found = nl }
                    }
                    nl = nl + 1
                }
                if found >= 0 {
                    acc = substr(acc, 0, found)
                    done = 1
                }
            }
        }
    }
    return acc
}

fn _rpcd_send_all(fd, s) {
    let total = len(s)
    let sent = 0
    while sent < total {
        let chunk = substr(s, sent, total - sent)
        let n = send_data(fd, chunk, total - sent)
        if n <= 0 { return 0 }
        sent = sent + n
    }
    return 1
}

// ---- wire_conn-aware line read / send (R94) ------------------------------
//
// The daemon used to call recv_data / send_data directly on a raw fd.
// R94 flips the wire hook to a real tls_conn when TLS is enabled, so
// I/O has to go through wire_connection_read / wire_connection_write
// instead. These two helpers are the equivalents of _rpcd_read_request
// / _rpcd_send_all built on the wire_conn API. When TLS is off the
// wire_conn is a RAW-tag null-op wrapper and the semantics are byte-
// identical to the pre-R94 recv_data / send_data path.

fn _rpcd_read_line_via_conn(conn, max_bytes) {
    let acc = ""
    let done = 0
    let out_len = list_new()
    push(out_len, 0)
    while done == 0 {
        if len(acc) >= max_bytes { done = 1 }
        else {
            let buf = alloc(RPCD_RECV_CHUNK + 1)
            let ok = wire_connection_read(conn, buf, RPCD_RECV_CHUNK, out_len)
            let n = out_len[0]
            if ok != 1 { done = 1 }
            else {
                if n <= 0 { done = 1 }
                else {
                    let chunk = _rpcd_bytes_to_str(buf, n)
                    acc = acc + chunk
                    // First '\n' terminates a line-shaped request.
                    let nl = 0
                    let found = 0 - 1
                    while nl < len(acc) {
                        if char_at(acc, nl) == 10 {
                            if found < 0 { found = nl }
                        }
                        nl = nl + 1
                    }
                    if found >= 0 {
                        acc = substr(acc, 0, found)
                        done = 1
                    }
                }
            }
        }
    }
    return acc
}

fn _rpcd_send_via_conn(conn, s) {
    let total = len(s)
    if total <= 0 { return 1 }
    let buf = alloc(total + 1)
    let i = 0
    while i < total {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + total, 0)
    return wire_connection_write(conn, buf, total)
}

// ---- boot: build the shared RpcContext ----------------------------------

fn _rpcd_build_ctx(now) {
    let kgreg = kg_registry_new()
    // A single "world" KG so skills that need a KG target find one.
    kg_spawn(kgreg, "world")
    let capreg = capreg_new()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, echo_skill_manifest())
    skill_registry_register(sr, research_skill_manifest())
    let preg = persona_registry_new()
    // ingest_agent + review_queue left 0; ingest.* verbs will refuse
    // with "no ingest agent / no review queue" -- deliberate for the
    // standalone daemon (R49 does not wire the ingestion pipeline).
    let ctx = rpc_ctx_new(kgreg, capreg, preg, sr, mo, 0, 0, now)
    // R95: wire a fresh nl_metrics registry so nl.ask records
    // total / unparsed / llm-fallback counters per presented holder.
    // Absent this call the seam is a no-op (counters not recorded);
    // adding it costs nothing at runtime for daemons that don't yet
    // read the numbers back and gives Phase C (`nl.metrics` verb)
    // something to snapshot when the wire verb lands.
    rpc_ctx_set_nl_metrics(ctx, nl_metrics_new())
    // R54 sandbox wiring: if CE_RPC_REQUIRE_TOKEN=1, mint a fresh
    // capability_registry and seed the admin token from the file the
    // operator supplied via CE_RPC_ADMIN_TOKEN_FILE. Absent enforcement
    // leaves ctx in R49/R50 pass-through mode.
    if _rpcd_enforcement_from_env() == 1 {
        let cap_reg = capability_registry_new()
        let admin_id = _rpcd_read_admin_token()
        if len(admin_id) > 0 {
            let roles = list_new()
            push(roles, "admin")
            let t = capability_token_new_roles(admin_id, "admin", roles,
                                               now, 0)
            capability_registry_add(cap_reg, t)
        }
        rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    }
    // R55.1 signed-skill enforcement: wire a fresh (empty) trust anchor
    // registry when enforcement is on. Operators populate anchors
    // in-process at boot (a small NOVA program can pre-register
    // known-good signer pubkeys; R56+ can add a wire verb for anchor
    // management). Absent enforcement, skill.install accepts pre-
    // registered names -- backward compatible.
    if _rpcd_signed_skill_from_env() == 1 {
        rpc_ctx_set_signed_skill_enforcement(ctx,
            trust_anchor_registry_new(), 1)
    }
    // R55.3 snapshot dir wiring.
    let snap_dir = _rpcd_snapshot_dir_from_env()
    if len(snap_dir) > 0 {
        rpc_ctx_set_snapshot_dir(ctx, snap_dir)
    }
    // R101 (ADR-0205 Mode 2): always allocate a fresh per-user
    // preference registry. When the mother has no ownership overlay
    // wired (sandbox-off) the preference filter is still inert (empty
    // registry -> preference_visible always returns 1); when the
    // overlay IS wired, users can toggle their per-item visibility via
    // the user.preference.* verbs.
    rpc_ctx_set_preference_reg(ctx, preference_registry_new())
    // R103 (Phase F part 1, ADR-0206): allocate a fresh gaps register
    // so nl.ask / skill.run / self.gaps have a place to write + read
    // known-unknowns. Capacity defaults to GAPS_DEFAULT_CAP (1024);
    // absent this call the seam is inert (self.gaps refuses with
    // "no gaps register configured"), matching R102's shape.
    rpc_ctx_set_gaps_reg(ctx, gaps_register_new(0))
    // R109 (Phase J, ADR-0210 tier 2): fresh AgentRegistry so
    // agent.compose can register + install pattern-driven agents at
    // runtime, agent.list can enumerate them, agent.run can dispatch.
    // Absent this call the four agent.* verbs refuse cleanly with
    // "no agent registry in context".
    rpc_ctx_set_agent_reg(ctx, agent_registry_new())
    // R111 (Phase K part 2 / Phase F part 2, ADR-0206): fresh
    // OverrideRegistry so self.override + self.override.list have a
    // place to record + read back the volitional-layer audit trail.
    // The registry owns its own decision log + goal engine + veto reg
    // + safety state; absent this call the two verbs refuse cleanly
    // with "no override registry configured", matching R103/R109 seam
    // shape.
    rpc_ctx_set_override_reg(ctx, ovw_new())
    return ctx
}

// ---- main ----------------------------------------------------------------

fn main() {
    let port = _rpcd_port_from_env()
    if port == 0 {
        println("CrossEngin JSON-RPC daemon: CE_RPC_PORT not set.")
        println("Usage: CE_RPC_PORT=9876 ./bin/crossengin-rpc-daemon")
        println(rpc_server_banner())
        return 1
    }
    let bind = _rpcd_bind_from_env()
    let max_request = _rpcd_max_request_from_env()
    let ip = _rpcd_ip_to_int(bind)
    if ip < 0 {
        println("bad bind IP: " + bind)
        return 1
    }
    let listen_fd = socket(RPCD_AF_INET, RPCD_SOCK_STREAM, 0)
    if listen_fd < 0 {
        println("socket() failed")
        return 1
    }
    let addr = make_sockaddr_in(port, ip)
    if bind_socket(listen_fd, addr, 16) < 0 {
        println("bind failed on " + bind + ":" + int_to_str(port))
        close_fd(listen_fd)
        return 1
    }
    if listen_socket(listen_fd, RPCD_LISTEN_BACKLOG) < 0 {
        println("listen failed on " + bind + ":" + int_to_str(port))
        close_fd(listen_fd)
        return 1
    }
    let ctx = _rpcd_build_ctx(0)
    // R100 --child-mode bootstrap. When CROSSENGIN_CHILD_MODE=1 is set,
    // load + verify the signed bundle at CROSSENGIN_CHILD_BUNDLE_PATH
    // under CROSSENGIN_MOTHER_ANCHOR_PK_B64, apply it to this daemon's
    // registries via session_snapshot_apply_ex, then flip the ctx's
    // CHILD_MODE bit so the wire refuses ingest / bake / admin / install
    // verbs for every request afterwards. Failure to bootstrap when the
    // env var is set is a HARD boot error (silent fallback to mother
    // mode with an unverified bundle would violate the ADR-0203 promise).
    let cm_res = child_mode_bootstrap_from_env()
    let cm_bits = 0
    if cm_res[0] == 1 {
        let cm_payload = cm_res[1]
        cm_bits = cm_payload[0]
        let cm_bundle = cm_payload[1]
        // Apply the bundle to the fresh registries in ctx. We need a
        // trust anchor + overlay + policy_reg + skill_reg -- the bundle
        // carries #PERSONA + #OWNERSHIP + #POLICY + #PATTERN + #SKILL
        // + #KG sections and NO #CAPS / #TRUST (deliberate: bearer
        // tokens are per-mother secrets, per bake.nova docstring).
        let apply_overlay = ownership_registry_new()
        rpc_ctx_set_ownership(ctx, apply_overlay)
        let apply_policy = policy_registry_new()
        rpc_ctx_set_ingest_policy(ctx, apply_policy)
        let ar = session_snapshot_apply_ex(cm_bundle,
                    rpc_ctx_persona_reg(ctx),
                    rpc_ctx_cap_reg(ctx),
                    rpc_ctx_trust_anchors(ctx),
                    apply_overlay,
                    apply_policy,
                    rpc_ctx_skill_reg(ctx),
                    0,          // R101: child bundles carry no user
                                //        preferences (per-user state is
                                //        mother-side; bake bundles are
                                //        deterministic across users).
                    rpc_ctx_agent_reg(ctx),   // R109: bundle-borne agents
                                //        register into the child's live
                                //        agent registry.
                    0)
        rpc_ctx_set_child_mode_bits(ctx, cm_bits)
        // R102: seed the current-bundle-fingerprint chain state so
        // update.apply can enforce parent-fingerprint on the first
        // incoming delta. Precedence:
        //   1. CROSSENGIN_CURRENT_BUNDLE_FINGERPRINT_HEX env var
        //      (operator seed for a fresh child).
        //   2. State file at <CROSSENGIN_STATE_DIR>/current_bundle_fingerprint
        //      (persists across daemon restarts).
        //   3. Empty "" -- first-apply mode (accept any parent).
        let cm_fp = child_mode_current_fingerprint_load()
        if len(cm_fp) > 0 {
            rpc_ctx_set_current_bundle_fingerprint(ctx, cm_fp)
        }
        let cm_path_env = getenv("CROSSENGIN_CHILD_BUNDLE_PATH")
        let cm_path_str = ""
        if cm_path_env != 0 {
            if len(cm_path_env) > 0 { cm_path_str = cm_path_env }
        }
        println("child-mode: ON -- bundle loaded from " + cm_path_str)
        println("           bundle signature verified under anchor pk;")
        println("           KG immutable + ingest/bake/admin verbs refused.")
        if len(cm_fp) > 0 {
            println("           current-bundle fingerprint seeded (" + cm_fp + ")")
        }
    } else {
        if len(cm_res[2]) > 0 {
            println("child-mode: BOOTSTRAP FAILED -- " + cm_res[2])
            println("           refusing to start (would demote trust silently).")
            close_fd(listen_fd)
            return 1
        }
    }
    // R94 TLS bootstrap. Opt-in via CROSSENGIN_TLS=1. Failure to
    // load the cert material with TLS enabled is treated as a hard
    // boot error (better to refuse than to silently downgrade the
    // wire to cleartext without the operator noticing).
    let tls_cfg = 0
    let rng_ctx = 0
    if _rpcd_tls_enabled_from_env() == 1 {
        let cfg = list_new()
        if daemon_load_tls_config_from_sidecar(cfg) != 1 {
            println("TLS: CROSSENGIN_TLS=1 but cert material missing or")
            println("     malformed. Set CROSSENGIN_TLS_LEAF_DER,")
            println("     CROSSENGIN_TLS_LEAF_PRIV, CROSSENGIN_TLS_ROOT_DER")
            println("     to base64(DER-bytes). See docs/SHIP_AS_APP.md")
            println("     section 7.44 for the sidecar recipe.")
            close_fd(listen_fd)
            return 1
        }
        tls_cfg = cfg
        let mode = _rpcd_rng_mode_from_env()
        if len(mode) == 0 {
            println("TLS: CROSSENGIN_RNG_MODE not set. In this sandbox")
            println("     use 'callback' with CROSSENGIN_RNG_FIFO=<path>;")
            println("     'os' works only when getrandom is available.")
            close_fd(listen_fd)
            return 1
        }
        rng_ctx = daemon_build_rng_ctx(mode)
        if rng_ctx == 0 {
            println("TLS: RNG mode '" + mode + "' failed to initialize.")
            println("     'os' likely means seccomp blocks getrandom;")
            println("     'callback' needs CROSSENGIN_RNG_FIFO=<path>;")
            println("     'test' needs CROSSENGIN_RNG_SEED=<string>.")
            close_fd(listen_fd)
            return 1
        }
    }
    println("=== " + rpc_server_banner() + " ===")
    println("listening on " + bind + ":" + int_to_str(port)
        + "  (max_request=" + int_to_str(max_request) + " bytes)")
    if tls_cfg == 0 {
        println("TLS: OFF (default). Set CROSSENGIN_TLS=1 + the three")
        println("     CROSSENGIN_TLS_* env vars + CROSSENGIN_RNG_MODE")
        println("     to opt into in-process TLS 1.3 (see docs/SHIP_AS_APP.md")
        println("     section 7.44).")
    } else {
        println("TLS: ON (R94, in-process TLS 1.3 with")
        println("     TLS_CHACHA20_POLY1305_SHA256, x25519, Ed25519).")
        println("     RNG mode: " + _rpcd_rng_mode_from_env())
    }
    if rpc_ctx_cap_enforced(ctx) == 1 {
        let cap_reg = rpc_ctx_cap_reg(ctx)
        let n = capability_registry_count(cap_reg)
        println("sandbox: ENFORCED (ADR-0105) -- every request must carry"
            + " {\"token\": \"<id>\"}. " + int_to_str(n)
            + " token(s) minted at boot.")
        if n == 0 {
            println("warning: no admin token loaded. Set CE_RPC_ADMIN_TOKEN_FILE"
                + " to a file containing a fresh 128-bit hex id before restarting;"
                + " enforcement will refuse every request until then.")
        }
    } else {
        println("sandbox: OFF (default) -- set CE_RPC_REQUIRE_TOKEN=1"
            + " + CE_RPC_ADMIN_TOKEN_FILE=<path> to enforce capability"
            + " tokens (see docs/adr/0105-sandbox-architecture.md).")
    }
    if rpc_ctx_signed_enforced(ctx) == 1 {
        println("signed-skill: ENFORCED (R54.2/R55.1) -- skill.install"
            + " requires a signed SkillPackage against a trust anchor."
            + " Pre-register anchors in-process before starting.")
    } else {
        println("signed-skill: OFF (default) -- set"
            + " CE_RPC_REQUIRE_SIGNED_SKILL=1 to require ed25519-signed"
            + " skill installs on the wire (see docs/adr/0105).")
    }
    let snap_dir = rpc_ctx_snapshot_dir(ctx)
    if len(snap_dir) > 0 {
        println("snapshot: ENABLED (R55.3) -- session.save / session.load"
            + " write to " + snap_dir + "/<name>.snap (chmod 0700 the dir).")
    } else {
        println("snapshot: OFF (default) -- set CE_RPC_SNAPSHOT_DIR=<path>"
            + " to enable session.save / session.load.")
    }
    println("hit with: echo '{\"verb\":\"kg.list\"}' | nc "
        + bind + " " + int_to_str(port))
    // Accept loop. One request per connection; connection is closed
    // after the response is sent. Serial (no threads): the daemon
    // trades throughput for simplicity in this first cut.
    let served = 0
    let go = 1
    while go == 1 {
        let conn_fd = accept_conn(listen_fd, 0, 0)
        if conn_fd < 0 {
            // A negative accept means the listen socket was closed or
            // a signal interrupted the syscall. Either way, wind up.
            go = 0
        } else {
            // R94 wire-integration: wire_connection_wrap now flips to
            // real TLS when tls_cfg is non-null. When null it stays a
            // pass-through, so pre-R94 deployments boot unchanged. See
            // ADR r86-in-process-tls-scaffolding for the phase history.
            let wrapped = list_new()
            let hok = wire_connection_wrap(conn_fd, tls_cfg, rng_ctx, wrapped)
            if hok != 1 {
                // Handshake failure -- drop the connection quietly and
                // move on. A hostile / mis-configured peer must not
                // hang the accept loop.
                close_fd(conn_fd)
            } else {
                served = served + 1
                let req = _rpcd_read_line_via_conn(wrapped, max_request)
                let resp = rpc_server_handle_line(req, ctx)
                _rpcd_send_via_conn(wrapped, resp + "\n")
                wire_connection_close(wrapped)
            }
        }
    }
    close_fd(listen_fd)
    println("bye. (served " + int_to_str(served) + " request(s))")
    return 0
}

main()
