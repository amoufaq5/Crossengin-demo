// CrossEngin /recall scenario driver (R8F).
//
// Purpose
//   Mirror of examples/episodic_demo.nova (R6F's write-side scenario)
//   for the READ side. Drive the substrate through a known observation
//   sequence, run the consolidation pass, and exercise every /recall
//   subcommand by calling episodic_recall_cmd directly -- the same
//   function the chat dispatch (`/recall ...`) routes to. Stdout carries
//   the formatted RECALL lines so the shell scenario can assert on them.
//
//   The two-cluster fixture is identical to test_episodic_retrieval's
//   _fixture_two_episodes:
//     - 5x (1,2,3) at ts 0/10/20/30/40
//     - 5x (4,5,6) at ts 200/210/220/230/240
//   After consolidation, episode id 0 is the newer {4,5,6} (the
//   consolidation scan walks newest-first) and episode id 1 is the older
//   {1,2,3}.
//
// NOVA dependencies: builtins + std/io. CrossEngin dependencies:
//   src/kg/episodic.nova (carries both the retrieval API and the
//   episodic_recall_cmd chat dispatcher).

import "std/syscall"
import "std/string"
import "std/io"
import "../src/kg/episodic.nova"

fn capture(stream, ts, a, b, c) {
    let m = ms_capture(stream, ts, MODALITY_TEXT, "x", 600, 0)
    moment_add_trace(m, a)
    moment_add_trace(m, b)
    moment_add_trace(m, c)
    return m
}

fn main() {
    let stream = ms_new()
    // Cluster 1: {1,2,3} at ts 0..40.
    let i = 0
    while i < 5 {
        capture(stream, i * 10, 1, 2, 3)
        i = i + 1
    }
    // Cluster 2: {4,5,6} at ts 200..240 (well outside COOCCUR_WINDOW
    // boundary so it consolidates as a separate cluster).
    let j = 0
    while j < 5 {
        capture(stream, 200 + j * 10, 4, 5, 6)
        j = j + 1
    }

    io_println("DRIVER moments=" + int_to_str(ms_count(stream)))

    // Sanity probe: a transient pre-consolidation pass to confirm the
    // two clusters mint cleanly and the store size matches.
    let probe_eas = episodic_atoms_new()
    let minted = episodic_consolidate(probe_eas, stream, 0, 0)
    io_println("DRIVER minted=" + int_to_str(minted))
    io_println("DRIVER store_size=" + int_to_str(episodic_atoms_count(probe_eas)))

    // Exercise each /recall subcommand via the chat dispatcher. Each
    // call re-runs consolidation internally so the dispatch path is
    // bit-identical to what the chat process does.
    episodic_recall_cmd(stream, "member 1")
    episodic_recall_cmd(stream, "member 4")
    episodic_recall_cmd(stream, "member 99")
    episodic_recall_cmd(stream, "window 0 50")
    episodic_recall_cmd(stream, "window 100 200")
    episodic_recall_cmd(stream, "window 0 1000")
    episodic_recall_cmd(stream, "top")
    episodic_recall_cmd(stream, "recent")
    // Empty arg path prints a usage line.
    episodic_recall_cmd(stream, "")
    // Unknown subcommand prints the help diagnostic.
    episodic_recall_cmd(stream, "bogus")

    exit(0)
}

main()
