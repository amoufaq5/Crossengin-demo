// CrossEngin schema-migration driver (atom-shape evolution).
//
// Purpose
//   Companion to examples/migrate_snap.nova. That binary handles the
//   CONTAINER migration (v1 wire -> v2 wire); this one handles the
//   atom-shape migration the schema-evolution framework owns
//   (src/persistence/schema_migration.nova).
//
//   Reads a v2 snapshot from $CE_MIGRATE_OLD, materializes a live KG
//   registry from the KGS section, runs `snap_post_load_migrate` to
//   bring every atom up to SCHEMA_CURRENT_VERSION, re-serializes the
//   migrated section, stamps the snapshot's atoms_version slot, and
//   writes the result to $CE_MIGRATE_NEW.
//
//   Reports:
//     migrated atoms v<old> -> v<new> (N atoms across K KGs)
//     written <bytes> bytes to <path>
//
//   The integration scenario scenario_ll_schema_migrate.sh exercises
//   this binary on a hand-rolled snapshot whose meta block lacks the
//   `schema.atoms_version` line (legacy V1 shape) and confirms that
//   the output declares schema.atoms_version 3 and that a re-load of
//   the output is idempotent.
//
//   Env-var I/O follows the codebase convention (CE_SNAP_PATH,
//   CE_DLOG_PATH, CE_MIGRATE_OLD/NEW): NOVA programs don't see argv.
//
// ADRs touched: ADR-0048 (persistence). NOVA dependencies: builtins.

import "std/syscall"
import "std/string"
import "std/io"
import "../src/persistence/snapshot_disk.nova"
import "../src/persistence/snapshot_reader.nova"
import "../src/persistence/schema_migration.nova"
import "../src/kg/multi_kg_manager.nova"
import "../src/kg/atom_store.nova"

fn _usage() {
    io_println("usage: CE_MIGRATE_OLD=OLD.snap CE_MIGRATE_NEW=NEW.snap nova run examples/migrate_schema.nova")
}

fn main() {
    let old_path = getenv("CE_MIGRATE_OLD")
    let new_path = getenv("CE_MIGRATE_NEW")
    if old_path == 0 { _usage() exit(2) }
    if new_path == 0 { _usage() exit(2) }
    if len(old_path) == 0 { _usage() exit(2) }
    if len(new_path) == 0 { _usage() exit(2) }

    let raw = snap_read_text(old_path)
    if raw == 0 {
        io_println("migrate_schema: cannot read '" + old_path + "'")
        exit(2)
    }
    if len(raw) == 0 {
        io_println("migrate_schema: input file is empty")
        exit(2)
    }
    let s = snap_from_text(raw)
    if s == 0 {
        io_println("migrate_schema: parse failed")
        exit(2)
    }
    let from_v = snap_meta_atoms_version(s)
    let snapshot_ts = snap_timestamp(s)

    // Stand up a minimal KG registry that mirrors the snapshot's atom
    // labels. The atom-shape migration runs on live atom objects, so
    // we apply the snapshot's KGS section into a fresh registry,
    // migrate, then re-build the section blob from the migrated atoms.
    let reg = kg_registry_new()
    let atom_count = 0
    let kg_count_before = 0
    if snap_has_section(s, SEC_KGS) == 1 {
        let blob = snap_section(s, SEC_KGS)
        let recs = list_new()
        if len(blob) > 1 { recs = blob[1] }
        // Bug 1 guard in kg_section_apply needs the labels to be
        // pre-spawned. Walk the records and spawn each KG label.
        let i = 0
        while i < len(recs) {
            let r = recs[i]
            kg_spawn(reg, r[0])
            i = i + 1
        }
        kg_count_before = kg_count(reg)
        let installed = kg_section_apply(reg, blob, snapshot_ts)
        atom_count = installed
    }

    let migrated = snap_post_load_migrate(s, reg)
    let to_v = snap_meta_atoms_version(s)

    // Re-build the KGS section from the now-migrated atoms. Each KG's
    // blob is the standard kg_section_build shape; we re-emit each KG
    // and concat the records into a single section. For the demo we
    // only support one KG -- the test fixture has one anyway.
    if kg_count(reg) > 0 {
        let new_blob = list_new()
        let total = 0
        let all_recs = list_new()
        let i = 0
        while i < kg_count(reg) {
            let kg = kg_get(reg, i)
            let b = kg_section_build(kg)
            total = total + b[0]
            let recs_i = b[1]
            let j = 0
            while j < len(recs_i) {
                push(all_recs, recs_i[j])
                j = j + 1
            }
            i = i + 1
        }
        push(new_blob, total)
        push(new_blob, all_recs)
        snap_put_section(s, SEC_KGS, new_blob)
    }

    let ok = snap_save(s, new_path)
    if ok == 0 {
        io_println("migrate_schema: write failed")
        exit(2)
    }
    let new_raw = snap_read_text(new_path)
    let new_size = 0
    if new_raw != 0 { new_size = len(new_raw) }

    let r = "migrated atoms v"
    r = r + int_to_str(from_v)
    r = r + " -> v"
    r = r + int_to_str(to_v)
    r = r + " ("
    r = r + int_to_str(migrated)
    r = r + " atoms across "
    r = r + int_to_str(kg_count(reg))
    r = r + " KGs)"
    io_println(r)

    let w = "written "
    w = w + int_to_str(new_size)
    w = w + " bytes to "
    w = w + new_path
    io_println(w)
    exit(0)
}
main()
