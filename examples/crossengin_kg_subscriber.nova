// CrossEngin KG sync subscriber (Phase 20 / Tier 4 #2 distributed-substrate seam).
//
// Purpose
//   Minimum-viable subscriber half of the kg-sync demo: dial a localhost TCP
//   publisher, perform the HELLO + SUB-* handshake, then read ATOM lines
//   forever. Each one is applied to the subscriber's local language KG with
//   the same kind / belief / label as the publisher side, so the two
//   processes converge.
//
//   Protocol details + safety defaults live in
//   src/io/transducers/kg_sync.nova. The subscriber's own KG starts empty --
//   without the publisher this binary holds no knowledge, by design (the
//   publisher OWNS the world; the subscriber is a clone).
//
//   Run with: ./bin/crossengin-kg-subscriber
//   Env:
//     CE_KGSYNC_HOST  -- publisher host (default 127.0.0.1)
//     CE_KGSYNC_PORT  -- publisher port (default 8766)
//
//   The subscriber prints `recv kg=lang id=42 label=widget` on each atom
//   so the integration scenario can grep its output for the expected labels.
//
// ADRs exercised: same as crossengin_kg_publisher.nova; this is the receive
//   side of the same atom-birth wire.

import "../src/io/transducers/kg_sync.nova"
import "../src/kg/multi_kg_manager.nova"

let CE_KGSYNC_MAX_ATOMS = 1024

fn _kgsync_host_from_env() {
    let env = getenv("CE_KGSYNC_HOST")
    if env != 0 {
        if len(env) > 0 { return env }
    }
    return "127.0.0.1"
}

fn main() {
    let host = _kgsync_host_from_env()
    let port = kgsync_port_from_env()
    println("kg-subscriber: dialing " + host + ":" + int_to_str(port))

    // 1. BOOT: own a small language KG, empty -- knowledge will arrive from
    // the publisher and be installed here.
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "language")
    println("kg-subscriber: boot kg=language atoms=" + int_to_str(kg_atom_count(kg)))

    // 2. CONNECT + HANDSHAKE.
    let conn_fd = sync_sub_connect(host, port)
    if conn_fd < 0 {
        println("kg-subscriber: ERROR cannot connect / handshake")
        exit(1)
    }
    println("kg-subscriber: handshake OK, subscribing to all atoms")

    // 3. RECEIVE LOOP: pull ATOM lines until BYE / EOF / error.
    let received = 0
    let go = 1
    while go == 1 {
        let rec = sync_sub_recv_atom(conn_fd)
        if rec == 0 {
            go = 0
        } else {
            let pub_kg    = rec[KGSYNC_R_KG]
            let pub_id    = rec[KGSYNC_R_ID]
            let pub_kind  = rec[KGSYNC_R_KIND]
            let pub_alpha = rec[KGSYNC_R_ALPHA]
            let pub_beta  = rec[KGSYNC_R_BETA]
            let pub_label = rec[KGSYNC_R_LABEL]

            // Install in the subscriber's local KG. We use the simplest API
            // (kg_add_atom) and then mirror the belief alpha/beta the
            // publisher reported, so the subscriber's view of the atom's
            // evidence matches the publisher's right after birth.
            let a = kg_add_atom(kg, pub_kind, pub_label, 0)
            let b = atom_belief(a)
            list_set(b, 0, pub_alpha)
            list_set(b, 1, pub_beta)

            received = received + 1
            // The integration test greps this line; keep the format stable.
            println("recv kg=" + pub_kg
                + " id=" + int_to_str(pub_id)
                + " label=" + pub_label)
            if received >= CE_KGSYNC_MAX_ATOMS {
                println("kg-subscriber: max atoms reached, closing")
                go = 0
            }
        }
    }

    // 4. CLOSE.
    sync_sub_bye(conn_fd)
    sync_close(conn_fd)
    println("kg-subscriber: closed (received " + int_to_str(received)
        + " atom(s), local kg=" + int_to_str(kg_atom_count(kg)) + ")")
}
main()
