// CrossEngin /find scenario driver (R10C).
//
// Purpose
//   Mirror of examples/episodic_recall_demo.nova for the new R10C
//   semantic-search retrieval surface. Drive a stand-alone TF-IDF
//   index through a 10-atom textual fixture (topics: ML, NLP, food,
//   weather, music, sports, history, geography, literature, code)
//   and exercise the public API (ss_search, ss_search_by_atom_id,
//   ss_find_cmd) the chat dispatch routes to. Stdout carries the
//   formatted FIND lines so the shell scenario can assert on them.
//
//   The semantic-search index is a TF-IDF + integer-cosine ranker; no
//   neural embedding, no LLM call. The 10-atom fixture is laid out so
//   the "machine learning" query has an obvious winner (atom 1, the
//   ML-themed sentence) and "nonsense gibberish" hits nothing (all
//   query tokens are below the IDF floor / unknown).
//
// NOVA dependencies: builtins + std/io. CrossEngin dependencies:
//   src/kg/semantic_search.nova (carries both the index API and the
//   ss_find_cmd dispatcher).

import "std/syscall"
import "std/string"
import "std/io"
import "../src/kg/semantic_search.nova"

fn _add(ix, id, label) {
    ss_index_add_atom(ix, id, label)
    return 1
}

fn main() {
    let ix = ss_index_new()
    _add(ix,  1, "machine learning models data analysis predictions")
    _add(ix,  2, "deep learning neural networks training algorithm")
    _add(ix,  3, "the quick brown fox jumps over the lazy dog")
    _add(ix,  4, "cooking recipes kitchen food preparation ingredients")
    _add(ix,  5, "weather forecast sunny clear sky temperature humidity")
    _add(ix,  6, "music classical composers orchestra symphony piano")
    _add(ix,  7, "sports football basketball tennis golf athletics")
    _add(ix,  8, "history ancient rome empire civilization legacy")
    _add(ix,  9, "geography mountains rivers lakes forests continents")
    _add(ix, 10, "literature poetry novels stories writing fiction")

    io_println("DRIVER atoms=" + int_to_str(ss_index_atom_count(ix)))
    io_println("DRIVER tokens=" + int_to_str(ss_index_token_count(ix)))

    // Smoke probe: empty index, empty query, top_k=0 all return empty.
    let empty_ix = ss_index_new()
    let h_empty = ss_search(empty_ix, "anything", 5)
    io_println("DRIVER empty_index_hits=" + int_to_str(len(h_empty)))

    // Query 1: "machine learning" -- atom 1 must rank first.
    let h1 = ss_search(ix, "machine learning", 5)
    io_println("FIND query=\"machine learning\" matched=" + int_to_str(len(h1)))
    let i = 0
    while i < len(h1) {
        io_println("RESULT rank=" + int_to_str(i + 1)
            + " atom_id=" + int_to_str(h1[i][0])
            + " sim=" + int_to_str(h1[i][1]) + " milli")
        i = i + 1
    }
    io_println("FIND_END query=\"machine learning\"")

    // Query 2: "nonsense gibberish" -- all-unknown tokens, expect 0 hits.
    let h2 = ss_search(ix, "nonsense gibberish floccinaucinihilipilification", 5)
    io_println("FIND query=\"nonsense\" matched=" + int_to_str(len(h2)))
    let j = 0
    while j < len(h2) {
        io_println("RESULT rank=" + int_to_str(j + 1)
            + " atom_id=" + int_to_str(h2[j][0])
            + " sim=" + int_to_str(h2[j][1]) + " milli")
        j = j + 1
    }
    io_println("FIND_END query=\"nonsense\"")

    // Query 3: "fox dog" -- only atom 3 matches.
    let h3 = ss_search(ix, "fox dog", 5)
    io_println("FIND query=\"fox dog\" matched=" + int_to_str(len(h3)))
    let k = 0
    while k < len(h3) {
        io_println("RESULT rank=" + int_to_str(k + 1)
            + " atom_id=" + int_to_str(h3[k][0])
            + " sim=" + int_to_str(h3[k][1]) + " milli")
        k = k + 1
    }
    io_println("FIND_END query=\"fox dog\"")

    // Query 4: by_atom_id(1) -- query atom 1 must NOT appear in its own
    // results; the only related atom in the fixture is atom 2 (shares
    // "training" lemma indirectly -- but the lexical TF-IDF treats them
    // as disjoint, so we just check that atom 1 itself is absent).
    let h4 = ss_search_by_atom_id(ix, 1, 5)
    io_println("FIND by_id=1 matched=" + int_to_str(len(h4)))
    let m = 0
    while m < len(h4) {
        io_println("RESULT rank=" + int_to_str(m + 1)
            + " atom_id=" + int_to_str(h4[m][0])
            + " sim=" + int_to_str(h4[m][1]) + " milli")
        m = m + 1
    }
    io_println("FIND_END by_id=1")

    exit(0)
}

main()
