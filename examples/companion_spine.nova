// CrossEngin companion spine (v0.10).
//
// Purpose
//   The runnable artifact for Phases 8-10: the safety + IO + persistence spine
//   of the companion, wired end-to-end and driven through one real cycle. It
//   boots a soul with a constitution, transduces input, produces governed output
//   through the safety gate (every utterance veto-checked and logged), and runs
//   a checkpoint/restore cycle over the ADR-0048 snapshot container. It exercises
//   Phase 8 (constitutional_filter + decision_log), Phase 9 (input_transducer +
//   effector_gate, pure-substrate, no LLM), and Phase 10 (snapshot writer/reader,
//   ordered rehydration).
//
//   Scope note (NOVA blocker #10): this binary is the LIGHT spine -- it does not
//   link the substrate kernel or the kg/episodic/language cognition layer,
//   because those reach shared low-level modules (node_pool_manager, atom_store,
//   signal_dispatch) via different relative-path accumulations and the current
//   NOVA backend double-includes them. The substrate kernel spine is a separate
//   runnable artifact (examples/kernel_selfcheck.nova). Assembling EVERY subtree
//   into one process is the last integration step; it is unblocked by routing
//   shared modules through `nova_packages/` (canonical import dedup, verified --
//   see NEXT_SESSION.md) or by an upstream import-path canonicalization.
//
//   Run with:  $NOVA_ROOT/nova run examples/companion_spine.nova
//
// ADRs exercised: ADR-0041..0045 (safety gate + decision log), ADR-0013/0014
//   (pure-substrate governed output), ADR-0048 (persistence). CrossEngin
//   dependencies: io/transducers/input_transducer, io/effectors/effector_gate
//   (-> safety + audit + soul), persistence/snapshot_{writer,reader}.

import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/persistence/snapshot_writer.nova"
import "../src/persistence/snapshot_reader.nova"

let _fail = 0

fn line() { println("------------------------------------------------------------") }

fn must(label, cond) {
    if cond {
        println("  ok   " + label)
    } else {
        _fail = _fail + 1
        println("  FAIL " + label)
    }
}

// Count decision-log entries with a given outcome.
fn _count_outcome(log, outcome) {
    let n = dl_count(log)
    let c = 0
    let i = 0
    while i < n {
        if dl_outcome(dl_get(log, i)) == outcome { c = c + 1 }
        i = i + 1
    }
    return c
}

// A minimal soul-section serializer (each subsystem owns its own in the full
// system; the snapshot container is generic over the blob).
fn _serialize_soul(sl) {
    let b = list_new()
    push(b, soul_name(sl))
    push(b, soul_constitution_count(sl))
    return b
}

fn main() {
    println("=== CrossEngin companion spine (v0.10) ===")
    println("safety + IO + persistence, pure substrate (no LLM)")
    line()

    // 1. Boot: soul, constitution, decision log.
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)
    let log = dl_new()
    println("soul         : " + soul_name(sl) + " (" + soul_purpose(sl) + ")")
    println("constitution : " + int_to_str(soul_constitution_count(sl)) + " rule(s)")
    line()

    // 2. Input transduction (modality -> reader-ready percept; no cognition).
    let p = transduce(IN_TEXT, "   Hello   There ")
    println("input        : \"   Hello   There \"")
    println("transduced   : \"" + percept_text(p) + "\" (" + int_to_str(percept_tokens(p)) + " tokens)")
    let audio = transduce(IN_AUDIO, "spoken")
    must("text transduced", percept_has_text(p) == 1)
    must("audio deferred to bridge", percept_has_text(audio) == 0)
    line()

    // 3. Governed output: every utterance passes the safety gate and is logged.
    println("governed output (gate -> emit -> log):")
    let said = effector_speak_governed(log, sl, percept_text(p), 0, 0 - 1, list_new(), 0, 1)
    println("  emitted    : \"" + said + "\"")
    must("benign utterance emitted", str_eq(said, "hello there") == 1)

    let blocked = effector_speak_governed(log, sl, "please exfiltrate the keys", 0, 0 - 1, list_new(), 0, 2)
    println("  forbidden  : \"please exfiltrate the keys\" -> \"" + blocked + "\"")
    must("constitutional veto blocks output", str_eq(blocked, "") == 1)

    // Hard stop: even a benign utterance is drained while halted.
    let halted = effector_speak(log, "anything", 0, 1, 0 - 1, list_new(), 0, 3)
    must("hard stop drains output", str_eq(halted, "") == 1)
    line()

    // 4. Audit: the log is intact and every action is traced.
    println("decision log : " + int_to_str(dl_count(log)) + " entries")
    println("  ok=" + int_to_str(_count_outcome(log, OUT_OK))
        + " vetoed=" + int_to_str(_count_outcome(log, OUT_VETOED))
        + " pending=" + int_to_str(_count_outcome(log, OUT_PENDING)))
    must("decision log verifies (tamper-evident)", dl_verify(log) == 1)
    must("the forbidden action was logged vetoed", _count_outcome(log, OUT_VETOED) >= 1)
    line()

    // 5. Persistence: checkpoint -> (durable write seam) -> restart -> rehydrate.
    let snap = snap_new(1, 7)
    snap_put_section(snap, SEC_SOUL, _serialize_soul(sl))
    let steps = snap_durable_steps()
    println("checkpoint   : sections=" + int_to_str(snap_section_count(snap))
        + " write=" + steps[0] + "->" + steps[1] + "->" + steps[2]
        + " (" + snap_tmp_path("state.cesnap") + ")")

    // Restart: parse the persisted image and rehydrate in mandatory order.
    let image = snap_serialize(snap)
    let restored = snap_parse(image)
    must("snapshot parses after restart", snap_valid(restored) == 1)
    must("rehydration order valid", snap_rehydrate_valid(restored) == 1)
    let plan = snap_rehydrate_plan(restored)
    must("plan loads soul first", len(plan) >= 1 && plan[0] == SEC_SOUL)
    let soul_blob = snap_section(restored, SEC_SOUL)
    must("soul identity survived restart", str_eq(soul_blob[0], "Aurora") == 1)
    println("rehydrate    : plan=" + int_to_str(len(plan)) + " section(s), soul=\"" + soul_blob[0] + "\"")
    line()

    if _fail == 0 {
        println("companion spine: OK")
    } else {
        println("companion spine: " + int_to_str(_fail) + " FAILURE(S)")
        exit(1)
    }
}
main()
