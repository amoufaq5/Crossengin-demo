// CrossEngin snapshot migration tool.
//
// Purpose
//   One-shot driver: read OLD.snap from $CE_MIGRATE_OLD, run the v1 -> v2
//   migration via snap_load + snap_save, write NEW.snap to $CE_MIGRATE_NEW,
//   and print a one-line report (`migrated v<old> -> v<new> ({old_size} ->
//   {new_size} bytes)`). The on-disk reader (`snap_from_text`) already
//   dispatches v1 files through `snap_migrate_v1_to_v2` automatically --
//   this binary just composes load + save so an operator can rewrite an
//   old file without booting the chat.
//
//   We resolve the input version BEFORE snap_load runs the migration so the
//   report can name both endpoints honestly (v1 -> v2). The text reader
//   sets the in-memory version to SNAP_FORMAT_VERSION after a successful
//   migration, so post-load it always reads as the current version; we
//   therefore peek at the raw `ver N` line before parsing.
//
//   We take paths via env vars (CE_MIGRATE_OLD / CE_MIGRATE_NEW) rather
//   than CLI args because NOVA doesn't expose argc/argv to programs --
//   the same pattern the rest of the codebase uses (e.g. CE_SNAP_PATH,
//   CE_DLOG_PATH, CE_AUDIO_CAPTURE_CMD). The shell wrapper
//   (`scripts/migrate_snapshot.sh`) sets the env before invoking this
//   binary.
//
//   Errors are surfaced on stdout (io_println, picked up by the shell
//   wrapper) with a non-zero exit code so the wrapper can detect them.
//
// Run with:
//   CE_MIGRATE_OLD=OLD.snap CE_MIGRATE_NEW=NEW.snap \
//     $NOVA_ROOT/nova run examples/migrate_snap.nova
//
// ADRs exercised: ADR-0048 (persistence container + format), SNAPSHOT_FORMAT.md
// (versioning policy + migration table).

import "std/syscall"
import "std/string"
import "std/io"
import "../src/persistence/snapshot_disk.nova"
import "../src/persistence/snapshot_reader.nova"

// Find the version stamped in the raw text. Returns -1 if not found. The
// reader's text format is line-oriented `key val\n` so any standalone
// `ver ` line is the load-bearing field.
fn _peek_version(text) {
    let needle = "ver "
    let nlen = len(needle)
    let n = len(text)
    let i = 0
    while i + nlen <= n {
        let hit = 1
        let j = 0
        while j < nlen {
            if char_at(text, i + j) != char_at(needle, j) {
                hit = 0
                j = nlen
            }
            j = j + 1
        }
        // `ver ` must start at a line beginning to avoid matching
        // accidentals like `cover ` or trailing `ver ` inside another
        // line's value.
        if hit == 1 {
            let at_start = 0
            if i == 0 { at_start = 1 }
            if i > 0 {
                if char_at(text, i - 1) == 10 { at_start = 1 }
            }
            if at_start == 1 {
                let p = i + nlen
                let acc = 0
                let saw = 0
                let neg = 0
                if p < n {
                    if char_at(text, p) == 45 {   // '-'
                        neg = 1
                        p = p + 1
                    }
                }
                let done = 0
                while p < n {
                    if done == 0 {
                        let c = char_at(text, p)
                        if c == 10 {
                            done = 1
                        } else {
                            if c >= 48 {
                                if c <= 57 {
                                    acc = acc * 10 + (c - 48)
                                    saw = 1
                                } else {
                                    done = 1
                                }
                            } else {
                                done = 1
                            }
                        }
                    }
                    p = p + 1
                }
                if saw == 1 {
                    if neg == 1 { return 0 - acc }
                    return acc
                }
                return -1
            }
        }
        i = i + 1
    }
    return -1
}

fn _usage() {
    io_println("usage: CE_MIGRATE_OLD=OLD.snap CE_MIGRATE_NEW=NEW.snap nova run examples/migrate_snap.nova")
}

fn main() {
    let old_path = getenv("CE_MIGRATE_OLD")
    let new_path = getenv("CE_MIGRATE_NEW")
    if old_path == 0 {
        _usage()
        exit(2)
    }
    if new_path == 0 {
        _usage()
        exit(2)
    }
    if len(old_path) == 0 {
        _usage()
        exit(2)
    }
    if len(new_path) == 0 {
        _usage()
        exit(2)
    }

    // Step 1: read raw text + peek at the on-disk version.
    let raw = snap_read_text(old_path)
    if raw == 0 {
        io_println("migrate_snap: cannot read '" + old_path + "'")
        exit(2)
    }
    if len(raw) == 0 {
        io_println("migrate_snap: input file is empty")
        exit(2)
    }
    let old_ver = _peek_version(raw)
    let old_size = len(raw)

    // Step 2: parse + migrate. snap_from_text dispatches on the version
    // field internally, calling snap_migrate_v1_to_v2 for v1 files and
    // rejecting v3+ as un-migratable.
    let s = snap_from_text(raw)
    if s == 0 {
        let msg = "migrate_snap: parse failed (corrupt, malformed, or v"
        msg = msg + int_to_str(old_ver)
        msg = msg + " is newer than this build supports)"
        io_println(msg)
        exit(2)
    }
    let new_ver = snap_version(s)

    // Step 3: write the migrated snapshot. snap_save serializes via
    // snap_to_text (which emits the v2 meta lines) and runs the crash-safe
    // write contract.
    let ok = snap_save(s, new_path)
    if ok == 0 {
        io_println("migrate_snap: write failed")
        exit(2)
    }
    let new_raw = snap_read_text(new_path)
    let new_size = 0
    if new_raw != 0 { new_size = len(new_raw) }

    // Step 4: one-line report. Split the concat to keep clear of the
    // NOVA codegen pointer-threshold (long chained "+" expressions).
    let r = "migrated v"
    r = r + int_to_str(old_ver)
    r = r + " -> v"
    r = r + int_to_str(new_ver)
    r = r + " ("
    r = r + int_to_str(old_size)
    r = r + " -> "
    r = r + int_to_str(new_size)
    r = r + " bytes)"
    io_println(r)
    exit(0)
}
main()
