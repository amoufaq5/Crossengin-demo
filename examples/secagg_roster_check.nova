// CrossEngin: check a SecAgg v4 roster and identity key (A2.1).
//
// Usage (NOVA has no argv; configuration is by environment):
//   CE_SECAGG_ROSTER=<roster file> [CE_SECAGG_ID_KEY=<seed file>] \
//     nova run examples/secagg_roster_check.nova
//
// Prints the soul count N, the threshold t, the roster fingerprint (compare
// it out of band between every soul and the coordinator) and each soul's
// id, name and Shamir x. With CE_SECAGG_ID_KEY it also loads the identity
// seed and prints which roster entry it belongs to.
//
// Exit status: 0 when everything given checks out, 1 when the roster or
// the identity key is refused (the reason is printed).
//
// CrossEngin dependencies: src/learning/sa_roster.nova.

import "../src/learning/sa_roster.nova"

fn main() {
    let r = sroster_load_from_env()
    if sroster_ok(r) != 1 {
        println("refused: " + sroster_err(r))
        exit(1)
    }
    println("roster ok: n=" + int_to_str(sroster_n(r)) + " t=" + int_to_str(sroster_t(r)))
    println("fingerprint: " + sroster_fingerprint(r))
    println("fingerprint (short): " + sroster_fp_short(sroster_fingerprint(r)))
    let es = sroster_entries(r)
    let i = 0
    while i < len(es) {
        let e = es[i]
        println("soul id=" + int_to_str(e[0]) + " name=" + e[1] + " x=" + int_to_str(e[4]))
        i = i + 1
    }
    let kp = getenv("CE_SECAGG_ID_KEY")
    if kp == 0 {
        println("self: CE_SECAGG_ID_KEY not set (roster checked only)")
        exit(0)
    }
    let me = sroster_identity_from_env(r)
    if me[0] != 1 {
        println("refused: " + me[1])
        exit(1)
    }
    let se = me[2]
    println("self: id=" + int_to_str(se[0]) + " name=" + se[1] + " x=" + int_to_str(se[4]))
    let seed = me[3]
    let k = 0
    while k < len(seed) {
        list_set(seed, k, 0)
        k = k + 1
    }
    exit(0)
}

main()
