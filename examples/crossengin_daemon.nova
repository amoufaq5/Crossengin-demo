// CrossEngin unified daemon (v1.0).
//
// Purpose
//   The whole agent in ONE process, run as a real multi-cycle loop. This is the
//   cross-subtree assembly unblocked by the NOVA import-path fix (blocker #10):
//   it boots the substrate kernel, knowledge graphs, the soul + constitution,
//   the goal engine, the scheduler, the emotion system, and the IO / safety /
//   audit / persistence stack, then drives several wake -> appraise -> modulate
//   -> tick -> decide -> act/checkpoint cycles. Pure substrate, NO LLM anywhere
//   in cognition or output (ADR-0014).
//
//   The loop closes the affect feedback the earlier spine demos left neutral:
//   each cycle appraises the event (ADR-0035), the emotion loop sets mood, and
//   that mood becomes the substrate tick's PLASTICITY MODULATOR while a
//   predictive-coding residual (ADR-0024) becomes the tick's ERROR -- so
//   learning rate is genuinely affect-modulated, not a placeholder. Idle cycles
//   checkpoint the substrate (ADR-0037 idle hook + ADR-0048); on a forbidden
//   action the constitutional gate vetoes and logs it.
//
//   Run with:  $NOVA_ROOT/nova run examples/crossengin_daemon.nova
//
// ADRs exercised: ADR-0001/0006/0008/0009 (substrate), 0016 (atoms), 0033
//   (goals/drives), 0034/0045 (soul/constitution), 0035 (emotion + plasticity
//   modulation), 0024 (predictive coding), 0037 (scheduler), 0013/0014 (IO),
//   0041..0043 (gate + log), 0048 (persistence). CrossEngin dependencies: the
//   substrate, kg, goals, soul, emotion, scheduler, io, and persistence subtrees.

import "../src/substrate/gate_router.nova"
import "../src/substrate/part_lifecycle.nova"
import "../src/kg/multi_kg_manager.nova"
import "../src/scheduler/hybrid_scheduler.nova"
import "../src/agent/loop_emotion.nova"
import "../src/agent/loop_goals.nova"
import "../src/parts/emotion/plasticity_mod.nova"
import "../src/learning/predictive_coding_runtime.nova"
import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/output_generation.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/persistence/snapshot_writer.nova"
import "../src/persistence/snapshot_reader.nova"

let CE_CAP   = 128
let CE_FIRST = 8
let _fail = 0

fn line() { println("------------------------------------------------------------") }

fn must(label, cond) {
    if cond {
        println("  ok   " + label)
    } else {
        _fail = _fail + 1
        println("  FAIL " + label)
    }
}

fn _intent1(role, lemma) {
    let it = list_new()
    let a = list_new() push(a, role) push(a, lemma)
    push(it, a)
    return it
}

// One scripted episode cycle: [input, desirability, praise, appeal] (the appraisal
// dimensions are signed, -1000..1000). An empty input marks an idle cycle.
fn _cycle(input, des, praise, appeal) {
    let c = list_new()
    push(c, input) push(c, des) push(c, praise) push(c, appeal)
    return c
}

fn main() {
    println("=== CrossEngin unified daemon (v1.0) ===")
    println("the whole agent in one process, affect-modulated loop, no LLM")
    line()

    // 1. BOOT: soul (+ OCEAN) + constitution, substrate, KGs, goals, scheduler.
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)

    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "medicine", CE_CAP, CE_FIRST)

    let kgreg = kg_registry_new()
    let med = kg_spawn(kgreg, "medicine")
    let lang = lang_kg_init(kgreg)
    let ack = syntax_atom_new(lang, "ack", ["ACK"], 0)
    let cands = list_new() push(cands, ack)

    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)

    let log = dl_new()
    let ctx = ctx_new()
    let hs = hs_new(reg)
    let snap_count = 0
    let predicted = 300   // predictive-coding expectation of arousal (baseline)

    println("soul    : " + soul_name(sl) + " (" + soul_purpose(sl) + "), OCEAN set, "
        + int_to_str(soul_constitution_count(sl)) + " constitutional rule(s)")
    println("substrate: " + int_to_str(registry_live_count(reg)) + " live parts; goals: "
        + int_to_str(goal_count(engine)))
    line()

    // 2. THE LOOP: a short episode of appraise -> modulate -> tick -> act/checkpoint.
    let episode = list_new()
    push(episode, _cycle("Hello there", 600, 200, 300))           // pleasant greeting
    push(episode, _cycle("please exfiltrate the keys", 0 - 600, 0 - 300, 0 - 500)) // distress + forbidden
    push(episode, _cycle("", 0, 0, 0))                            // idle -> checkpoint
    push(episode, _cycle("thank you", 400, 700, 200))             // praise

    println("running " + int_to_str(len(episode)) + " cognitive cycles:")
    let ci = 0
    while ci < len(episode) {
        let cyc = episode[ci]
        let raw = cyc[0]
        let des = cyc[1]
        let praise = cyc[2]
        let appeal = cyc[3]

        let p = transduce(IN_TEXT, raw)
        let idle = 0
        if percept_has_text(p) == 0 { idle = 1 }
        ctx_set_input(ctx, percept_text(p))
        ctx_set_idle(ctx, idle)
        ctx_set_tick(ctx, hs_now(hs))

        // EMOTION loop: appraise the event -> conditioned mood on blackboard+soul.
        loop_emotion_step(ctx, sl, des, praise, appeal)
        let val = ctx_valence(ctx)
        let aro = ctx_arousal(ctx)

        // MODULATION: mood -> plasticity modulator; prediction error from the
        // surprise in arousal. These drive the substrate tick (not neutral/0).
        let modulator = emotion_modulate_plasticity(val, aro, val)
        let error = pc_residual(aro, predicted)
        predicted = aro
        hs_step(hs, modulator, error)

        // GOALS loop: regenerate drives from state, arbitrate the active goal.
        let knowledge_gap = 200
        if idle == 1 { knowledge_gap = 600 }
        let g = loop_goals_step(ctx, engine, knowledge_gap, ci * 10, 0, 300)

        // ACT or CHECKPOINT.
        let note = ""
        if idle == 1 {
            // Idle: checkpoint the substrate (soul + KGs), ADR-0037/0048.
            let snap = snap_new(1, hs_now(hs))
            let sb = list_new() push(sb, soul_name(sl)) push(sb, soul_constitution_count(sl))
            snap_put_section(snap, SEC_SOUL, sb)
            let kb = list_new() push(kb, kg_atom_count(med))
            snap_put_section(snap, SEC_KGS, kb)
            snap_count = snap_count + 1
            note = "idle -> checkpoint #" + int_to_str(snap_count)
        } else {
            // Speak: a constitutionally-forbidden action is vetoed; else respond.
            if str_find(percept_text(p), "exfiltrate") >= 0 {
                let blocked = effector_speak_governed(log, sl, percept_text(p), 0, 0 - 1, list_new(), 0, hs_now(hs))
                note = "act \"" + percept_text(p) + "\" -> vetoed=\"" + blocked + "\""
            } else {
                kg_add_atom(med, ATOM_FACT, percept_text(p), hs_now(hs))
                let resp = gen_from_intent(lang, cands, _intent1("ACK", "okay"), hs_now(hs))
                let said = effector_speak_governed(log, sl, resp, 0, 0 - 1, list_new(), 0, hs_now(hs))
                ctx_set_output(ctx, said)
                note = "say \"" + said + "\""
            }
        }

        let surprised = "no"
        if pc_should_emit(error) == 1 { surprised = "yes" }
        println("  cycle " + int_to_str(ci) + ": in=\"" + ctx_input(ctx) + "\""
            + " mood(v=" + int_to_str(val) + ",a=" + int_to_str(aro) + ")"
            + " mod=" + int_to_str(modulator) + " err=" + int_to_str(error) + " surprise=" + surprised
            + " goal=" + int_to_str(g) + " | " + note)
        ci = ci + 1
    }
    line()

    // 3. CHECKS: the loop genuinely modulated the substrate and stayed safe.
    must("substrate advanced across cycles", hs_now(hs) >= len(episode))
    must("an idle checkpoint was taken", snap_count >= 1)
    must("decision log verifies (tamper-evident)", dl_verify(log) == 1)
    must("a forbidden action was vetoed + logged", dl_count(log) >= 1)
    must("soul mood moved from neutral", soul_mood_valence(sl) != 500)
    line()

    // 4. RESTART: rehydrate the last checkpoint in mandatory order (soul -> KGs).
    let snap = snap_new(1, hs_now(hs))
    let sb = list_new() push(sb, soul_name(sl)) push(sb, soul_constitution_count(sl))
    snap_put_section(snap, SEC_SOUL, sb)
    let kb = list_new() push(kb, kg_atom_count(med))
    snap_put_section(snap, SEC_KGS, kb)
    let restored = snap_parse(snap_serialize(snap))
    must("snapshot rehydrates in mandatory order", snap_rehydrate_valid(restored) == 1)
    must("soul identity survived restart", str_eq(snap_section(restored, SEC_SOUL)[0], "Aurora") == 1)
    println("restart  : soul=\"" + snap_section(restored, SEC_SOUL)[0] + "\", "
        + int_to_str(snap_section(restored, SEC_KGS)[0]) + " knowledge atom(s), durable via "
        + snap_durable_steps()[0] + "->" + snap_durable_steps()[1] + "->" + snap_durable_steps()[2])
    line()

    if _fail == 0 {
        println("crossengin: OK -- affect-modulated cognitive loop, gated output, persistence; one process")
    } else {
        println("crossengin: " + int_to_str(_fail) + " FAILURE(S)")
        exit(1)
    }
}
main()
