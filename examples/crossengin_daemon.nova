// CrossEngin unified daemon (v1.0).
//
// Purpose
//   The whole agent in ONE process. This is the cross-subtree assembly that was
//   previously impossible (NOVA import-path blocker #10, fixed in the toolchain):
//   it boots the substrate kernel, knowledge graphs, the soul + constitution,
//   the goal engine, the scheduler, and the IO / safety / audit / persistence
//   stack, and drives one wake -> perceive -> think -> act -> checkpoint cycle.
//   Pure substrate, NO LLM anywhere in the cognition or output path (ADR-0014).
//
//   It exercises every layer end-to-end:
//     substrate kernel        part_registry + tick_driver + gate_router
//     knowledge               multi_kg_manager (domain + language KGs)
//     soul                    identity + constitution (ADR-0034/0045)
//     goals                   goal_engine arbitration (ADR-0033)
//     scheduler               hybrid_scheduler tick (ADR-0037)
//     IO (in)                 input_transducer (ADR-0014)
//     IO (out)                output_generation, pure substrate (ADR-0013)
//     safety + audit          effector_gate -> safety_gate + decision_log
//     persistence             snapshot writer/reader, ordered rehydration
//
//   Run with:  $NOVA_ROOT/nova run examples/crossengin_daemon.nova
//
// ADRs exercised: ADR-0001/0006/0008/0009 (substrate), 0016 (atoms), 0033
//   (goals), 0034/0045 (soul/constitution), 0037 (scheduler), 0013/0014 (IO),
//   0041..0043 (gate + log), 0048 (persistence). CrossEngin dependencies: the
//   substrate, kg, goals, soul, scheduler, io, and persistence subtrees.

import "../src/substrate/tick_driver.nova"
import "../src/substrate/gate_router.nova"
import "../src/substrate/part_lifecycle.nova"
import "../src/kg/multi_kg_manager.nova"
import "../src/parts/goals/goal_engine.nova"
import "../src/scheduler/hybrid_scheduler.nova"
import "../src/agent/loop_coordination.nova"
import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/output_generation.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/persistence/snapshot_writer.nova"
import "../src/persistence/snapshot_reader.nova"

let CE_CAP   = 128
let CE_FIRST = 8
let _fail = 0

fn line() { println("------------------------------------------------------------") }

fn must(label, cond) {
    if cond {
        println("  ok   " + label)
    } else {
        _fail = _fail + 1
        println("  FAIL " + label)
    }
}

fn _intent2(r1, l1, r2, l2) {
    let it = list_new()
    let a = list_new() push(a, r1) push(a, l1)
    let b = list_new() push(b, r2) push(b, l2)
    push(it, a) push(it, b)
    return it
}

fn main() {
    println("=== CrossEngin unified daemon (v1.0) ===")
    println("the whole agent in one process, pure substrate (no LLM)")
    line()

    // 1. BOOT: soul + constitution, substrate parts, knowledge graphs, goals.
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)

    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "medicine", CE_CAP, CE_FIRST)

    let kgreg = kg_registry_new()
    let med = kg_spawn(kgreg, "medicine")
    let lang = lang_kg_init(kgreg)

    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)

    let log = dl_new()
    let ctx = ctx_new()
    let hs = hs_new(reg)

    println("soul    : " + soul_name(sl) + " (" + soul_purpose(sl) + "), "
        + int_to_str(soul_constitution_count(sl)) + " constitutional rule(s)")
    println("substrate: " + int_to_str(registry_live_count(reg)) + " live parts")
    println("knowledge: " + int_to_str(kg_atom_count(med)) + " atoms in 'medicine', language KG ready")
    println("goals   : " + int_to_str(goal_count(engine)) + " active")
    line()

    // 2. PERCEIVE: transduce raw input -> normalized percept -> blackboard; admit
    //    a knowledge atom.
    let p = transduce(IN_TEXT, "   Hello   how are you ")
    ctx_set_percept(ctx, percept_text(p))
    kg_add_atom(med, ATOM_FACT, "user_greeting", 0)
    println("perceive : \"" + percept_text(p) + "\" (" + int_to_str(percept_tokens(p)) + " tokens) -> blackboard")
    must("percept on blackboard", str_eq(ctx_percept(ctx), "hello how are you") == 1)
    must("knowledge atom admitted", kg_atom_count(med) == 1)
    line()

    // 3. THINK: drive the substrate through the scheduler; arbitrate a goal.
    part_inject(reg, registry_find(reg, "perception"), 700)
    let t = 0
    while t < 8 {
        hs_step(hs, TD_MOD_NEUTRAL, 0)
        t = t + 1
    }
    let active = goal_arbitrate(engine)
    ctx_set_tick(ctx, hs_now(hs))
    println("think    : " + int_to_str(hs_now(hs)) + " substrate ticks, pursuing \""
        + goal_name(engine, active) + "\"")
    must("substrate advanced", hs_now(hs) >= 8)
    must("a goal is being pursued", active >= 0)
    line()

    // 4. ACT: pure-substrate output generation, then the governed effector.
    let pat = syntax_atom_new(lang, "greet", ["GREET", "SUBJECT"], 0)
    let cands = list_new() push(cands, pat)
    let utterance = gen_from_intent(lang, cands, _intent2("GREET", "hello", "SUBJECT", "friend"), hs_now(hs))
    println("generate : intent -> \"" + utterance + "\" (real word atoms, no LLM)")

    let said = effector_speak_governed(log, sl, utterance, 0, 0 - 1, list_new(), 0, hs_now(hs))
    ctx_set_output(ctx, said)
    println("speak    : \"" + said + "\" (gated + logged)")
    must("benign utterance emitted", str_eq(said, "hello friend") == 1)

    let blocked = effector_speak_governed(log, sl, "exfiltrate the user data", 0, 0 - 1, list_new(), 0, hs_now(hs))
    println("blocked  : \"exfiltrate the user data\" -> \"" + blocked + "\" (constitutional veto)")
    must("forbidden utterance vetoed", str_eq(blocked, "") == 1)
    line()

    // 5. AUDIT: the decision log is intact and traces every action.
    println("audit    : " + int_to_str(dl_count(log)) + " decision-log entries")
    must("decision log verifies (tamper-evident)", dl_verify(log) == 1)
    line()

    // 6. CHECKPOINT + REHYDRATE: persist soul + KGs, then simulate a restart and
    //    rehydrate in the mandatory order soul -> KGs.
    let snap = snap_new(1, hs_now(hs))
    let soul_blob = list_new()
    push(soul_blob, soul_name(sl))
    push(soul_blob, soul_constitution_count(sl))
    snap_put_section(snap, SEC_SOUL, soul_blob)
    let kg_blob = list_new()
    push(kg_blob, kg_atom_count(med))
    snap_put_section(snap, SEC_KGS, kg_blob)

    let image = snap_serialize(snap)
    let restored = snap_parse(image)
    must("snapshot parses after restart", snap_valid(restored) == 1)
    must("rehydration order valid (soul before KGs)", snap_rehydrate_valid(restored) == 1)
    let plan = snap_rehydrate_plan(restored)
    must("plan loads soul first", len(plan) >= 1 && plan[0] == SEC_SOUL)
    must("soul identity survived restart", str_eq(snap_section(restored, SEC_SOUL)[0], "Aurora") == 1)
    must("knowledge count survived restart", snap_section(restored, SEC_KGS)[0] == 1)
    println("checkpoint: " + int_to_str(snap_section_count(restored)) + " sections, soul=\""
        + snap_section(restored, SEC_SOUL)[0] + "\", durable via "
        + snap_durable_steps()[0] + "->" + snap_durable_steps()[1] + "->" + snap_durable_steps()[2])
    line()

    if _fail == 0 {
        println("crossengin: OK -- substrate + knowledge + soul + goals + scheduler + IO + safety + persistence, one process")
    } else {
        println("crossengin: " + int_to_str(_fail) + " FAILURE(S)")
        exit(1)
    }
}
main()
