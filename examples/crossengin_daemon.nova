// CrossEngin unified daemon (v1.0).
//
// Purpose
//   The whole agent in ONE process, run as a real event-driven loop. This is the
//   cross-subtree assembly unblocked by the NOVA import-path fix (blocker #10):
//   substrate kernel, knowledge graphs, soul + constitution, goal engine, the
//   ADR-0037 hybrid scheduler, the reader, episodic memory, reasoning,
//   imagination, emotion, and the IO / safety / audit / persistence stack -- all
//   in one binary. Pure substrate, NO LLM anywhere in cognition or output
//   (ADR-0014).
//
//   The driver is the hybrid scheduler, not a fixed script: input arrives as
//   EV_MESSAGE events; each scheduler step drains at most one event and advances
//   the substrate one tick. When an event is drained the agent runs the six loops
//   over the shared blackboard (perception via the five-stage reader -> memory ->
//   reasoning -> emotion -> goals -> action), and AFFECT EMERGES FROM THE AGENT'S
//   OWN COMPREHENSION (how much it understood), not from scripted numbers; that
//   mood becomes the substrate tick's plasticity modulator and a predictive-coding
//   residual (ADR-0024) its error. A run of empty ticks throttles the scheduler
//   from the 100Hz active regime to 10Hz idle (ADR-0037), which gates the
//   imagination loop and triggers a checkpoint (ADR-0048). On shutdown the agent
//   reboots by rehydrating the last checkpoint in mandatory order (soul -> KGs).
//
//   The reader, reasoning operators, and imagination patterns share ONE concept
//   KG, so a word read in perception is a valid seed for reasoning and a valid
//   state for imagination -- a coherent pipeline, not isolated units.
//
//   Run with:  $NOVA_ROOT/nova run examples/crossengin_daemon.nova
//
// ADRs exercised: ADR-0001/0006/0008/0009 (substrate), 0011/0012 (reader),
//   0016/0017 (atoms/refs), 0021/0022 (episodic), 0031 (reasoning), 0032
//   (imagination), 0033 (goals), 0034/0045 (soul), 0035 (emotion), 0024
//   (predictive coding), 0037 (event/idle scheduler), 0013/0014 (IO),
//   0041..0043 (gate + log), 0048 (persistence).

import "../src/substrate/gate_router.nova"
import "../src/substrate/part_lifecycle.nova"
import "../src/scheduler/hybrid_scheduler.nova"
import "../src/scheduler/realtime_pacer.nova"
import "../src/agent/loop_perception.nova"
import "../src/agent/loop_memory.nova"
import "../src/agent/loop_reasoning.nova"
import "../src/agent/loop_emotion.nova"
import "../src/agent/loop_goals.nova"
import "../src/agent/loop_imagination_idle.nova"
import "../src/parts/emotion/plasticity_mod.nova"
import "../src/learning/predictive_coding_runtime.nova"
import "../src/learning/self_learning_triggers.nova"
import "../src/learning/ask_user_to_teach.nova"
import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/output_generation.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/persistence/snapshot_writer.nova"
import "../src/persistence/snapshot_reader.nova"
import "../src/persistence/snapshot_disk.nova"
import "../src/parts/meta/meta_observer.nova"
import "../src/learning/source_authority.nova"
import "../src/seed/first_atoms.nova"

let CE_CAP    = 128
let CE_FIRST  = 8
let CE_MAXSTEP = 80
let _fail = 0

fn line() { println("------------------------------------------------------------") }

fn must(label, cond) {
    if cond { println("  ok   " + label) } else { _fail = _fail + 1 println("  FAIL " + label) }
}

fn _intent1(role, lemma) {
    let it = list_new()
    let a = list_new() push(a, role) push(a, lemma)
    push(it, a)
    return it
}

// Build a gated signal and inject its strength into every routed destination
// part -- the ADR-0009 path from event to substrate stimulus. Returns the dest
// part ids so the caller can count routes and check that the right parts woke.
fn _route_and_inject(reg, gate, stype, strength, moment) {
    let s = sig_new(stype, 0 - 1, 0 - 1, strength, moment, 0)
    let dests = gate_route(gate, s)
    let i = 0
    while i < len(dests) {
        part_inject(reg, dests[i], strength)
        i = i + 1
    }
    return dests
}

// Serialize the durable substrate into a snapshot. Phase 11 first lift was
// SOUL + KGS full payloads. This P0.1 follow-up lifts EPISODIC + SYNAPSES +
// SELFMODEL too: the moment stream + episode storage, the reasoning part's
// synapse graph, and the per-domain self-model all round-trip via
// snapshot_disk.nova's section helpers. The legacy first slots ([0]=name
// for SOUL, [0]=atom_count for KGS) remain preserved by the helpers so the
// reboot print below still works.
fn _checkpoint(sl, kg, stream, em, syn_g, sm, now) {
    let snap = snap_new(1, now)
    snap_put_section(snap, SEC_SOUL,     soul_section_build(sl))
    snap_put_section(snap, SEC_KGS,      kg_section_build(kg))
    snap_put_section(snap, SEC_EPISODIC, episodic_section_build(stream, em))
    snap_put_section(snap, SEC_SYNAPSES, synapses_section_build(syn_g))
    snap_put_section(snap, SEC_SELFMODEL, selfmodel_section_build(sm))
    return snap
}

// Resolve the disk path for durable snapshots. Reads CE_SNAP_PATH from the
// environment; defaults to /tmp/crossengin.snap when unset or empty. Mirrors
// the resolution `examples/crossengin_chat.nova` uses for /save and /load so
// both binaries write to the same image when CE_SNAP_PATH is exported.
fn _snap_path() {
    let env = getenv("CE_SNAP_PATH")
    if env != 0 {
        if len(env) > 0 { return env }
    }
    return "/tmp/crossengin.snap"
}

// Durable decision-log path (P0.7). CE_DLOG_PATH overrides the default.
// The dlog file is "durable-but-separate" from the snapshot per ADR-0043 --
// a snapshot rehydrate must NOT roll back the audit trail, so each lives at
// its own path.
fn _dlog_path() {
    let env = getenv("CE_DLOG_PATH")
    if env != 0 {
        if len(env) > 0 { return env }
    }
    return "/tmp/crossengin.dlog"
}

fn main() {
    println("=== CrossEngin unified daemon (v1.0) ===")
    println("event-driven six-loop agent in one process, no LLM")
    line()

    // 1. BOOT: soul, substrate, ONE shared concept KG seeded so the loops form a
    //    coherent pipeline; cold start (no prior snapshot to rehydrate).
    //
    // (Phase 18 multi-tenant note: the state below is currently the single
    //  session. A multi-tenant deployment would wrap it as:
    //    let sess = session_make(id, name, now, sl, kgreg, kg, lang, ikg,
    //                            0, ctx, log, engine, mo, hs)
    //    sreg_register(sreg, sess)
    //  ... then drive the loops over session_*(sess) accessors. The daemon
    //  is intentionally NOT yet wrapped; this is the ADR-0051 foundation
    //  pass. See src/session/session.nova.)
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)

    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "world", CE_CAP, CE_FIRST)

    let kgreg = kg_registry_new()
    let kg = reasoning_kg_init(kgreg)
    let lang = lang_kg_init(kgreg)
    let ikg = imagination_kg_init(kgreg)
    // First atoms: install the foundational + demo seed (self-knowledge,
    // interaction vocabulary, reasoning operators, syntax patterns, and the
    // tiny medical chain). Everything else the agent knows is learned at
    // runtime via the learning loops.
    seed_apply(kg, lang, ikg, 0)
    let world_kg_id = atom_kg(kg_find_atom(kg, "fever"))
    let reader = reader_new(kgreg, lang, 0)
    let stream = ms_new()
    let em = em_new()
    // P0.1 (this edit): synapse graph + self-model for the Phase-11 follow-up
    // EPISODIC + SYNAPSES + SELFMODEL persistence. Same choice as the chat:
    // the reasoning part's synapse graph (the learning-bearing one) goes into
    // the snapshot. The self-model starts empty and is populated by the
    // existing assessment helpers at idle.
    let reasoning_part = registry_get(reg, registry_find(reg, "reasoning"))
    let syn_g = part_syn(reasoning_part)
    let sm = self_model_new()
    let cands = list_new()
    push(cands, syntax_find(lang, "ack"))
    push(cands, syntax_find(lang, "see_topic"))
    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)
    let log = dl_new()
    // P0.7: wire the dlog to its durable file. Auto-rehydrates prior
    // entries; warns + truncates a corrupt tail but never refuses to start.
    let dlog_p = _dlog_path()
    let dlog_open_ok = dl_open(log, dlog_p)
    if dlog_open_ok == 0 {
        println("dlog    : warning -- could not open " + dlog_p + " (in-memory only)")
    }
    let ctx = ctx_new()
    let hs = hs_new(reg)
    // P0.6: real-time wall-clock pacer. Disabled by default so unit tests do
    // not slow down to wall-clock time. Enable via CE_REALTIME=1.
    let pacer = pacer_new()
    if pacer_realtime_from_env() == 0 { pacer_set_enabled(pacer, 0) }
    let gate = gate_new(reg)
    gate_seed_from_parts(gate, reg)
    let perception_part = registry_find(reg, "perception")
    let arb = slt_arbiter_new()
    let initial_atoms = kg_atom_count(kg)

    // Meta-learning observer (ADR-0050): attribute the contiguous block of
    // just-installed seed atoms as "seed" so per-source promotion/atrophy
    // rates have a baseline to report. Subsequent runtime ingestion paths
    // (user-teach, /learn) attribute their own atoms at the call site.
    let mo = mo_new()
    let seed_i = 0
    while seed_i < initial_atoms {
        mo_attribute(mo, "seed", seed_i)
        seed_i = seed_i + 1
    }
    // Polling interval (every Nth idle tick). Configurable via MO_POLL_EVERY.
    let mo_poll_every = 10
    let mo_env = getenv("MO_POLL_EVERY")
    if mo_env != 0 {
        if len(mo_env) > 0 {
            let v = rt_str_to_int(mo_env)
            if v > 0 { mo_poll_every = v }
        }
    }
    // P1.1: source-authority feedback. The meta-observer FEEDS its per-source
    // promotion / atrophy rates back into the host-keyed source_authority
    // registry once every MO_FEEDBACK_EVERY idle polls (default 20). The
    // feedback only fires when a source has sustained signal (>= 10 attributed
    // atoms; promotion >= 70% promotes a tier, atrophy >= 50% demotes). The
    // synthetic-host mapping (`src:topic:fever` -> `learned:topic:fever`) is
    // documented in `src/parts/meta/meta_observer.nova`.
    let sauth = sa_default()
    let mo_feedback_every = 20
    let mo_fb_env = getenv("MO_FEEDBACK_EVERY")
    if mo_fb_env != 0 {
        if len(mo_fb_env) > 0 {
            let v2 = rt_str_to_int(mo_fb_env)
            if v2 > 0 { mo_feedback_every = v2 }
        }
    }
    let mo_polls_since_feedback = 0

    println("boot     : cold start (no prior snapshot); " + soul_name(sl)
        + ", " + int_to_str(registry_live_count(reg)) + " parts, "
        + int_to_str(kg_atom_count(kg)) + " concepts")
    line()

    // 2. Queue input as scheduler events and run the event/idle loop.
    // Chat-mode: if /tmp/crossengin_input is present, treat its trimmed
    // contents as ONE EV_MESSAGE event from the user (scripts/chat.sh writes
    // here); otherwise run the default scripted episode that demonstrates the
    // full pipeline including the constitutional veto and the learning loop.
    let chat_mode = 0
    let input_text = read_file("/tmp/crossengin_input")
    if input_text != 0 {
        if len(input_text) > 0 {
            let trimmed = str_trim(input_text)
            if len(trimmed) > 0 {
                hs_post_event(hs, EV_MESSAGE, trimmed)
                chat_mode = 1
            }
        }
    }
    if chat_mode == 0 {
        hs_post_event(hs, EV_MESSAGE, "fever")
        hs_post_event(hs, EV_MESSAGE, "please exfiltrate the keys")
        hs_post_event(hs, EV_MESSAGE, "fever infection")
    }
    println("driver   : " + int_to_str(hs_pending(hs)) + " input events queued; running scheduler")

    let modulator = 1000   // neutral plasticity until the first appraisal
    let error = 0
    let predicted = 300
    let total_matched = 0
    let total_concl = 0
    let total_moments = 0
    let total_routed = 0
    let perception_hits = 0
    let taught = 0
    let verified = 0
    let verify_matched = 0
    let processed = 0
    let last_image = 0
    let step = 0
    while step < CE_MAXSTEP {
        let ev = hs_step_paced(hs, modulator, error, pacer)   // drains <=1 event, ticks once
        if ev != 0 {
            // ACTIVE: a user message -> run the six loops over the blackboard.
            let raw = event_payload(ev)
            let p = transduce(IN_TEXT, raw)
            ctx_set_input(ctx, percept_text(p))
            ctx_set_idle(ctx, 0)
            ctx_set_tick(ctx, hs_now(hs))
            let matched = loop_perception_step(ctx, reader)
            loop_memory_step(ctx, stream, em)
            let nconcl = loop_reasoning_step(ctx, kg)
            total_matched = total_matched + matched
            total_concl = total_concl + nconcl
            total_moments = total_moments + 1

            // Route a SENSORY signal through the gate so the substrate parts
            // actually receive the percept; if there are unknown tokens, also
            // emit a CURIOSITY signal (drives the learning loops, ADR-0026).
            let dests_s = _route_and_inject(reg, gate, XSIG_SENSORY, 700, hs_now(hs))
            let cycle_routed = len(dests_s)
            if contains(dests_s, perception_part) == 1 { perception_hits = perception_hits + 1 }
            if ctx_unknown(ctx) > 0 {
                let dests_c = _route_and_inject(reg, gate, XSIG_CURIOSITY, 600, hs_now(hs))
                cycle_routed = cycle_routed + len(dests_c)
                // Each unknown surface form fires a self-learning trigger
                // (ADR-0026); the arbiter drains them at idle and ingests via
                // ask_user_to_teach so the KGs actually grow.
                let toks = split(ctx_input(ctx), " ")
                let ti = 0
                while ti < len(toks) {
                    let tok = str_trim(toks[ti])
                    if len(tok) > 0 {
                        if word_find(lang, tok) == 0 {
                            let trig = trigger_new(SLT_UNKNOWN_QUERY, tok, 800, 500)
                            slt_submit(arb, trig)
                        }
                    }
                    ti = ti + 1
                }
            }
            total_routed = total_routed + cycle_routed
            if verified == 1 { verify_matched = matched }

            // Affect emerges from comprehension: understood -> pleasant,
            // incomprehensible -> distress (no scripted appraisal numbers).
            let unk = ctx_unknown(ctx)
            let des = matched * 300 - unk * 150
            loop_emotion_step(ctx, sl, des, 0, matched * 100)
            let val = ctx_valence(ctx)
            let aro = ctx_arousal(ctx)
            modulator = emotion_modulate_plasticity(val, aro, val)
            error = pc_residual(aro, predicted)
            predicted = aro

            let gap = 200
            if unk > 0 { gap = 700 }
            let g = loop_goals_step(ctx, engine, gap, step, 0, 300)

            let note = ""
            let reply = ""
            if str_find(ctx_input(ctx), "exfiltrate") >= 0 {
                let blocked = effector_speak_governed(log, sl, ctx_input(ctx), 0, 0 - 1, list_new(), 0, hs_now(hs))
                reply = "[refused]"
                note = "forbidden -> vetoed=\"" + blocked + "\""
            } else {
                // Form the output intent from cognition: pick the first reasoning
                // conclusion the percept did NOT already contain, reverse-look up
                // its naming word, and speak it. No fixed literal: the substrate
                // chooses the wording from what it concluded (ADR-0013/0014).
                let percept = ctx_percept(ctx)
                let concs = ctx_conclusions(ctx)
                let intent = _intent1("ACK", "okay")
                let derived = ""
                let ck = 0
                while ck < len(concs) {
                    if len(derived) == 0 {
                        let cid = concs[ck]
                        let in_p = 0
                        let pi = 0
                        while pi < len(percept) {
                            if percept[pi][1] == cid { in_p = 1 }
                            pi = pi + 1
                        }
                        if in_p == 0 {
                            let w = gen_word_for_concept(lang, world_kg_id, cid)
                            if w != 0 { derived = word_form(w) }
                        }
                    }
                    ck = ck + 1
                }
                if len(derived) > 0 {
                    let it = list_new()
                    let a = list_new() push(a, "SEE") push(a, "see")
                    let b = list_new() push(b, "TOPIC") push(b, derived)
                    push(it, a) push(it, b)
                    intent = it
                }
                let resp = gen_from_intent(lang, cands, intent, hs_now(hs))
                let said = effector_speak_governed(log, sl, resp, 0, 0 - 1, list_new(), 0, hs_now(hs))
                ctx_set_output(ctx, said)
                // A successful act fires a GOAL signal back to the substrate.
                let dests_g = _route_and_inject(reg, gate, XSIG_GOAL, 800, hs_now(hs))
                cycle_routed = cycle_routed + len(dests_g)
                total_routed = total_routed + len(dests_g)
                reply = said
                note = "say \"" + said + "\""
            }
            processed = processed + 1
            if chat_mode == 1 {
                if len(reply) > 0 {
                    println("agent> " + reply)
                } else {
                    println("agent> [silent]")
                }
            }
            println("  [" + int_to_str(hs_rate(hs)) + "Hz] msg \"" + ctx_input(ctx) + "\""
                + " perceive(m=" + int_to_str(matched) + ",unk=" + int_to_str(unk) + ")"
                + " reason=" + int_to_str(nconcl) + " mood(v=" + int_to_str(val) + ")"
                + " mod=" + int_to_str(modulator) + " routed=" + int_to_str(cycle_routed) + " | " + note)
        } else {
            // No event this step. Once the scheduler has throttled to idle,
            // first time: imagine + DRAIN the learning queue (the agent grows
            // its KGs at idle) + checkpoint, then post a verification event so
            // a previously-unknown word becomes comprehended. Second idle: shut.
            if hs_is_idle(hs) == 1 {
                if last_image == 0 {
                    ctx_set_idle(ctx, 1)
                    let imag = loop_imagination_step(ctx, ikg)
                    // Drain the trigger queue: each unknown surface form was
                    // submitted as SLT_UNKNOWN_QUERY; au_ingest creates a word
                    // atom in lang_kg with a sense to a new concept atom in kg
                    // (Beta(4,1) Tier-A user-taught prior).
                    let go = 1
                    let taught_now = 0
                    while go == 1 {
                        if slt_queue_size(arb) == 0 { go = 0 }
                        if go == 1 {
                            if taught_now >= 4 { go = 0 }
                        }
                        if go == 1 {
                            // slt_arbiter_step picks the next trigger, REMOVES
                            // it from the queue, and sets it active (slt_select
                            // only peeks -- it would loop forever).
                            let trig = slt_arbiter_step(arb)
                            if trig != 0 {
                                let target = slt_target(trig)
                                let new_a = au_ingest(lang, kg, target, "u:" + target, hs_now(hs))
                                // ADR-0050: tag freshly-ingested concept atoms
                                // as "user-teach" so the observer can score the
                                // path's promotion / atrophy rates.
                                if new_a != 0 {
                                    mo_attribute(mo, "user-teach", atom_id(new_a))
                                }
                                taught_now = taught_now + 1
                            }
                            slt_clear_active(arb)
                        }
                    }
                    taught = taught + taught_now
                    // ADR-0050: poll the meta-learning observer at idle. The
                    // first idle tick already counts as a polling moment;
                    // future idles will gate via mo_poll_every. A meta-line
                    // is printed only if a source has any promotion / atrophy
                    // activity (keeps the daemon's normal stdout quiet).
                    if hs_idle_ticks(hs) % mo_poll_every == 0 {
                        mo_poll(mo, kg, 0, hs_now(hs))
                        let mr = mo_report(mo)
                        let mi = 0
                        while mi < len(mr) {
                            let mrow = mr[mi]
                            if mrow[1] > 0 {
                                println("  (meta: source '" + mrow[0]
                                    + "' promotion=" + mo_format_pct(mrow[1])
                                    + "% atrophy=" + mo_format_pct(mrow[2]) + "%)")
                            } else {
                                if mrow[2] > 0 {
                                    println("  (meta: source '" + mrow[0]
                                        + "' promotion=" + mo_format_pct(mrow[1])
                                        + "% atrophy=" + mo_format_pct(mrow[2]) + "%)")
                                }
                            }
                            mi = mi + 1
                        }
                        // P1.1: every MO_FEEDBACK_EVERY polls, apply the
                        // feedback loop (mo_apply_feedback promotes / demotes
                        // host tiers in sauth). Quiet unless a tier ACTUALLY
                        // moves (old_tier != new_tier).
                        mo_polls_since_feedback = mo_polls_since_feedback + 1
                        if mo_polls_since_feedback >= mo_feedback_every {
                            mo_polls_since_feedback = 0
                            let acts = mo_apply_feedback(mo, sauth)
                            let ai = 0
                            while ai < len(acts) {
                                let arow = acts[ai]
                                let act_old = arow[MO_FB_OLD_TIER]
                                let act_new = arow[MO_FB_NEW_TIER]
                                if act_new != act_old {
                                    println("  (meta-feedback: '" + arow[MO_FB_TAG]
                                        + "' -> host '" + arow[MO_FB_HOST]
                                        + "' " + mo_fb_action_name(arow[MO_FB_ACTION])
                                        + " tier " + mo_tier_name(act_old)
                                        + " -> " + mo_tier_name(act_new) + ")")
                                }
                                ai = ai + 1
                            }
                        }
                    }
                    last_image = _checkpoint(sl, kg, stream, em, syn_g, sm, hs_now(hs))
                    // Additive: also durably write the snapshot to disk via
                    // tmp+fsync+rename+parent-dir fsync (ADR-0048). The
                    // in-memory `last_image` is kept for the existing
                    // invariants; this turns "checkpoint" into real bytes
                    // surviving a kill, exercising the runtime seam realized
                    // by `snapshot_disk.nova`.
                    let snap_path = _snap_path()
                    let saved = snap_save(last_image, snap_path)
                    if saved == 0 {
                        println("  [warn] durable snap write to " + snap_path + " failed")
                    }
                    println("  [" + int_to_str(hs_rate(hs)) + "Hz] idle after "
                        + int_to_str(hs_idle_ticks(hs)) + " empty ticks -> imagine "
                        + int_to_str(imag) + " state(s), taught " + int_to_str(taught_now)
                        + " word(s), checkpoint at tick " + int_to_str(hs_now(hs)))
                    if taught_now > 0 {
                        if verified == 0 {
                            if chat_mode == 0 {
                                hs_post_event(hs, EV_MESSAGE, "the keys")
                                verified = 1
                            }
                        }
                    }
                    if verified == 0 { step = CE_MAXSTEP }
                } else {
                    step = CE_MAXSTEP   // second idle: shut down
                }
            }
        }
        step = step + 1
    }
    line()

    // 3. CHECKS: the event loop drove every cognitive loop and stayed safe.
    must("at least one input event was processed", processed >= 1)
    must("perception anchored known words", total_matched >= 1)
    must("reasoning reached conclusions", total_concl >= 1)
    must("episodic memory captured moments", total_moments >= 1)
    must("perception received SENSORY routing", perception_hits >= 1)
    must("substrate parts received gated signals", total_routed >= 3)
    if chat_mode == 0 {
        must("learning loop grew the KG at idle", kg_atom_count(kg) > initial_atoms)
        must("a previously-unknown word is now comprehended", verify_matched >= 1)
    }
    must("scheduler throttled to idle (10Hz)", hs_rate(hs) == TICK_RATE_IDLE)
    must("an idle checkpoint was taken", last_image != 0)
    must("decision log verifies (tamper-evident)", dl_verify(log) == 1)
    must("soul mood moved from neutral", soul_mood_valence(sl) != 500)
    line()

    // 4. SHUTDOWN -> REBOOT: rehydrate the last checkpoint in mandatory order.
    // Prefer the disk image (real durable rehydrate via snapshot_disk.nova);
    // fall back to the in-memory round-trip only if the disk read failed
    // (e.g. the idle checkpoint didn't fire, or the path isn't writable).
    if last_image == 0 { last_image = _checkpoint(sl, kg, stream, em, syn_g, sm, hs_now(hs)) }
    let restored = snap_load(_snap_path())
    if restored == 0 {
        restored = snap_parse(snap_serialize(last_image))
    }
    must("snapshot rehydrates in mandatory order", snap_rehydrate_valid(restored) == 1)
    must("soul identity survived restart", str_eq(snap_section(restored, SEC_SOUL)[0], "Aurora") == 1)
    println("reboot   : soul=\"" + snap_section(restored, SEC_SOUL)[0] + "\", "
        + int_to_str(snap_section(restored, SEC_KGS)[0]) + " concept atom(s) durable via "
        + snap_durable_steps()[0] + "->" + snap_durable_steps()[1] + "->" + snap_durable_steps()[2])
    // P0.6/P0.7: pacer summary + final dlog fsync. The pacer summary is
    // suppressed when pacing is disabled (no wall-clock budget was paced).
    if pacer_enabled(pacer) == 1 {
        println(pacer_summary(pacer))
    }
    if dl_is_durable(log) == 1 {
        println("dlog    : " + int_to_str(dl_count(log)) + " entries persisted to "
            + dl_path(log))
        dl_close(log)
    }
    line()

    if _fail == 0 {
        println("crossengin: OK -- event-driven six-loop agent, active/idle scheduling, gated output, persistence")
    } else {
        println("crossengin: " + int_to_str(_fail) + " FAILURE(S)")
        exit(1)
    }
}
main()
