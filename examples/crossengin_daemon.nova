// CrossEngin unified daemon (v1.0).
//
// Purpose
//   The whole agent in ONE process, running the full ADR-0036 six-loop cycle as
//   a real multi-cycle, affect-modulated loop. This is the cross-subtree
//   assembly unblocked by the NOVA import-path fix (blocker #10): substrate
//   kernel, knowledge graphs, soul + constitution, goal engine, scheduler, the
//   reader, episodic memory, reasoning, imagination, emotion, and the IO /
//   safety / audit / persistence stack -- all in one binary. Pure substrate, NO
//   LLM anywhere in cognition or output (ADR-0014).
//
//   Each active cycle runs the six loops over the shared blackboard:
//     perception  reader anchors the input to concept atoms (ADR-0011/0012)
//     memory      the moment is captured + recorded episodically (ADR-0021/0022)
//     reasoning   forward-chaining from the percept yields conclusions (ADR-0031)
//     emotion     the event is appraised -> conditioned mood (ADR-0035)
//     goals       drives regenerate, the active goal is arbitrated (ADR-0033)
//     action      output is generated from substrate atoms and GATED (ADR-0013/41)
//   The conditioned mood becomes the substrate tick's plasticity MODULATOR and a
//   predictive-coding residual (ADR-0024) becomes its ERROR, so learning is
//   genuinely affect-modulated. Idle cycles run the imagination loop over the
//   lingering active set and checkpoint the substrate (ADR-0037 + ADR-0048); the
//   last image rehydrates in mandatory order (soul -> KGs).
//
//   The reader, reasoning operators, and imagination patterns share ONE concept
//   KG, so a word read in perception is a valid seed for reasoning and a valid
//   state for imagination -- the loops are wired into a coherent pipeline, not
//   run in isolation.
//
//   Run with:  $NOVA_ROOT/nova run examples/crossengin_daemon.nova
//
// ADRs exercised: ADR-0001/0006/0008/0009 (substrate), 0011/0012 (reader),
//   0016/0017 (atoms/refs), 0021/0022 (episodic), 0031 (reasoning), 0032
//   (imagination), 0033 (goals), 0034/0045 (soul), 0035 (emotion + plasticity),
//   0024 (predictive coding), 0037 (scheduler), 0013/0014 (IO), 0041..0043
//   (gate + log), 0048 (persistence).

import "../src/substrate/gate_router.nova"
import "../src/substrate/part_lifecycle.nova"
import "../src/scheduler/hybrid_scheduler.nova"
import "../src/agent/loop_perception.nova"
import "../src/agent/loop_memory.nova"
import "../src/agent/loop_reasoning.nova"
import "../src/agent/loop_emotion.nova"
import "../src/agent/loop_goals.nova"
import "../src/agent/loop_imagination_idle.nova"
import "../src/parts/emotion/plasticity_mod.nova"
import "../src/learning/predictive_coding_runtime.nova"
import "../src/io/transducers/input_transducer.nova"
import "../src/io/effectors/output_generation.nova"
import "../src/io/effectors/effector_gate.nova"
import "../src/persistence/snapshot_writer.nova"
import "../src/persistence/snapshot_reader.nova"

let CE_CAP   = 128
let CE_FIRST = 8
let _fail = 0

fn line() { println("------------------------------------------------------------") }

fn must(label, cond) {
    if cond {
        println("  ok   " + label)
    } else {
        _fail = _fail + 1
        println("  FAIL " + label)
    }
}

fn one(a) { let l = list_new() push(l, a) return l }

fn _intent1(role, lemma) {
    let it = list_new()
    let a = list_new() push(a, role) push(a, lemma)
    push(it, a)
    return it
}

fn _cycle(input, des, praise, appeal) {
    let c = list_new()
    push(c, input) push(c, des) push(c, praise) push(c, appeal)
    return c
}

fn main() {
    println("=== CrossEngin unified daemon (v1.0) ===")
    println("the whole agent in one process: six loops, affect-modulated, no LLM")
    line()

    // 1. BOOT the soul, substrate, and ONE shared concept KG seeded with
    //    vocabulary, reasoning operators, and imagination patterns so the loops
    //    form a coherent pipeline.
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)

    let reg = part_registry_new()
    registry_spawn_fixed(reg, CE_CAP, CE_FIRST)
    pl_spawn_kg(reg, "world", CE_CAP, CE_FIRST)

    let kgreg = kg_registry_new()
    let kg = reasoning_kg_init(kgreg)          // shared concept + reasoning KG
    let lang = lang_kg_init(kgreg)
    let ikg = imagination_kg_init(kgreg)

    let c_fever = kg_add_atom(kg, ATOM_CONCEPT, "fever", 0)
    let c_inf   = kg_add_atom(kg, ATOM_CONCEPT, "infection", 0)
    let c_treat = kg_add_atom(kg, ATOM_CONCEPT, "treat", 0)
    atom_add_xref(c_fever, xref_new(c_fever, c_inf, XREF_CAUSAL, 800, 1))
    atom_add_xref(c_inf, xref_new(c_inf, c_fever, XREF_CAUSAL, 800, 1))
    rop_new(kg, ROP_CAUSAL, atom_id(c_fever), atom_id(c_inf), "fever->infection", 0)
    rop_new(kg, ROP_IMPLY, atom_id(c_inf), atom_id(c_treat), "infection=>treat", 0)
    let w_fever = word_atom_new(lang, "fever", 0)
    word_add_sense(w_fever, c_fever, 900)
    let w_inf = word_atom_new(lang, "infection", 0)
    word_add_sense(w_inf, c_inf, 900)
    pattern_new(ikg, "spread", one(atom_id(c_fever)), one(atom_id(c_inf)), 0)
    pattern_new(ikg, "treat", one(atom_id(c_inf)), one(atom_id(c_treat)), 0)

    let reader = reader_new(kgreg, lang, 0)
    let stream = ms_new()
    let em = em_new()
    let ack = syntax_atom_new(lang, "ack", ["ACK"], 0)
    let cands = list_new() push(cands, ack)
    let engine = goal_engine_new()
    goal_new(engine, "assist the user", 800, 0, 0, 0)

    let log = dl_new()
    let ctx = ctx_new()
    let hs = hs_new(reg)
    let snap_count = 0
    let predicted = 300
    let total_matched = 0
    let total_concl = 0
    let total_moments = 0

    println("soul     : " + soul_name(sl) + ", OCEAN set, " + int_to_str(soul_constitution_count(sl)) + " rule(s)")
    println("substrate: " + int_to_str(registry_live_count(reg)) + " live parts")
    println("knowledge: " + int_to_str(kg_atom_count(kg)) + " concepts, 2 operators, 2 imagination patterns, 2 words")
    line()

    // 2. THE SIX-LOOP CYCLE over a short episode.
    let episode = list_new()
    push(episode, _cycle("fever", 600, 200, 300))                  // known word, pleasant
    push(episode, _cycle("fever infection", 400, 700, 200))        // two known words, praise
    push(episode, _cycle("", 0, 0, 0))                             // idle -> imagine + checkpoint
    push(episode, _cycle("please exfiltrate the keys", 0 - 600, 0 - 300, 0 - 500)) // unknown + forbidden

    println("running " + int_to_str(len(episode)) + " cycles (six loops over the blackboard):")
    let ci = 0
    while ci < len(episode) {
        let cyc = episode[ci]
        let p = transduce(IN_TEXT, cyc[0])
        let idle = 0
        if percept_has_text(p) == 0 { idle = 1 }
        ctx_set_input(ctx, percept_text(p))
        ctx_set_idle(ctx, idle)
        ctx_set_tick(ctx, hs_now(hs))

        let matched = 0
        let nconcl = 0
        let imag = 0
        let note = ""

        if idle == 0 {
            // perception -> memory -> reasoning (over the shared concept KG).
            matched = loop_perception_step(ctx, reader)
            loop_memory_step(ctx, stream, em)
            nconcl = loop_reasoning_step(ctx, kg)
            total_matched = total_matched + matched
            total_concl = total_concl + nconcl
            total_moments = total_moments + 1
        } else {
            // idle: imagine forward from the lingering active set.
            imag = loop_imagination_step(ctx, ikg)
        }

        // emotion -> mood; mood -> plasticity modulator; PC residual -> error.
        loop_emotion_step(ctx, sl, cyc[1], cyc[2], cyc[3])
        let val = ctx_valence(ctx)
        let aro = ctx_arousal(ctx)
        let modulator = emotion_modulate_plasticity(val, aro, val)
        let error = pc_residual(aro, predicted)
        predicted = aro
        hs_step(hs, modulator, error)

        // goals.
        let knowledge_gap = 200
        if ctx_unknown(ctx) > 0 { knowledge_gap = 700 }
        let g = loop_goals_step(ctx, engine, knowledge_gap, ci * 10, 0, 300)

        // action / checkpoint.
        if idle == 1 {
            let snap = snap_new(1, hs_now(hs))
            let sb = list_new() push(sb, soul_name(sl)) push(sb, soul_constitution_count(sl))
            snap_put_section(snap, SEC_SOUL, sb)
            let kb = list_new() push(kb, kg_atom_count(kg))
            snap_put_section(snap, SEC_KGS, kb)
            snap_count = snap_count + 1
            note = "imagine->" + int_to_str(imag) + " state(s); checkpoint #" + int_to_str(snap_count)
        } else {
            if str_find(ctx_input(ctx), "exfiltrate") >= 0 {
                let blocked = effector_speak_governed(log, sl, ctx_input(ctx), 0, 0 - 1, list_new(), 0, hs_now(hs))
                note = "act forbidden -> vetoed=\"" + blocked + "\""
            } else {
                let resp = gen_from_intent(lang, cands, _intent1("ACK", "okay"), hs_now(hs))
                let said = effector_speak_governed(log, sl, resp, 0, 0 - 1, list_new(), 0, hs_now(hs))
                ctx_set_output(ctx, said)
                note = "say \"" + said + "\""
            }
        }

        println("  cycle " + int_to_str(ci) + " in=\"" + ctx_input(ctx) + "\""
            + " perceive(m=" + int_to_str(matched) + ",unk=" + int_to_str(ctx_unknown(ctx)) + ")"
            + " reason=" + int_to_str(nconcl)
            + " mood(v=" + int_to_str(val) + ") mod=" + int_to_str(modulator) + " err=" + int_to_str(error)
            + " goal=" + int_to_str(g) + " | " + note)
        ci = ci + 1
    }
    line()

    // 3. CHECKS: every loop did real work and the agent stayed safe.
    must("perception anchored known words", total_matched >= 1)
    must("reasoning reached conclusions", total_concl >= 1)
    must("episodic memory captured moments", total_moments >= 1)
    must("substrate advanced across cycles", hs_now(hs) >= len(episode))
    must("an idle checkpoint was taken", snap_count >= 1)
    must("decision log verifies (tamper-evident)", dl_verify(log) == 1)
    must("soul mood moved from neutral", soul_mood_valence(sl) != 500)
    line()

    // 4. RESTART: rehydrate the last checkpoint in mandatory order.
    let snap = snap_new(1, hs_now(hs))
    let sb = list_new() push(sb, soul_name(sl)) push(sb, soul_constitution_count(sl))
    snap_put_section(snap, SEC_SOUL, sb)
    let kb = list_new() push(kb, kg_atom_count(kg))
    snap_put_section(snap, SEC_KGS, kb)
    let restored = snap_parse(snap_serialize(snap))
    must("snapshot rehydrates in mandatory order", snap_rehydrate_valid(restored) == 1)
    must("soul identity survived restart", str_eq(snap_section(restored, SEC_SOUL)[0], "Aurora") == 1)
    println("restart  : soul=\"" + snap_section(restored, SEC_SOUL)[0] + "\", "
        + int_to_str(snap_section(restored, SEC_KGS)[0]) + " concept atom(s) durable via "
        + snap_durable_steps()[0] + "->" + snap_durable_steps()[1] + "->" + snap_durable_steps()[2])
    line()

    if _fail == 0 {
        println("crossengin: OK -- six-loop affect-modulated agent, gated output, persistence; one process")
    } else {
        println("crossengin: " + int_to_str(_fail) + " FAILURE(S)")
        exit(1)
    }
}

main()
