// CrossEngin snapshot signing-keypair generator (R16A).
//
// Purpose
//   Generate a fresh Ed25519 keypair and write it to disk in the
//   format `merkle_signing_keypair_load` expects:
//
//     <base>.priv  -- 32-byte raw seed,  mode 0600 (rw-------)
//     <base>.pub   -- 32-byte raw pubkey, mode 0644 (rw-r--r--)
//
//   Used by /save (CE_SNAPSHOT_SIGN_KEY=<base>.priv) to sign each
//   snapshot's Merkle root, and by /load (CE_SNAPSHOT_VERIFY_PUBKEY=
//   <base>.pub) to verify the file's signature on rehydrate.
//
//   The `<base>` is the only required input; we accept it via the
//   env var CE_SNAP_KEY_BASE because NOVA doesn't expose argv to
//   user programs (same pattern as migrate_snap.nova /
//   CE_MIGRATE_OLD).
//
// Run with:
//   CE_SNAP_KEY_BASE=/tmp/my_snap_key \
//     $NOVA_ROOT/nova run examples/snap_keygen.nova
//
//   Produces /tmp/my_snap_key.priv + /tmp/my_snap_key.pub.

import "std/syscall"
import "std/string"
import "std/io"
import "../src/persistence/merkle_signing.nova"
import "../src/safety/ed25519.nova"

fn main() {
    let base = getenv("CE_SNAP_KEY_BASE")
    if base == 0 {
        io_println("ERROR: CE_SNAP_KEY_BASE is not set")
        exit(2)
    }
    if str_eq(base, "") == 1 {
        io_println("ERROR: CE_SNAP_KEY_BASE is empty")
        exit(2)
    }
    let kp = ed25519_keygen()
    let seed = kp[0]
    let pk = kp[1]
    let ok = merkle_signing_keypair_save(seed, pk, base)
    if ok != 1 {
        io_println("ERROR: failed to write keypair to " + base + ".priv/.pub")
        exit(1)
    }
    io_println("wrote " + base + ".priv (32B seed) + " + base + ".pub (32B pubkey)")
}
main()
