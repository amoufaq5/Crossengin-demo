// Shared test harness for the SecAgg v4 soul tests (A2.2a). Not a test
// itself: it lives one directory above tests/unit/ like ce_test.nova.
//
// It plays a minimal, honest coordinator in memory: it relays the lines the
// souls produce, builds the U1..U4 sets, and reconstructs the aggregate
// from the reveals exactly as A2.2b's coordinator will (sum of y over U3,
// minus PRG(b_u) rebuilt from t b-shares, plus the dropped souls' pairwise
// masks rebuilt from their s-shares). Tests compare that against the sum
// of the inputs computed directly.
//
// Souls use the five RFC 8032 7.1 key pairs (TEST 1, 2, 3, 1024, SHA(abc))
// and non-contiguous ids 7, 300, 65536, 70000, 4294967295, so id, Shamir x
// and list index differ. sa4h_roster7 adds two souls (ids 80000, 90000,
// test-only seeds, public keys derived at run time) for N = 7, t = 5: the
// only size where a dropout still leaves more than t revealers (v4-sa2
// robust rebuild tests). Randomness is rng_test_new per (soul, round), so
// every run is byte-reproducible, and a shared vcache makes repeated
// signatures and checks free within one process.

import "../src/learning/sa4_soul.nova"
import "../src/learning/sa4_coord.nova"

let SA4H_IDS = [7, 300, 65536, 70000, 4294967295]
let SA4H_SEEDS = ["9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
    "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
    "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
    "f5e5767cf153319517630f226876b86c8160cc583bc013744c6bf255f5cc0ee5",
    "833fe62409237b9d62ec77587520911e9a759cec1d19755b7da901b96dca3d42"]
let SA4H_PKS = ["d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
    "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
    "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
    "278117fc144c72340f67d0f2316e8386ceffbf2b2428c9c51fef7c597f1d426e",
    "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf"]
let SA4H_L = 150
// Extra souls of the N = 7 and N = 10 rosters (ids between 70000 and
// 4294967295; test-only seeds, public keys derived at run time).
let SA4H_X_IDS = [80000, 90000, 100000, 110000, 120000]
let SA4H_X_SEEDS = ["a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a501",
    "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a502",
    "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a503",
    "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a504",
    "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a505"]

// The Ed25519 seed (hex) of a harness id.
fn sa4h_seed_hex(id) {
    let i = 0
    while i < len(SA4H_IDS) {
        if SA4H_IDS[i] == id { return SA4H_SEEDS[i] }
        i = i + 1
    }
    i = 0
    while i < len(SA4H_X_IDS) {
        if SA4H_X_IDS[i] == id { return SA4H_X_SEEDS[i] }
        i = i + 1
    }
    return ""
}

// N = 7 (t = 5): ids 7, 300, 65536, 70000, 80000, 90000, 4294967295.
fn sa4h_roster7() {
    let ids = [7, 300, 65536, 70000, 80000, 90000, 4294967295]
    let txt = "crossengin-secagg-roster v1\n"
    let i = 0
    while i < 7 {
        let pk = ""
        if i < 4 { pk = SA4H_PKS[i] }
        if i == 6 { pk = SA4H_PKS[4] }
        if len(pk) == 0 { pk = ed25519_bytes_to_hex(ed25519_pk_from_seed(ed25519_hex_to_bytes(SA4H_X_SEEDS[i - 4]))) }
        txt = txt + int_to_str(ids[i]) + " s" + int_to_str(i + 1) + " " + pk + "\n"
        i = i + 1
    }
    return sroster_parse(txt)
}

// N = 10 (t = 7, D = 4): ids 7, 300, 65536, 70000, 80000, 90000, 100000,
// 110000, 120000, 4294967295.
fn sa4h_roster10() {
    let ids = [7, 300, 65536, 70000, 80000, 90000, 100000, 110000, 120000, 4294967295]
    let txt = "crossengin-secagg-roster v1\n"
    let i = 0
    while i < 10 {
        let pk = ""
        if i < 4 { pk = SA4H_PKS[i] }
        if i == 9 { pk = SA4H_PKS[4] }
        if len(pk) == 0 { pk = ed25519_bytes_to_hex(ed25519_pk_from_seed(ed25519_hex_to_bytes(SA4H_X_SEEDS[i - 4]))) }
        txt = txt + int_to_str(ids[i]) + " s" + int_to_str(i + 1) + " " + pk + "\n"
        i = i + 1
    }
    return sroster_parse(txt)
}

fn sa4h_roster(n) {
    let txt = "crossengin-secagg-roster v1\n"
    let i = 0
    while i < n {
        txt = txt + int_to_str(SA4H_IDS[i]) + " s" + int_to_str(i + 1) + " " + SA4H_PKS[i] + "\n"
        i = i + 1
    }
    return sroster_parse(txt)
}

fn sa4h_layout() {
    let txt = "sa4 test layout v1"
    let l = list_new()
    let i = 0
    while i < len(txt) {
        push(l, char_at(txt, i))
        i = i + 1
    }
    return sa4w_sha256(l)
}

// Input of the soul at index i: wraps past 2^32 when summed.
fn sa4h_input(i, lw) {
    let out = list_new()
    let k = 0
    while k < lw {
        let v = int_add(int_add(int_mul(i + 1, 1000003), int_mul(k, 7919)), 4000000000)
        push(out, int_and(v, 4294967295))
        k = k + 1
    }
    return out
}

fn sa4h_rng(id, r) {
    let b = list_new()
    let tag = "sa4-test"
    let i = 0
    while i < len(tag) {
        push(b, char_at(tag, i))
        i = i + 1
    }
    let k = 24
    while k >= 0 {
        push(b, int_and(int_shr(id, k), 255))
        k = k - 8
    }
    k = 56
    while k >= 0 {
        push(b, int_and(int_shr(r, k), 255))
        k = k - 8
    }
    let ctx = list_new()
    rng_test_new(ctx, sac_list_to_buf(b), len(b))
    return ctx
}

// n souls for round r, all with their inputs set.
fn sa4h_souls(roster, n, r, vcache, last) {
    let out = list_new()
    let i = 0
    while i < n {
        let e = sroster_entries(roster)[i]
        let s = sa4s_new(roster, e, ed25519_hex_to_bytes(sa4h_seed_hex(e[0])), sa4h_rng(e[0], r), vcache, last)
        sa4s_set_input(s, sa4h_input(i, SA4H_L), sa4h_layout())
        push(out, s)
        i = i + 1
    }
    return out
}

fn sa4h_round_line(roster, r) {
    return sa4w_fmt_round(r, sa4w_unhex(sroster_fingerprint(roster), 32), SA4H_L, sa4h_layout())
}

// Feed lines; returns [ok, outs, err]. Stops at the first refusal and
// returns the abort line in outs.
fn sa4h_feed(sl, lines) {
    let outs = list_new()
    let i = 0
    while i < len(lines) {
        let res = sa4s_handle(sl, lines[i])
        let j = 0
        while j < len(res[2]) {
            push(outs, res[2][j])
            j = j + 1
        }
        if res[0] != 1 {
            let bad = list_new()
            push(bad, 0)
            push(bad, outs)
            push(bad, res[1])
            return bad
        }
        i = i + 1
    }
    let good = list_new()
    push(good, 1)
    push(good, outs)
    push(good, "")
    return good
}

fn sa4h_one(line) {
    let l = list_new()
    push(l, line)
    return l
}

fn sa4h_cat(a, b) {
    let out = list_new()
    let i = 0
    while i < len(a) {
        push(out, a[i])
        i = i + 1
    }
    i = 0
    while i < len(b) {
        push(out, b[i])
        i = i + 1
    }
    return out
}

fn sa4h_starts(s, p) {
    if len(s) < len(p) { return 0 }
    return str_eq_bytes(substr(s, 0, len(p)), p)
}

fn sa4h_filter(lines, prefix) {
    let out = list_new()
    let i = 0
    while i < len(lines) {
        if sa4h_starts(lines[i], prefix) == 1 { push(out, lines[i]) }
        i = i + 1
    }
    return out
}

// Exact sum of the inputs of the souls at the given x values.
fn sa4h_expected(xs) {
    let acc = sa4h_input(0, SA4H_L)
    let k = 0
    while k < SA4H_L {
        list_set(acc, k, 0)
        k = k + 1
    }
    let i = 0
    while i < len(xs) {
        acc = saprg_vec_add(acc, sa4h_input(xs[i] - 1, SA4H_L))
        i = i + 1
    }
    return acc
}

// The aggregate from the reveals, as the coordinator computes it, or 0.
//   advs: all SA4_ADV lines of U1; ys: all SA4_Y lines; reveals: all
//   SA4_REVEAL lines; u2, u3: x lists.
fn sa4h_unmask(roster, r, advs, ys, reveals, u2, u3) {
    let n = sroster_n(roster)
    let t = sroster_t(roster)
    let spk = list_new()
    let i = 0
    while i < n {
        push(spk, 0)
        i = i + 1
    }
    i = 0
    while i < len(advs) {
        let a = sa4w_parse(advs[i])
        list_set(spk, sroster_x(roster, a[2]) - 1, a[4])
        i = i + 1
    }
    // y per soul
    let total = sa4h_expected(list_new())
    i = 0
    while i < len(u3) {
        let id = sroster_entries(roster)[u3[i] - 1][0]
        let recs = list_new()
        let j = 0
        while j < len(ys) {
            let y = sa4w_parse(ys[j])
            if y[2] == id { push(recs, y) }
            j = j + 1
        }
        let yv = sa4w_y_assemble(recs, SA4H_L)
        if yv == 0 { return 0 }
        total = saprg_vec_add(total, yv)
        i = i + 1
    }
    // shares per (about, kind)
    let pr = list_new()
    i = 0
    while i < len(reveals) {
        push(pr, sa4w_parse(reveals[i]))
        i = i + 1
    }
    let ai = 0
    while ai < len(u2) {
        let ax = u2[ai]
        let about = sroster_entries(roster)[ax - 1][0]
        let kind = 1
        if _sa4s_contains(u3, ax) == 1 { kind = 0 }
        let shares = list_new()
        let j2 = 0
        while j2 < len(pr) {
            let p = pr[j2]
            if p[3] == about {
                if p[4] != kind { return 0 }        // the other kind was revealed
                if len(shares) < t {
                    push(shares, shamir_share(sroster_x(roster, p[2]), sac_list_to_buf(p[5]), 32))
                }
            }
            j2 = j2 + 1
        }
        if len(shares) < t { return 0 }
        let sec = shamir_combine(shares, 32)
        if sec == 0 { return 0 }
        if kind == 0 {
            total = saprg_mask(total, sec, 0 - 1)
        } else {
            let vi = 0
            while vi < len(u3) {
                let vx = u3[vi]
                let v = sroster_entries(roster)[vx - 1][0]
                let ms = sac_mask_seed(sec, sac_list_to_buf(spk[vx - 1]), r, about, v)
                if ms[1] != 1 { return 0 }
                // y_v carried +PRG(s_vd) if d > v, else -PRG(s_vd): undo it.
                if about > v {
                    total = saprg_mask(total, ms[0], 0 - 1)
                } else {
                    total = saprg_mask(total, ms[0], 1)
                }
                vi = vi + 1
            }
        }
        ai = ai + 1
    }
    return total
}

fn sa4h_same(a, b) {
    if a == 0 { return 0 }
    if len(a) != len(b) { return 0 }
    let i = 0
    while i < len(a) {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

fn sa4h_xs_of_ids(roster, ids) {
    let out = list_new()
    let i = 0
    while i < len(ids) {
        push(out, sroster_x(roster, ids[i]))
        i = i + 1
    }
    return out
}

fn sa4h_run(roster, souls, r, drop_before, drop_after) {
    return sa4h_run3(roster, souls, r, drop_before, drop_after, 0 - 1)
}

// Run a full round.
//   drop_before: index of a soul that never answers after its ADV
//   (-1: none): it is in U1 but not U2.
//   drop_after: index of a soul that sends shares but not y (-1: none): it
//   is in U2 but not U3.
//   drop_sig: index of a soul that sends y but no consistency signature
//   (-1: none): it is in U3 but not U4, so its b-share is revealed.
// Returns [ok, err, sum_ok, souls, advs, all_out_lines, reveals, sigs].
fn sa4h_run3(roster, souls, r, drop_before, drop_after, drop_sig) {
    let n = len(souls)
    let rl = sa4h_round_line(roster, r)
    let advs = list_new()
    let all = list_new()
    let i = 0
    while i < n {
        let f = sa4h_feed(souls[i], sa4h_one(rl))
        if f[0] != 1 { return [0, f[2], 0, souls, advs, all, list_new(), list_new()] }
        advs = sa4h_cat(advs, f[1])
        i = i + 1
    }
    let u1 = list_new()
    i = 0
    while i < n {
        push(u1, i + 1)
        i = i + 1
    }
    let set1 = sa4w_fmt_set(r, 1, sa4w_bitmap(u1))
    let shares = list_new()
    let u2 = list_new()
    i = 0
    while i < n {
        let f1 = sa4h_feed(souls[i], sa4h_cat(advs, sa4h_one(set1)))
        if f1[0] != 1 { return [0, f1[2], 0, souls, advs, all, list_new(), list_new()] }
        all = sa4h_cat(all, f1[1])
        if i != drop_before {
            shares = sa4h_cat(shares, sa4h_filter(f1[1], "SA4_SHARE "))
            push(u2, i + 1)
        }
        i = i + 1
    }
    // v4-sa3: the shares and SET 5 (U2' = u2) open the check phase; an
    // honest round has no complaint, so the final SET 2 names the same set.
    let set5 = sa4w_fmt_set(r, 5, sa4w_bitmap(u2))
    let set2 = sa4w_fmt_set(r, 2, sa4w_bitmap(u2))
    let ys = list_new()
    let u3 = list_new()
    i = 0
    while i < len(u2) {
        let si = u2[i] - 1
        let me = sroster_entries(roster)[si][0]
        let mine = list_new()
        let j = 0
        while j < len(shares) {
            let pr = sa4w_parse(shares[j])
            if pr[3] == me { push(mine, shares[j]) }
            j = j + 1
        }
        push(mine, set5)
        let f2c = sa4h_feed(souls[si], mine)
        if f2c[0] != 1 { return [0, f2c[2], 0, souls, advs, all, list_new(), list_new()] }
        all = sa4h_cat(all, f2c[1])
        let f2 = sa4h_feed(souls[si], sa4h_one(set2))
        if f2[0] != 1 { return [0, f2[2], 0, souls, advs, all, list_new(), list_new()] }
        all = sa4h_cat(all, f2[1])
        if si != drop_after {
            ys = sa4h_cat(ys, sa4h_filter(f2[1], "SA4_Y "))
            push(u3, si + 1)
        }
        i = i + 1
    }
    let set3 = sa4w_fmt_set(r, 3, sa4w_bitmap(u3))
    let sigs = list_new()
    let u4 = list_new()
    i = 0
    while i < len(u3) {
        let f3 = sa4h_feed(souls[u3[i] - 1], sa4h_one(set3))
        if f3[0] != 1 { return [0, f3[2], 0, souls, advs, all, list_new(), list_new()] }
        all = sa4h_cat(all, f3[1])
        if u3[i] - 1 != drop_sig {
            sigs = sa4h_cat(sigs, f3[1])
            push(u4, u3[i])
        }
        i = i + 1
    }
    let set4 = sa4w_fmt_set(r, 4, sa4w_bitmap(u4))
    let reveals = list_new()
    i = 0
    while i < len(u4) {
        let f4 = sa4h_feed(souls[u4[i] - 1], sa4h_cat(sigs, sa4h_one(set4)))
        if f4[0] != 1 { return [0, f4[2], 0, souls, advs, all, list_new(), sigs] }
        all = sa4h_cat(all, f4[1])
        reveals = sa4h_cat(reveals, sa4h_filter(f4[1], "SA4_REVEAL "))
        i = i + 1
    }
    let got = sa4h_unmask(roster, r, advs, ys, reveals, u2, u3)
    let ok = sa4h_same(got, sa4h_expected(u3))
    return [1, "", ok, souls, advs, all, reveals, sigs]
}

// T3 recomputed independently from the public lines: H1 over the U1 key
// pairs (from the ADV lines, ascending x), then the U2 and U3 bitmaps.
fn sa4h_t3(roster, r, advs, u1, u2, u3) {
    let keys = list_new()
    let i = 0
    while i < len(u1) {
        let id = sroster_entries(roster)[u1[i] - 1][0]
        let j = 0
        while j < len(advs) {
            let a = sa4w_parse(advs[j])
            if a[2] == id {
                let kp = list_new()
                push(kp, a[3])
                push(kp, a[4])
                push(kp, a[6])
                push(kp, a[7])
                push(keys, kp)
            }
            j = j + 1
        }
        i = i + 1
    }
    let h1 = sa4w_advset_hash(sa4w_bitmap(u1), keys)
    let fp = sa4w_unhex(sroster_fingerprint(roster), 32)
    return sa4w_t3_transcript(fp, r, h1, sa4w_bitmap(u2), sa4w_bitmap(u3))
}

// 1 if every round secret slot of the soul is cleared.
fn sa4h_wiped(sl) {
    if sl[12] != 0 { return 0 }
    if sl[14] != 0 { return 0 }
    if sl[16] != 0 { return 0 }
    if sl[27] != 0 { return 0 }
    if sl[29] != 0 { return 0 }
    if sl[30] != 0 { return 0 }
    if sl[31] != 0 { return 0 }
    if sl[34] != 0 { return 0 }
    return 1
}

// ---- end-to-end driver: souls + the real coordinator (A2.2b) -------------

// The phase (coordinator state) at which soul index i stops answering, or
// -1 if it never stops. stops: list of [index, phase].
fn sa4e_stop_phase(stops, i) {
    let k = 0
    while k < len(stops) {
        if stops[k][0] == i { return stops[k][1] }
        k = k + 1
    }
    return 0 - 1
}

// Tamper hook: tampers is a list of [index, phase, fn_index] or
// [index, phase, fn_index, arg]; sa4e_up applies the edit to the soul's
// outgoing lines (see sa4e_edit).
fn sa4e_tamper_entry(tampers, i, ph) {
    let k = 0
    while k < len(tampers) {
        if tampers[k][0] == i {
            if tampers[k][1] == ph { return tampers[k] }
        }
        k = k + 1
    }
    return 0
}

fn sa4e_tamper_of(tampers, i, ph) {
    let e = sa4e_tamper_entry(tampers, i, ph)
    if e == 0 { return 0 }
    return e[2]
}

// Edits that apply to every matching line (the others stop after the
// first line they change).
fn sa4e_edit_all(how) {
    if how == 6 { return 1 }
    if how == 8 { return 1 }
    return 0
}

// Flip the last hex digit of a line ("0" unless it is "0", then "1").
fn sa4e_flip_last(line) {
    let n = len(line)
    let last = "0"
    if char_at(line, n - 1) == 48 { last = "1" }
    return substr(line, 0, n - 1) + last
}

// Edits: 1 flip a byte of an ADV signature, 2 flip a byte of a SIG3
// signature, 3 turn the first reveal's kind b<->s, 4 flip a byte of the
// first s-share reveal, 5 flip a byte of the first share ciphertext,
// 6 flip a byte of every share ciphertext; v4-sa2 (the proof is kept, so
// it no longer matches the share): 7 flip a byte of the first b-share
// reveal, 8 flip a byte of every b-share reveal, 9 xor byte 0 of the share
// in the reveal about id arg[0] by arg[1], 10 drop the last 32 bytes of the
// first reveal's proof; v4-sa3: 11 flip the last hex digit of the SHARE
// line to id arg (an uplink MITM).
fn sa4e_edit(line, how) {
    return sa4e_edit2(line, how, 0)
}

fn sa4e_edit2(line, how, arg) {
    if how == 11 {
        if sa4h_starts(line, "SA4_SHARE ") == 1 {
            if sa4w_parse(line)[3] == arg { return sa4e_flip_last(line) }
        }
        return line
    }
    if how >= 7 {
        if sa4h_starts(line, "SA4_REVEAL ") == 1 {
            let q = sa4w_parse(line)
            let qs = q[5]
            if how <= 8 {
                if q[4] == 0 {
                    list_set(qs, 0, int_xor(qs[0], 1))
                    return sa4w_fmt_reveal(q[1], q[2], q[3], q[4], qs, q[6])
                }
            }
            if how == 9 {
                if q[3] == arg[0] {
                    list_set(qs, 0, int_xor(qs[0], arg[1]))
                    return sa4w_fmt_reveal(q[1], q[2], q[3], q[4], qs, q[6])
                }
            }
            if how == 10 {
                let pf = list_new()
                let z = 0
                while z < len(q[6]) - 32 {
                    push(pf, q[6][z])
                    z = z + 1
                }
                return sa4w_fmt_reveal(q[1], q[2], q[3], q[4], qs, pf)
            }
        }
        return line
    }
    if how >= 5 {
        if sa4h_starts(line, "SA4_SHARE ") == 1 {
            let p5 = sa4w_parse(line)
            let ct = p5[4]
            list_set(ct, 20, int_xor(ct[20], 1))
            return sa4w_fmt_share(p5[1], p5[2], p5[3], ct, p5[5])
        }
    }
    if how == 1 {
        if sa4h_starts(line, "SA4_ADV ") == 1 {
            let p = sa4w_parse(line)
            let g = p[5]
            list_set(g, 5, int_xor(g[5], 1))
            return sa4w_fmt_adv(p[1], p[2], p[3], p[4], g, p[6], p[7])
        }
    }
    if how == 2 {
        if sa4h_starts(line, "SA4_SIG3 ") == 1 {
            let p2 = sa4w_parse(line)
            let g2 = p2[3]
            list_set(g2, 7, int_xor(g2[7], 1))
            return sa4w_fmt_sig3(p2[1], p2[2], g2)
        }
    }
    if how == 3 {
        if sa4h_starts(line, "SA4_REVEAL ") == 1 {
            let p3 = sa4w_parse(line)
            return sa4w_fmt_reveal(p3[1], p3[2], p3[3], 1 - p3[4], p3[5], p3[6])
        }
    }
    if how == 4 {
        if sa4h_starts(line, "SA4_REVEAL ") == 1 {
            let p4 = sa4w_parse(line)
            if p4[4] == 1 {
                let s4 = p4[5]
                list_set(s4, 0, int_xor(s4[0], 1))
                return sa4w_fmt_reveal(p4[1], p4[2], p4[3], 1, s4, p4[6])
            }
        }
    }
    return line
}

// Hand soul i's output lines to the coordinator, unless it has stopped.
fn sa4e_up(c, souls, i, lines, stops, tampers) {
    let ph = sa4c_state(c)
    let sp = sa4e_stop_phase(stops, i)
    if sp >= 0 {
        if sa4c_phase_order(ph) >= sa4c_phase_order(sp) { return 0 }
    }
    let te = sa4e_tamper_entry(tampers, i, ph)
    let how = 0
    let arg = 0
    if te != 0 {
        how = te[2]
        if len(te) > 3 { arg = te[3] }
    }
    let id = sroster_entries(souls[i][1])[i][0]
    let done = 0
    let k = 0
    while k < len(lines) {
        let ln = lines[k]
        if how != 0 {
            if done == 0 {
                let ed = sa4e_edit2(ln, how, arg)
                if str_eq_bytes(ed, ln) == 0 {
                    if sa4e_edit_all(how) == 0 { done = 1 }
                }
                ln = ed
            }
        }
        sa4c_recv(c, id, ln)
        k = k + 1
    }
    return 0
}

// Inconsistent dealer (test-only surgery on soul i right after R0): the
// b-share it will deal to the lowest other x is altered, the tree and M_u
// are rebuilt over the altered share, and the ADV is re-signed, so the
// receiver's R2 check and the revealed proof both pass while the t shares
// no longer give the b_u that B_u commits to. Returns the new ADV lines.
fn sa4e_bad_dealer(roster, sl, adv_lines) {
    let me = sl[2][0]
    let mx = sl[2][4]
    let vx = 1
    if mx == 1 { vx = 2 }
    let bsh = sl[29]
    let sh = bsh[vx - 1]
    list_set(sh, 0, int_xor(sh[0], 1))
    let n = sroster_n(roster)
    let fp = sl[11]
    let r = sl[8]
    let leaves = list_new()
    let i = 0
    while i < n {
        push(leaves, sa4w_leaf(sa4w_hs(fp, r, me, i + 1, sl[30][i]), sa4w_hb(fp, r, me, i + 1, bsh[i])))
        i = i + 1
    }
    let tree = sa4w_tree(leaves, sa4w_depth(n))
    list_set(sl, 31, tree)
    list_set(sl, 33, sa4w_tree_root(tree))
    let a = sa4w_parse(adv_lines[0])
    let msg = sa4w_adv_transcript(fp, r, me, len(sl[9]), sl[10], a[3], a[4], sl[32], sl[33])
    let sig = ed25519_sign(msg, sl[3], sl[2][2])
    return sa4h_one(sa4w_fmt_adv(r, me, a[3], a[4], sig, sl[32], sl[33]))
}

fn sa4e_in(xs, v) {
    let k = 0
    while k < len(xs) {
        if xs[k] == v { return 1 }
        k = k + 1
    }
    return 0
}

// Run a round through the real coordinator. Returns
// [ok, err, words_or_0, coordinator].
fn sa4e_round(roster, souls, c, stops, tampers) {
    return sa4e_round_f(roster, souls, c, stops, tampers, list_new())
}

// bad_dealers: soul indices dealt inconsistently (sa4e_bad_dealer).
fn sa4e_round_f(roster, souls, c, stops, tampers, bad_dealers) {
    let res = sa4e_round_x(roster, souls, c, stops, tampers, bad_dealers, list_new())
    return [res[0], res[1], res[2], res[3]]
}

// ---- v4-sa3 test-only faults (surgery on a soul's own output) -------------
//
// faults: a list of entries, soul index i, target roster x:
//   [1, i, x, mode]  sender i's line to x is bad and i signs it into its
//                    share root (so the fault is provable): mode 1 the
//                    ciphertext is garbage(ct), 2 the plaintext x_to is
//                    (x mod N) + 1, 3 the b-share's byte 0 is flipped after
//                    the tree (bad_commit), 4 e_pk is SA4W_LOW_ORDER[2],
//                    5 sealed under e' = H("prepared" || e) and e' revealed
//                    (foreign key)
//   [2, i]           byte 0 of sender i's SHSIG flipped
//   [3, i, x]        soul i complains about x's (valid) share anyway
//   [4, i]           accused i answers SA4_ACCUSE with SA4_END 5 0
//   [5, i, x]        the routed SHARE line from x to soul i has its last
//                    hex digit flipped on i's downlink
//   [6, i]           accused i opens every forwarded complaint (corrupt)
//   [7, i, x, which] the ADV of x shown to soul i only is replaced by a
//                    second valid ADV of x: which 0 another c_pk, 1 another
//                    M (A2.4c attacks A1 / A2)
//   [8, i, x]        complaints from x forwarded to soul i are re-signed by
//                    x over i's own H1 (corrupt x, attack A1)
//   [9, i]           byte 0 of the signature of every complaint soul i
//                    sends is flipped
//   [10, i]          accused i sends its OPEN lines but not its SA4_END 5
//                    (openings count only once END 5 arrived)
// Sender modes also include 6: the plaintext version byte is 1.
// No production hook: everything is done on the soul's slots and lines.

fn sa4e_fault_of(faults, kind, i) {
    let k = 0
    while k < len(faults) {
        if faults[k][0] == kind {
            if faults[k][1] == i { return faults[k] }
        }
        k = k + 1
    }
    return 0
}

fn sa4e_bytes(s) {
    let out = list_new()
    let i = 0
    while i < len(s) {
        push(out, char_at(s, i))
        i = i + 1
    }
    return out
}

// The test-only garbage(ct) of SPEC A2.4c section 4: G0 = H(GARBAGE_DOMAIN
// || ct), G(i+1) = H(G(i)), the first len(ct) bytes of G0 || G1 || ...
fn sa4e_garbage(ct) {
    let g = sa4w_sha256(sa4h_cat(sa4e_bytes("crossengin/v4-sa/v3/test-garbage"), ct))
    let out = list_new()
    while len(out) < len(ct) {
        let k = 0
        while k < 32 {
            if len(out) < len(ct) { push(out, g[k]) }
            k = k + 1
        }
        g = sa4w_sha256(g)
    }
    return out
}

fn _sa4e_copy2(l) {
    if l == 0 { return 0 }
    let out = list_new()
    let i = 0
    while i < len(l) {
        push(out, _sa4s_copy(l[i]))
        i = i + 1
    }
    return out
}

// [bsh, ssh, tree] copies of soul sl's dealt shares (before SET 1).
fn sa4e_save_deal(sl) {
    let out = list_new()
    push(out, _sa4e_copy2(sl[29]))
    push(out, _sa4e_copy2(sl[30]))
    push(out, sl[31])
    return out
}

fn _sa4e_seal(sl, e, tx, pt) {
    let r = sl[8]
    let me = sl[2][0]
    let v = _sa4s_entry_at_x(sl, tx)[0]
    let ek = sac_enc_key(e, sac_list_to_buf(sl[17][tx - 1][0]), r, me, v)
    let ptb = sac_list_to_buf(pt)
    let w = sac_share_seal(ek[0], r, me, v, ptb, len(pt))
    return sac_buf_to_list(w[0], w[1])
}

// Rewrite sender sl's R1 output (outs) for a [1, i, x, mode] fault; also
// keeps its leaves, root and SHSIG consistent. Returns [outs, e_foreign].
fn sa4e_r1_fault(sl, outs, saved, f) {
    let n = sroster_n(sl[1])
    let r = sl[8]
    let me = sl[2][0]
    let fp = sl[11]
    let tx = f[2]
    let mode = f[3]
    let v = _sa4s_entry_at_x(sl, tx)[0]
    let ebuf = sac_eph_key(sl[34], r, me, v)[0]
    let efor = 0
    let out = list_new()
    let k = 0
    while k < len(outs) {
        let ln = outs[k]
        if sa4h_starts(ln, "SA4_SHARE ") == 1 {
            let q = sa4w_parse(ln)
            if q[3] == v {
                let ct = q[4]
                let epk = q[5]
                let path = sa4w_path(saved[2], tx - 1)
                if mode == 1 { ct = sa4e_garbage(ct) }
                if mode == 2 {
                    let xt = (tx - (tx / n) * n) + 1
                    ct = _sa4e_seal(sl, ebuf, tx, sa4w_share_pt(me, v, r, xt, saved[1][tx - 1], saved[0][tx - 1], path))
                }
                if mode == 3 {
                    let bb = _sa4s_copy(saved[0][tx - 1])
                    list_set(bb, 0, int_xor(bb[0], 1))
                    ct = _sa4e_seal(sl, ebuf, tx, sa4w_share_pt(me, v, r, tx, saved[1][tx - 1], bb, path))
                }
                if mode == 4 { epk = sa4w_unhex(SA4W_LOW_ORDER[2], 32) }
                if mode == 6 {
                    let pv = sa4w_share_pt(me, v, r, tx, saved[1][tx - 1], saved[0][tx - 1], path)
                    list_set(pv, 0, 1)
                    ct = _sa4e_seal(sl, ebuf, tx, pv)
                }
                if mode == 5 {
                    let e1 = sa4w_sha256(sa4h_cat(sa4e_bytes("prepared"), sac_buf_to_list(ebuf, 32)))
                    efor = e1
                    ct = _sa4e_seal(sl, sac_list_to_buf(e1), tx, sa4w_share_pt(me, v, r, tx, saved[1][tx - 1], saved[0][tx - 1], path))
                }
                list_set(sl[35], tx - 1, sa4w_sleaf(fp, r, me, tx, v, epk, ct))
                ln = sa4w_fmt_share(r, me, v, ct, epk)
            }
        }
        if sa4h_starts(ln, "SA4_SHSIG ") == 1 {
            let root = sa4w_tree_root(sa4w_share_tree(sl[35], sa4w_depth(n)))
            let g = ed25519_sign(sa4w_shares_transcript(fp, r, me, sl[23], root), sl[3], sl[2][2])
            ln = sa4w_fmt_shsig(r, me, g)
        }
        push(out, ln)
        k = k + 1
    }
    let res = list_new()
    push(res, out)
    push(res, efor)
    return res
}

fn sa4e_flip_csig(outs) {
    let out = list_new()
    let k = 0
    while k < len(outs) {
        let ln = outs[k]
        if sa4h_starts(ln, "SA4_COMPLAINT ") == 1 {
            let q = sa4w_parse(ln)
            let g = q[5]
            list_set(g, 0, int_xor(g[0], 1))
            ln = sa4w_fmt_complaint(q[1], q[2], q[3], q[4], g)
        }
        push(out, ln)
        k = k + 1
    }
    return out
}

fn sa4e_flip_shsig(outs) {
    let out = list_new()
    let k = 0
    while k < len(outs) {
        let ln = outs[k]
        if sa4h_starts(ln, "SA4_SHSIG ") == 1 {
            let q = sa4w_parse(ln)
            let g = q[3]
            list_set(g, 0, int_xor(g[0], 1))
            ln = sa4w_fmt_shsig(q[1], q[2], g)
        }
        push(out, ln)
        k = k + 1
    }
    return out
}

// Soul sl (just through CHECK, output outs) also complains about x, whose
// share line is among the lines fed to it (fed).
fn sa4e_false_complaint(sl, outs, fed, x) {
    let r = sl[8]
    let me = sl[2][0]
    let mx = sl[2][4]
    let u = _sa4s_entry_at_x(sl, x)[0]
    let cl = ""
    let k = 0
    while k < len(fed) {
        if sa4h_starts(fed[k], "SA4_SHARE ") == 1 {
            let q = sa4w_parse(fed[k])
            if q[2] == u {
                let lh = sa4w_sleaf(sl[11], r, u, mx, me, q[5], q[4])
                let g = ed25519_sign(sa4w_complaint_transcript(sl[11], r, me, u, sl[23], lh), sl[3], sl[2][2])
                cl = sa4w_fmt_complaint(r, me, u, lh, g)
            }
        }
        k = k + 1
    }
    let hv = sl[19][x - 1]
    if hv != 0 {
        _sa4s_zero_list(hv[0])
        _sa4s_zero_list(hv[1])
        list_set(sl[19], x - 1, 0)
    }
    push(sl[37], x)
    // Complaints stay in ascending sender x; END 4 counts them.
    let out = list_new()
    let done = 0
    let cnt = 0
    k = 0
    while k < len(outs) {
        let ln = outs[k]
        if sa4h_starts(ln, "SA4_COMPLAINT ") == 1 {
            let cx = sroster_x(sl[1], sa4w_parse(ln)[3])
            if done == 0 {
                if cx > x {
                    push(out, cl)
                    cnt = cnt + 1
                    done = 1
                }
            }
            push(out, ln)
            cnt = cnt + 1
        } else {
            if done == 0 {
                push(out, cl)
                cnt = cnt + 1
                done = 1
            }
            push(out, sa4w_fmt_end(r, 4, me, cnt))
        }
        k = k + 1
    }
    return out
}

// The OPEN phase output of soul sl rewritten: mode 0 silent (END 5 0),
// mode 1 open every complaint fed to it, mode 2 replace the e revealed to
// target x by efor.
fn sa4e_open_fault(sl, outs, fed, mode, x, efor) {
    let r = sl[8]
    let me = sl[2][0]
    let out = list_new()
    if mode == 0 {
        push(out, sa4w_fmt_end(r, 5, me, 0))
        return out
    }
    if mode == 1 {
        let vx = 1
        while vx <= sroster_n(sl[1]) {
            let k = 0
            while k < len(fed) {
                if sa4h_starts(fed[k], "SA4_COMPLAINT ") == 1 {
                    let q = sa4w_parse(fed[k])
                    if sroster_x(sl[1], q[2]) == vx {
                        let e = sac_eph_key(sl[34], r, me, q[2])[0]
                        push(out, sa4w_fmt_open(r, me, q[2], sac_buf_to_list(e, 32)))
                    }
                }
                k = k + 1
            }
            vx = vx + 1
        }
        push(out, sa4w_fmt_end(r, 5, me, len(out)))
        return out
    }
    let v = _sa4s_entry_at_x(sl, x)[0]
    let k2 = 0
    while k2 < len(outs) {
        let ln = outs[k2]
        if sa4h_starts(ln, "SA4_OPEN ") == 1 {
            if sa4w_parse(ln)[3] == v { ln = sa4w_fmt_open(r, me, v, efor) }
        }
        push(out, ln)
        k2 = k2 + 1
    }
    return out
}

// outs without its SA4_END lines (fault 10).
fn sa4e_drop_end(outs) {
    let out = list_new()
    let k = 0
    while k < len(outs) {
        if sa4h_starts(outs[k], "SA4_END ") == 0 { push(out, outs[k]) }
        k = k + 1
    }
    return out
}

// Downlink edits for soul i of the messages mine (faults 5, 7, 8).
fn sa4e_down(roster, souls, i, mine, faults, r) {
    let out = list_new()
    let k = 0
    while k < len(mine) {
        let ln = mine[k]
        let f = 0
        let fi = 0
        while fi < len(faults) {
            f = faults[fi]
            if f[1] == i {
                if f[0] == 5 {
                    if sa4h_starts(ln, "SA4_SHARE ") == 1 {
                        if sa4w_parse(ln)[2] == sroster_entries(roster)[f[2] - 1][0] { ln = sa4e_flip_last(ln) }
                    }
                }
                if f[0] == 7 {
                    if sa4h_starts(ln, "SA4_ADV ") == 1 {
                        let a = sa4w_parse(ln)
                        let ax = sroster_x(roster, a[2])
                        if ax == f[2] {
                            let cpk = a[3]
                            let mr = a[7]
                            if f[3] == 0 {
                                let pkb = alloc(33)
                                x25519_base(pkb, sac_list_to_buf(sa4w_sha256(sa4e_bytes("second c key of " + int_to_str(a[2])))))
                                cpk = sac_buf_to_list(pkb, 32)
                            }
                            if f[3] == 1 { mr = sa4w_sha256(sa4e_bytes("other M of " + int_to_str(a[2]))) }
                            let sx = souls[ax - 1]
                            let msg = sa4w_adv_transcript(sx[11], r, a[2], len(sx[9]), sx[10], cpk, a[4], a[6], mr)
                            let g = ed25519_sign(msg, sx[3], sx[2][2])
                            ln = sa4w_fmt_adv(r, a[2], cpk, a[4], g, a[6], mr)
                        }
                    }
                }
                if f[0] == 8 {
                    if sa4h_starts(ln, "SA4_COMPLAINT ") == 1 {
                        let q = sa4w_parse(ln)
                        let qx = sroster_x(roster, q[2])
                        if qx == f[2] {
                            let sq = souls[qx - 1]
                            let g8 = ed25519_sign(sa4w_complaint_transcript(sq[11], r, q[2], q[3], souls[i][23], q[4]), sq[3], sq[2][2])
                            ln = sa4w_fmt_complaint(r, q[2], q[3], q[4], g8)
                        }
                    }
                }
            }
            fi = fi + 1
        }
        push(out, ln)
        k = k + 1
    }
    return out
}

// Feed soul i its messages, applying the faults; returns its output lines
// (what the soul, honest or faulty, sends).
fn sa4e_soul_step(roster, souls, i, mine, faults, efors) {
    let sl = souls[i]
    let before = sa4s_state(sl)
    let saved = 0
    if before == 1 {
        if sa4e_fault_of(faults, 1, i) != 0 { saved = sa4e_save_deal(sl) }
    }
    let outs = sa4h_feed(sl, mine)[1]
    let after = sa4s_state(sl)
    if before == 1 {
        if after == 2 {
            let k = 0
            while k < len(faults) {
                let f = faults[k]
                if f[0] == 1 {
                    if f[1] == i {
                        let rr = sa4e_r1_fault(sl, outs, saved, f)
                        outs = rr[0]
                        if rr[1] != 0 {
                            let ef = list_new()
                            push(ef, i)
                            push(ef, f[2])
                            push(ef, rr[1])
                            push(efors, ef)
                        }
                    }
                }
                k = k + 1
            }
            if sa4e_fault_of(faults, 2, i) != 0 { outs = sa4e_flip_shsig(outs) }
        }
    }
    if before == 2 {
        if after == 7 {
            let k3 = 0
            while k3 < len(faults) {
                let f3 = faults[k3]
                if f3[0] == 3 {
                    if f3[1] == i { outs = sa4e_false_complaint(sl, outs, mine, f3[2]) }
                }
                k3 = k3 + 1
            }
            if sa4e_fault_of(faults, 9, i) != 0 { outs = sa4e_flip_csig(outs) }
        }
    }
    if before == 7 {
        if after == 8 {
            if sa4e_fault_of(faults, 4, i) != 0 { outs = sa4e_open_fault(sl, outs, mine, 0, 0, 0) }
            if sa4e_fault_of(faults, 6, i) != 0 { outs = sa4e_open_fault(sl, outs, mine, 1, 0, 0) }
            if sa4e_fault_of(faults, 10, i) != 0 { outs = sa4e_drop_end(outs) }
            let q = 0
            while q < len(efors) {
                if efors[q][0] == i { outs = sa4e_open_fault(sl, outs, mine, 2, efors[q][1], efors[q][2]) }
                q = q + 1
            }
        }
    }
    return outs
}

fn _sa4e_log(log, id, lines) {
    let k = 0
    while k < len(lines) {
        let e = list_new()
        push(e, id)
        push(e, lines[k])
        push(log, e)
        k = k + 1
    }
    return 0
}

// The full driver: as sa4e_round_f plus the v4-sa3 faults above. Returns
// [ok, err, words_or_0, coordinator, log]; log = every line a soul sent,
// as [id, line], in order (after the soul-side faults, before uplink
// tampering).
fn sa4e_round_x(roster, souls, c, stops, tampers, bad_dealers, faults) {
    let n = len(souls)
    let log = list_new()
    let efors = list_new()
    let rl = sa4c_round_line(c)
    let i = 0
    while i < n {
        if sa4e_stop_phase(stops, i) != 0 {
            let a0 = sa4h_feed(souls[i], sa4h_one(rl))[1]
            if sa4e_in(bad_dealers, i) == 1 { a0 = sa4e_bad_dealer(roster, souls[i], a0) }
            _sa4e_log(log, sroster_entries(roster)[i][0], a0)
            sa4e_up(c, souls, i, a0, stops, tampers)
        }
        i = i + 1
    }
    let loops = 0
    let going = 1
    while going == 1 {
        let stc = sa4c_state(c)
        if stc == 5 { going = 0 }
        if stc == 7 { going = 0 }
        if going == 1 {
            loops = loops + 1
            if loops > 8 { return [0, "driver loop", 0, c, log] }
            let cl = sa4c_close(c)
            if cl[0] != 1 { return [0, cl[1], 0, c, log] }
            let msgs = cl[2]
            i = 0
            while i < n {
                let id = sroster_entries(roster)[i][0]
                let mine = list_new()
                let k = 0
                while k < len(msgs) {
                    if msgs[k][0] == id { push(mine, msgs[k][1]) }
                    k = k + 1
                }
                if len(mine) > 0 {
                    let sp = sa4e_stop_phase(stops, i)
                    let live = 1
                    if sp >= 0 {
                        if sa4c_phase_order(sa4c_state(c)) >= sa4c_phase_order(sp) { live = 0 }
                    }
                    if live == 1 {
                        let fed = sa4e_down(roster, souls, i, mine, faults, c[2])
                        let outs = sa4e_soul_step(roster, souls, i, fed, faults, efors)
                        _sa4e_log(log, id, outs)
                        sa4e_up(c, souls, i, outs, stops, tampers)
                    }
                }
                i = i + 1
            }
        }
    }
    if sa4c_state(c) == 7 { return [0, "cancelled: " + c[15], 0, c, log] }
    let um = sa4c_unmask(c)
    if um[0] != 1 { return [0, um[1], 0, c, log] }
    return [1, "", um[2], c, log]
}

// n souls of roster through R0 and R1 (U1 = all), with the sender faults
// of faults applied: [souls, advs, all R1 lines (SHARE, SHSIG, END 1)].
fn sa4e_through_r1(roster, n, r, vc, faults) {
    let souls = sa4h_souls(roster, n, r, vc, 0)
    let rl = sa4h_round_line(roster, r)
    let advs = list_new()
    let i = 0
    while i < n {
        advs = sa4h_cat(advs, sa4h_feed(souls[i], sa4h_one(rl))[1])
        i = i + 1
    }
    let xs = list_new()
    i = 0
    while i < n {
        push(xs, i + 1)
        i = i + 1
    }
    let lines = sa4h_cat(advs, sa4h_one(sa4w_fmt_set(r, 1, sa4w_bitmap(xs))))
    let efors = list_new()
    let r1 = list_new()
    i = 0
    while i < n {
        r1 = sa4h_cat(r1, sa4e_soul_step(roster, souls, i, lines, faults, efors))
        i = i + 1
    }
    return [souls, advs, r1]
}

// The SHARE lines in lines addressed to id, in order.
fn sa4e_shares_to(lines, id) {
    let out = list_new()
    let k = 0
    while k < len(lines) {
        if sa4h_starts(lines[k], "SA4_SHARE ") == 1 {
            if sa4w_parse(lines[k])[3] == id { push(out, lines[k]) }
        }
        k = k + 1
    }
    return out
}

// The named harness rounds of SPEC A2.4c section 15 (N = 5, r = 13, last
// 0, L = 150): "P" plain, "F" 4294967295 sends 7 garbage (code 1), "G"
// 65536 complains falsely about 7 (code 2), "H" F with a silent accused
// (code 3), "I" the routed line 4294967295 -> 7 altered on 7's downlink
// (7 code 5), "J" F plus a bad SHSIG (code 4); "K" / "L" F / G with
// 70000 silent after its ADV (in U1, not in U2'; the round then cancels,
// |U2| 3 < t, and the evidence must still cover U1). Returns sa4e_round_x's
// [ok, err, words, coordinator, log] plus the roster at index 5.
fn sa4e_named_round(name, vc) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, 13, vc, 0)
    let c = sa4c_new(roster, 13, SA4H_L, sa4h_layout(), vc)
    let faults = list_new()
    let stops = list_new()
    if str_eq_bytes(name, "F") == 1 { faults = [[1, 4, 1, 1]] }
    if str_eq_bytes(name, "G") == 1 { faults = [[3, 2, 1]] }
    if str_eq_bytes(name, "H") == 1 { faults = [[1, 4, 1, 1], [4, 4]] }
    if str_eq_bytes(name, "I") == 1 { faults = [[5, 0, 5]] }
    if str_eq_bytes(name, "J") == 1 { faults = [[1, 4, 1, 1], [2, 4]] }
    if str_eq_bytes(name, "K") == 1 {
        faults = [[1, 4, 1, 1]]
        stops = [[3, 1]]
    }
    if str_eq_bytes(name, "L") == 1 {
        faults = [[3, 2, 1]]
        stops = [[3, 1]]
    }
    let res = sa4e_round_x(roster, souls, c, stops, list_new(), list_new(), faults)
    push(res, roster)
    return res
}

// "7,300" for a list of ids.
fn sa4e_ids_str(ids) {
    let out = ""
    let i = 0
    while i < len(ids) {
        if i > 0 { out = out + "," }
        out = out + int_to_str(ids[i])
        i = i + 1
    }
    return out
}

fn sa4e_coord(roster, r, vc) {
    return sa4c_new(roster, r, SA4H_L, sa4h_layout(), vc)
}
