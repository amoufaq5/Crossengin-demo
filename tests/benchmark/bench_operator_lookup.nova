// CrossEngin benchmark: operator-lookup speedup at N atoms (P1.5, ADR-0070).
//
// Purpose
//   Phase-boundary performance check for the directed-edge adjacency index that
//   backs `rk_operators_from` / `rk_operators_to`. Builds a reasoning KG with
//   N concept atoms and ~N operator edges, then times two equivalent lookups
//   head-to-head over many random premise ids:
//
//     A) Linear scan (the pre-P1.5 path): iterate EVERY atom, test
//        `is_operator` + `rop_premise == pid`. O(atoms) per lookup.
//     B) Indexed: `rk_operators_from(rkg, pid)` walks only the pid's bucket.
//        O(out-degree) per lookup.
//
//   On an N=2000 / ~2000-edge KG the scan touches ~4000 atoms per query while
//   the index touches ~1-2, so the expected ratio is large (tens to hundreds x);
//   the acceptance bar is "clearly super-linear separation, >= 20x at N=2000".
//   The clock is `nanotime()` (ns resolution).
//
// CrossEngin dependencies: src/parts/reasoning/reasoning_atoms.nova (rop_* +
//   rk_operators_from + the kg/atom API it re-exports).

import "std/io"
import "../../src/parts/reasoning/reasoning_atoms.nova"

// The exact pre-index full scan, kept as the head-to-head baseline.
fn _scan_from(rkg, pid) {
    let atoms = kg_atoms(rkg)
    let out = list_new()
    let i = 0
    while i < len(atoms) {
        if is_operator(atoms[i]) == 1 {
            if rop_premise(atoms[i]) == pid { push(out, atoms[i]) }
        }
        i = i + 1
    }
    return out
}

fn safe_div(a, b) {
    if b <= 0 { return a }
    return a / b
}

fn main() {
    println("=== CrossEngin benchmark: operator lookup (P1.5 edge index) ===")
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let n_atoms = 2000

    // Concept atoms 0..n-1.
    let i = 0
    while i < n_atoms {
        kg_add_atom(rkg, ATOM_CONCEPT, "c_" + int_to_str(i), 0)
        i = i + 1
    }

    // ~n operator edges: a chain i -> i+1 plus a few cross edges, so most nodes
    // have out-degree 1-2 while the KG holds ~n operators total. rop_new builds
    // the index incrementally (the analogue of ANN insertion cost).
    let t0 = nanotime()
    let e = 0
    while e < n_atoms - 1 {
        rop_new(rkg, ROP_CAUSAL, e, e + 1, "e", 0)
        if e % 7 == 0 { rop_new(rkg, ROP_IMPLY, e, (e + 3) % n_atoms, "x", 0) }
        e = e + 1
    }
    let t_build_ns = nanotime() - t0
    println("  atoms                 : " + int_to_str(n_atoms))
    println("  index build elapsed ms: " + int_to_str(t_build_ns / 1000000))

    // Pre-build query premise ids (spread across the id space).
    let queries = list_new()
    let q_count = 200
    let qi = 0
    while qi < q_count {
        push(queries, (qi * 9 + 1) % n_atoms)
        qi = qi + 1
    }

    let bench_rounds = 20
    // ---- A: linear scan (pre-P1.5) ---------------------------------------
    let lin_hits = 0
    let t_lin_0 = nanotime()
    let r = 0
    while r < bench_rounds {
        let m = 0
        while m < q_count {
            lin_hits = lin_hits + len(_scan_from(rkg, queries[m]))
            m = m + 1
        }
        r = r + 1
    }
    let t_lin_ns = nanotime() - t_lin_0

    // ---- B: indexed lookup -----------------------------------------------
    let idx_hits = 0
    let t_idx_0 = nanotime()
    let r2 = 0
    while r2 < bench_rounds {
        let m2 = 0
        while m2 < q_count {
            idx_hits = idx_hits + len(rk_operators_from(rkg, queries[m2]))
            m2 = m2 + 1
        }
        r2 = r2 + 1
    }
    let t_idx_ns = nanotime() - t_idx_0

    println("  lookups (each path)   : " + int_to_str(q_count * bench_rounds))
    println("  linear scan total ms  : " + int_to_str(t_lin_ns / 1000000))
    println("  indexed total ms      : " + int_to_str(t_idx_ns / 1000000))
    println("  speedup (x)           : " + int_to_str(safe_div(t_lin_ns, t_idx_ns)))
    // Correctness guard: both paths must agree on total hit count.
    if lin_hits == idx_hits {
        println("  parity                : OK (" + int_to_str(idx_hits) + " hits both)")
    } else {
        println("  parity                : FAIL lin=" + int_to_str(lin_hits) + " idx=" + int_to_str(idx_hits))
    }
}

main()
