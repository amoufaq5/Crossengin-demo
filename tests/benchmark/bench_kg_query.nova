// CrossEngin benchmark: KG query throughput.
//
// Purpose
//   Phase-boundary performance check for the knowledge layer (ADR-0049). Reports
//   atom insertion rate, O(1) lookup-by-id rate, indexed lookup-by-label rate
//   (the P2.4 hash-index path the reader uses), the scalar-walk lookup rate
//   (the legacy linear scan, for the speedup ratio), and Bayesian observation
//   rate. The second-resolution clock means each loop runs enough work to
//   span ~1s.
//
//   P2.4 (this revision) added the by-label hash index. The new section
//   below times the indexed path against the scalar-walk fallback over the
//   same 1000-atom KG and prints the speedup ratio. The legacy by-label scan
//   over 3000 atoms is retained because external benchmarks compare against
//   it.
//
// CrossEngin dependencies: src/kg/multi_kg_manager.nova.

import "std/io"
import "../../src/kg/multi_kg_manager.nova"

fn safe_div(a, b) {
    if b <= 0 { return a }
    return a / b
}

// Scalar walk over kg_atoms -- the old kg_find_atom implementation, kept here
// so we can show the indexed-vs-scalar delta head-to-head.
fn _scalar_find_atom(kg, label) {
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        if str_eq(atom_label(atoms[i]), label) == 1 { return atoms[i] }
        i = i + 1
    }
    return 0
}

fn main() {
    println("=== CrossEngin benchmark: KG query ===")
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "bench")
    let n_atoms = 3000

    // Insertion.
    let t0 = time()
    let i = 0
    while i < n_atoms {
        kg_add_atom(kg, ATOM_FACT, "atom_" + int_to_str(i), 0)
        i = i + 1
    }
    let t_ins = time() - t0
    println("  atoms inserted    : " + int_to_str(n_atoms))
    println("  insert elapsed(s) : " + int_to_str(t_ins))
    println("  inserts/sec       : " + int_to_str(safe_div(n_atoms, t_ins)))

    // O(1) lookup by id.
    let lookups = 300000
    let t1 = time()
    let k = 0
    let acc = 0
    while k < lookups {
        let a = kg_atom(kg, k % n_atoms)
        acc = acc + atom_id(a)
        k = k + 1
    }
    let t_id = time() - t1
    println("  id lookups        : " + int_to_str(lookups))
    println("  id lookups/sec    : " + int_to_str(safe_div(lookups, t_id)))

    // O(n) lookup by label (linear scan over n_atoms). Kept for comparison
    // with prior benchmark runs; the indexed path is the actual production
    // path.
    let label_lookups = 2000
    let t2 = time()
    let m = 0
    while m < label_lookups {
        kg_find_atom(kg, "atom_" + int_to_str(m))
        m = m + 1
    }
    let t_lbl = time() - t2
    println("  label lookups     : " + int_to_str(label_lookups) + " over " + int_to_str(n_atoms) + " atoms")
    println("  label lookups/sec : " + int_to_str(safe_div(label_lookups, t_lbl)))

    // P2.4: hash-indexed vs scalar-walk on a 1000-atom KG, head-to-head.
    // The second-resolution `time()` can't resolve the indexed half on its
    // own (it finishes well under 1s), so we measure both halves with
    // `nanotime()` for accurate ns-resolution timing AND span enough total
    // work that the scalar half is comfortably over 1s. The brief asks for
    // "1000 atoms, 1000 random lookups + report scalar vs indexed time +
    // ratio"; we run 1000 rounds of 1000 lookups (=1M lookups) so both
    // numbers are well-conditioned.
    let bkg = kg_spawn(reg, "p24")
    let bn = 1000
    let bi = 0
    while bi < bn {
        kg_add_atom(bkg, ATOM_FACT, "p24_" + int_to_str(bi), 0)
        bi = bi + 1
    }
    // Pre-build labels so the timed loop only pays the lookup cost.
    let blabels = list_new()
    let bli = 0
    while bli < bn {
        push(blabels, "p24_" + int_to_str(bli))
        bli = bli + 1
    }
    let runs = 1000   // 1000 lookups per run; we'll run BENCH_LOOPS rounds
    let bench_loops = 1000
    let total_lookups = runs * bench_loops

    // Indexed lookup (P2.4).
    let t_idx_ns0 = nanotime()
    let r = 0
    let idx_hits = 0
    while r < bench_loops {
        let m2 = 0
        while m2 < runs {
            let a = kg_find_atom(bkg, blabels[m2])
            if a != 0 { idx_hits = idx_hits + 1 }
            m2 = m2 + 1
        }
        r = r + 1
    }
    let t_idx_ns = nanotime() - t_idx_ns0

    // Scalar walk (the legacy linear scan).
    let t_sc_ns0 = nanotime()
    let s = 0
    let sc_hits = 0
    while s < bench_loops {
        let m3 = 0
        while m3 < runs {
            let a = _scalar_find_atom(bkg, blabels[m3])
            if a != 0 { sc_hits = sc_hits + 1 }
            m3 = m3 + 1
        }
        s = s + 1
    }
    let t_sc_ns = nanotime() - t_sc_ns0

    // Convert ns to ms for human readability. Use raw ns for the ratio so
    // we don't lose precision on the fast (indexed) half.
    let t_idx_ms = t_idx_ns / 1000000
    let t_sc_ms  = t_sc_ns  / 1000000
    let ratio = 0
    if t_idx_ns > 0 { ratio = t_sc_ns / t_idx_ns }

    // For per-lookup wall-clock report only (drop to ns / ms units).
    let idx_per_ms = 0
    if t_idx_ms > 0 { idx_per_ms = total_lookups / t_idx_ms }
    let sc_per_ms = 0
    if t_sc_ms > 0 { sc_per_ms = total_lookups / t_sc_ms }

    println("  --- P2.4 indexed vs scalar (1000-atom KG) ---")
    println("  total lookups      : " + int_to_str(total_lookups))
    println("  indexed elapsed(ms): " + int_to_str(t_idx_ms))
    println("  scalar  elapsed(ms): " + int_to_str(t_sc_ms))
    println("  indexed lookups/ms : " + int_to_str(idx_per_ms))
    println("  scalar  lookups/ms : " + int_to_str(sc_per_ms))
    println("  speedup ratio (ns) : " + int_to_str(ratio) + "x")
    println("  indexed hits       : " + int_to_str(idx_hits))
    println("  scalar  hits       : " + int_to_str(sc_hits))

    // Bayesian observation throughput.
    let obs = 300000
    let a0 = kg_atom(kg, 0)
    let t3 = time()
    let o = 0
    while o < obs {
        atom_observe(a0, 1)
        o = o + 1
    }
    let t_obs = time() - t3
    println("  observations      : " + int_to_str(obs))
    println("  observations/sec  : " + int_to_str(safe_div(obs, t_obs)))
    println("benchmark complete")
}

main()
