// CrossEngin A2.0 -- SecAgg v4 primitive timing micro-benchmark.
//
// Purpose
//   Report what each SecAgg v4 building block costs, so A2.1-A2.5 can size
//   their timeouts and round budgets, and give a rough side-channel check
//   on gf256_mul: its time should not depend on its operands. Reports only;
//   nothing here passes or fails. Run with `make benchmark` or
//   `nova run tests/benchmark/bench_sa_primitives.nova`.
//
// Output: one `name median_ns p99_ns n` line per measurement, then a
// crossengin-bench-v1 JSON line. Times are wall clock (nanotime), so they
// are noisy; compare medians, and treat the gf256 operand ratios as a smoke
// signal, not a proof of constant time.
//
// CrossEngin dependencies: src/safety/{gf256,shamir,saprg,ed25519}.nova,
//   src/learning/sa_crypto.nova.

import "../../src/safety/gf256.nova"
import "../../src/safety/shamir.nova"
import "../../src/safety/saprg.nova"
import "../../src/learning/sa_crypto.nova"
import "../../src/safety/ed25519.nova"

let BSA_JSON = ""

fn _bsa_nanotime_ok() {
    let t0 = nanotime()
    let t1 = nanotime()
    if t0 == 0 {
        if t1 == 0 { return 0 }
    }
    if t1 <= t0 { return 0 }
    return 1
}

fn _bsa_insert(sorted, v) {
    push(sorted, v)
    let i = len(sorted) - 1
    while i > 0 {
        if sorted[i - 1] <= v { return 0 }
        list_set(sorted, i, sorted[i - 1])
        list_set(sorted, i - 1, v)
        i = i - 1
    }
    return 0
}

fn _bsa_report(name, sorted) {
    let n = len(sorted)
    let med = sorted[int_shr(n, 1)]
    let p99i = (n * 99) / 100
    if p99i >= n { p99i = n - 1 }
    let p99 = sorted[p99i]
    println(name + " median_ns=" + int_to_str(med) + " p99_ns=" + int_to_str(p99) + " n=" + int_to_str(n))
    if len(BSA_JSON) > 0 { BSA_JSON = BSA_JSON + "," }
    BSA_JSON = BSA_JSON + "\"" + name + "\":{\"median_ns\":" + int_to_str(med) + ",\"p99_ns\":" + int_to_str(p99) + ",\"n\":" + int_to_str(n) + "}"
    return med
}

// gf256_mul timed in batches of 1000 calls on fixed operands.
fn _bsa_gf_batch(a, b, reps) {
    let sorted = list_new()
    let r = 0
    while r < reps {
        let t0 = nanotime()
        let acc = 0
        let i = 0
        while i < 1000 {
            acc = int_xor(acc, gf256_mul(a, b))
            i = i + 1
        }
        let dt = nanotime() - t0
        _bsa_insert(sorted, dt)
        r = r + 1
    }
    return sorted
}

fn _bsa_gf_varied(reps) {
    let sorted = list_new()
    let r = 0
    while r < reps {
        let t0 = nanotime()
        let acc = 0
        let i = 0
        while i < 1000 {
            acc = int_xor(acc, gf256_mul(int_and(i * 7 + r, 255), int_and(i * 13 + 5, 255)))
            i = i + 1
        }
        let dt = nanotime() - t0
        _bsa_insert(sorted, dt)
        r = r + 1
    }
    return sorted
}

fn main() {
    if _bsa_nanotime_ok() == 0 {
        println("SKIP: nanotime not functional; bench_sa_primitives not run")
        return 0
    }
    let m00 = _bsa_report("gf256_mul_x1000_00_00", _bsa_gf_batch(0, 0, 101))
    let mff = _bsa_report("gf256_mul_x1000_ff_ff", _bsa_gf_batch(255, 255, 101))
    let m81 = _bsa_report("gf256_mul_x1000_80_01", _bsa_gf_batch(128, 1, 101))
    let mvar = _bsa_report("gf256_mul_x1000_varied", _bsa_gf_varied(101))
    println("gf256_mul ratio ff,ff / 00,00 (per mille) = " + int_to_str((mff * 1000) / m00))
    println("gf256_mul ratio varied / 00,00 (per mille) = " + int_to_str((mvar * 1000) / m00))
    let inv = list_new()
    let r = 0
    while r < 101 {
        let t0 = nanotime()
        let i = 0
        while i < 256 {
            gf256_inv(i)
            i = i + 1
        }
        _bsa_insert(inv, nanotime() - t0)
        r = r + 1
    }
    _bsa_report("gf256_inv_x256", inv)

    let ctx = list_new()
    rng_test_new(ctx, cc_hex_decode("62656e6368")[0], 5)
    let secret = cc_hex_decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")[0]
    let split = list_new()
    let comb = list_new()
    r = 0
    while r < 51 {
        let t0 = nanotime()
        let sh = shamir_split(ctx, secret, 32, 3, 5)
        _bsa_insert(split, nanotime() - t0)
        let pick = list_new()
        push(pick, sh[0])
        push(pick, sh[2])
        push(pick, sh[4])
        let t1 = nanotime()
        shamir_combine(pick, 32)
        _bsa_insert(comb, nanotime() - t1)
        r = r + 1
    }
    _bsa_report("shamir_split_32B_t3_n5", split)
    _bsa_report("shamir_combine_32B_3", comb)
    let split100 = list_new()
    r = 0
    while r < 5 {
        let t0 = nanotime()
        shamir_split(ctx, secret, 32, 67, 100)
        _bsa_insert(split100, nanotime() - t0)
        r = r + 1
    }
    _bsa_report("shamir_split_32B_t67_n100", split100)

    let prg = list_new()
    r = 0
    while r < 11 {
        let t0 = nanotime()
        saprg_expand(secret, 10000)
        _bsa_insert(prg, nanotime() - t0)
        r = r + 1
    }
    _bsa_report("saprg_expand_10000_words", prg)

    let p1 = alloc(33)
    let q1 = alloc(33)
    let p2 = alloc(33)
    let q2 = alloc(33)
    let kg = list_new()
    r = 0
    while r < 11 {
        let t0 = nanotime()
        sac_x25519_keygen(ctx, p1, q1)
        _bsa_insert(kg, nanotime() - t0)
        r = r + 1
    }
    _bsa_report("sac_x25519_keygen", kg)
    sac_x25519_keygen(ctx, p2, q2)
    let ag = list_new()
    let key = 0
    r = 0
    while r < 11 {
        let t0 = nanotime()
        key = sac_enc_key(p1, q2, 1, 1, 2)[0]
        _bsa_insert(ag, nanotime() - t0)
        r = r + 1
    }
    _bsa_report("sac_enc_key", ag)
    let pt = cc_hex_decode("0000000100000002000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let seal = list_new()
    let open = list_new()
    r = 0
    while r < 51 {
        let t0 = nanotime()
        let w = sac_share_seal(key, 1, 1, 2, pt[0], pt[1])
        _bsa_insert(seal, nanotime() - t0)
        let t1 = nanotime()
        sac_share_open(key, 1, 1, 2, w[0], w[1])
        _bsa_insert(open, nanotime() - t1)
        r = r + 1
    }
    _bsa_report("sac_share_seal_72B", seal)
    _bsa_report("sac_share_open_72B", open)
    let pk = list_new()
    let seed = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    r = 0
    while r < 3 {
        let t0 = nanotime()
        ed25519_pk_from_seed(seed)
        _bsa_insert(pk, nanotime() - t0)
        r = r + 1
    }
    _bsa_report("ed25519_pk_from_seed", pk)
    println("{\"schema\":\"crossengin-bench-v1\",\"suite\":\"sa_primitives\",\"results\":{" + BSA_JSON + "}}")
    return 0
}

main()
