// CrossEngin benchmark: substrate tick rate.
//
// Purpose
//   Phase-boundary performance check (ADR-0049, master-plan rule 11). Measures
//   how many substrate ticks per wall-clock second the tick driver sustains,
//   for a single part and for the full seven-part fixed substrate. NOVA exposes
//   only a second-resolution clock (time()), so each configuration runs enough
//   ticks to span a few seconds, and the rate is reported as ops / elapsed.
//
//   ADR-0001 targets a 100Hz tick. This benchmark establishes the headroom of
//   the current scalar driver; SIMD-batched propagation (NOVA enhancement #4)
//   and the real 100Hz wall-clock pacer (enhancement #5, ADR-0037) build on it.
//
// CrossEngin dependencies: src/substrate/tick_driver.nova (full substrate).

import "../../src/substrate/tick_driver.nova"

fn safe_div(a, b) {
    if b <= 0 { return a }
    return a / b
}

// Wire a short feedforward chain among the first nodes of a part so each tick
// does representative integrate + propagate + plasticity work.
fn wire_chain(part, n) {
    let g = part_syn(part)
    let i = 0
    while i < n - 1 {
        syn_new(g, i, i + 1, 800, 0)
        i = i + 1
    }
}

fn bench_single_part(ticks) {
    let reg = part_registry_new()
    registry_add(reg, "p", FN_PRESET_REASONING, 64, 16)
    let part = registry_get(reg, 0)
    wire_chain(part, 8)
    let pool = part_pool(part)
    let e = td_engine_new(reg)
    let t0 = time()
    let i = 0
    while i < ticks {
        npm_node_input(pool, 0, 700)   // keep the chain firing
        td_step(e, TD_MOD_NEUTRAL, 0)
        i = i + 1
    }
    let elapsed = time() - t0
    println("single part (64 nodes):")
    println("  ticks            : " + int_to_str(ticks))
    println("  elapsed (s)      : " + int_to_str(elapsed))
    println("  ticks/sec        : " + int_to_str(safe_div(ticks, elapsed)))
}

fn bench_full_substrate(steps) {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 16)
    let perception = registry_find(reg, "perception")
    let pool = part_pool(registry_get(reg, perception))
    let e = td_engine_new(reg)
    let t0 = time()
    let i = 0
    while i < steps {
        npm_node_input(pool, 0, 700)
        td_step(e, TD_MOD_NEUTRAL, 0)   // ticks all 7 parts
        i = i + 1
    }
    let elapsed = time() - t0
    let part_ticks = steps * 7
    println("full substrate (7 parts x 64 nodes):")
    println("  steps            : " + int_to_str(steps))
    println("  part-ticks       : " + int_to_str(part_ticks))
    println("  elapsed (s)      : " + int_to_str(elapsed))
    println("  steps/sec        : " + int_to_str(safe_div(steps, elapsed)))
    println("  part-ticks/sec   : " + int_to_str(safe_div(part_ticks, elapsed)))
}

fn main() {
    println("=== CrossEngin benchmark: tick rate ===")
    bench_single_part(60000)
    println("")
    bench_full_substrate(5000)
    println("benchmark complete")
}

main()
