// CrossEngin benchmark: self-improvement across sessions (P5, ADR-0055).
//
// Acceptance: the agent improves a task metric across sessions using only its
// own logged experience -- no human teaching. On a deterministic 5x5 grid
// world, the agent acts, logs each (state, action, reward, next-state)
// transition, and updates a value estimate from it. We report the greedy-policy
// return before any learning vs after, and the per-session metric trend. A
// positive improvement (ideally reaching the optimal path) is the bar.
//
// CrossEngin dependencies: self_improve (-> world_model).

import "std/io"
import "../../src/parts/meta/self_improve.nova"

fn main() {
    let world = world_new(5, 5, 0, 0, 4, 4)
    let opt = world_optimal_steps(world)
    let q = q_new(world_n_states(world), world_actions(), 0)

    let before = si_eval(world, q, 200)
    let totals = si_train(world, q, 80, 200, 2024)
    let after = si_eval(world, q, 200)

    println("  --- self-improvement on a 5x5 grid (optimal " + int_to_str(opt) + " steps) ---")
    println("  untrained greedy return : " + int_to_str(before[0]) + "  (steps " + int_to_str(before[1]) + ")")
    println("  trained   greedy return : " + int_to_str(after[0]) + "  (steps " + int_to_str(after[1]) + ")")
    println("  improvement             : " + int_to_str(after[0] - before[0]))
    println("  metric trend (greedy return per session):")
    println("    s1="  + int_to_str(totals[0]) +
            "  s20=" + int_to_str(totals[19]) +
            "  s40=" + int_to_str(totals[39]) +
            "  s80=" + int_to_str(totals[79]))
    if after[1] == opt {
        println("  RESULT: learned the OPTIMAL path from its own logged experience (no teaching)")
    } else { if after[0] > before[0] {
        println("  RESULT: improved (near-optimal) from its own experience")
    } else {
        println("  RESULT: NO improvement (regression!)")
    } }
    println("benchmark complete")
}

main()
