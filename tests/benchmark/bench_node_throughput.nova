// CrossEngin benchmark: node throughput.
//
// Purpose
//   Phase-boundary performance check (ADR-0049, master-plan rule 11). Measures
//   how many node-kernel integrations per wall-clock second the substrate
//   sustains when a part is fully populated (every slot a live node). This is
//   the raw cost of the uniform kernel (leaky integrate + threshold fire +
//   novelty) across a dense pool.
//
//   ADR-0006 targets 1M nodes/part; the per-node cost measured here is what
//   NOVA enhancement #1 (1M+ arenas) and #4 (SIMD batched propagation) must
//   scale. The number reported is integrations/sec on the current scalar path.
//
// CrossEngin dependencies: src/substrate/tick_driver.nova.

import "../../src/substrate/tick_driver.nova"

fn safe_div(a, b) {
    if b <= 0 { return a }
    return a / b
}

fn main() {
    println("=== CrossEngin benchmark: node throughput ===")
    let capacity = 96
    let ticks = 8000

    let reg = part_registry_new()
    registry_add(reg, "dense", FN_PRESET_KG, capacity, 8)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)

    // Fill every remaining slot with a live node and give a sparse ring of
    // synapses so propagation does work too.
    while npm_available(pool) > 0 {
        npm_node_create_default(pool, NTYPE_KNOWER)
    }
    let live = npm_live_count(pool)
    let i = 0
    while i < live - 1 {
        syn_new(g, i, i + 1, 300, 0)
        i = i + 1
    }

    let e = td_engine_new(reg)
    let t0 = time()
    let k = 0
    while k < ticks {
        npm_node_input(pool, 0, 700)
        td_step(e, TD_MOD_NEUTRAL, 0)
        k = k + 1
    }
    let elapsed = time() - t0
    let integrations = live * ticks

    println("  live nodes        : " + int_to_str(live))
    println("  ticks             : " + int_to_str(ticks))
    println("  node-integrations : " + int_to_str(integrations))
    println("  elapsed (s)       : " + int_to_str(elapsed))
    println("  integrations/sec  : " + int_to_str(safe_div(integrations, elapsed)))
    println("benchmark complete")
}

main()
