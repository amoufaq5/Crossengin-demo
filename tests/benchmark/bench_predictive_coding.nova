// CrossEngin benchmark: predictive-coding loop reduces prediction error (P2).
//
// Acceptance (ADR-0052): a predict -> error -> reward loop measurably reduces
// prediction error over N ticks on a synthetic repeating moment sequence.
//
// Setup. A deterministic period-3 cycle of 3-node moments repeats for N ticks.
// An adaptive (delta-rule, gradient-free) predictor keyed on a signature of the
// PREVIOUS moment predicts each node's next value. We track the mean absolute
// prediction error in the first window of ticks vs the last window, and report
// the reduction. To exercise the full loop, the per-tick prediction error also
// drives a neuromodulator (pc_neuromod_scalar) that gates three-factor synapse
// plasticity, so we additionally report that a synapse's weight settles as the
// error (and thus the surprise-amplified neuromodulator) shrinks.
//
// CrossEngin dependencies: predictive_coding_runtime + synapse_graph.

import "std/io"
import "../../src/learning/predictive_coding_runtime.nova"
import "../../src/substrate/synapse_graph.nova"

// the repeating cycle of moments (each a 3-node activation vector, milli).
fn _moment(phase) {
    let m = list_new()
    if phase == 0 { push(m, 200); push(m, 900); push(m, 100) }
    if phase == 1 { push(m, 500); push(m, 100); push(m, 800) }
    if phase == 2 { push(m, 800); push(m, 400); push(m, 300) }
    return m
}

// context key = a signature of the previous moment (its node-0 bucket); on a
// deterministic cycle this uniquely identifies the predecessor, so the
// predictor can learn the transition to the successor.
fn _ctx(prev_n0) {
    if prev_n0 < 350 { return 0 }
    if prev_n0 < 650 { return 1 }
    return 2
}

fn _abs(x) { if x < 0 { return 0 - x } return x }

fn main() {
    let N = 150
    let nodes = 3
    let p = pc_pred_new()

    // a synapse driven by the loop: pre/post co-fire each tick, the prediction
    // error sets the neuromodulator.
    let g = syn_graph_new()
    let syn = syn_new(g, 0, 1, 0, 0)

    let prev_n0 = 200            // pretend tick -1 was phase 0
    let win = 10
    let first_sum = 0
    let last_sum = 0
    let t = 0
    while t < N {
        let phase = t % 3
        let m = _moment(phase)
        let ctx = _ctx(prev_n0)

        // 1. PREDICT + measure error against the observation
        let terr = 0
        let n = 0
        while n < nodes {
            terr = terr + _abs(pc_pred_error(p, ctx, n, m[n], 1000))
            n = n + 1
        }
        if t < win { first_sum = first_sum + terr }
        if t >= N - win { last_sum = last_sum + terr }

        // 2. LEARN: nudge each prediction toward the observation
        let n2 = 0
        while n2 < nodes { pc_pred_learn(p, ctx, n2, m[n2], 300); n2 = n2 + 1 }

        // 3. REWARD/plasticity: error-amplified neuromodulator gates the
        //    three-factor synapse update (co-fire this tick, then modulate).
        syn_coactivate(g, syn, t, t)
        let surprise = 0
        if terr > 300 { surprise = 300 }
        let nm = pc_neuromod_scalar(400, terr, surprise)
        syn_neuromodulate(g, nm)
        syn_decay_eligibility(g)

        prev_n0 = m[0]
        t = t + 1
    }

    let first_mean = first_sum / win
    let last_mean = last_sum / win
    let reduction = 0
    if first_mean > 0 { reduction = (first_mean - last_mean) * 100 / first_mean }

    println("  --- predictive coding loop (N=" + int_to_str(N) + " ticks, period-3 cycle) ---")
    println("  mean |error| first " + int_to_str(win) + " ticks : " + int_to_str(first_mean))
    println("  mean |error| last  " + int_to_str(win) + " ticks : " + int_to_str(last_mean))
    println("  error reduction                : " + int_to_str(reduction) + "%")
    println("  final synapse weight (3-factor): " + int_to_str(syn_weight(g, syn)))
    if last_mean < first_mean {
        println("  RESULT: prediction error decreased over the run (loop is learning)")
    } else {
        println("  RESULT: NO error reduction (regression!)")
    }
    println("benchmark complete")
}

main()
