// Unit tests for src/io/transducers/whisper_backend.nova (R8B).
//
// Hermetic coverage of the whisper.cpp backend's error-path semantics
// + transcript-cleanup logic + env-resolver behavior. The
// success-path (real whisper-main against a real WAV) requires the
// installed binary + model and is exercised by the integration
// scenario `tests/integration/scenario_jj_whisper.sh`, which SKIPs
// gracefully when whisper is not installed.
//
// Assertion targets (the brief asks for ~15-20):
//   * whisper_resolve_bin / whisper_resolve_model fall back to canonical
//     defaults when CE_WHISPER_BIN / CE_WHISPER_MODEL are unset.
//   * whisper_backend_available returns 0 when bin / model is missing.
//   * whisper_transcribe with a missing bin returns
//     error="binary not found", transcript="", confidence=0.
//   * whisper_transcribe with a missing model returns
//     error="model not found".
//   * whisper_transcribe with a missing wav returns "wav not found"
//     (after bin + model exist).
//   * whisper_clean_transcript trims leading/trailing whitespace,
//     collapses newlines to spaces, dedups runs of spaces.
//   * whisper_result_* accessors return the matching tuple slots.
//   * stt_seam dispatch through STT_BACKEND_WHISPER routes to the
//     whisper backend (verified via the "model not found" error
//     surfacing on the seam's last_error).

import "../ce_test.nova"
import "../../src/io/transducers/whisper_backend.nova"
import "../../src/io/transducers/stt_seam.nova"

// ---- env-resolver fallback paths ------------------------------------------

fn test_resolve_bin_defaults_to_canonical_path() {
    // The resolver returns WHISPER_DEFAULT_BIN when CE_WHISPER_BIN is
    // unset / empty, or the env value otherwise. The test tolerates
    // BOTH outcomes so it doesn't fail under integration scenarios
    // that export an override.
    let path = whisper_resolve_bin()
    let env = getenv("CE_WHISPER_BIN")
    if env == 0 {
        ce_str_eq("resolve_bin defaults to canonical path when env unset",
                  path, "/usr/local/bin/whisper-main")
    } else {
        if len(env) == 0 {
            ce_str_eq("resolve_bin defaults to canonical path when env empty",
                      path, "/usr/local/bin/whisper-main")
        } else {
            ce_str_eq("resolve_bin returns env override when set",
                      path, env)
        }
    }
}

fn test_resolve_model_defaults_to_canonical_path() {
    let path = whisper_resolve_model()
    let env = getenv("CE_WHISPER_MODEL")
    if env == 0 {
        ce_str_eq("resolve_model defaults to canonical path when env unset",
                  path, "/usr/local/share/whisper/ggml-tiny.en.bin")
    } else {
        if len(env) == 0 {
            ce_str_eq("resolve_model defaults to canonical path when env empty",
                      path, "/usr/local/share/whisper/ggml-tiny.en.bin")
        } else {
            ce_str_eq("resolve_model returns env override when set",
                      path, env)
        }
    }
}

// ---- availability probe ---------------------------------------------------

fn test_available_returns_zero_for_missing_bin() {
    // Definitely-not-a-file for both args -> availability=0.
    let ok = whisper_backend_available(
        "/tmp/ce_whisper_bin_does_not_exist_xyz_r8b",
        "/tmp/ce_whisper_model_does_not_exist_xyz_r8b")
    ce_eq("backend_available(missing, missing) -> 0", ok, 0)
}

fn test_available_returns_zero_for_missing_model_only() {
    // Use a file we know exists (the test source itself) as the "bin"
    // and a known-missing path as the model. Should be 0.
    let ok = whisper_backend_available(
        "/home/user/Crossengin-demo/tests/unit/test_whisper_backend.nova",
        "/tmp/ce_whisper_model_does_not_exist_xyz_r8b")
    ce_eq("backend_available(real, missing) -> 0", ok, 0)
}

fn test_available_returns_one_when_both_files_exist() {
    // Both args point to existing files (the test source as a stand-in
    // for both). The probe only checks openable-ness; it does NOT
    // verify executability or magic bytes. Should be 1.
    let path = "/home/user/Crossengin-demo/tests/unit/test_whisper_backend.nova"
    let ok = whisper_backend_available(path, path)
    ce_eq("backend_available(real, real) -> 1", ok, 1)
}

// ---- transcribe error paths -----------------------------------------------

fn test_transcribe_reports_binary_not_found() {
    // Both bin + model + wav don't exist. The pre-flight checks fire
    // in order: bin first, so we should see "binary not found".
    let r = whisper_transcribe(
        "/tmp/ce_whisper_bin_missing_r8b",
        "/tmp/ce_whisper_model_missing_r8b",
        "/tmp/ce_whisper_wav_missing_r8b")
    ce_str_eq("missing bin -> error='binary not found'",
              whisper_result_error(r), "binary not found")
    ce_str_eq("missing bin -> transcript=''",
              whisper_result_transcript(r), "")
    ce_eq("missing bin -> confidence=0",
          whisper_result_confidence(r), 0)
}

fn test_transcribe_reports_model_not_found() {
    // Bin exists, model + wav don't. The second pre-flight check
    // should fire: "model not found".
    let real = "/home/user/Crossengin-demo/tests/unit/test_whisper_backend.nova"
    let r = whisper_transcribe(
        real,
        "/tmp/ce_whisper_model_missing_r8b",
        "/tmp/ce_whisper_wav_missing_r8b")
    ce_str_eq("missing model -> error='model not found'",
              whisper_result_error(r), "model not found")
    ce_str_eq("missing model -> transcript=''",
              whisper_result_transcript(r), "")
}

fn test_transcribe_reports_wav_not_found() {
    // Bin + model exist, wav doesn't. Third pre-flight: "wav not found".
    let real = "/home/user/Crossengin-demo/tests/unit/test_whisper_backend.nova"
    let r = whisper_transcribe(
        real,
        real,
        "/tmp/ce_whisper_wav_missing_r8b")
    ce_str_eq("missing wav -> error='wav not found'",
              whisper_result_error(r), "wav not found")
}

// ---- transcript cleanup ---------------------------------------------------

fn test_clean_transcript_trims_leading_trailing() {
    let cleaned = whisper_clean_transcript("   hello world   ")
    ce_str_eq("trim leading/trailing whitespace", cleaned, "hello world")
}

fn test_clean_transcript_handles_newlines() {
    // whisper-cli with -nt -np typically emits "<space><text>\n" or
    // multi-segment "<text>\n<text>\n". The cleaner collapses \n -> ' '
    // then trims.
    let cleaned = whisper_clean_transcript(" hello world\n")
    ce_str_eq("strip trailing newline + leading space",
              cleaned, "hello world")
    let multi = whisper_clean_transcript("line one\nline two\n")
    ce_str_eq("collapse internal newline to space",
              multi, "line one line two")
}

fn test_clean_transcript_dedups_spaces() {
    let cleaned = whisper_clean_transcript("a   b\n\nc")
    ce_str_eq("dedup runs of spaces", cleaned, "a b c")
}

fn test_clean_transcript_handles_empty() {
    let cleaned = whisper_clean_transcript("")
    ce_str_eq("empty input -> empty output", cleaned, "")
    let blanks = whisper_clean_transcript("   \n\n  \r\n")
    ce_str_eq("all-whitespace input -> empty output", blanks, "")
}

// ---- result-tuple accessors ----------------------------------------------

fn test_result_accessors() {
    // Drive a known error case so we have a deterministic triple.
    let r = whisper_transcribe(
        "/tmp/ce_whisper_bin_missing_r8b",
        "/tmp/ce_whisper_model_missing_r8b",
        "/tmp/ce_whisper_wav_missing_r8b")
    ce_check("result is a 3-element list", len(r) == 3)
    ce_str_eq("whisper_result_transcript accessor",
              whisper_result_transcript(r), "")
    ce_eq("whisper_result_confidence accessor",
          whisper_result_confidence(r), 0)
    ce_str_eq("whisper_result_error accessor",
              whisper_result_error(r), "binary not found")
}

// ---- stt_seam round-trip through whisper backend --------------------------
//
// The seam's STT_BACKEND_WHISPER dispatch routes to
// _stt_backend_whisper which calls whisper_transcribe_default. Without
// CE_WHISPER_BIN set, the resolver returns the canonical default;
// we don't know whether whisper-main is installed in the test
// environment, so the assertion tolerates BOTH outcomes:
//   * if whisper is installed but the wav is missing -> seam reports
//     last_error="wav not found", transcript=stub placeholder.
//   * if whisper is not installed                    -> seam reports
//     last_error="binary not found", transcript=stub placeholder.
// Either way the transcript slot has the stub placeholder and the
// error slot starts with "b" or "w" -- exactly the contract.

fn test_seam_dispatches_to_whisper_on_missing_wav() {
    let s = stt_seam_new()
    stt_seam_set_default(s, 4)            // STT_BACKEND_WHISPER
    let r = stt_transcribe_wav(s, "/tmp/ce_seam_wav_missing_xyz_r8b.wav")
    let t = stt_result_transcript(r)
    let c = stt_result_confidence(r)
    let e = stt_result_error(r)
    // Transcript is always the stub placeholder on a whisper error.
    ce_str_eq("seam whisper error -> stub placeholder transcript",
              t, "[stt unavailable]")
    ce_eq("seam whisper error -> confidence 0", c, 0)
    // Error message has length > 0 and starts with 'b' (binary) or 'w' (wav).
    let n = len(e)
    ce_check("seam whisper error -> error string non-empty", n > 0)
    let first = char_at(e, 0)
    let ok = 0
    if first == 98  { ok = 1 }     // 'b' (binary not found)
    if first == 119 { ok = 1 }     // 'w' (wav not found)
    if first == 109 { ok = 1 }     // 'm' (model not found)
    if first == 101 { ok = 1 }     // 'e' (empty transcript -- rare here)
    ce_check("seam whisper error starts with b/w/m/e", ok == 1)
}

fn test_seam_new_whisper_constructor_pins_default() {
    let s = stt_seam_new_whisper("/usr/local/share/whisper/ggml-tiny.en.bin")
    ce_eq("stt_seam_new_whisper default backend = WHISPER",
          stt_seam_default_backend(s), 4)
    ce_str_eq("stt_seam_new_whisper backend name = 'whisper'",
              stt_seam_backend_name(s), "whisper")
}

fn test_seam_whisper_constant_value() {
    // The seam exposes STT_BACKEND_WHISPER as a constant. We can read it
    // through the registry: name "whisper" -> id 4.
    let s = stt_seam_new()
    let id = stt_seam_backend_id_for(s, "whisper")
    ce_eq("'whisper' name -> id 4", id, 4)
}

// ---- R10B: confidence parsing assertions ---------------------------------
//
// The whisper backend now parses `-ojf` JSON output for per-token
// probabilities and averages them into a real per-utterance milli
// confidence. The parser is exposed publicly as
// `whisper_parse_confidence_milli(json_body)`; tests can exercise it
// against synthesized fixtures without spawning whisper-main.

// _whisper_p_token_fixture(p_str) -- assemble a minimal JSON token with
// a given `"p": <p_str>` field. The parser only looks for `"p":` so
// we don't need a full transcription tree -- just a few tokens.
fn _whisper_p_token_fixture(p_str) {
    return "{\"text\":\" hi\",\"p\":" + p_str + ",\"t_dtw\":-1}"
}

fn test_confidence_parser_single_high_p() {
    // One token with p=0.97311 -> milli should be 973.
    let body = "{\"transcription\":[{\"tokens\":["
        + _whisper_p_token_fixture("0.97311")
        + "]}]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("single p=0.97311 -> 973 milli", milli, 973)
}

fn test_confidence_parser_single_low_p() {
    // One token with p=0.12345 -> milli should be 123.
    let body = "{\"transcription\":[{\"tokens\":["
        + _whisper_p_token_fixture("0.12345")
        + "]}]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("single p=0.12345 -> 123 milli", milli, 123)
}

fn test_confidence_parser_average_of_two_tokens() {
    // Two tokens p=0.900, p=0.800 -> avg=0.850 -> 850 milli.
    let body = "{\"transcription\":[{\"tokens\":["
        + _whisper_p_token_fixture("0.900")
        + ","
        + _whisper_p_token_fixture("0.800")
        + "]}]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("avg(0.900, 0.800) -> 850 milli", milli, 850)
}

fn test_confidence_parser_handles_integer_one() {
    // p=1 (no fractional part) clamps to 1000.
    let body = "{\"tokens\":[" + _whisper_p_token_fixture("1") + "]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("p=1 -> 1000 milli", milli, 1000)
}

fn test_confidence_parser_handles_integer_zero() {
    // p=0 -> 0 milli.
    let body = "{\"tokens\":[" + _whisper_p_token_fixture("0") + "]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("p=0 -> 0 milli", milli, 0)
}

fn test_confidence_parser_no_tokens() {
    // JSON with no "p":... fields -> -1 (no tokens, parser failure
    // signal). The caller falls back to the 800-milli legacy path.
    let body = "{\"systeminfo\":\"...\",\"model\":{\"type\":\"tiny\"}}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("no p:.. -> -1 (parser sentinel)", milli, -1)
}

fn test_confidence_parser_empty_body() {
    let milli = whisper_parse_confidence_milli("")
    ce_eq("empty body -> -1", milli, -1)
}

fn test_confidence_parser_handles_whitespace_after_colon() {
    // The JSON writer might emit `"p": 0.500` (space after colon). The
    // parser tolerates leading whitespace before the number.
    let body = "{\"tokens\":[{\"p\": 0.500}]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("whitespace after colon parsed -> 500 milli", milli, 500)
}

fn test_confidence_parser_average_high_low() {
    // Three tokens: 0.999, 0.800, 0.600 -> avg=0.799666... -> 799 milli.
    // (Sum = 999 + 800 + 600 = 2399 milli; avg = 799 integer division.)
    let body = "{\"tokens\":["
        + _whisper_p_token_fixture("0.999") + ","
        + _whisper_p_token_fixture("0.800") + ","
        + _whisper_p_token_fixture("0.600")
        + "]}"
    let milli = whisper_parse_confidence_milli(body)
    ce_eq("avg(0.999, 0.800, 0.600) -> 799 milli", milli, 799)
}

fn test_confidence_with_confidence_default_path_error_codes() {
    // The confidence-aware transcribe variant surfaces the same precise
    // error codes as the legacy variant. With missing bin -> "binary not
    // found".
    let r = whisper_transcribe_with_confidence(
        "/tmp/ce_whisper_bin_missing_r10b",
        "/tmp/ce_whisper_model_missing_r10b",
        "/tmp/ce_whisper_wav_missing_r10b")
    ce_str_eq("with_confidence: missing bin -> 'binary not found'",
              whisper_result_error(r), "binary not found")
    ce_eq("with_confidence: missing bin -> confidence=0",
          whisper_result_confidence(r), 0)
}

fn test_confidence_with_confidence_default_resolves_env() {
    // The env-resolved convenience wrapper should not crash even when
    // both bin + model are missing; it should surface "binary not found"
    // (because the default canonical bin path is /usr/local/bin/whisper-main
    // which may or may not exist -- the test tolerates either failure
    // code as long as the result is well-formed).
    let r = whisper_transcribe_with_confidence_default(
        "/tmp/ce_with_conf_wav_missing_r10b.wav")
    ce_check("with_confidence_default: result is a 3-element list",
             len(r) == 3)
    // Either confidence=0 + non-empty error (file missing path), OR
    // confidence>0 + empty error (succeeds against a real WAV -- not
    // expected here because the WAV path doesn't exist; we tolerate
    // both shapes defensively).
    let err = whisper_result_error(r)
    let confv = whisper_result_confidence(r)
    let well_formed = 0
    if len(err) > 0 {
        if confv == 0 { well_formed = 1 }
    }
    if len(err) == 0 {
        if confv >= 0 {
            if confv <= 1000 { well_formed = 1 }
        }
    }
    ce_check("with_confidence_default: well-formed triple",
             well_formed == 1)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_resolve_bin_defaults_to_canonical_path()
    test_resolve_model_defaults_to_canonical_path()
    test_available_returns_zero_for_missing_bin()
    test_available_returns_zero_for_missing_model_only()
    test_available_returns_one_when_both_files_exist()
    test_transcribe_reports_binary_not_found()
    test_transcribe_reports_model_not_found()
    test_transcribe_reports_wav_not_found()
    test_clean_transcript_trims_leading_trailing()
    test_clean_transcript_handles_newlines()
    test_clean_transcript_dedups_spaces()
    test_clean_transcript_handles_empty()
    test_result_accessors()
    test_seam_dispatches_to_whisper_on_missing_wav()
    test_seam_new_whisper_constructor_pins_default()
    test_seam_whisper_constant_value()
    // R10B confidence-parser assertions (~10):
    test_confidence_parser_single_high_p()
    test_confidence_parser_single_low_p()
    test_confidence_parser_average_of_two_tokens()
    test_confidence_parser_handles_integer_one()
    test_confidence_parser_handles_integer_zero()
    test_confidence_parser_no_tokens()
    test_confidence_parser_empty_body()
    test_confidence_parser_handles_whitespace_after_colon()
    test_confidence_parser_average_high_low()
    test_confidence_with_confidence_default_path_error_codes()
    test_confidence_with_confidence_default_resolves_env()
    ce_summary("whisper_backend")
}

main()
