// Unit tests for the R111 `self.override.list` audit read-back verb.
//
// Exercises: cap gate (reader-tier), empty registry, holder filter (default
// scoping to presented_holder, admin override), action filter, R107
// pagination (limit + after + next_after).

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/parts/meta/override_wire.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}
fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// Fabricate a fresh ctx + override registry with 6 canned entries.
// alice has 3, bob has 2, "" (anonymous) has 1. Actions span 4 kinds.
fn _mk_ctx_seeded() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = ovw_new()
    rpc_ctx_set_override_reg(ctx, reg)
    ovw_record(reg, OVW_ACT_HARD_STOP,   "{}", "alice", 0, 0, 0, "",    1000)
    ovw_record(reg, OVW_ACT_RESUME,      "{}", "alice", 0, 0, 0, "",    2000)
    ovw_record(reg, OVW_ACT_BELIEF_EDIT, "{\"atom_label\":\"mars\"}",
                                            "alice", 100, 100, 0, "mars", 3000)
    ovw_record(reg, OVW_ACT_HARD_STOP,   "{}", "bob",   0, 0, 0, "",    4000)
    ovw_record(reg, OVW_ACT_KILL_SWITCH, "{\"clean\":1}",
                                            "bob",   0, 0, 0, "",    5000)
    ovw_record(reg, OVW_ACT_GOAL_VETO,   "{\"goal_id\":0}",
                                            "",      0, 0, 0, "",    6000)
    let out = list_new()
    push(out, ctx)
    push(out, reg)
    return out
}

// ---- no-registry refusal ----------------------------------------------

fn test_no_registry_refuses() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("self.override.list", list_new(), ctx)
    ce_check("ok:false",       _has(out, "\"ok\":false"))
    ce_check("names missing",  _has(out, "no override registry"))
}

// ---- default scoping to presented_holder ------------------------------

fn test_default_scope_anonymous() {
    // Sandbox off + no presented token -> holder="".
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override.list", list_new(), ctx)
    ce_check("ok",                 _has(out, "\"ok\":true"))
    ce_check("holder empty",       _has(out, "\"holder\":\"\""))
    ce_check("count=1",            _has(out, "\"count\":1"))
    ce_check("has goal_veto",      _has(out, "\"action\":\"goal_veto\""))
    ce_check("no alice actions",   _has(out, "\"action\":\"hard_stop\"") == 0)
    ce_check("next_after empty",   _has(out, "\"next_after\":\"\""))
}

// ---- action filter ---------------------------------------------------

fn test_filter_by_action() {
    // Admin token so we can target alice.
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    let out = rpc_dispatch("self.override.list",
        _args2("holder", "alice", "action", "hard_stop"), ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("count=1",           _has(out, "\"count\":1"))
    ce_check("only hard_stop",    _has(out, "\"action\":\"hard_stop\""))
    ce_check("no resume",         _has(out, "\"action\":\"resume\"") == 0)
    ce_check("no belief_edit",    _has(out, "\"action\":\"belief_edit\"") == 0)
}

fn test_unknown_action_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override.list",
        _args1("action", "detonate"), ctx)
    ce_check("ok:false",  _has(out, "\"ok\":false"))
    ce_check("names bad", _has(out, "detonate"))
}

// ---- holder override cap gate ----------------------------------------

fn test_reader_cross_holder_refused() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "carol", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    // carol asks for alice -> refused with admin:sandbox.
    let out = rpc_dispatch("self.override.list",
        _args1("holder", "alice"), ctx)
    ce_check("ok:false",         _has(out, "\"ok\":false"))
    ce_check("names admin",      _has(out, "admin:sandbox"))
}

fn test_reader_self_holder_ok() {
    // carol asks for carol -> allowed (no admin cap needed).
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "carol", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    let out = rpc_dispatch("self.override.list",
        _args1("holder", "carol"), ctx)
    ce_check("ok",           _has(out, "\"ok\":true"))
    ce_check("count=0",      _has(out, "\"count\":0"))
}

fn test_admin_can_target_any_holder() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    let out = rpc_dispatch("self.override.list",
        _args1("holder", "alice"), ctx)
    ce_check("ok",         _has(out, "\"ok\":true"))
    ce_check("count=3",    _has(out, "\"count\":3"))
    ce_check("has resume", _has(out, "\"action\":\"resume\""))
}

// ---- pagination (R107) ------------------------------------------------

fn test_pagination_limits() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    let out = rpc_dispatch("self.override.list",
        _args2("holder", "alice", "limit", "2"), ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("count=2",           _has(out, "\"count\":2"))
    // Alice's first entry is override_id=1 (hard_stop), second is
    // override_id=2 (resume). limit=2 emits ids 1 + 2, next_after="2".
    ce_check("next_after=2",      _has(out, "\"next_after\":\"2\""))
    // Second page starts after cursor "2".
    let out2 = rpc_dispatch("self.override.list",
        _args2("holder", "alice", "after", "2"), ctx)
    ce_check("p2 ok",              _has(out2, "\"ok\":true"))
    ce_check("p2 count=1",         _has(out2, "\"count\":1"))
    ce_check("p2 belief_edit",     _has(out2, "\"action\":\"belief_edit\""))
    ce_check("p2 tail next=''",    _has(out2, "\"next_after\":\"\""))
}

fn test_pagination_empty_registry() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_override_reg(ctx, ovw_new())
    let out = rpc_dispatch("self.override.list", list_new(), ctx)
    ce_check("empty ok",       _has(out, "\"ok\":true"))
    ce_check("empty count=0",  _has(out, "\"count\":0"))
    ce_check("empty entries=[]", _has(out, "\"entries\":[]"))
    ce_check("empty next=''",  _has(out, "\"next_after\":\"\""))
}

// ---- entry shape ------------------------------------------------------

fn test_entry_shape() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override.list", list_new(), ctx)
    ce_check("has override_id",         _has(out, "\"override_id\":"))
    ce_check("has timestamp",           _has(out, "\"timestamp\":"))
    ce_check("has holder",              _has(out, "\"holder\":"))
    ce_check("has action",              _has(out, "\"action\":"))
    ce_check("has args_json",           _has(out, "\"args_json\":"))
    ce_check("has snapshot_captured",   _has(out, "\"snapshot_captured\":"))
    ce_check("has undone",              _has(out, "\"undone\":"))
}

// ---- cap gate --------------------------------------------------------

fn test_cap_required_is_nl_self_read() {
    ce_check("list requires nl:self:read",
        str_eq_bytes(capability_verb_required("self.override.list"),
                     CAP_NL_SELF_READ) == 1)
}

// ---- verb registered in names ---------------------------------------

fn test_verb_in_names() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "self.override.list") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("self.override.list registered", saw, 1)
}

// ---- main -----------------------------------------------------------

fn main() {
    test_no_registry_refuses()
    test_default_scope_anonymous()
    test_filter_by_action()
    test_unknown_action_refuses()
    test_reader_cross_holder_refused()
    test_reader_self_holder_ok()
    test_admin_can_target_any_holder()
    test_pagination_limits()
    test_pagination_empty_registry()
    test_entry_shape()
    test_cap_required_is_nl_self_read()
    test_verb_in_names()
    ce_summary("self_override_list_verb")
    return 0
}

main()
