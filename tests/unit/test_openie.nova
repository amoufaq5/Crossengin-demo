// Unit tests for src/learning/openie.nova (P3, ADR-0053).
//
// OpenIE discovers the predicate (keeps the verb itself as the relation) and
// captures prepositional tails as n-ary arguments, beating the fixed 6-relation
// extractor. Covered: SVO with a discovered verb + temporal arg, article
// dropping, intransitive verb with a prepositional argument, copula -> is_a,
// multi-argument event structure, negation rejection, the no-verb guard, and
// the [S,R,O] flattening that feeds the ingest path.
//
// ADR-0053.

import "../ce_test.nova"
import "../../src/learning/openie.nova"

fn test_svo_discovered_predicate() {
    let f = openie_extract("Einstein discovered relativity in 1905.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "einstein")
    ce_str_eq("predicate is the discovered verb", oie_predicate(f), "discovered")
    ce_str_eq("object", oie_object(f), "relativity")
    ce_eq("one n-ary arg", len(oie_args(f)), 1)
    ce_str_eq("arg role", oie_args(f)[0][0], "in")
    ce_str_eq("arg value", oie_args(f)[0][1], "1905")
}

fn test_simple_svo() {
    let f = openie_extract("The Earth orbits the Sun.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject (article dropped)", oie_subject(f), "earth")
    ce_str_eq("verb predicate", oie_predicate(f), "orbits")
    ce_str_eq("object (article dropped)", oie_object(f), "sun")
}

fn test_intransitive_nary() {
    let f = openie_extract("Water boils at 100 degrees.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "water")
    ce_str_eq("predicate", oie_predicate(f), "boils")
    ce_str_eq("no direct object", oie_object(f), "")
    ce_eq("one prepositional arg", len(oie_args(f)), 1)
    ce_str_eq("arg role", oie_args(f)[0][0], "at")
    ce_str_eq("arg value (NP chunk)", oie_args(f)[0][1], "100_degrees")
}

fn test_copula() {
    let f = openie_extract("Paris is the capital of France.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("copula normalised to is_a", oie_predicate(f), "is_a")
    ce_str_eq("subject", oie_subject(f), "paris")
    ce_str_eq("object", oie_object(f), "capital")
    ce_eq("one of-arg", len(oie_args(f)), 1)
    ce_str_eq("arg role", oie_args(f)[0][0], "of")
    ce_str_eq("arg value", oie_args(f)[0][1], "france")
}

fn test_event_multi_arg() {
    // who-did-what-where-when: two prepositional arguments.
    let f = openie_extract("Newton published the Principia in London in 1687.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "newton")
    ce_str_eq("predicate", oie_predicate(f), "published")
    ce_str_eq("object", oie_object(f), "principia")
    ce_eq("two args (where + when)", len(oie_args(f)), 2)
}

fn test_negation_rejected() {
    ce_eq("negated copula not asserted", openie_extract("The sky is not blue."), 0)
}

fn test_no_verb_no_fact() {
    ce_eq("no verb -> no fact", openie_extract("A big red house."), 0)
}

fn test_triples_flatten() {
    // (einstein discovered relativity) + (einstein discovered_in 1905)
    //                                  + (earth orbits sun) = 3
    let trips = openie_triples("Einstein discovered relativity in 1905. The Earth orbits the Sun.")
    ce_eq("flattened triple count", len(trips), 3)
}

fn main() {
    test_svo_discovered_predicate()
    test_simple_svo()
    test_intransitive_nary()
    test_copula()
    test_event_multi_arg()
    test_negation_rejected()
    test_no_verb_no_fact()
    test_triples_flatten()
    ce_summary("openie")
}

main()
