// Unit tests for src/learning/openie.nova (P3, ADR-0053).
//
// OpenIE discovers the predicate (keeps the verb itself as the relation) and
// captures prepositional tails as n-ary arguments, beating the fixed 6-relation
// extractor. Covered: SVO with a discovered verb + temporal arg, article
// dropping, intransitive verb with a prepositional argument, copula -> is_a,
// multi-argument event structure, negation rejection, the no-verb guard, and
// the [S,R,O] flattening that feeds the ingest path.
//
// ADR-0053.

import "../ce_test.nova"
import "../../src/learning/openie.nova"

fn test_svo_discovered_predicate() {
    let f = openie_extract("Einstein discovered relativity in 1905.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "einstein")
    ce_str_eq("predicate is the discovered verb", oie_predicate(f), "discovered")
    ce_str_eq("object", oie_object(f), "relativity")
    ce_eq("one n-ary arg", len(oie_args(f)), 1)
    ce_str_eq("arg role", oie_args(f)[0][0], "in")
    ce_str_eq("arg value", oie_args(f)[0][1], "1905")
}

fn test_simple_svo() {
    let f = openie_extract("The Earth orbits the Sun.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject (article dropped)", oie_subject(f), "earth")
    ce_str_eq("verb predicate", oie_predicate(f), "orbits")
    ce_str_eq("object (article dropped)", oie_object(f), "sun")
}

fn test_intransitive_nary() {
    let f = openie_extract("Water boils at 100 degrees.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "water")
    ce_str_eq("predicate", oie_predicate(f), "boils")
    ce_str_eq("no direct object", oie_object(f), "")
    ce_eq("one prepositional arg", len(oie_args(f)), 1)
    ce_str_eq("arg role", oie_args(f)[0][0], "at")
    ce_str_eq("arg value (NP chunk)", oie_args(f)[0][1], "100_degrees")
}

fn test_copula() {
    let f = openie_extract("Paris is the capital of France.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("copula normalised to is_a", oie_predicate(f), "is_a")
    ce_str_eq("subject", oie_subject(f), "paris")
    ce_str_eq("object", oie_object(f), "capital")
    ce_eq("one of-arg", len(oie_args(f)), 1)
    ce_str_eq("arg role", oie_args(f)[0][0], "of")
    ce_str_eq("arg value", oie_args(f)[0][1], "france")
}

fn test_event_multi_arg() {
    // who-did-what-where-when: two prepositional arguments.
    let f = openie_extract("Newton published the Principia in London in 1687.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "newton")
    ce_str_eq("predicate", oie_predicate(f), "published")
    ce_str_eq("object", oie_object(f), "principia")
    ce_eq("two args (where + when)", len(oie_args(f)), 2)
}

// N3: negation is now CARRIED as polarity, not silently dropped -- the fact is
// extracted (subject/predicate/object intact) but tagged negative, and it emits
// no positive triple.
fn test_negation_polarity() {
    let f = openie_extract("The sky is not blue.")
    ce_check("negated fact still extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "sky")
    ce_str_eq("predicate", oie_predicate(f), "is_a")
    ce_str_eq("object", oie_object(f), "blue")
    ce_eq("polarity negative", oie_polarity(f), 0 - 1)
    ce_eq("is_negated", oie_is_negated(f), 1)
    // a negated copula asserts no positive triple.
    let trips = openie_triples("The sky is not blue.")
    ce_eq("no positive triple from negation", len(trips), 0)
}

fn test_negation_aux_verb() {
    // "X does not <verb> Y": the aux hands off across the negation to the verb
    // (using a verb the heuristic recognises -- "require" is in the lexicon).
    let f = openie_extract("Mosses do not require sunlight.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "mosses")
    ce_str_eq("predicate is the verb past 'not'", oie_predicate(f), "require")
    ce_str_eq("object", oie_object(f), "sunlight")
    ce_eq("negated", oie_is_negated(f), 1)
}

fn test_positive_polarity_default() {
    let f = openie_extract("The Earth orbits the Sun.")
    ce_eq("positive polarity", oie_polarity(f), 1)
    ce_eq("not negated", oie_is_negated(f), 0)
    ce_eq("no coords", len(oie_coords(f)), 0)
}

// N3: coordinated objects split into the primary + a coords list, and each
// coordinated object flattens to its own (S, R, O) triple.
fn test_coordination() {
    let f = openie_extract("The cell contains a nucleus and mitochondria.")
    ce_check("fact extracted", f != 0)
    ce_str_eq("subject", oie_subject(f), "cell")
    ce_str_eq("predicate", oie_predicate(f), "contains")
    ce_str_eq("primary object", oie_object(f), "nucleus")
    ce_eq("one coordinated object", len(oie_coords(f)), 1)
    ce_str_eq("coord object", oie_coords(f)[0], "mitochondria")
    let trips = openie_triples("The cell contains a nucleus and mitochondria.")
    ce_eq("two triples (primary + coord)", len(trips), 2)
}

fn test_coordination_three() {
    let f = openie_extract("Plants need water and sunlight and soil.")
    ce_str_eq("primary", oie_object(f), "water")
    ce_eq("two coords", len(oie_coords(f)), 2)
    ce_str_eq("coord 1", oie_coords(f)[0], "sunlight")
    ce_str_eq("coord 2", oie_coords(f)[1], "soil")
}

// N3: a pronoun-led sentence corefers to the previous sentence's subject.
fn test_coreference() {
    let facts = openie_run("The Sun is a star. It is hot.")
    ce_eq("two facts", len(facts), 2)
    ce_str_eq("first subject", oie_subject(facts[0]), "sun")
    ce_str_eq("pronoun resolved to sun", oie_subject(facts[1]), "sun")
    ce_str_eq("second predicate", oie_predicate(facts[1]), "is_a")
    ce_str_eq("second object", oie_object(facts[1]), "hot")
}

fn test_coreference_no_antecedent() {
    // a leading pronoun with no prior subject: extraction falls back to the
    // normal content-skip path (no crash, no spurious antecedent).
    let facts = openie_run("It rains often.")
    ce_check("runs without antecedent", len(facts) >= 0)
}

fn test_no_verb_no_fact() {
    ce_eq("no verb -> no fact", openie_extract("A big red house."), 0)
}

fn test_triples_flatten() {
    // (einstein discovered relativity) + (einstein discovered_in 1905)
    //                                  + (earth orbits sun) = 3
    let trips = openie_triples("Einstein discovered relativity in 1905. The Earth orbits the Sun.")
    ce_eq("flattened triple count", len(trips), 3)
}

fn main() {
    test_svo_discovered_predicate()
    test_simple_svo()
    test_intransitive_nary()
    test_copula()
    test_event_multi_arg()
    test_negation_polarity()
    test_negation_aux_verb()
    test_positive_polarity_default()
    test_coordination()
    test_coordination_three()
    test_coreference()
    test_coreference_no_antecedent()
    test_no_verb_no_fact()
    test_triples_flatten()
    ce_summary("openie")
}

main()
