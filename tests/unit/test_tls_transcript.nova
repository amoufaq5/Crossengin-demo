// Unit tests for src/net/tls/tls_transcript.nova.
//
// Covers snapshot semantics, byte-list vs buffer parity, and equality
// across incremental / concatenated absorbs.

import "../ce_test.nova"
import "../../src/net/tls/tls_transcript.nova"
import "../../src/safety/sha256.nova"

// Build a byte list of `n` deterministic pseudo-random bytes.
fn _tr_bytes(n, seed) {
    let out = list_new()
    let i = 0
    let x = seed
    while i < n {
        x = int_and(x * 1103515245 + 12345, 2147483647)
        push(out, int_and(x, 255))
        i = i + 1
    }
    return out
}

// Concat two byte lists.
fn _tr_concat(a, b) {
    let out = list_new()
    let i = 0
    let na = len(a)
    while i < na { push(out, a[i]); i = i + 1 }
    let j = 0
    let nb = len(b)
    while j < nb { push(out, b[j]); j = j + 1 }
    return out
}

// Compare two 32-byte byte lists.
fn _tr_hash_eq(a, b) {
    if len(a) != 32 { return 0 }
    if len(b) != 32 { return 0 }
    let i = 0
    while i < 32 {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// SHA-256 of a byte list via oneshot for the reference value.
fn _tr_sha_bytes(byte_list) {
    let n = len(byte_list)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, byte_list[i])
        i = i + 1
    }
    store8(buf + n, 0)
    let d = sha256_oneshot(buf, n)
    let out = list_new()
    let j = 0
    while j < 32 {
        push(out, load8(d + j))
        j = j + 1
    }
    return out
}

// ---- basic cases --------------------------------------------------------

fn test_empty_transcript() {
    let ctx = transcript_new()
    let got = transcript_get(ctx)
    let want = _tr_sha_bytes(list_new())
    ce_eq("empty transcript hash matches sha256_empty",
          _tr_hash_eq(got, want), 1)
    ce_eq("empty transcript total = 0", transcript_total(ctx), 0)
}

fn test_single_absorb() {
    let ctx = transcript_new()
    let a = _tr_bytes(64, 7)
    transcript_absorb(ctx, a, 64)
    let got = transcript_get(ctx)
    let want = _tr_sha_bytes(a)
    ce_eq("single-absorb hash matches sha256_oneshot",
          _tr_hash_eq(got, want), 1)
    ce_eq("total=64", transcript_total(ctx), 64)
}

fn test_two_absorbs_matches_concat() {
    let ctx = transcript_new()
    let a = _tr_bytes(37, 11)
    let b = _tr_bytes(51, 12)
    transcript_absorb(ctx, a, 37)
    transcript_absorb(ctx, b, 51)
    let got = transcript_get(ctx)
    let want = _tr_sha_bytes(_tr_concat(a, b))
    ce_eq("two absorbs = concat", _tr_hash_eq(got, want), 1)
    ce_eq("total=88", transcript_total(ctx), 88)
}

fn test_many_absorbs_matches_concat() {
    let ctx = transcript_new()
    let all = list_new()
    let i = 0
    while i < 10 {
        let piece = _tr_bytes(41 + i, 100 + i)
        transcript_absorb(ctx, piece, len(piece))
        let k = 0
        while k < len(piece) {
            push(all, piece[k])
            k = k + 1
        }
        i = i + 1
    }
    let got = transcript_get(ctx)
    let want = _tr_sha_bytes(all)
    ce_eq("10 absorbs = concat", _tr_hash_eq(got, want), 1)
}

fn test_snapshot_does_not_disturb() {
    let ctx = transcript_new()
    let a = _tr_bytes(80, 21)
    let b = _tr_bytes(90, 22)
    transcript_absorb(ctx, a, 80)
    // First snapshot.
    let mid = transcript_get(ctx)
    let expected_mid = _tr_sha_bytes(a)
    ce_eq("snapshot after a", _tr_hash_eq(mid, expected_mid), 1)
    // Second snapshot without further absorb.
    let mid2 = transcript_get(ctx)
    ce_eq("second snapshot same", _tr_hash_eq(mid, mid2), 1)
    // Continue absorbing.
    transcript_absorb(ctx, b, 90)
    let final = transcript_get(ctx)
    let expected_final = _tr_sha_bytes(_tr_concat(a, b))
    ce_eq("continued absorb after snapshot",
          _tr_hash_eq(final, expected_final), 1)
}

fn test_absorb_empty_is_noop() {
    let ctx = transcript_new()
    let a = _tr_bytes(32, 5)
    transcript_absorb(ctx, list_new(), 0)   // no-op
    transcript_absorb(ctx, a, 32)
    transcript_absorb(ctx, list_new(), 0)   // no-op
    let got = transcript_get(ctx)
    let want = _tr_sha_bytes(a)
    ce_eq("empty absorb is noop", _tr_hash_eq(got, want), 1)
}

fn test_get_into_matches_get() {
    let ctx = transcript_new()
    let a = _tr_bytes(200, 42)
    transcript_absorb(ctx, a, 200)
    let byte_list = transcript_get(ctx)
    let buf = alloc(33)
    transcript_get_into(ctx, buf)
    let same = 1
    let i = 0
    while i < 32 {
        if byte_list[i] != load8(buf + i) { same = 0 }
        i = i + 1
    }
    ce_eq("get_into equals get", same, 1)
}

fn test_absorb_buf_equals_absorb_list() {
    let ctx1 = transcript_new()
    let ctx2 = transcript_new()
    let a = _tr_bytes(120, 3)
    // ctx1 via absorb (byte list).
    transcript_absorb(ctx1, a, 120)
    // ctx2 via absorb_buf (raw pointer).
    let buf = alloc(121)
    let i = 0
    while i < 120 { store8(buf + i, a[i]); i = i + 1 }
    store8(buf + 120, 0)
    transcript_absorb_buf(ctx2, buf, 120)
    ce_eq("list-absorb == buf-absorb",
          _tr_hash_eq(transcript_get(ctx1), transcript_get(ctx2)), 1)
}

fn test_init_variant_matches_new() {
    let ctx1 = transcript_new()
    let ctx2 = list_new()
    transcript_init(ctx2)
    let a = _tr_bytes(50, 71)
    transcript_absorb(ctx1, a, 50)
    transcript_absorb(ctx2, a, 50)
    ce_eq("init variant == new variant",
          _tr_hash_eq(transcript_get(ctx1), transcript_get(ctx2)), 1)
}

fn test_boundary_across_64() {
    // Two absorbs that straddle a 64-byte SHA-256 block boundary in
    // different ways. Ensures snapshot honors the partial buffer state.
    let ctx = transcript_new()
    let a = _tr_bytes(63, 1)   // 1 short of a full block
    let b = _tr_bytes(2, 2)    // pushes past 64
    transcript_absorb(ctx, a, 63)
    let mid = transcript_get(ctx)
    let want_mid = _tr_sha_bytes(a)
    ce_eq("snapshot at 63 bytes", _tr_hash_eq(mid, want_mid), 1)
    transcript_absorb(ctx, b, 2)
    let final = transcript_get(ctx)
    let want_final = _tr_sha_bytes(_tr_concat(a, b))
    ce_eq("post-boundary absorb", _tr_hash_eq(final, want_final), 1)
}

fn main() {
    test_empty_transcript()
    test_single_absorb()
    test_two_absorbs_matches_concat()
    test_many_absorbs_matches_concat()
    test_snapshot_does_not_disturb()
    test_absorb_empty_is_noop()
    test_get_into_matches_get()
    test_absorb_buf_equals_absorb_list()
    test_init_variant_matches_new()
    test_boundary_across_64()
    ce_summary("tls_transcript")
}

main()
