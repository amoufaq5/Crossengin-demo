// Unit tests for src/ingest/web_scheduler.nova.

import "../ce_test.nova"
import "../../src/ingest/web_scheduler.nova"

fn _wl() {
    let w = sw_new()
    sw_add(w, "en.wikipedia.org")
    sw_add(w, "www.who.int")
    return w
}

fn test_plan_and_size() {
    let s = ws_new(_wl())
    ce_eq("empty", ws_size(s), 0)
    let id = ws_plan(s, "https://en.wikipedia.org/wiki/Cat", "biology", 0)
    ce_eq("id 1", id, 1)
    ce_eq("size 1", ws_size(s), 1)
    let e = ws_find(s, id)
    ce_eq("planned state", e[WS_E_STATE], WS_PLANNED)
}

fn test_untrusted_host_blocked() {
    let s = ws_new(_wl())
    ws_plan(s, "https://evil.example/malware", "topic", 0)
    ce_eq("host-blocked count", ws_count_state(s, WS_HOST_BLOCKED), 1)
}

fn test_stub_fetch_and_ingest() {
    let s = ws_new(_wl())
    let id = ws_plan(s, "https://en.wikipedia.org/wiki/Cat", "biology", 0)
    let pairs = list_new()
    let p = list_new()
    push(p, "https://en.wikipedia.org/wiki/Cat")
    push(p, "KG animals\nSRC src:web:placeholder\nATOM cat 1 800\nATOM feline 1 800\nIMP cat feline EMPIRICAL\n")
    push(pairs, p)
    let out = ws_step_via_stub(s, pairs)
    ce_eq("1 fetched", out[0], 1)
    let e = ws_find(s, id)
    ce_eq("state fetched", e[WS_E_STATE], WS_FETCHED)
    let q = rq_new()
    let ing = ws_ingest_fetched(s, q, 0)
    ce_eq("1 record enqueued", ing[0], 1)
    ce_eq("state ingested", ws_find(s, id)[WS_E_STATE], WS_INGESTED)
    ce_eq("queue holds 1", rq_size(q), 1)
    let queued = rq_entries(q)[0]
    let src = cur_source(rq_record(queued))
    ce_check("src rewritten", str_eq_bytes(src, "src:web:biology:en.wikipedia.org") == 1)
}

fn test_missing_body_marks_failed() {
    let s = ws_new(_wl())
    ws_plan(s, "https://www.who.int/data", "health", 0)
    let out = ws_step_direct(s)   // no bodies delivered
    ce_eq("0 fetched", out[0], 0)
    ce_eq("1 failed", out[1], 1)
}

fn test_multiple_plans() {
    let s = ws_new(_wl())
    ws_plan(s, "https://en.wikipedia.org/wiki/A", "topic", 0)
    ws_plan(s, "https://en.wikipedia.org/wiki/B", "topic", 0)
    ws_plan(s, "https://outside.example/x", "topic", 0)
    ce_eq("2 planned", ws_count_state(s, WS_PLANNED), 2)
    ce_eq("1 blocked", ws_count_state(s, WS_HOST_BLOCKED), 1)
}

fn test_deliver_then_step() {
    let s = ws_new(_wl())
    let id = ws_plan(s, "https://www.who.int/covid", "health", 0)
    let ok = ws_deliver(s, id, "KG covid\nSRC src:web:x\nATOM sars_cov_2 1 900\n")
    ce_eq("delivered", ok, 1)
    let out = ws_step_direct(s)
    ce_eq("1 fetched via deliver", out[0], 1)
}

fn test_source_tag_shape() {
    ce_eq("shape",
        ws_source_tag("https://en.wikipedia.org/wiki/Cat", "biology"),
        "src:web:biology:en.wikipedia.org")
}

fn test_state_names() {
    ce_check("planned", len(ws_state_name(WS_PLANNED)) > 0)
    ce_check("blocked", len(ws_state_name(WS_HOST_BLOCKED)) > 0)
}

fn main() {
    test_plan_and_size()
    test_untrusted_host_blocked()
    test_stub_fetch_and_ingest()
    test_missing_body_marks_failed()
    test_multiple_plans()
    test_deliver_then_step()
    test_source_tag_shape()
    test_state_names()
    ce_summary("ingest_web_scheduler")
}

main()
