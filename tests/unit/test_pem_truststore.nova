// Unit tests for src/safety/pem_truststore.nova (R46). A PEM bundle holds an
// RSA cert and an ECDSA cert (both openssl-generated); the trust store must
// load the RSA anchor (key matches the cert modulus) and SKIP the ECDSA one.

import "../ce_test.nova"
import "../../src/safety/pem_truststore.nova"

let RSA_B64 = ""
let EC_B64  = ""
let RSA_MOD = ""

fn _bundle() {
    return "-----BEGIN CERTIFICATE-----\n" + RSA_B64 + "\n-----END CERTIFICATE-----\n"
         + "-----BEGIN CERTIFICATE-----\n" + EC_B64 + "\n-----END CERTIFICATE-----\n"
}

fn test_load_rsa_skip_ecdsa() {
    let anchors = truststore_load(_bundle())
    ce_eq("one RSA anchor (ECDSA skipped)", len(anchors), 1)
    // the loaded anchor's modulus equals the RSA cert's modulus
    let want = bn2048_from_hex(RSA_MOD)
    ce_check("anchor key matches cert modulus", bn2048_cmp(anchor_N(anchors[0]), want) == 0)
    ce_eq("anchor exponent 65537", anchor_e(anchors[0]), 65537)
}

fn test_empty_and_garbage() {
    ce_eq("empty bundle -> 0 anchors", len(truststore_load("")), 0)
    ce_eq("no PEM markers -> 0 anchors", len(truststore_load("not a pem file at all")), 0)
}

fn main() {
    test_load_rsa_skip_ecdsa()
    test_empty_and_garbage()
    ce_summary("pem_truststore")
}

main()
