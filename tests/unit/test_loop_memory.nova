// Unit tests for src/agent/loop_memory.nova
// Verifies the memory loop records a moment + episode and traces the percept.
// ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_memory.nova"

fn handle(kg, id) { let h = list_new(); push(h, kg); push(h, id); return h }

fn test_memory() {
    let stream = ms_new()
    let em = em_new()
    let ctx = ctx_new()
    ctx_set_tick(ctx, 5)
    ctx_set_input(ctx, "fever")
    let percept = list_new()
    push(percept, handle("med", 0))
    push(percept, handle("med", 1))
    ctx_set_percept(ctx, percept)
    let mid = loop_memory_step(ctx, stream, em)
    ce_eq("moment recorded", ms_count(stream), 1)
    ce_str_eq("moment raw", moment_raw(ms_get(stream, mid)), "fever")
    ce_eq("percept traced", len(moment_trace(ms_get(stream, mid))), 2)
    ce_eq("episode recorded", em_count(em), 1)
}

fn main() { test_memory() ce_summary("loop_memory") }
main()
