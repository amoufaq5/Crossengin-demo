// End-to-end test: ingest data/packs/biology.cerec.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn test_biology_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec", "data/packs/biology.cerec",
                          "biology", "src:pack:biology:v1", "", 0)
    ce_eq("1 record", ing_sum_ok(s), 1)
    ce_eq("77 atoms added", ing_sum_atoms(s), 77)
    ce_eq("0 parse errors", ing_sum_errors(s), 0)
    ce_eq("0 queued (trusted src:pack:)", ing_sum_queued(s), 0)
}

fn test_headline_biology_atoms_present() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/biology.cerec",
                  "biology", "src:pack:biology:v1", "", 0)
    let kgreg = ing_kgreg(a)
    let n = kg_count(kgreg)
    let bkg = 0
    let i = 0
    while i < n {
        let k = kg_get(kgreg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "biology") == 1 { bkg = k } }
        i = i + 1
    }
    ce_check("biology KG exists", bkg != 0)
    // Domains
    ce_check("bacteria present", kg_find_atom(bkg, "bacteria") != 0)
    ce_check("archaea present",  kg_find_atom(bkg, "archaea") != 0)
    ce_check("eukarya present",  kg_find_atom(bkg, "eukarya") != 0)
    // Kingdoms
    ce_check("animalia present", kg_find_atom(bkg, "animalia") != 0)
    ce_check("plantae present",  kg_find_atom(bkg, "plantae") != 0)
    // Organisms
    ce_check("human present",  kg_find_atom(bkg, "human") != 0)
    ce_check("e_coli present", kg_find_atom(bkg, "e_coli") != 0)
    // Organelles
    ce_check("mitochondria present", kg_find_atom(bkg, "mitochondria") != 0)
    ce_check("ribosome present",     kg_find_atom(bkg, "ribosome") != 0)
    // Molecules
    ce_check("dna present", kg_find_atom(bkg, "dna") != 0)
    ce_check("atp present", kg_find_atom(bkg, "atp") != 0)
    // Processes
    ce_check("photosynthesis present", kg_find_atom(bkg, "photosynthesis") != 0)
    ce_check("evolution present",      kg_find_atom(bkg, "evolution") != 0)
    ce_check("natural_selection present",
             kg_find_atom(bkg, "natural_selection") != 0)
    // Figures
    ce_check("darwin present", kg_find_atom(bkg, "darwin") != 0)
    ce_check("mendel present", kg_find_atom(bkg, "mendel") != 0)
}

fn test_biology_agrees_with_history_on_person() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/biology.cerec",
                  "biology", "src:pack:biology:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/world_history.cerec",
                  "history", "src:pack:world_history:v1", "", 0)
    let conflicts = mkgc_scan_conflicts(ing_kgreg(a), 100)
    let cross = 0
    let i = 0
    while i < len(conflicts) {
        let c = conflicts[i]
        let ka = mkgc_conflict_kg_a(c)
        let kb = mkgc_conflict_kg_b(c)
        let touches_bio = 0
        let touches_hist = 0
        if str_eq_bytes(ka, "biology") == 1 { touches_bio = 1 }
        if str_eq_bytes(kb, "biology") == 1 { touches_bio = 1 }
        if str_eq_bytes(ka, "history") == 1 { touches_hist = 1 }
        if str_eq_bytes(kb, "history") == 1 { touches_hist = 1 }
        if touches_bio == 1 { if touches_hist == 1 {
            cross = cross + 1
        } }
        i = i + 1
    }
    ce_eq("biology + history 0 direct conflicts", cross, 0)
}

fn test_source_attribution() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/biology.cerec",
                  "biology", "src:pack:biology:v1", "", 0)
    let report = mo_report(ing_mo(a))
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:biology:v1") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("biology pack source attributed via meta-observer", saw, 1)
}

fn main() {
    test_biology_ingests_cleanly()
    test_headline_biology_atoms_present()
    test_biology_agrees_with_history_on_person()
    test_source_attribution()
    ce_summary("pack_biology")
}

main()
