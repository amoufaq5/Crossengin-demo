// Unit tests for src/federation/raft_cluster.nova: Raft's CLUSTER-level safety
// properties, driven through real elections and replication over raft_core nodes.
// Election Safety (one leader/term), Log Matching, and State-Machine Safety
// (committed entries agree everywhere).

import "../ce_test.nova"
import "../../src/federation/raft_cluster.nova"

// A fresh candidate wins a clean election in a 3-node cluster: it gets its own
// vote plus both peers' -> majority -> leader. Exactly one leader for the term.
fn test_clean_election() {
    let c = rc_new(3)
    let won = rc_run_election(c, 0)
    ce_eq("candidate 0 won", won, 1)
    ce_eq("node 0 is leader", rf_role(rc_node(c, 0)), RF_LEADER)
    ce_eq("term is 1", rf_term(rc_node(c, 0)), 1)
    ce_eq("exactly one leader in term 1", rc_count_leaders(c, 1), 1)
}

// Election Safety: once a higher-term leader exists, a candidate starting a
// LATER election still wins at most for its own term -- two leaders never share a
// term. Here node 1 starts a second election (term 2): peers step up to term 2
// and grant, node 0 (still term 1 leader) is now stale.
fn test_election_safety_one_leader_per_term() {
    let c = rc_new(3)
    rc_run_election(c, 0)                 // node 0 leader @ term 1
    let won = rc_run_election(c, 1)       // node 1 candidate @ term 2
    ce_eq("node 1 won term 2", won, 1)
    ce_eq("one leader in term 2", rc_count_leaders(c, 2), 1)
    // node 0 was elected in term 1; no one else is a term-1 leader.
    ce_eq("at most one leader ever held term 1", rc_count_leaders(c, 1), 0)
}

// Replication: leader appends two commands, replicates -> commit advances to 2
// and every node's committed prefix agrees.
fn test_replication_and_commit() {
    let c = rc_new(3)
    rc_run_election(c, 0)
    rc_leader_append(c, 0, 111)
    rc_leader_append(c, 0, 222)
    let committed = rc_replicate(c, 0)
    ce_eq("committed index 2", committed, 2)
    ce_eq("follower 1 has the log", rf_last_index(rc_node(c, 1)), 2)
    ce_eq("follower 2 has the log", rf_last_index(rc_node(c, 2)), 2)
    ce_eq("follower 1 committed too", rf_commit(rc_node(c, 1)), 2)
    ce_eq("cluster committed-consistent", rc_committed_consistent(c), 1)
}

// State-Machine Safety across a leader change: a new leader replicates ITS log,
// overwriting a follower's divergent (uncommitted) tail; the committed prefix
// stays consistent everywhere.
fn test_leader_change_consistency() {
    let c = rc_new(3)
    rc_run_election(c, 0)
    rc_leader_append(c, 0, 10)
    rc_replicate(c, 0)                    // all commit index 1 (cmd 10)
    ce_eq("all agree after first round", rc_committed_consistent(c), 1)
    // node 1 takes over (term 2), appends a different command, replicates.
    rc_run_election(c, 1)
    ce_eq("node 1 leader term 2", rf_role(rc_node(c, 1)), RF_LEADER)
    rc_leader_append(c, 1, 20)
    let committed = rc_replicate(c, 1)
    ce_eq("commit advanced to 2", committed, 2)
    ce_eq("still consistent across cluster", rc_committed_consistent(c), 1)
    // index 1 (the earlier committed entry) is preserved everywhere.
    ce_eq("idx1 preserved on node 2", rf_log_term(rc_node(c, 2), 1), 1)
}

// A candidate with a STALE log cannot win against peers holding a newer entry
// (election restriction 5.4.1) -- so it can never erase a committed entry.
fn test_stale_candidate_loses() {
    let c = rc_new(3)
    rc_run_election(c, 0)
    rc_leader_append(c, 0, 99)
    rc_replicate(c, 0)                    // nodes 0,1,2 now hold index 1
    // node 2 artificially rewinds its own log (simulate a lagging replica) by
    // building a fresh cluster member with an empty log in its slot.
    let stale = rf_new(2)
    list_set(c, 2, stale)
    // stale node 2 starts an election; nodes 0 and 1 have a newer log -> refuse.
    let won = rc_run_election(c, 2)
    ce_eq("stale candidate cannot win", won, 0)
    ce_eq("stale candidate is not leader", rf_role(rc_node(c, 2)), RF_CANDIDATE)
}

// majority sizing: a 5-node cluster needs 3 votes; a clean election still wins.
fn test_five_node_election() {
    let c = rc_new(5)
    let won = rc_run_election(c, 2)
    ce_eq("5-node clean election won", won, 1)
    ce_eq("one leader in term 1", rc_count_leaders(c, 1), 1)
}

fn main() {
    test_clean_election()
    test_election_safety_one_leader_per_term()
    test_replication_and_commit()
    test_leader_change_consistency()
    test_stale_candidate_loses()
    test_five_node_election()
    ce_summary("raft_cluster")
}

main()
