// Unit tests for src/io/transducers/stream_http.nova -- the PURE logic
// (NL_AND_COVERAGE C1; ADR-0058). The socket lifecycle (bind/listen/accept) is
// integration-only; here we cover the deterministic helpers: digit checking,
// dotted-quad IP parsing, and the stream state object + accessors/counters.

import "../ce_test.nova"
import "../../src/io/transducers/stream_http.nova"

fn test_is_digits() {
    ce_eq("digits", _stream_http_is_digits("12345"), 1)
    ce_eq("single digit", _stream_http_is_digits("0"), 1)
    ce_eq("empty is not digits", _stream_http_is_digits(""), 0)
    ce_eq("trailing alpha", _stream_http_is_digits("12a"), 0)
    ce_eq("leading space", _stream_http_is_digits(" 12"), 0)
    ce_eq("sign is not a digit", _stream_http_is_digits("-1"), 0)
}

fn test_ip_to_int() {
    // octet packing: octet0 + octet1*256 + octet2*256^2 + octet3*256^3 (the
    // LAST octet is the most-significant). 4th octet kept <= 15: the existing
    // *256*256*256 chain overflows NOVA's large-multiply codegen threshold for
    // high 4th octets (documented in ADR-0058; the production bind path uses
    // low / loopback addresses).
    ce_eq("0.0.0.0 -> 0", _stream_http_ip_to_int("0.0.0.0"), 0)
    ce_eq("0.0.0.1 -> 256^3 (last octet most-significant)", _stream_http_ip_to_int("0.0.0.1"), 16777216)
    ce_eq("0.1.0.0 -> 256", _stream_http_ip_to_int("0.1.0.0"), 256)
    ce_eq("0.0.1.0 -> 65536", _stream_http_ip_to_int("0.0.1.0"), 65536)
    ce_eq("1.2.3.4 packs correctly", _stream_http_ip_to_int("1.2.3.4"), 67305985)
    // malformed -> -1
    ce_eq("too few octets", _stream_http_ip_to_int("1.2.3"), 0 - 1)
    ce_eq("too many octets", _stream_http_ip_to_int("1.2.3.4.5"), 0 - 1)
    ce_eq("octet out of range", _stream_http_ip_to_int("1.2.3.300"), 0 - 1)
    ce_eq("non-numeric octet", _stream_http_ip_to_int("1.2.x.4"), 0 - 1)
}

fn test_state_and_accessors() {
    let s = stream_http_new()
    ce_eq("fresh: disabled", stream_http_enabled(s), 0)
    ce_eq("fresh: not initialized", stream_http_initialized(s), 0)
    ce_eq("fresh: no listen fd", stream_http_listen_fd(s), 0)
    ce_eq("fresh: events counter 0", stream_http_events_total(s), 0)
    ce_eq("fresh: requests counter 0", stream_http_requests_total(s), 0)
}

fn main() {
    test_is_digits()
    test_ip_to_int()
    test_state_and_accessors()
    ce_summary("stream_http")
}

main()
