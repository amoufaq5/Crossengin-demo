// CE_TEST_TIMEOUT: 240
// Refusal tests for src/learning/sa4_coord.nova (A2.2b): the coordinator's
// checks on what souls send, part 1 (part 2, with a soul outside U2, is
// test_sa4_coord_refuse2.nova). An honest N = 5 round is recorded
// once (each soul's lines per phase); each case replays it into a fresh
// coordinator with one line changed and asserts the reason the sender was
// left out (sa4c_why). Replays hit the shared vcache, so only the recorded
// round pays for signatures. v4-sa3 (A2.4c): an honest round has six
// collecting phases (ADV, shares, check, y, SIG3, reveals), so rec has six
// rows; the receipt rules of the share, check and open phases are tested
// at the end (SPEC A2.4c 8.4), then the check close's filters (a
// complaint is forwarded only if its complainer and the accused are both
// still in) and sa4c_keep / sa4c_expect in state 9 with left-out souls.

import "../ce_test.nova"
import "../sa4_harness.nova"

let CR_R = 39

// rec[phase][i] = lines soul i sent in that phase (0..5: ADV, shares,
// check, y, SIG3, reveals).
fn cr_record(roster, vc) {
    let souls = sa4h_souls(roster, 5, CR_R, vc, 0)
    let c = sa4e_coord(roster, CR_R, vc)
    let rec = list_new()
    let ph = 0
    while ph < 6 {
        let row = list_new()
        let i = 0
        while i < 5 {
            push(row, list_new())
            i = i + 1
        }
        push(rec, row)
        ph = ph + 1
    }
    let rl = sa4c_round_line(c)
    let i2 = 0
    while i2 < 5 {
        let o = sa4h_feed(souls[i2], sa4h_one(rl))[1]
        list_set(rec[0], i2, o)
        let k = 0
        while k < len(o) {
            sa4c_recv(c, SA4H_IDS[i2], o[k])
            k = k + 1
        }
        i2 = i2 + 1
    }
    let p = 1
    while p < 6 {
        let msgs = sa4c_close(c)[2]
        let i = 0
        while i < 5 {
            let mine = list_new()
            let k = 0
            while k < len(msgs) {
                if msgs[k][0] == SA4H_IDS[i] { push(mine, msgs[k][1]) }
                k = k + 1
            }
            let o = sa4h_feed(souls[i], mine)[1]
            list_set(rec[p], i, o)
            let k2 = 0
            while k2 < len(o) {
                sa4c_recv(c, SA4H_IDS[i], o[k2])
                k2 = k2 + 1
            }
            i = i + 1
        }
        p = p + 1
    }
    ce_eq("recorded round closes", sa4c_close(c)[0], 1)
    ce_eq("recorded round unmasks", sa4h_same(sa4c_unmask(c)[2], sa4h_expected([1, 2, 3, 4, 5])), 1)
    return rec
}

// A fresh coordinator with phases < upto replayed and closed.
fn cr_replay(roster, vc, rec, upto) {
    let c = sa4e_coord(roster, CR_R, vc)
    let p = 0
    while p < upto {
        let i = 0
        while i < 5 {
            let o = rec[p][i]
            let k = 0
            while k < len(o) {
                sa4c_recv(c, SA4H_IDS[i], o[k])
                k = k + 1
            }
            i = i + 1
        }
        sa4c_close(c)
        p = p + 1
    }
    return c
}

fn cr_expect(label, c, from_id, line, frag) {
    let r = sa4c_recv(c, from_id, line)
    ce_eq(label + ": refused", r[0], 0)
    let why = sa4c_why(c, from_id)
    ce_check(label + ": reason '" + frag + "' (got '" + why + "' / '" + r[1] + "')", find_bytes(why + " " + r[1], frag) >= 0)
    return 0
}

fn cr_zero32() {
    let z = list_new()
    let i = 0
    while i < 32 {
        push(z, 0)
        i = i + 1
    }
    return z
}

fn test_adv(roster, vc, rec) {
    let a0 = rec[0][0][0]
    let p0 = sa4w_parse(a0)
    ce_eq("unknown connection id", sa4c_recv(cr_replay(roster, vc, rec, 0), 999, a0)[0], 0)
    cr_expect("ADV for another id", cr_replay(roster, vc, rec, 0), 300, a0, "ADV for another id")
    let c2 = cr_replay(roster, vc, rec, 0)
    sa4c_recv(c2, 7, a0)
    cr_expect("second ADV", c2, 7, a0, "second ADV")
    ce_eq("lines after being left out", sa4c_recv(c2, 7, a0)[0], 0)
    cr_expect("malformed line", cr_replay(roster, vc, rec, 0), 7, "SA4_ADV  x", "malformed")
    cr_expect("other round", cr_replay(roster, vc, rec, 0), 7, sa4w_fmt_adv(CR_R + 1, 7, p0[3], p0[4], p0[5], p0[6], p0[7]), "another round")
    cr_expect("c_pk == s_pk", cr_replay(roster, vc, rec, 0), 7, sa4w_fmt_adv(CR_R, 7, p0[3], p0[3], p0[5], p0[6], p0[7]), "c_pk == s_pk")
    cr_expect("low-order c_pk", cr_replay(roster, vc, rec, 0), 7, sa4w_fmt_adv(CR_R, 7, cr_zero32(), p0[4], p0[5], p0[6], p0[7]), "low-order c_pk")
    cr_expect("low-order s_pk", cr_replay(roster, vc, rec, 0), 7, sa4w_fmt_adv(CR_R, 7, p0[3], cr_zero32(), p0[5], p0[6], p0[7]), "low-order s_pk")
    cr_expect("share in the ADV phase", cr_replay(roster, vc, rec, 0), 7, rec[1][0][0], "expected SA4_ADV")
    let cab = cr_replay(roster, vc, rec, 0)
    cr_expect("soul abort", cab, 7, "SA4_ABORT 39 7 bad_fp", "possibly a victim")
    ce_eq("abort recorded as an abort", sa4c_aborted(cab, 7), 1)
    ce_eq("a malformed line is not an abort", sa4c_aborted(cab, 300), 0)
    // A correctly signed ADV that reuses another soul's c_pk: both souls
    // are left out at close.
    let p1 = sa4w_parse(rec[0][1][0])
    let msg = sa4w_adv_transcript(sa4w_unhex(sroster_fingerprint(roster), 32), CR_R, 300, SA4H_L, sa4h_layout(), p0[3], p1[4], p1[6], p1[7])
    let sig = ed25519_sign(msg, ed25519_hex_to_bytes(SA4H_SEEDS[1]), ed25519_hex_to_bytes(SA4H_PKS[1]))
    let c3 = sa4e_coord(roster, CR_R, vc)
    let i = 0
    while i < 5 {
        if i == 1 {
            ce_eq("copied-key ADV accepted on receipt", sa4c_recv(c3, 300, sa4w_fmt_adv(CR_R, 300, p0[3], p1[4], sig, p1[6], p1[7]))[0], 1)
        } else {
            sa4c_recv(c3, SA4H_IDS[i], rec[0][i][0])
        }
        i = i + 1
    }
    let cl = sa4c_close(c3)
    ce_eq("two souls left out: |U1| = 3 < t cancels", cl[0], 0)
    ce_check("copied key reason", find_bytes(sa4c_why(c3, 300), "another soul also advertised") >= 0)
    ce_check("victim of the copy also left out", find_bytes(sa4c_why(c3, 7), "another soul also advertised") >= 0)
    return 0
}

fn test_shares(roster, vc, rec) {
    let s0 = rec[1][0]
    let first = sa4w_parse(s0[0])
    cr_expect("share for another sender", cr_replay(roster, vc, rec, 1), 300, s0[0], "share for another sender")
    cr_expect("share to itself", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_share(CR_R, 7, 7, first[4], first[5]), "share to itself")
    cr_expect("share to an unknown id", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_share(CR_R, 7, 8, first[4], first[5]), "not in the roster")
    // v4-sa2: N = 5 gives D = 3, so a ciphertext must be 98 + 96 bytes; one
    // more or one fewer path node parses but is refused here.
    ce_eq("share ct is 98 + 32 D(5)", len(first[4]), 194)
    let longer = list_new()
    let z = 0
    while z < len(first[4]) + 32 {
        push(longer, 0)
        z = z + 1
    }
    cr_expect("share ct of depth 4", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_share(CR_R, 7, 300, longer, first[5]), "ciphertext length")
    let shorter = list_new()
    z = 0
    while z < len(first[4]) - 32 {
        push(shorter, first[4][z])
        z = z + 1
    }
    cr_expect("share ct of depth 2", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_share(CR_R, 7, 300, shorter, first[5]), "ciphertext length")
    let c = cr_replay(roster, vc, rec, 1)
    sa4c_recv(c, 7, s0[0])
    cr_expect("two shares to one soul", c, 7, s0[0], "two shares to one soul")
    let c2 = cr_replay(roster, vc, rec, 1)
    sa4c_recv(c2, 7, s0[0])
    cr_expect("END count differs", c2, 7, sa4w_fmt_end(CR_R, 1, 7, 4), "END count differs")
    let c3 = cr_replay(roster, vc, rec, 1)
    sa4c_recv(c3, 7, s0[0])
    cr_expect("END short of U1", c3, 7, sa4w_fmt_end(CR_R, 1, 7, 1), "not one share per soul")
    let c4 = cr_replay(roster, vc, rec, 1)
    let k = 0
    while k < len(s0) {
        sa4c_recv(c4, 7, s0[k])
        k = k + 1
    }
    cr_expect("line after END", c4, 7, s0[0], "line after END")
    cr_expect("END for phase 2", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_end(CR_R, 2, 7, 0), "wrong END phase")
    cr_expect("Y in the share phase", cr_replay(roster, vc, rec, 1), 7, rec[3][0][0], "unexpected line")
    // A soul left out of U1 cannot send shares.
    let c5 = sa4e_coord(roster, CR_R, vc)
    let i = 0
    while i < 4 {
        sa4c_recv(c5, SA4H_IDS[i], rec[0][i][0])
        i = i + 1
    }
    sa4c_close(c5)
    cr_expect("share from outside U1", c5, 4294967295, rec[1][4][0], "not in the current set")
    cr_expect("share to a soul outside U1", c5, 7, sa4w_fmt_share(CR_R, 7, 4294967295, first[4], first[5]), "outside U1")
    return 0
}

fn test_y(roster, vc, rec) {
    let y0 = rec[3][0]
    cr_expect("Y for another id", cr_replay(roster, vc, rec, 3), 300, y0[0], "Y for another id")
    let c = cr_replay(roster, vc, rec, 3)
    sa4c_recv(c, 7, y0[0])
    cr_expect("Y END count differs", c, 7, sa4w_fmt_end(CR_R, 2, 7, 2), "END count differs")
    let c2 = cr_replay(roster, vc, rec, 3)
    sa4c_recv(c2, 7, y0[0])
    cr_expect("Y chunks short", c2, 7, sa4w_fmt_end(CR_R, 2, 7, 1), "do not assemble")
    return 0
}

fn test_sig3(roster, vc, rec) {
    let g0 = rec[4][0][0]
    cr_expect("SIG3 for another id", cr_replay(roster, vc, rec, 4), 300, g0, "SIG3 for another id")
    let c = cr_replay(roster, vc, rec, 4)
    sa4c_recv(c, 7, g0)
    cr_expect("second SIG3", c, 7, g0, "second SIG3")
    cr_expect("END in the SIG3 phase", cr_replay(roster, vc, rec, 4), 7, sa4w_fmt_end(CR_R, 2, 7, 2), "expected SA4_SIG3")
    return 0
}

fn test_reveal(roster, vc, rec) {
    let r0 = rec[5][0]
    let first = sa4w_parse(r0[0])
    cr_expect("reveal for another id", cr_replay(roster, vc, rec, 5), 300, r0[0], "reveal for another id")
    cr_expect("reveal about an unknown id", cr_replay(roster, vc, rec, 5), 7, sa4w_fmt_reveal(CR_R, 7, 8, first[4], first[5], first[6]), "not in the roster")
    let c = cr_replay(roster, vc, rec, 5)
    sa4c_recv(c, 7, r0[0])
    cr_expect("two reveals about one soul", c, 7, r0[0], "two reveals about one soul")
    cr_expect("s-share about a soul in U3", cr_replay(roster, vc, rec, 5), 7, sa4w_fmt_reveal(CR_R, 7, first[3], 1, first[5], first[6]), "wrong share kind")
    // v4-sa2: the proof must be 32 (D(5) + 1) = 128 bytes.
    ce_eq("reveal proof is 32 (D + 1) bytes", len(first[6]), 128)
    let pshort = list_new()
    let z = 0
    while z < 96 {
        push(pshort, first[6][z])
        z = z + 1
    }
    cr_expect("reveal proof one node short", cr_replay(roster, vc, rec, 5), 7, sa4w_fmt_reveal(CR_R, 7, first[3], first[4], first[5], pshort), "proof length")
    let plong = sa4h_cat(first[6], pshort)
    cr_expect("reveal proof too long", cr_replay(roster, vc, rec, 5), 7, sa4w_fmt_reveal(CR_R, 7, first[3], first[4], first[5], plong), "proof length")
    let c2 = cr_replay(roster, vc, rec, 5)
    sa4c_recv(c2, 7, r0[0])
    cr_expect("reveal END count differs", c2, 7, sa4w_fmt_end(CR_R, 3, 7, 5), "END count differs")
    let c3 = cr_replay(roster, vc, rec, 5)
    sa4c_recv(c3, 7, r0[0])
    cr_expect("reveal END short of U2", c3, 7, sa4w_fmt_end(CR_R, 3, 7, 1), "not one reveal per soul")
    let c4 = cr_replay(roster, vc, rec, 5)
    ce_eq("unmask before the last close refused", sa4c_unmask(c4)[0], 0)
    return 0
}

// ---- v4-sa3 receipt rules (SPEC A2.4c 8.4) ----------------------------------

fn _cr_line_of(lines, prefix) {
    let k = 0
    while k < len(lines) {
        if sa4h_starts(lines[k], prefix) == 1 { return lines[k] }
        k = k + 1
    }
    return ""
}

fn test_shares_v3(roster, vc, rec) {
    let s0 = rec[1][0]
    let first = sa4w_parse(s0[0])
    let shsig = _cr_line_of(s0, "SA4_SHSIG ")
    ce_check("the recorded batch has a SHSIG", len(shsig) > 0)
    let c = cr_replay(roster, vc, rec, 1)
    sa4c_recv(c, 7, shsig)
    cr_expect("share after the share signature", c, 7, s0[0], "share after the share signature")
    let c2 = cr_replay(roster, vc, rec, 1)
    sa4c_recv(c2, 7, shsig)
    cr_expect("second share signature", c2, 7, shsig, "second share signature")
    cr_expect("share signature for another id", cr_replay(roster, vc, rec, 1), 300, shsig, "share signature for another id")
    let lo = sa4w_unhex(SA4W_LOW_ORDER[2], 32)
    cr_expect("low-order e_pk at receipt", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_share(CR_R, 7, 300, first[4], lo), "one-time key is not a valid X25519 key")
    let pz = list_new()
    let i = 0
    while i < 31 {
        push(pz, 255)
        i = i + 1
    }
    push(pz, 127)
    cr_expect("non-canonical e_pk at receipt", cr_replay(roster, vc, rec, 1), 7, sa4w_fmt_share(CR_R, 7, 300, first[4], pz), "one-time key is not a valid X25519 key")
    // END without SHSIG.
    let c3 = cr_replay(roster, vc, rec, 1)
    let k = 0
    while k < len(s0) {
        if sa4h_starts(s0[k], "SA4_SHARE ") == 1 { sa4c_recv(c3, 7, s0[k]) }
        k = k + 1
    }
    cr_expect("END without a share signature", c3, 7, sa4w_fmt_end(CR_R, 1, 7, 4), "no share signature")
    // A soul without END 1 is left out at the close ("share batch
    // incomplete"), not blamed.
    let c4 = cr_replay(roster, vc, rec, 1)
    let j = 0
    while j < 4 {
        let o = rec[1][j]
        let q = 0
        while q < len(o) {
            sa4c_recv(c4, SA4H_IDS[j], o[q])
            q = q + 1
        }
        j = j + 1
    }
    ce_eq("shares close with one soul silent", sa4c_close(c4)[0], 1)
    ce_check("silent soul: share batch incomplete", find_bytes(sa4c_why(c4, 4294967295), "share batch incomplete") >= 0)
    ce_eq("silent soul: not blamed", sa4c_blamed(c4, 4294967295), 0)
    ce_str_eq("U2' = the other four", sa4e_ids_str(sa4c_u2p(c4)), "7,300,65536,70000")
    ce_eq("state CHECK", sa4c_state(c4), SA4C_ST_CHECK)
    ce_str_eq("expect: U2'", sa4e_ids_str(sa4c_expect(c4)), "7,300,65536,70000")
    ce_str_eq("keep: U2'", sa4e_ids_str(sa4c_keep(c4)), "7,300,65536,70000")
    return 0
}

// A complaint line from v about u (signature and leaf are arbitrary: the
// coordinator stores it verbatim and checks nothing cryptographic here).
fn _cr_complaint(v, u) {
    return sa4w_fmt_complaint(CR_R, v, u, cr_zero32(), sa4h_cat(cr_zero32(), cr_zero32()))
}

fn test_check_phase(roster, vc, rec) {
    cr_expect("complaint for another id", cr_replay(roster, vc, rec, 2), 7, _cr_complaint(300, 65536), "complaint for another id")
    cr_expect("complaint about an unknown id", cr_replay(roster, vc, rec, 2), 7, _cr_complaint(7, 8), "complaint about an id not in the roster")
    cr_expect("complaint about itself", cr_replay(roster, vc, rec, 2), 7, _cr_complaint(7, 7), "complaint about itself")
    let c = cr_replay(roster, vc, rec, 2)
    sa4c_recv(c, 7, _cr_complaint(7, 300))
    cr_expect("two complaints about one soul", c, 7, _cr_complaint(7, 300), "two complaints about one soul")
    cr_expect("END 4 count differs", cr_replay(roster, vc, rec, 2), 7, sa4w_fmt_end(CR_R, 4, 7, 1), "END count differs")
    cr_expect("END 4 for another id", cr_replay(roster, vc, rec, 2), 7, sa4w_fmt_end(CR_R, 4, 300, 0), "END for another id")
    cr_expect("END 1 in the check phase", cr_replay(roster, vc, rec, 2), 7, sa4w_fmt_end(CR_R, 1, 7, 0), "wrong END phase")
    let c2 = cr_replay(roster, vc, rec, 2)
    sa4c_recv(c2, 7, sa4w_fmt_end(CR_R, 4, 7, 0))
    cr_expect("complaint after END 4", c2, 7, _cr_complaint(7, 300), "line after END")
    cr_expect("share in the check phase", cr_replay(roster, vc, rec, 2), 7, rec[1][0][0], "unexpected line while collecting complaints")
    // A soul outside U2' (left out at the shares close) may not complain,
    // nor be complained about.
    let c3 = cr_replay(roster, vc, rec, 1)
    let j = 0
    while j < 4 {
        let o = rec[1][j]
        let q = 0
        while q < len(o) {
            sa4c_recv(c3, SA4H_IDS[j], o[q])
            q = q + 1
        }
        j = j + 1
    }
    sa4c_close(c3)
    let c3b = c3
    cr_expect("complaint about a soul outside U2'", c3b, 7, _cr_complaint(7, 4294967295), "complaint about a soul outside U2'")
    cr_expect("complaint from outside U2' (left out at the shares close)", c3, 4294967295, _cr_complaint(4294967295, 7), "soul already left out")
    // No complaint: the check close goes straight to the final SET 2.
    let c4 = cr_replay(roster, vc, rec, 3)
    ce_eq("state after the check close (no complaint): Y", sa4c_state(c4), SA4C_ST_Y)
    ce_str_eq("nobody accused", sa4e_ids_str(sa4c_accused(c4)), "")
    let cn = sa4c_counters(c4)
    ce_eq("honest round: no blame crypto", cn[0] + cn[1] + cn[2] + cn[3], 0)
    // A soul without END 4 is left out ("did not finish the check phase").
    let c5 = cr_replay(roster, vc, rec, 2)
    let j5 = 0
    while j5 < 4 {
        let o5 = rec[2][j5]
        let q5 = 0
        while q5 < len(o5) {
            sa4c_recv(c5, SA4H_IDS[j5], o5[q5])
            q5 = q5 + 1
        }
        j5 = j5 + 1
    }
    let cl5 = sa4c_close(c5)
    ce_eq("check close with one soul silent", cl5[0], 1)
    ce_check("silent in the check phase: left out", find_bytes(sa4c_why(c5, 4294967295), "did not finish the check phase") >= 0)
    ce_str_eq("final U2 = the other four", sa4e_ids_str(sa4c_set(c5, 2)), "7,300,65536,70000")
    return 0
}

// A coordinator in the OPEN phase: 7 complained about 300 (x = 2).
fn _cr_open_state(roster, vc, rec) {
    let c = cr_replay(roster, vc, rec, 2)
    let j = 0
    while j < 5 {
        let id = SA4H_IDS[j]
        if j == 0 {
            sa4c_recv(c, id, _cr_complaint(7, 300))
            sa4c_recv(c, id, sa4w_fmt_end(CR_R, 4, 7, 1))
        } else {
            sa4c_recv(c, id, sa4w_fmt_end(CR_R, 4, id, 0))
        }
        j = j + 1
    }
    let cl = sa4c_close(c)
    ce_eq("check close with a complaint", cl[0], 1)
    return c
}

// END 4 0 from every soul of the round except skip1 and skip2.
fn _cr_end4_rest(c, skip1, skip2) {
    let j = 0
    while j < 5 {
        let id = SA4H_IDS[j]
        if id != skip1 {
            if id != skip2 { sa4c_recv(c, id, sa4w_fmt_end(CR_R, 4, id, 0)) }
        }
        j = j + 1
    }
    return 0
}

// Messages of a close result routed to id (to == 0: to anyone) whose line
// starts with p (p == "": any line).
fn _cr_routed(cl, to, p) {
    let n = 0
    let k = 0
    while k < len(cl[2]) {
        let hit = 1
        if to != 0 {
            if cl[2][k][0] != to { hit = 0 }
        }
        if len(p) > 0 {
            if sa4h_starts(cl[2][k][1], p) == 0 { hit = 0 }
        }
        n = n + hit
        k = k + 1
    }
    return n
}

// The check close forwards a complaint only if both its complainer and the
// accused are still in the round (SPEC A2.4c 8.5).
fn test_check_close_filters(roster, vc, rec) {
    // A complainer left out after complaining (a second complaint about
    // the same soul): nothing is forwarded, no open phase.
    let ca = cr_replay(roster, vc, rec, 2)
    sa4c_recv(ca, 7, _cr_complaint(7, 300))
    sa4c_recv(ca, 7, _cr_complaint(7, 300))
    _cr_end4_rest(ca, 7, 0)
    let cla = sa4c_close(ca)
    ce_str_eq("complainer left out after complaining: why", sa4c_why(ca, 7), "two complaints about one soul")
    ce_eq("complainer left out after complaining: state Y (no open phase)", sa4c_state(ca), SA4C_ST_Y)
    ce_str_eq("complainer left out after complaining: nobody accused", sa4e_ids_str(sa4c_accused(ca)), "")
    ce_eq("complainer left out after complaining: no ACCUSE, no COMPLAINT routed", _cr_routed(cla, 0, "SA4_ACCUSE ") + _cr_routed(cla, 0, "SA4_COMPLAINT "), 0)
    ce_eq("complainer left out after complaining: the accused gets only SET 2", _cr_routed(cla, 300, ""), 1)
    ce_str_eq("complainer left out after complaining: final U2", sa4e_ids_str(sa4c_set(ca, 2)), "300,65536,70000,4294967295")
    // A complainer that sent its complaint but no END 4 is left out at the
    // close ("did not finish the check phase"); its complaint is dropped.
    let cb = cr_replay(roster, vc, rec, 2)
    sa4c_recv(cb, 7, _cr_complaint(7, 300))
    _cr_end4_rest(cb, 7, 0)
    let clb = sa4c_close(cb)
    ce_str_eq("complainer without END 4: why", sa4c_why(cb, 7), "did not finish the check phase")
    ce_eq("complainer without END 4: state Y", sa4c_state(cb), SA4C_ST_Y)
    ce_eq("complainer without END 4: no ACCUSE routed", _cr_routed(clb, 0, "SA4_ACCUSE "), 0)
    // The accused left out before the check close (a wrong END phase):
    // nothing is routed to it, no open phase.
    let cc = cr_replay(roster, vc, rec, 2)
    sa4c_recv(cc, 7, _cr_complaint(7, 300))
    sa4c_recv(cc, 7, sa4w_fmt_end(CR_R, 4, 7, 1))
    sa4c_recv(cc, 300, sa4w_fmt_end(CR_R, 1, 300, 0))
    _cr_end4_rest(cc, 7, 300)
    let clc = sa4c_close(cc)
    ce_str_eq("accused left out in the check phase: why", sa4c_why(cc, 300), "wrong END phase")
    ce_eq("accused left out in the check phase: state Y (no open phase)", sa4c_state(cc), SA4C_ST_Y)
    ce_str_eq("accused left out in the check phase: nobody accused", sa4e_ids_str(sa4c_accused(cc)), "")
    ce_eq("accused left out in the check phase: nothing routed to it", _cr_routed(clc, 300, ""), 0)
    ce_eq("accused left out in the check phase: no ACCUSE routed", _cr_routed(clc, 0, "SA4_ACCUSE "), 0)
    ce_str_eq("accused left out in the check phase: final U2 keeps the complainer", sa4e_ids_str(sa4c_set(cc, 2)), "7,65536,70000,4294967295")
    ce_eq("accused left out in the check phase: not blamed", sa4c_blamed(cc, 300), 0)
    return 0
}

// sa4c_keep / sa4c_expect in state 9 with left-out souls (SPEC 8.3: keep is
// U2' not left out, expect the accused not left out).
fn test_open_keep(roster, vc, rec) {
    let c = cr_replay(roster, vc, rec, 2)
    sa4c_recv(c, 7, _cr_complaint(7, 300))
    sa4c_recv(c, 7, _cr_complaint(7, 65536))
    sa4c_recv(c, 7, sa4w_fmt_end(CR_R, 4, 7, 2))
    _cr_end4_rest(c, 7, 4294967295)
    let cl = sa4c_close(c)
    ce_eq("open phase with a soul silent in the check phase", cl[0], 1)
    ce_eq("state OPEN", sa4c_state(c), SA4C_ST_OPEN)
    ce_str_eq("silent soul: why", sa4c_why(c, 4294967295), "did not finish the check phase")
    ce_str_eq("accused: 300 and 65536", sa4e_ids_str(sa4c_accused(c)), "300,65536")
    ce_str_eq("expect: the accused", sa4e_ids_str(sa4c_expect(c)), "300,65536")
    ce_str_eq("keep: U2' without the silent soul", sa4e_ids_str(sa4c_keep(c)), "7,300,65536,70000")
    ce_eq("nothing routed to the silent soul", _cr_routed(cl, 4294967295, ""), 0)
    // An accused left out in the open phase leaves expect and keep.
    sa4c_recv(c, 65536, sa4w_fmt_end(CR_R, 4, 65536, 0))
    ce_str_eq("accused left out in state 9: why", sa4c_why(c, 65536), "wrong END phase")
    ce_str_eq("expect: the live accused", sa4e_ids_str(sa4c_expect(c)), "300")
    ce_str_eq("keep: U2' not left out", sa4e_ids_str(sa4c_keep(c)), "7,300,70000")
    return 0
}

fn test_open_phase(roster, vc, rec) {
    let c = _cr_open_state(roster, vc, rec)
    ce_eq("state OPEN", sa4c_state(c), SA4C_ST_OPEN)
    ce_str_eq("accused: 300", sa4e_ids_str(sa4c_accused(c)), "300")
    ce_str_eq("expect: the accused only", sa4e_ids_str(sa4c_expect(c)), "300")
    ce_str_eq("keep: all of U2'", sa4e_ids_str(sa4c_keep(c)), "7,300,65536,70000,4294967295")
    // No END 5 from the accused: the bogus complaint still costs 7 its
    // place (code 5), then 300 is left out unblamed, and |U2| = 3 < t.
    let cq = _cr_open_state(roster, vc, rec)
    let msgs = sa4c_close(cq)
    ce_eq("open close without END 5: cancelled", msgs[0], 0)
    ce_check("cancel reason (" + msgs[1] + ")", find_bytes(msgs[1], "|U2| 3 below t") >= 0)
    ce_str_eq("silent accused: why", sa4c_why(cq, 300), "did not finish the open phase")
    ce_eq("silent accused: not blamed (its complaint was not judged against it)", sa4c_blamed(cq, 300), 0)
    ce_eq("bogus complainer: code 5", sa4c_blamed(cq, 7), 5)
    let e = cr_zero32()
    cr_expect("opening for another id", _cr_open_state(roster, vc, rec), 300, sa4w_fmt_open(CR_R, 7, 300, e), "opening for another id")
    cr_expect("opening for a complaint not forwarded", _cr_open_state(roster, vc, rec), 300, sa4w_fmt_open(CR_R, 300, 65536, e), "opening for a complaint that was not forwarded")
    cr_expect("opening about an unknown id", _cr_open_state(roster, vc, rec), 300, sa4w_fmt_open(CR_R, 300, 8, e), "opening for a complaint that was not forwarded")
    let c2 = _cr_open_state(roster, vc, rec)
    sa4c_recv(c2, 300, sa4w_fmt_open(CR_R, 300, 7, e))
    cr_expect("two openings for one complaint", c2, 300, sa4w_fmt_open(CR_R, 300, 7, e), "two openings for one complaint")
    cr_expect("END 5 count differs", _cr_open_state(roster, vc, rec), 300, sa4w_fmt_end(CR_R, 5, 300, 1), "END count differs")
    cr_expect("END 5 for another id", _cr_open_state(roster, vc, rec), 300, sa4w_fmt_end(CR_R, 5, 7, 0), "END for another id")
    cr_expect("END 4 in the open phase", _cr_open_state(roster, vc, rec), 300, sa4w_fmt_end(CR_R, 4, 300, 0), "wrong END phase")
    let c3 = _cr_open_state(roster, vc, rec)
    sa4c_recv(c3, 300, sa4w_fmt_end(CR_R, 5, 300, 0))
    cr_expect("opening after END 5", c3, 300, sa4w_fmt_open(CR_R, 300, 7, e), "line after END")
    cr_expect("complaint in the open phase", _cr_open_state(roster, vc, rec), 300, _cr_complaint(300, 7), "unexpected line while collecting openings")
    cr_expect("a non-accused soul in the open phase", _cr_open_state(roster, vc, rec), 65536, sa4w_fmt_end(CR_R, 5, 65536, 0), "not in the current set")
    // The forged complaint (zero leaf) is judged: the leaf is not the
    // routed line's, so 7 is out with code 5; 300 stays.
    let c4 = _cr_open_state(roster, vc, rec)
    sa4c_recv(c4, 300, sa4w_fmt_end(CR_R, 5, 300, 0))
    sa4c_close(c4)
    ce_eq("bogus leaf: complainer code 5", sa4c_blamed(c4, 7), 5)
    ce_str_eq("bogus leaf: why", sa4c_why(c4, 7), "complaint about soul 300 names a share it was not sent (not proven)")
    ce_eq("bogus leaf: accused not blamed", sa4c_blamed(c4, 300), 0)
    ce_str_eq("final U2 without the complainer", sa4e_ids_str(sa4c_set(c4, 2)), "300,65536,70000,4294967295")
    ce_eq("state Y", sa4c_state(c4), SA4C_ST_Y)
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let rec = cr_record(roster, vc)
    test_adv(roster, vc, rec)
    test_shares(roster, vc, rec)
    test_y(roster, vc, rec)
    test_sig3(roster, vc, rec)
    test_reveal(roster, vc, rec)
    test_shares_v3(roster, vc, rec)
    test_check_phase(roster, vc, rec)
    test_open_phase(roster, vc, rec)
    test_check_close_filters(roster, vc, rec)
    test_open_keep(roster, vc, rec)
    ce_summary("sa4_coord_refuse")
}

main()
