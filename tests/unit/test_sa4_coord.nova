// CE_TEST_TIMEOUT: 240
// End-to-end tests of src/learning/sa4_coord.nova (A2.2b) with real souls
// (sa4_soul.nova), through tests/sa4_harness.nova's sa4e_round driver.
// N = 5, t = 4, all in round 33 so the shared vcache absorbs repeats:
//   - a soul stops after sending its shares: U3 has 4 souls, the
//     coordinator rebuilds the dropped soul's s key from exactly t = 4
//     reveals (checked against its advertised s_pk) and the sum matches;
//   - the same round with one s-share altered by a revealer (v4-sa2): the
//     rebuilt s key does not match the advertised s_pk, the liar's proof
//     fails and it is excluded, which leaves |R| - 1 = 3 < t good shares,
//     so unmasking is still refused (with |R| > t it gives the right sum:
//     test_sa4_coord6.nova);
//   - two souls stop after ADV: |U2| = 3 < t, the round is cancelled and
//     nothing can be unmasked.
// The honest N = 3 round is in test_sa4_coord_n3.nova.

import "../ce_test.nova"
import "../sa4_harness.nova"

fn _ids(l) {
    let s = ""
    let i = 0
    while i < len(l) {
        if i > 0 { s = s + "," }
        s = s + int_to_str(l[i])
        i = i + 1
    }
    return s
}

fn test_dropout_exactly_t(vc) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, 33, vc, 0)
    let c = sa4e_coord(roster, 33, vc)
    let res = sa4e_round(roster, souls, c, [[2, 2]], list_new())
    ce_eq("drop-after-shares round unmasks", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_str_eq("U2 has all five", _ids(sa4c_set(c, 2)), "7,300,65536,70000,4294967295")
    ce_str_eq("U3 lacks the dropped soul", _ids(sa4c_set(c, 3)), "7,300,70000,4294967295")
    ce_eq("exactly t = 4 revealers", len(sa4c_set(c, 5)), 4)
    ce_eq("sum over U3", sa4h_same(res[2], sa4h_expected([1, 2, 4, 5])), 1)
    return 0
}

fn test_cancel(vc) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, 33, vc, 0)
    let c = sa4e_coord(roster, 33, vc)
    let res = sa4e_round(roster, souls, c, [[3, 1], [4, 1]], list_new())
    ce_eq("round with |U2| < t does not unmask", res[0], 0)
    ce_check("cancelled at U2' (" + res[1] + ")", find_bytes(res[1], "cancelled: |U2'| 3 below t") >= 0)
    ce_check("a soul without END 1 is left out", find_bytes(sa4c_why(c, 70000), "share batch incomplete") >= 0)
    ce_eq("not blamed", sa4c_blamed(c, 70000), 0)
    ce_eq("state cancelled", sa4c_state(c), SA4C_ST_CANCELLED)
    ce_eq("unmask refused after cancel", sa4c_unmask(c)[0], 0)
    ce_eq("close refused after cancel", sa4c_close(c)[0], 0)
    return 0
}

fn test_bad_s_share(vc) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, 33, vc, 0)
    let c = sa4e_coord(roster, 33, vc)
    // Soul 7 alters its s-share about the dropped soul 65536.
    let res = sa4e_round(roster, souls, c, [[2, 2]], [[0, 4, 4]])
    ce_eq("altered s-share: no sum", res[0], 0)
    ce_check("refused: fewer than t good shares (" + res[1] + ")", find_bytes(res[1], "fewer than t good shares about soul 65536") >= 0)
    ce_str_eq("the liar is excluded", _ids(sa4c_bad_revealers(c)), "7")
    ce_check("the liar's reason names the dealer", find_bytes(sa4c_why(c, 7), "reveal about soul 65536 does not match its commitment") >= 0)
    ce_eq("the liar is not recorded as an abort", sa4c_aborted(c, 7), 0)
    return 0
}

fn main() {
    let vc = list_new()
    test_dropout_exactly_t(vc)
    test_bad_s_share(vc)
    test_cancel(vc)
    ce_summary("sa4_coord")
}

main()
