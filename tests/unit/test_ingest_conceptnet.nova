// Unit tests for src/ingest/importers/conceptnet.nova.

import "../ce_test.nova"
import "../../src/ingest/importers/conceptnet.nova"

fn test_concept_local() {
    ce_eq("en dog", cn_concept_local("/c/en/dog", 0), "dog")
    ce_eq("fr chien", cn_concept_local("/c/fr/chien", 0), "chien")
    ce_eq("en+lang", cn_concept_local("/c/en/dog", 1), "en:dog")
    ce_eq("with sense", cn_concept_local("/c/en/dog/n", 0), "dog")
}

fn test_relation_local() {
    ce_eq("IsA", cn_relation_local("/r/IsA"), "IsA")
    ce_eq("PartOf", cn_relation_local("/r/PartOf"), "PartOf")
    // Non-standard input returned as-is.
    ce_eq("bare", cn_relation_local("weird"), "weird")
}

fn test_weight_parse_integer() {
    let w = cn_weight("{\"weight\":2}")
    ce_eq("2000 milli", w, 2000)
}

fn test_weight_parse_decimal() {
    let w = cn_weight("{\"weight\":2.828}")
    ce_eq("2828 milli", w, 2828)
}

fn test_weight_missing() {
    ce_eq("no weight -> 0", cn_weight("{}"), 0)
    ce_eq("empty -> 0", cn_weight(""), 0)
}

fn test_belief_for_weight() {
    ce_eq("w=1.0 -> 600", cn_belief_for_weight(1000), 600)
    ce_eq("w=2.0 -> 700", cn_belief_for_weight(2000), 700)
    ce_eq("w=3.0 -> 800", cn_belief_for_weight(3000), 800)
    ce_eq("cap at 800", cn_belief_for_weight(10000), 800)
    ce_eq("negative -> base", cn_belief_for_weight(0 - 100), 500)
}

fn test_parse_one_assertion() {
    // uri\trelation\tstart\tend\tjson
    let text = "/a/[/r/IsA/,/c/en/dog/,/c/en/animal/]\t/r/IsA\t/c/en/dog\t/c/en/animal\t{\"weight\":2.828}\n"
    let r = cn_parse_text(text, "commonsense", "src:conceptnet:demo", 0)
    let rec = cn_records(r)[0]
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("1 imp", len(cur_imps(rec)), 1)
    ce_eq("first atom = dog", cur_atoms(rec)[0][CUR_ATOM_LABEL], "dog")
    ce_eq("second = animal", cur_atoms(rec)[1][CUR_ATOM_LABEL], "animal")
    ce_eq("imp EMPIRICAL", cur_imps(rec)[0][CUR_IMP_STR], "EMPIRICAL")
    // belief ~782 (2828/10=282, +500=782)
    ce_eq("belief seed=782", cur_atoms(rec)[0][CUR_ATOM_BELIEF], 782)
}

fn test_parse_multiple() {
    let text = "/a/x\t/r/IsA\t/c/en/dog\t/c/en/animal\t{\"weight\":3.0}\n"
             + "/a/y\t/r/IsA\t/c/en/cat\t/c/en/animal\t{\"weight\":3.5}\n"
    let r = cn_parse_text(text, "cs", "src:conceptnet:x", 0)
    let rec = cn_records(r)[0]
    ce_eq("3 atoms", len(cur_atoms(rec)), 3)
    ce_eq("2 imps", len(cur_imps(rec)), 2)
}

fn test_missing_field_row_skipped() {
    let text = "/a\t/r/IsA\t/c/en/dog\n"   // only 3 fields
    let r = cn_parse_text(text, "cs", "src:x", 0)
    let rec = cn_records(r)[0]
    ce_eq("0 atoms", len(cur_atoms(rec)), 0)
}

fn test_keep_lang_prefixes_labels() {
    let text = "/a\t/r/IsA\t/c/en/dog\t/c/en/animal\t{\"weight\":2}\n"
    let r = cn_parse_text(text, "cs", "src:x", 1)
    let rec = cn_records(r)[0]
    ce_eq("en_dog label", cur_atoms(rec)[0][CUR_ATOM_LABEL], "en_dog")
}

fn main() {
    test_concept_local()
    test_relation_local()
    test_weight_parse_integer()
    test_weight_parse_decimal()
    test_weight_missing()
    test_belief_for_weight()
    test_parse_one_assertion()
    test_parse_multiple()
    test_missing_field_row_skipped()
    test_keep_lang_prefixes_labels()
    ce_summary("ingest_conceptnet")
}

main()
