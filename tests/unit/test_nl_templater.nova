// Unit tests for src/nl/templater.nova (ADR-0104 R48p4).
//
// Tests the deterministic renderer that turns a ProposalResult (from
// skill_run) or an ExecutionResult (from nl_execute) into English,
// covering: the OK / refused split, source listing, disagreement
// callout, persona projection line, effector-calls block, admin-action
// dispatch, and the style-capsule trailer hook (ADR-0108).

import "../ce_test.nova"
import "../../src/nl/templater.nova"
import "../../src/nl/executor.nova"
import "../../src/nl/query_shape.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/persona/persona.nova"
import "../../src/persona/persona_project.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

// ---- test helpers --------------------------------------------------------

// Build an atom on `kg_label` with a specific belief mean, expressed
// as alpha/beta pseudo-counts. mean(a) = alpha / (alpha + beta) * 1000.
// e.g. alpha=8000,beta=2000 -> mean=800.
fn _mk_atom(kg_label, id, label, alpha, beta) {
    let a = atom_new(kg_label, id, ATOM_FACT, label, 0)
    list_set(a[A_BELIEF], 0, alpha)
    list_set(a[A_BELIEF], 1, beta)
    return a
}

// Build a projection tuple in the shape persona_project returns.
fn _mk_projection(valence, arousal, risk, similar, prefs) {
    let p = list_new()
    push(p, valence)
    push(p, arousal)
    push(p, risk)
    let sim = list_new()
    let i = 0
    while i < similar { push(sim, list_new()) i = i + 1 }
    push(p, sim)
    let pr = list_new()
    let j = 0
    while j < prefs { push(pr, list_new()) j = j + 1 }
    push(p, pr)
    push(p, list_new())              // trace
    return p
}

// Case-insensitive substring: does `hay` contain `needle`? Returns 1/0.
fn _t_contains(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- ProposalResult happy path -------------------------------------------

fn test_render_ok_body_and_trailer() {
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "here is what I know about mars")
    skill_pr_set_confidence(pr, 750)
    skill_pr_set_ok(pr)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("body present",       _t_contains(out, "here is what I know about mars"))
    ce_check("confidence in trailer", _t_contains(out, "Confidence: 750/1000"))
    ce_check("parser in trailer",   _t_contains(out, "parser: grammar"))
    ce_check("default style",       _t_contains(out, "style: default"))
    ce_check("no ⚠",                len(out) > 0)
    ce_eq("no refusal marker",      _t_contains(out, "Refused"), 0)
}

fn test_render_deterministic() {
    // Same PR + persona + parser -> byte-identical output.
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "hello world")
    skill_pr_set_confidence(pr, 600)
    skill_pr_set_ok(pr)
    skill_pr_add_atom(pr, _mk_atom("kg_a", 0, "sun", 7000, 3000))
    skill_pr_add_atom(pr, _mk_atom("kg_b", 0, "sun", 2000, 8000))
    let a = templater_render_proposal(pr, "grammar", 0)
    let b = templater_render_proposal(pr, "grammar", 0)
    ce_check("same length", len(a) == len(b))
    ce_check("byte-identical", str_eq_bytes(a, b) == 1)
}

// ---- sources listing -----------------------------------------------------

fn test_render_sources_listed() {
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "answer body")
    skill_pr_set_confidence(pr, 800)
    skill_pr_set_ok(pr)
    skill_pr_add_atom(pr, _mk_atom("solar_system", 0, "mars", 8000, 2000))
    skill_pr_add_atom(pr, _mk_atom("solar_system", 1, "phobos", 6000, 4000))
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("sources header",   _t_contains(out, "Sources cited (2 atoms):"))
    ce_check("mars line",        _t_contains(out, "[solar_system] mars: belief 800/1000"))
    ce_check("phobos line",      _t_contains(out, "[solar_system] phobos: belief 600/1000"))
}

fn test_render_single_atom_singular() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    skill_pr_add_atom(pr, _mk_atom("kg", 0, "x", 5000, 5000))
    let out = templater_render_proposal(pr, "grammar", 0)
    // 1 atom -> "1 atom):" not "1 atoms):"
    ce_check("singular atom", _t_contains(out, "Sources cited (1 atom):"))
    ce_eq("no plural s",      _t_contains(out, "Sources cited (1 atoms):"), 0)
}

fn test_render_no_sources_when_atoms_empty() {
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "no atoms cited")
    skill_pr_set_ok(pr)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_eq("no sources header", _t_contains(out, "Sources cited"), 0)
}

// ---- disagreement scan ---------------------------------------------------

fn test_render_disagreement_surfaced() {
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "planets research")
    skill_pr_set_ok(pr)
    // Same label 'mars' from two KGs, belief 800 vs 200 -> spread 600.
    skill_pr_add_atom(pr, _mk_atom("solar_system", 0, "mars", 8000, 2000))
    skill_pr_add_atom(pr, _mk_atom("folk_astronomy", 0, "mars", 2000, 8000))
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("disagree marker",   _t_contains(out, "⚠ Sources disagree on 'mars'"))
    ce_check("spread reported",   _t_contains(out, "spread 600 milli"))
    ce_check("two-sources",       _t_contains(out, "2 sources"))
    ce_check("kg_a mentioned",    _t_contains(out, "solar_system believes 800"))
    ce_check("kg_b mentioned",    _t_contains(out, "folk_astronomy believes 200"))
}

fn test_render_no_disagreement_when_close() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    // spread 100 milli < 300 threshold
    skill_pr_add_atom(pr, _mk_atom("kg_a", 0, "sun", 7000, 3000))
    skill_pr_add_atom(pr, _mk_atom("kg_b", 0, "sun", 6000, 4000))
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_eq("no disagree callout", _t_contains(out, "disagree"), 0)
}

fn test_render_no_disagreement_when_single_kg() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    // Same label, same KG (would be a duplicate cite) -> no disagreement.
    skill_pr_add_atom(pr, _mk_atom("kg_a", 0, "x", 8000, 2000))
    skill_pr_add_atom(pr, _mk_atom("kg_a", 1, "x", 2000, 8000))
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_eq("no cross-KG disagreement", _t_contains(out, "disagree"), 0)
}

// ---- persona projection line ---------------------------------------------

fn test_render_projection_line() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let proj = _mk_projection(425, 200, 500, 1, 2)
    list_set(pr, PR_PROJECTION, proj)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("projection header", _t_contains(out, "Persona projection"))
    ce_check("valence signed",    _t_contains(out, "valence +425"))
    ce_check("arousal shown",     _t_contains(out, "arousal 200"))
    ce_check("risk shown",        _t_contains(out, "risk 500/1000"))
    ce_check("similar count",     _t_contains(out, "1 similar past decision"))
    ce_check("pref count",        _t_contains(out, "2 matching preferences"))
}

fn test_render_projection_negative_valence_prints_minus() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let proj = _mk_projection(0 - 250, 100, 400, 0, 0)
    list_set(pr, PR_PROJECTION, proj)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("negative valence", _t_contains(out, "valence -250"))
}

fn test_render_no_projection_when_neutral() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    // All-zero projection with empty lists -> no line.
    let proj = _mk_projection(0, 0, 0, 0, 0)
    list_set(pr, PR_PROJECTION, proj)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_eq("no projection line", _t_contains(out, "Persona projection"), 0)
}

fn test_render_projection_absent_when_null() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    // Default PR_PROJECTION is 0 (no persona attached).
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_eq("no projection line", _t_contains(out, "Persona projection"), 0)
}

// ---- effector calls ------------------------------------------------------

fn test_render_effector_calls_listed() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let args = list_new()
    push(args, "alice") push(args, "hello world")
    skill_pr_add_effector_call(pr, "send_message", args)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("described header", _t_contains(out, "Would perform (described, not executed):"))
    ce_check("call name + args", _t_contains(out, "- send_message(alice, hello world)"))
}

fn test_render_no_effector_block_when_empty() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_eq("no described header", _t_contains(out, "Would perform"), 0)
}

// ---- refusal short-circuit -----------------------------------------------

fn test_render_refused_short_circuits() {
    let pr = skill_pr_new()
    skill_pr_refuse(pr, "min-confidence: 100 below threshold 500")
    // Attach atoms + projection + effector calls to prove they're
    // SUPPRESSED for a refused proposal.
    skill_pr_add_atom(pr, _mk_atom("kg", 0, "x", 5000, 5000))
    let proj = _mk_projection(100, 50, 400, 0, 0)
    list_set(pr, PR_PROJECTION, proj)
    skill_pr_add_effector_call(pr, "send", list_new())
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("refused marker",     _t_contains(out, "⚠ Refused:"))
    ce_check("reason echoed",      _t_contains(out, "min-confidence"))
    ce_eq("no sources on refuse",  _t_contains(out, "Sources cited"), 0)
    ce_eq("no projection on refuse", _t_contains(out, "Persona projection"), 0)
    ce_eq("no effectors on refuse", _t_contains(out, "Would perform"), 0)
    ce_check("trailer present",    _t_contains(out, "Confidence:"))
}

// ---- style capsule (ADR-0108 hook) ---------------------------------------

fn test_render_style_default_when_no_persona() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("style default", _t_contains(out, "style: default"))
}

fn test_render_style_default_when_persona_has_no_capsule() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let p = persona_new("u1", "Alice", "test", 0)
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("still default", _t_contains(out, "style: default"))
}

fn test_render_style_names_capsule_when_set() {
    let pr = skill_pr_new()
    skill_pr_set_ok(pr)
    let p = persona_new("u1", "Alice", "test", 0)
    persona_set_style_capsule(p, "curt_technical", 100)
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("names capsule", _t_contains(out, "style: curt_technical"))
}

// ---- ExecutionResult top-level dispatch ----------------------------------

fn test_render_er_refusal() {
    let q = sq_research("mars", "what is mars", "grammar")
    let er = nl_er_new(q, "grammar")
    // Simulate an NL-layer refusal.
    list_set(er, ER_REFUSAL_REASON, "no skill registry supplied")
    let out = templater_render(er, 0)
    ce_check("cannot-answer",     _t_contains(out, "⚠ Cannot answer:"))
    ce_check("reason echoed",     _t_contains(out, "no skill registry supplied"))
    ce_check("trailer present",   _t_contains(out, "parser: grammar"))
    // Side-effect: fills templated_answer.
    ce_check("templated_answer filled",
             len(nl_er_templated_answer(er)) > 0)
}

fn test_render_er_admin_action() {
    let q = sq_retract("bad_claim", "retract bad_claim", "grammar")
    let er = nl_er_new(q, "grammar")
    list_set(er, ER_OK, 1)
    list_set(er, ER_ADMIN_ACTION, "retract")
    let args = list_new()
    push(args, "bad_claim")
    list_set(er, ER_ADMIN_ARGS, args)
    let out = templater_render(er, 0)
    ce_check("admin queued",     _t_contains(out, "Admin action queued: retract"))
    ce_check("arg in call",      _t_contains(out, "(bad_claim)"))
    ce_check("parser in trailer", _t_contains(out, "parser: grammar"))
}

fn test_render_er_admin_no_args() {
    let q = sq_capsule_list("list capsules", "grammar")
    let er = nl_er_new(q, "grammar")
    list_set(er, ER_OK, 1)
    list_set(er, ER_ADMIN_ACTION, "capsule_list")
    let out = templater_render(er, 0)
    ce_check("no-args admin", _t_contains(out, "Admin action queued: capsule_list"))
    // No parens when args is empty.
    ce_eq("no parens", _t_contains(out, "capsule_list("), 0)
}

fn test_render_er_none_kind() {
    // Empty input: kind NONE, no proposal_result. Render a soft response.
    let q = sq_none("", "grammar")
    let er = nl_er_new(q, "grammar")
    list_set(er, ER_OK, 1)   // NONE is OK, just nothing to do
    let out = templater_render(er, 0)
    ce_check("soft none",       _t_contains(out, "nothing to answer"))
    ce_check("trailer present", _t_contains(out, "parser: grammar"))
}

fn test_render_er_dispatches_to_proposal_when_pr_present() {
    let q = sq_research("sun", "what is sun", "grammar")
    let er = nl_er_new(q, "grammar")
    list_set(er, ER_OK, 1)
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "here is the sun")
    skill_pr_set_confidence(pr, 900)
    skill_pr_set_ok(pr)
    skill_pr_add_atom(pr, _mk_atom("solar_system", 0, "sun", 9000, 1000))
    list_set(er, ER_PROPOSAL_RESULT, pr)
    let out = templater_render(er, 0)
    ce_check("proposal body",   _t_contains(out, "here is the sun"))
    ce_check("sources block",   _t_contains(out, "Sources cited"))
    ce_check("confidence",      _t_contains(out, "Confidence: 900/1000"))
}

fn test_render_er_null_returns_something() {
    let out = templater_render(0, 0)
    ce_check("null-er handled", len(out) > 0)
}

// ---- side-effect: templated_answer is set --------------------------------

fn test_render_sets_templated_answer_field() {
    let q = sq_research("x", "what is x", "grammar")
    let er = nl_er_new(q, "grammar")
    list_set(er, ER_OK, 1)
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "answer")
    skill_pr_set_ok(pr)
    list_set(er, ER_PROPOSAL_RESULT, pr)
    ce_eq("initially empty", len(nl_er_templated_answer(er)), 0)
    let out = templater_render(er, 0)
    ce_check("field populated after render",
             _t_contains(nl_er_templated_answer(er), "answer"))
    ce_check("returned string matches field",
             str_eq_bytes(out, nl_er_templated_answer(er)) == 1)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_render_ok_body_and_trailer()
    test_render_deterministic()
    test_render_sources_listed()
    test_render_single_atom_singular()
    test_render_no_sources_when_atoms_empty()
    test_render_disagreement_surfaced()
    test_render_no_disagreement_when_close()
    test_render_no_disagreement_when_single_kg()
    test_render_projection_line()
    test_render_projection_negative_valence_prints_minus()
    test_render_no_projection_when_neutral()
    test_render_projection_absent_when_null()
    test_render_effector_calls_listed()
    test_render_no_effector_block_when_empty()
    test_render_refused_short_circuits()
    test_render_style_default_when_no_persona()
    test_render_style_default_when_persona_has_no_capsule()
    test_render_style_names_capsule_when_set()
    test_render_er_refusal()
    test_render_er_admin_action()
    test_render_er_admin_no_args()
    test_render_er_none_kind()
    test_render_er_dispatches_to_proposal_when_pr_present()
    test_render_er_null_returns_something()
    test_render_sets_templated_answer_field()
    ce_summary("nl_templater")
}

main()
