// Unit tests for B5 (E2 production glue): pip_ingest_ex and its flags
// (PIP_F_NO_RESEED, PIP_F_TIER_WEIGHT, PIP_F_SIGNED_ATTR), labelled and
// signed meta-observer attribution (mo_attribute_in, mo_attribute_signed,
// mo_poll_reg, mo_live_split, mo_source_reliability) and the continuous
// per-host weight in source_authority. Every flag test has a control that
// runs the same records with the flag off.

import "../ce_test.nova"
import "../../src/ingest/pipeline.nova"
import "../../src/learning/source_authority.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _ab(reg, kgname, label) {
    let k = kg_find(reg, kgname)
    let a = kg_find_atom(k, label)
    return atom_belief(a)
}

// Source A declares x at 500 and contradicts it three times; source B then
// declares x at 600 (the T1 case from the B5 mapping).
fn _t1_records() {
    let r = list_new()
    let a = cur_new("e2", "src:e2:a")
    cur_add_atom(a, "x", ATOM_FACT, 500)
    cur_add_obs(a, "x", 0 - 1, 1000)
    cur_add_obs(a, "x", 0 - 1, 1000)
    cur_add_obs(a, "x", 0 - 1, 1000)
    push(r, a)
    let b = cur_new("e2", "src:e2:b")
    cur_add_atom(b, "x", ATOM_FACT, 600)
    push(r, b)
    return r
}

// ---- flags = 0 is the legacy pipeline --------------------------------------

// Status lists: slots PIP_ERR_DETAIL and PIP_CAPSULE_NAME hold strings,
// every other slot an int.
fn _same_status(x, y) {
    if len(x) != len(y) { return 0 }
    let i = 0
    while i < len(x) {
        if i == PIP_ERR_DETAIL || i == PIP_CAPSULE_NAME {
            if str_eq_bytes(x[i], y[i]) == 0 { return 0 }
        } else {
            if x[i] != y[i] { return 0 }
        }
        i = i + 1
    }
    return 1
}

fn test_flags_zero_matches_legacy() {
    let recs = _t1_records()
    let c = cur_new("e2", "src:e2:c")
    cur_add_atom(c, "y", ATOM_FACT, 700)
    cur_add_imp(c, "x", "y", "EMPIRICAL")
    cur_add_obs(c, "y", 1, 400)
    cur_add_cite(c, "src:e2:c", "src:e2:a", "supports")
    push(recs, c)
    let reg1 = kg_registry_new()
    let reg2 = kg_registry_new()
    let mo1 = mo_new()
    let mo2 = mo_new()
    let i = 0
    let same_status = 1
    while i < len(recs) {
        let s1 = pip_ingest(reg1, recs[i], mo1)
        let s2 = pip_ingest_ex(reg2, recs[i], mo2, 0, 0, 0)
        if _same_status(s1, s2) == 0 { same_status = 0 }
        i = i + 1
    }
    ce_eq("status lists identical", same_status, 1)
    let b1 = _ab(reg1, "e2", "x")
    let b2 = _ab(reg2, "e2", "x")
    ce_eq("alpha identical", b1[0], b2[0])
    ce_eq("beta identical", b1[1], b2[1])
    let y1 = _ab(reg1, "e2", "y")
    let y2 = _ab(reg2, "e2", "y")
    ce_eq("y alpha identical", y1[0], y2[0])
    ce_eq("y beta identical", y1[1], y2[1])
    let r1 = mo_report(mo1)
    let r2 = mo_report(mo2)
    ce_eq("same number of sources", len(r1), len(r2))
}

// ---- PIP_F_NO_RESEED (bug 3) -----------------------------------------------

fn test_reseed_default_and_flag() {
    // Control: the default pipeline wipes A's contradicting evidence.
    let recs = _t1_records()
    let reg = kg_registry_new()
    pip_ingest(reg, recs[0], 0)
    let b = _ab(reg, "e2", "x")
    ce_eq("after A: alpha 2500", b[0], 2500)
    ce_eq("after A: beta 5500", b[1], 5500)
    pip_ingest(reg, recs[1], 0)
    ce_eq("default: B's ATOM resets alpha", b[0], 3000)
    ce_eq("default: B's ATOM resets beta (evidence wiped)", b[1], 2000)
    // NO_RESEED keeps the evidence.
    let reg2 = kg_registry_new()
    pip_ingest_ex(reg2, recs[0], 0, 0, PIP_F_NO_RESEED, 0)
    pip_ingest_ex(reg2, recs[1], 0, 0, PIP_F_NO_RESEED, 0)
    let b2 = _ab(reg2, "e2", "x")
    ce_eq("no_reseed: alpha kept", b2[0], 2500)
    ce_eq("no_reseed: beta kept", b2[1], 5500)
    ce_eq("no_reseed: mean 312", bel_mean(b2), 312)
}

fn test_no_reseed_mints_and_keeps_positive() {
    let reg = kg_registry_new()
    let a = cur_new("e2", "src:e2:a")
    cur_add_atom(a, "z", ATOM_FACT, 500)
    let i = 0
    while i < 5 { cur_add_obs(a, "z", 1, 1000) i = i + 1 }
    let s = pip_ingest_ex(reg, a, 0, 0, PIP_F_NO_RESEED, 0)
    ce_eq("new atom still minted", pip_atoms_added(s), 1)
    let b = cur_new("e2", "src:e2:b")
    cur_add_atom(b, "z", ATOM_FACT, 900)
    let s2 = pip_ingest_ex(reg, b, 0, 0, PIP_F_NO_RESEED, 0)
    ce_eq("existing atom counted as seen", pip_atoms_seen(s2), 1)
    let z = _ab(reg, "e2", "z")
    ce_eq("evidence strength kept (10000)", z[0] + z[1], 10000)
}

fn test_no_reseed_empirical_imp() {
    let r = cur_new("e2", "src:e2:a")
    cur_add_atom(r, "p", ATOM_FACT, 500)
    cur_add_atom(r, "q", ATOM_FACT, 500)
    cur_add_imp(r, "p", "q", "EMPIRICAL")
    let w = cur_new("e2", "src:e2:b")
    cur_add_obs(w, "p-imp-q", 0 - 1, 1000)
    // Control: re-ingesting the imp record re-seeds the association at 800.
    let reg = kg_registry_new()
    pip_ingest(reg, r, 0)
    pip_ingest(reg, w, 0)
    pip_ingest(reg, r, 0)
    let c = _ab(reg, "e2", "p-imp-q")
    ce_eq("default: association reset (beta 1000)", c[1], 1000)
    let reg2 = kg_registry_new()
    pip_ingest_ex(reg2, r, 0, 0, PIP_F_NO_RESEED, 0)
    pip_ingest_ex(reg2, w, 0, 0, PIP_F_NO_RESEED, 0)
    pip_ingest_ex(reg2, r, 0, 0, PIP_F_NO_RESEED, 0)
    let c2 = _ab(reg2, "e2", "p-imp-q")
    ce_eq("no_reseed: association keeps the contradiction (beta 2000)", c2[1], 2000)
}

// ---- PIP_F_TIER_WEIGHT ------------------------------------------------------

fn _obs_record(tag, sign, w) {
    let r = cur_new("e2", tag)
    cur_add_atom(r, "f", ATOM_FACT, 500)
    cur_add_obs(r, "f", sign, w)
    return r
}

fn test_tier_weight() {
    let sa = sa_new()
    sa_host_set_weight(sa, mo_tag_to_host("src:e2:s1"), 750)
    sa_host_set_tier(sa, mo_tag_to_host("src:e2:s2"), SA_TIER_B)
    // Control: flag off ignores sa.
    let reg0 = kg_registry_new()
    pip_ingest_ex(reg0, _obs_record("src:e2:s1", 1, 1000), 0, 0, 0, sa)
    ce_eq("flag off: full weight", _ab(reg0, "e2", "f")[0], 3500)
    // Explicit continuous weight.
    let reg1 = kg_registry_new()
    pip_ingest_ex(reg1, _obs_record("src:e2:s1", 1, 1000), 0, 0, PIP_F_TIER_WEIGHT, sa)
    ce_eq("explicit weight 750", _ab(reg1, "e2", "f")[0], 2500 + 750)
    // Tier table.
    let reg2 = kg_registry_new()
    pip_ingest_ex(reg2, _obs_record("src:e2:s2", 0 - 1, 1000), 0, 0, PIP_F_TIER_WEIGHT, sa)
    ce_eq("tier B weight 500", _ab(reg2, "e2", "f")[1], 2500 + 500)
    // Unknown host: Tier C.
    let reg3 = kg_registry_new()
    pip_ingest_ex(reg3, _obs_record("src:e2:new", 1, 1000), 0, 0, PIP_F_TIER_WEIGHT, sa)
    ce_eq("unknown host tier C 200", _ab(reg3, "e2", "f")[0], 2500 + 200)
    // sa == 0: no scaling.
    let reg4 = kg_registry_new()
    pip_ingest_ex(reg4, _obs_record("src:e2:s1", 1, 1000), 0, 0, PIP_F_TIER_WEIGHT, 0)
    ce_eq("sa 0: full weight", _ab(reg4, "e2", "f")[0], 3500)
}

fn test_sa_weight_for_host() {
    let sa = sa_new()
    ce_eq("unknown host -> 200", sa_weight_for_host(sa, "h"), 200)
    sa_host_set_tier(sa, "h", SA_TIER_A)
    ce_eq("tier A -> 1000", sa_weight_for_host(sa, "h"), 1000)
    sa_host_set_weight(sa, "h", 333)
    ce_eq("explicit weight overrides tier", sa_weight_for_host(sa, "h"), 333)
    sa_host_set_weight(sa, "h", 444)
    ce_eq("explicit weight updated", sa_weight_for_host(sa, "h"), 444)
    ce_eq("tier still readable", sa_tier_for_host(sa, "h"), SA_TIER_A)
}

// ---- PIP_F_SIGNED_ATTR (bug 2) ---------------------------------------------

// good asserts f ten times; adv contradicts it once. f ends durable (781).
fn _good_adv(flags) {
    let reg = kg_registry_new()
    let mo = mo_new()
    let g = cur_new("e2", "src:e2:good")
    cur_add_atom(g, "f", ATOM_FACT, 500)
    let i = 0
    while i < 10 { cur_add_obs(g, "f", 1, 1000) i = i + 1 }
    pip_ingest_ex(reg, g, mo, 0, flags, 0)
    let a = cur_new("e2", "src:e2:adv")
    cur_add_obs(a, "f", 0 - 1, 1000)
    pip_ingest_ex(reg, a, mo, 0, flags, 0)
    mo_poll_reg(mo, kg_find(reg, "e2"), reg, 0, 1)
    let out = list_new()
    push(out, reg) push(out, mo)
    return out
}

fn _promo(mo, tag) {
    let rep = mo_report(mo)
    let i = 0
    while i < len(rep) {
        if str_eq_bytes(rep[i][0], tag) == 1 { return rep[i][1] }
        i = i + 1
    }
    return 0 - 1
}

fn test_signed_attribution() {
    // Control (default): the adversary gets promotion credit for a fact it
    // contradicted.
    let d = _good_adv(0)
    ce_eq("default: adv credited with promotion", _promo(d[1], "src:e2:adv"), 1000)
    let s = _good_adv(PIP_F_SIGNED_ATTR)
    let reg = s[0]
    let mo = s[1]
    let k = kg_find(reg, "e2")
    ce_eq("signed: good promoted", _promo(mo, "src:e2:good"), 1000)
    ce_eq("signed: adv not promoted", _promo(mo, "src:e2:adv"), 0)
    let fid = atom_id(kg_find_atom(k, "f"))
    ce_eq("adv stance -1", mo_stance(mo, "src:e2:adv", "e2", fid), 0 - 1)
    ce_eq("good stance +1", mo_stance(mo, "src:e2:good", "e2", fid), 1)
    let rg = mo_source_reliability(mo, "src:e2:good", k, reg)
    let ra = mo_source_reliability(mo, "src:e2:adv", k, reg)
    ce_check("reliability: good > 500", rg > 500)
    ce_check("reliability: adv < 500", ra < 500)
    ce_eq("reliability: unknown source 500", mo_source_reliability(mo, "src:none", k, reg), 500)
}

// ATOM-line sign mapping under SIGNED_ATTR: > 500 asserts, < 500 denies,
// exactly 500 is only a declaration.
fn test_signed_atom_seed_mapping() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("e2", "src:e2:decl")
    cur_add_atom(r, "hi", ATOM_FACT, 900)
    cur_add_atom(r, "lo", ATOM_FACT, 200)
    cur_add_atom(r, "mid", ATOM_FACT, 500)
    pip_ingest_ex(reg, r, mo, 0, PIP_F_SIGNED_ATTR, 0)
    let k = kg_find(reg, "e2")
    let hi = atom_id(kg_find_atom(k, "hi"))
    let lo = atom_id(kg_find_atom(k, "lo"))
    let mid = atom_id(kg_find_atom(k, "mid"))
    ce_eq("seed 900 -> stance +1", mo_stance(mo, "src:e2:decl", "e2", hi), 1)
    ce_eq("seed 200 -> stance -1", mo_stance(mo, "src:e2:decl", "e2", lo), 0 - 1)
    ce_eq("seed 500 -> no claim", mo_stance(mo, "src:e2:decl", "e2", mid), 0)
    ce_eq("seed 500 -> no entry (sample 2)", mo_report(mo)[0][3], 2)
    // The source denied "lo" and the KG agrees (mean 200): durable from its view.
    let split = mo_live_split(mo, "src:e2:decl", k, reg)
    ce_eq("both claims durable from the source's view", split[1], 2)
    // A lone seed-500 declaration creates no source row at all.
    let mo2 = mo_new()
    let r2 = cur_new("e2", "src:e2:quiet")
    cur_add_atom(r2, "mid2", ATOM_FACT, 500)
    pip_ingest_ex(kg_registry_new(), r2, mo2, 0, PIP_F_SIGNED_ATTR, 0)
    ce_eq("seed-500-only record: no source row", len(mo_report(mo2)), 0)
}

// OBS attributions are labelled with the atom's KG.
fn test_obs_attribution_labelled() {
    let reg = kg_registry_new()
    let main = kg_spawn(reg, "main")
    kg_add_atom(main, ATOM_CONCEPT, "seed0", 0)
    let mo = mo_new()
    let d = cur_new("lab", "src:e2:decl2")
    cur_add_atom(d, "g", ATOM_FACT, 500)
    pip_ingest(reg, d, 0)
    let o = cur_new("lab", "src:e2:obs")
    let i = 0
    while i < 6 { cur_add_obs(o, "g", 1, 1000) i = i + 1 }
    pip_ingest(reg, o, mo)
    let gid = atom_id(kg_find_atom(kg_find(reg, "lab"), "g"))
    ce_eq("OBS attribution carries the KG label", mo_stance(mo, "src:e2:obs", "lab", gid), 1)
    ce_eq("no unlabelled entry", mo_stance(mo, "src:e2:obs", "", gid), 0)
    ce_eq("resolved in its KG: durable", mo_live_split(mo, "src:e2:obs", main, reg)[1], 1)
}

// Signed stance uses the raw OBS weight, not the tier-scaled one: with a
// Tier C source (x0.2), weights 1 and 2 scale to 0, which would count as
// 1000 each and cancel.
fn test_signed_uses_raw_weight() {
    let sa = sa_new()
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("e2", "src:e2:tiny")
    cur_add_atom(r, "t", ATOM_FACT, 500)
    cur_add_obs(r, "t", 1, 1)
    cur_add_obs(r, "t", 0 - 1, 2)
    pip_ingest_ex(reg, r, mo, 0, PIP_F_SIGNED_ATTR + PIP_F_TIER_WEIGHT, sa)
    let tid = atom_id(kg_find_atom(kg_find(reg, "e2"), "t"))
    ce_eq("raw weights 1 vs 2 -> stance -1", mo_stance(mo, "src:e2:tiny", "e2", tid), 0 - 1)
}

// Pipeline-seeded metadata (citations at 900, EMPIRICAL associations at
// 800) is a note: it never counts as the source's promotion.
fn test_metadata_atoms_are_notes() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("meta", "src:e2:cites")
    cur_add_atom(r, "p", ATOM_FACT, 300)
    cur_add_atom(r, "q", ATOM_FACT, 300)
    cur_add_imp(r, "p", "q", "EMPIRICAL")
    cur_add_cite(r, "src:e2:cites", "src:e2:x", "supports")
    cur_add_cite(r, "src:e2:cites", "src:e2:y", "supports")
    pip_ingest(reg, r, mo)
    mo_poll_reg(mo, kg_find(reg, "meta"), reg, 0, 1)
    let rep = mo_report(mo)
    ce_eq("all five attributions counted in the sample", rep[0][3], 5)
    ce_eq("no promotion from citations or the association", rep[0][1], 0)
    let cid = atom_id(kg_find_atom(kg_find(reg, "citations"), "src:e2:cites supports src:e2:x"))
    ce_eq("citation entry is labelled and neutral", mo_stance(mo, "src:e2:cites", "citations", cid), 0)
    // An OBS on the association turns the note into a claim.
    let o = cur_new("meta", "src:e2:cites")
    cur_add_obs(o, "p-imp-q", 1, 1000)
    pip_ingest(reg, o, mo)
    let aid = atom_id(kg_find_atom(kg_find(reg, "meta"), "p-imp-q"))
    ce_eq("note becomes a +1 claim", mo_stance(mo, "src:e2:cites", "meta", aid), 1)
}

// A stance that cancels and later returns is not a second promotion.
fn test_stance_cancel_cycle() {
    let reg = kg_registry_new()
    let k = kg_spawn(reg, "c")
    let a = kg_add_atom(k, ATOM_FACT, "f", 0)
    let b = atom_belief(a)
    bel_observe_weighted(b, 1, 9000)        // mean ~ 909, durable
    let mo = mo_new()
    mo_attribute_signed(mo, "src:c", "c", atom_id(a), 1, 1000)
    mo_poll_reg(mo, k, reg, 0, 1)
    mo_attribute_signed(mo, "src:c", "c", atom_id(a), 0 - 1, 1000)   // cancels
    mo_poll_reg(mo, k, reg, 0, 2)
    mo_attribute_signed(mo, "src:c", "c", atom_id(a), 1, 1000)       // returns to +1
    mo_poll_reg(mo, k, reg, 0, 3)
    ce_eq("one promotion across the cycle", mo_report(mo)[0][1], 1000)
    let src = mo[MO_SOURCES][0]
    ce_eq("promotion count 1", src[MO_MS_PROMOTIONS], 1)
    ce_eq("no atrophy", src[MO_MS_ATROPHIES], 0)
}

fn test_attribute_signed_api() {
    let mo = mo_new()
    ce_eq("bad sign refused", mo_attribute_signed(mo, "src:t", "k", 3, 0, 1000), 0 - 1)
    ce_eq("new entry", mo_attribute_signed(mo, "src:t", "k", 3, 1, 1000), 1)
    ce_eq("existing entry", mo_attribute_signed(mo, "src:t", "k", 3, 0 - 1, 1000), 0)
    ce_eq("cancelled stance is 0", mo_stance(mo, "src:t", "k", 3), 0)
    mo_attribute_signed(mo, "src:t", "k", 3, 0 - 1, 0)
    ce_eq("weight <= 0 counts as 1000", mo_stance(mo, "src:t", "k", 3), 0 - 1)
    ce_eq("legacy attribution is stance +1", mo_attribute(mo, "src:u", 7), 1)
    ce_eq("legacy stance read", mo_stance(mo, "src:u", "", 7), 1)
    ce_eq("legacy dedup unchanged", mo_attribute(mo, "src:u", 7), 0)
    ce_eq("same id in another KG is a new entry", mo_attribute_in(mo, "src:u", "other", 7), 1)
}

// ---- labelled attribution and mo_poll_reg (bug 1) ---------------------------

fn test_labelled_poll() {
    let reg = kg_registry_new()
    let main = kg_spawn(reg, "main")
    kg_add_atom(main, ATOM_CONCEPT, "seed0", 0)   // id 0, mean 500
    kg_add_atom(main, ATOM_CONCEPT, "seed1", 0)   // id 1, mean 500
    let mo = mo_new()
    let r = cur_new("med", "src:e2:med")
    cur_add_atom(r, "fever_sym", ATOM_FACT, 950)
    cur_add_atom(r, "cough_sym", ATOM_FACT, 950)
    pip_ingest(reg, r, mo)
    let legacy = mo_live_split(mo, "src:e2:med", main, 0)
    ce_eq("legacy rule: ids read from the main KG (tentative 2)", legacy[0], 2)
    let fixed = mo_live_split(mo, "src:e2:med", main, reg)
    ce_eq("registry rule: durable 2", fixed[1], 2)
    ce_eq("registry rule: tentative 0", fixed[0], 0)
    mo_poll_reg(mo, main, reg, 0, 1)
    ce_eq("poll_reg: promotion credited", _promo(mo, "src:e2:med"), 1000)
    // The legacy entry point keeps its behaviour.
    let mo2 = mo_new()
    pip_ingest(reg, r, mo2)
    mo_poll(mo2, main, 0, 1)
    ce_eq("mo_poll (legacy) still reads the main KG", _promo(mo2, "src:e2:med"), 0)
}

fn test_citation_not_lost() {
    // The record's first atom and the first citation atom both get id 0 in
    // their own KGs; labelled attribution keeps both.
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("k", "src:e2:cite")
    cur_add_atom(r, "a", ATOM_FACT, 900)
    cur_add_cite(r, "src:e2:cite", "src:e2:other", "supports")
    pip_ingest(reg, r, mo)
    let rep = mo_report(mo)
    ce_eq("one source", len(rep), 1)
    ce_eq("both attributions kept", rep[0][3], 2)
    let aid = atom_id(kg_find_atom(kg_find(reg, "k"), "a"))
    ce_eq("record atom labelled with its KG", mo_stance(mo, "src:e2:cite", "k", aid), 1)
}

fn main() {
    test_flags_zero_matches_legacy()
    test_reseed_default_and_flag()
    test_no_reseed_mints_and_keeps_positive()
    test_no_reseed_empirical_imp()
    test_tier_weight()
    test_sa_weight_for_host()
    test_signed_attribution()
    test_attribute_signed_api()
    test_signed_atom_seed_mapping()
    test_obs_attribution_labelled()
    test_signed_uses_raw_weight()
    test_metadata_atoms_are_notes()
    test_stance_cancel_cycle()
    test_labelled_poll()
    test_citation_not_lost()
    ce_summary("e2_ingest")
}
main()
