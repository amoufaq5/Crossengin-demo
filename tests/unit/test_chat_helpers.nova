// Unit tests for src/chat/helpers.nova -- the pure helpers extracted from
// examples/crossengin_chat.nova in P1.8 for testability.
//
// Coverage
//   - _split_cmd: the 4 representative shapes from the brief.
//   - _split_triple: well-formed + malformed-line rejection (the 0 return).
//   - _intent1: the list-of-list shape ACK / SEE paths build.
//   - _learn_kind: every classifier branch (TOPIC / URL / FILE / BATCH / RSS / DIR)
//     including the composite-prefix priority over file-shape detection.
//   - _learn_kind_name: every code-to-name mapping.
//   - _learn_tag (and the per-kind derivers it dispatches to): the tag-string
//     output for representative inputs of each kind.
//   - _is_tag_alnum, _cap_tag, _tag_sanitise, _basename: low-level building
//     blocks.
//   - _mo_pad: width/truncate semantics.
//
//   Total assertions: 60. The tag-derivation assertions mirror what
//   tests/unit/test_learn_tag.nova already exercises locally (against its own
//   inlined copy of the same functions) -- both suites stay in the tree so a
//   drift in either copy is detected at make-test time.
//
// ADRs implemented: ADR-0049 (testing and benchmarks).

import "../ce_test.nova"
import "../../src/chat/helpers.nova"

// ---- _split_cmd ----------------------------------------------------------
// Brief's four canonical cases plus a few extras: leading slash preserved
// verbatim (no special treatment); str_trim on the args side; entire token
// returned as cmd when there's no space.
fn test_split_cmd() {
    let a = _split_cmd("/foo bar baz")
    ce_str_eq("split_cmd 'foo' arg cmd",  a[0], "/foo")
    ce_str_eq("split_cmd 'foo' arg args", a[1], "bar baz")

    let b = _split_cmd("/foo")
    ce_str_eq("split_cmd no-args cmd",  b[0], "/foo")
    ce_str_eq("split_cmd no-args args", b[1], "")

    let c = _split_cmd("")
    ce_str_eq("split_cmd empty cmd",  c[0], "")
    ce_str_eq("split_cmd empty args", c[1], "")

    let d = _split_cmd("no leading slash")
    ce_str_eq("split_cmd no-prefix cmd",  d[0], "no")
    ce_str_eq("split_cmd no-prefix args", d[1], "leading slash")

    // Extra: trailing whitespace in args is trimmed.
    let e = _split_cmd("/teach widget   ")
    ce_str_eq("split_cmd trims trailing space", e[1], "widget")

    // Extra: an already-trimmed multi-token args round-trips identically.
    let f = _split_cmd("/pin widget 850")
    ce_str_eq("split_cmd multi-arg cmd",  f[0], "/pin")
    ce_str_eq("split_cmd multi-arg args", f[1], "widget 850")
}

// ---- _split_triple --------------------------------------------------------
// Reference: chat's _admin_learn_triples uses this to parse one "S|R|O" line.
// Returns 0 on any malformed shape so the caller silently drops bad lines.
fn test_split_triple() {
    let t = _split_triple("fever|causal|infection")
    ce_str_eq("split_triple S", t[0], "fever")
    ce_str_eq("split_triple R", t[1], "causal")
    ce_str_eq("split_triple O", t[2], "infection")

    // Whitespace inside fields is trimmed.
    let t2 = _split_triple("  fever  |  causal  |  infection  ")
    ce_str_eq("split_triple trim S", t2[0], "fever")
    ce_str_eq("split_triple trim R", t2[1], "causal")
    ce_str_eq("split_triple trim O", t2[2], "infection")

    // Reject the malformed shapes.
    ce_eq("split_triple no pipes",  _split_triple("just words"), 0)
    ce_eq("split_triple one pipe",  _split_triple("a|b"),         0)
    ce_eq("split_triple empty S",   _split_triple("|r|o"),        0)
    ce_eq("split_triple empty R",   _split_triple("s||o"),        0)
    ce_eq("split_triple empty O",   _split_triple("s|r|"),        0)
}

// ---- _intent1 -------------------------------------------------------------
// Used by chat's reply path. Builds [[role, lemma]].
fn test_intent1() {
    let it = _intent1("ACK", "okay")
    ce_eq("intent1 len 1",    len(it), 1)
    ce_eq("intent1 cell len", len(it[0]), 2)
    ce_str_eq("intent1 role",  it[0][0], "ACK")
    ce_str_eq("intent1 lemma", it[0][1], "okay")

    let it2 = _intent1("subject", "fever")
    ce_str_eq("intent1 subject role",  it2[0][0], "subject")
    ce_str_eq("intent1 subject lemma", it2[0][1], "fever")
}

// ---- _learn_kind ----------------------------------------------------------
// Every classification branch, plus the composite-prefix priority guard.
fn test_learn_kind() {
    ce_eq("kind: bare TOPIC",         _learn_kind("fever"),                      LEARN_KIND_TOPIC)
    ce_eq("kind: empty -> TOPIC",     _learn_kind(""),                           LEARN_KIND_TOPIC)
    ce_eq("kind: https URL",          _learn_kind("https://x.com"),              LEARN_KIND_URL)
    ce_eq("kind: http URL",           _learn_kind("http://x.com/page"),          LEARN_KIND_URL)
    ce_eq("kind: /abs FILE",          _learn_kind("/abs/path"),                  LEARN_KIND_FILE)
    ce_eq("kind: ./rel FILE",         _learn_kind("./notes.md"),                 LEARN_KIND_FILE)
    ce_eq("kind: ../rel FILE",        _learn_kind("../share/d.json"),            LEARN_KIND_FILE)
    ce_eq("kind: @ BATCH",            _learn_kind("@list.txt"),                  LEARN_KIND_BATCH)
    ce_eq("kind: @/abs BATCH",        _learn_kind("@/tmp/urls.txt"),             LEARN_KIND_BATCH)
    ce_eq("kind: rss: RSS",           _learn_kind("rss:URL"),                    LEARN_KIND_RSS)
    ce_eq("kind: rss:https RSS",      _learn_kind("rss:https://x.com/feed"),     LEARN_KIND_RSS)
    ce_eq("kind: dir: DIR",           _learn_kind("dir:/path"),                  LEARN_KIND_DIR)
    ce_eq("kind: dir:rel DIR",        _learn_kind("dir:corpus"),                 LEARN_KIND_DIR)
    // Composite prefixes beat file-shape detection. A '@/...' MUST be BATCH.
    ce_eq("kind: @/abs is BATCH not FILE", _learn_kind("@/tmp/list.txt"),        LEARN_KIND_BATCH)
}

// ---- _learn_kind_name ----------------------------------------------------
// Every code-to-name pair (matches the strings stamped into src_prefix).
fn test_learn_kind_name() {
    ce_str_eq("name: TOPIC",  _learn_kind_name(LEARN_KIND_TOPIC), "topic")
    ce_str_eq("name: URL",    _learn_kind_name(LEARN_KIND_URL),   "url")
    ce_str_eq("name: FILE",   _learn_kind_name(LEARN_KIND_FILE),  "file")
    ce_str_eq("name: BATCH",  _learn_kind_name(LEARN_KIND_BATCH), "batch")
    ce_str_eq("name: RSS",    _learn_kind_name(LEARN_KIND_RSS),   "rss")
    ce_str_eq("name: DIR",    _learn_kind_name(LEARN_KIND_DIR),   "dir")
}

// ---- _learn_tag (dispatcher) ---------------------------------------------
// One representative input per kind. The deeper edge cases for each branch
// are exercised in test_learn_tag.nova (kept for regression).
fn test_learn_tag_dispatch() {
    ce_str_eq("tag: TOPIC pass-through",
        _learn_tag("fever"),
        "fever")
    ce_str_eq("tag: URL strips scheme",
        _learn_tag("https://en.wikipedia.org/wiki/Aspirin"),
        "enwikipediaorg_wiki_Aspirin")
    ce_str_eq("tag: FILE basename+strip-ext",
        _learn_tag("/tmp/test_corpus.txt"),
        "test_corpus")
    ce_str_eq("tag: BATCH prefix+stem",
        _learn_tag("@/tmp/urls.txt"),
        "batch_urls")
    ce_str_eq("tag: RSS prefix+host",
        _learn_tag("rss:https://feeds.bbci.co.uk/news/rss.xml"),
        "rss_feeds_bbci_co_uk")
    ce_str_eq("tag: DIR prefix+basename",
        _learn_tag("dir:/tmp/test_corpus_dir/"),
        "dir_test_corpus_dir")
}

// ---- _is_tag_alnum --------------------------------------------------------
// Char-code-level coverage of the [A-Za-z0-9_-] alphabet.
fn test_is_tag_alnum() {
    ce_eq("alnum '0'", _is_tag_alnum(48), 1)
    ce_eq("alnum '9'", _is_tag_alnum(57), 1)
    ce_eq("alnum 'A'", _is_tag_alnum(65), 1)
    ce_eq("alnum 'Z'", _is_tag_alnum(90), 1)
    ce_eq("alnum 'a'", _is_tag_alnum(97), 1)
    ce_eq("alnum 'z'", _is_tag_alnum(122), 1)
    ce_eq("alnum '_'", _is_tag_alnum(95), 1)
    ce_eq("alnum '-'", _is_tag_alnum(45), 1)
    ce_eq("alnum ' '  rejected", _is_tag_alnum(32), 0)
    ce_eq("alnum '/'  rejected", _is_tag_alnum(47), 0)
    ce_eq("alnum '.'  rejected", _is_tag_alnum(46), 0)
    ce_eq("alnum '@'  rejected", _is_tag_alnum(64), 0)
}

// ---- _cap_tag, _tag_sanitise, _basename ----------------------------------
fn test_low_level_helpers() {
    // _cap_tag: shorter passes through; longer truncates to 64.
    ce_str_eq("cap_tag short pass", _cap_tag("short"), "short")
    let long = ""
    let i = 0
    while i < 100 { long = long + "a" i = i + 1 }
    ce_eq("cap_tag truncates to 64", len(_cap_tag(long)), 64)

    // _tag_sanitise: alnum/_/-  preserved; everything else -> '_'.
    ce_str_eq("sanitise pass-through", _tag_sanitise("abc_DEF-09"), "abc_DEF-09")
    ce_str_eq("sanitise spaces",        _tag_sanitise("a b c"),     "a_b_c")
    ce_str_eq("sanitise dots+slashes",  _tag_sanitise("a.b/c"),     "a_b_c")

    // _basename: portion after last '/'; no slash -> whole string.
    ce_str_eq("basename abs",        _basename("/tmp/x/file.txt"), "file.txt")
    ce_str_eq("basename no slash",   _basename("file"),            "file")
    ce_str_eq("basename trailing /", _basename("/tmp/foo/"),       "")
}

// ---- _mo_pad --------------------------------------------------------------
// Width/truncate semantics: shorter strings get padded with spaces to width;
// strings >= width get truncated to (width-1) + " " for alignment.
fn test_mo_pad() {
    // Short input pads to exact width.
    ce_eq("pad shorter -> width", len(_mo_pad("abc", 6)), 6)
    ce_str_eq("pad shorter content", _mo_pad("abc", 6), "abc   ")

    // Equal-length input pads with a single trailing space (width - 1 chars
    // of input + one space). This is the "truncate" branch since n >= width.
    ce_str_eq("pad equal-length", _mo_pad("abc", 3), "ab ")

    // Longer input truncates to width-1 + space.
    ce_str_eq("pad longer truncates", _mo_pad("abcdef", 4), "abc ")
    ce_eq("pad longer length", len(_mo_pad("abcdef", 4)), 4)
}

// R64: operator-label -> human source name.
fn test_src_label_name() {
    ce_str_eq("wikipedia url", src_label_name("src:url:en.wikipedia.org:photosynthesis-causes-energy"), "Wikipedia")
    ce_str_eq("simple wikipedia", src_label_name("src:url:simple.wikipedia.org:x-is_a-y"), "Simple Wikipedia")
    ce_str_eq("wiktionary", src_label_name("src:url:en.wiktionary.org:a-b-c"), "Wiktionary")
    ce_str_eq("dictionary ingest", src_label_name("src:dict:serendipity:a-is_a-combination"), "dictionary")
    ce_str_eq("dictionary genus", src_label_name("src:dict:serendipity:genus"), "dictionary")
    ce_str_eq("learned topic", src_label_name("src:topic:photosynthesis:a-b-c"), "a learned topic")
    ce_str_eq("seed/unlabeled is prior knowledge", src_label_name("morning->breakfast"), "prior knowledge")
    ce_str_eq("other host kept", src_label_name("src:url:example.com:a-b-c"), "example.com")
}

// R68: dict operator label -> category tag.
fn test_dict_rel_tag() {
    ce_str_eq("genus", dict_rel_tag("src:dict:serendipity:genus"), "genus")
    ce_str_eq("synonym", dict_rel_tag("src:dict:happy:syn->cheerful"), "syn")
    ce_str_eq("antonym", dict_rel_tag("src:dict:happy:ant->sad"), "ant")
    ce_str_eq("plain relation -> empty", dict_rel_tag("src:url:en.wikipedia.org:a-causes-b"), "")
    ce_str_eq("seed op -> empty", dict_rel_tag("morning->breakfast"), "")
}

// R70: render one sense reference as "kglabel/conceptlabel".
fn test_know_sense_label() {
    ce_str_eq("sense label", _know_sense_label("reasoning", "fever"), "reasoning/fever")
    ce_str_eq("sense label other kg", _know_sense_label("medicine", "aspirin"), "medicine/aspirin")
}

fn main() {
    test_split_cmd()
    test_split_triple()
    test_intent1()
    test_learn_kind()
    test_learn_kind_name()
    test_learn_tag_dispatch()
    test_is_tag_alnum()
    test_low_level_helpers()
    test_mo_pad()
    test_src_label_name()
    test_dict_rel_tag()
    test_know_sense_label()
    ce_summary("chat_helpers")
}

main()
