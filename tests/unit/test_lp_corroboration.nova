// Unit tests for the corroboration-driven grade upgrade in learn_pipeline.nova
// (ADR-0092 gate (d), live). A claim asserted by a SECOND independent source is
// upgraded EMPIRICAL_WEAK -> EMPIRICAL_STRONG; a single source, or the same
// source repeated, is not.

import "../ce_test.nova"
import "../../src/learning/learn_pipeline.nova"

fn _weak_atom(label) {
    let a = atom_new(0, 1, ATOM_CONCEPT, label, 0)
    atom_set_evidence_grade(a, GRADE_EMPIRICAL_WEAK)
    return a
}

// One source: stays WEAK. A second DISTINCT source: upgraded to STRONG.
fn test_second_source_upgrades() {
    let reg = corr_new()
    lp_set_corroboration(reg)
    let a = _weak_atom("min_wage_helps")
    _lp_corroborate(a, "wikipedia:A")
    ce_eq("one source -> still WEAK", atom_evidence_grade(a), GRADE_EMPIRICAL_WEAK)
    _lp_corroborate(a, "journal:B")
    ce_eq("second independent source -> STRONG",
        atom_evidence_grade(a), GRADE_EMPIRICAL_STRONG)
    lp_set_corroboration(0)
}

// The SAME source repeated does NOT corroborate (no grade change).
fn test_same_source_no_upgrade() {
    let reg = corr_new()
    lp_set_corroboration(reg)
    let a = _weak_atom("dubious_claim")
    _lp_corroborate(a, "blog:A")
    _lp_corroborate(a, "blog:A")     // same source again
    _lp_corroborate(a, "blog:A")
    ce_eq("repeated single source -> still WEAK",
        atom_evidence_grade(a), GRADE_EMPIRICAL_WEAK)
    lp_set_corroboration(0)
}

// With no registry wired, the ingest path is unchanged (no upgrade, no fault).
fn test_no_registry_is_inert() {
    lp_set_corroboration(0)
    let a = _weak_atom("x")
    _lp_corroborate(a, "src:a")
    _lp_corroborate(a, "src:b")
    ce_eq("no registry -> grade unchanged", atom_evidence_grade(a), GRADE_EMPIRICAL_WEAK)
}

// A non-WEAK grade is never disturbed by corroboration (only WEAK upgrades).
fn test_only_weak_upgraded() {
    let reg = corr_new()
    lp_set_corroboration(reg)
    // a TESTIMONIAL atom corroborated twice stays TESTIMONIAL (not silently
    // promoted to STRONG -- only the web-fetch WEAK case is the corroboration win).
    let a = atom_new(0, 1, ATOM_CONCEPT, "user_said", 0)
    atom_set_evidence_grade(a, GRADE_TESTIMONIAL)
    _lp_corroborate(a, "s1")
    _lp_corroborate(a, "s2")
    ce_eq("TESTIMONIAL untouched", atom_evidence_grade(a), GRADE_TESTIMONIAL)
    lp_set_corroboration(0)
}

fn main() {
    test_second_source_upgrades()
    test_same_source_no_upgrade()
    test_no_registry_is_inert()
    test_only_weak_upgraded()
    ce_summary("lp_corroboration")
}

main()
