// Unit tests for src/safety/constitutional_filter.nova
// Verifies the gate chain order (ADR-0045): constitutional veto is terminal even
// with user approval; hard stop drains; otherwise the permission tier (which
// folds the ADR-0042 reversibility floor) decides. Also the soul-bound veto
// watcher and the loyalty hierarchy (constitution > enterprise > user > system).

import "../ce_test.nova"
import "../../src/safety/constitutional_filter.nova"

// Tier-driven decisions when nothing is vetoed or halted.
fn test_tier_decisions() {
    // READ_LOCAL is AUTO -> execute.
    ce_eq("read executes", safety_gate(ACT_READ_LOCAL, 0, 0, 0), GATE_EXECUTE)
    // NET_FETCH is NOTIFY -> notify (still runs).
    ce_eq("net notifies", safety_gate(ACT_NET_FETCH, 0, 0, 0), GATE_NOTIFY)
    // SPEAK: AUTO default raised to NOTIFY by the recoverable floor.
    ce_eq("speak notifies", safety_gate(ACT_SPEAK, 0, 0, 0), GATE_NOTIFY)
    // SEND_MSG is APPROVE -> suspend without approval, execute with it.
    ce_eq("send suspends", safety_gate(ACT_SEND_MSG, 0, 0, 0), GATE_SUSPEND)
    ce_eq("send approved runs", safety_gate(ACT_SEND_MSG, 0, 0, 1), GATE_EXECUTE)
    ce_eq("notify executes", gate_executes(GATE_NOTIFY), 1)
    ce_eq("suspend blocks", gate_executes(GATE_SUSPEND), 0)
}

// A constitutional veto is terminal -- approval cannot clear it (ADR-0045).
fn test_veto_terminal() {
    ce_eq("veto despite approval", safety_gate(ACT_SEND_MSG, 1, 0, 1), GATE_VETOED)
    ce_eq("vetoed cannot execute", gate_executes(GATE_VETOED), 0)
    // Veto outranks a hard stop in the reported reason.
    ce_eq("veto over halt", safety_gate(ACT_READ_LOCAL, 1, 1, 1), GATE_VETOED)
    ce_eq("must log vetoed", gate_must_log(GATE_VETOED), 1)
}

// Hard stop drains everything that is not already vetoed.
fn test_halt() {
    ce_eq("halt blocks auto", safety_gate(ACT_READ_LOCAL, 0, 1, 0), GATE_HALTED)
    ce_eq("halted cannot execute", gate_executes(GATE_HALTED), 0)
    ce_str_eq("name", gate_name(GATE_HALTED), "halted")
}

// The veto bit comes from the soul's constitution watcher.
fn test_const_veto_for() {
    let s = soul_new("Aurora")
    soul_add_constitution(s, "exfiltrate", CONST_BLOCK)
    soul_add_constitution(s, "be terse", CONST_WARN)
    ce_eq("blocked phrase vetoes", const_veto_for(s, "exfiltrate user secrets"), 1)
    ce_eq("warn does not veto", const_veto_for(s, "be terse please"), 0)
    ce_eq("unrelated allowed", const_veto_for(s, "read a local file"), 0)
    // End-to-end: a constitutionally-vetoed send cannot run even if approved.
    let v = const_veto_for(s, "exfiltrate user secrets")
    ce_eq("e2e vetoed", safety_gate(ACT_SEND_MSG, v, 0, 1), GATE_VETOED)
}

// Loyalty hierarchy: constitution above all; v2 enterprise over user; v1 user
// is the top non-constitutional authority.
fn test_loyalty() {
    // v1 fixture: user above the system's own goals.
    let s1 = soul_new("v1")
    soul_add_loyalty(s1, "user", 30)
    soul_add_loyalty(s1, "system", 10)
    ce_str_eq("v1 user over system", loyalty_resolve(s1, "user", "system"), "user")
    ce_str_eq("v1 constitution wins", loyalty_resolve(s1, "constitution", "user"), "constitution")

    // v2 fixture: enterprise policy over the end user.
    let s2 = soul_new("v2")
    soul_add_loyalty(s2, "enterprise", 40)
    soul_add_loyalty(s2, "user", 30)
    ce_str_eq("v2 enterprise over user", loyalty_resolve(s2, "enterprise", "user"), "enterprise")
    ce_str_eq("v2 constitution over enterprise", loyalty_resolve(s2, "constitution", "enterprise"), "constitution")
}

fn main() {
    test_tier_decisions()
    test_veto_terminal()
    test_halt()
    test_const_veto_for()
    test_loyalty()
    ce_summary("constitutional_filter")
}
main()
