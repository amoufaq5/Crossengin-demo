// Unit tests for src/net/tls/tls_state.nova
// (R86, ADR r86-in-process-tls-scaffolding).
//
// Covers the TLS 1.3 connection state machine: initial state, name
// lookup, classifiers (terminal / handshaking / can-send-app), every
// legal transition, every illegal transition, close / hard-close /
// finalize behavior, terminal-state refusal.

import "../ce_test.nova"
import "../../src/net/tls/tls_state.nova"
import "../../src/util/str_safe.nova"

fn test_initial_state_is_INIT() {
    let ctx = tls_state_ctx_new(TLS_ROLE_SERVER)
    ce_eq("initial state", tls_state_ctx_state(ctx), TLS_STATE_INIT)
    ce_eq("initial role",  tls_state_ctx_role(ctx),  TLS_ROLE_SERVER)
}

fn test_state_names() {
    ce_str_eq("INIT",                     tls_state_name(TLS_STATE_INIT),                     "INIT")
    ce_str_eq("HANDSHAKE_HELLO_SENT",     tls_state_name(TLS_STATE_HANDSHAKE_HELLO_SENT),     "HANDSHAKE_HELLO_SENT")
    ce_str_eq("HANDSHAKE_HELLO_RECEIVED", tls_state_name(TLS_STATE_HANDSHAKE_HELLO_RECEIVED), "HANDSHAKE_HELLO_RECEIVED")
    ce_str_eq("HANDSHAKE_FINISHED",       tls_state_name(TLS_STATE_HANDSHAKE_FINISHED),       "HANDSHAKE_FINISHED")
    ce_str_eq("APPLICATION",              tls_state_name(TLS_STATE_APPLICATION),              "APPLICATION")
    ce_str_eq("CLOSING",                  tls_state_name(TLS_STATE_CLOSING),                  "CLOSING")
    ce_str_eq("CLOSED",                   tls_state_name(TLS_STATE_CLOSED),                   "CLOSED")
    // Unknown state stringifies with numeric marker.
    let s = tls_state_name(99)
    ce_check("unknown state stringifies", find_bytes(s, "99") >= 0)
}

fn test_classifier_terminal() {
    ce_eq("INIT not terminal",         tls_state_is_terminal(TLS_STATE_INIT), 0)
    ce_eq("APPLICATION not terminal",  tls_state_is_terminal(TLS_STATE_APPLICATION), 0)
    ce_eq("CLOSING not terminal",      tls_state_is_terminal(TLS_STATE_CLOSING), 0)
    ce_eq("CLOSED is terminal",        tls_state_is_terminal(TLS_STATE_CLOSED), 1)
}

fn test_classifier_handshaking() {
    ce_eq("INIT is handshaking",            tls_state_is_handshaking(TLS_STATE_INIT), 1)
    ce_eq("HELLO_SENT is handshaking",      tls_state_is_handshaking(TLS_STATE_HANDSHAKE_HELLO_SENT), 1)
    ce_eq("HELLO_RECEIVED is handshaking",  tls_state_is_handshaking(TLS_STATE_HANDSHAKE_HELLO_RECEIVED), 1)
    ce_eq("FINISHED is handshaking",        tls_state_is_handshaking(TLS_STATE_HANDSHAKE_FINISHED), 1)
    ce_eq("APPLICATION not handshaking",    tls_state_is_handshaking(TLS_STATE_APPLICATION), 0)
    ce_eq("CLOSING not handshaking",        tls_state_is_handshaking(TLS_STATE_CLOSING), 0)
    ce_eq("CLOSED not handshaking",         tls_state_is_handshaking(TLS_STATE_CLOSED), 0)
}

fn test_classifier_can_send_app() {
    ce_eq("APPLICATION can send",           tls_state_can_send_app(TLS_STATE_APPLICATION), 1)
    ce_eq("INIT cannot send",               tls_state_can_send_app(TLS_STATE_INIT), 0)
    ce_eq("HELLO_SENT cannot send",         tls_state_can_send_app(TLS_STATE_HANDSHAKE_HELLO_SENT), 0)
    ce_eq("HELLO_RECEIVED cannot send",     tls_state_can_send_app(TLS_STATE_HANDSHAKE_HELLO_RECEIVED), 0)
    ce_eq("FINISHED cannot send",           tls_state_can_send_app(TLS_STATE_HANDSHAKE_FINISHED), 0)
    ce_eq("CLOSING cannot send",            tls_state_can_send_app(TLS_STATE_CLOSING), 0)
    ce_eq("CLOSED cannot send",             tls_state_can_send_app(TLS_STATE_CLOSED), 0)
}

fn test_legal_transitions() {
    // Client-side happy path: INIT -> HELLO_SENT -> FINISHED -> APPLICATION.
    ce_eq("INIT -> HELLO_SENT",     tls_state_can_advance(TLS_STATE_INIT, TLS_STATE_HANDSHAKE_HELLO_SENT), 1)
    ce_eq("HELLO_SENT -> FINISHED", tls_state_can_advance(TLS_STATE_HANDSHAKE_HELLO_SENT, TLS_STATE_HANDSHAKE_FINISHED), 1)
    ce_eq("FINISHED -> APPLICATION",tls_state_can_advance(TLS_STATE_HANDSHAKE_FINISHED, TLS_STATE_APPLICATION), 1)

    // Server-side happy path: INIT -> HELLO_RECEIVED -> HELLO_SENT -> FINISHED -> APPLICATION.
    ce_eq("INIT -> HELLO_RECEIVED",     tls_state_can_advance(TLS_STATE_INIT, TLS_STATE_HANDSHAKE_HELLO_RECEIVED), 1)
    ce_eq("HELLO_RECEIVED -> HELLO_SENT",tls_state_can_advance(TLS_STATE_HANDSHAKE_HELLO_RECEIVED, TLS_STATE_HANDSHAKE_HELLO_SENT), 1)
    ce_eq("HELLO_RECEIVED -> FINISHED", tls_state_can_advance(TLS_STATE_HANDSHAKE_HELLO_RECEIVED, TLS_STATE_HANDSHAKE_FINISHED), 1)
}

fn test_illegal_transitions() {
    // No skipping the handshake.
    ce_eq("INIT -> APPLICATION illegal", tls_state_can_advance(TLS_STATE_INIT, TLS_STATE_APPLICATION), 0)
    ce_eq("INIT -> FINISHED illegal",    tls_state_can_advance(TLS_STATE_INIT, TLS_STATE_HANDSHAKE_FINISHED), 0)

    // No going backwards.
    ce_eq("APPLICATION -> INIT illegal",       tls_state_can_advance(TLS_STATE_APPLICATION, TLS_STATE_INIT), 0)
    ce_eq("FINISHED -> HELLO_SENT illegal",    tls_state_can_advance(TLS_STATE_HANDSHAKE_FINISHED, TLS_STATE_HANDSHAKE_HELLO_SENT), 0)

    // No re-handshake within APPLICATION (TLS 1.3 forbids renegotiation).
    ce_eq("APPLICATION -> APPLICATION illegal", tls_state_can_advance(TLS_STATE_APPLICATION, TLS_STATE_APPLICATION), 0)

    // CLOSING is a terminal-lane state: no forward normal transitions.
    ce_eq("CLOSING -> APPLICATION illegal", tls_state_can_advance(TLS_STATE_CLOSING, TLS_STATE_APPLICATION), 0)
    ce_eq("CLOSING -> CLOSED via advance illegal (use finalize_close)",
          tls_state_can_advance(TLS_STATE_CLOSING, TLS_STATE_CLOSED), 0)

    // HELLO_SENT can't go to HELLO_RECEIVED (roles are fixed at INIT).
    ce_eq("HELLO_SENT -> HELLO_RECEIVED illegal",
          tls_state_can_advance(TLS_STATE_HANDSHAKE_HELLO_SENT, TLS_STATE_HANDSHAKE_HELLO_RECEIVED), 0)
}

fn test_advance_updates_ctx() {
    let ctx = tls_state_ctx_new(TLS_ROLE_SERVER)
    ce_eq("advance INIT -> HELLO_RECEIVED",
          tls_state_ctx_advance(ctx, TLS_STATE_HANDSHAKE_HELLO_RECEIVED), 1)
    ce_eq("state now HELLO_RECEIVED",
          tls_state_ctx_state(ctx), TLS_STATE_HANDSHAKE_HELLO_RECEIVED)

    ce_eq("advance HELLO_RECEIVED -> HELLO_SENT",
          tls_state_ctx_advance(ctx, TLS_STATE_HANDSHAKE_HELLO_SENT), 1)
    ce_eq("advance HELLO_SENT -> FINISHED",
          tls_state_ctx_advance(ctx, TLS_STATE_HANDSHAKE_FINISHED), 1)
    ce_eq("advance FINISHED -> APPLICATION",
          tls_state_ctx_advance(ctx, TLS_STATE_APPLICATION), 1)
    ce_eq("state now APPLICATION",
          tls_state_ctx_state(ctx), TLS_STATE_APPLICATION)
}

fn test_advance_refuses_illegal_and_leaves_state() {
    let ctx = tls_state_ctx_new(TLS_ROLE_CLIENT)
    ce_eq("advance INIT -> APPLICATION refused",
          tls_state_ctx_advance(ctx, TLS_STATE_APPLICATION), 0)
    ce_eq("state unchanged after refusal",
          tls_state_ctx_state(ctx), TLS_STATE_INIT)
}

fn test_close_path() {
    let ctx = tls_state_ctx_new(TLS_ROLE_SERVER)
    // Legal from any non-terminal state.
    ce_eq("close from INIT",         tls_state_ctx_close(ctx), 1)
    ce_eq("state = CLOSING",         tls_state_ctx_state(ctx), TLS_STATE_CLOSING)
    ce_eq("finalize from CLOSING",   tls_state_ctx_finalize_close(ctx), 1)
    ce_eq("state = CLOSED",          tls_state_ctx_state(ctx), TLS_STATE_CLOSED)
    // Terminal refuses further transitions.
    ce_eq("no re-close after CLOSED",         tls_state_ctx_close(ctx), 0)
    ce_eq("no re-finalize after CLOSED",      tls_state_ctx_finalize_close(ctx), 0)
    ce_eq("no advance from CLOSED",
          tls_state_ctx_advance(ctx, TLS_STATE_APPLICATION), 0)
    ce_eq("state unchanged",         tls_state_ctx_state(ctx), TLS_STATE_CLOSED)
}

fn test_hard_close_skips_closing() {
    let ctx = tls_state_ctx_new(TLS_ROLE_CLIENT)
    tls_state_ctx_advance(ctx, TLS_STATE_HANDSHAKE_HELLO_SENT)
    tls_state_ctx_advance(ctx, TLS_STATE_HANDSHAKE_FINISHED)
    tls_state_ctx_advance(ctx, TLS_STATE_APPLICATION)
    ce_eq("hard-close from APPLICATION", tls_state_ctx_hard_close(ctx), 1)
    ce_eq("state = CLOSED directly",     tls_state_ctx_state(ctx), TLS_STATE_CLOSED)
    ce_eq("no hard-close after CLOSED",  tls_state_ctx_hard_close(ctx), 0)
}

fn test_finalize_close_only_from_CLOSING() {
    let ctx = tls_state_ctx_new(TLS_ROLE_SERVER)
    ce_eq("finalize from INIT refused",       tls_state_ctx_finalize_close(ctx), 0)
    ce_eq("state unchanged after refusal",    tls_state_ctx_state(ctx), TLS_STATE_INIT)
}

fn test_can_close_now_all_states() {
    ce_eq("INIT can close",         tls_state_can_close_now(TLS_STATE_INIT), 1)
    ce_eq("HELLO_SENT can close",   tls_state_can_close_now(TLS_STATE_HANDSHAKE_HELLO_SENT), 1)
    ce_eq("APPLICATION can close",  tls_state_can_close_now(TLS_STATE_APPLICATION), 1)
    ce_eq("CLOSING can close",      tls_state_can_close_now(TLS_STATE_CLOSING), 1)
    ce_eq("CLOSED cannot close",    tls_state_can_close_now(TLS_STATE_CLOSED), 0)
}

fn main() {
    test_initial_state_is_INIT()
    test_state_names()
    test_classifier_terminal()
    test_classifier_handshaking()
    test_classifier_can_send_app()
    test_legal_transitions()
    test_illegal_transitions()
    test_advance_updates_ctx()
    test_advance_refuses_illegal_and_leaves_state()
    test_close_path()
    test_hard_close_skips_closing()
    test_finalize_close_only_from_CLOSING()
    test_can_close_now_all_states()
    ce_summary("tls_state")
}

main()
