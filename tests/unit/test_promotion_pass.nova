// Unit tests for src/parts/reasoning/promotion_pass.nova: the full ADR-0092
// gate ladder (promo_apply -> cand_promote) plus decision-log audit. The gate
// ladder runs with explicit, fully-formed inputs (the runtime-verifiable core);
// the KG-input gatherers (promo_corroboration / promo_find_conflict) depend on
// the operator walk, which mis-compiles under this launcher (rk_operators_to
// returns empty -- the same atom_payload_get/str_eq limit the debate KG-construct
// tests hit), so they are exercised only on their degenerate (no-operator) path
// here and compile-verified for the rest.

import "../ce_test.nova"
import "../../src/parts/reasoning/promotion_pass.nova"

fn _lic_reg() { return lic_registry_new() }
fn _prf_reg() { return proof_registry_new() }

// ---- gate ladder: a clean, corroborated, undefeated claim PROMOTES ---------
fn test_clean_corroborated_promotes() {
    let atom = atom_new(0, 1, ATOM_CONCEPT, "fact", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    // source wikipedia (CC_BY_SA, clean), 2 corroborating sources (-> STRONG),
    // not formal, no conflict.
    let claim = claim_new("wikipedia:Fact", 2, 0, PROV_NONE, 0)
    let state = promo_apply(atom, claim, pctx, DEBATE_PASSED, 100)
    ce_eq("promoted", state, CAND_PROMOTED)
    ce_eq("grade EMPIRICAL_STRONG (2 sources)",
        atom_evidence_grade(atom), GRADE_EMPIRICAL_STRONG)
}

// ---- gate (a): unclean source QUARANTINES ----------------------------------
fn test_unclean_source_quarantines() {
    let atom = atom_new(0, 1, ATOM_CONCEPT, "shady", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("rando-blog:Shady", 3, 0, PROV_NONE, 0)
    let state = promo_apply(atom, claim, pctx, DEBATE_PASSED, 100)
    ce_eq("quarantined", state, CAND_QUARANTINED)
}

// ---- gate (f): a lost debate freezes CONTESTED -----------------------------
fn test_lost_debate_contested() {
    let atom = atom_new(0, 1, ATOM_CONCEPT, "claim", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("wikipedia:Claim", 2, 0, PROV_NONE, 0)
    let state = promo_apply(atom, claim, pctx, DEBATE_FAILED, 100)
    ce_eq("contested (lost debate)", state, CAND_CONTESTED)
    ce_eq("grade CONTESTED", atom_evidence_grade(atom), GRADE_CONTESTED)
}

// ---- gate (e): conflict with a PROTECTED atom freezes both -----------------
fn test_conflict_with_protected_contested() {
    // protected = user-taught (LICENSE_OWNER) existing atom.
    let existing = atom_new(0, 1, ATOM_CONCEPT, "owned", 0)
    atom_set_license(existing, LICENSE_OWNER)
    let atom = atom_new(0, 2, ATOM_CONCEPT, "rival", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("wikipedia:Rival", 2, 0, PROV_NONE, existing)
    let state = promo_apply(atom, claim, pctx, DEBATE_PASSED, 100)
    ce_eq("contested (protected conflict)", state, CAND_CONTESTED)
}

// ---- gate (4): editing governance is REJECTED outright ---------------------
// NOTE: cand_is_governance reads atom_payload_has("governance") -> str_eq,
// which mis-compiles under this launcher (the same quirk behind the 6
// test_promotion baseline failures), so the REJECTED outcome is not reachable
// here at runtime. The gate logic itself is exercised by test_promotion; this
// test confirms promo_apply at least threads the conflict atom through without
// faulting. Compile-verified for the REJECTED path.
fn test_governance_edit_threads_conflict() {
    let gov = atom_new(0, 1, ATOM_CONCEPT, "constitution", 0)
    atom_payload_set(gov, "governance", 1)
    let atom = atom_new(0, 2, ATOM_CONCEPT, "edit", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("wikipedia:Edit", 2, 0, PROV_NONE, gov)
    let state = promo_apply(atom, claim, pctx, DEBATE_PASSED, 100)
    // Whatever the launcher resolves, the call returns a valid CAND_* state.
    ce_check("returns a terminal state", state >= 0)
}

// ---- DEBATE_NONE skips gate (f): an isolated clean claim still promotes -----
fn test_debate_none_promotes() {
    let atom = atom_new(0, 1, ATOM_CONCEPT, "lonefact", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("wikipedia:Lone", 1, 0, PROV_NONE, 0)
    let state = promo_apply(atom, claim, pctx, DEBATE_NONE, 100)
    ce_eq("promoted (no debate context)", state, CAND_PROMOTED)
    ce_eq("lone source -> EMPIRICAL_WEAK",
        atom_evidence_grade(atom), GRADE_EMPIRICAL_WEAK)
}

// ---- audit: promo_apply records the outcome to a wired log -----------------
fn test_audit_records_outcome() {
    let log = dl_new()
    promo_set_audit_log(log)
    let atom = atom_new(0, 1, ATOM_CONCEPT, "fact", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("wikipedia:Fact", 2, 0, PROV_NONE, 0)
    promo_apply(atom, claim, pctx, DEBATE_PASSED, 555)
    ce_eq("one log entry", dl_count(log), 1)
    let e = dl_get(log, 0)
    ce_eq("subtype promotion", drec_subtype(e), DREC_PROMOTION)
    ce_eq("flag PROMOTED", drec_flag(e), CAND_PROMOTED)
    ce_eq("promoted -> OK", dl_outcome(e), OUT_OK)
    ce_eq("chain intact", dl_verify(log), 1)
    promo_set_audit_log(0)
}

fn test_audit_records_quarantine_as_vetoed() {
    let log = dl_new()
    promo_set_audit_log(log)
    let atom = atom_new(0, 1, ATOM_CONCEPT, "shady", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("rando-blog:Shady", 1, 0, PROV_NONE, 0)
    promo_apply(atom, claim, pctx, DEBATE_NONE, 600)
    let e = dl_get(log, 0)
    ce_eq("quarantine flag", drec_flag(e), CAND_QUARANTINED)
    ce_eq("quarantine -> VETOED", dl_outcome(e), OUT_VETOED)
    promo_set_audit_log(0)
}

fn test_no_log_no_record() {
    promo_set_audit_log(0)
    let atom = atom_new(0, 1, ATOM_CONCEPT, "fact", 0)
    let pctx = pctx_new(_lic_reg(), _prf_reg())
    let claim = claim_new("wikipedia:Fact", 2, 0, PROV_NONE, 0)
    let state = promo_apply(atom, claim, pctx, DEBATE_PASSED, 100)
    ce_eq("still promoted (no audit)", state, CAND_PROMOTED)
    ce_eq("handle off", _promo_audit_log(), 0)
}

// ---- KG gatherers: degenerate (no-operator) path -- runtime-safe -----------
// rk_operators_to returns empty under this launcher, so an op-less KG yields 0
// corroboration and no conflict. This at least exercises the functions' no-op
// path without faulting (the populated path is compile-verified, see header).
fn test_gatherers_empty_kg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "isolated", 0)
    ce_eq("no corroboration on op-less KG",
        promo_corroboration(kg, atom_id(atom)), 0)
    ce_eq("no conflict on op-less KG",
        promo_find_conflict(kg, atom_id(atom)), 0)
}

// The src-equality helper (the dedup primitive) is pure and testable.
fn test_src_eq_helper() {
    ce_eq("equal strings", _promo_src_eq("src:a", "src:a"), 1)
    ce_eq("different strings", _promo_src_eq("src:a", "src:b"), 0)
    ce_eq("length mismatch", _promo_src_eq("src:a", "src:aa"), 0)
}

fn main() {
    test_clean_corroborated_promotes()
    test_unclean_source_quarantines()
    test_lost_debate_contested()
    test_conflict_with_protected_contested()
    test_governance_edit_threads_conflict()
    test_debate_none_promotes()
    test_audit_records_outcome()
    test_audit_records_quarantine_as_vetoed()
    test_no_log_no_record()
    test_gatherers_empty_kg()
    test_src_eq_helper()
    ce_summary("promotion_pass")
}

main()
