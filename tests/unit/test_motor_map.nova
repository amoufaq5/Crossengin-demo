// Unit tests for src/parts/action/motor_map.nova
//
// Verifies the substrate-activation -> effector-class registry: an empty
// registry reports size 0 and misses lookup, register grows the size,
// lookup returns the registered class on exact match, unregister removes
// entries, and re-registering an existing key overwrites in place.
// ADR-0093 (Phase N R2).

import "../ce_test.nova"
import "../../src/parts/action/motor_map.nova"

// ---- empty registry ------------------------------------------------------
fn test_empty_registry() {
    let mm = motor_map_new()
    ce_check("empty is map", mm_is_map(mm) == 1)
    ce_eq("empty size", motor_map_size(mm), 0)
    ce_eq("empty lookup returns INTERNAL",
          motor_map_lookup(mm, "any_signature"), EFF_CLASS_INTERNAL)
    ce_eq("empty keys empty list", len(motor_map_keys(mm)), 0)
    ce_eq("empty entries empty list", len(motor_map_entries(mm)), 0)
}

// ---- register + lookup ---------------------------------------------------
fn test_register_and_lookup() {
    let mm = motor_map_new()
    ce_eq("register web -> HTTP",
          motor_map_register(mm, "search_the_web", EFF_CLASS_HTTP), 1)
    ce_eq("size after 1 register", motor_map_size(mm), 1)
    ce_eq("lookup hit -> HTTP",
          motor_map_lookup(mm, "search_the_web"), EFF_CLASS_HTTP)
    ce_eq("lookup miss -> INTERNAL",
          motor_map_lookup(mm, "unrelated_signature"), EFF_CLASS_INTERNAL)
    ce_eq("register file -> FILE",
          motor_map_register(mm, "write_a_note", EFF_CLASS_FILE), 1)
    ce_eq("size after 2 registers", motor_map_size(mm), 2)
    ce_eq("both keys still resolve (http)",
          motor_map_lookup(mm, "search_the_web"), EFF_CLASS_HTTP)
    ce_eq("both keys still resolve (file)",
          motor_map_lookup(mm, "write_a_note"), EFF_CLASS_FILE)
}

// ---- overwrite existing key ----------------------------------------------
fn test_register_overwrites() {
    let mm = motor_map_new()
    motor_map_register(mm, "act_x", EFF_CLASS_SPEAK)
    ce_eq("initial mapping SPEAK",
          motor_map_lookup(mm, "act_x"), EFF_CLASS_SPEAK)
    motor_map_register(mm, "act_x", EFF_CLASS_TOOL)
    ce_eq("size unchanged on overwrite", motor_map_size(mm), 1)
    ce_eq("overwrite to TOOL",
          motor_map_lookup(mm, "act_x"), EFF_CLASS_TOOL)
}

// ---- enumeration ---------------------------------------------------------
fn test_enumeration() {
    let mm = motor_map_new()
    motor_map_register(mm, "k1", EFF_CLASS_SPEAK)
    motor_map_register(mm, "k2", EFF_CLASS_TOOL)
    motor_map_register(mm, "k3", EFF_CLASS_HTTP)
    let keys = motor_map_keys(mm)
    ce_eq("3 keys", len(keys), 3)
    ce_str_eq("key 0 insertion order", keys[0], "k1")
    ce_str_eq("key 1 insertion order", keys[1], "k2")
    ce_str_eq("key 2 insertion order", keys[2], "k3")
    let ents = motor_map_entries(mm)
    ce_eq("3 entries", len(ents), 3)
    ce_str_eq("entry 0 key", ents[0][0], "k1")
    ce_eq("entry 0 class", ents[0][1], EFF_CLASS_SPEAK)
    ce_str_eq("entry 2 key", ents[2][0], "k3")
    ce_eq("entry 2 class", ents[2][1], EFF_CLASS_HTTP)
}

// ---- unregister ----------------------------------------------------------
fn test_unregister() {
    let mm = motor_map_new()
    motor_map_register(mm, "removable", EFF_CLASS_AUDIO)
    motor_map_register(mm, "sticky", EFF_CLASS_MCP)
    ce_eq("size before unregister", motor_map_size(mm), 2)
    ce_eq("unregister removable ok",
          motor_map_unregister(mm, "removable"), 1)
    ce_eq("size after unregister", motor_map_size(mm), 1)
    ce_eq("removed no longer resolves",
          motor_map_lookup(mm, "removable"), EFF_CLASS_INTERNAL)
    ce_eq("sticky still resolves",
          motor_map_lookup(mm, "sticky"), EFF_CLASS_MCP)
    ce_eq("unregister absent key returns 0",
          motor_map_unregister(mm, "never_there"), 0)
}

// ---- Phase R1: default seed covers canonical vocabulary -----------------
fn test_motor_map_default_covers_canonical_vocabulary() {
    let mm = motor_map_default()
    ce_check("default is map", mm_is_map(mm) == 1)
    ce_check("default has entries", motor_map_size(mm) >= 9)
    ce_eq("search_the_web -> HTTP",
          motor_map_lookup(mm, "search_the_web"), EFF_CLASS_HTTP)
    ce_eq("fetch_url -> HTTP",
          motor_map_lookup(mm, "fetch_url"), EFF_CLASS_HTTP)
    ce_eq("write_a_note -> FILE",
          motor_map_lookup(mm, "write_a_note"), EFF_CLASS_FILE)
    ce_eq("read_file -> FILE",
          motor_map_lookup(mm, "read_file"), EFF_CLASS_FILE)
    ce_eq("call_tool -> TOOL",
          motor_map_lookup(mm, "call_tool"), EFF_CLASS_TOOL)
    ce_eq("run_code -> CODE",
          motor_map_lookup(mm, "run_code"), EFF_CLASS_CODE)
    ce_eq("play_audio -> AUDIO",
          motor_map_lookup(mm, "play_audio"), EFF_CLASS_AUDIO)
    ce_eq("invoke_mcp -> MCP",
          motor_map_lookup(mm, "invoke_mcp"), EFF_CLASS_MCP)
    ce_eq("unknown signature -> INTERNAL",
          motor_map_lookup(mm, "no_such_key"), EFF_CLASS_INTERNAL)
}

// ---- Phase R1: signature builder is deterministic -----------------------
fn test_mm_activation_signature_is_deterministic() {
    // Null ctx: signature degrades to the goal-id prefix. Same call
    // twice must produce byte-identical output.
    let s1 = mm_activation_signature(0, 42)
    let s2 = mm_activation_signature(0, 42)
    ce_check("null-ctx deterministic", _mm_key_eq(s1, s2) == 1)
    ce_str_eq("null-ctx shape", s1, "g42")
    // Non-null ctx: a ctx carrying no active tokens still produces the
    // same signature as the null-ctx case (plus the goal_id prefix),
    // and a lookup against motor_map_default with that key misses
    // (returns EFF_CLASS_INTERNAL) -- confirms the registry gates
    // non-matching signatures.
    let ctx = list_new()
    push(ctx, 3601)         // AC_TAG sentinel (not inspected by signature)
    push(ctx, 0)            // tick
    push(ctx, "")           // input
    push(ctx, list_new())   // percept
    push(ctx, list_new())   // routes
    push(ctx, list_new())   // active (empty)
    let s3 = mm_activation_signature(ctx, 0)
    let s4 = mm_activation_signature(ctx, 0)
    ce_check("ctx-with-empty-active deterministic", _mm_key_eq(s3, s4) == 1)
    ce_str_eq("ctx-with-empty-active shape", s3, "g0")
    let mm = motor_map_default()
    ce_eq("default-registry miss on signature",
          motor_map_lookup(mm, s3), EFF_CLASS_INTERNAL)
}

// ---- guards --------------------------------------------------------------
fn test_guards() {
    ce_eq("is_map on 0", mm_is_map(0), 0)
    ce_eq("size on 0", motor_map_size(0), 0)
    ce_eq("lookup on 0 -> INTERNAL",
          motor_map_lookup(0, "x"), EFF_CLASS_INTERNAL)
    let mm = motor_map_new()
    // Null key in register returns 0.
    ce_eq("register with null key -> 0",
          motor_map_register(mm, 0, EFF_CLASS_SPEAK), 0)
    ce_eq("lookup with null signature -> INTERNAL",
          motor_map_lookup(mm, 0), EFF_CLASS_INTERNAL)
}

fn main() {
    test_empty_registry()
    test_register_and_lookup()
    test_register_overwrites()
    test_enumeration()
    test_unregister()
    test_motor_map_default_covers_canonical_vocabulary()
    test_mm_activation_signature_is_deterministic()
    test_guards()
    ce_summary("motor_map")
}
main()
