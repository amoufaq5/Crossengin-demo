// Unit tests for src/net/tls/tls_cert.nova (R90 TLS 1.3 cert-auth seam).
//
// Coverage
//   * Constants match RFC 8446 §4.4.3 (64-byte pad, 33-byte context,
//     1-byte separator).
//   * Byte-level layout of tls_cert_verify_input_build:
//       - 64 leading 0x20 bytes.
//       - Correct context string for server vs client role.
//       - 0x00 separator directly after the context.
//       - Transcript hash bytes appended verbatim.
//       - Server and client outputs differ ONLY in the six-byte role
//         word (bytes 64+9 .. 64+14 of the built buffer).
//       - Length = 64 + 33 + 1 + transcript_hash_len.
//   * transcript_hash_len shorter than len(transcript_hash): only the
//     leading `len` bytes are consumed.
//   * Full sign + verify round-trip using an RFC 8032 TEST 1 keypair:
//     sign the tls_cert_verify_input_build output with ed25519_sign,
//     verify via tls_cert_verify AND tls_cert_verify_ed25519.
//   * Tamper detection: bit-flipped pubkey / bit-flipped signature /
//     tampered transcript / role mismatch (server vs client) / wrong
//     transcript length -> all reject.
//   * Shape rejection: wrong-length pubkey (31 / 33), wrong-length
//     signature (63 / 65), empty pubkey/sig.
//
// References
//   RFC 8446 §4.4.3 -- CertificateVerify.
//   RFC 8032 §7.1   -- Ed25519 reference vectors used for the keypair.
//
// NOVA dependencies: ce_test harness, ed25519 (for sign in round-trip),
//   tls_cert.

import "../ce_test.nova"
import "../../src/safety/ed25519.nova"
import "../../src/net/tls/tls_cert.nova"

// ---- helpers --------------------------------------------------------------

fn _tcert_bytes_from_str(s) {
    let out = list_new()
    let i = 0
    let n = len(s)
    while i < n {
        push(out, char_at(s, i))
        i = i + 1
    }
    return out
}

fn _tcert_flip_bit(bytes, off, bit) {
    let copy = list_new()
    let i = 0
    let n = len(bytes)
    while i < n {
        push(copy, bytes[i])
        i = i + 1
    }
    list_set(copy, off, int_xor(copy[off], int_shl(1, bit)))
    return copy
}

// Build a fake 32-byte transcript hash (deterministic byte pattern).
fn _tcert_fake_transcript() {
    let h = list_new()
    let i = 0
    while i < 32 {
        push(h, int_and(int_mul(i, 17) + 13, 255))
        i = i + 1
    }
    return h
}

// ---- constants -----------------------------------------------------------

fn test_constants() {
    ce_eq("TLS_CERT_PAD_LEN = 64", TLS_CERT_PAD_LEN, 64)
    ce_eq("TLS_CERT_CONTEXT_LEN = 33", TLS_CERT_CONTEXT_LEN, 33)
    ce_eq("TLS_CERT_SEP_LEN = 1", TLS_CERT_SEP_LEN, 1)
    ce_eq("TLS_CERT_PUBKEY_LEN = 32", TLS_CERT_PUBKEY_LEN, 32)
    ce_eq("TLS_CERT_SIGNATURE_LEN = 64", TLS_CERT_SIGNATURE_LEN, 64)
    ce_eq("TLS_CERT_ROLE_CLIENT = 0", TLS_CERT_ROLE_CLIENT, 0)
    ce_eq("TLS_CERT_ROLE_SERVER = 1", TLS_CERT_ROLE_SERVER, 1)
}

// ---- input-build byte layout --------------------------------------------

fn test_input_build_length_and_prefix() {
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    ce_eq("built length = 64 + 33 + 1 + 32", len(signed), 130)
    // First 64 bytes are 0x20.
    let ok = 1
    let i = 0
    while i < 64 {
        if signed[i] != 32 { ok = 0 }
        i = i + 1
    }
    ce_eq("first 64 bytes are 0x20", ok, 1)
}

fn test_input_build_server_context() {
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    // Byte 64 = 'T'
    ce_eq("byte 64 = 'T' (0x54)", signed[64], 84)
    // Bytes 64..64+33 must spell "TLS 1.3, server CertificateVerify".
    let expected = _tcert_bytes_from_str("TLS 1.3, server CertificateVerify")
    ce_eq("expected context length is 33", len(expected), 33)
    let ok = 1
    let i = 0
    while i < 33 {
        if signed[64 + i] != expected[i] { ok = 0 }
        i = i + 1
    }
    ce_eq("server context matches literal", ok, 1)
    // Separator byte after context.
    ce_eq("byte 97 = 0x00 separator", signed[97], 0)
}

fn test_input_build_client_context() {
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_CLIENT)
    let expected = _tcert_bytes_from_str("TLS 1.3, client CertificateVerify")
    ce_eq("client context length is 33", len(expected), 33)
    let ok = 1
    let i = 0
    while i < 33 {
        if signed[64 + i] != expected[i] { ok = 0 }
        i = i + 1
    }
    ce_eq("client context matches literal", ok, 1)
    ce_eq("client build byte 97 = 0x00 separator", signed[97], 0)
}

fn test_input_build_server_vs_client_diff() {
    let th = _tcert_fake_transcript()
    let sv = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let cl = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_CLIENT)
    ce_eq("server / client builds same length", len(sv), len(cl))
    // Verify equality outside the role word:
    //   bytes [0..64+9)   -- 64 pad + "TLS 1.3, "
    //   bytes [64+15..end) -- " CertificateVerify" + separator + transcript
    let ok_prefix = 1
    let i = 0
    while i < 64 + 9 {
        if sv[i] != cl[i] { ok_prefix = 0 }
        i = i + 1
    }
    ce_eq("bytes before role word match", ok_prefix, 1)
    let ok_suffix = 1
    let j = 64 + 15
    while j < len(sv) {
        if sv[j] != cl[j] { ok_suffix = 0 }
        j = j + 1
    }
    ce_eq("bytes after role word match", ok_suffix, 1)
    // Role bytes differ: 'server' vs 'client' at offset 64+9..64+15.
    let diff = 0
    let k = 64 + 9
    while k < 64 + 15 {
        if sv[k] != cl[k] { diff = diff + 1 }
        k = k + 1
    }
    ce_eq("role word differs in all 6 chars", diff, 6)
}

fn test_input_build_transcript_appended() {
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    // Trailing bytes [98..130) should be the transcript verbatim.
    let ok = 1
    let i = 0
    while i < 32 {
        if signed[98 + i] != th[i] { ok = 0 }
        i = i + 1
    }
    ce_eq("transcript appended verbatim after separator", ok, 1)
}

fn test_input_build_partial_transcript_length() {
    // Callers may hold a longer buffer; only `len` leading bytes go in.
    let th = list_new()
    let i = 0
    while i < 64 {
        push(th, int_and(i + 1, 255))
        i = i + 1
    }
    let signed = tls_cert_verify_input_build(th, 20, TLS_CERT_ROLE_SERVER)
    ce_eq("partial length total = 64 + 33 + 1 + 20", len(signed), 118)
    let ok = 1
    let j = 0
    while j < 20 {
        if signed[98 + j] != th[j] { ok = 0 }
        j = j + 1
    }
    ce_eq("only the leading 20 transcript bytes are consumed", ok, 1)
}

// ---- sign + verify round-trip -------------------------------------------

// Sign the built input with an RFC 8032 TEST 1 keypair, then run both
// verify entrypoints. This is the primary correctness proof for the
// tls_cert seam.
fn test_round_trip_ed25519_verify_server() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    ce_eq("test pubkey is 32 bytes", len(pk), 32)
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    ce_eq("signature is 64 bytes", len(sig), 64)
    // Direct verify over the assembled signed data.
    ce_eq("tls_cert_verify accepts a valid sig",
          tls_cert_verify(pk, signed, len(signed), sig), 1)
    // One-call convenience path.
    ce_eq("tls_cert_verify_ed25519 accepts a valid sig",
          tls_cert_verify_ed25519(pk, th, 32, TLS_CERT_ROLE_SERVER, sig), 1)
}

fn test_round_trip_ed25519_verify_client() {
    let sk = ed25519_hex_to_bytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_CLIENT)
    let sig = ed25519_sign(signed, sk, pk)
    ce_eq("client round-trip verify",
          tls_cert_verify_ed25519(pk, th, 32, TLS_CERT_ROLE_CLIENT, sig), 1)
    // A server-role verify over a client-role signature must FAIL: the
    // signed content differs by exactly the role word.
    ce_eq("client sig rejected under server-role verify",
          tls_cert_verify_ed25519(pk, th, 32, TLS_CERT_ROLE_SERVER, sig), 0)
}

// ---- tamper detection ----------------------------------------------------

fn test_tamper_bit_flip_signature() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    let sig_bad = _tcert_flip_bit(sig, 7, 3)
    ce_eq("bit-flipped signature rejected",
          tls_cert_verify_ed25519(pk, th, 32, TLS_CERT_ROLE_SERVER, sig_bad), 0)
}

fn test_tamper_bit_flip_pubkey() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    let pk_bad = _tcert_flip_bit(pk, 0, 0)
    ce_eq("bit-flipped pubkey rejected",
          tls_cert_verify_ed25519(pk_bad, th, 32, TLS_CERT_ROLE_SERVER, sig), 0)
}

fn test_tamper_transcript_bit_flip() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    let th_bad = _tcert_flip_bit(th, 15, 4)
    ce_eq("bit-flipped transcript rejected",
          tls_cert_verify_ed25519(pk, th_bad, 32,
                                  TLS_CERT_ROLE_SERVER, sig), 0)
}

// ---- shape rejection -----------------------------------------------------

fn test_shape_wrong_pubkey_length() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    // 31-byte pubkey (one short).
    let pk_short = list_new()
    let i = 0
    while i < 31 { push(pk_short, pk[i]); i = i + 1 }
    ce_eq("31-byte pubkey rejected",
          tls_cert_verify(pk_short, signed, len(signed), sig), 0)
    // 33-byte pubkey (one over).
    let pk_long = list_new()
    let j = 0
    while j < 32 { push(pk_long, pk[j]); j = j + 1 }
    push(pk_long, 0)
    ce_eq("33-byte pubkey rejected",
          tls_cert_verify(pk_long, signed, len(signed), sig), 0)
    // Empty pubkey.
    ce_eq("empty pubkey rejected",
          tls_cert_verify(list_new(), signed, len(signed), sig), 0)
}

fn test_shape_wrong_signature_length() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    let sig_short = list_new()
    let i = 0
    while i < 63 { push(sig_short, sig[i]); i = i + 1 }
    ce_eq("63-byte signature rejected",
          tls_cert_verify(pk, signed, len(signed), sig_short), 0)
    let sig_long = list_new()
    let j = 0
    while j < 64 { push(sig_long, sig[j]); j = j + 1 }
    push(sig_long, 0)
    ce_eq("65-byte signature rejected",
          tls_cert_verify(pk, signed, len(signed), sig_long), 0)
    ce_eq("empty signature rejected",
          tls_cert_verify(pk, signed, len(signed), list_new()), 0)
}

fn test_shape_bad_signed_data_len() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let th = _tcert_fake_transcript()
    let signed = tls_cert_verify_input_build(th, 32, TLS_CERT_ROLE_SERVER)
    let sig = ed25519_sign(signed, sk, pk)
    // Negative signed_data_len -> reject.
    ce_eq("negative signed_data_len rejected",
          tls_cert_verify(pk, signed, 0 - 1, sig), 0)
    // signed_data_len > len(signed_data) -> reject.
    ce_eq("oversized signed_data_len rejected",
          tls_cert_verify(pk, signed, len(signed) + 1, sig), 0)
    // signed_data_len < len(signed_data) -> truncated view, and since
    // the truncated data won't match the message that was signed, the
    // signature must fail to verify.
    ce_eq("shorter signed_data_len rejects (different content)",
          tls_cert_verify(pk, signed, len(signed) - 1, sig), 0)
}

fn main() {
    test_constants()
    test_input_build_length_and_prefix()
    test_input_build_server_context()
    test_input_build_client_context()
    test_input_build_server_vs_client_diff()
    test_input_build_transcript_appended()
    test_input_build_partial_transcript_length()
    test_round_trip_ed25519_verify_server()
    test_round_trip_ed25519_verify_client()
    test_tamper_bit_flip_signature()
    test_tamper_bit_flip_pubkey()
    test_tamper_transcript_bit_flip()
    test_shape_wrong_pubkey_length()
    test_shape_wrong_signature_length()
    test_shape_bad_signed_data_len()
    ce_summary("tls_cert")
}

main()
