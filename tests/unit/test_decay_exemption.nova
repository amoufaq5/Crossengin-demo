// Unit tests for the ADR-0088/0023 decay exemption: a verified FORMAL atom is
// exempt from time decay (a theorem does not become less true while
// unobserved), and the exemption is grade-derived so the kernel's unpin path
// (verify_recheck_atom dropping the grade) automatically re-enables decay.

import "../ce_test.nova"
import "../../src/mind/verify.nova"
import "../../src/learning/bayesian_updates.nova"

fn _ax(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

// A non-FORMAL atom is not exempt and DOES decay toward the prior.
fn test_ordinary_atom_decays() {
    let a = atom_new(0, 1, ATOM_CONCEPT, "rumor", 0)
    // push it well above prior so decay is observable.
    atom_observe_graded(a, 1)
    atom_observe_graded(a, 1)
    atom_observe_graded(a, 1)
    let before = atom_confidence(a)
    ce_check("non-formal not exempt", atom_decay_exempt(a) == 0)
    ce_check("starts above prior", before > 500)
    atom_decay_belief(a, 500)   // 0.5 retention -> strong decay
    let after = atom_confidence(a)
    ce_check("decayed toward prior", after < before)
}

// A verified FORMAL atom is exempt: its pinned belief does not move under decay.
fn test_formal_atom_is_exempt() {
    let reg = proof_registry_new()
    let a = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let p = term_atom("p")
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    verify_pin_atom(reg, a, pkt)
    ce_eq("grade FORMAL", atom_evidence_grade(a), GRADE_FORMAL)
    ce_eq("is exempt", atom_decay_exempt(a), 1)
    let before = atom_confidence(a)
    ce_check("pinned high", before > 990)
    // Hammer it with aggressive decay; a theorem must not erode.
    atom_decay_belief(a, 100)   // 0.1 retention
    atom_decay_belief(a, 100)
    atom_decay_belief(a, 100)
    ce_eq("confidence unchanged after decay", atom_confidence(a), before)
}

// The exemption is grade-derived: after the kernel unpins (re-check fails and
// drops the grade), the atom decays normally again -- "pin conditional on
// re-checkability" (ADR-0088).
fn test_exemption_lifts_after_unpin() {
    let reg = proof_registry_new()
    let a = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let p = term_atom("p")
    let q = term_atom("q")
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    verify_pin_atom(reg, a, pkt)
    ce_eq("exempt while FORMAL", atom_decay_exempt(a), 1)
    // Re-check with a bogus packet -> kernel rejects -> unpin (grade dropped).
    let bad = verify_packet(_ax(q), hyp_new(), pf_axiom(q), p, "p", "tampered")
    verify_recheck_atom(reg, a, bad)
    ce_eq("grade dropped", atom_evidence_grade(a), GRADE_UNKNOWN)
    ce_eq("no longer exempt", atom_decay_exempt(a), 0)
    // Belief is back at the prior (the unpin reset it); decay is a harmless
    // no-op at the prior but the exemption gate now lets it run.
    let before = atom_confidence(a)
    atom_observe_graded(a, 1) atom_observe_graded(a, 1)
    let raised = atom_confidence(a)
    ce_check("can move again", raised > before)
    atom_decay_belief(a, 200)
    ce_check("decays again after unpin", atom_confidence(a) < raised)
}

// tb_decay still works (it now delegates to bel_decay) -- guards the refactor.
fn test_tb_decay_still_decays() {
    let tb = tb_new(5000, 1000, 0)
    let before = tb_confidence(tb)
    tb_decay(tb, 500)
    ce_check("tb still decays", tb_confidence(tb) < before)
}

fn main() {
    test_ordinary_atom_decays()
    test_formal_atom_is_exempt()
    test_exemption_lifts_after_unpin()
    test_tb_decay_still_decays()
    ce_summary("decay_exemption")
}

main()
