// Unit tests for src/net/tls/tls_alerts.nova
// (R86, ADR r86-in-process-tls-scaffolding).
//
// Covers the alert enum (every RFC 8446 §6 code), constructors,
// two-byte serialize / parse round-trip, level + description
// name lookup, close_notify shorthand.

import "../ce_test.nova"
import "../../src/net/tls/tls_alerts.nova"
import "../../src/util/str_safe.nova"

fn _round_trip_desc(label, desc) {
    let a = tls_alert_new(TLS_ALERT_LEVEL_FATAL, desc)
    let pair = tls_alert_bytes_buf(a)
    let buf  = pair[TLS_ALERT_BUF_PTR]
    let n    = pair[TLS_ALERT_BUF_LEN]
    ce_eq(label + " bytes len", n, 2)
    let a2 = tls_alert_parse_buf(buf, n)
    ce_check(label + " parsed", a2 != 0)
    ce_eq(label + " round-trip level",       tls_alert_level(a2),       TLS_ALERT_LEVEL_FATAL)
    ce_eq(label + " round-trip description", tls_alert_description(a2), desc)
    ce_eq(label + " known",                  tls_alert_known(desc),     1)
}

fn test_level_constants() {
    ce_eq("warning level = 1", TLS_ALERT_LEVEL_WARNING, 1)
    ce_eq("fatal level = 2",   TLS_ALERT_LEVEL_FATAL,   2)
}

fn test_constructor_and_accessors() {
    let a = tls_alert_new(TLS_ALERT_LEVEL_FATAL, TLS_ALERT_HANDSHAKE_FAILURE)
    ce_eq("level accessor", tls_alert_level(a),       TLS_ALERT_LEVEL_FATAL)
    ce_eq("desc accessor",  tls_alert_description(a), TLS_ALERT_HANDSHAKE_FAILURE)
}

fn test_close_notify_shorthand() {
    let a = tls_alert_close_notify()
    ce_eq("close_notify is warning", tls_alert_level(a),       TLS_ALERT_LEVEL_WARNING)
    ce_eq("close_notify desc code",  tls_alert_description(a), TLS_ALERT_CLOSE_NOTIFY)
}

fn test_round_trip_every_known_code() {
    _round_trip_desc("close_notify",                    TLS_ALERT_CLOSE_NOTIFY)
    _round_trip_desc("unexpected_message",              TLS_ALERT_UNEXPECTED_MESSAGE)
    _round_trip_desc("bad_record_mac",                  TLS_ALERT_BAD_RECORD_MAC)
    _round_trip_desc("record_overflow",                 TLS_ALERT_RECORD_OVERFLOW)
    _round_trip_desc("handshake_failure",               TLS_ALERT_HANDSHAKE_FAILURE)
    _round_trip_desc("bad_certificate",                 TLS_ALERT_BAD_CERTIFICATE)
    _round_trip_desc("unsupported_certificate",         TLS_ALERT_UNSUPPORTED_CERTIFICATE)
    _round_trip_desc("certificate_revoked",             TLS_ALERT_CERTIFICATE_REVOKED)
    _round_trip_desc("certificate_expired",             TLS_ALERT_CERTIFICATE_EXPIRED)
    _round_trip_desc("certificate_unknown",             TLS_ALERT_CERTIFICATE_UNKNOWN)
    _round_trip_desc("illegal_parameter",               TLS_ALERT_ILLEGAL_PARAMETER)
    _round_trip_desc("unknown_ca",                      TLS_ALERT_UNKNOWN_CA)
    _round_trip_desc("access_denied",                   TLS_ALERT_ACCESS_DENIED)
    _round_trip_desc("decode_error",                    TLS_ALERT_DECODE_ERROR)
    _round_trip_desc("decrypt_error",                   TLS_ALERT_DECRYPT_ERROR)
    _round_trip_desc("protocol_version",                TLS_ALERT_PROTOCOL_VERSION)
    _round_trip_desc("insufficient_security",           TLS_ALERT_INSUFFICIENT_SECURITY)
    _round_trip_desc("internal_error",                  TLS_ALERT_INTERNAL_ERROR)
    _round_trip_desc("inappropriate_fallback",          TLS_ALERT_INAPPROPRIATE_FALLBACK)
    _round_trip_desc("user_canceled",                   TLS_ALERT_USER_CANCELED)
    _round_trip_desc("missing_extension",               TLS_ALERT_MISSING_EXTENSION)
    _round_trip_desc("unsupported_extension",           TLS_ALERT_UNSUPPORTED_EXTENSION)
    _round_trip_desc("unrecognized_name",               TLS_ALERT_UNRECOGNIZED_NAME)
    _round_trip_desc("bad_certificate_status_response", TLS_ALERT_BAD_CERTIFICATE_STATUS_RESPONSE)
    _round_trip_desc("unknown_psk_identity",            TLS_ALERT_UNKNOWN_PSK_IDENTITY)
    _round_trip_desc("certificate_required",            TLS_ALERT_CERTIFICATE_REQUIRED)
    _round_trip_desc("no_application_protocol",         TLS_ALERT_NO_APPLICATION_PROTOCOL)
}

fn test_parse_rejects_short_input() {
    let buf = alloc(4)
    store8(buf + 0, 1)
    ce_eq("zero-len parse -> 0",   tls_alert_parse_buf(buf, 0), 0)
    ce_eq("one-byte parse -> 0",   tls_alert_parse_buf(buf, 1), 0)
    ce_eq("three-byte parse -> 0", tls_alert_parse_buf(buf, 3), 0)
}

fn test_parse_accepts_unknown_desc() {
    // RFC 8446 says peers MUST ignore unknown alerts; parser accepts,
    // caller filters via tls_alert_known.
    let buf = alloc(2)
    store8(buf + 0, TLS_ALERT_LEVEL_FATAL)
    store8(buf + 1, 240)
    let a = tls_alert_parse_buf(buf, 2)
    ce_check("parsed unknown", a != 0)
    ce_eq("unknown desc round-trip", tls_alert_description(a), 240)
    ce_eq("known() returns 0 for unknown", tls_alert_known(240), 0)
}

fn test_name_lookup() {
    ce_str_eq("desc name close_notify",  tls_alert_desc_name(TLS_ALERT_CLOSE_NOTIFY), "close_notify")
    ce_str_eq("desc name bad_record_mac", tls_alert_desc_name(TLS_ALERT_BAD_RECORD_MAC), "bad_record_mac")
    ce_str_eq("desc name internal_error", tls_alert_desc_name(TLS_ALERT_INTERNAL_ERROR), "internal_error")
    ce_str_eq("level name warning", tls_alert_level_name(TLS_ALERT_LEVEL_WARNING), "warning")
    ce_str_eq("level name fatal",   tls_alert_level_name(TLS_ALERT_LEVEL_FATAL),   "fatal")
    // Unknown codes stringify as "unknown_alert(<N>)"
    let s = tls_alert_desc_name(240)
    ce_check("unknown desc stringifies", len(s) > 0)
    ce_check("unknown desc name contains 240", find_bytes(s, "240") >= 0)
}

fn test_wire_byte_order_is_level_then_desc() {
    // Level MUST come first per RFC 8446 §6.
    let a = tls_alert_new(TLS_ALERT_LEVEL_FATAL, TLS_ALERT_UNEXPECTED_MESSAGE)
    let pair = tls_alert_bytes_buf(a)
    let buf  = pair[TLS_ALERT_BUF_PTR]
    ce_eq("byte 0 = level", load8(buf + 0), TLS_ALERT_LEVEL_FATAL)
    ce_eq("byte 1 = desc",  load8(buf + 1), TLS_ALERT_UNEXPECTED_MESSAGE)
}

fn test_close_notify_bytes_contain_nul() {
    // The close_notify description is 0. NUL-safety is the reason the
    // serializer uses byte-buffer pairs instead of NOVA strings.
    let a = tls_alert_close_notify()
    let pair = tls_alert_bytes_buf(a)
    let buf  = pair[TLS_ALERT_BUF_PTR]
    let n    = pair[TLS_ALERT_BUF_LEN]
    ce_eq("len still 2 with NUL", n, 2)
    ce_eq("byte 0 = warning",     load8(buf + 0), TLS_ALERT_LEVEL_WARNING)
    ce_eq("byte 1 = NUL",         load8(buf + 1), 0)
    // Round-trip via the same buf.
    let a2 = tls_alert_parse_buf(buf, n)
    ce_eq("round-trip level", tls_alert_level(a2),       TLS_ALERT_LEVEL_WARNING)
    ce_eq("round-trip desc",  tls_alert_description(a2), TLS_ALERT_CLOSE_NOTIFY)
}

fn main() {
    test_level_constants()
    test_constructor_and_accessors()
    test_close_notify_shorthand()
    test_round_trip_every_known_code()
    test_parse_rejects_short_input()
    test_parse_accepts_unknown_desc()
    test_name_lookup()
    test_wire_byte_order_is_level_then_desc()
    test_close_notify_bytes_contain_nul()
    ce_summary("tls_alerts")
}

main()
