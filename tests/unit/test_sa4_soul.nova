// CE_TEST_TIMEOUT: 240
// Unit tests for src/learning/sa4_soul.nova (SecAgg v4 soul state machine,
// A2.2a): full in-memory rounds through tests/sa4_harness.nova.
//
// - N = 3, t = 3, everyone honest: the aggregate rebuilt from the reveals
//   equals the sum of the inputs (mod 2^32), every soul reveals one
//   b-share per soul, the transcript is byte-reproducible.
// Dropout rounds are in test_sa4_soul_dropout*.nova (split when Ed25519
// still cost ~23-46 MB per operation; since A2.3a it is ~30-45 KB).
// With nobody dropping, pairwise masks cancel under either sign convention;
// the dropout tests are what pin the convention (v > u adds, v < u subtracts).
// Ed25519 dominates the cost (~4 ms per signature, ~8 ms per check since
// A2.3a); the shared vcache makes repeats free.

import "../ce_test.nova"
import "../sa4_harness.nova"

fn _count_prefix(lines, p) {
    return len(sa4h_filter(lines, p))
}

fn test_honest_n3(vc) {
    let roster = sa4h_roster(3)
    ce_eq("roster N=3 ok", sroster_ok(roster), 1)
    ce_eq("t=3", sroster_t(roster), 3)
    let souls = sa4h_souls(roster, 3, 5, vc, 4)
    let res = sa4h_run(roster, souls, 5, 0 - 1, 0 - 1)
    ce_eq("N=3 round completes", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("N=3 aggregate equals the sum of inputs", res[2], 1)
    let i = 0
    let done = 0
    while i < 3 {
        if sa4s_state(souls[i]) == SA4S_ST_DONE { done = done + 1 }
        if sa4s_done_round(souls[i]) != 5 { done = done - 10 }
        i = i + 1
    }
    ce_eq("all souls done with round 5", done, 3)
    let wiped = 0
    i = 0
    while i < 3 {
        wiped = wiped + sa4h_wiped(souls[i])
        if souls[i][19] != 0 { wiped = wiped - 10 }
        i = i + 1
    }
    ce_eq("round secrets and held shares wiped at DONE", wiped, 3)
    let rv = res[6]
    ce_eq("3 souls x 3 b-reveals", len(rv), 9)
    ce_eq("no s-share revealed when nobody drops", len(sa4h_filter(rv, "SA4_REVEAL 5 7 300 s")) + len(sa4h_filter(rv, "SA4_REVEAL 5 300 7 s")), 0)
    let all = res[5]
    ce_eq("6 share lines", _count_prefix(all, "SA4_SHARE "), 6)
    ce_eq("2 Y chunks per soul", _count_prefix(all, "SA4_Y "), 6)
    ce_eq("3 consistency signatures", _count_prefix(all, "SA4_SIG3 "), 3)
    let longest = 0
    i = 0
    while i < len(all) {
        if len(all[i]) > longest { longest = len(all[i]) }
        i = i + 1
    }
    ce_check("every line under 1000 bytes", longest <= 1000)
    // A line after the round finished is refused.
    let late = sa4s_handle(souls[0], sa4w_fmt_set(5, 4, sa4w_bitmap([1, 2, 3])))
    ce_eq("line after DONE refused", late[0], 0)
    ce_eq("refused soul aborts", sa4s_state(souls[0]), SA4S_ST_ABORTED)
    // Byte-reproducible: the same seeds give the same ADV lines.
    let again = sa4h_souls(roster, 3, 5, vc, 4)
    let a2 = sa4h_feed(again[1], sa4h_one(sa4h_round_line(roster, 5)))
    ce_str_eq("deterministic ADV", a2[1][0], res[4][1])
    return 0
}

fn main() {
    let vc = list_new()
    test_honest_n3(vc)
    ce_summary("sa4_soul")
}

main()
