// Audit F-23: bake_child writes a "#KG v1" section into the child bundle,
// but nothing loaded it -- session_snapshot_apply_ex has no KG marker, so a
// baked child booted with an empty KG. bake_bundle_apply_kg (update_delta.nova)
// now applies the section; the RPC daemon's child-mode boot calls it.
//
// Round trip: bake a bundle from a registry holding solar_system/{mars,
// phobos, deimos}, apply its KG section to a FRESH registry, and check the
// atoms (label, kind, license) arrive. Re-applying is a no-op.

import "../ce_test.nova"
import "../../src/factory/bake.nova"
import "../../src/factory/bake_manifest.nova"
import "../../src/factory/update_delta.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/ingest/policy.nova"
import "../../src/safety/ed25519.nova"
import "../../src/util/str_safe.nova"
import "std/string"
import "std/io"

fn _mk_kgreg() {
    let r = kg_registry_new()
    let kg1 = kg_spawn(r, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    atom_set_license(a1, LICENSE_OPEN)
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    atom_set_license(a2, LICENSE_OPEN)
    kg_add_atom(kg1, ATOM_FACT, "deimos", 0)
    return r
}

fn _mk_manifest() {
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "solar-child")
    bake_manifest_set_version(m, "0.1.0")
    bake_manifest_set_domain(m, "astronomy")
    bake_manifest_add_capsule(m, "solar_system")
    bake_manifest_add_kg_prefix(m, "solar_")
    return m
}

fn _bake_bundle() {
    let kp = ed25519_keygen()
    let capreg = capreg_new()
    capreg_register(capreg, capsule_new("solar_system", "1.0.0", "system", "OPEN"))
    let br = bake_child(_mk_manifest(), persona_registry_new(), _mk_kgreg(),
                        capreg, skill_registry_new(), policy_registry_new(),
                        ownership_registry_new(), kp[0], kp[1], 5)
    ce_eq("bake ok", bake_result_ok(br), 1)
    return bake_result_bundle(br)
}

fn test_kg_section_round_trip() {
    let bundle = _bake_bundle()
    ce_check("bundle carries #KG v1", find_bytes(bundle, "#KG v1") >= 0)
    let fresh = kg_registry_new()
    let added = bake_bundle_apply_kg(bundle, fresh, 9)
    ce_eq("three atoms applied", added, 3)
    let kg = kg_find(fresh, "solar_system")
    ce_check("solar_system KG created", kg != 0)
    let mars = kg_find_atom(kg, "mars")
    ce_check("mars present", mars != 0)
    ce_check("phobos present", kg_find_atom(kg, "phobos") != 0)
    ce_check("deimos present", kg_find_atom(kg, "deimos") != 0)
    ce_eq("mars kind preserved", atom_kind(mars), ATOM_FACT)
    ce_eq("mars license preserved", atom_license(mars), LICENSE_OPEN)
    ce_eq("re-apply is a no-op", bake_bundle_apply_kg(bundle, fresh, 10), 0)
}

fn test_no_kg_section_is_noop() {
    let fresh = kg_registry_new()
    ce_eq("bundle without #KG v1 adds nothing",
          bake_bundle_apply_kg("#CROSSENGIN-BUNDLE v1\n#PERSONA v1\n", fresh, 1), 0)
    ce_eq("null registry adds nothing", bake_bundle_apply_kg(_bake_bundle(), 0, 1), 0)
}

fn main() {
    test_kg_section_round_trip()
    test_no_kg_section_is_noop()
    ce_summary("bake_kg_roundtrip")
}

main()
