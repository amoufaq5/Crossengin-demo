// CE_TEST_TIMEOUT: 240
// Malicious-coordinator test for SecAgg v4 (A2.2b): the false-dropout
// attack. N = 5, t = 4. Every soul, including E (id 4294967295), sends its
// masked y. The coordinator then:
//   - tells souls 1-4 that E dropped (U3 = {1,2,3,4}). They sign that T3,
//     see t valid signatures, and reveal E's s-share;
//   - tells E that U3 = all five, hoping for b-shares about E.
// To unmask y_E it needs both E's s key (to strip the pairwise masks) and
// b_E (to strip PRG(b_E)). It gets t s-shares about E but no b-share: only
// souls that signed a U3 containing E reveal one, and E refuses because
// the others' signatures are over a different T3. Stripping the pairwise
// masks from y_E leaves x_E + PRG(b_E), which does not equal x_E.
//
// v4-sa3 (A2.4c) attacks on the complaint round:
//   - forged complaints (zero signature, a colluder signing as the
//     complainer, another soul's complaint naming the complainer's leaf, a
//     complaint from an older round, one over another H1) get no SA4_OPEN
//     from an honest accused, and no abort;
//   - across fault scenarios, every SA4_OPEN of an honest dealer's line is
//     at a corrupt complainer's x (an honest share is never opened at an
//     honest x);
//   - A1: a corrupt receiver shows an honest sender a second valid ADV
//     (other c key) and re-signs its complaint over the sender's H1: the
//     honest sender is removed unproven (code 4), no evidence; without
//     the re-signed complaint (an honest coordinator and a network
//     attacker showing 7 the second ADV) 7 cannot verify the complaint,
//     sends no OPEN, and is removed with code 3, no evidence;
//   - A2: a corrupt sender shows an honest receiver a second valid ADV
//     (other M) and opens every complaint: the honest receiver is removed
//     unproven (code 5), no evidence;
//   - A3: a false complaint plus a MITM on the accused's uplink: the liar
//     is proven (code 2), the honest accused removed unproven (code 3).

import "../ce_test.nova"
import "../sa4_harness.nova"

let AT_R = 37

fn test_false_dropout(vc) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, AT_R, vc, 0)
    let rl = sa4h_round_line(roster, AT_R)
    let advs = list_new()
    let i = 0
    while i < 5 {
        advs = sa4h_cat(advs, sa4h_feed(souls[i], sa4h_one(rl))[1])
        i = i + 1
    }
    let set1 = sa4w_fmt_set(AT_R, 1, sa4w_bitmap([1, 2, 3, 4, 5]))
    let shares = list_new()
    i = 0
    while i < 5 {
        shares = sa4h_cat(shares, sa4h_filter(sa4h_feed(souls[i], sa4h_cat(advs, sa4h_one(set1)))[1], "SA4_SHARE "))
        i = i + 1
    }
    let set5 = sa4w_fmt_set(AT_R, 5, sa4w_bitmap([1, 2, 3, 4, 5]))
    let set2 = sa4w_fmt_set(AT_R, 2, sa4w_bitmap([1, 2, 3, 4, 5]))
    let ys = list_new()
    i = 0
    while i < 5 {
        let me = SA4H_IDS[i]
        let mine = list_new()
        let j = 0
        while j < len(shares) {
            if sa4w_parse(shares[j])[3] == me { push(mine, shares[j]) }
            j = j + 1
        }
        push(mine, set5)
        sa4h_feed(souls[i], mine)
        ys = sa4h_cat(ys, sa4h_filter(sa4h_feed(souls[i], sa4h_one(set2))[1], "SA4_Y "))
        i = i + 1
    }
    ce_eq("all five sent y (2 chunks each)", len(ys), 10)
    // Equivocate U3.
    let u3a = sa4w_fmt_set(AT_R, 3, sa4w_bitmap([1, 2, 3, 4]))
    let u3e = sa4w_fmt_set(AT_R, 3, sa4w_bitmap([1, 2, 3, 4, 5]))
    let sigs = list_new()
    i = 0
    while i < 4 {
        sigs = sa4h_cat(sigs, sa4h_feed(souls[i], sa4h_one(u3a))[1])
        i = i + 1
    }
    let esig = sa4h_feed(souls[4], sa4h_one(u3e))[1]
    ce_eq("E signed its T3", len(esig), 1)
    let set4a = sa4w_fmt_set(AT_R, 4, sa4w_bitmap([1, 2, 3, 4]))
    let reveals = list_new()
    i = 0
    while i < 4 {
        let f = sa4h_feed(souls[i], sa4h_cat(sigs, sa4h_one(set4a)))
        ce_eq("soul " + int_to_str(i + 1) + " reveals for U3 = 1-4", f[0], 1)
        reveals = sa4h_cat(reveals, sa4h_filter(f[1], "SA4_REVEAL "))
        i = i + 1
    }
    // E: the others' signatures (over the other T3) plus its own.
    let fe = sa4h_feed(souls[4], sa4h_cat(sa4h_cat(sigs, esig), sa4h_one(sa4w_fmt_set(AT_R, 4, sa4w_bitmap([1, 2, 3, 4, 5])))))
    ce_eq("E refuses", fe[0], 0)
    ce_check("E refuses on a consistency signature (" + fe[2] + ")", find_bytes(fe[2], "does not verify") >= 0)
    ce_eq("E revealed nothing", len(sa4h_filter(fe[1], "SA4_REVEAL ")), 0)
    // What the coordinator now holds about E.
    let eid = 4294967295
    let ss = list_new()
    let bcount = 0
    i = 0
    while i < len(reveals) {
        let p = sa4w_parse(reveals[i])
        if p[3] == eid {
            if p[4] == 0 { bcount = bcount + 1 }
            if p[4] == 1 { push(ss, shamir_share(sroster_x(roster, p[2]), sac_list_to_buf(p[5]), 32)) }
        }
        i = i + 1
    }
    ce_eq("b-shares about E: none", bcount, 0)
    ce_eq("s-shares about E: t = 4", len(ss), 4)
    let s_e = shamir_combine(ss, 32)
    let chk = alloc(33)
    sac_x25519_pub(chk, s_e)
    let espk = sa4w_parse(advs[4])[4]
    ce_eq("the coordinator really has E's s key", sa4h_same(sac_buf_to_list(chk, 32), espk), 1)
    // Strip E's pairwise masks from y_E (every other id is below E's, so
    // y_E carries -PRG(s_Ev) for each v).
    let erecs = list_new()
    i = 0
    while i < len(ys) {
        let y = sa4w_parse(ys[i])
        if y[2] == eid { push(erecs, y) }
        i = i + 1
    }
    let z = sa4w_y_assemble(erecs, SA4H_L)
    i = 0
    while i < 4 {
        let v = SA4H_IDS[i]
        let ms = sac_mask_seed(s_e, sac_list_to_buf(sa4w_parse(advs[i])[4]), AT_R, eid, v)
        z = saprg_mask(z, ms[0], 1)
        i = i + 1
    }
    let xe = sa4h_input(4, SA4H_L)
    let same = 0
    i = 0
    while i < SA4H_L {
        if z[i] == xe[i] { same = same + 1 }
        i = i + 1
    }
    ce_eq("x_E stays hidden behind PRG(b_E): no word matches", same, 0)
    // Control: the same reveals do give the honest aggregate over souls
    // 1-4 (E treated as dropped), so the mask arithmetic above is right.
    let ys4 = list_new()
    i = 0
    while i < len(ys) {
        if sa4w_parse(ys[i])[2] != eid { push(ys4, ys[i]) }
        i = i + 1
    }
    let agg = sa4h_unmask(roster, AT_R, advs, ys4, reveals, [1, 2, 3, 4, 5], [1, 2, 3, 4])
    ce_eq("control: aggregate over souls 1-4 is exact", sa4h_same(agg, sa4h_expected([1, 2, 3, 4])), 1)
    return 0
}

// ---- v4-sa3 --------------------------------------------------------------------

// Souls through R1; the accused (index 0, id 7) through its check phase.
// Returns [souls, advs, shares].
fn at_checked(roster, vc, r) {
    let souls = sa4h_souls(roster, 5, r, vc, 0)
    let rl = sa4h_round_line(roster, r)
    let advs = list_new()
    let i = 0
    while i < 5 {
        advs = sa4h_cat(advs, sa4h_feed(souls[i], sa4h_one(rl))[1])
        i = i + 1
    }
    let set1 = sa4w_fmt_set(r, 1, sa4w_bitmap([1, 2, 3, 4, 5]))
    let shares = list_new()
    i = 0
    while i < 5 {
        shares = sa4h_cat(shares, sa4h_filter(sa4h_feed(souls[i], sa4h_cat(advs, sa4h_one(set1)))[1], "SA4_SHARE "))
        i = i + 1
    }
    let mine = list_new()
    let j = 0
    while j < len(shares) {
        if sa4w_parse(shares[j])[3] == 7 { push(mine, shares[j]) }
        j = j + 1
    }
    push(mine, sa4w_fmt_set(r, 5, sa4w_bitmap([1, 2, 3, 4, 5])))
    let fc = sa4h_feed(souls[0], mine)
    ce_eq("accused through its check phase", fc[0], 1)
    return [souls, advs, shares]
}

fn at_seed(i) { return ed25519_hex_to_bytes(SA4H_SEEDS[i]) }
fn at_pk(i) { return ed25519_hex_to_bytes(SA4H_PKS[i]) }

fn test_forged_complaints(roster, vc) {
    let r = 47
    let fp = sa4w_unhex(sroster_fingerprint(roster), 32)
    let names = ["zero signature", "colluder 70000 signs as 65536", "70000's complaint naming 65536's leaf", "65536's complaint from round 46", "65536's complaint over another H1", "control: 65536's genuine complaint"]
    let k = 0
    while k < len(names) {
        let st = at_checked(roster, vc, r)
        let souls = st[0]
        let h1 = souls[0][23]
        // 7's genuine line to 65536 and its leaf.
        let line = ""
        let j = 0
        while j < len(st[2]) {
            let q = sa4w_parse(st[2][j])
            if q[2] == 7 {
                if q[3] == 65536 { line = st[2][j] }
            }
            j = j + 1
        }
        let q2 = sa4w_parse(line)
        let lh = sa4w_sleaf(fp, r, 7, 3, 65536, q2[5], q2[4])
        let cl = ""
        let cx = 3
        if k == 0 { cl = sa4w_fmt_complaint(r, 65536, 7, lh, sa4h_cat(lh, lh)) }
        if k == 1 { cl = sa4w_fmt_complaint(r, 65536, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, r, 65536, 7, h1, lh), at_seed(3), at_pk(3))) }
        if k == 2 {
            cl = sa4w_fmt_complaint(r, 70000, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, r, 70000, 7, h1, lh), at_seed(3), at_pk(3)))
            cx = 4
        }
        if k == 3 { cl = sa4w_fmt_complaint(r, 65536, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, r - 1, 65536, 7, h1, lh), at_seed(2), at_pk(2))) }
        if k == 4 { cl = sa4w_fmt_complaint(r, 65536, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, r, 65536, 7, sa4w_sha256(sa4e_bytes("x")), lh), at_seed(2), at_pk(2))) }
        if k == 5 { cl = sa4w_fmt_complaint(r, 65536, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, r, 65536, 7, h1, lh), at_seed(2), at_pk(2))) }
        let f = sa4h_feed(souls[0], [cl, sa4w_fmt_accuse(r, sa4w_bitmap([cx]))])
        ce_eq(names[k] + ": no refusal", f[0], 1)
        let opens = sa4h_filter(f[1], "SA4_OPEN ")
        if k == 5 {
            ce_eq(names[k] + ": one OPEN", len(opens), 1)
            let e = sa4w_parse(opens[0])[4]
            let pkb = alloc(33)
            x25519_base(pkb, sac_list_to_buf(e))
            ce_str_eq(names[k] + ": X25519_base(e) == own e_pk", sa4w_hex(sac_buf_to_list(pkb, 32)), sa4w_hex(q2[5]))
            ce_str_eq(names[k] + ": END 5 1", f[1][len(f[1]) - 1], sa4w_fmt_end(r, 5, 7, 1))
        } else {
            ce_eq(names[k] + ": no OPEN", len(opens), 0)
            ce_str_eq(names[k] + ": END 5 0", f[1][len(f[1]) - 1], sa4w_fmt_end(r, 5, 7, 0))
        }
        ce_eq(names[k] + ": state OPENED", sa4s_state(souls[0]), SA4S_ST_OPENED)
        k = k + 1
    }
    return 0
}

// Every OPEN in a log has a corrupt accused or a corrupt complainer.
fn at_opens_ok(roster, log, corrupt) {
    let bad = 0
    let i = 0
    while i < len(log) {
        let l = log[i][1]
        if sa4h_starts(l, "SA4_OPEN ") == 1 {
            let q = sa4w_parse(l)
            let ux = sroster_x(roster, q[2])
            let vx = sroster_x(roster, q[3])
            if sa4e_in(corrupt, ux) == 0 {
                if sa4e_in(corrupt, vx) == 0 { bad = bad + 1 }
            }
        }
        i = i + 1
    }
    return bad
}

fn at_count_opens(log) {
    let n = 0
    let i = 0
    while i < len(log) {
        if sa4h_starts(log[i][1], "SA4_OPEN ") == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}

// [label, faults, corrupt xs, uplink tampers]
fn test_privacy(roster, vc) {
    let cases = [["bad share (garbage) 4294967295 -> 7", [[1, 4, 1, 1]], [5], list_new()],
        ["bad share (fields)", [[1, 4, 2, 2]], [5], list_new()],
        ["bad share (commit)", [[1, 4, 3, 3]], [5], list_new()],
        ["false complaint 65536 about 7", [[3, 2, 1]], [3], list_new()],
        ["false complaints 65536 about everyone", [[3, 2, 1], [3, 2, 2], [3, 2, 4], [3, 2, 5]], [3], list_new()],
        ["corrupt accused opens everything", [[1, 4, 1, 1], [6, 4]], [5], list_new()],
        ["downlink alteration on 7", [[5, 0, 5]], list_new(), list_new()],
        ["uplink alteration of 7 -> 65536", list_new(), list_new(), [[0, 1, 11, 65536]]],
        ["foreign one-time key", [[1, 4, 1, 5]], [5], list_new()]]
    let total = 0
    let k = 0
    while k < len(cases) {
        let cs = cases[k]
        let souls = sa4h_souls(roster, 5, 53, vc, 0)
        let c = sa4c_new(roster, 53, SA4H_L, sa4h_layout(), vc)
        let res = sa4e_round_x(roster, souls, c, list_new(), cs[3], list_new(), cs[1])
        ce_eq(cs[0] + ": every OPEN has a corrupt accused or complainer", at_opens_ok(roster, res[4], cs[2]), 0)
        total = total + at_count_opens(res[4])
        k = k + 1
    }
    ce_check("the scenarios do produce OPEN lines (" + int_to_str(total) + ")", total >= 5)
    return 0
}

fn test_double_adv(roster, vc) {
    // A1: corrupt receiver 65536 (x = 3) shows honest sender 7 a second ADV
    // with another c key, and re-signs its complaint over 7's H1.
    let souls = sa4h_souls(roster, 5, 59, vc, 0)
    let c = sa4c_new(roster, 59, SA4H_L, sa4h_layout(), vc)
    let res = sa4e_round_x(roster, souls, c, list_new(), list_new(), list_new(), [[7, 0, 3, 0], [8, 0, 3]])
    ce_eq("A1: honest sender 7 removed unproven (code 4)", sa4c_blamed(c, 7), 4)
    ce_str_eq("A1: no evidence against 7", sa4c_evidence(c, 7), "")
    ce_eq("A1: the complainer is not blamed", sa4c_blamed(c, 65536), 0)
    ce_eq("A1: OPENs only to the corrupt 65536", at_opens_ok(roster, res[4], [3]), 0)
    ce_eq("A1: 7 did open (to 65536)", at_count_opens(res[4]), 1)
    ce_eq("A1: the round completes", res[0], 1)
    // A1 with an honest coordinator and a network attacker: the second ADV
    // reaches 7 only, and 65536's complaint is signed over the
    // coordinator's H1, which 7 cannot verify (its own H1 differs). 7
    // sends no OPEN and is removed with code 3 (not proven), no evidence.
    let souls1 = sa4h_souls(roster, 5, 63, vc, 0)
    let c1 = sa4c_new(roster, 63, SA4H_L, sa4h_layout(), vc)
    let res1 = sa4e_round_x(roster, souls1, c1, list_new(), list_new(), list_new(), [[7, 0, 3, 0]])
    ce_eq("A1 (network attacker): honest sender 7 removed unproven (code 3)", sa4c_blamed(c1, 7), 3)
    ce_str_eq("A1 (network attacker): 7's why", sa4c_why(c1, 7), "did not open its share to soul 65536 with its one-time key (not proven)")
    ce_str_eq("A1 (network attacker): no evidence against 7", sa4c_evidence(c1, 7), "")
    ce_eq("A1 (network attacker): the complainer is not blamed", sa4c_blamed(c1, 65536), 0)
    ce_eq("A1 (network attacker): no OPEN at all", at_count_opens(res1[4]), 0)
    ce_eq("A1 (network attacker): the round completes", res1[0], 1)
    // A2: corrupt sender 7 shows honest receiver 65536 a second ADV with
    // another M and opens every complaint.
    let souls2 = sa4h_souls(roster, 5, 61, vc, 0)
    let c2 = sa4c_new(roster, 61, SA4H_L, sa4h_layout(), vc)
    let res2 = sa4e_round_x(roster, souls2, c2, list_new(), list_new(), list_new(), [[7, 2, 1, 1], [6, 0]])
    ce_eq("A2: honest receiver 65536 removed unproven (code 5)", sa4c_blamed(c2, 65536), 5)
    ce_str_eq("A2: why", sa4c_why(c2, 65536), "complaint about soul 7 does not verify (not proven)")
    ce_str_eq("A2: no evidence against 65536", sa4c_evidence(c2, 65536), "")
    ce_eq("A2: the corrupt sender is not blamed", sa4c_blamed(c2, 7), 0)
    ce_eq("A2: the round completes", res2[0], 1)
    // A3: 300 complains falsely about 7 while a MITM alters 7's line to
    // 65536 on 7's uplink: the liar is proven, 7 is removed unproven.
    let souls3 = sa4h_souls(roster, 5, 67, vc, 0)
    let c3 = sa4c_new(roster, 67, SA4H_L, sa4h_layout(), vc)
    let res3 = sa4e_round_x(roster, souls3, c3, list_new(), [[0, 1, 11, 65536]], list_new(), [[3, 1, 1]])
    ce_eq("A3: the false complainer 300 is proven (code 2)", sa4c_blamed(c3, 300), 2)
    ce_check("A3: evidence against 300", len(sa4c_evidence(c3, 300)) > 0)
    ce_eq("A3: honest 7 removed unproven (code 3)", sa4c_blamed(c3, 7), 3)
    ce_str_eq("A3: 7's why", sa4c_why(c3, 7), "did not open its share to soul 65536 with its one-time key (not proven)")
    ce_eq("A3: 65536 (honest complainer) stays", sa4c_blamed(c3, 65536) + sa4e_in(sa4c_set(c3, 2), 65536) * 10, 10)
    ce_eq("A3: OPENs only to the liar", at_opens_ok(roster, res3[4], [2]), 0)
    ce_eq("A3: two removals at N = 5 leave |U2| = 3 < t: cancelled, never a wrong sum", res3[0], 0)
    ce_eq("A3: state cancelled", sa4c_state(c3), SA4C_ST_CANCELLED)
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    test_false_dropout(vc)
    test_forged_complaints(roster, vc)
    test_privacy(roster, vc)
    test_double_adv(roster, vc)
    ce_summary("sa4_attack")
}

main()
