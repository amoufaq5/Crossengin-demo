// CE_TEST_TIMEOUT: 240
// Malicious-coordinator test for SecAgg v4 (A2.2b): the false-dropout
// attack. N = 5, t = 4. Every soul, including E (id 4294967295), sends its
// masked y. The coordinator then:
//   - tells souls 1-4 that E dropped (U3 = {1,2,3,4}). They sign that T3,
//     see t valid signatures, and reveal E's s-share;
//   - tells E that U3 = all five, hoping for b-shares about E.
// To unmask y_E it needs both E's s key (to strip the pairwise masks) and
// b_E (to strip PRG(b_E)). It gets t s-shares about E but no b-share: only
// souls that signed a U3 containing E reveal one, and E refuses because
// the others' signatures are over a different T3. Stripping the pairwise
// masks from y_E leaves x_E + PRG(b_E), which does not equal x_E.

import "../ce_test.nova"
import "../sa4_harness.nova"

let AT_R = 37

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, AT_R, vc, 0)
    let rl = sa4h_round_line(roster, AT_R)
    let advs = list_new()
    let i = 0
    while i < 5 {
        advs = sa4h_cat(advs, sa4h_feed(souls[i], sa4h_one(rl))[1])
        i = i + 1
    }
    let set1 = sa4w_fmt_set(AT_R, 1, sa4w_bitmap([1, 2, 3, 4, 5]))
    let shares = list_new()
    i = 0
    while i < 5 {
        shares = sa4h_cat(shares, sa4h_filter(sa4h_feed(souls[i], sa4h_cat(advs, sa4h_one(set1)))[1], "SA4_SHARE "))
        i = i + 1
    }
    let set2 = sa4w_fmt_set(AT_R, 2, sa4w_bitmap([1, 2, 3, 4, 5]))
    let ys = list_new()
    i = 0
    while i < 5 {
        let me = SA4H_IDS[i]
        let mine = list_new()
        let j = 0
        while j < len(shares) {
            if sa4w_parse(shares[j])[3] == me { push(mine, shares[j]) }
            j = j + 1
        }
        push(mine, set2)
        ys = sa4h_cat(ys, sa4h_filter(sa4h_feed(souls[i], mine)[1], "SA4_Y "))
        i = i + 1
    }
    ce_eq("all five sent y (2 chunks each)", len(ys), 10)
    // Equivocate U3.
    let u3a = sa4w_fmt_set(AT_R, 3, sa4w_bitmap([1, 2, 3, 4]))
    let u3e = sa4w_fmt_set(AT_R, 3, sa4w_bitmap([1, 2, 3, 4, 5]))
    let sigs = list_new()
    i = 0
    while i < 4 {
        sigs = sa4h_cat(sigs, sa4h_feed(souls[i], sa4h_one(u3a))[1])
        i = i + 1
    }
    let esig = sa4h_feed(souls[4], sa4h_one(u3e))[1]
    ce_eq("E signed its T3", len(esig), 1)
    let set4a = sa4w_fmt_set(AT_R, 4, sa4w_bitmap([1, 2, 3, 4]))
    let reveals = list_new()
    i = 0
    while i < 4 {
        let f = sa4h_feed(souls[i], sa4h_cat(sigs, sa4h_one(set4a)))
        ce_eq("soul " + int_to_str(i + 1) + " reveals for U3 = 1-4", f[0], 1)
        reveals = sa4h_cat(reveals, sa4h_filter(f[1], "SA4_REVEAL "))
        i = i + 1
    }
    // E: the others' signatures (over the other T3) plus its own.
    let fe = sa4h_feed(souls[4], sa4h_cat(sa4h_cat(sigs, esig), sa4h_one(sa4w_fmt_set(AT_R, 4, sa4w_bitmap([1, 2, 3, 4, 5])))))
    ce_eq("E refuses", fe[0], 0)
    ce_check("E refuses on a consistency signature (" + fe[2] + ")", find_bytes(fe[2], "does not verify") >= 0)
    ce_eq("E revealed nothing", len(sa4h_filter(fe[1], "SA4_REVEAL ")), 0)
    // What the coordinator now holds about E.
    let eid = 4294967295
    let ss = list_new()
    let bcount = 0
    i = 0
    while i < len(reveals) {
        let p = sa4w_parse(reveals[i])
        if p[3] == eid {
            if p[4] == 0 { bcount = bcount + 1 }
            if p[4] == 1 { push(ss, shamir_share(sroster_x(roster, p[2]), sac_list_to_buf(p[5]), 32)) }
        }
        i = i + 1
    }
    ce_eq("b-shares about E: none", bcount, 0)
    ce_eq("s-shares about E: t = 4", len(ss), 4)
    let s_e = shamir_combine(ss, 32)
    let chk = alloc(33)
    sac_x25519_pub(chk, s_e)
    let espk = sa4w_parse(advs[4])[4]
    ce_eq("the coordinator really has E's s key", sa4h_same(sac_buf_to_list(chk, 32), espk), 1)
    // Strip E's pairwise masks from y_E (every other id is below E's, so
    // y_E carries -PRG(s_Ev) for each v).
    let erecs = list_new()
    i = 0
    while i < len(ys) {
        let y = sa4w_parse(ys[i])
        if y[2] == eid { push(erecs, y) }
        i = i + 1
    }
    let z = sa4w_y_assemble(erecs, SA4H_L)
    i = 0
    while i < 4 {
        let v = SA4H_IDS[i]
        let ms = sac_mask_seed(s_e, sac_list_to_buf(sa4w_parse(advs[i])[4]), AT_R, eid, v)
        z = saprg_mask(z, ms[0], 1)
        i = i + 1
    }
    let xe = sa4h_input(4, SA4H_L)
    let same = 0
    i = 0
    while i < SA4H_L {
        if z[i] == xe[i] { same = same + 1 }
        i = i + 1
    }
    ce_eq("x_E stays hidden behind PRG(b_E): no word matches", same, 0)
    // Control: the same reveals do give the honest aggregate over souls
    // 1-4 (E treated as dropped), so the mask arithmetic above is right.
    let ys4 = list_new()
    i = 0
    while i < len(ys) {
        if sa4w_parse(ys[i])[2] != eid { push(ys4, ys[i]) }
        i = i + 1
    }
    let agg = sa4h_unmask(roster, AT_R, advs, ys4, reveals, [1, 2, 3, 4, 5], [1, 2, 3, 4])
    ce_eq("control: aggregate over souls 1-4 is exact", sa4h_same(agg, sa4h_expected([1, 2, 3, 4])), 1)
    ce_summary("sa4_attack")
}

main()
