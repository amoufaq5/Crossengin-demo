// Unit tests for src/learning/sa4_fed.nova (SecAgg v4 federation glue,
// A2.3c): pinned tag parsing, the layout text and hash (hash from Python
// hashlib), mo_report rows to input words and back, the FED_JOIN parser,
// the soul's checks on a published result (own round, pinned tag, once per
// tag, 1 <= n <= |U3|), and the soul's last-round file (missing file, durable save, exact
// content, mode 0600, refusals: another roster or id, corrupt content,
// group/other permission bits, too long). Sockets are covered by
// tests/integration/scenario_u4_secagg.sh.

import "std/io"
import "std/string"
import "std/syscall"
import "../ce_test.nova"
import "../../src/learning/sa4_fed.nova"

let SF_FP = "373edb004ef3155c2ee7a83a86211ec50f43e230bc42c3486415daca30cbe55c"

fn sf_join(l) {
    let s = ""
    let i = 0
    while i < len(l) {
        if i > 0 { s = s + "," }
        s = s + l[i]
        i = i + 1
    }
    return s
}

fn test_tags() {
    let r = sa4f_tags_parse("user-teach,seed,topic:test,seed")
    ce_eq("tags: ok", r[0], 1)
    ce_str_eq("tags: sorted, de-duplicated", sf_join(r[2]), "seed,topic:test,user-teach")
    ce_eq("tags: unset refused", sa4f_tags_parse(0)[0], 0)
    ce_eq("tags: empty refused", sa4f_tags_parse("")[0], 0)
    ce_eq("tags: empty tag refused", sa4f_tags_parse("a,,b")[0], 0)
    ce_eq("tags: trailing comma refused", sa4f_tags_parse("a,b,")[0], 0)
    ce_eq("tags: space refused", sa4f_tags_parse("a b")[0], 0)
    ce_eq("tags: other punctuation refused", sa4f_tags_parse("a.b")[0], 0)
    let t64 = ""
    let i = 0
    while i < 64 {
        t64 = t64 + "x"
        i = i + 1
    }
    ce_eq("tags: 64 characters accepted", sa4f_tags_parse(t64)[0], 1)
    ce_eq("tags: 65 characters refused", sa4f_tags_parse(t64 + "x")[0], 0)
    let many = ""
    i = 0
    while i < 257 {
        if i > 0 { many = many + "," }
        many = many + "t" + int_to_str(1000 + i)
        i = i + 1
    }
    ce_eq("tags: 257 refused", sa4f_tags_parse(many)[0], 0)
    let r256 = sa4f_tags_parse(substr(many, 0, len(many) - 6))
    ce_eq("tags: 256 accepted", r256[0], 1)
    ce_eq("tags: 256 kept", len(r256[2]), 256)
    let r256d = sa4f_tags_parse(substr(many, 0, len(many) - 6) + ",t1000,t1001")
    ce_eq("tags: duplicates do not count against the cap (258 entries, 256 tags)", r256d[0], 1)
    ce_eq("tags: duplicates dropped", len(r256d[2]), 256)
    return 0
}

fn test_layout() {
    let tags = sa4f_tags_parse("user-teach,seed,topic:test")[2]
    ce_str_eq("layout text", sa4f_layout_text(tags),
        "crossengin-fed-layout v1\nseed promo atr present\ntopic:test promo atr present\nuser-teach promo atr present\n")
    ce_str_eq("layout hash (Python hashlib)", sa4w_hex(sa4f_layout(tags)),
        "242fddfa611a14e32609a562996bc553b333cf5d35289dd3ee041c4bf915bfc4")
    ce_eq("L = 3 per tag", sa4f_lw(tags), 9)
    ce_check("another tag set gives another hash",
        str_eq_bytes(sa4w_hex(sa4f_layout(sa4f_tags_parse("seed,user-teach")[2])), sa4w_hex(sa4f_layout(tags))) == 0)
    return 0
}

fn test_words() {
    let tags = sa4f_tags_parse("seed,topic:test,user-teach")[2]
    let rep = [["seed", 250, 7, 4, 0], ["other", 1, 1, 1, 0], ["user-teach", 900, 100, 0, 0]]
    let w = sa4f_words(tags, rep)
    ce_eq("words: ok", w[0], 1)
    ce_str_eq("words: present tag, absent tag, tag without samples",
        sa4w_hex(w[2]), sa4w_hex([250, 7, 1, 0, 0, 0, 0, 0, 0]))
    ce_eq("words: 9 words", len(w[2]), 9)
    ce_eq("words: one row outside the layout", w[3], 1)
    ce_eq("words: negative refused", sa4f_words(tags, [["seed", 0 - 1, 0, 1, 0]])[0], 0)
    ce_eq("words: above 2^32-1 refused", sa4f_words(tags, [["seed", 4294967296, 0, 1, 0]])[0], 0)
    ce_eq("words: 2^32-1 accepted", sa4f_words(tags, [["seed", 4294967295, 0, 1, 0]])[0], 1)
    let sums = sa4f_sums(tags, [10, 20, 2, 0, 0, 0, 5, 6, 1])
    ce_eq("sums: one row per tag", len(sums), 3)
    ce_str_eq("sums: tag", sums[2][0], "user-teach")
    ce_eq("sums: promo", sums[0][1], 10)
    ce_eq("sums: atr", sums[0][2], 20)
    ce_eq("sums: present", sums[0][3], 2)
    ce_eq("sums: present of the last tag", sums[2][3], 1)
    ce_eq("sums: wrong length gives nothing", len(sa4f_sums(tags, [1, 2, 3])), 0)
    return 0
}

fn test_join() {
    ce_eq("join: id", sa4f_parse_join("FED_JOIN 7 1000"), 7)
    ce_eq("join: max id", sa4f_parse_join("FED_JOIN 4294967295 1000"), 4294967295)
    ce_eq("join: 2^32 refused", sa4f_parse_join("FED_JOIN 4294967296 1000"), 0 - 1)
    ce_eq("join: leading zero refused", sa4f_parse_join("FED_JOIN 07 1000"), 0 - 1)
    ce_eq("join: name refused", sa4f_parse_join("FED_JOIN alice 1000"), 0 - 1)
    ce_eq("join: double space refused", sa4f_parse_join("FED_JOIN  7 1000"), 0 - 1)
    ce_eq("join: other weight refused", sa4f_parse_join("FED_JOIN 7 999"), 0 - 1)
    ce_eq("join: other verb refused", sa4f_parse_join("FED_LEAVE 7 1000"), 0 - 1)
    ce_eq("join: short refused", sa4f_parse_join("FED_JOIN"), 0 - 1)
    return 0
}

// Protocol v4-sa2 (A2.4b): the handshake strings name the new version, so
// a v4-sa (v1) peer is refused at the hello, never mid-round.
fn test_hello() {
    ce_str_eq("hello names v4-sa2", SA4F_HELLO, "SECAGG_HELLO ce-fed v4-sa2")
    ce_str_eq("reply names v4-sa2", SA4F_OK, "OK ce-fed v4-sa2 protocol accepted")
    ce_eq("v1 hello differs", str_eq_bytes(SA4F_HELLO, "SECAGG_HELLO ce-fed v4-sa"), 0)
    ce_eq("v1 reply differs", str_eq_bytes(SA4F_OK, "OK ce-fed v4-sa protocol accepted"), 0)
    return 0
}

fn test_results() {
    let tags = sa4f_tags_parse("seed,user-teach")[2]
    let ok = [0, 7, "seed", 100, 20, 3]
    ce_str_eq("result: accepted", sa4f_result_why(ok, 7, tags, 3, list_new()), "")
    ce_str_eq("result: n = |U3| accepted", sa4f_result_why([0, 7, "seed", 1, 1, 3], 7, tags, 3, list_new()), "")
    ce_str_eq("result: not a result line", sa4f_result_why(0, 7, tags, 3, list_new()), "not a FED_AGGREGATE_SUM line")
    ce_str_eq("result: another round", sa4f_result_why([0, 6, "seed", 1, 1, 3], 7, tags, 3, list_new()), "for another round")
    ce_str_eq("result: tag not pinned", sa4f_result_why([0, 7, "other", 1, 1, 3], 7, tags, 3, list_new()), "tag not in CE_SECAGG_V4_TAGS")
    ce_str_eq("result: second result for a tag", sa4f_result_why(ok, 7, tags, 3, ["seed"]), "second result for this tag")
    ce_str_eq("result: other tag after one applied", sa4f_result_why([0, 7, "user-teach", 1, 1, 2], 7, tags, 3, ["seed"]), "")
    ce_str_eq("result: n = 0", sa4f_result_why([0, 7, "seed", 1, 1, 0], 7, tags, 3, list_new()), "n_part below 1")
    ce_str_eq("result: n > |U3|", sa4f_result_why([0, 7, "seed", 1, 1, 4], 7, tags, 3, list_new()), "n_part above |U3|")
    ce_str_eq("result: before SET 3 (|U3| unknown = 0)", sa4f_result_why(ok, 7, tags, 0, list_new()), "n_part above |U3|")
    return 0
}

fn test_parse_result() {
    let a = sa4f_parse_result("FED_AGGREGATE_SUM 7 seed 100 20 3")
    ce_eq("parse: ok", a != 0, 1)
    ce_eq("parse: round", a[1], 7)
    ce_str_eq("parse: tag", a[2], "seed")
    ce_eq("parse: promo", a[3], 100)
    ce_eq("parse: atr", a[4], 20)
    ce_eq("parse: n", a[5], 3)
    ce_eq("parse: u32 max", sa4f_parse_result("FED_AGGREGATE_SUM 7 seed 4294967295 0 3")[3], 4294967295)
    let bad = ["FED_AGGREGATE_SUM 7 seed -5000 -7 2",
               "FED_AGGREGATE_SUM 7 seed 4294967296 0 3",
               "FED_AGGREGATE_SUM 7 seed 1000000000000000000000000 0 3",
               "FED_AGGREGATE_SUM 7 seed 01 0 3",
               "FED_AGGREGATE_SUM 7 seed 1 0 3 ",
               "FED_AGGREGATE_SUM 7  seed 1 0 3",
               "FED_AGGREGATE_SUM 7 seed 1 0",
               "FED_AGGREGATE_SUM 7 se.ed 1 0 3",
               "FED_AGGREGATE_SUM x seed 1 0 3",
               "FED_AGGREGATE_SUM 4611686018427387904 seed 1 0 3",
               "FED_AGGREGATE_SUMX 7 seed 1 0 3",
               "FED_AGGREGATE_SUM 7 seed 1a 0 3",
               ""]
    let i = 0
    while i < len(bad) {
        ce_eq("parse: refused " + int_to_str(i), sa4f_parse_result(bad[i]) == 0, 1)
        i = i + 1
    }
    ce_eq("parse: no line", sa4f_parse_result(0) == 0, 1)
    return 0
}

fn sf_write(path, text, mode) {
    sys_unlink(path)
    let fd = sys_open(path, O_WRONLY + O_CREAT + 131200, 384)
    if _ce_open_failed(fd) == 1 { return 0 }
    _sys_write_tagged(fd, text, len(text))
    ce_fchmod(fd, mode)
    sys_close(fd)
    return 1
}

fn sf_read(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if _ce_open_failed(fd) == 1 { return "" }
    let buf = alloc(300)
    let n = _sys_read_tagged(fd, buf, 290)
    sys_close(fd)
    let s = ""
    let i = 0
    while i < n {
        s = s + chr(load8(buf + i))
        i = i + 1
    }
    return s
}

fn sf_mode(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if _ce_open_failed(fd) == 1 { return 0 - 1 }
    let mu = _ce_fd_mode_uid(fd)
    sys_close(fd)
    return int_and(mu[0], 511)
}

// rmdir(2) for the test directory (the path is untagged if tagged, like
// sys_unlink). The result is not used.
fn sf_rmdir(path) {
    asm {
        "mov rax, 84"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .sf_rd_u"
        "sar rdi, 1"
        ".sf_rd_u:"
        "syscall"
    }
}

fn test_last_round() {
    let dir = "/tmp/ce_test_sa4f_" + int_to_str(getpid())
    sys_mkdir(dir, 448)
    let p = dir + "/lr"
    sys_unlink(p)
    let l0 = sa4f_last_round_load_at(p, SF_FP, 7)
    ce_eq("last round: missing file loads", l0[0], 1)
    ce_eq("last round: missing file is round 0", l0[2], 0)
    ce_eq("last round: save", sa4f_last_round_save_at(p, dir, SF_FP, 7, 5)[0], 1)
    ce_str_eq("last round: exact content", sf_read(p), "crossengin-sa4-last-round v1 " + SF_FP + " 7 5\n")
    ce_eq("last round: mode 0600", sf_mode(p), 384)
    let l1 = sa4f_last_round_load_at(p, SF_FP, 7)
    ce_eq("last round: load ok", l1[0], 1)
    ce_eq("last round: load 5", l1[2], 5)
    // 2^62 - 1, built arithmetically (NOVA literals near 2^62 are not exact).
    let rmax = int_shl(1, 61) - 1 + int_shl(1, 61)
    ce_eq("last round: save again", sa4f_last_round_save_at(p, dir, SF_FP, 7, rmax)[0], 1)
    ce_eq("last round: max round id", sa4f_last_round_load_at(p, SF_FP, 7)[2], rmax)
    ce_str_eq("last round: max round id text", int_to_str(rmax), "4611686018427387903")
    let fp2 = "473edb004ef3155c2ee7a83a86211ec50f43e230bc42c3486415daca30cbe55c"
    let lf = sa4f_last_round_load_at(p, fp2, 7)
    ce_eq("last round: another roster refused", lf[0], 0)
    ce_check("last round: another roster reason", find_bytes(lf[1], "another roster") >= 0)
    ce_eq("last round: another id refused", sa4f_last_round_load_at(p, SF_FP, 8)[0], 0)
    sf_write(p, "crossengin-sa4-last-round v1 " + SF_FP + " 7 5\n", 420)
    let lm = sa4f_last_round_load_at(p, SF_FP, 7)
    ce_eq("last round: mode 0644 refused", lm[0], 0)
    ce_check("last round: mode reason", find_bytes(lm[1], "group/others") >= 0)
    let bad = ["crossengin-sa4-last-round v1 " + SF_FP + " 7 05\n",
               "crossengin-sa4-last-round v1 " + SF_FP + " 7 5",
               "crossengin-sa4-last-round v1 " + SF_FP + " 7  5\n",
               "crossengin-sa4-last-round v2 " + SF_FP + " 7 5\n",
               "crossengin-sa4-last-round v1 " + SF_FP + " 7 4611686018427387904\n",
               "crossengin-sa4-last-round v1 " + SF_FP + " 7 -1\n",
               "crossengin-sa4-last-round v1 " + SF_FP + " 7\n",
               "\n",
               "crossengin-sa4-last-round v1 " + SF_FP + " 7 5\r\n"]
    let i = 0
    while i < len(bad) {
        sf_write(p, bad[i], 384)
        ce_eq("last round: corrupt file " + int_to_str(i) + " refused", sa4f_last_round_load_at(p, SF_FP, 7)[0], 0)
        i = i + 1
    }
    let long = ""
    i = 0
    while i < 130 {
        long = long + "x"
        i = i + 1
    }
    sf_write(p, long + "\n", 384)
    ce_eq("last round: too long refused", sa4f_last_round_load_at(p, SF_FP, 7)[0], 0)
    ce_eq("last round: save replaces a corrupt file", sa4f_last_round_save_at(p, dir, SF_FP, 7, 9)[0], 1)
    ce_eq("last round: then loads", sa4f_last_round_load_at(p, SF_FP, 7)[2], 9)
    ce_eq("last round: lock is taken once per process", sa4f_last_round_lock(p)[0], 1)
    sys_unlink(p)
    sys_unlink(p + ".lock")
    sf_rmdir(dir)
    return 0
}

fn main() {
    test_tags()
    test_layout()
    test_words()
    test_join()
    test_hello()
    test_results()
    test_parse_result()
    test_last_round()
    ce_summary("sa4_fed")
}

main()
