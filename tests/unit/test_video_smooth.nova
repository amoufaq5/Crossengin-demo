// Unit tests for src/io/transducers/video_smooth.nova (R24F).
//
// R24F builds on R23D image_tracker: scene-level temporal smoothing
// over a sequence of per-frame detections. The dense field is the
// recorded per-frame snapshot of every active track's state, with
// was_real = 1 for matched detections and 0 for Kalman-predicted
// frames.
//
// Coverage targets (~20 assertions):
//   * init shape (3)
//   * 5 consecutive frames moving -> 5-frame dense field x 1 track (5)
//   * 5 frames with frame 2 missing -> frame 2 filled by Kalman (4)
//   * continuity 5/5 = 1000 milli (1)
//   * continuity 4/5 = 800 milli (1)
//   * Two simultaneous tracks tracked independently (5)
//   * Empty step -> empty frame record (1)
//   * Accessors (4)
// Total: 24 assertions (above the ~20 floor).

import "../ce_test.nova"
import "../../src/io/transducers/video_smooth.nova"

fn _mk_dets(x, y, w, h) {
    let dets = list_new()
    push(dets, detection_from_xywh(x, y, w, h))
    return dets
}

fn _mk_two_dets(x1, y1, x2, y2, w, h) {
    let dets = list_new()
    push(dets, detection_from_xywh(x1, y1, w, h))
    push(dets, detection_from_xywh(x2, y2, w, h))
    return dets
}

fn _empty_dets() { return list_new() }

fn test_init_shape() {
    let st = vsmooth_init()
    ce_eq("vsmooth_init: num_frames_seen = 0",
          vsmooth_num_frames_seen(st), 0)
    ce_eq("vsmooth_init: last_frame = 0",
          vsmooth_last_frame(st), 0)
    ce_eq("vsmooth_init: step_count = 0",
          vsmooth_step_count(st), 0)
}

fn test_five_frames_moving_dense_field() {
    let st = vsmooth_init()
    let x = 10
    let y = 10
    let f = 1
    while f <= 5 {
        let dets = _mk_dets(x, y, 16, 16)
        vsmooth_step(st, dets, f)
        x = x + 5
        y = y + 5
        f = f + 1
    }
    ce_eq("after 5 steps, num_frames_seen = 5",
          vsmooth_num_frames_seen(st), 5)

    let field = vsmooth_dense_field(st, 5)
    ce_eq("dense_field has 5 frame slots", len(field), 5)

    // Frame 1 (idx 0) should have 1 track snapshot
    let rec1 = field[0]
    ce_eq("frame 1 has 1 track", len(rec1), 1)

    // Last frame should also have 1 track
    let rec5 = field[4]
    ce_eq("frame 5 has 1 track", len(rec5), 1)

    // The track at frame 5 should be real (matched a detection)
    let t5 = rec5[0]
    ce_eq("frame 5 track was a real detection",
          tat_was_real(t5), 1)
}

fn test_missing_middle_frame_filled() {
    let st = vsmooth_init()
    // 5 frames with detections at (10,10), (15,15), (-MISSING-), (25,25), (30,30)
    // frame 3 has no detection -> should be Kalman-predicted
    vsmooth_step(st, _mk_dets(10, 10, 16, 16), 1)
    vsmooth_step(st, _mk_dets(15, 15, 16, 16), 2)
    vsmooth_step(st, _empty_dets(),            3)
    vsmooth_step(st, _mk_dets(25, 25, 16, 16), 4)
    vsmooth_step(st, _mk_dets(30, 30, 16, 16), 5)

    let field = vsmooth_dense_field(st, 5)
    ce_eq("dense field has 5 frame slots", len(field), 5)

    // Frame 3 (idx 2): track exists (lifecycle says probational survives
    // until 5 consecutive misses). It should be marked predicted.
    let rec3 = field[2]
    ce_eq("frame 3 has 1 track (predicted)", len(rec3), 1)
    let t3 = rec3[0]
    ce_eq("frame 3 track was Kalman-predicted (not real)",
          tat_was_real(t3), 0)

    // Frame 3 predicted position must be SOMEWHERE between frame 2
    // (15) and frame 4 (25). Predict uses velocity from frame 1-2
    // (~5px / frame in milli) so it should be in the vicinity of
    // ~17-22 in pixel space. The exact value depends on Kalman gain
    // history but the predicted x_px must be > frame 2 x_px.
    let x3_px = tat_x_px(t3)
    let x3_ok = 0
    if x3_px >= 15 { if x3_px <= 25 { x3_ok = 1 } }
    ce_check("frame 3 predicted x_px in (15, 25] -- Kalman moved forward",
             x3_ok == 1)
}

fn test_continuity_perfect_score() {
    let st = vsmooth_init()
    let f = 1
    while f <= 5 {
        vsmooth_step(st, _mk_dets(50, 50, 16, 16), f)
        f = f + 1
    }
    let tracker = vsmooth_tracker(st)
    let active = tracker_active_tracks(tracker)
    let tid = track_id(active[0])
    let cont = vsmooth_track_continuity(st, tid)
    ce_eq("5/5 real detections -> continuity_milli = 1000",
          cont, 1000)
}

fn test_continuity_partial_score() {
    let st = vsmooth_init()
    // 5 frames, only 4 with real detections (frame 3 missing).
    vsmooth_step(st, _mk_dets(50, 50, 16, 16), 1)
    vsmooth_step(st, _mk_dets(52, 52, 16, 16), 2)
    vsmooth_step(st, _empty_dets(),            3)
    vsmooth_step(st, _mk_dets(56, 56, 16, 16), 4)
    vsmooth_step(st, _mk_dets(58, 58, 16, 16), 5)
    let tracker = vsmooth_tracker(st)
    // Track #1 is the only track.
    let cont = vsmooth_track_continuity(st, 1)
    // 4 real out of 5 present = 800 milli.
    ce_eq("4/5 real detections -> continuity_milli = 800",
          cont, 800)
}

fn test_two_simultaneous_tracks() {
    let st = vsmooth_init()
    let x = 10
    let f = 1
    while f <= 5 {
        let dets = _mk_two_dets(x, 10, x, 80, 16, 16)
        vsmooth_step(st, dets, f)
        x = x + 2
        f = f + 1
    }
    let field = vsmooth_dense_field(st, 5)
    ce_eq("two-track dense_field has 5 frames", len(field), 5)

    let rec_final = field[4]
    ce_eq("final frame has 2 tracks", len(rec_final), 2)

    // Both tracks should have continuity = 1000 (real detection
    // every frame).
    let cont1 = vsmooth_track_continuity(st, 1)
    let cont2 = vsmooth_track_continuity(st, 2)
    ce_eq("track #1 continuity = 1000", cont1, 1000)
    ce_eq("track #2 continuity = 1000", cont2, 1000)

    // The two tracks should be at distinct y positions.
    let snap1 = rec_final[0]
    let snap2 = rec_final[1]
    let y1 = tat_y_px(snap1)
    let y2 = tat_y_px(snap2)
    let diff = y1 - y2
    if diff < 0 { diff = 0 - diff }
    ce_check("two tracks separated by ~70 px in y",
             diff >= 60)
}

fn test_empty_step_empty_frame_record() {
    let st = vsmooth_init()
    vsmooth_step(st, _empty_dets(), 1)
    let rec = vsmooth_frame_record(st, 1)
    let rec_ok = 0
    if rec != 0 { rec_ok = 1 }
    ce_check("empty step still produces a frame record", rec_ok == 1)
    if rec != 0 {
        ce_eq("empty step's frame record is empty", len(rec), 0)
    }
}

fn test_accessors() {
    let st = vsmooth_init()
    vsmooth_step(st, _mk_dets(7, 11, 32, 32), 1)
    let rec = vsmooth_frame_record(st, 1)
    let t = rec[0]
    ce_eq("tat_track_id", tat_track_id(t), 1)
    ce_eq("tat_x_milli (7 * 1000)", tat_x_milli(t), 7000)
    ce_eq("tat_y_milli (11 * 1000)", tat_y_milli(t), 11000)
    ce_eq("tat_was_real on new probational w/ detection",
          tat_was_real(t), 1)
}

fn main() {
    test_init_shape()
    test_five_frames_moving_dense_field()
    test_missing_middle_frame_filled()
    test_continuity_perfect_score()
    test_continuity_partial_score()
    test_two_simultaneous_tracks()
    test_empty_step_empty_frame_record()
    test_accessors()
    ce_summary("video_smooth")
}

main()
