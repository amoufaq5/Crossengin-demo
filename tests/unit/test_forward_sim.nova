// Unit tests for src/parts/imagination/forward_sim.nova
// Verifies stepwise pattern application, multi-step rollout reaching distant
// states, early stop on no change, and the confidence floor. ADR-0032.

import "../ce_test.nova"
import "../../src/parts/imagination/forward_sim.nova"

fn one(a) { let l = list_new(); push(l, a); return l }

// Chain: 1->2->3->4.
fn build() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    pattern_new(ikg, "p1", one(1), one(2), 0)
    pattern_new(ikg, "p2", one(2), one(3), 0)
    pattern_new(ikg, "p3", one(3), one(4), 0)
    return ikg
}

fn test_rollout() {
    let ikg = build()
    let s = forward_simulate(ikg, one(1), 3, 0)
    ce_eq("reaches 2", img_state_has(s, 2), 1)
    ce_eq("reaches 3", img_state_has(s, 3), 1)
    ce_eq("reaches 4", img_state_has(s, 4), 1)
    // One step only reaches the first successor.
    let s1 = forward_simulate(ikg, one(1), 1, 0)
    ce_eq("one step reaches 2", img_state_has(s1, 2), 1)
    ce_eq("one step not 4", img_state_has(s1, 4), 0)
}

fn test_no_match_and_floor() {
    let ikg = build()
    // No pattern matches 9 -> state unchanged.
    let s = forward_simulate(ikg, one(9), 3, 0)
    ce_eq("unchanged size", img_state_size(s), 1)
    // High confidence floor blocks the (uniform-0.5) seed patterns.
    let s2 = forward_simulate(ikg, one(1), 3, 800)
    ce_eq("floor blocks application", img_state_has(s2, 2), 0)
}

fn main() {
    test_rollout()
    test_no_match_and_floor()
    ce_summary("forward_sim")
}

main()
