// Unit tests for the admin.bake_child wire verb (R99).
//
// Coverage: verb registered; verb count 38; cap gate (admin has
// admin:bake, reader doesn't); missing args refused; malformed
// manifest refused; missing signer keys refused; refuses without
// bake dir; response shape has expected fields (via error branch).
//
// Note: the happy path (signer keys loaded from env) is exercised
// by test_bake.nova because tests here cannot mutate the process
// environment. Fortunately R99's contract states the verb MUST
// refuse cleanly when signer keys are absent -- so the wire-verb
// tests focus on that gate + all the arg / dispatch bookkeeping.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/factory/bake_manifest.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_bare_ctx() {
    // Minimal ctx with no registries -- suffices for cap-gate + refusal
    // testing (the verb's early guards fire before touching registries).
    return rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
}

fn test_verb_count_38() {
    // R111: verb count now 51 (R109 = 49; +2 for self.override/list).
    ce_eq("verb count 51", len(rpc_verb_names()), 51)
}

fn test_admin_bake_child_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.bake_child") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.bake_child present", saw, 1)
}

fn test_verb_requires_admin_bake_cap() {
    let need = capability_verb_required("admin.bake_child")
    ce_str_eq("bake_child requires admin:bake", need, CAP_ADMIN_BAKE)
}

fn test_admin_role_carries_bake_cap() {
    let caps = capability_role_expand("admin")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_BAKE) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin role has admin:bake", saw, 1)
}

fn test_reader_lacks_bake_cap() {
    let caps = capability_role_expand("reader")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_BAKE) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("reader lacks admin:bake", saw, 0)
}

fn test_curator_lacks_bake_cap() {
    let caps = capability_role_expand("curator")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_BAKE) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("curator lacks admin:bake", saw, 0)
}

fn test_admin_bake_cap_is_known() {
    ce_eq("admin:bake is known cap", capability_is_known_cap(CAP_ADMIN_BAKE), 1)
}

fn test_missing_manifest_args_refused() {
    let ctx = _mk_bare_ctx()
    let out = rpc_dispatch("admin.bake_child", list_new(), ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions manifest",
             _has(out, "manifest_text") == 1 ||
             _has(out, "manifest_path") == 1)
}

fn test_malformed_manifest_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("manifest_text", "not a valid manifest\n"))
    let out = rpc_dispatch("admin.bake_child", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions parse", _has(out, "parse"))
}

fn test_manifest_missing_name_refused() {
    let ctx = _mk_bare_ctx()
    let mt = "BAKE-MANIFEST v1\nVERSION 1\nDOMAIN d\n"
    let args = list_new()
    push(args, rpc_arg_kv("manifest_text", mt))
    let out = rpc_dispatch("admin.bake_child", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions invalid",
             _has(out, "invalid") == 1 || _has(out, "NAME") == 1)
}

fn test_missing_signer_keys_refused() {
    // With no CROSSENGIN_MOTHER_SIGNER_* env vars set (the test env),
    // a valid manifest still fails at the signer-load step with a
    // clear error.
    let ctx = _mk_bare_ctx()
    let mt = "BAKE-MANIFEST v1\nNAME t\nVERSION 1\nDOMAIN d\n"
    let args = list_new()
    push(args, rpc_arg_kv("manifest_text", mt))
    let out = rpc_dispatch("admin.bake_child", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions signer",
             _has(out, "signer") == 1 || _has(out, "SIGNER") == 1)
}

fn test_manifest_path_unreadable_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("manifest_path", "/nonexistent/absolute/path/nope.txt"))
    let out = rpc_dispatch("admin.bake_child", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions unreadable",
             _has(out, "unreadable") == 1 || _has(out, "empty") == 1)
}

fn test_bake_dir_setter_reads_back() {
    let ctx = _mk_bare_ctx()
    rpc_ctx_set_bake_dir(ctx, "/tmp/crossengin/bake")
    ce_str_eq("bake dir round-trip",
              rpc_ctx_bake_dir(ctx), "/tmp/crossengin/bake")
}

fn test_bake_dir_default_empty() {
    let ctx = _mk_bare_ctx()
    ce_str_eq("default empty", rpc_ctx_bake_dir(ctx), "")
}

fn test_dispatch_unknown_ignores_bake_verb_string_variants() {
    // Sanity: a similar-but-not-matching verb name should still be
    // rejected by the dispatcher.
    let ctx = _mk_bare_ctx()
    let out = rpc_dispatch("admin.bake", list_new(), ctx)
    ce_check("unknown verb refused", _has(out, "unknown verb"))
}

fn main() {
    test_verb_count_38()
    test_admin_bake_child_registered()
    test_verb_requires_admin_bake_cap()
    test_admin_role_carries_bake_cap()
    test_reader_lacks_bake_cap()
    test_curator_lacks_bake_cap()
    test_admin_bake_cap_is_known()
    test_missing_manifest_args_refused()
    test_malformed_manifest_refused()
    test_manifest_missing_name_refused()
    test_missing_signer_keys_refused()
    test_manifest_path_unreadable_refused()
    test_bake_dir_setter_reads_back()
    test_bake_dir_default_empty()
    test_dispatch_unknown_ignores_bake_verb_string_variants()
    ce_summary("admin_bake_child_verb")
}

main()
