// Unit tests for src/parts/soul/state.nova
// Verifies fast state updates (mood/attention/energy) and that fast churn never
// touches the slow identity fields (the ADR-0034 timescale guarantee).

import "../ce_test.nova"
import "../../src/parts/soul/state.nova"

fn test_state() {
    let s = soul_new("A")
    // Neutral defaults.
    ce_eq("default valence", soul_mood_valence(s), 500)
    ce_eq("default energy", soul_energy(s), 1000)
    soul_update_state(s, 800, 600, 700, 400)
    ce_eq("valence", soul_mood_valence(s), 800)
    ce_eq("arousal", soul_mood_arousal(s), 600)
    ce_eq("attention", soul_attention(s), 700)
    ce_eq("energy", soul_energy(s), 400)
    soul_update_mood(s, 200, 900)
    ce_eq("mood valence", soul_mood_valence(s), 200)
    ce_eq("mood arousal", soul_mood_arousal(s), 900)
    ce_eq("attention preserved", soul_attention(s), 700)
}

fn test_state_does_not_touch_identity() {
    let s = soul_new("A")
    soul_set_identity(s, "purpose", "nature")
    let i = 0
    while i < 50 { soul_update_state(s, i * 10, i, 500, 500); i = i + 1 }
    // Identity untouched by fast state churn.
    ce_str_eq("purpose intact", soul_purpose(s), "purpose")
    ce_eq("no identity revisions", soul_revision_count(s), 0)
}

fn main() {
    test_state()
    test_state_does_not_touch_identity()
    ce_summary("soul_state")
}

main()
