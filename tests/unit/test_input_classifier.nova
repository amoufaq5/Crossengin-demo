// Unit tests for src/perception/input_classifier.nova (ADR-0055).
//
// Coverage: every category's canonical input plus the priority tie-breaks
// (arithmetic beats academic on "what is 2 + 2"; financial beats arithmetic
// when money words are present; debatable beats academic on "better than";
// procedural beats academic on "how do i"). Pure module -> exhaustive + fast.

import "../ce_test.nova"
import "../../src/perception/input_classifier.nova"

fn _cat(text) { return ci_category(classify_input(text)) }

fn test_each_category() {
    ce_eq("greeting hello",        _cat("hello"),                         CAT_GREETING)
    ce_eq("greeting hi there",     _cat("hi there"),                      CAT_GREETING)
    ce_eq("greeting thanks",       _cat("thanks"),                        CAT_GREETING)
    ce_eq("greeting good morning", _cat("good morning"),                  CAT_GREETING)

    ce_eq("academic what is",      _cat("what is photosynthesis"),        CAT_ACADEMIC)
    ce_eq("academic why",          _cat("why is the sky blue"),           CAT_ACADEMIC)
    ce_eq("academic explain",      _cat("explain gravity"),               CAT_ACADEMIC)

    ce_eq("personal i feel",       _cat("i feel sad today"),              CAT_PERSONAL)
    ce_eq("personal i am tired",   _cat("i am so tired"),                 CAT_PERSONAL)

    ce_eq("social how are you",    _cat("how are you"),                   CAT_SOCIAL)
    ce_eq("social tell me",        _cat("tell me about yourself"),        CAT_SOCIAL)

    ce_eq("debatable better than", _cat("is democracy better than monarchy"), CAT_DEBATABLE)
    ce_eq("debatable should we",   _cat("should we ban cars"),            CAT_DEBATABLE)
    ce_eq("debatable opinion",     _cat("what do you think about taxes is it fair"), CAT_DEBATABLE)

    ce_eq("financial price",       _cat("what is the price of gold"),     CAT_FINANCIAL)
    ce_eq("financial dollar",      _cat("i have $100 in savings"),        CAT_FINANCIAL)
    ce_eq("financial invest",      _cat("should i invest in stocks for profit"), CAT_FINANCIAL)

    ce_eq("arithmetic plus",       _cat("2 + 2"),                         CAT_ARITHMETIC)
    ce_eq("arithmetic what is",    _cat("what is 12 * 5"),                CAT_ARITHMETIC)
    ce_eq("arithmetic percent",    _cat("15% of 200"),                    CAT_ARITHMETIC)

    ce_eq("procedural how do i",   _cat("how do i bake bread"),           CAT_PROCEDURAL)
    ce_eq("procedural how to",     _cat("how to tie a knot"),             CAT_PROCEDURAL)

    ce_eq("factual assertion",     _cat("the sky is blue"),               CAT_FACTUAL)
    ce_eq("factual water boils",   _cat("water is a liquid"),             CAT_FACTUAL)

    ce_eq("unknown gibberish",     _cat("zxqv wbbl"),                     CAT_UNKNOWN)
    ce_eq("unknown empty",         _cat(""),                              CAT_UNKNOWN)
}

fn test_priority_tiebreaks() {
    // money context pulls "100 dollars + tax" to financial, not arithmetic.
    ce_eq("financial over arithmetic", _cat("how much is 100 dollars plus tax"), CAT_FINANCIAL)
    // "how do i invest" -> procedural wins on score over financial.
    ce_eq("procedural over financial", _cat("how do i invest"),           CAT_PROCEDURAL)
    // "is X better than Y" with a question mark -> debatable, not academic.
    ce_eq("debatable over academic",   _cat("which is better cats or dogs"), CAT_DEBATABLE)
}

fn test_confidence_nonzero() {
    ce_check("known input has confidence", ci_confidence(classify_input("hello")) > 0)
    ce_check("unknown input zero conf",    ci_confidence(classify_input("")) == 0)
}

fn test_cat_names() {
    ce_str_eq("name academic",   cat_name(CAT_ACADEMIC),   "academic")
    ce_str_eq("name financial",  cat_name(CAT_FINANCIAL),  "financial")
    ce_str_eq("name arithmetic", cat_name(CAT_ARITHMETIC), "arithmetic")
    ce_str_eq("name unknown",    cat_name(CAT_UNKNOWN),    "unknown")
}

fn main() {
    test_each_category()
    test_priority_tiebreaks()
    test_confidence_nonzero()
    test_cat_names()
    ce_summary("input_classifier")
}

main()
