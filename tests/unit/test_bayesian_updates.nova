// Unit tests for src/learning/bayesian_updates.nova
// Verifies tiered evidence weights, support/contradiction updates, decay toward
// the prior, conflict tracking, the CONTESTED flag (needs enough evidence), and
// that wrapping an atom's belief updates the atom. ADR-0023.

import "../ce_test.nova"
import "../../src/learning/bayesian_updates.nova"

fn test_weights_and_updates() {
    ce_eq("tier A weight", bayes_weight(SRC_A), 1000)
    ce_eq("tier B weight", bayes_weight(SRC_B), 600)
    ce_eq("tier C weight", bayes_weight(SRC_C), 300)
    ce_eq("user teaching weight", bayes_weight(SRC_USER), 1500)

    let tb = tb_new(1000, 1000, 0)
    ce_eq("uniform confidence", tb_confidence(tb), 500)
    ce_eq("uniform strength", tb_strength(tb), 2000)
    ce_eq("no conflict", tb_conflict(tb), 0)
    ce_eq("not contested", tb_is_contested(tb), 0)
    // One unit of supporting tier-A evidence -> alpha 2.0 -> mean 0.666.
    tb_observe_tier(tb, SRC_A, 1, 1)
    ce_eq("confidence after support", tb_confidence(tb), 666)
    ce_eq("still no conflict", tb_conflict(tb), 0)
}

fn test_decay_toward_prior() {
    let tb = tb_new(5000, 1000, 0)   // alpha 5, beta 1 -> mean 0.833
    ce_eq("starts confident", tb_confidence(tb), 833)
    // x = 1 + (x-1)*0.5 : alpha 1+(5-1)*0.5=3, beta 1 -> mean 0.75
    tb_decay(tb, 500)
    ce_eq("decays toward prior", tb_confidence(tb), 750)
    // Repeated decay drifts toward 0.5.
    tb_decay(tb, 500); tb_decay(tb, 500); tb_decay(tb, 500)
    ce_check("approaches uncertainty", tb_confidence(tb) < 600)
}

fn test_conflict_and_contested() {
    let tb = tb_new(1000, 1000, 0)
    // A little support then a little contradiction: conflict rises but evidence
    // is too thin to be CONTESTED.
    tb_observe_tier(tb, SRC_A, 1, 1)
    tb_observe_tier(tb, SRC_A, 0, 2)
    ce_check("conflict registered", tb_conflict(tb) > 0)
    ce_eq("thin evidence not contested", tb_is_contested(tb), 0)

    // Accumulate strong, genuinely conflicting evidence.
    let i = 0
    while i < 6 { tb_observe_tier(tb, SRC_A, 1, 10 + i); i = i + 1 }
    let j = 0
    while j < 6 { tb_observe_tier(tb, SRC_A, 0, 20 + j); j = j + 1 }
    ce_check("strength now high", tb_strength(tb) > CONTESTED_STRENGTH)
    ce_check("conflict high", tb_conflict(tb) > CONTESTED_CONFLICT)
    ce_eq("contested", tb_is_contested(tb), 1)
}

fn test_wraps_atom_belief() {
    let a = atom_new("med", 0, ATOM_FACT, "aspirin", 0)
    ce_eq("atom starts uniform", atom_confidence(a), 500)
    let tb = tb_wrap(atom_belief(a), 0)
    tb_observe_tier(tb, SRC_A, 1, 1)
    tb_observe_tier(tb, SRC_A, 1, 2)
    // Updating the tracked belief updated the atom in place.
    ce_eq("atom confidence updated", atom_confidence(a), 750)
}

fn main() {
    test_weights_and_updates()
    test_decay_toward_prior()
    test_conflict_and_contested()
    test_wraps_atom_belief()
    ce_summary("bayesian_updates")
}

main()
