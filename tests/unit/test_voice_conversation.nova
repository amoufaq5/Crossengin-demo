// Unit tests for examples/voice_conversation.nova (R25B).
//
// Verifies the three question templates the brief stipulates:
//   1. "what is FACT"    -> SELECT ?desc WHERE { ?atom kind FACT . ?atom label ?desc . } LIMIT 1
//   2. "how many FACT"   -> SELECT (COUNT(?a) AS ?n) WHERE { ?a kind FACT . }
//   3. "list all FACT"   -> SELECT ?a WHERE { ?a kind FACT . } LIMIT 10
//
// Plus result-formatter coverage:
//   * how-many empty   -> "There are 0 FACT atoms."
//   * how-many n=5     -> "There are 5 FACT atoms."
//   * what-is empty    -> "I do not know anything about FACT."
//   * list-all empty   -> "No FACT atoms found."
//   * list-all n=3     -> "Found 3 FACT atoms: ids 0, 1, 2."
//   * unknown template -> apology
//
// All integer math; no LLM. STT + TTS legs are NOT exercised here (they
// have their own unit suites: test_stt_seam, test_audio_tts); the
// integration scenario covers the round-trip.

import "std/syscall"
import "../ce_test.nova"
import "../../examples/voice_conversation.nova"

// ---- question parser: template recognition ------------------------------

fn test_parse_what_is_fact() {
    let p = vc_parse_question("what is FACT")
    ce_eq("what is FACT -> template_id WHAT_IS",
        vc_parsed_template(p), vc_template_what_is())
    ce_str_eq("what is FACT -> kind FACT",
        vc_parsed_kind(p), "FACT")
}

fn test_parse_how_many_fact() {
    let p = vc_parse_question("how many FACT")
    ce_eq("how many FACT -> template_id HOW_MANY",
        vc_parsed_template(p), vc_template_how_many())
    ce_str_eq("how many FACT -> kind FACT",
        vc_parsed_kind(p), "FACT")
}

fn test_parse_list_all_fact() {
    let p = vc_parse_question("list all FACT")
    ce_eq("list all FACT -> template_id LIST_ALL",
        vc_parsed_template(p), vc_template_list_all())
    ce_str_eq("list all FACT -> kind FACT",
        vc_parsed_kind(p), "FACT")
}

// ---- parser: case + punctuation tolerance -------------------------------

fn test_parse_question_mark_tolerance() {
    // Trailing "?" should not break the parser -- it's stripped during
    // trim. This matches the STT output shape from whisper.cpp on
    // questions (it emits the trailing punctuation).
    let p = vc_parse_question("what is FACT?")
    ce_eq("what is FACT? -> WHAT_IS (trailing ? stripped)",
        vc_parsed_template(p), vc_template_what_is())
}

fn test_parse_case_insensitive_leading() {
    // "WHAT IS FACT" should hit the same template -- the keyword folder
    // lower-cases before prefix matching.
    let p = vc_parse_question("WHAT IS FACT")
    ce_eq("WHAT IS FACT -> WHAT_IS (case-insensitive leading)",
        vc_parsed_template(p), vc_template_what_is())
    ce_str_eq("WHAT IS FACT -> kind FACT (upper-cased trailing token)",
        vc_parsed_kind(p), "FACT")
}

fn test_parse_lowercase_kind_uppercased() {
    // "what is fact" with lower-case kind should still resolve because
    // the parser uppercases the trailing token before validating.
    let p = vc_parse_question("what is fact")
    ce_eq("what is fact -> WHAT_IS",
        vc_parsed_template(p), vc_template_what_is())
    ce_str_eq("what is fact -> kind FACT (uppercased)",
        vc_parsed_kind(p), "FACT")
}

fn test_parse_concept_kind() {
    // CONCEPT is one of the recognised kinds too.
    let p = vc_parse_question("how many CONCEPT")
    ce_eq("how many CONCEPT -> HOW_MANY",
        vc_parsed_template(p), vc_template_how_many())
    ce_str_eq("how many CONCEPT -> kind CONCEPT",
        vc_parsed_kind(p), "CONCEPT")
}

// ---- parser: unknown patterns + graceful fallback -----------------------

fn test_parse_unknown_pattern_falls_back() {
    // Greeting -- not one of the three templates.
    let p = vc_parse_question("hello there friend")
    ce_eq("greeting -> UNKNOWN template",
        vc_parsed_template(p), vc_template_unknown())
}

fn test_parse_unknown_kind_falls_back() {
    // The leading keyword matches but the kind is not in our table.
    let p = vc_parse_question("what is XYZZY")
    ce_eq("unknown kind -> UNKNOWN template",
        vc_parsed_template(p), vc_template_unknown())
}

fn test_parse_empty_string_does_not_crash() {
    // Brief mandate: graceful handling. An empty transcript should
    // route to UNKNOWN, not crash.
    let p = vc_parse_question("")
    ce_eq("empty string -> UNKNOWN template",
        vc_parsed_template(p), vc_template_unknown())
}

fn test_parse_whitespace_only() {
    // Whitespace + punctuation only -- trimmed to "" then UNKNOWN.
    let p = vc_parse_question("   ?  ")
    ce_eq("whitespace+? only -> UNKNOWN template",
        vc_parsed_template(p), vc_template_unknown())
}

// ---- SPARQL template builder --------------------------------------------

fn test_build_sparql_what_is_fact() {
    // Brief mandate: the exact SPARQL shape.
    let p = vc_parse_question("what is FACT")
    let q = vc_build_sparql(p)
    ce_str_eq("what is FACT -> canonical SPARQL",
        q,
        "SELECT ?desc WHERE { ?atom kind FACT . ?atom label ?desc . } LIMIT 1")
}

fn test_build_sparql_how_many_fact() {
    let p = vc_parse_question("how many FACT")
    let q = vc_build_sparql(p)
    ce_str_eq("how many FACT -> canonical COUNT SPARQL",
        q,
        "SELECT (COUNT(?a) AS ?n) WHERE { ?a kind FACT . }")
}

fn test_build_sparql_list_all_fact() {
    let p = vc_parse_question("list all FACT")
    let q = vc_build_sparql(p)
    ce_str_eq("list all FACT -> SELECT with LIMIT 10",
        q,
        "SELECT ?a WHERE { ?a kind FACT . } LIMIT 10")
}

fn test_build_sparql_unknown_returns_empty() {
    let p = vc_parse_question("nonsense input")
    let q = vc_build_sparql(p)
    ce_str_eq("UNKNOWN -> empty SPARQL", q, "")
}

// ---- result formatter ---------------------------------------------------

fn test_format_how_many_with_count() {
    // Bindings = [{n: 5}] -- one row with the aggregate result. The
    // formatter pulls ?n and produces "There are 5 FACT atoms.".
    let p = vc_parse_question("how many FACT")
    let bindings = list_new()
    let row = list_new()
    let entry = list_new()
    push(entry, "n")
    push(entry, 5)
    push(row, entry)
    push(bindings, row)
    let s = vc_format_result(p, bindings)
    ce_str_eq("how many FACT [n=5] -> 'There are 5 FACT atoms.'",
        s, "There are 5 FACT atoms.")
}

fn test_format_how_many_zero() {
    // COUNT on an empty set still emits one row with n=0 (per R17E).
    let p = vc_parse_question("how many FACT")
    let bindings = list_new()
    let row = list_new()
    let entry = list_new()
    push(entry, "n")
    push(entry, 0)
    push(row, entry)
    push(bindings, row)
    let s = vc_format_result(p, bindings)
    ce_str_eq("how many FACT [n=0] -> 'There are 0 FACT atoms.'",
        s, "There are 0 FACT atoms.")
}

fn test_format_what_is_empty_bindings() {
    // No bindings -- the formatter says "I do not know anything about".
    let p = vc_parse_question("what is FACT")
    let bindings = list_new()
    let s = vc_format_result(p, bindings)
    ce_str_eq("what is FACT [empty] -> 'I do not know anything about FACT.'",
        s, "I do not know anything about FACT.")
}

fn test_format_list_all_empty() {
    // List-all with empty bindings -> "No FACT atoms found.".
    let p = vc_parse_question("list all FACT")
    let bindings = list_new()
    let s = vc_format_result(p, bindings)
    ce_str_eq("list all FACT [empty] -> 'No FACT atoms found.'",
        s, "No FACT atoms found.")
}

fn test_format_list_all_three_atoms() {
    // Bindings = [{a:0}, {a:1}, {a:2}] -> sentence enumerates the ids.
    let p = vc_parse_question("list all FACT")
    let bindings = list_new()
    let i = 0
    while i < 3 {
        let row = list_new()
        let entry = list_new()
        push(entry, "a")
        push(entry, i)
        push(row, entry)
        push(bindings, row)
        i = i + 1
    }
    let s = vc_format_result(p, bindings)
    ce_str_eq("list all FACT [a=0,1,2] -> 'Found 3 FACT atoms: ids 0, 1, 2.'",
        s, "Found 3 FACT atoms: ids 0, 1, 2.")
}

fn test_format_unknown_template_apology() {
    let p = vc_parse_question("hello there")
    let bindings = list_new()
    let s = vc_format_result(p, bindings)
    ce_str_eq("UNKNOWN -> apology sentence",
        s, "I do not know how to answer that question.")
}

// ---- main ---------------------------------------------------------------

fn main() {
    // parser: template recognition
    test_parse_what_is_fact()
    test_parse_how_many_fact()
    test_parse_list_all_fact()
    // parser: tolerance + casing
    test_parse_question_mark_tolerance()
    test_parse_case_insensitive_leading()
    test_parse_lowercase_kind_uppercased()
    test_parse_concept_kind()
    // parser: graceful fallback
    test_parse_unknown_pattern_falls_back()
    test_parse_unknown_kind_falls_back()
    test_parse_empty_string_does_not_crash()
    test_parse_whitespace_only()
    // SPARQL builder
    test_build_sparql_what_is_fact()
    test_build_sparql_how_many_fact()
    test_build_sparql_list_all_fact()
    test_build_sparql_unknown_returns_empty()
    // result formatter
    test_format_how_many_with_count()
    test_format_how_many_zero()
    test_format_what_is_empty_bindings()
    test_format_list_all_empty()
    test_format_list_all_three_atoms()
    test_format_unknown_template_apology()
    ce_summary("voice_conversation")
}

main()
