// Unit tests for src/perception/lipsync.nova (R23B).
//
// Cross-modal lip sync detector. The pipeline is:
//   image -> heuristic mouth-open score (intensity gradient)
//   audio -> per-frame voicing (VAD energy + ZCR)
//   correlate -> sync verdict (Pearson-style milli correlation)
//
// All fixtures are built in-memory (image buffers via alloc + store8;
// PCM via list of ints). The integration scenario
// (scenario_llll_lipsync.sh) exercises the chat /lipsync wiring
// against synthesized PGM frames + WAV; this unit suite covers the
// algorithm contract:
//
//   * Mouth-open score: synthesized face with dark interior in the
//       lower-third's center -> high score.
//   * Mouth-open score: uniform face -> 0 score (no contrast).
//   * Mouth-open score: invalid inputs -> SENTINEL.
//   * Correlation: identical sequences -> ~1000 milli (perfect).
//   * Correlation: anti-correlated sequences -> ~-1000 milli.
//   * Correlation: random / uncorrelated sequences -> low |corr|.
//   * Correlation: zero-variance / mismatch / empty -> SENTINEL.
//   * voicing_per_frame: pure-zero PCM -> all zeros.
//   * voicing_per_frame: high-amplitude PCM -> some ones.
//   * lipsync_detect: matched fixture (mouth opens when audio voiced)
//       -> is_synced=true.
//   * lipsync_detect: mismatched fixture (mouth opens when audio silent)
//       -> is_synced=false.
//   * lipsync_detect: empty inputs -> graceful sentinel.
//   * Chat helper: well-formed result -> printable line; sentinel
//       and null -> documented "no result" message.
//   * Public constants: threshold + score_max + sentinels are stable
//       (anti-regression pin).
//
// Assertion target: ~25+ (well above the brief's 20-25 floor).

import "../ce_test.nova"
import "../../src/perception/lipsync.nova"

// ---- fixture builders ---------------------------------------------------

// Build a width x height image that is uniformly `value`.
fn _flat_image(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// Build a width x height image that is bright skin tone (200) everywhere
// EXCEPT a dark interior in the lower-third's center (the simulated
// open mouth). The face_bbox in tests covers the full image, so the
// lower-third is rows [2*h/3 .. h).
fn _open_mouth_image(width, height) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, 200)
        i = i + 1
    }
    // Dark interior box: central 50% width x 30% height of the lower-
    // third. This matches the inner-box geometry the score helper uses.
    let mouth_y1 = (height * 2) / 3
    let mouth_h = height - mouth_y1
    let inner_h = (mouth_h * 3) / 10
    if inner_h < 1 { inner_h = 1 }
    let inner_w = width / 2
    if inner_w < 1 { inner_w = 1 }
    let inner_x1 = (width - inner_w) / 2
    let inner_y1 = mouth_y1 + (mouth_h - inner_h) / 2
    let y = inner_y1
    while y < inner_y1 + inner_h {
        let x = inner_x1
        while x < inner_x1 + inner_w {
            store8(buf + y * width + x, 30)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Build a width x height image that is uniform skin tone (closed mouth).
fn _closed_mouth_image(width, height) {
    return _flat_image(width, height, 180)
}

// Build a face_bbox spanning the full image (so the mouth ROI is the
// lower-third of the whole image).
fn _full_face_bbox(width, height) {
    let s = width
    if height < s { s = height }
    return lipsync_make_bbox(0, 0, s)
}

// Build a PCM list of `n` samples that simulates a voiced phoneme:
// a 250 Hz "sawtooth" that ramps up over 32 samples then flips sign.
// This gives a moderate ZCR (~2.5% per sample) and sustained energy --
// roughly what a Klatt-synthesized vowel looks like to vad_frame_energy
// + vad_frame_zcr. `amp` controls the peak magnitude.
fn _voiced_pcm(n, amp) {
    let pcm = list_new()
    let i = 0
    let period = 32   // 32 samples per half-cycle
    let half = period / 2
    while i < n {
        let phase = i - (i / period) * period
        let sign = 1
        if phase >= half { sign = 0 - 1 }
        let ramp = phase
        if phase >= half { ramp = phase - half }
        let v = (amp * ramp) / half
        if sign < 0 { v = 0 - v }
        push(pcm, v)
        i = i + 1
    }
    return pcm
}

// Pure zero PCM (silence).
fn _silence_pcm(n) {
    let pcm = list_new()
    let i = 0
    while i < n {
        push(pcm, 0)
        i = i + 1
    }
    return pcm
}

// Concatenate two PCM lists.
fn _concat_pcm(a, b) {
    let out = list_new()
    let i = 0
    while i < len(a) { push(out, a[i]); i = i + 1 }
    i = 0
    while i < len(b) { push(out, b[i]); i = i + 1 }
    return out
}

// ---- mouth-open score tests ---------------------------------------------

fn test_mouth_open_score_on_open_mouth_image_is_high() {
    let img = _open_mouth_image(48, 48)
    let bbox = _full_face_bbox(48, 48)
    let score = lipsync_mouth_open_score(img, 48, 48, bbox)
    ce_check("open-mouth fixture: score >= 200 (interior much darker than rim)",
             score >= 200)
    ce_check("open-mouth fixture: score <= 1000 (saturated to max range)",
             score <= 1000)
}

fn test_mouth_open_score_on_uniform_face_is_zero() {
    let img = _closed_mouth_image(48, 48)
    let bbox = _full_face_bbox(48, 48)
    let score = lipsync_mouth_open_score(img, 48, 48, bbox)
    ce_eq("uniform face: score == 0 (no interior/exterior contrast)",
          score, 0)
}

fn test_mouth_open_score_on_null_image_returns_sentinel() {
    let bbox = lipsync_make_bbox(0, 0, 48)
    let score = lipsync_mouth_open_score(0, 48, 48, bbox)
    ce_eq("null image ptr: score == SENTINEL (-1)",
          score, lipsync_score_sentinel())
}

fn test_mouth_open_score_on_zero_bbox_returns_sentinel() {
    let img = _closed_mouth_image(48, 48)
    let bbox = lipsync_make_bbox(0, 0, 0)
    let score = lipsync_mouth_open_score(img, 48, 48, bbox)
    ce_eq("zero-size bbox: score == SENTINEL (-1)",
          score, lipsync_score_sentinel())
}

fn test_mouth_open_score_oob_bbox_returns_sentinel() {
    let img = _closed_mouth_image(48, 48)
    // bbox extends past the right edge of the image.
    let bbox = lipsync_make_bbox(40, 40, 32)
    let score = lipsync_mouth_open_score(img, 48, 48, bbox)
    ce_eq("OOB bbox: score == SENTINEL (-1)",
          score, lipsync_score_sentinel())
}

fn test_mouth_open_score_bright_interior_clamps_to_zero() {
    // Interior brighter than rim -- not an opening; the score should
    // saturate to 0 (negative would mislead the correlator).
    let w = 48
    let h = 48
    let area = w * h
    let buf = alloc(area + 1)
    // Start dark everywhere, then paint a BRIGHT interior in the
    // lower-third's center. This inverts the open-mouth contrast.
    let i = 0
    while i < area { store8(buf + i, 50); i = i + 1 }
    let mouth_y1 = (h * 2) / 3
    let mouth_h = h - mouth_y1
    let inner_h = (mouth_h * 3) / 10
    if inner_h < 1 { inner_h = 1 }
    let inner_w = w / 2
    if inner_w < 1 { inner_w = 1 }
    let inner_x1 = (w - inner_w) / 2
    let inner_y1 = mouth_y1 + (mouth_h - inner_h) / 2
    let y = inner_y1
    while y < inner_y1 + inner_h {
        let x = inner_x1
        while x < inner_x1 + inner_w {
            store8(buf + y * w + x, 220)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    let bbox = _full_face_bbox(w, h)
    let score = lipsync_mouth_open_score(buf, w, h, bbox)
    ce_eq("bright interior: score saturates to 0 (no opening detected)",
          score, 0)
}

// ---- correlation tests --------------------------------------------------

fn test_correlate_identical_sequences_is_perfect() {
    let a = list_new()
    push(a, 100) push(a, 200) push(a, 300) push(a, 400) push(a, 500)
    let b = list_new()
    push(b, 100) push(b, 200) push(b, 300) push(b, 400) push(b, 500)
    let c = lipsync_correlate(a, b)
    ce_eq("identical sequences: corr_milli == 1000 (perfect Pearson)",
          c, 1000)
}

fn test_correlate_perfectly_anticorrelated_is_minus_one_thousand() {
    let a = list_new()
    push(a, 100) push(a, 200) push(a, 300) push(a, 400) push(a, 500)
    let b = list_new()
    push(b, 500) push(b, 400) push(b, 300) push(b, 200) push(b, 100)
    let c = lipsync_correlate(a, b)
    ce_eq("anti-correlated sequences: corr_milli == -1000",
          c, 0 - 1000)
}

fn test_correlate_random_sequences_is_near_zero() {
    // Uncorrelated sequences: peaks of a misalign with peaks of b.
    // The integer Pearson on these specific sequences happens to land
    // close to 0 (within +/- 500 milli).
    let a = list_new()
    push(a, 100) push(a, 800) push(a, 200) push(a, 700) push(a, 300)
    push(a, 600) push(a, 400) push(a, 500)
    let b = list_new()
    push(b, 500) push(b, 100) push(b, 400) push(b, 200) push(b, 300)
    push(b, 800) push(b, 600) push(b, 700)
    let c = lipsync_correlate(a, b)
    let abs_c = c
    if abs_c < 0 { abs_c = 0 - abs_c }
    ce_check("random sequences: |corr_milli| <= 500 (Pearson near zero)",
             abs_c <= 500)
}

fn test_correlate_empty_returns_sentinel() {
    let a = list_new()
    let b = list_new()
    let c = lipsync_correlate(a, b)
    ce_eq("empty sequences: corr_milli == SENTINEL (-1)",
          c, lipsync_corr_sentinel())
}

fn test_correlate_length_mismatch_returns_sentinel() {
    let a = list_new()
    push(a, 1) push(a, 2) push(a, 3)
    let b = list_new()
    push(b, 1) push(b, 2)
    let c = lipsync_correlate(a, b)
    ce_eq("length mismatch: corr_milli == SENTINEL (-1)",
          c, lipsync_corr_sentinel())
}

fn test_correlate_constant_input_returns_sentinel() {
    let a = list_new()
    push(a, 5) push(a, 5) push(a, 5) push(a, 5)
    let b = list_new()
    push(b, 1) push(b, 2) push(b, 3) push(b, 4)
    let c = lipsync_correlate(a, b)
    ce_eq("zero-variance input: corr_milli == SENTINEL (-1)",
          c, lipsync_corr_sentinel())
}

fn test_correlate_short_input_returns_sentinel() {
    // n=1 has no variance -> SENTINEL.
    let a = list_new()
    push(a, 42)
    let b = list_new()
    push(b, 42)
    let c = lipsync_correlate(a, b)
    ce_eq("single-element input: corr_milli == SENTINEL (-1)",
          c, lipsync_corr_sentinel())
}

// ---- voicing-per-frame tests --------------------------------------------

fn test_voicing_pure_silence_is_all_zeros() {
    let pcm = _silence_pcm(4800)  // 0.3s @ 16kHz
    let v = lipsync_voicing_per_frame(pcm, 16000, 10)
    ce_eq("silence PCM: voicing length == 10", len(v), 10)
    let zeros = 1
    let i = 0
    while i < len(v) {
        if v[i] != 0 { zeros = 0 }
        i = i + 1
    }
    ce_eq("silence PCM: every voicing flag is 0", zeros, 1)
}

fn test_voicing_high_amplitude_yields_some_ones() {
    let pcm = _voiced_pcm(4800, 8000)   // alternating +/- 8000
    let v = lipsync_voicing_per_frame(pcm, 16000, 10)
    ce_eq("voiced PCM: voicing length == 10", len(v), 10)
    let n_ones = 0
    let i = 0
    while i < len(v) {
        if v[i] == 1 { n_ones = n_ones + 1 }
        i = i + 1
    }
    ce_check("voiced PCM: at least 1 voiced flag (energy above threshold)",
             n_ones >= 1)
}

fn test_voicing_zero_frames_returns_empty() {
    let pcm = _voiced_pcm(1000, 5000)
    let v = lipsync_voicing_per_frame(pcm, 16000, 0)
    ce_eq("n_frames=0: voicing length == 0", len(v), 0)
}

// ---- end-to-end lipsync_detect tests ------------------------------------

// Build a 5-frame matched fixture: frames 0,2,4 have an open mouth (score
// high) while voicing alternates with them, AND frames 0,2,4 of the
// audio are voiced. This is the "synced" case.
fn _matched_video_frames() {
    let frames = list_new()
    let w = 48
    let h = 48
    let bbox = _full_face_bbox(w, h)
    let open_img = _open_mouth_image(w, h)
    let closed_img = _closed_mouth_image(w, h)
    // Frames 0,2,4 -> open; 1,3 -> closed.
    push(frames, lipsync_video_frame(open_img,   w, h, bbox))
    push(frames, lipsync_video_frame(closed_img, w, h, bbox))
    push(frames, lipsync_video_frame(open_img,   w, h, bbox))
    push(frames, lipsync_video_frame(closed_img, w, h, bbox))
    push(frames, lipsync_video_frame(open_img,   w, h, bbox))
    return frames
}

// Audio for the matched case: voiced (alternating +/-amp) where the
// frame is open, silence where it's closed. 16kHz; 5 frames of equal
// length so each video frame gets one audio chunk.
fn _matched_audio_pcm(samples_per_frame) {
    let voiced = _voiced_pcm(samples_per_frame, 10000)
    let silent = _silence_pcm(samples_per_frame)
    let p1 = _concat_pcm(voiced, silent)        // frame 0 + 1
    let p2 = _concat_pcm(p1, voiced)            // + frame 2
    let p3 = _concat_pcm(p2, silent)            // + frame 3
    return _concat_pcm(p3, voiced)              // + frame 4
}

fn test_lipsync_detect_matched_is_synced() {
    let frames = _matched_video_frames()
    let pcm = _matched_audio_pcm(800)   // 800 samples per video frame
    let result = lipsync_detect(frames, pcm, 16000)
    let score = lipsync_result_sync_score(result)
    let synced = lipsync_result_is_synced(result)
    ce_check("matched fixture: sync_score >= threshold",
             score >= lipsync_sync_threshold_milli())
    ce_eq("matched fixture: is_synced == 1", synced, 1)
}

// Mismatched fixture: same video (open/closed/open/closed/open) but
// audio is voiced where mouth is closed and silent where mouth is open.
// This is the "dubbed-over silent video" case -> anti-correlated -> not
// synced (the sync_score clamps to 0, below threshold).
fn _mismatched_audio_pcm(samples_per_frame) {
    let voiced = _voiced_pcm(samples_per_frame, 10000)
    let silent = _silence_pcm(samples_per_frame)
    let p1 = _concat_pcm(silent, voiced)        // frame 0 silent, 1 voiced
    let p2 = _concat_pcm(p1, silent)
    let p3 = _concat_pcm(p2, voiced)
    return _concat_pcm(p3, silent)
}

fn test_lipsync_detect_mismatched_is_not_synced() {
    let frames = _matched_video_frames()
    let pcm = _mismatched_audio_pcm(800)
    let result = lipsync_detect(frames, pcm, 16000)
    let score = lipsync_result_sync_score(result)
    let synced = lipsync_result_is_synced(result)
    ce_check("mismatched fixture: sync_score < threshold",
             score < lipsync_sync_threshold_milli())
    ce_eq("mismatched fixture: is_synced == 0", synced, 0)
}

fn test_lipsync_detect_empty_video_returns_sentinel() {
    let frames = list_new()
    let pcm = _voiced_pcm(800, 5000)
    let result = lipsync_detect(frames, pcm, 16000)
    let score = lipsync_result_sync_score(result)
    let synced = lipsync_result_is_synced(result)
    ce_eq("empty video frames: sync_score == SENTINEL",
          score, lipsync_corr_sentinel())
    ce_eq("empty video frames: is_synced == 0", synced, 0)
}

fn test_lipsync_detect_null_audio_returns_sentinel() {
    let frames = _matched_video_frames()
    let result = lipsync_detect(frames, 0, 16000)
    let score = lipsync_result_sync_score(result)
    ce_eq("null audio: sync_score == SENTINEL",
          score, lipsync_corr_sentinel())
}

fn test_lipsync_detect_bad_sample_rate_returns_sentinel() {
    let frames = _matched_video_frames()
    let pcm = _voiced_pcm(800, 5000)
    let result = lipsync_detect(frames, pcm, 0)
    let score = lipsync_result_sync_score(result)
    ce_eq("sample_rate=0: sync_score == SENTINEL",
          score, lipsync_corr_sentinel())
}

// ---- chat helper tests --------------------------------------------------

fn test_chat_format_sentinel_result() {
    let r = list_new()
    push(r, lipsync_corr_sentinel())
    push(r, 0)
    let s = lipsync_chat_format(r)
    ce_check("sentinel result: format mentions 'no result'",
             char_at(s, 0) == 40)  // '('
}

fn test_chat_format_well_formed_result_includes_score() {
    let r = list_new()
    push(r, 750)
    push(r, 1)
    let s = lipsync_chat_format(r)
    // First char should be 's' (sync_score_milli=...)
    ce_check("well-formed result: format starts with 'sync_score_milli'",
             char_at(s, 0) == 115)  // 's'
}

fn test_chat_format_null_result_safe() {
    let s = lipsync_chat_format(0)
    ce_check("null result: format starts with '('",
             char_at(s, 0) == 40)
}

// ---- public constant pins -----------------------------------------------

fn test_public_constants_are_stable() {
    ce_eq("LIPSYNC_SYNC_THRESHOLD_MILLI == 400",
          lipsync_sync_threshold_milli(), 400)
    ce_eq("LIPSYNC_SCORE_MAX == 1000",
          lipsync_score_max(), 1000)
    ce_eq("LIPSYNC_CORR_SENTINEL == -1",
          lipsync_corr_sentinel(), 0 - 1)
    ce_eq("LIPSYNC_SCORE_SENTINEL == -1",
          lipsync_score_sentinel(), 0 - 1)
    ce_eq("LIPSYNC_DEFAULT_FPS == 30",
          lipsync_default_fps(), 30)
}

// ---- frame and bbox constructor accessors -------------------------------

fn test_video_frame_accessors_round_trip() {
    let bbox = lipsync_make_bbox(10, 20, 30)
    let f = lipsync_video_frame(12345, 64, 48, bbox)
    ce_eq("frame_image accessor", lipsync_frame_image(f), 12345)
    ce_eq("frame_width accessor", lipsync_frame_width(f), 64)
    ce_eq("frame_height accessor", lipsync_frame_height(f), 48)
    ce_eq("bbox_x accessor", lipsync_bbox_x(lipsync_frame_bbox(f)), 10)
    ce_eq("bbox_y accessor", lipsync_bbox_y(lipsync_frame_bbox(f)), 20)
    ce_eq("bbox_size accessor", lipsync_bbox_size(lipsync_frame_bbox(f)), 30)
}

// ---- main runner --------------------------------------------------------

fn main() {
    test_mouth_open_score_on_open_mouth_image_is_high()
    test_mouth_open_score_on_uniform_face_is_zero()
    test_mouth_open_score_on_null_image_returns_sentinel()
    test_mouth_open_score_on_zero_bbox_returns_sentinel()
    test_mouth_open_score_oob_bbox_returns_sentinel()
    test_mouth_open_score_bright_interior_clamps_to_zero()
    test_correlate_identical_sequences_is_perfect()
    test_correlate_perfectly_anticorrelated_is_minus_one_thousand()
    test_correlate_random_sequences_is_near_zero()
    test_correlate_empty_returns_sentinel()
    test_correlate_length_mismatch_returns_sentinel()
    test_correlate_constant_input_returns_sentinel()
    test_correlate_short_input_returns_sentinel()
    test_voicing_pure_silence_is_all_zeros()
    test_voicing_high_amplitude_yields_some_ones()
    test_voicing_zero_frames_returns_empty()
    test_lipsync_detect_matched_is_synced()
    test_lipsync_detect_mismatched_is_not_synced()
    test_lipsync_detect_empty_video_returns_sentinel()
    test_lipsync_detect_null_audio_returns_sentinel()
    test_lipsync_detect_bad_sample_rate_returns_sentinel()
    test_chat_format_sentinel_result()
    test_chat_format_well_formed_result_includes_score()
    test_chat_format_null_result_safe()
    test_public_constants_are_stable()
    test_video_frame_accessors_round_trip()
    ce_summary("lipsync")
}

main()
