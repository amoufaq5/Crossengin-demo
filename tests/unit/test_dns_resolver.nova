// Unit tests for src/learning/dns_resolver.nova (ADR-0028 / R41).
// Exercises the binary packet builder + parser deterministically against
// hand-built buffers (no network): query encoding, A-record extraction, name
// compression, and the dotted-quad helpers.

import "../ce_test.nova"
import "../../src/learning/dns_resolver.nova"

fn _setb(buf, off, v) { store8(buf + off, v) return 0 }

fn test_dotted_quad() {
    ce_eq("8.8.8.8 is quad",   _dns_is_dotted_quad("8.8.8.8"), 1)
    ce_eq("host is not quad",  _dns_is_dotted_quad("example.com"), 0)
    ce_eq("256 rejected",      _dns_is_dotted_quad("1.2.3.256"), 0)
    // a + b*256 + c*65536 + d*16777216
    ce_eq("ip 1.2.3.4 -> int", _dns_ip_to_int("1.2.3.4"), 1 + 2 * 256 + 3 * 65536 + 4 * 16777216)
}

fn test_build_query() {
    let buf = alloc(64)
    let qlen = _dns_build_query(buf, "a.bc", 4660)
    // header(12) + [1]a[2]bc[0](6) + qtype(2) + qclass(2) = 22
    ce_eq("query length", qlen, 22)
    ce_eq("QDCOUNT=1",   _dns_get16(buf, 4), 1)
    ce_eq("label1 len",  load8(buf + 12), 1)
    ce_eq("label1 'a'",  load8(buf + 13), 97)
    ce_eq("label2 len",  load8(buf + 14), 2)
    ce_eq("label2 'b'",  load8(buf + 15), 98)
    ce_eq("label2 'c'",  load8(buf + 16), 99)
    ce_eq("root label 0", load8(buf + 17), 0)
    ce_eq("QTYPE A",     _dns_get16(buf, 18), 1)
    ce_eq("QCLASS IN",   _dns_get16(buf, 20), 1)
}

// Build a synthetic response: 1 question ("x"), 1 answer A=1.2.3.4 with a
// 0xC00C name-compression pointer back to the question.
fn _build_response(buf) {
    _setb(buf, 0, 18) _setb(buf, 1, 52)      // ID 0x1234
    _setb(buf, 2, 129) _setb(buf, 3, 128)    // flags 0x8180 (response, rcode 0)
    _setb(buf, 4, 0) _setb(buf, 5, 1)        // QDCOUNT 1
    _setb(buf, 6, 0) _setb(buf, 7, 1)        // ANCOUNT 1
    _setb(buf, 8, 0) _setb(buf, 9, 0)        // NSCOUNT
    _setb(buf, 10, 0) _setb(buf, 11, 0)      // ARCOUNT
    _setb(buf, 12, 1) _setb(buf, 13, 120) _setb(buf, 14, 0)   // QNAME [1]'x'[0]
    _setb(buf, 15, 0) _setb(buf, 16, 1)      // QTYPE A
    _setb(buf, 17, 0) _setb(buf, 18, 1)      // QCLASS IN
    _setb(buf, 19, 192) _setb(buf, 20, 12)   // answer NAME -> pointer 0xC00C
    _setb(buf, 21, 0) _setb(buf, 22, 1)      // TYPE A
    _setb(buf, 23, 0) _setb(buf, 24, 1)      // CLASS IN
    _setb(buf, 25, 0) _setb(buf, 26, 0) _setb(buf, 27, 0) _setb(buf, 28, 60)  // TTL
    _setb(buf, 29, 0) _setb(buf, 30, 4)      // RDLENGTH 4
    _setb(buf, 31, 1) _setb(buf, 32, 2) _setb(buf, 33, 3) _setb(buf, 34, 4)   // RDATA
    return 35
}

fn test_parse_answer() {
    let buf = alloc(64)
    let total = _build_response(buf)
    ce_str_eq("parses A record", _dns_parse_answer(buf, total, 4660), "1.2.3.4")
}

fn test_parse_rejects() {
    let buf = alloc(64)
    let total = _build_response(buf)
    // flip rcode to 3 (NXDOMAIN) -> no answer
    store8(buf + 3, 131)                      // 0x83 low nibble = 3
    ce_str_eq("nxdomain -> empty", _dns_parse_answer(buf, total, 4660), "")
    // too short
    ce_str_eq("short -> empty", _dns_parse_answer(buf, 8, 4660), "")
}

fn main() {
    test_dotted_quad()
    test_build_query()
    test_parse_answer()
    test_parse_rejects()
    ce_summary("dns_resolver")
}

main()
