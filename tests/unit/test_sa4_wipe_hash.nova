// Unit tests for the wiping hash used on secret bytes in v4-sa2 (A2.4b
// review): sha256_oneshot_wipe gives the same digest as sha256_oneshot
// (one- and two-block padding, block boundaries), and the commitment
// hashes over a share or b_u (sa4w_hs, sa4w_hb, sa4w_bcommit) leave no raw
// copy of the secret on the heap (the allocator never frees, so a copy
// would outlive the soul's wipe). The heap check scans every byte
// allocated during one call for the 32-byte secret. Also: sa4w_hex is
// linear in heap use (a v2 SHARE ciphertext at N = 255 is 354 bytes; the
// quadratic version used about 260 KB per line).

import "../ce_test.nova"
import "../../src/learning/sa4_wire.nova"

fn _wh_pattern(seed) {
    let out = list_new()
    let i = 0
    while i < 32 {
        push(out, int_and(seed + 7 * i + 13, 255))
        i = i + 1
    }
    return out
}

fn _wh_copy(l) {
    let out = list_new()
    let i = 0
    while i < len(l) {
        push(out, l[i])
        i = i + 1
    }
    return out
}

// Count raw copies of the 32-byte pattern in [lo, hi).
fn _wh_count(lo, hi, pat) {
    let n = 0
    let p = lo
    while p + 32 <= hi {
        if load8(p) == pat[0] {
            let k = 1
            let same = 1
            while k < 32 {
                if same == 1 {
                    if load8(p + k) != pat[k] { same = 0 }
                }
                k = k + 1
            }
            if same == 1 { n = n + 1 }
        }
        p = p + 1
    }
    return n
}

fn _wh_digest_eq(n) {
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, int_and(i * 31 + 5, 255))
        i = i + 1
    }
    let a = sac_buf_to_list(sha256_oneshot(buf, n), 32)
    let b = sac_buf_to_list(sha256_oneshot_wipe(buf, n), 32)
    return sa4w_hex(a) == sa4w_hex(b)
}

fn main() {
    let lens = [0, 1, 55, 56, 63, 64, 65, 104, 119, 120, 127, 128, 200]
    let i = 0
    while i < len(lens) {
        ce_check("sha256_oneshot_wipe == sha256_oneshot, n = " + int_to_str(lens[i]), _wh_digest_eq(lens[i]))
        i = i + 1
    }
    let fp = _wh_pattern(99)
    let pat = _wh_pattern(1)
    let sh = _wh_copy(pat)
    let h0 = alloc(8)
    let hs = sa4w_hs(fp, 5, 300, 7, sh)
    let h1 = alloc(8)
    ce_eq("sa4w_hs: no raw copy of the s-share left on the heap", _wh_count(h0, h1, pat), 0)
    ce_eq("sa4w_hs: the digest is 32 bytes", len(hs), 32)
    ce_str_eq("sa4w_hs: the caller's share list is untouched", sa4w_hex(sh), sa4w_hex(pat))
    let pat2 = _wh_pattern(2)
    let h2 = alloc(8)
    let hb = sa4w_hb(fp, 5, 300, 7, _wh_copy(pat2))
    let h3 = alloc(8)
    ce_eq("sa4w_hb: no raw copy of the b-share left on the heap", _wh_count(h2, h3, pat2), 0)
    let pat3 = _wh_pattern(3)
    let h4 = alloc(8)
    let bc = sa4w_bcommit(fp, 5, 300, _wh_copy(pat3))
    let h5 = alloc(8)
    ce_eq("sa4w_bcommit: no raw copy of b_u left on the heap", _wh_count(h4, h5, pat3), 0)
    ce_check("the scan finds a copy it should (control)", _wh_control(pat))
    ce_check("hb and B differ", sa4w_hex(hb) != sa4w_hex(bc))
    let big = list_new()
    let q = 0
    while q < 354 {
        push(big, int_and(q * 13, 255))
        q = q + 1
    }
    let m0 = alloc(8)
    let hx = sa4w_hex(big)
    let m1 = alloc(8)
    ce_eq("sa4w_hex: 708 digits", len(hx), 708)
    ce_check("sa4w_hex(354 bytes) allocates under 4 KB (" + int_to_str(m1 - m0) + " B)", m1 - m0 < 4096)
    ce_str_eq("sa4w_hex: digits", substr(hx, 0, 8), "000d1a27")
    ce_str_eq("sa4w_hex: empty", sa4w_hex(list_new()), "")
    ce_str_eq("sa4w_hex: round trip", sa4w_hex(sa4w_unhex(hx, 354)), hx)
    ce_summary("sa4_wipe_hash")
}

// Control: a plain sac_list_to_buf copy made in the window is found.
fn _wh_control(pat) {
    let h0 = alloc(8)
    let b = sac_list_to_buf(pat)
    let h1 = alloc(8)
    return _wh_count(h0, h1, pat) == 1
}

main()
