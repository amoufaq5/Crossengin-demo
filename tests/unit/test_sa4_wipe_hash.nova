// Unit tests for the wiping hash used on secret bytes in v4-sa2 (A2.4b
// review): sha256_oneshot_wipe gives the same digest as sha256_oneshot
// (one- and two-block padding, block boundaries), and the commitment
// hashes over a share or b_u (sa4w_hs, sa4w_hb, sa4w_bcommit) leave no raw
// copy of the secret on the heap (the allocator never frees, so a copy
// would outlive the soul's wipe). The heap check scans every byte
// allocated during one call for the 32-byte secret. Also: sa4w_hex is
// linear in heap use (a v2 SHARE ciphertext at N = 255 is 354 bytes; the
// quadratic version used about 260 KB per line).
// v4-sa3 (A2.4c): the one-time key seed eseed and every one-time key e_uv
// leave no raw copy on the heap: not in sac_eph_key (wiping HKDF), not in
// a soul's R1 (seal under e_uv, e_pk), not when an accused answers a
// complaint with SA4_OPEN. Positive control: the same scan finds the
// copies of a plain hkdf_sha256 call. (X25519 itself keeps a clamped copy
// of its scalar, which differs from e_uv in its low three and top two
// bits; the test checks that none of these e_uv is clamp-invariant, so the
// scan is meaningful.)
// CE_TEST_TIMEOUT: 240

import "../ce_test.nova"
import "../../src/learning/sa4_wire.nova"
import "../sa4_harness.nova"

fn _wh_pattern(seed) {
    let out = list_new()
    let i = 0
    while i < 32 {
        push(out, int_and(seed + 7 * i + 13, 255))
        i = i + 1
    }
    return out
}

fn _wh_copy(l) {
    let out = list_new()
    let i = 0
    while i < len(l) {
        push(out, l[i])
        i = i + 1
    }
    return out
}

// Count raw copies of the 32-byte pattern in [lo, hi).
fn _wh_count(lo, hi, pat) {
    let n = 0
    let p = lo
    while p + 32 <= hi {
        if load8(p) == pat[0] {
            let k = 1
            let same = 1
            while k < 32 {
                if same == 1 {
                    if load8(p + k) != pat[k] { same = 0 }
                }
                k = k + 1
            }
            if same == 1 { n = n + 1 }
        }
        p = p + 1
    }
    return n
}

fn _wh_digest_eq(n) {
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, int_and(i * 31 + 5, 255))
        i = i + 1
    }
    let a = sac_buf_to_list(sha256_oneshot(buf, n), 32)
    let b = sac_buf_to_list(sha256_oneshot_wipe(buf, n), 32)
    return sa4w_hex(a) == sa4w_hex(b)
}

fn main() {
    let lens = [0, 1, 55, 56, 63, 64, 65, 104, 119, 120, 127, 128, 200]
    let i = 0
    while i < len(lens) {
        ce_check("sha256_oneshot_wipe == sha256_oneshot, n = " + int_to_str(lens[i]), _wh_digest_eq(lens[i]))
        i = i + 1
    }
    let fp = _wh_pattern(99)
    let pat = _wh_pattern(1)
    let sh = _wh_copy(pat)
    let h0 = alloc(8)
    let hs = sa4w_hs(fp, 5, 300, 7, sh)
    let h1 = alloc(8)
    ce_eq("sa4w_hs: no raw copy of the s-share left on the heap", _wh_count(h0, h1, pat), 0)
    ce_eq("sa4w_hs: the digest is 32 bytes", len(hs), 32)
    ce_str_eq("sa4w_hs: the caller's share list is untouched", sa4w_hex(sh), sa4w_hex(pat))
    let pat2 = _wh_pattern(2)
    let h2 = alloc(8)
    let hb = sa4w_hb(fp, 5, 300, 7, _wh_copy(pat2))
    let h3 = alloc(8)
    ce_eq("sa4w_hb: no raw copy of the b-share left on the heap", _wh_count(h2, h3, pat2), 0)
    let pat3 = _wh_pattern(3)
    let h4 = alloc(8)
    let bc = sa4w_bcommit(fp, 5, 300, _wh_copy(pat3))
    let h5 = alloc(8)
    ce_eq("sa4w_bcommit: no raw copy of b_u left on the heap", _wh_count(h4, h5, pat3), 0)
    ce_check("the scan finds a copy it should (control)", _wh_control(pat))
    ce_check("hb and B differ", sa4w_hex(hb) != sa4w_hex(bc))
    let big = list_new()
    let q = 0
    while q < 354 {
        push(big, int_and(q * 13, 255))
        q = q + 1
    }
    let m0 = alloc(8)
    let hx = sa4w_hex(big)
    let m1 = alloc(8)
    ce_eq("sa4w_hex: 708 digits", len(hx), 708)
    ce_check("sa4w_hex(354 bytes) allocates under 4 KB (" + int_to_str(m1 - m0) + " B)", m1 - m0 < 4096)
    ce_str_eq("sa4w_hex: digits", substr(hx, 0, 8), "000d1a27")
    ce_str_eq("sa4w_hex: empty", sa4w_hex(list_new()), "")
    ce_str_eq("sa4w_hex: round trip", sa4w_hex(sa4w_unhex(hx, 354)), hx)
    test_eph_wipe()
    test_soul_eph_wipe()
    ce_summary("sa4_wipe_hash")
}

fn _wh_buf_list(b) { return sac_buf_to_list(b, 32) }

// 1 if X25519's clamp leaves the 32 bytes unchanged.
fn _wh_clamp_invariant(l) {
    if int_and(l[0], 7) != 0 { return 0 }
    if int_and(l[31], 192) != 64 { return 0 }
    return 1
}

fn test_eph_wipe() {
    let seed = _wh_pattern(41)
    let sb = sac_list_to_buf(seed)
    let h0 = alloc(8)
    let e = sac_eph_key(sb, 7, 300, 65536)
    let el = _wh_buf_list(e[0])
    sac_zero_buf(e[0], 32)
    let h1 = alloc(8)
    ce_eq("sac_eph_key: no raw copy of eseed on the heap", _wh_count(h0, h1, seed), 0)
    ce_eq("sac_eph_key: no raw copy of e_uv once the caller zeroed it", _wh_count(h0, h1, el), 0)
    // Positive control: plain HKDF over the same seed leaves copies of
    // both (its HMAC input and T(1)).
    let info = sac_kdf_info("eph", 7, 300, 65536)
    let h2 = alloc(8)
    let h = hkdf_sha256(0, 0, sb, 32, info[0], info[1], 32)
    let hl = _wh_buf_list(h[0])
    sac_zero_buf(h[0], 32)
    let h3 = alloc(8)
    ce_check("control: plain HKDF leaves a copy of eseed", _wh_count(h2, h3, seed) >= 1)
    ce_check("control: plain HKDF leaves a copy of its output", _wh_count(h2, h3, hl) >= 1)
    ce_str_eq("control: same key", sa4w_hex(hl), sa4w_hex(el))
    return 0
}

// A soul's R1 (5 souls, harness roster): no raw copy of its eseed or of
// any of its four e_uv in the heap used by R1; then the same for an OPEN.
fn test_soul_eph_wipe() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, 91, vc, 0)
    let rl = sa4h_round_line(roster, 91)
    let advs = list_new()
    let i = 0
    while i < 5 {
        advs = sa4h_cat(advs, sa4h_feed(souls[i], sa4h_one(rl))[1])
        i = i + 1
    }
    let sl = souls[0]
    let seed = _wh_buf_list(sl[34])
    let es = list_new()
    let k = 1
    while k < 5 {
        let ek = sac_eph_key(sl[34], 91, 7, SA4H_IDS[k])
        push(es, _wh_buf_list(ek[0]))
        sac_zero_buf(ek[0], 32)
        k = k + 1
    }
    let inv = 0
    k = 0
    while k < 4 {
        inv = inv + _wh_clamp_invariant(es[k])
        k = k + 1
    }
    ce_eq("no e_uv of soul 7 is clamp-invariant (the scan is meaningful)", inv, 0)
    let set1 = sa4w_fmt_set(91, 1, sa4w_bitmap([1, 2, 3, 4, 5]))
    let h0 = alloc(8)
    let r1 = sa4h_feed(sl, sa4h_cat(advs, sa4h_one(set1)))
    let h1 = alloc(8)
    ce_eq("R1 of soul 7 succeeds", r1[0], 1)
    ce_eq("R1: no raw copy of eseed", _wh_count(h0, h1, seed), 0)
    let found = 0
    k = 0
    while k < 4 {
        found = found + _wh_count(h0, h1, es[k])
        k = k + 1
    }
    ce_eq("R1: no raw copy of any e_uv (4 receivers)", found, 0)
    // OPEN (a fresh round, r = 93): soul 300 complains validly about soul
    // 7's line, and soul 7 reveals e_{7,300}.
    let fp = sa4w_unhex(sroster_fingerprint(roster), 32)
    let rx = sa4e_through_r1(roster, 5, 93, vc, list_new())
    let v = rx[0][0]
    let fc = sa4h_feed(v, sa4h_cat(sa4e_shares_to(rx[2], 7), sa4h_one(sa4w_fmt_set(93, 5, sa4w_bitmap([1, 2, 3, 4, 5])))))
    ce_eq("accused through CHECK", fc[0], 1)
    let l300 = sa4e_shares_to(rx[2], 300)[0]
    let q3 = sa4w_parse(l300)
    let lh3 = sa4w_sleaf(fp, 93, 7, 2, 300, q3[5], q3[4])
    let cs = ed25519_sign(sa4w_complaint_transcript(fp, 93, 300, 7, v[23], lh3), ed25519_hex_to_bytes(SA4H_SEEDS[1]), ed25519_hex_to_bytes(SA4H_PKS[1]))
    let ek3 = sac_eph_key(v[34], 93, 7, 300)
    let e3 = _wh_buf_list(ek3[0])
    sac_zero_buf(ek3[0], 32)
    let seed3 = _wh_buf_list(v[34])
    let cl = sa4w_fmt_complaint(93, 300, 7, lh3, cs)
    let acc = sa4w_fmt_accuse(93, sa4w_bitmap([2]))
    let h2 = alloc(8)
    let fo = sa4h_feed(v, [cl, acc])
    let h3 = alloc(8)
    ce_eq("OPEN sent", len(sa4h_filter(fo[1], "SA4_OPEN 93 7 300 " + sa4w_hex(e3))), 1)
    ce_eq("OPEN: no raw copy of e_{7,300}", _wh_count(h2, h3, e3), 0)
    ce_eq("OPEN: no raw copy of eseed", _wh_count(h2, h3, seed3), 0)
    ce_check("OPEN: e_{7,300} is not clamp-invariant", _wh_clamp_invariant(e3) == 0)
    return 0
}

// Control: a plain sac_list_to_buf copy made in the window is found.
fn _wh_control(pat) {
    let h0 = alloc(8)
    let b = sac_list_to_buf(pat)
    let h1 = alloc(8)
    return _wh_count(h0, h1, pat) == 1
}

main()
