// Unit tests for src/kg/episodic.nova
//
// Verifies the episodic memory consolidation cycle (ADR-0022 long-term
// memory promotion):
//   - episodic_atom_new shape + accessors
//   - canonical signature (order-invariant)
//   - episodic_tally over a recent moment window
//   - episodic_consolidate mints atoms iff cluster_size >= 3 AND count >= 5
//   - episodic_match (single-id membership)
//   - episodic_match_observation (cluster subset of observation)
//   - partial match (A,B,X vs {A,B,C}) returns 0 by documented policy
//   - episodic_update_belief: matched=1 bumps alpha, matched=0 bumps beta
//   - episodic_observe: live belief reinforcement across the store
//   - snapshot round-trip: write -> reload -> identical episodic atom
//
// ADRs: ADR-0022, ADR-0023, ADR-0048.

import "../ce_test.nova"
import "../../src/kg/episodic.nova"
import "../../src/persistence/snapshot_disk.nova"

// ---- helpers --------------------------------------------------------------

fn ids3(a, b, c) {
    let l = list_new()
    push(l, a) push(l, b) push(l, c)
    return l
}

fn ids4(a, b, c, d) {
    let l = list_new()
    push(l, a) push(l, b) push(l, c) push(l, d)
    return l
}

// Capture a moment with the given atom-id trace at logical ts.
fn capture(stream, ts, trace) {
    let m = ms_capture(stream, ts, MODALITY_TEXT, "x", 600, 0)
    let i = 0
    while i < len(trace) { moment_add_trace(m, trace[i]); i = i + 1 }
    return m
}

// ---- atom shape ----------------------------------------------------------

fn test_atom_shape() {
    let members = ids3(7, 11, 13)
    let a = episodic_atom_new(0, members, 5, 100, 200, "test/cluster")
    ce_eq("id is 0",                episodic_atom_id(a), 0)
    ce_eq("members length is 3",    len(episodic_atom_members(a)), 3)
    ce_eq("members[0] is 7",        episodic_atom_members(a)[0], 7)
    ce_eq("count is 5",             episodic_atom_count(a), 5)
    ce_eq("first_seen is 100",      episodic_atom_first_seen(a), 100)
    ce_eq("last_seen is 200",       episodic_atom_last_seen(a), 200)
    ce_eq("alpha starts at prior",  episodic_atom_alpha(a), BEL_PRIOR)
    ce_eq("beta starts at prior",   episodic_atom_beta(a), BEL_PRIOR)
    ce_str_eq("provenance survives", episodic_atom_provenance(a), "test/cluster")
    // Uniform prior -> posterior mean is 500 milli (0.5).
    ce_eq("confidence at prior is 500", episodic_atom_confidence(a), 500)
    // alpha + beta == 2000 milli at the prior.
    ce_eq("strength at prior is 2*PRIOR", episodic_atom_strength(a), BEL_PRIOR * 2)
}

// ---- canonical signature -------------------------------------------------

fn test_signature_canonical() {
    let s1 = episodic_signature(ids3(7, 11, 13))
    let s2 = episodic_signature(ids3(13, 7, 11))
    let s3 = episodic_signature(ids3(11, 13, 7))
    ce_str_eq("signature 7-11-13 canonical", s1, "7,11,13")
    ce_str_eq("permutation matches",          s2, "7,11,13")
    ce_str_eq("another permutation matches",  s3, "7,11,13")
    let s4 = episodic_signature(ids3(7, 11, 14))
    ce_check("different cluster -> different signature", str_eq(s1, s4) == 0)
}

// ---- empty / no-cooccurrence consolidation -------------------------------

fn test_consolidate_no_cooccurrence() {
    // 10 atoms, each in its own one-member trace -> below cluster-size gate.
    let stream = ms_new()
    let eas = episodic_atoms_new()
    let i = 0
    while i < 10 {
        let single = list_new()
        push(single, 100 + i)
        capture(stream, i, single)
        i = i + 1
    }
    let minted = episodic_consolidate(eas, stream, 0, 0)
    ce_eq("no clusters -> 0 minted", minted, 0)
    ce_eq("store is empty",          episodic_atoms_count(eas), 0)
}

// ---- canonical fixture: 5 (A,B,C) triplets -> 1 episodic atom ------------

fn test_consolidate_5_triplets() {
    let stream = ms_new()
    let eas = episodic_atoms_new()
    // Five (A=1,B=2,C=3) triplets at ts = 0, 10, 20, 30, 40 (within the
    // EPISODIC_COOCCUR_WINDOW boundary). Scattered noise between them.
    capture(stream, 0,  ids3(1, 2, 3))
    capture(stream, 5,  ids3(7, 8, 9))        // noise
    capture(stream, 10, ids3(1, 2, 3))
    capture(stream, 15, ids3(11, 12, 13))     // noise
    capture(stream, 20, ids3(1, 2, 3))
    capture(stream, 25, ids3(21, 22, 23))     // noise
    capture(stream, 30, ids3(1, 2, 3))
    capture(stream, 35, ids3(31, 32, 33))     // noise
    capture(stream, 40, ids3(1, 2, 3))

    let minted = episodic_consolidate(eas, stream, 0, 0)
    ce_eq("one {1,2,3} cluster minted", minted, 1)
    ce_eq("store has exactly one atom", episodic_atoms_count(eas), 1)

    let ep = episodic_atoms_get(eas, 0)
    ce_eq("count is 5",               episodic_atom_count(ep), 5)
    ce_eq("first_seen is 0",          episodic_atom_first_seen(ep), 0)
    ce_eq("last_seen is 40",          episodic_atom_last_seen(ep), 40)
    ce_eq("members has 3 ids",        len(episodic_atom_members(ep)), 3)
    ce_eq("members[0] is 1",          episodic_atom_members(ep)[0], 1)
    ce_eq("members[1] is 2",          episodic_atom_members(ep)[1], 2)
    ce_eq("members[2] is 3",          episodic_atom_members(ep)[2], 3)
    ce_str_eq("signature is 1,2,3",   episodic_signature(episodic_atom_members(ep)), "1,2,3")
    ce_eq("alpha still at prior",     episodic_atom_alpha(ep), BEL_PRIOR)
    ce_eq("beta still at prior",      episodic_atom_beta(ep), BEL_PRIOR)
}

// ---- 6th (A,B,C) triplet: match returns true, belief increments alpha ----

fn test_sixth_triplet_increments_alpha() {
    let stream = ms_new()
    let eas = episodic_atoms_new()
    let i = 0
    while i < 5 {
        capture(stream, i * 10, ids3(1, 2, 3))
        i = i + 1
    }
    episodic_consolidate(eas, stream, 0, 0)
    let ep = episodic_atoms_get(eas, 0)
    let prior_alpha = episodic_atom_alpha(ep)
    let prior_count = episodic_atom_count(ep)

    // Sixth observation arriving live (after the pass): episodic_match
    // returns 1 for each cluster member, and episodic_match_observation
    // returns 1 for the full set.
    ce_eq("member 1 matches",        episodic_match(ep, 1), 1)
    ce_eq("member 2 matches",        episodic_match(ep, 2), 1)
    ce_eq("member 3 matches",        episodic_match(ep, 3), 1)
    ce_eq("non-member 99 does not match", episodic_match(ep, 99), 0)
    ce_eq("full set matches as observation", episodic_match_observation(ep, ids3(1, 2, 3)), 1)

    // Live belief reinforcement: episodic_observe bumps alpha by FP_SCALE.
    let updated = episodic_observe(eas, ids3(1, 2, 3), 60)
    ce_eq("one atom updated", updated, 1)
    ce_eq("alpha incremented by FP_SCALE", episodic_atom_alpha(ep), prior_alpha + FP_SCALE)
    ce_eq("count incremented by 1",        episodic_atom_count(ep), prior_count + 1)
    ce_eq("last_seen advanced",            episodic_atom_last_seen(ep), 60)
    // Posterior mean now > 0.5 because alpha > beta.
    ce_check("confidence rose above prior 500", episodic_atom_confidence(ep) > 500)
}

// ---- (A,B,X) where X != C: no match against {A,B,C} ----------------------

fn test_partial_match_rejected() {
    let stream = ms_new()
    let eas = episodic_atoms_new()
    let i = 0
    while i < 5 {
        capture(stream, i * 10, ids3(1, 2, 3))
        i = i + 1
    }
    episodic_consolidate(eas, stream, 0, 0)
    let ep = episodic_atoms_get(eas, 0)

    // (A=1, B=2, X=99): X is not a cluster member; the cluster requires
    // every member to be present in the observation, so the predicate is 0.
    ce_eq("X not a cluster member", episodic_match(ep, 99), 0)
    ce_eq("(A,B,X) misses C -> match_observation = 0",
        episodic_match_observation(ep, ids3(1, 2, 99)), 0)
    ce_eq("(A,B) misses C -> match_observation = 0",
        episodic_match_observation(ep, ids3(1, 2, 1)), 0)

    // Observe (A,B,X): episodic_observe does NOT update the {A,B,C} cluster
    // because the observation is not a superset of {1,2,3}.
    let prior_alpha = episodic_atom_alpha(ep)
    let updated = episodic_observe(eas, ids3(1, 2, 99), 100)
    ce_eq("partial observation updates 0 atoms", updated, 0)
    ce_eq("alpha unchanged",                     episodic_atom_alpha(ep), prior_alpha)
}

// ---- explicit Beta(alpha,beta) update ------------------------------------

fn test_update_belief() {
    let a = episodic_atom_new(0, ids3(1, 2, 3), 5, 0, 100, "p")
    // matched=1 -> alpha += FP_SCALE
    ce_eq("first match returns new alpha", episodic_update_belief(a, 1), BEL_PRIOR + FP_SCALE)
    ce_eq("second match returns new alpha", episodic_update_belief(a, 1), BEL_PRIOR + 2 * FP_SCALE)
    ce_eq("alpha == prior + 2*FP_SCALE",   episodic_atom_alpha(a), BEL_PRIOR + 2 * FP_SCALE)
    // matched=0 -> beta += FP_SCALE
    ce_eq("first contradict returns new beta", episodic_update_belief(a, 0), BEL_PRIOR + FP_SCALE)
    ce_eq("beta == prior + 1*FP_SCALE",        episodic_atom_beta(a), BEL_PRIOR + FP_SCALE)
    // Confidence: alpha / (alpha + beta) -- now > 0.5 because alpha > beta.
    ce_check("confidence > 500", episodic_atom_confidence(a) > 500)
}

// ---- find by signature ---------------------------------------------------

fn test_find_by_signature() {
    let eas = episodic_atoms_new()
    episodic_atoms_mint(eas, ids3(7, 11, 13), 5, 0, 100, "p")
    let found = episodic_atoms_find(eas, "7,11,13")
    ce_check("found cluster by signature", found != 0)
    ce_eq("found atom id", episodic_atom_id(found), 0)
    let missing = episodic_atoms_find(eas, "1,2,3")
    ce_eq("missing cluster returns 0", missing, 0)
}

// ---- re-consolidate does not duplicate -----------------------------------

fn test_reconsolidate_no_duplicate() {
    let stream = ms_new()
    let eas = episodic_atoms_new()
    let i = 0
    while i < 5 {
        capture(stream, i * 10, ids3(1, 2, 3))
        i = i + 1
    }
    let m1 = episodic_consolidate(eas, stream, 0, 0)
    ce_eq("first pass mints 1", m1, 1)
    // Second pass over the same stream: signature already exists -> no mint.
    let m2 = episodic_consolidate(eas, stream, 0, 0)
    ce_eq("second pass mints 0", m2, 0)
    ce_eq("store still has 1 atom", episodic_atoms_count(eas), 1)
    // But the existing atom's count is bumped (it folds the new evidence in).
    let ep = episodic_atoms_get(eas, 0)
    ce_check("count grew on re-consolidation", episodic_atom_count(ep) > 5)
}

// ---- snapshot round-trip -------------------------------------------------

fn _wrap_for_text(blob) {
    let s = snap_new(1, 100)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 0)
    push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    snap_put_section(s, SEC_EPISODIC, blob)
    return s
}

fn test_round_trip_snapshot() {
    let stream = ms_new()
    let em = em_new()
    let eas = episodic_atoms_new()
    // Mint a cluster.
    let i = 0
    while i < 5 {
        capture(stream, i * 10, ids3(1, 2, 3))
        em_record(em, i, 600, i * 10)
        i = i + 1
    }
    episodic_consolidate(eas, stream, 0, 0)
    ce_eq("one atom minted pre-round-trip", episodic_atoms_count(eas), 1)
    // Bump belief so the round-trip carries non-default alpha/beta.
    episodic_observe(eas, ids3(1, 2, 3), 60)
    let ep_pre = episodic_atoms_get(eas, 0)
    let pre_alpha = episodic_atom_alpha(ep_pre)
    let pre_beta  = episodic_atom_beta(ep_pre)
    let pre_count = episodic_atom_count(ep_pre)
    let pre_first = episodic_atom_first_seen(ep_pre)
    let pre_last  = episodic_atom_last_seen(ep_pre)

    // Build blob WITH atoms, encode to text, reparse, apply onto fresh
    // subsystems. The new sub-block survives the round trip verbatim.
    let blob = episodic_section_build_with_atoms(stream, em, eas)
    ce_eq("blob has 3 sub-lists", len(blob), 3)
    ce_eq("blob[2] has 1 atom",   len(blob[2]), 1)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    ce_check("decoded snapshot valid", snap_valid(s2) == 1)
    let eb2 = snap_section(s2, SEC_EPISODIC)
    ce_eq("decoded blob has 3 sub-lists", len(eb2), 3)
    ce_eq("decoded atoms count is 1",     len(eb2[2]), 1)

    let stream2 = ms_new()
    let em2 = em_new()
    let eas2 = episodic_atoms_new()
    episodic_section_apply_with_atoms(stream2, em2, eas2, eb2)
    ce_eq("post-apply atom count is 1", episodic_atoms_count(eas2), 1)
    let ep_post = episodic_atoms_get(eas2, 0)
    ce_eq("members survive (len)", len(episodic_atom_members(ep_post)), 3)
    ce_eq("members[0] survives",   episodic_atom_members(ep_post)[0], 1)
    ce_eq("members[1] survives",   episodic_atom_members(ep_post)[1], 2)
    ce_eq("members[2] survives",   episodic_atom_members(ep_post)[2], 3)
    ce_eq("count survives",        episodic_atom_count(ep_post), pre_count)
    ce_eq("first_seen survives",   episodic_atom_first_seen(ep_post), pre_first)
    ce_eq("last_seen survives",    episodic_atom_last_seen(ep_post), pre_last)
    ce_eq("alpha survives",        episodic_atom_alpha(ep_post), pre_alpha)
    ce_eq("beta survives",         episodic_atom_beta(ep_post), pre_beta)
    ce_str_eq("provenance survives", episodic_atom_provenance(ep_post),
        EPISODIC_PROVENANCE_DEFAULT)
}

// ---- legacy 2-element blob still parses ----------------------------------

fn test_legacy_two_element_blob() {
    // Build the legacy 2-element blob (no episodic_atoms sub-list).
    let stream = ms_new()
    let em = em_new()
    capture(stream, 0, ids3(1, 2, 3))
    em_record(em, 0, 600, 0)
    let legacy_blob = list_new()
    let moments = list_new()
    let mrec = list_new()
    push(mrec, 0)       // ts
    push(mrec, MSTAT_PERCEIVED)
    push(mrec, 600)     // valence
    let atoms = list_new()
    push(atoms, 1) push(atoms, 2) push(atoms, 3)
    push(mrec, atoms)
    push(moments, mrec)
    push(legacy_blob, moments)
    push(legacy_blob, list_new())   // empty episodes

    let s = _wrap_for_text(legacy_blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    ce_check("legacy blob still valid",   snap_valid(s2) == 1)
    let eb2 = snap_section(s2, SEC_EPISODIC)
    // After this build the blob always carries the third sub-list (empty
    // when input had none); a NEW reader gets the consistent 3-sub-list
    // shape even for a "legacy" build.
    ce_check("decoded blob is 2 or 3 sub-lists", len(eb2) >= 2)
    // The third sub-list (if present) is empty.
    if len(eb2) >= 3 {
        ce_eq("legacy decoded has 0 atoms", len(eb2[2]), 0)
    }

    // Apply on a fresh subsystem; the moment survives, atoms count is 0.
    let stream2 = ms_new()
    let em2 = em_new()
    let eas2 = episodic_atoms_new()
    episodic_section_apply_with_atoms(stream2, em2, eas2, eb2)
    ce_eq("moment survives", ms_count(stream2), 1)
    ce_eq("no atoms",        episodic_atoms_count(eas2), 0)
}

fn main() {
    test_atom_shape()
    test_signature_canonical()
    test_consolidate_no_cooccurrence()
    test_consolidate_5_triplets()
    test_sixth_triplet_increments_alpha()
    test_partial_match_rejected()
    test_update_belief()
    test_find_by_signature()
    test_reconsolidate_no_duplicate()
    test_round_trip_snapshot()
    test_legacy_two_element_blob()
    ce_summary("episodic")
}

main()
