// Unit tests for src/parts/action/operand_builder.nova
//
// Verifies the Phase R3 (ADR-0109) operand synthesizer: one subtest per
// effector class, assertion on the exact tuple shape and operand bytes.
// TOOL and INTERNAL return empty lists (meta-dispatch / no-op); the five
// payload-bearing classes return `[path, content]`, `[url, canned]`,
// `[expr]`, `[service, request]` or `[out_path]` per the ADR's
// conventions table.
//
// Phase R4 (ADR-0112) adds a 6th `templates` arg. All existing subtests
// pass `0` for templates -- the fall-through path is byte-identical to
// pre-R4 (`templates == 0` short-circuits the probe). Two new subtests
// at the bottom exercise the template-hit path and the explicit
// templates=0 fall-through path (byte-identity canary).

import "../ce_test.nova"
import "../../src/parts/action/operand_builder.nova"
import "../../src/parts/action/goal_templates.nova"

// ---- FILE: ["/tmp/ce_goal_<id>.txt", goal_name] -------------------------
fn test_build_file_tuple() {
    let ops = operand_builder_build(EFF_CLASS_FILE, 0, 42, "write_a_note",
                                    "write_a_note", 0)
    ce_eq("file ops length", len(ops), 2)
    ce_str_eq("file path", ops[0], "/tmp/ce_goal_42.txt")
    ce_str_eq("file content", ops[1], "write_a_note")
}

// ---- HTTP: ["http://localhost/goal_<id>", "goal:" + goal_name] ---------
fn test_build_http_tuple() {
    let ops = operand_builder_build(EFF_CLASS_HTTP, 0, 7, "fetch_url",
                                    "fetch_url", 0)
    ce_eq("http ops length", len(ops), 2)
    ce_str_eq("http url", ops[0], "http://localhost/goal_7")
    ce_str_eq("http canned", ops[1], "goal:fetch_url")
}

// ---- CODE: ["1 + <id>"] -------------------------------------------------
fn test_build_code_tuple() {
    let ops = operand_builder_build(EFF_CLASS_CODE, 0, 3, "run_code",
                                    "run_code", 0)
    ce_eq("code ops length", len(ops), 1)
    ce_str_eq("code expr", ops[0], "1 + 3")
}

// ---- MCP: ["goal_svc", "req:" + goal_name] ------------------------------
fn test_build_mcp_tuple() {
    let ops = operand_builder_build(EFF_CLASS_MCP, 0, 11, "invoke_mcp",
                                    "invoke_mcp", 0)
    ce_eq("mcp ops length", len(ops), 2)
    ce_str_eq("mcp service", ops[0], "goal_svc")
    ce_str_eq("mcp request", ops[1], "req:invoke_mcp")
}

// ---- AUDIO: ["/tmp/ce_speech_goal_<id>.wav"] ----------------------------
fn test_build_audio_tuple() {
    let ops = operand_builder_build(EFF_CLASS_AUDIO, 0, 5, "synth_audio",
                                    "synth_audio", 0)
    ce_eq("audio ops length", len(ops), 1)
    ce_str_eq("audio out_path", ops[0], "/tmp/ce_speech_goal_5.wav")
}

// ---- TOOL: [] (meta-dispatch, resolved via in_effector_class) -----------
fn test_build_tool_empty() {
    let ops = operand_builder_build(EFF_CLASS_TOOL, 0, 1, "call_tool",
                                    "call_tool", 0)
    ce_eq("tool ops empty", len(ops), 0)
}

// ---- INTERNAL: [] (no-op) -----------------------------------------------
fn test_build_internal_empty() {
    let ops = operand_builder_build(EFF_CLASS_INTERNAL, 0, 1, "nothing",
                                    "nothing", 0)
    ce_eq("internal ops empty", len(ops), 0)
}

// ---- goal_name="" fallback: FILE still produces path, content = "" -----
//
// Defensive subtest: when no goal engine is wired the derive path passes
// `""` for goal_name. The FILE tuple's content slot is then empty but the
// path still carries the goal id -- confirms the builder tolerates the
// zero-name case rather than returning a shorter tuple. Not counted in
// the "7 subtests" roster; added as a robustness guard.
fn test_build_file_empty_name() {
    let ops = operand_builder_build(EFF_CLASS_FILE, 0, 0, "write_a_note", "", 0)
    ce_eq("file empty-name ops length", len(ops), 2)
    ce_str_eq("file empty-name path", ops[0], "/tmp/ce_goal_0.txt")
    ce_str_eq("file empty-name content", ops[1], "")
}

// ---- Phase R4: template hit expands %ID% / %NAME% (ADR-0112) -----------
//
// Seed a `goal_templates_default()` registry (carries the FILE +
// CODE seeds). Call `operand_builder_build` with EFF_CLASS_FILE and
// goal_name="write_a_note" and the registry handle as the 6th arg --
// the template `["file", "/tmp/ce_note_%ID%.txt", "%NAME%"]` matches,
// its eff_class tag is stripped, and `%ID%` / `%NAME%` are substituted.
fn test_operand_builder_uses_template_when_present() {
    let gt = goal_templates_default()
    let ops = operand_builder_build(EFF_CLASS_FILE, 0, 7, "write_a_note",
                                    "write_a_note", gt)
    ce_eq("template-hit ops length", len(ops), 2)
    ce_str_eq("template-hit path (R4 template, NOT R3 convention)",
              ops[0], "/tmp/ce_note_7.txt")
    ce_str_eq("template-hit content (NAME substituted)",
              ops[1], "write_a_note")
    // Confirm the CODE seed also fires.
    let ops2 = operand_builder_build(EFF_CLASS_CODE, 0, 7, "run_code",
                                     "run_code", gt)
    ce_eq("template-hit CODE ops length", len(ops2), 1)
    ce_str_eq("template-hit CODE expr", ops2[0], "1 + 7")
}

// ---- Phase R4: templates=0 falls back to R3 convention (byte-identity) -
//
// The explicit byte-identity canary. The output must be byte-identical
// to the pre-R4 FILE/CODE results. Any divergence breaks the R3 contract.
fn test_operand_builder_falls_back_to_convention_when_templates_zero() {
    let ops_file = operand_builder_build(EFF_CLASS_FILE, 0, 7,
                                         "write_a_note", "write_a_note", 0)
    ce_eq("fallback FILE ops length", len(ops_file), 2)
    ce_str_eq("fallback FILE path (R3 convention)",
              ops_file[0], "/tmp/ce_goal_7.txt")
    ce_str_eq("fallback FILE content (R3 convention)",
              ops_file[1], "write_a_note")
    let ops_code = operand_builder_build(EFF_CLASS_CODE, 0, 7,
                                         "run_code", "run_code", 0)
    ce_eq("fallback CODE ops length", len(ops_code), 1)
    ce_str_eq("fallback CODE expr (R3 convention)",
              ops_code[0], "1 + 7")
    // Also: a template-registry MISS (unknown goal_name) still falls
    // through to R3 convention when templates is a seeded registry.
    let gt = goal_templates_default()
    let ops_miss = operand_builder_build(EFF_CLASS_HTTP, 0, 7,
                                         "fetch_url", "unknown_goal", gt)
    ce_eq("miss-fallback HTTP ops length", len(ops_miss), 2)
    ce_str_eq("miss-fallback HTTP url (R3 convention)",
              ops_miss[0], "http://localhost/goal_7")
}

// ---- Phase R5: planner fires when templates miss (ADR-0113) ------------
//
// Three-layer precedence: template registry (R4) -> planner (R5) ->
// R3 convention. If the template registry misses but a planner
// heuristic hits, the planner tuple wins over the R3 convention.
// Here: goal_name="fetch https://foo" misses the default registry
// (not seeded), triggers the HTTP planner heuristic, and emits the
// URL tail -- NOT the R3 `"http://localhost/goal_<id>"` convention.
fn test_operand_builder_uses_planner_when_templates_miss() {
    let gt = goal_templates_default()
    let ops = operand_builder_build(EFF_CLASS_HTTP, 0, 11,
                                    "fetch https://foo",
                                    "fetch https://foo", gt)
    ce_eq("planner-hit ops length", len(ops), 2)
    ce_str_eq("planner-hit url (R5 planner, NOT R3 convention)",
              ops[0], "https://foo")
    ce_str_eq("planner-hit canned empty", ops[1], "")
    // Also prove the planner runs when templates handle is 0.
    let ops2 = operand_builder_build(EFF_CLASS_FILE, 0, 3,
                                     "write note hi",
                                     "write note hi", 0)
    ce_eq("planner-hit (templates=0) ops length", len(ops2), 2)
    ce_str_eq("planner-hit (templates=0) path",
              ops2[0], "/tmp/ce_note_3.txt")
    ce_str_eq("planner-hit (templates=0) content",
              ops2[1], "hi")
}

// ---- Phase R5: both templates + planner miss -> R3 convention ---------
//
// A goal name that neither the registry nor any planner prefix matches
// still falls through to the R3 convention floor. Byte-identity canary
// for the templates+planner double-miss case.
fn test_operand_builder_falls_through_to_r3_when_both_miss() {
    let gt = goal_templates_default()
    let ops = operand_builder_build(EFF_CLASS_FILE, 0, 9, "xyz", "xyz", gt)
    ce_eq("double-miss FILE ops length", len(ops), 2)
    ce_str_eq("double-miss FILE path (R3 convention)",
              ops[0], "/tmp/ce_goal_9.txt")
    ce_str_eq("double-miss FILE content (R3 convention)",
              ops[1], "xyz")
    // CODE class: motor_map vocab "run_code" misses both R4 default
    // (not seeded for this goal_name under templates=0) and R5 planner
    // (no trailing space), so falls through to R3 convention.
    let ops2 = operand_builder_build(EFF_CLASS_CODE, 0, 9,
                                     "run_code", "run_code", 0)
    ce_eq("double-miss CODE ops length", len(ops2), 1)
    ce_str_eq("double-miss CODE expr (R3 convention)", ops2[0], "1 + 9")
}

fn main() {
    test_build_file_tuple()
    test_build_http_tuple()
    test_build_code_tuple()
    test_build_mcp_tuple()
    test_build_audio_tuple()
    test_build_tool_empty()
    test_build_internal_empty()
    test_build_file_empty_name()
    test_operand_builder_uses_template_when_present()
    test_operand_builder_falls_back_to_convention_when_templates_zero()
    test_operand_builder_uses_planner_when_templates_miss()
    test_operand_builder_falls_through_to_r3_when_both_miss()
    ce_summary("operand_builder")
}
main()
