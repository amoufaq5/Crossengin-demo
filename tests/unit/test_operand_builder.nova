// Unit tests for src/parts/action/operand_builder.nova
//
// Verifies the Phase R3 (ADR-0109) operand synthesizer: one subtest per
// effector class, assertion on the exact tuple shape and operand bytes.
// TOOL and INTERNAL return empty lists (meta-dispatch / no-op); the five
// payload-bearing classes return `[path, content]`, `[url, canned]`,
// `[expr]`, `[service, request]` or `[out_path]` per the ADR's
// conventions table.

import "../ce_test.nova"
import "../../src/parts/action/operand_builder.nova"

// ---- FILE: ["/tmp/ce_goal_<id>.txt", goal_name] -------------------------
fn test_build_file_tuple() {
    let ops = operand_builder_build(EFF_CLASS_FILE, 0, 42, "write_a_note",
                                    "write_a_note")
    ce_eq("file ops length", len(ops), 2)
    ce_str_eq("file path", ops[0], "/tmp/ce_goal_42.txt")
    ce_str_eq("file content", ops[1], "write_a_note")
}

// ---- HTTP: ["http://localhost/goal_<id>", "goal:" + goal_name] ---------
fn test_build_http_tuple() {
    let ops = operand_builder_build(EFF_CLASS_HTTP, 0, 7, "fetch_url",
                                    "fetch_url")
    ce_eq("http ops length", len(ops), 2)
    ce_str_eq("http url", ops[0], "http://localhost/goal_7")
    ce_str_eq("http canned", ops[1], "goal:fetch_url")
}

// ---- CODE: ["1 + <id>"] -------------------------------------------------
fn test_build_code_tuple() {
    let ops = operand_builder_build(EFF_CLASS_CODE, 0, 3, "run_code",
                                    "run_code")
    ce_eq("code ops length", len(ops), 1)
    ce_str_eq("code expr", ops[0], "1 + 3")
}

// ---- MCP: ["goal_svc", "req:" + goal_name] ------------------------------
fn test_build_mcp_tuple() {
    let ops = operand_builder_build(EFF_CLASS_MCP, 0, 11, "invoke_mcp",
                                    "invoke_mcp")
    ce_eq("mcp ops length", len(ops), 2)
    ce_str_eq("mcp service", ops[0], "goal_svc")
    ce_str_eq("mcp request", ops[1], "req:invoke_mcp")
}

// ---- AUDIO: ["/tmp/ce_speech_goal_<id>.wav"] ----------------------------
fn test_build_audio_tuple() {
    let ops = operand_builder_build(EFF_CLASS_AUDIO, 0, 5, "synth_audio",
                                    "synth_audio")
    ce_eq("audio ops length", len(ops), 1)
    ce_str_eq("audio out_path", ops[0], "/tmp/ce_speech_goal_5.wav")
}

// ---- TOOL: [] (meta-dispatch, resolved via in_effector_class) -----------
fn test_build_tool_empty() {
    let ops = operand_builder_build(EFF_CLASS_TOOL, 0, 1, "call_tool",
                                    "call_tool")
    ce_eq("tool ops empty", len(ops), 0)
}

// ---- INTERNAL: [] (no-op) -----------------------------------------------
fn test_build_internal_empty() {
    let ops = operand_builder_build(EFF_CLASS_INTERNAL, 0, 1, "nothing",
                                    "nothing")
    ce_eq("internal ops empty", len(ops), 0)
}

// ---- goal_name="" fallback: FILE still produces path, content = "" -----
//
// Defensive subtest: when no goal engine is wired the derive path passes
// `""` for goal_name. The FILE tuple's content slot is then empty but the
// path still carries the goal id -- confirms the builder tolerates the
// zero-name case rather than returning a shorter tuple. Not counted in
// the "7 subtests" roster; added as a robustness guard.
fn test_build_file_empty_name() {
    let ops = operand_builder_build(EFF_CLASS_FILE, 0, 0, "write_a_note", "")
    ce_eq("file empty-name ops length", len(ops), 2)
    ce_str_eq("file empty-name path", ops[0], "/tmp/ce_goal_0.txt")
    ce_str_eq("file empty-name content", ops[1], "")
}

fn main() {
    test_build_file_tuple()
    test_build_http_tuple()
    test_build_code_tuple()
    test_build_mcp_tuple()
    test_build_audio_tuple()
    test_build_tool_empty()
    test_build_internal_empty()
    test_build_file_empty_name()
    ce_summary("operand_builder")
}
main()
