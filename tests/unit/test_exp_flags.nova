// Unit tests for B2 (E1 ablation flags): src/exp/exp_flags.nova, the
// tick driver's clock-only engine slot, and the two router-level flags
// (CE_ABL_SYNW, CE_ABL_BETA). Each ablation test also checks the flag-off
// control so a flag that does nothing would fail.

import "../ce_test.nova"
import "../../src/exp/exp_flags.nova"
import "../../src/agent/cognitive_router.nova"
import "../../src/substrate/tick_driver.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn test_defaults_off() {
    exp_flags_reset()
    let i = 0
    let any = 0
    while i < ABL_COUNT {
        if abl_on(i) == 1 { any = 1 }
        i = i + 1
    }
    ce_eq("all ablations off by default", any, 0)
    ce_eq("trace off by default", exp_trace_on(), 0)
    ce_check("csv empty by default", str_eq_bytes(exp_flags_csv(), "") == 1)
    ce_eq("out-of-range index is off", abl_on(ABL_COUNT), 0)
    ce_eq("negative index is off", abl_on(0 - 1), 0)
}

fn test_env_value_rule() {
    ce_eq("unset (0) is off", exp_env_value_on(0), 0)
    ce_eq("empty is off", exp_env_value_on(""), 0)
    ce_eq("0 is off", exp_env_value_on("0"), 0)
    ce_eq("1 is on", exp_env_value_on("1"), 1)
    ce_eq("true is off (only 1 counts)", exp_env_value_on("true"), 0)
    ce_eq("10 is off", exp_env_value_on("10"), 0)
}

fn test_names_and_csv() {
    exp_flags_reset()
    ce_check("env name ff", str_eq_bytes(abl_env_name(ABL_FF), "CE_ABL_FF") == 1)
    ce_check("env name substrate", str_eq_bytes(abl_env_name(ABL_SUBSTRATE), "CE_ABL_SUBSTRATE") == 1)
    ce_check("env name beta", str_eq_bytes(abl_env_name(ABL_BETA), "CE_ABL_BETA") == 1)
    exp_set_abl(ABL_PC, 1)
    exp_set_abl(ABL_FF, 1)
    exp_set_abl(ABL_SYNW, 1)
    ce_check("csv lists on flags in index order", str_eq_bytes(exp_flags_csv(), "ff,pc,synw") == 1)
    exp_set_abl(ABL_PC, 0)
    ce_check("csv after clearing pc", str_eq_bytes(exp_flags_csv(), "ff,synw") == 1)
    exp_set_trace(1)
    ce_eq("trace settable", exp_trace_on(), 1)
    exp_flags_reset()
    ce_eq("reset clears trace", exp_trace_on(), 0)
    ce_eq("reset clears flags", abl_on(ABL_FF), 0)
}

// ---- CE_ABL_SUBSTRATE: clock-only engine ----------------------------------

fn _one_part_reg() {
    let reg = part_registry_new()
    registry_add(reg, "t", FN_PRESET_REASONING, 16, 4)
    return reg
}

fn test_clock_only_engine() {
    // Control: a normal engine fires a stimulated node and potentiates a
    // co-active synapse.
    let reg0 = _one_part_reg()
    let part0 = registry_get(reg0, 0)
    let pool0 = part_pool(part0)
    let g0 = part_syn(part0)
    let s0 = syn_new(g0, 0, 1, 100, 0)
    npm_set_activation(pool0, 0, 600)
    npm_set_activation(pool0, 1, 600)
    let e0 = td_engine_new(reg0)
    ce_eq("control: clock-only off by default", td_clock_only(e0), 0)
    let f0 = td_fired_total()
    ce_eq("control: two nodes fire", td_step(e0, TD_MOD_NEUTRAL, 0), 2)
    ce_eq("control: fired counter +2", td_fired_total() - f0, 2)
    ce_eq("control: synapse potentiated", syn_weight(g0, s0), 107)

    // Clock-only: same setup, nothing fires or learns, the clock advances.
    let reg = _one_part_reg()
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)
    let s = syn_new(g, 0, 1, 100, 0)
    npm_set_activation(pool, 0, 600)
    npm_set_activation(pool, 1, 600)
    let e = td_engine_new(reg)
    td_set_clock_only(e, 1)
    let f1 = td_fired_total()
    ce_eq("clock-only: no node fires", td_step(e, TD_MOD_NEUTRAL, 0), 0)
    ce_eq("clock-only: fired counter unchanged", td_fired_total() - f1, 0)
    ce_eq("clock-only: clock advanced", td_now(e), 1)
    ce_eq("clock-only: node 0 never fired", npm_last_fired(pool, 0), 0 - 1)
    ce_eq("clock-only: synapse unchanged", syn_weight(g, s), 100)
    ce_eq("clock-only: run fires nothing", td_run(e, 4, TD_MOD_NEUTRAL, 0), 0)
    ce_eq("clock-only: clock at 5", td_now(e), 5)
    ce_eq("clock-only: step_part fires nothing", td_step_part(e, 0, TD_MOD_NEUTRAL, 0), 0)
    ce_eq("clock-only: 3f step fires nothing", td_step_3f(e, TD_MOD_NEUTRAL, 0, 0, 0, 0), 0)
    ce_eq("clock-only: part 3f step fires nothing", td_step_part_3f(e, 0, TD_MOD_NEUTRAL, 0, 0, 0, 0), 0)
    ce_eq("clock-only: clock at 8", td_now(e), 8)
    td_set_clock_only(e, 0)
    ce_eq("turned back off", td_clock_only(e), 0)
}

// ---- CE_ABL_SYNW / CE_ABL_BETA: router -------------------------------------

// morning(0) -> breakfast(1) and morning(0) -> coffee(2), equal confidence.
// On a tie the FIRST operator (breakfast) wins; a router-table weight on
// morning->coffee flips the choice unless CE_ABL_SYNW is on.
fn _fork_kg() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    kg_add_atom(rkg, ATOM_CONCEPT, "morning", 0)     // 0
    kg_add_atom(rkg, ATOM_CONCEPT, "breakfast", 0)   // 1
    kg_add_atom(rkg, ATOM_CONCEPT, "coffee", 0)      // 2
    rop_new(rkg, ROP_CAUSAL, 0, 1, "morning->breakfast", 0)
    rop_new(rkg, ROP_CAUSAL, 0, 2, "morning->coffee", 0)
    return rkg
}

fn _lang() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_intern(lang, "morning", 0)
    return lang
}

fn _percept0() {
    let p = list_new()
    let e = list_new() push(e, "tok") push(e, 0)
    push(p, e)
    return p
}

fn _trace_has(r, needle) {
    if find_bytes(rr_trace(r), needle) >= 0 { return 1 }
    return 0
}

fn test_synw_ablation() {
    exp_flags_reset()
    let kg = _fork_kg()
    let lang = _lang()
    let g = syn_graph_new()
    syn_new(g, 0, 2, 500, 0)          // reinforced morning->coffee
    cr_set_syn_g(g)
    let r = router_reply(CAT_ACADEMIC, "why morning", kg, lang, _percept0(), 0)
    ce_eq("control: table weight picks coffee", _trace_has(r, "morning->coffee"), 1)
    exp_set_abl(ABL_SYNW, 1)
    let r2 = router_reply(CAT_ACADEMIC, "why morning", kg, lang, _percept0(), 0)
    ce_eq("synw off: tie goes to breakfast", _trace_has(r2, "morning->breakfast"), 1)
    ce_eq("synw off: weight unchanged", syn_weight(g, syn_find(g, 0, 2)), 500)
    cr_set_syn_g(0)
    exp_flags_reset()
}

fn test_beta_ablation() {
    exp_flags_reset()
    let kg = _fork_kg()
    let lang = _lang()
    let g = syn_graph_new()
    cr_set_syn_g(g)
    let r = router_reply(CAT_ACADEMIC, "why morning", kg, lang, _percept0(), 0)
    let ops = rr_ops(r)
    let op = kg_atom(kg, str_to_int(str_trim(split_char(ops, 44)[0])))
    let c0 = rop_confidence(op)
    router_apply_feedback(kg, ops, 1)
    let c1 = rop_confidence(op)
    ce_check("control: /good raises confidence", c1 > c0)
    let w1 = syn_weight(g, syn_find(g, rop_premise(op), rop_conclusion(op)))
    exp_set_abl(ABL_BETA, 1)
    router_apply_feedback(kg, ops, 1)
    ce_eq("beta off: confidence unchanged", rop_confidence(op), c1)
    let w2 = syn_weight(g, syn_find(g, rop_premise(op), rop_conclusion(op)))
    ce_eq("beta off: table weight still +100", w2, w1 + 100)
    cr_set_syn_g(0)
    exp_flags_reset()
}

fn main() {
    test_defaults_off()
    test_env_value_rule()
    test_names_and_csv()
    test_clock_only_engine()
    test_synw_ablation()
    test_beta_ablation()
    ce_summary("exp_flags")
}
main()
