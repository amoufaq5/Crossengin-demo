// Unit tests for src/seed/pack_registry.nova.
// Verifies the registry surface: pack_list returns the 3 entries the brief
// promises, pack_install dispatches to each pack and reports atom + operator
// counts, idempotency (canary check) short-circuits a second install on the
// same KG, --reset / force=1 bypasses the canary, and unknown packs return a
// clean error status. P1.9.

import "../ce_test.nova"
import "../../src/seed/pack_registry.nova"
// imagination_kg_init (used in _setup) lives here and is NOT in the registry's
// import chain; without this NOVA silently compiles a call to a garbage address
// and the test segfaults at runtime (same class as ADR-0064).
import "../../src/parts/imagination/imagination_engine.nova"

fn _setup() {
    let reg = kg_registry_new()
    let env = list_new()
    push(env, reasoning_kg_init(reg))
    push(env, lang_kg_init(reg))
    push(env, imagination_kg_init(reg))
    push(env, mo_new())
    return env
}

fn test_pack_list_three_entries() {
    let packs = pack_list()
    ce_eq("pack_list returns 3 packs", len(packs), 3)
    // Entries are [name, description, atom_count_estimate].
    let names = list_new()
    let i = 0
    while i < len(packs) {
        push(names, pack_entry_name(packs[i]))
        i = i + 1
    }
    ce_str_eq("first pack is medical", names[0], "medical")
    ce_str_eq("second pack is ops_runbook", names[1], "ops_runbook")
    ce_str_eq("third pack is code_review", names[2], "code_review")
}

fn test_pack_list_descriptions() {
    let packs = pack_list()
    let i = 0
    while i < len(packs) {
        let desc = pack_entry_description(packs[i])
        ce_check("pack " + int_to_str(i) + " has a description", len(desc) > 0)
        ce_check("pack " + int_to_str(i) + " atom count > 0",
                 pack_entry_atom_count(packs[i]) > 0)
        i = i + 1
    }
}

fn test_install_medical_fresh_kg() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let before = kg_atom_count(kg)
    let r = pack_install("medical", lang, kg, ikg, mo, 0)
    ce_eq("install status is ok",
          1, str_eq(r[2], "ok"))
    ce_check("medical install produces >= 30 atoms", r[0] >= 30)
    ce_check("medical install produces >= 5 operators", r[1] >= 5)
    let after = kg_atom_count(kg)
    ce_check("KG grew (operators are atoms too)", after > before)
    // Spot-check that the canary atom is now present.
    ce_check("medical canary 'antibiotic' present", kg_find_atom(kg, "antibiotic") != 0)
}

fn test_idempotent_install_short_circuits() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install("medical", lang, kg, ikg, mo, 0)
    let count_after_first = kg_atom_count(kg)
    let r2 = pack_install("medical", lang, kg, ikg, mo, 0)
    ce_eq("second install reports 'already'", 1, str_eq(r2[2], "already"))
    ce_eq("second install adds 0 atoms", r2[0], 0)
    ce_eq("second install adds 0 operators", r2[1], 0)
    // KG count must not have grown (the install short-circuited).
    ce_eq("KG count unchanged on second install",
          kg_atom_count(kg), count_after_first)
}

fn test_force_reset_bypasses_canary() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install("medical", lang, kg, ikg, mo, 0)
    // force=1 bypasses the canary check and re-runs au_ingest; the underlying
    // au_ingest is itself idempotent on label, so the KG count must not grow
    // but the status must be "ok" (the install ran) and operator count
    // matches the install path.
    let r2 = pack_install_with_force("medical", lang, kg, ikg, mo, 1, 0)
    ce_eq("--reset install reports 'ok'", 1, str_eq(r2[2], "ok"))
}

fn test_install_ops_pack() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let r = pack_install("ops_runbook", lang, kg, ikg, mo, 0)
    ce_eq("ops_runbook install ok", 1, str_eq(r[2], "ok"))
    ce_check("ops pack canary 'service' present",
             kg_find_atom(kg, "service") != 0)
}

fn test_install_code_review_pack() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let r = pack_install("code_review", lang, kg, ikg, mo, 0)
    ce_eq("code_review install ok", 1, str_eq(r[2], "ok"))
    ce_check("code_review canary 'refactor' present",
             kg_find_atom(kg, "refactor") != 0)
}

fn test_install_unknown_pack() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let r = pack_install("nonesuch", lang, kg, ikg, mo, 0)
    ce_eq("unknown pack status 'unknown'", 1, str_eq(r[2], "unknown"))
    ce_eq("unknown pack atoms=0", r[0], 0)
    ce_eq("unknown pack ops=0", r[1], 0)
}

fn test_pack_already_installed_unknown() {
    let env = _setup()
    let kg = env[0]
    // Never-installed unknown pack -> not "already installed".
    ce_eq("unknown pack not already_installed",
          pack_already_installed(kg, "nonesuch"), 0)
}

fn test_install_fresh_vs_populated() {
    // Same call on a fresh KG and on a populated KG: the populated case
    // should hit the idempotency short-circuit while the fresh case
    // installs cleanly. Verifies _pack_canary_label + pack_already_installed
    // dispatch on label name, not on identity of the KG.
    let env_a = _setup()
    let kg_a = env_a[0]; let lang_a = env_a[1]; let ikg_a = env_a[2]; let mo_a = env_a[3]
    let env_b = _setup()
    let kg_b = env_b[0]; let lang_b = env_b[1]; let ikg_b = env_b[2]; let mo_b = env_b[3]
    let r_a = pack_install("medical", lang_a, kg_a, ikg_a, mo_a, 0)
    // Now also install into b (fresh), then call again -> already.
    let r_b1 = pack_install("medical", lang_b, kg_b, ikg_b, mo_b, 0)
    let r_b2 = pack_install("medical", lang_b, kg_b, ikg_b, mo_b, 0)
    ce_eq("fresh KG A install ok", 1, str_eq(r_a[2], "ok"))
    ce_eq("fresh KG B install ok", 1, str_eq(r_b1[2], "ok"))
    ce_eq("populated KG B second install short-circuits",
          1, str_eq(r_b2[2], "already"))
}

fn main() {
    test_pack_list_three_entries()
    test_pack_list_descriptions()
    test_install_medical_fresh_kg()
    test_idempotent_install_short_circuits()
    test_force_reset_bypasses_canary()
    test_install_ops_pack()
    test_install_code_review_pack()
    test_install_unknown_pack()
    test_pack_already_installed_unknown()
    test_install_fresh_vs_populated()
    ce_summary("pack_registry")
}
main()
