// Unit tests for src/learning/ask_user_to_teach.nova
// Verifies the ask budget (one unsolicited question per window), gating,
// question templates, and ingestion of a user answer as Beta(4,1) user-taught
// evidence (with re-teach strengthening and a linked word). ADR-0027.

import "../ce_test.nova"
import "../../src/learning/ask_user_to_teach.nova"

fn test_budget() {
    let b = au_budget_new()
    ce_eq("fresh can ask", au_can_ask(b, 0), 1)
    au_record_ask(b, 0)
    ce_eq("within window cannot ask again", au_can_ask(b, 100), 0)
    ce_eq("after window can ask", au_can_ask(b, 700), 1)
}

fn test_gating() {
    let b = au_budget_new()
    // Fetchable gaps are not asked (prefer fetch).
    ce_eq("fetchable -> no ask", au_should_ask(1, 1, 0, b, 0), 0)
    // Non-fetchable and blocks the response -> ask.
    ce_eq("non-fetchable blocking -> ask", au_should_ask(0, 1, 900, b, 0), 1)
    // Non-fetchable, not blocking, but very low competence -> ask.
    ce_eq("low competence -> ask", au_should_ask(0, 0, 100, b, 0), 1)
    // Non-fetchable, not blocking, adequate competence -> no ask.
    ce_eq("adequate competence -> no ask", au_should_ask(0, 0, 600, b, 0), 0)
    // Budget exhausted -> no ask even when warranted.
    au_record_ask(b, 0)
    ce_eq("budget exhausted -> no ask", au_should_ask(0, 1, 0, b, 10), 0)
}

fn test_question() {
    ce_check("explicit prompt mentions topic", contains_substr_ok())
    ce_str_eq("inline prompt", au_question("dosage", TEACH_INLINE), "I answered based on dosage. Is that what you meant?")
}

fn contains_substr_ok() {
    let q = au_question("penicillin", TEACH_EXPLICIT)
    if str_find(q, "penicillin") >= 0 { return 1 }
    return 0
}

fn test_ingest() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let a = au_ingest(lang, med, "penicillin", "an antibiotic", 5)
    ce_check("atom created", a != 0)
    ce_eq("fact atom", atom_kind(a), ATOM_FACT)
    // Beta(4,1) -> mean 0.8.
    ce_eq("user-taught confidence", atom_confidence(a), 800)
    ce_eq("provenance user_taught", au_is_user_taught(a), 1)
    ce_str_eq("answer stored", atom_payload_get(a, "taught"), "an antibiotic")
    // The target word was interned and linked.
    let w = word_find(lang, "penicillin")
    ce_check("word interned", w != 0)
    ce_eq("word linked to atom", word_sense_count(w), 1)
    // Re-teaching strengthens the existing atom (no duplicate).
    let a2 = au_ingest(lang, med, "penicillin", "an antibiotic", 6)
    ce_eq("no duplicate atom", atom_id(a2), atom_id(a))
    ce_check("re-teach strengthens", atom_confidence(a2) > 800)
}

fn main() {
    test_budget()
    test_gating()
    test_question()
    test_ingest()
    ce_summary("ask_user_to_teach")
}

main()
