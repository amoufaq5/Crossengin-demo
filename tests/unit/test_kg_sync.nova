// Unit tests for src/io/transducers/kg_sync.nova
// Exercises the pure protocol helpers (format / parse / strip / split /
// digits / labels / IP / token / promote / atrophy / delete / merge).
// Sockets are NOT touched here -- the live cross-process flow lives in
// tests/integration/scenario_g_kg_sync.sh (v1 single-sub demo) and
// tests/integration/scenario_g2_kg_sync_multi.sh (v2 N-sub + bidir +
// reconnect + auth + conflict). Keeping the protocol pure-by-design is
// what lets it be exercised here without flakiness.

import "../ce_test.nova"
import "../../src/io/transducers/kg_sync.nova"
import "../../src/kg/multi_kg_manager.nova"

// ---- format -------------------------------------------------------------

fn test_format_basic() {
    let s = _format_atom_line("lang", 42, 1, 800, 200, "widget")
    ce_str_eq("format basic", s, "ATOM lang 42 1 800 200 widget\n")
}

fn test_format_label_dashes_underscores() {
    let s = _format_atom_line("language", 7, 3, 1000, 1000, "self-aware_state")
    ce_str_eq("format with - and _", s, "ATOM language 7 3 1000 1000 self-aware_state\n")
}

fn test_format_zero_alpha_beta() {
    let s = _format_atom_line("kg", 0, 1, 0, 0, "x")
    ce_str_eq("format zeros", s, "ATOM kg 0 1 0 0 x\n")
}

fn test_format_pub() {
    let s = _format_pub_line("lang", 5, 3, 1000, 1000, "widget")
    ce_str_eq("format PUB", s, "PUB lang 5 3 1000 1000 widget\n")
}

fn test_format_promote() {
    let s = _format_promote_line("lang", 7, 1800, 200)
    ce_str_eq("format PROMOTE", s, "PROMOTE lang 7 1800 200\n")
}

fn test_format_atrophy() {
    let s = _format_atrophy_line("lang", 11)
    ce_str_eq("format ATROPHY", s, "ATROPHY lang 11\n")
}

fn test_format_delete() {
    let s = _format_delete_line("lang", 42)
    ce_str_eq("format DELETE", s, "DELETE lang 42\n")
}

// ---- parse --------------------------------------------------------------

fn test_parse_basic() {
    let r = _parse_atom_line("ATOM lang 42 1 800 200 widget")
    ce_check("parse basic non-zero", r != 0)
    ce_eq("parsed type",      r[KGSYNC_R_TYPE],  KGSYNC_EV_ATOM)
    ce_str_eq("parsed kg",    r[KGSYNC_R_KG],    "lang")
    ce_eq("parsed id",        r[KGSYNC_R_ID],    42)
    ce_eq("parsed kind",      r[KGSYNC_R_KIND],  1)
    ce_eq("parsed alpha",     r[KGSYNC_R_ALPHA], 800)
    ce_eq("parsed beta",      r[KGSYNC_R_BETA],  200)
    ce_str_eq("parsed label", r[KGSYNC_R_LABEL], "widget")
}

fn test_parse_with_trailing_newline() {
    let r = _parse_atom_line("ATOM lang 42 1 800 200 widget\n")
    ce_check("parse \\n-terminated non-zero", r != 0)
    ce_str_eq("parsed \\n label", r[KGSYNC_R_LABEL], "widget")
}

fn test_parse_with_crlf() {
    let r = _parse_atom_line("ATOM lang 42 1 800 200 widget\r\n")
    ce_check("parse CRLF non-zero", r != 0)
    ce_str_eq("parsed CRLF label", r[KGSYNC_R_LABEL], "widget")
}

fn test_parse_label_punctuation() {
    let r = _parse_atom_line("ATOM language 7 3 1000 1000 self-aware_state")
    ce_check("parse - + _", r != 0)
    ce_str_eq("parsed - + _ label", r[KGSYNC_R_LABEL], "self-aware_state")
    ce_str_eq("parsed - + _ kg", r[KGSYNC_R_KG], "language")
}

// ---- parse: malformed inputs --------------------------------------------

fn test_parse_rejects_short_line() {
    ce_eq("empty",        _parse_atom_line(""),       0)
    ce_eq("just prefix",  _parse_atom_line("ATOM"),   0)
    ce_eq("missing label", _parse_atom_line("ATOM lang 1 1 0 0"), 0)
}

fn test_parse_rejects_wrong_op() {
    ce_eq("BYE line",  _parse_atom_line("BYE"),        0)
    ce_eq("ACK line",  _parse_atom_line("ACK 42"),     0)
    ce_eq("hello",     _parse_atom_line("HELLO ce-kg-sync v1"), 0)
}

fn test_parse_rejects_non_numeric_fields() {
    ce_eq("id non-numeric",    _parse_atom_line("ATOM lang x 1 0 0 w"),   0)
    ce_eq("kind non-numeric",  _parse_atom_line("ATOM lang 1 a 0 0 w"),   0)
    ce_eq("alpha non-numeric", _parse_atom_line("ATOM lang 1 1 a 0 w"),   0)
    ce_eq("beta non-numeric",  _parse_atom_line("ATOM lang 1 1 0 a w"),   0)
}

fn test_parse_rejects_illegal_label_chars() {
    ce_eq("extra-space label", _parse_atom_line("ATOM lang 1 1 0 0 foo bar"), 0)
    ce_eq("dot in label",      _parse_atom_line("ATOM lang 1 1 0 0 foo.bar"), 0)
    ce_eq("slash in kg label", _parse_atom_line("ATOM la/ng 1 1 0 0 foo"),    0)
}

// ---- parse: v2 new event kinds ------------------------------------------

fn test_parse_pub_line() {
    let r = _parse_pub_line("PUB lang 5 3 1000 1000 widget")
    ce_check("parse PUB non-zero", r != 0)
    ce_eq("PUB type",      r[KGSYNC_R_TYPE],  KGSYNC_EV_PUB)
    ce_str_eq("PUB kg",    r[KGSYNC_R_KG],    "lang")
    ce_eq("PUB id",        r[KGSYNC_R_ID],    5)
    ce_eq("PUB kind",      r[KGSYNC_R_KIND],  3)
    ce_eq("PUB alpha",     r[KGSYNC_R_ALPHA], 1000)
    ce_eq("PUB beta",      r[KGSYNC_R_BETA],  1000)
    ce_str_eq("PUB label", r[KGSYNC_R_LABEL], "widget")
}

fn test_parse_pub_rejects_atom_prefix() {
    ce_eq("PUB parser rejects ATOM line",
          _parse_pub_line("ATOM lang 5 3 1000 1000 widget"), 0)
}

fn test_parse_promote_line() {
    let r = _parse_promote_line("PROMOTE lang 7 1800 200")
    ce_check("parse PROMOTE non-zero", r != 0)
    ce_eq("PROMOTE type",   r[KGSYNC_R_TYPE],  KGSYNC_EV_PROMOTE)
    ce_str_eq("PROMOTE kg", r[KGSYNC_R_KG],    "lang")
    ce_eq("PROMOTE id",     r[KGSYNC_R_ID],    7)
    ce_eq("PROMOTE alpha",  r[KGSYNC_P_ALPHA], 1800)
    ce_eq("PROMOTE beta",   r[KGSYNC_P_BETA],  200)
}

fn test_parse_promote_with_crlf() {
    let r = _parse_promote_line("PROMOTE lang 7 1800 200\r\n")
    ce_check("PROMOTE CRLF non-zero", r != 0)
    ce_eq("PROMOTE CRLF id", r[KGSYNC_R_ID], 7)
}

fn test_parse_promote_rejects_short() {
    ce_eq("PROMOTE missing alpha", _parse_promote_line("PROMOTE lang 7"),        0)
    ce_eq("PROMOTE bad numeric",   _parse_promote_line("PROMOTE lang x 1800 0"), 0)
    ce_eq("PROMOTE wrong op",      _parse_promote_line("ATOM lang 7 1800 200"),  0)
}

fn test_parse_atrophy_line() {
    let r = _parse_atrophy_line("ATROPHY lang 11")
    ce_check("parse ATROPHY non-zero", r != 0)
    ce_eq("ATROPHY type",   r[KGSYNC_R_TYPE], KGSYNC_EV_ATROPHY)
    ce_str_eq("ATROPHY kg", r[KGSYNC_R_KG],   "lang")
    ce_eq("ATROPHY id",     r[KGSYNC_R_ID],   11)
}

fn test_parse_atrophy_with_crlf() {
    let r = _parse_atrophy_line("ATROPHY lang 11\r\n")
    ce_check("ATROPHY CRLF non-zero", r != 0)
    ce_eq("ATROPHY CRLF id", r[KGSYNC_R_ID], 11)
}

fn test_parse_atrophy_rejects_bad() {
    ce_eq("ATROPHY missing id",   _parse_atrophy_line("ATROPHY lang"),     0)
    ce_eq("ATROPHY too many",     _parse_atrophy_line("ATROPHY lang 1 2"), 0)
    ce_eq("ATROPHY non-numeric",  _parse_atrophy_line("ATROPHY lang x"),   0)
    ce_eq("ATROPHY wrong op",     _parse_atrophy_line("DELETE lang 11"),   0)
}

fn test_parse_delete_line() {
    let r = _parse_delete_line("DELETE lang 42")
    ce_check("parse DELETE non-zero", r != 0)
    ce_eq("DELETE type",   r[KGSYNC_R_TYPE], KGSYNC_EV_DELETE)
    ce_str_eq("DELETE kg", r[KGSYNC_R_KG],   "lang")
    ce_eq("DELETE id",     r[KGSYNC_R_ID],   42)
}

fn test_parse_delete_with_crlf() {
    let r = _parse_delete_line("DELETE lang 42\r\n")
    ce_check("DELETE CRLF non-zero", r != 0)
    ce_eq("DELETE CRLF id", r[KGSYNC_R_ID], 42)
}

fn test_parse_delete_rejects_bad() {
    ce_eq("DELETE missing id",   _parse_delete_line("DELETE lang"),     0)
    ce_eq("DELETE too many",     _parse_delete_line("DELETE lang 1 2"), 0)
    ce_eq("DELETE non-numeric",  _parse_delete_line("DELETE lang x"),   0)
    ce_eq("DELETE wrong op",     _parse_delete_line("ATROPHY lang 42"), 0)
}

// ---- parse: top-level classifier ----------------------------------------

fn test_parse_line_routes() {
    let a = _parse_line("ATOM lang 1 1 0 0 w")
    ce_check("ATOM via _parse_line", a != 0)
    ce_eq("ATOM tag", a[KGSYNC_R_TYPE], KGSYNC_EV_ATOM)
    let p = _parse_line("PUB lang 1 1 0 0 w")
    ce_check("PUB via _parse_line", p != 0)
    ce_eq("PUB tag", p[KGSYNC_R_TYPE], KGSYNC_EV_PUB)
    let pr = _parse_line("PROMOTE lang 1 0 0")
    ce_check("PROMOTE via _parse_line", pr != 0)
    ce_eq("PROMOTE tag", pr[KGSYNC_R_TYPE], KGSYNC_EV_PROMOTE)
    let at = _parse_line("ATROPHY lang 1")
    ce_check("ATROPHY via _parse_line", at != 0)
    ce_eq("ATROPHY tag", at[KGSYNC_R_TYPE], KGSYNC_EV_ATROPHY)
    let d = _parse_line("DELETE lang 1")
    ce_check("DELETE via _parse_line", d != 0)
    ce_eq("DELETE tag", d[KGSYNC_R_TYPE], KGSYNC_EV_DELETE)
    let b = _parse_line("BYE")
    ce_check("BYE via _parse_line", b != 0)
    ce_eq("BYE tag", b[KGSYNC_R_TYPE], KGSYNC_EV_BYE)
    let ack = _parse_line("ACK 7")
    ce_check("ACK via _parse_line", ack != 0)
    ce_eq("ACK tag", ack[KGSYNC_R_TYPE], KGSYNC_EV_ACK)
    ce_eq("ACK id",  ack[KGSYNC_R_ID],   7)
    ce_eq("unknown returns 0", _parse_line("WTF banana"), 0)
}

// ---- HELLO token parser (auth) ------------------------------------------

fn test_hello_token_v2_with() {
    ce_str_eq("v2 with token",
              _parse_hello_token("HELLO ce-kg-sync v2 token=s3kret"),
              "s3kret")
}

fn test_hello_token_v2_with_crlf() {
    ce_str_eq("v2 with token CRLF",
              _parse_hello_token("HELLO ce-kg-sync v2 token=s3kret\r\n"),
              "s3kret")
}

fn test_hello_token_v2_no_token() {
    ce_eq("v2 without token returns 0",
          _parse_hello_token("HELLO ce-kg-sync v2"),
          0)
}

fn test_hello_token_v1_no_token() {
    ce_eq("v1 always returns 0",
          _parse_hello_token("HELLO ce-kg-sync v1"),
          0)
}

fn test_hello_token_bad_clause() {
    ce_eq("bogus 4th clause -> 0",
          _parse_hello_token("HELLO ce-kg-sync v2 banana"),
          0)
    ce_eq("empty token value -> 0",
          _parse_hello_token("HELLO ce-kg-sync v2 token="),
          0)
}

fn test_is_hello_recognises_both() {
    ce_eq("v1 hello",   _is_hello("HELLO ce-kg-sync v1"),               1)
    ce_eq("v2 hello",   _is_hello("HELLO ce-kg-sync v2"),               1)
    ce_eq("v2+token",   _is_hello("HELLO ce-kg-sync v2 token=foo"),     1)
    ce_eq("not hello",  _is_hello("ATOM lang 1 1 0 0 w"),               0)
}

// ---- round-trip ---------------------------------------------------------

fn test_round_trip() {
    let original = _format_atom_line("lang", 42, 1, 800, 200, "widget")
    let parsed = _parse_atom_line(original)
    ce_check("round-trip parsed", parsed != 0)
    let again = _format_atom_line(parsed[KGSYNC_R_KG], parsed[KGSYNC_R_ID],
                                  parsed[KGSYNC_R_KIND], parsed[KGSYNC_R_ALPHA],
                                  parsed[KGSYNC_R_BETA], parsed[KGSYNC_R_LABEL])
    ce_str_eq("round-trip identity", again, original)
}

fn test_round_trip_punctuation() {
    let original = _format_atom_line("world", 99, 3, 1500, 500, "fever-treat_chain")
    let parsed = _parse_atom_line(original)
    ce_check("round-trip with - + _ non-zero", parsed != 0)
    let again = _format_atom_line(parsed[KGSYNC_R_KG], parsed[KGSYNC_R_ID],
                                  parsed[KGSYNC_R_KIND], parsed[KGSYNC_R_ALPHA],
                                  parsed[KGSYNC_R_BETA], parsed[KGSYNC_R_LABEL])
    ce_str_eq("round-trip with - + _ identity", again, original)
}

fn test_round_trip_promote() {
    let original = _format_promote_line("lang", 42, 1800, 200)
    let parsed = _parse_promote_line(original)
    ce_check("PROMOTE round-trip non-zero", parsed != 0)
    let again = _format_promote_line(parsed[KGSYNC_R_KG], parsed[KGSYNC_R_ID],
                                     parsed[KGSYNC_P_ALPHA], parsed[KGSYNC_P_BETA])
    ce_str_eq("PROMOTE round-trip identity", again, original)
}

fn test_round_trip_atrophy() {
    let original = _format_atrophy_line("lang", 11)
    let parsed = _parse_atrophy_line(original)
    ce_check("ATROPHY round-trip non-zero", parsed != 0)
    let again = _format_atrophy_line(parsed[KGSYNC_R_KG], parsed[KGSYNC_R_ID])
    ce_str_eq("ATROPHY round-trip identity", again, original)
}

fn test_round_trip_delete() {
    let original = _format_delete_line("lang", 42)
    let parsed = _parse_delete_line(original)
    ce_check("DELETE round-trip non-zero", parsed != 0)
    let again = _format_delete_line(parsed[KGSYNC_R_KG], parsed[KGSYNC_R_ID])
    ce_str_eq("DELETE round-trip identity", again, original)
}

// ---- internal text helpers ---------------------------------------------

fn test_strip_eol() {
    ce_str_eq("strip none",  _strip_eol("abc"),       "abc")
    ce_str_eq("strip LF",    _strip_eol("abc\n"),     "abc")
    ce_str_eq("strip CRLF",  _strip_eol("abc\r\n"),   "abc")
    ce_str_eq("strip empty", _strip_eol(""),          "")
}

fn test_split_spaces() {
    let toks = _split_spaces("ATOM lang 42 1 800 200 widget")
    ce_eq("split count",  len(toks),  7)
    ce_str_eq("split [0]", toks[0], "ATOM")
    ce_str_eq("split [1]", toks[1], "lang")
    ce_str_eq("split [6]", toks[6], "widget")
}

fn test_is_digits() {
    ce_eq("digits-empty rejected",   _is_digits(""),     0)
    ce_eq("digits-pure accepted",    _is_digits("0"),    1)
    ce_eq("digits-bigger accepted",  _is_digits("12345"), 1)
    ce_eq("digits-letters rejected", _is_digits("12a"),  0)
}

fn test_starts_with() {
    ce_eq("prefix match",    _starts_with("ATOM lang", "ATOM "), 1)
    ce_eq("prefix mismatch", _starts_with("BYE",       "ATOM "), 0)
    ce_eq("prefix too long", _starts_with("AT",        "ATOM "), 0)
    ce_eq("prefix empty",    _starts_with("anything",  ""),      1)
}

// ---- IP encoding (publisher/subscriber dial-in helper) ------------------

fn test_ip_parse_loopback() {
    ce_eq("127.0.0.1", _ip_str_to_int("127.0.0.1"), 16777343)
}

fn test_ip_parse_any() {
    ce_eq("0.0.0.0", _ip_str_to_int("0.0.0.0"), 0)
}

fn test_ip_parse_rejects_bad() {
    ce_eq("not enough octets", _ip_str_to_int("127.0.0"),       -1)
    ce_eq("too many octets",   _ip_str_to_int("1.2.3.4.5"),     -1)
    ce_eq("non-numeric octet", _ip_str_to_int("127.0.0.a"),     -1)
    ce_eq("octet > 255",       _ip_str_to_int("127.0.0.500"),   -1)
}

// ---- env helpers --------------------------------------------------------

fn test_default_port_when_env_unset() {
    ce_eq("default port", kgsync_port_from_env(), KGSYNC_DEFAULT_PORT)
}

fn test_default_subs_when_env_unset() {
    ce_eq("default sub count", kgsync_subs_from_env(), KGSYNC_DEFAULT_SUBS)
}

fn test_default_token_when_env_unset() {
    ce_eq("default token", kgsync_token_from_env(), 0)
}

// ---- subscriber record / pruning ---------------------------------------

fn test_sub_record_init() {
    let r = sync_sub_record(7)
    ce_eq("init fd",       sync_sub_fd(r),       7)
    ce_eq("init last-ack", sync_sub_last_ack(r), 0 - 1)
}

fn test_sub_set_ack_records_id() {
    let r = sync_sub_record(7)
    sync_sub_set_ack(r, 42, 1000)
    ce_eq("set_ack id", sync_sub_last_ack(r), 42)
}

fn test_sub_is_stale_threshold() {
    // Synthetic record with patched last_active = 0 so the staleness
    // comparator does a pure subtraction (now - 0 = now) and compares to
    // KGSYNC_PRUNE_NS. This avoids adding to a real wall-clock nanotime
    // (PTR_THRESHOLD add-codegen bug -- see NEXT_SESSION.md).
    let r = sync_sub_record(7)
    list_set(r, KGSYNC_S_LAST_ACTIVE, 0)
    // gap of 1ms = not stale.
    ce_eq("fresh not stale", sync_sub_is_stale(r, 1000000), 0)
    // gap = PRUNE_NS (3e10) = not stale (strict >).
    ce_eq("at-threshold not stale", sync_sub_is_stale(r, KGSYNC_PRUNE_NS), 0)
    // gap > PRUNE_NS = stale. PRUNE_NS + 1 is constant-folded so the
    // call site doesn't trigger _nova_add at runtime.
    ce_eq("above-threshold stale",  sync_sub_is_stale(r, KGSYNC_PRUNE_NS + 1), 1)
}

// ---- conflict resolution / apply helpers --------------------------------

fn test_apply_atom_birth_when_absent() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    let a = sync_apply_atom(kg, 0, ATOM_CONCEPT, 1500, 500, "widget")
    ce_check("apply births when absent", a != 0)
    ce_str_eq("birth label", atom_label(a), "widget")
    let b = atom_belief(a)
    ce_eq("birth alpha", b[0], 1500)
    ce_eq("birth beta",  b[1], 500)
    ce_eq("kg has 1",    kg_atom_count(kg), 1)
}

fn test_apply_atom_refresh_on_same_id() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    let seed = kg_add_atom(kg, ATOM_CONCEPT, "widget", 0)
    let a = sync_apply_atom(kg, atom_id(seed), ATOM_CONCEPT, 2500, 500, "widget")
    ce_check("apply returns existing on match", a != 0)
    ce_eq("kg stays at 1", kg_atom_count(kg), 1)
    ce_eq("alpha refreshed", atom_belief(a)[0], 2500)
}

fn test_apply_atom_merge_on_id_conflict() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    let local = kg_add_atom(kg, ATOM_CONCEPT, "widget", 0)
    let lb = atom_belief(local)
    list_set(lb, 0, 2000)
    list_set(lb, 1, 400)
    let merged = sync_apply_atom(kg, 9, ATOM_CONCEPT, 1000, 200, "widget")
    ce_check("merge returns existing", merged != 0)
    ce_eq("merge preserves local id", atom_id(merged), atom_id(local))
    ce_eq("kg stays at 1 atom",       kg_atom_count(kg), 1)
    let mb = atom_belief(merged)
    ce_eq("merged alpha is avg", mb[0], 1500)
    ce_eq("merged beta is avg",  mb[1], 300)
}

fn test_apply_promote_updates_belief() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "widget", 0)
    let ok = sync_apply_promote(kg, atom_id(a), 1800, 200)
    ce_eq("promote ok", ok, 1)
    let b = atom_belief(a)
    ce_eq("promoted alpha", b[0], 1800)
    ce_eq("promoted beta",  b[1], 200)
}

fn test_apply_promote_missing_id() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    ce_eq("promote missing", sync_apply_promote(kg, 99, 1, 1), 0)
}

fn test_apply_atrophy_resets_to_prior() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "widget", 0)
    let b = atom_belief(a)
    list_set(b, 0, 5000)
    list_set(b, 1, 0)
    let ok = sync_apply_atrophy(kg, atom_id(a))
    ce_eq("atrophy ok", ok, 1)
    ce_eq("atrophy resets alpha", atom_belief(a)[0], BEL_PRIOR)
    ce_eq("atrophy resets beta",  atom_belief(a)[1], BEL_PRIOR)
}

fn test_apply_delete_zeros_label_and_belief() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "language")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "widget", 0)
    let ok = sync_apply_delete(kg, atom_id(a))
    ce_eq("delete ok", ok, 1)
    ce_str_eq("delete clears label", atom_label(a), "")
    ce_eq("delete zeros alpha", atom_belief(a)[0], 0)
    ce_eq("delete zeros beta",  atom_belief(a)[1], 0)
}

// ---- conn state (reconnect cursor) --------------------------------------

fn test_conn_new_and_accessors() {
    let c = sync_conn_new(7, "127.0.0.1", 8766, "tok", -1)
    ce_eq("conn fd",     sync_conn_fd(c),     7)
    ce_eq("conn cursor", sync_conn_cursor(c), 0 - 1)
}

fn test_conn_set_cursor() {
    let c = sync_conn_new(7, "127.0.0.1", 8766, "tok", -1)
    sync_conn_set_cursor(c, 42)
    ce_eq("cursor advanced", sync_conn_cursor(c), 42)
}

// ---- main ---------------------------------------------------------------

fn main() {
    // v1 format / parse
    test_format_basic()
    test_format_label_dashes_underscores()
    test_format_zero_alpha_beta()
    test_format_pub()
    test_format_promote()
    test_format_atrophy()
    test_format_delete()
    test_parse_basic()
    test_parse_with_trailing_newline()
    test_parse_with_crlf()
    test_parse_label_punctuation()
    test_parse_rejects_short_line()
    test_parse_rejects_wrong_op()
    test_parse_rejects_non_numeric_fields()
    test_parse_rejects_illegal_label_chars()
    // v2 new event kinds
    test_parse_pub_line()
    test_parse_pub_rejects_atom_prefix()
    test_parse_promote_line()
    test_parse_promote_with_crlf()
    test_parse_promote_rejects_short()
    test_parse_atrophy_line()
    test_parse_atrophy_with_crlf()
    test_parse_atrophy_rejects_bad()
    test_parse_delete_line()
    test_parse_delete_with_crlf()
    test_parse_delete_rejects_bad()
    test_parse_line_routes()
    // auth handshake
    test_hello_token_v2_with()
    test_hello_token_v2_with_crlf()
    test_hello_token_v2_no_token()
    test_hello_token_v1_no_token()
    test_hello_token_bad_clause()
    test_is_hello_recognises_both()
    // round-trips
    test_round_trip()
    test_round_trip_punctuation()
    test_round_trip_promote()
    test_round_trip_atrophy()
    test_round_trip_delete()
    // helpers
    test_strip_eol()
    test_split_spaces()
    test_is_digits()
    test_starts_with()
    test_ip_parse_loopback()
    test_ip_parse_any()
    test_ip_parse_rejects_bad()
    test_default_port_when_env_unset()
    test_default_subs_when_env_unset()
    test_default_token_when_env_unset()
    // subscriber records / pruning
    test_sub_record_init()
    test_sub_set_ack_records_id()
    test_sub_is_stale_threshold()
    // conflict resolution / apply helpers
    test_apply_atom_birth_when_absent()
    test_apply_atom_refresh_on_same_id()
    test_apply_atom_merge_on_id_conflict()
    test_apply_promote_updates_belief()
    test_apply_promote_missing_id()
    test_apply_atrophy_resets_to_prior()
    test_apply_delete_zeros_label_and_belief()
    // conn state
    test_conn_new_and_accessors()
    test_conn_set_cursor()
    ce_summary("kg_sync")
}
