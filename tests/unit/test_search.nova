// Unit tests for src/mind/search.nova: bounded proof SEARCH (ADR-0088 v2).
// The search constructs proofs; the kernel still gates them. Every "found"
// result is confirmed by verify_check, and the load-bearing property is that
// search can never yield a false theorem -- an unprovable goal returns 0.

import "../ce_test.nova"
import "../../src/mind/search.nova"

fn _terms(items) { return items }   // readability alias

// The Socrates syllogism, AUTO-DERIVED: from forall x.(human(x)->mortal(x)) and
// human(socrates), search finds mortal(socrates) (UI then MP) with no supplied
// proof.
fn test_search_socrates() {
    let reg = proof_registry_new()
    let law = term_forall("x", term_imp(term_pred("human", term_var("x")),
                                        term_pred("mortal", term_var("x"))))
    let human_soc = term_pred("human", term_atom("socrates"))
    let goal = term_pred("mortal", term_atom("socrates"))
    let premises = list_new()
    push(premises, law) push(premises, human_soc)
    let consts = list_new() push(consts, term_atom("socrates"))
    let proof = search_prove(premises, consts, goal, 5)
    ce_check("found a proof", proof != 0)
    // the search's proof is kernel-verified.
    ce_eq("search proof passes the kernel",
        search_prove_ok(reg, premises, consts, goal, 5), 1)
}

// MP chain: a->b, b->c, a |- c (two MP steps).
fn test_search_mp_chain() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let premises = list_new()
    push(premises, term_imp(a, b)) push(premises, term_imp(b, c)) push(premises, a)
    let consts = list_new()
    ce_eq("derives c via two MPs",
        search_prove_ok(reg, premises, consts, c, 5), 1)
}

// HS: a->b, b->c |- a->c (composed implication), without ever knowing a.
fn test_search_hs() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let premises = list_new()
    push(premises, term_imp(a, b)) push(premises, term_imp(b, c))
    let consts = list_new()
    ce_eq("derives a->c via HS",
        search_prove_ok(reg, premises, consts, term_imp(a, c), 5), 1)
}

// AND-elim: (a and b) |- a.
fn test_search_and_elim() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let premises = list_new()
    push(premises, term_and(a, b))
    let consts = list_new()
    ce_eq("extracts a from (a and b)",
        search_prove_ok(reg, premises, consts, a, 3), 1)
    ce_eq("extracts b from (a and b)",
        search_prove_ok(reg, premises, consts, b, 3), 1)
}

// A premise that's already the goal is found immediately (depth 0).
fn test_search_trivial() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let premises = list_new() push(premises, p)
    let consts = list_new()
    ce_eq("trivial goal found", search_prove_ok(reg, premises, consts, p, 1), 1)
}

// THE soundness property: an UNPROVABLE goal returns 0 -- the search never
// fabricates a proof, and search_prove_ok agrees (nothing to kernel-verify).
fn test_search_unprovable_returns_zero() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let z = term_atom("z")
    let premises = list_new() push(premises, a)
    let consts = list_new()
    ce_eq("unprovable goal -> no proof", search_prove(premises, consts, z, 5), 0)
    ce_eq("unprovable goal -> ok=0",
        search_prove_ok(reg, premises, consts, z, 5), 0)
}

// Even if the search were buggy, the kernel gate holds: a deeper chain that
// needs more passes than the budget allows returns 0 (incompleteness, never
// unsoundness). a->b, b->c, c->d, a with budget 1 can't reach d.
fn test_search_budget_incompleteness() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let d = term_atom("d")
    let premises = list_new()
    push(premises, term_imp(a, b)) push(premises, term_imp(b, c))
    push(premises, term_imp(c, d)) push(premises, a)
    let consts = list_new()
    // budget 1 is too shallow to reach d, but it's still SOUND (returns 0, not a
    // bogus proof); a larger budget finds it.
    ce_eq("shallow budget -> not yet found",
        search_prove_ok(reg, premises, consts, d, 1), 0)
    ce_eq("enough budget -> found",
        search_prove_ok(reg, premises, consts, d, 5), 1)
}

fn main() {
    test_search_socrates()
    test_search_mp_chain()
    test_search_hs()
    test_search_and_elim()
    test_search_trivial()
    test_search_unprovable_returns_zero()
    test_search_budget_incompleteness()
    ce_summary("search")
}

main()
