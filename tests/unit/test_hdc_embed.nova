// Unit tests for src/kg/hdc_embed.nova -- the P1 HDC/VSA embedding keystone.
//
// Covers (ADR-0051):
//   - dimensionality + bipolarity of the hypervectors,
//   - determinism: a label always maps to the same vector,
//   - near-orthogonality of distinct random symbols (the basis of VSA),
//   - bind/unbind algebra incl. the self-inverse property,
//   - bundle superposition (members similar, non-members ~0),
//   - permute dissimilarity + exact round-trip,
//   - holographic record recovery: (France (x) capital) -> Paris,
//   - synonyms-by-neighbourhood: cos(encode(car), encode(automobile)) > 700,
//   - capacity / crosstalk as the number of bundled pairs grows,
//   - query round-trip through the dimension-agnostic LSH ann_index at D=10k,
//   - the ATOM_EMBED_MODE cutover flag accessors.
//
// All cosines are deterministic (each symbol is a pure function of its label),
// so the thresholds below are stable, not statistical.
//
// ADR-0051, ADR-0016, ADR-0049.

import "../ce_test.nova"
import "../../src/kg/hdc_embed.nova"
import "../../src/kg/ann_index.nova"

// Generous orthogonality band: for D=10000 the cosine of two independent
// bipolar vectors has stddev ~10 milli, so ~0 means |cos| well under 120.
let ORTHO = 120

fn _pair(rel, nbr) {
    let p = list_new()
    push(p, rel)
    push(p, nbr)
    return p
}

fn _abs(x) { if x < 0 { return 0 - x } return x }

fn test_dims_and_bipolar() {
    ce_eq("hdc_dims is 10000", hdc_dims(), 10000)
    let v = hdc_symbol("anything")
    ce_eq("vector length == dims", len(v), hdc_dims())
    // every coordinate is exactly +1 or -1
    let i = 0
    let bad = 0
    let ones = 0
    while i < len(v) {
        if v[i] == 1 { ones = ones + 1 } else {
            if v[i] != -1 { bad = bad + 1 }
        }
        i = i + 1
    }
    ce_eq("all coords are +/-1", bad, 0)
    // roughly balanced sign distribution (between 40% and 60% positive)
    ce_check("balanced: >4000 positive", ones > 4000)
    ce_check("balanced: <6000 positive", ones < 6000)
}

fn test_determinism_and_orthogonality() {
    ce_eq("symbol identical to itself", hdc_cosine(hdc_symbol("car"), hdc_symbol("car")), 1000)
    // distinct labels -> near-orthogonal (this is what makes spelling irrelevant)
    ce_check("car vs dog near-orthogonal", _abs(hdc_cosine(hdc_symbol("car"), hdc_symbol("dog"))) < ORTHO)
    ce_check("alpha vs omega near-orthogonal", _abs(hdc_cosine(hdc_symbol("alpha"), hdc_symbol("omega"))) < ORTHO)
}

fn test_bind_inverse() {
    let a = hdc_symbol("role")
    let b = hdc_symbol("filler")
    let bound = hdc_bind(a, b)
    // self-inverse: unbind(bind(a,b), b) recovers a EXACTLY (cos 1000)
    ce_eq("unbind recovers filler exactly", hdc_cosine(hdc_unbind(bound, b), a), 1000)
    ce_eq("unbind by other operand recovers it", hdc_cosine(hdc_unbind(bound, a), b), 1000)
    // a bound pair is dissimilar to each operand (binding randomises)
    ce_check("bound ~orthogonal to operand a", _abs(hdc_cosine(bound, a)) < ORTHO)
    ce_check("bound ~orthogonal to operand b", _abs(hdc_cosine(bound, b)) < ORTHO)
}

fn test_bundle_membership() {
    let red   = hdc_symbol("red")
    let green = hdc_symbol("green")
    let blue  = hdc_symbol("blue")
    let set = list_new()
    push(set, red); push(set, green); push(set, blue)
    let bundled = hdc_bundle(set)
    // each member is clearly similar to the bundle...
    ce_check("member red in bundle", hdc_cosine(bundled, red) > 300)
    ce_check("member green in bundle", hdc_cosine(bundled, green) > 300)
    ce_check("member blue in bundle", hdc_cosine(bundled, blue) > 300)
    // ...a non-member is not
    ce_check("non-member purple absent", _abs(hdc_cosine(bundled, hdc_symbol("purple"))) < ORTHO)
}

fn test_permute() {
    let a = hdc_symbol("sequence")
    let p1 = hdc_permute(a, 1)
    ce_check("permute(1) dissimilar to original", _abs(hdc_cosine(p1, a)) < ORTHO)
    // exact round-trip: shift by k then by -k
    ce_eq("permute round-trip exact", hdc_cosine(hdc_permute(p1, -1), a), 1000)
    let p7 = hdc_permute(a, 7)
    ce_eq("permute(7) round-trip exact", hdc_cosine(hdc_permute(p7, -7), a), 1000)
    // permute by 0 is identity
    ce_eq("permute(0) is identity", hdc_cosine(hdc_permute(a, 0), a), 1000)
}

// Holographic record: bundle of role (x) filler pairs; query a role to read
// back its filler. Roadmap acceptance: (France (x) capital) recovers Paris.
fn test_record_recovery() {
    let edges = list_new()
    push(edges, _pair("capital", "Paris"))
    push(edges, _pair("population", "67M"))
    push(edges, _pair("language", "French"))
    push(edges, _pair("continent", "Europe"))
    let france = hdc_encode_edges(edges)
    let got = hdc_unbind(france, hdc_symbol("capital"))
    let cParis  = hdc_cosine(got, hdc_symbol("Paris"))
    let cFrench = hdc_cosine(got, hdc_symbol("French"))
    let cEurope = hdc_cosine(got, hdc_symbol("Europe"))
    ce_check("Paris recovered above noise", cParis > 200)
    ce_check("Paris beats French slot", cParis > cFrench + 150)
    ce_check("Paris beats Europe slot", cParis > cEurope + 150)
}

// Synonyms that share a neighbourhood land close even though their spellings
// (and therefore their raw symbol vectors) are unrelated. Roadmap acceptance:
// cos(encode(car), encode(automobile)) > 700.
fn test_synonyms_via_neighbours() {
    let shared = list_new()
    push(shared, _pair("is_a", "vehicle"))
    push(shared, _pair("has", "wheels"))
    push(shared, _pair("has", "engine"))
    push(shared, _pair("used_for", "transport"))
    push(shared, _pair("needs", "fuel"))
    push(shared, _pair("has", "doors"))
    push(shared, _pair("can", "drive"))
    push(shared, _pair("found_on", "road"))
    let car = list_new()
    let auto = list_new()
    let i = 0
    while i < len(shared) { push(car, shared[i]); push(auto, shared[i]); i = i + 1 }
    push(car, _pair("informal_name", "ride"))
    push(auto, _pair("formal_name", "motorcar"))
    let cv = hdc_encode_atom("car", car)
    let av = hdc_encode_atom("automobile", auto)

    // raw spelling-based symbols are unrelated (this is the problem HDC fixes)
    ce_check("raw symbols car/automobile unrelated",
             _abs(hdc_cosine(hdc_symbol("car"), hdc_symbol("automobile"))) < ORTHO)
    // ...but their neighbourhood encodings are close
    ce_check("encode(car)~encode(automobile) > 700", hdc_cosine(cv, av) > 700)

    // an unrelated concept (different neighbourhood) stays far
    let dog = list_new()
    push(dog, _pair("is_a", "animal"))
    push(dog, _pair("has", "tail"))
    push(dog, _pair("has", "fur"))
    push(dog, _pair("makes", "bark"))
    push(dog, _pair("eats", "meat"))
    let dv = hdc_encode_atom("dog", dog)
    ce_check("encode(car) vs encode(dog) far", hdc_cosine(cv, dv) < 250)

    // identical neighbourhoods unify perfectly
    let s1 = hdc_encode_edges(shared)
    let s2 = hdc_encode_edges(shared)
    ce_eq("identical neighbourhood -> cos 1000", hdc_cosine(s1, s2), 1000)
}

// How many bound pairs can a single bundle hold before crosstalk wins. A pair
// counts as recovered when unbinding its key yields a vector closer to its own
// filler than to the next filler, and clearly above noise.
fn _capacity_recovered(n) {
    let recs = list_new()
    let i = 0
    while i < n {
        push(recs, hdc_bind(hdc_symbol("key" + int_to_str(i)), hdc_symbol("fil" + int_to_str(i))))
        i = i + 1
    }
    let bundle = hdc_bundle(recs)
    i = 0
    let ok = 0
    while i < n {
        let got = hdc_unbind(bundle, hdc_symbol("key" + int_to_str(i)))
        let cself = hdc_cosine(got, hdc_symbol("fil" + int_to_str(i)))
        let cnext = hdc_cosine(got, hdc_symbol("fil" + int_to_str((i + 1) % n)))
        if cself > cnext {
            if cself > 50 { ok = ok + 1 }
        }
        i = i + 1
    }
    return ok
}

fn test_capacity_crosstalk() {
    // small loads recover perfectly
    ce_eq("N=5 recovers all", _capacity_recovered(5), 5)
    ce_eq("N=35 recovers all", _capacity_recovered(35), 35)
    // a heavy load degrades gracefully: not perfect, but most still recovered
    let heavy = _capacity_recovered(60)
    ce_check("N=60 shows crosstalk (< 60)", heavy < 60)
    ce_check("N=60 degrades gracefully (>= 50)", heavy >= 50)
}

// The LSH ann_index is dimension-agnostic; HDC vectors flow through it with K
// raised to 16 (roadmap: "LSH scales fine to D=10k; raise K from 8 to ~16").
fn test_ann_query_roundtrip() {
    let ann = ann_new(hdc_dims(), 16)
    ce_eq("ann sized to 2^16 buckets", ann_bucket_total(ann), 65536)
    let labels = list_new()
    push(labels, "apple"); push(labels, "banana"); push(labels, "cherry"); push(labels, "date")
    let atoms = list_new()
    let i = 0
    while i < len(labels) {
        let a = atom_new("fruit", i, ATOM_CONCEPT, labels[i], 0)
        atom_set_embed(a, hdc_symbol(labels[i]))
        push(atoms, a)
        ann_add(ann, i, atom_embed(a))
        i = i + 1
    }
    // querying with a stored vector returns that atom, exact match cos 1000
    let out = ann_query(ann, atoms, hdc_symbol("banana"), 4)
    ce_check("ann query returned a hit", len(out) > 0)
    ce_eq("top hit is the queried atom (id 1)", out[0][0], 1)
    ce_eq("exact self-match cosine 1000", out[0][1], 1000)
}

fn test_embed_mode_flag() {
    ce_eq("default mode is LEGACY", atom_embed_mode(), ATOM_EMBED_MODE_LEGACY)
    ce_eq("not hdc by default", atom_embed_is_hdc(), 0)
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    ce_eq("switched to HDC", atom_embed_is_hdc(), 1)
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
    ce_eq("reset to LEGACY", atom_embed_is_hdc(), 0)
}

fn main() {
    test_dims_and_bipolar()
    test_determinism_and_orthogonality()
    test_bind_inverse()
    test_bundle_membership()
    test_permute()
    test_record_recovery()
    test_synonyms_via_neighbours()
    test_capacity_crosstalk()
    test_ann_query_roundtrip()
    test_embed_mode_flag()
    ce_summary("hdc_embed")
}

main()
