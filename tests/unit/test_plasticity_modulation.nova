// Unit tests for src/learning/plasticity_modulation.nova
// Verifies the plasticity modulator: neutral baseline, arousal boost, reward
// boost and punishment reduction, valence-intensity boost, and clamping.
// ADR-0035, ADR-0007.

import "../ce_test.nova"
import "../../src/learning/plasticity_modulation.nova"

fn test_modulator() {
    ce_eq("neutral", pm_neutral(), 1000)
    ce_eq("no emotion -> neutral", pm_modulator(0, 0, 0), 1000)
    // Full arousal doubles plasticity.
    ce_eq("full arousal", pm_modulator(0, 1000, 0), 2000)
    // Reward boosts; punishment reduces.
    ce_eq("full reward", pm_modulator(0, 0, 1000), 1500)
    ce_eq("punishment reduces", pm_modulator(0, 0, -1000), 500)
    // Strong valence of either sign boosts via intensity.
    ce_eq("negative valence boosts", pm_modulator(-1000, 0, 0), 1300)
    ce_eq("positive valence boosts", pm_modulator(1000, 0, 0), 1300)
}

fn test_clamping() {
    // All maxed: 1000 + 1000 + 500 + 300 = 2800 -> clamped to PM_MOD_MAX.
    ce_eq("clamps to max", pm_modulator(1000, 1000, 1000), PM_MOD_MAX)
    // Heavy punishment: 1000 - 1000 = 0 -> clamped to PM_MOD_MIN.
    ce_eq("clamps to min", pm_modulator(0, 0, -2000), PM_MOD_MIN)
}

fn test_emotion_only() {
    ce_eq("emotion-only ignores reward", pm_from_emotion(0, 1000), 2000)
}

fn main() {
    test_modulator()
    test_clamping()
    test_emotion_only()
    ce_summary("plasticity_modulation")
}

main()
