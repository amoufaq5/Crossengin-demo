// Unit tests for src/learning/entity_resolve.nova (P3, ADR-0053).
//
// Entity resolution maps a surface mention to a single canonical atom before
// insertion, so the KG does not fragment. Covered: exact-label, alias-table,
// and the marquee P1->P3 path -- HDC neighbourhood similarity resolving "car"
// and "automobile" to ONE atom despite unrelated spellings -- plus the
// resolve-or-create flow, no-false-merge, and resolution precedence.
//
// ADR-0053, ADR-0051, ADR-0016.

import "../ce_test.nova"
import "../../src/learning/entity_resolve.nova"

fn ed(r, n) { let p = list_new() push(p, r) push(p, n) return p }
fn veh() {
    let e = list_new()
    push(e, ed("is_a", "vehicle")); push(e, ed("has", "wheels"))
    push(e, ed("has", "engine")); push(e, ed("used_for", "transport"))
    push(e, ed("needs", "fuel"))
    return e
}
fn animal() {
    let e = list_new()
    push(e, ed("is_a", "animal")); push(e, ed("has", "tail"))
    push(e, ed("has", "fur")); push(e, ed("makes", "bark"))
    return e
}

fn test_exact() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    let car = kg_add_atom(kg, ATOM_CONCEPT, "car", 0)
    let r = er_resolve(kg, er_aliases_new(), "car", list_new(), ER_HDC_THRESHOLD)
    ce_eq("exact resolves", r[1], ER_VIA_EXACT)
    ce_eq("exact -> same atom", atom_id(r[0]), atom_id(car))
    let miss = er_resolve(kg, er_aliases_new(), "spaceship", list_new(), ER_HDC_THRESHOLD)
    ce_eq("unknown -> none", miss[1], ER_VIA_NONE)
    ce_eq("unknown -> 0 atom", miss[0], 0)
}

fn test_alias() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    let car = kg_add_atom(kg, ATOM_CONCEPT, "car", 0)
    let al = er_aliases_new()
    er_alias_add(al, "automobile", "car")
    er_alias_add(al, "motorcar", "car")
    let r = er_resolve(kg, al, "automobile", list_new(), ER_HDC_THRESHOLD)
    ce_eq("alias resolves", r[1], ER_VIA_ALIAS)
    ce_eq("alias -> canonical atom", atom_id(r[0]), atom_id(car))
    ce_str_eq("alias lookup", er_alias_lookup(al, "motorcar"), "car")
    ce_str_eq("non-alias is empty", er_alias_lookup(al, "boat"), "")
}

// The marquee acceptance: "car" and "automobile" resolve to ONE atom via HDC
// neighbourhood similarity, and an unrelated mention does NOT falsely merge.
fn test_hdc_resolution() {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    let car = kg_add_atom(kg, ATOM_CONCEPT, "car", 0)
    atom_set_embed(car, hdc_encode_atom("car", veh()))
    let dog = kg_add_atom(kg, ATOM_CONCEPT, "dog", 0)
    atom_set_embed(dog, hdc_encode_atom("dog", animal()))

    let auto_vec = hdc_encode_atom("automobile", veh())
    let r = er_resolve(kg, er_aliases_new(), "automobile", auto_vec, ER_HDC_THRESHOLD)
    ce_eq("automobile resolves via HDC", r[1], ER_VIA_HDC)
    ce_eq("automobile -> the car atom (not dog)", atom_id(r[0]), atom_id(car))

    let bird = list_new()
    push(bird, ed("is_a", "bird")); push(bird, ed("can", "fly")); push(bird, ed("has", "feathers"))
    let nr = er_resolve(kg, er_aliases_new(), "sparrow", hdc_encode_atom("sparrow", bird), ER_HDC_THRESHOLD)
    ce_eq("unrelated mention not merged", nr[0], 0)
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

fn test_resolve_or_create() {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    let al = er_aliases_new()
    let r1 = er_resolve_or_create(kg, al, "car", hdc_encode_atom("car", veh()), ER_HDC_THRESHOLD, 0)
    ce_eq("first mention is minted", r1[1], ER_VIA_NEW)
    ce_eq("created flag set", r1[2], 1)
    // a synonym described the same way resolves to the minted atom (no dup).
    let r2 = er_resolve_or_create(kg, al, "automobile", hdc_encode_atom("automobile", veh()), ER_HDC_THRESHOLD, 0)
    ce_eq("synonym resolves via HDC", r2[1], ER_VIA_HDC)
    ce_eq("synonym created nothing", r2[2], 0)
    ce_eq("synonym -> same atom", atom_id(r2[0]), atom_id(r1[0]))
    ce_eq("KG holds exactly one atom", kg_atom_count(kg), 1)
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

fn test_precedence() {
    // exact beats alias: a mention that exists AND is aliased resolves exact.
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    let cat = kg_add_atom(kg, ATOM_CONCEPT, "cat", 0)
    kg_add_atom(kg, ATOM_CONCEPT, "feline", 0)
    let al = er_aliases_new()
    er_alias_add(al, "cat", "feline")
    let r = er_resolve(kg, al, "cat", list_new(), ER_HDC_THRESHOLD)
    ce_eq("exact wins over alias", atom_id(r[0]), atom_id(cat))
    ce_eq("via exact", r[1], ER_VIA_EXACT)
}

// ADR-0084 (GAP A): er_resolve_or_create caches a GENUINE synonym (a mention
// that resolves to an EXISTING atom by HDC, with a different surface form) as
// an alias `mention -> canonical_label`. This both speeds the next occurrence
// (cheap alias path) and makes the resolved atom an alias death-gate target.
// No alias is recorded for a no-op self-resolution (mention == canonical) and
// none for a freshly-minted atom (there is nothing to alias to yet).
fn test_synonym_autorecord() {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    // An existing canonical atom "aspirin" with a neighbourhood embedding.
    let aspirin = kg_add_atom(kg, ATOM_CONCEPT, "aspirin", 0)
    atom_set_embed(aspirin, hdc_encode_atom("aspirin", veh()))
    let al = er_aliases_new()

    // Resolve the synonym "asa" with a vector near aspirin's so HDC matches.
    let r = er_resolve_or_create(kg, al, "asa", hdc_encode_atom("asa", veh()), ER_HDC_THRESHOLD, 0)
    // (1) it resolved to the existing aspirin atom by HDC (nothing created).
    ce_eq("asa resolves via HDC", r[1], ER_VIA_HDC)
    ce_eq("asa created nothing", r[2], 0)
    ce_eq("asa -> aspirin atom", atom_id(r[0]), atom_id(aspirin))
    // (2) the alias asa -> aspirin was recorded.
    ce_str_eq("alias recorded asa->aspirin", er_alias_lookup(al, "asa"), "aspirin")
    ce_eq("aspirin is now an alias canonical", er_aliases_has_canonical(al, "aspirin"), 1)
    // ...and a SECOND resolve of "asa" now takes the cheap alias path.
    let r2 = er_resolve(kg, al, "asa", list_new(), ER_HDC_THRESHOLD)
    ce_eq("asa now hits alias path", r2[1], ER_VIA_ALIAS)
    ce_eq("alias path -> aspirin atom", atom_id(r2[0]), atom_id(aspirin))

    // (3) NO self-alias is recorded when resolving "aspirin" itself (exact hit,
    // mention == canonical). The table must still hold exactly the one entry.
    let rs = er_resolve_or_create(kg, al, "aspirin", hdc_encode_atom("aspirin", veh()), ER_HDC_THRESHOLD, 0)
    ce_eq("aspirin resolves exact", rs[1], ER_VIA_EXACT)
    ce_str_eq("no self-alias for aspirin", er_alias_lookup(al, "aspirin"), "")
    ce_eq("alias table still has one entry", len(al), 1)
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

fn main() {
    test_exact()
    test_alias()
    test_hdc_resolution()
    test_resolve_or_create()
    test_precedence()
    test_synonym_autorecord()
    ce_summary("entity_resolve")
}

main()
