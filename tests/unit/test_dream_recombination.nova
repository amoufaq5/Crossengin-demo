// Unit tests for src/parts/imagination/dream_recombination.nova
// Verifies seeded recombination at extreme creativity and novel-pattern
// discovery. ADR-0032.

import "../ce_test.nova"
import "../../src/parts/imagination/dream_recombination.nova"

fn lst(a, b) { let l = list_new(); push(l, a); push(l, b); return l }

fn test_recombine() {
    let frags = list_new()
    push(frags, lst(1, 2))
    push(frags, lst(3, 4))
    // Full creativity includes everything.
    let all = dream_recombine(frags, 1000, 7)
    ce_eq("all included", img_state_size(all), 4)
    // Zero creativity includes nothing.
    let blank = dream_recombine(frags, 0, 7)
    ce_eq("none included", img_state_size(blank), 0)
}

fn test_discover() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    let before = len(img_patterns(ikg))
    let p = dream_discover(ikg, lst(1, 2), lst(3, 4), 0)
    ce_check("pattern discovered", is_pattern(p) == 1)
    ce_eq("added to imagination kg", len(img_patterns(ikg)), before + 1)
    ce_eq("situation from first fragment", contains(pattern_situation(p), 1), 1)
    ce_eq("successor from second fragment", contains(pattern_successor(p), 3), 1)
}

fn main() {
    test_recombine()
    test_discover()
    ce_summary("dream_recombination")
}

main()
