// Unit tests for src/kg/louvain.nova (R12C).
//
// Covers the Louvain (Blondel 2008) two-phase modularity-optimisation
// community detector that ships beside R11F's label-propagation
// detector. Where R11F asks "which atoms VOTE together at the
// neighbour level", Louvain asks "what partition maximises Newman
// modularity greedily by repeatedly aggregating the local optimum".
// We exercise:
//   - extraction edge cases (empty, singleton, single-edge, two
//     disjoint pairs);
//   - the classic LPA fixtures (barbell 4+4+bridge, 3 disjoint
//     triangles) -- Louvain MUST match or beat R11F's modularity
//     since Louvain is provably modularity-maximising;
//   - the Zachary 1977 karate-club graph (34 nodes, 78 edges) --
//     Louvain finds 3..5 communities with modularity >= 350 milli;
//   - determinism (same seed -> same result);
//   - idempotence (rerunning on identical input gives identical
//     modularity);
//   - dendrogram shape (>= 1 level on any non-empty graph, depth
//     captures iterative coarsening);
//   - public API surface (louvain_label_at, louvain_community_count,
//     louvain_community_members, louvain_largest_community,
//     louvain_levels, louvain_dendrogram).
//
// Total assertions: ~50 (well above the 30-35 brief target).
//
// ADRs: ADR-0016 (atom + xref shape), ADR-0017 (xref is the link type
// we cluster), ADR-0049 (testing).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/cross_kg_references.nova"
import "../../src/kg/louvain.nova"

// ---- helpers --------------------------------------------------------------

// Build a fresh KG with `n` atoms, no xrefs. Returns the KG.
fn _mk_kg_n(label, n) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, label)
    let i = 0
    while i < n {
        kg_add_atom(kg, ATOM_FACT, "atom_" + int_to_str(i), 0)
        i = i + 1
    }
    return kg
}

// Wire an undirected link between two atoms by id. We push an xref on
// BOTH directions because the Louvain extractor treats the link graph
// as undirected (just like R11F's LPA extractor).
fn _link(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    let y = xref_new(b, a, XREF_SIMILAR, 900, 0)
    atom_add_xref(b, y)
    return 1
}

// Fully connect every pair in [start, start+size).
fn _clique(kg, start, size) {
    let i = 0
    while i < size {
        let j = i + 1
        while j < size {
            _link(kg, start + i, start + j)
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

// ---- extraction edge cases ------------------------------------------------

fn test_empty_kg_zero_communities() {
    let kg = _mk_kg_n("test_lv_empty", 0)
    let r = louvain_communities(kg, 10)
    ce_eq("empty KG -> 0 communities",   louvain_community_count(r), 0)
    ce_eq("empty KG -> 0 edges",         louvain_total_edges(r), 0)
    ce_eq("empty KG -> 0 levels",        louvain_levels(r), 0)
    ce_eq("largest community id = -1",   louvain_largest_community(r)[0], 0 - 1)
    ce_eq("largest community size = 0",  louvain_largest_community(r)[1], 0)
}

fn test_singleton_kg_one_community() {
    let kg = _mk_kg_n("test_lv_singleton", 1)
    let r = louvain_communities(kg, 10)
    ce_eq("singleton -> 1 community",    louvain_community_count(r), 1)
    ce_eq("singleton -> 0 edges",        louvain_total_edges(r), 0)
    let members = louvain_community_members(r, louvain_label_at(r, 0))
    ce_eq("singleton community has 1 member", len(members), 1)
    ce_eq("singleton community member id = 0", members[0], 0)
}

fn test_two_linked_atoms_one_community() {
    let kg = _mk_kg_n("test_lv_pair", 2)
    _link(kg, 0, 1)
    let r = louvain_communities(kg, 10)
    ce_eq("two linked atoms -> 1 community", louvain_community_count(r), 1)
    ce_eq("two linked atoms -> 1 edge",      louvain_total_edges(r), 1)
    // Both must share the same final community label.
    ce_eq("atoms 0 + 1 share a community",
        louvain_label_at(r, 0), louvain_label_at(r, 1))
}

fn test_two_disconnected_pairs_two_communities() {
    let kg = _mk_kg_n("test_lv_pairs", 4)
    _link(kg, 0, 1)
    _link(kg, 2, 3)
    let r = louvain_communities(kg, 10)
    ce_eq("two disconnected pairs -> 2 communities",
        louvain_community_count(r), 2)
    ce_eq("two pairs -> 2 edges total",  louvain_total_edges(r), 2)
    ce_eq("0 + 1 same community",
        louvain_label_at(r, 0), louvain_label_at(r, 1))
    ce_eq("2 + 3 same community",
        louvain_label_at(r, 2), louvain_label_at(r, 3))
    ce_check("0 + 2 different communities",
        louvain_label_at(r, 0) != louvain_label_at(r, 2))
}

// ---- barbell fixture (Louvain >= R11F's 423 milli) -----------------------
//
// Same fixture as test_graph_clustering's barbell test: two 4-cliques
// joined by a single bridge edge. R11F's LPA reports modularity = 423
// milli; Louvain MUST equal or exceed that since it greedily maximises
// modularity (the barbell is small enough that both algorithms reach
// the same global optimum).
fn test_barbell_two_communities() {
    let kg = _mk_kg_n("test_lv_barbell", 8)
    _clique(kg, 0, 4)   // atoms 0..3
    _clique(kg, 4, 4)   // atoms 4..7
    _link(kg, 3, 4)     // the bridge
    let r = louvain_communities(kg, 10)
    ce_eq("barbell edge count = 13", louvain_total_edges(r), 13)
    ce_eq("barbell -> 2 communities", louvain_community_count(r), 2)
    // Clique interiors stay together.
    ce_eq("left interior 0 + 1 same",
        louvain_label_at(r, 0), louvain_label_at(r, 1))
    ce_eq("left interior 0 + 2 same",
        louvain_label_at(r, 0), louvain_label_at(r, 2))
    ce_eq("right interior 5 + 6 same",
        louvain_label_at(r, 5), louvain_label_at(r, 6))
    ce_eq("right interior 5 + 7 same",
        louvain_label_at(r, 5), louvain_label_at(r, 7))
    ce_check("left interior 0 != right interior 5",
        louvain_label_at(r, 0) != louvain_label_at(r, 5))
    // Modularity must equal or exceed R11F's 423 milli (Louvain >= LPA).
    let q = louvain_modularity(kg, r)
    ce_check("barbell modularity >= R11F's 423 milli", q >= 423)
    ce_check("modularity <= 1000 milli", q <= 1000)
}

// ---- 3-clique fixture (Louvain >= R11F's 667 milli) ---------------------
fn test_three_disjoint_triangles_three_communities() {
    let kg = _mk_kg_n("test_lv_3clique", 9)
    _clique(kg, 0, 3)
    _clique(kg, 3, 3)
    _clique(kg, 6, 3)
    let r = louvain_communities(kg, 10)
    ce_eq("3-clique edge count = 9", louvain_total_edges(r), 9)
    ce_eq("3-clique -> 3 communities", louvain_community_count(r), 3)
    ce_eq("triangle 1: 0 + 1 same",
        louvain_label_at(r, 0), louvain_label_at(r, 1))
    ce_eq("triangle 1: 0 + 2 same",
        louvain_label_at(r, 0), louvain_label_at(r, 2))
    ce_eq("triangle 2: 3 + 4 same",
        louvain_label_at(r, 3), louvain_label_at(r, 4))
    ce_eq("triangle 2: 3 + 5 same",
        louvain_label_at(r, 3), louvain_label_at(r, 5))
    ce_eq("triangle 3: 6 + 7 same",
        louvain_label_at(r, 6), louvain_label_at(r, 7))
    ce_eq("triangle 3: 6 + 8 same",
        louvain_label_at(r, 6), louvain_label_at(r, 8))
    ce_check("triangle 1 != triangle 2",
        louvain_label_at(r, 0) != louvain_label_at(r, 3))
    ce_check("triangle 1 != triangle 3",
        louvain_label_at(r, 0) != louvain_label_at(r, 6))
    ce_check("triangle 2 != triangle 3",
        louvain_label_at(r, 3) != louvain_label_at(r, 6))
    // Modularity must equal or exceed R11F's 667 milli.
    let q = louvain_modularity(kg, r)
    ce_check("3-clique modularity >= R11F's 667 milli", q >= 667)
}

// ---- Zachary 1977 karate-club graph -------------------------------------
//
// The gold-standard community-detection benchmark: 34 club members,
// 78 friendship edges, real-world data that famously split into two
// factions after Mr. Hi (atom 0) and John A. (atom 33) fell out. The
// Louvain paper's textbook result is 4 communities, modularity ~0.44.
// At our deterministic seed (default 0), Louvain finds 3 communities
// with modularity around 0.40 milli (399 milli on this seed) -- 3..5
// matches the brief's expected range, and 399 > 350 milli clears the
// brief's threshold. R11F's LPA reports ~256 milli; Louvain wins by
// ~143 milli (~56% relative improvement). Edge count = 78.
fn _build_karate(label) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, label)
    let i = 0
    while i < 34 {
        kg_add_atom(kg, ATOM_FACT, "k_" + int_to_str(i), 0)
        i = i + 1
    }
    // Mr. Hi (0) -- his clique (atoms 1..21,31).
    _link(kg, 0, 1)   _link(kg, 0, 2)   _link(kg, 0, 3)   _link(kg, 0, 4)
    _link(kg, 0, 5)   _link(kg, 0, 6)   _link(kg, 0, 7)   _link(kg, 0, 8)
    _link(kg, 0, 10)  _link(kg, 0, 11)  _link(kg, 0, 12)  _link(kg, 0, 13)
    _link(kg, 0, 17)  _link(kg, 0, 19)  _link(kg, 0, 21)  _link(kg, 0, 31)
    // Atom 1 chain.
    _link(kg, 1, 2)   _link(kg, 1, 3)   _link(kg, 1, 7)   _link(kg, 1, 13)
    _link(kg, 1, 17)  _link(kg, 1, 19)  _link(kg, 1, 21)  _link(kg, 1, 30)
    // Atom 2 chain (bridges to John's side via 28, 32).
    _link(kg, 2, 3)   _link(kg, 2, 7)   _link(kg, 2, 8)   _link(kg, 2, 9)
    _link(kg, 2, 13)  _link(kg, 2, 27)  _link(kg, 2, 28)  _link(kg, 2, 32)
    // Atom 3 chain.
    _link(kg, 3, 7)   _link(kg, 3, 12)  _link(kg, 3, 13)
    // Atoms 4-6: small periphery cluster (4-5-6, 4-10).
    _link(kg, 4, 6)   _link(kg, 4, 10)
    _link(kg, 5, 6)   _link(kg, 5, 10)  _link(kg, 5, 16)
    _link(kg, 6, 16)
    // John's side: 30, 32, 33 hub plus connectors.
    _link(kg, 8, 30)  _link(kg, 8, 32)  _link(kg, 8, 33)
    _link(kg, 9, 33)
    _link(kg, 13, 33)
    _link(kg, 14, 32) _link(kg, 14, 33)
    _link(kg, 15, 32) _link(kg, 15, 33)
    _link(kg, 18, 32) _link(kg, 18, 33)
    _link(kg, 19, 33)
    _link(kg, 20, 32) _link(kg, 20, 33)
    _link(kg, 22, 32) _link(kg, 22, 33)
    _link(kg, 23, 25) _link(kg, 23, 27) _link(kg, 23, 29) _link(kg, 23, 32) _link(kg, 23, 33)
    _link(kg, 24, 25) _link(kg, 24, 27) _link(kg, 24, 31)
    _link(kg, 25, 31)
    _link(kg, 26, 29) _link(kg, 26, 33)
    _link(kg, 27, 33)
    _link(kg, 28, 31) _link(kg, 28, 33)
    _link(kg, 29, 32) _link(kg, 29, 33)
    _link(kg, 30, 32) _link(kg, 30, 33)
    _link(kg, 31, 32) _link(kg, 31, 33)
    _link(kg, 32, 33)
    return kg
}

fn test_karate_club_modularity_high() {
    let kg = _build_karate("test_lv_karate")
    let r = louvain_communities(kg, 10)
    // Edge count = 78 (Zachary's exact count).
    ce_eq("karate edge count = 78", louvain_total_edges(r), 78)
    // Community count in [3, 5] -- Louvain's classic result band.
    let n = louvain_community_count(r)
    ce_check("karate communities in [3, 5]", n >= 3)
    ce_check("karate communities <= 5",       n <= 5)
    // Modularity strictly above the brief's 350-milli threshold.
    let q = louvain_modularity(kg, r)
    ce_check("karate modularity > 350 milli", q > 350)
    ce_check("karate modularity <= 1000 milli", q <= 1000)
    // Mr. Hi (atom 0) lands in some community.
    ce_check("Mr Hi (atom 0) gets a valid community",
        louvain_label_at(r, 0) >= 0)
    // John (atom 33) lands in some community.
    ce_check("John (atom 33) gets a valid community",
        louvain_label_at(r, 33) >= 0)
    // The depth of the dendrogram is at least 2 (Louvain must coarsen
    // at least once on a graph this dense).
    ce_check("karate depth >= 2", louvain_levels(r) >= 2)
}

// ---- determinism (same seed -> same result) -----------------------------

fn test_same_seed_same_result() {
    let kg_a = _mk_kg_n("test_lv_seed_a", 6)
    _clique(kg_a, 0, 3)
    _clique(kg_a, 3, 3)
    let r_a = louvain_communities_seeded(kg_a, 10, 1234)

    let kg_b = _mk_kg_n("test_lv_seed_b", 6)
    _clique(kg_b, 0, 3)
    _clique(kg_b, 3, 3)
    let r_b = louvain_communities_seeded(kg_b, 10, 1234)

    ce_eq("same seed -> same community count",
        louvain_community_count(r_a), louvain_community_count(r_b))
    let i = 0
    while i < 6 {
        ce_eq("same seed -> identical community at " + int_to_str(i),
            louvain_label_at(r_a, i), louvain_label_at(r_b, i))
        i = i + 1
    }
}

// ---- stability (rerun on identical input is idempotent in modularity) ---
//
// Even though community ids might be re-minted (the integer label
// values are fresh-allocated per run), the PARTITION SHAPE is stable
// across runs, so modularity is identical run-to-run.
fn test_idempotent_modularity() {
    let kg = _build_karate("test_lv_idem")
    let r1 = louvain_communities(kg, 10)
    let q1 = louvain_modularity(kg, r1)
    let r2 = louvain_communities(kg, 10)
    let q2 = louvain_modularity(kg, r2)
    let r3 = louvain_communities(kg, 10)
    let q3 = louvain_modularity(kg, r3)
    ce_eq("re-run #1 -> same modularity", q1, q2)
    ce_eq("re-run #2 -> same modularity", q2, q3)
    ce_eq("re-run -> same community count",
        louvain_community_count(r1), louvain_community_count(r2))
}

// ---- dendrogram shape ---------------------------------------------------

fn test_dendrogram_records_levels() {
    let kg = _build_karate("test_lv_dend")
    let r = louvain_communities(kg, 10)
    let dend = louvain_dendrogram(r)
    ce_check("dendrogram has at least 1 level", len(dend) >= 1)
    ce_eq("dendrogram length = levels recorded",
        len(dend), louvain_levels(r))
    // Each dendrogram entry should have shape [n_communities,
    // labels_for_each_atom_id]; the labels list length matches the
    // atom_ids count.
    if len(dend) > 0 {
        let lvl0 = dend[0]
        let n_comm0 = lvl0[0]
        let labels0 = lvl0[1]
        ce_check("level 0 records >= 1 community", n_comm0 >= 1)
        ce_eq("level 0 labels list has 34 entries (karate)",
            len(labels0), 34)
    }
}

fn test_dendrogram_coarsens_monotonically() {
    let kg = _build_karate("test_lv_mono")
    let r = louvain_communities(kg, 10)
    let dend = louvain_dendrogram(r)
    // Each level's community count must be <= the previous level's
    // (Louvain only ever MERGES; it never splits).
    let i = 1
    let monotone = 1
    while i < len(dend) {
        let prev_n = dend[i - 1][0]
        let cur_n = dend[i][0]
        if cur_n > prev_n { monotone = 0 }
        i = i + 1
    }
    ce_check("dendrogram community count monotonically non-increasing",
        monotone == 1)
}

// ---- public API surface -------------------------------------------------

fn test_largest_community_picks_biggest() {
    let kg = _mk_kg_n("test_lv_largest", 6)
    _clique(kg, 0, 5)   // atoms 0..4 form a 5-clique
    // atom 5 is isolated; it's its own community
    let r = louvain_communities(kg, 10)
    let big = louvain_largest_community(r)
    ce_eq("largest community has 5 members", big[1], 5)
    let members = louvain_community_members(r, big[0])
    ce_eq("largest community member list len = 5", len(members), 5)
    ce_eq("member 0 = 0", members[0], 0)
    ce_eq("member 1 = 1", members[1], 1)
    ce_eq("member 2 = 2", members[2], 2)
    ce_eq("member 3 = 3", members[3], 3)
    ce_eq("member 4 = 4", members[4], 4)
}

fn test_community_members_missing_returns_empty() {
    let kg = _mk_kg_n("test_lv_missing", 2)
    _link(kg, 0, 1)
    let r = louvain_communities(kg, 10)
    let members = louvain_community_members(r, 9999)
    ce_eq("missing community -> empty member list", len(members), 0)
}

fn test_label_at_missing_atom() {
    let kg = _mk_kg_n("test_lv_missing_aid", 3)
    _link(kg, 0, 1)
    let r = louvain_communities(kg, 10)
    ce_eq("label_at(missing atom id) = -1",
        louvain_label_at(r, 100), 0 - 1)
}

fn test_modularity_empty_graph() {
    let kg = _mk_kg_n("test_lv_mod_empty", 0)
    let r = louvain_communities(kg, 10)
    ce_eq("modularity on empty graph = 0",
        louvain_modularity(kg, r), 0)
}

// ---- max_iter clamp -----------------------------------------------------

fn test_max_iter_zero_uses_default() {
    let kg = _mk_kg_n("test_lv_mxz", 4)
    _clique(kg, 0, 2)
    _clique(kg, 2, 2)
    let r_def = louvain_communities(kg, LV_DEFAULT_MAX_ITER)
    let r_zero = louvain_communities(kg, 0)
    ce_eq("max_iter=0 -> same community count as default",
        louvain_community_count(r_def), louvain_community_count(r_zero))
}

fn main() {
    test_empty_kg_zero_communities()
    test_singleton_kg_one_community()
    test_two_linked_atoms_one_community()
    test_two_disconnected_pairs_two_communities()
    test_barbell_two_communities()
    test_three_disjoint_triangles_three_communities()
    test_karate_club_modularity_high()
    test_same_seed_same_result()
    test_idempotent_modularity()
    test_dendrogram_records_levels()
    test_dendrogram_coarsens_monotonically()
    test_largest_community_picks_biggest()
    test_community_members_missing_returns_empty()
    test_label_at_missing_atom()
    test_modularity_empty_graph()
    test_max_iter_zero_uses_default()
    ce_summary("louvain")
}

main()
