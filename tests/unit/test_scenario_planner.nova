// Unit tests for src/parts/imagination/scenario_planner.nova
// Verifies branching expansion, goal-based scoring, and best/worst selection.
// ADR-0032.

import "../ce_test.nova"
import "../../src/parts/imagination/scenario_planner.nova"

fn one(a) { let l = list_new(); push(l, a); return l }
fn lst(a, b) { let l = list_new(); push(l, a); push(l, b); return l }

// Decision 10 (with 1) -> reaches goal 4; decision 20 (with 1) -> reaches 5.
fn build() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    pattern_new(ikg, "pa", lst(1, 10), one(4), 0)
    pattern_new(ikg, "pb", lst(1, 20), one(5), 0)
    return ikg
}

fn test_scenarios() {
    let ikg = build()
    let decisions = lst(10, 20)
    let goals = one(4)
    let scen = scenario_expand(ikg, one(1), decisions, goals, 2, 0)
    ce_eq("two scenarios", len(scen), 2)
    let best = scenario_best(scen)
    ce_eq("best decision is 10", scenario_decision(best), 10)
    ce_eq("best reaches goal", scenario_score(best), 1)
    let worst = scenario_worst(scen)
    ce_eq("worst decision is 20", scenario_decision(worst), 20)
    ce_eq("worst misses goal", scenario_score(worst), 0)
    ce_eq("best outcome contains goal", contains(scenario_outcome(best), 4), 1)
}

fn main() {
    test_scenarios()
    ce_summary("scenario_planner")
}

main()
