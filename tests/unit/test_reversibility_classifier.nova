// Unit tests for src/safety/reversibility_classifier.nova
// Verifies the three reversibility classes, the fail-safe default for unlisted
// action types, and the action-class name table. ADR-0042.

import "../ce_test.nova"
import "../../src/safety/reversibility_classifier.nova"

// Reversible actions: read-only / re-fetchable / recall (clean undo).
fn test_reversible() {
    ce_eq("read_local reversible", reversibility_class(ACT_READ_LOCAL), REV_REVERSIBLE)
    ce_eq("net_fetch reversible", reversibility_class(ACT_NET_FETCH), REV_REVERSIBLE)
    ce_eq("recall reversible", reversibility_class(ACT_RECALL), REV_REVERSIBLE)
    ce_eq("reversible not irreversible", is_irreversible(ACT_READ_LOCAL), 0)
}

// Recoverable: undo possible but lossy/delayed (local write, soft delete, speak).
fn test_recoverable() {
    ce_eq("write_local recoverable", reversibility_class(ACT_WRITE_LOCAL), REV_RECOVERABLE)
    ce_eq("delete recoverable", reversibility_class(ACT_DELETE), REV_RECOVERABLE)
    ce_eq("speak recoverable", reversibility_class(ACT_SPEAK), REV_RECOVERABLE)
    ce_eq("recoverable not irreversible", is_irreversible(ACT_DELETE), 0)
}

// Irreversible: no undo. Includes the fail-safe default for unknown types.
fn test_irreversible_and_failsafe() {
    ce_eq("send_msg irreversible", reversibility_class(ACT_SEND_MSG), REV_IRREVERSIBLE)
    ce_eq("hard_delete irreversible", reversibility_class(ACT_HARD_DELETE), REV_IRREVERSIBLE)
    ce_eq("spend irreversible", reversibility_class(ACT_SPEND), REV_IRREVERSIBLE)
    ce_eq("self_modify irreversible", reversibility_class(ACT_SELF_MODIFY), REV_IRREVERSIBLE)
    ce_eq("is_irreversible flag", is_irreversible(ACT_SEND_MSG), 1)
    // Unlisted action type (0, and a large id) -> safest class.
    ce_eq("unknown id 0 fail-safe", reversibility_class(0), REV_IRREVERSIBLE)
    ce_eq("unknown id 999 fail-safe", reversibility_class(999), REV_IRREVERSIBLE)
    ce_eq("unknown is_irreversible", is_irreversible(999), 1)
}

// Name tables round-trip and unknowns degrade gracefully.
fn test_names() {
    ce_str_eq("act name", act_name(ACT_HARD_DELETE), "hard_delete")
    ce_str_eq("act name speak", act_name(ACT_SPEAK), "speak")
    ce_str_eq("act name unknown", act_name(0), "unknown")
    ce_str_eq("rev name", rev_class_name(REV_IRREVERSIBLE), "irreversible")
    ce_str_eq("rev name unknown", rev_class_name(0), "unknown")
}

fn main() {
    test_reversible()
    test_recoverable()
    test_irreversible_and_failsafe()
    test_names()
    ce_summary("reversibility_classifier")
}
main()
