// R92 X.509 test-cert builder.
//
// Assembles minimum-shape RFC 5280 + RFC 8410 Ed25519 certificates
// programmatically from parts, then signs them with `ed25519_sign`
// so the resulting DER can be fed straight into `x509_parse` +
// `x509_chain_verify` for a round-trip test. Preferred over hand-
// authored hex-literal fixtures: the DER assembly is auditable in
// NOVA, and the signature always corresponds to the current TBS bytes
// (no risk of a stale hex fixture drifting out of sync with the
// parser's byte-exact expectations for `tbs_off..tbs_off + tbs_len`).
//
// Not a production module. Every field is caller-provided (subject CN,
// issuer CN, validity window strings, SPKI pubkey, signing seed) so
// the fixture supports every negative-path test the R92 spec calls
// for without special-casing the builder.
//
// NOVA dependencies: ed25519 (for signing).
// CrossEngin dependencies: src/safety/ed25519.nova.

import "../../../src/safety/ed25519.nova"

// ---- byte-list plumbing --------------------------------------------------

// Append every byte of `src` to `dst`. `src` and `dst` are byte lists.
fn _fx_append(dst, src) {
    let i = 0
    let n = len(src)
    while i < n {
        push(dst, src[i])
        i = i + 1
    }
}

// Encode a DER definite-length length field into a fresh byte list.
// Short form for L < 128; long form for larger. Cap at 4 length bytes
// (matches DER_MAX_LEN_BYTES in src/net/tls/der.nova).
fn _fx_encode_length(l) {
    let out = list_new()
    if l < 128 {
        push(out, l)
        return out
    }
    if l < 256 {
        push(out, 129)   // 0x81
        push(out, l)
        return out
    }
    if l < 65536 {
        push(out, 130)   // 0x82
        push(out, int_and(int_shr(l, 8), 255))
        push(out, int_and(l, 255))
        return out
    }
    if l < 16777216 {
        push(out, 131)   // 0x83
        push(out, int_and(int_shr(l, 16), 255))
        push(out, int_and(int_shr(l, 8),  255))
        push(out, int_and(l,               255))
        return out
    }
    push(out, 132)   // 0x84
    push(out, int_and(int_shr(l, 24), 255))
    push(out, int_and(int_shr(l, 16), 255))
    push(out, int_and(int_shr(l,  8), 255))
    push(out, int_and(l,               255))
    return out
}

// Wrap `content` (byte list) as TLV under `tag`. Returns a fresh
// byte list.
fn _fx_wrap_tlv(tag, content) {
    let out = list_new()
    push(out, tag)
    let ln = _fx_encode_length(len(content))
    _fx_append(out, ln)
    _fx_append(out, content)
    return out
}

// Turn an ASCII NOVA string into a byte list (safe for str_eq-flaky
// content because we walk char_at bytes, never str-compare).
fn _fx_str_bytes(s) {
    let out = list_new()
    let i = 0
    let n = len(s)
    while i < n {
        push(out, char_at(s, i))
        i = i + 1
    }
    return out
}

// ---- primitive DER encoders ---------------------------------------------

// INTEGER (small positive, 0..127). For our fixture the serial number
// stays tiny; a leading 0x00 padding byte is unnecessary while the top
// bit is clear.
fn _fx_der_int_small(n) {
    let c = list_new()
    if n < 128 {
        push(c, n)
    } else {
        // Prepend 0x00 to keep it unsigned per DER canonical form.
        push(c, 0)
        push(c, n)
    }
    return _fx_wrap_tlv(2, c)   // INTEGER tag = 0x02
}

// Version wrapper: [0] EXPLICIT INTEGER 2 (v3). Full TLV:
//   A0 03 02 01 02.
fn _fx_der_version_v3() {
    let inner = _fx_der_int_small(2)
    return _fx_wrap_tlv(160, inner)   // 0xA0 == DER_CONTEXT_0
}

// AlgorithmIdentifier for Ed25519: SEQUENCE { OID 1.3.101.112 }.
// Content bytes: 06 03 2B 65 70.
fn _fx_der_ed25519_algid() {
    let oid = list_new()
    push(oid, 43)    // 0x2B
    push(oid, 101)   // 0x65
    push(oid, 112)   // 0x70
    let oid_tlv = _fx_wrap_tlv(6, oid)   // OID tag = 0x06
    return _fx_wrap_tlv(48, oid_tlv)     // SEQUENCE = 0x30
}

// AlgorithmIdentifier with a bogus (RSA-looking) OID -- for the
// "reject non-Ed25519 alg" test. rsaEncryption = 1.2.840.113549.1.1.1
// = 06 09 2A 86 48 86 F7 0D 01 01 01. Sig alg for RSA is
// sha256WithRSAEncryption 1.2.840.113549.1.1.11.
fn _fx_der_rsa_algid() {
    let oid = list_new()
    push(oid, 42)    // 0x2A
    push(oid, 134)   // 0x86
    push(oid, 72)    // 0x48
    push(oid, 134)   // 0x86
    push(oid, 247)   // 0xF7
    push(oid, 13)    // 0x0D
    push(oid, 1)
    push(oid, 1)
    push(oid, 11)
    let oid_tlv = _fx_wrap_tlv(6, oid)
    // NULL parameters are typical for RSA OIDs (05 00).
    let null_tlv = list_new()
    push(null_tlv, 5)
    push(null_tlv, 0)
    let content = list_new()
    _fx_append(content, oid_tlv)
    _fx_append(content, null_tlv)
    return _fx_wrap_tlv(48, content)
}

// Name = SEQUENCE OF RelativeDistinguishedName (one RDN, one CN
// attribute). CN OID content = 55 04 03. AttributeValue as
// UTF8String (tag 0x0C).
fn _fx_der_name_with_cn(cn_str) {
    let cn_oid = list_new()
    push(cn_oid, 85)   // 0x55
    push(cn_oid, 4)
    push(cn_oid, 3)
    let cn_oid_tlv = _fx_wrap_tlv(6, cn_oid)
    let cn_bytes = _fx_str_bytes(cn_str)
    let cn_val_tlv = _fx_wrap_tlv(12, cn_bytes)  // UTF8String = 0x0C
    let atv_content = list_new()
    _fx_append(atv_content, cn_oid_tlv)
    _fx_append(atv_content, cn_val_tlv)
    let atv_tlv = _fx_wrap_tlv(48, atv_content)  // SEQUENCE
    let set_tlv = _fx_wrap_tlv(49, atv_tlv)      // SET = 0x31
    return _fx_wrap_tlv(48, set_tlv)             // outer Name SEQUENCE
}

// Validity SEQUENCE { UTCTime notBefore, UTCTime notAfter }. Time
// strings are 13-char "YYMMDDHHMMSSZ" -- the caller's responsibility.
// Passing a non-Z-suffix string produces a cert the parser will
// reject on the time-parse step (used by the negative time-parsing
// test).
fn _fx_der_validity_utc(nb_str, na_str) {
    let nb = _fx_str_bytes(nb_str)
    let na = _fx_str_bytes(na_str)
    let nb_tlv = _fx_wrap_tlv(23, nb)   // UTCTime = 0x17
    let na_tlv = _fx_wrap_tlv(23, na)
    let c = list_new()
    _fx_append(c, nb_tlv)
    _fx_append(c, na_tlv)
    return _fx_wrap_tlv(48, c)
}

// SubjectPublicKeyInfo. `pubkey_32` MUST be a 32-byte list (Ed25519
// pubkey). The BIT STRING carries 0 unused bits.
fn _fx_der_spki_ed25519(pubkey_32) {
    let bs_content = list_new()
    push(bs_content, 0)     // unused-bits count
    _fx_append(bs_content, pubkey_32)
    let bs_tlv = _fx_wrap_tlv(3, bs_content)   // BIT STRING = 0x03
    let c = list_new()
    _fx_append(c, _fx_der_ed25519_algid())
    _fx_append(c, bs_tlv)
    return _fx_wrap_tlv(48, c)
}

// Non-critical extension SEQUENCE with an unknown OID and empty
// OCTET STRING content. Used to prove the parser tolerates non-
// critical extensions.
fn _fx_der_unknown_ext_noncritical() {
    // Use OID 1.3.6.1.4.1.99999.1 (private enterprise, made-up).
    // subidentifier encoding of 99999: 0x86 0x8D 0x1F.
    // Actually easier: use a shorter OID 1.3.6.1.4.1.1 = 06 07 2B 06 01 04 01 01
    let oid = list_new()
    push(oid, 43)   // 1.3
    push(oid, 6)
    push(oid, 1)
    push(oid, 4)
    push(oid, 1)
    push(oid, 1)
    let oid_tlv = _fx_wrap_tlv(6, oid)
    let os_tlv = _fx_wrap_tlv(4, list_new())   // OCTET STRING with empty content
    let c = list_new()
    _fx_append(c, oid_tlv)
    _fx_append(c, os_tlv)
    return _fx_wrap_tlv(48, c)
}

// Critical extension SEQUENCE with an unknown OID -- the parser MUST
// refuse a cert containing this.
fn _fx_der_unknown_ext_critical() {
    let oid = list_new()
    push(oid, 43)
    push(oid, 6)
    push(oid, 1)
    push(oid, 4)
    push(oid, 1)
    push(oid, 1)
    let oid_tlv = _fx_wrap_tlv(6, oid)
    // BOOLEAN true = 01 01 FF (0xFF is DER-canonical for true).
    let bool_tlv = list_new()
    push(bool_tlv, 1)
    push(bool_tlv, 1)
    push(bool_tlv, 255)
    let os_tlv = _fx_wrap_tlv(4, list_new())
    let c = list_new()
    _fx_append(c, oid_tlv)
    _fx_append(c, bool_tlv)
    _fx_append(c, os_tlv)
    return _fx_wrap_tlv(48, c)
}

// [3] EXPLICIT SEQUENCE OF Extension wrapper.
fn _fx_der_extensions_wrapper(ext_list) {
    let seq = _fx_wrap_tlv(48, ext_list)   // inner SEQUENCE OF Extension
    return _fx_wrap_tlv(163, seq)          // 0xA3 == DER_CONTEXT_3
}

// ---- TBS + Certificate assembly -----------------------------------------

// Build a TBSCertificate as a byte list. `extensions_bytes` may be
// empty; if non-empty it should be an already-wrapped [3] EXPLICIT
// blob (via _fx_der_extensions_wrapper).
fn _fx_build_tbs(serial, sig_algid, issuer_cn, validity, subject_cn,
                 spki, extensions_bytes) {
    let tbs_content = list_new()
    _fx_append(tbs_content, _fx_der_version_v3())
    _fx_append(tbs_content, _fx_der_int_small(serial))
    _fx_append(tbs_content, sig_algid)
    _fx_append(tbs_content, _fx_der_name_with_cn(issuer_cn))
    _fx_append(tbs_content, validity)
    _fx_append(tbs_content, _fx_der_name_with_cn(subject_cn))
    _fx_append(tbs_content, spki)
    _fx_append(tbs_content, extensions_bytes)
    return _fx_wrap_tlv(48, tbs_content)
}

// Full Certificate assembly. `tbs_bytes` is signed with `signer_seed`
// / `signer_pubkey` (Ed25519 signing needs both -- the seed derives
// the scalar, the pubkey is fed into the k = SHA-512(R || A || M)
// hash). `outer_algid` is expected to byte-equal the inner sigalg
// used in `tbs_bytes` -- the R92 parser enforces that equality.
fn _fx_build_cert(tbs_bytes, outer_algid, signer_seed, signer_pubkey) {
    let sig = ed25519_sign(tbs_bytes, signer_seed, signer_pubkey)
    let bs_content = list_new()
    push(bs_content, 0)
    _fx_append(bs_content, sig)
    let bs_tlv = _fx_wrap_tlv(3, bs_content)   // BIT STRING
    let c = list_new()
    _fx_append(c, tbs_bytes)
    _fx_append(c, outer_algid)
    _fx_append(c, bs_tlv)
    return _fx_wrap_tlv(48, c)
}

// ---- public builders -----------------------------------------------------

// x509_build_test_cert: happy-path Ed25519 leaf-or-root cert.
//   subject_cn      -- CN string for the subject Name (Common Name).
//   issuer_cn       -- CN string for the issuer Name.
//   serial          -- small positive int for the serial number.
//   nb_utc          -- 13-char UTCTime "YYMMDDHHMMSSZ" for notBefore.
//   na_utc          -- 13-char UTCTime "YYMMDDHHMMSSZ" for notAfter.
//   spki_pubkey_32  -- 32-byte Ed25519 public key placed in SPKI.
//   signer_seed_32  -- 32-byte Ed25519 seed used to sign the TBS.
//   signer_pubkey_32 -- 32-byte Ed25519 pubkey matching signer_seed_32.
//     (For a self-signed cert, signer_pubkey_32 == spki_pubkey_32.)
//
// Returns the fully-assembled cert byte list. Feed into x509_parse.
fn x509_build_test_cert(subject_cn, issuer_cn, serial, nb_utc, na_utc,
                        spki_pubkey_32, signer_seed_32, signer_pubkey_32) {
    let sig_algid = _fx_der_ed25519_algid()
    let outer_algid = _fx_der_ed25519_algid()
    let validity = _fx_der_validity_utc(nb_utc, na_utc)
    let spki = _fx_der_spki_ed25519(spki_pubkey_32)
    let empty = list_new()
    let tbs = _fx_build_tbs(serial, sig_algid, issuer_cn, validity,
                            subject_cn, spki, empty)
    return _fx_build_cert(tbs, outer_algid, signer_seed_32, signer_pubkey_32)
}

// x509_build_test_cert_with_ext: same as above but also embeds an
// [3] EXPLICIT extensions block. `critical_flag` selects between the
// non-critical (0) and critical (1) unknown-extension shapes.
fn x509_build_test_cert_with_ext(subject_cn, issuer_cn, serial,
                                 nb_utc, na_utc,
                                 spki_pubkey_32, signer_seed_32,
                                 signer_pubkey_32, critical_flag) {
    let sig_algid = _fx_der_ed25519_algid()
    let outer_algid = _fx_der_ed25519_algid()
    let validity = _fx_der_validity_utc(nb_utc, na_utc)
    let spki = _fx_der_spki_ed25519(spki_pubkey_32)
    let ext_body = list_new()
    if critical_flag == 1 {
        _fx_append(ext_body, _fx_der_unknown_ext_critical())
    } else {
        _fx_append(ext_body, _fx_der_unknown_ext_noncritical())
    }
    let ext_wrapper = _fx_der_extensions_wrapper(ext_body)
    let tbs = _fx_build_tbs(serial, sig_algid, issuer_cn, validity,
                            subject_cn, spki, ext_wrapper)
    return _fx_build_cert(tbs, outer_algid, signer_seed_32, signer_pubkey_32)
}

// x509_build_test_cert_bad_alg: leaf built with RSA OIDs everywhere
// the parser expects Ed25519. Signature is faked (rubbish 64 bytes)
// because the RSA-alg cert would never satisfy `x509_parse` anyway
// (alg check runs before the signature check).
fn x509_build_test_cert_bad_alg(subject_cn, issuer_cn, serial,
                                nb_utc, na_utc, spki_pubkey_32) {
    let sig_algid = _fx_der_rsa_algid()
    let outer_algid = _fx_der_rsa_algid()
    let validity = _fx_der_validity_utc(nb_utc, na_utc)
    // SPKI keeps its structure but uses the bogus alg-id.
    let bs_content = list_new()
    push(bs_content, 0)
    _fx_append(bs_content, spki_pubkey_32)
    let bs_tlv = _fx_wrap_tlv(3, bs_content)
    let spki_content = list_new()
    _fx_append(spki_content, _fx_der_rsa_algid())
    _fx_append(spki_content, bs_tlv)
    let spki = _fx_wrap_tlv(48, spki_content)
    let empty = list_new()
    let tbs = _fx_build_tbs(serial, sig_algid, issuer_cn, validity,
                            subject_cn, spki, empty)
    // Fake 64-byte signature payload (won't be checked -- parse fails first).
    let fake_sig = list_new()
    let i = 0
    while i < 64 { push(fake_sig, 0); i = i + 1 }
    let bs2_content = list_new()
    push(bs2_content, 0)
    _fx_append(bs2_content, fake_sig)
    let bs2_tlv = _fx_wrap_tlv(3, bs2_content)
    let c = list_new()
    _fx_append(c, tbs)
    _fx_append(c, outer_algid)
    _fx_append(c, bs2_tlv)
    return _fx_wrap_tlv(48, c)
}

// x509_build_test_cert_non_z_time: notBefore uses a non-Z timezone
// suffix ("+0000") in a GeneralizedTime string, which the parser
// rejects.
fn x509_build_test_cert_non_z_time(subject_cn, issuer_cn, serial,
                                   spki_pubkey_32, signer_seed_32,
                                   signer_pubkey_32) {
    let sig_algid = _fx_der_ed25519_algid()
    let outer_algid = _fx_der_ed25519_algid()
    // Build a validity with a bad time (GeneralizedTime "20200101000000+0000"
    // -- 19 bytes, no trailing 'Z'). Even though shorter validity content
    // would parse OK for its TLV wrapper, our time helper enforces the
    // fixed 13-byte / 15-byte length + Z suffix.
    let bad_nb = _fx_str_bytes("20200101000000")   // 14 bytes, no Z
    let bad_nb_tlv = _fx_wrap_tlv(24, bad_nb)      // GeneralizedTime
    let ok_na = _fx_str_bytes("500101000000Z")
    let ok_na_tlv = _fx_wrap_tlv(23, ok_na)
    let vc = list_new()
    _fx_append(vc, bad_nb_tlv)
    _fx_append(vc, ok_na_tlv)
    let validity = _fx_wrap_tlv(48, vc)
    let spki = _fx_der_spki_ed25519(spki_pubkey_32)
    let empty = list_new()
    let tbs = _fx_build_tbs(serial, sig_algid, issuer_cn, validity,
                            subject_cn, spki, empty)
    return _fx_build_cert(tbs, outer_algid, signer_seed_32, signer_pubkey_32)
}

// ---- convenience: RFC 8032 test keypairs --------------------------------
//
// Two well-known Ed25519 keypairs from RFC 8032 §7.1 (TEST 1 and
// TEST 2). Used as the root / leaf keys in the chain tests. These
// are literal test vectors, NOT production keys.

// Hex helper: parse a 64-char hex string into a 32-byte list.
fn _fx_hex32(hex_str) {
    let out = list_new()
    let i = 0
    while i < 32 {
        let a = char_at(hex_str, i * 2)
        let b = char_at(hex_str, i * 2 + 1)
        let hi = 0
        if a >= 48 { if a <= 57 { hi = a - 48 } }
        if a >= 97 { if a <= 102 { hi = a - 97 + 10 } }
        if a >= 65 { if a <= 70  { hi = a - 65 + 10 } }
        let lo = 0
        if b >= 48 { if b <= 57 { lo = b - 48 } }
        if b >= 97 { if b <= 102 { lo = b - 97 + 10 } }
        if b >= 65 { if b <= 70  { lo = b - 65 + 10 } }
        push(out, hi * 16 + lo)
        i = i + 1
    }
    return out
}

fn fx_ed25519_test1_seed() {
    return _fx_hex32("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
}
fn fx_ed25519_test1_pub() {
    return _fx_hex32("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
}
fn fx_ed25519_test2_seed() {
    return _fx_hex32("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
}
fn fx_ed25519_test2_pub() {
    return _fx_hex32("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
}
