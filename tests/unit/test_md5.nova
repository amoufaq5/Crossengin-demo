// Unit tests for src/safety/md5.nova (R37C canonical MD5).
//
// Coverage
//   * RFC 1321 §A.5 known-answer vectors:
//       - MD5("") = d41d8cd98f00b204e9800998ecf8427e
//       - MD5("a") = 0cc175b9c0f1b6a831c399e269772661
//       - MD5("abc") = 900150983cd24fb0d6963f7d28e17f72
//       - MD5("message digest") = f96b697d7cb7938d525a2f31aaf161d0
//       - MD5("abcdefghijklmnopqrstuvwxyz") = c3fcd3d76192e4007dfb496cca67e13b
//   * Boundary cases:
//       - MD5 over 56-byte input (one-block boundary at >= 56 byte mark
//         that forces a two-block padding)
//       - MD5 over 100-byte input (two-block input)
//       - MD5 over 55-byte input (one-block padding boundary at < 56)
//   * Streaming equivalence (md5_init / update / final) vs oneshot:
//       - empty input
//       - single update
//       - byte-at-a-time
//       - block-aligned 128 bytes
//       - straddle-boundary mixed updates
//   * md5_oneshot_str string wrapper round-trip.
//   * Constants assertion (MD5_HASH_LEN, MD5_BLOCK_LEN).
//
// References
//   RFC 1321 §3.4 / §A.5 -- MD5 spec + KAT vectors.
//
// NOVA dependencies: ce_test harness, md5.nova (R37C canonical).

import "../ce_test.nova"
import "../../src/safety/md5.nova"

// ---- helpers --------------------------------------------------------------

fn _tm_buf_from_str(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    let r = list_new()
    push(r, buf)
    push(r, n)
    return r
}

fn _tm_nibble_hex(n) {
    if n < 10 { return 48 + n }      // '0'..'9'
    return 87 + n                    // 'a'..'f'
}

fn _tm_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        let hi = _tm_nibble_hex(int_and(int_shr(b, 4), 15))
        let lo = _tm_nibble_hex(int_and(b, 15))
        s = s + chr(hi) + chr(lo)
        i = i + 1
    }
    return s
}

// ---- RFC 1321 §A.5 KAT vectors -------------------------------------------

fn test_md5_empty() {
    // RFC 1321 §A.5: MD5("") = d41d8cd98f00b204e9800998ecf8427e
    let buf = alloc(1)
    store8(buf, 0)
    let h = md5_oneshot(buf, 0)
    ce_str_eq("MD5('')",
        _tm_hex_encode_buf(h, 16),
        "d41d8cd98f00b204e9800998ecf8427e")
}

fn test_md5_a() {
    // RFC 1321 §A.5: MD5("a") = 0cc175b9c0f1b6a831c399e269772661
    let p = _tm_buf_from_str("a")
    let h = md5_oneshot(p[0], p[1])
    ce_str_eq("MD5('a')",
        _tm_hex_encode_buf(h, 16),
        "0cc175b9c0f1b6a831c399e269772661")
}

fn test_md5_abc() {
    // RFC 1321 §A.5: MD5("abc") = 900150983cd24fb0d6963f7d28e17f72
    let p = _tm_buf_from_str("abc")
    let h = md5_oneshot(p[0], p[1])
    ce_str_eq("MD5('abc')",
        _tm_hex_encode_buf(h, 16),
        "900150983cd24fb0d6963f7d28e17f72")
}

fn test_md5_message_digest() {
    // RFC 1321 §A.5: MD5("message digest") = f96b697d7cb7938d525a2f31aaf161d0
    let p = _tm_buf_from_str("message digest")
    let h = md5_oneshot(p[0], p[1])
    ce_str_eq("MD5('message digest')",
        _tm_hex_encode_buf(h, 16),
        "f96b697d7cb7938d525a2f31aaf161d0")
}

fn test_md5_alphabet() {
    // RFC 1321 §A.5: MD5("abcdefghijklmnopqrstuvwxyz")
    //                = c3fcd3d76192e4007dfb496cca67e13b
    let p = _tm_buf_from_str("abcdefghijklmnopqrstuvwxyz")
    let h = md5_oneshot(p[0], p[1])
    ce_str_eq("MD5('abcdefghijklmnopqrstuvwxyz')",
        _tm_hex_encode_buf(h, 16),
        "c3fcd3d76192e4007dfb496cca67e13b")
}

// ---- Boundary cases -------------------------------------------------------

fn test_md5_55_byte_input() {
    // 55 bytes: fits in one block including the 0x80 + 8B length tail
    // (rem = 55 -> need_two = 0). Edge of one-block padding.
    let n = 55
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 65); i = i + 1 }   // 'A' * 55
    store8(buf + n, 0)
    let h_one = md5_oneshot(buf, n)
    // Cross-verify via streaming.
    let st = md5_init()
    md5_update(st, buf, n)
    let h_stream = md5_final(st)
    ce_str_eq("MD5('A' * 55) one-block padding boundary streaming eq",
        _tm_hex_encode_buf(h_stream, 16),
        _tm_hex_encode_buf(h_one, 16))
}

fn test_md5_56_byte_input() {
    // 56 bytes: triggers two-block padding (rem = 56 -> need_two = 1).
    let n = 56
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 65); i = i + 1 }   // 'A' * 56
    store8(buf + n, 0)
    let h_one = md5_oneshot(buf, n)
    let st = md5_init()
    md5_update(st, buf, n)
    let h_stream = md5_final(st)
    ce_str_eq("MD5('A' * 56) two-block padding boundary streaming eq",
        _tm_hex_encode_buf(h_stream, 16),
        _tm_hex_encode_buf(h_one, 16))
}

fn test_md5_100_byte_input() {
    // 100 bytes: 1 full 64-byte block + 36-byte tail (needs single
    // padding block since 36 < 56).
    let n = 100
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 97); i = i + 1 }   // 'a' * 100
    store8(buf + n, 0)
    let h_one = md5_oneshot(buf, n)
    let st = md5_init()
    md5_update(st, buf, n)
    let h_stream = md5_final(st)
    ce_str_eq("MD5('a' * 100) two-block input streaming eq",
        _tm_hex_encode_buf(h_stream, 16),
        _tm_hex_encode_buf(h_one, 16))
}

// ---- Streaming equivalence ------------------------------------------------

fn test_md5_streaming_empty() {
    // md5_init + final (no update) = MD5("")
    let st = md5_init()
    let h = md5_final(st)
    ce_str_eq("streaming empty input matches oneshot",
        _tm_hex_encode_buf(h, 16),
        "d41d8cd98f00b204e9800998ecf8427e")
}

fn test_md5_streaming_single_update() {
    // Single update of "abc".
    let p = _tm_buf_from_str("abc")
    let st = md5_init()
    md5_update(st, p[0], p[1])
    let h = md5_final(st)
    ce_str_eq("streaming 'abc' single-update",
        _tm_hex_encode_buf(h, 16),
        "900150983cd24fb0d6963f7d28e17f72")
}

fn test_md5_streaming_byte_at_a_time() {
    // Feed each byte of "abc" through a separate update() call.
    // Tests the partial-buffer accumulation path.
    let p = _tm_buf_from_str("abc")
    let st = md5_init()
    let i = 0
    while i < p[1] {
        md5_update(st, p[0] + i, 1)
        i = i + 1
    }
    let h = md5_final(st)
    ce_str_eq("streaming 'abc' byte-at-a-time matches oneshot",
        _tm_hex_encode_buf(h, 16),
        "900150983cd24fb0d6963f7d28e17f72")
}

fn test_md5_streaming_block_aligned() {
    // 128-byte input (two full 64-byte blocks) fed as a single update.
    let n = 128
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, int_and(i, 255)); i = i + 1 }
    store8(buf + n, 0)
    let h_one = md5_oneshot(buf, n)
    let st = md5_init()
    md5_update(st, buf, n)
    let h_stream = md5_final(st)
    ce_str_eq("streaming matches oneshot on 128-byte block-aligned input",
        _tm_hex_encode_buf(h_stream, 16),
        _tm_hex_encode_buf(h_one, 16))
}

fn test_md5_streaming_straddle_block() {
    // 200-byte input fed in two updates that cross a block boundary.
    // Split point chosen so first update ends mid-block (37 bytes) and
    // the second finishes that block + contributes more.
    let n = 200
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 97); i = i + 1 }   // 'a' * 200
    store8(buf + n, 0)
    let h_one = md5_oneshot(buf, n)
    let st = md5_init()
    md5_update(st, buf, 37)
    md5_update(st, buf + 37, n - 37)
    let h_stream = md5_final(st)
    ce_str_eq("streaming matches oneshot when updates straddle block boundary",
        _tm_hex_encode_buf(h_stream, 16),
        _tm_hex_encode_buf(h_one, 16))
}

// ---- String wrapper -------------------------------------------------------

fn test_md5_oneshot_str_roundtrip() {
    // md5_oneshot_str("abc") matches md5_oneshot of the same bytes.
    let h_str = md5_oneshot_str("abc")
    let p = _tm_buf_from_str("abc")
    let h_buf = md5_oneshot(p[0], p[1])
    ce_str_eq("md5_oneshot_str matches md5_oneshot byte path",
        _tm_hex_encode_buf(h_str, 16),
        _tm_hex_encode_buf(h_buf, 16))
}

// ---- Sanity: MD5_HASH_LEN / MD5_BLOCK_LEN constants ----------------------

fn test_constants() {
    ce_eq("MD5_HASH_LEN = 16", MD5_HASH_LEN, 16)
    ce_eq("MD5_BLOCK_LEN = 64", MD5_BLOCK_LEN, 64)
}

// ---- Run -----------------------------------------------------------------

fn main() {
    test_md5_empty()
    test_md5_a()
    test_md5_abc()
    test_md5_message_digest()
    test_md5_alphabet()
    test_md5_55_byte_input()
    test_md5_56_byte_input()
    test_md5_100_byte_input()
    test_md5_streaming_empty()
    test_md5_streaming_single_update()
    test_md5_streaming_byte_at_a_time()
    test_md5_streaming_block_aligned()
    test_md5_streaming_straddle_block()
    test_md5_oneshot_str_roundtrip()
    test_constants()
    ce_summary("md5")
}
