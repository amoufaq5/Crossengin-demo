    test_r33b_window_reset_allows_low_seq_after_epoch()
    test_r33b_stats_line_includes_new_fields()
    // R35A -- DTLS-SRTP keying material exporter (RFC 5764 §4.2).
    test_r35a_export_refuses_when_cipher_inactive()
    test_r35a_export_returns_60_bytes_when_active()
    test_r35a_export_byte_identical_across_peers()
