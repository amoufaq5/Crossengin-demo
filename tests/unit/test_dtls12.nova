//                          main
// ============================================================================

fn main() {
    test_init_zero_state()
    test_be_helpers_roundtrip()
    test_record_vector_handshake_zero_seq()
    test_record_vector_alert_nonzero_seq()
    test_record_vector_app_data_empty()
    test_record_parse_rejects_short_header()
    test_record_parse_rejects_bad_content_type()
    test_record_parse_rejects_truncated_fragment()
    test_handshake_envelope_roundtrip()
    test_handshake_parse_rejects_short()
    test_handshake_parse_rejects_nonzero_frag_off()
    test_handshake_parse_rejects_mismatched_frag_len()
    test_msg_seq_increments_monotonic()
    test_flight_retransmit_counter()
    test_state_machine_valid_edges()
    test_state_machine_invalid_edges()
    test_dtls_transition_applies_state()
    test_state_name_strings()
    test_client_init_emits_record_and_advances()
    test_client_init_rejects_when_not_init()
    test_cipher_suite_accepts_ecdhe_ecdsa()
    test_cipher_suite_rejects_others()
    test_cipher_suite_accepts_in_mixed_list()
    test_cipher_suite_rejects_empty()
    test_sha256_abc_fips_vector()
    test_sha256_empty_vector()
    test_hmac_sha256_rfc4231_tc1()
    test_hkdf_rfc5869_vector1_extract()
    test_hkdf_rfc5869_vector1_expand()
    test_prf_sha256_deterministic_and_length()
    test_prf_sha256_label_changes_output()
    test_prf_sha256_multi_block_path()
    test_stubs_return_DTLS_ERR_STUB()
    test_stats_line_well_formed()
    test_hex_codec_roundtrip()
    ce_summary("dtls12")
}

main()
