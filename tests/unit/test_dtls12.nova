    test_seal_rejects_oversize()
    test_open_rejects_short_buffer()
    // R32B -- anti-replay sliding window (RFC 6347 §4.1.2.6).
    test_anti_replay_init_state_zero()
    test_anti_replay_sequential_accept()
    test_anti_replay_replay_rejected()
    test_anti_replay_big_jump_slides_window()
