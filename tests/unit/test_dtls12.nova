    // R31B -- real cipher path tests.
    test_ecdhe_keygen_returns_compressed_pub()
    test_ecdhe_derive_populates_state()
    test_ecdhe_derive_both_sides_match()
    test_ecdhe_derive_rejects_bad_peer_pub()
    test_ecdhe_derive_rejects_no_priv()
