    test_r35a_export_deterministic_repeat_call()
    // R36B (R35A.2 / R33B.3) -- SRTP keying-material cache + invalidation.
    test_r36b_init_cache_slot_zero()
    test_r36b_first_call_populates_cache()
    test_r36b_second_call_serves_cached_pointer()
    test_r36b_third_call_bumps_hits_to_two()
    test_r36b_advance_epoch_invalidates_cache()
    test_r36b_cached_bytes_match_first_compute()
    test_r36b_caches_are_per_state()
    test_r36b_cache_does_not_bypass_cipher_active_gate()
    // R38B (R33B.4) -- PRF rekey on dtls_advance_epoch (variant A:
    // re-run the SAME PRF inputs; bytes unchanged; counter bumps).
    test_r38b_init_rekeys_counter_zero()
    test_r38b_advance_epoch_bumps_rekeys_counter()
    test_r38b_pre_cipher_advance_bumps_counter_but_skips_prf()
    test_r38b_advance_reallocates_key_block_and_subbuffers()
