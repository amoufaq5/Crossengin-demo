    test_anti_replay_pure_check_helper()
    test_anti_replay_update_big_jump_clears_mask()
    test_anti_replay_update_in_window_sets_bit()
    test_end_to_end_replay_after_ecdhe()
    test_stats_line_includes_replay_fields()
    // R33B -- cert verify + CCS-on-epoch-change reset.
    test_r33b_init_zero_r33b_slots()
    test_r33b_set_current_time_setter()
    test_r33b_cert_verify_ok()
    test_r33b_cert_verify_rejects_truncated_der()
