// Unit tests for src/parts/perception/perception_atoms.nova
//
// Verifies the Percept record type: constructors round-trip through
// accessors, modality / category name delegation is non-empty, and the
// multimodal constructor cross-links its two per-modality halves.
// ADR-0092 (Phase N R1).

import "../ce_test.nova"
import "../../src/parts/perception/perception_atoms.nova"

// ---- text percept ---------------------------------------------------------
fn test_text_percept() {
    let signals = list_new()
    push(signals, "digits")
    push(signals, "op")
    let p = percept_text_new(12345, CAT_ARITHMETIC, 900, signals, 77)
    ce_check("text percept tagged", pc_is_percept(p) == 1)
    ce_eq("text ts", pc_timestamp_ns(p), 12345)
    ce_eq("text modality", pc_modality(p), PC_MODALITY_TEXT)
    ce_eq("text category", pc_category(p), CAT_ARITHMETIC)
    ce_eq("text confidence", pc_confidence(p), 900)
    ce_eq("text signals len", len(pc_signals(p)), 2)
    ce_str_eq("text signal 0", pc_signals(p)[0], "digits")
    ce_str_eq("text signal 1", pc_signals(p)[1], "op")
    ce_eq("text source atom id", pc_source_atom_id(p), 77)
    ce_eq("text labels empty", len(pc_labels(p)), 0)
    ce_str_eq("text identity empty", pc_identity_label(p), "")
    ce_check("text not multimodal", pc_is_multimodal(p) == 0)
    ce_eq("text linked image", pc_linked_image(p), 0)
    ce_eq("text linked audio", pc_linked_audio(p), 0)
}

// ---- image percept --------------------------------------------------------
fn test_image_percept() {
    let labels = list_new()
    push(labels, "face")
    push(labels, "edge")
    push(labels, "corner")
    let p = percept_image_new(200000, labels, "alice", 42, 780)
    ce_check("image percept tagged", pc_is_percept(p) == 1)
    ce_eq("image ts", pc_timestamp_ns(p), 200000)
    ce_eq("image modality", pc_modality(p), PC_MODALITY_IMAGE)
    ce_eq("image category zero", pc_category(p), 0)
    ce_eq("image confidence", pc_confidence(p), 780)
    ce_eq("image labels len", len(pc_labels(p)), 3)
    ce_str_eq("image label 0", pc_labels(p)[0], "face")
    ce_str_eq("image identity", pc_identity_label(p), "alice")
    ce_eq("image source atom id", pc_source_atom_id(p), 42)
    ce_check("image not multimodal", pc_is_multimodal(p) == 0)
}

// Empty-identity image percept: identity stays "" and does not overwrite
// the pre-initialised empty string.
fn test_image_percept_no_identity() {
    let labels = list_new()
    push(labels, "edge")
    let p = percept_image_new(1, labels, "", 0, 500)
    ce_str_eq("image identity empty", pc_identity_label(p), "")
    ce_eq("image labels len", len(pc_labels(p)), 1)
}

// ---- audio percept --------------------------------------------------------
fn test_audio_percept() {
    let labels = list_new()
    push(labels, "hello")
    push(labels, "world")
    let p = percept_audio_new(300000, labels, "bob", 99, 850)
    ce_check("audio percept tagged", pc_is_percept(p) == 1)
    ce_eq("audio modality", pc_modality(p), PC_MODALITY_AUDIO)
    ce_eq("audio confidence", pc_confidence(p), 850)
    ce_eq("audio labels len", len(pc_labels(p)), 2)
    ce_str_eq("audio identity", pc_identity_label(p), "bob")
    ce_eq("audio source atom id", pc_source_atom_id(p), 99)
    ce_check("audio not multimodal", pc_is_multimodal(p) == 0)
}

// ---- multimodal percept ---------------------------------------------------
fn test_multimodal_percept() {
    let il = list_new()
    push(il, "face")
    let al = list_new()
    push(al, "voice")
    push(al, "carol")
    let img = percept_image_new(500, il, "carol", 1, 900)
    let aud = percept_audio_new(510, al, "carol", 2, 850)
    let mm = percept_multimodal_new(img, aud, 720)
    ce_check("mm tagged", pc_is_percept(mm) == 1)
    ce_check("mm is multimodal", pc_is_multimodal(mm) == 1)
    ce_eq("mm modality", pc_modality(mm), PC_MODALITY_MULTIMODAL)
    // Timestamp copied from the image half.
    ce_eq("mm ts from image", pc_timestamp_ns(mm), 500)
    // Confidence is min(image, audio) when both present.
    ce_eq("mm confidence min", pc_confidence(mm), 850)
    // Identity propagated (both sides agree on "carol").
    ce_str_eq("mm identity", pc_identity_label(mm), "carol")
    ce_eq("mm corr", pc_corr_milli(mm), 720)
    ce_check("mm links image", pc_linked_image(mm) == img)
    ce_check("mm links audio", pc_linked_audio(mm) == aud)
    // Merged labels: image first, then audio.
    ce_eq("mm labels len", len(pc_labels(mm)), 3)
    ce_str_eq("mm label 0", pc_labels(mm)[0], "face")
    ce_str_eq("mm label 1", pc_labels(mm)[1], "voice")
    ce_str_eq("mm label 2", pc_labels(mm)[2], "carol")
}

// Multimodal with only the image side: timestamp + identity fall through.
fn test_multimodal_image_only() {
    let il = list_new()
    push(il, "face")
    let img = percept_image_new(700, il, "dave", 3, 600)
    let mm = percept_multimodal_new(img, 0, 0)
    ce_eq("mm-imgonly ts", pc_timestamp_ns(mm), 700)
    ce_str_eq("mm-imgonly identity", pc_identity_label(mm), "dave")
    ce_eq("mm-imgonly conf from img", pc_confidence(mm), 600)
    ce_check("mm-imgonly links image", pc_linked_image(mm) == img)
    ce_eq("mm-imgonly no audio", pc_linked_audio(mm), 0)
}

// Multimodal with only the audio side: identity falls through to audio.
fn test_multimodal_audio_only() {
    let al = list_new()
    push(al, "hello")
    let aud = percept_audio_new(800, al, "eve", 4, 550)
    let mm = percept_multimodal_new(0, aud, 300)
    ce_eq("mm-audonly ts", pc_timestamp_ns(mm), 800)
    ce_str_eq("mm-audonly identity", pc_identity_label(mm), "eve")
    ce_eq("mm-audonly conf from aud", pc_confidence(mm), 550)
    ce_eq("mm-audonly corr", pc_corr_milli(mm), 300)
}

// ---- modality + category names -------------------------------------------
fn test_modality_names() {
    ce_str_eq("mod text", pc_modality_name(PC_MODALITY_TEXT), "text")
    ce_str_eq("mod image", pc_modality_name(PC_MODALITY_IMAGE), "image")
    ce_str_eq("mod audio", pc_modality_name(PC_MODALITY_AUDIO), "audio")
    ce_str_eq("mod video", pc_modality_name(PC_MODALITY_VIDEO), "video")
    ce_str_eq("mod multimodal", pc_modality_name(PC_MODALITY_MULTIMODAL), "multimodal")
    ce_str_eq("mod unknown", pc_modality_name(999), "unknown")
}

fn test_category_names() {
    // Delegates to cat_name from input_classifier; empty check via length.
    ce_check("cat greeting non-empty", len(pc_category_name(CAT_GREETING)) > 0)
    ce_check("cat academic non-empty", len(pc_category_name(CAT_ACADEMIC)) > 0)
    ce_check("cat arithmetic non-empty", len(pc_category_name(CAT_ARITHMETIC)) > 0)
    ce_check("cat factual non-empty", len(pc_category_name(CAT_FACTUAL)) > 0)
    // A zero category maps to "n/a" (image/audio/multimodal placeholder).
    ce_str_eq("cat zero", pc_category_name(0), "n/a")
}

// ---- pc_is_percept guard -------------------------------------------------
fn test_is_percept_guard() {
    ce_eq("is_percept zero", pc_is_percept(0), 0)
    let l = list_new()
    push(l, 42)
    ce_eq("is_percept short list", pc_is_percept(l), 0)
    let l2 = list_new()
    let i = 0
    while i < 14 { push(l2, 0) i = i + 1 }
    ce_eq("is_percept wrong tag", pc_is_percept(l2), 0)
}

// ---- setters --------------------------------------------------------------
fn test_setters() {
    let p = percept_text_new(1, CAT_GREETING, 900, list_new(), 0)
    let r = list_new()
    push(r, 5)
    push(r, 6)
    ce_eq("set routes", pc_set_routes(p, r), 1)
    ce_eq("get routes len", len(pc_routes(p)), 2)
    ce_eq("set unknown", pc_set_unknown(p, 3), 1)
    ce_eq("get unknown", pc_unknown(p), 3)
    ce_eq("set source id", pc_set_source_atom_id(p, 88), 1)
    ce_eq("get source id", pc_source_atom_id(p), 88)
}

// ---- summary formatter ----------------------------------------------------
fn test_summary() {
    let p = percept_text_new(1, CAT_GREETING, 950, list_new(), 0)
    let s = pc_summary(p)
    ce_check("summary non-empty", len(s) > 0)
    ce_str_eq("summary no percept", pc_summary(0), "<no percept>")
}

fn main() {
    test_text_percept()
    test_image_percept()
    test_image_percept_no_identity()
    test_audio_percept()
    test_multimodal_percept()
    test_multimodal_image_only()
    test_multimodal_audio_only()
    test_modality_names()
    test_category_names()
    test_is_percept_guard()
    test_setters()
    test_summary()
    ce_summary("perception_atoms")
}
main()
