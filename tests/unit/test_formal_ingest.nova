// Unit tests for src/learning/formal_ingest.nova: the kernel-gated FORMAL
// ingestion path (ADR-0088 path (a) + ADR-0087 license gate). Verified vs.
// unclean-source vs. kernel-rejected outcomes, all in isolation -- the
// promotion + debate paths are exercised in their own suites.

import "../ce_test.nova"
import "../../src/learning/formal_ingest.nova"

fn _ax(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

// Valid proof from a clean source -> kernel pins atom FORMAL + PROMOTED.
fn test_verified_proof_promotes_formal() {
    let reg = proof_registry_new()
    let atom = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let p = term_atom("p")
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    let state = lp_ingest_formal(atom, reg, "wikipedia:Modus_ponens", pkt)
    ce_eq("state PROMOTED", state, CAND_PROMOTED)
    ce_eq("grade FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
    ce_check("belief pinned high", atom_confidence(atom) > 990)
    ce_check("proof_ref stamped", atom_proof_ref(atom) > 0)
    // license was resolved + stamped (wikipedia -> CC_BY_SA, commercial-clean).
    ce_eq("license stamped", atom_license(atom), LICENSE_CC_BY_SA)
    // cand_state is also recorded in payload, but str_eq-based payload lookup
    // is environmentally flaky under this launcher (see audit_reader); the
    // direct return value above is the load-bearing check.
}

// Unclean source -> quarantined BEFORE the kernel runs (license gate first).
// The atom never gets to FORMAL even though the derivation is valid.
fn test_unclean_source_quarantines() {
    let reg = proof_registry_new()
    let atom = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let p = term_atom("p")
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    let state = lp_ingest_formal(atom, reg, "rando-blog:Random_claim", pkt)
    ce_eq("state QUARANTINED", state, CAND_QUARANTINED)
    ce_check("grade NOT FORMAL",
        atom_evidence_grade(atom) != GRADE_FORMAL)
    ce_eq("grade is EMPIRICAL_WEAK", atom_evidence_grade(atom), GRADE_EMPIRICAL_WEAK)
}

// Clean source but the kernel rejects the proof -> CANDIDATE, atom untouched.
// The caller may route it through ordinary empirical promotion.
fn test_kernel_rejects_leaves_candidate() {
    let reg = proof_registry_new()
    let atom = atom_new(0, 1, ATOM_CONCEPT, "q", 0)
    let p = term_atom("p")
    let q = term_atom("q")
    // Bogus packet: axiom of p, claim q.
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), q, "q", "bogus")
    let state = lp_ingest_formal(atom, reg, "wikipedia:Q", pkt)
    ce_eq("state CANDIDATE (fall back)", state, CAND_CANDIDATE)
    ce_eq("grade UNKNOWN", atom_evidence_grade(atom), GRADE_UNKNOWN)
    ce_eq("no proof_ref", atom_proof_ref(atom), PROV_NONE)
    // license was still stamped before the kernel ran.
    ce_eq("license stamped", atom_license(atom), LICENSE_CC_BY_SA)
    // belief is the uniform prior.
    ce_eq("belief still prior", atom_confidence(atom), 500)
}

// HYP path: an ingested formal claim that rests on an already-VERIFIED lemma.
// This is the cross-FORMAL chaining that ADR-0088 requires (and ADR-0089
// strict arguments rely on).
fn test_hyp_chain_promotes() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    // Pre-register a VERIFIED lemma for "p" -- as if a previous formal
    // ingestion had landed an axiom-rooted proof of p.
    let lemma_code = proof_register(reg, "p", list_new(), "")
    proof_set_status(reg, lemma_code, PROOF_VERIFIED)
    // Now ingest "p" using a HYP step that rests on the lemma.
    let hyps = hyp_new()
    hyp_add(hyps, "p", p, lemma_code)
    let atom = atom_new(0, 2, ATOM_CONCEPT, "p_again", 0)
    let pkt = verify_packet(axiom_table_new(), hyps, pf_hyp(p, "p"), p,
                            "p_again", "rests-on-lemma-p")
    let state = lp_ingest_formal(atom, reg, "wikipedia:Lemma", pkt)
    ce_eq("HYP-chain PROMOTED", state, CAND_PROMOTED)
    ce_eq("HYP-chain FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
}

// Property: a FORMAL atom ingested this way is reusable as a HYP for a
// downstream proof, completing the cross-FORMAL chain.
fn test_chain_reuse() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_imp(p, q)
    // First ingest: axioms p AND (p -> q), pin one of them FORMAL.
    let atom_p = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let pkt_p = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "p")
    lp_ingest_formal(atom_p, reg, "wikipedia:P", pkt_p)
    let code_p = atom_proof_ref(atom_p)
    ce_check("first formal pinned", code_p > 0)
    // Second ingest: prove q via MP, using HYP for p and AXIOM for (p -> q).
    let hyps = hyp_new()
    hyp_add(hyps, "p", p, code_p)
    let proof_q = pf_mp(q, pf_axiom(pq), pf_hyp(p, "p"))
    let atom_q = atom_new(0, 2, ATOM_CONCEPT, "q", 0)
    let pkt_q = verify_packet(_ax(pq), hyps, proof_q, q, "q", "mp-chain")
    let state = lp_ingest_formal(atom_q, reg, "wikipedia:Q", pkt_q)
    ce_eq("chained ingest PROMOTED", state, CAND_PROMOTED)
    ce_eq("chained ingest FORMAL", atom_evidence_grade(atom_q), GRADE_FORMAL)
}

fn main() {
    test_verified_proof_promotes_formal()
    test_unclean_source_quarantines()
    test_kernel_rejects_leaves_candidate()
    test_hyp_chain_promotes()
    test_chain_reuse()
    ce_summary("formal_ingest")
}

main()
