// Unit tests for src/seed/packs/code_review_pack.nova (brief). P1.9.

import "../ce_test.nova"
import "../../src/seed/packs/code_review_pack.nova"

fn _setup() {
    let reg = kg_registry_new()
    let env = list_new()
    push(env, reasoning_kg_init(reg))
    push(env, lang_kg_init(reg))
    push(env, imagination_kg_init(reg))
    push(env, mo_new())
    return env
}

fn _find_op(kg, premise_name, conclusion_name) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let ops = rk_operators_from(kg, atom_id(p))
    let i = 0
    while i < len(ops) {
        if rop_conclusion(ops[i]) == atom_id(c) { return ops[i] }
        i = i + 1
    }
    return 0
}

fn test_vocab_atoms_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_code_review_with_mo(lang, kg, ikg, mo, 0)
    ce_check("function atom", kg_find_atom(kg, "function") != 0)
    ce_check("test atom", kg_find_atom(kg, "test") != 0)
    ce_check("refactor atom", kg_find_atom(kg, "refactor") != 0)
    ce_check("race atom", kg_find_atom(kg, "race") != 0)
}

fn test_race_add_lock_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_code_review_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "race", "add_lock")
    ce_check("race -> add_lock operator exists", op != 0)
}

fn test_leak_add_cleanup_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_code_review_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "leak", "add_cleanup")
    ce_check("leak -> add_cleanup operator exists", op != 0)
}

fn test_missing_test_request_coverage_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_code_review_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "missing_test", "request_coverage")
    ce_check("missing_test -> request_coverage operator exists", op != 0)
}

fn test_install_returns_counts() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let r = pack_install_code_review_with_mo(lang, kg, ikg, mo, 0)
    ce_eq("returns 2-element [atoms, ops]", len(r), 2)
    ce_check("code_review atoms >= 30", r[0] >= 30)
    ce_check("code_review ops >= 5", r[1] >= 5)
}

fn main() {
    test_vocab_atoms_present()
    test_race_add_lock_operator()
    test_leak_add_cleanup_operator()
    test_missing_test_request_coverage_operator()
    test_install_returns_counts()
    ce_summary("code_review_pack")
}
main()
