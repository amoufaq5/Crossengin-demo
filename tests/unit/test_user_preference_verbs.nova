// Unit tests for the R101 user.preference.{set,list,clear} wire verbs.
//
// Coverage:
//   * All three verbs registered + cap gate wiring
//   * user.preference.set happy path + arg validation + refusals
//   * user.preference.list default (own) + admin-override with holder
//   * user.preference.clear single + all
//   * Preference filter changes pattern.list output for a holder
//   * Cross-holder mutation requires CAP_ADMIN_PREFERENCE

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/preference/user_preference.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx_with_pref() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_preference_reg(ctx, preference_registry_new())
    return ctx
}

fn _mk_ctx_no_pref() {
    return rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
}

fn _kv(k, v) {
    let p = list_new()
    push(p, k)
    push(p, v)
    return p
}

fn _args1(k, v) {
    let a = list_new()
    push(a, _kv(k, v))
    return a
}

fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, _kv(k1, v1))
    push(a, _kv(k2, v2))
    return a
}

fn _args3(k1, v1, k2, v2, k3, v3) {
    let a = list_new()
    push(a, _kv(k1, v1))
    push(a, _kv(k2, v2))
    push(a, _kv(k3, v3))
    return a
}

fn _args4(k1, v1, k2, v2, k3, v3, k4, v4) {
    let a = list_new()
    push(a, _kv(k1, v1))
    push(a, _kv(k2, v2))
    push(a, _kv(k3, v3))
    push(a, _kv(k4, v4))
    return a
}

// ---- verb-registration + cap-map assertions ----------------------------

fn test_all_three_verbs_registered() {
    let names = rpc_verb_names()
    let saw_s = 0
    let saw_l = 0
    let saw_c = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "user.preference.set")   == 1 { saw_s = 1 }
        if str_eq_bytes(names[i], "user.preference.list")  == 1 { saw_l = 1 }
        if str_eq_bytes(names[i], "user.preference.clear") == 1 { saw_c = 1 }
        i = i + 1
    }
    ce_eq("set registered",   saw_s, 1)
    ce_eq("list registered",  saw_l, 1)
    ce_eq("clear registered", saw_c, 1)
}

fn test_verb_cap_map() {
    ce_str_eq("set cap",   capability_verb_required("user.preference.set"),
              CAP_NL_PREFERENCE_WRITE)
    ce_str_eq("list cap",  capability_verb_required("user.preference.list"),
              CAP_NL_PREFERENCE_READ)
    ce_str_eq("clear cap", capability_verb_required("user.preference.clear"),
              CAP_NL_PREFERENCE_WRITE)
}

fn test_caps_are_known() {
    ce_eq("read known",  capability_is_known_cap(CAP_NL_PREFERENCE_READ),  1)
    ce_eq("write known", capability_is_known_cap(CAP_NL_PREFERENCE_WRITE), 1)
    ce_eq("admin known", capability_is_known_cap(CAP_ADMIN_PREFERENCE),    1)
}

fn test_reader_role_carries_pref_caps() {
    let caps = capability_role_expand("reader")
    let saw_r = 0
    let saw_w = 0
    let saw_admin = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_NL_PREFERENCE_READ)  == 1 { saw_r = 1 }
        if str_eq_bytes(caps[i], CAP_NL_PREFERENCE_WRITE) == 1 { saw_w = 1 }
        if str_eq_bytes(caps[i], CAP_ADMIN_PREFERENCE)    == 1 { saw_admin = 1 }
        i = i + 1
    }
    ce_eq("reader has read",  saw_r, 1)
    ce_eq("reader has write", saw_w, 1)
    ce_eq("reader lacks admin_pref", saw_admin, 0)
}

fn test_admin_role_carries_admin_pref() {
    let caps = capability_role_expand("admin")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_PREFERENCE) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin has admin_pref", saw, 1)
}

// ---- refusal on no preference registry ---------------------------------

fn test_set_refused_without_reg() {
    let ctx = _mk_ctx_no_pref()
    let out = rpc_dispatch("user.preference.set",
        _args3("kind", "skill", "name", "research", "enabled", "0"), ctx)
    ce_check("no reg -> refused", _has(out, "no preference registry"))
}

fn test_list_refused_without_reg() {
    let ctx = _mk_ctx_no_pref()
    let out = rpc_dispatch("user.preference.list", list_new(), ctx)
    ce_check("no reg -> refused", _has(out, "no preference registry"))
}

fn test_clear_refused_without_reg() {
    let ctx = _mk_ctx_no_pref()
    let out = rpc_dispatch("user.preference.clear",
        _args1("all", "1"), ctx)
    ce_check("no reg -> refused", _has(out, "no preference registry"))
}

// ---- set arg validation -----------------------------------------------

fn test_set_missing_kind() {
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args2("name", "x", "enabled", "1"), ctx)
    ce_check("missing kind refused", _has(out, "missing arg: kind"))
}

fn test_set_missing_name() {
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args2("kind", "skill", "enabled", "1"), ctx)
    ce_check("missing name refused", _has(out, "missing arg: name"))
}

fn test_set_missing_enabled() {
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args2("kind", "skill", "name", "x"), ctx)
    ce_check("missing enabled refused", _has(out, "missing arg: enabled"))
}

fn test_set_unknown_kind() {
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args3("kind", "nope", "name", "x", "enabled", "0"), ctx)
    ce_check("unknown kind refused", _has(out, "unknown kind: nope"))
}

fn test_set_empty_name() {
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args3("kind", "skill", "name", "", "enabled", "0"), ctx)
    ce_check("empty name refused", _has(out, "name must be non-empty"))
}

fn test_set_invalid_enabled() {
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args3("kind", "skill", "name", "x", "enabled", "2"), ctx)
    ce_check("enabled must be 0/1", _has(out, "enabled must be 0 or 1"))
}

fn test_set_anonymous_refused() {
    // No presented token -> anonymous holder -> refused.
    let ctx = _mk_ctx_with_pref()
    let out = rpc_dispatch("user.preference.set",
        _args3("kind", "skill", "name", "research", "enabled", "0"), ctx)
    ce_check("anonymous refused",
             _has(out, "anonymous callers cannot set preferences"))
}

// ---- set happy path (presented holder) ---------------------------------

fn _mk_ctx_with_reader_token(pref_reg, holder) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_preference_reg(ctx, pref_reg)
    let cap_reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tok-" + holder, holder, roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 0)     // enforced=0 to skip outer
                                              // gate; verb still sees the
                                              // presented holder via
                                              // rpc_ctx_presented_holder.
    rpc_ctx_set_presented_token(ctx, "tok-" + holder)
    return ctx
}

fn test_set_happy_defaults_presented_holder() {
    let pref = preference_registry_new()
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    let out = rpc_dispatch("user.preference.set",
        _args3("kind", "skill", "name", "research", "enabled", "0"), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("holder alice", _has(out, "\"holder\":\"alice\""))
    ce_eq("registry has entry",
          preference_get(pref, "alice", "skill", "research"), 0)
}

fn test_list_returns_own_only() {
    let pref = preference_registry_new()
    preference_set(pref, "alice", "skill", "research", 0)
    preference_set(pref, "alice", "pattern", "*", 0)
    preference_set(pref, "bob",   "skill", "echo", 0)
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    let out = rpc_dispatch("user.preference.list", list_new(), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("holder alice", _has(out, "\"holder\":\"alice\""))
    ce_check("shows research", _has(out, "\"name\":\"research\""))
    ce_check("shows wildcard", _has(out, "\"name\":\"*\""))
    // Bob's entry must not appear.
    ce_eq("no bob entry (echo)", _has(out, "\"echo\""), 0)
    ce_check("count 2", _has(out, "\"count\":2"))
}

fn test_non_admin_cannot_target_other_holder() {
    let pref = preference_registry_new()
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    // Alice tries to set a preference for bob.
    let out = rpc_dispatch("user.preference.set",
        _args4("kind", "skill", "name", "research", "enabled", "0",
                "holder", "bob"), ctx)
    ce_check("admin cap required",
             _has(out, "capability required: admin:preference"))
    ce_eq("bob has no entry",
          preference_get(pref, "bob", "skill", "research"), 0 - 1)
}

fn _mk_ctx_with_admin_token(pref_reg, holder) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_preference_reg(ctx, pref_reg)
    let cap_reg = capability_registry_new()
    let roles = list_new() push(roles, "admin")
    let t = capability_token_new_roles("adm-" + holder, holder, roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 0)
    rpc_ctx_set_presented_token(ctx, "adm-" + holder)
    return ctx
}

fn test_admin_can_target_other_holder() {
    let pref = preference_registry_new()
    let ctx = _mk_ctx_with_admin_token(pref, "opsadmin")
    let out = rpc_dispatch("user.preference.set",
        _args4("kind", "skill", "name", "research", "enabled", "0",
                "holder", "bob"), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("holder bob", _has(out, "\"holder\":\"bob\""))
    ce_eq("bob has entry now",
          preference_get(pref, "bob", "skill", "research"), 0)
}

// ---- clear ------------------------------------------------------------

fn test_clear_single_entry() {
    let pref = preference_registry_new()
    preference_set(pref, "alice", "skill", "research", 0)
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    let out = rpc_dispatch("user.preference.clear",
        _args2("kind", "skill", "name", "research"), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("cleared_count 1", _has(out, "\"cleared_count\":1"))
    ce_eq("entry gone",
          preference_get(pref, "alice", "skill", "research"), 0 - 1)
}

fn test_clear_all_flag() {
    let pref = preference_registry_new()
    preference_set(pref, "alice", "skill", "research", 0)
    preference_set(pref, "alice", "kg",    "world",    1)
    preference_set(pref, "alice", "pattern", "*",      0)
    preference_set(pref, "bob",   "skill", "echo", 0)
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    let out = rpc_dispatch("user.preference.clear",
        _args1("all", "1"), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("cleared_count 3", _has(out, "\"cleared_count\":3"))
    ce_eq("alice empty", preference_count(pref, "alice"), 0)
    ce_eq("bob untouched", preference_count(pref, "bob"), 1)
}

fn test_clear_missing_args() {
    let pref = preference_registry_new()
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    let out = rpc_dispatch("user.preference.clear", list_new(), ctx)
    ce_check("missing kind or all", _has(out, "missing arg: kind"))
}

fn test_clear_unknown_kind() {
    let pref = preference_registry_new()
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    let out = rpc_dispatch("user.preference.clear",
        _args2("kind", "nope", "name", "x"), ctx)
    ce_check("unknown kind", _has(out, "unknown kind: nope"))
}

// ---- integration: pattern.list respects preference wildcard ------------

fn test_pattern_list_hidden_after_wildcard_disable() {
    // Wire a pattern-list-shaped context; call user.preference.set to
    // wildcard-disable patterns; then call pattern.list and confirm
    // the response has no pattern entries for alice.
    let pref = preference_registry_new()
    let ctx = _mk_ctx_with_reader_token(pref, "alice")
    // pattern.list requires no capsule registry (walks the global
    // pattern registry singleton), but lazy-inits builtins on first
    // touch. Skip if we can't get any patterns.
    let baseline = rpc_dispatch("pattern.list", list_new(), ctx)
    let has_before = _has(baseline, "\"pattern_count\"")
    if has_before == 0 {
        ce_check("baseline has entries (skip when empty)", 1)
        return
    }
    // Wildcard disable.
    rpc_dispatch("user.preference.set",
        _args3("kind", "pattern", "name", "*", "enabled", "0"), ctx)
    let after = rpc_dispatch("pattern.list", list_new(), ctx)
    // After the wildcard disable alice sees no patterns. The response
    // is a JSON object with an empty array as the top-level result.
    ce_check("no pattern_count field after wildcard",
             _has(after, "\"pattern_count\"") == 0)
}

fn main() {
    test_all_three_verbs_registered()
    test_verb_cap_map()
    test_caps_are_known()
    test_reader_role_carries_pref_caps()
    test_admin_role_carries_admin_pref()
    test_set_refused_without_reg()
    test_list_refused_without_reg()
    test_clear_refused_without_reg()
    test_set_missing_kind()
    test_set_missing_name()
    test_set_missing_enabled()
    test_set_unknown_kind()
    test_set_empty_name()
    test_set_invalid_enabled()
    test_set_anonymous_refused()
    test_set_happy_defaults_presented_holder()
    test_list_returns_own_only()
    test_non_admin_cannot_target_other_holder()
    test_admin_can_target_other_holder()
    test_clear_single_entry()
    test_clear_all_flag()
    test_clear_missing_args()
    test_clear_unknown_kind()
    test_pattern_list_hidden_after_wildcard_disable()
    ce_summary("user_preference_verbs")
}

main()
