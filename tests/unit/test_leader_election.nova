// Unit tests for src/federation/leader_election.nova (R19E).
//
// Coverage (25 assertions, mapped to brief's required scenarios):
//   Bootstrap: le_init starts with no leader, STABLE state, self_id set.
//   3-soul IDs [10, 20, 30]: highest (30) wins election.
//   Soul 30 dies (gossip marks DEAD): souls 10 and 20 elect 20.
//   Soul 20 dies: soul 10 becomes leader (alone).
//   Election in flight: le_current_leader returns -1 until VICTORY received.
//   le_force_election triggers a fresh election even if a leader exists.
//   Peer-id map: register / unregister / lookup round-trip + idempotency.
//   Message handlers: ELECTION from lower-ID -> we send OK + start own election;
//     ELECTION from higher-ID -> we do nothing (wait for VICTORY).
//   VICTORY from higher-ID -> accept; VICTORY from lower-ID -> ignore.
//   le_step at bootstrap with no peers -> declares self winner after timeout.
//
// The unit tests deliberately AVOID network I/O -- the gossip state is
// instantiated WITHOUT a daemon and peers are added via gossip_add_peer
// directly. The leader_election state machine is then driven by direct
// le_on_* calls (simulating message arrivals) and le_election_check
// (simulating timeout firing). This isolates the algorithm from
// transport quirks; the integration scenario covers the end-to-end
// path with real sockets.

import "../ce_test.nova"
import "../../src/federation/leader_election.nova"

// Build a 3-soul gossip mesh seeded with peers + their IDs.
// `self_addr` is left out of peer_table (gossip_init filter), but
// the LE state pre-registers self_id separately.
fn _mk_le(self_addr, self_id, peer_addrs, peer_ids) {
    let bp = list_new()
    let i = 0
    while i < len(peer_addrs) {
        push(bp, peer_addrs[i])
        i = i + 1
    }
    let gs = gossip_init(self_addr, bp)
    let le = le_init(gs, self_id)
    let j = 0
    while j < len(peer_addrs) {
        le_register_peer(le, peer_addrs[j], peer_ids[j])
        j = j + 1
    }
    return le
}

fn _list2(a, b) { let l = list_new(); push(l, a); push(l, b); return l }

// ---- bootstrap state ------------------------------------------------------

fn test_init_starts_with_no_leader() {
    let gs = gossip_init("127.0.0.1:8770", 0)
    let le = le_init(gs, 100)
    ce_eq("bootstrap: leader=-1", le_current_leader(le), -1)
    ce_eq("bootstrap: state=STABLE", le_election_state(le), LE_STATE_STABLE)
    ce_eq("bootstrap: self_id=100", le_self_id(le), 100)
}

fn test_init_is_not_leader_yet() {
    let gs = gossip_init("127.0.0.1:8770", 0)
    let le = le_init(gs, 42)
    ce_eq("bootstrap: is_leader=0", le_is_leader(le), 0)
}

// ---- peer-id map ---------------------------------------------------------

fn test_register_peer_adds_mapping() {
    let gs = gossip_init("127.0.0.1:8770", 0)
    let le = le_init(gs, 10)
    le_register_peer(le, "127.0.0.1:8771", 20)
    ce_eq("registered peer count = 1", le_peer_count(le), 1)
    ce_eq("addr -> id lookup", le_peer_id_for_addr(le, "127.0.0.1:8771"), 20)
}

fn test_register_peer_idempotent_on_addr() {
    let gs = gossip_init("127.0.0.1:8770", 0)
    let le = le_init(gs, 10)
    le_register_peer(le, "127.0.0.1:8771", 20)
    // Re-registering with a NEW id overwrites (operator key rotation).
    le_register_peer(le, "127.0.0.1:8771", 25)
    ce_eq("duplicate addr does not duplicate row", le_peer_count(le), 1)
    ce_eq("re-register overwrites id", le_peer_id_for_addr(le, "127.0.0.1:8771"), 25)
}

fn test_unregister_peer_drops_mapping() {
    let gs = gossip_init("127.0.0.1:8770", 0)
    let le = le_init(gs, 10)
    le_register_peer(le, "127.0.0.1:8771", 20)
    le_unregister_peer(le, "127.0.0.1:8771")
    ce_eq("after unregister: count=0", le_peer_count(le), 0)
    ce_eq("after unregister: lookup -1", le_peer_id_for_addr(le, "127.0.0.1:8771"), -1)
}

// ---- 3-soul scenario [10, 20, 30] -- highest wins ------------------------

fn test_three_souls_highest_wins() {
    // Run election on soul 10 (the lowest). Both peers (20, 30) are
    // alive. Soul 10 sends ELECTION to both higher peers, then
    // SIMULATES receiving OK from both (their state machines would
    // also send OK in a real run). Soul 10's election_check times
    // out -> but it has GOT_OK=1, so it restarts the election.
    // The election effectively yields to soul 30 (the highest).
    // In a real mesh, soul 30 receives ELECTION, sends OK, starts
    // its own election, times out with no higher peer, broadcasts
    // VICTORY. To simulate THAT end-state on soul 10, we hand it
    // a VICTORY from soul 30.
    let peers = _list2("127.0.0.1:8771", "127.0.0.1:8772")
    let ids = _list2(20, 30)
    let le10 = _mk_le("127.0.0.1:8770", 10, peers, ids)
    // Start the election on soul 10.
    le_start_election(le10)
    ce_eq("during election: leader=-1", le_current_leader(le10), -1)
    ce_eq("during election: state=ELECTING", le_election_state(le10), LE_STATE_ELECTING)
    // Soul 10 enqueued an ELECTION for each of 20 and 30.
    ce_eq("election sent ELECTION to both higher peers",
          le_pending_message_count(le10), 2)
    // Drain the queue, simulate receiving an OK from each higher peer.
    le_drain_pending(le10)
    le_on_ok(le10, 20)
    le_on_ok(le10, 30)
    // After OKs, soul 10 expects a VICTORY broadcast from soul 30.
    le_on_victory(le10, 30)
    ce_eq("after VICTORY(30): leader=30", le_current_leader(le10), 30)
    ce_eq("after VICTORY(30): state=STABLE", le_election_state(le10), LE_STATE_STABLE)
    ce_eq("soul 10 is_leader=0", le_is_leader(le10), 0)
}

fn test_highest_soul_self_election_wins() {
    // From soul 30's perspective: it has no higher-ID peers in its
    // alive set. Starting an election should result in self-victory
    // after one timeout. We set the timeout to 1ms so the test
    // doesn't sleep.
    let peers = _list2("127.0.0.1:8770", "127.0.0.1:8771")
    let ids = _list2(10, 20)
    let le30 = _mk_le("127.0.0.1:8772", 30, peers, ids)
    le_set_timeout_ms(le30, 1)
    le_start_election(le30)
    // ELECTION queue should be EMPTY (no higher-ID alive peers).
    ce_eq("no higher peers -> no ELECTION messages",
          le_pending_message_count(le30), 0)
    // Sleep past the timeout, then run election_check.
    sleep_ms(5)
    le_election_check(le30)
    ce_eq("self-elected: leader=30", le_current_leader(le30), 30)
    ce_eq("self-elected: state=STABLE", le_election_state(le30), LE_STATE_STABLE)
    ce_eq("self-elected: is_leader=1", le_is_leader(le30), 1)
}

// ---- leader death + re-election -----------------------------------------

fn test_leader_death_triggers_election() {
    // Setup: soul 20 has accepted soul 30 as leader. Then soul 30
    // dies (gossip marks it DEAD). le_step should detect that and
    // kick off a fresh election. After the election times out with
    // no higher-ID peer (10 is lower than 20), soul 20 wins.
    let peers = _list2("127.0.0.1:8770", "127.0.0.1:8772")
    let ids = _list2(10, 30)
    let le20 = _mk_le("127.0.0.1:8771", 20, peers, ids)
    le_set_timeout_ms(le20, 1)
    // Pretend soul 30 already won an election.
    le_on_victory(le20, 30)
    ce_eq("setup: leader=30", le_current_leader(le20), 30)
    // Now mark soul 30 as DEAD via gossip's failure detector.
    // Three timeouts == DEAD per gossip's suspicion model.
    let gs = le20[LE_S_GOSSIP]
    gossip_on_timeout(gs, "127.0.0.1:8772")
    gossip_on_timeout(gs, "127.0.0.1:8772")
    gossip_on_timeout(gs, "127.0.0.1:8772")
    // le_step detects DEAD leader and kicks a new election.
    le_step(le20)
    ce_eq("after step: state=ELECTING", le_election_state(le20), LE_STATE_ELECTING)
    // No higher-ID alive peers (30 is DEAD, 10 is lower) -> after
    // timeout, self wins.
    sleep_ms(5)
    le_election_check(le20)
    ce_eq("re-election: leader=20", le_current_leader(le20), 20)
    ce_eq("re-election: is_leader=1", le_is_leader(le20), 1)
}

fn test_lone_soul_becomes_leader() {
    // Soul 10 alone (no live peers). Should self-elect after one
    // timeout.
    let gs = gossip_init("127.0.0.1:8770", 0)
    let le10 = le_init(gs, 10)
    le_set_timeout_ms(le10, 1)
    le_start_election(le10)
    ce_eq("alone: no ELECTION messages", le_pending_message_count(le10), 0)
    sleep_ms(5)
    le_election_check(le10)
    ce_eq("alone: self is leader", le_current_leader(le10), 10)
}

// ---- election in flight returns -1 --------------------------------------

fn test_election_in_flight_returns_minus_one() {
    let peers = _list2("127.0.0.1:8771", "")
    let ids = _list2(20, 0)
    // Strip the empty placeholder.
    let p2 = list_new(); push(p2, peers[0])
    let i2 = list_new(); push(i2, ids[0])
    let le10 = _mk_le("127.0.0.1:8770", 10, p2, i2)
    le_start_election(le10)
    ce_eq("electing: current_leader=-1", le_current_leader(le10), -1)
    // VICTORY arrives -> back to a leader id.
    le_on_victory(le10, 20)
    ce_check("post-victory leader != -1", le_current_leader(le10) != -1)
}

// ---- force_election --------------------------------------------------

fn test_force_election_overrides_stable_leader() {
    let peers = _list2("127.0.0.1:8771", "")
    let p2 = list_new(); push(p2, peers[0])
    let i2 = list_new(); push(i2, 20)
    let le10 = _mk_le("127.0.0.1:8770", 10, p2, i2)
    // Establish a stable leader.
    le_on_victory(le10, 20)
    ce_eq("stable: leader=20", le_current_leader(le10), 20)
    // Force a fresh election.
    le_force_election(le10)
    ce_eq("after force: leader=-1", le_current_leader(le10), -1)
    ce_eq("after force: state=ELECTING", le_election_state(le10), LE_STATE_ELECTING)
}

// ---- message handlers --------------------------------------------------

fn test_on_election_from_lower_replies_ok() {
    // Soul 30 receives ELECTION from soul 10 (lower). It should
    // enqueue an OK to soul 10 and start its own election.
    let peers = _list2("127.0.0.1:8770", "127.0.0.1:8771")
    let ids = _list2(10, 20)
    let le30 = _mk_le("127.0.0.1:8772", 30, peers, ids)
    le_on_election(le30, 10)
    let pending = le_drain_pending(le30)
    // Should have at least one OK (to 10) plus zero or more
    // ELECTION messages (nothing higher than 30 in alive set, so
    // just the OK).
    let saw_ok_to_10 = 0
    let i = 0
    while i < len(pending) {
        if pending[i][LE_PEND_TO_ID] == 10 {
            if pending[i][LE_PEND_KIND] == LE_MSG_OK { saw_ok_to_10 = 1 }
        }
        i = i + 1
    }
    ce_eq("ELECTION from lower triggers OK reply", saw_ok_to_10, 1)
    ce_eq("ELECTION from lower starts own election",
          le_election_state(le30), LE_STATE_ELECTING)
}

fn test_on_election_from_higher_no_reply() {
    // Soul 10 receives ELECTION from soul 30 (higher). It does
    // nothing (waits for the eventual VICTORY).
    let peers = _list2("127.0.0.1:8771", "127.0.0.1:8772")
    let ids = _list2(20, 30)
    let le10 = _mk_le("127.0.0.1:8770", 10, peers, ids)
    le_on_election(le10, 30)
    ce_eq("ELECTION from higher: no outbound", le_pending_message_count(le10), 0)
    ce_eq("ELECTION from higher: state stays STABLE", le_election_state(le10), LE_STATE_STABLE)
}

fn test_on_victory_from_lower_rejected() {
    // Soul 30 receives VICTORY from soul 10 (lower). Bully rule
    // says ignore -- a lower ID cannot legitimately claim victory.
    let gs = gossip_init("127.0.0.1:8772", 0)
    let le30 = le_init(gs, 30)
    le_on_victory(le30, 10)
    ce_eq("VICTORY from lower: leader unchanged (still -1)",
          le_current_leader(le30), LE_NO_LEADER)
}

fn test_on_ok_marks_deposed_counter() {
    let peers = _list2("127.0.0.1:8771", "")
    let p2 = list_new(); push(p2, peers[0])
    let i2 = list_new(); push(i2, 20)
    let le10 = _mk_le("127.0.0.1:8770", 10, p2, i2)
    le_start_election(le10)
    le_on_ok(le10, 20)
    ce_eq("OK from higher bumps deposed counter", le_stats_deposed(le10), 1)
}

fn test_election_check_defers_to_higher_via_gossip() {
    // Gossip-derived bully convergence: soul 10 starts an election;
    // the OK message transport is NOT wired (queue drained / dropped);
    // soul 10's election times out with GOT_OK=0. Because the
    // gossip-alive view shows a higher-ID peer (20) is alive, soul
    // 10 defers to 20 as leader (treating it AS IF a VICTORY arrived).
    let peers = _list2("127.0.0.1:8771", "")
    let p2 = list_new(); push(p2, peers[0])
    let i2 = list_new(); push(i2, 20)
    let le10 = _mk_le("127.0.0.1:8770", 10, p2, i2)
    le_set_timeout_ms(le10, 1)
    le_start_election(le10)
    // Drop the queued ELECTION messages without delivering them
    // (this is what the integration scenario does).
    le_drain_pending(le10)
    sleep_ms(5)
    le_election_check(le10)
    ce_eq("gossip-derived defer: leader=20", le_current_leader(le10), 20)
    ce_eq("gossip-derived defer: state=STABLE",
          le_election_state(le10), LE_STATE_STABLE)
    ce_eq("gossip-derived defer: deposed counter bumped",
          le_stats_deposed(le10), 1)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_init_starts_with_no_leader()
    test_init_is_not_leader_yet()
    test_register_peer_adds_mapping()
    test_register_peer_idempotent_on_addr()
    test_unregister_peer_drops_mapping()
    test_three_souls_highest_wins()
    test_highest_soul_self_election_wins()
    test_leader_death_triggers_election()
    test_lone_soul_becomes_leader()
    test_election_in_flight_returns_minus_one()
    test_force_election_overrides_stable_leader()
    test_on_election_from_lower_replies_ok()
    test_on_election_from_higher_no_reply()
    test_on_victory_from_lower_rejected()
    test_on_ok_marks_deposed_counter()
    test_election_check_defers_to_higher_via_gossip()
    ce_summary("leader_election")
}

main()
