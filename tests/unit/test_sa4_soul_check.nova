// CE_TEST_TIMEOUT: 240
// The v4-sa3 soul phases (A2.4c): CHECK (SET 5), OPEN (SA4_ACCUSE) and the
// final SET 2, N = 5 (t = 4). The victim is soul x = 1 (id 7) unless said
// otherwise; faulty senders are made by the harness surgery of
// tests/sa4_harness.nova (the sender signs its own bad line).
//   - one COMPLAINT per content kind (open, version, fields, commit), each
//     with the correct leaf hash and a signature over T_c(me, u, own H1,
//     lh) that verifies under the soul's roster key; never a refusal;
//   - structural faults refuse bad_share without a COMPLAINT;
//   - c^SK zero after CHECK; eseed (slot 34) zero after the final SET 2
//     and after a refusal; held shares outside U2 zeroed;
//   - the accused opens a valid complaint (X25519_base(e) == own e_pk) and
//     answers END 5 0 without refusing for a zero signature, a wrong
//     signer, another leaf, another round, another H1;
//   - the ACCUSE refusals of SPEC 7.6 and the final SET 2 refusals of 7.7;
//     SET 2 in SHARED and ACCUSE twice are unexpected.

import "../ce_test.nova"
import "../sa4_harness.nova"

let SC_R = 71

// Everyone through R1 (with sender faults); returns [souls, advs, r1].
fn sc_r1(roster, vc, faults) {
    return sa4e_through_r1(roster, 5, SC_R, vc, faults)
}

fn sc_set(k, xs) { return sa4w_fmt_set(SC_R, k, sa4w_bitmap(xs)) }

// Soul i's batch: its shares (all senders) + SET 5 over all five.
fn sc_check_lines(st, id) {
    return sa4h_cat(sa4e_shares_to(st[2], id), sa4h_one(sc_set(5, [1, 2, 3, 4, 5])))
}

fn sc_zero32(b) {
    if b == 0 { return 1 }
    let i = 0
    while i < 32 {
        if load8(b + i) != 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn sc_expect(label, sl, lines, code, frag) {
    let f = sa4h_feed(sl, lines)
    ce_eq(label + ": refused", f[0], 0)
    let outs = f[1]
    let last = ""
    if len(outs) > 0 { last = outs[len(outs) - 1] }
    let me = sl[2][0]
    ce_str_eq(label + ": abort line", last, "SA4_ABORT " + int_to_str(SC_R) + " " + int_to_str(me) + " " + code)
    ce_check(label + ": reason '" + frag + "' (got '" + f[2] + "')", find_bytes(f[2], frag) >= 0)
    ce_eq(label + ": no COMPLAINT", len(sa4h_filter(outs, "SA4_COMPLAINT ")), 0)
    ce_eq(label + ": no OPEN", len(sa4h_filter(outs, "SA4_OPEN ")), 0)
    ce_eq(label + ": secrets wiped (slot 34 included)", sa4h_wiped(sl), 1)
    ce_eq(label + ": v4-sa3 slots cleared", sl[35] + sl[36] + sl[37], 0)
    return 0
}

fn test_complaint_kinds(roster, vc) {
    let kinds = ["open", "fields", "commit", "version"]
    let modes = [1, 2, 3, 6]
    let fp = sa4w_unhex(sroster_fingerprint(roster), 32)
    let k = 0
    while k < 4 {
        let lab = "complaint (" + kinds[k] + ")"
        let st = sc_r1(roster, vc, [[1, 1, 1, modes[k]]])
        let v = st[0][0]
        let csk = v[12]
        let lines = sc_check_lines(st, 7)
        let f = sa4h_feed(v, lines)
        ce_eq(lab + ": no refusal (" + f[2] + ")", f[0], 1)
        let cl = sa4h_filter(f[1], "SA4_COMPLAINT ")
        ce_eq(lab + ": exactly one complaint", len(cl), 1)
        ce_str_eq(lab + ": END 4 1", f[1][len(f[1]) - 1], sa4w_fmt_end(SC_R, 4, 7, 1))
        let q = sa4w_parse(cl[0])
        ce_eq(lab + ": from me", q[2], 7)
        ce_eq(lab + ": about the sender", q[3], 300)
        let line = sa4e_shares_to(st[2], 7)[0]
        let p = sa4w_parse(line)
        ce_eq(lab + ": the bad line is 300's", p[2], 300)
        let lh = sa4w_sleaf(fp, SC_R, 300, 1, 7, p[5], p[4])
        ce_str_eq(lab + ": lh is the leaf of the received line", sa4w_hex(q[4]), sa4w_hex(lh))
        let msg = sa4w_complaint_transcript(fp, SC_R, 7, 300, v[23], lh)
        ce_eq(lab + ": signature verifies over T_c with the own H1", ed25519_verify(msg, q[5], ed25519_hex_to_bytes(SA4H_PKS[0])), 1)
        // The judge's view of the same line names the kind.
        let e = sac_eph_key(st[0][1][34], SC_R, 300, 7)
        let jk = sac_enc_key(e[0], sac_list_to_buf(sa4w_parse(st[1][0])[3]), SC_R, 300, 7)
        ce_str_eq(lab + ": the judge's check names the kind", sa4w_share_check(fp, SC_R, 300, 7, 1, 3, jk[0], p[4], sa4w_parse(st[1][1])[7])[0], kinds[k])
        ce_eq(lab + ": state CHECKED", sa4s_state(v), SA4S_ST_CHECKED)
        ce_str_eq(lab + ": sa4s_complained", sa4e_ids_str(sa4s_complained(v)), "300")
        ce_eq(lab + ": no held share from the sender", v[19][1], 0)
        ce_check(lab + ": held shares from the others", v[19][2] != 0)
        ce_eq(lab + ": c^SK bytes zero after CHECK", sc_zero32(csk), 1)
        ce_eq(lab + ": c^SK slot cleared after CHECK", v[12], 0)
        ce_check(lab + ": eseed kept until the final SET 2", sc_zero32(v[34]) == 0)
        k = k + 1
    }
    // Several bad senders: one complaint each, ascending sender x.
    let st2 = sc_r1(roster, vc, [[1, 4, 1, 1], [1, 2, 1, 3]])
    let f2 = sa4h_feed(st2[0][0], sc_check_lines(st2, 7))
    let cl2 = sa4h_filter(f2[1], "SA4_COMPLAINT ")
    ce_eq("two bad senders: two complaints", len(cl2), 2)
    ce_eq("two bad senders: ascending sender x (65536 first)", sa4w_parse(cl2[0])[3], 65536)
    ce_eq("two bad senders: then 4294967295", sa4w_parse(cl2[1])[3], 4294967295)
    ce_str_eq("two bad senders: END 4 2", f2[1][len(f2[1]) - 1], sa4w_fmt_end(SC_R, 4, 7, 2))
    // Honest batch: no complaint.
    let st3 = sc_r1(roster, vc, list_new())
    let f3 = sa4h_feed(st3[0][0], sc_check_lines(st3, 7))
    ce_eq("honest batch: one line (END 4 0)", len(f3[1]), 1)
    ce_str_eq("honest batch: END 4 0", f3[1][0], sa4w_fmt_end(SC_R, 4, 7, 0))
    return 0
}

fn test_structural(roster, vc) {
    let st = sc_r1(roster, vc, list_new())
    let mine = sa4e_shares_to(st[2], 7)
    let set5 = sc_set(5, [1, 2, 3, 4, 5])
    let q = sa4w_parse(mine[0])
    let lo = sa4w_unhex(SA4W_LOW_ORDER[2], 32)
    let bad_epk = sa4w_fmt_share(SC_R, q[2], 7, q[4], lo)
    let rest = list_new()
    let i = 1
    while i < len(mine) {
        push(rest, mine[i])
        i = i + 1
    }
    sc_expect("low-order e_pk", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(bad_epk), rest), sa4h_one(set5)), "bad_share", "one-time key is not a valid X25519 key")
    let nc = list_new()
    i = 0
    while i < 32 {
        push(nc, 255)
        i = i + 1
    }
    list_set(nc, 31, 127)
    sc_expect("non-canonical e_pk", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(sa4w_fmt_share(SC_R, q[2], 7, q[4], nc)), rest), sa4h_one(set5)), "bad_share", "one-time key is not a valid X25519 key")
    let short = list_new()
    i = 0
    while i < len(q[4]) - 32 {
        push(short, q[4][i])
        i = i + 1
    }
    sc_expect("ciphertext of another depth", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(sa4w_fmt_share(SC_R, q[2], 7, short, q[5])), rest), sa4h_one(set5)), "bad_share", "wrong length")
    sc_expect("two shares from one soul", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(mine[0]), sa4h_cat(sa4h_one(mine[0]), sa4h_cat(sa4h_one(mine[1]), sa4h_one(mine[2])))), sa4h_one(set5)), "bad_share", "two shares from one soul")
    sc_expect("share from a soul outside U2'", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(mine, sa4h_one(sc_set(5, [1, 2, 3, 4]))), "bad_share", "share lines do not match U2'")
    sc_expect("share from a soul outside U2' (count right)", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(mine[0]), sa4h_cat(sa4h_one(mine[1]), sa4h_one(mine[3]))), sa4h_one(sc_set(5, [1, 2, 3, 4]))), "bad_share", "outside U2'")
    let other = sa4e_shares_to(st[2], 300)
    sc_expect("share addressed to another soul", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(other[1]), rest), sa4h_one(set5)), "bad_share", "addressed to another soul")
    sc_expect("share lines short of U2'", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(rest, sa4h_one(set5)), "bad_share", "share lines do not match U2'")
    sc_expect("SET 2 in SHARED (no check phase)", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(mine, sa4h_one(sc_set(2, [1, 2, 3, 4, 5]))), "unexpected", "unexpected line in state 2")
    sc_expect("|U2'| < t", sc_r1(roster, vc, list_new())[0][0], sa4h_cat(sa4h_cat(sa4h_one(mine[0]), sa4h_one(mine[1])), sa4h_one(sc_set(5, [1, 2, 3]))), "u2_small", "|U2'| below the threshold")
    return 0
}

// The victim (7) as accused: 300 (x = 2) got a bad share from it and
// complained. Returns [st, complaint line from 300, 7's line to 300].
fn sc_accused(roster, vc) {
    let st = sc_r1(roster, vc, [[1, 0, 2, 1]])
    let f = sa4h_feed(st[0][0], sc_check_lines(st, 7))
    ce_eq("accused through CHECK", f[0], 1)
    let f3 = sa4h_feed(st[0][1], sc_check_lines(st, 300))
    let cl = sa4h_filter(f3[1], "SA4_COMPLAINT ")
    let line = sa4e_shares_to(st[2], 300)[0]
    return [st, cl[0], line]
}

fn test_open(roster, vc) {
    let fp = sa4w_unhex(sroster_fingerprint(roster), 32)
    let a = sc_accused(roster, vc)
    let v = a[0][0][0]
    let f = sa4h_feed(v, [a[1], sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))])
    ce_eq("valid complaint: no refusal", f[0], 1)
    ce_eq("valid complaint: one OPEN", len(sa4h_filter(f[1], "SA4_OPEN ")), 1)
    let op = sa4w_parse(f[1][0])
    ce_eq("OPEN from me", op[2], 7)
    ce_eq("OPEN about the complainer", op[3], 300)
    let pkb = alloc(33)
    x25519_base(pkb, sac_list_to_buf(op[4]))
    ce_str_eq("X25519_base(e) == own e_pk", sa4w_hex(sac_buf_to_list(pkb, 32)), sa4w_hex(sa4w_parse(a[2])[5]))
    ce_str_eq("END 5 1", f[1][1], sa4w_fmt_end(SC_R, 5, 7, 1))
    ce_eq("state OPENED", sa4s_state(v), SA4S_ST_OPENED)
    // The revealed key opens exactly that line (the judge's view): fields
    // fault of the dealer shows as "open" (garbage).
    let jk = sac_enc_key(sac_list_to_buf(op[4]), sac_list_to_buf(sa4w_parse(a[0][1][1])[3]), SC_R, 7, 300)
    ce_str_eq("the opened line fails the judge's check (garbage)", sa4w_share_check(fp, SC_R, 7, 300, 2, 3, jk[0], sa4w_parse(a[2])[4], sa4w_parse(a[0][1][0])[7])[0], "open")
    ce_str_eq("ACCUSE twice is unexpected", sa4h_feed(v, sa4h_one(sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))))[1][0], "SA4_ABORT 71 7 unexpected")
    // Forged complaints: no OPEN, no refusal.
    let q = sa4w_parse(a[1])
    let lh = q[4]
    let h1 = v[23]
    let names = ["zero signature", "wrong signer (65536 signs as 300)", "another leaf", "another round", "another H1"]
    let k = 0
    while k < 5 {
        let b = sc_accused(roster, vc)
        let vb = b[0][0][0]
        let cl = ""
        if k == 0 { cl = sa4w_fmt_complaint(SC_R, 300, 7, lh, sa4h_cat(lh, lh)) }
        if k == 1 { cl = sa4w_fmt_complaint(SC_R, 300, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, SC_R, 300, 7, h1, lh), ed25519_hex_to_bytes(SA4H_SEEDS[2]), ed25519_hex_to_bytes(SA4H_PKS[2]))) }
        if k == 2 {
            let lh2 = sa4w_sha256(lh)
            cl = sa4w_fmt_complaint(SC_R, 300, 7, lh2, ed25519_sign(sa4w_complaint_transcript(fp, SC_R, 300, 7, h1, lh2), ed25519_hex_to_bytes(SA4H_SEEDS[1]), ed25519_hex_to_bytes(SA4H_PKS[1])))
        }
        if k == 3 { cl = sa4w_fmt_complaint(SC_R, 300, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, SC_R - 1, 300, 7, h1, lh), ed25519_hex_to_bytes(SA4H_SEEDS[1]), ed25519_hex_to_bytes(SA4H_PKS[1]))) }
        if k == 4 { cl = sa4w_fmt_complaint(SC_R, 300, 7, lh, ed25519_sign(sa4w_complaint_transcript(fp, SC_R, 300, 7, sa4w_sha256(h1), lh), ed25519_hex_to_bytes(SA4H_SEEDS[1]), ed25519_hex_to_bytes(SA4H_PKS[1]))) }
        let fb = sa4h_feed(vb, [cl, sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))])
        ce_eq(names[k] + ": no refusal", fb[0], 1)
        ce_eq(names[k] + ": one line", len(fb[1]), 1)
        ce_str_eq(names[k] + ": END 5 0", fb[1][0], sa4w_fmt_end(SC_R, 5, 7, 0))
        k = k + 1
    }
    return 0
}

fn test_accuse_refusals(roster, vc) {
    let a = sc_accused(roster, vc)
    let cl = a[1]
    sc_expect("ACCUSE bitmap has bits above N", sc_accused(roster, vc)[0][0][0], [cl, sa4w_fmt_accuse(SC_R, sa4w_bitmap([2, 6]))], "bad_set", "ACCUSE bitmap has bits above N")
    sc_expect("empty ACCUSE set", sc_accused(roster, vc)[0][0][0], sa4h_one(sa4w_fmt_accuse(SC_R, sa4w_bitmap(list_new()))), "bad_set", "empty ACCUSE set")
    sc_expect("ACCUSE naming the accused itself", sc_accused(roster, vc)[0][0][0], [cl, sa4w_fmt_accuse(SC_R, sa4w_bitmap([1]))], "bad_set", "not a subset of U2' without this soul")
    sc_expect("ACCUSE with no complaint lines", sc_accused(roster, vc)[0][0][0], sa4h_one(sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))), "bad_complaint", "complaint lines do not match the ACCUSE set")
    let q = sa4w_parse(cl)
    let other = sa4w_fmt_complaint(SC_R, 300, 65536, q[4], q[5])
    sc_expect("complaint about another soul", sc_accused(roster, vc)[0][0][0], [other, sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))], "bad_complaint", "complaint about another soul")
    let from3 = sa4w_fmt_complaint(SC_R, 65536, 7, q[4], q[5])
    sc_expect("complaint from a soul outside the ACCUSE set", sc_accused(roster, vc)[0][0][0], [from3, sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))], "bad_complaint", "outside the ACCUSE set")
    let from9 = sa4w_fmt_complaint(SC_R, 9, 7, q[4], q[5])
    sc_expect("complaint from an id not in the roster", sc_accused(roster, vc)[0][0][0], [from9, sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))], "bad_complaint", "outside the ACCUSE set")
    sc_expect("two complaints from one soul", sc_accused(roster, vc)[0][0][0], [cl, cl, sa4w_fmt_accuse(SC_R, sa4w_bitmap([2, 3]))], "bad_complaint", "two complaints from one soul")
    sc_expect("complaints without SA4_ACCUSE", sc_accused(roster, vc)[0][0][0], [cl, sc_set(2, [1, 2, 3, 4, 5])], "bad_complaint", "complaints without SA4_ACCUSE")
    sc_expect("more complaint lines than souls", sc_accused(roster, vc)[0][0][0], [cl, cl, cl, cl, cl, cl], "bad_complaint", "more lines than souls")
    sc_expect("ACCUSE before CHECK", sc_r1(roster, vc, list_new())[0][0], sa4h_one(sa4w_fmt_accuse(SC_R, sa4w_bitmap([2]))), "unexpected", "unexpected line in state 2")
    return 0
}

// The victim through CHECK with a complaint about 300 (bad share to 7).
fn sc_complained(roster, vc) {
    let st = sc_r1(roster, vc, [[1, 1, 1, 1]])
    let f = sa4h_feed(st[0][0], sc_check_lines(st, 7))
    ce_eq("victim complains", len(sa4h_filter(f[1], "SA4_COMPLAINT ")), 1)
    return st
}

fn test_final_set2(roster, vc) {
    sc_expect("U2 bitmap has bits above N", sc_complained(roster, vc)[0][0], sa4h_one(sc_set(2, [1, 3, 4, 5, 6])), "bad_set", "U2 bitmap has bits above N")
    sc_expect("|U2| < t", sc_complained(roster, vc)[0][0], sa4h_one(sc_set(2, [1, 3, 4])), "u2_small", "|U2| below the threshold")
    sc_expect("not in U2", sc_complained(roster, vc)[0][0], sa4h_one(sc_set(2, [2, 3, 4, 5])), "not_in_u2", "this soul is not in U2")
    sc_expect("U2 contains a complained-about soul", sc_complained(roster, vc)[0][0], sa4h_one(sc_set(2, [1, 2, 3, 4, 5])), "bad_set", "complained about")
    // U2 not a subset of U2': U2' = souls 1-4 (soul 5 dropped at shares).
    let st = sc_r1(roster, vc, list_new())
    let v = st[0][0]
    let mine = sa4h_cat(sa4e_shares_to(st[2], 7), list_new())
    let m4 = list_new()
    let i = 0
    while i < len(mine) {
        if sa4w_parse(mine[i])[2] != 4294967295 { push(m4, mine[i]) }
        i = i + 1
    }
    ce_eq("CHECK with U2' = souls 1-4", sa4h_feed(v, sa4h_cat(m4, sa4h_one(sc_set(5, [1, 2, 3, 4]))))[0], 1)
    sc_expect("U2 not a subset of U2'", v, sa4h_one(sc_set(2, [1, 2, 3, 4, 5])), "bad_set", "U2 is not a subset of U2'")
    // The accepted final SET 2: complained-about 300 excluded; the held
    // share of 4294967295 (in U2', not in U2) is zeroed; eseed wiped.
    let st2 = sc_complained(roster, vc)
    let v2 = st2[0][0]
    let es = v2[34]
    let hv5 = v2[19][4]
    ce_check("held share of soul 5 present before SET 2", hv5 != 0)
    let s5 = hv5[0]
    let f = sa4h_feed(v2, sa4h_one(sc_set(2, [1, 3, 4])))
    ce_eq("|U2| = 3 refused", f[0], 0)
    let st3 = sc_complained(roster, vc)
    let v3 = st3[0][0]
    let es3 = v3[34]
    let hv3 = v3[19][4]
    let sl3 = v3[35]
    let fy = sa4h_feed(v3, sa4h_one(sc_set(2, [1, 3, 4, 5])))
    ce_eq("final SET 2 without the accused: y sent", fy[0], 1)
    ce_eq("y chunks + END 2", len(fy[1]), 3)
    ce_eq("state MASKED", sa4s_state(v3), SA4S_ST_MASKED)
    ce_eq("eseed bytes zero after the final SET 2", sc_zero32(es3), 1)
    ce_eq("eseed slot zero after the final SET 2", v3[34], 0)
    ce_eq("share leaves dropped", v3[35], 0)
    ce_check("leaves were present before", sl3 != 0)
    ce_check("the held share of soul 5 (in U2) is kept", v3[19][4] != 0)
    // Held share outside U2: U2 = souls 1, 3, 4, 5 excludes 300 (whose
    // share was never held) -- use a run where U2 drops a held soul.
    let st4 = sc_r1(roster, vc, list_new())
    let v4 = st4[0][0]
    sa4h_feed(v4, sc_check_lines(st4, 7))
    let h5 = v4[19][4]
    let s5b = h5[0]
    let b5b = h5[1]
    ce_eq("final SET 2 without soul 5", sa4h_feed(v4, sa4h_one(sc_set(2, [1, 2, 3, 4])))[0], 1)
    ce_eq("held share of soul 5 dropped", v4[19][4], 0)
    let z = 0
    i = 0
    while i < 32 {
        z = z + s5b[i] + b5b[i]
        i = i + 1
    }
    ce_eq("held share of soul 5 zeroed", z, 0)
    ce_eq("eseed slot zero after a refusal", v2[34], 0)
    ce_eq("eseed bytes zero after a refusal", sc_zero32(es), 1)
    ce_check("refusal path touched soul 5's held list", len(s5) == 32)
    return 0
}

// Pass 1 (structure) runs over the whole batch before pass 2 (content):
// a batch with a content fault from x = 2 and a structural fault from
// x = 5 is refused before anything is signed (no new signature in the
// soul's cache).
fn test_pass_order(roster, vc) {
    let st = sc_r1(roster, vc, [[1, 1, 1, 1]])
    let v = st[0][0]
    let mine = sa4e_shares_to(st[2], 7)
    let lo = sa4w_unhex(SA4W_LOW_ORDER[3], 32)
    let lines = list_new()
    let i = 0
    while i < len(mine) {
        let q = sa4w_parse(mine[i])
        if q[2] == 4294967295 {
            push(lines, sa4w_fmt_share(SC_R, q[2], 7, q[4], lo))
        } else {
            push(lines, mine[i])
        }
        i = i + 1
    }
    push(lines, sc_set(5, [1, 2, 3, 4, 5]))
    let fresh = list_new()
    list_set(v, 5, fresh)
    sc_expect("content fault at x = 2, structural fault at x = 5", v, lines, "bad_share", "one-time key is not a valid X25519 key")
    let signs = 0
    i = 0
    while i < len(fresh) {
        if char_at(fresh[i][0], 0) == 115 { signs = signs + 1 }
        i = i + 1
    }
    ce_eq("nothing signed before the structural refusal", signs, 0)
    // Control: without the structural fault the complaint is signed.
    let st2 = sc_r1(roster, vc, [[1, 1, 1, 1]])
    let v2 = st2[0][0]
    let fresh2 = list_new()
    list_set(v2, 5, fresh2)
    ce_eq("control: complaint batch accepted", sa4h_feed(v2, sc_check_lines(st2, 7))[0], 1)
    let signs2 = 0
    i = 0
    while i < len(fresh2) {
        if char_at(fresh2[i][0], 0) == 115 { signs2 = signs2 + 1 }
        i = i + 1
    }
    ce_eq("control: one complaint signature", signs2, 1)
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    test_pass_order(roster, vc)
    test_complaint_kinds(roster, vc)
    test_structural(roster, vc)
    test_open(roster, vc)
    test_accuse_refusals(roster, vc)
    test_final_set2(roster, vc)
    ce_summary("sa4_soul_check")
}

main()
