// Unit tests for src/io/effectors/tool.nova (P4, ADR-0054).
//
// The tool abstraction: a tool carries a capability, a backend kind, an action
// type, a cost, and a Bayesian competence. Covered: accessors, competence
// updates on success/failure, selection of the highest-competence tool for a
// capability (and the failure-flips-selection behaviour), cost tie-break, the
// permission/reversibility gate (AUTO/NOTIFY run, APPROVE denied unless
// approved), and the tool-result type.
//
// ADR-0054, ADR-0019/0023, ADR-0041/0042.

import "../ce_test.nova"
import "../../src/io/effectors/tool.nova"

fn test_tool_basics() {
    let t = tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 3, "cfg")
    ce_str_eq("name", tool_name(t), "calc")
    ce_eq("kind", tool_kind(t), TOOLK_CODE_EXEC)
    ce_str_eq("capability", tool_capability(t), "compute")
    ce_eq("action type", tool_action(t), ACT_READ_LOCAL)
    ce_eq("cost", tool_cost(t), 3)
    ce_str_eq("config", tool_config(t), "cfg")
    ce_eq("uniform competence", tool_competence(t), 500)
    ce_eq("no executions yet", tool_executions(t), 0)
}

fn test_competence_updates() {
    let t = tool_new("x", TOOLK_CODE_EXEC, "c", ACT_READ_LOCAL, 1, "")
    tool_observe(t, 1)
    tool_observe(t, 1)
    ce_eq("two successes -> 0.75", tool_competence(t), 750)
    ce_eq("two executions counted", tool_executions(t), 2)
    tool_observe(t, 0)
    ce_check("a failure lowers competence", tool_competence(t) < 750)
}

fn test_select_by_competence() {
    let reg = tool_registry_new()
    let a = tool_new("a", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, "")
    let b = tool_new("b", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, "")
    tool_register(reg, a)
    tool_register(reg, b)
    tool_observe(b, 1)
    tool_observe(b, 1)
    ce_str_eq("most competent selected", tool_name(tool_select(reg, "compute")), "b")
    ce_eq("no tool for unknown capability", tool_select(reg, "fly"), 0)
    tool_observe(b, 0)
    tool_observe(b, 0)
    tool_observe(b, 0)
    ce_str_eq("after b fails, a is selected", tool_name(tool_select(reg, "compute")), "a")
}

fn test_tiebreak_cost() {
    let reg = tool_registry_new()
    let pricey = tool_new("pricey", TOOLK_CODE_EXEC, "c", ACT_READ_LOCAL, 9, "")
    let cheap  = tool_new("cheap",  TOOLK_CODE_EXEC, "c", ACT_READ_LOCAL, 1, "")
    tool_register(reg, pricey)
    tool_register(reg, cheap)
    ce_str_eq("equal competence -> cheaper wins", tool_name(tool_select(reg, "c")), "cheap")
}

fn test_gating() {
    let read_t = tool_new("r", TOOLK_FILE_READ, "read", ACT_READ_LOCAL, 1, "")
    ce_eq("read auto-executes", tool_gate(read_t, 0), TGATE_EXECUTE)
    let write_t = tool_new("w", TOOLK_FILE_WRITE, "write", ACT_WRITE_LOCAL, 1, "")
    ce_eq("write runs at NOTIFY", tool_gate(write_t, 0), TGATE_NOTIFY)
    let fetch_t = tool_new("f", TOOLK_HTTP, "search", ACT_NET_FETCH, 1, "")
    ce_eq("fetch runs at NOTIFY", tool_gate(fetch_t, 0), TGATE_NOTIFY)
    let send_t = tool_new("s", TOOLK_HTTP, "send", ACT_SEND_MSG, 1, "")
    ce_eq("send denied unapproved", tool_gate(send_t, 0), TGATE_DENY)
    ce_eq("send executes when approved", tool_gate(send_t, 1), TGATE_EXECUTE)
    let spend_t = tool_new("p", TOOLK_HTTP, "pay", ACT_SPEND, 1, "")
    ce_eq("spend denied unapproved (irreversible)", tool_gate(spend_t, 0), TGATE_DENY)
}

fn test_result() {
    let r = tr_new(1, 42, "ok")
    ce_eq("ok flag", tr_ok(r), 1)
    ce_eq("value", tr_value(r), 42)
    ce_str_eq("text", tr_text(r), "ok")
    ce_eq("denied result is not ok", tr_ok(tr_denied()), 0)
}

fn main() {
    test_tool_basics()
    test_competence_updates()
    test_select_by_competence()
    test_tiebreak_cost()
    test_gating()
    test_result()
    ce_summary("tool")
}

main()
