// ---- R97 IS_A new forms --------------------------------------------------

fn test_is_x_a_kind_of_y() {
    let q = grammar_parse("is earth a kind of planet")
    ce_eq("is X a kind of Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "earth")
    ce_str_eq("y (kind-of stripped)", sq_is_a_y(q), "planet")
}

fn test_is_x_a_type_of_y() {
    let q = grammar_parse("is earth a type of planet")
    ce_eq("is X a type of Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "earth")
    ce_str_eq("y (type-of stripped)", sq_is_a_y(q), "planet")
}

fn test_is_x_kind_of_y_no_a() {
    let q = grammar_parse("is earth kind of planet")
    ce_eq("is X kind of Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "earth")
    ce_str_eq("y", sq_is_a_y(q), "planet")
}

fn test_is_x_type_of_y_no_a() {
    let q = grammar_parse("is earth type of planet")
    ce_eq("is X type of Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "earth")
    ce_str_eq("y", sq_is_a_y(q), "planet")
}

fn test_does_x_count_as_y() {
    let q = grammar_parse("does earth count as a planet")
    ce_eq("does X count as Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "earth")
    ce_str_eq("y (a stripped)", sq_is_a_y(q), "planet")
    let q2 = grammar_parse("does mars count as planet")
    ce_eq("no article -> IS_A", sq_kind(q2), NLK_IS_A)
    ce_eq("x2", sq_is_a_x(q2), "mars")
    ce_eq("y2", sq_is_a_y(q2), "planet")
}

fn test_is_x_considered_y() {
    let q = grammar_parse("is pluto considered a planet")
    ce_eq("is X considered Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "pluto")
    ce_str_eq("y", sq_is_a_y(q), "planet")
    let q2 = grammar_parse("is pluto considered planet")
    ce_eq("no article -> IS_A", sq_kind(q2), NLK_IS_A)
    ce_eq("y2", sq_is_a_y(q2), "planet")
}

fn test_declarative_is_a() {
    let q = grammar_parse("einstein is a physicist")
    ce_eq("declarative X is a Y -> IS_A", sq_kind(q), NLK_IS_A)
    ce_str_eq("x", sq_is_a_x(q), "einstein")
    ce_str_eq("y", sq_is_a_y(q), "physicist")
    let q2 = grammar_parse("einstein is an author")
    ce_eq("declarative X is an Y -> IS_A", sq_kind(q2), NLK_IS_A)
    ce_eq("x2", sq_is_a_x(q2), "einstein")
    ce_eq("y2", sq_is_a_y(q2), "author")
}

