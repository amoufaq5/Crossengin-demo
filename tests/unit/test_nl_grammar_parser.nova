// ---- R97 RELATE: new forms -----------------------------------------------

fn test_how_does_x_relate_to_y() {
    let q = grammar_parse("how does mitochondria relate to cell")
    ce_eq("how does X relate to Y -> RELATE", sq_kind(q), NLK_RELATE)
    ce_str_eq("a", sq_relate_a(q), "mitochondria")
    ce_str_eq("b", sq_relate_b(q), "cell")
}

fn test_what_is_the_relationship_between() {
    let q = grammar_parse("what is the relationship between mars and venus")
    ce_eq("relationship between -> RELATE", sq_kind(q), NLK_RELATE)
    ce_str_eq("a", sq_relate_a(q), "mars")
    ce_str_eq("b", sq_relate_b(q), "venus")
}

fn test_connection_between() {
    let q = grammar_parse("connection between mars and venus")
