// ---- R97 priority regressions --------------------------------------------

fn test_priority_what_is_the_meaning_of_beats_what_is() {
    // "what is the meaning of X" MUST match the specific 5-word prefix
    // matcher, not the loose "what is <TOPIC>" (which would give topic
    // = "the meaning of X").
    let q = grammar_parse("what is the meaning of entropy")
    ce_eq("topic clean (not 'the meaning of entropy')",
          sq_research_topic(q), "entropy")
}

fn test_priority_add_capsule_beats_research() {
    // "add capsule X" MUST route to CAP_INSTALL, not RESEARCH
    let q = grammar_parse("add capsule medicine")
    ce_eq("add capsule -> CAP_INSTALL", sq_kind(q), NLK_CAPSULE_INSTALL)
}

fn test_priority_forget_beats_research() {
    // "forget X" MUST route to RETRACT, not RESEARCH-with-topic-forget-x
    let q = grammar_parse("forget mars")
    ce_eq("forget -> RETRACT", sq_kind(q), NLK_RETRACT)
}

fn test_priority_installed_capsules_beats_declarative() {
    // "installed capsules" is a 2-token bare form for CAP_LIST; must NOT
    // fall through to declarative IS_A or research.
    let q = grammar_parse("installed capsules")
    ce_eq("installed capsules -> CAP_LIST", sq_kind(q), NLK_CAPSULE_LIST)
}

// ---- R97: every new pattern validates ------------------------------------

fn test_r97_every_new_pattern_validates() {
    let inputs = list_new()
    push(inputs, "explain X")
    push(inputs, "describe X")
    push(inputs, "define X")
    push(inputs, "what does X mean")
    push(inputs, "what is the meaning of X")
    push(inputs, "give me info on X")
    push(inputs, "information about X")
    push(inputs, "i want to know about X")
    push(inputs, "what can you say about X")
    push(inputs, "elaborate on X")
    push(inputs, "expand on X")
    push(inputs, "X definition")
    push(inputs, "X meaning")
    push(inputs, "X explained")
    push(inputs, "overview of X")
    push(inputs, "summary of X")
    push(inputs, "background on X")
    push(inputs, "history of X")
    push(inputs, "origin of X")
    push(inputs, "how does X work")
    push(inputs, "why is X important")
    push(inputs, "facts about X")
    push(inputs, "key points about X")
    push(inputs, "details on X")
    push(inputs, "how does X relate to Y")
    push(inputs, "what is the relationship between X and Y")
    push(inputs, "connection between X and Y")
    push(inputs, "link between X and Y")
    push(inputs, "X vs Y")
    push(inputs, "X versus Y")
    push(inputs, "compare X and Y")
    push(inputs, "comparison of X and Y")
    push(inputs, "similarities between X and Y")
    push(inputs, "difference between X and Y")
    push(inputs, "how are X and Y related")
    push(inputs, "association between X and Y")
    push(inputs, "contradictions in X")
    push(inputs, "conflicts about X")
    push(inputs, "disagreements about X")
    push(inputs, "find contradictions in X")
    push(inputs, "scan for contradictions about X")
    push(inputs, "where does X conflict")
    push(inputs, "inconsistencies in X")
    push(inputs, "is X a kind of Y")
    push(inputs, "is X a type of Y")
    push(inputs, "is X kind of Y")
    push(inputs, "does X count as Y")
    push(inputs, "is X considered Y")
    push(inputs, "einstein is a physicist")
    push(inputs, "forget X")
    push(inputs, "remove X")
    push(inputs, "delete X")
    push(inputs, "unlearn X")
    push(inputs, "withdraw X")
    push(inputs, "retract fact X")
    push(inputs, "forget about X")
    push(inputs, "add capsule X")
    push(inputs, "load capsule X")
    push(inputs, "import capsule X")
    push(inputs, "enable capsule X")
    push(inputs, "install pack X")
    push(inputs, "add skill X")
    push(inputs, "load skill X")
    push(inputs, "enable skill X")
    push(inputs, "activate skill X")
    push(inputs, "show capsules")
    push(inputs, "show all capsules")
    push(inputs, "list all capsules")
    push(inputs, "what capsules are installed")
    push(inputs, "which capsules do i have")
    push(inputs, "installed capsules")
    push(inputs, "available capsules")
    push(inputs, "show skills")
    push(inputs, "show all skills")
    push(inputs, "list all skills")
    push(inputs, "what skills are available")
    push(inputs, "which skills do i have")
    push(inputs, "installed skills")
    push(inputs, "available skills")
    push(inputs, "execute X on Y")
    push(inputs, "use skill X on Y")
    push(inputs, "apply X to Y")
    push(inputs, "run X with Y")
    push(inputs, "use X on Y")
    push(inputs, "invoke X on Y")
    let i = 0
    while i < len(inputs) {
        let q = grammar_parse(inputs[i])
        ce_eq(inputs[i] + " kind non-unparsed",
              sq_kind(q) == NLK_UNPARSED, 0)
        ce_eq(inputs[i] + " validates", sq_validate(q), SQ_OK)
        i = i + 1
    }
}

fn test_every_matched_query_validates() {
    let inputs = list_new()
    push(inputs, "what is X")
    push(inputs, "what do you know about X")
    push(inputs, "tell me about X")
    push(inputs, "does X relate to Y")
    push(inputs, "does X contradict Y")
    push(inputs, "is X a Y")
    push(inputs, "who is X")
    push(inputs, "when did X happen")
    push(inputs, "where is X")
    push(inputs, "why X")
    push(inputs, "retract X")
    push(inputs, "install capsule X")
    push(inputs, "install skill X")
    push(inputs, "list capsules")
    push(inputs, "list skills")
    push(inputs, "run skill X on Y")
    let i = 0
    while i < len(inputs) {
        let q = grammar_parse(inputs[i])
        ce_eq(inputs[i] + " kind non-unparsed",
              sq_kind(q) == NLK_UNPARSED, 0)
        ce_eq(inputs[i] + " validates", sq_validate(q), SQ_OK)
        i = i + 1
    }
}

