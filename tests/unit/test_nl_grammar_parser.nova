fn test_x_vs_y() {
    let q = grammar_parse("mars vs venus")
    ce_eq("X vs Y -> RELATE", sq_kind(q), NLK_RELATE)
    ce_str_eq("a", sq_relate_a(q), "mars")
    ce_str_eq("b", sq_relate_b(q), "venus")
}

fn test_x_versus_y() {
    let q = grammar_parse("mars versus venus")
    ce_eq("X versus Y -> RELATE", sq_kind(q), NLK_RELATE)
