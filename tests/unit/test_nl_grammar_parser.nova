    test_what_are_and_case_insensitivity()
    test_what_is_with_trailing_punctuation()
    test_what_do_you_know_about()
    test_tell_me_about()
    test_does_relate_to()
    test_does_contradict()
    test_does_relate_multi_word_x()
    test_is_a_simple()
    test_is_an()
    test_is_x_multi_word_a_y_multi_word()
    test_who_is()
    test_when_did_x()
    test_where_is()
    test_why_fallback()
    test_retract_simple()
    test_install_capsule()
    test_install_skill()
    test_install_missing_kind_unparsed()
    test_list_capsules()
    test_list_skills_plural_or_singular()
    test_run_skill_on()
    test_run_x_on_y_without_skill_keyword()
    test_run_missing_on_unparsed()
    test_what_do_you_know_beats_what_is()
    test_tell_me_about_beats_what()
    test_every_matched_query_validates()
    // --- R97 preamble stripping ---
    test_preamble_please_leading()
    test_preamble_can_you()
    test_preamble_could_you_please()
    test_preamble_would_you()
    test_preamble_will_you()
    test_preamble_may_i_ask()
    test_preamble_i_want_to_know_about()
    test_preamble_i_would_like_to()
    test_preamble_id_like_to()
    test_preamble_hey()
    test_preamble_hi_there()
    test_preamble_trailing_please()
    test_preamble_trailing_thanks()
    test_preamble_trailing_thank_you()
    test_preamble_both_ends()
    // --- R97 fillers -> NONE ---
