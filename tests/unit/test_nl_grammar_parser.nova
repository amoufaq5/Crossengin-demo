// Unit tests for src/nl/grammar_parser.nova (ADR-0104 R48p2).
// Covers all 15 canonical shapes + edge cases (empty, punctuation,
// case-insensitivity, slash-prefix, near-miss unparsed).

import "../ce_test.nova"
import "../../src/nl/grammar_parser.nova"

// ---- edge cases -----------------------------------------------------------

fn test_empty_returns_none() {
    let q = grammar_parse("")
    ce_eq("empty -> NONE", sq_kind(q), NLK_NONE)
    let q2 = grammar_parse("   \t  \n  ")
    ce_eq("whitespace -> NONE", sq_kind(q2), NLK_NONE)
}

fn test_slash_prefix_returns_unparsed() {
    // The chat's slash-command dispatcher still handles these; grammar
    // deliberately refuses so nl_execute can bypass to the admin path.
    let q = grammar_parse("/ingest cerec foo.cerec kg src:x")
    ce_eq("slash -> UNPARSED", sq_kind(q), NLK_UNPARSED)
    let q2 = grammar_parse("   /help")
    ce_eq("leading-ws slash -> UNPARSED", sq_kind(q2), NLK_UNPARSED)
}

fn test_garbage_returns_unparsed() {
    let q = grammar_parse("floof floof glorpity")
    ce_eq("no pattern -> UNPARSED", sq_kind(q), NLK_UNPARSED)
}

// ---- what is X / what are X ----------------------------------------------

fn test_what_is_simple() {
    let q = grammar_parse("what is photosynthesis")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "photosynthesis")
    ce_eq("no filter", sq_research_kind_filter(q), "")
    ce_eq("parser grammar", sq_parser_used(q), "grammar")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_what_is_multi_word_topic() {
    let q = grammar_parse("what is a black hole")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic joined with space", sq_research_topic(q), "a black hole")
}

fn test_what_are_and_case_insensitivity() {
    let q = grammar_parse("What Are The Planets")
    ce_eq("case-insensitive", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic lowercased", sq_research_topic(q), "the planets")
}

fn test_what_is_with_trailing_punctuation() {
    // Question mark strips at tokenize (non-wordchar).
    let q = grammar_parse("what is einstein?")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic clean", sq_research_topic(q), "einstein")
}

// ---- what do you know about X --------------------------------------------

fn test_what_do_you_know_about() {
    let q = grammar_parse("what do you know about the sun")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "the sun")
}

fn test_tell_me_about() {
    let q = grammar_parse("tell me about mitochondria")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "mitochondria")
}

// ---- does X relate to Y / does X contradict Y ----------------------------

fn test_does_relate_to() {
    let q = grammar_parse("does mitochondria relate to cell")
    ce_eq("kind RELATE", sq_kind(q), NLK_RELATE)
    ce_eq("a", sq_relate_a(q), "mitochondria")
    ce_eq("b", sq_relate_b(q), "cell")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_does_contradict() {
    let q = grammar_parse("does astronomy contradict folk astronomy")
    ce_eq("kind CONTRADICT", sq_kind(q), NLK_CONTRADICT_SCAN)
    ce_eq("a", sq_contradict_a(q), "astronomy")
    ce_eq("b", sq_contradict_b(q), "folk astronomy")
}

fn test_does_relate_multi_word_x() {
    let q = grammar_parse("does the sun relate to gravity")
    ce_eq("kind RELATE", sq_kind(q), NLK_RELATE)
    ce_eq("a multi-word", sq_relate_a(q), "the sun")
    ce_eq("b", sq_relate_b(q), "gravity")
}

// ---- is X a Y ------------------------------------------------------------

fn test_is_a_simple() {
    let q = grammar_parse("is earth a planet")
    ce_eq("kind IS_A", sq_kind(q), NLK_IS_A)
    ce_eq("x", sq_is_a_x(q), "earth")
    ce_eq("y", sq_is_a_y(q), "planet")
}

fn test_is_an() {
    let q = grammar_parse("is einstein an author")
    ce_eq("kind IS_A", sq_kind(q), NLK_IS_A)
    ce_eq("x", sq_is_a_x(q), "einstein")
    ce_eq("y", sq_is_a_y(q), "author")
}

fn test_is_x_multi_word_a_y_multi_word() {
    let q = grammar_parse("is the sun a g type star")
    ce_eq("kind IS_A", sq_kind(q), NLK_IS_A)
    ce_eq("x multi-word", sq_is_a_x(q), "the sun")
    ce_eq("y multi-word", sq_is_a_y(q), "g type star")
}

// ---- who / when / where --------------------------------------------------

fn test_who_is() {
    let q = grammar_parse("who is einstein")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "einstein")
    ce_eq("filter person", sq_research_kind_filter(q), "person")
}

fn test_when_did_x() {
    let q = grammar_parse("when did world war 2 happen")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "world war 2 happen")
    ce_eq("filter event", sq_research_kind_filter(q), "event")
}

fn test_where_is() {
    let q = grammar_parse("where is amritsar")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "amritsar")
    ce_eq("filter place", sq_research_kind_filter(q), "place")
}

// ---- why fallback --------------------------------------------------------

fn test_why_fallback() {
    let q = grammar_parse("why gravity")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic", sq_research_topic(q), "gravity")
    ce_eq("parser grammar", sq_parser_used(q), "grammar")
}

// ---- retract -------------------------------------------------------------

fn test_retract_simple() {
    let q = grammar_parse("retract old_claim")
    ce_eq("kind RETRACT", sq_kind(q), NLK_RETRACT)
    ce_eq("label", sq_retract_label(q), "old_claim")
}

// ---- install capsule / skill ---------------------------------------------

fn test_install_capsule() {
    let q = grammar_parse("install capsule medicine")
    ce_eq("kind CAP_INSTALL", sq_kind(q), NLK_CAPSULE_INSTALL)
    ce_eq("name", sq_capsule_install_name(q), "medicine")
}

fn test_install_skill() {
    let q = grammar_parse("install skill coding_helper")
    ce_eq("kind SK_INSTALL", sq_kind(q), NLK_SKILL_INSTALL)
    ce_eq("name", sq_skill_install_name(q), "coding_helper")
}

fn test_install_missing_kind_unparsed() {
    let q = grammar_parse("install foo")   // no "capsule"/"skill" keyword
    ce_eq("no keyword -> UNPARSED", sq_kind(q), NLK_UNPARSED)
}

// ---- list ----------------------------------------------------------------

fn test_list_capsules() {
    let q = grammar_parse("list capsules")
    ce_eq("kind CAP_LIST", sq_kind(q), NLK_CAPSULE_LIST)
}

fn test_list_skills_plural_or_singular() {
    let q1 = grammar_parse("list skills")
    ce_eq("plural sk list", sq_kind(q1), NLK_SKILL_LIST)
    let q2 = grammar_parse("list skill")
    ce_eq("singular sk list", sq_kind(q2), NLK_SKILL_LIST)
}

// ---- run skill X on Y ----------------------------------------------------

fn test_run_skill_on() {
    let q = grammar_parse("run skill research on the sun")
    ce_eq("kind SKILL_RUN", sq_kind(q), NLK_SKILL_RUN)
    ce_eq("skill", sq_skill_run_skill(q), "research")
    ce_eq("arg", sq_skill_run_arg(q), "the sun")
}

fn test_run_x_on_y_without_skill_keyword() {
    let q = grammar_parse("run echo on moon")
    ce_eq("kind SKILL_RUN", sq_kind(q), NLK_SKILL_RUN)
    ce_eq("skill", sq_skill_run_skill(q), "echo")
    ce_eq("arg", sq_skill_run_arg(q), "moon")
}

fn test_run_missing_on_unparsed() {
    let q = grammar_parse("run echo query")
    ce_eq("no 'on' -> UNPARSED", sq_kind(q), NLK_UNPARSED)
}

// ---- priority order (more-specific patterns beat looser ones) ------------

fn test_what_do_you_know_beats_what_is() {
    // "what do you know about X" must match BEFORE the looser "what X ..."
    // shape (which would eat "do" as topic).
    let q = grammar_parse("what do you know about photosynthesis")
    ce_eq("still RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("topic clean (not 'do you know about photosynthesis')",
          sq_research_topic(q), "photosynthesis")
}

fn test_tell_me_about_beats_what() {
    let q = grammar_parse("tell me about mitochondria")
    ce_eq("topic", sq_research_topic(q), "mitochondria")
}

// ---- all constructed queries validate ok --------------------------------

// ==========================================================================
// R97 GRAMMAR EXPANSION -- 40+ new patterns across all 11 SQ kinds.
// Each block asserts that a new natural phrasing maps to the SAME sq_*
// kind + arg layout the R48p2 core already recognizes. No new SQ kinds.
// ==========================================================================

// ---- R97 preamble stripping ----------------------------------------------

fn test_preamble_please_leading() {
    // "please tell me about X" parses the same as "tell me about X"
    let q = grammar_parse("please tell me about photosynthesis")
    ce_eq("please tell -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic clean", sq_research_topic(q), "photosynthesis")
}

fn test_preamble_can_you() {
    let q = grammar_parse("can you tell me about photosynthesis")
    ce_eq("can you tell -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic clean", sq_research_topic(q), "photosynthesis")
}

fn test_preamble_could_you_please() {
    // Loop-strip: "could you" then "please"
    let q = grammar_parse("could you please tell me about mars")
    ce_eq("nested preamble -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mars")
}

fn test_preamble_would_you() {
    let q = grammar_parse("would you explain mars")
    ce_eq("would you explain -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mars")
}

fn test_preamble_will_you() {
    let q = grammar_parse("will you list capsules")
    ce_eq("will you list -> CAP_LIST", sq_kind(q), NLK_CAPSULE_LIST)
}

fn test_preamble_may_i_ask() {
    let q = grammar_parse("may i ask what is einstein")
    ce_eq("may i ask -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "einstein")
}

fn test_preamble_i_want_to_know_about() {
    let q = grammar_parse("i want to know about mitochondria")
    ce_eq("i want to know about -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mitochondria")
}

fn test_preamble_i_would_like_to() {
    let q = grammar_parse("i would like to know about mars")
    ce_eq("i would like to know about -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mars")
}

fn test_preamble_id_like_to() {
    // "i'd like to" -> tokens i, d, like, to (apostrophe strips)
    let q = grammar_parse("i'd like to know about mars")
    ce_eq("i'd like to -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mars")
}

fn test_preamble_hey() {
    let q = grammar_parse("hey what is einstein")
    ce_eq("hey what is -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "einstein")
}

fn test_preamble_hi_there() {
    let q = grammar_parse("hi there tell me about mars")
    ce_eq("hi there tell me -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mars")
}

fn test_preamble_trailing_please() {
    let q = grammar_parse("tell me about mars please")
    ce_eq("trailing please -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "mars")
}

fn test_preamble_trailing_thanks() {
    let q = grammar_parse("what is einstein thanks")
    ce_eq("trailing thanks -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "einstein")
}

fn test_preamble_trailing_thank_you() {
    let q = grammar_parse("what is einstein thank you")
    ce_eq("trailing thank you -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "einstein")
}

fn test_preamble_both_ends() {
    let q = grammar_parse("please tell me about einstein thanks")
    ce_eq("both ends -> RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_str_eq("topic", sq_research_topic(q), "einstein")
}

// ---- R97 filler / greeting -> NONE ---------------------------------------

fn test_filler_hi_returns_none() {
    let q = grammar_parse("hi")
    ce_eq("hi -> NONE", sq_kind(q), NLK_NONE)
}

fn test_filler_hello_returns_none() {
    let q = grammar_parse("hello")
    ce_eq("hello -> NONE", sq_kind(q), NLK_NONE)
}

fn test_filler_hmm_returns_none() {
    let q = grammar_parse("hmm")
    ce_eq("hmm -> NONE", sq_kind(q), NLK_NONE)
}

fn test_filler_multi_returns_none() {
    let q = grammar_parse("um uh hmm")
    ce_eq("um uh hmm -> NONE", sq_kind(q), NLK_NONE)
    let q2 = grammar_parse("hi there hello")
    ce_eq("hi there hello -> NONE", sq_kind(q2), NLK_NONE)
}

fn test_punctuation_only_returns_none() {
    let q1 = grammar_parse("?")
    ce_eq("? -> NONE", sq_kind(q1), NLK_NONE)
    let q2 = grammar_parse("!")
    ce_eq("! -> NONE", sq_kind(q2), NLK_NONE)
    let q3 = grammar_parse("...")
    ce_eq("... -> NONE", sq_kind(q3), NLK_NONE)
    let q4 = grammar_parse(".")
    ce_eq(". -> NONE", sq_kind(q4), NLK_NONE)
}

