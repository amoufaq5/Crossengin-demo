// Unit tests for snapshot v1 -> v2 migration.
//
// Exercises:
//   - snap_migrate_v1_to_v2: invariants, recovery defaults
//   - snap_from_text on a hand-built v1 file: parses, migrates, populates meta
//   - snap_to_text on the migrated snapshot: round-trips with meta lines
//   - re-load of the v2 file: meta survives
//   - snap_parse on a v1 framed value: migrates in-place
//   - guard against v3+ wire format (rejected)
//
// ADRs: ADR-0048 (persistence container + format), SNAPSHOT_FORMAT.md
// (versioning policy + migration table).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"
import "../../src/persistence/snapshot_reader.nova"

// Build a synthetic v1 snapshot wire text. The shape mirrors what a real v1
// writer would have produced: header banner + tag + ver=1 + sections=5 +
// each section's `present` flag (we keep them all 0 here for a minimal
// fixture; the full-blob round-trip is covered by test_snapshot_disk.nova).
fn _build_v1_text() {
    let lines = list_new()
    push(lines, "crossengin-snapshot v1\n")
    push(lines, "tag 5361\n")          // SNAP_TAG
    push(lines, "ver 1\n")             // v1 -- the load-bearing field
    push(lines, "instance 42\n")
    push(lines, "timestamp 99\n")
    push(lines, "sections 5\n")
    push(lines, "soul.present 1\n")
    push(lines, "soul.name TestSoul\n")
    push(lines, "soul.constcount 0\n")
    push(lines, "kgs.present 0\n")
    push(lines, "episodic.present 0\n")
    push(lines, "synapses.present 0\n")
    push(lines, "selfmodel.present 0\n")
    push(lines, "end\n")
    return join(lines, "")
}

// Same but version 3 -- a forward-compat shape this build cannot understand.
fn _build_v3_text() {
    let lines = list_new()
    push(lines, "crossengin-snapshot v1\n")
    push(lines, "tag 5361\n")
    push(lines, "ver 3\n")
    push(lines, "instance 42\n")
    push(lines, "timestamp 99\n")
    push(lines, "sections 5\n")
    push(lines, "soul.present 0\n")
    push(lines, "kgs.present 0\n")
    push(lines, "episodic.present 0\n")
    push(lines, "synapses.present 0\n")
    push(lines, "selfmodel.present 0\n")
    push(lines, "end\n")
    return join(lines, "")
}

fn test_migrate_helper_invariants() {
    // A freshly-built v2 snapshot is rejected by the migration helper (it
    // expects v1 on the input slot).
    let s2 = snap_new(1, 0)
    ce_eq("migrate rejects v2", snap_migrate_v1_to_v2(s2), 0)

    // A v1 snapshot (faked: ver slot set to 1) migrates successfully and
    // the version slot lands at 2.
    let s = snap_new(7, 100)
    list_set(s, SNAP_VER, 1)
    ce_eq("migrate accepts v1", snap_migrate_v1_to_v2(s), 1)
    ce_eq("version post-migrate is 2", snap_version(s), 2)

    // Meta block is populated with the v1-recovery defaults.
    ce_eq("meta present after migrate", snap_has_meta(s), 1)
    ce_str_eq("creator is unknown/<v1>",
        snap_meta_creator(s), SNAP_META_CREATOR_DEFAULT_V1)
    ce_eq("created_ns is 0",
        snap_meta_created_ns(s), 0)
    ce_eq("compaction_threshold is -1",
        snap_meta_compaction_threshold(s), SNAP_META_COMPACT_TH_UNKNOWN)
    ce_str_eq("encryption is none",
        snap_meta_encryption(s), SNAP_META_ENCRYPTION_NONE)
}

fn test_parse_v1_text_migrates() {
    let text = _build_v1_text()
    let s = snap_from_text(text)
    ce_check("v1 file parses", s != 0)
    ce_eq("post-migration version is 2", snap_version(s), 2)
    ce_eq("snap_valid passes after migration", snap_valid(s), 1)
    // Instance + timestamp survive.
    ce_eq("instance survives", snap_instance(s), 42)
    ce_eq("timestamp survives", snap_timestamp(s), 99)
    // Soul section made it across.
    ce_eq("soul section present", snap_has_section(s, SEC_SOUL), 1)
    ce_str_eq("soul name survives", snap_section(s, SEC_SOUL)[0], "TestSoul")
    // Meta block has v1 recovery defaults.
    ce_str_eq("migrated creator", snap_meta_creator(s), SNAP_META_CREATOR_DEFAULT_V1)
    ce_eq("migrated created_ns is 0", snap_meta_created_ns(s), 0)
    ce_eq("migrated compaction_threshold is -1",
        snap_meta_compaction_threshold(s), SNAP_META_COMPACT_TH_UNKNOWN)
    ce_str_eq("migrated encryption", snap_meta_encryption(s),
        SNAP_META_ENCRYPTION_NONE)
}

fn test_save_v2_meta_roundtrip() {
    // Build a fresh v2 snapshot, stamp meta with non-default values, save +
    // reload, and verify the meta survives the text round-trip.
    let s = snap_new(11, 22)
    snap_meta_set_creator(s, "crossengin/0.1.0")
    snap_meta_set_created_ns(s, 1700000000000000000)
    snap_meta_set_compaction_threshold(s, 4096)
    snap_meta_set_encryption(s, SNAP_META_ENCRYPTION_NONE)

    let text = snap_to_text(s)
    ce_check("v2 text non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("v2 file re-parses", s2 != 0)
    ce_eq("v2 version preserved", snap_version(s2), 2)
    ce_str_eq("creator round-trips", snap_meta_creator(s2), "crossengin/0.1.0")
    ce_eq("created_ns round-trips", snap_meta_created_ns(s2), 1700000000000000000)
    ce_eq("compaction_threshold round-trips", snap_meta_compaction_threshold(s2), 4096)
    ce_str_eq("encryption round-trips", snap_meta_encryption(s2),
        SNAP_META_ENCRYPTION_NONE)
}

fn test_migrated_snap_resaves_as_v2() {
    // Parse a v1 file, save it (now as v2), reload, check it's clean v2.
    let v1_text = _build_v1_text()
    let s = snap_from_text(v1_text)
    ce_check("v1 -> v2 migration succeeded", s != 0)

    // Re-emit as text -- now bears v2 shape including meta lines.
    let v2_text = snap_to_text(s)
    ce_check("v2 text contains 'ver 2' line", len(v2_text) > 0)

    // Reload and confirm.
    let s2 = snap_from_text(v2_text)
    ce_check("re-parsed", s2 != 0)
    ce_eq("re-parsed version is 2", snap_version(s2), 2)
    ce_str_eq("creator survived re-save",
        snap_meta_creator(s2), SNAP_META_CREATOR_DEFAULT_V1)
}

fn test_v3_rejected() {
    // A wire-format newer than this build supports must be rejected loudly.
    let text = _build_v3_text()
    let s = snap_from_text(text)
    ce_eq("v3 file rejected", s, 0)
}

fn test_snap_parse_framed_v1() {
    // snap_parse (the in-memory framed-value parser) should also dispatch
    // on version and migrate v1 -> v2 in-place.
    let s = snap_new(5, 200)
    list_set(s, SNAP_VER, 1)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let ser = snap_serialize(s)
    // ser[1] is now 1 since list_set wrote 1 into the version slot and
    // snap_serialize reads it back via snap_version.
    ce_eq("framed value declares v1", ser[1], 1)
    let restored = snap_parse(ser)
    ce_check("v1 framed value parses", restored != 0)
    ce_eq("framed migration lands at v2", snap_version(restored), 2)
    ce_eq("framed migration installs meta",
        snap_has_meta(restored), 1)
    ce_str_eq("framed migration creator default",
        snap_meta_creator(restored), SNAP_META_CREATOR_DEFAULT_V1)
}

fn main() {
    test_migrate_helper_invariants()
    test_parse_v1_text_migrates()
    test_save_v2_meta_roundtrip()
    test_migrated_snap_resaves_as_v2()
    test_v3_rejected()
    test_snap_parse_framed_v1()
    ce_summary("snapshot_migrate")
}
main()
