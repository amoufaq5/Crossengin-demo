// End-to-end test: ingest the real data/packs/solar_system.cerec pack and
// the data/packs/folk_astronomy.cerec pack via the ingestion agent, then
// verify the multi_kg_consistency scan surfaces the intentional
// disagreements. This is the R44 "author a real domain pack" demonstration
// exercised in test form so a future migration cannot silently regress
// the cross-source conflict story.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn test_solar_system_pack_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec",
        "data/packs/solar_system.cerec",
        "astronomy",
        "src:pack:solar_system:v1",
        "", 0)
    ce_eq("1 record ingested", ing_sum_ok(s), 1)
    ce_eq("0 queued (trusted src:pack:)", ing_sum_queued(s), 0)
    ce_eq("0 dropped", ing_sum_dropped(s), 0)
    ce_eq("33 atoms added", ing_sum_atoms(s), 33)
    ce_eq("0 parse errors", ing_sum_errors(s), 0)
}

fn test_folk_pack_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec",
        "data/packs/folk_astronomy.cerec",
        "folk_astronomy",
        "src:pack:folk_astronomy:v1",
        "", 0)
    ce_eq("1 record", ing_sum_ok(s), 1)
    ce_eq("0 queued", ing_sum_queued(s), 0)
    ce_eq("5 atoms added", ing_sum_atoms(s), 5)
}

fn test_cross_pack_conflicts_surface() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/solar_system.cerec",
                  "astronomy", "src:pack:solar_system:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/folk_astronomy.cerec",
                  "folk_astronomy", "src:pack:folk_astronomy:v1", "", 0)
    // spread >= 200 catches the three engineered disagreements
    // (planet, sun, earth) but not marginal drift.
    let conflicts = mkgc_scan_conflicts(ing_kgreg(a), 200)
    ce_check("at least 3 conflicts", len(conflicts) >= 3)
    // Verify all three headline labels appear in the report.
    let saw_planet = 0
    let saw_sun = 0
    let saw_earth = 0
    let i = 0
    while i < len(conflicts) {
        let c = conflicts[i]
        let lab = mkgc_conflict_label(c)
        if str_eq_bytes(lab, "planet") == 1 { saw_planet = 1 }
        if str_eq_bytes(lab, "sun")    == 1 { saw_sun = 1 }
        if str_eq_bytes(lab, "earth")  == 1 { saw_earth = 1 }
        i = i + 1
    }
    ce_eq("planet conflict surfaced", saw_planet, 1)
    ce_eq("sun conflict surfaced", saw_sun, 1)
    ce_eq("earth conflict surfaced", saw_earth, 1)
}

fn test_source_attribution_is_uniform() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/solar_system.cerec",
                  "astronomy", "src:pack:solar_system:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/folk_astronomy.cerec",
                  "folk_astronomy", "src:pack:folk_astronomy:v1", "", 0)
    let report = mo_report(ing_mo(a))
    let saw_solar = 0
    let saw_folk = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:solar_system:v1") == 1 { saw_solar = 1 }
        if str_eq_bytes(report[i][0], "src:pack:folk_astronomy:v1") == 1 { saw_folk = 1 }
        i = i + 1
    }
    ce_eq("solar pack tag attributed", saw_solar, 1)
    ce_eq("folk pack tag attributed", saw_folk, 1)
}

fn test_reingest_is_idempotent() {
    let a = ing_agent_new()
    let s1 = ing_agent_run(a, "cerec", "data/packs/solar_system.cerec",
                           "astronomy", "src:pack:solar_system:v1", "", 0)
    let s2 = ing_agent_run(a, "cerec", "data/packs/solar_system.cerec",
                           "astronomy", "src:pack:solar_system:v1", "", 0)
    ce_eq("first pass added 33", ing_sum_atoms(s1), 33)
    // Re-ingest: same labels, no atoms added second time.
    ce_eq("second pass adds 0 atoms", ing_sum_atoms(s2), 0)
}

fn main() {
    test_solar_system_pack_ingests_cleanly()
    test_folk_pack_ingests_cleanly()
    test_cross_pack_conflicts_surface()
    test_source_attribution_is_uniform()
    test_reingest_is_idempotent()
    ce_summary("pack_solar_system")
}

main()
