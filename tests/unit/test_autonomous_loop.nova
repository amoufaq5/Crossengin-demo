// Unit tests for src/agent/autonomous_loop.nova -- the capstone (ADR-0057).
//
// One cycle runs all five roadmap phases together; over a run the test asserts
// each phase had effect and the whole thing stays safe:
//   - P5: the agent improves its task return across cycles and its greedy policy
//     reaches the optimal path -- learned only from its own logged experience;
//   - P2: the task-value synapse strengthens under reward (three-factor);
//   - P4: gated, competence-selected tool plans run and emit moments;
//   - P1+P3: repeated observations resolve to the same atoms (no fragmentation);
//   - safety: self-edits are bounded -- accepted+audited only when approved,
//     suspended (minting nothing) when not -- and the audit chain verifies.
//
// ADR-0057 (composing ADR-0051..0055).

import "../ce_test.nova"
import "../../src/agent/autonomous_loop.nova"

fn test_unified_cycle_learns_and_is_safe() {
    let a = agent_new(12345)
    // 30 cycles; self-edits approved; reflect every 10 cycles.
    let m = agent_run(a, 30, 1, 10)

    // P5 -- the agent improved at its task from its own experience.
    ce_check("task return improved across cycles",
             agent_metric_last_return(m) > agent_metric_first_return(m))
    ce_check("untrained first cycle did not reach the goal",
             agent_metric_first_return(m) < 0)
    ce_eq("learned policy reaches the goal optimally",
          agent_metric_eval_steps(m), agent_metric_optimal(m))
    ce_check("learned greedy return near optimum", agent_metric_eval_return(m) >= 90)

    // P2 -- the reward drove substrate three-factor plasticity.
    ce_check("task-value synapse strengthened under reward",
             agent_metric_value_weight(m) > 0)

    // P4 -- tools acted every cycle and emitted moments (30 cycles x 3 steps).
    ce_eq("a moment per tool step over the run", agent_metric_moments(m), 90)

    // P1+P3 -- ingestion resolved repeated observations to the same atoms.
    ce_check("ingestion produced atoms", agent_metric_kg_atoms(m) >= 1)
    ce_check("repeated observations did NOT fragment the KG",
             agent_metric_kg_atoms(m) <= 5)

    // ADR-0081 -- the memory-lifecycle machinery is wired into the live tick:
    // the agent owns an episodic store, and the episodic-aware GC sweep ran
    // (every AG_GC_EVERY cycles) WITHOUT fragmenting the KG. The <=5 bound above
    // is the proof the two cohere: re-observation reinforces atoms so live GC
    // never reclaims an alias-referenced (re-minted-on-loss) entity.
    ce_check("agent owns an episodic store (GC wiring live)", agent_eas(a) != 0)
    // ADR-0082 -- the recurring per-cycle observation is now fed into
    // consolidation (via AG_OBS_STREAM), so episodic clusters actually mint:
    // the store is no longer dormant.
    ce_check("consolidation minted >=1 episodic cluster",
             episodic_atoms_count(agent_eas(a)) >= 1)

    // safety -- bounded self-edits, audited.
    ce_eq("three approved self-edits over 30 cycles", agent_metric_edits(m), 3)
    ce_eq("audit chain verifies (tamper-evident)", agent_metric_audit_ok(m), 1)

    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

// The constitutional gate bounds the loop: with approval withheld, the
// ACT_SELF_MODIFY reflections SUSPEND and mint nothing -- the agent still learns
// its task, but cannot change itself without sanction.
fn test_self_edits_bounded_without_approval() {
    let a = agent_new(999)
    let m = agent_run(a, 20, 0, 5)   // approved = 0
    ce_eq("no self-edit accepted without approval", agent_metric_edits(m), 0)
    ce_check("agent still learned the task", agent_metric_eval_return(m) >= 90)
    ce_eq("audit chain still verifies", agent_metric_audit_ok(m), 1)
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

fn main() {
    test_unified_cycle_learns_and_is_safe()
    test_self_edits_bounded_without_approval()
    ce_summary("autonomous_loop")
}

main()
