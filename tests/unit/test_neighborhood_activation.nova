// Unit tests for src/reader/neighborhood.nova and its integration with
// src/reader/spreading_activation.nova.
//
// Phase 14 / Tier 2 #2: structural-neighborhood activation. The reader gains a
// substrate-native similarity surface mined from operator edges (ADR-0031),
// cross-KG xref edges (ADR-0017), and word-sense co-occurrence (ADR-0015) so
// indirectly-related concepts activate when the direct lookup misses or partly
// misses. No embeddings, no transformer; pure substrate signals.
//
// P2.1 + P2.2 (this pass): two more similarity sources --
//   - co-fire (from moment_stream): two atoms that recurrently fire in the
//     SAME moment surface as neighbors via the cofire side-index.
//   - syntactic-slot sharing (from output generation): two atoms that have
//     co-filled the same role in the same syntax pattern surface as
//     role-neighbors via the slot side-index.
// find_neighbors_full(kg_reg, source, ci, si, max_hops, max_results) adds
// these as ADDITIVE evidence on top of the P14 baseline sources; the 3-arg
// find_neighbors stays as a wrapper that disables the side-indices (so all
// pre-P2.1/P2.2 tests keep their exact strengths and orderings).

import "../ce_test.nova"
import "../../src/reader/context_bias.nova"
import "../../src/reader/neighborhood.nova"
import "../../src/reader/spreading_activation.nova"

// ---- helpers ---------------------------------------------------------------
// Build a small medical KG with concept atoms fever, infection, treat, headache.
// Wire it with:
//   - operator edges: fever -> infection -> treat, fever -> headache (causal).
//   - cross-KG xref edges: fever <-> infection (weight 800), infection <-> treat
//     (weight 700) so the seed-style spreading still flows.
// Adds word atoms for "fever", "infection", "treat", "headache" each pointing
// to the matching concept; plus the paraphrase word "temperature" pointing to
// fever (word-sense co-finding) so we can demonstrate polysemy / paraphrase.
fn build_med() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")

    let fever     = kg_add_atom(med, ATOM_CONCEPT, "fever", 0)
    let infection = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    let treat     = kg_add_atom(med, ATOM_CONCEPT, "treat", 0)
    let headache  = kg_add_atom(med, ATOM_CONCEPT, "headache", 0)

    // Operator atoms (reasoning_atoms): fever -> infection -> treat, fever ->
    // headache. These live in the same KG by convention (per seed/first_atoms).
    rop_new(med, ROP_CAUSAL, atom_id(fever),     atom_id(infection), "fever->infection", 0)
    rop_new(med, ROP_CAUSAL, atom_id(infection), atom_id(treat),     "infection->treat", 0)
    rop_new(med, ROP_CAUSAL, atom_id(fever),     atom_id(headache),  "fever->headache", 0)

    // Cross-KG xref edges (bidirectional, like seed/first_atoms _add_xref).
    atom_add_xref(fever,     xref_new(fever,     infection, XREF_CAUSAL, 800, 1))
    atom_add_xref(infection, xref_new(infection, fever,     XREF_CAUSAL, 800, 1))
    atom_add_xref(infection, xref_new(infection, treat,     XREF_CAUSAL, 700, 1))
    atom_add_xref(treat,     xref_new(treat,     infection, XREF_CAUSAL, 700, 1))

    // Word atoms anchoring the language KG. "temperature" is the paraphrase
    // word: it points to fever too, so a reader receiving "temperature"
    // exact-anchors to that word but also surfaces fever's neighborhood.
    let w_fever     = word_atom_new(lang, "fever", 0)
    let w_infection = word_atom_new(lang, "infection", 0)
    let w_treat     = word_atom_new(lang, "treat", 0)
    let w_headache  = word_atom_new(lang, "headache", 0)
    let w_temp      = word_atom_new(lang, "temperature", 0)
    word_add_sense(w_fever,     fever,     900)
    word_add_sense(w_infection, infection, 900)
    word_add_sense(w_treat,     treat,     900)
    word_add_sense(w_headache,  headache,  900)
    word_add_sense(w_temp,      fever,     800)

    let e = renv_new(reg, lang, 0, 0, 0)
    return e
}

fn _kg_id_of(e, label) {
    let kg = kg_find(renv_kgreg(e), label)
    return kg
}

// ---- test 1: find_neighbors(fever, 2, 5) surfaces infection + treat -------
fn test_find_neighbors_basic() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let fever_id     = atom_id(kg_find_atom(med, "fever"))
    let infection_id = atom_id(kg_find_atom(med, "infection"))
    let treat_id     = atom_id(kg_find_atom(med, "treat"))
    let headache_id  = atom_id(kg_find_atom(med, "headache"))

    let h_fever     = handle_new("med", fever_id)
    let h_infection = handle_new("med", infection_id)
    let h_treat     = handle_new("med", treat_id)
    let h_headache  = handle_new("med", headache_id)

    let nbrs = find_neighbors(renv_kgreg(e), h_fever, 2, 5)
    ce_check("find_neighbors returns >0 entries", len(nbrs) > 0)
    ce_check("seed itself NOT in neighbors", neighbor_strength(nbrs, h_fever) == 0)

    // Infection is reachable via BOTH an operator edge (fever->infection) AND
    // the cross-KG xref (weight 800). Aggregation should easily clear 500 milli.
    let s_inf = neighbor_strength(nbrs, h_infection)
    ce_check("infection is a one-hop neighbor", s_inf > 0)
    ce_check("infection one-hop is strong (>=500)", s_inf >= 500)

    // Headache reachable only via the fever->headache operator at one hop.
    let s_hd = neighbor_strength(nbrs, h_headache)
    ce_check("headache is a one-hop neighbor", s_hd > 0)

    // Treat is two-hop (fever->infection->treat both via operator and xref).
    // Two-hop is decayed by NEIGH_HOP_DECAY (500); the xref weight is 700;
    // contribution is in 0..1000 after fp_mul.
    let s_tr = neighbor_strength(nbrs, h_treat)
    ce_check("treat is a (two-hop) neighbor", s_tr > 0)

    // One-hop wins: infection should be >= treat in strength.
    ce_check("one-hop infection >= two-hop treat strength", s_inf >= s_tr)
}

// ---- test 2: result is sorted descending by strength ----------------------
fn test_find_neighbors_sorted() {
    let e = build_med()
    let h_fever = handle_new("med", atom_id(kg_find_atom(kg_find(renv_kgreg(e), "med"), "fever")))
    let nbrs = find_neighbors(renv_kgreg(e), h_fever, 2, 8)
    let n = len(nbrs)
    ce_check("got at least two neighbors", n >= 2)
    let i = 1
    let monotone = 1
    while i < n {
        if nbrs[i][1] > nbrs[i-1][1] { monotone = 0 }
        i = i + 1
    }
    ce_eq("neighbors sorted descending by strength", monotone, 1)
}

// ---- test 3: max_results caps the output length ----------------------------
fn test_find_neighbors_max_results() {
    let e = build_med()
    let h_fever = handle_new("med", atom_id(kg_find_atom(kg_find(renv_kgreg(e), "med"), "fever")))
    let n2 = len(find_neighbors(renv_kgreg(e), h_fever, 2, 2))
    let n8 = len(find_neighbors(renv_kgreg(e), h_fever, 2, 8))
    ce_check("max_results=2 caps output", n2 <= 2)
    ce_check("max_results=8 returns >=max_results=2", n8 >= n2)
}

// ---- test 4: max_hops=1 omits two-hop neighbors ----------------------------
fn test_find_neighbors_max_hops() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fever = handle_new("med", atom_id(kg_find_atom(med, "fever")))
    let h_treat = handle_new("med", atom_id(kg_find_atom(med, "treat")))

    let one_hop = find_neighbors(renv_kgreg(e), h_fever, 1, 16)
    let two_hop = find_neighbors(renv_kgreg(e), h_fever, 2, 16)
    let s1 = neighbor_strength(one_hop, h_treat)
    let s2 = neighbor_strength(two_hop, h_treat)
    ce_eq("treat NOT in 1-hop result", s1, 0)
    ce_check("treat present in 2-hop result", s2 > 0)
}

// ---- test 5: spreading_activation round-trip on "fever" -------------------
// Verifies the integration: an exact-match input activates both the seed (via
// classic SPREAD_SEED) AND the structural-neighborhood concepts (via the new
// find_neighbors seeding). The original test_spreading_activation still passes
// with updated expectations; here we verify the FULL chain reaches treat.
fn test_round_trip_includes_neighbors() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fever     = handle_new("med", atom_id(kg_find_atom(med, "fever")))
    let h_infection = handle_new("med", atom_id(kg_find_atom(med, "infection")))
    let h_treat     = handle_new("med", atom_id(kg_find_atom(med, "treat")))

    let c = rctx_new("fever")
    reader_anchor(e, c)
    reader_bias(e, c, list_new())
    let active = reader_spread(e, c)

    ce_check("active set populated", active > 0)
    ce_check("fever seed fully active", reader_activation(c, h_fever) >= SPREAD_SEED)
    ce_check("infection activated", reader_activation(c, h_infection) >= SPREAD_THRESHOLD)
    ce_check("treat activated via neighborhood", reader_activation(c, h_treat) >= SPREAD_THRESHOLD)
    ce_eq("fever settled active", reader_is_active(c, h_fever), 1)
    ce_eq("infection settled active", reader_is_active(c, h_infection), 1)
    ce_eq("treat settled active", reader_is_active(c, h_treat), 1)
}

// ---- test 6: cross-KG case -- same concept name in two KGs ----------------
// Build two KGs (med + bio); link bio::fever <-> med::fever via cross-KG xref.
// find_neighbors on med::fever must surface bio::fever as a neighbor.
fn test_cross_kg_link() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "med")
    let bio = kg_spawn(reg, "bio")
    let m_fever = kg_add_atom(med, ATOM_CONCEPT, "fever", 0)
    let b_fever = kg_add_atom(bio, ATOM_CONCEPT, "fever", 0)
    atom_add_xref(m_fever, xref_new(m_fever, b_fever, XREF_SIMILAR, 900, 1))
    atom_add_xref(b_fever, xref_new(b_fever, m_fever, XREF_SIMILAR, 900, 1))

    let h_m = handle_new("med", atom_id(m_fever))
    let h_b = handle_new("bio", atom_id(b_fever))
    let nbrs = find_neighbors(reg, h_m, 1, 4)
    ce_check("cross-KG result not empty", len(nbrs) > 0)
    let s = neighbor_strength(nbrs, h_b)
    ce_check("bio::fever surfaced via cross-KG xref", s > 0)
    ce_check("cross-KG strength is strong (>=900*FP)", s >= 900)
}

// ---- test 7: lexical fallback surfaces concepts for unmatched tokens -----
// "temperature" is a known word pointing at fever; an unmatched paraphrase that
// shares chars with it (e.g. "temperatur") should surface fever via the
// substring-similar word's sense list.
fn test_lexical_fallback() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fever = handle_new("med", atom_id(kg_find_atom(med, "fever")))

    // "temperatur" is NOT in the language KG, but it shares almost every char
    // with "temperature" (which is). Word similarity over the lexical facet
    // vector clears the 300 threshold.
    let cands = lexical_fallback_candidates(renv_kgreg(e), renv_lang(e), "temperatur", 4)
    ce_check("lexical fallback returns candidates", len(cands) > 0)
    let s = neighbor_strength(cands, h_fever)
    ce_check("fever surfaced via 'temperature' word sense", s > 0)
}

// ---- test 8: round-trip with an unmatched paraphrase token -----------------
// Reader receives "temperatur" (unknown). Lexical anchor sets curiosity; the
// spreading_activation lexical-fallback path then seeds activation on fever's
// concept via the known word "temperature"'s sense, AND find_neighbors expands
// that seed to its operator/xref neighbors (infection).
fn test_round_trip_paraphrase() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fever     = handle_new("med", atom_id(kg_find_atom(med, "fever")))
    let h_infection = handle_new("med", atom_id(kg_find_atom(med, "infection")))

    let c = rctx_new("temperatur")
    reader_anchor(e, c)
    reader_bias(e, c, list_new())
    reader_spread(e, c)

    ce_check("paraphrase activates fever", reader_activation(c, h_fever) > 0)
    ce_check("paraphrase activates infection (neighborhood-spread)", reader_activation(c, h_infection) > 0)
}

// ---- test 9: exact match still wins over neighborhood ---------------------
// On exact-match input "fever", the seed gets full SPREAD_SEED (1000); any
// neighbor it surfaces should have strictly lower activation in the result.
fn test_exact_match_wins() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fever     = handle_new("med", atom_id(kg_find_atom(med, "fever")))
    let h_infection = handle_new("med", atom_id(kg_find_atom(med, "infection")))

    let c = rctx_new("fever")
    reader_anchor(e, c)
    reader_bias(e, c, list_new())
    reader_spread(e, c)
    let a_seed     = reader_activation(c, h_fever)
    let a_neighbor = reader_activation(c, h_infection)
    ce_check("seed strictly dominates a one-hop neighbor", a_seed >= a_neighbor)
}

// ---- test 10: word-sense co-finder surfaces other senses of a polyseme ----
// Both "fever" and "temperature" point at the med::fever concept. find_neighbors
// on med::fever should NOT include med::fever itself, and should not double-
// count when both words share a sense to it. (Smoke test for the word-sense
// pass.)
fn test_word_sense_dedup() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fever = handle_new("med", atom_id(kg_find_atom(med, "fever")))
    let nbrs = find_neighbors(renv_kgreg(e), h_fever, 2, 16)
    // No self-entry.
    let i = 0
    let self_count = 0
    while i < len(nbrs) {
        if handle_eq(nbrs[i][0], h_fever) == 1 { self_count = self_count + 1 }
        i = i + 1
    }
    ce_eq("seed handle never appears in neighbors", self_count, 0)
    // All strengths are within milli range.
    let j = 0
    let all_in_range = 1
    while j < len(nbrs) {
        if nbrs[j][1] < 0 { all_in_range = 0 }
        if nbrs[j][1] > 1000 { all_in_range = 0 }
        j = j + 1
    }
    ce_eq("all strengths in 0..1000", all_in_range, 1)
}

// ---- test 11: cofire-only neighbors (P2.1) --------------------------------
// Build TWO atoms A and B that have NO operator edge, NO cross-KG xref, and
// NO word linking them at the lexical level. Then record a moment-stream
// history in which they ALWAYS appear together. find_neighbors_full(A) must
// surface B at high cofire strength even though the P14 sources find
// nothing -- exactly the gap P2.1 was meant to close.
fn test_find_neighbors_full_cofire_only() {
    let reg = kg_registry_new()
    let world = kg_spawn(reg, "world")
    let a = kg_add_atom(world, ATOM_CONCEPT, "alpha", 0)
    let b = kg_add_atom(world, ATOM_CONCEPT, "beta", 0)
    let c = kg_add_atom(world, ATOM_CONCEPT, "gamma", 0)
    // NO xrefs between any of them; no operator atoms; no word atoms.
    let h_a = handle_new("world", atom_id(a))
    let h_b = handle_new("world", atom_id(b))
    let h_c = handle_new("world", atom_id(c))

    // First check the legacy (3-arg) find_neighbors finds NOTHING -- proves
    // the cofire-only path is the ONLY way B can surface here.
    let bare = find_neighbors(reg, h_a, 2, 5)
    ce_eq("baseline P14: zero neighbors of alpha", len(bare), 0)

    // Build a cofire index where (alpha, beta) co-fire in 10 moments and
    // (alpha, gamma) only in 2 -- so beta is alpha's strongest cofire
    // neighbor by a wide margin.
    let ci = ci_new()
    let trace_ab = list_new()
    push(trace_ab, atom_id(a))
    push(trace_ab, atom_id(b))
    let i = 0
    while i < 10 {
        ci_record_moment(ci, "world", trace_ab)
        i = i + 1
    }
    let trace_ac = list_new()
    push(trace_ac, atom_id(a))
    push(trace_ac, atom_id(c))
    ci_record_moment(ci, "world", trace_ac)
    ci_record_moment(ci, "world", trace_ac)

    let nbrs = find_neighbors_full(reg, h_a, ci, 0, 1, 5)
    ce_check("cofire-only: at least one neighbor", len(nbrs) > 0)
    let s_b = neighbor_strength(nbrs, h_b)
    let s_c = neighbor_strength(nbrs, h_c)
    ce_check("cofire-only: beta surfaces", s_b > 0)
    ce_check("cofire-only: gamma surfaces", s_c > 0)
    // Beta has 10/10 co-fires (max), gamma has 2/10 -> beta should be MUCH
    // stronger.
    ce_check("beta stronger than gamma via cofire", s_b > s_c)
    ce_check("beta at full cofire strength (>=900)", s_b >= 900)
}

// ---- test 12: slot-only neighbors (P2.2) -----------------------------------
// Same setup as above, no edges of any kind, but two word atoms have been
// recorded as co-filling the AGENT role of the see_topic pattern. The slot
// side-index must surface them as role-neighbors via find_neighbors_full.
fn test_find_neighbors_full_slot_only() {
    let reg = kg_registry_new()
    let lang = kg_spawn(reg, "lang")
    let w1 = kg_add_atom(lang, ATOM_LANG, "alpha-w", 0)
    let w2 = kg_add_atom(lang, ATOM_LANG, "beta-w", 0)
    let h1 = handle_new("lang", atom_id(w1))
    let h2 = handle_new("lang", atom_id(w2))

    let bare = find_neighbors(reg, h1, 2, 5)
    ce_eq("baseline P14: zero neighbors for alpha-w", len(bare), 0)

    let si = si_new()
    // Pretend pattern atom id = 42 (the exact id doesn't matter -- the
    // index is keyed by integer).
    si_record_fill(si, 42, "AGENT", atom_id(w1))
    si_record_fill(si, 42, "AGENT", atom_id(w2))

    let nbrs = find_neighbors_full(reg, h1, 0, si, 1, 5)
    ce_check("slot-only: alpha-w has a neighbor", len(nbrs) > 0)
    let s = neighbor_strength(nbrs, h2)
    ce_check("slot-only: beta-w surfaces as role-neighbor", s > 0)
    ce_check("slot-only: full strength (>=900)", s >= 900)
}

// ---- test 13: full combined surface -- all five sources clamped at 1000 ---
// Build the medical KG (operator + xref + sense surface) and ALSO wire in a
// cofire history that says "fever and infection appeared together in 10
// moments" plus a slot history. Confirm find_neighbors_full(fever) still
// caps at 1000 and infection remains the top neighbor.
fn test_find_neighbors_full_combined() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let fever     = kg_find_atom(med, "fever")
    let infection = kg_find_atom(med, "infection")

    let h_fev = handle_new("med", atom_id(fever))
    let h_inf = handle_new("med", atom_id(infection))

    let ci = ci_new()
    let trace = list_new()
    push(trace, atom_id(fever))
    push(trace, atom_id(infection))
    let i = 0
    while i < 10 {
        ci_record_moment(ci, "med", trace)
        i = i + 1
    }

    let si = si_new()
    // Fever and infection both fill the TOPIC role in pattern 5.
    si_record_fill(si, 5, "TOPIC", atom_id(fever))
    si_record_fill(si, 5, "TOPIC", atom_id(infection))

    let bare = find_neighbors(renv_kgreg(e), h_fev, 1, 5)
    let s_bare = neighbor_strength(bare, h_inf)
    let full = find_neighbors_full(renv_kgreg(e), h_fev, ci, si, 1, 5)
    let s_full = neighbor_strength(full, h_inf)
    ce_check("combined infection strength capped at 1000", s_full <= 1000)
    ce_check("combined infection strength is positive", s_full > 0)
    // Bare and full are both clamped at 1000 for infection in this setup
    // (operator + xref alone already cap it). What we verify is the
    // additive surface doesn't break either monotonicity or the cap.
    ce_check("combined >= bare (additive)", s_full >= s_bare)
}

// ---- test 14: 3-arg find_neighbors is bit-identical to the P14 baseline ---
// Regression guard. With ci=0 and si=0 the full form must produce the same
// output as the legacy 3-arg form (which IS now just a wrapper with ci=si=0).
fn test_find_neighbors_3arg_wrapper() {
    let e = build_med()
    let med = kg_find(renv_kgreg(e), "med")
    let h_fev = handle_new("med", atom_id(kg_find_atom(med, "fever")))

    let a = find_neighbors(renv_kgreg(e), h_fev, 2, 5)
    let b = find_neighbors_full(renv_kgreg(e), h_fev, 0, 0, 2, 5)
    ce_eq("wrapper and full produce same len", len(a), len(b))
    let same_strengths = 1
    let i = 0
    while i < len(a) {
        if a[i][1] != b[i][1] { same_strengths = 0 }
        if handle_eq(a[i][0], b[i][0]) == 0 { same_strengths = 0 }
        i = i + 1
    }
    ce_eq("wrapper and full are bit-identical", same_strengths, 1)
}

fn main() {
    test_find_neighbors_basic()
    test_find_neighbors_sorted()
    test_find_neighbors_max_results()
    test_find_neighbors_max_hops()
    test_round_trip_includes_neighbors()
    test_cross_kg_link()
    test_lexical_fallback()
    test_round_trip_paraphrase()
    test_exact_match_wins()
    test_word_sense_dedup()
    test_find_neighbors_full_cofire_only()
    test_find_neighbors_full_slot_only()
    test_find_neighbors_full_combined()
    test_find_neighbors_3arg_wrapper()
    ce_summary("neighborhood_activation")
}

main()
