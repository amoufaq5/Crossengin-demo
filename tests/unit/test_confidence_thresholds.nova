// Unit tests for src/learning/confidence_thresholds.nova
// Verifies the low/high-stakes confidence and multi-source checks, the user
// confirmation requirement for high stakes, and the hard-cap force-close with
// provisional atoms. ADR-0030.

import "../ce_test.nova"
import "../../src/learning/confidence_thresholds.nova"

fn test_individual_checks() {
    ce_eq("low conf pass", ct_check_confidence_low(12000, 750, 800), 1)
    ce_eq("low conf fail strength", ct_check_confidence_low(11000, 800, 900), 0)
    ce_eq("low conf fail mean", ct_check_confidence_low(15000, 700, 900), 0)
    ce_eq("low conf fail selftest", ct_check_confidence_low(15000, 800, 700), 0)
    ce_eq("high conf pass", ct_check_confidence_high(20000, 850, 800), 1)
    ce_eq("high conf fail vs low bar", ct_check_confidence_high(12000, 750, 800), 0)
    ce_eq("multisource pass", ct_check_multisource(2, 1000, 0), 1)
    ce_eq("multisource fail count", ct_check_multisource(1, 2000, 0), 0)
    ce_eq("multisource fail weight", ct_check_multisource(3, 500, 0), 0)
    ce_eq("multisource fail contested", ct_check_multisource(3, 2000, 1), 0)
}

fn test_low_stakes_close() {
    // Confident + corroborated -> durable close.
    let r = ct_episode_done(CT_LOW, 13000, 800, 850, 2, 1000, 0, 0, 0, 0)
    ce_eq("low done", ct_done(r), 1)
    ce_eq("low learned", ct_reason(r), CT_REASON_LEARNED)
    ce_eq("low durable", ct_provisional(r), 0)
    // Not yet confident -> not done.
    let r2 = ct_episode_done(CT_LOW, 5000, 600, 500, 1, 600, 0, 0, 0, 0)
    ce_eq("low not done", ct_done(r2), 0)
}

fn test_high_stakes_requires_confirmation() {
    // Meets confidence + multisource but no user confirmation -> not done.
    let r = ct_episode_done(CT_HIGH, 21000, 900, 850, 2, 1000, 0, 0, 0, 0)
    ce_eq("high not done without confirm", ct_done(r), 0)
    // With confirmation -> durable close.
    let r2 = ct_episode_done(CT_HIGH, 21000, 900, 850, 2, 1000, 0, 1, 0, 0)
    ce_eq("high done with confirm", ct_done(r2), 1)
    ce_eq("high durable", ct_provisional(r2), 0)
    // Low-stakes bar is insufficient for high stakes even with confirmation.
    let r3 = ct_episode_done(CT_HIGH, 13000, 800, 850, 2, 1000, 0, 1, 0, 0)
    ce_eq("high needs high bar", ct_done(r3), 0)
}

fn test_hard_caps() {
    // 5 fetch attempts force a provisional close regardless of confidence.
    let r = ct_episode_done(CT_LOW, 0, 0, 0, 0, 0, 0, 0, 5, 0)
    ce_eq("fetch cap closes", ct_done(r), 1)
    ce_eq("force cap reason", ct_reason(r), CT_REASON_FORCE_CAP)
    ce_eq("provisional", ct_provisional(r), 1)
    // An unsatisfied teach-request also force-closes.
    let r2 = ct_episode_done(CT_HIGH, 0, 0, 0, 0, 0, 0, 0, 0, 1)
    ce_eq("teach cap closes", ct_done(r2), 1)
    ce_eq("teach provisional", ct_provisional(r2), 1)
}

fn main() {
    test_individual_checks()
    test_low_stakes_close()
    test_high_stakes_requires_confirmation()
    test_hard_caps()
    ce_summary("confidence_thresholds")
}

main()
