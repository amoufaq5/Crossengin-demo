// Unit tests for src/sandbox/skill_signature.nova (R54.2, ADR-0105
// §Signed skill install).
//
// Covers canonicalization determinism, hash reproducibility, ed25519
// sign+verify roundtrip on a real skill manifest, tamper detection
// (manifest mutated / signature mutated / pubkey mutated), the trust
// anchor registry (add / remove / trusts / dedup), and the
// authorize() gate composed under enforcement.

import "../ce_test.nova"
import "../../src/sandbox/skill_signature.nova"
import "../../src/safety/ed25519.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// Build a synthetic 32-byte list of a fixed byte (for wrong-length /
// null-guard tests where we just need SOMETHING of a specific length).
fn _mk_bytes(n, fill) {
    let out = list_new()
    let i = 0
    while i < n { push(out, fill & 255) i = i + 1 }
    return out
}

// A test keypair via the runtime CSPRNG-backed ed25519_keygen. Not
// deterministic across test runs, but individual tests only need SOME
// valid keypair, not the SAME keypair.
fn _mk_keypair(unused) {
    return ed25519_keygen()
}

fn _kp_seed(kp) { return kp[0] }
fn _kp_pk(kp)   { return kp[1] }

// ---- canonicalization ---------------------------------------------------

fn test_canonicalize_deterministic() {
    let m1 = echo_skill_manifest()
    let m2 = echo_skill_manifest()
    let a = skill_pkg_canonicalize(m1)
    let b = skill_pkg_canonicalize(m2)
    ce_check("byte-identical",         str_eq_bytes(a, b) == 1)
    ce_check("non-empty",              len(a) > 0)
    ce_check("names 'name='",          _has(a, "name="))
    ce_check("names 'version='",       _has(a, "version="))
    ce_check("names 'policy_id='",     _has(a, "policy_id="))
    ce_check("names 'tier='",          _has(a, "tier="))
    ce_check("has version prefix",     _has(a, "crossengin-skill-manifest-v1"))
}

fn test_canonicalize_differs_across_skills() {
    let a = skill_pkg_canonicalize(echo_skill_manifest())
    let b = skill_pkg_canonicalize(research_skill_manifest())
    ce_check("different skills -> different canonical",
             str_eq_bytes(a, b) == 0)
}

fn test_canonicalize_null_is_empty() {
    ce_eq("null -> ''", len(skill_pkg_canonicalize(0)), 0)
}

fn test_hash_deterministic_and_32_bytes() {
    let h1 = skill_pkg_hash_manifest(echo_skill_manifest())
    let h2 = skill_pkg_hash_manifest(echo_skill_manifest())
    ce_eq("32 bytes",    len(h1), 32)
    ce_eq("byte 0 same", h1[0], h2[0])
    ce_eq("byte 31 same", h1[31], h2[31])
}

// ---- sign / verify ------------------------------------------------------

fn test_sign_and_verify_roundtrip() {
    let kp = _mk_keypair(1)
    let m  = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(kp), _kp_pk(kp))
    ce_check("signature returned", sig != 0)
    ce_eq("64-byte signature", len(sig), 64)
    let pkg = skill_pkg_new(m, _kp_pk(kp), sig)
    ce_eq("verifies", skill_pkg_verify(pkg), 1)
}

fn test_sign_null_manifest_returns_zero() {
    let kp = _mk_keypair(2)
    ce_eq("null manifest -> 0",
          skill_pkg_sign(0, _kp_seed(kp), _kp_pk(kp)), 0)
}

fn test_sign_wrong_seed_length_returns_zero() {
    let kp = _mk_keypair(3)
    let short_seed = _mk_bytes(16, 99)      // 16 bytes, not 32
    let m = echo_skill_manifest()
    ce_eq("short seed rejected",
          skill_pkg_sign(m, short_seed, _kp_pk(kp)), 0)
}

fn test_sign_wrong_pk_length_returns_zero() {
    let kp = _mk_keypair(4)
    let short_pk = _mk_bytes(16, 42)
    let m = echo_skill_manifest()
    ce_eq("short pk rejected",
          skill_pkg_sign(m, _kp_seed(kp), short_pk), 0)
}

// ---- tamper detection ---------------------------------------------------

fn test_tamper_manifest_fails_verify() {
    // Sign a manifest, then swap the manifest for a different one
    // while keeping the OLD signature + pubkey. The verifier must
    // refuse (the hash of the new manifest doesn't match the sig).
    let kp = _mk_keypair(5)
    let m1 = echo_skill_manifest()
    let sig = skill_pkg_sign(m1, _kp_seed(kp), _kp_pk(kp))
    let pkg = skill_pkg_new(m1, _kp_pk(kp), sig)
    ce_eq("valid pre-tamper", skill_pkg_verify(pkg), 1)
    // Swap the manifest slot for a different skill.
    list_set(pkg, SKPKG_MANIFEST, research_skill_manifest())
    ce_eq("refuses after manifest swap", skill_pkg_verify(pkg), 0)
}

fn test_tamper_signature_fails_verify() {
    let kp = _mk_keypair(6)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(kp), _kp_pk(kp))
    let pkg = skill_pkg_new(m, _kp_pk(kp), sig)
    ce_eq("valid pre-tamper", skill_pkg_verify(pkg), 1)
    // Flip one byte in the signature.
    let sig2 = list_new()
    let i = 0
    while i < len(sig) { push(sig2, sig[i]) i = i + 1 }
    list_set(sig2, 5, (sig2[5] + 1) & 255)
    list_set(pkg, SKPKG_SIGNATURE, sig2)
    ce_eq("refuses tampered signature", skill_pkg_verify(pkg), 0)
}

fn test_wrong_pubkey_fails_verify() {
    // Sign with a real keypair, then swap the package's pk to a
    // different 32-byte value. Verify must refuse (either the sig
    // doesn't match the new pk, or the new pk isn't a valid point --
    // ed25519_verify returns 0 either way).
    let kp = _mk_keypair(7)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(kp), _kp_pk(kp))
    let pkg = skill_pkg_new(m, _kp_pk(kp), sig)
    ce_eq("valid pre-swap", skill_pkg_verify(pkg), 1)
    // Build a distinct 32-byte pubkey by flipping a chunk of bytes.
    let other = list_new()
    let i = 0
    while i < 32 {
        let b = _kp_pk(kp)[i]
        push(other, (b + 42) & 255)
        i = i + 1
    }
    list_set(pkg, SKPKG_SIGNER_PK, other)
    ce_eq("refuses wrong pubkey", skill_pkg_verify(pkg), 0)
}

fn test_null_pkg_verify_fails() {
    ce_eq("null pkg -> 0", skill_pkg_verify(0), 0)
}

// ---- trust anchor registry ---------------------------------------------

fn test_anchor_registry_empty_starts() {
    let reg = trust_anchor_registry_new()
    ce_eq("empty", trust_anchor_registry_count(reg), 0)
}

fn test_anchor_add_and_trusts() {
    let reg = trust_anchor_registry_new()
    let kp = _mk_keypair(10)
    ce_eq("added (new)", trust_anchor_add(reg, _kp_pk(kp)), 1)
    ce_eq("count 1",     trust_anchor_registry_count(reg), 1)
    ce_eq("trusts",      trust_anchor_trusts(reg, _kp_pk(kp)), 1)
}

fn test_anchor_add_dedupes() {
    let reg = trust_anchor_registry_new()
    let kp = _mk_keypair(11)
    trust_anchor_add(reg, _kp_pk(kp))
    ce_eq("re-add returns 0 (already present)",
          trust_anchor_add(reg, _kp_pk(kp)), 0)
    ce_eq("count still 1", trust_anchor_registry_count(reg), 1)
}

fn test_anchor_add_wrong_length_rejected() {
    let reg = trust_anchor_registry_new()
    let bad = _mk_bytes(16, 5)
    ce_eq("short pk rejected", trust_anchor_add(reg, bad), 0 - 1)
    ce_eq("null rejected",     trust_anchor_add(reg, 0),   0 - 1)
}

fn test_anchor_remove() {
    let reg = trust_anchor_registry_new()
    let kp = _mk_keypair(12)
    trust_anchor_add(reg, _kp_pk(kp))
    ce_eq("removed",   trust_anchor_remove(reg, _kp_pk(kp)), 1)
    ce_eq("count 0",   trust_anchor_registry_count(reg), 0)
    ce_eq("no trust",  trust_anchor_trusts(reg, _kp_pk(kp)), 0)
    ce_eq("re-remove -> 0",
          trust_anchor_remove(reg, _kp_pk(kp)), 0)
}

fn test_anchor_multiple_signers() {
    // Trust anchor stores 32-byte blobs by value; use hand-built
    // distinct byte-lists so the test doesn't depend on
    // ed25519_keygen giving three distinct pks in rapid succession
    // (which it doesn't in every container's CSPRNG).
    let reg = trust_anchor_registry_new()
    let pk_a = _mk_bytes(32, 0xAA)
    let pk_b = _mk_bytes(32, 0xBB)
    let pk_c = _mk_bytes(32, 0xCC)
    trust_anchor_add(reg, pk_a)
    trust_anchor_add(reg, pk_b)
    ce_eq("count 2", trust_anchor_registry_count(reg), 2)
    ce_eq("a trusted", trust_anchor_trusts(reg, pk_a), 1)
    ce_eq("b trusted", trust_anchor_trusts(reg, pk_b), 1)
    ce_eq("c not trusted", trust_anchor_trusts(reg, pk_c), 0)
}

// ---- authorize gate -----------------------------------------------------

fn test_authorize_off_is_pass_through() {
    // enforced=0 -> "" always (even with null everything).
    ce_eq("", len(skill_pkg_authorize(0, 0, 0)), 0)
}

fn test_authorize_null_pkg_refuses() {
    let reg = trust_anchor_registry_new()
    let out = skill_pkg_authorize(1, reg, 0)
    ce_check("names no-package", _has(out, "no SkillPackage supplied"))
}

fn test_authorize_null_reg_refuses() {
    let kp = _mk_keypair(30)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(kp), _kp_pk(kp))
    let pkg = skill_pkg_new(m, _kp_pk(kp), sig)
    let out = skill_pkg_authorize(1, 0, pkg)
    ce_check("names missing registry",
             _has(out, "no trust-anchor registry configured"))
}

fn test_authorize_bad_signature_refuses() {
    let kp = _mk_keypair(31)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(kp), _kp_pk(kp))
    let pkg = skill_pkg_new(m, _kp_pk(kp), sig)
    // Tamper the signature after packaging.
    let sig2 = list_new()
    let i = 0
    while i < len(sig) { push(sig2, sig[i]) i = i + 1 }
    list_set(sig2, 3, (sig2[3] + 1) & 255)
    list_set(pkg, SKPKG_SIGNATURE, sig2)
    let reg = trust_anchor_registry_new()
    trust_anchor_add(reg, _kp_pk(kp))
    let out = skill_pkg_authorize(1, reg, pkg)
    ce_check("names signature-fail",
             _has(out, "signature does not verify"))
}

fn test_authorize_untrusted_signer_refuses() {
    let signer = _mk_keypair(40)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(signer), _kp_pk(signer))
    let pkg = skill_pkg_new(m, _kp_pk(signer), sig)
    let reg = trust_anchor_registry_new()
    // Empty registry -> signer not trusted.
    let out = skill_pkg_authorize(1, reg, pkg)
    ce_check("names untrusted signer",
             _has(out, "signer_pk not in trust-anchor list"))
}

fn test_authorize_grants_when_signed_and_trusted() {
    let signer = _mk_keypair(50)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(signer), _kp_pk(signer))
    let pkg = skill_pkg_new(m, _kp_pk(signer), sig)
    let reg = trust_anchor_registry_new()
    trust_anchor_add(reg, _kp_pk(signer))
    let out = skill_pkg_authorize(1, reg, pkg)
    ce_eq("granted (empty error)", len(out), 0)
}

// ---- audit source tag --------------------------------------------------

fn test_source_tag_shape() {
    let signer = _mk_keypair(60)
    let m = echo_skill_manifest()
    let sig = skill_pkg_sign(m, _kp_seed(signer), _kp_pk(signer))
    let pkg = skill_pkg_new(m, _kp_pk(signer), sig)
    let tag = skill_pkg_source_tag(pkg)
    ce_check("prefix",     _has(tag, "src:skill:signed:"))
    // Fingerprint is 16 hex chars (8 bytes * 2). Total tag length:
    // len("src:skill:signed:") + 16.
    ce_eq("length", len(tag), 17 + 16)
    // Null package returns the unsigned marker.
    ce_check("unsigned marker",
             _has(skill_pkg_source_tag(0), "src:skill:unsigned"))
}

// ---- main --------------------------------------------------------------

fn main() {
    test_canonicalize_deterministic()
    test_canonicalize_differs_across_skills()
    test_canonicalize_null_is_empty()
    test_hash_deterministic_and_32_bytes()
    test_sign_and_verify_roundtrip()
    test_sign_null_manifest_returns_zero()
    test_sign_wrong_seed_length_returns_zero()
    test_sign_wrong_pk_length_returns_zero()
    test_tamper_manifest_fails_verify()
    test_tamper_signature_fails_verify()
    test_wrong_pubkey_fails_verify()
    test_null_pkg_verify_fails()
    test_anchor_registry_empty_starts()
    test_anchor_add_and_trusts()
    test_anchor_add_dedupes()
    test_anchor_add_wrong_length_rejected()
    test_anchor_remove()
    test_anchor_multiple_signers()
    test_authorize_off_is_pass_through()
    test_authorize_null_pkg_refuses()
    test_authorize_null_reg_refuses()
    test_authorize_bad_signature_refuses()
    test_authorize_untrusted_signer_refuses()
    test_authorize_grants_when_signed_and_trusted()
    test_source_tag_shape()
    ce_summary("skill_signature")
}

main()
