// Unit tests for src/util/str_safe.nova: the workaround for NOVA's flaky
// str_eq builtin. Byte-identical strings must always compare equal; any
// byte difference or length mismatch must compare unequal.

import "../ce_test.nova"
import "../../src/util/str_safe.nova"

fn test_equal() {
    ce_eq("empty == empty", str_eq_bytes("", ""), 1)
    ce_eq("'a' == 'a'", str_eq_bytes("a", "a"), 1)
    ce_eq("'op' == 'op' (previously flaky)", str_eq_bytes("op", "op"), 1)
    ce_eq("'num' == 'num' (previously flaky)", str_eq_bytes("num", "num"), 1)
    ce_eq("'hello world' == 'hello world'",
        str_eq_bytes("hello world", "hello world"), 1)
}

fn test_unequal() {
    ce_eq("'' != 'a'", str_eq_bytes("", "a"), 0)
    ce_eq("'a' != ''", str_eq_bytes("a", ""), 0)
    ce_eq("'ab' != 'abc'", str_eq_bytes("ab", "abc"), 0)
    ce_eq("case differs", str_eq_bytes("Op", "op"), 0)
    ce_eq("last-byte differs", str_eq_bytes("abc", "abd"), 0)
    ce_eq("first-byte differs", str_eq_bytes("xbc", "abc"), 0)
}

fn main() {
    test_equal()
    test_unequal()
    ce_summary("str_safe")
}

main()
