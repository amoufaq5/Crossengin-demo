// Verifies the ADR-0092 answer-path exclusion: forward-chaining
// (rk_operators_from) does not follow operators into governed-but-not-promoted
// conclusions, while ungoverned (base) and PROMOTED conclusions pass.

import "../ce_test.nova"
import "../../src/parts/reasoning/reasoning_atoms.nova"
import "../../src/learning/promotion.nova"

fn test_exclusion() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let premise = kg_add_atom(kg, ATOM_CONCEPT, "aspirin", 0)
    let good = kg_add_atom(kg, ATOM_CONCEPT, "fever_relief", 0)
    let bad = kg_add_atom(kg, ATOM_CONCEPT, "snake_oil", 0)

    // Govern: clean web source promotes; unlicensed source quarantines.
    govern_fetched_atom(good, "http://en.wikipedia.org/wiki/Aspirin")
    govern_fetched_atom(bad, "http://random.example.com")
    ce_eq("good promoted -> usable", cand_is_usable(good), 1)
    ce_eq("bad quarantined -> not usable", cand_is_usable(bad), 0)

    // Operators premise -> good (usable) and premise -> bad (quarantined).
    rop_new(kg, ROP_CAUSAL, atom_id(premise), atom_id(good), "src:wiki", 0)
    rop_new(kg, ROP_CAUSAL, atom_id(premise), atom_id(bad), "src:web", 0)

    let ops = rk_operators_from(kg, atom_id(premise))
    ce_eq("only usable-conclusion operator followed", len(ops), 1)
    ce_eq("the followed op concludes 'good'", rop_conclusion(ops[0]), atom_id(good))

    // An ungoverned base conclusion is also followed (base knowledge is trusted).
    let base = kg_add_atom(kg, ATOM_CONCEPT, "base_fact", 0)
    rop_new(kg, ROP_CAUSAL, atom_id(premise), atom_id(base), "src:seed", 0)
    let ops2 = rk_operators_from(kg, atom_id(premise))
    ce_eq("good + ungoverned base followed, bad excluded", len(ops2), 2)
}

fn main() {
    test_exclusion()
    ce_summary("answer_exclusion")
}

main()
