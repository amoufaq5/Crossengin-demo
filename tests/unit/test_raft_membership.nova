// Unit tests for src/federation/raft_membership.nova: safe reconfiguration via
// joint consensus. The key safety property -- during a config change, no two
// DISJOINT vote sets can both decide -- is what prevents a reconfiguration
// split-brain.

import "../ce_test.nova"
import "../../src/federation/raft_membership.nova"

fn _set3(a, b, x) { let s = list_new() push(s, a) push(s, b) push(s, x) return s }
fn _set4(a, b, x, y) { let s = list_new() push(s, a) push(s, b) push(s, x) push(s, y) return s }
fn _pair(a, b) { let s = list_new() push(s, a) push(s, b) return s }
fn _one(a) { let s = list_new() push(s, a) return s }

// Single-config majority arithmetic.
fn test_single_majority() {
    let cfg = _set3(0, 1, 2)
    ce_eq("majority of 3 is 2", rm_majority(cfg), 2)
    ce_eq("{0,1} is a majority", rm_has_majority(cfg, _pair(0, 1)), 1)
    ce_eq("{0} is not a majority", rm_has_majority(cfg, _one(0)), 0)
    // votes from non-members don't count: {0, 9} -> only 0 is in cfg.
    ce_eq("non-member vote ignored", rm_has_majority(cfg, _pair(0, 9)), 0)
}

// Joint consensus: a vote set must be a majority of BOTH configs. Growing the
// cluster {0,1,2} -> {0,1,2,3}: {0,1} is a majority of old but NOT of new (needs
// 3 of 4), so it cannot decide during the joint phase.
fn test_joint_requires_both() {
    let c_old = _set3(0, 1, 2)
    let c_new = _set4(0, 1, 2, 3)
    ce_eq("{0,1} majority of old", rm_has_majority(c_old, _pair(0, 1)), 1)
    ce_eq("{0,1} NOT majority of new", rm_has_majority(c_new, _pair(0, 1)), 0)
    ce_eq("{0,1} cannot decide jointly", rm_has_joint_majority(c_old, c_new, _pair(0, 1)), 0)
    // {0,1,2} is a majority of both (3>=2 old, 3>=3 new) -> joint majority.
    ce_eq("{0,1,2} decides jointly", rm_has_joint_majority(c_old, c_new, _set3(0, 1, 2)), 1)
}

// THE safety property: in the joint phase, two DISJOINT vote sets cannot both
// decide. {0,1} and {2,3} are disjoint; neither can be a joint majority, so they
// cannot each elect a leader -- no reconfiguration split-brain.
fn test_no_disjoint_double_decision() {
    let c_old = _set3(0, 1, 2)
    let c_new = _set4(0, 1, 2, 3)
    let a = _pair(0, 1)
    let b = _pair(2, 3)
    let a_ok = rm_has_joint_majority(c_old, c_new, a)
    let b_ok = rm_has_joint_majority(c_old, c_new, b)
    ce_eq("disjoint set A cannot decide", a_ok, 0)
    ce_eq("disjoint set B cannot decide", b_ok, 0)
    ce_eq("never two joint deciders", a_ok + b_ok, 0)
}

// The transition state machine: STABLE -> JOINT -> STABLE(C_new).
fn test_transition_phases() {
    let s = rm_state(_set3(0, 1, 2))
    ce_eq("starts stable", rm_phase(s), RM_STABLE)
    // stable phase uses single majority of the old config.
    ce_eq("stable decides on old majority", rm_can_decide(s, _pair(0, 1)), 1)
    // enter joint toward {0,1,2,3}.
    rm_begin_change(s, _set4(0, 1, 2, 3))
    ce_eq("now joint", rm_phase(s), RM_JOINT)
    ce_eq("joint blocks old-only majority", rm_can_decide(s, _pair(0, 1)), 0)
    ce_eq("joint allows majority of both", rm_can_decide(s, _set3(0, 1, 2)), 1)
    // commit the change -> stable under C_new.
    rm_commit_change(s)
    ce_eq("stable again", rm_phase(s), RM_STABLE)
    // now {0,1} is only 2 of 4 -> no longer a majority.
    ce_eq("new config needs 3", rm_can_decide(s, _pair(0, 1)), 0)
    ce_eq("new config majority of 3 decides", rm_can_decide(s, _set3(0, 1, 2)), 1)
}

// Shrinking the cluster {0,1,2,3} -> {0,1,2}: during joint, a decision still needs
// a majority of the (larger) old config too, so a bare new-config majority alone
// is insufficient until the change commits.
fn test_shrink_membership() {
    let s = rm_state(_set4(0, 1, 2, 3))
    rm_begin_change(s, _set3(0, 1, 2))
    // {0,1} is a majority of the new {0,1,2} (2>=2) but NOT of old {0,1,2,3} (needs 3).
    ce_eq("joint blocks new-only majority", rm_can_decide(s, _pair(0, 1)), 0)
    // {0,1,2} is a majority of both -> decides.
    ce_eq("joint majority of both decides", rm_can_decide(s, _set3(0, 1, 2)), 1)
    rm_commit_change(s)
    ce_eq("shrunk config live", rm_size(rm_current_config(s)), 3)
}

fn main() {
    test_single_majority()
    test_joint_requires_both()
    test_no_disjoint_double_decision()
    test_transition_phases()
    test_shrink_membership()
    ce_summary("raft_membership")
}

main()
