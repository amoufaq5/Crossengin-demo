// Unit tests for src/agent/loop_reasoning.nova
// Verifies the reasoning loop forward-chains from the percept and writes
// conclusions. ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_reasoning.nova"

fn handle(kg, id) { let h = list_new(); push(h, kg); push(h, id); return h }

fn test_reasoning() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    kg_add_atom(rkg, ATOM_FACT, "rain", 0)   // 0
    kg_add_atom(rkg, ATOM_FACT, "wet", 0)    // 1
    kg_add_atom(rkg, ATOM_FACT, "slip", 0)   // 2
    rop_new(rkg, ROP_CAUSAL, 0, 1, "rain->wet", 0)
    rop_new(rkg, ROP_CAUSAL, 1, 2, "wet->slip", 0)
    let ctx = ctx_new()
    let percept = list_new()
    push(percept, handle("reasoning", 0))   // seed rain
    ctx_set_percept(ctx, percept)
    let n = loop_reasoning_step(ctx, rkg)
    ce_check("conclusions derived", n >= 2)
    ce_check("reaches wet", contains(ctx_conclusions(ctx), 1) == 1)
    ce_check("reaches slip", contains(ctx_conclusions(ctx), 2) == 1)
}

fn main() { test_reasoning() ce_summary("loop_reasoning") }
main()
