// Unit tests for src/mind/recheck.nova: the periodic re-check sweep (ADR-0088).
// Proactively re-runs the kernel over registered FORMAL proofs on a cadence,
// cascading any failure. Covers the registry, the sampled sweep window + cursor
// wrap, the cadence wrapper, and the load-bearing case: a proof that silently
// stops holding (its lemma flipped) is caught by the sweep and its atom unpinned.

import "../ce_test.nova"
import "../../src/mind/recheck.nova"
import "../../src/learning/formal_ingest.nova"

fn _ax(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

// Pin an axiom-rooted atom FORMAL and register it for re-checking. Returns
// [reg, kgreg, rck, atom, pkt].
fn _pin_and_register(label) {
    let reg = proof_registry_new()
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let rck = rck_new()
    let p = term_atom(label)
    let atom = kg_add_atom(kg, ATOM_CONCEPT, label, 0)
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, label, "ax")
    verify_pin_atom(reg, atom, pkt)
    rck_register(rck, atom, pkt)
    let b = list_new()
    push(b, reg) push(b, kgreg) push(b, rck) push(b, atom) push(b, pkt)
    return b
}

// ---- registry --------------------------------------------------------------
fn test_registry_counts() {
    let b = _pin_and_register("p")
    let rck = b[2]
    ce_eq("one registered", rck_count(rck), 1)
    // register a second.
    rck_register(rck, b[3], b[4])
    ce_eq("two registered", rck_count(rck), 2)
}

// ---- a still-valid proof survives the sweep --------------------------------
fn test_valid_proof_survives() {
    let b = _pin_and_register("p")
    let reg = b[0]
    let kgreg = b[1]
    let rck = b[2]
    let atom = b[3]
    let res = rck_sweep(reg, kgreg, rck)
    ce_eq("checked 1", rck_checked(res), 1)
    ce_eq("failed 0", rck_failed(res), 0)
    ce_eq("unpinned 0", rck_unpinned(res), 0)
    ce_eq("still FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
    ce_check("still pinned high", atom_confidence(atom) > 990)
}

// ---- a proof that stops holding is caught + unpinned -----------------------
// Pin p (axiom) and q (HYP on p) in the same registry, register both. Then flip
// p's proof to FAILED behind the sweep's back (as a silent dependency change).
// The sweep re-checks q's packet: its HYP step now sees p as non-VERIFIED, so
// verify_check fails, q cascades, and q's atom is unpinned.
fn test_silent_dependency_change_caught() {
    let reg = proof_registry_new()
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let rck = rck_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_imp(p, q)
    // Pin p.
    let ap = kg_add_atom(kg, ATOM_CONCEPT, "p", 0)
    let pkt_p = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "p")
    verify_pin_atom(reg, ap, pkt_p)
    let code_p = atom_proof_ref(ap)
    rck_register(rck, ap, pkt_p)
    // Pin q via MP using HYP on p.
    let hyps = hyp_new() hyp_add(hyps, "p", p, code_p)
    let aq = kg_add_atom(kg, ATOM_CONCEPT, "q", 0)
    let pkt_q = verify_packet(_ax(pq), hyps, pf_mp(q, pf_axiom(pq), pf_hyp(p, "p")), q, "q", "mp")
    verify_pin_atom(reg, aq, pkt_q)
    rck_register(rck, aq, pkt_q)

    ce_eq("p FORMAL pre", atom_evidence_grade(ap), GRADE_FORMAL)
    ce_eq("q FORMAL pre", atom_evidence_grade(aq), GRADE_FORMAL)

    // Silent corruption: p's proof flips to FAILED with no cascade fired.
    proof_set_status(reg, code_p, PROOF_FAILED)

    // The sweep must catch q (its HYP no longer resolves to VERIFIED).
    let res = rck_sweep(reg, kgreg, rck)
    ce_check("at least one failed", rck_failed(res) >= 1)
    ce_check("at least one unpinned", rck_unpinned(res) >= 1)
    ce_eq("q withdrawn to UNKNOWN", atom_evidence_grade(aq), GRADE_UNKNOWN)
    ce_eq("q belief reset", atom_confidence(aq), 500)
}

// ---- cadence wrapper: due / not-due ----------------------------------------
fn test_cadence_not_due_then_due() {
    let b = _pin_and_register("p")
    let s = rcks_new(b[0], b[1], b[2], 10, 4)
    ce_eq("not due at 5", rcks_on_tick(s, 5), 0)
    let r = rcks_on_tick(s, 10)
    ce_check("due at 10 returns a result", r != 0)
    ce_eq("checked the one proof", rck_checked(r), 1)
}

// ---- sampling: the cursor advances and wraps so all entries get covered -----
fn test_sample_cursor_wraps() {
    // 3 registered proofs, sample 2 per tick, interval 1 (always due).
    let reg = proof_registry_new()
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let rck = rck_new()
    let names = list_new() push(names, "a") push(names, "b") push(names, "c")
    let i = 0
    while i < 3 {
        let lbl = names[i]
        let t = term_atom(lbl)
        let atom = kg_add_atom(kg, ATOM_CONCEPT, lbl, 0)
        let pkt = verify_packet(_ax(t), hyp_new(), pf_axiom(t), t, lbl, "ax")
        verify_pin_atom(reg, atom, pkt)
        rck_register(rck, atom, pkt)
        i = i + 1
    }
    let s = rcks_new(reg, kgreg, rck, 1, 2)
    ce_eq("cursor starts at 0", rcks_cursor(s), 0)
    let r1 = rcks_on_tick(s, 1)     // checks 0,1 -> cursor 2
    ce_eq("first tick checks 2", rck_checked(r1), 2)
    ce_eq("cursor advanced to 2", rcks_cursor(s), 2)
    let r2 = rcks_on_tick(s, 2)     // checks 2 -> window [2,4) clamps to 1 -> cursor wraps
    ce_eq("second tick checks 1 (clamped at end)", rck_checked(r2), 1)
    ce_eq("cursor wrapped to 0", rcks_cursor(s), 0)
}

// ---- disabled cadence is inert ---------------------------------------------
fn test_disabled_cadence() {
    let b = _pin_and_register("p")
    let s = rcks_new(b[0], b[1], b[2], 0, 4)   // every=0 -> disabled
    ce_eq("disabled never fires", rcks_on_tick(s, 9999), 0)
}

// ---- end-to-end: the FORMAL ingest path auto-registers for re-checking ------
// fi_set_recheck_registry wires the registry; lp_ingest_formal then registers
// every atom it pins, so the producer (ingest) and the consumer (sweep) compose
// with no per-atom bookkeeping at the call site.
fn test_ingest_auto_registers() {
    let proofs = proof_registry_new()
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let rck = rck_new()
    fi_set_recheck_registry(rck)

    let p = term_atom("p")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "p", 0)
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "ax")
    let state = lp_ingest_formal(atom, proofs, "wikipedia:P", pkt)
    ce_eq("ingest promoted", state, CAND_PROMOTED)
    ce_eq("auto-registered for re-check", rck_count(rck), 1)
    // A clean sweep finds it valid.
    let res = rck_sweep(proofs, kgreg, rck)
    ce_eq("checked the ingested proof", rck_checked(res), 1)
    ce_eq("no failures", rck_failed(res), 0)
    fi_set_recheck_registry(0)   // unwire for other tests
}

// A QUARANTINED ingest (unclean source) does NOT register -- nothing was pinned.
fn test_quarantined_ingest_not_registered() {
    let proofs = proof_registry_new()
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let rck = rck_new()
    fi_set_recheck_registry(rck)
    let p = term_atom("p")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "p", 0)
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "ax")
    lp_ingest_formal(atom, proofs, "rando-blog:P", pkt)
    ce_eq("nothing registered", rck_count(rck), 0)
    fi_set_recheck_registry(0)
}

fn main() {
    test_registry_counts()
    test_valid_proof_survives()
    test_silent_dependency_change_caught()
    test_cadence_not_due_then_due()
    test_sample_cursor_wraps()
    test_disabled_cadence()
    test_ingest_auto_registers()
    test_quarantined_ingest_not_registered()
    ce_summary("recheck")
}

main()
