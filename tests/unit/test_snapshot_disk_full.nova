// Unit tests for src/persistence/snapshot_disk.nova -- Phase 11 full subsystem
// blob serialization.
//
// Covers what test_snapshot_disk.nova does not: the new KGS atom-by-atom
// round-trip (serialize -> parse -> apply puts labels + beliefs back), the
// extended SOUL blob (purpose/identity/mood/OCEAN/constitution), end-to-end
// disk write+read with enough atoms to stress the list/join shape, and the
// backwards-compat path so an old-format snapshot still parses with no
// catastrophic failure (it just installs zero atoms).
//
// ADR-0048 (snapshot container + runtime seam); Phase 11 Tier 1 item #1.

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"
import "../../src/parts/soul/state.nova"
import "../../src/parts/soul/values.nova"
import "../../src/learning/ask_user_to_teach.nova"

// ---- helpers --------------------------------------------------------------

fn _new_kg() {
    let reg = kg_registry_new()
    return kg_spawn(reg, "reasoning")
}

fn _teach_atom(kg, label, alpha, beta) {
    let a = kg_add_atom(kg, ATOM_CONCEPT, label, 0)
    let b = atom_belief(a)
    list_set(b, 0, alpha)
    list_set(b, 1, beta)
    return a
}

// ---- KGS round-trip -------------------------------------------------------

fn test_kg_section_round_trip_small() {
    // Build a tiny KG with three atoms; serialize the blob; round-trip via the
    // line format; apply to a fresh KG registry; check labels + belief match.
    let kg = _new_kg()
    _teach_atom(kg, "fever",   3000, 1000)
    _teach_atom(kg, "widget",  4000, 1000)
    _teach_atom(kg, "sparkly",  500, 1500)
    ce_eq("source KG has 3 atoms", kg_atom_count(kg), 3)

    let blob = kg_section_build(kg)
    ce_eq("blob[0] atom_count", blob[0], 3)
    ce_eq("blob[1] record count", len(blob[1]), 3)

    // Serialize -> wrap in snapshot -> round-trip via snap_to_text/_from_text.
    let s = snap_new(42, 100)
    let sb = list_new() push(sb, "Aurora") push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    snap_put_section(s, SEC_KGS, blob)
    let text = snap_to_text(s)
    ce_check("encoded text non-empty", len(text) > 0)

    let s2 = snap_from_text(text)
    ce_check("decoded snapshot valid", snap_valid(s2) == 1)
    let kb2 = snap_section(s2, SEC_KGS)
    ce_eq("decoded blob atom count", kb2[0], 3)
    ce_eq("decoded blob has 3 records", len(kb2[1]), 3)

    // Apply: install into a brand new KG registry and check the atoms exist.
    let reg2 = kg_registry_new()
    let created = kg_section_apply(reg2, kb2, 0)
    ce_eq("3 atoms created", created, 3)
    let kg2 = kg_find(reg2, "reasoning")
    ce_check("target KG was spawned", kg2 != 0)
    let fever = kg_find_atom(kg2, "fever")
    ce_check("fever atom exists", fever != 0)
    ce_eq("fever alpha survived", atom_belief(fever)[0], 3000)
    ce_eq("fever beta  survived", atom_belief(fever)[1], 1000)
    let widget = kg_find_atom(kg2, "widget")
    ce_check("widget atom exists", widget != 0)
    ce_eq("widget alpha survived", atom_belief(widget)[0], 4000)
    let sparkly = kg_find_atom(kg2, "sparkly")
    ce_check("sparkly atom exists", sparkly != 0)
    ce_eq("sparkly alpha survived", atom_belief(sparkly)[0], 500)
    ce_eq("sparkly beta survived", atom_belief(sparkly)[1], 1500)
}

fn test_kg_section_apply_is_idempotent() {
    // Applying the same blob twice should not create duplicate atoms (REPLACE
    // BY LABEL policy: existing atom's belief is overwritten with snapshot
    // values; no second copy is made).
    let kg = _new_kg()
    _teach_atom(kg, "alpha", 2000, 1000)
    let blob = kg_section_build(kg)
    let reg2 = kg_registry_new()
    kg_section_apply(reg2, blob, 0)
    let count_after_first = kg_atom_count(kg_find(reg2, "reasoning"))
    kg_section_apply(reg2, blob, 0)
    let count_after_second = kg_atom_count(kg_find(reg2, "reasoning"))
    ce_eq("first apply created 1 atom", count_after_first, 1)
    ce_eq("second apply did not duplicate", count_after_second, 1)
}

fn test_kg_section_apply_restores_lang_word() {
    // The high-impact path for the headline acceptance test: a LANG atom in
    // the snapshot must come back as a real word atom (ltype = LWORD, lexical
    // embedding installed, sense xref to the same-labeled concept atom in a
    // sibling KG) so the reader's lexical anchor recognizes it.
    let reg = kg_registry_new()
    let reasoning = kg_spawn(reg, "reasoning")
    let language = kg_spawn(reg, "language")
    // Seed-style: install widget as a concept atom directly + a real word
    // atom via au_ingest, then build the blob and apply to a fresh registry.
    au_ingest(language, reasoning, "widget", "user_taught", 0)
    let src_blob = list_new()
    push(src_blob, kg_atom_count(reasoning) + kg_atom_count(language))
    let recs = list_new()
    let r1 = kg_section_build(reasoning)[1]
    let r2 = kg_section_build(language)[1]
    let i = 0
    while i < len(r1) { push(recs, r1[i]); i = i + 1 }
    let j = 0
    while j < len(r2) { push(recs, r2[j]); j = j + 1 }
    push(src_blob, recs)

    // Brand new registry: do NOT use au_ingest. Just install the seed concept
    // (the chat already seeds the reasoning KG before loading), then apply.
    let reg2 = kg_registry_new()
    let r_kg2 = kg_spawn(reg2, "reasoning")
    let l_kg2 = kg_spawn(reg2, "language")
    // The concept atom is part of the blob so it lands in reasoning via apply.
    kg_section_apply(reg2, src_blob, 0)

    // Word atom rehydrated as a real LWORD?
    let w = word_find(l_kg2, "widget")
    ce_check("widget found by word_find post-rehydrate", w != 0)
    if w != 0 {
        ce_eq("ltype = LWORD restored", lang_type(w), LWORD)
        ce_check("at least one sense xref restored", word_sense_count(w) > 0)
    }
}

fn test_kg_section_apply_refreshes_belief() {
    // If the target KG already has an atom with the same label, the snapshot
    // overwrites its belief. This is what makes /load idempotent over a
    // re-seeded substrate.
    let reg = kg_registry_new()
    let target = kg_spawn(reg, "reasoning")
    let pre = kg_add_atom(target, ATOM_CONCEPT, "self", 0)
    let pb = atom_belief(pre)
    list_set(pb, 0, 1000)
    list_set(pb, 1, 1000)

    let src = _new_kg()
    _teach_atom(src, "self", 5000, 1000)
    let blob = kg_section_build(src)
    let created = kg_section_apply(reg, blob, 0)
    ce_eq("no new atoms created", created, 0)
    let after = kg_find_atom(target, "self")
    ce_eq("alpha overwritten from snapshot", atom_belief(after)[0], 5000)
    ce_eq("beta overwritten from snapshot", atom_belief(after)[1], 1000)
}

// ---- SOUL round-trip ------------------------------------------------------

fn test_soul_section_round_trip() {
    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_update_mood(sl, 600, 400)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)
    soul_add_constitution(sl, "do not lie", CONST_WARN)

    let blob = soul_section_build(sl)
    ce_str_eq("blob[0] = name", blob[0], "Aurora")
    ce_eq("blob[1] = const count", blob[1], 2)
    ce_str_eq("blob[2] = purpose", blob[2], "understand and assist")
    ce_str_eq("blob[3] = nature", blob[3], "curious")
    ce_eq("blob[4] = mood valence", blob[4], 600)
    ce_eq("blob[5] = mood arousal", blob[5], 400)
    ce_eq("blob[6] = ocean.o", blob[6], 700)
    ce_eq("blob[7] = ocean.c", blob[7], 600)
    ce_eq("blob[8] = ocean.e", blob[8], 500)
    ce_eq("blob[9] = ocean.a", blob[9], 800)
    ce_eq("blob[10] = ocean.n", blob[10], 300)
    ce_eq("blob[11] has 2 rules", len(blob[11]), 2)

    // Round-trip via text -> parse -> apply to a fresh soul.
    let s = snap_new(7, 200)
    snap_put_section(s, SEC_SOUL, blob)
    let kb = list_new() push(kb, 0) push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    ce_check("re-decoded snapshot valid", snap_valid(s2) == 1)
    let blob2 = snap_section(s2, SEC_SOUL)

    let sl2 = soul_new("Other")
    soul_section_apply(sl2, blob2)
    ce_str_eq("name applied to fresh soul",     soul_name(sl2),       "Aurora")
    ce_str_eq("purpose applied",                soul_purpose(sl2),    "understand and assist")
    ce_str_eq("nature applied",                 soul_nature(sl2),     "curious")
    ce_eq("mood valence applied",               soul_mood_valence(sl2), 600)
    ce_eq("mood arousal applied",               soul_mood_arousal(sl2), 400)
    ce_eq("ocean.O applied",                    soul_openness(sl2), 700)
    ce_eq("ocean.C applied",                    soul_conscientiousness(sl2), 600)
    ce_eq("ocean.E applied",                    soul_extraversion(sl2), 500)
    ce_eq("ocean.A applied",                    soul_agreeableness(sl2), 800)
    ce_eq("ocean.N applied",                    soul_neuroticism(sl2), 300)
    ce_eq("constitution rule count applied",    soul_constitution_count(sl2), 2)
    let r0 = soul_constitution_rule(sl2, 0)
    ce_str_eq("rule 0 text",     r0[CR_TEXT],     "exfiltrate")
    ce_eq("rule 0 severity",     r0[CR_SEVERITY], CONST_BLOCK)
    let r1 = soul_constitution_rule(sl2, 1)
    ce_str_eq("rule 1 text",     r1[CR_TEXT],     "do not lie")
    ce_eq("rule 1 severity",     r1[CR_SEVERITY], CONST_WARN)
}

// ---- /tmp on-disk write + read with many atoms ----------------------------

fn test_disk_write_many_atoms() {
    // Stress the encoder: 50+ atoms exercises the per-atom field expansion;
    // each atom emits 6 lines, so this is ~300 emitted lines. Profiles the
    // list-then-join concat path.
    let kg = _new_kg()
    let i = 0
    while i < 55 {
        let lab = "w" + int_to_str(i)
        _teach_atom(kg, lab, 1000 + i * 10, 1000)
        i = i + 1
    }
    ce_eq("source KG has 55 atoms", kg_atom_count(kg), 55)

    let sl = soul_new("Aurora")
    soul_set_identity(sl, "understand and assist", "curious")
    soul_set_ocean(sl, 700, 600, 500, 800, 300)
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)

    let s = snap_new(99, 12345)
    snap_put_section(s, SEC_SOUL, soul_section_build(sl))
    snap_put_section(s, SEC_KGS, kg_section_build(kg))

    let path = "/tmp/crossengin_test_snap_full.dat"
    sys_unlink(path)
    let ok = snap_save(s, path)
    ce_eq("snap_save returned 1", ok, 1)

    let loaded = snap_load(path)
    ce_check("snap_load returned a value", loaded != 0)
    let kb = snap_section(loaded, SEC_KGS)
    ce_eq("loaded blob count", kb[0], 55)
    ce_eq("loaded record count", len(kb[1]), 55)

    let reg2 = kg_registry_new()
    let created = kg_section_apply(reg2, kb, 0)
    ce_eq("55 atoms rehydrated", created, 55)
    let kg2 = kg_find(reg2, "reasoning")
    let w7 = kg_find_atom(kg2, "w7")
    ce_check("w7 rehydrated", w7 != 0)
    ce_eq("w7 alpha rehydrated", atom_belief(w7)[0], 1070)
    let w54 = kg_find_atom(kg2, "w54")
    ce_check("w54 rehydrated", w54 != 0)
    ce_eq("w54 alpha rehydrated", atom_belief(w54)[0], 1540)

    sys_unlink(path)
    sys_unlink(snap_tmp_path(path))
}

// ---- backwards compat ------------------------------------------------------

fn test_legacy_snapshot_parses_zero_atoms() {
    // A hand-written old-style snapshot has `kgs.atoms 572` but no
    // `kgs.atoms.count` / `kgs.atoms[N].*` lines. It MUST parse without
    // error, and applying its blob installs zero atoms (the per-atom
    // records are absent -- the legacy field is a metadata-only hint).
    let old = ""
        + "crossengin-snapshot v1\n"
        + "tag " + int_to_str(SNAP_TAG) + "\n"
        + "ver " + int_to_str(SNAP_FORMAT_VERSION) + "\n"
        + "instance 1\n"
        + "timestamp 1\n"
        + "sections 5\n"
        + "soul.present 1\n"
        + "soul.name Aurora\n"
        + "soul.constcount 0\n"
        + "kgs.present 1\n"
        + "kgs.atoms 572\n"
        + "episodic.present 0\n"
        + "synapses.present 0\n"
        + "selfmodel.present 0\n"
        + "end\n"
    let s = snap_from_text(old)
    ce_check("legacy snapshot parses", s != 0)
    ce_check("legacy snapshot valid", snap_valid(s) == 1)
    let kb = snap_section(s, SEC_KGS)
    ce_eq("legacy blob[0] preserved", kb[0], 572)
    ce_eq("legacy blob record list empty", len(kb[1]), 0)

    let reg = kg_registry_new()
    let created = kg_section_apply(reg, kb, 0)
    ce_eq("legacy apply installs 0 atoms", created, 0)

    // SOUL still readable (and applies to a fresh soul as a defaults-extended
    // legacy blob; missing fields fall through to soul_new defaults).
    let sb = snap_section(s, SEC_SOUL)
    ce_str_eq("legacy soul name preserved", sb[0], "Aurora")
    let sl = soul_new("Other")
    soul_section_apply(sl, sb)
    ce_str_eq("legacy load: name applied", soul_name(sl), "Aurora")
    // Phase 11 fields are absent in old file -> defaults remain on the soul.
    ce_eq("legacy load: mood valence stays at the apply default", soul_mood_valence(sl), 500)
    ce_eq("legacy load: ocean.O default", soul_openness(sl), 500)
}

fn main() {
    test_kg_section_round_trip_small()
    test_kg_section_apply_is_idempotent()
    test_kg_section_apply_restores_lang_word()
    test_kg_section_apply_refreshes_belief()
    test_soul_section_round_trip()
    test_disk_write_many_atoms()
    test_legacy_snapshot_parses_zero_atoms()
    ce_summary("snapshot_disk_full")
}
main()
