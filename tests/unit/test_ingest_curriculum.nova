// Unit tests for src/ingest/curriculum.nova.

import "../ce_test.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/kg/atom_store.nova"

fn test_empty_record_validates() {
    let r = cur_new("history", "src:pack:history")
    ce_eq("empty record ok", cur_validate(r), CUR_OK)
    ce_eq("empty size", cur_size(r), 0)
}

fn test_full_record_validates() {
    let r = cur_new("history", "src:pack:history")
    cur_add_atom(r, "battle_of_hastings_1066", ATOM_FACT, 950)
    cur_add_atom(r, "norman_conquest_started", ATOM_FACT, 900)
    cur_add_imp(r, "battle_of_hastings_1066", "norman_conquest_started", "FORMAL")
    cur_add_obs(r, "battle_of_hastings_1066", 1, 1000)
    cur_add_cite(r, "src:pack:history", "src:paper:doi:10.example/1066", "supports")
    ce_eq("full record ok", cur_validate(r), CUR_OK)
    ce_eq("size adds", cur_size(r), 5)
}

fn test_missing_kg_rejected() {
    let r = cur_new("", "src:foo")
    ce_eq("empty kg rejected", cur_validate(r), CUR_ERR_KG)
}

fn test_bad_source_rejected() {
    let r = cur_new("k", "not-a-src-tag")
    ce_eq("bad source rejected", cur_validate(r), CUR_ERR_SOURCE)
    let r2 = cur_new("k", "src")
    ce_eq("too-short source rejected", cur_validate(r2), CUR_ERR_SOURCE)
    let r3 = cur_new("k", "src:")
    ce_eq("empty-body source rejected", cur_validate(r3), CUR_ERR_SOURCE)
}

fn test_bad_atom_rejected() {
    let r = cur_new("k", "src:x")
    cur_add_atom(r, "", ATOM_FACT, 500)
    ce_eq("empty-label atom rejected", cur_validate(r), CUR_ERR_ATOM)
}

fn test_belief_range() {
    let r1 = cur_new("k", "src:x")
    cur_add_atom(r1, "a", ATOM_FACT, 1001)
    ce_eq("belief > 1000 rejected", cur_validate(r1), CUR_ERR_BELIEF_RANGE)
    let r2 = cur_new("k", "src:x")
    cur_add_atom(r2, "a", ATOM_FACT, 0 - 1)
    ce_eq("belief < 0 rejected", cur_validate(r2), CUR_ERR_BELIEF_RANGE)
    let r3 = cur_new("k", "src:x")
    cur_add_atom(r3, "a", ATOM_FACT, 1000)
    ce_eq("belief == 1000 ok", cur_validate(r3), CUR_OK)
    let r4 = cur_new("k", "src:x")
    cur_add_atom(r4, "a", ATOM_FACT, 0)
    ce_eq("belief == 0 ok", cur_validate(r4), CUR_OK)
}

fn test_bad_obs_sign() {
    let r = cur_new("k", "src:x")
    cur_add_atom(r, "a", ATOM_FACT, 500)
    cur_add_obs(r, "a", 2, 1000)
    ce_eq("sign=2 rejected", cur_validate(r), CUR_ERR_SIGN)
    let r2 = cur_new("k", "src:x")
    cur_add_atom(r2, "a", ATOM_FACT, 500)
    cur_add_obs(r2, "a", 0, 1000)
    ce_eq("sign=0 rejected", cur_validate(r2), CUR_ERR_SIGN)
}

fn test_bad_cite_source() {
    let r = cur_new("k", "src:x")
    cur_add_cite(r, "not-src", "src:ok", "supports")
    ce_eq("cite bad from-src rejected", cur_validate(r), CUR_ERR_CITE)
    let r2 = cur_new("k", "src:x")
    cur_add_cite(r2, "src:ok", "not-src", "supports")
    ce_eq("cite bad to-src rejected", cur_validate(r2), CUR_ERR_CITE)
}

fn test_err_names_exist() {
    ce_check("ok name", len(cur_err_name(CUR_OK)) > 0)
    ce_check("shape name", len(cur_err_name(CUR_ERR_SHAPE)) > 0)
    ce_check("belief name", len(cur_err_name(CUR_ERR_BELIEF_RANGE)) > 0)
    ce_check("unknown name", len(cur_err_name(0 - 999)) > 0)
}

fn main() {
    test_empty_record_validates()
    test_full_record_validates()
    test_missing_kg_rejected()
    test_bad_source_rejected()
    test_bad_atom_rejected()
    test_belief_range()
    test_bad_obs_sign()
    test_bad_cite_source()
    test_err_names_exist()
    ce_summary("ingest_curriculum")
}

main()
