// Unit tests for src/agent/loop_perception.nova
// Verifies the perception loop reads input through the reader and writes
// percept/active/unknown onto the blackboard. ADR-0036.
//
// Phase N R1 (ADR-0092): the loop now delegates to
// `src/parts/perception/perception_module.nova` via a module-level
// singleton, keyed on `renv`. This suite adds a byte-identity assertion
// on a known fixture text against the pre-R1 reader-only ctx state.

import "../ce_test.nova"
import "../../src/agent/loop_perception.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn build() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    let c1 = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    atom_add_xref(c0, xref_new(c0, c1, XREF_CAUSAL, 800, 1))
    atom_add_xref(c1, xref_new(c1, c0, XREF_CAUSAL, 800, 1))
    word_add_sense(word_atom_new(lang, "fever", 0), c0, 900)
    return reader_new(reg, lang, 0)
}

fn test_perception() {
    let renv = build()
    let ctx = ctx_new()
    ctx_set_input(ctx, "fever")
    let matched = loop_perception_step(ctx, renv)
    ce_eq("matched one", matched, 1)
    ce_check("percept populated", len(ctx_percept(ctx)) >= 1)
    ce_eq("no unknown", ctx_unknown(ctx), 0)
    // Unknown token raises the learning signal.
    let ctx2 = ctx_new()
    ctx_set_input(ctx2, "fever glorptide")
    loop_perception_step(ctx2, renv)
    ce_eq("one unknown", ctx_unknown(ctx2), 1)
}

// Regression (ADR-0092): the four ctx slots produced by the Phase-N-R1
// module-delegated path MUST match, slot-for-slot, the pre-R1 inline
// reader-only path on the same fixture text. The refactor is
// additive-only at the ctx-slot layer.
fn test_ctx_byte_identity_vs_reader_only() {
    let renv = build()
    // Post-R1 path (through the module-singleton shim).
    _perception_module_singleton_reset()
    let ctx_a = ctx_new()
    ctx_set_input(ctx_a, "fever")
    loop_perception_step(ctx_a, renv)
    // Reference (pre-R1 inline).
    let ctx_b = ctx_new()
    ctx_set_input(ctx_b, "fever")
    let c = reader_read(renv, "fever", list_new())
    ctx_set_percept(ctx_b, rctx_active(c))
    ctx_set_active(ctx_b, rctx_active(c))
    ctx_set_routes(ctx_b, rctx_routes(c))
    ctx_set_unknown(ctx_b, reader_unknown(c))
    ce_eq("percept len parity", len(ctx_percept(ctx_a)), len(ctx_percept(ctx_b)))
    ce_eq("active len parity", len(ctx_active(ctx_a)), len(ctx_active(ctx_b)))
    ce_eq("routes len parity", len(ctx_routes(ctx_a)), len(ctx_routes(ctx_b)))
    ce_eq("unknown parity", ctx_unknown(ctx_a), ctx_unknown(ctx_b))
}

fn main() {
    test_perception()
    test_ctx_byte_identity_vs_reader_only()
    ce_summary("loop_perception")
}
main()
