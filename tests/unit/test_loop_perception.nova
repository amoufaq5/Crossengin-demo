// Unit tests for src/agent/loop_perception.nova
// Verifies the perception loop reads input through the reader and writes
// percept/active/unknown onto the blackboard. ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_perception.nova"

fn build() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    let c1 = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    atom_add_xref(c0, xref_new(c0, c1, XREF_CAUSAL, 800, 1))
    atom_add_xref(c1, xref_new(c1, c0, XREF_CAUSAL, 800, 1))
    word_add_sense(word_atom_new(lang, "fever", 0), c0, 900)
    return reader_new(reg, lang, 0)
}

fn test_perception() {
    let renv = build()
    let ctx = ctx_new()
    ctx_set_input(ctx, "fever")
    let matched = loop_perception_step(ctx, renv)
    ce_eq("matched one", matched, 1)
    ce_check("percept populated", len(ctx_percept(ctx)) >= 1)
    ce_eq("no unknown", ctx_unknown(ctx), 0)
    // Unknown token raises the learning signal.
    let ctx2 = ctx_new()
    ctx_set_input(ctx2, "fever glorptide")
    loop_perception_step(ctx2, renv)
    ce_eq("one unknown", ctx_unknown(ctx2), 1)
}

fn main() { test_perception() ce_summary("loop_perception") }
main()
