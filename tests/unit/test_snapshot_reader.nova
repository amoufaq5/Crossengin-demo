// Unit tests for src/persistence/snapshot_reader.nova
// Verifies parse + tag/version rejection, the mandatory rehydration order,
// dependency validation (no KGs before soul, no episodic before KGs), the
// present-section plan, and the apply-time order guard. ADR-0048.

import "../ce_test.nova"
import "../../src/persistence/snapshot_reader.nova"

fn _blob(tag) {
    let b = list_new()
    push(b, tag)
    return b
}

// A full snapshot round-trips through serialize -> parse with sections intact.
fn test_parse_roundtrip() {
    let s = snap_new(7, 500)
    snap_put_section(s, SEC_SOUL, _blob(1))
    snap_put_section(s, SEC_KGS, _blob(2))
    snap_put_section(s, SEC_EPISODIC, _blob(3))
    let parsed = snap_parse(snap_serialize(s))
    ce_check("parsed valid", snap_valid(parsed) == 1)
    ce_eq("instance kept", snap_instance(parsed), 7)
    ce_eq("soul recovered", snap_section(parsed, SEC_SOUL)[0], 1)
    ce_eq("episodic recovered", snap_section(parsed, SEC_EPISODIC)[0], 3)
    ce_eq("synapses absent", snap_has_section(parsed, SEC_SYNAPSES), 0)
}

// Wrong tag or version is rejected (tamper / incompatible image).
fn test_reject_bad_image() {
    let ser = snap_serialize(snap_new(1, 0))
    let good = snap_parse(ser)
    ce_check("good parses", snap_valid(good) == 1)
    // Corrupt the tag.
    list_set(ser, 0, 9999)
    ce_eq("bad tag rejected", snap_parse(ser), 0)
    // Restore tag, corrupt the version.
    list_set(ser, 0, SNAP_TAG)
    list_set(ser, 1, 999)
    ce_eq("bad version rejected", snap_parse(ser), 0)
}

// Mandatory order is soul, kgs, episodic, synapses, selfmodel.
fn test_order() {
    let o = snap_rehydrate_order()
    ce_eq("soul first", o[0], SEC_SOUL)
    ce_eq("kgs second", o[1], SEC_KGS)
    ce_eq("episodic third", o[2], SEC_EPISODIC)
}

// Dependency validation: a present section needs its predecessor present.
fn test_dependency_validation() {
    let ok = snap_new(1, 0)
    snap_put_section(ok, SEC_SOUL, _blob(1))
    snap_put_section(ok, SEC_KGS, _blob(2))
    snap_put_section(ok, SEC_EPISODIC, _blob(3))
    ce_eq("well-ordered valid", snap_rehydrate_valid(ok), 1)

    // KGs without the soul -> refused (constitution must be live first).
    let bad1 = snap_new(1, 0)
    snap_put_section(bad1, SEC_KGS, _blob(2))
    ce_eq("kgs without soul refused", snap_rehydrate_valid(bad1), 0)

    // Episodic without KGs -> refused (moments would dangle).
    let bad2 = snap_new(1, 0)
    snap_put_section(bad2, SEC_SOUL, _blob(1))
    snap_put_section(bad2, SEC_EPISODIC, _blob(3))
    ce_eq("episodic without kgs refused", snap_rehydrate_valid(bad2), 0)

    // A soul-only snapshot is valid (fresh instance, no knowledge yet).
    let soulonly = snap_new(1, 0)
    snap_put_section(soulonly, SEC_SOUL, _blob(1))
    ce_eq("soul-only valid", snap_rehydrate_valid(soulonly), 1)
}

// The plan lists only present sections, in mandatory order.
fn test_plan() {
    let s = snap_new(1, 0)
    snap_put_section(s, SEC_SOUL, _blob(1))
    snap_put_section(s, SEC_KGS, _blob(2))
    snap_put_section(s, SEC_SELFMODEL, _blob(5))
    let plan = snap_rehydrate_plan(s)
    ce_eq("three present", len(plan), 3)
    ce_eq("plan[0] soul", plan[0], SEC_SOUL)
    ce_eq("plan[1] kgs", plan[1], SEC_KGS)
    ce_eq("plan[2] selfmodel", plan[2], SEC_SELFMODEL)
}

// The apply-time cursor refuses out-of-order application.
fn test_apply_guard() {
    let cur = snap_cursor_new()
    ce_eq("soul applies first", snap_can_apply(cur, SEC_SOUL), 1)
    ce_eq("kgs blocked before soul", snap_can_apply(cur, SEC_KGS), 0)
    snap_mark_applied(cur, SEC_SOUL)
    ce_eq("kgs ok after soul", snap_can_apply(cur, SEC_KGS), 1)
    ce_eq("episodic blocked before kgs", snap_can_apply(cur, SEC_EPISODIC), 0)
    snap_mark_applied(cur, SEC_KGS)
    ce_eq("episodic ok after kgs", snap_can_apply(cur, SEC_EPISODIC), 1)
    ce_eq("synapses ok after kgs", snap_can_apply(cur, SEC_SYNAPSES), 1)
}

fn main() {
    test_parse_roundtrip()
    test_reject_bad_image()
    test_order()
    test_dependency_validation()
    test_plan()
    test_apply_guard()
    ce_summary("snapshot_reader")
}
main()
