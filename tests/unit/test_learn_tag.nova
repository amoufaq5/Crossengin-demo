// Unit tests for the /learn argument -> cache-tag derivation used by
// examples/crossengin_chat.nova's _admin_learn handler (Phase 15 / Tier 2
// item #3 multi-source learning).
//
// Why this lives standalone (not by importing the chat): the chat is the
// runnable artifact and pulls in the full agent stack at top level -- a unit
// test cannot import it cleanly. The helper bodies under test are a literal,
// byte-for-byte copy of those in examples/crossengin_chat.nova; any drift
// will surface immediately in the assertions below or in scripts/learn_smoke_multi.sh
// (which probes the BASH side of the same derivation). The contract that
// matters is: the chat-side tag MUST equal what scripts/learn.sh produced
// for the same argument, otherwise the cache file path will not resolve.
//
// Test coverage: classification of all three kinds (TOPIC / URL / FILE) and
// the tag-string output for representative inputs of each, including the
// edge cases that exercise the more interesting sed clauses (extension
// stripping for FILE, path-mangling and 64-char cap for URL, ./../ prefix
// detection, hidden-file-with-no-extension, and pure-topic passthrough).

import "../ce_test.nova"

let LEARN_KIND_TOPIC = 0
let LEARN_KIND_URL   = 1
let LEARN_KIND_FILE  = 2
let LEARN_KIND_BATCH = 3   // P1.5 -- @/path/urls.txt
let LEARN_KIND_RSS   = 4   // P1.5 -- rss:URL
let LEARN_KIND_DIR   = 5   // P1.5 -- dir:/path

fn _learn_kind(arg) {
    if len(arg) == 0 { return LEARN_KIND_TOPIC }
    // P1.5 composite prefixes come first, before path-shape detection.
    if char_at(arg, 0) == 64 { return LEARN_KIND_BATCH }
    if starts_with(arg, "rss:") == 1 { return LEARN_KIND_RSS }
    if starts_with(arg, "dir:") == 1 { return LEARN_KIND_DIR }
    if starts_with(arg, "http://")  == 1 { return LEARN_KIND_URL }
    if starts_with(arg, "https://") == 1 { return LEARN_KIND_URL }
    if char_at(arg, 0) == 47 { return LEARN_KIND_FILE }
    if len(arg) >= 2 {
        if char_at(arg, 0) == 46 {
            if char_at(arg, 1) == 47 { return LEARN_KIND_FILE }
            if len(arg) >= 3 {
                if char_at(arg, 1) == 46 {
                    if char_at(arg, 2) == 47 { return LEARN_KIND_FILE }
                }
            }
        }
    }
    return LEARN_KIND_TOPIC
}

fn _is_tag_alnum(c) {
    if c >= 48 { if c <= 57  { return 1 } }
    if c >= 65 { if c <= 90  { return 1 } }
    if c >= 97 { if c <= 122 { return 1 } }
    if c == 95 { return 1 }
    if c == 45 { return 1 }
    return 0
}

fn _cap_tag(s) {
    if len(s) <= 64 { return s }
    return substr(s, 0, 64)
}

fn _learn_tag_url(arg) {
    let s = arg
    if starts_with(s, "https://") == 1 { s = substr(s, 8, len(s) - 8) }
    else { if starts_with(s, "http://") == 1 { s = substr(s, 7, len(s) - 7) } }
    let out = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 47 {
            out = out + "_"
        } else {
            if _is_tag_alnum(c) == 1 {
                out = out + substr(s, i, 1)
            }
        }
        i = i + 1
    }
    return _cap_tag(out)
}

fn _learn_tag_file(arg) {
    let cut = 0 - 1
    let i = 0
    while i < len(arg) {
        if char_at(arg, i) == 47 { cut = i }
        i = i + 1
    }
    let base = arg
    if cut >= 0 { base = substr(arg, cut + 1, len(arg) - cut - 1) }
    let dot = 0 - 1
    let j = 0
    while j < len(base) {
        if char_at(base, j) == 46 { dot = j }
        j = j + 1
    }
    let body = base
    if dot >= 0 {
        if dot < len(base) - 1 { body = substr(base, 0, dot) }
    }
    let out = ""
    let k = 0
    while k < len(body) {
        let c = char_at(body, k)
        if _is_tag_alnum(c) == 1 {
            out = out + substr(body, k, 1)
        } else {
            out = out + "_"
        }
        k = k + 1
    }
    return _cap_tag(out)
}

// Sanitiser shared by all P1.5 composite tag derivers.
fn _tag_sanitise(s) {
    let out = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if _is_tag_alnum(c) == 1 {
            out = out + substr(s, i, 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    return _cap_tag(out)
}

fn _learn_tag_batch(arg) {
    let s = arg
    if len(s) >= 1 {
        if char_at(s, 0) == 64 { s = substr(s, 1, len(s) - 1) }
    }
    let cut = 0 - 1
    let i = 0
    while i < len(s) {
        if char_at(s, i) == 47 { cut = i }
        i = i + 1
    }
    let base = s
    if cut >= 0 { base = substr(s, cut + 1, len(s) - cut - 1) }
    let dot = 0 - 1
    let j = 0
    while j < len(base) {
        if char_at(base, j) == 46 { dot = j }
        j = j + 1
    }
    let stem = base
    if dot >= 0 {
        if dot < len(base) - 1 { stem = substr(base, 0, dot) }
    }
    return _tag_sanitise("batch_" + stem)
}

fn _learn_tag_rss(arg) {
    let s = arg
    if starts_with(s, "rss:") == 1 { s = substr(s, 4, len(s) - 4) }
    if starts_with(s, "https://") == 1 { s = substr(s, 8, len(s) - 8) }
    else { if starts_with(s, "http://") == 1 { s = substr(s, 7, len(s) - 7) } }
    let slash = 0 - 1
    let i = 0
    while i < len(s) {
        if char_at(s, i) == 47 {
            if slash < 0 { slash = i }
        }
        i = i + 1
    }
    let host = s
    if slash >= 0 { host = substr(s, 0, slash) }
    if len(host) > 32 { host = substr(host, 0, 32) }
    return _tag_sanitise("rss_" + host)
}

fn _basename(s) {
    let cut = 0 - 1
    let i = 0
    while i < len(s) {
        if char_at(s, i) == 47 { cut = i }
        i = i + 1
    }
    if cut < 0 { return s }
    return substr(s, cut + 1, len(s) - cut - 1)
}

fn _learn_tag_dir(arg) {
    let s = arg
    if starts_with(s, "dir:") == 1 { s = substr(s, 4, len(s) - 4) }
    while len(s) > 0 {
        if char_at(s, len(s) - 1) == 47 { s = substr(s, 0, len(s) - 1) }
        else { return _tag_sanitise("dir_" + _basename(s)) }
    }
    return _tag_sanitise("dir_")
}

fn _learn_tag(arg) {
    let kind = _learn_kind(arg)
    if kind == LEARN_KIND_URL   { return _learn_tag_url(arg) }
    if kind == LEARN_KIND_FILE  { return _learn_tag_file(arg) }
    if kind == LEARN_KIND_BATCH { return _learn_tag_batch(arg) }
    if kind == LEARN_KIND_RSS   { return _learn_tag_rss(arg) }
    if kind == LEARN_KIND_DIR   { return _learn_tag_dir(arg) }
    return arg
}

// ---- classification (kind) ------------------------------------------------
fn test_kind() {
    ce_eq("bare topic -> TOPIC",     _learn_kind("fever"),                         LEARN_KIND_TOPIC)
    ce_eq("https -> URL",            _learn_kind("https://example.com/x"),         LEARN_KIND_URL)
    ce_eq("http -> URL",             _learn_kind("http://example.com/x"),          LEARN_KIND_URL)
    ce_eq("/abs -> FILE",            _learn_kind("/tmp/test_corpus.txt"),          LEARN_KIND_FILE)
    ce_eq("./rel -> FILE",           _learn_kind("./local.txt"),                   LEARN_KIND_FILE)
    ce_eq("../rel -> FILE",          _learn_kind("../sibling.txt"),                LEARN_KIND_FILE)
    ce_eq("empty -> TOPIC default",  _learn_kind(""),                              LEARN_KIND_TOPIC)
    // A bare '.' is NOT a file path -- needs a slash after.
    ce_eq("'.' (no slash) -> TOPIC", _learn_kind(".bashrc"),                       LEARN_KIND_TOPIC)
    ce_eq("'..' (no slash) -> TOPIC", _learn_kind(".."),                           LEARN_KIND_TOPIC)
    // P1.5 composite kinds.
    ce_eq("'@list' -> BATCH",        _learn_kind("@/tmp/urls.txt"),                LEARN_KIND_BATCH)
    ce_eq("'@rel' -> BATCH",         _learn_kind("@urls.txt"),                     LEARN_KIND_BATCH)
    ce_eq("'rss:URL' -> RSS",        _learn_kind("rss:https://example.com/feed"),  LEARN_KIND_RSS)
    ce_eq("'dir:/path' -> DIR",      _learn_kind("dir:/tmp/corpus/"),              LEARN_KIND_DIR)
    ce_eq("'dir:rel' -> DIR",        _learn_kind("dir:corpus"),                    LEARN_KIND_DIR)
    // Verify the composite prefixes win over file-shape detection: a string
    // starting with '@/...' must be BATCH, not FILE.
    ce_eq("'@/...' is BATCH not FILE", _learn_kind("@/tmp/list.txt"),              LEARN_KIND_BATCH)
}

// ---- tag derivation -------------------------------------------------------
fn test_tag_topic() {
    // TOPIC pass-through: chat sees exactly what bash saw.
    ce_str_eq("topic pass-through",  _learn_tag("fever"),    "fever")
    ce_str_eq("topic with hyphens",  _learn_tag("co-vid"),   "co-vid")
    ce_str_eq("topic with under",    _learn_tag("my_topic"), "my_topic")
}

fn test_tag_url() {
    // Reference: scripts/learn.sh: sed -E 's|^https?://||; s|/|_|g; s|[^a-zA-Z0-9_-]||g' | cut -c1-64
    ce_str_eq("https wikipedia Aspirin",
        _learn_tag("https://en.wikipedia.org/wiki/Aspirin"),
        "enwikipediaorg_wiki_Aspirin")
    ce_str_eq("http variant strips scheme",
        _learn_tag("http://example.com/page"),
        "examplecom_page")
    ce_str_eq("url with query gets stripped",
        _learn_tag("https://example.com/page?q=1&id=42"),
        "examplecom_pageq1id42")
    // 64-char cap: 200 chars of 'a' after scheme strip is still all 'a',
    // but capped at 64.
    let long = "https://"
    let i = 0
    while i < 200 { long = long + "a" i = i + 1 }
    ce_eq("url tag capped at 64", len(_learn_tag(long)), 64)
}

fn test_tag_file() {
    // Reference: basename | sed -E 's|\.[^.]+$||; s|[^a-zA-Z0-9_-]|_|g' | cut -c1-64
    ce_str_eq("abs path strips dir+ext",
        _learn_tag("/tmp/test_corpus.txt"),
        "test_corpus")
    ce_str_eq("relative ./ strips dir+ext",
        _learn_tag("./notes.md"),
        "notes")
    ce_str_eq("parent ../ strips dir+ext",
        _learn_tag("../share/data.json"),
        "data")
    // Only the LAST extension is stripped (matches sed greedy on '.[^.]+$').
    ce_str_eq("only last extension stripped",
        _learn_tag("/srv/archive.tar.gz"),
        "archive_tar")
    // No extension: keep the whole basename.
    ce_str_eq("no extension keeps basename",
        _learn_tag("/tmp/Makefile"),
        "Makefile")
    // Spaces in basename become underscores (non-alnum->'_').
    ce_str_eq("non-alnum becomes underscore",
        _learn_tag("/tmp/hello world.txt"),
        "hello_world")
}

// ---- P1.5 BATCH tag derivation --------------------------------------------
// Reference: bash builds STEM = basename(LIST_PATH without last extension);
// TAG = sanitise("batch_" + STEM).
fn test_tag_batch() {
    ce_str_eq("batch abs strips dir+ext",
        _learn_tag("@/tmp/urls.txt"),
        "batch_urls")
    ce_str_eq("batch relative file",
        _learn_tag("@urls.txt"),
        "batch_urls")
    ce_str_eq("batch no extension keeps stem",
        _learn_tag("@/etc/Makefile"),
        "batch_Makefile")
    ce_str_eq("batch stem with hyphen preserved",
        _learn_tag("@/tmp/my-list.txt"),
        "batch_my-list")
}

// ---- P1.5 RSS tag derivation ----------------------------------------------
// Reference: TAG = sanitise("rss_" + host), where host is the portion of the
// feed URL after http(s):// and before the first '/'.
fn test_tag_rss() {
    ce_str_eq("rss simple host",
        _learn_tag("rss:https://feeds.bbci.co.uk/news/rss.xml"),
        "rss_feeds_bbci_co_uk")
    ce_str_eq("rss http variant",
        _learn_tag("rss:http://example.com/atom.xml"),
        "rss_example_com")
    ce_str_eq("rss host-only no path",
        _learn_tag("rss:https://feeds.example.org"),
        "rss_feeds_example_org")
    // Hosts longer than 32 chars get truncated BEFORE the rss_ prefix is
    // added, so the final tag stays well under the 64-char cap.
    let long_host = "rss:https://"
    let i = 0
    while i < 60 { long_host = long_host + "a" i = i + 1 }
    long_host = long_host + "/feed"
    let tag = _learn_tag(long_host)
    ce_eq("rss long host stays <=64", len(tag) <= 64, 1)
}

// ---- P1.5 DIR tag derivation ----------------------------------------------
// Reference: TAG = sanitise("dir_" + basename(DIR_PATH after stripping
// trailing slashes)).
fn test_tag_dir() {
    ce_str_eq("dir abs strips trailing slash",
        _learn_tag("dir:/tmp/test_corpus_dir/"),
        "dir_test_corpus_dir")
    ce_str_eq("dir abs no trailing slash",
        _learn_tag("dir:/tmp/test_corpus_dir"),
        "dir_test_corpus_dir")
    ce_str_eq("dir relative basename",
        _learn_tag("dir:corpus"),
        "dir_corpus")
    ce_str_eq("dir with spaces sanitised",
        _learn_tag("dir:/tmp/my corpus/"),
        "dir_my_corpus")
}

fn main() {
    test_kind()
    test_tag_topic()
    test_tag_url()
    test_tag_file()
    test_tag_batch()
    test_tag_rss()
    test_tag_dir()
    ce_summary("learn_tag")
}

main()
