// Unit tests for src/sandbox/ownership.nova + R55.2 wire integration
// on kg.list / capsule.list.
//
// Covers the overlay's shape (kinds, set/clear/lookup, filter), the
// visibility rule (unset = public; set = holder-exact), backward-
// compat null-overlay behavior (nothing filtered), and the wire
// verbs' filtering under a wired overlay + presented-holder path.

import "../ce_test.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/sandbox/capability.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    let kgreg = kg_registry_new()
    kg_spawn(kgreg, "world")
    kg_spawn(kgreg, "alice_notebook")
    kg_spawn(kgreg, "bob_notebook")
    let capreg = capreg_new()
    capreg_register(capreg, capsule_new("public_pack",  "1.0.0"))
    capreg_register(capreg, capsule_new("alice_private", "1.0.0"))
    capreg_register(capreg, capsule_new("bob_private",   "1.0.0"))
    return rpc_ctx_new(kgreg, capreg, persona_registry_new(),
                        skill_registry_new(), mo_new(), 0, 0, 100)
}

fn _grant_holder(ctx, holder) {
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-" + holder, holder, roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-" + holder)
    return reg
}

// ---- kind constants + guards --------------------------------------------

fn test_kinds_populated() {
    let ks = ownership_kinds()
    ce_check("2 kinds", len(ks) >= 2)
    ce_eq("kg known",      ownership_is_known_kind(OWN_KIND_KG), 1)
    ce_eq("capsule known", ownership_is_known_kind(OWN_KIND_CAPSULE), 1)
    ce_eq("bogus rejected", ownership_is_known_kind("no-such"), 0)
}

// ---- overlay lifecycle --------------------------------------------------

fn test_empty_overlay_owner_is_empty() {
    let reg = ownership_registry_new()
    ce_eq("count 0", ownership_registry_count(reg), 0)
    ce_eq("owner empty", len(ownership_owner(reg, OWN_KIND_KG, "world")), 0)
}

fn test_set_and_owner() {
    let reg = ownership_registry_new()
    let code = ownership_set(reg, OWN_KIND_KG, "alice_kg", "alice")
    ce_eq("set returns 1 (new)", code, 1)
    ce_eq("count 1", ownership_registry_count(reg), 1)
    ce_eq("owner is alice",
          str_eq_bytes(ownership_owner(reg, OWN_KIND_KG, "alice_kg"), "alice"), 1)
}

fn test_set_updates_existing() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "shared", "alice")
    let code = ownership_set(reg, OWN_KIND_KG, "shared", "bob")
    ce_eq("update returns 1", code, 1)
    ce_eq("count still 1", ownership_registry_count(reg), 1)
    ce_eq("owner now bob",
          str_eq_bytes(ownership_owner(reg, OWN_KIND_KG, "shared"), "bob"), 1)
}

fn test_clear_by_empty_owner() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "temp", "alice")
    let code = ownership_set(reg, OWN_KIND_KG, "temp", "")
    ce_eq("clear returns 0", code, 0)
    ce_eq("count back to 0", ownership_registry_count(reg), 0)
    ce_eq("owner empty",
          len(ownership_owner(reg, OWN_KIND_KG, "temp")), 0)
}

fn test_unknown_kind_rejected() {
    let reg = ownership_registry_new()
    ce_eq("set rejects", ownership_set(reg, "bogus", "x", "alice"), 0 - 1)
    ce_eq("empty name rejects",
          ownership_set(reg, OWN_KIND_KG, "", "alice"), 0 - 1)
}

// ---- visibility rules ---------------------------------------------------

fn test_null_overlay_is_visible_to_everyone() {
    // reg == 0 -> always visible (backward compat).
    ce_eq("null visible to alice",
          ownership_visible(0, OWN_KIND_KG, "world", "alice"), 1)
    ce_eq("null visible to anonymous",
          ownership_visible(0, OWN_KIND_KG, "world", ""), 1)
}

fn test_unset_resource_visible_to_all() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "alice_kg", "alice")
    ce_eq("world (unset) visible to alice",
          ownership_visible(reg, OWN_KIND_KG, "world", "alice"), 1)
    ce_eq("world visible to bob",
          ownership_visible(reg, OWN_KIND_KG, "world", "bob"), 1)
    ce_eq("world visible to anonymous",
          ownership_visible(reg, OWN_KIND_KG, "world", ""), 1)
}

fn test_owned_visible_to_exact_owner_only() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "alice_kg", "alice")
    ce_eq("alice sees her kg",
          ownership_visible(reg, OWN_KIND_KG, "alice_kg", "alice"), 1)
    ce_eq("bob does NOT",
          ownership_visible(reg, OWN_KIND_KG, "alice_kg", "bob"), 0)
    ce_eq("anonymous does NOT",
          ownership_visible(reg, OWN_KIND_KG, "alice_kg", ""), 0)
}

fn test_kg_and_capsule_kinds_are_independent() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "shared_name", "alice")
    ownership_set(reg, OWN_KIND_CAPSULE, "shared_name", "bob")
    ce_eq("alice sees kg", ownership_visible(reg, OWN_KIND_KG, "shared_name", "alice"), 1)
    ce_eq("bob does not see kg", ownership_visible(reg, OWN_KIND_KG, "shared_name", "bob"), 0)
    ce_eq("bob sees capsule", ownership_visible(reg, OWN_KIND_CAPSULE, "shared_name", "bob"), 1)
    ce_eq("alice does not see capsule", ownership_visible(reg, OWN_KIND_CAPSULE, "shared_name", "alice"), 0)
}

// ---- filter --------------------------------------------------------------

fn test_filter_preserves_order() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "b", "alice")
    ownership_set(reg, OWN_KIND_KG, "d", "bob")
    let names = list_new()
    push(names, "a") push(names, "b") push(names, "c") push(names, "d") push(names, "e")
    // alice sees a, b, c, e (not d).
    let out = ownership_filter(reg, OWN_KIND_KG, names, "alice")
    ce_eq("4 visible", len(out), 4)
    ce_eq("order preserved 0", str_eq_bytes(out[0], "a"), 1)
    ce_eq("order preserved 1", str_eq_bytes(out[1], "b"), 1)
    ce_eq("order preserved 2", str_eq_bytes(out[2], "c"), 1)
    ce_eq("order preserved 3", str_eq_bytes(out[3], "e"), 1)
}

fn test_filter_null_overlay_is_identity() {
    let names = list_new() push(names, "x") push(names, "y")
    let out = ownership_filter(0, OWN_KIND_KG, names, "anyone")
    ce_eq("passthrough len", len(out), 2)
}

// ---- convenience wrappers -----------------------------------------------

fn test_kg_wrappers() {
    let reg = ownership_registry_new()
    ownership_set_kg(reg, "alice_kg", "alice")
    ce_eq("wrapper visible for alice",
          ownership_kg_visible(reg, "alice_kg", "alice"), 1)
    ce_eq("wrapper hidden for bob",
          ownership_kg_visible(reg, "alice_kg", "bob"), 0)
}

fn test_capsule_wrappers() {
    let reg = ownership_registry_new()
    ownership_set_capsule(reg, "alice_pack", "alice")
    ce_eq("wrapper visible for alice",
          ownership_capsule_visible(reg, "alice_pack", "alice"), 1)
    ce_eq("wrapper hidden for bob",
          ownership_capsule_visible(reg, "alice_pack", "bob"), 0)
}

// ---- RpcContext helper: presented holder --------------------------------

fn test_presented_holder_empty_when_no_sandbox() {
    let ctx = _mk_ctx()
    // No sandbox, no token -> anonymous.
    ce_eq("empty", len(rpc_ctx_presented_holder(ctx)), 0)
}

fn test_presented_holder_from_valid_token() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    ce_eq("resolves to alice",
          str_eq_bytes(rpc_ctx_presented_holder(ctx), "alice"), 1)
}

fn test_presented_holder_empty_on_unknown_token() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "no-such-token")
    ce_eq("empty (unknown token)", len(rpc_ctx_presented_holder(ctx)), 0)
}

// ---- wire integration: kg.list ------------------------------------------

fn test_kg_list_unfiltered_when_no_overlay() {
    // Overlay slot 0 -> backward-compat: every KG visible regardless.
    let ctx = _mk_ctx()
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world",           _has(out, "\"world\""))
    ce_check("alice_notebook",  _has(out, "\"alice_notebook\""))
    ce_check("bob_notebook",    _has(out, "\"bob_notebook\""))
}

fn test_kg_list_filters_by_holder() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_notebook", "alice")
    ownership_set_kg(overlay, "bob_notebook",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world (public) visible",         _has(out, "\"world\""))
    ce_check("alice_notebook visible to alice", _has(out, "\"alice_notebook\""))
    ce_eq("bob_notebook HIDDEN from alice",
          _has(out, "\"bob_notebook\""), 0)
}

fn test_kg_list_bob_sees_only_his() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_notebook", "alice")
    ownership_set_kg(overlay, "bob_notebook",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world visible",              _has(out, "\"world\""))
    ce_check("bob_notebook visible to bob", _has(out, "\"bob_notebook\""))
    ce_eq("alice_notebook HIDDEN from bob",
          _has(out, "\"alice_notebook\""), 0)
}

fn test_kg_list_anonymous_sees_only_public() {
    let ctx = _mk_ctx()
    // No token grant -- anonymous caller under an overlay.
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_notebook", "alice")
    ownership_set_kg(overlay, "bob_notebook",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world (unset) visible", _has(out, "\"world\""))
    ce_eq("alice_notebook hidden",    _has(out, "\"alice_notebook\""), 0)
    ce_eq("bob_notebook hidden",      _has(out, "\"bob_notebook\""), 0)
}

// ---- wire integration: capsule.list ------------------------------------

fn test_capsule_list_filters_by_holder() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_capsule(overlay, "alice_private", "alice")
    ownership_set_capsule(overlay, "bob_private",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("public_pack visible",      _has(out, "\"name\":\"public_pack\""))
    ce_check("alice_private visible to alice",
             _has(out, "\"name\":\"alice_private\""))
    ce_eq("bob_private HIDDEN from alice",
          _has(out, "\"name\":\"bob_private\""), 0)
}

fn test_capsule_list_unfiltered_when_no_overlay() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("public_pack visible",    _has(out, "\"name\":\"public_pack\""))
    ce_check("alice_private visible",  _has(out, "\"name\":\"alice_private\""))
    ce_check("bob_private visible",    _has(out, "\"name\":\"bob_private\""))
}

// ---- ownership_entries surface ------------------------------------------

fn test_entries_null_returns_empty() {
    ce_eq("null -> empty", len(ownership_entries(0)), 0)
}

fn test_entries_reflects_writes() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "a", "alice")
    ownership_set(reg, OWN_KIND_CAPSULE, "p", "bob")
    let es = ownership_entries(reg)
    ce_eq("2 entries", len(es), 2)
    ce_eq("first is kg",
          str_eq_bytes(es[0][OWN_ENTRY_KIND], OWN_KIND_KG), 1)
    ce_eq("second is capsule",
          str_eq_bytes(es[1][OWN_ENTRY_KIND], OWN_KIND_CAPSULE), 1)
}

// ---- R60: nl.ask honors the ownership overlay for skill dispatch --------
//
// A holder whose role grants nl:ask + kg:read (reader) but doesn't
// own the 'research' skill must be refused with the SAME refusal
// shape a direct skill.run would return -- the two entrances stay
// in sync.

fn _grant_reader_with_skill_run(ctx, holder) {
    // Same as _grant_holder but the role bundle covers skill:run so
    // the reader can still hit skill.run for comparison; the ownership
    // check runs regardless of caps.
    let reg = capability_registry_new()
    let roles = list_new()
    push(roles, "skill_user")
    let t = capability_token_new_roles("tk-" + holder, holder, roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-" + holder)
    return reg
}

fn test_nl_ask_no_overlay_dispatches_normally() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "alice")
    // Seed a KG entry so the research policy has something to hit.
    let kgreg = rpc_ctx_kgreg(ctx)
    let kg = kg_get(kgreg, 0)
    kg_add_atom(kg, ATOM_FACT, "einstein", 0)
    let a = list_new()
    push(a, rpc_arg_kv("text", "what is einstein"))
    push(a, rpc_arg_kv("user_id", "alice"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("no refusal seen", _has(out, "\"refusal_reason\":\"\""))
}

fn test_nl_ask_owned_skill_refuses_other_holder() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "bob")
    // Overlay: 'research' is alice's; bob calls nl.ask.
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("text", "what is einstein"))
    push(a, rpc_arg_kv("user_id", "bob"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    // Envelope ok=true (the verb executed; the query executed; the
    // executor refused inside the ExecutionResult -- that shape is
    // what clients already handle for parse-refusals).
    ce_check("verb envelope ok",
             _has(out, "\"ok\":true"))
    ce_check("refusal shape matches skill.run",
             _has(out, "skill not accessible to bob: research"))
}

fn test_nl_ask_owned_skill_dispatches_for_owner() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let kgreg = rpc_ctx_kgreg(ctx)
    let kg = kg_get(kgreg, 0)
    kg_add_atom(kg, ATOM_FACT, "einstein", 0)
    let a = list_new()
    push(a, rpc_arg_kv("text", "what is einstein"))
    push(a, rpc_arg_kv("user_id", "alice"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    ce_check("owner dispatches",
             _has(out, "\"ok\":true"))
    ce_check("no ownership refusal for owner",
             _has(out, "\"refusal_reason\":\"\""))
}

fn test_nl_ask_admin_kinds_bypass_ownership() {
    // A "list capsules" query is an admin-delegated kind; the R60
    // gate must not fire on it (only skill-invoking kinds).
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("text", "list capsules"))
    push(a, rpc_arg_kv("user_id", "bob"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    ce_check("admin path unaffected",
             _has(out, "\"admin_action\":\"capsule_list\""))
    ce_check("no ownership refusal on admin path",
             _has(out, "\"refusal_reason\":\"\""))
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_kinds_populated()
    test_empty_overlay_owner_is_empty()
    test_set_and_owner()
    test_set_updates_existing()
    test_clear_by_empty_owner()
    test_unknown_kind_rejected()
    test_null_overlay_is_visible_to_everyone()
    test_unset_resource_visible_to_all()
    test_owned_visible_to_exact_owner_only()
    test_kg_and_capsule_kinds_are_independent()
    test_filter_preserves_order()
    test_filter_null_overlay_is_identity()
    test_kg_wrappers()
    test_capsule_wrappers()
    test_presented_holder_empty_when_no_sandbox()
    test_presented_holder_from_valid_token()
    test_presented_holder_empty_on_unknown_token()
    test_kg_list_unfiltered_when_no_overlay()
    test_kg_list_filters_by_holder()
    test_kg_list_bob_sees_only_his()
    test_kg_list_anonymous_sees_only_public()
    test_capsule_list_filters_by_holder()
    test_capsule_list_unfiltered_when_no_overlay()
    test_entries_null_returns_empty()
    test_entries_reflects_writes()
    // R60 -- nl.ask honors the ownership overlay
    test_nl_ask_no_overlay_dispatches_normally()
    test_nl_ask_owned_skill_refuses_other_holder()
    test_nl_ask_owned_skill_dispatches_for_owner()
    test_nl_ask_admin_kinds_bypass_ownership()
    ce_summary("ownership")
}

main()
