          ownership_capsule_visible(reg, "alice_pack", "bob"), 0)
}

// ---- RpcContext helper: presented holder --------------------------------

fn test_presented_holder_empty_when_no_sandbox() {
    let ctx = _mk_ctx()
    // No sandbox, no token -> anonymous.
    ce_eq("empty", len(rpc_ctx_presented_holder(ctx)), 0)
}

fn test_presented_holder_from_valid_token() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    ce_eq("resolves to alice",
          str_eq_bytes(rpc_ctx_presented_holder(ctx), "alice"), 1)
}

fn test_presented_holder_empty_on_unknown_token() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "no-such-token")
    ce_eq("empty (unknown token)", len(rpc_ctx_presented_holder(ctx)), 0)
}

// ---- wire integration: kg.list ------------------------------------------

fn test_kg_list_unfiltered_when_no_overlay() {
    // Overlay slot 0 -> backward-compat: every KG visible regardless.
    let ctx = _mk_ctx()
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world",           _has(out, "\"world\""))
    ce_check("alice_notebook",  _has(out, "\"alice_notebook\""))
    ce_check("bob_notebook",    _has(out, "\"bob_notebook\""))
}

fn test_kg_list_filters_by_holder() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_notebook", "alice")
    ownership_set_kg(overlay, "bob_notebook",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world (public) visible",         _has(out, "\"world\""))
    ce_check("alice_notebook visible to alice", _has(out, "\"alice_notebook\""))
    ce_eq("bob_notebook HIDDEN from alice",
          _has(out, "\"bob_notebook\""), 0)
}

fn test_kg_list_bob_sees_only_his() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_notebook", "alice")
    ownership_set_kg(overlay, "bob_notebook",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world visible",              _has(out, "\"world\""))
    ce_check("bob_notebook visible to bob", _has(out, "\"bob_notebook\""))
    ce_eq("alice_notebook HIDDEN from bob",
          _has(out, "\"alice_notebook\""), 0)
}

fn test_kg_list_anonymous_sees_only_public() {
    let ctx = _mk_ctx()
    // No token grant -- anonymous caller under an overlay.
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_notebook", "alice")
    ownership_set_kg(overlay, "bob_notebook",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("world (unset) visible", _has(out, "\"world\""))
    ce_eq("alice_notebook hidden",    _has(out, "\"alice_notebook\""), 0)
    ce_eq("bob_notebook hidden",      _has(out, "\"bob_notebook\""), 0)
}

// ---- wire integration: capsule.list ------------------------------------

fn test_capsule_list_filters_by_holder() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_capsule(overlay, "alice_private", "alice")
    ownership_set_capsule(overlay, "bob_private",   "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("public_pack visible",      _has(out, "\"name\":\"public_pack\""))
    ce_check("alice_private visible to alice",
             _has(out, "\"name\":\"alice_private\""))
    ce_eq("bob_private HIDDEN from alice",
          _has(out, "\"name\":\"bob_private\""), 0)
}

fn test_capsule_list_unfiltered_when_no_overlay() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("public_pack visible",    _has(out, "\"name\":\"public_pack\""))
    ce_check("alice_private visible",  _has(out, "\"name\":\"alice_private\""))
    ce_check("bob_private visible",    _has(out, "\"name\":\"bob_private\""))
}

// ---- ownership_entries surface ------------------------------------------

fn test_entries_null_returns_empty() {
    ce_eq("null -> empty", len(ownership_entries(0)), 0)
}

fn test_entries_reflects_writes() {
    let reg = ownership_registry_new()
    ownership_set(reg, OWN_KIND_KG, "a", "alice")
    ownership_set(reg, OWN_KIND_CAPSULE, "p", "bob")
    let es = ownership_entries(reg)
    ce_eq("2 entries", len(es), 2)
    ce_eq("first is kg",
          str_eq_bytes(es[0][OWN_ENTRY_KIND], OWN_KIND_KG), 1)
    ce_eq("second is capsule",
          str_eq_bytes(es[1][OWN_ENTRY_KIND], OWN_KIND_CAPSULE), 1)
}

// ---- R60: nl.ask honors the ownership overlay for skill dispatch --------
//
// A holder whose role grants nl:ask + kg:read (reader) but doesn't
// own the 'research' skill must be refused with the SAME refusal
// shape a direct skill.run would return -- the two entrances stay
// in sync.

fn _grant_reader_with_skill_run(ctx, holder) {
    // Same as _grant_holder but the role bundle covers skill:run so
    // the reader can still hit skill.run for comparison; the ownership
    // check runs regardless of caps.
    let reg = capability_registry_new()
    let roles = list_new()
    push(roles, "skill_user")
    let t = capability_token_new_roles("tk-" + holder, holder, roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-" + holder)
    return reg
}

fn test_nl_ask_no_overlay_dispatches_normally() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "alice")
    // Seed a KG entry so the research policy has something to hit.
    let kgreg = rpc_ctx_kgreg(ctx)
    let kg = kg_get(kgreg, 0)
    kg_add_atom(kg, ATOM_FACT, "einstein", 0)
    let a = list_new()
    push(a, rpc_arg_kv("text", "what is einstein"))
    push(a, rpc_arg_kv("user_id", "alice"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("no refusal seen", _has(out, "\"refusal_reason\":\"\""))
}

fn test_nl_ask_owned_skill_refuses_other_holder() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "bob")
    // Overlay: 'research' is alice's; bob calls nl.ask.
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("text", "what is einstein"))
    push(a, rpc_arg_kv("user_id", "bob"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    // Envelope ok=true (the verb executed; the query executed; the
    // executor refused inside the ExecutionResult -- that shape is
    // what clients already handle for parse-refusals).
    ce_check("verb envelope ok",
             _has(out, "\"ok\":true"))
    ce_check("refusal shape matches skill.run",
             _has(out, "skill not accessible to bob: research"))
}

fn test_nl_ask_owned_skill_dispatches_for_owner() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let kgreg = rpc_ctx_kgreg(ctx)
    let kg = kg_get(kgreg, 0)
    kg_add_atom(kg, ATOM_FACT, "einstein", 0)
    let a = list_new()
    push(a, rpc_arg_kv("text", "what is einstein"))
    push(a, rpc_arg_kv("user_id", "alice"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    ce_check("owner dispatches",
             _has(out, "\"ok\":true"))
    ce_check("no ownership refusal for owner",
             _has(out, "\"refusal_reason\":\"\""))
}

fn test_nl_ask_admin_kinds_bypass_ownership() {
    // A "list capsules" query is an admin-delegated kind; the R60
    // gate must not fire on it (only skill-invoking kinds).
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("text", "list capsules"))
    push(a, rpc_arg_kv("user_id", "bob"))
    let out = rpc_dispatch("nl.ask", a, ctx)
    ce_check("admin path unaffected",
             _has(out, "\"admin_action\":\"capsule_list\""))
    ce_check("no ownership refusal on admin path",
             _has(out, "\"refusal_reason\":\"\""))
}

// ---- R64: skill.run wire thread through coding_helper --------------

fn _install_coding_helper(ctx) {
    // Register + install coding_helper into the ctx's skill_registry
    // so `skill.run coding_helper` reaches the R64 scoped policy.
    let sr = rpc_ctx_skill_reg(ctx)
    let m = coding_helper_manifest()
    skill_registry_register(sr, m)
    let sup = skill_supervisor_new(m, rpc_ctx_kgreg(ctx),
                                    rpc_ctx_capreg(ctx), 0, 0,
                                    rpc_ctx_mo(ctx), 100)
    skill_registry_install(sr, "coding_helper", rpc_ctx_capreg(ctx),
                            sup, 100)
    return sup
}

fn test_skill_run_wire_alice_owner_matches() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "debug_common", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    _install_coding_helper(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("name", "coding_helper"))
    push(a, rpc_arg_kv("arg",  "help me debug a null pointer exception"))
    let out = rpc_dispatch("skill.run", a, ctx)
    ce_check("verb ok",  _has(out, "\"ok\":true"))
    ce_check("alice sees NULL deref advice",
             _has(out, "NULL deref"))
}

fn test_skill_run_wire_bob_non_owner_gets_no_matches() {
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "debug_common", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    _install_coding_helper(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("name", "coding_helper"))
    push(a, rpc_arg_kv("arg",  "help me debug a null pointer exception"))
    let out = rpc_dispatch("skill.run", a, ctx)
    ce_check("wire envelope still ok",
             _has(out, "\"ok\":true"))
    ce_check("bob does NOT see NULL deref",
             _has(out, "NULL deref") == 0)
    ce_check("bob's proposal contains the 'no match' hint",
             _has(out, "no debug pattern matched"))
    // Confidence collapses to 0 for a no-match run.
    ce_check("confidence 0",
             _has(out, "\"confidence\":0"))
}

fn test_skill_run_wire_no_overlay_matches_everyone() {
    // No overlay wired -> R47-R63 behavior: bob still sees the match.
    let ctx = _mk_ctx()
    _grant_reader_with_skill_run(ctx, "bob")
    _install_coding_helper(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("name", "coding_helper"))
    push(a, rpc_arg_kv("arg",  "help me debug a null pointer exception"))
    let out = rpc_dispatch("skill.run", a, ctx)
    ce_check("bob sees NULL deref without overlay",
             _has(out, "NULL deref"))
}

// ---- R70: capsule.install + skill.install auto-assign ownership ------

fn _grant_admin(ctx, holder) {
    // Admin token so capsule:install / skill:install caps are satisfied.
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "admin")
    let t = capability_token_new_roles("tk-" + holder, holder, roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-" + holder)
    return reg
}

fn test_capsule_install_no_overlay_owner_empty() {
    // Baseline: no overlay -> owner field is empty string, no error.
    let ctx = _mk_ctx()
    _grant_admin(ctx, "alice")
    let a = list_new()
    push(a, rpc_arg_kv("name", "public_pack"))
    let out = rpc_dispatch("capsule.install", a, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("owner empty",     _has(out, "\"owner\":\"\""))
}

fn test_capsule_install_wired_overlay_stamps_owner() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "public_pack"))
    let out = rpc_dispatch("capsule.install", a, ctx)
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("owner stamped to alice", _has(out, "\"owner\":\"alice\""))
    // Overlay actually got the entry.
    ce_str_eq("overlay records alice",
              ownership_owner(overlay, OWN_KIND_CAPSULE, "public_pack"),
              "alice")
}

fn test_capsule_install_anonymous_leaves_owner_empty() {
    // Sandbox off (no token presented) -> presented_holder is ""
    // -> even with wired overlay, no stamp.
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "public_pack"))
    let out = rpc_dispatch("capsule.install", a, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("owner empty",     _has(out, "\"owner\":\"\""))
    ce_eq("overlay untouched",
          len(ownership_owner(overlay, OWN_KIND_CAPSULE, "public_pack")), 0)
}

fn test_capsule_install_owner_can_reinstall() {
    // Alice installs, alice re-installs -> idempotent no-op (still ok).
    let ctx = _mk_ctx()
    _grant_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "public_pack"))
    rpc_dispatch("capsule.install", a, ctx)
    let out = rpc_dispatch("capsule.install", a, ctx)
    ce_check("re-install ok",           _has(out, "\"ok\":true"))
    ce_check("owner still alice",       _has(out, "\"owner\":\"alice\""))
}

fn test_capsule_install_cross_holder_refused() {
    // Alice installs; bob tries to install the same capsule name ->
    // refused with a clear message; overlay's owner unchanged.
    let ctx_a = _mk_ctx()
    _grant_admin(ctx_a, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx_a, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "public_pack"))
    rpc_dispatch("capsule.install", a, ctx_a)
    // Bob's ctx (share the overlay + capsule registry via ing_agent
    // pattern -- easiest is a fresh _mk_ctx and rewiring the same
    // overlay).
    let ctx_b = _mk_ctx()
    _grant_admin(ctx_b, "bob")
    rpc_ctx_set_ownership(ctx_b, overlay)
    let a2 = list_new()
    push(a2, rpc_arg_kv("name", "public_pack"))
    let out = rpc_dispatch("capsule.install", a2, ctx_b)
    ce_check("refused",
             _has(out, "already owned by alice"))
    // Alice remains the owner.
    ce_str_eq("owner still alice",
              ownership_owner(overlay, OWN_KIND_CAPSULE, "public_pack"),
              "alice")
}

// ---- R70: skill.install auto-assigns ownership ---------------------

fn _install_ready_ctx() {
    // A ctx pre-wired with the research skill's manifest registered
    // so the pre-anchored install path has something to install.
    let ctx = _mk_ctx()
    let sr = rpc_ctx_skill_reg(ctx)
    skill_registry_register(sr, research_skill_manifest())
    return ctx
}

fn test_skill_install_no_overlay_owner_empty() {
    let ctx = _install_ready_ctx()
    _grant_admin(ctx, "alice")
    let a = list_new()
    push(a, rpc_arg_kv("name", "research"))
    let out = rpc_dispatch("skill.install", a, ctx)
    ce_check("ok",           _has(out, "\"ok\":true"))
    ce_check("owner empty",  _has(out, "\"owner\":\"\""))
}

fn test_skill_install_wired_overlay_stamps_owner() {
    let ctx = _install_ready_ctx()
    _grant_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "research"))
    let out = rpc_dispatch("skill.install", a, ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("owner is alice",    _has(out, "\"owner\":\"alice\""))
    ce_str_eq("overlay records alice",
              ownership_owner(overlay, OWN_KIND_SKILL, "research"),
              "alice")
}

fn test_skill_install_cross_holder_refused_before_install() {
    let ctx_a = _install_ready_ctx()
    _grant_admin(ctx_a, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx_a, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "research"))
    rpc_dispatch("skill.install", a, ctx_a)
    // Bob attempts install -- must be refused.
    let ctx_b = _install_ready_ctx()
    _grant_admin(ctx_b, "bob")
    rpc_ctx_set_ownership(ctx_b, overlay)
    let a2 = list_new()
    push(a2, rpc_arg_kv("name", "research"))
    let out = rpc_dispatch("skill.install", a2, ctx_b)
    ce_check("cross-holder refused",
             _has(out, "already owned by alice"))
    // Overlay unchanged.
    ce_str_eq("owner still alice",
              ownership_owner(overlay, OWN_KIND_SKILL, "research"),
              "alice")
}

fn test_skill_install_owner_reinstall_idempotent() {
    let ctx = _install_ready_ctx()
    _grant_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "research"))
    rpc_dispatch("skill.install", a, ctx)
    let out = rpc_dispatch("skill.install", a, ctx)
    ce_check("re-install ok",     _has(out, "\"ok\":true"))
    ce_check("still owns",        _has(out, "\"owner\":\"alice\""))
}

// End-to-end integration: capsule.install auto-assigns ownership,
// then capsule.list correctly filters by that ownership.
fn test_capsule_install_then_list_filters_by_owner() {
    let overlay = ownership_registry_new()
    let ctx_a = _mk_ctx()
    _grant_admin(ctx_a, "alice")
    rpc_ctx_set_ownership(ctx_a, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("name", "public_pack"))
    rpc_dispatch("capsule.install", a, ctx_a)
    // Bob calls capsule.list -- must NOT see alice's public_pack.
    let ctx_b = _mk_ctx()
    _grant_admin(ctx_b, "bob")
    rpc_ctx_set_ownership(ctx_b, overlay)
    let out_b = rpc_dispatch("capsule.list", list_new(), ctx_b)
    ce_check("bob does NOT see public_pack",
             _has(out_b, "\"name\":\"public_pack\"") == 0)
    // Alice DOES see it.
    let out_a = rpc_dispatch("capsule.list", list_new(), ctx_a)
    ce_check("alice still sees public_pack",
             _has(out_a, "\"name\":\"public_pack\""))
}

// ---- R72: ownership.list + ownership.transfer wire verbs -----------

fn _seed_overlay() {
    let o = ownership_registry_new()
    ownership_set_kg(o,       "alice_kg",       "alice")
    ownership_set_kg(o,       "bob_kg",         "bob")
    ownership_set_capsule(o,  "alice_pack",     "alice")
    ownership_set_capsule(o,  "shared_pack",    "alice")
    ownership_set_skill(o,    "alice_skill",    "alice")
    ownership_set_pattern(o,  "alice_patterns", "alice")
    return o
}

fn test_r72_verbs_registered() {
    let names = rpc_verb_names()
    let saw_list = 0
    let saw_transfer = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "ownership.list")     == 1 { saw_list = 1 }
        if str_eq_bytes(names[i], "ownership.transfer") == 1 { saw_transfer = 1 }
        i = i + 1
    }
    ce_eq("ownership.list registered",     saw_list, 1)
    ce_eq("ownership.transfer registered", saw_transfer, 1)
}

fn test_r72_verbs_capped_admin_sandbox() {
    ce_eq("list cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("ownership.list"),
                       CAP_ADMIN_SANDBOX), 1)
    ce_eq("transfer cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("ownership.transfer"),
                       CAP_ADMIN_SANDBOX), 1)
}

fn test_r72_no_overlay_refuses() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    // No rpc_ctx_set_ownership -> overlay is 0.
    let out = rpc_dispatch("ownership.list", list_new(), ctx)
    ce_check("list refused w/o overlay",
             _has(out, "no ownership overlay in context"))
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "kg"))
    push(a, rpc_arg_kv("name",      "x"))
    push(a, rpc_arg_kv("new_owner", "y"))
    let out2 = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("transfer refused w/o overlay",
             _has(out2, "no ownership overlay in context"))
}

fn test_r72_reader_refused_by_cap() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")     // reader-only role
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let out = rpc_dispatch("ownership.list", list_new(), ctx)
    ce_check("reader refused",
             _has(out, "capability required: admin:sandbox"))
}

fn test_r72_list_returns_all_entries_when_no_filter() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let out = rpc_dispatch("ownership.list", list_new(), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("has alice_kg",          _has(out, "\"name\":\"alice_kg\""))
    ce_check("has bob_kg",            _has(out, "\"name\":\"bob_kg\""))
    ce_check("has alice_pack",        _has(out, "\"name\":\"alice_pack\""))
    ce_check("has alice_skill",       _has(out, "\"name\":\"alice_skill\""))
    ce_check("has alice_patterns",    _has(out, "\"name\":\"alice_patterns\""))
    ce_check("all entries carry kind",   _has(out, "\"kind\":\"kg\""))
    ce_check("kind capsule present",     _has(out, "\"kind\":\"capsule\""))
    ce_check("kind skill present",       _has(out, "\"kind\":\"skill\""))
    ce_check("kind pattern present",     _has(out, "\"kind\":\"pattern\""))
    // R107: paginated shape -- {entries:[...], next_after:"..."}.
    ce_check("entries field",           _has(out, "\"entries\":["))
    ce_check("next_after present",      _has(out, "\"next_after\":"))
}

fn test_r72_list_filter_by_kind() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("kind", "capsule"))
    let out = rpc_dispatch("ownership.list", a, ctx)
    ce_check("capsule shown",     _has(out, "\"name\":\"alice_pack\""))
    ce_check("shared_pack shown", _has(out, "\"name\":\"shared_pack\""))
    // KG entries filtered out.
    ce_check("alice_kg NOT shown",  _has(out, "\"name\":\"alice_kg\"") == 0)
    ce_check("alice_skill NOT shown", _has(out, "\"name\":\"alice_skill\"") == 0)
}

fn test_r72_list_filter_by_holder() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("holder", "bob"))
    let out = rpc_dispatch("ownership.list", a, ctx)
    ce_check("bob_kg shown",         _has(out, "\"name\":\"bob_kg\""))
    // Alice's entries filtered out.
    ce_check("alice_kg NOT shown",   _has(out, "\"name\":\"alice_kg\"") == 0)
    ce_check("alice_pack NOT shown", _has(out, "\"name\":\"alice_pack\"") == 0)
}

fn test_r72_list_filters_compose() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("kind",   "kg"))
    push(a, rpc_arg_kv("holder", "alice"))
    let out = rpc_dispatch("ownership.list", a, ctx)
    ce_check("alice_kg shown",       _has(out, "\"name\":\"alice_kg\""))
    ce_check("bob_kg filtered out",  _has(out, "\"name\":\"bob_kg\"") == 0)
    ce_check("alice_pack filtered",  _has(out, "\"name\":\"alice_pack\"") == 0)
}

fn test_r72_list_unknown_kind_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("kind", "bogus"))
    let out = rpc_dispatch("ownership.list", a, ctx)
    ce_check("unknown kind refused",
             _has(out, "unknown kind: bogus"))
}

fn test_r72_list_empty_overlay_returns_empty_array() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, ownership_registry_new())
    let out = rpc_dispatch("ownership.list", list_new(), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    // R107: paginated shape -- {entries:[...], next_after:"..."}.
    ce_check("empty array",     _has(out, "\"entries\":[]"))
    ce_check("next_after empty", _has(out, "\"next_after\":\"\""))
}

// ---- ownership.transfer ----------------------------------------------

fn test_r72_transfer_missing_args() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a1 = list_new()
    push(a1, rpc_arg_kv("name", "alice_kg"))
    push(a1, rpc_arg_kv("new_owner", "bob"))
    let out1 = rpc_dispatch("ownership.transfer", a1, ctx)
    ce_check("missing kind refused",
             _has(out1, "missing arg: kind"))
    let a2 = list_new()
    push(a2, rpc_arg_kv("kind", "kg"))
    push(a2, rpc_arg_kv("new_owner", "bob"))
    let out2 = rpc_dispatch("ownership.transfer", a2, ctx)
    ce_check("missing name refused",
             _has(out2, "missing arg: name"))
    let a3 = list_new()
    push(a3, rpc_arg_kv("kind", "kg"))
    push(a3, rpc_arg_kv("name", "alice_kg"))
    let out3 = rpc_dispatch("ownership.transfer", a3, ctx)
    ce_check("missing new_owner refused",
             _has(out3, "missing arg: new_owner"))
}

fn test_r72_transfer_unknown_kind_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "bogus"))
    push(a, rpc_arg_kv("name",      "x"))
    push(a, rpc_arg_kv("new_owner", "bob"))
    let out = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("unknown kind refused",
             _has(out, "unknown kind: bogus"))
}

fn test_r72_transfer_empty_name_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "kg"))
    push(a, rpc_arg_kv("name",      ""))
    push(a, rpc_arg_kv("new_owner", "bob"))
    let out = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("empty name refused",
             _has(out, "name must be non-empty"))
}

fn test_r72_transfer_fresh_resource_refused() {
    // Trying to transfer a resource that has NO existing owner
    // is refused -- transfer means hand-off, not establishment.
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "kg"))
    push(a, rpc_arg_kv("name",      "unowned_kg"))
    push(a, rpc_arg_kv("new_owner", "alice"))
    let out = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("no-existing-owner refused",
             _has(out, "cannot transfer"))
    ce_check("mentions install verb hint",
             _has(out, "use an install verb"))
}

fn test_r72_transfer_happy_path() {
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    let overlay = _seed_overlay()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "kg"))
    push(a, rpc_arg_kv("name",      "alice_kg"))
    push(a, rpc_arg_kv("new_owner", "bob"))
    let out = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("ok",                       _has(out, "\"ok\":true"))
    ce_check("kind kg",                  _has(out, "\"kind\":\"kg\""))
    ce_check("old_owner alice",          _has(out, "\"old_owner\":\"alice\""))
    ce_check("new_owner bob",            _has(out, "\"new_owner\":\"bob\""))
    ce_check("cleared false",            _has(out, "\"cleared\":false"))
    // Overlay actually got the transfer.
    ce_str_eq("overlay records bob",
              ownership_owner(overlay, OWN_KIND_KG, "alice_kg"), "bob")
}

fn test_r72_transfer_clear_to_public() {
    // new_owner="" clears the entry -- makes the resource public.
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    let overlay = _seed_overlay()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "capsule"))
    push(a, rpc_arg_kv("name",      "shared_pack"))
    push(a, rpc_arg_kv("new_owner", ""))
    let out = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("old_owner alice", _has(out, "\"old_owner\":\"alice\""))
    ce_check("new_owner empty", _has(out, "\"new_owner\":\"\""))
    ce_check("cleared true",    _has(out, "\"cleared\":true"))
    ce_eq("overlay entry cleared",
          len(ownership_owner(overlay, OWN_KIND_CAPSULE, "shared_pack")), 0)
    // A visibility check for anonymous now returns "visible" since
    // the resource is public again.
    ce_eq("public to anonymous",
          ownership_capsule_visible(overlay, "shared_pack", ""), 1)
}

fn test_r72_transfer_idempotent_same_owner() {
    // Transfer to same owner is a no-op (still ok, no state change).
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    let overlay = _seed_overlay()
    rpc_ctx_set_ownership(ctx, overlay)
    let a = list_new()
    push(a, rpc_arg_kv("kind",      "kg"))
    push(a, rpc_arg_kv("name",      "alice_kg"))
    push(a, rpc_arg_kv("new_owner", "alice"))
    let out = rpc_dispatch("ownership.transfer", a, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("old_owner alice", _has(out, "\"old_owner\":\"alice\""))
    ce_check("new_owner alice", _has(out, "\"new_owner\":\"alice\""))
    ce_str_eq("overlay unchanged",
              ownership_owner(overlay, OWN_KIND_KG, "alice_kg"), "alice")
}

fn test_r72_transfer_then_list_reflects_change() {
    // End-to-end: transfer + list see consistent state.
    let ctx = _mk_ctx()
    _grant_admin(ctx, "root")
    rpc_ctx_set_ownership(ctx, _seed_overlay())
    let ta = list_new()
    push(ta, rpc_arg_kv("kind",      "skill"))
    push(ta, rpc_arg_kv("name",      "alice_skill"))
    push(ta, rpc_arg_kv("new_owner", "carol"))
    rpc_dispatch("ownership.transfer", ta, ctx)
    // Now filter list by owner=carol and check alice_skill appears.
    let la = list_new()
    push(la, rpc_arg_kv("holder", "carol"))
    let out = rpc_dispatch("ownership.list", la, ctx)
    ce_check("carol owns alice_skill",
             _has(out, "\"name\":\"alice_skill\""))
    ce_check("carol owns 1 thing (single result in array)",
             _has(out, "\"kind\":\"skill\""))
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_kinds_populated()
    test_empty_overlay_owner_is_empty()
    test_set_and_owner()
    test_set_updates_existing()
    test_clear_by_empty_owner()
    test_unknown_kind_rejected()
    test_null_overlay_is_visible_to_everyone()
    test_unset_resource_visible_to_all()
    test_owned_visible_to_exact_owner_only()
    test_kg_and_capsule_kinds_are_independent()
    test_filter_preserves_order()
    test_filter_null_overlay_is_identity()
    test_kg_wrappers()
    test_capsule_wrappers()
    test_pattern_wrappers()
    test_presented_holder_empty_when_no_sandbox()
    test_presented_holder_from_valid_token()
    test_presented_holder_empty_on_unknown_token()
    test_kg_list_unfiltered_when_no_overlay()
    test_kg_list_filters_by_holder()
    test_kg_list_bob_sees_only_his()
    test_kg_list_anonymous_sees_only_public()
    test_capsule_list_filters_by_holder()
    test_capsule_list_unfiltered_when_no_overlay()
    test_entries_null_returns_empty()
    test_entries_reflects_writes()
    // R60 -- nl.ask honors the ownership overlay
    test_nl_ask_no_overlay_dispatches_normally()
    test_nl_ask_owned_skill_refuses_other_holder()
    test_nl_ask_owned_skill_dispatches_for_owner()
    test_nl_ask_admin_kinds_bypass_ownership()
    // R64 -- skill.run wire threads overlay into coding_helper
    test_skill_run_wire_alice_owner_matches()
    test_skill_run_wire_bob_non_owner_gets_no_matches()
    test_skill_run_wire_no_overlay_matches_everyone()
    // R70 -- capsule.install + skill.install auto-assign ownership
    test_capsule_install_no_overlay_owner_empty()
    test_capsule_install_wired_overlay_stamps_owner()
    test_capsule_install_anonymous_leaves_owner_empty()
    test_capsule_install_owner_can_reinstall()
    test_capsule_install_cross_holder_refused()
    test_skill_install_no_overlay_owner_empty()
    test_skill_install_wired_overlay_stamps_owner()
    test_skill_install_cross_holder_refused_before_install()
    test_skill_install_owner_reinstall_idempotent()
    test_capsule_install_then_list_filters_by_owner()
    // R72 -- ownership.list + ownership.transfer wire verbs
    test_r72_verbs_registered()
    test_r72_verbs_capped_admin_sandbox()
    test_r72_no_overlay_refuses()
    test_r72_reader_refused_by_cap()
    test_r72_list_returns_all_entries_when_no_filter()
    test_r72_list_filter_by_kind()
    test_r72_list_filter_by_holder()
    test_r72_list_filters_compose()
    test_r72_list_unknown_kind_refused()
    test_r72_list_empty_overlay_returns_empty_array()
    test_r72_transfer_missing_args()
    test_r72_transfer_unknown_kind_refused()
    test_r72_transfer_empty_name_refused()
    test_r72_transfer_fresh_resource_refused()
    test_r72_transfer_happy_path()
    test_r72_transfer_clear_to_public()
    test_r72_transfer_idempotent_same_owner()
    test_r72_transfer_then_list_reflects_change()
    ce_summary("ownership")
}

main()
