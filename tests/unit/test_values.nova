// Unit tests for src/parts/soul/values.nova
// Verifies adding/updating values and lookups. ADR-0034.

import "../ce_test.nova"
import "../../src/parts/soul/values.nova"

fn test_values() {
    let s = soul_new("A")
    ce_eq("empty", soul_value_count(s), 0)
    soul_add_value(s, "truth", "never fabricate")
    soul_add_value(s, "kindness", "consider impact")
    ce_eq("two values", soul_value_count(s), 2)
    ce_str_eq("lookup", soul_value(s, "truth"), "never fabricate")
    ce_eq("has value", soul_has_value(s, "kindness"), 1)
    ce_eq("missing value", soul_has_value(s, "greed"), 0)
    ce_str_eq("missing -> empty", soul_value(s, "greed"), "")
    // Updating an existing value does not duplicate.
    soul_add_value(s, "truth", "be precise")
    ce_eq("no duplicate", soul_value_count(s), 2)
    ce_str_eq("updated principle", soul_value(s, "truth"), "be precise")
}

fn main() {
    test_values()
    ce_summary("values")
}

main()
