// Unit tests for R105 -- Phase G multimodal ingest.file wire dispatch
// (src/nl/rpc_verbs.nova _rpc_verb_ingest_file for image / audio /
// video formats).
//
// Covers:
//   * verb still registered (regression from R66-R85)
//   * unsupported format "hologram" refused with a message naming
//     the R105 supported-formats list
//   * format=image via body_hex ingests without error (response reports
//     ok:true + records_ingested >= 1 + atoms_added > 0)
//   * format=audio via body_hex ingests without error
//   * format=video via ASCII body (Y4M is 7-bit) ingests without error
//   * body + body_hex both present -> ambiguous refusal
//   * neither body nor body_hex -> missing-body refusal
//   * malformed hex -> hex refusal
//   * reader token refused by cap gate

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/ingest/review_queue.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    let agent = ing_agent_new()
    kg_spawn(ing_kgreg(agent), "visual")
    kg_spawn(ing_kgreg(agent), "auditory")
    // Trust perceptual sources so they land direct in the KG rather
    // than queue for review.
    ing_agent_trust_prefix(agent, "src:image:")
    ing_agent_trust_prefix(agent, "src:audio:")
    ing_agent_trust_prefix(agent, "src:video:")
    let ctx = rpc_ctx_new(ing_kgreg(agent), capreg_new(),
                           persona_registry_new(),
                           skill_registry_new(),
                           ing_mo(agent),
                           agent,
                           ing_queue(agent),
                           100)
    return ctx
}

fn _grant_admin(ctx) {
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "admin")
    let t = capability_token_new_roles("tk-a", "root", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-a")
    return reg
}

fn _grant_reader(ctx) {
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    return reg
}

// ---- hex-encoding helpers -------------------------------------------------
//
// NOVA strings truncate at chr(0) so binary bodies must ride the wire's
// `body_hex` argument.

fn _hex_nib(n) {
    if n < 10 { return n + 48 }
    return n + 87
}

fn _bl_to_hex(bl) {
    let s = ""
    let i = 0
    while i < len(bl) {
        let b = bl[i]
        s = s + chr(_hex_nib(int_and(int_shr(b, 4), 15)))
        s = s + chr(_hex_nib(int_and(b, 15)))
        i = i + 1
    }
    return s
}

fn _pu16_le(bl, v) {
    push(bl, int_and(v, 255))
    push(bl, int_and(int_shr(v, 8), 255))
}

fn _pu32_le(bl, v) {
    push(bl, int_and(v, 255))
    push(bl, int_and(int_shr(v,  8), 255))
    push(bl, int_and(int_shr(v, 16), 255))
    push(bl, int_and(int_shr(v, 24), 255))
}

fn _mk_png_body_hex() {
    let bl = list_new()
    push(bl, 137) push(bl, 80) push(bl, 78) push(bl, 71)
    push(bl, 13) push(bl, 10) push(bl, 26) push(bl, 10)
    push(bl, 0) push(bl, 0) push(bl, 0) push(bl, 13)
    push(bl, 73) push(bl, 72) push(bl, 68) push(bl, 82)
    push(bl, 0) push(bl, 0) push(bl, 0) push(bl, 1)
    push(bl, 0) push(bl, 0) push(bl, 0) push(bl, 1)
    push(bl, 8) push(bl, 0)
    push(bl, 0) push(bl, 0) push(bl, 0)
    push(bl, 0) push(bl, 0) push(bl, 0) push(bl, 0)
    return _bl_to_hex(bl)
}

fn _mk_wav_body_hex() {
    let bl = list_new()
    push(bl, 82) push(bl, 73) push(bl, 70) push(bl, 70)
    _pu32_le(bl, 36 + 8)
    push(bl, 87) push(bl, 65) push(bl, 86) push(bl, 69)
    push(bl, 102) push(bl, 109) push(bl, 116) push(bl, 32)
    _pu32_le(bl, 16)
    _pu16_le(bl, 1)
    _pu16_le(bl, 1)
    _pu32_le(bl, 16000)
    _pu32_le(bl, 32000)
    _pu16_le(bl, 2) _pu16_le(bl, 16)
    push(bl, 100) push(bl, 97) push(bl, 116) push(bl, 97)
    _pu32_le(bl, 8)
    let i = 0
    while i < 8 { push(bl, 0)  i = i + 1 }
    return _bl_to_hex(bl)
}

fn _mk_y4m_body() {
    return "YUV4MPEG2 W2 H2 F30:1\n"
}

// ---- tests -----------------------------------------------------------------

fn test_verb_still_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "ingest.file") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("ingest.file registered", saw, 1)
}

fn test_unsupported_format_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("format", "hologram"))
    push(a, rpc_arg_kv("body",   "junk"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("hologram refused w/ unsupported format",
             _has(out, "unsupported format: hologram"))
    ce_check("refusal names R105", _has(out, "R105"))
    ce_check("refusal names image", _has(out, "image"))
    ce_check("refusal names audio", _has(out, "audio"))
    ce_check("refusal names video", _has(out, "video"))
    // The 10 pre-existing formats stay named too so operator surface is
    // discoverable in one shot.
    ce_check("refusal names cerec", _has(out, "cerec"))
    ce_check("refusal names yaml",  _has(out, "yaml"))
}

fn test_image_body_hex_ingests() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let hex = _mk_png_body_hex()
    ce_check("PNG body_hex non-empty", len(hex) > 0)
    let a = list_new()
    push(a, rpc_arg_kv("format",   "image"))
    push(a, rpc_arg_kv("body_hex", hex))
    push(a, rpc_arg_kv("kg",       "visual"))
    push(a, rpc_arg_kv("source",   "src:image:wire:test:v1"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("image ingest ok", _has(out, "\"ok\":true"))
    ce_check("format echoed",   _has(out, "\"format\":\"image\""))
    // A well-formed 1x1 PNG produces one record with 6 atoms (root + 5
    // metadata siblings); the trust prefix routes it straight through.
    ce_check("records_ingested 1",
             _has(out, "\"records_ingested\":1"))
    ce_check("atoms_added > 0 (perc:image root + meta)",
             _has(out, "\"atoms_added\":6"))
}

fn test_audio_body_hex_ingests() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let hex = _mk_wav_body_hex()
    let a = list_new()
    push(a, rpc_arg_kv("format",   "audio"))
    push(a, rpc_arg_kv("body_hex", hex))
    push(a, rpc_arg_kv("kg",       "auditory"))
    push(a, rpc_arg_kv("source",   "src:audio:wire:test:v1"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("audio ingest ok",  _has(out, "\"ok\":true"))
    ce_check("format audio",     _has(out, "\"format\":\"audio\""))
    ce_check("records_ingested 1",
             _has(out, "\"records_ingested\":1"))
    // 44-byte WAV: root + 7 metadata siblings.
    ce_check("atoms_added 8",
             _has(out, "\"atoms_added\":8"))
}

fn test_video_body_ascii_ingests() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let body = _mk_y4m_body()
    let a = list_new()
    push(a, rpc_arg_kv("format", "video"))
    push(a, rpc_arg_kv("body",   body))
    push(a, rpc_arg_kv("kg",     "visual"))
    push(a, rpc_arg_kv("source", "src:video:wire:test:v1"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("video ingest ok",  _has(out, "\"ok\":true"))
    ce_check("format video",     _has(out, "\"format\":\"video\""))
    ce_check("records_ingested 1",
             _has(out, "\"records_ingested\":1"))
    // Y4M header-only: root + 7 metadata siblings.
    ce_check("atoms_added 8",
             _has(out, "\"atoms_added\":8"))
}

fn test_body_and_body_hex_both_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("format",   "image"))
    push(a, rpc_arg_kv("body",     "junk"))
    push(a, rpc_arg_kv("body_hex", "0011"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("ambiguous refused", _has(out, "ambiguous"))
}

fn test_neither_body_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("format", "image"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("missing body refused", _has(out, "missing arg: body"))
}

fn test_bad_hex_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("format",   "image"))
    push(a, rpc_arg_kv("body_hex", "not-valid-hex-string"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("malformed hex refused", _has(out, "malformed hex"))
}

fn test_reader_refused_on_image() {
    let ctx = _mk_ctx()
    _grant_reader(ctx)
    let a = list_new()
    push(a, rpc_arg_kv("format",   "image"))
    push(a, rpc_arg_kv("body_hex", _mk_png_body_hex()))
    push(a, rpc_arg_kv("kg",       "visual"))
    push(a, rpc_arg_kv("source",   "src:image:alice:v1"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("reader refused by cap gate",
             _has(out, "capability required: ingest:decide"))
}

fn test_ownership_stamping_on_image() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    rpc_ctx_set_presented_holder(ctx, "alice")
    let a = list_new()
    push(a, rpc_arg_kv("format",   "image"))
    push(a, rpc_arg_kv("body_hex", _mk_png_body_hex()))
    push(a, rpc_arg_kv("kg",       "visual"))
    push(a, rpc_arg_kv("source",   "src:image:alice:v1"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("image ingest ok w/ overlay", _has(out, "\"ok\":true"))
    // The R71 ownership pre-pass stamps the visual KG to alice.
    let owner = ownership_owner(overlay, OWN_KIND_KG, "visual")
    ce_str_eq("alice owns visual KG after her image lands", owner, "alice")
    // Wire echo confirms the stamp count.
    ce_check("kgs_stamped 1 echoed",
             _has(out, "\"kgs_stamped\":1"))
}

fn main() {
    // R105 wire tests. The perceptual importer + register + doc paths
    // are separately covered by test_perceptual_capsule (61 checks),
    // test_image_records (38), test_audio_records (31),
    // test_video_records (35), test_ingest_source_registry (38 with
    // the R105 additions). These wire tests exercise the dispatch
    // through rpc_verbs.nova + the R71 ownership pre-pass.
    test_verb_still_registered()
    test_unsupported_format_refused()
    test_neither_body_refused()
    test_bad_hex_refused()
    test_body_and_body_hex_both_refused()
    test_reader_refused_on_image()
    test_video_body_ascii_ingests()
    test_image_body_hex_ingests()
    test_audio_body_hex_ingests()
    test_ownership_stamping_on_image()
    ce_summary("ingest_file_multimodal")
}

main()
