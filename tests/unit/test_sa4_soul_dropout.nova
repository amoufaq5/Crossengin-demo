// CE_TEST_TIMEOUT: 240
// Unit tests for src/learning/sa4_soul.nova (SecAgg v4 soul state machine,
// A2.2a): full in-memory rounds through tests/sa4_harness.nova.
//
// - N = 5, t = 4, one soul drops after sending its shares (in U2, not U3):
//   s-shares are revealed for it and its pairwise masks cancel.
// Ed25519 dominates the cost (~0.5 s per signature, ~0.9 s per check);
// the shared vcache makes repeats free.

import "../ce_test.nova"
import "../sa4_harness.nova"

fn _count_prefix(lines, p) {
    return len(sa4h_filter(lines, p))
}

fn test_dropout_after_shares(vc) {
    let roster = sa4h_roster(5)
    ce_eq("t=4 for N=5", sroster_t(roster), 4)
    let souls = sa4h_souls(roster, 5, 9, vc, 0)
    let res = sa4h_run(roster, souls, 9, 0 - 1, 2)
    ce_eq("N=5 drop-after-shares completes", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("aggregate over U3 equals the sum of their inputs", res[2], 1)
    let rv = res[6]
    ce_eq("4 revealers x 5 souls in U2", len(rv), 20)
    ce_eq("s-shares revealed only about the dropped soul", len(sa4h_filter(rv, "SA4_REVEAL 9 7 65536 s")), 1)
    ce_eq("no b-share about the dropped soul", len(sa4h_filter(rv, "SA4_REVEAL 9 7 65536 b")), 0)
    ce_eq("dropped soul is masked, not done", sa4s_state(souls[2]), SA4S_ST_MASKED)
    ce_eq("b_u, s_u, c_u and mask seeds wiped after R2", sa4h_wiped(souls[2]), 1)
    return 0
}

fn main() {
    let vc = list_new()
    test_dropout_after_shares(vc)
    ce_summary("sa4_soul_dropout")
}

main()
