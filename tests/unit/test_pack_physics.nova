// End-to-end test: ingest data/packs/physics.cerec and verify shape.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn test_physics_pack_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec", "data/packs/physics.cerec",
                          "physics", "src:pack:physics:v1", "", 0)
    ce_eq("1 record", ing_sum_ok(s), 1)
    ce_eq("35 atoms added", ing_sum_atoms(s), 35)
    ce_eq("0 parse errors", ing_sum_errors(s), 0)
    ce_eq("0 queued", ing_sum_queued(s), 0)
}

fn test_physics_agrees_with_solar_system() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/solar_system.cerec",
                  "astronomy", "src:pack:solar_system:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/physics.cerec",
                  "physics", "src:pack:physics:v1", "", 0)
    // Both packs list sun, earth, jupiter, planet, star at high belief.
    // With spread threshold 200, physics + astronomy should NOT produce
    // conflicts on those shared labels (both agree at 950+).
    let conflicts = mkgc_scan_conflicts(ing_kgreg(a), 200)
    let disagreed = 0
    let i = 0
    while i < len(conflicts) {
        let c = conflicts[i]
        let kg_a = mkgc_conflict_kg_a(c)
        let kg_b = mkgc_conflict_kg_b(c)
        let is_ap = 0
        if str_eq_bytes(kg_a, "astronomy") == 1 { if str_eq_bytes(kg_b, "physics") == 1 { is_ap = 1 } }
        if str_eq_bytes(kg_a, "physics") == 1 { if str_eq_bytes(kg_b, "astronomy") == 1 { is_ap = 1 } }
        if is_ap == 1 { disagreed = disagreed + 1 }
        i = i + 1
    }
    ce_eq("physics + astronomy agree on shared labels", disagreed, 0)
}

fn test_physics_contradicts_folk_astronomy() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/physics.cerec",
                  "physics", "src:pack:physics:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/folk_astronomy.cerec",
                  "folk_astronomy", "src:pack:folk_astronomy:v1", "", 0)
    // physics (sun=1000) vs folk_astronomy (sun=200) MUST surface.
    let conflicts = mkgc_scan_conflicts(ing_kgreg(a), 200)
    let saw_sun_conflict = 0
    let i = 0
    while i < len(conflicts) {
        let c = conflicts[i]
        if str_eq_bytes(mkgc_conflict_label(c), "sun") == 1 {
            let kg_a = mkgc_conflict_kg_a(c)
            let kg_b = mkgc_conflict_kg_b(c)
            let touches_physics = 0
            let touches_folk = 0
            if str_eq_bytes(kg_a, "physics") == 1 { touches_physics = 1 }
            if str_eq_bytes(kg_b, "physics") == 1 { touches_physics = 1 }
            if str_eq_bytes(kg_a, "folk_astronomy") == 1 { touches_folk = 1 }
            if str_eq_bytes(kg_b, "folk_astronomy") == 1 { touches_folk = 1 }
            if touches_physics == 1 { if touches_folk == 1 { saw_sun_conflict = 1 } }
        }
        i = i + 1
    }
    ce_eq("physics <-> folk sun conflict surfaced", saw_sun_conflict, 1)
}

fn main() {
    test_physics_pack_ingests_cleanly()
    test_physics_agrees_with_solar_system()
    test_physics_contradicts_folk_astronomy()
    ce_summary("pack_physics")
}

main()
