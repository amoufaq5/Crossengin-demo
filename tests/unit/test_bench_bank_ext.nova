// Unit tests for src/bench/bench_bank_ext.nova: the EXTENDED reasoning benchmark
// bank. Asserts the same load-bearing soundness property as the default bank, on
// a larger and more diverse sample: every provable theorem is proven with a
// kernel-checked proof, every non-theorem is refused, and ZERO false proofs are
// produced. A regression in any proof object (so it fails to verify) would move
// the proven/refused counts or, worse, surface a false proof -- both caught here.

import "../ce_test.nova"
import "../../src/bench/bench_bank_ext.nova"

// The extended bank scores perfectly and SOUND. Counts are exactly what the bank
// builds: 26 items = 19 provable (arithmetic + propositional + first-order, each
// with a valid proof) + 7 unprovable (false equalities, inexact division, non-
// entailed goals, bogus proofs), all correctly adjudicated.
fn test_ext_bank_is_perfect_and_sound() {
    let reg = proof_registry_new()
    let s = bench_run(reg, bench_ext_bank())
    ce_eq("26 items", bench_total(s), 26)
    ce_eq("19 proven (with machine-checked proofs)", bench_proven(s), 19)
    ce_eq("7 refused (honest abstention)", bench_refused(s), 7)
    ce_eq("all 26 correct", bench_correct(s), 26)
    ce_eq("accuracy 1000 milli", bench_accuracy(s), 1000)
    ce_eq("zero missed (no theorem refused)", bench_missed(s), 0)
    // THE load-bearing assertion: never proved a non-theorem.
    ce_eq("ZERO false proofs", bench_false_proofs(s), 0)
    ce_eq("benchmark reports SOUND", bench_is_sound(s), 1)
}

// The one-call report entry produces a non-empty rendered scorecard.
fn test_ext_report_non_empty() {
    ce_check("ext report non-empty", len(bench_ext_report()) > 0)
}

fn main() {
    test_ext_bank_is_perfect_and_sound()
    test_ext_report_non_empty()
    ce_summary("bench_bank_ext")
}

main()
