// CE_TEST_TIMEOUT: 240
// Refusal tests for src/learning/sa4_soul.nova (A2.2a) that need N = 5,
// t = 4, because with N = t the subset and membership checks are
// unreachable (test_sa4_soul_refuse covers the rest with N = 3). The
// victim is soul x = 1 (id 7). Each case asserts the abort code and the
// reason, so a refusal from a different check does not count.
//   - not in U1/U2/U3/U4; U2 not a subset of U1; U3 not a subset of U2;
//     U4 not a subset of U3; a SIG3 from a soul outside U4;
//   - a share whose plaintext fields (round, x) do not match, sealed under
//     the right directional key, so only the field check can catch it;
//   - more SHARE / SIG3 lines than souls;
//   - equivocation: the coordinator shows the victim a different U2, or a
//     different U1 (so a different H1), than another soul saw. That soul's
//     consistency signature must not verify for the victim.

import "../ce_test.nova"
import "../sa4_harness.nova"

let R5 = 21

fn r5_souls(roster, vc) {
    return sa4h_souls(roster, 5, R5, vc, 0)
}

// ADV line of each soul, by index.
fn r5_advs(roster, souls) {
    let out = list_new()
    let rl = sa4h_round_line(roster, R5)
    let i = 0
    while i < len(souls) {
        push(out, sa4h_feed(souls[i], sa4h_one(rl))[1][0])
        i = i + 1
    }
    return out
}

fn r5_pick(lines, idxs) {
    let out = list_new()
    let i = 0
    while i < len(idxs) {
        push(out, lines[idxs[i]])
        i = i + 1
    }
    return out
}

fn r5_xs(idxs) {
    let out = list_new()
    let i = 0
    while i < len(idxs) {
        push(out, idxs[i] + 1)
        i = i + 1
    }
    return out
}

// Feed soul i the ADVs of the souls in idxs plus SET 1 over them; return
// its share lines.
fn r5_u1(souls, advs, i, idxs) {
    let lines = sa4h_cat(r5_pick(advs, idxs), sa4h_one(sa4w_fmt_set(R5, 1, sa4w_bitmap(r5_xs(idxs)))))
    return sa4h_filter(sa4h_feed(souls[i], lines)[1], "SA4_SHARE ")
}

// Share lines addressed to `to` from the senders in idxs.
fn r5_to(shares, to, idxs) {
    let out = list_new()
    let j = 0
    while j < len(shares) {
        let p = sa4w_parse(shares[j])
        if p[3] == to {
            let k = 0
            while k < len(idxs) {
                if p[2] == SA4H_IDS[idxs[k]] { push(out, shares[j]) }
                k = k + 1
            }
        }
        j = j + 1
    }
    return out
}

fn r5_expect(label, sl, lines, code, frag) {
    let f = sa4h_feed(sl, lines)
    ce_eq(label + ": refused", f[0], 0)
    let outs = f[1]
    let last = ""
    if len(outs) > 0 { last = outs[len(outs) - 1] }
    let want = "SA4_ABORT " + int_to_str(R5) + " 7 " + code
    ce_check(label + ": abort " + code + " (got '" + last + "')", str_eq_bytes(last, want) == 1)
    ce_check(label + ": reason '" + frag + "' (got '" + f[2] + "')", find_bytes(f[2], frag) >= 0)
    ce_eq(label + ": secrets wiped", sa4h_wiped(sl), 1)
    ce_eq(label + ": held shares wiped", sl[19], 0)
    return 0
}

// Everyone through R1 with U1 = all five; returns [souls, advs, shares].
fn r5_through_u1(roster, vc) {
    let souls = r5_souls(roster, vc)
    let advs = r5_advs(roster, souls)
    let all5 = [0, 1, 2, 3, 4]
    let shares = list_new()
    let i = 0
    while i < 5 {
        shares = sa4h_cat(shares, r5_u1(souls, advs, i, all5))
        i = i + 1
    }
    return [souls, advs, shares]
}

// The victim through R2 with the given U2 (indices); returns its Y lines.
fn r5_victim_u2(st, u2) {
    let others = list_new()
    let i = 0
    while i < len(u2) {
        if u2[i] != 0 { push(others, u2[i]) }
        i = i + 1
    }
    let lines = sa4h_cat(r5_to(st[2], 7, others), sa4h_one(sa4w_fmt_set(R5, 2, sa4w_bitmap(r5_xs(u2)))))
    return sa4h_feed(st[0][0], lines)
}

fn test_membership(roster, vc) {
    let souls = r5_souls(roster, vc)
    let advs = r5_advs(roster, souls)
    let four = [1, 2, 3, 4]
    r5_expect("not in U1", souls[0], sa4h_cat(r5_pick(advs, four), sa4h_one(sa4w_fmt_set(R5, 1, sa4w_bitmap(r5_xs(four))))), "not_in_u1", "not in U1")
    // U2 not a subset of U1: U1 = souls 1-4, SET 2 adds soul 5.
    let s2 = r5_souls(roster, vc)
    let a2 = r5_advs(roster, s2)
    r5_u1(s2, a2, 0, [0, 1, 2, 3])
    r5_expect("U2 not a subset of U1", s2[0], sa4h_one(sa4w_fmt_set(R5, 2, sa4w_bitmap([1, 2, 3, 4, 5]))), "bad_set", "not a subset of U1")
    let st = r5_through_u1(roster, vc)
    r5_expect("not in U2", st[0][0], sa4h_cat(r5_to(st[2], 7, [1, 2, 3, 4]), sa4h_one(sa4w_fmt_set(R5, 2, sa4w_bitmap([2, 3, 4, 5])))), "not_in_u2", "not in U2")
    let st3 = r5_through_u1(roster, vc)
    ce_eq("victim masks with U2 = souls 1-4", r5_victim_u2(st3, [0, 1, 2, 3])[0], 1)
    r5_expect("U3 not a subset of U2", st3[0][0], sa4h_one(sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 5]))), "bad_set", "not a subset of U2")
    let st4 = r5_through_u1(roster, vc)
    r5_victim_u2(st4, [0, 1, 2, 3, 4])
    r5_expect("not in U3", st4[0][0], sa4h_one(sa4w_fmt_set(R5, 3, sa4w_bitmap([2, 3, 4, 5]))), "not_in_u3", "not in U3")
    // R4 checks: the victim signs U3 = souls 1-4.
    let st5 = r5_through_u1(roster, vc)
    r5_victim_u2(st5, [0, 1, 2, 3, 4])
    let own = sa4h_feed(st5[0][0], sa4h_one(sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 4]))))[1][0]
    r5_expect("U4 not a subset of U3", st5[0][0], sa4h_one(sa4w_fmt_set(R5, 4, sa4w_bitmap([1, 2, 3, 5]))), "bad_set", "not a subset of U3")
    let st6 = r5_through_u1(roster, vc)
    r5_victim_u2(st6, [0, 1, 2, 3, 4])
    sa4h_feed(st6[0][0], sa4h_one(sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 4, 5]))))
    r5_expect("not in U4", st6[0][0], sa4h_one(sa4w_fmt_set(R5, 4, sa4w_bitmap([2, 3, 4, 5]))), "not_in_u4", "not in U4")
    let st7 = r5_through_u1(roster, vc)
    r5_victim_u2(st7, [0, 1, 2, 3, 4])
    let own7 = sa4h_feed(st7[0][0], sa4h_one(sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 4, 5]))))[1][0]
    let fake = sa4w_parse(own7)[3]
    let lines = list_new()
    push(lines, own7)
    push(lines, sa4w_fmt_sig3(R5, 300, fake))
    push(lines, sa4w_fmt_sig3(R5, 65536, fake))
    push(lines, sa4w_fmt_sig3(R5, 4294967295, fake))
    push(lines, sa4w_fmt_set(R5, 4, sa4w_bitmap([1, 2, 3, 4])))
    r5_expect("SIG3 from a soul outside U4", st7[0][0], lines, "bad_sig3", "outside U4")
    ce_check("victim's own SIG3 line produced", sa4h_starts(own, "SA4_SIG3 21 7 ") == 1)
    return 0
}

fn test_share_fields(roster, vc) {
    // Seal shares from soul 300 (index 1) to the victim with the right
    // directional key but a wrong round, then a wrong x, in the plaintext.
    let codes = ["round", "x"]
    let ci = 0
    while ci < 2 {
        let st = r5_through_u1(roster, vc)
        let sender = st[0][1]
        let csk = sender[12]
        let vcpk = sa4w_parse(st[1][0])[3]
        let ek = sac_enc_key(csk, sac_list_to_buf(vcpk), R5, 300, 7)
        ce_eq("sender key agreement", ek[1], 1)
        let zero = list_new()
        let k = 0
        while k < 32 {
            push(zero, 3)
            k = k + 1
        }
        let rr = R5
        let xx = 1
        if ci == 0 { rr = R5 + 1 }
        if ci == 1 { xx = 2 }
        let pt = sa4w_share_pt(300, 7, rr, xx, zero, zero)
        let w = sac_share_seal(ek[0], R5, 300, 7, sac_list_to_buf(pt), 82)
        let forged = sa4w_fmt_share(R5, 300, 7, sac_buf_to_list(w[0], w[1]))
        let lines = sa4h_cat(sa4h_one(forged), r5_to(st[2], 7, [2, 3, 4]))
        push(lines, sa4w_fmt_set(R5, 2, sa4w_bitmap([1, 2, 3, 4, 5])))
        r5_expect("share plaintext with wrong " + codes[ci], st[0][0], lines, "bad_share", "ids, round or x differ")
        ci = ci + 1
    }
    return 0
}

fn test_batch_caps(roster, vc) {
    let st = r5_through_u1(roster, vc)
    let mine = r5_to(st[2], 7, [1, 2, 3, 4])
    let six = sa4h_cat(mine, sa4h_cat(sa4h_one(mine[0]), sa4h_one(mine[1])))
    r5_expect("more SHARE lines than souls", st[0][0], six, "bad_share", "more share lines than souls")
    let st2 = r5_through_u1(roster, vc)
    r5_victim_u2(st2, [0, 1, 2, 3, 4])
    let own = sa4h_feed(st2[0][0], sa4h_one(sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 4, 5]))))[1][0]
    let lines = list_new()
    let k = 0
    while k < 6 {
        push(lines, own)
        k = k + 1
    }
    r5_expect("more SIG3 lines than souls", st2[0][0], lines, "bad_sig3", "more signatures than souls")
    return 0
}

// Soul at index b gets U2 = souls 1-4 while the victim gets U2 = all; both
// get U3 = souls 1-4. b's signature is over a different T3 for the victim.
fn test_equivocate_u2(roster, vc) {
    let st = r5_through_u1(roster, vc)
    r5_victim_u2(st, [0, 1, 2, 3, 4])
    let b = st[0][1]
    let bl = sa4h_cat(r5_to(st[2], 300, [0, 2, 3]), sa4h_one(sa4w_fmt_set(R5, 2, sa4w_bitmap([1, 2, 3, 4]))))
    ce_eq("other soul masks with U2 = souls 1-4", sa4h_feed(b, bl)[0], 1)
    let set3 = sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 4]))
    let own = sa4h_feed(st[0][0], sa4h_one(set3))[1][0]
    let bsig = sa4h_feed(b, sa4h_one(set3))[1][0]
    let filler = sa4w_parse(own)[3]
    let lines = list_new()
    push(lines, own)
    push(lines, bsig)
    push(lines, sa4w_fmt_sig3(R5, 65536, filler))
    push(lines, sa4w_fmt_sig3(R5, 70000, filler))
    push(lines, sa4w_fmt_set(R5, 4, sa4w_bitmap([1, 2, 3, 4])))
    r5_expect("SIG3 over a different U2", st[0][0], lines, "bad_sig3", "soul 300 does not verify")
    return 0
}

// Soul at index b sees U1 = souls 1-4 while the victim sees all five; both
// use U2 = U3 = souls 1-4. Their H1 differ, so b's signature does not
// verify for the victim.
fn test_equivocate_u1(roster, vc) {
    let souls = r5_souls(roster, vc)
    let advs = r5_advs(roster, souls)
    let shares = list_new()
    shares = sa4h_cat(shares, r5_u1(souls, advs, 0, [0, 1, 2, 3, 4]))
    shares = sa4h_cat(shares, r5_u1(souls, advs, 1, [0, 1, 2, 3]))
    shares = sa4h_cat(shares, r5_u1(souls, advs, 2, [0, 1, 2, 3, 4]))
    shares = sa4h_cat(shares, r5_u1(souls, advs, 3, [0, 1, 2, 3, 4]))
    let set2 = sa4w_fmt_set(R5, 2, sa4w_bitmap([1, 2, 3, 4]))
    ce_eq("victim masks", sa4h_feed(souls[0], sa4h_cat(r5_to(shares, 7, [1, 2, 3]), sa4h_one(set2)))[0], 1)
    ce_eq("other soul masks", sa4h_feed(souls[1], sa4h_cat(r5_to(shares, 300, [0, 2, 3]), sa4h_one(set2)))[0], 1)
    let set3 = sa4w_fmt_set(R5, 3, sa4w_bitmap([1, 2, 3, 4]))
    let own = sa4h_feed(souls[0], sa4h_one(set3))[1][0]
    let bsig = sa4h_feed(souls[1], sa4h_one(set3))[1][0]
    let filler = sa4w_parse(own)[3]
    let lines = list_new()
    push(lines, own)
    push(lines, bsig)
    push(lines, sa4w_fmt_sig3(R5, 65536, filler))
    push(lines, sa4w_fmt_sig3(R5, 70000, filler))
    push(lines, sa4w_fmt_set(R5, 4, sa4w_bitmap([1, 2, 3, 4])))
    r5_expect("SIG3 over a different U1 (H1)", souls[0], lines, "bad_sig3", "soul 300 does not verify")
    return 0
}

fn r5_zero32(b) {
    if b == 0 { return 0 }
    let i = 0
    while i < 32 {
        if load8(b + i) != 0 { return 0 }
        i = i + 1
    }
    return 1
}

// The secret buffers themselves are zeroed (not just dropped from the
// soul): after R2, and on a refusal.
fn test_wipe_bytes(roster, vc) {
    let st = r5_through_u1(roster, vc)
    let v = st[0][0]
    let c = v[12]
    let s = v[14]
    let b = v[16]
    let seed = v[27][1]
    ce_check("secrets present after R1", r5_zero32(c) + r5_zero32(s) + r5_zero32(b) + r5_zero32(seed) == 0)
    ce_eq("victim masks", r5_victim_u2(st, [0, 1, 2, 3, 4])[0], 1)
    ce_eq("c_u^SK bytes zero after R2", r5_zero32(c), 1)
    ce_eq("s_u^SK bytes zero after R2", r5_zero32(s), 1)
    ce_eq("b_u bytes zero after R2", r5_zero32(b), 1)
    ce_eq("mask seed bytes zero after R2", r5_zero32(seed), 1)
    let st2 = r5_through_u1(roster, vc)
    let v2 = st2[0][0]
    let c2 = v2[12]
    let b2 = v2[16]
    sa4h_feed(v2, sa4h_one(sa4w_fmt_set(R5, 2, sa4w_bitmap([2, 3, 4, 5]))))
    ce_eq("c_u^SK bytes zero after a refusal", r5_zero32(c2), 1)
    ce_eq("b_u bytes zero after a refusal", r5_zero32(b2), 1)
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    ce_eq("t = 4", sroster_t(roster), 4)
    test_membership(roster, vc)
    test_share_fields(roster, vc)
    test_batch_caps(roster, vc)
    test_equivocate_u2(roster, vc)
    test_equivocate_u1(roster, vc)
    test_wipe_bytes(roster, vc)
    ce_summary("sa4_soul_refuse5")
}

main()
