// Unit tests for src/kg/proofs.nova (KG-proofs table, ADR-0088 storage layer).

import "../ce_test.nova"
import "../../src/kg/proofs.nova"

fn test_registry() {
    let reg = proof_registry_new()
    let ax = list_new()
    push(ax, "axiom_refl")
    push(ax, "axiom_trans")
    let code = proof_register(reg, "2+2=4", ax, "derivation-bytes")
    ce_eq("first proof code = 1", code, 1)
    ce_eq("starts unchecked", proof_status(reg, code), PROOF_UNCHECKED)
    ce_str_eq("claim stored", proof_claim(reg, code), "2+2=4")
    ce_eq("axiom count", len(proof_axioms(reg, code)), 2)

    // The kernel verifies it.
    ce_eq("set status ok", proof_set_status(reg, code, PROOF_VERIFIED), 1)
    ce_eq("now verified", proof_status(reg, code), PROOF_VERIFIED)

    // Fail-safe lookups.
    ce_eq("slot 0 unchecked", proof_status(reg, 0), PROOF_UNCHECKED)
    ce_eq("oob -> unchecked", proof_status(reg, 99), PROOF_UNCHECKED)
    ce_eq("negative -> unchecked", proof_status(reg, 0 - 1), PROOF_UNCHECKED)
    ce_eq("cannot set slot 0", proof_set_status(reg, 0, PROOF_VERIFIED), 0)
}

fn test_atom_proof_consistency() {
    let reg = proof_registry_new()
    // A non-FORMAL atom is vacuously consistent regardless of proof_ref.
    let e = atom_new("medicine", 0, ATOM_FACT, "aspirin treats fever", 5)
    atom_set_evidence_grade(e, GRADE_EMPIRICAL_STRONG)
    ce_eq("non-formal vacuously consistent", atom_proof_verified(reg, e), 1)

    // A FORMAL atom with no proof_ref is inconsistent.
    let t = atom_new("math", 1, ATOM_FACT, "2+2=4", 6)
    atom_set_evidence_grade(t, GRADE_FORMAL)
    ce_eq("formal w/o proof not verified", atom_proof_verified(reg, t), 0)

    // Attach a proof; still unchecked -> not verified.
    let ax = list_new()
    let code = proof_register(reg, "2+2=4", ax, "blob")
    atom_set_proof_ref(t, code)
    ce_eq("formal w/ unchecked proof not verified", atom_proof_verified(reg, t), 0)

    // Kernel verifies -> consistent.
    proof_set_status(reg, code, PROOF_VERIFIED)
    ce_eq("formal w/ verified proof OK", atom_proof_verified(reg, t), 1)

    // A failed proof -> not verified.
    let f = atom_new("math", 2, ATOM_FACT, "2+2=5", 7)
    atom_set_evidence_grade(f, GRADE_FORMAL)
    let fcode = proof_register(reg, "2+2=5", list_new(), "bad")
    atom_set_proof_ref(f, fcode)
    proof_set_status(reg, fcode, PROOF_FAILED)
    ce_eq("formal w/ failed proof not verified", atom_proof_verified(reg, f), 0)
}

fn main() {
    test_registry()
    test_atom_proof_consistency()
    ce_summary("proofs")
}

main()
