// Unit tests for src/nl/nl_metrics.nova (R95, Phase B).
//
// Covers: fresh registry all-zero, single- and multi-holder increments,
// empty-string holder as first-class bucket, snapshot idempotence,
// increment order independence, and 0-registry no-op safety.

import "../ce_test.nova"
import "../../src/nl/nl_metrics.nova"
import "../../src/util/str_safe.nova"

// ---- fresh registry --------------------------------------------------------

fn test_fresh_all_zero() {
    let r = nl_metrics_new()
    ce_eq("no holders",       nl_metrics_holder_count(r), 0)
    ce_eq("total alice=0",    nl_metrics_total(r, "alice"), 0)
    ce_eq("unparsed alice=0", nl_metrics_unparsed(r, "alice"), 0)
    ce_eq("attempts=0",       nl_metrics_llm_fallback_attempts(r, "alice"), 0)
    ce_eq("successes=0",      nl_metrics_llm_fallback_successes(r, "alice"), 0)
    ce_eq("failures=0",       nl_metrics_llm_fallback_failures(r, "alice"), 0)
    // Read alone does NOT create a row.
    ce_eq("still 0 holders after read", nl_metrics_holder_count(r), 0)
}

// ---- single holder ---------------------------------------------------------

fn test_inc_total_creates_row() {
    let r = nl_metrics_new()
    nl_metrics_inc_total(r, "alice")
    ce_eq("1 holder",  nl_metrics_holder_count(r), 1)
    ce_eq("total=1",   nl_metrics_total(r, "alice"), 1)
    ce_eq("unparsed=0", nl_metrics_unparsed(r, "alice"), 0)
    nl_metrics_inc_total(r, "alice")
    ce_eq("total=2",   nl_metrics_total(r, "alice"), 2)
}

fn test_all_slot_increments() {
    let r = nl_metrics_new()
    nl_metrics_inc_total(r, "alice")
    nl_metrics_inc_unparsed(r, "alice")
    nl_metrics_inc_llm_fallback_attempt(r, "alice")
    nl_metrics_inc_llm_fallback_success(r, "alice")
    nl_metrics_inc_llm_fallback_failure(r, "alice")
    nl_metrics_inc_ic_attempt(r, "alice")
    nl_metrics_inc_ic_hit(r, "alice")
    nl_metrics_inc_ic_miss(r, "alice")
    ce_eq("total=1",     nl_metrics_total(r, "alice"), 1)
    ce_eq("unparsed=1",  nl_metrics_unparsed(r, "alice"), 1)
    ce_eq("attempts=1",  nl_metrics_llm_fallback_attempts(r, "alice"), 1)
    ce_eq("successes=1", nl_metrics_llm_fallback_successes(r, "alice"), 1)
    ce_eq("failures=1",  nl_metrics_llm_fallback_failures(r, "alice"), 1)
    ce_eq("ic_att=1",    nl_metrics_ic_attempts(r, "alice"), 1)
    ce_eq("ic_hit=1",    nl_metrics_ic_hits(r, "alice"), 1)
    ce_eq("ic_miss=1",   nl_metrics_ic_misses(r, "alice"), 1)
}

// ---- R98 classifier counters -----------------------------------------------

fn test_ic_counters_isolated_from_llm() {
    // Bumping IC counters MUST NOT touch LLM counters (and vice versa).
    let r = nl_metrics_new()
    nl_metrics_inc_ic_attempt(r, "alice")
    nl_metrics_inc_ic_hit(r, "alice")
    ce_eq("ic_att=1", nl_metrics_ic_attempts(r, "alice"), 1)
    ce_eq("ic_hit=1", nl_metrics_ic_hits(r, "alice"), 1)
    ce_eq("llm_att unchanged",
        nl_metrics_llm_fallback_attempts(r, "alice"), 0)
    ce_eq("llm_success unchanged",
        nl_metrics_llm_fallback_successes(r, "alice"), 0)
    ce_eq("total unchanged", nl_metrics_total(r, "alice"), 0)
    ce_eq("unparsed unchanged", nl_metrics_unparsed(r, "alice"), 0)
    // The reverse: bumping LLM doesn't touch IC.
    let r2 = nl_metrics_new()
    nl_metrics_inc_llm_fallback_attempt(r2, "bob")
    nl_metrics_inc_llm_fallback_success(r2, "bob")
    ce_eq("bob llm_att=1",
        nl_metrics_llm_fallback_attempts(r2, "bob"), 1)
    ce_eq("bob ic_att=0",
        nl_metrics_ic_attempts(r2, "bob"), 0)
    ce_eq("bob ic_hit=0", nl_metrics_ic_hits(r2, "bob"), 0)
    ce_eq("bob ic_miss=0", nl_metrics_ic_misses(r2, "bob"), 0)
}

fn test_ic_zero_registry_noop() {
    ce_eq("ic_att(0)=0",  nl_metrics_inc_ic_attempt(0, "a"), 0)
    ce_eq("ic_hit(0)=0",  nl_metrics_inc_ic_hit(0, "a"), 0)
    ce_eq("ic_miss(0)=0", nl_metrics_inc_ic_miss(0, "a"), 0)
    ce_eq("read ic_att(0)=0",  nl_metrics_ic_attempts(0, "a"), 0)
    ce_eq("read ic_hit(0)=0",  nl_metrics_ic_hits(0, "a"), 0)
    ce_eq("read ic_miss(0)=0", nl_metrics_ic_misses(0, "a"), 0)
}

// ---- multi-holder ----------------------------------------------------------

fn test_per_holder_breakdown() {
    let r = nl_metrics_new()
    nl_metrics_inc_total(r, "alice")
    nl_metrics_inc_total(r, "alice")
    nl_metrics_inc_total(r, "bob")
    nl_metrics_inc_unparsed(r, "bob")
    ce_eq("2 holders",       nl_metrics_holder_count(r), 2)
    ce_eq("alice total=2",   nl_metrics_total(r, "alice"), 2)
    ce_eq("bob total=1",     nl_metrics_total(r, "bob"), 1)
    ce_eq("alice unpars=0",  nl_metrics_unparsed(r, "alice"), 0)
    ce_eq("bob unpars=1",    nl_metrics_unparsed(r, "bob"), 1)
    ce_eq("carol total=0",   nl_metrics_total(r, "carol"), 0)
}

// ---- empty-string holder (anonymous bucket) --------------------------------

fn test_anonymous_holder_first_class() {
    let r = nl_metrics_new()
    nl_metrics_inc_total(r, "")
    nl_metrics_inc_unparsed(r, "")
    nl_metrics_inc_llm_fallback_attempt(r, "")
    ce_eq("anon holder exists", nl_metrics_holder_count(r), 1)
    ce_eq("anon total=1",       nl_metrics_total(r, ""), 1)
    ce_eq("anon unparsed=1",    nl_metrics_unparsed(r, ""), 1)
    ce_eq("anon attempts=1",    nl_metrics_llm_fallback_attempts(r, ""), 1)
    // Not conflated with a named holder.
    ce_eq("alice total unchanged", nl_metrics_total(r, "alice"), 0)
}

// ---- snapshot --------------------------------------------------------------

fn test_snapshot_shape() {
    let r = nl_metrics_new()
    nl_metrics_inc_total(r, "alice")
    nl_metrics_inc_total(r, "alice")
    nl_metrics_inc_unparsed(r, "alice")
    nl_metrics_inc_total(r, "bob")
    nl_metrics_inc_llm_fallback_failure(r, "bob")
    let snap = nl_metrics_snapshot(r)
    ce_eq("two rows", len(snap), 2)
    // Rows preserve insertion order (alice first, bob second).
    let row_a = snap[0]
    let row_b = snap[1]
    ce_eq("row0 alice",     str_eq_bytes(nlms_holder(row_a), "alice"), 1)
    ce_eq("row0 total=2",   nlms_total(row_a), 2)
    ce_eq("row0 unpars=1",  nlms_unparsed(row_a), 1)
    ce_eq("row0 attempts=0", nlms_attempts(row_a), 0)
    ce_eq("row1 bob",       str_eq_bytes(nlms_holder(row_b), "bob"), 1)
    ce_eq("row1 total=1",   nlms_total(row_b), 1)
    ce_eq("row1 failures=1", nlms_failures(row_b), 1)
    ce_eq("row1 successes=0", nlms_successes(row_b), 0)
    // R98: new IC slots are all zero on a fresh snapshot row.
    ce_eq("row0 ic_att=0",  nlms_ic_attempts(row_a), 0)
    ce_eq("row0 ic_hit=0",  nlms_ic_hits(row_a), 0)
    ce_eq("row0 ic_miss=0", nlms_ic_misses(row_a), 0)
    ce_eq("row1 ic_att=0",  nlms_ic_attempts(row_b), 0)
}

fn test_snapshot_idempotent() {
    let r = nl_metrics_new()
    nl_metrics_inc_total(r, "alice")
    let snap1 = nl_metrics_snapshot(r)
    let snap2 = nl_metrics_snapshot(r)
    ce_eq("same len",     len(snap1), len(snap2))
    ce_eq("read no mut",  nl_metrics_holder_count(r), 1)
    ce_eq("total still 1", nl_metrics_total(r, "alice"), 1)
}

// ---- inc order independence ------------------------------------------------

fn test_inc_order_independence() {
    let r1 = nl_metrics_new()
    nl_metrics_inc_total(r1, "a")
    nl_metrics_inc_unparsed(r1, "a")
    nl_metrics_inc_llm_fallback_attempt(r1, "a")
    nl_metrics_inc_llm_fallback_success(r1, "a")

    let r2 = nl_metrics_new()
    nl_metrics_inc_llm_fallback_success(r2, "a")
    nl_metrics_inc_llm_fallback_attempt(r2, "a")
    nl_metrics_inc_unparsed(r2, "a")
    nl_metrics_inc_total(r2, "a")

    ce_eq("total same",     nl_metrics_total(r1, "a"),
                            nl_metrics_total(r2, "a"))
    ce_eq("unparsed same",  nl_metrics_unparsed(r1, "a"),
                            nl_metrics_unparsed(r2, "a"))
    ce_eq("attempt same",   nl_metrics_llm_fallback_attempts(r1, "a"),
                            nl_metrics_llm_fallback_attempts(r2, "a"))
    ce_eq("success same",   nl_metrics_llm_fallback_successes(r1, "a"),
                            nl_metrics_llm_fallback_successes(r2, "a"))
}

// ---- 0-registry no-op safety -----------------------------------------------

fn test_zero_registry_noop() {
    // All mutators must handle a 0 registry without crashing so callers
    // that haven't wired counters can call them unconditionally.
    ce_eq("inc_total(0) returns 0",    nl_metrics_inc_total(0, "a"), 0)
    ce_eq("inc_unparsed(0) returns 0", nl_metrics_inc_unparsed(0, "a"), 0)
    ce_eq("inc_attempt(0) returns 0",
        nl_metrics_inc_llm_fallback_attempt(0, "a"), 0)
    ce_eq("inc_success(0) returns 0",
        nl_metrics_inc_llm_fallback_success(0, "a"), 0)
    ce_eq("inc_failure(0) returns 0",
        nl_metrics_inc_llm_fallback_failure(0, "a"), 0)
    ce_eq("read total(0) is 0", nl_metrics_total(0, "a"), 0)
    ce_eq("holder_count(0) is 0", nl_metrics_holder_count(0), 0)
    let snap = nl_metrics_snapshot(0)
    ce_eq("snapshot(0) empty", len(snap), 0)
}

// ---- runner ---------------------------------------------------------------

fn main() {
    test_fresh_all_zero()
    test_inc_total_creates_row()
    test_all_slot_increments()
    test_per_holder_breakdown()
    test_anonymous_holder_first_class()
    test_snapshot_shape()
    test_snapshot_idempotent()
    test_inc_order_independence()
    test_zero_registry_noop()
    test_ic_counters_isolated_from_llm()
    test_ic_zero_registry_noop()
    ce_summary("nl_metrics")
}

main()
