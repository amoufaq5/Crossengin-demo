// Unit tests for src/parts/reasoning/debate.nova (ADR-0089 stage 5 adjudication
// + rebut wiring): grounded acceptability -> Beta confidence.

import "../ce_test.nova"
import "../../src/parts/reasoning/debate.nova"

fn _dargs1(d0) {
    let l = list_new()
    push(l, d0)
    return l
}
fn _dargs2(d0, d1) {
    let l = list_new()
    push(l, d0) push(l, d1)
    return l
}

fn test_single_support() {
    // one defeasible argument FOR claim 0, weight 1000 -> alpha 2000/beta 1000.
    let ds = _dargs1(darg_new(0, 1, 1000, 0))
    ce_eq("single support -> 0.666", debate_decide(ds, 0), 666)
    ce_eq("single support not contested", debate_is_contested(ds, 0), 0)
}

fn test_two_supports() {
    let ds = _dargs2(darg_new(0, 1, 1000, 0), darg_new(0, 1, 1000, 0))
    // both unattacked -> both IN -> alpha 3000/beta 1000 -> 0.75
    ce_eq("two supports -> 0.75", debate_decide(ds, 0), 750)
}

fn test_single_against() {
    let ds = _dargs1(darg_new(0, 0 - 1, 1000, 0))
    // one against, unattacked -> IN -> alpha 1000/beta 2000 -> 0.333
    ce_eq("single against -> 0.333", debate_decide(ds, 0), 333)
}

fn test_contested_rebut() {
    // for vs against, both defeasible -> mutual rebut -> 2-cycle -> both UNDEC.
    let ds = _dargs2(darg_new(0, 1, 1000, 0), darg_new(0, 0 - 1, 1000, 0))
    ce_eq("unresolved rebut -> prior 0.5", debate_decide(ds, 0), 500)
    ce_eq("flagged contested", debate_is_contested(ds, 0), 1)
}

fn test_strict_defeats_defeasible() {
    // strict FOR vs defeasible AGAINST: the proof defeats the opinion.
    let ds = _dargs2(darg_new(0, 1, 1000, 1), darg_new(0, 0 - 1, 1000, 0))
    ce_eq("strict for survives -> 0.666", debate_decide(ds, 0), 666)
    ce_eq("not contested (proof wins)", debate_is_contested(ds, 0), 0)
}

fn test_strict_against_defeats() {
    // defeasible FOR vs strict AGAINST: the proof of the negation defeats it.
    let ds = _dargs2(darg_new(0, 1, 1000, 0), darg_new(0, 0 - 1, 1000, 1))
    ce_eq("strict against survives -> 0.333", debate_decide(ds, 0), 333)
}

fn main() {
    test_single_support()
    test_two_supports()
    test_single_against()
    test_contested_rebut()
    test_strict_defeats_defeasible()
    test_strict_against_defeats()
    ce_summary("debate")
}

main()
