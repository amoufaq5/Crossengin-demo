// Unit tests for src/parts/reasoning/debate.nova (ADR-0089 stage 5 adjudication
// + rebut wiring): grounded acceptability -> Beta confidence.

import "../ce_test.nova"
import "../../src/parts/reasoning/debate.nova"

fn _dargs1(d0) {
    let l = list_new()
    push(l, d0)
    return l
}
fn _dargs2(d0, d1) {
    let l = list_new()
    push(l, d0) push(l, d1)
    return l
}

fn test_single_support() {
    // one defeasible argument FOR claim 0, weight 1000 -> alpha 2000/beta 1000.
    let ds = _dargs1(darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1))
    ce_eq("single support -> 0.666", debate_decide(ds, 0), 666)
    ce_eq("single support not contested", debate_is_contested(ds, 0), 0)
}

fn test_two_supports() {
    let ds = _dargs2(darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1), darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1))
    // both unattacked -> both IN -> alpha 3000/beta 1000 -> 0.75
    ce_eq("two supports -> 0.75", debate_decide(ds, 0), 750)
}

fn test_single_against() {
    let ds = _dargs1(darg_new(0, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    // one against, unattacked -> IN -> alpha 1000/beta 2000 -> 0.333
    ce_eq("single against -> 0.333", debate_decide(ds, 0), 333)
}

fn test_contested_rebut() {
    // for vs against, both defeasible -> mutual rebut -> 2-cycle -> both UNDEC.
    let ds = _dargs2(darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1), darg_new(0, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    ce_eq("unresolved rebut -> prior 0.5", debate_decide(ds, 0), 500)
    ce_eq("flagged contested", debate_is_contested(ds, 0), 1)
}

fn test_strict_defeats_defeasible() {
    // strict FOR vs defeasible AGAINST: the proof defeats the opinion.
    let ds = _dargs2(darg_new(0, 1, 1000, 1, 0 - 1, 0 - 1), darg_new(0, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    ce_eq("strict for survives -> 0.666", debate_decide(ds, 0), 666)
    ce_eq("not contested (proof wins)", debate_is_contested(ds, 0), 0)
}

fn test_strict_against_defeats() {
    // defeasible FOR vs strict AGAINST: the proof of the negation defeats it.
    let ds = _dargs2(darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1), darg_new(0, 0 - 1, 1000, 1, 0 - 1, 0 - 1))
    ce_eq("strict against survives -> 0.333", debate_decide(ds, 0), 333)
}

// ---- stages 1-2: construct arguments from a real reasoning KG --------------

fn test_construct_strong() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let target = kg_add_atom(kg, ATOM_CONCEPT, "fever_reduced", 0)
    let premise = kg_add_atom(kg, ATOM_CONCEPT, "aspirin", 0)
    atom_set_evidence_grade(premise, GRADE_EMPIRICAL_STRONG)
    rop_new(kg, ROP_IMPLY, atom_id(premise), atom_id(target), "src:wiki", 0)
    // premise conf 0.5 (prior) x strong weight 1000 -> weight 500; single FOR
    // -> alpha 1500/beta 1000 -> 0.6.
    ce_eq("strong premise -> 0.6", debate_atom(kg, atom_id(target)), 600)
    ce_eq("not contested", debate_atom_contested(kg, atom_id(target)), 0)
}

fn test_construct_formal() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let target = kg_add_atom(kg, ATOM_CONCEPT, "two_plus_two_four", 0)
    let premise = kg_add_atom(kg, ATOM_CONCEPT, "peano_axioms", 0)
    atom_set_evidence_grade(premise, GRADE_FORMAL)
    rop_new(kg, ROP_IMPLY, atom_id(premise), atom_id(target), "src:proof", 0)
    ce_eq("formal premise -> ~0.99", debate_atom(kg, atom_id(target)), 990)
}

fn test_construct_contested() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let target = kg_add_atom(kg, ATOM_CONCEPT, "policy_helps", 0)
    let pfor = kg_add_atom(kg, ATOM_CONCEPT, "study_a", 0)
    let pagainst = kg_add_atom(kg, ATOM_CONCEPT, "study_b", 0)
    atom_set_evidence_grade(pfor, GRADE_EMPIRICAL_STRONG)
    atom_set_evidence_grade(pagainst, GRADE_EMPIRICAL_STRONG)
    rop_new(kg, ROP_IMPLY, atom_id(pfor), atom_id(target), "src:a", 0)
    rop_new(kg, ROP_OPPOSITE, atom_id(pagainst), atom_id(target), "src:b", 0)
    ce_eq("two defeasible studies clash -> prior 0.5", debate_atom(kg, atom_id(target)), 500)
    ce_eq("flagged contested (ADR-0090)", debate_atom_contested(kg, atom_id(target)), 1)
}

fn test_construct_proof_beats_opinion() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let target = kg_add_atom(kg, ATOM_CONCEPT, "theorem_T", 0)
    let proof = kg_add_atom(kg, ATOM_CONCEPT, "the_proof", 0)
    let doubt = kg_add_atom(kg, ATOM_CONCEPT, "a_skeptic", 0)
    atom_set_evidence_grade(proof, GRADE_FORMAL)
    atom_set_evidence_grade(doubt, GRADE_TESTIMONIAL)
    rop_new(kg, ROP_IMPLY, atom_id(proof), atom_id(target), "src:proof", 0)
    rop_new(kg, ROP_OPPOSITE, atom_id(doubt), atom_id(target), "src:blog", 0)
    // the strict proof defeats the defeasible doubt: near-certain, not contested.
    ce_eq("proof beats opinion -> ~0.99", debate_atom(kg, atom_id(target)), 990)
    ce_eq("proof resolves -> not contested", debate_atom_contested(kg, atom_id(target)), 0)
}

// ---- closed governance loop: debate gate (f) -> promotion (ADR-0092) -------

fn test_closed_loop_promote() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let claim = kg_add_atom(kg, ATOM_CONCEPT, "sqrt2_irrational", 0)
    let proof_premise = kg_add_atom(kg, ATOM_CONCEPT, "euclid_proof", 0)
    atom_set_evidence_grade(proof_premise, GRADE_FORMAL)
    rop_new(kg, ROP_IMPLY, atom_id(proof_premise), atom_id(claim), "src:proof", 0)

    // gate (f): the proof-backed argument wins the debate.
    let verdict = debate_verdict_for(kg, atom_id(claim))
    ce_eq("proof-backed claim wins gate f", verdict, DEBATE_PASSED)

    // closed loop: promotion accepts a debate-winning candidate.
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let st = cand_promote(claim,
        claim_new("http://en.wikipedia.org/wiki/Square_root_of_2", 2, 0, PROV_NONE, 0),
        pctx_new(lic, prf), verdict)
    ce_eq("promoted via debate gate", st, CAND_PROMOTED)
}

fn test_closed_loop_contested() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let claim = kg_add_atom(kg, ATOM_CONCEPT, "policy_X_good", 0)
    let pfor = kg_add_atom(kg, ATOM_CONCEPT, "study_pro", 0)
    let pagainst = kg_add_atom(kg, ATOM_CONCEPT, "study_con", 0)
    atom_set_evidence_grade(pfor, GRADE_EMPIRICAL_STRONG)
    atom_set_evidence_grade(pagainst, GRADE_EMPIRICAL_STRONG)
    rop_new(kg, ROP_IMPLY, atom_id(pfor), atom_id(claim), "src:a", 0)
    rop_new(kg, ROP_OPPOSITE, atom_id(pagainst), atom_id(claim), "src:b", 0)

    // gate (f): an unresolved clash loses the gate.
    let verdict = debate_verdict_for(kg, atom_id(claim))
    ce_eq("contested claim loses gate f", verdict, DEBATE_FAILED)

    // closed loop: promotion freezes it CONTESTED rather than asserting it.
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let st = cand_promote(claim,
        claim_new("http://en.wikipedia.org/wiki/Minimum_wage", 2, 0, PROV_NONE, 0),
        pctx_new(lic, prf), verdict)
    ce_eq("contested -> not promoted", st, CAND_CONTESTED)
    ce_eq("contested claim not usable", cand_is_usable(claim), 0)
}

// ---- argument trace (ADR-0089 explainability) ------------------------------

fn test_trace_contested() {
    let ds = _dargs2(darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1), darg_new(0, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    let tr = debate_trace_build(ds, 0)
    ce_eq("trace confidence 0.5", debate_trace_confidence(tr), 500)
    ce_eq("trace contested", debate_trace_contested(tr), 1)
    ce_eq("trace 2 args", debate_trace_num_args(tr), 2)
    ce_eq("arg0 undec", debate_trace_label(tr, 0), ARG_UNDEC)
    ce_check("render non-empty", len(debate_trace_render(tr)) > 0)
}

fn test_trace_proof() {
    let ds = _dargs2(darg_new(0, 1, 99000, 1, 0 - 1, 0 - 1), darg_new(0, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    let tr = debate_trace_build(ds, 0)
    ce_eq("proof trace conf 0.99", debate_trace_confidence(tr), 990)
    ce_eq("proof trace not contested", debate_trace_contested(tr), 0)
    ce_eq("arg0 proof IN", debate_trace_label(tr, 0), ARG_IN)
    ce_eq("arg1 doubt OUT", debate_trace_label(tr, 1), ARG_OUT)
}

fn test_atom_trace() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let claim = kg_add_atom(kg, ATOM_CONCEPT, "thm", 0)
    let proof = kg_add_atom(kg, ATOM_CONCEPT, "the_proof", 0)
    let doubt = kg_add_atom(kg, ATOM_CONCEPT, "skeptic", 0)
    atom_set_evidence_grade(proof, GRADE_FORMAL)
    atom_set_evidence_grade(doubt, GRADE_TESTIMONIAL)
    rop_new(kg, ROP_IMPLY, atom_id(proof), atom_id(claim), "src:proof", 0)
    rop_new(kg, ROP_OPPOSITE, atom_id(doubt), atom_id(claim), "src:blog", 0)
    let tr = debate_atom_trace(kg, atom_id(claim))
    ce_eq("atom trace claim id", debate_trace_claim(tr), atom_id(claim))
    ce_eq("atom trace 2 args", debate_trace_num_args(tr), 2)
    ce_eq("atom trace conf ~0.99", debate_trace_confidence(tr), 990)
    ce_eq("atom trace not contested", debate_trace_contested(tr), 0)
    // Demonstrate the rendered "show your work" output.
    print(debate_trace_render(tr))
}

fn test_undermine() {
    // A argues FOR claim 10, resting on premise atom 5. B argues that premise 5
    // is false -> B undermines A (defeats it by refuting its premise).
    let ds = _dargs2(darg_new(10, 1, 1000, 0, 5, 0 - 1), darg_new(5, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    let af = debate_build_af(ds)
    let l = af_grounded(af)
    ce_eq("undermining arg B is IN", l[1], ARG_IN)
    ce_eq("undermined arg A is OUT", l[0], ARG_OUT)
    // claim 10 loses its only (undermined) support -> falls to the prior 0.5.
    ce_eq("undermined support -> prior 0.5", debate_decide(ds, 10), 500)
}

fn test_undercut() {
    // A argues FOR claim 10 via defeasible rule (operator) 7. B argues that rule 7
    // is inapplicable -> B undercuts A (defeats the inference step).
    let ds = _dargs2(darg_new(10, 1, 1000, 0, 0 - 1, 7), darg_new(7, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    let l = af_grounded(debate_build_af(ds))
    ce_eq("undercutter B is IN", l[1], ARG_IN)
    ce_eq("undercut A is OUT", l[0], ARG_OUT)
    ce_eq("undercut claim -> prior 0.5", debate_decide(ds, 10), 500)
    // A STRICT inference (a proof) cannot be undercut: it survives.
    let ds2 = _dargs2(darg_new(10, 1, 99000, 1, 0 - 1, 7), darg_new(7, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    let l2 = af_grounded(debate_build_af(ds2))
    ce_eq("strict inference not undercut", l2[0], ARG_IN)
    ce_eq("proof claim still high", debate_decide(ds2, 10), 990)
}

fn main() {
    test_single_support()
    test_two_supports()
    test_single_against()
    test_contested_rebut()
    test_strict_defeats_defeasible()
    test_strict_against_defeats()
    test_construct_strong()
    test_construct_formal()
    test_construct_contested()
    test_construct_proof_beats_opinion()
    test_closed_loop_promote()
    test_closed_loop_contested()
    test_trace_contested()
    test_trace_proof()
    test_atom_trace()
    test_undermine()
    test_undercut()
    ce_summary("debate")
}

main()
