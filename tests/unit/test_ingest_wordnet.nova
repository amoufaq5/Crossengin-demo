// Unit tests for src/ingest/importers/wordnet.nova.

import "../ce_test.nova"
import "../../src/ingest/importers/wordnet.nova"

fn test_empty() {
    let r = wn_parse_text("", "lang", "src:wordnet:demo")
    ce_eq("one empty record", len(wn_records(r)), 1)
    ce_eq("no atoms", len(cur_atoms(wn_records(r)[0])), 0)
}

fn test_single_synset_with_words() {
    let text = "SYNSET fast_moving\nWORD quick\nWORD rapid\nWORD speedy\n"
    let r = wn_parse_text(text, "lang", "src:wordnet:t")
    let rec = wn_records(r)[0]
    // atoms: synset + 3 words = 4
    ce_eq("4 atoms", len(cur_atoms(rec)), 4)
    // implications: word -> synset x 3
    ce_eq("3 imps", len(cur_imps(rec)), 3)
    ce_eq("first imp EMPIRICAL", cur_imps(rec)[0][CUR_IMP_STR], "EMPIRICAL")
}

fn test_hypernym_is_formal() {
    let text = "SYNSET dog\nWORD dog\nHYPERNYM canine\n"
    let r = wn_parse_text(text, "lang", "src:wordnet:t")
    let rec = wn_records(r)[0]
    // atoms: dog synset, dog word, canine = 3 (dog synset and word same label -> 2 in seen)
    // Actually _wn_seen_add uses shared seen list; SYNSET dog and WORD dog have same label -> only one atom.
    ce_eq("2 atoms after dedup", len(cur_atoms(rec)), 2)
    // imps: word->synset EMPIRICAL, synset->hypernym FORMAL
    ce_eq("2 imps", len(cur_imps(rec)), 2)
    // Find the FORMAL one.
    let has_formal = 0
    let i = 0
    while i < len(cur_imps(rec)) {
        if str_eq_bytes(cur_imps(rec)[i][CUR_IMP_STR], "FORMAL") == 1 { has_formal = 1 }
        i = i + 1
    }
    ce_eq("one is FORMAL", has_formal, 1)
}

fn test_antonym_records_cite() {
    let text = "SYNSET slow\nWORD slow\nANTONYM fast\n"
    let r = wn_parse_text(text, "lang", "src:wordnet:t")
    let rec = wn_records(r)[0]
    ce_eq("1 cite", len(cur_cites(rec)), 1)
    ce_eq("cite relation", cur_cites(rec)[0][CUR_CITE_REL], "contradicts")
    ce_eq("validator", cur_validate(rec), CUR_OK)
}

fn test_directive_before_synset_errors() {
    let text = "WORD orphan\nSYNSET a\nWORD w\n"
    let r = wn_parse_text(text, "lang", "src:wordnet:t")
    ce_check("has error", len(wn_errors(r)) >= 1)
    let rec = wn_records(r)[0]
    // Orphan WORD skipped; a + w -> 2 atoms + 1 imp
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("1 imp", len(cur_imps(rec)), 1)
}

fn test_multiple_synsets_share_hypernym() {
    let text = "SYNSET cat\nWORD cat\nHYPERNYM animal\n"
             + "SYNSET dog\nWORD dog\nHYPERNYM animal\n"
    let r = wn_parse_text(text, "lang", "src:wordnet:t")
    let rec = wn_records(r)[0]
    // atoms: cat, animal, dog = 3 (words dedup with synsets)
    ce_eq("3 atoms", len(cur_atoms(rec)), 3)
    // imps: cat->cat (self-loop from WORD/SYNSET name-collision skipped),
    //       cat->animal FORMAL, dog->animal FORMAL, dog->dog again = 2
    // Actually WORD cat -> SYNSET cat is a self-loop implication -- deliberately
    // kept for shape uniformity. So imps = 2 formal + 2 word->synset = 4.
    ce_eq("4 imps", len(cur_imps(rec)), 4)
}

fn test_comment_ignored() {
    let text = "# top note\nSYNSET x\n# mid\nWORD y\n"
    let r = wn_parse_text(text, "lang", "src:wordnet:t")
    ce_eq("no errors", len(wn_errors(r)), 0)
    let rec = wn_records(r)[0]
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
}

fn main() {
    test_empty()
    test_single_synset_with_words()
    test_hypernym_is_formal()
    test_antonym_records_cite()
    test_directive_before_synset_errors()
    test_multiple_synsets_share_hypernym()
    test_comment_ignored()
    ce_summary("ingest_wordnet")
}

main()
