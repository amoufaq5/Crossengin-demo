// Unit tests for src/ingest/llm_extractor.nova.

import "../ce_test.nova"
import "../../src/ingest/llm_extractor.nova"

fn _write_temp(name, content) {
    let path = "/tmp/_llm_" + name
    write_file(path, content)
    return path
}

fn test_source_rewrite_replaces_bare_tag() {
    let path = _write_temp("bare.cerec",
        "KG demo\nSRC src:pack:medical\nATOM foo 1 500\n")
    let q = rq_new()
    let s = llm_extract_ingest(path, q, "opus5", "run42", 0)
    ce_eq("1 enqueued", llm_sum_enqueued(s), 1)
    let e = rq_entries(q)[0]
    let src = cur_source(rq_record(e))
    // Bare non-extractor tag REPLACED with run prefix.
    ce_check("src starts with extractor prefix",
        str_eq_bytes(src, "src:extractor:llm:opus5:run42") == 1)
}

fn test_source_rewrite_preserves_upstream_extractor() {
    let path = _write_temp("upstream.cerec",
        "KG demo\nSRC src:extractor:llm:other:runX\nATOM foo 1 500\n")
    let q = rq_new()
    llm_extract_ingest(path, q, "opus5", "run42", 0)
    let e = rq_entries(q)[0]
    let src = cur_source(rq_record(e))
    // Extractor tag PRESERVED under our run prefix.
    ce_check("has upstream", str_eq_bytes(src,
        "src:extractor:llm:opus5:run42:upstream:src:extractor:llm:other:runX") == 1)
}

fn test_belief_downgraded() {
    let path = _write_temp("bel.cerec",
        "KG demo\nSRC src:pack:x\nATOM foo 1 950\nATOM bar 1 900\nATOM baz 1 700\n")
    let q = rq_new()
    let s = llm_extract_ingest(path, q, "m", "r", 0)
    // Two beliefs above 800 downgraded.
    ce_eq("2 beliefs downgraded", llm_sum_downgraded_bel(s), 2)
    let e = rq_entries(q)[0]
    let atoms = cur_atoms(rq_record(e))
    ce_eq("foo capped at 800", atoms[0][CUR_ATOM_BELIEF], 800)
    ce_eq("bar capped at 800", atoms[1][CUR_ATOM_BELIEF], 800)
    ce_eq("baz unchanged", atoms[2][CUR_ATOM_BELIEF], 700)
}

fn test_formal_imp_downgraded_to_empirical() {
    let path = _write_temp("imp.cerec",
        "KG demo\nSRC src:x\nATOM a 1 500\nATOM b 1 500\nIMP a b FORMAL\n")
    let q = rq_new()
    let s = llm_extract_ingest(path, q, "m", "r", 0)
    ce_eq("1 imp downgraded", llm_sum_downgraded_imp(s), 1)
    let e = rq_entries(q)[0]
    let imps = cur_imps(rq_record(e))
    ce_eq("imp is EMPIRICAL", imps[0][CUR_IMP_STR], "EMPIRICAL")
}

fn test_every_record_queued_never_direct() {
    let path = _write_temp("multi.cerec",
        "KG a\nSRC src:pack:trusted\nATOM x 1 500\n"
        + "\nKG b\nSRC src:cerec:manual\nATOM y 1 500\n")
    let q = rq_new()
    let s = llm_extract_ingest(path, q, "m", "r", 0)
    // Two records, both queued (never direct even though sources would be trusted).
    ce_eq("2 records", llm_sum_records(s), 2)
    ce_eq("2 enqueued", llm_sum_enqueued(s), 2)
}

fn test_parse_errors_counted() {
    let path = _write_temp("bad.cerec", "BOGUS one two three\nKG a\nSRC src:x\nATOM y 1 500\n")
    let q = rq_new()
    let s = llm_extract_ingest(path, q, "m", "r", 0)
    ce_check("has parse errors", llm_sum_parse_errors(s) >= 1)
    ce_eq("still 1 record enqueued", llm_sum_enqueued(s), 1)
}

fn test_invalid_record_dropped() {
    let path = _write_temp("dropme.cerec", "")
    let q = rq_new()
    let s = llm_extract_ingest(path, q, "m", "r", 0)
    ce_eq("0 records", llm_sum_records(s), 0)
    ce_eq("nothing queued", llm_sum_enqueued(s), 0)
}

fn main() {
    test_source_rewrite_replaces_bare_tag()
    test_source_rewrite_preserves_upstream_extractor()
    test_belief_downgraded()
    test_formal_imp_downgraded_to_empirical()
    test_every_record_queued_never_direct()
    test_parse_errors_counted()
    test_invalid_record_dropped()
    ce_summary("ingest_llm_extractor")
}

main()
