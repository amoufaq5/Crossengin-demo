// Scale test for the hash-indexed mkgc_scan_conflicts.
//
// Seeds N atoms per KG across 4 KGs -- most labels are UNIQUE (so live in
// singleton buckets and cost O(1) to visit), a small controlled subset
// SHARES a label across two KGs with divergent beliefs so the conflict
// count is a known-good invariant. Test verifies both correctness and
// that scan completes at reasonable scale.

import "../ce_test.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn _make_atom(kg, label, seed_alpha, seed_beta) {
    let a = kg_add_atom(kg, ATOM_CONCEPT, label, 0)
    let b = atom_belief(a)
    list_set(b, 0, seed_alpha)
    list_set(b, 1, seed_beta)
    return a
}

fn _seed_unique(kg, prefix, count) {
    let i = 0
    while i < count {
        _make_atom(kg, prefix + int_to_str(i), 4000, 1000)
        i = i + 1
    }
}

fn _int_to_str_wrap(n) {
    return int_to_str(n)
}

fn test_scan_100_atoms_zero_conflicts() {
    let reg = kg_registry_new()
    let a = kg_spawn(reg, "a")
    let b = kg_spawn(reg, "b")
    // 100 unique atoms in each -- no shared labels -> no conflicts.
    _seed_unique(a, "a_", 100)
    _seed_unique(b, "b_", 100)
    let conflicts = mkgc_scan_conflicts(reg, 200)
    ce_eq("no conflicts on disjoint label sets", len(conflicts), 0)
}

fn test_scan_100_atoms_all_shared_same_belief() {
    let reg = kg_registry_new()
    let a = kg_spawn(reg, "a")
    let b = kg_spawn(reg, "b")
    // Same 100 labels in both KGs; identical belief -> no conflicts.
    let i = 0
    while i < 100 {
        _make_atom(a, "shared_" + int_to_str(i), 4000, 1000)
        _make_atom(b, "shared_" + int_to_str(i), 4000, 1000)
        i = i + 1
    }
    let conflicts = mkgc_scan_conflicts(reg, 200)
    ce_eq("matched beliefs -> no conflicts", len(conflicts), 0)
}

fn test_scan_100_atoms_all_shared_opposing_belief() {
    let reg = kg_registry_new()
    let a = kg_spawn(reg, "a")
    let b = kg_spawn(reg, "b")
    // Same 50 labels in both KGs; a believes strongly, b disbelieves strongly.
    // Expect 50 conflicts.
    let i = 0
    while i < 50 {
        _make_atom(a, "shared_" + int_to_str(i), 4500, 500)   // ~900
        _make_atom(b, "shared_" + int_to_str(i), 500, 4500)   // ~100
        i = i + 1
    }
    let conflicts = mkgc_scan_conflicts(reg, 200)
    ce_eq("50 shared labels with opposing beliefs -> 50 conflicts",
          len(conflicts), 50)
}

fn test_scan_across_four_kgs() {
    let reg = kg_registry_new()
    let a = kg_spawn(reg, "kgA")
    let b = kg_spawn(reg, "kgB")
    let c = kg_spawn(reg, "kgC")
    let d = kg_spawn(reg, "kgD")
    // Each KG has 20 unique atoms + "shared" at different beliefs.
    _seed_unique(a, "au_", 20)
    _seed_unique(b, "bu_", 20)
    _seed_unique(c, "cu_", 20)
    _seed_unique(d, "du_", 20)
    _make_atom(a, "shared", 4500, 500)   // mean ~900
    _make_atom(b, "shared", 500, 4500)   // mean ~100
    _make_atom(c, "shared", 4500, 500)   // mean ~900
    _make_atom(d, "shared", 2500, 2500)  // mean 500
    // Conflicts on "shared" between pairs where spread >= 200:
    //   a-b (900-100=800), a-d (900-500=400), b-c (100-900=800),
    //   b-d (100-500=400), c-d (900-500=400). NOT a-c (both 900).
    // Total: 5 conflicts.
    let conflicts = mkgc_scan_conflicts(reg, 200)
    ce_eq("5 pairwise conflicts on shared label across 4 KGs",
          len(conflicts), 5)
}

fn test_singleton_bucket_labels_skipped_efficiently() {
    let reg = kg_registry_new()
    let a = kg_spawn(reg, "a")
    // 500 unique atoms in ONE KG -- every label goes in a bucket,
    // but singletons are skipped so no work happens per label.
    _seed_unique(a, "x_", 500)
    let conflicts = mkgc_scan_conflicts(reg, 100)
    ce_eq("no conflicts (single KG)", len(conflicts), 0)
}

fn main() {
    test_scan_100_atoms_zero_conflicts()
    test_scan_100_atoms_all_shared_same_belief()
    test_scan_100_atoms_all_shared_opposing_belief()
    test_scan_across_four_kgs()
    test_singleton_bucket_labels_skipped_efficiently()
    ce_summary("mkgc_scale")
}

main()
