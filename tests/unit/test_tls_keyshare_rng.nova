// Unit tests for the R91 RNG-backed wire entry points on
// src/net/tls/tls_keyshare.nova: `tls_keyshare_generate` and
// `tls_random_generate`.
//
// Coverage
//   * With a deterministic test RNG, `tls_keyshare_generate` fills
//     both priv_out and pub_out (32 bytes each), returns ok=1, and
//     is byte-identical from a re-seeded ctx (reproducibility).
//   * Two ctxs seeded differently produce different priv/pub outputs.
//   * DH property end-to-end: with two independently-seeded RNGs
//     acting as "Alice" and "Bob", the shared secret computed from
//     (alice_priv, bob_pub) equals the shared secret from
//     (bob_priv, alice_pub) -- the classic DH round-trip.
//   * `tls_random_generate` fills the requested length, is
//     deterministic for a same-seeded ctx, and diverges for different
//     seeds. Length sanity: 0 and negative rejected; over
//     TLS_RANDOM_MAX rejected.
//   * A rigged callback backend that returns ok=0 causes
//     `tls_keyshare_generate` to return 0 (RNG-failure propagation).
//
// NOVA dependencies: ce_test harness, tls_keyshare, x25519, rng.

import "../ce_test.nova"
import "../../src/safety/field25519.nova"
import "../../src/safety/x25519.nova"
import "../../src/safety/rng.nova"
import "../../src/net/tls/tls_keyshare.nova"

// ---- helpers -------------------------------------------------------------

fn _tkr_zero(buf, n) {
    let i = 0
    while i < n { store8(buf + i, 0); i = i + 1 }
}
fn _tkr_bufs_eq(a, na, b, nb) {
    if na != nb { return 0 }
    let i = 0
    while i < na {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}
fn _tkr_buf_nonzero(buf, n) {
    let acc = 0
    let i = 0
    while i < n { acc = int_or(acc, load8(buf + i)); i = i + 1 }
    if acc == 0 { return 0 }
    return 1
}
fn _tkr_seed(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, char_at(s, i)); i = i + 1 }
    store8(buf + n, 0)
    return buf
}

// ---- tls_keyshare_generate: reproducibility ------------------------------

fn test_generate_deterministic_from_same_seed() {
    let seed = _tkr_seed("keyshare-seed-A")
    let rng1 = list_new(); rng_test_new(rng1, seed, 15)
    let rng2 = list_new(); rng_test_new(rng2, seed, 15)

    let priv1 = alloc(33); _tkr_zero(priv1, 32)
    let pub1  = alloc(33); _tkr_zero(pub1, 32)
    let priv2 = alloc(33); _tkr_zero(priv2, 32)
    let pub2  = alloc(33); _tkr_zero(pub2, 32)

    ce_eq("generate 1 ok", tls_keyshare_generate(rng1, priv1, pub1), 1)
    ce_eq("generate 2 ok", tls_keyshare_generate(rng2, priv2, pub2), 1)

    ce_eq("same seed -> same priv",
          _tkr_bufs_eq(priv1, 32, priv2, 32), 1)
    ce_eq("same seed -> same pub",
          _tkr_bufs_eq(pub1, 32, pub2, 32), 1)
    ce_eq("priv is non-zero", _tkr_buf_nonzero(priv1, 32), 1)
    ce_eq("pub is non-zero", _tkr_buf_nonzero(pub1, 32), 1)
}

fn test_generate_different_seeds_diverge() {
    let sa = _tkr_seed("alice-keyshare-seed")
    let sb = _tkr_seed("bob-keyshare-seed")
    let rng_a = list_new(); rng_test_new(rng_a, sa, len("alice-keyshare-seed"))
    let rng_b = list_new(); rng_test_new(rng_b, sb, len("bob-keyshare-seed"))

    let priv_a = alloc(33); _tkr_zero(priv_a, 32)
    let pub_a  = alloc(33); _tkr_zero(pub_a, 32)
    let priv_b = alloc(33); _tkr_zero(priv_b, 32)
    let pub_b  = alloc(33); _tkr_zero(pub_b, 32)

    tls_keyshare_generate(rng_a, priv_a, pub_a)
    tls_keyshare_generate(rng_b, priv_b, pub_b)

    ce_eq("different seed -> different priv",
          _tkr_bufs_eq(priv_a, 32, priv_b, 32), 0)
    ce_eq("different seed -> different pub",
          _tkr_bufs_eq(pub_a, 32, pub_b, 32), 0)
}

// ---- DH round-trip via wire entry point ---------------------------------

fn test_dh_property_end_to_end() {
    // Simulate a full ECDH round-trip through the wire helper.
    let sa = _tkr_seed("alice-dh-seed-2026")
    let sb = _tkr_seed("bob-dh-seed-2026-2")
    let rng_a = list_new(); rng_test_new(rng_a, sa, len("alice-dh-seed-2026"))
    let rng_b = list_new(); rng_test_new(rng_b, sb, len("bob-dh-seed-2026-2"))

    let priv_a = alloc(33); _tkr_zero(priv_a, 32)
    let pub_a  = alloc(33); _tkr_zero(pub_a, 32)
    let priv_b = alloc(33); _tkr_zero(priv_b, 32)
    let pub_b  = alloc(33); _tkr_zero(pub_b, 32)
    ce_eq("alice keyshare ok", tls_keyshare_generate(rng_a, priv_a, pub_a), 1)
    ce_eq("bob keyshare ok", tls_keyshare_generate(rng_b, priv_b, pub_b), 1)

    let shared_ab = alloc(33); _tkr_zero(shared_ab, 32)
    let shared_ba = alloc(33); _tkr_zero(shared_ba, 32)
    ce_eq("x25519(alice_priv, bob_pub) ok",
          x25519(shared_ab, priv_a, pub_b), 1)
    ce_eq("x25519(bob_priv, alice_pub) ok",
          x25519(shared_ba, priv_b, pub_a), 1)
    ce_eq("DH property: shared_ab == shared_ba",
          _tkr_bufs_eq(shared_ab, 32, shared_ba, 32), 1)
    ce_eq("shared secret is non-zero", _tkr_buf_nonzero(shared_ab, 32), 1)
}

// ---- tls_random_generate --------------------------------------------------

fn test_random_generate_length_and_determinism() {
    let seed = _tkr_seed("random-seed-32")
    let r1 = list_new(); rng_test_new(r1, seed, 14)
    let r2 = list_new(); rng_test_new(r2, seed, 14)
    let out1 = alloc(33); _tkr_zero(out1, 32)
    let out2 = alloc(33); _tkr_zero(out2, 32)
    ce_eq("random 32B ok r1", tls_random_generate(r1, out1, 32), 1)
    ce_eq("random 32B ok r2", tls_random_generate(r2, out2, 32), 1)
    ce_eq("same seed -> same 32B random",
          _tkr_bufs_eq(out1, 32, out2, 32), 1)
    ce_eq("random 32B non-zero", _tkr_buf_nonzero(out1, 32), 1)
}

fn test_random_generate_diverges_on_seed() {
    let sa = _tkr_seed("nonce-A-1")
    let sb = _tkr_seed("nonce-B-2")
    let r1 = list_new(); rng_test_new(r1, sa, 9)
    let r2 = list_new(); rng_test_new(r2, sb, 9)
    let out1 = alloc(33); _tkr_zero(out1, 32)
    let out2 = alloc(33); _tkr_zero(out2, 32)
    tls_random_generate(r1, out1, 32)
    tls_random_generate(r2, out2, 32)
    ce_eq("different seed -> different random",
          _tkr_bufs_eq(out1, 32, out2, 32), 0)
}

fn test_random_generate_length_bounds() {
    let seed = _tkr_seed("bounds-seed")
    let r = list_new(); rng_test_new(r, seed, 11)
    let out = alloc(2)
    ce_eq("random len=0 rejected", tls_random_generate(r, out, 0), 0)
    ce_eq("random len=-1 rejected", tls_random_generate(r, out, 0 - 1), 0)
    ce_eq("random len > TLS_RANDOM_MAX rejected",
          tls_random_generate(r, out, TLS_RANDOM_MAX + 1), 0)
    // Boundary: TLS_RANDOM_MAX is accepted.
    let big = alloc(TLS_RANDOM_MAX + 1)
    _tkr_zero(big, TLS_RANDOM_MAX)
    ce_eq("random len == TLS_RANDOM_MAX ok",
          tls_random_generate(r, big, TLS_RANDOM_MAX), 1)
    ce_eq("random TLS_RANDOM_MAX non-zero",
          _tkr_buf_nonzero(big, TLS_RANDOM_MAX), 1)
}

// ---- RNG failure propagation --------------------------------------------

fn _tkr_cb_always_fail(out_buf, out_len) {
    // Do not touch out_buf; force ok=0 back through the interface.
    return 0
}

fn test_generate_rejects_when_rng_fails() {
    let ctx = list_new()
    ce_eq("failing-cb ctx built",
          rng_callback_new(ctx, _tkr_cb_always_fail), 1)
    let priv = alloc(33); _tkr_zero(priv, 32)
    let pub  = alloc(33); _tkr_zero(pub, 32)
    ce_eq("tls_keyshare_generate propagates RNG failure",
          tls_keyshare_generate(ctx, priv, pub), 0)
    let nonce = alloc(33); _tkr_zero(nonce, 32)
    ce_eq("tls_random_generate propagates RNG failure",
          tls_random_generate(ctx, nonce, 32), 0)
}

// ---- run -----------------------------------------------------------------

fn main() {
    test_generate_deterministic_from_same_seed()
    test_generate_different_seeds_diverge()
    test_dh_property_end_to_end()
    test_random_generate_length_and_determinism()
    test_random_generate_diverges_on_seed()
    test_random_generate_length_bounds()
    test_generate_rejects_when_rng_fails()
    ce_summary("tls_keyshare_rng")
}

main()
