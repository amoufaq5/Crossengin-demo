// Unit tests for src/persistence/merkle_signing.nova (R16A).
//
// Verifies the Ed25519 sign + verify path over Merkle snapshot roots:
//
//   * Sign a known root with a known private key -> the same
//     signature every time (Ed25519 is deterministic, not
//     probabilistic). This is the property snapshot determinism
//     (two /save calls on an unchanged KG produce bit-identical
//     files) inherits from R15E + R16A combined.
//   * Verify the legit signature -> 1.
//   * Tampered signature (single-bit flip) -> 0.
//   * Wrong pubkey -> 0.
//   * Wrong root -> 0.
//   * Bad-shape inputs (wrong-length sig, hex, etc.) -> 0.
//   * Hex codec round-trips: sign_hex / verify_signature_hex.
//   * Root-bytes-from-hex helper handles bad lengths cleanly.
//   * Keypair save + load round-trips bit-identical.
//   * Lone-pubkey save + load round-trip (verifier-side artefact).
//   * Loading a keypair from a non-existent path returns 0
//     (graceful failure, not crash).
//
// Backward-compat policy assertion:
//   A snapshot with no `meta.merkle_signature` line that the writer
//   produced under no CE_SNAPSHOT_SIGN_KEY env reads back into
//   `snap_meta_has_merkle_signature(s) == 0`. The verifier
//   (`snap_verify_signature`) returns -1 ("no signature on file")
//   when the file lacks the line. This unit test pins the LENIENT
//   policy: an unsigned file passes through `snap_load` unless
//   CE_SNAPSHOT_REQUIRE_SIGNATURE=1 is set (which strict-flips it).
//
// NOVA dependencies: ce_test harness.
// CrossEngin dependencies:
//   src/persistence/merkle_signing.nova,
//   src/safety/ed25519.nova (for deriving fresh pubkeys + sigs).

import "../ce_test.nova"
import "../../src/persistence/merkle_signing.nova"
import "../../src/safety/ed25519.nova"

// ---- helpers -------------------------------------------------------------

// A known 32-byte "root" -- the SHA-256 of "abc" per FIPS 180-4. Used
// as a stand-in for the Merkle root; doesn't matter what it is so
// long as it's stable and 32 bytes.
let _T_ROOT_HEX = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

// RFC 8032 test vector #1 sk -- a known seed so the test signatures
// are also bit-identical to a reference. The matching pubkey is
// pinned in test_ed25519.nova as well; we re-derive it here so the
// test doesn't have to import the literal.
let _T_SK_HEX = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"

// A second, distinct known sk so we can build a "wrong pubkey" pair.
let _T_SK2_HEX = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"

// Derive (seed_bytes, pk_bytes) from a hex seed.
fn _t_keypair_from_hex(sk_hex) {
    let seed = ed25519_hex_to_bytes(sk_hex)
    let parts = _ed_derive_a_and_prefix(seed)
    let pk = _ed_pk_from_a(parts[0])
    let r = list_new()
    push(r, seed)
    push(r, pk)
    return r
}

// Bit-flip on a byte list copy at offset `off`, bit `bit`.
fn _t_flip(bytes, off, bit) {
    let out = list_new()
    let i = 0
    while i < len(bytes) {
        push(out, bytes[i])
        i = i + 1
    }
    list_set(out, off, int_xor(out[off], int_shl(1, bit)))
    return out
}

// ---- root-bytes helper ---------------------------------------------------

fn test_root_bytes_from_hex_round_trip() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    ce_check("root bytes non-zero", root != 0)
    ce_eq("root has 32 bytes", len(root), 32)
    ce_eq("byte 0 = 0xba", root[0], 186)
    ce_eq("byte 31 = 0xad", root[31], 173)
}

fn test_root_bytes_from_hex_bad_shape() {
    let r1 = merkle_root_bytes_from_hex("deadbeef")
    ce_check("short hex rejected", r1 == 0)
    let r2 = merkle_root_bytes_from_hex(
        "z" + substr(_T_ROOT_HEX, 1, len(_T_ROOT_HEX) - 1))
    ce_check("non-hex char rejected", r2 == 0)
    let r3 = merkle_root_bytes_from_hex(0)
    ce_check("zero input rejected", r3 == 0)
}

// ---- sign + verify -------------------------------------------------------

fn test_sign_returns_64_byte_signature() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig = merkle_sign(root, kp[0], kp[1])
    ce_check("sig non-zero", sig != 0)
    ce_eq("sig has 64 bytes", len(sig), 64)
}

fn test_sign_is_deterministic() {
    // Ed25519 (RFC 8032 PureEdDSA) is deterministic: the same
    // (message, seed, pk) tuple always yields the same signature.
    // This is the property snapshot determinism relies on.
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig1 = merkle_sign(root, kp[0], kp[1])
    let sig2 = merkle_sign(root, kp[0], kp[1])
    let sig3 = merkle_sign(root, kp[0], kp[1])
    ce_eq("len(sig1) == len(sig2)", len(sig1), len(sig2))
    ce_eq("len(sig1) == len(sig3)", len(sig1), len(sig3))
    let i = 0
    let ok12 = 1
    let ok13 = 1
    while i < 64 {
        if sig1[i] != sig2[i] { ok12 = 0 }
        if sig1[i] != sig3[i] { ok13 = 0 }
        i = i + 1
    }
    ce_check("sig1 == sig2 byte-for-byte (determinism)", ok12 == 1)
    ce_check("sig1 == sig3 byte-for-byte (determinism)", ok13 == 1)
}

fn test_verify_accepts_legit_signature() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig = merkle_sign(root, kp[0], kp[1])
    let ok = merkle_verify_signature(root, sig, kp[1])
    ce_eq("legit signature verifies", ok, 1)
}

fn test_verify_rejects_tampered_signature() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig = merkle_sign(root, kp[0], kp[1])
    // Flip bit 0 in byte 0 of the signature.
    let bad = _t_flip(sig, 0, 0)
    let ok = merkle_verify_signature(root, bad, kp[1])
    ce_eq("bit-flipped sig rejected", ok, 0)
    // Flip bit 5 in byte 32 (the s half).
    let bad2 = _t_flip(sig, 32, 5)
    let ok2 = merkle_verify_signature(root, bad2, kp[1])
    ce_eq("bit-flipped s-half rejected", ok2, 0)
    // Original still verifies (defensive: prove we didn't ruin it).
    ce_eq("original still verifies after copy", merkle_verify_signature(root, sig, kp[1]), 1)
}

fn test_verify_rejects_wrong_pubkey() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp_alice = _t_keypair_from_hex(_T_SK_HEX)
    let kp_bob = _t_keypair_from_hex(_T_SK2_HEX)
    let sig_alice = merkle_sign(root, kp_alice[0], kp_alice[1])
    // Alice's sig verifies under Alice's pubkey.
    ce_eq("Alice sig + Alice pk verifies",
          merkle_verify_signature(root, sig_alice, kp_alice[1]), 1)
    // ...but not under Bob's pubkey.
    ce_eq("Alice sig + Bob pk rejected",
          merkle_verify_signature(root, sig_alice, kp_bob[1]), 0)
}

fn test_verify_rejects_wrong_root() {
    let root_a = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    // A different root (sha256 of "" = the empty-tree sentinel).
    let root_b = merkle_root_bytes_from_hex(
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig = merkle_sign(root_a, kp[0], kp[1])
    ce_eq("sig over root_a verifies against root_a",
          merkle_verify_signature(root_a, sig, kp[1]), 1)
    ce_eq("sig over root_a does NOT verify against root_b",
          merkle_verify_signature(root_b, sig, kp[1]), 0)
}

// ---- shape validation ----------------------------------------------------

fn test_sign_bad_shapes_return_zero() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    // zero inputs.
    ce_check("zero root => sign==0", merkle_sign(0, kp[0], kp[1]) == 0)
    ce_check("zero seed => sign==0", merkle_sign(root, 0, kp[1]) == 0)
    ce_check("zero pk => sign==0",   merkle_sign(root, kp[0], 0) == 0)
    // short root.
    let short_root = list_new()
    let i = 0
    while i < 16 { push(short_root, 0); i = i + 1 }
    ce_check("short root => sign==0",
             merkle_sign(short_root, kp[0], kp[1]) == 0)
}

fn test_verify_bad_shapes_return_zero() {
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig = merkle_sign(root, kp[0], kp[1])
    // Verify is strict on shapes.
    ce_eq("zero root => 0",   merkle_verify_signature(0, sig, kp[1]), 0)
    ce_eq("zero sig => 0",    merkle_verify_signature(root, 0, kp[1]), 0)
    ce_eq("zero pk => 0",     merkle_verify_signature(root, sig, 0), 0)
    let short_sig = list_new()
    let i = 0
    while i < 63 { push(short_sig, 0); i = i + 1 }
    ce_eq("short sig => 0", merkle_verify_signature(root, short_sig, kp[1]), 0)
}

// ---- hex round-trip helpers ---------------------------------------------

fn test_sign_hex_round_trip() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig_hex = merkle_sign_hex(_T_ROOT_HEX, kp[0], kp[1])
    ce_eq("sig hex length = 128", len(sig_hex), 128)
    // Re-hexify the pubkey for verify_signature_hex.
    let pk_hex = ed25519_bytes_to_hex(kp[1])
    ce_eq("pk hex length = 64", len(pk_hex), 64)
    let ok = merkle_verify_signature_hex(_T_ROOT_HEX, sig_hex, pk_hex)
    ce_eq("verify_signature_hex accepts the round-trip", ok, 1)
}

fn test_sign_hex_is_deterministic() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let s1 = merkle_sign_hex(_T_ROOT_HEX, kp[0], kp[1])
    let s2 = merkle_sign_hex(_T_ROOT_HEX, kp[0], kp[1])
    ce_str_eq("two sign_hex calls produce the same hex", s1, s2)
}

fn test_verify_signature_hex_rejects_tampered() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig_hex = merkle_sign_hex(_T_ROOT_HEX, kp[0], kp[1])
    let pk_hex = ed25519_bytes_to_hex(kp[1])
    // Flip a hex char in the signature.
    let first = char_at(sig_hex, 0)
    let new_first = chr(first + 1)
    if first == 102 { new_first = chr(48) }     // 'f' -> '0' wraparound
    let tampered = new_first + substr(sig_hex, 1, len(sig_hex) - 1)
    let ok = merkle_verify_signature_hex(_T_ROOT_HEX, tampered, pk_hex)
    ce_eq("hex-tampered sig rejected", ok, 0)
}

fn test_verify_signature_hex_bad_shapes() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig_hex = merkle_sign_hex(_T_ROOT_HEX, kp[0], kp[1])
    let pk_hex = ed25519_bytes_to_hex(kp[1])
    // Short sig hex.
    ce_eq("short sig hex rejected",
          merkle_verify_signature_hex(_T_ROOT_HEX, "deadbeef", pk_hex), 0)
    // Short pk hex.
    ce_eq("short pk hex rejected",
          merkle_verify_signature_hex(_T_ROOT_HEX, sig_hex, "deadbeef"), 0)
    // Short root hex.
    ce_eq("short root hex rejected",
          merkle_verify_signature_hex("deadbeef", sig_hex, pk_hex), 0)
}

// ---- keypair save / load round-trip --------------------------------------

fn test_keypair_save_load_round_trip() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let base = "/tmp/ce_test_merkle_signing_kp"
    let saved = merkle_signing_keypair_save(kp[0], kp[1], base)
    ce_eq("save returns 1", saved, 1)
    let loaded = merkle_signing_keypair_load(base)
    ce_check("load returns non-zero", loaded != 0)
    ce_eq("loaded has 2 entries", len(loaded), 2)
    ce_eq("loaded seed has 32 bytes", len(loaded[0]), 32)
    ce_eq("loaded pk has 32 bytes", len(loaded[1]), 32)
    // Byte-for-byte equality.
    let i = 0
    let seed_ok = 1
    while i < 32 {
        if loaded[0][i] != kp[0][i] { seed_ok = 0 }
        i = i + 1
    }
    ce_check("seed round-trips bit-identical", seed_ok == 1)
    let j = 0
    let pk_ok = 1
    while j < 32 {
        if loaded[1][j] != kp[1][j] { pk_ok = 0 }
        j = j + 1
    }
    ce_check("pk round-trips bit-identical", pk_ok == 1)
    // The round-tripped pair signs + verifies the same as the original.
    let root = merkle_root_bytes_from_hex(_T_ROOT_HEX)
    let sig_orig = merkle_sign(root, kp[0], kp[1])
    let sig_loaded = merkle_sign(root, loaded[0], loaded[1])
    let k = 0
    let sigs_ok = 1
    while k < 64 {
        if sig_orig[k] != sig_loaded[k] { sigs_ok = 0 }
        k = k + 1
    }
    ce_check("sig from loaded pair == sig from original pair (determinism)",
             sigs_ok == 1)
    // Clean up.
    sys_unlink(base + ".priv")
    sys_unlink(base + ".pub")
}

fn test_keypair_load_missing_returns_zero() {
    // No file at this base path -- the load must return 0 (graceful).
    let r = merkle_signing_keypair_load("/tmp/ce_test_merkle_signing_no_such_kp")
    ce_check("load on missing path => 0", r == 0)
}

fn test_pubkey_only_round_trip() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let pub_path = "/tmp/ce_test_merkle_signing_pk_only.pub"
    let ok = merkle_signing_pubkey_save(kp[1], pub_path)
    ce_eq("pubkey-only save returns 1", ok, 1)
    let loaded = merkle_signing_pubkey_load(pub_path)
    ce_check("pubkey-only load returns non-zero", loaded != 0)
    ce_eq("loaded pk has 32 bytes", len(loaded), 32)
    let i = 0
    let pk_ok = 1
    while i < 32 {
        if loaded[i] != kp[1][i] { pk_ok = 0 }
        i = i + 1
    }
    ce_check("pubkey-only round-trips bit-identical", pk_ok == 1)
    sys_unlink(pub_path)
}

// ---- end-to-end: tamper detection via the env-var verify path -----------

fn test_env_verify_via_env_no_pubkey_returns_neg_1() {
    // CE_SNAPSHOT_VERIFY_PUBKEY is NOT set in this test process
    // (tests don't manipulate env), so the env-driven verify path
    // returns -1 = "no pubkey configured".
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let sig_hex = merkle_sign_hex(_T_ROOT_HEX, kp[0], kp[1])
    let r = merkle_signing_verify_via_env(_T_ROOT_HEX, sig_hex)
    ce_eq("verify_via_env without pubkey returns -1", r, 0 - 1)
}

// ---- driver --------------------------------------------------------------

fn main() {
    test_root_bytes_from_hex_round_trip()
    test_root_bytes_from_hex_bad_shape()
    test_sign_returns_64_byte_signature()
    test_sign_is_deterministic()
    test_verify_accepts_legit_signature()
    test_verify_rejects_tampered_signature()
    test_verify_rejects_wrong_pubkey()
    test_verify_rejects_wrong_root()
    test_sign_bad_shapes_return_zero()
    test_verify_bad_shapes_return_zero()
    test_sign_hex_round_trip()
    test_sign_hex_is_deterministic()
    test_verify_signature_hex_rejects_tampered()
    test_verify_signature_hex_bad_shapes()
    test_keypair_save_load_round_trip()
    test_keypair_load_missing_returns_zero()
    test_pubkey_only_round_trip()
    test_env_verify_via_env_no_pubkey_returns_neg_1()
    ce_summary("merkle_signing")
}
main()
