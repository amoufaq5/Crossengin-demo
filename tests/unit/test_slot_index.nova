// Unit tests for src/reader/slot_index.nova
//
// P2.2: syntactic-slot similarity side-index from output generation. The
// slot table is keyed by (pattern_atom_id, role_name) and stores a histogram
// of atom-ids that have filled that slot. Two atoms are role-neighbors iff
// they appear in the same (pattern, role) cell; the similarity is
// normalized by the slot's most-frequent filler.

import "../ce_test.nova"
import "../../src/reader/slot_index.nova"

// ---- test 1: empty index returns 0 -----------------------------------------
fn test_empty_index() {
    let si = si_new()
    ce_eq("empty: size 0", si_size(si), 0)
    ce_eq("empty: fill count 0", si_fill_count(si, 100, "AGENT", 1), 0)
    ce_eq("empty: strength 0", si_strength(si, 1, 2), 0)
}

// ---- test 2: record a single fill ------------------------------------------
fn test_single_fill() {
    let si = si_new()
    let n = si_record_fill(si, 100, "AGENT", 1)
    ce_eq("first fill: count 1", n, 1)
    ce_eq("slot count is 1", si_size(si), 1)
    ce_eq("fill count(100, AGENT, 1)", si_fill_count(si, 100, "AGENT", 1), 1)
    // No second atom in this slot yet -> no role-neighbor.
    ce_eq("solo filler has no neighbor", si_strength(si, 1, 99), 0)
}

// ---- test 3: two atoms co-filling the same role return high similarity ----
fn test_corole_high_similarity() {
    let si = si_new()
    si_record_fill(si, 100, "AGENT", 1)
    si_record_fill(si, 100, "AGENT", 2)
    // Both filled the slot once. slot_max = 1 -> min(1,1)*1000/1 = 1000.
    ce_eq("co-role atoms: 1000", si_strength(si, 1, 2), 1000)
    ce_eq("symmetric", si_strength(si, 2, 1), 1000)
}

// ---- test 4: different roles return 0 --------------------------------------
fn test_different_roles_zero() {
    let si = si_new()
    si_record_fill(si, 100, "AGENT", 1)
    si_record_fill(si, 100, "PATIENT", 2)
    // Same pattern, different roles -> no slot in common.
    ce_eq("different roles: 0", si_strength(si, 1, 2), 0)
}

// ---- test 5: different patterns same role -- still no overlap -------------
fn test_different_patterns_zero() {
    let si = si_new()
    si_record_fill(si, 100, "AGENT", 1)
    si_record_fill(si, 200, "AGENT", 2)
    // Different patterns -> the (pat=100, AGENT) cell only has atom 1; the
    // (pat=200, AGENT) cell only has atom 2.
    ce_eq("different patterns: 0", si_strength(si, 1, 2), 0)
}

// ---- test 6: rarer co-filler bounded by min(count_a, count_b) -------------
fn test_min_bounded_strength() {
    let si = si_new()
    // Atom 1 fills the slot 10 times.
    let i = 0
    while i < 10 {
        si_record_fill(si, 100, "AGENT", 1)
        i = i + 1
    }
    // Atom 2 fills the slot 2 times.
    si_record_fill(si, 100, "AGENT", 2)
    si_record_fill(si, 100, "AGENT", 2)
    ce_eq("slot count 1", si_size(si), 1)
    // slot_max = 10, lo = min(10, 2) = 2 -> 2*1000/10 = 200.
    ce_eq("rare-with-frequent bounded by rare", si_strength(si, 1, 2), 200)
}

// ---- test 7: fill counts accumulate ----------------------------------------
fn test_fill_counts_accumulate() {
    let si = si_new()
    let i = 0
    while i < 3 {
        si_record_fill(si, 100, "AGENT", 7)
        i = i + 1
    }
    ce_eq("count after 3 fills", si_fill_count(si, 100, "AGENT", 7), 3)
}

// ---- test 8: multiple slots same atom -- strength sums and clamps ---------
fn test_multi_slot_sums() {
    let si = si_new()
    // Two slots: (100, AGENT) and (100, PATIENT). Atom 1 and atom 2 both
    // fill both slots once.
    si_record_fill(si, 100, "AGENT", 1)
    si_record_fill(si, 100, "AGENT", 2)
    si_record_fill(si, 100, "PATIENT", 1)
    si_record_fill(si, 100, "PATIENT", 2)
    // Each slot contributes 1000 -> sum 2000 -> clamped to 1000.
    ce_eq("multi-slot clamped 1000", si_strength(si, 1, 2), 1000)
}

// ---- test 9: invalid inputs return 0 ---------------------------------------
// Sentinels we DO reject: nil si (0), self-pair (a == b), pattern_id 0,
// empty role string. atom_id 0 is a VALID filler (first-born atom of each
// KG starts at id 0), so it is intentionally NOT a sentinel.
fn test_invalid_inputs() {
    let si = si_new()
    si_record_fill(si, 100, "AGENT", 1)
    si_record_fill(si, 100, "AGENT", 2)
    ce_eq("self -> 0",      si_strength(si, 1, 1), 0)
    ce_eq("nil si -> 0",    si_strength(0, 1, 2), 0)
    // Invalid recordings -> 0 (no slot created).
    ce_eq("nil si record",  si_record_fill(0, 100, "AGENT", 1), 0)
    ce_eq("zero pattern",   si_record_fill(si, 0, "AGENT", 1), 0)
    // atom_id 0 with a valid pattern/role IS recorded (counts as a fill).
    let before = si_size(si)
    let n = si_record_fill(si, 200, "AGENT", 0)
    ce_eq("atom-id 0 IS a valid filler", n, 1)
    ce_eq("a new slot was created",      si_size(si), before + 1)
}

// ---- test 10: si_neighbors enumeration -------------------------------------
fn test_neighbors_listing() {
    let si = si_new()
    si_record_fill(si, 100, "AGENT", 1)
    si_record_fill(si, 100, "AGENT", 2)
    si_record_fill(si, 100, "AGENT", 3)
    // Atom 1's role-neighbors are atoms 2 and 3, at strength 1000 each
    // (slot_max is 1 and lo is 1 for each pair).
    let nbrs = si_neighbors(si, "lang", 1, 1000)
    ce_eq("atom 1 has 2 role-neighbors", len(nbrs), 2)
    let ok = 1
    let i = 0
    while i < len(nbrs) {
        if nbrs[i][1] != 1000 { ok = 0 }
        i = i + 1
    }
    ce_eq("each role-neighbor at max strength", ok, 1)
}

fn main() {
    test_empty_index()
    test_single_fill()
    test_corole_high_similarity()
    test_different_roles_zero()
    test_different_patterns_zero()
    test_min_bounded_strength()
    test_fill_counts_accumulate()
    test_multi_slot_sums()
    test_invalid_inputs()
    test_neighbors_listing()
    ce_summary("slot_index")
}

main()
