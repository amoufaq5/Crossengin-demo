// Unit tests for src/skills/skill_registry.nova (ADR-0103).

import "../ce_test.nova"
import "../../src/skills/skill_registry.nova"

fn _mkm(name, ver) {
    return skill_manifest_new(name, ver, "test skill", 1)
}

fn test_new_empty() {
    let r = skill_registry_new()
    ce_eq("count 0", skill_registry_count(r), 0)
    ce_check("lookup missing = 0", skill_registry_lookup(r, "echo") == 0)
    ce_eq("no manifest", skill_registry_manifest(r, "echo"), 0)
    ce_eq("not installed", skill_registry_is_installed(r, "echo"), 0)
    ce_eq("no supervisor", skill_registry_supervisor(r, "echo"), 0)
}

fn test_register_and_lookup() {
    let r = skill_registry_new()
    let m = _mkm("echo", "1.0.0")
    ce_eq("register ok", skill_registry_register(r, m), 1)
    ce_eq("count 1", skill_registry_count(r), 1)
    let e = skill_registry_lookup(r, "echo")
    ce_check("entry found", e != 0)
    ce_check("manifest matches",
             skill_registry_manifest(r, "echo") == m)
    ce_eq("not installed yet", skill_registry_is_installed(r, "echo"), 0)
    // Duplicate register rejected.
    let m2 = _mkm("echo", "2.0.0")
    ce_eq("dup register rejected", skill_registry_register(r, m2), 0)
    ce_eq("count still 1", skill_registry_count(r), 1)
}

fn test_install_unknown_skill() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    let code = skill_registry_install(r, "missing", capreg, 42, 100)
    ce_eq("unknown code", code, SKILL_INSTALL_UNKNOWN)
    ce_eq("name", skill_install_name(code), "unknown-skill")
}

fn test_install_no_deps_ok() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    skill_registry_register(r, _mkm("echo", "1.0.0"))
    let code = skill_registry_install(r, "echo", capreg, 42, 100)
    ce_eq("ok", code, SKILL_INSTALL_OK)
    ce_eq("installed", skill_registry_is_installed(r, "echo"), 1)
    ce_eq("supervisor handle", skill_registry_supervisor(r, "echo"), 42)
    // Double install refused.
    ce_eq("already", skill_registry_install(r, "echo", capreg, 99, 200),
          SKILL_INSTALL_ALREADY)
}

fn test_install_with_deps_capsule_missing() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    let m = _mkm("coding_helper", "1.0.0")
    skill_manifest_add_capsule_dep(m, "coding", "1.0.0")
    skill_registry_register(r, m)
    let code = skill_registry_install(r, "coding_helper", capreg, 1, 100)
    ce_eq("dep missing", code, SKILL_INSTALL_DEP_MISSING)
    ce_eq("not installed", skill_registry_is_installed(r, "coding_helper"), 0)
}

fn test_install_with_deps_capsule_registered_but_not_installed() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    // Register the capsule but DO NOT install it.
    let cap = capsule_new("coding", "1.0.0", "coding capsule", "MIT")
    capreg_register(capreg, cap)
    let m = _mkm("coding_helper", "1.0.0")
    skill_manifest_add_capsule_dep(m, "coding", "1.0.0")
    skill_registry_register(r, m)
    let code = skill_registry_install(r, "coding_helper", capreg, 1, 100)
    ce_eq("dep not installed", code, SKILL_INSTALL_DEP_NOT_INSTALLED)
    ce_eq("skill not installed", skill_registry_is_installed(r, "coding_helper"), 0)
}

fn test_install_with_deps_all_satisfied() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    let cap = capsule_new("coding", "1.0.0", "coding capsule", "MIT")
    capreg_register(capreg, cap)
    capreg_install(capreg, "coding", 50)
    let m = _mkm("coding_helper", "1.0.0")
    skill_manifest_add_capsule_dep(m, "coding", "1.0.0")
    skill_registry_register(r, m)
    let code = skill_registry_install(r, "coding_helper", capreg, 77, 100)
    ce_eq("ok", code, SKILL_INSTALL_OK)
    ce_eq("installed", skill_registry_is_installed(r, "coding_helper"), 1)
    ce_eq("supervisor", skill_registry_supervisor(r, "coding_helper"), 77)
}

fn test_uninstall() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    skill_registry_register(r, _mkm("echo", "1.0.0"))
    skill_registry_install(r, "echo", capreg, 42, 100)
    ce_eq("uninstall ok", skill_registry_uninstall(r, "echo"), 1)
    ce_eq("not installed after", skill_registry_is_installed(r, "echo"), 0)
    ce_eq("no supervisor after", skill_registry_supervisor(r, "echo"), 0)
    // Double uninstall no-op.
    ce_eq("uninstall already off = 0", skill_registry_uninstall(r, "echo"), 0)
    // Manifest still there.
    ce_check("manifest preserved", skill_registry_manifest(r, "echo") != 0)
    ce_eq("count still 1 (manifest kept)", skill_registry_count(r), 1)
}

fn test_remove() {
    let r = skill_registry_new()
    skill_registry_register(r, _mkm("a", "1.0.0"))
    skill_registry_register(r, _mkm("b", "1.0.0"))
    skill_registry_register(r, _mkm("c", "1.0.0"))
    ce_eq("count 3", skill_registry_count(r), 3)
    ce_eq("remove b", skill_registry_remove(r, "b"), 1)
    ce_eq("count 2", skill_registry_count(r), 2)
    ce_check("b gone", skill_registry_lookup(r, "b") == 0)
    ce_check("a still there", skill_registry_lookup(r, "a") != 0)
    ce_check("c still there", skill_registry_lookup(r, "c") != 0)
    ce_eq("remove missing = 0", skill_registry_remove(r, "z"), 0)
}

fn test_listing_helpers() {
    let r = skill_registry_new()
    let capreg = capreg_new()
    skill_registry_register(r, _mkm("a", "1.0.0"))
    skill_registry_register(r, _mkm("b", "1.0.0"))
    skill_registry_register(r, _mkm("c", "1.0.0"))
    skill_registry_install(r, "a", capreg, 1, 100)
    skill_registry_install(r, "c", capreg, 3, 100)
    let all = skill_registry_names(r)
    ce_eq("3 registered", len(all), 3)
    let installed = skill_registry_installed_names(r)
    ce_eq("2 installed", len(installed), 2)
    // Order preserved (registration order).
    ce_str_eq("first installed a", installed[0], "a")
    ce_str_eq("second installed c", installed[1], "c")
}

fn test_null_capreg_trusts() {
    // Passing 0 for capreg is a test convenience: skip dep checking.
    let r = skill_registry_new()
    let m = _mkm("bold", "1.0.0")
    skill_manifest_add_capsule_dep(m, "nonexistent", "1.0.0")
    skill_registry_register(r, m)
    // With capreg=0, install succeeds despite the missing dep.
    ce_eq("null capreg trusts",
          skill_registry_install(r, "bold", 0, 42, 100), SKILL_INSTALL_OK)
    ce_eq("installed", skill_registry_is_installed(r, "bold"), 1)
}

fn main() {
    test_new_empty()
    test_register_and_lookup()
    test_install_unknown_skill()
    test_install_no_deps_ok()
    test_install_with_deps_capsule_missing()
    test_install_with_deps_capsule_registered_but_not_installed()
    test_install_with_deps_all_satisfied()
    test_uninstall()
    test_remove()
    test_listing_helpers()
    test_null_capreg_trusts()
    ce_summary("skill_registry")
}

main()
