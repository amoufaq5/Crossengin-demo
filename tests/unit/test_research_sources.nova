// Unit tests for src/learning/research_sources.nova -- R53 multi-source,
// disambiguation-aware research candidate construction (pure, no network).

import "../ce_test.nova"
import "../../src/learning/research_sources.nova"

fn _has_cand(cands, label, url) {
    let i = 0
    while i < len(cands) {
        if str_eq(research_cand_label(cands[i]), label) == 1 {
            if str_eq(research_cand_url(cands[i]), url) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

fn test_cap_first() {
    ce_str_eq("capitalize lowercase", research_cap_first("photosynthesis"), "Photosynthesis")
    ce_str_eq("already-capital preserved", research_cap_first("DNA"), "DNA")
    ce_str_eq("single char capitalized", research_cap_first("x"), "X")
    ce_str_eq("empty stays empty", research_cap_first(""), "")
    ce_str_eq("only first letter touched", research_cap_first("cat"), "Cat")
}

fn test_wiki_path_underscores() {
    ce_str_eq("spaces to underscores", research_wiki_path("Black hole"), "Black_hole")
    ce_str_eq("no spaces unchanged", research_wiki_path("Cat"), "Cat")
}

fn test_canonical_first() {
    let c = research_candidates("photosynthesis")
    ce_check("has at least one candidate", len(c) >= 1)
    ce_str_eq("first source is en.wikipedia", research_cand_label(c[0]), "en.wikipedia")
    ce_str_eq("first url is canonical capitalized title",
        research_cand_url(c[0]), "https://en.wikipedia.org/wiki/Photosynthesis")
}

fn test_acronym_variant_for_short_token() {
    // "dna" -> "Dna" only redirects; an acronym variant must offer the UPPER
    // title so the no-redirect client reaches the real article.
    let c = research_candidates("dna")
    ce_check("acronym (UPPER) variant present",
        _has_cand(c, "en.wikipedia/acronym", "https://en.wikipedia.org/wiki/DNA") == 1)
    ce_str_eq("canonical capitalized is still tried first",
        research_cand_url(c[0]), "https://en.wikipedia.org/wiki/Dna")
}

fn test_no_acronym_variant_for_long_token() {
    // A long word is not an acronym -- no spurious all-caps candidate.
    let c = research_candidates("photosynthesis")
    ce_eq("no acronym candidate for a long word",
        _has_cand(c, "en.wikipedia/acronym",
                  "https://en.wikipedia.org/wiki/PHOTOSYNTHESIS"), 0)
}

fn test_second_source_present() {
    // Multi-source: a genuinely different host is always offered as a fallback.
    let c = research_candidates("cat")
    ce_check("simple.wikipedia fallback present",
        _has_cand(c, "simple.wikipedia", "https://simple.wikipedia.org/wiki/Cat") == 1)
}

fn test_multiword_topic_uses_underscores() {
    // Defensive: a space-bearing topic forms a valid wiki title, not a URL with
    // raw spaces.
    let c = research_candidates("black hole")
    ce_str_eq("spaces become underscores in the title",
        research_cand_url(c[0]), "https://en.wikipedia.org/wiki/Black_hole")
}

fn test_all_urls_https() {
    let c = research_candidates("cat")
    let i = 0
    while i < len(c) {
        ce_check("every candidate url is https",
                 starts_with(research_cand_url(c[i]), "https://"))
        i = i + 1
    }
}

fn test_empty_topic_no_candidates() {
    let c = research_candidates("")
    ce_eq("empty topic yields no candidates", len(c), 0)
}

fn test_strong_threshold() {
    ce_eq("strong when ops > min", research_is_strong(5, 3), 1)
    ce_eq("weak when ops < min", research_is_strong(2, 3), 0)
    ce_eq("boundary is inclusive", research_is_strong(3, 3), 1)
}

// R55: an INDEPENDENT (non-Wikipedia-family) source -- the Wiktionary
// dictionary -- is offered, at the lowercased entry title.
fn test_independent_wiktionary_source() {
    let c = research_candidates("photosynthesis")
    ce_check("wiktionary source present",
        _has_cand(c, "en.wiktionary", "https://en.wiktionary.org/wiki/photosynthesis") == 1)
}

// R55: OpenSearch URL construction + query encoding.
fn test_search_url() {
    ce_str_eq("opensearch url for a single token",
        research_search_url("photosynthesis"),
        "https://en.wikipedia.org/w/api.php?action=opensearch&search=photosynthesis&limit=1&format=json&namespace=0")
    ce_str_eq("query spaces are percent-encoded",
        research_search_url("black hole"),
        "https://en.wikipedia.org/w/api.php?action=opensearch&search=black%20hole&limit=1&format=json&namespace=0")
}

fn test_url_encode() {
    ce_str_eq("space -> %20", research_url_encode("a b"), "a%20b")
    ce_str_eq("no space unchanged", research_url_encode("abc"), "abc")
}

// R55: parse the canonical article URL out of an OpenSearch JSON response.
fn test_first_url_parse() {
    // Real-shape response: [query,[titles],[descs],[urls]].
    let body = "[\"photosynthesis\",[\"Photosynthesis\"],[\"\"],[\"https://en.wikipedia.org/wiki/Photosynthesis\"]]"
    ce_str_eq("first url extracted (canonical article)",
        research_first_url(body), "https://en.wikipedia.org/wiki/Photosynthesis")
    // Typo-corrected response still parses to the corrected article.
    let typo = "[\"phtosynthesis\",[\"Photosynthesis\"],[\"\"],[\"https://en.wikipedia.org/wiki/Photosynthesis\"]]"
    ce_str_eq("typo-corrected url extracted",
        research_first_url(typo), "https://en.wikipedia.org/wiki/Photosynthesis")
    // Acronym response.
    let dna = "[\"dna\",[\"DNA\"],[\"\"],[\"https://en.wikipedia.org/wiki/DNA\"]]"
    ce_str_eq("acronym url extracted", research_first_url(dna), "https://en.wikipedia.org/wiki/DNA")
    // No results -> empty arrays, no url.
    let empty = "[\"zqxk\",[],[],[]]"
    ce_str_eq("no-result response -> empty", research_first_url(empty), "")
    // Garbage -> empty.
    ce_str_eq("garbage -> empty", research_first_url("not json at all"), "")
    // R58: a "https://" buried in a DESCRIPTION must NOT be picked -- only the
    // url array (index 3) counts. The string-scan version would have failed this.
    let spoof = "[\"x\",[\"X\"],[\"see https://evil.example/oops\"],[\"https://en.wikipedia.org/wiki/X\"]]"
    ce_str_eq("description url is not mistaken for the article url",
        research_first_url(spoof), "https://en.wikipedia.org/wiki/X")
}

// R58: extract definitions from a dictionaryapi.dev-shaped response.
fn test_dict_definitions() {
    let body = "[{\"word\":\"serendipity\",\"meanings\":[{\"partOfSpeech\":\"noun\",\"definitions\":[{\"definition\":\"a happy accident\"},{\"definition\":\"good luck\"}]}]}]"
    let defs = dict_definitions(body)
    ce_eq("two definitions extracted", len(defs), 2)
    ce_str_eq("first partOfSpeech", defs[0][0], "noun")
    ce_str_eq("first definition", defs[0][1], "a happy accident")
    ce_str_eq("second definition", defs[1][1], "good luck")
    // A 404 body (the API returns an object, not an array) -> no definitions.
    let notfound = "{\"title\":\"No Definitions Found\",\"message\":\"sorry\"}"
    ce_eq("404 object -> no definitions", len(dict_definitions(notfound)), 0)
    // Garbage -> no definitions, no crash.
    ce_eq("garbage -> no definitions", len(dict_definitions("xyz")), 0)
    // The dictionary endpoint URL is well-formed.
    ce_str_eq("dict api url", dict_api_url("cat"),
        "https://api.dictionaryapi.dev/api/v2/entries/en/cat")
    // R59: definitions join into sentence-terminated prose for ingest.
    ce_str_eq("definitions joined for ingest",
        dict_learn_text(dict_definitions(body)), "a happy accident. good luck. ")
    ce_str_eq("empty definitions -> empty text", dict_learn_text(list_new()), "")
}

fn main() {
    test_cap_first()
    test_wiki_path_underscores()
    test_canonical_first()
    test_acronym_variant_for_short_token()
    test_no_acronym_variant_for_long_token()
    test_second_source_present()
    test_multiword_topic_uses_underscores()
    test_all_urls_https()
    test_empty_topic_no_candidates()
    test_strong_threshold()
    test_independent_wiktionary_source()
    test_search_url()
    test_url_encode()
    test_first_url_parse()
    test_dict_definitions()
    ce_summary("research_sources")
}
main()
