// Unit tests for src/kg/competence_tracker.nova
// Verifies COMP_KNOW / COMP_DO / COMP_UNDERSTAND assessment from underlying
// belief/skill/concept state, the four competence tiers, gap reporting, and the
// self-model registry. ADR-0020.

import "../ce_test.nova"
import "../../src/kg/competence_tracker.nova"

fn observe_n(a, sign, n) {
    let i = 0
    while i < n { atom_observe(a, sign); i = i + 1 }
}

fn test_know_tiers() {
    let reg = kg_registry_new()
    // Capable: strong belief + plenty of evidence.
    let med = kg_spawn(reg, "medicine")
    let a = kg_add_atom(med, ATOM_FACT, "aspirin", 0)
    observe_n(a, 1, 20)
    let rk = competence_assess_know(med, 1)
    ce_check("know mean high", competence_reliability(rk) >= 750)
    ce_eq("know evidence 20", competence_evidence(rk), 20)
    ce_eq("know capable", competence_tier(rk), TIER_CAPABLE)
    ce_str_eq("tier name", competence_tier_name(TIER_CAPABLE), "capable")

    // Partial: confident but thin evidence.
    let law = kg_spawn(reg, "law")
    let b = kg_add_atom(law, ATOM_FACT, "tort", 0)
    observe_n(b, 1, 5)
    let rp = competence_assess_know(law, 1)
    ce_check("partial mean >= 0.5", competence_reliability(rp) >= 500)
    ce_eq("partial tier", competence_tier(rp), TIER_PARTIAL)

    // Aware: grounded but unreliable.
    let art = kg_spawn(reg, "art")
    let c = kg_add_atom(art, ATOM_FACT, "cubism", 0)
    observe_n(c, -1, 3)
    let ra = competence_assess_know(art, 1)
    ce_check("aware mean < 0.5", competence_reliability(ra) < 500)
    ce_eq("aware tier", competence_tier(ra), TIER_AWARE)

    // Unknown: no grounding.
    let empty = kg_spawn(reg, "music")
    let ru = competence_assess_know(empty, 1)
    ce_eq("no grounding", competence_grounding_count(ru), 0)
    ce_eq("unknown tier", competence_tier(ru), TIER_UNKNOWN)
}

fn test_do() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let m0 = kg_add_atom(med, ATOM_FACT, "headache", 0)
    let sk = skills_kg_init(reg)

    // A reliable skill cross-referenced to medicine.
    let s = skill_new(sk, "treat_headache", "headache", 0)
    atom_add_xref(s, xref_new(s, m0, XREF_CAUSAL, 600, 1))
    observe_n(s, 1, 20)
    let rd = competence_assess_do(sk, "medicine", 1)
    ce_eq("one skill grounds medicine-do", competence_grounding_count(rd), 1)
    ce_eq("do capable", competence_tier(rd), TIER_CAPABLE)
    ce_eq("no gaps", len(competence_gaps(rd)), 0)

    // A domain with no tied skills -> unknown.
    let rnone = competence_assess_do(sk, "law", 1)
    ce_eq("untied domain unknown", competence_tier(rnone), TIER_UNKNOWN)

    // A retired skill becomes a gap.
    let bad = skill_new(sk, "quack", "headache", 0)
    atom_add_xref(bad, xref_new(bad, m0, XREF_CAUSAL, 600, 1))
    observe_n(bad, -1, 8)
    let rd2 = competence_assess_do(sk, "medicine", 2)
    ce_check("retired skill recorded as gap", len(competence_gaps(rd2)) >= 1)
}

fn test_understand() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let layer = concept_layer_new()
    // A concept spanning medicine, fully filled -> high ratio.
    let cluster = list_new()
    push(cluster, kg_add_atom(med, ATOM_CONCEPT, "analgesic", 0))
    let cid = concept_promote(layer, cluster)
    concept_add_slot(layer, cid, "mechanism", 3)
    concept_add_slot(layer, cid, "dose", 3)
    concept_fill_slot(layer, cid, "mechanism", "x")
    concept_fill_slot(layer, cid, "dose", "y")
    let ru = competence_assess_understand(layer, "medicine", 1)
    ce_eq("understand grounded", competence_grounding_count(ru), 1)
    ce_eq("full fill ratio", competence_reliability(ru), 1000)
    ce_eq("no understand gaps", len(competence_gaps(ru)), 0)

    // A partially filled concept -> gaps and lower ratio (aware).
    let cluster2 = list_new()
    push(cluster2, kg_add_atom(med, ATOM_CONCEPT, "antibiotic", 0))
    let c2 = concept_promote(layer, cluster2)
    concept_add_slot(layer, c2, "a", 3); concept_add_slot(layer, c2, "b", 3)
    concept_add_slot(layer, c2, "c", 3); concept_add_slot(layer, c2, "d", 3)
    concept_fill_slot(layer, c2, "a", "x")
    let ru2 = competence_assess_understand(layer, "medicine", 2)
    // Two concepts now span medicine: ratios 1.0 and 0.25 -> mean ~0.625.
    ce_eq("two understand groundings", competence_grounding_count(ru2), 2)
    ce_check("understand gaps present", len(competence_gaps(ru2)) >= 3)

    // No concept spans this domain -> unknown.
    ce_eq("unknown domain", competence_tier(competence_assess_understand(layer, "law", 3)), TIER_UNKNOWN)
}

fn test_self_model() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let a = kg_add_atom(med, ATOM_FACT, "x", 0)
    observe_n(a, 1, 20)
    let sm = self_model_new()
    self_model_set(sm, competence_assess_know(med, 1))
    ce_eq("one record", self_model_count(sm), 1)
    // Replace same domain+kind.
    self_model_set(sm, competence_assess_know(med, 5))
    ce_eq("replaced not appended", self_model_count(sm), 1)
    let got = self_model_get(sm, "medicine", COMP_KNOW)
    ce_check("retrieved record", got != 0)
    ce_eq("retrieved tier capable", competence_tier(got), TIER_CAPABLE)
    ce_eq("missing record -> 0", self_model_get(sm, "law", COMP_KNOW), 0)
    ce_eq("snapshot length", len(self_model_snapshot(sm)), 1)
}

fn main() {
    test_know_tiers()
    test_do()
    test_understand()
    test_self_model()
    ce_summary("competence_tracker")
}

main()
