// Unit tests for src/reader/reader.nova
// End-to-end five-stage reads: a known coherent utterance is comprehended,
// activated, and routed; an utterance with an unknown word escalates to
// ask-user. ADR-0011, ADR-0012, ADR-0014.

import "../ce_test.nova"
import "../../src/reader/reader.nova"

fn build_reader() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    let c1 = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    atom_add_xref(c0, xref_new(c0, c1, XREF_CAUSAL, 800, 1))
    atom_add_xref(c1, xref_new(c1, c0, XREF_CAUSAL, 800, 1))
    let fever = word_atom_new(lang, "fever", 0)
    word_add_sense(fever, c0, 900)
    let infection = word_atom_new(lang, "infection", 0)
    word_add_sense(infection, c1, 900)
    return reader_new(reg, lang, 0)
}

fn test_comprehend_known() {
    let e = build_reader()
    let c = reader_read_plain(e, "Fever")
    ce_eq("matched one", reader_matched(c), 1)
    ce_eq("nothing unknown", reader_unknown(c), 0)
    ce_check("activation spread", reader_active_count(c) >= 2)
    ce_eq("coherent and accepted", reader_was_accepted(c), 1)
    ce_eq("coherence high", reader_coherence(c), 1000)
    ce_eq("routed for reasoning", len(rctx_routes(c)), 1)
    ce_eq("no learning needed", reader_trigger(c), LEARN_NONE)
}

fn test_multiword() {
    let e = build_reader()
    let c = reader_read_plain(e, "fever infection")
    ce_eq("both matched", reader_matched(c), 2)
    ce_eq("accepted", reader_was_accepted(c), 1)
}

fn test_unknown_word_escalates() {
    let e = build_reader()
    let c = reader_read_plain(e, "fever glorptide")
    ce_eq("one matched", reader_matched(c), 1)
    ce_eq("one unknown", reader_unknown(c), 1)
    ce_eq("not accepted", reader_was_accepted(c), 0)
    ce_eq("asks user to teach", reader_trigger(c), LEARN_ASK_USER)
}

fn main() {
    test_comprehend_known()
    test_multiword()
    test_unknown_word_escalates()
    ce_summary("reader")
}

main()
