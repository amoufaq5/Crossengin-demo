// CE_TEST_TIMEOUT: 240
// Refusal tests for src/learning/sa4_coord.nova (A2.2b), part 2. A round
// is recorded in which soul 5 (id 4294967295) stops after its ADV, so it
// is in U1 but not in U2 (U2 = U3 = U4 = souls 1-4, t = 4). Each case
// replays the recording into a fresh coordinator with one change and
// asserts the reason:
//   - lines from a soul outside the current set (y, SIG3, reveal phases);
//   - a reveal about a soul in U1 but not in U2;
//   - END with another id and END for the wrong phase, in every phase;
//     lines after END and unexpected lines in the y and reveal phases;
//   - y chunks: wrong count n, a chunk sent twice, a chunk of the wrong
//     length (memory a soul can make the coordinator hold is bounded by L);
//   - cancellation at |U3| < t, |U4| < t and too few complete reveals.
// v4-sa3 (A2.4c): soul 5 has no END 1, so it is left out at the shares
// close ("share batch incomplete") and its later lines are ignored as
// those of a left-out soul; an honest round has six collecting phases
// (ADV, shares, check, y, SIG3, reveals), so rec has six rows.

import "../ce_test.nova"
import "../sa4_harness.nova"

let R2_R = 43
let R2_OUT = 4294967295

// rec[phase][i]: soul i's lines in that phase; soul 4 sends only its ADV.
fn r2_record(roster, vc) {
    let souls = sa4h_souls(roster, 5, R2_R, vc, 0)
    let c = sa4e_coord(roster, R2_R, vc)
    let rec = list_new()
    let ph = 0
    while ph < 6 {
        let row = list_new()
        let i = 0
        while i < 5 {
            push(row, list_new())
            i = i + 1
        }
        push(rec, row)
        ph = ph + 1
    }
    let rl = sa4c_round_line(c)
    let i2 = 0
    while i2 < 5 {
        let o = sa4h_feed(souls[i2], sa4h_one(rl))[1]
        list_set(rec[0], i2, o)
        let k = 0
        while k < len(o) {
            sa4c_recv(c, SA4H_IDS[i2], o[k])
            k = k + 1
        }
        i2 = i2 + 1
    }
    let p = 1
    while p < 6 {
        let msgs = sa4c_close(c)[2]
        let i = 0
        while i < 4 {
            let mine = list_new()
            let k = 0
            while k < len(msgs) {
                if msgs[k][0] == SA4H_IDS[i] { push(mine, msgs[k][1]) }
                k = k + 1
            }
            let o = sa4h_feed(souls[i], mine)[1]
            list_set(rec[p], i, o)
            let k2 = 0
            while k2 < len(o) {
                sa4c_recv(c, SA4H_IDS[i], o[k2])
                k2 = k2 + 1
            }
            i = i + 1
        }
        p = p + 1
    }
    ce_eq("recorded round closes", sa4c_close(c)[0], 1)
    ce_eq("recorded U2 = 4", len(sa4c_set(c, 2)), 4)
    ce_eq("recorded round unmasks", sa4h_same(sa4c_unmask(c)[2], sa4h_expected([1, 2, 3, 4])), 1)
    return rec
}

// Replay phases < upto; in phase `skip_ph`, skip the lines of soul index
// `skip_i` (-1: none).
fn r2_replay(roster, vc, rec, upto, skip_ph, skip_i) {
    let c = sa4e_coord(roster, R2_R, vc)
    let p = 0
    while p < upto {
        let i = 0
        while i < 5 {
            let skip = 0
            if p == skip_ph {
                if i == skip_i { skip = 1 }
            }
            if skip == 0 {
                let o = rec[p][i]
                let k = 0
                while k < len(o) {
                    sa4c_recv(c, SA4H_IDS[i], o[k])
                    k = k + 1
                }
            }
            i = i + 1
        }
        sa4c_close(c)
        p = p + 1
    }
    return c
}

fn r2_expect(label, c, from_id, line, frag) {
    let r = sa4c_recv(c, from_id, line)
    ce_eq(label + ": refused", r[0], 0)
    let why = sa4c_why(c, from_id)
    ce_check(label + ": reason '" + frag + "' (got '" + why + "')", find_bytes(why + " " + r[1], frag) >= 0)
    return 0
}

fn r2_fill(n, v) {
    let l = list_new()
    let i = 0
    while i < n {
        push(l, v)
        i = i + 1
    }
    return l
}

fn test_outside_sets(roster, vc, rec) {
    // Soul 5 is not in U2/U3/U4: its lines in those phases are refused.
    r2_expect("y from outside U2", r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), R2_OUT, sa4w_fmt_end(R2_R, 2, R2_OUT, 0), "already left out")
    ce_str_eq("the soul without END 1: why", sa4c_why(r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), R2_OUT), "share batch incomplete")
    r2_expect("SIG3 from outside U3", r2_replay(roster, vc, rec, 4, 0 - 1, 0 - 1), R2_OUT, sa4w_fmt_sig3(R2_R, R2_OUT, sa4w_parse(rec[4][0][0])[3]), "already left out")
    let rv = sa4w_parse(rec[5][0][0])
    r2_expect("reveal from outside U4", r2_replay(roster, vc, rec, 5, 0 - 1, 0 - 1), R2_OUT, sa4w_fmt_reveal(R2_R, R2_OUT, 7, 0, rv[5], rv[6]), "already left out")
    r2_expect("reveal about a soul outside U2", r2_replay(roster, vc, rec, 5, 0 - 1, 0 - 1), 7, sa4w_fmt_reveal(R2_R, 7, R2_OUT, 1, rv[5], rv[6]), "outside U2")
    return 0
}

fn test_end_rules(roster, vc, rec) {
    r2_expect("share END for another id", r2_replay(roster, vc, rec, 1, 0 - 1, 0 - 1), 7, sa4w_fmt_end(R2_R, 1, 300, 3), "END for another id")
    r2_expect("y END for another id", r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), 7, sa4w_fmt_end(R2_R, 2, 300, 0), "END for another id")
    r2_expect("y END for phase 1", r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), 7, sa4w_fmt_end(R2_R, 1, 7, 0), "wrong END phase")
    r2_expect("reveal END for another id", r2_replay(roster, vc, rec, 5, 0 - 1, 0 - 1), 7, sa4w_fmt_end(R2_R, 3, 300, 0), "END for another id")
    r2_expect("reveal END for phase 2", r2_replay(roster, vc, rec, 5, 0 - 1, 0 - 1), 7, sa4w_fmt_end(R2_R, 2, 7, 0), "wrong END phase")
    let y0 = rec[3][0]
    let c = r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1)
    let k = 0
    while k < len(y0) {
        sa4c_recv(c, 7, y0[k])
        k = k + 1
    }
    r2_expect("y line after END", c, 7, y0[0], "line after END")
    r2_expect("SIG3 in the y phase", r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), 7, rec[4][0][0], "unexpected line")
    let r0 = rec[5][0]
    let c2 = r2_replay(roster, vc, rec, 5, 0 - 1, 0 - 1)
    k = 0
    while k < len(r0) {
        sa4c_recv(c2, 7, r0[k])
        k = k + 1
    }
    r2_expect("reveal line after END", c2, 7, r0[0], "line after END")
    r2_expect("Y in the reveal phase", r2_replay(roster, vc, rec, 5, 0 - 1, 0 - 1), 7, rec[3][0][0], "unexpected line")
    return 0
}

fn r2_hex60() {
    let h = ""
    let i = 0
    while i < 60 {
        h = h + "00000001"
        i = i + 1
    }
    return h
}

fn test_y_bounds(roster, vc, rec) {
    // L = 150: two chunks, of 100 and 50 words.
    r2_expect("Y chunk count differs from L", r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), 7, sa4w_fmt_y_lines(R2_R, 7, r2_fill(300, 1))[0], "chunk count differs")
    let c = r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1)
    let y0 = rec[3][0][0]
    sa4c_recv(c, 7, y0)
    r2_expect("Y chunk sent twice", c, 7, y0, "sent twice")
    r2_expect("last Y chunk too long", r2_replay(roster, vc, rec, 3, 0 - 1, 0 - 1), 7, "SA4_Y 43 7 1 2 " + r2_hex60(), "wrong length")
    return 0
}

fn test_cancels(roster, vc, rec) {
    let c3 = r2_replay(roster, vc, rec, 4, 3, 1)
    ce_eq("|U3| < t cancels", sa4c_state(c3), SA4C_ST_CANCELLED)
    let c4 = r2_replay(roster, vc, rec, 5, 4, 1)
    ce_eq("|U4| < t cancels", sa4c_state(c4), SA4C_ST_CANCELLED)
    let c5 = r2_replay(roster, vc, rec, 6, 5, 1)
    ce_eq("too few reveal batches cancels", sa4c_state(c5), SA4C_ST_CANCELLED)
    ce_eq("no unmask after cancel", sa4c_unmask(c5)[0], 0)
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let rec = r2_record(roster, vc)
    test_outside_sets(roster, vc, rec)
    test_end_rules(roster, vc, rec)
    test_y_bounds(roster, vc, rec)
    test_cancels(roster, vc, rec)
    ce_summary("sa4_coord_refuse2")
}

main()
