// Unit tests for src/safety/permission_tiers.nova
// Verifies static defaults, the reversibility floor, the MAX combination, the
// guard (raise-only), and the per-action gate decision. ADR-0041 (with ADR-0042
// floor).

import "../ce_test.nova"
import "../../src/safety/permission_tiers.nova"

// Static defaults per action class; unknown -> APPROVE (fail-safe).
fn test_defaults() {
    ce_eq("read auto", perm_default(ACT_READ_LOCAL), PERM_AUTO)
    ce_eq("net notify", perm_default(ACT_NET_FETCH), PERM_NOTIFY)
    ce_eq("send approve", perm_default(ACT_SEND_MSG), PERM_APPROVE)
    ce_eq("unknown approve", perm_default(0), PERM_APPROVE)
}

// The floor implied by reversibility.
fn test_floor() {
    ce_eq("reversible floor auto", reversibility_floor(ACT_READ_LOCAL), PERM_AUTO)
    ce_eq("recoverable floor notify", reversibility_floor(ACT_DELETE), PERM_NOTIFY)
    ce_eq("irreversible floor approve", reversibility_floor(ACT_SPEND), PERM_APPROVE)
}

// Effective tier is MAX(default, floor). SPEAK is the interesting case: its
// static default is AUTO but it is RECOVERABLE, so the floor raises it to NOTIFY.
fn test_effective_max() {
    ce_eq("speak raised by floor", perm_effective_tier(ACT_SPEAK), PERM_NOTIFY)
    ce_eq("read stays auto", perm_effective_tier(ACT_READ_LOCAL), PERM_AUTO)
    ce_eq("net stays notify", perm_effective_tier(ACT_NET_FETCH), PERM_NOTIFY)
    // Irreversible is always >= APPROVE regardless of default.
    ce_eq("send approve", perm_effective_tier(ACT_SEND_MSG), PERM_APPROVE)
    ce_eq("self_modify approve", perm_effective_tier(ACT_SELF_MODIFY), PERM_APPROVE)
    ce_eq("unknown approve", perm_effective_tier(0), PERM_APPROVE)
}

// A guard may only raise the tier, never lower it.
fn test_guard_raise_only() {
    ce_eq("guard raises", perm_apply_guard(PERM_AUTO, PERM_APPROVE), PERM_APPROVE)
    ce_eq("guard no lower", perm_apply_guard(PERM_APPROVE, PERM_AUTO), PERM_APPROVE)
    ce_eq("guard equal", perm_apply_guard(PERM_NOTIFY, PERM_NOTIFY), PERM_NOTIFY)
}

// Gate decision and approval predicate derived from the effective tier.
fn test_decision() {
    ce_eq("read executes", perm_decision(ACT_READ_LOCAL), PDEC_EXECUTE)
    ce_eq("speak notifies", perm_decision(ACT_SPEAK), PDEC_NOTIFY)
    ce_eq("send suspends", perm_decision(ACT_SEND_MSG), PDEC_SUSPEND)
    ce_eq("read no approval", perm_requires_approval(ACT_READ_LOCAL), 0)
    ce_eq("speak no approval", perm_requires_approval(ACT_SPEAK), 0)
    ce_eq("send needs approval", perm_requires_approval(ACT_SEND_MSG), 1)
    ce_str_eq("tier name", perm_tier_name(PERM_APPROVE), "approve")
    ce_str_eq("dec name", perm_dec_name(PDEC_SUSPEND), "suspend")
}

fn main() {
    test_defaults()
    test_floor()
    test_effective_max()
    test_guard_raise_only()
    test_decision()
    ce_summary("permission_tiers")
}
main()
