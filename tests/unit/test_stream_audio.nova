// Unit tests for src/io/transducers/stream_audio.nova -- the PURE state object
// (NL_AND_COVERAGE C1; ADR-0058). The capture/STT poll path is integration-only;
// here we cover the constructor defaults + accessors + the env-off gate.

import "../ce_test.nova"
import "../../src/io/transducers/stream_audio.nova"

fn test_fresh_state() {
    let s = stream_audio_new()
    ce_eq("fresh: disabled", stream_audio_enabled(s), 0)
    ce_eq("fresh: not initialized", stream_audio_initialized(s), 0)
    ce_str_eq("default wav path", stream_audio_wav_path(s), "/tmp/ce_input.wav")
    ce_eq("default poll interval", stream_audio_poll_interval(s), 100)
    ce_eq("fresh: tick counter 0", stream_audio_tick_counter(s), 0)
    ce_eq("fresh: utterances 0", stream_audio_utterances_total(s), 0)
    ce_eq("fresh: captures 0", stream_audio_captures_total(s), 0)
    ce_str_eq("fresh: no transcript", stream_audio_last_transcript(s), "")
    ce_check("has an STT seam", stream_audio_seam(s) != 0)
    ce_check("has a capture struct", stream_audio_capture(s) != 0)
}

fn main() {
    test_fresh_state()
    ce_summary("stream_audio")
}
main()
