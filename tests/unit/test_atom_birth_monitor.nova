// Unit tests for src/learning/atom_birth_monitor.nova
// Verifies candidate accumulation (frequency + distinct moments), the three
// birth gates (frequency, novelty, stability), surprise lowering the frequency
// bar, and belief seeding on birth. ADR-0025.

import "../ce_test.nova"
import "../../src/learning/atom_birth_monitor.nova"

fn embedv(d, val) {
    let v = vec_new(ATOM_EMBED_DIMS); vec_set(v, d, val); return v
}

// Observe a pattern `freq` times across `distinct` moments.
fn feed(mon, sig, embed, freq, distinct) {
    let i = 0
    while i < freq {
        abm_observe(mon, sig, embed, i % distinct, sig)
        i = i + 1
    }
}

fn test_candidate_accumulation() {
    let mon = abm_new()
    let e = embedv(0, 100)
    feed(mon, "p", e, 5, 3)
    let cand = abm_candidate(mon, "p")
    ce_check("candidate exists", cand != 0)
    ce_eq("frequency 5", cb_freq(cand), 5)
    ce_eq("stability 3 distinct moments", cb_stability(cand), 3)
    ce_eq("one candidate", abm_candidate_count(mon), 1)
}

fn test_birth_gates_and_seed() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mon = abm_new()
    let e = embedv(0, 100)
    feed(mon, "p", e, 5, 3)
    let cand = abm_candidate(mon, "p")
    ce_eq("gates pass", abm_should_birth(cand, kg, 0), 1)
    let a = abm_birth(cand, kg, 2000, 0, 7)
    ce_check("atom born", a != 0)
    ce_eq("born as concept", atom_kind(a), ATOM_CONCEPT)
    ce_eq("embedding carried", vec_get(atom_embed(a), 0), 100)
    // Belief seeded alpha = 1 + 2.0 = 3.0, beta = 1.0 -> mean 0.75.
    ce_eq("belief seeded", atom_confidence(a), 750)
}

fn test_gate_failures() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mon = abm_new()
    let e = embedv(0, 100)

    // Frequency too low (4 < 5) -> no birth (normal).
    feed(mon, "lowfreq", e, 4, 3)
    ce_eq("frequency gate blocks", abm_should_birth(abm_candidate(mon, "lowfreq"), kg, 0), 0)
    // ...but surprise lowers the bar (>= 3).
    ce_eq("surprise lowers freq gate", abm_should_birth(abm_candidate(mon, "lowfreq"), kg, 1), 1)

    // Stability too low (freq 6 but only 2 distinct moments).
    feed(mon, "unstable", embedv(1, 100), 6, 2)
    ce_eq("stability gate blocks", abm_should_birth(abm_candidate(mon, "unstable"), kg, 0), 0)

    // Novelty: an existing similar atom blocks birth.
    let existing = kg_add_atom(kg, ATOM_CONCEPT, "existing", 0)
    atom_set_embed(existing, embedv(2, 100))
    feed(mon, "dup", embedv(2, 100), 5, 3)
    ce_eq("novelty ok when none similar", abm_novelty_ok(kg, embedv(5, 100)), 1)
    ce_eq("novelty fails vs existing", abm_novelty_ok(kg, embedv(2, 100)), 0)
    ce_eq("novelty gate blocks birth", abm_should_birth(abm_candidate(mon, "dup"), kg, 0), 0)
}

fn main() {
    test_candidate_accumulation()
    test_birth_gates_and_seed()
    test_gate_failures()
    ce_summary("atom_birth_monitor")
}

main()
