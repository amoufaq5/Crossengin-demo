    test_empty_input()
    test_only_comments()
    test_only_blanks()
    test_top_level_list_of_records()
    test_top_level_records_key_form()
    test_top_level_scalar_refused()
    test_top_level_map_without_records_key_refused()
    test_records_value_must_be_list()
    test_multiple_records()
    test_kg_hint_and_source_tag_defaults_apply()
    test_record_kg_source_override_defaults()
    test_missing_kg_no_hint_records_error_and_skips()
    test_missing_source_no_default_errors()
    test_scalar_bare_string()
    test_scalar_double_quoted_string()
    test_scalar_single_quoted_string()
    test_scalar_double_quote_escapes()
    test_scalar_single_quote_doubled_escape()
    test_scalar_unterminated_double_quote()
    test_scalar_unsupported_escape()
    test_scalar_int_and_negative_int()
    test_scalar_null_forms()
    test_reject_tab_character()
    test_reject_odd_indent()
    test_reject_flow_sequence_at_line_start()
    test_reject_flow_sequence_as_value()
    test_reject_flow_mapping_as_value()
    test_reject_anchor_at_line_start()
    test_reject_alias_as_value()
    test_reject_tag_as_value()
    test_reject_block_scalar_pipe()
    test_reject_block_scalar_gt()
    test_reject_merge_key()
    test_reject_multi_doc_separator()
    test_leading_doc_header_tolerated()
    test_end_of_doc_marker_stops()
    test_reject_flow_inside_list_item()
    test_full_record_all_fields_populated()
    test_atom_bad_kind_logged_others_land()
    test_atom_kind_accepts_integer_constant()
    test_imp_strength_validation()
    test_obs_sign_validation()
    test_belief_must_be_int_string_refused()
    test_weight_must_be_int_string_refused()
    test_citation_missing_fields_errors()
    test_one_level_nested_mapping_capsule()
    test_capsule_deps_nested_list_of_maps()
    test_source_registry_registers_yaml()
    test_shipped_sample_yaml_parses()
    test_yamlr_parse_missing_file_errors()
    ce_summary("yaml_records")
}

main()
