// Unit tests for R85 YAML structured-record importer.
//
// Layered coverage:
//   * Tokenizer     -- comments, indentation, blank lines, quotes,
//                      strict rejects (anchors, aliases, flow, block,
//                      tags, merges, multi-doc, tabs, odd indent)
//   * Scalar layer  -- bare / quoted strings, int / bool / null,
//                      escape handling
//   * Tree builder  -- top-level list, top-level map+records key,
//                      nested map, nested list-of-map
//   * Schema layer  -- happy path with every record field populated,
//                      kg/source defaults + override, lenient per-record
//                      errors, integer-only belief/weight/sign
//   * Sample pack   -- data/packs/samples/climate_facts.yaml parses
//                      clean under the shipped default hints

import "../ce_test.nova"
import "../../src/ingest/importers/yaml_records.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/ingest/source_registry.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- empty / comments-only -------------------------------------------

fn test_empty_input() {
    let r = yamlr_parse_text("", "", "")
    ce_eq("no records for empty input", len(yamlr_records(r)), 0)
    ce_eq("no errors for empty input",  len(yamlr_errors(r)), 0)
}

fn test_only_comments() {
    let body = "# just a comment\n# and another\n# nothing else\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no records for comments-only", len(yamlr_records(r)), 0)
    ce_eq("no errors for comments-only",  len(yamlr_errors(r)), 0)
}

fn test_only_blanks() {
    let r = yamlr_parse_text("\n\n\n   \n\n", "", "")
    ce_eq("no records for blanks-only", len(yamlr_records(r)), 0)
    ce_eq("no errors for blanks-only",  len(yamlr_errors(r)), 0)
}

// ---- top-level shape -------------------------------------------------

fn test_top_level_list_of_records() {
    let body = "- kg: k\n  source: src:cerec:t\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("1 record from list-of-records", len(yamlr_records(r)), 1)
    ce_str_eq("kg", cur_kg(yamlr_records(r)[0]), "k")
    ce_str_eq("src", cur_source(yamlr_records(r)[0]), "src:cerec:t")
}

fn test_top_level_records_key_form() {
    let body = "records:\n"
             + "  - kg: k\n    source: src:cerec:t\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("1 record from records-key form", len(yamlr_records(r)), 1)
    ce_str_eq("kg via records key", cur_kg(yamlr_records(r)[0]), "k")
}

fn test_top_level_scalar_refused() {
    // A bare scalar at column 0 isn't a mapping key (no `: `) and
    // isn't a list item -- the parse_map layer surfaces the
    // "expected 'key: value'" error before we even reach the top-
    // level shape check.
    let r = yamlr_parse_text("just a scalar\n", "", "")
    ce_eq("no records", len(yamlr_records(r)), 0)
    ce_check("scalar-only doc refused",
             _has(yamlr_errors(r)[0][1], "expected 'key: value'"))
}

fn test_top_level_map_without_records_key_refused() {
    let body = "kg: k\nsource: src:cerec:t\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no records", len(yamlr_records(r)), 0)
    ce_check("top-level map needs records key",
             _has(yamlr_errors(r)[0][1], "'records' key"))
}

fn test_records_value_must_be_list() {
    let body = "records: hello\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no records", len(yamlr_records(r)), 0)
    ce_check("records must be a list",
             _has(yamlr_errors(r)[0][1], "'records' value must be a list"))
}

// ---- multiple records ------------------------------------------------

fn test_multiple_records() {
    let body = "- kg: alpha\n  source: src:cerec:a\n"
             + "- kg: beta\n  source: src:cerec:b\n"
             + "- kg: gamma\n  source: src:cerec:c\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no errors",   len(yamlr_errors(r)), 0)
    ce_eq("3 records",   len(yamlr_records(r)), 3)
    ce_str_eq("kg[0]",   cur_kg(yamlr_records(r)[0]), "alpha")
    ce_str_eq("kg[1]",   cur_kg(yamlr_records(r)[1]), "beta")
    ce_str_eq("kg[2]",   cur_kg(yamlr_records(r)[2]), "gamma")
}

// ---- kg / source defaults + override ---------------------------------

fn test_kg_hint_and_source_tag_defaults_apply() {
    let body = "- atoms:\n    - label: mars\n      kind: fact\n      belief: 900\n"
    let r = yamlr_parse_text(body, "default_kg", "src:cerec:default")
    ce_eq("no errors", len(yamlr_errors(r)), 0)
    ce_eq("1 record",  len(yamlr_records(r)), 1)
    ce_str_eq("kg from hint",  cur_kg(yamlr_records(r)[0]),  "default_kg")
    ce_str_eq("src from arg",  cur_source(yamlr_records(r)[0]), "src:cerec:default")
}

fn test_record_kg_source_override_defaults() {
    let body = "- kg: mine\n  source: src:cerec:mine\n"
             + "  atoms:\n    - label: y\n      kind: fact\n      belief: 500\n"
    let r = yamlr_parse_text(body, "IGNORED", "src:IGNORED")
    ce_str_eq("record's kg wins",  cur_kg(yamlr_records(r)[0]),  "mine")
    ce_str_eq("record's src wins", cur_source(yamlr_records(r)[0]), "src:cerec:mine")
}

fn test_missing_kg_no_hint_records_error_and_skips() {
    let body = "- source: src:x\n  atoms:\n    - label: z\n      kind: fact\n      belief: 100\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no records produced", len(yamlr_records(r)), 0)
    ce_check("error names missing kg",
             _has(yamlr_errors(r)[0][1], "missing 'kg'"))
}

fn test_missing_source_no_default_errors() {
    let body = "- kg: whatever\n  atoms:\n    - label: z\n      kind: fact\n      belief: 100\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no records", len(yamlr_records(r)), 0)
    ce_check("error names missing source",
             _has(yamlr_errors(r)[0][1], "missing 'source'"))
}

// ---- scalar layer ----------------------------------------------------

fn _scalar_via(body_val) {
    // Build a one-key mapping and read the value back through the
    // parser so we exercise the same code path a real record uses.
    let body = "records:\n  - kg: k\n    source: src:cerec:t\n"
             + "    capsule:\n      name: cap\n      version: " + body_val + "\n"
    let r = yamlr_parse_text(body, "", "")
    if len(yamlr_errors(r)) > 0 { return "ERR:" + yamlr_errors(r)[0][1] }
    if len(yamlr_records(r)) == 0 { return "NORECS" }
    return cur_capsule_version(yamlr_records(r)[0])
}

fn test_scalar_bare_string() {
    ce_str_eq("bare string value", _scalar_via("plain-value"), "plain-value")
}

fn test_scalar_double_quoted_string() {
    ce_str_eq("double-quoted string",
              _scalar_via("\"hello world\""), "hello world")
}

fn test_scalar_single_quoted_string() {
    ce_str_eq("single-quoted string",
              _scalar_via("'a value'"), "a value")
}

fn test_scalar_double_quote_escapes() {
    // \n \t \" \\ \/ round-trip via a bare mapping value.
    let body = "records:\n  - kg: k\n    source: src:cerec:t\n"
             + "    capsule:\n      name: cap\n"
             + "      description: \"line1\\nline2\\ttabbed\\\"quoted\\\"\"\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no parse errors on escapes", len(yamlr_errors(r)), 0)
    ce_eq("1 record",                    len(yamlr_records(r)), 1)
    let desc = cur_capsule_description(yamlr_records(r)[0])
    ce_check("newline escape",  _has(desc, "line1\nline2"))
    ce_check("tab escape",      _has(desc, "\ttabbed"))
    ce_check("quote escape",    _has(desc, "\"quoted\""))
}

fn test_scalar_single_quote_doubled_escape() {
    // '' -> literal ' inside a single-quoted scalar.
    let body = "records:\n  - kg: k\n    source: src:cerec:t\n"
             + "    capsule:\n      name: cap\n"
             + "      description: 'it''s working'\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no parse errors", len(yamlr_errors(r)), 0)
    ce_str_eq("literal apostrophe via ''",
              cur_capsule_description(yamlr_records(r)[0]), "it's working")
}

fn test_scalar_unterminated_double_quote() {
    let r = yamlr_parse_text("- kg: \"open string\n  source: src:x\n", "", "")
    ce_check("unterminated double quote surfaced",
             _has(yamlr_errors(r)[0][1], "unterminated"))
}

fn test_scalar_unsupported_escape() {
    let r = yamlr_parse_text(
        "- kg: k\n  source: \"has \\z escape\"\n", "", "")
    ce_check("unsupported escape refused",
             _has(yamlr_errors(r)[0][1], "unsupported escape"))
}

// Integers land as YT_INT.
fn test_scalar_int_and_negative_int() {
    // belief 900 -> stored as int; label bare-string.
    let body = "- kg: k\n  source: src:cerec:t\n"
             + "  atoms:\n    - label: a\n      kind: fact\n      belief: 42\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("atom parsed", len(cur_atoms(yamlr_records(r)[0])), 1)
    ce_eq("belief 42", cur_atoms(yamlr_records(r)[0])[0][CUR_ATOM_BELIEF], 42)
    // Negative int via observation sign.
    let body2 = "- kg: k\n  source: src:cerec:t\n"
              + "  observations:\n    - label: a\n      sign: -1\n      weight: 100\n"
    let r2 = yamlr_parse_text(body2, "", "")
    ce_eq("obs sign -1",
          cur_obs(yamlr_records(r2)[0])[0][CUR_OBS_SIGN], 0 - 1)
}

// Booleans: routed via a bare mapping value so we can watch a bool
// scalar land. The schema layer never consumes a bool for a
// records field, but the tree still holds one; assert by
// round-tripping through _yamlr_str_field's int-to-str fallback
// path (bool -> "").
fn test_scalar_null_forms() {
    // null and ~ both parse; test by using them as an absent capsule
    // description (should coerce to empty string via _yamlr_str_field).
    let body = "records:\n  - kg: k\n    source: src:cerec:t\n"
             + "    capsule:\n      name: cap\n      description: null\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no errors on null value", len(yamlr_errors(r)), 0)
    ce_str_eq("null coerces to empty string",
              cur_capsule_description(yamlr_records(r)[0]), "")
    let body2 = "records:\n  - kg: k\n    source: src:cerec:t\n"
              + "    capsule:\n      name: cap\n      description: ~\n"
    let r2 = yamlr_parse_text(body2, "", "")
    ce_eq("no errors on tilde", len(yamlr_errors(r2)), 0)
    ce_str_eq("~ coerces to empty string",
              cur_capsule_description(yamlr_records(r2)[0]), "")
}

// ---- indentation / tokenizer rejects ---------------------------------

fn test_reject_tab_character() {
    let body = "- kg: k\n\tsource: src:x\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("tab refused",
             _has(yamlr_errors(r)[0][1], "tab character"))
}

fn test_reject_odd_indent() {
    let body = "- kg: k\n   source: src:x\n"   // 3-space indent
    let r = yamlr_parse_text(body, "", "")
    ce_check("odd indent refused",
             _has(yamlr_errors(r)[0][1], "multiple of 2"))
}

fn test_reject_flow_sequence_at_line_start() {
    let body = "[a, b]\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("flow sequence refused",
             _has(yamlr_errors(r)[0][1], "flow-style sequences"))
}

fn test_reject_flow_sequence_as_value() {
    let body = "- kg: k\n  source: src:x\n  atoms: [a, b]\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("flow sequence value refused",
             _has(yamlr_errors(r)[0][1], "flow-style sequences"))
}

fn test_reject_flow_mapping_as_value() {
    let body = "- kg: k\n  source: src:x\n  atoms: {a: b}\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("flow mapping value refused",
             _has(yamlr_errors(r)[0][1], "flow-style mappings"))
}

fn test_reject_anchor_at_line_start() {
    let body = "&anchor\n- kg: k\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("anchor refused",
             _has(yamlr_errors(r)[0][1], "anchors"))
}

fn test_reject_alias_as_value() {
    let body = "- kg: k\n  source: *alias\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("alias value refused",
             _has(yamlr_errors(r)[0][1], "aliases"))
}

fn test_reject_tag_as_value() {
    let body = "- kg: k\n  source: !!str src:x\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("tag refused",
             _has(yamlr_errors(r)[0][1], "tags"))
}

fn test_reject_block_scalar_pipe() {
    let body = "- kg: k\n  source: |\n    multi\n    line\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("block scalar | refused",
             _has(yamlr_errors(r)[0][1], "block scalars"))
}

fn test_reject_block_scalar_gt() {
    let body = "- kg: k\n  source: >\n    folded\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("block scalar > refused",
             _has(yamlr_errors(r)[0][1], "block scalars"))
}

fn test_reject_merge_key() {
    let body = "- kg: k\n  <<: *other\n  source: src:x\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("merge key refused",
             _has(yamlr_errors(r)[0][1], "merge keys"))
}

fn test_reject_multi_doc_separator() {
    let body = "- kg: k\n  source: src:x\n---\n- kg: k2\n  source: src:y\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("multi-doc refused",
             _has(yamlr_errors(r)[0][1], "multi-document"))
}

fn test_leading_doc_header_tolerated() {
    // A leading `---` before any content is a valid first-doc header.
    let body = "---\n- kg: k\n  source: src:cerec:t\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no errors on leading ---", len(yamlr_errors(r)), 0)
    ce_eq("1 record", len(yamlr_records(r)), 1)
}

fn test_end_of_doc_marker_stops() {
    // `...` ends the doc; records after are ignored.
    let body = "- kg: first\n  source: src:cerec:t\n"
             + "...\n"
             + "- kg: after\n  source: src:cerec:u\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("only first record kept", len(yamlr_records(r)), 1)
    ce_str_eq("first kg", cur_kg(yamlr_records(r)[0]), "first")
}

fn test_reject_flow_inside_list_item() {
    let body = "- [a, b]\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("flow inside list item refused",
             _has(yamlr_errors(r)[0][1], "flow-style sequences"))
}

// ---- full-record shape ----------------------------------------------

fn _sample_body() {
    let s = ""
    s = s + "- kg: solar_system\n"
    s = s + "  source: src:yaml:sample:v1\n"
    s = s + "  capsule:\n"
    s = s + "    name: solar_yaml_pack\n"
    s = s + "    version: \"1.0.0\"\n"
    s = s + "    description: tiny sample\n"
    s = s + "    license: \"CC-BY-4.0\"\n"
    s = s + "    deps:\n"
    s = s + "      - name: physics\n"
    s = s + "        version: \"1.0.0\"\n"
    s = s + "  atoms:\n"
    s = s + "    - label: mercury\n"
    s = s + "      kind: fact\n"
    s = s + "      belief: 900\n"
    s = s + "    - label: hot\n"
    s = s + "      kind: concept\n"
    s = s + "      belief: 800\n"
    s = s + "  implications:\n"
    s = s + "    - ante: mercury\n"
    s = s + "      conseq: hot\n"
    s = s + "      strength: EMPIRICAL\n"
    s = s + "  observations:\n"
    s = s + "    - label: mercury\n"
    s = s + "      sign: 1\n"
    s = s + "      weight: 500\n"
    s = s + "  citations:\n"
    s = s + "    - from: src:yaml:sample:v1\n"
    s = s + "      to: src:paper:X\n"
    s = s + "      rel: supports\n"
    return s
}

fn test_full_record_all_fields_populated() {
    let r = yamlr_parse_text(_sample_body(), "", "")
    let recs = yamlr_records(r)
    ce_eq("no errors", len(yamlr_errors(r)), 0)
    ce_eq("1 record",  len(recs), 1)
    let rec = recs[0]
    ce_str_eq("kg",  cur_kg(rec),     "solar_system")
    ce_str_eq("src", cur_source(rec), "src:yaml:sample:v1")
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("1 imp",   len(cur_imps(rec)),  1)
    ce_eq("1 obs",   len(cur_obs(rec)),   1)
    ce_eq("1 cite",  len(cur_cites(rec)), 1)
    // Capsule
    ce_eq("has capsule", cur_has_capsule(rec), 1)
    ce_str_eq("cap name",    cur_capsule_name(rec),    "solar_yaml_pack")
    ce_str_eq("cap version", cur_capsule_version(rec), "1.0.0")
    ce_str_eq("cap license", cur_capsule_license(rec), "CC-BY-4.0")
    ce_eq("1 dep",   len(cur_capsule_deps(rec)), 1)
    // Atom shape
    let a0 = cur_atoms(rec)[0]
    ce_str_eq("atom label",  a0[CUR_ATOM_LABEL], "mercury")
    ce_eq("atom kind FACT",  a0[CUR_ATOM_KIND],  ATOM_FACT)
    ce_eq("atom belief 900", a0[CUR_ATOM_BELIEF], 900)
    let a1 = cur_atoms(rec)[1]
    ce_eq("atom 1 kind CONCEPT", a1[CUR_ATOM_KIND], ATOM_CONCEPT)
    // Imp shape
    let m0 = cur_imps(rec)[0]
    ce_str_eq("imp ante",     m0[CUR_IMP_ANTE],   "mercury")
    ce_str_eq("imp conseq",   m0[CUR_IMP_CONSEQ], "hot")
    ce_str_eq("imp strength", m0[CUR_IMP_STR],    "EMPIRICAL")
    // Obs shape
    let o0 = cur_obs(rec)[0]
    ce_eq("obs sign +1",   o0[CUR_OBS_SIGN],   1)
    ce_eq("obs weight 500", o0[CUR_OBS_WEIGHT], 500)
    // Cite shape
    let c0 = cur_cites(rec)[0]
    ce_str_eq("cite from", c0[CUR_CITE_FROM], "src:yaml:sample:v1")
    ce_str_eq("cite to",   c0[CUR_CITE_TO],   "src:paper:X")
    ce_str_eq("cite rel",  c0[CUR_CITE_REL],  "supports")
}

// ---- schema-layer lenient errors ------------------------------------

fn test_atom_bad_kind_logged_others_land() {
    let body = "- kg: k\n  source: src:x\n"
             + "  atoms:\n"
             + "    - label: ok\n      kind: fact\n      belief: 500\n"
             + "    - label: wat\n      kind: bogus\n      belief: 500\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("record built", len(yamlr_records(r)), 1)
    ce_eq("1 good atom",  len(cur_atoms(yamlr_records(r)[0])), 1)
    ce_check("error names unknown kind",
             _has(yamlr_errors(r)[0][1], "unknown 'kind'"))
}

fn test_atom_kind_accepts_integer_constant() {
    let body = "- kg: k\n  source: src:x\n"
             + "  atoms:\n    - label: y\n      kind: 1\n      belief: 500\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no errors", len(yamlr_errors(r)), 0)
    ce_eq("kind mapped to FACT",
          cur_atoms(yamlr_records(r)[0])[0][CUR_ATOM_KIND], ATOM_FACT)
}

fn test_imp_strength_validation() {
    let body = "- kg: k\n  source: src:x\n"
             + "  implications:\n    - ante: a\n      conseq: b\n      strength: WEAK\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("error records unknown strength",
             _has(yamlr_errors(r)[0][1], "FORMAL or EMPIRICAL"))
    ce_eq("0 imps landed",
          len(cur_imps(yamlr_records(r)[0])), 0)
}

fn test_obs_sign_validation() {
    let body = "- kg: k\n  source: src:x\n"
             + "  observations:\n    - label: a\n      sign: 2\n      weight: 100\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("error records bad sign",
             _has(yamlr_errors(r)[0][1], "sign' must be +1 or -1"))
    ce_eq("0 obs landed",
          len(cur_obs(yamlr_records(r)[0])), 0)
}

fn test_belief_must_be_int_string_refused() {
    // "500" as a bare string (int detection accepts bare digits, so
    // wrap in quotes to force YT_STR and check the schema rejects).
    let body = "- kg: k\n  source: src:x\n"
             + "  atoms:\n    - label: y\n      kind: fact\n      belief: \"500\"\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("quoted belief refused as string",
             _has(yamlr_errors(r)[0][1], "belief' must be an integer"))
    ce_eq("no atom landed",
          len(cur_atoms(yamlr_records(r)[0])), 0)
}

fn test_weight_must_be_int_string_refused() {
    let body = "- kg: k\n  source: src:x\n"
             + "  observations:\n    - label: a\n      sign: 1\n      weight: \"50\"\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("quoted weight refused as string",
             _has(yamlr_errors(r)[0][1], "weight' must be an integer"))
}

fn test_citation_missing_fields_errors() {
    let body = "- kg: k\n  source: src:x\n"
             + "  citations:\n    - from: src:x\n      to: src:y\n"
    let r = yamlr_parse_text(body, "", "")
    ce_check("citation missing rel",
             _has(yamlr_errors(r)[0][1], "missing 'rel'"))
    ce_eq("0 cites landed",
          len(cur_cites(yamlr_records(r)[0])), 0)
}

// ---- nested-mapping-inside-record shape ------------------------------

fn test_one_level_nested_mapping_capsule() {
    let body = "- kg: k\n  source: src:x\n"
             + "  capsule:\n"
             + "    name: p\n"
             + "    version: \"2.0.0\"\n"
             + "    license: MIT\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no errors", len(yamlr_errors(r)), 0)
    let rec = yamlr_records(r)[0]
    ce_eq("has capsule", cur_has_capsule(rec), 1)
    ce_str_eq("cap name",    cur_capsule_name(rec),    "p")
    ce_str_eq("cap version", cur_capsule_version(rec), "2.0.0")
    ce_str_eq("cap license", cur_capsule_license(rec), "MIT")
}

fn test_capsule_deps_nested_list_of_maps() {
    // Two-level nesting: capsule.deps is a list of {name, version} maps.
    let body = "- kg: k\n  source: src:x\n"
             + "  capsule:\n"
             + "    name: p\n"
             + "    version: \"1.0.0\"\n"
             + "    deps:\n"
             + "      - name: physics\n"
             + "        version: \"1.0.0\"\n"
             + "      - name: math\n"
             + "        version: \"2.5.0\"\n"
    let r = yamlr_parse_text(body, "", "")
    ce_eq("no errors", len(yamlr_errors(r)), 0)
    ce_eq("2 deps", len(cur_capsule_deps(yamlr_records(r)[0])), 2)
}

// ---- source registry dispatch ---------------------------------------

fn test_source_registry_registers_yaml() {
    let reg = reg_source_new()
    reg_source_install_defaults(reg)
    let tag = reg_source_tag(reg, "yaml")
    ce_eq("yaml tag is FMT_YAML", tag, FMT_YAML)
    ce_str_eq("yaml name roundtrip",
              reg_source_name(FMT_YAML), "yaml")
    let entry = reg_source_get(reg, "yaml")
    ce_check("entry found", entry != 0)
    ce_str_eq("prefix", entry[SR_PREFIX], "src:yaml:")
}

// ---- shipped sample file --------------------------------------------

fn test_shipped_sample_yaml_parses() {
    let r = yamlr_parse("data/packs/samples/climate_facts.yaml", "", "")
    let errs = yamlr_errors(r)
    ce_eq("no parse errors", len(errs), 0)
    let recs = yamlr_records(r)
    ce_check("at least 1 record", len(recs) >= 1)
    let r0 = recs[0]
    ce_str_eq("kg is climate", cur_kg(r0), "climate")
    ce_check("record has atoms",       len(cur_atoms(r0)) >= 5)
    ce_check("record has implications", len(cur_imps(r0))  >= 5)
    ce_check("record has observations", len(cur_obs(r0))   >= 1)
    ce_check("record has citations",    len(cur_cites(r0)) >= 1)
    ce_eq("has capsule",               cur_has_capsule(r0), 1)
    ce_str_eq("cap name",              cur_capsule_name(r0),
              "climate_sample_yaml")
}

// ---- non-existent file handling -------------------------------------

fn test_yamlr_parse_missing_file_errors() {
    let r = yamlr_parse("data/packs/samples/definitely-not-a-file.yaml", "", "")
    ce_check("read error surfaced",
             _has(yamlr_errors(r)[0][1], "could not read file"))
    ce_eq("no records", len(yamlr_records(r)), 0)
}

