// Unit tests for src/io/transducers/audio_speaker_id.nova (R19D).
//
// Hermetic coverage of the MFCC-gallery + DTW nearest-neighbour
// speaker-identification pipeline. R17B's `audio_mfcc.nova` ships
// the MFCC; R18C's `audio_wakeword.nova` ships the DTW core
// (wake_dtw_distance) reused for per-entry scoring. R19D ships
// the gallery + match-or-unknown classifier on top.
//
// All fixtures are built in-memory via Klatt phoneme synthesis
// (audio_synth). Three distinct speaker fixtures use three
// spectrally-disparate vowel sequences (alice=/iy ae/, bob=/ae uw/,
// carol=/uw ow/) so each speaker's MFCC signature is far from the
// other two -- distinct enough that DTW on identical reference and
// query is 0, and DTW across distinct speakers is well above any
// reasonable threshold.
//
//   * Empty gallery -> recognize returns "unknown" / -1               (~3)
//   * Enroll 3 distinct speakers -> size monotonic; each recognised   (~5)
//   * Unknown 4th speaker rejected under tight threshold              (~2)
//   * Duplicate enrollment overwrites the same slot                   (~2)
//   * Save + load round-trip preserves recognize results              (~5)
//   * Clear drops all entries; recognize -> unknown                   (~2)
//   * Empty / invalid args                                            (~3)
//   * Chat helper formatting                                          (~3)
//   * Threshold extremes (very low never matches; very high always)   (~2)
//
// Total: ~30+ assertions (well above the ~25 floor in the brief).

import "../ce_test.nova"
import "../../src/io/transducers/audio_speaker_id.nova"
import "../../src/io/effectors/audio_synth.nova"

// ---- fixture builders ---------------------------------------------------
//
// Stitch a sequence of Klatt phonemes into one PCM buffer -- emulates
// a multi-syllable utterance. Each phoneme is AUDIO_PHONEME_SAMPLES
// (1200 samples @ 8 kHz, 150 ms). A 2-phoneme utterance is 300 ms,
// 3-phoneme is 450 ms -- enough to fill several STFT frames.

fn _spk_klatt_utterance(labels) {
    let pcm = list_new()
    let i = 0
    while i < len(labels) {
        let v = synth_phoneme_klatt(labels[i])
        let j = 0
        while j < len(v) {
            push(pcm, v[j])
            j = j + 1
        }
        i = i + 1
    }
    return pcm
}

// Three distinct "speaker" fixtures. Each uses a different vowel
// triple so the formant trajectory -> MFCC trajectory is
// structurally different between speakers.

fn _spk_fixture_alice() {
    let labs = list_new()
    push(labs, "iy")
    push(labs, "ae")
    push(labs, "iy")
    return _spk_klatt_utterance(labs)
}

fn _spk_fixture_bob() {
    let labs = list_new()
    push(labs, "ae")
    push(labs, "uw")
    push(labs, "ae")
    return _spk_klatt_utterance(labs)
}

fn _spk_fixture_carol() {
    let labs = list_new()
    push(labs, "uw")
    push(labs, "ow")
    push(labs, "uw")
    return _spk_klatt_utterance(labs)
}

// A 4th speaker NOT in the gallery -- /a a a/ (low front vowels) is
// spectrally distinct from each of alice/bob/carol.
fn _spk_fixture_dave() {
    let labs = list_new()
    push(labs, "a")
    push(labs, "ah")
    push(labs, "a")
    return _spk_klatt_utterance(labs)
}

// ---- empty gallery contract ---------------------------------------------

fn test_empty_gallery_size_zero() {
    let g = spk_gallery_new()
    ce_eq("empty gallery size = 0", spk_gallery_size(g), 0)
}

fn test_empty_gallery_recognize_unknown() {
    let g = spk_gallery_new()
    let pcm = _spk_fixture_alice()
    let r = spk_gallery_recognize_from_pcm(g, pcm, 8000,
                                           spk_gallery_default_threshold())
    ce_str_eq("empty gallery recognize -> 'unknown'", r[0], "unknown")
    ce_eq("empty gallery distance = -1", r[1], 0 - 1)
}

// ---- single enrollment + self-match ------------------------------------

fn test_enroll_one_speaker() {
    let g = spk_gallery_new()
    let pcm = _spk_fixture_alice()
    let ok = spk_gallery_enroll_from_pcm(g, "alice", pcm, 8000)
    ce_eq("enroll alice -> ok=1", ok, 1)
    ce_eq("after 1 enroll: size = 1", spk_gallery_size(g), 1)
    ce_str_eq("entry[0] label = 'alice'",
              spk_gallery_label_at(g, 0), "alice")
}

fn test_self_match_distance_zero() {
    let g = spk_gallery_new()
    let pcm = _spk_fixture_alice()
    spk_gallery_enroll_from_pcm(g, "alice", pcm, 8000)
    // Recognize the SAME buffer -- DTW of identical MFCC seqs is 0.
    let r = spk_gallery_recognize_from_pcm(g, pcm, 8000,
                                           spk_gallery_default_threshold())
    ce_str_eq("self-match label = 'alice'", r[0], "alice")
    ce_eq("self-match distance = 0", r[1], 0)
}

// ---- 3-speaker gallery: each recognises its own label -------------------

fn test_three_speaker_gallery_each_recognized() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    let pcm_b = _spk_fixture_bob()
    let pcm_c = _spk_fixture_carol()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    spk_gallery_enroll_from_pcm(g, "bob",   pcm_b, 8000)
    spk_gallery_enroll_from_pcm(g, "carol", pcm_c, 8000)
    ce_eq("3-speaker gallery: size = 3", spk_gallery_size(g), 3)
    let thr = spk_gallery_default_threshold()
    let ra = spk_gallery_recognize_from_pcm(g, pcm_a, 8000, thr)
    ce_str_eq("recognize alice fixture -> 'alice'", ra[0], "alice")
    ce_eq("recognize alice distance = 0", ra[1], 0)
    let rb = spk_gallery_recognize_from_pcm(g, pcm_b, 8000, thr)
    ce_str_eq("recognize bob fixture -> 'bob'", rb[0], "bob")
    ce_eq("recognize bob distance = 0", rb[1], 0)
    let rc = spk_gallery_recognize_from_pcm(g, pcm_c, 8000, thr)
    ce_str_eq("recognize carol fixture -> 'carol'", rc[0], "carol")
    ce_eq("recognize carol distance = 0", rc[1], 0)
}

// ---- 4th unknown speaker rejected under tight threshold ----------------

fn test_unknown_speaker_rejected() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    let pcm_b = _spk_fixture_bob()
    let pcm_c = _spk_fixture_carol()
    let pcm_d = _spk_fixture_dave()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    spk_gallery_enroll_from_pcm(g, "bob",   pcm_b, 8000)
    spk_gallery_enroll_from_pcm(g, "carol", pcm_c, 8000)
    // Tight threshold of 100 (well below typical inter-speaker
    // DTW distance on the Klatt /iy ae iy/ vs /a ah a/ pair).
    let r = spk_gallery_recognize_from_pcm(g, pcm_d, 8000, 100)
    ce_str_eq("4th speaker under tight threshold -> 'unknown'",
              r[0], "unknown")
    ce_eq("4th speaker rejected: distance = -1", r[1], 0 - 1)
}

fn test_distinct_speaker_dtw_substantial() {
    // Sanity check: the cross-speaker DTW distance is non-trivially
    // larger than 0, confirming the fixtures are distinct enough
    // that the unknown-rejection probe is meaningful.
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    let pcm_d = _spk_fixture_dave()
    // Run with a very high threshold so we always get the nearest
    // entry, then inspect the distance.
    let r = spk_gallery_recognize_from_pcm(g, pcm_d, 8000, 999999999999)
    ce_str_eq("nearest match with huge threshold -> 'alice'", r[0], "alice")
    ce_check("dave-vs-alice DTW distance is > 0 (fixtures truly distinct)",
             r[1] > 0)
}

// ---- duplicate enrollment overwrites -----------------------------------

fn test_duplicate_enrollment_overwrites() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    let pcm_b = _spk_fixture_bob()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    // Re-enroll alice with bob's PCM. The label must keep its slot
    // (size stays 1) but the descriptor now points to bob's MFCC.
    let ok2 = spk_gallery_enroll_from_pcm(g, "alice", pcm_b, 8000)
    ce_eq("re-enroll same label -> ok=1", ok2, 1)
    ce_eq("after duplicate enroll: size still = 1",
          spk_gallery_size(g), 1)
    // Recognize the NEW descriptor (bob's PCM) -> matches alice with 0.
    let r = spk_gallery_recognize_from_pcm(g, pcm_b, 8000,
                                           spk_gallery_default_threshold())
    ce_str_eq("after overwrite: recognize bob's PCM -> 'alice'",
              r[0], "alice")
    ce_eq("after overwrite: distance = 0", r[1], 0)
}

// ---- save + load round-trip --------------------------------------------

fn test_save_load_round_trip_preserves_results() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    let pcm_b = _spk_fixture_bob()
    let pcm_c = _spk_fixture_carol()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    spk_gallery_enroll_from_pcm(g, "bob",   pcm_b, 8000)
    spk_gallery_enroll_from_pcm(g, "carol", pcm_c, 8000)
    let path = "/tmp/ce_test_spk_gallery.txt"
    let saved = spk_gallery_save(g, path)
    ce_eq("save 3-speaker gallery -> 1", saved, 1)
    let g2 = spk_gallery_load(path)
    ce_eq("loaded gallery size = 3", spk_gallery_size(g2), 3)
    let thr = spk_gallery_default_threshold()
    // Recognize each fixture against the LOADED gallery.
    let ra = spk_gallery_recognize_from_pcm(g2, pcm_a, 8000, thr)
    ce_str_eq("loaded: recognize alice -> 'alice'", ra[0], "alice")
    ce_eq("loaded: distance alice = 0", ra[1], 0)
    let rb = spk_gallery_recognize_from_pcm(g2, pcm_b, 8000, thr)
    ce_str_eq("loaded: recognize bob -> 'bob'", rb[0], "bob")
    ce_eq("loaded: distance bob = 0", rb[1], 0)
    let rc = spk_gallery_recognize_from_pcm(g2, pcm_c, 8000, thr)
    ce_str_eq("loaded: recognize carol -> 'carol'", rc[0], "carol")
    ce_eq("loaded: distance carol = 0", rc[1], 0)
}

fn test_save_empty_gallery_then_load() {
    let g = spk_gallery_new()
    let path = "/tmp/ce_test_spk_gallery_empty.txt"
    let saved = spk_gallery_save(g, path)
    ce_eq("save empty gallery -> 1", saved, 1)
    let g2 = spk_gallery_load(path)
    ce_eq("loaded empty gallery size = 0", spk_gallery_size(g2), 0)
    let pcm = _spk_fixture_alice()
    let r = spk_gallery_recognize_from_pcm(g2, pcm, 8000,
                                           spk_gallery_default_threshold())
    ce_str_eq("loaded empty gallery recognize -> 'unknown'",
              r[0], "unknown")
}

fn test_load_missing_file_returns_empty() {
    let g = spk_gallery_load("/tmp/ce_test_spk_gallery_does_not_exist.txt")
    ce_eq("load missing file -> size = 0", spk_gallery_size(g), 0)
}

// ---- clear --------------------------------------------------------------

fn test_clear_drops_all_entries() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    let pcm_b = _spk_fixture_bob()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    spk_gallery_enroll_from_pcm(g, "bob",   pcm_b, 8000)
    ce_eq("pre-clear size = 2", spk_gallery_size(g), 2)
    spk_gallery_clear(g)
    ce_eq("post-clear size = 0", spk_gallery_size(g), 0)
    let r = spk_gallery_recognize_from_pcm(g, pcm_a, 8000,
                                           spk_gallery_default_threshold())
    ce_str_eq("post-clear recognize -> 'unknown'", r[0], "unknown")
}

fn test_clear_then_reenroll() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    let pcm_b = _spk_fixture_bob()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    spk_gallery_clear(g)
    // Re-enroll a new identity. Dead-sentinel slots from the
    // clear should be reused so the underlying list doesn't grow.
    let ok = spk_gallery_enroll_from_pcm(g, "dave", pcm_b, 8000)
    ce_eq("post-clear enroll dave -> ok=1", ok, 1)
    ce_eq("post-clear+reenroll size = 1", spk_gallery_size(g), 1)
    let r = spk_gallery_recognize_from_pcm(g, pcm_b, 8000,
                                           spk_gallery_default_threshold())
    ce_str_eq("post-clear+reenroll recognize -> 'dave'",
              r[0], "dave")
}

// ---- threshold edges ---------------------------------------------------

fn test_threshold_zero_never_matches() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    let pcm_b = _spk_fixture_bob()
    // With threshold 0, even a zero-distance match would NOT pass
    // (the check is strict `<`). So a non-zero cross-speaker DTW
    // is also rejected, and the result is "unknown".
    let r = spk_gallery_recognize_from_pcm(g, pcm_b, 8000, 0)
    ce_str_eq("threshold=0 + cross-speaker -> 'unknown'",
              r[0], "unknown")
}

fn test_threshold_very_high_always_matches() {
    let g = spk_gallery_new()
    let pcm_a = _spk_fixture_alice()
    spk_gallery_enroll_from_pcm(g, "alice", pcm_a, 8000)
    let pcm_b = _spk_fixture_bob()
    // With a huge threshold, the nearest-neighbour always passes.
    let r = spk_gallery_recognize_from_pcm(g, pcm_b, 8000, 999999999999)
    ce_str_eq("threshold=huge -> nearest entry returned (alice)",
              r[0], "alice")
}

// ---- argument validation ------------------------------------------------

fn test_enroll_empty_label_fails() {
    let g = spk_gallery_new()
    let pcm = _spk_fixture_alice()
    let ok = spk_gallery_enroll_from_pcm(g, "", pcm, 8000)
    ce_eq("enroll empty label -> ok=0", ok, 0)
    ce_eq("after empty-label enroll: gallery still empty",
          spk_gallery_size(g), 0)
}

fn test_enroll_empty_pcm_fails() {
    let g = spk_gallery_new()
    let empty_pcm = list_new()
    let ok = spk_gallery_enroll_from_pcm(g, "alice", empty_pcm, 8000)
    ce_eq("enroll empty PCM -> ok=0", ok, 0)
}

fn test_enroll_zero_sample_rate_fails() {
    let g = spk_gallery_new()
    let pcm = _spk_fixture_alice()
    let ok = spk_gallery_enroll_from_pcm(g, "alice", pcm, 0)
    ce_eq("enroll zero sample rate -> ok=0", ok, 0)
}

// ---- chat helper formatting --------------------------------------------

fn test_enroll_chat_args_usage_line() {
    let s = spk_enroll_chat_args("")
    ce_str_eq("spk_enroll empty arg prints usage",
              s, "(/spk_enroll needs LABEL PATH.wav)")
}

fn test_enroll_chat_args_single_arg() {
    let s = spk_enroll_chat_args("labelonly")
    ce_str_eq("spk_enroll one-arg prints usage",
              s, "(/spk_enroll needs LABEL PATH.wav -- got 1 arg)")
}

fn test_recognize_chat_args_no_arg() {
    let s = spk_recognize_chat_args("")
    ce_str_eq("spk_recognize empty arg prints usage",
              s, "(/spk_recognize needs PATH.wav)")
}

// ---- public constant accessors -----------------------------------------

fn test_public_constants() {
    ce_eq("spk_gallery_max_entries = 64",
          spk_gallery_max_entries(), 64)
    ce_eq("spk_label_max = 64", spk_label_max(), 64)
    ce_check("spk_gallery_default_threshold > 0",
             spk_gallery_default_threshold() > 0)
}

fn main() {
    test_empty_gallery_size_zero()
    test_empty_gallery_recognize_unknown()
    test_enroll_one_speaker()
    test_self_match_distance_zero()
    test_three_speaker_gallery_each_recognized()
    test_unknown_speaker_rejected()
    test_distinct_speaker_dtw_substantial()
    test_duplicate_enrollment_overwrites()
    test_save_load_round_trip_preserves_results()
    test_save_empty_gallery_then_load()
    test_load_missing_file_returns_empty()
    test_clear_drops_all_entries()
    test_clear_then_reenroll()
    test_threshold_zero_never_matches()
    test_threshold_very_high_always_matches()
    test_enroll_empty_label_fails()
    test_enroll_empty_pcm_fails()
    test_enroll_zero_sample_rate_fails()
    test_enroll_chat_args_usage_line()
    test_enroll_chat_args_single_arg()
    test_recognize_chat_args_no_arg()
    test_public_constants()
    ce_summary("audio_speaker_id")
}

main()
