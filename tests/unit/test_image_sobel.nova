// Unit tests for src/io/transducers/image_sobel.nova (P3.3).
//
// Hermetic coverage of the Sobel edge detector + the per-image aggregate
// helpers (edge density, dominant orientation, label formatting). All
// fixtures are built in-memory (alloc + store8) so the suite never
// depends on an on-disk image. The integration test (scenario_q_image_see.sh)
// exercises the perception-path wiring against a hand-built 16x16 PGM
// with a known edge; this unit suite focuses on the algorithm itself.
//
// Assertion targets (~15):
//   * sobel_apply on a flat 16x16 field returns zero edges + zero counts.
//   * sobel_apply on a vertical-edge fixture (left half 0, right half 255)
//     produces edges concentrated in the column at the transition; the
//     dominant orientation bucket is 0 (horizontal gradient = vertical edge).
//   * sobel_apply on a horizontal-edge fixture (top half 0, bottom half 255)
//     produces edges at the row transition; dominant orientation is 2
//     (vertical gradient = horizontal edge).
//   * sobel_edge_density_milli math: 5 / 100 -> 50; 0 / 100 -> 0;
//     100 / 100 -> 1000; total<=0 returns 0 safely.
//   * sobel_dominant_orientation picks the bucket with the highest count;
//     ties are broken to the lower index (first-tie-wins).
//   * sobel_orient_label round-trips the four buckets.
//   * Pixel-area cap rejects an 800x800 fixture (refuses without crashing).
//   * Result-tuple accessors return non-zero pointers on a valid call.

import "../ce_test.nova"
import "../../src/io/transducers/image_sobel.nova"

// ---- fixture builders -----------------------------------------------------

fn _flat_fixture(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// Vertical edge: left half value `low`, right half value `high`. With
// width=16, the transition is at column 8.
fn _vertical_edge_fixture(width, height, low, high) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = width / 2
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = low
            if x >= half { v = high }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Horizontal edge: top half value `low`, bottom half value `high`.
fn _horizontal_edge_fixture(width, height, low, high) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = height / 2
    let y = 0
    while y < height {
        let row_off = y * width
        let v = low
        if y >= half { v = high }
        let x = 0
        while x < width {
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// ---- happy path -----------------------------------------------------------

fn test_flat_field_zero_edges() {
    let buf = _flat_fixture(16, 16, 128)
    let r = sobel_apply(buf, 16, 16)
    ce_eq("flat field edge_count == 0", sobel_result_edge_count(r), 0)
    ce_eq("flat field total == 256", sobel_result_total(r), 256)
    let oc = sobel_result_orient_counts(r)
    ce_eq("flat field orient bucket 0 == 0", oc[0], 0)
    ce_eq("flat field orient bucket 1 == 0", oc[1], 0)
    ce_eq("flat field orient bucket 2 == 0", oc[2], 0)
    ce_eq("flat field orient bucket 3 == 0", oc[3], 0)
}

fn test_vertical_edge_produces_horizontal_orient() {
    // Vertical edge in the image -> Sobel-X (horizontal gradient) is large,
    // Sobel-Y (vertical gradient) is small. Dominant orientation bucket is 0.
    let buf = _vertical_edge_fixture(16, 16, 0, 255)
    let r = sobel_apply(buf, 16, 16)
    let edge_count = sobel_result_edge_count(r)
    ce_check("vertical edge fixture has > 0 edge pixels", edge_count > 0)
    let oc = sobel_result_orient_counts(r)
    ce_check("bucket 0 (horizontal gradient) > bucket 2 (vertical gradient)",
             oc[0] > oc[2])
    let dom = sobel_dominant_orientation(oc)
    ce_eq("dominant orientation for vertical edge is bucket 0", dom, 0)
}

fn test_horizontal_edge_produces_vertical_orient() {
    // Horizontal edge in the image -> Sobel-Y is large, Sobel-X is small.
    // Dominant orientation bucket is 2 (vertical gradient = horizontal edge).
    let buf = _horizontal_edge_fixture(16, 16, 0, 255)
    let r = sobel_apply(buf, 16, 16)
    let edge_count = sobel_result_edge_count(r)
    ce_check("horizontal edge fixture has > 0 edge pixels", edge_count > 0)
    let oc = sobel_result_orient_counts(r)
    ce_check("bucket 2 (vertical gradient) > bucket 0 (horizontal gradient)",
             oc[2] > oc[0])
    let dom = sobel_dominant_orientation(oc)
    ce_eq("dominant orientation for horizontal edge is bucket 2", dom, 2)
}

// ---- aggregate helpers ---------------------------------------------------

fn test_edge_density_milli() {
    // 5 / 100 -> 50 milli (5%).
    ce_eq("5 / 100 == 50 milli", sobel_edge_density_milli(5, 100), 50)
    // 0 / 100 -> 0.
    ce_eq("0 / 100 == 0", sobel_edge_density_milli(0, 100), 0)
    // 100 / 100 -> 1000 (100%).
    ce_eq("100 / 100 == 1000", sobel_edge_density_milli(100, 100), 1000)
    // total <= 0 returns 0 (no divide-by-zero).
    ce_eq("0 / 0 == 0 (safe)", sobel_edge_density_milli(0, 0), 0)
}

fn test_dominant_orientation_ties() {
    // Hand-built counts: bucket 1 wins outright.
    let counts = list_new()
    push(counts, 3)
    push(counts, 7)
    push(counts, 2)
    push(counts, 1)
    ce_eq("dominant_orientation picks max bucket", sobel_dominant_orientation(counts), 1)
    // All zero -> -1.
    let zeros = list_new()
    push(zeros, 0)
    push(zeros, 0)
    push(zeros, 0)
    push(zeros, 0)
    ce_eq("all-zero counts -> -1", sobel_dominant_orientation(zeros), -1)
}

fn test_orient_label_roundtrip() {
    ce_str_eq("bucket 0 -> image_orient_0",   sobel_orient_label(0), "image_orient_0")
    ce_str_eq("bucket 1 -> image_orient_45",  sobel_orient_label(1), "image_orient_45")
    ce_str_eq("bucket 2 -> image_orient_90",  sobel_orient_label(2), "image_orient_90")
    ce_str_eq("bucket 3 -> image_orient_135", sobel_orient_label(3), "image_orient_135")
    ce_str_eq("invalid bucket -> empty string", sobel_orient_label(99), "")
}

// ---- caps + edge cases ---------------------------------------------------

fn test_dimension_cap_rejects_huge() {
    // 800x800 > SOBEL_MAX_DIM (512). Apply must refuse without crashing.
    // We don't actually allocate the data here; we just pass a non-zero
    // pointer in and rely on the size check firing FIRST. (Use a small
    // alloc to keep memory pressure trivial.)
    let dummy = alloc(8)
    let r = sobel_apply(dummy, 800, 800)
    ce_eq("oversized image -> total == 0", sobel_result_total(r), 0)
    ce_eq("oversized image -> edge_count == 0", sobel_result_edge_count(r), 0)
}

fn test_too_small_image_returns_empty() {
    // 2x2 image -> too small for the 3x3 kernel; we should get an
    // all-zero result without crashing.
    let buf = _flat_fixture(2, 2, 128)
    let r = sobel_apply(buf, 2, 2)
    ce_eq("2x2 image -> total == 4", sobel_result_total(r), 4)
    ce_eq("2x2 image -> edge_count == 0", sobel_result_edge_count(r), 0)
}

fn test_result_accessors_nonzero_on_valid_call() {
    let buf = _vertical_edge_fixture(16, 16, 0, 255)
    let r = sobel_apply(buf, 16, 16)
    let mag = sobel_result_magnitudes(r)
    let orient = sobel_result_orientations(r)
    ce_check("magnitudes pointer is non-zero", mag != 0)
    ce_check("orientations pointer is non-zero", orient != 0)
    // A pixel in the middle of the transition column (col 7 or 8) at
    // the centre row should have a substantial magnitude.
    let centre_mag = load8(mag + 8 * 16 + 7)
    ce_check("centre transition magnitude > 0", centre_mag > 0)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_flat_field_zero_edges()
    test_vertical_edge_produces_horizontal_orient()
    test_horizontal_edge_produces_vertical_orient()
    test_edge_density_milli()
    test_dominant_orientation_ties()
    test_orient_label_roundtrip()
    test_dimension_cap_rejects_huge()
    test_too_small_image_returns_empty()
    test_result_accessors_nonzero_on_valid_call()
    ce_summary("image_sobel")
}

main()
