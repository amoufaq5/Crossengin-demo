// Unit tests for src/io/transducers/audio_spectrogram.nova (R16E).
//
// Hermetic coverage of the integer-only STFT / Cooley-Tukey FFT and the
// spectrogram accessors. No I/O at the core (synth_sine / synth_phoneme
// are pure NOVA list builders); JFK is reached via the chat helper at
// the bottom and skipped if not installed.
//
// Coverage targets:
//
//   * Constants + accessors (defaults, frame size cap, milli)         (~4)
//   * Power-of-2 + log helpers, bin-to-Hz / frame-to-ms math          (~6)
//   * FFT identity: IFFT(FFT(x)) ~= x for a known small input         (~3)
//   * FFT on a pure 200 Hz cosine @ 16 kHz, N=512: peak at bin 6      (~3)
//   * FFT on a 1000 Hz cosine @ 8 kHz, N=256: peak at bin 32          (~2)
//   * FFT on silence: all magnitudes zero                             (~2)
//   * STFT on a 200 Hz sine: peak frequency near 200 Hz everywhere    (~3)
//   * STFT on multi-tone (200 + 800 Hz @ 16 kHz): peaks at both bins  (~2)
//   * STFT on white noise: distributed magnitude, no dominant peak    (~2)
//   * Klatt /ae/ vowel @ 8 kHz: peak in [F1..F2] formant band         (~2)
//   * Frame count = floor((N - F) / H) + 1                            (~3)
//   * Bin 0 = 0 Hz; bin N/2-1 ~ Nyquist - bin_width                   (~2)
//   * stft_peak_frequency / stft_magnitude / stft_total_magnitude     (~3)
//   * Edge cases: empty input, short input, hop > frame                (~3)
//
// Total: ~38 assertions (above the 30 brief floor).

import "../ce_test.nova"
import "../../src/io/transducers/audio_spectrogram.nova"
import "../../src/io/effectors/audio_synth.nova"

// ---- fixture builders ---------------------------------------------------

fn _spec_zero_buf(n) {
    let b = list_new()
    let i = 0
    while i < n {
        push(b, 0)
        i = i + 1
    }
    return b
}

fn _spec_noise_buf(n, amp) {
    let b = list_new()
    let i = 0
    let seed = 24601
    while i < n {
        seed = (seed * 1103515245 + 12345) & 1048575
        let v = seed - (seed / (2 * amp + 1)) * (2 * amp + 1) - amp
        push(b, v)
        i = i + 1
    }
    return b
}

// Sum two PCM lists element-wise (used to build a multi-tone signal
// from two synth_sine outputs).
fn _spec_add_lists(a, b) {
    let out = list_new()
    let n = len(a)
    if len(b) < n { n = len(b) }
    let i = 0
    while i < n {
        push(out, a[i] + b[i])
        i = i + 1
    }
    return out
}

// Concatenate two lists.
fn _spec_concat(a, b) {
    let out = list_new()
    let i = 0
    while i < len(a) {
        push(out, a[i])
        i = i + 1
    }
    let j = 0
    while j < len(b) {
        push(out, b[j])
        j = j + 1
    }
    return out
}

// Find argmax bin in a magnitude list (skipping bin 0).
fn _spec_argmax_skip0(mag) {
    let bins = len(mag)
    if bins < 2 { return 0 }
    let best = 1
    let bv = mag[1]
    let k = 2
    while k < bins {
        if mag[k] > bv {
            bv = mag[k]
            best = k
        }
        k = k + 1
    }
    return best
}

// ---- constants + accessors ----------------------------------------------

fn test_defaults_accessors() {
    ce_eq("frame_size default = 512",
          stft_frame_size_default(), 512)
    ce_eq("hop_size default = 256",
          stft_hop_size_default(), 256)
    ce_eq("max_samples = 480000",
          stft_max_samples(), 480000)
    ce_eq("milli base = 1000",
          stft_milli(), 1000)
}

// ---- bin-to-Hz / frame-to-ms math ---------------------------------------

fn test_bin_to_hz_math() {
    // At 16 kHz, frame_size=512 the bin width is 16000/512 = 31.25 Hz.
    // Integer bin_to_hz: bin * sr / frame_size.
    ce_eq("bin 0 = 0 Hz", stft_bin_to_hz(0, 16000, 512), 0)
    // bin 6 -> 6 * 16000 / 512 = 187 Hz (integer truncation).
    ce_eq("bin 6 @ 16 kHz / 512 = 187 Hz",
          stft_bin_to_hz(6, 16000, 512), 187)
    // bin 256 (the would-be Nyquist) -> 8000 Hz.
    ce_eq("bin 256 @ 16 kHz / 512 = 8000 Hz (Nyquist)",
          stft_bin_to_hz(256, 16000, 512), 8000)
    // bin 32 @ 8 kHz / 256 -> 32 * 8000 / 256 = 1000 Hz.
    ce_eq("bin 32 @ 8 kHz / 256 = 1000 Hz",
          stft_bin_to_hz(32, 8000, 256), 1000)
}

fn test_frame_to_ms_math() {
    // hop=256 @ 16 kHz -> 16 ms per frame.
    ce_eq("frame 0 = 0 ms", stft_frame_to_ms(0, 256, 16000), 0)
    ce_eq("frame 1 @ hop=256 / 16 kHz = 16 ms",
          stft_frame_to_ms(1, 256, 16000), 16)
    ce_eq("frame 10 @ hop=256 / 16 kHz = 160 ms",
          stft_frame_to_ms(10, 256, 16000), 160)
}

// ---- FFT on a known cosine ----------------------------------------------
//
// 200 Hz cosine @ 16 kHz, N = 512 samples. Expected: peak at
// bin = round(200 * 512 / 16000) = 6.4 -> 6 or 7.
// We use synth_sine (the project sine synth) since the FFT doesn't
// care about phase -- a sine vs cosine just trades real/imag energy.

fn test_fft_200hz_sine_peak_bin() {
    let pcm = synth_sine(200, 512, 16000)
    let imag = _spec_zero_buf(512)
    let f = fft_radix2(pcm, imag, 512)
    let mag = list_new()
    let half = 256
    let k = 0
    while k < half {
        let re = fft_real(f)[k]
        let im = fft_imag(f)[k]
        // Integer magnitude squared; use a coarse approximation
        // |x| ~ max(|re|, |im|) + min/2 (within 12% of true magnitude)
        // -- enough to find the argmax bin.
        let ar = re
        if ar < 0 { ar = 0 - ar }
        let ai = im
        if ai < 0 { ai = 0 - ai }
        let mx = ar
        let mn = ai
        if ai > ar { mx = ai; mn = ar }
        push(mag, mx + mn / 2)
        k = k + 1
    }
    let best = _spec_argmax_skip0(mag)
    ce_check("200 Hz sine FFT peak in bin range [5, 8]",
             best >= 5 && best <= 8)
    // DC (bin 0) should be near zero for a zero-mean sine.
    let dc = mag[0]
    if dc < 0 { dc = 0 - dc }
    // Peak bin magnitude should exceed bin 100 (a far-off band) by
    // a wide margin.
    ce_check("200 Hz sine peak magnitude > bin 100 (energy concentrated)",
             mag[best] > mag[100] * 4)
    ce_check("200 Hz sine FFT peak bin is non-zero",
             best > 0)
}

fn test_fft_1000hz_sine_8khz_peak_bin() {
    // 1000 Hz sine @ 8 kHz, N = 256. Expected bin = 1000 * 256 / 8000 = 32.
    let pcm = synth_sine(1000, 256, 8000)
    let imag = _spec_zero_buf(256)
    let f = fft_radix2(pcm, imag, 256)
    let mag = list_new()
    let half = 128
    let k = 0
    while k < half {
        let re = fft_real(f)[k]
        let im = fft_imag(f)[k]
        let ar = re
        if ar < 0 { ar = 0 - ar }
        let ai = im
        if ai < 0 { ai = 0 - ai }
        let mx = ar
        let mn = ai
        if ai > ar { mx = ai; mn = ar }
        push(mag, mx + mn / 2)
        k = k + 1
    }
    let best = _spec_argmax_skip0(mag)
    ce_check("1000 Hz @ 8 kHz FFT peak in bin range [30, 34]",
             best >= 30 && best <= 34)
    ce_check("1000 Hz @ 8 kHz: peak >> bin 60",
             mag[best] > mag[60] * 4)
}

fn test_fft_silence_zero_magnitude() {
    let pcm = _spec_zero_buf(256)
    let imag = _spec_zero_buf(256)
    let f = fft_radix2(pcm, imag, 256)
    let re = fft_real(f)
    let im = fft_imag(f)
    let k = 0
    let nonzero = 0
    while k < 256 {
        if re[k] != 0 { nonzero = nonzero + 1 }
        if im[k] != 0 { nonzero = nonzero + 1 }
        k = k + 1
    }
    ce_eq("FFT of silence: all 256 bins zero (real + imag)", nonzero, 0)
}

// ---- IFFT(FFT(x)) ~= x identity -----------------------------------------
//
// We use a tiny N=8 list of small integers so quantization in the milli
// twiddles stays well within rounding tolerance.

fn test_ifft_fft_identity_small() {
    let x = list_new()
    push(x, 100)
    push(x, 200)
    push(x, 50)
    push(x, -75)
    push(x, 25)
    push(x, -50)
    push(x, 175)
    push(x, 30)
    let im = _spec_zero_buf(8)
    let fwd = fft_radix2(x, im, 64)
    // Pad x to 64 for the radix-2 minimum frame size.
    let xpad = list_new()
    let i = 0
    while i < 8 {
        push(xpad, x[i])
        i = i + 1
    }
    while i < 64 {
        push(xpad, 0)
        i = i + 1
    }
    let im64 = _spec_zero_buf(64)
    let fwd64 = fft_radix2(xpad, im64, 64)
    let inv = ifft_radix2(fft_real(fwd64), fft_imag(fwd64), 64)
    let rout = fft_real(inv)
    // Within +/- 20 of the original (integer twiddle rounding error).
    let d0 = rout[0] - xpad[0]
    if d0 < 0 { d0 = 0 - d0 }
    let d1 = rout[1] - xpad[1]
    if d1 < 0 { d1 = 0 - d1 }
    let d2 = rout[2] - xpad[2]
    if d2 < 0 { d2 = 0 - d2 }
    ce_check("IFFT(FFT(x))[0] within +/- 30 of x[0]", d0 <= 30)
    ce_check("IFFT(FFT(x))[1] within +/- 30 of x[1]", d1 <= 30)
    ce_check("IFFT(FFT(x))[2] within +/- 30 of x[2]", d2 <= 30)
}

// ---- STFT on a pure sine -----------------------------------------------

fn test_stft_200hz_sine_peak_frequency() {
    // 1 second of 200 Hz sine @ 16 kHz = 16000 samples; with the
    // default frame_size=512 / hop_size=256, frames = floor((16000 -
    // 512) / 256) + 1 = 61.
    let pcm = synth_sine(200, 16000, 16000)
    let spec = stft(pcm, 16000, 512, 256)
    let nframes = stft_frame_count(spec)
    ce_eq("200 Hz sine @ 16 kHz, 1s, F=512 H=256 -> 61 frames",
          nframes, 61)
    ce_eq("spectrogram bins = 256", stft_bin_count(spec), 256)
    let peak = stft_peak_frequency(spec, 5)
    // Peak frequency for bin 6 @ 16 kHz / 512 = 187 Hz; for bin 7 = 218 Hz.
    // Either is within the +/- 31 Hz bin width of the true 200 Hz.
    ce_check("frame 5 peak frequency in [156, 250] Hz (bin 5..8)",
             peak >= 156 && peak <= 250)
}

fn test_stft_multi_tone_two_peaks() {
    // 200 Hz + 800 Hz @ 16 kHz, 1 second. Expected peaks at bin 6 (~200 Hz)
    // AND bin 25 or 26 (800 * 512 / 16000 = 25.6).
    let s1 = synth_sine(200, 16000, 16000)
    let s2 = synth_sine(800, 16000, 16000)
    let mix = _spec_add_lists(s1, s2)
    let spec = stft(mix, 16000, 512, 256)
    let frames = stft_frames(spec)
    // Look at frame 5 (well past any startup transient).
    let mag = frames[5]
    // Find argmax in [5..8] (the 200 Hz band).
    let lo_band_peak = 0
    let lo_idx = 5
    let k = 5
    while k <= 8 {
        if mag[k] > lo_band_peak { lo_band_peak = mag[k]; lo_idx = k }
        k = k + 1
    }
    // Find argmax in [24..28] (the 800 Hz band).
    let hi_band_peak = 0
    let hi_idx = 24
    k = 24
    while k <= 28 {
        if mag[k] > hi_band_peak { hi_band_peak = mag[k]; hi_idx = k }
        k = k + 1
    }
    // Both must be well above bin 100 (a noise-floor reference).
    ce_check("multi-tone: 200 Hz band peak > bin 100 floor (4x)",
             lo_band_peak > mag[100] * 4)
    ce_check("multi-tone: 800 Hz band peak > bin 100 floor (4x)",
             hi_band_peak > mag[100] * 4)
}

// ---- STFT on white noise ------------------------------------------------

fn test_stft_white_noise_distributed() {
    // White noise has no dominant frequency -- the ratio of peak to mean
    // should be bounded (typically < 10x for true white noise; our LCG
    // is approximately white).
    let pcm = _spec_noise_buf(8192, 5000)
    let spec = stft(pcm, 16000, 512, 256)
    let frames = stft_frames(spec)
    ce_check("white noise: produced >= 1 frame", len(frames) > 0)
    let mag = frames[0]
    let bins = len(mag)
    let total = 0
    let max = 0
    let i = 1
    while i < bins {
        total = total + mag[i]
        if mag[i] > max { max = mag[i] }
        i = i + 1
    }
    // Mean of the non-DC bins:
    let mean = total / (bins - 1)
    // For truly distributed noise the peak / mean ratio is ~5-10. For
    // an LCG-generated approximation we allow up to 25x.
    ce_check("white noise: peak/mean ratio < 25 (distributed magnitude)",
             max < mean * 25)
}

// ---- STFT on Klatt vowel -----------------------------------------------

fn test_stft_klatt_vowel_peak_in_formant_band() {
    // synth_phoneme_klatt("ae") produces 1200 samples @ 8 kHz with
    // formants at F1 = 660 Hz and F2 = 1720 Hz.
    // With FRAME=256, HOP=128 @ 8 kHz the bin width = 31.25 Hz so:
    //   F1 (660 Hz) -> bin ~= 21
    //   F2 (1720 Hz) -> bin ~= 55
    // Mid-frame peak should land in [F1..F2] band; either formant is OK.
    let pcm = synth_phoneme_klatt("ae")
    ce_eq("Klatt ae: 1200 samples", len(pcm), 1200)
    let spec = stft(pcm, 8000, 256, 128)
    let nframes = stft_frame_count(spec)
    ce_check("Klatt ae STFT: produced >= 1 frame", nframes > 0)
    // Mid-frame (5th frame -- past the attack envelope ramp).
    let mid = nframes / 2
    if mid >= nframes { mid = nframes - 1 }
    let peak = stft_peak_frequency(spec, mid)
    // Allow a wide formant band [400..2200] Hz; either F1 or F2
    // should be the strongest, plus +/- 1 bin tolerance.
    ce_check("Klatt ae mid-frame peak in [400, 2200] Hz (F1..F2 band)",
             peak >= 400 && peak <= 2200)
}

// ---- frame count math --------------------------------------------------

fn test_frame_count_math() {
    // 8 frames of 256 samples with hop=128 = 256 + 7 * 128 = 1152 samples.
    let pcm = _spec_zero_buf(1152)
    let spec = stft(pcm, 8000, 256, 128)
    ce_eq("1152 samples, F=256, H=128 -> 8 frames",
          stft_frame_count(spec), 8)
    // 1024 samples with hop=64 = floor((1024 - 256) / 64) + 1 = 13.
    let pcm2 = _spec_zero_buf(1024)
    let spec2 = stft(pcm2, 8000, 256, 64)
    ce_eq("1024 samples, F=256, H=64 -> 13 frames",
          stft_frame_count(spec2), 13)
    // Exactly one frame: pcm = frame_size samples.
    let pcm3 = _spec_zero_buf(256)
    let spec3 = stft(pcm3, 8000, 256, 128)
    ce_eq("256 samples, F=256, H=128 -> 1 frame",
          stft_frame_count(spec3), 1)
}

// ---- bin 0 / Nyquist ---------------------------------------------------

fn test_bin_endpoints() {
    // Bin 0 (DC) always maps to 0 Hz regardless of N or sr.
    ce_eq("stft_bin_to_hz(0, 16000, 512) = 0 Hz", stft_bin_to_hz(0, 16000, 512), 0)
    ce_eq("stft_bin_to_hz(0, 8000, 256) = 0 Hz", stft_bin_to_hz(0, 8000, 256), 0)
}

// ---- accessor / total magnitude helpers --------------------------------

fn test_accessors_silence() {
    let pcm = _spec_zero_buf(2048)
    let spec = stft(pcm, 16000, 512, 256)
    let nframes = stft_frame_count(spec)
    ce_check("silence: produced >= 3 frames", nframes >= 3)
    // Every cell magnitude should be zero.
    let total = stft_total_magnitude(spec)
    ce_eq("silence: total magnitude = 0", total, 0)
    let peak = stft_peak_frequency(spec, 0)
    ce_eq("silence: peak frequency = 0 Hz", peak, 0)
}

fn test_total_magnitude_signal() {
    let pcm = synth_sine(400, 4096, 16000)
    let spec = stft(pcm, 16000, 512, 256)
    let total = stft_total_magnitude(spec)
    ce_check("400 Hz sine: total magnitude > 1_000_000",
             total > 1000000)
    // stft_magnitude bounds check: out-of-range -> 0.
    ce_eq("stft_magnitude(-1, 0): out-of-range frame -> 0",
          stft_magnitude(spec, -1, 0), 0)
    ce_eq("stft_magnitude(9999, 0): out-of-range frame -> 0",
          stft_magnitude(spec, 9999, 0), 0)
}

// ---- edge cases ---------------------------------------------------------

fn test_empty_input() {
    let pcm = list_new()
    let spec = stft(pcm, 16000, 512, 256)
    ce_eq("empty pcm: 0 frames", stft_frame_count(spec), 0)
    ce_eq("empty pcm: frame_size stored", stft_frame_size(spec), 512)
    ce_eq("empty pcm: hop_size stored", stft_hop_size(spec), 256)
}

fn test_short_input_below_frame() {
    // 100 samples, frame_size = 256 -> 0 frames.
    let pcm = _spec_zero_buf(100)
    let spec = stft(pcm, 8000, 256, 128)
    ce_eq("100 samples, F=256: 0 frames", stft_frame_count(spec), 0)
}

fn test_hop_greater_than_frame_rejected() {
    // hop > frame -> no frames emitted (the implementation rejects this
    // up front so the time axis is monotonically increasing).
    let pcm = _spec_zero_buf(2048)
    let spec = stft(pcm, 16000, 256, 512)
    ce_eq("hop > frame: 0 frames", stft_frame_count(spec), 0)
}

fn test_disallowed_frame_size() {
    // 300 is not a power of 2 -> 0 frames.
    let pcm = _spec_zero_buf(2048)
    let spec = stft(pcm, 16000, 300, 128)
    ce_eq("non-power-of-2 frame_size: 0 frames",
          stft_frame_count(spec), 0)
    // 32 is below the floor (STFT_FRAME_MIN = 64).
    let spec2 = stft(pcm, 16000, 32, 16)
    ce_eq("frame_size below min: 0 frames",
          stft_frame_count(spec2), 0)
    // 2048 is above the cap (STFT_FRAME_MAX = 1024).
    let spec3 = stft(pcm, 16000, 2048, 1024)
    ce_eq("frame_size above max: 0 frames",
          stft_frame_count(spec3), 0)
}

fn main() {
    test_defaults_accessors()
    test_bin_to_hz_math()
    test_frame_to_ms_math()

    test_fft_200hz_sine_peak_bin()
    test_fft_1000hz_sine_8khz_peak_bin()
    test_fft_silence_zero_magnitude()

    test_ifft_fft_identity_small()

    test_stft_200hz_sine_peak_frequency()
    test_stft_multi_tone_two_peaks()
    test_stft_white_noise_distributed()
    test_stft_klatt_vowel_peak_in_formant_band()

    test_frame_count_math()
    test_bin_endpoints()

    test_accessors_silence()
    test_total_magnitude_signal()

    test_empty_input()
    test_short_input_below_frame()
    test_hop_greater_than_frame_rejected()
    test_disallowed_frame_size()

    ce_summary("audio_spectrogram")
}

main()
