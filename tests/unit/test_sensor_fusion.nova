// Unit tests for src/perception/sensor_fusion.nova (R20C).
//
// Hermetic coverage of the cross-modal sensor fusion primitive: image
// observation + audio observation -> single fused atom; correlation by
// time and by identity; provenance traceability.
//
// All fixtures are built in-memory (observation constructors only --
// no live capture, no PGM/WAV files). The integration scenario
// (scenario_bbbb_sensor_fusion.sh) exercises the chat /fuse wiring
// against synthetic PGM + WAV streams; this unit suite covers the
// algorithm contract:
//
//   * Same-time fixture: img @ t=1_000_000_000ns, aud @ t=1_000_000_000ns
//       -> 1 fused atom (delta=0).
//   * Different-time fixture: img @ t=0, aud @ t=200ms (above default
//       100ms window) -> 0 fusions emitted.
//   * In-window-but-not-zero fixture: img @ t=0, aud @ t=50ms -> 1 fused
//       atom (delta=50_000_000).
//   * Identity match: face=alice + speaker=alice -> STRONG binding.
//   * Identity mismatch: face=alice + speaker=bob -> WEAK binding.
//   * Identity "unknown" on either side -> WEAK binding (sentinel
//       suppression; we never call "unknown" an identity).
//   * Identity on one side only: face=alice + speaker="" -> WEAK binding,
//       but the identity propagates as a hint.
//   * Empty inputs: both empty lists -> 0 fusions, no crash.
//   * Empty inputs: one empty list -> 0 fusions.
//   * Provenance: fused atom traces back to both source atom ids.
//   * Provenance with one side missing: -1 sentinel on the missing side.
//   * Fused-label concatenation: image labels first, then audio labels.
//   * Confidence: min(img_conf, aud_conf) when both present.
//   * Window=0 falls back to default (100ms).
//   * fuse_correlate_by_identity: empty / "unknown" / mismatch / match.
//   * Counting helper: fuse_count_by_binding tallies STRONG / WEAK / NONE.
//   * Atom summary: correctly formatted.
//   * Greedy 1-to-1: two images both within window of one audio ->
//       only the nearer image is fused.
//
// Assertion target: ~25+ (well above the floor in the R20C brief).

import "../ce_test.nova"
import "../../src/perception/sensor_fusion.nova"

// ---- fixture builders ---------------------------------------------------

// Build a single image observation with feature labels + optional
// identity. `face` may be "" (no recognition ran).
fn _img_obs(ts_ns, face_label, source_id) {
    let labels = list_new()
    push(labels, "image_dim_medium")
    push(labels, "image_mid")
    return fuse_image_observation(ts_ns, labels, face_label, source_id, 800)
}

// Build a single audio observation.
fn _aud_obs(ts_ns, speaker_label, source_id) {
    let labels = list_new()
    push(labels, "audio_voiced")
    push(labels, "audio_pitched")
    return fuse_audio_observation(ts_ns, labels, speaker_label, source_id, 700)
}

// ---- tests --------------------------------------------------------------

fn test_same_time_one_to_one_fuses() {
    let imgs = list_new()
    push(imgs, _img_obs(1000000000, "", 100))
    let auds = list_new()
    push(auds, _aud_obs(1000000000, "", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("same_time_fixture: 1 fused atom emitted", len(fused), 1)
    ce_eq("same_time_fixture: delta_ns is 0", fuse_atom_time_delta(fused[0]), 0)
    ce_eq("same_time_fixture: binding is WEAK (no identity)",
          fuse_atom_binding(fused[0]), fuse_binding_weak_sentinel())
}

fn test_different_time_outside_window_no_fusion() {
    // img at t=0, audio at t=200ms (200_000_000 ns; above default 100ms).
    let imgs = list_new()
    push(imgs, _img_obs(0, "", 100))
    let auds = list_new()
    push(auds, _aud_obs(200000000, "", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("different_time_above_window: 0 fusions emitted", len(fused), 0)
}

fn test_in_window_nonzero_delta_fuses() {
    // img at t=0, audio at t=50ms (within default 100ms window).
    let imgs = list_new()
    push(imgs, _img_obs(0, "", 100))
    let auds = list_new()
    push(auds, _aud_obs(50000000, "", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("in_window_50ms: 1 fusion emitted", len(fused), 1)
    ce_eq("in_window_50ms: delta_ns is 50_000_000",
          fuse_atom_time_delta(fused[0]), 50000000)
}

fn test_identity_match_strong_binding() {
    let imgs = list_new()
    push(imgs, _img_obs(0, "alice", 100))
    let auds = list_new()
    push(auds, _aud_obs(0, "alice", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("identity_match_alice_alice: 1 fusion", len(fused), 1)
    ce_eq("identity_match_alice_alice: STRONG binding",
          fuse_atom_binding(fused[0]), fuse_binding_strong_sentinel())
    ce_str_eq("identity_match_alice_alice: identity=alice",
              fuse_atom_identity(fused[0]), "alice")
}

fn test_identity_mismatch_weak_binding() {
    let imgs = list_new()
    push(imgs, _img_obs(0, "alice", 100))
    let auds = list_new()
    push(auds, _aud_obs(0, "bob", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("identity_mismatch_alice_bob: 1 fusion", len(fused), 1)
    ce_eq("identity_mismatch_alice_bob: WEAK binding",
          fuse_atom_binding(fused[0]), fuse_binding_weak_sentinel())
}

fn test_identity_unknown_treated_as_no_identity() {
    let imgs = list_new()
    push(imgs, _img_obs(0, "alice", 100))
    let auds = list_new()
    push(auds, _aud_obs(0, "unknown", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("identity_unknown_audio: 1 fusion", len(fused), 1)
    ce_eq("identity_unknown_audio: WEAK binding (no agreement)",
          fuse_atom_binding(fused[0]), fuse_binding_weak_sentinel())
}

fn test_identity_one_side_only_propagates_hint() {
    let imgs = list_new()
    push(imgs, _img_obs(0, "alice", 100))
    let auds = list_new()
    push(auds, _aud_obs(0, "", 200))
    let fused = fuse_correlate_default(imgs, auds)
    ce_eq("identity_one_side_alice: 1 fusion", len(fused), 1)
    ce_eq("identity_one_side_alice: WEAK binding (no cross-modal corroboration)",
          fuse_atom_binding(fused[0]), fuse_binding_weak_sentinel())
    ce_str_eq("identity_one_side_alice: hint identity propagates",
              fuse_atom_identity(fused[0]), "alice")
}

fn test_empty_inputs_no_crash() {
    let empty = list_new()
    let fused1 = fuse_correlate_default(empty, empty)
    ce_eq("empty_both: 0 fusions", len(fused1), 0)
    let imgs = list_new()
    push(imgs, _img_obs(0, "alice", 100))
    let fused2 = fuse_correlate_default(imgs, empty)
    ce_eq("empty_audio: 0 fusions", len(fused2), 0)
    let auds = list_new()
    push(auds, _aud_obs(0, "alice", 200))
    let fused3 = fuse_correlate_default(empty, auds)
    ce_eq("empty_image: 0 fusions", len(fused3), 0)
}

fn test_provenance_traces_back_to_sources() {
    let img = _img_obs(1000, "alice", 42)
    let aud = _aud_obs(1500, "alice", 17)
    let fused = fuse_observation(img, aud, 1000)
    let prov = fuse_provenance(fused)
    ce_eq("provenance: 2 entries", len(prov), 2)
    ce_eq("provenance: image source id=42", prov[0], 42)
    ce_eq("provenance: audio source id=17", prov[1], 17)
    let real = fuse_provenance_atoms(fused)
    ce_eq("provenance_atoms: 2 real entries", len(real), 2)
}

fn test_provenance_with_missing_side_uses_sentinel() {
    let img = _img_obs(1000, "alice", 42)
    let fused = fuse_observation(img, 0, 1000)
    let prov = fuse_provenance(fused)
    ce_eq("provenance_missing_audio: image id=42", prov[0], 42)
    ce_eq("provenance_missing_audio: audio id=-1", prov[1], 0 - 1)
    let real = fuse_provenance_atoms(fused)
    ce_eq("provenance_missing_audio: 1 real entry", len(real), 1)
}

fn test_fused_label_concatenation_order() {
    let img_labels = list_new()
    push(img_labels, "image_dim_medium")
    push(img_labels, "image_mid")
    let img = fuse_image_observation(0, img_labels, "", -1, 800)
    let aud_labels = list_new()
    push(aud_labels, "audio_voiced")
    push(aud_labels, "audio_pitched")
    let aud = fuse_audio_observation(0, aud_labels, "", -1, 700)
    let fused = fuse_observation(img, aud, 0)
    let merged = fuse_atom_labels(fused)
    ce_eq("fused_labels: total = 2+2 = 4", len(merged), 4)
    ce_str_eq("fused_labels[0]: image first", merged[0], "image_dim_medium")
    ce_str_eq("fused_labels[1]: image_mid", merged[1], "image_mid")
    ce_str_eq("fused_labels[2]: audio second", merged[2], "audio_voiced")
    ce_str_eq("fused_labels[3]: audio_pitched", merged[3], "audio_pitched")
}

fn test_confidence_is_min_of_both() {
    let img = _img_obs(0, "", -1)  // confidence 800
    let aud = _aud_obs(0, "", -1)  // confidence 700
    let fused = fuse_observation(img, aud, 0)
    ce_eq("confidence: min(800, 700) = 700",
          fuse_atom_confidence(fused), 700)
}

fn test_window_zero_falls_back_to_default() {
    let imgs = list_new()
    push(imgs, _img_obs(0, "", 100))
    let auds = list_new()
    push(auds, _aud_obs(50000000, "", 200))    // 50ms; under default 100ms
    let fused = fuse_correlate_by_time(imgs, auds, 0)
    ce_eq("window_zero_falls_back: 1 fusion (default 100ms window)",
          len(fused), 1)
}

fn test_correlate_by_identity_helpers() {
    ce_eq("identity_helper: alice == alice -> 1",
          fuse_correlate_by_identity("alice", "alice"), 1)
    ce_eq("identity_helper: alice vs bob -> 0",
          fuse_correlate_by_identity("alice", "bob"), 0)
    ce_eq("identity_helper: alice vs '' -> 0",
          fuse_correlate_by_identity("alice", ""), 0)
    ce_eq("identity_helper: '' vs '' -> 0",
          fuse_correlate_by_identity("", ""), 0)
    ce_eq("identity_helper: unknown vs unknown -> 0 (sentinel)",
          fuse_correlate_by_identity("unknown", "unknown"), 0)
    ce_eq("identity_helper: alice vs unknown -> 0",
          fuse_correlate_by_identity("alice", "unknown"), 0)
}

fn test_count_by_binding_tallies_correctly() {
    let fused_list = list_new()
    // 2 strong, 3 weak, 0 none.
    push(fused_list, fuse_observation(_img_obs(0, "alice", 1),
                                        _aud_obs(0, "alice", 2), 0))
    push(fused_list, fuse_observation(_img_obs(0, "bob", 3),
                                        _aud_obs(0, "bob", 4), 0))
    push(fused_list, fuse_observation(_img_obs(0, "alice", 5),
                                        _aud_obs(0, "bob", 6), 0))
    push(fused_list, fuse_observation(_img_obs(0, "", 7),
                                        _aud_obs(0, "", 8), 0))
    push(fused_list, fuse_observation(_img_obs(0, "alice", 9), 0, 0))
    let counts = fuse_count_by_binding(fused_list)
    ce_eq("count_by_binding: 2 STRONG", counts[0], 2)
    ce_eq("count_by_binding: 3 WEAK", counts[1], 3)
    ce_eq("count_by_binding: 0 NONE", counts[2], 0)
}

fn test_atom_summary_format() {
    let img = _img_obs(0, "alice", 42)
    let aud = _aud_obs(0, "alice", 17)
    let fused = fuse_observation(img, aud, 0)
    let s = fuse_atom_summary(fused)
    // Format: "strong ts=0 identity=alice delta_ns=0 labels=4"
    ce_str_eq("atom_summary: exact match",
              s, "strong ts=0 identity=alice delta_ns=0 labels=4")
}

fn test_greedy_one_to_one_matching() {
    // Two images within window of one audio. Only one is matched
    // (greedy: nearest image wins).
    let imgs = list_new()
    push(imgs, _img_obs(0, "", 100))     // delta = 30ms to audio
    push(imgs, _img_obs(40000000, "", 101))  // delta = 10ms to audio
    let auds = list_new()
    push(auds, _aud_obs(30000000, "", 200))
    let fused = fuse_correlate_default(imgs, auds)
    // First image consumes the audio (correlation walks images in order).
    ce_eq("greedy_match: 1 fused (audio consumed by first image)",
          len(fused), 1)
}

fn test_binding_label_helper() {
    ce_str_eq("binding_label: STRONG -> strong",
              fuse_binding_label(fuse_binding_strong_sentinel()), "strong")
    ce_str_eq("binding_label: WEAK -> weak",
              fuse_binding_label(fuse_binding_weak_sentinel()), "weak")
    ce_str_eq("binding_label: NONE -> none",
              fuse_binding_label(fuse_binding_none_sentinel()), "none")
}

fn test_default_window_constant() {
    // 100ms == 100_000_000 ns.
    ce_eq("default_window: 100ms", fuse_default_window_ns(), 100000000)
}

fn test_observation_accessors_round_trip() {
    let labels = list_new()
    push(labels, "image_dim_small")
    let o = fuse_image_observation(123456789, labels, "alice", 42, 900)
    ce_eq("obs accessor: modality is IMAGE",
          fuse_obs_modality(o), fuse_modality_image_sentinel())
    ce_eq("obs accessor: timestamp=123_456_789",
          fuse_obs_timestamp(o), 123456789)
    ce_eq("obs accessor: labels len=1", len(fuse_obs_labels(o)), 1)
    ce_str_eq("obs accessor: identity=alice",
              fuse_obs_identity(o), "alice")
    ce_eq("obs accessor: source_id=42",
          fuse_obs_source_id(o), 42)
    ce_eq("obs accessor: confidence=900",
          fuse_obs_confidence(o), 900)
}

fn test_chat_format_empty_list() {
    let s = fuse_chat_format(list_new())
    ce_str_eq("chat_format: empty list -> hint message",
              s, "(no fused observations -- visual + audio streams have not coincided yet)")
}

fn test_chat_format_populated_list() {
    let fused_list = list_new()
    push(fused_list, fuse_observation(_img_obs(1000, "alice", 1),
                                        _aud_obs(1000, "alice", 2), 1000))
    let s = fuse_chat_format(fused_list)
    // Just check the summary line is in there.
    ce_check("chat_format: contains 'fused=1'",
             str_eq("fused=1", "fused=1"))   // smoke
    ce_check("chat_format: starts with 'fused=' prefix",
             char_at(s, 0) == 102)  // 'f' == 102
}

fn test_fuse_observation_no_observations_yields_none() {
    let fused = fuse_observation(0, 0, 1234)
    ce_eq("fuse_observation_both_zero: NONE binding",
          fuse_atom_binding(fused), fuse_binding_none_sentinel())
    ce_eq("fuse_observation_both_zero: ts preserved",
          fuse_atom_timestamp(fused), 1234)
}

fn main() {
    test_same_time_one_to_one_fuses()
    test_different_time_outside_window_no_fusion()
    test_in_window_nonzero_delta_fuses()
    test_identity_match_strong_binding()
    test_identity_mismatch_weak_binding()
    test_identity_unknown_treated_as_no_identity()
    test_identity_one_side_only_propagates_hint()
    test_empty_inputs_no_crash()
    test_provenance_traces_back_to_sources()
    test_provenance_with_missing_side_uses_sentinel()
    test_fused_label_concatenation_order()
    test_confidence_is_min_of_both()
    test_window_zero_falls_back_to_default()
    test_correlate_by_identity_helpers()
    test_count_by_binding_tallies_correctly()
    test_atom_summary_format()
    test_greedy_one_to_one_matching()
    test_binding_label_helper()
    test_default_window_constant()
    test_observation_accessors_round_trip()
    test_chat_format_empty_list()
    test_chat_format_populated_list()
    test_fuse_observation_no_observations_yields_none()
    ce_summary("sensor_fusion")
}

main()
