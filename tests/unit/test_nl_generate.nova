// Unit tests for src/language/nl_generate.nova (N4, ADR-0062).
// Fluent rendering of KG facts and reasoning chains: articles, number
// agreement, underscore->space, capitalisation, Oxford-comma object lists,
// and multi-hop chain rendering.

import "../ce_test.nova"
import "../../src/language/nl_generate.nova"

// ---- word helpers ----------------------------------------------------------
fn test_helpers() {
    ce_str_eq("deunderscore", nlg_phrase("the_sun"), "the sun")
    ce_str_eq("cap", nlg_cap("rain"), "Rain")
    ce_str_eq("cap leaves caps", nlg_cap("Rain"), "Rain")
    ce_str_eq("article a", nlg_indef_article("liquid"), "a")
    ce_str_eq("article an (vowel)", nlg_indef_article("animal"), "an")
    ce_eq("dogs is plural", nlg_is_plural("dogs"), 1)
    ce_eq("grass not plural (ss)", nlg_is_plural("grass"), 0)
    ce_eq("rain not plural", nlg_is_plural("rain"), 0)
    ce_str_eq("pluralize animal", nlg_pluralize("animal"), "animals")
    ce_str_eq("pluralize berry", nlg_pluralize("berry"), "berries")
    ce_str_eq("pluralize box", nlg_pluralize("box"), "boxes")
    ce_str_eq("pluralize already plural", nlg_pluralize("animals"), "animals")
}

// ---- single-fact clauses ---------------------------------------------------
fn test_clause_is_a() {
    ce_str_eq("is a (consonant)", nlg_clause("rain", ROP_IMPLY, "liquid"), "rain is a liquid")
    ce_str_eq("is an (vowel)", nlg_clause("dog", ROP_IMPLY, "animal"), "dog is an animal")
    ce_str_eq("plural subject -> are + plural obj",
              nlg_clause("dogs", ROP_IMPLY, "animal"), "dogs are animals")
    ce_str_eq("deunderscores both",
              nlg_clause("the_sun", ROP_IMPLY, "star"), "the sun is a star")
}

fn test_clause_causal() {
    ce_str_eq("causal singular", nlg_clause("rain", ROP_CAUSAL, "flood"), "rain leads to flood")
    ce_str_eq("causal plural", nlg_clause("clouds", ROP_CAUSAL, "rain"), "clouds lead to rain")
}

fn test_clause_other() {
    ce_str_eq("analogy", nlg_clause("atom", ROP_ANALOGY, "solar_system"), "atom is like solar system")
    ce_str_eq("opposite", nlg_clause("hot", ROP_OPPOSITE, "cold"), "hot is the opposite of cold")
}

fn test_sentence() {
    ce_str_eq("fact sentence", nlg_fact_sentence("rain", ROP_CAUSAL, "flood"), "Rain leads to flood.")
    ce_str_eq("is_a sentence", nlg_fact_sentence("dog", ROP_IMPLY, "animal"), "Dog is an animal.")
    ce_str_eq("no double period", nlg_sentence_of("rain leads to flood."), "Rain leads to flood.")
}

// ---- object lists / coordination -------------------------------------------
fn test_object_list() {
    ce_str_eq("one", nlg_object_list(["nucleus"]), "nucleus")
    ce_str_eq("two", nlg_object_list(["nucleus", "membrane"]), "nucleus and membrane")
    ce_str_eq("three oxford", nlg_object_list(["water", "sunlight", "soil"]), "water, sunlight, and soil")
    ce_str_eq("deunderscores items", nlg_object_list(["cell_wall", "nucleus"]), "cell wall and nucleus")
}

fn test_clause_multi() {
    ce_str_eq("causal multi",
              nlg_clause_multi("rain", ROP_CAUSAL, ["flooding", "erosion"]),
              "rain leads to flooding and erosion")
    ce_str_eq("single delegates to clause",
              nlg_clause_multi("rain", ROP_IMPLY, ["liquid"]), "rain is a liquid")
    ce_str_eq("three causal",
              nlg_clause_multi("plant", ROP_CAUSAL, ["water", "sunlight", "soil"]),
              "plant leads to water, sunlight, and soil")
}

// ---- reasoning chains ------------------------------------------------------
fn test_chain() {
    ce_str_eq("single node", nlg_chain(["rain"]), "rain")
    ce_str_eq("two hops", nlg_chain(["rain", "flood"]), "rain leads to flood")
    ce_str_eq("three hops",
              nlg_chain(["rain", "flood", "damage"]),
              "rain leads to flood, which leads to damage")
    ce_str_eq("chain sentence",
              nlg_chain_sentence(["morning", "breakfast", "energy"]),
              "Morning leads to breakfast, which leads to energy.")
    ce_str_eq("deunderscores chain nodes",
              nlg_chain(["heavy_rain", "flash_flood"]), "heavy rain leads to flash flood")
}

fn main() {
    test_helpers()
    test_clause_is_a()
    test_clause_causal()
    test_clause_other()
    test_sentence()
    test_object_list()
    test_clause_multi()
    test_chain()
    ce_summary("nl_generate")
}

main()
