// Unit tests for src/reader/fetch_route_learn.nova
// Verifies stage 5: an accepted read marks a route target, raises no learn
// trigger, and strengthens matched anchors; OOV escalates to ask-user; a known
// but incoherent read escalates to fetch. ADR-0012 stage 5.

import "../ce_test.nova"
import "../../src/reader/context_bias.nova"
import "../../src/reader/spreading_activation.nova"
import "../../src/reader/coherence_check.nova"
import "../../src/reader/fetch_route_learn.nova"

fn build_coherent() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    let c1 = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    atom_add_xref(c0, xref_new(c0, c1, XREF_CAUSAL, 800, 1))
    atom_add_xref(c1, xref_new(c1, c0, XREF_CAUSAL, 800, 1))
    let fever = word_atom_new(lang, "fever", 0)
    word_add_sense(fever, c0, 900)
    return renv_new(reg, lang, 0, 0, 0)
}

fn run(e, text) {
    let c = rctx_new(text)
    reader_anchor(e, c)
    reader_bias(e, c, list_new())
    reader_spread(e, c)
    reader_cohere(e, c)
    reader_route(e, c)
    return c
}

fn test_accepted_routes_and_learns() {
    let e = build_coherent()
    let c = run(e, "fever")
    ce_eq("accepted", reader_accepted(c), 1)
    ce_eq("no learn trigger", reader_learn(c), LEARN_NONE)
    ce_eq("routes to reasoning", len(rctx_routes(c)), 1)
    ce_str_eq("route target", rctx_routes(c)[0], ROUTE_REASONING)
    // The matched word was strengthened by the successful read.
    ce_check("anchor strengthened", word_confidence(word_find(renv_lang(e), "fever")) > 500)
}

fn test_oov_asks_user() {
    let e = build_coherent()
    let c = run(e, "fever zzz")
    ce_eq("not accepted", reader_accepted(c), 0)
    ce_eq("ask-user trigger", reader_learn(c), LEARN_ASK_USER)
    ce_eq("no routes on escalate", len(rctx_routes(c)), 0)
}

fn test_known_incoherent_fetches() {
    // Known words whose senses do not mutually reference -> incoherent -> fetch.
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let k = kg_spawn(reg, "k")
    let a = kg_add_atom(k, ATOM_CONCEPT, "alpha", 0)
    let b = kg_add_atom(k, ATOM_CONCEPT, "beta", 0)
    word_add_sense(word_atom_new(lang, "alpha", 0), a, 700)
    word_add_sense(word_atom_new(lang, "beta", 0), b, 700)
    let e = renv_new(reg, lang, 0, 0, 0)
    let c = run(e, "alpha beta")
    ce_eq("not accepted", reader_accepted(c), 0)
    ce_eq("no curiosity (known words)", len(rctx_curiosity(c)), 0)
    ce_eq("fetch trigger", reader_learn(c), LEARN_FETCH)
}

fn main() {
    test_accepted_routes_and_learns()
    test_oov_asks_user()
    test_known_incoherent_fetches()
    ce_summary("fetch_route_learn")
}

main()
