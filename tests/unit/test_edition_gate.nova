// Unit tests for src/editions/edition_gate.nova
// Verifies the ADR-0091 tiered-edition capability matrix: the shared
// trustworthy core (core reasoning + audit) is present in EVERY edition; Edge
// is the locked-down offline subset; Enterprise adds multi-tenant + federation
// + autonomous research + full domain; Research is the introspection superset
// (proof export + benchmark harness). Unknown capabilities fail closed.
// Pure decision module -- no I/O, no LLM. ADR-0091.

import "../ce_test.nova"
import "../../src/editions/edition_gate.nova"

fn test_codes_and_names() {
    ce_eq("edge code", ED_EDGE, 0)
    ce_eq("enterprise code", ED_ENTERPRISE, 1)
    ce_eq("research code", ED_RESEARCH, 2)
    // NOVA note: str_eq is unreliable here (compares identity) and a str_find
    // index of 0 does not compare cleanly with >=; the robust pattern is
    // `str_find(haystack, needle) != -1` ("contains"), which we use throughout.
    ce_check("ed_name edge", str_find(ed_name(ED_EDGE), "Edge") != -1)
    ce_check("ed_name enterprise", str_find(ed_name(ED_ENTERPRISE), "Enterprise") != -1)
    ce_check("ed_name research", str_find(ed_name(ED_RESEARCH), "Research") != -1)
    ce_check("ed_name unknown", str_find(ed_name(99), "unknown") != -1)

    ce_check("cap core", str_find(edition_capability_name(EDC_CORE_REASONING), "core reasoning") != -1)
    ce_check("cap audit", str_find(edition_capability_name(EDC_AUDIT_LOG), "audit log") != -1)
    ce_check("cap multi", str_find(edition_capability_name(EDC_MULTI_TENANT), "multi-tenant isolation") != -1)
    ce_check("cap bench", str_find(edition_capability_name(EDC_BENCH_HARNESS), "benchmark harness") != -1)
    ce_check("cap proof", str_find(edition_capability_name(EDC_PROOF_EXPORT), "proof / trace export") != -1)
    ce_check("cap unknown", str_find(edition_capability_name(999), "unknown capability") != -1)
}

fn test_shared_core_everywhere() {
    // Core reasoning + audit log are the trustworthy core: ALL three editions.
    ce_eq("edge core", edition_allows(ED_EDGE, EDC_CORE_REASONING), 1)
    ce_eq("ent core", edition_allows(ED_ENTERPRISE, EDC_CORE_REASONING), 1)
    ce_eq("res core", edition_allows(ED_RESEARCH, EDC_CORE_REASONING), 1)
    ce_eq("edge audit", edition_allows(ED_EDGE, EDC_AUDIT_LOG), 1)
    ce_eq("ent audit", edition_allows(ED_ENTERPRISE, EDC_AUDIT_LOG), 1)
    ce_eq("res audit", edition_allows(ED_RESEARCH, EDC_AUDIT_LOG), 1)
}

fn test_edge() {
    // Edge: offline, distilled, single-process. Core yes; everything heavy no.
    ce_eq("edge denies multi-tenant", edition_allows(ED_EDGE, EDC_MULTI_TENANT), 0)
    ce_eq("edge denies federation", edition_allows(ED_EDGE, EDC_FEDERATION), 0)
    ce_eq("edge denies autonomous research", edition_allows(ED_EDGE, EDC_AUTONOMOUS_RESEARCH), 0)
    ce_eq("edge denies full domain", edition_allows(ED_EDGE, EDC_FULL_DOMAIN_BREADTH), 0)
    ce_eq("edge denies proof export", edition_allows(ED_EDGE, EDC_PROOF_EXPORT), 0)
    ce_eq("edge denies bench", edition_allows(ED_EDGE, EDC_BENCH_HARNESS), 0)
    ce_eq("edge allows core", edition_allows(ED_EDGE, EDC_CORE_REASONING), 1)
}

fn test_enterprise() {
    // Enterprise: multi-tenant cloud, scale-out, full reasoning + autonomy.
    ce_eq("ent allows multi-tenant", edition_allows(ED_ENTERPRISE, EDC_MULTI_TENANT), 1)
    ce_eq("ent allows federation", edition_allows(ED_ENTERPRISE, EDC_FEDERATION), 1)
    ce_eq("ent allows autonomous research", edition_allows(ED_ENTERPRISE, EDC_AUTONOMOUS_RESEARCH), 1)
    ce_eq("ent allows full domain", edition_allows(ED_ENTERPRISE, EDC_FULL_DOMAIN_BREADTH), 1)
    // Enterprise hides the Research-only introspection surfaces.
    ce_eq("ent denies proof export", edition_allows(ED_ENTERPRISE, EDC_PROOF_EXPORT), 0)
    ce_eq("ent denies bench", edition_allows(ED_ENTERPRISE, EDC_BENCH_HARNESS), 0)
}

fn test_research() {
    // Research: full transparency + benchmark harness; NOT multi-tenant.
    ce_eq("res allows proof export", edition_allows(ED_RESEARCH, EDC_PROOF_EXPORT), 1)
    ce_eq("res allows bench", edition_allows(ED_RESEARCH, EDC_BENCH_HARNESS), 1)
    ce_eq("res allows autonomous research", edition_allows(ED_RESEARCH, EDC_AUTONOMOUS_RESEARCH), 1)
    ce_eq("res allows full domain", edition_allows(ED_RESEARCH, EDC_FULL_DOMAIN_BREADTH), 1)
    // Research is explicitly NOT multi-tenant and is single-node.
    ce_eq("res denies multi-tenant", edition_allows(ED_RESEARCH, EDC_MULTI_TENANT), 0)
    ce_eq("res denies federation", edition_allows(ED_RESEARCH, EDC_FEDERATION), 0)
}

fn test_research_superset_of_core() {
    // Research permits the most capabilities of any edition.
    let edge = edition_capability_count(ED_EDGE)
    let ent = edition_capability_count(ED_ENTERPRISE)
    let res = edition_capability_count(ED_RESEARCH)
    ce_check("research >= enterprise", res >= ent)
    ce_check("research >= edge", res >= edge)
    ce_check("enterprise >= edge", ent >= edge)
    // Edge has exactly the two shared-core capabilities.
    ce_eq("edge count is core only", edge, 2)
}

fn test_fail_closed() {
    // Unknown capability -> 0 in every edition.
    ce_eq("edge unknown cap", edition_allows(ED_EDGE, 999), 0)
    ce_eq("ent unknown cap", edition_allows(ED_ENTERPRISE, 999), 0)
    ce_eq("res unknown cap", edition_allows(ED_RESEARCH, 999), 0)
    // Unknown edition -> 0 for a gated capability.
    ce_eq("unknown edition gated cap", edition_allows(99, EDC_MULTI_TENANT), 0)
}

fn test_render_non_empty() {
    ce_check("edge render non-empty", str_find(edition_render(ED_EDGE), "core reasoning") != -1)
    ce_check("ent render shows multi-tenant", str_find(edition_render(ED_ENTERPRISE), "multi-tenant isolation") != -1)
    ce_check("res render shows bench", str_find(edition_render(ED_RESEARCH), "benchmark harness") != -1)
    ce_check("edge render names edition", str_find(edition_render(ED_EDGE), "Edge") != -1)
}

fn main() {
    test_codes_and_names()
    test_shared_core_everywhere()
    test_edge()
    test_enterprise()
    test_research()
    test_research_superset_of_core()
    test_fail_closed()
    test_render_non_empty()
    ce_summary("edition_gate")
}
main()
