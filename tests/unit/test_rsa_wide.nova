// CE_TEST_TIMEOUT: 240
// RSA-2048/3072/4096 with SHA-256/384/512, PKCS#1 v1.5 and PSS (PR 4b).
// Keys, signatures and digests generated with openssl 3 (genpkey, dgst
// -sign, PSS salt length = hash length, MGF1 = the same hash). Each case
// checks the good signature, a one-byte tamper, the wrong hash id, the
// wrong salt length, a PKCS#1 signature presented as PSS and a truncated
// signature.

import "../ce_test.nova"
import "../../src/safety/rsa.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _hv(c) {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn _hexbuf(h) {
    let n = int_shr(len(h), 1)
    let b = alloc(n + 1)
    let i = 0
    while i < n {
        store8(b + i, _hv(char_at(h, int_mul(i, 2))) * 16 + _hv(char_at(h, int_mul(i, 2) + 1)))
        i = i + 1
    }
    store8(b + n, 0)
    return b
}

fn _case(name, nhex, h, wrong_h, slen, mhex, pkhex, pshex) {
    let N = bnr_from_hex(nhex)
    let k = int_shr(len(nhex), 1)
    ce_eq(name + ": width", rsa_key_bytes(N), k)
    let mh = _hexbuf(mhex)
    let pk = _hexbuf(pkhex)
    let ps = _hexbuf(pshex)
    ce_eq(name + ": PKCS#1 v1.5 verifies", rsa_pkcs1_verify(N, 65537, h, mh, pk, k), 1)
    ce_eq(name + ": PSS verifies", rsa_pss_verify(N, 65537, h, slen, mh, ps, k), 1)
    ce_eq(name + ": PKCS#1 wrong hash id", rsa_pkcs1_verify(N, 65537, wrong_h, mh, pk, k), 0)
    ce_eq(name + ": PSS wrong salt length", rsa_pss_verify(N, 65537, h, slen - 1, mh, ps, k), 0)
    ce_eq(name + ": PKCS#1 sig as PSS", rsa_pss_verify(N, 65537, h, slen, mh, pk, k), 0)
    ce_eq(name + ": truncated sig", rsa_pkcs1_verify(N, 65537, h, mh, pk, k - 1), 0)
    store8(pk + 7, int_xor(load8(pk + 7), 1))
    ce_eq(name + ": tampered PKCS#1", rsa_pkcs1_verify(N, 65537, h, mh, pk, k), 0)
    store8(mh, int_xor(load8(mh), 1))
    ce_eq(name + ": PSS over another digest", rsa_pss_verify(N, 65537, h, slen, mh, ps, k), 0)
}

fn main() {
    _case("2048/sha256", "", RSA_H_SHA256, RSA_H_SHA384, 32, "bee4c1b0beafee879d14880a110dfd1e6b557659f80901668a833c664e9e507c", "", "")
    _case("2048/sha384", "", RSA_H_SHA384, RSA_H_SHA512, 48, "e63988fa463964a61b231df80af79effb80e68527d8407b2f3ca5120d2ee3b9050d8cf5edc4fde40267ea0a481fb7f85", "", "")
    _case("2048/sha512", "", RSA_H_SHA512, RSA_H_SHA256, 64, "3fdbe91644478578e0ba526994770860f22b93d913e29fb56166cf909e60693e4903c4e4aaf98271bbedde2f85ebe33c7ea7dbc793dd6eaaec4f027d4cb9e183", "", "")
    _case("3072/sha256", "", RSA_H_SHA256, RSA_H_SHA384, 32, "bee4c1b0beafee879d14880a110dfd1e6b557659f80901668a833c664e9e507c", "", "")
    _case("3072/sha384", "", RSA_H_SHA384, RSA_H_SHA512, 48, "e63988fa463964a61b231df80af79effb80e68527d8407b2f3ca5120d2ee3b9050d8cf5edc4fde40267ea0a481fb7f85", "", "")
    _case("3072/sha512", "", RSA_H_SHA512, RSA_H_SHA256, 64, "3fdbe91644478578e0ba526994770860f22b93d913e29fb56166cf909e60693e4903c4e4aaf98271bbedde2f85ebe33c7ea7dbc793dd6eaaec4f027d4cb9e183", "", "")
    _case("4096/sha256", "", RSA_H_SHA256, RSA_H_SHA384, 32, "bee4c1b0beafee879d14880a110dfd1e6b557659f80901668a833c664e9e507c", "", "")
    _case("4096/sha384", "", RSA_H_SHA384, RSA_H_SHA512, 48, "e63988fa463964a61b231df80af79effb80e68527d8407b2f3ca5120d2ee3b9050d8cf5edc4fde40267ea0a481fb7f85", "", "")
    _case("4096/sha512", "", RSA_H_SHA512, RSA_H_SHA256, 64, "3fdbe91644478578e0ba526994770860f22b93d913e29fb56166cf909e60693e4903c4e4aaf98271bbedde2f85ebe33c7ea7dbc793dd6eaaec4f027d4cb9e183", "", "")
    ce_summary("rsa_wide")
}

main()
