// CE_TEST_TIMEOUT: 240
// PR 4d: path building on REAL server chains (captured 2026-11-16 through
// the sandbox's CONNECT proxy and its transparent egress gateway). Servers
// omit the root; the top certs are often cross-signed by a root the client
// may not have. Anchors are the matching roots from the system CA bundle,
// embedded so the test does not depend on the runner's bundle; `now` is
// pinned so expiry of the real leaves does not break it.
//   WIKI:   *.wikipedia.org (P-256) <- Let's Encrypt YE2 (P-384) <- ISRG
//           Root YE (cross-signed by X2) <- ISRG Root X2 (cross-signed by X1)
//   EXCOM:  example.com (P-256) <- Cloudflare ECC CA 3 <- SSL.com Transit
//           ECC R2 <- SSL.com ECC Root 2022 (cross-signed by "AAA", absent)
//   GOOGLE: www.google.com <- GTS WE2 <- GTS Root R4 (cross-signed by
//           GlobalSign Root CA)
//   GW:     the egress gateway's chain for *.wikipedia.org with its root
//           left out.

import "../ce_test.nova"
import "../../src/safety/x509_verify.nova"
import "../../src/safety/pem_truststore.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

let WIKI_N = 4
let WIKI_0 = ""
let WIKI_1 = ""
let WIKI_2 = ""
let WIKI_3 = ""
let EXCOM_N = 4
let EXCOM_0 = ""
let EXCOM_1 = ""
let EXCOM_2 = ""
let EXCOM_3 = ""
let GOOGLE_N = 3
let GOOGLE_0 = ""
let GOOGLE_1 = ""
let GOOGLE_2 = ""
let GW_N = 2
let GW_0 = ""
let GW_1 = ""
let ROOT_0_B64 = ""   // ISRG Root X2
let ROOT_1_B64 = ""   // SSL.com TLS ECC Root CA 2022
let ROOT_2_B64 = ""   // GTS Root R4
let ROOT_3_B64 = ""   // sandbox-egress-gateway-production Egress Gateway CA

let NOW = 1795300000   // 2026-11-21

fn _rc_hv(c) {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn _rc_der(h) {
    let n = int_shr(len(h), 1)
    let b = alloc(n + 1)
    let i = 0
    while i < n {
        store8(b + i, _rc_hv(char_at(h, int_mul(i, 2))) * 16 + _rc_hv(char_at(h, int_mul(i, 2) + 1)))
        i = i + 1
    }
    let p = list_new()
    push(p, b) push(p, n)
    return p
}

fn _rc_pem(b64) {
    return "-----BEGIN CERTIFICATE-----\n" + b64 + "\n-----END CERTIFICATE-----\n"
}

fn _rc_anchors(which) {
    let pem = ""
    if which == 0 { pem = _rc_pem(ROOT_0_B64) }
    if which == 1 { pem = _rc_pem(ROOT_1_B64) }
    if which == 2 { pem = _rc_pem(ROOT_2_B64) }
    if which == 3 { pem = _rc_pem(ROOT_3_B64) }
    if which == 9 { pem = _rc_pem(ROOT_0_B64) + _rc_pem(ROOT_1_B64) + _rc_pem(ROOT_2_B64) + _rc_pem(ROOT_3_B64) }
    return truststore_load(pem)
}

fn _rc_status(chain, host, anchors) {
    return cert_chain_verify(chain, host, anchors, NOW)[0]
}

fn main() {
    let all = _rc_anchors(9)
    ce_eq("four roots load", len(all), 4)

    let wiki = list_new() push(wiki, _rc_der(WIKI_0)) push(wiki, _rc_der(WIKI_1)) push(wiki, _rc_der(WIKI_2)) push(wiki, _rc_der(WIKI_3))
    ce_eq("wikipedia: verifies to ISRG Root X2", _rc_status(wiki, "en.wikipedia.org", all), XV_OK)
    ce_eq("wikipedia: only X2 needed", _rc_status(wiki, "en.wikipedia.org", _rc_anchors(0)), XV_OK)
    ce_eq("wikipedia: wrong host", _rc_status(wiki, "example.com", all), XV_HOSTNAME)
    ce_eq("wikipedia: not trusted without X2", _rc_status(wiki, "en.wikipedia.org", _rc_anchors(1)), XV_NOT_PINNED)
    let wiki3 = list_new() push(wiki3, _rc_der(WIKI_0)) push(wiki3, _rc_der(WIKI_1)) push(wiki3, _rc_der(WIKI_2))
    ce_eq("wikipedia without the X2 cross cert", _rc_status(wiki3, "en.wikipedia.org", all), XV_OK)

    let ex = list_new() push(ex, _rc_der(EXCOM_0)) push(ex, _rc_der(EXCOM_1)) push(ex, _rc_der(EXCOM_2)) push(ex, _rc_der(EXCOM_3))
    ce_eq("example.com: verifies to SSL.com ECC 2022", _rc_status(ex, "example.com", _rc_anchors(1)), XV_OK)
    ce_eq("example.com: not trusted under ISRG X2", _rc_status(ex, "example.com", _rc_anchors(0)), XV_NOT_PINNED)

    let gg = list_new() push(gg, _rc_der(GOOGLE_0)) push(gg, _rc_der(GOOGLE_1)) push(gg, _rc_der(GOOGLE_2))
    ce_eq("google: verifies to GTS Root R4", _rc_status(gg, "www.google.com", _rc_anchors(2)), XV_OK)

    let gw = list_new() push(gw, _rc_der(GW_0)) push(gw, _rc_der(GW_1))
    ce_eq("gateway chain, root omitted: issued-by-anchor", _rc_status(gw, "en.wikipedia.org", _rc_anchors(3)), XV_OK)
    ce_eq("gateway chain not trusted under public roots", _rc_status(gw, "en.wikipedia.org", _rc_anchors(0)), XV_NOT_PINNED)

    // Splicing: a real leaf placed under another real chain's intermediate.
    let mix = list_new() push(mix, _rc_der(EXCOM_0)) push(mix, _rc_der(WIKI_1)) push(mix, _rc_der(WIKI_2))
    ce_check("spliced chain refused", _rc_status(mix, "example.com", all) != XV_OK)
    ce_summary("real_chains")
}

main()
