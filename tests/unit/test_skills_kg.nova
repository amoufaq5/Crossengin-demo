// Unit tests for src/kg/skills_kg.nova
// Verifies skill creation, step/precondition/effect assembly, precondition
// gating and ordered activation, Bayesian reliability via observation,
// retirement, and composition. ADR-0019.

import "../ce_test.nova"
import "../../src/kg/skills_kg.nova"

fn strlist(items) {
    let l = list_new()
    let i = 0
    while i < len(items) { push(l, items[i]); i = i + 1 }
    return l
}

fn test_create_and_assemble() {
    let reg = kg_registry_new()
    let sk = skills_kg_init(reg)
    ce_str_eq("skills kg label", kg_label(sk), "skills")
    let s = skill_new(sk, "take_medicine", "headache", 0)
    ce_str_eq("trigger", skill_trigger(s), "headache")
    ce_eq("no steps yet", skill_step_count(s), 0)
    ce_eq("skill is ATOM_SKILL", atom_kind(s), ATOM_SKILL)
    ce_eq("uniform reliability", skill_reliability(s), 500)
    ce_eq("no executions", skill_executions(s), 0)

    skill_add_step(sk, s, "", 15, 0)            // unconditional -> signal 15
    skill_add_step(sk, s, "have_pills", 16, 0)  // conditional  -> signal 16
    ce_eq("two steps", skill_step_count(s), 2)
    skill_add_precondition(s, "awake")
    skill_add_effect(s, "pain_relieved")
    ce_eq("one precondition", len(skill_preconditions(s)), 1)
    ce_eq("one effect", len(skill_effects(s)), 1)
}

fn test_activation() {
    let reg = kg_registry_new()
    let sk = skills_kg_init(reg)
    let s = skill_new(sk, "act", "t", 0)
    skill_add_step(sk, s, "", 15, 0)
    skill_add_step(sk, s, "have_pills", 16, 0)
    skill_add_precondition(s, "awake")

    // Preconditions met, both step conditions satisfied -> both fire in order.
    let out = skill_activate(sk, s, strlist(["awake", "have_pills"]))
    ce_eq("two actions", len(out), 2)
    ce_eq("first action", out[0], 15)
    ce_eq("second action", out[1], 16)
    // Conditional step's condition absent -> only the unconditional step fires.
    let out2 = skill_activate(sk, s, strlist(["awake"]))
    ce_eq("one action", len(out2), 1)
    ce_eq("only unconditional", out2[0], 15)
    // Preconditions unmet -> nothing fires.
    ce_eq("preconditions gate activation", len(skill_activate(sk, s, strlist(["asleep"]))), 0)
}

fn test_reliability_and_retire() {
    let reg = kg_registry_new()
    let sk = skills_kg_init(reg)
    let s = skill_new(sk, "flaky", "t", 0)
    // Eight failures -> low reliability, enough executions -> retire.
    let i = 0
    while i < 8 { skill_observe(s, -1); i = i + 1 }
    ce_eq("executions 8", skill_executions(s), 8)
    ce_check("reliability low", skill_reliability(s) < SKILL_RETIRE)
    ce_eq("should retire", skill_should_retire(s), 1)

    // A reliable skill is not retired.
    let g = skill_new(sk, "good", "t", 0)
    let j = 0
    while j < 8 { skill_observe(g, 1); j = j + 1 }
    ce_check("good reliability high", skill_reliability(g) > 500)
    ce_eq("good not retired", skill_should_retire(g), 0)

    // Too few executions -> not judged yet, even if currently unreliable.
    let n = skill_new(sk, "new", "t", 0)
    skill_observe(n, -1)
    ce_eq("not enough executions to retire", skill_should_retire(n), 0)
}

fn test_compose() {
    let reg = kg_registry_new()
    let sk = skills_kg_init(reg)
    let s1 = skill_new(sk, "s1", "trig1", 0)
    skill_add_step(sk, s1, "", 15, 0)
    skill_add_precondition(s1, "p1")
    let s2 = skill_new(sk, "s2", "trig2", 0)
    skill_add_step(sk, s2, "", 16, 0)
    skill_add_effect(s2, "e2")

    let c = skill_compose(sk, s1, s2, "combo", 0)
    ce_eq("composed steps concatenated", skill_step_count(c), 2)
    ce_str_eq("trigger from s1", skill_trigger(c), "trig1")
    ce_eq("preconditions from s1", len(skill_preconditions(c)), 1)
    ce_eq("effects from s2", len(skill_effects(c)), 1)
    // Composed skill runs both actions in order.
    let out = skill_activate(sk, c, strlist(["p1"]))
    ce_eq("composed runs both", len(out), 2)
}

fn main() {
    test_create_and_assemble()
    test_activation()
    test_reliability_and_retire()
    test_compose()
    ce_summary("skills_kg")
}

main()
