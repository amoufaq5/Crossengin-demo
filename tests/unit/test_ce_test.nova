// Meta-tests: the test harness (tests/ce_test.nova) itself is load-bearing --
// every unit test depends on ce_check / ce_eq / ce_str_eq / ce_near /
// ce_summary being honest. This suite covers the boundary: string equality
// (the previously flaky path -- the underlying NOVA str_eq gave WRONG results
// on certain identical literals, causing hundreds of tests to report ghost
// FAILs of the form `expected='CONST' got='CONST'`).
//
// The harness contract this file tests: _ce_str_eq_bytes returns 1 iff two
// strings have the same length AND every byte matches. Nothing else -- no
// str_eq call, no truthiness quirks.

import "../ce_test.nova"

fn test_bytes_eq_identical() {
    ce_eq("empty == empty", _ce_str_eq_bytes("", ""), 1)
    ce_eq("single char", _ce_str_eq_bytes("a", "a"), 1)
    ce_eq("multi char",  _ce_str_eq_bytes("hello", "hello"), 1)
    ce_eq("uppercase literal (previously false-FAIL family)",
        _ce_str_eq_bytes("CONST", "CONST"), 1)
    ce_eq("another literal from the flaky family",
        _ce_str_eq_bytes("INVALID", "INVALID"), 1)
    ce_eq("strings with spaces", _ce_str_eq_bytes("a b c", "a b c"), 1)
}

fn test_bytes_eq_different() {
    ce_eq("empty vs single -> ne", _ce_str_eq_bytes("", "a"), 0)
    ce_eq("single vs empty -> ne", _ce_str_eq_bytes("a", ""), 0)
    ce_eq("case differs -> ne",    _ce_str_eq_bytes("A", "a"), 0)
    ce_eq("length differs -> ne",  _ce_str_eq_bytes("ab", "abc"), 0)
    ce_eq("last byte differs -> ne", _ce_str_eq_bytes("abc", "abd"), 0)
    ce_eq("first byte differs -> ne", _ce_str_eq_bytes("xbc", "abc"), 0)
}

// The public ce_str_eq passes/fails silently as expected. We can't easily
// probe the internal pass/fail counters here without confusing our own summary,
// but we can validate that identical strings don't emit "FAIL" and different
// ones do -- which is exactly the contract downstream tests need.
fn test_ce_str_eq_smoke_identical() {
    ce_str_eq("identical", "hello", "hello")
    ce_str_eq("identical uppercase literal", "CONST", "CONST")
    ce_str_eq("identical with punctuation", "one, two", "one, two")
}

fn main() {
    test_bytes_eq_identical()
    test_bytes_eq_different()
    test_ce_str_eq_smoke_identical()
    ce_summary("ce_test")
}

main()
