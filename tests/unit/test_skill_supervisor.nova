// Unit tests for src/skills/skill_supervisor.nova + skill_dispatch.nova
// + skills/echo_skill.nova (ADR-0103 R47p2).
//
// Verifies the 5 hard guarantees from the invocation contract:
//   1. Pre-policy refusal conditions short-circuit.
//   2. Persona projection ALWAYS attached (even on refusal).
//   3. Effector calls are DESCRIBED, not executed.
//   4. Every atom touched flows to the meta-observer.
//   5. Persona is READ-ONLY through the runtime.

import "../ce_test.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona.nova"

fn _wire_test_kg(kgreg, kg_name, atoms) {
    // Register or spawn the KG under kg_name; seed each label at belief 800.
    let kg = kg_spawn(kgreg, kg_name)
    let i = 0
    while i < len(atoms) {
        let a = kg_add_atom(kg, ATOM_FACT, atoms[i], 0)
        let b = atom_belief(a)
        list_set(b, 0, 4000)
        list_set(b, 1, 1000)
        i = i + 1
    }
    return kg
}

fn _new_supervisor_for_echo() {
    let m = echo_skill_manifest()
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let mo = mo_new()
    let sup = skill_supervisor_new(m, kgreg, capreg, 0, 0, mo, 100)
    return sup
}

// ---- basic lifecycle ------------------------------------------------------

fn test_supervisor_new_shape() {
    let sup = _new_supervisor_for_echo()
    ce_check("manifest attached", skill_sup_manifest(sup) != 0)
    ce_check("kg registry attached", skill_sup_kg_registry(sup) != 0)
    ce_check("capsule registry attached", skill_sup_capreg(sup) != 0)
    ce_eq("no persona", skill_sup_persona(sup), 0)
    ce_check("meta observer attached", skill_sup_meta_observer(sup) != 0)
    ce_eq("tick count 0", skill_sup_tick_count(sup), 0)
    ce_eq("status STARTING", skill_sup_status(sup), SKILL_STARTING)
    ce_str_eq("status name", skill_sup_status_name(skill_sup_status(sup)), "starting")
}

fn test_supervisor_retire() {
    let sup = _new_supervisor_for_echo()
    skill_sup_retire(sup)
    ce_eq("status RETIRED", skill_sup_status(sup), SKILL_RETIRED)
    ce_eq("live state cleared", len(skill_sup_live_state(sup)), 0)
}

// ---- echo_skill end-to-end ------------------------------------------------

fn test_echo_skill_no_kgs_ok_but_zero_matches() {
    let sup = _new_supervisor_for_echo()
    let result = skill_run(sup, "moon")
    ce_eq("ok", skill_pr_ok(result), 1)
    ce_eq("no atoms matched", len(skill_pr_atoms(result)), 0)
    ce_eq("confidence 0", skill_pr_confidence(result), 0)
    ce_eq("no effector calls", len(skill_pr_effector_calls(result)), 0)
    ce_eq("no refusal reason", skill_pr_refusal_reason(result), "")
}

fn test_echo_skill_walks_kg_finds_matches() {
    let sup = _new_supervisor_for_echo()
    let atoms = list_new()
    push(atoms, "moon_landing_1969") push(atoms, "apollo_11")
    push(atoms, "einstein")           push(atoms, "general_relativity")
    _wire_test_kg(skill_sup_kg_registry(sup), "history", atoms)
    let result = skill_run(sup, "moon landing details")
    ce_eq("ok", skill_pr_ok(result), 1)
    // Token "moon" matches "moon_landing_1969"; "landing" also matches it.
    // So 1 atom matched at least (dedup at the atom level is not applied
    // -- the loop matches per-token but breaks on first match per atom).
    ce_check("at least 1 atom matched", len(skill_pr_atoms(result)) >= 1)
    ce_check("confidence > 0", skill_pr_confidence(result) > 0)
    ce_check("trace non-empty", len(skill_pr_trace(result)) >= 1)
}

fn test_echo_skill_no_effector_calls_ever() {
    let sup = _new_supervisor_for_echo()
    let atoms = list_new() push(atoms, "anything")
    _wire_test_kg(skill_sup_kg_registry(sup), "kg", atoms)
    let result = skill_run(sup, "anything")
    // Guarantee 3: effector calls are DESCRIBED (list), not executed.
    // echo_skill declares NO effectors, so the list is empty.
    ce_eq("no effector calls", len(skill_pr_effector_calls(result)), 0)
}

fn test_supervisor_tick_bumps_on_each_run() {
    let sup = _new_supervisor_for_echo()
    ce_eq("tick 0", skill_sup_tick_count(sup), 0)
    skill_run(sup, "q1")
    ce_eq("tick 1", skill_sup_tick_count(sup), 1)
    skill_run(sup, "q2")
    ce_eq("tick 2", skill_sup_tick_count(sup), 2)
}

// ---- guarantee 4: meta-observer attribution -------------------------------

fn test_supervisor_attributes_atoms_via_meta_observer() {
    let sup = _new_supervisor_for_echo()
    let atoms = list_new()
    push(atoms, "moon_landing_1969") push(atoms, "apollo_11")
    _wire_test_kg(skill_sup_kg_registry(sup), "history", atoms)
    let result = skill_run(sup, "moon apollo")
    // Every atom in result.atoms was attributed via the mo under the
    // skill's src:skill:echo:v1.0.0 tag.
    let mo = skill_sup_meta_observer(sup)
    let report = mo_report(mo)
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:skill:echo:v1.0.0") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("skill attribution flowed to meta-observer", saw, 1)
}

// ---- guarantee 1: pre-policy refusals short-circuit -----------------------

fn test_pre_refusal_kg_empty_short_circuits() {
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_KG_EMPTY, "missing_kg")
    let kgreg = kg_registry_new()
    let sup = skill_supervisor_new(m, kgreg, 0, 0, 0, mo_new(), 100)
    let result = skill_run(sup, "any query")
    ce_eq("refused", skill_pr_ok(result), 0)
    ce_check("reason mentions kg-empty", len(skill_pr_refusal_reason(result)) > 0)
    ce_eq("status REFUSED", skill_sup_status(sup), SKILL_REFUSED)
}

fn test_pre_refusal_capsule_uninstalled() {
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_CAPSULE_UNINSTALLED, "biology")
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   0, 0, mo_new(), 100)
    let result = skill_run(sup, "any query")
    ce_eq("refused", skill_pr_ok(result), 0)
    ce_check("reason present", len(skill_pr_refusal_reason(result)) > 0)
}

fn test_pre_refusal_persona_missing() {
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_PERSONA_MISSING, 0)
    // Supervisor with persona=0 -> pre-refusal fires.
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   0, 0, mo_new(), 100)
    let result = skill_run(sup, "any")
    ce_eq("refused", skill_pr_ok(result), 0)
    ce_check("reason present", len(skill_pr_refusal_reason(result)) > 0)
}

fn test_persona_missing_passes_when_persona_attached() {
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_PERSONA_MISSING, 0)
    let p = persona_new("alice", "A", "", 100)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   p, 0, mo_new(), 100)
    let result = skill_run(sup, "any")
    ce_eq("ok (persona present)", skill_pr_ok(result), 1)
}

// ---- guarantee 2: persona projection ALWAYS attached ----------------------

fn test_projection_attached_on_successful_run() {
    let m = echo_skill_manifest()
    let p = persona_new("alice", "A", "", 100)
    persona_add_preference(p, "moon", 800, "src:user:alice", 110)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   p, 0, mo_new(), 100)
    let result = skill_run(sup, "moon exploration")
    ce_eq("ok", skill_pr_ok(result), 1)
    ce_check("projection attached", skill_pr_projection(result) != 0)
}

fn test_projection_attached_even_on_refusal() {
    // Refuse via COND_KG_EMPTY, but ALSO attach a persona -- projection
    // still appears in the result.
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_KG_EMPTY, "nonexistent")
    let p = persona_new("alice", "A", "", 100)
    let sup = skill_supervisor_new(m, kg_registry_new(), 0, p, 0,
                                   mo_new(), 100)
    let result = skill_run(sup, "whatever")
    ce_eq("refused", skill_pr_ok(result), 0)
    ce_check("projection STILL attached", skill_pr_projection(result) != 0)
}

fn test_projection_zero_when_no_persona() {
    let sup = _new_supervisor_for_echo()   // persona=0
    let result = skill_run(sup, "q")
    ce_eq("no projection", skill_pr_projection(result), 0)
}

// ---- guarantee 5: persona is READ-ONLY ------------------------------------

fn test_persona_history_unchanged_by_skill_run() {
    let m = echo_skill_manifest()
    let p = persona_new("alice", "A", "", 100)
    // Persona starts with 0 history.
    ce_eq("history 0 pre-run", persona_history_count(p), 0)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   p, 0, mo_new(), 100)
    skill_run(sup, "some query")
    // Skill run must NOT append to history. That's operator work.
    ce_eq("history 0 post-run", persona_history_count(p), 0)
}

fn test_persona_prefs_unchanged_by_skill_run() {
    let m = echo_skill_manifest()
    let p = persona_new("alice", "A", "", 100)
    persona_add_preference(p, "concise", 800, "src:user:alice", 110)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   p, 0, mo_new(), 100)
    skill_run(sup, "concise report")
    ce_eq("prefs count unchanged", persona_preferences_count(p), 1)
    let pr = persona_find_preference(p, "concise")
    ce_eq("weight unchanged", pr[PER_PREF_WEIGHT], 800)
    ce_eq("count unchanged", pr[PER_PREF_COUNT], 1)
}

// ---- MIN_CONFIDENCE (post-policy) -----------------------------------------

fn test_min_confidence_refusal_below_threshold() {
    // Force a low-confidence result: no matches -> confidence 0 -> refuse
    // if threshold > 0.
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_MIN_CONFIDENCE, 500)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   0, 0, mo_new(), 100)
    let result = skill_run(sup, "nothing matches this")
    ce_eq("refused (post-policy)", skill_pr_ok(result), 0)
    ce_check("reason present", len(skill_pr_refusal_reason(result)) > 0)
}

fn test_min_confidence_passes_above_threshold() {
    let m = echo_skill_manifest()
    skill_manifest_add_refusal(m, COND_MIN_CONFIDENCE, 500)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg_new(),
                                   0, 0, mo_new(), 100)
    let atoms = list_new() push(atoms, "einstein")
    _wire_test_kg(skill_sup_kg_registry(sup), "history", atoms)
    let result = skill_run(sup, "einstein biography")
    // Match yields belief 800 > threshold 500 -> ok.
    ce_eq("ok", skill_pr_ok(result), 1)
    ce_check("confidence >= 500", skill_pr_confidence(result) >= 500)
}

fn main() {
    test_supervisor_new_shape()
    test_supervisor_retire()
    test_echo_skill_no_kgs_ok_but_zero_matches()
    test_echo_skill_walks_kg_finds_matches()
    test_echo_skill_no_effector_calls_ever()
    test_supervisor_tick_bumps_on_each_run()
    test_supervisor_attributes_atoms_via_meta_observer()
    test_pre_refusal_kg_empty_short_circuits()
    test_pre_refusal_capsule_uninstalled()
    test_pre_refusal_persona_missing()
    test_persona_missing_passes_when_persona_attached()
    test_projection_attached_on_successful_run()
    test_projection_attached_even_on_refusal()
    test_projection_zero_when_no_persona()
    test_persona_history_unchanged_by_skill_run()
    test_persona_prefs_unchanged_by_skill_run()
    test_min_confidence_refusal_below_threshold()
    test_min_confidence_passes_above_threshold()
    ce_summary("skill_supervisor")
}

main()
