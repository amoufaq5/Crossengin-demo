// Unit tests for src/kg/cross_kg_references.nova
// Verifies xref construction, automatic similarity links (with the XREF_AUTO
// threshold), earned promotion after EARN_K co-activations (causal/analogical
// only, with weight floor), lazy weight recompute, and the spawn-on-new-domain
// heuristic. ADR-0017.

import "../ce_test.nova"
import "../../src/kg/cross_kg_references.nova"

fn v4(a, b, c, d) {
    let v = vec_new(ATOM_EMBED_DIMS)
    vec_set(v, 0, a); vec_set(v, 1, b); vec_set(v, 2, c); vec_set(v, 3, d)
    return v
}

fn mk(label, e) {
    let a = atom_new("scratch", 0, ATOM_FACT, label, 0)
    atom_set_embed(a, e)
    return a
}

fn test_auto_link() {
    let a = mk("a", v4(100, 50, 0, 0))
    let b = mk("b", v4(100, 50, 0, 0))   // identical -> cosine 1000 >= 820
    let x = xref_auto_link(a, b)
    ce_check("similar pair links", x != 0)
    ce_eq("auto kind similar", xref_kind(x), XREF_SIMILAR)
    ce_eq("auto not earned", xref_earned(x), 0)
    ce_eq("auto weight is cosine", xref_weight(x), 1000)
    ce_eq("xref recorded on source", len(atom_xrefs(a)), 1)
    // [100,50] vs [50,100] -> cosine 811 < 820 -> no link.
    let c = mk("c", v4(50, 100, 0, 0))
    ce_eq("dissimilar does not link", xref_auto_link(a, c), 0)
    ce_str_eq("kind name", xref_kind_name(XREF_CAUSAL), "causal")
}

fn test_earned_promotion() {
    let a = mk("a", v4(100, 0, 0, 0))
    let b = mk("b", v4(0, 0, 100, 0))
    // A causal link with low weight; promote only after EARN_K co-activations.
    let x = xref_new(a, b, XREF_CAUSAL, 300, 0)
    ce_eq("not earned before K", xref_promote_earned(x), 0)
    let i = 0
    while i < EARN_K { xref_coactivate(x); i = i + 1 }
    ce_eq("coact count", xref_coact(x), EARN_K)
    ce_eq("earned after K", xref_promote_earned(x), 1)
    ce_eq("earned flag set", xref_earned(x), 1)
    ce_eq("weight floored to 0.5", xref_weight(x), EARN_FLOOR)
    // Similarity links never earn, even with co-activations.
    let y = xref_new(a, b, XREF_SIMILAR, 900, 0)
    let j = 0
    while j < EARN_K { xref_coactivate(y); j = j + 1 }
    ce_eq("similar cannot earn", xref_promote_earned(y), 0)
}

fn test_recompute_weight() {
    let a = mk("a", v4(100, 50, 0, 0))
    let b = mk("b", v4(100, 50, 0, 0))
    let x = xref_new(a, b, XREF_SIMILAR, 1000, 0)
    // Make them orthogonal; auto edge weight drops to the new cosine (0).
    atom_set_embed(b, v4(0, 0, 100, 0))
    ce_eq("auto weight decays", xref_recompute_weight(x, a, b), 0)
    // An earned edge is floored on recompute.
    let e = xref_new(a, b, XREF_CAUSAL, 600, 1)
    ce_eq("earned weight floored on recompute", xref_recompute_weight(e, a, b), EARN_FLOOR)
}

fn test_spawn_heuristic() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let m0 = kg_add_atom(med, ATOM_FACT, "m0", 0)
    let m1 = kg_add_atom(med, ATOM_FACT, "m1", 0)
    atom_set_embed(m0, v4(100, 10, 0, 0))
    atom_set_embed(m1, v4(90, 15, 0, 0))

    // Coherent cluster, dissimilar to medicine centroid (different dimensions).
    let new_cluster = list_new()
    push(new_cluster, mk("n0", v4(0, 0, 100, 10)))
    push(new_cluster, mk("n1", v4(0, 0, 90, 15)))
    ce_eq("coherent + dissimilar -> spawn", spawn_should(new_cluster, reg), 1)

    // Coherent cluster, similar to medicine centroid -> no spawn.
    let dup_cluster = list_new()
    push(dup_cluster, mk("d0", v4(100, 10, 0, 0)))
    push(dup_cluster, mk("d1", v4(95, 12, 0, 0)))
    ce_eq("coherent + similar -> no spawn", spawn_should(dup_cluster, reg), 0)

    // Incoherent cluster -> no spawn.
    let incoherent = list_new()
    push(incoherent, mk("i0", v4(100, 0, 0, 0)))
    push(incoherent, mk("i1", v4(0, 100, 0, 0)))
    ce_eq("incoherent -> no spawn", spawn_should(incoherent, reg), 0)

    ce_eq("empty cluster -> no spawn", spawn_should(list_new(), reg), 0)
    ce_check("single atom coherence is 1.0", cluster_coherence(new_cluster) > SPAWN_COHERE)
}

fn main() {
    test_auto_link()
    test_earned_promotion()
    test_recompute_weight()
    test_spawn_heuristic()
    ce_summary("cross_kg_references")
}

main()
