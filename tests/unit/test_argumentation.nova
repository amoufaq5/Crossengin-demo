// Unit tests for src/parts/reasoning/argumentation.nova (Dung grounded
// semantics, ADR-0089 stages 3-4).

import "../ce_test.nova"
import "../../src/parts/reasoning/argumentation.nova"

fn test_single_attack() {
    let af = af_new(2)        // 0=A, 1=B
    af_attack(af, 0, 1)       // A attacks B
    let l = af_grounded(af)
    ce_eq("A in", l[0], ARG_IN)
    ce_eq("B out", l[1], ARG_OUT)
    let ext = af_grounded_extension(af)
    ce_eq("extension {A}", len(ext), 1)
    ce_eq("extension is A", ext[0], 0)
}

fn test_two_cycle() {
    let af = af_new(2)
    af_attack(af, 0, 1)
    af_attack(af, 1, 0)
    let l = af_grounded(af)
    ce_eq("A undec", l[0], ARG_UNDEC)
    ce_eq("B undec", l[1], ARG_UNDEC)
    ce_eq("2-cycle empty extension", len(af_grounded_extension(af)), 0)
}

fn test_chain_reinstatement() {
    let af = af_new(3)        // A -> B -> C
    af_attack(af, 0, 1)
    af_attack(af, 1, 2)
    let l = af_grounded(af)
    ce_eq("A in", l[0], ARG_IN)
    ce_eq("B out", l[1], ARG_OUT)
    ce_eq("C reinstated in", l[2], ARG_IN)
    ce_eq("extension {A,C}", len(af_grounded_extension(af)), 2)
}

fn test_self_attack() {
    let af = af_new(1)
    af_attack(af, 0, 0)
    let l = af_grounded(af)
    ce_eq("self-attacker undecided", l[0], ARG_UNDEC)
}

fn test_unattacked() {
    let af = af_new(2)        // no attacks
    let l = af_grounded(af)
    ce_eq("A in", l[0], ARG_IN)
    ce_eq("B in", l[1], ARG_IN)
    ce_eq("both accepted", len(af_grounded_extension(af)), 2)
}

fn test_defense() {
    // C -> B -> A : C defends A by attacking A's attacker B.
    let af = af_new(3)        // 0=A, 1=B, 2=C
    af_attack(af, 1, 0)       // B attacks A
    af_attack(af, 2, 1)       // C attacks B
    let l = af_grounded(af)
    ce_eq("C in", l[2], ARG_IN)
    ce_eq("B out", l[1], ARG_OUT)
    ce_eq("A reinstated", l[0], ARG_IN)
}

fn test_unreinstated() {
    // A has two attackers: B (defended out by C) and D (accepted). A stays OUT
    // because a surviving attacker (D) remains.
    let af = af_new(4)        // 0=A, 1=B, 2=C, 3=D
    af_attack(af, 1, 0)       // B -> A
    af_attack(af, 2, 1)       // C -> B
    af_attack(af, 3, 0)       // D -> A
    let l = af_grounded(af)
    ce_eq("C in", l[2], ARG_IN)
    ce_eq("B out", l[1], ARG_OUT)
    ce_eq("D in", l[3], ARG_IN)
    ce_eq("A out (D still attacks)", l[0], ARG_OUT)
}

fn test_preferred_two_cycle() {
    // A<->B: grounded is empty (both UNDEC), but there are two coherent positions.
    let af = af_new(2)
    af_attack(af, 0, 1)
    af_attack(af, 1, 0)
    ce_eq("grounded empty", len(af_grounded_extension(af)), 0)
    ce_eq("2-cycle: 2 preferred positions", af_num_positions(af), 2)
    let exts = af_preferred_extensions(af)
    ce_eq("position 0 size 1", len(exts[0]), 1)
    ce_eq("position 1 size 1", len(exts[1]), 1)
}

fn test_preferred_single() {
    let af = af_new(2)
    af_attack(af, 0, 1)        // A -> B
    ce_eq("A->B: 1 position", af_num_positions(af), 1)
    let exts = af_preferred_extensions(af)
    ce_eq("position is {A}", len(exts[0]), 1)
    ce_eq("contains A", exts[0][0], 0)
}

fn test_preferred_unattacked() {
    let af = af_new(2)
    ce_eq("unattacked: 1 position", af_num_positions(af), 1)
    let exts = af_preferred_extensions(af)
    ce_eq("position is {A,B}", len(exts[0]), 2)
}

fn test_preferred_self_attack() {
    let af = af_new(1)
    af_attack(af, 0, 0)
    ce_eq("self-attack: 1 position", af_num_positions(af), 1)
    let exts = af_preferred_extensions(af)
    ce_eq("position is empty", len(exts[0]), 0)
}

fn test_preferred_four_cycle() {
    // A->B->C->D->A: grounded empty; preferred = {A,C} and {B,D}.
    let af = af_new(4)
    af_attack(af, 0, 1)
    af_attack(af, 1, 2)
    af_attack(af, 2, 3)
    af_attack(af, 3, 0)
    ce_eq("grounded empty", len(af_grounded_extension(af)), 0)
    ce_eq("4-cycle: 2 positions", af_num_positions(af), 2)
    let exts = af_preferred_extensions(af)
    ce_eq("position 0 size 2", len(exts[0]), 2)
    ce_eq("position 1 size 2", len(exts[1]), 2)
}

fn main() {
    test_single_attack()
    test_two_cycle()
    test_chain_reinstatement()
    test_self_attack()
    test_unattacked()
    test_defense()
    test_unreinstated()
    test_preferred_two_cycle()
    test_preferred_single()
    test_preferred_unattacked()
    test_preferred_self_attack()
    test_preferred_four_cycle()
    ce_summary("argumentation")
}

main()
