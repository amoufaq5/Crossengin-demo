// Unit tests for src/learning/maintenance.nova: the per-tick scheduler hook
// that fires belief decay (and optionally atom GC) on a cadence. The sweeps
// themselves are covered by test_belief_decay / the death-monitor suites; this
// suite covers the CADENCE policy -- due/not-due, steady interval, first-run
// warm-up, GC opt-in, and that a due decay sweep actually moves a belief.

import "../ce_test.nova"
import "../../src/learning/maintenance.nova"

fn _kg_with_atom() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "demo")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "rumor", 0)
    atom_observe_graded(a, 1) atom_observe_graded(a, 1)
    let b = list_new()
    push(b, reg) push(b, kg) push(b, a)
    return b
}

// Below the interval: no sweep runs.
fn test_not_due_before_interval() {
    let bundle = _kg_with_atom()
    let sched = maint_new(bundle[0], 10, 500)
    let r = maint_on_tick(sched, 5)
    ce_eq("decay not due at tick 5", maint_ran_decay(r), 0)
    ce_eq("gc disabled by default", maint_ran_gc(r), 0)
}

// At/after the interval: the decay sweep fires and moves the belief.
fn test_due_at_interval() {
    let bundle = _kg_with_atom()
    let a = bundle[2]
    let sched = maint_new(bundle[0], 10, 500)
    let before = atom_confidence(a)
    let r = maint_on_tick(sched, 10)
    ce_eq("decay due at tick 10", maint_ran_decay(r), 1)
    ce_check("belief moved", atom_confidence(a) < before)
    // the result carries the sweep stats.
    ce_eq("stats: one decayed", decay_decayed(maint_decay(r)), 1)
}

// After firing, it does not re-fire until another full interval elapses.
fn test_steady_cadence() {
    let bundle = _kg_with_atom()
    let sched = maint_new(bundle[0], 10, 900)
    maint_on_tick(sched, 10)                 // fires
    let r2 = maint_on_tick(sched, 15)        // 5 ticks later -> not due
    ce_eq("not due 5 ticks after firing", maint_ran_decay(r2), 0)
    let r3 = maint_on_tick(sched, 20)        // 10 ticks after the last run
    ce_eq("due again a full interval later", maint_ran_decay(r3), 1)
}

// decay_every = 0 disables belief decay entirely.
fn test_decay_disabled() {
    let bundle = _kg_with_atom()
    let sched = maint_new(bundle[0], 0, 500)
    let r = maint_on_tick(sched, 1000)
    ce_eq("disabled decay never runs", maint_ran_decay(r), 0)
}

// GC opt-in: enabling it makes the GC sweep fire on its own cadence,
// independent of the decay cadence.
fn test_gc_opt_in_independent_cadence() {
    let bundle = _kg_with_atom()
    let sched = maint_new(bundle[0], 10, 900)
    maint_enable_gc(sched, 4)
    // tick 4: GC due, decay not (interval 10).
    let r = maint_on_tick(sched, 4)
    ce_eq("gc due at tick 4", maint_ran_gc(r), 1)
    ce_eq("decay not due at tick 4", maint_ran_decay(r), 0)
    // gc result is a [tombstoned, removed, rescued] triple.
    ce_eq("gc triple length", len(maint_gc(r)), 3)
    // tick 10: decay due, gc not (last gc at 4, 10-4=6 < ... actually 6 >= 4!)
    // 10 - 4 = 6 >= 4 -> gc ALSO due. Both fire.
    let r2 = maint_on_tick(sched, 10)
    ce_eq("decay due at tick 10", maint_ran_decay(r2), 1)
    ce_eq("gc also due at tick 10", maint_ran_gc(r2), 1)
}

// Both sweeps off-cadence on an arbitrary tick: cheap no-op (nothing ran).
fn test_quiet_tick_is_noop() {
    let bundle = _kg_with_atom()
    let sched = maint_new(bundle[0], 100, 500)
    maint_enable_gc(sched, 50)
    let r = maint_on_tick(sched, 7)
    ce_eq("no decay on quiet tick", maint_ran_decay(r), 0)
    ce_eq("no gc on quiet tick", maint_ran_gc(r), 0)
}

// The registry-explicit hook sweeps a DIFFERENT registry than the scheduler's
// default -- the path the chat loop uses across /switch (cadence state stays in
// the scheduler; the active session's registry is supplied per call).
fn test_reg_explicit_hook() {
    let home = _kg_with_atom()
    let other = _kg_with_atom()
    let a_other = other[2]
    // Scheduler built over `home`, but we sweep `other` explicitly.
    let sched = maint_new(home[0], 10, 500)
    let before = atom_confidence(a_other)
    let r = maint_on_tick_reg(sched, other[0], 10)
    ce_eq("explicit-reg decay due", maint_ran_decay(r), 1)
    ce_check("explicit reg's atom decayed", atom_confidence(a_other) < before)
    // cadence state advanced on the shared scheduler.
    let r2 = maint_on_tick_reg(sched, other[0], 12)
    ce_eq("not due again right after", maint_ran_decay(r2), 0)
}

fn main() {
    test_not_due_before_interval()
    test_due_at_interval()
    test_steady_cadence()
    test_decay_disabled()
    test_gc_opt_in_independent_cadence()
    test_quiet_tick_is_noop()
    test_reg_explicit_hook()
    ce_summary("maintenance")
}

main()
