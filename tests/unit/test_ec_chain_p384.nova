// CE_TEST_TIMEOUT: 240
// PR 4c: a real P-384 / P-256 chain built with openssl 3:
//   CE-P384-Root (P-384, self-signed ecdsa-with-SHA384, CA)
//     -> CE-P256-Int (P-256 CA, signed ecdsa-with-SHA384)
//          -> p256leaf.example (P-256, signed ecdsa-with-SHA384: SHA-384
//             truncated to 256 bits for the P-256 issuer key)
//     -> p384leaf.example (P-384, signed ecdsa-with-SHA384)
//     -> CE-P256-Int-Renamed (same key as CE-P256-Int, different subject)
// plus TLS 1.3 CertificateVerify ecdsa_secp384r1_sha384 (0x0503) and the
// curve/scheme binding (0x0403 needs a P-256 leaf, 0x0503 a P-384 leaf),
// and strict DER / length handling for the signature bytes.

import "../ce_test.nova"
import "../../src/safety/x509_verify.nova"
import "../../src/safety/pem_truststore.nova"
import "../../src/io/transducers/tls13_client.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

let ROOT = ""
let INT = ""
let LEAF = ""
let INT_RENAMED = ""
let L384 = ""
let ROOT_PEM = "-----BEGIN CERTIFICATE-----\nMIIB0DCCAVagAwIBAgIUTBYZjqy/TYxgf/1p6o4UcoKL4jswCgYIKoZIzj0EAwMw\nFzEVMBMGA1UEAwwMQ0UtUDM4NC1Sb290MB4XDTI2MTExNjA2MjA1N1oXDTM2MTEx\nMzA2MjA1N1owFzEVMBMGA1UEAwwMQ0UtUDM4NC1Sb290MHYwEAYHKoZIzj0CAQYF\nK4EEACIDYgAErKR/r2jWcLuVxA8ews8X+OoaYiqAo+0jDs6ogOYe5oGCAlIO5isR\nwY/JUSieabLLP7TvJPg87N5TBPNsdVGqeaHdWNX4c4TlFPpRnwNcQHHpzEnUHjlI\nf/gceqEY16CSo2MwYTAdBgNVHQ4EFgQUA8rwTEHNs5Iih5OQwR5QhC8JDVkwHwYD\nVR0jBBgwFoAUA8rwTEHNs5Iih5OQwR5QhC8JDVkwDwYDVR0TAQH/BAUwAwEB/zAO\nBgNVHQ8BAf8EBAMCAQYwCgYIKoZIzj0EAwMDaAAwZQIxAIQsmiM/ZCaqFNRZF4Bj\nexl42w94gkKXwa56vbTRA/HzkHUVpE3l2B+YOY/UgktnkAIwcLRUO6Huaqp4yQKk\n27wWQX1lBGdZuOd8xFt/wJaDpFjrtBfNxiwhSL5MxHeCEoyA\n-----END CERTIFICATE-----\n"
let CV384 = "306502310089dfd5b3a40c6b4bedc8d5c722c4ff38930c5a563774925347143945397613d73825b1315d1c64f53d9cb6423d8455270230160cfe97643b7023fc1c3ebcd847234740ed8cab03e506d601a222d035ed094c0b7ed370f8782b4f6daa1dfaa83d45b1"
let CV256 = "304502210097fb5c34fb9352e7c510899d8a566983699c0c46568a3c41a0bc19046dfc3f59022019c45fefabf167f82357958d7a9f35186bf7501e52d2435a60220417bf7eefbe"
let NOW = 1800000000

fn _t_hv(c) {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn _t_hexbuf(h) {
    let n = int_shr(len(h), 1)
    let b = alloc(n + 1)
    let i = 0
    while i < n {
        store8(b + i, _t_hv(char_at(h, int_mul(i, 2))) * 16 + _t_hv(char_at(h, int_mul(i, 2) + 1)))
        i = i + 1
    }
    store8(b + n, 0)
    return b
}

fn _t_der(h) {
    let p = list_new()
    push(p, _t_hexbuf(h)) push(p, int_shr(len(h), 1))
    return p
}

fn _t_cert(h) { return cert_parse(_t_hexbuf(h), int_shr(len(h), 1)) }

fn _cv_msg(alg, sighex) {
    let sn = int_shr(len(sighex), 1)
    let body = 4 + sn
    let m = alloc(4 + body + 1)
    store8(m, 15)
    store8(m + 1, 0) store8(m + 2, int_shr(body, 8)) store8(m + 3, int_and(body, 255))
    store8(m + 4, int_shr(alg, 8)) store8(m + 5, int_and(alg, 255))
    store8(m + 6, int_shr(sn, 8)) store8(m + 7, int_and(sn, 255))
    let s = _t_hexbuf(sighex)
    let i = 0
    while i < sn { store8(m + 8 + i, load8(s + i)) i = i + 1 }
    return m
}

fn _th() {
    let t = alloc(33)
    let i = 0
    while i < 32 { store8(t + i, i + 1) i = i + 1 }
    return t
}

fn test_parse() {
    let root = _t_cert(ROOT)
    ce_eq("root parses", cert_ok(root), 1)
    ce_eq("root is P-384", cert_ec_point_n(root), 97)
    ce_eq("root signed ecdsa-with-SHA384", cert_sig_type(root), SIG_ECDSA_SHA384)
    ce_eq("root self-signature verifies", cert_verify_under(root, root), 1)
    let inter = _t_cert(INT)
    ce_eq("P-256 intermediate under the P-384 root", cert_verify_under(inter, root), 1)
    let leaf = _t_cert(LEAF)
    ce_eq("P-256 leaf (SHA-384 truncated) under the P-256 intermediate", cert_verify_under(leaf, inter), 1)
    ce_eq("leaf not verified by the root directly", cert_verify_under(leaf, root), 0)
}

fn test_chains() {
    let anchors = truststore_load(ROOT_PEM)
    ce_eq("PEM root loads as one anchor", len(anchors), 1)
    let c1 = list_new() push(c1, _t_der(LEAF)) push(c1, _t_der(INT)) push(c1, _t_der(ROOT))
    ce_eq("leaf -> P-256 int -> P-384 root verifies", cert_chain_verify(c1, "p256leaf.example", anchors, NOW)[0], XV_OK)
    ce_check("wrong host fails", cert_chain_verify(c1, "other.example", anchors, NOW)[0] != XV_OK)
    let c2 = list_new() push(c2, _t_der(L384)) push(c2, _t_der(ROOT))
    ce_eq("P-384 leaf -> P-384 root verifies", cert_chain_verify(c2, "p384leaf.example", anchors, NOW)[0], XV_OK)
    let c3 = list_new() push(c3, _t_der(LEAF)) push(c3, _t_der(ROOT))
    ce_check("leaf without its intermediate fails", cert_chain_verify(c3, "p256leaf.example", anchors, NOW)[0] != XV_OK)
    // PR 4d: servers normally omit the root; the top cert is then ISSUED BY
    // an anchor (issuer Name == root subject, signature under the root key).
    let c4 = list_new() push(c4, _t_der(LEAF)) push(c4, _t_der(INT))
    ce_eq("root omitted: issued-by-anchor path verifies", cert_chain_verify(c4, "p256leaf.example", anchors, NOW)[0], XV_OK)
    let c5 = list_new() push(c5, _t_der(L384))
    ce_eq("P-384 leaf alone under its root verifies", cert_chain_verify(c5, "p384leaf.example", anchors, NOW)[0], XV_OK)
    // Key-only anchors (no cert record) cannot do issued-by matching.
    let keyonly = list_new()
    let ka = list_new() push(ka, KEY_EC) push(ka, anchors[0][1]) push(ka, anchors[0][2])
    push(keyonly, ka)
    ce_eq("key-only anchor + omitted root: not pinned", cert_chain_verify(c4, "p256leaf.example", keyonly, NOW)[0], XV_NOT_PINNED)
    // The anchor must be valid at `now`.
    ce_eq("expired anchor refused", cert_chain_verify(c4, "p256leaf.example", anchors, 4000000000)[0], XV_NOT_PINNED)
    // Names must chain: INT_RENAMED is a CA with the SAME key as INT but the
    // subject CN=CE-P256-Int-Renamed, so the leaf's signature verifies under
    // it and only the issuer/subject comparison can refuse the path.
    let c6 = list_new() push(c6, _t_der(LEAF)) push(c6, _t_der(INT_RENAMED)) push(c6, _t_der(ROOT))
    ce_eq("issuer/subject mismatch refused", cert_chain_verify(c6, "p256leaf.example", anchors, NOW)[0], XV_NAME_CHAIN)
}

fn test_certverify() {
    let l384 = _t_cert(L384)
    let l256 = _t_cert(LEAF)
    ce_eq("0x0503 by a P-384 leaf", _tls_verify_certverify(_cv_msg(1283, CV384), 0, _th(), l384), 1)
    ce_eq("0x0403 by a P-256 leaf", _tls_verify_certverify(_cv_msg(1027, CV256), 0, _th(), l256), 1)
    ce_eq("0x0403 claimed for a P-384 leaf fails", _tls_verify_certverify(_cv_msg(1027, CV384), 0, _th(), l384), 0)
    ce_eq("0x0503 claimed for a P-256 leaf fails", _tls_verify_certverify(_cv_msg(1283, CV256), 0, _th(), l256), 0)
    ce_eq("P-384 signature under another key fails", _tls_verify_certverify(_cv_msg(1283, CV384), 0, _th(), _t_cert(ROOT)), 0)
}

// Review follow-ups: a DER long-form length with > 4 length bytes used to
// wrap to a negative offset and segfault; non-canonical ECDSA DER was
// accepted (malleable); a CertificateVerify with trailing bytes was
// accepted. All variants of a valid signature below must be refused.
fn test_strict_der() {
    let crash = _t_hexbuf("30100288ffffff0000000000020101000000")
    let pub = cert_ec_point(_t_cert(L384))
    let d = alloc(49)
    ce_eq("5-byte long-form length: refused, no crash", ecdsa_verify_any(pub, 97, d, 48, crash, 16), 0)
    ce_eq("same via 0x0503", _tls_verify_certverify(_cv_msg(1283, "30100288ffffff0000000000020101000000"), 0, _th(), _t_cert(L384)), 0)
    ce_eq("control: the canonical signature verifies", _tls_verify_certverify(_cv_msg(1283, CV384), 0, _th(), _t_cert(L384)), 1)
    ce_eq("strict DER: trailing byte after SEQUENCE", _tls_verify_certverify(_cv_msg(1283, "306502310089dfd5b3a40c6b4bedc8d5c722c4ff38930c5a563774925347143945397613d73825b1315d1c64f53d9cb6423d8455270230160cfe97643b7023fc1c3ebcd847234740ed8cab03e506d601a222d035ed094c0b7ed370f8782b4f6daa1dfaa83d45b100"), 0, _th(), _t_cert(L384)), 0)
    ce_eq("strict DER: needless 00 pad on r", _tls_verify_certverify(_cv_msg(1283, "30660232000089dfd5b3a40c6b4bedc8d5c722c4ff38930c5a563774925347143945397613d73825b1315d1c64f53d9cb6423d8455270230160cfe97643b7023fc1c3ebcd847234740ed8cab03e506d601a222d035ed094c0b7ed370f8782b4f6daa1dfaa83d45b1"), 0, _th(), _t_cert(L384)), 0)
    ce_eq("strict DER: long-form SEQUENCE length", _tls_verify_certverify(_cv_msg(1283, "30816502310089dfd5b3a40c6b4bedc8d5c722c4ff38930c5a563774925347143945397613d73825b1315d1c64f53d9cb6423d8455270230160cfe97643b7023fc1c3ebcd847234740ed8cab03e506d601a222d035ed094c0b7ed370f8782b4f6daa1dfaa83d45b1"), 0, _th(), _t_cert(L384)), 0)
    ce_eq("strict DER: junk INTEGER inside SEQUENCE", _tls_verify_certverify(_cv_msg(1283, "306802310089dfd5b3a40c6b4bedc8d5c722c4ff38930c5a563774925347143945397613d73825b1315d1c64f53d9cb6423d8455270230160cfe97643b7023fc1c3ebcd847234740ed8cab03e506d601a222d035ed094c0b7ed370f8782b4f6daa1dfaa83d45b1020101"), 0, _th(), _t_cert(L384)), 0)
    ce_eq("strict DER: negative r (pad removed)", _tls_verify_certverify(_cv_msg(1283, "3064023089dfd5b3a40c6b4bedc8d5c722c4ff38930c5a563774925347143945397613d73825b1315d1c64f53d9cb6423d8455270230160cfe97643b7023fc1c3ebcd847234740ed8cab03e506d601a222d035ed094c0b7ed370f8782b4f6daa1dfaa83d45b1"), 0, _th(), _t_cert(L384)), 0)
    let m = _cv_msg(1283, CV384)
    let body = load8(m + 2) * 256 + load8(m + 3)
    let longer = alloc(4 + body + 4)
    let i = 0
    while i < 4 + body { store8(longer + i, load8(m + i)) i = i + 1 }
    store8(longer + 2, int_shr(body + 3, 8)) store8(longer + 3, int_and(body + 3, 255))
    ce_eq("CertificateVerify with trailing bytes refused", _tls_verify_certverify(longer, 0, _th(), _t_cert(L384)), 0)
}

fn main() {
    test_parse()
    test_chains()
    test_certverify()
    test_strict_der()
    ce_summary("ec_chain_p384")
}

main()
