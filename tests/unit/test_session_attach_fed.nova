// Unit tests for session_attach_fed + the five federation getters
// (ADR-0111 close-out / Phase M R6).
//
// Coverage:
//   test_session_default_has_no_fed_slots   -- `session_make(...)` leaves
//                                              the fed slots at 0 (0 is
//                                              the "not attached" sentinel
//                                              the hook call site gates on).
//   test_session_attach_fed_sets_all_slots  -- attach writes all five slots
//                                              exactly as given (small-int
//                                              placeholders are fine; the
//                                              Session module never reads
//                                              past the top-level slot).
//   test_session_attach_fed_grows_lazily    -- a MANUALLY-BUILT 16-slot
//                                              list (simulating a pre-R6
//                                              Session built outside
//                                              session_make, e.g. a legacy
//                                              harness) grows cleanly to 21
//                                              slots after attach_fed.
//
// The daemon-shaped behavioral test for the hook-via-session-accessors
// composition lives alongside the other hook subtests in
// `tests/unit/test_snapshot_broadcast_hook.nova`.
//
// CrossEngin dependencies: src/session/session.nova, src/util/str_safe.nova.

import "../ce_test.nova"
import "../../src/session/session.nova"
import "../../src/util/str_safe.nova"

// Build a baseline session with opaque stand-ins for every pre-R6 slot.
// Values are integers / lists; Session never interprets the content.
fn _af_make_baseline(id) {
    return session_make(id, "T", 1000,
        1,                    // sl
        2,                    // kgreg
        3,                    // kg
        4,                    // lang
        5,                    // ikg
        6,                    // refl_kg
        list_new(),           // ctx
        list_new(),           // log
        list_new(),           // engine
        list_new(),           // mo
        list_new())           // hs
}

// Subtest 1: a freshly-constructed Session returns 0 from every fed
// getter. This is the invariant the hook call site relies on for byte-
// identity when `CE_FED_AUTO_BROADCAST_ON_SAVE` is unset.
fn test_session_default_has_no_fed_slots() {
    let s = _af_make_baseline("fed-default")
    ce_eq("session_gs returns 0 pre-attach",            session_gs(s), 0)
    ce_eq("session_att_store returns 0 pre-attach",     session_att_store(s), 0)
    ce_eq("session_signer_seed returns 0 pre-attach",   session_signer_seed(s), 0)
    ce_eq("session_signer_pk returns 0 pre-attach",     session_signer_pk(s), 0)
    ce_eq("session_soul_id_int returns 0 pre-attach",   session_soul_id_int(s), 0)
    // The constructor pushes placeholder zeros for the five tail slots
    // so freshly-built sessions already have SES_COUNT=21 slots. The
    // defensive `if len(s) <= SLOT { return 0 }` guards in the getters
    // handle the pre-R6-SHAPED case covered by subtest 3 below.
    ce_eq("session_make returns a SES_COUNT-slot list", len(s), SES_COUNT)
}

// Subtest 2: attach_fed sets each slot exactly to the passed value.
// Uses small-int placeholders so we don't drag in gossip_init /
// att_store_new / merkle_signing here; the behavioral composition that
// does use real primitives lives in test_snapshot_broadcast_hook.
fn test_session_attach_fed_sets_all_slots() {
    let s = _af_make_baseline("fed-set-all")
    let rc = session_attach_fed(s, 11, 22, 33, 44, 55)
    ce_eq("session_attach_fed returns 1",           rc, 1)
    ce_eq("session_gs after attach",                session_gs(s), 11)
    ce_eq("session_att_store after attach",         session_att_store(s), 22)
    ce_eq("session_signer_seed after attach",       session_signer_seed(s), 33)
    ce_eq("session_signer_pk after attach",         session_signer_pk(s), 44)
    ce_eq("session_soul_id_int after attach",       session_soul_id_int(s), 55)
    // Attach is idempotent: a second call overwrites.
    session_attach_fed(s, 111, 222, 333, 444, 555)
    ce_eq("session_gs after re-attach",             session_gs(s), 111)
    ce_eq("session_att_store after re-attach",      session_att_store(s), 222)
    ce_eq("session_signer_seed after re-attach",    session_signer_seed(s), 333)
    ce_eq("session_signer_pk after re-attach",      session_signer_pk(s), 444)
    ce_eq("session_soul_id_int after re-attach",    session_soul_id_int(s), 555)
}

// Subtest 3: a MANUALLY-BUILT pre-R6 shaped list (16 slots, no fed
// tail-pad) grows to SES_COUNT=21 cleanly after attach_fed. This covers
// the lazy-grow path in `while len(s) <= SES_SOUL_ID_INT { push(s, 0) }`
// for callers that constructed a Session outside session_make (e.g. a
// legacy test harness, a migration shim, or a sreg_lookup result from
// an older on-disk registry format).
fn test_session_attach_fed_grows_lazily() {
    let s = list_new()
    // 16 zero slots == pre-R6 struct size (SES_ID .. SES_DP inclusive).
    let i = 0
    while i < 16 {
        push(s, 0)
        i = i + 1
    }
    ce_eq("pre-R6-shaped session starts at 16 slots", len(s), 16)
    // Before attach, every fed getter returns 0 via the defensive guard.
    ce_eq("pre-R6 session_gs returns 0",             session_gs(s), 0)
    ce_eq("pre-R6 session_att_store returns 0",      session_att_store(s), 0)
    ce_eq("pre-R6 session_signer_seed returns 0",    session_signer_seed(s), 0)
    ce_eq("pre-R6 session_signer_pk returns 0",      session_signer_pk(s), 0)
    ce_eq("pre-R6 session_soul_id_int returns 0",    session_soul_id_int(s), 0)
    // Attach grows the list to SES_COUNT and populates every slot.
    session_attach_fed(s, 7, 8, 9, 10, 12)
    ce_eq("after attach, len == SES_COUNT",          len(s), SES_COUNT)
    ce_eq("grown session_gs matches",                session_gs(s), 7)
    ce_eq("grown session_att_store matches",         session_att_store(s), 8)
    ce_eq("grown session_signer_seed matches",       session_signer_seed(s), 9)
    ce_eq("grown session_signer_pk matches",         session_signer_pk(s), 10)
    ce_eq("grown session_soul_id_int matches",       session_soul_id_int(s), 12)
}

fn main() {
    test_session_default_has_no_fed_slots()
    test_session_attach_fed_sets_all_slots()
    test_session_attach_fed_grows_lazily()
    ce_summary("test_session_attach_fed")
}

main()
