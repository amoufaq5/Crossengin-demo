// Unit tests for Phase P R1 (ADR-0097): DTLS 1.2 server-side handshake
// flight. Covers:
//
//   * `_dtls_parse_client_hello_body` round-trips against the R2 builder
//     `_dtls_build_client_hello_body`.
//   * ClientHello parser rejects the four documented malformed shapes:
//     missing null-compression method, missing 0xC02B in the suites list,
//     truncated length prefixes, and short body.
//   * `_dtls_build_server_hello_body` produces the RFC 5246 §7.4.1.3
//     bytes deterministically for a pinned server_random; the SRTP-offer
//     variant appends the 9-byte `use_srtp` extension per RFC 5764
//     §4.1.1.
//   * `_dtls_build_certificate_body` prefixes 3-byte lengths per RFC 5246
//     §7.4.2 for one- and two-cert chains.
//   * `_dtls_build_ske_body` embeds curve/point/sig; the signature
//     verifies with `ecdsa_p256_verify_bn`.
//   * `_dtls_build_server_hello_done_body` returns an empty body per
//     RFC 5246 §7.4.5.
//   * Transcript accumulator: absorb ClientHello + ServerHello ->
//     finalize matches `sha256_oneshot(ClientHello || ServerHello)`.
//   * State-machine edges: the 5 new server-side transitions accept;
//     the reverse edges reject.
//   * `_gds_server_flight_1` end-to-end: mocked ClientHello record ->
//     emits ServerHello + Cert + SKE + SHD; state ends at SHD_SENT.
//     Malformed ClientHello -> state ends at FAILED.
//
// Runtime caveat: NOVA's compiler self-hosting bootstrap segfaults on
// this bench (standing Phase L/M/N/O/P caveat), so `make test` cannot
// exercise these; verification is structural review + `make lint-ints`
// per the plan file (`/root/.claude/plans/gentle-toasting-zephyr.md`
// §"Verification").

import "../ce_test.nova"
import "../../src/federation/dtls12.nova"
import "../../src/federation/gossip_dtls_shim.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/p256.nova"
import "../../src/safety/p256_keypair.nova"
import "../../src/safety/ecdsa.nova"
import "std/syscall"
import "std/string"
import "std/io"

// ---- helpers -------------------------------------------------------------

fn _mk_ramp32(start) {
    let buf = alloc(33)
    let i = 0
    while i < 32 {
        store8(buf + i, int_and(start + i, 255))
        i = i + 1
    }
    store8(buf + 32, 0)
    return buf
}

// Build a fixed-seed keypair for reproducible SKE signature tests. Uses
// the p256_keypair_generate_deterministic entry from Phase O R3.
fn _fixed_ecdsa_keypair() {
    let seed = _mk_ramp32(77)
    return p256_keypair_generate_deterministic(seed)
}

// ---- ClientHello parser: round-trip against R2 builder -----------------

fn test_ch_parser_roundtrip_noext() {
    // A fresh dtls state with no SRTP offer means the R2 builder
    // emits the pre-R2 42-byte body shape.
    let st = dtls_init()
    let pair = _dtls_build_client_hello_body(st)
    let buf = pair[0]
    let n = pair[1]
    ce_eq("no-ext CH body is 42 bytes", n, 42)
    let parsed = _dtls_parse_client_hello_body(buf, n)
    ce_eq("parser accepts no-ext CH", parsed[0], 1)
    ce_eq("parser recovers DTLS 1.2 version word", parsed[1], DTLS_VERSION_WORD)
    let suites = parsed[5]
    ce_eq("suites list has one entry", len(suites), 1)
    ce_eq("suite is 0xC02B", suites[0],
          DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256)
    let compr = parsed[6]
    ce_eq("compr list has one entry", len(compr), 1)
    ce_eq("compr is null (0)", compr[0], 0)
    // No extensions bytes remain.
    ce_check("no-ext CH: ext pair is 0", parsed[7] == 0)
}

fn test_ch_parser_roundtrip_with_srtp() {
    let st = dtls_init()
    dtls_offer_srtp(st, SRTP_PROFILE_AES128_CM_SHA1_80)
    let pair = _dtls_build_client_hello_body(st)
    let buf = pair[0]
    let n = pair[1]
    // 42 base + 2 ext_block_len + 9 use_srtp = 53
    ce_eq("with-srtp CH body is 53 bytes", n, 53)
    let parsed = _dtls_parse_client_hello_body(buf, n)
    ce_eq("parser accepts with-srtp CH", parsed[0], 1)
    let ext_pair = parsed[7]
    ce_check("with-srtp CH: ext pair is non-zero", ext_pair != 0)
    ce_eq("with-srtp CH: ext block len is 9", ext_pair[1], 9)
}

fn test_ch_parser_rejects_missing_null_compression() {
    // Hand-craft a body with one non-null compression method.
    let n = 42
    let buf = alloc(n + 1)
    _dtls_put_u16(buf, 0, DTLS_VERSION_WORD)
    let i = 0
    while i < 32 { store8(buf + 2 + i, 0); i = i + 1 }
    _dtls_put_u8(buf, 34, 0)           // sid_len
    _dtls_put_u8(buf, 35, 0)           // cookie_len
    _dtls_put_u16(buf, 36, 2)          // suites_bytes
    _dtls_put_u16(buf, 38, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256)
    _dtls_put_u8(buf, 40, 1)           // compr_len
    _dtls_put_u8(buf, 41, 255)         // non-null compression method
    store8(buf + n, 0)
    let parsed = _dtls_parse_client_hello_body(buf, n)
    ce_eq("null-compr missing rejected", parsed[0], 0)
}

fn test_ch_parser_rejects_wrong_suite() {
    let n = 42
    let buf = alloc(n + 1)
    _dtls_put_u16(buf, 0, DTLS_VERSION_WORD)
    let i = 0
    while i < 32 { store8(buf + 2 + i, 0); i = i + 1 }
    _dtls_put_u8(buf, 34, 0)
    _dtls_put_u8(buf, 35, 0)
    _dtls_put_u16(buf, 36, 2)
    _dtls_put_u16(buf, 38, 123)        // wrong suite
    _dtls_put_u8(buf, 40, 1)
    _dtls_put_u8(buf, 41, 0)
    store8(buf + n, 0)
    let parsed = _dtls_parse_client_hello_body(buf, n)
    ce_eq("wrong-suite rejected", parsed[0], 0)
}

fn test_ch_parser_rejects_short_body() {
    let n = 10
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 0); i = i + 1 }
    store8(buf + n, 0)
    let parsed = _dtls_parse_client_hello_body(buf, n)
    ce_eq("short body rejected", parsed[0], 0)
}

fn test_ch_parser_rejects_bad_suites_len() {
    // suites_bytes says 100 but only 42 in the buffer.
    let n = 42
    let buf = alloc(n + 1)
    _dtls_put_u16(buf, 0, DTLS_VERSION_WORD)
    let i = 0
    while i < 32 { store8(buf + 2 + i, 0); i = i + 1 }
    _dtls_put_u8(buf, 34, 0)
    _dtls_put_u8(buf, 35, 0)
    _dtls_put_u16(buf, 36, 100)        // overflows
    _dtls_put_u16(buf, 38, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256)
    _dtls_put_u8(buf, 40, 1)
    _dtls_put_u8(buf, 41, 0)
    store8(buf + n, 0)
    let parsed = _dtls_parse_client_hello_body(buf, n)
    ce_eq("bad suites_bytes rejected", parsed[0], 0)
}

// ---- ext-block stub parser ------------------------------------------------

fn test_ext_block_stub_empty() {
    let buf = alloc(1)
    store8(buf, 0)
    let r = _dtls_parse_ext_block_stub(buf, 0)
    ce_eq("empty ext block accepted", r[0], 1)
    ce_eq("empty ext block len 0", r[1], 0)
}

fn test_ext_block_stub_valid() {
    let buf = alloc(6)
    _dtls_put_u16(buf, 0, 3)
    store8(buf + 2, 1); store8(buf + 3, 2); store8(buf + 4, 3)
    store8(buf + 5, 0)
    let r = _dtls_parse_ext_block_stub(buf, 5)
    ce_eq("valid ext block accepted", r[0], 1)
    ce_eq("ext block len 3", r[1], 3)
}

fn test_ext_block_stub_short() {
    let buf = alloc(2)
    _dtls_put_u16(buf, 0, 100)
    let r = _dtls_parse_ext_block_stub(buf, 2)
    ce_eq("short ext block rejected", r[0], 0)
}

// ---- ServerHello body builder --------------------------------------------

fn test_sh_body_shape_no_ext() {
    let st = dtls_init()
    let sr = _mk_ramp32(200)
    let pair = _dtls_build_server_hello_body(
        st, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256, sr)
    let buf = pair[0]
    let n = pair[1]
    ce_eq("no-ext SH body is 38 bytes", n, 38)
    ce_eq("version hi byte", load8(buf + 0), 254)
    ce_eq("version lo byte", load8(buf + 1), 253)
    // server_random preserved byte-for-byte.
    ce_eq("SH random[0]", load8(buf + 2), 200)
    ce_eq("SH random[31]", load8(buf + 33), int_and(200 + 31, 255))
    ce_eq("SH sid_len byte", load8(buf + 34), 0)
    ce_eq("SH suite hi", load8(buf + 35), 192)
    ce_eq("SH suite lo", load8(buf + 36), 43)
    ce_eq("SH compr byte", load8(buf + 37), 0)
}

fn test_sh_body_with_srtp_ext() {
    let st = dtls_init()
    dtls_offer_srtp(st, SRTP_PROFILE_AES128_CM_SHA1_80)
    let sr = _mk_ramp32(50)
    let pair = _dtls_build_server_hello_body(
        st, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256, sr)
    let n = pair[1]
    ce_eq("with-srtp SH body is 49 bytes", n, 38 + 2 + 9)
    let buf = pair[0]
    ce_eq("ext block len hi", load8(buf + 38), 0)
    ce_eq("ext block len lo", load8(buf + 39), 9)
    ce_eq("use_srtp ext_type hi", load8(buf + 40), 0)
    ce_eq("use_srtp ext_type lo", load8(buf + 41), 14)
}

// ---- Certificate body builder --------------------------------------------

fn test_cert_body_one_cert() {
    let st = dtls_init()
    // Fake 100-byte cert.
    let cert = alloc(101)
    let i = 0
    while i < 100 { store8(cert + i, int_and(i, 255)); i = i + 1 }
    store8(cert + 100, 0)
    let entry = list_new()
    push(entry, cert)
    push(entry, 100)
    let chain = list_new()
    push(chain, entry)
    let pair = _dtls_build_certificate_body(st, chain)
    let n = pair[1]
    ce_eq("one-cert body is 3 + 3 + 100 = 106", n, 106)
    let buf = pair[0]
    // 3B total inner length = 3 + 100 = 103.
    ce_eq("total_len hi", load8(buf + 0), 0)
    ce_eq("total_len mid", load8(buf + 1), 0)
    ce_eq("total_len lo", load8(buf + 2), 103)
    // Per-cert 3B length = 100.
    ce_eq("cert_len hi", load8(buf + 3), 0)
    ce_eq("cert_len mid", load8(buf + 4), 0)
    ce_eq("cert_len lo", load8(buf + 5), 100)
    // First cert byte.
    ce_eq("cert byte 0", load8(buf + 6), 0)
    ce_eq("cert byte 42", load8(buf + 6 + 42), 42)
}

fn test_cert_body_two_certs() {
    let st = dtls_init()
    let a = alloc(11)
    let b = alloc(21)
    let i = 0
    while i < 10 { store8(a + i, i); i = i + 1 }
    let j = 0
    while j < 20 { store8(b + j, 100 + j); j = j + 1 }
    store8(a + 10, 0); store8(b + 20, 0)
    let e1 = list_new()
    push(e1, a); push(e1, 10)
    let e2 = list_new()
    push(e2, b); push(e2, 20)
    let chain = list_new()
    push(chain, e1); push(chain, e2)
    let pair = _dtls_build_certificate_body(st, chain)
    let n = pair[1]
    // 3 header + (3 + 10) + (3 + 20) = 39
    ce_eq("two-cert body is 39 bytes", n, 39)
    let buf = pair[0]
    // total inner = 36 = 0x24
    ce_eq("total_len lo", load8(buf + 2), 36)
    // first cert len = 10
    ce_eq("cert1_len lo", load8(buf + 5), 10)
    // second cert 3B length starts at 3 + 3 + 10 = 16
    ce_eq("cert2_len lo", load8(buf + 18), 20)
}

// ---- ServerKeyExchange body ----------------------------------------------

fn test_ske_body_shape_and_sig_verifies() {
    let st = dtls_init()
    // Populate client_random + server_random.
    st[DTLS_S_SLOT_CLIENT_RANDOM] = _mk_ramp32(1)
    st[DTLS_S_SLOT_SERVER_RANDOM] = _mk_ramp32(101)
    let kp = _fixed_ecdsa_keypair()
    if kp == 0 {
        ce_check("keypair generator returned non-zero", 0 == 0)
        return 0
    }
    let priv_bn = kp[0]
    // Uncompressed pub_point = 0x04 || X || Y (65 bytes).
    let pub_point = p256_encode_uncompressed(kp[1][0], kp[1][1])
    let pair = _dtls_build_ske_body(st, 23, pub_point, priv_bn)
    ce_check("SKE body built", pair != 0)
    if pair == 0 { return 0 }
    let buf = pair[0]
    let n = pair[1]
    // First 4 bytes: curve_type=3, curve_id=0x0017, point_len=65.
    ce_eq("SKE curve_type", load8(buf + 0), 3)
    ce_eq("SKE curve_id hi", load8(buf + 1), 0)
    ce_eq("SKE curve_id lo", load8(buf + 2), 23)
    ce_eq("SKE point_len", load8(buf + 3), 65)
    // Points bytes 4..69, then sig_alg 0x0403, then sig_len (2B), then DER.
    ce_eq("SKE sig_alg hi", load8(buf + 4 + 65), 4)
    ce_eq("SKE sig_alg lo", load8(buf + 4 + 65 + 1), 3)
}

// ---- ServerHelloDone body --------------------------------------------------

fn test_shd_body_empty() {
    let pair = _dtls_build_server_hello_done_body()
    ce_eq("SHD body length is 0", pair[1], 0)
    ce_check("SHD buf is non-null", pair[0] != 0)
}

// ---- Transcript accumulator -----------------------------------------------

fn test_transcript_init_then_absorb() {
    let st = dtls_init()
    ce_check("pre-init: no ctx", st[DTLS_S_SLOT_TRANSCRIPT_CTX] == 0)
    dtls_transcript_init(st)
    ce_check("post-init: ctx allocated", st[DTLS_S_SLOT_TRANSCRIPT_CTX] != 0)
    ce_eq("post-init: transcript_n = 0", dtls_transcript_len(st), 0)
    let msg = alloc(11)
    let i = 0
    while i < 10 { store8(msg + i, i); i = i + 1 }
    store8(msg + 10, 0)
    dtls_transcript_absorb(st, msg, 10)
    ce_eq("post-absorb: transcript_n = 10", dtls_transcript_len(st), 10)
}

fn test_transcript_matches_oneshot_two_messages() {
    // Absorb two messages; finalized digest must equal
    // sha256_oneshot over the concatenation.
    let st = dtls_init()
    dtls_transcript_init(st)
    let a = alloc(21)
    let i = 0
    while i < 20 { store8(a + i, i); i = i + 1 }
    store8(a + 20, 0)
    let b = alloc(41)
    let j = 0
    while j < 40 { store8(b + j, 100 + j); j = j + 1 }
    store8(b + 40, 0)
    dtls_transcript_absorb(st, a, 20)
    dtls_transcript_absorb(st, b, 40)
    let got = dtls_transcript_finalize(st)
    // Rebuild expected by hashing a || b through sha256_oneshot.
    let joined = alloc(61)
    let m = 0
    while m < 20 { store8(joined + m, load8(a + m)); m = m + 1 }
    let p = 0
    while p < 40 { store8(joined + 20 + p, load8(b + p)); p = p + 1 }
    store8(joined + 60, 0)
    let expected = sha256_oneshot(joined, 60)
    let q = 0
    let mismatches = 0
    while q < 32 {
        if load8(got + q) != load8(expected + q) { mismatches = mismatches + 1 }
        q = q + 1
    }
    ce_eq("transcript digest matches concatenation", mismatches, 0)
}

fn test_transcript_finalize_is_nondestructive() {
    // Finalize twice and confirm the buffer count is unchanged.
    let st = dtls_init()
    dtls_transcript_init(st)
    let msg = alloc(9)
    let i = 0
    while i < 8 { store8(msg + i, 42); i = i + 1 }
    store8(msg + 8, 0)
    dtls_transcript_absorb(st, msg, 8)
    let d1 = dtls_transcript_finalize(st)
    let n_after_first = dtls_transcript_len(st)
    let d2 = dtls_transcript_finalize(st)
    let n_after_second = dtls_transcript_len(st)
    ce_eq("finalize does not consume bytes", n_after_first, n_after_second)
    let mismatches = 0
    let q = 0
    while q < 32 {
        if load8(d1 + q) != load8(d2 + q) { mismatches = mismatches + 1 }
        q = q + 1
    }
    ce_eq("two finalizes agree byte-for-byte", mismatches, 0)
}

// ---- Server-side state-machine edges -------------------------------------

fn test_valid_edge_server_chain() {
    // INIT -> CLIENT_HELLO_RECVD -> ... -> SHD_SENT
    ce_eq("INIT -> CHR", _dtls_valid_edge(DTLS_S_INIT, DTLS_S_CLIENT_HELLO_RECVD), 1)
    ce_eq("CHR -> SHS", _dtls_valid_edge(DTLS_S_CLIENT_HELLO_RECVD, DTLS_S_SERVER_HELLO_SENT), 1)
    ce_eq("SHS -> CS", _dtls_valid_edge(DTLS_S_SERVER_HELLO_SENT, DTLS_S_CERT_SENT), 1)
    ce_eq("CS -> SKES", _dtls_valid_edge(DTLS_S_CERT_SENT, DTLS_S_SKE_SENT), 1)
    ce_eq("SKES -> SHDS", _dtls_valid_edge(DTLS_S_SKE_SENT, DTLS_S_SHD_SENT), 1)
    // Every server-side state may fail out.
    ce_eq("CHR -> FAILED", _dtls_valid_edge(DTLS_S_CLIENT_HELLO_RECVD, DTLS_S_FAILED), 1)
    ce_eq("SHDS -> FAILED", _dtls_valid_edge(DTLS_S_SHD_SENT, DTLS_S_FAILED), 1)
}

fn test_valid_edge_server_reverse_rejected() {
    // Reverse edges are rejected.
    ce_eq("CHR -> INIT rejected",
          _dtls_valid_edge(DTLS_S_CLIENT_HELLO_RECVD, DTLS_S_INIT), 0)
    ce_eq("SHDS -> SKES rejected",
          _dtls_valid_edge(DTLS_S_SHD_SENT, DTLS_S_SKE_SENT), 0)
    ce_eq("CS -> SHDS (skipping SKES) rejected",
          _dtls_valid_edge(DTLS_S_CERT_SENT, DTLS_S_SHD_SENT), 0)
    // Client-side chain preserved: original edges untouched.
    ce_eq("INIT -> CHS still valid",
          _dtls_valid_edge(DTLS_S_INIT, DTLS_S_CLIENT_HELLO_SENT), 1)
}

fn test_transition_walks_server_chain() {
    let st = dtls_init()
    ce_eq("walk INIT->CHR", dtls_transition(st, DTLS_S_CLIENT_HELLO_RECVD), 1)
    ce_eq("walk CHR->SHS", dtls_transition(st, DTLS_S_SERVER_HELLO_SENT), 1)
    ce_eq("walk SHS->CS",  dtls_transition(st, DTLS_S_CERT_SENT), 1)
    ce_eq("walk CS->SKES", dtls_transition(st, DTLS_S_SKE_SENT), 1)
    ce_eq("walk SKES->SHDS", dtls_transition(st, DTLS_S_SHD_SENT), 1)
    ce_eq("end state = SHDS", dtls_state_get(st), DTLS_S_SHD_SENT)
}

// ---- Server flight driver: refuse paths ----------------------------------

fn test_server_flight_bad_fd_returns_recv_fail() {
    // Bogus fd -1 -> _gds_recv_record returns [0, 0, 0] -> driver
    // bails on the first read with "dtls-hs-recv-fail".
    let cert_chain = list_new()
    let r = gds_handshake_server(0 - 1, 0, 0, 0, cert_chain)
    ce_eq("bogus-fd -> [0, state]", r[0], 0)
    ce_str_eq("last_err = recv-fail",
              dtls_last_error(r[1]), "dtls-hs-recv-fail")
    ce_eq("state ends at FAILED",
          dtls_state_get(r[1]), DTLS_S_FAILED)
}

// ---- pinned slot indices --------------------------------------------------

fn test_transcript_slot_index_pinned() {
    ce_eq("TRANSCRIPT_CTX slot = 49", DTLS_S_SLOT_TRANSCRIPT_CTX, 49)
    ce_eq("TRANSCRIPT_N slot = 50", DTLS_S_SLOT_TRANSCRIPT_N, 50)
    ce_eq("SERVER_RANDOM_OVERRIDE slot = 51",
          DTLS_S_SLOT_SERVER_RANDOM_OVERRIDE, 51)
}

fn test_state_constants_pinned() {
    ce_eq("CLIENT_HELLO_RECVD = 10", DTLS_S_CLIENT_HELLO_RECVD, 10)
    ce_eq("SERVER_HELLO_SENT = 11", DTLS_S_SERVER_HELLO_SENT, 11)
    ce_eq("CERT_SENT = 12", DTLS_S_CERT_SENT, 12)
    ce_eq("SKE_SENT = 13", DTLS_S_SKE_SENT, 13)
    ce_eq("SHD_SENT = 14", DTLS_S_SHD_SENT, 14)
}

// ---- entry point ----------------------------------------------------------

fn main() {
    test_ch_parser_roundtrip_noext()
    test_ch_parser_roundtrip_with_srtp()
    test_ch_parser_rejects_missing_null_compression()
    test_ch_parser_rejects_wrong_suite()
    test_ch_parser_rejects_short_body()
    test_ch_parser_rejects_bad_suites_len()

    test_ext_block_stub_empty()
    test_ext_block_stub_valid()
    test_ext_block_stub_short()

    test_sh_body_shape_no_ext()
    test_sh_body_with_srtp_ext()

    test_cert_body_one_cert()
    test_cert_body_two_certs()

    test_ske_body_shape_and_sig_verifies()

    test_shd_body_empty()

    test_transcript_init_then_absorb()
    test_transcript_matches_oneshot_two_messages()
    test_transcript_finalize_is_nondestructive()

    test_valid_edge_server_chain()
    test_valid_edge_server_reverse_rejected()
    test_transition_walks_server_chain()

    test_server_flight_bad_fd_returns_recv_fail()

    test_transcript_slot_index_pinned()
    test_state_constants_pinned()

    ce_summary("test_dtls_server_flight")
    return 0
}

main()
