// Unit tests for src/safety/capability_gate.nova (ADR-0094).
// Covers every rule branch of cg_decide plus the cg_is_allowed convenience gate
// and the name renderers, asserting fail-closed and never-silent-governance.

import "../ce_test.nova"
import "../../src/safety/capability_gate.nova"

// Reusable context helpers (authorized, touches_gov, reversible, source_clean).
fn ctx_clean()        { return cg_ctx_new(0, 0, 1, 1) }   // benign reversible clean
fn ctx_unclean()      { return cg_ctx_new(0, 0, 1, 0) }   // unclean source
fn ctx_auth()         { return cg_ctx_new(1, 0, 1, 1) }   // authorized, no gov
fn ctx_gov()          { return cg_ctx_new(0, 1, 1, 1) }   // touches governance
fn ctx_auth_gov()     { return cg_ctx_new(1, 1, 1, 1) }   // authorized + gov
fn ctx_irreversible() { return cg_ctx_new(0, 0, 0, 1) }   // not reversible

fn test_read_answer_allow() {
    ce_eq("read_kb ALLOW",  cg_decide(CAP_READ_KB, ctx_clean()),  CG_ALLOW)
    ce_eq("answer ALLOW",   cg_decide(CAP_ANSWER,  ctx_clean()),  CG_ALLOW)
    // read/answer stay ALLOW even with hostile-looking inputs (truly read-only).
    ce_eq("read_kb ALLOW unclean",  cg_decide(CAP_READ_KB, ctx_unclean()), CG_ALLOW)
    ce_eq("answer ALLOW gov",       cg_decide(CAP_ANSWER,  ctx_gov()),     CG_ALLOW)
}

fn test_fetch_ingest_source_screen() {
    ce_eq("fetch clean ALLOW",     cg_decide(CAP_AUTONOMOUS_FETCH, ctx_clean()),   CG_ALLOW)
    ce_eq("fetch unclean DENY",    cg_decide(CAP_AUTONOMOUS_FETCH, ctx_unclean()), CG_DENY)
    ce_eq("ingest clean ALLOW",    cg_decide(CAP_INGEST_ATOM, ctx_clean()),        CG_ALLOW)
    ce_eq("ingest unclean DENY",   cg_decide(CAP_INGEST_ATOM, ctx_unclean()),      CG_DENY)
}

fn test_promote_atom() {
    // reversible, non-governance -> ALLOW
    ce_eq("promote reversible ALLOW", cg_decide(CAP_PROMOTE_ATOM, ctx_clean()), CG_ALLOW)
    // irreversible -> REQUIRE_APPROVAL
    ce_eq("promote irreversible APPROVAL",
          cg_decide(CAP_PROMOTE_ATOM, ctx_irreversible()), CG_REQUIRE_APPROVAL)
    // touches governance -> DENY (even if reversible)
    ce_eq("promote gov DENY", cg_decide(CAP_PROMOTE_ATOM, ctx_gov()), CG_DENY)
    // governance dominates over reversibility ceiling
    ce_eq("promote gov+irrev DENY",
          cg_decide(CAP_PROMOTE_ATOM, cg_ctx_new(0, 1, 0, 1)), CG_DENY)
}

fn test_edit_governance_never_silent() {
    // unauthorized -> DENY
    ce_eq("gov edit unauth DENY", cg_decide(CAP_EDIT_GOVERNANCE, ctx_clean()), CG_DENY)
    // authorized -> at most REQUIRE_APPROVAL, NEVER a silent ALLOW
    ce_eq("gov edit auth APPROVAL",
          cg_decide(CAP_EDIT_GOVERNANCE, ctx_auth()), CG_REQUIRE_APPROVAL)
    ce_eq("gov edit auth+gov APPROVAL",
          cg_decide(CAP_EDIT_GOVERNANCE, ctx_auth_gov()), CG_REQUIRE_APPROVAL)
    // the load-bearing invariant: governance edit is never ALLOW
    ce_check("gov edit never ALLOW (unauth)",
             cg_decide(CAP_EDIT_GOVERNANCE, ctx_clean()) != CG_ALLOW)
    ce_check("gov edit never ALLOW (auth)",
             cg_decide(CAP_EDIT_GOVERNANCE, ctx_auth_gov()) != CG_ALLOW)
}

fn test_irreversible_outward() {
    // unauthorized -> REQUIRE_APPROVAL
    ce_eq("self_update unauth APPROVAL",
          cg_decide(CAP_SELF_UPDATE, ctx_clean()), CG_REQUIRE_APPROVAL)
    ce_eq("delete unauth APPROVAL",
          cg_decide(CAP_DELETE, ctx_clean()), CG_REQUIRE_APPROVAL)
    ce_eq("network_send unauth APPROVAL",
          cg_decide(CAP_NETWORK_SEND, ctx_clean()), CG_REQUIRE_APPROVAL)
    // touches governance -> DENY (self-editing safety gates)
    ce_eq("self_update gov DENY",
          cg_decide(CAP_SELF_UPDATE, ctx_gov()), CG_DENY)
    ce_eq("delete gov DENY",
          cg_decide(CAP_DELETE, ctx_gov()), CG_DENY)
    ce_eq("network_send gov DENY",
          cg_decide(CAP_NETWORK_SEND, ctx_gov()), CG_DENY)
    // authorized but no governance -> still REQUIRE_APPROVAL (high blast radius)
    ce_eq("self_update auth APPROVAL",
          cg_decide(CAP_SELF_UPDATE, ctx_auth()), CG_REQUIRE_APPROVAL)
}

fn test_fail_closed() {
    // unknown capability -> DENY
    ce_eq("unknown cap DENY", cg_decide(999, ctx_auth()), CG_DENY)
    ce_eq("zero cap DENY",    cg_decide(0,   ctx_clean()), CG_DENY)
}

fn test_is_allowed() {
    ce_eq("is_allowed read 1",   cg_is_allowed(CAP_READ_KB, ctx_clean()), 1)
    ce_eq("is_allowed fetch clean 1", cg_is_allowed(CAP_AUTONOMOUS_FETCH, ctx_clean()), 1)
    ce_eq("is_allowed fetch unclean 0", cg_is_allowed(CAP_AUTONOMOUS_FETCH, ctx_unclean()), 0)
    ce_eq("is_allowed gov edit 0", cg_is_allowed(CAP_EDIT_GOVERNANCE, ctx_auth()), 0)
    ce_eq("is_allowed self_update 0", cg_is_allowed(CAP_SELF_UPDATE, ctx_auth()), 0)
}

fn test_accessors_and_names() {
    let c = cg_ctx_new(1, 0, 1, 0)
    ce_eq("ctx authorized",   cg_ctx_authorized(c),         1)
    ce_eq("ctx governance",   cg_ctx_touches_governance(c), 0)
    ce_eq("ctx reversible",   cg_ctx_reversible(c),         1)
    ce_eq("ctx source_clean", cg_ctx_source_clean(c),       0)
    // out-of-range / default ctx fields read as 0 (fail-safe accessor)
    let empty = list_new()
    ce_eq("missing field reads 0", cg_ctx_authorized(empty), 0)
    // name renderers are exercised for non-crashing coverage (str compare avoided
    // per NOVA string-identity gotcha); we assert they are non-empty strings.
    ce_check("decision name non-empty", len(cg_decision_name(CG_ALLOW)) > 0)
    ce_check("cap name non-empty", len(cg_capability_name(CAP_SELF_UPDATE)) > 0)
    ce_check("unknown decision name non-empty", len(cg_decision_name(42)) > 0)
    ce_check("unknown cap name non-empty", len(cg_capability_name(123)) > 0)
}

test_read_answer_allow()
test_fetch_ingest_source_screen()
test_promote_atom()
test_edit_governance_never_silent()
test_irreversible_outward()
test_fail_closed()
test_is_allowed()
test_accessors_and_names()
ce_summary("capability_gate")
