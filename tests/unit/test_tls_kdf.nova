// Unit tests for src/net/tls/tls_kdf.nova
//   -- TLS 1.3 HKDF-Expand-Label / Derive-Secret / (key, iv) derivation
//   per RFC 8446 §7.1 + §7.3.
//
// Coverage
//   * HkdfLabel byte-serialization matches the RFC 8446 §7.1 wire spec:
//       - uint16 length is big-endian
//       - label is 1-byte length prefixed and gets the mandatory
//         "tls13 " prefix
//       - context is 1-byte length prefixed
//       - empty context serializes as a single 0x00 byte
//   * HKDF-Expand-Label vectors reproducible against Python hkdf:
//       - hkdf_expand_label(early_secret, "derived", sha256(""), 32)
//         -- exactly the RFC 8448 §3 "derived-from-early" secret
//     Reference bytes:
//       early_secret =
//         33ad0a1c607ec03b09e6cd9893680ce2
//         10adf300aa1f2660e1b22e10f170f92a
//       derived_from_early =
//         6f2615a108c702c5678f54fc9dbab697
//         16c076189c48250cebeac3576c3611ba
//   * Derive-Secret composes correctly:
//       derive_secret(early, "derived", "") ==
//           expand_label(early, "derived", sha256(""), 32)
//   * derive_key_iv on a derived secret matches expand_label on the
//     same secret with labels "key" and "iv" (byte-for-byte).
//   * Refusals: label_len == 0, label_len > 249, context_len > 255,
//     length > 65535.
//
// References
//   RFC 8446 §7.1 -- key schedule, HkdfLabel, Derive-Secret.
//   RFC 8446 §7.3 -- per-direction (key, iv) derivation.
//   RFC 8448 §3   -- 1-RTT handshake transcript; early_secret and
//                    derived secrets used as spot-check KATs.
//
// NOVA dependencies: ce_test harness, tls_kdf.nova, hkdf_sha256.nova,
//   sha256.nova.

import "../ce_test.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/hkdf_sha256.nova"
import "../../src/net/tls/tls_kdf.nova"

// ---- helpers --------------------------------------------------------------

fn _tk_nibble_hex(n) {
    if n < 10 { return 48 + n }
    return 87 + n
}

fn _tk_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        s = s + chr(_tk_nibble_hex(int_and(int_shr(b, 4), 15)))
        s = s + chr(_tk_nibble_hex(int_and(b, 15)))
        i = i + 1
    }
    return s
}

fn _tk_hex_nibble(c) {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    return 0 - 1
}

fn _tk_hex_to_buf(hex) {
    let n = len(hex)
    let half = int_shr(n, 1)
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _tk_hex_nibble(char_at(hex, i * 2))
        let lo = _tk_hex_nibble(char_at(hex, i * 2 + 1))
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    let r = list_new()
    push(r, buf)
    push(r, half)
    return r
}

fn _tk_bufs_eq(a, an, b, bn) {
    if an != bn { return 0 }
    let i = 0
    while i < an {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

fn _tk_ascii_to_buf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, char_at(s, i)); i = i + 1 }
    store8(buf + n, 0)
    let r = list_new()
    push(r, buf); push(r, n)
    return r
}

fn _tk_zeros(n) {
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 0); i = i + 1 }
    store8(buf + n, 0)
    return buf
}

// ---- HkdfLabel serialization -------------------------------------------

fn test_hkdflabel_derived_with_empty_transcript() {
    // Expected wire form for length=32, label="derived",
    // context=sha256(""). Reference computed by hand against the RFC:
    //   00 20                              length = 0x0020
    //   0d                                 label_length = 13
    //   74 6c 73 31 33 20 64 65 72 69      "tls13 derived"
    //   76 65 64
    //   20                                 context_length = 32
    //   e3 b0 c4 42 ...                    sha256("") (32 bytes)
    let label = _tk_ascii_to_buf("derived")
    let ctx   = _tk_hex_to_buf("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    let hb = tls_kdf_hkdf_label_bytes(32, label[0], label[1], ctx[0], ctx[1])
    ce_eq("HkdfLabel(derived, sha256(''), 32) total length",
        hb[1], 2 + 1 + 13 + 1 + 32)
    ce_str_eq("HkdfLabel(derived, sha256(''), 32) bytes",
        _tk_hex_encode_buf(hb[0], hb[1]),
        "00200d746c733133206465726976656420e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}

fn test_hkdflabel_key_empty_context() {
    // length=32, label="key", context empty (single 0x00 length byte).
    //   00 20  09  74 6c 73 31 33 20 6b 65 79  00
    let label = _tk_ascii_to_buf("key")
    let hb = tls_kdf_hkdf_label_bytes(32, label[0], label[1], 0, 0)
    ce_eq("HkdfLabel(key, '', 32) total length", hb[1], 2 + 1 + 9 + 1)
    ce_str_eq("HkdfLabel(key, '', 32) bytes",
        _tk_hex_encode_buf(hb[0], hb[1]),
        "002009746c733133206b657900")
}

fn test_hkdflabel_iv_empty_context() {
    // length=12, label="iv", context empty.
    //   00 0c  08  74 6c 73 31 33 20 69 76  00
    let label = _tk_ascii_to_buf("iv")
    let hb = tls_kdf_hkdf_label_bytes(12, label[0], label[1], 0, 0)
    ce_eq("HkdfLabel(iv, '', 12) total length", hb[1], 2 + 1 + 8 + 1)
    ce_str_eq("HkdfLabel(iv, '', 12) bytes",
        _tk_hex_encode_buf(hb[0], hb[1]),
        "000c08746c73313320697600")
}

fn test_hkdflabel_length_is_big_endian() {
    // length = 256 must serialize as 0x01 0x00, not 0x00 0x01.
    let label = _tk_ascii_to_buf("x")
    let hb = tls_kdf_hkdf_label_bytes(256, label[0], label[1], 0, 0)
    ce_eq("HkdfLabel length byte 0 = 0x01", load8(hb[0] + 0), 1)
    ce_eq("HkdfLabel length byte 1 = 0x00", load8(hb[0] + 1), 0)
}

// ---- HKDF-Expand-Label + RFC 8448 spot-check ---------------------------

fn test_early_secret_matches_rfc8448() {
    // early_secret = HKDF-Extract(salt = 0^32, IKM = 0^32).
    let zeros = _tk_zeros(32)
    let early = hkdf_extract(zeros, 32, zeros, 32)
    ce_str_eq("early_secret matches RFC 8448 §3",
        _tk_hex_encode_buf(early, 32),
        "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
}

fn test_expand_label_derived_from_early() {
    // hkdf_expand_label(early_secret, "derived", sha256(""), 32)
    // matches the RFC 8448 §3 "derived from early" secret.
    let early = _tk_hex_to_buf("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    let th    = _tk_hex_to_buf("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    let label = _tk_ascii_to_buf("derived")
    let out = tls_kdf_hkdf_expand_label(early[0], early[1],
                                        label[0], label[1],
                                        th[0], th[1], 32)
    ce_eq("expand_label(early,'derived',sha256(''),32) length", out[1], 32)
    ce_str_eq("expand_label(early,'derived',sha256(''),32) bytes",
        _tk_hex_encode_buf(out[0], 32),
        "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
}

// ---- Derive-Secret composes correctly ---------------------------------

fn test_derive_secret_matches_expand_label() {
    // derive_secret(early, "derived", "") should be identical to
    // expand_label(early, "derived", sha256(""), 32). This pins the
    // Transcript-Hash composition inside derive_secret.
    let early = _tk_hex_to_buf("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    let label = _tk_ascii_to_buf("derived")
    let empty = _tk_zeros(1)   // placeholder buf; len passed as 0
    let via_derive = tls_kdf_derive_secret(early[0], early[1],
                                           label[0], label[1],
                                           empty, 0)
    ce_eq("derive_secret length", via_derive[1], 32)
    ce_str_eq("derive_secret(early,'derived','') matches derived_from_early",
        _tk_hex_encode_buf(via_derive[0], 32),
        "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    // Cross-check with the manual expand_label version.
    let th = sha256_oneshot(empty, 0)
    let via_expand = tls_kdf_hkdf_expand_label(early[0], early[1],
                                               label[0], label[1],
                                               th, 32, 32)
    ce_eq("derive_secret bytes == expand_label bytes",
        _tk_bufs_eq(via_derive[0], 32, via_expand[0], 32), 1)
}

fn test_derive_secret_ext_binder() {
    // derive_secret(early, "ext binder", "") -- reference vector
    // computed against Python hkdf + sha256; pins the label surface
    // for a label with a space in it.
    let early = _tk_hex_to_buf("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    let label = _tk_ascii_to_buf("ext binder")
    let empty = _tk_zeros(1)
    let out = tls_kdf_derive_secret(early[0], early[1],
                                    label[0], label[1],
                                    empty, 0)
    ce_eq("ext binder length", out[1], 32)
    ce_str_eq("derive_secret(early,'ext binder','') bytes",
        _tk_hex_encode_buf(out[0], 32),
        "8fa31e7b3844748675c3a4728ba01c382ebd0c5f64cc6bee56c863982624c3e2")
}

// ---- derive_key_iv (record-layer entry point) --------------------------

fn test_derive_key_iv_matches_manual_labels() {
    // Feed derive_key_iv the "derived from early" secret; check that
    // the returned (key, iv) matches manual expand_label calls with
    // labels "key" and "iv".
    let secret = _tk_hex_to_buf("6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    let pair = tls_kdf_derive_key_iv(secret[0], secret[1])
    let key_label = _tk_ascii_to_buf("key")
    let iv_label  = _tk_ascii_to_buf("iv")
    let key_manual = tls_kdf_hkdf_expand_label(secret[0], secret[1],
                                               key_label[0], key_label[1],
                                               0, 0, 32)
    let iv_manual  = tls_kdf_hkdf_expand_label(secret[0], secret[1],
                                               iv_label[0], iv_label[1],
                                               0, 0, 12)
    ce_eq("derive_key_iv key matches expand_label('key')",
        _tk_bufs_eq(pair[0], 32, key_manual[0], 32), 1)
    ce_eq("derive_key_iv iv matches expand_label('iv')",
        _tk_bufs_eq(pair[1], 12, iv_manual[0], 12), 1)
    // And the fixed reference bytes from the Python hkdf reference.
    ce_str_eq("derive_key_iv key (derived_from_early)",
        _tk_hex_encode_buf(pair[0], 32),
        "d2438831192584a5886858ab6fe34bf96ae5c760a88ae3ebcc94955cd09be1ae")
    ce_str_eq("derive_key_iv iv  (derived_from_early)",
        _tk_hex_encode_buf(pair[1], 12),
        "41e2938f405524502cffd9fc")
}

// ---- Refusal cases -----------------------------------------------------

fn test_refuse_empty_label() {
    let secret = _tk_hex_to_buf("6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    let empty = _tk_zeros(1)
    let out = tls_kdf_hkdf_expand_label(secret[0], secret[1],
                                        empty, 0, 0, 0, 32)
    ce_eq("empty label refused (length 0)", out[1], 0)
}

fn test_refuse_oversize_label() {
    // 6 + 250 = 256 > 255 -> refuse. Build a 250-byte label.
    let secret = _tk_hex_to_buf("6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    let big_label = alloc(251)
    let i = 0
    while i < 250 { store8(big_label + i, 97); i = i + 1 }   // 'a'*250
    store8(big_label + 250, 0)
    let out = tls_kdf_hkdf_expand_label(secret[0], secret[1],
                                        big_label, 250, 0, 0, 32)
    ce_eq("6+250-byte label refused (length 0)", out[1], 0)
}

fn test_refuse_oversize_context() {
    let secret = _tk_hex_to_buf("6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    let label = _tk_ascii_to_buf("x")
    let big_ctx = alloc(257)
    let i = 0
    while i < 256 { store8(big_ctx + i, 0); i = i + 1 }
    store8(big_ctx + 256, 0)
    let out = tls_kdf_hkdf_expand_label(secret[0], secret[1],
                                        label[0], label[1],
                                        big_ctx, 256, 32)
    ce_eq("256-byte context refused (length 0)", out[1], 0)
}

fn test_refuse_oversize_length() {
    let secret = _tk_hex_to_buf("6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    let label = _tk_ascii_to_buf("x")
    let out = tls_kdf_hkdf_expand_label(secret[0], secret[1],
                                        label[0], label[1],
                                        0, 0, 65536)
    ce_eq("length=65536 refused (length 0)", out[1], 0)
}

// ---- Constants ---------------------------------------------------------

fn test_constants() {
    ce_eq("TLS_KDF_HASH_LEN = 32", TLS_KDF_HASH_LEN, 32)
    ce_eq("TLS_KDF_KEY_LEN  = 32", TLS_KDF_KEY_LEN, 32)
    ce_eq("TLS_KDF_IV_LEN   = 12", TLS_KDF_IV_LEN, 12)
}

// ---- Run ---------------------------------------------------------------

fn main() {
    test_hkdflabel_derived_with_empty_transcript()
    test_hkdflabel_key_empty_context()
    test_hkdflabel_iv_empty_context()
    test_hkdflabel_length_is_big_endian()
    test_early_secret_matches_rfc8448()
    test_expand_label_derived_from_early()
    test_derive_secret_matches_expand_label()
    test_derive_secret_ext_binder()
    test_derive_key_iv_matches_manual_labels()
    test_refuse_empty_label()
    test_refuse_oversize_label()
    test_refuse_oversize_context()
    test_refuse_oversize_length()
    test_constants()
    ce_summary("tls_kdf")
}

main()
