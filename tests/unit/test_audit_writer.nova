// Unit tests for src/audit/audit_writer.nova
// Verifies the intent-before-outcome ordering, the derived action descriptor
// (perm tier / rev class come from the live safety logic), the sync flag for
// irreversible actions, and correction/override entries. ADR-0043/0044.

import "../ce_test.nova"
import "../../src/audit/audit_writer.nova"

fn test_intent_outcome_ordering() {
    let log = audit_open()
    // A send (irreversible -> APPROVE tier). Intent first, then outcome.
    let seq = audit_intent(log, ACT_SEND_MSG, 2, list_new(), 9, 100)
    ce_eq("intent seq 0", seq, 0)
    let e = dl_get(log, seq)
    ce_eq("intent kind", dl_kind(e), DLK_INTENT)
    ce_eq("intent pending", dl_outcome(e), OUT_PENDING)
    // Descriptor derived from live logic: SEND_MSG is APPROVE + IRREVERSIBLE.
    ce_eq("derived tier", dl_perm_tier(e), PERM_APPROVE)
    ce_eq("derived rev", dl_rev_class(e), REV_IRREVERSIBLE)
    ce_eq("goal recorded", dl_goal(e), 2)

    let oseq = audit_outcome(log, seq, OUT_OK, 110)
    ce_eq("outcome seq 1", oseq, 1)
    let o = dl_get(log, oseq)
    ce_eq("outcome kind", dl_kind(o), DLK_OUTCOME)
    ce_eq("outcome refs intent", dl_ref(o), seq)
    ce_eq("outcome ok", dl_outcome(o), OUT_OK)
    // Completion record copies the intent's descriptor (self-describing).
    ce_eq("copied atype", dl_action_type(o), ACT_SEND_MSG)
    ce_eq("copied goal", dl_goal(o), 2)
    ce_eq("chain intact", dl_verify(log), 1)
}

// AUTO actions still log (ADR-0043 rejects skipping AUTO).
fn test_auto_logs() {
    let log = audit_open()
    let seq = audit_intent(log, ACT_READ_LOCAL, -1, list_new(), 0, 1)
    let e = dl_get(log, seq)
    ce_eq("auto tier", dl_perm_tier(e), PERM_AUTO)
    ce_eq("auto logged", dl_count(log), 1)
}

// The sync flag marks exactly the irreversible actions (ADR-0042 write-order).
fn test_needs_sync() {
    ce_eq("send needs sync", audit_needs_sync(ACT_SEND_MSG), 1)
    ce_eq("spend needs sync", audit_needs_sync(ACT_SPEND), 1)
    ce_eq("read no sync", audit_needs_sync(ACT_READ_LOCAL), 0)
    ce_eq("write no sync", audit_needs_sync(ACT_WRITE_LOCAL), 0)
}

// Corrections and overrides append their own (verifiable) entries.
fn test_correction_override() {
    let log = audit_open()
    audit_correction(log, ACT_SELF_MODIFY, 42, 5)
    audit_override(log, ACT_SELF_MODIFY, 7, 6)
    ce_eq("two entries", dl_count(log), 2)
    ce_eq("correction kind", dl_kind(dl_get(log, 0)), DLK_CORRECTION)
    ce_eq("correction ref atom", dl_ref(dl_get(log, 0)), 42)
    ce_eq("override kind", dl_kind(dl_get(log, 1)), DLK_OVERRIDE)
    ce_eq("override ref goal", dl_ref(dl_get(log, 1)), 7)
    ce_eq("chain intact", dl_verify(log), 1)
}

fn main() {
    test_intent_outcome_ordering()
    test_auto_logs()
    test_needs_sync()
    test_correction_override()
    ce_summary("audit_writer")
}
main()
