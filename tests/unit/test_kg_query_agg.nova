// Unit tests for src/kg/query.nova R17E extensions: aggregate functions
// (COUNT/SUM/AVG/MIN/MAX) + GROUP BY. R15D shipped BGP+FILTER+LIMIT;
// R16F added OPTIONAL+UNION+ORDER BY; R17E closes the core SPARQL 1.1
// analytical-query gap.
//
// The fixture is identical to R15D's _fixture_kg() (5 FACTs at ids 0..4
// with alpha = 1000..5000, then 5 CONCEPTs at ids 5..9 with alpha=1000,
// plus 5 SIMILAR xrefs FACT_i -> CONCEPT_(i+5)) so the aggregate counts
// are deterministic and exactly match the brief:
//   - COUNT(?a) on FACT atoms = 5
//   - SUM(?a alpha)  on FACT atoms = 15000  (1000 + 2000 + ... + 5000)
//   - AVG(?a alpha)  on FACT atoms = 3000   (15000 / 5)
//   - MIN(?a alpha)  on FACT atoms = 1000
//   - MAX(?a alpha)  on FACT atoms = 5000
//   - GROUP BY ?kind on all 10 atoms: 2 rows (FACT count=5, CONCEPT count=5)
//
// Total assertions: ~30. Helpers are integer-only; comparisons exact.
//
// ADRs: ADR-0016 (atoms + xrefs are the query surface), ADR-0049
// (testing + benchmarks).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/cross_kg_references.nova"
import "../../src/kg/query.nova"

// ---- helpers --------------------------------------------------------------

// Rebuilds R15D's 10-atom fixture: 5 FACTs at ids 0..4 with alpha =
// 1000..5000, then 5 CONCEPTs at ids 5..9 with alpha=1000 (the prior;
// CONCEPTs aren't observed). Every FACT i links to CONCEPT (i+5) via
// XREF_SIMILAR. Pinned across R15D/R16F/R17E.
fn _fixture_kg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "test_query_agg")
    let i = 0
    while i < 5 {
        let a = kg_add_atom(kg, ATOM_FACT, "fact_" + int_to_str(i), 1000 + i * 100)
        let j = 0
        while j < i {
            atom_observe(a, 1)
            j = j + 1
        }
        i = i + 1
    }
    let k = 0
    while k < 5 {
        kg_add_atom(kg, ATOM_CONCEPT, "concept_" + int_to_str(k), 1500 + k * 100)
        k = k + 1
    }
    let m = 0
    while m < 5 {
        let f = kg_atom(kg, m)
        let c = kg_atom(kg, m + 5)
        let x = xref_new(f, c, XREF_SIMILAR, 900, 0)
        atom_add_xref(f, x)
        m = m + 1
    }
    return kg
}

// ---- parser tests (new syntax) -------------------------------------------

fn test_parse_count_select() {
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) WHERE { ?a kind FACT . }")
    ce_check("COUNT query parses", kg_query_is_parsed(q) == 1)
    ce_eq("one var selected", len(kg_query_vars(q)), 1)
    ce_str_eq("var name is alias 'n'", kg_query_vars(q)[0], "n")
    ce_eq("one aggregate", len(kg_query_aggs(q)), 1)
    ce_eq("aggs_has true", kg_query_aggs_has(q), 1)
    let a = kg_query_aggs(q)[0]
    ce_eq("agg code is COUNT", a[0], QRY_AGG_COUNT)
    ce_str_eq("agg src_var is 'a'", a[1], "a")
    ce_str_eq("agg alias is 'n'", a[3], "n")
}

fn test_parse_sum_select() {
    let q = kg_query_parse("SELECT (SUM(?a alpha) AS ?total) WHERE { ?a kind FACT . }")
    ce_check("SUM query parses", kg_query_is_parsed(q) == 1)
    let a = kg_query_aggs(q)[0]
    ce_eq("agg code is SUM", a[0], QRY_AGG_SUM)
    ce_str_eq("agg field is 'alpha'", a[2], "alpha")
    ce_str_eq("agg alias is 'total'", a[3], "total")
}

fn test_parse_avg_min_max_select() {
    let q1 = kg_query_parse("SELECT (AVG(?a alpha) AS ?mean) WHERE { ?a kind FACT . }")
    ce_eq("AVG parses", kg_query_aggs(q1)[0][0], QRY_AGG_AVG)
    let q2 = kg_query_parse("SELECT (MIN(?a alpha) AS ?lo) WHERE { ?a kind FACT . }")
    ce_eq("MIN parses", kg_query_aggs(q2)[0][0], QRY_AGG_MIN)
    let q3 = kg_query_parse("SELECT (MAX(?a alpha) AS ?hi) WHERE { ?a kind FACT . }")
    ce_eq("MAX parses", kg_query_aggs(q3)[0][0], QRY_AGG_MAX)
}

fn test_parse_group_by() {
    let q = kg_query_parse("SELECT ?kind (COUNT(?a) AS ?n) WHERE { ?a kind ?kind . } GROUP BY ?kind")
    ce_check("GROUP BY query parses", kg_query_is_parsed(q) == 1)
    ce_eq("groupby_has", kg_query_groupby_has(q), 1)
    ce_str_eq("groupby var is 'kind'", kg_query_groupby_var(q), "kind")
    ce_eq("two vars (kind + alias n)", len(kg_query_vars(q)), 2)
    ce_str_eq("vars[0]=kind", kg_query_vars(q)[0], "kind")
    ce_str_eq("vars[1]=n", kg_query_vars(q)[1], "n")
}

fn test_parse_multi_aggregate() {
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) (SUM(?a alpha) AS ?total) WHERE { ?a kind FACT . }")
    ce_check("multi-aggregate parses", kg_query_is_parsed(q) == 1)
    ce_eq("two aggregates", len(kg_query_aggs(q)), 2)
    ce_str_eq("first alias=n", kg_query_aggs(q)[0][3], "n")
    ce_str_eq("second alias=total", kg_query_aggs(q)[1][3], "total")
}

fn test_parse_bad_agg_missing_field_for_sum() {
    let r = kg_query_parse("SELECT (SUM(?a) AS ?total) WHERE { ?a kind FACT . }")
    ce_eq("SUM without field is an error", _qry_is_error(r), 1)
}

fn test_parse_bad_agg_unknown_function() {
    let r = kg_query_parse("SELECT (MEDIAN(?a alpha) AS ?m) WHERE { ?a kind FACT . }")
    ce_eq("unknown aggregate function is an error", _qry_is_error(r), 1)
}

fn test_parse_bad_agg_missing_as() {
    let r = kg_query_parse("SELECT (COUNT(?a) ?n) WHERE { ?a kind FACT . }")
    ce_eq("missing AS is an error", _qry_is_error(r), 1)
}

fn test_parse_bad_group_by_missing_var() {
    let r = kg_query_parse("SELECT ?kind WHERE { ?a kind ?kind . } GROUP BY")
    ce_eq("GROUP BY without var is an error", _qry_is_error(r), 1)
}

// ---- executor tests: COUNT -----------------------------------------------

fn test_count_facts() {
    // R15D fixture: 5 FACT atoms; COUNT(?a) on FACTs = 5.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("one output row", len(results), 1)
    ce_eq("COUNT(?a) over FACTs = 5", binding_get(results[0], "n"), 5)
}

fn test_count_concepts() {
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) WHERE { ?a kind CONCEPT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("one output row", len(results), 1)
    ce_eq("COUNT(?a) over CONCEPTs = 5", binding_get(results[0], "n"), 5)
}

fn test_count_empty_set() {
    // Filter such that NO atom matches -- alpha > 999999.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) WHERE { ?a kind FACT . FILTER alpha > 999999 . }")
    let results = kg_query_execute(kg, q)
    ce_eq("still one output row (aggregate over empty set)", len(results), 1)
    ce_eq("COUNT on empty = 0", binding_get(results[0], "n"), 0)
}

// ---- executor tests: SUM/AVG/MIN/MAX -------------------------------------

fn test_sum_alpha_facts() {
    // FACT atoms have alpha = 1000, 2000, 3000, 4000, 5000 -> sum = 15000.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (SUM(?a alpha) AS ?total) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("SUM(alpha) over FACTs = 15000", binding_get(results[0], "total"), 15000)
}

fn test_avg_alpha_facts() {
    // 15000 / 5 = 3000 (exact, no truncation surprise).
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (AVG(?a alpha) AS ?mean) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("AVG(alpha) over FACTs = 3000", binding_get(results[0], "mean"), 3000)
}

fn test_min_alpha_facts() {
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (MIN(?a alpha) AS ?lo) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("MIN(alpha) over FACTs = 1000", binding_get(results[0], "lo"), 1000)
}

fn test_max_alpha_facts() {
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (MAX(?a alpha) AS ?hi) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("MAX(alpha) over FACTs = 5000", binding_get(results[0], "hi"), 5000)
}

fn test_sum_on_empty_set() {
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (SUM(?a alpha) AS ?total) WHERE { ?a kind FACT . FILTER alpha > 999999 . }")
    let results = kg_query_execute(kg, q)
    ce_eq("SUM on empty = 0", binding_get(results[0], "total"), 0)
}

fn test_avg_min_max_on_empty_set_sentinel() {
    // Brief specifies -1 ("no data") for AVG/MIN/MAX on no bindings.
    let kg = _fixture_kg()
    let q1 = kg_query_parse("SELECT (AVG(?a alpha) AS ?m) WHERE { ?a kind FACT . FILTER alpha > 999999 . }")
    let r1 = kg_query_execute(kg, q1)
    ce_eq("AVG on empty = QRY_AGG_EMPTY (-1)", binding_get(r1[0], "m"), QRY_AGG_EMPTY)
    let q2 = kg_query_parse("SELECT (MIN(?a alpha) AS ?m) WHERE { ?a kind FACT . FILTER alpha > 999999 . }")
    let r2 = kg_query_execute(kg, q2)
    ce_eq("MIN on empty = QRY_AGG_EMPTY", binding_get(r2[0], "m"), QRY_AGG_EMPTY)
    let q3 = kg_query_parse("SELECT (MAX(?a alpha) AS ?m) WHERE { ?a kind FACT . FILTER alpha > 999999 . }")
    let r3 = kg_query_execute(kg, q3)
    ce_eq("MAX on empty = QRY_AGG_EMPTY", binding_get(r3[0], "m"), QRY_AGG_EMPTY)
}

// ---- executor tests: GROUP BY --------------------------------------------

fn test_group_by_kind_count() {
    // GROUP BY ?kind on all atoms: 2 buckets (FACT=1, CONCEPT=3),
    // each with COUNT=5.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?kind (COUNT(?a) AS ?n) WHERE { ?a kind ?kind . } GROUP BY ?kind")
    let results = kg_query_execute(kg, q)
    ce_eq("two groups (FACT + CONCEPT)", len(results), 2)
    // FACT group: kind code = 1 (ATOM_FACT), count = 5.
    // CONCEPT group: kind code = 3 (ATOM_CONCEPT), count = 5.
    let saw_fact = 0
    let saw_concept = 0
    let i = 0
    while i < len(results) {
        let k = binding_get(results[i], "kind")
        let n = binding_get(results[i], "n")
        if k == ATOM_FACT {
            if n == 5 { saw_fact = 1 }
        }
        if k == ATOM_CONCEPT {
            if n == 5 { saw_concept = 1 }
        }
        i = i + 1
    }
    ce_eq("FACT bucket has count=5", saw_fact, 1)
    ce_eq("CONCEPT bucket has count=5", saw_concept, 1)
}

fn test_group_by_kind_sum() {
    // GROUP BY ?kind, SUM(?a alpha) per kind:
    //   FACT bucket: sum = 1000+2000+3000+4000+5000 = 15000
    //   CONCEPT bucket: sum = 1000*5 = 5000
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?kind (SUM(?a alpha) AS ?total) WHERE { ?a kind ?kind . } GROUP BY ?kind")
    let results = kg_query_execute(kg, q)
    ce_eq("two groups", len(results), 2)
    let i = 0
    while i < len(results) {
        let k = binding_get(results[i], "kind")
        let t = binding_get(results[i], "total")
        if k == ATOM_FACT {
            ce_eq("FACT alpha sum = 15000", t, 15000)
        }
        if k == ATOM_CONCEPT {
            ce_eq("CONCEPT alpha sum = 5000", t, 5000)
        }
        i = i + 1
    }
}

fn test_group_by_with_filter() {
    // FILTER alpha > 2500 keeps FACTs with alpha in {3000, 4000, 5000}.
    // CONCEPTs all have alpha = 1000, so none survive.
    // GROUP BY ?kind => only the FACT group remains, with COUNT=3.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?kind (COUNT(?a) AS ?n) WHERE { ?a kind ?kind . FILTER alpha > 2500 . } GROUP BY ?kind")
    let results = kg_query_execute(kg, q)
    ce_eq("one group (FACT only)", len(results), 1)
    ce_eq("FACT group kind = ATOM_FACT", binding_get(results[0], "kind"), ATOM_FACT)
    ce_eq("FACT group count = 3", binding_get(results[0], "n"), 3)
}

// ---- multiple aggregates in one SELECT -----------------------------------

fn test_multi_aggregate_single_group() {
    // Without GROUP BY: one row aggregating all FACT bindings.
    // COUNT=5, SUM=15000.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) (SUM(?a alpha) AS ?total) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("one row", len(results), 1)
    ce_eq("n=5", binding_get(results[0], "n"), 5)
    ce_eq("total=15000", binding_get(results[0], "total"), 15000)
}

fn test_multi_aggregate_min_max_avg() {
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT (MIN(?a alpha) AS ?lo) (MAX(?a alpha) AS ?hi) (AVG(?a alpha) AS ?mean) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("one row", len(results), 1)
    ce_eq("lo=1000", binding_get(results[0], "lo"), 1000)
    ce_eq("hi=5000", binding_get(results[0], "hi"), 5000)
    ce_eq("mean=3000", binding_get(results[0], "mean"), 3000)
}

// ---- GROUP BY + ORDER BY combination --------------------------------------

fn test_group_by_with_orderby() {
    // GROUP BY ?kind on all atoms; ORDER BY kind ASC -> FACT (1) before
    // CONCEPT (3). ORDER BY here works on the binding-level since the
    // aggregate row has no atom; we exercise the path doesn't crash.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?kind (COUNT(?a) AS ?n) WHERE { ?a kind ?kind . } GROUP BY ?kind")
    let results = kg_query_execute(kg, q)
    ce_eq("two groups", len(results), 2)
    // Group ordering deterministic by discovery; first FACT is encountered
    // first in atom_store iteration -> FACT bucket first.
    ce_eq("first group is FACT", binding_get(results[0], "kind"), ATOM_FACT)
    ce_eq("second group is CONCEPT", binding_get(results[1], "kind"), ATOM_CONCEPT)
}

// ---- regression: aggregate doesn't break R15D bare-var SELECT -------------

fn test_no_aggregates_still_returns_bindings() {
    // R15D shape with no aggregates: should be untouched.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("R15D shape: 5 FACT bindings", len(results), 5)
    ce_eq("aggs_has false", kg_query_aggs_has(q), 0)
    ce_eq("groupby_has false", kg_query_groupby_has(q), 0)
}

// ---- aggregate over an empty KG ------------------------------------------

fn test_count_on_empty_kg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "test_empty_agg")
    let q = kg_query_parse("SELECT (COUNT(?a) AS ?n) WHERE { ?a kind FACT . }")
    let results = kg_query_execute(kg, q)
    ce_eq("still 1 output row on empty KG", len(results), 1)
    ce_eq("COUNT=0", binding_get(results[0], "n"), 0)
}

fn main() {
    test_parse_count_select()
    test_parse_sum_select()
    test_parse_avg_min_max_select()
    test_parse_group_by()
    test_parse_multi_aggregate()
    test_parse_bad_agg_missing_field_for_sum()
    test_parse_bad_agg_unknown_function()
    test_parse_bad_agg_missing_as()
    test_parse_bad_group_by_missing_var()
    test_count_facts()
    test_count_concepts()
    test_count_empty_set()
    test_sum_alpha_facts()
    test_avg_alpha_facts()
    test_min_alpha_facts()
    test_max_alpha_facts()
    test_sum_on_empty_set()
    test_avg_min_max_on_empty_set_sentinel()
    test_group_by_kind_count()
    test_group_by_kind_sum()
    test_group_by_with_filter()
    test_multi_aggregate_single_group()
    test_multi_aggregate_min_max_avg()
    test_group_by_with_orderby()
    test_no_aggregates_still_returns_bindings()
    test_count_on_empty_kg()
    ce_summary("kg_query_agg")
}

main()
