// Unit tests for src/language/arithmetic.nova (ADR-0055).
// Pure fixed-point evaluator: infix precedence, word operators, percentage,
// decimal rendering, and the not-arithmetic / divide-by-zero rejections.

import "../ce_test.nova"
import "../../src/language/arithmetic.nova"

fn _txt(s) { return arith_text(arith_eval(s)) }
fn _ok(s)  { return arith_ok(arith_eval(s)) }

fn test_basic() {
    ce_str_eq("two plus two",        _txt("2 + 2"),            "4")
    ce_str_eq("embedded in question", _txt("what is 12 * 5"),  "60")
    ce_str_eq("subtraction",         _txt("100 - 30"),         "70")
    ce_str_eq("precedence mul",      _txt("2 + 3 * 4"),        "14")
    ce_str_eq("precedence div",      _txt("20 - 10 / 2"),      "15")
}

fn test_decimals() {
    ce_str_eq("div to decimal",      _txt("10 / 4"),           "2.5")
    ce_str_eq("decimal inputs",      _txt("3.5 + 1.5"),        "5")
    ce_str_eq("third",               _txt("1 / 8"),            "0.125")
}

fn test_words() {
    ce_str_eq("word times",          _txt("7 times 6"),        "42")
    ce_str_eq("word divided by",     _txt("10 divided by 4"),  "2.5")
    ce_str_eq("word plus",           _txt("8 plus 9"),         "17")
}

fn test_percent() {
    ce_str_eq("percent of",          _txt("15% of 200"),       "30")
    ce_str_eq("percent word",        _txt("20 percent of 50"), "10")
}

fn test_rejections() {
    ce_eq("plain word not arith",    _ok("hello world"),       0)
    ce_eq("single number not arith", _ok("42"),                0)
    ce_eq("divide by zero not ok",   _ok("10 / 0"),            0)
}

fn main() {
    test_basic()
    test_decimals()
    test_words()
    test_percent()
    test_rejections()
    ce_summary("arithmetic")
}

main()
