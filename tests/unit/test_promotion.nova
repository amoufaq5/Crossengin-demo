// Unit tests for src/learning/promotion.nova (governed promotion, ADR-0092).

import "../ce_test.nova"
import "../../src/learning/promotion.nova"

fn test_clean_promote() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let a = atom_new("medicine", 0, ATOM_FACT, "aspirin reduces fever", 5)
    let st = cand_promote(a, claim_new("http://en.wikipedia.org/wiki/Aspirin", 2, 0, PROV_NONE, 0), pctx_new(lic, prf))
    ce_eq("clean corroborated -> promoted", st, CAND_PROMOTED)
    ce_eq("graded EMPIRICAL_STRONG", atom_evidence_grade(a), GRADE_EMPIRICAL_STRONG)
    ce_eq("confidence reflects strong", atom_confidence(a), 666)
    ce_eq("license stamped CC-BY-SA", atom_license(a), LICENSE_CC_BY_SA)
    ce_eq("usable in answers", cand_is_usable(a), 1)
}

fn test_unlicensed_quarantine() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let a = atom_new("medicine", 1, ATOM_FACT, "herbal cure-all", 5)
    let st = cand_promote(a, claim_new("http://random-blog.example.com/x", 3, 0, PROV_NONE, 0), pctx_new(lic, prf))
    ce_eq("unlicensed -> quarantined", st, CAND_QUARANTINED)
    ce_eq("quarantined not usable", cand_is_usable(a), 0)
}

fn test_conflict_user_taught() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let owned = atom_new("medicine", 2, ATOM_FACT, "dose is 100mg", 5)
    atom_set_license(owned, LICENSE_OWNER)
    let a = atom_new("medicine", 3, ATOM_FACT, "dose is 500mg", 6)
    let st = cand_promote(a, claim_new("http://en.wikipedia.org/wiki/X", 2, 0, PROV_NONE, owned), pctx_new(lic, prf))
    ce_eq("conflict w/ user-taught -> contested", st, CAND_CONTESTED)
    ce_eq("candidate marked CONTESTED", atom_evidence_grade(a), GRADE_CONTESTED)
    ce_eq("existing marked CONTESTED", atom_evidence_grade(owned), GRADE_CONTESTED)
    ce_eq("contested candidate NOT usable", cand_is_usable(a), 0)
}

fn test_formal_proof() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let code = proof_register(prf, "2+2=4", list_new(), "deriv")
    proof_set_status(prf, code, PROOF_VERIFIED)
    let a = atom_new("math", 4, ATOM_FACT, "2+2=4", 5)
    let st = cand_promote(a, claim_new("http://en.wikipedia.org/wiki/Addition", 1, 1, code, 0), pctx_new(lic, prf))
    ce_eq("formal+verified -> promoted", st, CAND_PROMOTED)
    ce_eq("grade FORMAL", atom_evidence_grade(a), GRADE_FORMAL)
    ce_eq("proof_ref set", atom_proof_ref(a), code)
    ce_eq("confidence pinned ~0.999", atom_confidence(a), 999)
}

fn test_formal_unproven_fallback() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let code = proof_register(prf, "P=NP", list_new(), "handwave")
    let a = atom_new("cs", 5, ATOM_FACT, "P=NP", 5)
    let st = cand_promote(a, claim_new("http://en.wikipedia.org/wiki/PNP", 2, 1, code, 0), pctx_new(lic, prf))
    ce_eq("formal-tractable but unproven -> promoted", st, CAND_PROMOTED)
    ce_eq("unproven NOT graded FORMAL", atom_evidence_grade(a), GRADE_EMPIRICAL_STRONG)
}

fn test_governance_refused() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let gov = atom_new("soul", 6, ATOM_RULE, "be honest", 5)
    atom_payload_set(gov, "governance", 1)
    let a = atom_new("soul", 7, ATOM_RULE, "be deceptive", 6)
    let st = cand_promote(a, claim_new("http://en.wikipedia.org/wiki/X", 5, 0, PROV_NONE, gov), pctx_new(lic, prf))
    ce_eq("editing governance -> rejected", st, CAND_REJECTED)
    ce_eq("rejected not usable", cand_is_usable(a), 0)
}

fn test_lone_fetch_weak() {
    let lic = lic_registry_new()
    let prf = proof_registry_new()
    let a = atom_new("medicine", 8, ATOM_FACT, "rare claim", 5)
    let st = cand_promote(a, claim_new("http://en.wikipedia.org/wiki/X", 1, 0, PROV_NONE, 0), pctx_new(lic, prf))
    ce_eq("lone fetch promoted", st, CAND_PROMOTED)
    ce_eq("lone fetch -> EMPIRICAL_WEAK", atom_evidence_grade(a), GRADE_EMPIRICAL_WEAK)
}

fn test_govern_fetched() {
    // A fetched Wikipedia atom: license resolved, weak grade, marked CANDIDATE
    // and excluded from answers until a promotion pass runs.
    let a = atom_new("medicine", 10, ATOM_FACT, "x", 5)
    govern_fetched_atom(a, "http://en.wikipedia.org/wiki/X")
    ce_eq("fetched license CC-BY-SA", atom_license(a), LICENSE_CC_BY_SA)
    ce_eq("fetched grade WEAK", atom_evidence_grade(a), GRADE_EMPIRICAL_WEAK)
    ce_eq("fetched state CANDIDATE", cand_state(a), CAND_CANDIDATE)
    ce_eq("fetched not usable until promoted", cand_is_usable(a), 0)

    // A user-taught atom: OWNER license, testimonial grade.
    let b = atom_new("medicine", 11, ATOM_FACT, "y", 5)
    govern_fetched_atom(b, "user-taught")
    ce_eq("user license OWNER", atom_license(b), LICENSE_OWNER)
    ce_eq("user grade TESTIMONIAL", atom_evidence_grade(b), GRADE_TESTIMONIAL)

    // An unresolved source -> UNKNOWN license (quarantine on the clean gate).
    let c = atom_new("medicine", 12, ATOM_FACT, "z", 5)
    govern_fetched_atom(c, "http://random.example.com")
    ce_eq("unresolved license UNKNOWN", atom_license(c), LICENSE_UNKNOWN)
}

fn main() {
    test_clean_promote()
    test_unlicensed_quarantine()
    test_conflict_user_taught()
    test_govern_fetched()
    test_formal_proof()
    test_formal_unproven_fallback()
    test_governance_refused()
    test_lone_fetch_weak()
    ce_summary("promotion")
}

main()
