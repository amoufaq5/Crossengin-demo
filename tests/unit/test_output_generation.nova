// Unit tests for src/io/effectors/output_generation.nova
// Verifies pure-substrate generation (ADR-0013): intent -> real word atoms ->
// syntax-ordered text, well-formed-pattern selection, cold-start fallback, and
// plasticity (accepted phrasings strengthen, rejected weaken). No LLM.

import "../ce_test.nova"
import "../../src/io/effectors/output_generation.nova"

fn _intent2(r1, l1, r2, l2) {
    let it = list_new()
    let a = list_new() push(a, r1) push(a, l1)
    let b = list_new() push(b, r2) push(b, l2)
    push(it, a) push(it, b)
    return it
}

fn test_intent_to_text() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let pat = syntax_atom_new(lang, "greeting", ["GREET", "SUBJECT"], 0)
    let cands = list_new() push(cands, pat)
    let intent = _intent2("GREET", "hello", "SUBJECT", "world")

    let text = gen_from_intent(lang, cands, intent, 0)
    ce_str_eq("ordered utterance", text, "hello world")

    // Words are real, interned language atoms.
    ce_check("hello interned", word_find(lang, "hello") != 0)
    ce_check("world interned", word_find(lang, "world") != 0)
}

// A pattern the intent COMPLETES wins over one it only partially fills.
fn test_best_pattern_prefers_complete() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let full = syntax_atom_new(lang, "svo", ["AGENT", "ACTION", "PATIENT"], 0)
    let pair = syntax_atom_new(lang, "av", ["AGENT", "ACTION"], 0)
    let cands = list_new() push(cands, full) push(cands, pair)
    // Intent fills only AGENT+ACTION -> "av" is complete, "svo" is not.
    let intent = _intent2("AGENT", "cat", "ACTION", "runs")
    let fillers = gen_resolve(lang, intent, 0)
    let best = gen_best_pattern(cands, fillers)
    ce_check("complete pattern chosen", is_syntax_atom(best) == 1)
    ce_eq("chosen has 2 slots", syntax_slot_count(best), 2)
    ce_str_eq("emits both", gen_from_intent(lang, cands, intent, 0), "cat runs")
}

// Among complete patterns, higher reliability (belief) wins.
fn test_reliability_breaks_ties() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let p1 = syntax_atom_new(lang, "p1", ["A", "B"], 0)
    let p2 = syntax_atom_new(lang, "p2", ["A", "B"], 0)
    let i = 0
    while i < 6 { syntax_observe(p2, 1) i = i + 1 }   // p2 is more reliable
    let cands = list_new() push(cands, p1) push(cands, p2)
    let fillers = gen_resolve(lang, _intent2("A", "x", "B", "y"), 0)
    ce_check("more reliable pattern wins", gen_best_pattern(cands, fillers) == p2)
}

// With no fitting pattern, fall back to emitting the intent lemmas in order.
fn test_cold_start_fallback() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let cands = list_new()   // no patterns yet
    let text = gen_from_intent(lang, cands, _intent2("X", "good", "Y", "morning"), 0)
    ce_str_eq("cold-start order", text, "good morning")
}

// Plasticity: a generated (accepted) phrasing strengthens its words; explicit
// rejection weakens them (ADR-0007/0013).
fn test_plasticity() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let pat = syntax_atom_new(lang, "g", ["GREET", "SUBJECT"], 0)
    let cands = list_new() push(cands, pat)
    gen_from_intent(lang, cands, _intent2("GREET", "hi", "SUBJECT", "team"), 0)
    let hi = word_find(lang, "hi")
    ce_check("accepted use strengthens", word_confidence(hi) > 500)
    let before = word_confidence(hi)
    let seq = list_new() push(seq, hi)
    gen_feedback(pat, seq, 0)   // user rejects
    ce_check("rejection weakens", word_confidence(hi) < before)
}

// Reverse concept -> word lookup: the substrate-only generation glue that lets
// the agent speak from a reasoning conclusion instead of a fixed literal. The
// highest-weight sense wins; an unnamed concept yields 0.
fn test_reverse_concept_lookup() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c_fever = kg_add_atom(med, ATOM_CONCEPT, "fever", 0)
    let c_treat = kg_add_atom(med, ATOM_CONCEPT, "treat", 0)
    let w_fever = word_atom_new(lang, "fever", 0)
    word_add_sense(w_fever, c_fever, 800)

    let found = gen_word_for_concept(lang, atom_kg(c_fever), atom_id(c_fever))
    ce_check("finds the naming word", found != 0)
    ce_str_eq("right form", word_form(found), "fever")
    ce_eq("unnamed concept -> 0",
        gen_word_for_concept(lang, atom_kg(c_treat), atom_id(c_treat)), 0)

    // Higher-weight sense wins when two words reference the same concept.
    let pyrexia = word_atom_new(lang, "pyrexia", 0)
    word_add_sense(pyrexia, c_fever, 950)
    ce_str_eq("higher-weight sense wins",
        word_form(gen_word_for_concept(lang, atom_kg(c_fever), atom_id(c_fever))), "pyrexia")
}

fn main() {
    test_intent_to_text()
    test_best_pattern_prefers_complete()
    test_reliability_breaks_ties()
    test_cold_start_fallback()
    test_plasticity()
    test_reverse_concept_lookup()
    ce_summary("output_generation")
}
main()
