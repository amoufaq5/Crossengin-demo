// Unit tests for R92 end-to-end path:
//   tls_cert_verify_chain_and_signature -- chain verify + TLS
//   CertificateVerify signature verify.
//
// Coverage
//   * Happy path: leaf+root round-trip; sign a CertificateVerify blob
//     with the leaf's Ed25519 seed; verify -> 1.
//   * Chain fails (bad root pubkey) -> 0.
//   * Chain fails (expired cert -- now_unix outside window) -> 0.
//   * CertificateVerify sig fails (tampered signature) -> 0.
//   * Wrong is_server flag (server-side sig verified as client) -> 0.
//   * Shape rejection: 63/65-byte sig -> 0; negative transcript_hash_len -> 0.

import "../ce_test.nova"
import "../../src/safety/ed25519.nova"
import "../../src/net/tls/tls_cert.nova"
import "../../src/net/tls/x509.nova"
import "./fixtures/x509_test_certs.nova"

// ---- helpers -------------------------------------------------------------

// Deterministic 32-byte transcript hash for the tests.
fn _tcc_transcript() {
    let h = list_new()
    let i = 0
    while i < 32 {
        push(h, int_and(i * 31 + 7, 255))
        i = i + 1
    }
    return h
}

let _TCC_NOW = 1718452800   // 2024-06-15 12:00:00 UTC (same as test_x509_r92)
let _TCC_EXPIRED = 1546300800   // 2019-01-01 UTC (before validity window)

// Build a matched root/leaf pair (root self-signed with TEST 1;
// leaf signed by root, SPKI carries TEST 2 pubkey).
let _TCC_ROOT_CACHE = list_new()
let _TCC_LEAF_CACHE = list_new()

fn _tcc_root() {
    if len(_TCC_ROOT_CACHE) == 0 {
        let pk = fx_ed25519_test1_pub()
        let sk = fx_ed25519_test1_seed()
        let c = x509_build_test_cert("TCC_Root", "TCC_Root", 1,
                                     "200101000000Z", "490101000000Z",
                                     pk, sk, pk)
        let i = 0
        let n = len(c)
        while i < n { push(_TCC_ROOT_CACHE, c[i]); i = i + 1 }
    }
    return _TCC_ROOT_CACHE
}

fn _tcc_leaf() {
    if len(_TCC_LEAF_CACHE) == 0 {
        let leaf_pk = fx_ed25519_test2_pub()
        let root_sk = fx_ed25519_test1_seed()
        let root_pk = fx_ed25519_test1_pub()
        let c = x509_build_test_cert("TCC_Leaf", "TCC_Root", 2,
                                     "200101000000Z", "490101000000Z",
                                     leaf_pk, root_sk, root_pk)
        let i = 0
        let n = len(c)
        while i < n { push(_TCC_LEAF_CACHE, c[i]); i = i + 1 }
    }
    return _TCC_LEAF_CACHE
}

// Sign the RFC 8446 §4.4.3 signed content under the LEAF's seed
// (whose pubkey is in the leaf cert's SPKI). Returns a 64-byte
// Ed25519 signature. Uses the caller's is_server role.
fn _tcc_sign_certverify(is_server) {
    let transcript = _tcc_transcript()
    let signed = tls_cert_verify_input_build(transcript, 32, is_server)
    let sk = fx_ed25519_test2_seed()
    let pk = fx_ed25519_test2_pub()
    return ed25519_sign(signed, sk, pk)
}

// ---- happy path ----------------------------------------------------------

fn test_happy_server() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    ce_eq("happy path server chain+sig",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig),
          1)
}

fn test_happy_client() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_CLIENT)
    let transcript = _tcc_transcript()
    ce_eq("happy path client chain+sig",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_CLIENT, sig),
          1)
}

// ---- chain failure modes -------------------------------------------------

fn test_wrong_root() {
    let leaf = _tcc_leaf()
    // Root built with a different signer keypair -> leaf sig doesn't
    // match the root's SPKI pubkey.
    let wrong_pk = fx_ed25519_test2_pub()
    let wrong_sk = fx_ed25519_test2_seed()
    let wrong_root = x509_build_test_cert("TCC_Root", "TCC_Root", 3,
                                          "200101000000Z", "490101000000Z",
                                          wrong_pk, wrong_sk, wrong_pk)
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    ce_eq("wrong root -> chain+sig verify fails",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              wrong_root, len(wrong_root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
}

fn test_expired() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    ce_eq("now-before-window -> chain+sig fails",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_EXPIRED,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
}

// ---- CertificateVerify signature failure ---------------------------------

fn test_tampered_certverify_sig() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    // Flip one bit in the CertVerify signature.
    let tampered = list_new()
    let i = 0
    while i < 64 { push(tampered, sig[i]); i = i + 1 }
    list_set(tampered, 0, int_xor(tampered[0], 1))
    let transcript = _tcc_transcript()
    ce_eq("tampered CertVerify sig -> fails",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, tampered),
          0)
}

fn test_wrong_role_flag() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    // Sign as SERVER, verify as CLIENT.
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    ce_eq("server-signed CertVerify verified with is_server=CLIENT -> fails",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_CLIENT, sig),
          0)
    // And the reverse: sign as CLIENT, verify as SERVER.
    let sig2 = _tcc_sign_certverify(TLS_CERT_ROLE_CLIENT)
    ce_eq("client-signed CertVerify verified with is_server=SERVER -> fails",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig2),
          0)
}

// ---- shape rejections ----------------------------------------------------

fn test_sig_wrong_length() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    // Sig 63 bytes.
    let sig_short = list_new()
    let i = 0
    while i < 63 { push(sig_short, sig[i]); i = i + 1 }
    ce_eq("63-byte CertVerify sig rejected",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig_short),
          0)
    // Sig 65 bytes.
    let sig_long = list_new()
    let j = 0
    while j < 64 { push(sig_long, sig[j]); j = j + 1 }
    push(sig_long, 0)
    ce_eq("65-byte CertVerify sig rejected",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig_long),
          0)
}

fn test_bad_transcript_len() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    ce_eq("negative transcript_hash_len rejected",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 0 - 1,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
    ce_eq("oversized transcript_hash_len rejected",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 33,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
}

fn test_tampered_transcript() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    // Tampered transcript: flip a bit in the first byte.
    let transcript = _tcc_transcript()
    let bad = list_new()
    let i = 0
    let n = len(transcript)
    while i < n { push(bad, transcript[i]); i = i + 1 }
    list_set(bad, 0, int_xor(bad[0], 4))
    ce_eq("tampered transcript -> fails",
          tls_cert_verify_chain_and_signature(leaf, len(leaf),
                                              root, len(root),
                                              _TCC_NOW,
                                              bad, 32,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
}

fn test_tampered_leaf_cert_but_valid_sig() {
    let root = _tcc_root()
    let leaf = _tcc_leaf()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    // Flip a byte in the leaf cert's TBS body (bit deep in the middle).
    let p = x509_parsed_new()
    x509_parse(leaf, len(leaf), p)
    let mid = x509_parsed_tbs_off(p) + int_div(x509_parsed_tbs_len(p), 2)
    let tampered = list_new()
    let i = 0
    let n = len(leaf)
    while i < n { push(tampered, leaf[i]); i = i + 1 }
    list_set(tampered, mid, int_xor(tampered[mid], 1))
    ce_eq("tampered leaf TBS -> fails at chain verify",
          tls_cert_verify_chain_and_signature(tampered, len(tampered),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
}

fn test_self_signed_leaf_refused() {
    // If the caller hands the same cert as both leaf and root, the
    // chain verify must refuse -- there is no separately-trusted root.
    let root = _tcc_root()
    let sig = _tcc_sign_certverify(TLS_CERT_ROLE_SERVER)
    let transcript = _tcc_transcript()
    ce_eq("leaf byte-equal to root -> fails",
          tls_cert_verify_chain_and_signature(root, len(root),
                                              root, len(root),
                                              _TCC_NOW,
                                              transcript, 32,
                                              TLS_CERT_ROLE_SERVER, sig),
          0)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_happy_server()
    test_happy_client()
    test_wrong_root()
    test_expired()
    test_tampered_certverify_sig()
    test_wrong_role_flag()
    test_sig_wrong_length()
    test_bad_transcript_len()
    test_tampered_transcript()
    test_tampered_leaf_cert_but_valid_sig()
    test_self_signed_leaf_refused()
    ce_summary("tls_cert_chain")
}

main()
