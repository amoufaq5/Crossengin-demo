// Unit tests for src/io/transducers/audio_dsp.nova (R14E).
//
// Exercises the classical DSP effects leg of the audio chain:
//
//   * Constant accessors (~5 checks)
//   * Reverb on silence -> output silence + correct length (~2 checks)
//   * Reverb on impulse: tail decays past input length (decay-tail
//     non-zero sample count, peak in early region) (~3 checks)
//   * Reverb wet=0: output ~= dry input (RMS within band) (~2 checks)
//   * Reverb wet=1000: output is pure wet (no dry leak at sample 0) (~2)
//   * Reverb on synth vowel: total RMS preserved or boosted (~2)
//   * Noise gate: low-level silence-ish signal attenuated (~2)
//   * Noise gate: high-level signal passes unchanged (~2)
//   * Noise gate: attack/release ramps gain (no instantaneous step) (~2)
//   * Noise gate threshold=0: passes everything through (~1)
//   * Combined reverb+gate (chain): order preserved, output non-empty (~2)
//   * Compressor: peak attenuated above threshold (~2)
//   * Compressor: below-threshold signal passes through (~1)
//   * dsp_rms: bench against known sine RMS (~2)
//
// Total: ~30 assertions. Honours the ce_test convention (no "FAIL"
// token on the success path; exit 1 if any check fails).

import "../ce_test.nova"
import "../../src/io/transducers/audio_dsp.nova"
import "../../src/io/effectors/audio_synth.nova"

// ---- fixture builders ----------------------------------------------------

fn _zero_buf(n) {
    let b = list_new()
    let i = 0
    while i < n {
        push(b, 0)
        i = i + 1
    }
    return b
}

// A unit-impulse signal: 1 at index 0, then n-1 zeros. We use peak PCM16
// (16000) as the impulse height so the reverb tail registers in the same
// units as a Klatt vowel.
fn _impulse(n) {
    let b = _zero_buf(n)
    list_set(b, 0, 16000)
    return b
}

// Constant-amplitude signal at +/- amp PCM16 units. The square wave at
// `amp` gives a known RMS == amp, which exercises the envelope without the
// numerical artifacts of a sine table.
fn _square(amp, n) {
    let b = list_new()
    let i = 0
    while i < n {
        if (i - (i / 2) * 2) == 0 {
            push(b, amp)
        } else {
            push(b, 0 - amp)
        }
        i = i + 1
    }
    return b
}

// Count non-zero samples in a region.
fn _count_nonzero(pcm, lo, hi) {
    let n = len(pcm)
    let a = lo
    let b = hi
    if a < 0 { a = 0 }
    if b > n { b = n }
    let cnt = 0
    let i = a
    while i < b {
        if pcm[i] != 0 { cnt = cnt + 1 }
        i = i + 1
    }
    return cnt
}

fn _max_abs(pcm) {
    let n = len(pcm)
    let m = 0
    let i = 0
    while i < n {
        let v = pcm[i]
        if v < 0 { v = 0 - v }
        if v > m { m = v }
        i = i + 1
    }
    return m
}

// ---- constants -----------------------------------------------------------

fn test_dsp_constants() {
    ce_eq("reverb wet default = 300",   dsp_reverb_wet_default(),   300)
    ce_eq("reverb room default = 600",  dsp_reverb_room_default(),  600)
    ce_eq("gate threshold default = 100", dsp_gate_threshold_default(), 100)
    ce_eq("gate ratio default = 1000",    dsp_gate_ratio_default(),     1000)
    ce_eq("gate attack default = 5 ms",   dsp_gate_attack_ms_default(),  5)
    ce_eq("gate release default = 50 ms", dsp_gate_release_ms_default(), 50)
    ce_eq("max samples = 480000",         dsp_max_samples(), 480000)
    ce_eq("reverb tail = 400 ms",         dsp_reverb_tail_ms(), 400)
    ce_eq("full scale = 32767",           dsp_full_scale(), 32767)
}

// ---- reverb on silence ---------------------------------------------------

fn test_reverb_silence_in_silence_out() {
    let s = _zero_buf(4800)
    let out = dsp_reverb(s, 16000, 300, 600)
    // tail = 400 ms @ 16k = 6400 samples
    ce_eq("reverb(silence): out length == in + tail", len(out), 4800 + 6400)
    let m = _max_abs(out)
    ce_eq("reverb(silence): output is all zeros", m, 0)
}

// ---- reverb on impulse ---------------------------------------------------

fn test_reverb_impulse_decay_tail() {
    // 500 ms input @ 8 kHz with an impulse at sample 0 gives us enough
    // headroom for all four combs to fire repeatedly (delays scale with
    // sr: 5963*8000/16000=2981 etc., so all 4 fit in 4000 samples) and
    // the allpasses to smear the bursts into a decay envelope. Smaller
    // fixture keeps the NOVA arena footprint sane across the suite.
    let s = _impulse(4000)
    let out = dsp_reverb(s, 8000, 1000, 800)   // pure wet, big room
    // The IR has to extend past the input length (the "decay tail" of
    // ~400 ms at 8 kHz = 3200 samples). With 4 comb filters firing
    // repeatedly through the decay, the tail must contain non-zero
    // energy at many positions.
    let tail_nonzero = _count_nonzero(out, len(s), len(out))
    ce_check("reverb impulse: decay tail has > 15 non-zero samples",
             tail_nonzero > 15)
    // Energy decays over time: the peak in the input region is louder
    // than the peak in the last 500 samples of the tail.
    let early_peak = _max_abs_region(out, 0, len(s))
    let late_peak  = _max_abs_region(out, len(out) - 500, len(out))
    ce_check("reverb impulse: early reflections louder than late tail",
             early_peak > late_peak)
    // First comb spike at the smallest delay (cd3=3911*8000/16000=1955
    // @ 8 kHz) must be non-zero -- the impulse-response signature.
    ce_check("reverb impulse: spike at sample 1955 (smallest comb delay)",
             out[1955] != 0)
}

fn _max_abs_region(pcm, lo, hi) {
    let n = len(pcm)
    let a = lo
    let b = hi
    if a < 0 { a = 0 }
    if b > n { b = n }
    let m = 0
    let i = a
    while i < b {
        let v = pcm[i]
        if v < 0 { v = 0 - v }
        if v > m { m = v }
        i = i + 1
    }
    return m
}

// ---- reverb wet=0 (dry only) ---------------------------------------------

fn test_reverb_wet_zero_is_dry() {
    let s = synth_sine(300, 800, 8000)
    let out = dsp_reverb(s, 8000, 0, 600)
    // With wet=0 the first len(s) samples should match s closely (modulo
    // PCM16 clip rounding -- here negligible because the sine peaks at
    // AUDIO_AMPLITUDE=16000 << full scale).
    let i = 0
    let max_diff = 0
    while i < len(s) {
        let d = out[i] - s[i]
        if d < 0 { d = 0 - d }
        if d > max_diff { max_diff = d }
        i = i + 1
    }
    ce_check("reverb wet=0: dry signal preserved (max diff <= 2)",
             max_diff <= 2)
    // Tail with wet=0 must be all zeros: no dry signal to propagate.
    let tail_nonzero = _count_nonzero(out, len(s), len(out))
    ce_eq("reverb wet=0: tail is all zeros", tail_nonzero, 0)
}

// ---- reverb wet=1000 -----------------------------------------------------

fn test_reverb_wet_full_no_dry() {
    // 500 ms input @ 8 kHz ensures all 4 combs fire and the allpass
    // feedback paths populate. Smaller buffer keeps the suite light on
    // the arena across all the reverb-heavy tests.
    let s = _impulse(4000)
    let out = dsp_reverb(s, 8000, 1000, 600)
    // The first comb spike lives at sample cd3 == 1955 @ 8 kHz; the
    // tail past the input length must have at least a few rings from
    // the ongoing combs.
    let tail_rings = _count_nonzero(out, len(s), len(out))
    ce_check("reverb wet=1000: tail rings (non-zero past input)",
             tail_rings > 5)
    ce_eq("reverb wet=1000: total length == in + tail",
          len(out), 4000 + (8000 * 400) / 1000)
}

// ---- reverb on a vowel ---------------------------------------------------

fn test_reverb_vowel_adds_energy() {
    let v = synth_phoneme("ae")
    let dry_rms = dsp_rms(v)
    let out = dsp_reverb(v, 8000, 500, 800)   // 50% wet, big room
    let wet_rms = dsp_rms(out)
    // Sum-of-squares is a more honest "is there more energy here?" test
    // than RMS (which a longer buffer dilutes); we want the IR tail to
    // ADD energy past the dry input.
    let v_sum_sq = _sum_sq(v)
    let out_sum_sq = _sum_sq(out)
    // Compare via int_sub to keep both operands away from the smart-`>'
    // dispatcher (both sums are ~1e10..1e12, above the 1 MB threshold).
    let diff = int_sub(out_sum_sq, v_sum_sq)
    ce_check("reverb vowel: output sum-of-squares > input sum-of-squares",
             diff > 0)
    ce_check("reverb vowel: wet RMS > 0", wet_rms > 0)
}

// Sum of squares over a PCM buffer. PCM16 squared is ~1e9 and the
// running accumulator reaches ~1e12 -- both above NOVA's 1 MB smart-op
// threshold (NOVA_BUG_THRESHOLD.md), so we route the multiply and add
// through int_mul / int_add to stay scalar.
fn _sum_sq(pcm) {
    let n = len(pcm)
    let s = 0
    let i = 0
    while i < n {
        let v = pcm[i]
        s = int_add(s, int_mul(v, v))
        i = i + 1
    }
    return s
}

// ---- noise gate ----------------------------------------------------------

fn test_gate_low_level_attenuated() {
    // Quiet signal: square wave at amp=500 PCM16 (~ -36 dBFS). The
    // default threshold (100 milli = 10% FS ~ 3275 units) is well above
    // this, so the gate should clamp it nearly to zero.
    let s = _square(500, 4800)
    let out = dsp_noise_gate(s, 16000, 100, 1000, 5, 50)
    let in_rms = dsp_rms(s)
    let out_rms = dsp_rms(out)
    ce_check("gate low: input RMS ~ 500 (signal present)",
             in_rms >= 400 && in_rms <= 600)
    // After the release ramp completes, the gate should pull the output
    // RMS far below the input. Allow some leak from the release ramp at
    // the head of the buffer.
    ce_check("gate low: out RMS << in RMS (attenuated by 10x or more)",
             out_rms * 10 < in_rms)
}

fn test_gate_high_level_passes() {
    // Loud signal: square wave at amp=12000 PCM16 (~ -8 dBFS). The
    // default threshold (10% FS) is well below this, so the gate stays
    // open and the output should equal the input bit-for-bit (after the
    // ramp settles -- the gate starts open here because the first
    // envelope sample is already above threshold).
    let s = _square(12000, 4800)
    let out = dsp_noise_gate(s, 16000, 100, 1000, 5, 50)
    let in_rms = dsp_rms(s)
    let out_rms = dsp_rms(out)
    ce_check("gate high: input RMS ~ 12000",
             in_rms >= 11000 && in_rms <= 13000)
    // Output RMS should be within ~10% of input (we permit a small dip
    // because the attack ramp opens the gate from cur=initial cur_gain
    // -- with high-level input the initial gain is 1000 so no ramp at
    // all, output is bit-exact).
    let diff = in_rms - out_rms
    if diff < 0 { diff = 0 - diff }
    ce_check("gate high: output RMS within 10% of input",
             diff * 10 <= in_rms)
}

fn test_gate_attack_release_smooth() {
    // Build a signal that transitions abruptly: 2400 samples of quiet
    // (amp=200) followed by 2400 of loud (amp=12000). The gate must
    // ramp the gain over ~80 samples (5 ms @ 16 kHz) when opening; the
    // transition region must show intermediate magnitudes between
    // attenuated and full-scale rather than an instantaneous step.
    let n = 4800
    let s = list_new()
    let i = 0
    while i < n {
        if i < n / 2 {
            // quiet
            if (i - (i / 2) * 2) == 0 { push(s, 200) }
            else { push(s, 0 - 200) }
        } else {
            // loud
            if (i - (i / 2) * 2) == 0 { push(s, 12000) }
            else { push(s, 0 - 12000) }
        }
        i = i + 1
    }
    let out = dsp_noise_gate(s, 16000, 100, 1000, 10, 100)
    // Sample right at the transition (n/2) should be smaller in magnitude
    // than samples well past the attack window.
    let transition = out[n / 2]
    let settled    = out[n / 2 + 800]    // 50 ms past transition
    let abs_trans = transition
    if abs_trans < 0 { abs_trans = 0 - abs_trans }
    let abs_settled = settled
    if abs_settled < 0 { abs_settled = 0 - abs_settled }
    ce_check("gate attack: transition sample << settled sample (ramp present)",
             abs_trans < abs_settled)
    // And the settled sample should be at near full (loud) input level.
    ce_check("gate attack: settled sample near input level (> 10000)",
             abs_settled > 10000)
}

fn test_gate_threshold_zero_passes_all() {
    // threshold=0 -> every envelope is >= threshold -> gate always open.
    // Output should equal input bit-for-bit.
    let s = _square(2000, 1200)
    let out = dsp_noise_gate(s, 16000, 0, 1000, 5, 50)
    let i = 0
    let max_diff = 0
    while i < len(s) {
        let d = out[i] - s[i]
        if d < 0 { d = 0 - d }
        if d > max_diff { max_diff = d }
        i = i + 1
    }
    ce_check("gate threshold=0: passes input through (max diff <= 2)",
             max_diff <= 2)
}

// ---- combined chain ------------------------------------------------------

fn test_chain_reverb_then_gate() {
    let v = synth_phoneme("ae")
    let wet = dsp_reverb(v, 8000, 300, 600)
    let gated = dsp_noise_gate(wet, 8000, 50, 1000, 5, 50)
    ce_check("chain: reverb non-empty", len(wet) > len(v))
    ce_check("chain: gate preserves reverb length", len(gated) == len(wet))
}

// ---- compressor ----------------------------------------------------------

fn test_compressor_above_threshold_attenuates() {
    // Loud square wave at amp=12000 (~ -8 dBFS). Threshold=100 (10% FS,
    // ~3275 units) is well below; the compressor should attenuate.
    let s = _square(12000, 4800)
    let out = dsp_compressor(s, 16000, 100, 1000, 5, 50)
    let in_rms = dsp_rms(s)
    let out_rms = dsp_rms(out)
    ce_check("compressor: in RMS ~ 12000",
             in_rms >= 11000 && in_rms <= 13000)
    // After the attack ramp closes the compressor, the output RMS should
    // be substantially smaller than the input.
    ce_check("compressor: out RMS < 0.5 * in RMS",
             out_rms * 2 < in_rms)
}

fn test_compressor_below_threshold_passes() {
    // Quiet signal at amp=500 (~ -36 dBFS). Threshold=100 (~3275 units)
    // is well above; the compressor leaves it alone.
    let s = _square(500, 2400)
    let out = dsp_compressor(s, 16000, 100, 1000, 5, 50)
    let in_rms = dsp_rms(s)
    let out_rms = dsp_rms(out)
    let diff = in_rms - out_rms
    if diff < 0 { diff = 0 - diff }
    ce_check("compressor below threshold: output ~ input",
             diff * 20 <= in_rms)
}

// ---- dsp_rms primitive ---------------------------------------------------

fn test_dsp_rms_square_wave() {
    let s = _square(8000, 2400)
    let r = dsp_rms(s)
    // Square wave RMS == amplitude; allow +/- 1 for any rounding.
    ce_check("dsp_rms square 8000: in [7999..8001]",
             r >= 7999 && r <= 8001)
}

fn test_dsp_rms_silence() {
    let s = _zero_buf(2400)
    let r = dsp_rms(s)
    ce_eq("dsp_rms silence = 0", r, 0)
}

fn main() {
    test_dsp_constants()
    test_reverb_silence_in_silence_out()
    test_reverb_impulse_decay_tail()
    test_reverb_wet_zero_is_dry()
    test_reverb_wet_full_no_dry()
    test_reverb_vowel_adds_energy()
    test_gate_low_level_attenuated()
    test_gate_high_level_passes()
    test_gate_attack_release_smooth()
    test_gate_threshold_zero_passes_all()
    test_chain_reverb_then_gate()
    test_compressor_above_threshold_attenuates()
    test_compressor_below_threshold_passes()
    test_dsp_rms_square_wave()
    test_dsp_rms_silence()
    ce_summary("audio_dsp")
}

main()
