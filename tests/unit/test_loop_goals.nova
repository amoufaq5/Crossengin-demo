// Unit tests for src/agent/loop_goals.nova
// Verifies the goals loop runs drives and arbitrates the active goal. ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_goals.nova"

fn test_goals() {
    let engine = goal_engine_new()
    let ctx = ctx_new()
    // Knowledge gap + pending request -> goals spawned, one arbitrated active.
    let best = loop_goals_step(ctx, engine, 800, 100, 2, 100)
    ce_check("goals spawned", goal_count(engine) >= 1)
    ce_check("active goal chosen", best >= 0)
    ce_eq("ctx goal set", ctx_goal(ctx), best)
}

fn main() { test_goals() ce_summary("loop_goals") }
main()
