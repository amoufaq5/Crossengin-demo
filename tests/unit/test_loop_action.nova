// Unit tests for src/agent/loop_action.nova
// Verifies the action loop produces a state-derived utterance and interns its
// words. ADR-0036, ADR-0013.
//
// Phase N R2 (ADR-0093): the loop now delegates to
// `src/parts/action/action_module.nova` via a module-level singleton
// (action_module_singleton_for) keyed on (dl, goal_engine). This suite
// adds byte-identity assertions on the three pre-R2 fixtures and
// verifies that INTENT records now appear in the decision log when the
// module-level wiring slot `_la_dl_slot` is populated.

import "../ce_test.nova"
import "../../src/agent/loop_action.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn handle(kg, id) { let h = list_new(); push(h, kg); push(h, id); return h }

// Reset the module-level singletons between fixtures so each fixture
// runs against a fresh action_module (matches the R1 pattern).
fn _fresh_singletons() {
    _action_module_singleton_reset()
    _la_wiring_reset()
    return 1
}

fn test_action() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    // Comprehended percept -> acknowledgment.
    _fresh_singletons()
    let ctx = ctx_new()
    let p = list_new(); push(p, handle("med", 0))
    ctx_set_percept(ctx, p)
    let out = loop_action_step(ctx, lang)
    ce_str_eq("acknowledged", out, "understood")
    ce_str_eq("ctx output set", ctx_output(ctx), "understood")
    ce_check("output words interned", kg_atom_count(lang) >= 1)
    // Unknown tokens -> not-understood utterance.
    _fresh_singletons()
    let ctx2 = ctx_new()
    ctx_set_unknown(ctx2, 1)
    let out2 = loop_action_step(ctx2, lang)
    ce_check("signals confusion", str_find(out2, "understand") >= 0)
}

// Fixture 1: percept-present -> "understood".
fn test_byte_identity_percept() {
    _fresh_singletons()
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let ctx = ctx_new()
    let p = list_new(); push(p, handle("med", 0))
    ctx_set_percept(ctx, p)
    loop_action_step(ctx, lang)
    ce_str_eq("percept fixture byte-identity",
              ctx_output(ctx), "understood")
}

// Fixture 2: unknown tokens -> "i do not fully understand that yet".
fn test_byte_identity_unknown() {
    _fresh_singletons()
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    loop_action_step(ctx, lang)
    ce_str_eq("unknown fixture byte-identity",
              ctx_output(ctx),
              "i do not fully understand that yet")
}

// Fixture 3: neither -> "i have nothing to say".
fn test_byte_identity_silent() {
    _fresh_singletons()
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let ctx = ctx_new()
    loop_action_step(ctx, lang)
    ce_str_eq("silent fixture byte-identity",
              ctx_output(ctx), "i have nothing to say")
}

// R2 gate wiring: when the daemon-wire slot `_la_dl_slot` is populated,
// a SPEAK loop_action_step writes an INTENT (plus follow-on effector
// records) to the decision log. Uses the module-level wiring hook so
// the 2-arg signature stays intact.
fn test_gate_writes_when_wired() {
    _fresh_singletons()
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let dl = dl_new()
    _la_set_dl(dl)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    let before = dl_count(dl)
    loop_action_step(ctx, lang)
    let after = dl_count(dl)
    ce_check("wired dl grew on SPEAK", (after - before) >= 1)
    // Byte-identity of ctx_output holds even with the log wired.
    ce_str_eq("wired dl still preserves output",
              ctx_output(ctx),
              "i do not fully understand that yet")
    _la_wiring_reset()
    _action_module_singleton_reset()
}

// INTERNAL branch (silent fixture) leaves a wired log untouched.
fn test_gate_silent_no_log_write() {
    _fresh_singletons()
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let dl = dl_new()
    _la_set_dl(dl)
    let ctx = ctx_new()
    let before = dl_count(dl)
    loop_action_step(ctx, lang)
    let after = dl_count(dl)
    ce_eq("silent fixture no log write when wired",
          after - before, 0)
    ce_str_eq("silent fixture output preserved when wired",
              ctx_output(ctx), "i have nothing to say")
    _la_wiring_reset()
    _action_module_singleton_reset()
}

fn main() {
    test_action()
    test_byte_identity_percept()
    test_byte_identity_unknown()
    test_byte_identity_silent()
    test_gate_writes_when_wired()
    test_gate_silent_no_log_write()
    ce_summary("loop_action")
}
main()
