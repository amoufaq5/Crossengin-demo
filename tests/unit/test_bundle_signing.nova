// Unit tests for src/persistence/bundle_signing.nova (R99).
//
// Coverage: sign+verify happy path; tampered bundle refused; wrong pk
// refused; wrong-shape sig refused; empty bundle round-trip; hex
// encode/decode round-trip; env-var loader when unset.

import "../ce_test.nova"
import "../../src/persistence/bundle_signing.nova"
import "../../src/safety/ed25519.nova"
import "../../src/util/str_safe.nova"

// Generate a real (seed, pk) pair via the ed25519 keygen helper. The
// container may block secure_random; the ed25519 module falls back to
// nanotime + LCG when that happens, which is fine for a self-verify
// round-trip test (we're not making a security claim, just testing the
// sign/verify wiring).
let _kp_cache = 0
fn _get_kp() {
    if _kp_cache != 0 { return _kp_cache }
    _kp_cache = ed25519_keygen()
    return _kp_cache
}
fn _mk_seed() { return _get_kp()[0] }
fn _mk_pk_from_seed(seed) { return _get_kp()[1] }

fn _mk_bundle_bytes(s) {
    let out = list_new()
    let i = 0
    while i < len(s) { push(out, char_at(s, i)) i = i + 1 }
    return out
}

fn test_sign_verify_happy() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    ce_eq("pk is 32 bytes", len(pk), 32)
    let bundle = _mk_bundle_bytes("#CROSSENGIN-CHILD-BUNDLE v1\nhello world\n")
    let s = bundle_pkg_sign(bundle, seed, pk)
    ce_eq("sign ok", s[0], 1)
    ce_eq("sig is 64 bytes", len(s[1]), 64)
    let v = bundle_pkg_verify(bundle, s[1], pk)
    ce_eq("verify ok", v[0], 1)
    ce_str_eq("no err", v[1], "")
}

fn test_tampered_bundle_refused() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    let bundle = _mk_bundle_bytes("payload one\n")
    let s = bundle_pkg_sign(bundle, seed, pk)
    // Flip a byte.
    let tampered = list_new()
    let i = 0
    while i < len(bundle) { push(tampered, bundle[i]) i = i + 1 }
    tampered[0] = tampered[0] + 1
    let v = bundle_pkg_verify(tampered, s[1], pk)
    ce_eq("verify refuses tampered", v[0], 0)
    ce_check("err present", len(v[1]) > 0)
}

fn test_wrong_pk_refused() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    let bundle = _mk_bundle_bytes("some payload\n")
    let s = bundle_pkg_sign(bundle, seed, pk)
    // Wrong pk = flip a byte of the true pk.
    let bad_pk = list_new()
    let i = 0
    while i < len(pk) { push(bad_pk, pk[i]) i = i + 1 }
    bad_pk[0] = bad_pk[0] + 1
    let v = bundle_pkg_verify(bundle, s[1], bad_pk)
    ce_eq("verify refuses wrong pk", v[0], 0)
}

fn test_wrong_sig_shape() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    let bundle = _mk_bundle_bytes("data\n")
    let bad_sig = list_new()
    let i = 0
    while i < 40 { push(bad_sig, 0) i = i + 1 }
    let v = bundle_pkg_verify(bundle, bad_sig, pk)
    ce_eq("short sig refused", v[0], 0)
}

fn test_wrong_pk_shape() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    let bundle = _mk_bundle_bytes("data\n")
    let s = bundle_pkg_sign(bundle, seed, pk)
    let short_pk = list_new()
    let i = 0
    while i < 10 { push(short_pk, 0) i = i + 1 }
    let v = bundle_pkg_verify(bundle, s[1], short_pk)
    ce_eq("short pk refused", v[0], 0)
}

fn test_null_signature() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    let bundle = _mk_bundle_bytes("x\n")
    let v = bundle_pkg_verify(bundle, 0, pk)
    ce_eq("null sig refused", v[0], 0)
}

fn test_empty_bundle_signs() {
    let seed = _mk_seed()
    let pk = _mk_pk_from_seed(seed)
    let empty = list_new()
    let s = bundle_pkg_sign(empty, seed, pk)
    ce_eq("empty signs", s[0], 1)
    let v = bundle_pkg_verify(empty, s[1], pk)
    ce_eq("empty verifies", v[0], 1)
}

fn test_bad_seed_shape_refused() {
    let bad_seed = list_new()
    push(bad_seed, 1) push(bad_seed, 2)
    let pk = list_new()
    let i = 0
    while i < 32 { push(pk, 0) i = i + 1 }
    let s = bundle_pkg_sign(_mk_bundle_bytes("x"), bad_seed, pk)
    ce_eq("short seed refused", s[0], 0)
}

fn test_hex_encode_decode_roundtrip() {
    let b = list_new()
    push(b, 0) push(b, 255) push(b, 16) push(b, 171) push(b, 205)
    let hex = bundle_hex_encode(b)
    ce_str_eq("hex render", hex, "00ff10abcd")
    let dec = bundle_hex_decode(hex)
    ce_eq("dec len", len(dec), 5)
    ce_eq("dec[0]", dec[0], 0)
    ce_eq("dec[1]", dec[1], 255)
    ce_eq("dec[4]", dec[4], 205)
}

fn test_hex_decode_malformed() {
    // Odd length.
    ce_eq("odd length refused", bundle_hex_decode("abc"), 0)
    // Non-hex char.
    ce_eq("non-hex refused", bundle_hex_decode("gg"), 0)
}

fn test_fingerprint_stable() {
    let pk = list_new()
    let i = 0
    while i < 32 { push(pk, i) i = i + 1 }
    let fp1 = bundle_signer_fingerprint(pk)
    let fp2 = bundle_signer_fingerprint(pk)
    ce_str_eq("stable", fp1, fp2)
    ce_eq("64-char hex", len(fp1), 64)
}

fn test_env_loader_unset() {
    // In this test we ASSUME the env vars aren't set. Verify the loader
    // returns ok=0 with a descriptive error.
    let r = bundle_signer_load_from_env()
    ce_eq("loader refuses when unset", r[0], 0)
    ce_check("err mentions env",
             find_bytes(r[3], "CROSSENGIN_MOTHER_SIGNER") >= 0)
}

fn main() {
    test_sign_verify_happy()
    test_tampered_bundle_refused()
    test_wrong_pk_refused()
    test_wrong_sig_shape()
    test_wrong_pk_shape()
    test_null_signature()
    test_empty_bundle_signs()
    test_bad_seed_shape_refused()
    test_hex_encode_decode_roundtrip()
    test_hex_decode_malformed()
    test_fingerprint_stable()
    test_env_loader_unset()
    ce_summary("bundle_signing")
}

main()
