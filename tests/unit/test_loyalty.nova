// Unit tests for src/parts/soul/loyalty.nova
// Verifies loyalty levels, ranking by priority, and dominance resolution.
// ADR-0034.

import "../ce_test.nova"
import "../../src/parts/soul/loyalty.nova"

fn test_loyalty() {
    let s = soul_new("A")
    soul_add_loyalty(s, "constitution", 1000)
    soul_add_loyalty(s, "user", 800)
    soul_add_loyalty(s, "tenant", 400)
    ce_eq("three loyalties", soul_loyalty_count(s), 3)
    ce_eq("user level", soul_loyalty_level(s, "user"), 800)
    ce_eq("unknown level 0", soul_loyalty_level(s, "stranger"), 0)
    // Ranking (1 = highest).
    ce_eq("constitution rank 1", soul_loyalty_rank(s, "constitution"), 1)
    ce_eq("user rank 2", soul_loyalty_rank(s, "user"), 2)
    ce_eq("tenant rank 3", soul_loyalty_rank(s, "tenant"), 3)
    // Dominance resolution.
    ce_str_eq("constitution outranks user", soul_loyalty_dominant(s, "user", "constitution"), "constitution")
    ce_str_eq("user outranks tenant", soul_loyalty_dominant(s, "user", "tenant"), "user")
    // Updating a level re-ranks.
    soul_add_loyalty(s, "tenant", 900)
    ce_eq("tenant now rank 2", soul_loyalty_rank(s, "tenant"), 2)
}

fn main() {
    test_loyalty()
    ce_summary("loyalty")
}

main()
