// Unit tests for the P2.4 atom-store hash index.
//
// Verifies the label-hash + kind-bucket indexes inside each KG: O(1)
// amortized label lookup at 1000 atoms (wall-clock under 10ms), the
// hash-collision case (two distinct labels in the same bucket both retrievable),
// the kg_add_atom -> kg_find_atom hit path, the kg_remove_atom -> miss path
// (with the underlying atom still reachable by id so existing callers do not
// blow up), the snapshot rehydration path (`kg_rebuild_index` after a
// `kg_section_apply`-style replay), and 5000-atom cross-KG isolation
// (lookups in one KG do not return atoms from another). The hash function
// itself is exercised for determinism, bucket-distribution sanity, and the
// expected bucket-mask invariant (returned bucket index in [0, LABEL_BUCKETS)).
// ADR-0016, ADR-0049.

import "std/io"
import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"

// ---- hash function determinism & bounds ------------------------------------
fn test_label_hash_determinism() {
    let h1 = label_hash("aspirin")
    let h2 = label_hash("aspirin")
    ce_eq("hash deterministic", h1, h2)
    ce_check("hash non-negative", h1 >= 0)
    ce_check("hash within 15-bit mask", h1 <= 32767)
    // Bucket selection masks to LABEL_BUCKETS.
    let b = label_bucket("aspirin")
    ce_check("bucket within range lo", b >= 0)
    ce_check("bucket within range hi", b < LABEL_BUCKETS)
    // Empty label hashes to the seed; just check it stays in range.
    let h_empty = label_hash("")
    ce_check("empty label hash in range", h_empty >= 0)
    ce_check("empty label hash <= mask", h_empty <= 32767)
    // Different labels should usually hash to different buckets (probabilistic
    // but very likely for distinct ASCII strings).
    let b_a = label_bucket("aspirin")
    let b_b = label_bucket("ibuprofen")
    ce_check("different labels can differ (no crash)", b_a >= 0)
    ce_check("different labels can differ (no crash 2)", b_b >= 0)
}

// ---- index slot presence ---------------------------------------------------
fn test_fresh_kg_has_index() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "test")
    ce_check("fresh kg has label index slot", len(kg) > KG_LABEL_IDX)
    ce_check("fresh kg has kind index slot",  len(kg) > KG_KIND_IDX)
    // Both indexes are non-empty lists (containers).
    let lbl_idx = kg[KG_LABEL_IDX]
    let knd_idx = kg[KG_KIND_IDX]
    ce_eq("label index has LABEL_BUCKETS buckets", len(lbl_idx), LABEL_BUCKETS)
    ce_eq("kind index has ATOM_KIND_COUNT slots",  len(knd_idx), ATOM_KIND_COUNT)
}

// ---- add -> lookup hit -----------------------------------------------------
fn test_add_then_find() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    kg_add_atom(kg, ATOM_FACT, "aspirin", 0)
    let a = kg_find_atom(kg, "aspirin")
    ce_check("lookup hit", a != 0)
    ce_str_eq("hit returns same label", atom_label(a), "aspirin")
    ce_eq("hit has correct kind", atom_kind(a), ATOM_FACT)
    // Missing label is a clean 0.
    ce_eq("lookup miss returns 0", kg_find_atom(kg, "nope"), 0)
}

// ---- mutation: remove -> miss ----------------------------------------------
fn test_remove_then_miss() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let added = kg_add_atom(kg, ATOM_FACT, "ibuprofen", 0)
    ce_check("preremove hit", kg_find_atom(kg, "ibuprofen") != 0)
    let aid = atom_id(added)
    let r = kg_remove_atom(kg, aid)
    ce_eq("remove reported success", r, 1)
    ce_eq("postremove miss", kg_find_atom(kg, "ibuprofen"), 0)
    // The atom is still addressable by id (existing handle callers).
    let still = kg_atom(kg, aid)
    ce_check("atom still reachable by id", still != 0)
    // Removing again is a no-op (idempotent) -- index already empty for that
    // (label, id) pair so the operation succeeds without crashing.
    let r2 = kg_remove_atom(kg, aid)
    ce_check("repeat remove safe", r2 >= 0)
}

// ---- kind index ------------------------------------------------------------
fn test_kind_index_basics() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "k")
    kg_add_atom(kg, ATOM_FACT,    "fact_a", 0)
    kg_add_atom(kg, ATOM_FACT,    "fact_b", 0)
    kg_add_atom(kg, ATOM_CONCEPT, "concept_c", 0)
    kg_add_atom(kg, ATOM_LANG,    "lang_d", 0)
    let facts = kg_atoms_by_kind(kg, ATOM_FACT)
    let concepts = kg_atoms_by_kind(kg, ATOM_CONCEPT)
    let langs = kg_atoms_by_kind(kg, ATOM_LANG)
    let skills = kg_atoms_by_kind(kg, ATOM_SKILL)
    ce_eq("two facts in kind index", len(facts), 2)
    ce_eq("one concept in kind index", len(concepts), 1)
    ce_eq("one lang in kind index", len(langs), 1)
    ce_eq("no skills in kind index", len(skills), 0)
    // Lookup by id stays correct.
    let cid = concepts[0]
    ce_str_eq("concept label match", atom_label(kg_atom(kg, cid)), "concept_c")
}

// ---- hash collision: forced same bucket via labels with identical hash ---
//
// label_hash is a 15-bit value, bucket = h & 255 -> top 7 bits don't choose
// bucket. We just need two labels whose lower 8 bits of the hash match. We
// scan labels for a pair that hashes to the same bucket and verify both are
// findable. With ~30 candidates the birthday math says we'll find a collision
// almost certainly.
fn test_hash_collision() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "col")
    // Use a wide enough name space to find a colliding pair within 200 atoms.
    let pool_size = 200
    let i = 0
    while i < pool_size {
        kg_add_atom(kg, ATOM_FACT, "col_" + int_to_str(i), 0)
        i = i + 1
    }
    // Find two labels that land in the same bucket.
    let target = -1
    let other = -1
    let j = 0
    while j < pool_size {
        if target < 0 {
            let lbl_j = "col_" + int_to_str(j)
            let b_j = label_bucket(lbl_j)
            let k = j + 1
            while k < pool_size {
                let lbl_k = "col_" + int_to_str(k)
                if label_bucket(lbl_k) == b_j {
                    target = j
                    other = k
                    k = pool_size
                }
                k = k + 1
            }
        }
        j = j + 1
    }
    ce_check("found a colliding pair", target >= 0)
    if target >= 0 {
        let lbl_t = "col_" + int_to_str(target)
        let lbl_o = "col_" + int_to_str(other)
        ce_eq("same bucket", label_bucket(lbl_t), label_bucket(lbl_o))
        let a_t = kg_find_atom(kg, lbl_t)
        let a_o = kg_find_atom(kg, lbl_o)
        ce_check("first collider retrievable", a_t != 0)
        ce_check("second collider retrievable", a_o != 0)
        ce_str_eq("first label preserved",  atom_label(a_t), lbl_t)
        ce_str_eq("second label preserved", atom_label(a_o), lbl_o)
        // Removing one doesn't drop the other.
        kg_remove_atom(kg, atom_id(a_t))
        ce_eq("removed collider misses",   kg_find_atom(kg, lbl_t), 0)
        ce_check("partner collider still hits", kg_find_atom(kg, lbl_o) != 0)
    }
}

// ---- O(1) amortized lookup at 1000 atoms (wall-clock fastness) -----------
fn test_lookup_speed_1000_atoms() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "speed")
    let n = 1000
    let i = 0
    while i < n {
        kg_add_atom(kg, ATOM_FACT, "atom_" + int_to_str(i), 0)
        i = i + 1
    }
    ce_eq("inserted n atoms", kg_atom_count(kg), n)
    // Pre-build label strings once so the timed loop only measures the lookup
    // cost (not int_to_str + string concat overhead).
    let labels = list_new()
    let li = 0
    while li < n {
        push(labels, "atom_" + int_to_str(li))
        li = li + 1
    }
    let t0 = nanotime()
    let m = 0
    let hits = 0
    while m < n {
        let a = kg_find_atom(kg, labels[m])
        if a != 0 { hits = hits + 1 }
        m = m + 1
    }
    let t1 = nanotime()
    let elapsed_ms = (t1 - t0) / 1000000
    ce_eq("all 1000 looked up hit", hits, n)
    ce_check("1000 indexed lookups under 100ms", elapsed_ms < 100)
    // Tight bound the brief asked for. Even a slow CI box should be well
    // under this: 1000 hashes + 1000 bucket walks of avg ~4 entries each.
    ce_check("1000 indexed lookups under 50ms (tight)", elapsed_ms < 50)
}

// ---- snapshot rehydrate path -----------------------------------------------
fn test_rebuild_after_snapshot() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "snap")
    kg_add_atom(kg, ATOM_FACT, "alpha", 0)
    kg_add_atom(kg, ATOM_FACT, "beta", 0)
    kg_add_atom(kg, ATOM_CONCEPT, "gamma", 0)
    // Simulate the rehydrate path: clear the index by overwriting with empty
    // buckets, then call kg_rebuild_index to reconstruct from kg_atoms.
    list_set(kg, KG_LABEL_IDX, _new_label_index())
    list_set(kg, KG_KIND_IDX,  _new_kind_index())
    // Before rebuild, the lookup misses (index is empty even though atoms
    // still exist).
    ce_eq("cleared index -> miss", kg_find_atom(kg, "alpha"), 0)
    // Rebuild.
    let rebuilt = kg_rebuild_index(kg)
    ce_eq("rebuild walked all atoms", rebuilt, 3)
    let a = kg_find_atom(kg, "alpha")
    ce_check("post-rebuild hit on alpha", a != 0)
    ce_str_eq("post-rebuild label", atom_label(a), "alpha")
    ce_check("post-rebuild hit on gamma", kg_find_atom(kg, "gamma") != 0)
    // Kind index is repopulated too.
    let facts = kg_atoms_by_kind(kg, ATOM_FACT)
    ce_eq("kind index rebuilt", len(facts), 2)
}

// ---- per-KG isolation under stress (5000 atoms across two KGs) -----------
fn test_per_kg_isolation_stress() {
    let reg = kg_registry_new()
    let kg_a = kg_spawn(reg, "stress_a")
    let kg_b = kg_spawn(reg, "stress_b")
    let n = 2500
    let i = 0
    while i < n {
        kg_add_atom(kg_a, ATOM_FACT, "a_" + int_to_str(i), 0)
        kg_add_atom(kg_b, ATOM_FACT, "b_" + int_to_str(i), 0)
        i = i + 1
    }
    ce_eq("kg_a count", kg_atom_count(kg_a), n)
    ce_eq("kg_b count", kg_atom_count(kg_b), n)
    // A label that exists only in kg_a must not appear in kg_b.
    let probe = "a_1234"
    ce_check("kg_a finds its label", kg_find_atom(kg_a, probe) != 0)
    ce_eq("kg_b misses other-kg label", kg_find_atom(kg_b, probe), 0)
    // Symmetric check.
    let probe_b = "b_42"
    ce_check("kg_b finds its label", kg_find_atom(kg_b, probe_b) != 0)
    ce_eq("kg_a misses other-kg label", kg_find_atom(kg_a, probe_b), 0)
    // Same label in both KGs returns the right one per KG.
    kg_add_atom(kg_a, ATOM_FACT, "shared", 0)
    kg_add_atom(kg_b, ATOM_FACT, "shared", 0)
    let ha = kg_find_atom(kg_a, "shared")
    let hb = kg_find_atom(kg_b, "shared")
    ce_check("kg_a finds shared", ha != 0)
    ce_check("kg_b finds shared", hb != 0)
    ce_str_eq("kg_a shared owns kg_a label", atom_kg(ha), "stress_a")
    ce_str_eq("kg_b shared owns kg_b label", atom_kg(hb), "stress_b")
}

// ---- legacy-snapshot fallback (no index slot, linear scan still works) ---
fn test_legacy_snapshot_fallback() {
    // Hand-build a KG that lacks the index slots, as if rehydrated from an
    // older snapshot before P2.4. The atoms list still works; the lookup
    // path must fall back to a linear scan.
    let kg = list_new()
    push(kg, KG_OBJ_TAG)
    push(kg, "legacy")
    push(kg, 0)
    push(kg, list_new())
    push(kg, 0)
    push(kg, 1)
    // Note: NO KG_LABEL_IDX, NO KG_KIND_IDX.
    let n = atom_new("legacy", 0, ATOM_FACT, "old_atom", 0)
    push(kg[KG_ATOMS], n)
    list_set(kg, KG_NEXTID, 1)
    ce_eq("legacy KG has no index", _kg_has_index(kg), 0)
    // Lookup still finds the atom via linear-scan fallback.
    let a = kg_find_atom(kg, "old_atom")
    ce_check("legacy linear-scan hit", a != 0)
    ce_str_eq("legacy hit label", atom_label(a), "old_atom")
    ce_eq("legacy linear-scan miss", kg_find_atom(kg, "missing"), 0)
    // kg_rebuild_index installs the index in place on a legacy KG.
    kg_rebuild_index(kg)
    ce_check("post-rebuild legacy KG has index", _kg_has_index(kg) == 1)
    let a2 = kg_find_atom(kg, "old_atom")
    ce_check("indexed lookup post-rebuild", a2 != 0)
}

fn main() {
    test_label_hash_determinism()
    test_fresh_kg_has_index()
    test_add_then_find()
    test_remove_then_miss()
    test_kind_index_basics()
    test_hash_collision()
    test_lookup_speed_1000_atoms()
    test_rebuild_after_snapshot()
    test_per_kg_isolation_stress()
    test_legacy_snapshot_fallback()
    ce_summary("atom_store_index")
}

main()
