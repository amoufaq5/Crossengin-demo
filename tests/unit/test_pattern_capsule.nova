// Unit tests for src/capsules/pattern_capsule.nova (R53, ADR-0107).
//
// Covers Pattern + PatternCapsule constructors + accessors, the shared
// tokenizer, the ALL-tokens-present matcher, the registry (lookup /
// register-replaces / is_known / names / count), the sort-by-confidence
// order, capsule-filter behavior, and the shape of the two ship-built-ins.

import "../ce_test.nova"
import "../../src/capsules/pattern_capsule.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _has_str(list, needle) {
    let i = 0
    while i < len(list) {
        if str_eq_bytes(list[i], needle) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- Pattern constructor + accessors -------------------------------------

fn test_pattern_new_1() {
    let p = pcap_new_1("timeout", "check retry path", "src:x", 600)
    ce_eq("1 trigger", len(pcap_triggers(p)), 1)
    ce_eq("trigger word",
          str_eq_bytes(pcap_triggers(p)[0], "timeout"), 1)
    ce_eq("guidance",
          str_eq_bytes(pcap_guidance(p), "check retry path"), 1)
    ce_eq("source",
          str_eq_bytes(pcap_source_tag(p), "src:x"), 1)
    ce_eq("confidence", pcap_confidence(p), 600)
}

fn test_pattern_new_2() {
    let p = pcap_new_2("null", "pointer", "g", "s", 800)
    ce_eq("2 triggers", len(pcap_triggers(p)), 2)
    ce_eq("t1", str_eq_bytes(pcap_triggers(p)[0], "null"),    1)
    ce_eq("t2", str_eq_bytes(pcap_triggers(p)[1], "pointer"), 1)
}

fn test_pattern_new_3() {
    let p = pcap_new_3("off", "by", "one", "g", "s", 700)
    ce_eq("3 triggers", len(pcap_triggers(p)), 3)
}

// ---- PatternCapsule constructor + add ------------------------------------

fn test_pcapsule_empty() {
    let c = pcapsule_new("test_cap", "1.0.0")
    ce_eq("name",     str_eq_bytes(pcapsule_name(c), "test_cap"), 1)
    ce_eq("version",  str_eq_bytes(pcapsule_version(c), "1.0.0"), 1)
    ce_eq("empty",    pcapsule_count(c), 0)
}

fn test_pcapsule_add() {
    let c = pcapsule_new("test_cap", "1.0.0")
    pcapsule_add(c, pcap_new_1("a", "g1", "s", 100))
    pcapsule_add(c, pcap_new_1("b", "g2", "s", 200))
    ce_eq("2 patterns", pcapsule_count(c), 2)
    ce_eq("patterns list len", len(pcapsule_patterns(c)), 2)
}

// ---- tokenizer -----------------------------------------------------------

fn test_tokenize_basic() {
    let ts = pcap_tokenize("Help me fix a null pointer error")
    // Stopwords filtered: "me" is 2 chars (kept), "a" is 1 char (dropped),
    // len < 2 fails the stopword guard.
    // "Help", "me", "fix", "null", "pointer", "error" survive.
    ce_check("has null",     _has_str(ts, "null"))
    ce_check("has pointer",  _has_str(ts, "pointer"))
    ce_check("has error",    _has_str(ts, "error"))
    ce_check("lowercased",   _has_str(ts, "help"))
    ce_check("no capitals",  _has_str(ts, "Help") == 0)
    ce_check("dropped 'a' (1 char)", _has_str(ts, "a") == 0)
}

fn test_tokenize_stopwords() {
    let ts = pcap_tokenize("we will look at the code when the loop hangs")
    // Kept: "we", "look", "at" (len>=2, not on stop-list), "code", "loop", "hangs".
    // Stopped: will, the, when. ("what" intentionally not stopped in the
    // pattern tokenizer -- debug patterns don't false-fire on it.)
    ce_check("has code",  _has_str(ts, "code"))
    ce_check("has loop",  _has_str(ts, "loop"))
    ce_check("has hangs", _has_str(ts, "hangs"))
    ce_check("no will",   _has_str(ts, "will")  == 0)
    ce_check("no when",   _has_str(ts, "when")  == 0)
    ce_check("no the",    _has_str(ts, "the")   == 0)
}

fn test_tokenize_hyphen_preserved() {
    let ts = pcap_tokenize("off-by-one bug")
    // Hyphen is a wordchar in the pattern tokenizer -- "off-by-one" stays
    // as one token, not three.
    ce_check("hyphenated stays whole", _has_str(ts, "off-by-one"))
    ce_check("does NOT split on hyphen", _has_str(ts, "off") == 0)
}

fn test_tokenize_empty() {
    let ts = pcap_tokenize("")
    ce_eq("empty in -> empty out", len(ts), 0)
}

// ---- matcher -------------------------------------------------------------

fn test_matches_all_triggers_present() {
    let p = pcap_new_2("null", "pointer", "g", "s", 800)
    let ts = pcap_tokenize("a null pointer bug")
    ce_eq("matches", pcap_matches(p, ts), 1)
}

fn test_matches_missing_one_trigger_fails() {
    let p = pcap_new_2("null", "pointer", "g", "s", 800)
    let ts = pcap_tokenize("a null value bug")
    ce_eq("no pointer -> no match", pcap_matches(p, ts), 0)
}

fn test_matches_extra_tokens_ok() {
    let p = pcap_new_1("timeout", "g", "s", 500)
    let ts = pcap_tokenize("the network timeout on retry loop")
    ce_eq("extra tokens don't hurt", pcap_matches(p, ts), 1)
}

fn test_matches_empty_triggers_never_fires() {
    // Guard: an accidentally-empty trigger list should NOT match everything.
    let p = pcap_new(list_new(), "g", "s", 900)
    let ts = pcap_tokenize("anything at all")
    ce_eq("empty triggers refuse", pcap_matches(p, ts), 0)
}

// ---- registry: built-ins ------------------------------------------------

fn test_registry_ships_two_builtins() {
    ce_check("at least 2 registered", pattern_registry_count() >= 2)
    let names = pattern_registry_names()
    ce_check("has debug_common", _has_str(names, "debug_common"))
    ce_check("has research_hygiene", _has_str(names, "research_hygiene"))
}

fn test_registry_lookup_known_and_unknown() {
    let known = pattern_registry_lookup("debug_common")
    ce_check("known non-zero", known != 0)
    ce_eq("known name", str_eq_bytes(pcapsule_name(known), "debug_common"), 1)
    let unknown = pattern_registry_lookup("no-such")
    ce_eq("unknown returns 0", unknown, 0)
}

fn test_registry_is_known_flag() {
    ce_eq("debug_common known",     pattern_registry_is_known("debug_common"),     1)
    ce_eq("research_hygiene known", pattern_registry_is_known("research_hygiene"), 1)
    ce_eq("bogus not known",        pattern_registry_is_known("bogus"),            0)
}

fn test_debug_common_shape() {
    let cap = pattern_registry_lookup("debug_common")
    ce_check("has at least 8 patterns", pcapsule_count(cap) >= 8)
    ce_eq("version 1.0.0", str_eq_bytes(pcapsule_version(cap), "1.0.0"), 1)
    // Every pattern must be a well-formed 4-slot list with a
    // populated guidance + source tag + non-zero confidence.
    let ps = pcapsule_patterns(cap)
    let i = 0
    while i < len(ps) {
        let p = ps[i]
        ce_check("guidance non-empty",  len(pcap_guidance(p))    > 0)
        ce_check("source non-empty",    len(pcap_source_tag(p))  > 0)
        ce_check("triggers non-empty",  len(pcap_triggers(p))    > 0)
        ce_check("confidence positive", pcap_confidence(p)       > 0)
        // All debug_common patterns share the same source tag.
        ce_eq("shared source tag",
              str_eq_bytes(pcap_source_tag(p),
                           "src:pattern:debug_common:v1"), 1)
        i = i + 1
    }
}

fn test_research_hygiene_shape() {
    let cap = pattern_registry_lookup("research_hygiene")
    ce_check("has at least 4 patterns", pcapsule_count(cap) >= 4)
    let ps = pcapsule_patterns(cap)
    let i = 0
    while i < len(ps) {
        ce_eq("research tag",
              str_eq_bytes(pcap_source_tag(ps[i]),
                           "src:pattern:research_hygiene:v1"), 1)
        i = i + 1
    }
}

// ---- registry: register-replaces ---------------------------------------

fn test_register_new_capsule_appears() {
    let c = pcapsule_new("test-only-new", "0.1.0")
    pcapsule_add(c, pcap_new_1("xyz", "g", "s", 999))
    let count_before = pattern_registry_count()
    pattern_registry_register(c)
    ce_check("count grew", pattern_registry_count() > count_before)
    let got = pattern_registry_lookup("test-only-new")
    ce_check("looked up", got != 0)
    ce_eq("preserved count", pcapsule_count(got), 1)
}

fn test_register_replaces_by_name() {
    let c1 = pcapsule_new("test-only-replace", "1.0.0")
    pcapsule_add(c1, pcap_new_1("a", "first", "s", 100))
    pattern_registry_register(c1)
    let c2 = pcapsule_new("test-only-replace", "1.0.1")
    pcapsule_add(c2, pcap_new_1("a", "second", "s", 100))
    pcapsule_add(c2, pcap_new_1("b", "third",  "s", 100))
    pattern_registry_register(c2)
    let got = pattern_registry_lookup("test-only-replace")
    ce_eq("version updated",  str_eq_bytes(pcapsule_version(got), "1.0.1"), 1)
    ce_eq("count updated",    pcapsule_count(got), 2)
    ce_eq("guidance from c2", str_eq_bytes(pcap_guidance(pcapsule_patterns(got)[0]), "second"), 1)
}

// ---- registry matcher ---------------------------------------------------

fn test_match_returns_only_matches() {
    let ts = pcap_tokenize("my null pointer bug")
    let ms = pattern_registry_match(ts, list_new())    // no filter
    ce_check("at least one match", len(ms) >= 1)
    let i = 0
    while i < len(ms) {
        // Every returned pattern must actually match.
        ce_eq("returned pattern matches", pcap_matches(ms[i], ts), 1)
        i = i + 1
    }
}

fn test_match_sorted_desc_by_confidence() {
    let ts = pcap_tokenize("null pointer stack overflow timeout")
    let ms = pattern_registry_match(ts, list_new())
    ce_check("multiple matches", len(ms) >= 2)
    let i = 0
    let ok = 1
    while i + 1 < len(ms) {
        if pcap_confidence(ms[i]) < pcap_confidence(ms[i + 1]) { ok = 0 }
        i = i + 1
    }
    ce_eq("sorted desc", ok, 1)
}

fn test_match_capsule_filter_narrows() {
    let ts = pcap_tokenize("single source contradiction null pointer")
    // No filter -> matches from BOTH capsules (research_hygiene + debug_common).
    let all = pattern_registry_match(ts, list_new())
    let seen_debug = 0
    let seen_hyg = 0
    let i = 0
    while i < len(all) {
        if find_bytes(pcap_source_tag(all[i]), "debug_common") >= 0 { seen_debug = 1 }
        if find_bytes(pcap_source_tag(all[i]), "research_hygiene") >= 0 { seen_hyg = 1 }
        i = i + 1
    }
    ce_eq("no-filter sees debug",     seen_debug, 1)
    ce_eq("no-filter sees hygiene",   seen_hyg,   1)
    // Filter to just research_hygiene.
    let f = list_new() push(f, "research_hygiene")
    let hyg = pattern_registry_match(ts, f)
    let j = 0
    while j < len(hyg) {
        ce_check("only research_hygiene tags",
                 find_bytes(pcap_source_tag(hyg[j]), "research_hygiene") >= 0)
        j = j + 1
    }
}

fn test_match_no_matches_empty_result() {
    let ts = pcap_tokenize("alpaca keyboard cable")
    let ms = pattern_registry_match(ts, list_new())
    ce_eq("no matches", len(ms), 0)
}

fn test_match_all_alias() {
    let ts = pcap_tokenize("null pointer bug")
    let a = pattern_registry_match(ts, list_new())
    let b = pattern_registry_match_all(ts)
    ce_eq("same result length", len(a), len(b))
}

// ---- determinism -------------------------------------------------------

fn test_match_deterministic() {
    let ts = pcap_tokenize("null pointer stack overflow timeout")
    let a = pattern_registry_match(ts, list_new())
    let b = pattern_registry_match(ts, list_new())
    ce_eq("same length", len(a), len(b))
    let i = 0
    let all_match = 1
    while i < len(a) {
        if pcap_confidence(a[i]) != pcap_confidence(b[i]) { all_match = 0 }
        if str_eq_bytes(pcap_guidance(a[i]), pcap_guidance(b[i])) == 0 {
            all_match = 0
        }
        i = i + 1
    }
    ce_eq("byte-identical order + content", all_match, 1)
}

fn main() {
    test_pattern_new_1()
    test_pattern_new_2()
    test_pattern_new_3()
    test_pcapsule_empty()
    test_pcapsule_add()
    test_tokenize_basic()
    test_tokenize_stopwords()
    test_tokenize_hyphen_preserved()
    test_tokenize_empty()
    test_matches_all_triggers_present()
    test_matches_missing_one_trigger_fails()
    test_matches_extra_tokens_ok()
    test_matches_empty_triggers_never_fires()
    test_registry_ships_two_builtins()
    test_registry_lookup_known_and_unknown()
    test_registry_is_known_flag()
    test_debug_common_shape()
    test_research_hygiene_shape()
    test_register_new_capsule_appears()
    test_register_replaces_by_name()
    test_match_returns_only_matches()
    test_match_sorted_desc_by_confidence()
    test_match_capsule_filter_narrows()
    test_match_no_matches_empty_result()
    test_match_all_alias()
    test_match_deterministic()
    ce_summary("pattern_capsule")
}

main()
