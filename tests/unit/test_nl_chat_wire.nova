// End-to-end unit test for the NL wire that examples/crossengin_chat.nova
// runs (R48p5). Builds the same registries the chat lazily wires --
// kg_registry + capsule_registry + persona_registry + skill_registry +
// meta_observer -- and calls nl_execute + templater_render in the shape
// the chat's _try_nl helper does. This is the interactive REPL's
// integration coverage without needing a headless-chat harness.

import "../ce_test.nova"
import "../../src/nl/grammar_parser.nova"
import "../../src/nl/executor.nova"
import "../../src/nl/templater.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/persona/persona.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// ---- test harness -- mirror the chat's lazy-init exactly ----------------

// Build the KG registry + seed a couple of KGs with atoms shaped for the
// research skill's topic-token walk.
fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg1 = kg_spawn(reg, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    list_set(a1[A_BELIEF], 0, 8000)
    list_set(a1[A_BELIEF], 1, 2000)                     // mean 800
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    list_set(a2[A_BELIEF], 0, 6000)
    list_set(a2[A_BELIEF], 1, 4000)                     // mean 600
    let kg2 = kg_spawn(reg, "folk_astronomy")
    let a3 = kg_add_atom(kg2, ATOM_FACT, "mars", 0)
    list_set(a3[A_BELIEF], 0, 2000)
    list_set(a3[A_BELIEF], 1, 8000)                     // mean 200
    return reg
}

// Case-insensitive substring: does `hay` contain `needle`? Returns 1/0.
fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// Chat's _try_nl in a testable shape: everything the REPL sets up
// (registries + user_id + now) is passed in explicitly.
fn _run_nl(msg, kgreg, capreg, preg, skill_reg, mo, uid, now) {
    let q = grammar_parse(msg)
    let er = nl_execute(q, kgreg, capreg, preg, skill_reg, mo, uid, now)
    let persona = 0
    if preg != 0 { persona = persona_registry_lookup(preg, uid) }
    return templater_render(er, persona)
}

// ---- tests ---------------------------------------------------------------

// Grammar parse -> RESEARCH -> executor auto-installs research skill
// -> policy walks KGs -> templater renders body + sources + disagreement.
fn test_research_path_end_to_end() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    skill_registry_register(skill_reg, research_skill_manifest())
    let out = _run_nl("what is mars", kgreg, capreg, 0, skill_reg, mo,
                      "owner", 100)
    ce_check("body has topic",     _has(out, "mars"))
    ce_check("sources block",      _has(out, "Sources cited"))
    ce_check("solar_system source", _has(out, "solar_system"))
    ce_check("folk_astronomy source", _has(out, "folk_astronomy"))
    ce_check("disagree warning",   _has(out, "Sources disagree on 'mars'"))
    ce_check("parser in trailer",  _has(out, "parser: grammar"))
    ce_check("confidence line",    _has(out, "Confidence:"))
    ce_check("no refusal",         _has(out, "Refused") == 0)
}

// Grammar parse -> RELATE -> executor composes topic "mars phobos" and
// runs the same research skill.
fn test_relate_kind_hits_research() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    skill_registry_register(skill_reg, research_skill_manifest())
    let out = _run_nl("does mars relate to phobos", kgreg, capreg, 0,
                      skill_reg, mo, "owner", 100)
    ce_check("relate produced answer", len(out) > 0)
    ce_check("body cites something",  _has(out, "Sources cited"))
    ce_check("no NL-layer refusal",   _has(out, "Cannot answer") == 0)
}

// Grammar parse -> admin action (retract) -> executor names it; the
// chat's _nl_dispatch_admin then routes to the existing chat handler.
// This test verifies the ExecutionResult carries the admin action name +
// args, which is what the dispatcher keys on.
fn test_admin_action_named_for_dispatch() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    let q = grammar_parse("retract old_claim")
    let er = nl_execute(q, kgreg, capreg, 0, skill_reg, mo, "owner", 100)
    ce_eq("execution ok",         nl_er_ok(er), 1)
    ce_eq("admin=retract",        str_eq_bytes(nl_er_admin_action(er), "retract"), 1)
    let args = nl_er_admin_args(er)
    ce_eq("1 arg",                len(args), 1)
    ce_eq("label carried",        str_eq_bytes(args[0], "old_claim"), 1)
}

fn test_admin_list_capsules() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    let q = grammar_parse("list capsules")
    let er = nl_execute(q, kgreg, capreg, 0, skill_reg, mo, "owner", 100)
    ce_eq("ok",           nl_er_ok(er), 1)
    ce_eq("admin=capsule_list", str_eq_bytes(nl_er_admin_action(er), "capsule_list"), 1)
    ce_eq("no args",      len(nl_er_admin_args(er)), 0)
}

fn test_admin_skill_run_carries_both_args() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    let q = grammar_parse("run skill research on mars")
    let er = nl_execute(q, kgreg, capreg, 0, skill_reg, mo, "owner", 100)
    ce_eq("ok",              nl_er_ok(er), 1)
    ce_eq("admin=skill_run", str_eq_bytes(nl_er_admin_action(er), "skill_run"), 1)
    let args = nl_er_admin_args(er)
    ce_eq("2 args",          len(args), 2)
    ce_eq("skill name",      str_eq_bytes(args[0], "research"), 1)
    ce_eq("skill arg",       str_eq_bytes(args[1], "mars"), 1)
}

// Grammar rejects garbage -> UNPARSED. The chat's _try_nl returns 0 on
// UNPARSED so the legacy cognition path handles it (no regression risk).
fn test_unparsed_returns_none_signal() {
    let q = grammar_parse("floof floof glorpity")
    ce_eq("kind UNPARSED", sq_kind(q), NLK_UNPARSED)
    // The chat's _try_nl checks specifically for UNPARSED/NONE and
    // returns 0 so cognition still runs.
}

// Grammar treats empty input as NONE. Chat falls through so the existing
// empty-input path (bye / prompt) is unchanged.
fn test_empty_returns_none() {
    let q = grammar_parse("")
    ce_eq("kind NONE", sq_kind(q), NLK_NONE)
}

// Persona style-capsule surfaces in the rendered trailer. Wired through
// the same persona_registry_lookup(preg, uid) call the chat makes.
fn test_style_capsule_surfaces() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    skill_registry_register(skill_reg, research_skill_manifest())
    let preg = persona_registry_new()
    let p = persona_registry_ensure(preg, "owner", 100)
    persona_set_style_capsule(p, "curt_technical", 100)
    let out = _run_nl("what is mars", kgreg, capreg, preg, skill_reg,
                      mo, "owner", 100)
    ce_check("style names capsule", _has(out, "style: curt_technical"))
}

// NL-layer refusal (no skill registry) -> templater renders
// "⚠ Cannot answer: ...", chat prints that and returns 1 (won't fall
// through to cognition). Verifies the refusal shape end-to-end.
fn test_nl_refusal_no_skill_registry() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let out = _run_nl("what is mars", kgreg, capreg, 0, 0, mo, "owner", 100)
    ce_check("cannot answer marker", _has(out, "Cannot answer"))
    ce_check("mentions skill reg",   _has(out, "skill registry"))
}

// Deterministic: same registries + same query -> byte-identical output.
// The chat's replies must be reproducible from the underlying state.
fn test_end_to_end_deterministic() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let skill_reg = skill_registry_new()
    skill_registry_register(skill_reg, research_skill_manifest())
    let a = _run_nl("what is mars", kgreg, capreg, 0, skill_reg, mo,
                    "owner", 100)
    let kgreg2 = _mk_kgreg()
    let capreg2 = capreg_new()
    let mo2 = mo_new()
    let skill_reg2 = skill_registry_new()
    skill_registry_register(skill_reg2, research_skill_manifest())
    let b = _run_nl("what is mars", kgreg2, capreg2, 0, skill_reg2, mo2,
                    "owner", 100)
    ce_check("byte-identical across identical inputs",
             str_eq_bytes(a, b) == 1)
}

fn main() {
    test_research_path_end_to_end()
    test_relate_kind_hits_research()
    test_admin_action_named_for_dispatch()
    test_admin_list_capsules()
    test_admin_skill_run_carries_both_args()
    test_unparsed_returns_none_signal()
    test_empty_returns_none()
    test_style_capsule_surfaces()
    test_nl_refusal_no_skill_registry()
    test_end_to_end_deterministic()
    ce_summary("nl_chat_wire")
}

main()
