// CE_TEST_TIMEOUT: 240
// P-384 point decoding and ECDSA-P384 verification (PR 4c). Signatures
// from openssl 3 with a fresh secp384r1 key over SHA-384, SHA-256 and
// SHA-512 digests (SHA-512 is truncated to its leftmost 384 bits); plus
// tampering, wrong key, r/s range and off-curve point refusals.

import "../ce_test.nova"
import "../../src/safety/p384.nova"
import "std/syscall"
import "std/string"
import "std/io"

let PUB = "04898c43679cd21857a053852cda0ff7840d9e3e9368dae30b8784e21932fa1f2944d4f73966624e75d85f3749c2a240645295be42c5e3cafd58a79ee7d531c2f17f8eccd5bbb8d89d46a142bed97d369e6715a12b7c9f9fab2c7e84ad967637e4"
let NHEX = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"

fn _hv(c) {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn _hexbuf(h) {
    let n = int_shr(len(h), 1)
    let b = alloc(n + 1)
    let i = 0
    while i < n {
        store8(b + i, _hv(char_at(h, int_mul(i, 2))) * 16 + _hv(char_at(h, int_mul(i, 2) + 1)))
        i = i + 1
    }
    store8(b + n, 0)
    return b
}

fn _sig(name, dhex, rhex, shex) {
    let pub = _hexbuf(PUB)
    let d = _hexbuf(dhex)
    let dn = int_shr(len(dhex), 1)
    let r = _hexbuf(rhex)
    let s = _hexbuf(shex)
    ce_eq(name + ": verifies", ecdsa_p384_verify(pub, 97, d, dn, r, s), 1)
    ce_eq(name + ": r and s swapped", ecdsa_p384_verify(pub, 97, d, dn, s, r), 0)
    store8(d, int_xor(load8(d), 1))
    ce_eq(name + ": other digest", ecdsa_p384_verify(pub, 97, d, dn, r, s), 0)
}

fn test_point_decoding() {
    let pub = _hexbuf(PUB)
    ce_check("public key is on the curve", p384_decode_point(pub, 97) != 0)
    ce_check("wrong length refused", p384_decode_point(pub, 65) == 0)
    store8(pub + 96, int_xor(load8(pub + 96), 1))
    ce_check("off-curve point refused", p384_decode_point(pub, 97) == 0)
    let comp = _hexbuf(PUB)
    store8(comp, 2)
    ce_check("compressed point refused", p384_decode_point(comp, 97) == 0)
    let big = _hexbuf(PUB)
    let i = 1
    while i < 49 { store8(big + i, 255) i = i + 1 }
    ce_check("X >= p refused", p384_decode_point(big, 97) == 0)
}

fn test_range() {
    let pub = _hexbuf(PUB)
    let d = _hexbuf("3ddd014f89dcaab1b012b09fbf31101449b2a167f070c54a370d49c4d6e08db6d1837b5e7701e00e2119aac98e3b12c1")
    let s = _hexbuf("5f15674f5e258478e2e3eee48cbb6939c9cde4b8b331da8235d4d3e295d6dd761c626936e5d6c45aa3700d8723d076af")
    let zero = alloc(49)
    let i = 0
    while i < 48 { store8(zero + i, 0) i = i + 1 }
    ce_eq("r = 0 refused", ecdsa_p384_verify(pub, 97, d, 48, zero, s), 0)
    ce_eq("r = n refused", ecdsa_p384_verify(pub, 97, d, 48, _hexbuf(NHEX), s), 0)
    ce_eq("s = 0 refused", ecdsa_p384_verify(pub, 97, d, 48, _hexbuf("2d98376a5cd50b155bf22d094c2c4d3860ce0b56fe3cb7dbea8476eb56bf270625ff10741736c4e608c1290feb1f999c"), zero), 0)
}

fn main() {
    _sig("sha384 #0", "3ddd014f89dcaab1b012b09fbf31101449b2a167f070c54a370d49c4d6e08db6d1837b5e7701e00e2119aac98e3b12c1", "2d98376a5cd50b155bf22d094c2c4d3860ce0b56fe3cb7dbea8476eb56bf270625ff10741736c4e608c1290feb1f999c", "5f15674f5e258478e2e3eee48cbb6939c9cde4b8b331da8235d4d3e295d6dd761c626936e5d6c45aa3700d8723d076af")
    _sig("sha256 #1", "ae024d0e1d9c8e15daabe0a022bf10af9d4c05e688f7f7aa7fff985fdcab62da", "c990fa64ea909848fc3abeff085f05c7d82639a89c663ae0d869ed317ea2eb5411380a8ba84141d70daee4010557cb03", "c9706211f8b85384c6c88b449c674e04fb4e43865194e1c3b4f88849787bce4dd7a73f159da8ff33ad63edd6c20d96d4")
    _sig("sha512 #2", "30048362def55c8f9a001da5f33eb30d44175a1bfc497cac0909c6fc12aa2f9a2efdcf4e2f4c92a9e5432966efafb165e7f3866673cd28ca6d8db5f2d989beac", "b0a1f3374a78c9fd92e9a1f7b71863eaa7cdaa3f575a59ef82b6ea9cf75aa94d1d6c38a6a308cdb1c73b1bbdb877e7c0", "2d4c9cc6fb3e0003443e1c8ba67721a577e1c2daa5fbe4234f16ef905615f3ebf7b5f20d267f622b5256de0b28f38469")
    _sig("sha384 #3", "acb0fb4ab65f756da7d55049d7b9c49b40ec22698a37627eb2729ce7825c8b1198c6b1c644a17df2790f60bbcce543bd", "f1a4d98de6579c98c4271934331db9fe63c2220b28c404ff64670847fe28163f7609877bdb61f7869d9703c9a1390984", "6deea406ee6be1603024094f479c2dc7bc57ce8f0b466335f262f37e2281ed40f694532325dad5e4a7252d38ba17adba")
    _sig("sha256 #4", "57a16d47e95e9a275200a68eab6de1473878cfc9a7a8caf479184bfe9c98b9d8", "e85c087b7cd9afc69abb7ce246130c270c0df0fc74d6e2567d5f3a695dcd1d2a805dd9146ed35cfb688bb7f79b57c4c0", "1457557b6457af9d44cc4c8c3ce4b69756e07f5eef0caaf3a8ddb80ab8c1d1025e06514ab2e7de98ad2180d3883ae54d")
    _sig("sha512 #5", "ef12d3229d09168e0d057543736eba6878f748f34f3aa66a00d9807050c97ac7a4f4be11fafd14a4f089683898783f3df7ee9043c02a3956b5761ed7a55b072d", "8eb419d608dc8b93d79434e2dc1c46d3cb6c68898674fe12305092b9662829e6feb076c15d345c02331b4fa0d19db7a9", "a10f8b9c52c72bb829b4bee6444bf0c4bf96f55156284ea4e5ada2139bb5253676456e000ac060ee34aefeed0eef6b04")
    test_point_decoding()
    test_range()
    ce_summary("p384")
}

main()
