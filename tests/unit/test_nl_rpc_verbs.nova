// Unit tests for src/nl/rpc_verbs.nova (R48p7, ADR-0104 §Component 5).
//
// Covers each of the 12 JSON-RPC verbs with real registries + real
// skill runs, plus the wire envelope (ok/result/error), unknown-verb
// dispatch, missing-arg refusal, JSON escaping, and the RpcContext
// slot accessors.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/nl/query_shape.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/ingest/review_queue.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/util/str_safe.nova"

// ---- test helpers --------------------------------------------------------

// Build a KG registry mirroring test_nl_chat_wire's fixture:
//   solar_system  : mars@800, phobos@600
//   folk_astronomy: mars@200
fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg1 = kg_spawn(reg, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    list_set(a1[A_BELIEF], 0, 8000) list_set(a1[A_BELIEF], 1, 2000)
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    list_set(a2[A_BELIEF], 0, 6000) list_set(a2[A_BELIEF], 1, 4000)
    let kg2 = kg_spawn(reg, "folk_astronomy")
    let a3 = kg_add_atom(kg2, ATOM_FACT, "mars", 0)
    list_set(a3[A_BELIEF], 0, 2000) list_set(a3[A_BELIEF], 1, 8000)
    return reg
}

// Build an RpcContext with all registries wired.
fn _mk_ctx() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, echo_skill_manifest())
    skill_registry_register(sr, research_skill_manifest())
    let preg = persona_registry_new()
    persona_registry_ensure(preg, "owner", 100)
    return rpc_ctx_new(kgreg, capreg, preg, sr, mo, 0, 0, 100)
}

// Case-insensitive substring: does `hay` contain `needle`?
fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// Build a single-arg pair convenience.
fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// ---- envelope + dispatch bookkeeping -------------------------------------

fn test_verb_names_count() {
    // 12 R48p7 + 3 R55 cap-lifecycle + 1 R55.1 skill.install
    // + 2 R55.3 session verbs + 1 R58 ingest.auto_approve
    // + 3 R59 ingest.policy.{list,add,remove}
    // + 2 R62 pattern.{list,install}
    // + 1 R66 ingest.file
    // + 2 R72 ownership.{list,transfer}
    // + 1 R76 session.list
    // + 1 R77 session.delete
    // + 1 R78 admin.rotate_token
    // + 1 R79 admin.set_qps
    // + 1 R81 admin.set_expires
    // + 2 R82 admin.grant_cap / admin.remove_cap
    // + 1 R83 admin.set_revoked
    // + 1 R84 admin.set_holder
    // + 1 R96 nl.metrics
    // + 1 R99 admin.bake_child
    // + 3 R101 user.preference.{set,list,clear} = 41.
    ce_eq("43 verbs", len(rpc_verb_names()), 43)
    // R99: confirm admin.bake_child is present in the enumeration.
    let names38 = rpc_verb_names()
    let saw_bake = 0
    let bi = 0
    while bi < len(names38) {
        if str_eq_bytes(names38[bi], "admin.bake_child") == 1 { saw_bake = 1 }
        bi = bi + 1
    }
    ce_eq("admin.bake_child registered", saw_bake, 1)
    // R96: confirm nl.metrics is present in the enumeration.
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "nl.metrics") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("nl.metrics registered", saw, 1)
    // R101: confirm the three user.preference.* verbs are present.
    let saw_set = 0
    let saw_list = 0
    let saw_clr = 0
    let pj = 0
    while pj < len(names) {
        if str_eq_bytes(names[pj], "user.preference.set")   == 1 { saw_set = 1 }
        if str_eq_bytes(names[pj], "user.preference.list")  == 1 { saw_list = 1 }
        if str_eq_bytes(names[pj], "user.preference.clear") == 1 { saw_clr = 1 }
        pj = pj + 1
    }
    ce_eq("user.preference.set registered",   saw_set,  1)
    ce_eq("user.preference.list registered",  saw_list, 1)
    ce_eq("user.preference.clear registered", saw_clr,  1)
}

fn test_unknown_verb_dispatch() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 0)
    let out = rpc_dispatch("no.such.verb", list_new(), ctx)
    ce_check("wire has ok:false", _has(out, "\"ok\":false"))
    ce_check("names verb",        _has(out, "no.such.verb"))
    ce_check("null result",       _has(out, "\"result\":null"))
}

fn test_ctx_accessors() {
    let kgreg = _mk_kgreg()
    let ctx = rpc_ctx_new(kgreg, 0, 0, 0, 0, 0, 0, 42)
    ce_eq("kgreg round-trip", rpc_ctx_kgreg(ctx), kgreg)
    ce_eq("now round-trip",   rpc_ctx_now(ctx), 42)
}

// ---- nl.ask + nl.parse_only ---------------------------------------------

fn test_nl_ask_end_to_end() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("nl.ask",
        _args2("text", "what is mars", "user_id", "owner"), ctx)
    ce_check("ok true",            _has(out, "\"ok\":true"))
    ce_check("parser=grammar",     _has(out, "\"parser_used\":\"grammar\""))
    ce_check("kind=research",      _has(out, "\"kind\":\"research\""))
    ce_check("templated present",  _has(out, "\"templated_answer\":"))
    ce_check("templated has mars", _has(out, "mars"))
    ce_check("sources cited",      _has(out, "Sources cited"))
}

fn test_nl_ask_missing_text_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("nl.ask", _args1("user_id", "owner"), ctx)
    ce_check("ok false",  _has(out, "\"ok\":false"))
    ce_check("names text", _has(out, "missing arg: text"))
}

fn test_nl_parse_only_returns_query() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("nl.parse_only", _args1("text", "is earth a planet"), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    ce_check("kind=is-a",      _has(out, "\"kind\":\"is-a\""))
    ce_check("parser=grammar", _has(out, "\"parser_used\":\"grammar\""))
    ce_check("earth arg",      _has(out, "\"earth\""))
    ce_check("planet arg",     _has(out, "\"planet\""))
}

fn test_nl_parse_only_unparsed_still_ok() {
    // The verb ok-flag reflects "verb dispatched"; the query itself
    // can be UNPARSED without making the RPC call a failure.
    let ctx = _mk_ctx()
    let out = rpc_dispatch("nl.parse_only", _args1("text", "floof glorp"), ctx)
    ce_check("verb ok",        _has(out, "\"ok\":true"))
    ce_check("kind=unparsed",  _has(out, "\"kind\":\"unparsed\""))
}

// ---- kg.list -------------------------------------------------------------

fn test_kg_list() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("solar_system",    _has(out, "solar_system"))
    ce_check("folk_astronomy",  _has(out, "folk_astronomy"))
}

fn test_kg_list_needs_registry() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 0)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("refuses",        _has(out, "\"ok\":false"))
    ce_check("names KG reg",   _has(out, "no KG registry"))
}

// ---- capsule.list + capsule.install --------------------------------------

fn test_capsule_list_empty() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("ok",         _has(out, "\"ok\":true"))
    ce_check("empty arr",  _has(out, "\"result\":[]"))
}

fn test_capsule_list_with_entry() {
    let ctx = _mk_ctx()
    // Register a capsule directly (bypassing pack ingest).
    let c = capsule_new("medicine", "1.0.0")
    capreg_register(rpc_ctx_capreg(ctx), c)
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("names medicine",     _has(out, "\"name\":\"medicine\""))
    ce_check("version",            _has(out, "\"version\":\"1.0.0\""))
    ce_check("installed=false",    _has(out, "\"installed\":false"))
}

fn test_capsule_install_missing_arg() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("capsule.install", list_new(), ctx)
    ce_check("refuses",  _has(out, "\"ok\":false"))
    ce_check("names name", _has(out, "missing arg: name"))
}

// ---- skill.list + skill.run ---------------------------------------------

fn test_skill_list_lists_both() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("skill.list", list_new(), ctx)
    ce_check("ok",       _has(out, "\"ok\":true"))
    ce_check("echo",     _has(out, "\"name\":\"echo\""))
    ce_check("research", _has(out, "\"name\":\"research\""))
    ce_check("version present", _has(out, "\"version\":"))
    ce_check("description present", _has(out, "\"description\":"))
}

fn test_skill_run_needs_install() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("skill.run",
        _args2("name", "research", "arg", "mars"), ctx)
    ce_check("refused: not installed", _has(out, "not installed"))
}

fn test_skill_run_after_install() {
    let ctx = _mk_ctx()
    let sr = rpc_ctx_skill_reg(ctx)
    let capreg = rpc_ctx_capreg(ctx)
    let mo = rpc_ctx_mo(ctx)
    let kgreg = rpc_ctx_kgreg(ctx)
    let m = skill_registry_manifest(sr, "research")
    let sup = skill_supervisor_new(m, kgreg, capreg, 0, 0, mo, 100)
    skill_registry_install(sr, "research", capreg, sup, 100)
    let out = rpc_dispatch("skill.run",
        _args2("name", "research", "arg", "mars"), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    ce_check("proposal in result",  _has(out, "\"proposal\":"))
    ce_check("atoms array",         _has(out, "\"atoms\":["))
    ce_check("solar_system atom",   _has(out, "\"kg\":\"solar_system\""))
    ce_check("confidence field",    _has(out, "\"confidence\":"))
}

fn test_skill_run_missing_name() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("skill.run", _args1("arg", "mars"), ctx)
    ce_check("refuses",   _has(out, "\"ok\":false"))
    ce_check("names name", _has(out, "missing arg: name"))
}

// ---- persona.show + persona.project -------------------------------------

fn test_persona_show_existing() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("persona.show", _args1("user_id", "owner"), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    ce_check("user_id",        _has(out, "\"user_id\":\"owner\""))
    ce_check("ocean array",    _has(out, "\"ocean\":["))
    ce_check("valence field",  _has(out, "\"valence\":"))
    ce_check("risk_tolerance", _has(out, "\"risk_tolerance\":"))
}

fn test_persona_show_absent() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("persona.show", _args1("user_id", "ghost"), ctx)
    ce_check("refuses",           _has(out, "\"ok\":false"))
    ce_check("names user_id",     _has(out, "no persona for user_id: ghost"))
}

fn test_persona_show_missing_arg() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("persona.show", list_new(), ctx)
    ce_check("names missing user_id", _has(out, "missing arg: user_id"))
}

fn test_persona_project_returns_projection() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("persona.project",
        _args2("user_id", "owner", "proposal", "delete everything permanently"),
        ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("valence_shift",   _has(out, "\"valence_shift\":"))
    ce_check("risk_score",      _has(out, "\"risk_score\":"))
}

fn test_persona_project_missing_proposal() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("persona.project", _args1("user_id", "owner"), ctx)
    ce_check("names missing proposal", _has(out, "missing arg: proposal"))
}

// ---- ingest.review / approve / deny -------------------------------------

fn test_ingest_review_empty_queue() {
    let ctx = _mk_ctx()
    // Wire a review queue into the context.
    let q = rq_new()
    list_set(ctx, RCTX_REVIEW_QUEUE, q)
    let out = rpc_dispatch("ingest.review", list_new(), ctx)
    ce_check("ok",         _has(out, "\"ok\":true"))
    ce_check("empty arr",  _has(out, "\"result\":[]"))
}

fn test_ingest_review_no_queue_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("ingest.review", list_new(), ctx)
    ce_check("refused",         _has(out, "\"ok\":false"))
    ce_check("names review q",  _has(out, "no review queue"))
}

fn test_ingest_deny_missing_id() {
    let ctx = _mk_ctx()
    let q = rq_new()
    list_set(ctx, RCTX_REVIEW_QUEUE, q)
    let out = rpc_dispatch("ingest.deny", _args1("reason", "not credible"), ctx)
    ce_check("names id", _has(out, "missing arg: id"))
}

fn test_ingest_approve_needs_agent() {
    let ctx = _mk_ctx()
    let q = rq_new()
    list_set(ctx, RCTX_REVIEW_QUEUE, q)
    let out = rpc_dispatch("ingest.approve", _args1("id", "1"), ctx)
    ce_check("names ingest agent", _has(out, "no ingest agent"))
}

// ---- JSON escaping -------------------------------------------------------

fn test_json_escaping_in_error() {
    // A verb name with special chars should be echoed safely.
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 0)
    let out = rpc_dispatch("has\"quote", list_new(), ctx)
    ce_check("quote escaped",   _has(out, "has\\\"quote"))
}

fn test_json_escaping_in_ask_text() {
    // Malicious/quoted input must not break the wire.
    let ctx = _mk_ctx()
    let out = rpc_dispatch("nl.parse_only",
        _args1("text", "what is \"mars\"?"), ctx)
    ce_check("verb ok",          _has(out, "\"ok\":true"))
    ce_check("escaped quotes",   _has(out, "what is \\\"mars\\\"?"))
}

// ---- envelope shape (positive control) ----------------------------------

fn test_envelope_shape_ok() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    // {"ok":true,"result":[...],"error":""}
    ce_check("starts with {",      _has(out, "{\"ok\":true"))
    ce_check("has result key",     _has(out, "\"result\":"))
    ce_check("has empty error",    _has(out, "\"error\":\"\""))
}

fn test_envelope_shape_err() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 0)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("ok false",  _has(out, "\"ok\":false"))
    ce_check("null result", _has(out, "\"result\":null"))
    ce_check("has error string", _has(out, "\"error\":\"no"))
}

// ---- deterministic wire -------------------------------------------------

fn test_dispatch_deterministic() {
    let ctx1 = _mk_ctx()
    let ctx2 = _mk_ctx()
    let a = rpc_dispatch("nl.parse_only", _args1("text", "who is einstein"), ctx1)
    let b = rpc_dispatch("nl.parse_only", _args1("text", "who is einstein"), ctx2)
    ce_check("same wire twice", str_eq_bytes(a, b) == 1)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_verb_names_count()
    test_unknown_verb_dispatch()
    test_ctx_accessors()
    test_nl_ask_end_to_end()
    test_nl_ask_missing_text_refuses()
    test_nl_parse_only_returns_query()
    test_nl_parse_only_unparsed_still_ok()
    test_kg_list()
    test_kg_list_needs_registry()
    test_capsule_list_empty()
    test_capsule_list_with_entry()
    test_capsule_install_missing_arg()
    test_skill_list_lists_both()
    test_skill_run_needs_install()
    test_skill_run_after_install()
    test_skill_run_missing_name()
    test_persona_show_existing()
    test_persona_show_absent()
    test_persona_show_missing_arg()
    test_persona_project_returns_projection()
    test_persona_project_missing_proposal()
    test_ingest_review_empty_queue()
    test_ingest_review_no_queue_refuses()
    test_ingest_deny_missing_id()
    test_ingest_approve_needs_agent()
    test_json_escaping_in_error()
    test_json_escaping_in_ask_text()
    test_envelope_shape_ok()
    test_envelope_shape_err()
    test_dispatch_deterministic()
    ce_summary("nl_rpc_verbs")
}

main()
