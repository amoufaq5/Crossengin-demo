// Unit tests for R57 -- per-holder skill.run execution scoping
// (extends R55.2 ownership from LIST visibility to EXECUTION for
// skill.run; skill.list also filtered symmetrically).

import "../ce_test.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/sandbox/capability.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    let kgreg = kg_registry_new()
    kg_spawn(kgreg, "world")
    let capreg = capreg_new()
    let mo = mo_new()
    let sr = skill_registry_new()
    // Two skills registered so scoping has something to distinguish.
    skill_registry_register(sr, echo_skill_manifest())
    skill_registry_register(sr, research_skill_manifest())
    // Install BOTH so skill.run reaches its supervisor path.
    let echo_m = skill_registry_manifest(sr, "echo")
    let echo_sup = skill_supervisor_new(echo_m, kgreg, capreg, 0, 0, mo, 100)
    skill_registry_install(sr, "echo", capreg, echo_sup, 100)
    let research_m = skill_registry_manifest(sr, "research")
    let research_sup = skill_supervisor_new(research_m, kgreg, capreg, 0, 0, mo, 100)
    skill_registry_install(sr, "research", capreg, research_sup, 100)
    return rpc_ctx_new(kgreg, capreg, persona_registry_new(),
                        sr, mo, 0, 0, 100)
}

fn _grant_holder(ctx, holder) {
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "skill_user")
    let t = capability_token_new_roles("tk-" + holder, holder, roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-" + holder)
    return reg
}

fn _mk_args1(k, v) {
    let a = list_new() push(a, rpc_arg_kv(k, v)) return a
}

fn _mk_args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// ---- kind + wrappers ---------------------------------------------------

fn test_skill_kind_registered() {
    let kinds = ownership_kinds()
    let saw = 0
    let i = 0
    while i < len(kinds) {
        if str_eq_bytes(kinds[i], OWN_KIND_SKILL) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("skill kind present", saw, 1)
    ce_eq("skill kind known",
          ownership_is_known_kind(OWN_KIND_SKILL), 1)
}

fn test_skill_wrapper_visibility() {
    let reg = ownership_registry_new()
    // Unset = public.
    ce_eq("unset visible to alice",
          ownership_skill_visible(reg, "echo", "alice"), 1)
    ce_eq("unset visible to anonymous",
          ownership_skill_visible(reg, "echo", ""), 1)
    // Owned = holder-exact.
    ownership_set_skill(reg, "alice_only", "alice")
    ce_eq("alice sees hers",
          ownership_skill_visible(reg, "alice_only", "alice"), 1)
    ce_eq("bob does not",
          ownership_skill_visible(reg, "alice_only", "bob"), 0)
    ce_eq("anonymous does not",
          ownership_skill_visible(reg, "alice_only", ""), 0)
    // Null overlay is backward-compat: everyone sees everything.
    ce_eq("null overlay visible to anyone",
          ownership_skill_visible(0, "alice_only", "bob"), 1)
}

// ---- skill.run: no overlay -> backward-compat pass ---------------------

fn test_skill_run_unfiltered_when_no_overlay() {
    let ctx = _mk_ctx()
    // No overlay wired -> every caller can invoke every installed skill.
    let out = rpc_dispatch("skill.run",
        _mk_args2("name", "echo", "arg", "hello"), ctx)
    ce_check("ok even without holder", _has(out, "\"ok\":true"))
}

// ---- skill.run: overlay set, holder = owner -> pass --------------------

fn test_skill_run_owner_can_invoke() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "echo", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.run",
        _mk_args2("name", "echo", "arg", "hello alice"), ctx)
    ce_check("alice can invoke her skill", _has(out, "\"ok\":true"))
}

// ---- skill.run: overlay set, holder != owner -> refused ---------------

fn test_skill_run_non_owner_refused() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "echo", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.run",
        _mk_args2("name", "echo", "arg", "hello"), ctx)
    ce_check("bob refused",           _has(out, "\"ok\":false"))
    ce_check("names 'not accessible'", _has(out, "not accessible to bob"))
    ce_check("names the skill",       _has(out, "echo"))
}

fn test_skill_run_anonymous_refused_for_owned() {
    // No token grant. Under overlay, anonymous caller refused.
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "echo", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.run",
        _mk_args2("name", "echo", "arg", "x"), ctx)
    ce_check("anonymous refused",        _has(out, "\"ok\":false"))
    ce_check("names 'not accessible'",  _has(out, "not accessible to anonymous"))
}

fn test_skill_run_public_skill_still_open_to_all() {
    // Overlay wired but 'echo' is NOT owned -> everyone can invoke it.
    let ctx = _mk_ctx()
    _grant_holder(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "research", "alice")   // research owned
    rpc_ctx_set_ownership(ctx, overlay)
    // bob can call echo (public/unset).
    let out_echo = rpc_dispatch("skill.run",
        _mk_args2("name", "echo", "arg", "hi"), ctx)
    ce_check("bob invokes public echo", _has(out_echo, "\"ok\":true"))
    // bob cannot call research (owned by alice).
    let out_res = rpc_dispatch("skill.run",
        _mk_args2("name", "research", "arg", "topic"), ctx)
    ce_check("bob refused for owned research",
             _has(out_res, "\"ok\":false"))
    ce_check("refusal names research + bob",
             _has(out_res, "not accessible to bob: research"))
}

// ---- refusal order: ownership BEFORE "not installed" -------------------

fn test_ownership_refusal_takes_precedence_over_not_installed() {
    // An owned skill name that is NOT installed should refuse with
    // "not accessible" first (the caller shouldn't learn whether an
    // owned skill exists at all).
    let ctx = _mk_ctx()
    _grant_holder(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "phantom", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.run",
        _mk_args2("name", "phantom", "arg", "x"), ctx)
    ce_check("refused with not-accessible",
             _has(out, "not accessible to bob"))
    ce_eq("does NOT leak 'not installed'",
          _has(out, "not installed"), 0)
}

// ---- skill.list mirror -------------------------------------------------

fn test_skill_list_filters_by_ownership() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "alice")
    let overlay = ownership_registry_new()
    // echo owned by alice; research owned by bob.
    ownership_set_skill(overlay, "echo",     "alice")
    ownership_set_skill(overlay, "research", "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.list", list_new(), ctx)
    ce_check("alice sees echo",         _has(out, "\"name\":\"echo\""))
    ce_eq("alice does NOT see research",
          _has(out, "\"name\":\"research\""), 0)
}

fn test_skill_list_bob_mirror() {
    let ctx = _mk_ctx()
    _grant_holder(ctx, "bob")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "echo",     "alice")
    ownership_set_skill(overlay, "research", "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.list", list_new(), ctx)
    ce_check("bob sees research",         _has(out, "\"name\":\"research\""))
    ce_eq("bob does NOT see echo",
          _has(out, "\"name\":\"echo\""), 0)
}

fn test_skill_list_anonymous_public_only() {
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "echo", "alice")
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.list", list_new(), ctx)
    // research is unset -> visible; echo is owned -> hidden.
    ce_eq("echo hidden from anonymous",
          _has(out, "\"name\":\"echo\""), 0)
    ce_check("research visible", _has(out, "\"name\":\"research\""))
}

// ---- capability gate composition ---------------------------------------

fn test_capability_gate_still_fires_first() {
    // Under enforcement, an under-capped caller gets the CAP refusal
    // before the ownership check even runs. skill_user (not reader)
    // is needed for skill:run; give reader instead.
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    let overlay = ownership_registry_new()
    ownership_set_skill(overlay, "echo", "alice")  // alice owns echo
    rpc_ctx_set_ownership(ctx, overlay)
    let out = rpc_dispatch("skill.run",
        _mk_args2("name", "echo", "arg", "hi"), ctx)
    // Cap gate refuses FIRST -- alice is the owner but she can't call
    // skill.run without the skill:run cap.
    ce_check("cap refusal first",
             _has(out, "capability required: skill:run"))
    ce_eq("does NOT reach ownership check",
          _has(out, "not accessible"), 0)
}

// ---- main --------------------------------------------------------------

fn main() {
    test_skill_kind_registered()
    test_skill_wrapper_visibility()
    test_skill_run_unfiltered_when_no_overlay()
    test_skill_run_owner_can_invoke()
    test_skill_run_non_owner_refused()
    test_skill_run_anonymous_refused_for_owned()
    test_skill_run_public_skill_still_open_to_all()
    test_ownership_refusal_takes_precedence_over_not_installed()
    test_skill_list_filters_by_ownership()
    test_skill_list_bob_mirror()
    test_skill_list_anonymous_public_only()
    test_capability_gate_still_fires_first()
    ce_summary("skill_run_scoping")
}

main()
