// Unit tests for src/capsules/capsule_dep.nova.

import "../ce_test.nova"
import "../../src/capsules/capsule_dep.nova"

fn test_semver_parse_basic() {
    let v = semver_parse("1.2.3")
    ce_eq("major", v[0], 1)
    ce_eq("minor", v[1], 2)
    ce_eq("patch", v[2], 3)
    ce_eq("no pre", v[3], 0)
}

fn test_semver_parse_prerelease() {
    let v = semver_parse("1.2.3-beta")
    ce_eq("major", v[0], 1)
    ce_eq("minor", v[1], 2)
    ce_eq("patch", v[2], 3)
    ce_eq("has pre", v[3], 1)
}

fn test_semver_parse_zero() {
    let v = semver_parse("0.0.1")
    ce_eq("patch = 1", v[2], 1)
}

fn test_semver_cmp_ordering() {
    ce_eq("1.0.0 < 1.0.1", semver_cmp("1.0.0", "1.0.1"), 0 - 1)
    ce_eq("1.0.1 < 1.1.0", semver_cmp("1.0.1", "1.1.0"), 0 - 1)
    ce_eq("1.1.0 < 2.0.0", semver_cmp("1.1.0", "2.0.0"), 0 - 1)
    ce_eq("2.0.0 > 1.99.99", semver_cmp("2.0.0", "1.99.99"), 1)
    ce_eq("equal", semver_cmp("1.2.3", "1.2.3"), 0)
}

fn test_semver_prerelease_precedence() {
    // 1.2.3-beta < 1.2.3 (release)
    ce_eq("prerel < release", semver_cmp("1.2.3-beta", "1.2.3"), 0 - 1)
    ce_eq("release > prerel", semver_cmp("1.2.3", "1.2.3-beta"), 1)
}

fn test_semver_ge() {
    ce_eq("2.0.0 >= 1.0.0", semver_ge("2.0.0", "1.0.0"), 1)
    ce_eq("1.0.0 >= 1.0.0", semver_ge("1.0.0", "1.0.0"), 1)
    ce_eq("1.0.0 not >= 2.0.0", semver_ge("1.0.0", "2.0.0"), 0)
}

fn _mkadj(entries) {
    // entries is a list of [name, dep_names_list]
    return entries
}

fn test_toposort_leaf_only() {
    let adj = list_new()
    let e = list_new() push(e, "a") push(e, list_new())
    push(adj, e)
    let r = capdep_toposort(adj, "a")
    ce_eq("order len 1", len(r[0]), 1)
    ce_eq("first is a", r[0][0], "a")
    ce_eq("no cycle", len(r[1]), 0)
}

fn test_toposort_linear_chain() {
    // c depends on b depends on a
    let adj = list_new()
    let ea = list_new() push(ea, "a") push(ea, list_new())
    push(adj, ea)
    let eb = list_new() push(eb, "b")
    let ebd = list_new() push(ebd, "a")
    push(eb, ebd)
    push(adj, eb)
    let ec = list_new() push(ec, "c")
    let ecd = list_new() push(ecd, "b")
    push(ec, ecd)
    push(adj, ec)
    let r = capdep_toposort(adj, "c")
    ce_eq("order len 3", len(r[0]), 3)
    ce_eq("leaves-first: a first", r[0][0], "a")
    ce_eq("then b", r[0][1], "b")
    ce_eq("then c", r[0][2], "c")
    ce_eq("no cycle", len(r[1]), 0)
}

fn test_toposort_cycle_detected() {
    // a -> b -> c -> a
    let adj = list_new()
    let ea = list_new() push(ea, "a")
    let ead = list_new() push(ead, "b")
    push(ea, ead)
    push(adj, ea)
    let eb = list_new() push(eb, "b")
    let ebd = list_new() push(ebd, "c")
    push(eb, ebd)
    push(adj, eb)
    let ec = list_new() push(ec, "c")
    let ecd = list_new() push(ecd, "a")
    push(ec, ecd)
    push(adj, ec)
    let r = capdep_toposort(adj, "a")
    ce_check("cycle detected (nonempty)", len(r[1]) > 0)
}

fn test_toposort_diamond() {
    // d depends on b and c; b and c both depend on a.
    let adj = list_new()
    let ea = list_new() push(ea, "a") push(ea, list_new())
    push(adj, ea)
    let eb = list_new() push(eb, "b")
    let ebd = list_new() push(ebd, "a")
    push(eb, ebd)
    push(adj, eb)
    let ec = list_new() push(ec, "c")
    let ecd = list_new() push(ecd, "a")
    push(ec, ecd)
    push(adj, ec)
    let ed = list_new() push(ed, "d")
    let edd = list_new() push(edd, "b") push(edd, "c")
    push(ed, edd)
    push(adj, ed)
    let r = capdep_toposort(adj, "d")
    ce_eq("no cycle", len(r[1]), 0)
    ce_eq("order visits 4", len(r[0]), 4)
    ce_eq("d visited last", r[0][3], "d")
    ce_eq("a visited first", r[0][0], "a")
}

fn main() {
    test_semver_parse_basic()
    test_semver_parse_prerelease()
    test_semver_parse_zero()
    test_semver_cmp_ordering()
    test_semver_prerelease_precedence()
    test_semver_ge()
    test_toposort_leaf_only()
    test_toposort_linear_chain()
    test_toposort_cycle_detected()
    test_toposort_diamond()
    ce_summary("capsule_dep")
}

main()
