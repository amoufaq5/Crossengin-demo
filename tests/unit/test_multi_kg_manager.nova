// Unit tests for src/kg/multi_kg_manager.nova
// Verifies per-domain KG spawn (idempotent), atom storage by id and by label,
// stable (kg_id, atom_id) identity, centroid computation, and graceful
// out-of-range access. ADR-0004, ADR-0016.

import "../ce_test.nova"
import "../../src/kg/multi_kg_manager.nova"

fn test_spawn() {
    let reg = kg_registry_new()
    ce_eq("empty registry", kg_count(reg), 0)
    let med = kg_spawn(reg, "medicine")
    let law = kg_spawn(reg, "law")
    ce_eq("two kgs", kg_count(reg), 2)
    ce_eq("med num id 0", kg_num_id(med), 0)
    ce_eq("law num id 1", kg_num_id(law), 1)
    ce_str_eq("med label", kg_label(med), "medicine")
    // Idempotent: same label returns the same KG.
    let med2 = kg_spawn(reg, "medicine")
    ce_eq("idempotent num id", kg_num_id(med2), 0)
    ce_eq("no new kg", kg_count(reg), 2)
    // Lookup.
    ce_eq("find law num id", kg_num_id(kg_find(reg, "law")), 1)
    ce_eq("find missing -> 0", kg_find(reg, "music"), 0)
    ce_eq("get out of range -> 0", kg_get(reg, 9), 0)
}

fn test_atoms() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let a0 = kg_add_atom(med, ATOM_FACT, "aspirin", 1)
    let a1 = kg_add_atom(med, ATOM_FACT, "ibuprofen", 2)
    ce_eq("atom ids assigned", atom_id(a0), 0)
    ce_eq("second atom id", atom_id(a1), 1)
    ce_eq("count 2", kg_atom_count(med), 2)
    ce_str_eq("atom kg_id is label", atom_kg(a0), "medicine")
    // Retrieval by id and by label.
    ce_str_eq("get by id", atom_label(kg_atom(med, 1)), "ibuprofen")
    ce_str_eq("find by label", atom_label(kg_find_atom(med, "aspirin")), "aspirin")
    ce_eq("missing label -> 0", kg_find_atom(med, "nope"), 0)
    ce_eq("atom out of range -> 0", kg_atom(med, 99), 0)
    // Atoms in different KGs are independent namespaces.
    let law = kg_spawn(reg, "law")
    let l0 = kg_add_atom(law, ATOM_FACT, "tort", 3)
    ce_eq("law atom id resets to 0", atom_id(l0), 0)
    ce_str_eq("law atom kg", atom_kg(l0), "law")
}

fn test_centroid() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    // Empty KG -> zero centroid.
    ce_eq("empty centroid dim0", vec_get(kg_centroid(med), 0), 0)
    let a0 = kg_add_atom(med, ATOM_FACT, "a", 0)
    let a1 = kg_add_atom(med, ATOM_FACT, "b", 0)
    let e0 = vec_new(ATOM_EMBED_DIMS); vec_set(e0, 0, 100); vec_set(e0, 1, 20)
    let e1 = vec_new(ATOM_EMBED_DIMS); vec_set(e1, 0, 50);  vec_set(e1, 1, 40)
    atom_set_embed(a0, e0)
    atom_set_embed(a1, e1)
    let c = kg_centroid(med)
    ce_eq("centroid dim0 mean", vec_get(c, 0), 75)
    ce_eq("centroid dim1 mean", vec_get(c, 1), 30)
}

// P1.5: the generic directed-edge adjacency index.
fn test_edge_index() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "g")
    ce_eq("fresh KG has edge slot", _kg_has_edge_index(kg), 1)
    ce_eq("starts unbuilt", kg_edge_index_built(kg), 0)
    // record edges 100: 1->2, 101: 1->3, 102: 5->2
    kg_edge_add(kg, 100, 1, 2)
    kg_edge_add(kg, 101, 1, 3)
    kg_edge_add(kg, 102, 5, 2)
    let f1 = kg_edges_from(kg, 1)
    ce_eq("two edges from 1", len(f1), 2)
    ce_eq("order: 100 first", f1[0], 100)
    ce_eq("order: 101 second", f1[1], 101)
    ce_eq("one edge from 5", len(kg_edges_from(kg, 5)), 1)
    ce_eq("no edges from 9", len(kg_edges_from(kg, 9)), 0)
    let t2 = kg_edges_to(kg, 2)
    ce_eq("two edges to 2", len(t2), 2)
    ce_eq("no edges to 7", len(kg_edges_to(kg, 7)), 0)
    ce_eq("negative key safe", len(kg_edges_from(kg, 0 - 1)), 0)
    kg_edge_index_mark_built(kg)
    ce_eq("mark built sticks", kg_edge_index_built(kg), 1)
}

// A legacy KG (rehydrated short, before the edge slot existed) must not crash:
// presence check is 0 and lookups return empty until the slot is installed.
fn test_edge_index_legacy_fallback() {
    let short = list_new()
    push(short, KG_OBJ_TAG); push(short, "old"); push(short, 0); push(short, list_new())
    ce_eq("legacy: no edge index", _kg_has_edge_index(short), 0)
    ce_eq("legacy: built is 0", kg_edge_index_built(short), 0)
    ce_eq("legacy: edges_from empty", len(kg_edges_from(short, 1)), 0)
    // kg_edge_add auto-installs the slot in place (auto-grow).
    kg_edge_add(short, 7, 1, 2)
    ce_eq("legacy: installed on add", _kg_has_edge_index(short), 1)
    ce_eq("legacy: edge now present", len(kg_edges_from(short, 1)), 1)
}

fn main() {
    test_spawn()
    test_atoms()
    test_centroid()
    test_edge_index()
    test_edge_index_legacy_fallback()
    ce_summary("multi_kg_manager")
}

main()
