// Unit tests for src/kg/multi_kg_manager.nova
// Verifies per-domain KG spawn (idempotent), atom storage by id and by label,
// stable (kg_id, atom_id) identity, centroid computation, and graceful
// out-of-range access. ADR-0004, ADR-0016.

import "../ce_test.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/cross_kg_references.nova"
import "../../src/parts/reasoning/reasoning_atoms.nova"
import "../../src/kg/episodic.nova"

fn test_spawn() {
    let reg = kg_registry_new()
    ce_eq("empty registry", kg_count(reg), 0)
    let med = kg_spawn(reg, "medicine")
    let law = kg_spawn(reg, "law")
    ce_eq("two kgs", kg_count(reg), 2)
    ce_eq("med num id 0", kg_num_id(med), 0)
    ce_eq("law num id 1", kg_num_id(law), 1)
    ce_str_eq("med label", kg_label(med), "medicine")
    // Idempotent: same label returns the same KG.
    let med2 = kg_spawn(reg, "medicine")
    ce_eq("idempotent num id", kg_num_id(med2), 0)
    ce_eq("no new kg", kg_count(reg), 2)
    // Lookup.
    ce_eq("find law num id", kg_num_id(kg_find(reg, "law")), 1)
    ce_eq("find missing -> 0", kg_find(reg, "music"), 0)
    ce_eq("get out of range -> 0", kg_get(reg, 9), 0)
}

fn test_atoms() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let a0 = kg_add_atom(med, ATOM_FACT, "aspirin", 1)
    let a1 = kg_add_atom(med, ATOM_FACT, "ibuprofen", 2)
    ce_eq("atom ids assigned", atom_id(a0), 0)
    ce_eq("second atom id", atom_id(a1), 1)
    ce_eq("count 2", kg_atom_count(med), 2)
    ce_str_eq("atom kg_id is label", atom_kg(a0), "medicine")
    // Retrieval by id and by label.
    ce_str_eq("get by id", atom_label(kg_atom(med, 1)), "ibuprofen")
    ce_str_eq("find by label", atom_label(kg_find_atom(med, "aspirin")), "aspirin")
    ce_eq("missing label -> 0", kg_find_atom(med, "nope"), 0)
    ce_eq("atom out of range -> 0", kg_atom(med, 99), 0)
    // Atoms in different KGs are independent namespaces.
    let law = kg_spawn(reg, "law")
    let l0 = kg_add_atom(law, ATOM_FACT, "tort", 3)
    ce_eq("law atom id resets to 0", atom_id(l0), 0)
    ce_str_eq("law atom kg", atom_kg(l0), "law")
}

fn test_centroid() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    // Empty KG -> zero centroid.
    ce_eq("empty centroid dim0", vec_get(kg_centroid(med), 0), 0)
    let a0 = kg_add_atom(med, ATOM_FACT, "a", 0)
    let a1 = kg_add_atom(med, ATOM_FACT, "b", 0)
    let e0 = vec_new(ATOM_EMBED_DIMS); vec_set(e0, 0, 100); vec_set(e0, 1, 20)
    let e1 = vec_new(ATOM_EMBED_DIMS); vec_set(e1, 0, 50);  vec_set(e1, 1, 40)
    atom_set_embed(a0, e0)
    atom_set_embed(a1, e1)
    let c = kg_centroid(med)
    ce_eq("centroid dim0 mean", vec_get(c, 0), 75)
    ce_eq("centroid dim1 mean", vec_get(c, 1), 30)
}

// P1.5: the generic directed-edge adjacency index.
fn test_edge_index() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "g")
    ce_eq("fresh KG has edge slot", _kg_has_edge_index(kg), 1)
    ce_eq("starts unbuilt", kg_edge_index_built(kg), 0)
    // record edges 100: 1->2, 101: 1->3, 102: 5->2
    kg_edge_add(kg, 100, 1, 2)
    kg_edge_add(kg, 101, 1, 3)
    kg_edge_add(kg, 102, 5, 2)
    let f1 = kg_edges_from(kg, 1)
    ce_eq("two edges from 1", len(f1), 2)
    ce_eq("order: 100 first", f1[0], 100)
    ce_eq("order: 101 second", f1[1], 101)
    ce_eq("one edge from 5", len(kg_edges_from(kg, 5)), 1)
    ce_eq("no edges from 9", len(kg_edges_from(kg, 9)), 0)
    let t2 = kg_edges_to(kg, 2)
    ce_eq("two edges to 2", len(t2), 2)
    ce_eq("no edges to 7", len(kg_edges_to(kg, 7)), 0)
    ce_eq("negative key safe", len(kg_edges_from(kg, 0 - 1)), 0)
    kg_edge_index_mark_built(kg)
    ce_eq("mark built sticks", kg_edge_index_built(kg), 1)
}

// A legacy KG (rehydrated short, before the edge slot existed) must not crash:
// presence check is 0 and lookups return empty until the slot is installed.
fn test_edge_index_legacy_fallback() {
    let short = list_new()
    push(short, KG_OBJ_TAG); push(short, "old"); push(short, 0); push(short, list_new())
    ce_eq("legacy: no edge index", _kg_has_edge_index(short), 0)
    ce_eq("legacy: built is 0", kg_edge_index_built(short), 0)
    ce_eq("legacy: edges_from empty", len(kg_edges_from(short, 1)), 0)
    // kg_edge_add auto-installs the slot in place (auto-grow).
    kg_edge_add(short, 7, 1, 2)
    ce_eq("legacy: installed on add", _kg_has_edge_index(short), 1)
    ce_eq("legacy: edge now present", len(kg_edges_from(short, 1)), 1)
}

// P1.7: hard atom reclamation removes an atom from every index + the slot.
fn test_reclaim_atom() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "g")
    let a = kg_add_atom(kg, ATOM_FACT, "alpha", 0)     // id 0
    kg_add_atom(kg, ATOM_CONCEPT, "beta", 0)           // id 1
    kg_add_atom(kg, ATOM_FACT, "gamma", 0)             // id 2
    ce_eq("two FACTs before", len(kg_atoms_by_kind(kg, ATOM_FACT)), 2)
    ce_eq("found by label before", atom_id(kg_find_atom(kg, "alpha")), 0)
    ce_eq("freelist empty", kg_freelist_count(kg), 0)
    ce_eq("reclaim returns 1", kg_reclaim_atom(kg, atom_id(a)), 1)
    ce_eq("slot nulled", kg_atom(kg, 0), 0)
    ce_eq("one FACT after", len(kg_atoms_by_kind(kg, ATOM_FACT)), 1)
    ce_eq("gone from label index", kg_find_atom(kg, "alpha"), 0)
    ce_eq("freelist records it", kg_freelist_count(kg), 1)
    ce_eq("reclaim again is noop", kg_reclaim_atom(kg, 0), 0)
    ce_eq("reclaim out-of-range", kg_reclaim_atom(kg, 99), 0)
    ce_eq("survivor still found", atom_id(kg_find_atom(kg, "beta")), 1)
}

// ADR-0079: in-place KG compaction. Builds a KG with operators, a same-KG xref,
// a cross-KG xref into it, custom payloads + embeddings, then reclaims two atoms
// to create holes and compacts. Asserts the holes are gone, ids are dense, FULL
// atom state (payload + embedding) survives the move, and every id-reference
// (operator premise/conclusion, same-KG xref dst, cross-KG xref dst) is remapped.
fn test_kg_compact() {
    let reg = kg_registry_new()
    let kgA = kg_spawn(reg, "A")
    // 6 atoms in A: ids 0..5.
    let a0 = kg_add_atom(kgA, ATOM_FACT, "a0", 0)
    let a1 = kg_add_atom(kgA, ATOM_FACT, "a1", 0)
    let a2 = kg_add_atom(kgA, ATOM_CONCEPT, "a2", 0)
    let a3 = kg_add_atom(kgA, ATOM_FACT, "a3", 0)   // will be reclaimed (hole)
    let a4 = kg_add_atom(kgA, ATOM_CONCEPT, "a4", 0)
    let a5 = kg_add_atom(kgA, ATOM_FACT, "a5", 0)   // will be reclaimed (hole)

    // Give a4 a custom payload + a real embedding to PROVE state survives the move.
    atom_payload_set(a4, "value", 123)
    let e4 = vec_new(ATOM_EMBED_DIMS)
    vec_set(e4, 0, 77)
    vec_set(e4, 3, 42)
    atom_set_embed(a4, e4)

    // Operator: premise a1 -> conclusion a2 (same-KG ids 1 and 2).
    let op = rop_new(kgA, ROP_CAUSAL, atom_id(a1), atom_id(a2), "op_a1_a2", 0)
    // Edge index works pre-compact: operator reachable from premise id 1.
    ce_eq("op reachable pre-compact", len(rk_operators_from(kgA, atom_id(a1))), 1)

    // Same-KG xref: a0 -> a4 (dst is in A, will move).
    let xs = xref_new(a0, a4, XREF_SIMILAR, 900, 0)
    atom_add_xref(a0, xs)

    // Second KG B with an atom carrying a CROSS-KG xref whose dst is a2 in A.
    let kgB = kg_spawn(reg, "B")
    let b0 = kg_add_atom(kgB, ATOM_FACT, "b0", 0)
    let xc = xref_new(b0, a2, XREF_ANALOGICAL, 850, 0)
    atom_add_xref(b0, xc)

    // Reclaim two NON-referenced atoms (a3 id3, a5 id5) -> two holes.
    ce_eq("reclaim a3", kg_reclaim_atom(kgA, atom_id(a3)), 1)
    ce_eq("reclaim a5", kg_reclaim_atom(kgA, atom_id(a5)), 1)
    // 6 base atoms + 1 operator atom = 7 slots; reclaim 2 -> 5 live.
    ce_eq("live count is 5 pre-compact", kg_live_atom_count(kgA), 5)

    // Record the old ids of known survivors for the map assertion below.
    let old_a1 = atom_id(a1)   // 1
    let old_a4 = atom_id(a4)   // 4

    // ---- COMPACT ----
    let map = kg_compact(reg, kgA)

    // No holes: every slot 0..count-1 is non-0.
    let cnt = kg_atom_count(kgA)
    ce_eq("dense count == live count", cnt, 5)
    let i = 0
    let holes = 0
    while i < cnt {
        if kg_atom(kgA, i) == 0 { holes = holes + 1 }
        i = i + 1
    }
    ce_eq("no holes after compact", holes, 0)

    // Slot/id consistency: each atom's A_ID equals its slot.
    let j = 0
    let mism = 0
    while j < cnt {
        if atom_id(kg_atom(kgA, j)) != j { mism = mism + 1 }
        j = j + 1
    }
    ce_eq("A_ID matches slot", mism, 0)

    // STATE PRESERVED: a4 found by label still has its payload + embedding.
    let g4 = kg_find_atom(kgA, "a4")
    ce_eq("a4 survived (found by label)", g4 != 0, 1)
    ce_eq("a4 custom payload intact", atom_payload_get(g4, "value"), 123)
    ce_eq("a4 embedding length intact", len(atom_embed(g4)), ATOM_EMBED_DIMS)
    ce_eq("a4 embedding[0] intact", vec_get(atom_embed(g4), 0), 77)
    ce_eq("a4 embedding[3] intact", vec_get(atom_embed(g4), 3), 42)

    // OPERATOR remapped: premise/conclusion now point at the NEW ids of a1/a2.
    let g1 = kg_find_atom(kgA, "a1")
    let g2 = kg_find_atom(kgA, "a2")
    let gop = kg_find_atom(kgA, "op_a1_a2")
    ce_eq("operator survived", gop != 0, 1)
    ce_eq("premise -> new a1 id", rop_premise(gop), atom_id(g1))
    ce_eq("conclusion -> new a2 id", rop_conclusion(gop), atom_id(g2))
    // Edge index rebuilt: operator reachable from the NEW premise id.
    ce_eq("op reachable from new premise", len(rk_operators_from(kgA, atom_id(g1))), 1)

    // SAME-KG xref dst remapped to a4's new id (the xref still lives on a0).
    let g0 = kg_find_atom(kgA, "a0")
    let sx = atom_xrefs(g0)[0]
    ce_eq("same-KG xref dst -> new a4 id", xref_dst_atom(sx), atom_id(g4))

    // CROSS-KG xref (in B, dst into A) remapped to a2's new id.
    let cx = atom_xrefs(b0)[0]
    ce_eq("cross-KG xref dst -> new a2 id", xref_dst_atom(cx), atom_id(g2))

    // Returned map: known survivor old->new, and a hole old->(0-1).
    ce_eq("map a1: old->new", map[old_a1], atom_id(g1))
    ce_eq("map a4: old->new", map[old_a4], atom_id(g4))
    ce_eq("map hole id3 -> -1", map[3], 0 - 1)
    ce_eq("map hole id5 -> -1", map[5], 0 - 1)
    ce_eq("map padded to old len", len(map), 7)
}

// ADR-0079: episodic_remap_members rewrites a cluster's bare atom ids through
// the old->new map, dropping members whose atom was reclaimed (maps to 0-1).
fn test_episodic_remap_members() {
    let eas = episodic_atoms_new()
    // One cluster referencing atoms [0, 2, 4].
    let members = list_new()
    push(members, 0); push(members, 2); push(members, 4)
    episodic_atoms_mint(eas, members, 5, 0, 0, "test")
    // Compact-style map: {0->0, 2->1, 4->(0-1) dropped}.
    let map = list_new()
    push(map, 0)        // old 0 -> 0
    push(map, 0 - 1)    // old 1 -> hole
    push(map, 1)        // old 2 -> 1
    push(map, 0 - 1)    // old 3 -> hole
    push(map, 0 - 1)    // old 4 -> hole (dropped)
    let changed = episodic_remap_members(eas, map)
    ce_eq("one cluster changed length", changed, 1)
    let ep = episodic_atoms_get(eas, 0)
    let m = episodic_atom_members(ep)
    ce_eq("members shrank to 2", len(m), 2)
    ce_eq("member 0 remapped", m[0], 0)
    ce_eq("member 2 remapped to 1", m[1], 1)
}

fn main() {
    test_spawn()
    test_atoms()
    test_centroid()
    test_edge_index()
    test_edge_index_legacy_fallback()
    test_reclaim_atom()
    test_kg_compact()
    test_episodic_remap_members()
    ce_summary("multi_kg_manager")
}

main()
