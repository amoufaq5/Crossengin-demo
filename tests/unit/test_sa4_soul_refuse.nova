// CE_TEST_TIMEOUT: 240
// Refusal tests for src/learning/sa4_soul.nova (A2.2a): every check a soul
// makes on what the coordinator sends. Each scenario drives N = 3 souls
// (t = 3) to a phase with an honest in-memory coordinator, then hands the
// first soul (id 7) a tampered batch. A refusal must end the round with
// one SA4_ABORT line carrying the right code, and nothing after it.
// Signatures repeat across scenarios (same seeds, same round), so the
// shared vcache keeps the cost to one round plus the deliberate bad
// signatures.

import "../ce_test.nova"
import "../sa4_harness.nova"

let RF_R = 5

// [souls, advs, shares, ys, sigs]; upto: 1 ADV, 2 shares, 3 y, 4 sig3.
fn rf_drive(roster, vc, upto) {
    let souls = sa4h_souls(roster, 3, RF_R, vc, 4)
    let advs = list_new()
    let shares = list_new()
    let ys = list_new()
    let sigs = list_new()
    let rl = sa4h_round_line(roster, RF_R)
    let i = 0
    while i < 3 {
        advs = sa4h_cat(advs, sa4h_feed(souls[i], sa4h_one(rl))[1])
        i = i + 1
    }
    if upto >= 2 {
        let s1 = sa4w_fmt_set(RF_R, 1, sa4w_bitmap([1, 2, 3]))
        i = 0
        while i < 3 {
            shares = sa4h_cat(shares, sa4h_filter(sa4h_feed(souls[i], sa4h_cat(advs, sa4h_one(s1)))[1], "SA4_SHARE "))
            i = i + 1
        }
    }
    if upto >= 3 {
        let s2 = sa4w_fmt_set(RF_R, 2, sa4w_bitmap([1, 2, 3]))
        i = 0
        while i < 3 {
            let me = SA4H_IDS[i]
            let mine = list_new()
            let j = 0
            while j < len(shares) {
                if sa4w_parse(shares[j])[3] == me { push(mine, shares[j]) }
                j = j + 1
            }
            push(mine, s2)
            ys = sa4h_cat(ys, sa4h_filter(sa4h_feed(souls[i], mine)[1], "SA4_Y "))
            i = i + 1
        }
    }
    if upto >= 4 {
        let s3 = sa4w_fmt_set(RF_R, 3, sa4w_bitmap([1, 2, 3]))
        i = 0
        while i < 3 {
            sigs = sa4h_cat(sigs, sa4h_feed(souls[i], sa4h_one(s3))[1])
            i = i + 1
        }
    }
    return [souls, advs, shares, ys, sigs]
}

// Feed lines to soul 0 and check it refuses with `code`.
fn rf_expect(label, soul0, lines, code) {
    let f = sa4h_feed(soul0, lines)
    ce_eq(label + ": refused", f[0], 0)
    let outs = f[1]
    let last = ""
    if len(outs) > 0 { last = outs[len(outs) - 1] }
    let want = "SA4_ABORT " + int_to_str(RF_R) + " 7 " + code
    if str_eq_bytes(last, want) == 0 {
        if str_eq_bytes(last, "SA4_ABORT 0 7 " + code) == 0 {
            ce_check(label + ": abort line '" + want + "' (got '" + last + "', " + f[2] + ")", 0)
            return 0
        }
    }
    ce_check(label + ": abort line", 1)
    ce_eq(label + ": state aborted", sa4s_state(soul0), SA4S_ST_ABORTED)
    ce_eq(label + ": secrets wiped", sa4h_wiped(soul0), 1)
    ce_eq(label + ": held shares wiped", soul0[19], 0)
    let after = sa4s_handle(soul0, sa4w_fmt_set(RF_R, 1, sa4w_bitmap([1, 2, 3])))
    ce_eq(label + ": silent after abort", len(after[2]), 0)
    return 0
}

fn rf_adv_line(advs, i, cpk, spk, sig) {
    return rf_adv_line2(advs, i, cpk, spk, sig, 0, 0)
}

fn rf_adv_line2(advs, i, cpk, spk, sig, bcm, mroot) {
    let p = sa4w_parse(advs[i])
    let c = p[3]
    let s = p[4]
    let g = p[5]
    let bb = p[6]
    let mm = p[7]
    if cpk != 0 { c = cpk }
    if spk != 0 { s = spk }
    if sig != 0 { g = sig }
    if bcm != 0 { bb = bcm }
    if mroot != 0 { mm = mroot }
    return sa4w_fmt_adv(p[1], p[2], c, s, g, bb, mm)
}

fn rf_list3(a, b, c) {
    let l = list_new()
    push(l, a)
    push(l, b)
    push(l, c)
    return l
}

fn rf_fresh(roster, vc, last) {
    let e = sroster_entries(roster)[0]
    let s = sa4s_new(roster, e, ed25519_hex_to_bytes(SA4H_SEEDS[0]), sa4h_rng(7, RF_R), vc, last)
    sa4s_set_input(s, sa4h_input(0, SA4H_L), sa4h_layout())
    return s
}

fn test_round_refusals(roster, vc) {
    let fp = sa4w_unhex(sroster_fingerprint(roster), 32)
    let fp2 = sa4w_unhex(sroster_fingerprint(roster), 32)
    list_set(fp2, 0, int_xor(fp2[0], 1))
    rf_expect("wrong fingerprint", rf_fresh(roster, vc, 4), sa4h_one(sa4w_fmt_round(RF_R, fp2, SA4H_L, sa4h_layout())), "bad_fp")
    rf_expect("round equal to last", rf_fresh(roster, vc, 5), sa4h_one(sa4h_round_line(roster, RF_R)), "stale_round")
    rf_expect("round before last", rf_fresh(roster, vc, 9), sa4h_one(sa4h_round_line(roster, RF_R)), "stale_round")
    rf_expect("length differs", rf_fresh(roster, vc, 4), sa4h_one(sa4w_fmt_round(RF_R, fp, SA4H_L + 1, sa4h_layout())), "bad_len")
    let lay2 = sa4h_layout()
    list_set(lay2, 5, int_xor(lay2[5], 128))
    rf_expect("layout differs", rf_fresh(roster, vc, 4), sa4h_one(sa4w_fmt_round(RF_R, fp, SA4H_L, lay2)), "bad_layout")
    let bare = sa4s_new(roster, sroster_entries(roster)[0], ed25519_hex_to_bytes(SA4H_SEEDS[0]), sa4h_rng(7, RF_R), vc, 4)
    rf_expect("no input", bare, sa4h_one(sa4h_round_line(roster, RF_R)), "no_input")
    rf_expect("SET before ROUND", rf_fresh(roster, vc, 4), sa4h_one(sa4w_fmt_set(RF_R, 1, sa4w_bitmap([1]))), "unexpected")
    rf_expect("malformed line", rf_fresh(roster, vc, 4), sa4h_one("SA4_ROUND  5"), "bad_line")
    let s = rf_fresh(roster, vc, 4)
    ce_eq("input refused once started", sa4s_set_input(s, list_new(), sa4h_layout())[0], 0)
    ce_eq("word 2^32 refused", sa4s_set_input(sa4s_new(roster, sroster_entries(roster)[0], ed25519_hex_to_bytes(SA4H_SEEDS[0]), sa4h_rng(7, RF_R), vc, 4), [4294967296], sa4h_layout())[0], 0)
    ce_eq("negative word refused", sa4s_set_input(sa4s_new(roster, sroster_entries(roster)[0], ed25519_hex_to_bytes(SA4H_SEEDS[0]), sa4h_rng(7, RF_R), vc, 4), [0 - 1], sa4h_layout())[0], 0)
    return 0
}

fn test_u1_refusals(roster, vc) {
    let t3 = sa4w_bitmap([1, 2, 3])
    let s1 = sa4w_fmt_set(RF_R, 1, t3)
    let d = rf_drive(roster, vc, 1)
    let a = d[1]
    rf_expect("|U1| < t", rf_drive(roster, vc, 1)[0][0], sa4h_cat(sa4h_cat(sa4h_one(a[0]), sa4h_one(a[1])), sa4h_one(sa4w_fmt_set(RF_R, 1, sa4w_bitmap([1, 2])))), "u1_small")
    rf_expect("ADV lines short of U1", rf_drive(roster, vc, 1)[0][0], sa4h_cat(sa4h_cat(sa4h_one(a[0]), sa4h_one(a[1])), sa4h_one(s1)), "bad_set")
    rf_expect("bit above N", rf_drive(roster, vc, 1)[0][0], sa4h_cat(a, sa4h_one(sa4w_fmt_set(RF_R, 1, sa4w_bitmap([1, 2, 3, 4])))), "bad_set")
    let p2 = sa4w_parse(a[2])
    let unknown = sa4w_fmt_adv(RF_R, 9, p2[3], p2[4], p2[5], p2[6], p2[7])
    rf_expect("ADV from an unknown id", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], a[1], unknown), sa4h_one(s1)), "bad_adv")
    rf_expect("duplicate ADV", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], a[1], a[1]), sa4h_one(s1)), "bad_adv")
    let p1 = sa4w_parse(a[1])
    rf_expect("own ADV altered", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(rf_adv_line(a, 0, p1[3], 0, 0), a[1], a[2]), sa4h_one(s1)), "bad_adv")
    // v4-sa2: the own ADV's share commitments must come back unchanged too.
    rf_expect("own ADV with B altered", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(rf_adv_line2(a, 0, 0, 0, 0, p1[6], 0), a[1], a[2]), sa4h_one(s1)), "bad_adv")
    rf_expect("own ADV with M altered", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(rf_adv_line2(a, 0, 0, 0, 0, 0, p1[7]), a[1], a[2]), sa4h_one(s1)), "bad_adv")
    // A peer's B or M altered in transit: its ADV signature (which covers
    // both) no longer verifies.
    rf_expect("peer ADV with B altered", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], rf_adv_line2(a, 1, 0, 0, 0, sa4w_parse(a[2])[6], 0), a[2]), sa4h_one(s1)), "bad_sig")
    rf_expect("peer ADV with M altered", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], rf_adv_line2(a, 1, 0, 0, 0, 0, sa4w_parse(a[2])[7]), a[2]), sa4h_one(s1)), "bad_sig")
    rf_expect("peer with c_pk == s_pk", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], rf_adv_line(a, 1, 0, p1[3], 0), a[2]), sa4h_one(s1)), "dup_key")
    rf_expect("two souls share a key", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], a[1], rf_adv_line(a, 2, p1[3], 0, 0)), sa4h_one(s1)), "dup_key")
    let zero = list_new()
    let k = 0
    while k < 32 {
        push(zero, 0)
        k = k + 1
    }
    rf_expect("low-order peer key", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], rf_adv_line(a, 1, zero, 0, 0), a[2]), sa4h_one(s1)), "bad_key")
    let sig = sa4w_parse(a[2])[5]
    list_set(sig, 10, int_xor(sig[10], 4))
    rf_expect("bad ADV signature", rf_drive(roster, vc, 1)[0][0], sa4h_cat(rf_list3(a[0], a[1], rf_adv_line(a, 2, 0, 0, sig)), sa4h_one(s1)), "bad_sig")
    rf_expect("ADV for another round", rf_drive(roster, vc, 1)[0][0], sa4h_one(sa4w_fmt_adv(RF_R + 1, p1[2], p1[3], p1[4], p1[5], p1[6], p1[7])), "bad_round")
    rf_expect("ROUND twice", rf_drive(roster, vc, 1)[0][0], sa4h_one(sa4h_round_line(roster, RF_R)), "unexpected")
    rf_expect("too many ADV lines", rf_drive(roster, vc, 1)[0][0], sa4h_cat(a, sa4h_one(a[0])), "bad_adv")
    rf_expect("SET 2 instead of SET 1", rf_drive(roster, vc, 1)[0][0], sa4h_cat(a, sa4h_one(sa4w_fmt_set(RF_R, 2, t3))), "unexpected")
    return 0
}

fn rf_to(shares, id) {
    let out = list_new()
    let j = 0
    while j < len(shares) {
        if sa4w_parse(shares[j])[3] == id { push(out, shares[j]) }
        j = j + 1
    }
    return out
}

fn test_u2_refusals(roster, vc) {
    let s2 = sa4w_fmt_set(RF_R, 2, sa4w_bitmap([1, 2, 3]))
    let d = rf_drive(roster, vc, 2)
    let mine = rf_to(d[2], 7)
    ce_eq("two shares for soul 7", len(mine), 2)
    rf_expect("|U2| < t", rf_drive(roster, vc, 2)[0][0], sa4h_cat(sa4h_one(mine[0]), sa4h_one(sa4w_fmt_set(RF_R, 2, sa4w_bitmap([1, 2])))), "u2_small")
    rf_expect("share missing", rf_drive(roster, vc, 2)[0][0], sa4h_cat(sa4h_one(mine[0]), sa4h_one(s2)), "bad_share")
    rf_expect("duplicate share", rf_drive(roster, vc, 2)[0][0], sa4h_cat(sa4h_cat(sa4h_one(mine[0]), sa4h_one(mine[0])), sa4h_one(s2)), "bad_share")
    let other = rf_to(d[2], 300)
    rf_expect("share for another soul", rf_drive(roster, vc, 2)[0][0], sa4h_cat(sa4h_cat(sa4h_one(mine[0]), sa4h_one(other[0])), sa4h_one(s2)), "bad_share")
    let p = sa4w_parse(mine[1])
    let ct = p[4]
    list_set(ct, 40, int_xor(ct[40], 1))
    rf_expect("tampered ciphertext", rf_drive(roster, vc, 2)[0][0], sa4h_cat(sa4h_cat(sa4h_one(mine[0]), sa4h_one(sa4w_fmt_share(RF_R, p[2], 7, ct))), sa4h_one(s2)), "bad_share")
    // Relabel a share's sender: it no longer opens under that sender's key.
    let q = sa4w_parse(mine[0])
    let relabel = 300
    if q[2] == 300 { relabel = 65536 }
    rf_expect("relabelled sender", rf_drive(roster, vc, 2)[0][0], sa4h_cat(sa4h_one(sa4w_fmt_share(RF_R, relabel, 7, q[4])), sa4h_one(s2)), "bad_share")
    rf_expect("bit above N in U2", rf_drive(roster, vc, 2)[0][0], sa4h_cat(mine, sa4h_one(sa4w_fmt_set(RF_R, 2, sa4w_bitmap([1, 2, 3, 4])))), "bad_set")
    return 0
}

fn test_u3_u4_refusals(roster, vc) {
    rf_expect("|U3| < t", rf_drive(roster, vc, 3)[0][0], sa4h_one(sa4w_fmt_set(RF_R, 3, sa4w_bitmap([1, 2]))), "u3_small")
    rf_expect("SET 4 instead of SET 3", rf_drive(roster, vc, 3)[0][0], sa4h_one(sa4w_fmt_set(RF_R, 4, sa4w_bitmap([1, 2, 3]))), "unexpected")
    let s4 = sa4w_fmt_set(RF_R, 4, sa4w_bitmap([1, 2, 3]))
    let d = rf_drive(roster, vc, 4)
    let g = d[4]
    ce_eq("three signatures", len(g), 3)
    rf_expect("|U4| < t", rf_drive(roster, vc, 4)[0][0], sa4h_cat(sa4h_cat(sa4h_one(g[0]), sa4h_one(g[1])), sa4h_one(sa4w_fmt_set(RF_R, 4, sa4w_bitmap([1, 2])))), "u4_small")
    rf_expect("signature missing", rf_drive(roster, vc, 4)[0][0], sa4h_cat(sa4h_cat(sa4h_one(g[0]), sa4h_one(g[1])), sa4h_one(s4)), "bad_sig3")
    let p = sa4w_parse(g[2])
    let sig = p[3]
    list_set(sig, 3, int_xor(sig[3], 64))
    rf_expect("bad consistency signature", rf_drive(roster, vc, 4)[0][0], sa4h_cat(rf_list3(g[0], g[1], sa4w_fmt_sig3(RF_R, p[2], sig)), sa4h_one(s4)), "bad_sig3")
    rf_expect("own signature altered", rf_drive(roster, vc, 4)[0][0], sa4h_cat(rf_list3(sa4w_fmt_sig3(RF_R, 7, sa4w_parse(g[1])[3]), g[1], g[2]), sa4h_one(s4)), "bad_sig3")
    rf_expect("duplicate signature line", rf_drive(roster, vc, 4)[0][0], sa4h_cat(rf_list3(g[0], g[1], g[1]), sa4h_one(s4)), "bad_sig3")
    // A signature over a different U3 (an equivocating coordinator) does
    // not verify against the T3 this soul signed.
    let tamper_bm = sa4w_bitmap([1, 2, 3])
    let fake_t3 = sa4w_t3_transcript(sa4w_unhex(sroster_fingerprint(roster), 32), RF_R, sa4w_sha256(list_new()), tamper_bm, tamper_bm)
    let fake = ed25519_sign(fake_t3, ed25519_hex_to_bytes(SA4H_SEEDS[1]), ed25519_hex_to_bytes(SA4H_PKS[1]))
    rf_expect("signature over another transcript", rf_drive(roster, vc, 4)[0][0], sa4h_cat(rf_list3(g[0], sa4w_fmt_sig3(RF_R, 300, fake), g[2]), sa4h_one(s4)), "bad_sig3")
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(3)
    test_round_refusals(roster, vc)
    test_u1_refusals(roster, vc)
    test_u2_refusals(roster, vc)
    test_u3_u4_refusals(roster, vc)
    ce_summary("sa4_soul_refuse")
}

main()
