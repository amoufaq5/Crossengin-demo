// Unit tests for src/parts/goals/planner.nova
//
// Phase R5 (ADR-0113) ships four keyword heuristics on `goal_name` for
// FILE / HTTP / CODE / AUDIO. Each heuristic matches a prefix with a
// trailing SPACE -- motor_map's default vocabulary uses UNDERSCORES, so
// no R3+R4 test can trigger a planner hit (byte-identity canary).
//
// 10 subtests:
//   1.  FILE "write note hello world" -> ["/tmp/ce_note_7.txt", "hello world"]
//   2.  FILE "write_a_note"           -> empty (byte-identity canary)
//   3.  HTTP "fetch https://example.com" -> ["https://example.com", ""]
//   4.  HTTP "search_the_web"         -> empty
//   5.  CODE "run 2 + 3"              -> ["2 + 3"]
//   6.  CODE "run_code"               -> empty (byte-identity canary)
//   7.  AUDIO "say hello"             -> ["/tmp/ce_speech.wav"]
//   8.  Class-mismatch: "fetch url" with EFF_CLASS_FILE -> empty
//   9.  Empty goal_name across every class -> empty
//   10. MCP / TOOL / INTERNAL return empty regardless of goal_name

import "../ce_test.nova"
import "../../src/parts/goals/planner.nova"

// ---- subtest 1: FILE write-note hit -------------------------------------
fn test_planner_file_write_note_hit() {
    let ops = planner_materialize("write note hello world", EFF_CLASS_FILE, 7)
    ce_eq("file hit ops length", len(ops), 2)
    ce_str_eq("file hit path", ops[0], "/tmp/ce_note_7.txt")
    ce_str_eq("file hit content", ops[1], "hello world")
}

// ---- subtest 2: FILE motor_map vocab (underscores) MUST NOT match -------
fn test_planner_file_no_space_misses() {
    let ops = planner_materialize("write_a_note", EFF_CLASS_FILE, 7)
    ce_eq("file byte-identity canary (write_a_note is R3+R4 territory)",
          len(ops), 0)
}

// ---- subtest 3: HTTP fetch hit ------------------------------------------
fn test_planner_http_fetch_hit() {
    let ops = planner_materialize("fetch https://example.com",
                                  EFF_CLASS_HTTP, 3)
    ce_eq("http hit ops length", len(ops), 2)
    ce_str_eq("http hit url", ops[0], "https://example.com")
    ce_str_eq("http hit canned empty", ops[1], "")
}

// ---- subtest 4: HTTP non-matching name misses ---------------------------
fn test_planner_http_no_match_misses() {
    let ops = planner_materialize("search_the_web", EFF_CLASS_HTTP, 3)
    ce_eq("http no-match misses", len(ops), 0)
}

// ---- subtest 5: CODE run hit --------------------------------------------
fn test_planner_code_run_hit() {
    let ops = planner_materialize("run 2 + 3", EFF_CLASS_CODE, 5)
    ce_eq("code hit ops length", len(ops), 1)
    ce_str_eq("code hit expr", ops[0], "2 + 3")
}

// ---- subtest 6: CODE motor_map vocab (underscores) MUST NOT match -------
fn test_planner_code_no_match_misses() {
    let ops = planner_materialize("run_code", EFF_CLASS_CODE, 5)
    ce_eq("code byte-identity canary (run_code is R3+R4 territory)",
          len(ops), 0)
}

// ---- subtest 7: AUDIO say hit -------------------------------------------
fn test_planner_audio_say_hit() {
    let ops = planner_materialize("say hello", EFF_CLASS_AUDIO, 2)
    ce_eq("audio hit ops length", len(ops), 1)
    ce_str_eq("audio hit out_path", ops[0], "/tmp/ce_speech.wav")
}

// ---- subtest 8: class-mismatch (prefix matches but wrong class) ---------
//
// `"fetch url"` matches `PL_HTTP_PREFIX` -- but the dispatched class is
// FILE, so the HTTP branch is not visited. The FILE branch runs its own
// prefix check (`PL_FILE_PREFIX = "write note "`), misses, returns empty.
fn test_planner_class_mismatch_misses() {
    let ops = planner_materialize("fetch url", EFF_CLASS_FILE, 1)
    ce_eq("class-mismatch misses (fetch url against FILE)", len(ops), 0)
}

// ---- subtest 9: empty goal_name -> empty for every class ---------------
fn test_planner_empty_goal_name_misses() {
    let o_file  = planner_materialize("", EFF_CLASS_FILE,  1)
    let o_http  = planner_materialize("", EFF_CLASS_HTTP,  1)
    let o_code  = planner_materialize("", EFF_CLASS_CODE,  1)
    let o_audio = planner_materialize("", EFF_CLASS_AUDIO, 1)
    ce_eq("empty name FILE  empty", len(o_file),  0)
    ce_eq("empty name HTTP  empty", len(o_http),  0)
    ce_eq("empty name CODE  empty", len(o_code),  0)
    ce_eq("empty name AUDIO empty", len(o_audio), 0)
}

// ---- subtest 10: MCP / TOOL / INTERNAL always empty --------------------
//
// No planner heuristic ships for these classes this round. Even if the
// goal_name looks heuristic-ish (`"fetch mcp"`), the planner returns
// empty so the caller falls through to R3 convention (MCP) or the
// pre-R2 5-arg path (TOOL / INTERNAL).
fn test_planner_mcp_internal_tool_return_empty() {
    let o_mcp  = planner_materialize("fetch something", EFF_CLASS_MCP,      1)
    let o_tool = planner_materialize("run anything",    EFF_CLASS_TOOL,     1)
    let o_int  = planner_materialize("say nothing",     EFF_CLASS_INTERNAL, 1)
    ce_eq("mcp class returns empty",      len(o_mcp),  0)
    ce_eq("tool class returns empty",     len(o_tool), 0)
    ce_eq("internal class returns empty", len(o_int),  0)
}

fn main() {
    test_planner_file_write_note_hit()
    test_planner_file_no_space_misses()
    test_planner_http_fetch_hit()
    test_planner_http_no_match_misses()
    test_planner_code_run_hit()
    test_planner_code_no_match_misses()
    test_planner_audio_say_hit()
    test_planner_class_mismatch_misses()
    test_planner_empty_goal_name_misses()
    test_planner_mcp_internal_tool_return_empty()
    ce_summary("planner")
}
main()
