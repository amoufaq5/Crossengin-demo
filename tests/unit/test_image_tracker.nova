// Unit tests for src/io/transducers/image_tracker.nova (R23D).
//
// Coverage targets (the brief asks for ~25 assertions):
//   * Constants + sentinels (3); single detection -> probational (3);
//     5 consecutive frames -> confirmed (3); 5 moving frames ->
//     velocity (3); 5 missed -> lost (3); two parallel tracks (3);
//     Hungarian crossing-tracks no-swap (3); empty -> no spawn (2);
//     Kalman predict by known velocity (2); accessors (2); detection
//     helper (1). Total: 40 assertions (above the ~25 floor).

import "../ce_test.nova"
import "../../src/io/transducers/image_tracker.nova"

fn _mk_detections(x, y, w, h) {
    let dets = list_new()
    push(dets, detection_from_xywh(x, y, w, h))
    return dets
}

fn _mk_two_detections(x1, y1, x2, y2, w, h) {
    let dets = list_new()
    push(dets, detection_from_xywh(x1, y1, w, h))
    push(dets, detection_from_xywh(x2, y2, w, h))
    return dets
}

fn _empty_dets() { return list_new() }

fn test_constants() {
    ce_eq("TRACKER_CONFIRM_THRESHOLD = 5",
          tracker_confirm_threshold(), 5)
    ce_eq("TRACKER_LOST_THRESHOLD = 5",
          tracker_lost_threshold(), 5)
    ce_eq("TRACKER_MILLI = 1000", tracker_milli(), 1000)
}

fn test_single_detection_spawns_probational() {
    let tr = tracker_new()
    let dets = _mk_detections(10, 20, 16, 16)
    tracker_step(tr, dets, 1)
    let active = tracker_active_tracks(tr)
    ce_eq("single detection -> 1 active track", len(active), 1)
    let t = active[0]
    ce_str_eq("new track is probational",
              track_status(t), "probational")
    ce_eq("new track id = 1", track_id(t), 1)
}

fn test_five_frames_confirms_track() {
    let tr = tracker_new()
    let f = 1
    while f <= 5 {
        let dets = _mk_detections(50, 50, 16, 16)
        tracker_step(tr, dets, f)
        f = f + 1
    }
    let active = tracker_active_tracks(tr)
    ce_eq("after 5 frames -> 1 active track", len(active), 1)
    let t = active[0]
    ce_str_eq("after 5 hits -> confirmed",
              track_status(t), "confirmed")
    ce_eq("hits = 5", track_hits(t), 5)
}

fn test_moving_track_velocity() {
    let tr = tracker_new()
    let x = 10
    let y = 10
    let f = 1
    while f <= 5 {
        let dets = _mk_detections(x, y, 16, 16)
        tracker_step(tr, dets, f)
        x = x + 5
        y = y + 5
        f = f + 1
    }
    let active = tracker_active_tracks(tr)
    ce_eq("after 5 moving frames -> 1 active track",
          len(active), 1)
    let t = active[0]
    let state = track_state(t)
    let vx = state[2]
    let vy = state[3]
    let vx_ok = 0
    let vy_ok = 0
    if vx >= 2000 { if vx <= 6000 { vx_ok = 1 } }
    if vy >= 2000 { if vy <= 6000 { vy_ok = 1 } }
    ce_check("moving-track vx in [2000, 6000] milli", vx_ok == 1)
    ce_check("moving-track vy in [2000, 6000] milli", vy_ok == 1)
    let dir_ok = 0
    if vx > 0 { if vy > 0 { dir_ok = 1 } }
    ce_check("moving-track velocity has correct sign (+x +y)",
             dir_ok == 1)
}

fn test_track_marked_lost_after_misses() {
    let tr = tracker_new()
    let f = 1
    while f <= 5 {
        let dets = _mk_detections(80, 80, 16, 16)
        tracker_step(tr, dets, f)
        f = f + 1
    }
    let confirmed = tracker_confirmed_tracks(tr)
    ce_eq("track confirmed after 5 hits", len(confirmed), 1)
    let confirmed_id = track_id(confirmed[0])

    while f <= 10 {
        tracker_step(tr, _empty_dets(), f)
        f = f + 1
    }
    let t = tracker_track_at(tr, confirmed_id)
    let t_ok = 0
    if t != 0 { t_ok = 1 }
    ce_check("track still exists in all_tracks after lost", t_ok == 1)
    if t != 0 {
        ce_str_eq("track marked lost after 5 missed frames",
                  track_status(t), "lost")
        let active = tracker_active_tracks(tr)
        ce_eq("lost track not in active list", len(active), 0)
    }
}

fn test_two_tracks_no_swap() {
    let tr = tracker_new()
    let x = 10
    let f = 1
    while f <= 6 {
        let dets = _mk_two_detections(x, 10, x, 80, 16, 16)
        tracker_step(tr, dets, f)
        x = x + 2
        f = f + 1
    }
    let active = tracker_active_tracks(tr)
    ce_eq("two parallel tracks -> 2 active", len(active), 2)

    let t1 = tracker_track_at(tr, 1)
    let t2 = tracker_track_at(tr, 2)
    let t1_ok = 0
    let t2_ok = 0
    if t1 != 0 { t1_ok = 1 }
    if t2 != 0 { t2_ok = 1 }
    ce_check("track #1 exists", t1_ok == 1)
    ce_check("track #2 exists", t2_ok == 1)

    if t1 != 0 {
        let y1 = track_y_px(t1)
        let y1_ok = 0
        if y1 >= 5 { if y1 <= 15 { y1_ok = 1 } }
        ce_check("track #1 y-position near 10", y1_ok == 1)
    }
    if t2 != 0 {
        let y2 = track_y_px(t2)
        let y2_ok = 0
        if y2 >= 75 { if y2 <= 85 { y2_ok = 1 } }
        ce_check("track #2 y-position near 80", y2_ok == 1)
    }
}

fn test_hungarian_no_crossing_swap() {
    let tr = tracker_new()
    let dets1 = _mk_two_detections(20, 50, 80, 50, 16, 16)
    tracker_step(tr, dets1, 1)
    let dets2 = _mk_two_detections(25, 50, 75, 50, 16, 16)
    tracker_step(tr, dets2, 2)
    let dets3 = _mk_two_detections(30, 50, 70, 50, 16, 16)
    tracker_step(tr, dets3, 3)
    let dets4 = _mk_two_detections(35, 50, 65, 50, 16, 16)
    tracker_step(tr, dets4, 4)

    let t1 = tracker_track_at(tr, 1)
    let t2 = tracker_track_at(tr, 2)

    let x1 = track_x_px(t1)
    let x2 = track_x_px(t2)
    let x1_ok = 0
    let x2_ok = 0
    if x1 >= 25 { if x1 <= 40 { x1_ok = 1 } }
    if x2 >= 60 { if x2 <= 75 { x2_ok = 1 } }
    ce_check("track #1 stays on the LEFT after motion", x1_ok == 1)
    ce_check("track #2 stays on the RIGHT after motion", x2_ok == 1)

    ce_eq("after Hungarian-no-swap: 2 total tracks",
          len(tracker_all_tracks(tr)), 2)
}

fn test_empty_detections_no_new_track() {
    let tr = tracker_new()
    tracker_step(tr, _empty_dets(), 1)
    tracker_step(tr, _empty_dets(), 2)
    tracker_step(tr, _empty_dets(), 3)
    ce_eq("empty detections -> 0 tracks spawned",
          len(tracker_all_tracks(tr)), 0)
    ce_eq("step_count advanced", tracker_step_count(tr), 3)
}

fn test_kalman_predict_known_velocity() {
    let tr = tracker_new()
    tracker_step(tr, _mk_detections(50, 50, 16, 16), 1)
    let t = tracker_active_tracks(tr)[0]
    list_set(t, 3, 3000)
    list_set(t, 4, 4000)
    let x_before = t[1]
    let y_before = t[2]
    track_predict(t)
    let x_after = t[1]
    let y_after = t[2]
    ce_eq("predict +vx: x advanced by 3000 milli",
          x_after - x_before, 3000)
    ce_eq("predict +vy: y advanced by 4000 milli",
          y_after - y_before, 4000)
}

fn test_detection_helper() {
    let d = detection_from_xywh(7, 11, 16, 16)
    ce_eq("detection_from_xywh stores x", d[0], 7)
    ce_eq("detection_from_xywh stores y", d[1], 11)
    ce_eq("detection_from_xywh stores w", d[2], 16)
    ce_eq("detection_from_xywh stores h", d[3], 16)
}

fn test_track_state_shape() {
    let tr = tracker_new()
    tracker_step(tr, _mk_detections(15, 25, 32, 32), 1)
    let t = tracker_active_tracks(tr)[0]
    let s = track_state(t)
    ce_eq("track_state has 6 elements", len(s), 6)
    ce_eq("track_state[0] = x_milli (15*1000)", s[0], 15000)
    ce_eq("track_state[1] = y_milli (25*1000)", s[1], 25000)
    ce_eq("track_state[4] = w (32)", s[4], 32)
    ce_eq("track_state[5] = h (32)", s[5], 32)
}

fn test_tracker_track_at_lookup() {
    let tr = tracker_new()
    tracker_step(tr, _mk_detections(10, 20, 16, 16), 1)
    let t = tracker_track_at(tr, 1)
    let exists = 0
    if t != 0 { exists = 1 }
    ce_check("tracker_track_at(1) returns track", exists == 1)
    let missing = tracker_track_at(tr, 99)
    ce_check("tracker_track_at(99) returns 0 sentinel",
             missing == 0)
}

fn main() {
    test_constants()
    test_single_detection_spawns_probational()
    test_five_frames_confirms_track()
    test_moving_track_velocity()
    test_track_marked_lost_after_misses()
    test_two_tracks_no_swap()
    test_hungarian_no_crossing_swap()
    test_empty_detections_no_new_track()
    test_kalman_predict_known_velocity()
    test_detection_helper()
    test_track_state_shape()
    test_tracker_track_at_lookup()
    ce_summary("image_tracker")
}

main()
