// Unit tests for src/parts/soul/identity.nova
// Verifies the soul object, identity setup, OCEAN traits, and the gated
// slow-tier identity revision (requires justification, audited). ADR-0034.

import "../ce_test.nova"
import "../../src/parts/soul/identity.nova"

fn test_identity() {
    let s = soul_new("Aurora")
    ce_str_eq("name", soul_name(s), "Aurora")
    soul_set_identity(s, "understand and assist", "curious, careful")
    ce_str_eq("purpose", soul_purpose(s), "understand and assist")
    ce_str_eq("nature", soul_nature(s), "curious, careful")
    // OCEAN defaults neutral.
    ce_eq("default openness", soul_openness(s), 500)
    soul_set_ocean(s, 800, 700, 400, 900, 300)
    ce_eq("openness", soul_openness(s), 800)
    ce_eq("neuroticism", soul_neuroticism(s), 300)
    ce_eq("ocean list", len(soul_ocean(s)), 5)
}

fn test_gated_revision() {
    let s = soul_new("Aurora")
    soul_set_identity(s, "p0", "n0")
    // Revision without justification is rejected.
    ce_eq("no justification rejected", soul_revise_identity(s, "p1", "n1", ""), 0)
    ce_str_eq("purpose unchanged", soul_purpose(s), "p0")
    ce_eq("no revision logged", soul_revision_count(s), 0)
    // With justification it succeeds and is audited.
    ce_eq("justified revision", soul_revise_identity(s, "p1", "n1", "matured after experience"), 1)
    ce_str_eq("purpose revised", soul_purpose(s), "p1")
    ce_eq("revision logged", soul_revision_count(s), 1)
}

fn main() {
    test_identity()
    test_gated_revision()
    ce_summary("identity")
}

main()
