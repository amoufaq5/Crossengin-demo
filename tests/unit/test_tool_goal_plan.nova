// Unit tests for src/agent/tool_goal_plan.nova (P4 -> P5, ADR-0054 follow-up).
//
// The goal -> tool-plan bridge: a DECOMPOSED GOAL (a goal_engine goal with
// ordered leaf sub-goals) turns into a tool_use plan_* plan that plan_execute
// runs end to end. Covered: a 3-step goal (search -> compute -> write) that
// decomposes into a plan plan_execute completes with results threaded between
// steps; the decomposition driving the plan shape (a blocked leaf is dropped);
// a leaf with no matching binding is skipped; and the one-shot goal_run that
// builds + bridges + executes + rolls progress up so the goal closes.
//
// ADR-0054, ADR-0033.

import "../ce_test.nova"
import "../../src/agent/tool_goal_plan.nova"

fn _reg3() {
    let reg = tool_registry_new()
    tool_register(reg, tool_new("web_search", TOOLK_HTTP, "search", ACT_NET_FETCH, 5, "6"))
    tool_register(reg, tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, ""))
    tool_register(reg, tool_new("writer", TOOLK_FILE_WRITE, "write", ACT_WRITE_LOCAL, 2, "/tmp/ce_tool_goal_out.txt"))
    return reg
}

// Build the 3-step descriptor list (the same search -> compute -> write task,
// now expressed as a goal decomposition).
fn _descs3() {
    let d = list_new()
    let s1 = list_new(); push(s1, "find the number"); push(s1, "search"); push(s1, ARG_LITERAL); push(s1, "http://example/answer")
    let s2 = list_new(); push(s2, "multiply it"); push(s2, "compute"); push(s2, ARG_PREV_TEXT); push(s2, " * 7")
    let s3 = list_new(); push(s3, "write the answer"); push(s3, "write"); push(s3, ARG_PREV_TEXT); push(s3, "")
    push(d, s1); push(d, s2); push(d, s3)
    return d
}

// Acceptance: a goal decomposes into a plan that plan_execute completes.
fn test_goal_decomposes_to_plan() {
    let built = goal_plan_build("answer the question", _descs3(), 800, 0)
    let engine = goal_plan_engine(built)
    let root = goal_plan_root(built)
    // The goal really decomposed into three sub-goals in the engine.
    ce_eq("root has three sub-goals", len(goal_children(engine, root)), 3)
    ce_eq("three active leaves", len(goal_leaves(engine, root)), 3)
    // Bridge the decomposition to a plan.
    let plan = goal_to_plan(engine, root, goal_plan_spec(built))
    ce_eq("plan has one step per leaf", len(plan), 3)
    // plan_execute runs it end to end, threading results between steps.
    let out = plan_execute(_reg3(), plan, 0)
    ce_eq("all three steps succeeded", plan_ok_count(out), 3)
    ce_str_eq("result threaded + written to file",
              tr_text(file_ops_read("/tmp/ce_tool_goal_out.txt")), "42")
}

// The decomposition drives the plan SHAPE: blocking a leaf removes its step.
fn test_decomposition_shapes_plan() {
    let built = goal_plan_build("answer the question", _descs3(), 800, 0)
    let engine = goal_plan_engine(built)
    let root = goal_plan_root(built)
    let leaves = goal_leaves(engine, root)
    // Block the middle leaf (the "compute" sub-goal) -> no active path for it.
    goal_propagate_block(engine, leaves[1])
    let after = goal_leaves(engine, root)
    ce_eq("blocked leaf dropped from decomposition", len(after), 2)
    let plan = goal_to_plan(engine, root, goal_plan_spec(built))
    ce_eq("plan shrinks with the decomposition", len(plan), 2)
    // The remaining steps are search then write (compute removed): the search
    // result "6" is now threaded straight into the write step.
    let out = plan_execute(_reg3(), plan, 0)
    ce_eq("both remaining steps run", plan_ok_count(out), 2)
}

// A leaf with no matching binding (spec shorter than the leaf set) is skipped.
fn test_short_spec_skips_unbound_leaf() {
    let built = goal_plan_build("answer the question", _descs3(), 800, 0)
    let engine = goal_plan_engine(built)
    let root = goal_plan_root(built)
    // Truncate the spec to two bindings; the third leaf has no tool to attempt.
    let spec = goal_plan_spec(built)
    let trimmed = goal_spec_new()
    goal_spec_add(trimmed, spec[0])
    goal_spec_add(trimmed, spec[1])
    ce_eq("step count clamps to spec length", goal_plan_step_count(engine, root, trimmed), 2)
    let plan = goal_to_plan(engine, root, trimmed)
    ce_eq("unbound leaf produced no step", len(plan), 2)
}

// One-shot goal_run: build + bridge + execute + roll progress up; the goal
// closes (root satisfied) when every step succeeds.
fn test_goal_run_closes_the_loop() {
    let out = goal_run(_reg3(), "answer the question", _descs3(), 800, 0, 0)
    ce_eq("goal_run completed all steps", plan_ok_count(out), 3)
    let engine = goal_run_engine(out)
    let root = goal_run_root(out)
    ce_eq("root goal rolled up to satisfied", goal_status(engine, root), GOAL_SATISFIED)
    ce_eq("root progress is full", goal_progress(engine, root), 1000)
}

// goal_run with a failure: only completed steps' leaves are satisfied, so the
// root does NOT close (partial progress).
fn test_goal_run_partial_on_failure() {
    let reg = tool_registry_new()
    // Only a compute tool exists; the "search" step has no tool, so step 1 fails.
    tool_register(reg, tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, ""))
    let out = goal_run(reg, "answer the question", _descs3(), 800, 0, 0)
    ce_eq("no step completed (search has no tool)", plan_ok_count(out), 0)
    let engine = goal_run_engine(out)
    let root = goal_run_root(out)
    ce_check("root not satisfied on a failed plan", goal_status(engine, root) != GOAL_SATISFIED)
}

fn main() {
    test_goal_decomposes_to_plan()
    test_decomposition_shapes_plan()
    test_short_spec_skips_unbound_leaf()
    test_goal_run_closes_the_loop()
    test_goal_run_partial_on_failure()
    ce_summary("tool_goal_plan")
}

main()
