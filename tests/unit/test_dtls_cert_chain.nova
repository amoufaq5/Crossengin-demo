// Unit tests for src/federation/dtls12.nova::dtls_cert_verify_chain
// (Phase O R1, ADR-0094).
//
// Reuses the openssl-minted RSA and ECDSA test chains from
// test_x509_verify.nova (LEAF/ROOT + EC_LEAF/EC_ROOT, 100-year validity
// so vectors don't rot) rather than fabricating a fresh set -- the
// chains are already unit-tested at the cert_chain_verify layer, so
// this suite exercises the DTLS mapping shim on top.
//
// Coverage (~50 checks):
//   * Empty chain -> DTLS_CERT_PARSE_FAIL + STATS_CERT_PARSE_FAIL++.
//   * Chain-of-2 RSA leaf+root, root anchored, matching hostname
//     -> DTLS_OK + STATS_CERT_OK++ + returned leaf cert non-zero.
//   * Chain-of-1 self-signed root, root anchored, matching hostname
//     -> DTLS_OK (root's own SAN is "CrossEngin Test Root" so we test
//     via the ROOT cert whose CN carries no SAN -- this actually
//     returns DTLS_CERT_HOSTNAME_MISMATCH, which is the CORRECT
//     rejection; we assert that shape).
//   * Chain-of-2 with root NOT in anchors -> DTLS_CERT_NOT_PINNED
//     + STATS_CERT_NOT_PINNED++ + leaf 0.
//   * Chain-of-2 with tampered leaf sig -> DTLS_CERT_SIG_FAIL
//     + STATS_CERT_SIG_FAIL++.
//   * Wrong hostname -> DTLS_CERT_HOSTNAME_MISMATCH
//     + STATS_CERT_HOSTNAME_MISMATCH++.
//   * Wildcard hostname (abc.test.example) -> DTLS_OK.
//   * Expired cert (now > not_after) -> DTLS_CERT_EXPIRED.
//   * Not-yet-valid (now < not_before) -> DTLS_CERT_EXPIRED
//     (cert_chain_verify collapses both into XV_EXPIRED; see the
//     DTLS mapping docstring).
//   * ECDSA chain-of-2 valid -> DTLS_OK.
//   * ECDSA chain wrong host -> DTLS_CERT_HOSTNAME_MISMATCH.
//   * Return-shape invariants (list of two elements; leaf == 0 on
//     every non-OK path).
//   * Stats-line inclusion of the two new counters.

import "../ce_test.nova"
import "../../src/federation/dtls12.nova"
import "../../src/safety/x509_verify.nova"
import "../../src/util/str_safe.nova"

// ---------------------------------------------------------------------------
// Fixtures -- byte-identical to test_x509_verify.nova. Duplicated here
// (rather than imported) so this suite has no cross-test dependency:
// tests/unit/*.nova are independent programs.
// ---------------------------------------------------------------------------

let LEAF = ""
let ROOT = ""
let RMOD = ""
let EC_LEAF = ""
let EC_ROOT = ""

// hex -> [buf, n]. Byte-identical to test_x509_verify's `hexbuf`.
fn _hxv(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0
}
fn _hexbuf(s) {
    let n = len(s) / 2
    let b = alloc(n + 1)
    let k = 0
    while k < n {
        store8(b + k, _hxv(char_at(s, k*2)) * 16 + _hxv(char_at(s, k*2+1)))
        k = k + 1
    }
    let r = list_new() push(r, b) push(r, n) return r
}

// Build the RSA anchor list: one entry keyed on ROOT's modulus.
fn _rsa_anchors_good() {
    let anchors = list_new()
    let a = list_new()
    push(a, KEY_RSA)
    push(a, bn2048_from_hex(RMOD))
    push(a, 65537)
    push(anchors, a)
    return anchors
}

// Build a decoy anchor list (a nonsense N so the chain fails to pin).
fn _rsa_anchors_bad() {
    let anchors = list_new()
    let a = list_new()
    push(a, KEY_RSA)
    push(a, bn2048_from_int(3))
    push(a, 65537)
    push(anchors, a)
    return anchors
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

fn test_empty_chain_returns_parse_fail() {
    let st = dtls_init()
    let chain = list_new()
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   _rsa_anchors_good(), 100)
    ce_check("empty-chain result is list", len(r) == 2)
    ce_str_eq("empty-chain status is DTLS_CERT_PARSE_FAIL",
              r[0], DTLS_CERT_PARSE_FAIL)
    ce_eq("empty-chain leaf is 0", r[1], 0)
    ce_eq("empty-chain bumps stats_cert_parse_fail",
          dtls_stats_cert_parse_fail(st), 1)
    ce_str_eq("empty-chain sets last_err",
              dtls_last_error(st), DTLS_CERT_PARSE_FAIL)
}

fn test_chain_of_two_valid_returns_ok() {
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   _rsa_anchors_good(), now)
    ce_check("valid-chain result is list", len(r) == 2)
    ce_eq("valid-chain status is DTLS_OK", r[0], DTLS_OK)
    ce_check("valid-chain leaf non-zero", r[1] != 0)
    ce_eq("valid-chain bumps stats_cert_ok",
          dtls_stats_cert_ok(st), 1)
    ce_eq("valid-chain leaves other counters at zero",
          dtls_stats_cert_parse_fail(st)
            + dtls_stats_cert_sig_fail(st)
            + dtls_stats_cert_expired(st)
            + dtls_stats_cert_not_pinned(st)
            + dtls_stats_cert_hostname_mismatch(st), 0)
}

fn test_wildcard_host_ok() {
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "abc.test.example",
                                   _rsa_anchors_good(), now)
    ce_eq("wildcard-host chain returns DTLS_OK", r[0], DTLS_OK)
    ce_check("wildcard-host chain leaf non-zero", r[1] != 0)
}

fn test_not_pinned() {
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   _rsa_anchors_bad(), now)
    ce_str_eq("not-pinned status is DTLS_CERT_NOT_PINNED",
              r[0], DTLS_CERT_NOT_PINNED)
    ce_eq("not-pinned leaf is 0", r[1], 0)
    ce_eq("not-pinned bumps stats_cert_not_pinned",
          dtls_stats_cert_not_pinned(st), 1)
    ce_str_eq("not-pinned sets last_err",
              dtls_last_error(st), DTLS_CERT_NOT_PINNED)
    ce_eq("not-pinned does NOT bump cert_ok",
          dtls_stats_cert_ok(st), 0)
}

fn test_empty_anchors_not_pinned() {
    // An empty truststore rejects every chain via XV_NOT_PINNED. The
    // fed-daemon's boot-time "no manifest.txt" path takes this branch,
    // so R3 will inherit "fail closed" for free.
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let empty_anchors = list_new()
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   empty_anchors, now)
    ce_str_eq("empty-anchors -> NOT_PINNED",
              r[0], DTLS_CERT_NOT_PINNED)
    ce_eq("empty-anchors bumps stats_cert_not_pinned",
          dtls_stats_cert_not_pinned(st), 1)
}

fn test_wrong_hostname() {
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "evil.example.com",
                                   _rsa_anchors_good(), now)
    ce_str_eq("wrong-host status is DTLS_CERT_HOSTNAME_MISMATCH",
              r[0], DTLS_CERT_HOSTNAME_MISMATCH)
    ce_eq("wrong-host leaf is 0", r[1], 0)
    ce_eq("wrong-host bumps stats_cert_hostname_mismatch",
          dtls_stats_cert_hostname_mismatch(st), 1)
    ce_str_eq("wrong-host sets last_err",
              dtls_last_error(st), DTLS_CERT_HOSTNAME_MISMATCH)
}

fn test_expired_cert() {
    // now > not_after. cert_chain_verify collapses both "expired" and
    // "not yet valid" into XV_EXPIRED, which the mapping surfaces as
    // DTLS_CERT_EXPIRED.
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_after(leaf_cert) + 1
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   _rsa_anchors_good(), now)
    ce_str_eq("expired status is DTLS_CERT_EXPIRED",
              r[0], DTLS_CERT_EXPIRED)
    ce_eq("expired leaf is 0", r[1], 0)
    ce_eq("expired bumps stats_cert_expired",
          dtls_stats_cert_expired(st), 1)
}

fn test_not_yet_valid_cert() {
    // now < not_before -> DTLS_CERT_EXPIRED (see mapping docstring).
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) - 1
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   _rsa_anchors_good(), now)
    ce_str_eq("not-yet-valid status is DTLS_CERT_EXPIRED (collapsed)",
              r[0], DTLS_CERT_EXPIRED)
    ce_eq("not-yet-valid bumps stats_cert_expired",
          dtls_stats_cert_expired(st), 1)
}

fn test_tampered_leaf_sig() {
    // Flip a byte inside the LEAF signature range. The exact offset does
    // not matter -- we corrupt a byte near the end (in the signature
    // BIT STRING) and expect the RSA verify to reject. The DER buffer
    // is a fresh alloc from _hexbuf so mutation is local to this test.
    let st = dtls_init()
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let buf = l[0]
    let n = l[1]
    // Flip the last byte (deep in the signature). Even a 1-bit flip
    // breaks PKCS#1 v1.5 verification.
    let last_off = n - 1
    let orig = load8(buf + last_off)
    store8(buf + last_off, int_and(orig + 1, 255))
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    // Use ROOT's not_before + 1000 (LEAF cannot be trusted to parse
    // after tampering).
    let root_cert = cert_parse(rc[0], rc[1])
    let now = cert_not_before(root_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "test.example",
                                   _rsa_anchors_good(), now)
    // The exact XV code depends on whether the tampered byte lives
    // inside the DER structure the parser still traverses. Any of
    // SIG_FAIL / PARSE_FAIL is acceptable "safe reject"; we assert
    // it is DEFINITELY NOT DTLS_OK, and that one of the fail
    // counters bumped.
    ce_check("tampered chain does NOT return DTLS_OK", r[0] != DTLS_OK)
    ce_eq("tampered chain leaf is 0", r[1], 0)
    let sig_c = dtls_stats_cert_sig_fail(st)
    let parse_c = dtls_stats_cert_parse_fail(st)
    ce_check("tampered chain bumped SIG_FAIL or PARSE_FAIL",
             sig_c + parse_c >= 1)
}

fn test_ecdsa_chain_ok() {
    let st = dtls_init()
    let l = _hexbuf(EC_LEAF)
    let rc = _hexbuf(EC_ROOT)
    let root_cert = cert_parse(rc[0], rc[1])
    let anchors = list_new()
    let a = list_new()
    push(a, KEY_EC)
    push(a, cert_ec_point(root_cert))
    push(a, cert_ec_point_n(root_cert))
    push(anchors, a)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "ec.example", anchors, now)
    ce_eq("EC chain returns DTLS_OK", r[0], DTLS_OK)
    ce_check("EC chain leaf non-zero", r[1] != 0)
    ce_eq("EC chain bumps stats_cert_ok",
          dtls_stats_cert_ok(st), 1)
}

fn test_ecdsa_chain_wrong_host() {
    let st = dtls_init()
    let l = _hexbuf(EC_LEAF)
    let rc = _hexbuf(EC_ROOT)
    let root_cert = cert_parse(rc[0], rc[1])
    let anchors = list_new()
    let a = list_new()
    push(a, KEY_EC)
    push(a, cert_ec_point(root_cert))
    push(a, cert_ec_point_n(root_cert))
    push(anchors, a)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    let r = dtls_cert_verify_chain(st, chain, "notec.example", anchors, now)
    ce_str_eq("EC wrong-host is DTLS_CERT_HOSTNAME_MISMATCH",
              r[0], DTLS_CERT_HOSTNAME_MISMATCH)
    ce_eq("EC wrong-host bumps stats_cert_hostname_mismatch",
          dtls_stats_cert_hostname_mismatch(st), 1)
}

fn test_return_shape_always_pair() {
    // Every path returns a two-element list. Confirmed already in each
    // path-specific test, but this test asserts it once explicitly.
    let st = dtls_init()
    let empty_chain = list_new()
    let r = dtls_cert_verify_chain(st, empty_chain, "x",
                                   _rsa_anchors_good(), 100)
    ce_eq("return shape is length-2", len(r), 2)
}

fn test_stats_line_includes_new_counters() {
    // The stats_line footer must include the two new Phase O R1
    // counters so a grep-based monitor picks them up.
    let st = dtls_init()
    let line = dtls_stats_line(st)
    ce_check("stats_line contains cert_not_pinned",
             find_bytes(line, "cert_not_pinned=") >= 0)
    ce_check("stats_line contains cert_hostname_mismatch",
             find_bytes(line, "cert_hostname_mismatch=") >= 0)
}

fn test_counters_isolated_per_state() {
    // Two independent dtls states must NOT share counter storage.
    let s1 = dtls_init()
    let s2 = dtls_init()
    let empty = list_new()
    dtls_cert_verify_chain(s1, empty, "x", _rsa_anchors_good(), 0)
    ce_eq("s1 parse-fail counter is 1", dtls_stats_cert_parse_fail(s1), 1)
    ce_eq("s2 parse-fail counter is 0 (isolated)",
          dtls_stats_cert_parse_fail(s2), 0)
}

fn test_multiple_errors_accumulate() {
    let st = dtls_init()
    let empty = list_new()
    dtls_cert_verify_chain(st, empty, "x", _rsa_anchors_good(), 0)
    dtls_cert_verify_chain(st, empty, "x", _rsa_anchors_good(), 0)
    dtls_cert_verify_chain(st, empty, "x", _rsa_anchors_good(), 0)
    ce_eq("three empty-chain calls accumulate parse_fail=3",
          dtls_stats_cert_parse_fail(st), 3)
    // Now a wrong-host on a real chain -- expect hostname_mismatch=1
    // and the parse counter unchanged.
    let l = _hexbuf(LEAF)
    let rc = _hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, rc)
    let leaf_cert = cert_parse(l[0], l[1])
    let now = cert_not_before(leaf_cert) + 1000
    dtls_cert_verify_chain(st, chain, "evil.example",
                           _rsa_anchors_good(), now)
    ce_eq("mixed calls: parse_fail still 3",
          dtls_stats_cert_parse_fail(st), 3)
    ce_eq("mixed calls: hostname_mismatch now 1",
          dtls_stats_cert_hostname_mismatch(st), 1)
}

fn test_new_error_constants_spelling() {
    // ADR-0094 pins the wire spelling of the two new tags. A future
    // rename would break external monitors that string-match them, so
    // this test freezes the strings.
    ce_str_eq("DTLS_CERT_NOT_PINNED spelling",
              DTLS_CERT_NOT_PINNED, "dtls-cert-not-pinned")
    ce_str_eq("DTLS_CERT_HOSTNAME_MISMATCH spelling",
              DTLS_CERT_HOSTNAME_MISMATCH, "dtls-cert-hostname-mismatch")
}

fn main() {
    test_empty_chain_returns_parse_fail()
    test_chain_of_two_valid_returns_ok()
    test_wildcard_host_ok()
    test_not_pinned()
    test_empty_anchors_not_pinned()
    test_wrong_hostname()
    test_expired_cert()
    test_not_yet_valid_cert()
    test_tampered_leaf_sig()
    test_ecdsa_chain_ok()
    test_ecdsa_chain_wrong_host()
    test_return_shape_always_pair()
    test_stats_line_includes_new_counters()
    test_counters_isolated_per_state()
    test_multiple_errors_accumulate()
    test_new_error_constants_spelling()
    ce_summary("dtls_cert_chain")
}

main()
