// Unit tests for src/parts/meta/theory_of_mind.nova
// Verifies user-property modeling (categories, Bayesian confidence), export, and
// full delete. ADR-0039, ADR-0044.

import "../ce_test.nova"
import "../../src/parts/meta/theory_of_mind.nova"

fn test_properties() {
    let reg = kg_registry_new()
    let um = usermodel_init(reg)
    ce_str_eq("user kg", kg_label(um), "user")
    um_set_property(um, "style", UM_STABLE, "concise", 0)
    um_set_property(um, "mood", UM_FAST, "calm", 0)
    ce_eq("two properties", um_count(um), 2)
    ce_eq("category", um_category(um, "style"), UM_STABLE)
    ce_str_eq("value", um_value(um, "style"), "concise")
    ce_eq("uniform confidence", um_confidence(um, "style"), 500)
    // Evidence raises confidence; mismatch lowers it.
    um_observe(um, "style", 1); um_observe(um, "style", 1)
    ce_eq("confidence rose", um_confidence(um, "style"), 750)
    um_observe(um, "style", -1)
    ce_check("mismatch lowered", um_confidence(um, "style") < 750)
    // Re-setting a property does not duplicate.
    um_set_property(um, "style", UM_STABLE, "terse", 0)
    ce_eq("no duplicate", um_count(um), 2)
    ce_str_eq("value updated", um_value(um, "style"), "terse")
}

fn test_export_delete() {
    let reg = kg_registry_new()
    let um = usermodel_init(reg)
    um_set_property(um, "expertise", UM_STABLE, "medicine", 0)
    um_set_property(um, "project", UM_SLOW, "thesis", 0)
    let dump = usermodel_export(um)
    ce_eq("export two", len(dump), 2)
    ce_str_eq("export name", dump[0][0], "expertise")
    // Full delete clears everything (ADR-0044).
    usermodel_delete(um)
    ce_eq("deleted", um_count(um), 0)
    ce_eq("export empty after delete", len(usermodel_export(um)), 0)
}

fn main() { test_properties() test_export_delete() ce_summary("theory_of_mind") }
main()
