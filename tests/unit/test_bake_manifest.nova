// Unit tests for src/factory/bake_manifest.nova (R99, ADR-0203/0204).
//
// Coverage: parse happy path, missing/empty required fields, comment +
// blank line handling, duplicate aggregation, unknown directive
// refusal, round-trip serialize->parse.

import "../ce_test.nova"
import "../../src/factory/bake_manifest.nova"
import "../../src/util/str_safe.nova"

fn test_fresh_manifest() {
    let m = bake_manifest_new()
    ce_str_eq("empty name", bake_manifest_name(m), "")
    ce_str_eq("empty version", bake_manifest_version(m), "")
    ce_str_eq("empty domain", bake_manifest_domain(m), "")
    ce_eq("no capsules", len(bake_manifest_allowed_capsules(m)), 0)
    ce_eq("no skills",   len(bake_manifest_allowed_skills(m)), 0)
    ce_eq("no patterns", len(bake_manifest_allowed_patterns(m)), 0)
    ce_eq("no personas", len(bake_manifest_persona_users(m)), 0)
    ce_eq("no policies", len(bake_manifest_policy_allowlist(m)), 0)
    ce_eq("no kg caps",  len(bake_manifest_kg_capsules(m)), 0)
    ce_eq("no prefixes", len(bake_manifest_kg_prefixes(m)), 0)
    ce_eq("no licenses", len(bake_manifest_kg_licenses(m)), 0)
    ce_str_eq("no style", bake_manifest_style_pin(m), "")
}

fn test_parse_happy_path() {
    let t = "BAKE-MANIFEST v1\n"
          + "NAME solar-child\n"
          + "VERSION 0.2.1\n"
          + "DOMAIN astronomy\n"
          + "STYLE plain\n"
          + "ALLOW_CAPSULE solar_system\n"
          + "ALLOW_CAPSULE physics\n"
          + "ALLOW_SKILL research\n"
          + "ALLOW_SKILL echo\n"
          + "ALLOW_PATTERN debug_common\n"
          + "PERSONA_USER alice\n"
          + "PERSONA_USER bob\n"
          + "ALLOW_POLICY auto_wikidata\n"
          + "ALLOW_KG_CAPSULE solar_system\n"
          + "ALLOW_SOURCE_PREFIX solar_\n"
          + "ALLOW_SOURCE_PREFIX folk_\n"
          + "ALLOW_LICENSE OPEN\n"
    let r = bake_manifest_parse(t)
    ce_eq("parse ok", r[0], 1)
    let m = r[1]
    ce_str_eq("name",    bake_manifest_name(m),    "solar-child")
    ce_str_eq("version", bake_manifest_version(m), "0.2.1")
    ce_str_eq("domain",  bake_manifest_domain(m),  "astronomy")
    ce_str_eq("style",   bake_manifest_style_pin(m), "plain")
    ce_eq("2 caps",    len(bake_manifest_allowed_capsules(m)), 2)
    ce_eq("2 skills",  len(bake_manifest_allowed_skills(m)), 2)
    ce_eq("1 pattern", len(bake_manifest_allowed_patterns(m)), 1)
    ce_eq("2 personas", len(bake_manifest_persona_users(m)), 2)
    ce_eq("1 policy",  len(bake_manifest_policy_allowlist(m)), 1)
    ce_eq("1 kg cap",  len(bake_manifest_kg_capsules(m)), 1)
    ce_eq("2 prefixes", len(bake_manifest_kg_prefixes(m)), 2)
    ce_eq("1 license",  len(bake_manifest_kg_licenses(m)), 1)
    ce_str_eq("cap[0]",     bake_manifest_allowed_capsules(m)[0], "solar_system")
    ce_str_eq("cap[1]",     bake_manifest_allowed_capsules(m)[1], "physics")
    ce_str_eq("skill[0]",   bake_manifest_allowed_skills(m)[0], "research")
    ce_str_eq("persona[1]", bake_manifest_persona_users(m)[1], "bob")
    ce_str_eq("license[0]", bake_manifest_kg_licenses(m)[0], "OPEN")
    let v = bake_manifest_validate(m)
    ce_eq("validate ok", v[0], 1)
}

fn test_missing_banner_refused() {
    let t = "NAME foo\nVERSION 1\nDOMAIN x\n"
    let r = bake_manifest_parse(t)
    ce_eq("bad banner refused", r[0], 0)
    ce_check("err mentions banner", find_bytes(r[2], "BAKE-MANIFEST") >= 0)
}

fn test_wrong_banner_refused() {
    let t = "BAKE-MANIFEST v99\nNAME foo\n"
    let r = bake_manifest_parse(t)
    ce_eq("wrong banner refused", r[0], 0)
}

fn test_empty_manifest_refused() {
    let r = bake_manifest_parse("")
    ce_eq("empty refused", r[0], 0)
}

fn test_missing_name_fails_validate() {
    let t = "BAKE-MANIFEST v1\nVERSION 1\nDOMAIN x\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses", r[0], 1)
    let v = bake_manifest_validate(r[1])
    ce_eq("validate refuses", v[0], 0)
    ce_check("err says NAME", find_bytes(v[1], "NAME") >= 0)
}

fn test_missing_version_fails_validate() {
    let t = "BAKE-MANIFEST v1\nNAME foo\nDOMAIN x\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses", r[0], 1)
    let v = bake_manifest_validate(r[1])
    ce_eq("validate refuses", v[0], 0)
    ce_check("err says VERSION", find_bytes(v[1], "VERSION") >= 0)
}

fn test_missing_domain_fails_validate() {
    let t = "BAKE-MANIFEST v1\nNAME foo\nVERSION 1\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses", r[0], 1)
    let v = bake_manifest_validate(r[1])
    ce_eq("validate refuses", v[0], 0)
    ce_check("err says DOMAIN", find_bytes(v[1], "DOMAIN") >= 0)
}

fn test_empty_allowlists_legal() {
    let t = "BAKE-MANIFEST v1\nNAME foo\nVERSION 1\nDOMAIN x\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses", r[0], 1)
    let m = r[1]
    ce_eq("validates", bake_manifest_validate(m)[0], 1)
    ce_eq("0 capsules ok",    len(bake_manifest_allowed_capsules(m)), 0)
    ce_eq("0 skills ok",      len(bake_manifest_allowed_skills(m)), 0)
    ce_eq("0 personas ok",    len(bake_manifest_persona_users(m)), 0)
}

fn test_comments_and_blanks_ignored() {
    let t = "# this is a comment\n"
          + "\n"
          + "BAKE-MANIFEST v1\n"
          + "# inline comment\n"
          + "\n"
          + "NAME foo\n"
          + "  \n"
          + "VERSION 1\n"
          + "DOMAIN d\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses despite comments/blanks", r[0], 1)
    ce_str_eq("name",    bake_manifest_name(r[1]),    "foo")
    ce_str_eq("version", bake_manifest_version(r[1]), "1")
}

fn test_duplicate_directives_aggregate() {
    let t = "BAKE-MANIFEST v1\nNAME f\nVERSION 1\nDOMAIN d\n"
          + "ALLOW_CAPSULE a\n"
          + "ALLOW_CAPSULE b\n"
          + "ALLOW_CAPSULE c\n"
          + "PERSONA_USER u1\n"
          + "PERSONA_USER u2\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses", r[0], 1)
    ce_eq("3 capsules aggregated", len(bake_manifest_allowed_capsules(r[1])), 3)
    ce_eq("2 personas aggregated", len(bake_manifest_persona_users(r[1])), 2)
    ce_str_eq("cap[2]", bake_manifest_allowed_capsules(r[1])[2], "c")
}

fn test_unknown_directive_refused() {
    let t = "BAKE-MANIFEST v1\nNAME f\nVERSION 1\nDOMAIN d\n"
          + "UNKNOWN_THING xyz\n"
    let r = bake_manifest_parse(t)
    ce_eq("refused", r[0], 0)
    ce_check("err names directive", find_bytes(r[2], "UNKNOWN_THING") >= 0)
}

fn test_directive_missing_arg_refused() {
    let t = "BAKE-MANIFEST v1\nNAME\n"
    let r = bake_manifest_parse(t)
    ce_eq("NAME with no arg refused", r[0], 0)
}

fn test_roundtrip_serialize_parse() {
    let m1 = bake_manifest_new()
    bake_manifest_set_name(m1, "roundtrip")
    bake_manifest_set_version(m1, "0.9.0")
    bake_manifest_set_domain(m1, "test")
    bake_manifest_set_style(m1, "verbose")
    bake_manifest_add_capsule(m1, "capA")
    bake_manifest_add_capsule(m1, "capB")
    bake_manifest_add_skill(m1, "sk1")
    bake_manifest_add_pattern(m1, "pat1")
    bake_manifest_add_persona(m1, "user_x")
    bake_manifest_add_policy(m1, "auto1")
    bake_manifest_add_kg_capsule(m1, "capA")
    bake_manifest_add_kg_prefix(m1, "wiki_")
    bake_manifest_add_kg_license(m1, "OPEN")
    let text = bake_manifest_serialize(m1)
    ce_check("banner present", find_bytes(text, "BAKE-MANIFEST v1") >= 0)
    let r = bake_manifest_parse(text)
    ce_eq("round-trip parses", r[0], 1)
    let m2 = r[1]
    ce_str_eq("name preserved",    bake_manifest_name(m2),    "roundtrip")
    ce_str_eq("version preserved", bake_manifest_version(m2), "0.9.0")
    ce_str_eq("domain preserved",  bake_manifest_domain(m2),  "test")
    ce_str_eq("style preserved",   bake_manifest_style_pin(m2), "verbose")
    ce_eq("2 caps",   len(bake_manifest_allowed_capsules(m2)), 2)
    ce_eq("1 skill",  len(bake_manifest_allowed_skills(m2)), 1)
    ce_eq("1 pattern", len(bake_manifest_allowed_patterns(m2)), 1)
    ce_eq("1 persona", len(bake_manifest_persona_users(m2)), 1)
    ce_eq("1 policy",  len(bake_manifest_policy_allowlist(m2)), 1)
    ce_eq("1 kg cap",  len(bake_manifest_kg_capsules(m2)), 1)
    ce_eq("1 prefix",  len(bake_manifest_kg_prefixes(m2)), 1)
    ce_eq("1 license", len(bake_manifest_kg_licenses(m2)), 1)
}

fn test_list_has_helper() {
    let lst = list_new()
    push(lst, "foo") push(lst, "bar")
    ce_eq("finds foo", bake_manifest_list_has(lst, "foo"), 1)
    ce_eq("finds bar", bake_manifest_list_has(lst, "bar"), 1)
    ce_eq("misses baz", bake_manifest_list_has(lst, "baz"), 0)
    ce_eq("empty misses", bake_manifest_list_has(list_new(), "x"), 0)
}

fn test_wildcard_survives_roundtrip() {
    let t = "BAKE-MANIFEST v1\nNAME w\nVERSION 1\nDOMAIN d\n"
          + "ALLOW_LICENSE *\n"
          + "ALLOW_SOURCE_PREFIX *\n"
    let r = bake_manifest_parse(t)
    ce_eq("parses wildcard", r[0], 1)
    ce_str_eq("wildcard preserved (license)", bake_manifest_kg_licenses(r[1])[0], "*")
    ce_str_eq("wildcard preserved (prefix)",  bake_manifest_kg_prefixes(r[1])[0], "*")
}

fn test_null_manifest_validate() {
    let v = bake_manifest_validate(0)
    ce_eq("null refused", v[0], 0)
}

fn main() {
    test_fresh_manifest()
    test_parse_happy_path()
    test_missing_banner_refused()
    test_wrong_banner_refused()
    test_empty_manifest_refused()
    test_missing_name_fails_validate()
    test_missing_version_fails_validate()
    test_missing_domain_fails_validate()
    test_empty_allowlists_legal()
    test_comments_and_blanks_ignored()
    test_duplicate_directives_aggregate()
    test_unknown_directive_refused()
    test_directive_missing_arg_refused()
    test_roundtrip_serialize_parse()
    test_list_has_helper()
    test_wildcard_survives_roundtrip()
    test_null_manifest_validate()
    ce_summary("bake_manifest")
}

main()
