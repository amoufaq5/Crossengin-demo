// Unit tests for the R101 per-user preference registry
// (src/preference/user_preference.nova, ADR-0205 Mode 2).
//
// Coverage:
//   * Empty registry
//   * set + get round-trip
//   * Default (unset) visibility
//   * Explicit disable / enable
//   * Wildcard "*" disable at kind level
//   * Wildcard doesn't affect other kinds
//   * clear single / clear_all
//   * list_for_holder isolation
//   * count per holder
//   * Two holders do not interfere
//   * Unknown kind / invalid enabled / empty name refused
//   * Absence-means-visible with reg == 0
//   * Overwrite semantics (last-write-wins)

import "../ce_test.nova"
import "../../src/preference/user_preference.nova"
import "../../src/util/str_safe.nova"

fn test_empty_registry_count() {
    let r = preference_registry_new()
    ce_eq("count 0",   preference_count(r, "alice"), 0)
    ce_eq("count all", preference_registry_count_all(r), 0)
    ce_eq("get unset returns -1",
          preference_get(r, "alice", PREF_KIND_SKILL, "research"), 0 - 1)
}

fn test_set_then_get_roundtrip() {
    let r = preference_registry_new()
    let ok = preference_set(r, "alice", PREF_KIND_SKILL, "research", 0)
    ce_eq("set returned 1", ok, 1)
    ce_eq("get returns 0 (disabled)",
          preference_get(r, "alice", PREF_KIND_SKILL, "research"), 0)
    ce_eq("count 1 for alice", preference_count(r, "alice"), 1)
}

fn test_default_visible_when_unset() {
    let r = preference_registry_new()
    ce_eq("unset -> visible",
          preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 1)
    ce_eq("unset kg -> visible",
          preference_visible(r, "alice", PREF_KIND_KG, "world"), 1)
    ce_eq("unset capsule -> visible",
          preference_visible(r, "bob", PREF_KIND_CAPSULE, "solar_system"), 1)
}

fn test_explicit_disable_hides() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "research", 0)
    ce_eq("disabled -> hidden",
          preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 0)
    // Other names unaffected.
    ce_eq("other name still visible",
          preference_visible(r, "alice", PREF_KIND_SKILL, "echo"), 1)
    // Other holders unaffected.
    ce_eq("other holder still visible",
          preference_visible(r, "bob", PREF_KIND_SKILL, "research"), 1)
}

fn test_explicit_enable_visible() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "research", 1)
    ce_eq("enabled -> visible",
          preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 1)
}

fn test_wildcard_disable_hides_whole_kind() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_PATTERN, "*", 0)
    // Every unmentioned pattern name is now hidden for alice.
    ce_eq("wildcard hides A",
          preference_visible(r, "alice", PREF_KIND_PATTERN, "debug_common"), 0)
    ce_eq("wildcard hides B",
          preference_visible(r, "alice", PREF_KIND_PATTERN, "research_hygiene"), 0)
    ce_eq("wildcard hides C",
          preference_visible(r, "alice", PREF_KIND_PATTERN, "any_random_name"), 0)
    // Other kinds unaffected.
    ce_eq("skill kind unaffected",
          preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 1)
    ce_eq("kg kind unaffected",
          preference_visible(r, "alice", PREF_KIND_KG, "world"), 1)
    ce_eq("capsule kind unaffected",
          preference_visible(r, "alice", PREF_KIND_CAPSULE, "solar_system"), 1)
    // Other holders unaffected.
    ce_eq("other holder unaffected",
          preference_visible(r, "bob", PREF_KIND_PATTERN, "debug_common"), 1)
}

fn test_explicit_enable_overrides_wildcard() {
    // A per-name enable BEATS a kind-wide wildcard disable (explicit
    // entry wins by design; user selectively re-enables one thing).
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_PATTERN, "*", 0)
    preference_set(r, "alice", PREF_KIND_PATTERN, "keeper", 1)
    ce_eq("keeper still visible",
          preference_visible(r, "alice", PREF_KIND_PATTERN, "keeper"), 1)
    ce_eq("others still hidden",
          preference_visible(r, "alice", PREF_KIND_PATTERN, "someone_else"), 0)
}

fn test_clear_single_returns_to_default() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "research", 0)
    ce_eq("hidden before clear",
          preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 0)
    let n = preference_clear(r, "alice", PREF_KIND_SKILL, "research")
    ce_eq("clear returned 1", n, 1)
    ce_eq("visible after clear",
          preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 1)
    ce_eq("count 0 for alice", preference_count(r, "alice"), 0)
}

fn test_clear_missing_returns_zero() {
    let r = preference_registry_new()
    ce_eq("clear missing returns 0",
          preference_clear(r, "alice", PREF_KIND_SKILL, "nope"), 0)
}

fn test_clear_all_returns_count() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "s1", 0)
    preference_set(r, "alice", PREF_KIND_SKILL, "s2", 1)
    preference_set(r, "alice", PREF_KIND_PATTERN, "*", 0)
    preference_set(r, "bob",   PREF_KIND_SKILL, "s1", 0)
    ce_eq("alice count 3 before", preference_count(r, "alice"), 3)
    ce_eq("bob count 1 before",   preference_count(r, "bob"),   1)
    let n = preference_clear_all(r, "alice")
    ce_eq("cleared 3 for alice",  n, 3)
    ce_eq("alice count 0 after",  preference_count(r, "alice"), 0)
    ce_eq("bob count 1 unchanged", preference_count(r, "bob"),  1)
}

fn test_list_for_holder_isolates_others() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "s1", 0)
    preference_set(r, "alice", PREF_KIND_KG,    "k1", 1)
    preference_set(r, "bob",   PREF_KIND_SKILL, "s2", 0)
    let alist = preference_list_for_holder(r, "alice")
    let blist = preference_list_for_holder(r, "bob")
    ce_eq("alice has 2 rows", len(alist), 2)
    ce_eq("bob has 1 row",    len(blist), 1)
    ce_str_eq("alice row 0 kind", alist[0][0], PREF_KIND_SKILL)
    ce_str_eq("alice row 0 name", alist[0][1], "s1")
    ce_eq("alice row 0 enabled", alist[0][2], 0)
    ce_str_eq("bob row 0 kind",   blist[0][0], PREF_KIND_SKILL)
    ce_str_eq("bob row 0 name",   blist[0][1], "s2")
}

fn test_two_holders_do_not_interfere() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "research", 0)
    preference_set(r, "bob",   PREF_KIND_SKILL, "research", 1)
    ce_eq("alice hidden", preference_visible(r, "alice", PREF_KIND_SKILL, "research"), 0)
    ce_eq("bob visible",  preference_visible(r, "bob",   PREF_KIND_SKILL, "research"), 1)
}

fn test_unknown_kind_refused() {
    let r = preference_registry_new()
    ce_eq("unknown kind returns 0",
          preference_set(r, "alice", "nope", "x", 1), 0)
    ce_eq("count 0", preference_count(r, "alice"), 0)
}

fn test_empty_name_refused() {
    let r = preference_registry_new()
    ce_eq("empty name refused",
          preference_set(r, "alice", PREF_KIND_SKILL, "", 1), 0)
}

fn test_invalid_enabled_refused() {
    let r = preference_registry_new()
    ce_eq("enabled 2 refused",
          preference_set(r, "alice", PREF_KIND_SKILL, "s1", 2), 0)
    ce_eq("enabled -1 refused",
          preference_set(r, "alice", PREF_KIND_SKILL, "s1", 0 - 1), 0)
}

fn test_null_reg_visible_default() {
    ce_eq("null reg -> visible",
          preference_visible(0, "alice", PREF_KIND_SKILL, "research"), 1)
    ce_eq("null reg count 0",
          preference_count(0, "alice"), 0)
    ce_eq("null reg get -1",
          preference_get(0, "alice", PREF_KIND_SKILL, "x"), 0 - 1)
    ce_eq("null reg set returns 0",
          preference_set(0, "alice", PREF_KIND_SKILL, "x", 0), 0)
    ce_eq("null reg clear returns 0",
          preference_clear(0, "alice", PREF_KIND_SKILL, "x"), 0)
    ce_eq("null reg clear_all returns 0",
          preference_clear_all(0, "alice"), 0)
    ce_eq("null reg list is empty",
          len(preference_list_for_holder(0, "alice")), 0)
    ce_eq("null reg entries empty",
          len(preference_entries(0)), 0)
}

fn test_overwrite_last_write_wins() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "s1", 0)
    ce_eq("hidden", preference_visible(r, "alice", PREF_KIND_SKILL, "s1"), 0)
    preference_set(r, "alice", PREF_KIND_SKILL, "s1", 1)
    ce_eq("now visible", preference_visible(r, "alice", PREF_KIND_SKILL, "s1"), 1)
    ce_eq("still 1 entry", preference_count(r, "alice"), 1)
}

fn test_kinds_known_matrix() {
    ce_eq("capsule known", preference_is_known_kind(PREF_KIND_CAPSULE), 1)
    ce_eq("skill known",   preference_is_known_kind(PREF_KIND_SKILL),   1)
    ce_eq("pattern known", preference_is_known_kind(PREF_KIND_PATTERN), 1)
    ce_eq("kg known",      preference_is_known_kind(PREF_KIND_KG),      1)
    ce_eq("agent known (R109)", preference_is_known_kind(PREF_KIND_AGENT), 1)
    ce_eq("nope unknown",  preference_is_known_kind("nope"),            0)
    ce_eq("empty unknown", preference_is_known_kind(""),                0)
    ce_eq("kinds list has 5", len(preference_kinds()), 5)
}

fn test_agent_kind_wildcard_hides_all() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_AGENT, "*", 0)
    ce_eq("wildcard hides triage",
          preference_visible(r, "alice", PREF_KIND_AGENT, "triage"), 0)
    ce_eq("wildcard hides bugfix",
          preference_visible(r, "alice", PREF_KIND_AGENT, "bugfix"), 0)
    ce_eq("does not affect bob",
          preference_visible(r, "bob", PREF_KIND_AGENT, "triage"), 1)
    ce_eq("does not affect skill kind",
          preference_visible(r, "alice", PREF_KIND_SKILL, "echo"), 1)
}

fn test_entries_returns_flat() {
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL,   "s1", 0)
    preference_set(r, "alice", PREF_KIND_KG,      "k1", 1)
    preference_set(r, "bob",   PREF_KIND_PATTERN, "*",  0)
    let es = preference_entries(r)
    ce_eq("3 flat entries", len(es), 3)
    // First inserted first (order preserved).
    ce_str_eq("first holder alice", es[0][PREF_ENTRY_HOLDER], "alice")
    ce_str_eq("first kind skill",   es[0][PREF_ENTRY_KIND],   PREF_KIND_SKILL)
    ce_str_eq("third name *",       es[2][PREF_ENTRY_NAME],   "*")
    ce_eq("third enabled 0",        es[2][PREF_ENTRY_ENABLED], 0)
}

fn test_wildcard_enable_no_effect() {
    // A wildcard ENABLE stores but has no visible effect (default is
    // already visible). Explicit per-name entries still win.
    let r = preference_registry_new()
    preference_set(r, "alice", PREF_KIND_SKILL, "*", 1)
    ce_eq("random still visible",
          preference_visible(r, "alice", PREF_KIND_SKILL, "anything"), 1)
    // Add an explicit disable -- it still wins.
    preference_set(r, "alice", PREF_KIND_SKILL, "specific", 0)
    ce_eq("specific still hidden despite wildcard enable",
          preference_visible(r, "alice", PREF_KIND_SKILL, "specific"), 0)
}

fn test_empty_holder_string() {
    // Anonymous ("") is a valid holder value; the registry doesn't
    // block it -- the wire verbs do. Explicit set + read still works.
    let r = preference_registry_new()
    preference_set(r, "", PREF_KIND_SKILL, "s1", 0)
    ce_eq("anonymous hidden",
          preference_visible(r, "", PREF_KIND_SKILL, "s1"), 0)
    ce_eq("named still visible",
          preference_visible(r, "alice", PREF_KIND_SKILL, "s1"), 1)
}

fn main() {
    test_empty_registry_count()
    test_set_then_get_roundtrip()
    test_default_visible_when_unset()
    test_explicit_disable_hides()
    test_explicit_enable_visible()
    test_wildcard_disable_hides_whole_kind()
    test_explicit_enable_overrides_wildcard()
    test_clear_single_returns_to_default()
    test_clear_missing_returns_zero()
    test_clear_all_returns_count()
    test_list_for_holder_isolates_others()
    test_two_holders_do_not_interfere()
    test_unknown_kind_refused()
    test_empty_name_refused()
    test_invalid_enabled_refused()
    test_null_reg_visible_default()
    test_overwrite_last_write_wins()
    test_kinds_known_matrix()
    test_agent_kind_wildcard_hides_all()
    test_entries_returns_flat()
    test_wildcard_enable_no_effect()
    test_empty_holder_string()
    ce_summary("user_preference")
}

main()
