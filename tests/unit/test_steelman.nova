// Unit tests for src/parts/reasoning/steelman.nova (ADR-0090 contested steelman).

import "../ce_test.nova"
import "../../src/parts/reasoning/steelman.nova"

fn _ds2(a, b) {
    let l = list_new()
    push(l, a) push(l, b)
    return l
}

fn test_contested_steelman() {
    // FOR (strong, weight 1000) vs AGAINST (weaker, weight 400), both defeasible:
    // both sides survive as preferred extensions -> steelman both.
    let ds = _ds2(darg_new(0, 1, 1000, 0, 0 - 1, 0 - 1),
                  darg_new(0, 0 - 1, 400, 0, 0 - 1, 0 - 1))
    ce_eq("genuinely contested", steelman_is_contested(ds, 0), 1)
    let pos = steelman_positions(ds, 0)
    ce_eq("two surviving positions", len(pos), 2)
    ce_check("render non-empty", len(steelman_render(ds, 0)) > 0)
    print(steelman_render(ds, 0))
}

fn test_settled_by_proof() {
    // strict proof FOR vs defeasible AGAINST: the opposing side is defeated on the
    // merits -> it is in no preferred extension, NOT steelmanned as a peer.
    let ds = _ds2(darg_new(0, 1, 99000, 1, 0 - 1, 0 - 1),
                  darg_new(0, 0 - 1, 1000, 0, 0 - 1, 0 - 1))
    ce_eq("not contested (proof settles)", steelman_is_contested(ds, 0), 0)
    let pos = steelman_positions(ds, 0)
    ce_eq("one surviving position", len(pos), 1)
    ce_eq("the position SUPPORTS", pos_stance(pos[0]), 1)
}

fn test_kg_steelman() {
    // two clashing empirical studies on a value-laden claim -> contested.
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let claim = kg_add_atom(kg, ATOM_CONCEPT, "min_wage_helps", 0)
    let pro = kg_add_atom(kg, ATOM_CONCEPT, "study_pro", 0)
    let con = kg_add_atom(kg, ATOM_CONCEPT, "study_con", 0)
    atom_set_evidence_grade(pro, GRADE_EMPIRICAL_STRONG)
    atom_set_evidence_grade(con, GRADE_EMPIRICAL_STRONG)
    rop_new(kg, ROP_IMPLY, atom_id(pro), atom_id(claim), "src:a", 0)
    rop_new(kg, ROP_OPPOSITE, atom_id(con), atom_id(claim), "src:b", 0)
    let pos = steelman_atom_positions(kg, atom_id(claim))
    ce_eq("KG contested -> 2 positions", len(pos), 2)
    print(steelman_atom_render(kg, atom_id(claim)))
}

fn test_kg_steelman_prov() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let claim = kg_add_atom(kg, ATOM_CONCEPT, "diet_X_works", 0)
    let pro = kg_add_atom(kg, ATOM_CONCEPT, "trial_pro", 0)
    let con = kg_add_atom(kg, ATOM_CONCEPT, "trial_con", 0)
    atom_set_evidence_grade(pro, GRADE_EMPIRICAL_STRONG)
    atom_set_evidence_grade(con, GRADE_EMPIRICAL_WEAK)
    rop_new(kg, ROP_IMPLY, atom_id(pro), atom_id(claim), "src:journal_a", 0)
    rop_new(kg, ROP_OPPOSITE, atom_id(con), atom_id(claim), "src:journal_b", 0)
    let txt = steelman_atom_render_prov(kg, atom_id(claim))
    ce_check("prov steelman non-empty", len(txt) > 0)
    ce_check("shows pro source", _lic_contains(txt, "src:journal_a") == 1)
    ce_check("shows con source", _lic_contains(txt, "src:journal_b") == 1)
    ce_check("shows a grade", _lic_contains(txt, "empirical") == 1)
    print(txt)
}

fn main() {
    test_contested_steelman()
    test_settled_by_proof()
    test_kg_steelman()
    test_kg_steelman_prov()
    ce_summary("steelman")
}

main()
