// Unit tests for src/substrate/part_registry.nova
// Verifies fixed-part spawning with stable ids, name/id indexing, idempotent
// add, per-part pool/synapse/first-node ownership, and broadcast injection.
// ADR-0001, ADR-0002, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/part_registry.nova"

fn test_spawn_fixed_parts() {
    let reg = part_registry_new()
    ce_eq("empty registry", registry_count(reg), 0)
    let n = registry_spawn_fixed(reg, 256, 8)
    ce_eq("seven fixed parts", n, 7)
    ce_eq("registry count 7", registry_count(reg), 7)
    ce_eq("live count 7", registry_live_count(reg), 7)
    // Stable ids in declared order.
    ce_eq("perception id 0", registry_find(reg, "perception"), 0)
    ce_eq("reasoning id 3", registry_find(reg, "reasoning"), 3)
    ce_eq("meta id 6", registry_find(reg, "meta"), 6)
    ce_eq("missing -> -1", registry_find(reg, "nope"), -1)
}

fn test_part_ownership() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 256, 8)
    let p = registry_get(reg, registry_find(reg, "perception"))
    ce_check("part exists", p != 0)
    ce_str_eq("part name", part_name(p), "perception")
    ce_eq("part preset", part_preset(p), FN_PRESET_PERCEPTION)
    ce_eq("first block width 8", part_first_count(p), 8)
    ce_eq("capacity 256", part_capacity(p), 256)
    ce_check("alive", part_is_alive(p) == 1)
    // The part owns a usable pool and synapse graph.
    let pool = part_pool(p)
    ce_eq("8 first nodes claimed", part_node_count(p), 8)
    let g = part_syn(p)
    let s = syn_new(g, 0, 1, 500, 0)
    ce_eq("part synapse graph usable", syn_live(g), 1)
    // First nodes carry the part's perceiver affinity.
    ce_eq("first node affinity", npm_ntype(pool, 0), NTYPE_PERCEIVER)
}

fn test_idempotent_add() {
    let reg = part_registry_new()
    let id1 = registry_add(reg, "kg-medicine", FN_PRESET_KG, 128, 4)
    let id2 = registry_add(reg, "kg-medicine", FN_PRESET_KG, 128, 4)
    ce_eq("same name same id", id1, id2)
    ce_eq("no duplicate part", registry_count(reg), 1)
    let id3 = registry_add(reg, "kg-law", FN_PRESET_KG, 128, 4)
    ce_eq("distinct name new id", id3, 1)
    ce_eq("two parts", registry_count(reg), 2)
}

fn test_injection_and_bad_id() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    let pid = registry_find(reg, "perception")
    let delivered = part_inject(reg, pid, 250)
    ce_eq("injected to 4 first nodes", delivered, 4)
    let p = registry_get(reg, pid)
    ce_eq("first node received", npm_inbox(part_pool(p), part_first(p)[0]), 250)
    // Out-of-range ids are inert.
    ce_eq("get bad id -> 0", registry_get(reg, 999), 0)
    ce_eq("inject bad id -> 0", part_inject(reg, 999, 100), 0)
    ce_eq("inject negative id -> 0", part_inject(reg, -1, 100), 0)
}

fn main() {
    test_spawn_fixed_parts()
    test_part_ownership()
    test_idempotent_add()
    test_injection_and_bad_id()
    ce_summary("part_registry")
}

main()
