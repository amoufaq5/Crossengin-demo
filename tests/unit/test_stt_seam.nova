// Unit tests for src/io/transducers/stt_seam.nova (P2.5).
//
// Hermetic coverage of the pluggable STT seam. We cover only what is
// testable without microphone hardware (none in the sandbox) and without
// a real whisper.cpp / vosk install (neither is on PATH here). The
// integration path -- spoken utterance -> arecord -> scripts/transcribe.sh
// -> stt_seam -> EV_MESSAGE -- is documented as "deferred until microphone
// hardware" in STT_AUDIT.md.
//
// Assertion targets (the brief asks for ~15):
//   * stt_seam_new() returns a non-zero seam.
//   * stt_default_backend() returns STUB or SUBPROCESS depending on env.
//   * stt_transcribe_wav with the stub backend returns the placeholder
//     + confidence 0 + empty error.
//   * stt_transcribe_wav on a missing file under SUBPROCESS surfaces a
//     bracketed placeholder + zero confidence (via the shim's
//     "[stt: input wav missing]" fallback path).
//   * Registering a custom backend works (we wire a mock id and verify
//     stt_seam_backend_id_for resolves it).
//   * Misc invariants: tag sentinel set, two builtins registered at
//     construction, call_count advances, last_* mirrors track.

import "../ce_test.nova"
import "../../src/io/transducers/stt_seam.nova"

// ---- helpers --------------------------------------------------------------

fn _result_transcript(r) { return r[0] }
fn _result_confidence(r) { return r[1] }
fn _result_error(r)      { return r[2] }

// ---- construction / defaults ---------------------------------------------

fn test_seam_new_returns_nonzero() {
    let s = stt_seam_new()
    ce_check("stt_seam_new returns non-zero", s != 0)
    // Tag sentinel: the first slot is the STT_SEAM_TAG constant
    // (6301). The literal is duplicated here on purpose -- the
    // public API does not expose it.
    ce_eq("seam tag matches STT_SEAM_TAG", s[0], 6301)
}

fn test_seam_default_backend_is_one_of_stub_subprocess_or_whisper() {
    // The env-driven default resolves to:
    //   * STUB (1)       when CE_STT_BACKEND=stub OR unset+no whisper
    //   * SUBPROCESS (2) when CE_STT_BACKEND=subprocess
    //   * WHISPER (4)    when CE_STT_BACKEND=whisper OR unset+whisper installed
    //                    (R8B auto-pick).
    // We don't control the env here, but we DO know stt_default_backend
    // never returns anything else.
    let b = stt_default_backend()
    let valid = 0
    if b == 1 { valid = 1 }       // STT_BACKEND_STUB
    if b == 2 { valid = 1 }       // STT_BACKEND_SUBPROCESS
    if b == 4 { valid = 1 }       // STT_BACKEND_WHISPER
    ce_check("default backend is STUB, SUBPROCESS, or WHISPER", valid == 1)
}

fn test_seam_has_two_builtins_registered() {
    let s = stt_seam_new()
    // The constructor pre-registers "stub" + "subprocess" + (R8B)
    // "whisper" so stt_seam_backend_name has a string to return
    // even before any transcribe call. Count is therefore >= 3,
    // and each name resolves to its expected id.
    let stub_id = stt_seam_backend_id_for(s, "stub")
    let sub_id  = stt_seam_backend_id_for(s, "subprocess")
    let wh_id   = stt_seam_backend_id_for(s, "whisper")
    ce_eq("stub backend registered", stub_id, 1)         // STT_BACKEND_STUB
    ce_eq("subprocess backend registered", sub_id, 2)    // STT_BACKEND_SUBPROCESS
    ce_eq("whisper backend registered", wh_id, 4)        // STT_BACKEND_WHISPER (R8B)
    let missing = stt_seam_backend_id_for(s, "no-such-backend")
    ce_eq("absent backend resolves to NONE", missing, 0) // STT_BACKEND_NONE
}

fn test_seam_enabled_after_new() {
    let s = stt_seam_new()
    // stt_seam_enabled returns 1 iff registered_count > 0. Since
    // construction pre-registers the two builtins, this should be 1.
    ce_eq("seam reports enabled after construction", stt_seam_enabled(s), 1)
}

fn test_seam_backend_name_resolves_default() {
    let s = stt_seam_new()
    // Force the default to STUB so the test is independent of env.
    stt_seam_set_default(s, 1)
    ce_str_eq("default backend name is 'stub'", stt_seam_backend_name(s), "stub")
    stt_seam_set_default(s, 2)
    ce_str_eq("subprocess backend name resolves", stt_seam_backend_name(s), "subprocess")
}

// ---- stub backend behaviour ----------------------------------------------

fn test_stub_returns_placeholder() {
    let s = stt_seam_new()
    stt_seam_set_default(s, 1)               // force STUB
    let r = stt_transcribe_wav(s, "/tmp/anything.wav")
    ce_str_eq("stub transcript is the placeholder",
              _result_transcript(r), "[stt unavailable]")
    ce_eq("stub confidence is 0", _result_confidence(r), 0)
    ce_str_eq("stub error is empty", _result_error(r), "")
}

fn test_stub_mirrors_last_state() {
    let s = stt_seam_new()
    stt_seam_set_default(s, 1)
    ce_eq("call_count starts at 0", stt_seam_call_count(s), 0)
    stt_transcribe_wav(s, "/tmp/a.wav")
    stt_transcribe_wav(s, "/tmp/b.wav")
    ce_eq("call_count advances per call", stt_seam_call_count(s), 2)
    ce_str_eq("last_transcript mirrors stub output",
              stt_seam_last_transcript(s), "[stt unavailable]")
    ce_eq("last_confidence mirrors stub output", stt_seam_last_confidence(s), 0)
}

// ---- subprocess backend / missing file edge ------------------------------

fn test_subprocess_missing_file_returns_placeholder() {
    let s = stt_seam_new()
    stt_seam_set_default(s, 2)               // force SUBPROCESS
    // scripts/transcribe.sh prints "[stt: input wav missing]" with
    // exit 0 when the WAV is absent. The seam recognises the bracketed
    // "[stt..." prefix and maps it to confidence 0 with the bracketed
    // line preserved in the transcript slot.
    let r = stt_transcribe_wav(s, "/tmp/definitely-not-a-file.wav")
    let t = _result_transcript(r)
    let c = _result_confidence(r)
    // We don't know whether the daemon runs from the repo root in
    // every CI shape, so the test tolerates either of two outcomes:
    //   (a) the shim ran and emitted "[stt: input wav missing]" (or
    //       "[stt: no backend installed]"), and the seam mapped it to
    //       a placeholder triple with confidence 0.
    //   (b) the shim wasn't reachable -- the seam returned the stub
    //       placeholder "[stt unavailable]" with confidence 0.
    // Both outcomes have confidence 0 and a transcript that begins
    // with "[stt", which is exactly the placeholder predicate.
    let n = len(t)
    let prefix_ok = 0
    if n >= 4 {
        if char_at(t, 0) == 91 {       // '['
            if char_at(t, 1) == 115 {  // 's'
                if char_at(t, 2) == 116 {  // 't'
                    if char_at(t, 3) == 116 {  // 't'
                        prefix_ok = 1
                    }
                }
            }
        }
    }
    ce_eq("missing-file path yields '[stt...' prefix transcript", prefix_ok, 1)
    ce_eq("missing-file path yields confidence 0", c, 0)
}

// ---- pluggable backend registration -------------------------------------

let MOCK_BACKEND_ID = 99

fn test_register_custom_backend() {
    let s = stt_seam_new()
    // Register a brand-new id. Confirm the registry maps name<->id.
    stt_register_backend(s, "mock", MOCK_BACKEND_ID)
    let resolved = stt_seam_backend_id_for(s, "mock")
    ce_eq("custom backend registered with given id", resolved, MOCK_BACKEND_ID)
    // Re-registering the same name updates in place (no duplicate).
    stt_register_backend(s, "mock", MOCK_BACKEND_ID + 1)
    let again = stt_seam_backend_id_for(s, "mock")
    ce_eq("re-registering updates id in place", again, MOCK_BACKEND_ID + 1)
}

fn test_set_default_to_custom_does_not_call_stub() {
    // The dispatcher falls back to the STUB path for any id that is
    // NOT STT_BACKEND_SUBPROCESS. A custom backend id therefore lands
    // on the stub branch (we have no function-pointer plumbing yet --
    // that's the next iteration). Verify the documented behaviour: a
    // never-implemented mock backend still returns the stub triple,
    // never NULL.
    let s = stt_seam_new()
    stt_register_backend(s, "mock-pluggable", MOCK_BACKEND_ID)
    stt_seam_set_default(s, MOCK_BACKEND_ID)
    let r = stt_transcribe_wav(s, "/tmp/x.wav")
    ce_str_eq("custom id falls through to stub placeholder",
              _result_transcript(r), "[stt unavailable]")
    ce_eq("custom id falls through to confidence 0",
          _result_confidence(r), 0)
}

// ---- result-triple shape -------------------------------------------------

fn test_result_helpers() {
    let s = stt_seam_new()
    stt_seam_set_default(s, 1)
    let r = stt_transcribe_wav(s, "/tmp/y.wav")
    ce_check("result is a 3-element list", len(r) == 3)
    ce_str_eq("stt_result_transcript helper",
              stt_result_transcript(r), "[stt unavailable]")
    ce_eq("stt_result_confidence helper",
          stt_result_confidence(r), 0)
    ce_str_eq("stt_result_error helper",
              stt_result_error(r), "")
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_seam_new_returns_nonzero()
    test_seam_default_backend_is_one_of_stub_subprocess_or_whisper()
    test_seam_has_two_builtins_registered()
    test_seam_enabled_after_new()
    test_seam_backend_name_resolves_default()
    test_stub_returns_placeholder()
    test_stub_mirrors_last_state()
    test_subprocess_missing_file_returns_placeholder()
    test_register_custom_backend()
    test_set_default_to_custom_does_not_call_stub()
    test_result_helpers()
    ce_summary("stt_seam")
}

main()
