// Unit tests for src/reader/spreading_activation.nova
// Verifies that activation seeded on a chosen sense spreads over cross-KG edges
// with decay and settles: near neighbors clear the threshold, distant ones
// decay below it. ADR-0012 stage 3.

import "../ce_test.nova"
import "../../src/reader/context_bias.nova"
import "../../src/reader/spreading_activation.nova"

fn build() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    let c1 = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    let c2 = kg_add_atom(med, ATOM_CONCEPT, "bacteria", 0)
    // c0 -> c1 -> c2 chain of strong causal references.
    atom_add_xref(c0, xref_new(c0, c1, XREF_CAUSAL, 800, 1))
    atom_add_xref(c1, xref_new(c1, c2, XREF_CAUSAL, 800, 1))
    let fever = word_atom_new(lang, "fever", 0)
    word_add_sense(fever, c0, 900)
    return renv_new(reg, lang, 0, 0, 0)
}

fn test_spread() {
    let e = build()
    let c = rctx_new("fever")
    reader_anchor(e, c)
    reader_bias(e, c, list_new())   // chooses the single sense c0
    let active = reader_spread(e, c)

    let h0 = handle_new("med", 0)   // pyrexia (seed)
    let h1 = handle_new("med", 1)   // infection (1 hop)
    let h2 = handle_new("med", 2)   // bacteria (2 hops, decayed below threshold)

    ce_eq("seed fully active", reader_activation(c, h0), SPREAD_SEED)
    ce_eq("one hop = 0.8*0.5 = 0.4", reader_activation(c, h1), 400)
    ce_check("two hops decays below threshold", reader_activation(c, h2) < SPREAD_THRESHOLD)
    ce_eq("seed and near neighbor settle", active, 2)
    ce_eq("seed is active", reader_is_active(c, h0), 1)
    ce_eq("near neighbor active", reader_is_active(c, h1), 1)
    ce_eq("distant not active", reader_is_active(c, h2), 0)
}

fn test_no_senses_no_spread() {
    // A word with no senses seeds nothing -> empty active set.
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "fever", 0)   // no senses attached
    let e = renv_new(reg, lang, 0, 0, 0)
    let c = rctx_new("fever")
    reader_anchor(e, c)
    reader_bias(e, c, list_new())
    ce_eq("nothing to spread", reader_spread(e, c), 0)
}

fn main() {
    test_spread()
    test_no_senses_no_spread()
    ce_summary("spreading_activation")
}

main()
