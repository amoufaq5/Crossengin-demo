// Unit tests for src/learning/learning_policy.nova: the ADR-0096 ML-policy gate.
// The permitted family is allowed; each forbidden technique is refused for the
// RIGHT litmus reason; unknown techniques fail closed; the litmus is the gate.

import "../ce_test.nova"
import "../../src/learning/learning_policy.nova"

// The whole permitted family is PERMITTED.
fn test_permitted_family() {
    ce_eq("bayesian", mlp_technique_decide(LT_BAYESIAN), MLP_PERMITTED)
    ce_eq("hebbian", mlp_technique_decide(LT_HEBBIAN), MLP_PERMITTED)
    ce_eq("three-factor", mlp_technique_decide(LT_THREE_FACTOR), MLP_PERMITTED)
    ce_eq("forward-forward", mlp_technique_decide(LT_FORWARD_FORWARD), MLP_PERMITTED)
    ce_eq("hdc-vsa", mlp_technique_decide(LT_HDC_VSA), MLP_PERMITTED)
    ce_eq("predictive-coding", mlp_technique_decide(LT_PREDICTIVE_CODING), MLP_PERMITTED)
    ce_eq("is_permitted convenience", mlp_is_permitted(LT_BAYESIAN), 1)
}

// Each forbidden technique is FORBIDDEN.
fn test_forbidden_family() {
    ce_eq("llm cognition", mlp_technique_decide(LT_LLM_COGNITION), MLP_FORBIDDEN)
    ce_eq("frozen deep model", mlp_technique_decide(LT_FROZEN_DEEP_MODEL), MLP_FORBIDDEN)
    ce_eq("global backprop", mlp_technique_decide(LT_GLOBAL_BACKPROP), MLP_FORBIDDEN)
    ce_eq("offline batch", mlp_technique_decide(LT_OFFLINE_BATCH), MLP_FORBIDDEN)
    ce_eq("forbidden not permitted", mlp_is_permitted(LT_LLM_COGNITION), 0)
}

// Unknown technique fails CLOSED to forbidden (must be vetted, not assumed safe).
fn test_unknown_fails_closed() {
    ce_eq("unknown -> forbidden", mlp_technique_decide(9999), MLP_FORBIDDEN)
}

// The litmus is the real gate: any single criterion failing -> forbidden, even
// if the others pass.
fn test_litmus_each_criterion() {
    ce_eq("all four pass -> permitted", mlp_litmus(1, 1, 1, 0), MLP_PERMITTED)
    ce_eq("not online -> forbidden", mlp_litmus(0, 1, 1, 0), MLP_FORBIDDEN)
    ce_eq("not local -> forbidden", mlp_litmus(1, 0, 1, 0), MLP_FORBIDDEN)
    ce_eq("not auditable -> forbidden", mlp_litmus(1, 1, 0, 0), MLP_FORBIDDEN)
    ce_eq("frozen artifact -> forbidden", mlp_litmus(1, 1, 1, 1), MLP_FORBIDDEN)
}

// The forbidden techniques each fail the EXPECTED criterion (the ruling text
// names it). Probe via str_find with the "contains" idiom (!= -1).
fn test_forbidden_reasons() {
    ce_check("global backprop cited as not-local",
        str_find(mlp_ruling(LT_GLOBAL_BACKPROP), "not LOCAL") != (0 - 1))
    ce_check("offline batch cited as not-online",
        str_find(mlp_ruling(LT_OFFLINE_BATCH), "not ONLINE") != (0 - 1))
    ce_check("frozen model cited as frozen",
        str_find(mlp_ruling(LT_FROZEN_DEEP_MODEL), "FROZEN") != (0 - 1))
    ce_check("permitted ruling says PERMITTED",
        str_find(mlp_ruling(LT_BAYESIAN), "PERMITTED") != (0 - 1))
}

fn test_names() {
    ce_check("permitted name", str_find(mlp_decision_name(MLP_PERMITTED), "permitted") != (0 - 1))
    ce_check("forbidden name", str_find(mlp_decision_name(MLP_FORBIDDEN), "forbidden") != (0 - 1))
}

fn main() {
    test_permitted_family()
    test_forbidden_family()
    test_unknown_fails_closed()
    test_litmus_each_criterion()
    test_forbidden_reasons()
    test_names()
    ce_summary("learning_policy")
}

main()
