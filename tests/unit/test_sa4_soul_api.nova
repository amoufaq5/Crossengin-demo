// Unit tests for the public soul checks the network glue uses (A2.4a):
//   - sa4s_round_ok gives "" for a round the soul accepts and the soul's own
//     abort code otherwise (bad_fp, stale_round, bad_len, bad_layout,
//     no_input, unexpected, bad_line), so the chat can refuse to save a
//     round id for a round it will refuse (no round-id burn);
//   - sa4s_abort wipes every round secret (a transport failure mid-round)
//     and returns one SA4_ABORT line; it leaves a DONE or ABORTED soul as
//     it is.

import "../ce_test.nova"
import "../sa4_harness.nova"

fn main() {
    let vc = list_new()
    let ro = sa4h_roster(3)
    let s0 = sa4h_souls(ro, 3, 5, vc, 4)[0]
    let fp = sa4w_unhex(sroster_fingerprint(ro), 32)
    ce_str_eq("round_ok: accepted", sa4s_round_ok(s0, sa4w_parse(sa4h_round_line(ro, 5))), "")
    let fpx = sa4w_unhex(sroster_fingerprint(ro), 32)
    list_set(fpx, 0, int_xor(fpx[0], 1))
    ce_str_eq("round_ok: bad_fp", sa4s_round_ok(s0, sa4w_parse(sa4w_fmt_round(5, fpx, SA4H_L, sa4h_layout()))), "bad_fp")
    ce_str_eq("round_ok: bad_fp even with a huge round id", sa4s_round_ok(s0, sa4w_parse(sa4w_fmt_round(int_shl(1, 61) - 1 + int_shl(1, 61), fpx, SA4H_L, sa4h_layout()))), "bad_fp")
    ce_str_eq("round_ok: stale_round (= last)", sa4s_round_ok(s0, sa4w_parse(sa4h_round_line(ro, 4))), "stale_round")
    ce_str_eq("round_ok: stale_round (< last)", sa4s_round_ok(s0, sa4w_parse(sa4h_round_line(ro, 1))), "stale_round")
    ce_str_eq("round_ok: bad_len", sa4s_round_ok(s0, sa4w_parse(sa4w_fmt_round(5, fp, SA4H_L + 1, sa4h_layout()))), "bad_len")
    ce_str_eq("round_ok: bad_layout", sa4s_round_ok(s0, sa4w_parse(sa4w_fmt_round(5, fp, SA4H_L, fpx))), "bad_layout")
    ce_str_eq("round_ok: not a round line", sa4s_round_ok(s0, sa4w_parse(sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3])))), "unexpected")
    ce_str_eq("round_ok: unparsable", sa4s_round_ok(s0, 0), "bad_line")
    let e = sroster_entries(ro)[0]
    let fresh = sa4s_new(ro, e, ed25519_hex_to_bytes(SA4H_SEEDS[0]), sa4h_rng(e[0], 5), vc, 4)
    ce_str_eq("round_ok: no input", sa4s_round_ok(fresh, sa4w_parse(sa4h_round_line(ro, 5))), "no_input")
    ce_eq("round_ok: checking does not change the state", sa4s_state(s0), SA4S_ST_IDLE)

    // Abort mid-round: secrets wiped, one abort line, state ABORTED.
    let s1 = sa4h_souls(ro, 3, 5, vc, 4)[0]
    let h1 = sa4s_handle(s1, sa4h_round_line(ro, 5))
    ce_eq("abort: round handled", h1[0], 1)
    let ab = sa4s_abort(s1, "transport", "the coordinator closed the connection")
    ce_eq("abort: refused result", ab[0], 0)
    ce_eq("abort: one line", len(ab[2]), 1)
    ce_str_eq("abort: the line", ab[2][0], sa4w_fmt_abort(5, e[0], "transport"))
    ce_eq("abort: state ABORTED", sa4s_state(s1), SA4S_ST_ABORTED)
    ce_eq("abort: secrets wiped", sa4h_wiped(s1), 1)
    ce_eq("abort: a second abort sends nothing", len(sa4s_abort(s1, "transport", "x")[2]), 0)
    ce_eq("abort: a line after the abort sends nothing", len(sa4s_handle(s1, sa4h_round_line(ro, 6))[2]), 0)
    let s2 = sa4h_souls(ro, 3, 5, vc, 4)[0]
    ce_eq("abort: an idle soul aborts too", len(sa4s_abort(s2, "transport", "x")[2]), 1)
    ce_summary("sa4_soul_api")
}

main()
