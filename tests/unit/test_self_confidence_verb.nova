// Unit tests for the R103 `self.confidence` wire verb.
//
// Fabricates a small KG with atoms of varying confidence, then drives
// self.confidence through rpc_dispatch. Covers exact / fuzzy / hybrid
// modes, aggregate weighted mean, majority epistemic_status, empty-KG
// fallthroughs, cap gate (reader OK, anonymous refused when enforcement
// wired), and malformed-arg refusals.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/sandbox/capability.nova"
import "../../src/util/str_safe.nova"

// ---- fixture --------------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// Seed a KG with the given (label, alpha) pairs (beta computed to keep
// alpha+beta=5000, so alpha=4000 -> confidence 800/1000).
fn _seed_atom(kg, label, alpha) {
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    let b = atom_belief(a)
    list_set(b, 0, alpha)
    list_set(b, 1, 5000 - alpha)
    return a
}

fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "physics")
    _seed_atom(kg, "einstein",       4000)  // conf 800 (corroborated-ish)
    _seed_atom(kg, "quantum",        3000)  // conf 600 (believed)
    _seed_atom(kg, "relativity",     4500)  // conf 900 (corroborated)
    _seed_atom(kg, "photon",         1500)  // conf 300 (refuted region)
    _seed_atom(kg, "spooky_action",  2000)  // conf 400
    let kg2 = kg_spawn(reg, "biology")
    _seed_atom(kg2, "dna",           4200)  // conf 840
    return reg
}

fn _mk_ctx_with_gaps() {
    let kgreg = _mk_kgreg()
    let ctx = rpc_ctx_new(kgreg, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_gaps_reg(ctx, gaps_register_new(0))
    return ctx
}

// ---- happy path: exact mode ----------------------------------------------

fn test_confidence_exact_hit() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "einstein", "mode", "exact"), ctx)
    ce_check("ok:true",                _has(out, "\"ok\":true"))
    ce_check("mode echoed exact",      _has(out, "\"mode\":\"exact\""))
    ce_check("matched_atom_count=1",   _has(out, "\"matched_atom_count\":1"))
    // conf 800: alpha=4000, beta=1000 -> 4000/5000 = 800
    ce_check("aggregate_confidence 800",
             _has(out, "\"aggregate_confidence_milli\":800"))
    ce_check("matches array present",  _has(out, "\"matches\":["))
    ce_check("label in matches",       _has(out, "\"label\":\"einstein\""))
}

fn test_confidence_exact_miss_returns_empty() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "not_a_label", "mode", "exact"), ctx)
    ce_check("ok:true",              _has(out, "\"ok\":true"))
    ce_check("matched=0",            _has(out, "\"matched_atom_count\":0"))
    ce_check("aggregate=0",          _has(out, "\"aggregate_confidence_milli\":0"))
    // Majority over empty falls back to EP_UNKNOWN.
    ce_check("status=unknown",       _has(out, "\"epistemic_status\":\"unknown\""))
}

// ---- fuzzy mode -----------------------------------------------------------

fn test_confidence_fuzzy_returns_top_k() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "einstein", "mode", "fuzzy"), ctx)
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("mode fuzzy",             _has(out, "\"mode\":\"fuzzy\""))
    // Fuzzy over one-word "einstein" will match the einstein atom with
    // very high similarity; at least one match must survive.
    ce_check("at least one match",     _has(out, "\"label\":\"einstein\""))
}

fn test_confidence_fuzzy_empty_query_no_matches() {
    // Empty query must not crash; ss_search returns empty hits for a
    // zero-length query.
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", " ", "mode", "fuzzy"), ctx)
    // topic=" " is non-empty (1 char) so ss_search may produce 0 hits
    // legitimately -- we just verify the envelope is a well-formed ok.
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("mode fuzzy",             _has(out, "\"mode\":\"fuzzy\""))
}

// ---- hybrid mode (exact-first, fuzzy-fallback) ---------------------------

fn test_confidence_hybrid_exact_takes_precedence() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args1("topic", "einstein"), ctx)     // default mode = hybrid
    ce_check("ok",                     _has(out, "\"ok\":true"))
    // hybrid finds the exact match and reports mode=exact.
    ce_check("mode=exact via hybrid",  _has(out, "\"mode\":\"exact\""))
    ce_check("matched=1",              _has(out, "\"matched_atom_count\":1"))
}

fn test_confidence_hybrid_falls_through_to_fuzzy() {
    // Topic with no exact label match; hybrid should fall through to
    // fuzzy. Use a substring that matches the TF-IDF tokenizer.
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "einstein_similar_query", "mode", "hybrid"), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    // A fuzzy path with this compound token may or may not match given
    // TF-IDF tokenization; we assert only envelope shape (mode reflects
    // whichever path fired last).
    ce_check("mode is exact or fuzzy",
             _has(out, "\"mode\":\"fuzzy\"") == 1
             || _has(out, "\"mode\":\"exact\"") == 1)
}

// ---- empty KG -------------------------------------------------------------

fn test_confidence_empty_kg_returns_empty_matches() {
    let empty_reg = kg_registry_new()
    let ctx = rpc_ctx_new(empty_reg, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_gaps_reg(ctx, gaps_register_new(0))
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "einstein", "mode", "hybrid"), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("matched=0",             _has(out, "\"matched_atom_count\":0"))
    ce_check("aggregate=0",           _has(out, "\"aggregate_confidence_milli\":0"))
}

fn test_confidence_null_kgreg_still_returns_ok() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("self.confidence",
        _args1("topic", "einstein"), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("matched=0",             _has(out, "\"matched_atom_count\":0"))
}

// ---- malformed arg refusals ----------------------------------------------

fn test_confidence_missing_topic_refuses() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence", list_new(), ctx)
    ce_check("ok:false",              _has(out, "\"ok\":false"))
    ce_check("names arg",             _has(out, "topic"))
}

fn test_confidence_empty_topic_refuses() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args1("topic", ""), ctx)
    ce_check("ok:false",              _has(out, "\"ok\":false"))
    ce_check("says non-empty",        _has(out, "non-empty"))
}

fn test_confidence_unknown_mode_refuses() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "einstein", "mode", "wat"), ctx)
    ce_check("ok:false",              _has(out, "\"ok\":false"))
    ce_check("names bad mode",        _has(out, "wat"))
}

// ---- cap gate -------------------------------------------------------------

fn test_confidence_cap_required_lookup() {
    ce_check("verb requires nl:self:read",
        str_eq_bytes(capability_verb_required("self.confidence"),
                     CAP_NL_SELF_READ) == 1)
}

fn test_confidence_cap_reader_role_includes() {
    let caps = capability_role_expand("reader")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_NL_SELF_READ) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("reader has nl:self:read", saw, 1)
}

fn test_confidence_cap_admin_role_includes() {
    let caps = capability_role_expand("admin")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_NL_SELF_READ) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin has nl:self:read", saw, 1)
}

fn test_confidence_cap_is_known() {
    ce_eq("known cap",
          capability_is_known_cap(CAP_NL_SELF_READ), 1)
}

fn test_confidence_anonymous_refused_when_enforced() {
    // Wire enforcement ON. Anonymous caller has no token -> refused
    // with "capability required" (the sandbox layer's error shape).
    let ctx = _mk_ctx_with_gaps()
    let cap_reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    let out = rpc_dispatch("self.confidence",
        _args1("topic", "einstein"), ctx)
    ce_check("ok:false",              _has(out, "\"ok\":false"))
    ce_check("names cap",             _has(out, "nl:self:read"))
}

fn test_confidence_reader_token_authorised() {
    let ctx = _mk_ctx_with_gaps()
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "alice", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    let out = rpc_dispatch("self.confidence",
        _args1("topic", "einstein"), ctx)
    ce_check("ok:true",               _has(out, "\"ok\":true"))
    ce_check("matched=1",             _has(out, "\"matched_atom_count\":1"))
}

// ---- verb registration ---------------------------------------------------

fn test_verb_in_names() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "self.confidence") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("self.confidence registered", saw, 1)
}

// ---- aggregate confidence math -------------------------------------------

fn test_confidence_aggregate_weighted_mean() {
    // Exact-mode single-atom aggregate is just the atom's confidence.
    // Verified via einstein above. Here we also exercise relativity to
    // confirm distinct confidences propagate through the weighted mean.
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "relativity", "mode", "exact"), ctx)
    ce_check("relativity confidence = 900",
             _has(out, "\"aggregate_confidence_milli\":900"))
}

fn test_confidence_matches_carry_per_atom_conf() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "photon", "mode", "exact"), ctx)
    ce_check("photon confidence 300",
             _has(out, "\"confidence_milli\":300"))
    ce_check("similarity 1000 for exact",
             _has(out, "\"similarity_milli\":1000"))
}

fn test_confidence_matches_include_tier_and_grade() {
    let ctx = _mk_ctx_with_gaps()
    let out = rpc_dispatch("self.confidence",
        _args2("topic", "einstein", "mode", "exact"), ctx)
    ce_check("tier field present",   _has(out, "\"tier\":"))
    ce_check("grade field present",  _has(out, "\"grade\":"))
    ce_check("evidence_count present",
             _has(out, "\"evidence_count\":"))
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_confidence_exact_hit()
    test_confidence_exact_miss_returns_empty()

    test_confidence_fuzzy_returns_top_k()
    test_confidence_fuzzy_empty_query_no_matches()

    test_confidence_hybrid_exact_takes_precedence()
    test_confidence_hybrid_falls_through_to_fuzzy()

    test_confidence_empty_kg_returns_empty_matches()
    test_confidence_null_kgreg_still_returns_ok()

    test_confidence_missing_topic_refuses()
    test_confidence_empty_topic_refuses()
    test_confidence_unknown_mode_refuses()

    test_confidence_cap_required_lookup()
    test_confidence_cap_reader_role_includes()
    test_confidence_cap_admin_role_includes()
    test_confidence_cap_is_known()
    test_confidence_anonymous_refused_when_enforced()
    test_confidence_reader_token_authorised()

    test_verb_in_names()

    test_confidence_aggregate_weighted_mean()
    test_confidence_matches_carry_per_atom_conf()
    test_confidence_matches_include_tier_and_grade()

    ce_summary("self_confidence_verb")
    return 0
}

main()
