// Unit tests for src/parts/action/action_atoms.nova
//
// Verifies the Intent record type: constructors round-trip through
// accessors, kind / effector-class name mappings are non-empty, the
// in_kind_to_effector_class mapping is complete, and predicates
// (in_is_speak / in_is_internal) match the underlying kind slot.
// ADR-0093 (Phase N R2).

import "../ce_test.nova"
import "../../src/parts/action/action_atoms.nova"

// ---- SPEAK intent --------------------------------------------------------
fn test_speak_intent() {
    let ts = 12345
    let text = "hello world"
    let i = intent_speak_new(ts, text, 7, 800, 42)
    ce_check("speak intent tagged", in_is_intent(i) == 1)
    ce_eq("speak ts", in_timestamp_ns(i), ts)
    ce_eq("speak kind", in_kind(i), IN_KIND_SPEAK)
    ce_str_eq("speak text", in_text(i), "hello world")
    ce_eq("speak goal id", in_goal_id(i), 7)
    ce_eq("speak confidence", in_confidence(i), 800)
    ce_eq("speak source percept id", in_source_percept_id(i), 42)
    ce_eq("speak effector class", in_effector_class(i), EFF_CLASS_SPEAK)
    ce_check("speak is speak", in_is_speak(i) == 1)
    ce_check("speak not internal", in_is_internal(i) == 0)
    ce_str_eq("speak role default", in_role(i), "")
    ce_eq("speak linked percept default", in_linked_percept(i), 0)
    ce_str_eq("speak trace ref default", in_trace_ref(i), "")
    ce_str_eq("speak reason default", in_reason(i), "")
}

// ---- INTERNAL intent -----------------------------------------------------
fn test_internal_intent() {
    let i = intent_internal_new(9999, "nothing")
    ce_check("internal intent tagged", in_is_intent(i) == 1)
    ce_eq("internal ts", in_timestamp_ns(i), 9999)
    ce_eq("internal kind", in_kind(i), IN_KIND_INTERNAL)
    ce_str_eq("internal reason", in_reason(i), "nothing")
    // The R2 backwards-compat contract: an INTERNAL intent with reason
    // "nothing" carries the pre-R2 "i have nothing to say" template on
    // IN_TEXT so the loop shim can unconditionally emit in_text(intent)
    // and still produce byte-identical ctx_output.
    ce_str_eq("internal emits nothing text", in_text(i),
              "i have nothing to say")
    ce_eq("internal effector class", in_effector_class(i),
          EFF_CLASS_INTERNAL)
    ce_check("internal is internal", in_is_internal(i) == 1)
    ce_check("internal not speak", in_is_speak(i) == 0)
}

fn test_internal_intent_custom_reason() {
    let i = intent_internal_new(1, "reflect")
    // A non-"nothing" reason is stored verbatim on both IN_REASON and
    // IN_TEXT (the shim emits whatever we set on IN_TEXT).
    ce_str_eq("internal reflect reason", in_reason(i), "reflect")
    ce_str_eq("internal reflect text", in_text(i), "reflect")
}

// ---- TOOL intent ---------------------------------------------------------
fn test_tool_intent() {
    let i = intent_tool_new(555, "web_search", 3, 700, 88, EFF_CLASS_HTTP)
    ce_check("tool intent tagged", in_is_intent(i) == 1)
    ce_eq("tool ts", in_timestamp_ns(i), 555)
    ce_eq("tool kind", in_kind(i), IN_KIND_TOOL_CALL)
    ce_str_eq("tool text", in_text(i), "web_search")
    ce_eq("tool goal id", in_goal_id(i), 3)
    ce_eq("tool confidence", in_confidence(i), 700)
    ce_eq("tool source percept id", in_source_percept_id(i), 88)
    ce_eq("tool effector class override", in_effector_class(i),
          EFF_CLASS_HTTP)
    ce_check("tool not speak", in_is_speak(i) == 0)
    ce_check("tool not internal", in_is_internal(i) == 0)
}

fn test_tool_intent_default_class() {
    // Passing 0 as effector_class picks EFF_CLASS_TOOL by default.
    let i = intent_tool_new(1, "compute", 0, 500, 0, 0)
    ce_eq("tool default class", in_effector_class(i), EFF_CLASS_TOOL)
}

// ---- kind name mapping ---------------------------------------------------
fn test_kind_names() {
    ce_str_eq("kind speak name", in_kind_name(IN_KIND_SPEAK), "speak")
    ce_str_eq("kind tool_call name", in_kind_name(IN_KIND_TOOL_CALL),
              "tool_call")
    ce_str_eq("kind file_op name", in_kind_name(IN_KIND_FILE_OP),
              "file_op")
    ce_str_eq("kind http_action name", in_kind_name(IN_KIND_HTTP_ACTION),
              "http_action")
    ce_str_eq("kind code_exec name", in_kind_name(IN_KIND_CODE_EXEC),
              "code_exec")
    ce_str_eq("kind mcp name", in_kind_name(IN_KIND_MCP), "mcp")
    ce_str_eq("kind audio name", in_kind_name(IN_KIND_AUDIO), "audio")
    ce_str_eq("kind internal name", in_kind_name(IN_KIND_INTERNAL),
              "internal")
    ce_str_eq("kind unknown name", in_kind_name(999), "unknown")
}

fn test_effector_class_names() {
    ce_str_eq("class speak name", in_effector_class_name(EFF_CLASS_SPEAK),
              "speak")
    ce_str_eq("class tool name", in_effector_class_name(EFF_CLASS_TOOL),
              "tool")
    ce_str_eq("class file name", in_effector_class_name(EFF_CLASS_FILE),
              "file")
    ce_str_eq("class http name", in_effector_class_name(EFF_CLASS_HTTP),
              "http")
    ce_str_eq("class code name", in_effector_class_name(EFF_CLASS_CODE),
              "code")
    ce_str_eq("class mcp name", in_effector_class_name(EFF_CLASS_MCP),
              "mcp")
    ce_str_eq("class audio name",
              in_effector_class_name(EFF_CLASS_AUDIO), "audio")
    ce_str_eq("class internal name",
              in_effector_class_name(EFF_CLASS_INTERNAL), "internal")
    ce_str_eq("class unknown name", in_effector_class_name(42), "unknown")
}

// ---- kind -> effector class ----------------------------------------------
fn test_kind_to_effector_class() {
    ce_eq("speak -> speak class",
          in_kind_to_effector_class(IN_KIND_SPEAK), EFF_CLASS_SPEAK)
    ce_eq("tool -> tool class",
          in_kind_to_effector_class(IN_KIND_TOOL_CALL), EFF_CLASS_TOOL)
    ce_eq("file -> file class",
          in_kind_to_effector_class(IN_KIND_FILE_OP), EFF_CLASS_FILE)
    ce_eq("http -> http class",
          in_kind_to_effector_class(IN_KIND_HTTP_ACTION), EFF_CLASS_HTTP)
    ce_eq("code -> code class",
          in_kind_to_effector_class(IN_KIND_CODE_EXEC), EFF_CLASS_CODE)
    ce_eq("mcp -> mcp class",
          in_kind_to_effector_class(IN_KIND_MCP), EFF_CLASS_MCP)
    ce_eq("audio -> audio class",
          in_kind_to_effector_class(IN_KIND_AUDIO), EFF_CLASS_AUDIO)
    ce_eq("internal -> internal class",
          in_kind_to_effector_class(IN_KIND_INTERNAL), EFF_CLASS_INTERNAL)
    ce_eq("unknown kind -> internal class",
          in_kind_to_effector_class(999), EFF_CLASS_INTERNAL)
}

// ---- setters -------------------------------------------------------------
fn test_setters() {
    let i = intent_speak_new(1, "hi", 0, 500, 0)
    ce_eq("set role ok", in_set_role(i, "greeter"), 1)
    ce_str_eq("role round-trip", in_role(i), "greeter")
    ce_eq("set linked percept ok", in_set_linked_percept(i, 12345), 1)
    ce_eq("linked percept round-trip", in_linked_percept(i), 12345)
    ce_eq("set trace ref ok", in_set_trace_ref(i, "trace:1"), 1)
    ce_str_eq("trace ref round-trip", in_trace_ref(i), "trace:1")
    // Setters on a 0 handle return 0 (no crash).
    ce_eq("set role null", in_set_role(0, "x"), 0)
    ce_eq("set linked null", in_set_linked_percept(0, 1), 0)
    ce_eq("set trace null", in_set_trace_ref(0, "x"), 0)
}

// ---- guards --------------------------------------------------------------
fn test_guards() {
    ce_eq("is_intent on 0", in_is_intent(0), 0)
    let short = list_new()
    push(short, IN_OBJ_TAG)
    ce_eq("is_intent on short list", in_is_intent(short), 0)
    let fake = list_new()
    let k = 0
    while k < 12 { push(fake, 0) k = k + 1 }
    ce_eq("is_intent on wrong tag", in_is_intent(fake), 0)
    ce_check("is_speak on 0", in_is_speak(0) == 0)
    ce_check("is_internal on 0", in_is_internal(0) == 0)
}

// ---- summary -------------------------------------------------------------
fn test_summary() {
    let i = intent_speak_new(1, "ok", 0, 900, 0)
    let s = in_summary(i)
    ce_check("summary nonempty", len(s) > 0)
    ce_check("summary mentions speak", str_find(s, "speak") >= 0)
    ce_str_eq("summary on null", in_summary(0), "<no intent>")
}

fn main() {
    test_speak_intent()
    test_internal_intent()
    test_internal_intent_custom_reason()
    test_tool_intent()
    test_tool_intent_default_class()
    test_kind_names()
    test_effector_class_names()
    test_kind_to_effector_class()
    test_setters()
    test_guards()
    test_summary()
    ce_summary("action_atoms")
}
main()
