// Unit tests for src/safety/hkdf_sha256.nova (R88 HKDF-SHA-256).
//
// Coverage
//   * RFC 5869 Appendix A.1 -- basic SHA-256, 22-byte IKM, 13-byte
//     salt, 10-byte info, 42-byte OKM.
//   * RFC 5869 Appendix A.2 -- SHA-256, 80/80/80-byte IKM/salt/info,
//     82-byte OKM.
//   * RFC 5869 Appendix A.3 -- SHA-256 with empty salt (must expand to
//     32 zero bytes per RFC 5869 §2.2), empty info, 42-byte OKM.
//   * Extract-only round-trip for each of A.1..A.3.
//   * Expand-only round-trip for each of A.1..A.3.
//   * Combined-wrapper round-trip for each of A.1..A.3.
//   * Boundary lengths: out_len == 0, out_len == 32 (one T block),
//     out_len == 33 (two T blocks), out_len == 8160 (max, all 255 T
//     blocks in use), refusal at out_len == 8161 (over-max).
//
// References
//   RFC 5869 §2.2, §2.3 -- Extract, Expand.
//   RFC 5869 Appendix A.1, A.2, A.3 -- SHA-256 test vectors.
//
// NOVA dependencies: ce_test harness, hkdf_sha256.nova, sha256.nova.

import "../ce_test.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/hkdf_sha256.nova"

// ---- helpers --------------------------------------------------------------

fn _thk_nibble_hex(n) {
    if n < 10 { return 48 + n }
    return 87 + n
}

fn _thk_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        s = s + chr(_thk_nibble_hex(int_and(int_shr(b, 4), 15)))
        s = s + chr(_thk_nibble_hex(int_and(b, 15)))
        i = i + 1
    }
    return s
}

fn _thk_hex_nibble(c) {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    return 0 - 1
}

// Decode ASCII hex into [buf, len]. Empty hex returns a 1-byte NUL and
// length 0.
fn _thk_hex_to_buf(hex) {
    let n = len(hex)
    let half = int_shr(n, 1)
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _thk_hex_nibble(char_at(hex, i * 2))
        let lo = _thk_hex_nibble(char_at(hex, i * 2 + 1))
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    let r = list_new()
    push(r, buf)
    push(r, half)
    return r
}

// Byte-slice compare.
fn _thk_bufs_eq(a, an, b, bn) {
    if an != bn { return 0 }
    let i = 0
    while i < an {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---- RFC 5869 Appendix A.1 ---------------------------------------------

fn test_rfc5869_a1_extract() {
    let ikm  = _thk_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let salt = _thk_hex_to_buf("000102030405060708090a0b0c")
    let prk  = hkdf_extract(salt[0], salt[1], ikm[0], ikm[1])
    ce_str_eq("A.1 PRK",
        _thk_hex_encode_buf(prk, 32),
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
}

fn test_rfc5869_a1_expand() {
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let info  = _thk_hex_to_buf("f0f1f2f3f4f5f6f7f8f9")
    let okm   = hkdf_expand(prk_p[0], prk_p[1], info[0], info[1], 42)
    ce_eq("A.1 OKM length", okm[1], 42)
    ce_str_eq("A.1 OKM",
        _thk_hex_encode_buf(okm[0], 42),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
}

fn test_rfc5869_a1_combined() {
    let ikm  = _thk_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let salt = _thk_hex_to_buf("000102030405060708090a0b0c")
    let info = _thk_hex_to_buf("f0f1f2f3f4f5f6f7f8f9")
    let okm  = hkdf_sha256(salt[0], salt[1], ikm[0], ikm[1],
                           info[0], info[1], 42)
    ce_eq("A.1 combined length", okm[1], 42)
    ce_str_eq("A.1 combined OKM",
        _thk_hex_encode_buf(okm[0], 42),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
}

// ---- RFC 5869 Appendix A.2 ---------------------------------------------

fn test_rfc5869_a2_extract() {
    let ikm  = _thk_hex_to_buf("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f")
    let salt = _thk_hex_to_buf("606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    let prk  = hkdf_extract(salt[0], salt[1], ikm[0], ikm[1])
    ce_str_eq("A.2 PRK",
        _thk_hex_encode_buf(prk, 32),
        "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244")
}

fn test_rfc5869_a2_expand() {
    let prk_p = _thk_hex_to_buf("06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244")
    let info  = _thk_hex_to_buf("b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
    let okm   = hkdf_expand(prk_p[0], prk_p[1], info[0], info[1], 82)
    ce_eq("A.2 OKM length", okm[1], 82)
    ce_str_eq("A.2 OKM",
        _thk_hex_encode_buf(okm[0], 82),
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87")
}

fn test_rfc5869_a2_combined() {
    let ikm  = _thk_hex_to_buf("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f")
    let salt = _thk_hex_to_buf("606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    let info = _thk_hex_to_buf("b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
    let okm  = hkdf_sha256(salt[0], salt[1], ikm[0], ikm[1],
                           info[0], info[1], 82)
    ce_eq("A.2 combined length", okm[1], 82)
    ce_str_eq("A.2 combined OKM",
        _thk_hex_encode_buf(okm[0], 82),
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87")
}

// ---- RFC 5869 Appendix A.3 (empty salt + empty info) -------------------

fn test_rfc5869_a3_extract() {
    let ikm = _thk_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    // salt not provided -> pass len=0; RFC 5869 §2.2 substitutes 32
    // zero bytes internally.
    let prk = hkdf_extract(0, 0, ikm[0], ikm[1])
    ce_str_eq("A.3 PRK (empty salt)",
        _thk_hex_encode_buf(prk, 32),
        "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")
}

fn test_rfc5869_a3_expand() {
    let prk_p = _thk_hex_to_buf("19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")
    // info also empty.
    let okm = hkdf_expand(prk_p[0], prk_p[1], 0, 0, 42)
    ce_eq("A.3 OKM length", okm[1], 42)
    ce_str_eq("A.3 OKM (empty info)",
        _thk_hex_encode_buf(okm[0], 42),
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
}

fn test_rfc5869_a3_combined() {
    let ikm = _thk_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let okm = hkdf_sha256(0, 0, ikm[0], ikm[1], 0, 0, 42)
    ce_eq("A.3 combined length", okm[1], 42)
    ce_str_eq("A.3 combined OKM",
        _thk_hex_encode_buf(okm[0], 42),
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
}

// ---- Extract equivalence: hkdf_extract == HMAC(salt, ikm) --------------
//
// Prove the Extract layer is exactly a thin HMAC wrapper (per RFC 5869
// §2.2) for a non-empty salt, and that the zero-salt substitution
// matches HMAC(32-zero-bytes, ikm) explicitly.

fn test_extract_matches_hmac_non_empty_salt() {
    let ikm  = _thk_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let salt = _thk_hex_to_buf("000102030405060708090a0b0c")
    let prk_via_hkdf = hkdf_extract(salt[0], salt[1], ikm[0], ikm[1])
    let prk_via_hmac = hmac_sha256(salt[0], salt[1], ikm[0], ikm[1])
    ce_eq("Extract non-empty salt matches HMAC(salt, ikm)",
        _thk_bufs_eq(prk_via_hkdf, 32, prk_via_hmac, 32), 1)
}

fn test_extract_zero_salt_matches_hmac_zeros() {
    let ikm = _thk_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let zeros = alloc(33)
    let i = 0
    while i < 32 { store8(zeros + i, 0); i = i + 1 }
    store8(zeros + 32, 0)
    let prk_via_hkdf = hkdf_extract(0, 0, ikm[0], ikm[1])
    let prk_via_hmac = hmac_sha256(zeros, 32, ikm[0], ikm[1])
    ce_eq("Extract empty salt == HMAC(32*0x00, ikm)",
        _thk_bufs_eq(prk_via_hkdf, 32, prk_via_hmac, 32), 1)
}

// ---- Boundary lengths --------------------------------------------------

fn test_expand_zero_len() {
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let okm = hkdf_expand(prk_p[0], prk_p[1], 0, 0, 0)
    ce_eq("expand out_len=0 -> length 0", okm[1], 0)
}

fn test_expand_one_block() {
    // out_len == 32: exactly one T(i) block; T(1) truncated (well,
    // not truncated at all).
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let info  = _thk_hex_to_buf("f0f1f2f3f4f5f6f7f8f9")
    let okm   = hkdf_expand(prk_p[0], prk_p[1], info[0], info[1], 32)
    ce_eq("expand out_len=32 -> length 32", okm[1], 32)
    // First 32 bytes of the A.1 OKM.
    ce_str_eq("expand out_len=32 matches A.1 OKM[0..32]",
        _thk_hex_encode_buf(okm[0], 32),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf")
}

fn test_expand_two_block() {
    // out_len == 33: forces a second T(i) block (T(2)), only one byte
    // of which is kept. Byte 32 of the A.1 OKM is 0x34.
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let info  = _thk_hex_to_buf("f0f1f2f3f4f5f6f7f8f9")
    let okm   = hkdf_expand(prk_p[0], prk_p[1], info[0], info[1], 33)
    ce_eq("expand out_len=33 -> length 33", okm[1], 33)
    ce_str_eq("expand out_len=33 matches A.1 OKM[0..33]",
        _thk_hex_encode_buf(okm[0], 33),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34")
}

fn test_expand_prefix_property() {
    // Expand at any (<= 42) length is the prefix of the A.1 OKM.
    // This tests the length-truncation logic + T-chain construction.
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let info  = _thk_hex_to_buf("f0f1f2f3f4f5f6f7f8f9")
    let full  = hkdf_expand(prk_p[0], prk_p[1], info[0], info[1], 42)
    let short = hkdf_expand(prk_p[0], prk_p[1], info[0], info[1], 10)
    ce_eq("prefix property length", short[1], 10)
    ce_eq("prefix property bytes match",
        _thk_bufs_eq(full[0], 10, short[0], 10), 1)
}

fn test_expand_max_len() {
    // out_len == 8160: exercises all 255 T(i) blocks without triggering
    // the refusal branch. Just verify the returned length; a byte-level
    // KAT for L=8160 isn't in the RFC, but the correctness of the
    // T-chain is already pinned by A.1/A.2/A.3.
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let okm   = hkdf_expand(prk_p[0], prk_p[1], 0, 0, 8160)
    ce_eq("expand out_len=8160 -> length 8160", okm[1], 8160)
    // Constant check: HKDF_SHA256_MAX_OKM tallies with the RFC ceiling.
    ce_eq("HKDF_SHA256_MAX_OKM = 255*32", HKDF_SHA256_MAX_OKM, 8160)
}

fn test_expand_over_max_refused() {
    // out_len == 8161 must be refused (length 0 returned as the signal).
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let okm = hkdf_expand(prk_p[0], prk_p[1], 0, 0, 8161)
    ce_eq("expand out_len=8161 refused (length 0)", okm[1], 0)
}

fn test_expand_negative_refused() {
    let prk_p = _thk_hex_to_buf("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let okm = hkdf_expand(prk_p[0], prk_p[1], 0, 0, 0 - 1)
    ce_eq("expand out_len=-1 refused (length 0)", okm[1], 0)
}

// ---- Constants ---------------------------------------------------------

fn test_constants() {
    ce_eq("HKDF_SHA256_HASH_LEN = 32", HKDF_SHA256_HASH_LEN, 32)
}

// ---- Run ---------------------------------------------------------------

fn main() {
    test_rfc5869_a1_extract()
    test_rfc5869_a1_expand()
    test_rfc5869_a1_combined()
    test_rfc5869_a2_extract()
    test_rfc5869_a2_expand()
    test_rfc5869_a2_combined()
    test_rfc5869_a3_extract()
    test_rfc5869_a3_expand()
    test_rfc5869_a3_combined()
    test_extract_matches_hmac_non_empty_salt()
    test_extract_zero_salt_matches_hmac_zeros()
    test_expand_zero_len()
    test_expand_one_block()
    test_expand_two_block()
    test_expand_prefix_property()
    test_expand_max_len()
    test_expand_over_max_refused()
    test_expand_negative_refused()
    test_constants()
    ce_summary("hkdf_sha256")
}

main()
