// CE_TEST_TIMEOUT: 240
// End-to-end tests of src/learning/sa4_coord.nova (A2.2b), part 2: one bad
// or silent soul is left out and the round still completes for the rest
// (N = 5, t = 4), with the unmasked sum equal to the sum over U3.
//   - a soul's ADV signature is corrupted: the coordinator leaves it out of
//     U1 (otherwise every honest soul would refuse the round);
//   - a soul's SIG3 is corrupted: left out of U4.

import "../ce_test.nova"
import "../sa4_harness.nova"

let C2_R = 35

fn c2_run(vc, stops, tampers) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, C2_R, vc, 0)
    let c = sa4e_coord(roster, C2_R, vc)
    let res = sa4e_round(roster, souls, c, stops, tampers)
    if res[0] != 1 { println("  reason: " + res[1]) }
    return res
}

fn main() {
    let vc = list_new()
    let c = c2_run(vc, list_new(), [[3, 0, 1]])
    ce_eq("bad ADV signature: unmasks without it", c[0], 1)
    ce_eq("bad ADV signature: U1 = 4", len(sa4c_set(c[3], 1)), 4)
    ce_check("bad ADV signature: reason recorded", find_bytes(sa4c_why(c[3], 70000), "ADV signature does not verify") >= 0)
    ce_eq("bad ADV signature: sum over the other four", sa4h_same(c[2], sa4h_expected([1, 2, 3, 5])), 1)

    let d = c2_run(vc, list_new(), [[2, 3, 2]])
    ce_eq("bad SIG3: unmasks without it in U4", d[0], 1)
    ce_eq("bad SIG3: U4 = 4", len(sa4c_set(d[3], 4)), 4)
    ce_check("bad SIG3: reason recorded", find_bytes(sa4c_why(d[3], 65536), "SIG3 does not verify") >= 0)
    ce_eq("bad SIG3: its y still counts", sa4h_same(d[2], sa4h_expected([1, 2, 3, 4, 5])), 1)

    ce_summary("sa4_coord3")
}

main()
