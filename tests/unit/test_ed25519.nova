// Unit tests for src/safety/ed25519.nova (RFC 8032 Ed25519 + SHA-512).
//
// Coverage:
//   * SHA-512 NIST KAT: SHA-512("") and SHA-512("abc") match the
//     standard test vectors (FIPS 180-4 / NIST CSRC).
//   * RFC 8032 test vector #1 (empty message): known sk -> expected
//     pk, expected signature, verify returns 1.
//   * RFC 8032 test vector #2 (1-byte message "72"): same shape.
//   * RFC 8032 test vector #3 (2-byte message "af82"): same shape.
//   * Hex <-> byte-list round-trip helpers.
//   * Random keypair generation: secure_random path returns 32-byte
//     seed + 32-byte pubkey of the expected shapes.
//   * Sign + verify round-trip on a random keypair and random
//     message: verify returns 1.
//   * Tampered-message detection: signature on "hello" doesn't
//     verify against "world".
//   * Tampered-signature detection: flipping one bit in the
//     signature makes verify return 0.
//   * Tampered-pubkey detection: substituting a wrong pubkey makes
//     verify return 0.
//   * Bad-signature shape: wrong-length signatures get rejected.
//   * Edwards point identity: 0 * B == identity, 1 * B == B.

import "std/io"
import "../ce_test.nova"
import "../../src/safety/ed25519.nova"

// ---- helpers --------------------------------------------------------------

// Build a NOVA byte list from a string (each char becomes one byte).
fn _t_bytes_from_str(s) {
    let out = list_new()
    let i = 0
    let n = len(s)
    while i < n {
        push(out, char_at(s, i))
        i = i + 1
    }
    return out
}

// Bit-flip on a copy of a byte list at offset off.
fn _t_flip_bit(bytes, off, bit) {
    let copy = list_new()
    let i = 0
    let n = len(bytes)
    while i < n {
        push(copy, bytes[i])
        i = i + 1
    }
    list_set(copy, off, int_xor(copy[off], int_shl(1, bit)))
    return copy
}

// ---- SHA-512 NIST KATs ----------------------------------------------------

fn test_sha512_kat_empty() {
    let h = sha512_bytes(list_new())
    let got = ed25519_bytes_to_hex(h)
    ce_str_eq("SHA-512(\"\")", got,
        "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
}

fn test_sha512_kat_abc() {
    let h = sha512_bytes(_t_bytes_from_str("abc"))
    let got = ed25519_bytes_to_hex(h)
    ce_str_eq("SHA-512(\"abc\")", got,
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
}

// SHA-512 over a 104-byte input -- a multi-block message that
// exercises the long-message path. 104 bytes < 112-byte single-block
// padding threshold so this is the single-block padded path with
// non-zero `rem`. Verified against `sha512sum`.
fn test_sha512_kat_long_message() {
    let msg = _t_bytes_from_str(
        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrst")
    ce_eq("long-message input length is 104", len(msg), 104)
    let h = sha512_bytes(msg)
    let got = ed25519_bytes_to_hex(h)
    ce_str_eq("SHA-512 (104-byte ASCII KAT)", got,
        "e65131bf0c4f1acae17f1359802d481af7d2ca542b9eee20eadfaf73a82c628c3b2bdfd7da2f757eeffcf47dbb6f91cc252640bc7e3f9d656752e8a26394a9e5")
}

// SHA-512 over a 114-byte input -- forces the DUAL-block padding path
// (rem >= 112 so we need a second compression block for the length
// suffix). This is the only test that exercises the `need_two == 1`
// branch in sha512_bytes; without it a stray bug in the dual-block
// path would slip past the suite.
fn test_sha512_kat_dual_block_padding() {
    let msg = _t_bytes_from_str(
        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstuvwxyz0123")
    ce_eq("dual-block-padding input length is 114", len(msg), 114)
    let h = sha512_bytes(msg)
    let got = ed25519_bytes_to_hex(h)
    ce_str_eq("SHA-512 (114-byte forces dual-block pad)", got,
        "f37d0f8ce349db9b24a94199436209c063ac0b34602a59cdaac94e2ebb495b5322165e152a7693ee0efef1540aaff23cd8b1c7aa609e7cdd570db9b4d63f8429")
}

// ---- hex codec round-trips ------------------------------------------------

fn test_ed25519_hex_codec_round_trip() {
    let s = "deadbeef0102030405060708090a0b0c0d0e0f10"
    let b = ed25519_hex_to_bytes(s)
    ce_eq("hex -> bytes length", len(b), 20)
    ce_eq("byte[0] == 0xde", b[0], 222)
    ce_eq("byte[19] == 0x10", b[19], 16)
    let back = ed25519_bytes_to_hex(b)
    ce_str_eq("bytes -> hex round-trip", back, s)
}

fn test_ed25519_hex_codec_empty() {
    let b = ed25519_hex_to_bytes("")
    ce_eq("empty hex -> empty bytes", len(b), 0)
    let s = ed25519_bytes_to_hex(list_new())
    ce_str_eq("empty bytes -> empty hex", s, "")
}

fn test_ed25519_hex_codec_bad() {
    let b = ed25519_hex_to_bytes("xy")
    ce_eq("bad hex char -> empty result", len(b), 0)
    let b2 = ed25519_hex_to_bytes("abc")    // odd length
    ce_eq("odd length hex -> empty result", len(b2), 0)
}

// ---- RFC 8032 test vector #1 (empty message) -----------------------------

fn test_rfc8032_test1_empty_message() {
    let sk_hex = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    let expected_pk_hex = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    let expected_sig_hex = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
    let sk = ed25519_hex_to_bytes(sk_hex)
    let msg = list_new()
    // Pubkey derivation.
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    ce_str_eq("RFC 8032 TEST 1: pubkey", ed25519_bytes_to_hex(pk),
              expected_pk_hex)
    // Sign.
    let sig = ed25519_sign(msg, sk, pk)
    ce_str_eq("RFC 8032 TEST 1: signature", ed25519_bytes_to_hex(sig),
              expected_sig_hex)
    // Verify.
    ce_eq("RFC 8032 TEST 1: verify returns 1",
          ed25519_verify(msg, sig, pk), 1)
}

// ---- RFC 8032 test vector #2 (1-byte message "72") -----------------------

fn test_rfc8032_test2_one_byte_message() {
    let sk_hex = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    let expected_pk_hex = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
    let expected_sig_hex = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
    let sk = ed25519_hex_to_bytes(sk_hex)
    let msg = ed25519_hex_to_bytes("72")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    ce_str_eq("RFC 8032 TEST 2: pubkey", ed25519_bytes_to_hex(pk),
              expected_pk_hex)
    let sig = ed25519_sign(msg, sk, pk)
    ce_str_eq("RFC 8032 TEST 2: signature", ed25519_bytes_to_hex(sig),
              expected_sig_hex)
    ce_eq("RFC 8032 TEST 2: verify returns 1",
          ed25519_verify(msg, sig, pk), 1)
}

// ---- RFC 8032 test vector #3 (2-byte message "af82") ----------------------

fn test_rfc8032_test3_two_byte_message() {
    let sk_hex = "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"
    let expected_pk_hex = "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"
    let expected_sig_hex = "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
    let sk = ed25519_hex_to_bytes(sk_hex)
    let msg = ed25519_hex_to_bytes("af82")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    ce_str_eq("RFC 8032 TEST 3: pubkey", ed25519_bytes_to_hex(pk),
              expected_pk_hex)
    let sig = ed25519_sign(msg, sk, pk)
    ce_str_eq("RFC 8032 TEST 3: signature", ed25519_bytes_to_hex(sig),
              expected_sig_hex)
    ce_eq("RFC 8032 TEST 3: verify returns 1",
          ed25519_verify(msg, sig, pk), 1)
}

// ---- keypair generation: secure_random path --------------------------------

fn test_ed25519_keygen_shape() {
    let kp = ed25519_keygen()
    ce_eq("keygen returns 2 outputs", len(kp), 2)
    let seed = kp[0]
    let pk = kp[1]
    ce_eq("seed is 32 bytes", len(seed), 32)
    ce_eq("pk is 32 bytes", len(pk), 32)
}

// ---- sign + verify round-trip on a random keypair + random message --------

fn test_ed25519_round_trip_random() {
    let kp = ed25519_keygen()
    let seed = kp[0]
    let pk = kp[1]
    let msg = _t_bytes_from_str("CrossEngin round-trip test message")
    let sig = ed25519_sign(msg, seed, pk)
    ce_eq("round-trip sig is 64 bytes", len(sig), 64)
    ce_eq("round-trip verify returns 1",
          ed25519_verify(msg, sig, pk), 1)
}

// ---- tampered-message detection ------------------------------------------

fn test_ed25519_tamper_message() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let hello = _t_bytes_from_str("hello")
    let world = _t_bytes_from_str("world")
    let sig = ed25519_sign(hello, sk, pk)
    // The same signature must NOT verify against a different message.
    ce_eq("tampered message detected (hello sig vs world)",
          ed25519_verify(world, sig, pk), 0)
    // But the original message still verifies.
    ce_eq("original message still verifies",
          ed25519_verify(hello, sig, pk), 1)
}

// ---- tampered-signature detection -----------------------------------------

fn test_ed25519_tamper_signature_bit() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = _t_bytes_from_str("authenticated payload")
    let sig = ed25519_sign(msg, sk, pk)
    // Flip a bit in the R half (byte 0 bit 0).
    let sig_bad_R = _t_flip_bit(sig, 0, 0)
    ce_eq("flipped bit in R rejected",
          ed25519_verify(msg, sig_bad_R, pk), 0)
    // Flip a bit in the s half (byte 32 bit 5).
    let sig_bad_s = _t_flip_bit(sig, 32, 5)
    ce_eq("flipped bit in s rejected",
          ed25519_verify(msg, sig_bad_s, pk), 0)
    // Original still verifies.
    ce_eq("original sig still verifies",
          ed25519_verify(msg, sig, pk), 1)
}

// ---- tampered-pubkey detection --------------------------------------------

fn test_ed25519_tamper_pubkey() {
    let sk_alice = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk_bob = ed25519_hex_to_bytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let pa = _ed_derive_a_and_prefix(sk_alice)
    let pb = _ed_derive_a_and_prefix(sk_bob)
    let pk_alice = _ed_pk_from_a(pa[0])
    let pk_bob = _ed_pk_from_a(pb[0])
    let msg = _t_bytes_from_str("for Alice only")
    let sig = ed25519_sign(msg, sk_alice, pk_alice)
    // Alice's sig verifies under Alice's pubkey.
    ce_eq("Alice sig + Alice pk verifies",
          ed25519_verify(msg, sig, pk_alice), 1)
    // Alice's sig does NOT verify under Bob's pubkey.
    ce_eq("Alice sig + Bob pk rejected",
          ed25519_verify(msg, sig, pk_bob), 0)
    // Single-bit-flipped pubkey is also rejected.
    let pk_bad = _t_flip_bit(pk_alice, 0, 0)
    ce_eq("Alice sig + bit-flipped pk rejected",
          ed25519_verify(msg, sig, pk_bad), 0)
}

// ---- malformed signature / pubkey shapes ---------------------------------

fn test_ed25519_bad_sig_shape() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = _t_bytes_from_str("test")
    // Empty signature.
    ce_eq("empty signature rejected",
          ed25519_verify(msg, list_new(), pk), 0)
    // 63-byte signature (one short).
    let short = list_new()
    let i = 0
    while i < 63 {
        push(short, 0)
        i = i + 1
    }
    ce_eq("63-byte signature rejected",
          ed25519_verify(msg, short, pk), 0)
    // Wrong-length pubkey (31 bytes).
    let sig = ed25519_sign(msg, sk, pk)
    let pk_short = list_new()
    let j = 0
    while j < 31 {
        push(pk_short, 0)
        j = j + 1
    }
    ce_eq("31-byte pubkey rejected",
          ed25519_verify(msg, sig, pk_short), 0)
}

// ---- Edwards point edges (identity + 1*B) --------------------------------

fn test_ed25519_scalar_zero_is_identity() {
    // 0 * B should produce the identity point (0, 1).
    let B = _ed_base_point()
    let zero = bn256_new()
    let R = _ed_scalar_mult(zero, B)
    let aff = _ed_pt_to_affine(R)
    ce_eq("0 * B: x == 0", bn256_zero(aff[0]), 1)
    ce_eq("0 * B: y == 1", bn256_eq(aff[1], bn256_from_int(1)), 1)
}

fn test_ed25519_scalar_one_is_base() {
    // 1 * B should equal B in affine coordinates.
    let B = _ed_base_point()
    let one = bn256_from_int(1)
    let R = _ed_scalar_mult(one, B)
    let R_aff = _ed_pt_to_affine(R)
    let B_aff = _ed_pt_to_affine(B)
    ce_eq("1 * B: x == Bx", bn256_eq(R_aff[0], B_aff[0]), 1)
    ce_eq("1 * B: y == By", bn256_eq(R_aff[1], B_aff[1]), 1)
}

// ---- R90 extended verify coverage ----------------------------------------
//
// The tests above cover the RFC 8032 happy path + basic tamper detection.
// R90 fleshes out §5.1.7 rejection cases so a broken verify path can't
// slip through: s >= L (both s == L exactly and s == L+1), non-canonical
// y-encodings for A and R (y >= p), an all-zero pubkey (low-order /
// invalid), and determinism of the verify function on repeated calls.
// Also expands per-byte bit-flip coverage across the three RFC vectors
// so any single-bit corruption in R, s, msg, or pk is caught -- not
// just the ones we happened to spot-check.

// Bit-flip in the message byte causes verify to fail (extends the
// existing "hello vs world" swap test with per-vector coverage).
fn test_ed25519_rfc8032_test2_bitflip_message() {
    let sk = ed25519_hex_to_bytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = ed25519_hex_to_bytes("72")
    let sig = ed25519_sign(msg, sk, pk)
    ce_eq("TEST 2 baseline verify", ed25519_verify(msg, sig, pk), 1)
    let msg_bad = _t_flip_bit(msg, 0, 3)
    ce_eq("TEST 2 msg bit-flip rejected",
          ed25519_verify(msg_bad, sig, pk), 0)
}

fn test_ed25519_rfc8032_test3_bitflip_message() {
    let sk = ed25519_hex_to_bytes("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = ed25519_hex_to_bytes("af82")
    let sig = ed25519_sign(msg, sk, pk)
    ce_eq("TEST 3 baseline verify", ed25519_verify(msg, sig, pk), 1)
    let msg_bad = _t_flip_bit(msg, 1, 0)
    ce_eq("TEST 3 msg bit-flip (byte 1) rejected",
          ed25519_verify(msg_bad, sig, pk), 0)
    // Also flip in R (byte 5, bit 2) and pk (byte 12, bit 6).
    let sig_bad = _t_flip_bit(sig, 5, 2)
    ce_eq("TEST 3 R byte 5 bit 2 flip rejected",
          ed25519_verify(msg, sig_bad, pk), 0)
    let pk_bad = _t_flip_bit(pk, 12, 6)
    ce_eq("TEST 3 pk byte 12 bit 6 flip rejected",
          ed25519_verify(msg, sig, pk_bad), 0)
}

// Reject s == L exactly. RFC 8032 §5.1.7 requires s to be in [0, L),
// STRICTLY less than L. A well-formed s of exactly L must be refused.
fn test_ed25519_reject_s_equal_L() {
    // Take TEST 1's R + pk + msg but splice in s = L (LE encoded).
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = list_new()
    let sig = ed25519_sign(msg, sk, pk)
    // L in little-endian byte layout:
    //   L (big-endian hex) = 1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed
    //   little-endian     = eddef5ca1a63125d69cf7ade a2fdef14 0000000000000000000000000000000010
    // ... which is 32 LE bytes matching L's canonical scalar encoding.
    let L_le_hex = "edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010"
    let s_L = ed25519_hex_to_bytes(L_le_hex)
    ce_eq("s == L bytes decoded to 32 bytes", len(s_L), 32)
    // Assemble a spliced signature (R || s=L) and check rejection.
    let bad_sig = list_new()
    let i = 0
    while i < 32 { push(bad_sig, sig[i]); i = i + 1 }
    let j = 0
    while j < 32 { push(bad_sig, s_L[j]); j = j + 1 }
    ce_eq("s == L exactly rejected",
          ed25519_verify(msg, bad_sig, pk), 0)
}

// Reject s == L + 1 -- one above the group order.
fn test_ed25519_reject_s_equal_L_plus_one() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = list_new()
    let sig = ed25519_sign(msg, sk, pk)
    // L + 1 in LE: same as L with the LSB incremented from 0xed to 0xee.
    let L1_le_hex = "eed3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010"
    let s_L1 = ed25519_hex_to_bytes(L1_le_hex)
    let bad_sig = list_new()
    let i = 0
    while i < 32 { push(bad_sig, sig[i]); i = i + 1 }
    let j = 0
    while j < 32 { push(bad_sig, s_L1[j]); j = j + 1 }
    ce_eq("s == L+1 rejected",
          ed25519_verify(msg, bad_sig, pk), 0)
}

// Reject a non-canonical pubkey: y encoded such that y >= p when the
// sign bit is masked off. RFC 8032 §5.1.3 says point decoding must
// reject y >= p. Set the 32-byte pk to all 0xFF: after masking bit 255
// (the sign bit) we get y = 2^255 - 1, which is > p = 2^255 - 19.
fn test_ed25519_reject_non_canonical_pubkey_y_ge_p() {
    let pk_bad = list_new()
    let i = 0
    while i < 32 { push(pk_bad, 255); i = i + 1 }
    let msg = _t_bytes_from_str("nothing to see here")
    // A well-shaped but arbitrary 64-byte signature.
    let sig = list_new()
    let j = 0
    while j < 64 { push(sig, j); j = j + 1 }
    // s must be < L to reach the decode step. Byte 63 (top of s in LE)
    // = 63 has bit 7 clear, so numerically s < 2^250 << L; safe.
    ce_eq("non-canonical pubkey (y >= p) rejected",
          ed25519_verify(msg, sig, pk_bad), 0)
}

// Reject a non-canonical R: same y >= p condition applied to the R
// half of the signature. The verify path calls _ed_point_decode on R
// after the s check, and non-canonical y must fail.
fn test_ed25519_reject_non_canonical_R_y_ge_p() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = list_new()
    // s = 32 bytes with top byte having bit 7 clear so s < L.
    let bad_sig = list_new()
    let i = 0
    while i < 32 { push(bad_sig, 255); i = i + 1 }    // R with y=2^255-1 masked (still >= p)
    let j = 0
    while j < 32 {
        if j == 31 { push(bad_sig, 1) } else { push(bad_sig, 0) }
        j = j + 1
    }
    ce_eq("non-canonical R (y >= p) rejected",
          ed25519_verify(msg, bad_sig, pk), 0)
}

// Reject an all-zero pubkey. y = 0 decodes (u=-1, v=1, x=sqrt(-1)),
// which is a low-order point on the curve -- a well-known invalid
// TLS 1.3 CertificateVerify subject. Even if _ed_point_decode returns
// a point object, verifying an arbitrary signature against it must
// almost-always fail (the chance a random 64-byte signature verifies
// under a low-order key is ~2^-252).
fn test_ed25519_reject_all_zero_pubkey_signature() {
    let pk_zero = list_new()
    let i = 0
    while i < 32 { push(pk_zero, 0); i = i + 1 }
    let msg = _t_bytes_from_str("payload")
    // Fixed non-random signature so this test is deterministic.
    let sig = list_new()
    let j = 0
    while j < 64 { push(sig, int_and(j * 37 + 11, 255)); j = j + 1 }
    // Byte 63 top bit clear so s < L.
    list_set(sig, 63, int_and(sig[63], 15))
    ce_eq("all-zero pubkey + arbitrary sig rejected",
          ed25519_verify(msg, sig, pk_zero), 0)
}

// Determinism: verify(sig) called twice returns the same value. Pins
// that we don't accidentally consume any global state on the verify
// path (e.g. an RNG or a mutable cache with sequence-dependent output).
fn test_ed25519_verify_deterministic() {
    let sk = ed25519_hex_to_bytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = ed25519_hex_to_bytes("72")
    let sig = ed25519_sign(msg, sk, pk)
    let r1 = ed25519_verify(msg, sig, pk)
    let r2 = ed25519_verify(msg, sig, pk)
    ce_eq("verify determinism: r1 == r2", r1, r2)
    ce_eq("verify determinism: r1 == 1", r1, 1)
    // Same for a bad sig -- must consistently return 0.
    let bad = _t_flip_bit(sig, 40, 3)
    let b1 = ed25519_verify(msg, bad, pk)
    let b2 = ed25519_verify(msg, bad, pk)
    ce_eq("verify determinism on bad: b1 == b2", b1, b2)
    ce_eq("verify determinism on bad: b1 == 0", b1, 0)
}

// ---- sign latency timing --------------------------------------------------

fn test_ed25519_sign_latency_report() {
    let sk = ed25519_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let parts = _ed_derive_a_and_prefix(sk)
    let pk = _ed_pk_from_a(parts[0])
    let msg = _t_bytes_from_str("12345678901234567890123456789012")    // 32 bytes
    let t0 = nanotime()
    let sig = ed25519_sign(msg, sk, pk)
    let dt = nanotime() - t0
    let dt_ms = dt / 1000000
    println("ed25519_sign latency on 32B message: " + int_to_str(dt_ms) + " ms")
    ce_eq("latency-test sig is 64 bytes", len(sig), 64)
    ce_check("ed25519_sign latency positive", dt > 0)
    // Sanity ceiling: signing on this sandbox is ~250-1000ms; assert
    // under 30s to catch a pathological regression while leaving
    // headroom for noisy CI.
    ce_check("ed25519_sign latency under 30s", dt_ms < 30000)
}

fn main() {
    // SHA-512 NIST KATs (the foundation; if these fail the rest is meaningless).
    test_sha512_kat_empty()
    test_sha512_kat_abc()
    test_sha512_kat_long_message()
    test_sha512_kat_dual_block_padding()
    // Hex codec helpers.
    test_ed25519_hex_codec_round_trip()
    test_ed25519_hex_codec_empty()
    test_ed25519_hex_codec_bad()
    // RFC 8032 reference vectors (the brief's mandatory checks).
    test_rfc8032_test1_empty_message()
    test_rfc8032_test2_one_byte_message()
    test_rfc8032_test3_two_byte_message()
    // Keygen + round-trip on the secure_random path.
    test_ed25519_keygen_shape()
    test_ed25519_round_trip_random()
    // Tamper-detection paths.
    test_ed25519_tamper_message()
    test_ed25519_tamper_signature_bit()
    test_ed25519_tamper_pubkey()
    test_ed25519_bad_sig_shape()
    // Edwards-curve edge cases.
    test_ed25519_scalar_zero_is_identity()
    test_ed25519_scalar_one_is_base()
    // R90 extended RFC 8032 §5.1.7 rejection + determinism coverage.
    test_ed25519_rfc8032_test2_bitflip_message()
    test_ed25519_rfc8032_test3_bitflip_message()
    test_ed25519_reject_s_equal_L()
    test_ed25519_reject_s_equal_L_plus_one()
    test_ed25519_reject_non_canonical_pubkey_y_ge_p()
    test_ed25519_reject_non_canonical_R_y_ge_p()
    test_ed25519_reject_all_zero_pubkey_signature()
    test_ed25519_verify_deterministic()
    // Latency reporting (also doubles as a "sign on a 32B message
    // produces a 64B output" check).
    test_ed25519_sign_latency_report()
    ce_summary("ed25519")
}

main()
