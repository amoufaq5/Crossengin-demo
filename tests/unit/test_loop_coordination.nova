// Unit tests for src/agent/loop_coordination.nova
// Verifies the AgentContext blackboard accessors and the loop run-order /
// idle-gating logic. ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_coordination.nova"

fn test_context() {
    let c = ctx_new()
    ce_eq("tick 0", ctx_tick(c), 0)
    ce_eq("valence neutral", ctx_valence(c), 500)
    ctx_set_input(c, "hello")
    ce_str_eq("input", ctx_input(c), "hello")
    ctx_set_mood(c, 800, 600)
    ce_eq("mood valence", ctx_valence(c), 800)
    ce_eq("mood arousal", ctx_arousal(c), 600)
    ctx_set_goal(c, 3)
    ce_eq("goal", ctx_goal(c), 3)
    ctx_set_unknown(c, 2)
    ce_eq("unknown", ctx_unknown(c), 2)
    ctx_set_output(c, "ok")
    ce_str_eq("output", ctx_output(c), "ok")
}

fn test_coordination() {
    ce_eq("six loops in active cycle", len(coord_run_order()), 6)
    ce_str_eq("loop name", loop_name(LOOP_REASONING), "reasoning")
    // Active: the six run, imagination does not.
    ce_eq("perception runs when active", coord_should_run(LOOP_PERCEPTION, 0), 1)
    ce_eq("imagination off when active", coord_should_run(LOOP_IMAGINATION, 0), 0)
    // Idle: only imagination runs.
    ce_eq("imagination on when idle", coord_should_run(LOOP_IMAGINATION, 1), 1)
    ce_eq("perception off when idle", coord_should_run(LOOP_PERCEPTION, 1), 0)
    ce_eq("active loops = six", len(coord_active_loops(0)), 6)
    ce_eq("idle loops = imagination only", len(coord_active_loops(1)), 1)
}

fn main() { test_context() test_coordination() ce_summary("loop_coordination") }
main()
