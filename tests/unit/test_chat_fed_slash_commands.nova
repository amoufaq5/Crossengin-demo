// Unit tests for the chat's R1 federation slash-command helpers in
// src/chat/fed_slash.nova (Phase M R1, ADR-0089).
//
// Coverage (~30 assertions):
//   1. /gossip_start listen-addr resolution: no arg -> default;
//      arg present -> pass-through (trimmed); whitespace-only -> default.
//   2. /gossip_start output lines: "already running" repeats;
//      started-ok line with fd; started-fail line when fd < 0.
//   3. /gossip_peer arg parser: `add <addr>` splits correctly;
//      unknown sub-op reported; missing addr yields empty addr.
//   4. /gossip_peer added-line format; usage / no-state lines.
//   5. /gossip_peers rendering: header + one row per peer, each row
//      carrying addr / symbolic status / last_seen; ordering matches
//      the peer-table insertion order.
//   6. /gossip_dq arg parser: empty / whitespace -> ""; non-empty
//      passes through trimmed. Result header + no-state / usage lines.
//   7. dq_query end-to-end: on a single-soul mesh (dq wired to gossip
//      with no live peers), a valid SPARQL query returns local rows;
//      matches the /gossip_dq handler contract (call dq_query, format
//      via chat_fed_dq_result_header + dq_format_binding).

import "../ce_test.nova"
import "../../src/chat/fed_slash.nova"
import "../../src/federation/gossip.nova"
import "../../src/federation/distributed_query.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"

// ---- /gossip_start: pick listen addr -------------------------------------

fn test_pick_listen_addr_default_when_null() {
    ce_str_eq("null arg falls to default",
              chat_fed_pick_listen_addr(0),
              "127.0.0.1:8790")
}

fn test_pick_listen_addr_default_when_empty() {
    ce_str_eq("empty arg falls to default",
              chat_fed_pick_listen_addr(""),
              "127.0.0.1:8790")
}

fn test_pick_listen_addr_default_when_whitespace() {
    ce_str_eq("whitespace arg falls to default",
              chat_fed_pick_listen_addr("   "),
              "127.0.0.1:8790")
}

fn test_pick_listen_addr_passthrough() {
    ce_str_eq("explicit arg passes through",
              chat_fed_pick_listen_addr("10.0.0.5:9000"),
              "10.0.0.5:9000")
}

fn test_pick_listen_addr_trims() {
    ce_str_eq("arg is trimmed",
              chat_fed_pick_listen_addr("  10.0.0.5:9000  "),
              "10.0.0.5:9000")
}

// ---- /gossip_start: output lines -----------------------------------------

fn test_gossip_already_running_line() {
    ce_str_eq("already-running echoes addr",
              chat_fed_gossip_already_running_line("127.0.0.1:8790"),
              "gossip: already running on 127.0.0.1:8790")
}

fn test_gossip_started_line_success() {
    ce_str_eq("started line carries fd",
              chat_fed_gossip_started_line("127.0.0.1:8790", 7),
              "gossip: started on 127.0.0.1:8790 fd=7")
}

fn test_gossip_started_line_bind_fail() {
    let s = chat_fed_gossip_started_line("127.0.0.1:8790", 0 - 1)
    ce_check("bind-fail line names client-only mode",
             _t_contains(s, "WARN") == 1)
    ce_check("bind-fail line still carries addr",
             _t_contains(s, "127.0.0.1:8790") == 1)
}

// small substring helper (avoids re-importing gossip's _starts_with)
fn _t_contains(hay, needle) {
    let nl = len(needle)
    if nl == 0 { return 1 }
    let hl = len(hay)
    if nl > hl { return 0 }
    let i = 0
    while i + nl <= hl {
        let j = 0
        let ok = 1
        while j < nl {
            if char_at(hay, i + j) != char_at(needle, j) { ok = 0 j = nl }
            j = j + 1
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- /gossip_peer arg parser --------------------------------------------

fn test_peer_parse_add_addr() {
    let p = chat_fed_parse_peer_command("add 127.0.0.1:9000")
    ce_str_eq("action = add", p[0], "add")
    ce_str_eq("addr parsed", p[1], "127.0.0.1:9000")
}

fn test_peer_parse_add_addr_trims() {
    let p = chat_fed_parse_peer_command("add    10.0.0.7:8880   ")
    ce_str_eq("action = add (whitespace-padded)", p[0], "add")
    ce_str_eq("addr trimmed", p[1], "10.0.0.7:8880")
}

fn test_peer_parse_unknown_op() {
    let p = chat_fed_parse_peer_command("remove foo")
    ce_str_eq("action = unknown", p[0], "unknown")
}

fn test_peer_parse_empty_arg() {
    let p = chat_fed_parse_peer_command("")
    ce_str_eq("empty arg => unknown", p[0], "unknown")
    ce_str_eq("empty arg addr blank", p[1], "")
}

fn test_peer_parse_null_arg() {
    let p = chat_fed_parse_peer_command(0)
    ce_str_eq("null arg => unknown", p[0], "unknown")
}

fn test_peer_parse_add_no_addr() {
    let p = chat_fed_parse_peer_command("add")
    ce_str_eq("action = add w/no addr", p[0], "add")
    ce_str_eq("addr blank when omitted", p[1], "")
}

// ---- /gossip_peer output lines ------------------------------------------

fn test_peer_added_line() {
    ce_str_eq("peer-added line",
              chat_fed_peer_added_line("127.0.0.1:9000", 3),
              "gossip_peer: add 127.0.0.1:9000 (peers=3)")
}

fn test_peer_unknown_op_usage() {
    let s = chat_fed_peer_unknown_op_line()
    ce_check("usage line mentions add", _t_contains(s, "add") == 1)
    ce_check("usage line mentions <addr>", _t_contains(s, "<addr>") == 1)
}

fn test_gossip_no_state_line() {
    let s = chat_fed_gossip_no_state_line()
    ce_check("no-state line points to /gossip_start",
             _t_contains(s, "/gossip_start") == 1)
}

// ---- /gossip_peers rendering --------------------------------------------

fn test_peers_header_line_zero() {
    ce_str_eq("empty peers header",
              chat_fed_peers_header_line(0),
              "gossip_peers: 0 entries")
}

fn test_peers_header_line_many() {
    ce_str_eq("multi peers header",
              chat_fed_peers_header_line(5),
              "gossip_peers: 5 entries")
}

fn test_peer_row_line() {
    let row = chat_fed_peer_row_line("127.0.0.1:9000",
                                     GOSSIP_STATUS_ALIVE,
                                     12345)
    ce_check("row has addr", _t_contains(row, "127.0.0.1:9000") == 1)
    ce_check("row has status label", _t_contains(row, "ALIVE") == 1)
    ce_check("row has last_seen", _t_contains(row, "last_seen=12345") == 1)
}

fn test_status_labels_distinct() {
    ce_str_eq("ALIVE label",
              chat_fed_status_label(GOSSIP_STATUS_ALIVE),   "ALIVE")
    ce_str_eq("SUSPECT label",
              chat_fed_status_label(GOSSIP_STATUS_SUSPECT), "SUSPECT")
    ce_str_eq("DEAD label",
              chat_fed_status_label(GOSSIP_STATUS_DEAD),    "DEAD")
}

fn test_peers_render_empty_state() {
    let gs = gossip_init("127.0.0.1:8790", 0)
    let lines = chat_fed_peers_render(gs)
    ce_eq("empty state renders header only", len(lines), 1)
    ce_str_eq("header for empty peer table",
              lines[0], "gossip_peers: 0 entries")
}

fn test_peers_render_two_peers() {
    let peers = list_new()
    push(peers, "127.0.0.1:8791")
    push(peers, "127.0.0.1:8792")
    let gs = gossip_init("127.0.0.1:8790", peers)
    let lines = chat_fed_peers_render(gs)
    // 1 header + 2 rows
    ce_eq("render produces header + 2 rows", len(lines), 3)
    ce_check("row 1 has first peer",
             _t_contains(lines[1], "127.0.0.1:8791") == 1)
    ce_check("row 2 has second peer",
             _t_contains(lines[2], "127.0.0.1:8792") == 1)
}

// ---- /gossip_dq -----------------------------------------------------------

fn test_dq_pick_query_null() {
    ce_str_eq("null arg -> empty query",
              chat_fed_pick_query_text(0), "")
}

fn test_dq_pick_query_empty() {
    ce_str_eq("empty arg -> empty query",
              chat_fed_pick_query_text(""), "")
}

fn test_dq_pick_query_trims() {
    ce_str_eq("dq query trimmed",
              chat_fed_pick_query_text("  SELECT ?a WHERE ...  "),
              "SELECT ?a WHERE ...")
}

fn test_dq_usage_line() {
    let s = chat_fed_dq_usage_line()
    ce_check("usage line names /gossip_dq",
             _t_contains(s, "/gossip_dq") == 1)
}

fn test_dq_no_state_line() {
    let s = chat_fed_dq_no_state_line()
    ce_check("dq no-state line points to /gossip_start",
             _t_contains(s, "/gossip_start") == 1)
}

fn test_dq_result_header() {
    ce_str_eq("dq result header",
              chat_fed_dq_result_header(3),
              "gossip_dq: 3 row(s)")
}

// End-to-end: build a tiny KG + single-soul dq, run a SPARQL query,
// verify the result-count matches the rendered header. This is what
// the chat's /gossip_dq handler does at runtime.
fn test_dq_query_flows_through_to_dq_query() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "test_dq")
    kg_add_atom(kg, ATOM_FACT, "fact_0", 1000)
    kg_add_atom(kg, ATOM_FACT, "fact_1", 1100)

    let gs = gossip_init("127.0.0.1:8790", 0)
    let dq = dq_init(gs)
    let q  = chat_fed_pick_query_text("SELECT ?a WHERE { ?a kind FACT . }")
    let rows = dq_query(dq, kg, q, 0)
    ce_eq("dq_query returns 2 FACT rows", len(rows), 2)
    // The handler prints chat_fed_dq_result_header(len(rows)) as the
    // top line, then dq_format_binding per row -- validate the header
    // string builds off the actual row count.
    ce_str_eq("result header formats row count",
              chat_fed_dq_result_header(len(rows)),
              "gossip_dq: 2 row(s)")
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_pick_listen_addr_default_when_null()
    test_pick_listen_addr_default_when_empty()
    test_pick_listen_addr_default_when_whitespace()
    test_pick_listen_addr_passthrough()
    test_pick_listen_addr_trims()

    test_gossip_already_running_line()
    test_gossip_started_line_success()
    test_gossip_started_line_bind_fail()

    test_peer_parse_add_addr()
    test_peer_parse_add_addr_trims()
    test_peer_parse_unknown_op()
    test_peer_parse_empty_arg()
    test_peer_parse_null_arg()
    test_peer_parse_add_no_addr()

    test_peer_added_line()
    test_peer_unknown_op_usage()
    test_gossip_no_state_line()

    test_peers_header_line_zero()
    test_peers_header_line_many()
    test_peer_row_line()
    test_status_labels_distinct()
    test_peers_render_empty_state()
    test_peers_render_two_peers()

    test_dq_pick_query_null()
    test_dq_pick_query_empty()
    test_dq_pick_query_trims()
    test_dq_usage_line()
    test_dq_no_state_line()
    test_dq_result_header()
    test_dq_query_flows_through_to_dq_query()

    ce_summary("chat_fed_slash_commands")
}

main()
