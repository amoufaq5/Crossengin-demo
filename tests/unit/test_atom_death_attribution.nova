// Unit tests for the P1.6 atom-death attribution hook added to
// src/learning/atom_death_monitor.nova: when an atom transitions
// tombstone -> dead AND the optional meta-observer reference is non-zero,
// adm_sweep_attributed calls mo_record_death so the observer's per-source
// atrophy counter is bumped at the moment of outright death.
//
// Coverage:
//   * mo_record_death directly: attributes a tag, then records a death of
//     one of its atoms; the source's running atrophy counter +1.
//   * mo_record_death on an untagged atom is a no-op (returns 0) and does
//     not bump any counter.
//   * adm_sweep_attributed with mo=0 behaves identically to legacy adm_sweep
//     (does not crash on a null observer; tombstones/removes as before).
//   * adm_sweep_attributed with mo!=0 + a freshly-tagged atom: after
//     tombstone+remove, the observer's tag has atrophy=1 in mo_report.
//   * adm_sweep_attributed only attributes once per atom (the dead-flag
//     guard prevents a second call from re-bumping).
//   * Multiple attributed atoms dying in one sweep all show up in the
//     observer's counter.
//   * Mixed sweep (one tagged, one untagged): only the tagged atom's source
//     gets the +1.
//   * The legacy adm_sweep wrapper still works (back-compat).
// ADR-0050 P1.6, ADR-0025.

import "../ce_test.nova"
import "../../src/learning/atom_death_monitor.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// Helper: build a collectable atom (activation below the death floor) tagged
// to the observer under `source`.
fn _make_tagged_atom(kg, mo, label, source) {
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    adm_init(a, 0)
    adm_decay(a, 10)   // 1.0 * 0.01 = 0.01 < 0.02 floor
    mo_attribute(mo, source, atom_id(a))
    return a
}

// Helper: untagged collectable atom (no observer attribution).
fn _make_untagged_atom(kg, label) {
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    adm_init(a, 0)
    adm_decay(a, 10)
    return a
}

// ---- direct mo_record_death API ----------------------------------------

fn test_record_death_direct() {
    let mo = mo_new()
    mo_attribute(mo, "src:topic:trial", 42)
    let report_before = mo_report(mo)
    ce_eq("atrophy before is 0", report_before[0][2], 0)
    let bumped = mo_record_death(mo, 42)
    ce_eq("record_death returns 1 for attributed atom", bumped, 1)
    let report_after = mo_report(mo)
    // Cumulative atrophy = atrophies / sample = 1/1 -> 1000 milli.
    ce_eq("cumulative atrophy now 100%", report_after[0][2], 1000)
}

fn test_record_death_untagged_is_noop() {
    let mo = mo_new()
    mo_attribute(mo, "src:topic:trial", 1)
    mo_attribute(mo, "src:topic:trial", 2)
    let bumped = mo_record_death(mo, 999)   // not attributed
    ce_eq("record_death returns 0 for untagged atom id", bumped, 0)
    let report = mo_report(mo)
    ce_eq("source still has 0 atrophy", report[0][2], 0)
}

// ---- legacy adm_sweep still works --------------------------------------

fn test_legacy_sweep_no_observer() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let a = _make_untagged_atom(kg, "doomed")
    let s1 = adm_sweep(reg, kg)
    ce_eq("legacy sweep tombstones one", s1[0], 1)
    let s2 = adm_sweep(reg, kg)
    ce_eq("legacy sweep removes on second pass", s2[1], 1)
    ce_eq("atom is dead", adm_is_dead(a), 1)
}

// ---- adm_sweep_attributed with mo=0 --------------------------------------

fn test_sweep_attributed_with_null_mo() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let a = _make_untagged_atom(kg, "doomed")
    let s1 = adm_sweep_attributed(reg, kg, 0)
    ce_eq("null-mo sweep tombstones one", s1[0], 1)
    let s2 = adm_sweep_attributed(reg, kg, 0)
    ce_eq("null-mo sweep removes on second pass", s2[1], 1)
    ce_eq("atom is dead", adm_is_dead(a), 1)
}

// ---- the headline test: attribution lands -------------------------------

fn test_attributed_death_increments_atrophy() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mo = mo_new()
    let a = _make_tagged_atom(kg, mo, "doomed", "src:topic:experiment")
    // Tombstone phase: still alive, no attribution yet.
    let s1 = adm_sweep_attributed(reg, kg, mo)
    ce_eq("first sweep tombstones", s1[0], 1)
    ce_eq("first sweep removes none", s1[1], 0)
    let report_mid = mo_report(mo)
    ce_eq("atrophy still 0 after tombstone-only sweep", report_mid[0][2], 0)
    // Hard-remove phase: attribution fires.
    let s2 = adm_sweep_attributed(reg, kg, mo)
    ce_eq("second sweep hard-removes", s2[1], 1)
    ce_eq("atom is dead", adm_is_dead(a), 1)
    let report_after = mo_report(mo)
    ce_eq("source atrophy counter incremented",
        report_after[0][2], 1000)   // 1/1 sample -> 100%
}

// ---- idempotency: the dead-flag guard stops double-attribution --------

fn test_no_double_attribution_on_repeat_sweep() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mo = mo_new()
    let a = _make_tagged_atom(kg, mo, "doomed", "src:topic:once")
    adm_sweep_attributed(reg, kg, mo)
    adm_sweep_attributed(reg, kg, mo)
    // Snapshot atrophy after the first death.
    let after_two = mo_report(mo)
    let atrophy_after_two = after_two[0][2]
    // Run the sweep two more times -- the dead-flag guard means the atom
    // is skipped, so the attribution is NOT repeated.
    adm_sweep_attributed(reg, kg, mo)
    adm_sweep_attributed(reg, kg, mo)
    let after_four = mo_report(mo)
    ce_eq("atrophy did not double-count", after_four[0][2], atrophy_after_two)
}

// ---- multiple tagged atoms dying in one sweep ---------------------------

fn test_multiple_attributed_deaths_in_one_sweep() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mo = mo_new()
    let a1 = _make_tagged_atom(kg, mo, "one", "src:topic:batch")
    let a2 = _make_tagged_atom(kg, mo, "two", "src:topic:batch")
    let a3 = _make_tagged_atom(kg, mo, "three", "src:topic:batch")
    adm_sweep_attributed(reg, kg, mo)   // all tombstoned
    let s2 = adm_sweep_attributed(reg, kg, mo)
    ce_eq("three removed in second sweep", s2[1], 3)
    // Walk the side-table directly: atrophies should be 3 for the source.
    let srcs = mo[MO_SOURCES]
    let i = 0
    let atrophies = 0 - 1
    while i < len(srcs) {
        if str_eq_bytes(srcs[i][MO_MS_TAG], "src:topic:batch") == 1 {
            atrophies = srcs[i][MO_MS_ATROPHIES]
        }
        i = i + 1
    }
    ce_eq("source atrophies = 3", atrophies, 3)
}

// ---- mixed tagged + untagged --------------------------------------------

// A sweep with both attributed and unattributed dying atoms: only the
// attributed one bumps the source's counter.
fn test_mixed_tagged_and_untagged() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mo = mo_new()
    let tagged = _make_tagged_atom(kg, mo, "tagged", "src:topic:mixed")
    let untagged = _make_untagged_atom(kg, "untagged")
    adm_sweep_attributed(reg, kg, mo)
    adm_sweep_attributed(reg, kg, mo)
    ce_eq("tagged is dead", adm_is_dead(tagged), 1)
    ce_eq("untagged is dead", adm_is_dead(untagged), 1)
    let srcs = mo[MO_SOURCES]
    ce_eq("only one tracked source", len(srcs), 1)
    ce_eq("its atrophy counter is 1", srcs[0][MO_MS_ATROPHIES], 1)
}

// ---- record_death on an empty observer ---------------------------------

fn test_record_death_on_empty_observer() {
    let mo = mo_new()
    let bumped = mo_record_death(mo, 0)
    ce_eq("record_death on empty observer is a no-op (returns 0)", bumped, 0)
    ce_eq("no sources were created", len(mo_sources(mo)), 0)
}

// ---- protected atoms are not collected, so no attribution -------------

// An atom protected from death never lands in the dead state -> attribution
// never fires.
fn test_protected_attributed_atom_not_attributed() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let mo = mo_new()
    let p = _make_tagged_atom(kg, mo, "constitutional", "src:topic:protected")
    adm_set_protected(p)
    adm_sweep_attributed(reg, kg, mo)
    adm_sweep_attributed(reg, kg, mo)
    ce_eq("protected atom is NOT dead", adm_is_dead(p), 0)
    let srcs = mo[MO_SOURCES]
    ce_eq("source atrophy remained 0", srcs[0][MO_MS_ATROPHIES], 0)
}

fn main() {
    test_record_death_direct()
    test_record_death_untagged_is_noop()
    test_legacy_sweep_no_observer()
    test_sweep_attributed_with_null_mo()
    test_attributed_death_increments_atrophy()
    test_no_double_attribution_on_repeat_sweep()
    test_multiple_attributed_deaths_in_one_sweep()
    test_mixed_tagged_and_untagged()
    test_record_death_on_empty_observer()
    test_protected_attributed_atom_not_attributed()
    ce_summary("atom_death_attribution")
}

main()
