// Unit tests for src/kg/schemas.nova
// Verifies required/optional field declaration, validation (missing required,
// wrong type, min/max constraint violations) and instantiation with defaults.
// ADR-0018.

import "../ce_test.nova"
import "../../src/kg/schemas.nova"

fn props2(k1, v1, k2, v2) {
    let p = list_new()
    let a = list_new(); push(a, k1); push(a, v1); push(p, a)
    let b = list_new(); push(b, k2); push(b, v2); push(p, b)
    return p
}

fn build_schema() {
    let s = schema_new("drug")
    schema_add_required(s, "name", FTYPE_STR)
    schema_add_required(s, "dose", FTYPE_INT)
    schema_add_optional(s, "route", FTYPE_STR, "oral")
    schema_add_constraint(s, "dose", "min", 0)
    schema_add_constraint(s, "dose", "max", 1000)
    return s
}

fn test_declaration() {
    let s = build_schema()
    ce_str_eq("name", schema_name(s), "drug")
    ce_eq("field count", schema_field_count(s), 3)
    ce_eq("required count", schema_required_count(s), 2)
    // Re-adding an existing field does not duplicate.
    schema_add_required(s, "name", FTYPE_STR)
    ce_eq("no duplicate field", schema_field_count(s), 3)
    ce_eq("constraint on unknown field fails", schema_add_constraint(s, "nope", "min", 0), 0)
}

fn test_validation() {
    let s = build_schema()
    // Valid: required present, types ok, dose in range; route may be absent.
    ce_eq("valid -> no errors", len(schema_validate(s, props2("name", "aspirin", "dose", 100))), 0)
    ce_eq("schema_is_valid", schema_is_valid(s, props2("name", "aspirin", "dose", 100)), 1)
    // Missing required field.
    let missing = list_new()
    let d = list_new(); push(d, "dose"); push(d, 100); push(missing, d)
    ce_eq("missing required -> error", len(schema_validate(s, missing)), 1)
    // Wrong type for dose (string, not int).
    ce_eq("wrong type -> error", len(schema_validate(s, props2("name", "x", "dose", "big"))), 1)
    // Below min and above max.
    ce_eq("below min -> error", len(schema_validate(s, props2("name", "x", "dose", -5))), 1)
    ce_eq("above max -> error", len(schema_validate(s, props2("name", "x", "dose", 5000))), 1)
}

fn test_instantiate() {
    let s = build_schema()
    let inst = schema_instantiate(s, props2("name", "x", "dose", 50))
    // Optional 'route' default filled in.
    ce_eq("instance has 3 fields", len(inst), 3)
    // Find the route default.
    let found = 0
    let i = 0
    while i < len(inst) {
        if str_eq(inst[i][0], "route") == 1 {
            if str_eq(inst[i][1], "oral") == 1 { found = 1 }
        }
        i = i + 1
    }
    ce_eq("default route filled", found, 1)
}

fn main() {
    test_declaration()
    test_validation()
    test_instantiate()
    ce_summary("schemas")
}

main()
