// Unit tests for the session audit-log wiring in cognitive_router.nova:
// cr_set_audit_log() switches the NL-answer path between the unaudited
// nlq_respond and the audited nlq_respond_audited, so a CONTESTED reply
// during a chat session leaves a DLK_DECISION trail in the ADR-0043 log.
//
// The audit-side semantics (claim id carried, recorder writes the right
// payload) are already covered by test_nl_audit. This suite exercises the
// router-level handle behaviour (wire/unwire, idempotence, default off) and
// confirms the router still answers when the handle is unwired.

import "../ce_test.nova"
import "../../src/agent/cognitive_router.nova"

fn test_default_handle_is_off() {
    // Don't call cr_set_audit_log -- the default register is empty, so the
    // audit path is a no-op; _cr_audit_log() must return 0.
    ce_eq("default handle == 0", _cr_audit_log(), 0)
}

fn test_set_and_read_handle() {
    let log = dl_new()
    cr_set_audit_log(log)
    let h = _cr_audit_log()
    ce_check("handle wired", h != 0)
    // Same identity (the register stores the handle, not a copy): a fresh
    // dl_append goes through the same list object.
    dl_append(h, DLK_INTENT, 0 - 1, 1, _ds_desc(), 0 - 1, list_new(), 0, OUT_PENDING)
    ce_eq("write reflects on read", dl_count(_cr_audit_log()), 1)
}

fn _ds_desc() {
    let d = list_new()
    push(d, 0) push(d, 0) push(d, 0) push(d, 0)
    return d
}

// Re-wiring must replace the handle, not push a second one (the register is a
// 1-slot list; a chat session should never carry two logs).
fn test_rewire_replaces() {
    let log1 = dl_new()
    let log2 = dl_new()
    cr_set_audit_log(log1)
    cr_set_audit_log(log2)
    // Behavioural check (NOVA's != on list pointers is environmentally
    // unreliable in this launcher): writes through the active handle must land
    // on log2 and leave log1 untouched. That proves the register replaced
    // rather than appended.
    dl_append(_cr_audit_log(), DLK_INTENT, 0 - 1, 2, _ds_desc(), 0 - 1, list_new(), 0, OUT_PENDING)
    ce_eq("log2 has the entry", dl_count(log2), 1)
    ce_eq("log1 stays empty", dl_count(log1), 0)
}

// Unwire (pass 0) puts the handle back to off; the router behaves as before.
fn test_unwire() {
    let log = dl_new()
    cr_set_audit_log(log)
    cr_set_audit_log(0)
    ce_eq("handle off again", _cr_audit_log(), 0)
}

fn main() {
    test_default_handle_is_off()
    test_set_and_read_handle()
    test_rewire_replaces()
    test_unwire()
    ce_summary("router_audit")
}

main()
