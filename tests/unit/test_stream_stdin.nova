// Unit tests for src/io/transducers/stream_stdin.nova (P2.8 streaming source).
//
// Hermetic coverage of the line-splitting + EV_MESSAGE-posting logic that
// the daemon's streaming-mode tick calls into. We do NOT touch real stdin
// here -- the integration script `tests/integration/scenario_l_stream_stdin.sh`
// exercises the actual non-blocking fcntl + sys_read path against a live
// `./bin/crossengin` child. Here we feed synthetic bytes via the
// `stream_stdin_test_feed` helper and assert each complete line was
// transduced + posted onto a real scheduler event queue.
//
// Target ~10 assertions; we cover:
//   * fresh-state defaults                                         (3 checks)
//   * single complete line posts one normalized EV_MESSAGE         (3 checks)
//   * trailing residual is held until the newline arrives          (3 checks)
//   * multiple lines in one feed drain in order                    (3 checks)
//   * blank lines are silently dropped (no event posted)            (2 checks)
//   * env gate: CE_STREAM_STDIN unset / "0" -> disabled              (2 checks)

import "../ce_test.nova"
import "../../src/io/transducers/stream_stdin.nova"
import "../../src/scheduler/hybrid_scheduler.nova"
import "../../src/substrate/part_lifecycle.nova"

// Build a real (non-stubbed) scheduler so hs_post_event actually mutates
// a real queue and we can read it back with evq_drain. The substrate part
// registry is the minimum hs_new requires; we don't tick it in this test.
fn _mk_hs() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 8, 1)
    return hs_new(reg)
}

fn test_defaults() {
    let s = stream_stdin_new()
    ce_eq("fresh: not enabled",       stream_stdin_enabled(s), 0)
    ce_eq("fresh: no lines posted",   stream_stdin_lines_total(s), 0)
    ce_str_eq("fresh: empty residual", stream_stdin_residual(s), "")
    ce_eq("fresh: no EOF",            stream_stdin_eof(s), 0)
}

fn test_single_line() {
    let s = stream_stdin_new()
    let hs = _mk_hs()
    let n = stream_stdin_test_feed(s, hs, "fever\n")
    ce_eq("posted one line",       n, 1)
    ce_eq("total counter ticked",  stream_stdin_lines_total(s), 1)
    ce_str_eq("residual drained",  stream_stdin_residual(s), "")
    // Drain the queue and check the event is the right kind + payload.
    let ev = evq_drain(hs[HS_EVENTS])
    ce_check("event was popped",   ev != 0)
    ce_eq("event kind = EV_MESSAGE", event_kind(ev), EV_MESSAGE)
    ce_str_eq("payload normalized",   event_payload(ev), "fever")
}

fn test_trailing_residual_held() {
    let s = stream_stdin_new()
    let hs = _mk_hs()
    // First feed: a line WITHOUT a trailing newline. Must NOT post yet.
    let n1 = stream_stdin_test_feed(s, hs, "partial line so far")
    ce_eq("no complete line yet",       n1, 0)
    ce_str_eq("residual buffered",      stream_stdin_residual(s), "partial line so far")
    ce_eq("counter unchanged",          stream_stdin_lines_total(s), 0)
    // Second feed: the rest + newline. Now it posts.
    let n2 = stream_stdin_test_feed(s, hs, " continued\n")
    ce_eq("posted after newline",       n2, 1)
    ce_str_eq("residual drained again", stream_stdin_residual(s), "")
    let ev = evq_drain(hs[HS_EVENTS])
    ce_str_eq("joined and normalized",  event_payload(ev), "partial line so far continued")
}

fn test_multiple_lines_one_feed() {
    let s = stream_stdin_new()
    let hs = _mk_hs()
    let n = stream_stdin_test_feed(s, hs, "alpha\nbeta\ngamma\n")
    ce_eq("posted three",         n, 3)
    ce_eq("counter shows three",  stream_stdin_lines_total(s), 3)
    // Order is FIFO -- a stream-source must not reorder by content.
    let e1 = evq_drain(hs[HS_EVENTS])
    let e2 = evq_drain(hs[HS_EVENTS])
    let e3 = evq_drain(hs[HS_EVENTS])
    ce_str_eq("first line first",  event_payload(e1), "alpha")
    ce_str_eq("second line second", event_payload(e2), "beta")
    ce_str_eq("third line third",  event_payload(e3), "gamma")
}

fn test_blank_lines_dropped() {
    let s = stream_stdin_new()
    let hs = _mk_hs()
    // Blank lines and whitespace-only lines are silently dropped -- the
    // operator hitting RETURN twice should not enqueue an empty percept.
    let n = stream_stdin_test_feed(s, hs, "\n   \nhello\n")
    ce_eq("only the real line posted", n, 1)
    ce_eq("counter agrees",            stream_stdin_lines_total(s), 1)
    let ev = evq_drain(hs[HS_EVENTS])
    ce_str_eq("payload is the non-blank", event_payload(ev), "hello")
}

fn test_env_gate_default_off() {
    let s = stream_stdin_new()
    // No CE_STREAM_STDIN set in the test process env -- init_from_env
    // should return 0 and leave the stream disabled. This protects the
    // default "do not change scripted-episode behaviour" promise.
    let r = stream_stdin_init_from_env(s)
    ce_eq("env unset -> not enabled",   r, 0)
    ce_eq("flag stays off",             stream_stdin_enabled(s), 0)
}

fn test_normalization_through_transducer() {
    // The stream MUST route through transduce_text -- the same path the
    // scripted episode uses -- so trim/lowercase/whitespace-collapse is
    // applied. This is what makes a stdin-driven message indistinguishable
    // from an in-script `hs_post_event` from the daemon's perspective.
    let s = stream_stdin_new()
    let hs = _mk_hs()
    let n = stream_stdin_test_feed(s, hs, "   Hello   WORLD  \n")
    ce_eq("posted normalized", n, 1)
    let ev = evq_drain(hs[HS_EVENTS])
    ce_str_eq("trim+lower+collapse", event_payload(ev), "hello world")
}

fn main() {
    test_defaults()
    test_single_line()
    test_trailing_residual_held()
    test_multiple_lines_one_feed()
    test_blank_lines_dropped()
    test_env_gate_default_off()
    test_normalization_through_transducer()
    ce_summary("stream_stdin")
}
main()
