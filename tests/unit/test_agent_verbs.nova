// R109 (Phase J): agent.compose / agent.list / agent.run / agent.retire
// wire verbs. Covers cap gates, pagination on list, ownership
// auto-stamp on compose, refusal shapes, per-skill cap escalation
// prevention on run.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/agents/agent_manifest.nova"
import "../../src/agents/agent_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/sandbox/capability.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a1 = kg_add_atom(kg, ATOM_FACT, "mars", 0)
    list_set(a1[A_BELIEF], 0, 8000) list_set(a1[A_BELIEF], 1, 2000)
    return reg
}

fn _mk_ctx() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = skill_registry_new()
    let m = echo_skill_manifest()
    skill_registry_register(sr, m)
    let sup = skill_supervisor_new(m, kgreg, 0, 0, 0, mo, 100)
    skill_registry_install(sr, "echo", 0, sup, 100)
    let preg = persona_registry_new()
    let ctx = rpc_ctx_new(kgreg, 0, preg, sr, mo, 0, 0, 100)
    rpc_ctx_set_agent_reg(ctx, agent_registry_new())
    return ctx
}

// ---- ctx accessor round-trip ------------------------------------------

fn test_ctx_agent_reg_accessor() {
    let ctx = _mk_ctx()
    let ar = rpc_ctx_agent_reg(ctx)
    ce_check("agent reg wired", ar != 0)
    ce_eq("empty", agent_registry_count(ar), 0)
}

// ---- agent.compose ----------------------------------------------------

fn _mk_manifest_text(name) {
    return "AGENT-MANIFEST v1\n"
         + "NAME " + name + "\n"
         + "VERSION 1.0.0\n"
         + "DESCRIPTION test agent\n"
         + "SKILL_DEP echo\n"
}

fn test_compose_ok() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_compose(_args1("manifest_text",
                                              _mk_manifest_text("triage")), ctx)
    ce_check("ok true", _has(out, "\"ok\":true"))
    ce_check("name",    _has(out, "\"name\":\"triage\""))
    ce_check("version", _has(out, "\"version\":\"1.0.0\""))
    ce_check("installed", _has(out, "\"installed\":true"))
    ce_check("skill_deps has echo", _has(out, "\"echo\""))
    // Registry now has 1 entry.
    ce_eq("registry count 1",
          agent_registry_count(rpc_ctx_agent_reg(ctx)), 1)
}

fn test_compose_missing_arg() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_compose(list_new(), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions manifest",
             _has(out, "manifest_text"))
}

fn test_compose_no_registry() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = skill_registry_new()
    let ctx = rpc_ctx_new(kgreg, 0, persona_registry_new(), sr, mo, 0, 0, 100)
    // Deliberately no rpc_ctx_set_agent_reg.
    let out = _rpc_verb_agent_compose(_args1("manifest_text",
                                              _mk_manifest_text("x")), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("err no registry",
             _has(out, "no agent registry"))
}

fn test_compose_invalid_manifest() {
    let ctx = _mk_ctx()
    // Missing SKILL_DEP -> validation fails.
    let bad = "AGENT-MANIFEST v1\nNAME x\nVERSION 1\n"
    let out = _rpc_verb_agent_compose(_args1("manifest_text", bad), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions SKILL_DEP", _has(out, "SKILL_DEP"))
}

fn test_compose_duplicate_refuses() {
    let ctx = _mk_ctx()
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("a")), ctx)
    let out = _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("a")), ctx)
    ce_check("2nd ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions already", _has(out, "already"))
}

// ---- agent.compose ownership auto-stamp -------------------------------

fn test_compose_auto_stamps_ownership() {
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    // Wire a cap registry + presented token so ctx has a holder.
    let creg = capability_registry_new()
    let caps = list_new()
    push(caps, CAP_ADMIN_AGENT_COMPOSE)
    let t = capability_token_new("tok1", "alice", caps, 0, 0)
    capability_registry_add(creg, t)
    rpc_ctx_set_sandbox(ctx, creg, 0)   // registry wired but not enforced
    rpc_ctx_set_presented_token(ctx, "tok1")
    let out = _rpc_verb_agent_compose(_args1("manifest_text",
                                              _mk_manifest_text("owned")), ctx)
    ce_check("ok true", _has(out, "\"ok\":true"))
    ce_check("owner alice", _has(out, "\"owner\":\"alice\""))
    ce_str_eq("overlay owner recorded",
              ownership_owner(overlay, OWN_KIND_AGENT, "owned"), "alice")
}

fn test_compose_cross_holder_refused() {
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    ownership_set_agent(overlay, "targ", "bob")
    let creg = capability_registry_new()
    let caps = list_new()
    push(caps, CAP_ADMIN_AGENT_COMPOSE)
    let t = capability_token_new("tok2", "alice", caps, 0, 0)
    capability_registry_add(creg, t)
    rpc_ctx_set_sandbox(ctx, creg, 0)
    rpc_ctx_set_presented_token(ctx, "tok2")
    let out = _rpc_verb_agent_compose(_args1("manifest_text",
                                              _mk_manifest_text("targ")), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions bob", _has(out, "bob"))
}

// ---- agent.list -------------------------------------------------------

fn test_list_empty() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_list(list_new(), ctx)
    ce_check("ok true", _has(out, "\"ok\":true"))
    ce_check("agents empty", _has(out, "\"agents\":[]"))
    ce_check("next_after empty", _has(out, "\"next_after\":\"\""))
}

fn test_list_shape() {
    let ctx = _mk_ctx()
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("a")), ctx)
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("b")), ctx)
    let out = _rpc_verb_agent_list(list_new(), ctx)
    ce_check("ok true", _has(out, "\"ok\":true"))
    ce_check("name a", _has(out, "\"name\":\"a\""))
    ce_check("name b", _has(out, "\"name\":\"b\""))
    ce_check("installed true", _has(out, "\"installed\":true"))
    ce_check("retired false", _has(out, "\"retired\":false"))
}

fn test_list_pagination() {
    let ctx = _mk_ctx()
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("a")), ctx)
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("b")), ctx)
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("c")), ctx)
    let out = _rpc_verb_agent_list(_args1("limit", "2"), ctx)
    ce_check("has a", _has(out, "\"name\":\"a\""))
    ce_check("has b", _has(out, "\"name\":\"b\""))
    ce_check("does not have c", _has(out, "\"name\":\"c\"") == 0)
    ce_check("next_after b", _has(out, "\"next_after\":\"b\""))
    let out2 = _rpc_verb_agent_list(_args2("limit", "10", "after", "b"), ctx)
    ce_check("2nd page has c", _has(out2, "\"name\":\"c\""))
    ce_check("2nd page next empty", _has(out2, "\"next_after\":\"\""))
}

fn test_list_ownership_filter() {
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("pub")), ctx)
    // Manually stamp a second agent as owned by bob.
    let mtxt = _mk_manifest_text("bobs")
    let pr = agent_manifest_parse(mtxt)
    agent_registry_register(rpc_ctx_agent_reg(ctx), pr[1])
    ownership_set_agent(overlay, "bobs", "bob")
    // Alice's view (no matching token; anonymous holder) hides bobs.
    let out = _rpc_verb_agent_list(list_new(), ctx)
    ce_check("has pub", _has(out, "\"name\":\"pub\""))
    ce_check("hides bobs from anonymous",
             _has(out, "\"name\":\"bobs\"") == 0)
}

// ---- agent.retire -----------------------------------------------------

fn test_retire_ok() {
    let ctx = _mk_ctx()
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("z")), ctx)
    let out = _rpc_verb_agent_retire(_args1("name", "z"), ctx)
    ce_check("ok true", _has(out, "\"ok\":true"))
    ce_check("retired true", _has(out, "\"retired\":true"))
    ce_eq("registry knows retired",
          agent_registry_is_retired(rpc_ctx_agent_reg(ctx), "z"), 1)
}

fn test_retire_unknown() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_retire(_args1("name", "nope"), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions unknown", _has(out, "unknown"))
}

fn test_retire_missing_arg() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_retire(list_new(), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions name", _has(out, "missing arg: name"))
}

// ---- agent.run --------------------------------------------------------

fn test_run_dispatch_ok() {
    let ctx = _mk_ctx()
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("triage")), ctx)
    let out = _rpc_verb_agent_run(_args2("name", "triage", "input", "mars"), ctx)
    ce_check("ok true", _has(out, "\"ok\":true"))
    ce_check("agent_name triage", _has(out, "\"agent_name\":\"triage\""))
    ce_check("skill_used echo",   _has(out, "\"skill_used\":\"echo\""))
    ce_check("attribution",       _has(out, "src:agent:triage:v1.0.0"))
}

fn test_run_unknown() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_run(_args2("name", "nope", "input", "x"), ctx)
    // Wire returns ok=true with the AgentRunResult carrying ok=false.
    ce_check("wire ok true",           _has(out, "\"ok\":true"))
    ce_check("inner refusal_reason",   _has(out, "unknown agent"))
}

fn test_run_missing_name() {
    let ctx = _mk_ctx()
    let out = _rpc_verb_agent_run(_args1("input", "x"), ctx)
    ce_check("wire ok false", _has(out, "\"ok\":false"))
    ce_check("err mentions name", _has(out, "missing arg: name"))
}

fn test_run_escalation_prevention() {
    let ctx = _mk_ctx()
    _rpc_verb_agent_compose(_args1("manifest_text", _mk_manifest_text("triage")), ctx)
    // Wire a cap registry + token WITHOUT CAP_SKILL_RUN.
    let creg = capability_registry_new()
    let caps = list_new()
    push(caps, CAP_NL_AGENT_RUN)   // has run cap but not skill cap
    let t = capability_token_new("tok3", "carol", caps, 0, 0)
    capability_registry_add(creg, t)
    rpc_ctx_set_sandbox(ctx, creg, 0)  // wired, not enforced (bypass dispatch gate)
    rpc_ctx_set_presented_token(ctx, "tok3")
    let out = _rpc_verb_agent_run(_args2("name", "triage", "input", "mars"), ctx)
    // Inner refusal names the missing cap.
    ce_check("refusal names skill echo", _has(out, "echo"))
    ce_check("refusal names cap",       _has(out, CAP_SKILL_RUN))
}

// ---- ownership auto-stamp verifies overlay unset -> anonymous -> ok ---

fn test_list_no_registry() {
    let kgreg = _mk_kgreg()
    let ctx = rpc_ctx_new(kgreg, 0, persona_registry_new(),
                            skill_registry_new(), mo_new(), 0, 0, 100)
    let out = _rpc_verb_agent_list(list_new(), ctx)
    ce_check("ok false", _has(out, "\"ok\":false"))
    ce_check("no registry error", _has(out, "no agent registry"))
}

fn main() {
    test_ctx_agent_reg_accessor()
    test_compose_ok()
    test_compose_missing_arg()
    test_compose_no_registry()
    test_compose_invalid_manifest()
    test_compose_duplicate_refuses()
    test_compose_auto_stamps_ownership()
    test_compose_cross_holder_refused()
    test_list_empty()
    test_list_shape()
    test_list_pagination()
    test_list_ownership_filter()
    test_retire_ok()
    test_retire_unknown()
    test_retire_missing_arg()
    test_run_dispatch_ok()
    test_run_unknown()
    test_run_missing_name()
    test_run_escalation_prevention()
    test_list_no_registry()
    ce_summary("agent_verbs")
}

main()
