// Unit tests for the R39A chat intent dispatcher helpers in
// src/chat/helpers.nova.
//
// Coverage
//   - _str_lower_ascii: A-Z lowercases, every other char passes verbatim.
//   - _smq_strip_terminal_punct: '?', '.', '!' are stripped; otherwise pass-through.
//   - _intent_self_id_kind: 8+ positive cases across the 5 self-id subkinds
//     (IDENTITY / STATE / GOALS / CAPABILITIES / ACTIVITY) and 5+ negative
//     cases (greetings, admin commands, generic statements, "what is X" with
//     X != self).
//   - _smq_extract_concept_query: shapes "what is X" / "tell me about X" /
//     bare "X"; negative cases for "what are your goals" (self-id) and
//     multi-token non-shape lines.
//   - _smq_relation_phrase: every canonical mapping ("is_a", "has_property",
//     etc.) + verbatim pass-through for unknown relations.
//   - _smq_template_triple: composed reply renders cleanly.
//   - _smq_unknown_reply: stable phrasing pin.
//
//   Total assertions: 50+. The intent matcher is the load-bearing chunk: a
//   regression in pattern coverage means the chat falls back to "okay" for
//   self-id queries, which is exactly what R39A was wired to fix.
//
// ADRs implemented: ADR-0049 (testing and benchmarks), ADR-0038 (self-model
//   query routing), ADR-0026 (self-learning triggers naming).

import "../ce_test.nova"
import "../../src/chat/helpers.nova"

// ---- _str_lower_ascii -----------------------------------------------------
// Letter-by-letter coverage of the simple ASCII lower. Non-letters and
// already-lower chars must pass verbatim.
fn test_str_lower_ascii() {
    ce_str_eq("lower: empty -> empty", _str_lower_ascii(""), "")
    ce_str_eq("lower: all-lower pass",  _str_lower_ascii("hello"), "hello")
    ce_str_eq("lower: all-upper -> lower", _str_lower_ascii("HELLO"), "hello")
    ce_str_eq("lower: mixed",            _str_lower_ascii("HeLLo"), "hello")
    ce_str_eq("lower: with space",       _str_lower_ascii("Hi There"), "hi there")
    ce_str_eq("lower: with punct",       _str_lower_ascii("Who Are You?"), "who are you?")
    ce_str_eq("lower: with digits",      _str_lower_ascii("Bot42"), "bot42")
    ce_str_eq("lower: only digits",      _str_lower_ascii("12345"), "12345")
    ce_str_eq("lower: only punct",       _str_lower_ascii(".,!?"), ".,!?")
}

// ---- _smq_strip_terminal_punct -------------------------------------------
fn test_strip_punct() {
    ce_str_eq("strip: '?'",  _smq_strip_terminal_punct("hello?"), "hello")
    ce_str_eq("strip: '.'",  _smq_strip_terminal_punct("hello."), "hello")
    ce_str_eq("strip: '!'",  _smq_strip_terminal_punct("hello!"), "hello")
    ce_str_eq("strip: none", _smq_strip_terminal_punct("hello"),  "hello")
    ce_str_eq("strip: empty",_smq_strip_terminal_punct(""),       "")
    // Only ONE terminal char is stripped (matches the spec; "??" -> "?").
    ce_str_eq("strip: '??'", _smq_strip_terminal_punct("hello??"),"hello?")
}

// ---- _intent_self_id_kind: positive cases --------------------------------
// At least 8 positives across the five SMQ_KIND_* branches. Mix lowercase /
// CamelCase / trailing-punct shapes so the lower+strip preconditioning is
// exercised end-to-end.
fn test_self_id_positive() {
    // IDENTITY
    ce_eq("self-id: 'who are you'",
        _intent_self_id_kind("who are you"),     SMQ_KIND_IDENTITY)
    ce_eq("self-id: 'Who are you?'",
        _intent_self_id_kind("Who are you?"),    SMQ_KIND_IDENTITY)
    ce_eq("self-id: 'what are you'",
        _intent_self_id_kind("what are you"),    SMQ_KIND_IDENTITY)
    ce_eq("self-id: 'What is your name?'",
        _intent_self_id_kind("What is your name?"), SMQ_KIND_IDENTITY)
    ce_eq("self-id: 'tell me about yourself'",
        _intent_self_id_kind("tell me about yourself"), SMQ_KIND_IDENTITY)
    // STATE
    ce_eq("self-id: 'how are you'",
        _intent_self_id_kind("how are you"),     SMQ_KIND_STATE)
    ce_eq("self-id: 'How are you?'",
        _intent_self_id_kind("How are you?"),    SMQ_KIND_STATE)
    ce_eq("self-id: 'what is your state'",
        _intent_self_id_kind("what is your state"), SMQ_KIND_STATE)
    // GOALS
    ce_eq("self-id: 'what are your goals'",
        _intent_self_id_kind("what are your goals"), SMQ_KIND_GOALS)
    ce_eq("self-id: 'what do you want'",
        _intent_self_id_kind("what do you want"), SMQ_KIND_GOALS)
    ce_eq("self-id: 'what is your purpose?'",
        _intent_self_id_kind("what is your purpose?"), SMQ_KIND_GOALS)
    // CAPABILITIES
    ce_eq("self-id: 'what can you do'",
        _intent_self_id_kind("what can you do"), SMQ_KIND_CAPABILITIES)
    ce_eq("self-id: 'what do you know'",
        _intent_self_id_kind("what do you know"), SMQ_KIND_CAPABILITIES)
    // ACTIVITY: prefix-matching so "what are you doing today" still hits.
    ce_eq("self-id: 'what are you doing'",
        _intent_self_id_kind("what are you doing"), SMQ_KIND_ACTIVITY)
    ce_eq("self-id: 'what are you doing today'",
        _intent_self_id_kind("what are you doing today"), SMQ_KIND_ACTIVITY)
}

// ---- _intent_self_id_kind: negative cases --------------------------------
// 5+ inputs that MUST NOT trigger any self-id branch. The "what is fever"
// case is the load-bearing one in the brief: a concept-query starting with
// "what is" must NOT be misclassified as IDENTITY.
fn test_self_id_negative() {
    ce_eq("self-id-neg: 'hello'",         _intent_self_id_kind("hello"),       SMQ_KIND_NONE)
    ce_eq("self-id-neg: 'good morning'",  _intent_self_id_kind("good morning"),SMQ_KIND_NONE)
    ce_eq("self-id-neg: 'what is fever'", _intent_self_id_kind("what is fever"),SMQ_KIND_NONE)
    ce_eq("self-id-neg: 'tell me about fever'",
        _intent_self_id_kind("tell me about fever"), SMQ_KIND_NONE)
    ce_eq("self-id-neg: admin /teach",   _intent_self_id_kind("/teach fever"), SMQ_KIND_NONE)
    ce_eq("self-id-neg: empty",          _intent_self_id_kind(""),             SMQ_KIND_NONE)
    ce_eq("self-id-neg: whitespace only",_intent_self_id_kind("   "),          SMQ_KIND_NONE)
}

// ---- _smq_extract_concept_query ------------------------------------------
// Both positive (concept extracted) and negative (returns "") cases.
fn test_concept_extract() {
    ce_str_eq("extract: 'what is fever' -> fever",
        _smq_extract_concept_query("what is fever"), "fever")
    ce_str_eq("extract: 'What is Fever?' -> fever",
        _smq_extract_concept_query("What is Fever?"), "fever")
    ce_str_eq("extract: 'tell me about aspirin'",
        _smq_extract_concept_query("tell me about aspirin"), "aspirin")
    ce_str_eq("extract: 'describe pyramid'",
        _smq_extract_concept_query("describe pyramid"), "pyramid")
    // Bare single token returns itself.
    ce_str_eq("extract: bare 'fever'",
        _smq_extract_concept_query("fever"), "fever")
    ce_str_eq("extract: bare 'Fever?'",
        _smq_extract_concept_query("Fever?"), "fever")
    // Multi-token non-shape returns "" (not a concept query).
    ce_str_eq("extract: 'i am tired' -> ''",
        _smq_extract_concept_query("i am tired"), "")
    // Empty -> empty.
    ce_str_eq("extract: empty -> ''",
        _smq_extract_concept_query(""), "")
}

// ---- _smq_relation_phrase + _smq_template_triple -------------------------
fn test_relation_phrase() {
    ce_str_eq("relphr: is_a",        _smq_relation_phrase("is_a"),        "is a")
    ce_str_eq("relphr: kind_of",     _smq_relation_phrase("kind_of"),     "is a kind of")
    ce_str_eq("relphr: has",         _smq_relation_phrase("has"),         "has")
    ce_str_eq("relphr: has_property",_smq_relation_phrase("has_property"),"has")
    ce_str_eq("relphr: contains",    _smq_relation_phrase("contains"),    "contains")
    ce_str_eq("relphr: causal",      _smq_relation_phrase("causal"),      "causes")
    ce_str_eq("relphr: unknown verbatim", _smq_relation_phrase("foo"),    "foo")
}

fn test_template_triple() {
    ce_str_eq("template: fever is_a illness",
        _smq_template_triple("fever", "is_a", "illness"),
        "fever is a illness.")
    ce_str_eq("template: aspirin has tablets",
        _smq_template_triple("aspirin", "has", "tablets"),
        "aspirin has tablets.")
    ce_str_eq("template: fever causal infection",
        _smq_template_triple("fever", "causal", "infection"),
        "fever causes infection.")
}

// ---- _smq_unknown_reply --------------------------------------------------
// Pin the stable phrasing so the chat smoke test can grep for it.
fn test_unknown_reply() {
    ce_str_eq("unknown: 'fever'",
        _smq_unknown_reply("fever"),
        "I don't know fever yet -- I'll look into it.")
    ce_str_eq("unknown: 'widget'",
        _smq_unknown_reply("widget"),
        "I don't know widget yet -- I'll look into it.")
}

// ---- _smq_ends_with / _smq_prefix / _smq_exact (building blocks) ---------
fn test_match_blocks() {
    ce_eq("ends_with: positive",   _smq_ends_with("hello world", "world"), 1)
    ce_eq("ends_with: negative",   _smq_ends_with("hello world", "hello"), 0)
    ce_eq("ends_with: equal",      _smq_ends_with("hello", "hello"),       1)
    ce_eq("ends_with: longer suf", _smq_ends_with("hi", "hello"),          0)
    ce_eq("exact: match",          _smq_exact("hello", "hello"),           1)
    ce_eq("exact: mismatch",       _smq_exact("hello", "world"),           0)
    ce_eq("prefix: equal",         _smq_prefix("what are you", "what are you"), 1)
    ce_eq("prefix: prefix + space",_smq_prefix("what are you doing", "what are you"), 1)
    ce_eq("prefix: longer prefix", _smq_prefix("what", "what are you"),    0)
    ce_eq("prefix: prefix without space", _smq_prefix("whatevery", "what"),0)
}

fn main() {
    test_str_lower_ascii()
    test_strip_punct()
    test_self_id_positive()
    test_self_id_negative()
    test_concept_extract()
    test_relation_phrase()
    test_template_triple()
    test_unknown_reply()
    test_match_blocks()
    ce_summary("chat_intent_dispatch")
}

main()
