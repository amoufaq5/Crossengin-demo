// Unit tests for src/io/effectors/audio_tts.nova
//
// Verifies the R21C TTS pipeline: G2P (dictionary + rule fallback),
// per-phoneme Klatt synthesis, WAV wrapping, and the end-to-end
// tts_speak() pipeline. Round-trip with the STT seam is exercised when
// whisper is available (skipped silently otherwise).
//
// All integer math; no LLM.

import "std/syscall"
import "../ce_test.nova"
import "../../src/io/effectors/audio_tts.nova"

// ---- G2P dictionary path -------------------------------------------------

fn test_g2p_hello() {
    // "hello" is in the curated dictionary as HH EH L OW (canonical
    // CMUdict-style mapping). The brief explicitly calls this out as
    // the dictionary-path test fixture.
    let phs = tts_g2p_word("hello")
    ce_eq("hello -> 4 phonemes", len(phs), 4)
    ce_str_eq("hello[0] = hh", phs[0], "hh")
    ce_str_eq("hello[1] = eh", phs[1], "eh")
    ce_str_eq("hello[2] = l",  phs[2], "l")
    ce_str_eq("hello[3] = ow", phs[3], "ow")
}

fn test_g2p_world() {
    // "world" -> W ER L D. Dictionary entry.
    let phs = tts_g2p_word("world")
    ce_eq("world -> 4 phonemes", len(phs), 4)
    ce_str_eq("world[0] = w",  phs[0], "w")
    ce_str_eq("world[1] = er", phs[1], "er")
    ce_str_eq("world[2] = l",  phs[2], "l")
    ce_str_eq("world[3] = d",  phs[3], "d")
}

fn test_g2p_case_insensitive() {
    // "HELLO" should hit the same dictionary entry as "hello" (case-folded
    // at the lookup boundary).
    let lower = tts_g2p_word("hello")
    let upper = tts_g2p_word("HELLO")
    ce_eq("HELLO same length as hello", len(upper), len(lower))
    ce_str_eq("HELLO[0] matches",  upper[0], lower[0])
    ce_str_eq("HELLO[1] matches",  upper[1], lower[1])
}

fn test_g2p_function_word_the() {
    // "the" is the most-common English word; dictionary entry DH AX.
    let phs = tts_g2p_word("the")
    ce_eq("the -> 2 phonemes", len(phs), 2)
    ce_str_eq("the[0] = dh", phs[0], "dh")
    ce_str_eq("the[1] = ax", phs[1], "ax")
}

// ---- G2P rule-based fallback --------------------------------------------

fn test_g2p_unknown_word_does_not_crash() {
    // Brief mandate: G2P on unknown word falls back to letter-by-letter
    // without crash. "xyzwz" is gibberish so it hits the rule path.
    let phs = tts_g2p_word("xyzwz")
    ce_check("xyzwz emits at least 1 phoneme", len(phs) >= 1)
    // x maps to /K/ + /S/ (English orthographic rule), so the first two
    // phonemes are k and s; that's how the rule expands 'x'.
    ce_str_eq("xyzwz[0] = k (x -> ks)", phs[0], "k")
    ce_str_eq("xyzwz[1] = s (x -> ks)", phs[1], "s")
}

fn test_g2p_rule_fallback_digraph_sh() {
    // "shx" isn't in the dictionary; the rule path should pick up the
    // 'sh' digraph as a single /SH/ phoneme, then 'x' as /K/+/S/.
    let phs = tts_g2p_word("shx")
    ce_check("shx emits at least 3 phonemes", len(phs) >= 3)
    ce_str_eq("shx[0] = sh", phs[0], "sh")
}

fn test_g2p_rule_fallback_silent_e() {
    // "cake" -> K EY K (silent-e after CVC). Rule path; not in dict.
    let phs = tts_g2p_word("cake")
    ce_eq("cake -> 3 phonemes (silent-e)", len(phs), 3)
    ce_str_eq("cake[0] = k",  phs[0], "k")
    ce_str_eq("cake[1] = ey", phs[1], "ey")
    ce_str_eq("cake[2] = k",  phs[2], "k")
}

fn test_g2p_rule_fallback_silent_kn_prefix() {
    // "knee" -> N IY (the 'k' in 'kn' is silent). Rule path; "knee"
    // intentionally NOT in the dictionary so the strip_silent_prefix
    // is exercised.
    let phs = tts_g2p_word("knee")
    // After stripping 'k', we have "nee" -> N + EE digraph -> N + IY.
    ce_eq("knee -> 2 phonemes after stripping silent k", len(phs), 2)
    ce_str_eq("knee[0] = n",  phs[0], "n")
    ce_str_eq("knee[1] = iy", phs[1], "iy")
}

// ---- text-level G2P -----------------------------------------------------

fn test_g2p_text_hello_world() {
    // Brief: phoneme count for "hello world" should be in 8..12. hello=4,
    // world=4 -> 8 phonemes (the lower bound; we hit it exactly via
    // the dictionary path).
    let phs = tts_g2p("hello world")
    ce_check("hello world phonemes >= 8", len(phs) >= 8)
    ce_check("hello world phonemes <= 12", len(phs) <= 12)
}

fn test_g2p_text_tokenizes_on_punctuation() {
    // "hello, world!" should tokenize the same as "hello world" -- the
    // comma and exclamation become word separators.
    let a = tts_g2p("hello world")
    let b = tts_g2p("hello, world!")
    ce_eq("comma+bang produces same phoneme count", len(b), len(a))
}

fn test_g2p_text_empty() {
    let phs = tts_g2p("")
    ce_eq("empty text -> 0 phonemes", len(phs), 0)
}

// ---- per-phoneme synth + WAV wrap ---------------------------------------

fn test_synth_phonemes_single_vowel() {
    // A single vowel should produce a non-empty WAV. Klatt vowels are
    // 1200 samples at 8 kHz, so the WAV body is 2400 bytes + 44 header
    // = 2444 bytes total.
    let phs = list_new()
    push(phs, "a")
    let wav = tts_synth_phonemes(phs, 16000)
    ce_check("single-vowel WAV not empty", len(wav) > 44)
    ce_eq("single vowel = 44 header + 1200 * 2 bytes", len(wav), 44 + 1200 * 2)
}

fn test_synth_phonemes_wav_starts_RIFF() {
    let phs = list_new()
    push(phs, "a")
    let wav = tts_synth_phonemes(phs, 16000)
    ce_eq("byte 0 = 'R'", wav[0], 82)
    ce_eq("byte 1 = 'I'", wav[1], 73)
    ce_eq("byte 2 = 'F'", wav[2], 70)
    ce_eq("byte 3 = 'F'", wav[3], 70)
    ce_eq("byte 8 = 'W'", wav[8], 87)
    ce_eq("byte 9 = 'A'", wav[9], 65)
    ce_eq("byte 10 = 'V'", wav[10], 86)
    ce_eq("byte 11 = 'E'", wav[11], 69)
}

fn test_synth_phonemes_sample_rate_in_header() {
    // Header bytes 24..27 hold the LE u32 sample rate. Requesting
    // 16000 should round-trip there exactly.
    let phs = list_new()
    push(phs, "a")
    let wav = tts_synth_phonemes(phs, 16000)
    // 16000 = 0x3E80 -> bytes 0x80, 0x3E, 0x00, 0x00.
    ce_eq("sample rate byte 0", wav[24], 128)        // 0x80
    ce_eq("sample rate byte 1", wav[25], 62)         // 0x3E
    ce_eq("sample rate byte 2", wav[26], 0)
    ce_eq("sample rate byte 3", wav[27], 0)
}

fn test_synth_phonemes_word_break_renders_silence() {
    // Synth with one vowel + break + one vowel should be
    // 1200 + 480 + 1200 = 2880 samples; the middle 480 are zero (the
    // silence sentinel).
    let phs = list_new()
    push(phs, "a") push(phs, "_brk_") push(phs, "a")
    let wav = tts_synth_phonemes(phs, 16000)
    ce_eq("3-element seq with break -> 44 + 2880*2 bytes",
        len(wav), 44 + 2880 * 2)
    // The middle 480 PCM samples should all be 0. Byte offset of the
    // break region: header(44) + first-vowel-pcm(2400) = 2444; len=960.
    let zero_count = 0
    let i = 2444
    while i < 2444 + 960 {
        if wav[i] == 0 { zero_count = zero_count + 1 }
        i = i + 1
    }
    ce_eq("break region all zero bytes", zero_count, 960)
}

// ---- end-to-end tts_speak ------------------------------------------------

fn test_speak_hello_world_returns_valid_wav() {
    let wav = tts_speak("hello world", 16000)
    ce_check("hello world WAV has 44-byte header + PCM", len(wav) > 44)
    // RIFF magic
    ce_eq("byte 0 = 'R'", wav[0], 82)
    ce_eq("byte 8 = 'W'", wav[8], 87)
}

fn test_speak_empty_text_produces_header_only_wav() {
    let wav = tts_speak("", 16000)
    ce_eq("empty text -> 44-byte header only", len(wav), 44)
    ce_eq("byte 0 still 'R' (legal silent WAV)", wav[0], 82)
}

fn test_speak_is_deterministic() {
    // Brief mandate: same text + same sample rate -> bit-identical bytes.
    audio_synth_mode_reset()
    audio_lcg_reset()
    let a = tts_speak("hello world", 16000)
    audio_synth_mode_reset()
    audio_lcg_reset()
    let b = tts_speak("hello world", 16000)
    ce_eq("same input -> same WAV length", len(b), len(a))
    // Spot-check a handful of bytes across the buffer.
    let i = 0
    let mismatch = 0
    while i < len(a) {
        if a[i] != b[i] { mismatch = mismatch + 1 }
        i = i + 1
    }
    ce_eq("zero byte mismatches across whole WAV", mismatch, 0)
}

fn test_save_wav_round_trip() {
    let wav = tts_speak("hello", 16000)
    let ok = tts_save_wav(wav, "/tmp/ce_test_tts_save.wav")
    ce_eq("tts_save_wav reports success", ok, 1)
    // Read the file back and verify the first 4 bytes are RIFF and
    // the total length matches the byte list size.
    let fd = sys_open("/tmp/ce_test_tts_save.wav", O_RDONLY, 0)
    ce_check("written file opens", fd >= 0)
    let buf = alloc(65536)
    let n = sys_read(fd, buf, 65536)
    sys_close(fd)
    ce_eq("first byte 'R'", load8(buf), 82)
    ce_eq("file size matches WAV byte count", n, len(wav))
}

// ---- diagnostics --------------------------------------------------------

fn test_phonemes_to_string() {
    let phs = list_new()
    push(phs, "hh") push(phs, "eh") push(phs, "l") push(phs, "ow")
    let s = tts_phonemes_to_string(phs)
    ce_str_eq("space-separated", s, "hh eh l ow")
}

fn test_tokenize_basic() {
    let toks = tts_tokenize("hello world")
    ce_eq("2 tokens", len(toks), 2)
    ce_str_eq("tok[0]", toks[0], "hello")
    ce_str_eq("tok[1]", toks[1], "world")
}

fn test_tokenize_strips_empty() {
    let toks = tts_tokenize("  hello,, ,  world ?")
    ce_eq("still 2 tokens after extra separators", len(toks), 2)
    ce_str_eq("tok[0] hello", toks[0], "hello")
    ce_str_eq("tok[1] world", toks[1], "world")
}

fn test_g2p_marked_inserts_break() {
    // tts_g2p_marked should insert TTS_BREAK_LABEL between words.
    let phs = tts_g2p_marked("hello world")
    // hello (4) + brk (1) + world (4) = 9
    ce_eq("marked phoneme count = 9", len(phs), 9)
    ce_str_eq("phs[4] = break sentinel", phs[4], "_brk_")
}

// ---- main ---------------------------------------------------------------

fn main() {
    // dictionary path
    test_g2p_hello()
    test_g2p_world()
    test_g2p_case_insensitive()
    test_g2p_function_word_the()
    // rule fallback
    test_g2p_unknown_word_does_not_crash()
    test_g2p_rule_fallback_digraph_sh()
    test_g2p_rule_fallback_silent_e()
    test_g2p_rule_fallback_silent_kn_prefix()
    // text-level
    test_g2p_text_hello_world()
    test_g2p_text_tokenizes_on_punctuation()
    test_g2p_text_empty()
    // synthesis
    test_synth_phonemes_single_vowel()
    test_synth_phonemes_wav_starts_RIFF()
    test_synth_phonemes_sample_rate_in_header()
    test_synth_phonemes_word_break_renders_silence()
    // tts_speak end-to-end
    test_speak_hello_world_returns_valid_wav()
    test_speak_empty_text_produces_header_only_wav()
    test_speak_is_deterministic()
    test_save_wav_round_trip()
    // diagnostics
    test_phonemes_to_string()
    test_tokenize_basic()
    test_tokenize_strips_empty()
    test_g2p_marked_inserts_break()
    ce_summary("audio_tts")
}

main()
