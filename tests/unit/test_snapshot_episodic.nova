// Unit tests for the EPISODIC section in src/persistence/snapshot_disk.nova
// (Phase 11 P0.1 follow-up).
//
// Verifies the moment stream + episode storage round-trip: build a populated
// stream, serialize to text, parse back, apply to a fresh subsystem, and
// confirm every per-moment field that participates in reboot (timestamp,
// lifecycle, valence/salience, trace atom ids) survives. Also covers the
// empty round-trip, a legacy `episodic.present 1` (no sub-fields) hint, and
// the policy that on /load the live moment stream is REPLACED -- the snapshot
// is the new ground truth.
//
// ADR-0048 (snapshot container + runtime seam), ADR-0021 (moments),
// ADR-0022 (episodic memory).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"

// ---- helpers --------------------------------------------------------------

// Build a snapshot wrapping just the EPISODIC blob (plus minimal SOUL + KGS
// stubs so snap_to_text / snap_from_text accept the sections frame).
fn _wrap_for_text(blob) {
    let s = snap_new(1, 100)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 0)
    push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    snap_put_section(s, SEC_EPISODIC, blob)
    return s
}

// ---- empty stream round-trip ----------------------------------------------

fn test_empty_round_trip() {
    let stream = ms_new()
    let em = em_new()
    let blob = episodic_section_build(stream, em)
    ce_eq("empty blob has zero moments",  len(blob[0]), 0)
    ce_eq("empty blob has zero episodes", len(blob[1]), 0)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    ce_check("text encoded non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("decoded snapshot valid", snap_valid(s2) == 1)
    ce_check("episodic section present after round trip",
        snap_has_section(s2, SEC_EPISODIC) == 1)
    let eb2 = snap_section(s2, SEC_EPISODIC)
    ce_eq("decoded moments count is 0",  len(eb2[0]), 0)
    ce_eq("decoded episodes count is 0", len(eb2[1]), 0)

    // Apply onto fresh subsystem -> still empty.
    let stream2 = ms_new()
    let em2 = em_new()
    episodic_section_apply(stream2, em2, eb2)
    ce_eq("applied stream has 0 moments",  ms_count(stream2), 0)
    ce_eq("applied em has 0 episodes",     em_count(em2), 0)
}

// ---- populated round-trip -------------------------------------------------

fn test_populated_round_trip() {
    let stream = ms_new()
    let em = em_new()
    // 5 moments: ts = 10, 20, 30, 40, 50; traces of varying length.
    let m0 = ms_capture(stream, 10, MODALITY_TEXT, "hello",  600, 0)
    moment_add_trace(m0, 7)
    moment_add_trace(m0, 8)
    let m1 = ms_capture(stream, 20, MODALITY_TEXT, "widget", 700, 0)
    moment_add_trace(m1, 11)
    let m2 = ms_capture(stream, 30, MODALITY_TEXT, "fever",  800, 0)
    moment_add_trace(m2, 5)
    moment_add_trace(m2, 6)
    moment_add_trace(m2, 7)
    let m3 = ms_capture(stream, 40, MODALITY_TEXT, "go", 500, 0)
    let m4 = ms_capture(stream, 50, MODALITY_TEXT, "stop", 400, 0)
    // Settle the older ones so we exercise lifecycle persistence.
    moment_settle(m0)
    moment_settle(m1)
    ce_eq("source stream has 5 moments", ms_count(stream), 5)

    em_record(em, moment_id(m0), 600, 10)
    em_record(em, moment_id(m1), 700, 20)
    em_record(em, moment_id(m2), 800, 30)
    em_consolidate(em, 0)   // mark first episode CONSOLIDATED
    ce_eq("source em has 3 episodes", em_count(em), 3)

    let blob = episodic_section_build(stream, em)
    ce_eq("blob has 5 moment records",  len(blob[0]), 5)
    ce_eq("blob has 3 episode records", len(blob[1]), 3)

    // Round-trip via text encode -> decode.
    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    ce_check("encoded non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("decoded valid", snap_valid(s2) == 1)
    let eb2 = snap_section(s2, SEC_EPISODIC)
    ce_eq("decoded moment count",  len(eb2[0]), 5)
    ce_eq("decoded episode count", len(eb2[1]), 3)

    // Apply onto fresh subsystem.
    let stream2 = ms_new()
    let em2 = em_new()
    let restored = episodic_section_apply(stream2, em2, eb2)
    ce_eq("episodic_section_apply returns moment count restored", restored, 5)
    ce_eq("applied stream has 5 moments",  ms_count(stream2), 5)
    ce_eq("applied em has 3 episodes",     em_count(em2), 3)

    // Per-moment field survival.
    let r0 = ms_get(stream2, 0)
    let r1 = ms_get(stream2, 1)
    let r2 = ms_get(stream2, 2)
    let r3 = ms_get(stream2, 3)
    ce_eq("moment 0 ts",            moment_timestamp(r0), 10)
    ce_eq("moment 0 lifecycle SETTLED", moment_status(r0), MSTAT_SETTLED)
    ce_eq("moment 0 trace len 2",   len(moment_trace(r0)), 2)
    ce_eq("moment 0 atom[0] = 7",   moment_trace(r0)[0], 7)
    ce_eq("moment 1 ts",            moment_timestamp(r1), 20)
    ce_eq("moment 2 trace len 3",   len(moment_trace(r2)), 3)
    ce_eq("moment 3 ts",            moment_timestamp(r3), 40)

    // Per-episode field survival.
    let e0 = em_get(em2, 0)
    let e2 = em_get(em2, 2)
    ce_eq("episode 0 moment ref",   episode_moment(e0), 0)
    ce_eq("episode 0 tier survived (CONSOLIDATED)",
        episode_tier(e0), EP_CONSOLIDATED)
    ce_eq("episode 2 moment ref",   episode_moment(e2), 2)
}

// ---- backwards compat: presence-only stub --------------------------------

fn test_legacy_presence_only_parses_empty() {
    // An old snapshot with `episodic.present 1` but NO sub-fields parses
    // cleanly as an empty section. The legacy-hint policy mirrors `kgs.atoms`.
    let old = ""
        + "crossengin-snapshot v1\n"
        + "tag " + int_to_str(SNAP_TAG) + "\n"
        + "ver " + int_to_str(SNAP_FORMAT_VERSION) + "\n"
        + "instance 1\n"
        + "timestamp 1\n"
        + "sections 5\n"
        + "soul.present 1\n"
        + "soul.name Aurora\n"
        + "soul.constcount 0\n"
        + "kgs.present 1\n"
        + "kgs.atoms 0\n"
        + "kgs.atoms.count 0\n"
        + "episodic.present 1\n"
        + "synapses.present 0\n"
        + "selfmodel.present 0\n"
        + "end\n"
    let s = snap_from_text(old)
    ce_check("legacy snapshot parses", s != 0)
    ce_check("episodic section present", snap_has_section(s, SEC_EPISODIC) == 1)
    let eb = snap_section(s, SEC_EPISODIC)
    ce_eq("legacy episodic blob has empty moments",  len(eb[0]), 0)
    ce_eq("legacy episodic blob has empty episodes", len(eb[1]), 0)

    // Apply: live state stays empty.
    let stream = ms_new()
    let em = em_new()
    episodic_section_apply(stream, em, eb)
    ce_eq("post-apply moment count", ms_count(stream), 0)
    ce_eq("post-apply episode count", em_count(em), 0)
}

// ---- REPLACE policy on apply ---------------------------------------------

fn test_apply_replaces_existing_state() {
    // Live state has 3 moments + 2 episodes; applying a 1-moment snapshot
    // REPLACES the live state, not appends.
    let stream = ms_new()
    let em = em_new()
    ms_capture(stream, 1, MODALITY_TEXT, "live", 600, 0)
    ms_capture(stream, 2, MODALITY_TEXT, "data", 600, 0)
    ms_capture(stream, 3, MODALITY_TEXT, "here", 600, 0)
    em_record(em, 0, 600, 1)
    em_record(em, 1, 600, 2)
    ce_eq("live stream pre-apply", ms_count(stream), 3)
    ce_eq("live em pre-apply", em_count(em), 2)

    // Snapshot has only 1 moment / 0 episodes.
    let s2 = ms_new()
    let em2 = em_new()
    let m = ms_capture(s2, 100, MODALITY_TEXT, "single", 700, 0)
    moment_add_trace(m, 42)
    let blob = episodic_section_build(s2, em2)
    episodic_section_apply(stream, em, blob)
    ce_eq("post-apply replaces moment count", ms_count(stream), 1)
    ce_eq("post-apply replaces episode count", em_count(em), 0)
    let restored = ms_get(stream, 0)
    ce_eq("restored moment ts", moment_timestamp(restored), 100)
    ce_eq("restored moment trace", moment_trace(restored)[0], 42)
}

// ---- end-to-end on-disk round-trip ---------------------------------------

fn test_disk_round_trip() {
    // The headline path: 10 moments + 5 episodes -> snap_save -> snap_load
    // -> apply -> every moment id / ts / trace survives.
    let stream = ms_new()
    let em = em_new()
    let i = 0
    while i < 10 {
        let m = ms_capture(stream, 100 + i, MODALITY_TEXT, "msg", 600, 0)
        moment_add_trace(m, i * 2)
        moment_add_trace(m, i * 2 + 1)
        i = i + 1
    }
    let j = 0
    while j < 5 {
        em_record(em, j, 600, 100 + j)
        j = j + 1
    }

    let s = snap_new(7, 5000)
    let sb = list_new() push(sb, "Aurora") push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new() push(kb, 0) push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    snap_put_section(s, SEC_EPISODIC, episodic_section_build(stream, em))

    let path = "/tmp/crossengin_test_episodic_snap.dat"
    sys_unlink(path)
    let ok = snap_save(s, path)
    ce_eq("snap_save succeeded", ok, 1)
    let loaded = snap_load(path)
    ce_check("snap_load returned a value", loaded != 0)
    let eb_l = snap_section(loaded, SEC_EPISODIC)
    ce_eq("loaded moment count", len(eb_l[0]), 10)
    ce_eq("loaded episode count", len(eb_l[1]), 5)

    let stream2 = ms_new()
    let em2 = em_new()
    episodic_section_apply(stream2, em2, eb_l)
    ce_eq("post-load stream",  ms_count(stream2), 10)
    ce_eq("post-load em",      em_count(em2), 5)
    let last = ms_get(stream2, 9)
    ce_eq("last moment ts (109)", moment_timestamp(last), 109)
    ce_eq("last moment trace[0] = 18", moment_trace(last)[0], 18)
    ce_eq("last moment trace[1] = 19", moment_trace(last)[1], 19)

    sys_unlink(path)
    sys_unlink(snap_tmp_path(path))
}

fn main() {
    test_empty_round_trip()
    test_populated_round_trip()
    test_legacy_presence_only_parses_empty()
    test_apply_replaces_existing_state()
    test_disk_round_trip()
    ce_summary("snapshot_episodic")
}
main()
