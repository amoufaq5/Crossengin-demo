// Unit tests for src/reader/lexical_anchor.nova
// Verifies tokenization, matching tokens to word atoms, SENSORY signals (tagged
// with the matched atom id) for hits and CURIOSITY signals for OOV tokens, and
// the curiosity list. ADR-0012 stage 1.

import "../ce_test.nova"
import "../../src/reader/lexical_anchor.nova"

fn build_env() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "fever", 0)
    word_atom_new(lang, "cough", 0)
    return renv_new(reg, lang, 0, 0, 0)
}

fn test_anchor_mixed() {
    let e = build_env()
    let c = rctx_new("Fever and cough")
    let matched = reader_anchor(e, c)
    ce_eq("two matched", matched, 2)
    ce_eq("three tokens", len(rctx_tokens(c)), 3)
    ce_eq("three anchors", len(rctx_anchors(c)), 3)
    let anchors = rctx_anchors(c)
    ce_eq("fever matched", anchor_matched(anchors[0]), 1)
    ce_str_eq("token normalized", anchor_token(anchors[0]), "fever")
    ce_eq("and unmatched", anchor_matched(anchors[1]), 0)
    ce_eq("cough matched", anchor_matched(anchors[2]), 1)
    // One OOV token recorded.
    ce_eq("one curiosity", len(rctx_curiosity(c)), 1)
    ce_str_eq("curiosity token", rctx_curiosity(c)[0], "and")
}

fn test_signals() {
    let e = build_env()
    let c = rctx_new("fever and cough")
    reader_anchor(e, c)
    let sensory = rctx_sensory(c)
    ce_eq("three signals", len(sensory), 3)
    // Matched -> SENSORY tagged with the word atom id; OOV -> CURIOSITY.
    ce_eq("first is SENSORY", sig_type(sensory[0]), XSIG_SENSORY)
    ce_check("SENSORY tagged with atom id", sig_meta(sensory[0]) >= 0)
    ce_eq("second is CURIOSITY", sig_type(sensory[1]), XSIG_CURIOSITY)
    ce_eq("third is SENSORY", sig_type(sensory[2]), XSIG_SENSORY)
    // Matched anchor carries the word's confidence; OOV carries low confidence.
    ce_eq("matched confidence", anchor_conf(rctx_anchors(c)[0]), 500)
    ce_eq("oov confidence low", anchor_conf(rctx_anchors(c)[1]), ANCHOR_LOW_CONF)
}

fn test_all_unknown() {
    let e = build_env()
    let c = rctx_new("xyz   qrs")   // multiple spaces too
    ce_eq("none matched", reader_anchor(e, c), 0)
    ce_eq("two tokens (empties dropped)", len(rctx_tokens(c)), 2)
    ce_eq("two curiosity", len(rctx_curiosity(c)), 2)
}

// ---- R48: learned-bigram anchoring -----------------------------------------
fn build_env_compound() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "lung_cancer", 0)
    word_atom_new(lang, "smoking", 0)
    return renv_new(reg, lang, 0, 0, 0)
}

fn test_anchor_bigram_alone() {
    let e = build_env_compound()
    let c = rctx_new("lung cancer")
    reader_anchor(e, c)
    let anchors = rctx_anchors(c)
    ce_eq("bigram -> 1 anchor", len(anchors), 1)
    ce_str_eq("anchor is the compound", anchor_token(anchors[0]), "lung_cancer")
    ce_eq("compound matched", anchor_matched(anchors[0]), 1)
}

fn test_anchor_bigram_in_sentence() {
    let e = build_env_compound()
    let c = rctx_new("smoking causes lung cancer")
    reader_anchor(e, c)
    let anchors = rctx_anchors(c)
    // smoking(hit) + causes(miss) + lung_cancer(hit) = 3 anchors (not 4)
    ce_eq("compound merged: 3 anchors", len(anchors), 3)
    ce_eq("smoking matched", anchor_matched(anchors[0]), 1)
    ce_str_eq("third anchor is the compound", anchor_token(anchors[2]), "lung_cancer")
    ce_eq("compound matched", anchor_matched(anchors[2]), 1)
}

fn test_anchor_no_bigram_fallback() {
    let e = build_env_compound()
    let c = rctx_new("lung disease")             // lung_disease is not a learned atom
    reader_anchor(e, c)
    ce_eq("no bigram -> 2 single anchors", len(rctx_anchors(c)), 2)
}

fn main() {
    test_anchor_mixed()
    test_signals()
    test_all_unknown()
    test_anchor_bigram_alone()
    test_anchor_bigram_in_sentence()
    test_anchor_no_bigram_fallback()
    ce_summary("lexical_anchor")
}

main()
