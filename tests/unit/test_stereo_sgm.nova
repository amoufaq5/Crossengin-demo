// Unit tests for the R9A Semi-Global Matching (SGM) follow-up in
// src/io/transducers/image_stereo.nova: stereo_disparity_sgm and
// stereo_disparity_sgm_quality. Hirschmuller (2008) -- aggregate the
// matching cost along multiple 1-D scanline paths to enforce smoothness
// and dramatically reduce speckle in low-texture regions.
//
// All fixtures are in-memory (alloc + store8) so the suite never depends
// on an on-disk image -- mirrors R7E/R8D conventions.
//
// Assertion targets (~28):
//   * SGM on identical inputs: disparity 0 everywhere interior (the
//     smooth-zero case; both SGM and block-matching agree here).
//   * SGM on integer-shifted-by-8 pair: probed interior pixels read
//     disparity == 8.
//   * SGM on textureless-band fixture: SGM has LOWER variance than
//     block-matching in the band (speckle reduction; the headline
//     SGM benefit).
//   * SGM with P2 >> P1 (large discontinuity penalty) on a textureless
//     region: the disparity is smooth (per-pixel variance is small).
//   * SGM with very high P1+P2 over-smooths: most pixels converge to
//     a single disparity (low variance, possibly biased).
//   * stereo_disparity_sgm_quality on integer-shifted-by-8 pair:
//     consistent interior pixels report ~8000 milli, border / occluded
//     pixels report 0.
//   * stereo_disparity_sgm_quality on textureless band: LR-check
//     rejects a measurable fraction of band pixels (zero in milli).
//   * Result accessors return sane values.
//   * Invalid-input refusals for the two new APIs.
//   * Dimension cap (>= 128) refused cleanly.

import "../ce_test.nova"
import "../../src/io/transducers/image_stereo.nova"

// ---- fixture builders ---------------------------------------------------

fn _flat_fixture(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

fn _textured_fixture(width, height) {
    let area = width * height
    let buf = alloc(area + 1)
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = (x * 37 + y * 13)
            let q = v / 256
            v = v - q * 256
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// right(x, y) = left(x + shift, y) [integer left-shift]
fn _shift_left_fixture(src, width, height, shift) {
    let area = width * height
    let buf = alloc(area + 1)
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let sx = x + shift
            let v = 0
            if sx < width { v = load8(src + row_off + sx) }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Paint a textureless-but-noisy band into both fixtures (rows [yL..yH),
// columns [xL..xH)). The band uses base 150 with very small (~3-pixel)
// per-side noise so SAD has multiple near-equal minima; tiny noise that
// differs left vs right makes BM pick different d's pixel by pixel
// (the speckle case) while SGM aggregates and smooths.
fn _paint_textureless_band(left, right, w, xL, xH, yL, yH) {
    let y = yL
    while y < yH {
        let rb = y * w
        let x = xL
        while x < xH {
            let nl = (x * 5 + y * 3) - (((x * 5 + y * 3) / 3) * 3)
            let nr = (x * 11 + y * 7) - (((x * 11 + y * 7) / 3) * 3)
            store8(left  + rb + x, 150 + nl)
            store8(right + rb + x, 150 + nr)
            x = x + 1
        }
        y = y + 1
    }
    return 0
}

// Pure textureless-noisy stereo pair: a flat 128-base image with low-
// amplitude (mod-4) per-side noise that differs left vs right -- the
// canonical SGM-wins fixture. BM speckles wildly because SAD has many
// near-tied minima broken differently at every pixel; SGM aggregates
// along scanline paths and converges every pixel to the same d.
fn _noisy_flat_pair(w, h) {
    let area = w * h
    let l = alloc(area + 1)
    let r = alloc(area + 1)
    let y = 0
    while y < h {
        let rb = y * w
        let x = 0
        while x < w {
            let nl = (x * 7 + y * 11) - (((x * 7 + y * 11) / 4) * 4)
            let nr = (x * 13 + y * 17) - (((x * 13 + y * 17) / 4) * 4)
            store8(l + rb + x, 128 + nl)
            store8(r + rb + x, 128 + nr)
            x = x + 1
        }
        y = y + 1
    }
    store8(l + area, 0)
    store8(r + area, 0)
    let pair = list_new()
    push(pair, l)
    push(pair, r)
    return pair
}

// Variance of disparity-map values over rect [xL..xH) x [yL..yH).
fn _disparity_variance(map, w, xL, xH, yL, yH) {
    let sum = 0
    let cnt = 0
    let y = yL
    while y < yH {
        let x = xL
        while x < xH {
            sum = sum + stereo_disparity_at(map, w, x, y)
            cnt = cnt + 1
            x = x + 1
        }
        y = y + 1
    }
    let mean = 0
    if cnt > 0 { mean = sum / cnt }
    let vsum = 0
    let y2 = yL
    while y2 < yH {
        let x2 = xL
        while x2 < xH {
            let d = stereo_disparity_at(map, w, x2, y2) - mean
            vsum = vsum + d * d
            x2 = x2 + 1
        }
        y2 = y2 + 1
    }
    return vsum
}

// ---- SGM identity / shifted-pair tests ----------------------------------

fn test_sgm_identical_inputs_zero() {
    // left == right -> SGM disparity 0 at every interior pixel.
    let buf = _textured_fixture(32, 24)
    let r = stereo_disparity_sgm(buf, buf, 32, 24, 5, 16, 0, 0)
    let m = stereo_result_map(r)
    ce_check("SGM identical -> non-zero map ptr", m != 0)
    ce_eq("SGM identical -> mean 0", stereo_result_mean(r), 0)
    ce_eq("SGM identical -> density 0", stereo_result_density(r), 0)
    ce_eq("SGM identical disp(15, 12) == 0",
          stereo_disparity_at(m, 32, 15, 12), 0)
    ce_eq("SGM identical disp(20, 14) == 0",
          stereo_disparity_at(m, 32, 20, 14), 0)
    ce_eq("SGM identical total == area",
          stereo_result_total(r), 32 * 24)
}

fn test_sgm_shifted_by_8() {
    // left + left-shifted-by-8 pair: deep interior pixels recover
    // disparity 8 (same as R7E/R8D, but more reliably via aggregation).
    let SHIFT = 8
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, SHIFT)
    let r = stereo_disparity_sgm(left, right, 40, 32, 5, 16, 0, 0)
    let m = stereo_result_map(r)
    ce_check("SGM shifted -> non-zero map", m != 0)
    let d1 = stereo_disparity_at(m, 40, 20, 16)
    let d2 = stereo_disparity_at(m, 40, 25, 18)
    let d3 = stereo_disparity_at(m, 40, 30, 20)
    ce_eq("SGM shifted disp(20, 16) == SHIFT (8)", d1, SHIFT)
    ce_eq("SGM shifted disp(25, 18) == SHIFT (8)", d2, SHIFT)
    ce_eq("SGM shifted disp(30, 20) == SHIFT (8)", d3, SHIFT)
    let mean = stereo_result_mean(r)
    ce_check("SGM shifted mean > 0", mean > 0)
}

// ---- SGM textureless region: lower variance than BM ---------------------

fn test_sgm_pure_noise_lower_variance_than_bm() {
    // The canonical SGM-wins case: a wholly textureless-noisy stereo
    // pair (both sides flat-128 with uncorrelated low-amplitude noise).
    // BM speckles because SAD has many near-tied minima broken
    // differently at each pixel; SGM aggregates and smooths to a single
    // (arbitrary but uniform) disparity. Variance over a wide interior
    // region must be SMALLER for SGM than BM.
    let pair = _noisy_flat_pair(32, 24)
    let l = pair[0]
    let r = pair[1]
    let r_bm = stereo_disparity(l, r, 32, 24, 5, 16)
    let m_bm = stereo_result_map(r_bm)
    let r_sg = stereo_disparity_sgm(l, r, 32, 24, 5, 16, 8, 64)
    let m_sg = stereo_result_map(r_sg)
    let v_bm = _disparity_variance(m_bm, 32, 5, 27, 5, 19)
    let v_sg = _disparity_variance(m_sg, 32, 5, 27, 5, 19)
    ce_check("SGM variance < BM variance on noisy-flat pair",
             v_sg < v_bm)
    // Also: BM variance should be substantial (the speckle invariant).
    ce_check("BM variance > 0 (speckle invariant on noisy-flat)",
             v_bm > 0)
}

fn test_sgm_textureless_propagates_correct_shift() {
    // Mostly-flat band [10..30) x [12..20) with tiny left/right noise so
    // SAD has many near-equal minima. The textured surround is shifted
    // by SHIFT=4. BM picks d=0 in the textureless band (smallest tie
    // wins); SGM aggregates along scanlines and propagates the
    // surrounding SHIFT=4 disparity INTO the textureless region. The
    // mean SGM disparity in the band is therefore closer to SHIFT
    // (4) than BM's; BM's mean in the band is closer to 0.
    let SHIFT = 4
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, SHIFT)
    _paint_textureless_band(left, right, 40, 10, 30, 12, 20)

    let r_bm = stereo_disparity(left, right, 40, 32, 5, 16)
    let m_bm = stereo_result_map(r_bm)
    let r_sg = stereo_disparity_sgm(left, right, 40, 32, 5, 16, 8, 64)
    let m_sg = stereo_result_map(r_sg)

    // Mean disparity over the interior band [12..28) x [14..18).
    let bm_sum = 0
    let sg_sum = 0
    let cnt = 0
    let y = 14
    while y < 18 {
        let x = 12
        while x < 28 {
            bm_sum = bm_sum + stereo_disparity_at(m_bm, 40, x, y)
            sg_sum = sg_sum + stereo_disparity_at(m_sg, 40, x, y)
            cnt = cnt + 1
            x = x + 1
        }
        y = y + 1
    }
    let bm_mean = bm_sum / cnt
    let sg_mean = sg_sum / cnt
    // SGM propagates the surrounding SHIFT (4) into the band -> mean
    // closer to 4; BM defaults to 0 in the band -> mean closer to 0.
    ce_check("SGM band mean closer to SHIFT than BM band mean",
             sg_mean > bm_mean)
    ce_check("SGM band mean >= SHIFT/2 (smooths to surroundings)",
             sg_mean >= SHIFT / 2)
}

// ---- SGM smoothness with large P2 ---------------------------------------

fn test_sgm_large_p2_is_smooth() {
    // With P2 >> P1, large disparity jumps are heavily penalized, so the
    // aggregated S(p, d) is dominated by the "min(d') + P2" term in
    // textureless regions and the disparity map is smooth. We assert
    // smoothness via mean -- the band-region SGM disparity should
    // converge near the surround SHIFT=4 since SGM propagates from
    // textured pixels INTO the band.
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, 4)
    _paint_textureless_band(left, right, 40, 10, 30, 12, 20)
    let r = stereo_disparity_sgm(left, right, 40, 32, 5, 16, 4, 200)
    let m = stereo_result_map(r)
    // Sample 4 band pixels: with large P2, they should all be == SHIFT.
    let d1 = stereo_disparity_at(m, 40, 18, 16)
    let d2 = stereo_disparity_at(m, 40, 20, 16)
    let d3 = stereo_disparity_at(m, 40, 22, 16)
    let d4 = stereo_disparity_at(m, 40, 24, 16)
    ce_check("SGM large-P2 band pixel d(18,16) >= SHIFT/2",
             d1 >= 2)
    ce_check("SGM large-P2 band pixel d(20,16) >= SHIFT/2",
             d2 >= 2)
    ce_check("SGM large-P2 band pixel d(22,16) >= SHIFT/2",
             d3 >= 2)
    ce_check("SGM large-P2 band pixel d(24,16) >= SHIFT/2",
             d4 >= 2)
}

fn test_sgm_p2_equal_p1_smoother_still() {
    // With P2 == P1 (we still respect the clamp P2 >= P1), the cost of
    // any disparity jump is uniform -- the smooth path picks the global
    // min cost. We assert the SGM map is at least produced and probed
    // shifted-pair pixels still read SHIFT exactly.
    let SHIFT = 8
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, SHIFT)
    let r = stereo_disparity_sgm(left, right, 40, 32, 5, 16, 16, 16)
    let m = stereo_result_map(r)
    let d1 = stereo_disparity_at(m, 40, 20, 16)
    let d2 = stereo_disparity_at(m, 40, 25, 18)
    ce_check("SGM with P2==P1 still recovers SHIFT at probed",
             d1 == SHIFT)
    ce_check("SGM with P2==P1 still recovers SHIFT at probed (2)",
             d2 == SHIFT)
}

fn test_sgm_high_penalty_over_smooths() {
    // Very high P1 and P2 -> every transition gets a huge penalty so
    // the aggregation collapses interior pixels toward the single
    // global minimum disparity. We probe several interior pixels and
    // verify they all match -- over-smoothed to one value.
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, 4)
    let r = stereo_disparity_sgm(left, right, 40, 32, 5, 16, 200, 2000)
    let m = stereo_result_map(r)
    let d_ref = stereo_disparity_at(m, 40, 20, 16)
    let d2 = stereo_disparity_at(m, 40, 22, 16)
    let d3 = stereo_disparity_at(m, 40, 24, 16)
    let d4 = stereo_disparity_at(m, 40, 20, 18)
    ce_check("SGM high-penalty over-smooth: (22,16) == ref",
             d2 == d_ref)
    ce_check("SGM high-penalty over-smooth: (24,16) == ref",
             d3 == d_ref)
    ce_check("SGM high-penalty over-smooth: (20,18) == ref",
             d4 == d_ref)
}

// ---- SGM quality (LR + sub-pixel) ---------------------------------------

fn test_sgm_quality_shifted_by_8() {
    // Combined SGM + LR + sub-pixel on integer-shifted-by-8 pair:
    // consistent interior pixels report ~8000 milli; corners report 0.
    let SHIFT = 8
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, SHIFT)
    let r = stereo_disparity_sgm_quality(left, right, 40, 32, 5, 16, 0, 0, 1)
    let m = stereo_result_map(r)
    let m1 = stereo_disparity_milli_at(m, 40, 20, 16)
    let m2 = stereo_disparity_milli_at(m, 40, 25, 18)
    ce_near("SGM-quality shifted milli(20, 16) ~= 8000", m1, 8000, 300)
    ce_near("SGM-quality shifted milli(25, 18) ~= 8000", m2, 8000, 300)
    // Corner pixel outside interior -> 0.
    ce_eq("SGM-quality border milli(0, 0) == 0",
          stereo_disparity_milli_at(m, 40, 0, 0), 0)
}

fn test_sgm_quality_textureless_lr_consistent() {
    // Textureless-band fixture: SGM aggregation produces a consistent
    // disparity in the band even where BM speckles. The LR-check
    // (vs the right->left block-matching map) might reject some of
    // those band pixels (the right pass also speckles), but SGM-quality
    // should still produce a well-formed result with positive mean and
    // some non-zero pixels.
    let left  = _textured_fixture(40, 32)
    let right = _shift_left_fixture(left, 40, 32, 4)
    _paint_textureless_band(left, right, 40, 10, 30, 12, 20)
    let r = stereo_disparity_sgm_quality(left, right, 40, 32, 5, 16, 8, 64, 1)
    let m = stereo_result_map(r)
    let total = stereo_result_total(r)
    ce_check("SGM-quality textureless: total == area",
             total == 40 * 32)
    // At least one non-zero milli pixel anywhere -> pipeline survived.
    let any_nonzero = 0
    let y = 10
    while y < 26 {
        let x = 10
        while x < 32 {
            if stereo_disparity_milli_at(m, 40, x, y) > 0 {
                any_nonzero = 1
            }
            x = x + 1
        }
        y = y + 1
    }
    ce_check("SGM-quality textureless: produces some non-zero milli",
             any_nonzero == 1)
}

// ---- Invalid input refusals ---------------------------------------------

fn test_sgm_invalid_inputs() {
    let buf = _flat_fixture(8, 8, 100)
    let r0 = stereo_disparity_sgm(0, buf, 8, 8, 5, 8, 0, 0)
    ce_eq("SGM zero left -> total 0", stereo_result_total(r0), 0)
    let r1 = stereo_disparity_sgm(buf, 0, 8, 8, 5, 8, 0, 0)
    ce_eq("SGM zero right -> total 0", stereo_result_total(r1), 0)
    let r2 = stereo_disparity_sgm(buf, buf, 200, 200, 5, 8, 0, 0)
    ce_eq("SGM oversized -> total 0", stereo_result_total(r2), 0)
    // Volume cap: 128 * 128 * 64 = 1M ints (>= 512K cap) -> reject.
    let r3 = stereo_disparity_sgm(buf, buf, 128, 128, 5, 64, 0, 0)
    ce_eq("SGM volume cap rejects 128x128x64", stereo_result_total(r3), 0)
}

fn test_sgm_quality_invalid_inputs() {
    let buf = _flat_fixture(8, 8, 100)
    let r0 = stereo_disparity_sgm_quality(0, buf, 8, 8, 5, 8, 0, 0, 1)
    ce_eq("SGM-quality zero left -> total 0", stereo_result_total(r0), 0)
    let r1 = stereo_disparity_sgm_quality(buf, 0, 8, 8, 5, 8, 0, 0, 1)
    ce_eq("SGM-quality zero right -> total 0", stereo_result_total(r1), 0)
    let r2 = stereo_disparity_sgm_quality(buf, buf, 200, 200, 5, 8, 0, 0, 1)
    ce_eq("SGM-quality oversized -> total 0", stereo_result_total(r2), 0)
}

// ---- /depth_sgm dispatch helpers ----------------------------------------

fn test_sgm_pgm_args_dispatch_basic() {
    let r0 = stereo_sgm_pgm_args("")
    ce_check("/depth_sgm no-arg returns usage",
             str_eq(r0, "(/depth_sgm needs two PATHs -- usage: /depth_sgm L.pgm R.pgm)") == 1)
    let r1 = stereo_sgm_pgm_args("only_one.pgm")
    ce_check("/depth_sgm one-arg returns 'got 1' usage",
             str_eq(r1, "(/depth_sgm needs TWO paths -- got 1)") == 1)
    let r2 = stereo_sgm_pgm_args("/nonexistent_left.pgm /nonexistent_right.pgm")
    ce_check("/depth_sgm missing files returns error", len(r2) > 0)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_sgm_identical_inputs_zero()
    test_sgm_shifted_by_8()
    test_sgm_pure_noise_lower_variance_than_bm()
    test_sgm_textureless_propagates_correct_shift()
    test_sgm_large_p2_is_smooth()
    test_sgm_p2_equal_p1_smoother_still()
    test_sgm_high_penalty_over_smooths()
    test_sgm_quality_shifted_by_8()
    test_sgm_quality_textureless_lr_consistent()
    test_sgm_invalid_inputs()
    test_sgm_quality_invalid_inputs()
    test_sgm_pgm_args_dispatch_basic()
    ce_summary("image_stereo_sgm")
}

main()
