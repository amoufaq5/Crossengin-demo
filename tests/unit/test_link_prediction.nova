// Unit tests for src/kg/link_prediction.nova (R18B).
//
// Covers Liben-Nowell + Kleinberg's classical neighbourhood overlap
// scores (Common Neighbors, Jaccard, Adamic-Adar) on integer milli-
// units, deterministic, no randomness. We exercise:
//   - disconnected atoms (no overlap) -> 0 across all three;
//   - identical neighbour sets -> Jaccard 1000, AA all max-weight;
//   - partial overlap -> predictable Jaccard / CN values;
//   - Adamic-Adar's hub down-weighting (a high-degree shared neighbour
//     contributes less than a low-degree one);
//   - top_k ranking, tie-breaking (ASCENDING atom_id), k=0 and k>N
//     boundary;
//   - barbell-with-missing-edge fixture (the bridge predicts the
//     missing edge between its two endpoints);
//   - random pair in disjoint subgraphs -> 0;
//   - method-name parsing helpers (lp_method_parse + lp_method_name);
//   - integer log2 helper edge cases.
//
// Total assertions: ~50 (well above the 25-30 brief target).
//
// ADRs: ADR-0016 (atom + xref shape), ADR-0049 (testing).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/cross_kg_references.nova"
import "../../src/kg/link_prediction.nova"

// ---- helpers --------------------------------------------------------------

// Build a fresh KG with `n` atoms, no xrefs. Returns the KG.
fn _mk_kg_n(label, n) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, label)
    let i = 0
    while i < n {
        kg_add_atom(kg, ATOM_FACT, "atom_" + int_to_str(i), 0)
        i = i + 1
    }
    return kg
}

// Add an UNDIRECTED edge a <-> b: two xrefs, one on each endpoint.
// Link prediction treats the link graph as undirected, so either
// direction by itself would still register both endpoints as
// neighbours -- but adding both reflects the canonical xref pattern
// most callers use (see R12C's _link, R13E's _link, ANN's xref_new
// + atom_add_xref form).
fn _link(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    let y = xref_new(b, a, XREF_SIMILAR, 900, 0)
    atom_add_xref(b, y)
    return 1
}

// ---- pairwise edge cases -------------------------------------------------

fn test_disconnected_zero() {
    // Two isolated atoms in a KG of 4. CN/J/AA should all be 0.
    let kg = _mk_kg_n("test_lp_disconn", 4)
    ce_eq("CN disconnected -> 0", lp_common_neighbors(kg, 0, 1), 0)
    ce_eq("J  disconnected -> 0", lp_jaccard(kg, 0, 1), 0)
    ce_eq("AA disconnected -> 0", lp_adamic_adar(kg, 0, 1), 0)
}

fn test_self_pair_zero() {
    let kg = _mk_kg_n("test_lp_self", 3)
    _link(kg, 0, 1)
    _link(kg, 0, 2)
    ce_eq("CN(u, u) -> 0", lp_common_neighbors(kg, 0, 0), 0)
    ce_eq("J(u, u)  -> 0", lp_jaccard(kg, 0, 0), 0)
    ce_eq("AA(u, u) -> 0", lp_adamic_adar(kg, 0, 0), 0)
}

fn test_missing_atom_zero() {
    let kg = _mk_kg_n("test_lp_miss", 3)
    _link(kg, 0, 1)
    ce_eq("CN out-of-range -> 0", lp_common_neighbors(kg, 0, 999), 0)
    ce_eq("J  out-of-range -> 0", lp_jaccard(kg, 0, 999), 0)
    ce_eq("AA out-of-range -> 0", lp_adamic_adar(kg, 0, 999), 0)
    ce_eq("CN negative id  -> 0", lp_common_neighbors(kg, 0 - 1, 1), 0)
}

// ---- N shared neighbours ------------------------------------------------

fn test_cn_n_shared() {
    // Triangle plus extension: atoms 0, 1 both link to 2, 3, 4 ->
    // CN(0,1) = 3. (No 0-1 edge directly.)
    let kg = _mk_kg_n("test_lp_cn_n", 5)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 0, 4)
    _link(kg, 1, 2)
    _link(kg, 1, 3)
    _link(kg, 1, 4)
    ce_eq("CN with 3 shared -> 3", lp_common_neighbors(kg, 0, 1), 3)
    // Two shared, one unique on each side: |N(0)|=3, |N(1)|=3,
    // intersect = {2,3}, union = {2,3,4,5} -> J = 2*1000/4 = 500.
    let kg2 = _mk_kg_n("test_lp_cn_partial", 6)
    _link(kg2, 0, 2)
    _link(kg2, 0, 3)
    _link(kg2, 0, 4)
    _link(kg2, 1, 2)
    _link(kg2, 1, 3)
    _link(kg2, 1, 5)
    ce_eq("CN with 2 shared -> 2", lp_common_neighbors(kg2, 0, 1), 2)
    ce_eq("J  with 2/4 overlap -> 500 milli", lp_jaccard(kg2, 0, 1), 500)
}

// ---- Jaccard identical / disjoint ---------------------------------------

fn test_jaccard_identical_full() {
    // u, v share an identical neighbour set {2, 3, 4}.
    let kg = _mk_kg_n("test_lp_j_full", 5)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 0, 4)
    _link(kg, 1, 2)
    _link(kg, 1, 3)
    _link(kg, 1, 4)
    ce_eq("J identical neighbour sets -> 1000 milli",
        lp_jaccard(kg, 0, 1), 1000)
}

fn test_jaccard_disjoint_zero() {
    // u links {2, 3}; v links {4, 5}; intersect = {}, union = {2,3,4,5}.
    // J = 0 / 4 = 0.
    let kg = _mk_kg_n("test_lp_j_dis", 6)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 1, 4)
    _link(kg, 1, 5)
    ce_eq("J disjoint neighbour sets -> 0", lp_jaccard(kg, 0, 1), 0)
    ce_eq("CN disjoint neighbour sets -> 0",
        lp_common_neighbors(kg, 0, 1), 0)
}

fn test_jaccard_partial_predictable() {
    // u links {2}; v links {2, 3, 4, 5}. intersect = {2}, union = {2,3,4,5}.
    // J = 1 * 1000 / 4 = 250 milli.
    let kg = _mk_kg_n("test_lp_j_partial", 6)
    _link(kg, 0, 2)
    _link(kg, 1, 2)
    _link(kg, 1, 3)
    _link(kg, 1, 4)
    _link(kg, 1, 5)
    ce_eq("J 1/4 overlap -> 250 milli", lp_jaccard(kg, 0, 1), 250)
    ce_eq("CN 1/4 overlap -> 1", lp_common_neighbors(kg, 0, 1), 1)
}

fn test_jaccard_half_overlap() {
    // u links {2, 3}; v links {3, 4}; intersect = {3}, union = {2,3,4}.
    // J = 1 * 1000 / 3 = 333 milli.
    let kg = _mk_kg_n("test_lp_j_half", 5)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 1, 3)
    _link(kg, 1, 4)
    ce_eq("J 1/3 overlap -> 333 milli", lp_jaccard(kg, 0, 1), 333)
}

// ---- Adamic-Adar hub down-weighting -------------------------------------

fn test_aa_hub_down_weights() {
    // Two scenarios A vs B:
    //   A: u, v share a SINGLE rare neighbour w with degree 2 (only u
    //      and v are its neighbours). log2(2) = 1, weight = 1000.
    //   B: u, v share a SINGLE popular neighbour w with degree 8
    //      (u, v, plus 6 others). log2(8) = 3, weight = 333.
    // AA(A) > AA(B): a rare shared neighbour is more informative than
    // a hub. Both have CN = 1.
    let kg_a = _mk_kg_n("test_lp_aa_rare", 4)
    _link(kg_a, 0, 2)
    _link(kg_a, 1, 2)
    // deg(2) = 2 in kg_a.
    let aa_rare = lp_adamic_adar(kg_a, 0, 1)
    ce_eq("AA rare-neighbour weight = 1000/log2(2) = 1000 milli",
        aa_rare, 1000)
    ce_eq("CN(rare-neighbour) = 1", lp_common_neighbors(kg_a, 0, 1), 1)

    let kg_b = _mk_kg_n("test_lp_aa_hub", 10)
    // Make atom 2 a hub: link to 0, 1, 3, 4, 5, 6, 7, 8 -> deg(2) = 8.
    _link(kg_b, 0, 2)
    _link(kg_b, 1, 2)
    _link(kg_b, 2, 3)
    _link(kg_b, 2, 4)
    _link(kg_b, 2, 5)
    _link(kg_b, 2, 6)
    _link(kg_b, 2, 7)
    _link(kg_b, 2, 8)
    // CN(0, 1) = 1 (just atom 2 shared).
    let aa_hub = lp_adamic_adar(kg_b, 0, 1)
    ce_eq("CN(hub-neighbour) = 1", lp_common_neighbors(kg_b, 0, 1), 1)
    // log2(8) = 3, weight = 1000 / 3 = 333 milli.
    ce_eq("AA hub-neighbour weight = 1000/log2(8) = 333 milli",
        aa_hub, 333)
    // Critical: AA(rare) > AA(hub), confirming the down-weight.
    ce_check("AA rare > AA hub (hub down-weighted)", aa_rare > aa_hub)
}

fn test_aa_multiple_shared_sum() {
    // u links {2, 3}; v links {2, 3}. Two shared neighbours.
    // deg(2) = 2 -> weight 1000; deg(3) = 2 -> weight 1000.
    // AA = 1000 + 1000 = 2000 milli.
    let kg = _mk_kg_n("test_lp_aa_sum", 4)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 1, 2)
    _link(kg, 1, 3)
    let aa = lp_adamic_adar(kg, 0, 1)
    ce_eq("AA two rare shared neighbours -> 2000 milli", aa, 2000)
    // Jaccard at this point: intersect = {2, 3}, union = {2, 3}, J = 1000.
    ce_eq("J full overlap -> 1000 milli", lp_jaccard(kg, 0, 1), 1000)
    ce_eq("CN full overlap -> 2", lp_common_neighbors(kg, 0, 1), 2)
}

// ---- top_k ranking -------------------------------------------------------

fn test_top_k_zero_empty() {
    let kg = _mk_kg_n("test_lp_top_zero", 4)
    _link(kg, 0, 2)
    _link(kg, 1, 2)
    let out = lp_predict_top_k(kg, 0, 0, LP_JACCARD)
    ce_eq("top_k(0) -> empty", len(out), 0)
    let out2 = lp_predict_top_k(kg, 0, 0 - 1, LP_JACCARD)
    ce_eq("top_k(-1) -> empty", len(out2), 0)
}

fn test_top_k_descending_order() {
    // 6 atoms. atom 0 links to {2, 3}.
    // candidate 1 shares 2 neighbours with 0 (via {2, 3});
    // candidate 4 shares 1 neighbour with 0 (via {2});
    // candidate 5 shares 0 neighbours.
    // So top_k(3, CN) for source=0 -> [(1, 2), (4, 1)] (5 excluded score=0).
    let kg = _mk_kg_n("test_lp_top_desc", 6)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 1, 2)
    _link(kg, 1, 3)
    _link(kg, 4, 2)
    let top = lp_predict_top_k(kg, 0, 3, LP_CN)
    ce_eq("top_k -> 2 hits (score=0 dropped)", len(top), 2)
    ce_eq("top_k[0].id = 1 (highest CN=2)", top[0][0], 1)
    ce_eq("top_k[0].score = 2", top[0][1], 2)
    ce_eq("top_k[1].id = 4 (next CN=1)", top[1][0], 4)
    ce_eq("top_k[1].score = 1", top[1][1], 1)
}

fn test_top_k_filters_existing_edges() {
    // atom 0 ALREADY linked to atom 1. CN(0, 1) would be 0 because
    // their neighbour sets are {1}, {0} (each only knows the other),
    // but the filter is the more important behaviour: 0--1 must not
    // appear in top_k. Add atom 2 as a candidate (CN(0,2) > 0 via
    // shared neighbour 3) to make sure the filter doesn't drop
    // everything.
    let kg = _mk_kg_n("test_lp_top_filt", 4)
    _link(kg, 0, 1)
    _link(kg, 0, 3)
    _link(kg, 2, 3)
    // candidate 2: shares neighbour 3 -> CN(0,2) = 1.
    let top = lp_predict_top_k(kg, 0, 5, LP_CN)
    // atom 1 is already linked to 0 -> excluded.
    // atom 3 is already linked to 0 -> excluded.
    // atom 2 is the only candidate with score > 0 -> appears.
    ce_eq("top_k filters out already-linked atoms", len(top), 1)
    ce_eq("top_k[0].id = 2", top[0][0], 2)
}

fn test_top_k_tie_break_ascending_id() {
    // 5 atoms. 0 links to {3}. 1 and 2 both link to {3} (same overlap).
    // CN(0, 1) = 1, CN(0, 2) = 1 -- tie. Tie-break by ascending id
    // -> atom 1 first, atom 2 second.
    let kg = _mk_kg_n("test_lp_tiebreak", 4)
    _link(kg, 0, 3)
    _link(kg, 1, 3)
    _link(kg, 2, 3)
    let top = lp_predict_top_k(kg, 0, 5, LP_CN)
    ce_eq("top_k tie -> 2 hits", len(top), 2)
    ce_eq("top_k tie -> id 1 first (ASCENDING tiebreak)",
        top[0][0], 1)
    ce_eq("top_k tie -> id 2 second", top[1][0], 2)
    ce_eq("top_k tie -> same score", top[0][1], top[1][1])
}

fn test_top_k_larger_than_n() {
    // Request 100 candidates from a graph with only a couple of
    // scoring candidates. top_k clamps to the actual number found.
    let kg = _mk_kg_n("test_lp_top_big_k", 4)
    _link(kg, 0, 2)
    _link(kg, 1, 2)
    let top = lp_predict_top_k(kg, 0, 100, LP_CN)
    ce_check("top_k(100) returns <= num candidates", len(top) <= 4)
    ce_check("top_k(100) returns at least 1", len(top) >= 1)
}

fn test_top_k_invalid_source_empty() {
    let kg = _mk_kg_n("test_lp_top_bad_src", 3)
    _link(kg, 0, 1)
    let out = lp_predict_top_k(kg, 999, 5, LP_JACCARD)
    ce_eq("top_k(missing source) -> empty", len(out), 0)
    let out2 = lp_predict_top_k(kg, 0 - 1, 5, LP_JACCARD)
    ce_eq("top_k(negative source) -> empty", len(out2), 0)
}

// ---- barbell-with-missing-edge fixture ----------------------------------
//
// 6 atoms in two triangles joined by a bridge: {0, 1, 2} triangle on
// the left, {3, 4, 5} triangle on the right; one bridge edge 2--3.
// Atoms 1 and 4 are the triangle "non-bridge" vertices on each side.
//
// CN(1, 4) = |{2, 3} - already? 1 -> {0, 2}, 4 -> {3, 5}. Intersect
// is empty -> 0; they don't predict an edge.
//
// But: the bridge endpoints' neighbourhoods do overlap meaningfully
// via the bridge structure. CN(2, 3) is already linked so omit.
//
// The clearest "missing edge predicted by neighbours" is CN(0, 2),
// CN(1, 0), etc. -- triangle-completing edges that already exist.
// To get a TRUE missing-edge prediction, drop one triangle edge:
// {0, 1, 2} but no 0--2 edge, just 0--1 and 1--2. Then atom 1 is
// the shared neighbour for the missing pair (0, 2). CN(0, 2) = 1.
fn test_barbell_bridge_predicts_missing() {
    // Triangle with missing 0--2 edge: 0--1, 1--2, plus extension 2--3.
    let kg = _mk_kg_n("test_lp_bridge_missing", 4)
    _link(kg, 0, 1)
    _link(kg, 1, 2)
    _link(kg, 2, 3)
    // 0 links to {1}; 2 links to {1, 3}.
    // CN(0, 2) = |{1}| = 1 -> the triangle "missing edge" is
    // predicted via the shared neighbour 1.
    ce_eq("triangle-missing CN(0, 2) = 1 via shared 1",
        lp_common_neighbors(kg, 0, 2), 1)
    // Jaccard: intersect = {1}, union = {1, 3} -> 1*1000/2 = 500.
    ce_eq("triangle-missing J(0, 2) = 500 milli",
        lp_jaccard(kg, 0, 2), 500)
    // Adamic-Adar: shared neighbour 1 has deg 2; weight = 1000 / log2(2)
    // = 1000.
    ce_eq("triangle-missing AA(0, 2) = 1000 milli",
        lp_adamic_adar(kg, 0, 2), 1000)
}

// ---- disjoint subgraphs: random pair scores 0 ---------------------------

fn test_disjoint_subgraphs_zero() {
    // Two disjoint triangles {0, 1, 2} and {3, 4, 5}. Pick u=0 (left)
    // and v=3 (right). No shared neighbour.
    let kg = _mk_kg_n("test_lp_disjoint", 6)
    _link(kg, 0, 1)
    _link(kg, 0, 2)
    _link(kg, 1, 2)
    _link(kg, 3, 4)
    _link(kg, 3, 5)
    _link(kg, 4, 5)
    ce_eq("disjoint CN -> 0", lp_common_neighbors(kg, 0, 3), 0)
    ce_eq("disjoint J  -> 0", lp_jaccard(kg, 0, 3), 0)
    ce_eq("disjoint AA -> 0", lp_adamic_adar(kg, 0, 3), 0)
    // top_k should also reject all candidates in the other subgraph.
    let top = lp_predict_top_k(kg, 0, 5, LP_CN)
    // None of the right-triangle members share neighbours with 0.
    let i = 0
    let cross = 0
    while i < len(top) {
        let target_id = top[i][0]
        if target_id >= 3 { cross = cross + 1 }
        i = i + 1
    }
    ce_eq("top_k from disjoint left has 0 right-triangle hits",
        cross, 0)
}

// ---- method-name parsing -----------------------------------------------

fn test_method_parse_names() {
    ce_eq("parse 'cn' -> LP_CN",            lp_method_parse("cn"),       LP_CN)
    ce_eq("parse 'common' -> LP_CN",        lp_method_parse("common"),   LP_CN)
    ce_eq("parse 'jaccard' -> LP_JACCARD",  lp_method_parse("jaccard"),  LP_JACCARD)
    ce_eq("parse 'j' -> LP_JACCARD",        lp_method_parse("j"),        LP_JACCARD)
    ce_eq("parse 'aa' -> LP_AA",            lp_method_parse("aa"),       LP_AA)
    ce_eq("parse 'adamic' -> LP_AA",        lp_method_parse("adamic"),   LP_AA)
    ce_eq("parse 'adamic_adar' -> LP_AA",   lp_method_parse("adamic_adar"), LP_AA)
    ce_eq("parse 'unknown' -> 0 (invalid)", lp_method_parse("foo"),      0)
    ce_str_eq("name CN -> 'cn'",         lp_method_name(LP_CN),       "cn")
    ce_str_eq("name JACCARD -> 'jaccard'", lp_method_name(LP_JACCARD), "jaccard")
    ce_str_eq("name AA -> 'aa'",         lp_method_name(LP_AA),       "aa")
}

// ---- integer log2 helper ------------------------------------------------

fn test_int_log2_helper() {
    ce_eq("_lp_int_log2(1) = 0", _lp_int_log2(1), 0)
    ce_eq("_lp_int_log2(2) = 1", _lp_int_log2(2), 1)
    ce_eq("_lp_int_log2(3) = 1 (floor)", _lp_int_log2(3), 1)
    ce_eq("_lp_int_log2(4) = 2", _lp_int_log2(4), 2)
    ce_eq("_lp_int_log2(8) = 3", _lp_int_log2(8), 3)
    ce_eq("_lp_int_log2(16) = 4", _lp_int_log2(16), 4)
    ce_eq("_lp_int_log2(100) = 6", _lp_int_log2(100), 6)
    ce_eq("_lp_log2_clamped(1) = 1 (clamped up)",
        _lp_log2_clamped(1), 1)
    ce_eq("_lp_log2_clamped(8) = 3", _lp_log2_clamped(8), 3)
}

// ---- determinism --------------------------------------------------------

fn test_determinism_repeated_runs() {
    // Same KG -> same scores across repeated calls. No randomness
    // anywhere; this is mostly a regression guard against future
    // "let's sprinkle in a hash" tempting refactors.
    let kg = _mk_kg_n("test_lp_det", 5)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 1, 2)
    _link(kg, 1, 4)
    let a1 = lp_jaccard(kg, 0, 1)
    let a2 = lp_jaccard(kg, 0, 1)
    let a3 = lp_jaccard(kg, 0, 1)
    ce_eq("J deterministic 1==2", a1, a2)
    ce_eq("J deterministic 2==3", a2, a3)
    let b1 = lp_adamic_adar(kg, 0, 1)
    let b2 = lp_adamic_adar(kg, 0, 1)
    ce_eq("AA deterministic", b1, b2)
    let top1 = lp_predict_top_k(kg, 0, 5, LP_JACCARD)
    let top2 = lp_predict_top_k(kg, 0, 5, LP_JACCARD)
    ce_eq("top_k deterministic len", len(top1), len(top2))
    if len(top1) > 0 {
        ce_eq("top_k deterministic [0].id", top1[0][0], top2[0][0])
        ce_eq("top_k deterministic [0].score", top1[0][1], top2[0][1])
    }
}

fn main() {
    test_disconnected_zero()
    test_self_pair_zero()
    test_missing_atom_zero()
    test_cn_n_shared()
    test_jaccard_identical_full()
    test_jaccard_disjoint_zero()
    test_jaccard_partial_predictable()
    test_jaccard_half_overlap()
    test_aa_hub_down_weights()
    test_aa_multiple_shared_sum()
    test_top_k_zero_empty()
    test_top_k_descending_order()
    test_top_k_filters_existing_edges()
    test_top_k_tie_break_ascending_id()
    test_top_k_larger_than_n()
    test_top_k_invalid_source_empty()
    test_barbell_bridge_predicts_missing()
    test_disjoint_subgraphs_zero()
    test_method_parse_names()
    test_int_log2_helper()
    test_determinism_repeated_runs()
    ce_summary("link_prediction")
}

main()
