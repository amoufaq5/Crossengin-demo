// Unit tests for src/learning/source_whitelist.nova
// Verifies host extraction, add/dedup, allow/deny checks (case-insensitive),
// and the default whitelist. ADR-0028.

import "../ce_test.nova"
import "../../src/learning/source_whitelist.nova"

fn test_host_extraction() {
    ce_str_eq("https host", sw_host("https://en.wikipedia.org/wiki/Aspirin"), "en.wikipedia.org")
    ce_str_eq("http host", sw_host("http://example.com/page"), "example.com")
    ce_str_eq("no scheme", sw_host("example.org/x"), "example.org")
    ce_str_eq("host only", sw_host("docs.python.org"), "docs.python.org")
    ce_str_eq("case normalized", sw_host("HTTPS://EN.WIKIPEDIA.ORG/X"), "en.wikipedia.org")
}

fn test_add_and_check() {
    let wl = sw_new()
    ce_eq("empty", sw_count(wl), 0)
    sw_add(wl, "en.wikipedia.org")
    sw_add(wl, "EN.Wikipedia.ORG")   // dedup case-insensitive
    ce_eq("one domain", sw_count(wl), 1)
    ce_eq("allowed host", sw_check(wl, "https://en.wikipedia.org/wiki/X"), 1)
    ce_eq("denied host", sw_check(wl, "https://evil.example.com/x"), 0)
    ce_eq("has domain", sw_has_domain(wl, "en.wikipedia.org"), 1)
    ce_eq("missing domain", sw_has_domain(wl, "other.com"), 0)
}

fn test_default() {
    let wl = sw_default()
    ce_check("default non-empty", sw_count(wl) >= 5)
    ce_eq("wikipedia allowed", sw_check(wl, "https://en.wikipedia.org/wiki/Foo"), 1)
    ce_eq("random denied", sw_check(wl, "https://spam.biz/x"), 0)
}

fn main() {
    test_host_extraction()
    test_add_and_check()
    test_default()
    ce_summary("source_whitelist")
}

main()
