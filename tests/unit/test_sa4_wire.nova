// Unit tests for src/learning/sa4_wire.nova (SecAgg v4 wire format and
// signed transcripts, A2.2a; v4-sa2, A2.4b; protocol v4-sa3, A2.4c). No
// signatures are computed here. Transcript digests, bitmap and
// share-plaintext bytes were computed independently in Python (hashlib;
// the v4-sa2 values by /tmp/claude-0/a24b/nova_pins.py, the v4-sa3 ones
// (SIG domain v3, K3..K8) by /tmp/claude-0/a24c/proto_final.py --pins and
// by hand with hashlib). The commitment tree itself is tested in
// test_sa4_commit.nova. The harness is imported for the test-only
// garbage(ct) of SPEC A2.4c (K8).
// CE_TEST_TIMEOUT: 240

import "../ce_test.nova"
import "../../src/learning/sa4_wire.nova"
import "../sa4_harness.nova"

fn _w_fill(n, v) {
    let out = list_new()
    let i = 0
    while i < n {
        push(out, v)
        i = i + 1
    }
    return out
}

fn _w_iota(n) {
    let out = list_new()
    let i = 0
    while i < n {
        push(out, i)
        i = i + 1
    }
    return out
}

fn _w_rep(s, n) {
    let out = ""
    let i = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn test_decimals() {
    ce_eq("u32 0", sa4w_dec_u32("0"), 0)
    ce_eq("u32 max", sa4w_dec_u32("4294967295"), 4294967295)
    ce_eq("u32 2^32", sa4w_dec_u32("4294967296"), 0 - 1)
    ce_eq("u32 leading zero", sa4w_dec_u32("07"), 0 - 1)
    ce_eq("u32 sign", sa4w_dec_u32("-1"), 0 - 1)
    ce_eq("u32 11 digits", sa4w_dec_u32("10000000000"), 0 - 1)
    ce_eq("u32 empty", sa4w_dec_u32(""), 0 - 1)
    ce_eq("u32 x", sa4w_dec_u32("1x"), 0 - 1)
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    ce_eq("round 2^62-1", sa4w_dec_round("4611686018427387903"), maxr)
    ce_eq("round 2^62", sa4w_dec_round("4611686018427387904"), 0 - 1)
    ce_eq("round 19 nines", sa4w_dec_round("9999999999999999999"), 0 - 1)
    ce_eq("round 20 digits", sa4w_dec_round("10000000000000000000"), 0 - 1)
    ce_eq("round 18 digits", sa4w_dec_round("999999999999999999"), 999999999999999999)
    ce_eq("round 1 (19-digit lower)", sa4w_dec_round("1000000000000000000"), 1000000000000000000)
}

fn test_roundtrip() {
    let fp = _w_iota(32)
    let lay = _w_fill(32, 171)
    let l1 = sa4w_fmt_round(7, fp, 150, lay)
    ce_str_eq("round line", l1, "SA4_ROUND 7 000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f 150 abababababababababababababababababababababababababababababababab")
    let r1 = sa4w_parse(l1)
    ce_eq("round ev", r1[0], SA4W_EV_ROUND)
    ce_eq("round r", r1[1], 7)
    ce_eq("round L", r1[3], 150)
    ce_eq("round fp[31]", r1[2][31], 31)
    let cpk = _w_fill(32, 1)
    let spk = _w_fill(32, 2)
    let sig = _w_fill(64, 255)
    let bcm = _w_fill(32, 3)
    let mrt = _w_fill(32, 4)
    let l2 = sa4w_fmt_adv(7, 4294967295, cpk, spk, sig, bcm, mrt)
    ce_str_eq("adv v2 line", l2, "SA4_ADV 7 4294967295 " + _w_rep("01", 32) + " " + _w_rep("02", 32) + " " + _w_rep("03", 32) + " " + _w_rep("04", 32) + " " + _w_rep("ff", 64))
    let r2 = sa4w_parse(l2)
    ce_eq("adv ev", r2[0], SA4W_EV_ADV)
    ce_eq("adv id", r2[2], 4294967295)
    ce_eq("adv sig[63]", r2[5][63], 255)
    ce_eq("adv record has 8 fields", len(r2), 8)
    ce_eq("adv B[0]", r2[6][0], 3)
    ce_eq("adv M[31]", r2[7][31], 4)
    let r3 = sa4w_parse(sa4w_fmt_set(7, 3, sa4w_bitmap([1, 9, 255])))
    ce_eq("set k", r3[2], 3)
    ce_str_eq("bitmap bytes (Python)", sa4w_hex(r3[3]), "0101000000000000000000000000000000000000000000000000000000000040")
    let ct = _w_fill(98 + 64, 9)
    let epk = _w_fill(32, 12)
    let l4 = sa4w_fmt_share(7, 300, 65536, ct, epk)
    ce_str_eq("share v3 line (epk before ct)", l4, "SA4_SHARE 7 300 65536 " + _w_rep("0c", 32) + " " + _w_rep("09", 162))
    let r4 = sa4w_parse(l4)
    ce_eq("share to", r4[3], 65536)
    ce_eq("share ct len (D = 2)", len(r4[4]), 162)
    ce_eq("share record has 6 fields", len(r4), 6)
    ce_eq("share epk[0]", r4[5][0], 12)
    let r5 = sa4w_parse(sa4w_fmt_sig3(8, 70000, sig))
    ce_eq("sig3 id", r5[2], 70000)
    let prf = _w_fill(96, 6)
    let l6 = sa4w_fmt_reveal(8, 7, 300, 1, _w_fill(32, 5), prf)
    ce_str_eq("reveal v2 line", l6, "SA4_REVEAL 8 7 300 s " + _w_rep("05", 32) + " " + _w_rep("06", 96))
    let r6 = sa4w_parse(l6)
    ce_eq("reveal kind s", r6[4], 1)
    ce_eq("reveal record has 7 fields", len(r6), 7)
    ce_eq("reveal proof length", len(r6[6]), 96)
    ce_eq("reveal share[0]", r6[5][0], 5)
    let r6b = sa4w_parse(sa4w_fmt_reveal(8, 7, 300, 0, _w_fill(32, 5), prf))
    ce_eq("reveal kind b", r6b[4], 0)
    let r7 = sa4w_parse(sa4w_fmt_end(8, 2, 7, 3))
    ce_eq("end phase", r7[2], 2)
    ce_eq("end count", r7[4], 3)
    let r8 = sa4w_parse(sa4w_fmt_abort(8, 7, "bad_sig3"))
    ce_str_eq("abort code", r8[3], "bad_sig3")
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    let r9 = sa4w_parse(sa4w_fmt_end(maxr, 1, 4294967295, 254))
    ce_eq("max round round-trips", r9[1], maxr)
    ce_check("max-size ADV line under 1000", len(sa4w_fmt_adv(maxr, 4294967295, cpk, spk, sig, bcm, mrt)) <= 1000)
    ce_check("max-size SHARE line (D = 8) under 1000", len(sa4w_fmt_share(maxr, 4294967295, 4294967294, _w_fill(98 + 256, 1), _w_fill(32, 9))) <= 1000)
    ce_check("max-size REVEAL line (D = 8) under 1000", len(sa4w_fmt_reveal(maxr, 4294967295, 4294967294, 1, _w_fill(32, 1), _w_fill(288, 1))) <= 1000)
}

fn test_y_chunks() {
    let words = list_new()
    let i = 0
    while i < 250 {
        push(words, int_and(int_add(int_mul(i, 2654435761), 4000000000), 4294967295))
        i = i + 1
    }
    list_set(words, 0, 0)
    list_set(words, 1, 4294967295)
    let lines = sa4w_fmt_y_lines(9, 65536, words)
    ce_eq("250 words -> 3 chunks", len(lines), 3)
    let maxlen = 0
    let recs = list_new()
    i = 0
    while i < len(lines) {
        if len(lines[i]) > maxlen { maxlen = len(lines[i]) }
        push(recs, sa4w_parse(lines[i]))
        i = i + 1
    }
    ce_check("Y lines under 1000 bytes", maxlen <= 1000)
    ce_eq("chunk 2 has 50 words", len(recs[2][5]), 50)
    let back = sa4w_y_assemble(recs, 250)
    ce_eq("assembled length", len(back), 250)
    let same = 1
    i = 0
    while i < 250 {
        if back[i] != words[i] { same = 0 }
        i = i + 1
    }
    ce_eq("words round-trip", same, 1)
    let rev = list_new()
    push(rev, recs[2])
    push(rev, recs[0])
    push(rev, recs[1])
    ce_eq("out-of-order chunks assemble", len(sa4w_y_assemble(rev, 250)), 250)
    let dup = list_new()
    push(dup, recs[0])
    push(dup, recs[0])
    push(dup, recs[2])
    ce_eq("duplicate chunk refused", sa4w_y_assemble(dup, 250), 0)
    let miss = list_new()
    push(miss, recs[0])
    push(miss, recs[1])
    ce_eq("missing chunk refused", sa4w_y_assemble(miss, 250), 0)
    ce_eq("wrong L refused", sa4w_y_assemble(recs, 251), 0)
    // A chunk that claims a different total n is refused (it would
    // otherwise index past the slot list).
    let odd = list_new()
    push(odd, recs[0])
    push(odd, recs[1])
    push(odd, sa4w_parse("SA4_Y 9 65536 3 4 " + _w_rep("00000001", 50)))
    ce_eq("chunk with a different n refused", sa4w_y_assemble(odd, 250), 0)
    ce_eq("exact 100 words -> 1 chunk", len(sa4w_fmt_y_lines(1, 1, _w_fill(100, 7))), 1)
    ce_eq("1 word -> 1 chunk", len(sa4w_fmt_y_lines(1, 1, _w_fill(1, 7))), 1)
}

fn test_parse_refusals() {
    let fp = sa4w_hex(_w_iota(32))
    let lay = _w_rep("ab", 32)
    ce_check("valid round parses", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay) != 0)
    ce_eq("double space", sa4w_parse("SA4_ROUND 7  " + fp + " 150 " + lay), 0)
    ce_eq("trailing space", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay + " "), 0)
    ce_eq("leading space", sa4w_parse(" SA4_ROUND 7 " + fp + " 150 " + lay), 0)
    ce_eq("uppercase hex", sa4w_parse("SA4_ROUND 7 000102030405060708090A0B0C0D0E0F101112131415161718191a1b1c1d1e1f 150 " + lay), 0)
    ce_eq("short fp", sa4w_parse("SA4_ROUND 7 0001 150 " + lay), 0)
    ce_eq("L = 0", sa4w_parse("SA4_ROUND 7 " + fp + " 0 " + lay), 0)
    ce_eq("L > 2^24", sa4w_parse("SA4_ROUND 7 " + fp + " 16777217 " + lay), 0)
    ce_eq("round leading zero", sa4w_parse("SA4_ROUND 07 " + fp + " 150 " + lay), 0)
    ce_eq("round 2^62", sa4w_parse("SA4_ROUND 4611686018427387904 " + fp + " 150 " + lay), 0)
    ce_eq("extra field", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay + " x"), 0)
    ce_eq("tab", sa4w_parse("SA4_ROUND" + chr(9) + "7 " + fp + " 150 " + lay), 0)
    ce_eq("CR", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay + chr(13)), 0)
    ce_eq("unknown tag", sa4w_parse("SA4_NOPE 7 1"), 0)
    ce_eq("lowercase tag", sa4w_parse("sa4_end 7 1 1 1"), 0)
    ce_eq("set k=0", sa4w_parse("SA4_SET 7 0 " + fp), 0)
    ce_check("set k=5 (U2', v4-sa3)", sa4w_parse("SA4_SET 7 5 " + fp) != 0)
    ce_eq("set k=6", sa4w_parse("SA4_SET 7 6 " + fp), 0)
    ce_check("end phase 4 (complaints)", sa4w_parse("SA4_END 7 4 1 1") != 0)
    ce_check("end phase 5 (openings)", sa4w_parse("SA4_END 7 5 1 1") != 0)
    ce_eq("end phase 6", sa4w_parse("SA4_END 7 6 1 1"), 0)
    ce_eq("reveal kind x", sa4w_parse("SA4_REVEAL 7 1 2 x " + fp + " " + fp + fp), 0)
    ce_eq("abort uppercase code", sa4w_parse("SA4_ABORT 7 1 Bad"), 0)
    ce_eq("abort code 33 chars", sa4w_parse("SA4_ABORT 7 1 " + _w_rep("a", 33)), 0)
    ce_eq("y index >= n", sa4w_parse("SA4_Y 7 1 2 2 00000001"), 0)
    ce_eq("y n = 0", sa4w_parse("SA4_Y 7 1 0 0 00000001"), 0)
    ce_eq("y odd hex", sa4w_parse("SA4_Y 7 1 0 1 0000001"), 0)
    ce_eq("y 101 words", sa4w_parse("SA4_Y 7 1 0 1 " + _w_rep("00000001", 101)), 0)
    ce_eq("share short ct", sa4w_parse("SA4_SHARE 7 1 2 " + _w_rep("0c", 32) + " " + _w_rep("00", 97)), 0)
    let long = "SA4_ABORT 7 1 " + _w_rep("a", 32)
    while len(long) <= 1000 { long = long + "a" }
    ce_eq("line > 1000 bytes", sa4w_parse(long), 0)
    ce_eq("empty line", sa4w_parse(""), 0)
    // The 1000-byte rule itself (no valid line is that long, so test the
    // tokenizer directly).
    let t1000 = "aa"
    while len(t1000) < 1000 { t1000 = t1000 + " a" }
    ce_eq("1000-byte line tokenizes", len(t1000), 1000)
    ce_check("1000 bytes accepted", _sa4w_tokens(t1000) != 0)
    ce_eq("1001 bytes refused", _sa4w_tokens(t1000 + "a"), 0)
}

// v4-sa2 lengths: SHARE ct 98 + 32k bytes (k = 1..8), REVEAL proof 64k
// hex (k = 2..9), ADV exactly 8 tokens; v4-sa3: SHARE has 6 tokens.
fn test_v2_bounds() {
    let ep = _w_rep("0c", 32) + " "
    let k = 0
    while k <= 9 {
        let ok = 0
        if k >= 1 { if k <= 8 { ok = 1 } }
        let rs = sa4w_parse("SA4_SHARE 7 1 2 " + ep + _w_rep("00", 98 + 32 * k))
        ce_eq("share ct with k = " + int_to_str(k) + " path nodes", rs != 0, ok == 1)
        k = k + 1
    }
    ce_eq("share v1 ct (98 bytes) refused", sa4w_parse("SA4_SHARE 7 1 2 " + ep + _w_rep("00", 98)), 0)
    ce_eq("share ct 98+16 refused", sa4w_parse("SA4_SHARE 7 1 2 " + ep + _w_rep("00", 114)), 0)
    ce_eq("share ct odd hex refused", sa4w_parse("SA4_SHARE 7 1 2 " + ep + _w_rep("00", 130) + "0"), 0)
    ce_eq("share ct uppercase refused", sa4w_parse("SA4_SHARE 7 1 2 " + ep + _w_rep("AA", 130)), 0)
    ce_eq("v4-sa2 SHARE (5 tokens, no e_pk) refused", sa4w_parse("SA4_SHARE 7 1 2 " + _w_rep("00", 162)), 0)
    let sh = _w_rep("05", 32)
    k = 1
    while k <= 10 {
        let ok2 = 0
        if k >= 2 { if k <= 9 { ok2 = 1 } }
        let rr = sa4w_parse("SA4_REVEAL 7 1 2 b " + sh + " " + _w_rep("ab", 32 * k))
        ce_eq("reveal proof of " + int_to_str(k) + " x 32 bytes", rr != 0, ok2 == 1)
        k = k + 1
    }
    ce_eq("reveal proof not a multiple of 32 bytes", sa4w_parse("SA4_REVEAL 7 1 2 b " + sh + " " + _w_rep("ab", 80)), 0)
    ce_eq("reveal v1 (6 tokens) refused", sa4w_parse("SA4_REVEAL 7 1 2 b " + sh), 0)
    ce_eq("reveal 8 tokens refused", sa4w_parse("SA4_REVEAL 7 1 2 b " + sh + " " + _w_rep("ab", 64) + " " + _w_rep("ab", 64)), 0)
    ce_eq("reveal uppercase proof refused", sa4w_parse("SA4_REVEAL 7 1 2 b " + sh + " " + _w_rep("AB", 64)), 0)
    let h32 = _w_rep("01", 32)
    let s64 = _w_rep("ff", 64)
    ce_check("adv 8 tokens parses", sa4w_parse("SA4_ADV 7 1 " + h32 + " " + h32 + " " + h32 + " " + h32 + " " + s64) != 0)
    ce_eq("adv v1 (6 tokens) refused", sa4w_parse("SA4_ADV 7 1 " + h32 + " " + h32 + " " + s64), 0)
    ce_eq("adv 7 tokens refused", sa4w_parse("SA4_ADV 7 1 " + h32 + " " + h32 + " " + h32 + " " + s64), 0)
    ce_eq("adv short M refused", sa4w_parse("SA4_ADV 7 1 " + h32 + " " + h32 + " " + h32 + " " + _w_rep("01", 31) + " " + s64), 0)
    ce_eq("adv sig in the M slot refused", sa4w_parse("SA4_ADV 7 1 " + h32 + " " + h32 + " " + h32 + " " + s64 + " " + h32), 0)
    return 0
}

fn test_bitmaps() {
    let bm = sa4w_bitmap([1, 3, 8, 9])
    let xs = sa4w_bitmap_xs(bm, 9)
    ce_eq("xs count", len(xs), 4)
    ce_eq("xs[3]", xs[3], 9)
    ce_eq("bit above N refused", sa4w_bitmap_xs(bm, 8), 0)
    ce_eq("empty bitmap", len(sa4w_bitmap_xs(sa4w_bitmap(list_new()), 5)), 0)
    let full = list_new()
    let i = 1
    while i <= 255 {
        push(full, i)
        i = i + 1
    }
    ce_eq("N=255 all set", len(sa4w_bitmap_xs(sa4w_bitmap(full), 255)), 255)
    ce_eq("short bitmap refused", sa4w_bitmap_xs(_w_fill(31, 0), 5), 0)
}

fn test_transcripts() {
    let fp = _w_iota(32)
    let adv = sa4w_adv_transcript(fp, 7, 300, 150, _w_fill(32, 171), _w_fill(32, 1), _w_fill(32, 2), _w_fill(32, 3), _w_fill(32, 4))
    ce_eq("ADV length", len(adv), 235)
    ce_str_eq("ADV digest, v3 SIG domain (Python)", sa4w_hex(sa4w_sha256(adv)), "a45c61bcdc274f45e0da251eb007d3884770cfb4c47f95de73eba0771c30b2d7")
    let keys = list_new()
    let k = 0
    while k < 3 {
        let kp = list_new()
        push(kp, _w_fill(32, 2 * k + 1))
        push(kp, _w_fill(32, 2 * k + 2))
        push(kp, _w_fill(32, 16 + k))
        push(kp, _w_fill(32, 32 + k))
        push(keys, kp)
        k = k + 1
    }
    let h1 = sa4w_advset_hash(sa4w_bitmap([1, 2, 3]), keys)
    ce_str_eq("H1 v2 (Python)", sa4w_hex(h1), "e5b55243d36a5a97d6a10910d2818c5cfc720b466d30f643c8df0eccfc672909")
    // B and M are inside H1: changing one byte of either changes it.
    let m1 = keys[1][3]
    list_set(m1, 0, int_xor(m1[0], 1))
    ce_check("H1 covers M", str_eq_bytes(sa4w_hex(sa4w_advset_hash(sa4w_bitmap([1, 2, 3]), keys)), sa4w_hex(h1)) == 0)
    list_set(m1, 0, int_xor(m1[0], 1))
    let b2 = keys[2][2]
    list_set(b2, 31, int_xor(b2[31], 128))
    ce_check("H1 covers B", str_eq_bytes(sa4w_hex(sa4w_advset_hash(sa4w_bitmap([1, 2, 3]), keys)), sa4w_hex(h1)) == 0)
    list_set(b2, 31, int_xor(b2[31], 128))
    let t3 = sa4w_t3_transcript(fp, 7, h1, sa4w_bitmap([1, 2, 3]), sa4w_bitmap([1, 3]))
    ce_eq("T3 length", len(t3), 162)
    ce_str_eq("T3 digest, v3 SIG domain (Python)", sa4w_hex(sa4w_sha256(t3)), "d16e41787d83052674f3ca8b389039d039ab52f1fc067b29bc70409790c38417")
    ce_str_eq("B_u (Python)", sa4w_hex(sa4w_bcommit(fp, 7, 300, _w_fill(32, 34))), "5a8a0c94c71e1bf443473e5b017bb427a2cacb0bcc5cabecae8103b6f6a0f0f7")
    ce_str_eq("hb (Python)", sa4w_hex(sa4w_hb(fp, 7, 300, 3, _w_fill(32, 34))), "2f723366c37d1556f902f27a8ebd9c1a865f869d30ddfbad00509a16cb0a53c3")
    ce_str_eq("hs (Python)", sa4w_hex(sa4w_hs(fp, 7, 300, 3, _w_fill(32, 17))), "a3fe64c55c2142482a720fe501ecfd1725a2f6f622f9e178249be2706ed07378")
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    let path = list_new()
    push(path, _w_fill(32, 68))
    push(path, _w_fill(32, 85))
    let pt = sa4w_share_pt(7, 4294967295, maxr, 3, _w_fill(32, 17), _w_fill(32, 34), path)
    ce_eq("share plaintext v2 length (D = 2)", len(pt), 146)
    ce_eq("share plaintext length helper", sa4w_share_pt_len(2), 146)
    ce_eq("share wire length helper", sa4w_share_wire_len(2), 162)
    ce_str_eq("share plaintext v2 (Python)", sa4w_hex(pt), "0200000007ffffffff3fffffffffffffff031111111111111111111111111111111111111111111111111111111111111111222222222222222222222222222222222222222222222222222222222222222244444444444444444444444444444444444444444444444444444444444444445555555555555555555555555555555555555555555555555555555555555555")
    let p = sa4w_share_pt_parse(pt, 2)
    ce_eq("pt from", p[0], 7)
    ce_eq("pt to", p[1], 4294967295)
    ce_eq("pt round", p[2], maxr)
    ce_eq("pt x", p[3], 3)
    ce_eq("pt b[0]", p[5][0], 34)
    ce_eq("pt path length", len(p[6]), 2)
    ce_eq("pt path[1][31]", p[6][1][31], 85)
    ce_eq("pt parsed with another depth refused", sa4w_share_pt_parse(pt, 3), 0)
    ce_eq("pt parsed with depth 1 refused", sa4w_share_pt_parse(pt, 1), 0)
    let bad = sa4w_share_pt(7, 8, 1, 3, _w_fill(32, 0), _w_fill(32, 0), path)
    list_set(bad, 0, 1)
    ce_eq("pt version 1 refused", sa4w_share_pt_parse(bad, 2), 0)
    list_set(bad, 0, 3)
    ce_eq("pt version 3 refused", sa4w_share_pt_parse(bad, 2), 0)
    ce_eq("pt v1 length (82) refused", sa4w_share_pt_parse(_w_fill(82, 1), 2), 0)
    ce_eq("pt depth 0 refused", sa4w_share_pt_parse(_w_fill(82, 2), 0), 0)
}

// ---- v4-sa3 (A2.4c) ----------------------------------------------------------

fn test_v3_lines() {
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    let sig = _w_fill(64, 238)
    let l1 = sa4w_fmt_shsig(7, 300, sig)
    ce_str_eq("SHSIG line", l1, "SA4_SHSIG 7 300 " + _w_rep("ee", 64))
    let r1 = sa4w_parse(l1)
    ce_eq("SHSIG ev", r1[0], SA4W_EV_SHSIG)
    ce_eq("SHSIG record", len(r1), 4)
    ce_eq("SHSIG from", r1[2], 300)
    ce_eq("SHSIG sig[63]", r1[3][63], 238)
    let lh = _w_fill(32, 11)
    let l2 = sa4w_fmt_complaint(7, 65536, 300, lh, sig)
    ce_str_eq("COMPLAINT line", l2, "SA4_COMPLAINT 7 65536 300 " + _w_rep("0b", 32) + " " + _w_rep("ee", 64))
    let r2 = sa4w_parse(l2)
    ce_eq("COMPLAINT ev", r2[0], SA4W_EV_COMPLAINT)
    ce_eq("COMPLAINT record", len(r2), 6)
    ce_eq("COMPLAINT from", r2[2], 65536)
    ce_eq("COMPLAINT about", r2[3], 300)
    ce_eq("COMPLAINT lh[0]", r2[4][0], 11)
    ce_eq("COMPLAINT sig[0]", r2[5][0], 238)
    let l3 = sa4w_fmt_accuse(7, sa4w_bitmap([2, 5]))
    ce_str_eq("ACCUSE line", l3, "SA4_ACCUSE 7 12" + _w_rep("00", 31))
    let r3 = sa4w_parse(l3)
    ce_eq("ACCUSE ev", r3[0], SA4W_EV_ACCUSE)
    ce_eq("ACCUSE record", len(r3), 3)
    ce_eq("ACCUSE bitmap", r3[2][0], 18)
    let l4 = sa4w_fmt_open(7, 300, 65536, _w_fill(32, 14))
    ce_str_eq("OPEN line", l4, "SA4_OPEN 7 300 65536 " + _w_rep("0e", 32))
    let r4 = sa4w_parse(l4)
    ce_eq("OPEN ev", r4[0], SA4W_EV_OPEN)
    ce_eq("OPEN record", len(r4), 5)
    ce_eq("OPEN about", r4[3], 65536)
    ce_eq("OPEN e[31]", r4[4][31], 14)
    ce_eq("SET 5 parses", sa4w_parse(sa4w_fmt_set(7, 5, sa4w_bitmap([1, 2])))[2], 5)
    ce_eq("END 4 parses", sa4w_parse(sa4w_fmt_end(7, 4, 300, 2))[2], 4)
    ce_eq("END 5 parses", sa4w_parse(sa4w_fmt_end(7, 5, 300, 0))[2], 5)
    ce_eq("constant PHASE_CHECK", SA4W_PHASE_CHECK, 4)
    ce_eq("constant PHASE_OPEN", SA4W_PHASE_OPEN, 5)
    // format(parse(l)) == l
    let r5 = sa4w_parse(sa4w_fmt_share(7, 300, 65536, _w_fill(162, 9), _w_fill(32, 12)))
    ce_str_eq("SHARE round trip", sa4w_fmt_share(r5[1], r5[2], r5[3], r5[4], r5[5]), sa4w_fmt_share(7, 300, 65536, _w_fill(162, 9), _w_fill(32, 12)))
    ce_str_eq("COMPLAINT round trip", sa4w_fmt_complaint(r2[1], r2[2], r2[3], r2[4], r2[5]), l2)
    ce_str_eq("OPEN round trip", sa4w_fmt_open(r4[1], r4[2], r4[3], r4[4]), l4)
    // Refusals: token counts, hex lengths.
    let h32 = _w_rep("0c", 32)
    let h64 = _w_rep("ee", 64)
    ce_eq("epk 63 hex digits refused", sa4w_parse("SA4_SHARE 7 1 2 " + substr(h32, 0, 63) + " " + _w_rep("00", 162)), 0)
    ce_eq("epk 66 hex digits refused", sa4w_parse("SA4_SHARE 7 1 2 " + h32 + "00 " + _w_rep("00", 162)), 0)
    ce_eq("epk uppercase refused", sa4w_parse("SA4_SHARE 7 1 2 " + _w_rep("0C", 32) + " " + _w_rep("00", 162)), 0)
    ce_eq("SHARE 7 tokens refused", sa4w_parse("SA4_SHARE 7 1 2 " + h32 + " " + _w_rep("00", 162) + " 00"), 0)
    ce_eq("SHSIG short sig refused", sa4w_parse("SA4_SHSIG 7 1 " + _w_rep("ee", 63)), 0)
    ce_eq("SHSIG 5 tokens refused", sa4w_parse("SA4_SHSIG 7 1 " + h64 + " 1"), 0)
    ce_eq("COMPLAINT 5 tokens refused", sa4w_parse("SA4_COMPLAINT 7 1 2 " + h32), 0)
    ce_eq("COMPLAINT sig 63 bytes refused", sa4w_parse("SA4_COMPLAINT 7 1 2 " + h32 + " " + _w_rep("ee", 63)), 0)
    ce_eq("COMPLAINT about 2^32 refused", sa4w_parse("SA4_COMPLAINT 7 1 4294967296 " + h32 + " " + h64), 0)
    ce_eq("ACCUSE short bitmap refused", sa4w_parse("SA4_ACCUSE 7 " + _w_rep("00", 31)), 0)
    ce_eq("ACCUSE 4 tokens refused", sa4w_parse("SA4_ACCUSE 7 " + h32 + " 1"), 0)
    ce_eq("OPEN long e refused", sa4w_parse("SA4_OPEN 7 1 2 " + h32 + "00"), 0)
    ce_eq("OPEN 4 tokens refused", sa4w_parse("SA4_OPEN 7 1 2"), 0)
    ce_eq("OPEN round leading zero refused", sa4w_parse("SA4_OPEN 07 1 2 " + h32), 0)
    // Maximal sizes (r = 2^62 - 1, 10-digit ids) at N = 3 / 10 / 255.
    let big = 4294967295
    let dd = [2, 4, 8]
    let want = [441, 569, 825]
    let k = 0
    while k < 3 {
        let ls = sa4w_fmt_share(maxr, big, big, _w_fill(98 + 32 * dd[k], 0), sa4w_unhex("09" + _w_rep("00", 31), 32))
        ce_eq("max SHARE line at D = " + int_to_str(dd[k]), len(ls), want[k])
        ce_check("max SHARE line at D = " + int_to_str(dd[k]) + " parses", sa4w_parse(ls) != 0)
        k = k + 1
    }
    ce_eq("max SHSIG line", len(sa4w_fmt_shsig(maxr, big, _w_fill(64, 0))), 169)
    ce_eq("max SET 5 line", len(sa4w_fmt_set(maxr, 5, _w_fill(32, 0))), 94)
    ce_eq("max COMPLAINT line", len(sa4w_fmt_complaint(maxr, big, big, _w_fill(32, 0), _w_fill(64, 0))), 249)
    ce_eq("max ACCUSE line", len(sa4w_fmt_accuse(maxr, _w_fill(32, 0))), 95)
    ce_eq("max OPEN line", len(sa4w_fmt_open(maxr, big, big, _w_fill(32, 0))), 115)
    ce_eq("max END line", len(sa4w_fmt_end(maxr, 5, big, big)), 51)
    ce_check("max COMPLAINT parses", sa4w_parse(sa4w_fmt_complaint(maxr, big, big, _w_fill(32, 0), _w_fill(64, 0))) != 0)
    ce_check("max OPEN parses", sa4w_parse(sa4w_fmt_open(maxr, big, big, _w_fill(32, 0))) != 0)
    let l1001 = sa4w_fmt_share(maxr, big, big, _w_fill(98 + 256, 0), _w_fill(32, 9))
    while len(l1001) < 1001 { l1001 = l1001 + "0" }
    ce_eq("a 1001-byte line is refused", sa4w_parse(l1001), 0)
    ce_eq("SA4W_MAX_LINE stays 1000", SA4W_MAX_LINE, 1000)
}

// K3..K8 of SPEC A2.4c section 15 (proto_final.py --pins).
fn test_v3_pins() {
    let fp = _w_iota(32)
    ce_str_eq("K3 sleaf", sa4w_hex(sa4w_sleaf(fp, 7, 300, 3, 65536, _w_fill(32, 12), _w_fill(162, 13))), "de12c14647d745a5d76f797f9861de08ab5ba803fd89438c5307d1bbc4adf225")
    let lv = list_new()
    push(lv, 0)
    push(lv, _w_fill(32, 1))
    push(lv, _w_fill(32, 2))
    push(lv, _w_fill(32, 3))
    push(lv, _w_fill(32, 4))
    ce_str_eq("K4 share root N = 5", sa4w_hex(sa4w_tree_root(sa4w_share_tree(lv, sa4w_depth(5)))), "d84e8f937c944f5d86b1ccb7c6acc6b0dc56dba8545874230940a057fc99ab9c")
    let t5 = sa4w_shares_transcript(fp, 7, 300, _w_fill(32, 9), _w_fill(32, 10))
    ce_eq("K5 shares transcript length", len(t5), 138)
    ce_str_eq("K5 shares transcript digest", sa4w_hex(sa4w_sha256(t5)), "fcabfcf49bd21049cf9a8cadd8cbe60d9d0665506942a59448d95f13bacb3437")
    let t6 = sa4w_complaint_transcript(fp, 7, 65536, 300, _w_fill(32, 9), _w_fill(32, 11))
    ce_eq("K6 complaint transcript length", len(t6), 145)
    ce_str_eq("K6 complaint transcript digest", sa4w_hex(sa4w_sha256(t6)), "2d67c4b49a0de7573dfa4db43836c8256d6215bee38f6a2c955e1c5024336af9")
    let adv = sa4w_adv_transcript(fp, 7, 300, 150, sa4h_layout(), _w_fill(32, 1), _w_fill(32, 2), _w_fill(32, 3), _w_fill(32, 4))
    ce_eq("K7 ADV transcript length", len(adv), 235)
    ce_str_eq("K7 v3 ADV transcript digest", sa4w_hex(sa4w_sha256(adv)), "c745c7942d938a41cc13b5adc36287c254bfde40566c0f7050fd07630a0c9ff9")
    let g = sa4e_garbage(_w_fill(162, 0))
    ce_eq("K8 garbage length", len(g), 162)
    ce_str_eq("K8 garbage digest", sa4w_hex(sa4w_sha256(g)), "f4b04e6ec606faa8cf511c53a337c6ff58ae0b183a8b0675e03b2701f19ec243")
    let g16 = list_new()
    let i = 0
    while i < 16 {
        push(g16, g[i])
        i = i + 1
    }
    ce_str_eq("K8 garbage first 16 bytes", sa4w_hex(g16), "59faa26b2045ebe113270dcc877ccf50")
    // The sleaf covers e_pk and ct: one byte of either changes it.
    let ct = _w_fill(162, 13)
    list_set(ct, 161, 14)
    ce_check("sleaf covers ct", str_eq_bytes(sa4w_hex(sa4w_sleaf(fp, 7, 300, 3, 65536, _w_fill(32, 12), ct)), "de12c14647d745a5d76f797f9861de08ab5ba803fd89438c5307d1bbc4adf225") == 0)
    let ep = _w_fill(32, 12)
    list_set(ep, 0, 13)
    ce_check("sleaf covers e_pk", str_eq_bytes(sa4w_hex(sa4w_sleaf(fp, 7, 300, 3, 65536, ep, _w_fill(162, 13))), "de12c14647d745a5d76f797f9861de08ab5ba803fd89438c5307d1bbc4adf225") == 0)
    ce_check("sleaf covers x", str_eq_bytes(sa4w_hex(sa4w_sleaf(fp, 7, 300, 4, 65536, _w_fill(32, 12), _w_fill(162, 13))), "de12c14647d745a5d76f797f9861de08ab5ba803fd89438c5307d1bbc4adf225") == 0)
    ce_check("T_sh covers H1", str_eq_bytes(sa4w_hex(sa4w_sha256(sa4w_shares_transcript(fp, 7, 300, _w_fill(32, 8), _w_fill(32, 10)))), "fcabfcf49bd21049cf9a8cadd8cbe60d9d0665506942a59448d95f13bacb3437") == 0)
    ce_check("T_c covers H1", str_eq_bytes(sa4w_hex(sa4w_sha256(sa4w_complaint_transcript(fp, 7, 65536, 300, _w_fill(32, 8), _w_fill(32, 11)))), "2d67c4b49a0de7573dfa4db43836c8256d6215bee38f6a2c955e1c5024336af9") == 0)
}

fn _w_buf(lst) { return sac_list_to_buf(lst) }

// Seal plaintext pt from u = 300 to v = 65536 (round 7) under the one-time
// key e and the receiver's c key; returns the ciphertext list.
fn _w_seal(e, cpk, pt) {
    let k = sac_enc_key(_w_buf(e), _w_buf(cpk), 7, 300, 65536)
    let w = sac_share_seal(k[0], 7, 300, 65536, _w_buf(pt), len(pt))
    return sac_buf_to_list(w[0], w[1])
}

// sa4w_share_check reaches every kind but "length": a ciphertext of
// 98 + 32D bytes always opens to 82 + 32D bytes, and callers refuse any
// other ciphertext length before the check (soul pass 1, coordinator
// receipt, the judge), so "length" is unreachable by construction.
fn test_share_check() {
    let fp = _w_iota(32)
    let n = 3
    let dd = sa4w_depth(n)
    let leaves = list_new()
    let x = 1
    while x <= n {
        push(leaves, sa4w_leaf(sa4w_hs(fp, 7, 300, x, _w_fill(32, x)), sa4w_hb(fp, 7, 300, x, _w_fill(32, 100 + x))))
        x = x + 1
    }
    let tree = sa4w_tree(leaves, dd)
    let mroot = sa4w_tree_root(tree)
    let path = sa4w_path(tree, 1)
    let e = _w_fill(32, 14)
    let csk = _w_fill(32, 77)
    let cpkb = alloc(33)
    x25519_base(cpkb, _w_buf(csk))
    let cpk = sac_buf_to_list(cpkb, 32)
    let epkb = alloc(33)
    x25519_base(epkb, _w_buf(e))
    let epk = sac_buf_to_list(epkb, 32)
    let good = _w_seal(e, cpk, sa4w_share_pt(300, 65536, 7, 2, _w_fill(32, 2), _w_fill(32, 102), path))
    let rk = sac_enc_key(_w_buf(csk), _w_buf(epk), 7, 300, 65536)
    let res = sa4w_share_check(fp, 7, 300, 65536, 2, dd, rk[0], good, mroot)
    ce_str_eq("check: the dealt share passes", res[0], "")
    ce_eq("check: s-share returned", res[1][0], 2)
    ce_eq("check: b-share returned", res[2][31], 102)
    ce_eq("check: path returned", len(res[3]), dd)
    let kz = 0
    let i = 0
    while i < 32 {
        kz = kz + load8(rk[0] + i)
        i = i + 1
    }
    ce_eq("check: the key buffer is zeroed", kz, 0)
    // The judge key X25519(e, c_v^PK) gives the same result.
    let jk = sac_enc_key(_w_buf(e), _w_buf(cpk), 7, 300, 65536)
    ce_str_eq("check: judge key J = C", sa4w_share_check(fp, 7, 300, 65536, 2, dd, jk[0], good, mroot)[0], "")
    let bad = _w_seal(e, cpk, sa4w_share_pt(300, 65536, 7, 2, _w_fill(32, 2), _w_fill(32, 102), path))
    list_set(bad, 5, int_xor(bad[5], 1))
    ce_str_eq("check: open", sa4w_share_check(fp, 7, 300, 65536, 2, dd, sac_enc_key(_w_buf(csk), _w_buf(epk), 7, 300, 65536)[0], bad, mroot)[0], "open")
    let pv = sa4w_share_pt(300, 65536, 7, 2, _w_fill(32, 2), _w_fill(32, 102), path)
    list_set(pv, 0, 1)
    ce_str_eq("check: version", sa4w_share_check(fp, 7, 300, 65536, 2, dd, sac_enc_key(_w_buf(csk), _w_buf(epk), 7, 300, 65536)[0], _w_seal(e, cpk, pv), mroot)[0], "version")
    let pf = sa4w_share_pt(300, 65536, 7, 3, _w_fill(32, 2), _w_fill(32, 102), path)
    ce_str_eq("check: fields (x_to)", sa4w_share_check(fp, 7, 300, 65536, 2, dd, sac_enc_key(_w_buf(csk), _w_buf(epk), 7, 300, 65536)[0], _w_seal(e, cpk, pf), mroot)[0], "fields")
    let pr = sa4w_share_pt(300, 65536, 8, 2, _w_fill(32, 2), _w_fill(32, 102), path)
    ce_str_eq("check: fields (round)", sa4w_share_check(fp, 7, 300, 65536, 2, dd, sac_enc_key(_w_buf(csk), _w_buf(epk), 7, 300, 65536)[0], _w_seal(e, cpk, pr), mroot)[0], "fields")
    let pc = sa4w_share_pt(300, 65536, 7, 2, _w_fill(32, 2), _w_fill(32, 103), path)
    ce_str_eq("check: commit", sa4w_share_check(fp, 7, 300, 65536, 2, dd, sac_enc_key(_w_buf(csk), _w_buf(epk), 7, 300, 65536)[0], _w_seal(e, cpk, pc), mroot)[0], "commit")
    // key: a zero e_pk (bypassing epk_ok) makes the key agreement refuse.
    let zk = sac_enc_key(_w_buf(csk), _w_buf(_w_fill(32, 0)), 7, 300, 65536)
    ce_eq("check: zero e_pk refuses the key agreement", zk[1], 0)
    ce_str_eq("check: key", sa4w_share_check(fp, 7, 300, 65536, 2, dd, zk[0], good, mroot)[0], "key")
    ce_eq("check: failing kinds return no share", sa4w_share_check(fp, 7, 300, 65536, 2, dd, 0, good, mroot)[1], 0)
}

fn main() {
    test_decimals()
    test_roundtrip()
    test_y_chunks()
    test_parse_refusals()
    test_v2_bounds()
    test_bitmaps()
    test_transcripts()
    test_v3_lines()
    test_v3_pins()
    test_share_check()
    ce_summary("sa4_wire")
}

main()
