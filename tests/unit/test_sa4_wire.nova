// Unit tests for src/learning/sa4_wire.nova (SecAgg v4 wire format and
// signed transcripts, A2.2a). No signatures are computed here.
// Transcript digests, bitmap and share-plaintext bytes were computed
// independently in Python (hashlib).

import "../ce_test.nova"
import "../../src/learning/sa4_wire.nova"

fn _w_fill(n, v) {
    let out = list_new()
    let i = 0
    while i < n {
        push(out, v)
        i = i + 1
    }
    return out
}

fn _w_iota(n) {
    let out = list_new()
    let i = 0
    while i < n {
        push(out, i)
        i = i + 1
    }
    return out
}

fn _w_rep(s, n) {
    let out = ""
    let i = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn test_decimals() {
    ce_eq("u32 0", sa4w_dec_u32("0"), 0)
    ce_eq("u32 max", sa4w_dec_u32("4294967295"), 4294967295)
    ce_eq("u32 2^32", sa4w_dec_u32("4294967296"), 0 - 1)
    ce_eq("u32 leading zero", sa4w_dec_u32("07"), 0 - 1)
    ce_eq("u32 sign", sa4w_dec_u32("-1"), 0 - 1)
    ce_eq("u32 11 digits", sa4w_dec_u32("10000000000"), 0 - 1)
    ce_eq("u32 empty", sa4w_dec_u32(""), 0 - 1)
    ce_eq("u32 x", sa4w_dec_u32("1x"), 0 - 1)
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    ce_eq("round 2^62-1", sa4w_dec_round("4611686018427387903"), maxr)
    ce_eq("round 2^62", sa4w_dec_round("4611686018427387904"), 0 - 1)
    ce_eq("round 19 nines", sa4w_dec_round("9999999999999999999"), 0 - 1)
    ce_eq("round 20 digits", sa4w_dec_round("10000000000000000000"), 0 - 1)
    ce_eq("round 18 digits", sa4w_dec_round("999999999999999999"), 999999999999999999)
    ce_eq("round 1 (19-digit lower)", sa4w_dec_round("1000000000000000000"), 1000000000000000000)
}

fn test_roundtrip() {
    let fp = _w_iota(32)
    let lay = _w_fill(32, 171)
    let l1 = sa4w_fmt_round(7, fp, 150, lay)
    ce_str_eq("round line", l1, "SA4_ROUND 7 000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f 150 abababababababababababababababababababababababababababababababab")
    let r1 = sa4w_parse(l1)
    ce_eq("round ev", r1[0], SA4W_EV_ROUND)
    ce_eq("round r", r1[1], 7)
    ce_eq("round L", r1[3], 150)
    ce_eq("round fp[31]", r1[2][31], 31)
    let cpk = _w_fill(32, 1)
    let spk = _w_fill(32, 2)
    let sig = _w_fill(64, 255)
    let l2 = sa4w_fmt_adv(7, 4294967295, cpk, spk, sig)
    let r2 = sa4w_parse(l2)
    ce_eq("adv ev", r2[0], SA4W_EV_ADV)
    ce_eq("adv id", r2[2], 4294967295)
    ce_eq("adv sig[63]", r2[5][63], 255)
    let r3 = sa4w_parse(sa4w_fmt_set(7, 3, sa4w_bitmap([1, 9, 255])))
    ce_eq("set k", r3[2], 3)
    ce_str_eq("bitmap bytes (Python)", sa4w_hex(r3[3]), "0101000000000000000000000000000000000000000000000000000000000040")
    let ct = _w_fill(98, 9)
    let r4 = sa4w_parse(sa4w_fmt_share(7, 300, 65536, ct))
    ce_eq("share to", r4[3], 65536)
    ce_eq("share ct len", len(r4[4]), 98)
    let r5 = sa4w_parse(sa4w_fmt_sig3(8, 70000, sig))
    ce_eq("sig3 id", r5[2], 70000)
    let r6 = sa4w_parse(sa4w_fmt_reveal(8, 7, 300, 1, _w_fill(32, 5)))
    ce_eq("reveal kind s", r6[4], 1)
    let r6b = sa4w_parse(sa4w_fmt_reveal(8, 7, 300, 0, _w_fill(32, 5)))
    ce_eq("reveal kind b", r6b[4], 0)
    let r7 = sa4w_parse(sa4w_fmt_end(8, 2, 7, 3))
    ce_eq("end phase", r7[2], 2)
    ce_eq("end count", r7[4], 3)
    let r8 = sa4w_parse(sa4w_fmt_abort(8, 7, "bad_sig3"))
    ce_str_eq("abort code", r8[3], "bad_sig3")
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    let r9 = sa4w_parse(sa4w_fmt_end(maxr, 1, 4294967295, 254))
    ce_eq("max round round-trips", r9[1], maxr)
    ce_check("max-size ADV line under 1000", len(sa4w_fmt_adv(maxr, 4294967295, cpk, spk, sig)) <= 1000)
}

fn test_y_chunks() {
    let words = list_new()
    let i = 0
    while i < 250 {
        push(words, int_and(int_add(int_mul(i, 2654435761), 4000000000), 4294967295))
        i = i + 1
    }
    list_set(words, 0, 0)
    list_set(words, 1, 4294967295)
    let lines = sa4w_fmt_y_lines(9, 65536, words)
    ce_eq("250 words -> 3 chunks", len(lines), 3)
    let maxlen = 0
    let recs = list_new()
    i = 0
    while i < len(lines) {
        if len(lines[i]) > maxlen { maxlen = len(lines[i]) }
        push(recs, sa4w_parse(lines[i]))
        i = i + 1
    }
    ce_check("Y lines under 1000 bytes", maxlen <= 1000)
    ce_eq("chunk 2 has 50 words", len(recs[2][5]), 50)
    let back = sa4w_y_assemble(recs, 250)
    ce_eq("assembled length", len(back), 250)
    let same = 1
    i = 0
    while i < 250 {
        if back[i] != words[i] { same = 0 }
        i = i + 1
    }
    ce_eq("words round-trip", same, 1)
    let rev = list_new()
    push(rev, recs[2])
    push(rev, recs[0])
    push(rev, recs[1])
    ce_eq("out-of-order chunks assemble", len(sa4w_y_assemble(rev, 250)), 250)
    let dup = list_new()
    push(dup, recs[0])
    push(dup, recs[0])
    push(dup, recs[2])
    ce_eq("duplicate chunk refused", sa4w_y_assemble(dup, 250), 0)
    let miss = list_new()
    push(miss, recs[0])
    push(miss, recs[1])
    ce_eq("missing chunk refused", sa4w_y_assemble(miss, 250), 0)
    ce_eq("wrong L refused", sa4w_y_assemble(recs, 251), 0)
    ce_eq("exact 100 words -> 1 chunk", len(sa4w_fmt_y_lines(1, 1, _w_fill(100, 7))), 1)
    ce_eq("1 word -> 1 chunk", len(sa4w_fmt_y_lines(1, 1, _w_fill(1, 7))), 1)
}

fn test_parse_refusals() {
    let fp = sa4w_hex(_w_iota(32))
    let lay = _w_rep("ab", 32)
    ce_check("valid round parses", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay) != 0)
    ce_eq("double space", sa4w_parse("SA4_ROUND 7  " + fp + " 150 " + lay), 0)
    ce_eq("trailing space", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay + " "), 0)
    ce_eq("leading space", sa4w_parse(" SA4_ROUND 7 " + fp + " 150 " + lay), 0)
    ce_eq("uppercase hex", sa4w_parse("SA4_ROUND 7 000102030405060708090A0B0C0D0E0F101112131415161718191a1b1c1d1e1f 150 " + lay), 0)
    ce_eq("short fp", sa4w_parse("SA4_ROUND 7 0001 150 " + lay), 0)
    ce_eq("L = 0", sa4w_parse("SA4_ROUND 7 " + fp + " 0 " + lay), 0)
    ce_eq("L > 2^24", sa4w_parse("SA4_ROUND 7 " + fp + " 16777217 " + lay), 0)
    ce_eq("round leading zero", sa4w_parse("SA4_ROUND 07 " + fp + " 150 " + lay), 0)
    ce_eq("round 2^62", sa4w_parse("SA4_ROUND 4611686018427387904 " + fp + " 150 " + lay), 0)
    ce_eq("extra field", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay + " x"), 0)
    ce_eq("tab", sa4w_parse("SA4_ROUND" + chr(9) + "7 " + fp + " 150 " + lay), 0)
    ce_eq("CR", sa4w_parse("SA4_ROUND 7 " + fp + " 150 " + lay + chr(13)), 0)
    ce_eq("unknown tag", sa4w_parse("SA4_NOPE 7 1"), 0)
    ce_eq("lowercase tag", sa4w_parse("sa4_end 7 1 1 1"), 0)
    ce_eq("set k=0", sa4w_parse("SA4_SET 7 0 " + fp), 0)
    ce_eq("set k=5", sa4w_parse("SA4_SET 7 5 " + fp), 0)
    ce_eq("end phase 4", sa4w_parse("SA4_END 7 4 1 1"), 0)
    ce_eq("reveal kind x", sa4w_parse("SA4_REVEAL 7 1 2 x " + fp), 0)
    ce_eq("abort uppercase code", sa4w_parse("SA4_ABORT 7 1 Bad"), 0)
    ce_eq("abort code 33 chars", sa4w_parse("SA4_ABORT 7 1 " + _w_rep("a", 33)), 0)
    ce_eq("y index >= n", sa4w_parse("SA4_Y 7 1 2 2 00000001"), 0)
    ce_eq("y n = 0", sa4w_parse("SA4_Y 7 1 0 0 00000001"), 0)
    ce_eq("y odd hex", sa4w_parse("SA4_Y 7 1 0 1 0000001"), 0)
    ce_eq("y 101 words", sa4w_parse("SA4_Y 7 1 0 1 " + _w_rep("00000001", 101)), 0)
    ce_eq("share short ct", sa4w_parse("SA4_SHARE 7 1 2 " + _w_rep("00", 97)), 0)
    let long = "SA4_ABORT 7 1 " + _w_rep("a", 32)
    while len(long) <= 1000 { long = long + "a" }
    ce_eq("line > 1000 bytes", sa4w_parse(long), 0)
    ce_eq("empty line", sa4w_parse(""), 0)
}

fn test_bitmaps() {
    let bm = sa4w_bitmap([1, 3, 8, 9])
    let xs = sa4w_bitmap_xs(bm, 9)
    ce_eq("xs count", len(xs), 4)
    ce_eq("xs[3]", xs[3], 9)
    ce_eq("bit above N refused", sa4w_bitmap_xs(bm, 8), 0)
    ce_eq("empty bitmap", len(sa4w_bitmap_xs(sa4w_bitmap(list_new()), 5)), 0)
    let full = list_new()
    let i = 1
    while i <= 255 {
        push(full, i)
        i = i + 1
    }
    ce_eq("N=255 all set", len(sa4w_bitmap_xs(sa4w_bitmap(full), 255)), 255)
    ce_eq("short bitmap refused", sa4w_bitmap_xs(_w_fill(31, 0), 5), 0)
}

fn test_transcripts() {
    let fp = _w_iota(32)
    let adv = sa4w_adv_transcript(fp, 7, 300, 150, _w_fill(32, 171), _w_fill(32, 1), _w_fill(32, 2))
    ce_eq("ADV length", len(adv), 171)
    ce_str_eq("ADV digest (Python)", sa4w_hex(sa4w_sha256(adv)), "9447464ae2493fa6589c4dc0c5232b4c634aa1022fd15570665950e121bc2f7f")
    let keys = list_new()
    let k = 0
    while k < 3 {
        let kp = list_new()
        push(kp, _w_fill(32, 2 * k + 1))
        push(kp, _w_fill(32, 2 * k + 2))
        push(keys, kp)
        k = k + 1
    }
    let h1 = sa4w_advset_hash(sa4w_bitmap([1, 2, 3]), keys)
    ce_str_eq("H1 (Python)", sa4w_hex(h1), "4762c8d4585a354586706b51ce9fe782072d46f4b735925d8a3a4547e5292930")
    let t3 = sa4w_t3_transcript(fp, 7, h1, sa4w_bitmap([1, 2, 3]), sa4w_bitmap([1, 3]))
    ce_eq("T3 length", len(t3), 162)
    ce_str_eq("T3 digest (Python)", sa4w_hex(sa4w_sha256(t3)), "e119ce69a357bf133c6ceb679be239e5347edd98d3634118f87e523eaa4f22bc")
    let maxr = int_add(int_shl(1, 61), int_sub(int_shl(1, 61), 1))
    let pt = sa4w_share_pt(7, 4294967295, maxr, 3, _w_fill(32, 17), _w_fill(32, 34))
    ce_str_eq("share plaintext (Python)", sa4w_hex(pt), "0100000007ffffffff3fffffffffffffff0311111111111111111111111111111111111111111111111111111111111111112222222222222222222222222222222222222222222222222222222222222222")
    let p = sa4w_share_pt_parse(pt)
    ce_eq("pt from", p[0], 7)
    ce_eq("pt to", p[1], 4294967295)
    ce_eq("pt round", p[2], maxr)
    ce_eq("pt x", p[3], 3)
    ce_eq("pt b[0]", p[5][0], 34)
    let bad = sa4w_share_pt(7, 8, 1, 3, _w_fill(32, 0), _w_fill(32, 0))
    list_set(bad, 0, 2)
    ce_eq("pt version 2 refused", sa4w_share_pt_parse(bad), 0)
    ce_eq("pt short refused", sa4w_share_pt_parse(_w_fill(81, 1)), 0)
}

fn main() {
    test_decimals()
    test_roundtrip()
    test_y_chunks()
    test_parse_refusals()
    test_bitmaps()
    test_transcripts()
    ce_summary("sa4_wire")
}

main()
