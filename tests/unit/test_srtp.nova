// Unit tests for src/federation/srtp.nova (R34C SRTP wire codec).
//
// Coverage (~70 assertions):
//   * SHA-1 KAT vectors:
//       - SHA-1("abc") = a9993e36... (FIPS 180-4 Appendix A / RFC 3174)
//       - SHA-1("") = da39a3ee...
//       - SHA-1("abcdbcdecdef...nopq" 56-char) (FIPS 180-4 Appendix B.2)
//       - SHA-1("a" * 1000000) skipped -- too slow for the unit suite
//   * HMAC-SHA1 RFC 2202 test vectors:
//       - TC1: key=0x0b*20, msg="Hi There"
//       - TC2: key="Jefe", msg="what do ya want for nothing?"
//       - TC4: key=0x01..0x19, msg=0xcd*50
//   * AES-CM-128 keystream:
//       - Direct: AES_K(salt||00 00) on a known key + salt
//       - Counter increment crosses 16-byte boundary
//   * SRTP KDF (RFC 3711 §B.3 official test vector):
//       - master_key = E1F97A0D3E018BE0D64FA32C06DE4139
//       - master_salt = 0EC675AD498AFEEBB6960B3AABE6
//       - derived encryption key (label 0x00) = C61E7A93744F39EE10734AFE3FF7A087
//       - derived auth key (label 0x01) = CEBE321F6FF7716B6FD4AB49AF256A156D38BAA4
//       - derived salt (label 0x02) = 30CBBC08863D8C85D49DB34A9AE1
//   * Full srtp_seal + srtp_open round trip:
//       - 32-byte payload, hdr_n=12 (minimal RTP header)
//       - Recovered plaintext is byte-identical
//   * Tamper rejection:
//       - Flip a byte in the tag -> SRTP_AUTH_FAIL
//       - Flip a byte in the ciphertext -> SRTP_AUTH_FAIL
//   * Anti-replay:
//       - Replay of the same packet -> SRTP_REPLAY
//       - 64-packet jump slides the window correctly
//   * ROC rollover:
//       - Send seq 65534 -> 65535 -> 0 -> 1 increments ROC properly
//       - Open: seq 65535 then seq 0 estimated at next ROC
//   * Constants sanity
//
// References:
//   * RFC 3711 §B.3 -- KDF test vectors
//   * RFC 3174 Appendix A -- SHA-1 test vectors
//   * RFC 2202 §3 -- HMAC-SHA1 test cases
//
// NOVA dependencies: ce_test harness, srtp.nova (R34C), aes_gcm.nova
// (transitively for AES-128 block).

import "../ce_test.nova"
import "../../src/federation/srtp.nova"

// ----------------------------------------------------------------------------
//                          Helper utilities
// ----------------------------------------------------------------------------

fn _ts_nibble_hex(n) {
    if n < 10 { return 48 + n }      // '0'..'9'
    return 87 + n                    // 'a'..'f'
}

fn _ts_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        let hi = _ts_nibble_hex(int_and(int_shr(b, 4), 15))
        let lo = _ts_nibble_hex(int_and(b, 15))
        s = s + chr(hi) + chr(lo)
        i = i + 1
    }
    return s
}

fn _ts_hex_nibble(c) {
    if c >= 48 {
        if c <= 57 { return c - 48 }
    }
    if c >= 97 {
        if c <= 102 { return c - 87 }
    }
    if c >= 65 {
        if c <= 70 { return c - 55 }
    }
    return 0 - 1
}

fn _ts_hex_to_buf(hex) {
    let n = len(hex)
    let half = int_shr(n, 1)
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _ts_hex_nibble(char_at(hex, i * 2))
        let lo = _ts_hex_nibble(char_at(hex, i * 2 + 1))
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    let r = list_new()
    push(r, buf)
    push(r, half)
    return r
}

fn _ts_str_to_buf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    let r = list_new()
    push(r, buf)
    push(r, n)
    return r
}

// Buf-vs-buf byte equality.
fn _ts_buf_eq(a, b, n) {
    let i = 0
    while i < n {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

// ----------------------------------------------------------------------------
//                          SHA-1 KAT vectors
// ----------------------------------------------------------------------------
//
// Test the inline _srtp_sha1_oneshot via _srtp_hmac_sha1 indirectly is
// covered below; here we exercise the bare hash directly.

fn test_sha1_abc() {
    // RFC 3174 Appendix A / FIPS 180-4 Appendix A.1: SHA-1("abc").
    let p = _ts_str_to_buf("abc")
    let h = _srtp_sha1_oneshot(p[0], p[1])
    ce_str_eq("SHA-1('abc')",
        _ts_hex_encode_buf(h, 20),
        "a9993e364706816aba3e25717850c26c9cd0d89d")
}

fn test_sha1_empty() {
    // SHA-1("") (well-known constant).
    let buf = alloc(1)
    store8(buf, 0)
    let h = _srtp_sha1_oneshot(buf, 0)
    ce_str_eq("SHA-1('')",
        _ts_hex_encode_buf(h, 20),
        "da39a3ee5e6b4b0d3255bfef95601890afd80709")
}

fn test_sha1_fips_appendix_b2() {
    // FIPS 180-4 Appendix B.2 / RFC 3174 Appendix A: 56-char input
    // forces a 2-block padding (rem = 56 -> need_two = 1).
    let p = _ts_str_to_buf(
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    let h = _srtp_sha1_oneshot(p[0], p[1])
    ce_str_eq("SHA-1(FIPS Appendix B.2 56-char input)",
        _ts_hex_encode_buf(h, 20),
        "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
}

fn test_sha1_block_boundary_55() {
    // 55-byte input: exactly fits one block including the 0x80 + 8B
    // length tail (rem = 55 -> need_two = 0). 55 = 64 - 1 - 8.
    let n = 55
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 65); i = i + 1 }   // 'A' * 55
    store8(buf + n, 0)
    let h = _srtp_sha1_oneshot(buf, n)
    // Computed reference: SHA-1('A' * 55). 'A' = 0x41. Verified against
    // openssl: `printf '%.0sA' {1..55} | openssl dgst -sha1`.
    ce_str_eq("SHA-1('A' * 55) one-block boundary",
        _ts_hex_encode_buf(h, 20),
        "5021b3d42aa093bffc34eedd7a1455f3624bc552")
}

// ----------------------------------------------------------------------------
//                          HMAC-SHA1 RFC 2202 vectors
// ----------------------------------------------------------------------------

fn test_hmac_sha1_rfc2202_tc1() {
    // RFC 2202 §3 Test Case 1:
    //   key  = 0x0b * 20
    //   data = "Hi There"
    //   expected = b617318655057264e28bc0b6fb378c8ef146be00
    let key = _ts_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let msg = _ts_str_to_buf("Hi There")
    let mac = _srtp_hmac_sha1(key[0], key[1], msg[0], msg[1])
    ce_str_eq("HMAC-SHA1 RFC 2202 TC1",
        _ts_hex_encode_buf(mac, 20),
        "b617318655057264e28bc0b6fb378c8ef146be00")
}

fn test_hmac_sha1_rfc2202_tc2() {
    // RFC 2202 §3 Test Case 2:
    //   key  = "Jefe"
    //   data = "what do ya want for nothing?"
    //   expected = effcdf6ae5eb2fa2d27416d5f184df9c259a7c79
    let key = _ts_str_to_buf("Jefe")
    let msg = _ts_str_to_buf("what do ya want for nothing?")
    let mac = _srtp_hmac_sha1(key[0], key[1], msg[0], msg[1])
    ce_str_eq("HMAC-SHA1 RFC 2202 TC2",
        _ts_hex_encode_buf(mac, 20),
        "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
}

fn test_hmac_sha1_rfc2202_tc4() {
    // RFC 2202 §3 Test Case 4:
    //   key  = 0x01 0x02 ... 0x19 (25 bytes)
    //   data = 0xcd * 50
    //   expected = 4c9007f4026250c6bc8414f9bf50c86c2d7235da
    let key = _ts_hex_to_buf("0102030405060708090a0b0c0d0e0f10111213141516171819")
    let msg_n = 50
    let msg_buf = alloc(msg_n + 1)
    let i = 0
    while i < msg_n { store8(msg_buf + i, 205); i = i + 1 }   // 0xcd
    store8(msg_buf + msg_n, 0)
    let mac = _srtp_hmac_sha1(key[0], key[1], msg_buf, msg_n)
    ce_str_eq("HMAC-SHA1 RFC 2202 TC4",
        _ts_hex_encode_buf(mac, 20),
        "4c9007f4026250c6bc8414f9bf50c86c2d7235da")
}

fn test_hmac_sha1_long_key_normalization() {
    // RFC 2104 long-key path: key > 64 bytes gets pre-hashed.
    // We verify HMAC(long_key, msg) == HMAC(SHA-1(long_key), msg).
    let key_n = 80
    let key_buf = alloc(key_n + 1)
    let i = 0
    while i < key_n { store8(key_buf + i, 170); i = i + 1 }   // 0xaa * 80
    store8(key_buf + key_n, 0)
    let msg = _ts_str_to_buf("Test Using Larger Than Block-Size Key - Hash Key First")
    let mac_long = _srtp_hmac_sha1(key_buf, key_n, msg[0], msg[1])
    let key_hash = _srtp_sha1_oneshot(key_buf, key_n)
    let mac_pre = _srtp_hmac_sha1(key_hash, 20, msg[0], msg[1])
    ce_str_eq("HMAC-SHA1 long-key normalization matches pre-hash",
        _ts_hex_encode_buf(mac_long, 20),
        _ts_hex_encode_buf(mac_pre, 20))
}

// ----------------------------------------------------------------------------
//                          AES-CM keystream
// ----------------------------------------------------------------------------

fn test_aes_cm_zero_input() {
    // AES-128 of zero block under zero key (well-known constant).
    // This is what AES-CM produces for key=0^16, salt=0^14, ssrc=0,
    // packet_index=0, first 16 bytes.
    let key = alloc(17)
    let salt = alloc(15)
    let i = 0
    while i < 16 { store8(key + i, 0); i = i + 1 }
    store8(key + 16, 0)
    i = 0
    while i < 14 { store8(salt + i, 0); i = i + 1 }
    store8(salt + 14, 0)
    let ks = _srtp_aes_cm_keystream(key, salt, 0, 0, 16)
    // AES-128_0(0^128) = 66E94BD4EF8A2C3B884CFA59CA342B2E
    ce_str_eq("AES-CM keystream of (zero-key, zero-salt, zero-counter)",
        _ts_hex_encode_buf(ks, 16),
        "66e94bd4ef8a2c3b884cfa59ca342b2e")
}

fn test_aes_cm_counter_crosses_blocks() {
    // 32 bytes of keystream forces TWO AES blocks. The second block
    // should differ from the first because the counter increments.
    let key = alloc(17)
    let salt = alloc(15)
    let i = 0
    while i < 16 { store8(key + i, 0); i = i + 1 }
    store8(key + 16, 0)
    i = 0
    while i < 14 { store8(salt + i, 0); i = i + 1 }
    store8(salt + 14, 0)
    let ks = _srtp_aes_cm_keystream(key, salt, 0, 0, 32)
    // First block: AES(0, IV=salt||0000) = AES_0(0^16)
    //   = 66e94bd4ef8a2c3b884cfa59ca342b2e
    // Second block: AES(0, IV=salt||0001) = AES_0(0^15 || 01)
    //   = 58e2fccefa7e3061367f1d57a4e7455a
    // Both verified against the python `cryptography` AES-128 ECB.
    ce_str_eq("AES-CM keystream first 16 bytes (zero key, ctr=0)",
        _ts_hex_encode_buf(ks, 16),
        "66e94bd4ef8a2c3b884cfa59ca342b2e")
    ce_str_eq("AES-CM keystream bytes 16..32 (zero key, ctr=1)",
        _ts_hex_encode_buf(ks + 16, 16),
        "58e2fccefa7e3061367f1d57a4e7455a")
}

fn test_aes_cm_ssrc_xor_into_iv() {
    // With SSRC != 0, the IV at bytes 4..8 changes. Sanity-check that
    // the keystream differs from the ssrc=0 case.
    let key = alloc(17)
    let salt = alloc(15)
    let i = 0
    while i < 16 { store8(key + i, 0); i = i + 1 }
    store8(key + 16, 0)
    i = 0
    while i < 14 { store8(salt + i, 0); i = i + 1 }
    store8(salt + 14, 0)
    let ks_a = _srtp_aes_cm_keystream(key, salt, 0, 0, 16)
    let ks_b = _srtp_aes_cm_keystream(key, salt, 1, 0, 16)
    ce_check("AES-CM keystream differs for ssrc=0 vs ssrc=1",
             _ts_buf_eq(ks_a, ks_b, 16) == 0)
}

fn test_aes_cm_packet_index_xor_into_iv() {
    // With packet_index != 0, the IV at bytes 8..14 changes.
    let key = alloc(17)
    let salt = alloc(15)
    let i = 0
    while i < 16 { store8(key + i, 0); i = i + 1 }
    store8(key + 16, 0)
    i = 0
    while i < 14 { store8(salt + i, 0); i = i + 1 }
    store8(salt + 14, 0)
    let ks_a = _srtp_aes_cm_keystream(key, salt, 0, 0, 16)
    let ks_b = _srtp_aes_cm_keystream(key, salt, 0, 1, 16)
    ce_check("AES-CM keystream differs for packet_index=0 vs 1",
             _ts_buf_eq(ks_a, ks_b, 16) == 0)
}

fn test_srtp_encrypt_decrypt_round_trip() {
    // XOR is involutive: srtp_decrypt(srtp_encrypt(pt)) == pt.
    let key = _ts_hex_to_buf("2b7e151628aed2a6abf7158809cf4f3c")
    let salt = _ts_hex_to_buf("f0f1f2f3f4f5f6f7f8f9fafbfcfd")
    let pt_n = 32
    let pt = alloc(pt_n + 1)
    let i = 0
    while i < pt_n { store8(pt + i, int_and(i, 255)); i = i + 1 }
    store8(pt + pt_n, 0)
    let ct = srtp_encrypt(key[0], salt[0], 65537, 99, pt, pt_n)
    let pt2 = srtp_decrypt(key[0], salt[0], 65537, 99, ct, pt_n)
    ce_check("AES-CM encrypt+decrypt round-trip preserves plaintext",
             _ts_buf_eq(pt, pt2, pt_n) == 1)
    // And the ciphertext must NOT equal the plaintext (we encrypted).
    ce_check("AES-CM ciphertext differs from plaintext",
             _ts_buf_eq(pt, ct, pt_n) == 0)
}

// ----------------------------------------------------------------------------
//                          SRTP KDF (RFC 3711 §B.3)
// ----------------------------------------------------------------------------

fn test_srtp_kdf_rfc3711_appendix_b3_encr() {
    // RFC 3711 Appendix B.3 official test vector. Master key + salt
    // -> three sub-keys via the AES-CM KDF (labels 0/1/2).
    let mk   = _ts_hex_to_buf("e1f97a0d3e018be0d64fa32c06de4139")
    let ms   = _ts_hex_to_buf("0ec675ad498afeebb6960b3aabe6")
    // Label 0x00 -> SRTP encryption key (16 bytes).
    let encr = srtp_kdf(mk[0], ms[0], SRTP_LABEL_ENCR, SRTP_KEY_LEN)
    ce_str_eq("RFC 3711 §B.3 KDF encryption key (label 0)",
        _ts_hex_encode_buf(encr, 16),
        "c61e7a93744f39ee10734afe3ff7a087")
}

fn test_srtp_kdf_rfc3711_appendix_b3_auth() {
    // Label 0x01 -> auth key (20 bytes).
    let mk   = _ts_hex_to_buf("e1f97a0d3e018be0d64fa32c06de4139")
    let ms   = _ts_hex_to_buf("0ec675ad498afeebb6960b3aabe6")
    let auth = srtp_kdf(mk[0], ms[0], SRTP_LABEL_AUTH, SRTP_AUTH_KEY_LEN)
    ce_str_eq("RFC 3711 §B.3 KDF auth key (label 1)",
        _ts_hex_encode_buf(auth, 20),
        "cebe321f6ff7716b6fd4ab49af256a156d38baa4")
}

fn test_srtp_kdf_rfc3711_appendix_b3_salt() {
    // Label 0x02 -> SRTP salt (14 bytes).
    let mk   = _ts_hex_to_buf("e1f97a0d3e018be0d64fa32c06de4139")
    let ms   = _ts_hex_to_buf("0ec675ad498afeebb6960b3aabe6")
    let salt = srtp_kdf(mk[0], ms[0], SRTP_LABEL_SALT, SRTP_SALT_LEN)
    ce_str_eq("RFC 3711 §B.3 KDF salt (label 2)",
        _ts_hex_encode_buf(salt, 14),
        "30cbbc08863d8c85d49db34a9ae1")
}

fn test_srtp_derive_keys_b3() {
    // srtp_derive_keys wrapper returns the three labels in one shot.
    let mk = _ts_hex_to_buf("e1f97a0d3e018be0d64fa32c06de4139")
    let ms = _ts_hex_to_buf("0ec675ad498afeebb6960b3aabe6")
    let keys = srtp_derive_keys(mk[0], ms[0])
    ce_eq("srtp_derive_keys returns 3 buffers", len(keys), 3)
    let encr = keys[0]
    let auth = keys[1]
    let salt = keys[2]
    ce_str_eq("srtp_derive_keys encr matches §B.3",
        _ts_hex_encode_buf(encr, 16),
        "c61e7a93744f39ee10734afe3ff7a087")
    ce_str_eq("srtp_derive_keys auth matches §B.3",
        _ts_hex_encode_buf(auth, 20),
        "cebe321f6ff7716b6fd4ab49af256a156d38baa4")
    ce_str_eq("srtp_derive_keys salt matches §B.3",
        _ts_hex_encode_buf(salt, 14),
        "30cbbc08863d8c85d49db34a9ae1")
}

// ----------------------------------------------------------------------------
//                          srtp_authenticate
// ----------------------------------------------------------------------------

fn test_srtp_authenticate_tag_is_10_bytes() {
    // The HMAC tag is truncated to exactly SRTP_AUTH_TAG_LEN bytes.
    let auth_key = _ts_hex_to_buf("0102030405060708090a0b0c0d0e0f1011121314")
    let pkt = _ts_hex_to_buf("8000000100000064deadbeef")
    let tag = srtp_authenticate(auth_key[0], pkt[0], pkt[1], 0)
    ce_eq("srtp_authenticate tag length is SRTP_AUTH_TAG_LEN",
          SRTP_AUTH_TAG_LEN, 10)
    // Tag is deterministic; if we call again with the same inputs we
    // get the same tag.
    let tag2 = srtp_authenticate(auth_key[0], pkt[0], pkt[1], 0)
    ce_check("srtp_authenticate is deterministic",
             _ts_buf_eq(tag, tag2, 10) == 1)
}

fn test_srtp_authenticate_roc_changes_tag() {
    // RFC 3711 §4.2: the ROC is appended to the AAD. Different ROCs
    // should produce different tags even on the same packet bytes.
    let auth_key = _ts_hex_to_buf("0102030405060708090a0b0c0d0e0f1011121314")
    let pkt = _ts_hex_to_buf("8000000100000064deadbeef")
    let tag_a = srtp_authenticate(auth_key[0], pkt[0], pkt[1], 0)
    let tag_b = srtp_authenticate(auth_key[0], pkt[0], pkt[1], 1)
    ce_check("srtp_authenticate ROC-bound: ROC=0 vs ROC=1 -> different tags",
             _ts_buf_eq(tag_a, tag_b, 10) == 0)
}

// ----------------------------------------------------------------------------
//                          Top-level srtp_seal + srtp_open
// ----------------------------------------------------------------------------

// Build a fresh SRTP state with hard-coded keys for tests. Uses the
// §B.3 derived keys so we're exercising the KDF output and the seal
// path consistently.
fn _ts_build_state() {
    let mk = _ts_hex_to_buf("e1f97a0d3e018be0d64fa32c06de4139")
    let ms = _ts_hex_to_buf("0ec675ad498afeebb6960b3aabe6")
    let keys = srtp_derive_keys(mk[0], ms[0])
    // ssrc = 0x12345678
    return srtp_state_init(keys[0], keys[1], keys[2], 305419896)
}

// Build a 12-byte RTP header (no CSRC, no extensions). Layout:
//   byte 0: V=2, P=0, X=0, CC=0 -> 0x80
//   byte 1: M=0, PT=0           -> 0x00
//   bytes 2-3: seq (filled by seal)
//   bytes 4-7: timestamp = 0x00000064
//   bytes 8-11: SSRC = 0x12345678
fn _ts_build_rtp_header() {
    let hdr = alloc(13)
    store8(hdr + 0, 128)        // 0x80
    store8(hdr + 1, 0)
    store8(hdr + 2, 0)          // seq -- seal will overwrite
    store8(hdr + 3, 0)
    store8(hdr + 4, 0)
    store8(hdr + 5, 0)
    store8(hdr + 6, 0)
    store8(hdr + 7, 100)        // 0x64
    store8(hdr + 8, 18)         // 0x12
    store8(hdr + 9, 52)         // 0x34
    store8(hdr + 10, 86)        // 0x56
    store8(hdr + 11, 120)       // 0x78
    store8(hdr + 12, 0)
    return hdr
}

fn test_seal_open_roundtrip_basic() {
    let state = _ts_build_state()
    let hdr = _ts_build_rtp_header()
    // 32-byte payload (0x00 0x01 ... 0x1F).
    let pt_n = 32
    let pt = alloc(pt_n + 1)
    let i = 0
    while i < pt_n { store8(pt + i, i); i = i + 1 }
    store8(pt + pt_n, 0)
    // Seal: state has send_seq = 0 initially.
    let sealed = srtp_seal_packet(state, hdr, 12, pt, pt_n)
    ce_check("srtp_seal_packet returned a list", sealed != 0)
    let buf = sealed[0]
    let n   = sealed[1]
    ce_eq("sealed length = hdr_n + pt_n + tag_n", n, 12 + 32 + 10)
    // The seal stamped seq=0 into the header.
    ce_eq("seal stamped seq high byte = 0", load8(buf + 2), 0)
    ce_eq("seal stamped seq low byte = 0",  load8(buf + 3), 0)
    // Open the sealed packet from a fresh state with the same keys.
    let rx = _ts_build_state()
    let opened = srtp_open_packet(rx, buf, n, 12)
    ce_check("srtp_open_packet returned a list (open succeeded)",
             opened != SRTP_AUTH_FAIL)
    ce_check("srtp_open_packet not REPLAY", opened != SRTP_REPLAY)
    ce_check("srtp_open_packet not TOO_OLD", opened != SRTP_TOO_OLD)
    let pt_back = opened[2]
    let pt_back_n = opened[3]
    ce_eq("recovered pt length matches", pt_back_n, pt_n)
    ce_check("recovered plaintext is byte-identical",
             _ts_buf_eq(pt, pt_back, pt_n) == 1)
    // Stats incremented appropriately on both sides.
    ce_eq("seal stats incremented", srtp_state_stats_seal(state), 1)
    ce_eq("open stats incremented",  srtp_state_stats_open(rx), 1)
}

fn test_seal_open_multi_packet() {
    // Three back-to-back packets with increasing seq numbers.
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let pt_n = 16
    let pt = alloc(pt_n + 1)
    let i = 0
    while i < pt_n { store8(pt + i, 255 - i); i = i + 1 }
    store8(pt + pt_n, 0)
    let p = 0
    while p < 3 {
        let hdr = _ts_build_rtp_header()
        let sealed = srtp_seal_packet(tx, hdr, 12, pt, pt_n)
        let opened = srtp_open_packet(rx, sealed[0], sealed[1], 12)
        ce_check("packet " + int_to_str(p) + " opened OK",
                 opened != SRTP_AUTH_FAIL)
        ce_check("packet " + int_to_str(p) + " pt matches",
                 _ts_buf_eq(pt, opened[2], pt_n) == 1)
        p = p + 1
    }
    ce_eq("multi-packet send_seq advanced", srtp_state_send_seq(tx), 3)
    ce_eq("multi-packet recv window watermark = 2",
          srtp_state_packet_index(rx), 2)
}

// ----------------------------------------------------------------------------
//                          Tamper rejection
// ----------------------------------------------------------------------------

fn test_tamper_flip_tag_byte() {
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let hdr = _ts_build_rtp_header()
    let pt = _ts_hex_to_buf("deadbeefcafebabe1122334455667788")
    let sealed = srtp_seal_packet(tx, hdr, 12, pt[0], pt[1])
    let buf = sealed[0]
    let n   = sealed[1]
    // Tag is the LAST 10 bytes of the sealed buffer. Flip a bit in
    // tag byte 0.
    let tag_off = n - SRTP_AUTH_TAG_LEN
    store8(buf + tag_off, int_xor(load8(buf + tag_off), 1))
    let result = srtp_open_packet(rx, buf, n, 12)
    ce_eq("tampered tag -> SRTP_AUTH_FAIL", result, SRTP_AUTH_FAIL)
    ce_eq("tampered tag bumps auth_fail counter",
          srtp_state_stats_auth_fail(rx), 1)
    // Replay window did NOT advance.
    ce_eq("tampered tag does NOT advance window",
          srtp_state_packet_index(rx), 0)
}

fn test_tamper_flip_ct_byte() {
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let hdr = _ts_build_rtp_header()
    let pt = _ts_hex_to_buf("deadbeefcafebabe1122334455667788")
    let sealed = srtp_seal_packet(tx, hdr, 12, pt[0], pt[1])
    let buf = sealed[0]
    let n   = sealed[1]
    // Flip a byte in the ciphertext (sealed[hdr_n + 0]).
    let ct_off = 12
    store8(buf + ct_off, int_xor(load8(buf + ct_off), 16))
    let result = srtp_open_packet(rx, buf, n, 12)
    ce_eq("tampered ciphertext -> SRTP_AUTH_FAIL (HMAC is over ct)",
          result, SRTP_AUTH_FAIL)
    ce_eq("tampered ct bumps auth_fail counter",
          srtp_state_stats_auth_fail(rx), 1)
}

fn test_tamper_flip_header_byte() {
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let hdr = _ts_build_rtp_header()
    let pt = _ts_hex_to_buf("deadbeefcafebabe1122334455667788")
    let sealed = srtp_seal_packet(tx, hdr, 12, pt[0], pt[1])
    let buf = sealed[0]
    let n   = sealed[1]
    // Flip a byte in the RTP header (e.g. timestamp byte at offset 7).
    store8(buf + 7, int_xor(load8(buf + 7), 64))
    let result = srtp_open_packet(rx, buf, n, 12)
    ce_eq("tampered header -> SRTP_AUTH_FAIL (HMAC is over header too)",
          result, SRTP_AUTH_FAIL)
}

// ----------------------------------------------------------------------------
//                          Anti-replay
// ----------------------------------------------------------------------------

fn test_replay_same_packet_rejected() {
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let hdr = _ts_build_rtp_header()
    let pt = _ts_hex_to_buf("ab" + "ab" + "ab" + "ab" + "ab" + "ab" + "ab" + "ab")
    let sealed = srtp_seal_packet(tx, hdr, 12, pt[0], pt[1])
    let buf = sealed[0]
    let n   = sealed[1]
    // First open succeeds.
    let r1 = srtp_open_packet(rx, buf, n, 12)
    ce_check("first delivery opens OK", r1 != SRTP_AUTH_FAIL)
    ce_check("first delivery not REPLAY", r1 != SRTP_REPLAY)
    // Build an independent copy of the sealed bytes so the buffer isn't
    // aliased (the open path reads buf -- if we just passed it again
    // its contents are unchanged; the REPLAY rejection is purely about
    // state, not buffer content).
    let r2 = srtp_open_packet(rx, buf, n, 12)
    ce_eq("replay of same packet_index -> SRTP_REPLAY", r2, SRTP_REPLAY)
    ce_eq("replay bumps replay counter",
          srtp_state_stats_replay(rx), 1)
}

fn test_replay_window_64_jump() {
    // After receiving packet at idx=N, a packet at idx=N+64 must
    // slide the window so far that packet at idx=N is now TOO_OLD.
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let pt = _ts_hex_to_buf("1234567890abcdef")
    // Send + open packet seq=0.
    let hdr0 = _ts_build_rtp_header()
    let s0 = srtp_seal_packet(tx, hdr0, 12, pt[0], pt[1])
    srtp_open_packet(rx, s0[0], s0[1], 12)
    ce_eq("after first packet, hw_index = 0",
          srtp_state_packet_index(rx), 0)
    // Force tx.send_seq to 64 (skipping packets 1..63 -- in a real
    // session some packets get lost, which is exactly the case this
    // test simulates).
    srtp_state_set_send_seq(tx, 64, 0)
    let hdr64 = _ts_build_rtp_header()
    let s64 = srtp_seal_packet(tx, hdr64, 12, pt[0], pt[1])
    let r64 = srtp_open_packet(rx, s64[0], s64[1], 12)
    ce_check("packet at idx=64 opens OK", r64 != SRTP_AUTH_FAIL)
    ce_eq("hw_index advanced to 64", srtp_state_packet_index(rx), 64)
    // Replay packet at idx=0 is now TOO_OLD (delta = 64 >= 64).
    let r0_replay = srtp_open_packet(rx, s0[0], s0[1], 12)
    ce_eq("replay at idx=0 after jump to 64 -> SRTP_TOO_OLD",
          r0_replay, SRTP_TOO_OLD)
    ce_eq("too-old bumps too_old counter",
          srtp_state_stats_too_old(rx), 1)
}

fn test_replay_within_window_accept_higher() {
    // Receive idx=0, idx=5 (out-of-order arrival but within window).
    // Both should succeed; window's high watermark = 5.
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let pt = _ts_hex_to_buf("aabbccddeeff0011")
    // idx=0 first.
    let h0 = _ts_build_rtp_header()
    let p0 = srtp_seal_packet(tx, h0, 12, pt[0], pt[1])
    srtp_open_packet(rx, p0[0], p0[1], 12)
    // Then idx=5 (we set tx.send_seq=5 to jump).
    srtp_state_set_send_seq(tx, 5, 0)
    let h5 = _ts_build_rtp_header()
    let p5 = srtp_seal_packet(tx, h5, 12, pt[0], pt[1])
    let r5 = srtp_open_packet(rx, p5[0], p5[1], 12)
    ce_check("idx=5 after idx=0 opens OK", r5 != SRTP_AUTH_FAIL)
    ce_eq("hw_index advanced to 5", srtp_state_packet_index(rx), 5)
    // Now idx=0 replay should be REPLAY (still within window, bit set).
    let r0_replay = srtp_open_packet(rx, p0[0], p0[1], 12)
    ce_eq("replay of idx=0 within window -> SRTP_REPLAY",
          r0_replay, SRTP_REPLAY)
}

fn test_replay_anti_replay_pre_check_does_not_advance_window() {
    // Tamper -> auth-fail keeps window unchanged.
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let hdr = _ts_build_rtp_header()
    let pt = _ts_hex_to_buf("9988776655443322")
    let s = srtp_seal_packet(tx, hdr, 12, pt[0], pt[1])
    let buf = s[0]
    let n = s[1]
    // Tamper the tag.
    store8(buf + n - 1, int_xor(load8(buf + n - 1), 255))
    let r = srtp_open_packet(rx, buf, n, 12)
    ce_eq("tamper-after-pre-check -> AUTH_FAIL", r, SRTP_AUTH_FAIL)
    ce_eq("tamper does NOT advance window watermark",
          srtp_state_packet_index(rx), 0)
    ce_eq("tamper does NOT increment ROC",
          srtp_state_roc(rx), 0)
}

// ----------------------------------------------------------------------------
//                          ROC rollover (RFC 3711 §3.3.1)
// ----------------------------------------------------------------------------

fn test_roc_send_rollover_at_seq_wrap() {
    // Set send_seq=65534. Seal three packets:
    //   #1: seq=65534, roc=0 -> send_seq becomes 65535
    //   #2: seq=65535, roc=0 -> send_seq wraps to 0, roc -> 1
    //   #3: seq=0,     roc=1 -> send_seq becomes 1
    let tx = _ts_build_state()
    srtp_state_set_send_seq(tx, 65534, 0)
    let pt = _ts_hex_to_buf("0102030405060708")
    // Pkt 1.
    let h1 = _ts_build_rtp_header()
    srtp_seal_packet(tx, h1, 12, pt[0], pt[1])
    ce_eq("after seq=65534, send_seq=65535", srtp_state_send_seq(tx), 65535)
    ce_eq("after seq=65534, send_roc still 0", srtp_state_send_roc(tx), 0)
    // Pkt 2.
    let h2 = _ts_build_rtp_header()
    srtp_seal_packet(tx, h2, 12, pt[0], pt[1])
    ce_eq("after seq=65535, send_seq wraps to 0", srtp_state_send_seq(tx), 0)
    ce_eq("after seq=65535, send_roc = 1", srtp_state_send_roc(tx), 1)
    // Pkt 3.
    let h3 = _ts_build_rtp_header()
    srtp_seal_packet(tx, h3, 12, pt[0], pt[1])
    ce_eq("after seq=0 (new ROC), send_seq=1", srtp_state_send_seq(tx), 1)
    ce_eq("after seq=0 (new ROC), send_roc still 1",
          srtp_state_send_roc(tx), 1)
}

fn test_roc_recv_estimator_at_wrap() {
    // Two peers, one tx state and one rx state. Force tx's send_seq
    // to 65534 and walk through the wrap. The rx state's ROC + LAST_SEQ
    // start at 0; after each successful open, they should reflect the
    // actual ROC of the received packet.
    let tx = _ts_build_state()
    let rx = _ts_build_state()
    let pt = _ts_hex_to_buf("aabbccddeeff")
    // Pkt at seq=65534, roc=0.
    srtp_state_set_send_seq(tx, 65534, 0)
    let h1 = _ts_build_rtp_header()
    let s1 = srtp_seal_packet(tx, h1, 12, pt[0], pt[1])
    // Force rx's last_seq high so estimator considers 65534 same-roc.
    srtp_state_set_recv_roc(rx, 0, 65530)
    let r1 = srtp_open_packet(rx, s1[0], s1[1], 12)
    ce_check("seq=65534 opens at roc=0", r1 != SRTP_AUTH_FAIL)
    ce_eq("rx ROC = 0", srtp_state_roc(rx), 0)
    ce_eq("rx LAST_SEQ = 65534", srtp_state_last_seq(rx), 65534)
    // Pkt at seq=65535, roc=0.
    let h2 = _ts_build_rtp_header()
    let s2 = srtp_seal_packet(tx, h2, 12, pt[0], pt[1])
    let r2 = srtp_open_packet(rx, s2[0], s2[1], 12)
    ce_check("seq=65535 opens at roc=0", r2 != SRTP_AUTH_FAIL)
    ce_eq("rx LAST_SEQ = 65535", srtp_state_last_seq(rx), 65535)
    // Pkt at seq=0, roc=1.
    let h3 = _ts_build_rtp_header()
    let s3 = srtp_seal_packet(tx, h3, 12, pt[0], pt[1])
    let r3 = srtp_open_packet(rx, s3[0], s3[1], 12)
    ce_check("seq=0 after wrap opens at roc=1", r3 != SRTP_AUTH_FAIL)
    ce_eq("rx ROC = 1 after wrap", srtp_state_roc(rx), 1)
    ce_eq("rx LAST_SEQ = 0 after wrap", srtp_state_last_seq(rx), 0)
    // Pkt at seq=1, roc=1.
    let h4 = _ts_build_rtp_header()
    let s4 = srtp_seal_packet(tx, h4, 12, pt[0], pt[1])
    let r4 = srtp_open_packet(rx, s4[0], s4[1], 12)
    ce_check("seq=1 after wrap opens at roc=1", r4 != SRTP_AUTH_FAIL)
    ce_eq("rx LAST_SEQ = 1", srtp_state_last_seq(rx), 1)
    ce_eq("rx ROC still 1", srtp_state_roc(rx), 1)
}

fn test_roc_estimator_explicit_cases() {
    // Hammer the _srtp_estimate_packet_index logic directly.
    // Case A: last_seq < 2^15, seq close above -> same ROC.
    let idx_a = _srtp_estimate_packet_index(0, 100, 200)
    ce_eq("estimator: low last_seq, seq slightly above -> roc=0",
          int_shr(idx_a, 16), 0)
    ce_eq("estimator: low last_seq, seq above -> idx low = 200",
          int_and(idx_a, 65535), 200)
    // Case B: last_seq < 2^15, seq far ABOVE (delta > 2^15) means
    // packet is from the PREVIOUS ROC (i.e. it was delayed).
    let idx_b = _srtp_estimate_packet_index(5, 100, 60000)
    ce_eq("estimator: low last_seq, seq way above -> roc=4 (prev)",
          int_shr(idx_b, 16), 4)
    // Case C: last_seq >= 2^15, seq far BELOW (last_seq - 2^15 > seq)
    // means seq is from the NEXT ROC.
    let idx_c = _srtp_estimate_packet_index(5, 65530, 0)
    ce_eq("estimator: high last_seq, seq way below -> roc=6 (next)",
          int_shr(idx_c, 16), 6)
    // Case D: same ROC, sequential.
    let idx_d = _srtp_estimate_packet_index(3, 65530, 65531)
    ce_eq("estimator: sequential at high seq -> same roc",
          int_shr(idx_d, 16), 3)
}

// ----------------------------------------------------------------------------
//                          Helpers + constants
// ----------------------------------------------------------------------------

fn test_constants() {
    ce_eq("SRTP_AUTH_TAG_LEN = 10", SRTP_AUTH_TAG_LEN, 10)
    ce_eq("SRTP_KEY_LEN = 16", SRTP_KEY_LEN, 16)
    ce_eq("SRTP_AUTH_KEY_LEN = 20", SRTP_AUTH_KEY_LEN, 20)
    ce_eq("SRTP_SALT_LEN = 14", SRTP_SALT_LEN, 14)
    ce_eq("SRTP_LABEL_ENCR = 0", SRTP_LABEL_ENCR, 0)
    ce_eq("SRTP_LABEL_AUTH = 1", SRTP_LABEL_AUTH, 1)
    ce_eq("SRTP_LABEL_SALT = 2", SRTP_LABEL_SALT, 2)
    ce_check("SRTP_AUTH_FAIL is negative", SRTP_AUTH_FAIL < 0)
    ce_check("SRTP_REPLAY is negative", SRTP_REPLAY < 0)
    ce_check("SRTP_TOO_OLD is negative", SRTP_TOO_OLD < 0)
    // Distinct failure sentinels (no two are equal).
    ce_check("SRTP_AUTH_FAIL != SRTP_REPLAY", SRTP_AUTH_FAIL != SRTP_REPLAY)
    ce_check("SRTP_REPLAY != SRTP_TOO_OLD", SRTP_REPLAY != SRTP_TOO_OLD)
    ce_check("SRTP_AUTH_FAIL != SRTP_TOO_OLD",
             SRTP_AUTH_FAIL != SRTP_TOO_OLD)
}

fn test_state_init_zero() {
    // Fresh state from arbitrary buffers -- the seq + ROC + window
    // counters start at 0.
    let k = alloc(17)
    let a = alloc(21)
    let s = alloc(15)
    let i = 0
    while i < 16 { store8(k + i, 0); i = i + 1 }
    while i < 20 { store8(a + i, 0); i = i + 1 }
    i = 0
    while i < 14 { store8(s + i, 0); i = i + 1 }
    let state = srtp_state_init(k, a, s, 0)
    ce_eq("init ROC = 0", srtp_state_roc(state), 0)
    ce_eq("init last_seq = 0", srtp_state_last_seq(state), 0)
    ce_eq("init send_seq = 0", srtp_state_send_seq(state), 0)
    ce_eq("init send_roc = 0", srtp_state_send_roc(state), 0)
    ce_eq("init hw_index = 0", srtp_state_packet_index(state), 0)
    ce_eq("init replay_mask = 0", srtp_state_replay_mask(state), 0)
    ce_eq("init stats_seal = 0", srtp_state_stats_seal(state), 0)
    ce_eq("init stats_open = 0", srtp_state_stats_open(state), 0)
    ce_eq("init stats_auth_fail = 0",
          srtp_state_stats_auth_fail(state), 0)
    ce_eq("init stats_replay = 0", srtp_state_stats_replay(state), 0)
    ce_eq("init stats_too_old = 0", srtp_state_stats_too_old(state), 0)
}

// ----------------------------------------------------------------------------
//                          Run
// ----------------------------------------------------------------------------

fn main() {
    // SHA-1 KATs
    test_sha1_abc()
    test_sha1_empty()
    test_sha1_fips_appendix_b2()
    test_sha1_block_boundary_55()
    // HMAC-SHA1 RFC 2202
    test_hmac_sha1_rfc2202_tc1()
    test_hmac_sha1_rfc2202_tc2()
    test_hmac_sha1_rfc2202_tc4()
    test_hmac_sha1_long_key_normalization()
    // AES-CM
    test_aes_cm_zero_input()
    test_aes_cm_counter_crosses_blocks()
    test_aes_cm_ssrc_xor_into_iv()
    test_aes_cm_packet_index_xor_into_iv()
    test_srtp_encrypt_decrypt_round_trip()
    // SRTP KDF
    test_srtp_kdf_rfc3711_appendix_b3_encr()
    test_srtp_kdf_rfc3711_appendix_b3_auth()
    test_srtp_kdf_rfc3711_appendix_b3_salt()
    test_srtp_derive_keys_b3()
    // Authenticator
    test_srtp_authenticate_tag_is_10_bytes()
    test_srtp_authenticate_roc_changes_tag()
    // Seal + open
    test_seal_open_roundtrip_basic()
    test_seal_open_multi_packet()
    // Tamper
    test_tamper_flip_tag_byte()
    test_tamper_flip_ct_byte()
    test_tamper_flip_header_byte()
    // Anti-replay
    test_replay_same_packet_rejected()
    test_replay_window_64_jump()
    test_replay_within_window_accept_higher()
    test_replay_anti_replay_pre_check_does_not_advance_window()
    // ROC rollover
    test_roc_send_rollover_at_seq_wrap()
    test_roc_recv_estimator_at_wrap()
    test_roc_estimator_explicit_cases()
    // Constants + state init
    test_constants()
    test_state_init_zero()
    ce_summary("srtp")
}

main()
