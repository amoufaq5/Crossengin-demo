// Unit tests for src/learning/internet_fetch.nova
// Verifies the whitelist gate, in-flight + per-domain + hourly rate limits,
// content validation, ingestion as tiered fetched evidence, and cache hits
// bypassing the limiter. ADR-0028, ADR-0029.

import "../ce_test.nova"
import "../../src/learning/internet_fetch.nova"

fn build() {
    let wl = sw_new()
    sw_add(wl, "en.wikipedia.org")
    let sa = sa_new()
    sa_register(sa, "en.wikipedia.org", SA_TIER_B, SA_NEUTRAL)
    return if_fetcher_new(wl, sa)
}

fn test_whitelist_gate() {
    let f = build()
    ce_eq("off-whitelist denied", if_permit(f, "https://evil.com/x", 0), FETCH_DENIED_HOST)
    ce_eq("whitelisted permitted", if_permit(f, "https://en.wikipedia.org/wiki/A", 0), FETCH_OK)
}

fn test_rate_limits() {
    let f = build()
    // First permit OK and now in-flight.
    ce_eq("first ok", if_permit(f, "https://en.wikipedia.org/a", 0), FETCH_OK)
    ce_eq("in-flight", if_in_flight(f), 1)
    // A second request while one is in-flight is rate-limited.
    ce_eq("in-flight blocks", if_permit(f, "https://en.wikipedia.org/b", 10), FETCH_RATE_LIMITED)
    if_complete(f)
    // Same domain within 2s is rate-limited; after spacing it is allowed.
    ce_eq("domain spacing blocks", if_permit(f, "https://en.wikipedia.org/c", 1), FETCH_RATE_LIMITED)
    ce_eq("after spacing ok", if_permit(f, "https://en.wikipedia.org/c", 5), FETCH_OK)
    if_complete(f)
}

fn test_hourly_cap() {
    let f = build()
    // 30 spaced, completed requests within the hour fill the global budget.
    let i = 0
    while i < IF_MAX_PER_HOUR {
        if_permit(f, "https://en.wikipedia.org/p", i * 3)
        if_complete(f)
        i = i + 1
    }
    ce_eq("count at cap", if_request_count(f), IF_MAX_PER_HOUR)
    ce_eq("31st rate-limited", if_permit(f, "https://en.wikipedia.org/p", IF_MAX_PER_HOUR * 3), FETCH_RATE_LIMITED)
}

fn test_validation() {
    ce_eq("html ok", if_validate("text/html", 1000), 1)
    ce_eq("json ok", if_validate("application/json", 1000), 1)
    ce_eq("plain ok", if_validate("text/plain", 1000), 1)
    ce_eq("disallowed type", if_validate("application/octet-stream", 1000), 0)
    ce_eq("too big", if_validate("text/html", IF_MAX_BYTES + 1), 0)
}

fn test_ingest_and_cache() {
    let f = build()
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "med")
    let a = if_ingest(f, med, "https://en.wikipedia.org/wiki/Aspirin", "text/html", "aspirin is a drug", 17, 100)
    ce_check("atom ingested", a != 0)
    ce_eq("provenance fetched", if_is_fetched(a), 1)
    ce_eq("source tier B recorded", atom_payload_get(a, "source_tier"), SA_TIER_B)
    // Tier-B increment (+1.5) added to alpha: mean = 2.5/3.5 = 0.714.
    ce_eq("tiered evidence applied", atom_confidence(a), 714)
    // Invalid content is not ingested.
    ce_eq("invalid not ingested", if_ingest(f, med, "https://en.wikipedia.org/x", "image/png", "...", 10, 100), 0)
    // The ingested URL is cached -> a later permit is a cache hit (bypasses limiter).
    ce_eq("cache hit", if_permit(f, "https://en.wikipedia.org/wiki/Aspirin", 200), FETCH_CACHE_HIT)
}

// ---- if_fetch composer tests (R39B / NOVA enhancement #11) --------------
//
// We can exercise three branches without a live socket:
//   1. Denied gate (whitelist rejects)
//   2. Rate-limited gate
//   3. Cache hit short-circuits
// The HTTP transport leg itself (real recv) is covered by
// scenario_j_http_client.sh (loopback python http.server).

fn test_if_fetch_denies_off_whitelist() {
    let f = build()
    let r = if_fetch(f, 0, "https://evil.invalid/x", 100)
    ce_eq("denied tag",     if_fetch_tag(r), FETCH_DENIED_HOST)
    ce_eq("no status",      if_fetch_status(r), 0)
    ce_eq("no bytes",       if_fetch_bytes(r), 0)
    ce_str_eq("empty body", if_fetch_body(r), "")
}

fn test_if_fetch_returns_cache_hit() {
    let f = build()
    // Seed the cache.
    if_cache_put(f, "https://en.wikipedia.org/wiki/Aspirin", "CACHED_BODY", IF_TTL_DEFAULT, 50)
    let r = if_fetch(f, 0, "https://en.wikipedia.org/wiki/Aspirin", 100)
    ce_eq    ("cache hit tag",    if_fetch_tag(r), FETCH_CACHE_HIT)
    ce_str_eq("cached body",      if_fetch_body(r), "CACHED_BODY")
    ce_eq    ("bytes recorded",   if_fetch_bytes(r), 11)
}

fn test_if_fetch_rate_limited_inflight() {
    let f = build()
    // First permit -> OK + in-flight.
    ce_eq("first ok", if_permit(f, "https://en.wikipedia.org/a", 0), FETCH_OK)
    // Second if_fetch attempt should be rate-limited (in-flight blocks).
    let r = if_fetch(f, 0, "https://en.wikipedia.org/b", 0)
    ce_eq("rl tag", if_fetch_tag(r), FETCH_RATE_LIMITED)
    if_complete(f)
}

// 2MB content limit: a body of size > IF_MAX_BYTES fails if_validate, which
// the composer surfaces as FETCH_INVALID. We exercise the validator (the
// transport leg's HTTP_ERR_TOO_LARGE -> IF_ERR_HTTP_OVERSIZE mapping is
// covered in test_http_client.nova's sentinels assertion).
fn test_if_fetch_validation_caps_at_2mb() {
    ce_eq("at boundary ok",  if_validate("text/html", IF_MAX_BYTES), 1)
    ce_eq("over boundary",   if_validate("text/html", IF_MAX_BYTES + 1), 0)
}

// New IF_ERR_HTTP_* sentinels must be distinct from FETCH_* gate tags.
fn test_if_err_sentinels_non_colliding() {
    ce_check("err connect != ok",        IF_ERR_HTTP_CONNECT != FETCH_OK)
    ce_check("err timeout != denied",    IF_ERR_HTTP_TIMEOUT != FETCH_DENIED_HOST)
    ce_check("err parse != rl",          IF_ERR_HTTP_PARSE != FETCH_RATE_LIMITED)
    ce_check("err oversize != invalid",  IF_ERR_HTTP_OVERSIZE != FETCH_INVALID)
    ce_check("err scheme != cache hit",  IF_ERR_HTTP_SCHEME != FETCH_CACHE_HIT)
}

fn main() {
    test_whitelist_gate()
    test_rate_limits()
    test_hourly_cap()
    test_validation()
    test_ingest_and_cache()
    test_if_fetch_denies_off_whitelist()
    test_if_fetch_returns_cache_hit()
    test_if_fetch_rate_limited_inflight()
    test_if_fetch_validation_caps_at_2mb()
    test_if_err_sentinels_non_colliding()
    ce_summary("internet_fetch")
}

main()
