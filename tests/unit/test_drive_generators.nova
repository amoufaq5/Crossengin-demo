// Unit tests for src/parts/goals/drive_generators.nova
// Verifies each of the four drives' trigger thresholds, the goals they spawn
// (priority + provenance), and the combined generation pass. ADR-0033.

import "../ce_test.nova"
import "../../src/parts/goals/drive_generators.nova"

fn test_curiosity() {
    let e = goal_engine_new()
    // Below the gap threshold -> no goal.
    ce_eq("small gap -> none", drive_curiosity(e, 200, 1000, 0), -1)
    // Above threshold -> goal at priority gap*novelty.
    let g = drive_curiosity(e, 800, 500, 0)
    ce_check("spawned", g != -1)
    ce_eq("priority gap*novelty", goal_priority(e, g), 400)
}

fn test_social_task_homeostasis() {
    let e = goal_engine_new()
    ce_eq("recent interaction -> none", drive_social(e, 100, 0), -1)
    let s = drive_social(e, 700, 0)
    ce_check("social spawned", s != -1)
    ce_eq("social priority from wait", goal_priority(e, s), 700)

    ce_eq("no pending -> none", drive_task(e, 0, 0), -1)
    let t = drive_task(e, 3, 0)
    ce_check("task spawned", t != -1)
    ce_eq("task high priority", goal_priority(e, t), 900)

    // Homeostasis: low valence triggers a restorative goal.
    let h = drive_homeostasis(e, 200, 0, 0)
    ce_check("homeostasis on distress", h != -1)
    // Content valence + low load -> nothing.
    ce_eq("calm -> none", drive_homeostasis(e, 700, 300, 0), -1)
    // High memory load triggers consolidation.
    ce_check("homeostasis on load", drive_homeostasis(e, 700, 900, 0) != -1)
}

fn test_generate_all() {
    let e = goal_engine_new()
    // Curiosity (gap 800), social (wait 700), task (2 pending), homeostasis
    // (valence 200) all fire -> 4 goals.
    let n = drive_generate_all(e, 800, 1000, 700, 2, 200, 0, 0)
    ce_eq("four drives fire", n, 4)
    ce_eq("four goals", goal_count(e), 4)
    // Nothing crossing thresholds -> 0.
    let e2 = goal_engine_new()
    ce_eq("none fire", drive_generate_all(e2, 100, 1000, 100, 0, 700, 100, 0), 0)
}

fn main() {
    test_curiosity()
    test_social_task_homeostasis()
    test_generate_all()
    ce_summary("drive_generators")
}

main()
