// Unit tests for src/persona/persona.nova (ADR-0102).

import "../ce_test.nova"
import "../../src/persona/persona.nova"

fn test_new_shape_defaults() {
    let p = persona_new("alice", "Alice", "learn + assist", 100)
    ce_eq("user_id", persona_user_id(p), "alice")
    ce_eq("name", persona_name(p), "Alice")
    ce_eq("purpose", persona_purpose(p), "learn + assist")
    ce_eq("empty values list", len(persona_values(p)), 0)
    // OCEAN defaults to 500 across the board.
    let o = persona_ocean(p)
    ce_eq("ocean O default", o[0], 500)
    ce_eq("ocean C default", o[1], 500)
    ce_eq("ocean E default", o[2], 500)
    ce_eq("ocean A default", o[3], 500)
    ce_eq("ocean N default", o[4], 500)
    // Emotion neutral.
    ce_eq("valence 0", persona_valence(p), 0)
    ce_eq("arousal 300", persona_arousal(p), 300)
    ce_eq("focus empty", persona_focus(p), "")
    // Risk centred.
    ce_eq("risk tolerance 500", persona_risk_tolerance(p), 500)
    // History / prefs / reflection empty.
    ce_eq("history empty", persona_history_count(p), 0)
    ce_eq("prefs empty",   persona_preferences_count(p), 0)
    ce_eq("refl empty",    persona_reflection_count(p), 0)
    ce_eq("style ref empty", persona_style_capsule(p), "")
    ce_eq("created_at", persona_created_at(p), 100)
    ce_eq("updated_at", persona_updated_at(p), 100)
}

fn test_identity_mutation_updates_updated_at() {
    let p = persona_new("bob", "Bob", "p1", 100)
    persona_set_identity(p, "Robert", "p2", 200)
    ce_eq("name updated", persona_name(p), "Robert")
    ce_eq("purpose updated", persona_purpose(p), "p2")
    ce_eq("updated_at bumped", persona_updated_at(p), 200)
}

fn test_add_value_idempotent() {
    let p = persona_new("u", "U", "", 100)
    ce_eq("first add", persona_add_value(p, "honesty", 110), 1)
    ce_eq("dup add", persona_add_value(p, "honesty", 120), 0)
    ce_eq("second unique", persona_add_value(p, "curiosity", 130), 1)
    ce_eq("value count 2", len(persona_values(p)), 2)
}

fn test_ocean_bounds_enforced() {
    let p = persona_new("u", "U", "", 100)
    // Values outside 0..1000 get clamped.
    persona_set_ocean(p, 0 - 100, 500, 1500, 999, 0)
    let o = persona_ocean(p)
    ce_eq("O clamped to 0", o[0], 0)
    ce_eq("C in range", o[1], 500)
    ce_eq("E clamped to 1000", o[2], 1000)
    ce_eq("A in range", o[3], 999)
    ce_eq("N in range", o[4], 0)
}

fn test_emotion_signed_valence_bounds() {
    let p = persona_new("u", "U", "", 100)
    // Valence is signed -1000..+1000; arousal 0..1000.
    persona_set_emotion(p, 0 - 500, 800, "focused", 200)
    ce_eq("valence -500", persona_valence(p), 0 - 500)
    ce_eq("arousal 800", persona_arousal(p), 800)
    ce_eq("focus set", persona_focus(p), "focused")
    ce_eq("updated_at bumped", persona_updated_at(p), 200)
    // Out-of-bounds clamped.
    persona_set_emotion(p, 0 - 5000, 5000, "", 300)
    ce_eq("valence clamped to -1000", persona_valence(p), 0 - 1000)
    ce_eq("arousal clamped to 1000", persona_arousal(p), 1000)
}

fn test_risk_bounds() {
    let p = persona_new("u", "U", "", 100)
    persona_set_risk(p, 700, 300, 1200, 200)
    ce_eq("tolerance 700", persona_risk_tolerance(p), 700)
    let rk = persona_risk(p)
    ce_eq("loss_aversion 300", rk[1], 300)
    ce_eq("uncertainty appetite clamped to 1000", rk[2], 1000)
}

fn test_add_decision_appends() {
    let p = persona_new("u", "U", "", 100)
    let i0 = persona_add_decision(p, "install medicine capsule", "yes", 600, "src:user:u", 110)
    let i1 = persona_add_decision(p, "delete old logs", "no", 0 - 200, "src:user:u", 120)
    ce_eq("first index 0", i0, 0)
    ce_eq("second index 1", i1, 1)
    ce_eq("history count 2", persona_history_count(p), 2)
    let d0 = persona_history(p)[0]
    ce_eq("d0 moment", d0[PER_DEC_MOMENT], 110)
    ce_eq("d0 chosen", d0[PER_DEC_CHOSEN], "yes")
    ce_eq("d0 pred valence", d0[PER_DEC_PRED_VALENCE], 600)
    ce_eq("d0 actual is 0 (unknown)", d0[PER_DEC_ACTUAL], 0)
    ce_eq("d0 not retracted", d0[PER_DEC_RETRACTED], 0)
}

fn test_update_decision_outcome() {
    let p = persona_new("u", "U", "", 100)
    let i = persona_add_decision(p, "prop", "yes", 500, "src:user:u", 110)
    ce_eq("update ok", persona_update_decision_outcome(p, i, 800, 900, 200), 1)
    let d = persona_history(p)[i]
    ce_eq("actual set", d[PER_DEC_ACTUAL], 800)
    ce_eq("satisfaction clamped", d[PER_DEC_SATISFACTION], 900)
    ce_eq("bad index rejected", persona_update_decision_outcome(p, 999, 0, 0, 300), 0)
}

fn test_retract_decision_preserves_record() {
    let p = persona_new("u", "U", "", 100)
    let i = persona_add_decision(p, "prop", "yes", 500, "src:user:u", 110)
    ce_eq("retract ok", persona_retract_decision(p, i, 200), 1)
    // Record still present in history.
    ce_eq("history still count 1", persona_history_count(p), 1)
    let d = persona_history(p)[i]
    ce_eq("marker set", d[PER_DEC_RETRACTED], 1)
    ce_eq("original moment preserved", d[PER_DEC_MOMENT], 110)
}

fn test_preferences_add_or_update() {
    let p = persona_new("u", "U", "", 100)
    ce_eq("new pref returns 1", persona_add_preference(p, "concise_answers", 700, "src:user:u", 110), 1)
    ce_eq("second unique pref returns 1", persona_add_preference(p, "cite_sources", 800, "src:user:u", 120), 1)
    ce_eq("pref count 2", persona_preferences_count(p), 2)
    // Re-stating same label -> update (return 2), NOT append.
    ce_eq("re-state returns 2", persona_add_preference(p, "concise_answers", 900, "src:user:u", 130), 2)
    ce_eq("pref count still 2", persona_preferences_count(p), 2)
    let pr = persona_find_preference(p, "concise_answers")
    ce_check("found", pr != 0)
    ce_eq("weight updated", pr[PER_PREF_WEIGHT], 900)
    ce_eq("moment_first preserved", pr[PER_PREF_MOMENT_1ST], 110)
    ce_eq("moment_last bumped", pr[PER_PREF_MOMENT_LST], 130)
    ce_eq("count = 2", pr[PER_PREF_COUNT], 2)
}

fn test_preference_weight_bounds() {
    let p = persona_new("u", "U", "", 100)
    persona_add_preference(p, "over_positive", 5000, "src:x", 110)
    persona_add_preference(p, "over_negative", 0 - 5000, "src:x", 120)
    ce_eq("+ clamped to 1000",
          persona_find_preference(p, "over_positive")[PER_PREF_WEIGHT], 1000)
    ce_eq("- clamped to -1000",
          persona_find_preference(p, "over_negative")[PER_PREF_WEIGHT], 0 - 1000)
}

fn test_empty_pref_label_rejected() {
    let p = persona_new("u", "U", "", 100)
    ce_eq("empty label returns 0", persona_add_preference(p, "", 500, "src:x", 110), 0)
    ce_eq("no pref added", persona_preferences_count(p), 0)
}

fn test_reflection_append_only() {
    let p = persona_new("u", "U", "", 100)
    ce_eq("first reflection", persona_add_reflection(p, "user prefers brevity", "src:agent:r", 110), 1)
    ce_eq("second reflection", persona_add_reflection(p, "user disliked formal register on Monday", "src:agent:r", 120), 1)
    ce_eq("reflection count 2", persona_reflection_count(p), 2)
    let r0 = persona_reflection(p)[0]
    ce_eq("r0 moment", r0[PER_REFL_MOMENT], 110)
    ce_eq("r0 text", r0[PER_REFL_TEXT], "user prefers brevity")
    ce_eq("empty text rejected", persona_add_reflection(p, "", "src:x", 130), 0)
}

fn test_style_capsule_ref() {
    let p = persona_new("u", "U", "", 100)
    ce_eq("style ref starts empty", persona_style_capsule(p), "")
    persona_set_style_capsule(p, "academic-formal-v1", 200)
    ce_eq("style ref set", persona_style_capsule(p), "academic-formal-v1")
    ce_eq("updated_at bumped", persona_updated_at(p), 200)
    persona_set_style_capsule(p, "", 300)
    ce_eq("style ref cleared", persona_style_capsule(p), "")
}

fn test_from_soul_migration() {
    // Build persona seeded with soul fields the caller can supply.
    let p = persona_from_soul_fields("alice", "Alice", "assist + learn",
                                     700, 600, 400, 800, 300, 100)
    ce_eq("name from soul", persona_name(p), "Alice")
    ce_eq("purpose from soul", persona_purpose(p), "assist + learn")
    ce_eq("ocean O from soul", persona_ocean(p)[0], 700)
    ce_eq("ocean N from soul", persona_ocean(p)[4], 300)
    ce_eq("history empty", persona_history_count(p), 0)
}

fn main() {
    test_new_shape_defaults()
    test_identity_mutation_updates_updated_at()
    test_add_value_idempotent()
    test_ocean_bounds_enforced()
    test_emotion_signed_valence_bounds()
    test_risk_bounds()
    test_add_decision_appends()
    test_update_decision_outcome()
    test_retract_decision_preserves_record()
    test_preferences_add_or_update()
    test_preference_weight_bounds()
    test_empty_pref_label_rejected()
    test_reflection_append_only()
    test_style_capsule_ref()
    test_from_soul_migration()
    ce_summary("persona")
}

main()
