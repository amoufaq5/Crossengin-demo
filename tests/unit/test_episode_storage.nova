// Unit tests for src/parts/episodic/episode_storage.nova
// Verifies episode recording, geometric decay, recall reinforcement (capped),
// drop of weak non-consolidated episodes (consolidated survive), and replay
// prioritization. ADR-0022.

import "../ce_test.nova"
import "../../src/parts/episodic/episode_storage.nova"

fn test_record_and_access() {
    let em = em_new()
    let e = em_record(em, 0, 800, 5)
    ce_eq("id 0", episode_id(e), 0)
    ce_eq("moment ref", episode_moment(e), 0)
    ce_eq("salience", episode_salience(e), 800)
    ce_eq("init strength", episode_strength(e), EP_STRENGTH_INIT)
    ce_eq("recent tier", episode_tier(e), EP_RECENT)
    ce_eq("count 1", em_count(em), 1)
    ce_eq("recent count 1", em_count_recent(em), 1)
}

fn test_decay_and_reinforce() {
    let em = em_new()
    let e = em_record(em, 0, 1000, 0)
    episode_decay(e, 500)   // 1.0 * 0.5 = 0.5
    ce_eq("decayed", episode_strength(e), 500)
    episode_reinforce(e, 1) // +0.3 = 0.8
    ce_eq("reinforced", episode_strength(e), 800)
    ce_eq("last access updated", episode_last_access(e), 1)
    // Reinforcement caps at 1.0.
    episode_reinforce(e, 2); episode_reinforce(e, 3)
    ce_eq("capped at 1.0", episode_strength(e), 1000)
}

fn test_drop_sweep() {
    let em = em_new()
    let weak = em_record(em, 0, 500, 0)
    let strong = em_record(em, 1, 500, 0)
    let saved = em_record(em, 2, 500, 0)
    // Decay weak below the drop floor; consolidate one so it survives.
    episode_decay(weak, 10)        // 1.0 * 0.01 = 0.01 < 0.05
    episode_decay(saved, 10)
    em_consolidate(em, episode_id(saved))
    let dropped = em_drop_sweep(em)
    ce_eq("one dropped", dropped, 1)
    ce_eq("weak dropped", episode_tier(weak), EP_DROPPED)
    ce_eq("strong survives", episode_tier(strong), EP_RECENT)
    ce_eq("consolidated survives despite weakness", episode_tier(saved), EP_CONSOLIDATED)
}

fn test_recall_and_replay() {
    let em = em_new()
    em_record(em, 10, 400, 0)
    let target = em_record(em, 20, 900, 0)
    episode_decay(target, 500)   // strength 0.5
    // Recall by moment reinforces.
    let r = em_recall(em, 20, 7)
    ce_check("recalled", r != 0)
    ce_eq("recall reinforced", episode_strength(target), 800)   // 0.5 + 0.3
    ce_eq("recall miss -> 0", em_recall(em, 999, 8), 0)
    // Replay favors strength*salience: target (0.8*0.9=0.72) beats other (1.0*0.4=0.4).
    ce_eq("top replay is salient strong one", episode_moment(em_top_replay(em)), 20)
}

fn main() {
    test_record_and_access()
    test_decay_and_reinforce()
    test_drop_sweep()
    test_recall_and_replay()
    ce_summary("episode_storage")
}

main()
