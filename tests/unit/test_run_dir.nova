// Audit F-24: ce_run_dir() must only accept a private (0700) directory.
// ce_dir_is_private is the check; a 0755 directory, a regular file and a
// missing path are all refused.

import "../ce_test.nova"
import "../../src/util/run_dir.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn main() {
    let base = "/tmp/ce_test_run_dir_" + int_to_str(getpid())
    let priv = base + "_priv"
    let open = base + "_open"
    sys_mkdir(priv, 448)        // 0700
    sys_mkdir(open, 493)        // 0755
    ce_eq("0700 dir accepted", ce_dir_is_private(priv), 1)
    ce_eq("0755 dir refused", ce_dir_is_private(open), 0)
    let f = base + "_file"
    let fd = sys_open(f, 577, 384)
    sys_close(fd)
    ce_eq("regular file refused", ce_dir_is_private(f), 0)
    ce_eq("missing path refused", ce_dir_is_private(base + "_missing"), 0)
    // ce_run_path joins under the resolved dir.
    let p = ce_run_path("x.txt")
    ce_check("ce_run_path ends with /x.txt", str_ends_with(p, "/x.txt") == 1)
    ce_check("resolved run dir is private or explicit",
             ce_dir_is_private(ce_run_dir()) == 1 || len(_ce_env("CE_RUN_DIR")) > 0)
    sys_unlink(f)
    ce_summary("run_dir")
}

main()
