// Audit F-24: ce_run_dir() must only accept a private directory: a real
// directory (not a symlink), owned by our effective uid, mode 0700.
// ce_dir_is_private is the check; a 0755 directory, a symlink to a 0700
// directory, a directory owned by someone else (root-only case), a regular
// file and a missing path are all refused.

import "../ce_test.nova"
import "../../src/util/run_dir.nova"
import "std/syscall"
import "std/string"
import "std/io"

// symlink(2) / chown(2), test-only. Paths tag-polymorphic, ids tagged.
fn _t_symlink(target, linkpath) {
    asm {
        "mov rax, 88"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .trd_sl0"
        "sar rdi, 1"
        ".trd_sl0:"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .trd_sl1"
        "sar rsi, 1"
        ".trd_sl1:"
        "syscall"
        "test rax, rax"
        "js .trd_slr"
        "lea rax, [rax + rax + 1]"
        ".trd_slr:"
    }
}

fn _t_chown(path, uid, gid) {
    asm {
        "mov rax, 92"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .trd_ch0"
        "sar rdi, 1"
        ".trd_ch0:"
        "mov rsi, [rbp-16]"
        "sar rsi, 1"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
        "test rax, rax"
        "js .trd_chr"
        "lea rax, [rax + rax + 1]"
        ".trd_chr:"
    }
}

// mkdir then an explicit fchmod, so the process umask cannot change the
// mode under test.
fn _mkdir_mode(d, mode) {
    sys_mkdir(d, 448)
    let fd = sys_open(d, 65536, 0)
    if fd < 0 { return -1 }
    let r = ce_fchmod(fd, mode)
    sys_close(fd)
    return r
}

fn main() {
    let base = "/tmp/ce_test_run_dir_" + int_to_str(getpid())
    let priv = base + "_priv"
    let open = base + "_open"
    let link = base + "_link"
    let foreign = base + "_foreign"
    ce_eq("chmod 0700", _mkdir_mode(priv, 448), 0)
    ce_eq("chmod 0755", _mkdir_mode(open, 493), 0)
    ce_eq("0700 dir accepted", ce_dir_is_private(priv), 1)
    ce_eq("0755 dir refused", ce_dir_is_private(open), 0)

    ce_eq("symlink created", _t_symlink(priv, link), 0)
    ce_eq("symlink to a 0700 dir refused", ce_dir_is_private(link), 0)

    // Root can open any 0700 directory, so ownership must be checked too.
    // Only root can hand a directory to another uid; skip otherwise.
    _mkdir_mode(foreign, 448)
    if _ce_geteuid() == 0 {
        ce_eq("chown to nobody", _t_chown(foreign, 65534, 65534), 0)
        ce_eq("0700 dir owned by another uid refused", ce_dir_is_private(foreign), 0)
    }

    let f = base + "_file"
    let fd = sys_open(f, 577, 384)
    sys_close(fd)
    ce_eq("regular file refused", ce_dir_is_private(f), 0)
    ce_eq("missing path refused", ce_dir_is_private(base + "_missing"), 0)

    // ce_run_path joins under the resolved dir.
    let p = ce_run_path("x.txt")
    ce_check("ce_run_path ends with /x.txt", str_ends_with(p, "/x.txt") == 1)

    sys_unlink(f)
    sys_unlink(link)
    ce_eq("rmdir priv", ce_rmdir(priv), 0)
    ce_eq("rmdir open", ce_rmdir(open), 0)
    ce_rmdir(foreign)
    ce_summary("run_dir")
}

main()
