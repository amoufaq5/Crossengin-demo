// CE_TEST_TIMEOUT: 240
// PR 4d review follow-up: a trust point matched by KEY must take its
// constraints from the TRUSTED anchor record, not from the presented copy
// (whose own signature is never checked). Fixtures (openssl 3):
//   R0  root with pathLen:0        -> I0 -> l3.example
//   RNK root without keyCertSign   -> IN -> l4.example
//   RX  root valid for one day     -> IX -> l5.example
//   R0F / RNKF / RXF: forged "roots" carrying the real root's subject and
//   PUBLIC KEY with relaxed fields (no pathLen, keyCertSign, ten years),
//   signed by an unrelated key (openssl x509 -force_pubkey).
//   peer.example: a self-signed CA:FALSE federation-style peer cert;
//   peer_other: the same key re-self-signed with SAN other.example.
// Every forged path was accepted before the fix; openssl rejects all.

import "../ce_test.nova"
import "../../src/safety/x509_verify.nova"
import "../../src/safety/pem_truststore.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

let F_R0 = ""
let F_R0F = ""
let F_I0 = ""
let F_L3 = ""
let F_RNK = ""
let F_RNKF = ""
let F_IN = ""
let F_L4 = ""
let F_RX = ""
let F_RXF = ""
let F_IX = ""
let F_L5 = ""
let F_PEER = ""
let F_PEER_OTHER = ""
let P_R0 = ""
let P_RNK = ""
let P_RX = ""
let P_PEER = ""
let NOW0 = 1794819600    // 2026-11-16 09:00 UTC: everything valid
let LATE = 1795770000    // 2026-11-27 09:00 UTC: RX expired

fn _tp_hv(c) {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn _tp_der(h) {
    let n = int_shr(len(h), 1)
    let b = alloc(n + 1)
    let i = 0
    while i < n {
        store8(b + i, _tp_hv(char_at(h, int_mul(i, 2))) * 16 + _tp_hv(char_at(h, int_mul(i, 2) + 1)))
        i = i + 1
    }
    let p = list_new()
    push(p, b) push(p, n)
    return p
}

fn _tp_anchors(b64) {
    return truststore_load("-----BEGIN CERTIFICATE-----\n" + b64 + "\n-----END CERTIFICATE-----\n")
}

fn _tp_chain3(a, b, c) {
    let l = list_new() push(l, _tp_der(a)) push(l, _tp_der(b))
    if len(c) > 0 { push(l, _tp_der(c)) }
    return l
}

fn _tp(chain, host, anchors, now) { return cert_chain_verify(chain, host, anchors, now)[0] }

fn main() {
    let r0 = _tp_anchors(P_R0)
    let rnk = _tp_anchors(P_RNK)
    let rx = _tp_anchors(P_RX)
    // pathLen:0 root
    ce_eq("R0: root omitted -> not pinned (pathLen 0 forbids I0)", _tp(_tp_chain3(F_L3, F_I0, ""), "l3.example", r0, NOW0), XV_NOT_PINNED)
    ce_eq("R0: real root sent -> not a CA (pathLen)", _tp(_tp_chain3(F_L3, F_I0, F_R0), "l3.example", r0, NOW0), XV_NOT_CA)
    ce_eq("R0F forged copy -> still refused", _tp(_tp_chain3(F_L3, F_I0, F_R0F), "l3.example", r0, NOW0), XV_NOT_CA)
    // no keyCertSign
    ce_eq("RNK: real root sent -> not a CA", _tp(_tp_chain3(F_L4, F_IN, F_RNK), "l4.example", rnk, NOW0), XV_NOT_CA)
    ce_eq("RNKF forged copy -> still refused", _tp(_tp_chain3(F_L4, F_IN, F_RNKF), "l4.example", rnk, NOW0), XV_NOT_CA)
    // expired root
    ce_eq("RX valid: verifies", _tp(_tp_chain3(F_L5, F_IX, F_RX), "l5.example", rx, NOW0), XV_OK)
    ce_eq("RX expired: real root sent -> expired", _tp(_tp_chain3(F_L5, F_IX, F_RX), "l5.example", rx, LATE), XV_EXPIRED)
    ce_eq("RXF forged copy after expiry -> still refused", _tp(_tp_chain3(F_L5, F_IX, F_RXF), "l5.example", rx, LATE), XV_EXPIRED)
    // direct trust in a pinned peer cert uses the anchored cert's names
    let peer = _tp_anchors(P_PEER)
    let p1 = list_new() push(p1, _tp_der(F_PEER))
    ce_eq("pinned peer verifies for its own name", _tp(p1, "peer.example", peer, NOW0), XV_OK)
    let p2 = list_new() push(p2, _tp_der(F_PEER_OTHER))
    ce_eq("same key re-signed for other.example -> refused", _tp(p2, "other.example", peer, NOW0), XV_HOSTNAME)
    ce_summary("trust_point_forgery")
}

main()
