// Unit tests for src/io/transducers/http_client.nova (P1.4 Mode 1 parser layer).
//
// Pure-parser coverage -- no sockets. The full socket round-trip lives in
// tests/integration/scenario_j_http_client.sh which spawns a real
// python http.server. Here we test:
//   * http_parse_url across the matrix (scheme/host/port/path edges)
//   * the malformed-URL paths return the canonical empty record
//   * default-port handling for http and https
//   * http_dns_register + _http_dns_lookup happy path + miss
//   * http_header_get is case-insensitive
//   * http_is_redirect classifies 3xx vs not
//   * the dispatcher in internet_fetch picks the right branch for
//     http://, https://, and a bad URL
//
// Convention: every assertion goes through ce_eq / ce_check / ce_str_eq.
// Target ~15 assertions (we exceed it to cover the full URL matrix).

import "../ce_test.nova"
import "../../src/io/transducers/http_client.nova"
import "../../src/learning/internet_fetch.nova"

fn test_parse_url_full() {
    let r = http_parse_url("http://example.com:8080/path?q=1")
    ce_str_eq("scheme http",  r[0], "http")
    ce_str_eq("host",         r[1], "example.com")
    ce_eq    ("port explicit",r[2], 8080)
    ce_str_eq("path + query", r[3], "/path?q=1")
}

fn test_parse_url_default_port_http() {
    let r = http_parse_url("http://1.2.3.4/x")
    ce_str_eq("scheme http",  r[0], "http")
    ce_str_eq("host ip",      r[1], "1.2.3.4")
    ce_eq    ("port default", r[2], 80)
    ce_str_eq("path",         r[3], "/x")
}

fn test_parse_url_default_port_https() {
    let r = http_parse_url("https://example.com/y")
    ce_str_eq("scheme https", r[0], "https")
    ce_str_eq("host",         r[1], "example.com")
    ce_eq    ("port 443",     r[2], 443)
    ce_str_eq("path",         r[3], "/y")
}

fn test_parse_url_no_path_defaults_to_root() {
    let r = http_parse_url("http://example.com")
    ce_str_eq("scheme",       r[0], "http")
    ce_str_eq("host",         r[1], "example.com")
    ce_eq    ("port default", r[2], 80)
    ce_str_eq("default path", r[3], "/")
}

fn test_parse_url_authority_only_with_port() {
    let r = http_parse_url("http://1.2.3.4:8765")
    ce_str_eq("host",        r[1], "1.2.3.4")
    ce_eq    ("port",        r[2], 8765)
    ce_str_eq("default path",r[3], "/")
}

fn test_parse_url_wrong_scheme_returns_empty_record() {
    // ftp:// is not http(s) -- whole record is the canonical "bad" form.
    let r = http_parse_url("ftp://example.com/foo")
    ce_str_eq("empty scheme", r[0], "")
    ce_str_eq("empty host",   r[1], "")
    ce_eq    ("zero port",    r[2], 0)
    ce_str_eq("empty path",   r[3], "")
}

fn test_parse_url_malformed_returns_empty() {
    let r1 = http_parse_url("not-a-url")
    ce_str_eq("garbage scheme",  r1[0], "")
    let r2 = http_parse_url("")
    ce_str_eq("empty scheme",    r2[0], "")
    // Trailing colon with non-digit port -> bad.
    let r3 = http_parse_url("http://host:abc/")
    ce_str_eq("non-numeric port", r3[0], "")
    // Authority-only with empty host.
    let r4 = http_parse_url("http:///foo")
    ce_str_eq("empty host -> bad", r4[0], "")
}

fn test_dns_register_and_lookup() {
    // Dotted-quad host should bypass the cache entirely.
    let direct = _http_dns_lookup("10.0.0.1")
    ce_str_eq("dotted-quad bypass", direct, "10.0.0.1")
    // Manual registration + lookup (case-insensitive on host).
    http_dns_register("example.test", "203.0.113.7")
    ce_str_eq("registered host", _http_dns_lookup("example.test"), "203.0.113.7")
    ce_str_eq("lookup ci",       _http_dns_lookup("EXAMPLE.TEST"), "203.0.113.7")
    ce_str_eq("miss",            _http_dns_lookup("nope.invalid"), "")
}

fn test_dns_register_rejects_bad_ip() {
    // Refuse non-dotted-quad registrations.
    ce_eq("bad-ip register returns 0", http_dns_register("foo", "not.an.ip"), 0)
    ce_str_eq("not stored", _http_dns_lookup("foo"), "")
}

fn test_header_get_case_insensitive() {
    let h = list_new()
    let a = list_new(); push(a, "Content-Type");    push(a, "text/html")
    let b = list_new(); push(b, "Content-Length");  push(b, "1234")
    push(h, a)
    push(h, b)
    ce_str_eq("ct match",      http_header_get(h, "Content-Type"),   "text/html")
    ce_str_eq("ct ci match",   http_header_get(h, "content-type"),   "text/html")
    ce_str_eq("cl match",      http_header_get(h, "Content-Length"), "1234")
    ce_str_eq("absent -> empty", http_header_get(h, "X-Foo"),        "")
}

fn test_is_redirect_classifies_3xx() {
    ce_eq("301 -> redirect", http_is_redirect(301), 1)
    ce_eq("302 -> redirect", http_is_redirect(302), 1)
    ce_eq("399 -> redirect", http_is_redirect(399), 1)
    ce_eq("200 -> not",      http_is_redirect(200), 0)
    ce_eq("400 -> not",      http_is_redirect(400), 0)
    ce_eq("500 -> not",      http_is_redirect(500), 0)
}

fn test_status_line_parser() {
    ce_eq("200 OK",     _http_status_from_line("HTTP/1.1 200 OK"), 200)
    ce_eq("404 NF",     _http_status_from_line("HTTP/1.1 404 Not Found"), 404)
    ce_eq("301 moved",  _http_status_from_line("HTTP/1.0 301 Moved Permanently"), 301)
    ce_eq("500 ise",    _http_status_from_line("HTTP/1.1 500 Internal Server Error"), 500)
    // No status-text after the code is fine (some servers do this).
    ce_eq("just code",  _http_status_from_line("HTTP/1.1 200"), 200)
    // Bad cases.
    ce_eq("garbage",    _http_status_from_line("XYZZY"), -1)
    ce_eq("too short",  _http_status_from_line("HTTP/"), -1)
    ce_eq("non-numeric",_http_status_from_line("HTTP/1.1 OK 200"), -1)
}

// Multi-value header lookup: real Set-Cookie / Cookie use case. The
// http_header_get "first match" semantics would silently drop the second
// cookie; http_header_get_all preserves wire order.
fn test_header_get_all_multivalue() {
    let h = list_new()
    let a = list_new(); push(a, "Set-Cookie"); push(a, "sid=ABC; Path=/")
    let b = list_new(); push(b, "Set-Cookie"); push(b, "csrf=DEF; Path=/")
    let c = list_new(); push(c, "Content-Type"); push(c, "text/html")
    push(h, a); push(h, b); push(h, c)
    let cookies = http_header_get_all(h, "Set-Cookie")
    ce_eq    ("count",           len(cookies), 2)
    ce_str_eq("first cookie",    cookies[0], "sid=ABC; Path=/")
    ce_str_eq("second cookie",   cookies[1], "csrf=DEF; Path=/")
    // Case-insensitive on name too.
    let cookies_ci = http_header_get_all(h, "SET-COOKIE")
    ce_eq    ("ci count",        len(cookies_ci), 2)
    // Absent header -> empty list.
    let none = http_header_get_all(h, "X-None")
    ce_eq    ("absent empty",    len(none), 0)
}

// Transfer-Encoding: chunked detection. Handles a single token, a comma
// list ("gzip, chunked"), case variants, and the absent case.
fn test_chunked_header_detection() {
    let h = list_new()
    let a = list_new(); push(a, "Transfer-Encoding"); push(a, "chunked")
    push(h, a)
    ce_eq("chunked single", _hc_is_chunked(h), 1)
    let h2 = list_new()
    let b = list_new(); push(b, "Transfer-Encoding"); push(b, "gzip, chunked")
    push(h2, b)
    ce_eq("chunked in list", _hc_is_chunked(h2), 1)
    let h3 = list_new()
    let c = list_new(); push(c, "Transfer-Encoding"); push(c, "CHUNKED")
    push(h3, c)
    ce_eq("chunked ci",     _hc_is_chunked(h3), 1)
    let h4 = list_new()
    let d = list_new(); push(d, "Transfer-Encoding"); push(d, "gzip")
    push(h4, d)
    ce_eq("not chunked",    _hc_is_chunked(h4), 0)
    let h5 = list_new()
    ce_eq("absent",         _hc_is_chunked(h5), 0)
}

// Chunked body dechunk round-trip. RFC 7230 sec 4.1.3 example:
// "4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n"
// -> "Wikipedia in\r\n\r\nchunks."
fn test_chunked_decode_roundtrip() {
    let body = "4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n"
    let r = _hc_chunked_decode(body, len(body), 4096)
    ce_str_eq("decoded body err", r[1], "")
    ce_str_eq("decoded body",     r[0], "Wikipedia in\r\n\r\nchunks.")
}

fn test_chunked_decode_simple() {
    // Two chunks of "Hello" + "World" then last-chunk.
    let body = "5\r\nHello\r\n5\r\nWorld\r\n0\r\n\r\n"
    let r = _hc_chunked_decode(body, len(body), 4096)
    ce_str_eq("hello+world err", r[1], "")
    ce_str_eq("hello+world", r[0], "HelloWorld")
}

fn test_chunked_decode_zero_only() {
    // Empty body via single last-chunk.
    let body = "0\r\n\r\n"
    let r = _hc_chunked_decode(body, len(body), 4096)
    ce_str_eq("zero err",  r[1], "")
    ce_str_eq("zero body", r[0], "")
}

fn test_chunked_decode_malformed() {
    // Missing CRLF after chunk data -> HTTP_ERR_CHUNKED.
    let body = "5\r\nHelloXX0\r\n\r\n"
    let r = _hc_chunked_decode(body, len(body), 4096)
    ce_check("err set", len(r[1]) > 0)
    ce_str_eq("chunked-class err", r[1], HTTP_ERR_CHUNKED)
}

fn test_chunked_decode_oversize() {
    // Chunk larger than the cap -> HTTP_ERR_TOO_LARGE (the recv cap mapping).
    let body = "10\r\n0123456789ABCDEF\r\n0\r\n\r\n"
    let r = _hc_chunked_decode(body, len(body), 8)   // cap is 8 bytes
    ce_str_eq("oversize err", r[1], HTTP_ERR_TOO_LARGE)
}

// Content-Length trimming. A body buffer longer than the declared length
// is trimmed; a Content-Length larger than the buffer is left alone.
fn test_content_length_apply() {
    let h = list_new()
    let a = list_new(); push(a, "Content-Length"); push(a, "5")
    push(h, a)
    ce_str_eq("trim", _hc_apply_content_length(h, "HelloWORLD"), "Hello")
    // Larger CL than body: leave alone (short-read is transport's problem).
    let h2 = list_new()
    let b = list_new(); push(b, "Content-Length"); push(b, "999")
    push(h2, b)
    ce_str_eq("longer cl", _hc_apply_content_length(h2, "Short"), "Short")
    // Absent: passthrough.
    let h3 = list_new()
    ce_str_eq("absent",    _hc_apply_content_length(h3, "Pass"), "Pass")
    // Non-digit value: passthrough (defensive).
    let h4 = list_new()
    let d = list_new(); push(d, "Content-Length"); push(d, "abc")
    push(h4, d)
    ce_str_eq("non-digit", _hc_apply_content_length(h4, "Keep"), "Keep")
}

// Recv timeout: today no `sys_setsockopt` builtin so the seam returns 0
// to advertise the gap. The constant is still pinned so a future builtin
// landing in NOVA will be a single-line flip.
fn test_recv_timeout_documented_gap() {
    ce_eq("timeout ms constant", HTTP_RECV_TIMEOUT_MS, 10000)
    ce_eq("timeout not active",  http_recv_timeout_active(), 0)
    // Calling _hc_set_recv_timeout on a dummy fd should not crash and
    // should return 0 (documented gap signal).
    ce_eq("setsockopt noop",     _hc_set_recv_timeout(-1, 10000), 0)
}

// Response parser end-to-end on a synthetic buffer: status + headers + body.
// Exercises the same _hc_parse_response that the real recv path feeds.
fn test_response_parse_full() {
    let resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\n\r\nhello world"
    let split = _hc_parse_response(resp, len(resp), 4096)
    ce_str_eq("status line", split[0], "HTTP/1.1 200 OK")
    ce_eq    ("status code", _http_status_from_line(split[0]), 200)
    let headers = split[1]
    ce_eq    ("header count",       len(headers), 2)
    ce_str_eq("ct via lookup",      http_header_get(headers, "Content-Type"), "text/plain")
    ce_str_eq("body",               split[2], "hello world")
    ce_str_eq("no parse err",       split[3], "")
}

fn test_response_parse_no_body() {
    let resp = "HTTP/1.1 204 No Content\r\nServer: ce\r\n\r\n"
    let split = _hc_parse_response(resp, len(resp), 4096)
    ce_eq    ("204",       _http_status_from_line(split[0]), 204)
    ce_str_eq("empty body", split[2], "")
    ce_str_eq("no err",     split[3], "")
}

fn test_response_parse_malformed_no_blank() {
    // No "\r\n\r\n" separator -> NO_STATUS surfaces as parse_err.
    let resp = "HTTP/1.1 200 OK\r\nHeader: x"
    let split = _hc_parse_response(resp, len(resp), 4096)
    ce_str_eq("err nostatus", split[3], HTTP_ERR_NO_STATUS)
}

// Dispatch oversize translation: synthesise a HTTP_ERR_TOO_LARGE response via
// the if_fetch composer wrapping http_get is the real path; here we pin the
// constants used by _if_fetch_http_err_tag mapping so the public sentinels
// stay stable across the IF_ERR_HTTP_* surface.
fn test_if_err_sentinels_distinct() {
    // The five HTTP-layer sentinels must be distinct integer tags so a
    // caller's switch never collides with FETCH_*.
    ce_check("connect != timeout", IF_ERR_HTTP_CONNECT != IF_ERR_HTTP_TIMEOUT)
    ce_check("timeout != parse",   IF_ERR_HTTP_TIMEOUT != IF_ERR_HTTP_PARSE)
    ce_check("parse != oversize",  IF_ERR_HTTP_PARSE   != IF_ERR_HTTP_OVERSIZE)
    ce_check("oversize != dns",    IF_ERR_HTTP_OVERSIZE != IF_ERR_HTTP_DNS)
    ce_check("dns != scheme",      IF_ERR_HTTP_DNS != IF_ERR_HTTP_SCHEME)
    // None of them collide with FETCH_OK/CACHE_HIT etc.
    ce_check("vs FETCH_OK",        IF_ERR_HTTP_CONNECT != FETCH_OK)
    ce_check("vs FETCH_INVALID",   IF_ERR_HTTP_PARSE != FETCH_INVALID)
}

fn test_dispatch_https_is_deferred() {
    let r = if_dispatch_transport("https://en.wikipedia.org/x", 4096)
    ce_eq("tag deferred", if_tr_tag(r), IF_TRANSPORT_DEFERRED)
    ce_eq("no status",    if_tr_status(r), 0)
    ce_str_eq("empty body", if_tr_body(r), "")
    // err should mention deferred and TLS_AUDIT.md
    ce_check("err mentions deferred", len(if_tr_err(r)) > 0)
}

fn test_dispatch_malformed_url() {
    let r = if_dispatch_transport("not-a-url", 4096)
    ce_eq("tag bad url", if_tr_tag(r), IF_TRANSPORT_BAD_URL)
    ce_eq("no status",   if_tr_status(r), 0)
}

fn test_dispatch_http_dns_miss() {
    // unknown host (no dotted-quad, not in env), so we expect HTTP_ERR transport
    // (the http_get returns 0 status with DNS error in `error_msg`).
    let r = if_dispatch_transport("http://unresolvable.test.invalid/x", 4096)
    ce_eq("tag http err",  if_tr_tag(r), IF_TRANSPORT_HTTP_ERR)
    ce_eq("no status",     if_tr_status(r), 0)
    ce_check("err non-empty", len(if_tr_err(r)) > 0)
}

fn main() {
    test_parse_url_full()
    test_parse_url_default_port_http()
    test_parse_url_default_port_https()
    test_parse_url_no_path_defaults_to_root()
    test_parse_url_authority_only_with_port()
    test_parse_url_wrong_scheme_returns_empty_record()
    test_parse_url_malformed_returns_empty()
    test_dns_register_and_lookup()
    test_dns_register_rejects_bad_ip()
    test_header_get_case_insensitive()
    test_is_redirect_classifies_3xx()
    test_status_line_parser()
    test_header_get_all_multivalue()
    test_chunked_header_detection()
    test_chunked_decode_roundtrip()
    test_chunked_decode_simple()
    test_chunked_decode_zero_only()
    test_chunked_decode_malformed()
    test_chunked_decode_oversize()
    test_content_length_apply()
    test_recv_timeout_documented_gap()
    test_response_parse_full()
    test_response_parse_no_body()
    test_response_parse_malformed_no_blank()
    test_if_err_sentinels_distinct()
    test_dispatch_https_is_deferred()
    test_dispatch_malformed_url()
    test_dispatch_http_dns_miss()
    ce_summary("http_client")
}

main()
