// Unit tests for src/safety/rng.nova (R91 pluggable RNG interface).
//
// Coverage
//   Interface (backend-independent):
//     * rng_read on out_len == 0 returns 1 and no-ops.
//     * rng_read on negative out_len returns 0.
//     * rng_read on a NULL ctx returns 0.
//     * rng_read on unknown-kind ctx returns 0.
//     * rng_kind reports the constructed backend.
//   Backend B (test/deterministic):
//     * Same seed -> byte-identical output across two ctxs (32 bytes,
//       1 byte, 64 bytes, 128 bytes, 1024 bytes).
//     * Different seeds -> different output.
//     * Long output correctness: 1024-byte read deterministic.
//     * Two reads (e.g. 20 bytes + 12 bytes) == one 32-byte read.
//     * Multiple sequential reads from one ctx produce monotonically-
//       fresh bytes (no repeat block).
//     * Empty seed rejected.
//     * TEST-ONLY warning string present in the source.
//     * Backend kind reports TEST.
//   Backend C (callback):
//     * cb_fn invoked with the caller's buffer and length exactly.
//     * cb_fn=0 rejected at construction (returns 0).
//     * ok=1 from cb propagates as ok=1.
//     * ok=0 from cb propagates as ok=0.
//     * Kind reports CALLBACK.
//   Backend A (OS entropy):
//     * rng_os_new reports availability. Because R91's probe found that
//       this container's `secure_random` returns -1 (getrandom syscall
//       blocked), the OS backend is EXPECTED to be unavailable here.
//       We log a "skipped: OS entropy source not available in this
//       container" line and do NOT go red. If the container's seccomp
//       changes and secure_random starts working, the availability
//       branch fires and we exercise it end-to-end (rng_read + two
//       32-byte reads differ + non-zero bytes).
//
// NOVA dependencies: ce_test harness, rng, sha256, chacha20.

import "../ce_test.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/chacha20.nova"
import "../../src/safety/rng.nova"

// ---- helpers -------------------------------------------------------------

fn _trng_zero(buf, n) {
    let i = 0
    while i < n {
        store8(buf + i, 0)
        i = i + 1
    }
}

fn _trng_bufs_eq(a, na, b, nb) {
    if na != nb { return 0 }
    let i = 0
    while i < na {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

fn _trng_buf_nonzero(buf, n) {
    let acc = 0
    let i = 0
    while i < n {
        acc = int_or(acc, load8(buf + i))
        i = i + 1
    }
    if acc == 0 { return 0 }
    return 1
}

fn _trng_str_from_bytes(s) {
    // Copy a NUL-terminated NOVA string literal into a fresh buf.
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    return buf
}

// ---- interface tests -----------------------------------------------------

fn test_read_zero_len_is_noop() {
    let ctx = list_new()
    let seed = _trng_str_from_bytes("seed-A")
    ce_eq("test ctx built", rng_test_new(ctx, seed, 6), 1)
    let out = alloc(9)
    _trng_zero(out, 8)
    ce_eq("read len=0 returns ok=1", rng_read(ctx, out, 0), 1)
    // Buffer must be untouched.
    let acc = 0
    let i = 0
    while i < 8 { acc = int_or(acc, load8(out + i)); i = i + 1 }
    ce_eq("read len=0 did not touch out_buf", acc, 0)
}

fn test_read_negative_len_rejected() {
    let ctx = list_new()
    let seed = _trng_str_from_bytes("seed-B")
    rng_test_new(ctx, seed, 6)
    let out = alloc(9)
    ce_eq("read len=-1 returns 0", rng_read(ctx, out, 0 - 1), 0)
    ce_eq("read len=-99 returns 0", rng_read(ctx, out, 0 - 99), 0)
}

fn test_read_null_ctx_rejected() {
    let out = alloc(9)
    ce_eq("read null ctx returns 0", rng_read(0, out, 8), 0)
}

fn test_read_bad_kind_rejected() {
    // Fabricate a ctx with an unknown kind sentinel.
    let bad = list_new()
    push(bad, 999)
    let out = alloc(9)
    ce_eq("read unknown kind returns 0", rng_read(bad, out, 8), 0)
}

fn test_read_over_max_rejected() {
    let ctx = list_new()
    let seed = _trng_str_from_bytes("seed-M")
    rng_test_new(ctx, seed, 6)
    let out = alloc(9)
    ce_eq("read over RNG_MAX_READ returns 0",
          rng_read(ctx, out, RNG_MAX_READ + 1), 0)
}

fn test_rng_kind_reports() {
    ce_eq("rng_kind(0) = 0", rng_kind(0), 0)
    let ctx_t = list_new()
    let seed = _trng_str_from_bytes("seed-K")
    rng_test_new(ctx_t, seed, 6)
    ce_eq("rng_kind(test) = TEST", rng_kind(ctx_t), RNG_KIND_TEST)
}

// ---- test/deterministic backend -----------------------------------------

fn test_test_same_seed_same_output_32() {
    let seed = _trng_str_from_bytes("shared-seed-32")
    let ctx1 = list_new(); rng_test_new(ctx1, seed, 14)
    let ctx2 = list_new(); rng_test_new(ctx2, seed, 14)
    let out1 = alloc(33); _trng_zero(out1, 32)
    let out2 = alloc(33); _trng_zero(out2, 32)
    ce_eq("ctx1 read ok", rng_read(ctx1, out1, 32), 1)
    ce_eq("ctx2 read ok", rng_read(ctx2, out2, 32), 1)
    ce_eq("same seed -> identical 32B output",
          _trng_bufs_eq(out1, 32, out2, 32), 1)
    ce_eq("output is not the zero buffer",
          _trng_buf_nonzero(out1, 32), 1)
}

fn test_test_same_seed_same_output_1B() {
    let seed = _trng_str_from_bytes("byte-at-a-time")
    let ctx1 = list_new(); rng_test_new(ctx1, seed, 14)
    let ctx2 = list_new(); rng_test_new(ctx2, seed, 14)
    let out1 = alloc(2); _trng_zero(out1, 1)
    let out2 = alloc(2); _trng_zero(out2, 1)
    rng_read(ctx1, out1, 1)
    rng_read(ctx2, out2, 1)
    ce_eq("same seed -> identical 1B output", load8(out1), load8(out2))
}

fn test_test_same_seed_same_output_64() {
    let seed = _trng_str_from_bytes("full-block-64")
    let ctx1 = list_new(); rng_test_new(ctx1, seed, 13)
    let ctx2 = list_new(); rng_test_new(ctx2, seed, 13)
    let out1 = alloc(65); _trng_zero(out1, 64)
    let out2 = alloc(65); _trng_zero(out2, 64)
    rng_read(ctx1, out1, 64)
    rng_read(ctx2, out2, 64)
    ce_eq("same seed -> identical 64B (one chacha block)",
          _trng_bufs_eq(out1, 64, out2, 64), 1)
}

fn test_test_same_seed_same_output_128() {
    let seed = _trng_str_from_bytes("two-block-128")
    let ctx1 = list_new(); rng_test_new(ctx1, seed, 13)
    let ctx2 = list_new(); rng_test_new(ctx2, seed, 13)
    let out1 = alloc(129); _trng_zero(out1, 128)
    let out2 = alloc(129); _trng_zero(out2, 128)
    rng_read(ctx1, out1, 128)
    rng_read(ctx2, out2, 128)
    ce_eq("same seed -> identical 128B (two chacha blocks)",
          _trng_bufs_eq(out1, 128, out2, 128), 1)
}

fn test_test_same_seed_same_output_1024() {
    let seed = _trng_str_from_bytes("long-read-1024")
    let ctx1 = list_new(); rng_test_new(ctx1, seed, 14)
    let ctx2 = list_new(); rng_test_new(ctx2, seed, 14)
    let out1 = alloc(1025); _trng_zero(out1, 1024)
    let out2 = alloc(1025); _trng_zero(out2, 1024)
    ce_eq("1024B read ok ctx1", rng_read(ctx1, out1, 1024), 1)
    ce_eq("1024B read ok ctx2", rng_read(ctx2, out2, 1024), 1)
    ce_eq("same seed -> identical 1024B output",
          _trng_bufs_eq(out1, 1024, out2, 1024), 1)
}

fn test_test_different_seeds_diverge() {
    let seed_a = _trng_str_from_bytes("seed-alpha")
    let seed_b = _trng_str_from_bytes("seed-bravo")
    let ctx_a = list_new(); rng_test_new(ctx_a, seed_a, 10)
    let ctx_b = list_new(); rng_test_new(ctx_b, seed_b, 10)
    let out_a = alloc(33); _trng_zero(out_a, 32)
    let out_b = alloc(33); _trng_zero(out_b, 32)
    rng_read(ctx_a, out_a, 32)
    rng_read(ctx_b, out_b, 32)
    ce_eq("different seeds -> different output",
          _trng_bufs_eq(out_a, 32, out_b, 32), 0)
    // First byte alone almost-always differs.
    ce_check("different seeds -> first byte differs",
             load8(out_a) != load8(out_b))
}

fn test_test_seed_bit_flip_diverges() {
    // Confirm even a 1-bit change in the seed diverges the stream.
    let seed_a = _trng_str_from_bytes("seed-bit-A")
    let seed_b = _trng_str_from_bytes("seed-bit-B")
    let ctx_a = list_new(); rng_test_new(ctx_a, seed_a, 10)
    let ctx_b = list_new(); rng_test_new(ctx_b, seed_b, 10)
    let out_a = alloc(33); _trng_zero(out_a, 32)
    let out_b = alloc(33); _trng_zero(out_b, 32)
    rng_read(ctx_a, out_a, 32)
    rng_read(ctx_b, out_b, 32)
    ce_eq("1-bit seed change -> different output",
          _trng_bufs_eq(out_a, 32, out_b, 32), 0)
}

fn test_test_split_reads_equal_one_read() {
    // rng_read(ctx, 20) then rng_read(ctx, 12) MUST produce the same
    // 32 bytes as a single rng_read(ctx, 32) from an identically-
    // seeded ctx.
    let seed = _trng_str_from_bytes("split-read-seed")
    let ctx_split = list_new(); rng_test_new(ctx_split, seed, 15)
    let ctx_one = list_new(); rng_test_new(ctx_one, seed, 15)
    let out_split = alloc(33); _trng_zero(out_split, 32)
    let out_one   = alloc(33); _trng_zero(out_one, 32)
    rng_read(ctx_split, out_split + 0, 20)
    rng_read(ctx_split, out_split + 20, 12)
    rng_read(ctx_one, out_one, 32)
    ce_eq("split reads == one read",
          _trng_bufs_eq(out_split, 32, out_one, 32), 1)
}

fn test_test_split_across_block_boundary() {
    // Read 100 bytes as 50+50 (straddles the 64-byte chacha block
    // boundary) and confirm it matches a single 100-byte read.
    let seed = _trng_str_from_bytes("straddle-seed-64")
    let ctx_a = list_new(); rng_test_new(ctx_a, seed, 16)
    let ctx_b = list_new(); rng_test_new(ctx_b, seed, 16)
    let out_a = alloc(101); _trng_zero(out_a, 100)
    let out_b = alloc(101); _trng_zero(out_b, 100)
    rng_read(ctx_a, out_a + 0, 50)
    rng_read(ctx_a, out_a + 50, 50)
    rng_read(ctx_b, out_b, 100)
    ce_eq("split across block boundary matches whole",
          _trng_bufs_eq(out_a, 100, out_b, 100), 1)
}

fn test_test_sequential_reads_fresh_bytes() {
    // Two 32-byte pulls from ONE ctx should not be identical (would
    // indicate the counter is stuck).
    let seed = _trng_str_from_bytes("sequential-seed")
    let ctx = list_new(); rng_test_new(ctx, seed, 15)
    let a = alloc(33); _trng_zero(a, 32)
    let b = alloc(33); _trng_zero(b, 32)
    rng_read(ctx, a, 32)
    rng_read(ctx, b, 32)
    ce_eq("sequential reads produce different bytes",
          _trng_bufs_eq(a, 32, b, 32), 0)
    ce_eq("both reads non-zero A", _trng_buf_nonzero(a, 32), 1)
    ce_eq("both reads non-zero B", _trng_buf_nonzero(b, 32), 1)
}

fn test_test_empty_seed_rejected() {
    let ctx = list_new()
    let seed = alloc(1); store8(seed, 0)
    ce_eq("empty seed rejected (len=0)", rng_test_new(ctx, seed, 0), 0)
}

fn test_test_negative_seed_len_rejected() {
    let ctx = list_new()
    let seed = alloc(1); store8(seed, 0)
    ce_eq("negative seed len rejected",
          rng_test_new(ctx, seed, 0 - 1), 0)
}

fn test_test_one_byte_seed_works() {
    // Short seed is fine (SHA-256 extractor handles any nonzero length).
    let ctx = list_new()
    let seed = alloc(2); store8(seed, 42); store8(seed + 1, 0)
    ce_eq("1-byte seed accepted", rng_test_new(ctx, seed, 1), 1)
    let out = alloc(33); _trng_zero(out, 32)
    ce_eq("1-byte-seed read ok", rng_read(ctx, out, 32), 1)
    ce_eq("1-byte-seed produces non-zero", _trng_buf_nonzero(out, 32), 1)
}

fn _trng_str_contains(hay, needle) {
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0 { return 1 }
    if nn > hn { return 0 }
    let i = 0
    while i <= hn - nn {
        let hit = 1
        let j = 0
        while j < nn {
            if char_at(hay, i + j) != char_at(needle, j) { hit = 0; j = nn }
            j = j + 1
        }
        if hit == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn test_test_warning_string_exported() {
    // The rng module exports RNG_TEST_BACKEND_WARNING for callers /
    // audit logs to display. Pin its shape here: it must contain
    // "TEST-ONLY", "MUST NEVER", and either "TLS" or "keyshare" so
    // a future refactor that quietly softens the warning triggers
    // a red.
    ce_eq("TEST-ONLY substring present",
          _trng_str_contains(RNG_TEST_BACKEND_WARNING, "TEST-ONLY"), 1)
    ce_eq("MUST NEVER substring present",
          _trng_str_contains(RNG_TEST_BACKEND_WARNING, "MUST NEVER"), 1)
    ce_eq("mentions TLS or keyshare",
          int_or(_trng_str_contains(RNG_TEST_BACKEND_WARNING, "TLS"),
                 _trng_str_contains(RNG_TEST_BACKEND_WARNING, "keyshare")), 1)
    ce_check("warning string is not empty", len(RNG_TEST_BACKEND_WARNING) > 32)
}

// ---- callback backend ----------------------------------------------------
//
// The callback tests need three functions:
//   _trng_cb_fill_stamp -- writes a known stamp into out_buf and returns 1.
//   _trng_cb_always_fail -- returns 0 without writing.
//   _trng_cb_record_call -- records (buf_addr, out_len) into module state.

let _trng_cb_last_buf = 0
let _trng_cb_last_len = 0
let _trng_cb_call_count = 0

fn _trng_cb_fill_stamp(out_buf, out_len) {
    _trng_cb_last_buf = out_buf
    _trng_cb_last_len = out_len
    _trng_cb_call_count = _trng_cb_call_count + 1
    let i = 0
    while i < out_len {
        // Deterministic stamp so the caller can verify what was written.
        store8(out_buf + i, int_and(i + 17, 255))
        i = i + 1
    }
    return 1
}

fn _trng_cb_always_fail(out_buf, out_len) {
    // Do not touch out_buf; propagate ok=0.
    return 0
}

fn test_callback_invoked_with_caller_buf() {
    _trng_cb_last_buf = 0
    _trng_cb_last_len = 0
    _trng_cb_call_count = 0
    let ctx = list_new()
    ce_eq("cb ctx built", rng_callback_new(ctx, _trng_cb_fill_stamp), 1)
    let out = alloc(17); _trng_zero(out, 16)
    ce_eq("cb read ok", rng_read(ctx, out, 16), 1)
    ce_eq("cb was called once", _trng_cb_call_count, 1)
    ce_eq("cb saw caller's buf", _trng_cb_last_buf, out)
    ce_eq("cb saw caller's len", _trng_cb_last_len, 16)
    // Confirm the stamp landed in the caller's buffer.
    let good = 1
    let i = 0
    while i < 16 {
        if load8(out + i) != int_and(i + 17, 255) { good = 0 }
        i = i + 1
    }
    ce_eq("cb stamp visible to caller", good, 1)
}

fn test_callback_ok_zero_propagates() {
    let ctx = list_new()
    ce_eq("cb ctx built (fail)",
          rng_callback_new(ctx, _trng_cb_always_fail), 1)
    let out = alloc(9); _trng_zero(out, 8)
    ce_eq("cb returning 0 propagates as ok=0",
          rng_read(ctx, out, 8), 0)
}

fn test_callback_null_fn_rejected() {
    let ctx = list_new()
    ce_eq("cb_fn=0 rejected", rng_callback_new(ctx, 0), 0)
}

fn test_callback_kind_reports() {
    let ctx = list_new()
    rng_callback_new(ctx, _trng_cb_fill_stamp)
    ce_eq("rng_kind(cb) = CALLBACK", rng_kind(ctx), RNG_KIND_CALLBACK)
}

// ---- OS backend (availability-dependent) --------------------------------

fn test_os_backend_report_and_maybe_run() {
    let ctx = list_new()
    let ok = rng_os_new(ctx)
    ce_check("rng_os_new returns 0 or 1", ok == 0 || ok == 1)
    if ok == 0 {
        println("SKIP: OS entropy source not available in this container (secure_random returned -1 or short)")
        // Nothing more we can assert without the backend. Not a red.
        return
    }
    // OS backend live: exercise it.
    ce_eq("rng_kind(os) = OS", rng_kind(ctx), RNG_KIND_OS)
    let a = alloc(33); _trng_zero(a, 32)
    let b = alloc(33); _trng_zero(b, 32)
    ce_eq("os read A ok=1", rng_read(ctx, a, 32), 1)
    ce_eq("os read B ok=1", rng_read(ctx, b, 32), 1)
    ce_eq("os produces non-zero A", _trng_buf_nonzero(a, 32), 1)
    ce_eq("os produces non-zero B", _trng_buf_nonzero(b, 32), 1)
    ce_eq("two 32B os reads differ", _trng_bufs_eq(a, 32, b, 32), 0)
    // 128-byte read (crosses two extractor pool refills).
    let c = alloc(129); _trng_zero(c, 128)
    ce_eq("os 128B read ok=1", rng_read(ctx, c, 128), 1)
    ce_eq("os 128B non-zero", _trng_buf_nonzero(c, 128), 1)
}

// ---- run ----------------------------------------------------------------

fn main() {
    // Interface tests.
    test_read_zero_len_is_noop()
    test_read_negative_len_rejected()
    test_read_null_ctx_rejected()
    test_read_bad_kind_rejected()
    test_read_over_max_rejected()
    test_rng_kind_reports()
    // Test backend.
    test_test_same_seed_same_output_32()
    test_test_same_seed_same_output_1B()
    test_test_same_seed_same_output_64()
    test_test_same_seed_same_output_128()
    test_test_same_seed_same_output_1024()
    test_test_different_seeds_diverge()
    test_test_seed_bit_flip_diverges()
    test_test_split_reads_equal_one_read()
    test_test_split_across_block_boundary()
    test_test_sequential_reads_fresh_bytes()
    test_test_empty_seed_rejected()
    test_test_negative_seed_len_rejected()
    test_test_one_byte_seed_works()
    test_test_warning_string_exported()
    // Callback backend.
    test_callback_invoked_with_caller_buf()
    test_callback_ok_zero_propagates()
    test_callback_null_fn_rejected()
    test_callback_kind_reports()
    // OS backend (availability-gated).
    test_os_backend_report_and_maybe_run()
    ce_summary("rng")
}

main()
