// Unit tests for the governed-promotion audit hook in learn_pipeline.nova
// (ADR-0043 x ADR-0092): when a decision log is wired via lp_set_audit_log,
// each governed atom's promotion outcome is recorded as a DLK_DECISION /
// DREC_PROMOTION entry; with no log wired the ingest path is unchanged.
//
// The full lp_ingest at scale hits the bootstrap's KG-construct-at-scale limit
// (test_learn_pipeline segfaults identically with and without this change), so
// the audit semantics are exercised here on the helper + handle directly, the
// same isolation strategy the other ingest-adjacent suites use.

import "../ce_test.nova"
import "../../src/learning/learn_pipeline.nova"

// A clean (wikipedia) source -> PROMOTED -> one OK DLK_DECISION entry.
fn test_audited_govern_records_promotion() {
    let log = dl_new()
    lp_set_audit_log(log)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "demo")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "fact", 0)
    let state = _lp_govern_audited(atom, "wikipedia:Fact", 100)
    ce_eq("promoted", state, CAND_PROMOTED)
    ce_eq("one log entry", dl_count(log), 1)
    let e = dl_get(log, 0)
    ce_eq("kind decision", dl_kind(e), DLK_DECISION)
    ce_eq("subtype promotion", drec_subtype(e), DREC_PROMOTION)
    ce_eq("claim is the atom id", drec_claim(e), atom_id(atom))
    ce_eq("flag carries PROMOTED state", drec_flag(e), CAND_PROMOTED)
    ce_eq("promoted -> OK outcome", dl_outcome(e), OUT_OK)
    ce_eq("chain intact", dl_verify(log), 1)
    lp_set_audit_log(0)   // unwire so other tests see a clean default
}

// An unclean source -> QUARANTINED -> one VETOED entry.
fn test_audited_govern_records_quarantine() {
    let log = dl_new()
    lp_set_audit_log(log)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "demo")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "shady", 0)
    let state = _lp_govern_audited(atom, "rando-blog:Shady", 200)
    ce_eq("quarantined", state, CAND_QUARANTINED)
    let e = dl_get(log, 0)
    ce_eq("flag carries QUARANTINED", drec_flag(e), CAND_QUARANTINED)
    ce_eq("quarantine -> VETOED", dl_outcome(e), OUT_VETOED)
    lp_set_audit_log(0)
}

// With NO log wired, the helper governs but records nothing (ingest unchanged).
fn test_no_log_no_record() {
    lp_set_audit_log(0)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "demo")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "fact", 0)
    let state = _lp_govern_audited(atom, "wikipedia:Fact", 100)
    ce_eq("still governed (promoted)", state, CAND_PROMOTED)
    ce_eq("handle is off", _lp_audit_log(), 0)
}

// Multiple governed atoms append a growing, intact chain.
fn test_multiple_entries_chain() {
    let log = dl_new()
    lp_set_audit_log(log)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "demo")
    let a1 = kg_add_atom(kg, ATOM_CONCEPT, "a1", 0)
    let a2 = kg_add_atom(kg, ATOM_CONCEPT, "a2", 0)
    let a3 = kg_add_atom(kg, ATOM_CONCEPT, "a3", 0)
    _lp_govern_audited(a1, "wikipedia:A1", 10)
    _lp_govern_audited(a2, "rando-blog:A2", 20)
    _lp_govern_audited(a3, "user-taught", 30)
    ce_eq("three entries", dl_count(log), 3)
    ce_eq("chain intact across all", dl_verify(log), 1)
    lp_set_audit_log(0)
}

fn main() {
    test_audited_govern_records_promotion()
    test_audited_govern_records_quarantine()
    test_no_log_no_record()
    test_multiple_entries_chain()
    ce_summary("lp_audit")
}

main()
