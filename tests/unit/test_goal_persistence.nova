// Unit tests for src/parts/goals/goal_persistence.nova
// Verifies serialize/deserialize round-trip (preserving fields and re-linking
// children) and validation that detaches dangling-parent orphans. ADR-0033.

import "../ce_test.nova"
import "../../src/parts/goals/goal_persistence.nova"

fn test_roundtrip() {
    let e = goal_engine_new()
    let root = goal_new(e, "root", 800, 0, 1, 5)
    let a = goal_new(e, "a", 500, 0, 2, 6)
    goal_add_subgoal(e, root, a)
    goal_set_progress(e, a, 400)

    let data = goal_serialize(e)
    ce_eq("two records", len(data), 2)

    let e2 = goal_deserialize(data)
    ce_eq("count preserved", goal_count(e2), 2)
    ce_str_eq("name preserved", goal_name(e2, root), "root")
    ce_eq("priority preserved", goal_priority(e2, a), 500)
    ce_eq("progress preserved", goal_progress(e2, a), 400)
    // Child link rebuilt from parent.
    ce_eq("parent rebuilt", goal_parent(e2, a), root)
    ce_eq("children rebuilt", len(goal_children(e2, root)), 1)
    // A fresh goal in the rehydrated engine gets the next id.
    let c = goal_new(e2, "c", 100, 0, 1, 0)
    ce_eq("next id continues", c, 2)
}

fn test_validation() {
    // A record whose parent id is out of range must be detached on load.
    let data = list_new()
    let r0 = list_new()
    push(r0, 0); push(r0, "ok"); push(r0, -1); push(r0, GOAL_ACTIVE)
    push(r0, 500); push(r0, 0); push(r0, 0); push(r0, 1); push(r0, 0)
    let r1 = list_new()
    push(r1, 1); push(r1, "orphan"); push(r1, 99); push(r1, GOAL_ACTIVE)
    push(r1, 500); push(r1, 0); push(r1, 0); push(r1, 1); push(r1, 0)
    push(data, r0); push(data, r1)

    let e = goal_deserialize(data)
    let fixed = goal_validate(e)
    ce_eq("one orphan fixed", fixed, 1)
    ce_eq("orphan detached", goal_parent(e, 1), -1)
    // A valid tree validates clean.
    let e2 = goal_engine_new()
    let root = goal_new(e2, "r", 800, 0, 1, 0)
    let a = goal_new(e2, "a", 500, 0, 1, 0)
    goal_add_subgoal(e2, root, a)
    ce_eq("valid tree -> no fixes", goal_validate(e2), 0)
}

fn main() {
    test_roundtrip()
    test_validation()
    ce_summary("goal_persistence")
}

main()
