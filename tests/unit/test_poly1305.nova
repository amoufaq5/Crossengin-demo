// Unit tests for src/safety/poly1305.nova (pure-NOVA Poly1305 MAC).
//
// Coverage
//   * Clamp (RFC 7539 section 2.5 -- the bit-mask applied to the first
//     16 bytes of the key before it can be used as r).
//   * Empty-message tag (degenerate case: tag = s mod 2^128 since a = 0).
//   * Short-message tag (RFC 7539 section 2.5.2 worked example, 34-byte
//     "Cryptographic Forum Research Group" message). This is the
//     canonical Poly1305 acceptance test.
//   * Verify happy path + verify fails on a single-byte tamper of the
//     message.
//   * Round-trip with a Poly1305 key derived from a ChaCha20 block
//     (counter=0) per RFC 7539 section 2.6.2 -- shows the full AEAD
//     key-derivation pipeline.
//
// Convention: every assertion goes through ce_eq / ce_check / ce_str_eq.

import "../ce_test.nova"
import "../../src/safety/chacha20.nova"
import "../../src/safety/poly1305.nova"

// ---- helpers --------------------------------------------------------------

// Copy an ASCII NOVA string into a byte buffer; return [buf, len].
fn _tp_ascii_to_buf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    let r = list_new()
    push(r, buf)
    push(r, n)
    return r
}

// ---- clamp (RFC 7539 section 2.5) ---------------------------------------

fn test_clamp() {
    // Input r:    85d6be7857556d337f4452fe42d506a8
    // Clamped r:  85d6be0854556d037c44520e40d50608
    let key_pair = cc_hex_decode("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    let c = _pl_test_clamp(key_pair[0])
    ce_str_eq("clamp matches RFC 7539 2.5", cc_hex_encode_buf(c, 16),
              "85d6be0854556d037c44520e40d50608")
}

// ---- empty-message tag ---------------------------------------------------
//
// With m = empty, a stays at 0 and the tag is just (a + s) mod 2^128 = s.

fn test_empty_message_tag() {
    let key_pair = cc_hex_decode("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    let tag = poly1305_mac_buf(key_pair[0], 0, 0)
    // s = bytes [16..31] of the key = "0103808afb0db2fd4abff6af4149f51b"
    ce_str_eq("empty tag == s", cc_hex_encode_buf(tag, 16),
              "0103808afb0db2fd4abff6af4149f51b")
}

// ---- RFC 7539 section 2.5.2 -- the canonical Poly1305 vector ------------

fn test_mac_rfc7539_2_5_2() {
    let key_pair = cc_hex_decode("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    let msg = _tp_ascii_to_buf("Cryptographic Forum Research Group")
    ce_eq("msg len = 34", msg[1], 34)
    let tag = poly1305_mac_buf(key_pair[0], msg[0], msg[1])
    ce_str_eq("RFC 2.5.2 tag", cc_hex_encode_buf(tag, 16),
              "a8061dc1305136c6c22b8baf0c0127a9")
}

// ---- verify happy + tamper ----------------------------------------------

fn test_verify_match_and_tamper() {
    let key_pair = cc_hex_decode("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    let msg = _tp_ascii_to_buf("Cryptographic Forum Research Group")
    let exp = cc_hex_decode("a8061dc1305136c6c22b8baf0c0127a9")
    ce_eq("verify happy", poly1305_verify_buf(key_pair[0], msg[0], msg[1], exp[0]), 1)
    // Tamper byte 0: 'C' (67) -> 'D' (68).
    store8(msg[0], 68)
    ce_eq("verify tamper", poly1305_verify_buf(key_pair[0], msg[0], msg[1], exp[0]), 0)
    // Restore and confirm verify recovers.
    store8(msg[0], 67)
    ce_eq("verify restored", poly1305_verify_buf(key_pair[0], msg[0], msg[1], exp[0]), 1)
}

// ---- Poly1305 key derived from a ChaCha20 block -------------------------
//
// RFC 7539 section 2.6.2: the AEAD pipeline derives the Poly1305 key
// by running ChaCha20 with counter=0 over the same key/nonce that will
// later encrypt the payload. This test confirms (a) the derivation
// matches the published bytes, and (b) the derived key successfully
// MACs a small payload that we can verify with the SAME key. The
// derived-tag value is not in RFC 7539 -- we recompute and round-trip.

fn test_derived_key_round_trip() {
    let cc_key   = cc_hex_decode("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    let cc_nonce = cc_hex_decode("000000000001020304050607")
    let block = chacha20_block_buf(cc_key[0], cc_nonce[0], 0)
    // The first 32 bytes of the ChaCha20(counter=0) block are the
    // Poly1305 one-time key per RFC 7539 section 2.6.2.
    let pl_key_hex = cc_hex_encode_buf(block, 32)
    ce_str_eq("derived Poly1305 key matches RFC 2.6.2", pl_key_hex,
              "8ad5a08b905f81cc815040274ab29471a833b637e3fd0da508dbb8e2fdd1a646")
    // Use the derived key for a tiny MAC and round-trip verify.
    let pl_key = cc_hex_decode(pl_key_hex)
    let payload = _tp_ascii_to_buf("hello aead")
    let tag = poly1305_mac_buf(pl_key[0], payload[0], payload[1])
    ce_eq("derived-key round-trip verify",
          poly1305_verify_buf(pl_key[0], payload[0], payload[1], tag), 1)
}

fn main() {
    test_clamp()
    test_empty_message_tag()
    test_mac_rfc7539_2_5_2()
    test_verify_match_and_tamper()
    test_derived_key_round_trip()
    ce_summary("poly1305")
}

main()
