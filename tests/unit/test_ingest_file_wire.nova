// ---- R68: wikidata multi-body ingest (labels_body + formal_preds) ------

fn _wd_body() {
    // Two Wikidata-flavored NT lines: a P31 (in the default FORMAL
    // set) and a P279 (also in the default set), so records land
    // regardless of whether the caller passes extras.
    return "<http://www.wikidata.org/entity/Q76> "
         + "<http://www.wikidata.org/prop/direct/P31> "
         + "<http://www.wikidata.org/entity/Q5> .\n"
         + "<http://www.wikidata.org/entity/Q5> "
         + "<http://www.wikidata.org/prop/direct/P279> "
         + "<http://www.wikidata.org/entity/Q729> .\n"
}

fn test_wikidata_labels_loaded_defaults_zero_without_arg() {
    // R67 baseline: no labels_body arg => labels_loaded is 0.
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "wd")
    let a = list_new()
    push(a, rpc_arg_kv("format", "wikidata"))
    push(a, rpc_arg_kv("body",   _wd_body()))
    push(a, rpc_arg_kv("kg",     "wd"))
    push(a, rpc_arg_kv("source", "src:cerec:wd"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("labels_loaded 0",       _has(out, "\"labels_loaded\":0"))
    ce_check("extra_formal_preds 0",  _has(out, "\"extra_formal_preds\":0"))
    ce_check("still ingested",        _has(out, "\"records_ingested\":1"))
}

fn test_wikidata_labels_body_loaded_and_counted() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "wd")
    // 3 labels: 2 real + 1 comment (ignored) + 1 blank (ignored).
    let labels_body = "Q76\tBarack Obama\n"
                    + "# comment line ignored\n"
                    + "Q5\thuman\n"
                    + "\n"
                    + "Q729\tanimal\n"
    let a = list_new()
    push(a, rpc_arg_kv("format",      "wikidata"))
    push(a, rpc_arg_kv("body",        _wd_body()))
    push(a, rpc_arg_kv("kg",          "wd"))
    push(a, rpc_arg_kv("source",      "src:cerec:wd"))
    push(a, rpc_arg_kv("labels_body", labels_body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("labels_loaded 3",        _has(out, "\"labels_loaded\":3"))
    ce_check("record ingested",        _has(out, "\"records_ingested\":1"))
    // Extra preds still 0 (no arg supplied).
    ce_check("extra_formal_preds 0",  _has(out, "\"extra_formal_preds\":0"))
}

fn test_wikidata_labels_body_empty_string_treated_as_absent() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "wd")
    let a = list_new()
    push(a, rpc_arg_kv("format",      "wikidata"))
