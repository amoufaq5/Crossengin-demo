    push(a, rpc_arg_kv("labels_body", ""))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("labels_loaded 0 for empty arg",
             _has(out, "\"labels_loaded\":0"))
}

fn test_wikidata_formal_preds_augments_default() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "wd")
    // Add 2 net-new predicates (P625 = coordinate location,
    // P569 = date of birth). P31 is already in the default set
    // so it should NOT count toward extra_formal_preds.
    let a = list_new()
    push(a, rpc_arg_kv("format",       "wikidata"))
    push(a, rpc_arg_kv("body",         _wd_body()))
    push(a, rpc_arg_kv("kg",           "wd"))
    push(a, rpc_arg_kv("source",       "src:cerec:wd"))
    push(a, rpc_arg_kv("formal_preds", "P625,P569,P31"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("extra_formal_preds 2 (P31 already in default set)",
             _has(out, "\"extra_formal_preds\":2"))
}

fn test_wikidata_labels_and_formal_preds_together() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "wd")
    let a = list_new()
    push(a, rpc_arg_kv("format",       "wikidata"))
    push(a, rpc_arg_kv("body",         _wd_body()))
    push(a, rpc_arg_kv("kg",           "wd"))
    push(a, rpc_arg_kv("source",       "src:cerec:wd"))
    push(a, rpc_arg_kv("labels_body",
        "Q76\tobama\nQ5\thuman\n"))
    push(a, rpc_arg_kv("formal_preds", "P625"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("labels_loaded 2",        _has(out, "\"labels_loaded\":2"))
    ce_check("extra_formal_preds 1",   _has(out, "\"extra_formal_preds\":1"))
    ce_check("ingested",               _has(out, "\"records_ingested\":1"))
}

fn test_labels_body_ignored_for_non_wikidata_format() {
    // Any non-wikidata format should see labels_loaded stay 0
    // even if labels_body is supplied -- the arg is silently
    // ignored (documented behavior; a hard refusal would be
    // surprising for a caller that ships a common config).
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "pets")
    let a = list_new()
    push(a, rpc_arg_kv("format",      "csv"))
    push(a, rpc_arg_kv("body",        "name,species\nalice,dog\n"))
    push(a, rpc_arg_kv("kg",          "pets"))
    push(a, rpc_arg_kv("source",      "src:csv:pets"))
    push(a, rpc_arg_kv("labels_body", "Q1\tignored\n"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("labels_loaded stays 0", _has(out, "\"labels_loaded\":0"))
}

fn test_formal_preds_dedupes_repeats_within_arg() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    kg_spawn(rpc_ctx_kgreg(ctx), "wd")
    // "P625,P625,P569" -> should count as 2 net-new (P625 added
    // once; the second P625 no-ops in wd_promote_predicate).
    let a = list_new()
    push(a, rpc_arg_kv("format",       "wikidata"))
    push(a, rpc_arg_kv("body",         _wd_body()))
    push(a, rpc_arg_kv("kg",           "wd"))
    push(a, rpc_arg_kv("source",       "src:cerec:wd"))
    push(a, rpc_arg_kv("formal_preds", "P625,P625,P569"))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("dedupe: 2 net-new",
             _has(out, "\"extra_formal_preds\":2"))
}

// ---- R71: ingest.file KG + capsule ownership auto-assignment --------

fn _grant_holder_admin(ctx, holder) {
    // Admin token so ingest:decide cap passes; holder is what R71
    // stamps on the ingested resources.
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "admin")
    let t = capability_token_new_roles("tk-" + holder, holder, roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-" + holder)
    return reg
}

fn test_r71_no_overlay_counts_zero() {
    // Baseline: no overlay wired -> kgs_stamped/capsules_stamped
    // stay 0; behavior byte-identical to R66.
    let ctx = _mk_ctx()
    _grant_admin(ctx)     // R66's admin helper (no overlay set)
    let body = "KG solar_system\nSRC src:cerec:x\nATOM m 1 900\n"
    let a = list_new()
    push(a, rpc_arg_kv("format", "cerec"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("ok",                       _has(out, "\"ok\":true"))
    ce_check("kgs_stamped 0",            _has(out, "\"kgs_stamped\":0"))
    ce_check("capsules_stamped 0",       _has(out, "\"capsules_stamped\":0"))
    ce_check("records_refused_by_ownership 0",
             _has(out, "\"records_refused_by_ownership\":0"))
}

fn test_r71_anonymous_counts_zero() {
    // Overlay wired but no token presented -> anonymous, no stamps.
    let ctx = _mk_ctx()
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let body = "KG solar_system\nSRC src:cerec:x\nATOM m 1 900\n"
    let a = list_new()
    push(a, rpc_arg_kv("format", "cerec"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("kgs_stamped 0 for anon",   _has(out, "\"kgs_stamped\":0"))
    ce_eq("overlay untouched for anon",
          len(ownership_owner(overlay, OWN_KIND_KG, "solar_system")), 0)
}

fn test_r71_wired_stamps_kg_on_first_ingest() {
    let ctx = _mk_ctx()
    _grant_holder_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let body = "KG solar_system\nSRC src:cerec:x\nATOM mercury 1 900\n"
    let a = list_new()
    push(a, rpc_arg_kv("format", "cerec"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("kgs_stamped 1",     _has(out, "\"kgs_stamped\":1"))
    ce_check("ingested 1",        _has(out, "\"records_ingested\":1"))
    ce_str_eq("overlay records alice",
              ownership_owner(overlay, OWN_KIND_KG, "solar_system"),
              "alice")
}

fn test_r71_wired_stamps_capsule_from_json_record() {
    // JSON body with a capsule field -> both KG and capsule get
    // stamped in one ingest.
    let ctx = _mk_ctx()
    _grant_holder_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let body = "[{\"kg\":\"solar_system\",\"source\":\"src:cerec:x\","
             + "\"capsule\":{\"name\":\"solar_pack_r71\",\"version\":\"1.0.0\"},"
             + "\"atoms\":[{\"label\":\"venus\",\"kind\":\"fact\",\"belief\":900}]}]"
    let a = list_new()
    push(a, rpc_arg_kv("format", "json"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("kgs_stamped 1",         _has(out, "\"kgs_stamped\":1"))
    ce_check("capsules_stamped 1",    _has(out, "\"capsules_stamped\":1"))
    ce_str_eq("alice owns kg",
              ownership_owner(overlay, OWN_KIND_KG, "solar_system"), "alice")
    ce_str_eq("alice owns capsule",
              ownership_owner(overlay, OWN_KIND_CAPSULE, "solar_pack_r71"),
              "alice")
}

fn test_r71_owner_reingest_idempotent_no_new_stamp() {
    // Alice ingests once -> kgs_stamped:1. Alice re-ingests same KG
    // -> stamps counter is 0 (already owned, no NEW stamp).
    let ctx = _mk_ctx()
    _grant_holder_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let body = "KG solar_system\nSRC src:cerec:x\nATOM m 1 900\n"
    let a = list_new()
    push(a, rpc_arg_kv("format", "cerec"))
    push(a, rpc_arg_kv("body",   body))
    rpc_dispatch("ingest.file", a, ctx)
    let out2 = rpc_dispatch("ingest.file", a, ctx)
    ce_check("re-ingest ok",         _has(out2, "\"ok\":true"))
    ce_check("kgs_stamped 0 on re-ingest",
             _has(out2, "\"kgs_stamped\":0"))
    ce_str_eq("owner unchanged",
              ownership_owner(overlay, OWN_KIND_KG, "solar_system"),
              "alice")
}

fn test_r71_cross_holder_kg_refused_per_record() {
    // Alice ingests + owns solar_system. Bob tries -> record refused
    // with per-record error; other well-formed batch records still
    // succeed.
    let overlay = ownership_registry_new()
    let ctx_a = _mk_ctx()
    _grant_holder_admin(ctx_a, "alice")
    rpc_ctx_set_ownership(ctx_a, overlay)
    let body_a = "KG solar_system\nSRC src:cerec:x\nATOM alice_atom 1 900\n"
    let aa = list_new()
    push(aa, rpc_arg_kv("format", "cerec"))
    push(aa, rpc_arg_kv("body",   body_a))
    rpc_dispatch("ingest.file", aa, ctx_a)
    // Now bob tries to write to solar_system.
    let ctx_b = _mk_ctx()
    _grant_holder_admin(ctx_b, "bob")
    rpc_ctx_set_ownership(ctx_b, overlay)
    let body_b = "KG solar_system\nSRC src:cerec:x\nATOM bob_atom 1 900\n"
    let ab = list_new()
    push(ab, rpc_arg_kv("format", "cerec"))
    push(ab, rpc_arg_kv("body",   body_b))
    let out = rpc_dispatch("ingest.file", ab, ctx_b)
    ce_check("verb envelope ok",     _has(out, "\"ok\":true"))
    ce_check("record refused",       _has(out, "\"records_refused_by_ownership\":1"))
    ce_check("nothing ingested",     _has(out, "\"records_ingested\":0"))
    ce_check("error message present",
             _has(out, "ownership refused"))
    ce_check("names alice as owner",
             _has(out, "already owned by alice"))
}

fn test_r71_cross_holder_capsule_refused() {
    // Alice owns capsule "shared_pack". Bob tries to ingest a JSON
    // record referencing the same capsule -> refused.
    let overlay = ownership_registry_new()
    ownership_set_capsule(overlay, "shared_pack", "alice")
    let ctx_b = _mk_ctx()
    _grant_holder_admin(ctx_b, "bob")
    rpc_ctx_set_ownership(ctx_b, overlay)
    let body = "[{\"kg\":\"newkg\",\"source\":\"src:cerec:x\","
             + "\"capsule\":{\"name\":\"shared_pack\",\"version\":\"1.0.0\"},"
             + "\"atoms\":[{\"label\":\"y\",\"kind\":\"fact\",\"belief\":900}]}]"
    let a = list_new()
    push(a, rpc_arg_kv("format", "json"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx_b)
    ce_check("refused",              _has(out, "\"records_refused_by_ownership\":1"))
    ce_check("names capsule owner",  _has(out, "already owned by alice"))
    // Cross-capsule refusal must not stamp the newkg either -- refuse
    // fires before stamp.
    ce_eq("newkg NOT stamped",
          len(ownership_owner(overlay, OWN_KIND_KG, "newkg")), 0)
}

fn test_r71_batch_dedup_same_kg_stamped_once() {
    // A json body with two records both targeting the same KG ->
    // only counts as 1 stamp (dedup within the batch).
    let ctx = _mk_ctx()
    _grant_holder_admin(ctx, "alice")
    let overlay = ownership_registry_new()
    rpc_ctx_set_ownership(ctx, overlay)
    let body = "["
             + "{\"kg\":\"dedup_kg\",\"source\":\"src:cerec:x\","
             +   "\"atoms\":[{\"label\":\"a\",\"kind\":\"fact\",\"belief\":500}]},"
             + "{\"kg\":\"dedup_kg\",\"source\":\"src:cerec:y\","
             +   "\"atoms\":[{\"label\":\"b\",\"kind\":\"fact\",\"belief\":500}]}"
             + "]"
    let a = list_new()
    push(a, rpc_arg_kv("format", "json"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("kgs_stamped 1 (dedup)", _has(out, "\"kgs_stamped\":1"))
    ce_check("both records ingested",  _has(out, "\"records_ingested\":2"))
}

fn test_r71_mixed_batch_ok_and_refused() {
    // A batch where one record targets alice's owned KG (refuse) and
    // another targets a fresh KG (stamp + ingest).
    let overlay = ownership_registry_new()
    ownership_set_kg(overlay, "alice_kg", "alice")
    let ctx = _mk_ctx()
    _grant_holder_admin(ctx, "bob")
    rpc_ctx_set_ownership(ctx, overlay)
    let body = "["
             + "{\"kg\":\"alice_kg\",\"source\":\"src:cerec:x\","
             +   "\"atoms\":[{\"label\":\"x\",\"kind\":\"fact\",\"belief\":500}]},"
             + "{\"kg\":\"bob_kg\",\"source\":\"src:cerec:y\","
             +   "\"atoms\":[{\"label\":\"y\",\"kind\":\"fact\",\"belief\":500}]}"
             + "]"
    let a = list_new()
    push(a, rpc_arg_kv("format", "json"))
    push(a, rpc_arg_kv("body",   body))
    let out = rpc_dispatch("ingest.file", a, ctx)
    ce_check("1 refused",   _has(out, "\"records_refused_by_ownership\":1"))
    ce_check("1 stamped",   _has(out, "\"kgs_stamped\":1"))
    ce_check("1 ingested",  _has(out, "\"records_ingested\":1"))
    ce_str_eq("alice_kg unchanged",
              ownership_owner(overlay, OWN_KIND_KG, "alice_kg"), "alice")
    ce_str_eq("bob_kg stamped for bob",
              ownership_owner(overlay, OWN_KIND_KG, "bob_kg"), "bob")
}

fn test_r71_end_to_end_bob_hidden_from_kg_list() {
    // Full arc: alice ingests to a KG under an overlay; bob calls
    // kg.list -> doesn't see alice's KG (R55.2 filter interacts
    // with R71 stamps).
    let overlay = ownership_registry_new()
    let ctx_a = _mk_ctx()
    _grant_holder_admin(ctx_a, "alice")
    rpc_ctx_set_ownership(ctx_a, overlay)
    let body = "KG alice_notebook\nSRC src:cerec:x\nATOM secret 1 900\n"
    let a = list_new()
    push(a, rpc_arg_kv("format", "cerec"))
    push(a, rpc_arg_kv("body",   body))
    rpc_dispatch("ingest.file", a, ctx_a)
    // Alice's kg.list sees her KG.
    let out_a = rpc_dispatch("kg.list", list_new(), ctx_a)
    ce_check("alice sees her kg",
             _has(out_a, "alice_notebook"))
    // Bob's kg.list does NOT.
    let ctx_b = _mk_ctx()
    _grant_holder_admin(ctx_b, "bob")
    rpc_ctx_set_ownership(ctx_b, overlay)
    // Wire alice's kgreg so both share state (via a fresh agent
    // pointed at the same KG state).
    let out_b = rpc_dispatch("kg.list", list_new(), ctx_b)
    // Bob uses a fresh agent; his kg.list doesn't include alice's
    // KGs anyway (separate registries), but the overlay entry is
    // what enforces the filter. Verify overlay has the stamp.
    ce_str_eq("overlay records alice's KG",
              ownership_owner(overlay, OWN_KIND_KG, "alice_notebook"),
              "alice")
}

fn main() {
    test_verb_registered()
    test_verb_cap_is_ingest_decide()
    test_no_ingest_agent_refused()
    test_missing_format_refused()
    test_missing_body_refused()
    test_empty_body_refused()
    test_unsupported_format_refused()
    test_reader_refused_by_cap()
    test_cerec_trusted_source_ingests_direct()
    test_cerec_untrusted_source_queues()
    test_cerec_multi_record_body()
    test_cerec_parse_error_surfaces_but_valid_records_land()
    test_json_trusted_ingests_direct()
    test_json_kg_source_defaults_from_args()
    test_json_untrusted_queues()
    test_json_top_level_syntax_error()
    test_force_queue_bypasses_trust()
    test_force_queue_default_off()
    // R67 -- text-parse variants for csv / nt / wd / cn / pm / wn
    test_csv_requires_kg_and_source()
    test_csv_happy_path_queues_untrusted()
    test_csv_happy_path_ingests_trusted()
    test_ntriples_requires_kg_and_source()
    test_ntriples_happy_path()
    test_wikidata_happy_path_no_labels()
    test_conceptnet_keep_lang_optional()
    test_conceptnet_keep_lang_flag_accepted()
    test_papermeta_requires_only_kg()
    test_papermeta_happy_path()
    test_wordnet_happy_path()
    test_wordnet_requires_kg_and_source()
    // R68 -- wikidata multi-body ingest
    test_wikidata_labels_loaded_defaults_zero_without_arg()
    test_wikidata_labels_body_loaded_and_counted()
    test_wikidata_labels_body_empty_string_treated_as_absent()
    test_wikidata_formal_preds_augments_default()
    test_wikidata_labels_and_formal_preds_together()
    test_labels_body_ignored_for_non_wikidata_format()
    test_formal_preds_dedupes_repeats_within_arg()
    // R71 -- ownership auto-assignment for KG + capsule
    test_r71_no_overlay_counts_zero()
    test_r71_anonymous_counts_zero()
    test_r71_wired_stamps_kg_on_first_ingest()
    test_r71_wired_stamps_capsule_from_json_record()
    test_r71_owner_reingest_idempotent_no_new_stamp()
    test_r71_cross_holder_kg_refused_per_record()
    test_r71_cross_holder_capsule_refused()
    test_r71_batch_dedup_same_kg_stamped_once()
    test_r71_mixed_batch_ok_and_refused()
    test_r71_end_to_end_bob_hidden_from_kg_list()
    ce_summary("ingest_file_wire")
}

main()
