// R109 (Phase J): agent.run dispatch. Covers happy-path dispatch,
// per-skill cap-check escalation refusal, min-confidence threshold,
// style-pin persona clone, retired + unknown refusals, visibility gate.

import "../ce_test.nova"
import "../../src/agents/agent_manifest.nova"
import "../../src/agents/agent_registry.nova"
import "../../src/agents/agent_run.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/persona/persona.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/sandbox/capability.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg1 = kg_spawn(reg, "world")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    list_set(a1[A_BELIEF], 0, 8000) list_set(a1[A_BELIEF], 1, 2000)
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    list_set(a2[A_BELIEF], 0, 7000) list_set(a2[A_BELIEF], 1, 3000)
    return reg
}

// Skill registry with echo installed for a specific persona.
fn _mk_installed_skill_reg(kgreg, persona, mo) {
    let sr = skill_registry_new()
    let m = echo_skill_manifest()
    skill_registry_register(sr, m)
    let sup = skill_supervisor_new(m, kgreg, 0, persona, 0, mo, 100)
    skill_registry_install(sr, "echo", 0, sup, 100)
    return sr
}

fn _mk_ok_agent_reg(sr) {
    let ar = agent_registry_new()
    let m = agent_manifest_new("triage", "1.0.0", "test agent")
    agent_manifest_add_skill_dep(m, "echo")
    agent_manifest_set_min_confidence(m, 0)
    agent_registry_register(ar, m)
    agent_registry_install(ar, "triage", sr, 100)
    return ar
}

// ---- happy-path dispatch ----------------------------------------------

fn test_dispatch_happy_path() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    let r = agent_run_scoped(ar, "triage", "mars phobos",
                              kgreg, 0, 0, sr, mo, 0, 0, 0, "",
                              "", 0, "mars phobos", 100)
    ce_eq("ok", ar_result_ok(r), 1)
    ce_str_eq("agent name",    ar_result_agent_name(r),    "triage")
    ce_str_eq("agent version", ar_result_agent_version(r), "1.0.0")
    ce_str_eq("skill used",    ar_result_skill_used(r),    "echo")
    ce_str_eq("attribution",   ar_result_attribution(r),
              "src:agent:triage:v1.0.0")
    ce_str_eq("no refusal", ar_result_refusal_reason(r), "")
    ce_check("proposal non-null", ar_result_proposal(r) != 0)
    let traces = ar_result_skill_traces(r)
    ce_eq("1 trace row", len(traces), 1)
    ce_str_eq("trace skill echo", traces[0][0], "echo")
    ce_eq("trace ok", traces[0][1], 1)
}

// ---- unknown / retired / uninstalled refusals -------------------------

fn test_unknown_agent_refused() {
    let ar = agent_registry_new()
    let r = agent_run_scoped(ar, "nope", "q", 0, 0, 0, 0, 0, 0, 0, 0, "",
                              "", 0, "q", 100)
    ce_eq("ok=0", ar_result_ok(r), 0)
    ce_check("err mentions unknown", _has(ar_result_refusal_reason(r), "unknown"))
}

fn test_retired_agent_refused() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    agent_registry_retire(ar, "triage", 200)
    let r = agent_run_scoped(ar, "triage", "q", kgreg, 0, 0, sr, mo,
                              0, 0, 0, "", "", 0, "q", 100)
    ce_eq("ok=0", ar_result_ok(r), 0)
    ce_check("err mentions retired", _has(ar_result_refusal_reason(r), "retired"))
}

fn test_uninstalled_agent_refused() {
    let ar = agent_registry_new()
    let m = agent_manifest_new("z", "1", "")
    agent_manifest_add_skill_dep(m, "echo")
    agent_registry_register(ar, m)  // not installed
    let r = agent_run_scoped(ar, "z", "q", 0, 0, 0, 0, 0, 0, 0, 0, "",
                              "", 0, "q", 100)
    ce_eq("ok=0", ar_result_ok(r), 0)
    ce_check("err mentions not installed",
             _has(ar_result_refusal_reason(r), "not installed"))
}

// ---- visibility gate --------------------------------------------------

fn test_visibility_gate_refuses_other_holder() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    let ov = ownership_registry_new()
    ownership_set_agent(ov, "triage", "alice")
    let r = agent_run_scoped(ar, "triage", "q", kgreg, 0, 0, sr, mo,
                              ov, 0, 0, "", "bob", 0, "q", 100)
    ce_eq("ok=0", ar_result_ok(r), 0)
    ce_check("err mentions bob",
             _has(ar_result_refusal_reason(r), "bob"))
}

fn test_visibility_gate_allows_owner() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    let ov = ownership_registry_new()
    ownership_set_agent(ov, "triage", "alice")
    let r = agent_run_scoped(ar, "triage", "mars", kgreg, 0, 0, sr, mo,
                              ov, 0, 0, "", "alice", 0, "mars", 100)
    ce_eq("ok=1", ar_result_ok(r), 1)
}

// ---- per-skill cap-check escalation prevention ------------------------

fn test_escalation_prevention_missing_skill_cap() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    // Build a cap registry with a token that has NL_ASK but NOT SKILL_RUN.
    let creg = capability_registry_new()
    let caps = list_new()
    push(caps, CAP_NL_ASK)
    let t = capability_token_new("tok1", "carol", caps, 0, 0)
    capability_registry_add(creg, t)
    let r = agent_run_scoped(ar, "triage", "q", kgreg, 0, 0, sr, mo,
                              0, 0, creg, "tok1", "carol", 0, "q", 100)
    ce_eq("ok=0", ar_result_ok(r), 0)
    ce_check("err names skill",
             _has(ar_result_refusal_reason(r), "echo"))
    ce_check("err mentions cap",
             _has(ar_result_refusal_reason(r), CAP_SKILL_RUN))
}

fn test_escalation_prevention_allows_cap_holder() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    let creg = capability_registry_new()
    let caps = list_new()
    push(caps, CAP_NL_AGENT_RUN)
    push(caps, CAP_SKILL_RUN)
    let t = capability_token_new("tok2", "dora", caps, 0, 0)
    capability_registry_add(creg, t)
    let r = agent_run_scoped(ar, "triage", "mars", kgreg, 0, 0, sr, mo,
                              0, 0, creg, "tok2", "dora", 0, "mars", 100)
    ce_eq("ok=1", ar_result_ok(r), 1)
}

// ---- min-confidence threshold -----------------------------------------

fn test_min_confidence_threshold_below_refuses() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    // Build agent with min_confidence higher than what echo can produce.
    let ar = agent_registry_new()
    let m = agent_manifest_new("strict", "1", "high threshold")
    agent_manifest_add_skill_dep(m, "echo")
    agent_manifest_set_min_confidence(m, 999)
    agent_registry_register(ar, m)
    agent_registry_install(ar, "strict", sr, 100)
    let r = agent_run_scoped(ar, "strict", "nonsense_no_match_here",
                              kgreg, 0, 0, sr, mo, 0, 0, 0, "",
                              "", 0, "nonsense_no_match_here", 100)
    ce_eq("ok=0", ar_result_ok(r), 0)
    ce_check("err mentions refused",
             _has(ar_result_refusal_reason(r), "refused"))
}

// ---- style-pin persona clone (does NOT mutate stored persona) ---------

fn test_style_pin_clones_persona() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let pr = persona_registry_new()
    let base = persona_new("alice", "Alice", "test", 100)
    persona_set_style_capsule(base, "original_style", 100)
    persona_registry_register(pr, base)
    let sr = _mk_installed_skill_reg(kgreg, base, mo)
    let ar = agent_registry_new()
    let m = agent_manifest_new("styled", "1", "with style pin")
    agent_manifest_add_skill_dep(m, "echo")
    agent_manifest_set_style_pin(m, "terse_override")
    agent_registry_register(ar, m)
    agent_registry_install(ar, "styled", sr, 100)
    let r = agent_run_scoped(ar, "styled", "mars", kgreg, 0, pr, sr, mo,
                              0, 0, 0, "", "alice", 0, "mars", 100)
    ce_eq("ok=1", ar_result_ok(r), 1)
    // Base persona's style_capsule must NOT be mutated -- the clone was
    // what the run touched.
    ce_str_eq("base persona untouched",
              persona_style_capsule(base), "original_style")
}

// ---- attribution --------------------------------------------------

fn test_attribution_tag_present() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    let r = agent_run_scoped(ar, "triage", "mars", kgreg, 0, 0, sr, mo,
                              0, 0, 0, "", "", 0, "mars", 100)
    ce_str_eq("agent attribution",
              ar_result_attribution(r), "src:agent:triage:v1.0.0")
}

// ---- pattern matches (informational) -----------------------------

fn test_pattern_matches_empty_when_no_deps() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = _mk_ok_agent_reg(sr)
    let r = agent_run_scoped(ar, "triage", "mars", kgreg, 0, 0, sr, mo,
                              0, 0, 0, "", "", 0, "mars", 100)
    ce_eq("no pattern matches", len(ar_result_pattern_matches(r)), 0)
}

// ---- multi-skill fallback (first tries hits) --------------------------

fn test_multi_skill_fallback_first_hits() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = _mk_installed_skill_reg(kgreg, 0, mo)
    let ar = agent_registry_new()
    let m = agent_manifest_new("multi", "1", "")
    agent_manifest_add_skill_dep(m, "echo")
    agent_manifest_add_skill_dep(m, "echo")  // dup deduped
    agent_registry_register(ar, m)
    agent_registry_install(ar, "multi", sr, 100)
    let r = agent_run_scoped(ar, "multi", "mars", kgreg, 0, 0, sr, mo,
                              0, 0, 0, "", "", 0, "mars", 100)
    ce_eq("ok", ar_result_ok(r), 1)
    ce_eq("1 trace row (dup deduped)", len(ar_result_skill_traces(r)), 1)
}

fn main() {
    test_dispatch_happy_path()
    test_unknown_agent_refused()
    test_retired_agent_refused()
    test_uninstalled_agent_refused()
    test_visibility_gate_refuses_other_holder()
    test_visibility_gate_allows_owner()
    test_escalation_prevention_missing_skill_cap()
    test_escalation_prevention_allows_cap_holder()
    test_min_confidence_threshold_below_refuses()
    test_style_pin_clones_persona()
    test_attribution_tag_present()
    test_pattern_matches_empty_when_no_deps()
    test_multi_skill_fallback_first_hits()
    ce_summary("agent_run")
}

main()
