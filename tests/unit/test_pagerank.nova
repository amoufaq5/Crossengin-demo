// Unit tests for src/kg/pagerank.nova (R13E).
//
// Covers Brin & Page 1998 PageRank, integer milli-units, deterministic
// no-randomness. We exercise:
//   - extraction edge cases (empty KG, singleton, two-atom symmetric);
//   - the closed-form examples the brief calls out (single, pair,
//     linear chain sink, star);
//   - convergence on the Zachary 1977 karate-club graph -- the two
//     most central nodes (Mr Hi = atom 0 and Officer = atom 33) MUST
//     win the top-2 PR slots, with convergence in <= 30 iterations;
//   - damping = 0 (uniform check confirms the math);
//   - damping = 1000 (no teleport / pure random walk);
//   - dangling-atom mass conservation (total ~1000 milli +/- N);
//   - top_k behaviour at boundaries (k <= 0 empty, k > N returns all);
//   - determinism (rerun on identical input gives identical scores).
//
// Total assertions: ~75 (well above the 25-30 brief target).
//
// ADRs: ADR-0016 (atom + xref shape), ADR-0049 (testing).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/cross_kg_references.nova"
import "../../src/kg/pagerank.nova"

// ---- helpers --------------------------------------------------------------

// Build a fresh KG with `n` atoms, no xrefs. Returns the KG.
fn _mk_kg_n(label, n) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, label)
    let i = 0
    while i < n {
        kg_add_atom(kg, ATOM_FACT, "atom_" + int_to_str(i), 0)
        i = i + 1
    }
    return kg
}

// Add a DIRECTED xref a -> b. PageRank treats the link graph as
// directed -- (a -> b) means a has an out-edge to b and b has an
// in-edge from a, which is the textbook PageRank input.
fn _dir(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    return 1
}

// Add an UNDIRECTED xref pair (both a -> b and b -> a). Used for the
// star and symmetric tests where the brief specifies bidirectional
// links.
fn _link(kg, a_id, b_id) {
    _dir(kg, a_id, b_id)
    _dir(kg, b_id, a_id)
    return 1
}

// ---- empty + singleton edge cases ----------------------------------------

fn test_empty_kg_zero_scores() {
    let kg = _mk_kg_n("test_pr_empty", 0)
    let r = pagerank_default(kg)
    ce_eq("empty KG -> 0 atoms",       pagerank_n_atoms(r), 0)
    ce_eq("empty KG -> 0 iterations",  pagerank_iterations(r), 0)
    ce_eq("empty KG -> converged=yes", pagerank_converged(r), 1)
    let top = pagerank_top_k(r, 5)
    ce_eq("empty KG -> top_k empty",   len(top), 0)
    ce_eq("empty KG -> total mass = 0", pagerank_total_mass(r), 0)
    ce_eq("empty KG -> pagerank_at(0) missing -> -1",
        pagerank_at(r, 0), 0 - 1)
}

fn test_single_atom_all_mass() {
    let kg = _mk_kg_n("test_pr_single", 1)
    let r = pagerank_default(kg)
    ce_eq("single atom -> 1 atom",     pagerank_n_atoms(r), 1)
    ce_eq("single atom -> PR(0) = 1000", pagerank_at(r, 0), 1000)
    let top = pagerank_top_k(r, 5)
    ce_eq("single atom -> top_k(5) has 1 entry", len(top), 1)
    ce_eq("single atom top entry id = 0", top[0][0], 0)
    ce_eq("single atom top entry pr = 1000", top[0][1], 1000)
    // Damping factor stored as requested.
    ce_eq("damping stored = 850", pagerank_damping(r), 850)
}

// ---- two-atom bidirectional: 500 milli each ------------------------------

fn test_two_atoms_symmetric() {
    let kg = _mk_kg_n("test_pr_two", 2)
    _link(kg, 0, 1)
    let r = pagerank_default(kg)
    ce_eq("two atoms -> 2 atoms", pagerank_n_atoms(r), 2)
    let pr0 = pagerank_at(r, 0)
    let pr1 = pagerank_at(r, 1)
    // Both should be ~500 milli; allow +/- 5 milli for rounding.
    ce_near("PR(0) ~= 500", pr0, 500, 5)
    ce_near("PR(1) ~= 500", pr1, 500, 5)
    // Strict equality by symmetry: same graph topology + same indeg/outdeg.
    ce_eq("symmetric pair -> PR(0) == PR(1)", pr0, pr1)
    // Total mass within a few milli of 1000.
    let total = pagerank_total_mass(r)
    ce_near("total mass ~= 1000", total, 1000, 5)
    ce_check("converged on simple pair", pagerank_converged(r) == 1)
}

// ---- linear chain 0->1->2->3->4 (sink at 4) ------------------------------
//
// Atom 4 is a sink (no out-edges). Atom 0 is a source with no in-edges
// (so it only receives teleport mass). With d=0.85 the PR ranking
// becomes: atom 4 > atom 3 > atom 2 > atom 1 > atom 0 (the further
// downstream, the more mass accumulates -- the dangling-sink
// redistribution does a partial reset, but atom 4's directly-received
// mass dominates).
fn test_linear_chain_sink_highest() {
    let kg = _mk_kg_n("test_pr_chain", 5)
    _dir(kg, 0, 1)
    _dir(kg, 1, 2)
    _dir(kg, 2, 3)
    _dir(kg, 3, 4)
    let r = pagerank_default(kg)
    ce_eq("chain -> 5 atoms", pagerank_n_atoms(r), 5)
    let pr0 = pagerank_at(r, 0)
    let pr1 = pagerank_at(r, 1)
    let pr2 = pagerank_at(r, 2)
    let pr3 = pagerank_at(r, 3)
    let pr4 = pagerank_at(r, 4)
    // Sink atom 4 has the highest PR.
    ce_check("chain sink (atom 4) has highest PR > atom 3",
        pr4 > pr3)
    ce_check("chain sink (atom 4) has highest PR > atom 0",
        pr4 > pr0)
    // Source atom 0 has the lowest PR.
    ce_check("chain source (atom 0) has lowest PR < atom 1",
        pr0 < pr1)
    ce_check("chain source (atom 0) has lowest PR < atom 4",
        pr0 < pr4)
    // Monotone gradient down the chain: each atom strictly above the
    // previous toward the sink.
    ce_check("chain monotone: pr1 < pr2", pr1 < pr2)
    ce_check("chain monotone: pr2 < pr3", pr2 < pr3)
    ce_check("chain monotone: pr3 < pr4", pr3 < pr4)
    // Total mass conserved within ~5 milli.
    let total = pagerank_total_mass(r)
    ce_near("chain total mass ~= 1000", total, 1000, 10)
    // top_k(2) -- atom 4 first, then atom 3 (or atom 3 + something
    // close in case of dangling redistribution shuffling things).
    let top = pagerank_top_k(r, 2)
    ce_eq("chain top_k(2) has 2 entries", len(top), 2)
    ce_eq("chain top atom = 4", top[0][0], 4)
    ce_check("chain second-top atom = 3", top[1][0] == 3)
}

// ---- star: 1 center linked to 4 leaves, all bidirectional ---------------
//
// Center is atom 0, leaves are atoms 1..4. With bidirectional links the
// center has indeg=4 + outdeg=4; each leaf has indeg=1 + outdeg=1
// (only the center). PR(center) > PR(leaf) and all leaves are equal.
fn test_star_center_highest() {
    let kg = _mk_kg_n("test_pr_star", 5)
    _link(kg, 0, 1)
    _link(kg, 0, 2)
    _link(kg, 0, 3)
    _link(kg, 0, 4)
    let r = pagerank_default(kg)
    let pr_c = pagerank_at(r, 0)
    let pr_l1 = pagerank_at(r, 1)
    let pr_l2 = pagerank_at(r, 2)
    let pr_l3 = pagerank_at(r, 3)
    let pr_l4 = pagerank_at(r, 4)
    ce_check("star center > leaf 1", pr_c > pr_l1)
    ce_check("star center > leaf 4", pr_c > pr_l4)
    // All leaves equal by symmetry.
    ce_eq("star leaf 1 == leaf 2", pr_l1, pr_l2)
    ce_eq("star leaf 2 == leaf 3", pr_l2, pr_l3)
    ce_eq("star leaf 3 == leaf 4", pr_l3, pr_l4)
    // Center wins top_k(1).
    let top = pagerank_top_k(r, 1)
    ce_eq("star top_k(1) -> center (id 0)", top[0][0], 0)
    // top_k(5) returns all five.
    let all = pagerank_top_k(r, 5)
    ce_eq("star top_k(5) returns all 5", len(all), 5)
}

// ---- damping = 0: uniform distribution (math sanity check) --------------

fn test_damping_zero_uniform() {
    let kg = _mk_kg_n("test_pr_d0", 4)
    _link(kg, 0, 1)
    _link(kg, 1, 2)
    _link(kg, 2, 3)
    // damping=0: PR_new(i) = (1000 - 0)/N + 0 = 1000/N for every i.
    // With N=4 -> PR(i) = 250 milli for every atom regardless of graph
    // shape, after the very first iteration.
    let r = pagerank_compute(kg, 0, 50)
    ce_eq("damping=0 -> stored damping = 0", pagerank_damping(r), 0)
    ce_eq("damping=0 -> 4 atoms", pagerank_n_atoms(r), 4)
    let pr0 = pagerank_at(r, 0)
    let pr1 = pagerank_at(r, 1)
    let pr2 = pagerank_at(r, 2)
    let pr3 = pagerank_at(r, 3)
    ce_eq("damping=0 -> PR(0) = 250", pr0, 250)
    ce_eq("damping=0 -> PR(1) = 250", pr1, 250)
    ce_eq("damping=0 -> PR(2) = 250", pr2, 250)
    ce_eq("damping=0 -> PR(3) = 250", pr3, 250)
    ce_check("damping=0 converged", pagerank_converged(r) == 1)
    // Converges fast -- one iteration suffices because uniform is the
    // fixed point.
    ce_check("damping=0 converged in <= 2 iters",
        pagerank_iterations(r) <= 2)
}

// ---- damping = 1000: pure random walk (no teleport) ---------------------
//
// With d=1000 the (1000 - d) teleport disappears. Mass redistributes
// strictly along edges + dangling redistribution. On a strongly-
// connected graph it should still converge to the eigenvector solution;
// on a disconnected graph the dangling redistribution keeps things
// stable. We only check that the algorithm terminates cleanly and
// preserves mass; the EXACT distribution may differ from d=850.
fn test_damping_one_thousand() {
    let kg = _mk_kg_n("test_pr_d1000", 3)
    _link(kg, 0, 1)
    _link(kg, 1, 2)
    let r = pagerank_compute(kg, 1000, 50)
    ce_eq("damping=1000 -> stored damping = 1000",
        pagerank_damping(r), 1000)
    ce_eq("damping=1000 -> 3 atoms", pagerank_n_atoms(r), 3)
    let total = pagerank_total_mass(r)
    // Mass should be ~1000, but the no-teleport variant can drift
    // slightly through repeated integer truncation -- allow generous
    // tolerance (+/- 50 milli for N=3).
    ce_check("damping=1000 -> total mass between 900 and 1050",
        total >= 900)
    ce_check("damping=1000 -> total mass between 900 and 1050",
        total <= 1050)
    // Every score non-negative.
    ce_check("damping=1000 -> PR(0) >= 0", pagerank_at(r, 0) >= 0)
    ce_check("damping=1000 -> PR(1) >= 0", pagerank_at(r, 1) >= 0)
    ce_check("damping=1000 -> PR(2) >= 0", pagerank_at(r, 2) >= 0)
}

// ---- damping clamping above 1000 ----------------------------------------

fn test_damping_above_1000_clamps() {
    let kg = _mk_kg_n("test_pr_clamp_hi", 3)
    _link(kg, 0, 1)
    let r = pagerank_compute(kg, 2000, 50)
    ce_eq("damping > 1000 -> stored damping = 1000",
        pagerank_damping(r), 1000)
}

fn test_damping_negative_uses_default() {
    let kg = _mk_kg_n("test_pr_neg", 3)
    _link(kg, 0, 1)
    let r = pagerank_compute(kg, 0 - 1, 50)
    ce_eq("damping < 0 -> stored damping = default 850",
        pagerank_damping(r), 850)
}

// ---- dangling-atom mass conservation ------------------------------------
//
// All four atoms are sinks (no out-edges); the dangling redistribution
// uniformly re-injects mass each iteration. PR should remain uniform
// and total mass ~= 1000 milli within rounding.
fn test_dangling_only_uniform() {
    let kg = _mk_kg_n("test_pr_dangling", 4)
    // No xrefs at all. Every atom has out_deg=0 and in_deg=0.
    let r = pagerank_default(kg)
    let pr0 = pagerank_at(r, 0)
    let pr1 = pagerank_at(r, 1)
    let pr2 = pagerank_at(r, 2)
    let pr3 = pagerank_at(r, 3)
    // All equal -- pure-dangling reduces to uniform teleport.
    ce_eq("dangling -> PR(0) == PR(1)", pr0, pr1)
    ce_eq("dangling -> PR(1) == PR(2)", pr1, pr2)
    ce_eq("dangling -> PR(2) == PR(3)", pr2, pr3)
    // Total within +/- 5 milli of 1000.
    let total = pagerank_total_mass(r)
    ce_near("dangling-only total mass ~= 1000", total, 1000, 10)
}

fn test_dangling_mixed_mass_conserved() {
    // Mix: atoms 0,1 link to each other (no sinks among them); atom 2
    // is a pure sink (no out-edges). PR(2) should accumulate as much
    // as the dangling redistribution lets it -- but mass is conserved.
    let kg = _mk_kg_n("test_pr_dangling_mixed", 3)
    _link(kg, 0, 1)
    // atom 2 has no edges -> dangling
    let r = pagerank_default(kg)
    let total = pagerank_total_mass(r)
    ce_near("mixed dangling -- mass ~= 1000 +/- 10 milli",
        total, 1000, 10)
    ce_check("mixed dangling -- all PR non-negative",
        pagerank_at(r, 0) >= 0)
    ce_check("mixed dangling -- all PR non-negative",
        pagerank_at(r, 1) >= 0)
    ce_check("mixed dangling -- all PR non-negative",
        pagerank_at(r, 2) >= 0)
}

// ---- top_k boundary semantics -------------------------------------------

fn test_top_k_zero_empty() {
    let kg = _mk_kg_n("test_pr_topk0", 3)
    _link(kg, 0, 1)
    let r = pagerank_default(kg)
    let top = pagerank_top_k(r, 0)
    ce_eq("top_k(0) -> empty list", len(top), 0)
    let top_neg = pagerank_top_k(r, 0 - 5)
    ce_eq("top_k(-5) -> empty list", len(top_neg), 0)
}

fn test_top_k_larger_than_n_clamps() {
    let kg = _mk_kg_n("test_pr_topk_big", 3)
    _link(kg, 0, 1)
    let r = pagerank_default(kg)
    let top = pagerank_top_k(r, 100)
    ce_eq("top_k(100) on N=3 -> 3 entries", len(top), 3)
}

fn test_top_k_descending_order() {
    // 5 atoms, ordered structure where atom 4 > atom 0 > etc.
    let kg = _mk_kg_n("test_pr_topk_order", 5)
    _dir(kg, 0, 4)
    _dir(kg, 1, 4)
    _dir(kg, 2, 4)
    _dir(kg, 3, 4)
    let r = pagerank_default(kg)
    let top = pagerank_top_k(r, 5)
    ce_eq("top_k(5) -> 5 entries", len(top), 5)
    // First entry is the atom with highest PR; atom 4 collects all
    // in-mass from 0..3 so PR(4) is highest.
    ce_eq("first top = atom 4", top[0][0], 4)
    // Strict descending order on scores.
    ce_check("top sorted desc: top[0] >= top[1]", top[0][1] >= top[1][1])
    ce_check("top sorted desc: top[1] >= top[2]", top[1][1] >= top[2][1])
    ce_check("top sorted desc: top[2] >= top[3]", top[2][1] >= top[3][1])
    ce_check("top sorted desc: top[3] >= top[4]", top[3][1] >= top[4][1])
}

// ---- determinism --------------------------------------------------------

fn test_determinism_identical_runs() {
    let kg_a = _mk_kg_n("test_pr_det_a", 4)
    _link(kg_a, 0, 1)
    _link(kg_a, 1, 2)
    _link(kg_a, 2, 3)
    let r_a = pagerank_default(kg_a)

    let kg_b = _mk_kg_n("test_pr_det_b", 4)
    _link(kg_b, 0, 1)
    _link(kg_b, 1, 2)
    _link(kg_b, 2, 3)
    let r_b = pagerank_default(kg_b)

    let i = 0
    while i < 4 {
        ce_eq("determinism: PR matches at atom " + int_to_str(i),
            pagerank_at(r_a, i), pagerank_at(r_b, i))
        i = i + 1
    }
    ce_eq("determinism: iterations match",
        pagerank_iterations(r_a), pagerank_iterations(r_b))
    ce_eq("determinism: converged matches",
        pagerank_converged(r_a), pagerank_converged(r_b))
}

// ---- Zachary 1977 karate-club graph -- the big one ---------------------
//
// Real-world graph: 34 atoms, 78 friendship edges (78 undirected ->
// each link is registered as a bidirectional pair in our extractor).
// Mr Hi = atom 0 (the instructor); Officer / John A. = atom 33 (the
// club president). These two have the highest in-degree by far (16 and
// 17 respectively, of the 34 nodes), so PageRank's top-2 must be
// {0, 33} in some order, and convergence must happen within 30 iters
// per Brin & Page's empirical bound.
fn _build_karate(label) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, label)
    let i = 0
    while i < 34 {
        kg_add_atom(kg, ATOM_FACT, "k_" + int_to_str(i), 0)
        i = i + 1
    }
    // Mr Hi (atom 0) -- big clique.
    _link(kg, 0, 1)   _link(kg, 0, 2)   _link(kg, 0, 3)   _link(kg, 0, 4)
    _link(kg, 0, 5)   _link(kg, 0, 6)   _link(kg, 0, 7)   _link(kg, 0, 8)
    _link(kg, 0, 10)  _link(kg, 0, 11)  _link(kg, 0, 12)  _link(kg, 0, 13)
    _link(kg, 0, 17)  _link(kg, 0, 19)  _link(kg, 0, 21)  _link(kg, 0, 31)
    _link(kg, 1, 2)   _link(kg, 1, 3)   _link(kg, 1, 7)   _link(kg, 1, 13)
    _link(kg, 1, 17)  _link(kg, 1, 19)  _link(kg, 1, 21)  _link(kg, 1, 30)
    _link(kg, 2, 3)   _link(kg, 2, 7)   _link(kg, 2, 8)   _link(kg, 2, 9)
    _link(kg, 2, 13)  _link(kg, 2, 27)  _link(kg, 2, 28)  _link(kg, 2, 32)
    _link(kg, 3, 7)   _link(kg, 3, 12)  _link(kg, 3, 13)
    _link(kg, 4, 6)   _link(kg, 4, 10)
    _link(kg, 5, 6)   _link(kg, 5, 10)  _link(kg, 5, 16)
    _link(kg, 6, 16)
    _link(kg, 8, 30)  _link(kg, 8, 32)  _link(kg, 8, 33)
    _link(kg, 9, 33)
    _link(kg, 13, 33)
    _link(kg, 14, 32) _link(kg, 14, 33)
    _link(kg, 15, 32) _link(kg, 15, 33)
    _link(kg, 18, 32) _link(kg, 18, 33)
    _link(kg, 19, 33)
    _link(kg, 20, 32) _link(kg, 20, 33)
    _link(kg, 22, 32) _link(kg, 22, 33)
    _link(kg, 23, 25) _link(kg, 23, 27) _link(kg, 23, 29) _link(kg, 23, 32) _link(kg, 23, 33)
    _link(kg, 24, 25) _link(kg, 24, 27) _link(kg, 24, 31)
    _link(kg, 25, 31)
    _link(kg, 26, 29) _link(kg, 26, 33)
    _link(kg, 27, 33)
    _link(kg, 28, 31) _link(kg, 28, 33)
    _link(kg, 29, 32) _link(kg, 29, 33)
    _link(kg, 30, 32) _link(kg, 30, 33)
    _link(kg, 31, 32) _link(kg, 31, 33)
    _link(kg, 32, 33)
    return kg
}

fn test_karate_top_two_are_hi_and_officer() {
    let kg = _build_karate("test_pr_karate")
    let r = pagerank_default(kg)
    ce_eq("karate -> 34 atoms", pagerank_n_atoms(r), 34)
    // Mr Hi (0) and Officer (33) must own the top-2 PR scores. We do
    // not commit to the order between them -- both have very similar
    // degree (Mr Hi 16, Officer 17), but the canonical Brin & Page
    // result on Zachary puts them as the top two centrality nodes.
    let top = pagerank_top_k(r, 2)
    ce_eq("karate top_k(2) -> 2 entries", len(top), 2)
    let a = top[0][0]
    let b = top[1][0]
    let ok = 0
    if a == 0 {
        if b == 33 { ok = 1 }
    }
    if a == 33 {
        if b == 0 { ok = 1 }
    }
    ce_check("karate top-2 are {0, 33}", ok == 1)
    // Convergence must happen within 30 iterations (well below the
    // default cap of 50).
    ce_check("karate converges <= 30 iters",
        pagerank_iterations(r) <= 30)
    ce_check("karate converges (L_inf threshold)",
        pagerank_converged(r) == 1)
    // Atoms 0 and 33 strictly beat the rest of the field.
    let pr0 = pagerank_at(r, 0)
    let pr33 = pagerank_at(r, 33)
    let pr_max_other = 0
    let i = 1
    while i < 33 {
        let p = pagerank_at(r, i)
        if p > pr_max_other { pr_max_other = p }
        i = i + 1
    }
    ce_check("karate: PR(0) > best non-hub", pr0 > pr_max_other)
    ce_check("karate: PR(33) > best non-hub", pr33 > pr_max_other)
    // Total mass conserved within +/- 50 milli for N=34.
    let total = pagerank_total_mass(r)
    ce_near("karate total mass ~= 1000 milli", total, 1000, 50)
}

// ---- pagerank_at on missing id ------------------------------------------

fn test_pagerank_at_missing() {
    let kg = _mk_kg_n("test_pr_missing", 2)
    _link(kg, 0, 1)
    let r = pagerank_default(kg)
    ce_eq("pagerank_at(missing id) -> -1",
        pagerank_at(r, 999), 0 - 1)
}

// ---- iteration cap clamp (max_iter <= 0 uses default) -------------------

fn test_max_iter_zero_uses_default() {
    let kg = _mk_kg_n("test_pr_maxiter", 3)
    _link(kg, 0, 1)
    _link(kg, 1, 2)
    let r_def = pagerank_compute(kg, 850, PR_DEFAULT_MAX_ITER)
    let r_zero = pagerank_compute(kg, 850, 0)
    // Same fixed point regardless of how we got there.
    ce_eq("max_iter=0 -> matches default at atom 0",
        pagerank_at(r_def, 0), pagerank_at(r_zero, 0))
    ce_eq("max_iter=0 -> matches default at atom 1",
        pagerank_at(r_def, 1), pagerank_at(r_zero, 1))
    ce_eq("max_iter=0 -> matches default at atom 2",
        pagerank_at(r_def, 2), pagerank_at(r_zero, 2))
}

// ---- iteration cap forces non-convergence -------------------------------

fn test_low_max_iter_can_miss_convergence() {
    // Tighten the cap to 1 iteration on a chain -- with d=0.85, one
    // pass cannot fully redistribute mass into the sink. We expect
    // converged=0 (the L_inf delta won't drop below 1 milli that fast
    // on a 5-atom chain).
    let kg = _mk_kg_n("test_pr_low_iter", 5)
    _dir(kg, 0, 1)
    _dir(kg, 1, 2)
    _dir(kg, 2, 3)
    _dir(kg, 3, 4)
    let r = pagerank_compute(kg, 850, 1)
    ce_eq("max_iter=1 -> iterations=1", pagerank_iterations(r), 1)
    // converged may be 0 OR 1 depending on starting delta. Just check
    // we ran exactly one pass.
}

fn main() {
    test_empty_kg_zero_scores()
    test_single_atom_all_mass()
    test_two_atoms_symmetric()
    test_linear_chain_sink_highest()
    test_star_center_highest()
    test_damping_zero_uniform()
    test_damping_one_thousand()
    test_damping_above_1000_clamps()
    test_damping_negative_uses_default()
    test_dangling_only_uniform()
    test_dangling_mixed_mass_conserved()
    test_top_k_zero_empty()
    test_top_k_larger_than_n_clamps()
    test_top_k_descending_order()
    test_determinism_identical_runs()
    test_karate_top_two_are_hi_and_officer()
    test_pagerank_at_missing()
    test_max_iter_zero_uses_default()
    test_low_max_iter_can_miss_convergence()
    ce_summary("pagerank")
}

main()
