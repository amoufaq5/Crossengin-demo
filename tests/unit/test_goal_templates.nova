// Unit tests for src/parts/action/goal_templates.nova
//
// Verifies the Phase R4 (ADR-0112) goal-template registry mirror of
// motor_map: fresh handle shape, register/lookup, duplicate upsert,
// miss returns 0, expand substitutes %ID% / %NAME%, and the default
// seed exposes the FILE + CODE entries.

import "../ce_test.nova"
import "../../src/parts/action/goal_templates.nova"

// ---- subtest 1: fresh handle has tag + empty entries list ---------------
fn test_goal_templates_new_empty() {
    let gt = goal_templates_new()
    ce_check("new is map", gt_is_map(gt) == 1)
    ce_eq("new size", goal_templates_size(gt), 0)
    ce_eq("lookup on empty returns 0",
          goal_templates_lookup(gt, "write_a_note"), 0)
}

// ---- subtest 2: register once, look it up -------------------------------
fn test_goal_templates_register_and_lookup() {
    let gt = goal_templates_new()
    let t = list_new()
    push(t, "file")
    push(t, "/tmp/ce_note_%ID%.txt")
    push(t, "%NAME%")
    ce_eq("register ok",
          goal_templates_register(gt, "write_a_note", t), 1)
    ce_eq("size after register", goal_templates_size(gt), 1)
    let hit = goal_templates_lookup(gt, "write_a_note")
    ce_check("lookup hit non-zero", hit != 0)
    ce_eq("hit length", len(hit), 3)
    ce_str_eq("hit class tag", hit[0], "file")
    ce_str_eq("hit path template", hit[1], "/tmp/ce_note_%ID%.txt")
    ce_str_eq("hit content template", hit[2], "%NAME%")
}

// ---- subtest 3: duplicate key overwrites -------------------------------
fn test_goal_templates_register_overwrites_duplicate() {
    let gt = goal_templates_new()
    let t1 = list_new()
    push(t1, "file")
    push(t1, "/old/%ID%.txt")
    goal_templates_register(gt, "write_a_note", t1)
    let t2 = list_new()
    push(t2, "file")
    push(t2, "/new/%ID%.txt")
    push(t2, "%NAME%")
    ce_eq("overwrite ok",
          goal_templates_register(gt, "write_a_note", t2), 1)
    ce_eq("size unchanged on overwrite", goal_templates_size(gt), 1)
    let hit = goal_templates_lookup(gt, "write_a_note")
    ce_eq("hit length after overwrite", len(hit), 3)
    ce_str_eq("hit path reflects overwrite",
              hit[1], "/new/%ID%.txt")
    ce_str_eq("hit content reflects overwrite",
              hit[2], "%NAME%")
}

// ---- subtest 4: unknown key returns 0 ----------------------------------
fn test_goal_templates_lookup_miss_returns_zero() {
    let gt = goal_templates_new()
    let t = list_new()
    push(t, "file")
    push(t, "/tmp/x.txt")
    goal_templates_register(gt, "write_a_note", t)
    ce_eq("miss returns 0",
          goal_templates_lookup(gt, "no_such_goal"), 0)
    // Guards.
    ce_eq("is_map on 0", gt_is_map(0), 0)
    ce_eq("lookup on 0 handle returns 0",
          goal_templates_lookup(0, "anything"), 0)
    ce_eq("lookup with null key returns 0",
          goal_templates_lookup(gt, 0), 0)
}

// ---- subtest 5: expand substitutes %ID% and %NAME% ---------------------
//
// Pass the template body WITHOUT the class tag (operand_builder slices
// `hit[1..]` before calling expand). With goal_id=7 and
// goal_name="write_a_note", the body
// `["/tmp/ce_note_%ID%.txt", "%NAME%"]` must become
// `["/tmp/ce_note_7.txt", "write_a_note"]`.
fn test_goal_templates_expand_substitutes_id_and_name() {
    let body = list_new()
    push(body, "/tmp/ce_note_%ID%.txt")
    push(body, "%NAME%")
    let out = goal_templates_expand(body, 7, "write_a_note")
    ce_eq("expand length", len(out), 2)
    ce_str_eq("expand %ID% substituted in path",
              out[0], "/tmp/ce_note_7.txt")
    ce_str_eq("expand %NAME% substituted verbatim",
              out[1], "write_a_note")
    // A slot without placeholders is copied through.
    let body2 = list_new()
    push(body2, "constant_string")
    push(body2, "prefix_%ID%_suffix_%NAME%_tail")
    let out2 = goal_templates_expand(body2, 42, "fetch_url")
    ce_str_eq("expand no-placeholder slot unchanged",
              out2[0], "constant_string")
    ce_str_eq("expand mixed-placeholder slot",
              out2[1], "prefix_42_suffix_fetch_url_tail")
}

// ---- subtest 6: default seed covers FILE + CODE ------------------------
fn test_goal_templates_default_covers_file_and_code() {
    let gt = goal_templates_default()
    ce_check("default is map", gt_is_map(gt) == 1)
    ce_eq("default size", goal_templates_size(gt), 2)
    let f = goal_templates_lookup(gt, "write_a_note")
    ce_check("default has write_a_note", f != 0)
    ce_str_eq("default FILE class tag", f[0], "file")
    ce_str_eq("default FILE path template",
              f[1], "/tmp/ce_note_%ID%.txt")
    ce_str_eq("default FILE content template", f[2], "%NAME%")
    let c = goal_templates_lookup(gt, "run_code")
    ce_check("default has run_code", c != 0)
    ce_str_eq("default CODE class tag", c[0], "code")
    ce_str_eq("default CODE expr template", c[1], "1 + %ID%")
    // Unknown goal still misses (no "search_the_web" seed in R4).
    ce_eq("default miss on HTTP keyword",
          goal_templates_lookup(gt, "search_the_web"), 0)
}

fn main() {
    test_goal_templates_new_empty()
    test_goal_templates_register_and_lookup()
    test_goal_templates_register_overwrites_duplicate()
    test_goal_templates_lookup_miss_returns_zero()
    test_goal_templates_expand_substitutes_id_and_name()
    test_goal_templates_default_covers_file_and_code()
    ce_summary("goal_templates")
}
main()
