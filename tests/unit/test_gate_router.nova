// Unit tests for src/substrate/gate_router.nova
// Verifies preset-seeded routing, the admit threshold, reinforcement (incl.
// route creation), decay+prune, and the privileged, non-learnable
// constitutional broadcast. ADR-0009, ADR-0045, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/gate_router.nova"

fn build_gate() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    let gate = gate_new(reg)
    gate_seed_from_parts(gate, reg)
    return [reg, gate]
}

fn test_seeded_routes() {
    let env = build_gate()
    let reg = env[0]
    let gate = env[1]
    let perception = registry_find(reg, "perception")
    let reasoning = registry_find(reg, "reasoning")
    let action = registry_find(reg, "action")
    let episodic = registry_find(reg, "episodic")

    ce_eq("SENSORY seed weight", gate_weight(gate, XSIG_SENSORY, perception), GATE_SEED_W)
    // SENSORY -> perception only.
    let s = gate_route(gate, sig_new(XSIG_SENSORY, -1, -1, 100, 0, 0))
    ce_eq("SENSORY one dest", len(s), 1)
    ce_check("SENSORY -> perception", contains(s, perception) == 1)
    // GOAL -> reasoning AND action (ADR-0009 prior).
    let g = gate_route(gate, sig_new(XSIG_GOAL, -1, -1, 100, 0, 0))
    ce_eq("GOAL two dests", len(g), 2)
    ce_check("GOAL -> reasoning", contains(g, reasoning) == 1)
    ce_check("GOAL -> action", contains(g, action) == 1)
    // RECALL -> episodic.
    let r = gate_route(gate, sig_new(XSIG_RECALL, -1, -1, 100, 0, 0))
    ce_check("RECALL -> episodic", contains(r, episodic) == 1)
}

fn test_admit_threshold() {
    let env = build_gate()
    let reg = env[0]
    let gate = env[1]
    let perception = registry_find(reg, "perception")
    // A weak route (<= admit) does not deliver.
    gate_add_route(gate, XSIG_EXCITE, perception, 50)
    let d1 = gate_route(gate, sig_new(XSIG_EXCITE, -1, -1, 100, 0, 0))
    ce_check("weak route not admitted", contains(d1, perception) == 0)
    // Reinforce above the threshold -> now delivers.
    gate_reinforce(gate, XSIG_EXCITE, perception, 100)
    ce_eq("reinforced weight", gate_weight(gate, XSIG_EXCITE, perception), 150)
    let d2 = gate_route(gate, sig_new(XSIG_EXCITE, -1, -1, 100, 0, 0))
    ce_check("strong route admitted", contains(d2, perception) == 1)
}

fn test_reinforce_creates_and_dedups() {
    let env = build_gate()
    let reg = env[0]
    let gate = env[1]
    let reasoning = registry_find(reg, "reasoning")
    let action = registry_find(reg, "action")
    // Positive delta on a missing route creates it.
    gate_reinforce(gate, XSIG_ANALOGY, reasoning, 300)
    ce_eq("created route weight", gate_weight(gate, XSIG_ANALOGY, reasoning), 300)
    // Negative delta on a missing route does nothing.
    ce_eq("no create on negative", gate_reinforce(gate, XSIG_ANALOGY, action, -100), 0)
    ce_eq("still one analogy route", gate_route_count(gate, XSIG_ANALOGY), 1)
    // Re-adding an existing route updates in place (no duplicate).
    gate_add_route(gate, XSIG_ANALOGY, reasoning, 800)
    ce_eq("updated not duplicated", gate_route_count(gate, XSIG_ANALOGY), 1)
    ce_eq("weight updated", gate_weight(gate, XSIG_ANALOGY, reasoning), 800)
}

fn test_decay_and_prune() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    let gate = gate_new(reg)
    let perception = registry_find(reg, "perception")
    gate_add_route(gate, XSIG_EXCITE, perception, 700)
    ce_eq("one route before", gate_route_count(gate, XSIG_EXCITE), 1)
    // Decay 0.03x -> 21, at/below prune threshold (30).
    gate_decay(gate, 30)
    ce_eq("decayed weight", gate_weight(gate, XSIG_EXCITE, perception), 21)
    ce_eq("one pruned", gate_prune(gate), 1)
    ce_eq("route gone", gate_route_count(gate, XSIG_EXCITE), 0)
}

fn test_constitutional_is_privileged() {
    let env = build_gate()
    let reg = env[0]
    let gate = env[1]
    // CONST broadcasts to ALL parts regardless of any table state.
    let dests = gate_route(gate, sig_new(XSIG_CONST, -1, -1, 100, 0, 0))
    ce_eq("CONST broadcasts to all parts", len(dests), registry_count(reg))
    // CONST is never tabled and cannot be added, reinforced, or pruned.
    ce_eq("cannot add CONST route", gate_add_route(gate, XSIG_CONST, 0, 900), 0)
    ce_eq("cannot reinforce CONST", gate_reinforce(gate, XSIG_CONST, 0, 900), 0)
    ce_eq("CONST not in table", gate_route_count(gate, XSIG_CONST), 0)
    // Pruning never affects the constitutional broadcast.
    gate_prune(gate)
    let after = gate_route(gate, sig_new(XSIG_CONST, -1, -1, 100, 0, 0))
    ce_eq("CONST still broadcasts after prune", len(after), registry_count(reg))
}

fn main() {
    test_seeded_routes()
    test_admit_threshold()
    test_reinforce_creates_and_dedups()
    test_decay_and_prune()
    test_constitutional_is_privileged()
    ce_summary("gate_router")
}

main()
