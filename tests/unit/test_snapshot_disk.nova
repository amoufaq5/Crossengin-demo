// Unit tests for src/persistence/snapshot_disk.nova
// Verifies the text encode/decode round-trip + the durable on-disk write/read
// via NOVA's sys_open/sys_fsync/sys_rename. Uses /tmp paths so the test never
// touches the real working tree. ADR-0048 (snapshot container + runtime seam).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"

fn _build_full_snap() {
    let s = snap_new(42, 12345)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 7)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 572)
    snap_put_section(s, SEC_KGS, kb)
    return s
}

fn test_text_roundtrip_full() {
    let s = _build_full_snap()
    let text = snap_to_text(s)
    ce_check("encoded text non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("decoded snapshot valid", snap_valid(s2) == 1)
    ce_eq("instance survives", snap_instance(s2), 42)
    ce_eq("timestamp survives", snap_timestamp(s2), 12345)
    ce_check("soul section present", snap_has_section(s2, SEC_SOUL) == 1)
    ce_str_eq("soul name survives", snap_section(s2, SEC_SOUL)[0], "Aurora")
    ce_eq("soul constcount survives", snap_section(s2, SEC_SOUL)[1], 7)
    ce_check("kgs section present", snap_has_section(s2, SEC_KGS) == 1)
    ce_eq("kgs atomcount survives", snap_section(s2, SEC_KGS)[0], 572)
    ce_eq("episodic absent", snap_has_section(s2, SEC_EPISODIC), 0)
    ce_eq("synapses absent", snap_has_section(s2, SEC_SYNAPSES), 0)
    ce_eq("selfmodel absent", snap_has_section(s2, SEC_SELFMODEL), 0)
}

fn test_text_rejects_bad_header() {
    let bogus = "not-a-snapshot\nend\n"
    ce_eq("bogus header rejected", snap_from_text(bogus), 0)
}

fn test_text_rejects_missing_end() {
    let s = _build_full_snap()
    let text = snap_to_text(s)
    let trimmed = substr(text, 0, len(text) - 4)   // chop "end\n"
    ce_eq("missing 'end' rejected", snap_from_text(trimmed), 0)
}

fn test_text_rejects_wrong_tag() {
    let tampered = "crossengin-snapshot v1\ntag 1\nver 1\ninstance 1\ntimestamp 1\nsections 5\nsoul.present 0\nkgs.present 0\nepisodic.present 0\nsynapses.present 0\nselfmodel.present 0\nend\n"
    ce_eq("wrong tag rejected", snap_from_text(tampered), 0)
}

fn test_durable_write_read() {
    let s = _build_full_snap()
    let path = "/tmp/crossengin_test_snap.dat"
    sys_unlink(path)
    let ok = snap_save(s, path)
    ce_eq("snap_save returned 1", ok, 1)
    let loaded = snap_load(path)
    ce_check("snap_load returned a value", loaded != 0)
    ce_check("loaded snapshot valid", snap_valid(loaded) == 1)
    ce_eq("loaded instance matches", snap_instance(loaded), 42)
    ce_str_eq("loaded soul name matches", snap_section(loaded, SEC_SOUL)[0], "Aurora")
    ce_eq("loaded kgs atomcount matches", snap_section(loaded, SEC_KGS)[0], 572)
    sys_unlink(path)
    sys_unlink(snap_tmp_path(path))
}

fn test_durable_write_overwrites_atomically() {
    let path = "/tmp/crossengin_test_snap_overwrite.dat"
    sys_unlink(path)
    let s1 = snap_new(1, 100)
    let sb1 = list_new() push(sb1, "Aurora") push(sb1, 0)
    snap_put_section(s1, SEC_SOUL, sb1)
    ce_eq("first save ok", snap_save(s1, path), 1)
    let s2 = snap_new(2, 200)
    let sb2 = list_new() push(sb2, "Borealis") push(sb2, 3)
    snap_put_section(s2, SEC_SOUL, sb2)
    ce_eq("second save ok", snap_save(s2, path), 1)
    let loaded = snap_load(path)
    ce_str_eq("final image is the second one", snap_section(loaded, SEC_SOUL)[0], "Borealis")
    ce_eq("final image instance is the second one", snap_instance(loaded), 2)
    sys_unlink(path)
    sys_unlink(snap_tmp_path(path))
}

fn test_load_missing_returns_zero() {
    let path = "/tmp/crossengin_test_snap_does_not_exist.dat"
    sys_unlink(path)
    ce_eq("loading missing file is 0", snap_load(path), 0)
}

fn test_load_corrupt_returns_zero() {
    let path = "/tmp/crossengin_test_snap_corrupt.dat"
    sys_unlink(path)
    let flags = O_WRONLY + O_CREAT + O_TRUNC
    let fd = sys_open(path, flags, 420)
    let garbage = "garbage that is not a snapshot\n"
    sys_write(fd, garbage, len(garbage))
    sys_close(fd)
    ce_eq("loading corrupt file is 0", snap_load(path), 0)
    sys_unlink(path)
}

fn test_parent_dir_resolution() {
    ce_str_eq("parent of /tmp/foo.dat", _parent_dir("/tmp/foo.dat"), "/tmp")
    ce_str_eq("parent of bare filename", _parent_dir("foo.dat"), ".")
    ce_str_eq("parent of root-level file", _parent_dir("/foo"), "/")
    ce_str_eq("parent of nested path", _parent_dir("a/b/c.dat"), "a/b")
}

fn main() {
    test_text_roundtrip_full()
    test_text_rejects_bad_header()
    test_text_rejects_missing_end()
    test_text_rejects_wrong_tag()
    test_durable_write_read()
    test_durable_write_overwrites_atomically()
    test_load_missing_returns_zero()
    test_load_corrupt_returns_zero()
    test_parent_dir_resolution()
    ce_summary("snapshot_disk")
}
main()
