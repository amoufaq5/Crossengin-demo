// Unit tests for src/scheduler/event_dispatch.nova
// Verifies event posting, priority-then-FIFO draining, and pending count.
// ADR-0037.

import "../ce_test.nova"
import "../../src/scheduler/event_dispatch.nova"

fn test_queue() {
    let q = evq_new()
    ce_eq("empty", evq_is_empty(q), 1)
    ce_eq("drain empty -> 0", evq_drain(q), 0)
    evq_post(q, EV_EMOTION, 100)    // pri 2
    evq_post(q, EV_MESSAGE, 200)    // pri 9
    evq_post(q, EV_MOMENT, 300)     // pri 7
    evq_post(q, EV_MESSAGE, 201)    // pri 9 (after first message)
    ce_eq("four pending", evq_pending(q), 4)
    // Highest priority first; FIFO within a priority.
    ce_eq("message first", event_payload(evq_drain(q)), 200)
    ce_eq("second message", event_payload(evq_drain(q)), 201)
    ce_eq("then moment", event_payload(evq_drain(q)), 300)
    ce_eq("then emotion", event_payload(evq_drain(q)), 100)
    ce_eq("drained", evq_is_empty(q), 1)
}

fn test_priority_map() {
    ce_check("message > moment", event_priority(EV_MESSAGE) > event_priority(EV_MOMENT))
    ce_check("moment > goal", event_priority(EV_MOMENT) > event_priority(EV_GOAL))
}

// Regression guard for the NOVA list_remove tagging bug in evq_drain:
// drain a queue of same-priority events. Each drain must return each event
// exactly once, in order. Previously two consecutive drains silently returned
// the SAME event.
fn test_drain_no_duplicates() {
    let q = evq_new()
    evq_post(q, EV_MOMENT, 10)
    evq_post(q, EV_MOMENT, 11)
    evq_post(q, EV_MOMENT, 12)
    evq_post(q, EV_MOMENT, 13)
    ce_eq("drain 1 payload=10", event_payload(evq_drain(q)), 10)
    ce_eq("drain 2 payload=11", event_payload(evq_drain(q)), 11)
    ce_eq("drain 3 payload=12", event_payload(evq_drain(q)), 12)
    ce_eq("drain 4 payload=13", event_payload(evq_drain(q)), 13)
    ce_eq("empty after N drains", evq_is_empty(q), 1)
}

fn main() { test_queue() test_priority_map() test_drain_no_duplicates() ce_summary("event_dispatch") }
main()
