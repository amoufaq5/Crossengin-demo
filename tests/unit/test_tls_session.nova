// Unit tests for src/net/tls/tls_session.nova.
//
// Crown jewel: build a server session with a cert, build a client
// session with the root, alternately drain each side's outbound into
// the other's inbound, step until both handshake_done, and verify
// they derived byte-identical application traffic secrets.
//
// Also verifies application-data round-trip in both directions,
// sequence-counter correctness across multiple records, and the
// close_notify flow.
//
// Tamper suite (bad root, expired leaf, wrong CertVerify sig, wrong
// server Finished, wrong client Finished, wrong cipher, wrong group)
// lives in test_tls_session_tamper.nova alongside.

import "../ce_test.nova"
import "../../src/safety/rng.nova"
import "../../src/safety/ed25519.nova"
import "../../src/net/tls/tls_session.nova"
import "../../src/net/tls/tls_handshake.nova"
import "./fixtures/x509_test_certs.nova"

let _TS_NOW = 1718452800   // 2024-06-15 12:00:00 UTC

// Build a fresh RNG from a seed string.
fn _ts_rng(seed_str) {
    let ctx = list_new()
    let sb = list_new()
    let i = 0
    let n = len(seed_str)
    while i < n {
        push(sb, char_at(seed_str, i))
        i = i + 1
    }
    let buf = alloc(n + 1)
    let j = 0
    while j < n { store8(buf + j, sb[j]); j = j + 1 }
    store8(buf + n, 0)
    rng_test_new(ctx, buf, n)
    return ctx
}

// Build the "TCC" root cert + leaf cert pair (mirrors test_tls_cert_chain).
let _TS_ROOT_CACHE = list_new()
let _TS_LEAF_CACHE = list_new()

fn _ts_root() {
    if len(_TS_ROOT_CACHE) == 0 {
        let pk = fx_ed25519_test1_pub()
        let sk = fx_ed25519_test1_seed()
        let c = x509_build_test_cert("TS_Root", "TS_Root", 1,
                                     "200101000000Z", "490101000000Z",
                                     pk, sk, pk)
        let i = 0
        while i < len(c) { push(_TS_ROOT_CACHE, c[i]); i = i + 1 }
    }
    return _TS_ROOT_CACHE
}

fn _ts_leaf() {
    if len(_TS_LEAF_CACHE) == 0 {
        let leaf_pk = fx_ed25519_test2_pub()
        let root_sk = fx_ed25519_test1_seed()
        let root_pk = fx_ed25519_test1_pub()
        let c = x509_build_test_cert("TS_Leaf", "TS_Root", 2,
                                     "200101000000Z", "490101000000Z",
                                     leaf_pk, root_sk, root_pk)
        let i = 0
        while i < len(c) { push(_TS_LEAF_CACHE, c[i]); i = i + 1 }
    }
    return _TS_LEAF_CACHE
}

// Pump: repeatedly drain each side's outbound and feed to the other's
// recv, up to `max_iter` iterations or until both sides are done.
// Returns the number of iterations used.
fn _ts_pump(client, server, max_iter) {
    let it = 0
    while it < max_iter {
        let cout = list_new()
        session_drain_send(client, cout, 65536)
        let sout = list_new()
        session_drain_send(server, sout, 65536)
        if len(cout) == 0 {
            if len(sout) == 0 {
                return it
            }
        }
        if len(cout) > 0 {
            session_recv(server, cout)
        }
        if len(sout) > 0 {
            session_recv(client, sout)
        }
        it = it + 1
    }
    return it
}

fn _ts_bytes_eq(a, b) {
    if len(a) != len(b) { return 0 }
    let i = 0
    let n = len(a)
    while i < n {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// ---- crown jewel: handshake convergence -------------------------------

fn test_full_handshake_and_key_agreement() {
    let root = _ts_root()
    let leaf = _ts_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let crng = _ts_rng("client-seed-A")
    let srng = _ts_rng("server-seed-B")
    let client = list_new()
    let server = list_new()
    ce_eq("client alloc",
          session_new_client(client, root, crng, _TS_NOW), 1)
    ce_eq("server alloc",
          session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TS_NOW), 1)
    ce_eq("client start", session_start_client(client), 1)
    let iters = _ts_pump(client, server, 30)
    ce_eq("client handshake done", session_handshake_done(client), 1)
    ce_eq("server handshake done", session_handshake_done(server), 1)
    // Crown assertion: both peers derived byte-identical traffic secrets.
    ce_eq("client_ap_traffic matches",
          _ts_bytes_eq(session_client_ap_traffic(client),
                       session_client_ap_traffic(server)), 1)
    ce_eq("server_ap_traffic matches",
          _ts_bytes_eq(session_server_ap_traffic(client),
                       session_server_ap_traffic(server)), 1)
    ce_eq("client_hs_traffic matches",
          _ts_bytes_eq(session_client_hs_traffic(client),
                       session_client_hs_traffic(server)), 1)
    ce_eq("server_hs_traffic matches",
          _ts_bytes_eq(session_server_hs_traffic(client),
                       session_server_hs_traffic(server)), 1)
}

// Same setup, then send app data.
fn _ts_setup_hand_shaken() {
    let root = _ts_root()
    let leaf = _ts_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let crng = _ts_rng("appdata-c")
    let srng = _ts_rng("appdata-s")
    let client = list_new()
    let server = list_new()
    session_new_client(client, root, crng, _TS_NOW)
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TS_NOW)
    session_start_client(client)
    _ts_pump(client, server, 30)
    let pair = list_new()
    push(pair, client)
    push(pair, server)
    return pair
}

fn test_app_data_client_to_server() {
    let pair = _ts_setup_hand_shaken()
    let client = pair[0]
    let server = pair[1]
    let msg = list_new()
    push(msg, 104); push(msg, 105); push(msg, 33)  // "hi!"
    ce_eq("encrypt ok", session_encrypt_app(client, msg), 1)
    let out = list_new()
    session_drain_send(client, out, 65536)
    session_recv(server, out)
    let got = session_decrypt_app(server)
    ce_eq("recovered bytes", _ts_bytes_eq(got, msg), 1)
}

fn test_app_data_server_to_client() {
    let pair = _ts_setup_hand_shaken()
    let client = pair[0]
    let server = pair[1]
    let msg = list_new()
    push(msg, 79); push(msg, 75)   // "OK"
    ce_eq("encrypt ok", session_encrypt_app(server, msg), 1)
    let out = list_new()
    session_drain_send(server, out, 65536)
    session_recv(client, out)
    let got = session_decrypt_app(client)
    ce_eq("recovered bytes", _ts_bytes_eq(got, msg), 1)
}

fn test_multiple_records_seq_ok() {
    let pair = _ts_setup_hand_shaken()
    let client = pair[0]
    let server = pair[1]
    let i = 0
    while i < 4 {
        let msg = list_new()
        push(msg, i)
        push(msg, i + 10)
        push(msg, i + 20)
        session_encrypt_app(client, msg)
        i = i + 1
    }
    let out = list_new()
    session_drain_send(client, out, 65536)
    session_recv(server, out)
    let j = 0
    while j < 4 {
        let got = session_decrypt_app(server)
        ce_eq("len==3", len(got), 3)
        ce_eq("byte0", got[0], j)
        ce_eq("byte1", got[1], j + 10)
        ce_eq("byte2", got[2], j + 20)
        j = j + 1
    }
}

fn test_close_notify_round_trip() {
    let pair = _ts_setup_hand_shaken()
    let client = pair[0]
    let server = pair[1]
    ce_eq("client close",   session_close(client), 1)
    ce_eq("client state CLOSING", session_state(client), TSS_CLOSING)
    let out = list_new()
    session_drain_send(client, out, 65536)
    session_recv(server, out)
    // Server sees close_notify via decrypt_app -> transitions to CLOSING.
    let leftover = session_decrypt_app(server)
    ce_eq("server saw close (empty)", len(leftover), 0)
    ce_eq("server state CLOSING", session_state(server), TSS_CLOSING)
    session_finalize_close(client)
    session_finalize_close(server)
    ce_eq("client CLOSED", session_state(client), TSS_CLOSED)
    ce_eq("server CLOSED", session_state(server), TSS_CLOSED)
}

fn main() {
    test_full_handshake_and_key_agreement()
    test_app_data_client_to_server()
    test_app_data_server_to_client()
    test_multiple_records_seq_ok()
    test_close_notify_round_trip()
    ce_summary("tls_session")
}

main()
