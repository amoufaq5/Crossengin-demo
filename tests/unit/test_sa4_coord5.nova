// CE_TEST_TIMEOUT: 240
// End-to-end tests of src/learning/sa4_coord.nova (A2.2b): what one
// malicious soul can do with share messages, which only their receiver can
// open (N = 5, t = 4). The soul with id 4294967295 corrupts ciphertexts.
//   - One corrupted share (to soul 7): soul 7 refuses and aborts. The
//     coordinator leaves soul 7 out, records it as an abort ("possibly a
//     victim"), not as misbehaviour, and the round completes over the
//     other four, including the sender of the bad share.
//   - Every share corrupted: all four honest souls abort and the round is
//     cancelled at U3. This is the documented limit: the coordinator
//     cannot tell who sent a bad share without a complaint round.

import "../ce_test.nova"
import "../sa4_harness.nova"

let C5_R = 41

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, C5_R, vc, 0)
    let c = sa4e_coord(roster, C5_R, vc)
    let res = sa4e_round(roster, souls, c, list_new(), [[4, 1, 5]])
    ce_eq("one bad share: the round still unmasks", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("the receiver aborted", sa4s_state(souls[0]), SA4S_ST_ABORTED)
    ce_eq("receiver recorded as an abort", sa4c_aborted(c, 7), 1)
    ce_check("receiver's reason says possibly a victim", find_bytes(sa4c_why(c, 7), "possibly a victim") >= 0)
    ce_str_eq("the sender is not marked", sa4c_why(c, 4294967295), "")
    ce_eq("U3 = the other four", len(sa4c_set(c, 3)), 4)
    ce_eq("sum over the four", sa4h_same(res[2], sa4h_expected([2, 3, 4, 5])), 1)

    let souls2 = sa4h_souls(roster, 5, C5_R, vc, 0)
    let c2 = sa4e_coord(roster, C5_R, vc)
    let res2 = sa4e_round(roster, souls2, c2, list_new(), [[4, 1, 6]])
    ce_eq("every share bad: no sum", res2[0], 0)
    ce_check("cancelled at U3 (" + res2[1] + ")", find_bytes(res2[1], "cancelled: |U3| 1 below t") >= 0)
    let ab = 0
    let i = 0
    while i < 4 {
        ab = ab + sa4c_aborted(c2, SA4H_IDS[i])
        i = i + 1
    }
    ce_eq("all four honest souls recorded as aborts", ab, 4)
    ce_eq("unmask refused", sa4c_unmask(c2)[0], 0)
    ce_summary("sa4_coord5")
}

main()
