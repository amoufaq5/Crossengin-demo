// CE_TEST_TIMEOUT: 240
// End-to-end tests of src/learning/sa4_coord.nova (A2.2b; v4-sa3 blame,
// A2.4c): what one malicious soul can do with share messages, which only
// their receiver can open (N = 5, t = 4). The soul with id 4294967295
// deals bad shares, signed into its own share root (the harness fault
// [1, i, x, 1]: the ciphertext is garbage(ct)).
//   - One bad share (to soul 7): soul 7 complains instead of aborting, the
//     sender reveals its one-time key for the valid complaint, and the
//     coordinator proves the sender guilty (code 1, evidence). Soul 7
//     stays; the round completes over the other four.
//   - Every share of the sender bad: one pair is judged, the other three
//     are skipped (the sender is already out), and the round completes
//     over the four honest souls (v4-sa2 cancelled it).

import "../ce_test.nova"
import "../sa4_harness.nova"

let C5_R = 41

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, C5_R, vc, 0)
    let c = sa4e_coord(roster, C5_R, vc)
    let res = sa4e_round_x(roster, souls, c, list_new(), list_new(), list_new(), [[1, 4, 1, 1]])
    ce_eq("one bad share: the round still unmasks", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("the receiver did not abort", sa4s_state(souls[0]), SA4S_ST_DONE)
    ce_eq("the receiver is not an abort", sa4c_aborted(c, 7), 0)
    ce_eq("the receiver is not blamed", sa4c_blamed(c, 7), 0)
    ce_eq("the sender is proven (code 1)", sa4c_blamed(c, 4294967295), 1)
    ce_str_eq("the sender's reason", sa4c_why(c, 4294967295), "proven: sent soul 7 a share that fails the open check")
    ce_check("evidence against the sender", len(sa4c_evidence(c, 4294967295)) > 0)
    ce_str_eq("U2 = the other four", sa4e_ids_str(sa4c_set(c, 2)), "7,300,65536,70000")
    ce_eq("U3 = the other four", len(sa4c_set(c, 3)), 4)
    ce_eq("sum over the four", sa4h_same(res[2], sa4h_expected([1, 2, 3, 4])), 1)

    let souls2 = sa4h_souls(roster, 5, C5_R, vc, 0)
    let c2 = sa4e_coord(roster, C5_R, vc)
    let res2 = sa4e_round_x(roster, souls2, c2, list_new(), list_new(), list_new(), [[1, 4, 1, 1], [1, 4, 2, 1], [1, 4, 3, 1], [1, 4, 4, 1]])
    ce_eq("every share bad: the round completes", res2[0], 1)
    if res2[0] != 1 { println("  reason: " + res2[1]) }
    ce_eq("sum over the four honest souls", sa4h_same(res2[2], sa4h_expected([1, 2, 3, 4])), 1)
    ce_eq("the sender is proven (code 1)", sa4c_blamed(c2, 4294967295), 1)
    let ab = 0
    let bl = 0
    let i = 0
    while i < 4 {
        ab = ab + sa4c_aborted(c2, SA4H_IDS[i])
        bl = bl + sa4c_blamed(c2, SA4H_IDS[i])
        i = i + 1
    }
    ce_eq("no honest soul aborted", ab, 0)
    ce_eq("no honest soul blamed", bl, 0)
    ce_str_eq("accused: the sender only", sa4e_ids_str(sa4c_accused(c2)), "4294967295")
    let cn = sa4c_counters(c2)
    ce_eq("one pair judged", cn[0], 1)
    ce_eq("three pairs skipped", cn[1], 3)
    ce_eq("one share root", cn[2], 1)
    ce_summary("sa4_coord5")
}

main()
