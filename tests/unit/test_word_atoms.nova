// Unit tests for src/language/word_atoms.nova
// Verifies word-atom creation and normalization, exact lookup, intern
// idempotency, weighted polysemous senses, dominant-sense selection, confidence
// updates, and lexical similarity. ADR-0015.

import "../ce_test.nova"
import "../../src/language/word_atoms.nova"

fn test_create_and_normalize() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    ce_str_eq("language kg", kg_label(lang), "language")
    let w = word_atom_new(lang, "  Aspirin ", 0)
    ce_str_eq("form normalized", word_form(w), "aspirin")
    ce_eq("is ATOM_LANG", atom_kind(w), ATOM_LANG)
    ce_eq("is word", is_word_atom(w), 1)
    ce_eq("ltype LWORD", lang_type(w), LWORD)
    ce_str_eq("normalize fn", lang_normalize("  HELLO "), "hello")
}

fn test_lookup_and_intern() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "fever", 0)
    // Lookup is case/space-insensitive (normalized).
    ce_check("find by normalized form", word_find(lang, "  FEVER ") != 0)
    ce_eq("missing word -> 0", word_find(lang, "qwxyz"), 0)
    // Intern is idempotent.
    let a = word_intern(lang, "cough", 0)
    let b = word_intern(lang, "COUGH", 0)
    ce_eq("intern same atom id", atom_id(a), atom_id(b))
    ce_eq("intern did not duplicate", kg_atom_count(lang), 2)
}

fn test_senses_and_polysemy() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "medicine")
    let analgesic = kg_add_atom(med, ATOM_CONCEPT, "analgesic", 0)   // id 0
    let antipyretic = kg_add_atom(med, ATOM_CONCEPT, "antipyretic", 0) // id 1

    let w = word_atom_new(lang, "aspirin", 0)
    ce_eq("no senses initially", word_sense_count(w), 0)
    word_add_sense(w, analgesic, 800)
    word_add_sense(w, antipyretic, 400)
    ce_eq("two senses (polysemy)", word_sense_count(w), 2)
    // Dominant sense is the highest-weighted reference.
    let dom = word_dominant_sense(w)
    ce_str_eq("dominant sense kg", handle_kg(dom), "medicine")
    ce_eq("dominant sense atom", handle_atom(dom), atom_id(analgesic))
    ce_eq("no senses -> 0", word_dominant_sense(word_atom_new(lang, "lonely", 0)), 0)
}

fn test_confidence_and_similarity() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let w = word_atom_new(lang, "x", 0)
    ce_eq("uniform confidence", word_confidence(w), 500)
    word_observe(w, 1); word_observe(w, 1)
    ce_eq("confidence rises with use", word_confidence(w), 750)
    // Lexical similarity.
    ce_eq("identical forms", word_form_similarity("cat", "cat"), 1000)
    ce_eq("case-insensitive", word_form_similarity("CAT", "cat"), 1000)
    ce_check("disjoint forms low", word_form_similarity("cat", "dog") < 500)
}

// R49: morphological fallback lookup. Accepts only variants that ARE known
// atoms, so it matches inflections without inventing concepts.
fn _morph_hits(lang, variant, base) {
    let v = word_find_morph(lang, variant)
    if v == 0 { return 0 }
    if atom_id(v) == atom_id(word_find(lang, base)) { return 1 }
    return 0
}

fn test_morph() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "cancer", 0)
    word_atom_new(lang, "study", 0)
    word_atom_new(lang, "run", 0)
    word_atom_new(lang, "walk", 0)
    word_atom_new(lang, "box", 0)
    word_atom_new(lang, "make", 0)
    word_atom_new(lang, "use", 0)

    ce_eq("exact still works", _morph_hits(lang, "cancer", "cancer"), 1)
    ce_eq("plural -s: cancers", _morph_hits(lang, "cancers", "cancer"), 1)
    ce_eq("plural -ies: studies", _morph_hits(lang, "studies", "study"), 1)
    ce_eq("plural -es: boxes", _morph_hits(lang, "boxes", "box"), 1)
    ce_eq("-ing undouble: running", _morph_hits(lang, "running", "run"), 1)
    ce_eq("-ing base: walking", _morph_hits(lang, "walking", "walk"), 1)
    ce_eq("-ing +e: making", _morph_hits(lang, "making", "make"), 1)
    ce_eq("-ed: walked", _morph_hits(lang, "walked", "walk"), 1)
    ce_eq("-d: used", _morph_hits(lang, "used", "use"), 1)

    ce_eq("bus -> no false match", word_find_morph(lang, "bus"), 0)
    ce_eq("gas -> no false match", word_find_morph(lang, "gas"), 0)
    ce_eq("-ss not stripped", word_find_morph(lang, "less"), 0)
    ce_eq("unknown stays unknown", word_find_morph(lang, "xyzzy"), 0)
}

// R54: irregular lemma table -- the raw mapping is pure data.
fn test_irregular_lemma_table() {
    ce_str_eq("mice -> mouse", irregular_lemma("mice"), "mouse")
    ce_str_eq("ran -> run", irregular_lemma("ran"), "run")
    ce_str_eq("leaves -> leaf", irregular_lemma("leaves"), "leaf")
    ce_str_eq("children -> child", irregular_lemma("children"), "child")
    ce_str_eq("bacteria -> bacterium", irregular_lemma("bacteria"), "bacterium")
    ce_str_eq("analyses -> analysis", irregular_lemma("analyses"), "analysis")
    ce_str_eq("understood -> understand", irregular_lemma("understood"), "understand")
    ce_str_eq("not an irregular -> empty", irregular_lemma("cancer"), "")
    ce_str_eq("regular plural not in table", irregular_lemma("cancers"), "")
}

// R54: irregular forms reach the learned base atom, with the same
// accept-only-if-known safety as the regular rules.
fn test_irregular_morph() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "mouse", 0)
    word_atom_new(lang, "run", 0)
    word_atom_new(lang, "leaf", 0)
    word_atom_new(lang, "child", 0)
    word_atom_new(lang, "foot", 0)
    word_atom_new(lang, "person", 0)
    word_atom_new(lang, "analysis", 0)
    word_atom_new(lang, "bacterium", 0)
    word_atom_new(lang, "take", 0)

    // Irregular plurals.
    ce_eq("mice -> mouse", _morph_hits(lang, "mice", "mouse"), 1)
    ce_eq("children -> child", _morph_hits(lang, "children", "child"), 1)
    ce_eq("feet -> foot", _morph_hits(lang, "feet", "foot"), 1)
    ce_eq("people -> person", _morph_hits(lang, "people", "person"), 1)
    ce_eq("analyses -> analysis", _morph_hits(lang, "analyses", "analysis"), 1)
    ce_eq("bacteria -> bacterium", _morph_hits(lang, "bacteria", "bacterium"), 1)
    // leaves -> leaf must beat the regular -es strip to "leave" (not learned).
    ce_eq("leaves -> leaf (not 'leave')", _morph_hits(lang, "leaves", "leaf"), 1)
    // Irregular verbs.
    ce_eq("ran -> run", _morph_hits(lang, "ran", "run"), 1)
    ce_eq("took -> take", _morph_hits(lang, "took", "take"), 1)
    ce_eq("taken -> take", _morph_hits(lang, "taken", "take"), 1)

    // Safety: an irregular whose base was NOT learned does not match.
    ce_eq("men -> man absent (man not learned)", word_find_morph(lang, "men"), 0)
    ce_eq("ate -> eat absent (eat not learned)", word_find_morph(lang, "ate"), 0)
    // Exact match wins over the table: if "leaves" itself were learned it would
    // return itself, but here it isn't, so the lemma path is what fires above.
}

fn _has_str(lst, s) {
    let i = 0
    while i < len(lst) {
        if str_eq(lst[i], s) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// R57: derivational candidate generation is pure data.
fn test_derive_candidates() {
    ce_eq("national -> nation", _has_str(derive_candidates("national"), "nation"), 1)
    ce_eq("biological -> biology", _has_str(derive_candidates("biological"), "biology"), 1)
    ce_eq("happiness -> happy", _has_str(derive_candidates("happiness"), "happy"), 1)
    ce_eq("quickly -> quick", _has_str(derive_candidates("quickly"), "quick"), 1)
    ce_eq("ability -> able", _has_str(derive_candidates("ability"), "able"), 1)
    ce_eq("activity -> active", _has_str(derive_candidates("activity"), "active"), 1)
    ce_eq("historic -> history", _has_str(derive_candidates("historic"), "history"), 1)
    // A base word with no derivational suffix proposes nothing.
    ce_eq("base word 'nation' has no candidates", len(derive_candidates("nation")), 0)
    // Length guard: too-short stems are never proposed (final -> fin, only -> on).
    ce_eq("final does not propose 'fin'", _has_str(derive_candidates("final"), "fin"), 0)
    ce_eq("only does not propose 'on'", _has_str(derive_candidates("only"), "on"), 0)
}

// R57: derivational forms reach the learned base, with accept-only-if-known.
fn test_derivational_morph() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "nation", 0)
    word_atom_new(lang, "biology", 0)
    word_atom_new(lang, "dark", 0)
    word_atom_new(lang, "happy", 0)
    word_atom_new(lang, "quick", 0)
    word_atom_new(lang, "real", 0)
    word_atom_new(lang, "danger", 0)
    word_atom_new(lang, "atom", 0)
    word_atom_new(lang, "history", 0)
    word_atom_new(lang, "art", 0)
    word_atom_new(lang, "complex", 0)
    word_atom_new(lang, "active", 0)
    word_atom_new(lang, "able", 0)
    word_atom_new(lang, "govern", 0)
    word_atom_new(lang, "help", 0)
    word_atom_new(lang, "music", 0)

    ce_eq("national -> nation", _morph_hits(lang, "national", "nation"), 1)
    ce_eq("biological -> biology", _morph_hits(lang, "biological", "biology"), 1)
    ce_eq("darkness -> dark", _morph_hits(lang, "darkness", "dark"), 1)
    ce_eq("happiness -> happy", _morph_hits(lang, "happiness", "happy"), 1)
    ce_eq("quickly -> quick", _morph_hits(lang, "quickly", "quick"), 1)
    ce_eq("really -> real", _morph_hits(lang, "really", "real"), 1)
    ce_eq("dangerous -> danger", _morph_hits(lang, "dangerous", "danger"), 1)
    ce_eq("atomic -> atom", _morph_hits(lang, "atomic", "atom"), 1)
    ce_eq("historic -> history", _morph_hits(lang, "historic", "history"), 1)
    ce_eq("artist -> art", _morph_hits(lang, "artist", "art"), 1)
    ce_eq("complexity -> complex", _morph_hits(lang, "complexity", "complex"), 1)
    ce_eq("activity -> active", _morph_hits(lang, "activity", "active"), 1)
    ce_eq("ability -> able", _morph_hits(lang, "ability", "able"), 1)
    ce_eq("government -> govern", _morph_hits(lang, "government", "govern"), 1)
    ce_eq("helpful -> help", _morph_hits(lang, "helpful", "help"), 1)
    ce_eq("musical -> music", _morph_hits(lang, "musical", "music"), 1)

    // Safety: a derived form whose base was NOT learned does not match
    // ("kindness" with no "kind").
    ce_eq("kindness absent (kind not learned)", word_find_morph(lang, "kindness"), 0)
    // Over-stemming guard: short stems aren't reachable even when seeded.
    word_atom_new(lang, "fin", 0)
    word_atom_new(lang, "on", 0)
    ce_eq("final does NOT over-stem to fin", word_find_morph(lang, "final"), 0)
    ce_eq("only does NOT over-stem to on", word_find_morph(lang, "only"), 0)
}

fn main() {
    test_create_and_normalize()
    test_lookup_and_intern()
    test_senses_and_polysemy()
    test_confidence_and_similarity()
    test_morph()
    test_irregular_lemma_table()
    test_irregular_morph()
    test_derive_candidates()
    test_derivational_morph()
    ce_summary("word_atoms")
}

main()
