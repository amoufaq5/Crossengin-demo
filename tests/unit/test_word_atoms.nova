// Unit tests for src/language/word_atoms.nova
// Verifies word-atom creation and normalization, exact lookup, intern
// idempotency, weighted polysemous senses, dominant-sense selection, confidence
// updates, and lexical similarity. ADR-0015.

import "../ce_test.nova"
import "../../src/language/word_atoms.nova"

fn test_create_and_normalize() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    ce_str_eq("language kg", kg_label(lang), "language")
    let w = word_atom_new(lang, "  Aspirin ", 0)
    ce_str_eq("form normalized", word_form(w), "aspirin")
    ce_eq("is ATOM_LANG", atom_kind(w), ATOM_LANG)
    ce_eq("is word", is_word_atom(w), 1)
    ce_eq("ltype LWORD", lang_type(w), LWORD)
    ce_str_eq("normalize fn", lang_normalize("  HELLO "), "hello")
}

fn test_lookup_and_intern() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_atom_new(lang, "fever", 0)
    // Lookup is case/space-insensitive (normalized).
    ce_check("find by normalized form", word_find(lang, "  FEVER ") != 0)
    ce_eq("missing word -> 0", word_find(lang, "qwxyz"), 0)
    // Intern is idempotent.
    let a = word_intern(lang, "cough", 0)
    let b = word_intern(lang, "COUGH", 0)
    ce_eq("intern same atom id", atom_id(a), atom_id(b))
    ce_eq("intern did not duplicate", kg_atom_count(lang), 2)
}

fn test_senses_and_polysemy() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "medicine")
    let analgesic = kg_add_atom(med, ATOM_CONCEPT, "analgesic", 0)   // id 0
    let antipyretic = kg_add_atom(med, ATOM_CONCEPT, "antipyretic", 0) // id 1

    let w = word_atom_new(lang, "aspirin", 0)
    ce_eq("no senses initially", word_sense_count(w), 0)
    word_add_sense(w, analgesic, 800)
    word_add_sense(w, antipyretic, 400)
    ce_eq("two senses (polysemy)", word_sense_count(w), 2)
    // Dominant sense is the highest-weighted reference.
    let dom = word_dominant_sense(w)
    ce_str_eq("dominant sense kg", handle_kg(dom), "medicine")
    ce_eq("dominant sense atom", handle_atom(dom), atom_id(analgesic))
    ce_eq("no senses -> 0", word_dominant_sense(word_atom_new(lang, "lonely", 0)), 0)
}

fn test_confidence_and_similarity() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let w = word_atom_new(lang, "x", 0)
    ce_eq("uniform confidence", word_confidence(w), 500)
    word_observe(w, 1); word_observe(w, 1)
    ce_eq("confidence rises with use", word_confidence(w), 750)
    // Lexical similarity.
    ce_eq("identical forms", word_form_similarity("cat", "cat"), 1000)
    ce_eq("case-insensitive", word_form_similarity("CAT", "cat"), 1000)
    ce_check("disjoint forms low", word_form_similarity("cat", "dog") < 500)
}

fn main() {
    test_create_and_normalize()
    test_lookup_and_intern()
    test_senses_and_polysemy()
    test_confidence_and_similarity()
    ce_summary("word_atoms")
}

main()
