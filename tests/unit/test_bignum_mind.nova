// Unit tests for src/mind/bignum.nova: arbitrary-precision integers via
// little-endian base-10000 digit lists. Coverage centers on from_str/to_str
// round-trips (including values far beyond 63-bit), sign-aware add/sub, and
// schoolbook multiply -- the latter cross-checked both against hand-verified
// constants and self-checking algebraic identities (commutativity,
// distributivity, identity/annihilator).
//
// NOTE on filename: tests/unit/test_bignum.nova already exists for the
// UNRELATED 256-bit fixed-width module src/safety/bignum.nova. To avoid
// modifying that pre-existing file (and breaking its suite), the tests for the
// new list-based src/mind/bignum.nova live here under test_bignum_mind.nova.
//
// NOTE on string equality: per NOVA guidance str_eq is unreliable here (and the
// builtin returns false for value-equal strings produced via distinct paths),
// so we compare strings ourselves with char_at/len and assert via ce_check.

import "../ce_test.nova"
import "../../src/mind/bignum.nova"

// Structural string equality via char codes (avoids the unreliable str_eq).
fn _seq(a, b) {
    if len(a) - len(b) != 0 { return 0 }
    let i = 0
    while i < len(a) {
        if char_at(a, i) - char_at(b, i) != 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Assert two strings are equal, reporting both on mismatch.
fn _ce_s(label, got, expected) {
    if _seq(got, expected) == 1 {
        ce_check(label, 1)
    } else {
        ce_check(label + " expected='" + expected + "' got='" + got + "'", 0)
    }
}

// Round-trip a decimal string through bn_from_str -> bn_to_str.
fn _rt(label, s) {
    _ce_s(label, bn_to_str(bn_from_str(s)), s)
}

fn test_roundtrip() {
    _rt("rt 0", "0")
    _rt("rt 7", "7")
    _rt("rt 9999", "9999")
    _rt("rt 10000 (carry boundary)", "10000")
    _rt("rt 30-digit", "123456789012345678901234567890")
    _rt("rt negative", "-42")
    // canonical zero / from_int forms
    _ce_s("from_int 0", bn_to_str(bn_from_int(0)), "0")
    _ce_s("from_int 100000", bn_to_str(bn_from_int(100000)), "100000")
    _ce_s("from_int negative", bn_to_str(bn_from_int(0 - 12345)), "-12345")
}

fn test_add() {
    _ce_s("9999+1 carries base", bn_to_str(bn_add(bn_from_str("9999"), bn_from_str("1"))), "10000")
    _ce_s("big +1 cascades carry",
        bn_to_str(bn_add(bn_from_str("99999999999999999999"), bn_from_str("1"))),
        "100000000000000000000")
    // mixed signs
    _ce_s("100 + -30", bn_to_str(bn_add(bn_from_str("100"), bn_from_str("-30"))), "70")
    _ce_s("-100 + 30", bn_to_str(bn_add(bn_from_str("-100"), bn_from_str("30"))), "-70")
    // additive inverse -> canonical zero
    _ce_s("x + (-x) = 0", bn_to_str(bn_add(bn_from_str("12345"), bn_from_str("-12345"))), "0")
}

fn test_sub() {
    _ce_s("100-1", bn_to_str(bn_sub(bn_from_str("100"), bn_from_str("1"))), "99")
    _ce_s("0-5 negative", bn_to_str(bn_sub(bn_from_str("0"), bn_from_str("5"))), "-5")
    _ce_s("big borrow chain",
        bn_to_str(bn_sub(bn_from_str("100000000000000000000"), bn_from_str("1"))),
        "99999999999999999999")
}

fn test_mul() {
    _ce_s("12*12", bn_to_str(bn_mul(bn_from_str("12"), bn_from_str("12"))), "144")
    _ce_s("123456789*987654321",
        bn_to_str(bn_mul(bn_from_str("123456789"), bn_from_str("987654321"))),
        "121932631112635269")
    // (10^20 - 1)^2 = 10^40 - 2*10^20 + 1
    _ce_s("huge square",
        bn_to_str(bn_mul(bn_from_str("99999999999999999999"), bn_from_str("99999999999999999999"))),
        "9999999999999999999800000000000000000001")
    // self-checking algebraic identities
    let x = bn_from_str("123456789012345")
    let y = bn_from_str("-98765432109876")
    ce_eq("mul commutes", bn_eq(bn_mul(x, y), bn_mul(y, x)), 1)
    _ce_s("x*0 = 0", bn_to_str(bn_mul(x, bn_from_str("0"))), "0")
    ce_eq("x*1 = x", bn_eq(bn_mul(x, bn_from_str("1")), x), 1)
    ce_eq("x*-1 = -x", bn_eq(bn_mul(x, bn_from_str("-1")), bn_sub(bn_from_str("0"), x)), 1)
    // distributivity: (a+b)*c == a*c + b*c
    let a = bn_from_str("99999999999999999999")
    let b = bn_from_str("123456789012345678")
    let c = bn_from_str("-555555555555")
    let lhs = bn_mul(bn_add(a, b), c)
    let rhs = bn_add(bn_mul(a, c), bn_mul(b, c))
    ce_eq("(a+b)*c = a*c+b*c", bn_eq(lhs, rhs), 1)
    // sign rule on product
    _ce_s("neg*pos", bn_to_str(bn_mul(bn_from_str("-12"), bn_from_str("12"))), "-144")
    _ce_s("neg*neg", bn_to_str(bn_mul(bn_from_str("-12"), bn_from_str("-12"))), "144")
}

fn test_cmp() {
    ce_eq("cmp equal", bn_cmp(bn_from_str("42"), bn_from_str("42")), 0)
    ce_eq("cmp less", bn_cmp(bn_from_str("41"), bn_from_str("42")), 0 - 1)
    ce_eq("cmp greater", bn_cmp(bn_from_str("43"), bn_from_str("42")), 1)
    ce_eq("cmp neg < pos", bn_cmp(bn_from_str("-1"), bn_from_str("1")), 0 - 1)
    ce_eq("cmp pos > neg", bn_cmp(bn_from_str("1"), bn_from_str("-1")), 1)
    ce_eq("cmp both neg", bn_cmp(bn_from_str("-5"), bn_from_str("-3")), 0 - 1)
    // multi-digit magnitude comparison
    ce_eq("cmp big less", bn_cmp(bn_from_str("99999999999999999998"), bn_from_str("99999999999999999999")), 0 - 1)
    ce_eq("bn_eq true", bn_eq(bn_from_str("123456789012345678901234567890"),
                             bn_from_str("123456789012345678901234567890")), 1)
    ce_eq("bn_eq false", bn_eq(bn_from_str("100"), bn_from_str("101")), 0)
    // is_zero
    ce_eq("is_zero 0", bn_is_zero(bn_from_str("0")), 1)
    ce_eq("is_zero -0 normalized", bn_is_zero(bn_from_str("-0")), 1)
    ce_eq("is_zero nonzero", bn_is_zero(bn_from_str("1")), 0)
}

fn main() {
    test_roundtrip()
    test_add()
    test_sub()
    test_mul()
    test_cmp()
    ce_summary("bignum")
}

main()
