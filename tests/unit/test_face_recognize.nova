// Unit tests for src/io/transducers/image_face_recognize.nova (R18D).
//
// Hermetic coverage of the LBP-gallery nearest-neighbor face
// recognition pipeline. R17D's `image_lbp.nova` ships the descriptor
// + chi-squared distance; R18D ships the gallery + match-or-unknown
// classifier built on top.
//
// All fixtures are built in-memory (alloc + store8). The integration
// scenario (scenario_vvv_face_recognize.sh) exercises the chat
// /face_enroll + /face_recognize wiring against PGM fixtures on disk;
// this unit suite covers the algorithm contract:
//
//   * Empty gallery: recognize returns "unknown" with distance -1.
//   * Single-enrollment self-match: recognize on the same buffer
//     returns the enrolled label with distance 0.
//   * Three-enrollment correctness: each face recognises its own
//     label, no false negatives.
//   * Unknown rejection: a 4th face NOT in the gallery returns
//     "unknown" when min distance >= threshold.
//   * Duplicate label: re-enrolling with the same label overwrites
//     the previous descriptor (idempotent re-enrollment).
//   * Save + load round-trip: a gallery saved + reloaded produces
//     bit-identical recognize results.
//   * Clear: size reverts to 0; recognize returns "unknown" again.
//   * Cap behaviour: enrollment caps at FACE_REC_MAX_ENTRIES.
//   * Argument validation: too-small image / null label / null
//     gallery all fail cleanly.

import "../ce_test.nova"
import "../../src/io/transducers/image_face_recognize.nova"

// ---- fixture builders (face_a / face_b / face_c distinct) ---------------

// Vertical edge: left half dark, right half bright. Stand-in for an
// "identity A" face -- a strong vertical-edge LBP signature.
fn _fixture_face_a(width, height) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = width / 2
    let y = 0
    while y < height {
        let row = y * width
        let x = 0
        while x < width {
            let v = 50
            if x >= half { v = 200 }
            store8(buf + row + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Four bright spots near the corners of a dark field. Stand-in for
// "identity B" -- a different LBP signature than face_a.
fn _fixture_face_b(width, height) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, 50)
        i = i + 1
    }
    // Four 4x4 bright spots.
    let positions = list_new()
    let p0 = list_new() push(p0, 3)              push(p0, 3)              push(positions, p0)
    let p1 = list_new() push(p1, width - 7)      push(p1, 3)              push(positions, p1)
    let p2 = list_new() push(p2, 3)              push(p2, height - 7)     push(positions, p2)
    let p3 = list_new() push(p3, width - 7)      push(p3, height - 7)     push(positions, p3)
    let k = 0
    while k < 4 {
        let pp = positions[k]
        let sx = pp[0]
        let sy = pp[1]
        let dy = 0
        while dy < 4 {
            let dx = 0
            while dx < 4 {
                store8(buf + (sy + dy) * width + (sx + dx), 200)
                dx = dx + 1
            }
            dy = dy + 1
        }
        k = k + 1
    }
    store8(buf + area, 0)
    return buf
}

// Horizontal edge: top half dark, bottom half bright. Stand-in for
// "identity C" -- yet another distinct LBP signature (LBP is NOT
// rotation-invariant so this is distinct from face_a).
fn _fixture_face_c(width, height) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = height / 2
    let y = 0
    while y < height {
        let row = y * width
        let v = 50
        if y >= half { v = 200 }
        let x = 0
        while x < width {
            store8(buf + row + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Diagonal edge: a 4th distinct face NOT enrolled in the test
// gallery. Used for the unknown-rejection test.
fn _fixture_face_d(width, height) {
    let area = width * height
    let buf = alloc(area + 1)
    let y = 0
    while y < height {
        let row = y * width
        let x = 0
        while x < width {
            let v = 50
            if x + y >= width { v = 200 }
            store8(buf + row + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Flat (uniform) field -- recognised as nothing in particular; used
// for descriptor edge cases.
fn _fixture_flat(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// ---- core gallery contract ---------------------------------------------

fn test_empty_gallery_size_zero() {
    let g = face_gallery_new()
    ce_eq("empty gallery size = 0", face_gallery_size(g), 0)
    ce_eq("empty gallery live_size = 0",
          face_gallery_live_size(g), 0)
}

fn test_empty_gallery_recognize_unknown() {
    let g = face_gallery_new()
    let buf = _fixture_face_a(32, 32)
    let r = face_gallery_recognize(g, buf, 32, 32, 500)
    ce_str_eq("empty gallery recognize -> 'unknown'",
              r[0], "unknown")
    ce_eq("empty gallery distance = -1",
          r[1], 0 - 1)
}

fn test_enroll_one_face() {
    let g = face_gallery_new()
    let buf = _fixture_face_a(32, 32)
    let ok = face_gallery_enroll(g, "alice", buf, 32, 32)
    ce_eq("enroll alice -> ok=1", ok, 1)
    ce_eq("after 1 enroll: live_size = 1",
          face_gallery_live_size(g), 1)
    ce_str_eq("entry[0] label = 'alice'",
              face_gallery_label_at(g, 0), "alice")
}

fn test_self_match_distance_zero() {
    let g = face_gallery_new()
    let buf = _fixture_face_a(32, 32)
    face_gallery_enroll(g, "alice", buf, 32, 32)
    // Recognize the SAME buffer: chi-squared should be exactly 0.
    let r = face_gallery_recognize(g, buf, 32, 32, 500)
    ce_str_eq("self-match label = 'alice'",
              r[0], "alice")
    ce_eq("self-match distance = 0", r[1], 0)
}

fn test_three_face_gallery_each_recognized() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    let buf_b = _fixture_face_b(32, 32)
    let buf_c = _fixture_face_c(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    face_gallery_enroll(g, "bob",   buf_b, 32, 32)
    face_gallery_enroll(g, "carol", buf_c, 32, 32)
    ce_eq("3-face gallery: live_size = 3",
          face_gallery_live_size(g), 3)
    let ra = face_gallery_recognize(g, buf_a, 32, 32, 500)
    ce_str_eq("recognize face_a -> 'alice'", ra[0], "alice")
    ce_eq("recognize face_a distance = 0", ra[1], 0)
    let rb = face_gallery_recognize(g, buf_b, 32, 32, 500)
    ce_str_eq("recognize face_b -> 'bob'", rb[0], "bob")
    ce_eq("recognize face_b distance = 0", rb[1], 0)
    let rc = face_gallery_recognize(g, buf_c, 32, 32, 500)
    ce_str_eq("recognize face_c -> 'carol'", rc[0], "carol")
    ce_eq("recognize face_c distance = 0", rc[1], 0)
}

fn test_unknown_face_rejected_with_low_threshold() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    let buf_b = _fixture_face_b(32, 32)
    let buf_c = _fixture_face_c(32, 32)
    let buf_d = _fixture_face_d(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    face_gallery_enroll(g, "bob",   buf_b, 32, 32)
    face_gallery_enroll(g, "carol", buf_c, 32, 32)
    // face_d (diagonal) is structurally different. With a TIGHT
    // threshold of 10 -- well below the typical inter-identity
    // distance -- recognize must return 'unknown'.
    let r = face_gallery_recognize(g, buf_d, 32, 32, 10)
    ce_str_eq("4th face under tight threshold -> 'unknown'",
              r[0], "unknown")
    ce_eq("4th face rejected: distance = -1",
          r[1], 0 - 1)
}

fn test_duplicate_enrollment_overwrites() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    let buf_b = _fixture_face_b(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    // Re-enroll under same label with a DIFFERENT descriptor.
    let ok2 = face_gallery_enroll(g, "alice", buf_b, 32, 32)
    ce_eq("re-enroll same label -> ok=1", ok2, 1)
    ce_eq("after duplicate enroll: live_size still = 1",
          face_gallery_live_size(g), 1)
    // Recognize the NEW descriptor -- should match 'alice' with 0.
    let r = face_gallery_recognize(g, buf_b, 32, 32, 500)
    ce_str_eq("after overwrite: recognize face_b -> 'alice'",
              r[0], "alice")
    ce_eq("after overwrite: distance = 0", r[1], 0)
}

fn test_clear_drops_all_entries() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    let buf_b = _fixture_face_b(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    face_gallery_enroll(g, "bob",   buf_b, 32, 32)
    ce_eq("pre-clear live_size = 2",
          face_gallery_live_size(g), 2)
    face_gallery_clear(g)
    ce_eq("post-clear live_size = 0",
          face_gallery_live_size(g), 0)
    let r = face_gallery_recognize(g, buf_a, 32, 32, 500)
    ce_str_eq("post-clear recognize -> 'unknown'",
              r[0], "unknown")
}

fn test_clear_then_reenroll() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    let buf_b = _fixture_face_b(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    face_gallery_clear(g)
    // Re-enroll a new identity. Since clear left dead-sentinel slots
    // in the underlying list, re-enroll should reuse those slots.
    let ok = face_gallery_enroll(g, "dave", buf_b, 32, 32)
    ce_eq("post-clear enroll dave -> ok=1", ok, 1)
    ce_eq("post-clear+reenroll live_size = 1",
          face_gallery_live_size(g), 1)
    let r = face_gallery_recognize(g, buf_b, 32, 32, 500)
    ce_str_eq("post-clear+reenroll recognize -> 'dave'",
              r[0], "dave")
}

// ---- argument validation ------------------------------------------------

fn test_enroll_empty_label_fails() {
    let g = face_gallery_new()
    let buf = _fixture_face_a(32, 32)
    let ok = face_gallery_enroll(g, "", buf, 32, 32)
    ce_eq("enroll empty label -> ok=0", ok, 0)
    ce_eq("enroll empty label: gallery still empty",
          face_gallery_live_size(g), 0)
}

fn test_enroll_too_small_image_fails() {
    let g = face_gallery_new()
    let buf = _fixture_flat(4, 4, 128)
    let ok = face_gallery_enroll(g, "alice", buf, 4, 4)
    ce_eq("enroll 4x4 (< 8x8 min) -> ok=0", ok, 0)
}

fn test_recognize_too_small_image_returns_unknown() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    let buf_small = _fixture_flat(4, 4, 128)
    let r = face_gallery_recognize(g, buf_small, 4, 4, 500)
    ce_str_eq("recognize on 4x4 image -> 'unknown'",
              r[0], "unknown")
}

// ---- save / load round-trip --------------------------------------------

fn test_save_load_round_trip_preserves_results() {
    let g = face_gallery_new()
    let buf_a = _fixture_face_a(32, 32)
    let buf_b = _fixture_face_b(32, 32)
    let buf_c = _fixture_face_c(32, 32)
    face_gallery_enroll(g, "alice", buf_a, 32, 32)
    face_gallery_enroll(g, "bob",   buf_b, 32, 32)
    face_gallery_enroll(g, "carol", buf_c, 32, 32)
    let path = "/tmp/ce_test_face_gallery.txt"
    let saved = face_gallery_save(g, path)
    ce_eq("save 3-face gallery -> 1", saved, 1)
    let g2 = face_gallery_load(path)
    ce_eq("loaded gallery live_size = 3",
          face_gallery_live_size(g2), 3)
    // Recognize each fixture against the LOADED gallery -- should
    // produce the same labels + distances as the original.
    let ra = face_gallery_recognize(g2, buf_a, 32, 32, 500)
    ce_str_eq("loaded: recognize face_a -> 'alice'",
              ra[0], "alice")
    ce_eq("loaded: distance face_a = 0", ra[1], 0)
    let rb = face_gallery_recognize(g2, buf_b, 32, 32, 500)
    ce_str_eq("loaded: recognize face_b -> 'bob'",
              rb[0], "bob")
    ce_eq("loaded: distance face_b = 0", rb[1], 0)
    let rc = face_gallery_recognize(g2, buf_c, 32, 32, 500)
    ce_str_eq("loaded: recognize face_c -> 'carol'",
              rc[0], "carol")
    ce_eq("loaded: distance face_c = 0", rc[1], 0)
}

fn test_save_empty_gallery_then_load() {
    let g = face_gallery_new()
    let path = "/tmp/ce_test_face_gallery_empty.txt"
    let saved = face_gallery_save(g, path)
    ce_eq("save empty gallery -> 1", saved, 1)
    let g2 = face_gallery_load(path)
    ce_eq("loaded empty gallery live_size = 0",
          face_gallery_live_size(g2), 0)
    let buf = _fixture_face_a(32, 32)
    let r = face_gallery_recognize(g2, buf, 32, 32, 500)
    ce_str_eq("loaded empty gallery recognize -> 'unknown'",
              r[0], "unknown")
}

fn test_load_missing_file_returns_empty() {
    let g = face_gallery_load("/tmp/ce_test_face_gallery_does_not_exist.txt")
    ce_eq("load on missing file -> live_size = 0",
          face_gallery_live_size(g), 0)
}

// ---- chat helper formatting --------------------------------------------

fn test_enroll_pgm_args_usage_line() {
    let g = face_gallery_new()
    let s = face_enroll_pgm_args(g, "")
    ce_str_eq("face_enroll empty arg prints usage",
              s, "(/face_enroll needs LABEL PATH.pgm)")
}

fn test_enroll_pgm_args_single_arg() {
    let g = face_gallery_new()
    let s = face_enroll_pgm_args(g, "labelonly")
    ce_str_eq("face_enroll one-arg prints usage",
              s, "(/face_enroll needs LABEL PATH.pgm -- got 1 arg)")
}

fn test_recognize_pgm_args_empty_gallery() {
    let g = face_gallery_new()
    let s = face_recognize_pgm_args(g, "/tmp/does_not_exist.pgm", 500)
    ce_str_eq("face_recognize on empty gallery prints gallery-empty err",
              s, "(face_recognize FAILED: gallery empty -- /face_enroll first)")
}

fn test_recognize_pgm_args_no_arg() {
    let g = face_gallery_new()
    let s = face_recognize_pgm_args(g, "", 500)
    ce_str_eq("face_recognize empty arg prints usage",
              s, "(/face_recognize needs PATH.pgm)")
}

// ---- main --------------------------------------------------------------

fn main() {
    test_empty_gallery_size_zero()
    test_empty_gallery_recognize_unknown()
    test_enroll_one_face()
    test_self_match_distance_zero()
    test_three_face_gallery_each_recognized()
    test_unknown_face_rejected_with_low_threshold()
    test_duplicate_enrollment_overwrites()
    test_clear_drops_all_entries()
    test_clear_then_reenroll()
    test_enroll_empty_label_fails()
    test_enroll_too_small_image_fails()
    test_recognize_too_small_image_returns_unknown()
    test_save_load_round_trip_preserves_results()
    test_save_empty_gallery_then_load()
    test_load_missing_file_returns_empty()
    test_enroll_pgm_args_usage_line()
    test_enroll_pgm_args_single_arg()
    test_recognize_pgm_args_empty_gallery()
    test_recognize_pgm_args_no_arg()
    ce_summary("image_face_recognize")
}

main()
