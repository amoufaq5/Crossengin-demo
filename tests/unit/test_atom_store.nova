// Unit tests for src/kg/atom_store.nova
// Verifies the alpha/beta belief math, integer cosine similarity, atom
// construction and accessors, payload get/set, mutation versioning, Bayesian
// observation, embeddings, and (kg_id, atom_id) handles. ADR-0016, ADR-0023.

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"

fn test_belief() {
    let b = bel_uniform()
    ce_eq("uniform mean 0.5", bel_mean(b), 500)
    ce_eq("uniform strength 2.0", bel_strength(b), 2000)
    ce_eq("uniform evidence 0", bel_evidence(b), 0)
    bel_observe(b, 1)
    ce_eq("after +1 mean 0.666", bel_mean(b), 666)
    ce_eq("after +1 evidence 1", bel_evidence(b), 1)
    bel_observe(b, 1)
    ce_eq("after ++ mean 0.75", bel_mean(b), 750)
    bel_observe(b, -1)
    ce_eq("after +,+,- evidence 3", bel_evidence(b), 3)
    // alpha=3000 beta=2000 -> 0.6
    ce_eq("mixed mean 0.6", bel_mean(b), 600)
}

fn test_cosine() {
    let a = vec_new(4)
    vec_set(a, 0, 100); vec_set(a, 1, 50)
    let b = vec_new(4)
    vec_set(b, 0, 100); vec_set(b, 1, 50)
    ce_eq("identical cosine 1.0", vec_cosine(a, b), 1000)
    let c = vec_new(4)
    vec_set(c, 2, 100)
    ce_eq("orthogonal cosine 0", vec_cosine(a, c), 0)
    let z = vec_new(4)
    ce_eq("zero vector cosine 0", vec_cosine(a, z), 0)
    ce_eq("isqrt 144", isqrt(144), 12)
    ce_eq("isqrt 0", isqrt(0), 0)
}

fn test_atom_basics() {
    let a = atom_new("medicine", 0, ATOM_FACT, "aspirin", 5)
    ce_eq("id", atom_id(a), 0)
    ce_str_eq("kg", atom_kg(a), "medicine")
    ce_eq("kind", atom_kind(a), ATOM_FACT)
    ce_str_eq("label", atom_label(a), "aspirin")
    ce_eq("uniform confidence", atom_confidence(a), 500)
    ce_eq("version 0", atom_version(a), 0)
    ce_eq("created moment", atom_created(a), 5)
    ce_str_eq("kind name", atom_kind_name(ATOM_SKILL), "skill")
    ce_eq("kind valid", atom_kind_valid(ATOM_RULE), 1)
    ce_eq("kind invalid", atom_kind_valid(99), 0)
}

fn test_payload_and_mutation() {
    let a = atom_new("medicine", 1, ATOM_FACT, "aspirin", 5)
    ce_eq("missing key -> 0", atom_payload_get(a, "dose"), 0)
    ce_eq("has missing -> 0", atom_payload_has(a, "dose"), 0)
    atom_payload_set(a, "dose", "100mg")
    atom_payload_set(a, "count", 42)
    ce_str_eq("string payload", atom_payload_get(a, "dose"), "100mg")
    ce_eq("int payload", atom_payload_get(a, "count"), 42)
    ce_eq("has key", atom_payload_has(a, "dose"), 1)
    // Update bumps version and updated_moment, identity preserved.
    let v = atom_update(a, "dose", "200mg", 9)
    ce_eq("version bumped", v, 1)
    ce_str_eq("payload updated", atom_payload_get(a, "dose"), "200mg")
    ce_eq("updated moment", atom_updated(a), 9)
    ce_eq("id immutable", atom_id(a), 1)
    ce_eq("no duplicate payload key", atom_payload_get(a, "count"), 42)
}

fn test_observe_and_embed() {
    let a = atom_new("medicine", 2, ATOM_FACT, "x", 0)
    atom_observe(a, 1)
    atom_observe(a, 1)
    ce_eq("confidence rose to 0.75", atom_confidence(a), 750)
    ce_eq("evidence 2", atom_evidence(a), 2)
    atom_observe(a, -1)
    ce_check("contradiction lowers confidence", atom_confidence(a) < 750)

    let b = atom_new("medicine", 3, ATOM_FACT, "y", 0)
    let v = vec_new(4); vec_set(v, 0, 100); vec_set(v, 1, 50)
    let w = vec_new(4); vec_set(w, 0, 100); vec_set(w, 1, 50)
    atom_set_embed(a, v)
    atom_set_embed(b, w)
    ce_eq("atom embeddings cosine", vec_cosine(atom_embed(a), atom_embed(b)), 1000)
}

fn test_handles() {
    let h = handle_new("medicine", 7)
    ce_str_eq("handle kg", handle_kg(h), "medicine")
    ce_eq("handle atom", handle_atom(h), 7)
    ce_eq("handle eq same", handle_eq(h, handle_new("medicine", 7)), 1)
    ce_eq("handle ne kg", handle_eq(h, handle_new("law", 7)), 0)
    ce_eq("handle ne id", handle_eq(h, handle_new("medicine", 8)), 0)
}

fn test_provenance() {
    // Defaults from atom_new (ADR-0087 ledger).
    let a = atom_new("medicine", 7, ATOM_FACT, "aspirin", 100)
    ce_eq("default tier 0", atom_source_tier(a), 0)
    ce_eq("default part -1", atom_producing_part(a), -1)
    ce_eq("default license unknown", atom_license(a), LICENSE_UNKNOWN)
    ce_eq("default grade unknown", atom_evidence_grade(a), GRADE_UNKNOWN)
    ce_eq("default ts = moment", atom_source_timestamp(a), 100)
    ce_eq("default proof none", atom_proof_ref(a), -1)
    ce_eq("default not clean (unresolved license)", atom_is_clean(a), 0)
    ce_eq("grade consistent when unknown", atom_grade_consistent(a), 1)

    // Set the full ledger.
    atom_set_provenance(a, 1, 3, LICENSE_OPEN, GRADE_EMPIRICAL_STRONG, 250, -1)
    ce_eq("tier set", atom_source_tier(a), 1)
    ce_eq("part set", atom_producing_part(a), 3)
    ce_eq("license set", atom_license(a), LICENSE_OPEN)
    ce_eq("grade set", atom_evidence_grade(a), GRADE_EMPIRICAL_STRONG)
    ce_eq("ts set", atom_source_timestamp(a), 250)
    ce_eq("clean once licensed", atom_is_clean(a), 1)
    ce_str_eq("grade name", atom_grade_name(atom_evidence_grade(a)), "empirical_strong")

    // ADR-0087 invariant: FORMAL requires a proof reference.
    atom_set_evidence_grade(a, GRADE_FORMAL)
    ce_eq("FORMAL without proof is inconsistent", atom_grade_consistent(a), 0)
    atom_set_proof_ref(a, 42)
    ce_eq("FORMAL with proof is consistent", atom_grade_consistent(a), 1)
    ce_eq("proof ref set", atom_proof_ref(a), 42)

    // Backward compatibility: a short (2-element) provenance still reads, with
    // defaults for the new fields, and upgrades cleanly when written.
    let b = atom_new("medicine", 8, ATOM_FACT, "ibuprofen", 5)
    list_set(b, A_PROV, [2, -1])
    ce_eq("old-style tier reads", atom_source_tier(b), 2)
    ce_eq("old-style license default", atom_license(b), LICENSE_UNKNOWN)
    ce_eq("old-style grade default", atom_evidence_grade(b), GRADE_UNKNOWN)
    ce_eq("old-style proof default", atom_proof_ref(b), -1)
    atom_set_license(b, LICENSE_OWNER)
    ce_eq("upgraded license", atom_license(b), LICENSE_OWNER)
    ce_eq("upgraded tier preserved", atom_source_tier(b), 2)
}

fn test_graded_belief() {
    // EMPIRICAL_STRONG: a full-weight observation (alpha 1000 -> 2000).
    let a = atom_new("medicine", 20, ATOM_FACT, "x", 0)
    atom_set_evidence_grade(a, GRADE_EMPIRICAL_STRONG)
    atom_observe_graded(a, 1)
    ce_eq("strong +1 -> 0.666", atom_confidence(a), 666)

    // EMPIRICAL_WEAK: damped (alpha 1000 -> 1400; 1400/2400 = 0.583).
    let b = atom_new("medicine", 21, ATOM_FACT, "y", 0)
    atom_set_evidence_grade(b, GRADE_EMPIRICAL_WEAK)
    atom_observe_graded(b, 1)
    ce_eq("weak +1 -> 0.583", atom_confidence(b), 583)
    ce_check("weak moves less than strong", atom_confidence(b) < atom_confidence(a))

    // TESTIMONIAL: more damped (1250/2250 = 0.555).
    let c = atom_new("medicine", 22, ATOM_FACT, "z", 0)
    atom_set_evidence_grade(c, GRADE_TESTIMONIAL)
    atom_observe_graded(c, 1)
    ce_eq("testimonial +1 -> 0.555", atom_confidence(c), 555)
    ce_check("testimonial moves less than weak", atom_confidence(c) < atom_confidence(b))

    // FORMAL: a proof pins the belief near-certain, regardless of one observation.
    let d = atom_new("math", 23, ATOM_FACT, "thm", 0)
    atom_set_evidence_grade(d, GRADE_FORMAL)
    atom_observe_graded(d, 1)
    ce_eq("formal proved -> ~0.999", atom_confidence(d), 999)

    // FORMAL refutation pins low.
    let e = atom_new("math", 24, ATOM_FACT, "false_claim", 0)
    atom_set_evidence_grade(e, GRADE_FORMAL)
    atom_observe_graded(e, -1)
    ce_eq("formal refuted -> ~0.001", atom_confidence(e), 1)

    // Default grade (UNKNOWN) uses a moderate weight (1000 -> 1600; 1600/2600 = 0.615).
    let f = atom_new("medicine", 25, ATOM_FACT, "w", 0)
    atom_observe_graded(f, 1)
    ce_eq("unknown-grade +1 -> 0.615", atom_confidence(f), 615)

    // grade_weight table.
    ce_eq("weight strong", grade_weight(GRADE_EMPIRICAL_STRONG), 1000)
    ce_eq("weight weak", grade_weight(GRADE_EMPIRICAL_WEAK), 400)
    ce_eq("weight testimonial", grade_weight(GRADE_TESTIMONIAL), 250)
}

fn main() {
    test_belief()
    test_cosine()
    test_atom_basics()
    test_payload_and_mutation()
    test_observe_and_embed()
    test_handles()
    test_provenance()
    test_graded_belief()
    ce_summary("atom_store")
}

main()
