// Unit tests for src/io/effectors/audio_voice_clone.nova (R13D).
//
// Exercises the voice-cloning leg of the audio modality bridge:
//
//   * Constants + struct accessors (~4 checks)
//   * Autocorrelation primitive (~2 checks)
//   * Levinson-Durbin recursion on a trivial input -> stable result (~2 checks)
//   * LPC formant extraction on a pure 800 Hz sine (~2 checks)
//   * LPC formant extraction on Klatt /ae/ (F1=660, F2=1720) ->
//     extracted formants within +/- 100 Hz tolerance (~4 checks)
//   * vc_analyze_reference on a 200 Hz reference -> profile.P0 ~= 200 Hz
//     via R11B YIN (~3 checks)
//   * Empty / missing reference -> empty profile sentinel (~2 checks)
//   * vc_apply_profile: identity profile produces unchanged R6E table (~3 checks)
//   * vc_apply_profile: different P0 leaves the new table's pitch updated
//     and ratios applied to unobserved vowels (~3 checks)
//   * vc_synth_with_profile produces a non-empty WAV whose YIN-measured
//     F0 matches the profile's target P0 (~3 checks)
//   * vc_run_clone_command happy + sad paths (~3 checks)
//
// Total: ~30 assertions.

import "../ce_test.nova"
import "../../src/io/effectors/audio_voice_clone.nova"
import "../../src/io/effectors/audio_synth.nova"
import "../../src/io/transducers/audio_pitch.nova"

// ---- fixture builders ----------------------------------------------------

fn _zero_buf(n) {
    let b = list_new()
    let i = 0
    while i < n {
        push(b, 0)
        i = i + 1
    }
    return b
}

// Sum of two pure cosines at f_a + f_b. Useful for testing formant
// extraction on a known harmonic.
fn _two_tone(f_a, f_b, n, sr) {
    let a = synth_sine(f_a, n, sr)
    let b = synth_sine(f_b, n, sr)
    let out = list_new()
    let i = 0
    while i < n {
        push(out, (a[i] + b[i]) / 2)
        i = i + 1
    }
    return out
}

// Build an "identity" profile: P0 = 120 Hz (R6E baseline), F1/F2/F3
// matching R6E's "ae" defaults exactly. Used by the identity-transfer
// test to confirm vc_apply_profile is a no-op for unchanged input.
fn _identity_profile() {
    let p = vc_profile_empty()
    p[1] = 12000              // P0 = 120 Hz
    p[2] = 8000
    let table = list_new()
    let t = list_new()
    push(t, "ae"); push(t, 660); push(t, 1720); push(t, 2410)
    push(t, 60); push(t, 90); push(t, 150)
    push(table, t)
    p[3] = table
    let refs = list_new()
    push(refs, "ae")
    p[4] = refs
    p[5] = 1000               // F1 ratio = identity
    p[6] = 1000               // F2 ratio = identity
    return p
}

// ---- constants + accessors ----------------------------------------------

fn test_vc_constants() {
    ce_eq("profile tag = 8131", vc_profile_tag(), 8131)
    ce_eq("LPC order default = 10", vc_lpc_order_default(), 10)
    ce_eq("LPC order max = 12", vc_lpc_order_max(), 12)
    ce_eq("max ref samples = 480000", vc_max_ref_samples(), 480000)
    ce_eq("spectrum step = 50 Hz", vc_spectrum_step_hz(), 50)
    ce_eq("formant min = 150 Hz", vc_formant_min_hz(), 150)
}

fn test_empty_profile_shape() {
    let p = vc_profile_empty()
    ce_eq("empty profile is_valid", vc_profile_is_valid(p), 1)
    ce_eq("empty profile P0 = 0", vc_profile_p0_centihz(p), 0)
    ce_eq("empty profile sample_rate = 0", vc_profile_sample_rate(p), 0)
    ce_eq("empty profile f1_ratio = 1000", vc_profile_f1_ratio(p), 1000)
    ce_eq("empty profile f2_ratio = 1000", vc_profile_f2_ratio(p), 1000)
}

// ---- autocorrelation primitive ------------------------------------------

fn test_autocorr_zero_buffer() {
    let z = _zero_buf(1200)
    let r = vc_autocorr(z, 5)
    ce_eq("autocorr zero len = order+1", len(r), 6)
    ce_eq("autocorr zero R(0) = 0", r[0], 0)
}

fn test_autocorr_sine_nonzero() {
    let s = synth_sine(200, 1200, 8000)
    let r = vc_autocorr(s, 10)
    ce_check("autocorr sine R(0) > 0", r[0] > 0)
    // R(period) ~= R(0) for pure sine where period = sr/freq = 40 samples.
    // Within order=10 we won't reach the full period, but R(0) should
    // be the largest.
    ce_check("autocorr sine has length order+1", len(r) == 11)
}

// ---- Levinson-Durbin ----------------------------------------------------

fn test_levinson_zero_input() {
    let r = list_new()
    push(r, 0); push(r, 0); push(r, 0); push(r, 0); push(r, 0)
    let lpc = vc_levinson_durbin(r, 4)
    ce_eq("LPC zero-input length = order+1", len(lpc), 5)
    ce_eq("LPC zero-input a_0 = 1000 (milli)", lpc[0], 1000)
}

fn test_levinson_runs_on_sine() {
    // LPC of a pure sine -- the result should be non-trivial but stable.
    let s = synth_sine(200, 1200, 8000)
    let r = vc_autocorr(s, 10)
    let lpc = vc_levinson_durbin(r, 10)
    ce_eq("LPC of sine: length = order+1", len(lpc), 11)
    ce_eq("LPC of sine: a_0 = 1000", lpc[0], 1000)
}

// ---- LPC formant extraction ---------------------------------------------

fn test_lpc_on_sine_detects_formant() {
    // Pure 800 Hz sine -> LPC peak should land near 800 Hz.
    let s = synth_sine(800, 1200, 8000)
    let f = vc_extract_formants(s, 8000, 10, 3)
    ce_eq("formants list length = 3", len(f), 3)
    // At least one of the top-3 formants should be near 800 Hz (+/- 100).
    let near800 = 0
    let i = 0
    while i < 3 {
        let v = f[i]
        if v >= 700 && v <= 900 { near800 = 1 }
        i = i + 1
    }
    ce_eq("LPC on 800Hz sine: detected formant near 800 Hz", near800, 1)
}

fn test_lpc_on_klatt_ae() {
    // Klatt /ae/ -> F1=660, F2=1720, F3=2410 (R6E defaults). LPC should
    // recover these within +/- 100 Hz. Per-formant tolerance is the
    // 50-Hz spectrum step + half-step rounding + LPC peak-pick precision.
    let s = synth_phoneme_klatt("ae")
    let f = vc_extract_formants(s, 8000, 10, 3)
    ce_check("Klatt /ae/ F1 in [560..760]", f[0] >= 560 && f[0] <= 760)
    ce_check("Klatt /ae/ F2 in [1620..1820]", f[1] >= 1620 && f[1] <= 1820)
    // F3 (~2410) -- looser tolerance since at 8 kHz the F3 region is
    // close to Nyquist and LPC resolution degrades.
    ce_check("Klatt /ae/ F3 in [2200..2700]", f[2] >= 2200 && f[2] <= 2700)
}

// ---- vc_analyze_reference -----------------------------------------------

fn test_analyze_missing_returns_empty() {
    let p = vc_analyze_reference("/tmp/__nonexistent_vc_ref__.wav")
    // Empty profile still validates -- it's the sentinel.
    ce_eq("missing reference -> empty profile is_valid", vc_profile_is_valid(p), 1)
    ce_eq("missing reference -> empty profile P0 = 0", vc_profile_p0_centihz(p), 0)
}

fn test_analyze_200hz_reference() {
    // Write a 200 Hz sine and analyze; profile.P0 should be ~200 Hz
    // via R11B YIN. YIN on a clean 200 Hz @ 8 kHz returns 20000 centi-Hz
    // exactly (verified by R11B's own test suite); we allow +/- 200
    // centi-Hz tolerance for envelope-edge effects.
    let s = synth_sine(200, 9600, 8000)
    audio_write_wav(s, "/tmp/test_vc_ref_200.wav")
    let p = vc_analyze_reference("/tmp/test_vc_ref_200.wav")
    ce_eq("200Hz ref profile is_valid", vc_profile_is_valid(p), 1)
    ce_eq("200Hz ref sample_rate = 8000", vc_profile_sample_rate(p), 8000)
    let p0 = vc_profile_p0_centihz(p)
    ce_check("200Hz ref P0 in [19800..20200] centi-Hz",
             p0 >= 19800 && p0 <= 20200)
}

// ---- vc_apply_profile ---------------------------------------------------

fn test_apply_identity_profile() {
    // Identity profile (R6E ae defaults, ratios = 1000). Apply to
    // [ae, iy, uw] -- the result should match R6E's table for each:
    //   ae -> direct match: (660, 1720, 2410)
    //   iy -> ratio-scaled by identity: (270, 2290, 3010)
    //   uw -> ratio-scaled by identity: (300, 870, 2240)
    let prof = _identity_profile()
    let labels = list_new()
    push(labels, "ae"); push(labels, "iy"); push(labels, "uw")
    let out = vc_apply_profile(labels, prof)
    ce_eq("identity-apply output length = 3", len(out), 3)
    let t0 = out[0]
    ce_eq("identity ae F1 = 660", vc_formant_f1(t0), 660)
    ce_eq("identity ae F2 = 1720", vc_formant_f2(t0), 1720)
    let t1 = out[1]
    ce_eq("identity iy F1 = 270 (R6E default, unchanged)", vc_formant_f1(t1), 270)
    ce_eq("identity iy F2 = 2290 (R6E default, unchanged)", vc_formant_f2(t1), 2290)
    let t2 = out[2]
    ce_eq("identity uw F1 = 300 (R6E default, unchanged)", vc_formant_f1(t2), 300)
}

fn test_apply_scaled_profile() {
    // Profile with F1 ratio 0.5 (e.g. female-to-male transfer would
    // ratio < 1; child-to-adult > 1). Apply to "iy" -- F1 should be
    // halved relative to R6E's 270.
    let prof = vc_profile_empty()
    prof[1] = 22000             // P0 = 220 Hz
    prof[2] = 8000
    let table = list_new()
    let t_ae = list_new()
    push(t_ae, "ae"); push(t_ae, 330); push(t_ae, 860); push(t_ae, 1205)
    push(t_ae, 60); push(t_ae, 90); push(t_ae, 150)
    push(table, t_ae)
    prof[3] = table
    let refs = list_new()
    push(refs, "ae")
    prof[4] = refs
    prof[5] = 500                // F1 scaled to 0.5x
    prof[6] = 500                // F2 scaled to 0.5x
    let labels = list_new()
    push(labels, "iy")
    let out = vc_apply_profile(labels, prof)
    let t = out[0]
    ce_eq("scaled-apply iy F1 = 135 (= 270 * 0.5)", vc_formant_f1(t), 135)
    ce_eq("scaled-apply iy F2 = 1145 (= 2290 * 0.5)", vc_formant_f2(t), 1145)
    // F3 also gets the F2 ratio applied.
    ce_eq("scaled-apply iy F3 = 1505 (= 3010 * 0.5)", vc_formant_f3(t), 1505)
}

fn test_apply_direct_match_uses_reference() {
    // Direct match: profile has measured "ae" formants; applying to
    // "ae" should return those formants unchanged, NOT the R6E defaults
    // scaled by ratios.
    let prof = vc_profile_empty()
    prof[1] = 15000             // P0 = 150 Hz
    prof[2] = 8000
    let table = list_new()
    let t_ae = list_new()
    push(t_ae, "ae"); push(t_ae, 999); push(t_ae, 1888); push(t_ae, 2777)
    push(t_ae, 70); push(t_ae, 100); push(t_ae, 200)
    push(table, t_ae)
    prof[3] = table
    let refs = list_new()
    push(refs, "ae")
    prof[4] = refs
    prof[5] = 500
    prof[6] = 500
    let labels = list_new()
    push(labels, "ae")
    let out = vc_apply_profile(labels, prof)
    let t = out[0]
    ce_eq("direct match ae F1 = 999", vc_formant_f1(t), 999)
    ce_eq("direct match ae F2 = 1888", vc_formant_f2(t), 1888)
    ce_eq("direct match ae F3 = 2777", vc_formant_f3(t), 2777)
}

// ---- vc_synth_with_profile -----------------------------------------------

fn test_synth_invalid_profile_empty() {
    // Invalid (zero) profile -> empty output (the guard's sentinel).
    let out = vc_synth_with_profile("ae", 0)
    ce_eq("invalid profile synth -> empty", len(out), 0)
}

fn test_synth_empty_text_empty() {
    let prof = _identity_profile()
    let out = vc_synth_with_profile("", prof)
    ce_eq("empty text synth -> empty", len(out), 0)
}

fn test_synth_non_empty_output() {
    // Synthesizing any non-empty text against a valid profile should
    // produce a non-empty PCM buffer.
    let prof = _identity_profile()
    let out = vc_synth_with_profile("ae", prof)
    ce_check("synth /ae/ output is non-empty", len(out) > 0)
    // Each voiced char -> 1200 samples (AUDIO_PHONEME_SAMPLES).
    ce_eq("synth /ae/ length = 2 * 1200 = 2400", len(out), 2400)
}

fn test_synth_pitch_transfer_200hz() {
    // Build a profile with P0 = 200 Hz, synthesize voiced text,
    // verify YIN F0 of the synth output matches 200 Hz within
    // tolerance. The continuous-phase F0 carrier keeps YIN locked
    // across phoneme boundaries.
    let prof = vc_profile_empty()
    prof[1] = 20000              // P0 = 200 Hz centi-Hz
    prof[2] = 8000
    let table = list_new()
    let t_ae = list_new()
    push(t_ae, "ae"); push(t_ae, 660); push(t_ae, 1720); push(t_ae, 2410)
    push(t_ae, 60); push(t_ae, 90); push(t_ae, 150)
    push(table, t_ae)
    prof[3] = table
    let refs = list_new()
    push(refs, "ae")
    prof[4] = refs
    prof[5] = 1000
    prof[6] = 1000
    let out = vc_synth_with_profile("aeaeaeae", prof)
    ce_check("synth pitch-transfer output > 4800 samples (8x phonemes)",
             len(out) >= 4800)
    let contour = pitch_track_yin(out, 8000)
    let voiced = pitch_voiced_count(contour)
    ce_check("synth pitch-transfer has voiced frames",
             voiced >= 5)
    let mean = pitch_mean_voiced(contour)
    // Target 20000 centi-Hz; tolerance +/- 1500 covers envelope
    // edge effects and the small formant contribution.
    ce_check("synth pitch-transfer YIN mean in [18500..21500]",
             mean >= 18500 && mean <= 21500)
}

fn test_apply_different_p0_updates_pitch() {
    // Two profiles with different P0; the vc_synth_with_profile output
    // should have different measurable F0.
    let prof_lo = _identity_profile()       // P0 = 120 Hz
    let prof_hi = _identity_profile()
    prof_hi[1] = 20000                      // P0 = 200 Hz
    let out_lo = vc_synth_with_profile("ae ae", prof_lo)
    let out_hi = vc_synth_with_profile("ae ae", prof_hi)
    let c_lo = pitch_track_yin(out_lo, 8000)
    let c_hi = pitch_track_yin(out_hi, 8000)
    let m_lo = pitch_mean_voiced(c_lo)
    let m_hi = pitch_mean_voiced(c_hi)
    ce_check("different P0 changes YIN F0: hi > lo",
             m_hi > m_lo)
}

// ---- chat helper --------------------------------------------------------

fn test_run_clone_no_args() {
    let s = vc_run_clone_command("")
    ce_check("/clone no-arg returns usage", str_find(s, "/clone needs") >= 0)
}

fn test_run_clone_missing_text() {
    let s = vc_run_clone_command("/tmp/some_wav.wav")
    ce_check("/clone missing text returns usage", str_find(s, "/clone needs") >= 0)
}

fn test_run_clone_missing_file() {
    let s = vc_run_clone_command("/tmp/__missing_vc_ref__.wav hello")
    // Missing file -> vc_analyze_reference returns empty profile (which
    // is still valid as a sentinel), so the synth produces only silence
    // (no P0). The error path here is the table-len check: empty profile
    // has an empty formant table.
    ce_check("/clone missing reference returns FAILED message",
             str_find(s, "FAILED") >= 0)
}

fn test_run_clone_happy_path() {
    // Write a 200 Hz reference; clone with text "ae". Verify the chat
    // helper succeeds, writes /tmp/cloned.wav, and reports a positive P0.
    let s = synth_sine(200, 9600, 8000)
    audio_write_wav(s, "/tmp/test_vc_clone_ref.wav")
    let r = vc_run_clone_command("/tmp/test_vc_clone_ref.wav aeaeaeae")
    ce_check("/clone happy path reports clone label",
             str_find(r, "(clone") >= 0)
    ce_check("/clone happy path writes /tmp/cloned.wav",
             str_find(r, "/tmp/cloned.wav") >= 0)
    ce_check("/clone happy path reports p0=", str_find(r, "p0=") >= 0)
}

fn main() {
    test_vc_constants()
    test_empty_profile_shape()
    test_autocorr_zero_buffer()
    test_autocorr_sine_nonzero()
    test_levinson_zero_input()
    test_levinson_runs_on_sine()
    test_lpc_on_sine_detects_formant()
    test_lpc_on_klatt_ae()
    test_analyze_missing_returns_empty()
    test_analyze_200hz_reference()
    test_apply_identity_profile()
    test_apply_scaled_profile()
    test_apply_direct_match_uses_reference()
    test_synth_invalid_profile_empty()
    test_synth_empty_text_empty()
    test_synth_non_empty_output()
    test_synth_pitch_transfer_200hz()
    test_apply_different_p0_updates_pitch()
    test_run_clone_no_args()
    test_run_clone_missing_text()
    test_run_clone_missing_file()
    test_run_clone_happy_path()
    ce_summary("voice_clone")
}

main()
