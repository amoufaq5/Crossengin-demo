// CE_TEST_TIMEOUT: 240
// Equivalence tests for src/safety/ed25519.nova (A2.3a rewrite: point layer
// on field25519, flat SHA-512). Every expected value below was produced by
// an independent Python implementation (hashlib SHA-512 and big-integer
// RFC 8032 code, cofactorless verify, strict decode), and the old bignum
// implementation agreed with all of them before the rewrite. The rewrite
// must give the same answers:
//   - SHA-512 at 17 lengths around the padding boundaries;
//   - public keys and signatures for 6 seeds (messages 0..200 bytes);
//   - 12 verify cases: tampered R / s, s + L, other message / key, the
//     identity and order-2 keys with s = 0 (accepted, as RFC 8032
//     cofactorless verify does), R with an order-2 component, a
//     mixed-order key, a non-canonical R, a short signature;
//   - decode and pk_check on 32 encodings: the 8 small-order points,
//     y >= p, "-0", a mixed-order point, valid keys, random strings.
// It also bounds the heap growth of one sign and one verify (the old code
// used about 25 MB and 48 MB, never freed).

import "std/io"
import "std/string"
import "std/syscall"
import "../ce_test.nova"
import "../../src/safety/ed25519.nova"

fn eqv_msg(n, salt) {
    let m = list_new()
    let i = 0
    while i < n {
        push(m, int_and(int_add(int_mul(i, 131), salt), 255))
        i = i + 1
    }
    return m
}

