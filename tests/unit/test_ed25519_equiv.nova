fn test_sha() {
    let v = eqv_sha()
    let i = 0
    while i < len(v) {
        let r = v[i]
        ce_str_eq("sha512 len " + int_to_str(r[0]), ed25519_bytes_to_hex(sha512_bytes(eqv_msg(r[0], 7))), r[1])
        i = i + 1
    }
    return 0
}

fn test_sign() {
    let v = eqv_sign()
    let i = 0
    while i < len(v) {
        let r = v[i]
        let seed = ed25519_hex_to_bytes(r[0])
        let m = eqv_msg(r[1], r[2])
        let pk = ed25519_pk_from_seed(seed)
        ce_str_eq("pk " + int_to_str(i), ed25519_bytes_to_hex(pk), r[3])
        let sig = ed25519_sign(m, seed, pk)
        ce_str_eq("sig " + int_to_str(i) + " (msg " + int_to_str(r[1]) + " B)", ed25519_bytes_to_hex(sig), r[4])
        ce_eq("verify " + int_to_str(i), ed25519_verify(m, sig, pk), 1)
        i = i + 1
    }
    return 0
}

fn test_verify() {
    let v = eqv_verify()
    let i = 0
    while i < len(v) {
        let r = v[i]
        let got = ed25519_verify(ed25519_hex_to_bytes(r[1]), ed25519_hex_to_bytes(r[2]), ed25519_hex_to_bytes(r[3]))
        ce_eq("verify case: " + r[0], got, r[4])
        i = i + 1
    }
    return 0
}

fn test_pk() {
    let v = eqv_pk()
    let i = 0
    while i < len(v) {
        let r = v[i]
        let b = ed25519_hex_to_bytes(r[1])
        ce_eq("pk_check: " + r[0], ed25519_pk_check(b), r[2])
        let d = 1
        if _ed_point_decode(b) == 0 { d = 0 }
        ce_eq("decode: " + r[0], d, r[3])
        i = i + 1
    }
    return 0
}

// Heap growth of one sign and one verify, from the bump allocator's
// position (alloc never frees).
fn test_memory() {
    let seed = ed25519_hex_to_bytes(eqv_sign()[0][0])
    let pk = ed25519_pk_from_seed(seed)
    let m = eqv_msg(64, 3)
    let h0 = alloc(8)
    let sig = ed25519_sign(m, seed, pk)
    let h1 = alloc(8)
    let ok = ed25519_verify(m, sig, pk)
    let h2 = alloc(8)
    ce_eq("memory: signature verifies", ok, 1)
    ce_check("memory: one sign grows the heap by < 512 KB (" + int_to_str(h1 - h0) + ")", h1 - h0 < 524288)
    ce_check("memory: one verify grows the heap by < 512 KB (" + int_to_str(h2 - h1) + ")", h2 - h1 < 524288)
    return 0
}

fn main() {
    test_sha()
    test_pk()
    test_verify()
    test_sign()
    test_memory()
    ce_summary("ed25519_equiv")
}

main()
