// R112 -- CLI polish helpers (--json / history / color). Exercises the pure
// helpers in src/util/chat_cli_polish.nova. The chat's main() wires these
// against real getenv + sys_open; here we cover the branching logic in
// isolation. Manual smoke of the wire integration is:
//   CROSSENGIN_JSON_MODE=1 echo "hi" | ./bin/crossengin-chat  # one JSON line
//   CROSSENGIN_COLOR=1 ./bin/crossengin-chat                  # cyan prompt
//
// ADRs: none (UX polish).

import "../ce_test.nova"
import "../../src/util/chat_cli_polish.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _mk_argv_1(a) {
    let r = list_new()
    push(r, a)
    return r
}
fn _mk_argv_2(a, b) {
    let r = list_new()
    push(r, a)
    push(r, b)
    return r
}
fn _mk_argv_3(a, b, c) {
    let r = list_new()
    push(r, a)
    push(r, b)
    push(r, c)
    return r
}
fn _mk_lines(n) {
    let r = list_new()
    let i = 0
    while i < n {
        push(r, "line_" + int_to_str(i))
        i = i + 1
    }
    return r
}

// Byte-exact string check via ce_str_eq (which uses the safe compare).
fn _assert_contains(label, hay, needle) {
    let idx = find_bytes(hay, needle)
    if idx >= 0 {
        ce_check(label, 1)
    } else {
        ce_check(label + " (missing '" + needle + "' in '" + hay + "')", 0)
    }
}

// ---- flag parsing --------------------------------------------------------

fn test_parse_no_flags() {
    let r = _chat_parse_args(list_new())
    ce_eq("empty argv -> json_mode=0", r[CCP_JSON_MODE], 0)
}

fn test_parse_json_only() {
    let r = _chat_parse_args(_mk_argv_1("--json"))
    ce_eq("--json -> json_mode=1", r[CCP_JSON_MODE], 1)
}

fn test_parse_json_with_other() {
    let r = _chat_parse_args(_mk_argv_3("--json", "--unknown", "foo"))
    ce_eq("--json with extra tokens -> json_mode=1", r[CCP_JSON_MODE], 1)
}

fn test_parse_no_json_with_other() {
    let r = _chat_parse_args(_mk_argv_2("--unknown", "foo"))
    ce_eq("unknown flags only -> json_mode=0", r[CCP_JSON_MODE], 0)
}

fn test_parse_null_argv_safe() {
    // A launcher passing 0 (no argv) should not crash and should default off.
    let r = _chat_parse_args(0)
    ce_eq("null argv -> json_mode=0", r[CCP_JSON_MODE], 0)
}

// ---- env-var fold-in -----------------------------------------------------

fn test_effective_argv_wins() {
    ce_eq("--json + env=0 -> 1", _chat_json_mode_effective(1, "0"), 1)
    ce_eq("--json + env unset -> 1", _chat_json_mode_effective(1, 0), 1)
}

fn test_effective_env_activates() {
    ce_eq("env=1 without --json -> 1", _chat_json_mode_effective(0, "1"), 1)
    ce_eq("env=true without --json -> 1 (any nonempty non-0)", _chat_json_mode_effective(0, "true"), 1)
}

fn test_effective_env_unset() {
    ce_eq("env unset (0) -> 0", _chat_json_mode_effective(0, 0), 0)
    ce_eq("env empty -> 0", _chat_json_mode_effective(0, ""), 0)
    ce_eq("env explicit 0 -> 0", _chat_json_mode_effective(0, "0"), 0)
}

// ---- history-file trim ---------------------------------------------------

fn test_history_trim_under_cap() {
    let lines = _mk_lines(50)
    let out = _chat_history_trim(lines, 100)
    ce_eq("under cap -> unchanged length", len(out), 50)
    ce_str_eq("under cap -> first line preserved", out[0], "line_0")
    ce_str_eq("under cap -> last line preserved", out[49], "line_49")
}

fn test_history_trim_at_cap() {
    let lines = _mk_lines(100)
    let out = _chat_history_trim(lines, 100)
    ce_eq("exactly cap -> unchanged", len(out), 100)
}

fn test_history_trim_over_cap() {
    let lines = _mk_lines(120)
    let out = _chat_history_trim(lines, 100)
    ce_eq("over cap -> trimmed to cap", len(out), 100)
    ce_str_eq("over cap -> first kept is line_20", out[0], "line_20")
    ce_str_eq("over cap -> last kept is line_119", out[99], "line_119")
}

fn test_history_trim_default_cap_matches_doc() {
    ce_eq("default cap constant matches documented 10000", CCP_HISTORY_DEFAULT_CAP, 10000)
}

fn test_history_trim_zero_cap_empties() {
    let lines = _mk_lines(5)
    let out = _chat_history_trim(lines, 0)
    ce_eq("cap=0 -> empty", len(out), 0)
}

fn test_history_trim_neg_cap_empties() {
    let lines = _mk_lines(5)
    let out = _chat_history_trim(lines, 0 - 1)
    ce_eq("cap<0 -> empty (defensive)", len(out), 0)
}

fn test_history_trim_null_lines_safe() {
    let out = _chat_history_trim(0, 100)
    ce_eq("null lines + positive cap -> empty", len(out), 0)
}

// ---- history-line split + join round-trip --------------------------------

fn test_history_lines_empty() {
    ce_eq("empty text -> 0 lines", len(_chat_history_lines("")), 0)
    ce_eq("null text -> 0 lines", len(_chat_history_lines(0)), 0)
}

fn test_history_lines_single_no_newline() {
    let out = _chat_history_lines("hello")
    ce_eq("bare 'hello' -> 1 line", len(out), 1)
    ce_str_eq("bare 'hello' -> content preserved", out[0], "hello")
}

fn test_history_lines_multi() {
    let out = _chat_history_lines("a\nb\nc\n")
    ce_eq("'a\\nb\\nc\\n' -> 3 lines", len(out), 3)
    ce_str_eq("line[0]=a", out[0], "a")
    ce_str_eq("line[1]=b", out[1], "b")
    ce_str_eq("line[2]=c", out[2], "c")
}

fn test_history_join_terminates() {
    let lines = list_new()
    push(lines, "x")
    push(lines, "y")
    let s = _chat_history_join(lines)
    ce_str_eq("join adds trailing \\n on every line", s, "x\ny\n")
}

fn test_history_round_trip() {
    let orig = _mk_lines(3)
    let text = _chat_history_join(orig)
    let back = _chat_history_lines(text)
    ce_eq("round-trip preserves count", len(back), 3)
    ce_str_eq("round-trip preserves first", back[0], "line_0")
    ce_str_eq("round-trip preserves last", back[2], "line_2")
}

// ---- color gating --------------------------------------------------------

fn test_color_off_by_default() {
    // env unset (0) for both -> OFF (default-off stance)
    ce_eq("no env set -> color off", _chat_color_should_enable(0, 0, 0), 0)
}

fn test_color_on_when_env_1() {
    ce_eq("CROSSENGIN_COLOR=1 -> on", _chat_color_should_enable(0, 0, "1"), 1)
}

fn test_color_no_color_wins() {
    ce_eq("NO_COLOR set + COLOR=1 -> OFF (NO_COLOR wins)",
        _chat_color_should_enable(0, "1", "1"), 0)
    ce_eq("NO_COLOR set (empty value counts as unset per spec) + COLOR=1 -> on",
        _chat_color_should_enable(0, "", "1"), 1)
}

fn test_color_json_forbids() {
    ce_eq("json_mode=1 forbids color even with COLOR=1",
        _chat_color_should_enable(1, 0, "1"), 0)
}

fn test_color_env_zero_off() {
    ce_eq("COLOR=0 -> off", _chat_color_should_enable(0, 0, "0"), 0)
    ce_eq("COLOR=anything-else -> off (strict '1' opt-in)",
        _chat_color_should_enable(0, 0, "yes"), 0)
}

// ---- color wrap ----------------------------------------------------------

fn test_wrap_disabled_passthrough() {
    ce_str_eq("disabled wrap returns raw text",
        _chat_color_wrap("hello", CCP_COLOR_PROMPT, 0), "hello")
}

fn test_wrap_enabled_contains_frame() {
    let out = _chat_color_wrap("hi", CCP_COLOR_PROMPT, 1)
    // Should contain the color code and end with a reset
    _assert_contains("wrapped output contains color code", out, "[36m")
    _assert_contains("wrapped output contains reset", out, "[0m")
    _assert_contains("wrapped output contains payload", out, "hi")
}

fn test_wrap_refusal_color() {
    let out = _chat_color_wrap("refused", CCP_COLOR_REFUSAL, 1)
    _assert_contains("refusal wraps yellow (33)", out, "[33m")
}

fn test_wrap_meta_color() {
    let out = _chat_color_wrap("perceive(m=1)", CCP_COLOR_META, 1)
    _assert_contains("meta wraps dim gray (2;37)", out, "[2;37m")
}

// ---- JSON exchange encoding ---------------------------------------------

fn test_json_exchange_ok() {
    let line = _chat_json_encode_exchange("what is water", "H2O is a compound", "def:water")
    _assert_contains("ok=1 embedded", line, "\"ok\":1")
    _assert_contains("input echoed", line, "\"input\":\"what is water\"")
    _assert_contains("reply echoed", line, "\"reply\":\"H2O is a compound\"")
    _assert_contains("reasoning echoed", line, "\"reasoning\":\"def:water\"")
    _assert_contains("refusal empty", line, "\"refusal_reason\":\"\"")
}

fn test_json_exchange_refused() {
    let line = _chat_json_encode_exchange("bad input", "[refused] policy veto", "")
    _assert_contains("[refused] -> ok=0", line, "\"ok\":0")
    _assert_contains("[refused] -> refusal_reason=refused", line, "\"refusal_reason\":\"refused\"")
}

fn test_json_exchange_silent() {
    let line = _chat_json_encode_exchange("mystery", "[silent]", "")
    _assert_contains("[silent] -> ok=0", line, "\"ok\":0")
    _assert_contains("[silent] -> refusal_reason=silent", line, "\"refusal_reason\":\"silent\"")
}

fn test_json_exchange_escapes_quotes() {
    let line = _chat_json_encode_exchange("she said \"hi\"", "ok", "")
    _assert_contains("embedded quotes escaped", line, "\\\"hi\\\"")
}

fn test_json_exchange_escapes_newlines() {
    let line = _chat_json_encode_exchange("line1\nline2", "ok", "")
    _assert_contains("embedded newline escaped", line, "line1\\nline2")
}

fn test_json_exchange_null_inputs_safe() {
    // A caller that passes 0 (unset) instead of "" should not crash.
    let line = _chat_json_encode_exchange(0, 0, 0)
    _assert_contains("null inputs normalise to empty strings", line, "\"input\":\"\"")
    _assert_contains("null reply -> ok=1 (no sentinel)", line, "\"ok\":1")
}

// ---- history path resolution --------------------------------------------

fn test_history_path_explicit_override() {
    ce_str_eq("HISTORY_FILE override wins over HOME",
        _chat_history_path("/tmp/foo", "/home/user"), "/tmp/foo")
}

fn test_history_path_default_from_home() {
    ce_str_eq("HISTORY_FILE unset, HOME set -> default under HOME",
        _chat_history_path(0, "/home/user"), "/home/user/.crossengin_history")
}

fn test_history_path_no_home_no_override() {
    ce_str_eq("no override + no HOME -> empty (disable)",
        _chat_history_path(0, 0), "")
    ce_str_eq("empty override + empty HOME -> empty",
        _chat_history_path("", ""), "")
}

fn test_history_enabled_default_on() {
    ce_eq("HISTORY env unset -> enabled", _chat_history_enabled(0), 1)
    ce_eq("HISTORY env empty -> enabled", _chat_history_enabled(""), 1)
    ce_eq("HISTORY=1 -> enabled", _chat_history_enabled("1"), 1)
}

fn test_history_enabled_disable_via_env() {
    ce_eq("HISTORY=0 -> disabled", _chat_history_enabled("0"), 0)
}

// ---- run all ------------------------------------------------------------

fn main() {
    test_parse_no_flags()
    test_parse_json_only()
    test_parse_json_with_other()
    test_parse_no_json_with_other()
    test_parse_null_argv_safe()

    test_effective_argv_wins()
    test_effective_env_activates()
    test_effective_env_unset()

    test_history_trim_under_cap()
    test_history_trim_at_cap()
    test_history_trim_over_cap()
    test_history_trim_default_cap_matches_doc()
    test_history_trim_zero_cap_empties()
    test_history_trim_neg_cap_empties()
    test_history_trim_null_lines_safe()

    test_history_lines_empty()
    test_history_lines_single_no_newline()
    test_history_lines_multi()
    test_history_join_terminates()
    test_history_round_trip()

    test_color_off_by_default()
    test_color_on_when_env_1()
    test_color_no_color_wins()
    test_color_json_forbids()
    test_color_env_zero_off()

    test_wrap_disabled_passthrough()
    test_wrap_enabled_contains_frame()
    test_wrap_refusal_color()
    test_wrap_meta_color()

    test_json_exchange_ok()
    test_json_exchange_refused()
    test_json_exchange_silent()
    test_json_exchange_escapes_quotes()
    test_json_exchange_escapes_newlines()
    test_json_exchange_null_inputs_safe()

    test_history_path_explicit_override()
    test_history_path_default_from_home()
    test_history_path_no_home_no_override()
    test_history_enabled_default_on()
    test_history_enabled_disable_via_env()

    ce_summary("chat_cli_polish")
    return 0
}

main()
