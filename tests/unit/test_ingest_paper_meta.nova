// Unit tests for src/ingest/importers/paper_meta.nova.

import "../ce_test.nova"
import "../../src/ingest/importers/paper_meta.nova"

fn test_empty() {
    let r = pm_parse_text("", "papers")
    ce_eq("no records", len(pm_records(r)), 0)
}

fn test_single_paper() {
    let text = "DOI 10.1038/nature12373\n"
             + "TITLE Cerebral Cortex Function\n"
             + "AUTHOR Smith J\n"
             + "AUTHOR Doe A\n"
             + "YEAR 2013\n"
             + "ABSTRACT-KEY memory\n"
             + "ABSTRACT-KEY hippocampus\n"
             + "CITES 10.1038/nature10102 supports\n"
    let r = pm_parse_text(text, "papers")
    let recs = pm_records(r)
    ce_eq("one paper", len(recs), 1)
    let rec = recs[0]
    ce_eq("kg papers", cur_kg(rec), "papers")
    ce_check("src doi tag", str_eq_bytes(cur_source(rec), "src:paper:doi:10.1038/nature12373") == 1)
    // atoms: paper, paper-title, year_2013, author_Smith_J, author_Doe_A,
    //        memory, hippocampus, cited paper -> 8
    ce_eq("8 atoms", len(cur_atoms(rec)), 8)
    // implications: paper->title, ->year, ->2 authors, ->2 keys = 6
    ce_eq("6 imps", len(cur_imps(rec)), 6)
    // 1 citation
    ce_eq("1 cite", len(cur_cites(rec)), 1)
    ce_eq("validator", cur_validate(rec), CUR_OK)
}

fn test_two_papers_blank_separated() {
    let text = "DOI 10.1/aaa\nTITLE Paper A\n\nDOI 10.1/bbb\nTITLE Paper B\n"
    let r = pm_parse_text(text, "papers")
    let recs = pm_records(r)
    ce_eq("two papers", len(recs), 2)
    ce_check("first doi", str_eq_bytes(cur_source(recs[0]), "src:paper:doi:10.1/aaa") == 1)
    ce_check("second doi", str_eq_bytes(cur_source(recs[1]), "src:paper:doi:10.1/bbb") == 1)
}

fn test_no_doi_skipped() {
    let text = "TITLE No DOI\nAUTHOR X\n"
    let r = pm_parse_text(text, "papers")
    ce_eq("no records", len(pm_records(r)), 0)
    ce_check("error logged", len(pm_errors(r)) >= 1)
}

fn test_contradicts_creates_implication() {
    let text = "DOI 10.1/aaa\n"
             + "TITLE A\n"
             + "CITES 10.1/bbb contradicts\n"
    let r = pm_parse_text(text, "papers")
    let rec = pm_records(r)[0]
    ce_eq("1 cite", len(cur_cites(rec)), 1)
    ce_check("cite relation contradicts",
             str_eq_bytes(cur_cites(rec)[0][CUR_CITE_REL], "contradicts") == 1)
    // paper -> cited implication seeded on contradicts
    let has_shadow = 0
    let i = 0
    while i < len(cur_imps(rec)) {
        let ii = cur_imps(rec)[i]
        if str_eq_bytes(ii[CUR_IMP_ANTE], "paper_doi_10.1_aaa") == 1 {
            if str_eq_bytes(ii[CUR_IMP_CONSEQ], "paper_doi_10.1_bbb") == 1 {
                has_shadow = 1
            }
        }
        i = i + 1
    }
    ce_eq("shadow imp present", has_shadow, 1)
}

fn test_unknown_key_logged_but_skipped() {
    let text = "DOI 10.1/x\nWEIRD stuff\nTITLE T\n"
    let r = pm_parse_text(text, "papers")
    ce_eq("one paper", len(pm_records(r)), 1)
    ce_check("has error", len(pm_errors(r)) >= 1)
}

fn test_comments_ignored() {
    let text = "# leading\nDOI 10.1/x\n# mid\nTITLE T\n"
    let r = pm_parse_text(text, "papers")
    ce_eq("one paper", len(pm_records(r)), 1)
    ce_eq("no errors", len(pm_errors(r)), 0)
}

fn main() {
    test_empty()
    test_single_paper()
    test_two_papers_blank_separated()
    test_no_doi_skipped()
    test_contradicts_creates_implication()
    test_unknown_key_logged_but_skipped()
    test_comments_ignored()
    ce_summary("ingest_paper_meta")
}

main()
