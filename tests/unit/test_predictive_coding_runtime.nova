// Unit tests for src/learning/predictive_coding_runtime.nova
// Verifies residual and precision-weighted error, suppression of well-predicted
// input, the surprise threshold, the upward XSIG_ERROR signal, and the
// prediction buffer with decay. ADR-0024.

import "../ce_test.nova"
import "../../src/learning/predictive_coding_runtime.nova"

fn test_error_and_thresholds() {
    ce_eq("residual", pc_residual(800, 300), 500)
    ce_eq("negative residual", pc_residual(200, 500), -300)
    // Precision scales the error.
    ce_eq("full precision", pc_precision_error(800, 300, 1000), 500)
    ce_eq("half precision", pc_precision_error(800, 300, 500), 250)
    // Suppression: small error does not propagate.
    ce_eq("well-predicted suppressed", pc_should_emit(pc_residual(320, 300)), 0)
    ce_eq("large error emits", pc_should_emit(500), 1)
    ce_eq("negative large error emits", pc_should_emit(-500), 1)
    // Surprise threshold.
    ce_eq("below surprise", pc_is_surprise(200), 0)
    ce_eq("above surprise", pc_is_surprise(400), 1)
}

fn test_error_signal() {
    let s = pc_emit_error(3, 9, -450)
    ce_eq("is XSIG_ERROR", sig_type(s), XSIG_ERROR)
    ce_eq("high priority", sig_priority(s), 7)
    ce_eq("strength is magnitude", sig_strength(s), 450)
    ce_eq("meta carries signed error", sig_meta(s), -450)
}

fn test_prediction_buffer() {
    let buf = pc_buffer_new()
    ce_eq("no prediction -> 0", pc_buffer_get(buf, 5), 0)
    pc_buffer_set(buf, 5, 600)
    ce_eq("prediction set", pc_buffer_get(buf, 5), 600)
    pc_buffer_set(buf, 5, 700)   // replace, not duplicate
    ce_eq("prediction replaced", pc_buffer_get(buf, 5), 700)
    // Process an observation: actual 900 vs predicted 700, full precision.
    ce_eq("buffered error", pc_process(buf, 5, 900, 1000), 200)
    // Unrefreshed predictions decay.
    pc_buffer_decay(buf, 500)
    ce_eq("prediction decayed", pc_buffer_get(buf, 5), 350)
}

// P2 (ADR-0052): the adaptive predictor closes the predict -> error -> learn
// loop. On a stationary observation its delta-rule estimate converges and the
// prediction error falls toward zero -- the metric the bench tracks.
fn test_adaptive_predictor() {
    let p = pc_pred_new()
    ce_eq("unseen prediction is 0", pc_pred_predict(p, 0, 0), 0)
    let first = pc_abs(pc_pred_error(p, 0, 0, 800, 1000))   // 800 - 0
    let t = 0
    while t < 30 { pc_pred_learn(p, 0, 0, 800, 300); t = t + 1 }
    let last = pc_abs(pc_pred_error(p, 0, 0, 800, 1000))
    ce_check("prediction converged toward the observation", pc_pred_predict(p, 0, 0) > 750)
    ce_check("error fell after learning", last < first)
    ce_check("error driven near zero", last < 60)
}

// Distinct contexts learn independent targets -- the basis of next-moment
// sequence prediction (predict the successor of the current moment).
fn test_context_keyed_prediction() {
    let p = pc_pred_new()
    let i = 0
    while i < 30 {
        pc_pred_learn(p, 0, 0, 800, 300)   // context 0 -> 800
        pc_pred_learn(p, 1, 0, 200, 300)   // context 1 -> 200
        i = i + 1
    }
    ce_check("context 0 learned ~800", pc_pred_predict(p, 0, 0) > 750)
    ce_check("context 1 learned ~200", pc_pred_predict(p, 1, 0) < 260)
    ce_check("contexts stay independent", pc_pred_predict(p, 0, 0) > pc_pred_predict(p, 1, 0))
}

// The neuromodulator scalar that drives three-factor plasticity.
fn test_neuromod_scalar() {
    ce_eq("reward passes through at neutral salience", pc_neuromod_scalar(500, 0, 0), 500)
    ce_check("surprise + error amplify learning", pc_neuromod_scalar(500, 600, 400) > 500)
    ce_eq("sign preserved (punishment)", pc_neuromod_scalar(-500, 0, 0), -500)
    ce_check("clamped to +/-1000", pc_neuromod_scalar(1000, 1000, 1000) <= 1000)
    ce_eq("no reward -> no signal regardless of salience", pc_neuromod_scalar(0, 1000, 1000), 0)
}

fn main() {
    test_error_and_thresholds()
    test_error_signal()
    test_prediction_buffer()
    test_adaptive_predictor()
    test_context_keyed_prediction()
    test_neuromod_scalar()
    ce_summary("predictive_coding_runtime")
}

main()
