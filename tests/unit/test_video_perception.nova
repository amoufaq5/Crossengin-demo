// Unit tests for src/io/transducers/video_perception.nova -- the PURE seam
// (NL_AND_COVERAGE C1; ADR-0058). Real decoding is integration-only; here we
// cover the decoder registry, default selection, name<->id mapping, and the
// fresh-result accessors.

import "../ce_test.nova"
import "../../src/io/transducers/video_perception.nova"

fn test_seam_registry() {
    let s = vid_seam_new()
    ce_eq("builtins registered -> enabled", vid_seam_enabled(s), 1)
    ce_eq("y4m name maps to its id", vid_seam_decoder_id_for(s, "y4m"), VID_DECODER_Y4M)
    ce_eq("stub name maps to its id", vid_seam_decoder_id_for(s, "stub"), VID_DECODER_STUB)
    ce_eq("default decoder is y4m (env unset)", vid_seam_default_decoder(s), VID_DECODER_Y4M)
    ce_str_eq("default decoder name", vid_seam_decoder_name(s), "y4m")
    // changing the default is reflected by the name.
    vid_seam_set_default(s, VID_DECODER_STUB)
    ce_str_eq("after set_default(stub)", vid_seam_decoder_name(s), "stub")
    // a custom decoder can be registered and resolved.
    vid_register_decoder(s, "mydec", 42)
    ce_eq("custom decoder resolves", vid_seam_decoder_id_for(s, "mydec"), 42)
}

fn test_fresh_results() {
    let s = vid_seam_new()
    ce_eq("fresh: call count 0", vid_seam_call_count(s), 0)
    ce_eq("fresh: last confidence 0", vid_seam_last_confidence(s), 0)
    ce_str_eq("fresh: no error", vid_seam_last_error(s), "")
    ce_eq("fresh: 0 frames", vid_seam_last_frame_count(s), 0)
}

fn main() {
    test_seam_registry()
    test_fresh_results()
    ce_summary("video_perception")
}
main()
