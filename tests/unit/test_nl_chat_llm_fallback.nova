// Unit tests for the R95 chat-side LLM fallback seam.
//
// examples/crossengin_chat.nova's `_try_nl` calls print() directly and
// pulls in a large slice of the substrate (perception, memory, formal
// chat, ingestion, ...), which makes it impractical to import here as
// a black-box surface. The plan explicitly allows testing the SHARED
// helper (nl_llm_try_fallback) for the chat seam, since the chat's
// only R95-specific behavior IS calling that helper and behaving on
// its return. This test asserts the exact contract the chat REPL
// relies on:
//
//   * NLK_NONE never reaches the fallback (chat returns 0 first).
//   * On a grammar-parseable q the helper is a no-op.
//   * On UNPARSED with sidecar off the helper returns UNPARSED
//     (chat then returns 0 and cognition takes over -- existing
//     "genuinely no NL match" behavior preserved).
//   * On UNPARSED with sidecar success the helper returns a valid
//     StructuredQuery (chat then continues to nl_execute).
//   * On UNPARSED with sidecar failure the helper returns UNPARSED
//     and metrics show attempt + failure.
//
// The two-surface metric singleton wiring is exercised inline by
// spinning up a fresh nl_metrics_new() per test, matching what
// _ensure_nl_metrics() does in the chat.

import "../ce_test.nova"
import "../../src/nl/nl_llm_sidecar.nova"
import "../../src/nl/nl_metrics.nova"
import "../../src/nl/grammar_parser.nova"
import "../../src/nl/query_shape.nova"
import "../../src/util/str_safe.nova"

// Mirror the chat's helper semantics -- the anonymous holder bucket
// is the correct home for local-user chat traffic.
let _CHAT_HOLDER = ""

// ---- chat's expected fast-path (NLK_NONE) --------------------------------

fn test_chat_none_never_reaches_helper() {
    // grammar_parse("") returns NLK_NONE; chat returns 0 before
    // ever calling nl_llm_try_fallback -- but if some future
    // refactor mis-routes it, the helper must still no-op safely.
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("KIND research\nARG cats\n")
    let metrics = nl_metrics_new()
    let q = grammar_parse("")
    ce_eq("empty is NONE", sq_kind(q), NLK_NONE)
    let out = nl_llm_try_fallback(q, "", metrics, _CHAT_HOLDER)
    ce_eq("still NONE",   sq_kind(out), NLK_NONE)
    ce_eq("no attempts",
        nl_metrics_llm_fallback_attempts(metrics, _CHAT_HOLDER), 0)
}

// ---- grammar success: helper is a no-op ----------------------------------

fn test_chat_grammar_success_bypasses_fallback() {
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("KIND research\nARG cats\n")
    let metrics = nl_metrics_new()
    let q = grammar_parse("what is mars")
    ce_check("not UNPARSED", sq_kind(q) != NLK_UNPARSED)
    ce_check("not NONE",     sq_kind(q) != NLK_NONE)
    let out = nl_llm_try_fallback(q, "what is mars",
                                   metrics, _CHAT_HOLDER)
    // Same kind, same parser -- helper made no observable change.
    ce_eq("same kind",   sq_kind(out), sq_kind(q))
    ce_eq("parser=grammar",
        str_eq_bytes(sq_parser_used(out), "grammar"), 1)
    ce_eq("attempts=0",
        nl_metrics_llm_fallback_attempts(metrics, _CHAT_HOLDER), 0)
    ce_eq("successes=0",
        nl_metrics_llm_fallback_successes(metrics, _CHAT_HOLDER), 0)
    ce_eq("failures=0",
        nl_metrics_llm_fallback_failures(metrics, _CHAT_HOLDER), 0)
}

// ---- UNPARSED + sidecar off: preserve legacy fall-through -----------------

fn test_chat_unparsed_sidecar_off_returns_unparsed() {
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_off()
    let metrics = nl_metrics_new()
    let q = grammar_parse("floof floof glorpity blibble")
    ce_eq("grammar UNPARSED", sq_kind(q), NLK_UNPARSED)
    let out = nl_llm_try_fallback(q, "floof floof glorpity blibble",
                                   metrics, _CHAT_HOLDER)
    ce_eq("still UNPARSED",  sq_kind(out), NLK_UNPARSED)
    ce_eq("no attempts",
        nl_metrics_llm_fallback_attempts(metrics, _CHAT_HOLDER), 0)
    // total + unparsed are the chat's responsibility (inc'd BEFORE
    // calling the helper); the helper itself never touches them.
    ce_eq("no total inc from helper",
        nl_metrics_total(metrics, _CHAT_HOLDER), 0)
    ce_eq("no unparsed inc from helper",
        nl_metrics_unparsed(metrics, _CHAT_HOLDER), 0)
}

// ---- UNPARSED + sidecar success: helper promotes --------------------------

fn test_chat_unparsed_sidecar_success_promotes() {
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("KIND research\nARG cats\n")
    let metrics = nl_metrics_new()
    let q = grammar_parse("floof floof glorpity blibble")
    ce_eq("grammar UNPARSED", sq_kind(q), NLK_UNPARSED)
    let out = nl_llm_try_fallback(q, "floof floof glorpity blibble",
                                   metrics, _CHAT_HOLDER)
    ce_eq("now RESEARCH",     sq_kind(out), NLK_RESEARCH)
    ce_eq("topic threaded",
        str_eq_bytes(sq_research_topic(out), "cats"), 1)
    ce_eq("parser=llm",
        str_eq_bytes(sq_parser_used(out), "llm"), 1)
    ce_eq("attempts=1",
        nl_metrics_llm_fallback_attempts(metrics, _CHAT_HOLDER), 1)
    ce_eq("successes=1",
        nl_metrics_llm_fallback_successes(metrics, _CHAT_HOLDER), 1)
    ce_eq("failures=0",
        nl_metrics_llm_fallback_failures(metrics, _CHAT_HOLDER), 0)
}

// ---- UNPARSED + sidecar malformed: still UNPARSED, failure counted --------

fn test_chat_unparsed_sidecar_malformed_counts_failure() {
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("some garbage nothing valid")
    let metrics = nl_metrics_new()
    let q = grammar_parse("floof floof glorpity blibble")
    let out = nl_llm_try_fallback(q, "floof floof glorpity blibble",
                                   metrics, _CHAT_HOLDER)
    ce_eq("still UNPARSED",  sq_kind(out), NLK_UNPARSED)
    ce_eq("attempts=1",
        nl_metrics_llm_fallback_attempts(metrics, _CHAT_HOLDER), 1)
    ce_eq("failures=1",
        nl_metrics_llm_fallback_failures(metrics, _CHAT_HOLDER), 1)
    ce_eq("successes=0",
        nl_metrics_llm_fallback_successes(metrics, _CHAT_HOLDER), 0)
}

// ---- runner ---------------------------------------------------------------

fn main() {
    test_chat_none_never_reaches_helper()
    test_chat_grammar_success_bypasses_fallback()
    test_chat_unparsed_sidecar_off_returns_unparsed()
    test_chat_unparsed_sidecar_success_promotes()
    test_chat_unparsed_sidecar_malformed_counts_failure()
    ce_summary("nl_chat_llm_fallback")
}

main()
