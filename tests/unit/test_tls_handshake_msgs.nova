// Unit tests for src/net/tls/tls_handshake.nova.
//
// Coverage:
//   * Round-trip: serialize -> parse -> equal for each message type.
//   * Byte-level: hand-encoded values decode correctly.
//   * Extension boundary: unknown extension is ignored on receive.
//   * Reject: cipher != 0x1303 / group != x25519 / sigalg != ed25519.
//   * Reject: legacy_version != 0x0303.
//   * Reject: length overflow (extension length > message length).

import "../ce_test.nova"
import "../../src/net/tls/tls_handshake.nova"

// ---- helpers -----------------------------------------------------------

fn _hm_bytes(n, seed) {
    let out = list_new()
    let i = 0
    let x = seed
    while i < n {
        x = int_and(x * 1103515245 + 12345, 2147483647)
        push(out, int_and(x, 255))
        i = i + 1
    }
    return out
}

fn _hm_byte_eq(a, b) {
    if len(a) != len(b) { return 0 }
    let i = 0
    let n = len(a)
    while i < n {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// ---- ClientHello round-trip -------------------------------------------

fn test_ch_round_trip_no_sni() {
    let ch = hs_client_hello_new()
    hs_client_hello_set_random(ch, _hm_bytes(32, 111))
    hs_client_hello_set_keyshare(ch, _hm_bytes(32, 222))
    let msg = hs_client_hello_serialize(ch)
    ce_check("wire non-empty", len(msg) > 0)
    ce_eq("type byte", msg[0], TLS_HS_CLIENT_HELLO)
    let parsed = hs_client_hello_parse(msg)
    ce_check("parse ok", parsed != 0)
    ce_eq("random matches",
          _hm_byte_eq(hs_client_hello_random(parsed), _hm_bytes(32, 111)), 1)
    ce_eq("keyshare matches",
          _hm_byte_eq(hs_client_hello_keyshare(parsed), _hm_bytes(32, 222)), 1)
    ce_eq("no sni", hs_client_hello_sni_present(parsed), 0)
}

fn test_ch_round_trip_with_sni() {
    let ch = hs_client_hello_new()
    hs_client_hello_set_random(ch, _hm_bytes(32, 55))
    hs_client_hello_set_keyshare(ch, _hm_bytes(32, 66))
    let sni = list_new()
    push(sni, 101)   // 'e'
    push(sni, 120)   // 'x'
    push(sni, 46)    // '.'
    push(sni, 105)   // 'i'
    push(sni, 111)   // 'o'
    hs_client_hello_set_sni(ch, sni)
    let msg = hs_client_hello_serialize(ch)
    let parsed = hs_client_hello_parse(msg)
    ce_check("parse ok", parsed != 0)
    ce_eq("sni present", hs_client_hello_sni_present(parsed), 1)
    ce_eq("sni bytes eq",
          _hm_byte_eq(hs_client_hello_sni(parsed), sni), 1)
}

fn test_ch_byte_level() {
    let ch = hs_client_hello_new()
    hs_client_hello_set_random(ch, _hm_bytes(32, 7))
    hs_client_hello_set_keyshare(ch, _hm_bytes(32, 8))
    let msg = hs_client_hello_serialize(ch)
    // First 4 bytes: type=1, length (24-bit BE) = body length.
    ce_eq("hs type = 1", msg[0], 1)
    // Body starts at index 4: legacy_version.
    ce_eq("legacy ver hi = 3", msg[4], 3)
    ce_eq("legacy ver lo = 3", msg[5], 3)
    // Session ID length = 0 immediately after random (at offset 4+2+32 = 38).
    ce_eq("session_id length = 0", msg[38], 0)
    // Cipher suites list byte-length = 2, then 0x13, 0x03.
    ce_eq("cs list hi = 0", msg[39], 0)
    ce_eq("cs list lo = 2", msg[40], 2)
    ce_eq("cipher byte 1 = 0x13", msg[41], 19)
    ce_eq("cipher byte 2 = 0x03", msg[42], 3)
    // Compression methods: 1 byte length + one null.
    ce_eq("cm len = 1", msg[43], 1)
    ce_eq("cm null", msg[44], 0)
}

fn test_ch_reject_wrong_version() {
    let ch = hs_client_hello_new()
    hs_client_hello_set_random(ch, _hm_bytes(32, 1))
    hs_client_hello_set_keyshare(ch, _hm_bytes(32, 2))
    let msg = hs_client_hello_serialize(ch)
    // Flip legacy_version byte at offset 4 (should be 0x03 -> flip to 0x02).
    let bad = list_new()
    let i = 0
    let n = len(msg)
    while i < n { push(bad, msg[i]); i = i + 1 }
    list_set(bad, 4, 2)
    let parsed = hs_client_hello_parse(bad)
    ce_eq("wrong version rejected", parsed, 0)
}

fn test_ch_reject_wrong_cipher() {
    // Hand-encode a body with a single cipher suite = 0x00,0x2f (AES-SHA).
    let body = list_new()
    push(body, 3); push(body, 3)   // legacy_version
    let i = 0
    while i < 32 { push(body, i); i = i + 1 }
    push(body, 0)                   // session_id len
    push(body, 0); push(body, 2)    // cipher_suites list len = 2
    push(body, 0); push(body, 47)   // cipher = TLS_RSA_WITH_AES_128_CBC_SHA
    push(body, 1); push(body, 0)    // compression: 1 byte, null
    push(body, 0); push(body, 0)    // extensions total len = 0
    // Wrap in header manually.
    let wrapped = hs_wrap_header(TLS_HS_CLIENT_HELLO, body)
    ce_eq("wrong cipher rejected", hs_client_hello_parse(wrapped), 0)
}

fn test_ch_reject_missing_keyshare() {
    // A ClientHello with supported_versions + supported_groups + sigalg
    // but NO key_share -- must reject.
    let body = list_new()
    push(body, 3); push(body, 3)
    let i = 0
    while i < 32 { push(body, i); i = i + 1 }
    push(body, 0)                   // session_id
    push(body, 0); push(body, 2)    // cipher list
    push(body, 19); push(body, 3)   // 0x1303
    push(body, 1); push(body, 0)    // compression
    let exts = list_new()
    // supported_versions
    push(exts, 0); push(exts, 43); push(exts, 0); push(exts, 3)
    push(exts, 2); push(exts, 3); push(exts, 4)
    // supported_groups
    push(exts, 0); push(exts, 10); push(exts, 0); push(exts, 4)
    push(exts, 0); push(exts, 2); push(exts, 0); push(exts, 29)
    // signature_algorithms
    push(exts, 0); push(exts, 13); push(exts, 0); push(exts, 4)
    push(exts, 0); push(exts, 2); push(exts, 8); push(exts, 7)
    push(body, int_and(int_shr(len(exts), 8), 255))
    push(body, int_and(len(exts), 255))
    let j = 0
    while j < len(exts) { push(body, exts[j]); j = j + 1 }
    let wrapped = hs_wrap_header(TLS_HS_CLIENT_HELLO, body)
    ce_eq("no keyshare rejected", hs_client_hello_parse(wrapped), 0)
}

fn test_ch_extension_length_overflow() {
    let ch = hs_client_hello_new()
    hs_client_hello_set_random(ch, _hm_bytes(32, 91))
    hs_client_hello_set_keyshare(ch, _hm_bytes(32, 92))
    let msg = hs_client_hello_serialize(ch)
    // Corrupt the outer extensions length -- pump it up by 100 so it
    // overruns the message body.
    let bad = list_new()
    let i = 0
    let n = len(msg)
    while i < n { push(bad, msg[i]); i = i + 1 }
    // Body offsets: ver(2)+random(32)+sid_len(1)+cs_list(2)+cs(2)+cm_len(1)+
    // cm(1) = 41, so ext_total_ln lives at body[41-42], wire[45-46].
    let ext_len_off = 45
    let cur_hi = bad[ext_len_off]
    let cur_lo = bad[ext_len_off + 1]
    let cur = cur_hi * 256 + cur_lo
    let bumped = cur + 100
    list_set(bad, ext_len_off, int_and(int_shr(bumped, 8), 255))
    list_set(bad, ext_len_off + 1, int_and(bumped, 255))
    ce_eq("ext len overflow rejected", hs_client_hello_parse(bad), 0)
}

fn test_ch_unknown_extension_ignored() {
    // Serialize normally; splice an unknown extension into the ext list.
    let ch = hs_client_hello_new()
    hs_client_hello_set_random(ch, _hm_bytes(32, 33))
    hs_client_hello_set_keyshare(ch, _hm_bytes(32, 44))
    let msg = hs_client_hello_serialize(ch)
    // Build a new msg where we prepend an unknown extension inside the
    // extensions block. Extract body, extract ext list, wrap unknown at
    // front.
    // Body offset is 4 (hs header). In-body ext_total_ln is at body[41-42].
    let body_off = 4
    let ext_len_off = body_off + 41
    let ext_len = msg[ext_len_off] * 256 + msg[ext_len_off + 1]
    // Unknown extension: type=0xDDDD, len=3, data=0xAABBCC.
    let unknown = list_new()
    push(unknown, 221); push(unknown, 221)
    push(unknown, 0); push(unknown, 3)
    push(unknown, 170); push(unknown, 187); push(unknown, 204)
    let new_ext_len = ext_len + len(unknown)
    // Reassemble.
    let out = list_new()
    let i = 0
    while i < ext_len_off { push(out, msg[i]); i = i + 1 }
    push(out, int_and(int_shr(new_ext_len, 8), 255))
    push(out, int_and(new_ext_len, 255))
    let u = 0
    while u < len(unknown) { push(out, unknown[u]); u = u + 1 }
    let ext_body_start = ext_len_off + 2
    let ext_body_end = ext_body_start + ext_len
    let k = ext_body_start
    while k < ext_body_end { push(out, msg[k]); k = k + 1 }
    let rest = ext_body_end
    while rest < len(msg) { push(out, msg[rest]); rest = rest + 1 }
    // Fix the outer 3-byte handshake length.
    let new_body_len = len(out) - body_off
    list_set(out, 1, int_and(int_shr(new_body_len, 16), 255))
    list_set(out, 2, int_and(int_shr(new_body_len, 8), 255))
    list_set(out, 3, int_and(new_body_len, 255))
    let parsed = hs_client_hello_parse(out)
    ce_check("unknown ext ignored", parsed != 0)
    ce_eq("keyshare survives",
          _hm_byte_eq(hs_client_hello_keyshare(parsed), _hm_bytes(32, 44)), 1)
}

// ---- ServerHello round-trip -------------------------------------------

fn test_sh_round_trip() {
    let sh = hs_server_hello_new()
    hs_server_hello_set_random(sh, _hm_bytes(32, 700))
    hs_server_hello_set_keyshare(sh, _hm_bytes(32, 800))
    let msg = hs_server_hello_serialize(sh)
    ce_eq("hs type = 2", msg[0], TLS_HS_SERVER_HELLO)
    let parsed = hs_server_hello_parse(msg)
    ce_check("parse ok", parsed != 0)
    ce_eq("random matches",
          _hm_byte_eq(hs_server_hello_random(parsed), _hm_bytes(32, 700)), 1)
    ce_eq("keyshare matches",
          _hm_byte_eq(hs_server_hello_keyshare(parsed), _hm_bytes(32, 800)), 1)
}

fn test_sh_reject_wrong_version() {
    let sh = hs_server_hello_new()
    hs_server_hello_set_random(sh, _hm_bytes(32, 1))
    hs_server_hello_set_keyshare(sh, _hm_bytes(32, 2))
    let msg = hs_server_hello_serialize(sh)
    let bad = list_new()
    let i = 0
    while i < len(msg) { push(bad, msg[i]); i = i + 1 }
    list_set(bad, 4, 3)   // still 3
    list_set(bad, 5, 4)   // was 3, now 4 -> version 0x0304 (illegal for legacy)
    ce_eq("wrong legacy_version rejected",
          hs_server_hello_parse(bad), 0)
}

// ---- EncryptedExtensions ---------------------------------------------

fn test_ee_round_trip() {
    let msg = hs_encrypted_extensions_serialize()
    let t = list_new(); push(t, 0)
    let l = list_new(); push(l, 0)
    ce_eq("header parses", hs_parse_header(msg, 0, t, l), 1)
    ce_eq("type = EE", t[0], TLS_HS_ENCRYPTED_EXTENSIONS)
    // Body = 2 zero bytes.
    ce_eq("body len = 2", l[0], 2)
    // Parse body.
    let body = list_new()
    push(body, msg[4])
    push(body, msg[5])
    ce_eq("parse ok", hs_encrypted_extensions_parse_body(body), 1)
}

fn test_ee_reject_bad_len() {
    let body = list_new()
    push(body, 0); push(body, 10)   // claims 10 bytes of ext data
    ce_eq("bad ee len rejected",
          hs_encrypted_extensions_parse_body(body), 0)
}

// ---- Certificate --------------------------------------------------------

fn test_cert_round_trip() {
    let leaf = _hm_bytes(400, 999)
    let msg = hs_certificate_serialize(leaf)
    ce_eq("type = 11", msg[0], TLS_HS_CERTIFICATE)
    // Extract body.
    let body_len = msg[1] * 65536 + msg[2] * 256 + msg[3]
    let body = list_new()
    let i = 0
    while i < body_len {
        push(body, msg[4 + i])
        i = i + 1
    }
    let parsed = hs_certificate_parse_body(body)
    ce_check("parsed leaf non-zero", parsed != 0)
    ce_eq("leaf bytes eq", _hm_byte_eq(parsed, leaf), 1)
}

// ---- CertificateVerify -------------------------------------------------

fn test_certverify_round_trip() {
    let sig = _hm_bytes(64, 501)
    let msg = hs_certificate_verify_serialize(sig)
    ce_eq("type = 15", msg[0], TLS_HS_CERTIFICATE_VERIFY)
    let body_len = msg[1] * 65536 + msg[2] * 256 + msg[3]
    let body = list_new()
    let i = 0
    while i < body_len { push(body, msg[4 + i]); i = i + 1 }
    let parsed = hs_certificate_verify_parse_body(body)
    ce_check("parsed sig", parsed != 0)
    ce_eq("sig bytes eq", _hm_byte_eq(parsed, sig), 1)
}

fn test_certverify_reject_wrong_sigalg() {
    // Body with algorithm = 0x0403 (ECDSA_SECP256R1_SHA256).
    let body = list_new()
    push(body, 4); push(body, 3)
    push(body, 0); push(body, 64)
    let i = 0
    while i < 64 { push(body, 0); i = i + 1 }
    ce_eq("wrong sigalg rejected",
          hs_certificate_verify_parse_body(body), 0)
}

fn test_certverify_reject_short_sig() {
    let body = list_new()
    push(body, 8); push(body, 7)
    push(body, 0); push(body, 63)   // claims 63 bytes -- too short
    let i = 0
    while i < 63 { push(body, 0); i = i + 1 }
    ce_eq("short sig rejected",
          hs_certificate_verify_parse_body(body), 0)
}

// ---- Finished ----------------------------------------------------------

fn test_finished_round_trip() {
    let vd = _hm_bytes(32, 8888)
    let msg = hs_finished_serialize(vd)
    ce_eq("type = 20", msg[0], TLS_HS_FINISHED)
    ce_eq("body len = 32",
          msg[1] * 65536 + msg[2] * 256 + msg[3], 32)
    let body = list_new()
    let i = 0
    while i < 32 { push(body, msg[4 + i]); i = i + 1 }
    let parsed = hs_finished_parse_body(body)
    ce_check("parsed", parsed != 0)
    ce_eq("vd bytes eq", _hm_byte_eq(parsed, vd), 1)
}

fn test_finished_reject_wrong_length() {
    let body = list_new()
    let i = 0
    while i < 31 { push(body, 0); i = i + 1 }
    ce_eq("31-byte vd rejected", hs_finished_parse_body(body), 0)
    let body2 = list_new()
    while i < 33 { push(body2, 0); i = i + 1 }
    ce_eq("33-byte vd rejected", hs_finished_parse_body(body2), 0)
}

// ---- header parse edge cases ------------------------------------------

fn test_header_parse_bounds() {
    let short = list_new()
    push(short, 1); push(short, 0); push(short, 0)  // only 3 bytes
    let t = list_new(); push(t, 0)
    let l = list_new(); push(l, 0)
    ce_eq("too short header rejected", hs_parse_header(short, 0, t, l), 0)
    // Header says 100 body bytes but only 4 total.
    let bad = list_new()
    push(bad, 1); push(bad, 0); push(bad, 0); push(bad, 100)
    ce_eq("insufficient body rejected", hs_parse_header(bad, 0, t, l), 0)
    // Legit small message.
    let ok = list_new()
    push(ok, 20); push(ok, 0); push(ok, 0); push(ok, 2)
    push(ok, 42); push(ok, 43)
    ce_eq("ok header", hs_parse_header(ok, 0, t, l), 1)
    ce_eq("parsed type", t[0], 20)
    ce_eq("parsed len", l[0], 2)
}

// ---- main --------------------------------------------------------------

fn main() {
    test_ch_round_trip_no_sni()
    test_ch_round_trip_with_sni()
    test_ch_byte_level()
    test_ch_reject_wrong_version()
    test_ch_reject_wrong_cipher()
    test_ch_reject_missing_keyshare()
    test_ch_extension_length_overflow()
    test_ch_unknown_extension_ignored()
    test_sh_round_trip()
    test_sh_reject_wrong_version()
    test_ee_round_trip()
    test_ee_reject_bad_len()
    test_cert_round_trip()
    test_certverify_round_trip()
    test_certverify_reject_wrong_sigalg()
    test_certverify_reject_short_sig()
    test_finished_round_trip()
    test_finished_reject_wrong_length()
    test_header_parse_bounds()
    ce_summary("tls_handshake_msgs")
}

main()
