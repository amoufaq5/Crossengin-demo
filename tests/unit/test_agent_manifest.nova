// R109 (Phase J, ADR-0210 tier 2): agent manifest parse / serialize /
// validate coverage.

import "../ce_test.nova"
import "../../src/agents/agent_manifest.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- constructor + accessors ------------------------------------------

fn test_new_defaults() {
    let m = agent_manifest_new("triage", "1.0.0", "front-line triage")
    ce_str_eq("name",    agent_manifest_name(m),        "triage")
    ce_str_eq("version", agent_manifest_version(m),     "1.0.0")
    ce_str_eq("desc",    agent_manifest_description(m), "front-line triage")
    ce_eq("no capsule deps", agent_manifest_capsule_dep_count(m), 0)
    ce_eq("no skill deps",   agent_manifest_skill_dep_count(m),   0)
    ce_eq("no pattern deps", agent_manifest_pattern_dep_count(m), 0)
    ce_str_eq("no style",   agent_manifest_style_pin(m),   "")
    ce_str_eq("no persona", agent_manifest_persona_pin(m), "")
    ce_eq("min conf 0",     agent_manifest_min_confidence_milli(m), 0)
    ce_str_eq("attribution auto",
              agent_manifest_attribution(m), "src:agent:triage:v1.0.0")
    ce_str_eq("license default", agent_manifest_license(m), "unspecified")
}

fn test_mutators_idempotent() {
    let m = agent_manifest_new("a", "1", "x")
    ce_eq("cap add",       agent_manifest_add_capsule_dep(m, "cap1"), 1)
    ce_eq("cap dupe",      agent_manifest_add_capsule_dep(m, "cap1"), 0)
    ce_eq("cap count",     agent_manifest_capsule_dep_count(m), 1)
    ce_eq("skill add",     agent_manifest_add_skill_dep(m, "research"), 1)
    ce_eq("skill dupe",    agent_manifest_add_skill_dep(m, "research"), 0)
    ce_eq("skill count",   agent_manifest_skill_dep_count(m), 1)
    ce_eq("pat add",       agent_manifest_add_pattern_dep(m, "debug_common"), 1)
    ce_eq("pat count",     agent_manifest_pattern_dep_count(m), 1)
    agent_manifest_set_style_pin(m, "terse")
    ce_str_eq("style pin", agent_manifest_style_pin(m), "terse")
    agent_manifest_set_persona_pin(m, "alice")
    ce_str_eq("persona pin", agent_manifest_persona_pin(m), "alice")
    agent_manifest_set_min_confidence(m, 700)
    ce_eq("min conf 700", agent_manifest_min_confidence_milli(m), 700)
    // Clamped high.
    agent_manifest_set_min_confidence(m, 5000)
    ce_eq("min conf clamped 1000", agent_manifest_min_confidence_milli(m), 1000)
    agent_manifest_set_min_confidence(m, -100)
    ce_eq("min conf clamped 0", agent_manifest_min_confidence_milli(m), 0)
    agent_manifest_set_attribution(m, "custom:tag")
    ce_str_eq("attribution custom", agent_manifest_attribution(m), "custom:tag")
    agent_manifest_set_license(m, "MIT")
    ce_str_eq("license MIT", agent_manifest_license(m), "MIT")
}

// ---- parser -----------------------------------------------------------

fn _mk_full_manifest_text() {
    return "AGENT-MANIFEST v1\n"
         + "# leading comment\n"
         + "\n"
         + "NAME triage\n"
         + "VERSION 1.0.0\n"
         + "DESCRIPTION front-line triage agent\n"
         + "CAPSULE_DEP solar_system\n"
         + "CAPSULE_DEP world_history\n"
         + "SKILL_DEP research\n"
         + "SKILL_DEP echo\n"
         + "PATTERN_DEP debug_common\n"
         + "STYLE_PIN terse\n"
         + "PERSONA_PIN alice\n"
         + "MIN_CONFIDENCE_MILLI 400\n"
         + "ATTRIBUTION_PREF src:agent:triage:custom\n"
         + "LICENSE Apache-2.0\n"
}

fn test_parse_full() {
    let r = agent_manifest_parse(_mk_full_manifest_text())
    ce_eq("ok", r[0], 1)
    let m = r[1]
    ce_str_eq("name",       agent_manifest_name(m),        "triage")
    ce_str_eq("version",    agent_manifest_version(m),     "1.0.0")
    ce_str_eq("desc",       agent_manifest_description(m), "front-line triage agent")
    ce_eq("2 cap deps",     agent_manifest_capsule_dep_count(m), 2)
    ce_eq("2 skill deps",   agent_manifest_skill_dep_count(m),   2)
    ce_eq("1 pattern dep",  agent_manifest_pattern_dep_count(m), 1)
    ce_str_eq("style",      agent_manifest_style_pin(m),   "terse")
    ce_str_eq("persona",    agent_manifest_persona_pin(m), "alice")
    ce_eq("min conf 400",   agent_manifest_min_confidence_milli(m), 400)
    ce_str_eq("attribution custom",
              agent_manifest_attribution(m), "src:agent:triage:custom")
    ce_str_eq("license Apache", agent_manifest_license(m), "Apache-2.0")
    // Skill_dep order preserved (research first, echo second).
    let sd = agent_manifest_skill_deps(m)
    ce_str_eq("skill_dep[0] research", sd[0], "research")
    ce_str_eq("skill_dep[1] echo",     sd[1], "echo")
}

fn test_parse_missing_banner() {
    let r = agent_manifest_parse("NAME x\nVERSION 1\n")
    ce_eq("ok=0", r[0], 0)
    ce_check("err mentions banner", _has(r[2], "AGENT-MANIFEST v1"))
}

fn test_parse_empty_text() {
    let r = agent_manifest_parse("")
    ce_eq("ok=0", r[0], 0)
    ce_check("err mentions empty", _has(r[2], "empty"))
}

fn test_parse_unknown_directive() {
    let r = agent_manifest_parse("AGENT-MANIFEST v1\nNAME x\nWEIRD junk\n")
    ce_eq("ok=0", r[0], 0)
    ce_check("err names directive", _has(r[2], "WEIRD"))
}

fn test_parse_missing_name_value() {
    let r = agent_manifest_parse("AGENT-MANIFEST v1\nNAME\n")
    ce_eq("ok=0", r[0], 0)
}

fn test_parse_missing_version_value() {
    let r = agent_manifest_parse("AGENT-MANIFEST v1\nNAME x\nVERSION\n")
    ce_eq("ok=0", r[0], 0)
}

fn test_parse_comments_and_blank_lines() {
    let text = "AGENT-MANIFEST v1\n"
             + "\n\n"
             + "# a comment\n"
             + "NAME agent1\n"
             + "  # indented comment\n"
             + "VERSION 2\n"
             + "SKILL_DEP echo\n"
    let r = agent_manifest_parse(text)
    ce_eq("ok=1", r[0], 1)
    ce_str_eq("name", agent_manifest_name(r[1]), "agent1")
}

fn test_parse_leading_whitespace_tolerated() {
    let text = "AGENT-MANIFEST v1\n"
             + "    NAME agent2\n"
             + "\tVERSION 3\n"
             + "  SKILL_DEP echo\n"
    let r = agent_manifest_parse(text)
    ce_eq("ok=1", r[0], 1)
    ce_str_eq("name", agent_manifest_name(r[1]), "agent2")
    ce_str_eq("ver",  agent_manifest_version(r[1]), "3")
    ce_eq("skill deps 1", agent_manifest_skill_dep_count(r[1]), 1)
}

fn test_parse_duplicate_deps_deduped() {
    let text = "AGENT-MANIFEST v1\nNAME a\nVERSION 1\n"
             + "SKILL_DEP echo\nSKILL_DEP echo\nSKILL_DEP research\n"
    let r = agent_manifest_parse(text)
    ce_eq("ok=1", r[0], 1)
    ce_eq("2 unique skills",
          agent_manifest_skill_dep_count(r[1]), 2)
}

fn test_parse_pattern_dep_empty_ok() {
    let text = "AGENT-MANIFEST v1\nNAME a\nVERSION 1\nSKILL_DEP echo\n"
    let r = agent_manifest_parse(text)
    ce_eq("ok=1", r[0], 1)
    ce_eq("no pattern deps", agent_manifest_pattern_dep_count(r[1]), 0)
}

// ---- validator --------------------------------------------------------

fn test_validate_valid() {
    let m = agent_manifest_new("a", "1", "d")
    agent_manifest_add_skill_dep(m, "echo")
    let v = agent_manifest_validate(m)
    ce_eq("ok=1", v[0], 1)
    ce_str_eq("err empty", v[1], "")
}

fn test_validate_missing_name() {
    let m = agent_manifest_new("", "1", "")
    agent_manifest_add_skill_dep(m, "echo")
    let v = agent_manifest_validate(m)
    ce_eq("ok=0", v[0], 0)
    ce_check("err mentions NAME", _has(v[1], "NAME"))
}

fn test_validate_missing_version() {
    let m = agent_manifest_new("x", "", "")
    agent_manifest_add_skill_dep(m, "echo")
    let v = agent_manifest_validate(m)
    ce_eq("ok=0", v[0], 0)
    ce_check("err mentions VERSION", _has(v[1], "VERSION"))
}

fn test_validate_no_skill_deps() {
    let m = agent_manifest_new("x", "1", "")
    let v = agent_manifest_validate(m)
    ce_eq("ok=0", v[0], 0)
    ce_check("err mentions SKILL_DEP", _has(v[1], "SKILL_DEP"))
}

fn test_validate_null() {
    let v = agent_manifest_validate(0)
    ce_eq("ok=0", v[0], 0)
}

// ---- serialize round-trip --------------------------------------------

fn test_serialize_roundtrip() {
    let src = agent_manifest_new("bugfix", "0.9", "coder helper")
    agent_manifest_add_capsule_dep(src, "cap_a")
    agent_manifest_add_skill_dep(src, "coding_helper")
    agent_manifest_add_skill_dep(src, "research")
    agent_manifest_add_pattern_dep(src, "debug_common")
    agent_manifest_set_style_pin(src, "verbose")
    agent_manifest_set_persona_pin(src, "bob")
    agent_manifest_set_min_confidence(src, 350)
    agent_manifest_set_license(src, "MIT")
    let text = agent_manifest_serialize(src)
    ce_check("has banner",   _has(text, "AGENT-MANIFEST v1"))
    ce_check("has NAME",     _has(text, "NAME bugfix"))
    ce_check("has SKILL_DEP", _has(text, "SKILL_DEP coding_helper"))
    ce_check("has PATTERN_DEP", _has(text, "PATTERN_DEP debug_common"))
    ce_check("has STYLE_PIN", _has(text, "STYLE_PIN verbose"))
    ce_check("has PERSONA_PIN", _has(text, "PERSONA_PIN bob"))
    ce_check("has MIN_CONFIDENCE_MILLI 350",
             _has(text, "MIN_CONFIDENCE_MILLI 350"))
    ce_check("has LICENSE MIT", _has(text, "LICENSE MIT"))
    // Re-parse.
    let r = agent_manifest_parse(text)
    ce_eq("re-parse ok", r[0], 1)
    let dst = r[1]
    ce_str_eq("dst name",    agent_manifest_name(dst),    "bugfix")
    ce_str_eq("dst version", agent_manifest_version(dst), "0.9")
    ce_str_eq("dst desc",    agent_manifest_description(dst), "coder helper")
    ce_eq("dst cap deps 1",  agent_manifest_capsule_dep_count(dst), 1)
    ce_eq("dst skill deps 2", agent_manifest_skill_dep_count(dst), 2)
    ce_eq("dst pat deps 1",  agent_manifest_pattern_dep_count(dst), 1)
    ce_str_eq("dst style",   agent_manifest_style_pin(dst), "verbose")
    ce_str_eq("dst persona", agent_manifest_persona_pin(dst), "bob")
    ce_eq("dst min conf",    agent_manifest_min_confidence_milli(dst), 350)
    ce_str_eq("dst license", agent_manifest_license(dst), "MIT")
}

fn main() {
    test_new_defaults()
    test_mutators_idempotent()
    test_parse_full()
    test_parse_missing_banner()
    test_parse_empty_text()
    test_parse_unknown_directive()
    test_parse_missing_name_value()
    test_parse_missing_version_value()
    test_parse_comments_and_blank_lines()
    test_parse_leading_whitespace_tolerated()
    test_parse_duplicate_deps_deduped()
    test_parse_pattern_dep_empty_ok()
    test_validate_valid()
    test_validate_missing_name()
    test_validate_missing_version()
    test_validate_no_skill_deps()
    test_validate_null()
    test_serialize_roundtrip()
    ce_summary("agent_manifest")
}

main()
