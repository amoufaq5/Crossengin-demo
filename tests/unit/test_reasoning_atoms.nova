// Unit tests for src/parts/reasoning/reasoning_atoms.nova
// Verifies operator-atom creation, accessors, confidence/observation, and
// from/to operator lookup. ADR-0031.

import "../ce_test.nova"
import "../../src/parts/reasoning/reasoning_atoms.nova"

fn test_operators() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    ce_str_eq("reasoning kg", kg_label(rkg), "reasoning")
    // Premise/conclusion fact atoms (ids 0,1,2).
    let a = kg_add_atom(rkg, ATOM_FACT, "rain", 0)
    let b = kg_add_atom(rkg, ATOM_FACT, "wet ground", 0)
    let c = kg_add_atom(rkg, ATOM_FACT, "slippery", 0)
    let op1 = rop_new(rkg, ROP_CAUSAL, atom_id(a), atom_id(b), "rain->wet", 0)
    rop_new(rkg, ROP_CAUSAL, atom_id(b), atom_id(c), "wet->slip", 0)
    ce_eq("is operator", is_operator(op1), 1)
    ce_eq("fact not operator", is_operator(a), 0)
    ce_eq("kind causal", rop_kind(op1), ROP_CAUSAL)
    ce_eq("premise", rop_premise(op1), atom_id(a))
    ce_eq("conclusion", rop_conclusion(op1), atom_id(b))
    ce_str_eq("kind name", rop_kind_name(ROP_IMPLY), "implicative")
    // Confidence and observation.
    ce_eq("uniform confidence", rop_confidence(op1), 500)
    rop_observe(op1, 1); rop_observe(op1, 1)
    ce_eq("strengthened", rop_confidence(op1), 750)
}

fn test_lookup() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let a = kg_add_atom(rkg, ATOM_FACT, "a", 0)   // id 0
    let b = kg_add_atom(rkg, ATOM_FACT, "b", 0)   // id 1
    let c = kg_add_atom(rkg, ATOM_FACT, "c", 0)   // id 2
    rop_new(rkg, ROP_CAUSAL, 0, 1, "a->b", 0)
    rop_new(rkg, ROP_IMPLY, 0, 2, "a=>c", 0)
    rop_new(rkg, ROP_CAUSAL, 1, 2, "b->c", 0)
    ce_eq("two operators from a", len(rk_operators_from(rkg, 0)), 2)
    ce_eq("one operator from b", len(rk_operators_from(rkg, 1)), 1)
    ce_eq("two operators to c", len(rk_operators_to(rkg, 2)), 2)
    ce_eq("none to a", len(rk_operators_to(rkg, 0)), 0)
}

// P1.5: the edge index must give the SAME answers as a full scan, including
// after a snapshot-style index reset (kg_rebuild_index leaves it unbuilt; the
// first lookup lazily rebuilds it from the restored operators).
fn test_index_rebuild_equivalence() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    kg_add_atom(rkg, ATOM_FACT, "a", 0)   // 0
    kg_add_atom(rkg, ATOM_FACT, "b", 0)   // 1
    kg_add_atom(rkg, ATOM_FACT, "c", 0)   // 2
    rop_new(rkg, ROP_CAUSAL, 0, 1, "a->b", 0)
    rop_new(rkg, ROP_IMPLY,  0, 2, "a=>c", 0)
    rop_new(rkg, ROP_CAUSAL, 1, 2, "b->c", 0)
    ce_eq("index built after rop_new", kg_edge_index_built(rkg), 1)
    // Simulate the post-load path: rebuild the KG indexes (resets edge idx).
    kg_rebuild_index(rkg)
    ce_eq("edge idx reset to unbuilt", kg_edge_index_built(rkg), 0)
    // First lookup lazily rebuilds and returns identical results + order.
    let from_a = rk_operators_from(rkg, 0)
    ce_eq("rebuilt: two from a", len(from_a), 2)
    ce_eq("rebuilt: built flag set", kg_edge_index_built(rkg), 1)
    ce_eq("order preserved (a->b first)", rop_conclusion(from_a[0]), 1)
    ce_eq("order preserved (a=>c second)", rop_conclusion(from_a[1]), 2)
    ce_eq("rebuilt: two to c", len(rk_operators_to(rkg, 2)), 2)
}

// The legacy full scan: the exact pre-index algorithm, kept here as the
// reference oracle the indexed lookup must match.
fn _scan_from(rkg, pid) {
    let atoms = kg_atoms(rkg)
    let out = list_new()
    let i = 0
    while i < len(atoms) {
        if is_operator(atoms[i]) == 1 {
            if rop_premise(atoms[i]) == pid { push(out, atoms[i]) }
        }
        i = i + 1
    }
    return out
}

// Property: the indexed lookup returns the same operators, in the same order,
// as a full scan -- for present and absent nodes alike.
fn test_index_matches_scan() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let n = 0
    while n < 6 { kg_add_atom(rkg, ATOM_FACT, "n" + int_to_str(n), 0) n = n + 1 }
    rop_new(rkg, ROP_CAUSAL, 0, 1, "0->1", 0)
    rop_new(rkg, ROP_IMPLY,  0, 2, "0=>2", 0)
    rop_new(rkg, ROP_CAUSAL, 0, 3, "0->3", 0)
    rop_new(rkg, ROP_CAUSAL, 2, 3, "2->3", 0)
    let p = 0
    while p < 6 {
        let idx = rk_operators_from(rkg, p)
        let scn = _scan_from(rkg, p)
        ce_eq("count matches scan for node " + int_to_str(p), len(idx), len(scn))
        let k = 0
        while k < len(scn) {
            ce_eq("same op id at pos " + int_to_str(k) + " node " + int_to_str(p),
                  atom_id(idx[k]), atom_id(scn[k]))
            k = k + 1
        }
        p = p + 1
    }
    // 0 has out-degree 3, the absent-edge node 5 has 0.
    ce_eq("node 0 out-degree", len(rk_operators_from(rkg, 0)), 3)
    ce_eq("node 5 out-degree", len(rk_operators_from(rkg, 5)), 0)
}

fn main() {
    test_operators()
    test_lookup()
    test_index_rebuild_equivalence()
    test_index_matches_scan()
    ce_summary("reasoning_atoms")
}

main()
