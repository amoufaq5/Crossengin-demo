// Unit tests for src/parts/reasoning/reasoning_atoms.nova
// Verifies operator-atom creation, accessors, confidence/observation, and
// from/to operator lookup. ADR-0031.

import "../ce_test.nova"
import "../../src/parts/reasoning/reasoning_atoms.nova"

fn test_operators() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    ce_str_eq("reasoning kg", kg_label(rkg), "reasoning")
    // Premise/conclusion fact atoms (ids 0,1,2).
    let a = kg_add_atom(rkg, ATOM_FACT, "rain", 0)
    let b = kg_add_atom(rkg, ATOM_FACT, "wet ground", 0)
    let c = kg_add_atom(rkg, ATOM_FACT, "slippery", 0)
    let op1 = rop_new(rkg, ROP_CAUSAL, atom_id(a), atom_id(b), "rain->wet", 0)
    rop_new(rkg, ROP_CAUSAL, atom_id(b), atom_id(c), "wet->slip", 0)
    ce_eq("is operator", is_operator(op1), 1)
    ce_eq("fact not operator", is_operator(a), 0)
    ce_eq("kind causal", rop_kind(op1), ROP_CAUSAL)
    ce_eq("premise", rop_premise(op1), atom_id(a))
    ce_eq("conclusion", rop_conclusion(op1), atom_id(b))
    ce_str_eq("kind name", rop_kind_name(ROP_IMPLY), "implicative")
    // Confidence and observation.
    ce_eq("uniform confidence", rop_confidence(op1), 500)
    rop_observe(op1, 1); rop_observe(op1, 1)
    ce_eq("strengthened", rop_confidence(op1), 750)
}

fn test_lookup() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let a = kg_add_atom(rkg, ATOM_FACT, "a", 0)   // id 0
    let b = kg_add_atom(rkg, ATOM_FACT, "b", 0)   // id 1
    let c = kg_add_atom(rkg, ATOM_FACT, "c", 0)   // id 2
    rop_new(rkg, ROP_CAUSAL, 0, 1, "a->b", 0)
    rop_new(rkg, ROP_IMPLY, 0, 2, "a=>c", 0)
    rop_new(rkg, ROP_CAUSAL, 1, 2, "b->c", 0)
    ce_eq("two operators from a", len(rk_operators_from(rkg, 0)), 2)
    ce_eq("one operator from b", len(rk_operators_from(rkg, 1)), 1)
    ce_eq("two operators to c", len(rk_operators_to(rkg, 2)), 2)
    ce_eq("none to a", len(rk_operators_to(rkg, 0)), 0)
}

fn main() {
    test_operators()
    test_lookup()
    ce_summary("reasoning_atoms")
}

main()
