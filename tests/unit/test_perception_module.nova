// Unit tests for src/parts/perception/perception_module.nova
//
// Verifies the perception orchestrator: text step produces a Percept whose
// category matches classify_input, ctx slots are populated byte-identically
// to the pre-Phase-N reader-only path, image + audio steps carry the
// identity label through, and multimodal composition correctly skips
// lipsync when frames/pcm are missing. ADR-0092 (Phase N R1).
//
// NOVA language quirk (Phase Q R2): `==` / `!=` on list values are
// NOT reference-identity AND NOT content-structural -- empirically both
// comparators treat any two list handles as EQUAL (verified by probe:
// two lists with completely different content still compare `==` true).
// Tests asserting "handle distinctness" (`s1 != pm`) therefore ALWAYS
// evaluate false. For singleton-vs-explicit distinctness, assert
// BEHAVIORAL side-effects via step_count / last_percept mutation; for
// singleton rebuild, use the explicit `_perception_module_singleton_reset()`
// test helper (the module's own `renv != renv2` rebuild guard cannot
// fire under NOVA's list equality). See ADR-0092 "NOVA language quirks".

import "../ce_test.nova"
import "../../src/parts/perception/perception_module.nova"
import "std/syscall"
import "std/string"
import "std/io"

// Small reader stack sufficient for the text-perception smoke:
// a language KG with one word ("fever") sensed to a "pyrexia" atom.
fn build_reader() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    word_add_sense(word_atom_new(lang, "fever", 0), c0, 900)
    return reader_new(reg, lang, 0)
}

// ---- text path: percept + ctx slots --------------------------------------
fn test_perception_step_text_basic() {
    let renv = build_reader()
    let pm = perception_module_new(renv)
    let ctx = ctx_new()
    ctx_set_input(ctx, "fever")
    ctx_set_tick(ctx, 42)
    let p = perception_step_text(pm, ctx, "fever", 42)
    ce_check("percept minted", pc_is_percept(p) == 1)
    ce_eq("modality is text", pc_modality(p), PC_MODALITY_TEXT)
    ce_eq("ts propagated", pc_timestamp_ns(p), 42)
    // ctx slots populated (percept/active are the reader's active list;
    // routes is the reader's routes; unknown is the reader's curiosity count).
    ce_check("ctx percept populated", len(ctx_percept(ctx)) >= 1)
    ce_check("ctx active populated", len(ctx_active(ctx)) >= 1)
    ce_eq("ctx no unknown", ctx_unknown(ctx), 0)
    // Reader matched cached on the pm.
    ce_check("pm last matched >= 1", pm_last_matched(pm) >= 1)
    // Percept cached.
    ce_check("pm last percept == p", pm_last_percept(pm) == p)
    ce_eq("pm step count", pm_step_count(pm), 1)
    // Category is a valid classifier enum value (0..CAT_COUNT).
    ce_check("category in range", pc_category(p) >= 0)
    ce_check("category < CAT_COUNT", pc_category(p) < CAT_COUNT)
}

// Unknown-token learning signal: reader curiosity count -> ctx_unknown.
fn test_perception_step_text_unknown() {
    let renv = build_reader()
    let pm = perception_module_new(renv)
    let ctx = ctx_new()
    ctx_set_input(ctx, "fever glorptide")
    let p = perception_step_text(pm, ctx, "fever glorptide", 1)
    ce_eq("ctx unknown = 1", ctx_unknown(ctx), 1)
    ce_eq("percept unknown = 1", pc_unknown(p), 1)
}

// ---- behavior preservation: ctx slots byte-identical to reader-only path
fn test_perception_step_text_byte_identity() {
    let renv = build_reader()
    let pm = perception_module_new(renv)
    let ctx_a = ctx_new()
    ctx_set_input(ctx_a, "fever")
    perception_step_text(pm, ctx_a, "fever", 0)
    // Reference: the pre-Phase-N inline reader-only path.
    let ctx_b = ctx_new()
    ctx_set_input(ctx_b, "fever")
    let c = reader_read(renv, "fever", list_new())
    ctx_set_percept(ctx_b, rctx_active(c))
    ctx_set_active(ctx_b, rctx_active(c))
    ctx_set_routes(ctx_b, rctx_routes(c))
    ctx_set_unknown(ctx_b, reader_unknown(c))
    // Byte identity: the four ctx slots must have the same shape + values.
    ce_eq("percept len parity", len(ctx_percept(ctx_a)), len(ctx_percept(ctx_b)))
    ce_eq("active len parity", len(ctx_active(ctx_a)), len(ctx_active(ctx_b)))
    ce_eq("routes len parity", len(ctx_routes(ctx_a)), len(ctx_routes(ctx_b)))
    ce_eq("unknown parity", ctx_unknown(ctx_a), ctx_unknown(ctx_b))
}

// ---- image path ----------------------------------------------------------
fn test_perception_step_image() {
    let pm = perception_module_new(0)
    let labels = list_new()
    push(labels, "face")
    push(labels, "edge")
    let p = perception_step_image(pm, 0, labels, "alice", 11, 800, 100)
    ce_check("image percept", pc_is_percept(p) == 1)
    ce_eq("image modality", pc_modality(p), PC_MODALITY_IMAGE)
    ce_str_eq("image identity", pc_identity_label(p), "alice")
    ce_eq("image labels len", len(pc_labels(p)), 2)
    ce_check("image cached", pm_last_percept(pm) == p)
    ce_eq("image step count", pm_step_count(pm), 1)
}

// ---- audio path ----------------------------------------------------------
fn test_perception_step_audio() {
    let pm = perception_module_new(0)
    let labels = list_new()
    push(labels, "hello")
    let p = perception_step_audio(pm, 0, labels, "bob", 22, 750, 200)
    ce_check("audio percept", pc_is_percept(p) == 1)
    ce_eq("audio modality", pc_modality(p), PC_MODALITY_AUDIO)
    ce_str_eq("audio identity", pc_identity_label(p), "bob")
    ce_eq("audio labels len", len(pc_labels(p)), 1)
    ce_check("audio cached", pm_last_percept(pm) == p)
}

// ---- multimodal path -----------------------------------------------------
// Both halves present, but neither frames nor pcm shipped: lipsync skipped,
// corr stays 0 (fuse_observation still runs for the identity binding).
fn test_perception_step_multimodal_no_lipsync() {
    let pm = perception_module_new(0)
    let il = list_new()
    push(il, "face")
    let al = list_new()
    push(al, "voice")
    let img = perception_step_image(pm, 0, il, "carol", 1, 900, 500)
    let aud = perception_step_audio(pm, 0, al, "carol", 2, 850, 510)
    let mm = perception_step_multimodal(pm, 0, img, aud, 0, 0, 0, 500)
    ce_check("mm minted", pc_is_percept(mm) == 1)
    ce_check("mm is multimodal", pc_is_multimodal(mm) == 1)
    // Identity propagated from fused atom (STRONG binding on agreement).
    ce_str_eq("mm identity", pc_identity_label(mm), "carol")
    // No lipsync ran -> corr stays 0.
    ce_eq("mm corr zero", pc_corr_milli(mm), 0)
    ce_check("mm cached", pm_last_percept(pm) == mm)
    // Step count = 1 image + 1 audio + 1 mm = 3.
    ce_eq("mm step count", pm_step_count(pm), 3)
}

// One-side-only multimodal: audio absent -> mm still constructs.
fn test_perception_step_multimodal_image_only() {
    let pm = perception_module_new(0)
    let il = list_new()
    push(il, "face")
    let img = perception_step_image(pm, 0, il, "dave", 3, 500, 100)
    let mm = perception_step_multimodal(pm, 0, img, 0, 0, 0, 0, 100)
    ce_check("mm one-side minted", pc_is_percept(mm) == 1)
    ce_eq("mm one-side ts from image", pc_timestamp_ns(mm), 100)
    ce_str_eq("mm one-side identity", pc_identity_label(mm), "dave")
}

// ---- module init + singleton ---------------------------------------------
// Singleton semantics are asserted BEHAVIORALLY (via step_count mutation
// side-effects) rather than by handle distinctness: NOVA's `!=` on lists is
// structural equality, not reference-identity, so `s1 != pm` on two
// structurally-identical PM handles always evaluates false. See the top-of-
// file quirk note and ADR-0092 "NOVA language quirks".
fn test_module_init_and_singleton() {
    let renv = build_reader()
    // Explicit init.
    let pm = perception_module_init(renv, 0)
    ce_check("pm is module", pm_is_module(pm) == 1)
    ce_eq("pm initial step count", pm_step_count(pm), 0)
    ce_eq("pm initial last percept", pm_last_percept(pm), 0)
    // Singleton is lazy + stable per renv.
    _perception_module_singleton_reset()
    let s1 = perception_module_singleton_for(renv)
    let s2 = perception_module_singleton_for(renv)
    ce_check("singleton stable per renv", s1 == s2)
    // Singleton-vs-explicit: step the singleton, confirm the explicit pm's
    // state did NOT advance. Proves the two handles own separate state.
    let ctx1 = ctx_new()
    ctx_set_input(ctx1, "fever")
    perception_step_text(s1, ctx1, "fever", 0)
    ce_eq("singleton step_count after step", pm_step_count(s1), 1)
    ce_eq("explicit pm untouched by singleton step", pm_step_count(pm), 0)
    // Reset forces a fresh singleton: the module's own `renv != renv2`
    // rebuild guard cannot fire under NOVA's list-equality (`!=` on
    // lists is always false), so the only portable way to force a
    // rebuild is the explicit `_perception_module_singleton_reset()`
    // helper. A post-reset singleton_for() call must yield a module
    // with fresh step_count=0, not s1's post-step state (1).
    _perception_module_singleton_reset()
    let s3 = perception_module_singleton_for(renv)
    ce_eq("singleton rebuilt after reset (fresh step_count)", pm_step_count(s3), 0)
}

// ---- last-matched cache round-trip ---------------------------------------
fn test_last_matched_cache() {
    let renv = build_reader()
    _perception_module_singleton_reset()
    let pm = perception_module_singleton_for(renv)
    let ctx = ctx_new()
    ctx_set_input(ctx, "fever")
    perception_step_text(pm, ctx, "fever", 0)
    let cached = pm_last_matched(pm)
    // Compare against a fresh reader_read matched over the same text.
    let c = reader_read(renv, "fever", list_new())
    ce_eq("cached matched parity", cached, reader_matched(c))
}

fn main() {
    test_perception_step_text_basic()
    test_perception_step_text_unknown()
    test_perception_step_text_byte_identity()
    test_perception_step_image()
    test_perception_step_audio()
    test_perception_step_multimodal_no_lipsync()
    test_perception_step_multimodal_image_only()
    test_module_init_and_singleton()
    test_last_matched_cache()
    ce_summary("perception_module")
}
main()
