// Unit tests for src/capsules/capsule_registry.nova.

import "../ce_test.nova"
import "../../src/capsules/capsule_registry.nova"

fn test_new_empty() {
    let r = capreg_new()
    ce_eq("count 0", capreg_count(r), 0)
    ce_check("lookup missing = 0", capreg_lookup(r, "medicine") == 0)
    ce_eq("installed missing = 0", capreg_is_installed(r, "medicine"), 0)
}

fn test_register_and_lookup() {
    let r = capreg_new()
    let c = capsule_new("medicine", "1.0.0", "d", "l")
    ce_eq("first register", capreg_register(r, c), 1)
    ce_eq("count 1", capreg_count(r), 1)
    let found = capreg_lookup(r, "medicine")
    ce_check("found is c", found == c)
    let c2 = capsule_new("medicine", "2.0.0", "d", "l")
    ce_eq("dup register rejected", capreg_register(r, c2), 0)
    ce_eq("count still 1", capreg_count(r), 1)
}

fn test_install_no_deps() {
    let r = capreg_new()
    let c = capsule_new("medicine", "1.0.0", "d", "l")
    capreg_register(r, c)
    let s = capreg_install(r, "medicine", 100)
    ce_eq("ok", s[0], 1)
    ce_eq("installed count 1", s[1], 1)
    ce_eq("cycle empty", s[2], "")
    ce_eq("missing empty", s[3], "")
    ce_eq("capsule now installed", capreg_is_installed(r, "medicine"), 1)
}

fn test_install_missing_capsule() {
    let r = capreg_new()
    let s = capreg_install(r, "medicine", 100)
    ce_eq("ok=0 for missing", s[0], 0)
    ce_eq("missing names it", s[3], "medicine")
}

fn test_install_with_deps_ordered() {
    let r = capreg_new()
    let bio = capsule_new("biology", "1.0.0", "d", "l")
    let med = capsule_new("medicine", "1.0.0", "d", "l")
    capsule_add_dep(med, "biology", "1.0.0")
    capreg_register(r, bio)
    capreg_register(r, med)
    let s = capreg_install(r, "medicine", 100)
    ce_eq("ok", s[0], 1)
    ce_eq("both installed", s[1], 2)
    ce_eq("bio installed", capreg_is_installed(r, "biology"), 1)
    ce_eq("med installed", capreg_is_installed(r, "medicine"), 1)
    // Second install run should not re-install.
    let s2 = capreg_install(r, "medicine", 200)
    ce_eq("2nd install: nothing new", s2[1], 0)
}

fn test_install_missing_dep() {
    let r = capreg_new()
    let med = capsule_new("medicine", "1.0.0", "d", "l")
    capsule_add_dep(med, "biology", "1.0.0")
    capreg_register(r, med)   // biology intentionally missing
    let s = capreg_install(r, "medicine", 100)
    ce_eq("ok=0 for missing dep", s[0], 0)
    ce_eq("missing names biology", s[3], "biology")
    ce_eq("med not installed", capreg_is_installed(r, "medicine"), 0)
}

fn test_install_cycle_rejected() {
    let r = capreg_new()
    let a = capsule_new("a", "1.0.0", "d", "l")
    let b = capsule_new("b", "1.0.0", "d", "l")
    capsule_add_dep(a, "b", "1.0.0")
    capsule_add_dep(b, "a", "1.0.0")
    capreg_register(r, a)
    capreg_register(r, b)
    let s = capreg_install(r, "a", 100)
    ce_eq("ok=0 on cycle", s[0], 0)
    ce_check("cycle non-empty", len(s[2]) > 0)
    ce_eq("a not installed", capreg_is_installed(r, "a"), 0)
}

fn test_uninstall() {
    let r = capreg_new()
    let c = capsule_new("k", "1.0.0", "d", "l")
    capreg_register(r, c)
    capreg_install(r, "k", 100)
    ce_eq("installed before", capreg_is_installed(r, "k"), 1)
    ce_eq("uninstall applied", capreg_uninstall(r, "k"), 1)
    ce_eq("not installed after", capreg_is_installed(r, "k"), 0)
    // Atoms/imps stay on the capsule -- only the install flag flipped.
    ce_eq("uninstall missing = 0", capreg_uninstall(r, "nope"), 0)
}

fn test_remove() {
    let r = capreg_new()
    let c = capsule_new("k", "1.0.0", "d", "l")
    capreg_register(r, c)
    ce_eq("remove applied", capreg_remove(r, "k"), 1)
    ce_eq("count 0", capreg_count(r), 0)
    ce_eq("remove missing = 0", capreg_remove(r, "k"), 0)
}

fn test_installed_capsules_filter() {
    let r = capreg_new()
    let a = capsule_new("a", "1.0.0", "d", "l")
    let b = capsule_new("b", "1.0.0", "d", "l")
    let c = capsule_new("c", "1.0.0", "d", "l")
    capreg_register(r, a) capreg_register(r, b) capreg_register(r, c)
    capreg_install(r, "a", 1)
    capreg_install(r, "c", 2)
    let installed = capreg_installed_capsules(r)
    ce_eq("2 installed", len(installed), 2)
}

fn test_capsules_owning_atom() {
    let r = capreg_new()
    let bio = capsule_new("biology", "1.0.0", "d", "l")
    let med = capsule_new("medicine", "1.0.0", "d", "l")
    capsule_claim_atom(bio, 42)
    capsule_claim_atom(med, 42)
    capreg_register(r, bio)
    capreg_register(r, med)
    let owners = capreg_capsules_owning_atom(r, 42)
    ce_eq("both claim atom 42", len(owners), 2)
    let no_owners = capreg_capsules_owning_atom(r, 99)
    ce_eq("nobody claims 99", len(no_owners), 0)
}

fn main() {
    test_new_empty()
    test_register_and_lookup()
    test_install_no_deps()
    test_install_missing_capsule()
    test_install_with_deps_ordered()
    test_install_missing_dep()
    test_install_cycle_rejected()
    test_uninstall()
    test_remove()
    test_installed_capsules_filter()
    test_capsules_owning_atom()
    ce_summary("capsule_registry")
}

main()
