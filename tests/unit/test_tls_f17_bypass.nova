// Audit F-17 repro: the TLS verifier accepted forged RSA-4096 chains.
//
// bn2048_from_hex returns 0 for a modulus wider than 2048 bits, cert_parse
// did not check, so every RSA-4096 cert (60 roots in the system bundle, and
// any attacker leaf) parsed with N = 0. cert_anchor_match then matched an
// attacker's RSA-4096 leaf to any RSA-4096 anchor (0 == 0), and
// bn2048_modpow_ct(s, e, 0) returns s, so a hand-built PSS encoding passed
// rsa_pss_sha256_verify with no private key. Also: an oversized ECDSA r/s
// overflowed _x509v_int_to_32's buffer, and the server Finished was never
// compared.
//
// Fixtures: openssl-generated RSA-4096 root, an unrelated RSA-4096 "attacker"
// leaf (SAN victim.example), a P-384 root; a PSS EM for SHA-256("forged")
// built in Python (emBits 2047, salt 00..1f).

import "../ce_test.nova"
import "../../src/safety/x509_verify.nova"
import "../../src/safety/pem_truststore.nova"
import "../../src/io/transducers/tls13_client.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _hxv(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0
}
fn hexbuf(s) {
    let n = len(s) / 2
    let b = alloc(n + 1)
    let k = 0
    while k < n { store8(b + k, _hxv(char_at(s, k*2)) * 16 + _hxv(char_at(s, k*2+1))) k = k + 1 }
    let r = list_new() push(r, b) push(r, n) return r
}

let R4K_ROOT = ""
let ATK_LEAF = ""
let P384_ROOT = ""
let R4K_B64 = ""
let P384_B64 = ""
let FORGED_EM = ""
let FORGED_MH = "ccdd35168ab474fa5764a526cfb83621351e23682c5075b2e18d56bddf96aa30"

fn test_rsa4096_certs_rejected() {
    let r = hexbuf(R4K_ROOT)
    ce_eq("RSA-4096 root no longer parses (unsupported, not N=0)", cert_ok(cert_parse(r[0], r[1])), 0)
    let a = hexbuf(ATK_LEAF)
    ce_eq("RSA-4096 attacker leaf rejected", cert_ok(cert_parse(a[0], a[1])), 0)
}

fn test_bundle_skips_unsupported_roots() {
    let pem = "-----BEGIN CERTIFICATE-----\n" + R4K_B64 + "\n-----END CERTIFICATE-----\n"
            + "-----BEGIN CERTIFICATE-----\n" + P384_B64 + "\n-----END CERTIFICATE-----\n"
    ce_eq("RSA-4096 + P-384 roots load as 0 anchors", len(truststore_load(pem)), 0)
}

fn test_p384_rejected() {
    let p = hexbuf(P384_ROOT)
    ce_eq("P-384 cert rejected (curve not implemented)", cert_ok(cert_parse(p[0], p[1])), 0)
}

fn test_zero_modulus_forgery_refused() {
    // Before: N = 0 -> modpow returns s -> a hand-built EM verified.
    let em = hexbuf(FORGED_EM)
    let mh = hexbuf(FORGED_MH)
    let zero = bn2048_new()
    ce_eq("PSS verify under N=0 refused", rsa_pss_sha256_verify(zero, 65537, mh[0], em[0], em[1]), 0)
    ce_eq("PKCS1 verify under N=0 refused", rsa_pkcs1_sha256_verify(zero, 65537, mh[0], em[0], em[1]), 0)
    ce_eq("short signature refused", rsa_pss_sha256_verify(zero, 65537, mh[0], em[0], 100), 0)
}

fn test_oversized_ecdsa_sig_rejected() {
    // SEQUENCE { INTEGER (40 bytes), INTEGER (1 byte) }
    let s = "302d0228" + "11111111111111111111111111111111111111111111111111111111111111111111111111111111" + "020101"
    let b = hexbuf(s)
    ce_check("40-byte r rejected (no overflow)", _x509v_parse_ecdsa_sig(b[0], b[1]) == 0)
    let t = hexbuf("3006020101040101")
    ce_check("non-INTEGER s rejected", _x509v_parse_ecdsa_sig(t[0], t[1]) == 0)
}

fn test_finished_compare() {
    let a = alloc(33)
    let b = alloc(33)
    let i = 0
    while i < 32 { store8(a + i, i) store8(b + i, i) i = i + 1 }
    ce_eq("matching verify_data accepted", _tls_finished_ok(a, b, 32), 1)
    store8(b + 31, 99)
    ce_eq("one-byte mismatch rejected", _tls_finished_ok(a, b, 32), 0)
    ce_eq("wrong length rejected", _tls_finished_ok(a, a, 31), 0)
}

fn main() {
    test_rsa4096_certs_rejected()
    test_bundle_skips_unsupported_roots()
    test_p384_rejected()
    test_zero_modulus_forgery_refused()
    test_oversized_ecdsa_sig_rejected()
    test_finished_compare()
    ce_summary("tls_f17_bypass")
}

main()
