// Unit tests for src/substrate/synapse_graph.nova
// Verifies parallel-array storage and accessors, weight clamping, type masks,
// source adjacency / find / growth, signed transmission, the fused
// Hebbian+error plasticity rule (with exact arithmetic), eligibility decay, and
// idle pruning with slot reclaim. ADR-0007, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/synapse_graph.nova"
import "../../src/substrate/signal_dispatch.nova"

fn test_create_and_clamp() {
    let g = syn_graph_new()
    let idx = syn_new(g, 0, 1, 500, 0)
    ce_eq("first index 0", idx, 0)
    ce_eq("pre", syn_pre(g, idx), 0)
    ce_eq("post", syn_post(g, idx), 1)
    ce_eq("weight", syn_weight(g, idx), 500)
    ce_eq("alive", syn_alive(g, idx), 1)
    ce_eq("live count", syn_live(g), 1)
    ce_eq("total", syn_total(g), 1)
    // Weight clamping to [W_MIN, W_MAX].
    let hi = syn_new(g, 2, 3, 5000, 0)
    ce_eq("clamp high", syn_weight(g, hi), W_MAX)
    let lo = syn_new(g, 4, 5, -5000, 0)
    ce_eq("clamp low", syn_weight(g, lo), W_MIN)
    ce_eq("set_weight clamps", syn_set_weight(g, idx, 9999), 1)
    ce_eq("weight clamped after set", syn_weight(g, idx), W_MAX)
}

fn test_masks() {
    let m = syn_mask_add(syn_mask_add(0, XSIG_SENSORY), XSIG_EXCITE)
    ce_check("mask has SENSORY", syn_mask_has(m, XSIG_SENSORY) == 1)
    ce_check("mask has EXCITE", syn_mask_has(m, XSIG_EXCITE) == 1)
    ce_check("mask lacks INHIBIT", syn_mask_has(m, XSIG_INHIBIT) == 0)
    let g = syn_graph_new()
    let idx = syn_new(g, 0, 1, 400, m)
    ce_check("carries SENSORY", syn_carries(g, idx, XSIG_SENSORY) == 1)
    ce_check("not carries GOAL", syn_carries(g, idx, XSIG_GOAL) == 0)
}

fn test_adjacency_find_growth() {
    let g = syn_graph_new()
    syn_new(g, 0, 1, 300, 0)
    syn_new(g, 0, 2, 300, 0)
    syn_new(g, 5, 6, 300, 0)
    let outs0 = syn_out(g, 0)
    ce_eq("node 0 has 2 outgoing", len(outs0), 2)
    ce_eq("node 5 has 1 outgoing", len(syn_out(g, 5)), 1)
    ce_eq("node 9 has 0 outgoing", len(syn_out(g, 9)), 0)
    ce_check("find 0->2 exists", syn_find(g, 0, 2) >= 0)
    ce_eq("find 0->7 absent", syn_find(g, 0, 7), -1)
    // Growth is idempotent: returns existing index, does not duplicate.
    let before = syn_live(g)
    let same = syn_grow_if_absent(g, 0, 2, 800, 0)
    ce_eq("grow existing returns it", same, syn_find(g, 0, 2))
    ce_eq("no new synapse", syn_live(g), before)
    let grown = syn_grow_if_absent(g, 0, 7, 800, 0)
    ce_check("grow new", grown >= 0)
    ce_eq("live grew by one", syn_live(g), before + 1)
}

fn test_transmit_sign() {
    let g = syn_graph_new()
    let exc = syn_new(g, 0, 1, 800, 0)
    ce_eq("excitatory transmit", syn_transmit(g, exc, 1000, 5), 800)
    ce_eq("records last active", syn_last(g, exc), 5)
    let inh = syn_new(g, 2, 3, -600, 0)
    ce_eq("inhibitory transmit negative", syn_transmit(g, inh, 1000, 6), -600)
}

fn test_plasticity_rule() {
    // Hebbian only (error 0, neutral modulator): dw = 0.02 * pre * post.
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 100, 0)
    syn_learn_one(g, s, 1000, 1000, 0, 1000)
    ce_eq("hebbian +20", syn_weight(g, s), 120)
    ce_eq("eligibility set", syn_elig(g, s), 1000)

    // Error-driven only (post 0): dw = 0.03 * pre * error.
    let g2 = syn_graph_new()
    let s2 = syn_new(g2, 0, 1, 100, 0)
    syn_learn_one(g2, s2, 1000, 0, 500, 1000)
    ce_eq("error +15", syn_weight(g2, s2), 115)
    ce_eq("no co-activation eligibility", syn_elig(g2, s2), 0)

    // Modulator scales the update (0.5x).
    let g3 = syn_graph_new()
    let s3 = syn_new(g3, 0, 1, 100, 0)
    syn_learn_one(g3, s3, 1000, 1000, 0, 500)
    ce_eq("modulated +10", syn_weight(g3, s3), 110)

    // Repeated potentiation clamps at W_MAX.
    let g4 = syn_graph_new()
    let s4 = syn_new(g4, 0, 1, 980, 0)
    let i = 0
    while i < 10 { syn_learn_one(g4, s4, 1000, 1000, 0, 1000); i = i + 1 }
    ce_eq("clamps at W_MAX", syn_weight(g4, s4), W_MAX)
}

fn test_eligibility_decay() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 100, 0)
    syn_learn_one(g, s, 1000, 1000, 0, 1000)
    ce_eq("elig 1000", syn_elig(g, s), 1000)
    syn_decay_eligibility(g)
    ce_eq("elig decays 0.9", syn_elig(g, s), 900)
}

fn test_plasticity_step_snapshot() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 100, 0)
    let snapshot = list_new()
    push(snapshot, 1000)   // node 0
    push(snapshot, 1000)   // node 1
    let updated = syn_plasticity_step(g, snapshot, 0, 1000, 9)
    ce_eq("one synapse updated", updated, 1)
    ce_eq("weight learned", syn_weight(g, s), 120)
    ce_eq("last active tick", syn_last(g, s), 9)
    // learn set elig 1000, then the step's decay pass brings it to 900.
    ce_eq("elig set then decayed", syn_elig(g, s), 900)
}

fn test_prune_and_reclaim() {
    let g = syn_graph_new()
    let weak = syn_new(g, 0, 1, 5, 0)      // |5| < death threshold, elig 0
    let strong = syn_new(g, 2, 3, 800, 0)  // survives
    ce_eq("two live", syn_live(g), 2)
    let pruned = syn_prune(g)
    ce_eq("one pruned", pruned, 1)
    ce_eq("one live remains", syn_live(g), 1)
    ce_eq("weak is dead", syn_alive(g, weak), 0)
    ce_eq("strong survives", syn_alive(g, strong), 1)
    ce_eq("weak removed from adjacency", len(syn_out(g, 0)), 0)
    // The reclaimed slot is reused by the next creation.
    let reused = syn_new(g, 7, 8, 700, 0)
    ce_eq("slot reclaimed", reused, weak)
    ce_eq("total unchanged (no append)", syn_total(g), 2)
    ce_eq("live back to two", syn_live(g), 2)
}

fn test_bad_input_graceful() {
    let g = syn_graph_new()
    syn_new(g, 0, 1, 500, 0)
    ce_eq("weight of bad idx", syn_weight(g, 999), 0)
    ce_eq("pre of bad idx", syn_pre(g, -1), -1)
    ce_eq("set_weight bad idx", syn_set_weight(g, 999, 100), 0)
    ce_eq("transmit bad idx", syn_transmit(g, 999, 1000, 1), 0)
    ce_eq("learn bad idx", syn_learn_one(g, 999, 1000, 1000, 0, 1000), 0)
    ce_eq("alive of bad idx", syn_alive(g, 999), 0)
}

fn main() {
    test_create_and_clamp()
    test_masks()
    test_adjacency_find_growth()
    test_transmit_sign()
    test_plasticity_rule()
    test_eligibility_decay()
    test_plasticity_step_snapshot()
    test_prune_and_reclaim()
    test_bad_input_graceful()
    ce_summary("synapse_graph")
}

main()
