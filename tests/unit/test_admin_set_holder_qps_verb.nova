// R113 (Phase K part 4) unit tests for admin.set_holder_qps.
//
// Covers:
//   * verb registered in rpc_verb_names()
//   * verb-cap map declares CAP_ADMIN_SANDBOX
//   * happy path: set an explicit cap, response echoes previous_qps
//   * missing/empty arg refusals
//   * negative qps refused
//   * non-numeric qps refused (str_to_int -> 0 must NOT silently unlimit)
//   * "0" is intentional "unlimited" and accepted
//   * no holder-rate registry in context refuses cleanly
//   * anonymous holder ("") is a legitimate target (aggregate bucket)

import "../ce_test.nova"
import "../../src/sandbox/capability.nova"
import "../../src/sandbox/holder_rate.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    return rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
}

fn _mk_args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

fn _mk_arg1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

// ---- verb registration + cap gate ---------------------------------

fn test_verb_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.set_holder_qps") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.set_holder_qps in verb list", saw, 1)
}

fn test_verb_cap_is_admin_sandbox() {
    ce_str_eq("cap is admin:sandbox",
              capability_verb_required("admin.set_holder_qps"),
              CAP_ADMIN_SANDBOX)
}

// ---- refusals -----------------------------------------------------

fn test_no_registry_in_context_refuses() {
    let ctx = _mk_ctx()
    // No holder_rate_reg wired.
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "alice", "qps", "5"), ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("names no-registry",
             _has(out, "no holder-rate registry in context"))
}

fn test_missing_holder_refused() {
    let ctx = _mk_ctx()
    rpc_ctx_set_holder_rate_reg(ctx, holder_rate_registry_new(10))
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_arg1("qps", "5"), ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("names missing holder", _has(out, "missing arg: holder"))
}

fn test_missing_qps_refused() {
    let ctx = _mk_ctx()
    rpc_ctx_set_holder_rate_reg(ctx, holder_rate_registry_new(10))
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_arg1("holder", "alice"), ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("names missing qps", _has(out, "missing arg: qps"))
}

fn test_negative_qps_refused() {
    let ctx = _mk_ctx()
    rpc_ctx_set_holder_rate_reg(ctx, holder_rate_registry_new(10))
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "alice", "qps", "-1"), ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("names >= 0", _has(out, "qps must be >= 0"))
}

fn test_non_numeric_qps_refused() {
    // Guards against the NOVA quirk where str_to_int("foo") returns 0
    // -- a silent unlimit is worse than a loud refusal.
    let ctx = _mk_ctx()
    rpc_ctx_set_holder_rate_reg(ctx, holder_rate_registry_new(10))
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "alice", "qps", "banana"), ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("names non-negative int",
             _has(out, "qps must be a non-negative integer"))
}

// ---- happy path ---------------------------------------------------

fn test_happy_path_sets_explicit_cap() {
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "alice", "qps", "42"), ctx)
    ce_check("ok:true",         _has(out, "\"ok\":true"))
    ce_check("has holder",      _has(out, "\"holder\":\"alice\""))
    ce_check("has qps 42",      _has(out, "\"qps\":42"))
    // previous_qps = default (10) since no prior explicit setting.
    ce_check("previous_qps 10", _has(out, "\"previous_qps\":10"))
    // Registry now reflects the explicit cap.
    ce_eq("stored qps for alice", holder_rate_get(reg, "alice"), 42)
}

fn test_response_previous_qps_when_updating() {
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    holder_rate_set(reg, "alice", 7)
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "alice", "qps", "9"), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("previous_qps 7", _has(out, "\"previous_qps\":7"))
    ce_check("qps 9", _has(out, "\"qps\":9"))
}

fn test_qps_zero_accepted_as_unlimited() {
    // "0" MUST be accepted (intentional unlimited). str_to_int("0")
    // returns 0 but the verb also verifies the string was literally
    // "0" so we accept this path.
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "svc", "qps", "0"), ctx)
    ce_check("ok:true", _has(out, "\"ok\":true"))
    ce_check("qps 0",   _has(out, "\"qps\":0"))
    ce_eq("stored svc as unlimited", holder_rate_get(reg, "svc"), 0)
}

fn test_anon_holder_is_valid_target() {
    // Empty-string holder ("") is legitimate (aggregate anonymous bucket).
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    let out = rpc_dispatch("admin.set_holder_qps",
        _mk_args2("holder", "", "qps", "3"), ctx)
    ce_check("ok:true (empty holder allowed)", _has(out, "\"ok\":true"))
    ce_check("holder empty string", _has(out, "\"holder\":\"\""))
    ce_eq("stored anon cap", holder_rate_get(reg, ""), 3)
}

// ---- main --------------------------------------------------------

fn main() {
    test_verb_registered()
    test_verb_cap_is_admin_sandbox()
    test_no_registry_in_context_refuses()
    test_missing_holder_refused()
    test_missing_qps_refused()
    test_negative_qps_refused()
    test_non_numeric_qps_refused()
    test_happy_path_sets_explicit_cap()
    test_response_previous_qps_when_updating()
    test_qps_zero_accepted_as_unlimited()
    test_anon_holder_is_valid_target()
    ce_summary("admin_set_holder_qps_verb")
    return 0
}

main()
