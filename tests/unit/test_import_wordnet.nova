// Unit tests for src/data/import_wordnet.nova (NL_AND_COVERAGE C1).
//
// Verifies the WordNet importer over a small normalized feed:
//   * synsets -> CONCEPT atoms keyed "wn:<id>" (dedup-safe);
//   * synonymy: distinct words on one synset point to the same concept;
//   * polysemy: one word across two synsets carries two senses;
//   * hypernymy: H record -> ROP_IMPLY operator (hyponym -> hypernym);
//   * antonymy: A record -> ROP_OPPOSITE operator;
//   * provenance: imported atoms tagged kb / wordnet;
//   * idempotency: re-import refreshes belief, adds no new concepts/edges.
//
// NOVA dependencies: ce_test harness, import_wordnet.nova (+ its imports).

import "../ce_test.nova"
import "../../src/data/import_wordnet.nova"

// A small WordNet feed (LF-joined so we do not rely on "\n" escapes).
fn _feed() {
    let nl = chr(10)
    let f = "S|1|car|a road vehicle"
    f = f + nl + "W|1|automobile"
    f = f + nl + "W|1|auto"
    f = f + nl + "S|2|bank|financial institution"
    f = f + nl + "S|3|bank|sloping land beside water"
    f = f + nl + "S|4|vehicle|a means of transport"
    f = f + nl + "H|1|4"
    f = f + nl + "S|5|hot|high temperature"
    f = f + nl + "S|6|cold|low temperature"
    f = f + nl + "A|5|6"
    return f
}

fn _setup() {
    let reg = kg_registry_new()
    let env = list_new()
    push(env, kg_spawn(reg, "wn"))        // [0] concept KG
    push(env, lang_kg_init(reg))          // [1] language KG
    push(env, reasoning_kg_init(reg))     // [2] reasoning KG
    return env
}

// Find an operator in `rkg` from premise_id to conclusion_id of a given kind.
fn _find_op(rkg, premise_id, conclusion_id, kind) {
    let ops = rk_operators_from(rkg, premise_id)
    let i = 0
    while i < len(ops) {
        if rop_conclusion(ops[i]) == conclusion_id {
            if rop_kind(ops[i]) == kind { return ops[i] }
        }
        i = i + 1
    }
    return 0
}

fn test_concepts_created() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    let stats = wn_import(kg, lang, rkg, _feed(), 0)
    ce_eq("6 concepts added", kbi_stat_concepts_added(stats), 6)
    ce_check("wn:1 exists", kg_find_atom(kg, "wn:1") != 0)
    ce_check("wn:6 exists", kg_find_atom(kg, "wn:6") != 0)
}

fn test_synonymy() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    wn_import(kg, lang, rkg, _feed(), 0)
    let c1 = kg_find_atom(kg, "wn:1")
    let wcar  = word_find(lang, "car")
    let wauto = word_find(lang, "automobile")
    ce_check("car interned", wcar != 0)
    ce_check("automobile interned", wauto != 0)
    ce_eq("car -> wn:1", handle_atom(word_dominant_sense(wcar)), atom_id(c1))
    ce_eq("automobile -> wn:1", handle_atom(word_dominant_sense(wauto)), atom_id(c1))
}

fn test_polysemy() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    wn_import(kg, lang, rkg, _feed(), 0)
    let wbank = word_find(lang, "bank")
    ce_check("bank interned", wbank != 0)
    ce_eq("bank has 2 senses", word_sense_count(wbank), 2)
}

fn test_hypernym_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    wn_import(kg, lang, rkg, _feed(), 0)
    let car = kg_find_atom(kg, "wn:1")
    let veh = kg_find_atom(kg, "wn:4")
    ce_check("car IS-A vehicle (IMPLY)", _find_op(rkg, atom_id(car), atom_id(veh), ROP_IMPLY) != 0)
}

fn test_antonym_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    wn_import(kg, lang, rkg, _feed(), 0)
    let hot  = kg_find_atom(kg, "wn:5")
    let cold = kg_find_atom(kg, "wn:6")
    ce_check("hot OPPOSITE cold", _find_op(rkg, atom_id(hot), atom_id(cold), ROP_OPPOSITE) != 0)
}

fn test_provenance_tagged() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    wn_import(kg, lang, rkg, _feed(), 0)
    let c1 = kg_find_atom(kg, "wn:1")
    ce_str_eq("provenance kb", atom_payload_get(c1, "provenance"), "kb")
    ce_str_eq("kb_source wordnet", atom_payload_get(c1, "kb_source"), "wordnet")
}

fn test_edge_count() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    let stats = wn_import(kg, lang, rkg, _feed(), 0)
    ce_eq("2 edges added (1 H + 1 A)", kbi_stat_edges(stats), 2)
}

fn test_idempotent_reimport() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let rkg = env[2]
    wn_import(kg, lang, rkg, _feed(), 0)
    let stats2 = wn_import(kg, lang, rkg, _feed(), 1)
    ce_eq("reimport adds 0 concepts", kbi_stat_concepts_added(stats2), 0)
    ce_eq("reimport refreshes 6", kbi_stat_concepts_refreshed(stats2), 6)
    ce_eq("reimport adds 0 edges", kbi_stat_edges(stats2), 0)
}

fn main() {
    test_concepts_created()
    test_synonymy()
    test_polysemy()
    test_hypernym_operator()
    test_antonym_operator()
    test_provenance_tagged()
    test_edge_count()
    test_idempotent_reimport()
    ce_summary("import_wordnet")
}
main()
