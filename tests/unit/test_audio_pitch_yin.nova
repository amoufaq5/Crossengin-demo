// Unit tests for the YIN extension of src/io/transducers/audio_pitch.nova
// (R11B).
//
// YIN (de Cheveigne & Kawahara 2002) is the textbook cure for the
// formant-snap that the R10F autocorrelation pitch estimator suffers on
// harmonic-rich signals. This file exercises the new YIN-class entry
// points (pitch_estimate_frame_yin / pitch_track_yin /
// pitch_run_yin_command) against:
//
//   * Constants + accessors (~3 checks)
//   * Difference-function primitive d(tau): zero at the true period,
//     positive elsewhere (~3 checks)
//   * Per-frame YIN on pure sines at 100, 200, 400 Hz @ 16 kHz: F0
//     centi-Hz exact within +/- 50, voicing maximal (~6 checks)
//   * Harmonic-rich synthesized signal (sum of fundamental + 2nd + 3rd
//     harmonics at 120 Hz): YIN F0 ~= 12000 centi-Hz, NOT 24000 or 36000
//     (the harmonic snap). Compared head-to-head with R10F autocorrelation
//     to document the difference. (~3 checks)
//   * Per-frame YIN on white-noise / silence: unvoiced (~3 checks)
//   * Klatt /uw/ vowel at 8 kHz: YIN F0 in plausible voice band, voicing
//     above threshold (~2 checks)
//   * pitch_track_yin on rising-pitch buffer (100..190 Hz): contour
//     reflects the rise (~3 checks)
//   * Sub-sample parabolic interpolation: shifted-period test (~2 checks)
//   * Backward compatibility: R10F pitch_estimate_frame still works
//     (~2 checks)
//   * Edge cases: short buffer, zero-bound defaults (~3 checks)
//
// Total: ~30 assertions.

import "../ce_test.nova"
import "../../src/io/transducers/audio_pitch.nova"
import "../../src/io/effectors/audio_synth.nova"

// ---- fixture builders ---------------------------------------------------

fn _zero_buf(n) {
    let b = list_new()
    let i = 0
    while i < n {
        push(b, 0)
        i = i + 1
    }
    return b
}

fn _noise_buf(n, amp) {
    let b = list_new()
    let i = 0
    let seed = 12345
    while i < n {
        seed = (seed * 1103515245 + 12345) & 1048575
        let v = seed - (seed / (2 * amp + 1)) * (2 * amp + 1) - amp
        push(b, v)
        i = i + 1
    }
    return b
}

// Harmonic-rich signal: fundamental + 2nd + 3rd harmonics with integer
// amplitudes 3:2:1, summed and divided by 6 to keep within int16.
fn _harmonic_buf(f0_hz, n, sr) {
    let h1 = synth_sine(f0_hz, n, sr)
    let h2 = synth_sine(f0_hz * 2, n, sr)
    let h3 = synth_sine(f0_hz * 3, n, sr)
    let out = list_new()
    let i = 0
    while i < n {
        let v = h1[i] * 3 + h2[i] * 2 + h3[i] * 1
        push(out, v / 6)
        i = i + 1
    }
    return out
}

// ---- constants + accessors ----------------------------------------------

fn test_yin_constants() {
    ce_eq("YIN threshold = 100 milli", pitch_yin_threshold(), 100)
    ce_eq("YIN voicing max = 1000",    pitch_yin_voicing_max(), 1000)
    // R10F constants still accessible (back-compat):
    ce_eq("R10F frame_ms still 30",    pitch_frame_ms(), 30)
}

// ---- d(tau) primitive ---------------------------------------------------

fn test_yin_diff_at_true_period_zero() {
    // Pure 200 Hz sine @ 16 kHz: period = 80 samples. d(80) should be
    // (close to) zero because samples[i] == samples[i+80] exactly.
    let s = synth_sine(200, 480, 16000)
    let d = pitch_yin_diff_at(s, 0, 480, 80)
    // Allow a tiny non-zero from sin-table quantization (in centi-square).
    // For pure 200 Hz the true period IS exactly 80 samples (16000/200=80),
    // so d(80) should be 0 within rounding.
    ce_eq("d(80) on 200 Hz sine = 0", d, 0)
}

fn test_yin_diff_at_half_period_positive() {
    // d(40) for a 200 Hz sine should be FAR from zero -- at half-period
    // the samples are out-of-phase. Sum of (x - (-x))^2 = 4 * sum(x^2).
    // For pure sine, this is ~= 4 * energy ~= 4 * sum(sin^2) = ~2 * N * amp^2.
    let s = synth_sine(200, 480, 16000)
    let d_half = pitch_yin_diff_at(s, 0, 480, 40)
    ce_check("d(40) on 200 Hz sine > 1e9 (well above zero)",
             d_half > 1000000000)
}

fn test_yin_diff_at_zero_lag_zero() {
    // d(tau=0): the sum is over (x(n) - x(n+0))^2 = 0. Vacuous truth.
    // pitch_yin_diff_at is undefined for tau=0 in the caller, but the
    // implementation returns 0 (empty range when end_pair=n-0=n and
    // i starts at off iterating with tau=0 makes inner be (a-a)^2=0).
    let s = synth_sine(200, 480, 16000)
    let d = pitch_yin_diff_at(s, 0, 480, 0)
    ce_eq("d(0) trivially = 0", d, 0)
}

// ---- pure sine frame estimator -----------------------------------------

fn test_yin_estimate_sine_200hz() {
    let s = synth_sine(200, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    let v  = pitch_result_voicing_milli(res)
    // 200 Hz @ 16 kHz: period exactly 80 samples -> 20000 centi-Hz exact.
    // Allow +/- 50 centi-Hz for parabolic-interp rounding.
    ce_check("YIN 200 Hz: F0 centi in [19950, 20050]",
             f0 >= 19950 && f0 <= 20050)
    ce_check("YIN 200 Hz: voicing high (>= 900 milli)", v >= 900)
}

fn test_yin_estimate_sine_100hz() {
    let s = synth_sine(100, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    let v  = pitch_result_voicing_milli(res)
    // 100 Hz @ 16 kHz: period 160 samples -> 10000 centi-Hz.
    ce_check("YIN 100 Hz: F0 centi in [9800, 10200]",
             f0 >= 9800 && f0 <= 10200)
    ce_check("YIN 100 Hz: voicing high (>= 900 milli)", v >= 900)
}

fn test_yin_estimate_sine_400hz() {
    let s = synth_sine(400, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    let v  = pitch_result_voicing_milli(res)
    // 400 Hz @ 16 kHz: period 40 samples -> 40000 centi-Hz.
    ce_check("YIN 400 Hz: F0 centi in [39800, 40200]",
             f0 >= 39800 && f0 <= 40200)
    ce_check("YIN 400 Hz: voicing high (>= 900 milli)", v >= 900)
}

// ---- harmonic-rich signal: YIN vs R10F head-to-head --------------------

fn test_yin_harmonic_rich_120hz_no_snap() {
    // Sum of fundamental + 2nd + 3rd harmonics at 120 Hz. The TRUE F0 is
    // 120 Hz = 12000 centi-Hz. A naive autocorrelation argmax might pick
    // a harmonic and report 24000 (2x) or 36000 (3x). YIN's cumulative
    // mean normalized difference function is the standard cure.
    let s = _harmonic_buf(120, 480, 16000)
    let yin_res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0_yin = pitch_result_f0_centihz(yin_res)
    // Allow +/- 100 centi-Hz tolerance. 120 Hz @ 16 kHz: period ~ 133.33
    // samples. With sub-sample parabolic refinement YIN should hit
    // ~12000 centi-Hz within rounding.
    ce_check("YIN harmonic 120 Hz: F0 centi in [11900, 12100]",
             f0_yin >= 11900 && f0_yin <= 12100)
    // Critical: F0 must NOT be 24000 (2nd-harmonic snap) or 36000
    // (3rd-harmonic snap). The whole point of YIN.
    let snapped_to_2h = 0
    if f0_yin >= 23800 && f0_yin <= 24200 { snapped_to_2h = 1 }
    let snapped_to_3h = 0
    if f0_yin >= 35800 && f0_yin <= 36200 { snapped_to_3h = 1 }
    ce_eq("YIN does NOT snap to 2nd harmonic (24000 centi-Hz)",
          snapped_to_2h, 0)
    ce_eq("YIN does NOT snap to 3rd harmonic (36000 centi-Hz)",
          snapped_to_3h, 0)
}

fn test_yin_voicing_high_on_periodic() {
    // The harmonic-rich signal has strong periodicity -> voicing should
    // be near max (1000 milli).
    let s = _harmonic_buf(120, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let v = pitch_result_voicing_milli(res)
    ce_check("YIN harmonic 120 Hz: voicing >= 800 milli",
             v >= 800)
}

// ---- noise / silence ----------------------------------------------------

fn test_yin_white_noise_unvoiced() {
    // d'(tau) should never drop below the 100 milli threshold on white
    // noise -- no dominant periodicity. Frame should be marked unvoiced
    // (f0_centihz = PITCH_UNVOICED = 0, voicing_milli = 0).
    let s = _noise_buf(480, 5000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    let v  = pitch_result_voicing_milli(res)
    ce_eq("YIN white noise: f0 = 0 (unvoiced)", f0, 0)
    ce_eq("YIN white noise: voicing = 0", v, 0)
}

fn test_yin_silence_unvoiced() {
    // Pure silence: R0 = 0, bail unvoiced.
    let s = _zero_buf(480)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    ce_eq("YIN silence: f0 = 0", pitch_result_f0_centihz(res), 0)
    ce_eq("YIN silence: voicing = 0",
          pitch_result_voicing_milli(res), 0)
}

// ---- Klatt vowel -------------------------------------------------------

fn test_yin_klatt_vowel_in_band() {
    // R6E's Klatt /uw/ synthesizes the F1/F2 cosine pair (no glottal
    // source). The cumulative-mean difference function's first below-
    // threshold local minimum should fall in the human-voice band.
    let vowel = synth_phoneme("uw")
    let view = list_new()
    let i = 0
    while i < 240 {
        push(view, vowel[i])
        i = i + 1
    }
    let res = pitch_estimate_frame_yin(view, 8000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    let v  = pitch_result_voicing_milli(res)
    // YIN may pick the GCD(F1, F2) sub-multiple or one of the formant
    // carrier periods. We assert the result is voiced and within the
    // searched band [50..500] Hz (5000..50000 centi-Hz).
    ce_check("Klatt /uw/: voiced (f0 != PITCH_UNVOICED)",
             f0 != pitch_unvoiced_sentinel())
    ce_check("Klatt /uw/: F0 in [50..500] Hz band",
             f0 >= 5000 && f0 <= 50000)
}

// ---- pitch_track_yin contour ------------------------------------------

fn test_yin_track_rising_pitch_contour() {
    // 10 frames at 100, 110, ..., 190 Hz. The YIN contour should rise.
    let pcm = list_new()
    let target_freqs = list_new()
    push(target_freqs, 100)
    push(target_freqs, 110)
    push(target_freqs, 120)
    push(target_freqs, 130)
    push(target_freqs, 140)
    push(target_freqs, 150)
    push(target_freqs, 160)
    push(target_freqs, 170)
    push(target_freqs, 180)
    push(target_freqs, 190)
    let fi = 0
    while fi < len(target_freqs) {
        let s = synth_sine(target_freqs[fi], 480, 16000)
        let j = 0
        while j < 480 {
            push(pcm, s[j])
            j = j + 1
        }
        fi = fi + 1
    }
    let contour = pitch_track_yin(pcm, 16000)
    ce_eq("YIN contour has 10 entries", len(contour), 10)
    ce_eq("YIN: all 10 frames voiced",
          pitch_voiced_count(contour), 10)
    let f0_first = pitch_result_f0_centihz(contour[0])
    let f0_last  = pitch_result_f0_centihz(contour[9])
    ce_check("YIN contour rises: first < last",
             f0_first < f0_last)
}

// ---- sub-sample parabolic interpolation --------------------------------
//
// The YIN paper's Step 5 (II.E) parabolic interpolation around the
// threshold-crossing tau gives sub-sample period precision -- a
// signal with true period 80.5 samples should land between
// integer tau=80 and tau=81 in the refined milli-tau.
//
// Test: a 197 Hz sine @ 16 kHz has true period 81.218... samples.
// YIN should refine this to a centi-Hz value close to 19700 (not the
// integer-tau snap to sr/81 = 19753 centi-Hz that a non-interpolated
// estimator would produce).

fn test_yin_parabolic_refines_period() {
    // 197 Hz sine: true period 16000/197 = 81.218 samples. F0 = 19700
    // centi-Hz. Without parabolic interp the result snaps to tau=81 ->
    // 19753 centi-Hz (53 centi off) or tau=80 -> 20000 centi-Hz (300 off).
    // With parabolic interp we expect closer to 19700.
    let s = synth_sine(197, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    // Tolerance: +/- 200 centi-Hz from the true value.
    ce_check("YIN 197 Hz with parabolic interp: F0 in [19500, 19900]",
             f0 >= 19500 && f0 <= 19900)
}

fn test_yin_parabolic_refines_173hz() {
    // 173 Hz sine: true period ~ 92.49 samples. F0 = 17300 centi-Hz.
    // Without interp the result would snap to tau=92 -> 17391 (91 off)
    // or tau=93 -> 17204 (96 off). Parabolic should refine.
    let s = synth_sine(173, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let f0 = pitch_result_f0_centihz(res)
    ce_check("YIN 173 Hz with parabolic interp: F0 in [17100, 17500]",
             f0 >= 17100 && f0 <= 17500)
}

// ---- back-compat: R10F autocorrelation still works -------------------

fn test_r10f_back_compat_sine_still_works() {
    // R10F's pitch_estimate_frame must still produce 20000 centi-Hz on
    // a 200 Hz sine (no regression from the YIN extension).
    let s = synth_sine(200, 480, 16000)
    let res = pitch_estimate_frame(s, 16000, 50, 500)
    let f0 = pitch_result_f0_centihz(res)
    ce_check("R10F back-compat: 200 Hz sine F0 centi in [19800, 20200]",
             f0 >= 19800 && f0 <= 20200)
}

fn test_r10f_back_compat_pitch_track() {
    // R10F's pitch_track on a single 200 Hz frame.
    let s = synth_sine(200, 480, 16000)
    let contour = pitch_track(s, 16000)
    ce_eq("R10F pitch_track: 1 frame for 480-sample input",
          len(contour), 1)
}

// ---- harmonic-rich head-to-head: YIN vs R10F autocorrelation ---------

fn test_yin_better_than_autocorrelation_on_harmonics() {
    // The harmonic-rich 120 Hz fixture is a synthetic test case. R10F's
    // pitch_estimate_frame has its own octave-down correction (PITCH_
    // OCTAVE_RATIO_MILLI = 920 milli = 0.92 threshold), so on this
    // fixture the integer-multiple peak check often does cure the snap
    // -- 12000 centi-Hz is reported by BOTH algorithms. The R10F's
    // octave correction is calibrated for the simple-harmonic case.
    //
    // The KEY DIFFERENCE shows up on natural speech / Klatt vowels with
    // FORMANT structure (separate F1/F2 frequencies that aren't integer
    // multiples of F0) -- there R10F snaps to F1 (296 Hz on Klatt /uw/,
    // 220 Hz on JFK) while YIN cures via its cumulative-mean difference
    // function. This unit test asserts:
    //
    //   (a) YIN F0 on the simple harmonic-rich fixture is ~12000.
    //   (b) Both algorithms PASS this fixture (parity demonstrated).
    //
    // The JFK / Klatt formant-snap difference is exercised in the
    // integration scenario (scenario_vv_yin_pitch.sh) where the real
    // speech sample is the discriminator.
    let s = _harmonic_buf(120, 480, 16000)
    let yin_res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    let ac_res = pitch_estimate_frame(s, 16000, 50, 500)
    let f0_yin = pitch_result_f0_centihz(yin_res)
    let f0_ac  = pitch_result_f0_centihz(ac_res)
    ce_check("YIN F0 ~ 12000 centi-Hz on harmonic 120 Hz",
             f0_yin >= 11800 && f0_yin <= 12200)
    // Both algorithms should at least be in the 50-500 Hz band on this
    // synthetic input (the formant snap is a natural-speech failure mode).
    ce_check("R10F F0 in [50..500] Hz band on harmonic 120 Hz",
             f0_ac >= 5000 && f0_ac <= 50000)
}

// ---- edge cases --------------------------------------------------------

fn test_yin_short_buffer_unvoiced() {
    // Buffer shorter than frame_size -> immediate unvoiced.
    let s = synth_sine(200, 100, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 50, 500, 0)
    ce_eq("YIN short buffer: f0 = 0",
          pitch_result_f0_centihz(res), 0)
    ce_eq("YIN short buffer: voicing = 0",
          pitch_result_voicing_milli(res), 0)
}

fn test_yin_default_bounds() {
    // f0_min=0 / f0_max=0 / yin_threshold=0 should fall back to defaults.
    let s = synth_sine(200, 480, 16000)
    let res = pitch_estimate_frame_yin(s, 16000, 0, 0, 0)
    let f0 = pitch_result_f0_centihz(res)
    ce_check("YIN default bounds (0/0/0): F0 ~ 200 Hz",
             f0 >= 19800 && f0 <= 20200)
}

fn test_yin_track_yin_silence() {
    // pitch_track_yin on all-silence -> contour of unvoiced frames.
    let pcm = _zero_buf(4800)
    let contour = pitch_track_yin(pcm, 16000)
    ce_eq("YIN track silence: 0 voiced frames",
          pitch_voiced_count(contour), 0)
}

// ---- main --------------------------------------------------------------

fn main() {
    test_yin_constants()

    test_yin_diff_at_true_period_zero()
    test_yin_diff_at_half_period_positive()
    test_yin_diff_at_zero_lag_zero()

    test_yin_estimate_sine_200hz()
    test_yin_estimate_sine_100hz()
    test_yin_estimate_sine_400hz()

    test_yin_harmonic_rich_120hz_no_snap()
    test_yin_voicing_high_on_periodic()

    test_yin_white_noise_unvoiced()
    test_yin_silence_unvoiced()

    test_yin_klatt_vowel_in_band()

    test_yin_track_rising_pitch_contour()

    test_yin_parabolic_refines_period()
    test_yin_parabolic_refines_173hz()

    test_r10f_back_compat_sine_still_works()
    test_r10f_back_compat_pitch_track()

    test_yin_better_than_autocorrelation_on_harmonics()

    test_yin_short_buffer_unvoiced()
    test_yin_default_bounds()
    test_yin_track_yin_silence()

    ce_summary("audio_pitch_yin")
}

main()
