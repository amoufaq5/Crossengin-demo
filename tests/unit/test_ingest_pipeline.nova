// Unit tests for src/ingest/pipeline.nova.

import "../ce_test.nova"
import "../../src/ingest/pipeline.nova"

fn test_null_reg_rejected() {
    let r = cur_new("history", "src:pack:history")
    let s = pip_ingest(0, r, 0)
    ce_eq("null reg rejected", pip_err_code(s), PIP_ERR_NULL_REG)
    ce_eq("ok=0", pip_ok(s), 0)
}

fn test_invalid_record_rejected() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let bad = cur_new("", "not-a-src")
    let s = pip_ingest(reg, bad, mo)
    ce_eq("invalid record", pip_err_code(s), PIP_ERR_INVALID_RECORD)
}

fn test_seeds_atoms_and_creates_kg() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("history", "src:pack:history")
    cur_add_atom(r, "hastings_1066", ATOM_FACT, 950)
    cur_add_atom(r, "harold_died", ATOM_FACT, 800)
    let s = pip_ingest(reg, r, mo)
    ce_eq("ok=1", pip_ok(s), 1)
    ce_eq("atoms_added=2", pip_atoms_added(s), 2)
    ce_eq("kg count went up", kg_count(reg), 1)
    let n = kg_count(reg)
    let history = 0
    let i = 0
    while i < n {
        let kg = kg_get(reg, i)
        if kg != 0 { if str_eq_bytes(kg_label(kg), "history") == 1 { history = kg } }
        i = i + 1
    }
    ce_check("history KG exists", history != 0)
    let hastings = kg_find_atom(history, "hastings_1066")
    ce_check("hastings atom present", hastings != 0)
    ce_eq("hastings belief mean ~950", bel_mean(atom_belief(hastings)), 950)
}

fn test_idempotent_no_double_seed() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("k", "src:x")
    cur_add_atom(r, "a", ATOM_FACT, 800)
    let s1 = pip_ingest(reg, r, mo)
    ce_eq("first pass added 1", pip_atoms_added(s1), 1)
    let s2 = pip_ingest(reg, r, mo)
    ce_eq("second pass adds 0", pip_atoms_added(s2), 0)
    ce_eq("second pass sees 1", pip_atoms_seen(s2), 1)
}

fn test_no_backslide_from_reingest() {
    let reg = kg_registry_new()
    let r1 = cur_new("k", "src:x")
    cur_add_atom(r1, "a", ATOM_FACT, 900)
    pip_ingest(reg, r1, 0)
    // Re-ingest at LOWER belief -- must not weaken.
    let r2 = cur_new("k", "src:x")
    cur_add_atom(r2, "a", ATOM_FACT, 100)
    pip_ingest(reg, r2, 0)
    let n = kg_count(reg)
    let kg = 0
    let i = 0
    while i < n {
        let k = kg_get(reg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "k") == 1 { kg = k } }
        i = i + 1
    }
    let a = kg_find_atom(kg, "a")
    ce_check("belief did not backslide below original", bel_mean(atom_belief(a)) >= 900)
}

fn test_dangling_implication_ante() {
    let reg = kg_registry_new()
    let r = cur_new("k", "src:x")
    cur_add_atom(r, "b", ATOM_FACT, 500)
    cur_add_imp(r, "no_such_atom", "b", "EMPIRICAL")
    let s = pip_ingest(reg, r, 0)
    ce_eq("dangling ante rejected", pip_err_code(s), PIP_ERR_IMP_DANGLING_ANTE)
    ce_eq("detail names atom", pip_err_detail(s), "no_such_atom")
}

fn test_empirical_implication_seeds_association() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("k", "src:x")
    cur_add_atom(r, "a", ATOM_FACT, 800)
    cur_add_atom(r, "b", ATOM_FACT, 800)
    cur_add_imp(r, "a", "b", "EMPIRICAL")
    let s = pip_ingest(reg, r, mo)
    ce_eq("ok", pip_ok(s), 1)
    ce_eq("imp added", pip_imps_added(s), 1)
    let n = kg_count(reg)
    let kg = 0
    let i = 0
    while i < n {
        let k = kg_get(reg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "k") == 1 { kg = k } }
        i = i + 1
    }
    let assoc = kg_find_atom(kg, "a-imp-b")
    ce_check("association atom seeded", assoc != 0)
}

fn test_observations_shift_belief() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("k", "src:x")
    cur_add_atom(r, "a", ATOM_FACT, 500)
    let big = 0
    while big < 5 { cur_add_obs(r, "a", 1, 1000) big = big + 1 }
    let s = pip_ingest(reg, r, mo)
    ce_eq("ok", pip_ok(s), 1)
    ce_eq("obs applied", pip_obs_applied(s), 5)
    let n = kg_count(reg)
    let kg = 0
    let i = 0
    while i < n {
        let k = kg_get(reg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "k") == 1 { kg = k } }
        i = i + 1
    }
    let a = kg_find_atom(kg, "a")
    // Started at 500 milli (Beta(2500,2500)); 5 positive full observations
    // add 5*1000=5000 to alpha -> Beta(7500,2500) -> mean 750.
    ce_eq("belief moved to ~750", bel_mean(atom_belief(a)), 750)
}

fn test_source_attribution() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("k", "src:pack:foo")
    cur_add_atom(r, "a", ATOM_FACT, 800)
    cur_add_atom(r, "b", ATOM_FACT, 800)
    pip_ingest(reg, r, mo)
    let report = mo_report(mo)
    ce_check("mo has entries", len(report) > 0)
    // Every atom attributed to src:pack:foo -> the report row for that
    // source should show at least 2 attributions.
    let found = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:foo") == 1 { found = 1 }
        i = i + 1
    }
    ce_eq("source src:pack:foo appears in mo", found, 1)
}

fn test_citations_recorded() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = cur_new("k", "src:paper:doi:aaa")
    cur_add_cite(r, "src:paper:doi:aaa", "src:paper:doi:bbb", "contradicts")
    let s = pip_ingest(reg, r, mo)
    ce_eq("ok", pip_ok(s), 1)
    ce_eq("cite recorded", pip_cites_recorded(s), 1)
    // Citations KG should exist.
    let n = kg_count(reg)
    let cites_kg = 0
    let i = 0
    while i < n {
        let k = kg_get(reg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "citations") == 1 { cites_kg = k } }
        i = i + 1
    }
    ce_check("citations KG created", cites_kg != 0)
}

fn main() {
    test_null_reg_rejected()
    test_invalid_record_rejected()
    test_seeds_atoms_and_creates_kg()
    test_idempotent_no_double_seed()
    test_no_backslide_from_reingest()
    test_dangling_implication_ante()
    test_empirical_implication_seeds_association()
    test_observations_shift_belief()
    test_source_attribution()
    test_citations_recorded()
    ce_summary("ingest_pipeline")
}

main()
