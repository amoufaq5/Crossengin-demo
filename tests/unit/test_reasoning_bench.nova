// Unit tests for src/bench/reasoning_bench.nova: the ADR-0086 Phase 7 reasoning
// benchmark. Builds a mixed bank of provable theorems (with valid kernel proofs)
// and unprovable claims (no proof, or a bogus one) and asserts the soundness
// scorecard: every theorem proven, every non-theorem refused, ZERO false proofs.

import "../ce_test.nova"
import "../../src/bench/reasoning_bench.nova"

fn _ax(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

fn _ax2(t1, t2) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t1) axiom_table_add(tbl, t2)
    return tbl
}

// Build a representative bank covering the kernel's rules:
//   1. AXIOM: p, with p registered  -> PROVABLE
//   2. MP: from (p->q), p, derive q -> PROVABLE
//   3. AND_I: from p, q derive p&q  -> PROVABLE
//   4. HS: from (a->b),(b->c) get (a->c) -> PROVABLE
//   5. an UNPROVABLE claim with NO proof supplied -> must REFUSE
//   6. an UNPROVABLE claim with a BOGUS proof (axiom p claiming q) -> must REFUSE
fn _build_bank() {
    let items = list_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let pq_imp = term_imp(p, q)

    // 1. axiom p.
    push(items, bench_item(1, _ax(p), hyp_new(), pf_axiom(p), p, BENCH_PROVABLE))
    // 2. modus ponens -> q.
    push(items, bench_item(2, _ax2(pq_imp, p), hyp_new(),
        pf_mp(q, pf_axiom(pq_imp), pf_axiom(p)), q, BENCH_PROVABLE))
    // 3. and-intro -> (p and q).
    let pandq = term_and(p, q)
    push(items, bench_item(3, _ax2(p, q), hyp_new(),
        pf_and_i(pandq, pf_axiom(p), pf_axiom(q)), pandq, BENCH_PROVABLE))
    // 4. hypothetical syllogism -> (a -> c).
    let ac = term_imp(a, c)
    push(items, bench_item(4, _ax2(term_imp(a, b), term_imp(b, c)), hyp_new(),
        pf_hs(ac, pf_axiom(term_imp(a, b)), pf_axiom(term_imp(b, c))),
        ac, BENCH_PROVABLE))
    // 5. unprovable, no proof supplied (engine must refuse, honestly).
    push(items, bench_item(5, axiom_table_new(), hyp_new(), 0, term_atom("z"),
        BENCH_UNPROVABLE))
    // 6. unprovable, BOGUS proof: axiom-of-p claiming q (kernel rejects).
    push(items, bench_item(6, _ax(p), hyp_new(), pf_axiom(p), q,
        BENCH_UNPROVABLE))
    return items
}

fn test_perfect_soundness_scorecard() {
    let reg = proof_registry_new()
    let items = _build_bank()
    let s = bench_run(reg, items)
    ce_eq("6 items", bench_total(s), 6)
    ce_eq("4 proven", bench_proven(s), 4)
    ce_eq("2 refused", bench_refused(s), 2)
    ce_eq("all 6 correct", bench_correct(s), 6)
    ce_eq("accuracy 1000 milli", bench_accuracy(s), 1000)
    ce_eq("zero missed (no theorem refused)", bench_missed(s), 0)
    // THE load-bearing assertion: the kernel never proved a non-theorem.
    ce_eq("ZERO false proofs", bench_false_proofs(s), 0)
    ce_eq("benchmark reports SOUND", bench_is_sound(s), 1)
    print(bench_render(s))
}

// The harness must COUNT a false proof if one ever occurred. Simulate the
// adversary's dream: an item whose ground truth is UNPROVABLE but whose proof
// the kernel WOULD accept (i.e. it's actually a theorem mislabeled). The scorer
// must flag it as a false proof + report UNSOUND, so a real kernel regression
// can never hide behind a green bench.
fn test_harness_flags_a_false_proof() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let items = list_new()
    // A genuine theorem (axiom p) deliberately mislabeled UNPROVABLE.
    push(items, bench_item(1, _ax(p), hyp_new(), pf_axiom(p), p, BENCH_UNPROVABLE))
    let s = bench_run(reg, items)
    ce_eq("counted as proven", bench_proven(s), 1)
    ce_eq("flagged false proof", bench_false_proofs(s), 1)
    ce_eq("reports UNSOUND", bench_is_sound(s), 0)
    ce_eq("not counted correct", bench_correct(s), 0)
}

// Incompleteness is honest, not unsound: refusing a real theorem (no proof
// supplied) counts as MISSED, never as a soundness breach.
fn test_incompleteness_is_not_unsound() {
    let reg = proof_registry_new()
    let items = list_new()
    // A provable claim but NO proof supplied -> engine refuses -> missed.
    push(items, bench_item(1, axiom_table_new(), hyp_new(), 0,
        term_atom("theorem"), BENCH_PROVABLE))
    let s = bench_run(reg, items)
    ce_eq("refused", bench_refused(s), 1)
    ce_eq("missed (incompleteness)", bench_missed(s), 1)
    ce_eq("still sound (no false proof)", bench_false_proofs(s), 0)
    ce_eq("sound", bench_is_sound(s), 1)
    // accuracy reflects the miss: 0/1.
    ce_eq("accuracy 0", bench_accuracy(s), 0)
}

// An empty bank is vacuously sound with 0 accuracy denominator handled.
fn test_empty_bank() {
    let reg = proof_registry_new()
    let s = bench_run(reg, list_new())
    ce_eq("total 0", bench_total(s), 0)
    ce_eq("accuracy 0 (no div by zero)", bench_accuracy(s), 0)
    ce_eq("vacuously sound", bench_is_sound(s), 1)
}

// The built-in bank (shared with the /bench chat command) scores perfectly and
// SOUND: 5 provable theorems proven, 2 unprovable claims refused, 0 false proofs.
fn test_default_bank_is_perfect_and_sound() {
    let reg = proof_registry_new()
    let s = bench_run(reg, bench_default_bank())
    ce_eq("11 items", bench_total(s), 11)
    ce_eq("7 proven (incl 2+2=4, 6/2=3)", bench_proven(s), 7)
    ce_eq("4 refused (incl 2+2=5, 7/2=3)", bench_refused(s), 4)
    ce_eq("all correct", bench_correct(s), 11)
    ce_eq("zero false proofs", bench_false_proofs(s), 0)
    ce_eq("sound", bench_is_sound(s), 1)
    ce_check("default report non-empty", len(bench_default_report()) > 0)
}

// ---- head-to-head comparison (increment 17) --------------------------------

// The load-bearing ENGINE invariant over the comparison: no matter the LLM
// column, the engine is correct on every item with ZERO false proofs (its
// errors, if any, are abstentions). This is the structural guarantee.
fn test_compare_engine_invariant() {
    let reg = proof_registry_new()
    let s = bench_compare(reg, bench_default_pairs())
    ce_eq("engine correct on all", cmp_eng_correct(s), cmp_total(s))
    ce_eq("engine accuracy 1000", cmp_eng_accuracy(s), 1000)
    ce_eq("engine ZERO false proofs", cmp_eng_false_proofs(s), 0)
    print(bench_compare_render(s))
}

// The HARNESS math on a controlled 3-item bank with known recorded verdicts:
//   A: provable axiom p,  LLM affirms -> LLM correct
//   B: unprovable (no proof), LLM affirms -> LLM false-confident
//   C: unprovable (no proof), LLM denies  -> LLM correct
fn test_compare_scores_llm() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let pairs = list_new()
    push(pairs, bench_pair(
        bench_item(1, _ax(p), hyp_new(), pf_axiom(p), p, BENCH_PROVABLE),
        LLM_AFFIRM))
    push(pairs, bench_pair(
        bench_item(2, axiom_table_new(), hyp_new(), 0, term_atom("z"), BENCH_UNPROVABLE),
        LLM_AFFIRM))
    push(pairs, bench_pair(
        bench_item(3, axiom_table_new(), hyp_new(), 0, term_atom("w"), BENCH_UNPROVABLE),
        LLM_DENY))
    let s = bench_compare(reg, pairs)
    ce_eq("3 items", cmp_total(s), 3)
    // engine: A proven (correct), B refused (correct), C refused (correct).
    ce_eq("engine correct 3", cmp_eng_correct(s), 3)
    ce_eq("engine false proofs 0", cmp_eng_false_proofs(s), 0)
    ce_eq("engine refused 2", cmp_eng_refused(s), 2)
    // LLM: A affirm-provable (correct), B affirm-unprovable (false-conf),
    // C deny-unprovable (correct).
    ce_eq("LLM correct 2", cmp_llm_correct(s), 2)
    ce_eq("LLM false-confident 1", cmp_llm_false_conf(s), 1)
}

// The illustrative default pairs: the engine sweeps it, the recorded LLM does
// not (it commits to some unprovable claims) -- the structural gap.
fn test_default_pairs_show_the_gap() {
    let reg = proof_registry_new()
    let s = bench_compare(reg, bench_default_pairs())
    ce_check("engine beats or ties LLM accuracy",
        cmp_eng_accuracy(s) >= cmp_llm_accuracy(s))
    ce_check("LLM has at least one false-confident answer",
        cmp_llm_false_conf(s) >= 1)
    ce_eq("engine still has zero false proofs", cmp_eng_false_proofs(s), 0)
    ce_check("compare report non-empty", len(bench_compare_report()) > 0)
}

fn main() {
    test_perfect_soundness_scorecard()
    test_harness_flags_a_false_proof()
    test_incompleteness_is_not_unsound()
    test_empty_bank()
    test_default_bank_is_perfect_and_sound()
    test_compare_engine_invariant()
    test_compare_scores_llm()
    test_default_pairs_show_the_gap()
    ce_summary("reasoning_bench")
}

main()
