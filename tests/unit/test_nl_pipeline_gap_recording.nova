// Unit tests: R103 gap-recording along the nl.ask / skill.run path.
//
// Verifies each of the four gap-reasons that fire from live pipeline
// activity actually lands in the register:
//   - GAP_UNPARSED from nl.ask on gibberish
//   - GAP_LOW_CONFIDENCE from a successful nl.ask under-threshold
//   - GAP_NO_MATCH from a successful nl.ask that produced 0 atoms
//   - GAP_SKILL_REFUSED from a skill supervisor refusal
// The GAP_REFUSED path is exercised by test_nl_executor (executor
// signature accommodation).

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/parts/meta/gaps_register.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}
fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}
fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

fn _seed_atom(kg, label, alpha) {
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    let b = atom_belief(a)
    list_set(b, 0, alpha)
    list_set(b, 1, 5000 - alpha)
    return a
}

// KG with a couple of atoms so research policy has SOMETHING to
// return.
fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "physics")
    _seed_atom(kg, "mars",   4000)
    _seed_atom(kg, "phobos", 3500)
    return reg
}

// Full ctx with kgreg + skill_reg + mo + gaps_reg wired.
fn _mk_ctx() {
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, echo_skill_manifest())
    skill_registry_register(sr, research_skill_manifest())
    let ctx = rpc_ctx_new(kgreg, 0, 0, sr, mo, 0, 0, 100)
    rpc_ctx_set_gaps_reg(ctx, gaps_register_new(0))
    return ctx
}

// Count gap events matching a specific reason.
fn _count_by_reason(reg, reason) {
    return len(gaps_entries_by_reason(reg, reason))
}

// ---- GAP_UNPARSED from unparseable nl.ask --------------------------------

fn test_unparseable_nl_ask_records_unparsed() {
    let ctx = _mk_ctx()
    let reg = rpc_ctx_gaps_reg(ctx)
    let before = _count_by_reason(reg, GAP_UNPARSED)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "asdf qwerty gorpblarp", "user_id", "alice"), ctx)
    let after = _count_by_reason(reg, GAP_UNPARSED)
    ce_check("nl.ask returned",       _has(out, "\"ok\":true"))
    ce_check("UNPARSED bumped by 1",  after == before + 1)
}

fn test_unparseable_records_topic() {
    let ctx = _mk_ctx()
    let reg = rpc_ctx_gaps_reg(ctx)
    rpc_dispatch("nl.ask",
        _args2("text", "zzz mystery input", "user_id", "alice"), ctx)
    // Find the last UNPARSED event and check the topic.
    let entries = gaps_entries_by_reason(reg, GAP_UNPARSED)
    ce_check("entries not empty", len(entries) > 0)
    let last = entries[len(entries) - 1]
    ce_str_eq("topic captured",
              gap_event_topic(last), "zzz mystery input")
}

fn test_unparseable_gap_holder_from_token() {
    let ctx = _mk_ctx()
    let reg = rpc_ctx_gaps_reg(ctx)
    // Wire a token so presented_holder resolves to a name; enforcement
    // stays OFF (no sandbox on) but the token+cap_reg is enough for
    // rpc_ctx_presented_holder to return the holder name.
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("rtok", "carol", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 0)   // enforced=0, but registry wired
    rpc_ctx_set_presented_token(ctx, "rtok")
    rpc_dispatch("nl.ask",
        _args2("text", "gorp blorp", "user_id", "carol"), ctx)
    let entries = gaps_entries_for_holder(reg, "carol")
    ce_check("carol has >=1 gap", len(entries) > 0)
    // At least one of carol's should be UNPARSED.
    let saw = 0
    let i = 0
    while i < len(entries) {
        if gap_event_reason(entries[i]) == GAP_UNPARSED { saw = 1 }
        i = i + 1
    }
    ce_eq("carol saw UNPARSED", saw, 1)
}

// ---- GAP_NO_MATCH on successful dispatch with zero atoms -----------------

fn test_nl_ask_no_match_records_no_match() {
    // Research skill returns 0 atoms when the topic has no KG matches.
    let ctx = _mk_ctx()
    let reg = rpc_ctx_gaps_reg(ctx)
    let before = _count_by_reason(reg, GAP_NO_MATCH)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "what is jupiter", "user_id", "alice"), ctx)
    let after_nomatch = _count_by_reason(reg, GAP_NO_MATCH)
    ce_check("nl.ask returned",           _has(out, "\"ok\":true"))
    // Either NO_MATCH or LOW_CONFIDENCE fires; the research policy
    // for an absent label typically produces zero touched atoms
    // (which is our NO_MATCH bucket).
    let after_low  = _count_by_reason(reg, GAP_LOW_CONFIDENCE)
    ce_check("either NO_MATCH or LOW_CONFIDENCE bumped",
             after_nomatch > before || after_low > before)
}

// ---- GAP_SKILL_REFUSED via a direct skill.run refusal --------------------
//
// The echo skill declares no refusal conditions; force a refusal by
// asking research to run over an EMPTY kg -- research's manifest lists
// COND_KG_EMPTY, so the supervisor returns a pre-policy refusal, which
// the R103 skill_run_scoped path records as GAP_SKILL_REFUSED.

fn test_skill_run_refusal_records_skill_refused() {
    // Ctx with EMPTY kg registry so research's kg-empty refusal fires.
    let empty_reg = kg_registry_new()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, research_skill_manifest())
    // Pre-install so skill.run can dispatch.
    let capreg = 0
    let sup = skill_supervisor_new(research_skill_manifest(),
                                    empty_reg, 0, 0, 0, mo, 100)
    skill_registry_install(sr, "research", 0, sup, 100)
    let ctx = rpc_ctx_new(empty_reg, 0, 0, sr, mo, 0, 0, 100)
    rpc_ctx_set_gaps_reg(ctx, gaps_register_new(0))
    let reg = rpc_ctx_gaps_reg(ctx)
    let before = _count_by_reason(reg, GAP_SKILL_REFUSED)
    let out = rpc_dispatch("skill.run",
        _args2("name", "research", "arg", "any topic"), ctx)
    let after = _count_by_reason(reg, GAP_SKILL_REFUSED)
    ce_check("skill.run returned",       _has(out, "\"ok\":true"))
    ce_check("SKILL_REFUSED bumped",     after > before)
}

// ---- gaps_reg=0 (no register wired) => nothing recorded ------------------

fn test_no_gap_recorded_when_no_register() {
    // ctx without rpc_ctx_set_gaps_reg -> RCTX_GAPS_REG stays 0 ->
    // gaps_record calls short-circuit; nl.ask still runs fine.
    let kgreg = _mk_kgreg()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, echo_skill_manifest())
    let ctx = rpc_ctx_new(kgreg, 0, 0, sr, mo, 0, 0, 100)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "asdf qwerty gorpblarp", "user_id", "alice"), ctx)
    ce_check("nl.ask still returns ok", _has(out, "\"ok\":true"))
    // self.gaps refuses with the "no register" shape.
    let out2 = rpc_dispatch("self.gaps", list_new(), ctx)
    ce_check("self.gaps refuses",       _has(out2, "\"ok\":false"))
    ce_check("names missing register",  _has(out2, "no gaps register"))
}

// ---- register accessible via ctx ------------------------------------------

fn test_gaps_reg_roundtrip_via_ctx() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    ce_eq("initially 0", rpc_ctx_gaps_reg(ctx), 0)
    let reg = gaps_register_new(0)
    rpc_ctx_set_gaps_reg(ctx, reg)
    ce_check("round-trips", rpc_ctx_gaps_reg(ctx) == reg)
}

// ---- ring-buffer honored across pipeline calls ---------------------------

fn test_ring_trim_across_pipeline_calls() {
    // Small cap so overflow demonstrates. Requires re-plumbing the
    // ctx's gaps_reg to a smaller-cap register.
    let ctx = _mk_ctx()
    let reg = gaps_register_new(3)
    rpc_ctx_set_gaps_reg(ctx, reg)
    // Fire 5 unparseable asks; the ring holds 3 with lifetime total = 5.
    rpc_dispatch("nl.ask", _args2("text", "zap", "user_id", "u"), ctx)
    rpc_dispatch("nl.ask", _args2("text", "zip", "user_id", "u"), ctx)
    rpc_dispatch("nl.ask", _args2("text", "zop", "user_id", "u"), ctx)
    rpc_dispatch("nl.ask", _args2("text", "zup", "user_id", "u"), ctx)
    rpc_dispatch("nl.ask", _args2("text", "zyp", "user_id", "u"), ctx)
    ce_eq("count clamped to 3", gaps_count(reg), 3)
    ce_eq("lifetime total 5",   gaps_total(reg), 5)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_unparseable_nl_ask_records_unparsed()
    test_unparseable_records_topic()
    test_unparseable_gap_holder_from_token()
    test_nl_ask_no_match_records_no_match()
    test_skill_run_refusal_records_skill_refused()
    test_no_gap_recorded_when_no_register()
    test_gaps_reg_roundtrip_via_ctx()
    test_ring_trim_across_pipeline_calls()
    ce_summary("nl_pipeline_gap_recording")
    return 0
}

main()
