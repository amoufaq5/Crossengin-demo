// Unit tests for src/io/transducers/deflate_decode.nova (P3.1.PNG full).
//
// Coverage of the pure-NOVA DEFLATE decompressor for ALL three RFC 1951
// block types:
//
//   * BTYPE = 00  STORED  -- regression coverage so the
//     Item-3 stored-block path keeps decoding bit-for-bit even after
//     the static / dynamic Huffman additions land.
//   * BTYPE = 01  STATIC  -- "hello" at level 9 round-trip via the fixed
//     RFC 1951 section 3.2.6 Huffman tables; an EMPTY block (just the
//     end-of-block marker); 12 X's exercising a length back-ref; 8 a's
//     exercising an OVERLAPPING copy (length > distance); 12 A's + B
//     exercising the length-extra-bits path (length code 265 + extra
//     bit -> length 11); HELLO + 270 padding + HELLO exercising a
//     multi-byte DISTANCE code (distance > 256).
//   * BTYPE = 02  DYNAMIC -- a long pangram repetition compresses to a
//     dynamic Huffman block (BTYPE=10); the round-trip recovers all
//     22500 bytes and the first / last 45 chars match the pangram.
//
// All fixtures are pre-compressed by Python's `zlib.compressobj(level=9,
// wbits=-15)` (the raw-DEFLATE variant) and pasted as `store8` literals
// so the suite never depends on a Python interpreter at test time.
//
// Acceptance: 30+ assertions across 8 test functions. Stored-block
// regression + static-Huffman happy path + edge cases (length 265 with
// extra bits, distance > 256, overlapping copy) + dynamic-Huffman
// round-trip. The integration scenario (scenario_t_png_see.sh) exercises
// the full pipeline end-to-end with a real PNG generated by
// scripts/gen_test_png.py at zlib level 9 (dynamic Huffman).

import "../ce_test.nova"
import "../../src/io/transducers/deflate_decode.nova"

// ---- stored-block regression (BTYPE=00) ----------------------------------

fn test_stored_single_block() {
    // BFINAL=1, BTYPE=00, padding -> 0x01. LEN=5, NLEN=0xFFFA.
    // Payload: 0x10, 0x20, 0x30, 0x40, 0x50.
    let buf = alloc(16)
    store8(buf + 0, 1)
    store8(buf + 1, 5)
    store8(buf + 2, 0)
    store8(buf + 3, 250)
    store8(buf + 4, 255)
    store8(buf + 5, 16)
    store8(buf + 6, 32)
    store8(buf + 7, 48)
    store8(buf + 8, 64)
    store8(buf + 9, 80)
    let r = deflate_decode(buf, 10)
    ce_str_eq("stored block: no error", deflate_result_error(r), "")
    ce_eq("stored block: 5 bytes out", deflate_result_length(r), 5)
    let out = deflate_result_output(r)
    ce_eq("stored byte 0", load8(out + 0), 16)
    ce_eq("stored byte 1", load8(out + 1), 32)
    ce_eq("stored byte 2", load8(out + 2), 48)
    ce_eq("stored byte 3", load8(out + 3), 64)
    ce_eq("stored byte 4", load8(out + 4), 80)
}

// ---- static Huffman happy path (BTYPE=01) --------------------------------

fn test_static_hello() {
    // Python: zlib.compressobj(level=9, wbits=-15).compress(b'hello')+flush()
    // -> cb 48 cd c9 c9 07 00
    let buf = alloc(8)
    store8(buf + 0, 203)
    store8(buf + 1, 72)
    store8(buf + 2, 205)
    store8(buf + 3, 201)
    store8(buf + 4, 201)
    store8(buf + 5, 7)
    store8(buf + 6, 0)
    let r = deflate_decode(buf, 7)
    ce_str_eq("static hello: no error", deflate_result_error(r), "")
    ce_eq("static hello: 5 bytes out", deflate_result_length(r), 5)
    let out = deflate_result_output(r)
    ce_eq("static hello byte 0 (h=104)", load8(out + 0), 104)
    ce_eq("static hello byte 1 (e=101)", load8(out + 1), 101)
    ce_eq("static hello byte 2 (l=108)", load8(out + 2), 108)
    ce_eq("static hello byte 3 (l=108)", load8(out + 3), 108)
    ce_eq("static hello byte 4 (o=111)", load8(out + 4), 111)
}

// ---- static Huffman empty block ------------------------------------------

fn test_static_empty_block() {
    // Python: zlib.compressobj(level=9, wbits=-15).compress(b'')+flush()
    // -> 03 00  (BFINAL=1, BTYPE=01, then the 7-bit code for symbol 256)
    let buf = alloc(3)
    store8(buf + 0, 3)
    store8(buf + 1, 0)
    let r = deflate_decode(buf, 2)
    ce_str_eq("static empty: no error", deflate_result_error(r), "")
    ce_eq("static empty: 0 bytes out", deflate_result_length(r), 0)
}

// ---- static Huffman with overlapping copy (length > distance) -----------

fn test_static_eight_a_overlapping() {
    // 8 'a's: 'aaaaaaaa'. The 'a' literal is emitted once, then a
    // back-reference of length 7 + distance 1 reads the byte being
    // written (RLE encoding). Python l=9 raw: 4b 4c 84 00 00.
    let buf = alloc(6)
    store8(buf + 0, 75)
    store8(buf + 1, 76)
    store8(buf + 2, 132)
    store8(buf + 3, 0)
    store8(buf + 4, 0)
    let r = deflate_decode(buf, 5)
    ce_str_eq("8a overlapping: no error", deflate_result_error(r), "")
    ce_eq("8a overlapping: 8 bytes out", deflate_result_length(r), 8)
    let out = deflate_result_output(r)
    let all_a = 1
    let i = 0
    while i < 8 {
        if load8(out + i) != 97 { all_a = 0 }   // 'a' == 97
        i = i + 1
    }
    ce_eq("8a overlapping: all bytes are 'a'", all_a, 1)
}

// ---- length code with extra bits (length 265 + 1 extra bit -> 11) -------

fn test_static_length_extra_bits() {
    // 12 A's + 'B': 'AAAAAAAAAAAAB' (13 bytes). The 12 A's
    // compress as A literal then back-ref of length 11 (length code 265
    // with 1 extra bit), distance 1. Python l=9 raw: 73 74 44 00 27 00.
    let buf = alloc(7)
    store8(buf + 0, 115)
    store8(buf + 1, 116)
    store8(buf + 2, 68)
    store8(buf + 3, 0)
    store8(buf + 4, 39)
    store8(buf + 5, 0)
    let r = deflate_decode(buf, 6)
    ce_str_eq("length-extra: no error", deflate_result_error(r), "")
    ce_eq("length-extra: 13 bytes out", deflate_result_length(r), 13)
    let out = deflate_result_output(r)
    // First 12 bytes are 'A' = 65.
    let all_A = 1
    let i = 0
    while i < 12 {
        if load8(out + i) != 65 { all_A = 0 }
        i = i + 1
    }
    ce_eq("length-extra: bytes 0..11 are 'A'", all_A, 1)
    ce_eq("length-extra: byte 12 is 'B'", load8(out + 12), 66)
}

// ---- 12 X's: exercises a back-ref of length 11 (code 265 + 1 extra) -----

fn test_static_twelve_X() {
    // 12 'X' = XXXXXXXXXXXX. Python l=9 raw: 8b 88 40 00 00.
    let buf = alloc(6)
    store8(buf + 0, 139)
    store8(buf + 1, 136)
    store8(buf + 2, 64)
    store8(buf + 3, 0)
    store8(buf + 4, 0)
    let r = deflate_decode(buf, 5)
    ce_str_eq("twelve X: no error", deflate_result_error(r), "")
    ce_eq("twelve X: 12 bytes out", deflate_result_length(r), 12)
    let out = deflate_result_output(r)
    let all_X = 1
    let i = 0
    while i < 12 {
        if load8(out + i) != 88 { all_X = 0 }   // 'X' = 88
        i = i + 1
    }
    ce_eq("twelve X: all bytes are 'X'", all_X, 1)
}

// ---- distance > 256 (multi-byte distance code) --------------------------

fn test_static_distance_gt_256() {
    // Input: 'HELLO' + 270 'X' + 'HELLO' + 5 'Y' (285 bytes total).
    // The second HELLO is a back-ref at distance 275 (270 X + 5 HELLO).
    // Distance 275 lands in code 16 (base 257, 7 extra bits).
    // Python l=9 raw: f3 70 f5 f1 f1 8f 18 05 48 c0 03 14 24 91 20 00 00.
    let buf = alloc(18)
    store8(buf + 0, 243)
    store8(buf + 1, 112)
    store8(buf + 2, 245)
    store8(buf + 3, 241)
    store8(buf + 4, 241)
    store8(buf + 5, 143)
    store8(buf + 6, 24)
    store8(buf + 7, 5)
    store8(buf + 8, 72)
    store8(buf + 9, 192)
    store8(buf + 10, 3)
    store8(buf + 11, 20)
    store8(buf + 12, 36)
    store8(buf + 13, 145)
    store8(buf + 14, 32)
    store8(buf + 15, 0)
    store8(buf + 16, 0)
    let r = deflate_decode(buf, 17)
    ce_str_eq("dist>256: no error", deflate_result_error(r), "")
    ce_eq("dist>256: 285 bytes out", deflate_result_length(r), 285)
    let out = deflate_result_output(r)
    // First 5 bytes: HELLO = 72 69 76 76 79.
    ce_eq("dist>256 byte 0 (H=72)",  load8(out + 0), 72)
    ce_eq("dist>256 byte 4 (O=79)",  load8(out + 4), 79)
    // Bytes 5..274: 270 'X' = 88.
    ce_eq("dist>256 byte 100 (X=88)", load8(out + 100), 88)
    ce_eq("dist>256 byte 274 (X=88)", load8(out + 274), 88)
    // Bytes 275..279: second HELLO.
    ce_eq("dist>256 byte 275 (H=72)", load8(out + 275), 72)
    ce_eq("dist>256 byte 279 (O=79)", load8(out + 279), 79)
    // Bytes 280..284: YYYYY = 89.
    ce_eq("dist>256 byte 284 (Y=89)", load8(out + 284), 89)
}

// ---- dynamic Huffman (BTYPE=10) ------------------------------------------

fn test_dynamic_pangram() {
    // Pangram repeated 500 times = 22500 bytes, compressed via Python
    // zlib level 9 raw -> 127 byte dynamic Huffman block.
    //   text = 'The quick brown fox jumps over the lazy dog. ' * 500
    // Pre-encoded byte sequence (127 bytes).
    let buf = alloc(128)
    store8(buf + 0,   237)
    store8(buf + 1,   202)
    store8(buf + 2,   203)
    store8(buf + 3,   1)
    store8(buf + 4,   130)
    store8(buf + 5,   48)
    store8(buf + 6,   20)
    store8(buf + 7,   0)
    store8(buf + 8,   176)
    store8(buf + 9,   85)
    store8(buf + 10,  222)
    store8(buf + 11,  4)
    store8(buf + 12,  76)
    store8(buf + 13,  211)
    store8(buf + 14,  5)
    store8(buf + 15,  64)
    store8(buf + 16,  139)
    store8(buf + 17,  127)
    store8(buf + 18,  11)
    store8(buf + 19,  213)
    store8(buf + 20,  170)
    store8(buf + 21,  48)
    store8(buf + 22,  189)
    store8(buf + 23,  92)
    store8(buf + 24,  216)
    store8(buf + 25,  34)
    store8(buf + 26,  231)
    store8(buf + 27,  36)
    store8(buf + 28,  157)
    store8(buf + 29,  115)
    store8(buf + 30,  204)
    store8(buf + 31,  237)
    store8(buf + 32,  114)
    store8(buf + 33,  184)
    store8(buf + 34,  197)
    store8(buf + 35,  80)
    store8(buf + 36,  203)
    store8(buf + 37,  247)
    store8(buf + 38,  25)
    store8(buf + 39,  99)
    store8(buf + 40,  249)
    store8(buf + 41,  197)
    store8(buf + 42,  181)
    store8(buf + 43,  61)
    store8(buf + 44,  166)
    store8(buf + 45,  87)
    store8(buf + 46,  148)
    store8(buf + 47,  79)
    store8(buf + 48,  174)
    store8(buf + 49,  241)
    store8(buf + 50,  222)
    store8(buf + 51,  248)
    store8(buf + 52,  222)
    store8(buf + 53,  175)
    store8(buf + 54,  75)
    store8(buf + 55,  28)
    store8(buf + 56,  203)
    store8(buf + 57,  169)
    store8(buf + 58,  139)
    store8(buf + 59,  36)
    store8(buf + 60,  203)
    store8(buf + 61,  178)
    store8(buf + 62,  44)
    store8(buf + 63,  203)
    store8(buf + 64,  178)
    store8(buf + 65,  44)
    store8(buf + 66,  203)
    store8(buf + 67,  178)
    store8(buf + 68,  44)
    store8(buf + 69,  203)
    store8(buf + 70,  178)
    store8(buf + 71,  44)
    store8(buf + 72,  203)
    store8(buf + 73,  178)
    store8(buf + 74,  44)
    store8(buf + 75,  203)
    store8(buf + 76,  178)
    store8(buf + 77,  44)
    store8(buf + 78,  203)
    store8(buf + 79,  178)
    store8(buf + 80,  44)
    store8(buf + 81,  203)
    store8(buf + 82,  178)
    store8(buf + 83,  44)
    store8(buf + 84,  203)
    store8(buf + 85,  178)
    store8(buf + 86,  44)
    store8(buf + 87,  203)
    store8(buf + 88,  178)
    store8(buf + 89,  44)
    store8(buf + 90,  203)
    store8(buf + 91,  178)
    store8(buf + 92,  44)
    store8(buf + 93,  203)
    store8(buf + 94,  178)
    store8(buf + 95,  44)
    store8(buf + 96,  203)
    store8(buf + 97,  178)
    store8(buf + 98,  44)
    store8(buf + 99,  203)
    store8(buf + 100, 178)
    store8(buf + 101, 44)
    store8(buf + 102, 203)
    store8(buf + 103, 178)
    store8(buf + 104, 44)
    store8(buf + 105, 203)
    store8(buf + 106, 178)
    store8(buf + 107, 44)
    store8(buf + 108, 203)
    store8(buf + 109, 178)
    store8(buf + 110, 44)
    store8(buf + 111, 203)
    store8(buf + 112, 178)
    store8(buf + 113, 44)
    store8(buf + 114, 203)
    store8(buf + 115, 178)
    store8(buf + 116, 44)
    store8(buf + 117, 203)
    store8(buf + 118, 178)
    store8(buf + 119, 44)
    store8(buf + 120, 203)
    store8(buf + 121, 178)
    store8(buf + 122, 44)
    store8(buf + 123, 203)
    store8(buf + 124, 242)
    store8(buf + 125, 158)
    store8(buf + 126, 255)
    let r = deflate_decode(buf, 127)
    ce_str_eq("dynamic pangram: no error", deflate_result_error(r), "")
    ce_eq("dynamic pangram: 22500 bytes out", deflate_result_length(r), 22500)
    let out = deflate_result_output(r)
    // First 11 bytes: "The quick b" -> T h e _ q u i c k _ b
    //   T=84 h=104 e=101 ' '=32 q=113 u=117 i=105 c=99 k=107 ' '=32 b=98
    ce_eq("dynamic byte 0 (T)",   load8(out + 0),   84)
    ce_eq("dynamic byte 1 (h)",   load8(out + 1),   104)
    ce_eq("dynamic byte 2 (e)",   load8(out + 2),   101)
    ce_eq("dynamic byte 3 ( )",   load8(out + 3),   32)
    ce_eq("dynamic byte 4 (q)",   load8(out + 4),   113)
    // Verify repetition: byte 45 starts the second copy of pangram.
    ce_eq("dynamic byte 45 (T)",  load8(out + 45),  84)
    ce_eq("dynamic byte 90 (T)",  load8(out + 90),  84)
    // Last byte (22499) is ' ' (space at the end of pangram).
    ce_eq("dynamic byte 22499 ( )", load8(out + 22499), 32)
}

// ---- BTYPE=11 reserved must be rejected ----------------------------------

fn test_btype_11_reserved() {
    // BFINAL=1, BTYPE=11 -> 0x07.
    let buf = alloc(4)
    store8(buf + 0, 7)
    let r = deflate_decode(buf, 1)
    ce_check("BTYPE=11 reserved -> error",
             len(deflate_result_error(r)) > 0)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_stored_single_block()
    test_static_hello()
    test_static_empty_block()
    test_static_eight_a_overlapping()
    test_static_length_extra_bits()
    test_static_twelve_X()
    test_static_distance_gt_256()
    test_dynamic_pangram()
    test_btype_11_reserved()
    ce_summary("deflate")
}

main()
