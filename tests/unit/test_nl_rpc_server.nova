// Unit tests for src/nl/rpc_server.nova (R49, ADR-0104 §Component 5).
//
// Covers the JSON-RPC line adapter: parses one JSON request per line,
// dispatches through rpc_verbs.rpc_dispatch, returns a JSON response.
// The socket / daemon layer is NOT exercised here (that lives in
// examples/crossengin_rpc_daemon.nova and is smoke-tested end-to-end).

import "../ce_test.nova"
import "../../src/nl/rpc_server.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// ---- test harness --------------------------------------------------------

// Build the same fixture kg_registry the rpc_verbs tests use.
fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg1 = kg_spawn(reg, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    list_set(a1[A_BELIEF], 0, 8000) list_set(a1[A_BELIEF], 1, 2000)
    return reg
}

fn _mk_ctx() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, research_skill_manifest())
    let preg = persona_registry_new()
    persona_registry_ensure(preg, "owner", 100)
    return rpc_ctx_new(kgreg, capreg, preg, sr, mo, 0, 0, 100)
}

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- happy-path dispatch ------------------------------------------------

fn test_handles_kg_list_no_args() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"verb\":\"kg.list\"}", ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("names kg",        _has(out, "solar_system"))
    ce_check("no id echoed",    _has(out, "\"id\":") == 0)
}

fn test_handles_nl_parse_only() {
    let ctx = _mk_ctx()
    let req = "{\"verb\":\"nl.parse_only\",\"args\":{\"text\":\"what is mars\"}}"
    let out = rpc_server_handle_line(req, ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("kind research",   _has(out, "\"kind\":\"research\""))
    ce_check("topic mars",      _has(out, "\"mars\""))
}

fn test_handles_nl_ask_end_to_end() {
    let ctx = _mk_ctx()
    let req = "{\"verb\":\"nl.ask\",\"args\":{\"text\":\"what is mars\",\"user_id\":\"owner\"}}"
    let out = rpc_server_handle_line(req, ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("templated present", _has(out, "\"templated_answer\":"))
    ce_check("mentions mars",     _has(out, "mars"))
    ce_check("parser=grammar",    _has(out, "\"parser_used\":\"grammar\""))
}

// ---- id correlation -----------------------------------------------------

fn test_numeric_id_echoed() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line(
        "{\"verb\":\"kg.list\",\"id\":42}", ctx)
    ce_check("id numeric",    _has(out, "\"id\":42"))
    ce_check("id before ok",  find_bytes(out, "\"id\":42") < find_bytes(out, "\"ok\":"))
}

fn test_string_id_echoed() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line(
        "{\"verb\":\"kg.list\",\"id\":\"req-001\"}", ctx)
    ce_check("id string quoted", _has(out, "\"id\":\"req-001\""))
}

fn test_null_id_echoed() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line(
        "{\"verb\":\"kg.list\",\"id\":null}", ctx)
    ce_check("id null echoed", _has(out, "\"id\":null"))
}

fn test_no_id_no_echo() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"verb\":\"kg.list\"}", ctx)
    ce_eq("no id key", _has(out, "\"id\":"), 0)
}

// ---- number / bool arg coercion -----------------------------------------

fn test_numeric_arg_becomes_string() {
    // rpc_verbs.rpc_dispatch expects arg VALUES as strings; the server
    // coerces JSON numbers before handing off.
    let ctx = _mk_ctx()
    let q = rq_ctx_note("N/A")
    // ingest.deny wants "id" -- a JSON number should become "1".
    // Wire a review queue in so the verb reaches its arg-check.
    let out = rpc_server_handle_line(
        "{\"verb\":\"ingest.deny\",\"args\":{\"id\":1,\"reason\":\"stale\"}}",
        ctx)
    // No review queue in ctx -> the verb refuses with a clear error;
    // that's the CORRECT downstream signal (the arg was coerced fine,
    // the missing infra is what refuses).
    ce_check("no review queue error",
             _has(out, "no review queue"))
    ce_eq("no arg-coercion crash",
          _has(out, "malformed"), 0)
}

fn test_bool_arg_becomes_string() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line(
        "{\"verb\":\"kg.list\",\"args\":{\"quiet\":true}}", ctx)
    // kg.list ignores the extra arg; the point is that "true" didn't
    // crash the coercion path.
    ce_check("ok",     _has(out, "\"ok\":true"))
}

// ---- malformed input ----------------------------------------------------

fn test_empty_line_refused() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("", ctx)
    ce_check("empty error",  _has(out, "empty request"))
    ce_check("wire is JSON", _has(out, "\"ok\":false"))
}

fn test_whitespace_only_refused() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("   \r\n\t  ", ctx)
    ce_check("still empty", _has(out, "empty request"))
}

fn test_malformed_json_refused() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{not json", ctx)
    ce_check("malformed JSON", _has(out, "malformed JSON"))
    ce_check("ok false",       _has(out, "\"ok\":false"))
}

fn test_non_object_root_refused() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("[1,2,3]", ctx)
    ce_check("names object",  _has(out, "must be a JSON object"))
}

fn test_missing_verb_refused() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"args\":{\"text\":\"x\"}}", ctx)
    ce_check("names field",   _has(out, "missing field: verb"))
}

fn test_verb_wrong_type_refused() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"verb\":42}", ctx)
    ce_check("names must-be-string", _has(out, "verb' must be a string"))
}

fn test_unknown_verb_from_dispatch() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"verb\":\"no.such\"}", ctx)
    ce_check("unknown verb", _has(out, "unknown verb: no.such"))
    ce_check("ok false",      _has(out, "\"ok\":false"))
}

// ---- trailing whitespace / newlines --------------------------------------

fn test_leading_ws_tolerated() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("   \t {\"verb\":\"kg.list\"}", ctx)
    ce_check("still ok", _has(out, "\"ok\":true"))
}

fn test_trailing_crlf_tolerated() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"verb\":\"kg.list\"}\r\n", ctx)
    ce_check("still ok", _has(out, "\"ok\":true"))
}

// ---- escaping the response line -----------------------------------------

fn test_response_escapes_quotes_in_error() {
    let ctx = _mk_ctx()
    let out = rpc_server_handle_line("{\"verb\":\"has\\\"quote\"}", ctx)
    ce_check("escaped quote in error", _has(out, "has\\\"quote"))
    ce_check("wire still parseable ok:false", _has(out, "\"ok\":false"))
}

// ---- banner -------------------------------------------------------------

fn test_banner_shape() {
    let b = rpc_server_banner()
    ce_check("names CrossEngin", _has(b, "CrossEngin"))
    ce_check("names JSON-RPC",   _has(b, "JSON-RPC"))
    ce_check("names 12 verbs",   _has(b, "12 verbs"))
    ce_check("cites ADR",        _has(b, "ADR-0104"))
}

// ---- determinism --------------------------------------------------------

fn test_deterministic_same_request_same_wire() {
    let ctx1 = _mk_ctx()
    let ctx2 = _mk_ctx()
    let req = "{\"verb\":\"nl.parse_only\",\"args\":{\"text\":\"is earth a planet\"}}"
    let a = rpc_server_handle_line(req, ctx1)
    let b = rpc_server_handle_line(req, ctx2)
    ce_check("byte-identical", str_eq_bytes(a, b) == 1)
}

// ---- helper (no-op; keeps compilation focused when a test refers to it) --
fn rq_ctx_note(x) { return x }

// ---- main ---------------------------------------------------------------

fn main() {
    test_handles_kg_list_no_args()
    test_handles_nl_parse_only()
    test_handles_nl_ask_end_to_end()
    test_numeric_id_echoed()
    test_string_id_echoed()
    test_null_id_echoed()
    test_no_id_no_echo()
    test_numeric_arg_becomes_string()
    test_bool_arg_becomes_string()
    test_empty_line_refused()
    test_whitespace_only_refused()
    test_malformed_json_refused()
    test_non_object_root_refused()
    test_missing_verb_refused()
    test_verb_wrong_type_refused()
    test_unknown_verb_from_dispatch()
    test_leading_ws_tolerated()
    test_trailing_crlf_tolerated()
    test_response_escapes_quotes_in_error()
    test_banner_shape()
    test_deterministic_same_request_same_wire()
    ce_summary("nl_rpc_server")
}

main()
