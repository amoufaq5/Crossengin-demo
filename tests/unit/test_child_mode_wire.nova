// Unit tests for R100 child-mode wire integration.
//
// The disable table + bit constants are covered by test_child_mode.nova;
// this file covers the seams they hook into:
//   - RCTX_CHILD_MODE_BITS accessor + mutator round-trip.
//   - rpc_ctx_is_child_mode / rpc_ctx_child_mode_bits helpers.
//   - rpc_dispatch: with CHILD_MODE_ACTIVE set, every disabled verb
//     returns the child-mode refusal envelope AND does NOT run the
//     verb's implementation.
//   - rpc_dispatch: with CHILD_MODE_ACTIVE set, enabled verbs still
//     dispatch (their existing shape is unchanged).
//   - rpc_dispatch: without the bit, the disable table is a no-op --
//     verbs behave as pre-R100.
//   - capability_authorize_ex: child-mode gate fires BEFORE the cap
//     check when both would refuse (child-mode message wins).

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/factory/child_mode.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    let kgreg = kg_registry_new()
    kg_spawn(kgreg, "world")
    return rpc_ctx_new(kgreg, capreg_new(), persona_registry_new(),
                        skill_registry_new(), mo_new(), 0, 0, 100)
}

fn _mk_child_ctx() {
    let c = _mk_ctx()
    rpc_ctx_set_child_mode_bits(c, CHILD_MODE_ACTIVE)
    return c
}

// ---- ctx slot mechanics ------------------------------------------------

fn test_default_bits_zero() {
    let c = _mk_ctx()
    ce_eq("default child_mode bits = 0", rpc_ctx_child_mode_bits(c), 0)
    ce_eq("default is_child_mode = 0", rpc_ctx_is_child_mode(c), 0)
}

fn test_bits_round_trip() {
    let c = _mk_ctx()
    rpc_ctx_set_child_mode_bits(c, CHILD_MODE_ACTIVE)
    ce_eq("bits round-trip", rpc_ctx_child_mode_bits(c), CHILD_MODE_ACTIVE)
    ce_eq("is_child_mode=1", rpc_ctx_is_child_mode(c), 1)
}

fn test_bits_clear() {
    let c = _mk_ctx()
    rpc_ctx_set_child_mode_bits(c, CHILD_MODE_ACTIVE)
    rpc_ctx_set_child_mode_bits(c, 0)
    ce_eq("cleared bits", rpc_ctx_child_mode_bits(c), 0)
    ce_eq("cleared is_child_mode=0", rpc_ctx_is_child_mode(c), 0)
}

fn test_higher_bit_still_recognized_as_child() {
    // R101+ may add sub-bits (bit 1, bit 2 ...) alongside ACTIVE.
    // A ctx that has bit 0 AND any higher bit still reports child mode.
    let c = _mk_ctx()
    rpc_ctx_set_child_mode_bits(c, 3)   // ACTIVE (bit0) + hypothetical bit1
    ce_eq("bit0+bit1 -> is_child_mode=1", rpc_ctx_is_child_mode(c), 1)
}

fn test_only_higher_bit_not_child_mode() {
    // If only a higher bit is set (bit1 alone, without bit0), the ctx
    // should NOT be considered in child mode -- ACTIVE is bit 0 by
    // definition. Guards against future misuse of the bitmask.
    let c = _mk_ctx()
    rpc_ctx_set_child_mode_bits(c, 2)   // just bit1
    ce_eq("bit1-only -> not child mode",
          rpc_ctx_is_child_mode(c), 0)
}

// ---- dispatch: disabled verbs in child mode ----------------------------

fn _assert_wire_disabled(verb) {
    let c = _mk_child_ctx()
    let out = rpc_dispatch(verb, list_new(), c)
    if _has(out, "\"ok\":false") == 1 {
        if _has(out, "child-mode runtime") == 1 {
            if _has(out, verb) == 1 {
                ce_pass = ce_pass + 1
                return 0
            }
        }
    }
    ce_fail = ce_fail + 1
    println("FAIL: expected child-mode refusal for '" + verb + "', got: " + out)
    return 0
}

fn test_disabled_ingest_file() { _assert_wire_disabled("ingest.file") }
fn test_disabled_ingest_policy_add() { _assert_wire_disabled("ingest.policy.add") }
fn test_disabled_ingest_policy_list() { _assert_wire_disabled("ingest.policy.list") }
fn test_disabled_ingest_policy_remove() { _assert_wire_disabled("ingest.policy.remove") }
fn test_disabled_capsule_install() { _assert_wire_disabled("capsule.install") }
fn test_disabled_skill_install() { _assert_wire_disabled("skill.install") }
fn test_disabled_pattern_install() { _assert_wire_disabled("pattern.install") }
fn test_disabled_session_save() { _assert_wire_disabled("session.save") }
fn test_disabled_admin_bake_child() { _assert_wire_disabled("admin.bake_child") }
fn test_disabled_admin_emit_delta() { _assert_wire_disabled("admin.emit_delta") }
fn test_disabled_admin_rotate_token() { _assert_wire_disabled("admin.rotate_token") }
fn test_disabled_admin_set_qps() { _assert_wire_disabled("admin.set_qps") }
fn test_disabled_admin_set_expires() { _assert_wire_disabled("admin.set_expires") }
fn test_disabled_admin_grant_cap() { _assert_wire_disabled("admin.grant_cap") }
fn test_disabled_admin_remove_cap() { _assert_wire_disabled("admin.remove_cap") }
fn test_disabled_admin_set_revoked() { _assert_wire_disabled("admin.set_revoked") }
fn test_disabled_admin_set_holder() { _assert_wire_disabled("admin.set_holder") }
fn test_disabled_capability_issue() { _assert_wire_disabled("capability.issue") }
fn test_disabled_capability_revoke() { _assert_wire_disabled("capability.revoke") }
fn test_disabled_ownership_transfer() { _assert_wire_disabled("ownership.transfer") }

// ---- dispatch: enabled verbs in child mode still work ------------------
//
// We can't easily test full nl.ask output here (needs full grammar +
// classifier wiring); instead assert that the response is NOT the
// child-mode refusal (any other error shape is fine -- e.g. missing
// arg -- because it means we made it past the child-mode gate).

fn _assert_wire_not_child_refused(verb) {
    let c = _mk_child_ctx()
    let out = rpc_dispatch(verb, list_new(), c)
    if _has(out, "child-mode runtime") == 1 {
        ce_fail = ce_fail + 1
        println("FAIL: verb '" + verb + "' unexpectedly refused as child-mode: " + out)
    } else {
        ce_pass = ce_pass + 1
    }
}

fn test_enabled_nl_ask_not_child_refused() { _assert_wire_not_child_refused("nl.ask") }
fn test_enabled_kg_list_not_child_refused() { _assert_wire_not_child_refused("kg.list") }
fn test_enabled_skill_run_not_child_refused() { _assert_wire_not_child_refused("skill.run") }
fn test_enabled_capsule_list_not_child_refused() { _assert_wire_not_child_refused("capsule.list") }
fn test_enabled_skill_list_not_child_refused() { _assert_wire_not_child_refused("skill.list") }
fn test_enabled_pattern_list_not_child_refused() { _assert_wire_not_child_refused("pattern.list") }
fn test_enabled_session_load_not_child_refused() { _assert_wire_not_child_refused("session.load") }
fn test_enabled_session_list_not_child_refused() { _assert_wire_not_child_refused("session.list") }
fn test_enabled_ownership_list_not_child_refused() { _assert_wire_not_child_refused("ownership.list") }
fn test_enabled_capability_list_not_child_refused() { _assert_wire_not_child_refused("capability.list") }
fn test_enabled_nl_metrics_not_child_refused() { _assert_wire_not_child_refused("nl.metrics") }
// R102: update.apply is the ONE admin verb that stays enabled in
// child mode. It's the mother -> child mutation channel.
fn test_enabled_update_apply_not_child_refused() { _assert_wire_not_child_refused("update.apply") }

// ---- dispatch: no child mode = pre-R100 behavior -----------------------

fn test_mother_mode_disabled_verb_dispatches() {
    // A disabled-in-child-mode verb, dispatched from a mother-mode
    // ctx, must NOT be refused as child-mode. Sample: capsule.install
    // with no args returns its own arg-error, NOT the child-mode
    // message.
    let c = _mk_ctx()
    let out = rpc_dispatch("capsule.install", list_new(), c)
    ce_check("no child-mode refusal in mother mode",
             _has(out, "child-mode runtime") == 0)
}

fn test_mother_mode_admin_bake_dispatches() {
    // admin.bake_child without env-loaded signer keys refuses with a
    // signer-related error, not a child-mode error.
    let c = _mk_ctx()
    let mt = "BAKE-MANIFEST v1\nNAME t\nVERSION 1\nDOMAIN d\n"
    let args = list_new()
    push(args, rpc_arg_kv("manifest_text", mt))
    let out = rpc_dispatch("admin.bake_child", args, c)
    ce_check("mother-mode bake gets past child gate",
             _has(out, "child-mode runtime") == 0)
}

// ---- capability_authorize_ex: child-mode message wins over cap error ---

fn test_authorize_ex_child_mode_wins() {
    // Simulate: cap enforcement on, no token, disabled verb, child
    // mode active. The pre-R100 authorize would refuse with
    // "capability required: request missing 'token' field". With
    // R100 the child-mode message wins (fires first).
    let out = capability_authorize_ex(CHILD_MODE_ACTIVE, 1, 1, 0, "",
                                      "admin.bake_child", 100)
    ce_check("child-mode msg wins over cap",
             _has(out, "child-mode runtime") == 1)
    ce_check("no cap-required prefix",
             _has(out, "capability required") == 0)
}

fn test_authorize_ex_no_child_delegates_to_cap() {
    // Bit clear -> falls through to capability_authorize, so the
    // no-registry error surfaces exactly as before R100.
    let out = capability_authorize_ex(0, 1, 1, 0, "tk-x",
                                      "admin.bake_child", 100)
    ce_check("cap error surfaces",
             _has(out, "capability required") == 1
          || _has(out, "sandbox misconfigured") == 1)
    ce_check("no child-mode message",
             _has(out, "child-mode runtime") == 0)
}

fn test_authorize_ex_enabled_verb_not_child_gated() {
    // In child mode but for an ENABLED verb (verb_disabled=0), the
    // child gate is inert and the pre-R100 authorize runs.
    let out = capability_authorize_ex(CHILD_MODE_ACTIVE, 0, 0, 0, "",
                                      "nl.ask", 100)
    ce_str_eq("enforced=0 -> empty (authorized)", out, "")
}

// ---- verb count reflects R101's 3 new verbs (38 + 3 = 41) --------------

fn test_verb_count_still_38() {
    // Note: verb-count is the authoritative check in test_nl_rpc_verbs.nova; this is a mirror.
    ce_eq("verb count 51 (post-R111: 49 + 2 self.override verbs)",
          len(rpc_verb_names()), 51)
}

// ---- main --------------------------------------------------------------

fn main() {
    test_default_bits_zero()
    test_bits_round_trip()
    test_bits_clear()
    test_higher_bit_still_recognized_as_child()
    test_only_higher_bit_not_child_mode()

    test_disabled_ingest_file()
    test_disabled_ingest_policy_add()
    test_disabled_ingest_policy_list()
    test_disabled_ingest_policy_remove()
    test_disabled_capsule_install()
    test_disabled_skill_install()
    test_disabled_pattern_install()
    test_disabled_session_save()
    test_disabled_admin_bake_child()
    test_disabled_admin_emit_delta()
    test_disabled_admin_rotate_token()
    test_disabled_admin_set_qps()
    test_disabled_admin_set_expires()
    test_disabled_admin_grant_cap()
    test_disabled_admin_remove_cap()
    test_disabled_admin_set_revoked()
    test_disabled_admin_set_holder()
    test_disabled_capability_issue()
    test_disabled_capability_revoke()
    test_disabled_ownership_transfer()

    test_enabled_nl_ask_not_child_refused()
    test_enabled_kg_list_not_child_refused()
    test_enabled_skill_run_not_child_refused()
    test_enabled_capsule_list_not_child_refused()
    test_enabled_skill_list_not_child_refused()
    test_enabled_pattern_list_not_child_refused()
    test_enabled_session_load_not_child_refused()
    test_enabled_session_list_not_child_refused()
    test_enabled_ownership_list_not_child_refused()
    test_enabled_capability_list_not_child_refused()
    test_enabled_nl_metrics_not_child_refused()
    test_enabled_update_apply_not_child_refused()

    test_mother_mode_disabled_verb_dispatches()
    test_mother_mode_admin_bake_dispatches()

    test_authorize_ex_child_mode_wins()
    test_authorize_ex_no_child_delegates_to_cap()
    test_authorize_ex_enabled_verb_not_child_gated()

    test_verb_count_still_38()

    ce_summary("child_mode_wire")
}

main()
