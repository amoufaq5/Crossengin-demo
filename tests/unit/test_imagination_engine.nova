// Unit tests for src/parts/imagination/imagination_engine.nova
// Verifies pattern creation, match/apply, seed bootstrap, abstraction, and state
// helpers. ADR-0032.

import "../ce_test.nova"
import "../../src/parts/imagination/imagination_engine.nova"

fn lst(a, b) { let l = list_new(); push(l, a); push(l, b); return l }
fn one(a) { let l = list_new(); push(l, a); return l }

fn test_patterns() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    ce_str_eq("imagination kg", kg_label(ikg), "imagination")
    let p = pattern_new(ikg, "p1", one(1), one(2), 0)
    ce_eq("is pattern", is_pattern(p), 1)
    ce_eq("confidence uniform", pattern_confidence(p), 500)
    // Matching and application.
    ce_eq("matches when present", pattern_matches(p, one(1)), 1)
    ce_eq("no match when absent", pattern_matches(p, one(9)), 0)
    let out = pattern_apply(p, one(1))
    ce_eq("applied adds successor", img_state_has(out, 2), 1)
    ce_eq("original preserved", img_state_has(out, 1), 1)
    // Empty situation matches anything.
    let pe = pattern_new(ikg, "pe", list_new(), one(7), 0)
    ce_eq("empty situation matches", pattern_matches(pe, one(99)), 1)
}

fn test_seeds_and_abstract() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    ce_eq("ten seeds", seed_patterns(ikg, 0), 10)
    ce_eq("ten patterns", len(img_patterns(ikg)), 10)
    pattern_abstract(ikg, one(5), one(6), 0)
    ce_eq("abstract adds one", len(img_patterns(ikg)), 11)
}

fn test_state_helpers() {
    let s = img_state_new()
    img_state_add(s, 3)
    img_state_add(s, 3)   // dedup
    img_state_add(s, 4)
    ce_eq("dedup", img_state_size(s), 2)
    ce_eq("has 3", img_state_has(s, 3), 1)
    ce_eq("not 9", img_state_has(s, 9), 0)
}

fn main() {
    test_patterns()
    test_seeds_and_abstract()
    test_state_helpers()
    ce_summary("imagination_engine")
}

main()
