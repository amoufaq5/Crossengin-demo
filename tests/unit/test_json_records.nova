// Unit tests for R65 JSON structured-record importer, refactored in
// R69 onto src/data/json.nova.
//
// The parser layer (json_parse) is now shared with the rest of the
// codebase and covered by tests/unit/test_json.nova; this suite only
// exercises the SCHEMA layer (jsonr_parse_text / jsonr_parse) that
// turns JV_* trees into curriculum records.
//
// Covers:
//   * jsonr_parse_text: full happy-path record with every field
//     populated, capsule metadata, deps
//   * kg / source defaults from kg_hint + source_tag
//   * Field-shape validation: missing/malformed atom/imp/obs/citation
//     fields log errors but keep other records
//   * Kind coercion: string names AND integer constants both work
//   * Float rejection at the SCHEMA layer (belief / weight / sign
//     must be strict ints; the R69 parser accepts JSON floats but
//     they never land in an int slot without a per-record error)
//   * source_registry FMT_JSON dispatch tag
//   * Sample file at data/packs/samples/climate_facts.json parses

import "../ce_test.nova"
import "../../src/ingest/importers/json_records.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/ingest/source_registry.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- jsonr_parse_text: full record ------------------------------------

fn _sample_body() {
    let s = ""
    s = s + "[\n"
    s = s + "  {\n"
    s = s + "    \"kg\": \"solar_system\",\n"
    s = s + "    \"source\": \"src:json:sample:v1\",\n"
    s = s + "    \"capsule\": {\n"
    s = s + "      \"name\": \"solar_json_pack\",\n"
    s = s + "      \"version\": \"1.0.0\",\n"
    s = s + "      \"description\": \"tiny sample\",\n"
    s = s + "      \"license\": \"CC-BY-4.0\",\n"
    s = s + "      \"deps\": [{\"name\":\"physics\",\"version\":\"1.0.0\"}]\n"
    s = s + "    },\n"
    s = s + "    \"atoms\": [\n"
    s = s + "      {\"label\":\"mercury\",\"kind\":\"fact\",\"belief\":900},\n"
    s = s + "      {\"label\":\"hot\",\"kind\":\"concept\",\"belief\":800}\n"
    s = s + "    ],\n"
    s = s + "    \"implications\": [\n"
    s = s + "      {\"ante\":\"mercury\",\"conseq\":\"hot\",\"strength\":\"EMPIRICAL\"}\n"
    s = s + "    ],\n"
    s = s + "    \"observations\": [\n"
    s = s + "      {\"label\":\"mercury\",\"sign\":1,\"weight\":500}\n"
    s = s + "    ],\n"
    s = s + "    \"citations\": [\n"
    s = s + "      {\"from\":\"src:json:sample:v1\",\"to\":\"src:paper:X\",\"rel\":\"supports\"}\n"
    s = s + "    ]\n"
    s = s + "  }\n"
    s = s + "]\n"
    return s
}

fn test_full_record_all_fields_populated() {
    let r = jsonr_parse_text(_sample_body(), "", "")
    let recs = jsonr_records(r)
    let errs = jsonr_errors(r)
    ce_eq("no errors", len(errs), 0)
    ce_eq("1 record", len(recs), 1)
    let rec = recs[0]
    ce_str_eq("kg",  cur_kg(rec),     "solar_system")
    ce_str_eq("src", cur_source(rec), "src:json:sample:v1")
    ce_eq("2 atoms", len(cur_atoms(rec)),  2)
    ce_eq("1 imp",   len(cur_imps(rec)),   1)
    ce_eq("1 obs",   len(cur_obs(rec)),    1)
    ce_eq("1 cite",  len(cur_cites(rec)),  1)
    // Capsule metadata round-trip
    ce_eq("has capsule", cur_has_capsule(rec), 1)
    ce_str_eq("cap name",    cur_capsule_name(rec),        "solar_json_pack")
    ce_str_eq("cap version", cur_capsule_version(rec),     "1.0.0")
    ce_str_eq("cap license", cur_capsule_license(rec),     "CC-BY-4.0")
    ce_eq("1 dep",   len(cur_capsule_deps(rec)), 1)
    // Atom shape
    let a0 = cur_atoms(rec)[0]
    ce_str_eq("atom label", a0[CUR_ATOM_LABEL], "mercury")
    ce_eq("atom kind FACT", a0[CUR_ATOM_KIND],  ATOM_FACT)
    ce_eq("atom belief 900", a0[CUR_ATOM_BELIEF], 900)
    let a1 = cur_atoms(rec)[1]
    ce_eq("atom 1 kind CONCEPT", a1[CUR_ATOM_KIND], ATOM_CONCEPT)
    // Imp shape
    let m0 = cur_imps(rec)[0]
    ce_str_eq("imp ante",     m0[CUR_IMP_ANTE],   "mercury")
    ce_str_eq("imp conseq",   m0[CUR_IMP_CONSEQ], "hot")
    ce_str_eq("imp strength", m0[CUR_IMP_STR],    "EMPIRICAL")
    // Obs
    let o0 = cur_obs(rec)[0]
    ce_eq("obs sign +1",   o0[CUR_OBS_SIGN],   1)
    ce_eq("obs weight 500", o0[CUR_OBS_WEIGHT], 500)
    // Cite
    let c0 = cur_cites(rec)[0]
    ce_str_eq("cite from", c0[CUR_CITE_FROM], "src:json:sample:v1")
    ce_str_eq("cite rel",  c0[CUR_CITE_REL],  "supports")
}

fn test_kg_and_source_defaults_apply() {
    // Record without top-level "kg" / "source" -- pick up defaults.
    let body = "[{\"atoms\":[{\"label\":\"x\",\"kind\":\"fact\",\"belief\":500}]}]"
    let r = jsonr_parse_text(body, "default_kg", "src:json:default:v1")
    let recs = jsonr_records(r)
    ce_eq("1 record", len(recs), 1)
    ce_str_eq("kg from hint",   cur_kg(recs[0]),     "default_kg")
    ce_str_eq("src from arg",   cur_source(recs[0]), "src:json:default:v1")
}

fn test_record_own_values_override_defaults() {
    let body = "[{\"kg\":\"mine\",\"source\":\"src:json:mine\","
             + "\"atoms\":[{\"label\":\"y\",\"kind\":\"fact\",\"belief\":500}]}]"
    let r = jsonr_parse_text(body, "IGNORED", "src:IGNORED")
    ce_str_eq("record's kg wins",  cur_kg(jsonr_records(r)[0]),     "mine")
    ce_str_eq("record's src wins", cur_source(jsonr_records(r)[0]), "src:json:mine")
}

fn test_missing_kg_no_hint_records_error_and_skips() {
    let body = "[{\"source\":\"src:x\",\"atoms\":[{\"label\":\"z\",\"kind\":\"fact\",\"belief\":100}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_eq("no records produced", len(jsonr_records(r)), 0)
    ce_check("error names missing kg",
             _has(jsonr_errors(r)[0][1], "missing 'kg'"))
}

fn test_missing_source_no_default_records_error_and_skips() {
    let body = "[{\"kg\":\"whatever\",\"atoms\":[{\"label\":\"z\",\"kind\":\"fact\",\"belief\":100}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_eq("no records", len(jsonr_records(r)), 0)
    ce_check("error names missing source",
             _has(jsonr_errors(r)[0][1], "missing 'source'"))
}

fn test_lenient_bad_atom_kind_logged_others_land() {
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\",\"atoms\":["
             + "{\"label\":\"ok\",\"kind\":\"fact\",\"belief\":500},"
             + "{\"label\":\"wat\",\"kind\":\"bogus\",\"belief\":500}"
             + "]}]"
    let r = jsonr_parse_text(body, "", "")
    let recs = jsonr_records(r)
    ce_eq("record still built", len(recs), 1)
    ce_eq("1 good atom", len(cur_atoms(recs[0])), 1)
    ce_check("error names unknown kind",
             _has(jsonr_errors(r)[0][1], "unknown 'kind'"))
}

fn test_kind_accepts_integer_constant() {
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"atoms\":[{\"label\":\"y\",\"kind\":1,\"belief\":500}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_eq("no errors", len(jsonr_errors(r)), 0)
    ce_eq("kind mapped to FACT",
          cur_atoms(jsonr_records(r)[0])[0][CUR_ATOM_KIND], ATOM_FACT)
}

fn test_imp_strength_validation() {
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"implications\":[{\"ante\":\"a\",\"conseq\":\"b\",\"strength\":\"WEAK\"}]}]"
    let r = jsonr_parse_text(body, "", "")
    let errs = jsonr_errors(r)
    ce_check("error records unknown strength",
             _has(errs[0][1], "FORMAL or EMPIRICAL"))
    // No imp added because strength failed.
    ce_eq("0 imps landed",
          len(cur_imps(jsonr_records(r)[0])), 0)
}

fn test_obs_sign_validation() {
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"observations\":[{\"label\":\"a\",\"sign\":2,\"weight\":100}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_check("error records bad sign",
             _has(jsonr_errors(r)[0][1], "sign' must be +1 or -1"))
    ce_eq("0 obs landed",
          len(cur_obs(jsonr_records(r)[0])), 0)
}

fn test_top_level_json_error_returned() {
    let r = jsonr_parse_text("not-json-at-all", "", "")
    ce_eq("no records", len(jsonr_records(r)), 0)
    ce_check("error mentions json prefix",
             _has(jsonr_errors(r)[0][1], "json:"))
}

fn test_top_level_must_be_array() {
    // Single object at the top -- refused (must wrap in array).
    let body = "{\"kg\":\"k\",\"source\":\"src:x\"}"
    let r = jsonr_parse_text(body, "", "")
    ce_eq("no records", len(jsonr_records(r)), 0)
    ce_check("error names array requirement",
             _has(jsonr_errors(r)[0][1], "must be a JSON array"))
}

fn test_multiple_records_parse() {
    let body = "["
             + "{\"kg\":\"a\",\"source\":\"src:x:1\",\"atoms\":[{\"label\":\"a1\",\"kind\":\"fact\",\"belief\":500}]},"
             + "{\"kg\":\"b\",\"source\":\"src:x:2\",\"atoms\":[{\"label\":\"b1\",\"kind\":\"fact\",\"belief\":500}]}"
             + "]"
    let r = jsonr_parse_text(body, "", "")
    ce_eq("no errors",  len(jsonr_errors(r)), 0)
    ce_eq("2 records",  len(jsonr_records(r)), 2)
    ce_str_eq("first kg", cur_kg(jsonr_records(r)[0]), "a")
    ce_str_eq("second kg", cur_kg(jsonr_records(r)[1]), "b")
}

// ---- R69: schema-layer float rejection ------------------------------

fn test_float_belief_rejected_at_schema_layer() {
    // The R69 parser (src/data/json.nova) ACCEPTS floats. The schema
    // layer must reject them before they land in an int-typed slot.
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"atoms\":[{\"label\":\"y\",\"kind\":\"fact\",\"belief\":3.14}]}]"
    let r = jsonr_parse_text(body, "", "")
    let errs = jsonr_errors(r)
    ce_check("float belief error recorded", len(errs) >= 1)
    ce_check("error names belief int constraint",
             _has(errs[0][1], "belief' must be an integer"))
    ce_eq("no atom landed",
          len(cur_atoms(jsonr_records(r)[0])), 0)
}

fn test_float_weight_rejected() {
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"observations\":[{\"label\":\"a\",\"sign\":1,\"weight\":0.5}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_check("float weight error recorded",
             _has(jsonr_errors(r)[0][1], "weight' must be an integer"))
    ce_eq("no obs landed",
          len(cur_obs(jsonr_records(r)[0])), 0)
}

fn test_float_sign_rejected() {
    // sign 1.0 might round to 1; refuse it at the schema layer so
    // the wire contract stays "sign is +1 or -1 integer".
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"observations\":[{\"label\":\"a\",\"sign\":1.0,\"weight\":100}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_check("float sign refused",
             _has(jsonr_errors(r)[0][1], "sign' must be +1 or -1"))
}

fn test_exponent_notation_rejected() {
    // 1e2 = 100 as a float; parser accepts, schema rejects.
    let body = "[{\"kg\":\"k\",\"source\":\"src:x\","
             + "\"atoms\":[{\"label\":\"y\",\"kind\":\"fact\",\"belief\":1e2}]}]"
    let r = jsonr_parse_text(body, "", "")
    ce_check("exponent belief refused",
             _has(jsonr_errors(r)[0][1], "belief' must be an integer"))
}

// ---- source registry dispatch -----------------------------------------

fn test_source_registry_registers_json() {
    let reg = reg_source_new()
    reg_source_install_defaults(reg)
    let tag = reg_source_tag(reg, "json")
    ce_eq("json tag is FMT_JSON", tag, FMT_JSON)
    ce_str_eq("json name roundtrip",
              reg_source_name(FMT_JSON), "json")
    let entry = reg_source_get(reg, "json")
    ce_check("entry found", entry != 0)
    ce_str_eq("prefix", entry[SR_PREFIX], "src:json:")
}

// ---- shipped sample file ---------------------------------------------

fn test_shipped_sample_json_parses() {
    let r = jsonr_parse("data/packs/samples/climate_facts.json",
                        "climate", "src:json:climate:v1")
    let errs = jsonr_errors(r)
    ce_eq("no parse errors", len(errs), 0)
    let recs = jsonr_records(r)
    ce_check("at least 1 record", len(recs) >= 1)
    // First record should have several atoms + at least one implication.
    let r0 = recs[0]
    ce_check("record has atoms", len(cur_atoms(r0)) >= 3)
    ce_check("kg populated", len(cur_kg(r0)) > 0)
}

fn main() {
    test_full_record_all_fields_populated()
    test_kg_and_source_defaults_apply()
    test_record_own_values_override_defaults()
    test_missing_kg_no_hint_records_error_and_skips()
    test_missing_source_no_default_records_error_and_skips()
    test_lenient_bad_atom_kind_logged_others_land()
    test_kind_accepts_integer_constant()
    test_imp_strength_validation()
    test_obs_sign_validation()
    test_top_level_json_error_returned()
    test_top_level_must_be_array()
    test_multiple_records_parse()
    test_float_belief_rejected_at_schema_layer()
    test_float_weight_rejected()
    test_float_sign_rejected()
    test_exponent_notation_rejected()
    test_source_registry_registers_json()
    test_shipped_sample_json_parses()
    ce_summary("json_records")
}

main()
