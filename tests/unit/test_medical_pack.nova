// Unit tests for src/seed/packs/medical_pack.nova.
// Verifies the medical pack installs the headline labels (anatomy, symptoms,
// drug classes), creates the brief's example operators (headache -> dehydration,
// cough -> bronchitis, rash -> allergy), and tags every atom under
// `src:pack:medical` so the meta-observer can attribute it. P1.9.

import "../ce_test.nova"
import "../../src/seed/packs/medical_pack.nova"
import "../../src/util/str_safe.nova"
// imagination_kg_init (used by _setup) lives here and is NOT in the pack's
// import chain; without this NOVA silently compiles a call to a garbage address
// and the test segfaults at runtime (same class as ADR-0064).
import "../../src/parts/imagination/imagination_engine.nova"

fn _setup() {
    let reg = kg_registry_new()
    let env = list_new()
    push(env, reasoning_kg_init(reg))
    push(env, lang_kg_init(reg))
    push(env, imagination_kg_init(reg))
    push(env, mo_new())
    return env
}

// Find a reasoning operator (ROP_*) in `kg` whose premise/conclusion labels
// match the named atoms. Returns the operator atom or 0.
fn _find_op(kg, premise_name, conclusion_name) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let ops = rk_operators_from(kg, atom_id(p))
    let i = 0
    while i < len(ops) {
        if rop_conclusion(ops[i]) == atom_id(c) { return ops[i] }
        i = i + 1
    }
    return 0
}

fn test_anatomy_atoms_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    ce_check("head atom", kg_find_atom(kg, "head") != 0)
    ce_check("chest atom", kg_find_atom(kg, "chest") != 0)
    ce_check("abdomen atom", kg_find_atom(kg, "abdomen") != 0)
    ce_check("limb atom", kg_find_atom(kg, "limb") != 0)
}

fn test_symptom_atoms_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    ce_check("cough atom", kg_find_atom(kg, "cough") != 0)
    ce_check("nausea atom", kg_find_atom(kg, "nausea") != 0)
    ce_check("dizziness atom", kg_find_atom(kg, "dizziness") != 0)
    ce_check("rash atom", kg_find_atom(kg, "rash") != 0)
}

fn test_drug_class_atoms_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    ce_check("antibiotic atom", kg_find_atom(kg, "antibiotic") != 0)
    ce_check("analgesic atom", kg_find_atom(kg, "analgesic") != 0)
    ce_check("antihistamine atom", kg_find_atom(kg, "antihistamine") != 0)
    ce_check("headache atom (already in seed but re-tagged)",
             kg_find_atom(kg, "headache") != 0)
}

fn test_headache_dehydration_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "headache", "dehydration")
    ce_check("headache -> dehydration operator exists", op != 0)
}

fn test_cough_bronchitis_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "cough", "bronchitis")
    ce_check("cough -> bronchitis operator exists", op != 0)
}

fn test_rash_allergy_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "rash", "allergy")
    ce_check("rash -> allergy operator exists", op != 0)
}

fn test_lang_word_interned() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    // au_ingest interns a word in the language KG; that's the bridge
    // perception uses to look the new concept up by surface form.
    ce_check("'cough' word interned", word_find(lang, "cough") != 0)
    ce_check("'antibiotic' word interned", word_find(lang, "antibiotic") != 0)
}

fn test_install_returns_counts() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let r = pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    ce_eq("returns 2-element [atoms, ops]", len(r), 2)
    ce_check("atoms >= 30", r[0] >= 30)
    ce_check("ops >= 5", r[1] >= 5)
    ce_check("atoms <= 80", r[0] <= 80)
}

fn test_meta_observer_attribution() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_medical_with_mo(lang, kg, ikg, mo, 0)
    // After install, the meta-observer's source table must have a row
    // tagged "src:pack:medical" with at least one attributed atom.
    let report = mo_report(mo)
    let found = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:medical") == 1 { found = 1 }
        i = i + 1
    }
    // mo_report only surfaces sources that have been polled at least once;
    // we instead probe MO_SOURCES directly via the attribute side-table.
    let srcs = mo[MO_SOURCES]
    let found_src = 0
    let j = 0
    while j < len(srcs) {
        if str_eq_bytes(srcs[j][MO_MS_TAG], "src:pack:medical") == 1 { found_src = 1 }
        j = j + 1
    }
    ce_eq("meta-observer has a 'src:pack:medical' source", found_src, 1)
}

fn main() {
    test_anatomy_atoms_present()
    test_symptom_atoms_present()
    test_drug_class_atoms_present()
    test_headache_dehydration_operator()
    test_cough_bronchitis_operator()
    test_rash_allergy_operator()
    test_lang_word_interned()
    test_install_returns_counts()
    test_meta_observer_attribution()
    ce_summary("medical_pack")
}
main()
