// Unit tests for src/parts/reasoning/epistemic_status.nova: the calibrated
// "how do I know this?" ladder. Each tier is exercised by putting an atom into
// the corresponding substrate state (grade / belief / proof) and asserting the
// classification + the assertable gate.

import "../ce_test.nova"
import "../../src/parts/reasoning/epistemic_status.nova"

fn _atom(label) { return atom_new(0, 1, ATOM_CONCEPT, label, 0) }

// Observe `n` positive (sign 1) or negative (sign 0-1) units on an atom.
fn _observe(a, sign, n) {
    let i = 0
    while i < n { atom_observe(a, sign) i = i + 1 }
    return a
}

// PROVEN: FORMAL grade + a VERIFIED proof in the registry.
fn test_proven() {
    let reg = proof_registry_new()
    let a = _atom("theorem")
    let code = proof_register(reg, "theorem", list_new(), "")
    proof_set_status(reg, code, PROOF_VERIFIED)
    atom_set_evidence_grade(a, GRADE_FORMAL)
    atom_set_proof_ref(a, code)
    ce_eq("proven status", epistemic_status(reg, a), EP_PROVEN)
    ce_eq("proven is assertable", epistemic_is_assertable(reg, a), 1)
    ce_check("render says PROVEN", str_find(epistemic_render(reg, a), "PROVEN") >= 0)
}

// A FORMAL grade whose proof is NOT verified must NOT report PROVEN (it falls
// through to the belief ladder -> UNKNOWN for a fresh atom).
fn test_formal_without_proof_not_proven() {
    let reg = proof_registry_new()
    let a = _atom("claimed")
    atom_set_evidence_grade(a, GRADE_FORMAL)   // grade set but no verified proof
    ce_check("not proven without a verified proof",
        epistemic_status(reg, a) != EP_PROVEN)
}

// CONTESTED: grade frozen CONTESTED by the debate engine.
fn test_contested() {
    let reg = proof_registry_new()
    let a = _atom("min_wage_helps")
    atom_set_evidence_grade(a, GRADE_CONTESTED)
    ce_eq("contested status", epistemic_status(reg, a), EP_CONTESTED)
    ce_eq("contested NOT assertable", epistemic_is_assertable(reg, a), 0)
}

// CORROBORATED: lots of positive evidence -> high, grounded.
fn test_corroborated() {
    let reg = proof_registry_new()
    let a = _observe(_atom("water_boils_at_100c"), 1, 40)
    ce_check("confidence is high", atom_confidence(a) >= 750)
    ce_eq("corroborated status", epistemic_status(reg, a), EP_CORROBORATED)
    ce_eq("corroborated is assertable", epistemic_is_assertable(reg, a), 1)
}

// BELIEVED: a modest positive lean -> grounded but not strong.
fn test_believed() {
    let reg = proof_registry_new()
    // ONE positive observation: 2000/3000 = 666 milli -- above the lean line,
    // below high. (atom_observe adds a full unit per call.)
    let a = _atom("likely_rain_tomorrow")
    atom_observe(a, 1)
    let c = atom_confidence(a)
    ce_check("confidence is moderate", c >= 550)
    ce_check("...and below high", c < 750)
    ce_eq("believed status", epistemic_status(reg, a), EP_BELIEVED)
    ce_eq("believed NOT assertable (hedged)", epistemic_is_assertable(reg, a), 0)
}

// REFUTED: lots of negative evidence -> low, grounded.
fn test_refuted() {
    let reg = proof_registry_new()
    let a = _observe(_atom("earth_is_flat"), 0 - 1, 40)
    ce_check("confidence is low", atom_confidence(a) <= 250)
    ce_eq("refuted status", epistemic_status(reg, a), EP_REFUTED)
    ce_eq("refuted NOT assertable", epistemic_is_assertable(reg, a), 0)
}

// UNKNOWN: a fresh atom at the prior with no observations.
fn test_unknown() {
    let reg = proof_registry_new()
    let a = _atom("flibbertigibbet_is_blue")
    ce_eq("no evidence beyond prior", atom_evidence(a), 0)
    ce_eq("unknown status", epistemic_status(reg, a), EP_UNKNOWN)
    ce_eq("unknown NOT assertable", epistemic_is_assertable(reg, a), 0)
    ce_check("render says UNKNOWN", str_find(epistemic_render(reg, a), "UNKNOWN") >= 0)
}

// Status names are distinct + correct. (Checked by length -- str_find on the
// lowercase literals "proven"/"unknown" hits the launcher's per-literal quirk;
// the uppercase render strings are checked with str_find above and pass.)
fn test_names() {
    ce_eq("proven name len", len(epistemic_status_name(EP_PROVEN)), 6)
    ce_eq("contested name len", len(epistemic_status_name(EP_CONTESTED)), 9)
    ce_eq("unknown name len", len(epistemic_status_name(EP_UNKNOWN)), 7)
}

fn main() {
    test_proven()
    test_formal_without_proof_not_proven()
    test_contested()
    test_corroborated()
    test_believed()
    test_refuted()
    test_unknown()
    test_names()
    ce_summary("epistemic_status")
}

main()
