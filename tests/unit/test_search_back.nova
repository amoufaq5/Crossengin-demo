// Unit tests for src/mind/search_back.nova: backward (goal-directed) proof
// SEARCH (ADR-0088 v2). The search constructs proofs; the kernel still gates
// them. Every "found" result is confirmed by verify_check, and the load-bearing
// property is that search can never yield a false theorem -- an unprovable goal
// returns 0, and a cyclic premise set terminates rather than looping forever.

import "../ce_test.nova"
import "../../src/mind/search_back.nova"

// A premise that is already the goal is found immediately, and kernel-verifies.
fn test_sb_trivial() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let premises = list_new() push(premises, p)
    ce_check("trivial goal found", sb_prove(premises, p, 3) != 0)
    ce_eq("trivial goal kernel-verified", sb_prove_ok(reg, premises, p, 3), 1)
}

// MP chain: a->b, b->c, a |- c (backward: c <- b <- a).
fn test_sb_mp_chain() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let premises = list_new()
    push(premises, term_imp(a, b)) push(premises, term_imp(b, c)) push(premises, a)
    ce_eq("derives c via backward MP", sb_prove_ok(reg, premises, c, 5), 1)
}

// AND-intro: a, b |- (a and b).
fn test_sb_and_intro() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let premises = list_new()
    push(premises, a) push(premises, b)
    ce_eq("builds (a and b)", sb_prove_ok(reg, premises, term_and(a, b), 5), 1)
}

// AND-elim: (a and b) |- a, and |- b.
fn test_sb_and_elim() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let premises = list_new()
    push(premises, term_and(a, b))
    ce_eq("extracts a from (a and b)", sb_prove_ok(reg, premises, a, 3), 1)
    ce_eq("extracts b from (a and b)", sb_prove_ok(reg, premises, b, 3), 1)
}

// THE soundness property: an UNPROVABLE goal returns 0 -- the search never
// fabricates a proof, and sb_prove_ok agrees (nothing to kernel-verify).
fn test_sb_unprovable() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let z = term_atom("z")
    let premises = list_new() push(premises, a)
    ce_eq("unprovable goal -> no proof", sb_prove(premises, z, 5), 0)
    ce_eq("unprovable goal -> ok=0", sb_prove_ok(reg, premises, z, 5), 0)
}

// Cycle safety: a->a as the only premise, goal b. The MP branch would recurse
// on antecedent a forever without the budget guard; it must terminate and
// return 0 within a small budget.
fn test_sb_cycle_safety() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let premises = list_new()
    push(premises, term_imp(a, a))
    ce_eq("cyclic premise -> no proof (terminates)", sb_prove(premises, b, 4), 0)
    ce_eq("cyclic premise -> ok=0", sb_prove_ok(reg, premises, b, 4), 0)
}

fn main() {
    test_sb_trivial()
    test_sb_mp_chain()
    test_sb_and_intro()
    test_sb_and_elim()
    test_sb_unprovable()
    test_sb_cycle_safety()
    ce_summary("search_back")
}

main()
