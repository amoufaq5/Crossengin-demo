// CE_TEST_TIMEOUT: 240
// Unit tests for src/learning/sa4_soul.nova (SecAgg v4 soul state machine,
// A2.2a): full in-memory rounds through tests/sa4_harness.nova.
//
// - N = 5, t = 4, one soul drops after its ADV (in U1, not U2): nothing is
//   revealed about it and the aggregate covers the other four.
// Ed25519 dominates the cost (~4 ms per signature, ~8 ms per check since
// A2.3a); the shared vcache makes repeats free.

import "../ce_test.nova"
import "../sa4_harness.nova"

fn _count_prefix(lines, p) {
    return len(sa4h_filter(lines, p))
}

fn test_dropout_before_shares(vc) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, 11, vc, 0)
    let res = sa4h_run(roster, souls, 11, 4, 0 - 1)
    ce_eq("N=5 drop-before-shares completes", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("aggregate over the four", res[2], 1)
    ce_eq("nothing revealed about the soul outside U2", len(sa4h_filter(res[6], "SA4_REVEAL 11 7 4294967295 ")), 0)
    return 0
}

fn main() {
    let vc = list_new()
    test_dropout_before_shares(vc)
    ce_summary("sa4_soul_dropout2")
}

main()
