// CE_TEST_TIMEOUT: 240
// DTLS ECDSA-P256 signer: (e + r*priv) mod n must keep the carry out of
// 2^256. bn256_add drops it, and for the P-256 order n the sum of two
// values below n overflows 2^256 often, so about one ServerKeyExchange
// signature in five failed to verify (test_dtls_client_flight was flaky).
//   - _dtls_bn256_addmod_n edge cases (deterministic, no RNG);
//   - 24 sign/verify round trips with fresh keys and nonces.

import "../ce_test.nova"
import "../../src/federation/dtls12.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/p256.nova"
import "../../src/safety/ecdsa.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn test_addmod_edges() {
    let n = p256_curve_n()
    let one = bn256_from_int(1)
    let two = bn256_from_int(2)
    let nm1 = bn256_sub(n, one)
    let nm2 = bn256_sub(n, two)
    // (n-1) + (n-1) overflows 2^256; the answer is n-2.
    ce_eq("(n-1)+(n-1) mod n = n-2", bn256_cmp(_dtls_bn256_addmod_n(nm1, nm1, n), nm2), 0)
    ce_eq("(n-1)+1 mod n = 0", bn256_zero(_dtls_bn256_addmod_n(nm1, one, n)), 1)
    ce_eq("(n-1)+2 mod n = 1", bn256_cmp(_dtls_bn256_addmod_n(nm1, two, n), one), 0)
    ce_eq("1+1 mod n = 2", bn256_cmp(_dtls_bn256_addmod_n(one, one, n), two), 0)
}

fn _pub_bytes(Q) {
    let b = alloc(66)
    store8(b, 4)
    _p256_bn_to_bytes_be(Q[0], b, 1)
    _p256_bn_to_bytes_be(Q[1], b, 33)
    return b
}

fn test_sign_verify_round_trips() {
    let G = p256_base_point()
    let msg = alloc(41)
    let fails = 0
    let i = 0
    while i < 24 {
        let priv = _p256_random_scalar()
        let Q = p256_scalar_mult(priv, G[0], G[1])
        let pub = _pub_bytes(Q)
        let j = 0
        while j < 40 { store8(msg + j, int_and(i * 37 + j * 11, 255)) j = j + 1 }
        let sig = _dtls_ecdsa_p256_sign(msg, 40, priv)
        let e = _p256_bytes_to_bn(sha256_oneshot(msg, 40), 0)
        if sig == 0 {
            fails = fails + 1
        } else {
            if ecdsa_p256_verify_bn(pub, 65, e, sig[0], sig[1]) != 1 { fails = fails + 1 }
        }
        i = i + 1
    }
    ce_eq("24 DTLS signatures all verify", fails, 0)
}

fn main() {
    test_addmod_edges()
    test_sign_verify_round_trips()
    ce_summary("dtls_ecdsa_sign")
}

main()
