// Unit tests for src/parts/emotion/ocean_conditioning.nova
// Verifies neutral personality is a no-op, neuroticism amplifies arousal and
// negative valence, and extraversion raises valence. ADR-0035.

import "../ce_test.nova"
import "../../src/parts/emotion/ocean_conditioning.nova"

fn test_neutral() {
    let r = emotion_condition(500, 500, 500, 500, 500, 600, 400)
    ce_eq("neutral valence unchanged", conditioned_valence(r), 600)
    ce_eq("neutral arousal unchanged", conditioned_arousal(r), 400)
}

fn test_neuroticism() {
    // High neuroticism: valence -150, arousal +200.
    let r = emotion_condition(500, 500, 500, 500, 1000, 600, 400)
    ce_eq("neurotic valence down", conditioned_valence(r), 450)
    ce_eq("neurotic arousal up", conditioned_arousal(r), 600)
}

fn test_extraversion() {
    // High extraversion: valence +150.
    let r = emotion_condition(500, 500, 1000, 500, 500, 600, 400)
    ce_eq("extravert valence up", conditioned_valence(r), 750)
    ce_eq("extravert arousal unchanged", conditioned_arousal(r), 400)
}

fn test_clamp() {
    // Extreme inputs clamp to [0,1000].
    let r = emotion_condition(500, 500, 1000, 1000, 500, 950, 900)
    ce_check("valence clamped", conditioned_valence(r) <= 1000)
    ce_check("valence raised", conditioned_valence(r) > 950)
}

fn main() {
    test_neutral()
    test_neuroticism()
    test_extraversion()
    test_clamp()
    ce_summary("ocean_conditioning")
}

main()
