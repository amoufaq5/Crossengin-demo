    test_writer_starts_empty()
    test_writer_records_add()
    test_writer_records_three_ops()
    test_empty_round_trip()
    test_add_round_trip()
    test_mod_round_trip()
    test_del_round_trip()
    test_parse_rejects_missing_trailer()
    test_parse_rejects_bad_header()
    test_apply_add_creates_new_atom()
    test_apply_mod_updates_belief()
    test_apply_del_removes_atom()
    test_apply_skips_unknown_kg()
    test_apply_rejects_fp_mismatch()
    test_apply_accepts_matching_fp()
    test_multiple_deltas_apply_in_order()
    test_delta_path_layout()
    test_enumeration_finds_contiguous_range()
    test_enumeration_stops_at_gap()
    test_disk_round_trip_parent_only()
    test_disk_round_trip_one_delta()
    test_disk_round_trip_three_deltas()
    test_compaction_below_threshold_is_noop()
    test_compaction_collapses_deltas()
    test_schema_migration_runs_after_delta_apply()
    test_episodic_survives_delta_round_trip()
    test_make_delta_writer_stamps_fingerprint()
    ce_summary("snapshot_delta")
}
main()
