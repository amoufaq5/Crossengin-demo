// Unit tests for src/agent/tool_use.nova (P4, ADR-0054).
//
// The agentic loop: decompose -> select by competence -> gate -> invoke ->
// thread result -> learn. Covered: the acceptance 3-step plan
// (search -> compute -> write) running end-to-end with results threaded between
// steps; a failed tool call lowering its competence (via the planner) and
// changing the next selection; a gated step being denied without approval; and
// pre-simulation predicting a result.
//
// ADR-0054.

import "../ce_test.nova"
import "../../src/agent/tool_use.nova"
import "../../src/parts/episodic/moment_stream.nova"

fn _reg3() {
    let reg = tool_registry_new()
    tool_register(reg, tool_new("web_search", TOOLK_HTTP, "search", ACT_NET_FETCH, 5, "6"))
    tool_register(reg, tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, ""))
    tool_register(reg, tool_new("writer", TOOLK_FILE_WRITE, "write", ACT_WRITE_LOCAL, 2, "/tmp/ce_tool_use_out.txt"))
    return reg
}

// Acceptance 1: a 3-step plan (search -> compute -> write) end-to-end.
fn test_three_step_plan() {
    let reg = _reg3()
    let plan = plan_new()
    plan_add(plan, plan_step("search", ARG_LITERAL, "http://example/answer"))   // -> "6"
    plan_add(plan, plan_step("compute", ARG_PREV_TEXT, " * 7"))                  // "6 * 7" -> 42
    plan_add(plan, plan_step("write", ARG_PREV_TEXT, ""))                        // write "42"
    let out = plan_execute(reg, plan, 0)
    ce_eq("all three steps succeeded", plan_ok_count(out), 3)
    ce_eq("trace has three entries", len(plan_trace(out)), 3)
    ce_str_eq("result threaded + written to file",
              tr_text(file_ops_read("/tmp/ce_tool_use_out.txt")), "42")
}

// Acceptance 2a: a failing tool call (via the planner) lowers its competence.
fn test_failure_lowers_competence() {
    let reg = tool_registry_new()
    let calc = tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, "")
    tool_register(reg, calc)
    let before = tool_competence(calc)
    let plan = plan_new()
    plan_add(plan, plan_step("compute", ARG_LITERAL, "not valid math"))
    let out = plan_execute(reg, plan, 0)
    ce_eq("failing step yields no successes", plan_ok_count(out), 0)
    ce_check("the failure lowered the tool's competence", tool_competence(calc) < before)
}

// Acceptance 2b: failures change which tool gets selected next.
fn test_failure_changes_selection() {
    let reg = tool_registry_new()
    let flaky = tool_new("flaky", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, "")
    let solid = tool_new("solid", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, "")
    tool_register(reg, flaky)
    tool_register(reg, solid)
    tool_observe(flaky, 1)
    tool_observe(flaky, 1)
    tool_observe(flaky, 1)
    ce_str_eq("flaky chosen first (more competent)", tool_name(tool_select(reg, "compute")), "flaky")
    tool_observe(flaky, 0)
    tool_observe(flaky, 0)
    tool_observe(flaky, 0)
    tool_observe(flaky, 0)
    tool_observe(flaky, 0)
    ce_str_eq("after failures, solid chosen instead", tool_name(tool_select(reg, "compute")), "solid")
}

fn test_gated_step() {
    let reg = tool_registry_new()
    tool_register(reg, tool_new("emailer", TOOLK_HTTP, "send", ACT_SEND_MSG, 1, "sent"))
    let plan = plan_new()
    plan_add(plan, plan_step("send", ARG_LITERAL, "hello"))
    ce_eq("gated step denied without approval", plan_ok_count(plan_execute(reg, plan, 0)), 0)
    ce_eq("gated step runs with approval", plan_ok_count(plan_execute(reg, plan, 1)), 1)
}

fn test_presimulate() {
    let calc = tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, "")
    let pred = tool_presimulate(calc, "3 + 4")
    ce_eq("pre-simulation predicts success", tr_ok(pred), 1)
    ce_str_eq("predicted result", tr_text(pred), "7")
    // Non-deterministic backend: no local dry run, use the forward_sim seam.
    let http = tool_new("web", TOOLK_HTTP, "search", ACT_NET_FETCH, 1, "x")
    ce_eq("non-deterministic backend has no local prediction", tr_ok(tool_presimulate(http, "q")), 0)
}

// Forward-sim pre-check seam: the caller forward-simulates (here a predicted
// atom-id state) and the seam reports whether the step's effect is reachable.
fn test_presimulate_forward_seam() {
    let predicted = list_new()
    push(predicted, 7); push(predicted, 11); push(predicted, 42)
    let reach = tool_presimulate_via_fwd(predicted, 42)
    ce_eq("effect atom in predicted state -> reachable", tr_ok(reach), 1)
    ce_str_eq("reachable label", tr_text(reach), "forward-sim:reachable")
    ce_eq("effect atom absent -> unreachable", tr_ok(tool_presimulate_via_fwd(predicted, 99)), 0)
}

// ADR-0054 gap: results emitted into moment_stream, not just trace moments.
fn test_plan_execute_moments() {
    let reg = _reg3()
    let plan = plan_new()
    plan_add(plan, plan_step("search", ARG_LITERAL, "http://example/answer"))
    plan_add(plan, plan_step("compute", ARG_PREV_TEXT, " * 7"))
    plan_add(plan, plan_step("write", ARG_PREV_TEXT, ""))
    let stream = ms_new()
    let out = plan_execute_moments(reg, plan, 0, stream, 100)
    // Positions 0..2 behave exactly like plan_execute.
    ce_eq("all three steps succeeded", plan_ok_count(out), 3)
    ce_eq("trace has three entries", len(plan_trace(out)), 3)
    ce_str_eq("final threaded result text", tr_text(plan_result(out)), "wrote 2 bytes")
    // New: a real moment per result, captured into the stream.
    ce_eq("three moments returned", len(plan_moments(out)), 3)
    ce_eq("stream captured three moments", ms_count(stream), 3)
    let m0 = ms_get(stream, 0)
    ce_eq("moment modality is internal", moment_modality(m0), MODALITY_INTERNAL)
    ce_str_eq("first moment raw is the search result", moment_raw(m0), "tool:search=6")
    ce_eq("successful moment is salient", moment_salience(m0), 700)
    ce_eq("monotonic logical clock from start_ts", moment_timestamp(m0), 100)
    ce_str_eq("third moment raw is the write result", moment_raw(ms_get(stream, 2)), "tool:write=wrote 2 bytes")
}

// A failing step still emits its (low-salience) moment, then aborts.
fn test_plan_execute_moments_failure() {
    let reg = tool_registry_new()
    tool_register(reg, tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, ""))
    let plan = plan_new()
    plan_add(plan, plan_step("compute", ARG_LITERAL, "not valid math"))
    let stream = ms_new()
    let out = plan_execute_moments(reg, plan, 0, stream, 0)
    ce_eq("no successes", plan_ok_count(out), 0)
    ce_eq("the failed result still produced a moment", ms_count(stream), 1)
    ce_eq("failed moment is low-salience", moment_salience(ms_get(stream, 0)), 100)
}

fn main() {
    test_three_step_plan()
    test_failure_lowers_competence()
    test_failure_changes_selection()
    test_gated_step()
    test_presimulate()
    test_presimulate_forward_seam()
    test_plan_execute_moments()
    test_plan_execute_moments_failure()
    ce_summary("tool_use")
}

main()
