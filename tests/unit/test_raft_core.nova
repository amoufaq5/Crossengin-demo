// Unit tests for src/federation/raft_core.nova: the Raft safety properties as a
// pure state machine (NOVA-0008). These check the rules that make Raft CORRECT --
// election safety, log matching, single-vote-per-term, majority commit.

import "../ce_test.nova"
import "../../src/federation/raft_core.nova"

fn _entries(items) { return items }

// ---- RequestVote ----------------------------------------------------------
fn test_vote_granted_fresh() {
    let n = rf_new(1)
    // peer 2, term 1, empty log -> we (term 0, empty) grant.
    let r = rf_request_vote(n, 1, 2, 0, 0)
    ce_eq("granted", r[0], 1)
    ce_eq("term adopted", rf_term(n), 1)
    ce_eq("voted for 2", rf_voted_for(n), 2)
}

fn test_vote_rejects_stale_term() {
    let n = rf_new(1)
    rf_become_candidate(n)          // term 1, voted self
    rf_become_candidate(n)          // term 2
    let r = rf_request_vote(n, 1, 2, 0, 0)   // candidate term 1 < our 2
    ce_eq("stale term rejected", r[0], 0)
    ce_eq("our term unchanged", r[1], 2)
}

// One vote per term: after voting for 2, a different candidate 3 in the SAME
// term is refused.
fn test_one_vote_per_term() {
    let n = rf_new(1)
    let r1 = rf_request_vote(n, 5, 2, 0, 0)
    ce_eq("first vote granted", r1[0], 1)
    let r2 = rf_request_vote(n, 5, 3, 0, 0)   // same term, different candidate
    ce_eq("second candidate refused", r2[0], 0)
    // but re-asking the SAME candidate is idempotent (still granted).
    let r3 = rf_request_vote(n, 5, 2, 0, 0)
    ce_eq("same candidate idempotent", r3[0], 1)
}

// Election safety 5.4.1: refuse a candidate whose log is LESS up-to-date.
fn test_vote_rejects_stale_log() {
    let n = rf_new(1)
    // give us a log: index 1 @ term 2.
    rf_append_entries(n, 2, 0, 0, _entries(_one(rf_entry(2, 100))), 0)
    ce_eq("we have index 1", rf_last_index(n), 1)
    // candidate term 3 but its last log is term 1 (older) -> refuse.
    let r = rf_request_vote(n, 3, 2, 5, 1)
    ce_eq("less-up-to-date candidate refused", r[0], 0)
    // a candidate with an equal-or-newer log term IS granted (term adopted).
    let r2 = rf_request_vote(n, 3, 2, 1, 2)
    ce_eq("up-to-date candidate granted", r2[0], 1)
}

fn _one(e) { let l = list_new() push(l, e) return l }

// ---- AppendEntries --------------------------------------------------------
fn test_append_basic_and_heartbeat() {
    let n = rf_new(1)
    // append one entry at index 1 (prev_idx 0 always matches the sentinel).
    let r = rf_append_entries(n, 1, 0, 0, _one(rf_entry(1, 42)), 0)
    ce_eq("append ok", r[0], 1)
    ce_eq("log grew to 1", rf_last_index(n), 1)
    ce_eq("became follower", rf_role(n), RF_FOLLOWER)
    // heartbeat (empty entries) with matching prev succeeds + advances commit.
    let hb = rf_append_entries(n, 1, 1, 1, list_new(), 1)
    ce_eq("heartbeat ok", hb[0], 1)
    ce_eq("commit advanced to 1", rf_commit(n), 1)
}

fn test_append_rejects_stale_leader() {
    let n = rf_new(1)
    rf_become_candidate(n) rf_become_candidate(n)   // term 2
    let r = rf_append_entries(n, 1, 0, 0, list_new(), 0)   // leader term 1 < 2
    ce_eq("stale leader rejected", r[0], 0)
}

// Log Matching: a prev_idx/prev_term that doesn't match our log is rejected.
fn test_append_rejects_log_mismatch() {
    let n = rf_new(1)
    rf_append_entries(n, 1, 0, 0, _one(rf_entry(1, 1)), 0)   // index 1 @ term 1
    // claim prev_idx 1 @ term 2 -> mismatch (ours is term 1) -> reject.
    let r = rf_append_entries(n, 2, 1, 2, _one(rf_entry(2, 2)), 0)
    ce_eq("mismatch rejected", r[0], 0)
    ce_eq("log unchanged at 1", rf_last_index(n), 1)
    // prev_idx beyond our log -> reject.
    let r2 = rf_append_entries(n, 2, 5, 1, list_new(), 0)
    ce_eq("missing prev rejected", r2[0], 0)
}

// Conflicting suffix is truncated and replaced.
fn test_append_truncates_conflict() {
    let n = rf_new(1)
    // build log: idx1@t1, idx2@t1, idx3@t1.
    let three = list_new()
    push(three, rf_entry(1, 10)) push(three, rf_entry(1, 20)) push(three, rf_entry(1, 30))
    rf_append_entries(n, 1, 0, 0, three, 0)
    ce_eq("three entries", rf_last_index(n), 3)
    // a new leader (term 2) sends from prev_idx 1: idx2@t2 -- conflicts with our
    // idx2@t1 -> truncate idx2..3 and append the new one.
    let r = rf_append_entries(n, 2, 1, 1, _one(rf_entry(2, 99)), 0)
    ce_eq("append ok", r[0], 1)
    ce_eq("log now length 2 (idx1 kept, idx2 replaced)", rf_last_index(n), 2)
    ce_eq("idx2 is now term 2", rf_log_term(n, 2), 2)
    ce_eq("idx1 untouched (term 1)", rf_log_term(n, 1), 1)
}

// Idempotent re-delivery: re-sending entries we already have changes nothing.
fn test_append_idempotent() {
    let n = rf_new(1)
    rf_append_entries(n, 1, 0, 0, _one(rf_entry(1, 7)), 0)
    rf_append_entries(n, 1, 0, 0, _one(rf_entry(1, 7)), 0)   // same again
    ce_eq("no duplication", rf_last_index(n), 1)
}

// ---- majority commit ------------------------------------------------------
fn test_majority_index() {
    // 5 nodes, match indexes [5,4,3,2,1]: majority (3) have index >= 3 -> 3.
    let m = list_new()
    push(m, 5) push(m, 4) push(m, 3) push(m, 2) push(m, 1)
    ce_eq("majority index 3", rf_majority_index(m), 3)
    // 3 nodes all at 7 -> 7.
    let m2 = list_new() push(m2, 7) push(m2, 7) push(m2, 7)
    ce_eq("unanimous 7", rf_majority_index(m2), 7)
    // 3 nodes [9,0,0]: only 1 has >=9, no majority -> highest with majority is 0.
    let m3 = list_new() push(m3, 9) push(m3, 0) push(m3, 0)
    ce_eq("no majority above 0", rf_majority_index(m3), 0)
}

// ---- term transitions -----------------------------------------------------
fn test_become_candidate_and_step_down() {
    let n = rf_new(1)
    let t = rf_become_candidate(n)
    ce_eq("term incremented", t, 1)
    ce_eq("role candidate", rf_role(n), RF_CANDIDATE)
    ce_eq("self-voted", rf_voted_for(n), 1)
    // seeing a higher term in any RPC steps us down.
    let r = rf_request_vote(n, 9, 2, 0, 0)
    ce_eq("granted to higher term", r[0], 1)
    ce_eq("stepped down to follower", rf_role(n), RF_FOLLOWER)
    ce_eq("term now 9", rf_term(n), 9)
}

fn main() {
    test_vote_granted_fresh()
    test_vote_rejects_stale_term()
    test_one_vote_per_term()
    test_vote_rejects_stale_log()
    test_append_basic_and_heartbeat()
    test_append_rejects_stale_leader()
    test_append_rejects_log_mismatch()
    test_append_truncates_conflict()
    test_append_idempotent()
    test_majority_index()
    test_become_candidate_and_step_down()
    ce_summary("raft_core")
}

main()
