// Unit tests for pipeline auto-registration of capsules (R45p2).
// Verifies pip_ingest_with_capreg correctly:
//   * registers a capsule from record metadata
//   * claims every atom seeded/seen for that capsule (idempotent)
//   * populates status.PIP_CAPSULE_NAME and status.PIP_CAPSULE_CLAIMED
//   * is a no-op vs pip_ingest when capreg=0
//   * atoms are shareable: two capsules can both claim the same atom

import "../ce_test.nova"
import "../../src/ingest/pipeline.nova"
import "../../src/capsules/capsule_registry.nova"

fn _mk_capsule_record(cap_name, ver, kg_name, atoms_labels) {
    let r = cur_new(kg_name, "src:cap:" + cap_name + ":v" + ver)
    cur_set_capsule(r, cap_name, ver, "test capsule", "MIT")
    let i = 0
    while i < len(atoms_labels) {
        cur_add_atom(r, atoms_labels[i], ATOM_FACT, 800)
        i = i + 1
    }
    return r
}

fn test_pip_ingest_still_works_with_zero_capreg() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let r = _mk_capsule_record("medicine", "1.0.0", "med",
        _mk_labels("aspirin"))
    // legacy pip_ingest -> no capsule registration
    let s = pip_ingest(reg, r, mo)
    ce_eq("ok", pip_ok(s), 1)
    ce_eq("atoms added 1", pip_atoms_added(s), 1)
    ce_eq("capsule name empty (no capreg)", pip_capsule_name(s), "")
    ce_eq("capsule claimed 0", pip_capsule_claimed(s), 0)
}

fn _mk_labels(a) {
    let l = list_new() push(l, a) return l
}

fn test_pip_ingest_with_capreg_registers_capsule() {
    let reg = kg_registry_new()
    let mo = mo_new()
    let capreg = capreg_new()
    let labels = list_new() push(labels, "aspirin") push(labels, "ibuprofen")
    let r = _mk_capsule_record("medicine", "1.0.0", "med", labels)
    let s = pip_ingest_with_capreg(reg, r, mo, capreg)
    ce_eq("ok", pip_ok(s), 1)
    ce_eq("2 atoms added", pip_atoms_added(s), 2)
    ce_eq("capsule name in status", pip_capsule_name(s), "medicine")
    ce_eq("2 atoms claimed", pip_capsule_claimed(s), 2)
    ce_eq("registry has 1 capsule", capreg_count(capreg), 1)
    let cap = capreg_lookup(capreg, "medicine")
    ce_check("capsule found", cap != 0)
    ce_eq("capsule has 2 atoms", capsule_atom_count(cap), 2)
    ce_eq("capsule version", capsule_version(cap), "1.0.0")
    ce_eq("capsule license", capsule_license(cap), "MIT")
}

fn test_pip_ingest_capsule_dep_added() {
    let reg = kg_registry_new()
    let capreg = capreg_new()
    let r = cur_new("med", "src:cap:medicine:v1.0.0")
    cur_set_capsule(r, "medicine", "1.0.0", "d", "MIT")
    cur_add_capsule_dep(r, "biology", "1.0.0")
    cur_add_capsule_dep(r, "chemistry", "0.9.0")
    cur_add_atom(r, "aspirin", ATOM_FACT, 800)
    pip_ingest_with_capreg(reg, r, 0, capreg)
    let cap = capreg_lookup(capreg, "medicine")
    ce_eq("2 deps registered", capsule_dep_count(cap), 2)
}

fn test_pip_ingest_reingest_is_idempotent_on_capsule() {
    let reg = kg_registry_new()
    let capreg = capreg_new()
    let labels = list_new() push(labels, "a") push(labels, "b")
    let r1 = _mk_capsule_record("med", "1.0.0", "med", labels)
    let s1 = pip_ingest_with_capreg(reg, r1, 0, capreg)
    ce_eq("first pass claims 2", pip_capsule_claimed(s1), 2)
    let r2 = _mk_capsule_record("med", "1.0.0", "med", labels)
    let s2 = pip_ingest_with_capreg(reg, r2, 0, capreg)
    ce_eq("second pass claims 0", pip_capsule_claimed(s2), 0)
    ce_eq("registry still has 1 capsule", capreg_count(capreg), 1)
    ce_eq("capsule still has 2 atoms",
          capsule_atom_count(capreg_lookup(capreg, "med")), 2)
}

fn test_shareable_atom_across_two_capsules() {
    // Both biology and medicine claim "mitochondria" -- the same atom in
    // one KG belongs to both capsules simultaneously.
    let reg = kg_registry_new()
    let capreg = capreg_new()
    let bio = _mk_capsule_record("biology", "1.0.0", "shared_kg",
        _mk_labels("mitochondria"))
    let med = _mk_capsule_record("medicine", "1.0.0", "shared_kg",
        _mk_labels("mitochondria"))
    pip_ingest_with_capreg(reg, bio, 0, capreg)
    pip_ingest_with_capreg(reg, med, 0, capreg)
    ce_eq("2 capsules registered", capreg_count(capreg), 2)
    let cbio = capreg_lookup(capreg, "biology")
    let cmed = capreg_lookup(capreg, "medicine")
    ce_eq("bio claims 1 atom", capsule_atom_count(cbio), 1)
    ce_eq("med claims 1 atom", capsule_atom_count(cmed), 1)
    // The same atom_id in the KG appears in both capsules.
    let bio_atoms = capsule_atom_refs(cbio)
    let med_atoms = capsule_atom_refs(cmed)
    ce_eq("same atom_id shared", bio_atoms[0], med_atoms[0])
    // capreg_capsules_owning_atom should return both.
    let owners = capreg_capsules_owning_atom(capreg, bio_atoms[0])
    ce_eq("2 capsules own the shared atom", len(owners), 2)
}

fn test_non_capsule_record_leaves_registry_alone() {
    let reg = kg_registry_new()
    let capreg = capreg_new()
    let r = cur_new("plainkg", "src:manual")
    cur_add_atom(r, "plain_atom", ATOM_FACT, 800)
    let s = pip_ingest_with_capreg(reg, r, 0, capreg)
    ce_eq("ok", pip_ok(s), 1)
    ce_eq("no capsule name", pip_capsule_name(s), "")
    ce_eq("0 atoms claimed", pip_capsule_claimed(s), 0)
    ce_eq("registry still empty", capreg_count(capreg), 0)
}

fn test_empirical_imp_association_atom_also_claimed() {
    let reg = kg_registry_new()
    let capreg = capreg_new()
    let r = cur_new("k", "src:cap:x:v1")
    cur_set_capsule(r, "x", "1.0.0", "d", "MIT")
    cur_add_atom(r, "a", ATOM_FACT, 800)
    cur_add_atom(r, "b", ATOM_FACT, 800)
    cur_add_imp(r, "a", "b", "EMPIRICAL")
    pip_ingest_with_capreg(reg, r, 0, capreg)
    let cap = capreg_lookup(capreg, "x")
    // 2 primary atoms + 1 association atom = 3 total claimed.
    ce_eq("3 atoms claimed (2 + association)", capsule_atom_count(cap), 3)
}

fn main() {
    test_pip_ingest_still_works_with_zero_capreg()
    test_pip_ingest_with_capreg_registers_capsule()
    test_pip_ingest_capsule_dep_added()
    test_pip_ingest_reingest_is_idempotent_on_capsule()
    test_shareable_atom_across_two_capsules()
    test_non_capsule_record_leaves_registry_alone()
    test_empirical_imp_association_atom_also_claimed()
    ce_summary("ingest_pipeline_capsule")
}

main()
