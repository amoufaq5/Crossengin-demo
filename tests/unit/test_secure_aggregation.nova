// ---- local parsers -------------------------------------------------------

fn test_sa_parse_peer_line() {
    let r = sa_parse_peer_line("SECAGG_PEER bob secret-ab")
    ce_check("parse peer non-zero", r != 0)
    ce_eq("peer ev type", r[SECAGG_R_TYPE], SECAGG_EV_PEER)
    ce_str_eq("peer id", r[SECAGG_R_PEER_ID], "bob")
    ce_str_eq("peer token", r[SECAGG_R_TOKEN], "secret-ab")
}

fn test_sa_parse_stat_masked_line() {
    let r = sa_parse_stat_masked_line("FED_STAT_MASKED 7 topic:fever 150 60")
    ce_check("parse stat_masked non-zero", r != 0)
    ce_eq("ev type", r[SECAGG_R_TYPE], SECAGG_EV_STAT_MASKED)
    ce_eq("round id", r[SECAGG_R_ROUND], 7)
    ce_str_eq("tag", r[SECAGG_R_TAG], "topic:fever")
    ce_eq("masked promo", r[SECAGG_R_PROMO], 150)
    ce_eq("masked atr", r[SECAGG_R_ATR], 60)
}

fn test_sa_parse_aggregate_sum_line() {
    let r = sa_parse_aggregate_sum_line(
        "FED_AGGREGATE_SUM 5 topic:fever 800 100 3")
    ce_check("parse agg_sum non-zero", r != 0)
    ce_eq("ev type", r[SECAGG_R_TYPE], SECAGG_EV_AGG_SUM)
    ce_eq("round id", r[SECAGG_R_ROUND], 5)
    ce_str_eq("tag", r[SECAGG_R_TAG], "topic:fever")
    ce_eq("sum promo", r[SECAGG_R_PROMO], 800)
    ce_eq("sum atr", r[SECAGG_R_ATR], 100)
    ce_eq("n_part", r[SECAGG_R_NPART], 3)
}

fn test_sa_parse_stat_masked_accepts_negative() {
    // Masked values can be negative (after a sign-flipped mask
    // subtraction). The parser must accept '-' as a leading char.
    let r = sa_parse_stat_masked_line("FED_STAT_MASKED 1 topic:test -42 -7")
    ce_check("parse negative-masked non-zero", r != 0)
    ce_eq("negative promo", r[SECAGG_R_PROMO], 0 - 42)
    ce_eq("negative atr", r[SECAGG_R_ATR], 0 - 7)
}

fn test_sa_parse_line_dispatch() {
    let r1 = sa_parse_line("SECAGG_HELLO ce-fed v2-sa")
    ce_check("dispatch HELLO", r1 != 0)
    ce_eq("HELLO type", r1[SECAGG_R_TYPE], SECAGG_EV_HELLO)
    let r2 = sa_parse_line("SECAGG_PEER bob secret")
    ce_eq("dispatch PEER", r2[SECAGG_R_TYPE], SECAGG_EV_PEER)
    let r3 = sa_parse_line("FED_STAT_MASKED 1 t 10 20")
    ce_eq("dispatch STAT_MASKED", r3[SECAGG_R_TYPE], SECAGG_EV_STAT_MASKED)
    let r4 = sa_parse_line("FED_AGGREGATE_SUM 1 t 10 20 2")
    ce_eq("dispatch AGG_SUM", r4[SECAGG_R_TYPE], SECAGG_EV_AGG_SUM)
}

fn test_sa_parse_line_rejects_garbage() {
    let r = sa_parse_line("GARBAGE here")
    ce_eq("garbage -> 0", r, 0)
}

