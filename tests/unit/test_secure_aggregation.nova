fn test_sa_parse_recon_masked_accepts_negative() {
    // Reconciled values can be negative when the dropped peer's mask
    // exceeded the raw value (the residual flips sign).
    let r = sa_parse_recon_masked_line(
        "FED_RECON_MASKED 1 alice topic:test -42 -7")
    ce_check("parse negative recon non-zero", r != 0)
    ce_eq("negative recon promo", r[SECAGG_R_RECON_PROMO], 0 - 42)
    ce_eq("negative recon atr", r[SECAGG_R_RECON_ATR], 0 - 7)
}

fn test_sa_parse_line_dispatches_new_events() {
    let rd = sa_parse_line("FED_DROPOUT 1 bob")
    ce_eq("dispatch DROPOUT", rd[SECAGG_R_TYPE], SECAGG_EV_DROPOUT)
    let rr = sa_parse_line("FED_RECON_MASKED 1 alice t 10 20")
    ce_eq("dispatch RECON_MASKED", rr[SECAGG_R_TYPE], SECAGG_EV_RECON_MASKED)
}

