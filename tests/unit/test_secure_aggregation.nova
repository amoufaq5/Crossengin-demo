    ce_str_eq("recon masked line", s,
        "FED_RECON_MASKED 3 alice topic:fever 50 20\n")
}

fn test_sa_parse_dropout_line() {
    let r = sa_parse_dropout_line("FED_DROPOUT 3 bob")
    ce_check("parse dropout non-zero", r != 0)
    ce_eq("dropout ev type", r[SECAGG_R_TYPE], SECAGG_EV_DROPOUT)
    ce_eq("dropout round id", r[SECAGG_R_ROUND], 3)
