    let s = sa_format_peer_line("bob", "secret-ab")
    ce_str_eq("peer line", s, "SECAGG_PEER bob secret-ab\n")
}

fn test_sa_format_stat_masked_line() {
    let s = sa_format_stat_masked_line(7, "topic:fever", 150, 60)
    ce_str_eq("masked stat", s, "FED_STAT_MASKED 7 topic:fever 150 60\n")
}

