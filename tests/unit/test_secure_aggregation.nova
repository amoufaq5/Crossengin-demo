fn test_sa_dh_enabled_from_env_default() {
    // CE_SECAGG_DH unset -> 0 (default off, backwards-compat with v2-sa).
    let v = sa_dh_enabled_from_env()
    ce_eq("default off (env not set)", v, 0)
}

// Register-DH idempotency: a second call with the same peer_id updates
// the pubkey rather than appending a new row.
fn test_sa_register_peer_dh_idempotent() {
    let sa = sa_state_new("alice")
    let r1 = sa_register_peer_dh(sa, "bob", "aaaa")
    ce_eq("first DH-register returns 1", r1, 1)
    ce_eq("peer count = 1", sa_peer_count(sa), 1)
    let r2 = sa_register_peer_dh(sa, "bob", "bbbb")
    ce_eq("re-register returns 0 (idempotent)", r2, 0)
    ce_eq("peer count still 1", sa_peer_count(sa), 1)
    ce_str_eq("pubkey was refreshed", sa_pubkey_for_peer(sa, "bob"), "bbbb")
}

