// ---- P3.9 DH key-agreement tests ----------------------------------------
//
// CORE smoke (the brief's CHECK): a 2-soul DH round derives MATCHING
// pairwise masks on both ends. This is the equivalence between the
// pre-shared-token path and the DH path: as long as both sides derive
// the same shared secret, the existing LCG mask derivation produces
// matching masks and the cancellation invariant still holds.
//
// Each `bn_modpow_ct` call at 256-bit modulus is ~50 ms wall-clock in
// the dev sandbox. The 2-soul DH round needs:
//   - 2 keygens (each: 1 modpow_ct -> g^priv mod p)
//   - 2 shared secret derivations (each: 1 modpow_ct -> peer_pub^priv mod p)
//   - 2 sa_mask_for_peer calls (which each internally call
//     sa_dh_shared_secret_for_peer -> 1 modpow_ct)
// That's ~6 modpow_ct = ~300 ms wall-clock per test. We keep the test
// surface tight (one demo) to stay well under the harness's budget.

fn test_sa_dh_keygen_produces_valid_pair() {
    let sa = sa_state_new("alice")
    let pub_hex = sa_dh_generate_keys(sa)
    ce_eq("DH mode is set after keygen", sa_dh_mode(sa), 1)
    ce_check("DH private is set", sa_dh_private(sa) != 0)
    ce_check("DH public is set", sa_dh_public(sa) != 0)
    // Public key hex returned matches the stored slot.
    ce_str_eq("returned pub matches stored", pub_hex, sa_dh_public(sa))
    // Hex strings are 64 chars (canonical bn_to_hex output).
    ce_eq("private hex length = 64", len(sa_dh_private(sa)), 64)
    ce_eq("public hex length = 64",  len(pub_hex), 64)
    // Public key is non-zero (g^d for any d > 0 produces non-zero in the
    // Curve25519 field; if priv landed at 0 the loop would be no-op but
    // bn_mod always produces a value in [0, p), and 0 -> g^0 = 1).
    let pub_bn = bn_from_hex(pub_hex)
    ce_check("pub is non-zero", bn_zero(pub_bn) != 1)
}

// CORE BRIEF CHECK: 2-soul DH-derived pairwise masks MATCH.
// Alice generates (priv_A, pub_A). Bob generates (priv_B, pub_B).
// Alice registers Bob's pub via sa_register_peer_dh. Bob registers
// Alice's pub via sa_register_peer_dh. Both compute the shared secret
// for the peer; both derive a mask for (peer, round, k_dim=0). Both
// masks MUST be equal -- that's the DH commutativity property that
// preserves the SecAgg cancellation invariant when DH replaces the
// pre-shared token.
fn test_sa_dh_two_soul_pair_mask_matches() {
    let sa_a = sa_state_new("alice")
    let pub_a = sa_dh_generate_keys(sa_a)
    let sa_b = sa_state_new("bob")
    let pub_b = sa_dh_generate_keys(sa_b)
    // Exchange pubkeys: alice learns bob's pub, bob learns alice's pub.
    sa_register_peer_dh(sa_a, "bob", pub_b)
    sa_register_peer_dh(sa_b, "alice", pub_a)
    // Shared secret derivation: each side computes peer_pub^my_priv.
    // By DH commutativity (g^a)^b == (g^b)^a mod p, so both equal g^(ab).
    let shared_from_a = sa_dh_shared_secret_for_peer(sa_a, "bob")
    let shared_from_b = sa_dh_shared_secret_for_peer(sa_b, "alice")
    ce_check("shared_from_a non-zero", shared_from_a != 0)
    ce_check("shared_from_b non-zero", shared_from_b != 0)
    // CRITICAL: the two sides must derive the SAME shared secret.
    ce_str_eq("DH shared secret matches (a == b)",
        shared_from_a, shared_from_b)
    // And the mask derived for the pair (which feeds the shared secret
    // into the existing LCG) must also match between the two sides.
    sa_round_set(sa_a, 1)
    sa_round_set(sa_b, 1)
    let mask_from_a = sa_mask_for_peer(sa_a, "bob", 1, 0)
    let mask_from_b = sa_mask_for_peer(sa_b, "alice", 1, 0)
    ce_eq("DH-derived mask matches (a == b)", mask_from_a, mask_from_b)
    // Mask is non-zero (so the masking is actually doing something).
    ce_check("DH-derived mask is positive", mask_from_a > 0)
}

// 2-soul DH demo: full end-to-end equivalent of `test_secagg_two_soul_sum_demo`
// but using DH-derived shared secrets instead of pre-shared tokens.
// x_A=100, x_B=200; coordinator's sum must equal 300 because the
// DH-derived masks cancel pairwise just like the token-derived ones.
fn test_secagg_two_soul_dh_sum_demo() {
    let sa_a = sa_state_new("alice")
    let pub_a = sa_dh_generate_keys(sa_a)
    let sa_b = sa_state_new("bob")
    let pub_b = sa_dh_generate_keys(sa_b)
    sa_register_peer_dh(sa_a, "bob", pub_b)
    sa_register_peer_dh(sa_b, "alice", pub_a)
    sa_round_set(sa_a, 1)
    sa_round_set(sa_b, 1)
    let x_a = 100
    let x_b = 200
    let masked_a = sa_apply_masks(sa_a, x_a, 0)
    let masked_b = sa_apply_masks(sa_b, x_b, 0)
    // The masked values must NOT equal the raw values (mask is non-zero).
    ce_check("DH: masked_a != x_a", masked_a != x_a)
    ce_check("DH: masked_b != x_b", masked_b != x_b)
    // Run the coordinator-side sum.
    let acc = sa_acc_new(1)
    sa_acc_add_masked(acc, "topic:test", masked_a, 0)
    sa_acc_add_masked(acc, "topic:test", masked_b, 0)
    let sums = sa_acc_sums(acc)
    ce_eq("DH: one source row in accumulator", len(sums), 1)
    let sum_row = sums[0]
    // CRITICAL: the DH-derived masks cancel and the sum equals x_a + x_b.
    ce_eq("DH: sum equals x_a + x_b (masks canceled)", sum_row[1], x_a + x_b)
    ce_eq("DH: sum equals 300 (brief's expected)", sum_row[1], 300)
    ce_eq("DH: n_participants = 2", sum_row[3], 2)
}

