fn test_sa_parse_recon_masked_line() {
    let r = sa_parse_recon_masked_line(
        "FED_RECON_MASKED 3 alice topic:fever 50 20")
    ce_check("parse recon non-zero", r != 0)
    ce_eq("recon ev type", r[SECAGG_R_TYPE], SECAGG_EV_RECON_MASKED)
    ce_eq("recon round id", r[SECAGG_R_ROUND], 3)
