// ---- mask robustness: hash determinism + LCG step independence ---------

fn test_sa_hash_determinism() {
    // Same token + round -> same seed every time.
    let s1 = _sa_seed_for_pair("token-x", 5)
    let s2 = _sa_seed_for_pair("token-x", 5)
    ce_eq("seed deterministic", s1, s2)
    let s3 = _sa_seed_for_pair("token-y", 5)
    ce_check("different token -> different seed", s1 != s3)
}

fn test_sa_lcg_step_distribution() {
    // 10 successive steps from a fixed seed produce 10 distinct values
    // (the LCG has period > 10 with a good seed).
    let seed = _sa_hash_str("test")
    let cur = seed
    let seen = list_new()
    let i = 0
    while i < 10 {
        cur = _sa_lcg_step(cur)
        push(seen, cur)
        i = i + 1
    }
    // Count uniques by O(n^2) compare (n=10).
    let unique_n = 0
    let j = 0
    while j < len(seen) {
        let dup = 0
        let k = 0
        while k < j {
            if seen[j] == seen[k] { dup = 1 }
            k = k + 1
        }
        if dup == 0 { unique_n = unique_n + 1 }
        j = j + 1
    }
    // Allow some collisions on a 15-bit space, but expect mostly unique.
    ce_check("10 LCG steps have at least 8 unique values", unique_n >= 8)
}

// ---- P3.8r dropout-resilience tests --------------------------------------

// CORE 3-soul dropout demo (the brief's GOAL check). Souls A, B, C all
// share pairwise tokens; A=50, B=100, C=150. Total expected: 300. If B
// drops mid-round, the coordinator's view of the SHRUNK set should be
// A + C = 200 (NOT 300, NOT a garbage value). The mask cancellation
// across the surviving pair A <-> C still holds; B's pairwise mask
// contributions are removed by A and C reconciling.
fn test_secagg_three_soul_dropout_demo() {
    let sa_a = sa_state_new("alice")
    sa_register_peer(sa_a, "bob",   "tok-ab")
    sa_register_peer(sa_a, "carol", "tok-ac")
    sa_round_set(sa_a, 7)
    let sa_b = sa_state_new("bob")
    sa_register_peer(sa_b, "alice", "tok-ab")
    sa_register_peer(sa_b, "carol", "tok-bc")
    sa_round_set(sa_b, 7)
    let sa_c = sa_state_new("carol")
    sa_register_peer(sa_c, "alice", "tok-ac")
    sa_register_peer(sa_c, "bob",   "tok-bc")
    sa_round_set(sa_c, 7)

    let x_a = 50
    let x_b = 100
    let x_c = 150

    // Step 1: every soul masks normally and "sends" its FED_STAT_MASKED.
    let m_a = sa_apply_masks(sa_a, x_a, 0)
    let m_b = sa_apply_masks(sa_b, x_b, 0)
    let m_c = sa_apply_masks(sa_c, x_c, 0)

    // Sanity: if B simply vanishes without reconciliation, the
    // surviving sum m_a + m_c is NOT equal to x_a + x_c (because the
    // m_AB / m_BC mask contributions are still on A and C's submissions
    // and don't cancel anywhere). This is the documented P3.8 failure
    // mode the dropout-resilience path fixes.
    let unreconciled_sum = m_a + m_c
    ce_check("unreconciled drop leaves garbage sum",
        unreconciled_sum != x_a + x_c)

    // Step 2: B drops -> A and C reconcile by subtracting B's mask
    // contribution from each of their submissions.
    let adj_a = sa_reconcile_for_dropped(sa_a, m_a, "bob", 0)
    let adj_c = sa_reconcile_for_dropped(sa_c, m_c, "bob", 0)

    // Step 3: the coordinator sums the RECONCILED submissions. The
    // m_AC pair still cancels (A and C are both alive); the residual
    // is exactly x_a + x_c = 200.
    let acc = sa_acc_new(7)
    sa_acc_add_masked(acc, "topic:test", adj_a, 0)
    sa_acc_add_masked(acc, "topic:test", adj_c, 0)
    let sums = sa_acc_sums(acc)
    ce_eq("reconciled sum row count = 1", len(sums), 1)
    ce_eq("reconciled sum = x_a + x_c (200)", sums[0][1], x_a + x_c)
    ce_eq("reconciled sum equals 200 (brief's expected)", sums[0][1], 200)
    ce_eq("n_part = 2 (B excluded)", sums[0][3], 2)
}

// sa_recompute_without is DETERMINISTIC -- the same SA state +
// dropped_id + k_dim always returns the same signed mask. The whole
// reconciliation correctness relies on this LCG determinism property
// (the brief calls it out in NOVA gotchas).
fn test_sa_recompute_without_determinism() {
    let sa_a = sa_state_new("alice")
    sa_register_peer(sa_a, "bob", "tok-ab")
    sa_round_set(sa_a, 3)
    let d1 = sa_recompute_without(sa_a, "bob", 0)
    let d2 = sa_recompute_without(sa_a, "bob", 0)
    ce_eq("recompute_without is deterministic", d1, d2)
    // alice < bob -> alice ADDED +m_AB -> delta is +m_AB (positive)
    ce_check("delta > 0 when soul_id < dropped_id", d1 > 0)
}

// sa_recompute_without follows the sign convention: smaller id ADDS
// the mask, larger id SUBTRACTS it. So when bob (larger) reconciles
// against alice (smaller and dropped), the returned delta should be
// NEGATIVE (the mask was already subtracted, so we add it back =
// subtract a negative).
fn test_sa_recompute_without_sign() {
    let sa_b = sa_state_new("bob")
    sa_register_peer(sa_b, "alice", "tok-ab")
    sa_round_set(sa_b, 3)
    let d = sa_recompute_without(sa_b, "alice", 0)
    ce_check("delta < 0 when soul_id > dropped_id", d < 0)
    // Pair-symmetric: |d_from_a_pov| == |d_from_b_pov| (same token,
    // same round, same dim -> same mask magnitude on both sides).
    let sa_a = sa_state_new("alice")
    sa_register_peer(sa_a, "bob", "tok-ab")
    sa_round_set(sa_a, 3)
    let d_a = sa_recompute_without(sa_a, "bob", 0)
    let neg_d = 0 - d
    ce_eq("pair-symmetric magnitude (sign-mirrored)", d_a, neg_d)
}

// sa_recompute_without returns 0 for non-peer / self / no-token.
fn test_sa_recompute_without_unknown_peer() {
    let sa = sa_state_new("alice")
    sa_register_peer(sa, "bob", "tok-ab")
    sa_round_set(sa, 3)
    let d_ghost = sa_recompute_without(sa, "ghost", 0)
    ce_eq("unknown peer -> 0 delta", d_ghost, 0)
    let d_self = sa_recompute_without(sa, "alice", 0)
    ce_eq("self -> 0 delta", d_self, 0)
}

// sa_reconcile_for_dropped composes recompute_without + subtraction.
fn test_sa_reconcile_for_dropped_arithmetic() {
    let sa_a = sa_state_new("alice")
    sa_register_peer(sa_a, "bob", "tok-ab")
    sa_round_set(sa_a, 3)
    let m = sa_apply_masks(sa_a, 100, 0)
    let adj = sa_reconcile_for_dropped(sa_a, m, "bob", 0)
    // For a single peer that drops, the adjusted value must equal
    // the raw x (the entire mask contribution from bob just got
    // removed; alice has no other peers).
    ce_eq("single-peer dropout -> adjusted = raw x", adj, 100)
}

// sa_reconcile_for_dropped_pair handles BOTH stat dims independently.
fn test_sa_reconcile_for_dropped_pair_both_dims() {
    let sa_a = sa_state_new("alice")
    sa_register_peer(sa_a, "bob", "tok-ab")
    sa_round_set(sa_a, 4)
    let masked = sa_apply_masks_pair(sa_a, 100, 200)
    let adj = sa_reconcile_for_dropped_pair(sa_a, masked[0], masked[1], "bob")
    ce_eq("pair recon: promo dim restored", adj[0], 100)
    ce_eq("pair recon: atr dim restored", adj[1], 200)
}

