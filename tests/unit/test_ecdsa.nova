// Unit tests for src/safety/ecdsa.nova (ECDSA-P-256 verify + SHA-256).
//
// Coverage
//   * SHA-256 known-answer vectors (FIPS 180-4 Appendix B.1 + B.2):
//       SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223
//                        b00361a396177a9cb410ff61f20015ad
//       SHA-256("") = e3b0c44298fc1c149afbf4c8996fb924
//                     27ae41e4649b934ca495991b7852b855
//       SHA-256("abcdbcdecdefdefgefghfghighijhijk...nopqlmnopnopq") =
//                     248d6a61d20638b8e5c026930c3e6039
//                     a33ce45964ff2167f6ecedd419db06c1
//   * ECDSA-P-256 verify against RFC 6979 §A.2.5 deterministic vector:
//     priv = C9AFA9D845BA75166B5C215767B1D6934E50C3DB36E89B127B8A622B120F6721
//     pub Q = (60FED4BA255A9D31C961EB74C6356D68C049B8923B61FA6CE669622E60F29FB6,
//              7903FE1008B8BC99A41AE9E95628BC64F2F1B20C2D7E9F5177A3C294D4462299)
//     msg = "sample"
//     hash = AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF
//     r = EFD48B2AACB6A8FD1140DD9CD45E81D69D2C877B56AAF991C34D0EA84EAF3716
//     s = F7CB1C942D657C41D436C7A1B6E29F65F3E900DBB9AFF4064DC4AB2F843ACDA8
//   * Tampered signature (r flip, s flip) -> verify returns 0.
//   * Tampered message -> verify returns 0.
//   * Wrong public key -> verify returns 0.
//   * Range checks: r == 0, s == 0, r >= n, s >= n all reject without
//     reaching curve math.
//   * Bad-shape public-key buffer (truncated, wrong tag) -> 0.
//
// References:
//   FIPS 186-4 §6.4 -- ECDSA verify recipe.
//   RFC 6979 §A.2.5 -- canonical deterministic test vectors for the
//                       P-256 + SHA-256 combination, replicated in
//                       countless independent implementations.
//   FIPS 180-4      -- SHA-256.

import "std/io"
import "../ce_test.nova"
import "../../src/safety/ecdsa.nova"

// ---- helpers --------------------------------------------------------------

// Hex decode helper from p256 (transitively imported).
fn _t_hex(s) {
    return p256_hex_decode(s)
}

// Compare two bn256 by hex.
fn _t_bn_hex(bn) {
    return bn256_to_hex(bn)
}

// Allocate a 32-byte buffer for a hex-encoded big-endian integer.
fn _t_be32_from_hex(hex_str) {
    let p = p256_hex_decode(hex_str)
    return p[0]
}

// ---- SHA-256 vectors ------------------------------------------------------

fn test_sha256_abc() {
    let buf = alloc(4)
    store8(buf + 0, 97)   // 'a'
    store8(buf + 1, 98)   // 'b'
    store8(buf + 2, 99)   // 'c'
    store8(buf + 3, 0)
    let h = ecdsa_sha256(buf, 3)
    let got = p256_hex_encode_buf(h, 32)
    ce_str_eq("SHA-256('abc')",
        got,
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

fn test_sha256_empty() {
    let buf = alloc(1)
    store8(buf, 0)
    let h = ecdsa_sha256(buf, 0)
    let got = p256_hex_encode_buf(h, 32)
    ce_str_eq("SHA-256('')",
        got,
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}

fn test_sha256_fips_appendix_b2() {
    // The 56-character string used in FIPS 180-4 Appendix B.2:
    //   "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    let s = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    let h = ecdsa_sha256(buf, n)
    let got = p256_hex_encode_buf(h, 32)
    ce_str_eq("SHA-256(56-char Appendix B.2)",
        got,
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
}

fn test_sha256_one_block_boundary() {
    // 55 bytes = exactly one 64-byte block worth of padding fits in the
    // tail. Use 55 'A' characters.
    let buf = alloc(56)
    let i = 0
    while i < 55 { store8(buf + i, 65); i = i + 1 }
    store8(buf + 55, 0)
    let h = ecdsa_sha256(buf, 55)
    // SHA-256("A" * 55) precomputed via python hashlib:
    //   8963cc0afd622cc7574ac2011f93a3059b3d65548a77542a1559e3d202e6ab00
    let got = p256_hex_encode_buf(h, 32)
    ce_str_eq("SHA-256('A' * 55) block-boundary case",
        got,
        "8963cc0afd622cc7574ac2011f93a3059b3d65548a77542a1559e3d202e6ab00")
}

fn test_sha256_long_input() {
    // 1000 bytes = 15 full 64-byte blocks + 40 byte remainder.
    // Use 'a' * 1000. SHA-256 reference: openssl dgst -sha256 yields
    //   41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3
    // (also matches Crypto.Hash.SHA256 in Python).
    let n = 1000
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 97); i = i + 1 }
    store8(buf + n, 0)
    let h = ecdsa_sha256(buf, n)
    let got = p256_hex_encode_buf(h, 32)
    ce_str_eq("SHA-256('a' * 1000)",
        got,
        "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")
}

fn test_sha256_bytes_wrapper() {
    // sha256_bytes wrapper: round-trip 'abc' via byte list.
    let bl = list_new()
    push(bl, 97)
    push(bl, 98)
    push(bl, 99)
    let digest = ecdsa_sha256_bytes(bl)
    ce_eq("sha256_bytes returns 32-byte list", len(digest), 32)
    // First byte: 0xba = 186.
    ce_eq("sha256_bytes[0] = 0xba", digest[0], 186)
    ce_eq("sha256_bytes[31] = 0xad", digest[31], 173)
}

// ---- ECDSA-P-256 verify -- RFC 6979 §A.2.5 ('sample') --------------------

fn _t_rfc6979_sample_pubkey_uncompressed() {
    // 0x04 || Qx (32B BE) || Qy (32B BE)
    return p256_hex_decode(
        "04"
        + "60fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6"
        + "7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299"
    )
}

fn _t_rfc6979_sample_hash() {
    // SHA-256("sample") = af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf
    return p256_hex_decode(
        "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf")
}

fn _t_rfc6979_sample_sig_r() {
    return p256_hex_decode(
        "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716")
}

fn _t_rfc6979_sample_sig_s() {
    return p256_hex_decode(
        "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
}

fn test_ecdsa_rfc6979_sample_verify_ok() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], r[0], s[0])
    ce_eq("RFC 6979 §A.2.5 'sample' verify -> true", ok, 1)
}

fn test_ecdsa_rfc6979_sample_verify_full() {
    // Same vector, but run the verify_full path which SHA-256s the
    // message internally.
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let msg = "sample"
    let msg_buf = alloc(len(msg) + 1)
    let i = 0
    while i < len(msg) {
        store8(msg_buf + i, char_at(msg, i))
        i = i + 1
    }
    store8(msg_buf + len(msg), 0)
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let ok = ecdsa_p256_verify_full(pub[0], pub[1], msg_buf, len(msg),
                                    r[0], s[0])
    ce_eq("RFC 6979 §A.2.5 verify_full('sample') -> true", ok, 1)
}

// ---- Tamper-rejection paths ----------------------------------------------

fn test_ecdsa_tamper_r_flip() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    // Flip the low byte of r.
    let r_buf = r[0]
    store8(r_buf + 31, int_xor(load8(r_buf + 31), 1))
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], r_buf, s[0])
    ce_eq("tampered r -> false", ok, 0)
}

fn test_ecdsa_tamper_s_flip() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let s_buf = s[0]
    store8(s_buf + 0, int_xor(load8(s_buf + 0), 128))
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], r[0], s_buf)
    ce_eq("tampered s -> false", ok, 0)
}

fn test_ecdsa_tamper_msg_hash() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let h_buf = h[0]
    // Flip the high byte of the hash.
    store8(h_buf + 0, int_xor(load8(h_buf + 0), 1))
    let ok = ecdsa_p256_verify(pub[0], pub[1], h_buf, r[0], s[0])
    ce_eq("tampered hash -> false", ok, 0)
}

fn test_ecdsa_wrong_pub() {
    // Use a different public key (Q + G, computed via curve add). The
    // signature will not verify against the wrong point.
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    // Decode pub into (X, Y), add G to it, re-encode.
    let pt = p256_decode_point(pub[0], pub[1])
    let G = p256_base_point()
    let pt2 = p256_pt_add_affine(pt[0], pt[1], G[0], G[1])
    let pub2 = p256_encode_uncompressed(pt2[0], pt2[1])
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let ok = ecdsa_p256_verify(pub2, 65, h[0], r[0], s[0])
    ce_eq("wrong public key -> false", ok, 0)
}

// ---- Range-check paths ----------------------------------------------------

fn test_ecdsa_reject_r_zero() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let s = _t_rfc6979_sample_sig_s()
    // r = 0 (32 zero bytes).
    let zero = alloc(33)
    let i = 0
    while i < 33 { store8(zero + i, 0); i = i + 1 }
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], zero, s[0])
    ce_eq("r == 0 -> false", ok, 0)
}

fn test_ecdsa_reject_s_zero() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let zero = alloc(33)
    let i = 0
    while i < 33 { store8(zero + i, 0); i = i + 1 }
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], r[0], zero)
    ce_eq("s == 0 -> false", ok, 0)
}

fn test_ecdsa_reject_r_eq_n() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let s = _t_rfc6979_sample_sig_s()
    // n = ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551
    let n_buf = p256_hex_decode(
        "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], n_buf[0], s[0])
    ce_eq("r == n -> false (out of [1, n-1])", ok, 0)
}

fn test_ecdsa_reject_s_eq_n() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let n_buf = p256_hex_decode(
        "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], r[0], n_buf[0])
    ce_eq("s == n -> false", ok, 0)
}

fn test_ecdsa_reject_r_above_n() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let s = _t_rfc6979_sample_sig_s()
    // 2^256 - 1: well above n.
    let big = p256_hex_decode(
        "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], big[0], s[0])
    ce_eq("r >= n -> false", ok, 0)
}

fn test_ecdsa_reject_bad_pubkey_shape() {
    // Bad tag byte.
    let bad = alloc(66)
    store8(bad, 5)
    let i = 0
    while i < 65 { store8(bad + i, 0); i = i + 1 }
    store8(bad + 65, 0)
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let ok = ecdsa_p256_verify(bad, 65, h[0], r[0], s[0])
    ce_eq("bad pubkey tag -> false", ok, 0)
}

fn test_ecdsa_reject_truncated_pubkey() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    // Claim a wrong length for the SEC1 point.
    let ok = ecdsa_p256_verify(pub[0], 33, h[0], r[0], s[0])
    ce_eq("wrong pubkey length -> false", ok, 0)
}

// ---- Round-trip: sign deterministically + verify -------------------------

// This anchor uses RFC 6979 'sample' again but via a different message
// to confirm the verify path generalizes. Reuse RFC 6979 §A.2.5 'test'
// vector:
//   msg = "test"
//   hash = 9F86D081884C7D659A2FEAA0C55AD015A3BF4F1B2B0B822CD15D6C15B0F00A08
//   r = F1ABB023518351CD71D881567B1EA663ED3EFCF6C5132B354F28D3B0B7D38367
//   s = 019F4113742A2B14BD25926B49C649155F267E60D3814B4C0CC84250E46F0083

fn test_ecdsa_rfc6979_test_verify() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let h = p256_hex_decode(
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08")
    let r = p256_hex_decode(
        "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367")
    let s = p256_hex_decode(
        "019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083")
    let ok = ecdsa_p256_verify(pub[0], pub[1], h[0], r[0], s[0])
    ce_eq("RFC 6979 'test' verify -> true", ok, 1)
}

fn test_ecdsa_rfc6979_test_verify_full() {
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let msg = "test"
    let msg_buf = alloc(len(msg) + 1)
    let i = 0
    while i < len(msg) {
        store8(msg_buf + i, char_at(msg, i))
        i = i + 1
    }
    store8(msg_buf + len(msg), 0)
    let r = p256_hex_decode(
        "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367")
    let s = p256_hex_decode(
        "019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083")
    let ok = ecdsa_p256_verify_full(pub[0], pub[1], msg_buf, len(msg),
                                    r[0], s[0])
    ce_eq("RFC 6979 'test' verify_full -> true", ok, 1)
}

// ---- Compressed public-key acceptance ------------------------------------

fn test_ecdsa_compressed_pubkey() {
    // Encode the RFC 6979 §A.2.5 public key in COMPRESSED form (33B);
    // verify must accept it equally.
    let pub_unc = _t_rfc6979_sample_pubkey_uncompressed()
    let pt = p256_decode_point(pub_unc[0], pub_unc[1])
    let pub_cmp = p256_encode_compressed(pt[0], pt[1])
    let h = _t_rfc6979_sample_hash()
    let r = _t_rfc6979_sample_sig_r()
    let s = _t_rfc6979_sample_sig_s()
    let ok = ecdsa_p256_verify(pub_cmp, 33, h[0], r[0], s[0])
    ce_eq("compressed pubkey verify -> true", ok, 1)
}

// ---- bn256 entry point ---------------------------------------------------

fn test_ecdsa_verify_bn_entry() {
    // The bn256 entry point lets x509 callers skip the buffer hop.
    let pub = _t_rfc6979_sample_pubkey_uncompressed()
    let hash_bn = bn256_from_hex(
        "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf")
    let r_bn = bn256_from_hex(
        "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716")
    let s_bn = bn256_from_hex(
        "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    let ok = ecdsa_p256_verify_bn(pub[0], pub[1], hash_bn, r_bn, s_bn)
    ce_eq("verify_bn entry point matches buffer entry", ok, 1)
}

fn main() {
    test_sha256_abc()
    test_sha256_empty()
    test_sha256_fips_appendix_b2()
    test_sha256_one_block_boundary()
    test_sha256_long_input()
    test_sha256_bytes_wrapper()
    test_ecdsa_rfc6979_sample_verify_ok()
    test_ecdsa_rfc6979_sample_verify_full()
    test_ecdsa_tamper_r_flip()
    test_ecdsa_tamper_s_flip()
    test_ecdsa_tamper_msg_hash()
    test_ecdsa_wrong_pub()
    test_ecdsa_reject_r_zero()
    test_ecdsa_reject_s_zero()
    test_ecdsa_reject_r_eq_n()
    test_ecdsa_reject_s_eq_n()
    test_ecdsa_reject_r_above_n()
    test_ecdsa_reject_bad_pubkey_shape()
    test_ecdsa_reject_truncated_pubkey()
    test_ecdsa_rfc6979_test_verify()
    test_ecdsa_rfc6979_test_verify_full()
    test_ecdsa_compressed_pubkey()
    test_ecdsa_verify_bn_entry()
    ce_summary("ecdsa")
}

main()
