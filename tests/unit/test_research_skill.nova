// Unit tests for src/skills/skills/research_skill.nova (ADR-0103 R47p3).
//
// Also verifies the end-to-end vision moment: load two packs whose atoms
// disagree on shared labels, run the research skill on the shared topic,
// see the disagreement reported as a first-class part of the proposal.

import "../ce_test.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/agent/ingestion_agent.nova"

fn _mk_supervisor(kgreg, mo) {
    let m = research_skill_manifest()
    return skill_supervisor_new(m, kgreg, capreg_new(), 0, 0, mo, 100)
}

fn _perception(topic, kgs) {
    let p = list_new() push(p, topic) push(p, kgs) return p
}

fn _empty_kgs() { return list_new() }

fn _wire_kg(kgreg, kg_name, labels, alphas) {
    let kg = kg_spawn(kgreg, kg_name)
    let i = 0
    while i < len(labels) {
        let a = kg_add_atom(kg, ATOM_FACT, labels[i], 0)
        let b = atom_belief(a)
        list_set(b, 0, alphas[i])
        list_set(b, 1, 5000 - alphas[i])
        i = i + 1
    }
    return kg
}

// ---- basic behaviour ------------------------------------------------------

fn test_manifest_shape() {
    let m = research_skill_manifest()
    ce_eq("name", skill_manifest_name(m), "research")
    ce_eq("version", skill_manifest_version(m), "1.0.0")
    ce_eq("policy id", skill_manifest_policy_id(m), SKILL_POLICY_RESEARCH)
    ce_eq("no effectors declared", skill_manifest_effector_count(m), 0)
}

fn test_no_registry_ok_but_zero() {
    let m = research_skill_manifest()
    let sup = skill_supervisor_new(m, 0, capreg_new(), 0, 0, mo_new(), 100)
    let r = skill_run(sup, _perception("moon", _empty_kgs()))
    ce_eq("ok", skill_pr_ok(r), 1)
    ce_eq("no atoms", len(skill_pr_atoms(r)), 0)
    ce_eq("confidence 0", skill_pr_confidence(r), 0)
}

fn test_empty_topic_returns_noop() {
    let sup = _mk_supervisor(kg_registry_new(), mo_new())
    let r = skill_run(sup, _perception("", _empty_kgs()))
    ce_eq("ok", skill_pr_ok(r), 1)
    ce_eq("no atoms", len(skill_pr_atoms(r)), 0)
    ce_eq("confidence 0", skill_pr_confidence(r), 0)
}

fn test_topic_all_stopwords_returns_noop() {
    let sup = _mk_supervisor(kg_registry_new(), mo_new())
    // Every token here is a stopword (< 3 chars OR in the list).
    let r = skill_run(sup, _perception("what does the", _empty_kgs()))
    ce_eq("ok", skill_pr_ok(r), 1)
    ce_eq("no atoms after stopword filter", len(skill_pr_atoms(r)), 0)
}

// ---- KG walking + filtering ----------------------------------------------

fn test_walks_all_kgs_when_wanted_empty() {
    let kgreg = kg_registry_new()
    let labs1 = list_new() push(labs1, "einstein")
    let alphas1 = list_new() push(alphas1, 4500)
    _wire_kg(kgreg, "history", labs1, alphas1)
    let labs2 = list_new() push(labs2, "einstein_photon_hypothesis")
    let alphas2 = list_new() push(alphas2, 4000)
    _wire_kg(kgreg, "physics", labs2, alphas2)
    let sup = _mk_supervisor(kgreg, mo_new())
    let r = skill_run(sup, _perception("einstein biography", _empty_kgs()))
    ce_eq("ok", skill_pr_ok(r), 1)
    // Two atoms in two different KGs both match "einstein".
    ce_eq("2 atoms matched across 2 KGs", len(skill_pr_atoms(r)), 2)
}

fn test_wanted_filter_narrows_to_listed_kgs() {
    let kgreg = kg_registry_new()
    let labs1 = list_new() push(labs1, "einstein")
    let alphas1 = list_new() push(alphas1, 4500)
    _wire_kg(kgreg, "history", labs1, alphas1)
    let labs2 = list_new() push(labs2, "einstein_theory")
    let alphas2 = list_new() push(alphas2, 4000)
    _wire_kg(kgreg, "physics", labs2, alphas2)
    let sup = _mk_supervisor(kgreg, mo_new())
    let wanted = list_new() push(wanted, "physics")
    let r = skill_run(sup, _perception("einstein", wanted))
    ce_eq("only physics matched", len(skill_pr_atoms(r)), 1)
    // Trace mentions the scanned KG count = 1 (only physics).
    let trace = skill_pr_trace(r)
    let saw = 0
    let i = 0
    while i < len(trace) {
        // Look for "scanned 1 KGs" substring
        let t = trace[i]
        let n = len(t)
        let j = 0
        while j <= n - 9 {
            if char_at(t, j) == 115 { if char_at(t, j+1) == 99 {
                if char_at(t, j+2) == 97 { if char_at(t, j+3) == 110 {
                    if char_at(t, j+4) == 110 { if char_at(t, j+5) == 101 {
                        if char_at(t, j+6) == 100 { if char_at(t, j+7) == 32 {
                            if char_at(t, j+8) == 49 { saw = 1 j = n }
                        } }
                    } }
                } }
            } }
            j = j + 1
        }
        i = i + 1
    }
    ce_eq("trace confirms 1 KG scanned", saw, 1)
}

// ---- headline vision test: cross-KG conflict surfaces --------------------

fn test_cross_kg_conflict_surfaces_in_proposal() {
    // The vision demo, distilled to test form: two KGs, same-labeled atom,
    // opposing belief. Research skill on that topic must report the
    // disagreement as a first-class part of its proposal.
    let kgreg = kg_registry_new()
    let mo = mo_new()
    // "science" KG: sun believes 950
    let labs1 = list_new() push(labs1, "sun")
    let alphas1 = list_new() push(alphas1, 4750)   // mean 950
    _wire_kg(kgreg, "science", labs1, alphas1)
    // "folk" KG: sun believes 100
    let labs2 = list_new() push(labs2, "sun")
    let alphas2 = list_new() push(alphas2, 500)    // mean 100
    _wire_kg(kgreg, "folk", labs2, alphas2)
    let sup = _mk_supervisor(kgreg, mo)
    let r = skill_run(sup, _perception("what do you know about the sun",
                                       _empty_kgs()))
    ce_eq("ok", skill_pr_ok(r), 1)
    // Both atoms matched (2 hits).
    ce_eq("2 atom matches", len(skill_pr_atoms(r)), 2)
    // Confidence = max mean = 950.
    ce_eq("confidence 950", skill_pr_confidence(r), 950)
    // Proposal string contains BOTH beliefs AND the conflict callout.
    let prop = skill_pr_proposal(r)
    // Look for the substring "conflicts" in the proposal.
    let has_conflicts_word = 0
    let n = len(prop)
    let target = "conflicts"
    let tn = len(target)
    let i = 0
    while i <= n - tn {
        let ok = 1
        let j = 0
        while j < tn {
            if char_at(prop, i + j) != char_at(target, j) { ok = 0 j = tn }
            else { j = j + 1 }
        }
        if ok == 1 { has_conflicts_word = 1 i = n }
        i = i + 1
    }
    ce_eq("proposal reports cross-KG conflicts", has_conflicts_word, 1)
    // Trace names 1 relevant conflict.
    let trace = skill_pr_trace(r)
    let has_conflict_trace = 0
    let ti = 0
    while ti < len(trace) {
        let t = trace[ti]
        // Look for "1 cross-KG conflicts".
        let nn = len(t)
        let needle = "1 cross-KG conflicts"
        let nl = len(needle)
        let k = 0
        while k <= nn - nl {
            let mok = 1
            let m = 0
            while m < nl {
                if char_at(t, k + m) != char_at(needle, m) { mok = 0 m = nl }
                else { m = m + 1 }
            }
            if mok == 1 { has_conflict_trace = 1 k = nn }
            k = k + 1
        }
        ti = ti + 1
    }
    ce_eq("trace surfaces 1 conflict", has_conflict_trace, 1)
}

// ---- run through the real ingestion agent + real packs -------------------

fn test_end_to_end_via_ingestion_agent_solar_and_folk() {
    // Same story as the /kg_consistency demo but through the SKILL runtime:
    // ingest solar_system + folk_astronomy, then research "sun".
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/solar_system.cerec",
                  "astronomy", "src:pack:solar_system:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/folk_astronomy.cerec",
                  "folk_astronomy", "src:pack:folk_astronomy:v1", "", 0)
    let sup = _mk_supervisor(ing_kgreg(a), ing_mo(a))
    let r = skill_run(sup, _perception("the sun", _empty_kgs()))
    ce_eq("ok", skill_pr_ok(r), 1)
    // At least one atom matched in each of the two packs' KGs.
    ce_check("at least 2 atoms matched",
             len(skill_pr_atoms(r)) >= 2)
    // Some conflict on shared labels surfaced. Just verify by finding
    // "cross-KG conflicts" wording in the proposal.
    let prop = skill_pr_proposal(r)
    let has_conflicts_word = 0
    let n = len(prop)
    let target = "cross-KG conflicts"
    let tn = len(target)
    let i = 0
    while i <= n - tn {
        let ok = 1
        let j = 0
        while j < tn {
            if char_at(prop, i + j) != char_at(target, j) { ok = 0 j = tn }
            else { j = j + 1 }
        }
        if ok == 1 { has_conflicts_word = 1 i = n }
        i = i + 1
    }
    ce_eq("real packs -> conflict surfaced by skill", has_conflicts_word, 1)
}

// ---- meta-observer attribution flows through skill_run --------------------

fn test_attribution_under_research_tag() {
    let kgreg = kg_registry_new()
    let mo = mo_new()
    let labs = list_new() push(labs, "einstein")
    let alphas = list_new() push(alphas, 4500)
    _wire_kg(kgreg, "history", labs, alphas)
    let sup = _mk_supervisor(kgreg, mo)
    skill_run(sup, _perception("einstein", _empty_kgs()))
    let report = mo_report(mo)
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:skill:research:v1.0.0") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("attribution under skill's own tag", saw, 1)
}

fn main() {
    test_manifest_shape()
    test_no_registry_ok_but_zero()
    test_empty_topic_returns_noop()
    test_topic_all_stopwords_returns_noop()
    test_walks_all_kgs_when_wanted_empty()
    test_wanted_filter_narrows_to_listed_kgs()
    test_cross_kg_conflict_surfaces_in_proposal()
    test_end_to_end_via_ingestion_agent_solar_and_folk()
    test_attribution_under_research_tag()
    ce_summary("research_skill")
}

main()
