// CE_TEST_TIMEOUT: 240
// PR 4b: TLS 1.3 CertificateVerify with rsa_pss_rsae_sha256/384/512 for
// RSA-3072/4096 leaves, and X.509 sha384/sha512WithRSAEncryption.
// Fixtures from openssl 3: self-signed RSA-4096 (sha384WithRSA) and
// RSA-3072 (sha512WithRSA) certs, PSS signatures (salt = hash length) over
// the RFC 8446 4.4.3 CertificateVerify content for a fixed transcript hash.

import "../ce_test.nova"
import "../../src/safety/x509_verify.nova"
import "../../src/io/transducers/tls13_client.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

let C4096 = ""
let C3072 = ""
let S4096_256 = ""
let S4096_384 = ""
let S4096_512 = ""
let S3072_256 = ""
let S3072_384 = ""
let S3072_512 = ""
let TH = "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"

fn _hv(c) {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn _hexbuf(h) {
    let n = int_shr(len(h), 1)
    let b = alloc(n + 1)
    let i = 0
    while i < n {
        store8(b + i, _hv(char_at(h, int_mul(i, 2))) * 16 + _hv(char_at(h, int_mul(i, 2) + 1)))
        i = i + 1
    }
    store8(b + n, 0)
    return b
}

fn _cert(h) { return cert_parse(_hexbuf(h), int_shr(len(h), 1)) }

// A CertificateVerify handshake message: type 15, u24 length, u16 scheme,
// u16 signature length, signature. `claimed` is the signature length field.
fn _cv_msg(alg, sighex, claimed) {
    let sn = int_shr(len(sighex), 1)
    let body = 4 + sn
    let m = alloc(4 + body + 1)
    store8(m, 15)
    store8(m + 1, int_and(int_shr(body, 16), 255))
    store8(m + 2, int_and(int_shr(body, 8), 255))
    store8(m + 3, int_and(body, 255))
    store8(m + 4, int_shr(alg, 8)) store8(m + 5, int_and(alg, 255))
    store8(m + 6, int_shr(claimed, 8)) store8(m + 7, int_and(claimed, 255))
    let s = _hexbuf(sighex)
    let i = 0
    while i < sn { store8(m + 8 + i, load8(s + i)) i = i + 1 }
    return m
}

fn _cv(alg, sighex, leaf) {
    return _tls_verify_certverify(_cv_msg(alg, sighex, int_shr(len(sighex), 1)), 0, _hexbuf(TH), leaf)
}

fn test_wide_certs() {
    let c4 = _cert(C4096)
    let c3 = _cert(C3072)
    ce_eq("RSA-4096 cert parses", cert_ok(c4), 1)
    ce_eq("RSA-3072 cert parses", cert_ok(c3), 1)
    ce_eq("RSA-4096 key is 512 bytes", rsa_key_bytes(cert_N(c4)), 512)
    ce_eq("RSA-3072 key is 384 bytes", rsa_key_bytes(cert_N(c3)), 384)
    ce_eq("sha384WithRSA recognised", cert_sig_type(c4), SIG_RSA_SHA384)
    ce_eq("sha512WithRSA recognised", cert_sig_type(c3), SIG_RSA_SHA512)
    ce_eq("RSA-4096 sha384WithRSA self-signature verifies", cert_verify_under(c4, c4), 1)
    ce_eq("RSA-3072 sha512WithRSA self-signature verifies", cert_verify_under(c3, c3), 1)
    ce_eq("signature does not verify under another key", cert_verify_under(c4, c3), 0)
}

fn test_certverify_schemes() {
    let c4 = _cert(C4096)
    let c3 = _cert(C3072)
    ce_eq("4096 rsa_pss_rsae_sha256", _cv(2052, S4096_256, c4), 1)
    ce_eq("4096 rsa_pss_rsae_sha384", _cv(2053, S4096_384, c4), 1)
    ce_eq("4096 rsa_pss_rsae_sha512", _cv(2054, S4096_512, c4), 1)
    ce_eq("3072 rsa_pss_rsae_sha256", _cv(2052, S3072_256, c3), 1)
    ce_eq("3072 rsa_pss_rsae_sha384", _cv(2053, S3072_384, c3), 1)
    ce_eq("3072 rsa_pss_rsae_sha512", _cv(2054, S3072_512, c3), 1)
    ce_eq("sha384 signature under the sha512 scheme fails", _cv(2054, S4096_384, c4), 0)
    ce_eq("signature from another key fails", _cv(2053, S3072_384, c4), 0)
    ce_eq("unsupported scheme 0x0401 fails", _cv(1025, S4096_256, c4), 0)
    let bad = _cv_msg(2053, S4096_384, 600)
    ce_eq("signature length past the message end fails",
          _tls_verify_certverify(bad, 0, _hexbuf(TH), c4), 0)
}

fn main() {
    test_wide_certs()
    test_certverify_schemes()
    ce_summary("tls_certverify_wide")
}

main()
