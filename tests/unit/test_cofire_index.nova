// Unit tests for src/reader/cofire_index.nova
//
// P2.1: co-fire similarity side-index from the moment stream. The cofire
// table is keyed by atom-id-pair and records how many distinct moments their
// activations co-appeared. ci_strength(ci, a, b) returns 0..1000 milli
// normalized by the global maximum co-fire count -- a rare pair that
// co-fires as often as the most-frequent pair still scores 1000.

import "../ce_test.nova"
import "../../src/reader/cofire_index.nova"

// ---- test 1: empty index returns 0 -----------------------------------------
fn test_empty_index() {
    let ci = ci_new()
    ce_eq("empty: size 0", ci_size(ci), 0)
    ce_eq("empty: max 0",  ci_max(ci), 0)
    ce_eq("empty: count(a,b) 0", ci_count(ci, "kg", 1, "kg", 2), 0)
    ce_eq("empty: strength(a,b) 0", ci_strength(ci, "kg", 1, "kg", 2), 0)
}

// ---- test 2: record a single moment -- one pair, one count ----------------
fn test_record_single_moment() {
    let ci = ci_new()
    let trace = list_new()
    push(trace, 1)
    push(trace, 2)
    let pairs = ci_record_moment(ci, "kg", trace)
    ce_eq("single moment: 1 pair", pairs, 1)
    ce_eq("size after 1 moment", ci_size(ci), 1)
    ce_eq("count(1,2) == 1", ci_count(ci, "kg", 1, "kg", 2), 1)
    ce_eq("count(2,1) symmetric", ci_count(ci, "kg", 2, "kg", 1), 1)
    ce_eq("max after one moment", ci_max(ci), 1)
    // Single observation: count == max -> strength 1000.
    ce_eq("strength at max -> 1000", ci_strength(ci, "kg", 1, "kg", 2), 1000)
}

// ---- test 3: multi-atom moment expands to all pairs ------------------------
fn test_multi_atom_moment() {
    let ci = ci_new()
    let trace = list_new()
    push(trace, 1)
    push(trace, 2)
    push(trace, 3)
    let n = ci_record_moment(ci, "kg", trace)
    // C(3,2) = 3 pairs: (1,2) (1,3) (2,3).
    ce_eq("3-atom moment yields 3 pairs", n, 3)
    ce_eq("size after 3-atom moment", ci_size(ci), 3)
    ce_eq("count(1,2) 1", ci_count(ci, "kg", 1, "kg", 2), 1)
    ce_eq("count(1,3) 1", ci_count(ci, "kg", 1, "kg", 3), 1)
    ce_eq("count(2,3) 1", ci_count(ci, "kg", 2, "kg", 3), 1)
}

// ---- test 4: same-pair moments accumulate counts ---------------------------
fn test_accumulate_counts() {
    let ci = ci_new()
    let t = list_new()
    push(t, 1)
    push(t, 2)
    let i = 0
    while i < 5 {
        ci_record_moment(ci, "kg", t)
        i = i + 1
    }
    ce_eq("count(1,2) after 5 moments", ci_count(ci, "kg", 1, "kg", 2), 5)
    ce_eq("max == 5", ci_max(ci), 5)
    // strength normalized by max -> count(1,2) is the max, so 1000.
    ce_eq("strength at global max -> 1000", ci_strength(ci, "kg", 1, "kg", 2), 1000)
}

// ---- test 5: normalization by global max -----------------------------------
fn test_normalized_strength() {
    let ci = ci_new()
    let strong = list_new()
    push(strong, 1)
    push(strong, 2)
    // (1,2) co-fires 10 times.
    let i = 0
    while i < 10 {
        ci_record_moment(ci, "kg", strong)
        i = i + 1
    }
    // (3,4) co-fires only twice.
    let weak = list_new()
    push(weak, 3)
    push(weak, 4)
    ci_record_moment(ci, "kg", weak)
    ci_record_moment(ci, "kg", weak)
    ce_eq("max is 10", ci_max(ci), 10)
    ce_eq("count(1,2) 10", ci_count(ci, "kg", 1, "kg", 2), 10)
    ce_eq("count(3,4) 2",  ci_count(ci, "kg", 3, "kg", 4), 2)
    // (3,4) = 2 out of max 10 -> 200 milli.
    ce_eq("strength(3,4) -> 200",  ci_strength(ci, "kg", 3, "kg", 4), 200)
    ce_eq("strength(1,2) -> 1000", ci_strength(ci, "kg", 1, "kg", 2), 1000)
}

// ---- test 6: missing pairs return 0 ----------------------------------------
fn test_missing_pair_zero() {
    let ci = ci_new()
    let t = list_new()
    push(t, 1)
    push(t, 2)
    ci_record_moment(ci, "kg", t)
    ce_eq("absent pair -> count 0",    ci_count(ci, "kg", 5, "kg", 6), 0)
    ce_eq("absent pair -> strength 0", ci_strength(ci, "kg", 5, "kg", 6), 0)
}

// ---- test 7: a==b is zero (no self-similarity) -----------------------------
fn test_self_pair_zero() {
    let ci = ci_new()
    let t = list_new()
    push(t, 1)
    push(t, 2)
    ci_record_moment(ci, "kg", t)
    ce_eq("self count is 0",    ci_count(ci, "kg", 1, "kg", 1), 0)
    ce_eq("self strength is 0", ci_strength(ci, "kg", 1, "kg", 1), 0)
}

// ---- test 8: singleton + empty moments are no-ops --------------------------
fn test_singleton_moment_noop() {
    let ci = ci_new()
    let singleton = list_new()
    push(singleton, 1)
    ce_eq("singleton: 0 pairs", ci_record_moment(ci, "kg", singleton), 0)
    ce_eq("size unchanged", ci_size(ci), 0)
    let empty = list_new()
    ce_eq("empty trace: 0 pairs", ci_record_moment(ci, "kg", empty), 0)
}

// ---- test 9: ci_neighbors enumerates from one atom -------------------------
fn test_neighbors_listing() {
    let ci = ci_new()
    let t = list_new()
    push(t, 1)
    push(t, 2)
    push(t, 3)
    ci_record_moment(ci, "kg", t)
    let nbrs = ci_neighbors(ci, "kg", 1, 1000)
    ce_eq("atom 1 has 2 cofire neighbors", len(nbrs), 2)
    // Either ordering ok; collect strengths into a set.
    let strengths_ok = 1
    let i = 0
    while i < len(nbrs) {
        if nbrs[i][1] != 1000 { strengths_ok = 0 }
        i = i + 1
    }
    ce_eq("each neighbor at max strength", strengths_ok, 1)
}

// ---- test 10: multi-kg handle form ----------------------------------------
fn test_multikg_pairs() {
    let ci = ci_new()
    let pairs = list_new()
    let p1 = list_new()
    push(p1, "med")
    push(p1, 1)
    push(pairs, p1)
    let p2 = list_new()
    push(p2, "bio")
    push(p2, 7)
    push(pairs, p2)
    let n = ci_record_moment_multikg(ci, pairs)
    ce_eq("multikg moment: 1 pair", n, 1)
    ce_eq("count med/1 vs bio/7", ci_count(ci, "med", 1, "bio", 7), 1)
    ce_eq("count bio/7 vs med/1 symmetric", ci_count(ci, "bio", 7, "med", 1), 1)
}

fn main() {
    test_empty_index()
    test_record_single_moment()
    test_multi_atom_moment()
    test_accumulate_counts()
    test_normalized_strength()
    test_missing_pair_zero()
    test_self_pair_zero()
    test_singleton_moment_noop()
    test_neighbors_listing()
    test_multikg_pairs()
    ce_summary("cofire_index")
}

main()
