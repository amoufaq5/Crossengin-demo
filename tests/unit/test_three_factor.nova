// Unit tests for the three-factor / neuromodulated plasticity rule and STDP
// asymmetry added to src/substrate/synapse_graph.nova (P2, ADR-0052).
//
// The headline claim: a reward arriving k ticks AFTER a co-firing still credits
// the right synapse (temporal credit assignment), which two-factor Hebbian
// cannot do. Also covers the STDP timing kernel, forward/backward asymmetry,
// punishment (negative neuromodulator), and the per-node fire-tick deposit pass.
//
// ADR-0052, ADR-0007.

import "../ce_test.nova"
import "../../src/substrate/synapse_graph.nova"

fn _abs(x) { if x < 0 { return 0 - x } return x }

fn test_stdp_kernel() {
    ce_check("same-tick pairing is causal/positive", syn_stdp_kernel(0) > 0)
    ce_check("causal beats acausal at equal |dt|", syn_stdp_kernel(3) > syn_stdp_kernel(-3))
    ce_check("kernel decays with delay", syn_stdp_kernel(1) > syn_stdp_kernel(8))
    ce_eq("outside window (causal) -> 0", syn_stdp_kernel(STDP_TAU), 0)
    ce_eq("outside window (acausal) -> 0", syn_stdp_kernel(0 - STDP_TAU), 0)
}

// The acceptance test: three-factor learns a delayed-reward association that
// pure Hebbian cannot.
fn test_delayed_reward_beats_hebbian() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 0, 0)
    syn_coactivate(g, s, 5, 5)               // A and B co-fire at tick 5
    ce_check("eligibility deposited by co-firing", syn_elig(g, s) > 0)
    ce_eq("weight unchanged with no reward yet", syn_weight(g, s), 0)

    let k = 0                                 // 5 ticks pass, still no reward
    while k < 5 { syn_decay_eligibility(g); k = k + 1 }
    ce_check("trace persists across the delay", syn_elig(g, s) > 0)

    syn_neuromodulate(g, 1000)                // reward finally arrives at tick 10
    ce_check("delayed reward potentiated the synapse", syn_weight(g, s) > 0)

    // Pure-Hebbian baseline: the fused rule needs simultaneous pre*post. At the
    // reward tick nothing is co-firing, so the same reward (as the modulator)
    // has nothing to act on -> no learning.
    let g2 = syn_graph_new()
    let s2 = syn_new(g2, 0, 1, 0, 0)
    syn_coactivate(g2, s2, 5, 5)
    let k2 = 0
    while k2 < 5 { syn_decay_eligibility(g2); k2 = k2 + 1 }
    syn_learn_one(g2, s2, 0, 0, 0, 1000)     // pre=0, post=0 -> inert
    ce_eq("pure Hebbian cannot use the delayed reward", syn_weight(g2, s2), 0)
}

// STDP asymmetry: "A then B" wires forward more strongly than "B then A".
fn test_stdp_asymmetry() {
    let g = syn_graph_new()
    let fwd = syn_new(g, 0, 1, 0, 0)   // A -> B
    let bwd = syn_new(g, 1, 0, 0, 0)   // B -> A
    // A fires at 10, B fires at 12 (A before B).
    syn_coactivate(g, fwd, 10, 12)     // pre=A@10 before post=B@12 : causal
    syn_coactivate(g, bwd, 12, 10)     // pre=B@12 after  post=A@10 : acausal
    ce_check("causal eligibility exceeds acausal", syn_elig(g, fwd) > syn_elig(g, bwd))
    syn_neuromodulate(g, 1000)         // same reward to both
    ce_check("forward (A->B) wired stronger than backward (B->A)",
             syn_weight(g, fwd) > syn_weight(g, bwd))
    ce_check("both still potentiated (asymmetry, not exclusion)", syn_weight(g, bwd) > 0)
}

fn test_punishment_depresses() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 500, 0)   // start excitatory (0.5)
    syn_coactivate(g, s, 3, 3)
    let w0 = syn_weight(g, s)
    syn_neuromodulate(g, -1000)        // negative neuromodulator (punishment)
    ce_check("negative neuromod depressed the weight", syn_weight(g, s) < w0)
}

fn test_eligibility_step_snapshot() {
    // graph-level deposit from a per-node fire-tick snapshot (node id -> tick).
    let g = syn_graph_new()
    let s = syn_new(g, 0, 2, 0, 0)     // node 0 -> node 2
    let ft = list_new(); push(ft, 7); push(ft, -1); push(ft, 8)  // 0@7, 1 never, 2@8
    ce_eq("one synapse received a trace", syn_eligibility_step(g, ft), 1)
    ce_check("causal 0->2 eligibility built", syn_elig(g, s) > 0)

    // a synapse whose post never fired gets nothing.
    let g2 = syn_graph_new()
    let s2 = syn_new(g2, 0, 1, 0, 0)
    let ft2 = list_new(); push(ft2, 7); push(ft2, -1)  // node 1 never fired
    syn_eligibility_step(g2, ft2)
    ce_eq("no trace when post never fired", syn_elig(g2, s2), 0)
}

// Eligibility traces still decay (and thus still gate pruning) -- the existing
// behaviour the three-factor path builds on, unchanged.
fn test_trace_decays() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 0, 0)
    syn_coactivate(g, s, 4, 4)
    let e0 = syn_elig(g, s)
    syn_decay_eligibility(g)
    ce_check("trace decays toward zero", syn_elig(g, s) < e0)
}

fn main() {
    test_stdp_kernel()
    test_delayed_reward_beats_hebbian()
    test_stdp_asymmetry()
    test_punishment_depresses()
    test_eligibility_step_snapshot()
    test_trace_decays()
    ce_summary("three_factor")
}

main()
