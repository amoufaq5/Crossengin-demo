// Unit tests for src/skills/skills/coding_helper.nova (ADR-0103 R47p5,
// activated in R53 via ADR-0107 pattern capsules).
//
// The skill's SHAPE was declared in R47p5 as a stub waiting on
// ADR-0107. R53 activated the policy body: the skill now consults the
// built-in `debug_common` pattern capsule to compose a real,
// source-tagged proposal. These tests cover the R53 shape.

import "../ce_test.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/coding_helper.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/capsules/pattern_capsule.nova"
import "../../src/ingest/pattern_pack.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_sup() {
    let m = coding_helper_manifest()
    return skill_supervisor_new(m, kg_registry_new(), capreg_new(), 0, 0,
                                mo_new(), 100)
}

// ---- manifest shape ------------------------------------------------------

fn test_manifest_identity() {
    let m = coding_helper_manifest()
    ce_eq("name", skill_manifest_name(m), "coding_helper")
    ce_eq("version", skill_manifest_version(m), "1.0.0")
    ce_eq("policy id", skill_manifest_policy_id(m), SKILL_POLICY_CODING_HELPER)
    ce_eq("tier USER", skill_manifest_capability_tier(m), SKILL_TIER_USER)
    ce_eq("attribution auto",
          skill_manifest_attribution(m), "src:skill:coding_helper:v1.0.0")
}

fn test_manifest_declares_effectors() {
    let m = coding_helper_manifest()
    ce_eq("2 effectors", skill_manifest_effector_count(m), 2)
    let es = skill_manifest_effectors(m)
    let saw_exec = 0
    let saw_ops = 0
    let i = 0
    while i < len(es) {
        if str_eq_bytes(es[i], "effector_code_exec") == 1 { saw_exec = 1 }
        if str_eq_bytes(es[i], "effector_file_ops")  == 1 { saw_ops = 1 }
        i = i + 1
    }
    ce_eq("declares code_exec", saw_exec, 1)
    ce_eq("declares file_ops", saw_ops, 1)
}

fn test_manifest_no_longer_requires_capsule_deps() {
    // R53 dropped the coding + debug_pattern refusal conditions; patterns
    // now come from the process-wide pattern registry (lazy-init built-
    // ins). A fresh manifest declares no external capsule deps.
    let m = coding_helper_manifest()
    ce_eq("no capsule deps",     skill_manifest_dep_count(m),     0)
    ce_eq("no refusal conditions", skill_manifest_refusal_count(m), 0)
}

// ---- runtime behavior: activated policy ---------------------------------

fn test_null_pointer_query_matches_debug_common() {
    let sup = _mk_sup()
    let r = skill_run(sup, "help me debug a null pointer exception")
    ce_eq("ok",                     skill_pr_ok(r), 1)
    ce_check("proposal non-empty",  len(skill_pr_proposal(r)) > 0)
    ce_check("proposal names skill", _has(skill_pr_proposal(r), "coding_helper"))
    ce_check("proposal echoes problem",
             _has(skill_pr_proposal(r), "null pointer exception"))
    ce_check("matched at least one debug pattern",
             _has(skill_pr_proposal(r), "matched"))
    ce_check("proposal contains NULL deref guidance",
             _has(skill_pr_proposal(r), "NULL deref"))
    // Highest confidence in debug_common is 800 (null pointer, stack overflow).
    ce_check("confidence reflects strongest match",
             skill_pr_confidence(r) >= 700)
    // Effector calls DESCRIBED, not executed (ADR-0103 #3).
    ce_check("described code_exec + file_ops",
             len(skill_pr_effector_calls(r)) >= 2)
}

fn test_race_condition_query() {
    let sup = _mk_sup()
    let r = skill_run(sup, "my code has a race condition on the shared counter")
    ce_eq("ok",   skill_pr_ok(r), 1)
    ce_check("race guidance", _has(skill_pr_proposal(r), "shared state"))
    ce_check("names lock",    _has(skill_pr_proposal(r), "lock"))
    ce_check("confidence 750+", skill_pr_confidence(r) >= 750)
}

fn test_off_by_one_multi_token() {
    let sup = _mk_sup()
    let r = skill_run(sup, "I have an off by one bug at the loop end")
    ce_eq("ok", skill_pr_ok(r), 1)
    ce_check("off-by-one guidance",
             _has(skill_pr_proposal(r), "loop bounds"))
}

fn test_unknown_problem_no_match() {
    // The tokens don't hit any pattern.
    let sup = _mk_sup()
    let r = skill_run(sup, "my alpaca ate my keyboard cable")
    ce_eq("ok",              skill_pr_ok(r), 1)
    ce_check("no-match text", _has(skill_pr_proposal(r), "no debug pattern matched"))
    ce_check("hint present",  _has(skill_pr_proposal(r), "add more concrete symptoms"))
    // Confidence 0 -- honest signal.
    ce_eq("confidence 0", skill_pr_confidence(r), 0)
    // No effectors described when there's no match: the skill has
    // nothing concrete to run.
    ce_eq("no effectors on no-match",
          len(skill_pr_effector_calls(r)), 0)
}

fn test_empty_problem_returns_noop() {
    let sup = _mk_sup()
    let r = skill_run(sup, "")
    ce_eq("ok",           skill_pr_ok(r), 1)
    ce_eq("confidence 0", skill_pr_confidence(r), 0)
    ce_check("proposal is a usage line",
             _has(skill_pr_proposal(r), "usage:"))
}

// ---- audit: trace names contributing pattern sources --------------------

fn test_trace_names_pattern_sources() {
    let sup = _mk_sup()
    let r = skill_run(sup, "null pointer at the caller boundary")
    let trace = skill_pr_trace(r)
    // Look for "src:pattern:debug_common:v1" in at least one trace line.
    let saw_tag = 0
    let ti = 0
    while ti < len(trace) {
        if find_bytes(trace[ti], "src:pattern:debug_common:v1") >= 0 {
            saw_tag = 1
        }
        ti = ti + 1
    }
    ce_eq("trace carries pattern source tag", saw_tag, 1)
}

// ---- top-N cap ----------------------------------------------------------

fn test_top_n_cap_when_many_match() {
    // A query that trips a lot of patterns (unlikely in practice, but
    // we can construct one by naming several trigger words at once).
    let sup = _mk_sup()
    let r = skill_run(sup, "null pointer race condition memory leak timeout stack overflow permission denied type error")
    ce_eq("ok", skill_pr_ok(r), 1)
    // At least 5 matches present in trace (the cap for body inclusion).
    let trace = skill_pr_trace(r)
    let matched_count = 0
    let ti = 0
    while ti < len(trace) {
        if find_bytes(trace[ti], "matched: src:pattern:debug_common:v1") >= 0 {
            matched_count = matched_count + 1
        }
        ti = ti + 1
    }
    ce_check("many matches in trace", matched_count >= 5)
    // Body length shouldn't grow unboundedly -- the "elided" line
    // appears when more matches exist than the CODING_HELPER_MAX_MATCHES
    // cap.
    if matched_count > 5 {
        ce_check("body notes elision when > 5 matches",
                 _has(skill_pr_proposal(r), "elided"))
    }
}

// ---- determinism --------------------------------------------------------

fn test_deterministic_same_problem_same_proposal() {
    let a_sup = _mk_sup()
    let a = skill_run(a_sup, "null pointer at boundary")
    let b_sup = _mk_sup()
    let b = skill_run(b_sup, "null pointer at boundary")
    ce_check("byte-identical proposals",
             str_eq_bytes(skill_pr_proposal(a), skill_pr_proposal(b)) == 1)
    ce_eq("same confidence",
          skill_pr_confidence(a), skill_pr_confidence(b))
}

// ---- R64: holder-scoped dispatch --------------------------------------

fn test_scoped_no_overlay_matches_unscoped_run() {
    // Baseline: overlay=0 -> scoped path returns byte-identical result
    // to the pre-R64 unscoped `skill_run`.
    let sup_a = _mk_sup()
    let a = skill_run(sup_a, "null pointer at boundary")
    let sup_b = _mk_sup()
    let b = skill_run_scoped(sup_b, "null pointer at boundary", 0, "")
    ce_check("byte-identical proposal",
             str_eq_bytes(skill_pr_proposal(a), skill_pr_proposal(b)) == 1)
    ce_eq("same confidence",
          skill_pr_confidence(a), skill_pr_confidence(b))
    ce_eq("same trace length",
          len(skill_pr_trace(a)), len(skill_pr_trace(b)))
}

fn test_scoped_owner_of_debug_common_gets_matches() {
    // debug_common owned by alice; alice's holder should still match.
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "debug_common", "alice")
    let sup = _mk_sup()
    let r = skill_run_scoped(sup,
                              "help me debug a null pointer exception",
                              overlay, "alice")
    ce_eq("ok",                     skill_pr_ok(r), 1)
    ce_check("matches present",
             _has(skill_pr_proposal(r), "NULL deref"))
    ce_check("trace notes overlay filtering",
             _has(skill_pr_proposal(r), "NULL deref"))
}

fn test_scoped_non_owner_gets_no_matches() {
    // debug_common owned by alice; bob asks the same question.
    // The scoped match returns 0 patterns; skill still returns ok
    // with the "no match" hint rather than a hard refusal.
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "debug_common", "alice")
    let sup = _mk_sup()
    let r = skill_run_scoped(sup,
                              "help me debug a null pointer exception",
                              overlay, "bob")
    ce_eq("ok (no hard refusal on empty match)",
          skill_pr_ok(r), 1)
    ce_check("no NULL deref advice reaches bob",
             _has(skill_pr_proposal(r), "NULL deref") == 0)
    ce_check("bob sees the 'no match' hint",
             _has(skill_pr_proposal(r), "no debug pattern matched"))
    ce_eq("confidence collapsed to 0",
          skill_pr_confidence(r), 0)
    // Trace should record that the overlay filtered by holder.
    let trace = skill_pr_trace(r)
    let saw = 0
    let i = 0
    while i < len(trace) {
        if _has(trace[i], "ownership overlay wired") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("trace records the overlay filter", saw, 1)
}

fn test_scoped_anonymous_denied_owned_capsule() {
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "debug_common", "alice")
    let sup = _mk_sup()
    let r = skill_run_scoped(sup,
                              "null pointer bug",
                              overlay, "")
    ce_check("anonymous gets no NULL deref",
             _has(skill_pr_proposal(r), "NULL deref") == 0)
    ce_check("anonymous sees the 'no match' hint",
             _has(skill_pr_proposal(r), "no debug pattern matched"))
}

fn test_scoped_public_debug_common_reaches_bob_when_only_others_owned() {
    // debug_common stays PUBLIC (unset); alice owns some OTHER pack.
    // Bob's dispatch still finds debug_common matches.
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "alices_private_pack", "alice")
    let sup = _mk_sup()
    let r = skill_run_scoped(sup,
                              "help me debug a null pointer exception",
                              overlay, "bob")
    ce_eq("ok",                     skill_pr_ok(r), 1)
    ce_check("debug_common still reaches bob (it's public)",
             _has(skill_pr_proposal(r), "NULL deref"))
}

fn test_scoped_alice_sees_alices_authored_pack() {
    // Alice installs a private pack matching a specific problem
    // description; bob (same query) doesn't see it. Proves the
    // R64 gate composes with R61/R62/R63 authored packs.
    pattern_pack_load_text(
        "CAPSULE r64_alices_debug\nVERSION 1.0.0\n"
      + "PATTERN 950\nTRIGGER kernel panic\n"
      + "GUIDANCE alice's private kernel-panic diagnosis\n")
    let overlay = ownership_registry_new()
    ownership_set_pattern(overlay, "r64_alices_debug", "alice")
    // NOTE: the coding_helper filter is fixed to ["debug_common"] --
    // so the alice-only pack won't fire via coding_helper by name
    // even with a matching query. Prove that the CORRECT behavior
    // is still what we expect: no leak to bob. (Both see 0 matches
    // via coding_helper for this pack because it's outside the
    // filter; the R63 scoped-match unit tests already covered the
    // pattern-registry filter path directly.)
    let sup = _mk_sup()
    let r_alice = skill_run_scoped(sup, "kernel panic on boot",
                                    overlay, "alice")
    let r_bob   = skill_run_scoped(sup, "kernel panic on boot",
                                    overlay, "bob")
    // Neither includes alice's private guidance because
    // coding_helper's filter is ["debug_common"]. Confirm the
    // leak-safety property: bob's proposal never contains alice's
    // authored guidance even when it exists in the registry.
    ce_check("bob does not see alice's private guidance",
             _has(skill_pr_proposal(r_bob),
                  "alice's private kernel-panic diagnosis") == 0)
    ce_check("alice ALSO doesn't via coding_helper (filter=debug_common)",
             _has(skill_pr_proposal(r_alice),
                  "alice's private kernel-panic diagnosis") == 0)
}

// ---- guarantees preserved end-to-end ---------------------------------

fn test_scoped_persona_projection_still_attached() {
    // ADR-0103 guarantee #2: persona projection ALWAYS attached.
    // No persona wired here, so projection stays 0 -- verify the
    // scoped path doesn't skip the composition step.
    let sup = _mk_sup()
    let r = skill_run_scoped(sup, "off by one bug",
                              ownership_registry_new(), "alice")
    ce_eq("projection slot present (0 = no persona)",
          skill_pr_projection(r), 0)
    ce_eq("ok",  skill_pr_ok(r), 1)
}

fn test_scoped_effectors_still_described_not_executed() {
    // Guarantee #3: effector calls are DESCRIBED, not executed.
    let sup = _mk_sup()
    let r = skill_run_scoped(sup, "null pointer at boundary",
                              ownership_registry_new(), "alice")
    let ecs = skill_pr_effector_calls(r)
    // On a matching problem, coding_helper describes 2 effector calls.
    ce_check("2 described calls", len(ecs) >= 1)
    // No effector actually FIRED -- the ec fragments are metadata only.
    // (Nothing writes to disk / spawns a subprocess in this path.)
}

fn main() {
    test_manifest_identity()
    test_manifest_declares_effectors()
    test_manifest_no_longer_requires_capsule_deps()
    test_null_pointer_query_matches_debug_common()
    test_race_condition_query()
    test_off_by_one_multi_token()
    test_unknown_problem_no_match()
    test_empty_problem_returns_noop()
    test_trace_names_pattern_sources()
    test_top_n_cap_when_many_match()
    test_deterministic_same_problem_same_proposal()
    // R64 -- holder-scoped dispatch
    test_scoped_no_overlay_matches_unscoped_run()
    test_scoped_owner_of_debug_common_gets_matches()
    test_scoped_non_owner_gets_no_matches()
    test_scoped_anonymous_denied_owned_capsule()
    test_scoped_public_debug_common_reaches_bob_when_only_others_owned()
    test_scoped_alice_sees_alices_authored_pack()
    test_scoped_persona_projection_still_attached()
    test_scoped_effectors_still_described_not_executed()
    ce_summary("coding_helper")
}

main()
