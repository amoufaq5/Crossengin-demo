// Unit tests for src/skills/skills/coding_helper.nova (ADR-0103 R47p5).
//
// The skill's SHAPE ships now: manifest with declared capsule deps
// (coding + debug_pattern), declared effectors (code_exec + file_ops),
// declared refusal conditions gating capsule installation.
//
// The POLICY BODY is an honest stub -- the real body waits on
// ADR-0107 (Pattern Capsules) + coding.cerec + debug_pattern.cerec.
// Tests verify the SHAPE lands correctly and the refusal semantics
// fire as designed.

import "../ce_test.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skills/coding_helper.nova"
import "../../src/capsules/capsule_registry.nova"

// ---- manifest shape ------------------------------------------------------

fn test_manifest_identity() {
    let m = coding_helper_manifest()
    ce_eq("name", skill_manifest_name(m), "coding_helper")
    ce_eq("version", skill_manifest_version(m), "1.0.0")
    ce_eq("policy id", skill_manifest_policy_id(m), SKILL_POLICY_CODING_HELPER)
    ce_eq("tier USER", skill_manifest_capability_tier(m), SKILL_TIER_USER)
    ce_eq("attribution auto",
          skill_manifest_attribution(m), "src:skill:coding_helper:v1.0.0")
}

fn test_manifest_declares_capsule_deps() {
    let m = coding_helper_manifest()
    ce_eq("2 deps", skill_manifest_dep_count(m), 2)
    let deps = skill_manifest_required_capsules(m)
    let saw_coding = 0
    let saw_debug = 0
    let i = 0
    while i < len(deps) {
        if str_eq_bytes(deps[i][0], "coding") == 1 { saw_coding = 1 }
        if str_eq_bytes(deps[i][0], "debug_pattern") == 1 { saw_debug = 1 }
        i = i + 1
    }
    ce_eq("declares coding dep", saw_coding, 1)
    ce_eq("declares debug_pattern dep", saw_debug, 1)
}

fn test_manifest_declares_effectors() {
    let m = coding_helper_manifest()
    ce_eq("2 effectors", skill_manifest_effector_count(m), 2)
    let es = skill_manifest_effectors(m)
    let saw_exec = 0
    let saw_ops = 0
    let i = 0
    while i < len(es) {
        if str_eq_bytes(es[i], "effector_code_exec") == 1 { saw_exec = 1 }
        if str_eq_bytes(es[i], "effector_file_ops")  == 1 { saw_ops = 1 }
        i = i + 1
    }
    ce_eq("declares code_exec", saw_exec, 1)
    ce_eq("declares file_ops", saw_ops, 1)
}

fn test_manifest_declares_refusal_conditions() {
    let m = coding_helper_manifest()
    ce_check("has refusal conditions", skill_manifest_refusal_count(m) >= 2)
    let conds = skill_manifest_refusal_conds(m)
    let saw_coding = 0
    let saw_debug = 0
    let i = 0
    while i < len(conds) {
        let c = conds[i]
        if c[0] == COND_CAPSULE_UNINSTALLED {
            if str_eq_bytes(c[1], "coding") == 1 { saw_coding = 1 }
            if str_eq_bytes(c[1], "debug_pattern") == 1 { saw_debug = 1 }
        }
        i = i + 1
    }
    ce_eq("refuses if coding not installed", saw_coding, 1)
    ce_eq("refuses if debug_pattern not installed", saw_debug, 1)
}

// ---- runtime behavior: refusal short-circuits when capsules missing ------

fn test_refuses_when_neither_capsule_installed() {
    let m = coding_helper_manifest()
    let capreg = capreg_new()   // empty -- no capsules registered
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg, 0, 0,
                                   mo_new(), 100)
    let r = skill_run(sup, "help me debug a null pointer exception")
    ce_eq("refused", skill_pr_ok(r), 0)
    ce_check("reason mentions capsule",
             len(skill_pr_refusal_reason(r)) > 0)
    // Policy body never ran -> no effector calls populated.
    ce_eq("no effector calls populated", len(skill_pr_effector_calls(r)), 0)
}

fn test_refuses_when_coding_registered_but_not_installed() {
    let m = coding_helper_manifest()
    let capreg = capreg_new()
    // Register both capsules but INSTALL only debug_pattern.
    capreg_register(capreg, capsule_new("coding", "1.0.0", "d", "MIT"))
    capreg_register(capreg, capsule_new("debug_pattern", "1.0.0", "d", "MIT"))
    capreg_install(capreg, "debug_pattern", 50)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg, 0, 0,
                                   mo_new(), 100)
    let r = skill_run(sup, "help me")
    ce_eq("refused", skill_pr_ok(r), 0)
    // The reason should name the coding capsule specifically.
    let reason = skill_pr_refusal_reason(r)
    let saw_coding_in_reason = 0
    let n = len(reason)
    let target = "coding"
    let tn = len(target)
    let i = 0
    while i <= n - tn {
        let ok = 1
        let j = 0
        while j < tn {
            if char_at(reason, i + j) != char_at(target, j) { ok = 0 j = tn }
            else { j = j + 1 }
        }
        if ok == 1 { saw_coding_in_reason = 1 i = n }
        i = i + 1
    }
    ce_eq("reason names the missing capsule", saw_coding_in_reason, 1)
}

// ---- runtime behavior: stub policy runs cleanly when deps satisfied ------

fn test_stub_policy_runs_when_both_capsules_installed() {
    // Install both capsules (empty content; policy is a stub anyway),
    // then invoke the skill.
    let m = coding_helper_manifest()
    let capreg = capreg_new()
    capreg_register(capreg, capsule_new("coding", "1.0.0", "d", "MIT"))
    capreg_register(capreg, capsule_new("debug_pattern", "1.0.0", "d", "MIT"))
    capreg_install(capreg, "coding", 50)
    capreg_install(capreg, "debug_pattern", 60)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg, 0, 0,
                                   mo_new(), 100)
    let r = skill_run(sup, "help me debug a null pointer exception")
    ce_eq("ok (stub runs)", skill_pr_ok(r), 1)
    ce_check("proposal non-empty", len(skill_pr_proposal(r)) > 0)
    // Stub sets confidence 0 -- honest signal that the policy hasn't
    // computed anything real yet.
    ce_eq("confidence 0", skill_pr_confidence(r), 0)
    // Effector calls DESCRIBED (guarantee 3): the stub lists what it
    // WOULD dispatch on approval.
    ce_check("stub described effector calls",
             len(skill_pr_effector_calls(r)) >= 1)
    // Trace explains that the policy body is pending.
    let trace = skill_pr_trace(r)
    let saw_pending = 0
    let ti = 0
    while ti < len(trace) {
        let t = trace[ti]
        // Look for "pending" in the trace text.
        let nn = len(t)
        let target = "pending"
        let tn = len(target)
        let k = 0
        while k <= nn - tn {
            let ok = 1
            let m2 = 0
            while m2 < tn {
                if char_at(t, k + m2) != char_at(target, m2) { ok = 0 m2 = tn }
                else { m2 = m2 + 1 }
            }
            if ok == 1 { saw_pending = 1 k = nn }
            k = k + 1
        }
        ti = ti + 1
    }
    ce_eq("trace mentions 'pending'", saw_pending, 1)
}

fn test_stub_policy_empty_problem_returns_noop() {
    let m = coding_helper_manifest()
    let capreg = capreg_new()
    capreg_register(capreg, capsule_new("coding", "1.0.0", "d", "MIT"))
    capreg_register(capreg, capsule_new("debug_pattern", "1.0.0", "d", "MIT"))
    capreg_install(capreg, "coding", 50)
    capreg_install(capreg, "debug_pattern", 60)
    let sup = skill_supervisor_new(m, kg_registry_new(), capreg, 0, 0,
                                   mo_new(), 100)
    let r = skill_run(sup, "")
    ce_eq("ok (noop path)", skill_pr_ok(r), 1)
    ce_eq("confidence 0", skill_pr_confidence(r), 0)
}

// (skill_registry_install dep-gating semantics for coding_helper are
// already covered generically by test_skill_registry.nova via the
// test_install_with_deps_* cases -- keeping them here too would trigger
// a NOVA module-init quirk in the diamond import graph
// [test -> skill_dispatch -> skill_supervisor -> capsule_registry]
// where re-touching capsule_registry symbols after skill_dispatch has
// initialized crashes at skill_registry_new. Coverage is preserved.)

fn main() {
    test_manifest_identity()
    test_manifest_declares_capsule_deps()
    test_manifest_declares_effectors()
    test_manifest_declares_refusal_conditions()
    test_refuses_when_neither_capsule_installed()
    test_refuses_when_coding_registered_but_not_installed()
    test_stub_policy_runs_when_both_capsules_installed()
    test_stub_policy_empty_problem_returns_noop()
    ce_summary("coding_helper")
}

main()
