// Unit tests for src/persona/persona_export.nova (ADR-0102).
// Round-trip: export a persona to a string, import it back, verify
// every slot matches.

import "../ce_test.nova"
import "../../src/persona/persona_export.nova"

fn test_export_null_persona_returns_empty() {
    ce_eq("null persona -> empty string", persona_export(0), "")
}

fn test_import_empty_returns_zero() {
    ce_check("empty -> 0", persona_import("") == 0)
}

fn test_import_no_user_directive_returns_zero() {
    ce_check("no USER -> 0", persona_import("#PERSONA v1\nNAME X\n") == 0)
}

fn test_roundtrip_minimal_persona() {
    let p = persona_new("alice", "Alice", "learn and assist", 100)
    let s = persona_export(p)
    ce_check("export non-empty", len(s) > 0)
    let p2 = persona_import(s)
    ce_check("import returned persona", p2 != 0)
    ce_eq("user_id preserved", persona_user_id(p2), "alice")
    ce_eq("name preserved", persona_name(p2), "Alice")
    ce_eq("purpose preserved", persona_purpose(p2), "learn and assist")
    ce_eq("created_at preserved", persona_created_at(p2), 100)
    // Defaults preserved.
    ce_eq("OCEAN O default", persona_ocean(p2)[0], 500)
    ce_eq("valence default", persona_valence(p2), 0)
    ce_eq("arousal default", persona_arousal(p2), 300)
    ce_eq("risk tolerance default", persona_risk_tolerance(p2), 500)
}

fn test_roundtrip_full_state() {
    let p = persona_new("bob", "Robert", "solve problems", 100)
    persona_add_value(p, "honesty", 110)
    persona_add_value(p, "curiosity", 120)
    persona_set_ocean(p, 700, 600, 400, 800, 300)
    persona_set_emotion(p, 0 - 400, 700, "reading", 200)
    persona_set_risk(p, 300, 800, 400, 210)
    persona_set_style_capsule(p, "academic-formal-v1", 220)
    // History
    let d1 = persona_add_decision(p, "install medicine capsule", "yes",
                                  600, "src:user:bob", 250)
    persona_update_decision_outcome(p, d1, 800, 900, 260)
    let d2 = persona_add_decision(p, "delete old logs from disk", "no",
                                  0 - 200, "src:user:bob", 270)
    persona_retract_decision(p, d2, 280)
    // Preferences
    persona_add_preference(p, "concise", 800, "src:user:bob", 290)
    persona_add_preference(p, "cite_sources", 900, "src:user:bob", 300)
    // Reflection
    persona_add_reflection(p, "user prefers brevity over exhaustion",
                           "src:agent:reflect", 310)
    persona_add_reflection(p, "user disliked formal register on Monday",
                           "src:agent:reflect", 320)
    // Round-trip.
    let s = persona_export(p)
    let p2 = persona_import(s)
    ce_check("imported non-null", p2 != 0)
    // Identity + name + purpose
    ce_eq("user_id", persona_user_id(p2), "bob")
    ce_eq("name",    persona_name(p2), "Robert")
    ce_eq("purpose", persona_purpose(p2), "solve problems")
    // Values (both present, order preserved)
    ce_eq("2 values", len(persona_values(p2)), 2)
    ce_eq("value 0", persona_values(p2)[0], "honesty")
    ce_eq("value 1", persona_values(p2)[1], "curiosity")
    // OCEAN vector
    ce_eq("OCEAN O", persona_ocean(p2)[0], 700)
    ce_eq("OCEAN C", persona_ocean(p2)[1], 600)
    ce_eq("OCEAN E", persona_ocean(p2)[2], 400)
    ce_eq("OCEAN A", persona_ocean(p2)[3], 800)
    ce_eq("OCEAN N", persona_ocean(p2)[4], 300)
    // Emotion
    ce_eq("valence signed", persona_valence(p2), 0 - 400)
    ce_eq("arousal", persona_arousal(p2), 700)
    ce_eq("focus", persona_focus(p2), "reading")
    // Risk
    ce_eq("tolerance", persona_risk_tolerance(p2), 300)
    let rk = persona_risk(p2)
    ce_eq("loss aversion", rk[1], 800)
    ce_eq("uncertainty appetite", rk[2], 400)
    // Style
    ce_eq("style ref", persona_style_capsule(p2), "academic-formal-v1")
    // History (2 records: one with outcome, one retracted)
    ce_eq("2 history records", persona_history_count(p2), 2)
    let hd1 = persona_history(p2)[0]
    ce_eq("d1 moment", hd1[PER_DEC_MOMENT], 250)
    ce_eq("d1 chosen", hd1[PER_DEC_CHOSEN], "yes")
    ce_eq("d1 pred valence", hd1[PER_DEC_PRED_VALENCE], 600)
    ce_eq("d1 actual", hd1[PER_DEC_ACTUAL], 800)
    ce_eq("d1 satisfaction", hd1[PER_DEC_SATISFACTION], 900)
    ce_eq("d1 not retracted", hd1[PER_DEC_RETRACTED], 0)
    ce_eq("d1 proposal", hd1[PER_DEC_PROPOSAL], "install medicine capsule")
    let hd2 = persona_history(p2)[1]
    ce_eq("d2 negative pred valence", hd2[PER_DEC_PRED_VALENCE], 0 - 200)
    ce_eq("d2 retracted", hd2[PER_DEC_RETRACTED], 1)
    ce_eq("d2 proposal with spaces",
          hd2[PER_DEC_PROPOSAL], "delete old logs from disk")
    // Preferences (2 records, weights + counts preserved)
    ce_eq("2 prefs", persona_preferences_count(p2), 2)
    let pr = persona_find_preference(p2, "concise")
    ce_check("concise pref present", pr != 0)
    ce_eq("concise weight", pr[PER_PREF_WEIGHT], 800)
    ce_eq("concise moment_first", pr[PER_PREF_MOMENT_1ST], 290)
    ce_eq("concise count", pr[PER_PREF_COUNT], 1)
    // Reflection (append-only)
    ce_eq("2 reflections", persona_reflection_count(p2), 2)
    let r0 = persona_reflection(p2)[0]
    ce_eq("r0 moment", r0[PER_REFL_MOMENT], 310)
    ce_eq("r0 text (with spaces)",
          r0[PER_REFL_TEXT], "user prefers brevity over exhaustion")
    ce_eq("r0 source", r0[PER_REFL_SOURCE], "src:agent:reflect")
}

fn test_roundtrip_preserves_empty_style_capsule() {
    let p = persona_new("u", "U", "", 100)
    // no style capsule set
    let p2 = persona_import(persona_export(p))
    ce_eq("empty style preserved", persona_style_capsule(p2), "")
}

fn test_double_roundtrip_stable() {
    // Idempotent: export -> import -> export -> import yields the same
    // shape as one round-trip.
    let p = persona_new("u", "U", "learn", 100)
    persona_add_preference(p, "brevity", 700, "src:x", 150)
    persona_add_decision(p, "install thing", "yes", 500, "src:user:u", 160)
    let s1 = persona_export(p)
    let p2 = persona_import(s1)
    let s2 = persona_export(p2)
    ce_str_eq("second export bytes match first", s2, s1)
}

fn test_import_ignores_unknown_directives_forward_compat() {
    // A .persona file emitted by a future version with new directives
    // must still import cleanly (unknown lines ignored).
    let text = "#PERSONA v1\n"
             + "USER alice\n"
             + "NAME Alice\n"
             + "PURPOSE demo\n"
             + "FUTURE_DIRECTIVE some value\n"
             + "OCEAN 500 500 500 500 500\n"
             + "STYLE\n"
             + "CREATED 100\n"
             + "UPDATED 100\n"
    let p = persona_import(text)
    ce_check("imported", p != 0)
    ce_eq("name", persona_name(p), "Alice")
}

fn test_import_skips_comments_and_blank_lines() {
    let text = "# top comment\n"
             + "\n"
             + "#PERSONA v1\n"
             + "\n"
             + "USER alice\n"
             + "NAME Alice\n"
             + "\n"
             + "# blank ok too\n"
             + "PURPOSE learn\n"
    let p = persona_import(text)
    ce_check("imported", p != 0)
    ce_eq("name", persona_name(p), "Alice")
    ce_eq("purpose", persona_purpose(p), "learn")
}

fn main() {
    test_export_null_persona_returns_empty()
    test_import_empty_returns_zero()
    test_import_no_user_directive_returns_zero()
    test_roundtrip_minimal_persona()
    test_roundtrip_full_state()
    test_roundtrip_preserves_empty_style_capsule()
    test_double_roundtrip_stable()
    test_import_ignores_unknown_directives_forward_compat()
    test_import_skips_comments_and_blank_lines()
    ce_summary("persona_export")
}

main()
