// Unit tests for src/io/transducers/image_canny.nova (P3.3 cont.).
//
// Hermetic coverage of the Canny edge detector: Gaussian smoothing +
// Sobel gradients + non-maximum suppression + hysteresis flood-fill.
// All fixtures are built in-memory (alloc + store8) so the suite never
// depends on an on-disk image. The integration test
// (scenario_q_image_see.sh) exercises the perception-path wiring; this
// unit suite focuses on the algorithm itself.
//
// Assertion targets (~20):
//   * Uniform grey 32x32 -> 0 edges.
//   * Sharp vertical step (left half white, right half black) -> a
//     single-pixel-wide column of edges near x=16 (single-pixel-wide
//     is the NMS guarantee that distinguishes Canny from Sobel).
//   * Diagonal step -> edges land along the diagonal.
//   * Hysteresis: a chain of weak-edge pixels connecting two strong
//     edges is kept; an ISOLATED weak edge is dropped.
//   * Canny edges are a STRICT SUBSET of Sobel edges (NMS + thresholding
//     always reduces).
//   * Density-label round-trip and density-milli math.
//   * Dimension caps reject 800x800; too-small images return empty.
//   * Result-tuple accessors return non-zero counts on a valid call.
//
// NOTE on assertion semantics: NMS is strict (> on both sides), so a
// flat magnitude ridge sometimes leaves NO pixel as the local max in a
// given direction-bin. The vertical-step fixture below uses a clean
// 0/255 transition where the L1-norm magnitude peaks sharply at one
// column, so NMS retains it cleanly. For diagonal steps the situation
// is symmetrical -- the diagonal direction bin has the peak ON the
// step.

import "../ce_test.nova"
import "../../src/io/transducers/image_canny.nova"
import "../../src/io/transducers/image_sobel.nova"

// ---- fixture builders --------------------------------------------------

fn _flat_fixture(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// Vertical step: left half value `low`, right half value `high`. With
// width=32, the step is at column 16.
fn _vertical_step_fixture(width, height, low, high) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = width / 2
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = low
            if x >= half { v = high }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Diagonal step: pixel (x, y) is `high` iff x > y; else `low`. Produces
// a 45-degree edge that the diagonal NMS bin should capture.
fn _diagonal_step_fixture(width, height, low, high) {
    let area = width * height
    let buf = alloc(area + 1)
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = low
            if x > y { v = high }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Two-strong-edges-with-weak-bridge fixture (16x16 byte buffer): two
// short 0-to-255 vertical step columns at y=4 and y=11, connected by a
// gentler ramp at y=5..10. The two ends produce STRONG magnitudes (a
// 255-step); the middle rows produce WEAK magnitudes (ramp of 1 per
// pixel). Without hysteresis the middle would be dropped; with
// hysteresis the chain is kept because it touches a strong edge.
fn _hysteresis_bridge_fixture() {
    let w = 16
    let h = 16
    let area = w * h
    let buf = alloc(area + 1)
    // Start with all-zero.
    let i = 0
    while i < area {
        store8(buf + i, 0)
        i = i + 1
    }
    // Strong vertical step at column 8 in rows 3..4 and 11..12: hard
    // 0-to-255 transition (right half white, left half black).
    // Weak ramp in rows 5..10: a single-row jump of 50 from column 7 -> 8.
    let y = 0
    while y < h {
        let row_off = y * w
        let strong = 0
        if y >= 3 {
            if y <= 4 { strong = 1 }
        }
        if y >= 11 {
            if y <= 12 { strong = 1 }
        }
        let weak = 0
        if y >= 5 {
            if y <= 10 { weak = 1 }
        }
        if strong == 1 {
            let x = 0
            while x < w {
                let v = 0
                if x >= 8 { v = 255 }
                store8(buf + row_off + x, v)
                x = x + 1
            }
        }
        if weak == 1 {
            let x = 0
            while x < w {
                let v = 100
                if x >= 8 { v = 155 }   // 55-step ramp
                store8(buf + row_off + x, v)
                x = x + 1
            }
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// ---- core happy-path tests ---------------------------------------------

fn test_uniform_grey_zero_edges() {
    let buf = _flat_fixture(32, 32, 128)
    let r = canny_detect(buf, 32, 32)
    ce_eq("uniform 32x32 edge_count == 0",
          canny_result_edge_count(r), 0)
    ce_eq("uniform 32x32 total == 1024",
          canny_result_total(r), 1024)
}

fn test_vertical_step_edges_concentrated_at_column() {
    // Width 32, step at column 16. The L1-norm magnitude peaks
    // sharply at column 15 (where the 3x3 kernel straddles the
    // transition). NMS keeps one pixel per row.
    let buf = _vertical_step_fixture(32, 32, 0, 255)
    let r = canny_detect(buf, 32, 32)
    let edges = canny_result_edges(r)
    let n = canny_result_edge_count(r)
    ce_check("vertical step produces > 0 edges", n > 0)
    // We expect ~32 edge pixels (one per interior row) but the
    // gaussian blur smears the transition, so the kernel border
    // (y=0 and y=31) get zeros. Real count is 30 +/- 4.
    ce_check("vertical step edge count is 25..38 (one per interior row)",
             n >= 25)
    ce_check("vertical step edge count is 25..38 (one per interior row)",
             n <= 38)
    // Walk every kept edge: x should be 14, 15, or 16 (the kernel
    // straddles the step from cols 14..16; gaussian smearing one px
    // either way).
    let i = 0
    let bad_x = 0
    while i < n {
        let e = edges[i]
        let ex = e[0]
        if ex < 13 { bad_x = bad_x + 1 }
        if ex > 17 { bad_x = bad_x + 1 }
        i = i + 1
    }
    ce_eq("every vertical-step edge has 13 <= x <= 17", bad_x, 0)
}

fn test_diagonal_step_edges_along_diagonal() {
    let buf = _diagonal_step_fixture(32, 32, 0, 255)
    let r = canny_detect(buf, 32, 32)
    let edges = canny_result_edges(r)
    let n = canny_result_edge_count(r)
    ce_check("diagonal step produces > 0 edges", n > 0)
    // Each kept edge should satisfy |x - y| <= 2 (the gaussian blur
    // smears the transition one or two pixels either way).
    let i = 0
    let off_diag = 0
    while i < n {
        let e = edges[i]
        let ex = e[0]
        let ey = e[1]
        let d = ex - ey
        if d < 0 { d = 0 - d }
        if d > 2 { off_diag = off_diag + 1 }
        i = i + 1
    }
    ce_eq("every diagonal-step edge satisfies |x-y| <= 2", off_diag, 0)
}

// ---- hysteresis test ---------------------------------------------------

fn test_hysteresis_chain_is_kept() {
    let buf = _hysteresis_bridge_fixture()
    let r = canny_detect(buf, 16, 16)
    let edges = canny_result_edges(r)
    let n = canny_result_edge_count(r)
    // We expect SOME edges from the strong + weak combined region. The
    // weak-bridge rows would be dropped by a no-hysteresis threshold;
    // here we just check the chain produced more edges than the strong
    // ends alone would have (the strong ends are ~4 rows total, so
    // edges from JUST those would be ~4-6 pixels).
    ce_check("hysteresis fixture produces > 4 edges (chain is kept)",
             n > 4)
}

// ---- Canny is a strict subset of Sobel --------------------------------

fn test_canny_subset_of_sobel() {
    // The defining property of NMS + thresholding is that it reduces
    // the edge set: every Canny edge MUST also be in the Sobel
    // above-threshold set (the magnitudes are the same; Canny just
    // applies more filtering).
    let buf = _vertical_step_fixture(32, 32, 0, 255)
    let canny_r = canny_detect(buf, 32, 32)
    let canny_edges = canny_result_edges(canny_r)
    let canny_n = canny_result_edge_count(canny_r)
    let sobel_r = sobel_apply(buf, 32, 32)
    let sobel_count = sobel_result_edge_count(sobel_r)
    let sobel_mag = sobel_result_magnitudes(sobel_r)
    // Reduction: canny_n must be <= sobel_count (strict reduction for
    // a clean vertical step where Sobel has thick edges).
    ce_check("canny edge count <= sobel edge count",
             canny_n <= sobel_count)
    // Verify every Canny edge has a non-zero Sobel magnitude there. We
    // can't directly check "above sobel threshold" because Canny
    // applies the Gaussian blur first and then thresholds in milli
    // units, so the magnitudes won't match exactly; but ANY Canny
    // edge should land at a Sobel-magnitude > 0 pixel (otherwise the
    // gradient there is zero and there's nothing for Canny to detect).
    let i = 0
    let zero_sobel = 0
    while i < canny_n {
        let e = canny_edges[i]
        let ex = e[0]
        let ey = e[1]
        let s = load8(sobel_mag + ey * 32 + ex)
        if s == 0 { zero_sobel = zero_sobel + 1 }
        i = i + 1
    }
    ce_eq("every canny edge lands on a non-zero sobel magnitude",
          zero_sobel, 0)
}

// ---- aggregate helpers ------------------------------------------------

fn test_density_milli() {
    // Uniform image: density 0.
    let flat = _flat_fixture(32, 32, 128)
    ce_eq("uniform 32x32 density milli == 0",
          canny_density_milli(flat, 32, 32), 0)
    // Vertical step: density is positive but less than Sobel's.
    let step = _vertical_step_fixture(32, 32, 0, 255)
    let d = canny_density_milli(step, 32, 32)
    ce_check("vertical step density milli > 0", d > 0)
    // Density label round-trip.
    ce_str_eq("density 5 -> low",
              canny_density_label(5), "image_canny_edges_low")
    ce_str_eq("density 30 -> mid",
              canny_density_label(30), "image_canny_edges_mid")
    ce_str_eq("density 250 -> high",
              canny_density_label(250), "image_canny_edges_high")
}

// ---- caps + edge cases ------------------------------------------------

fn test_dimension_cap_rejects_huge() {
    // 800x800 > CANNY_MAX_DIM (512). Apply must refuse without crashing.
    let dummy = alloc(8)
    let r = canny_detect(dummy, 800, 800)
    ce_eq("oversized image -> total == 0", canny_result_total(r), 0)
    ce_eq("oversized image -> edge_count == 0",
          canny_result_edge_count(r), 0)
}

fn test_too_small_image_returns_empty_edges() {
    // 2x2 image -> too small for the 3x3 kernel; we get an empty edge
    // list with total > 0.
    let buf = _flat_fixture(2, 2, 128)
    let r = canny_detect(buf, 2, 2)
    ce_eq("2x2 image -> total == 4", canny_result_total(r), 4)
    ce_eq("2x2 image -> edge_count == 0",
          canny_result_edge_count(r), 0)
}

fn test_result_accessors() {
    let buf = _vertical_step_fixture(32, 32, 0, 255)
    let r = canny_detect(buf, 32, 32)
    ce_check("canny_result_edges returns a list with > 0 entries",
             canny_result_edge_count(r) > 0)
    ce_eq("canny_result_total returns 1024 for 32x32",
          canny_result_total(r), 1024)
}

// ---- main -------------------------------------------------------------

fn main() {
    test_uniform_grey_zero_edges()
    test_vertical_step_edges_concentrated_at_column()
    test_diagonal_step_edges_along_diagonal()
    test_hysteresis_chain_is_kept()
    test_canny_subset_of_sobel()
    test_density_milli()
    test_dimension_cap_rejects_huge()
    test_too_small_image_returns_empty_edges()
    test_result_accessors()
    ce_summary("image_canny")
}

main()
