// Unit tests for src/scheduler/tick_loop.nova
// Verifies tick advancement, rate set/clamp, and active/idle throttling.
// ADR-0037.

import "../ce_test.nova"
import "../../src/scheduler/tick_loop.nova"

fn test_tick_loop() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 32, 4)
    let tl = tick_loop_new(reg)
    ce_eq("starts active rate", tl_rate(tl), TICK_RATE_ACTIVE)
    ce_eq("clock 0", tl_now(tl), 0)
    // Stimulate a node and tick.
    let pool = part_pool(registry_get(reg, registry_find(reg, "perception")))
    npm_node_input(pool, 0, 700)
    let fired = tl_tick(tl, TD_MOD_NEUTRAL, 0)
    ce_eq("clock advanced", tl_now(tl), 1)
    ce_check("a node fired", fired >= 1)
    // Rate control.
    tl_go_idle(tl)
    ce_eq("idle rate", tl_rate(tl), TICK_RATE_IDLE)
    tl_go_active(tl)
    ce_eq("active rate", tl_rate(tl), TICK_RATE_ACTIVE)
    // Clamping.
    ce_eq("clamp high", tl_set_rate(tl, 9999), TICK_RATE_ACTIVE)
    ce_eq("clamp low", tl_set_rate(tl, 1), TICK_RATE_IDLE)
}

fn main() { test_tick_loop() ce_summary("tick_loop") }
main()
