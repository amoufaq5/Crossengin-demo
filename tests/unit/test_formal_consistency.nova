// Runtime verification of the /consistency + /not chat commands at the API level
// (ADR-0088). The chat REPL binary cannot boot in this environment (a pre-existing
// NOVA-runtime startup segfault for that very large program -- the documented
// chat run-verification limitation), so we exercise the EXACT code path those two
// commands use, against a really-booted formal subsystem and a real KG:
//
//   /not P        -> fc_assert_imp(kg, "not_P", "P", "_FALSE_", ...)   (P -> FALSE)
//   /consistency  -> con_scan_axioms(_fc_proofs(), fc_env_axioms(), hyp_new())
//
// This proves the wiring is sound end-to-end except for the thin io_println shell.

import "../ce_test.nova"
import "../../src/agent/formal_chat.nova"
import "../../src/mind/recheck.nova"
import "../../src/mind/cascade.nova"
import "../../src/parts/reasoning/contradiction.nova"

// Boot a fresh formal subsystem + KG, returning [proofs, kgreg, kg, rck].
fn _boot() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let b = list_new()
    push(b, proofs) push(b, kgreg) push(b, kg) push(b, rck)
    return b
}

// The /not command path: asserting not-P stores (P -> FALSE) FORMAL, and the
// stored term IS the negation contradiction.nova recognizes.
fn test_not_command_stores_negation() {
    let b = _boot()
    let kg = b[2]
    // mirror _admin_not: fc_assert_imp(kg, "not_"+word, word, "_FALSE_", ...).
    let r = fc_assert_imp(kg, "not_rain", "rain", "_FALSE_", "user-taught")
    ce_eq("not-rain pins FORMAL", fc_state(r), CAND_PROMOTED)
    // the stored env term for not_rain is exactly (rain -> FALSE).
    let e = _fc_env_get("not_rain")
    ce_check("env has not_rain", e != 0)
    ce_eq("stored term is a negation", con_is_negation(_fc_env_term(e)), 1)
    ce_eq("its inner is the atom rain",
        term_eq(con_negated_of(_fc_env_term(e)), term_atom("rain")), 1)
    fc_boot(0, b[3])
}

// /consistency over a contradictory store: assert P and not-P, then the scan
// finds a kernel-certified FALSE.
fn test_consistency_detects_contradiction() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "rain", "user-taught")                     // /axiom rain
    fc_assert_imp(kg, "not_rain", "rain", "_FALSE_", "user-taught") // /not rain
    let axs = fc_env_axioms()
    ce_eq("two formal propositions", len(axs), 2)
    let r = con_scan_axioms(_fc_proofs(), axs, hyp_new())
    ce_eq("contradiction found", con_found(r), 1)
    ce_eq("witness verifies as FALSE",
        verify_check(_fc_proofs(), axs, hyp_new(), con_proof(r), con_false()), 1)
    ce_eq("store reported inconsistent",
        con_is_consistent(_fc_proofs(), axs, hyp_new()), 0)
    fc_boot(0, b[3])
}

// /consistency over a clean store: P and an unrelated Q, no contradiction.
fn test_consistency_clean_store() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "rain", "user-taught")
    fc_assert_axiom(kg, "wet", "user-taught")
    let axs = fc_env_axioms()
    ce_eq("two propositions", len(axs), 2)
    ce_eq("no contradiction", con_found(con_scan_axioms(_fc_proofs(), axs, hyp_new())), 0)
    ce_eq("store reported consistent",
        con_is_consistent(_fc_proofs(), axs, hyp_new()), 1)
    fc_boot(0, b[3])
}

// Holding only not-P (without P) is consistent -- FALSE is not derivable.
fn test_negation_alone_consistent() {
    let b = _boot()
    let kg = b[2]
    fc_assert_imp(kg, "not_rain", "rain", "_FALSE_", "user-taught")
    let axs = fc_env_axioms()
    ce_eq("not-P alone is consistent",
        con_is_consistent(_fc_proofs(), axs, hyp_new()), 1)
    fc_boot(0, b[3])
}

// An empty formal store is trivially consistent (the /consistency empty-store
// branch).
fn test_empty_store_consistent() {
    let b = _boot()
    let axs = fc_env_axioms()
    ce_eq("empty store", len(axs), 0)
    ce_eq("trivially consistent",
        con_is_consistent(_fc_proofs(), axs, hyp_new()), 1)
    fc_boot(0, b[3])
}

// The transitive /consistency path: assert P, P->Q, and not-Q as FORMAL. There
// is NO direct P + not-P pair, but con_scan_transitive derives Q via MP and the
// kernel then verifies FALSE. Mirrors what /consistency now runs internally.
fn test_consistency_detects_derived_contradiction() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")                           // P
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")                  // P -> Q
    fc_assert_imp(kg, "not_q", "q", "_FALSE_", "user-taught")         // not Q
    let axs = fc_env_axioms()
    // Direct scan finds nothing (no literal P + not P pair).
    ce_eq("direct scan misses derived",
        con_found(con_scan_axioms(_fc_proofs(), axs, hyp_new())), 0)
    // Transitive scan finds it AND the kernel verifies.
    let rt = con_scan_transitive(_fc_proofs(), axs, hyp_new(), 12)
    ce_eq("transitive scan finds derived contradiction", con_found(rt), 1)
    ce_eq("witness verifies as FALSE",
        verify_check(_fc_proofs(), axs, hyp_new(), con_proof(rt), con_false()), 1)
    fc_boot(0, b[3])
}

// The /consistency conflict-set report: /consistency now names the offending
// propositions. Mirrors: assert P, P->Q, not Q, plus irrelevant R; the reported
// conflict labels should be exactly {p, pq, not_q} and NOT r.
fn test_consistency_names_conflict_labels() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    fc_assert_imp(kg, "not_q", "q", "_FALSE_", "user-taught")
    fc_assert_axiom(kg, "r", "user-taught")                           // irrelevant
    let axs = fc_env_axioms()
    let cs = con_conflict_set(_fc_proofs(), axs, hyp_new(), 12)
    ce_eq("conflict found", con_cs_found(cs), 1)
    let used = con_cs_premises(cs)
    ce_eq("three premises used", len(used), 3)
    // reverse-lookup each used premise to its label.
    let saw_p = 0 let saw_pq = 0 let saw_notq = 0 let saw_r = 0
    let i = 0
    while i < len(used) {
        let lbl = fc_env_label_for(used[i])
        if _fc_label_eq(lbl, "p") == 1 { saw_p = 1 }
        if _fc_label_eq(lbl, "pq") == 1 { saw_pq = 1 }
        if _fc_label_eq(lbl, "not_q") == 1 { saw_notq = 1 }
        if _fc_label_eq(lbl, "r") == 1 { saw_r = 1 }
        i = i + 1
    }
    ce_eq("p in conflict", saw_p, 1)
    ce_eq("pq in conflict", saw_pq, 1)
    ce_eq("not_q in conflict", saw_notq, 1)
    ce_eq("r NOT in conflict", saw_r, 0)
    fc_boot(0, b[3])
}

// The minimal-revision suggestion: the newest premise in the conflict is
// flagged as the challenger. Insertion order: p, pq, r (irrelevant), then
// not_q added LAST -- so not_q should be the suggested retract.
fn test_consistency_suggests_newest_retract() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")                           // idx 0
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")                  // idx 1
    fc_assert_axiom(kg, "r", "user-taught")                           // idx 2 (irrelevant)
    fc_assert_imp(kg, "not_q", "q", "_FALSE_", "user-taught")         // idx 3 (newest)
    let axs = fc_env_axioms()
    let cs = con_conflict_set(_fc_proofs(), axs, hyp_new(), 12)
    ce_eq("conflict found", con_cs_found(cs), 1)
    let newest = fc_newest_in_conflict(con_cs_premises(cs))
    ce_eq("newest in conflict is not_q", _fc_label_eq(newest, "not_q"), 1)
    // Reorder sanity: index lookup returns the right positions.
    ce_eq("p at idx 0", fc_env_index_for(term_atom("p")), 0)
    ce_eq("not_q at idx 3",
        fc_env_index_for(term_imp(term_atom("q"), term_atom("_FALSE_"))), 3)
    ce_eq("unknown -> -1", fc_env_index_for(term_atom("zzz")), 0 - 1)
    fc_boot(0, b[3])
}

// The on-ingest guard: after each FORMAL assertion the chat runs the transitive
// scan and warns if the store is now inconsistent. Simulate the sequence: assert
// p, then p->q consistent; then not_q as the CHALLENGER -- at that point the
// scan MUST report inconsistency AND the challenger must be identified as the
// newest premise in the conflict.
fn test_ingest_guard_flags_challenger() {
    let b = _boot()
    let kg = b[2]
    // First two are individually consistent additions.
    fc_assert_axiom(kg, "p", "user-taught")
    let axs1 = fc_env_axioms()
    ce_eq("consistent after p",
        con_cs_found(con_conflict_set(_fc_proofs(), axs1, hyp_new(), 12)), 0)
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    let axs2 = fc_env_axioms()
    ce_eq("consistent after p, pq",
        con_cs_found(con_conflict_set(_fc_proofs(), axs2, hyp_new(), 12)), 0)
    // The challenger arrives -- the ingest guard would fire here.
    fc_assert_imp(kg, "not_q", "q", "_FALSE_", "user-taught")
    let axs3 = fc_env_axioms()
    let cs = con_conflict_set(_fc_proofs(), axs3, hyp_new(), 12)
    ce_eq("inconsistent after not_q", con_cs_found(cs), 1)
    // The challenger IS in the conflict.
    let used = con_cs_premises(cs)
    let in_conflict = 0
    let i = 0
    while i < len(used) {
        if _fc_label_eq(fc_env_label_for(used[i]), "not_q") == 1 { in_conflict = 1 }
        i = i + 1
    }
    ce_eq("challenger in conflict", in_conflict, 1)
    // And it IS the newest premise -- the retraction suggestion.
    ce_eq("challenger is newest",
        _fc_label_eq(fc_newest_in_conflict(used), "not_q"), 1)
    fc_boot(0, b[3])
}

// Boundary: an assertion that doesn't introduce a contradiction produces no
// hit -- the guard silently no-ops.
fn test_ingest_guard_silent_on_consistent() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "a", "user-taught")
    fc_assert_axiom(kg, "b", "user-taught")
    fc_assert_imp(kg, "ab", "a", "b", "user-taught")
    let axs = fc_env_axioms()
    ce_eq("still consistent after ab",
        con_cs_found(con_conflict_set(_fc_proofs(), axs, hyp_new(), 12)), 0)
    fc_boot(0, b[3])
}

// ---- /retract: the second half of the truth-seeking loop -----------------
// Retract removes a FORMAL proposition and returns the cascade counts. After
// retracting the challenger identified by /consistency, the store is
// consistent again.
fn test_retract_restores_consistency() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    fc_assert_imp(kg, "not_q", "q", "_FALSE_", "user-taught")
    let axs_before = fc_env_axioms()
    ce_eq("inconsistent before retract",
        con_cs_found(con_conflict_set(_fc_proofs(), axs_before, hyp_new(), 12)), 1)
    // Retract the newest challenger.
    let r = fc_retract_with(kgreg, "not_q")
    ce_eq("retract succeeded", fc_ret_status(r), 1)
    ce_check("at least one atom unpinned", fc_ret_unpinned(r) >= 1)
    // Store is now consistent, and not_q is gone.
    let axs_after = fc_env_axioms()
    ce_eq("consistent after retract",
        con_cs_found(con_conflict_set(_fc_proofs(), axs_after, hyp_new(), 12)), 0)
    ce_eq("env shrunk", len(axs_after), len(axs_before) - 1)
    ce_eq("not_q unknown", fc_env_index_for(term_imp(term_atom("q"), term_atom("_FALSE_"))), 0 - 1)
    fc_boot(0, b[3])
}

// Retract cascades: a THEOREM derived by MP is unpinned when its premise is
// retracted. Assert p + p->q + derive q via MP; retract p; q must also be
// unpinned in the cascade.
fn test_retract_cascades_to_theorem() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    let dq = fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    ce_eq("q derived FORMAL", atom_evidence_grade(fc_atom(dq)), GRADE_FORMAL)
    let q_atom = fc_atom(dq)
    // Retract the root premise p; q must cascade to non-FORMAL.
    let r = fc_retract_with(kgreg, "p")
    ce_eq("retract succeeded", fc_ret_status(r), 1)
    ce_check("cascade unpinned >= 2 (p, q)", fc_ret_unpinned(r) >= 2)
    ce_eq("q withdrawn to UNKNOWN", atom_evidence_grade(q_atom), GRADE_UNKNOWN)
    fc_boot(0, b[3])
}

// Retracting an unknown label is a no-op that reports status 0.
fn test_retract_unknown_is_no_op() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    let r = fc_retract_with(kgreg, "nonexistent")
    ce_eq("no-op status", fc_ret_status(r), 0)
    // p still there.
    ce_eq("p still known", fc_env_index_for(term_atom("p")), 0)
    fc_boot(0, b[3])
}

// ---- /derivation LABEL: render any FORMAL proof ---------------------------
// An axiom's derivation is a single "assume" line naming the atom.
fn test_derivation_axiom_renders() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "rain", "user-taught")
    let proof = fc_env_proof_for("rain")
    ce_check("proof retrievable", proof != 0)
    let text = con_render_proof(proof)
    ce_check("mentions rain", str_find(text, "rain") != (0 - 1))
    ce_check("uses 'assume'", str_find(text, "assume") != (0 - 1))
    ce_check("is a single numbered step", str_find(text, "1.") != (0 - 1))
    fc_boot(0, b[3])
}

// A DERIVED theorem's proof renders the MP step. /derive q from pq and p:
// the rendered derivation cites both premises and MP.
fn test_derivation_derived_theorem_renders() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    let text = con_render_proof(fc_env_proof_for("q"))
    ce_check("mentions MP", str_find(text, "MP") != (0 - 1))
    ce_check("cites step numbers", str_find(text, "step") != (0 - 1))
    ce_check("concludes with q", str_find(text, "q") != (0 - 1))
    fc_boot(0, b[3])
}

// Unknown labels return 0 (no proof) -- the /derivation command reports it
// cleanly rather than crashing.
fn test_derivation_unknown_returns_zero() {
    let b = _boot()
    ce_eq("unknown -> 0", fc_env_proof_for("nonexistent"), 0)
    fc_boot(0, b[3])
}

// After retract, the proof for that label is gone too.
fn test_derivation_gone_after_retract() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    ce_check("proof present before retract", fc_env_proof_for("p") != 0)
    fc_retract_with(kgreg, "p")
    ce_eq("proof gone after retract", fc_env_proof_for("p"), 0)
    fc_boot(0, b[3])
}

// ---- retraction audit log --------------------------------------------------
// Boot leaves the log empty; each retract appends; count matches.
fn test_retraction_log_empty_at_boot() {
    let b = _boot()
    ce_eq("empty at boot", fc_retraction_count(), 0)
    fc_boot(0, b[3])
}

fn test_retraction_log_appends() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_axiom(kg, "q", "user-taught")
    ce_eq("log empty after asserts", fc_retraction_count(), 0)
    fc_retract_with(kgreg, "p")
    ce_eq("one entry after first retract", fc_retraction_count(), 1)
    fc_retract_with(kgreg, "q")
    ce_eq("two entries after second retract", fc_retraction_count(), 2)
    // Each entry records label + source + cascade counts.
    let log = fc_retraction_log()
    ce_eq("entry 0 label is 'p'", _fc_label_eq(fc_rle_label(log[0]), "p"), 1)
    ce_eq("entry 0 source recorded",
        _fc_label_eq(fc_rle_source(log[0]), "user-taught"), 1)
    ce_check("entry 0 unpinned >= 1", fc_rle_unpinned(log[0]) >= 1)
    ce_eq("entry 1 label is 'q'", _fc_label_eq(fc_rle_label(log[1]), "q"), 1)
    fc_boot(0, b[3])
}

// A no-op retract (unknown label) does NOT append to the log.
fn test_retraction_log_ignores_unknown() {
    let b = _boot()
    let kgreg = b[1]
    fc_retract_with(kgreg, "nonexistent")
    ce_eq("log empty after unknown retract", fc_retraction_count(), 0)
    fc_boot(0, b[3])
}

// fc_boot resets the log.
fn test_retraction_log_resets_on_boot() {
    let b = _boot()
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_retract_with(b[1], "p")
    ce_eq("one entry", fc_retraction_count(), 1)
    // Fresh boot.
    let b2 = _boot()
    ce_eq("cleared on boot", fc_retraction_count(), 0)
    fc_boot(0, b2[3])
}

// Cascade counts are captured: derive q from p+pq, retract p, entry records
// the cascade extent (>=2 atoms unpinned).
fn test_retraction_log_captures_cascade() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    fc_retract_with(kgreg, "p")
    let log = fc_retraction_log()
    ce_check("cascade captured (>= 2 atoms)", fc_rle_unpinned(log[0]) >= 2)
    ce_check("flipped count non-negative", fc_rle_flipped(log[0]) >= 0)
    fc_boot(0, b[3])
}

fn main() {
    test_not_command_stores_negation()
    test_consistency_detects_contradiction()
    test_consistency_clean_store()
    test_negation_alone_consistent()
    test_empty_store_consistent()
    test_consistency_detects_derived_contradiction()
    test_consistency_names_conflict_labels()
    test_consistency_suggests_newest_retract()
    test_ingest_guard_flags_challenger()
    test_ingest_guard_silent_on_consistent()
    test_retract_restores_consistency()
    test_retract_cascades_to_theorem()
    test_retract_unknown_is_no_op()
    test_derivation_axiom_renders()
    test_derivation_derived_theorem_renders()
    test_derivation_unknown_returns_zero()
    test_derivation_gone_after_retract()
    test_retraction_log_empty_at_boot()
    test_retraction_log_appends()
    test_retraction_log_ignores_unknown()
    test_retraction_log_resets_on_boot()
    test_retraction_log_captures_cascade()
    ce_summary("formal_consistency")
}

main()
