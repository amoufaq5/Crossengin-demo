// Unit tests for src/language/syntax_atoms.nova
// Verifies syntax-pattern creation, role ordering on apply (the core
// word-ordering operation for generation), completeness checks, and belief
// updates. ADR-0015, ADR-0013.

import "../ce_test.nova"
import "../../src/language/syntax_atoms.nova"

fn roles(items) {
    let l = list_new()
    let i = 0
    while i < len(items) { push(l, items[i]); i = i + 1 }
    return l
}

fn assign(r, f) {
    let p = list_new(); push(p, r); push(p, f); return p
}

fn test_pattern() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let s = syntax_atom_new(lang, "svo", roles(["AGENT", "ACTION", "PATIENT"]), 0)
    ce_eq("is syntax", is_syntax_atom(s), 1)
    ce_eq("ltype LSYNTAX", lang_type(s), LSYNTAX)
    ce_eq("three slots", syntax_slot_count(s), 3)
    ce_check("find by name", syntax_find(lang, "svo") != 0)
    // A word atom is not a syntax atom.
    ce_eq("word not syntax", is_syntax_atom(word_atom_new(lang, "dog", 0)), 0)
}

fn test_ordering() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let s = syntax_atom_new(lang, "svo", roles(["AGENT", "ACTION", "PATIENT"]), 0)
    // Fillers supplied out of order; apply imposes the pattern order.
    let fillers = list_new()
    push(fillers, assign("PATIENT", "ball"))
    push(fillers, assign("AGENT", "dog"))
    push(fillers, assign("ACTION", "chase"))
    let out = syntax_apply(s, fillers)
    ce_eq("three words", len(out), 3)
    ce_str_eq("ordered: agent", out[0], "dog")
    ce_str_eq("ordered: action", out[1], "chase")
    ce_str_eq("ordered: patient", out[2], "ball")
    ce_eq("complete", syntax_complete(s, fillers), 1)
    // Missing a role: skipped in output, not complete.
    let partial = list_new()
    push(partial, assign("AGENT", "cat"))
    push(partial, assign("ACTION", "sleep"))
    ce_eq("missing role -> incomplete", syntax_complete(s, partial), 0)
    ce_eq("partial output skips missing", len(syntax_apply(s, partial)), 2)
}

fn test_belief() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let s = syntax_atom_new(lang, "svo", roles(["A", "B"]), 0)
    ce_eq("uniform reliability", syntax_confidence(s), 500)
    syntax_observe(s, 1); syntax_observe(s, 1)
    ce_eq("strengthens on success", syntax_confidence(s), 750)
}

fn main() {
    test_pattern()
    test_ordering()
    test_belief()
    ce_summary("syntax_atoms")
}

main()
