// Unit tests for src/parts/emotion/plasticity_mod.nova
// Verifies emotion->plasticity modulator (neutral, arousal boost, combined) and
// arousal-scaled episodic encoding. ADR-0035, ADR-0007, ADR-0022.

import "../ce_test.nova"
import "../../src/parts/emotion/plasticity_mod.nova"

fn test_modulator() {
    // Neutral emotion -> neutral modulator.
    ce_eq("neutral modulator", emotion_modulate_plasticity(500, 0, 500), 1000)
    // Full arousal doubles plasticity.
    ce_eq("arousal boosts", emotion_modulate_plasticity(500, 1000, 500), 2000)
    // Combined valence + arousal + reward: 1000 + 500 + 400 + 240 = 2140.
    ce_eq("combined", emotion_modulate_plasticity(900, 500, 900), 2140)
    // Punishment (reward < neutral) lowers the modulator.
    ce_check("punishment lowers", emotion_modulate_plasticity(500, 0, 100) < 1000)
}

fn test_encoding() {
    ce_eq("no arousal -> 1.0", emotion_episodic_encoding(0), 1000)
    ce_eq("full arousal -> 2.0", emotion_episodic_encoding(1000), 2000)
    ce_eq("mid arousal", emotion_episodic_encoding(500), 1500)
}

fn main() {
    test_modulator()
    test_encoding()
    ce_summary("emotion_plasticity_mod")
}

main()
