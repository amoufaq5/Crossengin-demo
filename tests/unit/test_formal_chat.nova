    // A non-mirroring pair is rejected.
    fc_assert_imp(kg, "bc", "b", "c", "user-taught")
    let bad = fc_prove_iff(kg, "x", "ab", "bc", "user-taught")
    ce_eq("non-mirror IFF -> REJECTED", fc_state(bad), CAND_REJECTED)
    fc_boot(0, rck)
}

// A composed implication cascades when one of its source implications is pulled.
fn test_hs_cascade() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_imp(kg, "ab", "a", "b", "user-taught")
    fc_assert_imp(kg, "bc", "b", "c", "user-taught")
    let ac = fc_prove_hs(kg, "ac", "ab", "bc", "user-taught")
    ce_eq("ac FORMAL before", atom_evidence_grade(fc_atom(ac)), GRADE_FORMAL)
    // invalidate ab -> ac (which rests on it via HYP) must withdraw.
    let code_ab = _fc_env_code(_fc_env_get("ab"))
    let casc = verify_cascade_invalidate(proofs, kgreg, code_ab)
    ce_check("cascade unpinned >= 2 (ab, ac)", cascade_unpinned(casc) >= 2)
    ce_eq("ac withdrawn", atom_evidence_grade(fc_atom(ac)), GRADE_UNKNOWN)
    fc_boot(0, rck)
}

// ---- cross-session persistence (increment 13) ------------------------------
// Build a small proof environment (axiom + MP-derived theorem + AND), snapshot
// it, then restore into a FRESH proofs registry + KG and confirm everything is
// re-pinned FORMAL -- by re-running the kernel, not by trusting persisted state.
fn test_snapshot_restore_roundtrip() {
    // session 1: assert + derive.
    let proofs1 = proof_registry_new()
    let rck1 = rck_new()
    fc_boot(proofs1, rck1)
    let kgreg1 = kg_registry_new()
    let kg1 = kg_spawn(kgreg1, "math")
    fc_assert_axiom(kg1, "p", "user-taught")
    fc_assert_imp(kg1, "pq", "p", "q", "user-taught")
    fc_prove_mp(kg1, "q", "pq", "p", "user-taught")
    fc_assert_axiom(kg1, "r", "user-taught")
    fc_prove_and(kg1, "q_and_r", "q", "r", "user-taught")
    ce_eq("5 env entries", fc_env_count(), 5)
    let snap = fc_snapshot()
    ce_check("snapshot non-empty", len(snap) > 0)

    // session 2: fresh everything, restore from the snapshot.
    let proofs2 = proof_registry_new()
    let rck2 = rck_new()
    fc_boot(proofs2, rck2)
    let kgreg2 = kg_registry_new()
    let kg2 = kg_spawn(kgreg2, "math")
    ce_eq("env empty before restore", fc_env_count(), 0)
    let restored = fc_restore(kg2, snap)
    ce_eq("all 5 re-derived", restored, 5)
    ce_eq("env repopulated", fc_env_count(), 5)
    // the derived theorem is FORMAL again -- re-verified, not trusted.
    let q_atom = fc_atom(fc_assert_axiom(kg2, "q", "user-taught"))   // looks up q
    ce_eq("restored q is FORMAL", atom_evidence_grade(q_atom), GRADE_FORMAL)
    // and the restored proofs auto-register for re-check.
    ce_check("restored proofs registered", rck_count(rck2) >= 5)
    fc_boot(0, rck2)
}

// Soundness under restore: a restored derived theorem still CASCADES when its
// root premise is withdrawn -- the dependency edges were rebuilt by re-running
// the kernel, not copied.
fn test_restore_preserves_cascade() {
    let proofs1 = proof_registry_new()
    let rck1 = rck_new()
    fc_boot(proofs1, rck1)
    let kgreg1 = kg_registry_new()
    let kg1 = kg_spawn(kgreg1, "math")
    fc_assert_axiom(kg1, "p", "user-taught")
    fc_assert_imp(kg1, "pq", "p", "q", "user-taught")
    fc_prove_mp(kg1, "q", "pq", "p", "user-taught")
    let snap = fc_snapshot()

    let proofs2 = proof_registry_new()
    let rck2 = rck_new()
    fc_boot(proofs2, rck2)
    let kgreg2 = kg_registry_new()
    let kg2 = kg_spawn(kgreg2, "math")
    fc_restore(kg2, snap)
    // invalidate p in the RESTORED registry; q must cascade.
    let q_atom = _fc_env_atom(_fc_env_get("q"))
    let code_p = _fc_env_code(_fc_env_get("p"))
    let casc = verify_cascade_invalidate(proofs2, kgreg2, code_p)
    ce_check("restored cascade unpinned >= 2", cascade_unpinned(casc) >= 2)
    ce_eq("restored q withdrawn", atom_evidence_grade(q_atom), GRADE_UNKNOWN)
    fc_boot(0, rck2)
}

// A tampered persisted proof is NOT re-pinned on restore (restore re-verifies).
// Hand-build a snapshot whose proof is bogus (axiom p, claiming q) and confirm
// fc_restore refuses it.
fn test_restore_rejects_tampered() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // snapshot for one entry "q" whose proof is an axiom of p (won't verify q).
    let out = list_new()
    push(out, "1")                       // one entry
    push(out, "q")                       // label
    push(out, "user-taught")             // src
    term_ser(out, term_atom("q"))        // claim = q
    term_list_ser(out, _ax(term_atom("p")))  // axioms = {p}
    proof_ser(out, pf_axiom(term_atom("p")))  // proof = axiom p (proves p, not q)
    let snap = _ps_join(out)
    let restored = fc_restore(kg, snap)
    ce_eq("tampered entry NOT restored", restored, 0)
    ce_eq("env stays empty", fc_env_count(), 0)
    fc_boot(0, rck)
}

// ---- arithmetic at the seam (increment 15) ---------------------------------
fn test_arith_proves_and_refuses() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // 2 + 2 = 4 -> FORMAL.
    let ok = fc_prove_arith(kg, "two_plus_two", 2, FC_OP_ADD, 2, 4)
    ce_eq("2+2=4 promoted", fc_state(ok), CAND_PROMOTED)
    ce_eq("2+2=4 FORMAL", atom_evidence_grade(fc_atom(ok)), GRADE_FORMAL)
    // 6 * 7 = 42 -> FORMAL.
    let ok2 = fc_prove_arith(kg, "six_times_seven", 6, FC_OP_MUL, 7, 42)
    ce_eq("6*7=42 promoted", fc_state(ok2), CAND_PROMOTED)
    // 3 + 3 = 7 -> the kernel refuses; NOT promoted (CAND_CANDIDATE).
    let bad = fc_prove_arith(kg, "bad_sum", 3, FC_OP_ADD, 3, 7)
    ce_eq("3+3=7 NOT promoted", fc_state(bad), CAND_CANDIDATE)
    ce_check("3+3=7 NOT formal",
        atom_evidence_grade(fc_atom(bad)) != GRADE_FORMAL)
    // 10 - 4 = 6 -> FORMAL.
    let sub = fc_prove_arith(kg, "ten_minus_four", 10, FC_OP_SUB, 4, 6)
    ce_eq("10-4=6 promoted", fc_state(sub), CAND_PROMOTED)
    // 6 / 2 = 3 -> FORMAL (exact).
    let div = fc_prove_arith(kg, "six_div_two", 6, FC_OP_DIV, 2, 3)
    ce_eq("6/2=3 promoted", fc_state(div), CAND_PROMOTED)
    // 7 / 2 = 3 -> refused (inexact; the engine won't round).
    let inex = fc_prove_arith(kg, "bad_div", 7, FC_OP_DIV, 2, 3)
    ce_eq("7/2=3 NOT promoted", fc_state(inex), CAND_CANDIDATE)
    fc_boot(0, rck)
}

// ---- quantifiers at the seam (increment 17): the Socrates syllogism ---------
fn test_syllogism_at_seam() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // forall x.(human(x) -> mortal(x)) ; human(socrates).
    let law = fc_assert_forall_imp(kg, "mortality_law", "human", "mortal")
    ce_eq("universal law FORMAL", fc_state(law), CAND_PROMOTED)
    let fact = fc_assert_pred(kg, "soc_human", "human", "socrates")
    ce_eq("fact FORMAL", fc_state(fact), CAND_PROMOTED)
    // derive mortal(socrates) by UI + MP.
    let r = fc_prove_syllogism(kg, "soc_mortal", "mortality_law", "soc_human")
    ce_eq("syllogism derived", fc_state(r), CAND_PROMOTED)
    ce_eq("mortal(socrates) FORMAL", atom_evidence_grade(fc_atom(r)), GRADE_FORMAL)
    ce_check("mortal(socrates) pinned high", atom_confidence(fc_atom(r)) > 990)
    fc_boot(0, rck)
}

// A fact that doesn't match the law's antecedent -> REJECTED. The law is about
// humans; a fact dog(rex) cannot drive it.
fn test_syllogism_mismatch_rejected() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_forall_imp(kg, "mortality_law", "human", "mortal")
    fc_assert_pred(kg, "rex_dog", "dog", "rex")
    let bad = fc_prove_syllogism(kg, "rex_mortal", "mortality_law", "rex_dog")
    ce_eq("mismatched fact -> REJECTED", fc_state(bad), CAND_REJECTED)
    fc_boot(0, rck)
}

// The derived predicate theorem persists + restores (the quantifier-derived
// proof survives a snapshot round-trip, re-verified).
fn test_syllogism_persists() {
    let proofs1 = proof_registry_new()
    let rck1 = rck_new()
    fc_boot(proofs1, rck1)
    let kgreg1 = kg_registry_new()
    let kg1 = kg_spawn(kgreg1, "math")
    fc_assert_forall_imp(kg1, "law", "human", "mortal")
    fc_assert_pred(kg1, "soc_h", "human", "socrates")
    fc_prove_syllogism(kg1, "soc_m", "law", "soc_h")
    let snap = fc_snapshot()
    // fresh session, restore.
    let proofs2 = proof_registry_new()
    let rck2 = rck_new()
    fc_boot(proofs2, rck2)
    let kgreg2 = kg_registry_new()
    let kg2 = kg_spawn(kgreg2, "math")
    let n = fc_restore(kg2, snap)
    ce_eq("all 3 (law, fact, theorem) restored", n, 3)
    fc_boot(0, rck2)
}

// ---- proof search over the env (increment 18) ------------------------------
// After asserting a universal law + a fact, the engine can AUTO-DERIVE the
// conclusion via fc_can_derive (search), with no /syllogism step.
fn test_search_over_env() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_forall_imp(kg, "law", "human", "mortal")
    fc_assert_pred(kg, "soc", "human", "socrates")
    // can we derive mortal(socrates)? yes (UI + MP found by search).
    ce_eq("auto-derives mortal(socrates)",
        fc_can_derive("mortal", "socrates"), 1)
    // can we derive immortal(socrates)? no -- not entailed.
    ce_eq("does not derive immortal(socrates)",
        fc_can_derive("immortal", "socrates"), 0)
    // can we derive mortal(plato)? no -- no fact human(plato).
    ce_eq("does not derive mortal(plato) (no fact)",
        fc_can_derive("mortal", "plato"), 0)
    fc_boot(0, rck)
}

fn main() {
    test_arith_proves_and_refuses()
    test_search_over_env()
    test_syllogism_at_seam()
    test_syllogism_mismatch_rejected()
    test_syllogism_persists()
    test_not_booted_is_safe()
    test_user_axiom_pins_formal()
    test_unclean_source_quarantines()
    test_reassert_pins_both()
    test_render()
    test_modus_ponens_derives_theorem()
    test_prove_unknown_premise_rejected()
    test_prove_shape_mismatch_rejected()
    test_derived_theorem_cascades()
    test_derived_theorem_registered()
    test_render_proof()
    test_and_intro_and_elim()
    test_and_elim_wrong_name_rejected()
    test_and_unknown_rejected()
    test_chained_proof_deep_cascade()
    test_hs_composes_implications()
    test_hs_mismatch_rejected()
    test_iff_intro_at_seam()
    test_hs_cascade()
    test_snapshot_restore_roundtrip()
    test_restore_preserves_cascade()
    test_restore_rejects_tampered()
    ce_summary("formal_chat")
}

main()
