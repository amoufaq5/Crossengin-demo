// Unit tests for src/agent/formal_chat.nova: the live /axiom seam that brings
// FORMAL ingest into the chat turn loop (ADR-0088). Asserting an axiom mints +
// kernel-verifies + pins it FORMAL, registers it for the periodic re-check
// sweep, and is gated by the license check -- all the FORMAL machinery, reached
// from a chat command.

import "../ce_test.nova"
import "../../src/agent/formal_chat.nova"
import "../../src/mind/recheck.nova"
import "../../src/mind/cascade.nova"

fn _ax(t) { let tbl = axiom_table_new() axiom_table_add(tbl, t) return tbl }

fn test_not_booted_is_safe() {
    // Before fc_boot, the helper refuses cleanly (no fault, no pin).
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "math")
    ce_eq("not booted", fc_is_booted(), 0)
    let r = fc_assert_axiom(kg, "refl", "user-taught")
    ce_eq("returns CANDIDATE when unbooted", fc_state(r), CAND_CANDIDATE)
}

fn test_user_axiom_pins_formal() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    ce_eq("booted", fc_is_booted(), 1)

    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // "user-taught" -> LICENSE_OWNER (clean) -> the axiom pins FORMAL.
    let r = fc_assert_axiom(kg, "reflexivity", "user-taught")
    ce_eq("promoted", fc_state(r), CAND_PROMOTED)
    let atom = fc_atom(r)
    ce_eq("grade FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
    ce_check("belief pinned high", atom_confidence(atom) > 990)
    ce_check("proof_ref stamped", atom_proof_ref(atom) > 0)
    // auto-registered for the periodic re-check sweep.
    ce_eq("registered for re-check", rck_count(rck), 1)
    // and a clean sweep confirms it still holds.
    let sweep = rck_sweep(proofs, kgreg, rck)
    ce_eq("re-check finds it valid", rck_failed(sweep), 0)
    fc_boot(0, rck)   // reset proofs handle for isolation
}

fn test_unclean_source_quarantines() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // an unrecognized source -> UNKNOWN license -> quarantine (Rule 3).
    let r = fc_assert_axiom(kg, "dubious", "rando-blog:Dubious")
    ce_eq("quarantined", fc_state(r), CAND_QUARANTINED)
    ce_check("NOT formal", atom_evidence_grade(fc_atom(r)) != GRADE_FORMAL)
    ce_eq("not registered for re-check", rck_count(rck), 0)
    fc_boot(0, rck)
}

// Re-asserting the same axiom pins FORMAL both times. (Whether it re-uses the
// existing atom depends on kg_find_atom -> str_eq, which is launcher-flaky here;
// the load-bearing property is that each assertion verifies and pins.)
fn test_reassert_pins_both() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let r1 = fc_assert_axiom(kg, "identity", "user-taught")
    let r2 = fc_assert_axiom(kg, "identity", "user-taught")
    ce_eq("first pins FORMAL", atom_evidence_grade(fc_atom(r1)), GRADE_FORMAL)
    ce_eq("second pins FORMAL", atom_evidence_grade(fc_atom(r2)), GRADE_FORMAL)
    fc_boot(0, rck)
}

// Render strings are non-empty and distinguish the outcomes.
fn test_render() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let ok = fc_assert_axiom(kg, "ax1", "user-taught")
    ce_check("promoted render mentions FORMAL",
        str_find(fc_render(ok, "ax1"), "FORMAL") >= 0)
    let bad = fc_assert_axiom(kg, "ax2", "rando:X")
    ce_check("quarantine render mentions quarantined",
        str_find(fc_render(bad, "ax2"), "quarantined") >= 0)
    fc_boot(0, rck)
}

// ---- /prove: derived theorems ----------------------------------------------
// Assert p and (p -> q) as FORMAL axioms, then derive q by modus ponens. The
// derived theorem is FORMAL, and -- critically -- it cascades when a premise is
// withdrawn (the dep edges the kernel recorded via the HYP steps).
fn _setup_proof_env() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // p (atom axiom) and pq := (p -> q) (implication axiom).
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    let b = list_new()
    push(b, proofs) push(b, kgreg) push(b, kg) push(b, rck)
    return b
}

fn test_modus_ponens_derives_theorem() {
    let b = _setup_proof_env()
    let kg = b[2]
    // derive q from pq:(p->q) and p.
    let r = fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    ce_eq("q derived + promoted", fc_state(r), CAND_PROMOTED)
    ce_eq("q is FORMAL", atom_evidence_grade(fc_atom(r)), GRADE_FORMAL)
    ce_check("q pinned high", atom_confidence(fc_atom(r)) > 990)
}

// An unknown premise -> REJECTED (ill-formed request, not a kernel failure).
fn test_prove_unknown_premise_rejected() {
    let b = _setup_proof_env()
    let kg = b[2]
    let r = fc_prove_mp(kg, "z", "nonexistent", "p", "user-taught")
    ce_eq("unknown premise -> REJECTED", fc_state(r), CAND_REJECTED)
}

// A shape mismatch (implication isn't p -> <concl>) -> REJECTED.
fn test_prove_shape_mismatch_rejected() {
    let b = _setup_proof_env()
    let kg = b[2]
    // pq is (p -> q); asking to derive "r" from it is a mismatch.
    let r = fc_prove_mp(kg, "r", "pq", "p", "user-taught")
    ce_eq("shape mismatch -> REJECTED", fc_state(r), CAND_REJECTED)
}

// The load-bearing property: a DERIVED theorem cascades when its premise is
// invalidated. Derive q, then cascade-invalidate p's proof -> q must be
// withdrawn (the HYP dep edge from p to q does its job through /prove).
fn test_derived_theorem_cascades() {
    let b = _setup_proof_env()
    let proofs = b[0]
    let kgreg = b[1]
    let kg = b[2]
    let pr = fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    let q_atom = fc_atom(pr)
    ce_eq("q FORMAL before", atom_evidence_grade(q_atom), GRADE_FORMAL)
    // Invalidate p (the antecedent premise) and cascade.
    let p_entry = _fc_env_get("p")
    let code_p = _fc_env_code(p_entry)
    let casc = verify_cascade_invalidate(proofs, kgreg, code_p)
    ce_check("cascade unpinned >= 2 (p and q)", cascade_unpinned(casc) >= 2)
    ce_eq("q withdrawn to UNKNOWN", atom_evidence_grade(q_atom), GRADE_UNKNOWN)
}

// The derived theorem is also auto-registered for the periodic re-check sweep
// (it went through lp_ingest_formal like any other pin).
fn test_derived_theorem_registered() {
    let b = _setup_proof_env()
    let kg = b[2]
    let rck = b[3]
    let before = rck_count(rck)
    fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    ce_eq("one more registered proof", rck_count(rck), before + 1)
}

fn test_render_proof() {
    let b = _setup_proof_env()
    let kg = b[2]
    let ok = fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    ce_check("derived render says DERIVED",
        str_find(fc_render_proof(ok, "q"), "DERIVED") >= 0)
    let bad = fc_prove_mp(kg, "z", "missing", "p", "user-taught")
    // (probe with "premise is unknown" -- the "cannot derive" literal hits the
    // launcher's per-literal str_find quirk; the reject body is one string.)
    ce_check("reject render explains the rejection",
        str_find(fc_render_proof(bad, "z"), "premise is unknown") >= 0)
}

// ---- conjunction intro/elim ------------------------------------------------
// Assert two atoms, AND-introduce their conjunction, then eliminate it back.
fn test_and_intro_and_elim() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_axiom(kg, "a", "user-taught")
    fc_assert_axiom(kg, "b", "user-taught")
    // a AND b
    let ai = fc_prove_and(kg, "a_and_b", "a", "b", "user-taught")
    ce_eq("conjunction derived", fc_state(ai), CAND_PROMOTED)
    ce_eq("conjunction FORMAL", atom_evidence_grade(fc_atom(ai)), GRADE_FORMAL)
    // eliminate left -> a
    let el = fc_prove_and_elim(kg, "a", "a_and_b", FC_AND_LEFT, "user-taught")
    ce_eq("left elim FORMAL", fc_state(el), CAND_PROMOTED)
    // eliminate right -> b
    let er = fc_prove_and_elim(kg, "b", "a_and_b", FC_AND_RIGHT, "user-taught")
    ce_eq("right elim FORMAL", fc_state(er), CAND_PROMOTED)
    fc_boot(0, rck)
}

// Elimination naming the WRONG conjunct -> REJECTED (term mismatch).
fn test_and_elim_wrong_name_rejected() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_axiom(kg, "a", "user-taught")
    fc_assert_axiom(kg, "b", "user-taught")
    fc_prove_and(kg, "a_and_b", "a", "b", "user-taught")
    // left of (a AND b) is a, not b -> naming it "b" mismatches.
    let bad = fc_prove_and_elim(kg, "b", "a_and_b", FC_AND_LEFT, "user-taught")
    ce_eq("wrong conjunct name -> REJECTED", fc_state(bad), CAND_REJECTED)
    fc_boot(0, rck)
}

// And-intro over an unknown conjunct -> REJECTED.
fn test_and_unknown_rejected() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_axiom(kg, "a", "user-taught")
    let bad = fc_prove_and(kg, "x", "a", "nonexistent", "user-taught")
    ce_eq("unknown conjunct -> REJECTED", fc_state(bad), CAND_REJECTED)
    fc_boot(0, rck)
}

// ---- chained multi-step proof + deep cascade -------------------------------
// p, (p->q) |- q  (MP); then q AND r  (AND-I). Invalidate p and the WHOLE chain
// p -> q -> (q AND r) must be withdrawn -- a 3-deep dependency cascade built
// entirely through the chat seam.
fn test_chained_proof_deep_cascade() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    fc_assert_axiom(kg, "p", "user-taught")
    fc_assert_imp(kg, "pq", "p", "q", "user-taught")
    fc_assert_axiom(kg, "r", "user-taught")
    // step 1: derive q by MP.
    let q = fc_prove_mp(kg, "q", "pq", "p", "user-taught")
    ce_eq("q FORMAL", atom_evidence_grade(fc_atom(q)), GRADE_FORMAL)
    // step 2: derive (q AND r) -- rests on the DERIVED q + the axiom r.
    let qr = fc_prove_and(kg, "q_and_r", "q", "r", "user-taught")
    ce_eq("q_and_r FORMAL", atom_evidence_grade(fc_atom(qr)), GRADE_FORMAL)
    // now pull the root: invalidate p. The cascade must reach q AND q_and_r.
    let code_p = _fc_env_code(_fc_env_get("p"))
    let casc = verify_cascade_invalidate(proofs, kgreg, code_p)
    ce_check("cascade unpinned >= 3 (p, q, q_and_r)", cascade_unpinned(casc) >= 3)
    ce_eq("q withdrawn", atom_evidence_grade(fc_atom(q)), GRADE_UNKNOWN)
    ce_eq("q_and_r withdrawn", atom_evidence_grade(fc_atom(qr)), GRADE_UNKNOWN)
    fc_boot(0, rck)
}

// ---- hypothetical syllogism + biconditional at the seam (increment 12) ------
fn test_hs_composes_implications() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    // (a->b) and (b->c) FORMAL; compose to (a->c).
    fc_assert_imp(kg, "ab", "a", "b", "user-taught")
    fc_assert_imp(kg, "bc", "b", "c", "user-taught")
    let r = fc_prove_hs(kg, "ac", "ab", "bc", "user-taught")
    ce_eq("HS composes -> FORMAL", fc_state(r), CAND_PROMOTED)
    ce_eq("ac is FORMAL", atom_evidence_grade(fc_atom(r)), GRADE_FORMAL)
    // The derived (a->c) can itself be a premise: chain to (a->d) via (c->d).
    fc_assert_imp(kg, "cd", "c", "d", "user-taught")
    let r2 = fc_prove_hs(kg, "ad", "ac", "cd", "user-taught")
    ce_eq("HS chains on a derived implication", fc_state(r2), CAND_PROMOTED)
    fc_boot(0, rck)
}

// Middle-term mismatch -> REJECTED.
fn test_hs_mismatch_rejected() {
