// Unit tests for src/persona/persona_registry.nova (ADR-0102).

import "../ce_test.nova"
import "../../src/persona/persona_registry.nova"

fn test_new_empty() {
    let r = persona_registry_new()
    ce_eq("count 0", persona_registry_count(r), 0)
    ce_check("lookup missing = 0", persona_registry_lookup(r, "alice") == 0)
    ce_eq("has missing", persona_registry_has(r, "alice"), 0)
    ce_eq("user_ids empty", len(persona_registry_user_ids(r)), 0)
}

fn test_register_new() {
    let r = persona_registry_new()
    let p = persona_new("alice", "Alice", "learn", 100)
    ce_eq("register ok", persona_registry_register(r, p), 1)
    ce_eq("count 1", persona_registry_count(r), 1)
    ce_eq("has alice", persona_registry_has(r, "alice"), 1)
    let found = persona_registry_lookup(r, "alice")
    ce_check("lookup returns registered", found == p)
}

fn test_one_per_user_invariant() {
    let r = persona_registry_new()
    let p1 = persona_new("alice", "Alice One", "purpose1", 100)
    let p2 = persona_new("alice", "Alice Two", "purpose2", 200)
    ce_eq("first alice registered", persona_registry_register(r, p1), 1)
    ce_eq("second alice REJECTED", persona_registry_register(r, p2), 0)
    ce_eq("count still 1", persona_registry_count(r), 1)
    // Original persona still returned; second discarded.
    let found = persona_registry_lookup(r, "alice")
    ce_str_eq("original name preserved", persona_name(found), "Alice One")
}

fn test_ensure_creates_if_absent() {
    let r = persona_registry_new()
    let p = persona_registry_ensure(r, "carol", 100)
    ce_check("returns a persona", p != 0)
    ce_eq("count 1", persona_registry_count(r), 1)
    ce_str_eq("user_id set", persona_user_id(p), "carol")
    ce_str_eq("name defaults to user_id", persona_name(p), "carol")
    ce_eq("empty purpose", persona_purpose(p), "")
}

fn test_ensure_returns_existing() {
    let r = persona_registry_new()
    let first = persona_registry_ensure(r, "dave", 100)
    // Ensure again -- must return the SAME persona, not a new one.
    let second = persona_registry_ensure(r, "dave", 200)
    ce_check("same object returned", first == second)
    ce_eq("count still 1", persona_registry_count(r), 1)
    // The original created_at is preserved.
    ce_eq("created_at unchanged", persona_created_at(second), 100)
}

fn test_multiple_users_coexist() {
    let r = persona_registry_new()
    persona_registry_register(r, persona_new("alice", "A", "p", 100))
    persona_registry_register(r, persona_new("bob",   "B", "p", 100))
    persona_registry_register(r, persona_new("carol", "C", "p", 100))
    ce_eq("count 3", persona_registry_count(r), 3)
    let ids = persona_registry_user_ids(r)
    ce_eq("3 user_ids", len(ids), 3)
    ce_str_eq("first alice", ids[0], "alice")
    ce_str_eq("second bob", ids[1], "bob")
    ce_str_eq("third carol", ids[2], "carol")
    // Cross-lookup isolation: each user_id resolves to its own persona
    // (verified by comparing user_id fields since NOVA pointer-equality
    // on list handles isn't a language-level guarantee we can rely on).
    let bob_p   = persona_registry_lookup(r, "bob")
    let alice_p = persona_registry_lookup(r, "alice")
    ce_str_eq("bob's persona has user_id bob",   persona_user_id(bob_p),   "bob")
    ce_str_eq("alice's persona has user_id alice", persona_user_id(alice_p), "alice")
}

fn test_remove() {
    let r = persona_registry_new()
    persona_registry_register(r, persona_new("alice", "A", "p", 100))
    persona_registry_register(r, persona_new("bob",   "B", "p", 100))
    persona_registry_register(r, persona_new("carol", "C", "p", 100))
    ce_eq("remove bob", persona_registry_remove(r, "bob"), 1)
    ce_eq("count 2", persona_registry_count(r), 2)
    ce_eq("bob gone", persona_registry_has(r, "bob"), 0)
    ce_eq("alice still", persona_registry_has(r, "alice"), 1)
    ce_eq("carol still", persona_registry_has(r, "carol"), 1)
    ce_eq("remove missing = 0", persona_registry_remove(r, "eve"), 0)
    ce_eq("remove again = 0", persona_registry_remove(r, "bob"), 0)
}

fn test_persona_state_persists_across_lookups() {
    // Registry stores references, not copies. Mutations via one handle
    // are visible via subsequent lookups.
    let r = persona_registry_new()
    let p = persona_registry_ensure(r, "alice", 100)
    persona_add_preference(p, "concise", 800, "src:user:alice", 200)
    persona_add_decision(p, "install cap", "yes", 500, "src:user:alice", 210)
    let refetched = persona_registry_lookup(r, "alice")
    ce_eq("prefs visible via lookup",
          persona_preferences_count(refetched), 1)
    ce_eq("history visible via lookup",
          persona_history_count(refetched), 1)
}

fn main() {
    test_new_empty()
    test_register_new()
    test_one_per_user_invariant()
    test_ensure_creates_if_absent()
    test_ensure_returns_existing()
    test_multiple_users_coexist()
    test_remove()
    test_persona_state_persists_across_lookups()
    ce_summary("persona_registry")
}

main()
