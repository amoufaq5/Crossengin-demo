// Unit tests for src/audit/decision_log.nova
// Verifies append-only growth, the immutable hash chain, and tamper detection
// (field mutation, seq tamper, broken linkage, tail truncation). ADR-0043.

import "../ce_test.nova"
import "../../src/audit/decision_log.nova"

fn _desc(ac, at, pt, rc) {
    let d = list_new()
    push(d, ac)
    push(d, at)
    push(d, pt)
    push(d, rc)
    return d
}

fn _trace(a, b) {
    let t = list_new()
    push(t, a)
    push(t, b)
    return t
}

fn test_append_and_accessors() {
    let log = dl_new()
    ce_eq("empty count", dl_count(log), 0)
    ce_eq("empty head", dl_head_hash(log), 0)

    let s0 = dl_append(log, DLK_INTENT, -1, 100, _desc(4, 4, 3, 3), 7, _trace(1, 2), 55, OUT_PENDING)
    let s1 = dl_append(log, DLK_OUTCOME, s0, 110, _desc(4, 4, 3, 3), 7, _trace(1, 2), 55, OUT_OK)
    ce_eq("seq 0", s0, 0)
    ce_eq("seq 1", s1, 1)
    ce_eq("count 2", dl_count(log), 2)

    let e0 = dl_get(log, 0)
    ce_eq("kind intent", dl_kind(e0), DLK_INTENT)
    ce_eq("ref none", dl_ref(e0), -1)
    ce_eq("ts", dl_timestamp(e0), 100)
    ce_eq("atype", dl_action_type(e0), 4)
    ce_eq("ptier", dl_perm_tier(e0), 3)
    ce_eq("rclass", dl_rev_class(e0), 3)
    ce_eq("goal", dl_goal(e0), 7)
    ce_eq("outcome pending", dl_outcome(e0), OUT_PENDING)
    ce_eq("trace len", len(dl_trace(e0)), 2)

    let e1 = dl_get(log, 1)
    ce_eq("e1 refs e0", dl_ref(e1), 0)
    ce_eq("e1 outcome ok", dl_outcome(e1), OUT_OK)
    // The chain links: e1.prev == e0.hash, and head == e1.hash.
    ce_eq("linkage", dl_prev_hash(e1), dl_hash(e0))
    ce_eq("head is last hash", dl_head_hash(log), dl_hash(e1))
    ce_check("out of range get", dl_get(log, 5) == 0)
}

fn test_verify_intact() {
    let log = dl_new()
    dl_append(log, DLK_INTENT, -1, 1, _desc(1, 1, 1, 1), -1, list_new(), 0, OUT_PENDING)
    dl_append(log, DLK_OUTCOME, 0, 2, _desc(1, 1, 1, 1), -1, list_new(), 0, OUT_OK)
    dl_append(log, DLK_CORRECTION, -1, 3, _desc(8, 8, 3, 3), -1, list_new(), 0, OUT_OK)
    ce_eq("intact verifies", dl_verify(log), 1)
}

// Mutating any stored field must break the recomputed hash.
fn test_tamper_field() {
    let log = dl_new()
    dl_append(log, DLK_INTENT, -1, 10, _desc(2, 2, 2, 2), 3, _trace(9, 9), 1, OUT_PENDING)
    dl_append(log, DLK_OUTCOME, 0, 11, _desc(2, 2, 2, 2), 3, _trace(9, 9), 1, OUT_OK)
    ce_eq("pre-tamper ok", dl_verify(log), 1)
    // Flip the outcome of entry 0 without recomputing its hash.
    let e0 = dl_get(log, 0)
    list_set(e0, E_OUTCOME, OUT_FAILED)
    ce_eq("field tamper detected", dl_verify(log), 0)
}

// Breaking the prev linkage (a reorder/mid-chain cut) must fail.
fn test_tamper_linkage() {
    let log = dl_new()
    dl_append(log, DLK_INTENT, -1, 1, _desc(1, 1, 1, 1), -1, list_new(), 0, OUT_PENDING)
    dl_append(log, DLK_OUTCOME, 0, 2, _desc(1, 1, 1, 1), -1, list_new(), 0, OUT_OK)
    let e1 = dl_get(log, 1)
    list_set(e1, E_PREV, 12345)
    ce_eq("linkage tamper detected", dl_verify(log), 0)
}

// Removing the last entry (tail truncation) without updating the head must fail.
fn test_tamper_truncation() {
    let log = dl_new()
    dl_append(log, DLK_INTENT, -1, 1, _desc(1, 1, 1, 1), -1, list_new(), 0, OUT_PENDING)
    dl_append(log, DLK_OUTCOME, 0, 2, _desc(1, 1, 1, 1), -1, list_new(), 0, OUT_OK)
    ce_eq("pre-trunc ok", dl_verify(log), 1)
    list_remove(log[DL_ENTRIES], 1)
    ce_eq("truncation detected", dl_verify(log), 0)
}

fn main() {
    test_append_and_accessors()
    test_verify_intact()
    test_tamper_field()
    test_tamper_linkage()
    test_tamper_truncation()
    ce_summary("decision_log")
}
main()
