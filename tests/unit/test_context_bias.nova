// Unit tests for src/reader/context_bias.nova
// Verifies polysemy resolution: a word's sense is chosen by similarity to the
// context bias vector, falling back to the dominant sense with no context, and
// XSIG_PREDICT signals are emitted. ADR-0012 stage 2.

import "../ce_test.nova"
import "../../src/reader/context_bias.nova"

fn embed1(d, val) {
    let v = vec_new(ATOM_EMBED_DIMS); vec_set(v, d, val); return v
}

fn build() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let geo = kg_spawn(reg, "geo")
    let fin = kg_spawn(reg, "finance")
    let river = kg_add_atom(geo, ATOM_CONCEPT, "riverbank", 0)
    let money = kg_add_atom(fin, ATOM_CONCEPT, "moneybank", 0)
    atom_set_embed(river, embed1(0, 100))   // dim 0
    atom_set_embed(money, embed1(1, 100))   // dim 1
    let bank = word_atom_new(lang, "bank", 0)
    word_add_sense(bank, river, 500)
    word_add_sense(bank, money, 700)        // dominant
    let e = renv_new(reg, lang, 0, 0, 0)
    // Return env plus the two concept atoms for context construction.
    return [e, river, money]
}

fn read_bank(e, context) {
    let c = rctx_new("bank")
    reader_anchor(e, c)
    reader_bias(e, c, context)
    return rctx_anchors(c)[0]
}

fn ctx(a) { let l = list_new(); push(l, a); return l }

fn test_disambiguation() {
    let env = build()
    let e = env[0]
    let river = env[1]
    let money = env[2]
    // Water context (dim 0) -> river sense.
    let a1 = read_bank(e, ctx(river))
    ce_str_eq("river context -> geo sense", handle_kg(anchor_sense(a1)), "geo")
    ce_eq("river sense atom", handle_atom(anchor_sense(a1)), atom_id(river))
    // Finance context (dim 1) -> money sense.
    let a2 = read_bank(e, ctx(money))
    ce_str_eq("finance context -> finance sense", handle_kg(anchor_sense(a2)), "finance")
    ce_eq("money sense atom", handle_atom(anchor_sense(a2)), atom_id(money))
    // No context -> dominant sense (money, weight 700).
    let a3 = read_bank(e, list_new())
    ce_str_eq("no context -> dominant", handle_kg(anchor_sense(a3)), "finance")
}

fn test_predict_signals_and_monosemy() {
    let env = build()
    let e = env[0]
    let c = rctx_new("bank")
    reader_anchor(e, c)
    let resolved = reader_bias(e, c, list_new())
    ce_eq("one sense resolved", resolved, 1)
    ce_eq("one predict signal", len(rctx_predict(c)), 1)
    ce_eq("predict type", sig_type(rctx_predict(c)[0]), XSIG_PREDICT)

    // A monosemous word: its single sense is chosen regardless of context.
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let dom = kg_spawn(reg, "med")
    let concept = kg_add_atom(dom, ATOM_CONCEPT, "pyrexia", 0)
    let fever = word_atom_new(lang, "fever", 0)
    word_add_sense(fever, concept, 600)
    let e2 = renv_new(reg, lang, 0, 0, 0)
    let c2 = rctx_new("fever")
    reader_anchor(e2, c2)
    reader_bias(e2, c2, list_new())
    ce_eq("monosemous sense chosen", handle_atom(anchor_sense(rctx_anchors(c2)[0])), atom_id(concept))
}

fn main() {
    test_disambiguation()
    test_predict_signals_and_monosemy()
    ce_summary("context_bias")
}

main()
