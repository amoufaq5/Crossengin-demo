// Unit tests for src/language/nl_query.nova (N1, ADR-0059).
// Builds a small reasoning KG (concepts + operator edges in one KG, the same
// convention the cognitive router tests use) and drives the NL-question bridge
// end to end: classification, focus/entity extraction, the per-form lookups
// (what / why / yes-no / how-many), entity-resolution via alias, the R74
// confidence hedging, and source provenance.

import "../ce_test.nova"
import "../../src/language/nl_query.nova"

// rain --causal--> flood --imply--> disaster ; hot --opposite--> cold ;
// rain also --causal--> erosion. "car" is an alias target for "automobile".
fn build_kg() {
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    kg_add_atom(kg, ATOM_CONCEPT, "rain", 0)      // 0
    kg_add_atom(kg, ATOM_CONCEPT, "flood", 0)     // 1
    kg_add_atom(kg, ATOM_CONCEPT, "disaster", 0)  // 2
    kg_add_atom(kg, ATOM_CONCEPT, "hot", 0)       // 3
    kg_add_atom(kg, ATOM_CONCEPT, "cold", 0)      // 4
    kg_add_atom(kg, ATOM_CONCEPT, "erosion", 0)   // 5
    kg_add_atom(kg, ATOM_CONCEPT, "car", 0)       // 6
    // rain -> flood, with a web-sourced provenance label.
    rop_new(kg, ROP_CAUSAL, 0, 1, "src:url:host:rain-causes->flood", 0)
    rop_new(kg, ROP_CAUSAL, 0, 5, "src:url:host:rain-causes->erosion", 0)
    rop_new(kg, ROP_IMPLY,  1, 2, "src:dict:flood-is_a->disaster", 0)
    rop_new(kg, ROP_OPPOSITE, 3, 4, "hot-opp->cold", 0)
    return kg
}

fn _has(hay, needle) {
    if str_find(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- classification --------------------------------------------------------
fn test_classify() {
    ce_eq("yes/no is",       nlq_classify("is rain a flood"),        NLQ_YESNO)
    ce_eq("yes/no does",     nlq_classify("does rain cause flood"),  NLQ_YESNO)
    ce_eq("what",            nlq_classify("what is rain"),           NLQ_WHAT)
    ce_eq("who",             nlq_classify("who is einstein"),        NLQ_WHO)
    ce_eq("why",             nlq_classify("why does flood happen"),  NLQ_WHY)
    ce_eq("how many",        nlq_classify("how many things rain"),   NLQ_HOWMANY)
    ce_eq("how (not many)",  nlq_classify("how does rain work"),     NLQ_HOW)
    ce_eq("not a question",  nlq_classify("rain is wet"),            NLQ_NONE)
    ce_eq("empty",           nlq_classify(""),                       NLQ_NONE)
}

// ---- focus / entity extraction --------------------------------------------
fn test_focus() {
    ce_str_eq("focus skips qword+copula", nlq_focus(_nlq_tokens("what is rain")), "rain")
    ce_str_eq("focus skips rel verb", nlq_focus(_nlq_tokens("what does rain cause")), "rain")
    ce_str_eq("focus bounded NP", nlq_focus(_nlq_tokens("what is a big red car")), "big_red_car")
}

fn test_rel_kind() {
    ce_eq("cause -> causal", _nlq_rel_kind(_nlq_tokens("what does rain cause"), NLQ_WHAT), ROP_CAUSAL)
    ce_eq("opposite kind",   _nlq_rel_kind(_nlq_tokens("is hot the opposite of cold"), NLQ_YESNO), ROP_OPPOSITE)
    ce_eq("why -> causal",   _nlq_rel_kind(_nlq_tokens("why flood"), NLQ_WHY), ROP_CAUSAL)
    ce_eq("no rel word",     _nlq_rel_kind(_nlq_tokens("what is rain"), NLQ_WHAT), 0)
}

// ---- what / why ------------------------------------------------------------
fn test_what() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "what does rain cause")
    ce_eq("found", nlq_found(a), 1)
    ce_str_eq("rain leads to flood", nlq_text(a), "rain leads to flood")
    ce_str_eq("provenance is web", nlq_source(a), "web")
    ce_eq("one op cited", len(nlq_ops(a)), 1)
}

fn test_what_is_prefers_is_a() {
    let kg = build_kg()
    // flood has an is_a edge (-> disaster) and is the object of a causal edge;
    // "what is flood" should surface the is_a relation.
    let a = nlq_respond(kg, 0, "what is flood")
    ce_eq("found", nlq_found(a), 1)
    ce_str_eq("flood is a disaster", nlq_text(a), "flood is a disaster")
}

fn test_why() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "why does flood happen")
    ce_eq("found", nlq_found(a), 1)
    ce_eq("form is why", nlq_aform(a), NLQ_WHY)
    ce_str_eq("rain leads to flood (incoming)", nlq_text(a), "rain leads to flood")
}

fn test_unknown_focus() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "what is unicorn")
    ce_eq("not found", nlq_found(a), 0)
    ce_check("honest gap", _has(nlq_text(a), "unicorn") == 1)
}

// ---- yes/no ----------------------------------------------------------------
fn test_yesno_positive() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "does rain cause flood")
    ce_eq("found", nlq_found(a), 1)
    ce_str_eq("yes", nlq_text(a), "yes")
}

fn test_yesno_no_link() {
    let kg = build_kg()
    // there is a causal edge rain->flood, but no is_a edge, so "is rain a flood"
    // is honestly "no link", not a guessed yes.
    let a = nlq_respond(kg, 0, "is rain a flood")
    ce_eq("not found", nlq_found(a), 0)
    ce_check("honest no-link", _has(nlq_text(a), "link") == 1)
}

fn test_yesno_opposite_is_yes() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "is hot the opposite of cold")
    ce_eq("found", nlq_found(a), 1)
    ce_str_eq("opposite -> yes", nlq_text(a), "yes")
}

fn test_yesno_unknown() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "is dragon a flood")
    ce_eq("not found", nlq_found(a), 0)
    ce_check("names unknown", _has(nlq_text(a), "dragon") == 1)
}

// ---- how many --------------------------------------------------------------
fn test_howmany() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "how many things does rain cause")
    ce_eq("found", nlq_found(a), 1)
    ce_str_eq("rain causes 2 things", nlq_text(a), "2")
}

// ---- entity resolution via alias -------------------------------------------
fn test_alias() {
    let kg = build_kg()
    let al = er_aliases_new()
    er_alias_add(al, "automobile", "car")
    // "automobile" resolves to the "car" atom; car has no edges, so the answer
    // is an honest fact-gap (proving resolution happened, not a missing-atom gap).
    let a = nlq_respond(kg, al, "what is automobile")
    ce_eq("resolved but no fact", nlq_found(a), 0)
    ce_check("fact gap not unknown", _has(nlq_text(a), "fact") == 1)
}

// ---- confidence hedging (R74 tiers) ----------------------------------------
fn test_confidence_tiers() {
    // a fresh edge defaults to belief 500 -> "i think".
    let kg = build_kg()
    let mid = nlq_respond(kg, 0, "what does rain cause")
    ce_eq("default conf 500", nlq_conf(mid), 500)
    ce_str_eq("mid hedge", nlq_phrase(nlq_conf(mid)), "i think ")

    // strengthen rain->flood twice (alpha 1000->3000) -> mean 750 -> confident.
    let opid = nlq_ops(mid)[0]
    let op = kg_atom(kg, opid)
    rop_observe(op, 1)
    rop_observe(op, 1)
    let strong = nlq_respond(kg, 0, "what does rain cause")
    ce_check("strong >= 700", nlq_conf(strong) >= 700)
    ce_str_eq("no hedge when confident", nlq_phrase(nlq_conf(strong)), "")

    // weaken erosion edge so the strongest becomes the weak one only if lower;
    // instead weaken flood below 400 and re-query: beta 1000->4000 -> mean 200.
    rop_observe(op, 0 - 1)
    rop_observe(op, 0 - 1)
    rop_observe(op, 0 - 1)
    rop_observe(op, 0 - 1)
    rop_observe(op, 0 - 1)
    let weak = nlq_respond(kg, 0, "does rain cause flood")
    ce_check("weak < 400", nlq_conf(weak) < 400)
    ce_str_eq("tentative hedge", nlq_phrase(nlq_conf(weak)), "tentatively, ")
}

// ---- source tagging --------------------------------------------------------
fn test_source_tag() {
    ce_str_eq("wikipedia", nlq_source_tag("src:url:en.wikipedia.org:a-b->c"), "wikipedia")
    ce_str_eq("wiktionary", nlq_source_tag("src:url:en.wiktionary.org:a-b->c"), "wiktionary")
    ce_str_eq("dictionary", nlq_source_tag("src:dict:a-b->c"), "dictionary")
    ce_str_eq("topic", nlq_source_tag("src:topic:a-b->c"), "topic")
    ce_str_eq("web", nlq_source_tag("src:url:host:a-b->c"), "web")
    ce_str_eq("learned", nlq_source_tag("src:chat:a-b->c"), "learned")
    ce_str_eq("seed", nlq_source_tag("morning->breakfast"), "seed")
}

// ---- rendering -------------------------------------------------------------
fn test_render() {
    let kg = build_kg()
    let a = nlq_respond(kg, 0, "what does rain cause")
    // default conf 500 -> "i think " + body + provenance tag.
    ce_str_eq("rendered with hedge + source",
              nlq_render(a), "i think rain leads to flood [from web]")
    let hm = nlq_respond(kg, 0, "how many things does rain cause")
    ce_str_eq("how-many renders bare count", nlq_render(hm), "2")
    let gap = nlq_respond(kg, 0, "what is unicorn")
    ce_check("gap renders its message", _has(nlq_render(gap), "unicorn") == 1)
}

fn main() {
    test_classify()
    test_focus()
    test_rel_kind()
    test_what()
    test_what_is_prefers_is_a()
    test_why()
    test_unknown_focus()
    test_yesno_positive()
    test_yesno_no_link()
    test_yesno_opposite_is_yes()
    test_yesno_unknown()
    test_howmany()
    test_alias()
    test_confidence_tiers()
    test_source_tag()
    test_render()
    ce_summary("nl_query")
}

main()
