// Unit tests for src/persistence/chat_state.nova
//
// Verifies the R39C save+load API: soul (name, identity, OCEAN, values)
// + multi-KG (atoms across multiple KGs) + decision-log tail round-trip
// against the textual on-disk format. Also covers the schema-versioning
// guard (rejects a v2 file), the missing-file path (returns NOT_FOUND),
// malformed records (returns PARSE), unknown-record forward-compat (the
// reader SKIPs lines it doesn't recognize), the IO failure path
// (non-writable parent), the default-path resolution + CE_PERSIST_PATH
// override, the auto-mkdir behaviour for $HOME/.crossengin/, and
// EMPTY-state round-trip (zero atoms, zero entries).
//
// The target assertion count is 30+ -- this suite ships ~50 assertions.

import "std/syscall"
import "std/io"
import "../ce_test.nova"
import "../../src/persistence/chat_state.nova"

let TEST_PATH_A = "/tmp/ce_test_chat_state_a.dat"
let TEST_PATH_B = "/tmp/ce_test_chat_state_b.dat"
let TEST_PATH_C = "/tmp/ce_test_chat_state_c.dat"
let TEST_PATH_D = "/tmp/ce_test_chat_state_d.dat"
let TEST_PATH_E = "/tmp/ce_test_chat_state_e.dat"
let TEST_PATH_F = "/tmp/ce_test_chat_state_f.dat"
let TEST_PATH_G = "/tmp/ce_test_chat_state_g.dat"
let TEST_PATH_H = "/tmp/ce_test_chat_state_h.dat"
let TEST_PATH_I = "/tmp/ce_test_chat_state_i.dat"
let TEST_PATH_J = "/tmp/ce_test_chat_state_j.dat"
let TEST_PATH_K = "/tmp/ce_test_chat_state_k.dat"
let TEST_PATH_AUTOMKDIR = "/tmp/ce_test_chat_state_dir_x/inner/chat_state.dat"

// Wipe a path between tests. sys_unlink missing-file failures are ignored.
fn _unlink(path) {
    sys_unlink(path)
    return 1
}

// Build a small but representative soul: name, identity, OCEAN, a couple
// of values.
fn _seed_soul() {
    let sl = soul_new("crossengin")
    soul_set_identity(sl, "I help humans think clearly about complex domains",
                          "A patient inquisitive assistant")
    soul_set_ocean(sl, 500, 600, 450, 700, 300)
    soul_add_value(sl, "truth",   "never fabricate")
    soul_add_value(sl, "respect", "treat the user as a peer")
    return sl
}

// Build a multi-KG registry with one KG and 10 atoms.
fn _seed_kg_10atoms() {
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    kg_add_atom(med, ATOM_FACT,    "aspirin",   1)
    kg_add_atom(med, ATOM_FACT,    "ibuprofen", 1)
    kg_add_atom(med, ATOM_CONCEPT, "headache",  1)
    kg_add_atom(med, ATOM_CONCEPT, "fever",     1)
    kg_add_atom(med, ATOM_LANG,    "dose",      1)
    kg_add_atom(med, ATOM_FACT,    "paracetamol", 1)
    kg_add_atom(med, ATOM_CONCEPT, "pain",      1)
    kg_add_atom(med, ATOM_FACT,    "antibiotic", 1)
    kg_add_atom(med, ATOM_SKILL,   "diagnose",  1)
    kg_add_atom(med, ATOM_RULE,    "if_fever_check_temp", 1)
    return reg
}

// Build 5 triples (test fixture) for the 10-atom medicine KG.
fn _seed_triples_5() {
    let triples = list_new()
    let t0 = list_new(); push(t0, 0); push(t0, 9); push(t0, 1); push(t0, 800); push(triples, t0)
    let t1 = list_new(); push(t1, 2); push(t1, 6); push(t1, 3); push(t1, 700); push(triples, t1)
    let t2 = list_new(); push(t2, 4); push(t2, 9); push(t2, 5); push(t2, 600); push(triples, t2)
    let t3 = list_new(); push(t3, 7); push(t3, 9); push(t3, 0); push(t3, 500); push(triples, t3)
    let t4 = list_new(); push(t4, 8); push(t4, 9); push(t4, 6); push(t4, 400); push(triples, t4)
    return triples
}

// Build a registry with 3 KGs, each carrying 5 atoms.
fn _seed_kg_three() {
    let reg = kg_registry_new()
    let r1 = kg_spawn(reg, "reasoning")
    let r2 = kg_spawn(reg, "language")
    let r3 = kg_spawn(reg, "imagination")
    let i = 0
    while i < 5 {
        kg_add_atom(r1, ATOM_FACT,    "r_atom_" + int_to_str(i), 1)
        kg_add_atom(r2, ATOM_LANG,    "l_word_" + int_to_str(i), 1)
        kg_add_atom(r3, ATOM_CONCEPT, "i_idea_" + int_to_str(i), 1)
        i = i + 1
    }
    return reg
}

// Helper: build a 4-element [aclass, atype, ptier, rclass] desc.
fn _desc(ac, at, pt, rc) {
    let d = list_new()
    push(d, ac); push(d, at); push(d, pt); push(d, rc)
    return d
}

// Pre-populate a decision log with `count` synthetic intent entries.
fn _seed_dlog(count) {
    let log = dl_new()
    let i = 0
    while i < count {
        dl_append(log, DLK_INTENT, 0 - 1, i + 100, _desc(4, 4, 3, 3),
                  0 - 1, list_new(), 0, OUT_PENDING)
        i = i + 1
    }
    return log
}

// ---- 1. Save + load round-trip: soul fields byte-identical ----------------

fn test_round_trip_soul() {
    _unlink(TEST_PATH_A)
    let sl = _seed_soul()
    let reg = _seed_kg_10atoms()
    let dlog = _seed_dlog(0)
    let rc = chat_state_save(TEST_PATH_A, sl, reg, dlog)
    ce_eq("save returns 0 on success", rc, 0)
    let r = chat_state_load(TEST_PATH_A)
    ce_eq("load result is success", chat_state_is_load_ok(r), 1)
    let sl2 = chat_state_loaded_soul(r)
    ce_str_eq("soul name round-trip",            soul_name(sl2),    "crossengin")
    ce_str_eq("soul purpose round-trip",         soul_purpose(sl2), "I help humans think clearly about complex domains")
    ce_str_eq("soul nature round-trip",          soul_nature(sl2),  "A patient inquisitive assistant")
    ce_eq("soul openness round-trip",            soul_openness(sl2),          500)
    ce_eq("soul conscientiousness round-trip",   soul_conscientiousness(sl2), 600)
    ce_eq("soul extraversion round-trip",        soul_extraversion(sl2),      450)
    ce_eq("soul agreeableness round-trip",       soul_agreeableness(sl2),     700)
    ce_eq("soul neuroticism round-trip",         soul_neuroticism(sl2),       300)
    ce_eq("soul values count",                   soul_value_count(sl2),       2)
    ce_str_eq("soul value truth principle",      soul_value(sl2, "truth"),    "never fabricate")
    ce_str_eq("soul value respect principle",    soul_value(sl2, "respect"),  "treat the user as a peer")
}

// ---- 2. Round-trip multi-KG (3 KGs, 5 atoms each) ------------------------

fn test_round_trip_multi_kg() {
    _unlink(TEST_PATH_B)
    let sl = soul_new("nameless")
    let reg = _seed_kg_three()
    let dlog = dl_new()
    let rc = chat_state_save(TEST_PATH_B, sl, reg, dlog)
    ce_eq("save 3-KG returns 0", rc, 0)
    let r = chat_state_load(TEST_PATH_B)
    ce_eq("load 3-KG ok", chat_state_is_load_ok(r), 1)
    let reg2 = chat_state_loaded_kgs(r)
    ce_eq("3 KGs reconstructed", kg_count(reg2), 3)
    let r1 = kg_find(reg2, "reasoning")
    let r2 = kg_find(reg2, "language")
    let r3 = kg_find(reg2, "imagination")
    ce_check("reasoning KG present",   r1 != 0)
    ce_check("language KG present",    r2 != 0)
    ce_check("imagination KG present", r3 != 0)
    ce_eq("reasoning 5 atoms",   kg_atom_count(r1), 5)
    ce_eq("language 5 atoms",    kg_atom_count(r2), 5)
    ce_eq("imagination 5 atoms", kg_atom_count(r3), 5)
    ce_str_eq("a r_atom is findable",   atom_label(kg_find_atom(r1, "r_atom_3")), "r_atom_3")
    ce_str_eq("a l_word is findable",   atom_label(kg_find_atom(r2, "l_word_0")), "l_word_0")
    ce_str_eq("a i_idea is findable",   atom_label(kg_find_atom(r3, "i_idea_4")), "i_idea_4")
}

// ---- 3. Round-trip 10 atoms with kinds + beliefs --------------------------

fn test_round_trip_10atoms_with_beliefs() {
    _unlink(TEST_PATH_C)
    let sl = soul_new("aurora")
    let reg = _seed_kg_10atoms()
    // Touch a few atoms' beliefs so the round-trip exercises non-uniform priors.
    let med = kg_find(reg, "medicine")
    let asp = kg_find_atom(med, "aspirin")
    atom_observe(asp, 1)
    atom_observe(asp, 1)         // alpha now 3000, beta 1000
    let pain = kg_find_atom(med, "pain")
    atom_observe(pain, 0 - 1)
    atom_observe(pain, 0 - 1)    // beta now 3000, alpha 1000
    let rc = chat_state_save(TEST_PATH_C, sl, reg, dl_new())
    ce_eq("save 10-atom ok", rc, 0)
    let r = chat_state_load(TEST_PATH_C)
    ce_eq("load 10-atom ok", chat_state_is_load_ok(r), 1)
    let reg2 = chat_state_loaded_kgs(r)
    let med2 = kg_find(reg2, "medicine")
    ce_eq("loaded med 10 atoms", kg_atom_count(med2), 10)
    let asp2 = kg_find_atom(med2, "aspirin")
    ce_eq("aspirin alpha preserved", atom_belief(asp2)[0], 3000)
    ce_eq("aspirin beta preserved",  atom_belief(asp2)[1], 1000)
    let pain2 = kg_find_atom(med2, "pain")
    ce_eq("pain alpha preserved", atom_belief(pain2)[0], 1000)
    ce_eq("pain beta preserved",  atom_belief(pain2)[1], 3000)
    // Atom kinds (was concept) preserved.
    ce_eq("pain kind preserved", atom_kind(pain2), ATOM_CONCEPT)
    ce_eq("dose kind LANG preserved", atom_kind(kg_find_atom(med2, "dose")), ATOM_LANG)
    ce_eq("diagnose kind SKILL preserved", atom_kind(kg_find_atom(med2, "diagnose")), ATOM_SKILL)
}

// ---- 4. Triples round-trip (5 triples in one KG) --------------------------

fn test_round_trip_triples() {
    _unlink(TEST_PATH_D)
    let sl = soul_new("aurora")
    let reg = _seed_kg_10atoms()
    let triples = _seed_triples_5()
    let triples_by_kg = list_new()
    push(triples_by_kg, triples)
    let rc = chat_state_save_full(TEST_PATH_D, sl, reg, dl_new(), triples_by_kg, 100)
    ce_eq("save w/ triples ok", rc, 0)
    let r = chat_state_load(TEST_PATH_D)
    ce_eq("load w/ triples ok", chat_state_is_load_ok(r), 1)
    let tbk = chat_state_load_triples(TEST_PATH_D)
    ce_eq("triples-by-kg has 1 KG", len(tbk), 1)
    ce_eq("triples count round-tripped", len(tbk[0]), 5)
    ce_eq("triple 0 subj",  tbk[0][0][0], 0)
    ce_eq("triple 0 rel",   tbk[0][0][1], 9)
    ce_eq("triple 0 obj",   tbk[0][0][2], 1)
    ce_eq("triple 0 belief", tbk[0][0][3], 800)
    ce_eq("triple 4 subj",  tbk[0][4][0], 8)
    ce_eq("triple 4 obj",   tbk[0][4][2], 6)
    ce_eq("triple 4 belief", tbk[0][4][3], 400)
}

// ---- 5. Decision-log tail: 100 entries saved + loaded ---------------------

fn test_round_trip_dlog_tail() {
    _unlink(TEST_PATH_E)
    let sl = soul_new("aurora")
    let reg = kg_registry_new()
    let dlog = _seed_dlog(100)
    ce_eq("seeded dlog has 100 entries", dl_count(dlog), 100)
    let rc = chat_state_save(TEST_PATH_E, sl, reg, dlog)
    ce_eq("save dlog ok", rc, 0)
    let r = chat_state_load(TEST_PATH_E)
    ce_eq("load dlog ok", chat_state_is_load_ok(r), 1)
    let dlog2 = chat_state_loaded_dlog(r)
    ce_eq("dlog 100 entries restored", dl_count(dlog2), 100)
    ce_eq("e0 kind", dl_kind(dl_get(dlog2, 0)),  DLK_INTENT)
    ce_eq("e0 ts",   dl_timestamp(dl_get(dlog2, 0)), 100)
    ce_eq("e99 ts",  dl_timestamp(dl_get(dlog2, 99)), 199)
}

// ---- 6. Decision-log tail-cap: 250 entries saved -> last 100 loaded ------

fn test_dlog_tail_cap() {
    _unlink(TEST_PATH_F)
    let sl = soul_new("aurora")
    let reg = kg_registry_new()
    let dlog = _seed_dlog(250)
    ce_eq("seeded dlog has 250 entries", dl_count(dlog), 250)
    let rc = chat_state_save(TEST_PATH_F, sl, reg, dlog)   // default tail = 100
    ce_eq("save large dlog ok", rc, 0)
    let r = chat_state_load(TEST_PATH_F)
    ce_eq("load capped dlog ok", chat_state_is_load_ok(r), 1)
    let dlog2 = chat_state_loaded_dlog(r)
    ce_eq("dlog tail capped to 100", dl_count(dlog2), 100)
    // The cap walks the END of the log (most recent 100); the 0-th
    // recovered entry should be the 150th seeded entry (ts=250).
    ce_eq("recovered e0 ts is from tail", dl_timestamp(dl_get(dlog2, 0)), 250)
    ce_eq("recovered e99 ts is end of tail", dl_timestamp(dl_get(dlog2, 99)), 349)
}

// ---- 7. Schema VERSION mismatch -> PERSIST_ERR_VERSION -------------------

fn test_version_mismatch() {
    _unlink(TEST_PATH_G)
    // Hand-write a file declaring VERSION 2.
    let fd = sys_open(TEST_PATH_G, O_WRONLY + O_CREAT + O_TRUNC, 416)
    let text = "VERSION 2\nEND\n"
    sys_write(fd, text, len(text))
    sys_fsync(fd)
    sys_close(fd)
    let r = chat_state_load(TEST_PATH_G)
    ce_eq("VERSION 2 file -> PERSIST_ERR_VERSION", r, PERSIST_ERR_VERSION)
}

// ---- 8. Missing file -> PERSIST_ERR_NOT_FOUND ----------------------------

fn test_missing_file() {
    _unlink(TEST_PATH_H)
    // Don't create -- just try to load.
    let r = chat_state_load(TEST_PATH_H)
    ce_eq("missing file -> PERSIST_ERR_NOT_FOUND", r, PERSIST_ERR_NOT_FOUND)
}

// ---- 9. Malformed record -> PERSIST_ERR_PARSE ----------------------------

fn test_malformed_line_returns_parse() {
    _unlink(TEST_PATH_I)
    // Truncated ATOM record (missing label + alpha/beta).
    let fd = sys_open(TEST_PATH_I, O_WRONLY + O_CREAT + O_TRUNC, 416)
    let text = "VERSION 1\nKG_BEGIN medicine\nATOM 0 3\nKG_END\nEND\n"
    sys_write(fd, text, len(text))
    sys_fsync(fd)
    sys_close(fd)
    let r = chat_state_load(TEST_PATH_I)
    ce_eq("malformed ATOM -> PERSIST_ERR_PARSE", r, PERSIST_ERR_PARSE)
}

// ---- 10. Missing END marker -> PERSIST_ERR_PARSE -------------------------

fn test_missing_end_returns_parse() {
    _unlink(TEST_PATH_J)
    let fd = sys_open(TEST_PATH_J, O_WRONLY + O_CREAT + O_TRUNC, 416)
    let text = "VERSION 1\nSOUL_NAME aurora\n"
    sys_write(fd, text, len(text))
    sys_fsync(fd)
    sys_close(fd)
    let r = chat_state_load(TEST_PATH_J)
    ce_eq("no END marker -> PERSIST_ERR_PARSE", r, PERSIST_ERR_PARSE)
}

// ---- 11. Unknown record type within known VERSION -> SKIP ----------------
//
// Forward compat: a future writer might add a `GOAL_ENTRY` line inside the
// VERSION 1 file. The current reader should SKIP unknown record types and
// still load the rest of the file.

fn test_unknown_record_skipped() {
    _unlink(TEST_PATH_K)
    let fd = sys_open(TEST_PATH_K, O_WRONLY + O_CREAT + O_TRUNC, 416)
    let text = "VERSION 1\n"
        + "SOUL_NAME aurora\n"
        + "FUTURE_FIELD some unknown payload here\n"
        + "GOAL_ENTRY 7 active 800 0 0\n"
        + "MORE_FUTURE_STUFF 42\n"
        + "SOUL_OCEAN_O 555\n"
        + "END\n"
    sys_write(fd, text, len(text))
    sys_fsync(fd)
    sys_close(fd)
    let r = chat_state_load(TEST_PATH_K)
    ce_eq("unknown lines skipped, load succeeds", chat_state_is_load_ok(r), 1)
    let sl2 = chat_state_loaded_soul(r)
    ce_str_eq("known SOUL_NAME survived",    soul_name(sl2),    "aurora")
    ce_eq("known SOUL_OCEAN_O survived",     soul_openness(sl2), 555)
}

// ---- 12. EMPTY state round-trips -----------------------------------------

fn test_empty_state_round_trip() {
    _unlink(TEST_PATH_A)
    let sl = soul_new("")
    let reg = kg_registry_new()
    let dlog = dl_new()
    let rc = chat_state_save(TEST_PATH_A, sl, reg, dlog)
    ce_eq("save empty state ok", rc, 0)
    let r = chat_state_load(TEST_PATH_A)
    ce_eq("load empty state ok", chat_state_is_load_ok(r), 1)
    let reg2 = chat_state_loaded_kgs(r)
    let dlog2 = chat_state_loaded_dlog(r)
    ce_eq("empty state: 0 KGs", kg_count(reg2), 0)
    ce_eq("empty state: 0 dlog entries", dl_count(dlog2), 0)
}

// ---- 13. Default path resolution: $CE_PERSIST_PATH overrides $HOME -------

fn test_default_path_respects_env() {
    // We can't easily call setenv from NOVA, but we can directly check the
    // resolver's two-stage precedence by inspecting the result against the
    // current environment. At minimum, the call must return a non-empty
    // path (one of CE_PERSIST_PATH, $HOME/.crossengin/..., or the
    // /tmp/crossengin/... fallback).
    let p = chat_state_default_path()
    ce_check("default path is non-empty", len(p) > 0)
    // Must end in chat_state.dat for $HOME / /tmp branches; we can't assume
    // CE_PERSIST_PATH does (operator-chosen), so just check the path has
    // length when env is set.
    let env = getenv("CE_PERSIST_PATH")
    if env == 0 {
        // No env override -> path must contain "chat_state.dat" suffix.
        let n = len(p)
        let suffix = "chat_state.dat"
        let s = len(suffix)
        ce_check("default path includes filename suffix", n >= s)
    } else {
        if len(env) > 0 {
            ce_str_eq("CE_PERSIST_PATH wins", p, env)
        } else {
            // Empty env value: same precedence as unset.
            let n = len(p)
            let suffix = "chat_state.dat"
            let s = len(suffix)
            ce_check("empty CE_PERSIST_PATH falls through", n >= s)
        }
    }
}

// ---- 14. Auto-mkdir for parent of $HOME/.crossengin/ ---------------------

fn test_auto_mkdir_parent() {
    // Best-effort: write to /tmp/ce_test_chat_state_dir_x/inner/chat_state.dat
    // The parent dir doesn't exist initially -- save must create it.
    sys_unlink(TEST_PATH_AUTOMKDIR)
    let sl = soul_new("aurora")
    let reg = kg_registry_new()
    let rc = chat_state_save(TEST_PATH_AUTOMKDIR, sl, reg, dl_new())
    // We expect either success (mkdir worked) OR PERSIST_ERR_IO (the
    // grandparent dir doesn't exist; sys_mkdir is single-level).
    // The grandparent /tmp/ce_test_chat_state_dir_x does NOT exist; the
    // single-level mkdir creates /tmp/ce_test_chat_state_dir_x/inner only
    // if its parent exists. So this test exercises the IO failure path
    // (PERSIST_ERR_IO) when the grandparent is missing.
    ce_check("auto-mkdir returns IO or ok",
        rc == 0 || rc == PERSIST_ERR_IO)
}

// ---- 15. Save to a non-writable path -> PERSIST_ERR_IO -------------------

fn test_save_unwritable_path() {
    let sl = soul_new("aurora")
    let reg = kg_registry_new()
    // /proc is the canonical non-writable root on Linux.
    let rc = chat_state_save("/proc/this_path_should_be_unwritable", sl, reg, dl_new())
    ce_eq("non-writable save -> PERSIST_ERR_IO", rc, PERSIST_ERR_IO)
}

// ---- 16. Round-trip via in-memory text helper ----------------------------
//
// Exercises chat_state_load_text directly (the variant tests use when they
// don't want to hit the filesystem); guards against a future refactor that
// breaks the text-only path.

fn test_in_memory_text_round_trip() {
    let text = "VERSION 1\n"
        + "SOUL_NAME testname\n"
        + "SOUL_IDENTITY_PURPOSE A purpose with multiple words\n"
        + "SOUL_OCEAN_O 700\n"
        + "VALUE honesty be transparent always\n"
        + "KG_BEGIN testkg\n"
        + "ATOM 0 1 1000 1000 alpha\n"
        + "ATOM 1 1 2000 500 beta\n"
        + "KG_END\n"
        + "END\n"
    let r = chat_state_load_text(text)
    ce_eq("in-memory load ok", chat_state_is_load_ok(r), 1)
    let sl = chat_state_loaded_soul(r)
    ce_str_eq("in-memory soul name",    soul_name(sl), "testname")
    ce_str_eq("in-memory soul purpose", soul_purpose(sl), "A purpose with multiple words")
    ce_eq("in-memory ocean O",          soul_openness(sl), 700)
    ce_str_eq("in-memory value",        soul_value(sl, "honesty"), "be transparent always")
    let reg = chat_state_loaded_kgs(r)
    let kg = kg_find(reg, "testkg")
    ce_check("in-memory KG present", kg != 0)
    ce_eq("in-memory 2 atoms", kg_atom_count(kg), 2)
    let beta = kg_find_atom(kg, "beta")
    ce_eq("in-memory beta alpha", atom_belief(beta)[0], 2000)
    ce_eq("in-memory beta beta",  atom_belief(beta)[1], 500)
}

// ---- 17. is_load_ok behaves correctly on error tags ----------------------

fn test_is_load_ok_predicate() {
    ce_eq("PERSIST_ERR_NOT_FOUND -> not ok", chat_state_is_load_ok(PERSIST_ERR_NOT_FOUND), 0)
    ce_eq("PERSIST_ERR_VERSION   -> not ok", chat_state_is_load_ok(PERSIST_ERR_VERSION),   0)
    ce_eq("PERSIST_ERR_PARSE     -> not ok", chat_state_is_load_ok(PERSIST_ERR_PARSE),     0)
    ce_eq("PERSIST_ERR_IO        -> not ok", chat_state_is_load_ok(PERSIST_ERR_IO),        0)
    // A 3-element list is ok.
    let mock = list_new()
    push(mock, 0); push(mock, 0); push(mock, 0)
    ce_eq("3-list result -> ok", chat_state_is_load_ok(mock), 1)
}

// ---- 18. ADR-0083: cross-KG reference (xref) round-trip ------------------
//
// Build two KGs with a SAME-KG xref and a CROSS-KG xref, save via the
// chat_state path, load back, and assert both xrefs survive with correct
// endpoints (dst kg + dst atom id), kind, weight, and earned flag. Before
// ADR-0083 the chat ATOM format dropped ALL xrefs, so a loaded atom had zero.

fn test_round_trip_xrefs() {
    _unlink(TEST_PATH_B)
    let sl = soul_new("xrefsoul")
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "medicine")
    let bio = kg_spawn(reg, "biology")
    let aspirin = kg_add_atom(med, ATOM_FACT,    "aspirin", 1)   // id 0 in medicine
    let pain    = kg_add_atom(med, ATOM_CONCEPT, "pain",    1)   // id 1 in medicine
    let enzyme  = kg_add_atom(bio, ATOM_CONCEPT, "enzyme",  1)   // id 0 in biology
    // SAME-KG edge: aspirin -> pain (causal, weight 700, not earned).
    atom_add_xref(aspirin, xref_new(aspirin, pain, XREF_CAUSAL, 700, 0))
    // CROSS-KG edge: aspirin -> enzyme (analogical, weight 600, earned).
    atom_add_xref(aspirin, xref_new(aspirin, enzyme, XREF_ANALOGICAL, 600, 1))
    ce_eq("seed aspirin has 2 xrefs", len(atom_xrefs(aspirin)), 2)

    let rc = chat_state_save(TEST_PATH_B, sl, reg, dl_new())
    ce_eq("save w/ xrefs ok", rc, 0)
    let r = chat_state_load(TEST_PATH_B)
    ce_eq("load w/ xrefs ok", chat_state_is_load_ok(r), 1)
    let reg2 = chat_state_loaded_kgs(r)
    let med2 = kg_find(reg2, "medicine")
    let bio2 = kg_find(reg2, "biology")
    ce_check("medicine KG present after load", med2 != 0)
    ce_check("biology KG present after load",  bio2 != 0)
    let aspirin2 = kg_find_atom(med2, "aspirin")
    let pain2    = kg_find_atom(med2, "pain")
    let enzyme2  = kg_find_atom(bio2, "enzyme")
    ce_check("aspirin restored", aspirin2 != 0)
    ce_check("pain restored",    pain2 != 0)
    ce_check("enzyme restored",  enzyme2 != 0)
    let xs = atom_xrefs(aspirin2)
    ce_eq("aspirin has 2 xrefs after load", len(xs), 2)

    // Identify the same-KG (-> medicine/pain) and cross-KG (-> biology/enzyme)
    // edges; order is preserved by emission but we match by dst to be robust.
    let same_idx = 0 - 1
    let cross_idx = 0 - 1
    let k = 0
    while k < len(xs) {
        if str_eq(xref_dst_kg(xs[k]), "medicine") == 1 { same_idx = k }
        if str_eq(xref_dst_kg(xs[k]), "biology") == 1  { cross_idx = k }
        k = k + 1
    }
    ce_check("same-KG xref present", same_idx >= 0)
    ce_check("cross-KG xref present", cross_idx >= 0)

    let sx = xs[same_idx]
    ce_str_eq("same-KG dst kg",  xref_dst_kg(sx), "medicine")
    ce_eq("same-KG dst atom id", xref_dst_atom(sx), atom_id(pain2))
    ce_eq("same-KG kind causal", xref_kind(sx), XREF_CAUSAL)
    ce_eq("same-KG weight",      xref_weight(sx), 700)
    ce_eq("same-KG earned 0",    xref_earned(sx), 0)

    let cx = xs[cross_idx]
    ce_str_eq("cross-KG dst kg",  xref_dst_kg(cx), "biology")
    ce_eq("cross-KG dst atom id", xref_dst_atom(cx), atom_id(enzyme2))
    ce_eq("cross-KG kind analog", xref_kind(cx), XREF_ANALOGICAL)
    ce_eq("cross-KG weight",      xref_weight(cx), 600)
    ce_eq("cross-KG earned 1",    xref_earned(cx), 1)

    // src endpoint correctness: xref_src_kg/src_atom point back at aspirin2.
    ce_str_eq("xref src kg is medicine", xref_src_kg(sx), "medicine")
    ce_eq("xref src atom is aspirin",    xref_src_atom(sx), atom_id(aspirin2))
}

// ---- 19. ADR-0083: back-compat -- old file with no XREF records loads -----
//
// An old chat_state file (written before ADR-0083) carries no XREF lines.
// Loading it must succeed and yield zero xrefs on every atom (no crash).

fn test_xref_backcompat_no_records() {
    let text = "VERSION 1\n"
        + "SOUL_NAME legacy\n"
        + "KG_BEGIN medicine\n"
        + "ATOM 0 1 1000 1000 aspirin\n"
        + "ATOM 1 3 1000 1000 pain\n"
        + "KG_END\n"
        + "END\n"
    let r = chat_state_load_text(text)
    ce_eq("legacy (no XREF) load ok", chat_state_is_load_ok(r), 1)
    let reg = chat_state_loaded_kgs(r)
    let med = kg_find(reg, "medicine")
    ce_check("legacy medicine KG present", med != 0)
    let asp = kg_find_atom(med, "aspirin")
    let pain = kg_find_atom(med, "pain")
    ce_check("legacy aspirin present", asp != 0)
    ce_check("legacy pain present",    pain != 0)
    ce_eq("legacy aspirin 0 xrefs", len(atom_xrefs(asp)),  0)
    ce_eq("legacy pain 0 xrefs",    len(atom_xrefs(pain)), 0)
}

// ---- 20. ADR-0083: malformed XREF record -> PERSIST_ERR_PARSE -------------

fn test_xref_malformed_returns_parse() {
    let text = "VERSION 1\n"
        + "KG_BEGIN medicine\n"
        + "ATOM 0 1 1000 1000 aspirin\n"
        + "XREF 0 medicine\n"        // truncated: missing dst id / kind / weight / earned
        + "KG_END\n"
        + "END\n"
    let r = chat_state_load_text(text)
    ce_eq("malformed XREF -> PERSIST_ERR_PARSE", r, PERSIST_ERR_PARSE)
}

fn main() {
    test_round_trip_soul()
    test_round_trip_multi_kg()
    test_round_trip_10atoms_with_beliefs()
    test_round_trip_triples()
    test_round_trip_dlog_tail()
    test_dlog_tail_cap()
    test_version_mismatch()
    test_missing_file()
    test_malformed_line_returns_parse()
    test_missing_end_returns_parse()
    test_unknown_record_skipped()
    test_empty_state_round_trip()
    test_default_path_respects_env()
    test_auto_mkdir_parent()
    test_save_unwritable_path()
    test_in_memory_text_round_trip()
    test_is_load_ok_predicate()
    test_round_trip_xrefs()
    test_xref_backcompat_no_records()
    test_xref_malformed_returns_parse()
    ce_summary("chat_state_persistence")
}
main()
