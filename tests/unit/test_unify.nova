// Unit tests for src/mind/unify.nova: first-order unification.

import "../ce_test.nova"
import "../../src/mind/unify.nova"

// A unification succeeds AND its substitution makes the two terms equal.
fn _unifies(a, b) {
    let s = unify_terms(a, b)
    if s == 0 { return 0 }
    if term_eq(subst_apply(s, a), subst_apply(s, b)) == 1 { return 1 }
    return 0
}

fn test_atoms() {
    ce_eq("same atom unifies", _unifies(term_atom("a"), term_atom("a")), 1)
    ce_eq("diff atoms fail", unify_terms(term_atom("a"), term_atom("b")), 0)
}

fn test_var_binds_atom() {
    // x unifies with a, binding x:=a.
    let s = unify_terms(term_var("x"), term_atom("a"))
    ce_check("x ~ a succeeds", s != 0)
    ce_eq("x bound to a", term_eq(subst_apply(s, term_var("x")), term_atom("a")), 1)
}

fn test_pred_unify() {
    // P(x) ~ P(a)  ->  x:=a.
    let s = unify_terms(term_pred("P", term_var("x")), term_pred("P", term_atom("a")))
    ce_check("P(x) ~ P(a)", s != 0)
    ce_eq("x:=a from pred", term_eq(subst_apply(s, term_var("x")), term_atom("a")), 1)
    // P(x) ~ Q(a) fails (different predicate).
    ce_eq("P(x) ~ Q(a) fails",
        unify_terms(term_pred("P", term_var("x")), term_pred("Q", term_atom("a"))), 0)
}

fn test_implication_unify() {
    // (P(x) -> Q(x)) ~ (P(a) -> Q(a))  binds x:=a consistently across both sides.
    let lhs = term_imp(term_pred("P", term_var("x")), term_pred("Q", term_var("x")))
    let rhs = term_imp(term_pred("P", term_atom("a")), term_pred("Q", term_atom("a")))
    ce_eq("(P(x)->Q(x)) ~ (P(a)->Q(a))", _unifies(lhs, rhs), 1)
    // inconsistent: (P(x) -> Q(x)) ~ (P(a) -> Q(b)) must FAIL (x can't be a and b).
    let bad = term_imp(term_pred("P", term_atom("a")), term_pred("Q", term_atom("b")))
    ce_eq("inconsistent var fails", unify_terms(lhs, bad), 0)
}

fn test_occurs_check() {
    // x ~ P(x) must fail (would be cyclic).
    ce_eq("occurs check rejects x ~ P(x)",
        unify_terms(term_var("x"), term_pred("P", term_var("x"))), 0)
}

fn test_two_vars() {
    // x ~ y binds them; applying makes them equal.
    let s = unify_terms(term_var("x"), term_var("y"))
    ce_check("x ~ y", s != 0)
    ce_eq("x and y become equal",
        term_eq(subst_apply(s, term_var("x")), subst_apply(s, term_var("y"))), 1)
}

// The headline: unify a universal law's consequent with a ground goal to
// discover the instantiation -- the search uses exactly this.
fn test_discover_instantiation() {
    // law consequent mortal(x) ~ goal mortal(socrates)  ->  x := socrates.
    let s = unify_terms(term_pred("mortal", term_var("x")),
                        term_pred("mortal", term_atom("socrates")))
    ce_check("discovered a binding", s != 0)
    ce_eq("x := socrates",
        term_eq(subst_apply(s, term_var("x")), term_atom("socrates")), 1)
}

fn main() {
    test_atoms()
    test_var_binds_atom()
    test_pred_unify()
    test_implication_unify()
    test_occurs_check()
    test_two_vars()
    test_discover_instantiation()
    ce_summary("unify")
}

main()
