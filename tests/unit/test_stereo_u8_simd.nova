// R15A -- u8 raw-byte SIMD wired into the stereo disparity hot path.
//
// Verifies stereo_sad_block_u8 + stereo_disparity_u8_simd produce
// BIT-IDENTICAL output vs the scalar reference (stereo_sad_block /
// stereo_disparity with CE_STEREO_SIMD=off) on the canonical R7E
// fixtures: flat blocks, shifted-by-8, textured pairs, four-spot
// patterns, vertical edges.
//
// The u8 path packs the WIN_SIZE x WIN_SIZE window into a contiguous
// byte buffer and reduces via R14B's simd_sad_u8 builtin (AVX2
// vpsadbw, 32 bytes per insn -> 4 i64 partials, scalar tail). That
// eliminates the 4x staging-buffer width the R12A i32 path carries
// (one i32 lane per byte pixel). Hit-rate target: 3-4x absolute over
// scalar (R12A i32 SIMD plateaued at ~1.93x).
//
// Coverage targets (~20 assertions):
//   * stereo_sad_block_u8 vs scalar stereo_sad_block on flat / known-
//     diff / negative-diff fixtures: bit-identical.
//   * stereo_sad_block_u8 across ws in {3, 5, 7, 9, 11}: bit-identical
//     to scalar across the full SAD primitive coverage range.
//   * stereo_disparity_u8_simd on R7E's shifted-by-8 textured 64x32:
//     SHIFT=8 disparity at interior probe pixels (correctness on the
//     u8 path).
//   * stereo_disparity_u8_simd disparity map byte-wise identical to
//     scalar disparity on a 48x32 textured pair.
//   * stereo_disparity_u8_simd disparity map byte-wise identical to
//     scalar on a 4-spot pattern + a vertical-edge fixture.
//   * Public stereo_disparity routes to u8 SIMD when CE_STEREO_U8_SIMD
//     opt-in is set (covered by the always-call paths -- the variants
//     are bit-identical regardless of which env-var route fires).
//   * stereo_disparity_u8_simd rejects oversize / zero inputs cleanly.

import "../ce_test.nova"
import "../../src/io/transducers/image_stereo.nova"

// ---- fixture builders ----------------------------------------------------

fn _u8_flat(w, h, v) {
    let area = int_mul(w, h)
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, v)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// Textured pattern -- same as R7E's _textured_fixture.
fn _u8_textured(w, h) {
    let area = int_mul(w, h)
    let buf = alloc(area + 1)
    let y = 0
    while y < h {
        let row_off = int_mul(y, w)
        let x = 0
        while x < w {
            let v = int_add(int_mul(x, 37), int_mul(y, 13))
            let q = v / 256
            v = int_sub(v, int_mul(q, 256))
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// right(x, y) = left(x + shift, y) zero-padded -- R7E's _shift_left.
fn _u8_shift_left(src, w, h, shift) {
    let area = int_mul(w, h)
    let buf = alloc(area + 1)
    let y = 0
    while y < h {
        let row_off = int_mul(y, w)
        let x = 0
        while x < w {
            let sx = int_add(x, shift)
            let v = 0
            if sx < w { v = load8(src + row_off + sx) }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Four-spot pattern: a 4-quadrant pattern (top-left bright, bottom-
// right bright, others dark). Drives disparity tests that need
// SOMETHING distinctive in each block.
fn _u8_four_spots(w, h) {
    let area = int_mul(w, h)
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, 0)
        i = i + 1
    }
    let cx = w / 4
    let cy = h / 4
    let cx2 = int_mul(3, w / 4)
    let cy2 = int_mul(3, h / 4)
    let radius = 3
    let y = 0
    while y < h {
        let row_off = int_mul(y, w)
        let x = 0
        while x < w {
            // bright at (cx, cy) and (cx2, cy2)
            let d1x = int_sub(x, cx)
            let d1y = int_sub(y, cy)
            let d2x = int_sub(x, cx2)
            let d2y = int_sub(y, cy2)
            if d1x < 0 { d1x = 0 - d1x }
            if d1y < 0 { d1y = 0 - d1y }
            if d2x < 0 { d2x = 0 - d2x }
            if d2y < 0 { d2y = 0 - d2y }
            if d1x <= radius {
                if d1y <= radius { store8(buf + row_off + x, 200) }
            }
            if d2x <= radius {
                if d2y <= radius { store8(buf + row_off + x, 200) }
            }
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Vertical-edge fixture: left half dark (40), right half bright (200).
fn _u8_vertical_edge(w, h) {
    let area = int_mul(w, h)
    let buf = alloc(area + 1)
    let mid = w / 2
    let y = 0
    while y < h {
        let row_off = int_mul(y, w)
        let x = 0
        while x < w {
            let v = 40
            if x >= mid { v = 200 }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Local scalar disparity reference (independent of any env-var route).
// Mirrors test_simd_production's _r12a_scalar_disparity_map.
fn _u8_scalar_disparity_map(lft, rgt, w, h, ws, md) {
    let area = int_mul(w, h)
    let map = alloc(area + 1)
    let i = 0
    while i < area {
        store8(map + i, 0)
        i = i + 1
    }
    store8(map + area, 0)
    let half = ws / 2
    let y = half
    let y_max = int_sub(h, half)
    while y < y_max {
        let row_off = int_mul(y, w)
        let x = half
        let x_max = int_sub(w, half)
        while x < x_max {
            let local_max_d = md
            let cap = int_sub(x, half)
            if local_max_d > cap { local_max_d = cap }
            if local_max_d < 0   { local_max_d = 0 }
            let best_sad = -1
            let best_d   = 0
            let d = 0
            while d <= local_max_d {
                let sad = stereo_sad_block(lft, rgt, w, x, int_sub(x, d), y, ws)
                if best_sad < 0 {
                    best_sad = sad
                    best_d   = d
                } else {
                    if sad < best_sad {
                        best_sad = sad
                        best_d   = d
                    }
                }
                d = int_add(d, 1)
            }
            store8(map + int_add(row_off, x), best_d)
            x = int_add(x, 1)
        }
        y = int_add(y, 1)
    }
    return map
}

// ---- stereo_sad_block_u8 vs scalar ---------------------------------------

fn test_sad_u8_flat_zero() {
    let a = _u8_flat(16, 16, 100)
    let b = _u8_flat(16, 16, 100)
    let l_buf = alloc(49 + 8)
    let r_buf = alloc(49 + 8)
    let s_scalar = stereo_sad_block(a, b, 16, 8, 8, 8, 7)
    let s_u8     = stereo_sad_block_u8(a, b, 16, 8, 8, 8, 7, l_buf, r_buf)
    ce_eq("u8 SAD on flat=flat == scalar (0)", s_u8, s_scalar)
    ce_eq("u8 SAD on flat=flat == 0",          s_u8, 0)
}

fn test_sad_u8_known_diff() {
    let a = _u8_flat(16, 16, 100)
    let b = _u8_flat(16, 16, 110)
    let l_buf = alloc(49 + 8)
    let r_buf = alloc(49 + 8)
    let s_scalar = stereo_sad_block(a, b, 16, 8, 8, 8, 7)
    let s_u8     = stereo_sad_block_u8(a, b, 16, 8, 8, 8, 7, l_buf, r_buf)
    ce_eq("u8 SAD (100 vs 110) over 7x7 == scalar", s_u8, s_scalar)
    ce_eq("u8 SAD (100 vs 110) over 7x7 == 490",    s_u8, 490)
}

fn test_sad_u8_negative_diff_symmetric() {
    // simd_sad_u8 treats bytes as UNSIGNED so |a - b| == |b - a| in
    // both implementations. Proves no sign-extension on the byte path.
    let a = _u8_flat(16, 16, 100)
    let b = _u8_flat(16, 16, 50)
    let l_buf = alloc(49 + 8)
    let r_buf = alloc(49 + 8)
    let s_ab = stereo_sad_block_u8(a, b, 16, 8, 8, 8, 7, l_buf, r_buf)
    let s_ba = stereo_sad_block_u8(b, a, 16, 8, 8, 8, 7, l_buf, r_buf)
    ce_eq("u8 SAD symmetric a/b == b/a",  s_ab, s_ba)
    ce_eq("u8 SAD (100 vs 50) == 49*50",  s_ab, 2450)
}

fn test_sad_u8_varying_winsize() {
    // ws in {3, 5, 7, 9, 11} on a textured pair: u8 SAD must be
    // bit-identical to scalar SAD across all window sizes. ws=3 (9
    // bytes, tail-only), ws=5 (25 bytes, tail-only), ws=7 (49 bytes,
    // 1 chunk + tail), ws=9 (81 bytes, 2 chunks + tail), ws=11 (121
    // bytes, 3 chunks + tail). Covers both the vpsadbw chunk path
    // and the scalar tail path.
    let a = _u8_textured(32, 32)
    let b = _u8_shift_left(a, 32, 32, 2)
    let l_buf = alloc(121 + 8)
    let r_buf = alloc(121 + 8)
    let s3_sc = stereo_sad_block(a, b, 32, 16, 14, 16, 3)
    let s3_u8 = stereo_sad_block_u8(a, b, 32, 16, 14, 16, 3, l_buf, r_buf)
    ce_eq("u8 SAD ws=3 == scalar", s3_u8, s3_sc)
    let s5_sc = stereo_sad_block(a, b, 32, 16, 14, 16, 5)
    let s5_u8 = stereo_sad_block_u8(a, b, 32, 16, 14, 16, 5, l_buf, r_buf)
    ce_eq("u8 SAD ws=5 == scalar", s5_u8, s5_sc)
    let s7_sc = stereo_sad_block(a, b, 32, 16, 14, 16, 7)
    let s7_u8 = stereo_sad_block_u8(a, b, 32, 16, 14, 16, 7, l_buf, r_buf)
    ce_eq("u8 SAD ws=7 == scalar", s7_u8, s7_sc)
    let s9_sc = stereo_sad_block(a, b, 32, 16, 14, 16, 9)
    let s9_u8 = stereo_sad_block_u8(a, b, 32, 16, 14, 16, 9, l_buf, r_buf)
    ce_eq("u8 SAD ws=9 == scalar", s9_u8, s9_sc)
    let s11_sc = stereo_sad_block(a, b, 32, 16, 14, 16, 11)
    let s11_u8 = stereo_sad_block_u8(a, b, 32, 16, 14, 16, 11, l_buf, r_buf)
    ce_eq("u8 SAD ws=11 == scalar", s11_u8, s11_sc)
}

// ---- stereo_disparity_u8_simd byte-wise == scalar reference --------------

fn test_disparity_u8_simd_byte_wise_identical_textured() {
    let lft = _u8_textured(48, 32)
    let rgt = _u8_shift_left(lft, 48, 32, 6)
    let m_sc = _u8_scalar_disparity_map(lft, rgt, 48, 32, 7, 32)
    let r_u8 = stereo_disparity_u8_simd(lft, rgt, 48, 32, 7, 32)
    let m_u8 = stereo_result_map(r_u8)
    let area = 48 * 32
    let mismatches = 0
    let i = 0
    while i < area {
        if load8(m_sc + i) != load8(m_u8 + i) {
            mismatches = mismatches + 1
        }
        i = i + 1
    }
    ce_eq("u8 SIMD vs scalar disparity map: byte-wise identical (48x32 textured)",
          mismatches, 0)
}

// R7E's shifted-by-8 fixture -- the u8 path must produce the same
// SHIFT=8 disparity at interior probe pixels as scalar / i32 SIMD.
fn test_disparity_u8_simd_shifted_by_8_correct() {
    let SHIFT = 8
    let lft = _u8_textured(64, 32)
    let rgt = _u8_shift_left(lft, 64, 32, SHIFT)
    let r = stereo_disparity_u8_simd(lft, rgt, 64, 32, 7, 32)
    let m = stereo_result_map(r)
    ce_check("u8 SIMD shifted-by-8 produces non-zero map", m != 0)
    ce_eq("u8 SIMD disparity at (30,16) == 8", stereo_disparity_at(m, 64, 30, 16), SHIFT)
    ce_eq("u8 SIMD disparity at (35,18) == 8", stereo_disparity_at(m, 64, 35, 18), SHIFT)
    ce_eq("u8 SIMD disparity at (40,20) == 8", stereo_disparity_at(m, 64, 40, 20), SHIFT)
    ce_eq("u8 SIMD disparity at (45,14) == 8", stereo_disparity_at(m, 64, 45, 14), SHIFT)
}

// Four-spot pattern cross-fixture: the u8 SIMD disparity map must
// agree byte-wise with scalar -- the SAD primitive doesn't care
// about the spatial frequency of the input.
fn test_disparity_u8_simd_four_spots_identical() {
    let lft = _u8_four_spots(48, 32)
    let rgt = _u8_shift_left(lft, 48, 32, 4)
    let m_sc = _u8_scalar_disparity_map(lft, rgt, 48, 32, 7, 16)
    let r_u8 = stereo_disparity_u8_simd(lft, rgt, 48, 32, 7, 16)
    let m_u8 = stereo_result_map(r_u8)
    let area = 48 * 32
    let mismatches = 0
    let i = 0
    while i < area {
        if load8(m_sc + i) != load8(m_u8 + i) {
            mismatches = mismatches + 1
        }
        i = i + 1
    }
    ce_eq("u8 SIMD vs scalar disparity: four-spots fixture byte-wise identical",
          mismatches, 0)
}

// Vertical-edge cross-fixture: the SAD minimum is ambiguous on flat
// regions (multiple disparity values produce identical SAD), so the
// argmin is implementation-defined -- but both scalar and u8 SIMD walk
// the d loop in the SAME order (0..local_max_d ascending) and pick the
// first match, so the resulting maps are still bit-identical.
fn test_disparity_u8_simd_vertical_edge_identical() {
    let lft = _u8_vertical_edge(48, 24)
    let rgt = _u8_shift_left(lft, 48, 24, 3)
    let m_sc = _u8_scalar_disparity_map(lft, rgt, 48, 24, 7, 16)
    let r_u8 = stereo_disparity_u8_simd(lft, rgt, 48, 24, 7, 16)
    let m_u8 = stereo_result_map(r_u8)
    let area = 48 * 24
    let mismatches = 0
    let i = 0
    while i < area {
        if load8(m_sc + i) != load8(m_u8 + i) {
            mismatches = mismatches + 1
        }
        i = i + 1
    }
    ce_eq("u8 SIMD vs scalar disparity: vertical-edge byte-wise identical",
          mismatches, 0)
}

// Identical-input invariant: left == right -> mean disparity 0 at
// every interior pixel under the u8 path.
fn test_disparity_u8_simd_identical_zero() {
    let buf = _u8_textured(48, 32)
    let r = stereo_disparity_u8_simd(buf, buf, 48, 32, 7, 32)
    let m = stereo_result_map(r)
    ce_check("u8 SIMD identical inputs produce non-zero map ptr", m != 0)
    ce_eq("u8 SIMD identical inputs -> mean 0", stereo_result_mean(r), 0)
    ce_eq("u8 SIMD identical inputs -> density 0", stereo_result_density(r), 0)
}

// Reject oversize / zero inputs cleanly (same contract as the i32 path).
fn test_disparity_u8_simd_input_validation() {
    let dummy = alloc(8)
    let r0 = stereo_disparity_u8_simd(0, dummy, 8, 8, 7, 16)
    ce_eq("zero left ptr -> total 0", stereo_result_total(r0), 0)
    let r1 = stereo_disparity_u8_simd(dummy, 0, 8, 8, 7, 16)
    ce_eq("zero right ptr -> total 0", stereo_result_total(r1), 0)
    let r2 = stereo_disparity_u8_simd(dummy, dummy, 300, 300, 7, 16)
    ce_eq("oversize dims -> total 0",  stereo_result_total(r2), 0)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_sad_u8_flat_zero()
    test_sad_u8_known_diff()
    test_sad_u8_negative_diff_symmetric()
    test_sad_u8_varying_winsize()
    test_disparity_u8_simd_byte_wise_identical_textured()
    test_disparity_u8_simd_shifted_by_8_correct()
    test_disparity_u8_simd_four_spots_identical()
    test_disparity_u8_simd_vertical_edge_identical()
    test_disparity_u8_simd_identical_zero()
    test_disparity_u8_simd_input_validation()
    ce_summary("image_stereo_u8_simd")
}

main()
