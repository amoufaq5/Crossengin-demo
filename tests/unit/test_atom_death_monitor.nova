// Unit tests for src/learning/atom_death_monitor.nova
// Verifies the death gates (activation, belief, protection, cross-ref), the
// two-phase tombstone -> hard-remove sweep, and rescue on reactivation.
// ADR-0025.

import "../ce_test.nova"
import "../../src/learning/atom_death_monitor.nova"

fn weak_atom(kg, label) {
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    adm_init(a, 0)
    adm_decay(a, 10)   // 1.0 * 0.01 = 0.01 < 0.02 floor
    return a
}

fn test_gates() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let a = weak_atom(kg, "cold")
    ce_check("weak activation", adm_act(a) < DEATH_STRENGTH)
    ce_eq("collectable", adm_is_collectable(reg, a), 1)

    // Protected atoms are never collected.
    let p = weak_atom(kg, "constitutional")
    adm_set_protected(p)
    ce_eq("protected exempt", adm_is_collectable(reg, p), 0)

    // Well-evidenced atoms are never collected.
    let strong = weak_atom(kg, "well_known")
    atom_observe(strong, 1); atom_observe(strong, 1); atom_observe(strong, 1)
    ce_check("belief strength high", bel_strength(atom_belief(strong)) >= DEATH_BELIEF)
    ce_eq("well-evidenced exempt", adm_is_collectable(reg, strong), 0)

    // Referenced atoms are never collected.
    let referent = weak_atom(kg, "referent")
    let referrer = kg_add_atom(kg, ATOM_FACT, "referrer", 0)
    atom_add_xref(referrer, xref_new(referrer, referent, XREF_CAUSAL, 500, 0))
    ce_eq("referenced", adm_is_referenced(reg, referent), 1)
    ce_eq("referenced exempt", adm_is_collectable(reg, referent), 0)
}

fn test_tombstone_then_remove() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let a = weak_atom(kg, "doomed")
    // First sweep tombstones it.
    let s1 = adm_sweep(reg, kg)
    ce_eq("one tombstoned", s1[0], 1)
    ce_eq("none removed yet", s1[1], 0)
    ce_eq("is tombstoned", adm_is_tombstoned(a), 1)
    // Second sweep (still collectable) hard-removes it.
    let s2 = adm_sweep(reg, kg)
    ce_eq("removed on second sweep", s2[1], 1)
    ce_eq("is dead", adm_is_dead(a), 1)
    // P1.7 Phase B: the dead atom is now actually reclaimed -- slot nulled and
    // recorded on the free-list -- not just flagged. (The `a` handle still reads
    // dead because the object itself persists; only the KG slot is freed.)
    ce_eq("slot reclaimed", kg_atom(kg, atom_id(a)), 0)
    ce_eq("freelist recorded it", kg_freelist_count(kg), 1)
    // A third sweep over the now-holed KG must not crash and must do nothing.
    let s3 = adm_sweep(reg, kg)
    ce_eq("third sweep no-op", s3[1], 0)
}

fn test_rescue_on_reactivation() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "med")
    let a = weak_atom(kg, "revived")
    adm_sweep(reg, kg)               // tombstone
    ce_eq("tombstoned", adm_is_tombstoned(a), 1)
    adm_reinforce(a, 5)              // reactivated: activation back above floor
    ce_check("reactivated", adm_act(a) >= DEATH_STRENGTH)
    let s = adm_sweep(reg, kg)       // rescues, does not remove
    ce_eq("rescued", s[2], 1)
    ce_eq("not removed", s[1], 0)
    ce_eq("tombstone cleared", adm_is_tombstoned(a), 0)
    ce_eq("not dead", adm_is_dead(a), 0)
}

fn main() {
    test_gates()
    test_tombstone_then_remove()
    test_rescue_on_reactivation()
    ce_summary("atom_death_monitor")
}

main()
