// Audit F-09: differential-privacy noise had the wrong scale.
//  - Every session seeded its 15-bit LCG with budget + 7919, so two dp_new
//    states produced identical noise.
//  - The geometric sampler capped its scale at 100000 and used 10-bit
//    uniforms, so noise stopped growing below epsilon = 0.01.
//  - dp_noisy_mean added noise in whole units to a milli-valued mean, i.e.
//    ~1000x too little (usually exactly 0).
// Seeded states (ChaCha20) keep these checks deterministic.

import "../ce_test.nova"
import "../../src/safety/differential_privacy.nova"
import "std/string"
import "std/io"

fn _abs(x) { if x < 0 { return 0 - x } return x }

// mean |noise| over n draws of the count mechanism at epsilon_milli.
fn _mean_abs_count(seed, eps, n) {
    let dp = dp_new_seeded(100000000, seed)
    let total = 0
    let i = 0
    while i < n {
        let v = dp_noisy_count(dp, 1000, eps)
        total = total + _abs(v - 1000)
        i = i + 1
    }
    return total / n
}

fn test_count_noise_scales_with_epsilon() {
    // Laplace scale = 1/epsilon -> E|noise| ~ 1/epsilon (whole units).
    let m1000 = _mean_abs_count(11, 1000, 200)     // eps 1.0   -> ~1
    let m100  = _mean_abs_count(12, 100, 200)      // eps 0.1   -> ~10
    let m5    = _mean_abs_count(13, 5, 100)        // eps 0.005 -> ~200
    // eps 0.001 -> ~1000. The old 10-bit sampler could not exceed t=1023/1024
    // (E|X| ~ 511 here), so this separates 32-bit from 10-bit uniforms.
    let m1    = _mean_abs_count(14, 1, 100)
    print("mean|noise| eps=1.0:") print_int(m1000)
    print(" eps=0.1:") print_int(m100)
    print(" eps=0.005:") print_int(m5) println("")
    ce_check("eps 1.0 noise small (<= 3)", m1000 <= 3)
    ce_check("eps 0.1 noise ~10 (5..20)", m100 >= 5)
    ce_check("eps 0.1 noise ~10 (<= 20)", m100 <= 20)
    // The old sampler capped here at ~92 regardless of epsilon.
    ce_check("eps 0.005 noise ~200 (>= 120)", m5 >= 120)
    ce_check("eps 0.005 noise ~200 (<= 320)", m5 <= 320)
    print(" eps=0.001:") print_int(m1) println("")
    ce_check("eps 0.001 noise ~1000 (>= 700)", m1 >= 700)
    ce_check("eps 0.001 noise ~1000 (<= 1400)", m1 <= 1400)
}

fn test_noisy_mean_is_actually_noised() {
    // sensitivity 100 milli, epsilon 1000 milli -> Laplace scale 100 milli.
    let dp = dp_new_seeded(100000000, 21)
    let changed = 0
    let total = 0
    let i = 0
    while i < 100 {
        let v = dp_noisy_mean(dp, 500, 100, 1000)
        if v != 500 { changed = changed + 1 }
        total = total + _abs(v - 500)
        i = i + 1
    }
    print("noisy_mean: changed=") print_int(changed) print(" mean|d|=") print_int(total / 100) println("")
    ce_check("most noisy means differ from the true mean", changed >= 80)
    ce_check("noise magnitude ~ scale 100 milli (40..250)", total / 100 >= 40)
    ce_check("noise magnitude ~ scale 100 milli (<= 250)", total / 100 <= 250)
}

fn test_fresh_states_differ() {
    // Two dp_new states (OS entropy) must not share a noise stream.
    let a = dp_new(100000000)
    let b = dp_new(100000000)
    let same = 0
    let i = 0
    while i < 20 {
        if dp_noisy_count(a, 1000, 100) == dp_noisy_count(b, 1000, 100) { same = same + 1 }
        i = i + 1
    }
    ce_check("two dp_new states give different noise", same <= 5)
}

fn test_seeded_is_deterministic() {
    let a = dp_new_seeded(100000000, 77)
    let b = dp_new_seeded(100000000, 77)
    let eq = 1
    let i = 0
    while i < 20 {
        if dp_noisy_count(a, 0, 100) != dp_noisy_count(b, 0, 100) { eq = 0 }
        i = i + 1
    }
    ce_eq("same seed -> same stream", eq, 1)
}

fn test_different_seeds_differ() {
    let a = dp_new_seeded(100000000, 77)
    let b = dp_new_seeded(100000000, 78)
    let same = 0
    let i = 0
    while i < 20 {
        if dp_noisy_count(a, 0, 100) == dp_noisy_count(b, 0, 100) { same = same + 1 }
        i = i + 1
    }
    ce_check("different seeds -> different streams", same <= 5)
}

fn test_huge_scale_refused_not_zero() {
    // Review finding: s * 2^32 overflowed for scale >= 2^30 milli and the
    // noise silently became 0. Oversized scales are now refused, and the
    // budget is not spent on them.
    let dp = dp_new_seeded(100000000, 5)
    let before = dp_remaining_budget(dp)
    let v = dp_noisy_mean(dp, 500, 1000000, 1)     // scale 1e12 milli
    ce_eq("huge-scale mean query refused", dp_is_refused(v), 1)
    ce_eq("refusal spends no budget", dp_remaining_budget(dp), before)
    // The threshold itself must not wrap at very large scales (the old
    // s * 2^32 product went negative for s >= 2^30).
    let t30 = _dp_threshold(1073741824)
    let t40 = _dp_threshold(1099511627776)
    ce_check("threshold at s=2^30 in (0, 2^32)", t30 > 4290000000)
    ce_check("threshold at s=2^30 < 2^32", t30 < 4294967296)
    ce_check("threshold at s=2^40 in (0, 2^32)", t40 > 4294967000)
    ce_check("threshold at s=2^40 < 2^32", t40 < 4294967296)
    ce_eq("threshold at s=1000 is exactly 2^31", _dp_threshold(1000), 2147483648)
}

fn main() {
    test_count_noise_scales_with_epsilon()
    test_noisy_mean_is_actually_noised()
    test_fresh_states_differ()
    test_seeded_is_deterministic()
    test_different_seeds_differ()
    test_huge_scale_refused_not_zero()
    ce_summary("dp_scale")
}

main()
