// Unit tests for src/safety/x509_verify.nova -- RSA cert parsing + chain
// verification, against a synthetic openssl chain (root -> leaf, SAN
// test.example + *.test.example, RSA-2048, sha256, 100-year validity, so the
// vectors don't rot). openssl "verify -CAfile root leaf" => OK.

import "../ce_test.nova"
import "../../src/safety/x509_verify.nova"

fn _hxv(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0
}
fn hexbuf(s) {
    let n = len(s) / 2
    let b = alloc(n + 1)
    let k = 0
    while k < n { store8(b + k, _hxv(char_at(s, k*2)) * 16 + _hxv(char_at(s, k*2+1))) k = k + 1 }
    let r = list_new() push(r, b) push(r, n) return r
}

let LEAF = ""
let ROOT = ""
let RMOD = ""
let EC_LEAF = ""
let EC_ROOT = ""

fn _has_san(san, name) {
    let i = 0
    while i < len(san) { if str_eq(san[i], name) == 1 { return 1 } i = i + 1 }
    return 0
}

fn test_parse() {
    let l = hexbuf(LEAF)
    let c = cert_parse(l[0], l[1])
    ce_eq("leaf parses", cert_ok(c), 1)
    ce_check("leaf SAN has test.example", _has_san(cert_san(c), "test.example") == 1)
    ce_check("leaf SAN has wildcard", _has_san(cert_san(c), "*.test.example") == 1)
    ce_check("validity window sane", cert_not_after(c) > cert_not_before(c))
}

fn test_chain() {
    let l = hexbuf(LEAF)
    let r = hexbuf(ROOT)
    let chain = list_new()
    push(chain, l)
    push(chain, r)
    let pinN = bn2048_from_hex(RMOD)
    let now = cert_not_before(cert_parse(l[0], l[1])) + 1000

    // anchors are [key_type, A, B]; build a one-entry RSA trust store.
    let anchors = list_new()
    let a0 = list_new() push(a0, KEY_RSA) push(a0, pinN) push(a0, 65537)
    push(anchors, a0)

    let ok = cert_chain_verify(chain, "test.example", anchors, now)
    ce_eq("chain verifies", ok[0], XV_OK)

    let wild = cert_chain_verify(chain, "abc.test.example", anchors, now)
    ce_eq("wildcard host ok", wild[0], XV_OK)

    let badhost = cert_chain_verify(chain, "evil.com", anchors, now)
    ce_eq("wrong host rejected", badhost[0], XV_HOSTNAME)

    let bad_anchors = list_new()
    let b0 = list_new() push(b0, KEY_RSA) push(b0, bn2048_from_int(3)) push(b0, 65537)
    push(bad_anchors, b0)
    let badpin = cert_chain_verify(chain, "test.example", bad_anchors, now)
    ce_eq("wrong pin rejected", badpin[0], XV_NOT_PINNED)
}


fn test_ecdsa_chain() {
    let l = hexbuf(EC_LEAF)
    let r = hexbuf(EC_ROOT)
    let lc = cert_parse(l[0], l[1])
    ce_eq("EC leaf parses", cert_ok(lc), 1)
    ce_eq("EC leaf key type", cert_key_type(lc), KEY_EC)
    ce_eq("EC leaf sig type", cert_sig_type(lc), SIG_ECDSA)
    let rc = cert_parse(r[0], r[1])
    let anchor = list_new() push(anchor, KEY_EC) push(anchor, cert_ec_point(rc)) push(anchor, cert_ec_point_n(rc))
    let anchors = list_new() push(anchors, anchor)
    let chain = list_new() push(chain, l) push(chain, r)
    let now = cert_not_before(lc) + 1000
    ce_eq("EC chain verifies", cert_chain_verify(chain, "ec.example", anchors, now)[0], XV_OK)
    ce_eq("EC wrong host rejected", cert_chain_verify(chain, "evil.com", anchors, now)[0], XV_HOSTNAME)
    let bad = list_new()
    let ba = list_new() push(ba, KEY_EC) push(ba, cert_ec_point(lc)) push(ba, cert_ec_point_n(lc))
    push(bad, ba)
    ce_eq("EC wrong anchor rejected", cert_chain_verify(chain, "ec.example", bad, now)[0], XV_NOT_PINNED)
}

fn main() {
    test_parse()
    test_chain()
    test_ecdsa_chain()
    ce_summary("x509_verify")
}

main()
