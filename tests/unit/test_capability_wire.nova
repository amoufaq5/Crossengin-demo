    test_issue_with_expiry()
    test_issue_missing_holder()
    test_issue_empty_holder()
    test_issue_unknown_role()
    test_issue_no_registry_refuses()
    test_revoke_kills_liveness()
    test_revoke_unknown_returns_false()
    test_revoke_missing_arg()
    test_list_returns_entries_without_token_ids()
    test_list_empty_registry()
    test_list_no_registry()
    test_reader_cannot_issue_under_enforcement()
    test_admin_can_issue_under_enforcement()
    test_issued_token_works_then_revoked()
    test_token_id_mint_shape()
    // R78 -- admin.rotate_token
    test_r78_verb_registered()
    test_r78_cap_is_admin_sandbox()
    test_r78_no_registry_refuses()
    test_r78_missing_token_id_refuses()
    test_r78_unknown_token_id_refuses()
    test_r78_reader_refused_by_cap()
    test_r78_rotates_id_preserves_holder_and_caps()
    test_r78_new_id_looks_up_the_same_token()
    test_r78_rotate_is_idempotent_by_holder_but_not_by_id()
    // R79 -- admin.set_qps
    test_r79_verb_registered()
    test_r79_cap_is_admin_sandbox()
    test_r79_no_registry_refuses()
    test_r79_missing_token_id_refuses()
    test_r79_missing_qps_max_refuses()
    test_r79_negative_qps_refused()
    test_r79_unknown_token_id_refuses()
    test_r79_reader_refused_by_cap()
    test_r79_set_qps_from_zero_to_positive()
    test_r79_set_qps_can_go_back_to_unlimited()
    test_r79_set_qps_resets_window()
    // R80 -- capability.list echoes window state
    test_r80_list_carries_qps_max_and_window_fields()
    test_r80_list_reflects_live_window_count()
    test_r80_list_after_set_qps_resets_window_count()
    // R81 -- admin.set_expires
    test_r81_verb_registered()
    test_r81_cap_is_admin_sandbox()
    test_r81_no_registry_refuses()
    test_r81_missing_token_id_refuses()
    test_r81_missing_expires_at_refuses()
    test_r81_negative_expires_refused()
    test_r81_unknown_token_id_refuses()
    test_r81_reader_refused_by_cap()
    test_r81_set_expires_from_never_to_finite()
    test_r81_set_expires_to_zero_never_expires()
    test_r81_set_expires_can_expire_immediately()
    test_r81_set_expires_reflected_in_capability_list()
    // R82 -- admin.grant_cap + admin.remove_cap
    test_r82_verbs_registered()
    test_r82_verbs_capped_admin_sandbox()
    test_r82_grant_no_registry_refuses()
    test_r82_grant_missing_token_id()
    test_r82_grant_missing_cap()
    test_r82_grant_empty_cap_refused()
    test_r82_grant_unknown_cap_refused()
    test_r82_grant_unknown_token_id_refused()
    test_r82_grant_reader_refused_by_cap()
    test_r82_grant_new_cap_appended()
    test_r82_grant_idempotent_when_already_present()
    test_r82_remove_cap_present()
    test_r82_remove_cap_idempotent_when_absent()
    test_r82_remove_accepts_unknown_cap_string()
    test_r82_grant_then_use_via_authorize()
    test_r82_remove_then_use_via_authorize()
    // R83 -- admin.set_revoked
    test_r83_verb_registered()
    test_r83_cap_is_admin_sandbox()
    test_r83_no_registry_refuses()
    test_r83_missing_args_refused()
    test_r83_out_of_range_refused()
    test_r83_unknown_token_refused()
    test_r83_reader_refused_by_cap()
