}

fn test_r82_grant_unknown_cap_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "tk-admin", "cap", "typo:everything"), ctx)
    ce_check("unknown cap refused",
             _has(out, "unknown cap: typo:everything"))
}

fn test_r82_grant_unknown_token_id_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "never", "cap", "nl:ask"), ctx)
    ce_check("unknown token refused",
             _has(out, "unknown token_id"))
}

fn test_r82_grant_reader_refused_by_cap() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "tk-r", "cap", "nl:ask"), ctx)
    ce_check("reader refused",
             _has(out, "capability required: admin:sandbox"))
}

fn test_r82_grant_new_cap_appended() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    // Reader token doesn't have skill:run by default.
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-oscar", "oscar", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    ce_eq("initially lacks skill:run",
          token_has_cap(t, CAP_SKILL_RUN), 0)
    let before_count = len(token_caps(t))
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "tk-oscar", "cap", "skill:run"), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    ce_check("granted true",        _has(out, "\"granted\":true"))
    ce_check("holder oscar",        _has(out, "\"holder\":\"oscar\""))
    ce_check("caps list contains skill:run",
             _has(out, "\"skill:run\""))
    ce_eq("token now has skill:run",
          token_has_cap(t, CAP_SKILL_RUN), 1)
    ce_eq("caps count grew by 1",
          len(token_caps(t)), before_count + 1)
}

fn test_r82_grant_idempotent_when_already_present() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")   // already has nl:ask
    let t = capability_token_new_roles("tk-paula", "paula", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    let before_count = len(token_caps(t))
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "tk-paula", "cap", "nl:ask"), ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("granted false (already present)",
             _has(out, "\"granted\":false"))
    ce_eq("caps count unchanged",
          len(token_caps(t)), before_count)
}

fn test_r82_remove_cap_present() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-quinn", "quinn", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    ce_eq("initially has nl:ask",
          token_has_cap(t, CAP_NL_ASK), 1)
    let out = rpc_dispatch("admin.remove_cap",
        _mk_args2("token_id", "tk-quinn", "cap", "nl:ask"), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    ce_check("removed true",        _has(out, "\"removed\":true"))
    ce_eq("token no longer has nl:ask",
          token_has_cap(t, CAP_NL_ASK), 0)
    // The response echoes cap="nl:ask" (arg) but the caps array
    // must not contain it -- verify via token state, which is the
    // authoritative check anyway.
    ce_eq("token no longer holds nl:ask",
          token_has_cap(t, CAP_NL_ASK), 0)
}

fn test_r82_remove_cap_idempotent_when_absent() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-rita", "rita", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    ce_eq("initially lacks admin:sandbox",
          token_has_cap(t, CAP_ADMIN_SANDBOX), 0)
    let out = rpc_dispatch("admin.remove_cap",
        _mk_args2("token_id", "tk-rita", "cap", "admin:sandbox"), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("removed false (absent)", _has(out, "\"removed\":false"))
}

fn test_r82_remove_accepts_unknown_cap_string() {
    // remove doesn't validate against known-cap list (documented
    // exception -- lets an operator clean up a legacy token that
    // somehow has a stale cap).
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-sam", "sam", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    // Manually inject a stale cap string (simulates the R55-era
    // bug scenario the remove path is designed to clean up).
    push(t[TOK_CAPS], "legacy:weird_cap")
    ce_eq("token has stale cap",
          token_has_cap(t, "legacy:weird_cap"), 1)
    let out = rpc_dispatch("admin.remove_cap",
        _mk_args2("token_id", "tk-sam", "cap", "legacy:weird_cap"), ctx)
    ce_check("removed true",        _has(out, "\"removed\":true"))
    ce_eq("stale cap gone",
          token_has_cap(t, "legacy:weird_cap"), 0)
}

fn test_r82_grant_then_use_via_authorize() {
    // End-to-end: grant a cap to a reader token, verify the
    // resulting cap gate lets the reader hit skill.run.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-tara", "tara", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    // Before grant: reader doesn't have skill:run.
    ce_str_eq("pre-grant authorize refuses",
              capability_authorize(1, admin_reg, "tk-tara", "skill.run", 100),
              "capability required: skill:run")
    // Grant via wire.
    rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "tk-tara", "cap", "skill:run"), ctx)
    // After grant: authorize passes for skill.run.
    ce_str_eq("post-grant authorize succeeds",
              capability_authorize(1, admin_reg, "tk-tara", "skill.run", 100),
              "")
}

fn test_r82_remove_then_use_via_authorize() {
    // End-to-end: remove nl:ask from a reader token, verify the
    // cap gate now refuses nl.ask.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-uma", "uma", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    // Before remove: reader has nl:ask.
    ce_str_eq("pre-remove authorize succeeds",
              capability_authorize(1, admin_reg, "tk-uma", "nl.ask", 100),
              "")
    // Remove via wire.
    rpc_dispatch("admin.remove_cap",
        _mk_args2("token_id", "tk-uma", "cap", "nl:ask"), ctx)
    // After remove: authorize refuses.
    ce_str_eq("post-remove authorize refuses",
              capability_authorize(1, admin_reg, "tk-uma", "nl.ask", 100),
              "capability required: nl:ask")
}

// ---- R83: admin.set_revoked ---------------------------------------

fn test_r83_verb_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.set_revoked") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.set_revoked registered", saw, 1)
}

fn test_r83_cap_is_admin_sandbox() {
    ce_eq("cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("admin.set_revoked"),
                       CAP_ADMIN_SANDBOX), 1)
}

fn test_r83_no_registry_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "x", "revoked", "1"), ctx)
    ce_check("names no cap registry",
             _has(out, "no capability registry in context"))
}

fn test_r83_missing_args_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out1 = rpc_dispatch("admin.set_revoked",
        _mk_arg("revoked", "1"), ctx)
    ce_check("missing token_id", _has(out1, "missing arg: token_id"))
    let out2 = rpc_dispatch("admin.set_revoked",
        _mk_arg("token_id", "tk-admin"), ctx)
    ce_check("missing revoked",  _has(out2, "missing arg: revoked"))
}

fn test_r83_out_of_range_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out1 = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-admin", "revoked", "2"), ctx)
    ce_check("value 2 refused", _has(out1, "revoked must be 0 or 1"))
    let out2 = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-admin", "revoked", "-1"), ctx)
    ce_check("value -1 refused", _has(out2, "revoked must be 0 or 1"))
    // Non-numeric (str_to_int returns 0 for garbage; explicit
    // string check catches this and refuses).
    let out3 = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-admin", "revoked", "true"), ctx)
    ce_check("value 'true' refused (must be literal 0/1)",
             _has(out3, "revoked must be 0 or 1"))
}

fn test_r83_unknown_token_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "never-existed", "revoked", "1"), ctx)
    ce_check("unknown refused", _has(out, "unknown token_id"))
}

fn test_r83_reader_refused_by_cap() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    let out = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-r", "revoked", "1"), ctx)
    ce_check("reader refused",
             _has(out, "capability required: admin:sandbox"))
}

fn test_r83_revoke_then_authorize_refuses() {
    // Sanity: set_revoked=1 is equivalent to capability.revoke as
    // far as token_is_live is concerned.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-victor", "victor", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    ce_eq("initially live", token_is_live(t, 100), 1)
    let out = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-victor", "revoked", "1"), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("old_revoked false",  _has(out, "\"old_revoked\":false"))
    ce_check("new_revoked true",   _has(out, "\"new_revoked\":true"))
    ce_eq("now revoked", token_revoked(t), 1)
    ce_eq("no longer live", token_is_live(t, 100), 0)
}

fn test_r83_un_revoke_restores_liveness() {
    // The R83 audit-pure recovery path: mis-revoke, then un-revoke,
    // and the token is live again with identity intact.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-wanda", "wanda", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    // Revoke via R55.
    capability_registry_revoke(admin_reg, "tk-wanda")
    ce_eq("revoked",       token_revoked(t), 1)
    ce_eq("not live",      token_is_live(t, 100), 0)
    // Un-revoke via R83.
    let out = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-wanda", "revoked", "0"), ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("old_revoked true",  _has(out, "\"old_revoked\":true"))
    ce_check("new_revoked false", _has(out, "\"new_revoked\":false"))
    ce_eq("not revoked",  token_revoked(t), 0)
    ce_eq("live again",   token_is_live(t, 100), 1)
    // Identity preserved: token_id still tk-wanda, caps + holder
    // pointer-identical to pre-revoke.
    ce_str_eq("id preserved",     token_id(t), "tk-wanda")
    ce_str_eq("holder preserved", token_holder(t), "wanda")
}

fn test_r83_set_revoked_reflected_in_capability_list() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-xander", "xander", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    // Revoke via R83.
    rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-xander", "revoked", "1"), ctx)
    let out = rpc_dispatch("capability.list", list_new(), ctx)
    // Verify xander shows revoked:true in the list.
    ce_check("xander present",         _has(out, "\"holder\":\"xander\""))
    // capability.list encodes revoked as bool.
    ce_check("shows revoked:true",     _has(out, "\"revoked\":true"))
    // Un-revoke; list reflects that too.
    rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-xander", "revoked", "0"), ctx)
    ce_eq("token no longer revoked", token_revoked(t), 0)
}

fn test_r83_idempotent_same_value() {
    // Setting revoked=1 on an already-revoked token succeeds and
    // reports old_revoked=true / new_revoked=true (idempotent).
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-yara", "yara", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    capability_registry_revoke(admin_reg, "tk-yara")
    let out = rpc_dispatch("admin.set_revoked",
        _mk_args2("token_id", "tk-yara", "revoked", "1"), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    ce_check("old_revoked true",    _has(out, "\"old_revoked\":true"))
    ce_check("new_revoked true",    _has(out, "\"new_revoked\":true"))
    ce_eq("still revoked",          token_revoked(t), 1)
}

// ---- R84: admin.set_holder ----------------------------------------

fn test_r84_verb_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.set_holder") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.set_holder registered", saw, 1)
}

fn test_r84_cap_is_admin_sandbox() {
    ce_eq("cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("admin.set_holder"),
                       CAP_ADMIN_SANDBOX), 1)
}

fn test_r84_no_registry_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "x", "holder", "bob"), ctx)
    ce_check("names no cap registry",
             _has(out, "no capability registry in context"))
}

fn test_r84_missing_args_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out1 = rpc_dispatch("admin.set_holder",
        _mk_arg("holder", "bob"), ctx)
    ce_check("missing token_id", _has(out1, "missing arg: token_id"))
    let out2 = rpc_dispatch("admin.set_holder",
        _mk_arg("token_id", "tk-admin"), ctx)
    ce_check("missing holder",   _has(out2, "missing arg: holder"))
}

fn test_r84_empty_holder_refused() {
    // A token with an empty holder makes no sense -- ownership
    // checks would treat it as anonymous. Refuse before any state
    // change.
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "tk-admin", "holder", ""), ctx)
    ce_check("empty holder refused",
             _has(out, "holder must be non-empty"))
}

fn test_r84_unknown_token_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "never-existed", "holder", "bob"), ctx)
    ce_check("unknown refused", _has(out, "unknown token_id"))
}

fn test_r84_reader_refused_by_cap() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "tk-r", "holder", "bob"), ctx)
    ce_check("reader refused",
             _has(out, "capability required: admin:sandbox"))
}

fn test_r84_happy_path_holder_moves() {
    // ops handoff: team_a's service token rolls to team_b. Response
    // carries old_holder and new_holder; the underlying token slot
    // reflects the new holder.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-svc", "team_a", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "tk-svc", "holder", "team_b"), ctx)
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("token_id echoed",        _has(out, "\"token_id\":\"tk-svc\""))
    ce_check("old_holder team_a",      _has(out, "\"old_holder\":\"team_a\""))
    ce_check("new_holder team_b",      _has(out, "\"new_holder\":\"team_b\""))
    ce_str_eq("slot updated",          token_holder(t), "team_b")
    // Identity preserved: same token_id, still live, same caps
    // pointer (list) so downstream authorization sees the same
    // permission set under the new owner.
    ce_str_eq("id preserved",          token_id(t), "tk-svc")
    ce_eq("still live",                token_is_live(t, 100), 1)
}

fn test_r84_capability_list_reflects_new_holder() {
    // After reassignment, capability.list output shows the token
    // under new_holder, not old_holder. (The list encodes holder as
    // a JSON string; the presence of "holder":"new" and absence of
    // "holder":"old" for this fresh registry is the signal.)
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-move", "old_owner", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    // Before: list has old_owner.
    let before = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("before: old_owner present", _has(before, "\"holder\":\"old_owner\""))
    ce_check("before: new_owner absent",  _has(before, "\"holder\":\"new_owner\"") == 0)
    // Reassign.
    rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "tk-move", "holder", "new_owner"), ctx)
    let after = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("after: new_owner present",  _has(after, "\"holder\":\"new_owner\""))
    ce_check("after: old_owner absent",   _has(after, "\"holder\":\"old_owner\"") == 0)
}

fn test_r84_idempotent_same_holder() {
    // Reassigning to the current holder succeeds and reports
    // old_holder == new_holder. No-op on the underlying slot.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-same", "carla", roles, 0, 0)
    capability_registry_add(admin_reg, t)
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "tk-same", "holder", "carla"), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("old_holder carla",      _has(out, "\"old_holder\":\"carla\""))
    ce_check("new_holder carla",      _has(out, "\"new_holder\":\"carla\""))
    ce_str_eq("holder still carla",   token_holder(t), "carla")
}

fn test_r84_preserves_caps_expires_revoked_qps() {
    // The whole point of set_holder: mint the token once, hand it
    // off later without disturbing anything else. Verify by
    // stamping every mutable dimension pre-handoff and checking
    // it's still there post-handoff (via capability.list).
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    // expires_at = 5000, so we can eyeball it in the list.
    let t = capability_token_new_roles("tk-full", "team_a", roles, 0, 5000)
    capability_registry_add(admin_reg, t)
    // Add a cap, set qps, revoke: every dimension has a
    // distinctive value.
    token_add_cap(t, CAP_NL_ASK)
    token_set_qps_max(t, 42)
    token_set_revoked(t, 1)
    let caps_before = len(token_caps(t))
    // Hand off.
    let out = rpc_dispatch("admin.set_holder",
        _mk_args2("token_id", "tk-full", "holder", "team_b"), ctx)
    ce_check("handoff ok", _has(out, "\"ok\":true"))
    // Cap count, expires_at, revoked flag, qps all preserved.
    ce_eq("caps preserved",     len(token_caps(t)), caps_before)
    ce_eq("expires preserved",  token_expires_at(t), 5000)
    ce_eq("revoked preserved",  token_revoked(t), 1)
    ce_eq("qps preserved",      token_qps_max(t), 42)
    // capability.list reflects everything under the new holder.
    let listed = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("list has team_b",         _has(listed, "\"holder\":\"team_b\""))
    ce_check("list has expires 5000",   _has(listed, "\"expires_at\":5000"))
    ce_check("list has revoked true",   _has(listed, "\"revoked\":true"))
    ce_check("list has qps_max 42",     _has(listed, "\"qps_max\":42"))
}

// ---- R100 child-mode gate ordering -------------------------------------
//
// The child-mode disable table (src/factory/child_mode.nova) is
// checked BEFORE the pre-R100 cap check via capability_authorize_ex.
// When both would refuse, the child-mode message wins so an operator
// sees the correct reason -- the caller's token might legitimately
// hold the required cap; child mode is what's actually forbidding it.

fn test_r100_child_mode_beats_cap_error() {
    // enforced=1, no registry, empty token, disabled verb, child mode
    // active. Pre-R100 authorize would refuse "sandbox misconfigured"
    // or "capability required: ..."; R100 must refuse with the
    // child-mode message instead.
    let out = capability_authorize_ex(1, 1, 1, 0, "",
                                      "admin.bake_child", 100)
    ce_check("child-mode message present",
             _has(out, "child-mode runtime"))
    ce_check("no capability-required prefix",
             _has(out, "capability required") == 0)
    ce_check("no sandbox-misconfigured prefix",
             _has(out, "sandbox misconfigured") == 0)
}

fn test_r100_child_mode_beats_missing_token_error() {
    // Same as above but with a registry present. Pre-R100 authorize
    // would return "request missing 'token' field". R100 returns the
    // child-mode message.
    let reg = capability_registry_new()
    let out = capability_authorize_ex(1, 1, 1, reg, "",
                                      "ingest.file", 100)
    ce_check("child-mode wins over missing-token",
             _has(out, "child-mode runtime"))
    ce_check("verb name in message", _has(out, "ingest.file"))
}

fn test_r100_no_child_mode_delegates_to_cap() {
    // Bit clear -> old authorize surfaces. The exact error depends on
    // arguments; we just assert the child-mode message is absent.
    let out = capability_authorize_ex(0, 1, 1, 0, "tk-x",
                                      "admin.bake_child", 100)
    ce_check("child-mode message absent",
             _has(out, "child-mode runtime") == 0)
    // And some cap-layer error IS present (either misconfigured or
    // capability-required or unknown-token, depending on the fixture).
    ce_check("cap-layer error present", len(out) > 0)
}

fn test_r100_child_mode_enabled_verb_falls_through() {
    // Child mode active but verb NOT disabled -> normal cap path runs.
    // With enforced=0 the pre-R100 authorize returns "" (authorized).
    let out = capability_authorize_ex(1, 0, 0, 0, "", "nl.ask", 100)
    ce_str_eq("enforced=0 authorized", out, "")
}

