    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.grant_cap",
        _mk_arg("token_id", "tk-admin"), ctx)
    ce_check("missing cap",
             _has(out, "missing arg: cap"))
}

fn test_r82_grant_empty_cap_refused() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "tk-admin", "cap", ""), ctx)
    ce_check("empty cap refused",
