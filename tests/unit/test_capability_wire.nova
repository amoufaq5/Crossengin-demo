             _has(out, "expires_at must be >= 0"))
}

fn test_r81_unknown_token_id_refuses() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.set_expires",
        _mk_args2("token_id", "never-existed", "expires_at", "500"), ctx)
    ce_check("unknown refused",
             _has(out, "unknown token_id"))
}

fn test_r81_reader_refused_by_cap() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    let out = rpc_dispatch("admin.set_expires",
        _mk_args2("token_id", "tk-r", "expires_at", "500"), ctx)
    ce_check("reader refused",
             _has(out, "capability required: admin:sandbox"))
}

fn test_r81_set_expires_from_never_to_finite() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    // Mint a fresh reader token with expires_at=0 (never expires).
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-kate", "kate", roles, 100, 0)
    capability_registry_add(admin_reg, t)
    ce_eq("initial expires_at 0", token_expires_at(t), 0)
    let out = rpc_dispatch("admin.set_expires",
        _mk_args2("token_id", "tk-kate", "expires_at", "5000"), ctx)
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("token_id echoed",        _has(out, "\"token_id\":\"tk-kate\""))
    ce_check("holder echoed",          _has(out, "\"holder\":\"kate\""))
    ce_check("old_expires_at 0",       _has(out, "\"old_expires_at\":0"))
    ce_check("new_expires_at 5000",    _has(out, "\"new_expires_at\":5000"))
    ce_eq("token now expires at 5000", token_expires_at(t), 5000)
    // Every other slot unchanged.
    ce_str_eq("holder unchanged",      token_holder(t), "kate")
    ce_eq("not revoked",               token_revoked(t), 0)
    ce_eq("issued_at preserved",       token_issued_at(t), 100)
}

fn test_r81_set_expires_to_zero_never_expires() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    // Start with a finite expiry.
    let t = capability_token_new_roles("tk-liam", "liam", roles, 100, 1000)
    capability_registry_add(admin_reg, t)
    let out = rpc_dispatch("admin.set_expires",
        _mk_args2("token_id", "tk-liam", "expires_at", "0"), ctx)
    ce_check("ok",                    _has(out, "\"ok\":true"))
    ce_check("old_expires_at 1000",   _has(out, "\"old_expires_at\":1000"))
    ce_check("new_expires_at 0",      _has(out, "\"new_expires_at\":0"))
    ce_eq("expires_at now 0", token_expires_at(t), 0)
    // With expires_at=0 the token is live at any `now`.
    ce_eq("live at now=9999999", token_is_live(t, 9999999), 1)
}

fn test_r81_set_expires_can_expire_immediately() {
    // Operator can effectively "expire this token right now"
    // without capability.revoke by setting expires_at < now.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-maya", "maya", roles, 100, 0)
    capability_registry_add(admin_reg, t)
    ce_eq("live before at now=500", token_is_live(t, 500), 1)
    rpc_dispatch("admin.set_expires",
        _mk_args2("token_id", "tk-maya", "expires_at", "200"), ctx)
    ce_eq("expired at now=500", token_is_live(t, 500), 0)
    // But live BEFORE its expiry.
    ce_eq("still live at now=150", token_is_live(t, 150), 1)
    // Not revoked -- expiry-based only.
    ce_eq("not revoked", token_revoked(t), 0)
}

fn test_r81_set_expires_reflected_in_capability_list() {
    // End-to-end: set_expires then capability.list echoes the new
    // expires_at (R55 field, preserved through R80).
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-noel", "noel", roles, 100, 0)
    capability_registry_add(admin_reg, t)
    rpc_dispatch("admin.set_expires",
        _mk_args2("token_id", "tk-noel", "expires_at", "8888"), ctx)
    let out = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("noel present",              _has(out, "\"holder\":\"noel\""))
    ce_check("noel's new expires_at seen",
             _has(out, "\"expires_at\":8888"))
}

// ---- R82: admin.grant_cap + admin.remove_cap -----------------------

fn test_r82_verbs_registered() {
    let names = rpc_verb_names()
    let saw_g = 0
    let saw_r = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.grant_cap")  == 1 { saw_g = 1 }
        if str_eq_bytes(names[i], "admin.remove_cap") == 1 { saw_r = 1 }
        i = i + 1
    }
    ce_eq("admin.grant_cap registered",  saw_g, 1)
    ce_eq("admin.remove_cap registered", saw_r, 1)
}

fn test_r82_verbs_capped_admin_sandbox() {
    ce_eq("grant cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("admin.grant_cap"),
                       CAP_ADMIN_SANDBOX), 1)
    ce_eq("remove cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("admin.remove_cap"),
                       CAP_ADMIN_SANDBOX), 1)
}

fn test_r82_grant_no_registry_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("admin.grant_cap",
        _mk_args2("token_id", "x", "cap", "nl:ask"), ctx)
    ce_check("names no cap registry",
             _has(out, "no capability registry in context"))
}

fn test_r82_grant_missing_token_id() {
