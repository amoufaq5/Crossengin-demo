// Unit tests for the R55 capability lifecycle wire verbs
// (capability.issue / .revoke / .list, ADR-0105 §Token issuance).
//
// Covers: verb-name registration, verb-cap map declares admin:sandbox,
// missing-registry refusal, missing-arg refusal, unknown-role refusal,
// happy-path issue -> live token -> revoke, list output (holder + caps
// + expiry + revoked flag; NO token_id leakage), end-to-end
// enforcement (admin can issue; a reader token cannot).

import "../ce_test.nova"
import "../../src/sandbox/capability.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// ---- helpers -------------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    let kgreg = kg_registry_new()
    kg_spawn(kgreg, "world")
    return rpc_ctx_new(kgreg, capreg_new(), persona_registry_new(),
                        skill_registry_new(), mo_new(), 0, 0, 100)
}

fn _mk_arg(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

fn _mk_args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

fn _mk_args3(k1, v1, k2, v2, k3, v3) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    push(a, rpc_arg_kv(k3, v3))
    return a
}

fn _grant_admin(ctx) {
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "admin")
    let t = capability_token_new_roles("tk-admin", "root", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-admin")
    return reg
}

// ---- verb-name registration + cap map -----------------------------------

fn test_verbs_registered() {
    let names = rpc_verb_names()
    let has_issue = 0
    let has_revoke = 0
    let has_list = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "capability.issue")  == 1 { has_issue = 1 }
        if str_eq_bytes(names[i], "capability.revoke") == 1 { has_revoke = 1 }
        if str_eq_bytes(names[i], "capability.list")   == 1 { has_list = 1 }
        i = i + 1
    }
    ce_eq("issue registered",  has_issue,  1)
    ce_eq("revoke registered", has_revoke, 1)
    ce_eq("list registered",   has_list,   1)
}

fn test_verbs_require_admin_sandbox_cap() {
    ce_eq("issue -> admin:sandbox",
          str_eq_bytes(capability_verb_required("capability.issue"),
                       CAP_ADMIN_SANDBOX), 1)
    ce_eq("revoke -> admin:sandbox",
          str_eq_bytes(capability_verb_required("capability.revoke"),
                       CAP_ADMIN_SANDBOX), 1)
    ce_eq("list -> admin:sandbox",
          str_eq_bytes(capability_verb_required("capability.list"),
                       CAP_ADMIN_SANDBOX), 1)
}

fn test_reader_does_not_get_admin_sandbox() {
    let caps = capability_role_expand("reader")
    let i = 0
    let saw = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_SANDBOX) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("reader lacks admin:sandbox", saw, 0)
}

fn test_admin_has_admin_sandbox() {
    let caps = capability_role_expand("admin")
    let i = 0
    let saw = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_SANDBOX) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin has admin:sandbox", saw, 1)
}

// ---- capability.issue happy path ---------------------------------------

fn test_issue_ok_returns_token_id() {
    let ctx = _mk_ctx()
    let reg = _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "alice", "roles", "reader"), ctx)
    ce_check("ok",                _has(out, "\"ok\":true"))
    ce_check("has token_id",      _has(out, "\"token_id\":\""))
    ce_check("holder echoed",     _has(out, "\"holder\":\"alice\""))
    ce_check("caps in result",    _has(out, "\"caps\":["))
    ce_check("nl:ask cap",        _has(out, "\"nl:ask\""))
    ce_check("kg:read cap",       _has(out, "\"kg:read\""))
    ce_check("no skill:run",      _has(out, "\"skill:run\"") == 0)
    // Newly-added token should be findable in the registry.
    ce_check("registry grew", capability_registry_count(reg) >= 2)
}

fn test_issue_multi_role_dedupes_caps() {
    let ctx = _mk_ctx()
    let reg = _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "bob", "roles", "reader,skill_user"), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    // Both reader + skill_user carry nl:ask; the response should show
    // exactly one nl:ask entry.
    let first  = find_bytes(out, "\"nl:ask\"")
    let after  = substr(out, first + 1, len(out) - first - 1)
    let second = find_bytes(after, "\"nl:ask\"")
    ce_eq("nl:ask appears once (deduped)", second, 0 - 1)
    ce_check("skill:run present", _has(out, "\"skill:run\""))
}

fn test_issue_with_expiry() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_args3("holder", "carol", "roles", "reader",
                  "expires_at", "1500"), ctx)
    ce_check("ok",                 _has(out, "\"ok\":true"))
    ce_check("expires_at echoed",  _has(out, "\"expires_at\":1500"))
}

// ---- capability.issue refusal paths -----------------------------------

fn test_issue_missing_holder() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_arg("roles", "reader"), ctx)
    ce_check("names missing holder", _has(out, "missing arg: holder"))
}

fn test_issue_empty_holder() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "", "roles", "reader"), ctx)
    ce_check("names empty holder", _has(out, "holder must be non-empty"))
}

fn test_issue_unknown_role() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "alice", "roles", "no-such-role"), ctx)
    ce_check("names unknown role", _has(out, "unknown role: no-such-role"))
}

fn test_issue_no_registry_refuses() {
    // Enforcement OFF, no registry wired. Dispatch skips the cap gate
    // (backward-compat) but the verb still needs a registry to write to.
    let ctx = _mk_ctx()
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "alice", "roles", "reader"), ctx)
    ce_check("names missing registry",
             _has(out, "no capability registry in context"))
}

// ---- capability.revoke -------------------------------------------------

fn test_revoke_kills_liveness() {
    let ctx = _mk_ctx()
    let reg = _grant_admin(ctx)
    // Mint a fresh token, then revoke it via the wire.
    let out_issue = rpc_dispatch("capability.issue",
        _mk_args2("holder", "alice", "roles", "reader"), ctx)
    // Extract token_id from the response JSON.
    let start = find_bytes(out_issue, "\"token_id\":\"") + len("\"token_id\":\"")
    let end   = find_bytes(substr(out_issue, start, len(out_issue) - start), "\"")
    let tid   = substr(out_issue, start, end)
    // Now revoke.
    let out_rev = rpc_dispatch("capability.revoke",
        _mk_arg("token_id", tid), ctx)
    ce_check("ok",           _has(out_rev, "\"ok\":true"))
    ce_check("revoked true", _has(out_rev, "\"revoked\":true"))
    // Verify the token is dead in the registry.
    let t = capability_registry_lookup(reg, tid)
    ce_check("looked up",  t != 0)
    ce_eq("revoked bit",   token_revoked(t), 1)
}

fn test_revoke_unknown_returns_false() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.revoke",
        _mk_arg("token_id", "no-such-id"), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    ce_check("revoked false",  _has(out, "\"revoked\":false"))
}

fn test_revoke_missing_arg() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.revoke", list_new(), ctx)
    ce_check("names missing token_id", _has(out, "missing arg: token_id"))
}

// ---- capability.list ---------------------------------------------------

fn test_list_returns_entries_without_token_ids() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    rpc_dispatch("capability.issue",
        _mk_args2("holder", "alice", "roles", "reader"), ctx)
    rpc_dispatch("capability.issue",
        _mk_args2("holder", "bob", "roles", "skill_user"), ctx)
    let out = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("alice listed",    _has(out, "\"holder\":\"alice\""))
    ce_check("bob listed",      _has(out, "\"holder\":\"bob\""))
    ce_check("root (admin) listed", _has(out, "\"holder\":\"root\""))
    ce_check("caps in result",  _has(out, "\"caps\":["))
    ce_check("issued_at",       _has(out, "\"issued_at\":"))
    ce_check("expires_at",      _has(out, "\"expires_at\":"))
    ce_check("revoked",         _has(out, "\"revoked\":false"))
    // The critical audit invariant: token_ids are NEVER on the wire.
    ce_eq("no token_id leaked", _has(out, "\"token_id\""), 0)
    ce_eq("bootstrap admin id  not leaked",
          _has(out, "tk-admin"), 0)
}

fn test_list_empty_registry() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, reg, 0)     // no enforcement; empty reg
    let out = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("ok",           _has(out, "\"ok\":true"))
    ce_check("empty array",  _has(out, "\"result\":[]"))
}

fn test_list_no_registry() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("names missing registry",
             _has(out, "no capability registry in context"))
}

// ---- end-to-end enforcement --------------------------------------------

fn test_reader_cannot_issue_under_enforcement() {
    let ctx = _mk_ctx()
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-reader", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-reader")
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "eve", "roles", "admin"), ctx)
    ce_check("refused",             _has(out, "\"ok\":false"))
    ce_check("names admin:sandbox", _has(out, "capability required: admin:sandbox"))
}

fn test_admin_can_issue_under_enforcement() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("capability.issue",
        _mk_args2("holder", "eve", "roles", "reader"), ctx)
    ce_check("granted", _has(out, "\"ok\":true"))
}

// The full lifecycle: admin issues a token, uses it via the wire,
// revokes it, then the revoked token can no longer dispatch.
fn test_issued_token_works_then_revoked() {
    let ctx = _mk_ctx()
    let reg = _grant_admin(ctx)
    // Admin issues alice a reader token.
    let out_issue = rpc_dispatch("capability.issue",
        _mk_args2("holder", "alice", "roles", "reader"), ctx)
    let start = find_bytes(out_issue, "\"token_id\":\"") + len("\"token_id\":\"")
    let after = substr(out_issue, start, len(out_issue) - start)
    let end   = find_bytes(after, "\"")
    let tid   = substr(out_issue, start, end)
    // Switch to alice's token; kg.list should work (reader has kg:read).
    rpc_ctx_set_presented_token(ctx, tid)
    let out_kg1 = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("alice can kg.list", _has(out_kg1, "\"ok\":true"))
    // Admin revokes alice.
    rpc_ctx_set_presented_token(ctx, "tk-admin")
    rpc_dispatch("capability.revoke", _mk_arg("token_id", tid), ctx)
    // Alice tries again -> refused.
    rpc_ctx_set_presented_token(ctx, tid)
    let out_kg2 = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("alice denied post-revoke", _has(out_kg2, "\"ok\":false"))
    ce_check("names revoked",            _has(out_kg2, "token revoked"))
}

// ---- token id minter shape ---------------------------------------------

fn test_token_id_mint_shape() {
    let tid = capability_token_id_mint()
    ce_eq("32 hex chars", len(tid), 32)
    // Every char is 0-9 or a-f.
    let i = 0
    let all_hex = 1
    while i < len(tid) {
        let c = char_at(tid, i)
        let ok = 0
        if c >= 48 { if c <= 57  { ok = 1 } }     // 0-9
        if c >= 97 { if c <= 102 { ok = 1 } }     // a-f
        if ok == 0 { all_hex = 0 }
        i = i + 1
    }
    ce_eq("all lowercase hex", all_hex, 1)
}

// ---- R78: admin.rotate_token ------------------------------------------

fn test_r78_verb_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.rotate_token") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.rotate_token registered", saw, 1)
}

fn test_r78_cap_is_admin_sandbox() {
    ce_eq("cap is admin:sandbox",
          str_eq_bytes(capability_verb_required("admin.rotate_token"),
                       CAP_ADMIN_SANDBOX), 1)
}

fn test_r78_no_registry_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", "anything"), ctx)
    ce_check("names no cap registry",
             _has(out, "no capability registry in context"))
}

fn test_r78_missing_token_id_refuses() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)                     // admin token wired
    let out = rpc_dispatch("admin.rotate_token", list_new(), ctx)
    ce_check("missing token_id refused",
             _has(out, "missing arg: token_id"))
}

fn test_r78_unknown_token_id_refuses() {
    let ctx = _mk_ctx()
    _grant_admin(ctx)
    let out = rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", "never-existed"), ctx)
    ce_check("unknown refused",
             _has(out, "unknown token_id"))
}

fn test_r78_reader_refused_by_cap() {
    let ctx = _mk_ctx()
    // Mint a reader token first via helper; then attempt rotate under
    // reader auth -- must be blocked by the cap gate.
    let reg = capability_registry_new()
    let roles = list_new() push(roles, "reader")
    let t = capability_token_new_roles("tk-r", "alice", roles, 0, 0)
    capability_registry_add(reg, t)
    rpc_ctx_set_sandbox(ctx, reg, 1)
    rpc_ctx_set_presented_token(ctx, "tk-r")
    let out = rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", "tk-r"), ctx)
    ce_check("reader refused",
             _has(out, "capability required: admin:sandbox"))
}

fn test_r78_rotates_id_preserves_holder_and_caps() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)     // reuses the admin token bookkeeping
    // Mint a curator token to be rotated.
    let croles = list_new() push(croles, "curator")
    let ct = capability_token_new_roles("tk-carol", "carol", croles, 0, 0)
    capability_registry_add(admin_reg, ct)
    // Capture identity BEFORE rotation.
    let before_caps  = token_caps(ct)
    let before_hold  = token_holder(ct)
    let before_exp   = token_expires_at(ct)
    let before_qps   = token_qps_max(ct)
    // Rotate.
    let out = rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", "tk-carol"), ctx)
    ce_check("ok",               _has(out, "\"ok\":true"))
    ce_check("old_token_id echoed",
             _has(out, "\"old_token_id\":\"tk-carol\""))
    ce_check("holder echoed",    _has(out, "\"holder\":\"carol\""))
    ce_check("new_token_id present",
             _has(out, "\"new_token_id\":"))
    // The old id is no longer looked up; the new id is.
    ce_eq("old id unknown post-rotate",
          capability_registry_lookup(admin_reg, "tk-carol"), 0)
    // Same token record, mutated in place: holder + caps + expiry +
    // qps preserved (pointer-identical to the pre-rotate list).
    ce_str_eq("holder unchanged", token_holder(ct), before_hold)
    ce_eq("caps unchanged (same list)",
          len(token_caps(ct)), len(before_caps))
    ce_eq("expires_at unchanged", token_expires_at(ct), before_exp)
    ce_eq("qps_max unchanged",    token_qps_max(ct), before_qps)
    ce_eq("not revoked",          token_revoked(ct), 0)
}

fn test_r78_new_id_looks_up_the_same_token() {
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let croles = list_new() push(croles, "skill_user")
    let ct = capability_token_new_roles("tk-old", "dave", croles, 0, 0)
    capability_registry_add(admin_reg, ct)
    // Rotate.
    rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", "tk-old"), ctx)
    // We can't parse the JSON to extract the new id in NOVA easily,
    // so re-derive: after rotation, ct's TOK_ID should be a fresh
    // 32-hex-char string, and looking it up should return ct.
    let new_id = token_id(ct)
    ce_check("new id is 32 hex chars", len(new_id) == 32)
    ce_check("new id lookup returns same record",
             capability_registry_lookup(admin_reg, new_id) == ct)
    // The rotated token stays live (no revoke).
    ce_eq("still live", token_is_live(ct, 100), 1)
}

fn test_r78_rotate_is_idempotent_by_holder_but_not_by_id() {
    // Rotate twice: first with the initial id, then with the new id.
    // Both should succeed; the record's TOK_ID slot changes each time.
    let ctx = _mk_ctx()
    let admin_reg = _grant_admin(ctx)
    let croles = list_new() push(croles, "reader")
    let ct = capability_token_new_roles("tk-eve", "eve", croles, 0, 0)
    capability_registry_add(admin_reg, ct)
    rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", "tk-eve"), ctx)
    let after_first = token_id(ct)
    let out2 = rpc_dispatch("admin.rotate_token",
        _mk_arg("token_id", after_first), ctx)
    ce_check("second rotate ok",  _has(out2, "\"ok\":true"))
    // Second call reports old_token_id = after_first.
    ce_check("second call names first-rotated id as old",
             _has(out2, "\"old_token_id\":\"" + after_first + "\""))
    // A THIRD lookup with the original tk-eve id is still unknown.
    ce_eq("original id still unknown",
          capability_registry_lookup(admin_reg, "tk-eve"), 0)
}

