    // R100: child-mode gate ordering.
    test_r100_child_mode_beats_cap_error()
    test_r100_child_mode_beats_missing_token_error()
    test_r100_no_child_mode_delegates_to_cap()
    test_r100_child_mode_enabled_verb_falls_through()
    ce_summary("capability_wire")
}

main()
