// Unit tests for src/nl/executor.nova (ADR-0104 R48p3).
//
// Verifies the executor dispatches every kind correctly AND preserves
// the 5 ADR-0103 guarantees end-to-end when the dispatch reaches
// skill_run.

import "../ce_test.nova"
import "../../src/nl/executor.nova"
import "../../src/nl/grammar_parser.nova"
// capsule_registry is pulled in transitively via executor -> skill_supervisor
// -> capsule_registry. Direct re-import triggers a NOVA module-init quirk
// in this specific diamond graph (same class as R47p5's coding_helper test);
// capreg_new + capreg_register are visible via the transitive chain.

fn _seed_kg(kgreg, kg_name, labels, alphas) {
    let kg = kg_spawn(kgreg, kg_name)
    let i = 0
    while i < len(labels) {
        let a = kg_add_atom(kg, ATOM_FACT, labels[i], 0)
        let b = atom_belief(a)
        list_set(b, 0, alphas[i])
        list_set(b, 1, 5000 - alphas[i])
        i = i + 1
    }
    return kg
}

// ---- guard clauses --------------------------------------------------------

fn test_null_query_refuses() {
    let r = nl_execute(0, 0, 0, 0, 0, 0, "u", 0)
    ce_eq("refused", nl_er_ok(r), 0)
    ce_check("reason present", len(nl_er_refusal_reason(r)) > 0)
}

fn test_none_kind_passes_through() {
    let q = sq_none("", "grammar")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 0)
    // NONE isn't an error -- caller can decide whether to prompt.
    ce_eq("ok", nl_er_ok(r), 1)
    ce_check("no proposal", nl_er_proposal_result(r) == 0)
    ce_check("no admin action", len(nl_er_admin_action(r)) == 0)
}

fn test_unparsed_refuses_pending_llm() {
    let q = sq_unparsed("floof floof glorpity")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 0)
    ce_eq("refused (LLM path)", nl_er_ok(r), 0)
    // Reason mentions LLM fallback.
    let reason = nl_er_refusal_reason(r)
    let saw_llm = 0
    let n = len(reason)
    let target = "LLM"
    let tn = len(target)
    let i = 0
    while i <= n - tn {
        let ok = 1
        let j = 0
        while j < tn {
            if char_at(reason, i + j) != char_at(target, j) { ok = 0 j = tn }
            else { j = j + 1 }
        }
        if ok == 1 { saw_llm = 1 i = n }
        i = i + 1
    }
    ce_eq("reason names LLM fallback", saw_llm, 1)
}

fn test_invalid_query_refuses() {
    // Manually build a broken query -- unknown kind.
    let q = sq_new(999, "raw", "grammar")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 0)
    ce_eq("refused", nl_er_ok(r), 0)
}

// ---- skill dispatch: RESEARCH ---------------------------------------------

fn test_research_dispatches_to_skill_run() {
    let kgreg = kg_registry_new()
    let mo = mo_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let labels = list_new() push(labels, "einstein")
    let alphas = list_new() push(alphas, 4500)
    _seed_kg(kgreg, "history", labels, alphas)
    let q = grammar_parse("what is einstein")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo, "u", 100)
    ce_eq("executor ok", nl_er_ok(r), 1)
    let pr = nl_er_proposal_result(r)
    ce_check("proposal_result attached", pr != 0)
    ce_eq("skill_run returned ok", skill_pr_ok(pr), 1)
    ce_check("at least 1 atom matched", len(skill_pr_atoms(pr)) >= 1)
    // parser_used echoes through.
    ce_str_eq("parser grammar", nl_er_parser_used(r), "grammar")
    // Templater has not run yet -- templated_answer is empty.
    ce_eq("templated answer empty (R48p4 fills)",
          nl_er_templated_answer(r), "")
}

fn test_research_auto_installs_skill() {
    // The skill registry starts empty. Executor must auto-register +
    // install the research skill on demand.
    let kgreg = kg_registry_new()
    let mo = mo_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    ce_eq("research not registered pre-execute", skill_registry_is_installed(skill_reg, "research"), 0)
    let q = grammar_parse("tell me about photosynthesis")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_eq("research auto-installed", skill_registry_is_installed(skill_reg, "research"), 1)
}

fn test_research_refuses_without_kg_registry() {
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let q = grammar_parse("what is einstein")
    let r = nl_execute(q, 0, capreg, 0, skill_reg, mo_new(), "u", 100)
    ce_eq("refused", nl_er_ok(r), 0)
    ce_check("reason mentions KG registry", len(nl_er_refusal_reason(r)) > 0)
}

fn test_research_refuses_without_skill_registry() {
    let kgreg = kg_registry_new()
    let q = grammar_parse("what is einstein")
    let r = nl_execute(q, kgreg, 0, 0, 0, mo_new(), "u", 100)
    ce_eq("refused", nl_er_ok(r), 0)
}

// ---- skill dispatch: RELATE / CONTRADICT / IS_A --------------------------

fn test_relate_dispatches_via_research() {
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let labs = list_new() push(labs, "mitochondria") push(labs, "cell")
    let alphas = list_new() push(alphas, 4500) push(alphas, 4500)
    _seed_kg(kgreg, "biology", labs, alphas)
    let q = grammar_parse("does mitochondria relate to cell")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo_new(), "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    let pr = nl_er_proposal_result(r)
    // Research walks for combined topic "mitochondria cell"; both match.
    ce_check("both atoms found", len(skill_pr_atoms(pr)) >= 2)
}

fn test_contradict_dispatches_via_research() {
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    // Same-labeled atom in two KGs with opposing belief.
    let labs1 = list_new() push(labs1, "sun")
    let a1 = list_new() push(a1, 4750)
    _seed_kg(kgreg, "science", labs1, a1)
    let labs2 = list_new() push(labs2, "sun")
    let a2 = list_new() push(a2, 500)
    _seed_kg(kgreg, "folk", labs2, a2)
    let q = grammar_parse("does science contradict folk")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo_new(), "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    // Research skill surfaces the sun conflict; proposal string
    // includes "conflicts" wording (verified in test_research_skill).
    let pr = nl_er_proposal_result(r)
    ce_check("proposal non-empty", len(skill_pr_proposal(pr)) > 0)
}

fn test_is_a_dispatches_via_research() {
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let labs = list_new() push(labs, "earth") push(labs, "planet")
    let alphas = list_new() push(alphas, 4500) push(alphas, 4500)
    _seed_kg(kgreg, "astronomy", labs, alphas)
    let q = grammar_parse("is earth a planet")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo_new(), "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    let pr = nl_er_proposal_result(r)
    ce_check("both atoms matched", len(skill_pr_atoms(pr)) >= 2)
}

// ---- admin delegation -----------------------------------------------------

fn test_retract_delegates_to_admin() {
    let q = grammar_parse("retract bad_claim")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_str_eq("admin action", nl_er_admin_action(r), "retract")
    let args = nl_er_admin_args(r)
    ce_eq("1 arg", len(args), 1)
    ce_str_eq("arg is label", args[0], "bad_claim")
    ce_eq("no proposal", nl_er_proposal_result(r), 0)
}

fn test_capsule_install_delegates_to_admin() {
    let q = grammar_parse("install capsule medicine")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_str_eq("admin action", nl_er_admin_action(r), "capsule_install")
    ce_str_eq("name arg", nl_er_admin_args(r)[0], "medicine")
}

fn test_skill_install_delegates_to_admin() {
    let q = grammar_parse("install skill coding_helper")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_str_eq("admin action", nl_er_admin_action(r), "skill_install")
    ce_str_eq("name arg", nl_er_admin_args(r)[0], "coding_helper")
}

fn test_capsule_list_delegates() {
    let q = grammar_parse("list capsules")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_str_eq("admin action", nl_er_admin_action(r), "capsule_list")
    ce_eq("no args", len(nl_er_admin_args(r)), 0)
}

fn test_skill_list_delegates() {
    let q = grammar_parse("list skills")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_str_eq("admin action", nl_er_admin_action(r), "skill_list")
}

fn test_skill_run_delegates() {
    let q = grammar_parse("run skill echo on moon")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    ce_str_eq("admin action", nl_er_admin_action(r), "skill_run")
    let args = nl_er_admin_args(r)
    ce_eq("2 args", len(args), 2)
    ce_str_eq("skill", args[0], "echo")
    ce_str_eq("arg", args[1], "moon")
}

// ---- ADR-0103 guarantees end-to-end through the executor -----------------

fn test_persona_projection_attached_when_persona_present() {
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let persona_reg = persona_registry_new()
    persona_registry_ensure(persona_reg, "alice", 100)
    let labs = list_new() push(labs, "einstein")
    let a = list_new() push(a, 4500)
    _seed_kg(kgreg, "history", labs, a)
    let q = grammar_parse("what is einstein")
    let r = nl_execute(q, kgreg, capreg, persona_reg, skill_reg,
                       mo_new(), "alice", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    let pr = nl_er_proposal_result(r)
    // Guarantee 2: projection attached (persona present).
    ce_check("projection attached", skill_pr_projection(pr) != 0)
}

fn test_persona_projection_absent_when_persona_missing() {
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let labs = list_new() push(labs, "einstein")
    let a = list_new() push(a, 4500)
    _seed_kg(kgreg, "history", labs, a)
    let q = grammar_parse("what is einstein")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo_new(), "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    let pr = nl_er_proposal_result(r)
    // No persona attached (persona_reg was 0).
    ce_eq("no projection", skill_pr_projection(pr), 0)
}

fn test_persona_read_only_across_executor() {
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let persona_reg = persona_registry_new()
    let p = persona_registry_ensure(persona_reg, "alice", 100)
    persona_add_preference(p, "concise", 800, "src:user:alice", 110)
    let labs = list_new() push(labs, "einstein")
    let a = list_new() push(a, 4500)
    _seed_kg(kgreg, "history", labs, a)
    let q = grammar_parse("what is einstein")
    nl_execute(q, kgreg, capreg, persona_reg, skill_reg,
               mo_new(), "alice", 100)
    // Guarantee 5: persona unchanged (no history appended, no prefs bumped).
    ce_eq("history still 0", persona_history_count(p), 0)
    ce_eq("prefs count still 1", persona_preferences_count(p), 1)
    let pr = persona_find_preference(p, "concise")
    ce_eq("pref weight unchanged", pr[PER_PREF_WEIGHT], 800)
}

fn test_effector_calls_described_not_executed() {
    // Guarantee 3: through the executor, the result carries described
    // effector_calls but the runtime dispatches none. echo/research
    // skills declare no effectors so the list is empty -- test asserts
    // that the FIELD exists and is a list (not a dispatched call).
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let q = grammar_parse("what is anything")
    let r = nl_execute(q, kgreg, capreg, 0, skill_reg, mo_new(), "u", 100)
    ce_eq("ok", nl_er_ok(r), 1)
    let pr = nl_er_proposal_result(r)
    // Effector list exists (may be empty).
    ce_check("effector_calls is a list",
             len(skill_pr_effector_calls(pr)) >= 0)
}

fn test_meta_observer_attribution_flows() {
    // Guarantee 4: skill_run attributes touched atoms under
    // src:skill:research:v1.0.0. Verifying that survives the executor.
    let kgreg = kg_registry_new()
    let capreg = capreg_new()
    let skill_reg = skill_registry_new()
    let mo = mo_new()
    let labs = list_new() push(labs, "einstein")
    let a = list_new() push(a, 4500)
    _seed_kg(kgreg, "history", labs, a)
    let q = grammar_parse("what is einstein")
    nl_execute(q, kgreg, capreg, 0, skill_reg, mo, "u", 100)
    let report = mo_report(mo)
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:skill:research:v1.0.0") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("research skill attribution flowed", saw, 1)
}

// ---- templated_answer slot exists but empty (R48p4 fills it) -------------

fn test_templated_answer_empty_by_default() {
    let q = sq_none("", "grammar")
    let r = nl_execute(q, 0, 0, 0, 0, 0, "u", 0)
    ce_eq("templated empty", nl_er_templated_answer(r), "")
    // Templater will set it later.
    nl_er_set_templated_answer(r, "Hi!")
    ce_eq("templater setter works", nl_er_templated_answer(r), "Hi!")
}

fn main() {
    test_null_query_refuses()
    test_none_kind_passes_through()
    test_unparsed_refuses_pending_llm()
    test_invalid_query_refuses()
    test_research_dispatches_to_skill_run()
    test_research_auto_installs_skill()
    test_research_refuses_without_kg_registry()
    test_research_refuses_without_skill_registry()
    test_relate_dispatches_via_research()
    test_contradict_dispatches_via_research()
    test_is_a_dispatches_via_research()
    test_retract_delegates_to_admin()
    test_capsule_install_delegates_to_admin()
    test_skill_install_delegates_to_admin()
    test_capsule_list_delegates()
    test_skill_list_delegates()
    test_skill_run_delegates()
    test_persona_projection_attached_when_persona_present()
    test_persona_projection_absent_when_persona_missing()
    test_persona_read_only_across_executor()
    test_effector_calls_described_not_executed()
    test_meta_observer_attribution_flows()
    test_templated_answer_empty_by_default()
    ce_summary("nl_executor")
}

main()
