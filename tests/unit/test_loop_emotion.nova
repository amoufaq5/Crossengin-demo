// Unit tests for src/agent/loop_emotion.nova
// Verifies the emotion loop appraises + conditions + writes mood to ctx/soul.
// ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_emotion.nova"

fn test_emotion() {
    let sl = soul_new("A")
    let ctx = ctx_new()
    // Desirable outcome -> positive valence written to ctx and soul.
    let v = loop_emotion_step(ctx, sl, 800, 0, 0)
    ce_check("positive mood", ctx_valence(ctx) > 500)
    ce_eq("soul mood synced", soul_mood_valence(sl), v)
    // High neuroticism makes a bad outcome more negative.
    let sl2 = soul_new("B")
    soul_set_ocean(sl2, 500, 500, 500, 500, 1000)
    let ctx2 = ctx_new()
    loop_emotion_step(ctx2, sl2, -600, 0, 0)
    ce_check("neurotic negative", ctx_valence(ctx2) < 400)
}

fn main() { test_emotion() ce_summary("loop_emotion") }
main()
