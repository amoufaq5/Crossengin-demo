// Unit tests for src/ingest/importers/wikidata.nova.

import "../ce_test.nova"
import "../../src/ingest/importers/wikidata.nova"

fn test_labels_table_lookup() {
    let t = wd_labels_new()
    wd_labels_add(t, "Q1", "universe")
    wd_labels_add(t, "P31", "instance-of")
    ce_eq("Q1 -> universe", wd_labels_lookup(t, "Q1"), "universe")
    ce_eq("P31 -> instance-of", wd_labels_lookup(t, "P31"), "instance-of")
    ce_eq("miss returns empty", wd_labels_lookup(t, "P999"), "")
}

fn test_labels_parse_text() {
    let text = "Q1\tuniverse\nQ2\tlife\n# comment\nQ3\tearth\n"
    let t = wd_labels_parse_text(text)
    ce_eq("Q1", wd_labels_lookup(t, "Q1"), "universe")
    ce_eq("Q2", wd_labels_lookup(t, "Q2"), "life")
    ce_eq("Q3", wd_labels_lookup(t, "Q3"), "earth")
    ce_eq("miss", wd_labels_lookup(t, "Qxx"), "")
}

fn test_formal_pred_set() {
    let s = wd_default_formal_preds()
    ce_eq("P31 formal", wd_is_formal_pred(s, "P31"), 1)
    ce_eq("P279 formal", wd_is_formal_pred(s, "P279"), 1)
    ce_eq("P17 formal", wd_is_formal_pred(s, "P17"), 1)
    ce_eq("P400 not formal by default", wd_is_formal_pred(s, "P400"), 0)
    wd_promote_predicate(s, "P400")
    ce_eq("P400 now formal", wd_is_formal_pred(s, "P400"), 1)
    // idempotent
    wd_promote_predicate(s, "P400")
    ce_eq("still formal", wd_is_formal_pred(s, "P400"), 1)
}

fn test_display_prefers_label() {
    let t = wd_labels_new()
    wd_labels_add(t, "Q1", "universe")
    ce_eq("labeled", wd_display(t, "Q1"), "universe")
    ce_eq("unlabeled falls back", wd_display(t, "Q999"), "Q999")
}

fn test_parse_simple_wikidata() {
    let labels = wd_labels_new()
    wd_labels_add(labels, "Q146", "cat")
    wd_labels_add(labels, "Q144", "dog")
    wd_labels_add(labels, "Q729", "animal")
    wd_labels_add(labels, "P31", "instance-of")
    let text = "<http://www.wikidata.org/entity/Q146> <http://www.wikidata.org/prop/direct/P31> <http://www.wikidata.org/entity/Q729> .\n"
             + "<http://www.wikidata.org/entity/Q144> <http://www.wikidata.org/prop/direct/P31> <http://www.wikidata.org/entity/Q729> .\n"
    let r = wd_parse_text(text, "biology", "src:wikidata:demo",
                          labels, wd_default_formal_preds())
    let rec = wd_records(r)[0]
    ce_eq("3 atoms (cat, animal, dog)", len(cur_atoms(rec)), 3)
    ce_eq("2 imps", len(cur_imps(rec)), 2)
    // P31 is FORMAL by default -> both implications FORMAL.
    ce_eq("first imp FORMAL", cur_imps(rec)[0][CUR_IMP_STR], "FORMAL")
    ce_eq("second imp FORMAL", cur_imps(rec)[1][CUR_IMP_STR], "FORMAL")
}

fn test_unlabeled_falls_back_to_bare_id() {
    let labels = wd_labels_new()
    let text = "<http://www.wikidata.org/entity/Q7654> <http://www.wikidata.org/prop/direct/P400> <http://www.wikidata.org/entity/Q9999> .\n"
    let r = wd_parse_text(text, "k", "src:wikidata:test",
                          labels, wd_default_formal_preds())
    let rec = wd_records(r)[0]
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("Q7654 as label", cur_atoms(rec)[0][CUR_ATOM_LABEL], "Q7654")
    // Non-formal predicate P400 -> EMPIRICAL
    ce_eq("EMPIRICAL default", cur_imps(rec)[0][CUR_IMP_STR], "EMPIRICAL")
}

fn test_literal_object_produces_fact() {
    let labels = wd_labels_new()
    wd_labels_add(labels, "Q1", "universe")
    let text = "<http://www.wikidata.org/entity/Q1> <http://www.wikidata.org/prop/direct/P1082> \"1000000\" .\n"
    let r = wd_parse_text(text, "k", "src:wikidata:test",
                          labels, wd_default_formal_preds())
    let rec = wd_records(r)[0]
    // atoms: universe, universe-P1082 (fact)
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_check("last atom is fact-shaped label", str_eq_bytes(cur_atoms(rec)[1][CUR_ATOM_LABEL], "universe-P1082") == 1)
}

fn main() {
    test_labels_table_lookup()
    test_labels_parse_text()
    test_formal_pred_set()
    test_display_prefers_label()
    test_parse_simple_wikidata()
    test_unlabeled_falls_back_to_bare_id()
    test_literal_object_produces_fact()
    ce_summary("ingest_wikidata")
}

main()
