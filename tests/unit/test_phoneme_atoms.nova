// Unit tests for src/language/phoneme_atoms.nova
// Verifies phoneme creation (case-preserving), lookup, intern idempotency, and
// recording a word's pronunciation. ADR-0015.

import "../ce_test.nova"
import "../../src/language/phoneme_atoms.nova"

fn symlist(items) {
    let l = list_new()
    let i = 0
    while i < len(items) { push(l, items[i]); i = i + 1 }
    return l
}

fn test_phoneme_basics() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let p = phoneme_atom_new(lang, "AE", 0)
    ce_str_eq("symbol case preserved", phoneme_symbol(p), "AE")
    ce_eq("is phoneme", is_phoneme_atom(p), 1)
    ce_eq("ltype LPHONEME", lang_type(p), LPHONEME)
    ce_check("find phoneme", phoneme_find(lang, "AE") != 0)
    ce_eq("missing phoneme -> 0", phoneme_find(lang, "ZZ"), 0)
    let p2 = phoneme_intern(lang, "AE", 0)
    ce_eq("intern idempotent", atom_id(p2), atom_id(p))
    ce_eq("no duplicate", kg_atom_count(lang), 1)
    // A word is not a phoneme.
    ce_eq("word is not phoneme", is_phoneme_atom(word_atom_new(lang, "cat", 0)), 0)
}

fn test_word_pronunciation() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let w = word_atom_new(lang, "asp", 0)
    ce_eq("no phonemes initially", len(word_phonemes(w)), 0)
    word_set_phonemes(lang, w, symlist(["AE", "S", "P"]), 0)
    ce_eq("three phonemes recorded", len(word_phonemes(w)), 3)
    // Phonemes were interned as atoms in the language KG (word + 3 phonemes).
    ce_eq("phonemes interned", kg_atom_count(lang), 4)
    // Re-recording reuses interned phonemes (no duplicates).
    word_set_phonemes(lang, w, symlist(["AE", "S"]), 0)
    ce_eq("no phoneme duplication", kg_atom_count(lang), 4)
}

fn main() {
    test_phoneme_basics()
    test_word_pronunciation()
    ce_summary("phoneme_atoms")
}

main()
