// PR 4e (audit F-17): TLS certificate verification is on by default.
//   - CE_TLS_STRICT parsing: only "0" turns verification off;
//   - trust store order: $CE_TLS_CA_BUNDLE (fail closed when set but
//     unusable -- it used to fall back to the built-in pins), else the
//     system bundle, else the pins.
// NOVA has no setenv, so the pure helpers are tested with fixture files.

import "../ce_test.nova"
import "../../src/io/transducers/tls13_client.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

let ROOT_B64 = ""

fn _ts_write(path, text) {
    sys_unlink(path)
    let fd = sys_open(path, 577, 384)
    let n = len(text)
    let b = alloc(n + 1)
    let i = 0
    while i < n { store8(b + i, char_at(text, i)) i = i + 1 }
    sys_write(fd, b, n)
    sys_close(fd)
    return path
}

fn test_strict_parsing() {
    ce_eq("unset: verify", _tls_strict_from(0), 1)
    ce_eq("empty: verify", _tls_strict_from(""), 1)
    ce_eq("\"1\": verify", _tls_strict_from("1"), 1)
    ce_eq("\"false\": verify (only \"0\" opts out)", _tls_strict_from("false"), 1)
    ce_eq("\"0\": off", _tls_strict_from("0"), 0)
}

fn test_trust_store_order() {
    let base = "/tmp/ce_test_tls_store_" + int_to_str(getpid())
    let good = _ts_write(base + "_good.pem", "-----BEGIN CERTIFICATE-----\n" + ROOT_B64 + "\n-----END CERTIFICATE-----\n")
    let junk = _ts_write(base + "_junk.pem", "not a certificate\n")
    let missing = base + "_missing.pem"
    ce_eq("CE_TLS_CA_BUNDLE wins", len(_tls_anchors_from(good, missing)), 1)
    ce_eq("CE_TLS_CA_BUNDLE missing: fail closed (no pins)", len(_tls_anchors_from(missing, good)), 0)
    ce_eq("CE_TLS_CA_BUNDLE unusable: fail closed", len(_tls_anchors_from(junk, good)), 0)
    ce_eq("unset: the system bundle", len(_tls_anchors_from(0, good)), 1)
    ce_eq("empty: the system bundle", len(_tls_anchors_from("", good)), 1)
    let pins = _tls_anchors_from(0, missing)
    ce_eq("no bundle anywhere: the two gateway pins", len(pins), 2)
    ce_eq("pins are key-only RSA anchors", len(pins[0]), 3)
    ce_check("bundle anchors carry the root cert (issued-by paths)", len(_tls_anchors_from(good, missing)[0]) > 3)
    sys_unlink(good)
    sys_unlink(junk)
}

fn main() {
    test_strict_parsing()
    test_trust_store_order()
    ce_summary("tls_strict_default")
}

main()
