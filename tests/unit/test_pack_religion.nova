// End-to-end test: ingest data/packs/religion.cerec.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn test_religion_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec", "data/packs/religion.cerec",
                          "religion", "src:pack:religion:v1", "", 0)
    ce_eq("1 record", ing_sum_ok(s), 1)
    ce_eq("58 atoms added", ing_sum_atoms(s), 58)
    ce_eq("0 parse errors", ing_sum_errors(s), 0)
    ce_eq("0 queued (trusted src:pack:)", ing_sum_queued(s), 0)
}

fn test_headline_traditions_present() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/religion.cerec",
                  "religion", "src:pack:religion:v1", "", 0)
    let kgreg = ing_kgreg(a)
    let n = kg_count(kgreg)
    let rkg = 0
    let i = 0
    while i < n {
        let k = kg_get(kgreg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "religion") == 1 { rkg = k } }
        i = i + 1
    }
    ce_check("religion KG exists", rkg != 0)
    // Spot-check the five largest traditions + one sub-family + one text.
    ce_check("christianity present", kg_find_atom(rkg, "christianity") != 0)
    ce_check("islam present",        kg_find_atom(rkg, "islam") != 0)
    ce_check("hinduism present",     kg_find_atom(rkg, "hinduism") != 0)
    ce_check("buddhism present",     kg_find_atom(rkg, "buddhism") != 0)
    ce_check("judaism present",      kg_find_atom(rkg, "judaism") != 0)
    ce_check("abrahamic_tradition sub-family present",
             kg_find_atom(rkg, "abrahamic_tradition") != 0)
    ce_check("bible present", kg_find_atom(rkg, "bible") != 0)
}

fn test_religion_agrees_with_world_history_on_person() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/religion.cerec",
                  "religion", "src:pack:religion:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/world_history.cerec",
                  "history", "src:pack:world_history:v1", "", 0)
    // Both packs list "person" at belief 950. The cross-KG scan should
    // NOT surface a religion<->history conflict on this label at any
    // reasonable spread threshold.
    let conflicts = mkgc_scan_conflicts(ing_kgreg(a), 100)
    let saw_relhist_person_conflict = 0
    let i = 0
    while i < len(conflicts) {
        let c = conflicts[i]
        if str_eq_bytes(mkgc_conflict_label(c), "person") == 1 {
            let ka = mkgc_conflict_kg_a(c)
            let kb = mkgc_conflict_kg_b(c)
            let touches_rel = 0
            let touches_hist = 0
            if str_eq_bytes(ka, "religion") == 1 { touches_rel = 1 }
            if str_eq_bytes(kb, "religion") == 1 { touches_rel = 1 }
            if str_eq_bytes(ka, "history") == 1 { touches_hist = 1 }
            if str_eq_bytes(kb, "history") == 1 { touches_hist = 1 }
            if touches_rel == 1 { if touches_hist == 1 {
                saw_relhist_person_conflict = 1
            } }
        }
        i = i + 1
    }
    ce_eq("religion + history agree on 'person'", saw_relhist_person_conflict, 0)
}

fn test_source_attribution() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/religion.cerec",
                  "religion", "src:pack:religion:v1", "", 0)
    let report = mo_report(ing_mo(a))
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:religion:v1") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("religion pack source attributed via meta-observer", saw, 1)
}

fn main() {
    test_religion_ingests_cleanly()
    test_headline_traditions_present()
    test_religion_agrees_with_world_history_on_person()
    test_source_attribution()
    ce_summary("pack_religion")
}

main()
