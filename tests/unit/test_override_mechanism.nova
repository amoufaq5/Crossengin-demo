// Unit tests for src/safety/override_mechanism.nova
// Verifies the four graded overrides (ADR-0044): belief edit (+pin), goal veto
// (subtree prune + standing regen-block), hard stop/resume, and kill switch
// (clean snapshots+logs, panic skips). All non-panic overrides are logged.

import "../ce_test.nova"
import "../../src/safety/override_mechanism.nova"

// 1. Belief edit: privileged alpha/beta write moves the posterior; pin sticks;
//    a correction entry is logged and the chain stays intact.
fn test_belief_edit() {
    let log = audit_open()
    let a = atom_new(0, 0, ATOM_FACT, "sky_is_green", 0)
    ce_eq("prior mean 500", atom_confidence(a), 500)
    let m = override_belief_edit(log, a, 9000, 1000, 1, 5)
    ce_eq("edited mean 900", m, 900)
    ce_eq("pinned", override_belief_is_pinned(a), 1)
    ce_eq("correction logged", dl_count(log), 1)
    ce_eq("correction kind", dl_kind(dl_get(log, 0)), DLK_CORRECTION)
    ce_eq("chain ok", dl_verify(log), 1)

    let b = atom_new(0, 1, ATOM_FACT, "loose", 0)
    override_belief_edit(log, b, 1000, 9000, 0, 6)
    ce_eq("low mean 100", atom_confidence(b), 100)
    ce_eq("not pinned", override_belief_is_pinned(b), 0)
}

// 2. Goal veto: a standing veto marks the whole sub-tree VETOED, blocks
//    regeneration by name, and logs an override.
fn test_goal_veto() {
    let log = audit_open()
    let eng = goal_engine_new()
    let root = goal_new(eng, "spam everyone", 800, 0, 0, 0)
    let kid = goal_new(eng, "collect addresses", 500, 0, 0, 0)
    let grand = goal_new(eng, "scrape contacts", 400, 0, 0, 0)
    goal_add_subgoal(eng, root, kid)
    goal_add_subgoal(eng, kid, grand)
    let reg = veto_registry_new()

    override_goal_veto(log, eng, reg, root, 1, 7)
    ce_eq("root vetoed", goal_status(eng, root), GOAL_VETOED)
    ce_eq("child vetoed", goal_status(eng, kid), GOAL_VETOED)
    ce_eq("grandchild vetoed", goal_status(eng, grand), GOAL_VETOED)
    ce_eq("standing blocks regen", override_name_vetoed(reg, "spam everyone"), 1)
    ce_eq("other name allowed", override_name_vetoed(reg, "help user"), 0)
    ce_eq("override logged", dl_kind(dl_get(log, 0)), DLK_OVERRIDE)

    // A one-shot veto does not register a standing block.
    let reg2 = veto_registry_new()
    let g2 = goal_new(eng, "once", 100, 0, 0, 0)
    override_goal_veto(log, eng, reg2, g2, 0, 8)
    ce_eq("oneshot vetoed", goal_status(eng, g2), GOAL_VETOED)
    ce_eq("oneshot not standing", override_name_vetoed(reg2, "once"), 0)
}

// 3. Hard stop freezes execution; resume lifts it. Logged.
fn test_hard_stop() {
    let log = audit_open()
    let ss = safety_state_new()
    ce_eq("not halted initially", safety_is_halted(ss), 0)
    override_hard_stop(log, ss, 9)
    ce_eq("halted", safety_is_halted(ss), 1)
    ce_eq("hard stop logged", dl_count(log), 1)
    override_resume(ss)
    ce_eq("resumed", safety_is_halted(ss), 0)
}

// 4. Kill: clean kill requests a snapshot and is logged; panic kill skips both.
fn test_kill() {
    let log = audit_open()
    let ss = safety_state_new()
    let snap = override_kill(log, ss, 0, 10)
    ce_eq("clean requests snapshot", snap, 1)
    ce_eq("killed", safety_is_killed(ss), 1)
    ce_eq("clean not panic", safety_kill_was_panic(ss), 0)
    ce_eq("clean kill logged", dl_count(log), 1)

    let log2 = audit_open()
    let ss2 = safety_state_new()
    let snap2 = override_kill(log2, ss2, 1, 11)
    ce_eq("panic skips snapshot", snap2, 0)
    ce_eq("panic was panic", safety_kill_was_panic(ss2), 1)
    ce_eq("panic kill not logged", dl_count(log2), 0)
}

fn main() {
    test_belief_edit()
    test_goal_veto()
    test_hard_stop()
    test_kill()
    ce_summary("override_mechanism")
}
main()
