// Unit tests for src/io/transducers/image_harris.nova (P3.3).
//
// Hermetic coverage of the Harris corner detector + the per-image
// aggregate helpers (count classification, spatial-distribution labels).
// All fixtures are built in-memory (alloc + store8) so the suite never
// depends on an on-disk image.
//
// Assertion targets (~15):
//   * harris_apply on a flat 16x16 field returns zero corners.
//   * harris_apply on a "single corner" fixture (a black square in a
//     white field) detects at least one corner near the square's
//     boundary.
//   * harris_apply on a vertical edge (no corners, just an edge) returns
//     ZERO or very few corners (Harris suppresses edges).
//   * harris_apply on a 4-corner fixture (small black square in a white
//     field) detects multiple corners.
//   * harris_corner_count_label buckets: 0 -> low; 5 -> mid; 100 -> high.
//   * harris_density_labels returns top label when most corners are in
//     the top half; right label when most are on the right.
//   * Dimension cap rejects oversized fixtures without crashing.
//   * Result-tuple accessors round-trip.

import "../ce_test.nova"
import "../../src/io/transducers/image_harris.nova"

// ---- fixture builders -----------------------------------------------------

fn _flat_fixture(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// Black square at (sx, sy) of side `sz` in a white field. The square's
// 4 corners are the Harris response targets.
fn _black_square_fixture(width, height, sx, sy, sz) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, 255)
        i = i + 1
    }
    let y = sy
    while y < sy + sz {
        if y >= 0 {
            if y < height {
                let row_off = y * width
                let x = sx
                while x < sx + sz {
                    if x >= 0 {
                        if x < width {
                            store8(buf + row_off + x, 0)
                        }
                    }
                    x = x + 1
                }
            }
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Vertical edge: left half value `low`, right half value `high`.
fn _vertical_edge_fixture(width, height, low, high) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = width / 2
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = low
            if x >= half { v = high }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// ---- happy path -----------------------------------------------------------

fn test_flat_field_no_corners() {
    let buf = _flat_fixture(16, 16, 128)
    let r = harris_apply(buf, 16, 16)
    let corners = harris_result_corners(r)
    ce_eq("flat field returns 0 corners", len(corners), 0)
    ce_eq("flat field total == 256", harris_result_total(r), 256)
}

fn test_black_square_detects_corners() {
    // A 4x4 black square at (6, 6) in a 16x16 white field. The four
    // corners (6,6), (9,6), (6,9), (9,9) should be detected (Harris
    // can light up the edge pixels too, but the corner peaks should be
    // local maxima).
    let buf = _black_square_fixture(16, 16, 6, 6, 4)
    let r = harris_apply(buf, 16, 16)
    let corners = harris_result_corners(r)
    ce_check("black square produces > 0 corners", len(corners) > 0)
}

fn test_vertical_edge_few_or_no_corners() {
    // A pure vertical edge has rank-1 structure tensor (intensity varies
    // only in x). The Harris response is small along the edge -- no
    // strong corner. Tolerate up to a few false positives at the
    // boundary, but expect strictly fewer corners than the black-square
    // fixture.
    let edge = _vertical_edge_fixture(16, 16, 0, 255)
    let square = _black_square_fixture(16, 16, 6, 6, 4)
    let r_edge = harris_apply(edge, 16, 16)
    let r_sq   = harris_apply(square, 16, 16)
    let corners_edge = harris_result_corners(r_edge)
    let corners_sq   = harris_result_corners(r_sq)
    // Both have non-zero size, but the corner fixture should have more.
    ce_check("square has more corners than pure edge",
             len(corners_sq) >= len(corners_edge))
}

// ---- aggregate helpers ---------------------------------------------------

fn test_corner_count_label_buckets() {
    ce_str_eq("0 -> low",   harris_corner_count_label(0),   "image_corner_count_low")
    ce_str_eq("4 -> low",   harris_corner_count_label(4),   "image_corner_count_low")
    ce_str_eq("5 -> mid",   harris_corner_count_label(5),   "image_corner_count_mid")
    ce_str_eq("20 -> mid",  harris_corner_count_label(20),  "image_corner_count_mid")
    ce_str_eq("21 -> high", harris_corner_count_label(21),  "image_corner_count_high")
    ce_str_eq("100 -> high",harris_corner_count_label(100), "image_corner_count_high")
}

fn test_density_labels_top() {
    // Build a fake corner list with most corners in the top half.
    let corners = list_new()
    push(corners, _make_corner(2, 1, 50000))
    push(corners, _make_corner(5, 2, 60000))
    push(corners, _make_corner(8, 3, 55000))
    push(corners, _make_corner(10, 14, 40000))  // bottom-right outlier
    let labels = harris_density_labels(corners, 16, 16)
    // 3 of 4 corners in top half (> 50%) -> image_corner_dense_top.
    ce_check("top-heavy distribution emits image_corner_dense_top",
             _has_label(labels, "image_corner_dense_top"))
}

fn test_density_labels_right() {
    // Most corners on the right side.
    let corners = list_new()
    push(corners, _make_corner(12, 4, 50000))
    push(corners, _make_corner(14, 8, 60000))
    push(corners, _make_corner(13, 12, 55000))
    push(corners, _make_corner(2, 6, 40000))    // left outlier
    let labels = harris_density_labels(corners, 16, 16)
    ce_check("right-heavy distribution emits image_corner_dense_right",
             _has_label(labels, "image_corner_dense_right"))
}

fn test_density_labels_empty_input() {
    let corners = list_new()
    let labels = harris_density_labels(corners, 16, 16)
    ce_eq("empty corners -> empty labels", len(labels), 0)
}

// ---- caps + edge cases ---------------------------------------------------

fn test_dimension_cap_rejects_huge() {
    let dummy = alloc(8)
    let r = harris_apply(dummy, 800, 800)
    ce_eq("oversized image -> total == 0", harris_result_total(r), 0)
    let corners = harris_result_corners(r)
    ce_eq("oversized image -> 0 corners", len(corners), 0)
}

fn test_too_small_image_no_corners() {
    let buf = _flat_fixture(2, 2, 128)
    let r = harris_apply(buf, 2, 2)
    let corners = harris_result_corners(r)
    ce_eq("2x2 -> 0 corners", len(corners), 0)
}

fn test_corner_accessors_roundtrip() {
    let c = _make_corner(7, 11, 12345)
    ce_eq("corner x accessor", harris_corner_x(c), 7)
    ce_eq("corner y accessor", harris_corner_y(c), 11)
    ce_eq("corner response accessor", harris_corner_response(c), 12345)
}

// ---- helpers --------------------------------------------------------------

fn _make_corner(x, y, response) {
    let c = list_new()
    push(c, x)
    push(c, y)
    push(c, response)
    return c
}

fn _has_label(labels, target) {
    let i = 0
    while i < len(labels) {
        if str_eq(labels[i], target) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_flat_field_no_corners()
    test_black_square_detects_corners()
    test_vertical_edge_few_or_no_corners()
    test_corner_count_label_buckets()
    test_density_labels_top()
    test_density_labels_right()
    test_density_labels_empty_input()
    test_dimension_cap_rejects_huge()
    test_too_small_image_no_corners()
    test_corner_accessors_roundtrip()
    ce_summary("image_harris")
}

main()
