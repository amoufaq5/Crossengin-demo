// End-to-end story test for the truth-seeking loop: exercise every stage
// (preview -> assert -> derive -> detect -> localize -> suggest -> retract ->
// audit -> re-verify) in one continuous narrative against a really-booted
// formal subsystem. Each stage's mechanism is unit-tested elsewhere; this
// test validates that they COMPOSE correctly through a plausible session.
//
// The story: "birds fly. Sparrows are birds. Therefore sparrows fly. Now
// someone teaches me 'sparrows don't fly' -- the store is inconsistent.
// Localize the conflict, retract the challenger, restore consistency,
// audit the history."
//
// This does not run against the chat REPL (blocked by the NOVA std/io
// startup segfault -- see NEXT_SESSION.md) but exercises the exact same
// fc_* + con_* + list_safe APIs those chat commands invoke.

import "../ce_test.nova"
import "../../src/agent/formal_chat.nova"
import "../../src/mind/recheck.nova"
import "../../src/parts/reasoning/contradiction.nova"

fn _boot() {
    let proofs = proof_registry_new()
    let rck = rck_new()
    fc_boot(proofs, rck)
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "reasoning")
    let b = list_new()
    push(b, proofs) push(b, kgreg) push(b, kg) push(b, rck)
    return b
}

// ---- Act I: build a coherent belief set ------------------------------------
fn test_story_build_up() {
    let b = _boot()
    let kg = b[2]
    // Step 1: PREVIEW an axiom before committing (non-destructive).
    let preview_axs = fc_env_axioms()
    axiom_table_add(preview_axs, term_atom("sparrow_flies"))
    ce_eq("preview on empty store: no conflict",
        con_cs_found(con_conflict_set(_fc_proofs(), preview_axs, hyp_new(), 8)), 0)
    ce_eq("preview did not touch env", fc_env_count(), 0)

    // Step 2: Commit two premises + an implication.
    fc_assert_axiom(kg, "sparrow", "user-taught")            // sparrow
    fc_assert_imp(kg, "birds_fly", "bird", "flies", "user-taught")   // bird -> flies
    fc_assert_imp(kg, "sparrow_is_bird", "sparrow", "bird", "user-taught") // sparrow -> bird

    // Step 3: derive via HS: sparrow -> flies.
    let hs = fc_prove_hs(kg, "sparrow_flies", "sparrow_is_bird", "birds_fly",
                         "user-taught")
    ce_eq("HS derived FORMAL", fc_state(hs), CAND_PROMOTED)
    // Step 4: derive the concrete conclusion `flies` by MP from sparrow +
    // sparrow_flies (which is sparrow -> flies).
    let mp = fc_prove_mp(kg, "flies", "sparrow_flies", "sparrow", "user-taught")
    ce_eq("MP derived FORMAL", fc_state(mp), CAND_PROMOTED)
    ce_eq("flies is FORMAL", atom_evidence_grade(fc_atom(mp)), GRADE_FORMAL)

    // Store is still consistent.
    ce_eq("store consistent",
        con_is_consistent_transitive(_fc_proofs(), fc_env_axioms(),
                                     hyp_new(), 12), 1)

    // /derivation flies would print the MP-chained proof.
    let proof = fc_env_proof_for("flies")
    ce_check("derivation retrievable", proof != 0)
    let txt = con_render_proof_annotated(proof, fc_derivation_annotations())
    ce_check("derivation cites MP",
        str_find(txt, "MP") != (0 - 1))
    ce_check("derivation shows the user-taught tag",
        str_find(txt, "user-taught") != (0 - 1))
    fc_boot(0, b[3])
}

// ---- Act II: a contradiction arrives; detect + localize + suggest ---------
fn test_story_conflict_and_retract() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "sparrow", "user-taught")
    fc_assert_imp(kg, "birds_fly", "bird", "flies", "user-taught")
    fc_assert_imp(kg, "sparrow_is_bird", "sparrow", "bird", "user-taught")
    fc_prove_hs(kg, "sparrow_flies", "sparrow_is_bird", "birds_fly", "user-taught")
    fc_prove_mp(kg, "flies", "sparrow_flies", "sparrow", "user-taught")

    // Preview `not flies` FIRST: the guard says "would conflict".
    let hyp = term_imp(term_atom("flies"), term_atom("_FALSE_"))
    let preview_axs = fc_env_axioms()
    axiom_table_add(preview_axs, hyp)
    ce_eq("preview: not-flies WOULD conflict",
        con_cs_found(con_conflict_set(_fc_proofs(), preview_axs, hyp_new(), 12)), 1)
    ce_eq("preview did not mutate env",
        con_is_consistent_transitive(_fc_proofs(), fc_env_axioms(),
                                     hyp_new(), 12), 1)

    // Commit anyway (mirror a user who ignores the warning).
    fc_assert_imp(kg, "not_flies", "flies", "_FALSE_", "user-taught")

    // Now the transitive scan flags it, names the conflict, and identifies
    // the newest premise as the challenger.
    let cs = con_conflict_set(_fc_proofs(), fc_env_axioms(), hyp_new(), 12)
    ce_eq("real store now inconsistent", con_cs_found(cs), 1)
    let newest = fc_newest_in_conflict(con_cs_premises(cs))
    ce_eq("newest = not_flies (the challenger)",
        _fc_label_eq(newest, "not_flies"), 1)

    // Retract the challenger; the store restores + the log records it.
    let r = fc_retract_with(kgreg, "not_flies")
    ce_eq("retract succeeded", fc_ret_status(r), 1)
    ce_eq("store consistent after retract",
        con_is_consistent_transitive(_fc_proofs(), fc_env_axioms(),
                                     hyp_new(), 12), 1)

    // Audit log has exactly one entry, and its KG label matches.
    ce_eq("one retraction logged", fc_retraction_count(), 1)
    let e = fc_retraction_log()[0]
    ce_eq("logged label = not_flies", _fc_label_eq(fc_rle_label(e), "not_flies"), 1)
    ce_eq("logged kg = reasoning", _fc_label_eq(fc_rle_kg(e), "reasoning"), 1)
    ce_eq("logged source = user-taught",
        _fc_label_eq(fc_rle_source(e), "user-taught"), 1)

    fc_boot(0, b[3])
}

// ---- Act III: the wrong retract cascades; recover by re-asserting ---------
// If we'd retracted `sparrow` instead of `not_flies`, `flies` (the derived
// theorem) would have cascaded to UNKNOWN. Show that cascade is captured in
// the log, and that re-asserting `sparrow` restores the theorem via the
// kernel (re-verified, not remembered).
fn test_story_recover_from_bad_retract() {
    let b = _boot()
    let kgreg = b[1]
    let kg = b[2]
    fc_assert_axiom(kg, "sparrow", "user-taught")
    fc_assert_imp(kg, "birds_fly", "bird", "flies", "user-taught")
    fc_assert_imp(kg, "sparrow_is_bird", "sparrow", "bird", "user-taught")
    fc_prove_hs(kg, "sparrow_flies", "sparrow_is_bird", "birds_fly", "user-taught")
    let mp = fc_prove_mp(kg, "flies", "sparrow_flies", "sparrow", "user-taught")
    let flies_atom = fc_atom(mp)
    ce_eq("flies FORMAL before", atom_evidence_grade(flies_atom), GRADE_FORMAL)

    // The "wrong" retract: dropping sparrow yanks the antecedent out from
    // under sparrow_flies (via HS) and flies (via MP). Cascade should reach
    // multiple atoms.
    let r = fc_retract_with(kgreg, "sparrow")
    ce_eq("retract sparrow succeeded", fc_ret_status(r), 1)
    ce_check("cascade unpinned >= 2 (sparrow, flies)",
        fc_ret_unpinned(r) >= 2)
    ce_eq("flies withdrawn to UNKNOWN",
        atom_evidence_grade(flies_atom), GRADE_UNKNOWN)

    // Log entry captures the wide cascade.
    let e = fc_retraction_log()[0]
    ce_check("logged unpinned matches cascade",
        fc_rle_unpinned(e) >= 2)

    // Re-assert sparrow: kernel re-verifies. (flies is not automatically
    // re-derived -- the theorem's proof was invalidated; a fresh /derive is
    // needed. This is the honest behaviour: we don't quietly resurrect
    // theorems.)
    let re = fc_assert_axiom(kg, "sparrow", "user-taught")
    ce_eq("sparrow re-pinned", fc_state(re), CAND_PROMOTED)
    // flies is still UNKNOWN until re-derived.
    ce_eq("flies still UNKNOWN until re-derived",
        atom_evidence_grade(flies_atom), GRADE_UNKNOWN)

    fc_boot(0, b[3])
}

fn main() {
    test_story_build_up()
    test_story_conflict_and_retract()
    test_story_recover_from_bad_retract()
    ce_summary("reasoning_workflow")
}

main()
