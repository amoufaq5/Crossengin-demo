// Unit tests for B3 (audit F-03): cr_hebb_step, the Hebbian step on the
// cognitive router's table. The audit found the substrate's Hebbian term
// never reached router edges (pool slots vs KG atom ids), so delta w was
// always 0. These tests key edges by real atom ids above any pool size
// (300 -> 301 -> 302 -> 303) and check that delta w is positive on every
// leg of a 3-leg chain at seed confidence, follows the ADR-0007 rule, scales
// with the modulator, never grows edges, and counts only real changes.

import "../ce_test.nova"
import "../../src/exp/exp_flags.nova"
import "../../src/agent/cognitive_router.nova"
import "../../src/util/str_safe.nova"
import "std/string"
import "std/io"

// A reasoning KG with concept atoms 0..303 and three operators
// 300 -> 301, 301 -> 302, 302 -> 303. Returns [kg, op1, op2, op3].
fn _kg300() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let i = 0
    while i < 304 {
        kg_add_atom(rkg, ATOM_CONCEPT, "c" + int_to_str(i), 0)
        i = i + 1
    }
    let o1 = rop_new(rkg, ROP_CAUSAL, 300, 301, "c300->c301", 0)
    let o2 = rop_new(rkg, ROP_CAUSAL, 301, 302, "c301->c302", 0)
    let o3 = rop_new(rkg, ROP_CAUSAL, 302, 303, "c302->c303", 0)
    let r = list_new()
    push(r, rkg) push(r, o1) push(r, o2) push(r, o3)
    return r
}

fn _csv(a, b) { return int_to_str(atom_id(a)) + "," + int_to_str(atom_id(b)) }

// ADR-0007 rule with error 0: dw = mod * (eta_h * pre * post), milli.
fn _expect_dw(pre, post, modulator) {
    return fp_mul(modulator, fp_mul(SYN_ETA_H, fp_mul(pre, post)))
}

fn test_ids_300_301_learn() {
    let c = _kg300()
    let g = syn_graph_new()
    let s1 = syn_new(g, 300, 301, 100, 0)
    cr_set_syn_g(g)
    ce_check("op ids are above 300", atom_id(c[1]) > 300)
    let n = cr_hebb_step(c[0], int_to_str(atom_id(c[1])), 1000)
    ce_eq("one edge updated", n, 1)
    let w = syn_weight(g, s1)
    ce_check("300->301 delta w > 0", w > 100)
    let conf = rop_confidence(c[1])
    ce_eq("delta w follows the ADR-0007 rule", w - 100, _expect_dw(1000, conf, 1000))
    ce_check("eligibility recorded", syn_elig(g, s1) > 0)
    cr_set_syn_g(0)
}

fn test_three_leg_chain_all_learn() {
    // The live seed chains are 3 legs long at confidence 500; every leg
    // must learn (an earlier draft decayed activation down the chain and
    // the third leg truncated to 0).
    let c = _kg300()
    let g = syn_graph_new()
    let s1 = syn_new(g, 300, 301, 100, 0)
    let s2 = syn_new(g, 301, 302, 100, 0)
    let s3 = syn_new(g, 302, 303, 100, 0)
    cr_set_syn_g(g)
    ce_eq("seed confidence is 500", rop_confidence(c[3]), 500)
    let ops = _csv(c[1], c[2]) + "," + int_to_str(atom_id(c[3]))
    let n = cr_hebb_step(c[0], ops, 1000)
    ce_eq("all three legs changed", n, 3)
    ce_eq("leg 1 follows the rule", syn_weight(g, s1) - 100, _expect_dw(1000, rop_confidence(c[1]), 1000))
    ce_eq("leg 2 follows the rule", syn_weight(g, s2) - 100, _expect_dw(1000, rop_confidence(c[2]), 1000))
    ce_eq("leg 3 follows the rule", syn_weight(g, s3) - 100, _expect_dw(1000, rop_confidence(c[3]), 1000))
    ce_check("leg 3 delta w > 0", syn_weight(g, s3) > 100)
    let i = 0
    while i < 9 { cr_hebb_step(c[0], ops, 1322) i = i + 1 }
    ce_check("leg 3 keeps learning over turns", syn_weight(g, s3) >= 100 + 10 * _expect_dw(1000, 500, 1000))
    cr_set_syn_g(0)
}

fn test_modulator_scales() {
    let c = _kg300()
    let g = syn_graph_new()
    let s1 = syn_new(g, 300, 301, 100, 0)
    cr_set_syn_g(g)
    cr_hebb_step(c[0], int_to_str(atom_id(c[1])), 0)
    ce_eq("modulator 0: no change", syn_weight(g, s1), 100)
    cr_hebb_step(c[0], int_to_str(atom_id(c[1])), 2000)
    ce_eq("modulator 2000: twice the neutral step",
          syn_weight(g, s1) - 100, _expect_dw(1000, rop_confidence(c[1]), 2000))
    cr_set_syn_g(0)
}

fn test_never_grows() {
    let c = _kg300()
    let g = syn_graph_new()
    let s2 = syn_new(g, 301, 302, 100, 0)     // only the second leg exists
    cr_set_syn_g(g)
    let n = cr_hebb_step(c[0], _csv(c[1], c[2]), 1000)
    ce_eq("only the existing edge updated", n, 1)
    ce_eq("missing edge not grown", syn_find(g, 300, 301), 0 - 1)
    ce_eq("existing leg learns", syn_weight(g, s2) - 100, _expect_dw(1000, rop_confidence(c[2]), 1000))
    cr_set_syn_g(0)
}

fn test_noops_and_update_count() {
    let c = _kg300()
    let op1 = int_to_str(atom_id(c[1]))
    cr_set_syn_g(0)
    ce_eq("no router table: no-op", cr_hebb_step(c[0], op1, 1000), 0)
    let g = syn_graph_new()
    let s1 = syn_new(g, 300, 301, 100, 0)
    cr_set_syn_g(g)
    ce_eq("empty ops: no-op", cr_hebb_step(c[0], "", 1000), 0)
    ce_eq("unknown op id: nothing updated", cr_hebb_step(c[0], "999999", 1000), 0)
    ce_eq("weight unchanged so far", syn_weight(g, s1), 100)
    ce_eq("real change counted", cr_hebb_step(c[0], op1, 1000), 1)
    // A step that leaves the weight unchanged is not an update.
    ce_eq("modulator 0: no update", cr_hebb_step(c[0], op1, 0), 0)
    syn_set_weight(g, s1, W_MAX)
    ce_eq("at W_MAX: no update", cr_hebb_step(c[0], op1, 1000), 0)
    ce_eq("at W_MAX: clamped", syn_weight(g, s1), W_MAX)
    cr_set_syn_g(0)
}

fn test_flag() {
    exp_flags_reset()
    ce_eq("CE_HEBB off by default", exp_hebb_on(), 0)
    ce_check("trace flags empty by default", str_eq_bytes(exp_trace_flags_csv(), "") == 1)
    exp_set_hebb(1)
    ce_eq("hebb settable", exp_hebb_on(), 1)
    ce_check("trace flags list hebb", str_eq_bytes(exp_trace_flags_csv(), "hebb") == 1)
    exp_set_abl(ABL_CACHE, 1)
    ce_check("hebb listed after ablations", str_eq_bytes(exp_trace_flags_csv(), "cache,hebb") == 1)
    ce_check("ablation csv excludes hebb", str_eq_bytes(exp_flags_csv(), "cache") == 1)
    exp_flags_reset()
    ce_eq("reset clears hebb", exp_hebb_on(), 0)
}

fn main() {
    test_ids_300_301_learn()
    test_three_leg_chain_all_learn()
    test_modulator_scales()
    test_never_grows()
    test_noops_and_update_count()
    test_flag()
    ce_summary("router_hebb")
}
main()
