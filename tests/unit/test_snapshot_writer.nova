// Unit tests for src/persistence/snapshot_writer.nova
// Verifies the snapshot container: header fields, section put/get/presence,
// the framed serialization layout, and the crash-safe write contract. ADR-0048.

import "../ce_test.nova"
import "../../src/persistence/snapshot_writer.nova"

fn _blob(tag) {
    let b = list_new()
    push(b, tag)
    push(b, 99)
    return b
}

fn test_header_and_sections() {
    let s = snap_new(42, 1000)
    ce_eq("tag", snap_tag(s), SNAP_TAG)
    ce_eq("version", snap_version(s), SNAP_FORMAT_VERSION)
    ce_eq("instance", snap_instance(s), 42)
    ce_eq("timestamp", snap_timestamp(s), 1000)
    ce_eq("empty count", snap_section_count(s), 0)
    ce_eq("soul absent", snap_has_section(s, SEC_SOUL), 0)

    snap_put_section(s, SEC_SOUL, _blob(7))
    snap_put_section(s, SEC_KGS, _blob(8))
    ce_eq("soul present", snap_has_section(s, SEC_SOUL), 1)
    ce_eq("count 2", snap_section_count(s), 2)
    ce_eq("soul blob round-trips", snap_section(s, SEC_SOUL)[0], 7)
    ce_eq("episodic still absent", snap_has_section(s, SEC_EPISODIC), 0)
    ce_check("absent section is 0", snap_section(s, SEC_EPISODIC) == 0)

    // Out-of-range section is rejected.
    ce_eq("bad section rejected", snap_put_section(s, 99, _blob(1)), 0)
}

fn test_serialize_layout() {
    let s = snap_new(5, 200)
    snap_put_section(s, SEC_SOUL, _blob(11))
    snap_put_section(s, SEC_SELFMODEL, _blob(22))
    let ser = snap_serialize(s)
    ce_eq("ser tag", ser[0], SNAP_TAG)
    ce_eq("ser version", ser[1], SNAP_FORMAT_VERSION)
    ce_eq("ser instance", ser[2], 5)
    ce_eq("ser timestamp", ser[3], 200)
    ce_eq("ser sec count", ser[4], SEC_COUNT)
    // Section cells follow in order; cell = [present, blob].
    ce_eq("soul present in ser", ser[5 + SEC_SOUL][0], 1)
    ce_eq("soul blob in ser", ser[5 + SEC_SOUL][1][0], 11)
    ce_eq("kgs absent in ser", ser[5 + SEC_KGS][0], 0)
    ce_eq("selfmodel present", ser[5 + SEC_SELFMODEL][0], 1)
}

fn test_durable_contract() {
    ce_str_eq("tmp path", snap_tmp_path("/var/ce/state.cesnap"), "/var/ce/state.cesnap.tmp")
    let steps = snap_durable_steps()
    ce_eq("three steps", len(steps), 3)
    ce_str_eq("write first", steps[0], "write_tmp")
    ce_str_eq("fsync second", steps[1], "fsync")
    ce_str_eq("rename last", steps[2], "atomic_rename")
    ce_str_eq("section name", sec_name(SEC_EPISODIC), "episodic")
}

fn main() {
    test_header_and_sections()
    test_serialize_layout()
    test_durable_contract()
    ce_summary("snapshot_writer")
}
main()
