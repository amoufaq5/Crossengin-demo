// Unit tests for src/io/transducers/stream_unix_socket.nova -- the PURE logic
// (NL_AND_COVERAGE C1; ADR-0058). The Unix-domain socket lifecycle is
// integration-only; here we cover the first-newline line splitter + the state
// object/accessors.

import "../ce_test.nova"
import "../../src/io/transducers/stream_unix_socket.nova"

fn test_split_first_newline() {
    let r = _stream_unix_split_first_newline("abc\ndef")
    ce_check("split returns a pair", r != 0)
    ce_str_eq("pre is before the newline", r[0], "abc")
    ce_str_eq("post is after the newline", r[1], "def")
    // only the FIRST newline splits; later ones stay in the remainder.
    let r2 = _stream_unix_split_first_newline("first\nsecond\nthird")
    ce_str_eq("pre = first line", r2[0], "first")
    ce_str_eq("post keeps later newlines", r2[1], "second\nthird")
    // leading newline -> empty prefix.
    let r3 = _stream_unix_split_first_newline("\ntail")
    ce_str_eq("leading newline empty pre", r3[0], "")
    ce_str_eq("leading newline tail", r3[1], "tail")
    // no newline -> 0 (incomplete line, buffer it).
    ce_eq("no newline -> 0", _stream_unix_split_first_newline("noeol"), 0)
}

fn test_fresh_state() {
    let s = stream_unix_new()
    ce_eq("fresh: disabled", stream_unix_enabled(s), 0)
    ce_eq("fresh: not initialized", stream_unix_initialized(s), 0)
    ce_eq("fresh: no listen fd", stream_unix_listen_fd(s), 0)
    ce_eq("fresh: lines 0", stream_unix_lines_total(s), 0)
    ce_eq("fresh: accepts 0", stream_unix_accepts_total(s), 0)
    // the socket path is resolved from $CE_STREAM_SOCKET at init, so a fresh
    // (pre-init) state carries no path yet.
    ce_str_eq("fresh: path unset until init", stream_unix_path(s), "")
}

fn main() {
    test_split_first_newline()
    test_fresh_state()
    ce_summary("stream_unix_socket")
}
main()
