// Unit tests for src/parts/action/action_module.nova
//
// Verifies the action orchestrator: derive maps ctx state to the right
// intent kind, submit routes SPEAK intents through effector_gate (writing
// INTENT + OUTCOME records to a wired decision log), submit no-ops when
// the log is null, run cascades through derive/submit/complete correctly,
// and halted paths produce EFF_HALTED with no effector_speak emission.
// ADR-0093 (Phase N R2).
//
// NOVA language quirk (Phase Q R2): `==` / `!=` on list values are
// NOT reference-identity AND NOT content-structural -- empirically both
// comparators treat any two list handles as EQUAL (verified by probe:
// two lists with completely different content still compare `==` true).
// Tests asserting "handle distinctness" (`s1 != s3`) therefore ALWAYS
// evaluate false. For singleton rebuild-on-key-change, use the explicit
// `_action_module_singleton_reset()` test helper (the module's own
// `dl != dl2` rebuild guard cannot fire under NOVA's list equality).
// See ADR-0093 "NOVA language quirks".

import "../ce_test.nova"
import "../../src/parts/action/action_module.nova"

// ---- derive: unknown ctx -> SPEAK not-understood -------------------------
fn test_derive_unknown() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    let intent = action_derive_intent(am, ctx, 0, 100)
    ce_check("unknown -> intent", in_is_intent(intent) == 1)
    ce_eq("unknown kind = SPEAK", in_kind(intent), IN_KIND_SPEAK)
    ce_str_eq("unknown text",
              in_text(intent),
              "i do not fully understand that yet")
    ce_eq("unknown confidence lower", in_confidence(intent), 500)
    ce_eq("unknown ts", in_timestamp_ns(intent), 100)
    ce_check("unknown is speak", in_is_speak(intent) == 1)
}

// ---- derive: percept present -> SPEAK understood -------------------------
fn test_derive_percept() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    let p = list_new(); push(p, 12345)
    ctx_set_percept(ctx, p)
    let intent = action_derive_intent(am, ctx, 0, 200)
    ce_check("percept -> intent", in_is_intent(intent) == 1)
    ce_eq("percept kind = SPEAK", in_kind(intent), IN_KIND_SPEAK)
    ce_str_eq("percept text", in_text(intent), "understood")
    ce_eq("percept confidence higher", in_confidence(intent), 800)
    ce_check("percept is speak", in_is_speak(intent) == 1)
}

// ---- derive: empty ctx -> INTERNAL ---------------------------------------
fn test_derive_empty() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 300)
    ce_check("empty -> intent", in_is_intent(intent) == 1)
    ce_eq("empty kind = INTERNAL", in_kind(intent), IN_KIND_INTERNAL)
    ce_check("empty is internal", in_is_internal(intent) == 1)
    // Backwards-compat contract: INTERNAL carries the pre-R2
    // "i have nothing to say" template on IN_TEXT.
    ce_str_eq("empty text", in_text(intent), "i have nothing to say")
    ce_str_eq("empty reason", in_reason(intent), "nothing")
}

// ---- derive: goal engine attaches goal id --------------------------------
fn test_derive_goal_attached() {
    let ge = goal_engine_new()
    let gid = goal_new(ge, "g1", 900, 0, 0, 0)
    let am = action_module_init(0, ge)
    let ctx = ctx_new()
    let p = list_new(); push(p, 1)
    ctx_set_percept(ctx, p)
    let intent = action_derive_intent(am, ctx, 0, 1)
    ce_eq("goal attached to intent", in_goal_id(intent), gid)
}

// ---- submit: SPEAK with wired dl writes INTENT ---------------------------
fn test_submit_speak_wired_dl() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_speak_new(100, "hello", 0, 800, 0)
    let out = action_submit(am, intent, 0, 1, 0, 100)
    let result = out[0]
    let seq = out[1]
    // The action module writes one INTENT via effector_submit, then
    // effector_speak writes another INTENT + one OUTCOME (its own
    // ACT_SPEAK submission). That's three records total after submit.
    // (action_complete adds a fourth OUTCOME -- not called here.)
    let after = dl_count(dl)
    ce_check("submit wrote records", (after - before) >= 1)
    ce_eq("submit result EXECUTED", result, EFF_EXECUTED)
    ce_check("submit seq recorded", seq >= 0)
}

// ---- submit: SPEAK with null dl is a no-op silently ----------------------
fn test_submit_speak_null_dl() {
    let am = action_module_init(0, 0)
    let intent = intent_speak_new(100, "hello", 0, 800, 0)
    let out = action_submit(am, intent, 0, 1, 0, 100)
    let result = out[0]
    let seq = out[1]
    ce_eq("null dl still reports EXECUTED", result, EFF_EXECUTED)
    ce_eq("null dl no seq", seq, 0 - 1)
}

// ---- submit: INTERNAL never touches the log ------------------------------
fn test_submit_internal_no_op() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_internal_new(1, "nothing")
    let out = action_submit(am, intent, 0, 1, 0, 1)
    let after = dl_count(dl)
    ce_eq("internal no log write", after - before, 0)
    ce_eq("internal result EXECUTED", out[0], EFF_EXECUTED)
    ce_eq("internal seq unset", out[1], 0 - 1)
}

// ---- submit: TOOL_CALL suspended (motor_map empty) ----------------------
fn test_submit_tool_suspended() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_tool_new(1, "search", 0, 500, 0, EFF_CLASS_HTTP)
    let out = action_submit(am, intent, 0, 1, 0, 1)
    let after = dl_count(dl)
    ce_eq("tool submit result SUSPENDED", out[0], EFF_SUSPENDED)
    ce_eq("tool no seq", out[1], 0 - 1)
    ce_eq("tool no log write", after - before, 0)
}

// ---- submit + complete: SPEAK writes INTENT + OUTCOME --------------------
fn test_submit_then_complete() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_speak_new(100, "hello", 0, 800, 0)
    let out = action_submit(am, intent, 0, 1, 0, 100)
    let mid = dl_count(dl)
    let seq = out[1]
    ce_check("submit grew log", (mid - before) >= 1)
    let n = action_complete(am, seq, 1, 101)
    let after = dl_count(dl)
    ce_eq("complete wrote outcome", after - mid, 1)
    ce_eq("complete returned 1", n, 1)
}

// ---- run: unknown ctx cascades through submit + complete -----------------
fn test_run_unknown_end_to_end() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    let before = dl_count(dl)
    let intent = action_run(am, ctx, 0, 0, 1, 0, 500)
    let after = dl_count(dl)
    // action_run: 1 INTENT (action_submit) + 1 INTENT (effector_speak) +
    // 1 OUTCOME (effector_speak) + 1 OUTCOME (action_complete) = 4 recs.
    ce_check("run unknown wrote records", (after - before) >= 2)
    ce_str_eq("run unknown ctx_output (via intent)",
              in_text(intent),
              "i do not fully understand that yet")
    ce_check("run unknown is speak", in_is_speak(intent) == 1)
    ce_eq("run unknown eff EXECUTED", am_last_eff_result(am), EFF_EXECUTED)
}

// ---- run: empty ctx adds no log entries ----------------------------------
fn test_run_empty_no_log() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let ctx = ctx_new()
    let before = dl_count(dl)
    let intent = action_run(am, ctx, 0, 0, 1, 0, 600)
    let after = dl_count(dl)
    ce_eq("run empty no log write", after - before, 0)
    ce_str_eq("run empty text", in_text(intent), "i have nothing to say")
    ce_check("run empty is internal", in_is_internal(intent) == 1)
}

// ---- run: halted -> EFF_HALTED, no emit ----------------------------------
fn test_run_halted() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    let intent = action_run(am, ctx, 0, 1, 1, 0, 700)  // halted=1
    ce_eq("halted -> EFF_HALTED", am_last_eff_result(am), EFF_HALTED)
    // The intent itself is still SPEAK-kind (derive is halted-agnostic)
    // and carries the not-understood text; what changed is the submit
    // path did NOT invoke effector_speak (eff_runs(EFF_HALTED)==0), so
    // there is no emit-side INTENT/OUTCOME pair -- only the
    // action_module's own INTENT record (from effector_submit).
    ce_check("halted intent still speak", in_is_speak(intent) == 1)
}

// ---- module handle guards -----------------------------------------------
fn test_module_guards() {
    ce_eq("am_is_module on 0", am_is_module(0), 0)
    let am = action_module_init(0, 0)
    ce_check("am_is_module on real handle", am_is_module(am) == 1)
    ce_eq("am_dl empty", am_dl(am), 0)
    ce_eq("am_goal_engine empty", am_goal_engine(am), 0)
    ce_eq("am_intent_count initial", am_intent_count(am), 0)
    ce_eq("am_last_intent initial", am_last_intent(am), 0)
    ce_eq("am_last_intent_seq initial", am_last_intent_seq(am), 0 - 1)
}

// ---- singleton ----------------------------------------------------------
// Rebuild-on-dl-change is asserted BEHAVIORALLY (via am_intent_count
// mutation side-effects) rather than by handle distinctness: NOVA's `!=`
// on lists is structural equality, not reference-identity, so `s1 != s3`
// on two structurally-identical AM handles always evaluates false. See
// the top-of-file quirk note and ADR-0093 "NOVA language quirks".
fn test_singleton() {
    _action_module_singleton_reset()
    let dl = dl_new()
    let s1 = action_module_singleton_for(dl, 0)
    let s2 = action_module_singleton_for(dl, 0)
    ce_check("singleton stable across identical keys", s1 == s2)
    // Mutate s1's intent_count via an empty-ctx run (empty-ctx -> INTERNAL
    // intent, no log write, but intent_count still ticks).
    let ctx = ctx_new()
    action_run(s1, ctx, 0, 0, 1, 0, 1)
    ce_eq("s1 intent_count after run", am_intent_count(s1), 1)
    // Reset forces a fresh singleton: the module's own `dl != dl2`
    // rebuild guard cannot fire under NOVA's list-equality (`!=` on
    // lists is always false), so the only portable way to force a
    // rebuild is the explicit `_action_module_singleton_reset()` helper.
    // A post-reset singleton_for() call must yield a module with fresh
    // intent_count=0, not s1's post-run state (1).
    _action_module_singleton_reset()
    let s3 = action_module_singleton_for(dl, 0)
    ce_eq("singleton rebuilt after reset (fresh intent_count)",
          am_intent_count(s3), 0)
    _action_module_singleton_reset()
}

// ---- run: intent count monotonically increases --------------------------
fn test_intent_count_growth() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    ce_eq("initial count", am_intent_count(am), 0)
    action_run(am, ctx, 0, 0, 1, 0, 1)
    ce_eq("count after one run", am_intent_count(am), 1)
    action_run(am, ctx, 0, 0, 1, 0, 2)
    ce_eq("count after two runs", am_intent_count(am), 2)
    ce_check("last intent cached", in_is_intent(am_last_intent(am)) == 1)
}

// ---- Phase R1: motor_map hit mints TOOL kind -----------------------------
//
// Seed the module's AM_MOTOR_MAP with a known signature->EFF_CLASS_TOOL
// mapping, feed a ctx whose activation signature matches, and assert
// `action_derive_intent` returns an IN_KIND_TOOL_CALL intent (not
// SPEAK, not INTERNAL). Confirms the Phase R1 lookup runs BEFORE the
// pre-R2 SPEAK/INTERNAL fallthrough. ADR-0107.
fn test_derive_intent_mints_tool_on_motor_map_hit() {
    let am = action_module_init(0, 0)
    // Install a custom registry with ONE known mapping. The signature
    // bytes mm_activation_signature produces for (ctx with no active,
    // goal_id=0) is "g0" -- seed that.
    let mm = motor_map_new()
    motor_map_register(mm, "g0", EFF_CLASS_TOOL)
    am_set_motor_map(am, mm)
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 123)
    ce_check("hit -> intent", in_is_intent(intent) == 1)
    ce_eq("hit kind = TOOL_CALL", in_kind(intent), IN_KIND_TOOL_CALL)
    ce_eq("hit effector_class = TOOL",
          in_effector_class(intent), EFF_CLASS_TOOL)
    ce_check("hit is NOT speak", in_is_speak(intent) == 0)
    ce_check("hit is NOT internal", in_is_internal(intent) == 0)
}

// ---- Phase R1: motor_map miss falls through to pre-R2 decision tree ------
//
// An unseeded registry (no entries) misses on every signature, so the
// pre-R2 unknown/percept/empty decision tree runs unchanged. Empty ctx
// still mints an INTERNAL intent with the "nothing" reason -- byte-
// identity with pre-R1 behavior. ADR-0107.
fn test_derive_intent_falls_through_on_motor_map_miss() {
    let am = action_module_init(0, 0)
    // Explicitly override the default registry with an empty one so the
    // signature misses on every lookup.
    am_set_motor_map(am, motor_map_new())
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 456)
    ce_check("miss -> intent", in_is_intent(intent) == 1)
    ce_eq("miss falls through to INTERNAL",
          in_kind(intent), IN_KIND_INTERNAL)
    ce_str_eq("miss carries pre-R2 nothing text",
              in_text(intent), "i have nothing to say")
}

// ---- run: percept links onto intent -------------------------------------
fn test_run_percept_linked() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    let p = list_new(); push(p, 42)
    ctx_set_percept(ctx, p)
    // A sentinel percept "object" so in_set_linked_percept has something
    // non-zero to attach. Reuse a small list -- action_module reads only
    // the source atom id at slot 7 if len >= 8, which this list doesn't
    // satisfy, so source_pid stays 0 (that's fine here).
    let fake_percept = list_new()
    let k = 0
    while k < 4 { push(fake_percept, 0) k = k + 1 }
    let intent = action_run(am, ctx, fake_percept, 0, 1, 0, 1)
    ce_check("percept linked onto intent",
             in_linked_percept(intent) == fake_percept)
}

fn main() {
    test_derive_unknown()
    test_derive_percept()
    test_derive_empty()
    test_derive_goal_attached()
    test_submit_speak_wired_dl()
    test_submit_speak_null_dl()
    test_submit_internal_no_op()
    test_submit_tool_suspended()
    test_submit_then_complete()
    test_run_unknown_end_to_end()
    test_run_empty_no_log()
    test_run_halted()
    test_module_guards()
    test_singleton()
    test_intent_count_growth()
    test_derive_intent_mints_tool_on_motor_map_hit()
    test_derive_intent_falls_through_on_motor_map_miss()
    test_run_percept_linked()
    ce_summary("action_module")
}
main()
