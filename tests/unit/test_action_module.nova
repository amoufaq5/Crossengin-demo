    ce_check("http dispatch ran gate", eff_runs(out[0]) == 1)
    ce_check("http dispatch seq assigned", out[1] >= 0)
    ce_check("http dispatch wrote records", (after - before) >= 2)
}

// ---- Phase R2: CODE dispatch executes code_exec_run ---------------------
