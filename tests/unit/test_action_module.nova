    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_audio_new_with_payload(1, "hello", 0, 700, 0,
                                               "/tmp/ce_tool_r2a_audio.wav")
    let out = action_submit(am, intent, 0, 1, 0, 1)
    let after = dl_count(dl)
    // AUDIO uses ACT_SPEAK -> NOTIFY tier -> EFF_NOTIFIED.
    ce_check("audio dispatch ran gate", eff_runs(out[0]) == 1)
    ce_check("audio dispatch seq assigned", out[1] >= 0)
    ce_check("audio dispatch wrote records", (after - before) >= 2)
}

// ---- Phase R2: TOOL meta re-dispatches via in_effector_class ------------
// A TOOL_CALL intent whose effector class is CODE should route into the
// CODE branch and execute like a plain CODE intent.
fn test_submit_tool_meta_dispatches_code() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_tool_new(1, "call_tool", 0, 700, 0, EFF_CLASS_CODE)
    list_set(intent, IN_CODE_EXPR, "2*3")
    let out = action_submit(am, intent, 0, 1, 0, 1)
    let after = dl_count(dl)
    ce_eq("tool-meta -> code EXECUTED", out[0], EFF_EXECUTED)
    ce_check("tool-meta seq assigned", out[1] >= 0)
    ce_check("tool-meta wrote records", (after - before) >= 2)
}

// ---- Phase R2: FILE operand-missing falls through to SUSPENDED ---------
// A verb-token-only FILE intent (what action_derive_intent's R1 motor_map
// hit produces) has an empty IN_FILE_PATH slot and must cleanly fall
// through to EFF_SUSPENDED, preserving R1 behavior.
fn test_submit_file_missing_path_falls_through_to_suspended() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_file_new(1, "write_a_note", 0, 700, 0)
    let out = action_submit(am, intent, 0, 1, 0, 1)
    let after = dl_count(dl)
    ce_eq("missing-path result SUSPENDED", out[0], EFF_SUSPENDED)
    ce_eq("missing-path no seq", out[1], 0 - 1)
    ce_eq("missing-path no log write", after - before, 0)
}

// ---- submit + complete: SPEAK writes INTENT + OUTCOME --------------------
fn test_submit_then_complete() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let before = dl_count(dl)
    let intent = intent_speak_new(100, "hello", 0, 800, 0)
    let out = action_submit(am, intent, 0, 1, 0, 100)
    let mid = dl_count(dl)
    let seq = out[1]
    ce_check("submit grew log", (mid - before) >= 1)
    let n = action_complete(am, seq, 1, 101)
    let after = dl_count(dl)
    ce_eq("complete wrote outcome", after - mid, 1)
    ce_eq("complete returned 1", n, 1)
}

// ---- run: unknown ctx cascades through submit + complete -----------------
fn test_run_unknown_end_to_end() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    let before = dl_count(dl)
    let intent = action_run(am, ctx, 0, 0, 1, 0, 500)
    let after = dl_count(dl)
    // action_run: 1 INTENT (action_submit) + 1 INTENT (effector_speak) +
    // 1 OUTCOME (effector_speak) + 1 OUTCOME (action_complete) = 4 recs.
    ce_check("run unknown wrote records", (after - before) >= 2)
    ce_str_eq("run unknown ctx_output (via intent)",
              in_text(intent),
              "i do not fully understand that yet")
    ce_check("run unknown is speak", in_is_speak(intent) == 1)
    // Phase R3 (ADR-0109): SPEAK -> EFF_NOTIFIED (NOTIFY tier). Use the
    // `eff_runs` predicate like R2's non-SPEAK dispatch subtests.
    ce_check("run unknown eff ran", eff_runs(am_last_eff_result(am)) == 1)
}

// ---- run: empty ctx adds no log entries ----------------------------------
fn test_run_empty_no_log() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let ctx = ctx_new()
    let before = dl_count(dl)
    let intent = action_run(am, ctx, 0, 0, 1, 0, 600)
    let after = dl_count(dl)
    ce_eq("run empty no log write", after - before, 0)
    ce_str_eq("run empty text", in_text(intent), "i have nothing to say")
    ce_check("run empty is internal", in_is_internal(intent) == 1)
}

// ---- run: halted -> EFF_HALTED, no emit ----------------------------------
fn test_run_halted() {
    let dl = dl_new()
    let am = action_module_init(dl, 0)
    let ctx = ctx_new()
    ctx_set_unknown(ctx, 1)
    let intent = action_run(am, ctx, 0, 1, 1, 0, 700)  // halted=1
    ce_eq("halted -> EFF_HALTED", am_last_eff_result(am), EFF_HALTED)
    // The intent itself is still SPEAK-kind (derive is halted-agnostic)
    // and carries the not-understood text; what changed is the submit
    // path did NOT invoke effector_speak (eff_runs(EFF_HALTED)==0), so
    // there is no emit-side INTENT/OUTCOME pair -- only the
    // action_module's own INTENT record (from effector_submit).
    ce_check("halted intent still speak", in_is_speak(intent) == 1)
}

// ---- module handle guards -----------------------------------------------
fn test_module_guards() {
    ce_eq("am_is_module on 0", am_is_module(0), 0)
    let am = action_module_init(0, 0)
    ce_check("am_is_module on real handle", am_is_module(am) == 1)
    ce_eq("am_dl empty", am_dl(am), 0)
    ce_eq("am_goal_engine empty", am_goal_engine(am), 0)
    ce_eq("am_intent_count initial", am_intent_count(am), 0)
    ce_eq("am_last_intent initial", am_last_intent(am), 0)
    ce_eq("am_last_intent_seq initial", am_last_intent_seq(am), 0 - 1)
}

// ---- singleton ----------------------------------------------------------
// Rebuild-on-dl-change is asserted BEHAVIORALLY (via am_intent_count
// mutation side-effects) rather than by handle distinctness: NOVA's `!=`
// on lists is structural equality, not reference-identity, so `s1 != s3`
// on two structurally-identical AM handles always evaluates false. See
// the top-of-file quirk note and ADR-0093 "NOVA language quirks".
fn test_singleton() {
    _action_module_singleton_reset()
    let dl = dl_new()
    let s1 = action_module_singleton_for(dl, 0)
    let s2 = action_module_singleton_for(dl, 0)
    ce_check("singleton stable across identical keys", s1 == s2)
    // Mutate s1's intent_count via an empty-ctx run (empty-ctx -> INTERNAL
    // intent, no log write, but intent_count still ticks).
    let ctx = ctx_new()
    action_run(s1, ctx, 0, 0, 1, 0, 1)
    ce_eq("s1 intent_count after run", am_intent_count(s1), 1)
    // Reset forces a fresh singleton: the module's own `dl != dl2`
    // rebuild guard cannot fire under NOVA's list-equality (`!=` on
    // lists is always false), so the only portable way to force a
    // rebuild is the explicit `_action_module_singleton_reset()` helper.
    // A post-reset singleton_for() call must yield a module with fresh
    // intent_count=0, not s1's post-run state (1).
    _action_module_singleton_reset()
    let s3 = action_module_singleton_for(dl, 0)
    ce_eq("singleton rebuilt after reset (fresh intent_count)",
          am_intent_count(s3), 0)
    _action_module_singleton_reset()
}

// ---- run: intent count monotonically increases --------------------------
fn test_intent_count_growth() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    ce_eq("initial count", am_intent_count(am), 0)
    action_run(am, ctx, 0, 0, 1, 0, 1)
    ce_eq("count after one run", am_intent_count(am), 1)
    action_run(am, ctx, 0, 0, 1, 0, 2)
    ce_eq("count after two runs", am_intent_count(am), 2)
    ce_check("last intent cached", in_is_intent(am_last_intent(am)) == 1)
}

// ---- Phase R1: motor_map hit mints TOOL kind -----------------------------
//
// Seed the module's AM_MOTOR_MAP with a known signature->EFF_CLASS_TOOL
// mapping, feed a ctx whose activation signature matches, and assert
// `action_derive_intent` returns an IN_KIND_TOOL_CALL intent (not
// SPEAK, not INTERNAL). Confirms the Phase R1 lookup runs BEFORE the
// pre-R2 SPEAK/INTERNAL fallthrough. ADR-0107.
fn test_derive_intent_mints_tool_on_motor_map_hit() {
    let am = action_module_init(0, 0)
    // Install a custom registry with ONE known mapping. The signature
    // bytes mm_activation_signature produces for (ctx with no active,
    // goal_id=0) is "g0" -- seed that.
    let mm = motor_map_new()
    motor_map_register(mm, "g0", EFF_CLASS_TOOL)
    am_set_motor_map(am, mm)
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 123)
    ce_check("hit -> intent", in_is_intent(intent) == 1)
    ce_eq("hit kind = TOOL_CALL", in_kind(intent), IN_KIND_TOOL_CALL)
    ce_eq("hit effector_class = TOOL",
          in_effector_class(intent), EFF_CLASS_TOOL)
    ce_check("hit is NOT speak", in_is_speak(intent) == 0)
    ce_check("hit is NOT internal", in_is_internal(intent) == 0)
}

// ---- Phase R1: motor_map miss falls through to pre-R2 decision tree ------
//
// An unseeded registry (no entries) misses on every signature, so the
// pre-R2 unknown/percept/empty decision tree runs unchanged. Empty ctx
// still mints an INTERNAL intent with the "nothing" reason -- byte-
// identity with pre-R1 behavior. ADR-0107.
fn test_derive_intent_falls_through_on_motor_map_miss() {
    let am = action_module_init(0, 0)
    // Explicitly override the default registry with an empty one so the
    // signature misses on every lookup.
    am_set_motor_map(am, motor_map_new())
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 456)
    ce_check("miss -> intent", in_is_intent(intent) == 1)
    ce_eq("miss falls through to INTERNAL",
          in_kind(intent), IN_KIND_INTERNAL)
    ce_str_eq("miss carries pre-R2 nothing text",
              in_text(intent), "i have nothing to say")
}

// ---- Phase R3: semantic-sig bridge mints FILE _with_payload -------------
//
// A goal named "write_a_note" is registered in `motor_map_default`
// against EFF_CLASS_FILE. R3's semantic-sig probe reaches that entry
// via the goal name (the handle-sig "g<id>" misses the default
// registry), and `operand_builder_build` synthesizes
// `[path, content] = ["/tmp/ce_goal_<id>.txt", goal_name]`. Assert the
// derived intent carries both operands verbatim. ADR-0109.
fn test_derive_hits_motor_map_by_goal_name_mints_file_with_payload() {
    let ge = goal_engine_new()
    let gid = goal_new(ge, "write_a_note", 900, 0, 0, 0)
    let am = action_module_init(0, ge)
    // Phase R4 (ADR-0112): clear the default goal_templates registry so
    // this subtest keeps exercising the R3 convention path. The R4
    // template path is covered separately by
    // `test_derive_uses_default_templates_on_file_hit`.
    am_set_goal_templates(am, 0)
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 1000)
    ce_check("file derive -> intent", in_is_intent(intent) == 1)
    ce_eq("file derive kind = FILE_OP", in_kind(intent), IN_KIND_FILE_OP)
    ce_eq("file derive effector_class = FILE",
          in_effector_class(intent), EFF_CLASS_FILE)
    ce_eq("file derive goal attached", in_goal_id(intent), gid)
    // Operand convention: path = "/tmp/ce_goal_<id>.txt", content = goal_name.
    ce_str_eq("file derive path",
              in_file_path(intent),
              "/tmp/ce_goal_" + int_to_str(gid) + ".txt")
    ce_str_eq("file derive content",
              in_file_content(intent),
              "write_a_note")
}

// ---- Phase R3: semantic-sig bridge mints CODE _with_payload -------------
//
// Parallel to the FILE subtest, keyed on "run_code" -> EFF_CLASS_CODE.
// CODE's `ACT_READ_LOCAL` is AUTO tier so this path is also useful for
// the end-to-end dispatch subtest below. ADR-0109.
fn test_derive_hits_motor_map_by_goal_name_mints_code_with_payload() {
    let ge = goal_engine_new()
    let gid = goal_new(ge, "run_code", 900, 0, 0, 0)
    let am = action_module_init(0, ge)
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 2000)
    ce_check("code derive -> intent", in_is_intent(intent) == 1)
    ce_eq("code derive kind = CODE_EXEC", in_kind(intent), IN_KIND_CODE_EXEC)
    ce_eq("code derive effector_class = CODE",
          in_effector_class(intent), EFF_CLASS_CODE)
    ce_eq("code derive goal attached", in_goal_id(intent), gid)
    ce_str_eq("code derive expr",
              in_code_expr(intent),
              "1 + " + int_to_str(gid))
}

// ---- Phase R4: default-templates registry drives FILE operand (ADR-0112) --
//
// A goal named "write_a_note" is seeded in both the motor_map (R1) AND
// `goal_templates_default` (R4). `action_module_init` wires the default
// templates handle into AM_GOAL_TEMPLATES; the derive path reaches the
// FILE eff_class via the semantic-sig bridge (R3), then operand_builder
// consults the registry and expands the template.
//
// Expected: `in_file_path == "/tmp/ce_note_<id>.txt"` (R4 TEMPLATE), NOT
// the R3 convention `"/tmp/ce_goal_<id>.txt"`. The content slot still
// matches the goal name verbatim (template body `"%NAME%"` -> goal_name).
fn test_derive_uses_default_templates_on_file_hit() {
    let ge = goal_engine_new()
    let gid = goal_new(ge, "write_a_note", 900, 0, 0, 0)
    let am = action_module_init(0, ge)
    let ctx = ctx_new()
    let intent = action_derive_intent(am, ctx, 0, 4000)
    ce_check("r4 derive -> intent", in_is_intent(intent) == 1)
    ce_eq("r4 kind = FILE_OP", in_kind(intent), IN_KIND_FILE_OP)
    ce_str_eq("r4 path uses TEMPLATE (/tmp/ce_note_<id>.txt), NOT convention",
              in_file_path(intent),
              "/tmp/ce_note_" + int_to_str(gid) + ".txt")
    ce_str_eq("r4 content = goal_name (%NAME% expansion)",
              in_file_content(intent),
              "write_a_note")
}

// ---- Phase R3: end-to-end run_code mints + dispatches + logs 4 recs -----
//
// A goal named "run_code" drives `action_run` through derive -> submit ->
// complete. `operand_builder_build` populates IN_CODE_EXPR, the per-class
// dispatch invokes `code_exec_run`, and the decision log carries four
// records (INTENT via effector_submit, OUTCOME via effector_complete in
// action_submit's CODE branch, plus action_run's own OUTCOME via
// action_complete -- that's at least 2 observable). `eff_runs == 1` is
// the uniform predicate across tiers (CODE lands on EFF_EXECUTED since
// ACT_READ_LOCAL is AUTO). ADR-0109.
fn test_run_code_end_to_end_via_motor_map_semantic_bridge() {
    let dl = dl_new()
    let ge = goal_engine_new()
    let gid = goal_new(ge, "run_code", 900, 0, 0, 0)
    let am = action_module_init(dl, ge)
    let ctx = ctx_new()
    let before = dl_count(dl)
    let intent = action_run(am, ctx, 0, 0, 1, 0, 3000)
    let after = dl_count(dl)
    ce_eq("end-to-end kind = CODE_EXEC", in_kind(intent), IN_KIND_CODE_EXEC)
    ce_check("end-to-end eff ran",
             eff_runs(am_last_eff_result(am)) == 1)
    // 4 rows: effector_submit INTENT + effector_complete OUTCOME (both
    // inside action_submit's CODE branch) + action_complete's OUTCOME.
    // The 4th row is reserved for symmetry with SPEAK's effector_speak
    // pair; CODE only writes 3 here (INTENT + 2x OUTCOME). Assert the
    // minimum guaranteed by R2's dispatch pattern.
    ce_check("end-to-end log grew", (after - before) >= 3)
}

// ---- run: percept links onto intent -------------------------------------
fn test_run_percept_linked() {
    let am = action_module_init(0, 0)
    let ctx = ctx_new()
    let p = list_new(); push(p, 42)
    ctx_set_percept(ctx, p)
    // A sentinel percept "object" so in_set_linked_percept has something
    // non-zero to attach. Reuse a small list -- action_module reads only
    // the source atom id at slot 7 if len >= 8, which this list doesn't
    // satisfy, so source_pid stays 0 (that's fine here).
    let fake_percept = list_new()
    let k = 0
    while k < 4 { push(fake_percept, 0) k = k + 1 }
    let intent = action_run(am, ctx, fake_percept, 0, 1, 0, 1)
    ce_check("percept linked onto intent",
             in_linked_percept(intent) == fake_percept)
}

fn main() {
    test_derive_unknown()
    test_derive_percept()
    test_derive_empty()
    test_derive_goal_attached()
    test_submit_speak_wired_dl()
    test_submit_speak_null_dl()
    test_submit_internal_no_op()
    test_submit_then_complete()
    test_run_unknown_end_to_end()
    test_run_empty_no_log()
    test_run_halted()
    test_module_guards()
    test_singleton()
    test_intent_count_growth()
    test_derive_intent_mints_tool_on_motor_map_hit()
    test_derive_intent_falls_through_on_motor_map_miss()
    test_run_percept_linked()
    // Phase R2 (ADR-0108) per-class dispatch subtests. Gate the FILE
    // and AUDIO ones on an actual /tmp write (the test container may
    // block sys_open(O_CREAT, ...) on /tmp; CODE / HTTP (simulated=1)
    // / MCP / TOOL meta never touch the FS and always run).
    test_submit_code_dispatch_executes()
    test_submit_http_dispatch_executes()
    test_submit_mcp_dispatch_executes()
    test_submit_tool_meta_dispatches_code()
    test_submit_file_missing_path_falls_through_to_suspended()
    // Phase R3 (ADR-0109) subtests: semantic-sig bridge + operand builder.
    // The pure-derive FILE/CODE subtests do no FS I/O (they inspect the
    // minted intent's payload slots). The end-to-end CODE run dispatches
    // through code_exec_run (no FS). All three always run.
    test_derive_hits_motor_map_by_goal_name_mints_file_with_payload()
    test_derive_hits_motor_map_by_goal_name_mints_code_with_payload()
    test_derive_uses_default_templates_on_file_hit()
    test_run_code_end_to_end_via_motor_map_semantic_bridge()
    if _tmp_write_works() == 1 {
        test_submit_file_dispatch_executes()
        test_submit_audio_dispatch_executes()
    } else {
        ce_check("sandboxed sys_open: R2 FILE+AUDIO dispatch subtests skipped cleanly", 1)
    }
    ce_summary("action_module")
}
main()
