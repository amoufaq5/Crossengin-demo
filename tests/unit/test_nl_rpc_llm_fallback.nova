// Unit tests for the R95 LLM-fallback seam in _rpc_verb_nl_ask.
//
// Verifies that when nl.ask is dispatched with an UNPARSED input,
// the seam consults the sidecar (via test-mode injectors) and either
// promotes the query to a valid SQ (success) or leaves it as UNPARSED
// (failure / unavailable), while the attached nl_metrics registry
// records total / unparsed / attempts / successes / failures per
// presented holder.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/nl/nl_llm_sidecar.nova"
import "../../src/nl/nl_metrics.nova"
import "../../src/nl/query_shape.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_dispatch.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/skills/skills/echo_skill.nova"
import "../../src/skills/skills/research_skill.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/util/str_safe.nova"

// ---- test helpers ---------------------------------------------------------

fn _mk_kgreg() {
    let reg = kg_registry_new()
    let kg1 = kg_spawn(reg, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    list_set(a1[A_BELIEF], 0, 8000) list_set(a1[A_BELIEF], 1, 2000)
    return reg
}

fn _mk_ctx() {
    let kgreg = _mk_kgreg()
    let capreg = capreg_new()
    let mo = mo_new()
    let sr = skill_registry_new()
    skill_registry_register(sr, echo_skill_manifest())
    skill_registry_register(sr, research_skill_manifest())
    let preg = persona_registry_new()
    persona_registry_ensure(preg, "owner", 100)
    let ctx = rpc_ctx_new(kgreg, capreg, preg, sr, mo, 0, 0, 100)
    rpc_ctx_set_nl_metrics(ctx, nl_metrics_new())
    return ctx
}

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// ---- fast path: grammar-parseable input -----------------------------------

fn test_grammar_parsed_no_fallback() {
    // "what is mars" parses via grammar; the sidecar is never consulted.
    // Metrics: total=1, unparsed=0, attempts=0.
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("KIND research\nARG cats\n")
    let ctx = _mk_ctx()
    let metrics = rpc_ctx_nl_metrics(ctx)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "what is mars", "user_id", "owner"), ctx)
    ce_check("ok true",         _has(out, "\"ok\":true"))
    ce_check("parser=grammar",  _has(out, "\"parser_used\":\"grammar\""))
    ce_eq("total=1",    nl_metrics_total(metrics, ""), 1)
    ce_eq("unparsed=0", nl_metrics_unparsed(metrics, ""), 0)
    ce_eq("attempts=0", nl_metrics_llm_fallback_attempts(metrics, ""), 0)
    ce_eq("successes=0", nl_metrics_llm_fallback_successes(metrics, ""), 0)
}

// ---- sidecar unavailable --------------------------------------------------

fn test_unparsed_sidecar_off_refuses() {
    // Grammar can't parse this; sidecar OFF; the executor's refusal
    // branch fires (updated R95 message text).
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_off()
    let ctx = _mk_ctx()
    let metrics = rpc_ctx_nl_metrics(ctx)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "floof floof glorpity", "user_id", "owner"), ctx)
    ce_check("verb ok true",   _has(out, "\"ok\":true"))
    ce_check("nl-level refused", _has(out, "\"ok\":false"))
    ce_check("refusal names LLM",  _has(out, "LLM"))
    ce_check("refusal names sidecar", _has(out, "sidecar"))
    ce_eq("total=1",    nl_metrics_total(metrics, ""), 1)
    ce_eq("unparsed=1", nl_metrics_unparsed(metrics, ""), 1)
    // Unavailable is NOT an attempt.
    ce_eq("attempts=0", nl_metrics_llm_fallback_attempts(metrics, ""), 0)
    ce_eq("failures=0", nl_metrics_llm_fallback_failures(metrics, ""), 0)
}

// ---- sidecar promotes the query ------------------------------------------

fn test_unparsed_sidecar_success_promotes() {
    // Grammar can't parse "gibberish question"; testmode-injected LLM
    // wire says {research, cats}. Executor dispatches the research
    // skill against the seeded KG (mars atom is available but cats is
    // not). We assert the seam PROMOTED the query -- the response
    // must mention the templated research answer, and metrics must
    // show attempt+success.
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("KIND research\nARG cats\n")
    let ctx = _mk_ctx()
    let metrics = rpc_ctx_nl_metrics(ctx)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "wobble wobble frotzle", "user_id", "owner"), ctx)
    // The seam handed the LLM-derived research query to nl_execute;
    // the resulting SQ has parser_used="llm".
    ce_check("parser=llm in response", _has(out, "\"parser_used\":\"llm\""))
    ce_check("kind=research",          _has(out, "\"kind\":\"research\""))
    ce_check("topic=cats",             _has(out, "\"cats\""))
    ce_eq("total=1",    nl_metrics_total(metrics, ""), 1)
    ce_eq("unparsed=1", nl_metrics_unparsed(metrics, ""), 1)
    ce_eq("attempts=1", nl_metrics_llm_fallback_attempts(metrics, ""), 1)
    ce_eq("successes=1", nl_metrics_llm_fallback_successes(metrics, ""), 1)
    ce_eq("failures=0", nl_metrics_llm_fallback_failures(metrics, ""), 0)
}

// ---- sidecar returns malformed wire --------------------------------------

fn test_unparsed_sidecar_malformed_wire_fails() {
    // Testmode-injected wire is malformed; the seam counts an attempt
    // + a failure and leaves q as UNPARSED so the executor refuses.
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_testmode("this is not wire format at all")
    let ctx = _mk_ctx()
    let metrics = rpc_ctx_nl_metrics(ctx)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "wobble frotzle glorp", "user_id", "owner"), ctx)
    ce_check("nl-level refused",  _has(out, "\"ok\":false"))
    ce_check("refusal names LLM", _has(out, "LLM"))
    ce_eq("total=1",     nl_metrics_total(metrics, ""), 1)
    ce_eq("unparsed=1",  nl_metrics_unparsed(metrics, ""), 1)
    ce_eq("attempts=1",  nl_metrics_llm_fallback_attempts(metrics, ""), 1)
    ce_eq("failures=1",  nl_metrics_llm_fallback_failures(metrics, ""), 1)
    ce_eq("successes=0", nl_metrics_llm_fallback_successes(metrics, ""), 0)
}

// ---- context wiring -------------------------------------------------------

fn test_ctx_nl_metrics_accessor() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 0)
    ce_eq("default 0", rpc_ctx_nl_metrics(ctx), 0)
    let reg = nl_metrics_new()
    rpc_ctx_set_nl_metrics(ctx, reg)
    ce_eq("round-trips", rpc_ctx_nl_metrics(ctx), reg)
}

fn test_zero_metrics_ctx_still_dispatches() {
    // A daemon that never called rpc_ctx_set_nl_metrics must still
    // dispatch nl.ask correctly (metrics inc is a no-op).
    nl_llm_sidecar_reset_cache()
    nl_llm_sidecar_test_force_off()
    let kgreg = _mk_kgreg()
    let sr = skill_registry_new()
    skill_registry_register(sr, research_skill_manifest())
    let ctx = rpc_ctx_new(kgreg, 0, 0, sr, 0, 0, 0, 100)
    let out = rpc_dispatch("nl.ask",
        _args2("text", "what is mars", "user_id", ""), ctx)
    ce_check("verb ok",         _has(out, "\"ok\":true"))
    ce_check("parser=grammar",  _has(out, "\"parser_used\":\"grammar\""))
}

// ---- runner ---------------------------------------------------------------

fn main() {
    test_ctx_nl_metrics_accessor()
    test_grammar_parsed_no_fallback()
    test_unparsed_sidecar_off_refuses()
    test_unparsed_sidecar_success_promotes()
    test_unparsed_sidecar_malformed_wire_fails()
    test_zero_metrics_ctx_still_dispatches()
    ce_summary("nl_rpc_llm_fallback")
}

main()
