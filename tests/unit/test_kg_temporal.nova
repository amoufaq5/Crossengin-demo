// Unit tests for src/kg/temporal.nova (R19C).
//
// Covers Allen's 13-relation interval algebra (Allen 1983, CACM
// 26(11)) over atom timestamps:
//   - each of the 13 relations (before, meets, overlaps, starts,
//     during, finishes, equals + their 6 inverses) with hand-built
//     intervals of known geometry;
//   - tmp_relation_name <-> tmp_relation_parse round-trip;
//   - inverse relation: tmp_relation(A, B) == BEFORE iff
//     tmp_relation(B, A) == AFTER (the brief's mandatory check);
//   - tmp_query_relation walks a 5-atom KG with known time order;
//   - tmp_chain builds the maximal "before-chain" through 5 atoms;
//   - tmp_overlap_set returns all overlapping intervals;
//   - edge cases: self-relation (A vs A), missing atom_id,
//     empty KG, max_hops boundary;
//   - tmp_relation_inverse pair round-trip.
//
// Total assertions: ~35 (above the brief's 30 target).
//
// ADRs: ADR-0016 (atom design -- created/updated fields), ADR-0049
//   (testing).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/temporal.nova"

// ---- helpers --------------------------------------------------------------

// Build a fresh KG with `n` atoms, all created at ts=0, then return it.
// Callers immediately set per-atom timestamps via _set_interval below.
fn _mk_kg_n(label, n) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, label)
    let i = 0
    while i < n {
        kg_add_atom(kg, ATOM_FACT, "atom_" + int_to_str(i), 0)
        i = i + 1
    }
    return kg
}

// Set the interval [first, last] of a freshly-added atom by writing
// directly to its A_CREATED and A_UPDATED slots. This is the test-only
// equivalent of "the atom was born at first and last seen at last".
// Production atoms get the same effect via kg_add_atom(now=first) +
// atom_touch(a, last).
fn _set_interval(kg, atom_id_in, first, last) {
    let a = kg_atom(kg, atom_id_in)
    if a == 0 { return 0 }
    list_set(a, A_CREATED, first)
    list_set(a, A_UPDATED, last)
    return 1
}

// Build a KG of `n` atoms with intervals [first, last] specified as
// parallel lists. Helper for the multi-relation fixtures below.
fn _mk_kg_intervals(label, firsts, lasts) {
    let n = len(firsts)
    let kg = _mk_kg_n(label, n)
    let i = 0
    while i < n {
        _set_interval(kg, i, firsts[i], lasts[i])
        i = i + 1
    }
    return kg
}

// ---- each of the 13 Allen relations --------------------------------------

fn test_allen_before() {
    // A = [10, 20]; B = [30, 40]. al=20 < bf=30 -> BEFORE.
    let kg = _mk_kg_n("test_allen_before", 2)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 30, 40)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("before: A=[10,20], B=[30,40] -> BEFORE",
        tmp_relation(a, b), ALLEN_BEFORE)
}

fn test_allen_meets() {
    // A = [10, 20]; B = [20, 30]. al=20 == bf=20 (and af < bf) -> MEETS.
    let kg = _mk_kg_n("test_allen_meets", 2)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 20, 30)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("meets: A=[10,20], B=[20,30] -> MEETS",
        tmp_relation(a, b), ALLEN_MEETS)
}

fn test_allen_overlaps() {
    // A = [10, 25]; B = [20, 40]. af<bf, al>bf, al<bl -> OVERLAPS.
    let kg = _mk_kg_n("test_allen_overlaps", 2)
    _set_interval(kg, 0, 10, 25)
    _set_interval(kg, 1, 20, 40)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("overlaps: A=[10,25], B=[20,40] -> OVERLAPS",
        tmp_relation(a, b), ALLEN_OVERLAPS)
}

fn test_allen_starts() {
    // A = [10, 20]; B = [10, 30]. af==bf, al<bl -> STARTS.
    let kg = _mk_kg_n("test_allen_starts", 2)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 10, 30)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("starts: A=[10,20], B=[10,30] -> STARTS",
        tmp_relation(a, b), ALLEN_STARTS)
}

fn test_allen_during() {
    // A = [15, 25]; B = [10, 30]. af>bf, al<bl -> DURING (A inside B).
    let kg = _mk_kg_n("test_allen_during", 2)
    _set_interval(kg, 0, 15, 25)
    _set_interval(kg, 1, 10, 30)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("during: A=[15,25], B=[10,30] -> DURING",
        tmp_relation(a, b), ALLEN_DURING)
}

fn test_allen_finishes() {
    // A = [20, 30]; B = [10, 30]. al==bl, af>bf -> FINISHES.
    let kg = _mk_kg_n("test_allen_finishes", 2)
    _set_interval(kg, 0, 20, 30)
    _set_interval(kg, 1, 10, 30)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("finishes: A=[20,30], B=[10,30] -> FINISHES",
        tmp_relation(a, b), ALLEN_FINISHES)
}

fn test_allen_equals() {
    // A = [10, 20]; B = [10, 20]. af==bf && al==bl -> EQUALS.
    let kg = _mk_kg_n("test_allen_equals", 2)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 10, 20)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("equals: A=[10,20], B=[10,20] -> EQUALS",
        tmp_relation(a, b), ALLEN_EQUALS)
}

fn test_allen_after() {
    // Inverse of BEFORE: A = [30, 40], B = [10, 20]. af=30 > bl=20 -> AFTER.
    let kg = _mk_kg_n("test_allen_after", 2)
    _set_interval(kg, 0, 30, 40)
    _set_interval(kg, 1, 10, 20)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("after: A=[30,40], B=[10,20] -> AFTER",
        tmp_relation(a, b), ALLEN_AFTER)
}

fn test_allen_met_by() {
    // Inverse of MEETS: A = [20, 30], B = [10, 20]. af==bl, al>bl -> MET_BY.
    let kg = _mk_kg_n("test_allen_met_by", 2)
    _set_interval(kg, 0, 20, 30)
    _set_interval(kg, 1, 10, 20)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("met_by: A=[20,30], B=[10,20] -> MET_BY",
        tmp_relation(a, b), ALLEN_MET_BY)
}

fn test_allen_overlapped_by() {
    // Inverse of OVERLAPS: A = [20, 40], B = [10, 25]. af>bf, af<bl, al>bl -> OVERLAPPED_BY.
    let kg = _mk_kg_n("test_allen_obb", 2)
    _set_interval(kg, 0, 20, 40)
    _set_interval(kg, 1, 10, 25)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("overlapped_by: A=[20,40], B=[10,25] -> OVERLAPPED_BY",
        tmp_relation(a, b), ALLEN_OVERLAPPED_BY)
}

fn test_allen_started_by() {
    // Inverse of STARTS: A = [10, 30], B = [10, 20]. af==bf, al>bl -> STARTED_BY.
    let kg = _mk_kg_n("test_allen_started_by", 2)
    _set_interval(kg, 0, 10, 30)
    _set_interval(kg, 1, 10, 20)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("started_by: A=[10,30], B=[10,20] -> STARTED_BY",
        tmp_relation(a, b), ALLEN_STARTED_BY)
}

fn test_allen_contains() {
    // Inverse of DURING: A = [10, 30], B = [15, 25]. af<bf, al>bl -> CONTAINS.
    let kg = _mk_kg_n("test_allen_contains", 2)
    _set_interval(kg, 0, 10, 30)
    _set_interval(kg, 1, 15, 25)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("contains: A=[10,30], B=[15,25] -> CONTAINS",
        tmp_relation(a, b), ALLEN_CONTAINS)
}

fn test_allen_finished_by() {
    // Inverse of FINISHES: A = [10, 30], B = [20, 30]. al==bl, af<bf -> FINISHED_BY.
    let kg = _mk_kg_n("test_allen_finished_by", 2)
    _set_interval(kg, 0, 10, 30)
    _set_interval(kg, 1, 20, 30)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("finished_by: A=[10,30], B=[20,30] -> FINISHED_BY",
        tmp_relation(a, b), ALLEN_FINISHED_BY)
}

// ---- name round-trip + inverse ------------------------------------------

fn test_relation_name_roundtrip() {
    ce_str_eq("name BEFORE       -> 'before'",
        tmp_relation_name(ALLEN_BEFORE), "before")
    ce_str_eq("name MEETS        -> 'meets'",
        tmp_relation_name(ALLEN_MEETS), "meets")
    ce_str_eq("name OVERLAPS     -> 'overlaps'",
        tmp_relation_name(ALLEN_OVERLAPS), "overlaps")
    ce_str_eq("name STARTS       -> 'starts'",
        tmp_relation_name(ALLEN_STARTS), "starts")
    ce_str_eq("name DURING       -> 'during'",
        tmp_relation_name(ALLEN_DURING), "during")
    ce_str_eq("name FINISHES     -> 'finishes'",
        tmp_relation_name(ALLEN_FINISHES), "finishes")
    ce_str_eq("name EQUALS       -> 'equals'",
        tmp_relation_name(ALLEN_EQUALS), "equals")
    ce_str_eq("name AFTER        -> 'after'",
        tmp_relation_name(ALLEN_AFTER), "after")
    ce_str_eq("name MET_BY       -> 'met_by'",
        tmp_relation_name(ALLEN_MET_BY), "met_by")
    ce_str_eq("name OVERLAPPED_BY-> 'overlapped_by'",
        tmp_relation_name(ALLEN_OVERLAPPED_BY), "overlapped_by")
    ce_str_eq("name STARTED_BY   -> 'started_by'",
        tmp_relation_name(ALLEN_STARTED_BY), "started_by")
    ce_str_eq("name CONTAINS     -> 'contains'",
        tmp_relation_name(ALLEN_CONTAINS), "contains")
    ce_str_eq("name FINISHED_BY  -> 'finished_by'",
        tmp_relation_name(ALLEN_FINISHED_BY), "finished_by")

    // Parse round-trip: name(code) -> string; parse(string) -> code.
    ce_eq("parse 'before'        -> ALLEN_BEFORE",
        tmp_relation_parse("before"), ALLEN_BEFORE)
    ce_eq("parse 'after'         -> ALLEN_AFTER",
        tmp_relation_parse("after"), ALLEN_AFTER)
    ce_eq("parse 'overlapped_by' -> ALLEN_OVERLAPPED_BY",
        tmp_relation_parse("overlapped_by"), ALLEN_OVERLAPPED_BY)
    ce_eq("parse 'unknown'       -> 0",
        tmp_relation_parse("bogus"), 0)
}

fn test_inverse_pair_roundtrip() {
    // The brief's mandatory check: BEFORE(A, B) iff AFTER(B, A).
    let kg = _mk_kg_n("test_inv_be_af", 2)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 30, 40)
    let a = kg_atom(kg, 0)
    let b = kg_atom(kg, 1)
    ce_eq("tmp_relation(A, B) == BEFORE", tmp_relation(a, b), ALLEN_BEFORE)
    ce_eq("tmp_relation(B, A) == AFTER  (inverse of BEFORE)",
        tmp_relation(b, a), ALLEN_AFTER)

    // OVERLAPS / OVERLAPPED_BY: tmp_relation(A,B)==OVERLAPS iff tmp_relation(B,A)==OVERLAPPED_BY.
    let kg2 = _mk_kg_n("test_inv_ov", 2)
    _set_interval(kg2, 0, 10, 25)
    _set_interval(kg2, 1, 20, 40)
    let a2 = kg_atom(kg2, 0)
    let b2 = kg_atom(kg2, 1)
    ce_eq("tmp_relation(A, B) == OVERLAPS",
        tmp_relation(a2, b2), ALLEN_OVERLAPS)
    ce_eq("tmp_relation(B, A) == OVERLAPPED_BY",
        tmp_relation(b2, a2), ALLEN_OVERLAPPED_BY)

    // DURING / CONTAINS: tmp_relation(A,B)==DURING iff tmp_relation(B,A)==CONTAINS.
    let kg3 = _mk_kg_n("test_inv_dur", 2)
    _set_interval(kg3, 0, 15, 25)
    _set_interval(kg3, 1, 10, 30)
    let a3 = kg_atom(kg3, 0)
    let b3 = kg_atom(kg3, 1)
    ce_eq("tmp_relation(A, B) == DURING",
        tmp_relation(a3, b3), ALLEN_DURING)
    ce_eq("tmp_relation(B, A) == CONTAINS",
        tmp_relation(b3, a3), ALLEN_CONTAINS)

    // tmp_relation_inverse helper.
    ce_eq("inverse(BEFORE) == AFTER",
        tmp_relation_inverse(ALLEN_BEFORE), ALLEN_AFTER)
    ce_eq("inverse(AFTER) == BEFORE",
        tmp_relation_inverse(ALLEN_AFTER), ALLEN_BEFORE)
    ce_eq("inverse(EQUALS) == EQUALS (self-inverse)",
        tmp_relation_inverse(ALLEN_EQUALS), ALLEN_EQUALS)
    ce_eq("inverse(STARTS) == STARTED_BY",
        tmp_relation_inverse(ALLEN_STARTS), ALLEN_STARTED_BY)
    ce_eq("inverse(STARTED_BY) == STARTS",
        tmp_relation_inverse(ALLEN_STARTED_BY), ALLEN_STARTS)
}

// ---- query: 5 atoms in known temporal order ------------------------------

fn test_query_relation_after() {
    // Brief: KG with 5 atoms in known temporal order, tmp_query_relation
    // (source=2, ALLEN_AFTER) returns atoms 3, 4 (the ones temporally
    // after atom 2).
    //
    // Intervals: 0=[10,20], 1=[30,40], 2=[50,60], 3=[70,80], 4=[90,100].
    // For source=2, we want atoms whose interval is AFTER 2's interval.
    // tmp_relation(a, src) == AFTER means a starts strictly after src ends.
    //   atom 3 [70,80] vs src 2 [50,60]: af=70 > bl=60 -> AFTER. yes.
    //   atom 4 [90,100] vs src 2 [50,60]: af=90 > bl=60 -> AFTER. yes.
    //   atom 0, 1: BEFORE 2.
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 20)
    push(firsts, 30) push(lasts, 40)
    push(firsts, 50) push(lasts, 60)
    push(firsts, 70) push(lasts, 80)
    push(firsts, 90) push(lasts, 100)
    let kg = _mk_kg_intervals("test_q_after", firsts, lasts)

    let hits = tmp_query_relation(kg, 2, ALLEN_AFTER)
    ce_eq("query(2, AFTER) returns 2 hits", len(hits), 2)
    ce_eq("query(2, AFTER)[0] == 3", hits[0], 3)
    ce_eq("query(2, AFTER)[1] == 4", hits[1], 4)

    // Symmetric: query(2, BEFORE) returns {0, 1}.
    let before_hits = tmp_query_relation(kg, 2, ALLEN_BEFORE)
    ce_eq("query(2, BEFORE) returns 2 hits", len(before_hits), 2)
    ce_eq("query(2, BEFORE)[0] == 0", before_hits[0], 0)
    ce_eq("query(2, BEFORE)[1] == 1", before_hits[1], 1)
}

fn test_query_relation_during() {
    // Source atom 0 = [10, 100]; atoms 1, 2 are DURING source;
    // atom 3 is EQUALS source; atom 4 is BEFORE source.
    // query(0, CONTAINS) -- atoms with relation CONTAINS to source 0
    // means tmp_relation(a, src) == CONTAINS -> a's interval contains src's.
    // None do here (src is the widest).
    // query(0, DURING) -- atoms whose interval is during src.
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 100)
    push(firsts, 20) push(lasts, 30)
    push(firsts, 50) push(lasts, 60)
    push(firsts, 10) push(lasts, 100)
    push(firsts, 0)  push(lasts, 5)
    let kg = _mk_kg_intervals("test_q_during", firsts, lasts)

    // Atoms 1, 2 are DURING source 0.
    let hits = tmp_query_relation(kg, 0, ALLEN_DURING)
    ce_eq("query(0, DURING) -> 2 hits", len(hits), 2)
    ce_eq("query(0, DURING)[0] == 1", hits[0], 1)
    ce_eq("query(0, DURING)[1] == 2", hits[1], 2)

    // Atom 3 is EQUALS source 0.
    let eq_hits = tmp_query_relation(kg, 0, ALLEN_EQUALS)
    ce_eq("query(0, EQUALS) -> 1 hit", len(eq_hits), 1)
    ce_eq("query(0, EQUALS)[0] == 3", eq_hits[0], 3)
}

// ---- chain: 5 atoms A<B<C<D<E -------------------------------------------

fn test_chain_five_atoms() {
    // Brief: 5 atoms A<B<C<D<E (each strictly BEFORE the next).
    // tmp_chain(A, 5) returns [A, B, C, D, E] (length 5).
    // Intervals: 0=[10,20], 1=[30,40], 2=[50,60], 3=[70,80], 4=[90,100].
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 20)
    push(firsts, 30) push(lasts, 40)
    push(firsts, 50) push(lasts, 60)
    push(firsts, 70) push(lasts, 80)
    push(firsts, 90) push(lasts, 100)
    let kg = _mk_kg_intervals("test_chain", firsts, lasts)

    let chain = tmp_chain(kg, 0, 5)
    ce_eq("chain(0, 5) length == 5", len(chain), 5)
    ce_eq("chain(0)[0] == 0", chain[0], 0)
    ce_eq("chain(0)[1] == 1", chain[1], 1)
    ce_eq("chain(0)[2] == 2", chain[2], 2)
    ce_eq("chain(0)[3] == 3", chain[3], 3)
    ce_eq("chain(0)[4] == 4", chain[4], 4)
}

fn test_chain_max_hops_zero() {
    // max_hops=0 -> just [start_id]; max_hops<0 -> empty list.
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 20)
    push(firsts, 30) push(lasts, 40)
    let kg = _mk_kg_intervals("test_chain_zero", firsts, lasts)

    let zero = tmp_chain(kg, 0, 0)
    ce_eq("chain(0, 0) length == 1 (just start)", len(zero), 1)
    ce_eq("chain(0, 0)[0] == 0", zero[0], 0)

    let neg = tmp_chain(kg, 0, 0 - 1)
    ce_eq("chain(0, -1) -> empty", len(neg), 0)
}

fn test_chain_dead_end() {
    // Chain terminates early when no later atom exists.
    // 3 atoms: 0=[10,20], 1=[30,40], 2=[15,25] (overlaps 0; not after 1).
    // tmp_chain(1, 10) -> [1] (no atom is strictly after 1's [30,40]).
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 20)
    push(firsts, 30) push(lasts, 40)
    push(firsts, 15) push(lasts, 25)
    let kg = _mk_kg_intervals("test_chain_de", firsts, lasts)

    let chain = tmp_chain(kg, 1, 10)
    ce_eq("chain(1, 10) on dead-end -> length 1", len(chain), 1)
    ce_eq("chain(1, 10)[0] == 1", chain[0], 1)
}

// ---- overlap set --------------------------------------------------------

fn test_overlap_set_three_atoms() {
    // Brief: 3 atoms with overlapping intervals -> tmp_overlap_set
    // returns all 3 (including the source).
    // 0=[10,30], 1=[20,40], 2=[25,35]. All three overlap pairwise.
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 30)
    push(firsts, 20) push(lasts, 40)
    push(firsts, 25) push(lasts, 35)
    let kg = _mk_kg_intervals("test_overlap", firsts, lasts)

    let hits = tmp_overlap_set(kg, 0)
    ce_eq("overlap_set(0) on 3 overlapping atoms -> 3 hits", len(hits), 3)
    ce_eq("overlap_set(0)[0] == 0 (self)", hits[0], 0)
    ce_eq("overlap_set(0)[1] == 1", hits[1], 1)
    ce_eq("overlap_set(0)[2] == 2", hits[2], 2)
}

fn test_overlap_set_disjoint() {
    // 3 atoms with disjoint intervals: 0=[10,20], 1=[30,40], 2=[50,60].
    // overlap_set(1) -> [1] (only self overlaps self).
    let firsts = list_new()
    let lasts = list_new()
    push(firsts, 10) push(lasts, 20)
    push(firsts, 30) push(lasts, 40)
    push(firsts, 50) push(lasts, 60)
    let kg = _mk_kg_intervals("test_overlap_dis", firsts, lasts)

    let hits = tmp_overlap_set(kg, 1)
    ce_eq("overlap_set(1) on disjoint atoms -> 1 hit (self)",
        len(hits), 1)
    ce_eq("overlap_set(1)[0] == 1 (self)", hits[0], 1)
}

// ---- edge cases ---------------------------------------------------------

fn test_self_relation_equals() {
    // tmp_relation(A, A) == EQUALS by definition (same endpoints).
    let kg = _mk_kg_n("test_self", 1)
    _set_interval(kg, 0, 10, 20)
    let a = kg_atom(kg, 0)
    ce_eq("tmp_relation(A, A) -> EQUALS",
        tmp_relation(a, a), ALLEN_EQUALS)
}

fn test_missing_atom_query_empty() {
    // Missing atom_id -> empty list.
    let kg = _mk_kg_n("test_missing", 3)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 30, 40)
    _set_interval(kg, 2, 50, 60)
    let hits = tmp_query_relation(kg, 999, ALLEN_AFTER)
    ce_eq("query(missing, AFTER) -> empty", len(hits), 0)
    let neg = tmp_query_relation(kg, 0 - 1, ALLEN_AFTER)
    ce_eq("query(negative, AFTER) -> empty", len(neg), 0)
    let chain = tmp_chain(kg, 999, 5)
    ce_eq("chain(missing, 5) -> empty", len(chain), 0)
    let ov = tmp_overlap_set(kg, 999)
    ce_eq("overlap_set(missing) -> empty", len(ov), 0)
}

fn test_query_invalid_relation_empty() {
    let kg = _mk_kg_n("test_inv_rel", 2)
    _set_interval(kg, 0, 10, 20)
    _set_interval(kg, 1, 30, 40)
    // Relation code 0 and codes outside 1..13 are rejected.
    let zero = tmp_query_relation(kg, 0, 0)
    ce_eq("query(0, rel=0) -> empty", len(zero), 0)
    let high = tmp_query_relation(kg, 0, 99)
    ce_eq("query(0, rel=99) -> empty", len(high), 0)
}

fn test_first_last_helpers() {
    // tmp_first_ns / tmp_last_ns expose the atom's created / updated
    // timestamps. After _set_interval, both must reflect the new values.
    let kg = _mk_kg_n("test_helpers", 1)
    _set_interval(kg, 0, 100, 200)
    let a = kg_atom(kg, 0)
    ce_eq("tmp_first_ns(a) == 100", tmp_first_ns(a), 100)
    ce_eq("tmp_last_ns(a) == 200", tmp_last_ns(a), 200)
    // Helpers on a zero atom must yield 0 (not crash).
    ce_eq("tmp_first_ns(0) == 0", tmp_first_ns(0), 0)
    ce_eq("tmp_last_ns(0) == 0", tmp_last_ns(0), 0)
}

fn main() {
    test_allen_before()
    test_allen_meets()
    test_allen_overlaps()
    test_allen_starts()
    test_allen_during()
    test_allen_finishes()
    test_allen_equals()
    test_allen_after()
    test_allen_met_by()
    test_allen_overlapped_by()
