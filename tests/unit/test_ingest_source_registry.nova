// Unit tests for src/ingest/source_registry.nova.

import "../ce_test.nova"
import "../../src/ingest/source_registry.nova"

fn test_empty_registry() {
    let r = reg_source_new()
    ce_eq("empty size 0", len(r), 0)
    ce_check("unknown lookup returns 0", reg_source_get(r, "cerec") == 0)
    ce_eq("unknown tag", reg_source_tag(r, "cerec"), FMT_UNKNOWN)
}

fn test_defaults_install() {
    let r = reg_source_new()
    let n = reg_source_install_defaults(r)
    // R65 added json (9 formats); R85 added yaml (10 formats);
    // R105 (Phase G, ADR-0202) added image/audio/video (13 formats).
    ce_eq("defaults install 13", n, 13)
    ce_eq("cerec tag", reg_source_tag(r, "cerec"), FMT_CEREC)
    ce_eq("csv tag", reg_source_tag(r, "csv"), FMT_CSV)
    ce_eq("ntriples tag", reg_source_tag(r, "ntriples"), FMT_NTRIPLES)
    ce_eq("wikidata tag", reg_source_tag(r, "wikidata"), FMT_WIKIDATA)
    ce_eq("conceptnet tag", reg_source_tag(r, "conceptnet"), FMT_CONCEPTNET)
    ce_eq("papermeta tag", reg_source_tag(r, "papermeta"), FMT_PAPERMETA)
    ce_eq("wordnet tag", reg_source_tag(r, "wordnet"), FMT_WORDNET)
    ce_eq("llm tag", reg_source_tag(r, "llm"), FMT_LLM_EXTRACT)
    ce_eq("json tag", reg_source_tag(r, "json"), FMT_JSON)
    ce_eq("yaml tag", reg_source_tag(r, "yaml"), FMT_YAML)
    ce_eq("image tag", reg_source_tag(r, "image"), FMT_IMAGE)
    ce_eq("audio tag", reg_source_tag(r, "audio"), FMT_AUDIO)
    ce_eq("video tag", reg_source_tag(r, "video"), FMT_VIDEO)
    // R85: yaml gets its own src: prefix so ingest.policy rules can
    // route yaml-origin records without stealing json's prefix.
    ce_str_eq("yaml prefix", reg_source_get(r, "yaml")[SR_PREFIX], "src:yaml:")
    // R105: perceptual prefixes so policy engine can route
    // multimodal origins per ADR-0029 authority weighting.
    ce_str_eq("image prefix", reg_source_get(r, "image")[SR_PREFIX], "src:image:")
    ce_str_eq("audio prefix", reg_source_get(r, "audio")[SR_PREFIX], "src:audio:")
    ce_str_eq("video prefix", reg_source_get(r, "video")[SR_PREFIX], "src:video:")
}

fn test_lookup_returns_prefix() {
    let r = reg_source_new()
    reg_source_install_defaults(r)
    let e = reg_source_get(r, "wikidata")
    ce_check("wikidata found", e != 0)
    ce_eq("prefix matches", e[SR_PREFIX], "src:wikidata:")
}

fn test_unknown_name() {
    let r = reg_source_new()
    reg_source_install_defaults(r)
    ce_eq("nonsense tag", reg_source_tag(r, "not-a-format"), FMT_UNKNOWN)
}

fn test_reg_source_name_roundtrip() {
    let names = list_new()
    push(names, "cerec") push(names, "csv") push(names, "ntriples")
    push(names, "wikidata") push(names, "conceptnet") push(names, "papermeta")
    push(names, "wordnet") push(names, "llm") push(names, "json") push(names, "yaml")
    push(names, "image")   push(names, "audio") push(names, "video")
    let r = reg_source_new() reg_source_install_defaults(r)
    let i = 0
    while i < len(names) {
        let tag = reg_source_tag(r, names[i])
        ce_check("round-trip " + names[i], str_eq_bytes(reg_source_name(tag), names[i]) == 1)
        i = i + 1
    }
    ce_eq("unknown name", reg_source_name(999), "unknown")
}

fn main() {
    test_empty_registry()
    test_defaults_install()
    test_lookup_returns_prefix()
    test_unknown_name()
    test_reg_source_name_roundtrip()
    ce_summary("ingest_source_registry")
}

main()
