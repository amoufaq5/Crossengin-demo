// Unit tests for src/kg/query.nova R16F extensions: OPTIONAL, UNION,
// ORDER BY. R15D shipped the BGP+FILTER+LIMIT base; R16F adds three
// SPARQL-core features that complete the "standard" subset.
//
// The fixture is a clone of the R15D _fixture_kg() (5 FACTs + 5
// CONCEPTs + 5 SIMILAR xrefs FACT_i -> CONCEPT_(i+5)) so the new
// tests can directly compare against R15D's pinned counts.
//
// Total assertions: ~35. Helpers are integer-only; comparisons exact.
//
// ADRs: ADR-0016 (atoms + xrefs are the query surface), ADR-0049
// (testing + benchmarks).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/cross_kg_references.nova"
import "../../src/kg/query.nova"

// ---- helpers --------------------------------------------------------------

// Re-builds the R15D 10-atom fixture: 5 FACT atoms at ids 0..4 with
// alpha = 1000..5000, then 5 CONCEPT atoms at ids 5..9 with alpha=1000
// (the prior; CONCEPTs aren't observed). Every FACT i links to
// CONCEPT (i+5) via XREF_SIMILAR.
fn _fixture_kg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "test_query_ext")
    let i = 0
    while i < 5 {
        let a = kg_add_atom(kg, ATOM_FACT, "fact_" + int_to_str(i), 1000 + i * 100)
        let j = 0
        while j < i {
            atom_observe(a, 1)
            j = j + 1
        }
        i = i + 1
    }
    let k = 0
    while k < 5 {
        kg_add_atom(kg, ATOM_CONCEPT, "concept_" + int_to_str(k), 1500 + k * 100)
        k = k + 1
    }
    let m = 0
    while m < 5 {
        let f = kg_atom(kg, m)
        let c = kg_atom(kg, m + 5)
        let x = xref_new(f, c, XREF_SIMILAR, 900, 0)
        atom_add_xref(f, x)
        m = m + 1
    }
    return kg
}

// A KG identical to _fixture_kg() but with NO xrefs at all -- so that
// `OPTIONAL { ?a links ?b }` cannot match any binding, and we can
// assert the all-unbound-?b semantics.
fn _fixture_kg_no_xrefs() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "test_query_ext_no_xrefs")
    let i = 0
    while i < 5 {
        let a = kg_add_atom(kg, ATOM_FACT, "fact_" + int_to_str(i), 1000 + i * 100)
        let j = 0
        while j < i {
            atom_observe(a, 1)
            j = j + 1
        }
        i = i + 1
    }
    let k = 0
    while k < 5 {
        kg_add_atom(kg, ATOM_CONCEPT, "concept_" + int_to_str(k), 1500 + k * 100)
        k = k + 1
    }
    return kg
}

// ---- parser tests (new syntax) -------------------------------------------

fn test_parse_optional_block() {
    // OPTIONAL { ... } is a top-level pattern; the body has its own
    // patterns.
    let q = kg_query_parse("SELECT ?a ?b WHERE { ?a kind FACT . OPTIONAL { ?a links ?b . } }")
    ce_check("OPTIONAL query parses", kg_query_is_parsed(q) == 1)
    ce_eq("two top-level patterns (triple + optional)", len(kg_query_patterns(q)), 2)
    let opt = kg_query_patterns(q)[1]
    ce_eq("optional tag is PAT_OPTIONAL", opt[0], PAT_OPTIONAL)
    ce_eq("optional inner has 1 triple", len(opt[1]), 1)
}

fn test_parse_union_block() {
    let q = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . } UNION { ?a kind CONCEPT . } }")
    ce_check("UNION query parses", kg_query_is_parsed(q) == 1)
    ce_eq("one top-level pattern (the UNION)", len(kg_query_patterns(q)), 1)
    let u = kg_query_patterns(q)[0]
    ce_eq("union tag is PAT_UNION", u[0], PAT_UNION)
    ce_eq("union left has 1 triple", len(u[1]), 1)
    ce_eq("union right has 1 triple", len(u[2]), 1)
}

fn test_parse_orderby_asc_default() {
    // ORDER BY field (no direction) defaults to ASC.
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY alpha")
    ce_check("ORDER BY field-only parses", kg_query_is_parsed(q) == 1)
    ce_eq("orderby is present", kg_query_orderby_has(q), 1)
    ce_str_eq("orderby field is alpha", kg_query_orderby_field(q), "alpha")
    ce_eq("orderby direction is ASC", kg_query_orderby_dir(q), ORD_ASC)
}

fn test_parse_orderby_desc_paren() {
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY DESC(alpha)")
    ce_check("ORDER BY DESC(alpha) parses", kg_query_is_parsed(q) == 1)
    ce_eq("orderby is present", kg_query_orderby_has(q), 1)
    ce_str_eq("orderby field is alpha", kg_query_orderby_field(q), "alpha")
    ce_eq("orderby direction is DESC", kg_query_orderby_dir(q), ORD_DESC)
}

fn test_parse_orderby_asc_paren() {
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY ASC(alpha)")
    ce_check("ORDER BY ASC(alpha) parses", kg_query_is_parsed(q) == 1)
    ce_eq("orderby is present", kg_query_orderby_has(q), 1)
    ce_eq("orderby direction is ASC", kg_query_orderby_dir(q), ORD_ASC)
}

fn test_parse_orderby_then_limit() {
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY DESC(alpha) LIMIT 3")
    ce_check("ORDER BY + LIMIT parses", kg_query_is_parsed(q) == 1)
    ce_eq("orderby is present", kg_query_orderby_has(q), 1)
    ce_eq("limit is 3", kg_query_limit(q), 3)
    ce_eq("orderby direction is DESC", kg_query_orderby_dir(q), ORD_DESC)
}

fn test_parse_no_orderby() {
    // R15D query with no ORDER BY: kg_query_orderby_has returns 0.
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } LIMIT 5")
    ce_check("R15D-shape parses", kg_query_is_parsed(q) == 1)
    ce_eq("no orderby", kg_query_orderby_has(q), 0)
}

fn test_parse_bad_orderby_missing_field() {
    let r = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY")
    ce_eq("missing field is an error", _qry_is_error(r), 1)
}

fn test_parse_bad_orderby_unknown_field() {
    let r = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY frobnicate")
    ce_eq("unknown field is an error", _qry_is_error(r), 1)
}

// ---- executor tests: OPTIONAL --------------------------------------------

fn test_optional_all_match() {
    // Every FACT links to a CONCEPT, so OPTIONAL { ?a links ?b } binds
    // ?b on every row. Result: 5 bindings, all with ?b bound.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a ?b WHERE { ?a kind FACT . OPTIONAL { ?a links ?b . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("5 FACT bindings", len(results), 5)
    let bound_count = 0
    let i = 0
    while i < len(results) {
        if binding_has(results[i], "b") == 1 { bound_count = bound_count + 1 }
        i = i + 1
    }
    ce_eq("all 5 have ?b bound (FACTs all link)", bound_count, 5)
}

fn test_optional_no_match() {
    // KG has no xrefs; OPTIONAL { ?a links ?b } never matches.
    // Expected: 5 FACT bindings, all with ?b UNBOUND.
    let kg = _fixture_kg_no_xrefs()
    let q = kg_query_parse("SELECT ?a ?b WHERE { ?a kind FACT . OPTIONAL { ?a links ?b . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("5 FACT bindings (LEFT-OUTER-JOIN)", len(results), 5)
    let bound_count = 0
    let i = 0
    while i < len(results) {
        if binding_has(results[i], "b") == 1 { bound_count = bound_count + 1 }
        i = i + 1
    }
    ce_eq("none have ?b bound (no xrefs)", bound_count, 0)
    let a_bound = 0
    let j = 0
    while j < len(results) {
        if binding_has(results[j], "a") == 1 { a_bound = a_bound + 1 }
        j = j + 1
    }
    ce_eq("all 5 have ?a bound", a_bound, 5)
}

fn test_optional_mixed() {
    // Add a 6th FACT to the standard fixture that has NO xrefs. So 6
    // FACTs total: 5 with ?b bound, 1 with ?b unbound.
    let kg = _fixture_kg()
    kg_add_atom(kg, ATOM_FACT, "fact_lonely", 2000)
    let q = kg_query_parse("SELECT ?a ?b WHERE { ?a kind FACT . OPTIONAL { ?a links ?b . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("6 FACT bindings", len(results), 6)
    let bound_count = 0
    let i = 0
    while i < len(results) {
        if binding_has(results[i], "b") == 1 { bound_count = bound_count + 1 }
        i = i + 1
    }
    ce_eq("5 have ?b bound (1 lonely FACT does not)", bound_count, 5)
}

// ---- executor tests: UNION -----------------------------------------------

fn test_union_facts_and_concepts() {
    // { ?a kind FACT } UNION { ?a kind CONCEPT } -> 10 bindings.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . } UNION { ?a kind CONCEPT . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("10 atoms (5 FACT + 5 CONCEPT)", len(results), 10)
    let all_bound = 1
    let i = 0
    while i < len(results) {
        if binding_has(results[i], "a") == 0 { all_bound = 0 }
        i = i + 1
    }
    ce_eq("every binding has ?a", all_bound, 1)
}

fn test_union_with_filter_left_only() {
    // Filter on FACT side only: { ?a kind FACT . FILTER alpha > 3500 . }
    // UNION { ?a kind CONCEPT . }. FACT side keeps 2 (alpha=4000,5000);
    // CONCEPT side keeps all 5. Total: 7.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . FILTER alpha > 3500 . } UNION { ?a kind CONCEPT . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("2 FACT + 5 CONCEPT", len(results), 7)
}

fn test_union_with_filter_both_sides() {
    // Filter on both sides: { ?a kind FACT . FILTER alpha > 2500 . }
    // UNION { ?a kind CONCEPT . FILTER count = 3 . }.
    // FACT alpha > 2500: 3 (alpha=3000,4000,5000)
    // CONCEPT count = 3 (CONCEPT kind code is 3): all 5
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . FILTER alpha > 2500 . } UNION { ?a kind CONCEPT . FILTER count = 3 . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("3 FACT + 5 CONCEPT", len(results), 8)
}

fn test_union_same_branch() {
    // Pathological: UNION of two identical branches should DOUBLE the
    // result set (SPARQL bag semantics; no implicit dedupe).
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . } UNION { ?a kind FACT . } }")
    let results = kg_query_execute(kg, q)
    ce_eq("UNION of identical branches doubles count (5+5)", len(results), 10)
}

// ---- executor tests: ORDER BY --------------------------------------------

fn test_orderby_asc_alpha() {
    // 5 FACTs with alpha 1000,2000,3000,4000,5000; ASC -> ascending.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY ASC(alpha)")
    let results = kg_query_execute(kg, q)
    ce_eq("5 results", len(results), 5)
    // Smallest alpha is FACT 0 (alpha=1000), largest is FACT 4
    // (alpha=5000). ASC -> FACT 0 first.
    ce_eq("ASC: first is atom_id=0", binding_get(results[0], "a"), 0)
    ce_eq("ASC: last is atom_id=4", binding_get(results[4], "a"), 4)
}

fn test_orderby_desc_alpha() {
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY DESC(alpha)")
    let results = kg_query_execute(kg, q)
    ce_eq("5 results", len(results), 5)
    // DESC: largest first.
    ce_eq("DESC: first is atom_id=4 (alpha=5000)", binding_get(results[0], "a"), 4)
    ce_eq("DESC: last is atom_id=0 (alpha=1000)", binding_get(results[4], "a"), 0)
}

fn test_orderby_with_limit() {
    // DESC alpha LIMIT 3 -> top 3 by alpha: ids 4, 3, 2.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY DESC(alpha) LIMIT 3")
    let results = kg_query_execute(kg, q)
    ce_eq("LIMIT 3 returns 3", len(results), 3)
    ce_eq("top-1 atom_id=4", binding_get(results[0], "a"), 4)
    ce_eq("top-2 atom_id=3", binding_get(results[1], "a"), 3)
    ce_eq("top-3 atom_id=2", binding_get(results[2], "a"), 2)
}

fn test_orderby_stable_tiebreak() {
    // All 5 CONCEPTs have alpha=1000 (no observations), so every row
    // ties on alpha; the secondary key (atom_id ascending) breaks the
    // tie. DESC alpha LIMIT 5 -> all 5, with atom_ids 5,6,7,8,9 in
    // order (smaller id first per the tiebreaker).
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind CONCEPT . } ORDER BY DESC(alpha)")
    let results = kg_query_execute(kg, q)
    ce_eq("5 CONCEPTs", len(results), 5)
    // Tied alpha; tiebreak by atom_id ASC.
    ce_eq("tiebreak[0]=5", binding_get(results[0], "a"), 5)
    ce_eq("tiebreak[4]=9", binding_get(results[4], "a"), 9)
}

fn test_orderby_asc_with_limit_top3() {
    // ASC alpha LIMIT 3 -> ids 0, 1, 2.
    let kg = _fixture_kg()
    let q = kg_query_parse("SELECT ?a WHERE { ?a kind FACT . } ORDER BY ASC(alpha) LIMIT 3")
    let results = kg_query_execute(kg, q)
    ce_eq("LIMIT 3 returns 3", len(results), 3)
    ce_eq("asc[0]=0", binding_get(results[0], "a"), 0)
    ce_eq("asc[1]=1", binding_get(results[1], "a"), 1)
    ce_eq("asc[2]=2", binding_get(results[2], "a"), 2)
}

// ---- error handling ------------------------------------------------------

fn test_parse_bad_union_missing_right() {
    // UNION with no right brace group.
    let r = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . } UNION }")
    ce_eq("UNION missing right is an error", _qry_is_error(r), 1)
}

fn test_parse_bad_optional_missing_brace() {
    let r = kg_query_parse("SELECT ?a WHERE { OPTIONAL ?a kind FACT . }")
    ce_eq("OPTIONAL missing '{' is an error", _qry_is_error(r), 1)
}

fn test_parse_bad_lone_brace_group() {
    // A brace group at top level that is not followed by UNION is
    // currently not legal (we route brace-pos directly to UNION parser).
    let r = kg_query_parse("SELECT ?a WHERE { { ?a kind FACT . } }")
    ce_eq("lone brace group without UNION is an error", _qry_is_error(r), 1)
}

fn main() {
    test_parse_optional_block()
    test_parse_union_block()
    test_parse_orderby_asc_default()
    test_parse_orderby_desc_paren()
    test_parse_orderby_asc_paren()
    test_parse_orderby_then_limit()
    test_parse_no_orderby()
    test_parse_bad_orderby_missing_field()
    test_parse_bad_orderby_unknown_field()
    test_optional_all_match()
    test_optional_no_match()
    test_optional_mixed()
    test_union_facts_and_concepts()
    test_union_with_filter_left_only()
    test_union_with_filter_both_sides()
    test_union_same_branch()
    test_orderby_asc_alpha()
    test_orderby_desc_alpha()
    test_orderby_with_limit()
    test_orderby_stable_tiebreak()
    test_orderby_asc_with_limit_top3()
    test_parse_bad_union_missing_right()
    test_parse_bad_optional_missing_brace()
    test_parse_bad_lone_brace_group()
    ce_summary("kg_query_ext")
}

main()
