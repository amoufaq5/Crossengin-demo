// Unit tests for src/parts/soul/goals_in_soul.nova
// Verifies the medium-tier goal summary sync and top-goal lookup. ADR-0034.

import "../ce_test.nova"
import "../../src/parts/soul/goals_in_soul.nova"

fn summary(name, pri, status) {
    let e = list_new(); push(e, name); push(e, pri); push(e, status); return e
}

fn test_sync() {
    let s = soul_new("A")
    ce_eq("empty summary", soul_goal_count(s), 0)
    let sums = list_new()
    push(sums, summary("learn medicine", 800, 1))
    push(sums, summary("answer user", 950, 1))
    soul_sync_goals(s, sums)
    ce_eq("two goals summarized", soul_goal_count(s), 2)
    ce_str_eq("goal name", soul_goal_name(s, 0), "learn medicine")
    ce_eq("goal priority", soul_goal_priority(s, 1), 950)
    ce_str_eq("top goal", soul_top_goal(s), "answer user")
    // Re-sync replaces the summary.
    let sums2 = list_new()
    push(sums2, summary("rest", 100, 1))
    soul_sync_goals(s, sums2)
    ce_eq("replaced", soul_goal_count(s), 1)
    ce_str_eq("new top", soul_top_goal(s), "rest")
}

fn main() {
    test_sync()
    ce_summary("goals_in_soul")
}

main()
