// Unit tests for src/parts/meta/self_model_query.nova
// Verifies identity/state/goals/competence answers reflect real subsystem state
// (no LLM). ADR-0038.

import "../ce_test.nova"
import "../../src/parts/meta/self_model_query.nova"

fn test_identity_state() {
    let sl = soul_new("Aurora")
    ce_check("forming when empty", str_find(selfmodel_identity(sl), "forming") >= 0)
    soul_set_identity(sl, "understand and assist", "curious")
    soul_add_theme(sl, "helper", 800)
    ce_check("identity mentions purpose", str_find(selfmodel_identity(sl), "understand and assist") >= 0)
    ce_check("identity mentions theme", str_find(selfmodel_identity(sl), "helper") >= 0)
    soul_update_state(sl, 700, 400, 500, 900)
    ce_check("state mentions valence", str_find(selfmodel_state(sl), "700") >= 0)
    // Dispatch.
    ce_check("dispatch identity", str_find(selfmodel_answer(SELFQ_IDENTITY, sl, goal_engine_new()), "curious") >= 0)
}

fn test_goals_competence() {
    let engine = goal_engine_new()
    ce_check("no goals", str_find(selfmodel_goals(engine), "no active") >= 0)
    goal_new(engine, "learn medicine", 800, 0, 1, 0)
    ce_check("pursuing goal", str_find(selfmodel_goals(engine), "learn medicine") >= 0)

    // Competence: a capable domain reads back as 'capable'.
    let reg = kg_registry_new()
    let med = kg_spawn(reg, "med")
    let a = kg_add_atom(med, ATOM_FACT, "x", 0)
    let i = 0
    while i < 20 { atom_observe(a, 1); i = i + 1 }
    let sm = self_model_new()
    self_model_set(sm, competence_assess_know(med, 1))
    ce_check("competence capable", str_find(selfmodel_competence(sm, "med", COMP_KNOW), "capable") >= 0)
    ce_check("unknown domain", str_find(selfmodel_competence(sm, "law", COMP_KNOW), "no grounding") >= 0)
}

fn main() { test_identity_state() test_goals_competence() ce_summary("self_model_query") }
main()
