// Unit tests for Phase P R2 (ADR-0098): DTLS 1.2 client-side handshake
// flight + Finished MAC + server-side R2 flight. Covers:
//
//   * ClientHello builder now emits a real 32-byte Random (populated
//     from secure_random or the deterministic test-mode override).
//   * All four server-flight parsers (ServerHello / Certificate / SKE /
//     ServerHelloDone) round-trip byte-exact against R1's builders.
//   * ClientKeyExchange parser round-trips against R2's CKE builder.
//   * CCS record builder emits a 14-byte wire record (13B DTLS header +
//     1B body=0x01) with content_type=20.
//   * Finished body builder returns 12B; matches PRF output for a
//     known transcript + master_secret; is_client=1 uses "client
//     finished" label; is_client=0 uses "server finished" label.
//   * DER-decode inverse of R1's DER-encode: encode + decode round-trip
//     recovers the original (r, s) bn256 pair.
//   * State-machine edges (client-side R29B chain untouched, terminates
//     cleanly at DTLS_S_ESTABLISHED).
//   * `gds_handshake_client` refuse path: bogus fd -> [0, state]
//     with last_err set and state at DTLS_S_FAILED.
//   * Slot indices pinned (52/53/54 for client_random_override /
//     hostname / anchors).
//
// Full end-to-end handshake round-trip (client + server converge on
// identical master_secret + reach DTLS_S_ESTABLISHED, then gds_send_line
// / gds_recv_line round-trip a plaintext "hello") requires a working
// socket-pair test harness plus the NOVA compiler to run tests. NOVA's
// compiler self-hosting bootstrap segfaults on this bench (standing
// Phase L / M / N / O / P caveat), so `make test` cannot exercise this
// suite. Verification is structural review + `make lint-ints` per the
// plan file. The tests below are byte-oriented unit checks that
// exercise each new function in isolation.

import "../ce_test.nova"
import "../../src/federation/dtls12.nova"
import "../../src/federation/gossip_dtls_shim.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/p256.nova"
import "../../src/safety/p256_keypair.nova"
import "../../src/safety/ecdsa.nova"
import "std/syscall"
import "std/string"
import "std/io"

// ---- helpers -------------------------------------------------------------

fn _mk_ramp32(start) {
    let buf = alloc(33)
    let i = 0
    while i < 32 {
        store8(buf + i, int_and(start + i, 255))
        i = i + 1
    }
    store8(buf + 32, 0)
    return buf
}

fn _fixed_ecdsa_keypair(seed_offset) {
    let seed = _mk_ramp32(seed_offset)
    return p256_keypair_generate_deterministic(seed)
}

fn _same_bytes(a, b, n) {
    let i = 0
    while i < n {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---- Fix #1: ClientHello Random populated from override ------------------

fn test_ch_builder_writes_override_random_to_wire() {
    let st = dtls_init()
    let override = _mk_ramp32(200)
    st[DTLS_S_SLOT_CLIENT_RANDOM_OVERRIDE] = override
    let pair = _dtls_build_client_hello_body(st)
    ce_check("no-ext CH body built", pair != 0)
    let buf = pair[0]
    // If secure_random succeeded, we won't see the override on the wire;
    // this test only asserts one of two invariants:
    //   1. slot 17 (CLIENT_RANDOM) is populated (non-zero), AND
    //   2. the bytes at wire[2..34] match slot 17 byte-for-byte.
    let cr_slot = st[DTLS_S_SLOT_CLIENT_RANDOM]
    ce_check("CLIENT_RANDOM slot populated after builder", cr_slot != 0)
    ce_eq("wire random matches CLIENT_RANDOM slot",
          _same_bytes(buf + 2, cr_slot, 32), 1)
}

fn test_ch_builder_populates_client_random_slot() {
    let st = dtls_init()
    ce_check("pre-build: CLIENT_RANDOM slot is 0",
             st[DTLS_S_SLOT_CLIENT_RANDOM] == 0)
    let pair = _dtls_build_client_hello_body(st)
    ce_check("post-build: CLIENT_RANDOM slot non-zero",
             st[DTLS_S_SLOT_CLIENT_RANDOM] != 0)
    ce_check("no-ext CH body built", pair != 0)
}

// ---- ServerHello parser round-trip --------------------------------------

fn test_sh_parser_roundtrip_no_ext() {
    let st = dtls_init()
    let sr = _mk_ramp32(50)
    let pair = _dtls_build_server_hello_body(
        st, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256, sr)
    let buf = pair[0]
    let n = pair[1]
    ce_eq("no-ext SH body is 38 bytes", n, 38)
    let parsed = _dtls_parse_server_hello_body(buf, n)
    ce_eq("SH parser accepts no-ext", parsed[0], 1)
    ce_eq("SH parser version", parsed[1], DTLS_VERSION_WORD)
    ce_eq("SH parser suite matches", parsed[4],
          DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256)
    ce_eq("SH parser compression = null", parsed[5], 0)
    ce_check("SH parser ext_pair is 0 for no-ext", parsed[6] == 0)
    // Random bytes byte-for-byte.
    let random = parsed[2]
    ce_eq("SH random[0]", load8(random + 0), int_and(50, 255))
    ce_eq("SH random[31]", load8(random + 31), int_and(50 + 31, 255))
}

fn test_sh_parser_roundtrip_with_srtp() {
    let st = dtls_init()
    dtls_offer_srtp(st, SRTP_PROFILE_AES128_CM_SHA1_80)
    let sr = _mk_ramp32(100)
    let pair = _dtls_build_server_hello_body(
        st, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256, sr)
    let n = pair[1]
    ce_eq("with-srtp SH body is 49 bytes", n, 49)
    let parsed = _dtls_parse_server_hello_body(pair[0], n)
    ce_eq("SH parser accepts with-srtp", parsed[0], 1)
    let ext_pair = parsed[6]
    ce_check("SH ext_pair non-zero", ext_pair != 0)
    ce_eq("SH ext_block_len = 9", ext_pair[1], 9)
}

fn test_sh_parser_rejects_short() {
    let buf = alloc(11)
    let i = 0
    while i < 10 { store8(buf + i, 0); i = i + 1 }
    store8(buf + 10, 0)
    let parsed = _dtls_parse_server_hello_body(buf, 10)
    ce_eq("SH short body rejected", parsed[0], 0)
}

fn test_sh_parser_rejects_wrong_suite() {
    let n = 38
    let buf = alloc(n + 1)
    _dtls_put_u16(buf, 0, DTLS_VERSION_WORD)
    let i = 0
    while i < 32 { store8(buf + 2 + i, 0); i = i + 1 }
    _dtls_put_u8(buf, 34, 0)         // sid_len
    _dtls_put_u16(buf, 35, 123)      // wrong suite
    _dtls_put_u8(buf, 37, 0)         // compr
    store8(buf + n, 0)
    let parsed = _dtls_parse_server_hello_body(buf, n)
    ce_eq("SH wrong-suite rejected", parsed[0], 0)
}

fn test_sh_parser_rejects_non_null_compr() {
    let n = 38
    let buf = alloc(n + 1)
    _dtls_put_u16(buf, 0, DTLS_VERSION_WORD)
    let i = 0
    while i < 32 { store8(buf + 2 + i, 0); i = i + 1 }
    _dtls_put_u8(buf, 34, 0)         // sid_len
    _dtls_put_u16(buf, 35, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256)
    _dtls_put_u8(buf, 37, 42)        // non-null compression
    store8(buf + n, 0)
    let parsed = _dtls_parse_server_hello_body(buf, n)
    ce_eq("SH non-null-compr rejected", parsed[0], 0)
}

// ---- Certificate parser round-trip --------------------------------------

fn test_cert_parser_roundtrip_one_cert() {
    let st = dtls_init()
    let cert = alloc(51)
    let i = 0
    while i < 50 { store8(cert + i, int_and(i, 255)); i = i + 1 }
    store8(cert + 50, 0)
    let entry = list_new()
    push(entry, cert); push(entry, 50)
    let chain = list_new()
    push(chain, entry)
    let built = _dtls_build_certificate_body(st, chain)
    let parsed = _dtls_parse_certificate_body(built[0], built[1])
    ce_eq("cert parser accepts one-cert", parsed[0], 1)
    ce_eq("cert parser recovers one cert", len(parsed[1]), 1)
    let recovered = parsed[1][0]
    ce_eq("recovered cert has 50 bytes", recovered[1], 50)
    ce_eq("recovered cert byte 0", load8(recovered[0] + 0), 0)
    ce_eq("recovered cert byte 25", load8(recovered[0] + 25), 25)
    ce_eq("recovered cert byte 49", load8(recovered[0] + 49), 49)
}

fn test_cert_parser_roundtrip_two_certs() {
    let st = dtls_init()
    let a = alloc(21)
    let b = alloc(31)
    let i = 0
    while i < 20 { store8(a + i, i); i = i + 1 }
    let j = 0
    while j < 30 { store8(b + j, 100 + j); j = j + 1 }
    store8(a + 20, 0); store8(b + 30, 0)
    let e1 = list_new()
    push(e1, a); push(e1, 20)
    let e2 = list_new()
    push(e2, b); push(e2, 30)
    let chain = list_new()
    push(chain, e1); push(chain, e2)
    let built = _dtls_build_certificate_body(st, chain)
    let parsed = _dtls_parse_certificate_body(built[0], built[1])
    ce_eq("cert parser accepts two-cert", parsed[0], 1)
    ce_eq("cert parser recovers 2 certs", len(parsed[1]), 2)
    ce_eq("cert[0].n = 20", parsed[1][0][1], 20)
    ce_eq("cert[1].n = 30", parsed[1][1][1], 30)
    ce_eq("cert[1].byte0 = 100", load8(parsed[1][1][0] + 0), 100)
}

fn test_cert_parser_rejects_overflow() {
    let buf = alloc(10)
    _dtls_put_u24(buf, 0, 1000)  // total_len = 1000 > buf
    let i = 3
    while i < 10 { store8(buf + i, 0); i = i + 1 }
    let parsed = _dtls_parse_certificate_body(buf, 10)
    ce_eq("cert overflow rejected", parsed[0], 0)
}

// ---- ServerKeyExchange parser round-trip --------------------------------

fn test_ske_parser_roundtrip() {
    let st = dtls_init()
    st[DTLS_S_SLOT_CLIENT_RANDOM] = _mk_ramp32(1)
    st[DTLS_S_SLOT_SERVER_RANDOM] = _mk_ramp32(101)
    let kp = _fixed_ecdsa_keypair(77)
    if kp == 0 {
        ce_check("keypair generator returned non-zero", 0 == 0)
        return 0
    }
    let priv_bn = kp[0]
    let pub_point = p256_encode_uncompressed(kp[1][0], kp[1][1])
    let built = _dtls_build_ske_body(st, 23, pub_point, priv_bn)
    ce_check("SKE built", built != 0)
    if built == 0 { return 0 }
    let parsed = _dtls_parse_ske_body(built[0], built[1])
    ce_eq("SKE parser accepts", parsed[0], 1)
    ce_eq("SKE curve_type = 3", parsed[1], 3)
    ce_eq("SKE curve_id = 23 (secp256r1)", parsed[2], 23)
    // sig_alg = 0x0403.
    ce_eq("SKE sig_alg = 0x0403", parsed[4], 1027)
    // Recovered pub_point bytes match the original 65 bytes.
    ce_eq("SKE pub_point recovered byte-for-byte",
          _same_bytes(pub_point, parsed[3], 65), 1)
}

fn test_ske_parser_rejects_wrong_curve_type() {
    let n = 4 + 65 + 4
    let buf = alloc(n + 1)
    _dtls_put_u8(buf, 0, 42)         // wrong curve_type
    _dtls_put_u16(buf, 1, 23)
    _dtls_put_u8(buf, 3, 65)
    store8(buf + n, 0)
    let parsed = _dtls_parse_ske_body(buf, n)
    ce_eq("SKE wrong curve_type rejected", parsed[0], 0)
}

fn test_ske_parser_rejects_wrong_curve_id() {
    let n = 4 + 65 + 4
    let buf = alloc(n + 1)
    _dtls_put_u8(buf, 0, 3)
    _dtls_put_u16(buf, 1, 42)        // wrong curve_id
    _dtls_put_u8(buf, 3, 65)
    store8(buf + n, 0)
    let parsed = _dtls_parse_ske_body(buf, n)
    ce_eq("SKE wrong curve_id rejected", parsed[0], 0)
}

fn test_ske_parser_rejects_wrong_point_len() {
    let n = 4 + 65 + 4
    let buf = alloc(n + 1)
    _dtls_put_u8(buf, 0, 3)
    _dtls_put_u16(buf, 1, 23)
    _dtls_put_u8(buf, 3, 33)         // wrong point_len
    store8(buf + n, 0)
    let parsed = _dtls_parse_ske_body(buf, n)
    ce_eq("SKE wrong point_len rejected", parsed[0], 0)
}

// ---- ServerHelloDone parser ---------------------------------------------

fn test_shd_parser_accepts_empty() {
    let buf = alloc(1)
    store8(buf, 0)
    let parsed = _dtls_parse_server_hello_done_body(buf, 0)
    ce_eq("SHD empty accepted", parsed[0], 1)
}

fn test_shd_parser_rejects_nonempty() {
    let buf = alloc(2)
    store8(buf, 42)
    store8(buf + 1, 0)
    let parsed = _dtls_parse_server_hello_done_body(buf, 1)
    ce_eq("SHD non-empty rejected", parsed[0], 0)
}

// ---- ClientKeyExchange builder + parser round-trip ----------------------

fn test_cke_builder_shape() {
    let st = dtls_init()
    let point = alloc(66)
    let i = 0
    while i < 65 { store8(point + i, int_and(i + 20, 255)); i = i + 1 }
    store8(point + 65, 0)
    let pair = _dtls_build_client_key_exchange_body(st, point)
    ce_eq("CKE body is 66 bytes", pair[1], 66)
    ce_eq("CKE point_len byte = 65", load8(pair[0] + 0), 65)
    ce_eq("CKE point byte 0", load8(pair[0] + 1), 20)
    ce_eq("CKE point byte 64", load8(pair[0] + 65), int_and(20 + 64, 255))
}

fn test_cke_parser_roundtrip() {
    let st = dtls_init()
    let point = alloc(66)
    let i = 0
    while i < 65 { store8(point + i, int_and(i * 3, 255)); i = i + 1 }
    store8(point + 65, 0)
    let built = _dtls_build_client_key_exchange_body(st, point)
    let parsed = _dtls_parse_client_key_exchange_body(built[0], built[1])
    ce_eq("CKE parser accepts", parsed[0], 1)
    ce_eq("CKE recovered point matches",
          _same_bytes(point, parsed[1], 65), 1)
}

fn test_cke_parser_rejects_wrong_len() {
    let buf = alloc(3)
    _dtls_put_u8(buf, 0, 33)         // wrong point_len
    store8(buf + 1, 0); store8(buf + 2, 0)
    let parsed = _dtls_parse_client_key_exchange_body(buf, 1)
    ce_eq("CKE wrong point_len rejected", parsed[0], 0)
}

// ---- ChangeCipherSpec record builder ------------------------------------

fn test_ccs_record_shape() {
    let st = dtls_init()
    let rec = _dtls_build_change_cipher_spec_record(st)
    ce_check("CCS record built", rec != 0)
    // Record = 13B DTLS header + 1B body.
    ce_eq("CCS record total = 14 bytes", rec[1], 14)
    // content_type=20 (DTLS_CT_CCS).
    ce_eq("CCS content_type = 20", load8(rec[0] + 0), 20)
    // length field at offset 11 = 1.
    ce_eq("CCS body_len hi = 0", load8(rec[0] + 11), 0)
    ce_eq("CCS body_len lo = 1", load8(rec[0] + 12), 1)
    // body byte = 0x01.
    ce_eq("CCS body = 0x01", load8(rec[0] + 13), 1)
}

// ---- Finished body builder ----------------------------------------------

fn test_finished_body_shape_client() {
    let st = dtls_init()
    // Populate master_secret + init transcript with a known message.
    let ms = alloc(49)
    let i = 0
    while i < 48 { store8(ms + i, i); i = i + 1 }
    store8(ms + 48, 0)
    st[DTLS_S_SLOT_MASTER_SECRET] = ms
    dtls_transcript_init(st)
    let msg = alloc(11)
    let j = 0
    while j < 10 { store8(msg + j, 42); j = j + 1 }
    store8(msg + 10, 0)
    dtls_transcript_absorb(st, msg, 10)
    let pair = _dtls_build_finished_body(st, 1)
    ce_check("Finished body built", pair != 0)
    ce_eq("Finished body is 12 bytes", pair[1], 12)
}

fn test_finished_body_matches_prf_client() {
    let st = dtls_init()
    let ms = alloc(49)
    let i = 0
    while i < 48 { store8(ms + i, i); i = i + 1 }
    store8(ms + 48, 0)
    st[DTLS_S_SLOT_MASTER_SECRET] = ms
    dtls_transcript_init(st)
    let msg = alloc(11)
    let j = 0
    while j < 10 { store8(msg + j, 42); j = j + 1 }
    store8(msg + 10, 0)
    dtls_transcript_absorb(st, msg, 10)
    let got = _dtls_build_finished_body(st, 1)
    // Compute expected: PRF(ms, "client finished",
    //                       sha256(msg), 12).
    let h = sha256_oneshot(msg, 10)
    let expected = dtls_prf_sha256(ms, 48, "client finished", h, 32, 12)
    ce_eq("Finished body matches PRF (client)",
          _same_bytes(got[0], expected, 12), 1)
}

fn test_finished_body_matches_prf_server() {
    let st = dtls_init()
    let ms = alloc(49)
    let i = 0
    while i < 48 { store8(ms + i, int_and(i + 5, 255)); i = i + 1 }
    store8(ms + 48, 0)
    st[DTLS_S_SLOT_MASTER_SECRET] = ms
    dtls_transcript_init(st)
    let msg = alloc(21)
    let j = 0
    while j < 20 { store8(msg + j, int_and(j + 100, 255)); j = j + 1 }
    store8(msg + 20, 0)
    dtls_transcript_absorb(st, msg, 20)
    let got = _dtls_build_finished_body(st, 0)
    let h = sha256_oneshot(msg, 20)
    let expected = dtls_prf_sha256(ms, 48, "server finished", h, 32, 12)
    ce_eq("Finished body matches PRF (server)",
          _same_bytes(got[0], expected, 12), 1)
}

fn test_finished_body_labels_differ() {
    // Same inputs, different is_client -> different verify_data.
    let st = dtls_init()
    let ms = alloc(49)
    let i = 0
    while i < 48 { store8(ms + i, 7); i = i + 1 }
    store8(ms + 48, 0)
    st[DTLS_S_SLOT_MASTER_SECRET] = ms
    dtls_transcript_init(st)
    let msg = alloc(5)
    let j = 0
    while j < 4 { store8(msg + j, j); j = j + 1 }
    store8(msg + 4, 0)
    dtls_transcript_absorb(st, msg, 4)
    let cli = _dtls_build_finished_body(st, 1)
    let srv = _dtls_build_finished_body(st, 0)
    ce_check("client vs server verify_data differ",
             _same_bytes(cli[0], srv[0], 12) == 0)
}

fn test_finished_body_rejects_no_master_secret() {
    let st = dtls_init()
    dtls_transcript_init(st)
    let pair = _dtls_build_finished_body(st, 1)
    ce_check("Finished refused without master_secret", pair == 0)
}

// ---- DER-encode + DER-decode round-trip ---------------------------------

fn test_der_ecdsa_roundtrip() {
    let kp = _fixed_ecdsa_keypair(88)
    if kp == 0 {
        ce_check("keypair non-zero", 0 == 0)
        return 0
    }
    // Sign a fixed hash to get (r, s).
    let msg = _mk_ramp32(33)
    let sig = _dtls_ecdsa_p256_sign(msg, 32, kp[0])
    if sig == 0 {
        ce_check("sign returned non-zero", 0 == 0)
        return 0
    }
    let r_bn = sig[0]
    let s_bn = sig[1]
    let der = _dtls_der_encode_ecdsa_sig(r_bn, s_bn)
    ce_check("DER encode returned non-zero", der != 0)
    let decoded = _dtls_der_decode_ecdsa_sig(der[0], der[1])
    ce_check("DER decode returned non-zero", decoded != 0)
    // The two bn256 should be equal.
    ce_eq("decoded r matches original", bn256_eq(decoded[0], r_bn), 1)
    ce_eq("decoded s matches original", bn256_eq(decoded[1], s_bn), 1)
}

fn test_der_decode_rejects_bad_tag() {
    // 0x00 outer tag (should be 0x30).
    let buf = alloc(10)
    store8(buf, 0)
    store8(buf + 1, 6)
    let i = 2
    while i < 10 { store8(buf + i, 0); i = i + 1 }
    let r = _dtls_der_decode_ecdsa_sig(buf, 8)
    ce_check("DER decode refuses bad outer tag", r == 0)
}

// ---- gds_handshake_client refuse path ------------------------------------

fn test_client_flight_bad_fd_returns_failed() {
    let anchors = list_new()
    let r = gds_handshake_client(0 - 1, 0, 0, 0, "example.com", anchors, 0)
    ce_eq("bogus-fd -> [0, state]", r[0], 0)
    ce_eq("state at FAILED",
          dtls_state_get(r[1]), DTLS_S_FAILED)
    // last_err should be a non-empty string of our diagnostic tags.
    let err = dtls_last_error(r[1])
    ce_check("last_err populated", err != "")
}

// ---- Cert-verify hook: state slots wired --------------------------------

fn test_client_flight_writes_hostname_anchors_to_state() {
    let anchors = list_new()
    // Call with a bogus fd so the flight fails quickly; but the slot
    // assignments happen up front, so we can inspect them.
    let r = gds_handshake_client(0 - 1, 0, 0, 0, "example.com", anchors, 42)
    let st = r[1]
    ce_str_eq("hostname slot populated",
              dtls_hostname(st), "example.com")
    ce_check("anchors slot populated", dtls_anchors(st) != 0)
    ce_eq("current_time_unix slot populated",
          dtls_current_time(st), 42)
}

// ---- Slot indices pinned ------------------------------------------------

fn test_r2_slot_indices_pinned() {
    ce_eq("CLIENT_RANDOM_OVERRIDE slot = 52",
          DTLS_S_SLOT_CLIENT_RANDOM_OVERRIDE, 52)
    ce_eq("HOSTNAME slot = 53", DTLS_S_SLOT_HOSTNAME, 53)
    ce_eq("ANCHORS slot = 54", DTLS_S_SLOT_ANCHORS, 54)
}

// ---- Client-side state chain: still valid ------------------------------

fn test_client_state_chain_still_valid() {
    // The R29B client-side chain must still terminate cleanly.
    ce_eq("INIT -> CHS",
          _dtls_valid_edge(DTLS_S_INIT, DTLS_S_CLIENT_HELLO_SENT), 1)
    ce_eq("CHS -> SHR",
          _dtls_valid_edge(DTLS_S_CLIENT_HELLO_SENT, DTLS_S_SERVER_HELLO_RECVD), 1)
    ce_eq("SHR -> CR",
          _dtls_valid_edge(DTLS_S_SERVER_HELLO_RECVD, DTLS_S_CERTIFICATE_RECVD), 1)
    ce_eq("CR -> FIN",
          _dtls_valid_edge(DTLS_S_CERTIFICATE_RECVD, DTLS_S_FINISHED), 1)
    ce_eq("FIN -> EST",
          _dtls_valid_edge(DTLS_S_FINISHED, DTLS_S_ESTABLISHED), 1)
    // FAILED reachable from every state.
    ce_eq("EST -> FAILED",
          _dtls_valid_edge(DTLS_S_ESTABLISHED, DTLS_S_FAILED), 1)
}

// ---- CCS builder increments record counters -----------------------------

fn test_ccs_builder_bumps_records_out() {
    let st = dtls_init()
    let n0 = st[DTLS_S_SLOT_RECORDS_OUT]
    let rec = _dtls_build_change_cipher_spec_record(st)
    ce_check("CCS record built", rec != 0)
    let n1 = st[DTLS_S_SLOT_RECORDS_OUT]
    ce_eq("records_out bumped by 1", n1 - n0, 1)
}

// ---- SKE parser recovers a wire-conformant sig -------------------------

fn test_ske_parser_sig_verifies() {
    let st = dtls_init()
    st[DTLS_S_SLOT_CLIENT_RANDOM] = _mk_ramp32(11)
    st[DTLS_S_SLOT_SERVER_RANDOM] = _mk_ramp32(111)
    let kp = _fixed_ecdsa_keypair(55)
    if kp == 0 {
        ce_check("keypair non-zero", 0 == 0)
        return 0
    }
    let priv_bn = kp[0]
    let pub_point = p256_encode_uncompressed(kp[1][0], kp[1][1])
    let built = _dtls_build_ske_body(st, 23, pub_point, priv_bn)
    if built == 0 {
        ce_check("SKE built non-zero", 0 == 0)
        return 0
    }
    let parsed = _dtls_parse_ske_body(built[0], built[1])
    if parsed[0] == 0 {
        ce_check("SKE parser succeeds", 0 == 0)
        return 0
    }
    // Reconstruct signed message: cr || sr || (curve_type(1) + curve_id(2) +
    // point_len(1) + point(65)) = 32 + 32 + 69 = 133 bytes.
    let cr = st[DTLS_S_SLOT_CLIENT_RANDOM]
    let sr = st[DTLS_S_SLOT_SERVER_RANDOM]
    let msg = alloc(134)
    let i = 0
    while i < 32 {
        store8(msg + i, load8(cr + i))
        store8(msg + 32 + i, load8(sr + i))
        i = i + 1
    }
    store8(msg + 64, 3)                          // curve_type
    _dtls_put_u16(msg, 65, 23)                   // curve_id
    store8(msg + 67, 65)                         // point_len
    let k = 0
    while k < 65 {
        store8(msg + 68 + k, load8(pub_point + k))
        k = k + 1
    }
    store8(msg + 133, 0)
    let h = sha256_oneshot(msg, 133)
    let hbn = _p256_bytes_to_bn(h, 0)
    let rs = _dtls_der_decode_ecdsa_sig(parsed[5][0], parsed[5][1])
    if rs == 0 {
        ce_check("DER decode succeeds", 0 == 0)
        return 0
    }
    let ok = ecdsa_p256_verify_bn(pub_point, 65, hbn, rs[0], rs[1])
    ce_eq("SKE sig verifies via parser-recovered DER", ok, 1)
}

// ---- entry point ---------------------------------------------------------

fn main() {
    test_ch_builder_writes_override_random_to_wire()
    test_ch_builder_populates_client_random_slot()

    test_sh_parser_roundtrip_no_ext()
    test_sh_parser_roundtrip_with_srtp()
    test_sh_parser_rejects_short()
    test_sh_parser_rejects_wrong_suite()
    test_sh_parser_rejects_non_null_compr()

    test_cert_parser_roundtrip_one_cert()
    test_cert_parser_roundtrip_two_certs()
    test_cert_parser_rejects_overflow()

    test_ske_parser_roundtrip()
    test_ske_parser_rejects_wrong_curve_type()
    test_ske_parser_rejects_wrong_curve_id()
    test_ske_parser_rejects_wrong_point_len()

    test_shd_parser_accepts_empty()
    test_shd_parser_rejects_nonempty()

    test_cke_builder_shape()
    test_cke_parser_roundtrip()
    test_cke_parser_rejects_wrong_len()

    test_ccs_record_shape()
    test_ccs_builder_bumps_records_out()

    test_finished_body_shape_client()
    test_finished_body_matches_prf_client()
    test_finished_body_matches_prf_server()
    test_finished_body_labels_differ()
    test_finished_body_rejects_no_master_secret()

    test_der_ecdsa_roundtrip()
    test_der_decode_rejects_bad_tag()

    test_client_flight_bad_fd_returns_failed()
    test_client_flight_writes_hostname_anchors_to_state()

    test_r2_slot_indices_pinned()
    test_client_state_chain_still_valid()

    test_ske_parser_sig_verifies()

    ce_summary("test_dtls_client_flight")
    return 0
}
