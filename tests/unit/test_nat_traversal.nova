// Unit tests for src/federation/nat_traversal.nova (R23E).
//
// Coverage (~33 assertions): STUN parse + format, sockaddr_in
// extraction, peer table set/get/update, local addrs enumeration,
// NAT type heuristic (cone/symmetric/open/blocked), hole-punch stub,
// inbound EXTADDR plumbing, status line.

import "../ce_test.nova"
import "../../src/federation/nat_traversal.nova"

// ---- nat_init -----------------------------------------------------------

fn test_init_state_empty() {
    let st = nat_init()
    ce_str_eq("fresh external addr empty", nat_get_external(st), "")
    ce_str_eq("fresh type empty", nat_get_type(st), "")
    ce_eq("fresh query count 0", nat_query_count(st), 0)
    ce_eq("fresh query_ok count 0", nat_query_ok_count(st), 0)
    ce_eq("fresh advert count 0", nat_advertise_count(st), 0)
    ce_eq("fresh inbound_ad count 0", nat_inbound_ad_count(st), 0)
    ce_eq("fresh peer count 0", nat_peer_count(st), 0)
}

// ---- STUN response parse -----------------------------------------------

fn test_parse_stun_response_well_formed() {
    let addr = nat_parse_stun_response("EXTERNAL 1.2.3.4:5678\n")
    ce_check("well-formed parse returns non-zero", addr != 0)
    ce_str_eq("parsed addr exact", addr, "1.2.3.4:5678")
}

fn test_parse_stun_response_no_trailing_newline() {
    let addr = nat_parse_stun_response("EXTERNAL 10.0.0.1:8080")
    ce_str_eq("no-newline parse works", addr, "10.0.0.1:8080")
}

fn test_parse_stun_response_with_cr() {
    let addr = nat_parse_stun_response("EXTERNAL 10.0.0.1:8080\r\n")
    ce_str_eq("CRLF stripped", addr, "10.0.0.1:8080")
}

fn test_parse_stun_response_wrong_prefix() {
    ce_eq("wrong prefix -> 0", nat_parse_stun_response("EXT 1.2.3.4:5678\n"), 0)
}

fn test_parse_stun_response_missing_port() {
    ce_eq("missing port -> 0", nat_parse_stun_response("EXTERNAL 1.2.3.4\n"), 0)
}

fn test_parse_stun_response_non_numeric_port() {
    ce_eq("non-numeric port -> 0", nat_parse_stun_response("EXTERNAL 1.2.3.4:abc\n"), 0)
}

fn test_parse_stun_response_bad_ip() {
    ce_eq("non-IP host -> 0", nat_parse_stun_response("EXTERNAL not-an-ip:8080\n"), 0)
}

fn test_parse_stun_response_octet_over_255() {
    ce_eq("octet > 255 -> 0", nat_parse_stun_response("EXTERNAL 256.0.0.1:80\n"), 0)
}

fn test_parse_stun_response_empty() {
    ce_eq("empty input -> 0", nat_parse_stun_response(""), 0)
}

// ---- STUN response format ----------------------------------------------

fn test_format_stun_response() {
    let s = nat_format_stun_response("192.168.1.5", 5000)
    ce_str_eq("format round-trip", s, "EXTERNAL 192.168.1.5:5000")
}

// ---- sockaddr_in peer-addr extraction ----------------------------------

fn test_extract_peer_addr_loopback_with_port() {
    let buf = nat_alloc_sa_buf()
    store8(buf + 0, 2)
    store8(buf + 1, 0)
    store8(buf + 2, 195)
    store8(buf + 3, 80)
    store8(buf + 4, 127)
    store8(buf + 5, 0)
    store8(buf + 6, 0)
    store8(buf + 7, 1)
    let parsed = nat_extract_peer_addr(buf)
    ce_check("extract returned non-zero", parsed != 0)
    ce_str_eq("IP parsed as 127.0.0.1", parsed[0], "127.0.0.1")
    ce_eq("port parsed as 50000", parsed[1], 50000)
}

fn test_extract_peer_addr_rejects_non_inet() {
    let buf = nat_alloc_sa_buf()
    store8(buf + 0, 10)
    store8(buf + 1, 0)
    ce_eq("non-AF_INET extract -> 0", nat_extract_peer_addr(buf), 0)
}

// ---- peer external-addr table -----------------------------------------

fn test_set_get_peer_external() {
    let st = nat_init()
    nat_set_peer_external(st, "10.0.0.1:8770", "203.0.113.1:5000")
    ce_str_eq("get returns set value",
              nat_get_peer_external(st, "10.0.0.1:8770"),
              "203.0.113.1:5000")
    ce_eq("peer count is 1", nat_peer_count(st), 1)
}

fn test_set_peer_external_update_overwrites() {
    let st = nat_init()
    nat_set_peer_external(st, "10.0.0.1:8770", "203.0.113.1:5000")
    nat_set_peer_external(st, "10.0.0.1:8770", "203.0.113.99:5099")
    ce_str_eq("update overwrites",
              nat_get_peer_external(st, "10.0.0.1:8770"),
              "203.0.113.99:5099")
    ce_eq("peer count still 1", nat_peer_count(st), 1)
}

fn test_get_peer_external_unknown_returns_empty() {
    let st = nat_init()
    ce_str_eq("unknown peer -> empty string",
              nat_get_peer_external(st, "10.0.0.99:8770"),
              "")
}

fn test_nat_peer_external_addrs_returns_table() {
    let st = nat_init()
    nat_set_peer_external(st, "10.0.0.1:8770", "203.0.113.1:5000")
    nat_set_peer_external(st, "10.0.0.2:8770", "203.0.113.2:5001")
    let tbl = nat_peer_external_addrs(st)
    ce_eq("table has 2 entries", len(tbl), 2)
    ce_str_eq("entry 0 internal", tbl[0][0], "10.0.0.1:8770")
    ce_str_eq("entry 0 external", tbl[0][1], "203.0.113.1:5000")
}

// ---- local addr enumeration -------------------------------------------

fn test_local_addrs_nonempty() {
    ce_check("local addrs nonempty", len(nat_local_addrs()) >= 1)
}

fn test_local_addrs_contains_loopback() {
    let locals = nat_local_addrs()
    let found = 0
    let i = 0
    while i < len(locals) {
        if str_eq(locals[i], "127.0.0.1") == 1 { found = 1 }
        i = i + 1
    }
    ce_eq("contains 127.0.0.1", found, 1)
}

