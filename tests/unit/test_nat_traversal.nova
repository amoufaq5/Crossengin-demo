// ---- status line ------------------------------------------------------

fn test_status_line_fresh_state() {
    let st = nat_init()
    let s = nat_status_line(st)
    ce_check("status mentions unknown ext", str_has(s, "external=<unknown>") == 1)
    ce_check("status mentions undetected type", str_has(s, "type=<undetected>") == 1)
}

fn test_status_line_with_data() {
    let st = nat_init()
    nat_set_external(st, "203.0.113.1:50000")
    nat_set_type(st, NAT_TYPE_CONE)
    nat_set_peer_external(st, "10.0.0.1:8770", "203.0.113.99:5099")
    let s = nat_status_line(st)
    ce_check("status mentions ext addr", str_has(s, "external=203.0.113.1:50000") == 1)
    ce_check("status mentions cone type", str_has(s, "type=cone") == 1)
    ce_check("status mentions peers=1", str_has(s, "peers=1") == 1)
}

fn str_has(hay, needle) {
    let n = len(needle)
    let m = len(hay)
    if n == 0 { return 1 }
    if m < n { return 0 }
    let i = 0
    while i <= m - n {
        let hit = 1
        let j = 0
        while j < n {
            if char_at(hay, i + j) != char_at(needle, j) { hit = 0; j = n }
            j = j + 1
        }
        if hit == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ============================================================================
// R31C / R30C.2 -- RFC 8489 STUN wire migration tests
//
// These verify that:
//   1. The legacy STUN-LIKE text wire is preserved (helpers exist
//      under the nat_legacy_* names + the original names).
//   2. The new wire emits an RFC 8489 Binding Request that
//      `stun_msg_parse` (R30C) accepts as well-formed.
//   3. FINGERPRINT + MESSAGE-INTEGRITY emit on the new wire and
//      `stun_verify_fingerprint` / `stun_verify_message_integrity`
//      both verify.
//   4. The high-level `nat_send_binding_request` /
//      `nat_recv_binding_response` round-trip a Binding Request
//      against a hand-built Binding Success Response: the mapped
//      IP+port flow back into `NAT_S_MY_EXTERNAL`.
//   5. The env flag `CE_NAT_USE_RFC8489` controls
//      `nat_use_rfc8489_enabled()`.
//   6. Stats counters bump correctly on send + recv (RFC and legacy
//      paths share NAT_S_QUERIES + NAT_S_QUERIES_OK).
//   7. A bad packet (short / no XOR-MAPPED-ADDRESS) bumps NAT_S_RFC_BAD
//      and does NOT mutate NAT_S_MY_EXTERNAL.

// ---- legacy-compat helpers --------------------------------------------

fn test_r31c_legacy_emit_request_matches_old_wire() {
    let req = nat_legacy_emit_stunlike_request()
    ce_str_eq("legacy emit produces STUN_REQUEST\\n",
              req, "STUN_REQUEST\n")
}

fn test_r31c_legacy_format_response_matches_old_wire() {
    let line = nat_legacy_format_stunlike_response("203.0.113.7", 4000)
    ce_str_eq("legacy format response shape",
              line, "EXTERNAL 203.0.113.7:4000\n")
}

fn test_r31c_legacy_parse_round_trip() {
    let line = nat_legacy_format_stunlike_response("198.51.100.1", 33444)
    let parsed = nat_legacy_parse_stunlike_response(line)
    ce_str_eq("legacy parse round-trip", parsed, "198.51.100.1:33444")
}

// ---- env flag ---------------------------------------------------------

fn test_r31c_env_flag_default_off() {
    // CE_NAT_USE_RFC8489 not in env: 0
    ce_eq("default env flag is off", nat_use_rfc8489_enabled(), 0)
}

// ---- RFC 8489 emit + parse against stun_rfc8489 ----------------------

fn test_r31c_emit_request_parses_as_rfc8489() {
    let st = nat_init()
    let result = nat_emit_rfc8489_binding_request(st, "crossengin/r31c")
    let pkt = result[0]
    let n = result[1]
    ce_check("emit returned a buf", pkt != 0)
    ce_check("emit returned positive length", n >= 20)
    // Header parse must succeed and identify a Binding Request.
    let parsed = stun_msg_parse(pkt, n)
    ce_check("packet parses as RFC 8489 (not error tag)",
             str_eq(parsed, STUN_ERR_BAD_HEADER) == 0)
    ce_eq("emit type = Binding Request",
          stun_msg_get_type(pkt), STUN_TYPE_BINDING_REQUEST)
    ce_eq("emit cookie = 0x2112A442",
          stun_msg_get_cookie(pkt), STUN_MAGIC_COOKIE)
    // RFC 8489 14.7: FINGERPRINT must verify on emitted requests.
    ce_eq("emit FINGERPRINT verifies",
          stun_verify_fingerprint(pkt, n), 1)
}

fn test_r31c_emit_request_with_credentials_has_mi() {
    let st = nat_init()
    nat_set_rfc8489_credentials(st, "alice", "secretpass")
    let result = nat_emit_rfc8489_binding_request(st, "crossengin/r31c")
    let pkt = result[0]
    let n = result[1]
    ce_eq("emit with creds MI verifies (right pwd)",
          stun_verify_message_integrity(pkt, n, "secretpass"), 1)
    ce_eq("emit with creds MI rejects wrong pwd",
          stun_verify_message_integrity(pkt, n, "wrong"), 0)
    ce_eq("emit with creds FINGERPRINT verifies",
          stun_verify_fingerprint(pkt, n), 1)
}

fn test_r31c_emit_request_bumps_rfc_counter() {
    let st = nat_init()
    nat_emit_rfc8489_binding_request(st, "ce")
    nat_emit_rfc8489_binding_request(st, "ce")
    ce_eq("RFC requests counter advanced", nat_rfc8489_requests_sent(st), 2)
}

// ---- send_binding_request high-level wrapper -------------------------

fn test_r31c_send_binding_request_validates_addr() {
    let st = nat_init()
    let bad = nat_send_binding_request(st, "not-an-addr", "ce")
    ce_eq("send with bad addr returns 0", bad, 0)
    ce_str_eq("bad addr sets last_error",
              nat_last_error(st), "bad-remote-addr")
    ce_eq("bad addr does NOT bump queries counter",
          nat_query_count(st), 0)
}

fn test_r31c_send_binding_request_good_addr() {
    let st = nat_init()
    let res = nat_send_binding_request(st, "203.0.113.5:3478", "ce")
    ce_check("send with good addr returns list", res != 0)
    ce_eq("send bumps NAT_S_QUERIES", nat_query_count(st), 1)
    ce_eq("send bumps NAT_S_RFC_REQUESTS",
          nat_rfc8489_requests_sent(st), 1)
    // The emitted packet must be parseable by stun_rfc8489.
    let pkt = res[0]
    let n = res[1]
    ce_eq("sent request type = Binding Request",
          stun_msg_get_type(pkt), STUN_TYPE_BINDING_REQUEST)
    ce_eq("sent request FP verifies",
          stun_verify_fingerprint(pkt, n), 1)
}

// ---- recv_binding_response: round-trip a hand-built success response ----

fn test_r31c_recv_binding_response_round_trip_ipv4() {
    let st = nat_init()
    // Drive the send first to record a pending txn id.
    let sent = nat_send_binding_request(st, "203.0.113.5:3478", "ce")
    let pkt_req = sent[0]
    let n_req = sent[1]
    let txn_id = sent[2]
    // Build a Binding Success Response with XOR-MAPPED 203.0.113.99:54321.
    let v4 = stun_ipv4_str_to_buf("203.0.113.99")
    let resp = stun_msg_build_success_response_ipv4(txn_id, v4, 54321,
                                                    "server", "", "", 1)
    let pkt_resp = resp[0]
    let n_resp = resp[1]
    // Sanity: the resp itself parses + FP verifies.
    ce_eq("resp FP verifies", stun_verify_fingerprint(pkt_resp, n_resp), 1)
    // Now feed it through nat_recv_binding_response.
    let ok = nat_recv_binding_response(st, pkt_resp, n_resp)
    ce_eq("recv returns 1 on success", ok, 1)
    ce_str_eq("recv mapped NAT_S_MY_EXTERNAL slot",
              nat_get_external(st), "203.0.113.99:54321")
    ce_eq("recv bumps NAT_S_QUERIES_OK", nat_query_ok_count(st), 1)
    ce_eq("recv bumps NAT_S_RFC_OK", nat_rfc8489_responses_ok(st), 1)
    ce_str_eq("recv clears last_error", nat_last_error(st), "")
}

// ---- nat_parse_rfc8489_binding_response: same flow, returns the triple ---

fn test_r31c_parse_rfc8489_returns_triple() {
    let st = nat_init()
    let sent = nat_send_binding_request(st, "203.0.113.5:3478", "ce")
    let txn_id = sent[2]
    let v4 = stun_ipv4_str_to_buf("192.0.2.100")
    let resp = stun_msg_build_success_response_ipv4(txn_id, v4, 9999,
                                                    "", "", "", 1)
    let triple = nat_parse_rfc8489_binding_response(st, resp[0], resp[1])
    ce_check("triple is non-zero", triple != 0)
    ce_str_eq("triple ip", triple[0], "192.0.2.100")
    ce_eq("triple port", triple[1], 9999)
    ce_eq("triple family = IPv4", triple[2], STUN_FAMILY_IPV4)
}

// ---- bad packet path -------------------------------------------------

fn test_r31c_recv_bad_packet_bumps_bad_counter() {
    let st = nat_init()
    // 8 bytes is too short to be a STUN header.
    let buf = alloc(9)
    let i = 0
    while i < 8 { store8(buf + i, 0); i = i + 1 }
    store8(buf + 8, 0)
    let ok = nat_recv_binding_response(st, buf, 8)
    ce_eq("recv on short pkt returns 0", ok, 0)
    ce_eq("recv on short pkt bumps NAT_S_RFC_BAD",
          nat_rfc8489_responses_bad(st), 1)
    ce_str_eq("short pkt leaves external unset",
              nat_get_external(st), "")
}

fn test_r31c_recv_zero_buf_returns_zero() {
    let st = nat_init()
    ce_eq("recv with 0 buf returns 0",
          nat_recv_binding_response(st, 0, 100), 0)
    ce_eq("recv with 0 len returns 0",
          nat_recv_binding_response(st, 1, 0), 0)
}

// ---- nat_format_rfc8489_success_response_ipv4 -------------------------

fn test_r31c_format_success_response_ipv4() {
    let st = nat_init()
    let sent = nat_send_binding_request(st, "203.0.113.5:3478", "ce")
    let txn = sent[2]
    let resp = nat_format_rfc8489_success_response_ipv4(txn, "10.0.0.5", 1234,
                                                        "server", "", "")
    ce_check("format returned list", resp != 0)
    let buf = resp[0]
    let n = resp[1]
    ce_eq("response type = Binding Success",
          stun_msg_get_type(buf), STUN_TYPE_BINDING_SUCCESS_RESPONSE)
    ce_eq("response cookie", stun_msg_get_cookie(buf),
          STUN_MAGIC_COOKIE)
    ce_eq("response FP verifies", stun_verify_fingerprint(buf, n), 1)
}

fn test_r31c_format_success_response_rejects_bad_ip() {
    let st = nat_init()
    let sent = nat_send_binding_request(st, "203.0.113.5:3478", "ce")
    let txn = sent[2]
    ce_eq("format with bad IP returns 0",
          nat_format_rfc8489_success_response_ipv4(txn, "999.0.0.1", 80,
                                                    "", "", ""), 0)
}

// ---- nat_rfc8489_state lazy alloc + idempotent ----------------------

fn test_r31c_rfc8489_state_lazy_idempotent() {
    let st = nat_init()
    ce_eq("fresh state has no stun_state",
          st[NAT_S_STUN_STATE], 0)
    let s1 = nat_rfc8489_state(st)
    ce_check("lazy alloc returns non-zero", s1 != 0)
    let s2 = nat_rfc8489_state(st)
    ce_check("second call returns same handle", s1 == s2)
}

// ---- stats accessors guard against 0-state -------------------------

fn test_r31c_stats_accessors_guard_zero_state() {
    ce_eq("rfc_requests on 0 state -> 0",
          nat_rfc8489_requests_sent(0), 0)
    ce_eq("rfc_ok on 0 state -> 0",
          nat_rfc8489_responses_ok(0), 0)
    ce_eq("rfc_bad on 0 state -> 0",
          nat_rfc8489_responses_bad(0), 0)
}

// ============================================================================
// R32A / R31C.2 / R28C consumer -- UDP datagram dispatch tests
//
// What's covered (24 new assertions):
//   1. Stats accessors (sent/recvd/timeouts) return 0 on fresh state +
//      0 on 0-state.
//   2. Env timeout default = 1000ms.
//   3. nat_udp_open returns a non-negative fd on native targets and -1
//      on stub targets (handled by branching the assertion).
//   4. With env flag default off, nat_query_stun_with_state still
//      walks the TCP text path -- specifically: a dial to a closed
//      port produces dial-failed (not a UDP path error).
//   5. UDP loopback round-trip: client sends Binding Request via
//      `nat_udp_send_binding_request_at`; responder receives raw
//      datagram, builds a Binding Success Response with the matching
//      txn id via R30C, sends it back; client `nat_udp_recv_binding_
//      response` returns 1 and external addr matches.
//   6. UDP timeout: an unbound socket with no inbound datagram
//      returns 0 from recv, bumps NAT_S_UDP_TIMEOUTS, sets
//      nat_last_error to "udp-timeout", does not corrupt NAT_S_MY_EXTERNAL.
//   7. Counters: SENT increments on dispatch; RECVD on successful
//      parse; TIMEOUTS on recv timeout. Counters do NOT bump on bad
//      addr / bad fd.
//
// Test strategy notes:
//   * Sandbox UDP availability is probed via `sys_socket_udp()`. On
//     stub targets the round-trip and timeout tests are skipped (sock
//     creation returns -1) but the stats / accessor / env / bad-addr
//     assertions all still run.
//   * The round-trip plays both sides in one process by binding the
//     responder to a fixed loopback port and sequencing send -> recv
//     -> respond -> recv. This is reliable because UDP sockets queue
//     datagrams; we never block more than `timeout_ms` per recv.

// ---- stats accessors -------------------------------------------------

fn test_r32a_udp_stats_accessors_zero_state() {
    ce_eq("udp_sent on 0 state -> 0", nat_udp_sent_count(0), 0)
    ce_eq("udp_recvd on 0 state -> 0", nat_udp_recvd_count(0), 0)
    ce_eq("udp_timeouts on 0 state -> 0", nat_udp_timeout_count(0), 0)
}

fn test_r32a_udp_stats_accessors_fresh_state() {
    let st = nat_init()
    ce_eq("fresh udp_sent 0", nat_udp_sent_count(st), 0)
    ce_eq("fresh udp_recvd 0", nat_udp_recvd_count(st), 0)
    ce_eq("fresh udp_timeouts 0", nat_udp_timeout_count(st), 0)
}

// ---- env timeout ------------------------------------------------------

fn test_r32a_timeout_default() {
    ce_eq("default RFC 8489 timeout = 1000ms",
          nat_rfc8489_timeout_ms_from_env(), 1000)
}

// ---- nat_udp_open shape ----------------------------------------------

fn test_r32a_udp_open_returns_fd_or_minus_one() {
    let fd = nat_udp_open()
    // Either fd >= 0 (native) or fd == -1 (stub / sandbox-deny).
    // Both shapes are valid for the assertion below.
    ce_check("udp_open returns fd >= 0 OR -1", fd >= 0)
    if fd >= 0 { close_fd(fd) }
}

// ---- TCP path preserved when env flag off ----------------------------

fn test_r32a_tcp_path_preserved_when_flag_off() {
    // CE_NAT_USE_RFC8489 is unset in the test env. nat_query_stun_
    // with_state must walk the legacy TCP path. We don't actually
    // connect (no server) -- the legacy path's _nat_dial fails to a
    // closed port and returns -1, so we expect a dial-failed last
    // error (NOT udp-* or rfc8489-*).
    let st = nat_init()
    let r = nat_query_stun_with_state(st, "127.0.0.1:1")
    ce_eq("legacy path on closed port returns 0", r, 0)
    ce_str_eq("legacy path last_error is dial-failed",
              nat_last_error(st), "dial-failed")
    ce_eq("legacy path bumps NAT_S_QUERIES",
          nat_query_count(st), 1)
    // R32A: even when the dial fails, the legacy path must NOT
    // touch any UDP counter.
    ce_eq("legacy path leaves UDP_SENT untouched",
          nat_udp_sent_count(st), 0)
    ce_eq("legacy path leaves UDP_RECVD untouched",
          nat_udp_recvd_count(st), 0)
    ce_eq("legacy path leaves UDP_TIMEOUTS untouched",
          nat_udp_timeout_count(st), 0)
}

// ---- bad addr through UDP dispatch -----------------------------------

fn test_r32a_udp_dispatch_bad_addr() {
    let st = nat_init()
    let r = nat_udp_query_rfc8489_with_state(st, "not-an-addr")
    ce_eq("dispatch on bad addr returns 0", r, 0)
    ce_str_eq("dispatch on bad addr sets last_error",
              nat_last_error(st), "bad-remote-addr")
    ce_eq("dispatch on bad addr does NOT bump UDP_SENT",
          nat_udp_sent_count(st), 0)
}

fn test_r32a_udp_dispatch_bad_ip() {
    let st = nat_init()
    let r = nat_udp_query_rfc8489_with_state(st, "999.0.0.1:3478")
    ce_eq("dispatch on bad ip returns 0", r, 0)
    ce_str_eq("dispatch on bad ip sets last_error",
              nat_last_error(st), "bad-remote-addr-ip")
}

// ---- udp_send_binding_request_at validation --------------------------

fn test_r32a_send_at_rejects_bad_fd() {
    let st = nat_init()
    let r = nat_udp_send_binding_request_at(0 - 1, st, "127.0.0.1",
                                            3478, "ce")
    ce_eq("send_at with fd=-1 returns 0", r, 0)
    ce_str_eq("send_at fd=-1 sets udp-bad-fd",
              nat_last_error(st), "udp-bad-fd")
    ce_eq("send_at fd=-1 does NOT bump UDP_SENT",
          nat_udp_sent_count(st), 0)
}

fn test_r32a_send_at_rejects_bad_ip() {
    let st = nat_init()
    let r = nat_udp_send_binding_request_at(3, st, "not-an-ip",
                                            3478, "ce")
    ce_eq("send_at bad ip returns 0", r, 0)
    ce_str_eq("send_at bad ip sets last_error",
              nat_last_error(st), "bad-remote-addr-ip")
}

fn test_r32a_send_at_rejects_bad_port() {
    let st = nat_init()
    let r = nat_udp_send_binding_request_at(3, st, "127.0.0.1",
                                            0, "ce")
    ce_eq("send_at port=0 returns 0", r, 0)
    let r2 = nat_udp_send_binding_request_at(3, st, "127.0.0.1",
                                             70000, "ce")
    ce_eq("send_at port>65535 returns 0", r2, 0)
}

// ---- recv_binding_response on bad fd ---------------------------------

fn test_r32a_recv_rejects_bad_fd() {
    let st = nat_init()
    let r = nat_udp_recv_binding_response(0 - 1, st, 50)
    ce_eq("recv with fd=-1 returns 0", r, 0)
    ce_str_eq("recv fd=-1 sets udp-bad-fd",
              nat_last_error(st), "udp-bad-fd")
    ce_eq("recv fd=-1 does NOT bump UDP_TIMEOUTS",
          nat_udp_timeout_count(st), 0)
}

// ---- UDP loopback round-trip (full path) ----------------------------
//
// This is the load-bearing test: send a real Binding Request over a
// real UDP socket; have a responder reply with a real Binding Success
// Response (built through R30C); the client side of nat_traversal
// receives, parses, and updates NAT_S_MY_EXTERNAL. If sys_socket_udp
// returns -1 (stub target / sandbox deny), the test is skipped via
// an early return so the rest of the suite still runs.

fn test_r32a_udp_loopback_round_trip() {
    let probe = nat_udp_open()
    if probe < 0 {
        // Stub target: skip the round-trip. Record that the skip path
        // is reachable by checking the recvd counter stays 0.
        ce_check("stub-target: udp round-trip skipped", 1 == 1)
        return
    }
    close_fd(probe)

    // 127.0.0.1 in net-byte-order int. nova's make_sockaddr_in
    // expects this value (matches _nat_ip_str_to_int's output).
    let LOOPBACK = 16777343
    let RESP_PORT = 42519

    let resp_fd = nat_udp_open()
    ce_check("responder socket opened", resp_fd >= 0)
    let resp_sa = make_sockaddr_in(RESP_PORT, LOOPBACK)
    let bind_rc = bind_socket(resp_fd, resp_sa, 16)
    ce_eq("responder bound on 127.0.0.1:42519", bind_rc, 0)

    let cli_fd = nat_udp_open()
    ce_check("client socket opened", cli_fd >= 0)

    let st = nat_init()
    // Mimic top-level dispatch: it bumps NAT_S_QUERIES before
    // handing off to the UDP layer.
    st[NAT_S_QUERIES] = st[NAT_S_QUERIES] + 1

    let emitted = nat_udp_send_binding_request_at(cli_fd, st,
                                                  "127.0.0.1",
                                                  RESP_PORT,
                                                  "ce/r32a-test")
    ce_check("send_binding_request returned packet",
             emitted != 0)
    ce_eq("send bumps NAT_S_UDP_SENT", nat_udp_sent_count(st), 1)
    ce_eq("send bumps NAT_S_RFC_REQUESTS",
          nat_rfc8489_requests_sent(st), 1)

    let txn = emitted[2]

    // Responder receives the Binding Request.
    let rbuf = alloc(NAT_RFC8489_UDP_BUF_LEN)
    let ri = 0
    while ri < NAT_RFC8489_UDP_BUF_LEN { store8(rbuf + ri, 0); ri = ri + 1 }
    let rx = sys_recvfrom(resp_fd, rbuf, NAT_RFC8489_UDP_BUF_LEN, 1000)
    let rx_n = rx[0]
    let rx_ip = rx[1]
    let rx_port = rx[2]
    ce_check("responder received request bytes > 0", rx_n > 0)
    ce_eq("responder sender ip = 127.0.0.1 int", rx_ip, LOOPBACK)
    ce_check("responder sender port nonzero", rx_port > 0)
    // The first two bytes of an RFC 8489 Binding Request are 0x00 0x01.
    ce_eq("inbound first byte = 0", load8(rbuf), 0)
    ce_eq("inbound second byte = 1 (Binding Request)",
          load8(rbuf + 1), 1)

    // Build a Binding Success Response with XOR-MAPPED-ADDRESS pointing
    // at 198.51.100.250:43200 and the same txn id.
    let v4 = stun_ipv4_str_to_buf("198.51.100.250")
    let resp_msg = stun_msg_build_success_response_ipv4(txn, v4, 43200,
                                                        "ce/r32a-resp",
                                                        "", "", 1)
    let resp_pkt = resp_msg[0]
    let resp_n = resp_msg[1]
    let resp_sent = sys_sendto(resp_fd, resp_pkt, resp_n, rx_ip, rx_port)
    ce_eq("responder sendto returned full length", resp_sent, resp_n)

    // Client receives + parses.
    let ok = nat_udp_recv_binding_response(cli_fd, st, 1000)
    ce_eq("client recv returns 1", ok, 1)
    ce_str_eq("NAT_S_MY_EXTERNAL set from XOR-MAPPED",
              nat_get_external(st), "198.51.100.250:43200")
    ce_eq("recv bumps NAT_S_UDP_RECVD", nat_udp_recvd_count(st), 1)
    ce_eq("recv bumps NAT_S_QUERIES_OK", nat_query_ok_count(st), 1)
    ce_eq("recv bumps NAT_S_RFC_OK",
          nat_rfc8489_responses_ok(st), 1)
    ce_eq("recv leaves NAT_S_UDP_TIMEOUTS at 0",
          nat_udp_timeout_count(st), 0)
    ce_str_eq("recv clears last_error",
              nat_last_error(st), "")

    close_fd(cli_fd)
    close_fd(resp_fd)
}

// ---- UDP timeout path -------------------------------------------------

fn test_r32a_udp_recv_timeout() {
    let probe = nat_udp_open()
    if probe < 0 {
        ce_check("stub-target: timeout skipped", 1 == 1)
        return
    }
    close_fd(probe)

    let fd = nat_udp_open()
    ce_check("timeout-test fd opened", fd >= 0)
    let st = nat_init()
    nat_set_external(st, "preserve-me")
    let r = nat_udp_recv_binding_response(fd, st, 50)
    ce_eq("recv with no inbound datagram returns 0", r, 0)
    ce_eq("recv timeout bumps NAT_S_UDP_TIMEOUTS",
          nat_udp_timeout_count(st), 1)
    ce_str_eq("recv timeout sets last_error",
              nat_last_error(st), "udp-timeout")
    // CRITICAL: timeout must NOT corrupt the existing external addr.
    ce_str_eq("recv timeout leaves NAT_S_MY_EXTERNAL intact",
              nat_get_external(st), "preserve-me")
    ce_eq("recv timeout does NOT bump NAT_S_UDP_RECVD",
          nat_udp_recvd_count(st), 0)
    ce_eq("recv timeout does NOT bump NAT_S_QUERIES_OK",
          nat_query_ok_count(st), 0)
    ce_eq("recv timeout does NOT bump NAT_S_RFC_BAD",
          nat_rfc8489_responses_bad(st), 0)
    close_fd(fd)
}

// ---- top-level dispatch with env flag on -> UDP timeout path --------
//
// Direct test that nat_query_stun_with_state walks the UDP path when
// CE_NAT_USE_RFC8489=1 is set. We can't manipulate env from inside the
// test (no setenv), but we CAN verify the dispatch shape by calling
// the internal helper that the env-on path resolves to. The end-to-end
// env path is exercised by the integration scenario.

fn test_r32a_udp_dispatch_via_helper_timeout() {
    let probe = nat_udp_open()
    if probe < 0 {
        ce_check("stub-target: dispatch helper skipped", 1 == 1)
        return
    }
    close_fd(probe)

    // Dispatch to a closed/unbound port. UDP "send" succeeds but no
    // response arrives -> we expect a timeout shape: NAT_S_QUERIES
    // unchanged (this helper doesn't enter through nat_query_stun_with_
    // state), NAT_S_UDP_SENT == 1, NAT_S_UDP_TIMEOUTS == 1.
    let st = nat_init()
    let r = nat_udp_query_rfc8489_with_state(st, "127.0.0.1:1")
    ce_eq("dispatch returns 0 on timeout", r, 0)
    ce_eq("dispatch bumps NAT_S_UDP_SENT", nat_udp_sent_count(st), 1)
    ce_eq("dispatch bumps NAT_S_UDP_TIMEOUTS",
          nat_udp_timeout_count(st), 1)
    ce_eq("dispatch leaves NAT_S_UDP_RECVD at 0",
          nat_udp_recvd_count(st), 0)
    ce_str_eq("dispatch leaves NAT_S_MY_EXTERNAL empty",
              nat_get_external(st), "")
}

