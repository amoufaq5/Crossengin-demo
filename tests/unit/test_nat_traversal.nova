    test_parse_stun_response_non_numeric_port()
    test_parse_stun_response_bad_ip()
    test_parse_stun_response_octet_over_255()
    test_parse_stun_response_empty()
    test_format_stun_response()
    test_extract_peer_addr_loopback_with_port()
    test_extract_peer_addr_rejects_non_inet()
    test_set_get_peer_external()
    test_set_peer_external_update_overwrites()
    test_get_peer_external_unknown_returns_empty()
    test_nat_peer_external_addrs_returns_table()
    test_local_addrs_nonempty()
    test_local_addrs_contains_loopback()
    test_detect_type_cone_same_port_same_ip()
    test_detect_type_symmetric_different_ports()
    test_detect_type_symmetric_different_ips()
    test_detect_type_open_local_ip_same_port()
    test_detect_type_blocked_first_query_failed()
    test_detect_type_blocked_both_failed()
    test_detect_type_blocked_empty_reply()
    test_detect_type_blocked_malformed_reply()
    test_hole_punch_stub_returns_zero()
    test_hole_punch_bumps_counter()
    test_record_inbound_extaddr_appends()
    test_record_inbound_extaddr_rejects_bad_external()
    test_record_inbound_extaddr_rejects_empty_internal()
    test_status_line_fresh_state()
    test_status_line_with_data()
    // R31C / R30C.2 -- RFC 8489 wire migration.
    test_r31c_legacy_emit_request_matches_old_wire()
    test_r31c_legacy_format_response_matches_old_wire()
    test_r31c_legacy_parse_round_trip()
    test_r31c_env_flag_default_off()
    test_r31c_emit_request_parses_as_rfc8489()
    test_r31c_emit_request_with_credentials_has_mi()
    test_r31c_emit_request_bumps_rfc_counter()
    test_r31c_send_binding_request_validates_addr()
    test_r31c_send_binding_request_good_addr()
    test_r31c_recv_binding_response_round_trip_ipv4()
    test_r31c_parse_rfc8489_returns_triple()
    test_r31c_recv_bad_packet_bumps_bad_counter()
    test_r31c_recv_zero_buf_returns_zero()
    test_r31c_format_success_response_ipv4()
    test_r31c_format_success_response_rejects_bad_ip()
    test_r31c_rfc8489_state_lazy_idempotent()
    test_r31c_stats_accessors_guard_zero_state()
    // R32A / R31C.2 / R28C consumer -- UDP dispatch.
    test_r32a_udp_stats_accessors_zero_state()
    test_r32a_udp_stats_accessors_fresh_state()
    test_r32a_timeout_default()
    test_r32a_udp_open_returns_fd_or_minus_one()
    test_r32a_tcp_path_preserved_when_flag_off()
    test_r32a_udp_dispatch_bad_addr()
    test_r32a_udp_dispatch_bad_ip()
    test_r32a_send_at_rejects_bad_fd()
    test_r32a_send_at_rejects_bad_ip()
    test_r32a_send_at_rejects_bad_port()
    test_r32a_recv_rejects_bad_fd()
    test_r32a_udp_loopback_round_trip()
    test_r32a_udp_recv_timeout()
    test_r32a_udp_dispatch_via_helper_timeout()
    ce_summary("nat_traversal")
}

main()
