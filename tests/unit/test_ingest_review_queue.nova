// Unit tests for src/ingest/review_queue.nova.

import "../ce_test.nova"
import "../../src/ingest/review_queue.nova"

fn _mkrec(kg, src) {
    let r = cur_new(kg, src)
    cur_add_atom(r, "a", ATOM_FACT, 800)
    return r
}

fn test_empty_queue() {
    let q = rq_new()
    ce_eq("size 0", rq_size(q), 0)
    ce_eq("no pending", rq_count_state(q, RQ_PENDING), 0)
}

fn test_submit_returns_ids() {
    let q = rq_new()
    let id1 = rq_submit(q, _mkrec("k", "src:a"), 100)
    let id2 = rq_submit(q, _mkrec("k", "src:b"), 101)
    ce_eq("id1=1", id1, 1)
    ce_eq("id2=2", id2, 2)
    ce_eq("size 2", rq_size(q), 2)
    ce_eq("both pending", rq_count_state(q, RQ_PENDING), 2)
}

fn test_find_by_id() {
    let q = rq_new()
    let id = rq_submit(q, _mkrec("k", "src:a"), 100)
    let e = rq_find(q, id)
    ce_check("found", e != 0)
    ce_eq("state pending", rq_state(e), RQ_PENDING)
    ce_eq("source matches", rq_source(e), "src:a")
    ce_eq("submitted matches", rq_submitted(e), 100)
    ce_check("nothing at bogus id", rq_find(q, 999) == 0)
}

fn test_approve_ingests() {
    let q = rq_new()
    let reg = kg_registry_new()
    let mo = mo_new()
    let id = rq_submit(q, _mkrec("k", "src:x"), 0)
    let code = rq_approve(q, id, reg, mo)
    ce_eq("approve ok", code, RQ_APPROVE_OK)
    let e = rq_find(q, id)
    ce_eq("state ingested", rq_state(e), RQ_INGESTED)
    ce_eq("kg exists", kg_count(reg), 1)
}

fn test_deny_records_reason() {
    let q = rq_new()
    let id = rq_submit(q, _mkrec("k", "src:x"), 0)
    let ok = rq_deny(q, id, "source under investigation")
    ce_eq("deny returns 1", ok, 1)
    let e = rq_find(q, id)
    ce_eq("state denied", rq_state(e), RQ_DENIED)
    ce_eq("reason kept", rq_reason(e), "source under investigation")
}

fn test_double_approve_no_op() {
    let q = rq_new()
    let reg = kg_registry_new()
    let mo = mo_new()
    let id = rq_submit(q, _mkrec("k", "src:x"), 0)
    rq_approve(q, id, reg, mo)
    let code = rq_approve(q, id, reg, mo)
    ce_eq("second approve refused", code, RQ_APPROVE_ALREADY_DONE)
}

fn test_deny_then_approve_refused() {
    let q = rq_new()
    let reg = kg_registry_new()
    let id = rq_submit(q, _mkrec("k", "src:x"), 0)
    rq_deny(q, id, "no")
    let code = rq_approve(q, id, reg, 0)
    ce_eq("approve after deny refused", code, RQ_APPROVE_ALREADY_DONE)
}

fn test_approve_bad_record_marks_failed() {
    let q = rq_new()
    let reg = kg_registry_new()
    let bad = cur_new("k", "src:x")
    cur_add_atom(bad, "b", ATOM_FACT, 500)
    cur_add_obs(bad, "no_such_atom", 1, 1000)
    let id = rq_submit(q, bad, 0)
    let code = rq_approve(q, id, reg, 0)
    ce_eq("ingest failed", code, RQ_APPROVE_INGEST_FAILED)
    let e = rq_find(q, id)
    ce_eq("state ingest-failed", rq_state(e), RQ_INGEST_FAILED)
    ce_check("reason non-empty", len(rq_reason(e)) > 0)
}

fn test_filter_state() {
    let q = rq_new()
    let reg = kg_registry_new()
    let ids = list_new()
    let i = 0
    while i < 4 { push(ids, rq_submit(q, _mkrec("k", "src:x"), i)) i = i + 1 }
    rq_approve(q, ids[0], reg, 0)
    rq_deny(q, ids[1], "n")
    let pending = rq_filter_state(q, RQ_PENDING)
    ce_eq("pending count = 2", len(pending), 2)
    let ingested = rq_filter_state(q, RQ_INGESTED)
    ce_eq("ingested count = 1", len(ingested), 1)
    let denied = rq_filter_state(q, RQ_DENIED)
    ce_eq("denied count = 1", len(denied), 1)
}

fn test_state_names() {
    ce_check("pending name", len(rq_state_name(RQ_PENDING)) > 0)
    ce_check("ingested name", len(rq_state_name(RQ_INGESTED)) > 0)
    ce_check("unknown name", len(rq_state_name(999)) > 0)
}

fn main() {
    test_empty_queue()
    test_submit_returns_ids()
    test_find_by_id()
    test_approve_ingests()
    test_deny_records_reason()
    test_double_approve_no_op()
    test_deny_then_approve_refused()
    test_approve_bad_record_marks_failed()
    test_filter_state()
    test_state_names()
    ce_summary("ingest_review_queue")
}

main()
