// Unit tests for src/parts/emotion/appraisal.nova
// Verifies OCC appraisal: valence/arousal from desirability/praise/appeal, the
// dominant-dimension emotion type, and the neutral band. ADR-0035.

import "../ce_test.nova"
import "../../src/parts/emotion/appraisal.nova"

fn test_appraise() {
    // Strong desirable outcome -> joy, positive valence, moderate arousal.
    let r = emotion_appraise(800, 0, 0)
    ce_eq("joy valence positive", appraisal_valence(r), 633)
    ce_eq("joy arousal", appraisal_arousal(r), 266)
    ce_eq("joy type", appraisal_type(r), EMO_JOY)
    // Thwarted goal -> distress, negative valence.
    let d = emotion_appraise(-600, 0, 0)
    ce_check("distress valence < neutral", appraisal_valence(d) < 500)
    ce_eq("distress type", appraisal_type(d), EMO_DISTRESS)
    // Value violation -> shame.
    ce_eq("shame type", appraisal_type(emotion_appraise(0, -700, 0)), EMO_SHAME)
    // Praiseworthy action -> pride.
    ce_eq("pride type", appraisal_type(emotion_appraise(0, 600, 0)), EMO_PRIDE)
    // Appealing object -> liking.
    ce_eq("liking type", appraisal_type(emotion_appraise(0, 0, 500)), EMO_LIKING)
}

fn test_neutral_and_signed() {
    // Below threshold -> neutral.
    let n = emotion_appraise(50, 30, 20)
    ce_eq("neutral type", appraisal_type(n), EMO_NEUTRAL)
    ce_check("near-neutral valence", appraisal_valence(n) > 480)
    ce_str_eq("type name", emotion_type_name(EMO_DISTRESS), "distress")
    // Signed valence mapping.
    ce_eq("neutral signed 0", emotion_valence_signed(500), 0)
    ce_eq("full positive signed", emotion_valence_signed(1000), 1000)
    ce_eq("full negative signed", emotion_valence_signed(0), -1000)
}

fn main() {
    test_appraise()
    test_neutral_and_signed()
    ce_summary("appraisal")
}

main()
