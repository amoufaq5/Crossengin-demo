// Unit tests for src/kg/rule_explain.nova (R22E).
//
// Covers recursive provenance walks over R20B's rule engine: ground-fact
// leaves, one-step derivations, two-step derivations, 5-link transitive
// ancestor chains, max_depth cap with TRUNCATED sentinel, cycle handling,
// structured + text rendering, ground-fact extraction. ~32 assertions;
// snapshot-tests the text output for a known fixture.
//
// ADRs: ADR-0016 (atoms + xrefs are the inference surface),
//   ADR-0049 (testing + benchmarks).

import "../ce_test.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/rule_inference.nova"
import "../../src/kg/rule_explain.nova"

// ---- helpers --------------------------------------------------------------

fn _empty_kg() {
    let reg = kg_registry_new()
    return kg_spawn(reg, "test_explain")
}

// Seed parent(0,1) .. parent(n-1, n) facts.
fn _seed_chain(n) {
    let kg = _empty_kg()
    let i = 0
    while i < n {
        let label = "parent|" + int_to_str(i) + "|" + int_to_str(i + 1)
        kg_add_atom(kg, ATOM_RELATION, label, 0)
        i = i + 1
    }
    return kg
}

// Build an engine with the two classical transitive ancestor rules.
fn _ancestor_engine() {
    let e = rule_engine_new()
    rule_engine_add(e, "RULE ancestor(?a, ?b) <- parent(?a, ?b)")
    rule_engine_add(e, "RULE ancestor(?a, ?c) <- ancestor(?a, ?b), parent(?b, ?c)")
    return e
}

// Find an ancestor atom with the given args. Returns the atom_id or -1.
fn _find_ancestor(kg, a, b) {
    let label = "ancestor|" + int_to_str(a) + "|" + int_to_str(b)
    let atom = kg_find_atom(kg, label)
    if atom == 0 { return -1 }
    return atom_id(atom)
}

// ---- ground-fact leaf ----------------------------------------------------

fn test_ground_fact_leaf() {
    let kg = _empty_kg()
    let pa = kg_add_atom(kg, ATOM_RELATION, "parent|0|1", 0)
    let aid = atom_id(pa)
    let e = rule_engine_new()
    let tree = explain_atom(kg, e, aid)
    ce_check("ground tree is valid", proof_is_tree(tree) == 1)
    ce_eq("ground tree height is 1", proof_height(tree), 1)
    ce_eq("ground tree has no sub-proofs", proof_sub_count(tree), 0)
    ce_eq("ground tree marked as ground", proof_is_ground(tree), 1)
    ce_eq("ground tree derivation count is 0", proof_derivation_count(tree), 0)
    ce_str_eq("ground tree rule_name is GROUND", proof_rule_name(tree), "GROUND")
    ce_str_eq("ground tree label preserved", proof_label(tree), "parent|0|1")
}

// ---- one-step derivation -------------------------------------------------

fn test_one_step_derivation() {
    let kg = _seed_chain(1)         // parent(0,1) only
    let e = rule_engine_new()
    rule_engine_add(e, "RULE ancestor(?a, ?b) <- parent(?a, ?b)")
    rule_engine_run(e, kg, 100)
    // The derived ancestor(0,1) is the second atom (atom 0 = parent, 1 = ancestor).
    let aid = _find_ancestor(kg, 0, 1)
    ce_check("one-step ancestor exists", aid >= 0)
    let tree = explain_atom(kg, e, aid)
    ce_check("one-step tree is valid", proof_is_tree(tree) == 1)
    ce_eq("one-step height is 2", proof_height(tree), 2)
    ce_eq("one-step has 1 child", proof_sub_count(tree), 1)
    ce_eq("one-step is NOT ground", proof_is_ground(tree), 0)
    let child = proof_subs(tree)[0]
    ce_eq("child is ground", proof_is_ground(child), 1)
    ce_eq("child height is 1", proof_height(child), 1)
    ce_str_eq("rule name is ancestor", proof_rule_name(tree), "ancestor")
}

// ---- two-step derivation (derived from derived) -------------------------

fn test_two_step_derivation() {
    let kg = _seed_chain(2)         // parent(0,1), parent(1,2)
    let e = _ancestor_engine()
    rule_engine_run(e, kg, 100)
    // ancestor(0, 2) is derived from ancestor(0, 1) AND parent(1, 2);
    // ancestor(0, 1) is itself derived from parent(0, 1).
    let aid = _find_ancestor(kg, 0, 2)
    ce_check("two-step ancestor exists", aid >= 0)
    let tree = explain_atom(kg, e, aid)
    ce_check("two-step tree is valid", proof_is_tree(tree) == 1)
    ce_check("two-step height >= 3", proof_height(tree) >= 3)
    // The proof of ancestor(0,2) has 2 children: ancestor(0,1) + parent(1,2).
    ce_eq("two-step has 2 children", proof_sub_count(tree), 2)
}

// ---- 5-link transitive ancestor chain (the brief's headline case) -------
//
// parent(0,1), parent(1,2), parent(2,3), parent(3,4), parent(4,5):
// 5 parent facts -> chain of 6 nodes. ancestor(0, 4) has the shape
//   ancestor(0,4) <- ancestor(0,3) AND parent(3,4)
// (rule index 1 applies in the standard order). The proof tree therefore
// has 4 levels (height 4): ancestor(0,4) -> ancestor(0,3) -> ancestor(0,2)
// -> ancestor(0,1) -> parent(0,1) ground. The brief explicitly calls for
// "ancestor(0,4) has proof tree of 4 levels"; we test that.

fn test_5_link_ancestor_chain() {
    let kg = _seed_chain(5)
    let e = _ancestor_engine()
    rule_engine_run(e, kg, 100)
    let aid = _find_ancestor(kg, 0, 4)
    ce_check("ancestor(0,4) exists", aid >= 0)
    let tree = explain_atom(kg, e, aid)
    ce_check("5-link tree is valid", proof_is_tree(tree) == 1)
    // The recursive proof has 4 levels of ancestor + 1 final ground fact
    // = total height >= 4 (depending on which rule fired first at each
    // level; the chained rule produces taller trees).
    ce_check("5-link height >= 4", proof_height(tree) >= 4)
    // Every leaf must be a parent ground fact.
    let grounds = proof_ground_facts(tree)
    ce_check("ground facts are non-empty", len(grounds) >= 1)
    // The ancestor(0,4) chain pulls in exactly 4 distinct parent facts
    // (parent(0,1), parent(1,2), parent(2,3), parent(3,4)) -- one per
    // link in the chain. The chained rule's derivation tree of
    // ancestor(0,4) is
    //   ancestor(0,4) <- ancestor(0,3) AND parent(3,4)
    //   ancestor(0,3) <- ancestor(0,2) AND parent(2,3)
    //   ancestor(0,2) <- ancestor(0,1) AND parent(1,2)
    //   ancestor(0,1) <- parent(0,1)
    // = 4 distinct ground parent facts.
    ce_eq("5-link uses 4 ground parent facts", len(grounds), 4)
}

// Also check ancestor(0,5) -- the full chain. The brief mentions 5-link
// chain with depth = 4. ancestor(0,5) climbs through 5 derivations.
fn test_5_link_ancestor_full() {
    let kg = _seed_chain(5)
    let e = _ancestor_engine()
    rule_engine_run(e, kg, 100)
    let aid = _find_ancestor(kg, 0, 5)
    ce_check("ancestor(0,5) exists", aid >= 0)
    let tree = explain_atom(kg, e, aid)
    ce_check("5-link full chain valid", proof_is_tree(tree) == 1)
    // ancestor(0,5) chains 5 derivations -> tree height >= 5 (deepest leaf).
    ce_check("ancestor(0,5) height >= 5", proof_height(tree) >= 5)
    let grounds = proof_ground_facts(tree)
    ce_eq("ancestor(0,5) uses 5 distinct parents", len(grounds), 5)
}

// ---- max_depth truncation ------------------------------------------------

fn test_max_depth_truncates() {
    let kg = _seed_chain(5)
    let e = _ancestor_engine()
    rule_engine_run(e, kg, 100)
    let aid = _find_ancestor(kg, 0, 5)
    ce_check("ancestor(0,5) exists for truncation test", aid >= 0)
    // Force truncation: cap at depth 2 means depth 0+1 walked, depth 2
    // (the leaves) become TRUNCATED sentinels. So tree height is 3
    // (root + 1 internal + 1 truncated leaf).
    let tree = explain_atom_with_depth(kg, e, aid, 2)
    ce_check("truncated tree is valid", proof_is_tree(tree) == 1)
    ce_eq("truncated tree height is 3", proof_height(tree), 3)
    // Look at the GRANDCHILDREN (depth=2): at least one should be marked
    // TRUNCATED (since the chain continues past depth 2 on the left
    // ancestor branch).
    let subs = proof_subs(tree)
    ce_check("truncated tree has children", len(subs) >= 1)
    let has_truncation = 0
    let i = 0
    while i < len(subs) {
        let child = subs[i]
        let gks = proof_subs(child)
        let j = 0
        while j < len(gks) {
            if proof_is_truncated(gks[j]) == 1 {
                has_truncation = 1
            }
            j = j + 1
        }
        i = i + 1
    }
    ce_eq("truncated tree contains TRUNCATED sentinel", has_truncation, 1)
}

// ---- cycle prevention ----------------------------------------------------
//
// R20B's dedupe prevents cycles in the input, but if a test fixture forces
// a duplicate provenance entry that references the parent atom, we want
// the walk to short-circuit gracefully via CYCLE sentinel rather than
// recursing forever. We can't easily inject a cycle from the public API
// (rule_engine_explain only reads the engine's provenance table), so we
// directly assert that the walk respects EXPLAIN_MAX_DEPTH and emits a
// truncated sentinel rather than crashing -- this is the same defensive
// behaviour.
//
// We CAN test the no-cycle invariant by running a self-rule (foo<-foo)
// which adds no derivations; the explain of foo|x|y should be a ground
// fact (since the rule fires but the dedupe step skips the add).
fn test_no_cycle_via_dedupe() {
    let kg = _empty_kg()
    let f = kg_add_atom(kg, ATOM_RELATION, "foo|x|y", 0)
    let aid = atom_id(f)
    let e = rule_engine_new()
    rule_engine_add(e, "RULE foo(?a, ?b) <- foo(?a, ?b)")
    rule_engine_run(e, kg, 50)
    // foo|x|y is unchanged in the engine's provenance: the dedupe step
    // skipped the add, so explain returns a ground-fact tree.
    let tree = explain_atom(kg, e, aid)
    ce_eq("self-rule still gives ground fact (no cycle)", proof_is_ground(tree), 1)
    ce_eq("self-rule height is 1", proof_height(tree), 1)
}

// ---- explain on missing atom ---------------------------------------------

fn test_explain_missing_atom() {
    let kg = _empty_kg()
    let e = rule_engine_new()
    let tree = explain_atom(kg, e, 999)
    ce_check("missing atom tree is valid", proof_is_tree(tree) == 1)
    ce_eq("missing atom not marked ground", proof_is_ground(tree), 0)
    ce_str_eq("missing atom rule_name is MISSING", proof_rule_name(tree), "MISSING")
}

// ---- text rendering ------------------------------------------------------

fn test_text_render_ground() {
    let kg = _empty_kg()
    let pa = kg_add_atom(kg, ATOM_RELATION, "parent|0|1", 0)
    let aid = atom_id(pa)
    let e = rule_engine_new()
    let tree = explain_atom(kg, e, aid)
    let txt = proof_render_text(tree, 50)
    // Expected snapshot for a ground fact.
    let expected = "- atom " + int_to_str(aid) + " \"parent|0|1\" GROUND\n"
    ce_str_eq("ground text snapshot", txt, expected)
}

fn test_text_render_one_step() {
    let kg = _seed_chain(1)
    let e = rule_engine_new()
    rule_engine_add(e, "RULE ancestor(?a, ?b) <- parent(?a, ?b)")
    rule_engine_run(e, kg, 100)
    let aid_anc = _find_ancestor(kg, 0, 1)
    let aid_par = atom_id(kg_find_atom(kg, "parent|0|1"))
    let tree = explain_atom(kg, e, aid_anc)
    let txt = proof_render_text(tree, 50)
    let expected = "- atom " + int_to_str(aid_anc) + " \"ancestor|0|1\" via ancestor (rule #0)\n"
        + "  - atom " + int_to_str(aid_par) + " \"parent|0|1\" GROUND\n"
    ce_str_eq("one-step text snapshot", txt, expected)
}

// ---- structured rendering ------------------------------------------------

fn test_structured_render_ground() {
    let kg = _empty_kg()
    let pa = kg_add_atom(kg, ATOM_RELATION, "parent|0|1", 0)
    let aid = atom_id(pa)
    let e = rule_engine_new()
    let tree = explain_atom(kg, e, aid)
    let s = proof_render_structured(tree)
    // [atom_id, label, rule_idx, [] ]
    ce_eq("structured has 4 fields", len(s), 4)
    ce_eq("structured atom_id matches", s[0], aid)
    ce_str_eq("structured label matches", s[1], "parent|0|1")
    ce_eq("structured rule_idx is GROUND", s[2], -1)
    ce_eq("structured kids list is empty", len(s[3]), 0)
}

fn test_structured_render_two_step() {
    let kg = _seed_chain(2)
    let e = _ancestor_engine()
    rule_engine_run(e, kg, 100)
    let aid = _find_ancestor(kg, 0, 2)
    let tree = explain_atom(kg, e, aid)
    let s = proof_render_structured(tree)
    ce_eq("two-step structured has 4 fields", len(s), 4)
    ce_eq("two-step structured atom_id matches", s[0], aid)
    // Root rule is the chained ancestor rule (index 1 in our engine).
    ce_eq("two-step structured rule_idx is 1", s[2], 1)
    ce_eq("two-step structured has 2 children", len(s[3]), 2)
}

// ---- ground-fact extraction ----------------------------------------------

fn test_ground_facts_dedupe() {
    // Build a fixture where two paths converge on the same ground fact:
    // parent(0,1), parent(1,2). ancestor(0,2) <- ancestor(0,1) AND parent(1,2)
    // ancestor(0,1) <- parent(0,1). So the proof has one parent(0,1)
    // ground leaf and one parent(1,2) ground leaf. The ground-fact list
    // should be deduplicated (no repeated atom IDs).
    let kg = _seed_chain(2)
    let e = _ancestor_engine()
    rule_engine_run(e, kg, 100)
    let aid = _find_ancestor(kg, 0, 2)
    let tree = explain_atom(kg, e, aid)
    let grounds = proof_ground_facts(tree)
    ce_eq("two-step uses 2 distinct parents", len(grounds), 2)
}

// ---- proof_node_count -----------------------------------------------------

fn test_node_count() {
    let kg = _empty_kg()
    let pa = kg_add_atom(kg, ATOM_RELATION, "parent|0|1", 0)
    let e = rule_engine_new()
    let tree = explain_atom(kg, e, atom_id(pa))
    ce_eq("ground tree node count is 1", proof_node_count(tree), 1)
    // One-step: ancestor(0,1) + parent(0,1) = 2 nodes.
    let kg2 = _seed_chain(1)
    let e2 = rule_engine_new()
    rule_engine_add(e2, "RULE ancestor(?a, ?b) <- parent(?a, ?b)")
    rule_engine_run(e2, kg2, 100)
    let tree2 = explain_atom(kg2, e2, _find_ancestor(kg2, 0, 1))
    ce_eq("one-step tree node count is 2", proof_node_count(tree2), 2)
}

// ---- chat-engine bridge --------------------------------------------------

fn test_chat_engine_helpers() {
    let before = explain_chat_engine_size()
    let r = explain_chat_add_rule("RULE p(?a, ?b) <- q(?a, ?b)")
    ce_eq("explain_chat_add_rule succeeded", r, 1)
    ce_eq("chat engine size grew", explain_chat_engine_size(), before + 1)
}

fn main() {
    test_ground_fact_leaf()
    test_one_step_derivation()
    test_two_step_derivation()
    test_5_link_ancestor_chain()
    test_5_link_ancestor_full()
    test_max_depth_truncates()
    test_no_cycle_via_dedupe()
    test_explain_missing_atom()
    test_text_render_ground()
    test_text_render_one_step()
    test_structured_render_ground()
    test_structured_render_two_step()
    test_ground_facts_dedupe()
    test_node_count()
    test_chat_engine_helpers()
    ce_summary("rule_explain")
}

main()
