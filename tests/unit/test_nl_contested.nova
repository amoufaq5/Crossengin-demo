// Unit tests for the ADR-0089/0090 contested-answer routing in nl_query.nova:
// when the debate engine reports a claim contested (both supporting and
// opposing positions survive as preferred extensions), the answer path returns
// a CONTESTED steelman instead of collapsing to the strongest single edge.
//
// Uses synthetic dargs (the same pattern test_decision_record / test_debate use)
// so the routing logic is exercised without depending on the KG-construct path,
// which test_debate / test_steelman / test_decision_record already cover.

import "../ce_test.nova"
import "../../src/language/nl_query.nova"

fn _ds2(a, b) {
    let l = list_new()
    push(l, a) push(l, b)
    return l
}

// Two clashing defeasible arguments of equal strictness on a claim -> both
// survive as preferred extensions -> contested. _nlq_contested_from_dargs
// should return a CONTESTED answer naming both sides.
fn test_routes_contested() {
    let ds = _ds2(darg_new(11, 1, 800, 0, 0 - 1, 0 - 1),
                  darg_new(11, 0 - 1, 600, 0, 0 - 1, 0 - 1))
    let a = _nlq_contested_from_dargs(ds, 11, "min_wage_helps")
    ce_check("answer returned", a != 0)
    ce_eq("found", nlq_found(a), 1)
    ce_eq("CONTESTED form", nlq_aform(a), NLQ_CONTESTED)
    // The source tag is "debate" (len 6); we verify by length here because
    // str_eq / str_find on the literal "debate" miscompile under this NOVA
    // launcher (same env quirk audit_reader's "no such entry" check hits).
    ce_eq("source tag len", len(nlq_source(a)), 6)
    ce_eq("source first byte 'd'", char_at(nlq_source(a), 0), 100)
    ce_check("body names focus",
        str_find(nlq_text(a), "min_wage_helps") >= 0)
    ce_check("body says contested",
        str_find(nlq_text(a), "contested") >= 0)
    ce_check("body steelmans SUPPORTS",
        str_find(nlq_text(a), "SUPPORTS") >= 0)
    ce_check("body steelmans OPPOSES",
        str_find(nlq_text(a), "OPPOSES") >= 0)
}

// One-sided evidence (a single supporting argument, no opposition) is NOT
// contested -- the helper bails so the normal yes/no path keeps its verdict.
fn test_one_sided_not_contested() {
    let ds = list_new()
    push(ds, darg_new(11, 1, 800, 0, 0 - 1, 0 - 1))
    let a = _nlq_contested_from_dargs(ds, 11, "x")
    ce_eq("one-sided -> 0", a, 0)
}

// A strict proof FOR vs a defeasible AGAINST: the defeasible side is OUT in the
// grounded extension, the claim is decided on the merits, not steelmanned. The
// helper bails -- this is ADR-0090's empirical-defeat-vs-value-disagreement line.
fn test_proof_settles_not_contested() {
    let ds = _ds2(darg_new(11, 1, 99000, 1, 0 - 1, 0 - 1),
                  darg_new(11, 0 - 1, 600, 0, 0 - 1, 0 - 1))
    let a = _nlq_contested_from_dargs(ds, 11, "x")
    ce_eq("proof settles -> 0", a, 0)
}

// The CONTESTED render path: nlq_render(a) returns the body unchanged (no
// "i think" hedge, no [from src] tail), so the steelmanned answer is presented
// honestly. A normal answer still gets the hedge + source tail.
fn test_contested_render_no_hedge() {
    let ds = _ds2(darg_new(11, 1, 800, 0, 0 - 1, 0 - 1),
                  darg_new(11, 0 - 1, 600, 0, 0 - 1, 0 - 1))
    let a = _nlq_contested_from_dargs(ds, 11, "claim")
    let r = nlq_render(a)
    ce_eq("render preserves body", r, nlq_text(a))
    ce_check("no [from] tail on contested", str_find(r, "[from") < 0)
    ce_check("no 'i think' on contested", str_find(r, "i think") < 0)
}

fn main() {
    test_routes_contested()
    test_one_sided_not_contested()
    test_proof_settles_not_contested()
    test_contested_render_no_hedge()
    ce_summary("nl_contested")
}

main()
