// Unit tests for src/federation/snapshot_attestation.nova (R20F).
//
// Coverage (~28 assertions):
//   Round-trip: att_make + att_verify accept a legit attestation.
//   Tamper resistance:
//     * Bit-flipped root rejected.
//     * Bit-flipped signature rejected.
//     * Wrong pubkey rejected.
//     * Mutated soul_id rejected.
//     * Mutated ts_ns rejected.
//   Wire codec: att_to_wire / att_parse_wire round-trips lossless.
//   Parse rejects shape-bad inputs (non-hex, wrong tok count, wrong prefix).
//   Store: add + count + per-peer count.
//   Store latest: empty store returns 0; with entries returns highest-ts.
//   Store per-peer: filters correctly when multiple peers present.
//   Store peer_ids: unique enumeration.
//
// CrossEngin dependencies: src/federation/snapshot_attestation.nova,
// src/safety/ed25519.nova (for fresh keypairs).

import "../ce_test.nova"
import "../../src/federation/snapshot_attestation.nova"
import "../../src/safety/ed25519.nova"

// ---- helpers --------------------------------------------------------------

// A known 32-byte "root" -- SHA-256 of "abc" per FIPS 180-4.
let _T_ROOT_HEX = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

// A second distinct known root (SHA-256 of "").
let _T_ROOT2_HEX = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

// RFC 8032 test vector #1 seed.
let _T_SK_HEX  = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"

// A second distinct seed.
let _T_SK2_HEX = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"

fn _t_keypair_from_hex(sk_hex) {
    let seed = ed25519_hex_to_bytes(sk_hex)
    let parts = _ed_derive_a_and_prefix(seed)
    let pk = _ed_pk_from_a(parts[0])
    let r = list_new()
    push(r, seed)
    push(r, pk)
    return r
}

fn _t_root_bytes(hex) {
    return ed25519_hex_to_bytes(hex)
}

// Bit-flip a copy of a byte list at (off, bit).
fn _t_flip(bytes, off, bit) {
    let out = list_new()
    let i = 0
    while i < len(bytes) {
        push(out, bytes[i])
        i = i + 1
    }
    list_set(out, off, int_xor(out[off], int_shl(1, bit)))
    return out
}

// Materialise a tampered ATT by mutating one hex char.
fn _t_mutate_hex_at(s, idx) {
    let c = char_at(s, idx)
    let new_c = c + 1
    // '9' -> 'a' is fine (still hex); 'f' -> wrap to '0'.
    if c == 102 { new_c = 48 }
    // We MUST keep the char as a valid hex char so length checks survive
    // and the underlying byte changes; the loop above does that.
    let prefix = substr(s, 0, idx)
    let suffix = substr(s, idx + 1, len(s) - idx - 1)
    return prefix + chr(new_c) + suffix
}

// ---- round-trip ----------------------------------------------------------

fn test_att_make_returns_full_tuple() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 1700000000000000000, root, kp[0], kp[1])
    ce_check("att non-zero", att != 0)
    ce_eq("att soul_id=42", att_soul_id(att), 42)
    ce_eq("att ts_ns set", att_ts_ns(att), 1700000000000000000)
    ce_eq("att root_hex matches", str_eq(att_root_hex(att), _T_ROOT_HEX), 1)
    ce_eq("att sig_hex length=128", len(att_sig_hex(att)), 128)
}

fn test_att_verify_accepts_round_trip() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 1234567890, root, kp[0], kp[1])
    let ok = att_verify(att, kp[1])
    ce_eq("legit attestation verifies", ok, 1)
}

fn test_att_make_is_deterministic() {
    // Ed25519 is deterministic; same inputs => same signature.
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let a1 = att_make(42, 5555, root, kp[0], kp[1])
    let a2 = att_make(42, 5555, root, kp[0], kp[1])
    ce_eq("same sig hex on re-sign", str_eq(att_sig_hex(a1), att_sig_hex(a2)), 1)
}

fn test_att_make_distinct_ts_produce_distinct_sigs() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let a1 = att_make(42, 1000, root, kp[0], kp[1])
    let a2 = att_make(42, 1001, root, kp[0], kp[1])
    // Same root + key + soul_id but different ts -> different signature.
    let same = 0
    if str_eq(att_sig_hex(a1), att_sig_hex(a2)) == 1 { same = 1 }
    ce_eq("different ts_ns yields different sig", same, 0)
}

// ---- tamper detection ----------------------------------------------------

fn test_att_verify_rejects_tampered_root() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 5555, root, kp[0], kp[1])
    // Mutate the root hex post-sign.
    let tampered = list_new()
    push(tampered, att[ATT_F_SOUL_ID])
    push(tampered, att[ATT_F_TS_NS])
    push(tampered, _t_mutate_hex_at(att[ATT_F_ROOT_HEX], 5))
    push(tampered, att[ATT_F_SIG_HEX])
    let ok = att_verify(tampered, kp[1])
    ce_eq("bit-flipped root rejected", ok, 0)
}

fn test_att_verify_rejects_tampered_signature() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 5555, root, kp[0], kp[1])
    let tampered = list_new()
    push(tampered, att[ATT_F_SOUL_ID])
    push(tampered, att[ATT_F_TS_NS])
    push(tampered, att[ATT_F_ROOT_HEX])
    push(tampered, _t_mutate_hex_at(att[ATT_F_SIG_HEX], 0))
    let ok = att_verify(tampered, kp[1])
    ce_eq("bit-flipped sig rejected", ok, 0)
    // Make sure original still verifies (defensive).
    ce_eq("untampered original still verifies",
          att_verify(att, kp[1]), 1)
}

fn test_att_verify_rejects_wrong_pubkey() {
    let alice = _t_keypair_from_hex(_T_SK_HEX)
    let bob   = _t_keypair_from_hex(_T_SK2_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 5555, root, alice[0], alice[1])
    ce_eq("Alice sig + Alice pk = 1", att_verify(att, alice[1]), 1)
    ce_eq("Alice sig + Bob pk = 0",   att_verify(att, bob[1]), 0)
}

fn test_att_verify_rejects_mutated_soul_id() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 5555, root, kp[0], kp[1])
    let mutated = list_new()
    push(mutated, 43)                                   // bumped from 42
    push(mutated, att[ATT_F_TS_NS])
    push(mutated, att[ATT_F_ROOT_HEX])
    push(mutated, att[ATT_F_SIG_HEX])
    ce_eq("mutated soul_id => 0", att_verify(mutated, kp[1]), 0)
}

fn test_att_verify_rejects_mutated_ts_ns() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 5555, root, kp[0], kp[1])
    let mutated = list_new()
    push(mutated, att[ATT_F_SOUL_ID])
    push(mutated, 5556)                                 // bumped from 5555
    push(mutated, att[ATT_F_ROOT_HEX])
    push(mutated, att[ATT_F_SIG_HEX])
    ce_eq("mutated ts_ns => 0", att_verify(mutated, kp[1]), 0)
}

// ---- shape validation ----------------------------------------------------

fn test_att_make_bad_shapes_return_zero() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    ce_check("zero root => 0", att_make(42, 5555, 0, kp[0], kp[1]) == 0)
    ce_check("zero seed => 0", att_make(42, 5555, root, 0, kp[1]) == 0)
    ce_check("zero pk => 0",   att_make(42, 5555, root, kp[0], 0) == 0)
}

fn test_att_verify_zero_inputs() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    ce_eq("zero att => 0", att_verify(0, kp[1]), 0)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 5555, root, kp[0], kp[1])
    ce_eq("zero pk => 0", att_verify(att, 0), 0)
}

// ---- wire codec ----------------------------------------------------------

fn test_att_to_wire_round_trip() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let att = att_make(42, 1234567890, root, kp[0], kp[1])
    let line = att_to_wire(att)
    let parsed = att_parse_wire(line)
    ce_check("parsed non-zero", parsed != 0)
    ce_eq("parsed soul_id", att_soul_id(parsed), 42)
    ce_eq("parsed ts_ns", att_ts_ns(parsed), 1234567890)
    ce_eq("parsed root_hex", str_eq(att_root_hex(parsed), att_root_hex(att)), 1)
    ce_eq("parsed sig_hex",  str_eq(att_sig_hex(parsed), att_sig_hex(att)), 1)
    // The parsed tuple verifies under the same pubkey.
    ce_eq("parsed verifies", att_verify(parsed, kp[1]), 1)
}

fn test_att_parse_wire_rejects_short_lines() {
    ce_check("zero line => 0", att_parse_wire(0) == 0)
    ce_check("empty line => 0", att_parse_wire("") == 0)
    ce_check("no prefix => 0",
             att_parse_wire("PING 1 127.0.0.1:9000") == 0)
    // Right prefix but wrong field count.
    ce_check("too few fields => 0",
             att_parse_wire("ATTESTATION 42 1000") == 0)
    // Right prefix but non-hex root.
    ce_check("non-hex root => 0",
             att_parse_wire("ATTESTATION 42 1000 NOTHEX " + _T_ROOT_HEX + _T_ROOT_HEX) == 0)
}

// ---- store ---------------------------------------------------------------

fn test_store_starts_empty() {
    let s = att_store_new()
    ce_eq("empty store count = 0", att_store_count(s), 0)
    ce_eq("empty store latest = 0", att_store_latest(s, 42), 0)
    ce_eq("empty store per-peer count = 0", att_store_count_for_peer(s, 42), 0)
    ce_eq("empty store for_peer = []", len(att_store_for_peer(s, 42)), 0)
}

fn test_store_add_appends() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let s = att_store_new()
    let att = att_make(42, 1000, root, kp[0], kp[1])
    att_store_add(s, att)
    ce_eq("after one add: count=1", att_store_count(s), 1)
    ce_eq("after one add: per-peer count=1", att_store_count_for_peer(s, 42), 1)
}

fn test_store_latest_returns_most_recent_by_ts() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let root2 = _t_root_bytes(_T_ROOT2_HEX)
    let s = att_store_new()
    let a1 = att_make(42, 1000, root, kp[0], kp[1])
    let a2 = att_make(42, 2000, root2, kp[0], kp[1])
    let a3 = att_make(42, 1500, root, kp[0], kp[1])
    att_store_add(s, a1)
    att_store_add(s, a2)
    att_store_add(s, a3)   // out-of-order; latest by TS should still be a2
    let latest = att_store_latest(s, 42)
    ce_check("latest non-zero", latest != 0)
    ce_eq("latest ts = 2000", att_ts_ns(latest), 2000)
    ce_eq("latest root = root2", str_eq(att_root_hex(latest), _T_ROOT2_HEX), 1)
}

fn test_store_for_peer_filters_by_id() {
    let kp_a = _t_keypair_from_hex(_T_SK_HEX)
    let kp_b = _t_keypair_from_hex(_T_SK2_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let s = att_store_new()
    att_store_add(s, att_make(1, 100, root, kp_a[0], kp_a[1]))
    att_store_add(s, att_make(2, 200, root, kp_b[0], kp_b[1]))
    att_store_add(s, att_make(1, 300, root, kp_a[0], kp_a[1]))
    att_store_add(s, att_make(2, 400, root, kp_b[0], kp_b[1]))
    att_store_add(s, att_make(2, 500, root, kp_b[0], kp_b[1]))
    ce_eq("total store count = 5", att_store_count(s), 5)
    ce_eq("count(peer=1) = 2", att_store_count_for_peer(s, 1), 2)
    ce_eq("count(peer=2) = 3", att_store_count_for_peer(s, 2), 3)
    ce_eq("count(peer=3) = 0", att_store_count_for_peer(s, 3), 0)
    let p1_log = att_store_for_peer(s, 1)
    let p2_log = att_store_for_peer(s, 2)
    ce_eq("for_peer(1) returns 2 entries", len(p1_log), 2)
    ce_eq("for_peer(2) returns 3 entries", len(p2_log), 3)
    // Latest per peer is independent.
    let latest1 = att_store_latest(s, 1)
    let latest2 = att_store_latest(s, 2)
    ce_eq("latest(1) ts=300", att_ts_ns(latest1), 300)
    ce_eq("latest(2) ts=500", att_ts_ns(latest2), 500)
}

fn test_store_peer_ids_dedupes() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let s = att_store_new()
    att_store_add(s, att_make(10, 100, root, kp[0], kp[1]))
    att_store_add(s, att_make(20, 200, root, kp[0], kp[1]))
    att_store_add(s, att_make(10, 300, root, kp[0], kp[1]))
    att_store_add(s, att_make(30, 400, root, kp[0], kp[1]))
    let ids = att_store_peer_ids(s)
    ce_eq("3 distinct peers", len(ids), 3)
    // Insertion-order: 10, 20, 30.
    ce_eq("ids[0]=10", ids[0], 10)
    ce_eq("ids[1]=20", ids[1], 20)
    ce_eq("ids[2]=30", ids[2], 30)
}

fn test_status_line_for_empty_and_populated_peer() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let root = _t_root_bytes(_T_ROOT_HEX)
    let s = att_store_new()
    // Empty case.
    let line0 = att_status_line_for_peer(s, 99)
    ce_check("empty status mentions 'no attestations'",
             str_eq(line0, "att: peer 99 no attestations") == 1)
    // Populated case.
    att_store_add(s, att_make(99, 12345, root, kp[0], kp[1]))
    let line1 = att_status_line_for_peer(s, 99)
    // The string is "att: peer 99 count=1 latest_ts=12345 latest_root=ba7816bf"
    ce_check("populated status mentions count=1",
             str_eq(line1, "att: peer 99 count=1 latest_ts=12345 latest_root=ba7816bf") == 1)
}

fn test_canonical_message_layout() {
    // Soul_id 42 (LE) || ts_ns 100 (LE) || root_bytes.
    let root = _t_root_bytes(_T_ROOT_HEX)
    let msg = att_canonical_message(42, 100, root)
    ce_eq("canonical msg length = 48", len(msg), 48)
    // First byte of soul_id (42 = 0x2A) is 42.
    ce_eq("msg[0] = 0x2A", msg[0], 42)
    ce_eq("msg[1] = 0x00", msg[1], 0)
    // ts_ns occupies bytes 8..15; first byte is 100 (0x64).
    ce_eq("msg[8] = 0x64", msg[8], 100)
    // root starts at byte 16; first byte is 0xba.
    ce_eq("msg[16] = 0xba (root[0])", msg[16], 186)
    // Last byte of root is 0xad.
    ce_eq("msg[47] = 0xad (root[31])", msg[47], 173)
}

fn test_make_from_hex_round_trip() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    let att = att_make_from_hex(7, 999, _T_ROOT_HEX, kp[0], kp[1])
    ce_check("att_make_from_hex non-zero", att != 0)
    ce_eq("from-hex soul_id=7", att_soul_id(att), 7)
    ce_eq("from-hex ts_ns=999", att_ts_ns(att), 999)
    ce_eq("from-hex verifies", att_verify(att, kp[1]), 1)
}

fn test_make_from_hex_rejects_bad_root_hex() {
    let kp = _t_keypair_from_hex(_T_SK_HEX)
    ce_check("non-hex root => 0",
             att_make_from_hex(7, 999, "NOT_A_VALID_HEX_STRING_XX", kp[0], kp[1]) == 0)
    ce_check("zero root => 0",
             att_make_from_hex(7, 999, 0, kp[0], kp[1]) == 0)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_att_make_returns_full_tuple()
    test_att_verify_accepts_round_trip()
    test_att_make_is_deterministic()
    test_att_make_distinct_ts_produce_distinct_sigs()
    test_att_verify_rejects_tampered_root()
    test_att_verify_rejects_tampered_signature()
    test_att_verify_rejects_wrong_pubkey()
    test_att_verify_rejects_mutated_soul_id()
    test_att_verify_rejects_mutated_ts_ns()
    test_att_make_bad_shapes_return_zero()
    test_att_verify_zero_inputs()
    test_att_to_wire_round_trip()
    test_att_parse_wire_rejects_short_lines()
    test_store_starts_empty()
    test_store_add_appends()
    test_store_latest_returns_most_recent_by_ts()
    test_store_for_peer_filters_by_id()
    test_store_peer_ids_dedupes()
    test_status_line_for_empty_and_populated_peer()
    test_canonical_message_layout()
    test_make_from_hex_round_trip()
    test_make_from_hex_rejects_bad_root_hex()
    ce_summary("test_snapshot_attestation")
}

main()
