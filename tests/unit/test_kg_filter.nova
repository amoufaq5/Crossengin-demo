// Unit tests for src/factory/kg_filter.nova (R99).
//
// Coverage: capsule-membership match; source-prefix match; license
// match; empty allowlist = no matches; wildcard "*" = all match;
// multi-predicate OR; selected_atoms walk over kg registry.

import "../ce_test.nova"
import "../../src/factory/kg_filter.nova"
import "../../src/factory/bake_manifest.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/util/str_safe.nova"

// Build a fixture: 2 KGs, 4 atoms.
//
// NOTE: capsule membership is stored as a bare atom-id list (existing
// capsule module design predates the R99 filter), so ids from different
// KGs may collide. Tests below scope their assertions accordingly.
//
//   solar_system:
//     - mars   (license OPEN)
//     - phobos (license UNKNOWN)
//   folk_astronomy:
//     - luna   (license CC_BY_SA)
//     - venus  (license OPEN)
// The "planets" capsule claims ONLY solar_system atoms (mars+phobos)
// so the capsule-membership predicate cleanly matches those two.
fn _mk_fixture() {
    let out = list_new()
    let kgreg = kg_registry_new()
    let kg1 = kg_spawn(kgreg, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    atom_set_license(a1, LICENSE_OPEN)
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    let kg2 = kg_spawn(kgreg, "folk_astronomy")
    let a3 = kg_add_atom(kg2, ATOM_FACT, "luna", 0)
    atom_set_license(a3, LICENSE_CC_BY_SA)
    let a4 = kg_add_atom(kg2, ATOM_FACT, "venus", 0)
    atom_set_license(a4, LICENSE_OPEN)
    let capreg = capreg_new()
    let cap = capsule_new("planets", "1.0", "planets", "OPEN")
    capsule_claim_atom(cap, atom_id(a1))
    capsule_claim_atom(cap, atom_id(a2))
    capreg_register(capreg, cap)
    push(out, kgreg)
    push(out, capreg)
    push(out, a1) push(out, a2) push(out, a3) push(out, a4)
    return out
}

// Single-KG fixture for capsule-membership tests. Avoids the cross-KG
// id-collision quirk of the base capsule module (predates R99).
fn _mk_single_kg_fixture() {
    let out = list_new()
    let kgreg = kg_registry_new()
    let kg1 = kg_spawn(kgreg, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    atom_set_license(a1, LICENSE_OPEN)
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    let a3 = kg_add_atom(kg1, ATOM_FACT, "deimos", 0)
    let a4 = kg_add_atom(kg1, ATOM_FACT, "ceres", 0)
    atom_set_license(a4, LICENSE_OPEN)
    let capreg = capreg_new()
    let cap = capsule_new("inner_moons", "1.0", "moons", "OPEN")
    capsule_claim_atom(cap, atom_id(a2))
    capsule_claim_atom(cap, atom_id(a3))
    capreg_register(capreg, cap)
    push(out, kgreg)
    push(out, capreg)
    push(out, a1) push(out, a2) push(out, a3) push(out, a4)
    return out
}

fn test_empty_manifest_selects_nothing() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "empty")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    ce_eq("empty filter selects 0", len(sel), 0)
}

fn test_capsule_membership_pass() {
    let fix = _mk_single_kg_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "cap")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_capsule(m, "inner_moons")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    // capsule "inner_moons" claims phobos + deimos -> 2 atoms
    ce_eq("2 atoms selected via capsule", len(sel), 2)
    // Individual predicate check
    ce_eq("mars rejected (not in capsule)",
          kg_filter_matches(fix[2], atom_id(fix[2]), "solar_system", m, fix[1]), 0)
    ce_eq("phobos passes",
          kg_filter_matches(fix[3], atom_id(fix[3]), "solar_system", m, fix[1]), 1)
    ce_eq("deimos passes",
          kg_filter_matches(fix[4], atom_id(fix[4]), "solar_system", m, fix[1]), 1)
    ce_eq("ceres rejected",
          kg_filter_matches(fix[5], atom_id(fix[5]), "solar_system", m, fix[1]), 0)
}

fn test_capsule_membership_wrong_name() {
    let fix = _mk_single_kg_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "cap2")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_capsule(m, "nonexistent")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    ce_eq("wrong capsule name -> 0 atoms", len(sel), 0)
}

fn test_source_prefix_pass() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "src")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_prefix(m, "solar_")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    ce_eq("2 atoms via solar_ prefix", len(sel), 2)
    ce_eq("mars passes (prefix)",
          kg_filter_matches(fix[2], atom_id(fix[2]), "solar_system", m, fix[1]), 1)
    ce_eq("venus rejected (wrong prefix)",
          kg_filter_matches(fix[5], atom_id(fix[5]), "folk_astronomy", m, fix[1]), 0)
}

fn test_license_pass() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "lic")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_license(m, "OPEN")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    // mars + venus have LICENSE_OPEN
    ce_eq("2 atoms via OPEN license", len(sel), 2)
    ce_eq("luna rejected (CC_BY_SA)",
          kg_filter_matches(fix[4], atom_id(fix[4]), "folk_astronomy", m, fix[1]), 0)
}

fn test_multi_predicates_or() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "multi")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_prefix(m, "solar_")
    bake_manifest_add_kg_license(m, "CC_BY_SA")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    // solar_system atoms (2) + luna (CC_BY_SA) = 3
    ce_eq("3 atoms via OR", len(sel), 3)
}

fn test_wildcard_license() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "star")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_license(m, "*")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    ce_eq("wildcard license = all 4 atoms", len(sel), 4)
}

fn test_wildcard_prefix() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "star")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_prefix(m, "*")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    ce_eq("wildcard prefix = all 4 atoms", len(sel), 4)
}

fn test_no_capreg_capsule_predicate_fails() {
    let fix = _mk_single_kg_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "nc")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_capsule(m, "inner_moons")
    let sel = kg_filter_selected_atoms(fix[0], m, 0)
    ce_eq("no capreg -> 0 via capsule predicate", len(sel), 0)
}

fn test_selected_has() {
    let fix = _mk_fixture()
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "s")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "test")
    bake_manifest_add_kg_prefix(m, "*")
    let sel = kg_filter_selected_atoms(fix[0], m, fix[1])
    ce_eq("finds mars in selection",
          kg_filter_selected_has(sel, "solar_system", atom_id(fix[2])), 1)
    ce_eq("finds venus in selection",
          kg_filter_selected_has(sel, "folk_astronomy", atom_id(fix[5])), 1)
    ce_eq("misses unknown atom",
          kg_filter_selected_has(sel, "solar_system", 99999), 0)
    ce_eq("misses wrong kg",
          kg_filter_selected_has(sel, "wrong_kg", atom_id(fix[2])), 0)
}

fn test_null_kgreg() {
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "z") bake_manifest_set_version(m, "1") bake_manifest_set_domain(m, "d")
    let sel = kg_filter_selected_atoms(0, m, 0)
    ce_eq("null kgreg -> 0", len(sel), 0)
}

fn test_null_manifest() {
    let fix = _mk_fixture()
    let sel = kg_filter_selected_atoms(fix[0], 0, fix[1])
    ce_eq("null manifest -> 0", len(sel), 0)
}

fn main() {
    test_empty_manifest_selects_nothing()
    test_capsule_membership_pass()
    test_capsule_membership_wrong_name()
    test_source_prefix_pass()
    test_license_pass()
    test_multi_predicates_or()
    test_wildcard_license()
    test_wildcard_prefix()
    test_no_capreg_capsule_predicate_fails()
    test_selected_has()
    test_null_kgreg()
    test_null_manifest()
    ce_summary("kg_filter")
}

main()
