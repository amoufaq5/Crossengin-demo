// Unit tests for src/parts/imagination/counterfactual.nova
// Verifies clamp, divergence, and factual-vs-counterfactual comparison.
// ADR-0032.

import "../ce_test.nova"
import "../../src/parts/imagination/counterfactual.nova"

fn one(a) { let l = list_new(); push(l, a); return l }

fn build() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    pattern_new(ikg, "p1", one(1), one(2), 0)
    pattern_new(ikg, "p2", one(2), one(3), 0)
    pattern_new(ikg, "p3", one(3), one(4), 0)
    return ikg
}

fn test_clamp_and_divergence() {
    let st = list_new(); push(st, 1); push(st, 2)
    let c = cf_clamp(st, 1, 5)
    ce_eq("removed", contains(c, 1), 0)
    ce_eq("kept", contains(c, 2), 1)
    ce_eq("added", contains(c, 5), 1)
    let a = list_new(); push(a, 1); push(a, 2); push(a, 3)
    let b = list_new(); push(b, 2); push(b, 4)
    ce_eq("divergence", cf_divergence(a, b), 3)   // {1,3} only in a, {4} only in b
}

fn test_counterfactual() {
    let ikg = build()
    // Removing 1 (and seeding 5, which leads nowhere) changes the outcome a lot.
    let r = counterfactual(ikg, one(1), 1, 5, 3, 0)
    ce_check("factual reaches 4", img_state_has(cf_factual(r), 4) == 1)
    ce_check("cf does not", img_state_has(cf_outcome(r), 4) == 0)
    ce_check("large divergence", cf_divergence_of(r) >= 4)
    // Adding 2 when 1 already yields 2 changes nothing -> zero divergence.
    let r2 = counterfactual(ikg, one(1), -1, 2, 3, 0)
    ce_eq("irrelevant change -> no divergence", cf_divergence_of(r2), 0)
}

fn main() {
    test_clamp_and_divergence()
    test_counterfactual()
    ce_summary("counterfactual")
}

main()
