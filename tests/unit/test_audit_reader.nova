// Unit tests for src/audit/audit_reader.nova
// Verifies chain verification, plain-language rendering, the "why did you do X"
// causal account (from stored trace + goal, no LLM), and outcome queries.
// ADR-0043/0038.

import "../ce_test.nova"
import "../../src/audit/audit_writer.nova"
import "../../src/audit/audit_reader.nova"

fn _populate() {
    let log = audit_open()
    let t = list_new()
    push(t, 11)
    push(t, 12)
    push(t, 13)
    let s = audit_intent(log, ACT_SEND_MSG, 4, t, 0, 100)
    audit_outcome(log, s, OUT_OK, 110)
    let s2 = audit_intent(log, ACT_NET_FETCH, -1, list_new(), 0, 120)
    audit_outcome(log, s2, OUT_FAILED, 130)
    return log
}

fn test_verify_and_render() {
    let log = _populate()
    ce_eq("verify ok", audit_verify(log), 1)
    let r = audit_render(log, 0)
    ce_check("render names action", str_find(r, "send_msg") >= 0)
    ce_check("render shows rev", str_find(r, "irreversible") >= 0)
    ce_check("render shows tier", str_find(r, "approve") >= 0)
    ce_str_eq("render missing", audit_render(log, 99), "no such entry")
}

fn test_why() {
    let log = _populate()
    let w = audit_why(log, 0)
    ce_check("why names action", str_find(w, "send_msg") >= 0)
    ce_check("why cites goal", str_find(w, "goal #4") >= 0)
    ce_check("why counts nodes", str_find(w, "3 node") >= 0)
    ce_check("why explains gating", str_find(w, "irreversible") >= 0)
}

fn test_queries() {
    let log = _populate()
    // Two OK (the two intents are PENDING; outcomes are OK and FAILED).
    ce_eq("one ok outcome", audit_count_outcome(log, OUT_OK), 1)
    ce_eq("one failed", audit_count_outcome(log, OUT_FAILED), 1)
    ce_eq("two pending", audit_count_outcome(log, OUT_PENDING), 2)
    // Most recent entry referencing a NET_FETCH descriptor is the failed outcome.
    ce_check("last net_fetch found", audit_last_for_action(log, ACT_NET_FETCH) >= 0)
    ce_eq("no spend", audit_last_for_action(log, ACT_SPEND), -1)
}

fn main() {
    test_verify_and_render()
    test_why()
    test_queries()
    ce_summary("audit_reader")
}
main()
