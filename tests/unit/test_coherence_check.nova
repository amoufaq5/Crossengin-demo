// Unit tests for src/reader/coherence_check.nova
// Verifies coherence as cross-ref density within the active set: a mutually
// referencing cluster is accepted and bound; unrelated active atoms or any OOV
// token escalate. ADR-0012 stage 4.

import "../ce_test.nova"
import "../../src/reader/context_bias.nova"
import "../../src/reader/spreading_activation.nova"
import "../../src/reader/coherence_check.nova"

// A reciprocal pair c0 <-> c1 reachable from the word "fever".
fn build_coherent() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let med = kg_spawn(reg, "med")
    let c0 = kg_add_atom(med, ATOM_CONCEPT, "pyrexia", 0)
    let c1 = kg_add_atom(med, ATOM_CONCEPT, "infection", 0)
    atom_add_xref(c0, xref_new(c0, c1, XREF_CAUSAL, 800, 1))
    atom_add_xref(c1, xref_new(c1, c0, XREF_CAUSAL, 800, 1))   // reciprocal
    let fever = word_atom_new(lang, "fever", 0)
    word_add_sense(fever, c0, 900)
    return renv_new(reg, lang, 0, 0, 0)
}

fn run(e, text) {
    let c = rctx_new(text)
    reader_anchor(e, c)
    reader_bias(e, c, list_new())
    reader_spread(e, c)
    reader_cohere(e, c)
    return c
}

fn test_coherent_accept() {
    let e = build_coherent()
    let c = run(e, "fever")
    ce_check("active set non-empty", len(rctx_active(c)) >= 2)
    ce_eq("mutually referencing -> coherent", rctx_coherence(c), 1000)
    ce_eq("accepted", reader_accepted(c), 1)
    ce_eq("one binding group", len(rctx_bindings(c)), 1)
}

fn test_unrelated_escalate() {
    // Two words whose senses do not reference each other -> incoherent.
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let k = kg_spawn(reg, "k")
    let a = kg_add_atom(k, ATOM_CONCEPT, "alpha", 0)
    let b = kg_add_atom(k, ATOM_CONCEPT, "beta", 0)
    let wa = word_atom_new(lang, "alpha", 0); word_add_sense(wa, a, 700)
    let wb = word_atom_new(lang, "beta", 0);  word_add_sense(wb, b, 700)
    let e = renv_new(reg, lang, 0, 0, 0)
    let c = run(e, "alpha beta")
    ce_eq("two active", len(rctx_active(c)), 2)
    ce_eq("no mutual refs -> coherence 0", rctx_coherence(c), 0)
    ce_eq("escalates (not accepted)", reader_accepted(c), 0)
    ce_eq("no binding", len(rctx_bindings(c)), 0)
}

fn test_oov_escalates() {
    let e = build_coherent()
    // "fever" is coherent on its own, but an OOV token forces escalation.
    let c = run(e, "fever zzz")
    ce_check("coherent part still scores", rctx_coherence(c) >= COHERE_ACCEPT)
    ce_eq("one curiosity", len(rctx_curiosity(c)), 1)
    ce_eq("OOV forces escalate", reader_accepted(c), 0)
}

fn main() {
    test_coherent_accept()
    test_unrelated_escalate()
    test_oov_escalates()
    ce_summary("coherence_check")
}

main()
