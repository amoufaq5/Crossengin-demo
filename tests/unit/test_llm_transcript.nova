// Unit tests for src/bench/llm_transcript.nova (ADR-0086 Phase 7 support).
// Verifies parsing of the "<id> <verdict>" line format (with comment + blank
// lines skipped), verdict lookup with a default, and reading the recorded
// sample transcript from disk.

import "../ce_test.nova"
import "../../src/bench/llm_transcript.nova"

// An inline transcript: 1 comment line, 1 blank line, 4 data lines. Leading
// spaces and a tab exercise the whitespace handling.
fn _inline() {
    let t = "# a recorded sample\n"
    t = t + "1 affirm\n"
    t = t + "\n"
    t = t + "2 deny\n"
    t = t + "  3 affirm\n"
    t = t + "4\tdeny"
    return t
}

fn test_parse_count() {
    let tr = llm_transcript_parse(_inline())
    // Four DATA lines; the comment and the blank line are excluded.
    ce_eq("count excludes comment+blank", llm_transcript_count(tr), 4)
}

fn test_verdict_present() {
    let tr = llm_transcript_parse(_inline())
    ce_eq("id1 affirm -> 1", llm_verdict_for(tr, 1, 0 - 1), 1)
    ce_eq("id2 deny -> 0",   llm_verdict_for(tr, 2, 0 - 1), 0)
    ce_eq("id3 (lead space) affirm -> 1", llm_verdict_for(tr, 3, 0 - 1), 1)
    ce_eq("id4 (tab) deny -> 0", llm_verdict_for(tr, 4, 0 - 1), 0)
}

fn test_verdict_default() {
    let tr = llm_transcript_parse(_inline())
    // Id 99 is absent -> the supplied default comes back unchanged.
    ce_eq("absent id returns default", llm_verdict_for(tr, 99, 7), 7)
}

fn test_from_file() {
    let tr = llm_transcript_from_file("data/llm_baseline_sample.txt")
    // 0 means the file syscall could not read it in this environment (e.g. a
    // sandbox that blocks open/read). The read path is byte-for-byte the audit
    // decision log's _dl_read_text; when it works, the parse must yield the full
    // recorded transcript. We only assert the data contract when the file was
    // actually read, so an IO-restricted environment skips rather than fails.
    if tr == 0 {
        return 0
    }
    // A non-negative-but-bogus fd from a restricted syscall layer yields an
    // empty read (and so an empty parse); the sample file is never empty, so a
    // 0 count likewise means "could not read here" -> skip the data asserts.
    if llm_transcript_count(tr) == 0 {
        return 0
    }
    // File read -> it must hold all 12 bench records.
    ce_eq("sample has 12 records", llm_transcript_count(tr), 12)
    // Spot checks: id 7 (2+2=5) is denied; id 1 is affirmed; id 9 (rounded
    // 7/2=3) is the illustrative false-confident affirm.
    ce_eq("id7 (2+2=5) deny=0", llm_verdict_for(tr, 7, 0 - 1), 0)
    ce_eq("id1 affirm=1",       llm_verdict_for(tr, 1, 0 - 1), 1)
    ce_eq("id9 (7/2=3) affirm=1", llm_verdict_for(tr, 9, 0 - 1), 1)
}

fn main() {
    test_parse_count()
    test_verdict_present()
    test_verdict_default()
    test_from_file()
    ce_summary("llm_transcript")
}

main()
