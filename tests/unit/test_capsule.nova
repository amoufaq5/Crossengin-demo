// Unit tests for src/capsules/capsule.nova.

import "../ce_test.nova"
import "../../src/capsules/capsule.nova"

fn test_new_shape() {
    let c = capsule_new("medicine", "1.0.0",
        "Reference clinical medicine at Merck Manual level",
        "CC-BY-4.0")
    ce_eq("name", capsule_name(c), "medicine")
    ce_eq("version", capsule_version(c), "1.0.0")
    ce_eq("description length > 0", len(capsule_description(c)) > 0, 1)
    ce_eq("source prefix computed",
          capsule_source_pref(c), "src:cap:medicine:v1.0.0")
    ce_eq("atom refs empty",  capsule_atom_count(c), 0)
    ce_eq("imp refs empty",   capsule_imp_count(c), 0)
    ce_eq("deps empty",       capsule_dep_count(c), 0)
    ce_eq("license",          capsule_license(c), "CC-BY-4.0")
    ce_eq("not installed",    capsule_installed(c), 0)
}

fn test_claim_atom_idempotent() {
    let c = capsule_new("k", "1.0.0", "d", "l")
    ce_eq("first claim new", capsule_claim_atom(c, 42), 1)
    ce_eq("second claim dup", capsule_claim_atom(c, 42), 0)
    ce_eq("atom count = 1", capsule_atom_count(c), 1)
    ce_eq("has atom", capsule_has_atom(c, 42), 1)
    ce_eq("missing atom", capsule_has_atom(c, 99), 0)
}

fn test_claim_imp_idempotent() {
    let c = capsule_new("k", "1.0.0", "d", "l")
    ce_eq("first imp claim", capsule_claim_imp(c, 7), 1)
    ce_eq("second imp claim", capsule_claim_imp(c, 7), 0)
    ce_eq("imp count = 1", capsule_imp_count(c), 1)
    ce_eq("has imp", capsule_has_imp(c, 7), 1)
    ce_eq("missing imp", capsule_has_imp(c, 99), 0)
}

fn test_add_dep() {
    let c = capsule_new("medicine", "1.0.0", "d", "l")
    ce_eq("first dep", capsule_add_dep(c, "biology", "1.0.0"), 1)
    ce_eq("dup dep by name skipped",
          capsule_add_dep(c, "biology", "1.1.0"), 0)
    ce_eq("dep count = 1", capsule_dep_count(c), 1)
    ce_eq("second unique dep",
          capsule_add_dep(c, "human_anatomy", "1.0.0"), 1)
    ce_eq("dep count = 2", capsule_dep_count(c), 2)
}

fn test_install_uninstall() {
    let c = capsule_new("k", "1.0.0", "d", "l")
    ce_eq("first install", capsule_install(c, 100), 1)
    ce_eq("now installed", capsule_installed(c), 1)
    ce_eq("installed_at recorded", capsule_installed_at(c), 100)
    ce_eq("double install no-op", capsule_install(c, 200), 0)
    ce_eq("installed_at unchanged", capsule_installed_at(c), 100)
    ce_eq("uninstall", capsule_uninstall(c), 1)
    ce_eq("not installed", capsule_installed(c), 0)
    ce_eq("double uninstall no-op", capsule_uninstall(c), 0)
}

fn test_shareable_atom_via_multiple_capsules() {
    // Two capsules can both claim the same atom_id; each's atom_refs has it.
    let c1 = capsule_new("biology", "1.0.0", "d", "l")
    let c2 = capsule_new("medicine", "1.0.0", "d", "l")
    capsule_claim_atom(c1, 42)
    capsule_claim_atom(c2, 42)
    ce_eq("c1 has atom", capsule_has_atom(c1, 42), 1)
    ce_eq("c2 has atom", capsule_has_atom(c2, 42), 1)
    ce_eq("each counts 1", capsule_atom_count(c1) + capsule_atom_count(c2), 2)
}

fn main() {
    test_new_shape()
    test_claim_atom_idempotent()
    test_claim_imp_idempotent()
    test_add_dep()
    test_install_uninstall()
    test_shareable_atom_via_multiple_capsules()
    ce_summary("capsule")
}

main()
