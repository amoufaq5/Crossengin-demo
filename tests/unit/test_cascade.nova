// Unit tests for src/mind/cascade.nova + the dep table in src/kg/proofs.nova
// (ADR-0088 increment 7). When a lemma's proof flips to FAILED, every
// downstream proof that used it via HYP must cascade FAILED, and every FORMAL
// atom whose proof_ref is no longer VERIFIED must be unpinned.

import "../ce_test.nova"
import "../../src/mind/cascade.nova"

fn _ax(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

// ---- registry-level: dep edges are recorded at check time ------------------
// Pin p (an axiom), then pin q (using p as a HYP via MP from axiom p->q).
// The kernel must have recorded q's code as a dependent of p's code.
fn _setup_p_then_q() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_imp(p, q)
    // Pin p as an axiom proof.
    let atom_p = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let pkt_p = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    verify_pin_atom(reg, atom_p, pkt_p)
    let code_p = atom_proof_ref(atom_p)
    // Pin q via MP, using HYP for p (rests on code_p) and AXIOM for (p -> q).
    let hyps = hyp_new()
    hyp_add(hyps, "p", p, code_p)
    let proof_q = pf_mp(q, pf_axiom(pq), pf_hyp(p, "p"))
    let atom_q = atom_new(0, 2, ATOM_CONCEPT, "q", 0)
    let pkt_q = verify_packet(_ax(pq), hyps, proof_q, q, "q", "mp-chain")
    verify_pin_atom(reg, atom_q, pkt_q)
    let code_q = atom_proof_ref(atom_q)
    let bundle = list_new()
    push(bundle, reg) push(bundle, atom_p) push(bundle, atom_q)
    push(bundle, code_p) push(bundle, code_q)
    return bundle
}

fn test_dep_edge_recorded() {
    let b = _setup_p_then_q()
    let reg = b[0]
    let code_p = b[3]
    let code_q = b[4]
    let deps = proof_dependents(reg, code_p)
    ce_eq("p has one dependent", len(deps), 1)
    ce_eq("dependent is q's code", deps[0], code_q)
    // q is a leaf in the dep graph: no proof rests on q.
    ce_eq("q has no dependents", len(proof_dependents(reg, code_q)), 0)
}

// ---- registry cascade: invalidating p flips q too --------------------------
fn test_registry_cascade() {
    let b = _setup_p_then_q()
    let reg = b[0]
    let code_p = b[3]
    let code_q = b[4]
    ce_eq("p starts VERIFIED", proof_status(reg, code_p), PROOF_VERIFIED)
    ce_eq("q starts VERIFIED", proof_status(reg, code_q), PROOF_VERIFIED)
    let flipped = proof_invalidate(reg, code_p)
    ce_eq("flipped 2 proofs (p and q)", flipped, 2)
    ce_eq("p is FAILED",  proof_status(reg, code_p), PROOF_FAILED)
    ce_eq("q is FAILED",  proof_status(reg, code_q), PROOF_FAILED)
}

// Invalidating an already-FAILED proof is a no-op (idempotence; guards against
// diamond-shaped dep graphs re-walking).
fn test_invalidate_already_failed_is_noop() {
    let b = _setup_p_then_q()
    let reg = b[0]
    let code_p = b[3]
    proof_invalidate(reg, code_p)            // p+q -> FAILED
    let again = proof_invalidate(reg, code_p) // already failed
    ce_eq("re-invalidate flips 0", again, 0)
}

// ---- diamond dep graph cascades exactly once per proof ---------------------
// p; q rests on p; r rests on p AND q; invalidating p must flip p, q, r.
// r uses p TWICE (via q's chain + direct), so the dep edge can be listed twice
// on p's list -- the FAILED guard must keep the count correct.
fn test_diamond_cascade() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let r = term_atom("r")
    let pq = term_imp(p, q)
    let qr = term_imp(q, r)
    // Pin p.
    let ap = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    verify_pin_atom(reg, ap,
        verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "p"))
    let code_p = atom_proof_ref(ap)
    // Pin q from HYP-p + AXIOM-(p->q) by MP.
    let hyps_q = hyp_new() hyp_add(hyps_q, "p", p, code_p)
    let aq = atom_new(0, 2, ATOM_CONCEPT, "q", 0)
    verify_pin_atom(reg, aq, verify_packet(_ax(pq), hyps_q,
        pf_mp(q, pf_axiom(pq), pf_hyp(p, "p")), q, "q", "mp-pq"))
    let code_q = atom_proof_ref(aq)
    // Pin r from HYP-q + AXIOM-(q->r) by MP. r depends on q which depends on p.
    let hyps_r = hyp_new() hyp_add(hyps_r, "q", q, code_q)
    let ar = atom_new(0, 3, ATOM_CONCEPT, "r", 0)
    verify_pin_atom(reg, ar, verify_packet(_ax(qr), hyps_r,
        pf_mp(r, pf_axiom(qr), pf_hyp(q, "q")), r, "r", "mp-qr"))
    let code_r = atom_proof_ref(ar)

    let flipped = proof_invalidate(reg, code_p)
    ce_eq("cascade flips 3", flipped, 3)
    ce_eq("p FAILED", proof_status(reg, code_p), PROOF_FAILED)
    ce_eq("q FAILED", proof_status(reg, code_q), PROOF_FAILED)
    ce_eq("r FAILED", proof_status(reg, code_r), PROOF_FAILED)
}

// ---- end-to-end: cascade unpins downstream atoms ---------------------------
fn test_cascade_unpins_atoms() {
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_imp(p, q)
    // Use kg_add_atom so the atoms live in the registry the cascade walks.
    let ap = kg_add_atom(kg, ATOM_CONCEPT, "p", 0)
    verify_pin_atom(reg, ap,
        verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "p"))
    let code_p = atom_proof_ref(ap)
    let hyps = hyp_new() hyp_add(hyps, "p", p, code_p)
    let aq = kg_add_atom(kg, ATOM_CONCEPT, "q", 0)
    verify_pin_atom(reg, aq, verify_packet(_ax(pq), hyps,
        pf_mp(q, pf_axiom(pq), pf_hyp(p, "p")), q, "q", "mp"))
    ce_eq("p starts FORMAL", atom_evidence_grade(ap), GRADE_FORMAL)
    ce_eq("q starts FORMAL", atom_evidence_grade(aq), GRADE_FORMAL)
    let p_conf_before = atom_confidence(ap)
    let q_conf_before = atom_confidence(aq)
    ce_check("p pinned high", p_conf_before > 990)
    ce_check("q pinned high", q_conf_before > 990)

    // Cascade-invalidate p: should flip 2 proofs, unpin 2 atoms.
    let result = verify_cascade_invalidate(reg, kgreg, code_p)
    ce_eq("flipped 2 proofs", cascade_flipped(result), 2)
    ce_eq("unpinned 2 atoms", cascade_unpinned(result), 2)
    ce_eq("p grade dropped", atom_evidence_grade(ap), GRADE_UNKNOWN)
    ce_eq("q grade dropped", atom_evidence_grade(aq), GRADE_UNKNOWN)
    ce_eq("p belief reset to prior", atom_confidence(ap), 500)
    ce_eq("q belief reset to prior", atom_confidence(aq), 500)
}

// A second cascade after the first settles finds nothing: idempotence end-to-end.
fn test_cascade_idempotent() {
    let kgreg = kg_registry_new()
    let kg = kg_spawn(kgreg, "math")
    let reg = proof_registry_new()
    let p = term_atom("p")
    let ap = kg_add_atom(kg, ATOM_CONCEPT, "p", 0)
    verify_pin_atom(reg, ap,
        verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "p"))
    let code_p = atom_proof_ref(ap)
    verify_cascade_invalidate(reg, kgreg, code_p)
    let r2 = verify_cascade_invalidate(reg, kgreg, code_p)
    ce_eq("second invalidate flips 0", cascade_flipped(r2), 0)
    ce_eq("second invalidate unpins 0", cascade_unpinned(r2), 0)
}

// An UNRELATED FORMAL atom (different KG, different proof root) is untouched.
fn test_unrelated_atom_not_unpinned() {
    let kgreg = kg_registry_new()
    let math = kg_spawn(kgreg, "math")
    let other = kg_spawn(kgreg, "other")
    let reg = proof_registry_new()
    let p = term_atom("p")
    let r = term_atom("r")
    // FORMAL atom in math, that we will invalidate.
    let ap = kg_add_atom(math, ATOM_CONCEPT, "p", 0)
    verify_pin_atom(reg, ap,
        verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "p"))
    // FORMAL atom in other, independent.
    let ar = kg_add_atom(other, ATOM_CONCEPT, "r", 0)
    verify_pin_atom(reg, ar,
        verify_packet(_ax(r), hyp_new(), pf_axiom(r), r, "r", "r"))
    let r_before = atom_confidence(ar)
    verify_cascade_invalidate(reg, kgreg, atom_proof_ref(ap))
    ce_eq("p was unpinned", atom_evidence_grade(ap), GRADE_UNKNOWN)
    ce_eq("r stays FORMAL", atom_evidence_grade(ar), GRADE_FORMAL)
    ce_eq("r belief unchanged", atom_confidence(ar), r_before)
}

fn main() {
    test_dep_edge_recorded()
    test_registry_cascade()
    test_invalidate_already_failed_is_noop()
    test_diamond_cascade()
    test_cascade_unpins_atoms()
    test_cascade_idempotent()
    test_unrelated_atom_not_unpinned()
    ce_summary("cascade")
}

main()
