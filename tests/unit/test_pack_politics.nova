// End-to-end test: ingest data/packs/politics.cerec.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn test_politics_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec", "data/packs/politics.cerec",
                          "politics", "src:pack:politics:v1", "", 0)
    ce_eq("1 record", ing_sum_ok(s), 1)
    ce_eq("73 atoms added", ing_sum_atoms(s), 73)
    ce_eq("0 parse errors", ing_sum_errors(s), 0)
    ce_eq("0 queued (trusted src:pack:)", ing_sum_queued(s), 0)
}

fn test_headline_systems_ideologies_present() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/politics.cerec",
                  "politics", "src:pack:politics:v1", "", 0)
    let kgreg = ing_kgreg(a)
    let n = kg_count(kgreg)
    let pkg = 0
    let i = 0
    while i < n {
        let k = kg_get(kgreg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "politics") == 1 { pkg = k } }
        i = i + 1
    }
    ce_check("politics KG exists", pkg != 0)
    // Systems
    ce_check("democracy present", kg_find_atom(pkg, "democracy") != 0)
    ce_check("republic present",  kg_find_atom(pkg, "republic") != 0)
    ce_check("monarchy present",  kg_find_atom(pkg, "monarchy") != 0)
    ce_check("federalism present", kg_find_atom(pkg, "federalism") != 0)
    // Ideologies (documented, not endorsed)
    ce_check("liberalism present",   kg_find_atom(pkg, "liberalism") != 0)
    ce_check("conservatism present", kg_find_atom(pkg, "conservatism") != 0)
    ce_check("socialism present",    kg_find_atom(pkg, "socialism") != 0)
    // Institutions + concepts
    ce_check("rule_of_law present", kg_find_atom(pkg, "rule_of_law") != 0)
    ce_check("separation_of_powers present",
             kg_find_atom(pkg, "separation_of_powers") != 0)
    // International bodies
    ce_check("united_nations present", kg_find_atom(pkg, "united_nations") != 0)
}

fn test_politics_agrees_with_world_history() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/politics.cerec",
                  "politics", "src:pack:politics:v1", "", 0)
    ing_agent_run(a, "cerec", "data/packs/world_history.cerec",
                  "history", "src:pack:world_history:v1", "", 0)
    // Both packs list french_revolution_1789 + us_independence_1776 at 950,
    // and 'person' at 950. Cross-KG scan should NOT surface politics<->
    // history conflicts on those labels.
    let conflicts = mkgc_scan_conflicts(ing_kgreg(a), 100)
    let cross_pack_conflicts = 0
    let i = 0
    while i < len(conflicts) {
        let c = conflicts[i]
        let ka = mkgc_conflict_kg_a(c)
        let kb = mkgc_conflict_kg_b(c)
        let touches_pol = 0
        let touches_hist = 0
        if str_eq_bytes(ka, "politics") == 1 { touches_pol = 1 }
        if str_eq_bytes(kb, "politics") == 1 { touches_pol = 1 }
        if str_eq_bytes(ka, "history") == 1 { touches_hist = 1 }
        if str_eq_bytes(kb, "history") == 1 { touches_hist = 1 }
        if touches_pol == 1 { if touches_hist == 1 {
            cross_pack_conflicts = cross_pack_conflicts + 1
        } }
        i = i + 1
    }
    ce_eq("politics + history agree on shared labels", cross_pack_conflicts, 0)
}

fn test_source_attribution() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/politics.cerec",
                  "politics", "src:pack:politics:v1", "", 0)
    let report = mo_report(ing_mo(a))
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:politics:v1") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("politics pack source attributed via meta-observer", saw, 1)
}

fn main() {
    test_politics_ingests_cleanly()
    test_headline_systems_ideologies_present()
    test_politics_agrees_with_world_history()
    test_source_attribution()
    ce_summary("pack_politics")
}

main()
