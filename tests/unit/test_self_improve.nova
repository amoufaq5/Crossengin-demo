// Unit tests for src/parts/meta/self_improve.nova (P5, ADR-0055).
//
// Covered: the value table + TD backup; the ACCEPTANCE criterion -- the agent
// improves its task return across sessions learning ONLY from its own logged
// experience (no teaching), converging to the optimal path; and the bounded
// self-edit -- a proposed self-change is constitutionally gated (vetoed edits
// never run; APPROVE-tier edits need approval) and every attempt is written to
// the hash-chained decision log (audited + reversible).
//
// ADR-0055, ADR-0045, ADR-0043, ADR-0024.

import "../ce_test.nova"
import "../../src/parts/meta/self_improve.nova"
import "../../src/parts/soul/state.nova"
import "../../src/kg/skills_kg.nova"

fn test_qtable() {
    let q = q_new(4, 3, 0)
    ce_eq("rows", len(q), 4)
    ce_eq("cols", len(q[0]), 3)
    ce_eq("init value", q_get(q, 2, 1), 0)
    q_set(q, 2, 1, 50)
    ce_eq("set/get", q_get(q, 2, 1), 50)
    ce_eq("argmax", q_argmax(q, 2, 3), 1)
    ce_eq("max", q_max(q, 2, 3), 50)
}

fn test_td_update() {
    let q = q_new(2, 2, 0)
    si_update(q, 0, 0, 100, 1, 1, 2)               // terminal: target = reward
    ce_eq("terminal target = reward", q_get(q, 0, 0), 100)
    q_set(q, 1, 0, 100)
    si_update(q, 0, 1, 0 - 1, 1, 0, 2)             // -1 + 0.9 * 100 = 89
    ce_eq("bootstrapped target", q_get(q, 0, 1), 89)
}

// ACCEPTANCE: improves a task metric across sessions from its own experience.
fn test_improves_across_sessions() {
    let world = world_new(4, 4, 0, 0, 3, 3)
    let q = q_new(world_n_states(world), world_actions(), 0)
    let before = si_eval(world, q, 100)
    ce_check("untrained policy fails to reach the goal", before[0] < 0)
    si_train(world, q, 60, 100, 12345)            // learn only from logged reward
    let after = si_eval(world, q, 100)
    ce_check("trained policy improved its return", after[0] > before[0])
    ce_eq("trained policy reaches the goal optimally", after[1], world_optimal_steps(world))
    ce_check("trained return is near the optimum", after[0] >= 90)
}

fn test_bounded_self_edit() {
    let dl = dl_new()
    let sl = soul_new("Aurora")
    soul_add_constitution(sl, "disable safety", CONST_BLOCK)
    // benign + approved -> accepted, executes, logged OK
    let e1 = si_self_edit(sl, dl, "adopt navigation rule for state 0", 101, 1, 1)
    ce_eq("benign+approved accepted", e1[0], 1)
    ce_eq("decision execute", e1[1], GATE_EXECUTE)
    // ACT_SELF_MODIFY without approval -> suspended (bounded)
    let e2 = si_self_edit(sl, dl, "adjust policy weights", 102, 0, 2)
    ce_eq("unapproved not accepted", e2[0], 0)
    ce_eq("decision suspend", e2[1], GATE_SUSPEND)
    // constitutionally forbidden -> vetoed even with approval
    let e3 = si_self_edit(sl, dl, "disable safety immediately", 103, 1, 3)
    ce_eq("forbidden not accepted", e3[0], 0)
    ce_eq("decision veto", e3[1], GATE_VETOED)
    // every attempt is audited (intent + outcome), chain verifies
    ce_eq("three edits -> six log entries", dl_count(dl), 6)
    ce_eq("audit chain verifies (tamper-evident)", dl_verify(dl), 1)
}

// Task 1: forward-sim lookahead planning over world_peek reaches the goal.
fn test_plan_reaches_goal() {
    let world = world_new(4, 4, 0, 0, 3, 3)
    let q = q_new(world_n_states(world), world_actions(), 0)
    si_train(world, q, 60, 100, 12345)
    // depth-0 planning == greedy tabular policy (sanity: same as si_eval).
    let p0 = si_eval_plan(world, q, 100, 0)
    ce_eq("depth-0 plan reaches goal optimally", p0[1], world_optimal_steps(world))
    // depth-3 lookahead also reaches the goal optimally on the trained table.
    let p3 = si_eval_plan(world, q, 100, 3)
    ce_eq("depth-3 plan reaches goal optimally", p3[1], world_optimal_steps(world))
    ce_check("depth-3 plan return near optimum", p3[0] >= 90)
    // Planning compensates for an UNDER-trained table: lookahead with the model
    // still solves the world where the greedy tabular policy stalls. Use a fresh
    // untrained table; deep enough lookahead spans the whole 4x4 grid.
    let qu = q_new(world_n_states(world), world_actions(), 0)
    let greedy = si_eval(world, qu, 100)
    ce_check("untrained greedy fails to reach goal", greedy[0] < 0)
    let planned = si_eval_plan(world, qu, 100, 8)
    ce_eq("deep lookahead solves it untrained", planned[1], world_optimal_steps(world))
    // si_plan_action is a pure prediction: choosing does not move the agent.
    world_reset(world)
    let a = si_plan_action(world, q, 3)
    ce_check("plan_action returns a valid action", a >= 0)
    ce_check("plan_action returns a valid action (hi)", a < world_actions())
    ce_eq("plan_action did NOT move the agent", world_state_id(world), 0)
}

// Task 2: HDC state features -- same state identical, distinct near-orthogonal.
fn test_state_features() {
    let v0 = si_state_vector(0)
    ce_eq("state vector has HDC dimensionality", len(v0), hdc_dims())
    // Same state id -> byte-identical feature (cosine == 1000 milli).
    ce_eq("same state is identical", si_state_similarity(5, 5), 1000)
    // Distinct states -> near-orthogonal (|cosine| small). Random D=10000
    // bipolar vectors score ~0; allow a generous band well below "similar".
    let sim01 = si_state_similarity(0, 1)
    ce_check("distinct states near-orthogonal (0 vs 1)", sim01 < 200)
    ce_check("distinct states near-orthogonal (0 vs 1, lo)", sim01 > 0 - 200)
    let sim_far = si_state_similarity(3, 14)
    ce_check("distinct states near-orthogonal (3 vs 14)", sim_far < 200)
    ce_check("distinct states near-orthogonal (3 vs 14, lo)", sim_far > 0 - 200)
}

// Task 3: serialize/restore the value table -- round-trip gives the same eval.
fn test_q_persistence() {
    let world = world_new(4, 4, 0, 0, 3, 3)
    let q = q_new(world_n_states(world), world_actions(), 0)
    si_train(world, q, 60, 100, 12345)
    let before = si_eval(world, q, 100)
    // Serialize -> restore at the same shape.
    let text = si_q_serialize(q)
    let q2 = si_q_restore(text, world_n_states(world), world_actions())
    // Restored table is value-identical (spot-check a couple of cells).
    ce_eq("restored cell [0][argmax] matches", q_get(q2, 0, q_argmax(q, 0, world_actions())), q_get(q, 0, q_argmax(q, 0, world_actions())))
    ce_eq("restored argmax at start matches", q_argmax(q2, 0, world_actions()), q_argmax(q, 0, world_actions()))
    // The honest test: the restored table yields the SAME greedy eval.
    let after = si_eval(world, q2, 100)
    ce_eq("restored eval return matches", after[0], before[0])
    ce_eq("restored eval steps matches", after[1], before[1])
    ce_eq("restored eval still optimal", after[1], world_optimal_steps(world))
    // Negative values round-trip (step reward is -1): set, serialize, restore.
    let qn = q_new(2, 2, 0)
    q_set(qn, 1, 0, 0 - 7)
    q_set(qn, 0, 1, 89)
    let qn2 = si_q_restore(si_q_serialize(qn), 2, 2)
    ce_eq("negative cell round-trips", q_get(qn2, 1, 0), 0 - 7)
    ce_eq("positive cell round-trips", q_get(qn2, 0, 1), 89)
}

// Task 4: an accepted self-edit mints exactly one rule atom; a vetoed or
// suspended one mints none (the gate still bounds what becomes live).
fn test_apply_edit_mints() {
    let world = world_new(4, 4, 0, 0, 3, 3)
    let q = q_new(world_n_states(world), world_actions(), 0)
    si_train(world, q, 60, 100, 12345)
    let n = world_actions()
    let dl = dl_new()
    let sl = soul_new("Aurora")
    soul_add_constitution(sl, "disable safety", CONST_BLOCK)
    let reg = kg_registry_new()
    let skg = skills_kg_init(reg)
    ce_eq("skills KG starts empty", len(kg_atoms_by_kind(skg, ATOM_RULE)), 0)
    // benign + approved -> accepted -> mints exactly one rule atom for state 0.
    let e1 = si_apply_edit(sl, dl, skg, q, 0, n, 201, 1, 1)
    ce_eq("accepted edit accepted", e1[0], 1)
    ce_eq("accepted edit decision execute", e1[1], GATE_EXECUTE)
    ce_check("accepted edit minted an atom (id >= 0)", e1[3] >= 0)
    ce_eq("exactly one rule atom after accept", len(kg_atoms_by_kind(skg, ATOM_RULE)), 1)
    // the minted rule prescribes the learned best action for state 0.
    ce_eq("minted rule action == learned argmax", si_rule_action_for(skg, 0), q_argmax(q, 0, n))
    // unapproved ACT_SELF_MODIFY -> suspended -> mints NOTHING.
    let e2 = si_apply_edit(sl, dl, skg, q, 1, n, 202, 0, 2)
    ce_eq("suspended edit not accepted", e2[0], 0)
    ce_eq("suspended edit decision suspend", e2[1], GATE_SUSPEND)
    ce_eq("suspended edit minted nothing (id -1)", e2[3], 0 - 1)
    ce_eq("still exactly one rule atom after suspend", len(kg_atoms_by_kind(skg, ATOM_RULE)), 1)
    // constitutionally forbidden text -> vetoed even with approval -> mints
    // nothing. si_apply_edit builds the edit text from the rule; to exercise the
    // veto we vet a forbidden text directly via si_self_edit and confirm no mint
    // path runs (apply_edit only mints when si_self_edit accepts).
    let e3 = si_self_edit(sl, dl, "disable safety now", 203, 1, 3)
    ce_eq("forbidden edit vetoed", e3[1], GATE_VETOED)
    ce_eq("forbidden edit not accepted", e3[0], 0)
    ce_eq("veto minted nothing -- still one rule atom", len(kg_atoms_by_kind(skg, ATOM_RULE)), 1)
    // the whole audited chain still verifies (tamper-evident rollback record).
    ce_eq("audit chain verifies", dl_verify(dl), 1)
}

fn main() {
    test_qtable()
    test_td_update()
    test_improves_across_sessions()
    test_bounded_self_edit()
    test_plan_reaches_goal()
    test_state_features()
    test_q_persistence()
    test_apply_edit_mints()
    ce_summary("self_improve")
}

main()
