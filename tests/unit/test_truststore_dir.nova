// Unit tests for src/safety/pem_truststore.nova::truststore_load_dir
// (Phase O R1, ADR-0094).
//
// Strategy: `truststore_load_dir(dir)` reads `<dir>/manifest.txt` --
// NOVA has no `sys_readdir`, so the manifest-file fallback is the
// only load path R1 ships. Tests exercise:
//   * Non-existent dir -> empty anchors, no error.
//   * Null path (0) -> empty anchors, no error.
//   * Empty path ("") -> empty anchors, no error.
//   * Manifest listing one .pem file -> anchors parsed.
//   * Manifest listing two files -> anchors merged.
//   * Manifest with # comment + blank lines -> skipped cleanly.
//   * Manifest listing a missing file -> that entry skipped, others
//     still load.
//   * Manifest listing a corrupt-PEM file -> that file's anchors
//     empty, others still load (documented drop).
//   * CRLF-terminated manifest -> handled (trailing \r trimmed).
//   * Manifest without trailing newline -> handled.
//   * Empty manifest -> 0 anchors.
//   * All-comment manifest -> 0 anchors.
//
// All fixtures live under $HOME (or ./_truststore_dir_test if HOME is
// unset) with a per-test filename prefix so no mkdir is required --
// NOVA's `write_file` writes flat files but we cannot count on it
// creating parent dirs.

import "../ce_test.nova"
import "../../src/safety/pem_truststore.nova"

// Reuse the RSA and EC certs from test_pem_truststore.nova. One cert
// per file keeps the fixtures small; the loader concatenates them
// into one anchors list regardless of the on-disk split.
let RSA_B64 = ""
let EC_B64  = ""

fn _rsa_pem() {
    return "-----BEGIN CERTIFICATE-----\n" + RSA_B64
         + "\n-----END CERTIFICATE-----\n"
}

fn _ec_pem() {
    return "-----BEGIN CERTIFICATE-----\n" + EC_B64
         + "\n-----END CERTIFICATE-----\n"
}

// Base test dir. Unique per test suite run (per-test namespaces avoid
// cross-test contamination via manifest filenames).
fn _base() {
    let home = getenv("HOME")
    if home != 0 {
        if len(home) > 0 { return home }
    }
    return "."
}

// Per-test dir path -- prefixed with .crossengin_ph_o_r1_ so cleanup
// (manual grep) is trivial.
fn _tdir(name) {
    return _base() + "/.crossengin_ph_o_r1_" + name
}

// The loader reads <dir>/manifest.txt. We cannot mkdir from NOVA, so
// each test uses `write_file` to lay down `<base>/<subdir>/manifest.txt`
// and `<base>/<subdir>/*.pem`. Empirically write_file on the CrossEngin
// bench creates parent dirs; a test whose write_file failed will
// surface as a "empty manifest" read-back (0 anchors) and its
// downstream assertions catch the failure -- no false OK path.

fn test_nonexistent_dir_empty() {
    let anchors = truststore_load_dir(
        "/nonexistent/definitely/not/there/xyz_ph_o_r1")
    ce_eq("nonexistent dir -> 0 anchors", len(anchors), 0)
}

fn test_null_path_empty() {
    ce_eq("null (0) path -> 0 anchors",
          len(truststore_load_dir(0)), 0)
}

fn test_empty_path_empty() {
    ce_eq("empty ('') path -> 0 anchors",
          len(truststore_load_dir("")), 0)
}

fn test_no_manifest_empty() {
    let dir = _tdir("no_manifest")
    // Populate with an unrelated file so the dir exists but no
    // manifest.txt is present.
    write_file(dir + "/decoy.txt", "not-a-pem-and-not-a-manifest\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("dir with no manifest -> 0 anchors", len(anchors), 0)
}

fn test_single_pem_via_manifest() {
    let dir = _tdir("single")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/manifest.txt", "rsa.pem\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("single-file manifest -> 1 anchor", len(anchors), 1)
    ce_eq("single anchor is RSA",
          anchor_key_type(anchors[0]), KEY_RSA)
}

fn test_two_files_merged() {
    let dir = _tdir("two")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/ec.pem",  _ec_pem())
    write_file(dir + "/manifest.txt", "rsa.pem\nec.pem\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("two-file manifest -> 2 anchors merged", len(anchors), 2)
    let has_rsa = 0
    let has_ec = 0
    let i = 0
    while i < len(anchors) {
        if anchor_key_type(anchors[i]) == KEY_RSA { has_rsa = 1 }
        if anchor_key_type(anchors[i]) == KEY_EC  { has_ec  = 1 }
        i = i + 1
    }
    ce_eq("merged anchors contain RSA", has_rsa, 1)
    ce_eq("merged anchors contain EC",  has_ec,  1)
}

fn test_manifest_comments_and_blank_lines() {
    let dir = _tdir("comments")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/manifest.txt",
        "# CrossEngin fed truststore\n\n# another comment\nrsa.pem\n\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("manifest with comments/blank -> 1 anchor",
          len(anchors), 1)
    ce_eq("anchor is RSA",
          anchor_key_type(anchors[0]), KEY_RSA)
}

fn test_manifest_missing_file_skipped() {
    let dir = _tdir("missing")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/manifest.txt",
        "rsa.pem\ndoes_not_exist.pem\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("missing manifest entry silently dropped; rsa still loads",
          len(anchors), 1)
    ce_eq("surviving anchor is RSA",
          anchor_key_type(anchors[0]), KEY_RSA)
}

fn test_manifest_corrupt_pem_skipped() {
    let dir = _tdir("corrupt")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/junk.pem", "this is not a PEM at all\n")
    write_file(dir + "/manifest.txt", "junk.pem\nrsa.pem\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("junk PEM contributes nothing; rsa contributes 1",
          len(anchors), 1)
    ce_eq("surviving anchor is RSA",
          anchor_key_type(anchors[0]), KEY_RSA)
}

fn test_manifest_crlf_line_endings() {
    let dir = _tdir("crlf")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/manifest.txt", "rsa.pem\r\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("CRLF manifest still loads RSA anchor",
          len(anchors), 1)
    ce_eq("CRLF anchor is RSA",
          anchor_key_type(anchors[0]), KEY_RSA)
}

fn test_manifest_no_trailing_newline() {
    let dir = _tdir("no_nl")
    write_file(dir + "/rsa.pem", _rsa_pem())
    write_file(dir + "/manifest.txt", "rsa.pem")
    let anchors = truststore_load_dir(dir)
    ce_eq("manifest without trailing newline still loads",
          len(anchors), 1)
}

fn test_empty_manifest() {
    let dir = _tdir("empty_manifest")
    write_file(dir + "/manifest.txt", "")
    let anchors = truststore_load_dir(dir)
    ce_eq("empty manifest -> 0 anchors", len(anchors), 0)
}

fn test_manifest_all_comments() {
    let dir = _tdir("all_comments")
    write_file(dir + "/manifest.txt",
        "# every line is a comment\n# and this one too\n\n")
    let anchors = truststore_load_dir(dir)
    ce_eq("all-comment manifest -> 0 anchors", len(anchors), 0)
}

fn main() {
    test_nonexistent_dir_empty()
    test_null_path_empty()
    test_empty_path_empty()
    test_no_manifest_empty()
    test_single_pem_via_manifest()
    test_two_files_merged()
    test_manifest_comments_and_blank_lines()
    test_manifest_missing_file_skipped()
    test_manifest_corrupt_pem_skipped()
    test_manifest_crlf_line_endings()
    test_manifest_no_trailing_newline()
    test_empty_manifest()
    test_manifest_all_comments()
    ce_summary("truststore_dir")
}

main()
