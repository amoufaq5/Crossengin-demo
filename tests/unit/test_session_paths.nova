// Unit tests for the per-session path helpers (P1.2) in src/session/session.nova.
//
// Verifies the precedence contract for `session_snap_path_resolve`,
// `session_dlog_path_resolve`, and `session_id_resolve`:
//
//   1. The first argument (the legacy single-file env override) wins outright.
//   2. else the second argument (the directory env override; or "/tmp" when
//      unset) combined with the per-session filename template
//      `crossengin.<session_id>.<snap|dlog>`.
//   3. The session id 0 / "" resolves to "default" so the derived filename
//      is always non-empty.
//
// The unit tests target the PURE resolvers (which take the env-style strings
// as explicit arguments) so the suite does not need to mutate the process
// environment -- NOVA exposes `getenv` but not `setenv`/`putenv`, and the
// thin env-reading wrappers are exercised end-to-end by the integration
// suite in `tests/integration/scenario_h2_session_paths.sh`.

import "../ce_test.nova"
import "../../src/session/session.nova"

// ---- snap path: default + per-session id derivation ----------------------

fn test_snap_path_default_id_uses_tmp() {
    // No env overrides at all: 0/0 simulates both CE_SNAP_PATH and
    // CE_SNAP_DIR being unset (the `getenv` call returned 0).
    let p = session_snap_path_resolve(0, 0, "default")
    ce_str_eq("default id derives /tmp/crossengin.default.snap",
        p, "/tmp/crossengin.default.snap")
}

fn test_snap_path_named_id() {
    let p = session_snap_path_resolve(0, 0, "alice")
    ce_str_eq("alice id derives /tmp/crossengin.alice.snap",
        p, "/tmp/crossengin.alice.snap")
}

fn test_snap_path_zero_id_falls_back_to_default() {
    // Callers may pass 0 (NOVA's empty/no-value sentinel) for an unset id;
    // the helper must fall back to "default" so the path is never broken.
    let p = session_snap_path_resolve(0, 0, 0)
    ce_str_eq("id=0 falls back to default", p, "/tmp/crossengin.default.snap")
}

fn test_snap_path_empty_id_falls_back_to_default() {
    let p = session_snap_path_resolve(0, 0, "")
    ce_str_eq("empty id falls back to default", p, "/tmp/crossengin.default.snap")
}

// ---- snap path: $CE_SNAP_DIR override ------------------------------------

fn test_snap_path_dir_env_overrides_tmp() {
    let p = session_snap_path_resolve(0, "/var/lib/ce", "alice")
    ce_str_eq("CE_SNAP_DIR routes per-session file",
        p, "/var/lib/ce/crossengin.alice.snap")
}

fn test_snap_path_empty_dir_env_falls_back_to_tmp() {
    // An EXPLICITLY-empty CE_SNAP_DIR should be treated as unset and the
    // helper should fall back to /tmp.
    let p = session_snap_path_resolve(0, "", "alice")
    ce_str_eq("empty CE_SNAP_DIR falls back to /tmp",
        p, "/tmp/crossengin.alice.snap")
}

// ---- snap path: $CE_SNAP_PATH legacy override wins -----------------------

fn test_snap_path_path_env_beats_everything() {
    let p = session_snap_path_resolve("/custom/legacy.snap", "/var/lib/ce", "alice")
    ce_str_eq("CE_SNAP_PATH beats CE_SNAP_DIR + session id",
        p, "/custom/legacy.snap")
}

fn test_snap_path_path_env_beats_default() {
    let p = session_snap_path_resolve("/some/where.snap", 0, "default")
    ce_str_eq("CE_SNAP_PATH wins even for default session id",
        p, "/some/where.snap")
}

fn test_snap_path_empty_path_env_falls_through() {
    // An explicitly-EMPTY CE_SNAP_PATH should NOT win -- the helper treats it
    // as unset so callers don't have to "" -> default themselves.
    let p = session_snap_path_resolve("", 0, "alice")
    ce_str_eq("empty CE_SNAP_PATH falls through to default derivation",
        p, "/tmp/crossengin.alice.snap")
}

// ---- dlog path: parallel precedence shape --------------------------------
// Same three branches but the function name + suffix is ".dlog". Confirms
// the dlog helper is genuinely a separate resolver (the daemon and chat
// call it with the dlog env namespace).

fn test_dlog_path_default_id_uses_tmp() {
    let p = session_dlog_path_resolve(0, 0, "default")
    ce_str_eq("default id derives /tmp/crossengin.default.dlog",
        p, "/tmp/crossengin.default.dlog")
}

fn test_dlog_path_named_id() {
    let p = session_dlog_path_resolve(0, 0, "bob")
    ce_str_eq("named id derives /tmp/crossengin.bob.dlog",
        p, "/tmp/crossengin.bob.dlog")
}

fn test_dlog_path_dir_env_overrides_tmp() {
    let p = session_dlog_path_resolve(0, "/audit", "alice")
    ce_str_eq("CE_DLOG_DIR routes per-session dlog",
        p, "/audit/crossengin.alice.dlog")
}

fn test_dlog_path_path_env_beats_everything() {
    let p = session_dlog_path_resolve("/legacy/audit.dlog", "/audit", "alice")
    ce_str_eq("CE_DLOG_PATH beats CE_DLOG_DIR + session id",
        p, "/legacy/audit.dlog")
}

fn test_dlog_path_empty_id_falls_back_to_default() {
    let p = session_dlog_path_resolve(0, 0, "")
    ce_str_eq("empty id falls back to default for dlog",
        p, "/tmp/crossengin.default.dlog")
}

// ---- session_id_resolve: env-value semantics -----------------------------

fn test_session_id_resolve_default() {
    let id = session_id_resolve(0)
    ce_str_eq("unset env -> 'default'", id, "default")
}

fn test_session_id_resolve_set() {
    let id = session_id_resolve("alice")
    ce_str_eq("env=alice -> 'alice'", id, "alice")
}

fn test_session_id_resolve_empty_falls_back() {
    let id = session_id_resolve("")
    ce_str_eq("empty env -> 'default'", id, "default")
}

// ---- end-to-end env-wrapper sanity ---------------------------------------
// The thin env-reading wrappers must produce a well-formed default path when
// no env vars are set. This pins the "out of the box" experience.

fn test_session_snap_path_wrapper_default() {
    // No CE_SNAP_PATH / CE_SNAP_DIR are set in the test environment, so the
    // wrapper should hit the default branch.
    let p = session_snap_path("default")
    ce_str_eq("wrapper default snap path", p, "/tmp/crossengin.default.snap")
}

fn test_session_dlog_path_wrapper_default() {
    let p = session_dlog_path("default")
    ce_str_eq("wrapper default dlog path", p, "/tmp/crossengin.default.dlog")
}

fn test_session_id_from_env_wrapper_default() {
    let id = session_id_from_env()
    ce_str_eq("wrapper default id", id, "default")
}

// ---- format invariants ---------------------------------------------------
// Cross-check that the snap and dlog paths only differ in suffix when the
// inputs are identical -- a future refactor that accidentally crosses the
// wires (e.g. .dlog written into the snap path) would break this.

fn test_snap_and_dlog_only_differ_in_suffix() {
    let snap = session_snap_path_resolve(0, "/var/spool/ce", "alice")
    let dlog = session_dlog_path_resolve(0, "/var/spool/ce", "alice")
    ce_str_eq("snap suffix is .snap",
        snap, "/var/spool/ce/crossengin.alice.snap")
    ce_str_eq("dlog suffix is .dlog",
        dlog, "/var/spool/ce/crossengin.alice.dlog")
}

fn main() {
    test_snap_path_default_id_uses_tmp()
    test_snap_path_named_id()
    test_snap_path_zero_id_falls_back_to_default()
    test_snap_path_empty_id_falls_back_to_default()
    test_snap_path_dir_env_overrides_tmp()
    test_snap_path_empty_dir_env_falls_back_to_tmp()
    test_snap_path_path_env_beats_everything()
    test_snap_path_path_env_beats_default()
    test_snap_path_empty_path_env_falls_through()
    test_dlog_path_default_id_uses_tmp()
    test_dlog_path_named_id()
    test_dlog_path_dir_env_overrides_tmp()
    test_dlog_path_path_env_beats_everything()
    test_dlog_path_empty_id_falls_back_to_default()
    test_session_id_resolve_default()
    test_session_id_resolve_set()
    test_session_id_resolve_empty_falls_back()
    test_session_snap_path_wrapper_default()
    test_session_dlog_path_wrapper_default()
    test_session_id_from_env_wrapper_default()
    test_snap_and_dlog_only_differ_in_suffix()
    ce_summary("session_paths")
}

main()
