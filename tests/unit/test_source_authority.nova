// Unit tests for src/learning/source_authority.nova
// Verifies tier weights and increments, domain->tier mapping, recency-policy
// conflict resolution, user-taught precedence, and hard-conflict detection.
// ADR-0029.

import "../ce_test.nova"
import "../../src/learning/source_authority.nova"

fn test_weights() {
    ce_eq("tier A weight", sa_weight(SA_TIER_A), 1000)
    ce_eq("tier B weight", sa_weight(SA_TIER_B), 500)
    ce_eq("tier C weight", sa_weight(SA_TIER_C), 200)
    ce_eq("tier A increment", sa_increment(SA_TIER_A), 3000)
    ce_eq("tier B increment", sa_increment(SA_TIER_B), 1500)
    ce_eq("tier C increment", sa_increment(SA_TIER_C), 600)
}

fn test_mapping() {
    let sa = sa_default()
    ce_eq("who is tier A", sa_tier(sa, "https://www.who.int/news"), SA_TIER_A)
    ce_eq("wikipedia is tier B", sa_tier(sa, "https://en.wikipedia.org/wiki/X"), SA_TIER_B)
    ce_eq("unknown is tier C", sa_tier(sa, "https://random.example/x"), SA_TIER_C)
    ce_eq("who policy normative", sa_policy(sa, "https://www.who.int/g"), SA_NORMATIVE)
    ce_eq("url weight via tier", sa_url_weight(sa, "https://en.wikipedia.org/x"), 500)
    ce_eq("url increment via tier", sa_url_increment(sa, "https://www.who.int/x"), 3000)
}

fn test_resolution() {
    // Higher tier wins regardless of recency.
    ce_eq("tier A beats B", sa_resolve(SA_TIER_A, 1, SA_TIER_B, 100, SA_NEUTRAL), 1)
    ce_eq("tier A beats C (b->a)", sa_resolve(SA_TIER_C, 100, SA_TIER_A, 1, SA_NEUTRAL), 2)
    // Same tier: normative -> newest wins; classical -> oldest wins.
    ce_eq("normative newest", sa_resolve(SA_TIER_B, 5, SA_TIER_B, 9, SA_NORMATIVE), 2)
    ce_eq("classical oldest", sa_resolve(SA_TIER_B, 5, SA_TIER_B, 9, SA_CLASSICAL), 1)
    ce_eq("neutral combine", sa_resolve(SA_TIER_B, 5, SA_TIER_B, 9, SA_NEUTRAL), 0)
    // User-taught outranks a non-user claim within the same tier.
    ce_eq("user outranks fetched same tier", sa_resolve_sourced(SA_TIER_A, 1, 5, SA_TIER_A, 0, 9, SA_NEUTRAL), 1)
}

fn test_hard_conflict() {
    // Two Tier-A sources disagreeing.
    ce_eq("two tier-A hard", sa_is_hard_conflict(SA_TIER_A, 0, SA_TIER_A, 0, 0, 0), 1)
    // Fetched contradicts user-taught.
    ce_eq("fetched vs user hard", sa_is_hard_conflict(SA_TIER_A, 1, SA_TIER_B, 0, 0, 0), 1)
    // A high-confidence atom would be overturned.
    ce_eq("overturn high-conf hard", sa_is_hard_conflict(SA_TIER_B, 0, SA_TIER_C, 0, 21000, 850), 1)
    // Ordinary low-stakes disagreement is not hard.
    ce_eq("ordinary not hard", sa_is_hard_conflict(SA_TIER_B, 0, SA_TIER_C, 0, 3000, 600), 0)
}

fn main() {
    test_weights()
    test_mapping()
    test_resolution()
    test_hard_conflict()
    ce_summary("source_authority")
}

main()
