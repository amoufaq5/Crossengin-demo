// CE_TEST_TIMEOUT: 240
// bignum_rsa (PR 4b): width-generic Montgomery arithmetic + fast public
// modpow for RSA-2048/3072/4096 verification. Vectors generated with
// Python pow(); includes moduli whose top container bit is clear, the
// e=43147 seen in the system CA bundle and e=2^31+1. Cross-checks R^2 mod N
// against bignum_2048 at 64 limbs, and the refusals (s >= N, even / zero
// N, width mismatch).

import "../ce_test.nova"
import "../../src/safety/bignum_rsa.nova"
import "../../src/safety/bignum_2048.nova"
import "../../src/util/str_safe.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _hex(buf, n) {
    let d = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        out = out + substr(d, int_shr(b, 4), 1) + substr(d, int_and(b, 15), 1)
        i = i + 1
    }
    return out
}

fn _vec(name, nhex, shex, e, want) {
    let N = bnr_from_hex(nhex)
    let s = bnr_from_hex(shex)
    let ctx = bnr_mont_ctx_new(N)
    ce_check(name + ": ctx", ctx != 0)
    let r = bnr_modpow_pub(s, e, ctx)
    ce_check(name + ": result", r != 0)
    let k = int_shr(len(nhex), 1)
    ce_check(name + ": s^e mod N", str_eq_bytes(_hex(bnr_to_be_bytes(r, k), k), want) == 1)
}

fn test_vectors() {
    _vec("2048-bit e=65537", "", "", 65537, "")
    _vec("2048-bit e=3", "", "", 3, "")
    _vec("3072-bit e=65537", "", "", 65537, "")
    _vec("4096-bit e=65537", "", "", 65537, "")
    _vec("4096-bit e=43147", "", "", 43147, "")
    _vec("4096-bit e=2147483649", "", "", 2147483649, "")
    _vec("4096-bit e=65537 (top bit clear)", "", "", 65537, "")
    _vec("2048-bit e=65537 (top bit clear)", "", "", 65537, "")
}

fn test_r2_matches_bn2048() {
    let nhex = ""
    let a = bnr_mont_ctx_new(bnr_from_hex(nhex))
    let b = bn2048_mont_ctx_new(bn2048_from_hex(nhex))
    ce_eq("2048-bit R^2 mod N matches bignum_2048", bnr_cmp(a[1], b[1]), 0)
    ce_eq("same n'0", a[0], b[0])
    ce_eq("64 limbs, same layout as bn2048", len(bnr_from_hex(nhex)), 64)
}

fn test_refusals() {
    let N = bnr_from_hex("")
    let ctx = bnr_mont_ctx_new(N)
    ce_check("s == N refused", bnr_modpow_pub(N, 65537, ctx) == 0)
    ce_check("zero N: no context", bnr_mont_ctx_new(bnr_from_int(0, 64)) == 0)
    ce_check("even N: no context", bnr_mont_ctx_new(bnr_from_int(10, 64)) == 0)
    ce_check("null N: no context", bnr_mont_ctx_new(0) == 0)
    let wide = bnr_from_be_bytes_n(bnr_to_be_bytes(N, 256), 0, 256, 128)
    ce_check("same value, different width: not equal", bnr_eq(N, wide) == 0)
    ce_check("width mismatch: modpow refused", bnr_modpow_pub(bnr_from_int(5, 128), 65537, ctx) == 0)
    ce_check("e = 0 refused", bnr_modpow_pub(bnr_from_int(5, 64), 0, ctx) == 0)
    ce_check("bytes round trip", bnr_eq(bnr_from_be_bytes(bnr_to_be_bytes(N, 256), 0, 256), N) == 1)
    ce_eq("bitlen of 2^0", bnr_bitlen(bnr_from_int(1, 4)), 1)
}

fn main() {
    test_vectors()
    test_r2_matches_bn2048()
    test_refusals()
    ce_summary("bignum_rsa")
}

main()
