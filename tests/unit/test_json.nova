// Unit tests for src/data/json.nova -- the recursive-descent JSON parser (R58).

import "../ce_test.nova"
import "../../src/data/json.nova"

fn test_primitives() {
    ce_eq("null type", json_type(json_parse("null")), JV_NULL)
    ce_eq("true is bool 1", json_bool(json_parse("true")), 1)
    ce_eq("false is bool 0", json_bool(json_parse("false")), 0)
    ce_eq("bool type", json_type(json_parse("false")), JV_BOOL)
    ce_eq("integer", json_num(json_parse("42")), 42)
    ce_eq("negative integer", json_num(json_parse("-7")), 0 - 7)
    ce_eq("number type", json_type(json_parse("3.14")), JV_NUM)
    ce_str_eq("plain string", json_str(json_parse("\"hello\"")), "hello")
    ce_eq("string type", json_type(json_parse("\"hi\"")), JV_STR)
    // Leading whitespace is skipped.
    ce_eq("leading ws", json_num(json_parse("   123")), 123)
}

fn test_string_escapes() {
    ce_str_eq("escaped quote", json_str(json_parse("\"a\\\"b\"")), "a\"b")
    ce_str_eq("escaped backslash", json_str(json_parse("\"a\\\\b\"")), "a\\b")
    ce_str_eq("escaped slash", json_str(json_parse("\"a\\/b\"")), "a/b")
    // \n decodes to a newline (char 10).
    let nl = json_str(json_parse("\"a\\nb\""))
    ce_eq("newline length", len(nl), 3)
    ce_eq("middle char is LF", char_at(nl, 1), 10)
    // A -> 'A'
    ce_str_eq("unicode escape ASCII", json_str(json_parse("\"\\u0041\"")), "A")
    // é -> two-byte UTF-8 (e9 = e-acute), length 2.
    ce_eq("unicode escape 2-byte len", len(json_str(json_parse("\"\\u00e9\""))), 2)
}

fn test_array() {
    let v = json_parse("[1, 2, 3]")
    ce_eq("array type", json_type(v), JV_ARR)
    ce_eq("array length", json_arr_len(v), 3)
    ce_eq("elem 0", json_num(json_arr_get(v, 0)), 1)
    ce_eq("elem 2", json_num(json_arr_get(v, 2)), 3)
    ce_eq("out of range -> err", json_is_valid(json_arr_get(v, 9)), 0)
    ce_eq("empty array len", json_arr_len(json_parse("[]")), 0)
    // Mixed types.
    let m = json_parse("[\"a\", 1, true, null]")
    ce_str_eq("mixed str", json_str(json_arr_get(m, 0)), "a")
    ce_eq("mixed bool", json_bool(json_arr_get(m, 2)), 1)
    ce_eq("mixed null", json_is_null(json_arr_get(m, 3)), 1)
}

fn test_object() {
    let v = json_parse("{\"a\": 1, \"b\": \"x\", \"c\": [10, 20]}")
    ce_eq("object type", json_type(v), JV_OBJ)
    ce_eq("get a", json_num(json_get(v, "a")), 1)
    ce_str_eq("get b", json_str(json_get(v, "b")), "x")
    ce_eq("has a", json_has(v, "a"), 1)
    ce_eq("missing key", json_has(v, "z"), 0)
    ce_eq("missing key -> err", json_is_valid(json_get(v, "z")), 0)
    // Nested array under a key.
    let c = json_get(v, "c")
    ce_eq("nested arr len", json_arr_len(c), 2)
    ce_eq("nested arr elem", json_num(json_arr_get(c, 1)), 20)
    ce_eq("empty object", json_type(json_parse("{}")), JV_OBJ)
}

fn test_nesting() {
    // Deep navigation: arr[0].meanings[0].definitions[0].definition
    let body = "[{\"word\":\"x\",\"meanings\":[{\"partOfSpeech\":\"noun\",\"definitions\":[{\"definition\":\"a thing\"}]}]}]"
    let root = json_parse(body)
    ce_eq("root is array", json_type(root), JV_ARR)
    let entry = json_arr_get(root, 0)
    ce_str_eq("word", json_str(json_get(entry, "word")), "x")
    let meaning = json_arr_get(json_get(entry, "meanings"), 0)
    ce_str_eq("partOfSpeech", json_str(json_get(meaning, "partOfSpeech")), "noun")
    let def0 = json_arr_get(json_get(meaning, "definitions"), 0)
    ce_str_eq("definition", json_str(json_get(def0, "definition")), "a thing")
}

fn test_opensearch_shape() {
    // The real OpenSearch response shape: [query,[titles],[descs],[urls]].
    let body = "[\"photosynthesis\",[\"Photosynthesis\"],[\"\"],[\"https://en.wikipedia.org/wiki/Photosynthesis\"]]"
    let v = json_parse(body)
    let urls = json_arr_get(v, 3)
    ce_str_eq("first url", json_str(json_arr_get(urls, 0)),
        "https://en.wikipedia.org/wiki/Photosynthesis")
}

fn test_errors() {
    ce_eq("garbage -> err", json_is_valid(json_parse("not json")), 0)
    ce_eq("unterminated string -> err", json_is_valid(json_parse("\"abc")), 0)
    ce_eq("unterminated array -> err", json_is_valid(json_parse("[1, 2")), 0)
    ce_eq("bad object (no colon) -> err", json_is_valid(json_parse("{\"a\" 1}")), 0)
    ce_eq("empty input -> err", json_is_valid(json_parse("")), 0)
    // Wrong-type access is safe (returns err / defaults, never crashes).
    ce_eq("str of a number -> empty", len(json_str(json_parse("5"))), 0)
    ce_eq("get on a non-object -> err", json_is_valid(json_get(json_parse("5"), "k")), 0)
}

fn main() {
    test_primitives()
    test_string_escapes()
    test_array()
    test_object()
    test_nesting()
    test_opensearch_shape()
    test_errors()
    ce_summary("json")
}
main()
