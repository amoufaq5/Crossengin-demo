// End-to-end test: ingest data/packs/world_history.cerec.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"

fn test_world_history_ingests_cleanly() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "cerec", "data/packs/world_history.cerec",
                          "history", "src:pack:world_history:v1", "", 0)
    ce_eq("1 record", ing_sum_ok(s), 1)
    ce_eq("43 atoms added", ing_sum_atoms(s), 43)
    ce_eq("0 parse errors", ing_sum_errors(s), 0)
    ce_eq("0 queued (trusted src:pack:)", ing_sum_queued(s), 0)
}

fn test_world_history_atoms_present() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/world_history.cerec",
                  "history", "src:pack:world_history:v1", "", 0)
    // Find the history KG in the registry.
    let kgreg = ing_kgreg(a)
    let n = kg_count(kgreg)
    let hkg = 0
    let i = 0
    while i < n {
        let k = kg_get(kgreg, i)
        if k != 0 { if str_eq_bytes(kg_label(k), "history") == 1 { hkg = k } }
        i = i + 1
    }
    ce_check("history KG exists", hkg != 0)
    ce_check("newton atom seeded", kg_find_atom(hkg, "newton") != 0)
    ce_check("moon_landing_1969 seeded",
             kg_find_atom(hkg, "moon_landing_1969") != 0)
    ce_check("world_war_2 seeded",
             kg_find_atom(hkg, "world_war_2") != 0)
}

fn test_source_attribution() {
    let a = ing_agent_new()
    ing_agent_run(a, "cerec", "data/packs/world_history.cerec",
                  "history", "src:pack:world_history:v1", "", 0)
    let report = mo_report(ing_mo(a))
    let saw = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:pack:world_history:v1") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("world_history pack source attributed", saw, 1)
}

fn main() {
    test_world_history_ingests_cleanly()
    test_world_history_atoms_present()
    test_source_attribution()
    ce_summary("pack_world_history")
}

main()
