// Unit tests for src/safety/shamir.nova (t-of-n Shamir over GF(2^8)).
//
// Vectors S0-S3 and the Lagrange coefficients come from an independent
// Python reference (plan A2.0). Coefficients are fixed there, so the
// deterministic hook shamir_split_coeffs is used for the vectors; the
// RNG path (shamir_split with rng_test_new / rng_os_new) is checked by
// round trips.

import "../ce_test.nova"
import "../../src/safety/shamir.nova"
import "../../src/safety/chacha20.nova"

fn _sh_hex(h) {
    let d = cc_hex_decode(h)
    return d[0]
}

fn _sh_cat(a, b) {
    return cc_hex_decode(a + b)[0]
}

fn _sh_pick(shares, xs) {
    let out = list_new()
    let i = 0
    while i < len(xs) {
        push(out, shares[xs[i] - 1])
        i = i + 1
    }
    return out
}

fn _sh_lag_hex(xs) {
    let lam = shamir_lagrange0(xs)
    let buf = alloc(len(lam) + 1)
    let i = 0
    while i < len(lam) {
        store8(buf + i, lam[i])
        i = i + 1
    }
    return cc_hex_encode_buf(buf, len(lam))
}

fn test_s0_single_byte() {
    // s = 0x42, c1 = 0x13, c2 = 0x37, t = 3, n = 5
    let sec = _sh_hex("42")
    let co = _sh_hex("1337")
    let sh = shamir_split_coeffs(sec, 1, 3, 5, co)
    ce_eq("S0 n shares", len(sh), 5)
    let want = ["66", "b8", "9c", "53", "77"]
    let i = 0
    while i < 5 {
        ce_eq("S0 x" + int_to_str(i + 1), shamir_share_x(sh[i]), i + 1)
        ce_str_eq("S0 f(" + int_to_str(i + 1) + ")", cc_hex_encode_buf(shamir_share_buf(sh[i]), 1), want[i])
        i = i + 1
    }
    // every 3-subset of {1..5} recovers 0x42
    let ok = 0
    let a = 1
    while a <= 5 {
        let b = a + 1
        while b <= 5 {
            let c = b + 1
            while c <= 5 {
                let r = shamir_combine(_sh_pick(sh, [a, b, c]), 1)
                if load8(r) == 66 { ok = ok + 1 }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    ce_eq("S0 all ten 3-subsets recover", ok, 10)
    // below threshold: {1,2} gives 0x2c, not 0x42
    ce_eq("S0 t-1 shares give 2c", load8(shamir_combine(_sh_pick(sh, [1, 2]), 1)), 44)
}

fn test_lagrange() {
    ce_str_eq("lag {1,2,3}", _sh_lag_hex([1, 2, 3]), "010101")
    ce_str_eq("lag {1,2,4}", _sh_lag_hex([1, 2, 4]), "62a4c7")
    ce_str_eq("lag {1,2,5}", _sh_lag_hex([1, 2, 5]), "8c68e5")
    ce_str_eq("lag {1,3,4}", _sh_lag_hex([1, 3, 4]), "f7b94f")
    ce_str_eq("lag {2,3,5}", _sh_lag_hex([2, 3, 5]), "d303d1")
    ce_str_eq("lag {3,4,5}", _sh_lag_hex([3, 4, 5]), "d0d302")
    ce_str_eq("lag {1,2}", _sh_lag_hex([1, 2]), "f7f6")
    ce_str_eq("lag {1..5}", _sh_lag_hex([1, 2, 3, 4, 5]), "01d0d0d1d1")
    ce_str_eq("lag {1,255}", _sh_lag_hex([1, 255]), "4041")
    ce_str_eq("lag {7,200,255}", _sh_lag_hex([7, 200, 255]), "2991b9")
}

fn test_s1() {
    let secret_hex = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    let sec = _sh_hex(secret_hex)
    let co = _sh_cat("e7a529222dac1ef2325d45588cbb67653f78d5b0db35a83b2d5877c3d5265b37",
                     "af1e7a3272d818cff0a7ef1fccfbe54481c9daad377108978d1390b12398895b")
    let sh = shamir_split_coeffs(sec, 32, 3, 5, co)
    let want = [
        "48ba51135b71003acaf3a04c4c4d8c2eaea01d0ef851b6bbb852fd69eaa3cc73",
        "5f28a38f8d0b5ae9811911c712a179ce5ce8e6ea65a07d0b40e582742107ba06",
        "1793f09fd27f5cd443e3bb8052e1fbefe259e9f789e4dda7e0ae6506d7b9686a",
        "af584786d1ace5a659f8779b7efe5bac24ce64db08900048a4491edf63c62104",
        "e7e314968ed8e39b9b02dddc3ebed98d9a7f6bc6e4d4a0e40402f9ad9578f368"]
    let i = 0
    while i < 5 {
        ce_str_eq("S1 y" + int_to_str(i + 1), cc_hex_encode_buf(shamir_share_buf(sh[i]), 32), want[i])
        i = i + 1
    }
    ce_str_eq("S1 {1,2,3}", cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [1, 2, 3]), 32), 32), secret_hex)
    ce_str_eq("S1 {2,4,5}", cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [2, 4, 5]), 32), 32), secret_hex)
    ce_str_eq("S1 {5,3,1}", cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [5, 3, 1]), 32), 32), secret_hex)
    ce_str_eq("S1 all five", cc_hex_encode_buf(shamir_combine(sh, 32), 32), secret_hex)
    ce_str_eq("S1 {1,2} wrong", cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [1, 2]), 32), 32),
        "453df667e0ae3682f35ccf358fe0df870998bd527af70622193f21625a3617a9")
}

fn test_s2_s3() {
    let ff = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    let sh = shamir_split_coeffs(_sh_hex(ff), 32, 2, 3,
        _sh_hex("0101010101010101010101010101010101010101010101010101010101010101"))
    ce_str_eq("S2 y1", cc_hex_encode_buf(sh[0][1], 32), "fefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefe")
    ce_str_eq("S2 y3", cc_hex_encode_buf(sh[2][1], 32), "fcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfcfc")
    ce_str_eq("S2 {1,3}", cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [1, 3]), 32), 32), ff)
    let s3 = "0bbb470572989c47f6713031422c24bebf6c3c04a5d06ab8a544e6c84a6e5b96"
    let co = _sh_cat(_sh_cat_hex2("6d37819111e4ad4b26b2e8bc5dde71eee0bb260f3d169bbf3ea393389f715237",
                                  "96def76b98c5383fbb8c9375cdd9ce0ec05e1922029ec9122a65eda1183d8eca"),
                     _sh_cat_hex2("36b907bc532c720d074690f773162e6d8b9b77ca9fa1a66c50ca6cb90bd1159e",
                                  "c7cb5252e7d3ba5c548170e06bb6d28fef8d42b86c0b28a745d52647b02dd951"))
    let sh3 = shamir_split_coeffs(_sh_hex(s3), 32, 5, 5, co)
    ce_str_eq("S3 y1", cc_hex_encode_buf(sh3[0][1], 32), "012064114f46c1623888abefca8b67bcfb9f365b69f2b6dea49dd2af76de4ba4")
    ce_str_eq("S3 y5", cc_hex_encode_buf(sh3[4][1], 32), "43cb0fa9e69fe4840f653d519aa6df444aacbb216be57363cc0582520402d5a7")
    ce_str_eq("S3 {5,4,3,2,1}", cc_hex_encode_buf(shamir_combine(_sh_pick(sh3, [5, 4, 3, 2, 1]), 32), 32), s3)
}

fn _sh_cat_hex2(a, b) {
    return a + b
}

fn test_rng_round_trip() {
    let ctx = list_new()
    ce_eq("rng_test_new", rng_test_new(ctx, _sh_hex("7368616d6972"), 6), 1)
    let sec = _sh_hex("c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00")
    let sh = shamir_split(ctx, sec, 32, 4, 7)
    ce_eq("split n", len(sh), 7)
    // every 4-subset of 7 recovers (35 subsets)
    let ok = 0
    let total = 0
    let a = 1
    while a <= 7 {
        let b = a + 1
        while b <= 7 {
            let c = b + 1
            while c <= 7 {
                let d = c + 1
                while d <= 7 {
                    let r = shamir_combine(_sh_pick(sh, [a, b, c, d]), 32)
                    if r != 0 {
                        if _ce_str_eq_bytes(cc_hex_encode_buf(r, 32), "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00") == 1 {
                            ok = ok + 1
                        }
                    }
                    total = total + 1
                    d = d + 1
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    ce_eq("all 35 4-subsets of 7 recover", ok, 35)
    ce_eq("subset count", total, 35)
    // 3 shares of a 4-threshold split do not give the secret
    let low = cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [1, 2, 3]), 32), 32)
    ce_check("t-1 shares do not recover", _ce_str_eq_bytes(low, "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00") == 0)
    // shares differ from the secret and from each other
    ce_check("share 1 is not the secret", _ce_str_eq_bytes(cc_hex_encode_buf(sh[0][1], 32), "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00") == 0)
    ce_check("shares 1 and 2 differ", _ce_str_eq_bytes(cc_hex_encode_buf(sh[0][1], 32), cc_hex_encode_buf(sh[1][1], 32)) == 0)
    // two splits from the same RNG stream use different coefficients
    let sh2 = shamir_split(ctx, sec, 32, 4, 7)
    ce_check("fresh coefficients per split", _ce_str_eq_bytes(cc_hex_encode_buf(sh[0][1], 32), cc_hex_encode_buf(sh2[0][1], 32)) == 0)
    // n = 255, t = 2 (the maximum share count)
    let big = shamir_split(ctx, sec, 32, 2, 255)
    ce_eq("n=255 split", len(big), 255)
    ce_eq("last x is 255", big[254][0], 255)
    ce_str_eq("{1,255} recovers", cc_hex_encode_buf(shamir_combine(_sh_pick(big, [1, 255]), 32), 32),
        "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00")
}

fn test_os_rng_split() {
    let ctx = list_new()
    if rng_os_new(ctx) != 1 {
        println("SKIP: OS RNG unavailable; os split not exercised")
        return 0
    }
    let sec = _sh_hex("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
    let sh = shamir_split(ctx, sec, 32, 3, 5)
    ce_str_eq("os split round trip", cc_hex_encode_buf(shamir_combine(_sh_pick(sh, [4, 2, 5]), 32), 32),
        "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
    return 1
}

fn _sh_failing_rng(buf, n) {
    return 0
}

fn test_refusals() {
    let sec = _sh_hex("42")
    let co = _sh_hex("1337")
    ce_eq("t=0 refused", shamir_split_coeffs(sec, 1, 0, 5, co), 0)
    ce_eq("t>n refused", shamir_split_coeffs(sec, 1, 6, 5, co), 0)
    ce_eq("n=256 refused", shamir_split_coeffs(sec, 1, 2, 256, co), 0)
    ce_eq("slen=0 refused", shamir_split_coeffs(sec, 0, 2, 3, co), 0)
    ce_eq("null secret refused", shamir_split_coeffs(0, 1, 2, 3, co), 0)
    ce_eq("null coeffs refused", shamir_split_coeffs(sec, 1, 2, 3, 0), 0)
    let t1 = shamir_split_coeffs(sec, 1, 1, 3, 0)
    ce_eq("t=1 copies the secret", load8(t1[2][1]), 66)
    let sh = shamir_split_coeffs(sec, 1, 3, 5, co)
    ce_eq("empty set refused", shamir_combine(list_new(), 1), 0)
    ce_eq("duplicate x refused", shamir_combine(_sh_pick(sh, [1, 2, 2]), 1), 0)
    // a valid control: shares built with shamir_share combine fine
    let good = list_new()
    push(good, shamir_share(1, sh[0][1], 1))
    push(good, shamir_share(2, sh[1][1], 1))
    push(good, shamir_share(3, sh[2][1], 1))
    ce_eq("shamir_share-built set recovers", load8(shamir_combine(good, 1)), 66)
    ce_eq("share len recorded", shamir_share_len(sh[0]), 1)
    let bad = list_new()
    push(bad, shamir_share(0, sh[0][1], 1))
    push(bad, sh[1])
    ce_eq("x=0 refused", shamir_combine(bad, 1), 0)
    let bad2 = list_new()
    push(bad2, shamir_share(256, sh[0][1], 1))
    ce_eq("x=256 refused", shamir_combine(bad2, 1), 0)
    let bad3 = list_new()
    push(bad3, shamir_share(3, 0, 1))
    ce_eq("null share buffer refused", shamir_combine(bad3, 1), 0)
    // length checks: a short share, a wrong slen, the old 2-element form
    let s32 = shamir_split_coeffs(_sh_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), 32, 2, 3,
        _sh_hex("0101010101010101010101010101010101010101010101010101010101010101"))
    let shortset = list_new()
    push(shortset, shamir_share(1, _sh_hex("ab"), 1))
    push(shortset, s32[1])
    ce_eq("short share refused", shamir_combine(shortset, 32), 0)
    ce_eq("slen larger than shares refused", shamir_combine(s32, 40), 0)
    ce_eq("slen smaller than shares refused", shamir_combine(s32, 16), 0)
    let twoform = list_new()
    let p0 = list_new()
    push(p0, 1)
    push(p0, s32[0][1])
    push(twoform, p0)
    push(twoform, s32[1])
    ce_eq("2-element share refused", shamir_combine(twoform, 32), 0)
    ce_eq("slen=0 combine refused", shamir_combine(sh, 0), 0)
    let fctx = list_new()
    rng_callback_new(fctx, _sh_failing_rng)
    ce_eq("rng failure refused", shamir_split(fctx, sec, 1, 3, 5), 0)
}

fn main() {
    test_s0_single_byte()
    test_lagrange()
    test_s1()
    test_s2_s3()
    test_rng_round_trip()
    test_os_rng_split()
    test_refusals()
    ce_summary("shamir")
}

main()
