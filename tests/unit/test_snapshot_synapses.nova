// Unit tests for the SYNAPSES section in src/persistence/snapshot_disk.nova
// (Phase 11 P0.1 follow-up).
//
// Verifies the synapse graph round-trip: build a populated graph, serialize
// to text, parse back, apply to a fresh graph, and confirm src/dst/weight/
// eligibility tuples survive. Also covers the threshold cut (sub-threshold
// synapses dropped on write), the empty round-trip, and the legacy
// `synapses.present 1` (no sub-fields) hint.
//
// ADR-0007 (synapse design), ADR-0048 (snapshot container + runtime seam).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"
import "../../src/substrate/part_registry.nova"
import "../../src/substrate/first_nodes.nova"

// ---- helpers --------------------------------------------------------------

fn _wrap_for_text(blob) {
    let s = snap_new(1, 100)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 0)
    push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    snap_put_section(s, SEC_SYNAPSES, blob)
    return s
}

// ---- empty round-trip -----------------------------------------------------

fn test_empty_round_trip() {
    let g = syn_graph_new()
    let blob = synapses_section_build(g)
    ce_eq("empty graph: threshold default", blob[0], SYN_SNAP_MIN)
    ce_eq("empty graph: zero records",      len(blob[1]), 0)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    ce_check("encoded non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("decoded valid", snap_valid(s2) == 1)
    ce_check("synapses section present", snap_has_section(s2, SEC_SYNAPSES) == 1)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded threshold",  sb2[0], SYN_SNAP_MIN)
    ce_eq("decoded record count", len(sb2[1]), 0)

    let g2 = syn_graph_new()
    let n = synapses_section_apply(g2, sb2)
    ce_eq("apply returned 0", n, 0)
    ce_eq("post-apply syn_live = 0", syn_live(g2), 0)
}

// ---- populated round-trip -------------------------------------------------

fn test_populated_round_trip() {
    // 6 synapses with varying weights; all above the default threshold.
    let g = syn_graph_new()
    syn_new(g, 1, 2, 500, 0)   // 0.5
    syn_new(g, 1, 3, 700, 0)   // 0.7
    syn_new(g, 2, 4, 300, 0)   // 0.3
    syn_new(g, 3, 4, 250, 0)   // 0.25
    syn_new(g, 4, 5, 900, 0)   // 0.9
    syn_new(g, 5, 6, 0 - 600, 0) // -0.6 (inhibitory; |w|=0.6 above threshold)
    ce_eq("source graph has 6 live syns", syn_live(g), 6)

    // Manually set some eligibility so it survives.
    syn_set_eligibility(g, 0, 200)
    syn_set_eligibility(g, 4, 800)

    let blob = synapses_section_build(g)
    ce_eq("blob threshold = 100", blob[0], 100)
    ce_eq("blob captured 6 records", len(blob[1]), 6)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded threshold",  sb2[0], 100)
    ce_eq("decoded record count",  len(sb2[1]), 6)

    let g2 = syn_graph_new()
    let n = synapses_section_apply(g2, sb2)
    ce_eq("apply returned 6",  n, 6)
    ce_eq("g2 has 6 live syns", syn_live(g2), 6)

    // Per-record survival.
    let idx_12 = syn_find(g2, 1, 2)
    ce_check("1->2 survived", idx_12 != -1)
    ce_eq("1->2 weight",      syn_weight(g2, idx_12), 500)
    ce_eq("1->2 eligibility", syn_elig(g2, idx_12), 200)
    let idx_45 = syn_find(g2, 4, 5)
    ce_check("4->5 survived", idx_45 != -1)
    ce_eq("4->5 weight",      syn_weight(g2, idx_45), 900)
    ce_eq("4->5 eligibility", syn_elig(g2, idx_45), 800)
    let idx_56 = syn_find(g2, 5, 6)
    ce_check("5->6 survived (inhibitory)", idx_56 != -1)
    ce_eq("5->6 weight (negative)", syn_weight(g2, idx_56), 0 - 600)
}

// ---- threshold cut --------------------------------------------------------

fn test_threshold_cut() {
    // Weights below 100 milli are dropped on write -- they are below the
    // SYN_SNAP_MIN default so the snapshot doesn't waste bytes on noise.
    let g = syn_graph_new()
    syn_new(g, 0, 1, 50, 0)    // 0.05  DROPPED
    syn_new(g, 1, 2, 99, 0)    // 0.099 DROPPED
    syn_new(g, 2, 3, 100, 0)   // 0.10  kept (>=)
    syn_new(g, 3, 4, 200, 0)   // 0.20  kept
    syn_new(g, 4, 5, 0 - 75, 0) // -0.075 DROPPED (|w|=75 < 100)
    syn_new(g, 5, 6, 0 - 150, 0) // -0.15 kept (|w|=150 >= 100)
    ce_eq("source graph has 6 live syns", syn_live(g), 6)

    let blob = synapses_section_build(g)
    ce_eq("only 3 synapses above threshold", len(blob[1]), 3)

    // Round trip + apply.
    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded record count", len(sb2[1]), 3)
    let g2 = syn_graph_new()
    synapses_section_apply(g2, sb2)
    ce_eq("post-apply has 3 live syns", syn_live(g2), 3)
    // The DROPPED synapses are not present.
    ce_eq("0->1 dropped (below threshold)", syn_find(g2, 0, 1), -1)
    ce_eq("1->2 dropped (below threshold)", syn_find(g2, 1, 2), -1)
    ce_eq("4->5 dropped (|w|<threshold)",   syn_find(g2, 4, 5), -1)
    // The kept ones are present.
    ce_check("2->3 kept",   syn_find(g2, 2, 3) != -1)
    ce_check("3->4 kept",   syn_find(g2, 3, 4) != -1)
    ce_check("5->6 kept",   syn_find(g2, 5, 6) != -1)
}

// ---- backwards compat: presence-only stub ---------------------------------

fn test_legacy_presence_only_parses_empty() {
    let old = ""
        + "crossengin-snapshot v1\n"
        + "tag " + int_to_str(SNAP_TAG) + "\n"
        + "ver " + int_to_str(SNAP_FORMAT_VERSION) + "\n"
        + "instance 1\n"
        + "timestamp 1\n"
        + "sections 5\n"
        + "soul.present 1\n"
        + "soul.name Aurora\n"
        + "soul.constcount 0\n"
        + "kgs.present 1\n"
        + "kgs.atoms 0\n"
        + "kgs.atoms.count 0\n"
        + "episodic.present 0\n"
        + "synapses.present 1\n"
        + "selfmodel.present 0\n"
        + "end\n"
    let s = snap_from_text(old)
    ce_check("legacy snapshot parses", s != 0)
    ce_check("synapses section present", snap_has_section(s, SEC_SYNAPSES) == 1)
    let sb = snap_section(s, SEC_SYNAPSES)
    ce_eq("legacy synapses threshold default",  sb[0], SYN_SNAP_MIN)
    ce_eq("legacy synapses record list empty",  len(sb[1]), 0)

    let g = syn_graph_new()
    let n = synapses_section_apply(g, sb)
    ce_eq("legacy apply installs 0 syns", n, 0)
    ce_eq("post-apply graph still empty", syn_live(g), 0)
}

// ---- apply is idempotent (re-install overwrites) -------------------------

fn test_apply_is_idempotent() {
    let g = syn_graph_new()
    syn_new(g, 10, 20, 400, 0)
    let blob = synapses_section_build(g)
    let g2 = syn_graph_new()
    synapses_section_apply(g2, blob)
    let after_first = syn_live(g2)
    synapses_section_apply(g2, blob)
    let after_second = syn_live(g2)
    ce_eq("first apply created 1 syn", after_first, 1)
    ce_eq("second apply did not duplicate", after_second, 1)
    let idx = syn_find(g2, 10, 20)
    ce_eq("weight still 400", syn_weight(g2, idx), 400)
}

// ---- multi-part round-trip ------------------------------------------------
//
// P0.1 follow-up #2: synapses_section_build_multi walks the part registry and
// emits per-part records (label + records list); synapses_section_apply_multi
// rehydrates each part's records into the matching named part. This test
// builds a 3-part registry (reasoning + episodic + soul), populates DISTINCT
// synapse patterns in each, round-trips through text, and asserts each
// part's graph survives independently.

fn _seed_simple_part(reg, name, preset) {
    // Capacity 64 + first-count 4 keeps the test cheap; the preset only
    // affects which first-node template the part installs (not relevant for
    // synapse persistence -- the test populates the graph directly).
    registry_add(reg, name, preset, 64, 4)
    return registry_find(reg, name)
}

fn test_multi_part_round_trip() {
    let reg = part_registry_new()
    let r_id = _seed_simple_part(reg, "reasoning",   FN_PRESET_REASONING)
    let e_id = _seed_simple_part(reg, "episodic",    FN_PRESET_EPISODIC)
    let s_id = _seed_simple_part(reg, "soul",        FN_PRESET_SOUL)

    // Populate each part with a DIFFERENT synapse pattern.
    let rg = part_syn(registry_get(reg, r_id))
    syn_new(rg, 1, 2, 500, 0)
    syn_new(rg, 2, 3, 700, 0)
    syn_set_eligibility(rg, 0, 250)
    let eg = part_syn(registry_get(reg, e_id))
    syn_new(eg, 4, 5, 300, 0)
    syn_new(eg, 5, 6, 0 - 400, 0)   // inhibitory in episodic
    syn_set_eligibility(eg, 1, 500)
    let sg = part_syn(registry_get(reg, s_id))
    syn_new(sg, 7, 8, 850, 0)
    ce_eq("reasoning has 2 syns",    syn_live(rg), 2)
    ce_eq("episodic has 2 syns",     syn_live(eg), 2)
    ce_eq("soul has 1 syn",          syn_live(sg), 1)

    // Build the multi-part blob.
    let blob = synapses_section_build_multi(reg)
    ce_eq("multi-blob: threshold default", blob[0], SYN_SNAP_MIN)
    ce_eq("multi-blob: legacy block mirrors reasoning (2 recs)", len(blob[1]), 2)
    ce_eq("multi-blob: 3 parts captured", len(blob[2]), 3)
    // Per-part check (order matches the registry's part-id order).
    ce_check("parts[0] label = reasoning", str_eq(blob[2][0][0], "reasoning") == 1)
    ce_eq("parts[0] records = 2",          len(blob[2][0][1]), 2)
    ce_check("parts[1] label = episodic",  str_eq(blob[2][1][0], "episodic") == 1)
    ce_eq("parts[1] records = 2",          len(blob[2][1][1]), 2)
    ce_check("parts[2] label = soul",      str_eq(blob[2][2][0], "soul") == 1)
    ce_eq("parts[2] records = 1",          len(blob[2][2][1]), 1)

    // Round-trip through text.
    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    ce_check("decoded valid", snap_valid(s2) == 1)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded threshold",  sb2[0], SYN_SNAP_MIN)
    ce_eq("decoded legacy block size", len(sb2[1]), 2)
    ce_eq("decoded parts count", len(sb2[2]), 3)
    ce_eq("parts.count helper agrees", synapses_section_parts_count(sb2), 3)

    // Apply to a FRESH registry with the same part names and assert each
    // part rehydrates independently.
    let reg2 = part_registry_new()
    let r2 = _seed_simple_part(reg2, "reasoning",   FN_PRESET_REASONING)
    let e2 = _seed_simple_part(reg2, "episodic",    FN_PRESET_EPISODIC)
    let s2id = _seed_simple_part(reg2, "soul",      FN_PRESET_SOUL)
    let installed = synapses_section_apply_multi(reg2, sb2)
    ce_eq("multi-apply installed 5 synapses (2+2+1)", installed, 5)

    let rg2 = part_syn(registry_get(reg2, r2))
    let eg2 = part_syn(registry_get(reg2, e2))
    let sg2 = part_syn(registry_get(reg2, s2id))
    ce_eq("reasoning rehydrated: 2 live syns", syn_live(rg2), 2)
    ce_eq("episodic rehydrated: 2 live syns",  syn_live(eg2), 2)
    ce_eq("soul rehydrated: 1 live syn",       syn_live(sg2), 1)

    // Per-edge survival in each part.
    let idx_r = syn_find(rg2, 1, 2)
    ce_check("reasoning 1->2 survived", idx_r != -1)
    ce_eq("reasoning 1->2 weight",      syn_weight(rg2, idx_r), 500)
    ce_eq("reasoning 1->2 eligibility", syn_elig(rg2, idx_r),   250)

    let idx_e = syn_find(eg2, 5, 6)
    ce_check("episodic 5->6 inhibitory survived", idx_e != -1)
    ce_eq("episodic 5->6 weight (negative)",      syn_weight(eg2, idx_e), 0 - 400)

    let idx_s = syn_find(sg2, 7, 8)
    ce_check("soul 7->8 survived",            idx_s != -1)
    ce_eq("soul 7->8 weight",                 syn_weight(sg2, idx_s), 850)

    // Cross-part isolation: a synapse from `reasoning` MUST NOT appear in
    // `episodic` or `soul` (and vice versa).
    ce_eq("reasoning 1->2 NOT in episodic", syn_find(eg2, 1, 2), 0 - 1)
    ce_eq("reasoning 1->2 NOT in soul",     syn_find(sg2, 1, 2), 0 - 1)
    ce_eq("episodic 5->6 NOT in reasoning", syn_find(rg2, 5, 6), 0 - 1)
    ce_eq("soul 7->8 NOT in reasoning",     syn_find(rg2, 7, 8), 0 - 1)
}

// ---- multi-part skips empty parts -----------------------------------------
//
// A part with no above-threshold synapses should not appear in the parts
// list (empty entries are just snapshot bloat).

fn test_multi_part_skips_empty() {
    let reg = part_registry_new()
    let r_id = _seed_simple_part(reg, "reasoning", FN_PRESET_REASONING)
    let e_id = _seed_simple_part(reg, "episodic",  FN_PRESET_EPISODIC)
    // Populate ONLY reasoning.
    let rg = part_syn(registry_get(reg, r_id))
    syn_new(rg, 0, 1, 600, 0)
    // Episodic has a single SUB-threshold synapse that the build should drop.
    let eg = part_syn(registry_get(reg, e_id))
    syn_new(eg, 2, 3, 50, 0)   // 0.05 below SYN_SNAP_MIN
    let blob = synapses_section_build_multi(reg)
    ce_eq("only 1 non-empty part captured", len(blob[2]), 1)
    ce_check("the one captured part is reasoning", str_eq(blob[2][0][0], "reasoning") == 1)
    ce_eq("reasoning records = 1", len(blob[2][0][1]), 1)
}

// ---- multi-part apply: legacy (no parts block) installs into reasoning ----
//
// Backwards compat: a snapshot with `synapses.count` but no
// `synapses.parts.count` parses with an empty blob[2]; the apply path
// installs the legacy records into the reasoning part by default.

fn test_multi_part_apply_legacy_falls_through() {
    // Build a LEGACY-shape blob: [threshold, recs] only. The single-graph
    // builder is exactly that shape (blob[2] is an empty list).
    let g = syn_graph_new()
    syn_new(g, 100, 200, 750, 0)
    let blob = synapses_section_build(g)
    ce_eq("single-graph build leaves parts empty", len(blob[2]), 0)
    // Round-trip through text + apply through the multi path.
    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    let reg = part_registry_new()
    let r_id = _seed_simple_part(reg, "reasoning", FN_PRESET_REASONING)
    _seed_simple_part(reg, "episodic", FN_PRESET_EPISODIC)
    let n = synapses_section_apply_multi(reg, sb2)
    ce_eq("legacy multi-apply installs 1 synapse", n, 1)
    let rg = part_syn(registry_get(reg, r_id))
    ce_eq("reasoning has 1 syn",      syn_live(rg), 1)
    let idx = syn_find(rg, 100, 200)
    ce_check("100->200 in reasoning", idx != -1)
    ce_eq("100->200 weight",          syn_weight(rg, idx), 750)
    // Other part untouched.
    let eg = part_syn(registry_get(reg, registry_find(reg, "episodic")))
    ce_eq("episodic still empty",     syn_live(eg), 0)
}

// ---- multi-part apply is idempotent ---------------------------------------
//
// A second /load of the same multi-part snapshot must not duplicate synapses
// in any part -- existing pre->post edges have their weights overwritten
// rather than being re-grown.

fn test_multi_part_apply_idempotent() {
    let reg_src = part_registry_new()
    let r_src = _seed_simple_part(reg_src, "reasoning", FN_PRESET_REASONING)
    let e_src = _seed_simple_part(reg_src, "episodic",  FN_PRESET_EPISODIC)
    syn_new(part_syn(registry_get(reg_src, r_src)), 1, 2, 450, 0)
    syn_new(part_syn(registry_get(reg_src, e_src)), 3, 4, 350, 0)
    let blob = synapses_section_build_multi(reg_src)

    let reg_dst = part_registry_new()
    let r_dst = _seed_simple_part(reg_dst, "reasoning", FN_PRESET_REASONING)
    let e_dst = _seed_simple_part(reg_dst, "episodic",  FN_PRESET_EPISODIC)
    synapses_section_apply_multi(reg_dst, blob)
    let after_first = syn_live(part_syn(registry_get(reg_dst, r_dst)))
        + syn_live(part_syn(registry_get(reg_dst, e_dst)))
    synapses_section_apply_multi(reg_dst, blob)
    let after_second = syn_live(part_syn(registry_get(reg_dst, r_dst)))
        + syn_live(part_syn(registry_get(reg_dst, e_dst)))
    ce_eq("first apply created 2 syns total",  after_first, 2)
    ce_eq("second apply did not duplicate",    after_second, 2)
}

// ---- multi-part apply: unknown part name is skipped with warning ---------
//
// If the snapshot names a part the running registry doesn't know, the
// apply path SKIPS that entry (with a stdout warning) and continues. The
// known entries still install. Mirrors kg_section_apply's friendly fwd-compat.

fn test_multi_part_apply_skips_unknown() {
    // Build a synthetic blob with two parts: one known (reasoning) + one
    // unknown ("phantom"). Manually construct rather than going through the
    // registry walker so we don't depend on a separate "phantom" preset.
    let r1 = list_new()
    push(r1, 10) push(r1, 11) push(r1, 600) push(r1, 0)
    let recs_known = list_new()
    push(recs_known, r1)
    let entry_known = list_new()
    push(entry_known, "reasoning")
    push(entry_known, recs_known)
    let r2 = list_new()
    push(r2, 20) push(r2, 21) push(r2, 700) push(r2, 0)
    let recs_unknown = list_new()
    push(recs_unknown, r2)
    let entry_unknown = list_new()
    push(entry_unknown, "phantom")
    push(entry_unknown, recs_unknown)
    let parts_list = list_new()
    push(parts_list, entry_known)
    push(parts_list, entry_unknown)
    let blob = list_new()
    push(blob, SYN_SNAP_MIN)
    push(blob, recs_known)   // legacy mirror of reasoning
    push(blob, parts_list)
    let reg = part_registry_new()
    let r_id = _seed_simple_part(reg, "reasoning", FN_PRESET_REASONING)
    // NOTE: the apply will print a stdout warning naming the unknown part;
    // that's documented behaviour and not a test failure.
    let n = synapses_section_apply_multi(reg, blob)
    ce_eq("only the known part's 1 record installed", n, 1)
    let rg = part_syn(registry_get(reg, r_id))
    let idx = syn_find(rg, 10, 11)
    ce_check("known part's synapse 10->11 installed", idx != -1)
    ce_eq("known part's synapse weight", syn_weight(rg, idx), 600)
}

fn main() {
    test_empty_round_trip()
    test_populated_round_trip()
    test_threshold_cut()
    test_legacy_presence_only_parses_empty()
    test_apply_is_idempotent()
    test_multi_part_round_trip()
    test_multi_part_skips_empty()
    test_multi_part_apply_legacy_falls_through()
    test_multi_part_apply_idempotent()
    test_multi_part_apply_skips_unknown()
    ce_summary("snapshot_synapses")
}
main()
