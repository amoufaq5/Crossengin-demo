// Unit tests for the SYNAPSES section in src/persistence/snapshot_disk.nova
// (Phase 11 P0.1 follow-up).
//
// Verifies the synapse graph round-trip: build a populated graph, serialize
// to text, parse back, apply to a fresh graph, and confirm src/dst/weight/
// eligibility tuples survive. Also covers the threshold cut (sub-threshold
// synapses dropped on write), the empty round-trip, and the legacy
// `synapses.present 1` (no sub-fields) hint.
//
// ADR-0007 (synapse design), ADR-0048 (snapshot container + runtime seam).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"

// ---- helpers --------------------------------------------------------------

fn _wrap_for_text(blob) {
    let s = snap_new(1, 100)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 0)
    push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    snap_put_section(s, SEC_SYNAPSES, blob)
    return s
}

// ---- empty round-trip -----------------------------------------------------

fn test_empty_round_trip() {
    let g = syn_graph_new()
    let blob = synapses_section_build(g)
    ce_eq("empty graph: threshold default", blob[0], SYN_SNAP_MIN)
    ce_eq("empty graph: zero records",      len(blob[1]), 0)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    ce_check("encoded non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("decoded valid", snap_valid(s2) == 1)
    ce_check("synapses section present", snap_has_section(s2, SEC_SYNAPSES) == 1)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded threshold",  sb2[0], SYN_SNAP_MIN)
    ce_eq("decoded record count", len(sb2[1]), 0)

    let g2 = syn_graph_new()
    let n = synapses_section_apply(g2, sb2)
    ce_eq("apply returned 0", n, 0)
    ce_eq("post-apply syn_live = 0", syn_live(g2), 0)
}

// ---- populated round-trip -------------------------------------------------

fn test_populated_round_trip() {
    // 6 synapses with varying weights; all above the default threshold.
    let g = syn_graph_new()
    syn_new(g, 1, 2, 500, 0)   // 0.5
    syn_new(g, 1, 3, 700, 0)   // 0.7
    syn_new(g, 2, 4, 300, 0)   // 0.3
    syn_new(g, 3, 4, 250, 0)   // 0.25
    syn_new(g, 4, 5, 900, 0)   // 0.9
    syn_new(g, 5, 6, 0 - 600, 0) // -0.6 (inhibitory; |w|=0.6 above threshold)
    ce_eq("source graph has 6 live syns", syn_live(g), 6)

    // Manually set some eligibility so it survives.
    syn_set_eligibility(g, 0, 200)
    syn_set_eligibility(g, 4, 800)

    let blob = synapses_section_build(g)
    ce_eq("blob threshold = 100", blob[0], 100)
    ce_eq("blob captured 6 records", len(blob[1]), 6)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded threshold",  sb2[0], 100)
    ce_eq("decoded record count",  len(sb2[1]), 6)

    let g2 = syn_graph_new()
    let n = synapses_section_apply(g2, sb2)
    ce_eq("apply returned 6",  n, 6)
    ce_eq("g2 has 6 live syns", syn_live(g2), 6)

    // Per-record survival.
    let idx_12 = syn_find(g2, 1, 2)
    ce_check("1->2 survived", idx_12 != -1)
    ce_eq("1->2 weight",      syn_weight(g2, idx_12), 500)
    ce_eq("1->2 eligibility", syn_elig(g2, idx_12), 200)
    let idx_45 = syn_find(g2, 4, 5)
    ce_check("4->5 survived", idx_45 != -1)
    ce_eq("4->5 weight",      syn_weight(g2, idx_45), 900)
    ce_eq("4->5 eligibility", syn_elig(g2, idx_45), 800)
    let idx_56 = syn_find(g2, 5, 6)
    ce_check("5->6 survived (inhibitory)", idx_56 != -1)
    ce_eq("5->6 weight (negative)", syn_weight(g2, idx_56), 0 - 600)
}

// ---- threshold cut --------------------------------------------------------

fn test_threshold_cut() {
    // Weights below 100 milli are dropped on write -- they are below the
    // SYN_SNAP_MIN default so the snapshot doesn't waste bytes on noise.
    let g = syn_graph_new()
    syn_new(g, 0, 1, 50, 0)    // 0.05  DROPPED
    syn_new(g, 1, 2, 99, 0)    // 0.099 DROPPED
    syn_new(g, 2, 3, 100, 0)   // 0.10  kept (>=)
    syn_new(g, 3, 4, 200, 0)   // 0.20  kept
    syn_new(g, 4, 5, 0 - 75, 0) // -0.075 DROPPED (|w|=75 < 100)
    syn_new(g, 5, 6, 0 - 150, 0) // -0.15 kept (|w|=150 >= 100)
    ce_eq("source graph has 6 live syns", syn_live(g), 6)

    let blob = synapses_section_build(g)
    ce_eq("only 3 synapses above threshold", len(blob[1]), 3)

    // Round trip + apply.
    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    let sb2 = snap_section(s2, SEC_SYNAPSES)
    ce_eq("decoded record count", len(sb2[1]), 3)
    let g2 = syn_graph_new()
    synapses_section_apply(g2, sb2)
    ce_eq("post-apply has 3 live syns", syn_live(g2), 3)
    // The DROPPED synapses are not present.
    ce_eq("0->1 dropped (below threshold)", syn_find(g2, 0, 1), -1)
    ce_eq("1->2 dropped (below threshold)", syn_find(g2, 1, 2), -1)
    ce_eq("4->5 dropped (|w|<threshold)",   syn_find(g2, 4, 5), -1)
    // The kept ones are present.
    ce_check("2->3 kept",   syn_find(g2, 2, 3) != -1)
    ce_check("3->4 kept",   syn_find(g2, 3, 4) != -1)
    ce_check("5->6 kept",   syn_find(g2, 5, 6) != -1)
}

// ---- backwards compat: presence-only stub ---------------------------------

fn test_legacy_presence_only_parses_empty() {
    let old = ""
        + "crossengin-snapshot v1\n"
        + "tag " + int_to_str(SNAP_TAG) + "\n"
        + "ver " + int_to_str(SNAP_FORMAT_VERSION) + "\n"
        + "instance 1\n"
        + "timestamp 1\n"
        + "sections 5\n"
        + "soul.present 1\n"
        + "soul.name Aurora\n"
        + "soul.constcount 0\n"
        + "kgs.present 1\n"
        + "kgs.atoms 0\n"
        + "kgs.atoms.count 0\n"
        + "episodic.present 0\n"
        + "synapses.present 1\n"
        + "selfmodel.present 0\n"
        + "end\n"
    let s = snap_from_text(old)
    ce_check("legacy snapshot parses", s != 0)
    ce_check("synapses section present", snap_has_section(s, SEC_SYNAPSES) == 1)
    let sb = snap_section(s, SEC_SYNAPSES)
    ce_eq("legacy synapses threshold default",  sb[0], SYN_SNAP_MIN)
    ce_eq("legacy synapses record list empty",  len(sb[1]), 0)

    let g = syn_graph_new()
    let n = synapses_section_apply(g, sb)
    ce_eq("legacy apply installs 0 syns", n, 0)
    ce_eq("post-apply graph still empty", syn_live(g), 0)
}

// ---- apply is idempotent (re-install overwrites) -------------------------

fn test_apply_is_idempotent() {
    let g = syn_graph_new()
    syn_new(g, 10, 20, 400, 0)
    let blob = synapses_section_build(g)
    let g2 = syn_graph_new()
    synapses_section_apply(g2, blob)
    let after_first = syn_live(g2)
    synapses_section_apply(g2, blob)
    let after_second = syn_live(g2)
    ce_eq("first apply created 1 syn", after_first, 1)
    ce_eq("second apply did not duplicate", after_second, 1)
    let idx = syn_find(g2, 10, 20)
    ce_eq("weight still 400", syn_weight(g2, idx), 400)
}

fn main() {
    test_empty_round_trip()
    test_populated_round_trip()
    test_threshold_cut()
    test_legacy_presence_only_parses_empty()
    test_apply_is_idempotent()
    ce_summary("snapshot_synapses")
}
main()
