// Unit tests for the R103 `self.gaps` wire verb.
//
// Fabricates crafted refusals via direct gaps_record calls (bypassing
// the NL pipeline so the coverage focuses on the verb contract, not
// the pipeline wiring -- that's test_nl_pipeline_gap_recording.nova's
// job), then exercises filtering, summary, holder-override, limit.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/parts/meta/gaps_register.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}
fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// Build a fresh ctx + gaps register and seed it with 6 canned events.
// Returns [ctx, reg] so tests can inspect the register directly.
fn _mk_ctx_seeded() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = gaps_register_new(0)
    rpc_ctx_set_gaps_reg(ctx, reg)
    gaps_record(reg, "alice", "einstein",   GAP_NO_MATCH,       "0 atoms",       1)
    gaps_record(reg, "alice", "quantum",    GAP_LOW_CONFIDENCE, "conf 200/1000", 2)
    gaps_record(reg, "alice", "gibberish",  GAP_UNPARSED,       "grammar failed",3)
    gaps_record(reg, "bob",   "einstein",   GAP_NO_MATCH,       "0 atoms",       4)
    gaps_record(reg, "bob",   "research",   GAP_SKILL_REFUSED,  "persona missing",5)
    gaps_record(reg, "",      "orphan",     GAP_REFUSED,        "null query",    6)
    let out = list_new()
    push(out, ctx)
    push(out, reg)
    return out
}

// ---- happy path -----------------------------------------------------------

fn test_gaps_no_register_refuses() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("self.gaps", list_new(), ctx)
    ce_check("ok:false",           _has(out, "\"ok\":false"))
    ce_check("names missing reg",  _has(out, "no gaps register"))
}

fn test_gaps_default_scope_to_presented_holder() {
    // Anonymous presented (no token) => holder="" => only the orphan
    // entry matches. Deliberately no ctx.set_sandbox: enforcement OFF
    // so the verb runs even without a token.
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.gaps", list_new(), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    // Presented holder is "", count = 1 orphan entry.
    ce_check("holder empty",        _has(out, "\"holder\":\"\""))
    ce_check("count=1",             _has(out, "\"count\":1"))
    ce_check("orphan present",      _has(out, "\"topic\":\"orphan\""))
    ce_check("no alice entries",    _has(out, "\"topic\":\"einstein\"") == 0)
    // R107: entries branch carries next_after (empty when done).
    ce_check("next_after empty",    _has(out, "\"next_after\":\"\""))
}

fn test_gaps_summary_mode() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.gaps",
        _args1("summary", "1"), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    ce_check("total=6",             _has(out, "\"total\":6"))
    // Reasons buckets present.
    ce_check("by_reason field",     _has(out, "\"by_reason\":["))
    ce_check("no_match reason",     _has(out, "\"reason\":\"no_match\""))
    ce_check("low_confidence rsn",  _has(out, "\"reason\":\"low_confidence\""))
    ce_check("unparsed reason",     _has(out, "\"reason\":\"unparsed\""))
    ce_check("skill_refused rsn",   _has(out, "\"reason\":\"skill_refused\""))
    ce_check("refused reason",      _has(out, "\"reason\":\"refused\""))
    // Holder buckets present (three distinct holders including "").
    ce_check("by_holder field",     _has(out, "\"by_holder\":["))
    ce_check("alice bucket",        _has(out, "\"holder\":\"alice\""))
    ce_check("bob bucket",          _has(out, "\"holder\":\"bob\""))
}

// ---- filtering by reason -------------------------------------------------

fn test_gaps_filter_by_reason_name() {
    // Enforcement ON with an admin token so we can override holder=alice.
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    let out = rpc_dispatch("self.gaps",
        _args2("holder", "alice", "reason", "no_match"), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    ce_check("count=1",        _has(out, "\"count\":1"))
    ce_check("einstein",       _has(out, "\"topic\":\"einstein\""))
    ce_check("no quantum",     _has(out, "\"topic\":\"quantum\"") == 0)
    ce_check("no gibberish",   _has(out, "\"topic\":\"gibberish\"") == 0)
}

fn test_gaps_unknown_reason_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.gaps",
        _args1("reason", "wat"), ctx)
    ce_check("ok:false",        _has(out, "\"ok\":false"))
    ce_check("names bad",       _has(out, "wat"))
}

// ---- limit ---------------------------------------------------------------

fn test_gaps_limit_enforced() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    // alice has 3 entries; limit=2 clamps.
    let out = rpc_dispatch("self.gaps",
        _args2("holder", "alice", "limit", "2"), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    ce_check("count=2",        _has(out, "\"count\":2"))
}

fn test_gaps_limit_zero_uses_default() {
    // limit=0 falls through to default 50 (str_to_int returns 0 for
    // absent; the impl treats <=0 as "use default").
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.gaps",
        _args1("limit", "0"), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    // presented holder="", count still 1 orphan.
    ce_check("count=1",        _has(out, "\"count\":1"))
}

// ---- holder override (admin gate) ----------------------------------------

fn test_gaps_holder_override_needs_admin_when_enforced() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "carol", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    // carol (reader) asks for alice's gaps -> refused; the reader token
    // presents holder=carol and asking holder=alice != carol.
    let out = rpc_dispatch("self.gaps",
        _args1("holder", "alice"), ctx)
    ce_check("ok:false",        _has(out, "\"ok\":false"))
    ce_check("names admin",     _has(out, "admin:sandbox"))
}

fn test_gaps_holder_self_no_admin_required() {
    // The reader token's own holder is carol; asking holder=carol
    // matches presented and must pass without ADMIN_SANDBOX.
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "carol", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    let out = rpc_dispatch("self.gaps",
        _args1("holder", "carol"), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    // carol has no seeded entries.
    ce_check("count=0",         _has(out, "\"count\":0"))
}

fn test_gaps_holder_override_admin_ok() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    let out = rpc_dispatch("self.gaps",
        _args1("holder", "alice"), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("count=3",         _has(out, "\"count\":3"))
    ce_check("einstein",        _has(out, "\"topic\":\"einstein\""))
    ce_check("quantum",         _has(out, "\"topic\":\"quantum\""))
    ce_check("gibberish",       _has(out, "\"topic\":\"gibberish\""))
}

// ---- entries payload shape -----------------------------------------------

fn test_gaps_entry_shape() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.gaps", list_new(), ctx)
    // Every entry carries timestamp / holder / topic / reason / detail.
    ce_check("timestamp field",  _has(out, "\"timestamp\":"))
    ce_check("holder field",     _has(out, "\"holder\":"))
    ce_check("topic field",      _has(out, "\"topic\":"))
    ce_check("reason field",     _has(out, "\"reason\":"))
    ce_check("detail field",     _has(out, "\"detail\":"))
    ce_check("reason as name",   _has(out, "\"reason\":\"refused\""))
}

// ---- cap gate -------------------------------------------------------------

fn test_gaps_cap_required() {
    ce_check("gaps requires nl:self:read",
        str_eq_bytes(capability_verb_required("self.gaps"),
                     CAP_NL_SELF_READ) == 1)
}

fn test_gaps_reader_can_call() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "alice", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    let out = rpc_dispatch("self.gaps", list_new(), ctx)
    ce_check("ok",             _has(out, "\"ok\":true"))
    // Alice's presented -> her entries.
    ce_check("count=3",        _has(out, "\"count\":3"))
}

fn test_gaps_anonymous_refused_when_enforced() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    let out = rpc_dispatch("self.gaps", list_new(), ctx)
    ce_check("ok:false",        _has(out, "\"ok\":false"))
    ce_check("names cap",       _has(out, "nl:self:read"))
}

fn test_verb_in_names() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "self.gaps") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("self.gaps registered", saw, 1)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_gaps_no_register_refuses()
    test_gaps_default_scope_to_presented_holder()
    test_gaps_summary_mode()

    test_gaps_filter_by_reason_name()
    test_gaps_unknown_reason_refuses()

    test_gaps_limit_enforced()
    test_gaps_limit_zero_uses_default()

    test_gaps_holder_override_needs_admin_when_enforced()
    test_gaps_holder_self_no_admin_required()
    test_gaps_holder_override_admin_ok()

    test_gaps_entry_shape()

    test_gaps_cap_required()
    test_gaps_reader_can_call()
    test_gaps_anonymous_refused_when_enforced()

    test_verb_in_names()

    ce_summary("self_gaps_verb")
    return 0
}

main()
