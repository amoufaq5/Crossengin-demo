// Audit F-24: snapshot file hardening.
//  - snap_write_durable / delta_write_durable wrote 0644 (world-readable)
//    files; now 0600.
//  - a hostile count or `[N]` index -- top-level (kgs.atoms.count,
//    kgs.atoms[N]) or nested (moments[N].atoms[K], .atom_count,
//    synapses.parts[N], .synapses[K], kgs.atoms[N].xref[J], ...) -- made the
//    loader allocate without bound. Every one is now bounded by the file
//    length, and the total growth across all lists by one per-file budget,
//    so many records each claiming a large nested list are rejected too.
// Each hostile input is a COMPLETE snapshot (header, tag, ver, sections,
// end): the same text with a sane value loads (positive control), so the
// rejection comes from the bound, not from a missing `end` line.
//  - a symlink planted at <path>.tmp is not followed (snapshot and delta).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"
import "../../src/persistence/snapshot_delta.nova"
import "../../src/util/sys_tagged.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _mode_of(path) {
    let fd = sys_open(path, 0, 0)
    if fd < 0 { return -1 }
    let st = alloc(160)
    sys_fstat(fd, st)
    sys_close(fd)
    return int_and(load8(st + 24) + load8(st + 25) * 256, 511)
}

fn test_snapshot_mode_0600() {
    let p = "/tmp/ce_test_snap_mode_" + int_to_str(getpid()) + ".snap"
    sys_unlink(p)
    ce_eq("write ok", snap_write_durable("crossengin-snapshot v1\n", p), 1)
    ce_eq("snapshot is 0600", _mode_of(p), 384)
    // A stale temp file is replaced, not appended to or reused.
    let tfd = sys_open(p + ".tmp", 577, 420)
    sys_write(tfd, "stale", 5)
    sys_close(tfd)
    ce_eq("write over stale .tmp ok", snap_write_durable("crossengin-snapshot v1\n", p), 1)
    ce_eq("still 0600", _mode_of(p), 384)
    sys_unlink(p)
}

fn test_delta_mode_0600() {
    let p = "/tmp/ce_test_delta_mode_" + int_to_str(getpid()) + ".delta"
    sys_unlink(p)
    ce_check("delta write ok", delta_write_durable("crossengin-delta v1\n", p) > 0)
    ce_eq("delta file is 0600", _mode_of(p), 384)
    sys_unlink(p)
}

// symlink(2), test-only. Paths tag-polymorphic.
fn _t_symlink(target, linkpath) {
    asm {
        "mov rax, 88"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .tsh_sl0"
        "sar rdi, 1"
        ".tsh_sl0:"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .tsh_sl1"
        "sar rsi, 1"
        ".tsh_sl1:"
        "syscall"
        "test rax, rax"
        "js .tsh_slr"
        "lea rax, [rax + rax + 1]"
        ".tsh_slr:"
    }
}

// A symlink planted at <path>.tmp must not be followed: the writer drops
// the link and creates a fresh file, so the link's target keeps its bytes.
fn _check_no_follow(name, path, is_delta) {
    let victim = path + ".victim"
    sys_unlink(path)
    sys_unlink(path + ".tmp")
    sys_unlink(victim)
    let vfd = sys_open(victim, 577, 384)
    sys_write(vfd, "VICTIM", 6)
    sys_close(vfd)
    ce_eq(name + ": symlink planted", _t_symlink(victim, path + ".tmp"), 0)
    let ok = 0
    if is_delta == 1 { ok = delta_write_durable("crossengin-delta v1\n", path) }
    else { ok = snap_write_durable("crossengin-snapshot v1\n", path) }
    ce_check(name + ": write ok", ok > 0)
    ce_check(name + ": symlink target untouched", str_eq_bytes(_read_file_tagged(victim), "VICTIM") == 1)
    ce_eq(name + ": result is 0600", _mode_of(path), 384)
    sys_unlink(path)
    sys_unlink(victim)
}

fn test_planted_tmp_symlink() {
    let base = "/tmp/ce_test_snap_link_" + int_to_str(getpid())
    _check_no_follow("snapshot", base + ".snap", 0)
    _check_no_follow("delta", base + ".delta", 1)
}

fn _base(sections) {
    return "crossengin-snapshot v1\ntag 5361\nver 2\ninstance 1\ntimestamp 1\nsections 5\n" + sections
}

fn _kgs(body) { return _base("kgs.present 1\n" + body + "end\n") }
fn _ep(body)  { return _base("episodic.present 1\n" + body + "end\n") }
fn _syn(body) { return _base("synapses.present 1\n" + body + "end\n") }

fn test_top_level_bounds() {
    ce_check("control: kgs.atoms.count 0 loads", snap_from_text(_kgs("kgs.atoms.count 0\n")) != 0)
    ce_check("control: kgs.atoms[0] loads",
             snap_from_text(_kgs("kgs.atoms.count 1\nkgs.atoms[0].label x\n")) != 0)
    ce_check("huge kgs.atoms.count rejected", snap_from_text(_kgs("kgs.atoms.count 900000000000\n")) == 0)
    ce_check("negative count rejected", snap_from_text(_kgs("kgs.atoms.count -5\n")) == 0)
    ce_check("huge kgs.atoms[N] rejected", snap_from_text(_kgs("kgs.atoms[900000000000].label x\n")) == 0)
}

fn test_nested_bounds() {
    ce_check("control: moments[0].atoms[0] loads",
             snap_from_text(_ep("episodic.moments.count 1\nepisodic.moments[0].atom_count 1\nepisodic.moments[0].atoms[0] 5\n")) != 0)
    ce_check("huge moments[0].atom_count rejected",
             snap_from_text(_ep("episodic.moments.count 1\nepisodic.moments[0].atom_count 900000000000\n")) == 0)
    ce_check("huge moments[0].atoms[K] rejected",
             snap_from_text(_ep("episodic.moments.count 1\nepisodic.moments[0].atoms[900000000000] 5\n")) == 0)
    ce_check("negative moments[0].atoms[K] rejected",
             snap_from_text(_ep("episodic.moments.count 1\nepisodic.moments[0].atoms[-3] 5\n")) == 0)
    ce_check("huge synapses.parts[N] rejected",
             snap_from_text(_syn("synapses.parts[900000000000].label x\n")) == 0)
    ce_check("huge synapses.parts[0].synapses[K] rejected",
             snap_from_text(_syn("synapses.parts[0].label x\nsynapses.parts[0].synapses[900000000000].src 1\n")) == 0)
    ce_check("huge kgs.atoms[0].xref[J] rejected",
             snap_from_text(_kgs("kgs.atoms.count 1\nkgs.atoms[0].label x\nkgs.atoms[0].xref[900000000000].dst y\n")) == 0)
}

// Each index is below the file length, but 200 records each asking for
// ~len(file) slots would allocate ~200x the file: the shared budget stops it.
fn test_budget_across_records() {
    let body = "episodic.moments.count 200\n"
    let i = 0
    while i < 200 {
        body = body + "episodic.moments[" + int_to_str(i) + "].atoms[5000] 1\n"
        i = i + 1
    }
    ce_check("many records x large nested index rejected", snap_from_text(_ep(body)) == 0)
}

// Every section's top-level count pre-sizes its list after parsing; those
// are charged to the same budget. One count of ~len(file) fits; seven of
// them in the same file would allocate ~7x the file and are rejected.
fn _pad(n) {
    let p = "#"
    while len(p) < n { p = p + "################################################################" }
    return p + "\n"
}

fn test_budget_across_section_counts() {
    let pad = _pad(4000)
    let one = _base(pad + "episodic.present 1\nepisodic.moments.count 3000\nend\n")
    ce_check("control: one large section count within the budget loads", snap_from_text(one) != 0)
    let many = _base(pad + "kgs.present 1\nkgs.atoms.count 3000\n"
        + "episodic.present 1\nepisodic.moments.count 3000\nepisodic.episodes.count 3000\nepisodic.atoms.count 3000\n"
        + "synapses.present 1\nsynapses.count 3000\nsynapses.parts.count 3000\n"
        + "selfmodel.present 1\nselfmodel.domains.count 3000\nend\n")
    ce_check("seven section counts of ~len(file) rejected", snap_from_text(many) == 0)
}

fn main() {
    test_snapshot_mode_0600()
    test_delta_mode_0600()
    test_planted_tmp_symlink()
    test_top_level_bounds()
    test_nested_bounds()
    test_budget_across_records()
    test_budget_across_section_counts()
    ce_summary("snapshot_hardening")
}

main()
