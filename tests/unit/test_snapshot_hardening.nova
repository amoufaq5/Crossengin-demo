// Audit F-24: snapshot file hardening.
//  - snap_write_durable wrote 0644 (world-readable) files; now 0600.
//  - a hostile `*.count` / `[N]` index made the loader allocate without
//    bound; counts and indices larger than the file are now rejected.
// (The planted-symlink case lives in scenario_file_hardening.sh, which can
// create symlinks.)

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _mode_of(path) {
    let fd = sys_open(path, 0, 0)
    if fd < 0 { return -1 }
    let st = alloc(160)
    sys_fstat(fd, st)
    sys_close(fd)
    return int_and(load8(st + 24) + load8(st + 25) * 256, 511)
}

fn test_snapshot_mode_0600() {
    let p = "/tmp/ce_test_snap_mode_" + int_to_str(getpid()) + ".snap"
    sys_unlink(p)
    ce_eq("write ok", snap_write_durable("crossengin-snapshot v1\n", p), 1)
    ce_eq("snapshot is 0600", _mode_of(p), 384)
    // A stale temp file is replaced, not appended to or reused.
    let tfd = sys_open(p + ".tmp", 577, 420)
    sys_write(tfd, "stale", 5)
    sys_close(tfd)
    ce_eq("write over stale .tmp ok", snap_write_durable("crossengin-snapshot v1\n", p), 1)
    ce_eq("still 0600", _mode_of(p), 384)
    sys_unlink(p)
}

fn test_huge_count_rejected() {
    let t = "crossengin-snapshot v1\nkgs.atoms.count 900000000000\n"
    ce_check("huge kgs.atoms.count rejected", snap_from_text(t) == 0)
    let u = "crossengin-snapshot v1\nkgs.atoms[900000000000].label x\n"
    ce_check("huge [N] index rejected", snap_from_text(u) == 0)
    let v = "crossengin-snapshot v1\nkgs.atoms.count -5\n"
    ce_check("negative count rejected", snap_from_text(v) == 0)
}

fn main() {
    test_snapshot_mode_0600()
    test_huge_count_rejected()
    ce_summary("snapshot_hardening")
}

main()
