// Unit tests for src/net/tls/der.nova (R92 DER TLV walker).
//
// Coverage
//   * Tag constants match RFC 5280 / X.690.
//   * Short-form length: single-byte TLV of every legal length up to 127.
//   * Long-form length: 0x81, 0x82, 0x83, 0x84 with a real payload.
//   * Rejection: indefinite length (0x80 solo).
//   * Rejection: truncated content (length claims more than buffer holds).
//   * Rejection: length past declared buf_len (sub-range enforcement).
//   * Rejection: > 4 length bytes (0x85+).
//   * Rejection: long-form tag identifier (low 5 bits = 0x1F).
//   * Rejection: off outside the buffer.
//   * der_expect_tag: OK on match, err on mismatch.
//   * Nested SEQUENCE walk: read outer, walk inner, exhaust.
//   * BIT STRING: 0-unused-bits normal case; reject non-zero unused bits;
//     reject empty content.
//   * OID equality: match, length mismatch, byte mismatch, out-of-buffer
//     safety.
//   * Context-specific [0] EXPLICIT wrapping an INTEGER.
//   * der_bytes_equal: symmetric byte match on identical slices; mismatch
//     on differing byte; length mismatch; empty slice.

import "../ce_test.nova"
import "../../src/net/tls/der.nova"

// ---- helpers -------------------------------------------------------------

fn _tder_bytes(list_of_ints) {
    return list_of_ints
}

fn _tder_mk(bytes_list) {
    let out = list_new()
    let i = 0
    let n = len(bytes_list)
    while i < n {
        push(out, bytes_list[i])
        i = i + 1
    }
    return out
}

// Manually build a byte list from a hard-coded byte sequence.
fn _tder_seq_bytes() {
    // SEQUENCE (0x30) length 6: INTEGER 3, INTEGER 100.
    // 30 06 02 01 03 02 01 64
    let b = list_new()
    push(b, 48)
    push(b, 6)
    push(b, 2)
    push(b, 1)
    push(b, 3)
    push(b, 2)
    push(b, 1)
    push(b, 100)
    return b
}

fn _tder_nested_seq() {
    // Outer SEQUENCE length 8 wrapping [SEQUENCE length 3 { INT 5 }, INT 7]
    // outer: 30 08 30 03 02 01 05 02 01 07
    let b = list_new()
    push(b, 48)   // outer SEQ
    push(b, 8)
    push(b, 48)   // inner SEQ
    push(b, 3)
    push(b, 2)
    push(b, 1)
    push(b, 5)
    push(b, 2)   // trailing INT
    push(b, 1)
    push(b, 7)
    return b
}

// ---- constants -----------------------------------------------------------

fn test_constants() {
    ce_eq("DER_INTEGER = 0x02", DER_INTEGER, 2)
    ce_eq("DER_BIT_STRING = 0x03", DER_BIT_STRING, 3)
    ce_eq("DER_OCTET_STRING = 0x04", DER_OCTET_STRING, 4)
    ce_eq("DER_NULL = 0x05", DER_NULL, 5)
    ce_eq("DER_OID = 0x06", DER_OID, 6)
    ce_eq("DER_UTF8STRING = 0x0C", DER_UTF8STRING, 12)
    ce_eq("DER_PRINTABLESTRING = 0x13", DER_PRINTABLESTRING, 19)
    ce_eq("DER_UTCTIME = 0x17", DER_UTCTIME, 23)
    ce_eq("DER_GENERALIZEDTIME = 0x18", DER_GENERALIZEDTIME, 24)
    ce_eq("DER_SEQUENCE = 0x30", DER_SEQUENCE, 48)
    ce_eq("DER_SET = 0x31", DER_SET, 49)
    ce_eq("DER_CONTEXT_0 = 0xA0", DER_CONTEXT_0, 160)
    ce_eq("DER_CONTEXT_3 = 0xA3", DER_CONTEXT_3, 163)
    ce_eq("DER_OK = 1", DER_OK, 1)
    ce_eq("DER_ERR = 0", DER_ERR, 0)
}

// ---- short-form length --------------------------------------------------

fn test_short_form_length() {
    // INTEGER length 1, value 42: 02 01 2A
    let b = list_new()
    push(b, 2); push(b, 1); push(b, 42)
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, 3, 0, tag, ln, vo, no)
    ce_eq("short-form ok", ok, DER_OK)
    ce_eq("short-form tag", tag[0], DER_INTEGER)
    ce_eq("short-form len", ln[0], 1)
    ce_eq("short-form val_off", vo[0], 2)
    ce_eq("short-form next_off", no[0], 3)
    ce_eq("short-form value byte", b[vo[0]], 42)
}

fn test_short_form_max_127() {
    // OCTET STRING length 127 (0x7F) with 127 filler bytes.
    let b = list_new()
    push(b, 4); push(b, 127)
    let i = 0
    while i < 127 { push(b, int_and(i, 255)); i = i + 1 }
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, 129, 0, tag, ln, vo, no)
    ce_eq("short-form 127 ok", ok, DER_OK)
    ce_eq("short-form 127 tag", tag[0], DER_OCTET_STRING)
    ce_eq("short-form 127 len", ln[0], 127)
    ce_eq("short-form 127 next_off", no[0], 129)
}

// ---- long-form length ---------------------------------------------------

fn test_long_form_1byte() {
    // OCTET STRING length 200 -> long form 0x81 0xC8.
    let b = list_new()
    push(b, 4); push(b, 129); push(b, 200)
    let i = 0
    while i < 200 { push(b, 0); i = i + 1 }
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, len(b), 0, tag, ln, vo, no)
    ce_eq("long-form 0x81 ok", ok, DER_OK)
    ce_eq("long-form 0x81 len", ln[0], 200)
    ce_eq("long-form 0x81 val_off", vo[0], 3)
    ce_eq("long-form 0x81 next_off", no[0], 203)
}

fn test_long_form_2byte() {
    // Length 300 -> 0x82 0x01 0x2C
    let b = list_new()
    push(b, 4); push(b, 130); push(b, 1); push(b, 44)
    let i = 0
    while i < 300 { push(b, 0); i = i + 1 }
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, len(b), 0, tag, ln, vo, no)
    ce_eq("long-form 0x82 ok", ok, DER_OK)
    ce_eq("long-form 0x82 len", ln[0], 300)
    ce_eq("long-form 0x82 val_off", vo[0], 4)
}

fn test_long_form_2byte_max() {
    // Length 65535 -> 0x82 0xFF 0xFF (but we won't build 64k payload;
    // truncated buf triggers the past-buf-end rejection).
    let b = list_new()
    push(b, 4); push(b, 130); push(b, 255); push(b, 255)
    // Only 10 bytes of content follow.
    let i = 0
    while i < 10 { push(b, 0); i = i + 1 }
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, len(b), 0, tag, ln, vo, no)
    ce_eq("truncated 0x82 content rejected", ok, DER_ERR)
}

fn test_long_form_3byte_denied_over_max() {
    // Length bytes count 5 (0x85 ...) -> reject as too many.
    let b = list_new()
    push(b, 4); push(b, 133); push(b, 0); push(b, 0); push(b, 0); push(b, 0); push(b, 1)
    let i = 0
    while i < 10 { push(b, 0); i = i + 1 }
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, len(b), 0, tag, ln, vo, no)
    ce_eq("length byte count > 4 rejected", ok, DER_ERR)
}

fn test_long_form_length_bytes_missing() {
    // 0x82 with only one following byte -> can't reconstruct length.
    let b = list_new()
    push(b, 4); push(b, 130); push(b, 0)
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, len(b), 0, tag, ln, vo, no)
    ce_eq("missing length bytes rejected", ok, DER_ERR)
}

// ---- indefinite length ---------------------------------------------------

fn test_indefinite_length_rejected() {
    // 0x30 0x80 ... 0x00 0x00 -- BER indefinite; DER refuses.
    let b = list_new()
    push(b, 48); push(b, 128); push(b, 0); push(b, 0)
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    let ok = der_read_tlv(b, 4, 0, tag, ln, vo, no)
    ce_eq("indefinite length rejected", ok, DER_ERR)
}

// ---- truncation gates ----------------------------------------------------

fn test_off_out_of_buffer() {
    let b = list_new()
    push(b, 2); push(b, 1); push(b, 5)
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    ce_eq("off past buf_len rejected",
          der_read_tlv(b, 3, 3, tag, ln, vo, no), DER_ERR)
    ce_eq("negative off rejected",
          der_read_tlv(b, 3, 0 - 1, tag, ln, vo, no), DER_ERR)
}

fn test_buf_len_over_true_len_rejected() {
    let b = list_new()
    push(b, 2); push(b, 1); push(b, 5)
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    ce_eq("buf_len > len(buf) rejected",
          der_read_tlv(b, 100, 0, tag, ln, vo, no), DER_ERR)
}

fn test_truncated_content() {
    // 02 05 01 02 -- claims length 5 but only 2 content bytes present.
    let b = list_new()
    push(b, 2); push(b, 5); push(b, 1); push(b, 2)
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    ce_eq("truncated content rejected",
          der_read_tlv(b, 4, 0, tag, ln, vo, no), DER_ERR)
}

// ---- long-form tag rejection --------------------------------------------

fn test_long_form_tag_rejected() {
    // Tag 0x1F is the long-form tag escape (low 5 bits all set).
    let b = list_new()
    push(b, 31); push(b, 1); push(b, 5)   // Even 0x1F alone triggers.
    let tag = list_new(); push(tag, 0)
    let ln  = list_new(); push(ln, 0)
    let vo  = list_new(); push(vo, 0)
    let no  = list_new(); push(no, 0)
    ce_eq("long-form tag identifier rejected",
          der_read_tlv(b, 3, 0, tag, ln, vo, no), DER_ERR)
}

// ---- der_expect_tag ------------------------------------------------------

fn test_expect_tag_match() {
    let b = list_new()
    push(b, 2); push(b, 1); push(b, 5)
    let vo = list_new(); push(vo, 0)
    let ln = list_new(); push(ln, 0)
    let no = list_new(); push(no, 0)
    ce_eq("expect INTEGER match",
          der_expect_tag(b, 3, 0, DER_INTEGER, vo, ln, no), DER_OK)
    ce_eq("expect INTEGER val_off", vo[0], 2)
    ce_eq("expect INTEGER len", ln[0], 1)
}

fn test_expect_tag_mismatch() {
    let b = list_new()
    push(b, 2); push(b, 1); push(b, 5)
    let vo = list_new(); push(vo, 0)
    let ln = list_new(); push(ln, 0)
    let no = list_new(); push(no, 0)
    ce_eq("expect SEQUENCE mismatch on INTEGER",
          der_expect_tag(b, 3, 0, DER_SEQUENCE, vo, ln, no), DER_ERR)
}

// ---- nested walk ---------------------------------------------------------

fn test_nested_sequence_walk() {
    let b = _tder_nested_seq()
    let outer_vo = list_new(); push(outer_vo, 0)
    let outer_ln = list_new(); push(outer_ln, 0)
    let outer_no = list_new(); push(outer_no, 0)
    ce_eq("outer SEQ parsed",
          der_expect_tag(b, len(b), 0, DER_SEQUENCE,
                         outer_vo, outer_ln, outer_no), DER_OK)
    ce_eq("outer SEQ content len", outer_ln[0], 8)
    ce_eq("outer SEQ next off (end of buffer)", outer_no[0], 10)
    // Walk inside: inner SEQ then trailing INT.
    let inner_vo = list_new(); push(inner_vo, 0)
    let inner_ln = list_new(); push(inner_ln, 0)
    let inner_no = list_new(); push(inner_no, 0)
    ce_eq("inner SEQ parsed",
          der_expect_tag(b, len(b), outer_vo[0], DER_SEQUENCE,
                         inner_vo, inner_ln, inner_no), DER_OK)
    ce_eq("inner SEQ content len", inner_ln[0], 3)
    let int_vo = list_new(); push(int_vo, 0)
    let int_ln = list_new(); push(int_ln, 0)
    let int_no = list_new(); push(int_no, 0)
    ce_eq("inner INT parsed",
          der_expect_tag(b, len(b), inner_vo[0], DER_INTEGER,
                         int_vo, int_ln, int_no), DER_OK)
    ce_eq("inner INT value", b[int_vo[0]], 5)
    // Trailing INT immediately after inner SEQ.
    let tail_vo = list_new(); push(tail_vo, 0)
    let tail_ln = list_new(); push(tail_ln, 0)
    let tail_no = list_new(); push(tail_no, 0)
    ce_eq("trailing INT parsed",
          der_expect_tag(b, len(b), inner_no[0], DER_INTEGER,
                         tail_vo, tail_ln, tail_no), DER_OK)
    ce_eq("trailing INT value", b[tail_vo[0]], 7)
    ce_eq("trailing INT exhausts outer SEQ", tail_no[0], outer_no[0])
}

// ---- BIT STRING ---------------------------------------------------------

fn test_bitstring_zero_unused() {
    // BIT STRING with 0 unused bits and 4 content bytes: 03 05 00 AA BB CC DD
    let b = list_new()
    push(b, 3); push(b, 5); push(b, 0)
    push(b, 170); push(b, 187); push(b, 204); push(b, 221)
    let vo = list_new(); push(vo, 0)
    let ln = list_new(); push(ln, 0)
    let no = list_new(); push(no, 0)
    ce_eq("BIT STRING TLV parsed",
          der_expect_tag(b, len(b), 0, DER_BIT_STRING, vo, ln, no), DER_OK)
    let out_off = list_new(); push(out_off, 0)
    let out_ln  = list_new(); push(out_ln, 0)
    ce_eq("BIT STRING 0-unused content OK",
          der_bitstring_content(b, vo[0], ln[0], out_off, out_ln), DER_OK)
    ce_eq("BIT STRING content offset skips unused byte", out_off[0], vo[0] + 1)
    ce_eq("BIT STRING content length", out_ln[0], 4)
}

fn test_bitstring_nonzero_unused_rejected() {
    // 03 03 03 F0 F0 -- unused = 3 (nonzero) -> reject.
    let b = list_new()
    push(b, 3); push(b, 3); push(b, 3); push(b, 240); push(b, 240)
    let vo = list_new(); push(vo, 0)
    let ln = list_new(); push(ln, 0)
    let no = list_new(); push(no, 0)
    der_expect_tag(b, len(b), 0, DER_BIT_STRING, vo, ln, no)
    let out_off = list_new(); push(out_off, 0)
    let out_ln  = list_new(); push(out_ln, 0)
    ce_eq("BIT STRING nonzero-unused rejected",
          der_bitstring_content(b, vo[0], ln[0], out_off, out_ln), DER_ERR)
}

fn test_bitstring_empty_content_rejected() {
    // BIT STRING with empty content (no unused-bits byte) -> reject.
    let out_off = list_new(); push(out_off, 0)
    let out_ln  = list_new(); push(out_ln, 0)
    ce_eq("empty BIT STRING rejected",
          der_bitstring_content(list_new(), 0, 0, out_off, out_ln), DER_ERR)
}

// ---- OID equality --------------------------------------------------------

fn test_oid_equal_match() {
    // Ed25519 OID content: 2B 65 70
    let b = list_new()
    push(b, 43); push(b, 101); push(b, 112)
    let expected = list_new()
    push(expected, 43); push(expected, 101); push(expected, 112)
    ce_eq("OID match", der_oid_equal(b, 0, 3, expected, 3), 1)
}

fn test_oid_equal_len_mismatch() {
    let b = list_new()
    push(b, 43); push(b, 101); push(b, 112)
    let expected = list_new()
    push(expected, 43); push(expected, 101)
    ce_eq("OID length mismatch", der_oid_equal(b, 0, 3, expected, 2), 0)
}

fn test_oid_equal_prefix_mismatch() {
    let b = list_new()
    push(b, 43); push(b, 101); push(b, 112)
    let expected = list_new()
    push(expected, 43); push(expected, 101); push(expected, 113)
    ce_eq("OID prefix mismatch (last byte differs)",
          der_oid_equal(b, 0, 3, expected, 3), 0)
}

fn test_oid_equal_out_of_range() {
    let b = list_new()
    push(b, 43); push(b, 101)
    let expected = list_new()
    push(expected, 43); push(expected, 101); push(expected, 112)
    ce_eq("OID out-of-range offset+len returns 0",
          der_oid_equal(b, 0, 3, expected, 3), 0)
}

// ---- context-specific [0] EXPLICIT --------------------------------------

fn test_context_zero_explicit() {
    // [0] EXPLICIT INTEGER 2: A0 03 02 01 02
    let b = list_new()
    push(b, 160); push(b, 3); push(b, 2); push(b, 1); push(b, 2)
    let vo = list_new(); push(vo, 0)
    let ln = list_new(); push(ln, 0)
    let no = list_new(); push(no, 0)
    ce_eq("[0] EXPLICIT parsed",
          der_expect_tag(b, len(b), 0, DER_CONTEXT_0, vo, ln, no), DER_OK)
    ce_eq("[0] EXPLICIT content len", ln[0], 3)
    let int_vo = list_new(); push(int_vo, 0)
    let int_ln = list_new(); push(int_ln, 0)
    let int_no = list_new(); push(int_no, 0)
    ce_eq("wrapped INTEGER parsed",
          der_expect_tag(b, len(b), vo[0], DER_INTEGER, int_vo, int_ln, int_no),
          DER_OK)
    ce_eq("wrapped INTEGER value", b[int_vo[0]], 2)
}

// ---- der_bytes_equal ----------------------------------------------------

fn test_bytes_equal_match() {
    let a = list_new()
    push(a, 1); push(a, 2); push(a, 3); push(a, 4)
    let b = list_new()
    push(b, 9); push(b, 1); push(b, 2); push(b, 3); push(b, 4); push(b, 9)
    ce_eq("bytes_equal identical slice", der_bytes_equal(a, 0, 4, b, 1, 4), 1)
}

fn test_bytes_equal_mismatch() {
    let a = list_new()
    push(a, 1); push(a, 2); push(a, 3); push(a, 4)
    let b = list_new()
    push(b, 1); push(b, 2); push(b, 3); push(b, 5)
    ce_eq("bytes_equal diff byte -> 0", der_bytes_equal(a, 0, 4, b, 0, 4), 0)
}

fn test_bytes_equal_len_diff() {
    let a = list_new()
    push(a, 1); push(a, 2)
    let b = list_new()
    push(b, 1); push(b, 2); push(b, 3)
    ce_eq("bytes_equal length diff -> 0", der_bytes_equal(a, 0, 2, b, 0, 3), 0)
}

fn test_bytes_equal_empty() {
    let a = list_new()
    let b = list_new()
    ce_eq("bytes_equal empty slices -> 1", der_bytes_equal(a, 0, 0, b, 0, 0), 1)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_constants()
    test_short_form_length()
    test_short_form_max_127()
    test_long_form_1byte()
    test_long_form_2byte()
    test_long_form_2byte_max()
    test_long_form_3byte_denied_over_max()
    test_long_form_length_bytes_missing()
    test_indefinite_length_rejected()
    test_off_out_of_buffer()
    test_buf_len_over_true_len_rejected()
    test_truncated_content()
    test_long_form_tag_rejected()
    test_expect_tag_match()
    test_expect_tag_mismatch()
    test_nested_sequence_walk()
    test_bitstring_zero_unused()
    test_bitstring_nonzero_unused_rejected()
    test_bitstring_empty_content_rejected()
    test_oid_equal_match()
    test_oid_equal_len_mismatch()
    test_oid_equal_prefix_mismatch()
    test_oid_equal_out_of_range()
    test_context_zero_explicit()
    test_bytes_equal_match()
    test_bytes_equal_mismatch()
    test_bytes_equal_len_diff()
    test_bytes_equal_empty()
    ce_summary("der")
}

main()
