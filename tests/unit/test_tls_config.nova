// Unit tests for src/net/tls/tls_config.nova R94 additions.
//
// tls_config_new_empty / tls_config_new_from_material coverage lives
// in test_tls_scaffold; this file exercises the R94 production-shape
// constructors (server + client) and the accessors they populate.

import "../ce_test.nova"
import "../../src/net/tls/tls_config.nova"
import "../../src/safety/ed25519.nova"
import "./fixtures/x509_test_certs.nova"

let _TC_NOW = 1718452800

// Test-cert cache; mirrors test_tls_session's approach.
let _TC_ROOT_CACHE = list_new()
let _TC_LEAF_CACHE = list_new()

fn _tc_root() {
    if len(_TC_ROOT_CACHE) == 0 {
        let pk = fx_ed25519_test1_pub()
        let sk = fx_ed25519_test1_seed()
        let c = x509_build_test_cert("TC_Root", "TC_Root", 1,
                                     "200101000000Z", "490101000000Z",
                                     pk, sk, pk)
        let i = 0
        while i < len(c) { push(_TC_ROOT_CACHE, c[i]); i = i + 1 }
    }
    return _TC_ROOT_CACHE
}

fn _tc_leaf() {
    if len(_TC_LEAF_CACHE) == 0 {
        let leaf_pk = fx_ed25519_test2_pub()
        let root_sk = fx_ed25519_test1_seed()
        let root_pk = fx_ed25519_test1_pub()
        let c = x509_build_test_cert("TC_Leaf", "TC_Root", 2,
                                     "200101000000Z", "490101000000Z",
                                     leaf_pk, root_sk, root_pk)
        let i = 0
        while i < len(c) { push(_TC_LEAF_CACHE, c[i]); i = i + 1 }
    }
    return _TC_LEAF_CACHE
}

fn _tc_bytes_eq(a, b) {
    if len(a) != len(b) { return 0 }
    let i = 0
    let n = len(a)
    while i < n {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

fn test_new_server_ok_and_fields() {
    let root = _tc_root()
    let leaf = _tc_leaf()
    let priv = fx_ed25519_test2_seed()
    let cfg = list_new()
    ce_eq("new_server ok",
          tls_config_new_server(cfg, leaf, len(leaf), priv,
                                 root, len(root)), 1)
    ce_eq("role = SERVER",     tls_config_role(cfg), TLS_CONFIG_ROLE_SERVER)
    ce_eq("cert_der matches",  _tc_bytes_eq(tls_config_cert_der(cfg), leaf), 1)
    ce_eq("key_der matches",   _tc_bytes_eq(tls_config_key_der(cfg), priv), 1)
    ce_eq("root_der matches",  _tc_bytes_eq(tls_config_root_der(cfg), root), 1)
    // Derived pubkey matches the RFC 8032 TEST 2 public key.
    let expected_pub = fx_ed25519_test2_pub()
    ce_eq("cert_pub derived",  _tc_bytes_eq(tls_config_cert_pub(cfg),
                                             expected_pub), 1)
    ce_eq("has_material",      tls_config_has_material(cfg), 1)
}

fn test_new_server_bad_priv_len_refused() {
    let root = _tc_root()
    let leaf = _tc_leaf()
    let bad_priv = list_new()
    push(bad_priv, 1)
    push(bad_priv, 2)
    let cfg = list_new()
    ce_eq("short priv refused",
          tls_config_new_server(cfg, leaf, len(leaf), bad_priv,
                                 root, len(root)), 0)
}

fn test_new_server_bad_leaf_der_refused() {
    let root = _tc_root()
    let priv = fx_ed25519_test2_seed()
    // A malformed leaf DER: five random bytes -- fails x509_parse.
    let bad = list_new()
    push(bad, 1); push(bad, 2); push(bad, 3); push(bad, 4); push(bad, 5)
    let cfg = list_new()
    ce_eq("bad leaf refused",
          tls_config_new_server(cfg, bad, len(bad), priv,
                                 root, len(root)), 0)
}

fn test_new_server_bad_root_der_refused() {
    let leaf = _tc_leaf()
    let priv = fx_ed25519_test2_seed()
    let bad = list_new()
    push(bad, 9); push(bad, 8); push(bad, 7); push(bad, 6); push(bad, 5)
    let cfg = list_new()
    ce_eq("bad root refused",
          tls_config_new_server(cfg, leaf, len(leaf), priv,
                                 bad, len(bad)), 0)
}

fn test_new_server_length_mismatch_refused() {
    let root = _tc_root()
    let leaf = _tc_leaf()
    let priv = fx_ed25519_test2_seed()
    let cfg = list_new()
    ce_eq("len mismatch leaf refused",
          tls_config_new_server(cfg, leaf, len(leaf) - 1, priv,
                                 root, len(root)), 0)
    let cfg2 = list_new()
    ce_eq("len mismatch root refused",
          tls_config_new_server(cfg2, leaf, len(leaf), priv,
                                 root, len(root) - 1), 0)
}

fn test_new_client_ok_and_fields() {
    let root = _tc_root()
    let cfg = list_new()
    ce_eq("new_client ok",
          tls_config_new_client(cfg, root, len(root)), 1)
    ce_eq("role = CLIENT",    tls_config_role(cfg), TLS_CONFIG_ROLE_CLIENT)
    ce_eq("cert_der empty",   len(tls_config_cert_der(cfg)), 0)
    ce_eq("key_der empty",    len(tls_config_key_der(cfg)), 0)
    ce_eq("root_der matches", _tc_bytes_eq(tls_config_root_der(cfg), root), 1)
}

fn test_new_client_bad_root_refused() {
    let bad = list_new()
    push(bad, 1); push(bad, 2); push(bad, 3)
    let cfg = list_new()
    ce_eq("bad root refused",
          tls_config_new_client(cfg, bad, len(bad)), 0)
}

fn test_new_client_length_mismatch_refused() {
    let root = _tc_root()
    let cfg = list_new()
    ce_eq("len mismatch refused",
          tls_config_new_client(cfg, root, len(root) - 1), 0)
}

fn test_empty_config_role_none() {
    let c = tls_config_new_empty()
    ce_eq("empty cfg role = NONE", tls_config_role(c), TLS_CONFIG_ROLE_NONE)
    ce_eq("empty cfg root empty",  len(tls_config_root_der(c)), 0)
    ce_eq("empty cfg pub empty",   len(tls_config_cert_pub(c)), 0)
}

fn main() {
    test_new_server_ok_and_fields()
    test_new_server_bad_priv_len_refused()
    test_new_server_bad_leaf_der_refused()
    test_new_server_bad_root_der_refused()
    test_new_server_length_mismatch_refused()
    test_new_client_ok_and_fields()
    test_new_client_bad_root_refused()
    test_new_client_length_mismatch_refused()
    test_empty_config_role_none()
    ce_summary("tls_config")
}

main()
