// CE_TEST_TIMEOUT: 240
// End-to-end tests of src/learning/sa4_coord.nova (A2.2b), part 2: one bad
// or silent soul is left out and the round still completes for the rest
// (N = 5, t = 4), with the unmasked sum equal to the sum over U3.
//   - a soul stops after ADV (in U1, not U2);
//   - a soul in U3 sends no SIG3 (U4 = 4): its b-share is revealed and its
//     y still counts.
// Bad-soul cases are in test_sa4_coord3.nova and test_sa4_coord4.nova.

import "../ce_test.nova"
import "../sa4_harness.nova"

let C2_R = 35

fn c2_run(vc, stops, tampers) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, C2_R, vc, 0)
    let c = sa4e_coord(roster, C2_R, vc)
    let res = sa4e_round(roster, souls, c, stops, tampers)
    if res[0] != 1 { println("  reason: " + res[1]) }
    return res
}

fn main() {
    let vc = list_new()
    let a = c2_run(vc, [[4, 1]], list_new())
    ce_eq("stop after ADV: unmasks", a[0], 1)
    ce_eq("stop after ADV: U2 = 4", len(sa4c_set(a[3], 2)), 4)
    ce_eq("stop after ADV: sum over the four", sa4h_same(a[2], sa4h_expected([1, 2, 3, 4])), 1)

    let b = c2_run(vc, [[1, 3]], list_new())
    ce_eq("silent at SIG3: unmasks", b[0], 1)
    ce_eq("silent at SIG3: U3 = 5", len(sa4c_set(b[3], 3)), 5)
    ce_eq("silent at SIG3: U4 = 4", len(sa4c_set(b[3], 4)), 4)
    ce_eq("silent at SIG3: sum includes its y", sa4h_same(b[2], sa4h_expected([1, 2, 3, 4, 5])), 1)

    ce_summary("sa4_coord2")
}

main()
