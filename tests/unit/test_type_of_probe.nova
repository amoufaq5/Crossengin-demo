// Phase-Q R3e empirical probe for the `type_of()` runtime regression.
//
// Historical NOVA mapping (ADR-0054 era):
//   type_of(int)    == 1
//   type_of(string) == 2
//   type_of(list)   == 3
//   type_of(map)    == 4
//
// Observed on current codegen (c2e0f1a, 2026-10):
//   type_of(int)    returns 0 (plain int, compares equal to 0)
//   type_of(list)   returns 1 (plain int, compares equal to 1)
//   type_of(string) returns a TAGGED value: int_to_str() prints "1", but
//     it is NEITHER equal to 1 NOR equal to any integer -- it only
//     agrees via <, >, +, and the printing path.
//
// The tagged value is the pivot that makes the regression tractable:
// `type_of(x) == 1` is TRUE for lists and FALSE for strings, so lists
// remain distinguishable from strings and from ints via a user-level
// predicate. See ADR-0104 and `src/util/type_safe.nova` for the
// workaround that `is_list_val` / `is_str_val` / `is_int_val` provide,
// and the 7 migrated call sites.
//
// This test pins the CURRENT regressed semantics so it is green at HEAD;
// a future NOVA codegen fix will visibly break this test, prompting an
// upstream regression dance.

import "../ce_test.nova"

fn main() {
    // ---- type_of(int) -> plain 0 --------------------------------------
    let t_int0  = type_of(0)
    let t_int42 = type_of(42)
    ce_check("type_of(0) == 0",  t_int0  == 0)
    ce_check("type_of(42) == 0", t_int42 == 0)
    ce_check("type_of(0) != 1",  t_int0  != 1)

    // ---- type_of(list) -> plain 1 -------------------------------------
    let l_empty = list_new()
    let l_one   = list_new()
    push(l_one, 42)
    let t_lemp  = type_of(l_empty)
    let t_lone  = type_of(l_one)
    ce_check("type_of([]) == 1",   t_lemp == 1)
    ce_check("type_of([42]) == 1", t_lone == 1)
    ce_check("type_of([]) != 0",   t_lemp != 0)

    // ---- type_of(string) -> tagged, neither == 0 nor == 1 -------------
    let t_sempty = type_of("")
    let t_sabc   = type_of("abc")
    ce_check("type_of(\"\") != 0",  t_sempty != 0)
    ce_check("type_of(\"\") != 1",  t_sempty != 1)
    ce_check("type_of(\"abc\") != 0", t_sabc != 0)
    ce_check("type_of(\"abc\") != 1", t_sabc != 1)

    // The pivot predicate used by src/util/type_safe.nova: `t == 1`
    // distinguishes list (TRUE) from string (FALSE) and int (FALSE).
    ce_check("list and string differ under == 1",
             (t_lone == 1) != (t_sabc == 1))

    // ---- len() still works on strings and lists -----------------------
    ce_eq("len(\"\")",    len(""),    0)
    ce_eq("len(\"abc\")", len("abc"), 3)
    ce_eq("len([])",      len(l_empty), 0)
    ce_eq("len([42])",    len(l_one),   1)

    ce_summary("test_type_of_probe")
}

main()
