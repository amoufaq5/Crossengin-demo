// Pin the historical NOVA `type_of()` semantics, restored upstream by
// NOVA commit 651a507 (tagged `_nova_type_of` return + match-arm cmp).
//
// Historical NOVA mapping:
//   type_of(null)   == 0
//   type_of(int)    == 1
//   type_of(string) == 2
//   type_of(list)   == 3
//   type_of(map)    == 4
//
// This test replaces the Phase-Q R3e empirical probe that pinned the
// regressed values. See ADR-0104 (Superseded).

import "../ce_test.nova"

fn main() {
    // ---- type_of(int) -> 1 --------------------------------------------
    let t_int0  = type_of(0)
    let t_int42 = type_of(42)
    ce_check("type_of(0) == 1",  t_int0  == 1)
    ce_check("type_of(42) == 1", t_int42 == 1)

    // ---- type_of(string) -> 2 -----------------------------------------
    let t_sempty = type_of("")
    let t_sabc   = type_of("abc")
    ce_check("type_of(\"\") == 2",    t_sempty == 2)
    ce_check("type_of(\"abc\") == 2", t_sabc   == 2)

    // ---- type_of(list) -> 3 -------------------------------------------
    let l_empty = list_new()
    let l_one   = list_new()
    push(l_one, 42)
    let t_lemp  = type_of(l_empty)
    let t_lone  = type_of(l_one)
    ce_check("type_of([]) == 3",   t_lemp == 3)
    ce_check("type_of([42]) == 3", t_lone == 3)

    // ---- type_of(map) -> 4 --------------------------------------------
    let m = map_new()
    ce_check("type_of({}) == 4", type_of(m) == 4)

    // ---- len() still works on strings and lists -----------------------
    ce_eq("len(\"\")",    len(""),    0)
    ce_eq("len(\"abc\")", len("abc"), 3)
    ce_eq("len([])",      len(l_empty), 0)
    ce_eq("len([42])",    len(l_one),   1)

    ce_summary("test_type_of_probe")
}

main()
