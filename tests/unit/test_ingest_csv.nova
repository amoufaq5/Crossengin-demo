// Unit tests for src/ingest/importers/csv_facts.nova.

import "../ce_test.nova"
import "../../src/ingest/importers/csv_facts.nova"

fn test_empty_text() {
    let r = csv_parse_text("", "k", "src:x")
    ce_eq("no records", len(csv_records(r)), 0)
}

fn test_header_only_yields_empty_record() {
    let r = csv_parse_text("a,b,c\n", "k", "src:x")
    ce_eq("one record", len(csv_records(r)), 1)
    ce_eq("no atoms", len(cur_atoms(csv_records(r)[0])), 0)
}

fn test_simple_rows() {
    let text = "name,species,habitat\n"
             + "alice,dog,indoor\n"
             + "bob,cat,indoor\n"
    let r = csv_parse_text(text, "animals", "src:csv:pets")
    let recs = csv_records(r)
    ce_eq("one record", len(recs), 1)
    let rec = recs[0]
    // atoms: alice, dog, indoor, bob, cat  (indoor dedup'd)
    ce_eq("5 unique atoms", len(cur_atoms(rec)), 5)
    // 2 implications per row * 2 rows = 4
    ce_eq("4 implications", len(cur_imps(rec)), 4)
    ce_eq("validator ok", cur_validate(rec), CUR_OK)
}

fn test_dedup_row_labels() {
    // Same first-column value in two rows -> one atom, but each row's
    // implications counted separately.
    let text = "k,v\nA,x\nA,y\n"
    let r = csv_parse_text(text, "k", "src:x")
    let rec = csv_records(r)[0]
    ce_eq("3 unique atoms (A,x,y)", len(cur_atoms(rec)), 3)
    ce_eq("2 implications", len(cur_imps(rec)), 2)
}

fn test_quoted_fields() {
    let text = "name,note\n"
             + "\"Alice, PhD\",\"a note with, comma\"\n"
    let r = csv_parse_text(text, "k", "src:x")
    let rec = csv_records(r)[0]
    // 2 atoms: cleaned labels
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("1 imp", len(cur_imps(rec)), 1)
}

fn test_escaped_quote_in_quoted_field() {
    let text = "name\n\"she said \"\"hi\"\"\"\n"
    let r = csv_parse_text(text, "k", "src:x")
    ce_eq("1 atom", len(cur_atoms(csv_records(r)[0])), 1)
}

fn test_empty_row_skipped() {
    let text = "a,b\n1,2\n,\n3,4\n"
    let r = csv_parse_text(text, "k", "src:x")
    let rec = csv_records(r)[0]
    // atoms: 1, 2, 3, 4 -> 4
    ce_eq("4 atoms", len(cur_atoms(rec)), 4)
    ce_eq("2 imps", len(cur_imps(rec)), 2)
}

fn test_empty_column_value_skipped() {
    // Only non-empty columns produce implications.
    let text = "k,v,w\nA,B,\n"
    let r = csv_parse_text(text, "k", "src:x")
    let rec = csv_records(r)[0]
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("1 imp", len(cur_imps(rec)), 1)
}

fn test_crlf_line_endings() {
    let text = "a,b\r\n1,2\r\n3,4\r\n"
    let r = csv_parse_text(text, "k", "src:x")
    let rec = csv_records(r)[0]
    ce_eq("4 atoms", len(cur_atoms(rec)), 4)
    ce_eq("2 imps", len(cur_imps(rec)), 2)
}

fn test_key_column_empty_logged() {
    let text = "k,v\n,foo\n"
    let r = csv_parse_text(text, "k", "src:x")
    ce_check("has error", len(csv_errors(r)) >= 1)
}

fn test_label_sanitization() {
    // Values with spaces / punctuation become underscore-separated safe labels.
    let text = "k\nfoo bar!\n"
    let r = csv_parse_text(text, "k", "src:x")
    let rec = csv_records(r)[0]
    ce_eq("1 atom", len(cur_atoms(rec)), 1)
    ce_eq("sanitized label", cur_atoms(rec)[0][CUR_ATOM_LABEL], "foo_bar_")
}

fn main() {
    test_empty_text()
    test_header_only_yields_empty_record()
    test_simple_rows()
    test_dedup_row_labels()
    test_quoted_fields()
    test_escaped_quote_in_quoted_field()
    test_empty_row_skipped()
    test_empty_column_value_skipped()
    test_crlf_line_endings()
    test_key_column_empty_logged()
    test_label_sanitization()
    ce_summary("ingest_csv")
}

main()
