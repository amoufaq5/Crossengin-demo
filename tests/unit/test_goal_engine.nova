// Unit tests for src/parts/goals/goal_engine.nova
// Verifies goal creation, subgoal trees, progress rollup + auto-satisfy, block
// propagation, leaf arbitration by priority, and staleness decay. ADR-0033.

import "../ce_test.nova"
import "../../src/parts/goals/goal_engine.nova"

fn test_create_and_tree() {
    let e = goal_engine_new()
    let root = goal_new(e, "learn medicine", 800, 0, 1, 0)
    ce_eq("id 0", root, 0)
    ce_str_eq("name", goal_name(e, root), "learn medicine")
    ce_eq("active", goal_status(e, root), GOAL_ACTIVE)
    ce_eq("priority", goal_priority(e, root), 800)
    ce_eq("leaf initially", goal_is_leaf(e, root), 1)
    let s1 = goal_new(e, "read drug atoms", 500, 0, 1, 0)
    let s2 = goal_new(e, "practice dosing", 600, 0, 1, 0)
    goal_add_subgoal(e, root, s1)
    goal_add_subgoal(e, root, s2)
    ce_eq("root not leaf", goal_is_leaf(e, root), 0)
    ce_eq("two children", len(goal_children(e, root)), 2)
    ce_eq("child parent set", goal_parent(e, s1), root)
}

fn test_rollup_and_satisfy() {
    let e = goal_engine_new()
    let root = goal_new(e, "r", 800, 0, 1, 0)
    let a = goal_new(e, "a", 500, 0, 1, 0)
    let b = goal_new(e, "b", 500, 0, 1, 0)
    goal_add_subgoal(e, root, a)
    goal_add_subgoal(e, root, b)
    goal_set_progress(e, a, 1000)   // satisfied
    goal_set_progress(e, b, 400)
    ce_eq("a satisfied", goal_status(e, a), GOAL_SATISFIED)
    // Rollup: parent = mean(1.0, 0.4) = 0.7.
    ce_eq("rollup mean", goal_rollup_progress(e, root), 700)
    // Both satisfied -> parent satisfied.
    goal_set_progress(e, b, 1000)
    goal_rollup_progress(e, root)
    ce_eq("parent satisfied", goal_status(e, root), GOAL_SATISFIED)
}

fn test_block_propagation() {
    let e = goal_engine_new()
    let root = goal_new(e, "r", 800, 0, 1, 0)
    let a = goal_new(e, "a", 500, 0, 1, 0)
    let b = goal_new(e, "b", 500, 0, 1, 0)
    goal_add_subgoal(e, root, a)
    goal_add_subgoal(e, root, b)
    // Block one child -> root still active (other path open).
    goal_propagate_block(e, a)
    ce_eq("a blocked", goal_status(e, a), GOAL_BLOCKED)
    ce_eq("root still active", goal_status(e, root), GOAL_ACTIVE)
    // Block the other -> root becomes blocked.
    goal_propagate_block(e, b)
    ce_eq("root blocked", goal_status(e, root), GOAL_BLOCKED)
}

fn test_arbitration() {
    let e = goal_engine_new()
    let root = goal_new(e, "r", 900, 0, 1, 0)   // high priority but not a leaf
    let a = goal_new(e, "a", 500, 0, 1, 0)
    let b = goal_new(e, "b", 700, 0, 1, 0)
    goal_add_subgoal(e, root, a)
    goal_add_subgoal(e, root, b)
    // Arbitration picks the highest-priority active leaf (b), not the root.
    ce_eq("picks highest leaf", goal_arbitrate(e), b)
    // Block b -> arbitration falls to a.
    goal_propagate_block(e, b)
    ce_eq("falls to next leaf", goal_arbitrate(e), a)
    ce_eq("active count", goal_active_count(e), 2)   // root + a
}

fn test_staleness_decay() {
    let e = goal_engine_new()
    let fresh = goal_new(e, "fresh", 800, 0, 1, 100)
    let stale = goal_new(e, "stale", 800, 0, 1, 0)
    // At now=100, decay goals untouched for >= 50 ticks, retain 0.5.
    let n = goal_decay_stale(e, 100, 50, 500)
    ce_eq("one stale decayed", n, 1)
    ce_eq("stale priority halved", goal_priority(e, stale), 400)
    ce_eq("fresh untouched", goal_priority(e, fresh), 800)
}

fn main() {
    test_create_and_tree()
    test_rollup_and_satisfy()
    test_block_propagation()
    test_arbitration()
    test_staleness_decay()
    ce_summary("goal_engine")
}

main()
