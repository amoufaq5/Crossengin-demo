// Unit tests for src/factory/update_delta.nova (R102, Phase D part 3).
//
// End-to-end: bake an initial bundle A, mutate the mother, compute a
// delta A->B, verify, apply on a fresh child, walk the chain.

import "../ce_test.nova"
import "../../src/factory/update_delta.nova"
import "../../src/factory/bake.nova"
import "../../src/factory/bake_manifest.nova"
import "../../src/persistence/bundle_signing.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/ingest/policy.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/safety/ed25519.nova"
import "../../src/safety/sha256.nova"
import "../../src/util/str_safe.nova"

// ---- shared fixtures ----------------------------------------------------

let _kp = 0
fn _kp_seed() { if _kp == 0 { _kp = ed25519_keygen() } return _kp[0] }
fn _kp_pk()   { if _kp == 0 { _kp = ed25519_keygen() } return _kp[1] }

fn _mk_manifest() {
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "delta-child")
    bake_manifest_set_version(m, "0.1.0")
    bake_manifest_set_domain(m, "astro")
    bake_manifest_add_capsule(m, "solar_system")
    bake_manifest_add_capsule(m, "physics")
    bake_manifest_add_skill(m, "echo_skill")
    bake_manifest_add_policy(m, "auto_open")
    bake_manifest_add_kg_prefix(m, "solar_")
    return m
}

fn _mk_kg_v1() {
    let r = kg_registry_new()
    let kg = kg_spawn(r, "solar_system")
    // Stamped at moment 10; these atoms are the "initial" state.
    let a = kg_add_atom(kg, ATOM_FACT, "mars", 10)
    atom_set_license(a, LICENSE_OPEN)
    let b = kg_add_atom(kg, ATOM_FACT, "phobos", 10)
    atom_set_license(b, LICENSE_OPEN)
    return r
}

fn _mk_capreg_v1() {
    let r = capreg_new()
    capreg_register(r, capsule_new("solar_system", "1.0.0", "system", "OPEN"))
    return r
}

fn _mk_skill_reg_v1() {
    let r = skill_registry_new()
    skill_registry_register(r, skill_manifest_new("echo_skill", "1.0", "echo", 1))
    return r
}

fn _mk_pol_reg_v1() {
    let r = policy_registry_new()
    policy_registry_register(r, policy_new("auto_open", 0))
    return r
}

fn _bake_v1() {
    let br = bake_child(_mk_manifest(),
        persona_registry_new(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(),
        _mk_pol_reg_v1(), ownership_registry_new(),
        _kp_seed(), _kp_pk(), 10)
    return bake_result_bundle(br)
}

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- basic delta compute ------------------------------------------------

fn test_delta_compute_empty_window() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    // Same mother state, empty (0, 0] window -> no additions or removals.
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        20, 20, _kp_seed(), _kp_pk(), 100)
    ce_eq("empty window ok",         delta_result_ok(dr), 1)
    ce_eq("no atoms added",          delta_result_atoms_added(dr), 0)
    ce_eq("no atoms retracted",      delta_result_atoms_retracted(dr), 0)
}

fn test_delta_compute_since_equals_until() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        50, 50, _kp_seed(), _kp_pk(), 100)
    ce_eq("since=until ok",     delta_result_ok(dr), 1)
    ce_eq("no additions",       delta_result_atoms_added(dr), 0)
    let delta = delta_result_delta(dr)
    ce_check("has banner",      _has(delta, "#CROSSENGIN-KG-DELTA v1"))
    ce_check("has parent-fp",   _has(delta, "#parent-bundle-fingerprint "))
    ce_check("has signature",   _has(delta, "#SIGNATURE "))
    // Delta-fingerprint = SHA-256 of the whole delta bytes; exposed via
    // delta_result_delta_fp / delta_apply's DR_DELTA_FP, NOT embedded
    // in the header (can't hash something that includes itself).
    ce_eq("delta_fp is 64 hex chars",
          len(delta_result_delta_fp(dr)), 64)
}

fn test_delta_bundle_shape() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 100)
    ce_eq("delta ok", delta_result_ok(dr), 1)
    let delta = delta_result_delta(dr)
    ce_check("has DELTA-KG",      _has(delta, "#DELTA-KG v1"))
    ce_check("has DELTA-CAPSULE", _has(delta, "#DELTA-CAPSULE v1"))
    ce_check("has DELTA-SKILL",   _has(delta, "#DELTA-SKILL v1"))
    ce_check("has DELTA-PATTERN", _has(delta, "#DELTA-PATTERN v1"))
    ce_check("has DELTA-POLICY",  _has(delta, "#DELTA-POLICY v1"))
    ce_check("has emitted-at",    _has(delta, "#emitted-at 100"))
    ce_check("has manifest-name", _has(delta, "#manifest-name delta-child"))
}

fn test_delta_added_atoms_in_window() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    // Build a v2 KG with an additional atom stamped at moment 50.
    let kg2 = _mk_kg_v1()
    let solar = kg_find(kg2, "solar_system")
    let d = kg_add_atom(solar, ATOM_FACT, "deimos", 50)
    atom_set_license(d, LICENSE_OPEN)
    // Delta window (10, 100] should catch deimos but NOT the v1 atoms
    // (all stamped at moment 10, boundary NOT included).
    let dr = delta_compute(bundle_a, _mk_manifest(),
        kg2, _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        10, 100, _kp_seed(), _kp_pk(), 60)
    ce_eq("delta ok", delta_result_ok(dr), 1)
    ce_eq("1 atom added (deimos)", delta_result_atoms_added(dr), 1)
    let delta = delta_result_delta(dr)
    ce_check("delta lists deimos", _has(delta, " deimos\n"))
}

fn test_parent_fingerprint_matches_source_sha256() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 100)
    let expected = _dlt_hex_sha256(bundle_a)
    ce_str_eq("parent-fp = SHA256(bundle_a)",
              delta_result_parent_fp(dr), expected)
}

// ---- verify -------------------------------------------------------------

fn test_delta_verify_happy_path() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 100)
    let vr = delta_verify(delta_result_delta(dr),
                          delta_result_parent_fp(dr), _kp_pk())
    ce_eq("verify ok", vr[0], 1)
    ce_str_eq("no err", vr[1], "")
}

fn test_delta_verify_parent_mismatch_refused() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 100)
    let vr = delta_verify(delta_result_delta(dr),
        "deadbeef1234567890deadbeef1234567890deadbeef1234567890deadbeef00",
        _kp_pk())
    ce_eq("mismatch refused", vr[0], 0)
    ce_check("err says chain broken", find_bytes(vr[1], "chain broken") >= 0)
}

fn test_delta_verify_tampered_refused() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 100)
    let delta = delta_result_delta(dr)
    // Flip a byte after position 200 (deep in the body).
    let flipped = ""
    let i = 0
    while i < len(delta) {
        if i == 200 {
            let c = char_at(delta, i)
            let nc = c + 1
            if nc > 120 { nc = c - 1 }
            flipped = flipped + chr(nc)
        } else {
            flipped = flipped + substr(delta, i, 1)
        }
        i = i + 1
    }
    let vr = delta_verify(flipped, "", _kp_pk())
    ce_eq("tampered refused", vr[0], 0)
}

fn test_delta_verify_empty_refused() {
    let vr = delta_verify("", "", _kp_pk())
    ce_eq("empty refused", vr[0], 0)
}

fn test_delta_verify_bad_banner_refused() {
    let vr = delta_verify("#not-a-delta v1\n#foo bar\n", "", _kp_pk())
    ce_eq("bad banner refused", vr[0], 0)
    ce_check("err says banner", find_bytes(vr[1], "banner") >= 0)
}

// ---- apply --------------------------------------------------------------

fn test_delta_apply_adds_atom() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let kg2 = _mk_kg_v1()
    let solar = kg_find(kg2, "solar_system")
    let d = kg_add_atom(solar, ATOM_FACT, "deimos", 50)
    atom_set_license(d, LICENSE_OPEN)
    let dr = delta_compute(bundle_a, _mk_manifest(),
        kg2, _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        10, 100, _kp_seed(), _kp_pk(), 60)
    ce_eq("compute ok", delta_result_ok(dr), 1)

    // Apply to a fresh child KG that only has {mars, phobos}.
    let child_kg = _mk_kg_v1()
    let ar = delta_apply(delta_result_delta(dr),
        child_kg, _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        200)
    ce_eq("apply ok", delta_result_ok(ar), 1)
    ce_eq("1 atom added",           delta_result_atoms_added(ar), 1)
    let child_solar = kg_find(child_kg, "solar_system")
    let child_deimos = kg_find_atom(child_solar, "deimos")
    ce_check("deimos landed on child", child_deimos != 0)
}

fn test_delta_apply_retracts_atom() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    // Log a retraction of "mars" after moment 10.
    let mars_wm = kg_log_retraction("solar_system", "mars")
    ce_check("mars retraction wm > 0", mars_wm > 0)
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, mars_wm, _kp_seed(), _kp_pk(), 60)
    ce_eq("compute ok", delta_result_ok(dr), 1)
    ce_eq("1 atom retracted", delta_result_atoms_retracted(dr), 1)
    let delta = delta_result_delta(dr)
    ce_check("has -ATOM directive", _has(delta, "-ATOM solar_system mars"))

    // Apply on child: mars should be removed.
    let child_kg = _mk_kg_v1()
    let ar = delta_apply(delta, child_kg, _mk_capreg_v1(),
        _mk_skill_reg_v1(), _mk_pol_reg_v1(), 200)
    ce_eq("apply ok", delta_result_ok(ar), 1)
    ce_eq("1 retracted on child", delta_result_atoms_retracted(ar), 1)
    let cs = kg_find(child_kg, "solar_system")
    let cmars = kg_find_atom(cs, "mars")
    ce_eq("mars gone from child", cmars, 0)
}

fn test_delta_apply_idempotent_add() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let kg2 = _mk_kg_v1()
    let solar = kg_find(kg2, "solar_system")
    let d = kg_add_atom(solar, ATOM_FACT, "deimos", 50)
    atom_set_license(d, LICENSE_OPEN)
    let dr = delta_compute(bundle_a, _mk_manifest(),
        kg2, _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        10, 100, _kp_seed(), _kp_pk(), 60)
    let delta = delta_result_delta(dr)
    // Pre-load the child with deimos already present.
    let child_kg = _mk_kg_v1()
    let cs = kg_find(child_kg, "solar_system")
    kg_add_atom(cs, ATOM_FACT, "deimos", 40)
    let ar = delta_apply(delta, child_kg, _mk_capreg_v1(),
        _mk_skill_reg_v1(), _mk_pol_reg_v1(), 200)
    ce_eq("apply ok", delta_result_ok(ar), 1)
    // Duplicate add is a no-op; count is 0.
    ce_eq("no re-add",           delta_result_atoms_added(ar), 0)
}

fn test_delta_apply_retract_absent_is_noop() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    // Retract "phantom" that doesn't exist.
    kg_log_retraction("solar_system", "phantom")
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 60)
    let delta = delta_result_delta(dr)
    let child_kg = _mk_kg_v1()
    let ar = delta_apply(delta, child_kg, _mk_capreg_v1(),
        _mk_skill_reg_v1(), _mk_pol_reg_v1(), 200)
    ce_eq("apply ok on missing", delta_result_ok(ar), 1)
    // Retracted count is 0 since the atom wasn't there.
    ce_eq("no retract for absent", delta_result_atoms_retracted(ar), 0)
}

// ---- capsule diff -------------------------------------------------------

fn test_delta_capsule_added() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    // v2 mother has an extra capsule "physics".
    let cap2 = _mk_capreg_v1()
    capreg_register(cap2, capsule_new("physics", "0.1.0", "physics", "OPEN"))
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), cap2, _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 60)
    ce_eq("compute ok", delta_result_ok(dr), 1)
    let delta = delta_result_delta(dr)
    ce_check("physics in delta", _has(delta, "+CAPSULE physics"))
}

fn test_delta_capsule_removed() {
    kg_retraction_log_clear()
    // Bake source with both capsules.
    let cap_full = _mk_capreg_v1()
    capreg_register(cap_full, capsule_new("physics", "0.1.0", "physics", "OPEN"))
    let br = bake_child(_mk_manifest(),
        persona_registry_new(),
        _mk_kg_v1(), cap_full, _mk_skill_reg_v1(),
        _mk_pol_reg_v1(), ownership_registry_new(),
        _kp_seed(), _kp_pk(), 10)
    let bundle_full = bake_result_bundle(br)
    // v2 mother no longer has physics (only solar_system).
    let dr = delta_compute(bundle_full, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 60)
    ce_eq("compute ok", delta_result_ok(dr), 1)
    let delta = delta_result_delta(dr)
    ce_check("physics retracted", _has(delta, "-CAPSULE physics"))
}

// ---- chain --------------------------------------------------------------

fn test_delta_chain_two_hops() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    // Delta 1: adds deimos.
    let kg2 = _mk_kg_v1()
    let solar = kg_find(kg2, "solar_system")
    let d = kg_add_atom(solar, ATOM_FACT, "deimos", 20)
    atom_set_license(d, LICENSE_OPEN)
    let dr1 = delta_compute(bundle_a, _mk_manifest(),
        kg2, _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        10, 25, _kp_seed(), _kp_pk(), 30)
    ce_eq("delta1 ok", delta_result_ok(dr1), 1)
    let delta1 = delta_result_delta(dr1)
    let d1_fp = delta_result_delta_fp(dr1)
    // Delta 2 computed from delta1 (as its parent). Adds nothing new
    // but chains fingerprint-wise.
    let dr2 = delta_compute(delta1, _mk_manifest(),
        kg2, _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        25, 30, _kp_seed(), _kp_pk(), 40)
    ce_eq("delta2 ok", delta_result_ok(dr2), 1)
    // Delta 2's parent-fingerprint must equal delta1's delta-fingerprint.
    ce_str_eq("chain parent = delta1 fp",
              delta_result_parent_fp(dr2), d1_fp)
    // Verify delta2 chains from delta1.
    let vr = delta_verify(delta_result_delta(dr2), d1_fp, _kp_pk())
    ce_eq("delta2 verifies against delta1 fp", vr[0], 1)
    // Same delta2 verified against WRONG expected parent -> refuse.
    let bad = delta_verify(delta_result_delta(dr2), "deadbeef", _kp_pk())
    ce_eq("delta2 refused wrong parent", bad[0], 0)
}

fn test_delta_apply_updates_fingerprint() {
    kg_retraction_log_clear()
    let bundle_a = _bake_v1()
    let dr = delta_compute(bundle_a, _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        0, 100, _kp_seed(), _kp_pk(), 100)
    let ar = delta_apply(delta_result_delta(dr),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        200)
    ce_eq("apply ok", delta_result_ok(ar), 1)
    // The apply result exposes the delta-fingerprint for the caller
    // to persist as the new baseline.
    ce_str_eq("apply carries delta fp",
              delta_result_delta_fp(ar), delta_result_delta_fp(dr))
    ce_str_eq("apply carries parent fp",
              delta_result_parent_fp(ar), delta_result_parent_fp(dr))
    ce_eq("apply since",  delta_result_since(ar), 0)
    ce_eq("apply until",  delta_result_until(ar), 100)
}

// ---- watermark + retraction log helpers --------------------------------

fn test_watermark_monotonic() {
    kg_retraction_log_clear()
    let w1 = kg_mutation_watermark_tick()
    let w2 = kg_mutation_watermark_tick()
    let w3 = kg_mutation_watermark_current()
    ce_eq("w1=1", w1, 1)
    ce_eq("w2=2", w2, 2)
    ce_eq("w3=current=2", w3, 2)
}

fn test_retraction_log_since() {
    kg_retraction_log_clear()
    kg_log_retraction("kg1", "atom_a")
    kg_log_retraction("kg1", "atom_b")
    kg_log_retraction("kg2", "atom_c")
    let all = kg_retractions_since(0)
    ce_eq("3 retractions since 0", len(all), 3)
    let after1 = kg_retractions_since(1)
    ce_eq("2 retractions since 1", len(after1), 2)
    let empty_ret = kg_retractions_since(10)
    ce_eq("0 retractions since 10", len(empty_ret), 0)
}

// ---- refusal paths ------------------------------------------------------

fn test_compute_null_manifest_refused() {
    let dr = delta_compute("", 0, 0, 0, 0, 0, 0, 0, _kp_seed(), _kp_pk(), 0)
    ce_eq("null manifest refused", delta_result_ok(dr), 0)
}

fn test_compute_null_signer_refused() {
    let dr = delta_compute("", _mk_manifest(), 0, 0, 0, 0, 0, 0, 0, 0, 0)
    ce_eq("null seed refused", delta_result_ok(dr), 0)
}

fn test_compute_until_less_than_since_refused() {
    let dr = delta_compute("", _mk_manifest(),
        _mk_kg_v1(), _mk_capreg_v1(), _mk_skill_reg_v1(), _mk_pol_reg_v1(),
        100, 50, _kp_seed(), _kp_pk(), 0)
    ce_eq("bad window refused", delta_result_ok(dr), 0)
}

fn main() {
    test_delta_compute_empty_window()
    test_delta_compute_since_equals_until()
    test_delta_bundle_shape()
    test_delta_added_atoms_in_window()
    test_parent_fingerprint_matches_source_sha256()
    test_delta_verify_happy_path()
    test_delta_verify_parent_mismatch_refused()
    test_delta_verify_tampered_refused()
    test_delta_verify_empty_refused()
    test_delta_verify_bad_banner_refused()
    test_delta_apply_adds_atom()
    test_delta_apply_retracts_atom()
    test_delta_apply_idempotent_add()
    test_delta_apply_retract_absent_is_noop()
    test_delta_capsule_added()
    test_delta_capsule_removed()
    test_delta_chain_two_hops()
    test_delta_apply_updates_fingerprint()
    test_watermark_monotonic()
    test_retraction_log_since()
    test_compute_null_manifest_refused()
    test_compute_null_signer_refused()
    test_compute_until_less_than_since_refused()
    ce_summary("update_delta")
}

main()
