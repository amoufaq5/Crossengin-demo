// Unit tests for src/federation/turn.nova (R34B / R28E.2).
//
// Coverage (~80 assertions):
//   * BE byte helpers (u16/u32) round-trip + 4-byte attribute padding.
//   * Method/class pack-unpack round-trip for all six TURN methods +
//     all four classes (request/indication/success/error).
//   * 20-byte header byte layout on a hand-built Allocate Request.
//   * Allocate Request emit + parse round-trip via the success-response
//     test-emitter: LIFETIME + REQUESTED-TRANSPORT survive.
//   * Allocate Success Response round-trip: XOR-RELAYED-ADDRESS,
//     LIFETIME, XOR-MAPPED-ADDRESS all decode.
//   * Allocate Error Response round-trip: ERROR-CODE 401 Unauthorized
//     and 437 Allocation Mismatch.
//   * Refresh Request emit + Refresh Success Response parse round-trip
//     with lifetime values 0 (delete), 60 (one minute), 600 (default).
//   * CreatePermission Request round-trip (single peer + multi-peer).
//   * Send Indication round-trip via Data Indication parse path
//     (server bounces back the same XOR-PEER + DATA layout).
//   * Send Indication with a non-trivial 64-byte data payload.
//   * ChannelBind Request round-trip: CHANNEL-NUMBER + XOR-PEER-ADDRESS
//     decode.
//   * XOR-PEER-ADDRESS encode/decode round-trip via the helper.
//   * Multi-peer XOR-PEER-ADDRESS: all three peers decoded.
//   * Malformed header: short header (8 bytes) -> TURN_ERR_HEADER.
//   * Malformed magic cookie -> TURN_ERR_COOKIE.
//   * Truncated attribute TLV -> TURN_ERR_ATTR.
//   * First-2-bits-non-zero message type -> TURN_ERR_HEADER.
//   * Length not multiple of 4 -> TURN_ERR_LENGTH.
//   * Length exceeds buffer -> TURN_ERR_LENGTH.
//   * Wrong method for parser: Allocate parser on a Refresh response
//     -> TURN_ERR_METHOD.
//   * IPv6 XOR address (family=2) -> TURN_ERR_FAMILY.
//   * STUN-shared attributes (SOFTWARE, USERNAME, MESSAGE-INTEGRITY,
//     REALM, NONCE, FINGERPRINT) tolerated on parse -- presence does
//     NOT reject the message even though the codec does not interpret
//     them. The Allocate success response with all of these injected
//     still parses + extracts XOR-RELAYED-ADDRESS / LIFETIME.
//
// All tests run in the unit sandbox -- no sockets, no real TURN
// relay server. The byte-codec contract is verified directly.

import "../ce_test.nova"
import "../../src/federation/turn.nova"

// ============================================================================
//                         Small reusable helpers
// ============================================================================

fn _tt_zero_buf(n) {
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 0); i = i + 1 }
    store8(buf + n, 0)
    return buf
}

fn _tt_str_to_buf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, char_at(s, i)); i = i + 1 }
    store8(buf + n, 0)
    let out = list_new()
    push(out, buf)
    push(out, n)
    return out
}

fn _tt_fixed_txn() {
    let buf = alloc(13)
    let i = 0
    while i < 12 { store8(buf + i, i + 1); i = i + 1 }   // 0x01..0x0C
    store8(buf + 12, 0)
    return buf
}

fn _tt_alt_txn() {
    let buf = alloc(13)
    let i = 0
    while i < 12 { store8(buf + i, 0xA0 + i); i = i + 1 }
    store8(buf + 12, 0)
    return buf
}

fn _tt_ipv4(ip) { return turn_ipv4_str_to_buf(ip) }

// ============================================================================
//                         BE byte helpers + pad4
// ============================================================================

fn test_be_helpers_roundtrip() {
    let buf = _tt_zero_buf(16)
    _turn_test_put_u16(buf, 0, 0)
    ce_eq("u16 zero", _turn_test_get_u16(buf, 0), 0)
    _turn_test_put_u16(buf, 4, 65535)
    ce_eq("u16 max", _turn_test_get_u16(buf, 4), 65535)
    _turn_test_put_u16(buf, 8, 0xABCD)
    ce_eq("u16 byte 0 hi", load8(buf + 8), 0xAB)
    ce_eq("u16 byte 1 lo", load8(buf + 9), 0xCD)
    _turn_test_put_u32(buf, 0, 0x2112A442)
    ce_eq("u32 cookie byte 0", load8(buf + 0), 0x21)
    ce_eq("u32 cookie byte 3", load8(buf + 3), 0x42)
    ce_eq("u32 round-trip", _turn_test_get_u32(buf, 0), 0x2112A442)
}

fn test_pad4_alignment() {
    ce_eq("pad4(0)", _turn_test_pad4(0), 0)
    ce_eq("pad4(1)", _turn_test_pad4(1), 4)
    ce_eq("pad4(3)", _turn_test_pad4(3), 4)
    ce_eq("pad4(4)", _turn_test_pad4(4), 4)
    ce_eq("pad4(5)", _turn_test_pad4(5), 8)
    ce_eq("attr_size(8)", _turn_test_attr_size(8), 12)
    ce_eq("attr_size(4)", _turn_test_attr_size(4), 8)
    ce_eq("attr_size(0)", _turn_test_attr_size(0), 4)
}

// ============================================================================
//                         Method/class pack-unpack
// ============================================================================

fn test_method_class_pack() {
    // For methods 0x003..0x009 the high method bits are zero so the
    // packed value is exactly (class << 8) | method (since c1 lives at
    // bit 8 and c0 lives at bit 4 -- but bit 4 is INSIDE the method's
    // m0_3 only when m4_6 is non-zero). For method=3 (=0b0011) the
    // m4_6 + m7_11 fields are 0, so class bits assemble cleanly.
    let t_req = turn_msg_type_pack(TURN_METHOD_ALLOCATE, TURN_CLASS_REQUEST)
    ce_eq("Allocate Request type = 0x0003", t_req, 0x0003)
    let t_succ = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                    TURN_CLASS_SUCCESS_RESP)
    ce_eq("Allocate Success type = 0x0103", t_succ, 0x0103)
    let t_err = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                   TURN_CLASS_ERROR_RESP)
    ce_eq("Allocate Error type = 0x0113", t_err, 0x0113)
    let t_refresh_req = turn_msg_type_pack(TURN_METHOD_REFRESH,
                                           TURN_CLASS_REQUEST)
    ce_eq("Refresh Request = 0x0004", t_refresh_req, 0x0004)
    let t_refresh_succ = turn_msg_type_pack(TURN_METHOD_REFRESH,
                                            TURN_CLASS_SUCCESS_RESP)
    ce_eq("Refresh Success = 0x0104", t_refresh_succ, 0x0104)
    let t_send_ind = turn_msg_type_pack(TURN_METHOD_SEND,
                                        TURN_CLASS_INDICATION)
    ce_eq("Send Indication = 0x0016", t_send_ind, 0x0016)
    let t_data_ind = turn_msg_type_pack(TURN_METHOD_DATA,
                                        TURN_CLASS_INDICATION)
    ce_eq("Data Indication = 0x0017", t_data_ind, 0x0017)
    let t_cp_req = turn_msg_type_pack(TURN_METHOD_CREATE_PERMISSION,
                                      TURN_CLASS_REQUEST)
    ce_eq("CreatePermission Request = 0x0008", t_cp_req, 0x0008)
    let t_cb_req = turn_msg_type_pack(TURN_METHOD_CHANNEL_BIND,
                                      TURN_CLASS_REQUEST)
    ce_eq("ChannelBind Request = 0x0009", t_cb_req, 0x0009)
}

fn test_method_class_unpack_roundtrip() {
    let methods = list_new()
    push(methods, TURN_METHOD_ALLOCATE)
    push(methods, TURN_METHOD_REFRESH)
    push(methods, TURN_METHOD_SEND)
    push(methods, TURN_METHOD_DATA)
    push(methods, TURN_METHOD_CREATE_PERMISSION)
    push(methods, TURN_METHOD_CHANNEL_BIND)
    let classes = list_new()
    push(classes, TURN_CLASS_REQUEST)
    push(classes, TURN_CLASS_INDICATION)
    push(classes, TURN_CLASS_SUCCESS_RESP)
    push(classes, TURN_CLASS_ERROR_RESP)
    let i = 0
    while i < len(methods) {
        let j = 0
        while j < len(classes) {
            let m = methods[i]
            let c = classes[j]
            let t = turn_msg_type_pack(m, c)
            let mc = turn_msg_type_unpack(t)
            ce_eq("method round-trip", mc[0], m)
            ce_eq("class round-trip", mc[1], c)
            j = j + 1
        }
        i = i + 1
    }
}

// ============================================================================
//                         XOR address helper
// ============================================================================

fn test_xor_address_v4_helper() {
    let txn = _tt_fixed_txn()
    // 192.0.2.1 = 0xC0000201
    let addr = 0xC0000201
    let port = 32853
    let res = turn_xor_address_v4(addr, port, txn)
    let x_addr = res[0]
    let x_port = res[1]
    // XOR with magic 0x2112A442 -> 0xE112A643. XOR port with top16
    // 0x2112 = 8466 -> 32853 XOR 8466 = ?
    let expected_addr = int_xor(addr, 0x2112A442)
    ce_eq("xor addr matches manual", x_addr, expected_addr)
    let expected_port = int_xor(port, 0x2112)
    ce_eq("xor port matches manual", x_port, expected_port)
    // Round-trip
    let res2 = turn_xor_address_v4(x_addr, x_port, txn)
    ce_eq("xor round-trip addr", res2[0], addr)
    ce_eq("xor round-trip port", res2[1], port)
}

// ============================================================================
//                         classify_message
// ============================================================================

fn test_classify_message() {
    let txn = _tt_fixed_txn()
    let pkt = turn_emit_allocate_request(txn, 600, TURN_TRANSPORT_UDP)
    let cls = turn_classify_message(pkt[0], pkt[1])
    ce_eq("classify method = ALLOCATE", cls[0], TURN_METHOD_ALLOCATE)
    ce_eq("classify class = REQUEST", cls[1], TURN_CLASS_REQUEST)
    ce_eq("classify body length = 16", cls[2], 16)
    // txn pointer should be buf + 8; check byte 0 = 0x01
    ce_eq("classify txn[0]", load8(cls[3]), 1)
    ce_eq("classify txn[11]", load8(cls[3] + 11), 12)
}

fn test_classify_message_indication() {
    let peer = _tt_ipv4("192.0.2.5")
    let data = _tt_str_to_buf("hi")
    let pkt = turn_emit_send_indication(peer, 4242, data[0], data[1])
    let cls = turn_classify_message(pkt[0], pkt[1])
    ce_eq("classify Send method", cls[0], TURN_METHOD_SEND)
    ce_eq("classify Send class = INDICATION", cls[1], TURN_CLASS_INDICATION)
}

// ============================================================================
//                         Allocate Request header byte layout
// ============================================================================

fn test_allocate_request_byte_layout() {
    let txn = _tt_fixed_txn()
    let pkt = turn_emit_allocate_request(txn, 600, TURN_TRANSPORT_UDP)
    let buf = pkt[0]
    let n = pkt[1]
    ce_eq("size = 36", n, 36)
    ce_eq("type hi", load8(buf + 0), 0x00)
    ce_eq("type lo = 0x03", load8(buf + 1), 0x03)
    ce_eq("length hi", load8(buf + 2), 0)
    ce_eq("length lo = 16", load8(buf + 3), 16)
    ce_eq("cookie byte 0", load8(buf + 4), 0x21)
    ce_eq("cookie byte 3", load8(buf + 7), 0x42)
    ce_eq("txn byte 0", load8(buf + 8), 0x01)
    ce_eq("txn byte 11", load8(buf + 19), 0x0C)
    // LIFETIME attr: type 0x000D, len 0x0004, value = 600 (BE 0x00000258)
    ce_eq("LIFETIME type hi", load8(buf + 20), 0x00)
    ce_eq("LIFETIME type lo", load8(buf + 21), 0x0D)
    ce_eq("LIFETIME len lo", load8(buf + 23), 0x04)
    ce_eq("LIFETIME value byte 2", load8(buf + 26), 0x02)
    ce_eq("LIFETIME value byte 3", load8(buf + 27), 0x58)
    // REQUESTED-TRANSPORT attr: type 0x0019, len 0x0004, value = 17,0,0,0
    ce_eq("TRANSPORT type hi", load8(buf + 28), 0x00)
    ce_eq("TRANSPORT type lo", load8(buf + 29), 0x19)
    ce_eq("TRANSPORT protocol = 17", load8(buf + 32), 17)
}

// ============================================================================
//                         Allocate Request -> Allocate Success round-trip
// ============================================================================

fn test_allocate_roundtrip() {
    let txn = _tt_fixed_txn()
    let req = turn_emit_allocate_request(txn, 600, TURN_TRANSPORT_UDP)
    // Verify request parse classify
    let cls = turn_classify_message(req[0], req[1])
    ce_eq("rt allocate req method", cls[0], TURN_METHOD_ALLOCATE)
    ce_eq("rt allocate req class", cls[1], TURN_CLASS_REQUEST)
    // Walk attributes to confirm LIFETIME + REQUESTED-TRANSPORT present
    let walk = _turn_test_walk_attrs(req[0], req[1])
    ce_eq("rt walk ok flag = 0", walk[0], 0)
    let attrs = walk[1]
    ce_eq("rt attr count = 2", len(attrs), 2)
    ce_eq("rt attr[0] type LIFETIME", attrs[0][0], TURN_ATTR_LIFETIME)
    ce_eq("rt attr[0] value lifetime = 600",
          _turn_test_get_u32(attrs[0][1], 0), 600)
    ce_eq("rt attr[1] type REQUESTED-TRANSPORT",
          attrs[1][0], TURN_ATTR_REQUESTED_TRANSPORT)
    ce_eq("rt attr[1] protocol byte 0 = UDP",
          load8(attrs[1][1] + 0), TURN_TRANSPORT_UDP)
    // Build a success response and parse it back
    let relayed = _tt_ipv4("203.0.113.5")
    let mapped  = _tt_ipv4("198.51.100.7")
    let resp = turn_emit_allocate_success_response(txn, relayed, 51000, 600,
                                                   mapped, 41000)
    let dec = turn_parse_allocate_success_response(resp[0], resp[1])
    ce_check("alloc-success parse returns list", len(dec) == 5)
    ce_str_eq("alloc-success relayed ip", dec[0], "203.0.113.5")
    ce_eq("alloc-success relayed port", dec[1], 51000)
    ce_eq("alloc-success lifetime = 600", dec[2], 600)
    ce_str_eq("alloc-success mapped ip", dec[3], "198.51.100.7")
    ce_eq("alloc-success mapped port", dec[4], 41000)
}

// ============================================================================
//                         Allocate Error Response (401, 437)
// ============================================================================

fn test_allocate_error_401() {
    let txn = _tt_fixed_txn()
    let resp = turn_emit_allocate_error_response(txn, 4, 1, "Unauthorized")
    let dec = turn_parse_allocate_error_response(resp[0], resp[1])
    ce_eq("err 401 parse list size = 2", len(dec), 2)
    ce_eq("err 401 code = 401", dec[0], 401)
    ce_str_eq("err 401 reason", dec[1], "Unauthorized")
}

fn test_allocate_error_437() {
    let txn = _tt_fixed_txn()
    let resp = turn_emit_allocate_error_response(txn, 4, 37,
                                                 "Allocation Mismatch")
    let dec = turn_parse_allocate_error_response(resp[0], resp[1])
    ce_eq("err 437 code = 437", dec[0], 437)
    ce_str_eq("err 437 reason", dec[1], "Allocation Mismatch")
}

// ============================================================================
//                         Refresh Request + Response (lifetime 0/60/600)
// ============================================================================

fn test_refresh_roundtrip_lifetime_0() {
    let txn = _tt_alt_txn()
    let req = turn_emit_refresh_request(txn, 0)
    let cls = turn_classify_message(req[0], req[1])
    ce_eq("refresh req method", cls[0], TURN_METHOD_REFRESH)
    let walk = _turn_test_walk_attrs(req[0], req[1])
    ce_eq("refresh walk ok", walk[0], 0)
    let attrs = walk[1]
    ce_eq("refresh attr count = 1", len(attrs), 1)
    ce_eq("refresh lifetime = 0 (delete)",
          _turn_test_get_u32(attrs[0][1], 0), 0)
    let resp = turn_emit_refresh_success_response(txn, 0)
    let dec = turn_parse_refresh_success_response(resp[0], resp[1])
    ce_eq("refresh resp lifetime = 0", dec[0], 0)
}

fn test_refresh_roundtrip_lifetime_60() {
    let txn = _tt_alt_txn()
    let req = turn_emit_refresh_request(txn, 60)
    let walk = _turn_test_walk_attrs(req[0], req[1])
    let attrs = walk[1]
    ce_eq("refresh lifetime = 60",
          _turn_test_get_u32(attrs[0][1], 0), 60)
    let resp = turn_emit_refresh_success_response(txn, 60)
    let dec = turn_parse_refresh_success_response(resp[0], resp[1])
    ce_eq("refresh resp lifetime = 60", dec[0], 60)
}

fn test_refresh_roundtrip_lifetime_600() {
    let txn = _tt_alt_txn()
    let req = turn_emit_refresh_request(txn, TURN_LIFETIME_DEFAULT)
    let resp = turn_emit_refresh_success_response(txn,
                                                  TURN_LIFETIME_DEFAULT)
    let dec = turn_parse_refresh_success_response(resp[0], resp[1])
    ce_eq("refresh resp default lifetime = 600",
          dec[0], TURN_LIFETIME_DEFAULT)
}

// ============================================================================
//                         CreatePermission Request
// ============================================================================

fn test_create_permission_single() {
    let txn = _tt_fixed_txn()
    let peer = _tt_ipv4("192.0.2.50")
    let req = turn_emit_create_permission_request(txn, peer, 5678)
    let cls = turn_classify_message(req[0], req[1])
    ce_eq("cp method", cls[0], TURN_METHOD_CREATE_PERMISSION)
    ce_eq("cp class = REQUEST", cls[1], TURN_CLASS_REQUEST)
    let walk = _turn_test_walk_attrs(req[0], req[1])
    let attrs = walk[1]
    ce_eq("cp attr count = 1", len(attrs), 1)
    ce_eq("cp attr[0] is XOR-PEER",
          attrs[0][0], TURN_ATTR_XOR_PEER_ADDRESS)
    let dec = _turn_test_decode_xor_addr(attrs[0][1], attrs[0][2])
    ce_check("cp decode returned list", dec != 0)
    ce_eq("cp decoded family", dec[0], TURN_FAMILY_IPV4)
    ce_str_eq("cp decoded ip", dec[1], "192.0.2.50")
    ce_eq("cp decoded port", dec[2], 5678)
}

fn test_create_permission_multi() {
    let txn = _tt_fixed_txn()
    let peers = list_new()
    let p1 = list_new(); push(p1, _tt_ipv4("203.0.113.10")); push(p1, 1000)
    let p2 = list_new(); push(p2, _tt_ipv4("203.0.113.20")); push(p2, 2000)
    let p3 = list_new(); push(p3, _tt_ipv4("203.0.113.30")); push(p3, 3000)
    push(peers, p1); push(peers, p2); push(peers, p3)
    let req = turn_emit_create_permission_request_multi(txn, peers)
    let walk = _turn_test_walk_attrs(req[0], req[1])
    let attrs = walk[1]
    ce_eq("cp multi attr count = 3", len(attrs), 3)
    let dec1 = _turn_test_decode_xor_addr(attrs[0][1], attrs[0][2])
    let dec2 = _turn_test_decode_xor_addr(attrs[1][1], attrs[1][2])
    let dec3 = _turn_test_decode_xor_addr(attrs[2][1], attrs[2][2])
    ce_str_eq("cp multi peer 0 ip", dec1[1], "203.0.113.10")
    ce_eq("cp multi peer 0 port", dec1[2], 1000)
    ce_str_eq("cp multi peer 1 ip", dec2[1], "203.0.113.20")
    ce_eq("cp multi peer 1 port", dec2[2], 2000)
    ce_str_eq("cp multi peer 2 ip", dec3[1], "203.0.113.30")
    ce_eq("cp multi peer 2 port", dec3[2], 3000)
}

// ============================================================================
//                         Send Indication / Data Indication
// ============================================================================

fn test_send_indication_byte_layout() {
    let peer = _tt_ipv4("192.0.2.99")
    let data = _tt_str_to_buf("ABCD")
    let pkt = turn_emit_send_indication(peer, 5050, data[0], data[1])
    let buf = pkt[0]
    let n = pkt[1]
    ce_eq("send size = 20 + 12 + 8 = 40", n, 40)
    ce_eq("send type byte = 0x00", load8(buf + 0), 0x00)
    ce_eq("send type byte 1 = 0x16", load8(buf + 1), 0x16)
}

fn test_send_to_data_indication_via_parse() {
    // The Send and Data indications share the same XOR-PEER + DATA
    // layout. We emit a Send Indication and run it through the DATA
    // parser to confirm the layout matches -- but we EXPECT this to
    // fail with TURN_ERR_METHOD since the method tag differs. So we
    // build a synthetic Data Indication using the test-only helper
    // and run that through the parse path.
    let txn = _tt_fixed_txn()
    let peer = _tt_ipv4("203.0.113.99")
    let payload = _tt_str_to_buf("payload-bytes")
    let pkt = turn_emit_data_indication_with_txn(txn, peer, 6060,
                                                 payload[0], payload[1])
    let dec = turn_parse_data_indication(pkt[0], pkt[1])
    ce_check("data ind parse returns 4-elem list", len(dec) == 4)
    ce_str_eq("data ind peer ip", dec[0], "203.0.113.99")
    ce_eq("data ind peer port", dec[1], 6060)
    ce_eq("data ind data length", dec[3], 13)
    // First byte should be 'p'
    ce_eq("data ind data[0] = 'p'", load8(dec[2]), 112)
    ce_eq("data ind data[12] = 's'", load8(dec[2] + 12), 115)
}

fn test_send_parsed_via_data_parser_rejects_method() {
    // Direct sanity: Send Indication parsed via Data parser must yield
    // TURN_ERR_METHOD (the codec is strict).
    let peer = _tt_ipv4("192.0.2.55")
    let data = _tt_str_to_buf("hi")
    let pkt = turn_emit_send_indication(peer, 7070, data[0], data[1])
    let dec = turn_parse_data_indication(pkt[0], pkt[1])
    ce_eq("Send via Data parser = METHOD err",
          dec, TURN_ERR_METHOD)
}

fn test_send_with_large_payload() {
    let peer = _tt_ipv4("192.0.2.77")
    let data = _tt_zero_buf(64)
    let i = 0
    while i < 64 { store8(data + i, i + 1); i = i + 1 }
    let pkt = turn_emit_send_indication(peer, 8080, data, 64)
    // Hand-build the equivalent Data Indication so we can decode the
    // data attribute too.
    let txn = _tt_fixed_txn()
    let pkt2 = turn_emit_data_indication_with_txn(txn, peer, 8080, data, 64)
    let dec = turn_parse_data_indication(pkt2[0], pkt2[1])
    ce_eq("send large data length = 64", dec[3], 64)
    ce_eq("send large byte 0 = 1", load8(dec[2]), 1)
    ce_eq("send large byte 63 = 64", load8(dec[2] + 63), 64)
    ce_eq("send pkt size includes 64-byte data + 8-byte peer",
          pkt[1], TURN_HDR_LEN + 12 + 4 + 64)
}

// ============================================================================
//                         ChannelBind Request
// ============================================================================

fn test_channel_bind_roundtrip() {
    let txn = _tt_fixed_txn()
    let peer = _tt_ipv4("203.0.113.7")
    let req = turn_emit_channel_bind_request(txn, 0x4001, peer, 9000)
    let cls = turn_classify_message(req[0], req[1])
    ce_eq("cb method", cls[0], TURN_METHOD_CHANNEL_BIND)
    let walk = _turn_test_walk_attrs(req[0], req[1])
    let attrs = walk[1]
    ce_eq("cb attr count = 2", len(attrs), 2)
    ce_eq("cb attr[0] is CHANNEL-NUMBER",
          attrs[0][0], TURN_ATTR_CHANNEL_NUMBER)
    // CHANNEL-NUMBER value = 16-bit channel + 16-bit RFFU
    ce_eq("cb channel hi", load8(attrs[0][1] + 0), 0x40)
    ce_eq("cb channel lo", load8(attrs[0][1] + 1), 0x01)
    ce_eq("cb attr[1] is XOR-PEER",
          attrs[1][0], TURN_ATTR_XOR_PEER_ADDRESS)
    let dec = _turn_test_decode_xor_addr(attrs[1][1], attrs[1][2])
    ce_str_eq("cb peer ip", dec[1], "203.0.113.7")
    ce_eq("cb peer port", dec[2], 9000)
}

// ============================================================================
//                         Malformed message rejections
// ============================================================================

fn test_reject_short_header() {
    let buf = _tt_zero_buf(8)
    let r = turn_parse_allocate_success_response(buf, 8)
    ce_eq("short header -> ERR_HEADER", r, TURN_ERR_HEADER)
    let r2 = turn_classify_message(buf, 8)
    ce_eq("classify short header -> ERR_HEADER", r2, TURN_ERR_HEADER)
}

fn test_reject_bad_cookie() {
    // Build a valid-looking 20-byte header but corrupt the cookie.
    let buf = _tt_zero_buf(20)
    // type = 0x0103 (Allocate Success), length = 0
    store8(buf + 1, 0x03)
    store8(buf + 0, 0x01)
    // bad magic
    store8(buf + 4, 0xDE)
    store8(buf + 5, 0xAD)
    store8(buf + 6, 0xBE)
    store8(buf + 7, 0xEF)
    let r = turn_parse_allocate_success_response(buf, 20)
    ce_eq("bad cookie -> ERR_COOKIE", r, TURN_ERR_COOKIE)
}

fn test_reject_truncated_attribute() {
    // Header claims length=20 (one full TLV) but we put a 4-byte attr
    // header with claimed value length 16, then truncate the buf.
    let total = TURN_HDR_LEN + 24      // 4 header + 16 value = 20 -> +4 = 24
    let buf = _tt_zero_buf(total)
    store8(buf + 0, 0x01)
    store8(buf + 1, 0x03)
    _turn_test_put_u16(buf, 2, 20)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    // attr type LIFETIME, len 16 (lies -- we don't have 16 bytes)
    _turn_test_put_u16(buf, 20, TURN_ATTR_LIFETIME)
    _turn_test_put_u16(buf, 22, 16)
    // Tell parser n = TURN_HDR_LEN + 8 (4-byte TLV header + 4 bytes)
    // but with attr_len=16 the walker should see the TLV claims to
    // extend past the body end and reject.
    let r = turn_parse_allocate_success_response(buf, TURN_HDR_LEN + 8)
    ce_check("truncated attr -> negative error",
             r == TURN_ERR_LENGTH)
}

fn test_reject_truncated_attribute_inside_body() {
    // length=20 in the header, body 20 bytes but the TLV claims value
    // length larger than remaining body.
    let total = TURN_HDR_LEN + 20
    let buf = _tt_zero_buf(total)
    store8(buf + 0, 0x01)
    store8(buf + 1, 0x03)
    _turn_test_put_u16(buf, 2, 20)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    _turn_test_put_u16(buf, 20, TURN_ATTR_LIFETIME)
    _turn_test_put_u16(buf, 22, 100)        // claims 100-byte value
    let r = turn_parse_allocate_success_response(buf, total)
    ce_eq("attr-value-overflows-body -> ERR_ATTR", r, TURN_ERR_ATTR)
}

fn test_reject_non_zero_top_2_bits() {
    // type with top 2 bits = 0b11 -> rejected
    let buf = _tt_zero_buf(TURN_HDR_LEN)
    store8(buf + 0, 0xC0)         // top 2 bits = 11
    store8(buf + 1, 0x03)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let r = turn_classify_message(buf, TURN_HDR_LEN)
    ce_eq("top-2-bits-non-zero -> ERR_HEADER", r, TURN_ERR_HEADER)
    let r2 = turn_parse_allocate_success_response(buf, TURN_HDR_LEN)
    ce_eq("top-2-bits parse -> ERR_HEADER", r2, TURN_ERR_HEADER)
}

fn test_reject_unaligned_length() {
    let buf = _tt_zero_buf(24)
    store8(buf + 0, 0x01)
    store8(buf + 1, 0x03)
    _turn_test_put_u16(buf, 2, 3)        // not multiple of 4
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let r = turn_parse_allocate_success_response(buf, 24)
    ce_eq("unaligned length -> ERR_LENGTH", r, TURN_ERR_LENGTH)
}

fn test_reject_length_exceeds_buf() {
    let buf = _tt_zero_buf(24)
    store8(buf + 0, 0x01)
    store8(buf + 1, 0x03)
    _turn_test_put_u16(buf, 2, 1000)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let r = turn_parse_allocate_success_response(buf, 24)
    ce_eq("length exceeds buf -> ERR_LENGTH", r, TURN_ERR_LENGTH)
}

fn test_reject_wrong_method_for_parser() {
    // Build a Refresh Success Response and run it through the Allocate
    // Success parser -- should reject with ERR_METHOD.
    let txn = _tt_fixed_txn()
    let resp = turn_emit_refresh_success_response(txn, 300)
    let r = turn_parse_allocate_success_response(resp[0], resp[1])
    ce_eq("Refresh resp via Alloc parser -> ERR_METHOD",
          r, TURN_ERR_METHOD)
}

fn test_reject_ipv6_xor_address() {
    // Hand-build an Allocate Success with an IPv6 XOR-RELAYED-ADDRESS
    // (family = 2). Parser must reject with ERR_FAMILY.
    let txn = _tt_fixed_txn()
    let total = TURN_HDR_LEN + _turn_test_attr_size(20)   // ipv6 = 20 bytes
              + _turn_test_attr_size(4)                   // LIFETIME
    let buf = _tt_zero_buf(total)
    let mtype = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                   TURN_CLASS_SUCCESS_RESP)
    _turn_test_put_u16(buf, 0, mtype)
    _turn_test_put_u16(buf, 2, total - TURN_HDR_LEN)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let i = 0
    while i < 12 { store8(buf + 8 + i, load8(txn + i)); i = i + 1 }
    let off = TURN_HDR_LEN
    // XOR-RELAYED-ADDRESS, value length = 20, family = 2 (IPv6)
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_XOR_RELAYED_ADDRESS)
    _turn_test_put_u16(buf, off + 2, 20)
    store8(buf + off + 4, 0)
    store8(buf + off + 5, TURN_FAMILY_IPV6)
    // port + 16 address bytes can be zeros
    off = off + 24
    // LIFETIME
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_LIFETIME)
    _turn_test_put_u16(buf, off + 2, 4)
    _turn_test_put_u32(buf, off + 4, 600)
    let r = turn_parse_allocate_success_response(buf, total)
    ce_eq("IPv6 XOR-RELAYED -> ERR_FAMILY", r, TURN_ERR_FAMILY)
}

// ============================================================================
//                         STUN-shared attribute tolerance
// ============================================================================
//
//   The parser must skip-over USERNAME / REALM / NONCE / SOFTWARE /
//   MESSAGE-INTEGRITY / FINGERPRINT etc. without rejecting the
//   message. Build an Allocate Success Response with all six of those
//   STUN-shared attrs injected between LIFETIME and the required
//   XOR-RELAYED + XOR-MAPPED, and confirm the codec still extracts
//   the right values.

fn test_stun_shared_attrs_tolerated() {
    let txn = _tt_fixed_txn()
    let relayed = _tt_ipv4("203.0.113.5")
    let mapped  = _tt_ipv4("198.51.100.7")
    // Layout (manually built):
    //   SOFTWARE (8 byte value)            8 + 4 = 12
    //   XOR-RELAYED-ADDRESS (8)             8 + 4 = 12
    //   LIFETIME (4)                        4 + 4 = 8
    //   USERNAME (8)                        8 + 4 = 12
    //   REALM (8)                           8 + 4 = 12
    //   NONCE (8)                           8 + 4 = 12
    //   XOR-MAPPED-ADDRESS (8)              8 + 4 = 12
    //   MESSAGE-INTEGRITY (20)             20 + 4 = 24
    //   FINGERPRINT (4)                     4 + 4 = 8
    //   total body = 112
    let body = 112
    let total = TURN_HDR_LEN + body
    let buf = _tt_zero_buf(total)
    let mtype = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                   TURN_CLASS_SUCCESS_RESP)
    _turn_test_put_u16(buf, 0, mtype)
    _turn_test_put_u16(buf, 2, body)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let i = 0
    while i < 12 { store8(buf + 8 + i, load8(txn + i)); i = i + 1 }
    let off = TURN_HDR_LEN
    // SOFTWARE "test/01"
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_SOFTWARE)
    _turn_test_put_u16(buf, off + 2, 8)
    let sw = "test/01x"
    let k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(sw, k)); k = k + 1 }
    off = off + 12
    // XOR-RELAYED-ADDRESS
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_XOR_RELAYED_ADDRESS)
    _turn_test_put_u16(buf, off + 2, 8)
    store8(buf + off + 4, 0)
    store8(buf + off + 5, TURN_FAMILY_IPV4)
    let cookie_hi = int_and(int_shr(0x2112A442, 16), 65535)
    _turn_test_put_u16(buf, off + 6, int_xor(51000, cookie_hi))
    let m = 0
    while m < 4 {
        let cb = int_and(int_shr(0x2112A442, (3 - m) * 8), 255)
        store8(buf + off + 8 + m, int_xor(load8(relayed + m), cb))
        m = m + 1
    }
    off = off + 12
    // LIFETIME 600
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_LIFETIME)
    _turn_test_put_u16(buf, off + 2, 4)
    _turn_test_put_u32(buf, off + 4, 600)
    off = off + 8
    // USERNAME "userpswd"
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_USERNAME)
    _turn_test_put_u16(buf, off + 2, 8)
    let un = "userpswd"
    k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(un, k)); k = k + 1 }
    off = off + 12
    // REALM "realm-01"
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_REALM)
    _turn_test_put_u16(buf, off + 2, 8)
    let rl = "realm-01"
    k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(rl, k)); k = k + 1 }
    off = off + 12
    // NONCE "nonce-AB"
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_NONCE)
    _turn_test_put_u16(buf, off + 2, 8)
    let nc = "nonce-AB"
    k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(nc, k)); k = k + 1 }
    off = off + 12
    // XOR-MAPPED-ADDRESS
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_XOR_MAPPED_ADDRESS)
    _turn_test_put_u16(buf, off + 2, 8)
    store8(buf + off + 4, 0)
    store8(buf + off + 5, TURN_FAMILY_IPV4)
    _turn_test_put_u16(buf, off + 6, int_xor(41000, cookie_hi))
    m = 0
    while m < 4 {
        let cb = int_and(int_shr(0x2112A442, (3 - m) * 8), 255)
        store8(buf + off + 8 + m, int_xor(load8(mapped + m), cb))
        m = m + 1
    }
    off = off + 12
    // MESSAGE-INTEGRITY 20 bytes (all zeros -- we do not verify)
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_MESSAGE_INTEGRITY)
    _turn_test_put_u16(buf, off + 2, 20)
    off = off + 24
    // FINGERPRINT
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_FINGERPRINT)
    _turn_test_put_u16(buf, off + 2, 4)
    _turn_test_put_u32(buf, off + 4, 0x12345678)
    off = off + 8
    let dec = turn_parse_allocate_success_response(buf, total)
    ce_check("with-shared-attrs parse returns list",
             dec != TURN_ERR_HEADER)
    ce_str_eq("with-shared-attrs relayed ip", dec[0], "203.0.113.5")
    ce_eq("with-shared-attrs relayed port", dec[1], 51000)
    ce_eq("with-shared-attrs lifetime = 600", dec[2], 600)
    ce_str_eq("with-shared-attrs mapped ip", dec[3], "198.51.100.7")
    ce_eq("with-shared-attrs mapped port", dec[4], 41000)
}

// Auth-required server scenario: Allocate Error with 401 + REALM +
// NONCE attrs included alongside ERROR-CODE. Parser must extract the
// error code without choking on the credential attrs.
fn test_allocate_error_with_auth_attrs() {
    let txn = _tt_fixed_txn()
    let reason = "Unauthorized"
    let reason_n = len(reason)
    let err_val_n = 4 + reason_n
    // body = ERROR-CODE pad + REALM pad + NONCE pad
    let body = _turn_test_attr_size(err_val_n)
              + _turn_test_attr_size(8)        // REALM
              + _turn_test_attr_size(8)        // NONCE
    let total = TURN_HDR_LEN + body
    let buf = _tt_zero_buf(total)
    let mtype = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                   TURN_CLASS_ERROR_RESP)
    _turn_test_put_u16(buf, 0, mtype)
    _turn_test_put_u16(buf, 2, body)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let i = 0
    while i < 12 { store8(buf + 8 + i, load8(txn + i)); i = i + 1 }
    let off = TURN_HDR_LEN
    // ERROR-CODE 401
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_ERROR_CODE)
    _turn_test_put_u16(buf, off + 2, err_val_n)
    store8(buf + off + 4, 0)
    store8(buf + off + 5, 0)
    store8(buf + off + 6, 4)        // class = 4
    store8(buf + off + 7, 1)        // number = 1
    let k = 0
    while k < reason_n {
        store8(buf + off + 8 + k, char_at(reason, k))
        k = k + 1
    }
    off = off + _turn_test_attr_size(err_val_n)
    // REALM
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_REALM)
    _turn_test_put_u16(buf, off + 2, 8)
    let rl = "ce-realm"
    k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(rl, k)); k = k + 1 }
    off = off + 12
    // NONCE
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_NONCE)
    _turn_test_put_u16(buf, off + 2, 8)
    let nc = "abcd1234"
    k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(nc, k)); k = k + 1 }
    off = off + 12
    let dec = turn_parse_allocate_error_response(buf, total)
    ce_eq("auth-attr error code = 401", dec[0], 401)
    ce_str_eq("auth-attr error reason", dec[1], "Unauthorized")
}

// ============================================================================
//                         IPv4 parser smoke
// ============================================================================

fn test_ipv4_string_parser() {
    let buf = turn_ipv4_str_to_buf("192.0.2.1")
    ce_check("ipv4 parse ok", buf != 0)
    ce_eq("ipv4 byte 0 = 192", load8(buf + 0), 192)
    ce_eq("ipv4 byte 1 = 0",   load8(buf + 1), 0)
    ce_eq("ipv4 byte 2 = 2",   load8(buf + 2), 2)
    ce_eq("ipv4 byte 3 = 1",   load8(buf + 3), 1)
    let bad1 = turn_ipv4_str_to_buf("not.an.ip.address")
    ce_eq("ipv4 reject non-digit", bad1, 0)
    let bad2 = turn_ipv4_str_to_buf("256.0.0.0")
    ce_eq("ipv4 reject out-of-range", bad2, 0)
    let bad3 = turn_ipv4_str_to_buf("1.2.3")
    ce_eq("ipv4 reject 3-part", bad3, 0)
}

// ============================================================================
//                         Misc smoke
// ============================================================================

fn test_zero_lifetime_request_byte_layout() {
    let txn = _tt_alt_txn()
    let req = turn_emit_refresh_request(txn, 0)
    let buf = req[0]
    let n = req[1]
    ce_eq("refresh-0 size = 28", n, 28)
    ce_eq("refresh-0 type lo = 0x04", load8(buf + 1), 0x04)
    ce_eq("refresh-0 LIFETIME value = 0",
          _turn_test_get_u32(buf, 24), 0)
}

fn test_channel_bind_byte_layout() {
    let txn = _tt_fixed_txn()
    let peer = _tt_ipv4("198.51.100.20")
    let req = turn_emit_channel_bind_request(txn, 0x4002, peer, 12345)
    let buf = req[0]
    let n = req[1]
    // header 20 + CHANNEL-NUMBER attr (4 + 4 = 8) + XOR-PEER attr (4 + 8 = 12)
    ce_eq("cb size = 40", n, 40)
    ce_eq("cb type lo = 0x09", load8(buf + 1), 0x09)
    ce_eq("cb CHANNEL-NUMBER attr type lo", load8(buf + 21), 0x0C)
    ce_eq("cb channel hi = 0x40", load8(buf + 24), 0x40)
    ce_eq("cb channel lo = 0x02", load8(buf + 25), 0x02)
    ce_eq("cb XOR-PEER attr type lo", load8(buf + 29), 0x12)
}

// ============================================================================
// ============================================================================
//                Client-side allocation state machine (R34B.2)
// ============================================================================
// ============================================================================
//
// Coverage (~50 assertions) layered on top of the wire codec tests
// above. The state machine tests do NOT modify any of the prior 200
// assertions; they extend the suite via new test functions wired into
// main() below.

// Build a Refresh-success response with an injected txn so we can
// drive the state machine without a live server.
fn _tt_refresh_success(txn, lifetime) {
    return turn_emit_refresh_success_response(txn, lifetime)
}

fn _tt_allocate_success(txn, relayed_ip, relayed_port, lifetime,
                        mapped_ip, mapped_port) {
    return turn_emit_allocate_success_response(txn,
                                               _tt_ipv4(relayed_ip),
                                               relayed_port,
                                               lifetime,
                                               _tt_ipv4(mapped_ip),
                                               mapped_port)
}

fn _tt_allocate_error(txn, class_num, number, reason) {
    return turn_emit_allocate_error_response(txn, class_num, number, reason)
}

fn test_state_init_zero() {
    let st = turn_client_init()
    ce_eq("init state = IDLE", turn_client_state(st), TURN_STATE_IDLE)
    ce_eq("init txn = 0", turn_client_txn_id(st), 0)
    ce_str_eq("init relayed_ip empty", turn_client_relayed_ip(st), "")
    ce_eq("init relayed_port = 0", turn_client_relayed_port(st), 0)
    ce_eq("init lifetime = 0", turn_client_lifetime(st), 0)
    ce_eq("init expiry = 0", turn_client_expiry(st), 0)
    ce_eq("init last_err = 0", turn_client_last_err(st), 0)
    ce_eq("init perms empty", len(turn_client_perms(st)), 0)
    ce_eq("init channels empty", len(turn_client_channels(st)), 0)
    ce_eq("init stats alloc_sent = 0", turn_client_stats_alloc_sent(st), 0)
    ce_eq("init stats alloc_recv = 0", turn_client_stats_alloc_recv(st), 0)
    ce_eq("init stats alloc_fail = 0", turn_client_stats_alloc_fail(st), 0)
    ce_eq("init stats refr_sent = 0", turn_client_stats_refr_sent(st), 0)
    ce_eq("init stats refr_recv = 0", turn_client_stats_refr_recv(st), 0)
    ce_eq("init stats perm_sent = 0", turn_client_stats_perm_sent(st), 0)
    ce_eq("init stats perm_recv = 0", turn_client_stats_perm_recv(st), 0)
    ce_eq("init stats chan_sent = 0", turn_client_stats_chan_sent(st), 0)
    ce_eq("init stats chan_recv = 0", turn_client_stats_chan_recv(st), 0)
    ce_eq("init inflight_method = 0", turn_client_inflight_method(st), 0)
}

fn test_send_allocate_transitions_pending() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    let pkt = turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    ce_check("send_allocate returned [buf, n] tuple", len(pkt) == 2)
    ce_eq("send_allocate size = 36", pkt[1], 36)
    ce_eq("state -> PENDING", turn_client_state(st), TURN_STATE_PENDING)
    ce_eq("inflight_method = ALLOCATE",
          turn_client_inflight_method(st), TURN_METHOD_ALLOCATE)
    ce_eq("alloc_sent counter = 1", turn_client_stats_alloc_sent(st), 1)
    // Verify the txn_id pointer stored in state matches the input buf.
    ce_eq("stored txn[0] = 0x01", load8(turn_client_txn_id(st) + 0), 0x01)
    ce_eq("stored txn[11] = 0x0C", load8(turn_client_txn_id(st) + 11), 0x0C)
}

fn test_send_allocate_rejected_when_pending() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    // Second send_allocate while PENDING must be rejected.
    let alt = _tt_alt_txn()
    let r = turn_client_send_allocate(st, alt, 600, TURN_TRANSPORT_UDP)
    ce_eq("send_allocate from PENDING -> rejected (0)", r, 0)
    ce_eq("alloc_sent still 1", turn_client_stats_alloc_sent(st), 1)
}

fn test_recv_allocate_success_to_active() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    let tag = turn_client_recv(st, resp[0], resp[1], now)
    ce_eq("recv alloc-success tag = ALLOCATED", tag, TURN_RECV_ALLOCATED)
    ce_eq("state -> ACTIVE", turn_client_state(st), TURN_STATE_ACTIVE)
    ce_str_eq("relayed_ip", turn_client_relayed_ip(st), "203.0.113.5")
    ce_eq("relayed_port", turn_client_relayed_port(st), 51000)
    ce_str_eq("mapped_ip", turn_client_mapped_ip(st), "198.51.100.7")
    ce_eq("mapped_port", turn_client_mapped_port(st), 41000)
    ce_eq("lifetime = 600", turn_client_lifetime(st), 600)
    ce_eq("expiry = now + 600", turn_client_expiry(st), now + 600)
    ce_eq("alloc_recv counter = 1", turn_client_stats_alloc_recv(st), 1)
    ce_eq("inflight cleared", turn_client_inflight_method(st), 0)
}

fn test_recv_allocate_error_to_failed() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_error(txn, 4, 1, "Unauthorized")
    let tag = turn_client_recv(st, resp[0], resp[1], now)
    ce_eq("recv alloc-error tag = ALLOC_FAIL",
          tag, TURN_RECV_ALLOCATE_FAILED)
    ce_eq("state -> FAILED", turn_client_state(st), TURN_STATE_FAILED)
    ce_eq("last_err = 401", turn_client_last_err(st), 401)
    ce_eq("alloc_fail counter = 1", turn_client_stats_alloc_fail(st), 1)
    ce_eq("inflight cleared on failure",
          turn_client_inflight_method(st), 0)
}

fn test_recv_mismatched_txn_ignored() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    // Build a response with the WRONG txn -- state must NOT transition.
    let bad_txn = _tt_alt_txn()
    let resp = _tt_allocate_success(bad_txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    let tag = turn_client_recv(st, resp[0], resp[1], now)
    ce_eq("mismatched txn -> IGNORED", tag, TURN_RECV_IGNORED)
    ce_eq("state still PENDING", turn_client_state(st),
          TURN_STATE_PENDING)
    ce_eq("alloc_recv counter still 0", turn_client_stats_alloc_recv(st), 0)
}

fn test_recv_when_idle_ignored() {
    let st = turn_client_init()
    let now = 1700000000
    // No in-flight allocate; an arbitrary response must IGNORE.
    let txn = _tt_fixed_txn()
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    let tag = turn_client_recv(st, resp[0], resp[1], now)
    ce_eq("recv from IDLE -> IGNORED", tag, TURN_RECV_IGNORED)
    ce_eq("state stays IDLE", turn_client_state(st), TURN_STATE_IDLE)
}

fn test_send_refresh_from_active() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Now ACTIVE; issue a refresh.
    let txn2 = _tt_alt_txn()
    let r = turn_client_send_refresh(st, txn2, 600)
    ce_check("send_refresh returned tuple", len(r) == 2)
    ce_eq("state -> REFRESHING", turn_client_state(st),
          TURN_STATE_REFRESHING)
    ce_eq("inflight = REFRESH", turn_client_inflight_method(st),
          TURN_METHOD_REFRESH)
    ce_eq("refr_sent counter = 1", turn_client_stats_refr_sent(st), 1)
}

fn test_send_refresh_rejected_when_idle() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    let r = turn_client_send_refresh(st, txn, 600)
    ce_eq("send_refresh from IDLE -> 0", r, 0)
}

fn test_recv_refresh_success_extends_expiry() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now1 = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now1)
    let txn2 = _tt_alt_txn()
    turn_client_send_refresh(st, txn2, 600)
    let now2 = 1700000500       // 500 sec later
    let rresp = _tt_refresh_success(txn2, 600)
    let tag = turn_client_recv(st, rresp[0], rresp[1], now2)
    ce_eq("refresh success tag", tag, TURN_RECV_REFRESHED)
    ce_eq("state back to ACTIVE", turn_client_state(st), TURN_STATE_ACTIVE)
    ce_eq("expiry extended to now2 + 600",
          turn_client_expiry(st), now2 + 600)
    ce_eq("refr_recv counter = 1", turn_client_stats_refr_recv(st), 1)
    ce_eq("inflight cleared after refresh",
          turn_client_inflight_method(st), 0)
}

fn test_recv_refresh_lifetime_0_to_expired() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now1 = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now1)
    let txn2 = _tt_alt_txn()
    turn_client_send_refresh(st, txn2, 0)
    let now2 = 1700000100
    let rresp = _tt_refresh_success(txn2, 0)   // lifetime=0 -> delete
    let tag = turn_client_recv(st, rresp[0], rresp[1], now2)
    ce_eq("refresh lifetime=0 -> REFRESH_DELETED",
          tag, TURN_RECV_REFRESH_DELETED)
    ce_eq("state -> EXPIRED", turn_client_state(st), TURN_STATE_EXPIRED)
    ce_eq("lifetime = 0", turn_client_lifetime(st), 0)
}

fn test_recv_refresh_error_to_failed() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now1 = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now1)
    let txn2 = _tt_alt_txn()
    turn_client_send_refresh(st, txn2, 600)
    let rerr = turn_emit_refresh_error_response(txn2, 4, 37,
                                                "Allocation Mismatch")
    let tag = turn_client_recv(st, rerr[0], rerr[1], now1 + 100)
    ce_eq("refresh error tag", tag, TURN_RECV_REFRESH_FAILED)
    ce_eq("state -> FAILED after refresh error",
          turn_client_state(st), TURN_STATE_FAILED)
    ce_eq("last_err = 437", turn_client_last_err(st), 437)
}

fn test_tick_active_not_expired() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now1 = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now1)
    // expiry is now1 + 600. Tick at now1 + 300 -> still ACTIVE.
    let tag = turn_client_tick(st, now1 + 300)
    ce_eq("tick before expiry = OK", tag, TURN_TICK_OK)
    ce_eq("state still ACTIVE", turn_client_state(st), TURN_STATE_ACTIVE)
}

fn test_tick_expiry_elapsed_to_expired() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now1 = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now1)
    // Tick at now1 + 700 -> past expiry (now1 + 600).
    let tag = turn_client_tick(st, now1 + 700)
    ce_eq("tick past expiry = EXPIRED", tag, TURN_TICK_EXPIRED)
    ce_eq("state -> EXPIRED", turn_client_state(st), TURN_STATE_EXPIRED)
}

fn test_tick_when_idle_noop() {
    let st = turn_client_init()
    let tag = turn_client_tick(st, 1700000000)
    ce_eq("tick when IDLE = OK", tag, TURN_TICK_OK)
    ce_eq("state still IDLE", turn_client_state(st), TURN_STATE_IDLE)
}

fn test_send_permission_appends_on_success() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Issue a CreatePermission for 192.0.2.50:5678.
    let txn2 = _tt_alt_txn()
    let pkt = turn_client_send_permission(st, txn2, "192.0.2.50", 5678)
    ce_check("send_permission returned tuple", len(pkt) == 2)
    ce_eq("perm_sent counter = 1", turn_client_stats_perm_sent(st), 1)
    // State stays ACTIVE while permission is in flight (lifecycle unchanged).
    ce_eq("state still ACTIVE during perm", turn_client_state(st),
          TURN_STATE_ACTIVE)
    // Server sends back a CreatePermission-success.
    let sresp = turn_emit_create_permission_success_response(txn2)
    let tag = turn_client_recv(st, sresp[0], sresp[1], now)
    ce_eq("recv perm-success tag = PERMITTED", tag, TURN_RECV_PERMITTED)
    let perms = turn_client_perms(st)
    ce_eq("perms_list length = 1", len(perms), 1)
    ce_str_eq("perm[0] ip", perms[0][0], "192.0.2.50")
    ce_eq("perm[0] port", perms[0][1], 5678)
    ce_eq("perm[0] expiry = now + 300 (RFC 5766 §8 default)",
          perms[0][2], now + TURN_PERM_LIFETIME_DEFAULT)
    ce_eq("perm_recv counter = 1", turn_client_stats_perm_recv(st), 1)
}

fn test_send_channel_bind_appends_on_success() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    let txn2 = _tt_alt_txn()
    let pkt = turn_client_send_channel_bind(st, txn2, 0x4001,
                                            "203.0.113.7", 9000)
    ce_check("send_channel_bind returned tuple", len(pkt) == 2)
    ce_eq("chan_sent counter = 1", turn_client_stats_chan_sent(st), 1)
    let sresp = turn_emit_channel_bind_success_response(txn2)
    let tag = turn_client_recv(st, sresp[0], sresp[1], now)
    ce_eq("recv chanbind-success tag", tag, TURN_RECV_CHANNEL_BOUND)
    let chans = turn_client_channels(st)
    ce_eq("channels_list length = 1", len(chans), 1)
    ce_eq("chan[0] num = 0x4001", chans[0][0], 0x4001)
    ce_str_eq("chan[0] peer ip", chans[0][1], "203.0.113.7")
    ce_eq("chan[0] peer port", chans[0][2], 9000)
    ce_eq("chan_recv counter = 1", turn_client_stats_chan_recv(st), 1)
}

fn test_send_channel_bind_rejects_out_of_range() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Below band: 0x3FFF.
    let txn2 = _tt_alt_txn()
    let r1 = turn_client_send_channel_bind(st, txn2, 0x3FFF,
                                           "203.0.113.7", 9000)
    ce_eq("channel < 0x4000 rejected (0)", r1, 0)
    ce_eq("counter not bumped on reject",
          turn_client_stats_chan_sent(st), 0)
    // Above band: 0x7FFF (per RFC 5766 §11 the max usable is 0x7FFE).
    let r2 = turn_client_send_channel_bind(st, txn2, 0x7FFF,
                                           "203.0.113.7", 9000)
    ce_eq("channel > 0x7FFE rejected (0)", r2, 0)
    let r3 = turn_client_send_channel_bind(st, txn2, 0x8000,
                                           "203.0.113.7", 9000)
    ce_eq("channel 0x8000 (out-of-band) rejected", r3, 0)
    // Boundary OK: 0x4000 and 0x7FFE both accepted.
    let r4 = turn_client_send_channel_bind(st, txn2, 0x4000,
                                           "203.0.113.7", 9000)
    ce_check("channel = 0x4000 accepted", len(r4) == 2)
    // Reset inflight to avoid carrying chanbind in-flight into next.
}

fn test_send_channel_bind_rejected_when_not_active() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    let r = turn_client_send_channel_bind(st, txn, 0x4001,
                                          "203.0.113.7", 9000)
    ce_eq("chanbind from IDLE rejected", r, 0)
}

fn test_multi_peer_permissions() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Build 3 distinct txn ids and send 3 permissions.
    let txn1 = alloc(13)
    let txn2 = alloc(13)
    let txn3 = alloc(13)
    let i = 0
    while i < 12 {
        store8(txn1 + i, 0xB0 + i)
        store8(txn2 + i, 0xC0 + i)
        store8(txn3 + i, 0xD0 + i)
        i = i + 1
    }
    store8(txn1 + 12, 0); store8(txn2 + 12, 0); store8(txn3 + 12, 0)
    turn_client_send_permission(st, txn1, "203.0.113.10", 1000)
    let r1 = turn_emit_create_permission_success_response(txn1)
    turn_client_recv(st, r1[0], r1[1], now)
    turn_client_send_permission(st, txn2, "203.0.113.20", 2000)
    let r2 = turn_emit_create_permission_success_response(txn2)
    turn_client_recv(st, r2[0], r2[1], now)
    turn_client_send_permission(st, txn3, "203.0.113.30", 3000)
    let r3 = turn_emit_create_permission_success_response(txn3)
    turn_client_recv(st, r3[0], r3[1], now)
    let perms = turn_client_perms(st)
    ce_eq("multi-peer perms count = 3", len(perms), 3)
    ce_str_eq("perm[0] ip", perms[0][0], "203.0.113.10")
    ce_str_eq("perm[1] ip", perms[1][0], "203.0.113.20")
    ce_str_eq("perm[2] ip", perms[2][0], "203.0.113.30")
    ce_eq("perm[2] port", perms[2][1], 3000)
    ce_eq("perm_sent total = 3", turn_client_stats_perm_sent(st), 3)
    ce_eq("perm_recv total = 3", turn_client_stats_perm_recv(st), 3)
}

fn test_recv_data_indication_tag() {
    let st = turn_client_init()
    // Data indications have no txn correlation, but the state machine
    // still needs to return the DATA tag for the caller to read the
    // payload via turn_parse_data_indication.
    let txn = _tt_fixed_txn()
    let peer = _tt_ipv4("203.0.113.99")
    let payload = _tt_str_to_buf("hi")
    let pkt = turn_emit_data_indication_with_txn(txn, peer, 6060,
                                                 payload[0], payload[1])
    let tag = turn_client_recv(st, pkt[0], pkt[1], 1700000000)
    ce_eq("data indication -> TURN_RECV_DATA", tag, TURN_RECV_DATA)
    // State unchanged (data indications don't transition lifecycle).
    ce_eq("state unchanged on data", turn_client_state(st),
          TURN_STATE_IDLE)
}

fn test_full_lifecycle_idle_pending_active_refreshing_expired() {
    // Walk the full transition table once in a single test.
    let st = turn_client_init()
    ce_eq("step 0: IDLE", turn_client_state(st), TURN_STATE_IDLE)
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    ce_eq("step 1: PENDING", turn_client_state(st), TURN_STATE_PENDING)
    let now1 = 1700000000
    let aresp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                     "198.51.100.7", 41000)
    turn_client_recv(st, aresp[0], aresp[1], now1)
    ce_eq("step 2: ACTIVE", turn_client_state(st), TURN_STATE_ACTIVE)
    let txn2 = _tt_alt_txn()
    turn_client_send_refresh(st, txn2, 600)
    ce_eq("step 3: REFRESHING", turn_client_state(st), TURN_STATE_REFRESHING)
    let rresp = _tt_refresh_success(txn2, 0)        // server delete
    turn_client_recv(st, rresp[0], rresp[1], now1 + 100)
    ce_eq("step 4: EXPIRED (via lifetime=0 refresh)",
          turn_client_state(st), TURN_STATE_EXPIRED)
    // Caller can issue a fresh allocate after EXPIRED.
    let txn3 = _tt_fixed_txn()
    let pkt = turn_client_send_allocate(st, txn3, 600, TURN_TRANSPORT_UDP)
    ce_check("fresh allocate after EXPIRED returns tuple", len(pkt) == 2)
    ce_eq("step 5: PENDING again", turn_client_state(st), TURN_STATE_PENDING)
}

fn test_active_to_expired_via_tick_no_refresh() {
    // The other path to EXPIRED: ACTIVE allocation whose lifetime
    // elapses without a successful Refresh ever arriving.
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 60, TURN_TRANSPORT_UDP)
    let now1 = 1700000000
    let aresp = _tt_allocate_success(txn, "203.0.113.5", 51000, 60,
                                     "198.51.100.7", 41000)
    turn_client_recv(st, aresp[0], aresp[1], now1)
    ce_eq("expiry = now1 + 60", turn_client_expiry(st), now1 + 60)
    // Tick at now1 + 30 -> still ACTIVE.
    ce_eq("mid-lifetime tick OK",
          turn_client_tick(st, now1 + 30), TURN_TICK_OK)
    // Tick at now1 + 120 -> EXPIRED.
    ce_eq("post-lifetime tick EXPIRED",
          turn_client_tick(st, now1 + 120), TURN_TICK_EXPIRED)
    ce_eq("state -> EXPIRED via tick", turn_client_state(st),
          TURN_STATE_EXPIRED)
}

fn test_perm_error_failure_keeps_active() {
    // Permission error -> last_err set, but the allocation stays
    // ACTIVE (the per-peer permission failed, not the whole alloc).
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    let txn2 = _tt_alt_txn()
    turn_client_send_permission(st, txn2, "192.0.2.50", 5678)
    let perr = turn_emit_create_permission_error_response(txn2, 4, 3,
                                                          "Forbidden")
    let tag = turn_client_recv(st, perr[0], perr[1], now)
    ce_eq("perm error tag = PERM_FAILED", tag, TURN_RECV_PERM_FAILED)
    ce_eq("state still ACTIVE after perm error",
          turn_client_state(st), TURN_STATE_ACTIVE)
    ce_eq("last_err = 403", turn_client_last_err(st), 403)
    ce_eq("perms_list still empty after error",
          len(turn_client_perms(st)), 0)
}

fn test_chanbind_error_no_append() {
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    let txn2 = _tt_alt_txn()
    turn_client_send_channel_bind(st, txn2, 0x4002, "203.0.113.7", 9000)
    let cberr = turn_emit_channel_bind_error_response(txn2, 4, 41,
                                                      "Wrong Credentials")
    let tag = turn_client_recv(st, cberr[0], cberr[1], now)
    ce_eq("chanbind error tag = CHANNEL_FAILED",
          tag, TURN_RECV_CHANNEL_FAILED)
    ce_eq("state still ACTIVE after chanbind error",
          turn_client_state(st), TURN_STATE_ACTIVE)
    ce_eq("last_err = 441", turn_client_last_err(st), 441)
    ce_eq("channels_list empty after error",
          len(turn_client_channels(st)), 0)
}

fn test_recv_short_buf_ignored() {
    // Truncated message must not crash the state machine.
    let st = turn_client_init()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let buf = _tt_zero_buf(8)        // shorter than header
    let tag = turn_client_recv(st, buf, 8, 1700000000)
    ce_eq("truncated buf -> IGNORED", tag, TURN_RECV_IGNORED)
    ce_eq("state still PENDING", turn_client_state(st),
          TURN_STATE_PENDING)
}

// ============================================================================
// ============================================================================
//        R36A -- long-term-credential auth + per-permission tick
// ============================================================================
// ============================================================================

// MD5 RFC 1321 §A.5 test vector: MD5("") -> d41d8cd98f00b204e9800998ecf8427e
// and MD5("abc") -> 900150983cd24fb0d6963f7d28e17f72. Spot-check both.
fn test_md5_empty_vector() {
    let buf = _tt_zero_buf(1)
    let d = _turn_test_md5(buf, 0)
    ce_eq("MD5('') byte 0 = 0xd4", load8(d + 0), 0xd4)
    ce_eq("MD5('') byte 1 = 0x1d", load8(d + 1), 0x1d)
    ce_eq("MD5('') byte 2 = 0x8c", load8(d + 2), 0x8c)
    ce_eq("MD5('') byte 14 = 0x42", load8(d + 14), 0x42)
    ce_eq("MD5('') byte 15 = 0x7e", load8(d + 15), 0x7e)
}

fn test_md5_abc_vector() {
    let msg = _tt_str_to_buf("abc")
    let d = _turn_test_md5(msg[0], msg[1])
    // MD5("abc") = 900150983cd24fb0d6963f7d28e17f72
    ce_eq("MD5('abc') byte 0 = 0x90", load8(d + 0), 0x90)
    ce_eq("MD5('abc') byte 1 = 0x01", load8(d + 1), 0x01)
    ce_eq("MD5('abc') byte 2 = 0x50", load8(d + 2), 0x50)
    ce_eq("MD5('abc') byte 15 = 0x72", load8(d + 15), 0x72)
}

// MD5("message digest") -> f96b697d7cb7938d525a2f31aaf161d0
fn test_md5_message_digest_vector() {
    let msg = _tt_str_to_buf("message digest")
    let d = _turn_test_md5(msg[0], msg[1])
    ce_eq("MD5('message digest') byte 0 = 0xf9", load8(d + 0), 0xf9)
    ce_eq("MD5('message digest') byte 1 = 0x6b", load8(d + 1), 0x6b)
    ce_eq("MD5('message digest') byte 15 = 0xd0", load8(d + 15), 0xd0)
}

// HMAC-SHA1 RFC 2202 TC1:
//   key = 0x0b * 20 bytes, msg = "Hi There"
//   -> b617318655057264e28bc0b6fb378c8ef146be00
fn test_hmac_sha1_rfc2202_tc1() {
    let key = _tt_zero_buf(20)
    let i = 0
    while i < 20 { store8(key + i, 0x0b); i = i + 1 }
    let msg = _tt_str_to_buf("Hi There")
    let mac = _turn_test_hmac_sha1(key, 20, msg[0], msg[1])
    ce_eq("HMAC-SHA1 TC1 byte 0 = 0xb6", load8(mac + 0), 0xb6)
    ce_eq("HMAC-SHA1 TC1 byte 1 = 0x17", load8(mac + 1), 0x17)
    ce_eq("HMAC-SHA1 TC1 byte 2 = 0x31", load8(mac + 2), 0x31)
    ce_eq("HMAC-SHA1 TC1 byte 19 = 0x00", load8(mac + 19), 0x00)
}

// HMAC-SHA1 RFC 2202 TC2:
//   key = "Jefe", msg = "what do ya want for nothing?"
//   -> effcdf6ae5eb2fa2d27416d5f184df9c259a7c79
fn test_hmac_sha1_rfc2202_tc2() {
    let key = _tt_str_to_buf("Jefe")
    let msg = _tt_str_to_buf("what do ya want for nothing?")
    let mac = _turn_test_hmac_sha1(key[0], key[1], msg[0], msg[1])
    ce_eq("HMAC-SHA1 TC2 byte 0 = 0xef", load8(mac + 0), 0xef)
    ce_eq("HMAC-SHA1 TC2 byte 1 = 0xfc", load8(mac + 1), 0xfc)
    ce_eq("HMAC-SHA1 TC2 byte 2 = 0xdf", load8(mac + 2), 0xdf)
    ce_eq("HMAC-SHA1 TC2 byte 19 = 0x79", load8(mac + 19), 0x79)
}

// turn_hmac_sha1_key(username, realm, password) = MD5("u:r:p")
// Pre-computed: MD5("alice:ce-realm:secret") -> first 4 bytes are
// the same MD5 path; we recompute via _turn_test_md5 directly and
// confirm the two methods agree.
fn test_hmac_sha1_key_md5_roundtrip() {
    let key = turn_hmac_sha1_key("alice", "ce-realm", "secret")
    let buf = _tt_str_to_buf("alice:ce-realm:secret")
    let direct = _turn_test_md5(buf[0], buf[1])
    let i = 0
    let same = 1
    while i < 16 {
        if load8(key + i) != load8(direct + i) { same = 0 }
        i = i + 1
    }
    ce_eq("HMAC-SHA1 key derivation matches direct MD5", same, 1)
}

// Authed Allocate: classify the emitted bytes and confirm the four
// expected auth attributes are present in order, plus MI at the tail.
fn test_emit_allocate_authed_attr_order() {
    let txn = _tt_fixed_txn()
    let pkt = turn_emit_allocate_request_authed(txn, 600, TURN_TRANSPORT_UDP,
                                                "alice", "secret",
                                                "ce-realm", "n01ce")
    let buf = pkt[0]
    let n = pkt[1]
    ce_check("authed allocate emitted (n > 36)", n > 36)
    let cls = turn_classify_message(buf, n)
    ce_eq("authed allocate method = ALLOCATE",
          cls[0], TURN_METHOD_ALLOCATE)
    ce_eq("authed allocate class = REQUEST",
          cls[1], TURN_CLASS_REQUEST)
    let walk = _turn_test_walk_attrs(buf, n)
    ce_eq("authed walk ok flag = 0", walk[0], 0)
    let attrs = walk[1]
    ce_eq("authed attr count = 6 (LT + RT + UN + RL + NO + MI)",
          len(attrs), 6)
    ce_eq("authed attr[0] LIFETIME",
          attrs[0][0], TURN_ATTR_LIFETIME)
    ce_eq("authed attr[1] REQUESTED-TRANSPORT",
          attrs[1][0], TURN_ATTR_REQUESTED_TRANSPORT)
    ce_eq("authed attr[2] USERNAME",
          attrs[2][0], TURN_ATTR_USERNAME)
    ce_eq("authed attr[3] REALM",
          attrs[3][0], TURN_ATTR_REALM)
    ce_eq("authed attr[4] NONCE",
          attrs[4][0], TURN_ATTR_NONCE)
    ce_eq("authed attr[5] MESSAGE-INTEGRITY",
          attrs[5][0], TURN_ATTR_MESSAGE_INTEGRITY)
    ce_eq("authed MI value length = 20", attrs[5][2], 20)
    // Username string round-trips.
    ce_eq("authed USERNAME length = 5", attrs[2][2], 5)
    ce_eq("authed USERNAME byte 0 = 'a'", load8(attrs[2][1] + 0), 97)
    ce_eq("authed REALM byte 0 = 'c'", load8(attrs[3][1] + 0), 99)
    ce_eq("authed NONCE byte 0 = 'n'", load8(attrs[4][1] + 0), 110)
}

// MI byte-position rule: HMAC is computed over the bytes BEFORE the
// MI attribute. Confirm we can recompute the MI ourselves and it
// matches the embedded value.
fn test_emit_allocate_authed_mi_position() {
    let txn = _tt_fixed_txn()
    let pkt = turn_emit_allocate_request_authed(txn, 600, TURN_TRANSPORT_UDP,
                                                "alice", "secret",
                                                "ce-realm", "n01ce")
    let buf = pkt[0]
    let n = pkt[1]
    let key = turn_hmac_sha1_key("alice", "ce-realm", "secret")
    // The MI attr is the LAST attribute and is 24 bytes wide
    // (4-byte TLV header + 20-byte value).
    let mi_attr_start = n - 24
    let computed = _turn_test_hmac_sha1(key, 16, buf, mi_attr_start)
    let mi_val = mi_attr_start + 4
    let i = 0
    let same = 1
    while i < 20 {
        if load8(computed + i) != load8(buf + mi_val + i) { same = 0 }
        i = i + 1
    }
    ce_eq("computed MI matches embedded value at MI position",
          same, 1)
}

// turn_verify_message_integrity on a self-emitted authed Allocate
// should return 1 (own-message MI must verify).
fn test_verify_message_integrity_self_emit() {
    let txn = _tt_alt_txn()
    let pkt = turn_emit_allocate_request_authed(txn, 600, TURN_TRANSPORT_UDP,
                                                "bob", "12345",
                                                "ce-realm", "noncev2")
    let key = turn_hmac_sha1_key("bob", "ce-realm", "12345")
    let ok = turn_verify_message_integrity(pkt[0], pkt[1], key)
    ce_eq("self-emitted authed MI verifies", ok, 1)
}

// turn_verify_message_integrity with the WRONG key should fail.
fn test_verify_message_integrity_wrong_key() {
    let txn = _tt_alt_txn()
    let pkt = turn_emit_allocate_request_authed(txn, 600, TURN_TRANSPORT_UDP,
                                                "bob", "12345",
                                                "ce-realm", "noncev2")
    let bad_key = turn_hmac_sha1_key("bob", "ce-realm", "WRONG")
    let ok = turn_verify_message_integrity(pkt[0], pkt[1], bad_key)
    ce_eq("wrong-key MI verify fails", ok, 0)
}

// turn_verify_message_integrity on a message with NO MI should return
// 0 (skip with documented tolerance, not crash).
fn test_verify_message_integrity_no_mi() {
    let txn = _tt_fixed_txn()
    let pkt = turn_emit_allocate_request(txn, 600, TURN_TRANSPORT_UDP)
    let key = turn_hmac_sha1_key("alice", "ce-realm", "secret")
    let ok = turn_verify_message_integrity(pkt[0], pkt[1], key)
    ce_eq("no-MI message -> verify returns 0 (no crash)", ok, 0)
}

// turn_parse_401_response: build a 401 Allocate Error with REALM +
// NONCE and confirm both are extracted.
fn test_parse_401_response_extracts_realm_nonce() {
    let txn = _tt_fixed_txn()
    let reason = "Unauthorized"
    let reason_n = len(reason)
    let err_val_n = 4 + reason_n
    let body = _turn_test_attr_size(err_val_n)
              + _turn_test_attr_size(8)        // REALM
              + _turn_test_attr_size(7)        // NONCE
    let total = TURN_HDR_LEN + body
    let buf = _tt_zero_buf(total)
    let mtype = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                   TURN_CLASS_ERROR_RESP)
    _turn_test_put_u16(buf, 0, mtype)
    _turn_test_put_u16(buf, 2, body)
    _turn_test_put_u32(buf, 4, 0x2112A442)
    let i = 0
    while i < 12 { store8(buf + 8 + i, load8(txn + i)); i = i + 1 }
    let off = TURN_HDR_LEN
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_ERROR_CODE)
    _turn_test_put_u16(buf, off + 2, err_val_n)
    store8(buf + off + 4, 0)
    store8(buf + off + 5, 0)
    store8(buf + off + 6, 4)        // class = 4
    store8(buf + off + 7, 1)        // number = 1
    let k = 0
    while k < reason_n {
        store8(buf + off + 8 + k, char_at(reason, k))
        k = k + 1
    }
    off = off + _turn_test_attr_size(err_val_n)
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_REALM)
    _turn_test_put_u16(buf, off + 2, 8)
    let rl = "ce-realm"
    k = 0
    while k < 8 { store8(buf + off + 4 + k, char_at(rl, k)); k = k + 1 }
    off = off + 12
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_NONCE)
    _turn_test_put_u16(buf, off + 2, 7)
    let nc = "n01ce42"
    k = 0
    while k < 7 { store8(buf + off + 4 + k, char_at(nc, k)); k = k + 1 }
    off = off + _turn_test_attr_size(7)
    let dec = turn_parse_401_response(buf, total)
    ce_check("parse_401 returns list", len(dec) == 4)
    ce_eq("parse_401 realm_n = 8", dec[1], 8)
    ce_eq("parse_401 nonce_n = 7", dec[3], 7)
    ce_eq("parse_401 realm byte 0 = 'c'", load8(dec[0] + 0), 99)
    ce_eq("parse_401 nonce byte 0 = 'n'", load8(dec[2] + 0), 110)
    ce_eq("parse_401 realm byte 7 = 'm'", load8(dec[0] + 7), 109)
    ce_eq("parse_401 nonce byte 6 = '2'", load8(dec[2] + 6), 50)
}

// parse_401 must reject responses that lack REALM or NONCE.
fn test_parse_401_rejects_no_realm() {
    let txn = _tt_fixed_txn()
    // 401 Error with NO REALM attribute.
    let resp = turn_emit_allocate_error_response(txn, 4, 1, "Unauthorized")
    let dec = turn_parse_401_response(resp[0], resp[1])
    ce_eq("401 missing REALM -> ERR_NO_ATTR", dec, TURN_ERR_NO_ATTR)
}

// parse_401 must reject responses with non-401 error code.
fn test_parse_401_rejects_non_401() {
    let txn = _tt_fixed_txn()
    let resp = turn_emit_allocate_error_response(txn, 4, 37,
                                                 "Allocation Mismatch")
    let dec = turn_parse_401_response(resp[0], resp[1])
    // Non-401 returns TURN_ERR_METHOD per the parser contract.
    ce_eq("non-401 -> ERR_METHOD", dec, TURN_ERR_METHOD)
}

// ----------------------------------------------------------------------------
// Per-permission tick
// ----------------------------------------------------------------------------

fn test_perm_lifetime_default_constants() {
    ce_eq("TURN_PERM_LIFETIME_DEFAULT = 300 (RFC 5766 §8)",
          TURN_PERM_LIFETIME_DEFAULT, 300)
    ce_eq("TURN_CHANNEL_LIFETIME_DEFAULT = 600 (RFC 5766 §11)",
          TURN_CHANNEL_LIFETIME_DEFAULT, 600)
}

fn test_tick_perms_removes_expired() {
    let st = turn_client_init_authed()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Stamp two permissions at now+300 expiry.
    let txn2 = _tt_alt_txn()
    turn_client_send_permission(st, txn2, "192.0.2.50", 5678)
    let r1 = turn_emit_create_permission_success_response(txn2)
    turn_client_recv(st, r1[0], r1[1], now)
    let txn3 = alloc(13)
    let i = 0
    while i < 12 { store8(txn3 + i, 0xC0 + i); i = i + 1 }
    store8(txn3 + 12, 0)
    turn_client_send_permission(st, txn3, "192.0.2.51", 5679)
    let r2 = turn_emit_create_permission_success_response(txn3)
    turn_client_recv(st, r2[0], r2[1], now)
    ce_eq("two perms appended", len(turn_client_perms(st)), 2)
    // Tick at now+400 -> both expired.
    let r = turn_client_tick_perms(st, now + 400)
    ce_eq("tick_perms removed 2 perms", r[0], 2)
    ce_eq("tick_perms removed 0 channels", r[1], 0)
    ce_eq("perms_list now empty", len(turn_client_perms(st)), 0)
    ce_eq("stats_perm_expired bumped by 2",
          turn_client_stats_perm_expired(st), 2)
}

fn test_tick_perms_keeps_in_window() {
    let st = turn_client_init_authed()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    let txn2 = _tt_alt_txn()
    turn_client_send_permission(st, txn2, "192.0.2.50", 5678)
    let r1 = turn_emit_create_permission_success_response(txn2)
    turn_client_recv(st, r1[0], r1[1], now)
    // Tick at now+100 -- well inside the 300s window.
    let r = turn_client_tick_perms(st, now + 100)
    ce_eq("tick_perms removed 0", r[0], 0)
    ce_eq("perms_list still 1", len(turn_client_perms(st)), 1)
    ce_eq("stats_perm_expired = 0",
          turn_client_stats_perm_expired(st), 0)
}

fn test_tick_perms_mixed_window() {
    let st = turn_client_init_authed()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    // Two permissions stamped at DIFFERENT times -- the second is
    // outside the 300s window at the tick instant, the first is in.
    let now0 = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now0)
    let txn2 = _tt_alt_txn()
    turn_client_send_permission(st, txn2, "192.0.2.50", 5678)
    let r1 = turn_emit_create_permission_success_response(txn2)
    turn_client_recv(st, r1[0], r1[1], now0)
    // Permission 2 stamped LATER at now0 + 200, will expire at now0+500.
    let txn3 = alloc(13)
    let i = 0
    while i < 12 { store8(txn3 + i, 0xD0 + i); i = i + 1 }
    store8(txn3 + 12, 0)
    turn_client_send_permission(st, txn3, "192.0.2.51", 5679)
    let r2 = turn_emit_create_permission_success_response(txn3)
    turn_client_recv(st, r2[0], r2[1], now0 + 200)
    // Tick at now0 + 400 -> first perm (expires at now0+300) is
    // expired; second perm (expires at now0+500) is still in-window.
    let r = turn_client_tick_perms(st, now0 + 400)
    ce_eq("mixed: 1 expired", r[0], 1)
    ce_eq("perms_list now 1", len(turn_client_perms(st)), 1)
    ce_str_eq("surviving perm ip = '192.0.2.51'",
              turn_client_perms(st)[0][0], "192.0.2.51")
}

fn test_tick_perms_channels_pruned() {
    let st = turn_client_init_authed()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Build a channel binding via the R36A-aware appender.
    list_set(st, _TURN_ST_PENDING_CHANNEL, 0x4001)
    list_set(st, _TURN_ST_PENDING_PEER_IP, "203.0.113.7")
    list_set(st, _TURN_ST_PENDING_PEER_PORT, 9000)
    _turn_test_record_channel_r36a(st, now)
    ce_eq("channels_list has 1 entry", len(turn_client_channels(st)), 1)
    // Tick AT the moment of expiry (now + 600). The entry's expiry is
    // now+600; tick at now+601 expires it. Tick at now+599 keeps it.
    let r1 = turn_client_tick_perms(st, now + 599)
    ce_eq("tick before chan expiry keeps", r1[1], 0)
    ce_eq("channels_list still 1",
          len(turn_client_channels(st)), 1)
    let r2 = turn_client_tick_perms(st, now + 601)
    ce_eq("tick past chan expiry prunes", r2[1], 1)
    ce_eq("channels_list now empty",
          len(turn_client_channels(st)), 0)
    ce_eq("stats_chan_expired bumped",
          turn_client_stats_chan_expired(st), 1)
}

fn test_tick_authed_composition() {
    // turn_client_tick_authed must combine alloc-expiry AND perm cadence
    // in one call.
    let st = turn_client_init_authed()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 60, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 60,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    let txn2 = _tt_alt_txn()
    turn_client_send_permission(st, txn2, "192.0.2.50", 5678)
    let r1 = turn_emit_create_permission_success_response(txn2)
    turn_client_recv(st, r1[0], r1[1], now)
    // Tick at now + 400 -> alloc (60s) expired AND perm (300s) expired.
    let tag = turn_client_tick_authed(st, now + 400)
    ce_eq("composed tick -> EXPIRED tag", tag, TURN_TICK_EXPIRED)
    ce_eq("state -> EXPIRED", turn_client_state(st),
          TURN_STATE_EXPIRED)
    ce_eq("perms also pruned in same tick",
          len(turn_client_perms(st)), 0)
    ce_eq("perm-expired counter = 1",
          turn_client_stats_perm_expired(st), 1)
}

fn test_perm_lifetime_override_default_path() {
    let st = turn_client_init_authed()
    ce_eq("default perm lifetime = 300",
          turn_client_perm_lifetime_default(st), 300)
    turn_set_perm_lifetime_default(st, 120)
    ce_eq("override perm lifetime = 120",
          turn_client_perm_lifetime_default(st), 120)
}

// `turn_client_restamp_last_permission` re-stamps the last appended
// perm's expiry with the configured (override) lifetime. Confirm the
// recorded expiry matches now + override_secs.
fn test_perm_lifetime_override_reflected_after_recv() {
    let st = turn_client_init_authed()
    let txn = _tt_fixed_txn()
    turn_client_send_allocate(st, txn, 600, TURN_TRANSPORT_UDP)
    let now = 1700000000
    let resp = _tt_allocate_success(txn, "203.0.113.5", 51000, 600,
                                    "198.51.100.7", 41000)
    turn_client_recv(st, resp[0], resp[1], now)
    // Configure a 120s default and stamp via the authed send.
    turn_set_perm_lifetime_default(st, 120)
    let txn2 = _tt_alt_txn()
    turn_client_send_permission_authed(st, txn2, "192.0.2.50", 5678)
    let r1 = turn_emit_create_permission_success_response(txn2)
    turn_client_recv(st, r1[0], r1[1], now)
    turn_client_restamp_last_permission(st, now)
    let perms = turn_client_perms(st)
    ce_eq("perm[0] expiry = now + 120 (override)",
          perms[0][2], now + 120)
}

fn test_tick_perms_no_alloc_still_works() {
    // tick_perms on an IDLE state must not crash, must return [0, 0].
    let st = turn_client_init_authed()
    let r = turn_client_tick_perms(st, 1700000000)
    ce_eq("tick_perms idle -> 0 perms expired", r[0], 0)
    ce_eq("tick_perms idle -> 0 chans expired", r[1], 0)
}

// Compatibility: a state built by the R35B `turn_client_init` (no R36A
// slots) must be auto-extended by `turn_client_tick_perms` so the
// counters still work.
fn test_tick_perms_r35b_state_auto_extends() {
    let st = turn_client_init()
    ce_eq("init state has 24 slots (R35B baseline)", len(st), 24)
    let r = turn_client_tick_perms(st, 1700000000)
    ce_eq("tick_perms on R35B state ok", r[0], 0)
    ce_check("state auto-extended to >= 27 slots", len(st) >= 27)
    ce_eq("stats_perm_expired accessor reads 0",
          turn_client_stats_perm_expired(st), 0)
}

