    test_create_permission_multi()
    test_send_indication_byte_layout()
    test_send_to_data_indication_via_parse()
    test_send_parsed_via_data_parser_rejects_method()
    test_send_with_large_payload()
    test_channel_bind_roundtrip()
    test_reject_short_header()
