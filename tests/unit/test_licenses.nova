// Unit tests for src/kg/licenses.nova (KG-licenses table, ADR-0087 / Rule 3).

import "../ce_test.nova"
import "../../src/kg/licenses.nova"

fn test_registry() {
    let reg = lic_registry_new()
    ce_eq("unknown not commercial", lic_commercial_ok(reg, LICENSE_UNKNOWN), 0)
    ce_eq("owner commercial", lic_commercial_ok(reg, LICENSE_OWNER), 1)
    ce_eq("open commercial", lic_commercial_ok(reg, LICENSE_OPEN), 1)
    ce_eq("cc-by-sa commercial", lic_commercial_ok(reg, LICENSE_CC_BY_SA), 1)
    ce_eq("cc-by-sa attribution", lic_attribution_required(reg, LICENSE_CC_BY_SA), 1)
    ce_eq("cc-by-sa share-alike", lic_share_alike(reg, LICENSE_CC_BY_SA), 1)
    ce_eq("open no attribution", lic_attribution_required(reg, LICENSE_OPEN), 0)
    ce_eq("proprietary not commercial", lic_commercial_ok(reg, LICENSE_PROPRIETARY), 0)
    ce_str_eq("cc-by-sa name", lic_name(reg, LICENSE_CC_BY_SA), "CC-BY-SA-4.0")
    ce_str_eq("open name", lic_name(reg, LICENSE_OPEN), "public-domain")
    // Fail-safe: out-of-range / negative codes resolve to UNKNOWN (not clean).
    ce_eq("oob code -> not commercial", lic_commercial_ok(reg, 99), 0)
    ce_eq("negative code -> not commercial", lic_commercial_ok(reg, 0 - 1), 0)
}

fn test_register() {
    let reg = lic_registry_new()
    let code = lic_register(reg, "MIT", 1, 1, 0, "https://opensource.org/license/mit")
    ce_eq("registered code = 5", code, 5)
    ce_eq("MIT commercial", lic_commercial_ok(reg, code), 1)
    ce_eq("MIT attribution", lic_attribution_required(reg, code), 1)
    ce_eq("MIT no share-alike", lic_share_alike(reg, code), 0)
    ce_str_eq("MIT name", lic_name(reg, code), "MIT")
}

fn test_atom_clean() {
    let reg = lic_registry_new()
    let a = atom_new("medicine", 0, ATOM_FACT, "aspirin", 5)
    // Default license is UNKNOWN -> not clean (quarantine).
    ce_eq("default atom not clean", atom_license_clean(reg, a), 0)
    atom_set_license(a, LICENSE_OPEN)
    ce_eq("open atom clean", atom_license_clean(reg, a), 1)
    ce_eq("open atom no attribution", atom_requires_attribution(reg, a), 0)
    atom_set_license(a, LICENSE_CC_BY_SA)
    ce_eq("cc-by-sa atom clean", atom_license_clean(reg, a), 1)
    ce_eq("cc-by-sa atom needs attribution", atom_requires_attribution(reg, a), 1)
    ce_eq("cc-by-sa atom needs share-alike", atom_requires_share_alike(reg, a), 1)
    atom_set_license(a, LICENSE_PROPRIETARY)
    ce_eq("proprietary atom not clean", atom_license_clean(reg, a), 0)
}

fn main() {
    test_registry()
    test_register()
    test_atom_clean()
    ce_summary("licenses")
}

main()
