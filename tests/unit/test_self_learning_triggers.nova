// Unit tests for src/learning/self_learning_triggers.nova
// Verifies source weights and activation thresholds, priority scoring, queue
// dedup/cap/eviction, user-request pre-emption in selection, and arbitration
// (one external episode, user pre-empts). ADR-0026.

import "../ce_test.nova"
import "../../src/learning/self_learning_triggers.nova"

fn test_weights_and_thresholds() {
    ce_eq("user weight", slt_source_weight(SLT_USER_REQUEST), 1000)
    ce_eq("error weight", slt_source_weight(SLT_PREDICTION_ERROR), 700)
    ce_eq("curiosity weight", slt_source_weight(SLT_CURIOSITY), 300)
    ce_eq("curiosity fires", slt_curiosity_fires(700), 1)
    ce_eq("curiosity quiet", slt_curiosity_fires(500), 0)
    ce_eq("imagination gap fires", slt_imagination_gap_fires(5000), 1)
    ce_eq("imagination gap full", slt_imagination_gap_fires(9000), 0)
    ce_eq("error fires sustained", slt_error_fires(500, 5), 1)
    ce_eq("error not sustained", slt_error_fires(500, 3), 0)
    ce_eq("error too small", slt_error_fires(300, 9), 0)
}

fn test_priority() {
    let e = trigger_new(SLT_PREDICTION_ERROR, 5, 1000, 1000)
    ce_eq("error priority", slt_priority(e), 700)
    ce_eq("target stored", slt_target(e), 5)
    let u = trigger_new(SLT_USER_REQUEST, 7, 500, 1000)
    ce_eq("user priority scaled by gap", slt_priority(u), 500)
    let c = trigger_new(SLT_CURIOSITY, 9, 1000, 500)
    ce_eq("goal alignment scales", slt_priority(c), 150)   // 0.3*1.0*0.5
}

fn test_submit_dedup_cap() {
    let arb = slt_arbiter_new()
    slt_submit(arb, trigger_new(SLT_PREDICTION_ERROR, 1, 1000, 1000))  // pri 700
    // Same target, lower priority -> kept existing, no growth.
    slt_submit(arb, trigger_new(SLT_CURIOSITY, 1, 1000, 1000))         // pri 300
    ce_eq("dedup keeps one", slt_queue_size(arb), 1)
    // Same target, higher priority -> replaced.
    slt_submit(arb, trigger_new(SLT_USER_REQUEST, 1, 1000, 1000))      // pri 1000
    ce_eq("still one", slt_queue_size(arb), 1)
    ce_eq("replaced with higher", slt_priority(slt_select(arb)), 1000)

    // Fill to capacity with distinct targets.
    let arb2 = slt_arbiter_new()
    let i = 0
    while i < SLT_QUEUE_MAX {
        slt_submit(arb2, trigger_new(SLT_PREDICTION_ERROR, 100 + i, 700, 1000))  // pri ~490
        i = i + 1
    }
    ce_eq("queue full", slt_queue_size(arb2), SLT_QUEUE_MAX)
    // A weaker newcomer is dropped.
    ce_eq("weak dropped", slt_submit(arb2, trigger_new(SLT_CURIOSITY, 999, 100, 1000)), 0)
    ce_eq("still full", slt_queue_size(arb2), SLT_QUEUE_MAX)
    // A stronger newcomer evicts the lowest.
    ce_eq("strong evicts", slt_submit(arb2, trigger_new(SLT_USER_REQUEST, 999, 1000, 1000)), 1)
    ce_eq("size unchanged", slt_queue_size(arb2), SLT_QUEUE_MAX)
}

fn test_user_preempts() {
    let arb = slt_arbiter_new()
    slt_submit(arb, trigger_new(SLT_PREDICTION_ERROR, 1, 1000, 1000))  // pri 700
    slt_submit(arb, trigger_new(SLT_USER_REQUEST, 2, 100, 1000))       // pri 100, but user
    // Selection pre-empts to the user request despite lower priority.
    ce_eq("user pre-empts selection", slt_target(slt_select(arb)), 2)
}

fn test_arbitration() {
    let arb = slt_arbiter_new()
    slt_submit(arb, trigger_new(SLT_PREDICTION_ERROR, 1, 1000, 1000))  // pri 700
    slt_submit(arb, trigger_new(SLT_CURIOSITY, 2, 1000, 1000))         // pri 300
    let a1 = slt_arbiter_step(arb)
    ce_eq("activates highest", slt_target(a1), 1)
    ce_eq("active set", slt_target(slt_active(arb)), 1)
    // External episode stays active (no user request) on the next step.
    ce_eq("external holds", slt_target(slt_arbiter_step(arb)), 1)
    // A user request pre-empts the active external episode.
    slt_submit(arb, trigger_new(SLT_USER_REQUEST, 3, 500, 1000))
    ce_eq("user pre-empts active", slt_target(slt_arbiter_step(arb)), 3)
}

fn main() {
    test_weights_and_thresholds()
    test_priority()
    test_submit_dedup_cap()
    test_user_preempts()
    test_arbitration()
    ce_summary("self_learning_triggers")
}

main()
