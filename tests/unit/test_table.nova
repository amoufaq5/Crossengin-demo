// Unit tests for src/data/table.nova (P3, ADR-0053).
//
// Covers CSV parsing (incl. quoted fields with embedded commas and "" escapes),
// Markdown-pipe parsing (separator row skipped), integer-cell detection, and
// the acceptance criterion: a CSV ingests to row-atoms that are queryable via
// query.nova GROUP BY (sum a measure column grouped by a category column).
//
// ADR-0053, ADR-0016.

import "../ce_test.nova"
import "../../src/data/table.nova"
import "../../src/kg/query.nova"

fn test_csv_parse() {
    let t = table_parse_csv("region,amount\nwest,100\neast,200\n")
    ce_eq("2 cols", table_ncols(t), 2)
    ce_eq("2 rows", table_nrows(t), 2)
    ce_str_eq("header 0", table_headers(t)[0], "region")
    ce_str_eq("cell 0 region", table_cell_by(t, 0, "region"), "west")
    ce_eq("cell 1 amount as int", table_cell_int(t, 1, table_col_index(t, "amount")), 200)
    ce_eq("missing col -> -1", table_col_index(t, "nope"), 0 - 1)
}

fn test_csv_quoting() {
    // name = Smith, John  ;  note = says "hi"
    let t = table_parse_csv("name,note\n\"Smith, John\",\"says \"\"hi\"\"\"\n")
    ce_eq("one row", table_nrows(t), 1)
    ce_str_eq("quoted comma preserved", table_cell_by(t, 0, "name"), "Smith, John")
    ce_str_eq("doubled quotes unescaped", table_cell_by(t, 0, "note"), "says \"hi\"")
}

fn test_int_detection() {
    ce_eq("plain int", table_is_int("42"), 1)
    ce_eq("negative int", table_is_int("-7"), 1)
    ce_eq("alnum is not int", table_is_int("4a"), 0)
    ce_eq("empty is not int", table_is_int(""), 0)
    ce_eq("lone minus is not int", table_is_int("-"), 0)
}

fn test_markdown_parse() {
    let t = table_parse_markdown("| name | qty |\n|------|-----|\n| apple | 3 |\n| pear | 5 |\n")
    ce_eq("md 2 cols", table_ncols(t), 2)
    ce_eq("md 2 rows (separator skipped)", table_nrows(t), 2)
    ce_str_eq("md cell name", table_cell_by(t, 1, "name"), "pear")
    ce_str_eq("md cell qty", table_cell_by(t, 0, "qty"), "3")
}

// Acceptance: CSV -> row-atoms -> aggregate with query.nova GROUP BY.
fn test_groupby_query() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "sales")
    let t = table_parse_csv("region,amount\nwest,100\neast,200\nwest,300\neast,50\n")
    let res = table_to_atoms(kg, t, "sale", "region", "amount", 0)
    let dict = res[1]
    ce_eq("4 row-atoms created", kg_atom_count(kg), 4)

    let q = kg_query_parse("SELECT ?g (SUM(?a alpha) AS ?total) WHERE { ?a beta ?g . } GROUP BY ?g")
    let rows = kg_query_execute(kg, q)
    ce_eq("two groups", len(rows), 2)
    let west_ok = 0
    let east_ok = 0
    let i = 0
    while i < len(rows) {
        let name = table_group_value(dict, binding_get(rows[i], "g"))
        let total = binding_get(rows[i], "total")
        if str_eq(name, "west") == 1 { if total == 400 { west_ok = 1 } }   // 100 + 300
        if str_eq(name, "east") == 1 { if total == 250 { east_ok = 1 } }   // 200 + 50
        i = i + 1
    }
    ce_eq("west grouped sum = 400", west_ok, 1)
    ce_eq("east grouped sum = 250", east_ok, 1)

    // the full row is preserved in the payload regardless of the projection.
    let a0 = kg_atom(kg, 0)
    ce_str_eq("payload keeps region", atom_payload_get(a0, "region"), "west")
    ce_str_eq("payload keeps amount", atom_payload_get(a0, "amount"), "100")
}

fn main() {
    test_csv_parse()
    test_csv_quoting()
    test_int_detection()
    test_markdown_parse()
    test_groupby_query()
    ce_summary("table")
}

main()
