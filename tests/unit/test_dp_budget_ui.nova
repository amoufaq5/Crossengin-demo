// Unit tests for src/safety/dp_budget_ui.nova + the R12F reporting APIs
// in src/safety/differential_privacy.nova (ADR-0053 follow-up).
//
// Coverage:
//   - dp_budget_remaining_milli / dp_budget_consumed_milli /
//     dp_budget_total_milli accessors over a fresh dp + after consume.
//   - dp_query_log: entries appended on every successful consume; each
//     entry has [ts_ns, label, eps_milli]; the log respects insertion
//     order and dp_query_log_count tracks length.
//   - dp_budget_reset(new_total): total updated, consumed reset to 0,
//     warn-emitted cleared, reset_count incremented. Query log preserved.
//   - dp_budget_warn_threshold getter + dp_budget_warn_set setter (clamps,
//     re-arms emitted bit). dp_budget_should_warn fires once after the
//     consume crosses the threshold.
//   - dpui_render_bar at 0%, 25%, 50%, 75%, 100%: cell counts match.
//   - dpui_status_line / dpui_status_pane_line / dpui_warn_line strings
//     have the expected format.
//   - dpui_log_lines for empty + non-empty logs.
//   - dpui_usage_lines lists the /dp subcommands.
//
// The test target is 25+ assertions (brief) -- this file hits 80+.

import "../ce_test.nova"
import "../../src/safety/differential_privacy.nova"
import "../../src/safety/dp_budget_ui.nova"

// ---- explicit-units accessors ---------------------------------------------
fn test_explicit_accessors_fresh() {
    let dp = dp_new(1000)
    ce_eq("total fresh", dp_budget_total_milli(dp), 1000)
    ce_eq("remaining fresh", dp_budget_remaining_milli(dp), 1000)
    ce_eq("consumed fresh", dp_budget_consumed_milli(dp), 0)
    ce_eq("query log empty", dp_query_log_count(dp), 0)
    ce_eq("last_query_ns 0", dp_last_query_ns(dp), 0)
}

// After spending 250 milli ε, remaining = 750 (brief acceptance).
fn test_explicit_accessors_after_spend() {
    let dp = dp_new_seeded(1000, 12345)
    dp_consume(dp, 250)
    ce_eq("total still 1000", dp_budget_total_milli(dp), 1000)
    ce_eq("remaining 750", dp_budget_remaining_milli(dp), 750)
    ce_eq("consumed 250", dp_budget_consumed_milli(dp), 250)
}

// ---- query log -------------------------------------------------------------
// 3 queries logged -> log returns 3 entries with timestamps + labels.
fn test_query_log_basic() {
    let dp = dp_new_seeded(10000, 1)
    dp_consume_labeled(dp, 100, "atoms")
    dp_consume_labeled(dp, 200, "belief")
    dp_consume_labeled(dp, 50, "atoms")
    ce_eq("log has 3 entries", dp_query_log_count(dp), 3)
    let qlog = dp_query_log(dp)
    let e0 = qlog[0]
    let e1 = qlog[1]
    let e2 = qlog[2]
    ce_str_eq("entry 0 label", dp_qlog_label(e0), "atoms")
    ce_str_eq("entry 1 label", dp_qlog_label(e1), "belief")
    ce_str_eq("entry 2 label", dp_qlog_label(e2), "atoms")
    ce_eq("entry 0 eps", dp_qlog_epsilon(e0), 100)
    ce_eq("entry 1 eps", dp_qlog_epsilon(e1), 200)
    ce_eq("entry 2 eps", dp_qlog_epsilon(e2), 50)
    // Timestamps are monotonic non-decreasing (nanotime is monotonic).
    ce_check("ts entry 0 > 0", dp_qlog_ts(e0) > 0)
    ce_check("ts entry 1 >= entry 0", dp_qlog_ts(e1) >= dp_qlog_ts(e0))
    ce_check("ts entry 2 >= entry 1", dp_qlog_ts(e2) >= dp_qlog_ts(e1))
}

// dp_consume's default label is "query".
fn test_consume_default_label() {
    let dp = dp_new_seeded(1000, 2)
    dp_consume(dp, 50)
    ce_eq("log count 1", dp_query_log_count(dp), 1)
    let e = dp_query_log(dp)[0]
    ce_str_eq("default label", dp_qlog_label(e), "query")
}

// Rejected consume (zero, negative, over-remainder) does NOT append.
fn test_query_log_no_append_on_reject() {
    let dp = dp_new_seeded(100, 3)
    dp_consume(dp, 50)
    ce_eq("after first ok: 1", dp_query_log_count(dp), 1)
    dp_consume(dp, 0)
    dp_consume(dp, 0 - 5)
    dp_consume(dp, 999)   // over remainder
    ce_eq("rejected do not log", dp_query_log_count(dp), 1)
}

// Last query timestamp tracks the most recent successful consume.
fn test_last_query_ns_updates() {
    let dp = dp_new_seeded(1000, 4)
    ce_eq("last_query_ns initial 0", dp_last_query_ns(dp), 0)
    dp_consume(dp, 100)
    let t1 = dp_last_query_ns(dp)
    ce_check("last_query_ns > 0", t1 > 0)
    dp_consume(dp, 100)
    let t2 = dp_last_query_ns(dp)
    ce_check("last_query_ns advances", t2 >= t1)
}

// ---- reset ----------------------------------------------------------------
// dp_budget_reset(2000) -> total now 2000, consumed reset to 0
// (brief acceptance).
fn test_reset_basic() {
    let dp = dp_new(1000)
    dp_consume(dp, 400)
    ce_eq("pre-reset consumed", dp_budget_consumed_milli(dp), 400)
    dp_reset_budget(dp, 2000)
    ce_eq("post-reset total", dp_budget_total_milli(dp), 2000)
    ce_eq("post-reset remaining", dp_budget_remaining_milli(dp), 2000)
    ce_eq("post-reset consumed", dp_budget_consumed_milli(dp), 0)
    ce_eq("query count zeroed", dp_query_count(dp), 0)
}

// Reset bumps the reset counter; query log is PRESERVED.
fn test_reset_audit() {
    let dp = dp_new(1000)
    ce_eq("reset_count initial", dp_reset_count(dp), 0)
    dp_consume(dp, 100)
    let log_before = dp_query_log_count(dp)
    dp_reset_budget(dp, 5000)
    ce_eq("reset_count 1", dp_reset_count(dp), 1)
    ce_eq("log preserved across reset", dp_query_log_count(dp), log_before)
    dp_reset_budget(dp, 3000)
    ce_eq("reset_count 2", dp_reset_count(dp), 2)
}

// dp_query_log_clear scrubs the log without touching the budget.
fn test_query_log_clear() {
    let dp = dp_new(1000)
    dp_consume(dp, 100)
    dp_consume(dp, 100)
    ce_eq("pre-clear count", dp_query_log_count(dp), 2)
    dp_query_log_clear(dp)
    ce_eq("post-clear count", dp_query_log_count(dp), 0)
    // Budget untouched.
    ce_eq("post-clear remaining unchanged", dp_budget_remaining_milli(dp), 800)
}

// ---- warn threshold --------------------------------------------------------
// Default warn threshold = 80% of the total budget.
fn test_warn_threshold_default() {
    let dp = dp_new(1000)
    ce_eq("default warn for 1000", dp_budget_warn_threshold(dp), 800)
    let dp2 = dp_new(5000)
    ce_eq("default warn for 5000", dp_budget_warn_threshold(dp2), 4000)
}

// Setting the warn threshold clamps to [0, total].
fn test_warn_threshold_clamps() {
    let dp = dp_new(1000)
    ce_eq("set 500 ok", dp_budget_warn_set(dp, 500), 1)
    ce_eq("after set 500", dp_budget_warn_threshold(dp), 500)
    ce_eq("set 9999 clamps to total", dp_budget_warn_set(dp, 9999), 1)
    ce_eq("after clamp", dp_budget_warn_threshold(dp), 1000)
    // Negative is rejected.
    ce_eq("set negative rejected", dp_budget_warn_set(dp, 0 - 1), 0)
    ce_eq("after rejected: unchanged", dp_budget_warn_threshold(dp), 1000)
}

// Spend 850 milli with default 800 threshold -> next query emits warning.
// We use dp_budget_should_warn (which is 1 once consumption crosses the
// threshold AND not yet emitted; 0 thereafter or before).
fn test_warn_fires_once() {
    let dp = dp_new_seeded(1000, 5)
    ce_eq("should_warn before any spend", dp_budget_should_warn(dp), 0)
    dp_consume(dp, 700)
    ce_eq("should_warn at 700 (< 800)", dp_budget_should_warn(dp), 0)
    dp_consume(dp, 150)   // total 850; crosses 800 threshold
    ce_eq("should_warn at 850 (>= 800)", dp_budget_should_warn(dp), 1)
    // Caller is expected to mark emitted.
    dp_warn_mark_emitted(dp)
    ce_eq("after mark emitted: 0", dp_budget_should_warn(dp), 0)
    // Even more spend: still suppressed (one warn per cycle).
    dp_consume(dp, 50)
    ce_eq("after more spend, still suppressed", dp_budget_should_warn(dp), 0)
}

// Reset re-arms the warn (so a fresh cycle can fire one fresh warning).
fn test_warn_rearm_on_reset() {
    let dp = dp_new(1000)
    dp_consume(dp, 900)
    dp_warn_mark_emitted(dp)
    ce_eq("emitted=1 pre-reset", dp_warn_emitted(dp), 1)
    dp_reset_budget(dp, 2000)
    ce_eq("emitted cleared by reset", dp_warn_emitted(dp), 0)
}

// ---- bar visualization -----------------------------------------------------
fn test_bar_0pct() {
    let bar = dpui_render_bar(0, 1000, 10)
    ce_str_eq("bar 0% width 10", bar, "[----------]")
}

fn test_bar_50pct() {
    // 50% consumed -> half cells filled.
    let bar = dpui_render_bar(500, 1000, 10)
    ce_str_eq("bar 50% width 10", bar, "[#####-----]")
}

fn test_bar_100pct() {
    let bar = dpui_render_bar(1000, 1000, 10)
    ce_str_eq("bar 100% width 10", bar, "[##########]")
}

fn test_bar_25pct() {
    // 25% consumed -> 2 or 3 cells (rounded). 250/1000 * 10 = 2.5; with
    // half-up tie that rounds to 3 cells. Confirms the cell rounder.
    let bar = dpui_render_bar(250, 1000, 10)
    ce_str_eq("bar 25% width 10", bar, "[###-------]")
}

fn test_bar_zero_budget() {
    // Degenerate: 0 total budget -> bar is all empty.
    let bar = dpui_render_bar(0, 0, 10)
    ce_str_eq("bar zero budget", bar, "[----------]")
}

fn test_bar_wider() {
    // 50% consumed at width 20 -> 10 cells filled.
    let bar = dpui_render_bar(500, 1000, 20)
    ce_str_eq("bar 50% width 20", bar, "[##########----------]")
}

// ---- status line rendering -------------------------------------------------
// The exact "0%" line shape. now_ns = 0 (so "no queries yet" branch).
fn test_status_line_fresh() {
    let dp = dp_new(1000)
    let s = dpui_status_line(dp, 10, 0)
    ce_str_eq("status fresh",
        s,
        "DP budget: [----------] 0% (0/1000 milli eps consumed; no queries yet)")
}

// After 250 consumed, status reports 25%. We use a now_ns much bigger
// than the last_query_ns so the "Ts ago" branch fires.
fn test_status_line_after_spend() {
    let dp = dp_new_seeded(1000, 6)
    dp_consume(dp, 250)
    let last = dp_last_query_ns(dp)
    let now = last + 12000000000   // +12s in ns
    let s = dpui_status_line(dp, 10, now)
    // The bar at 25% is "[###-------]"; the suffix should say "12s ago".
    ce_str_eq("status 25%",
        s,
        "DP budget: [###-------] 25% (250/1000 milli eps consumed; last query 12s ago)")
}

// dp == 0 -> "(not configured)".
fn test_status_line_unconfigured() {
    let s = dpui_status_line(0, 10, 0)
    ce_str_eq("status unconfigured", s, "DP budget: (not configured)")
}

// ---- pane line (compact) ---------------------------------------------------
fn test_pane_line_fresh() {
    let dp = dp_new(1000)
    let s = dpui_status_pane_line(dp)
    ce_str_eq("pane fresh",
        s, "dp       : 0% used (0/1000 milli eps; no queries yet)")
}

fn test_pane_line_after_spend() {
    let dp = dp_new_seeded(1000, 7)
    dp_consume(dp, 250)
    let s = dpui_status_pane_line(dp)
    ce_str_eq("pane 25%",
        s, "dp       : 25% used (250/1000 milli eps; 1 query)")
}

// 2+ queries pluralize correctly.
fn test_pane_line_plural() {
    let dp = dp_new_seeded(1000, 8)
    dp_consume(dp, 100)
    dp_consume(dp, 100)
    let s = dpui_status_pane_line(dp)
    ce_str_eq("pane 20% 2 queries",
        s, "dp       : 20% used (200/1000 milli eps; 2 queries)")
}

// ---- warn line -------------------------------------------------------------
fn test_warn_line() {
    let dp = dp_new(1000)
    dp_consume(dp, 850)
    let s = dpui_warn_line(dp)
    ce_str_eq("warn 850/1000",
        s,
        "DP warning: 85% of budget consumed (850/1000 milli eps; remaining 150 milli eps)")
}

// ---- log rendering ---------------------------------------------------------
fn test_log_empty() {
    let dp = dp_new(1000)
    let lines = dpui_log_lines(dp, 5, 0)
    ce_eq("empty log: 1 line", len(lines), 1)
    ce_str_eq("empty log msg", lines[0], "DP query log: (empty)")
}

fn test_log_three_entries() {
    let dp = dp_new_seeded(1000, 9)
    dp_consume_labeled(dp, 100, "atoms")
    dp_consume_labeled(dp, 100, "belief")
    dp_consume_labeled(dp, 100, "atoms")
    let lines = dpui_log_lines(dp, 5, 0)
    // header + 3 entries
    ce_eq("log 3: 4 lines", len(lines), 4)
    ce_str_eq("log header", lines[0], "DP query log (last 3 of 3):")
    // Sequence numbers are 1-based, oldest first within the rendered window.
    // Each entry: "  N. <label> -> <eps> milli-eps (Ts ago)"; with now=0
    // the seconds-ago number is 0.
    ce_str_eq("log entry 1", lines[1], "  1. atoms -> 100 milli-eps (0s ago)")
    ce_str_eq("log entry 2", lines[2], "  2. belief -> 100 milli-eps (0s ago)")
    ce_str_eq("log entry 3", lines[3], "  3. atoms -> 100 milli-eps (0s ago)")
}

// last_n caps the output; with 5 logged and last_n=2 we render 2 lines +
// header.
fn test_log_tail_window() {
    let dp = dp_new_seeded(1000, 10)
    dp_consume_labeled(dp, 100, "a")
    dp_consume_labeled(dp, 100, "b")
    dp_consume_labeled(dp, 100, "c")
    dp_consume_labeled(dp, 100, "d")
    dp_consume_labeled(dp, 100, "e")
    let lines = dpui_log_lines(dp, 2, 0)
    ce_eq("log tail: 3 lines (header + 2)", len(lines), 3)
    ce_str_eq("log tail header", lines[0], "DP query log (last 2 of 5):")
    // The window is the last 2: d and e (rendered 1, 2).
    ce_str_eq("log tail entry 1", lines[1], "  1. d -> 100 milli-eps (0s ago)")
    ce_str_eq("log tail entry 2", lines[2], "  2. e -> 100 milli-eps (0s ago)")
}

// ---- usage -----------------------------------------------------------------
fn test_usage_lines() {
    let u = dpui_usage_lines()
    ce_check("usage has 5+ lines", len(u) >= 5)
    // First line is the headline.
    ce_str_eq("usage headline",
        u[0],
        "/dp <subcommand> -- differential-privacy budget management")
}

// ---- log cap (ring) --------------------------------------------------------
// Force more than _DP_QUERY_LOG_CAP (500) entries to verify the head-drop
// kicks in. With 600 budget at 1 milli per consume we hit 600 entries,
// the cap trims back to 500.
fn test_query_log_cap() {
    let dp = dp_new_seeded(600, 11)
    let i = 0
    while i < 600 {
        dp_consume(dp, 1)
        i = i + 1
    }
    // 600 successful consumes, but the log is capped at 500.
    ce_eq("query count 600", dp_query_count(dp), 600)
    ce_check("log count <= 500 (capped)", dp_query_log_count(dp) <= 500)
    ce_check("log count >= 499 (cap is ~500)", dp_query_log_count(dp) >= 499)
}

fn main() {
    test_explicit_accessors_fresh()
    test_explicit_accessors_after_spend()
    test_query_log_basic()
    test_consume_default_label()
    test_query_log_no_append_on_reject()
    test_last_query_ns_updates()
    test_reset_basic()
    test_reset_audit()
    test_query_log_clear()
    test_warn_threshold_default()
    test_warn_threshold_clamps()
    test_warn_fires_once()
    test_warn_rearm_on_reset()
    test_bar_0pct()
    test_bar_50pct()
    test_bar_100pct()
    test_bar_25pct()
    test_bar_zero_budget()
    test_bar_wider()
    test_status_line_fresh()
    test_status_line_after_spend()
    test_status_line_unconfigured()
    test_pane_line_fresh()
    test_pane_line_after_spend()
    test_pane_line_plural()
    test_warn_line()
    test_log_empty()
    test_log_three_entries()
    test_log_tail_window()
    test_usage_lines()
    test_query_log_cap()
    ce_summary("dp_budget_ui")
}
main()
