// Unit tests for src/io/transducers/secure_channel.nova (PSK-only secure
// channel over TCP, P1.4 continuation of the TLS_AUDIT.md roadmap).
//
// Coverage (no real socket -- the in-memory test helpers
// _sc_test_make_frame / _sc_test_open_frame let us exercise the
// encrypt + MAC envelope without binding a port; the integration test
// scenario_v_secure_channel.sh is the real end-to-end loopback).
//   * sc_psk_validate
//   * derive_session: same PSK + same nonce -> same key bytes.
//   * derive_session: same PSK + different nonce -> different keys.
//   * build_nonce: little-endian counter layout.
//   * frame round-trip: client makes a frame for "hello secure", server
//     opens it and recovers the same bytes.
//   * tamper detection: a single-byte flip in the ciphertext makes
//     _sc_test_open_frame return 0.
//   * counter advances after a successful send / recv.
//
// Convention: every assertion goes through ce_eq / ce_check / ce_str_eq.

import "../ce_test.nova"
import "../../src/safety/chacha20.nova"
import "../../src/io/transducers/secure_channel.nova"

// ---- helpers --------------------------------------------------------------

fn _ts_ascii_to_buf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    let r = list_new()
    push(r, buf)
    push(r, n)
    return r
}

// ---- PSK validation ------------------------------------------------------

fn test_psk_validate() {
    // Exactly 32 bytes (64 hex chars) -> valid.
    ce_eq("32-byte PSK accepts",
          sc_psk_validate("000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f"), 1)
    // Too short.
    ce_eq("16-byte PSK rejects",
          sc_psk_validate("000102030405060708090a0b0c0d0e0f"), 0)
    // Odd-length hex -> bad.
    ce_eq("odd-length hex PSK rejects", sc_psk_validate("abc"), 0)
}

// ---- session-key derivation ---------------------------------------------

fn test_derive_session_deterministic() {
    let a = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "deadbeef0000000000000001")
    let b = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "deadbeef0000000000000001")
    let ha = cc_hex_encode_buf(a[0], 32)
    let hb = cc_hex_encode_buf(b[0], 32)
    ce_str_eq("same PSK + same nonce -> same key", ha, hb)
}

fn test_derive_session_different_nonce_differs() {
    let a = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "deadbeef0000000000000001")
    let b = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "deadbeef0000000000000002")
    let ha = cc_hex_encode_buf(a[0], 32)
    let hb = cc_hex_encode_buf(b[0], 32)
    ce_check("different nonce -> different key", str_eq(ha, hb) == 0)
}

// ---- nonce builder layout ----------------------------------------------

fn test_build_nonce_layout() {
    // Prefix = deadbeef, counter = 1: nonce should be deadbeef0100000000000000
    let n = _sc_test_build_nonce("deadbeef", 1)
    ce_str_eq("nonce LE counter=1", cc_hex_encode_buf(n, 12),
              "deadbeef0100000000000000")
    // counter = 0x123:
    let n2 = _sc_test_build_nonce("deadbeef", 291)    // 0x123
    ce_str_eq("nonce LE counter=0x123", cc_hex_encode_buf(n2, 12),
              "deadbeef2301000000000000")
}

// ---- frame round trip --------------------------------------------------

fn test_frame_round_trip_hello() {
    let derived = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "deadbeef0000000000000001")
    let key = derived[0]
    let prefix = derived[1]
    let sender = _sc_test_state_with(key, prefix, 1, 1)
    let receiver = _sc_test_state_with(key, prefix, 1, 1)
    let pt = _ts_ascii_to_buf("hello secure")
    let frame = _sc_test_make_frame(sender, pt[0], pt[1])
    // Body length is 12 (nonce) + 12 (ct) + 16 (tag) = 40, total frame is
    // 4 (length header) + 40 = 44.
    ce_eq("frame total len = 44", frame[1], 44)
    let opened = _sc_test_open_frame(receiver, frame[0], frame[1])
    ce_check("frame opened (non-zero)", opened != 0)
    ce_eq("plaintext len recovered = 12", opened[1], 12)
    // Compare byte-by-byte: "hello secure".
    ce_eq("pt[0] == 'h'",  load8(opened[0] + 0),  104)
    ce_eq("pt[6] == 's'",  load8(opened[0] + 6),  115)
    ce_eq("pt[11] == 'e'", load8(opened[0] + 11), 101)
}

// ---- tamper detection --------------------------------------------------

fn test_frame_tamper_rejects() {
    let derived = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "deadbeef0000000000000001")
    let key = derived[0]
    let prefix = derived[1]
    let sender = _sc_test_state_with(key, prefix, 1, 1)
    let receiver = _sc_test_state_with(key, prefix, 1, 1)
    let pt = _ts_ascii_to_buf("hello secure")
    let frame = _sc_test_make_frame(sender, pt[0], pt[1])
    // Flip one bit in the first ciphertext byte (offset 4 + 12 = 16).
    let old = load8(frame[0] + 16)
    store8(frame[0] + 16, int_xor(old, 1))
    let bad = _sc_test_open_frame(receiver, frame[0], frame[1])
    ce_eq("tamper detected -> open returns 0", bad, 0)
    // Restore + confirm it now opens.
    store8(frame[0] + 16, old)
    let good = _sc_test_open_frame(receiver, frame[0], frame[1])
    ce_check("untampered opens", good != 0)
}

// ---- counter advances ---------------------------------------------------

fn test_counter_advances() {
    let derived = _sc_test_derive_session(
        "000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f",
        "cafef00d0000000000000001")
    let key = derived[0]
    let prefix = derived[1]
    let sender = _sc_test_state_with(key, prefix, 5, 5)
    let pt = _ts_ascii_to_buf("x")
    let frame = _sc_test_make_frame(sender, pt[0], pt[1])
    ce_eq("send counter advanced to 6", sender[SC_T_SCTR], 6)
}

fn main() {
    test_psk_validate()
    test_derive_session_deterministic()
    test_derive_session_different_nonce_differs()
    test_build_nonce_layout()
    test_frame_round_trip_hello()
    test_frame_tamper_rejects()
    test_counter_advances()
    ce_summary("secure_channel")
}

main()
