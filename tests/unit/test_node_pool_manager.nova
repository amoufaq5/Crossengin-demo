// Unit tests for src/substrate/node_pool_manager.nova
// Exercises the uniform node kernel: leaky integration, threshold firing,
// refractory reset, inhibition, novelty accumulation, capacity limits, and
// graceful handling of out-of-range ids. ADR-0006, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/node_pool_manager.nova"

fn test_fixed_point() {
    ce_eq("fp_mul 1.5*1.5", fp_mul(1500, 1500), 2250)
    ce_eq("fp_mul 2.0*3.0", fp_mul(2000, 3000), 6000)
    ce_eq("fp_clamp low", fp_clamp(-10, 0, 1000), 0)
    ce_eq("fp_clamp high", fp_clamp(5000, 0, 4000), 4000)
    ce_eq("fp_clamp mid", fp_clamp(700, 0, 4000), 700)
}

fn test_create_and_fire() {
    let pool = npm_pool_new(16)
    let id = npm_node_create_default(pool, NTYPE_KNOWER)
    ce_check("id non-negative", id >= 0)
    ce_check("node live", npm_node_is_live(pool, id) == 1)
    ce_eq("default threshold", npm_threshold(pool, id), 500)
    ce_eq("ntype stored", npm_ntype(pool, id), NTYPE_KNOWER)
    ce_eq("never fired", npm_last_fired(pool, id), -1)

    // Supra-threshold input fires this tick.
    npm_node_input(pool, id, 600)
    ce_eq("inbox loaded", npm_inbox(pool, id), 600)
    let fired = npm_node_integrate(pool, id, 7)
    ce_eq("fired", fired, 1)
    ce_eq("last_fired tick", npm_last_fired(pool, id), 7)
    ce_eq("fire count", npm_fires(pool, id), 1)
    ce_eq("refractory reset", npm_activation(pool, id), 0)
    ce_eq("inbox drained", npm_inbox(pool, id), 0)
    ce_check("novelty rose", npm_novelty(pool, id) > 0)
}

fn test_leaky_accumulation() {
    let pool = npm_pool_new(8)
    let id = npm_node_create_default(pool, NTYPE_REASONER)
    // Sub-threshold input does not fire but is retained (leaky).
    npm_node_input(pool, id, 300)
    ce_eq("no fire under threshold", npm_node_integrate(pool, id, 1), 0)
    ce_eq("activation retained", npm_activation(pool, id), 300)
    // 0.9*300 + 300 = 570 >= 500 -> fires on the second push.
    npm_node_input(pool, id, 300)
    ce_eq("fires after accumulation", npm_node_integrate(pool, id, 2), 1)
    ce_eq("activation reset after fire", npm_activation(pool, id), 0)
}

fn test_inhibition_vetoes_fire() {
    let pool = npm_pool_new(8)
    let id = npm_node_create_default(pool, NTYPE_FEELER)
    // Prime activation to 450 (below 0.5 threshold).
    npm_node_input(pool, id, 450)
    npm_node_integrate(pool, id, 1)
    ce_eq("primed activation", npm_activation(pool, id), 450)
    // Net input -100 (excite +200, inhibit -300): 0.9*450 - 100 = 305 < 500.
    npm_node_input(pool, id, 200)
    npm_node_input(pool, id, -300)
    ce_eq("inhibition net", npm_inbox(pool, id), -100)
    ce_eq("inhibited: no fire", npm_node_integrate(pool, id, 2), 0)
    ce_eq("suppressed activation", npm_activation(pool, id), 305)
}

fn test_capacity_limit() {
    let pool = npm_pool_new(3)
    let a = npm_node_create_default(pool, NTYPE_PERCEIVER)
    let b = npm_node_create_default(pool, NTYPE_PERCEIVER)
    let c = npm_node_create_default(pool, NTYPE_PERCEIVER)
    ce_eq("three live", npm_live_count(pool), 3)
    ce_eq("none available", npm_available(pool), 0)
    let overflow = npm_node_create_default(pool, NTYPE_PERCEIVER)
    ce_eq("create on full returns -1", overflow, -1)
}

fn test_bad_input_is_graceful() {
    let pool = npm_pool_new(4)
    let id = npm_node_create_default(pool, NTYPE_ACTOR)
    // Out-of-range reads/writes must not crash and must be inert.
    ce_eq("read out-of-range -> 0", npm_activation(pool, 999), 0)
    ce_eq("read negative -> 0", npm_get(pool, -1, NS_BIAS), 0)
    ce_eq("write out-of-range -> 0", npm_set(pool, 999, NS_BIAS, 100), 0)
    ce_eq("integrate out-of-range -> 0", npm_node_integrate(pool, 999, 1), 0)
    ce_eq("input out-of-range -> 0", npm_node_input(pool, -5, 100), 0)
    ce_check("valid node untouched", npm_node_is_live(pool, id) == 1)
}

fn test_reset_preserves_config() {
    let pool = npm_pool_new(4)
    let id = npm_node_create(pool, NTYPE_KNOWER, 700, 50)
    npm_node_input(pool, id, 900)
    npm_node_integrate(pool, id, 3)
    ce_check("fired before reset", npm_fires(pool, id) >= 1)
    npm_node_reset(pool, id)
    ce_eq("activation cleared", npm_activation(pool, id), 0)
    ce_eq("fires cleared", npm_fires(pool, id), 0)
    ce_eq("last_fired cleared", npm_last_fired(pool, id), -1)
    ce_eq("threshold preserved", npm_threshold(pool, id), 700)
    ce_eq("bias preserved", npm_bias(pool, id), 50)
}

fn main() {
    test_fixed_point()
    test_create_and_fire()
    test_leaky_accumulation()
    test_inhibition_vetoes_fire()
    test_capacity_limit()
    test_bad_input_is_graceful()
    test_reset_preserves_config()
    ce_summary("node_pool_manager")
}

main()
