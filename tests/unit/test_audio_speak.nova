// Unit tests for src/io/effectors/audio_speak.nova -- the PURE logic
// (NL_AND_COVERAGE C1; ADR-0058). The fork/exec speech path is integration-only;
// here we cover the security-critical shell-quoting (POSIX single-quote escaping,
// which is what stops command injection when text is handed to /bin/sh -c) and
// the capability probe.

import "../ce_test.nova"
import "../../src/io/effectors/audio_speak.nova"

fn test_shell_quote() {
    ce_str_eq("plain word wrapped in single quotes", _shell_quote_single("hello"), "'hello'")
    ce_str_eq("empty -> empty single-quote pair", _shell_quote_single(""), "''")
    // an embedded single quote becomes  '\''  (close, escaped quote, reopen):
    // "a'b" -> 'a'\''b'  (8 chars). Build the expected via chr to avoid any
    // source-escaping ambiguity.
    let esc = chr(39) + chr(92) + chr(39) + chr(39)        // '\''
    ce_str_eq("embedded quote escaped (injection-safe)", _shell_quote_single("a'b"), "'a" + esc + "b'")
    // no shell metacharacter can break out: the result always starts+ends with '
    let q = _shell_quote_single("$(rm -rf /); echo")
    ce_eq("quoted starts with single-quote", char_at(q, 0), 39)
    ce_eq("quoted ends with single-quote", char_at(q, len(q) - 1), 39)
}

fn test_modes_available() {
    // Always reports something (a space-separated list, or "synth-only").
    ce_check("modes string is non-empty", len(audio_modes_available()) > 0)
}

fn main() {
    test_shell_quote()
    test_modes_available()
    ce_summary("audio_speak")
}
main()
