// End-to-end: exercise the ingestion pipeline via the same primitives the
// chat's admin commands use, so we're confident the wiring works even
// though the chat REPL has an unrelated startup issue.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"
import "../../src/ingest/llm_extractor.nova"

fn _write_temp(name, content) {
    let path = "/tmp/_chatint_" + name
    write_file(path, content)
    return path
}

// Mirror the /ingest cerec path.
fn test_ingest_cerec_trusted_end_to_end() {
    let a = ing_agent_new()
    let path = _write_temp("full.cerec",
        "KG history\nSRC src:cerec:battle\n"
        + "ATOM hastings_1066 1 950\n"
        + "ATOM harold_died 1 800\n"
        + "IMP hastings_1066 harold_died EMPIRICAL\n"
        + "OBS hastings_1066 +1 1000\n"
        + "CITE src:cerec:battle src:paper:doi:example supports\n")
    let s = ing_agent_run(a, "cerec", path, "history", "src:cerec:battle", "", 0)
    ce_eq("1 ingested", ing_sum_ok(s), 1)
    ce_eq("queue empty", rq_size(ing_queue(a)), 0)
    // 2 KGs: history + citations
    ce_eq("2 KGs", kg_count(ing_kgreg(a)), 2)
}

// Mirror the /ingest_review + /ingest_approve path.
fn test_review_then_approve_end_to_end() {
    let a = ing_agent_new()
    let path = _write_temp("untrusted.cerec",
        "KG topic\nSRC src:web:demo\nATOM foo 1 800\nATOM bar 1 800\n")
    ing_agent_run(a, "cerec", path, "topic", "src:web:demo", "", 0)
    ce_eq("queued", rq_size(ing_queue(a)), 1)
    let e = rq_entries(ing_queue(a))[0]
    ce_eq("state pending", rq_state(e), RQ_PENDING)
    let code = rq_approve(ing_queue(a), rq_id(e), ing_kgreg(a), ing_mo(a))
    ce_eq("approve ok", code, RQ_APPROVE_OK)
    ce_eq("state ingested", rq_state(e), RQ_INGESTED)
    ce_eq("KG appeared", kg_count(ing_kgreg(a)), 1)
}

// Mirror the /ingest_deny path.
fn test_review_then_deny_end_to_end() {
    let a = ing_agent_new()
    let path = _write_temp("deny.cerec",
        "KG topic\nSRC src:web:dubious\nATOM x 1 800\n")
    ing_agent_run(a, "cerec", path, "topic", "src:web:dubious", "", 0)
    let e = rq_entries(ing_queue(a))[0]
    let ok = rq_deny(ing_queue(a), rq_id(e), "domain has retracted the source")
    ce_eq("denied", ok, 1)
    ce_eq("state denied", rq_state(e), RQ_DENIED)
    ce_eq("reason preserved", rq_reason(e), "domain has retracted the source")
    ce_eq("KG stays empty", kg_count(ing_kgreg(a)), 0)
}

// Mirror the /ingest_llm path.
fn test_llm_extract_end_to_end() {
    let a = ing_agent_new()
    let path = _write_temp("llm.cerec",
        "KG topic\nSRC src:pack:medical\n"
        + "ATOM aggressive_belief 1 950\n"
        + "ATOM inference 1 500\n"
        + "IMP aggressive_belief inference FORMAL\n")
    let s = llm_extract_ingest(path, ing_queue(a), "opus5", "run1", 0)
    ce_eq("1 record", llm_sum_records(s), 1)
    ce_eq("1 enqueued", llm_sum_enqueued(s), 1)
    ce_eq("1 belief downgraded", llm_sum_downgraded_bel(s), 1)
    ce_eq("1 imp downgraded", llm_sum_downgraded_imp(s), 1)
    let e = rq_entries(ing_queue(a))[0]
    let src = cur_source(rq_record(e))
    ce_check("src rewritten to LLM prefix",
        str_eq_bytes(src, "src:extractor:llm:opus5:run1") == 1)
}

// Same wiring, mixed batch.
fn test_multi_format_agent_reuse() {
    let a = ing_agent_new()
    ing_agent_trust_prefix(a, "src:csv:")
    let cerec_path = _write_temp("m.cerec", "KG a\nSRC src:cerec:x\nATOM x 1 500\n")
    let csv_path = _write_temp("m.csv", "k,v\nrow1,val1\nrow2,val2\n")
    let s1 = ing_agent_run(a, "cerec", cerec_path, "a", "src:cerec:x", "", 0)
    let s2 = ing_agent_run(a, "csv",   csv_path,   "b", "src:csv:t",   "", 0)
    ce_eq("cerec ok", ing_sum_ok(s1), 1)
    ce_eq("csv ok", ing_sum_ok(s2), 1)
    // Agent shares kgreg across runs.
    ce_check("kg count >= 2", kg_count(ing_kgreg(a)) >= 2)
}

fn main() {
    test_ingest_cerec_trusted_end_to_end()
    test_review_then_approve_end_to_end()
    test_review_then_deny_end_to_end()
    test_llm_extract_end_to_end()
    test_multi_format_agent_reuse()
    ce_summary("ingest_chat_integration")
}

main()
