// Unit tests for src/io/transducers/visual_perception.nova -- the PURE seam
// (NL_AND_COVERAGE C1; ADR-0058). Real image decoding is integration-only; here
// we cover the decoder registry (stub/pgm/png/jpeg), default selection, the
// name<->id mapping, and the fresh-result accessors.

import "../ce_test.nova"
import "../../src/io/transducers/visual_perception.nova"

fn test_seam_registry() {
    let s = vp_seam_new()
    ce_eq("builtins registered -> enabled", vp_seam_enabled(s), 1)
    ce_eq("pgm maps", vp_seam_decoder_id_for(s, "pgm"), VP_DECODER_PGM)
    ce_eq("png maps", vp_seam_decoder_id_for(s, "png"), VP_DECODER_PNG)
    ce_eq("jpeg maps", vp_seam_decoder_id_for(s, "jpeg"), VP_DECODER_JPEG)
    ce_eq("stub maps", vp_seam_decoder_id_for(s, "stub"), VP_DECODER_STUB)
    ce_eq("default decoder is pgm (env unset)", vp_seam_default_decoder(s), VP_DECODER_PGM)
    ce_str_eq("default decoder name", vp_seam_decoder_name(s), "pgm")
    vp_seam_set_default(s, VP_DECODER_PNG)
    ce_str_eq("after set_default(png)", vp_seam_decoder_name(s), "png")
    vp_register_decoder(s, "myimg", 77)
    ce_eq("custom decoder resolves", vp_seam_decoder_id_for(s, "myimg"), 77)
}

fn test_fresh_results() {
    let s = vp_seam_new()
    ce_eq("fresh: call count 0", vp_seam_call_count(s), 0)
    ce_eq("fresh: last confidence 0", vp_seam_last_confidence(s), 0)
    ce_str_eq("fresh: no error", vp_seam_last_error(s), "")
}

fn main() {
    test_seam_registry()
    test_fresh_results()
    ce_summary("visual_perception")
}
main()
