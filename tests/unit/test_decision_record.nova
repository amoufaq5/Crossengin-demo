// Unit tests for src/parts/reasoning/decision_record.nova: persisting debate /
// promotion / steelman adjudications to the ADR-0043 decision log as immutable,
// hash-chained DLK_DECISION entries (ADR-0089/0090/0092).

import "../ce_test.nova"
import "../../src/parts/reasoning/decision_record.nova"

fn _ds2(a, b) {
    let l = list_new()
    push(l, a) push(l, b)
    return l
}

fn test_record_decided_debate() {
    let log = dl_new()
    // one strong FOR argument, no opposition -> decided, not contested.
    let ds = list_new()
    push(ds, darg_new(7, 1, 800, 0, 0 - 1, 0 - 1))
    let tr = debate_trace_build(ds, 7)
    let seq = dlog_record_debate(log, tr, 1000)

    ce_eq("one entry", dl_count(log), 1)
    ce_eq("seq 0", seq, 0)
    let e = dl_get(log, 0)
    ce_eq("kind decision", dl_kind(e), DLK_DECISION)
    ce_eq("is decision", drec_is_decision(e), 1)
    ce_eq("subtype debate", drec_subtype(e), DREC_DEBATE)
    ce_eq("claim recorded", drec_claim(e), 7)
    ce_eq("confidence on scalar", drec_scalar(e), debate_trace_confidence(tr))
    ce_eq("not contested flag", drec_flag(e), 0)
    ce_eq("decided -> OK", dl_outcome(e), OUT_OK)
    ce_eq("trace has the arg", len(dl_trace(e)), 1)
    ce_eq("chain intact", dl_verify(log), 1)
}

fn test_record_contested_debate() {
    let log = dl_new()
    // FOR vs AGAINST, equal strictness -> mutual rebut -> contested (both UNDEC).
    let ds = _ds2(darg_new(3, 1, 500, 0, 0 - 1, 0 - 1),
                  darg_new(3, 0 - 1, 500, 0, 0 - 1, 0 - 1))
    let tr = debate_trace_build(ds, 3)
    dlog_record_debate(log, tr, 2000)
    let e = dl_get(log, 0)
    ce_eq("contested flag set", drec_flag(e), 1)
    ce_eq("contested -> VETOED", dl_outcome(e), OUT_VETOED)
    ce_eq("both args traced", len(dl_trace(e)), 2)
    ce_check("render mentions contested", _lic_contains(drec_render(log, 0), "CONTESTED") == 1)
}

fn test_record_promotion() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "vitamin_c_helps", 0)
    atom_set_evidence_grade(atom, GRADE_EMPIRICAL_WEAK)

    let log = dl_new()
    let s0 = dlog_record_promotion(log, atom, atom_id(atom), CAND_PROMOTED, 3000)
    let s1 = dlog_record_promotion(log, atom, atom_id(atom), CAND_QUARANTINED, 3100)

    let e0 = dl_get(log, s0)
    ce_eq("promotion subtype", drec_subtype(e0), DREC_PROMOTION)
    ce_eq("grade on scalar", drec_scalar(e0), GRADE_EMPIRICAL_WEAK)
    ce_eq("state on flag", drec_flag(e0), CAND_PROMOTED)
    ce_eq("promoted -> OK", dl_outcome(e0), OUT_OK)

    let e1 = dl_get(log, s1)
    ce_eq("quarantined state", drec_flag(e1), CAND_QUARANTINED)
    ce_eq("quarantined -> VETOED", dl_outcome(e1), OUT_VETOED)
    ce_eq("chain still intact", dl_verify(log), 1)
    ce_check("render shows grade+state", _lic_contains(drec_render(log, 0), "promoted") == 1)
}

fn test_record_steelman() {
    // Two clashing evidenced sides on a value-laden claim -> both survive as
    // preferred extensions -> contested steelman, two positions. (Synthetic
    // dargs: the construct-from-KG path is exercised by test_steelman.nova; this
    // test targets the recorder, not argument construction.)
    let ds = _ds2(darg_new(5, 1, 1000, 0, 0 - 1, 0 - 1),
                  darg_new(5, 0 - 1, 400, 0, 0 - 1, 0 - 1))
    let log = dl_new()
    dlog_record_steelman(log, ds, 5, 4000)
    let e = dl_get(log, 0)
    ce_eq("steelman subtype", drec_subtype(e), DREC_STEELMAN)
    ce_eq("two surviving positions", drec_scalar(e), 2)
    ce_eq("contested steelman flag", drec_flag(e), 1)
    ce_eq("contested -> VETOED", dl_outcome(e), OUT_VETOED)
    ce_eq("both premises traced", len(dl_trace(e)), 2)
    ce_eq("chain intact", dl_verify(log), 1)
    print(drec_render(log, 0))
}

// A mixed audit trail (debate -> promotion -> steelman) must form one valid
// hash chain, and a later field tamper must still be caught.
fn test_mixed_chain_and_tamper() {
    let log = dl_new()
    let ds = list_new()
    push(ds, darg_new(1, 1, 700, 0, 0 - 1, 0 - 1))
    dlog_record_debate(log, debate_trace_build(ds, 1), 10)

    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let atom = kg_add_atom(kg, ATOM_CONCEPT, "claim", 0)
    atom_set_evidence_grade(atom, GRADE_TESTIMONIAL)
    dlog_record_promotion(log, atom, atom_id(atom), CAND_PROMOTED, 20)

    ce_eq("three? no, two entries", dl_count(log), 2)
    ce_eq("mixed chain intact", dl_verify(log), 1)
    ce_check("kinds all decision",
        dl_kind(dl_get(log, 0)) == DLK_DECISION)
    // tamper: flip the recorded confidence of entry 0 without rehashing.
    list_set(dl_get(log, 0), E_PTIER, 999)
    ce_eq("tamper detected", dl_verify(log), 0)
}

fn main() {
    test_record_decided_debate()
    test_record_contested_debate()
    test_record_promotion()
    test_record_steelman()
    test_mixed_chain_and_tamper()
    ce_summary("decision_record")
}

main()
