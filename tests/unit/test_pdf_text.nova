// Unit tests for src/data/pdf_text.nova (P3, ADR-0053).
//
// Covers extracting visible text from PDF content-stream text objects: basic
// (...)Tj fragments, backslash + octal escapes, balanced nested parens, the
// BT/ET scoping (strings outside a text object are NOT text), FlateDecode
// detection, and the end-to-end PDF -> OpenIE triples path (the acceptance:
// a PDF ingests to provenanced triples).
//
// Backslashes are built with chr(92) so the test does not depend on NOVA
// source-string escaping.
//
// ADR-0053.

import "../ce_test.nova"
import "../../src/data/pdf_text.nova"
import "../../src/learning/openie.nova"

fn bs() { return chr(92) }   // a single backslash

fn _has(hay, needle) {
    let n = len(hay)
    let m = len(needle)
    if m == 0 { return 1 }
    let i = 0
    while i + m <= n {
        let k = 0
        let ok = 1
        while k < m {
            if char_at(hay, i + k) != char_at(needle, k) { ok = 0 k = m } else { k = k + 1 }
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn test_extract_basic() {
    let txt = pdf_extract_text("BT (Hello) Tj (World) Tj ET")
    ce_eq("first fragment", _has(txt, "Hello"), 1)
    ce_eq("second fragment", _has(txt, "World"), 1)
}

fn test_escapes() {
    // (a\(b\)c) -> a(b)c
    let pdf = "BT (a" + bs() + "(b" + bs() + ")c) Tj ET"
    ce_eq("escaped parens decoded", _has(pdf_extract_text(pdf), "a(b)c"), 1)
}

fn test_octal_escape() {
    // \101 = 'A', \102 = 'B'
    let pdf = "BT (" + bs() + "101" + bs() + "102) Tj ET"
    ce_eq("octal escapes decoded to AB", _has(pdf_extract_text(pdf), "AB"), 1)
}

fn test_nested_parens() {
    let txt = pdf_extract_text("BT (a (b) c) Tj ET")
    ce_eq("balanced nested parens preserved", _has(txt, "a (b) c"), 1)
}

fn test_only_within_bt_et() {
    // the (...) before BT is metadata, not shown text -> must be ignored.
    let txt = pdf_extract_text("(MetadataTitle) BT (RealText) Tj ET")
    ce_eq("text inside BT/ET extracted", _has(txt, "RealText"), 1)
    ce_eq("string outside BT/ET ignored", _has(txt, "MetadataTitle"), 0)
}

fn test_has_flate() {
    ce_eq("FlateDecode detected", pdf_has_flate("<< /Filter /FlateDecode >>"), 1)
    ce_eq("uncompressed -> no flate", pdf_has_flate("BT (x) Tj ET"), 0)
}

fn test_pdf_to_triples() {
    let pdf = "BT (Photosynthesis is a process. ) Tj (Plants absorb carbon dioxide from the air.) Tj ET"
    let txt = pdf_extract_text(pdf)
    let trips = openie_triples(txt)
    ce_check("PDF text yields provenanced triples", len(trips) >= 2)
}

// ---- FlateDecode routing + inflate ----------------------------------------

// A RAW DEFLATE *stored* block (BTYPE=00) wrapping `payload`. Needs no encoder:
// header byte 0b00000001 (BFINAL=1, BTYPE=00), then LEN/NLEN (LE, NLEN is the
// one's complement so LEN+NLEN==65535), then the literal payload bytes. This
// is exactly what deflate_decode.nova's stored path consumes, so we can build a
// genuine compressed-stream fixture and inflate it end to end.
fn _stored_deflate(payload) {
    let L = len(payload)
    let lo = L & 255
    let hi = L / 256
    let nlen = 65535 - L
    let nlo = nlen & 255
    let nhi = nlen / 256
    let s = chr(1) + chr(lo) + chr(hi) + chr(nlo) + chr(nhi)
    return s + payload
}

// Prepend a valid zlib header (CMF=0x78, FLG=0x9C: CM=8/deflate and
// (0x78*256+0x9C) % 31 == 0) so the auto-path must strip it before inflating.
fn _zlib_wrap(raw) {
    return chr(120) + chr(156) + raw    // 0x78, 0x9C
}

// A minimal FlateDecoded PDF: a content stream object whose body is the
// (raw or zlib-wrapped) deflate of a normal BT..ET text object.
fn _flate_pdf(stream_body) {
    let head = "1 0 obj << /Filter /FlateDecode /Length 99 >>\nstream\n"
    return head + stream_body + "\nendstream\nendobj"
}

fn test_auto_uncompressed_unchanged() {
    // No FlateDecode declared -> pdf_extract_text_auto == pdf_extract_text.
    let pdf = "BT (Hello) Tj (World) Tj ET"
    let a = pdf_extract_text_auto(pdf)
    let b = pdf_extract_text(pdf)
    ce_str_eq("auto path equals plain path when uncompressed", a, b)
    ce_eq("auto still extracts uncompressed text", _has(a, "Hello"), 1)
    ce_eq("auto still extracts second fragment", _has(a, "World"), 1)
}

fn test_auto_routing_decision() {
    // pdf_has_flate is the routing predicate the auto-path keys off.
    ce_eq("flate PDF is routed to inflate", pdf_has_flate(_flate_pdf("x")), 1)
    ce_eq("plain PDF is not routed", pdf_has_flate("BT (x) Tj ET"), 0)
}

fn test_auto_inflate_raw_deflate() {
    // Genuine end-to-end: a FlateDecoded stream (raw DEFLATE stored block)
    // inflates and its BT..ET text is extracted.
    let inner = "BT (InflatedText) Tj ET"
    let pdf = _flate_pdf(_stored_deflate(inner))
    let txt = pdf_extract_text_auto(pdf)
    ce_eq("inflated stream text extracted", _has(txt, "InflatedText"), 1)
}

fn test_auto_inflate_zlib_wrapped() {
    // Same, but the stream carries a zlib header that must be stripped first.
    let inner = "BT (ZlibWrapped) Tj ET"
    let pdf = _flate_pdf(_zlib_wrap(_stored_deflate(inner)))
    let txt = pdf_extract_text_auto(pdf)
    ce_eq("zlib-wrapped stream text extracted", _has(txt, "ZlibWrapped"), 1)
}

fn test_auto_inflate_to_triples() {
    // The acceptance shape: a compressed PDF -> inflate -> OpenIE triples.
    let inner = "BT (Plants absorb carbon dioxide from the air.) Tj ET"
    let pdf = _flate_pdf(_zlib_wrap(_stored_deflate(inner)))
    let txt = pdf_extract_text_auto(pdf)
    let trips = openie_triples(txt)
    ce_check("inflated PDF yields triples", len(trips) >= 1)
}

fn main() {
    test_extract_basic()
    test_escapes()
    test_octal_escape()
    test_nested_parens()
    test_only_within_bt_et()
    test_has_flate()
    test_pdf_to_triples()
    test_auto_uncompressed_unchanged()
    test_auto_routing_decision()
    test_auto_inflate_raw_deflate()
    test_auto_inflate_zlib_wrapped()
    test_auto_inflate_to_triples()
    ce_summary("pdf_text")
}

main()
