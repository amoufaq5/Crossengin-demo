// Unit tests for src/data/pdf_text.nova (P3, ADR-0053).
//
// Covers extracting visible text from PDF content-stream text objects: basic
// (...)Tj fragments, backslash + octal escapes, balanced nested parens, the
// BT/ET scoping (strings outside a text object are NOT text), FlateDecode
// detection, and the end-to-end PDF -> OpenIE triples path (the acceptance:
// a PDF ingests to provenanced triples).
//
// Backslashes are built with chr(92) so the test does not depend on NOVA
// source-string escaping.
//
// ADR-0053.

import "../ce_test.nova"
import "../../src/data/pdf_text.nova"
import "../../src/learning/openie.nova"

fn bs() { return chr(92) }   // a single backslash

fn _has(hay, needle) {
    let n = len(hay)
    let m = len(needle)
    if m == 0 { return 1 }
    let i = 0
    while i + m <= n {
        let k = 0
        let ok = 1
        while k < m {
            if char_at(hay, i + k) != char_at(needle, k) { ok = 0 k = m } else { k = k + 1 }
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn test_extract_basic() {
    let txt = pdf_extract_text("BT (Hello) Tj (World) Tj ET")
    ce_eq("first fragment", _has(txt, "Hello"), 1)
    ce_eq("second fragment", _has(txt, "World"), 1)
}

fn test_escapes() {
    // (a\(b\)c) -> a(b)c
    let pdf = "BT (a" + bs() + "(b" + bs() + ")c) Tj ET"
    ce_eq("escaped parens decoded", _has(pdf_extract_text(pdf), "a(b)c"), 1)
}

fn test_octal_escape() {
    // \101 = 'A', \102 = 'B'
    let pdf = "BT (" + bs() + "101" + bs() + "102) Tj ET"
    ce_eq("octal escapes decoded to AB", _has(pdf_extract_text(pdf), "AB"), 1)
}

fn test_nested_parens() {
    let txt = pdf_extract_text("BT (a (b) c) Tj ET")
    ce_eq("balanced nested parens preserved", _has(txt, "a (b) c"), 1)
}

fn test_only_within_bt_et() {
    // the (...) before BT is metadata, not shown text -> must be ignored.
    let txt = pdf_extract_text("(MetadataTitle) BT (RealText) Tj ET")
    ce_eq("text inside BT/ET extracted", _has(txt, "RealText"), 1)
    ce_eq("string outside BT/ET ignored", _has(txt, "MetadataTitle"), 0)
}

fn test_has_flate() {
    ce_eq("FlateDecode detected", pdf_has_flate("<< /Filter /FlateDecode >>"), 1)
    ce_eq("uncompressed -> no flate", pdf_has_flate("BT (x) Tj ET"), 0)
}

fn test_pdf_to_triples() {
    let pdf = "BT (Photosynthesis is a process. ) Tj (Plants absorb carbon dioxide from the air.) Tj ET"
    let txt = pdf_extract_text(pdf)
    let trips = openie_triples(txt)
    ce_check("PDF text yields provenanced triples", len(trips) >= 2)
}

fn main() {
    test_extract_basic()
    test_escapes()
    test_octal_escape()
    test_nested_parens()
    test_only_within_bt_et()
    test_has_flate()
    test_pdf_to_triples()
    ce_summary("pdf_text")
}

main()
