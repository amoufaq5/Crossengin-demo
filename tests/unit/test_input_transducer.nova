// Unit tests for src/io/transducers/input_transducer.nova
// Verifies reader-ready text normalization, percept records, and the honest
// deferred audio (STT) seam (ADR-0014, ADR-0011/0012, ADR-0021). No cognition.

import "../ce_test.nova"
import "../../src/io/transducers/input_transducer.nova"

fn test_text_normalization() {
    ce_str_eq("trim+lower", transduce_text("  Hello WORLD "), "hello world")
    ce_str_eq("multi spaces", transduce_text("foo     bar   baz"), "foo bar baz")
    ce_str_eq("leading/trailing", transduce_text("   one two   "), "one two")
    ce_str_eq("empty", transduce_text("   "), "")
}

fn test_percept_text() {
    let p = transduce(IN_TEXT, "Foo  BAR")
    ce_eq("modality text", percept_modality(p), IN_TEXT)
    ce_str_eq("normalized", percept_text(p), "foo bar")
    ce_eq("token count", percept_tokens(p), 2)
    ce_eq("has text", percept_has_text(p), 1)
}

fn test_file_modality() {
    ce_eq("file ready", transducer_ready(IN_FILE), 1)
    let p = transduce(IN_FILE, "  Line One  ")
    ce_str_eq("file normalized", percept_text(p), "line one")
    ce_eq("file tokens", percept_tokens(p), 2)
}

// Audio (STT) is the deferred bridge seam: not ready, and yields an empty
// percept (never a fabricated transcription).
fn test_audio_deferred() {
    ce_eq("audio not ready", transducer_ready(IN_AUDIO), 0)
    let p = transduce(IN_AUDIO, "spoken words here")
    ce_eq("audio modality kept", percept_modality(p), IN_AUDIO)
    ce_str_eq("audio empty", percept_text(p), "")
    ce_eq("audio no text", percept_has_text(p), 0)
}

fn test_names() {
    ce_str_eq("text name", in_modality_name(IN_TEXT), "text")
    ce_str_eq("audio name", in_modality_name(IN_AUDIO), "audio")
    ce_str_eq("file name", in_modality_name(IN_FILE), "file")
    ce_str_eq("unknown", in_modality_name(9), "unknown")
}

fn main() {
    test_text_normalization()
    test_percept_text()
    test_file_modality()
    test_audio_deferred()
    test_names()
    ce_summary("input_transducer")
}
main()
