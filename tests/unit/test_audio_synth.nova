// Unit tests for src/io/effectors/audio_synth.nova
//
// Verifies the Phase 19 Tier-4 #1 minimum-viable audio modality bridge:
// WAV header bytes, sine generation (peak / zero crossings / scale),
// per-phoneme duration, text-level concatenation, and the on-disk WAV write
// path (read back the first 4 bytes via sys_open + sys_read and check RIFF).
// All integer math; no LLM.

import "std/syscall"
import "../ce_test.nova"
import "../../src/io/effectors/audio_synth.nova"

// Helper since NOVA has no `abs`.
fn _abs(x) {
    if x < 0 { return 0 - x }
    return x
}

fn _sl3(a, b, c) {
    let l = list_new()
    push(l, a) push(l, b) push(l, c)
    return l
}

fn _zero_samples(n) {
    let l = list_new()
    let i = 0
    while i < n { push(l, 0); i = i + 1 }
    return l
}

// ---- WAV header -----------------------------------------------------------

fn test_wav_header_riff() {
    let h = wav_header(8000, 1000)
    ce_eq("header is 44 bytes", len(h), 44)
    ce_eq("byte 0 == 'R'", h[0], 82)
    ce_eq("byte 1 == 'I'", h[1], 73)
    ce_eq("byte 2 == 'F'", h[2], 70)
    ce_eq("byte 3 == 'F'", h[3], 70)
    // "WAVE" at 8..11
    ce_eq("byte 8 == 'W'",  h[8],  87)
    ce_eq("byte 9 == 'A'",  h[9],  65)
    ce_eq("byte 10 == 'V'", h[10], 86)
    ce_eq("byte 11 == 'E'", h[11], 69)
    // "data" -- the canonical PCM chunk marker at 36..39 (the header
    // ENDS with the data-chunk identifier, followed by its 4-byte size).
    ce_eq("byte 36 == 'd'", h[36], 100)
    ce_eq("byte 37 == 'a'", h[37], 97)
    ce_eq("byte 38 == 't'", h[38], 116)
    ce_eq("byte 39 == 'a'", h[39], 97)
}

fn test_wav_header_fields() {
    let h = wav_header(8000, 1000)
    // PCM format (1) at 20..21
    ce_eq("audio format = 1", h[20], 1)
    ce_eq("audio format hi byte = 0", h[21], 0)
    // n channels (1) at 22..23
    ce_eq("n channels = 1", h[22], 1)
    // sample rate LE at 24..27: 8000 = 0x1F40 -> 0x40,0x1F,0x00,0x00
    ce_eq("sample rate byte 0", h[24], 64)        // 0x40
    ce_eq("sample rate byte 1", h[25], 31)        // 0x1F
    ce_eq("sample rate byte 2", h[26], 0)
    ce_eq("sample rate byte 3", h[27], 0)
    // data size at 40..43 = 2000 = 0x07D0 -> 0xD0,0x07,0x00,0x00
    ce_eq("data size byte 0", h[40], 208)         // 0xD0
    ce_eq("data size byte 1", h[41], 7)
    ce_eq("data size byte 2", h[42], 0)
    ce_eq("data size byte 3", h[43], 0)
}

// ---- synth_sine -----------------------------------------------------------

fn test_synth_sine_count_and_shape() {
    let s = synth_sine(440, 8000, 8000)
    ce_eq("8000 samples", len(s), 8000)
    // Sine starts at 0 (phase 0).
    ce_check("first sample near zero", _abs(s[0]) <= 200)
    // Find max / min across the buffer; should be near +AUDIO_AMPLITUDE
    // (16000) and -AUDIO_AMPLITUDE respectively (within a Bhaskara tolerance).
    let mx = s[0]
    let mn = s[0]
    let i = 0
    while i < len(s) {
        if s[i] > mx { mx = s[i] }
        if s[i] < mn { mn = s[i] }
        i = i + 1
    }
    ce_check("max ~ +16000", mx >= 15500 && mx <= 16000)
    ce_check("min ~ -16000", mn <= 0 - 15500 && mn >= 0 - 16000)
}

fn test_synth_sine_zero_first_and_last() {
    // At 1 Hz sampled at 1000 samples / 1 sec, the wave completes one period
    // exactly, so first AND last samples are at 0 phase (both near zero).
    let s = synth_sine(1, 1000, 1000)
    ce_eq("1000 samples", len(s), 1000)
    ce_check("first sample near zero", _abs(s[0]) <= 200)
    ce_check("last sample near zero",  _abs(s[len(s) - 1]) <= 200)
}

fn test_synth_sine_silent_on_zero_count() {
    let s = synth_sine(440, 0, 8000)
    ce_eq("zero samples requested -> zero produced", len(s), 0)
}

// ---- synth_phoneme --------------------------------------------------------

fn test_synth_phoneme_duration() {
    let s = synth_phoneme("a")
    // 150ms at 8000Hz = 1200 samples (the AUDIO_PHONEME_SAMPLES invariant).
    ce_eq("a phoneme is 1200 samples", len(s), 1200)
    // Envelope: the first sample is at zero gain (ramped down to nothing).
    ce_eq("envelope zero at start", s[0], 0)
    // Mid-buffer should hit close to the carrier amplitude (the envelope is
    // 1.0 in the sustain region). Scan for the absolute peak.
    let mx = 0
    let i = 0
    while i < len(s) {
        let v = _abs(s[i])
        if v > mx { mx = v }
        i = i + 1
    }
    ce_check("envelope peak ~ 16000", mx >= 15500 && mx <= 16000)
}

fn test_synth_phoneme_unknown_fallback() {
    let s = synth_phoneme("xx-unknown-xx")
    ce_eq("unknown phoneme still 1200 samples", len(s), 1200)
}

fn test_synth_phoneme_fricative() {
    // Fricatives ('s') use a high carrier (3500 Hz) but the duration
    // invariant still holds.
    let s = synth_phoneme("s")
    ce_eq("fricative still 1200 samples", len(s), 1200)
}

// ---- synth_text -----------------------------------------------------------

fn test_synth_text_minimum_length() {
    // 5 fallback per-character phonemes -> 5 * 1200 = 6000 samples; brief
    // asks for at least 1500 ("5 phonemes worth").
    let s = synth_text("hello", 0)
    ce_check("hello samples >= 1500", len(s) >= 1500)
    ce_check("hello samples >= 6000",  len(s) >= 6000)
}

fn test_synth_text_multiword() {
    let s1 = synth_text("hello",       0)
    let s2 = synth_text("hello world", 0)
    ce_check("two words longer than one", len(s2) > len(s1))
}

fn test_synth_text_empty_input() {
    let s = synth_text("", 0)
    ce_eq("empty input -> no samples", len(s), 0)
}

fn test_synth_text_uses_lang_phonemes() {
    // When the language KG has phoneme atoms attached to a word, synth_text
    // emits one phoneme per registered phoneme atom -- proving the lang-KG
    // path is taken in preference to the per-character fallback.
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let w = word_atom_new(lang, "asp", 0)
    // 3 phonemes: a, s, p. Expect 3 * 1200 = 3600 samples (not 3 chars * 1200
    // via fallback -- they're the same here by coincidence, so we add a
    // length-mismatch check below).
    word_set_phonemes(lang, w, _sl3("a", "s", "p"), 0)
    let s = synth_text("asp", lang)
    ce_eq("three phonemes -> 3600 samples", len(s), 3600)
}

fn test_synth_text_lang_overrides_fallback_count() {
    // Same word with 5 recorded phonemes -> KG path wins -> 5 * 1200 = 6000,
    // not the 3-char fallback's 3 * 1200 = 3600. Distinguishes the two paths.
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let w = word_atom_new(lang, "asp", 0)
    let pl = list_new()
    push(pl, "a") push(pl, "e") push(pl, "i") push(pl, "o") push(pl, "u")
    word_set_phonemes(lang, w, pl, 0)
    let s = synth_text("asp", lang)
    ce_eq("five phonemes -> 6000 samples", len(s), 6000)
}

// ---- audio_write_wav ------------------------------------------------------

fn test_write_wav_returns_1() {
    let z = _zero_samples(3)
    let ok = audio_write_wav(z, "/tmp/ce_test_audio.wav")
    ce_eq("write_wav success", ok, 1)
}

fn test_write_wav_starts_with_RIFF() {
    let z = _zero_samples(3)
    audio_write_wav(z, "/tmp/ce_test_audio.wav")
    let fd = sys_open("/tmp/ce_test_audio.wav", O_RDONLY, 0)
    ce_check("file opens after write", fd >= 0)
    let buf = alloc(8)
    let n = sys_read(fd, buf, 4)
    sys_close(fd)
    ce_eq("read 4 bytes", n, 4)
    ce_eq("first byte 'R'", load8(buf),     82)
    ce_eq("byte 1 'I'",     load8(buf + 1), 73)
    ce_eq("byte 2 'F'",     load8(buf + 2), 70)
    ce_eq("byte 3 'F'",     load8(buf + 3), 70)
}

fn test_write_wav_size_includes_header() {
    // 10 samples -> 20 PCM bytes + 44 header = 64 bytes total.
    let z = _zero_samples(10)
    audio_write_wav(z, "/tmp/ce_test_audio.wav")
    let fd = sys_open("/tmp/ce_test_audio.wav", O_RDONLY, 0)
    ce_check("file opens", fd >= 0)
    let buf = alloc(128)
    let n = sys_read(fd, buf, 128)
    sys_close(fd)
    ce_eq("file is 64 bytes", n, 64)
}

// ---- main -----------------------------------------------------------------

fn main() {
    test_wav_header_riff()
    test_wav_header_fields()
    test_synth_sine_count_and_shape()
    test_synth_sine_zero_first_and_last()
    test_synth_sine_silent_on_zero_count()
    test_synth_phoneme_duration()
    test_synth_phoneme_unknown_fallback()
    test_synth_phoneme_fricative()
    test_synth_text_minimum_length()
    test_synth_text_multiword()
    test_synth_text_empty_input()
    test_synth_text_uses_lang_phonemes()
    test_synth_text_lang_overrides_fallback_count()
    test_write_wav_returns_1()
    test_write_wav_starts_with_RIFF()
    test_write_wav_size_includes_header()
    ce_summary("audio_synth")
}

main()
