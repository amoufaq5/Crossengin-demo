// Unit tests for the TLS module scaffold
// (R86, ADR r86-in-process-tls-scaffolding).
//
// Smoke tests that every module under src/net/tls/ loads, its structs
// construct, its stubs return the correct TLS_NOT_IMPLEMENTED sentinel,
// and its enums are internally consistent. This is the "scaffold works"
// check that R87..R9X will incrementally replace with real functional
// tests as the primitives land.

import "../ce_test.nova"
import "../../src/net/tls/tls_config.nova"
import "../../src/net/tls/tls_record.nova"
import "../../src/net/tls/tls_handshake.nova"
import "../../src/net/tls/tls_wire_hook.nova"
import "../../src/util/str_safe.nova"

// ---- tls_config ---------------------------------------------------------

fn test_config_empty() {
    let c = tls_config_new_empty()
    ce_eq("empty cert len",         len(tls_config_cert_der(c)), 0)
    ce_eq("empty key len",          len(tls_config_key_der(c)),  0)
    ce_eq("has_material = 0",       tls_config_has_material(c),  0)
    ce_eq("default cache size",     tls_config_cache_size(c),    TLS_DEFAULT_SESSION_CACHE_SIZE)
    let prefs = tls_config_cipher_pref(c)
    ce_eq("default cipher pref len", len(prefs), 1)
    ce_eq("default cipher = CHACHA20_POLY1305_SHA256",
          prefs[0], TLS_CIPHER_CHACHA20_POLY1305_SHA256)
}

fn test_config_with_material() {
    let c = tls_config_new_from_material("fake_cert_bytes", "fake_key_bytes__________________")
    ce_check("cert set",     len(tls_config_cert_der(c)) > 0)
    ce_check("key set",      len(tls_config_key_der(c))  > 0)
    ce_eq("has_material = 1", tls_config_has_material(c), 1)
}

fn test_config_add_cipher_dedupes() {
    let c = tls_config_new_empty()
    ce_eq("add AES128 -> new",   tls_config_add_cipher(c, TLS_CIPHER_AES_128_GCM_SHA256), 1)
    ce_eq("add AES128 -> dupe",  tls_config_add_cipher(c, TLS_CIPHER_AES_128_GCM_SHA256), 0)
    let prefs = tls_config_cipher_pref(c)
    ce_eq("prefs len = 2 (chacha + aes128)", len(prefs), 2)
}

fn test_cipher_name_lookup() {
    ce_str_eq("chacha name", tls_cipher_name(TLS_CIPHER_CHACHA20_POLY1305_SHA256), "TLS_CHACHA20_POLY1305_SHA256")
    ce_str_eq("aes128 name", tls_cipher_name(TLS_CIPHER_AES_128_GCM_SHA256),       "TLS_AES_128_GCM_SHA256")
    ce_str_eq("aes256 name", tls_cipher_name(TLS_CIPHER_AES_256_GCM_SHA384),       "TLS_AES_256_GCM_SHA384")
    let unk = tls_cipher_name(9999)
    ce_check("unknown stringifies", find_bytes(unk, "9999") >= 0)
}

// ---- tls_record ---------------------------------------------------------

fn test_record_content_type_constants() {
    ce_eq("alert code",            TLS_CONTENT_ALERT,            21)
    ce_eq("handshake code",        TLS_CONTENT_HANDSHAKE,        22)
    ce_eq("application_data code", TLS_CONTENT_APPLICATION_DATA, 23)
    ce_eq("cchange_cipher_spec",   TLS_CONTENT_CHANGE_CIPHER_SPEC, 20)
}

fn test_record_header_round_trip() {
    let h = tls_record_header_new(TLS_CONTENT_HANDSHAKE, 1234)
    ce_eq("type",   tls_record_header_type(h),   TLS_CONTENT_HANDSHAKE)
    ce_eq("ver_hi", tls_record_header_ver_hi(h), TLS_RECORD_LEGACY_VERSION_HI)
    ce_eq("ver_lo", tls_record_header_ver_lo(h), TLS_RECORD_LEGACY_VERSION_LO)
    ce_eq("length", tls_record_header_length(h), 1234)

    let pair = tls_record_header_bytes_buf(h)
    let buf  = pair[TLS_RECORD_BUF_PTR]
    let n    = pair[TLS_RECORD_BUF_LEN]
    ce_eq("header length = 5", n, TLS_RECORD_HEADER_LEN)
    ce_eq("byte 0 = type",     load8(buf + 0), TLS_CONTENT_HANDSHAKE)
    ce_eq("byte 1 = ver_hi",   load8(buf + 1), 3)
    ce_eq("byte 2 = ver_lo",   load8(buf + 2), 3)
    // 1234 = 0x04D2 -> hi=4, lo=210
    ce_eq("byte 3 = len hi",   load8(buf + 3), 4)
    ce_eq("byte 4 = len lo",   load8(buf + 4), 210)

    let p = tls_record_header_parse_buf(buf, n)
    ce_check("parsed",         p != 0)
    ce_eq("parsed type",       tls_record_header_type(p),   TLS_CONTENT_HANDSHAKE)
    ce_eq("parsed length",     tls_record_header_length(p), 1234)
}

fn test_record_header_parse_rejects() {
    let buf = alloc(TLS_RECORD_HEADER_LEN)
    store8(buf + 0, 99)  // unknown content type
    store8(buf + 1, 3)
    store8(buf + 2, 3)
    store8(buf + 3, 0)
    store8(buf + 4, 5)
    ce_eq("short parse -> 0",     tls_record_header_parse_buf(buf, 3), 0)
    ce_eq("unknown content -> 0", tls_record_header_parse_buf(buf, TLS_RECORD_HEADER_LEN), 0)
}

fn test_record_content_name() {
    ce_str_eq("name alert",     tls_record_content_name(TLS_CONTENT_ALERT),     "alert")
    ce_str_eq("name handshake", tls_record_content_name(TLS_CONTENT_HANDSHAKE), "handshake")
    ce_str_eq("name app_data",  tls_record_content_name(TLS_CONTENT_APPLICATION_DATA), "application_data")
    ce_str_eq("name invalid",   tls_record_content_name(TLS_CONTENT_INVALID),   "invalid")
}

fn test_record_wrap_unwrap_are_stubs() {
    // Body-layer AEAD is R94; R86 returns the sentinel.
    ce_str_eq("wrap stub",   tls_record_wrap(TLS_CONTENT_APPLICATION_DATA, "hi", 0), TLS_NOT_IMPLEMENTED)
    ce_str_eq("unwrap stub", tls_record_unwrap("some bytes", 0),                     TLS_NOT_IMPLEMENTED)
}

// ---- tls_handshake ------------------------------------------------------

fn test_handshake_type_constants() {
    ce_eq("client_hello",        TLS_HS_CLIENT_HELLO,         1)
    ce_eq("server_hello",        TLS_HS_SERVER_HELLO,         2)
    ce_eq("encrypted_extensions", TLS_HS_ENCRYPTED_EXTENSIONS, 8)
    ce_eq("certificate",         TLS_HS_CERTIFICATE,          11)
    ce_eq("certificate_verify",  TLS_HS_CERTIFICATE_VERIFY,   15)
    ce_eq("finished",            TLS_HS_FINISHED,             20)
    ce_eq("key_update",          TLS_HS_KEY_UPDATE,           24)
}

fn test_handshake_type_known() {
    ce_eq("client_hello known", tls_handshake_type_known(TLS_HS_CLIENT_HELLO), 1)
    ce_eq("finished known",     tls_handshake_type_known(TLS_HS_FINISHED),     1)
    ce_eq("42 not known",       tls_handshake_type_known(42),                  0)
}

fn test_handshake_type_name() {
    ce_str_eq("client_hello name", tls_handshake_type_name(TLS_HS_CLIENT_HELLO), "client_hello")
    ce_str_eq("server_hello name", tls_handshake_type_name(TLS_HS_SERVER_HELLO), "server_hello")
    ce_str_eq("finished name",     tls_handshake_type_name(TLS_HS_FINISHED),     "finished")
    let unk = tls_handshake_type_name(99)
    ce_check("unknown handshake stringifies", find_bytes(unk, "99") >= 0)
}

// R93 replaced the R86 stubs with concrete parse / serialize routines.
// The scaffold retains a shape check: the four-byte header wrapper
// (hs_wrap_header) round-trips through hs_parse_header without loss.
fn test_handshake_wire_header_round_trip() {
    let body = list_new()
    push(body, 1)
    push(body, 2)
    push(body, 3)
    let msg = hs_wrap_header(TLS_HS_FINISHED, body)
    ce_eq("wire len = 4 + body", len(msg), 7)
    ce_eq("type byte",     msg[0], TLS_HS_FINISHED)
    ce_eq("len hi",        msg[1], 0)
    ce_eq("len mid",       msg[2], 0)
    ce_eq("len lo",        msg[3], 3)
    let t = list_new(); push(t, 0)
    let l = list_new(); push(l, 0)
    ce_eq("header parses",  hs_parse_header(msg, 0, t, l), 1)
    ce_eq("parsed type",    t[0], TLS_HS_FINISHED)
    ce_eq("parsed length",  l[0], 3)
}

// ---- tls_wire_hook ------------------------------------------------------

fn test_wire_hook_null_config_passthrough() {
    // R94 signature: wire_connection_wrap(fd, tls_config, rng_ctx,
    // out_conn) -> ok. tls_config == 0 returns a RAW-tag null-op conn
    // that stores the fd unchanged; wire_conn_fd(conn) reports it
    // byte-identical to what was passed in. R86 back-compat -- the
    // pre-TLS wire path stays available for callers that never wire a
    // tls_config.
    let out = list_new()
    ce_eq("null cfg wrap ok",
          wire_connection_wrap(42, 0, 0, out), 1)
    ce_eq("stored fd matches",     wire_conn_fd(out), 42)
    ce_eq("null cfg tag = RAW",    wire_conn_tag(out), TLS_WIRE_CONN_TAG_RAW)
    ce_eq("null cfg established",  wire_conn_is_established(out), 1)
    let out2 = list_new()
    ce_eq("negative fd wrap ok",
          wire_connection_wrap(0 - 1, 0, 0, out2), 1)
    ce_eq("negative fd stored",    wire_conn_fd(out2), 0 - 1)
}

fn test_wire_hook_tag_helper_backcompat() {
    // wire_conn_tag(0) reports RAW so the R86 sentinel usage keeps
    // working while callers migrate to explicit wire_conn structs.
    ce_eq("null handle -> RAW", wire_conn_tag(0), TLS_WIRE_CONN_TAG_RAW)
}

fn main() {
    test_config_empty()
    test_config_with_material()
    test_config_add_cipher_dedupes()
    test_cipher_name_lookup()
    test_record_content_type_constants()
    test_record_header_round_trip()
    test_record_header_parse_rejects()
    test_record_content_name()
    test_record_wrap_unwrap_are_stubs()
    test_handshake_type_constants()
    test_handshake_type_known()
    test_handshake_type_name()
    test_handshake_wire_header_round_trip()
    test_wire_hook_null_config_passthrough()
    test_wire_hook_tag_helper_backcompat()
    ce_summary("tls_scaffold")
}

main()
