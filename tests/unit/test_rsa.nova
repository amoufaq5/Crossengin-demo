// Unit tests for src/safety/rsa.nova -- RSA-2048 PKCS#1 v1.5 + PSS (SHA-256)
// verification, pinned to signatures produced by openssl over a known message:
//   msg = "CrossEngin TLS verify test vector"
//   openssl genrsa 2048; dgst -sha256 -sign (PKCS#1) and -sigopt
//   rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32 (PSS). Both "Verified OK".

import "../ce_test.nova"
import "../../src/safety/rsa.nova"

fn _hxv(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70  { return c - 55 } }
    return 0
}
fn hexbuf(s) {
    let n = len(s) / 2
    let buf = alloc(n + 1)
    let k = 0
    while k < n { store8(buf + k, _hxv(char_at(s, k * 2)) * 16 + _hxv(char_at(s, k * 2 + 1))) k = k + 1 }
    return buf
}
fn strbuf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, char_at(s, i)) i = i + 1 }
    return buf
}

let MOD = ""
let SIG_PKCS1 = ""
let SIG_PSS = ""

fn test_rsa_verify() {
    let pk = rsa_pubkey_from_hex(MOD, 65537)
    let msg = strbuf("CrossEngin TLS verify test vector")
    let mhash = sha256_oneshot(msg, len("CrossEngin TLS verify test vector"))

    let sp = hexbuf(SIG_PKCS1)
    ce_eq("pkcs1 v1.5 verifies", rsa_pkcs1_sha256_verify(rsa_pk_n(pk), rsa_pk_e(pk), mhash, sp, 256), 1)

    let ss = hexbuf(SIG_PSS)
    ce_eq("pss verifies", rsa_pss_sha256_verify(rsa_pk_n(pk), rsa_pk_e(pk), mhash, ss, 256), 1)

    // Tamper the signature -> both must reject.
    store8(sp + 200, int_xor(load8(sp + 200), 1))
    ce_eq("pkcs1 rejects tampered sig", rsa_pkcs1_sha256_verify(rsa_pk_n(pk), rsa_pk_e(pk), mhash, sp, 256), 0)
    store8(ss + 100, int_xor(load8(ss + 100), 1))
    ce_eq("pss rejects tampered sig", rsa_pss_sha256_verify(rsa_pk_n(pk), rsa_pk_e(pk), mhash, ss, 256), 0)

    // Wrong message hash -> reject.
    let wrong = sha256_oneshot(strbuf("different message"), len("different message"))
    let sp2 = hexbuf(SIG_PKCS1)
    ce_eq("pkcs1 rejects wrong hash", rsa_pkcs1_sha256_verify(rsa_pk_n(pk), rsa_pk_e(pk), wrong, sp2, 256), 0)
}

fn main() {
    test_rsa_verify()
    ce_summary("rsa")
}

main()
