// Unit tests for src/parts/reasoning/multi_kg_consistency.nova:
// cross-KG empirical-belief conflict detection.

import "../ce_test.nova"
import "../../src/parts/reasoning/multi_kg_consistency.nova"

fn _mk_reg() {
    let reg = kg_registry_new()
    let physics = kg_spawn(reg, "physics")
    let folk = kg_spawn(reg, "folk")
    let b = list_new()
    push(b, reg) push(b, physics) push(b, folk)
    return b
}

// Uniform prior everywhere -> no atoms exceed the threshold.
fn test_empty_registry_consistent() {
    let reg = kg_registry_new()
    ce_eq("empty reg has no conflicts",
        len(mkgc_scan_conflicts(reg, MKGC_DEFAULT_SPREAD)), 0)
    ce_eq("empty reg is_consistent", mkgc_is_consistent(reg, 500), 1)
}

// Same-labeled atoms in two KGs with strongly opposed beliefs -> conflict.
fn test_direct_belief_split() {
    let b = _mk_reg()
    let reg = b[0]
    let physics = b[1]
    let folk = b[2]
    let a_p = kg_add_atom(physics, ATOM_CONCEPT, "electron_charge", 0)
    let a_f = kg_add_atom(folk,    ATOM_CONCEPT, "electron_charge", 0)
    // Physics: strongly believes (many + observations).
    let i = 0
    while i < 20 { bel_observe(atom_belief(a_p), 1) i = i + 1 }
    // Folk: strongly disbelieves.
    let j = 0
    while j < 20 { bel_observe(atom_belief(a_f), 0 - 1) j = j + 1 }
    // Confirm the split is real before scanning.
    let mp = atom_confidence(a_p)
    let mf = atom_confidence(a_f)
    ce_check("physics believes strongly", mp > 900)
    ce_check("folk disbelieves strongly", mf < 100)
    // Scan finds the conflict.
    let conflicts = mkgc_scan_conflicts(reg, MKGC_DEFAULT_SPREAD)
    ce_eq("one conflict", len(conflicts), 1)
    ce_eq("label matches", char_at(mkgc_conflict_label(conflicts[0]), 0), 101) // 'e'
    // Threshold hasn't been crossed for a lower value -- but here spread is
    // huge, so it's above whatever reasonable threshold.
    ce_check("spread over default", mp - mf > MKGC_DEFAULT_SPREAD)
}

// Same-labeled atoms with matching beliefs -> no conflict.
fn test_matched_belief_no_conflict() {
    let b = _mk_reg()
    let reg = b[0]
    let physics = b[1]
    let folk = b[2]
    let a_p = kg_add_atom(physics, ATOM_CONCEPT, "gravity", 0)
    let a_f = kg_add_atom(folk,    ATOM_CONCEPT, "gravity", 0)
    let i = 0
    while i < 10 { bel_observe(atom_belief(a_p), 1) bel_observe(atom_belief(a_f), 1) i = i + 1 }
    // Both should have similar high means.
    ce_check("physics believes", atom_confidence(a_p) > 800)
    ce_check("folk believes", atom_confidence(a_f) > 800)
    ce_eq("no conflicts",
        len(mkgc_scan_conflicts(reg, MKGC_DEFAULT_SPREAD)), 0)
}

// Different labels -> no conflict, even if beliefs oppose.
fn test_different_labels_no_conflict() {
    let b = _mk_reg()
    let reg = b[0]
    let physics = b[1]
    let folk = b[2]
    let a_p = kg_add_atom(physics, ATOM_CONCEPT, "quark", 0)
    let a_f = kg_add_atom(folk,    ATOM_CONCEPT, "leprechaun", 0)
    let i = 0
    while i < 20 { bel_observe(atom_belief(a_p), 1) i = i + 1 }
    let j = 0
    while j < 20 { bel_observe(atom_belief(a_f), 0 - 1) j = j + 1 }
    ce_eq("labels differ -> no conflict",
        len(mkgc_scan_conflicts(reg, MKGC_DEFAULT_SPREAD)), 0)
}

// Small belief drift under threshold -> no conflict.
fn test_small_drift_under_threshold() {
    let b = _mk_reg()
    let reg = b[0]
    let physics = b[1]
    let folk = b[2]
    let a_p = kg_add_atom(physics, ATOM_CONCEPT, "warm", 0)
    let a_f = kg_add_atom(folk,    ATOM_CONCEPT, "warm", 0)
    // Both mostly agree; small evidence.
    bel_observe(atom_belief(a_p), 1)
    bel_observe(atom_belief(a_p), 1)
    bel_observe(atom_belief(a_f), 1)
    let mp = atom_confidence(a_p)
    let mf = atom_confidence(a_f)
    let spread = mp - mf
    if spread < 0 { spread = 0 - spread }
    // Confirm it IS a small spread that stays under the default 500 threshold.
    ce_check("small spread", spread < MKGC_DEFAULT_SPREAD)
    ce_eq("small drift -> no conflict",
        len(mkgc_scan_conflicts(reg, MKGC_DEFAULT_SPREAD)), 0)
}

// Threshold parameter honored: tight threshold catches drift the default misses.
fn test_threshold_parameterized() {
    let b = _mk_reg()
    let reg = b[0]
    let physics = b[1]
    let folk = b[2]
    let a_p = kg_add_atom(physics, ATOM_CONCEPT, "topic", 0)
    let a_f = kg_add_atom(folk,    ATOM_CONCEPT, "topic", 0)
    // Very light opposing evidence -- 1 obs each side; spread ~333 milli,
    // below default 500 but above tight threshold 100.
    bel_observe(atom_belief(a_p), 1)
    bel_observe(atom_belief(a_f), 0 - 1)
    ce_eq("default threshold -> no conflict",
        len(mkgc_scan_conflicts(reg, MKGC_DEFAULT_SPREAD)), 0)
    ce_eq("tight threshold catches it",
        len(mkgc_scan_conflicts(reg, 100)), 1)
}

fn main() {
    test_empty_registry_consistent()
    test_direct_belief_split()
    test_matched_belief_no_conflict()
    test_different_labels_no_conflict()
    test_small_drift_under_threshold()
    test_threshold_parameterized()
    ce_summary("multi_kg_consistency")
}

main()
