// Unit tests for src/nl/nl_intent_classifier.nova (R98, Phase C part 3).
//
// Verifies the HDC prototype-vector intent classifier:
//   * corpus parses to N prototypes (== count of KIND blocks).
//   * training-corpus utterance -> that KIND (self-similarity high).
//   * paraphrase (novel vocabulary) -> the intended KIND with a
//     slot-filled arg.
//   * threshold behavior: 10000 bp -> almost every classify misses;
//     0 bp -> almost every classify hits (may misclassify).
//   * slot fill: RESEARCH topic strips "tell me about"; RELATE splits
//     on "and"; SKILL_RUN splits on "on".
//   * validator: slot-fill that would produce an SQ_ERR_EMPTY_ARG
//     falls through to unparsed.
//   * metric counters: hit / miss / attempt increment correctly.
//   * determinism: same corpus -> same prototype vectors.

import "../ce_test.nova"
import "../../src/nl/nl_intent_classifier.nova"
import "../../src/nl/nl_metrics.nova"
import "../../src/nl/query_shape.nova"
import "../../src/util/str_safe.nova"
import "../../src/kg/hdc_embed.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

// ---- init + registry ---------------------------------------------------

fn test_init_ten_prototypes() {
    let reg = nl_ic_init()
    ce_check("registry non-null", reg != 0)
    // 10 kinds embedded (research/relate/contradict_scan/is_a/retract/
    //   capsule_install/skill_install/capsule_list/skill_list/skill_run).
    ce_eq("proto count 10", nl_ic_prototype_count(), 10)
}

fn test_init_idempotent() {
    let r1 = nl_ic_init()
    let r2 = nl_ic_init()
    ce_eq("same registry object", r1, r2)
    ce_eq("still 10 protos", nl_ic_prototype_count(), 10)
}

// ---- self-similarity: a training utterance classifies to its kind ----

fn test_training_utterance_research_hits() {
    let m = nl_metrics_new()
    // "tell me about the cell cycle" -- a training-corpus utterance.
    // Bundles a comparatively rich set of tokens against the RESEARCH
    // prototype and scores well above threshold.
    let out = nl_ic_try_classify("tell me about the cell cycle", m, "")
    ce_eq("ok",         nl_ic_result_ok(out), 1)
    ce_eq("kind=research", sq_kind(nl_ic_result_sq(out)), NLK_RESEARCH)
    ce_check("similarity above threshold",
              nl_ic_result_similarity(out) >= nl_ic_threshold_bp())
}

fn test_training_utterance_relate_hits() {
    let m = nl_metrics_new()
    // "compare python and rust" -- training utterance with dense
    // token overlap against the RELATE prototype.
    let out = nl_ic_try_classify("compare python and rust", m, "")
    ce_eq("ok",         nl_ic_result_ok(out), 1)
    ce_eq("kind=relate", sq_kind(nl_ic_result_sq(out)), NLK_RELATE)
}

fn test_training_utterance_skill_run_hits() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify("run echo on hello world", m, "")
    ce_eq("ok",           nl_ic_result_ok(out), 1)
    ce_eq("kind=skill_run", sq_kind(nl_ic_result_sq(out)), NLK_SKILL_RUN)
}

fn test_training_capsule_list_hits() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify("show all capsules", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("kind=capsule_list", sq_kind(nl_ic_result_sq(out)),
                                NLK_CAPSULE_LIST)
}

// ---- paraphrase (novel vocab overlap with training) -------------------

fn test_paraphrase_research_mitochondria() {
    let m = nl_metrics_new()
    // "give me the details on mitochondria" -- token overlap with
    // "details on", "give me info on", so should classify as RESEARCH.
    let out = nl_ic_try_classify(
        "give me the details on mitochondria", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("kind=research", sq_kind(nl_ic_result_sq(out)), NLK_RESEARCH)
    let topic = sq_research_topic(nl_ic_result_sq(out))
    ce_check("topic contains mitochondria",
              _has(topic, "mitochondria"))
}

fn test_paraphrase_is_a_with_leading_article() {
    let m = nl_metrics_new()
    // "is a whale a mammal" -- IS_A with a leading article. Slot fill
    // must skip the leading "a" and split on the SECOND "a".
    let out = nl_ic_try_classify("is a whale a mammal", m, "")
    ce_eq("ok",     nl_ic_result_ok(out), 1)
    ce_eq("kind=is_a", sq_kind(nl_ic_result_sq(out)), NLK_IS_A)
    let x = sq_is_a_x(nl_ic_result_sq(out))
    let y = sq_is_a_y(nl_ic_result_sq(out))
    ce_check("X mentions whale", _has(x, "whale"))
    ce_check("Y mentions mammal", _has(y, "mammal"))
}

// ---- threshold behavior ----------------------------------------------

fn test_threshold_default_is_3500_bp() {
    // Unset env -- default is 3500 bp (chosen so on-topic paraphrases
    // hit while two-word non-sense inputs miss).
    ce_eq("threshold_bp = 3500", nl_ic_threshold_bp(), 3500)
}

fn test_off_topic_misses() {
    let m = nl_metrics_new()
    // A clearly-off input -- no tokens overlap with any prototype.
    let out = nl_ic_try_classify("floof floof glorpity", m, "")
    ce_eq("miss",         nl_ic_result_ok(out), 0)
    ce_eq("kind=unparsed", sq_kind(nl_ic_result_sq(out)), NLK_UNPARSED)
}

fn test_high_confidence_hit() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify("install capsule biology", m, "")
    ce_eq("hits at default", nl_ic_result_ok(out), 1)
    ce_eq("kind=capsule_install",
        sq_kind(nl_ic_result_sq(out)), NLK_CAPSULE_INSTALL)
    // Similarity for a training utterance's kind should clear
    // the threshold with room to spare (typically ~5000 bp).
    ce_check("similarity clears threshold",
        nl_ic_result_similarity(out) >= nl_ic_threshold_bp())
}

// ---- slot fill --------------------------------------------------------

fn test_slot_fill_research_strips_preamble() {
    let m = nl_metrics_new()
    // "tell me about the cell cycle" -- a training utterance that
    // scores above threshold. Slot fill must drop "tell", "me",
    // "about" (all in the RESEARCH signal-words list) so the
    // recovered topic is the noun-phrase remainder.
    let out = nl_ic_try_classify("tell me about the cell cycle", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("kind=research", sq_kind(nl_ic_result_sq(out)), NLK_RESEARCH)
    let topic = sq_research_topic(nl_ic_result_sq(out))
    // Signal words stripped; topic mentions "cell" and "cycle".
    ce_check("topic mentions cell",  _has(topic, "cell"))
    ce_check("topic mentions cycle", _has(topic, "cycle"))
    ce_check("topic drops 'tell'",   find_bytes(topic, "tell") < 0)
    ce_check("topic drops 'about'",  find_bytes(topic, "about") < 0)
}

fn test_slot_fill_relate_splits_on_and() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify(
        "compare python and rust", m, "")
    ce_eq("ok",     nl_ic_result_ok(out), 1)
    ce_eq("kind=relate", sq_kind(nl_ic_result_sq(out)), NLK_RELATE)
    let a = sq_relate_a(nl_ic_result_sq(out))
    let b = sq_relate_b(nl_ic_result_sq(out))
    ce_check("a==python", _has(a, "python"))
    ce_check("b==rust",   _has(b, "rust"))
}

fn test_slot_fill_skill_run_splits_on_on() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify(
        "run echo on hello world", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("kind=skill_run", sq_kind(nl_ic_result_sq(out)), NLK_SKILL_RUN)
    let sk = sq_skill_run_skill(nl_ic_result_sq(out))
    let arg = sq_skill_run_arg(nl_ic_result_sq(out))
    ce_check("skill==echo",   _has(sk, "echo"))
    ce_check("arg==hello world", _has(arg, "hello world"))
}

// ---- validator fall-through ------------------------------------------

fn test_slot_fill_bad_falls_through() {
    let m = nl_metrics_new()
    // Utterance is intent-like for RELATE but has no connector -- slot
    // fill can't produce two args; either the classifier scores it
    // below threshold (miss) OR it scores above but slot-fill returns
    // 0 and we fall through to unparsed. Both are valid; the
    // invariant is that ok is 0 and the returned SQ is UNPARSED --
    // NEVER a malformed SQ that would confuse the executor.
    let out = nl_ic_try_classify("connection between", m, "")
    ce_eq("no hit",        nl_ic_result_ok(out), 0)
    ce_eq("kind=unparsed", sq_kind(nl_ic_result_sq(out)), NLK_UNPARSED)
}

// ---- metrics behavior ------------------------------------------------

fn test_metrics_hit_increments() {
    let m = nl_metrics_new()
    ce_eq("attempts=0", nl_metrics_ic_attempts(m, ""), 0)
    ce_eq("hits=0",     nl_metrics_ic_hits(m, ""), 0)
    let out = nl_ic_try_classify("install capsule biology", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("attempts=1", nl_metrics_ic_attempts(m, ""), 1)
    ce_eq("hits=1",     nl_metrics_ic_hits(m, ""), 1)
    ce_eq("misses=0",   nl_metrics_ic_misses(m, ""), 0)
}

fn test_metrics_miss_increments() {
    let m = nl_metrics_new()
    // Empty text -> no tokens -> miss.
    let out = nl_ic_try_classify("", m, "")
    ce_eq("not ok", nl_ic_result_ok(out), 0)
    ce_eq("attempts=1", nl_metrics_ic_attempts(m, ""), 1)
    ce_eq("hits=0",     nl_metrics_ic_hits(m, ""), 0)
    ce_eq("misses=1",   nl_metrics_ic_misses(m, ""), 1)
}

fn test_metrics_per_holder() {
    let m = nl_metrics_new()
    nl_ic_try_classify("install capsule biology", m, "alice")
    nl_ic_try_classify("", m, "bob")
    ce_eq("alice attempts=1", nl_metrics_ic_attempts(m, "alice"), 1)
    ce_eq("alice hits=1",     nl_metrics_ic_hits(m, "alice"), 1)
    ce_eq("bob attempts=1",   nl_metrics_ic_attempts(m, "bob"), 1)
    ce_eq("bob misses=1",     nl_metrics_ic_misses(m, "bob"), 1)
}

fn test_metrics_zero_reg_noop() {
    // Should not crash with a null metrics registry.
    let out = nl_ic_try_classify("install capsule biology", 0, "")
    ce_eq("ok",     nl_ic_result_ok(out), 1)
    ce_eq("kind=capsule_install", sq_kind(nl_ic_result_sq(out)),
                                    NLK_CAPSULE_INSTALL)
}

// ---- determinism -----------------------------------------------------

fn test_prototype_determinism() {
    // The prototype vectors are pure functions of the embedded corpus,
    // so a re-init produces the same vectors bit-for-bit. We check by
    // classifying the same utterance twice and comparing the reported
    // similarity basis-points -- if the prototype differed, the number
    // would differ too.
    nl_ic_reset_cache()
    let m1 = nl_metrics_new()
    let out1 = nl_ic_try_classify("explain photosynthesis", m1, "")
    let sim1 = nl_ic_result_similarity(out1)
    nl_ic_reset_cache()
    let m2 = nl_metrics_new()
    let out2 = nl_ic_try_classify("explain photosynthesis", m2, "")
    let sim2 = nl_ic_result_similarity(out2)
    ce_eq("determinism: sim identical", sim1, sim2)
}

// ---- prototype isolation --------------------------------------------

fn test_prototype_kinds_disjoint() {
    // The chosen kind for a training utterance should be that utterance's
    // kind (not a different one). A weak isolation test: research vs
    // skill_run don't collide.
    let m = nl_metrics_new()
    let r = nl_ic_try_classify("tell me about the cell cycle", m, "")
    ce_eq("research",   sq_kind(nl_ic_result_sq(r)), NLK_RESEARCH)
    let s = nl_ic_try_classify("invoke echo on ping", m, "")
    ce_eq("skill_run",  sq_kind(nl_ic_result_sq(s)), NLK_SKILL_RUN)
    let l = nl_ic_try_classify("list all skills", m, "")
    ce_eq("skill_list", sq_kind(nl_ic_result_sq(l)), NLK_SKILL_LIST)
    let c = nl_ic_try_classify("install capsule biology", m, "")
    ce_eq("capsule_install",
        sq_kind(nl_ic_result_sq(c)), NLK_CAPSULE_INSTALL)
}

// ---- constructed SQ validates ---------------------------------------

fn test_hit_produces_valid_sq() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify("tell me about the cell cycle", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("validate", sq_validate(nl_ic_result_sq(out)), SQ_OK)
}

fn test_capsule_install_slotfill() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify("add capsule solar_system", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("kind=capsule_install",
        sq_kind(nl_ic_result_sq(out)), NLK_CAPSULE_INSTALL)
    let name = sq_capsule_install_name(nl_ic_result_sq(out))
    ce_check("name mentions solar", _has(name, "solar"))
}

fn test_retract_slotfill() {
    let m = nl_metrics_new()
    let out = nl_ic_try_classify("forget everything about phlogiston", m, "")
    ce_eq("ok", nl_ic_result_ok(out), 1)
    ce_eq("kind=retract", sq_kind(nl_ic_result_sq(out)), NLK_RETRACT)
    let lab = sq_retract_label(nl_ic_result_sq(out))
    ce_check("label mentions phlogiston", _has(lab, "phlogiston"))
}

// ---- runner ---------------------------------------------------------

fn main() {
    // Init once at start; subsequent tests share the module-level
    // singleton so we don't pay the (small) prototype-build cost
    // 20+ times. Tests that need a fresh state call
    // nl_ic_reset_cache themselves.
    nl_ic_reset_cache()
    test_init_ten_prototypes()
    test_init_idempotent()
    test_training_utterance_research_hits()
    test_training_utterance_relate_hits()
    test_training_utterance_skill_run_hits()
    test_training_capsule_list_hits()
    test_paraphrase_research_mitochondria()
    test_paraphrase_is_a_with_leading_article()
    test_threshold_default_is_3500_bp()
    test_off_topic_misses()
    test_high_confidence_hit()
    test_slot_fill_research_strips_preamble()
    test_slot_fill_relate_splits_on_and()
    test_slot_fill_skill_run_splits_on_on()
    test_slot_fill_bad_falls_through()
    test_metrics_hit_increments()
    test_metrics_miss_increments()
    test_metrics_per_holder()
    test_metrics_zero_reg_noop()
    test_prototype_determinism()
    test_prototype_kinds_disjoint()
    test_hit_produces_valid_sq()
    test_capsule_install_slotfill()
    test_retract_slotfill()
    ce_summary("nl_intent_classifier")
}

main()
