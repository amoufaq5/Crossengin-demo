// Unit tests for src/seed/packs/ops_runbook_pack.nova (brief). P1.9.

import "../ce_test.nova"
import "../../src/seed/packs/ops_runbook_pack.nova"
// imagination_kg_init (used by _setup) lives here and is NOT in the pack's
// import chain; without this NOVA silently compiles a call to a garbage address
// and the test segfaults at runtime (same class as ADR-0064).
import "../../src/parts/imagination/imagination_engine.nova"

fn _setup() {
    let reg = kg_registry_new()
    let env = list_new()
    push(env, reasoning_kg_init(reg))
    push(env, lang_kg_init(reg))
    push(env, imagination_kg_init(reg))
    push(env, mo_new())
    return env
}

fn _find_op(kg, premise_name, conclusion_name) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let ops = rk_operators_from(kg, atom_id(p))
    let i = 0
    while i < len(ops) {
        if rop_conclusion(ops[i]) == atom_id(c) { return ops[i] }
        i = i + 1
    }
    return 0
}

fn test_core_concepts_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_ops_runbook_with_mo(lang, kg, ikg, mo, 0)
    ce_check("service atom", kg_find_atom(kg, "service") != 0)
    ce_check("alert atom", kg_find_atom(kg, "alert") != 0)
    ce_check("latency atom", kg_find_atom(kg, "latency") != 0)
    ce_check("oom atom", kg_find_atom(kg, "oom") != 0)
}

fn test_high_latency_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_ops_runbook_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "high_latency", "check_database")
    ce_check("high_latency -> check_database operator exists", op != 0)
}

fn test_oom_restart_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_ops_runbook_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "oom", "restart")
    ce_check("oom -> restart operator exists", op != 0)
}

fn test_install_returns_counts() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    let r = pack_install_ops_runbook_with_mo(lang, kg, ikg, mo, 0)
    ce_eq("returns 2-element [atoms, ops]", len(r), 2)
    ce_check("ops_runbook atoms >= 30", r[0] >= 30)
    ce_check("ops_runbook ops >= 5", r[1] >= 5)
}

fn test_error_rate_spike_operator() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]; let mo = env[3]
    pack_install_ops_runbook_with_mo(lang, kg, ikg, mo, 0)
    let op = _find_op(kg, "error_rate_spike", "check_recent_deploy")
    ce_check("error_rate_spike -> check_recent_deploy operator exists", op != 0)
}

fn main() {
    test_core_concepts_present()
    test_high_latency_operator()
    test_oom_restart_operator()
    test_install_returns_counts()
    test_error_rate_spike_operator()
    ce_summary("ops_runbook_pack")
}
main()
