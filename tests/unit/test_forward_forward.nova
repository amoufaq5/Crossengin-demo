// Unit tests for src/learning/forward_forward.nova (P2, ADR-0052).
//
// Forward-Forward learns representations with a per-layer goodness objective:
// goodness is pushed HIGH on positive (real) data and LOW on negative
// (corrupted) data, with a local Hebbian / anti-Hebbian update and no gradient
// crossing layers. Covered here:
//   - after training, every positive scores above every negative (separation),
//   - a calibrated threshold then classifies all samples correctly,
//   - locality: training an upper layer leaves the lower layer's weights
//     untouched (the literal "no gradient flows between layers"), while the
//     upper layer still learns from the forward-only handoff.
//
// ADR-0052.

import "../ce_test.nova"
import "../../src/learning/forward_forward.nova"

fn vec4(a, b, c, d) {
    let v = list_new()
    push(v, a); push(v, b); push(v, c); push(v, d)
    return v
}
fn pl2(a, b) {
    let l = list_new()
    push(l, a); push(l, b)
    return l
}

// Two real "classes" (P1, P2) vs two corrupted mixes (N1, N2).
fn _P1() { return vec4(1000, 1000, 0, 0) }
fn _P2() { return vec4(0, 0, 1000, 1000) }
fn _N1() { return vec4(1000, 0, 1000, 0) }
fn _N2() { return vec4(0, 1000, 0, 1000) }

fn test_goodness_separation() {
    let layer = ff_layer_new(12, 4, 0, 777)
    // Untrained, the layer should not already separate the classes -- training
    // is what does the work.
    let ep = 0
    while ep < 60 {
        ff_train_pair(layer, _P1(), _N1(), 30)
        ff_train_pair(layer, _P2(), _N2(), 30)
        ep = ep + 1
    }
    let gP1 = ff_goodness(layer, _P1())
    let gP2 = ff_goodness(layer, _P2())
    let gN1 = ff_goodness(layer, _N1())
    let gN2 = ff_goodness(layer, _N2())
    let minpos = gP1
    if gP2 < minpos { minpos = gP2 }
    let maxneg = gN1
    if gN2 > maxneg { maxneg = gN2 }
    ce_check("every positive scores above every negative", minpos > maxneg)
}

fn test_calibrated_classification() {
    let layer = ff_layer_new(12, 4, 0, 777)
    let ep = 0
    while ep < 60 {
        ff_train_pair(layer, _P1(), _N1(), 30)
        ff_train_pair(layer, _P2(), _N2(), 30)
        ep = ep + 1
    }
    ff_calibrate_threshold(layer, pl2(_P1(), _P2()), pl2(_N1(), _N2()))
    ce_eq("P1 classified positive", ff_is_positive(layer, _P1()), 1)
    ce_eq("P2 classified positive", ff_is_positive(layer, _P2()), 1)
    ce_eq("N1 classified negative", ff_is_positive(layer, _N1()), 0)
    ce_eq("N2 classified negative", ff_is_positive(layer, _N2()), 0)
}

// No gradient flows between layers: training the upper layer must not change
// the lower layer's weights, and the upper layer must still learn locally from
// the (forward-only) handoff.
fn test_layer_locality() {
    let l1 = ff_layer_new(12, 4, 0, 101)
    let l2 = ff_layer_new(8, 12, 0, 202)
    let handoff = ff_normalize(ff_forward(l1, _P1()), 1000)  // layer 1's output

    let l1w_before = l1[FFL_W][0][0]
    let g2_before = ff_goodness(l2, handoff)
    let i = 0
    while i < 40 { ff_learn(l2, handoff, 1, 30); i = i + 1 }   // train ONLY layer 2
    let l1w_after = l1[FFL_W][0][0]
    let g2_after = ff_goodness(l2, handoff)

    ce_eq("layer 1 weights unchanged when layer 2 trains (no backward gradient)",
          l1w_after, l1w_before)
    ce_check("layer 2 learned locally from the forward handoff", g2_after > g2_before)
}

// The anti-Hebbian arm works on its own: a negative pass lowers goodness.
fn test_negative_pass_lowers_goodness() {
    let layer = ff_layer_new(8, 4, 0, 55)
    let x = _N1()
    let g0 = ff_goodness(layer, x)
    let i = 0
    while i < 30 { ff_learn(layer, x, 0, 30); i = i + 1 }   // negative passes only
    ce_check("negative training lowered goodness", ff_goodness(layer, x) < g0)
}

fn main() {
    test_goodness_separation()
    test_calibrated_classification()
    test_layer_locality()
    test_negative_pass_lowers_goodness()
    ce_summary("forward_forward")
}

main()
