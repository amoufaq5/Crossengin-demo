// Unit tests for the R101 composed visibility helper
// (visibility_visible in src/sandbox/ownership.nova).
//
// composed_visible = ownership_visible AND preference_visible
//
// Coverage:
//   * ownership allows + preference default -> visible
//   * ownership allows + preference disabled -> hidden
//   * ownership allows + preference enabled -> visible
//   * ownership blocks + preference enabled -> hidden (ownership wins)
//   * wildcard disable hides that kind, others unaffected
//   * reg=0 cases fall through cleanly
//   * cross-holder isolation
//   * cross-kind isolation

import "../ce_test.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/preference/user_preference.nova"

fn test_null_regs_visible() {
    // Both null -> visible (both fall through).
    ce_eq("both null", visibility_visible(0, 0, OWN_KIND_SKILL, "research", "alice"), 1)
}

fn test_ownership_only_no_pref() {
    let o = ownership_registry_new()
    ownership_set(o, OWN_KIND_SKILL, "research", "alice")
    // Alice sees it, bob does not.
    ce_eq("alice ownership", visibility_visible(o, 0, OWN_KIND_SKILL, "research", "alice"), 1)
    ce_eq("bob blocked",     visibility_visible(o, 0, OWN_KIND_SKILL, "research", "bob"),   0)
}

fn test_preference_only_no_ownership() {
    let p = preference_registry_new()
    preference_set(p, "alice", OWN_KIND_SKILL, "research", 0)
    // No ownership -> public. Alice's preference hides it; bob sees it.
    ce_eq("alice pref-hidden", visibility_visible(0, p, OWN_KIND_SKILL, "research", "alice"), 0)
    ce_eq("bob still sees",    visibility_visible(0, p, OWN_KIND_SKILL, "research", "bob"),   1)
}

fn test_ownership_allows_pref_default_visible() {
    let o = ownership_registry_new()
    let p = preference_registry_new()
    // Public resource (no ownership entry).
    ce_eq("default visible",
          visibility_visible(o, p, OWN_KIND_CAPSULE, "solar_system", "alice"), 1)
}

fn test_ownership_allows_pref_disabled_hidden() {
    let o = ownership_registry_new()
    let p = preference_registry_new()
    // Public resource; alice preference-hides.
    preference_set(p, "alice", OWN_KIND_CAPSULE, "solar_system", 0)
    ce_eq("hidden by pref",
          visibility_visible(o, p, OWN_KIND_CAPSULE, "solar_system", "alice"), 0)
    ce_eq("bob unaffected",
          visibility_visible(o, p, OWN_KIND_CAPSULE, "solar_system", "bob"), 1)
}

fn test_ownership_allows_pref_enabled_visible() {
    let o = ownership_registry_new()
    let p = preference_registry_new()
    preference_set(p, "alice", OWN_KIND_CAPSULE, "solar_system", 1)
    ce_eq("visible with explicit enable",
          visibility_visible(o, p, OWN_KIND_CAPSULE, "solar_system", "alice"), 1)
}

fn test_ownership_blocks_pref_enabled_still_hidden() {
    // Ownership is HARD: a preference-enable does not override an
    // ownership block. Bob cannot see alice's private research skill
    // even if he tries to preference-enable it.
    let o = ownership_registry_new()
    let p = preference_registry_new()
    ownership_set(o, OWN_KIND_SKILL, "research", "alice")
    preference_set(p, "bob", OWN_KIND_SKILL, "research", 1)
    ce_eq("bob still hidden by ownership",
          visibility_visible(o, p, OWN_KIND_SKILL, "research", "bob"), 0)
    ce_eq("alice still visible",
          visibility_visible(o, p, OWN_KIND_SKILL, "research", "alice"), 1)
}

fn test_wildcard_hides_whole_kind_composed() {
    let o = ownership_registry_new()
    let p = preference_registry_new()
    // No ownership entries -> everything public. Alice wildcards patterns.
    preference_set(p, "alice", OWN_KIND_PATTERN, "*", 0)
    ce_eq("pattern A hidden",
          visibility_visible(o, p, OWN_KIND_PATTERN, "debug_common", "alice"), 0)
    ce_eq("pattern B hidden",
          visibility_visible(o, p, OWN_KIND_PATTERN, "research_hygiene", "alice"), 0)
    // Other kinds untouched.
    ce_eq("skill unaffected",
          visibility_visible(o, p, OWN_KIND_SKILL, "research", "alice"), 1)
    ce_eq("kg unaffected",
          visibility_visible(o, p, OWN_KIND_KG, "world", "alice"), 1)
    ce_eq("capsule unaffected",
          visibility_visible(o, p, OWN_KIND_CAPSULE, "solar_system", "alice"), 1)
    // Bob unaffected.
    ce_eq("bob patterns visible",
          visibility_visible(o, p, OWN_KIND_PATTERN, "debug_common", "bob"), 1)
}

fn test_wildcard_ownership_still_gates() {
    // Wildcard disable is a preference filter; ownership still gates.
    // Alice wildcards patterns, but a pattern is owned by bob so alice
    // never sees it either way; the composed result is still 0.
    let o = ownership_registry_new()
    let p = preference_registry_new()
    ownership_set(o, OWN_KIND_PATTERN, "bobs_pack", "bob")
    preference_set(p, "alice", OWN_KIND_PATTERN, "*", 0)
    ce_eq("alice still blocked",
          visibility_visible(o, p, OWN_KIND_PATTERN, "bobs_pack", "alice"), 0)
    // Bob CAN see (ownership match, no pref block for bob).
    ce_eq("bob sees own pack",
          visibility_visible(o, p, OWN_KIND_PATTERN, "bobs_pack", "bob"), 1)
}

fn test_pref_re_enable_overrides_wildcard_but_not_ownership() {
    let o = ownership_registry_new()
    let p = preference_registry_new()
    ownership_set(o, OWN_KIND_PATTERN, "gate", "alice")
    preference_set(p, "alice", OWN_KIND_PATTERN, "*", 0)  // hide all
    preference_set(p, "alice", OWN_KIND_PATTERN, "gate", 1) // re-enable gate
    ce_eq("gate visible (alice owns + re-enabled)",
          visibility_visible(o, p, OWN_KIND_PATTERN, "gate", "alice"), 1)
    // Bob cannot see (ownership block).
    ce_eq("bob still blocked",
          visibility_visible(o, p, OWN_KIND_PATTERN, "gate", "bob"), 0)
}

fn test_pref_disable_public_after_ownership_removed() {
    // Resource is public (no ownership entry). Alice disables it. She
    // shouldn't see it. Bob still should.
    let o = ownership_registry_new()
    let p = preference_registry_new()
    preference_set(p, "alice", OWN_KIND_KG, "world", 0)
    ce_eq("alice hidden",
          visibility_visible(o, p, OWN_KIND_KG, "world", "alice"), 0)
    ce_eq("bob still visible",
          visibility_visible(o, p, OWN_KIND_KG, "world", "bob"), 1)
}

fn test_anonymous_holder_composed() {
    // An anonymous caller ("") sees only public+preference-visible.
    // No ownership entries -> everything public. No preference for
    // anonymous -> visible.
    let o = ownership_registry_new()
    let p = preference_registry_new()
    ce_eq("anon sees public",
          visibility_visible(o, p, OWN_KIND_KG, "world", ""), 1)
    // Owned by alice -> anon blocked.
    ownership_set(o, OWN_KIND_KG, "world", "alice")
    ce_eq("anon blocked when owned",
          visibility_visible(o, p, OWN_KIND_KG, "world", ""), 0)
}

fn main() {
    test_null_regs_visible()
    test_ownership_only_no_pref()
    test_preference_only_no_ownership()
    test_ownership_allows_pref_default_visible()
    test_ownership_allows_pref_disabled_hidden()
    test_ownership_allows_pref_enabled_visible()
    test_ownership_blocks_pref_enabled_still_hidden()
    test_wildcard_hides_whole_kind_composed()
    test_wildcard_ownership_still_gates()
    test_pref_re_enable_overrides_wildcard_but_not_ownership()
    test_pref_disable_public_after_ownership_removed()
    test_anonymous_holder_composed()
    ce_summary("visibility_composed")
}

main()
