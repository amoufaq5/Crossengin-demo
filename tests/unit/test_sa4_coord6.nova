// CE_TEST_TIMEOUT: 240
// End-to-end tests of the v4-sa2 robust rebuild in
// src/learning/sa4_coord.nova (A2.4b), with real souls through
// tests/sa4_harness.nova. A revealer that alters a share keeps its proof
// (sa4e_edit 7-9), so the proof no longer matches the share:
//   - a wrong b-share with |R| = t + 1 (N = 5): the right sum, and the
//     liar in sa4c_bad_revealers;
//   - a wrong s-share with a dropout and |R| = t + 1 (N = 7, t = 5): the
//     right sum (v1 refused this round);
//   - |R| - t + 1 = 2 liars about one dealer: refused;
//   - two liars about two different dealers with |R| = t + 1: refused,
//     because the first liar stays excluded for the second dealer (global
//     exclusion; it was honest about that dealer);
//   - an inconsistent dealer (its committed share for one receiver does not
//     lie on its polynomial): refused, the dealer blamed, nobody excluded;
//   - an s-share error that only touches the bits X25519 clamps: the right
//     sum, no exclusion (control: an error in another bit is refused at
//     |R| = t);
//   - a proof of the wrong length: the revealer is left out on receipt,
//     the sum is right from the other t;
//   - one liar about every dealer: excluded once, the right sum.

import "../ce_test.nova"
import "../sa4_harness.nova"

let C6_R = 45

fn _ids(l) {
    let s = ""
    let i = 0
    while i < len(l) {
        if i > 0 { s = s + "," }
        s = s + int_to_str(l[i])
        i = i + 1
    }
    return s
}

fn c6_run(roster, n, vc, stops, tampers, bad_dealers) {
    let souls = sa4h_souls(roster, n, C6_R, vc, 0)
    let c = sa4e_coord(roster, C6_R, vc)
    return sa4e_round_f(roster, souls, c, stops, tampers, bad_dealers)
}

fn test_wrong_b(roster, vc) {
    // Soul 65536 (index 2) alters its b-share about soul 7.
    let res = c6_run(roster, 5, vc, list_new(), [[2, 4, 7]], list_new())
    let c = res[3]
    ce_eq("wrong b-share, |R| = t + 1: unmasked", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("wrong b-share: the right sum", sa4h_same(res[2], sa4h_expected([1, 2, 3, 4, 5])), 1)
    ce_str_eq("wrong b-share: the liar is excluded", _ids(sa4c_bad_revealers(c)), "65536")
    ce_check("wrong b-share: reason (" + sa4c_why(c, 65536) + ")", find_bytes(sa4c_why(c, 65536), "reveal about soul 7 does not match its commitment") >= 0)
    ce_eq("wrong b-share: not an abort", sa4c_aborted(c, 65536), 0)
    ce_str_eq("wrong b-share: the dealer is not blamed", sa4c_why(c, 7), "")
    return 0
}

fn test_wrong_s_dropout(vc) {
    let r7 = sa4h_roster7()
    ce_eq("N = 7 roster", sroster_n(r7), 7)
    ce_eq("N = 7: t = 5", sroster_t(r7), 5)
    // Soul 65536 (index 2) stops after its shares; soul 7 alters its
    // s-share about it. |R| = 6 > t.
    let res = c6_run(r7, 7, vc, [[2, 2]], [[0, 4, 4]], list_new())
    let c = res[3]
    ce_eq("wrong s-share with a dropout: unmasked", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_str_eq("wrong s-share: U3 lacks the dropped soul", _ids(sa4c_set(c, 3)), "7,300,70000,80000,90000,4294967295")
    ce_eq("wrong s-share: the right sum", sa4h_same(res[2], sa4h_expected([1, 2, 4, 5, 6, 7])), 1)
    ce_str_eq("wrong s-share: the liar is excluded", _ids(sa4c_bad_revealers(c)), "7")
    ce_check("wrong s-share: reason", find_bytes(sa4c_why(c, 7), "reveal about soul 65536 does not match its commitment") >= 0)
    return 0
}

fn test_too_many_liars(roster, vc) {
    let res = c6_run(roster, 5, vc, list_new(), [[0, 4, 7], [1, 4, 7]], list_new())
    let c = res[3]
    ce_eq("two liars about soul 7, |R| = 5: refused", res[0], 0)
    ce_check("two liars: fewer than t good shares (" + res[1] + ")", find_bytes(res[1], "fewer than t good shares about soul 7") >= 0)
    ce_str_eq("two liars: both excluded", _ids(sa4c_bad_revealers(c)), "7,300")
    return 0
}

fn test_global_exclusion(roster, vc) {
    // Soul 7 lies only about soul 300, soul 300 only about soul 65536.
    let res = c6_run(roster, 5, vc, list_new(), [[0, 4, 9, [300, 1]], [1, 4, 9, [65536, 1]]], list_new())
    let c = res[3]
    ce_eq("liars about two dealers, |R| = t + 1: refused", res[0], 0)
    ce_check("global exclusion: soul 7 stays out for soul 65536 (" + res[1] + ")", find_bytes(res[1], "fewer than t good shares about soul 65536") >= 0)
    ce_str_eq("global exclusion: both liars excluded", _ids(sa4c_bad_revealers(c)), "7,300")
    ce_check("soul 7's reason names soul 300", find_bytes(sa4c_why(c, 7), "reveal about soul 300 does not match") >= 0)
    ce_check("soul 300's reason names soul 65536", find_bytes(sa4c_why(c, 300), "reveal about soul 65536 does not match") >= 0)
    return 0
}

fn test_bad_dealer(roster, vc) {
    // Soul 300 (index 1) commits to and deals a b-share for x = 1 that is
    // not on its polynomial.
    let res = c6_run(roster, 5, vc, list_new(), list_new(), [1])
    let c = res[3]
    ce_eq("inconsistent dealer: every soul got through R2", len(sa4c_set(c, 3)), 5)
    ce_eq("inconsistent dealer: refused", res[0], 0)
    ce_check("inconsistent dealer: blamed in the refusal (" + res[1] + ")", find_bytes(res[1], "soul 300 dealt shares that do not match its commitment") >= 0)
    ce_check("inconsistent dealer: sa4c_why of the dealer", find_bytes(sa4c_why(c, 300), "soul 300 dealt shares that do not match its commitment") >= 0)
    ce_eq("inconsistent dealer: no revealer excluded", len(sa4c_bad_revealers(c)), 0)
    ce_str_eq("inconsistent dealer: the receiver of the bad share is not blamed", sa4c_why(c, 7), "")
    return 0
}

fn test_clamped(roster, vc) {
    // Dropout of soul 65536 at N = 5: R = {1, 2, 4, 5} = t. Soul 7 (x = 1)
    // xors byte 0 of its s-share about 65536 by e = 1 / lambda_1, so the
    // rebuilt s key differs only in bit 0, which X25519 clears.
    let lam = shamir_lagrange0([1, 2, 4, 5])[0]
    let e = gf256_inv(lam)
    ce_eq("e * lambda_1 = 1", gf256_mul(e, lam), 1)
    let res = c6_run(roster, 5, vc, [[2, 2]], [[0, 4, 9, [65536, e]]], list_new())
    let c = res[3]
    ce_eq("clamped-bit s error: unmasked", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("clamped-bit s error: the right sum", sa4h_same(res[2], sa4h_expected([1, 2, 4, 5])), 1)
    ce_eq("clamped-bit s error: nobody excluded", len(sa4c_bad_revealers(c)), 0)
    ce_str_eq("clamped-bit s error: no reason for soul 7", sa4c_why(c, 7), "")
    // Control: bit 3 of byte 0 is not clamped.
    let e8 = gf256_mul(e, 8)
    let res2 = c6_run(roster, 5, vc, [[2, 2]], [[0, 4, 9, [65536, e8]]], list_new())
    ce_eq("unclamped s error at |R| = t: refused", res2[0], 0)
    ce_str_eq("unclamped s error: the liar is excluded", _ids(sa4c_bad_revealers(res2[3])), "7")
    return 0
}

fn test_bad_proof_length(roster, vc) {
    let res = c6_run(roster, 5, vc, list_new(), [[3, 4, 10]], list_new())
    let c = res[3]
    ce_check("short proof: left out on receipt (" + sa4c_why(c, 70000) + ")", find_bytes(sa4c_why(c, 70000), "proof length") >= 0)
    ce_str_eq("short proof: not a revealer", _ids(sa4c_set(c, 5)), "7,300,65536,4294967295")
    ce_eq("short proof: unmasked from the other t", res[0], 1)
    ce_eq("short proof: the right sum", sa4h_same(res[2], sa4h_expected([1, 2, 3, 4, 5])), 1)
    ce_eq("short proof: nobody excluded at unmasking", len(sa4c_bad_revealers(c)), 0)
    return 0
}

fn test_one_liar_many_dealers(roster, vc) {
    let res = c6_run(roster, 5, vc, list_new(), [[0, 4, 8]], list_new())
    let c = res[3]
    ce_eq("one liar about every dealer: unmasked", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("one liar about every dealer: the right sum", sa4h_same(res[2], sa4h_expected([1, 2, 3, 4, 5])), 1)
    ce_str_eq("one liar about every dealer: excluded once", _ids(sa4c_bad_revealers(c)), "7")
    ce_check("first dealer named in the reason", find_bytes(sa4c_why(c, 7), "reveal about soul 7 does not match") >= 0)
    return 0
}

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    test_wrong_b(roster, vc)
    test_wrong_s_dropout(vc)
    test_too_many_liars(roster, vc)
    test_global_exclusion(roster, vc)
    test_bad_dealer(roster, vc)
    test_clamped(roster, vc)
    test_bad_proof_length(roster, vc)
    test_one_liar_many_dealers(roster, vc)
    ce_summary("sa4_coord6")
}

main()
