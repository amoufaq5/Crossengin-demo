// Unit tests for src/sim/world_model.nova (P5, ADR-0055).
//
// The deterministic grid micro-world: construction, reset, stepping (move,
// wall-clamp, goal reward + done), state ids, the optimal-steps baseline, and
// world_peek being a pure prediction (the forward-sim seam) that does not move
// the real agent.
//
// ADR-0055.

import "../ce_test.nova"
import "../../src/sim/world_model.nova"

fn test_world_basics() {
    let w = world_new(4, 4, 0, 0, 3, 3)
    ce_eq("width", world_width(w), 4)
    ce_eq("height", world_height(w), 4)
    ce_eq("n_states", world_n_states(w), 16)
    ce_eq("n_actions", world_actions(), 4)
    ce_eq("start state id", world_state_id(w), 0)
    ce_eq("optimal steps (manhattan)", world_optimal_steps(w), 6)
    ce_eq("not done at start", world_done(w), 0)
}

fn test_step_move_and_wall() {
    let w = world_new(4, 4, 0, 0, 3, 3)
    let r = world_step(w, SIM_RIGHT)
    ce_eq("right moves x", world_x(w), 1)
    ce_eq("step reward", r[0], SIM_STEP_REWARD)
    ce_eq("not done", r[1], 0)
    ce_eq("state id after right", world_state_id(w), 1)
    world_reset(w)
    world_step(w, SIM_LEFT)
    ce_eq("left into the wall stays put", world_x(w), 0)
    ce_eq("step still counted", world_steps(w), 1)
}

fn test_reach_goal() {
    let w = world_new(2, 1, 0, 0, 1, 0)
    let r = world_step(w, SIM_RIGHT)
    ce_eq("goal reward paid", r[0], SIM_GOAL_REWARD)
    ce_eq("done flagged", r[1], 1)
    ce_eq("world done", world_done(w), 1)
    let r2 = world_step(w, SIM_LEFT)
    ce_eq("step after done is a no-op", r2[0], 0)
    ce_eq("still done", r2[1], 1)
}

fn test_peek_is_pure() {
    let w = world_new(4, 4, 0, 0, 3, 3)
    let pk = world_peek(w, SIM_RIGHT)
    ce_eq("peek reward", pk[0], SIM_STEP_REWARD)
    ce_eq("peek not done", pk[1], 0)
    ce_eq("peek next state", pk[2], 1)
    ce_eq("peek did NOT move the agent", world_x(w), 0)
    let w2 = world_new(2, 1, 0, 0, 1, 0)
    let pg = world_peek(w2, SIM_RIGHT)
    ce_eq("peek predicts the goal reward", pg[0], SIM_GOAL_REWARD)
    ce_eq("peek predicts done", pg[1], 1)
    ce_eq("peek did NOT finish the real world", world_done(w2), 0)
}

fn test_reset() {
    let w = world_new(4, 4, 0, 0, 3, 3)
    world_step(w, SIM_RIGHT)
    world_step(w, SIM_DOWN)
    world_reset(w)
    ce_eq("reset x", world_x(w), 0)
    ce_eq("reset y", world_y(w), 0)
    ce_eq("reset steps", world_steps(w), 0)
    ce_eq("reset done", world_done(w), 0)
}

// State-id <-> coordinate round-trip, and peek-from-an-arbitrary-state (the
// pure forward-sim primitive multi-step lookahead is built on).
fn test_state_decode_and_peek_at() {
    let w = world_new(4, 4, 0, 0, 3, 3)
    // state id 6 = (y=1, x=2) on a width-4 grid.
    ce_eq("decode x of state 6", world_state_x(w, 6), 2)
    ce_eq("decode y of state 6", world_state_y(w, 6), 1)
    ce_eq("encode matches decode", world_state_of(2, 1, 4), 6)
    // peek_at from a state the agent is NOT standing on.
    let pk = world_peek_at(w, 6, SIM_RIGHT)
    ce_eq("peek_at reward", pk[0], SIM_STEP_REWARD)
    ce_eq("peek_at not done", pk[1], 0)
    ce_eq("peek_at next state (right -> x=3)", pk[2], world_state_of(3, 1, 4))
    // a step that reaches the goal cell (3,3) = state 15 from (3,2) = state 11.
    let pg = world_peek_at(w, world_state_of(3, 2, 4), SIM_DOWN)
    ce_eq("peek_at predicts goal reward", pg[0], SIM_GOAL_REWARD)
    ce_eq("peek_at predicts done", pg[1], 1)
    // purity: the real agent never moved (still at the start cell).
    ce_eq("peek_at did NOT move the agent x", world_x(w), 0)
    ce_eq("peek_at did NOT move the agent y", world_y(w), 0)
    // wall clamp from an arbitrary state: left from x=0 stays put.
    let pw = world_peek_at(w, world_state_of(0, 2, 4), SIM_LEFT)
    ce_eq("peek_at left-into-wall stays", pw[2], world_state_of(0, 2, 4))
}

fn main() {
    test_world_basics()
    test_step_move_and_wall()
    test_reach_goal()
    test_peek_is_pure()
    test_reset()
    test_state_decode_and_peek_at()
    ce_summary("world_model")
}

main()
