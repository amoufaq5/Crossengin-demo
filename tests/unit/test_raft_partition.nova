// Unit tests for src/federation/raft_partition.nova: Raft under network
// partition -- the no-split-brain guarantee. A minority side can neither elect a
// leader nor commit; the majority side makes progress; on heal the stale minority
// converges on the majority's committed log.

import "../ce_test.nova"
import "../../src/federation/raft_partition.nova"

// A minority partition (2 of 5) cannot elect a leader: the candidate reaches only
// one peer, 2 votes < majority of 3.
fn test_minority_cannot_elect() {
    let c = rc_new(5)
    let won = rp_election(c, 0, rp_pair(0, 1))
    ce_eq("minority candidate loses", won, 0)
    ce_eq("no leader on minority side", rf_role(rc_node(c, 0)), RF_CANDIDATE)
}

// The majority partition (3 of 5) DOES elect a leader and commit -- progress
// continues on the side that has a quorum.
fn test_majority_makes_progress() {
    let c = rc_new(5)
    let won = rp_election(c, 2, rp_trio(2, 3, 4))
    ce_eq("majority candidate wins", won, 1)
    ce_eq("node 2 is leader", rf_role(rc_node(c, 2)), RF_LEADER)
    rc_leader_append(c, 2, 777)
    let committed = rp_replicate(c, 2, rp_trio(2, 3, 4))
    ce_eq("majority commits index 1", committed, 1)
}

// No split-brain: with the cluster split {0,1} | {2,3,4}, run an election on each
// side. Only the majority side produces a leader -- never two leaders in a term.
fn test_no_split_brain() {
    let c = rc_new(5)
    let minority_won = rp_election(c, 0, rp_pair(0, 1))      // term 1, fails
    let majority_won = rp_election(c, 2, rp_trio(2, 3, 4))   // term 1, wins
    ce_eq("minority side has no leader", minority_won, 0)
    ce_eq("majority side elected", majority_won, 1)
    ce_eq("exactly one leader in term 1", rc_count_leaders(c, 1), 1)
}

// A stranded minority leader-wannabe cannot commit even if its local followers
// ack: commit counts the whole cluster, so the unreachable majority pins the
// majority-index below its entries.
fn test_minority_cannot_commit() {
    let c = rc_new(5)
    // force node 0 to believe it leads (it does not have a quorum) and append.
    rf_become_candidate(c[0])
    rf_become_leader(c[0])
    rc_leader_append(c, 0, 555)
    let committed = rp_replicate(c, 0, rp_pair(0, 1))
    ce_eq("minority leader cannot commit", committed, 0)
    ce_eq("majority side never saw the entry", rf_last_index(rc_node(c, 2)), 0)
}

// On heal, the majority's committed log propagates to the stale minority and the
// whole cluster becomes consistent with a single leader.
fn test_heal_converges() {
    let c = rc_new(5)
    rp_election(c, 0, rp_pair(0, 1))                 // minority candidate (fails)
    rp_election(c, 2, rp_trio(2, 3, 4))              // majority leader, term 1
    rc_leader_append(c, 2, 42)
    rp_replicate(c, 2, rp_trio(2, 3, 4))             // committed on majority side
    // heal: the leader can now reach everyone.
    let committed = rp_replicate(c, 2, rp_all(c))
    ce_eq("commit holds at 1", committed, 1)
    ce_eq("stale node 0 caught up", rf_last_index(rc_node(c, 0)), 1)
    ce_eq("stale node 1 caught up", rf_last_index(rc_node(c, 1)), 1)
    ce_eq("cluster consistent after heal", rc_committed_consistent(c), 1)
    ce_eq("still exactly one leader in term 1", rc_count_leaders(c, 1), 1)
}

fn main() {
    test_minority_cannot_elect()
    test_majority_makes_progress()
    test_no_split_brain()
    test_minority_cannot_commit()
    test_heal_converges()
    ce_summary("raft_partition")
}

main()
