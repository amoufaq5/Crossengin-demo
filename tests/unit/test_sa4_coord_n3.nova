// CE_TEST_TIMEOUT: 240
// End-to-end test of src/learning/sa4_coord.nova (A2.2b): an honest N = 3
// round through the real coordinator. The unmasked sum equals the sum of
// the inputs, a second unmask is refused, and lines after the round are
// refused.

import "../ce_test.nova"
import "../sa4_harness.nova"

fn _ids(l) {
    let s = ""
    let i = 0
    while i < len(l) {
        if i > 0 { s = s + "," }
        s = s + int_to_str(l[i])
        i = i + 1
    }
    return s
}

fn test_honest_n3(vc) {
    let roster = sa4h_roster(3)
    let souls = sa4h_souls(roster, 3, 31, vc, 0)
    let c = sa4e_coord(roster, 31, vc)
    let res = sa4e_round(roster, souls, c, list_new(), list_new())
    ce_eq("N=3 round unmasks", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("N=3 sum equals the sum of inputs", sa4h_same(res[2], sa4h_expected([1, 2, 3])), 1)
    ce_str_eq("U3 is everyone", _ids(sa4c_set(c, 3)), "7,300,65536")
    ce_eq("coordinator done", sa4c_state(c), SA4C_ST_DONE)
    let again = sa4c_unmask(c)
    ce_eq("second unmask refused", again[0], 0)
    ce_check("second unmask reason", find_bytes(again[1], "already unmasked") >= 0)
    ce_eq("lines after the round are refused", sa4c_recv(c, 7, "SA4_END 31 3 7 3")[0], 0)
    return 0
}

fn main() {
    let vc = list_new()
    test_honest_n3(vc)
    ce_summary("sa4_coord_n3")
}

main()
