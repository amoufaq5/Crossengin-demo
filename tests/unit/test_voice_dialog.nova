// ---- R25B.5 kind-pivot (R31F / R30F.2) ---------------------------------
//
// R30F's exit report explicitly named the deferred fix: "consult
// `_vd_known_kind` against remainder tokens from the more-cue path and
// route as a kind-pivot when the remainder names a known kind != prior".
// R31F lands that fix and introduces VC_FOLLOWUP_KIND_PIVOT, a fifth
// classifier output distinct from PIVOT. The handler treats a
// KIND_PIVOT like a fresh template-preserving query against the new
// kind (LIST_ALL by default, prior template when set), with LIMIT
// reset to baseline -- NOT escalated.
//
// Test fixtures (20+ new assertions). Coverage:
//   * The headline R29C/R30F failure case now classifies KIND_PIVOT.
//   * The explicit "what about KIND" path upgrades to KIND_PIVOT
//     (already updated in test_classify_what_about_kind_is_pivot
//     above; we re-assert end-state here).
//   * Same-kind remainder ("tell me more about facts" after FACT)
//     stays CONTINUE -- no kind shift signal.
//   * Unknown-kind remainder ("cats", "dogs") stays PIVOT -- no
//     known-kind in remainder to route as KIND_PIVOT.
//   * "list all RULE" + "tell me more about facts" -> KIND_PIVOT
//     (the symmetric case).
//   * Dispatch verifies handler runs prior template against new
//     kind, LIMIT resets to baseline, history records the pivot
//     turn with the new kind annotated.
//   * Public probe voice_followup_kind_pivot_target returns the
//     matched kind name on KIND_PIVOT inputs, "" otherwise.

// Headline brief case: "list all FACT" -> "tell me more about RULE
// atoms" -> KIND_PIVOT. Matches RULE in known kinds; new query
// fires with kind=RULE, limit=10.
fn test_kind_pivot_more_about_rule_atoms_after_fact() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'tell me more about RULE atoms' after FACT -> KIND_PIVOT",
        voice_followup_classify(s, "tell me more about RULE atoms"),
        vc_followup_kind_pivot())
    ce_str_eq("target kind = RULE",
        voice_followup_kind_pivot_target(s, "tell me more about RULE atoms"),
        "RULE")
}

// Headline brief case via morphology: "list all FACT" -> "tell me
// more about that atom in the rule engine" -> KIND_PIVOT. Matches
// "rule" via morphology against known kind RULE. (This is the
// R29C-documented failure case that R30F honestly left as PIVOT.)
fn test_kind_pivot_rule_engine_after_fact() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'tell me more about that atom in the rule engine' after FACT -> KIND_PIVOT",
        voice_followup_classify(s,
            "tell me more about that atom in the rule engine"),
        vc_followup_kind_pivot())
    ce_str_eq("target kind = RULE (via morphology)",
        voice_followup_kind_pivot_target(s,
            "tell me more about that atom in the rule engine"),
        "RULE")
}

// Symmetric case: "list all RULE" -> "tell me more about facts"
// -> KIND_PIVOT (matches "fact" via morphology against kind FACT).
fn test_kind_pivot_more_about_facts_after_rule() {
