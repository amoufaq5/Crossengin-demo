    ce_eq("template LIST_ALL preserved",
        vc_session_last_template(s), vc_template_list_all())
    ce_eq("limit baseline 10", vc_session_last_limit(s), 10)
}

// Multi-kind ambiguous remainder: R31F shipped "first kind wins" and
// documented the brief alternative ("clarify"). R32F lands the
// clarifying-question path; the classifier now returns CLARIFY when
// the remainder names 2+ known kinds (with `CE_VOICE_NO_CLARIFY`
// unset). The target probe `voice_followup_kind_pivot_target` still
// returns the first-match kind ("FACT") -- it walks
// `_vd_remainder_known_kind` regardless of the classifier label so
// the env-opt-out CE_VOICE_NO_CLARIFY=1 path (which routes via
// KIND_PIVOT) sees the same first-match target.
//
// R32F UPDATE: prior expected on classify was vc_followup_kind_pivot();
// the target accessor is unchanged from R31F.
fn test_kind_pivot_multi_kind_ambiguous_picks_first() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all CONCEPT")
    ce_eq("'more facts and rules' after CONCEPT -> CLARIFY (R32F)",
        voice_followup_classify(s, "more facts and rules"),
        vc_followup_clarify())
    ce_str_eq("'more facts and rules' target = FACT (first in tokeniser order; preserved)",
        voice_followup_kind_pivot_target(s, "more facts and rules"),
        "FACT")
}

// Negative: "and dogs" stays PIVOT (no known kind, no kind-pivot).
