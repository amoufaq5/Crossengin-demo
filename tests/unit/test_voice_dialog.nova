// Dispatch -- give up after MAX attempts.
fn test_dispatch_clarify_give_up_after_max_attempts() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all CONCEPT")
    vc_session_turn(kg, s, "more facts and rules")  // attempts=1
    vc_session_turn(kg, s, "cats")                  // attempts=2, re-clarify
    // Third turn: still no resolution. attempts would go to 3 which
    // exceeds MAX (2); give-up path fires.
    let r = vc_session_turn(kg, s, "dogs")
    let txt = vc_session_result_text(r)
    // The give-up apology + first-match dispatch are joined into one
    // response. First candidate = FACT; KG has 3 FACTs.
    ce_str_eq("give-up apology + first-match dispatch",
        txt,
        "Sorry, I could not tell which kind you meant. Showing FACT atoms by default. Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("no longer pending",
        vc_session_is_pending_clarify(s), 0)
    ce_str_eq("kind FACT (first-match fallback)",
        vc_session_last_kind(s), "FACT")
}

// Dispatch -- topic-shift mid-clarify cancels pending.
fn test_dispatch_clarify_topic_shift_cancels() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all CONCEPT")
    vc_session_turn(kg, s, "more facts and rules")
    ce_eq("mid-clarify",
        vc_session_is_pending_clarify(s), 1)
    let r = vc_session_turn(kg, s, "never mind")
    let txt = vc_session_result_text(r)
    ce_str_eq("'never mind' acknowledged",
        txt, "Okay, let us change the topic. What would you like to know?")
    ce_eq("no longer pending (reset cleared it)",
        vc_session_is_pending_clarify(s), 0)
    ce_eq("history wiped", len(vc_session_history(s)), 0)
}

// Brief full chain: list all CONCEPT -> CLARIFY -> RULE -> new query.
fn test_clarify_full_chain_concept_clarify_rule() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r1 = vc_session_turn(kg, s, "list all CONCEPT")
    ce_str_eq("turn 1: LIST_ALL CONCEPT",
        vc_session_result_text(r1),
        "Found 2 CONCEPT atoms: ids 3, 4.")
    let r2 = vc_session_turn(kg, s, "tell me more about facts and rules")
    ce_str_eq("turn 2: clarify question",
        vc_session_result_text(r2),
        "Did you mean FACT or RULE atoms?")
    let r3 = vc_session_turn(kg, s, "RULE")
    ce_str_eq("turn 3: 'RULE' resolves -> LIST_ALL RULE",
        vc_session_result_text(r3), "No RULE atoms found.")
    ce_str_eq("post-chain: kind RULE",
        vc_session_last_kind(s), "RULE")
}

// CLARIFY produces no history entry of its own -- the pending state
// is what carries the turn forward. (History only grows on resolved
// or fresh-parsed turns.)
fn test_clarify_no_history_growth_on_clarify_emission() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all CONCEPT")  // history = 1
    vc_session_turn(kg, s, "more facts and rules")  // CLARIFY emit
    ce_eq("history still 1 after CLARIFY emit",
        len(vc_session_history(s)), 1)
    vc_session_turn(kg, s, "RULE")  // resolution -> _vd_pivot_turn
    // _vd_pivot_turn appends one turn entry on resolution.
    ce_eq("history grows to 2 on resolution",
        len(vc_session_history(s)), 2)
}

// Env opt-out: CE_VOICE_NO_CLARIFY=1 falls back to R31F's first-match
// KIND_PIVOT byte-identically. We can't directly set env vars from
// the test runner, but the public probe `vc_clarify_suppressed_by_env`
// exposes the suppression decision so the test framework can verify
// the wiring is in place. The runtime opt-out is exercised in the
// integration scenario.
fn test_clarify_env_opt_out_probe_default_off() {
    // In the test runner the env var is not set -> probe returns 0.
    ce_eq("default: clarify NOT suppressed",
        vc_clarify_suppressed_by_env(), 0)
}

// Multi-kind detector "and" cue case: "and facts and rules" after
// SKILL -> CLARIFY with FACT + RULE candidates.
fn test_clarify_and_cue_multi_kind() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all SKILL")
    ce_eq("'and facts and rules' after SKILL -> CLARIFY",
        voice_followup_classify(s, "and facts and rules"),
        vc_followup_clarify())
    let cands = voice_followup_clarify_candidates(s,
        "and facts and rules")
    ce_eq("two candidates", len(cands), 2)
}

// Same-kind multi-mention is NOT clarify -- "and rules and rule
// atoms" stems both to RULE; that's a single kind, not multi.
fn test_clarify_same_kind_multi_mention_not_clarify() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    // Remainder has two mentions of RULE (rules + rule). Detector
    // dedups -> single kind. Classifier returns KIND_PIVOT.
    ce_eq("'more rules and rule atoms' after FACT -> KIND_PIVOT",
        voice_followup_classify(s, "more rules and rule atoms"),
        vc_followup_kind_pivot())
}

// Probe parity -- candidates is always empty when there's no prior
// (defensive parity with kind_pivot_target).
fn test_clarify_candidates_no_prior_empty() {
    let s = vc_session_new()
    let cands = voice_followup_clarify_candidates(s,
        "tell me more about facts and rules")
    ce_eq("no prior -> empty candidates", len(cands), 0)
}

// ---- R34D: STT confidence threshold + clarifying-question fallback ------
//
// R34D adds a "did I hear you?" gate in front of the dialog state
// machine. When the STT seam reports confidence < threshold (default
// 0.5 milli == 500), the dialog returns "I did not catch that clearly.
// Could you repeat?" instead of advancing the state machine. The env
// `CE_VOICE_STT_CONF_THRESHOLD` overrides the threshold; values are
// integer-percent (50 = 0.5 = 500 milli, 70 = 0.7 = 700 milli).
//
// We do NOT exercise real STT here -- the new `vc_session_turn_with_
// confidence(kg, session, transcript, conf_milli)` takes a plumbed
// confidence so the dialog policy is the unit under test. The
// integration scenario covers the WAV roundtrip.

// Default-threshold env-resolved value: the test runner does NOT set
// `CE_VOICE_STT_CONF_THRESHOLD`, so the resolver should return the
// documented default 500 (= 0.5).
fn test_r34d_default_threshold_is_500_milli() {
    ce_eq("default STT threshold is 500 milli (0.5)",
        vc_voice_stt_threshold_milli(), 500)
}

// Threshold-parser corner cases. We hit `_vd_parse_threshold_env`
// directly (well, via its `vc_voice_stt_threshold_milli` wrapper) by
// going through a helper that constructs synthetic env strings. NOVA's
// test runner has no portable setenv, but we CAN test the pure
// `_vd_parse_threshold_env` via... actually there's no public probe.
// We test the wired path indirectly via the dispatch tests below
// (which use `vc_session_turn_with_confidence` directly).

// Clarify text is the canonical sentence -- byte-identical assertion.
fn test_r34d_clarify_text_is_canonical() {
    ce_str_eq("R34D clarify text",
        vc_voice_stt_clarify_text(),
        "I did not catch that clearly. Could you repeat?")
}

// New sessions report -1 last_stt_confidence (sentinel for "no STT
// result threaded yet"). This is the legacy `vc_session_turn` path's
// behaviour -- it doesn't have a confidence to plumb.
fn test_r34d_new_session_stt_confidence_unset() {
    let s = vc_session_new()
    ce_eq("new session: last_stt_confidence = -1",
        vc_session_last_stt_confidence(s), 0 - 1)
}

// vc_session_reset() restores the -1 sentinel. We populate the slot
// via a high-confidence turn first, then reset, then check.
fn test_r34d_reset_clears_stt_confidence() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    // High-confidence turn: 950 milli is well above the 500 default.
    vc_session_turn_with_confidence(kg, s, "list all FACT", 950)
    ce_eq("after high-conf turn: last_stt_confidence = 950",
        vc_session_last_stt_confidence(s), 950)
    vc_session_reset(s)
    ce_eq("post-reset: last_stt_confidence = -1",
        vc_session_last_stt_confidence(s), 0 - 1)
}

// High-confidence transcript routes to the existing dialog flow. We
// pass 950 (0.95) for a "list all FACT" transcript; the response is
// the canonical R25B sentence, the template moves to LIST_ALL, and
// last_stt_confidence reflects the high value.
fn test_r34d_high_confidence_routes_to_normal_dialog() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn_with_confidence(kg, s, "list all FACT", 950)
    let txt = vc_session_result_text(r)
    ce_str_eq("high-conf list all FACT -> normal R25B response",
        txt, "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("high-conf: template advanced to LIST_ALL",
        vc_session_last_template(s), vc_template_list_all())
    ce_eq("high-conf: last_stt_confidence reflects STT value",
        vc_session_last_stt_confidence(s), 950)
}

// Low-confidence transcript routes to the clarify response and does
// NOT advance the dialog state machine. The session's template stays
// UNKNOWN, no history is appended, but last_stt_confidence reflects
// the (low) value so telemetry can see what was reported.
fn test_r34d_low_confidence_routes_to_clarify() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    // 300 milli (0.3) is below the 500 default threshold.
    let r = vc_session_turn_with_confidence(kg, s, "list all FACT", 300)
    let txt = vc_session_result_text(r)
    ce_str_eq("low-conf transcript -> canonical clarify text",
        txt, "I did not catch that clearly. Could you repeat?")
    ce_eq("low-conf: template NOT advanced (still UNKNOWN)",
        vc_session_last_template(s), vc_template_unknown())
    ce_eq("low-conf: history still empty",
        len(vc_session_history(s)), 0)
    ce_eq("low-conf: turn_count NOT bumped",
        vc_session_turn_count(s), 0)
    ce_eq("low-conf: last_stt_confidence reflects low value",
        vc_session_last_stt_confidence(s), 300)
}

// Exact-threshold case: confidence == threshold routes to the NORMAL
// path (the gate is strict "<"). 500 == default threshold -> high.
fn test_r34d_exact_threshold_routes_to_normal() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn_with_confidence(kg, s, "list all FACT", 500)
    let txt = vc_session_result_text(r)
    ce_str_eq("conf == threshold -> normal R25B (strict <)",
        txt, "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("exact-threshold: template advanced to LIST_ALL",
        vc_session_last_template(s), vc_template_list_all())
}

// Zero-confidence (STT failure / empty transcript path) routes to
// clarify. The seam returns 0 confidence for the stub backend and for
// any whisper-cli error path; the dialog should treat this as "didn't
// hear you" rather than feeding the placeholder string into the parser.
fn test_r34d_zero_confidence_empty_transcript_clarifies() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    // Pair: empty transcript + 0 confidence -> clarify.
    let r = vc_session_turn_with_confidence(kg, s, "", 0)
    let txt = vc_session_result_text(r)
    ce_str_eq("empty transcript + 0 conf -> clarify text",
        txt, "I did not catch that clearly. Could you repeat?")
    ce_eq("zero-conf: history still empty",
        len(vc_session_history(s)), 0)
    ce_eq("zero-conf: last_stt_confidence = 0",
        vc_session_last_stt_confidence(s), 0)
}

// Boundary: conf = threshold - 1 routes to clarify (just below).
fn test_r34d_just_below_threshold_clarifies() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn_with_confidence(kg, s, "list all FACT", 499)
    let txt = vc_session_result_text(r)
    ce_str_eq("499 milli (just below) -> clarify",
        txt, "I did not catch that clearly. Could you repeat?")
}

// last_stt_confidence reflects the MOST RECENT call, even across
// multiple turns. We verify it updates on each call regardless of
// whether the call routed to clarify or normal.
fn test_r34d_last_stt_confidence_tracks_most_recent() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn_with_confidence(kg, s, "list all FACT", 900)
    ce_eq("turn 1: last_stt_confidence = 900",
        vc_session_last_stt_confidence(s), 900)
    vc_session_turn_with_confidence(kg, s, "list all FACT", 200)
    ce_eq("turn 2 (clarify): last_stt_confidence = 200",
        vc_session_last_stt_confidence(s), 200)
    vc_session_turn_with_confidence(kg, s, "tell me more", 950)
    ce_eq("turn 3: last_stt_confidence = 950",
        vc_session_last_stt_confidence(s), 950)
}

// After a low-conf turn the dialog state is intact; the NEXT high-conf
// turn proceeds as if the low-conf turn never happened. This is the
// key invariant: a misheard utterance doesn't poison subsequent turns.
fn test_r34d_low_conf_turn_then_high_conf_advances() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    // Misheard low-conf turn -- clarifies, no state change.
    vc_session_turn_with_confidence(kg, s, "list all FACT", 200)
    ce_eq("post-misheard: template still UNKNOWN",
        vc_session_last_template(s), vc_template_unknown())
    // High-conf turn -- proceeds normally.
    let r2 = vc_session_turn_with_confidence(kg, s, "list all FACT", 900)
    let txt2 = vc_session_result_text(r2)
    ce_str_eq("retry high-conf -> normal response",
        txt2, "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("retry: template now LIST_ALL",
        vc_session_last_template(s), vc_template_list_all())
}

// R31F kind-pivot regression: the kind-pivot routing (R25B.5) still
// works for high-confidence transcripts. Prior FACT, then a tell-me-
// more about RULE kind should KIND_PIVOT to RULE.
fn test_r34d_r31f_kind_pivot_intact_for_high_confidence() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn_with_confidence(kg, s, "list all FACT", 900)
    ce_eq("prior turn: template LIST_ALL",
        vc_session_last_template(s), vc_template_list_all())
    ce_str_eq("prior turn: kind FACT",
        vc_session_last_kind(s), "FACT")
    // High-conf KIND_PIVOT to RULE: the more-cue path with "rule" in
    // the remainder should pivot.
    let r2 = vc_session_turn_with_confidence(kg, s,
        "tell me more about RULE atoms", 850)
    ce_str_eq("R31F kind-pivot intact: kind now RULE",
        vc_session_last_kind(s), "RULE")
    let txt2 = vc_session_result_text(r2)
    // RULE has no atoms in the fixture -> "No RULE atoms found.".
    ce_str_eq("R31F kind-pivot result text",
        txt2, "No RULE atoms found.")
}

// R32F multi-kind clarify regression: an ambiguous remainder (2+
// known kinds) with high confidence still emits the "Did you mean
// X or Y?" question. The STT-confidence gate must not interfere with
// the higher-level R32F multi-kind clarify state machine.
fn test_r34d_r32f_multi_kind_clarify_intact_for_high_confidence() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn_with_confidence(kg, s, "list all CONCEPT", 900)
    // Remainder "facts and rules" names two kinds different from
    // CONCEPT -> CLARIFY classifier emits the "Did you mean...?"
    let r2 = vc_session_turn_with_confidence(kg, s,
        "tell me more about facts and rules", 850)
    let txt2 = vc_session_result_text(r2)
    ce_str_eq("R32F multi-kind clarify intact",
        txt2, "Did you mean FACT or RULE atoms?")
    ce_eq("R32F: pending clarify set",
        vc_session_is_pending_clarify(s), 1)
}

// A LOW-conf turn during an active R32F pending-clarify does NOT
// advance the multi-kind state machine: the operator should be asked
// to repeat themselves, and the pending-clarify candidates remain
// intact for the next try.
fn test_r34d_low_conf_during_pending_clarify_preserves_state() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn_with_confidence(kg, s, "list all CONCEPT", 900)
    vc_session_turn_with_confidence(kg, s,
        "tell me more about facts and rules", 850)
    // Pending clarify is active. A low-conf "RULE" reply should NOT
    // resolve it -- the operator might have said something else.
    ce_eq("pre-low-conf: pending clarify set",
        vc_session_is_pending_clarify(s), 1)
    let r3 = vc_session_turn_with_confidence(kg, s, "RULE", 200)
    let txt3 = vc_session_result_text(r3)
    ce_str_eq("low-conf during pending clarify -> clarify text",
        txt3, "I did not catch that clearly. Could you repeat?")
    // Pending clarify state preserved.
    ce_eq("post-low-conf: pending clarify still set",
        vc_session_is_pending_clarify(s), 1)
}

// Threshold parser unit tests via the wired probe. We can't directly
// drive the env var from inside NOVA tests (the runner exports a fixed
// env), but we CAN verify the default path via the public probe + the
// dispatch tests above. Additionally we run the parser via a synthetic
// shape: confidence 500 vs 499 around the documented default.
fn test_r34d_threshold_gate_is_strict_less_than() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    // 500 (== threshold) -> high. Already covered in the exact-
    // threshold test above; we add a 501 case for parity (above
    // threshold by 1 milli).
    let r = vc_session_turn_with_confidence(kg, s, "list all FACT", 501)
    let txt = vc_session_result_text(r)
    ce_str_eq("501 milli (above threshold) -> normal",
        txt, "Found 3 FACT atoms: ids 0, 1, 2.")
}

// Whisper-side heuristic helper -- explicit unit tests for the pure
// `whisper_heuristic_confidence_milli` function. Empty transcript +
// empty error -> 0 (can't be confident in nothing). Non-empty
// transcript + empty error -> 900 (we got SOMETHING). Any error
// regardless of transcript -> 0.
fn test_r34d_heuristic_empty_transcript_is_zero() {
    ce_eq("heuristic: empty transcript + no error -> 0",
        whisper_heuristic_confidence_milli("", ""), 0)
}

fn test_r34d_heuristic_non_empty_transcript_is_900() {
    ce_eq("heuristic: 'hello' + no error -> 900",
        whisper_heuristic_confidence_milli("hello", ""), 900)
}

fn test_r34d_heuristic_error_overrides_transcript() {
    ce_eq("heuristic: 'hello' + 'binary not found' -> 0",
        whisper_heuristic_confidence_milli("hello", "binary not found"), 0)
}

// Direct delegation: vc_session_turn() and vc_session_turn_with_
// confidence() with a high-conf value should produce byte-identical
// session state. The STT-confidence wrapper is purely additive on the
// pass-through path; it must not alter the dialog state machine.
fn test_r34d_high_conf_path_is_byte_identical_to_session_turn() {
    let kg1 = _fixture_kg()
    let s1 = vc_session_new()
    vc_session_turn(kg1, s1, "list all FACT")
    let kg2 = _fixture_kg()
    let s2 = vc_session_new()
    vc_session_turn_with_confidence(kg2, s2, "list all FACT", 1000)
    ce_eq("byte-identical template",
        vc_session_last_template(s1), vc_session_last_template(s2))
    ce_str_eq("byte-identical kind",
        vc_session_last_kind(s1), vc_session_last_kind(s2))
    ce_eq("byte-identical turn_count",
        vc_session_turn_count(s1), vc_session_turn_count(s2))
    ce_eq("byte-identical history length",
        len(vc_session_history(s1)), len(vc_session_history(s2)))
}

// ---- main ---------------------------------------------------------------

fn main() {
    // session bookkeeping
    test_session_new_is_empty()
    test_session_reset_clears_state()
    // R25B parity
    test_single_turn_list_all()
    test_single_turn_how_many()
    test_single_turn_unknown_pattern_apology()
    // tell me more
    test_more_request_escalates_limit()
    test_more_request_without_prior_complains()
    // anaphora
    test_anaphora_describe_it_resolves_to_first_id()
    test_anaphora_what_is_it_after_what_is()
    test_anaphora_without_prior_complains()
    // ordinal anaphora
    test_ordinal_second_one_resolves_to_index_1()
    test_ordinal_what_is_the_third_one()
    test_ordinal_last_one_resolves_to_tail()
    // pivot
    test_pivot_what_about_concept()
    // topic shift
    test_topic_shift_actually_resets_and_parses_rest()
    test_topic_shift_bare_acknowledges_and_resets()
    // history cap
    test_history_caps_at_5_turns()
    // R25B.3 -- topic-shift classifier
    test_classify_no_prior_returns_none()
    test_classify_bare_more_is_continue()
    test_classify_more_with_unrelated_remainder_is_pivot()
    test_classify_what_about_kind_is_pivot()
    test_classify_anaphora_priority()
    test_classify_same_kind_remainder_is_continue()
    test_classify_describe_with_content_word()
    test_classify_and_with_unrelated_remainder_is_pivot()
    test_classify_also_cue_unrelated_is_pivot()
    // R25B.3 -- 3-turn dispatch fixtures
    test_three_turn_continue_byte_identical()
    test_three_turn_pivot_unrelated_remainder()
    test_three_turn_pivot_what_about_kind()
    test_three_turn_anaphora_unchanged()
    test_dispatch_pivot_does_not_escalate_limit()
    test_r28d_parity_smoke()
    // R25B.4 -- morphology + weighted Jaccard
    test_morph_stem_basic_plurals()
    test_morph_stem_singular_unchanged()
    test_morph_stem_short_word_preserved()
    test_morph_stem_suffix_quirks()
    test_morph_stem_ies_to_y()
    test_morph_stem_no_trailing_s_unchanged()
    test_weighted_score_kind_match_double_weight()
    test_weighted_score_no_kind_match_zero()
    test_weighted_score_mixed_kind_and_other()
    test_weighted_score_empty_prior()
    test_weighted_score_empty_now()
    test_classify_more_facts_after_fact_is_continue()
    test_classify_more_rules_after_rule_is_continue()
    test_classify_r29c_failure_case_after_fact_is_pivot()
    test_classify_r29c_correct_case_after_rule_is_continue()
    test_classify_more_about_cats_after_fact_still_pivot()
    test_classify_what_about_rule_atoms_after_fact_is_pivot()
    test_classify_weighted_lift_long_remainder()
    test_classify_and_facts_after_fact_is_continue()
    test_classify_more_dogs_after_fact_still_pivot()
    test_dispatch_morphology_continue_escalates_limit()
    test_dispatch_more_rules_continues_rule_topic()
    // R25B.5 (R31F / R30F.2) -- kind-pivot routing
    test_kind_pivot_more_about_rule_atoms_after_fact()
    test_kind_pivot_rule_engine_after_fact()
    test_kind_pivot_more_about_facts_after_rule()
    test_kind_pivot_more_about_cats_stays_pivot()
    test_kind_pivot_bare_more_stays_continue()
    test_kind_pivot_same_kind_remainder_stays_continue()
    test_kind_pivot_anaphora_paths_unchanged()
    test_kind_pivot_target_returns_empty_on_non_pivot()
    test_kind_pivot_target_what_about_path()
    test_dispatch_kind_pivot_runs_fresh_query()
    test_dispatch_kind_pivot_via_morphology()
    test_dispatch_kind_pivot_what_about_matches_prior_endstate()
    test_kind_pivot_multi_kind_ambiguous_picks_first()
    test_kind_pivot_and_dogs_stays_pivot()
    test_kind_pivot_and_concept_after_fact()
    // R25B.6 (R32F / R31F.2) -- multi-kind clarifying question
    test_clarify_constant_distinct()
    test_clarify_max_attempts_accessor()
    test_multi_kind_detector_two_kinds()
    test_multi_kind_detector_dedup()
    test_multi_kind_detector_excludes_prior()
    test_multi_kind_detector_three_kinds()
    test_multi_kind_detector_no_match()
    test_clarify_classifier_two_kinds()
    test_clarify_candidates_probe_two_kinds()
    test_clarify_single_kind_still_kind_pivot()
    test_clarify_no_kind_still_pivot()
    test_clarify_render_two()
