// Unit tests for examples/voice_dialog.nova (R25B.2).
//
// Covers:
//   * Session bookkeeping -- new / reset / history cap at 5 turns.
//   * Single turn -- same shape as R25B (the R25B parser path is the
//     fallback for transcripts that don't match a follow-up pattern).
//   * "Tell me more" -- escalates LIMIT, re-runs LIST_ALL on prior kind.
//   * Anaphora -- "describe it" / "what is it" resolves to last ids[0].
//   * Ordinal anaphora -- "the second one" -> last_ids[1].
//   * "what about X" / "and X" -- pivots prior template onto new kind.
//   * Topic shift -- "actually X" / "never mind" reset the session.
//
// We do NOT exercise the STT or TTS legs here -- vc_session_turn takes
// already-transcribed text so the dialog state machine is the unit
// under test. The integration scenario covers the WAV roundtrip.
//
// We build a real R15D KG with a handful of FACT / CONCEPT / RELATION
// atoms so the SPARQL executor returns real bindings; the dialog layer
// then has actual ids to anaphor against.

import "std/syscall"
import "../ce_test.nova"
import "../../examples/voice_dialog.nova"
import "../../src/kg/atom_store.nova"
import "../../src/kg/multi_kg_manager.nova"

// ---- KG fixture ----------------------------------------------------------

// Build a small KG: 3 FACT atoms (ids 0..2), 2 CONCEPT atoms (ids 3..4),
// 1 RELATION (id 5). The ids are 0-indexed in order of insertion (the
// R15D convention; see tests/unit/test_kg_query.nova for the same shape).
fn _fixture_kg() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "dialog_test")
    kg_add_atom(kg, ATOM_FACT,    "f1", 1000)
    kg_add_atom(kg, ATOM_FACT,    "f2", 1100)
    kg_add_atom(kg, ATOM_FACT,    "f3", 1200)
    kg_add_atom(kg, ATOM_CONCEPT, "c1", 1500)
    kg_add_atom(kg, ATOM_CONCEPT, "c2", 1600)
    kg_add_atom(kg, ATOM_RELATION, "r1", 1700)
    return kg
}

// ---- session bookkeeping -------------------------------------------------

fn test_session_new_is_empty() {
    let s = vc_session_new()
    ce_eq("new session: history empty",
        len(vc_session_history(s)), 0)
    ce_eq("new session: turn_count 0",
        vc_session_turn_count(s), 0)
    ce_eq("new session: last_template UNKNOWN",
        vc_session_last_template(s), vc_template_unknown())
}

fn test_session_reset_clears_state() {
    let s = vc_session_new()
    let kg = _fixture_kg()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("pre-reset: turn_count 1",
        vc_session_turn_count(s), 1)
    vc_session_reset(s)
    ce_eq("post-reset: history empty",
        len(vc_session_history(s)), 0)
    ce_eq("post-reset: turn_count 0",
        vc_session_turn_count(s), 0)
    ce_eq("post-reset: last_template UNKNOWN",
        vc_session_last_template(s), vc_template_unknown())
}

// ---- single turn (R25B parity) -------------------------------------------

fn test_single_turn_list_all() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn(kg, s, "list all FACT")
    let txt = vc_session_result_text(r)
    // The KG has 3 FACTs (ids 0, 1, 2). The R25B formatter says
    // "Found 3 FACT atoms: ids 0, 1, 2.".
    ce_str_eq("single LIST_ALL FACT response",
        txt, "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("post-turn: template LIST_ALL",
        vc_session_last_template(s), vc_template_list_all())
    ce_str_eq("post-turn: kind FACT",
        vc_session_last_kind(s), "FACT")
    let ids = vc_session_last_ids(s)
    ce_eq("post-turn: 3 ids captured", len(ids), 3)
    ce_eq("post-turn: ids[0] = 0", ids[0], 0)
    ce_eq("post-turn: ids[1] = 1", ids[1], 1)
}

fn test_single_turn_how_many() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn(kg, s, "how many FACT")
    let txt = vc_session_result_text(r)
    ce_str_eq("how many FACT -> count sentence",
        txt, "There are 3 FACT atoms.")
    ce_eq("post-turn: template HOW_MANY",
        vc_session_last_template(s), vc_template_how_many())
    // HOW_MANY doesn't carry entity ids, so last_ids is empty.
    ce_eq("post-turn: ids empty for HOW_MANY",
        len(vc_session_last_ids(s)), 0)
}

fn test_single_turn_unknown_pattern_apology() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn(kg, s, "tell me a joke")
    let txt = vc_session_result_text(r)
    ce_str_eq("unknown -> R25B apology",
        txt, "I do not know how to answer that question.")
    // Unknown does NOT push a turn into history.
    ce_eq("unknown: history still empty",
        len(vc_session_history(s)), 0)
}

// ---- "tell me more" -------------------------------------------------------

fn test_more_request_escalates_limit() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("first turn: limit 10",
        vc_session_last_limit(s), 10)
    let r2 = vc_session_turn(kg, s, "tell me more")
    let txt2 = vc_session_result_text(r2)
    // KG only has 3 FACTs but LIST_ALL with LIMIT 20 still returns 3.
    // The escalation is observable: last_limit should now be 20.
    ce_eq("more: limit doubled to 20",
        vc_session_last_limit(s), 20)
    ce_str_eq("more: re-runs LIST_ALL on prior kind",
        txt2, "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("more: template still LIST_ALL",
        vc_session_last_template(s), vc_template_list_all())
}

fn test_more_request_without_prior_complains() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn(kg, s, "tell me more")
    let txt = vc_session_result_text(r)
    ce_str_eq("more without prior -> complaint",
        txt, "There is nothing yet. Please ask a question first.")
}

// ---- anaphora ------------------------------------------------------------

fn test_anaphora_describe_it_resolves_to_first_id() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    let r = vc_session_turn(kg, s, "describe it")
    let txt = vc_session_result_text(r)
    // last_ids = [0, 1, 2]; "describe it" -> ids[0] = 0.
    ce_str_eq("describe it -> id 0",
        txt, "That FACT atom has id 0.")
    ce_eq("describe it: template now WHAT_IS",
        vc_session_last_template(s), vc_template_what_is())
}

fn test_anaphora_what_is_it_after_what_is() {
    // Chain: "what is X" -> bindings carries ids -> "what is it"
    // resolves to that first id. (Anaphora chains across WHAT_IS.)
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "what is CONCEPT")
    let ids_after_first = vc_session_last_ids(s)
    ce_eq("what is CONCEPT: 1 id captured",
        len(ids_after_first), 1)
    let first_id = ids_after_first[0]
    let r = vc_session_turn(kg, s, "what is it")
    let txt = vc_session_result_text(r)
    ce_str_eq("what is it -> id mirrored",
        txt, "That CONCEPT atom has id " + int_to_str(first_id) + ".")
}

fn test_anaphora_without_prior_complains() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r = vc_session_turn(kg, s, "describe it")
    let txt = vc_session_result_text(r)
    ce_str_eq("describe it without prior -> complaint",
        txt, "I do not have a previous result to describe.")
}

// ---- ordinal anaphora ----------------------------------------------------

fn test_ordinal_second_one_resolves_to_index_1() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    let r = vc_session_turn(kg, s, "the second one")
    let txt = vc_session_result_text(r)
    // last_ids = [0, 1, 2]; "the second one" -> ids[1] = 1.
    ce_str_eq("the second one -> id 1",
        txt, "That FACT atom has id 1.")
}

fn test_ordinal_what_is_the_third_one() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    let r = vc_session_turn(kg, s, "what is the third one")
    let txt = vc_session_result_text(r)
    ce_str_eq("what is the third one -> id 2",
        txt, "That FACT atom has id 2.")
}

fn test_ordinal_last_one_resolves_to_tail() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    let r = vc_session_turn(kg, s, "the last one")
    let txt = vc_session_result_text(r)
    // 3 FACTs; last = ids[2] = 2.
    ce_str_eq("the last one -> id 2",
        txt, "That FACT atom has id 2.")
}

// ---- "what about X" / "and X" pivot --------------------------------------

fn test_pivot_what_about_concept() {
    // Prior: "list all FACT" -> reuse LIST_ALL with CONCEPT.
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    let r = vc_session_turn(kg, s, "what about CONCEPT")
    let txt = vc_session_result_text(r)
    // KG has 2 CONCEPT atoms at ids 3, 4.
    ce_str_eq("what about CONCEPT -> LIST_ALL CONCEPT",
        txt, "Found 2 CONCEPT atoms: ids 3, 4.")
    ce_str_eq("post-pivot: kind is CONCEPT",
        vc_session_last_kind(s), "CONCEPT")
}

// ---- topic shift ---------------------------------------------------------

fn test_topic_shift_actually_resets_and_parses_rest() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("pre-shift: history size 1",
        len(vc_session_history(s)), 1)
    let r = vc_session_turn(kg, s, "actually list all CONCEPT")
    let txt = vc_session_result_text(r)
    // The shift resets THEN parses "list all CONCEPT" fresh.
    ce_str_eq("actually list all CONCEPT -> CONCEPT result",
        txt, "Found 2 CONCEPT atoms: ids 3, 4.")
    // History: shift reset, then one fresh turn pushed.
    ce_eq("post-shift+parse: history size 1",
        len(vc_session_history(s)), 1)
    ce_str_eq("post-shift+parse: kind CONCEPT",
        vc_session_last_kind(s), "CONCEPT")
}

fn test_topic_shift_bare_acknowledges_and_resets() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    let r = vc_session_turn(kg, s, "never mind")
    let txt = vc_session_result_text(r)
    ce_str_eq("never mind -> acknowledgement",
        txt, "Okay, let us change the topic. What would you like to know?")
    ce_eq("never mind: history wiped",
        len(vc_session_history(s)), 0)
    ce_eq("never mind: template UNKNOWN",
        vc_session_last_template(s), vc_template_unknown())
}

// ---- history cap (5 turns) -----------------------------------------------

fn test_history_caps_at_5_turns() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    // 7 successful turns; only the last 5 should remain.
    vc_session_turn(kg, s, "list all FACT")
    vc_session_turn(kg, s, "list all CONCEPT")
    vc_session_turn(kg, s, "list all RELATION")
    vc_session_turn(kg, s, "how many FACT")
    vc_session_turn(kg, s, "how many CONCEPT")
    vc_session_turn(kg, s, "list all FACT")
    vc_session_turn(kg, s, "list all CONCEPT")
    let hist = vc_session_history(s)
    ce_eq("after 7 turns: history capped at 5",
        len(hist), 5)
    // The MONOTONIC turn_count survives the cap.
    ce_eq("turn_count survives cap",
        vc_session_turn_count(s), 7)
    // The OLDEST surviving entry should be the 3rd ingestion
    // (turn index 2 in insertion order -- "list all RELATION").
    let oldest = hist[0]
    ce_str_eq("oldest surviving: 'list all RELATION'",
        vc_turn_question(oldest), "list all RELATION")
    // Newest is the 7th: "list all CONCEPT".
    let newest = hist[len(hist) - 1]
    ce_str_eq("newest surviving: 'list all CONCEPT'",
        vc_turn_question(newest), "list all CONCEPT")
}

// ---- R25B.3 follow-up classifier + topic-shift detection ----------------
//
// The R28D dialog manager assumed every "tell me more" was a continuation
// of the prior topic. R29C extends that with content-word Jaccard: when
// the user says "tell me more about cats" after "list all FACT", the
// "cats" tail is unrelated to "fact" so the turn is a PIVOT, not a
// CONTINUE. Anaphora resolution wins over pivot detection so "describe
// the first one" still resolves to last_ids[0] (the word "first" is a
// stopword, not a content signal). Tests cover the four classifier
// outputs + the runtime dispatch behaviour they trigger.

// Classifier: no prior turn -> NONE.
fn test_classify_no_prior_returns_none() {
    let s = vc_session_new()
    ce_eq("classify empty session 'tell me more' -> NONE",
        voice_followup_classify(s, "tell me more"), vc_followup_none())
    ce_eq("classify empty session 'describe it' -> NONE",
        voice_followup_classify(s, "describe it"), vc_followup_none())
    ce_eq("classify empty session 'list all FACT' -> NONE",
        voice_followup_classify(s, "list all FACT"), vc_followup_none())
    ce_eq("classify empty session '' -> NONE",
        voice_followup_classify(s, ""), vc_followup_none())
}

// Classifier: bare "tell me more" after a prior turn -> CONTINUE (no
// content-words in the remainder; nothing to disagree with).
fn test_classify_bare_more_is_continue() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'tell me more' after prior -> CONTINUE",
        voice_followup_classify(s, "tell me more"), vc_followup_continue())
    ce_eq("'more' after prior -> CONTINUE",
        voice_followup_classify(s, "more"), vc_followup_continue())
    ce_eq("'tell me more about it' after prior -> CONTINUE",
        voice_followup_classify(s, "tell me more about it"), vc_followup_continue())
}

// Classifier: "tell me more about cats" -- "cats" unrelated to prior
// "fact" -> PIVOT.
fn test_classify_more_with_unrelated_remainder_is_pivot() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'tell me more about cats' after FACT prior -> PIVOT",
        voice_followup_classify(s, "tell me more about cats"),
        vc_followup_pivot())
    ce_eq("'more about dogs' after FACT prior -> PIVOT",
        voice_followup_classify(s, "more about dogs"),
        vc_followup_pivot())
}

// Classifier: "what about RULE atoms" -- explicit kind pivot -> PIVOT.
fn test_classify_what_about_kind_is_pivot() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'what about RULE atoms' after prior -> PIVOT",
        voice_followup_classify(s, "what about RULE atoms"),
        vc_followup_pivot())
    ce_eq("'what about CONCEPT' after prior -> PIVOT",
        voice_followup_classify(s, "what about CONCEPT"),
        vc_followup_pivot())
    ce_eq("'how about SKILL' after prior -> PIVOT",
        voice_followup_classify(s, "how about SKILL"),
        vc_followup_pivot())
}

// Classifier: anaphora wins over pivot. "describe the first one" must
// be ANAPHORA -- even though "first" could read as a content word, the
// stopword list excludes it.
fn test_classify_anaphora_priority() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'describe the first one' -> ANAPHORA",
        voice_followup_classify(s, "describe the first one"),
        vc_followup_anaphora())
    ce_eq("'the second one' -> ANAPHORA",
        voice_followup_classify(s, "the second one"),
        vc_followup_anaphora())
    ce_eq("'describe it' -> ANAPHORA",
        voice_followup_classify(s, "describe it"),
        vc_followup_anaphora())
    ce_eq("'tell me about it' -> ANAPHORA",
        voice_followup_classify(s, "tell me about it"),
        vc_followup_anaphora())
    ce_eq("'the last one' -> ANAPHORA",
        voice_followup_classify(s, "the last one"),
        vc_followup_anaphora())
}

// Classifier: same kind word in remainder as prior -> CONTINUE.
fn test_classify_same_kind_remainder_is_continue() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    // "and FACT" -- the remainder content is exactly the prior content;
    // Jaccard = 1.0, well above 0.2 -> CONTINUE.
    ce_eq("'and FACT' after FACT prior -> CONTINUE",
        voice_followup_classify(s, "and FACT"),
        vc_followup_continue())
    // "more fact" -- same singular word -> CONTINUE.
    ce_eq("'more fact' approximation -> CONTINUE (single-word overlap)",
        voice_followup_classify(s, "more fact"),
        vc_followup_continue())
}

// 3-turn fixture (extends R28D's): "list all FACT" -> "tell me more"
// -> CONTINUE. Same byte-identical state transitions as R28D.
fn test_three_turn_continue_byte_identical() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r1 = vc_session_turn(kg, s, "list all FACT")
    ce_str_eq("turn 1: LIST_ALL FACT response",
        vc_session_result_text(r1), "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("turn 1: limit base 10", vc_session_last_limit(s), 10)
    ce_eq("turn 1: history size 1", len(vc_session_history(s)), 1)

    let r2 = vc_session_turn(kg, s, "tell me more")
    ce_str_eq("turn 2: more re-runs LIST_ALL with doubled LIMIT",
        vc_session_result_text(r2), "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("turn 2: limit doubled to 20", vc_session_last_limit(s), 20)
    ce_eq("turn 2: still LIST_ALL template",
        vc_session_last_template(s), vc_template_list_all())
    ce_str_eq("turn 2: kind FACT preserved",
        vc_session_last_kind(s), "FACT")
    ce_eq("turn 2: history size 2", len(vc_session_history(s)), 2)
    ce_eq("turn 2: turn_count 2", vc_session_turn_count(s), 2)
}

// 3-turn pivot fixture: "list all FACT" -> "tell me more about cats"
// -> PIVOT. Session state is reset; "cats" is not a known kind so
// R25B's parser returns UNKNOWN, but the pivot turn IS recorded in
// history. The LIMIT does NOT escalate; the prior-kind context is
// gone.
fn test_three_turn_pivot_unrelated_remainder() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("pre-pivot: limit 10", vc_session_last_limit(s), 10)
    ce_eq("pre-pivot: history size 1", len(vc_session_history(s)), 1)

    let r = vc_session_turn(kg, s, "tell me more about cats")
    let txt = vc_session_result_text(r)
    // "cats" is not a known kind; R25B parses as UNKNOWN. The pivot
    // path still records the turn so the operator sees the shift.
    ce_str_eq("'tell me more about cats' -> UNKNOWN apology",
        txt, "I do not know how to answer that question.")
    // LIMIT must NOT escalate -- pivot reset it to base.
    ce_eq("post-pivot: limit reset to base",
        vc_session_last_limit(s), 10)
    // Template / kind cleared (pivot resets prior context, and the
    // UNKNOWN parse does not re-establish it).
    ce_eq("post-pivot: template UNKNOWN",
        vc_session_last_template(s), vc_template_unknown())
    ce_str_eq("post-pivot: kind cleared",
        vc_session_last_kind(s), "")
    // History should still contain the pivot turn (brief: "history
    // still records the pivot turn"). The reset wiped the FACT turn,
    // then the pivot fresh-turn helper appended its own.
    ce_eq("post-pivot: history records the pivot turn",
        len(vc_session_history(s)), 1)
    let pivot_turn = vc_session_history(s)[0]
    ce_str_eq("post-pivot: history holds pivot question",
        vc_turn_question(pivot_turn), "tell me more about cats")
}

// "list all FACT" -> "what about RULE atoms" -> PIVOT. Existing
// template-preserving kind-pivot path; reuses LIST_ALL with RULE.
fn test_three_turn_pivot_what_about_kind() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("pre-pivot: classifier sees PIVOT",
        voice_followup_classify(s, "what about RULE atoms"),
        vc_followup_pivot())
    let r = vc_session_turn(kg, s, "what about RULE atoms")
    let txt = vc_session_result_text(r)
    // The KG fixture has zero RULE atoms (only FACT / CONCEPT / RELATION).
    ce_str_eq("'what about RULE atoms' -> LIST_ALL RULE empty",
        txt, "No RULE atoms found.")
    ce_str_eq("post-pivot: kind is RULE",
        vc_session_last_kind(s), "RULE")
    ce_eq("post-pivot: template LIST_ALL preserved",
        vc_session_last_template(s), vc_template_list_all())
    // History captures BOTH turns (R25B.2 behaviour: pivot does NOT
    // reset history, only the more-cue-with-unrelated-remainder path
    // does that).
    ce_eq("post-pivot: history has both turns",
        len(vc_session_history(s)), 2)
}

// "list all FACT" -> "describe the first one" -> ANAPHORA. Existing
// behaviour: resolve to last_ids[0]. R28D parity assertion -- R29C
// must not regress.
fn test_three_turn_anaphora_unchanged() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("pre-anaphora: classifier sees ANAPHORA",
        voice_followup_classify(s, "describe the first one"),
        vc_followup_anaphora())
    let r = vc_session_turn(kg, s, "describe the first one")
    let txt = vc_session_result_text(r)
    // The R28D ordinal path resolves "the first one" via WHAT_IS at
    // ids[0] = 0.
    ce_str_eq("'describe the first one' -> id 0",
        txt, "That FACT atom has id 0.")
    ce_eq("post-anaphora: template WHAT_IS",
        vc_session_last_template(s), vc_template_what_is())
    ce_str_eq("post-anaphora: kind FACT preserved",
        vc_session_last_kind(s), "FACT")
}

// Stopword stripping smoke test -- the classifier should treat
// "describe the first one" as ANAPHORA. Included here for
// self-documenting symmetry with the next assertion.
fn test_classify_describe_with_content_word() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'describe the first one' -> ANAPHORA",
        voice_followup_classify(s, "describe the first one"),
        vc_followup_anaphora())
}

// Pivot via "and X" cue (X unrelated): "list all FACT" -> "and dogs"
// should be PIVOT (Jaccard = 0).
fn test_classify_and_with_unrelated_remainder_is_pivot() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'and dogs' after FACT -> PIVOT",
        voice_followup_classify(s, "and dogs"),
        vc_followup_pivot())
}

// Multi-cue robustness: "also cats" -- "also" is a cue stopword,
// "cats" alone is the content set; FACT prior -> PIVOT.
fn test_classify_also_cue_unrelated_is_pivot() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    ce_eq("'also cats' after FACT -> PIVOT",
        voice_followup_classify(s, "also cats"),
        vc_followup_pivot())
}

// Runtime dispatch: pivot via more-cue does NOT escalate LIMIT.
fn test_dispatch_pivot_does_not_escalate_limit() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    vc_session_turn(kg, s, "tell me more")  // limit -> 20
    ce_eq("pre-pivot: limit escalated to 20",
        vc_session_last_limit(s), 20)
    vc_session_turn(kg, s, "tell me more about cats")
    ce_eq("post-pivot: limit reset to base 10",
        vc_session_last_limit(s), 10)
}

// Cumulative R28D parity: after the R29C changes the original R28D
// dispatcher must still emit the exact strings R28D published. We
// re-assert the load-bearing transitions here. Note: the prior turn
// was WHAT_IS (from "describe it"), so the pivot reuses WHAT_IS over
// CONCEPT -- that's the documented R28D pivot semantics.
fn test_r28d_parity_smoke() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r1 = vc_session_turn(kg, s, "list all FACT")
    ce_str_eq("R28D parity: list all FACT",
        vc_session_result_text(r1), "Found 3 FACT atoms: ids 0, 1, 2.")
    let r2 = vc_session_turn(kg, s, "tell me more")
    ce_str_eq("R28D parity: tell me more",
        vc_session_result_text(r2), "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("R28D parity: limit doubled",
        vc_session_last_limit(s), 20)
    let r3 = vc_session_turn(kg, s, "describe it")
    ce_str_eq("R28D parity: describe it -> id 0",
        vc_session_result_text(r3), "That FACT atom has id 0.")
    // After "describe it" the template is WHAT_IS; pivot reuses it.
    let r4 = vc_session_turn(kg, s, "what about CONCEPT")
    ce_str_eq("R28D parity: what about CONCEPT (reuses WHAT_IS)",
        vc_session_result_text(r4), "The first CONCEPT atom has id 3.")
}

// ---- main ---------------------------------------------------------------

fn main() {
    // session bookkeeping
    test_session_new_is_empty()
    test_session_reset_clears_state()
    // R25B parity
    test_single_turn_list_all()
    test_single_turn_how_many()
    test_single_turn_unknown_pattern_apology()
    // tell me more
    test_more_request_escalates_limit()
    test_more_request_without_prior_complains()
    // anaphora
    test_anaphora_describe_it_resolves_to_first_id()
    test_anaphora_what_is_it_after_what_is()
    test_anaphora_without_prior_complains()
    // ordinal anaphora
    test_ordinal_second_one_resolves_to_index_1()
    test_ordinal_what_is_the_third_one()
    test_ordinal_last_one_resolves_to_tail()
    // pivot
    test_pivot_what_about_concept()
    // topic shift
    test_topic_shift_actually_resets_and_parses_rest()
    test_topic_shift_bare_acknowledges_and_resets()
    // history cap
    test_history_caps_at_5_turns()
    // R25B.3 -- topic-shift classifier
    test_classify_no_prior_returns_none()
    test_classify_bare_more_is_continue()
    test_classify_more_with_unrelated_remainder_is_pivot()
    test_classify_what_about_kind_is_pivot()
    test_classify_anaphora_priority()
    test_classify_same_kind_remainder_is_continue()
    test_classify_describe_with_content_word()
    test_classify_and_with_unrelated_remainder_is_pivot()
    test_classify_also_cue_unrelated_is_pivot()
    // R25B.3 -- 3-turn dispatch fixtures
    test_three_turn_continue_byte_identical()
    test_three_turn_pivot_unrelated_remainder()
    test_three_turn_pivot_what_about_kind()
    test_three_turn_anaphora_unchanged()
    test_dispatch_pivot_does_not_escalate_limit()
    test_r28d_parity_smoke()
    ce_summary("voice_dialog")
}

main()
