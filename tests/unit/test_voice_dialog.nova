// ---- R25B.6 multi-kind clarifying question (R32F / R31F.2) -------------
//
// R31F's exit report explicitly named the deferred fix: "multi-kind
// ambiguous remainder ('more facts and rules' after CONCEPT finds TWO
// known kinds). `_vd_remainder_known_kind` returns the FIRST match in
// tokeniser order... future fix would add a confidence threshold or an
// explicit disambiguation turn."
//
// R32F implements option (b/c hybrid): a new classifier output
// `VC_FOLLOWUP_CLARIFY` fires when the more-cue remainder names 2+
// known kinds (unless CE_VOICE_NO_CLARIFY=1 forces R31F's first-match
// fallback). The dispatcher emits "Did you mean RULE or FACT atoms?"
// and stashes the candidates in a new session slot; the NEXT user turn
// is parsed as a kind-selector first (bare kind name, morphology
// phrase, or "both" / "either" / "all" -> first-match shortcut). After
// VC_DIALOG_CLARIFY_MAX_ATTEMPTS (2) failed resolution turns we give
// up and route as PIVOT with an apologetic message + first-match
// dispatch so the operator still gets a usable answer.
//
// Coverage: 25+ new assertions across 15 new test functions.

// New classifier output -- the accessor returns 5 (next after the four
// existing classes).
fn test_clarify_constant_distinct() {
    ce_eq("CLARIFY constant = 5",
        vc_followup_clarify(), 5)
    // Existing four still distinct.
    ce_eq("NONE = 0", vc_followup_none(), 0)
    ce_eq("CONTINUE = 1", vc_followup_continue(), 1)
    ce_eq("PIVOT = 2", vc_followup_pivot(), 2)
    ce_eq("ANAPHORA = 3", vc_followup_anaphora(), 3)
    ce_eq("KIND_PIVOT = 4", vc_followup_kind_pivot(), 4)
}

// Max-attempts cap accessor -- exposes the constant so tests can
// drive the give-up path deterministically.
fn test_clarify_max_attempts_accessor() {
    ce_eq("max-attempts cap = 2",
        vc_dialog_clarify_max_attempts(), 2)
}

// Multi-kind detector: deduplicated UPPER-CASE list in tokeniser order.
