// Cumulative R28D parity: after the R29C changes the original R28D
// dispatcher must still emit the exact strings R28D published. We
// re-assert the load-bearing transitions here. Note: the prior turn
// was WHAT_IS (from "describe it"), so the pivot reuses WHAT_IS over
// CONCEPT -- that's the documented R28D pivot semantics.
fn test_r28d_parity_smoke() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    let r1 = vc_session_turn(kg, s, "list all FACT")
    ce_str_eq("R28D parity: list all FACT",
        vc_session_result_text(r1), "Found 3 FACT atoms: ids 0, 1, 2.")
    let r2 = vc_session_turn(kg, s, "tell me more")
    ce_str_eq("R28D parity: tell me more",
        vc_session_result_text(r2), "Found 3 FACT atoms: ids 0, 1, 2.")
    ce_eq("R28D parity: limit doubled",
        vc_session_last_limit(s), 20)
    let r3 = vc_session_turn(kg, s, "describe it")
    ce_str_eq("R28D parity: describe it -> id 0",
        vc_session_result_text(r3), "That FACT atom has id 0.")
    // After "describe it" the template is WHAT_IS; pivot reuses it.
    let r4 = vc_session_turn(kg, s, "what about CONCEPT")
    ce_str_eq("R28D parity: what about CONCEPT (reuses WHAT_IS)",
        vc_session_result_text(r4), "The first CONCEPT atom has id 3.")
}

// ---- R25B.4 morphology + weighted Jaccard (R30F / R29C.2) ---------------
//
// R29C (R25B.3) shipped uniform-weight Jaccard. The exit report
// documented two known failure modes:
//
//   1. Long unrelated remainder on the kind-naming side --
//      "tell me more about that atom in the rule engine" after
//      `list all RULE` scores 3/10 = CONTINUE (correct), but the
//      same utterance after `list all FACT` scores 0/4 = PIVOT
//      (loses the "more rows" intent on RULE topic).
//   2. No morphology -- "facts" plural mismatches "fact" singular
//      and trips PIVOT spuriously.
//
// R25B.4 closes (2) wholesale and partially closes (1):
//   * _vd_stem normalises trailing-s plurals (cats -> cat, facts ->
//     fact, rules -> rule, entities -> entity) so kind-naming
//     remainders stay anchored to CONTINUE regardless of
//     pluralisation.
//   * _vd_weighted_score_tenths re-scores the same prior/remainder
//     pair with the KIND word counting double on both sides of the
//     ratio. Borderline remainders that include the prior kind get
//     LIFTED into CONTINUE even when the uniform Jaccard rounds
//     below the threshold.
//
// HONEST: the brief's case 1 ("tell me more about that atom in the
// rule engine" after FACT) IS still PIVOT under the weighted model
// because the remainder names a DIFFERENT kind (rule) than the
// prior (fact). The weighted score for kind=fact + remainder=
// {atom, rule, engine} is 0/2 = 0; no fact-token is present to
// receive the kind weight. That's the honest answer: the operator
// shifted topic from FACT to the rule engine. The right fix is
// either (a) noticing the remainder names a DIFFERENT KNOWN kind
// and routing as kind-pivot, or (b) a semantic-distance model that
// recognises "rule engine" as off-topic from FACT. Deferred to a
// future R25B.5; documented below.

// Morphology unit tests -- direct probes of vc_stem (public wrapper
// around _vd_stem). Covers the s-suffix rule + its quirks.
fn test_morph_stem_basic_plurals() {
    ce_str_eq("cats -> cat", vc_stem("cats"), "cat")
    ce_str_eq("rules -> rule", vc_stem("rules"), "rule")
    ce_str_eq("facts -> fact", vc_stem("facts"), "fact")
    ce_str_eq("dogs -> dog", vc_stem("dogs"), "dog")
    ce_str_eq("atoms -> atom", vc_stem("atoms"), "atom")
}

fn test_morph_stem_singular_unchanged() {
    ce_str_eq("cat unchanged", vc_stem("cat"), "cat")
    ce_str_eq("rule unchanged", vc_stem("rule"), "rule")
    ce_str_eq("fact unchanged", vc_stem("fact"), "fact")
    ce_str_eq("engine unchanged", vc_stem("engine"), "engine")
}

fn test_morph_stem_short_word_preserved() {
    // Length < 4 -- "is" / "as" / "us" / "go" should not be touched.
    ce_str_eq("is unchanged (short)", vc_stem("is"), "is")
    ce_str_eq("as unchanged (short)", vc_stem("as"), "as")
    ce_str_eq("us unchanged (short)", vc_stem("us"), "us")
    ce_str_eq("os unchanged (short)", vc_stem("os"), "os")
}

fn test_morph_stem_suffix_quirks() {
    // -ss / -us / -is / -as / -os tails should not strip the s.
    ce_str_eq("kiss unchanged (-ss)", vc_stem("kiss"), "kiss")
    ce_str_eq("grass unchanged (-ss)", vc_stem("grass"), "grass")
    ce_str_eq("focus unchanged (-us)", vc_stem("focus"), "focus")
    ce_str_eq("axis unchanged (-is)", vc_stem("axis"), "axis")
    ce_str_eq("was unchanged (-as)", vc_stem("was"), "was")
    ce_str_eq("has unchanged (-as)", vc_stem("has"), "has")
    ce_str_eq("atlas unchanged (-as)", vc_stem("atlas"), "atlas")
    ce_str_eq("kudos unchanged (-os)", vc_stem("kudos"), "kudos")
}

fn test_morph_stem_ies_to_y() {
    // -ies (entities) -> -y (entity).
    ce_str_eq("entities -> entity", vc_stem("entities"), "entity")
    ce_str_eq("categories -> category", vc_stem("categories"),
        "category")
    ce_str_eq("facilities -> facility", vc_stem("facilities"),
        "facility")
}

fn test_morph_stem_no_trailing_s_unchanged() {
    // Words not ending in s should pass through.
    ce_str_eq("hello unchanged", vc_stem("hello"), "hello")
    ce_str_eq("query unchanged", vc_stem("query"), "query")
    ce_str_eq("empty unchanged", vc_stem(""), "")
}

// Weighted-score unit tests -- direct probes of vc_weighted_score.
// All inputs are pre-stemmed (caller's responsibility -- the public
// wrapper is documented that way).
fn test_weighted_score_kind_match_double_weight() {
    // kind=fact, no other prior content, remainder=[fact]
    // -> num = 2*1 + 0 = 2; den = 2*1 + 0 = 2 -> 10/10 = 10.
    let prior_other = list_new()
    let now = list_new()
    push(now, "fact")
    ce_eq("kind-only prior + remainder=[fact] -> 10",
        vc_weighted_score(prior_other, "fact", now), 10)
}

fn test_weighted_score_no_kind_match_zero() {
    // kind=fact, no other content, remainder=[cat] (unrelated)
    // -> 0 / 2 = 0.
    let prior_other = list_new()
    let now = list_new()
    push(now, "cat")
    ce_eq("kind-only prior + unrelated remainder -> 0",
        vc_weighted_score(prior_other, "fact", now), 0)
}

fn test_weighted_score_mixed_kind_and_other() {
    // kind=fact, prior_other=[apple], remainder=[fact, apple, cat]
    // -> kind_match=1, other_match=1, num = 2+1 = 3; den = 2+1 = 3
    // -> 30/3 = 10.
    let prior_other = list_new()
    push(prior_other, "apple")
    let now = list_new()
    push(now, "fact")
    push(now, "apple")
    push(now, "cat")
    ce_eq("kind+other match -> 10",
        vc_weighted_score(prior_other, "fact", now), 10)
}

fn test_weighted_score_empty_prior() {
    // No prior kind, no prior other; remainder unrelated -> 0.
    let prior_other = list_new()
    let now = list_new()
    push(now, "cat")
    ce_eq("empty prior + non-empty now -> 0",
        vc_weighted_score(prior_other, "", now), 0)
}

fn test_weighted_score_empty_now() {
    // Non-empty prior, empty remainder -> 0.
    let prior_other = list_new()
    let now = list_new()
    ce_eq("non-empty prior + empty now -> 0",
        vc_weighted_score(prior_other, "fact", now), 0)
}

