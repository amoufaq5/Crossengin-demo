        txt, "No RULE atoms found.")
    ce_str_eq("post: kind RULE (was FACT)",
        vc_session_last_kind(s), "RULE")
    ce_eq("post: limit baseline 10",
        vc_session_last_limit(s), 10)
}

// Dispatch: KIND_PIVOT via explicit "what about KIND" path matches
// the byte-identical end state of the previous R29C/R30F
// "PIVOT via what-about" behaviour. End-state response text +
// kind + template + LIMIT must be identical.
fn test_dispatch_kind_pivot_what_about_matches_prior_endstate() {
    let kg = _fixture_kg()
