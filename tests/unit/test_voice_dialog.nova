// Brief fixture: the R29C / R30F documented failure case. After FACT
// the remainder "that atom in the rule engine" names a DIFFERENT kind
// (rule). R31F / R25B.5 routes this to KIND_PIVOT: the more-cue path
// runs uniform Jaccard (miss), weighted Jaccard (miss -- no
// fact-token in remainder), then scans the remainder for a token
// naming a known kind != prior. "rule" stems to "rule", upcases to
// "RULE", _vd_known_kind("RULE") == 1, and RULE != FACT, so the
// classifier returns VC_FOLLOWUP_KIND_PIVOT. The handler then
// re-runs the prior template (LIST_ALL) against RULE with the
// baseline LIMIT.
//
// R31F UPDATE: prior expected was vc_followup_pivot() under R30F's
// honest-PIVOT documentation. The R30F exit report explicitly named
// this as the deferred R25B.5 case; R31F lands the fix.
fn test_classify_r29c_failure_case_after_fact_is_pivot() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    // R25B.5 routes via the kind-pivot pass since "rule" in the
    // remainder names a different known kind than FACT prior.
    ce_eq("'tell me more about that atom in the rule engine' after FACT -> KIND_PIVOT (R25B.5)",
        voice_followup_classify(s,
            "tell me more about that atom in the rule engine"),
        vc_followup_kind_pivot())
}

// Parity case: the R29C report said the same utterance after
