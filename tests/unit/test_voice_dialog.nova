    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all CONCEPT")
    let r = vc_session_turn(kg, s, "more facts and rules")
    let txt = vc_session_result_text(r)
    ce_str_eq("clarify question text",
        txt, "Did you mean FACT or RULE atoms?")
    // Session is now mid-clarify.
    ce_eq("session is pending clarify",
        vc_session_is_pending_clarify(s), 1)
    let pending = vc_session_pending_clarify_kinds(s)
    ce_eq("two candidates stashed", len(pending), 2)
    ce_str_eq("[0] FACT", pending[0], "FACT")
    ce_str_eq("[1] RULE", pending[1], "RULE")
    ce_eq("pending template = LIST_ALL",
        vc_session_pending_clarify_template(s),
        vc_template_list_all())
    ce_eq("attempts = 1 (first clarify emitted)",
        vc_session_pending_clarify_attempts(s), 1)
    // Prior CONCEPT context is preserved -- no session reset.
    ce_str_eq("prior kind preserved CONCEPT",
        vc_session_last_kind(s), "CONCEPT")
    ce_eq("history still has the CONCEPT turn",
        len(vc_session_history(s)), 1)
}

