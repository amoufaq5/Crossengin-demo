// Dispatch: KIND_PIVOT re-runs prior LIST_ALL template against new
// kind. Response matches the fresh-LIST_ALL-on-RULE shape; LIMIT
// resets to baseline 10 (NOT escalated). History captures both
// turns (no session reset on KIND_PIVOT, unlike generic PIVOT).
fn test_dispatch_kind_pivot_runs_fresh_query() {
    let kg = _fixture_kg()
    let s = vc_session_new()
    vc_session_turn(kg, s, "list all FACT")
    vc_session_turn(kg, s, "tell me more")  // limit -> 20
    ce_eq("pre-pivot: limit escalated to 20",
        vc_session_last_limit(s), 20)
    let r = vc_session_turn(kg, s, "tell me more about RULE atoms")
    let txt = vc_session_result_text(r)
    // KG has zero RULE atoms; LIST_ALL RULE returns empty.
    ce_str_eq("KIND_PIVOT runs LIST_ALL RULE",
        txt, "No RULE atoms found.")
    ce_eq("post-kind-pivot: limit reset to base 10 (NOT escalated)",
        vc_session_last_limit(s), 10)
    ce_str_eq("post-kind-pivot: kind annotated as RULE",
        vc_session_last_kind(s), "RULE")
    ce_eq("post-kind-pivot: template LIST_ALL preserved",
        vc_session_last_template(s), vc_template_list_all())
    // KIND_PIVOT does NOT reset history (unlike generic PIVOT). The
    // FACT turn + tell-me-more turn + kind-pivot turn = 3 turns.
    ce_eq("post-kind-pivot: history has 3 turns",
        len(vc_session_history(s)), 3)
}

// Dispatch: morphology-routed KIND_PIVOT runs new query.
// "list all FACT" -> "tell me more about that atom in the rule engine"
// dispatches to LIST_ALL RULE (the R29C failure-case fix).
fn test_dispatch_kind_pivot_via_morphology() {
    let kg = _fixture_kg()
