// Tamper / negative-path tests for src/net/tls/tls_session.nova.
//
// Coverage:
//   * Client rejects cert with wrong root       -> bad_certificate.
//   * Client rejects expired leaf               -> certificate_expired.
//   * Client rejects bad CertVerify signature   -> decrypt_error.
//   * Client rejects wrong server Finished      -> decrypt_error.
//   * Server rejects wrong client Finished      -> decrypt_error.
//   * Server rejects wrong cipher in CH         -> handshake_failure.
//   * Server rejects wrong group in CH          -> handshake_failure.

import "../ce_test.nova"
import "../../src/safety/rng.nova"
import "../../src/safety/ed25519.nova"
import "../../src/net/tls/tls_session.nova"
import "../../src/net/tls/tls_handshake.nova"
import "../../src/net/tls/tls_alerts.nova"
import "./fixtures/x509_test_certs.nova"

let _TT_NOW = 1718452800
let _TT_EXPIRED_NOW = 1546300800   // 2019-01-01, before validity window

fn _tt_rng(seed_str) {
    let ctx = list_new()
    let n = len(seed_str)
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, char_at(seed_str, i)); i = i + 1 }
    store8(buf + n, 0)
    rng_test_new(ctx, buf, n)
    return ctx
}

// Root/leaf used for TCC-style tests.
fn _tt_root() {
    let pk = fx_ed25519_test1_pub()
    let sk = fx_ed25519_test1_seed()
    return x509_build_test_cert("TT_Root", "TT_Root", 1,
                                "200101000000Z", "490101000000Z",
                                pk, sk, pk)
}

fn _tt_leaf() {
    let leaf_pk = fx_ed25519_test2_pub()
    let root_sk = fx_ed25519_test1_seed()
    let root_pk = fx_ed25519_test1_pub()
    return x509_build_test_cert("TT_Leaf", "TT_Root", 2,
                                "200101000000Z", "490101000000Z",
                                leaf_pk, root_sk, root_pk)
}

// A DIFFERENT root, so the client can't verify the leaf's chain.
fn _tt_other_root() {
    let other_pk = fx_ed25519_test2_pub()
    let other_sk = fx_ed25519_test2_seed()
    return x509_build_test_cert("TT_OtherRoot", "TT_OtherRoot", 9,
                                "200101000000Z", "490101000000Z",
                                other_pk, other_sk, other_pk)
}

fn _tt_pump(client, server, max_iter) {
    let it = 0
    while it < max_iter {
        let cout = list_new()
        session_drain_send(client, cout, 65536)
        let sout = list_new()
        session_drain_send(server, sout, 65536)
        if len(cout) == 0 {
            if len(sout) == 0 { return it }
        }
        if len(cout) > 0 { session_recv(server, cout) }
        if len(sout) > 0 { session_recv(client, sout) }
        it = it + 1
    }
    return it
}

// ---- bad root: client aborts -------------------------------------------

fn test_client_rejects_wrong_root() {
    let leaf = _tt_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let other_root = _tt_other_root()   // client trust anchor mismatch
    let crng = _tt_rng("wr-c")
    let srng = _tt_rng("wr-s")
    let client = list_new()
    let server = list_new()
    session_new_client(client, other_root, crng, _TT_NOW)
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TT_NOW)
    session_start_client(client)
    _tt_pump(client, server, 30)
    ce_check("client not done", session_handshake_done(client) == 0)
    ce_check("client sent alert", session_alert_sent(client) == 1)
    ce_eq("alert = bad_certificate",
          session_alert_desc(client), TLS_ALERT_BAD_CERTIFICATE)
}

// ---- expired leaf: client aborts ---------------------------------------

fn test_client_rejects_expired_leaf() {
    let root = _tt_root()
    let leaf = _tt_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let crng = _tt_rng("ex-c")
    let srng = _tt_rng("ex-s")
    let client = list_new()
    let server = list_new()
    // Client's clock is before validity window.
    session_new_client(client, root, crng, _TT_EXPIRED_NOW)
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TT_NOW)
    session_start_client(client)
    _tt_pump(client, server, 30)
    ce_check("client not done", session_handshake_done(client) == 0)
    ce_eq("alert = certificate_expired",
          session_alert_desc(client), TLS_ALERT_CERTIFICATE_EXPIRED)
}

// ---- bad CertVerify signature ------------------------------------------
//
// Give the server a bogus signer keypair for CertVerify: it will sign
// the RFC 8446 §4.4.3 blob with a key that does NOT match the leaf's
// SPKI pubkey, so the client's verify fails.

fn test_client_rejects_bad_certverify_sig() {
    let root = _tt_root()
    let leaf = _tt_leaf()
    let wrong_seed = fx_ed25519_test1_seed()   // root's seed, NOT leaf's
    let wrong_pub = fx_ed25519_test1_pub()
    let crng = _tt_rng("cv-c")
    let srng = _tt_rng("cv-s")
    let client = list_new()
    let server = list_new()
    session_new_client(client, root, crng, _TT_NOW)
    // Server presents leaf cert whose SPKI is the leaf pubkey, but
    // signs CertVerify with root's seed -> mismatch.
    session_new_server(server, leaf, wrong_seed, wrong_pub, srng, _TT_NOW)
    session_start_client(client)
    _tt_pump(client, server, 30)
    ce_check("client not done", session_handshake_done(client) == 0)
    ce_eq("alert = decrypt_error",
          session_alert_desc(client), TLS_ALERT_DECRYPT_ERROR)
}

// ---- wrong cipher / group ClientHello ---------------------------------
//
// Craft a raw ClientHello with a non-x1303 cipher OR non-x25519 group
// and feed it to a server session. Server must abort with
// handshake_failure (R93 has no HRR).

fn _tt_build_bad_ch(cipher_hi, cipher_lo, group_hi, group_lo) {
    // Hand-build a minimal ClientHello body with the given cipher +
    // group. Same-shape as hs_client_hello_serialize_body but with
    // caller-supplied cipher and group codes.
    let body = list_new()
    push(body, 3); push(body, 3)   // legacy_version
    let i = 0
    while i < 32 { push(body, i); i = i + 1 }   // random
    push(body, 0)   // session_id length
    // cipher_suites: 2-byte length + one 2-byte suite.
    push(body, 0); push(body, 2)
    push(body, cipher_hi); push(body, cipher_lo)
    // legacy_compression_methods.
    push(body, 1); push(body, 0)
    // Extensions.
    let exts = list_new()
    // supported_versions
    push(exts, 0); push(exts, 43)
    push(exts, 0); push(exts, 3)
    push(exts, 2); push(exts, 3); push(exts, 4)
    // supported_groups
    push(exts, 0); push(exts, 10)
    push(exts, 0); push(exts, 4)
    push(exts, 0); push(exts, 2)
    push(exts, group_hi); push(exts, group_lo)
    // signature_algorithms (ed25519)
    push(exts, 0); push(exts, 13)
    push(exts, 0); push(exts, 4)
    push(exts, 0); push(exts, 2)
    push(exts, 8); push(exts, 7)
    // key_share (dummy 32-byte pubkey under the supplied group)
    let ks_pub_n = 32
    let entry_len = 2 + 2 + ks_pub_n
    let client_shares_len = entry_len
    let ext_data_len = 2 + client_shares_len
    push(exts, 0); push(exts, 51)
    push(exts, int_and(int_shr(ext_data_len, 8), 255))
    push(exts, int_and(ext_data_len, 255))
    push(exts, int_and(int_shr(client_shares_len, 8), 255))
    push(exts, int_and(client_shares_len, 255))
    push(exts, group_hi); push(exts, group_lo)
    push(exts, 0); push(exts, 32)
    let k = 0
    while k < 32 { push(exts, k); k = k + 1 }
    push(body, int_and(int_shr(len(exts), 8), 255))
    push(body, int_and(len(exts), 255))
    let e = 0
    while e < len(exts) { push(body, exts[e]); e = e + 1 }
    return hs_wrap_header(TLS_HS_CLIENT_HELLO, body)
}

// Wrap a handshake message list into a TLS cleartext record.
fn _tt_wrap_hs_record(hs_bytes) {
    let out = list_new()
    let n = len(hs_bytes)
    push(out, 22)   // TLS_CONTENT_HANDSHAKE
    push(out, 3); push(out, 3)
    push(out, int_and(int_shr(n, 8), 255))
    push(out, int_and(n, 255))
    let i = 0
    while i < n { push(out, hs_bytes[i]); i = i + 1 }
    return out
}

fn test_server_rejects_wrong_cipher() {
    let leaf = _tt_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let srng = _tt_rng("bc-s")
    let server = list_new()
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TT_NOW)
    // Cipher 0x00,0x2F (TLS_RSA_WITH_AES_128_CBC_SHA -- not our suite).
    let bad_ch = _tt_build_bad_ch(0, 47, 0, 29)
    let record = _tt_wrap_hs_record(bad_ch)
    session_recv(server, record)
    ce_eq("alert = handshake_failure",
          session_alert_desc(server), TLS_ALERT_HANDSHAKE_FAILURE)
}

fn test_server_rejects_wrong_group() {
    let leaf = _tt_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let srng = _tt_rng("bg-s")
    let server = list_new()
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TT_NOW)
    // Group 0x00,0x17 (secp256r1 -- not x25519).
    let bad_ch = _tt_build_bad_ch(19, 3, 0, 23)
    let record = _tt_wrap_hs_record(bad_ch)
    session_recv(server, record)
    ce_eq("alert = handshake_failure",
          session_alert_desc(server), TLS_ALERT_HANDSHAKE_FAILURE)
}

// ---- tampered server Finished ------------------------------------------
//
// Do a normal handshake but corrupt the LAST byte of the server's
// encrypted flight (which is a MAC tag or a byte inside server Finished)
// so the client's decrypt/verify fails.

fn test_client_rejects_bad_server_finished() {
    let root = _tt_root()
    let leaf = _tt_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let crng = _tt_rng("bsf-c")
    let srng = _tt_rng("bsf-s")
    let client = list_new()
    let server = list_new()
    session_new_client(client, root, crng, _TT_NOW)
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TT_NOW)
    session_start_client(client)
    // Client sends CH.
    let ch_out = list_new()
    session_drain_send(client, ch_out, 65536)
    session_recv(server, ch_out)
    // Server produced ServerHello + encrypted flight.
    let s_out = list_new()
    session_drain_send(server, s_out, 65536)
    // Corrupt the last byte (likely inside the tag) of s_out.
    let last = len(s_out) - 1
    list_set(s_out, last, int_xor(s_out[last], 1))
    session_recv(client, s_out)
    ce_check("client not done", session_handshake_done(client) == 0)
    ce_check("client alerted", session_alert_sent(client) == 1)
    // Could be bad_record_mac (if tag byte flipped) or decrypt_error (if
    // Finished MAC failed after successful AEAD open). Either is fatal.
    let d = session_alert_desc(client)
    let ok = 0
    if d == TLS_ALERT_BAD_RECORD_MAC { ok = 1 }
    if d == TLS_ALERT_DECRYPT_ERROR { ok = 1 }
    ce_eq("alert bad_record_mac or decrypt_error", ok, 1)
}

// ---- tampered client Finished ------------------------------------------

fn test_server_rejects_bad_client_finished() {
    let root = _tt_root()
    let leaf = _tt_leaf()
    let leaf_seed = fx_ed25519_test2_seed()
    let leaf_pub = fx_ed25519_test2_pub()
    let crng = _tt_rng("bcf-c")
    let srng = _tt_rng("bcf-s")
    let client = list_new()
    let server = list_new()
    session_new_client(client, root, crng, _TT_NOW)
    session_new_server(server, leaf, leaf_seed, leaf_pub, srng, _TT_NOW)
    session_start_client(client)
    // CH -> server.
    let a = list_new(); session_drain_send(client, a, 65536); session_recv(server, a)
    // Server's flight -> client. Client finishes and emits client Finished.
    let b = list_new(); session_drain_send(server, b, 65536); session_recv(client, b)
    let c = list_new(); session_drain_send(client, c, 65536)
    // Corrupt last byte before feeding to server.
    let last = len(c) - 1
    list_set(c, last, int_xor(c[last], 1))
    session_recv(server, c)
    ce_check("server not done", session_handshake_done(server) == 0)
    ce_check("server alerted", session_alert_sent(server) == 1)
    let d = session_alert_desc(server)
    let ok = 0
    if d == TLS_ALERT_BAD_RECORD_MAC { ok = 1 }
    if d == TLS_ALERT_DECRYPT_ERROR { ok = 1 }
    ce_eq("server alert bad_record_mac or decrypt_error", ok, 1)
}

fn main() {
    test_client_rejects_wrong_root()
    test_client_rejects_expired_leaf()
    test_client_rejects_bad_certverify_sig()
    test_server_rejects_wrong_cipher()
    test_server_rejects_wrong_group()
    test_client_rejects_bad_server_finished()
    test_server_rejects_bad_client_finished()
    ce_summary("tls_session_tamper")
}

main()
