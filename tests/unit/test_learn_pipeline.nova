// Unit tests for src/learning/learn_pipeline.nova (R41 / ADR-0028).
// Drives lp_ingest (the network-free core) on a synthetic preprocessor result
// and verifies the R41 fix: triples MINT their endpoint atoms + reasoning
// operators, so freshly-learned facts are immediately reasonable-over.

import "../ce_test.nova"
import "../../src/learning/learn_pipeline.nova"

fn _mk_triple(s, r, o) {
    let t = list_new() push(t, s) push(t, r) push(t, o)
    return t
}

fn test_ingest_mints_atoms_and_operators() {
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)

    let atoms = list_new()
    push(atoms, "photosynthesis") push(atoms, "process") push(atoms, "light")

    let triples = list_new()
    push(triples, _mk_triple("photosynthesis", "is_a", "process"))   // both pre-created
    push(triples, _mk_triple("photosynthesis", "causes", "energy"))  // energy is NEW

    let r = lp_ingest(kg, lang, atoms, triples, "src:test", 0)
    ce_eq("3 content words", r[0], 3)
    ce_eq("2 operators",     r[1], 2)
    // new atoms: photosynthesis, process, light (3) + energy minted by a triple (1)
    ce_eq("4 new atoms",     r[2], 4)

    // The endpoint atom that only appeared inside a triple was created.
    ce_check("energy atom minted", kg_find_atom(kg, "energy") != 0)

    // And the operators are real: forward edges leave photosynthesis to BOTH
    // process and energy -- so the academic strategy can chain over what was
    // just learned.
    let p = kg_find_atom(kg, "photosynthesis")
    let ops = rk_operators_from(kg, atom_id(p))
    ce_eq("two operators leave photosynthesis", len(ops), 2)
}

fn test_ingest_is_dedup_safe() {
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)

    let a1 = list_new() push(a1, "water") push(a1, "liquid")
    lp_ingest(kg, lang, a1, list_new(), "src:test", 0)

    // Re-ingesting an existing word mints no new atom.
    let a2 = list_new() push(a2, "water")
    let r2 = lp_ingest(kg, lang, a2, list_new(), "src:test", 0)
    ce_eq("re-ingest mints nothing new", r2[2], 0)
    ce_eq("but still counts the word",   r2[0], 1)
}

fn test_status_names() {
    ce_str_eq("ok name",      lp_status_name(LP_OK), "ok")
    ce_str_eq("https name",   lp_status_name(LP_HTTPS_DEFERRED), "https-deferred")
    ce_str_eq("dns name",     lp_status_name(LP_DNS_FAIL), "dns-failed")
}

// ===========================================================================
// OpenIE-aware, entity-resolving ingest (ADR-0053 "Honest gaps"): wiring
// openie_triples + er_resolve_or_create into the pipeline.
//
//   The marquee acceptance: ingesting text where "car" and "automobile" appear
//   with the SAME neighbourhood collapses them onto ONE concept atom via HDC
//   neighbourhood similarity (the first consumer of the P1 HDC layer wired into
//   ingest), while an unrelated mention ("dog") stays its own atom. We also
//   cover graceful degradation: in LEGACY embed mode the HDC step is inert so
//   the synonym is minted separately (exact + alias only), and the alias table
//   collapses a synonym in any mode. The exact-match lp_ingest above is left
//   unchanged for its callers, so this is purely additive.
// ===========================================================================

// car and automobile share an identical neighbourhood (requires fuel, uses an
// engine); dog has a disjoint one. OpenIE lowercases and yields one triple per
// clause: [car|requires|fuel] [car|uses|engine] [automobile|requires|fuel]
// [automobile|uses|engine] [dog|chases|ball].
fn _lp_synonym_text() {
    return "The car requires fuel. The car uses an engine. The automobile requires fuel. The automobile uses an engine. The dog chases a ball."
}

fn test_resolved_ingest_collapses_synonyms() {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)

    let res = lp_ingest_resolved(kg, lang, er_aliases_new(), _lp_synonym_text(), "src:test", 0)

    // 5 triples -> 5 operators minted.
    ce_eq("one operator per triple", res[1], 5)
    // Distinct surface concepts: car, fuel, engine, automobile, dog, ball (6);
    // but "automobile" resolves onto "car" via HDC, so only 5 are minted.
    ce_eq("synonym does not mint a new atom (5 of 6 surface forms)", res[2], 5)

    // "car" survives as canonical; "automobile" was resolved away (never
    // inserted under its own label) -- the KG did not fragment.
    ce_check("car atom exists", kg_find_atom(kg, "car") != 0)
    ce_eq("automobile collapsed onto car (no separate atom)", kg_find_atom(kg, "automobile"), 0)
    // An unrelated mention keeps its own identity (no false merge).
    ce_check("unrelated mention 'dog' stays a distinct atom", kg_find_atom(kg, "dog") != 0)

    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

// Directly assert the resolution provenance: a synonym mention with the same
// neighbourhood resolves VIA HDC into the graph the ingest path just built.
fn test_resolved_ingest_via_hdc() {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)

    lp_ingest_resolved(kg, lang, er_aliases_new(), "The car requires fuel. The car uses an engine.", "src:seed", 0)
    let edges = list_new()
    let e1 = list_new() push(e1, "requires") push(e1, "fuel") push(edges, e1)
    let e2 = list_new() push(e2, "uses") push(e2, "engine") push(edges, e2)
    let mvec = hdc_encode_atom("automobile", edges)
    let r = er_resolve(kg, er_aliases_new(), "automobile", mvec, ER_HDC_THRESHOLD)
    ce_eq("automobile resolves via HDC into the existing graph", r[1], ER_VIA_HDC)
    ce_eq("HDC resolution lands on the car atom", atom_id(r[0]), atom_id(kg_find_atom(kg, "car")))

    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

// LEGACY mode: the HDC step is inert, so the synonym is minted as its own atom
// (resolution is exact + alias only) -- the documented graceful degradation.
fn test_resolved_ingest_legacy_keeps_synonym() {
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)

    let res = lp_ingest_resolved(kg, lang, er_aliases_new(), _lp_synonym_text(), "src:test", 0)
    ce_check("LEGACY keeps automobile as its own atom (HDC inert)", kg_find_atom(kg, "automobile") != 0)
    ce_eq("LEGACY mints every distinct surface form", res[2], 6)
}

// An explicit alias collapses a synonym even in LEGACY mode (the alias step is
// mode-independent), proving the alias table is threaded through the new path.
fn test_resolved_ingest_alias() {
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
    let reg = kg_registry_new()
    let kg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)
    let al = er_aliases_new()
    er_alias_add(al, "automobile", "car")

    lp_ingest_resolved(kg, lang, al, _lp_synonym_text(), "src:test", 0)
    ce_eq("aliased synonym is not inserted under its own label", kg_find_atom(kg, "automobile"), 0)
    ce_check("alias canonical 'car' exists", kg_find_atom(kg, "car") != 0)
}

fn main() {
    test_ingest_mints_atoms_and_operators()
    test_ingest_is_dedup_safe()
    test_status_names()
    test_resolved_ingest_collapses_synonyms()
    test_resolved_ingest_via_hdc()
    test_resolved_ingest_legacy_keeps_synonym()
    test_resolved_ingest_alias()
    ce_summary("learn_pipeline")
}

main()
