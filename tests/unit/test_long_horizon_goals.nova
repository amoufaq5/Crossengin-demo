// Unit tests for src/parts/meta/long_horizon_goals.nova
// Verifies cumulative progress accrual, subgoal completion rollup, and revisit
// salience / scan favoring stale + near-deadline goals. ADR-0040.

import "../ce_test.nova"
import "../../src/parts/meta/long_horizon_goals.nova"

fn test_accrual() {
    let e = goal_engine_new()
    let g = lh_new(e, "write book", 500, 1000, 0)
    ce_eq("deadline is horizon", goal_deadline(e, g), 1000)
    goal_advance(e, g, 300, 10)
    ce_eq("progress accrued", goal_progress(e, g), 300)
    ce_eq("attended updated", goal_last_touched(e, g), 10)
    // Cumulative -- a second advance adds, never resets.
    goal_advance(e, g, 400, 20)
    ce_eq("cumulative", goal_progress(e, g), 700)
}

fn test_subgoal_complete() {
    let e = goal_engine_new()
    let root = lh_new(e, "root", 500, 0, 0)
    let a = goal_new(e, "a", 500, 0, 1, 0)
    let b = goal_new(e, "b", 500, 0, 1, 0)
    goal_add_subgoal(e, root, a)
    goal_add_subgoal(e, root, b)
    goal_subgoal_complete(e, a, 5)
    ce_eq("subgoal satisfied", goal_status(e, a), GOAL_SATISFIED)
    // root rolled up to mean(1.0, 0) = 0.5.
    ce_eq("parent rollup", goal_progress(e, root), 500)
}

fn test_revisit() {
    let e = goal_engine_new()
    let stale = lh_new(e, "stale", 500, 1000, 0)     // last touched 0
    let fresh = lh_new(e, "fresh", 500, 1000, 100)   // last touched 100
    // At now=100: stale has staleness 100 -> higher salience than fresh.
    ce_check("stale more salient", lh_revisit_salience(e, stale, 100) > lh_revisit_salience(e, fresh, 100))
    // Scan returns the stale one above a threshold that excludes the fresh one.
    let due = goal_revisit_scan(e, 100, 750)
    ce_check("stale due", contains(due, stale) == 1)
    ce_check("fresh not due", contains(due, fresh) == 0)
}

fn main() { test_accrual() test_subgoal_complete() test_revisit() ce_summary("long_horizon_goals") }
main()
