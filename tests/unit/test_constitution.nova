// Unit tests for src/parts/soul/constitution.nova
// Verifies rule storage, the permit/veto check by severity, violation lookup,
// and the privileged XSIG_CONST constitutional signal. ADR-0034, ADR-0045.

import "../ce_test.nova"
import "../../src/parts/soul/constitution.nova"

fn test_rules_and_check() {
    let s = soul_new("A")
    soul_add_constitution(s, "fabricate", CONST_BLOCK)
    soul_add_constitution(s, "harm", CONST_OVERRIDE)
    soul_add_constitution(s, "be terse", CONST_WARN)
    ce_eq("three rules", soul_constitution_count(s), 3)
    // Benign action permitted.
    ce_eq("benign permitted", soul_check_constitution(s, "answer the question honestly"), 1)
    // Action containing a blocked term is vetoed.
    ce_eq("block veto", soul_check_constitution(s, "fabricate a citation"), 0)
    ce_eq("override veto", soul_check_constitution(s, "this could harm the user"), 0)
    // Warn-only rule does not veto.
    ce_eq("warn does not veto", soul_check_constitution(s, "be terse and clear"), 1)
    // Violation lookup.
    ce_eq("violated by rule 0", soul_constitution_violated_by(s, "fabricate data"), 0)
    ce_eq("no violation", soul_constitution_violated_by(s, "help kindly"), -1)
}

fn test_constitutional_signal() {
    let s = soul_new("A")
    soul_add_constitution(s, "fabricate", CONST_BLOCK)
    let sig = soul_constitution_signal(s, 0)
    ce_eq("is XSIG_CONST", sig_type(sig), XSIG_CONST)
    ce_eq("priority 9", sig_priority(sig), 9)
    ce_eq("constitutional", xsig_is_constitutional(sig_type(sig)), 1)
    ce_eq("meta is rule index", sig_meta(sig), 0)
}

fn main() {
    test_rules_and_check()
    test_constitutional_signal()
    ce_summary("constitution")
}

main()
