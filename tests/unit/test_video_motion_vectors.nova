// Unit tests for src/io/transducers/video_motion_vectors.nova (P3.3).
//
// Hermetic coverage of the block-matching motion vector field + the
// per-frame aggregate helpers (direction label, complexity label,
// aggregate label list). All fixtures are built in-memory (alloc +
// store8) so the suite never depends on an on-disk video.
//
// Assertion targets (~15):
//   * mv_apply on two identical frames returns vectors at (0, 0).
//   * mv_apply on a frame shifted RIGHT by 3 pixels (object moves
//     leftward) returns mean_dx > 0 (the search found the object 3
//     pixels to the right in the previous frame). The label should be
//     motion_dir_left.
//   * mv_apply on a frame shifted LEFT by 3 returns motion_dir_right.
//   * mv_apply on a frame shifted UP by 3 returns motion_dir_up.
//   * mv_apply on a frame shifted DOWN by 3 returns motion_dir_down.
//   * mv_direction_label returns motion_dir_static when both axes are
//     under the threshold.
//   * mv_complexity_label thresholds: 0 -> simple; 100000 -> complex.
//   * mv_aggregate_labels returns the right pair of strings for the
//     above cases.
//   * Frames smaller than the 16x16 block size return an empty vector list.
//   * Dimension cap rejects oversized fixtures.

import "../ce_test.nova"
import "../../src/io/transducers/video_motion_vectors.nova"

// ---- fixture builders -----------------------------------------------------

// Build a 32x32 frame with a single white 8x8 square at (sx, sy) on a
// black background. The square is the "object" the block-matching
// search should find at a shifted position in the previous frame.
fn _frame_with_square(width, height, sx, sy) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, 0)
        i = i + 1
    }
    let y = sy
    while y < sy + 8 {
        if y >= 0 {
            if y < height {
                let row_off = y * width
                let x = sx
                while x < sx + 8 {
                    if x >= 0 {
                        if x < width {
                            store8(buf + row_off + x, 255)
                        }
                    }
                    x = x + 1
                }
            }
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// Flat frame: all pixels same value.
fn _flat_frame(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// ---- happy path -----------------------------------------------------------

fn test_identical_frames_zero_motion() {
    let f = _frame_with_square(32, 32, 10, 10)
    // prev == cur (same pointer) -> the best SAD is 0 at (0, 0).
    let r = mv_apply(f, f, 32, 32)
    ce_check("identical frames -> mean_dx == 0", mv_result_mean_dx(r) == 0)
    ce_check("identical frames -> mean_dy == 0", mv_result_mean_dy(r) == 0)
    // The label should be motion_dir_static.
    let dir = mv_direction_label(mv_result_mean_dx(r), mv_result_mean_dy(r))
    ce_str_eq("identical frames -> motion_dir_static", dir, "motion_dir_static")
}

fn test_object_moved_left_yields_dir_left() {
    // Object moved from x=14 in prev frame to x=10 in current frame.
    // The block at (current, x=8..23, contains the object's new position)
    // should find its best match in (prev, x=12..27), so dx = +4
    // (search direction: positive dx points back to where the object
    // came from). Direction label: motion_dir_left.
    let prev = _frame_with_square(32, 32, 14, 12)
    let cur  = _frame_with_square(32, 32, 10, 12)
    let r = mv_apply(prev, cur, 32, 32)
    let mean_dx = mv_result_mean_dx(r)
    let mean_dy = mv_result_mean_dy(r)
    ce_check("leftward motion: mean_dx > 0", mean_dx > 0)
    let dir = mv_direction_label(mean_dx, mean_dy)
    ce_str_eq("leftward motion -> motion_dir_left", dir, "motion_dir_left")
}

fn test_object_moved_right_yields_dir_right() {
    // Object moved from x=10 in prev to x=14 in current. dx should be
    // negative. Direction label: motion_dir_right.
    let prev = _frame_with_square(32, 32, 10, 12)
    let cur  = _frame_with_square(32, 32, 14, 12)
    let r = mv_apply(prev, cur, 32, 32)
    let mean_dx = mv_result_mean_dx(r)
    let mean_dy = mv_result_mean_dy(r)
    ce_check("rightward motion: mean_dx < 0", mean_dx < 0)
    let dir = mv_direction_label(mean_dx, mean_dy)
    ce_str_eq("rightward motion -> motion_dir_right", dir, "motion_dir_right")
}

fn test_object_moved_up_yields_dir_up() {
    // Object moved from y=14 in prev to y=10 in current. dy should be
    // positive. Direction label: motion_dir_up.
    let prev = _frame_with_square(32, 32, 12, 14)
    let cur  = _frame_with_square(32, 32, 12, 10)
    let r = mv_apply(prev, cur, 32, 32)
    let mean_dx = mv_result_mean_dx(r)
    let mean_dy = mv_result_mean_dy(r)
    ce_check("upward motion: mean_dy > 0", mean_dy > 0)
    let dir = mv_direction_label(mean_dx, mean_dy)
    ce_str_eq("upward motion -> motion_dir_up", dir, "motion_dir_up")
}

fn test_object_moved_down_yields_dir_down() {
    // Object moved from y=10 in prev to y=14 in current. dy should be
    // negative. Direction label: motion_dir_down.
    let prev = _frame_with_square(32, 32, 12, 10)
    let cur  = _frame_with_square(32, 32, 12, 14)
    let r = mv_apply(prev, cur, 32, 32)
    let mean_dx = mv_result_mean_dx(r)
    let mean_dy = mv_result_mean_dy(r)
    ce_check("downward motion: mean_dy < 0", mean_dy < 0)
    let dir = mv_direction_label(mean_dx, mean_dy)
    ce_str_eq("downward motion -> motion_dir_down", dir, "motion_dir_down")
}

// ---- direction + complexity labels ---------------------------------------

fn test_direction_label_static_below_threshold() {
    ce_str_eq("(0, 0) -> static",
              mv_direction_label(0, 0), "motion_dir_static")
}

fn test_complexity_label_thresholds() {
    ce_str_eq("0 -> simple",
              mv_complexity_label(0), "motion_complexity_simple")
    ce_str_eq("4000 -> simple",
              mv_complexity_label(4000), "motion_complexity_simple")
    ce_str_eq("5000 -> complex",
              mv_complexity_label(5000), "motion_complexity_complex")
    ce_str_eq("100000 -> complex",
              mv_complexity_label(100000), "motion_complexity_complex")
}

fn test_aggregate_labels_static_simple() {
    // Build a fake result with mean_dx=mean_dy=0 and variance=0.
    let r = list_new()
    push(r, list_new())       // vectors
    push(r, 0)                // mean_dx
    push(r, 0)                // mean_dy
    push(r, 0)                // variance
    push(r, 4)                // n
    let labels = mv_aggregate_labels(r)
    ce_eq("aggregate labels length == 2", len(labels), 2)
    ce_str_eq("first label is motion_dir_static", labels[0], "motion_dir_static")
    ce_str_eq("second label is motion_complexity_simple",
              labels[1], "motion_complexity_simple")
}

fn test_aggregate_labels_left_complex() {
    let r = list_new()
    push(r, list_new())
    push(r, 5)                // mean_dx > 0 -> motion_dir_left
    push(r, 0)
    push(r, 50000)            // variance > threshold -> complex
    push(r, 4)
    let labels = mv_aggregate_labels(r)
    ce_eq("aggregate labels length == 2", len(labels), 2)
    ce_str_eq("first label is motion_dir_left", labels[0], "motion_dir_left")
    ce_str_eq("second label is motion_complexity_complex",
              labels[1], "motion_complexity_complex")
}

// ---- caps + edge cases ---------------------------------------------------

fn test_too_small_frame_returns_no_vectors() {
    let a = _flat_frame(8, 8, 100)
    let b = _flat_frame(8, 8, 150)
    let r = mv_apply(a, b, 8, 8)
    ce_eq("8x8 frame -> 0 blocks", mv_result_block_n(r), 0)
    let vecs = mv_result_vectors(r)
    ce_eq("8x8 frame -> empty vector list", len(vecs), 0)
}

fn test_dimension_cap_rejects_huge() {
    let dummy = alloc(8)
    let r = mv_apply(dummy, dummy, 800, 800)
    ce_eq("800x800 -> n=0", mv_result_block_n(r), 0)
}

fn test_vector_accessor_roundtrip() {
    let f = _frame_with_square(32, 32, 10, 10)
    let r = mv_apply(f, f, 32, 32)
    let vecs = mv_result_vectors(r)
    ce_check("32x32 produces > 0 vectors", len(vecs) > 0)
    let v = vecs[0]
    ce_eq("first vector block_x == 0", mv_vector_block_x(v), 0)
    ce_eq("first vector block_y == 0", mv_vector_block_y(v), 0)
    // For identical frames the best dx, dy at (0,0) is the zero vector.
    ce_eq("identical frames first vector dx == 0", mv_vector_dx(v), 0)
    ce_eq("identical frames first vector dy == 0", mv_vector_dy(v), 0)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_identical_frames_zero_motion()
    test_object_moved_left_yields_dir_left()
    test_object_moved_right_yields_dir_right()
    test_object_moved_up_yields_dir_up()
    test_object_moved_down_yields_dir_down()
    test_direction_label_static_below_threshold()
    test_complexity_label_thresholds()
    test_aggregate_labels_static_simple()
    test_aggregate_labels_left_complex()
    test_too_small_frame_returns_no_vectors()
    test_dimension_cap_rejects_huge()
    test_vector_accessor_roundtrip()
    ce_summary("video_motion_vectors")
}

main()
