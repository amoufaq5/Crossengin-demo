// Unit tests for src/io/transducers/image_segmentation.nova (R11E).
//
// Hermetic coverage of the spatial k-means image segmenter. Every fixture
// is built in-memory via alloc + store8 so the suite never touches the
// filesystem. The integration scenario (scenario_ww_segmentation.sh)
// exercises chat dispatch + PGM round-trip; this suite focuses on the
// algorithm itself.
//
// Assertion targets (~25-30):
//   * K=2 on a left-half-black + right-half-white 32x32 -> two clusters
//     with centroids near (0, ~7, ~15) and (255, ~23, ~15) and dead-
//     center pixels assigned by half. The grid init lays K=2 centroids
//     at (W/4, H/2) and (3W/4, H/2), so the LR-split fixture matches the
//     init orientation cleanly.
//   * K=4 on a quadrant fixture (each 16x16 corner a distinct intensity)
//     -> exactly four clusters with centroids at the corner intensities,
//     one per quadrant. Convergence in <= 5 iterations.
//   * Identical-intensity image (128 everywhere) -> all pixels still
//     assigned a cluster (no segfault), and the centroids' I values
//     all equal 128 (their (x, y) split is spatial-only).
//   * K=1 -> trivial single-cluster case; centroid I = pixel mean.
//   * seg_render_pgm returns a valid PGM-P5 byte buffer with the
//     correct width / height header and W*H pixels of payload.
//   * seg_label_at(-1, 0) returns SEG_LABEL_OOB (-1) sentinel.
//   * Dimension cap rejects > 256 per axis (centroid_count == 0).
//   * K cap rejects K > 32 and K < 1.
//   * max_iter cap rejects <= 0 and silently truncates > 50.
//   * seg_centroid_count returns K on success.
//   * seg_iterations and seg_converged are populated.
//   * seg_dominant_label returns "image_segmentation_dominant_<k>".
//   * Weighted variant: w_spatial=0 (force pure intensity clustering)
//     on a uniform half-image produces the same intensity-clean result.

import "../ce_test.nova"
import "../../src/io/transducers/image_segmentation.nova"

// ---- fixture builders -----------------------------------------------------

fn _flat_fixture(width, height, value) {
    let area = width * height
    let buf = alloc(area + 1)
    let i = 0
    while i < area {
        store8(buf + i, value)
        i = i + 1
    }
    store8(buf + area, 0)
    return buf
}

// Left half value `low`, right half value `high`. For width=32 the
// split lands at column 16. The K=2 grid init lays centroids at x=8
// and x=24, so the assignment converges in one iteration.
fn _left_right_fixture(width, height, low, high) {
    let area = width * height
    let buf = alloc(area + 1)
    let half = width / 2
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = low
            if x >= half { v = high }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// 4-quadrant fixture: TL = `a`, TR = `b`, BL = `c`, BR = `d`. With
// width=height=32 each quadrant is 16x16. The K=4 grid init lays
// centroids at the four quadrant centers, so the assignment converges
// in one iteration.
fn _quadrant_fixture(width, height, a, b, c, d) {
    let area = width * height
    let buf = alloc(area + 1)
    let half_x = width / 2
    let half_y = height / 2
    let y = 0
    while y < height {
        let row_off = y * width
        let x = 0
        while x < width {
            let v = a
            if x >= half_x {
                if y < half_y { v = b } else { v = d }
            } else {
                if y >= half_y { v = c }
            }
            store8(buf + row_off + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(buf + area, 0)
    return buf
}

// ---- core happy-path tests ------------------------------------------------

fn test_k2_left_right_split() {
    let buf = _left_right_fixture(32, 32, 0, 255)
    let r = seg_kmeans(buf, 32, 32, 2, 10)
    ce_eq("K=2 LR centroid_count == 2", seg_centroid_count(r), 2)
    ce_eq("K=2 LR width == 32",         seg_width(r), 32)
    ce_eq("K=2 LR height == 32",        seg_height(r), 32)
    ce_check("K=2 LR converged",        seg_converged(r) == 1)
    // Iter cap check: at most 5.
    ce_check("K=2 LR iters <= 5",       seg_iterations(r) <= 5)
    // Centroid intensities: low and high cluster.
    let c0 = seg_centroid_at(r, 0)
    let c1 = seg_centroid_at(r, 1)
    ce_eq("K=2 LR c0.I == 0",   c0[0], 0)
    ce_eq("K=2 LR c1.I == 255", c1[0], 255)
    // Spatial centroids on a 32x32 should be near (8, 15) / (23, 15)
    // (means of left half and right half pixel coordinates).
    ce_near("K=2 LR c0.x near 7..8",   c0[1], 7,  1)
    ce_near("K=2 LR c0.y near 15..16", c0[2], 15, 1)
    ce_near("K=2 LR c1.x near 23..24", c1[1], 23, 1)
    ce_near("K=2 LR c1.y near 15..16", c1[2], 15, 1)
    // Sample some labels: top-left should be cluster 0; top-right cluster 1.
    ce_eq("K=2 LR label(0,0) == 0",   seg_label_at(r, 0, 0),   0)
    ce_eq("K=2 LR label(31,0) == 1",  seg_label_at(r, 31, 0),  1)
    ce_eq("K=2 LR label(0,31) == 0",  seg_label_at(r, 0, 31),  0)
    ce_eq("K=2 LR label(31,31) == 1", seg_label_at(r, 31, 31), 1)
}

fn test_k4_quadrants_match_intensities() {
    // Each quadrant a distinct intensity. The K=4 grid init places
    // centroids at the 4 quadrant centers; one Lloyd iteration is
    // enough to converge.
    let buf = _quadrant_fixture(32, 32, 0, 80, 160, 240)
    let r = seg_kmeans(buf, 32, 32, 4, 10)
    ce_eq("K=4 QUAD centroid_count == 4", seg_centroid_count(r), 4)
    ce_check("K=4 QUAD converged",        seg_converged(r) == 1)
    ce_check("K=4 QUAD iters <= 5",       seg_iterations(r) <= 5)
    // Centroid I values should be the four intensities (in grid order:
    // TL, TR, BL, BR for the init pattern).
    let c0 = seg_centroid_at(r, 0)
    let c1 = seg_centroid_at(r, 1)
    let c2 = seg_centroid_at(r, 2)
    let c3 = seg_centroid_at(r, 3)
    ce_eq("K=4 QUAD c0.I == 0 (TL)",   c0[0], 0)
    ce_eq("K=4 QUAD c1.I == 80 (TR)",  c1[0], 80)
    ce_eq("K=4 QUAD c2.I == 160 (BL)", c2[0], 160)
    ce_eq("K=4 QUAD c3.I == 240 (BR)", c3[0], 240)
    // Spatial centroids land at the centers of their quadrant.
    ce_near("K=4 QUAD c0.x near 7..8",  c0[1], 7,  1)
    ce_near("K=4 QUAD c0.y near 7..8",  c0[2], 7,  1)
    ce_near("K=4 QUAD c3.x near 23..24", c3[1], 23, 1)
    ce_near("K=4 QUAD c3.y near 23..24", c3[2], 23, 1)
    // Labels by quadrant: TL=(0,0)->0; BR=(31,31)->3.
    ce_eq("K=4 QUAD label(0,0) == 0 (TL)",     seg_label_at(r, 0, 0),     0)
    ce_eq("K=4 QUAD label(31,0) == 1 (TR)",    seg_label_at(r, 31, 0),    1)
    ce_eq("K=4 QUAD label(0,31) == 2 (BL)",    seg_label_at(r, 0, 31),    2)
    ce_eq("K=4 QUAD label(31,31) == 3 (BR)",   seg_label_at(r, 31, 31),   3)
}

fn test_identical_intensity_image() {
    // Uniform grey 128: every pixel has the same intensity, so cluster
    // assignment is driven purely by spatial proximity. With K=2 the
    // grid init makes the left half belong to cluster 0, right half
    // cluster 1; both centroids end with I == 128.
    let buf = _flat_fixture(32, 32, 128)
    let r = seg_kmeans(buf, 32, 32, 2, 10)
    ce_eq("FLAT K=2 centroid_count == 2", seg_centroid_count(r), 2)
    let c0 = seg_centroid_at(r, 0)
    let c1 = seg_centroid_at(r, 1)
    ce_eq("FLAT K=2 c0.I == 128", c0[0], 128)
    ce_eq("FLAT K=2 c1.I == 128", c1[0], 128)
    // Every pixel landed somewhere -- no -1 / no >= K. Walk a few.
    ce_check("FLAT K=2 (0,0) label in [0..1]",
             seg_label_at(r, 0, 0) >= 0)
    ce_check("FLAT K=2 (0,0) label < K",
             seg_label_at(r, 0, 0) < 2)
}

fn test_k1_trivial_single_cluster() {
    // K=1 -> all pixels in cluster 0, centroid I = mean intensity.
    let buf = _left_right_fixture(32, 32, 50, 200)
    let r = seg_kmeans(buf, 32, 32, 1, 10)
    ce_eq("K=1 centroid_count == 1", seg_centroid_count(r), 1)
    let c0 = seg_centroid_at(r, 0)
    // Half 50, half 200 -> mean = 125.
    ce_near("K=1 c0.I near 125", c0[0], 125, 2)
    ce_eq("K=1 label(0,0) == 0",   seg_label_at(r, 0, 0),   0)
    ce_eq("K=1 label(15,15) == 0", seg_label_at(r, 15, 15), 0)
    ce_eq("K=1 label(31,31) == 0", seg_label_at(r, 31, 31), 0)
}

// ---- iteration / convergence ---------------------------------------------

fn test_iterations_and_convergence_flags() {
    // Quadrant fixture converges in <=5 iterations (typically 2).
    let buf = _quadrant_fixture(32, 32, 0, 80, 160, 240)
    let r = seg_kmeans(buf, 32, 32, 4, 10)
    ce_check("QUAD K=4 iter count > 0", seg_iterations(r) > 0)
    ce_check("QUAD K=4 iter count <= 5", seg_iterations(r) <= 5)
    ce_eq("QUAD K=4 converged flag == 1", seg_converged(r), 1)
}

// ---- render / PGM output -------------------------------------------------

fn test_render_pgm_header_and_size() {
    let buf = _quadrant_fixture(32, 32, 0, 80, 160, 240)
    let r = seg_kmeans(buf, 32, 32, 4, 10)
    let total = seg_render_pgm_size(r)
    // "P5\n32 32\n255\n" = 13 bytes header + 1024 pixels = 1037.
    ce_eq("render_pgm_size for 32x32 == 1037", total, 1037)
    let bytes = seg_render_pgm(r, buf)
    ce_check("render_pgm returns non-zero pointer", bytes != 0)
    // Header check: first two bytes "P5".
    ce_eq("render_pgm byte 0 == 'P'", load8(bytes + 0), 80)
    ce_eq("render_pgm byte 1 == '5'", load8(bytes + 1), 53)
    ce_eq("render_pgm byte 2 == '\\n'", load8(bytes + 2), 10)
    // Last byte of pixel data: the (31, 31) pixel's cluster centroid I.
    // For the 4-quadrant fixture the BR cluster (3) has centroid I = 240.
    ce_eq("render_pgm last pixel byte == 240",
          load8(bytes + total - 1), 240)
    // First pixel byte == cluster 0's centroid I == 0 (TL quadrant).
    // Find the start of pixel data: after the header, which for 32x32 is
    // exactly 13 bytes ("P5\n32 32\n255\n").
    ce_eq("render_pgm first pixel byte == 0",
          load8(bytes + 13), 0)
}

// ---- caps + OOB safety ---------------------------------------------------

fn test_oob_label_safety() {
    let buf = _flat_fixture(32, 32, 128)
    let r = seg_kmeans(buf, 32, 32, 2, 10)
    // Out-of-bounds coordinates return the sentinel -1.
    ce_eq("label(-1, 0) == OOB sentinel", seg_label_at(r, -1, 0),  -1)
    ce_eq("label(0, -1) == OOB sentinel", seg_label_at(r, 0, -1),  -1)
    ce_eq("label(32, 0) == OOB sentinel", seg_label_at(r, 32, 0),  -1)
    ce_eq("label(0, 32) == OOB sentinel", seg_label_at(r, 0, 32),  -1)
    ce_eq("label(99,99) == OOB sentinel", seg_label_at(r, 99, 99), -1)
}

fn test_dimension_cap_rejects_huge() {
    let dummy = alloc(8)
    let r = seg_kmeans(dummy, 300, 300, 2, 10)
    ce_eq("300x300 -> centroid_count == 0", seg_centroid_count(r), 0)
    ce_eq("300x300 -> width == 0",          seg_width(r), 0)
    ce_eq("300x300 -> iter == 0",           seg_iterations(r), 0)
}

fn test_k_cap_rejects_oob_k() {
    let buf = _flat_fixture(32, 32, 128)
    // K == 0 -> reject.
    let r0 = seg_kmeans(buf, 32, 32, 0, 10)
    ce_eq("K=0 -> centroid_count == 0", seg_centroid_count(r0), 0)
    // K > 32 -> reject.
    let r33 = seg_kmeans(buf, 32, 32, 33, 10)
    ce_eq("K=33 -> centroid_count == 0", seg_centroid_count(r33), 0)
}

fn test_max_iter_cap() {
    let buf = _flat_fixture(32, 32, 128)
    // max_iter <= 0 -> reject.
    let r0 = seg_kmeans(buf, 32, 32, 2, 0)
    ce_eq("max_iter=0 -> centroid_count == 0", seg_centroid_count(r0), 0)
    // max_iter > 50 silently caps to 50, doesn't fail.
    let r99 = seg_kmeans(buf, 32, 32, 2, 99)
    ce_eq("max_iter=99 silently capped (K still 2)",
          seg_centroid_count(r99), 2)
    ce_check("max_iter=99 iters <= 50",
             seg_iterations(r99) <= 50)
}

// ---- label helpers --------------------------------------------------------

fn test_cluster_count_label_string() {
    ce_str_eq("cluster_count_label(4)",
              seg_cluster_count_label(4),
              "image_segmentation_cluster_count_4")
    ce_str_eq("cluster_count_label(2)",
              seg_cluster_count_label(2),
              "image_segmentation_cluster_count_2")
}

fn test_dominant_label_picks_majority_cluster() {
    // Quadrant fixture: all 4 clusters have equal pixel counts (256
    // pixels each). Dominant tie -> earliest cluster id wins (cluster 0).
    let buf = _quadrant_fixture(32, 32, 0, 80, 160, 240)
    let r = seg_kmeans(buf, 32, 32, 4, 10)
    ce_str_eq("dominant label for 4-equal-quadrants is cluster 0",
              seg_dominant_label(r),
              "image_segmentation_dominant_0")
}

// ---- weighted variant -----------------------------------------------------

fn test_weighted_variant_pure_intensity() {
    // With w_spatial=0 the assignment is driven by intensity only --
    // every pixel snaps to the centroid with the closest intensity
    // regardless of position. On the LR fixture every black pixel
    // joins centroid 0 and every white pixel joins centroid 1, same
    // as the default weights would produce; the test just verifies
    // the weighted API does not regress on the simple case.
    let buf = _left_right_fixture(32, 32, 0, 255)
    let r = seg_kmeans_weighted(buf, 32, 32, 2, 10, 1, 0)
    ce_eq("weighted K=2 centroid_count == 2", seg_centroid_count(r), 2)
    let c0 = seg_centroid_at(r, 0)
    let c1 = seg_centroid_at(r, 1)
    ce_eq("weighted K=2 c0.I == 0",   c0[0], 0)
    ce_eq("weighted K=2 c1.I == 255", c1[0], 255)
}

// ---- main -------------------------------------------------------------

fn main() {
    test_k2_left_right_split()
    test_k4_quadrants_match_intensities()
    test_identical_intensity_image()
    test_k1_trivial_single_cluster()
    test_iterations_and_convergence_flags()
    test_render_pgm_header_and_size()
    test_oob_label_safety()
    test_dimension_cap_rejects_huge()
    test_k_cap_rejects_oob_k()
    test_max_iter_cap()
    test_cluster_count_label_string()
    test_dominant_label_picks_majority_cluster()
    test_weighted_variant_pure_intensity()
    ce_summary("image_segmentation")
}

main()
