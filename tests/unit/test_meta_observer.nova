// Unit tests for src/parts/meta/meta_observer.nova
// Verifies the observer's per-source bucketing, attribution dedup, the
// tentative/durable classification, promotion + atrophy delta counting on
// poll, multi-poll accumulation, and the mo_report shape. ADR-0050.

import "../ce_test.nova"
import "../../src/parts/meta/meta_observer.nova"
import "../../src/parts/meta/reflection_loop.nova"

// Force an atom's posterior mean to a milli target (alpha/beta in milli),
// for clean classification tests. mean = alpha / (alpha + beta).
fn _set_mean(atom, mean_milli) {
    let b = atom_belief(atom)
    list_set(b, 0, mean_milli)
    list_set(b, 1, 1000 - mean_milli)
    return 1
}

fn test_empty_observer() {
    let mo = mo_new()
    ce_eq("no sources", len(mo_sources(mo)), 0)
    ce_eq("no polls yet", mo_total_polls(mo), 0)
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let r = mo_poll(mo, kg, 0, 0)
    ce_eq("poll on empty observer is empty", len(r), 0)
    ce_eq("poll counter still bumps", mo_total_polls(mo), 1)
    ce_eq("report on empty is empty", len(mo_report(mo)), 0)
}

fn test_attribute_two_sources() {
    let mo = mo_new()
    mo_attribute(mo, "seed", 1)
    mo_attribute(mo, "seed", 2)
    mo_attribute(mo, "seed", 3)
    mo_attribute(mo, "user-teach", 4)
    let srcs = mo_sources(mo)
    ce_eq("two source tags", len(srcs), 2)
    ce_check("seed listed", contains(srcs, "seed") == 1)
    ce_check("user-teach listed", contains(srcs, "user-teach") == 1)
}

fn test_attribute_idempotent() {
    let mo = mo_new()
    let added1 = mo_attribute(mo, "seed", 7)
    let added2 = mo_attribute(mo, "seed", 7)
    ce_eq("first attribute creates", added1, 1)
    ce_eq("second attribute is a no-op", added2, 0)
}

// 750/250 -> just-promoted to durable; 500/500 -> tentative; 100/900 -> tentative.
fn test_classification_on_poll() {
    let mo = mo_new()
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a_dur = kg_add_atom(kg, ATOM_CONCEPT, "dur", 0)
    let a_ten = kg_add_atom(kg, ATOM_CONCEPT, "ten", 0)
    let a_atr = kg_add_atom(kg, ATOM_CONCEPT, "atr", 0)
    _set_mean(a_dur, 750)
    _set_mean(a_ten, 500)
    _set_mean(a_atr, 100)
    mo_attribute(mo, "seed", atom_id(a_dur))
    mo_attribute(mo, "seed", atom_id(a_ten))
    mo_attribute(mo, "seed", atom_id(a_atr))
    let snap = mo_poll(mo, kg, 0, 0)
    ce_eq("one source row", len(snap), 1)
    let row = snap[0]
    ce_str_eq("row tagged seed", row[MO_SNAP_TAG], "seed")
    ce_eq("three atoms total", row[MO_SNAP_ATOMS], 3)
    ce_eq("two tentative", row[MO_SNAP_TENT], 2)
    ce_eq("one durable", row[MO_SNAP_DUR], 1)
}

// First poll: tentative atom. Promote (raise belief). Second poll: should
// register a promotion delta. Third poll with no change: no further deltas.
fn test_promotion_delta_on_poll() {
    let mo = mo_new()
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "x", 0)
    _set_mean(a, 500)
    mo_attribute(mo, "seed", atom_id(a))
    mo_poll(mo, kg, 0, 0)                       // poll 1: tentative
    _set_mean(a, 800)
    let s2 = mo_poll(mo, kg, 0, 0)              // poll 2: just promoted
    ce_eq("poll 2 sees one durable", s2[0][MO_SNAP_DUR], 1)
    ce_eq("poll 2 sees zero tentative", s2[0][MO_SNAP_TENT], 0)
    let report = mo_report(mo)
    let row = report[0]
    ce_str_eq("report tag matches", row[0], "seed")
    ce_check("cumulative promotion > 0", row[1] > 0)
    ce_eq("cumulative atrophy = 0", row[2], 0)
}

// Durable atom that drops below threshold should register as atrophy.
fn test_atrophy_delta_on_poll() {
    let mo = mo_new()
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "y", 0)
    _set_mean(a, 800)
    mo_attribute(mo, "seed", atom_id(a))
    mo_poll(mo, kg, 0, 0)                       // poll 1: durable
    _set_mean(a, 100)
    let s2 = mo_poll(mo, kg, 0, 0)              // poll 2: atrophied
    ce_eq("poll 2 sees one tentative", s2[0][MO_SNAP_TENT], 1)
    ce_eq("poll 2 sees zero durable", s2[0][MO_SNAP_DUR], 0)
    let report = mo_report(mo)
    ce_check("cumulative atrophy > 0", report[0][2] > 0)
}

// Polling twice between events accumulates the running counters: a brand-new
// durable atom on poll 2 plus another on poll 3 should both end up in the
// promotion total.
fn test_multi_poll_accumulation() {
    let mo = mo_new()
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "a", 0)
    let b = kg_add_atom(kg, ATOM_CONCEPT, "b", 0)
    _set_mean(a, 400)
    _set_mean(b, 400)
    mo_attribute(mo, "seed", atom_id(a))
    mo_attribute(mo, "seed", atom_id(b))
    mo_poll(mo, kg, 0, 0)                       // poll 1: 2 tentative
    _set_mean(a, 800)                           // promote 'a'
    mo_poll(mo, kg, 0, 1)                       // poll 2: +1 promotion
    _set_mean(b, 800)                           // promote 'b'
    mo_poll(mo, kg, 0, 2)                       // poll 3: +1 promotion
    ce_eq("three polls total", mo_total_polls(mo), 3)
    let report = mo_report(mo)
    let row = report[0]
    // Cumulative promotion: 2 of 2 -> 1000 milli (100%).
    ce_eq("both atoms got promoted", row[1], 1000)
    ce_eq("sample size 2", row[3], 2)
}

fn test_report_includes_every_source() {
    let mo = mo_new()
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a = kg_add_atom(kg, ATOM_CONCEPT, "a", 0)
    let b = kg_add_atom(kg, ATOM_CONCEPT, "b", 0)
    let c = kg_add_atom(kg, ATOM_CONCEPT, "c", 0)
    _set_mean(a, 750)
    _set_mean(b, 750)
    _set_mean(c, 750)
    mo_attribute(mo, "seed", atom_id(a))
    mo_attribute(mo, "user-teach", atom_id(b))
    mo_attribute(mo, "learn:wiki", atom_id(c))
    mo_poll(mo, kg, 0, 5)
    let report = mo_report(mo)
    ce_eq("three rows in report", len(report), 3)
    // Each row's last-poll field reflects the tick we passed to mo_poll.
    let i = 0
    while i < len(report) {
        ce_eq("row sample size 1", report[i][3], 1)
        ce_eq("row last_poll = 5", report[i][4], 5)
        i = i + 1
    }
}

// mo_format_pct should render 0..1000 milli as decimal percentages.
fn test_format_pct() {
    ce_str_eq("0   -> 0.0",    mo_format_pct(0),    "0.0")
    ce_str_eq("5   -> 0.5",    mo_format_pct(5),    "0.5")
    ce_str_eq("425 -> 42.5",   mo_format_pct(425),  "42.5")
    ce_str_eq("965 -> 96.5",   mo_format_pct(965),  "96.5")
    ce_str_eq("1000 -> 100.0", mo_format_pct(1000), "100.0")
}

// mo_refl_promotions should pick up refl-kg atoms tagged "promoted".
fn test_refl_promotions_observed() {
    let mo = mo_new()
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let refl = refl_kg_init(reg)
    let r1 = kg_add_atom(refl, ATOM_FACT, "speculation", 0)
    let r2 = kg_add_atom(refl, ATOM_FACT, "still_tentative", 0)
    atom_payload_set(r1, "promoted", 1)
    mo_poll(mo, kg, refl, 0)
    ce_eq("one refl promotion seen", mo_refl_promotions(mo), 1)
}

fn main() {
    test_empty_observer()
    test_attribute_two_sources()
    test_attribute_idempotent()
    test_classification_on_poll()
    test_promotion_delta_on_poll()
    test_atrophy_delta_on_poll()
    test_multi_poll_accumulation()
    test_report_includes_every_source()
    test_format_pct()
    test_refl_promotions_observed()
    ce_summary("meta_observer")
}

main()
