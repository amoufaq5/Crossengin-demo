// Unit tests for src/language/number_words.nova (N2, ADR-0060).
// English number-words / digit tokens / units -> milli value. Values that
// exceed NOVA codegen bug #11's 0x100000 threshold are asserted via int_to_str
// string equality (a `==` between two such large ints would miscompile), the
// small ones via ce_eq directly.

import "../ce_test.nova"
import "../../src/language/number_words.nova"

fn _val(s)   { return numw_words_to_value(s)[1] }
fn _vok(s)   { return numw_words_to_value(s)[0] }

// ---- word -> value (small enough for ce_eq) --------------------------------
fn test_words_small() {
    ce_eq("zero",            _val("zero"),                 0)
    ce_eq("nineteen",        _val("nineteen"),             19)
    ce_eq("twenty",          _val("twenty"),               20)
    ce_eq("twenty-one",      _val("twenty-one"),           21)
    ce_eq("ninety nine",     _val("ninety nine"),          99)
    ce_eq("three hundred",   _val("three hundred"),        300)
    ce_eq("a hundred",       _val("a hundred"),            100)
    ce_eq("hundred and five",_val("one hundred and five"), 105)
    ce_eq("a dozen",         _val("a dozen"),              12)
    ce_eq("two dozen",       _val("two dozen"),            24)
    ce_eq("a couple",        _val("a couple"),             2)
    ce_eq("a score",         _val("a score"),              20)
    ce_eq("two thousand 500",_val("two thousand five hundred"), 2500)
    ce_eq("123",             _val("one hundred twenty three"),  123)
}

// ---- word -> value (large: string-compared) --------------------------------
fn test_words_large() {
    ce_str_eq("two million",  int_to_str(_val("two million")),   "2000000")
    ce_str_eq("3 billion",    int_to_str(_val("three billion")), "3000000000")
    ce_str_eq("1.5M words",   int_to_str(_val("one million five hundred thousand")), "1500000")
}

fn test_words_extract_from_sentence() {
    // the run is found anywhere in the text, stopping at the first non-number.
    ce_eq("embedded run", _val("i have three hundred apples"), 300)
    ce_eq("no number", _vok("the quick brown fox"), 0)
    ce_eq("no number value 0", _val("hello world"), 0)
}

// ---- units -----------------------------------------------------------------
fn test_units() {
    ce_str_eq("kg canon",        numw_unit_canon("kilograms"), "kg")
    ce_str_eq("lb canon",        numw_unit_canon("pounds"),    "lb")
    ce_str_eq("metre canon",     numw_unit_canon("metres"),    "m")
    ce_str_eq("percent canon",   numw_unit_canon("percent"),   "%")
    ce_eq("kg is unit",          numw_is_unit("kg"),           1)
    ce_eq("banana not unit",     numw_is_unit("banana"),       0)
}

// ---- full parse: digits + units --------------------------------------------
fn test_parse_digits() {
    let a = numw_parse("2.5 kg")
    ce_eq("digit ok",    numw_ok(a),    1)
    ce_eq("2.5 -> 2500", numw_milli(a), 2500)
    ce_str_eq("unit kg", numw_unit(a),  "kg")
    ce_eq("value trunc", numw_value(a), 2)

    let b = numw_parse("100")
    ce_eq("100 -> 100000", numw_milli(b), 100000)
    ce_str_eq("no unit",   numw_unit(b),  "")

    let c = numw_parse("12")
    ce_eq("12 -> 12000",   numw_milli(c), 12000)
}

fn test_parse_words() {
    let a = numw_parse("three hundred grams")
    ce_eq("ok", numw_ok(a), 1)
    ce_eq("300 -> 300000", numw_milli(a), 300000)
    ce_str_eq("g", numw_unit(a), "g")

    // unit only attaches when recognised: "a dozen eggs" -> no unit.
    let b = numw_parse("a dozen eggs")
    ce_eq("dozen -> 12000", numw_milli(b), 12000)
    ce_str_eq("eggs not a unit", numw_unit(b), "")

    let c = numw_parse("five kg of flour")
    ce_eq("five -> 5000", numw_milli(c), 5000)
    ce_str_eq("kg before of", numw_unit(c), "kg")
}

fn test_parse_large() {
    let a = numw_parse("two million")
    ce_str_eq("milli string", int_to_str(numw_milli(a)), "2000000000")
    ce_eq("ok", numw_ok(a), 1)
}

fn test_parse_none() {
    let a = numw_parse("nothing numeric here")
    ce_eq("not ok", numw_ok(a), 0)
    ce_eq("milli 0", numw_milli(a), 0)
    ce_str_eq("no unit", numw_unit(a), "")
}

fn main() {
    test_words_small()
    test_words_large()
    test_words_extract_from_sentence()
    test_units()
    test_parse_digits()
    test_parse_words()
    test_parse_large()
    test_parse_none()
    ce_summary("number_words")
}

main()
