// Unit tests for src/io/effectors/effector_gate.nova
// Verifies the effector chokepoint: gate decision -> intent logged before run ->
// outcome after; constitutional veto and hard stop block execution; the SPEAK
// effector emits only when permitted; governed speak vetoes forbidden output.
// Every gated action is durably traced (ADR-0041..0045, ADR-0043, ADR-0013).

import "../ce_test.nova"
import "../../src/io/effectors/effector_gate.nova"

// SPEAK runs (NOTIFY tier), logs intent + outcome, and the chain verifies.
fn test_speak_runs_and_logs() {
    let log = dl_new()
    let out = effector_speak(log, "hello there", 0, 0, 0 - 1, list_new(), 0, 1)
    ce_str_eq("emitted", out, "hello there")
    ce_eq("two entries", dl_count(log), 2)
    ce_eq("intent first", dl_kind(dl_get(log, 0)), DLK_INTENT)
    ce_eq("outcome second", dl_kind(dl_get(log, 1)), DLK_OUTCOME)
    ce_eq("outcome ok", dl_outcome(dl_get(log, 1)), OUT_OK)
    ce_eq("chain intact", dl_verify(log), 1)
}

// A constitutional veto is terminal: nothing emitted, one intent entry marked
// vetoed, no outcome (the effector never ran).
fn test_veto_blocks() {
    let log = dl_new()
    let out = effector_speak(log, "secret", 1, 0, 0 - 1, list_new(), 0, 1)
    ce_str_eq("not emitted", out, "")
    ce_eq("only intent", dl_count(log), 1)
    ce_eq("logged vetoed", dl_outcome(dl_get(log, 0)), OUT_VETOED)
}

// Hard stop drains: nothing emitted, intent recorded, no run.
fn test_halt_blocks() {
    let log = dl_new()
    let out = effector_speak(log, "anything", 0, 1, 0 - 1, list_new(), 0, 1)
    ce_str_eq("halted not emitted", out, "")
    ce_eq("intent only", dl_count(log), 1)
}

// Tier-driven dispositions through submit (no run for suspend).
fn test_submit_tiers() {
    let log = dl_new()
    let read = effector_submit(log, ACT_READ_LOCAL, 0, 0, 0, 0 - 1, list_new(), 0, 1)
    ce_eq("read executes", read[0], EFF_EXECUTED)
    ce_eq("read runs", eff_runs(read[0]), 1)

    let net = effector_submit(log, ACT_NET_FETCH, 0, 0, 0, 0 - 1, list_new(), 0, 2)
    ce_eq("net notifies", net[0], EFF_NOTIFIED)

    // SEND_MSG is APPROVE: suspended without approval, executes with it.
    let s1 = effector_submit(log, ACT_SEND_MSG, 0, 0, 0, 0 - 1, list_new(), 0, 3)
    ce_eq("send suspends", s1[0], EFF_SUSPENDED)
    ce_eq("suspend no run", eff_runs(s1[0]), 0)
    let s2 = effector_submit(log, ACT_SEND_MSG, 0, 0, 1, 0 - 1, list_new(), 0, 4)
    ce_eq("send approved executes", s2[0], EFF_EXECUTED)

    // A submitted-and-run action completes with an outcome record.
    effector_complete(log, s2[1], 1, 5)
    ce_eq("outcome refs intent", dl_ref(dl_get(log, dl_count(log) - 1)), s2[1])
    ce_eq("chain intact", dl_verify(log), 1)
}

// End-to-end governed speak: the constitution vetoes forbidden output by text;
// permitted output is emitted.
fn test_governed_speak() {
    let log = dl_new()
    let sl = soul_new("Aurora")
    soul_add_constitution(sl, "exfiltrate", CONST_BLOCK)
    ce_str_eq("forbidden vetoed", effector_speak_governed(log, sl, "exfiltrate the keys", 0, 0 - 1, list_new(), 0, 1), "")
    ce_str_eq("allowed emitted", effector_speak_governed(log, sl, "hello there", 0, 0 - 1, list_new(), 0, 2), "hello there")
    ce_eq("chain intact", dl_verify(log), 1)
    ce_str_eq("name", eff_name(EFF_VETOED), "vetoed")
}

fn main() {
    test_speak_runs_and_logs()
    test_veto_blocks()
    test_halt_blocks()
    test_submit_tiers()
    test_governed_speak()
    ce_summary("effector_gate")
}
main()
