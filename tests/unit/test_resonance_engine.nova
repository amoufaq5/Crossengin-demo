// Unit tests for src/substrate/resonance_engine.nova
// Verifies reciprocal pair strength, resonance detection (co-active AND
// reciprocally linked), bidirectional pair reinforcement with growth, the
// one-pass resonance step (each pair once, only co-active reciprocals), and
// resonant-assembly extraction. ADR-0001, ADR-0007, ADR-0008, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/resonance_engine.nova"

fn snap(values) {
    let s = list_new()
    let i = 0
    while i < len(values) { push(s, values[i]); i = i + 1 }
    return s
}

fn test_pair_strength() {
    let g = syn_graph_new()
    syn_new(g, 0, 1, 600, 0)
    syn_new(g, 1, 0, 800, 0)
    ce_eq("reciprocal strength = min", res_pair_strength(g, 0, 1), 600)
    syn_new(g, 2, 3, 500, 0)   // one direction only
    ce_eq("one-way strength 0", res_pair_strength(g, 2, 3), 0)
    ce_eq("absent pair strength 0", res_pair_strength(g, 0, 9), 0)
}

fn test_is_resonant() {
    let g = syn_graph_new()
    syn_new(g, 0, 1, 600, 0)
    syn_new(g, 1, 0, 600, 0)
    syn_new(g, 2, 3, 600, 0)   // one-way
    let s = snap([500, 500, 500, 500])
    ce_eq("reciprocal + co-active", res_is_resonant(g, s, 0, 1, 400), 1)
    let s2 = snap([500, 100])
    ce_eq("not co-active -> not resonant", res_is_resonant(g, s2, 0, 1, 400), 0)
    ce_eq("one-way -> not resonant", res_is_resonant(g, s, 2, 3, 400), 0)
}

fn test_reinforce_pair_grows() {
    let g = syn_graph_new()
    // Both directions absent: grow at seed (200) then +50 -> 250 each.
    let strength = res_reinforce_pair(g, 0, 1, 50)
    ce_eq("grew both directions", syn_live(g), 2)
    ce_eq("seed + delta", strength, 250)
    // Existing: no new synapses, just +50 -> 300.
    let s2 = res_reinforce_pair(g, 0, 1, 50)
    ce_eq("no new synapses", syn_live(g), 2)
    ce_eq("reinforced to 300", s2, 300)
}

fn test_res_step() {
    let g = syn_graph_new()
    syn_new(g, 0, 1, 300, 0)   // pair A
    syn_new(g, 1, 0, 300, 0)
    syn_new(g, 2, 3, 300, 0)   // pair B
    syn_new(g, 3, 2, 300, 0)
    syn_new(g, 4, 5, 300, 0)   // one-way, not a pair
    let s = snap([500, 500, 500, 500, 500, 500])
    let n = res_step(g, s, 400, 50)
    ce_eq("two reciprocal pairs reinforced", n, 2)
    ce_eq("pair A forward potentiated", syn_weight(g, syn_find(g, 0, 1)), 350)
    ce_eq("pair A reverse potentiated", syn_weight(g, syn_find(g, 1, 0)), 350)
    ce_eq("one-way untouched", syn_weight(g, syn_find(g, 4, 5)), 300)

    // With one endpoint quiet, that pair is not reinforced.
    let g2 = syn_graph_new()
    syn_new(g2, 0, 1, 300, 0)
    syn_new(g2, 1, 0, 300, 0)
    let quiet = snap([500, 100])
    ce_eq("quiet endpoint -> no reinforce", res_step(g2, quiet, 400, 50), 0)
}

fn test_assembly() {
    let g = syn_graph_new()
    syn_new(g, 0, 1, 400, 0)   // 0<->1 reciprocal
    syn_new(g, 1, 0, 400, 0)
    syn_new(g, 0, 2, 400, 0)   // 0<->2 reciprocal
    syn_new(g, 2, 0, 400, 0)
    syn_new(g, 0, 3, 400, 0)   // 0->3 one-way
    let s = snap([500, 500, 500, 500])
    let members = res_assembly(g, s, 0, 400)
    ce_eq("assembly has reciprocal co-active neighbors", len(members), 2)
    ce_check("contains 1", contains(members, 1) == 1)
    ce_check("contains 2", contains(members, 2) == 1)
    ce_check("excludes one-way 3", contains(members, 3) == 0)
    // Quiet seed -> empty assembly.
    let quiet = snap([100, 500, 500, 500])
    ce_eq("quiet seed empty", len(res_assembly(g, quiet, 0, 400)), 0)
}

fn main() {
    test_pair_strength()
    test_is_resonant()
    test_reinforce_pair_grows()
    test_res_step()
    test_assembly()
    ce_summary("resonance_engine")
}

main()
