// Unit tests for the daemon TLS bootstrap plumbing (R94).
//
// Verifies base64 -> tls_config wiring by round-tripping cert DER
// through the base64 encoder (built in-test) and the base64 decoder
// (production module), then feeding into tls_config_new_server the
// same way daemon_load_tls_config_from_sidecar would if the env vars
// were set. Deliberately does NOT call getenv itself -- getenv
// behavior varies by NOVA runtime environment and the daemon-level
// test would sometimes hang or misbehave under the sandbox. The
// point is confirming base64_decode + tls_config_new_server compose
// correctly, which is the load-bearing wiring.

import "../ce_test.nova"
import "../../src/net/tls/base64.nova"
import "../../src/net/tls/tls_config.nova"
import "../../src/safety/ed25519.nova"
import "./fixtures/x509_test_certs.nova"

let _TD_NOW = 1718452800

// In-test base64 encoder (independent of the decoder under test).
let _TD_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn _td_b64_encode(bytes) {
    let out = ""
    let n = len(bytes)
    let i = 0
    while i + 3 <= n {
        let b0 = bytes[i]
        let b1 = bytes[i + 1]
        let b2 = bytes[i + 2]
        let v0 = int_and(int_shr(b0, 2), 63)
        let v1 = int_and(int_or(int_shl(int_and(b0, 3), 4),
                                 int_shr(b1, 4)), 63)
        let v2 = int_and(int_or(int_shl(int_and(b1, 15), 2),
                                 int_shr(b2, 6)), 63)
        let v3 = int_and(b2, 63)
        out = out + substr(_TD_ALPHABET, v0, 1)
        out = out + substr(_TD_ALPHABET, v1, 1)
        out = out + substr(_TD_ALPHABET, v2, 1)
        out = out + substr(_TD_ALPHABET, v3, 1)
        i = i + 3
    }
    let rem = n - i
    if rem == 1 {
        let b0 = bytes[i]
        let v0 = int_and(int_shr(b0, 2), 63)
        let v1 = int_and(int_shl(int_and(b0, 3), 4), 63)
        out = out + substr(_TD_ALPHABET, v0, 1)
        out = out + substr(_TD_ALPHABET, v1, 1)
        out = out + "=="
    }
    if rem == 2 {
        let b0 = bytes[i]
        let b1 = bytes[i + 1]
        let v0 = int_and(int_shr(b0, 2), 63)
        let v1 = int_and(int_or(int_shl(int_and(b0, 3), 4),
                                 int_shr(b1, 4)), 63)
        let v2 = int_and(int_shl(int_and(b1, 15), 2), 63)
        out = out + substr(_TD_ALPHABET, v0, 1)
        out = out + substr(_TD_ALPHABET, v1, 1)
        out = out + substr(_TD_ALPHABET, v2, 1)
        out = out + "="
    }
    return out
}

let _TD_ROOT = list_new()
let _TD_LEAF = list_new()

fn _td_root() {
    if len(_TD_ROOT) == 0 {
        let pk = fx_ed25519_test1_pub()
        let sk = fx_ed25519_test1_seed()
        let c = x509_build_test_cert("TD_Root", "TD_Root", 1,
                                     "200101000000Z", "490101000000Z",
                                     pk, sk, pk)
        let i = 0
        while i < len(c) { push(_TD_ROOT, c[i]); i = i + 1 }
    }
    return _TD_ROOT
}

fn _td_leaf() {
    if len(_TD_LEAF) == 0 {
        let leaf_pk = fx_ed25519_test2_pub()
        let root_sk = fx_ed25519_test1_seed()
        let root_pk = fx_ed25519_test1_pub()
        let c = x509_build_test_cert("TD_Leaf", "TD_Root", 2,
                                     "200101000000Z", "490101000000Z",
                                     leaf_pk, root_sk, root_pk)
        let i = 0
        while i < len(c) { push(_TD_LEAF, c[i]); i = i + 1 }
    }
    return _TD_LEAF
}

// The env-var pipe the daemon runs at boot when CROSSENGIN_TLS=1:
//   getenv -> string -> base64_decode -> byte list -> tls_config_new_server
// This test synthesizes the strings the sidecar would export and
// walks them through the same decode + config path.
fn test_env_pipe_end_to_end() {
    let root = _td_root()
    let leaf = _td_leaf()
    let priv = fx_ed25519_test2_seed()
    let root_b64 = _td_b64_encode(root)
    let leaf_b64 = _td_b64_encode(leaf)
    let priv_b64 = _td_b64_encode(priv)
    // Decode.
    let root_res = base64_decode(root_b64)
    let leaf_res = base64_decode(leaf_b64)
    let priv_res = base64_decode(priv_b64)
    ce_eq("root decode ok", root_res[0], 1)
    ce_eq("leaf decode ok", leaf_res[0], 1)
    ce_eq("priv decode ok", priv_res[0], 1)
    ce_eq("root decode len", len(root_res[1]), len(root))
    ce_eq("leaf decode len", len(leaf_res[1]), len(leaf))
    ce_eq("priv decode len", len(priv_res[1]), 32)
    // Feed into tls_config_new_server.
    let cfg = list_new()
    ce_eq("tls_config_new_server ok",
          tls_config_new_server(cfg, leaf_res[1], len(leaf_res[1]),
                                 priv_res[1], root_res[1], len(root_res[1])),
          1)
    ce_eq("role = SERVER",
          tls_config_role(cfg), TLS_CONFIG_ROLE_SERVER)
}

fn test_env_pipe_bad_base64_refused() {
    // A garbled env-var: base64_decode returns ok=0, and the daemon
    // path treats that as "missing material" and refuses to boot
    // rather than silently downgrading the wire.
    let bad = "not!!valid==base64"
    let res = base64_decode(bad)
    ce_eq("garbled b64 refused", res[0], 0)
}

fn main() {
    test_env_pipe_end_to_end()
    test_env_pipe_bad_base64_refused()
    ce_summary("daemon_tls_bootstrap")
}

main()
