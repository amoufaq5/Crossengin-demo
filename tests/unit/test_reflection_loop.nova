// Unit tests for src/parts/meta/reflection_loop.nova
// Verifies a forward-sim rollout from a seed lands NEW atom labels into
// refl_kg as tentative atoms, empty seeds are a clean no-op, and re-running
// the same reflection corroborates instead of duplicating. ADR-0032/0023.

import "../ce_test.nova"
import "../../src/parts/meta/reflection_loop.nova"

fn _build() {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let ikg = imagination_kg_init(reg)
    let refl = refl_kg_init(reg)
    let c_a = kg_add_atom(kg, ATOM_CONCEPT, "a", 0)
    let c_b = kg_add_atom(kg, ATOM_CONCEPT, "b", 0)
    let c_c = kg_add_atom(kg, ATOM_CONCEPT, "c", 0)
    // patterns a -> b, b -> c so a depth-2 rollout reaches both.
    let s_a = list_new() push(s_a, atom_id(c_a))
    let s_b = list_new() push(s_b, atom_id(c_b))
    let s_c = list_new() push(s_c, atom_id(c_c))
    pattern_new(ikg, "ab", s_a, s_b, 0)
    pattern_new(ikg, "bc", s_b, s_c, 0)
    let env = list_new()
    push(env, kg) push(env, ikg) push(env, refl)
    push(env, atom_id(c_a)) push(env, atom_id(c_b)) push(env, atom_id(c_c))
    return env
}

fn test_basic_reflection() {
    let env = _build()
    let kg = env[0]; let ikg = env[1]; let refl = env[2]
    let id_a = env[3]
    let ids = list_new() push(ids, id_a)
    let seed = refl_seed_from_ids(ids)
    let labels = refl_run(kg, ikg, refl, seed, 2, 0, 0)
    ce_check("derived inferences", len(labels) >= 1)
    ce_check("refl_kg grew", refl_size(refl) >= 1)
    ce_check("'b' tentatively recorded", kg_find_atom(refl, "b") != 0)
    ce_check("'c' tentatively recorded", kg_find_atom(refl, "c") != 0)
}

fn test_empty_seed_is_noop() {
    let env = _build()
    let kg = env[0]; let ikg = env[1]; let refl = env[2]
    let seed = img_state_new()
    let labels = refl_run(kg, ikg, refl, seed, 2, 0, 0)
    ce_eq("empty seed -> empty result", len(labels), 0)
    ce_eq("refl_kg untouched", refl_size(refl), 0)
}

// Two reflections from the same seed should produce the same labels but NOT
// duplicate atoms -- the second call corroborates existing entries instead.
fn test_double_reflection_corroborates() {
    let env = _build()
    let kg = env[0]; let ikg = env[1]; let refl = env[2]
    let id_a = env[3]
    let ids = list_new() push(ids, id_a)
    let seed = refl_seed_from_ids(ids)
    refl_run(kg, ikg, refl, seed, 2, 0, 0)
    let first = refl_size(refl)
    refl_run(kg, ikg, refl, seed, 2, 0, 0)
    let second = refl_size(refl)
    ce_eq("no duplicates on re-run", first, second)
    // The corroborating call should have increased the belief of the existing
    // tentative atoms.
    let b_atom = kg_find_atom(refl, "b")
    ce_check("'b' got an additional observation",
        atom_evidence(b_atom) >= 1)
}

// The tentative atoms wear an explicit "reflection" provenance so callers can
// distinguish them from real seeded knowledge.
fn test_tentative_provenance() {
    let env = _build()
    let kg = env[0]; let ikg = env[1]; let refl = env[2]
    let id_a = env[3]
    let ids = list_new() push(ids, id_a)
    refl_run(kg, ikg, refl, refl_seed_from_ids(ids), 2, 0, 0)
    let b_atom = kg_find_atom(refl, "b")
    ce_str_eq("provenance tag", atom_payload_get(b_atom, "provenance"), "reflection")
}

fn main() {
    test_basic_reflection()
    test_empty_seed_is_noop()
    test_double_reflection_corroborates()
    test_tentative_provenance()
    ce_summary("reflection_loop")
}
main()
