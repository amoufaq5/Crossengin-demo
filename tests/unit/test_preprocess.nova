// Unit tests for src/learning/preprocess.nova
// Verifies the HTML strip, entity decode, sentence split, tokenize,
// stopword filter, triple extraction, and the end-to-end pipeline.
// ADR-0028 (transform seam), ADR-0031 (reasoning operators).

import "../ce_test.nova"
import "../../src/learning/preprocess.nova"

// ---- HTML strip ------------------------------------------------------------

fn test_strip_plain_tags() {
    let out = preprocess_strip_html("<p>hello <b>world</b></p>")
    ce_check("plain tags stripped (contains hello world)",
             str_eq(out, "hello world") + str_eq(out, "hello world ") > 0)
}

fn test_strip_script_block() {
    let out = preprocess_strip_html("before<script>alert(1);var x=2;</script>after")
    // The script body must be gone -- no 'alert', no '=' chars.
    let bad = 0
    let i = 0
    while i < len(out) {
        let c = char_at(out, i)
        if c == 61 { bad = bad + 1 }   // '='
        if c == 40 { bad = bad + 1 }   // '('
        i = i + 1
    }
    ce_eq("script body removed (no parens/equals)", bad, 0)
    // 'before' and 'after' must both survive.
    ce_check("before survives", _t_contains(out, "before"))
    ce_check("after survives", _t_contains(out, "after"))
}

fn test_strip_style_block() {
    let out = preprocess_strip_html("hi<style>.x{color:red}</style>bye")
    ce_check("style removed", _t_contains(out, "hi"))
    ce_check("style removed (bye)", _t_contains(out, "bye"))
    ce_check("css selector gone", _t_contains(out, "color") == 0)
}

fn test_strip_entities() {
    ce_str_eq("&amp;", _t_squeeze(preprocess_strip_html("a&amp;b")), "a&b")
    ce_str_eq("&lt;",  _t_squeeze(preprocess_strip_html("a&lt;b")),  "a<b")
    ce_str_eq("&gt;",  _t_squeeze(preprocess_strip_html("a&gt;b")),  "a>b")
    ce_str_eq("&quot;",_t_squeeze(preprocess_strip_html("a&quot;b")), "a\"b")
    ce_str_eq("&#39;", _t_squeeze(preprocess_strip_html("a&#39;b")), "a'b")
    ce_str_eq("&nbsp;",_t_squeeze(preprocess_strip_html("a&nbsp;b")), "a b")
}

fn test_strip_empty() {
    ce_str_eq("empty html", preprocess_strip_html(""), "")
}

fn test_strip_block_to_newline() {
    // <p> + </p> should introduce sentence boundaries downstream.
    let out = preprocess_strip_html("<p>One sentence.</p><p>Two now.</p>")
    ce_check("first survives", _t_contains(out, "One"))
    ce_check("second survives", _t_contains(out, "Two"))
}

fn test_strip_nested_unknown() {
    let out = preprocess_strip_html("<span class='x'>kept</span>")
    ce_check("span content kept", _t_contains(out, "kept"))
}

// ---- sentence split --------------------------------------------------------

fn test_split_basic() {
    let s = preprocess_split_sentences("Hello world. This is two. And three!")
    ce_eq("3 sentences", len(s), 3)
}

fn test_split_question_exclaim() {
    let s = preprocess_split_sentences("Why? Because. Wow!")
    ce_eq("3 sentences (?.!)", len(s), 3)
}

fn test_split_abbrev_dr() {
    // "Dr. Smith arrived. He left." -> 2 sentences, NOT 3.
    let s = preprocess_split_sentences("Dr. Smith arrived. He left.")
    ce_eq("Dr. not a sentence end", len(s), 2)
}

fn test_split_abbrev_eg() {
    let s = preprocess_split_sentences("Examples include e.g. fever. Pain too.")
    ce_eq("e.g. not a sentence end", len(s), 2)
}

fn test_split_abbrev_ie() {
    let s = preprocess_split_sentences("Pain, i.e. discomfort, is common. Always.")
    ce_eq("i.e. not a sentence end", len(s), 2)
}

fn test_split_no_trailing_lower() {
    // Period followed by lowercase should NOT split (URLs / decimals).
    let s = preprocess_split_sentences("Visit example.com today. Now go.")
    ce_eq("decimal-like no split", len(s), 2)
}

fn test_split_empty() {
    let s = preprocess_split_sentences("")
    ce_eq("empty -> no sentences", len(s), 0)
}

fn test_split_single_no_terminator() {
    let s = preprocess_split_sentences("Just one fragment")
    ce_eq("trailing fragment kept", len(s), 1)
}

// ---- tokenize --------------------------------------------------------------

fn test_tokenize_basic() {
    let t = preprocess_tokenize("Hello World Foo")
    ce_eq("3 tokens", len(t), 3)
    ce_str_eq("lowercased 0", t[0], "hello")
    ce_str_eq("lowercased 1", t[1], "world")
    ce_str_eq("lowercased 2", t[2], "foo")
}

fn test_tokenize_punctuation() {
    let t = preprocess_tokenize("apple, banana; cherry!")
    ce_eq("3 tokens punct", len(t), 3)
    ce_str_eq("apple", t[0], "apple")
    ce_str_eq("banana", t[1], "banana")
    ce_str_eq("cherry", t[2], "cherry")
}

fn test_tokenize_skips_numbers() {
    let t = preprocess_tokenize("aspirin 500 mg helps")
    // "aspirin", "mg", "helps" -- "500" is pure-numeric and dropped.
    ce_eq("3 non-numeric tokens", len(t), 3)
    let has_500 = 0
    let i = 0
    while i < len(t) {
        if str_eq(t[i], "500") == 1 { has_500 = 1 }
        i = i + 1
    }
    ce_eq("number dropped", has_500, 0)
}

fn test_tokenize_skips_single_chars() {
    let t = preprocess_tokenize("a is for apple")
    // 'a' (single char) AND 'is' (stopword but not yet filtered here) AND
    // 'for' (3 chars) and 'apple'. Tokenize alone drops 'a'.
    let has_a = 0
    let i = 0
    while i < len(t) {
        if str_eq(t[i], "a") == 1 { has_a = 1 }
        i = i + 1
    }
    ce_eq("single char dropped", has_a, 0)
}

fn test_tokenize_empty() {
    let t = preprocess_tokenize("")
    ce_eq("empty -> 0 tokens", len(t), 0)
}

// ---- stopwords -------------------------------------------------------------

fn test_stopword_membership() {
    ce_eq("'the' is stopword", preprocess_is_stopword("the"), 1)
    ce_eq("'is' is stopword",  preprocess_is_stopword("is"),  1)
    ce_eq("'a' is stopword",   preprocess_is_stopword("a"),   1)
    ce_eq("'fever' not stop",  preprocess_is_stopword("fever"), 0)
}

fn test_stopword_filter() {
    let toks = list_new()
    push(toks, "fever"); push(toks, "is"); push(toks, "a"); push(toks, "symptom")
    let kept = preprocess_filter_stopwords(toks)
    ce_eq("2 kept", len(kept), 2)
    ce_str_eq("fever kept", kept[0], "fever")
    ce_str_eq("symptom kept", kept[1], "symptom")
}

fn test_stopword_swap() {
    // Save current, swap to a tiny custom list, verify, restore.
    let custom = list_new()
    push(custom, "alpha"); push(custom, "beta")
    preprocess_set_stopwords(custom)
    ce_eq("alpha now stop", preprocess_is_stopword("alpha"), 1)
    ce_eq("'the' no longer stop", preprocess_is_stopword("the"), 0)
    // Restore the default (re-initialize lazily).
    preprocess_set_stopwords(_pp_default_stopwords())
    ce_eq("'the' stop again", preprocess_is_stopword("the"), 1)
}

// ---- triple extraction -----------------------------------------------------

fn test_triple_is_a() {
    let t = preprocess_extract_triples("Fever is a symptom of infection.")
    ce_check("at least one triple", len(t) >= 1)
    // First triple expected: (fever, is_a, symptom)
    ce_str_eq("subject 0", t[0][0], "fever")
    ce_str_eq("relation 0", t[0][1], "is_a")
    ce_str_eq("object 0", t[0][2], "symptom")
}

fn test_triple_causes() {
    let t = preprocess_extract_triples("Smoking causes cancer.")
    ce_check("at least one triple", len(t) >= 1)
    ce_str_eq("subject", t[0][0], "smoking")
    ce_str_eq("relation", t[0][1], "causes")
    ce_str_eq("object", t[0][2], "cancer")
}

fn test_triple_has() {
    let t = preprocess_extract_triples("Aspirin has side effects.")
    ce_check("at least one triple", len(t) >= 1)
    ce_str_eq("subject", t[0][0], "aspirin")
    ce_str_eq("relation", t[0][1], "has_property")
    ce_str_eq("object (compound)", t[0][2], "side_effects")   // R45 noun-phrase chunking
}

fn test_triple_part_of() {
    let t = preprocess_extract_triples("Heart is part of body.")
    ce_check("at least one triple", len(t) >= 1)
    ce_str_eq("subject", t[0][0], "heart")
    ce_str_eq("relation", t[0][1], "part_of")
    ce_str_eq("object", t[0][2], "body")
}

fn test_triple_means() {
    let t = preprocess_extract_triples("Headache means pain.")
    ce_check("at least one triple", len(t) >= 1)
    ce_str_eq("subject", t[0][0], "headache")
    ce_str_eq("relation", t[0][1], "defined_as")
    ce_str_eq("object", t[0][2], "pain")
}

fn test_triple_defined_as() {
    let t = preprocess_extract_triples("Cardiology is defined as study.")
    ce_check("at least one triple", len(t) >= 1)
    ce_str_eq("subject", t[0][0], "cardiology")
    ce_str_eq("relation", t[0][1], "defined_as")
    ce_str_eq("object", t[0][2], "study")
}

fn test_triple_max_two() {
    // A longer sentence with several relations -- cap at 2.
    let t = preprocess_extract_triples("Aspirin is a drug. Aspirin has uses. Aspirin causes effects.")
    // Each sentence yields up to 2 triples; we pass it as ONE call though, so
    // the cap applies to the whole input. Just verify we get <=2 here.
    ce_check("cap at 2", len(t) <= 2)
}

fn test_triple_short_sentence() {
    let t = preprocess_extract_triples("hi")
    ce_eq("too short -> 0 triples", len(t), 0)
}

// ---- R44: noise filtering --------------------------------------------------
fn test_triple_negation_drops() {
    // "is not visible" must NOT assert (spectrum, is_a, not/visible).
    let t = preprocess_extract_triples("The spectrum is not visible.")
    ce_eq("negated relation -> 0 triples", len(t), 0)
}

fn test_triple_stopword_subject_drops() {
    // pronoun subject "it" is a function word -> no triple.
    let t = preprocess_extract_triples("It is a process.")
    ce_eq("stopword subject -> 0 triples", len(t), 0)
}

fn test_triple_object_is_content() {
    // "is a green pigment" -> object skips the article to a content word, and
    // "is for use" yields a content object, never the preposition "for".
    let a = preprocess_extract_triples("Chlorophyll is a green pigment.")
    ce_check("chlorophyll triple", len(a) >= 1)
    ce_str_eq("content subject", a[0][0], "chlorophyll")
    ce_str_eq("content object (compound)", a[0][2], "green_pigment")   // R45
    let b = preprocess_extract_triples("This domain is for use.")
    if len(b) >= 1 {
        ce_check("object is not the preposition 'for'", str_eq(b[0][2], "for") == 0)
    } else {
        ce_check("object is not the preposition 'for'", 1 == 1)
    }
}

fn test_triple_empty_sentence() {
    let t = preprocess_extract_triples("")
    ce_eq("empty -> 0 triples", len(t), 0)
}

// ---- R45: noun-phrase chunking ---------------------------------------------
fn test_triple_compound_object() {
    let t = preprocess_extract_triples("Smoking causes lung cancer.")
    ce_check("triple", len(t) >= 1)
    ce_str_eq("compound object survives", t[0][2], "lung_cancer")
}

fn test_triple_compound_subject() {
    let t = preprocess_extract_triples("Carbon dioxide is a gas.")
    ce_check("triple", len(t) >= 1)
    ce_str_eq("compound subject survives", t[0][0], "carbon_dioxide")
    ce_str_eq("object", t[0][2], "gas")
}

// ---- end-to-end ------------------------------------------------------------

fn test_run_empty() {
    preprocess_stats_reset()
    let r = preprocess_run("")
    ce_eq("empty atoms", len(r[0]), 0)
    ce_eq("empty triples", len(r[1]), 0)
}

fn test_run_pure_html_no_text() {
    preprocess_stats_reset()
    let r = preprocess_run("<style>x{}</style><script>y</script>")
    ce_eq("no atoms", len(r[0]), 0)
    ce_eq("no triples", len(r[1]), 0)
}

fn test_run_e2e_small_fixture() {
    // Restore default stopwords in case a prior test swapped them.
    preprocess_set_stopwords(_pp_default_stopwords())
    preprocess_stats_reset()
    let html = "<html><body><h1>Fever</h1><p>Fever is a symptom. Smoking causes cancer.</p></body></html>"
    let r = preprocess_run(html)
    let atoms = r[0]
    let triples = r[1]
    ce_check("atoms non-empty", len(atoms) >= 3)
    ce_check("triples non-empty", len(triples) >= 1)
    // 'fever' should be among atoms.
    let has_fever = 0
    let i = 0
    while i < len(atoms) {
        if str_eq(atoms[i], "fever") == 1 { has_fever = 1 }
        i = i + 1
    }
    ce_eq("fever atom present", has_fever, 1)
    // At least one expected triple.
    let has_fever_triple = 0
    let has_smoking_triple = 0
    let j = 0
    while j < len(triples) {
        if str_eq(triples[j][0], "fever") == 1 {
            if str_eq(triples[j][1], "is_a") == 1 { has_fever_triple = 1 }
        }
        if str_eq(triples[j][0], "smoking") == 1 {
            if str_eq(triples[j][1], "causes") == 1 { has_smoking_triple = 1 }
        }
        j = j + 1
    }
    ce_eq("fever is_a triple", has_fever_triple, 1)
    ce_eq("smoking causes triple", has_smoking_triple, 1)
}

fn test_run_telemetry() {
    preprocess_stats_reset()
    let r = preprocess_run("Fever is a sign. Pain is a symptom.")
    let s = preprocess_stats()
    ce_eq("2 sentences counted", s[0], 2)
    ce_check("tokens > 0", s[1] > 0)
    ce_check("triples > 0", s[2] > 0)
    ce_check("html bytes > 0", s[3] > 0)
}

fn test_run_dedup_atoms() {
    preprocess_set_stopwords(_pp_default_stopwords())
    preprocess_stats_reset()
    let r = preprocess_run("fever fever fever pain pain")
    let atoms = r[0]
    // After dedup, expect exactly 2 atoms.
    ce_eq("deduped to 2 atoms", len(atoms), 2)
}

// ---- helpers ---------------------------------------------------------------

// Strict substring search (no regex), used by ce_check'd assertions above.
fn _t_contains(hay, needle) {
    let nh = len(hay)
    let nn = len(needle)
    if nn == 0 { return 1 }
    if nh < nn { return 0 }
    let limit = nh - nn
    let i = 0
    while i <= limit {
        let j = 0
        let ok = 1
        while j < nn {
            if char_at(hay, i + j) != char_at(needle, j) { ok = 0; j = nn }
            else { j = j + 1 }
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Trim a single trailing/leading space (entity tests may yield "a&b " or "a&b").
fn _t_squeeze(s) {
    let n = len(s)
    if n == 0 { return s }
    let lo = 0
    if char_at(s, 0) == 32 { lo = 1 }
    let hi = n - 1
    if hi >= lo {
        if char_at(s, hi) == 32 { hi = hi - 1 }
    }
    if hi < lo { return "" }
    return substr(s, lo, hi - lo + 1)
}

fn main() {
    test_strip_plain_tags()
    test_strip_script_block()
    test_strip_style_block()
    test_strip_entities()
    test_strip_empty()
    test_strip_block_to_newline()
    test_strip_nested_unknown()

    test_split_basic()
    test_split_question_exclaim()
    test_split_abbrev_dr()
    test_split_abbrev_eg()
    test_split_abbrev_ie()
    test_split_no_trailing_lower()
    test_split_empty()
    test_split_single_no_terminator()

    test_tokenize_basic()
    test_tokenize_punctuation()
    test_tokenize_skips_numbers()
    test_tokenize_skips_single_chars()
    test_tokenize_empty()

    test_stopword_membership()
    test_stopword_filter()
    test_stopword_swap()

    test_triple_is_a()
    test_triple_causes()
    test_triple_has()
    test_triple_part_of()
    test_triple_means()
    test_triple_defined_as()
    test_triple_max_two()
    test_triple_short_sentence()
    test_triple_empty_sentence()
    test_triple_negation_drops()
    test_triple_stopword_subject_drops()
    test_triple_object_is_content()
    test_triple_compound_object()
    test_triple_compound_subject()

    test_run_empty()
    test_run_pure_html_no_text()
    test_run_e2e_small_fixture()
    test_run_telemetry()
    test_run_dedup_atoms()

    ce_summary("preprocess")
}

main()
