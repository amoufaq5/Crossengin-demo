// Unit tests for src/substrate/part_lifecycle.nova
// Verifies dynamic KG part spawn, idempotent re-spawn, retire (KG only, not
// fixed parts), revive preserving substrate, and active-part listing.
// ADR-0001, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/part_lifecycle.nova"

fn test_spawn_kg() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    let med = pl_spawn_kg(reg, "medicine", 128, 4)
    ce_eq("kg part id is 7 (after 7 fixed)", med, 7)
    let part = registry_get(reg, med)
    ce_check("is kg part", pl_is_kg(part) == 1)
    ce_str_eq("domain extracted", pl_kg_domain(part), "medicine")
    ce_str_eq("kg name", part_name(part), "kg-medicine")
    // Re-spawning the same domain is idempotent.
    let med2 = pl_spawn_kg(reg, "medicine", 128, 4)
    ce_eq("respawn same id", med2, med)
    ce_eq("no duplicate", registry_count(reg), 8)
}

fn test_retire_and_revive() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    let law = pl_spawn_kg(reg, "law", 64, 4)
    ce_eq("active before retire", pl_is_active(reg, law), 1)
    let active_before = pl_active_count(reg)

    // Mark some substrate state so we can prove revive preserves it.
    let part = registry_get(reg, law)
    syn_new(part_syn(part), 0, 1, 600, 0)
    ce_eq("synapse present", syn_live(part_syn(part)), 1)

    ce_eq("retire succeeds", pl_retire(reg, law), 1)
    ce_eq("inactive after retire", pl_is_active(reg, law), 0)
    ce_eq("active count dropped", pl_active_count(reg), active_before - 1)
    ce_eq("double retire -> 0", pl_retire(reg, law), 0)

    // Revive via spawn: substrate intact.
    let revived = pl_spawn_kg(reg, "law", 64, 4)
    ce_eq("revive same id", revived, law)
    ce_eq("active again", pl_is_active(reg, law), 1)
    ce_eq("synapse preserved across retire/revive", syn_live(part_syn(registry_get(reg, law))), 1)
}

fn test_fixed_parts_not_retirable() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    let reasoning = registry_find(reg, "reasoning")
    ce_eq("retire fixed part refused", pl_retire(reg, reasoning), 0)
    ce_eq("reasoning still active", pl_is_active(reg, reasoning), 1)
    ce_eq("retire unknown id refused", pl_retire(reg, 999), 0)
}

fn test_list_active_kg() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 64, 4)
    pl_spawn_kg(reg, "medicine", 64, 4)
    pl_spawn_kg(reg, "law", 64, 4)
    pl_spawn_kg(reg, "music", 64, 4)
    ce_eq("three active kg", len(pl_list_active_kg(reg)), 3)
    pl_retire(reg, registry_find(reg, "kg-law"))
    ce_eq("two active kg after retire", len(pl_list_active_kg(reg)), 2)
    // Fixed parts are not counted as KG parts.
    ce_check("fixed not in kg list", contains(pl_list_active_kg(reg), registry_find(reg, "soul")) == 0)
}

fn main() {
    test_spawn_kg()
    test_retire_and_revive()
    test_fixed_parts_not_retirable()
    test_list_active_kg()
    ce_summary("part_lifecycle")
}

main()
