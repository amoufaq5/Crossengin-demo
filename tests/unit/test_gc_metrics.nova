// Unit tests for src/kg/gc_metrics.nova -- the ADR-0087 GC observability
// registry that counters increment into. Exercises the per-KG isolation
// invariant (each KG's counters live at a stable parallel index), the
// counter vs sample distinction (compact runs accumulate; freelist samples
// overwrite), and the snapshot shape /gc-stats reads from.
// ADR-0087, Phase L R2.

import "../ce_test.nova"
import "../../src/kg/gc_metrics.nova"

// Fresh registry: no KG labels yet, snapshot is empty, kg_count is 0.
fn test_fresh_registry_is_empty() {
    let reg = gc_metrics_new()
    ce_check("registry created", reg != 0)
    ce_eq("no KG names", len(gcm_kg_names(reg)), 0)
    ce_eq("kg_count is 0", gcm_kg_count(reg), 0)
    ce_eq("snapshot is empty", len(gcm_snapshot(reg)), 0)
    // Reading a counter for a KG that has never been seen returns 0.
    ce_eq("reclaimed of unknown KG", gcm_reclaimed_total(reg, "med"), 0)
    ce_eq("swept of unknown KG", gcm_swept_total(reg, "med"), 0)
}

// gcm_ensure_kg auto-adds on first call; second call is idempotent (same idx).
fn test_ensure_kg_idempotent() {
    let reg = gc_metrics_new()
    let i0 = gcm_ensure_kg(reg, "med")
    ce_eq("first KG index 0", i0, 0)
    let i1 = gcm_ensure_kg(reg, "law")
    ce_eq("second KG index 1", i1, 1)
    let i0b = gcm_ensure_kg(reg, "med")
    ce_eq("first KG same idx on re-ensure", i0b, 0)
    ce_eq("kg_count is 2", gcm_kg_count(reg), 2)
    let names = gcm_kg_names(reg)
    ce_eq("names length 2", len(names), 2)
    ce_str_eq("names[0]", names[0], "med")
    ce_str_eq("names[1]", names[1], "law")
}

// Two KGs: each counter stays in its own slot.
fn test_reclaim_per_kg_isolation() {
    let reg = gc_metrics_new()
    gcm_inc_reclaimed(reg, "med")
    gcm_inc_reclaimed(reg, "med")
    gcm_inc_reclaimed(reg, "law")
    ce_eq("med reclaimed = 2", gcm_reclaimed_total(reg, "med"), 2)
    ce_eq("law reclaimed = 1", gcm_reclaimed_total(reg, "law"), 1)
    // Cross-check: an unseen KG label reads 0 without adding a row.
    ce_eq("unseen KG reclaimed = 0", gcm_reclaimed_total(reg, "sky"), 0)
    ce_eq("kg_count still 2", gcm_kg_count(reg), 2)
}

// swept accumulates by N; swept_episodic is a separate counter.
fn test_swept_accumulates_by_n() {
    let reg = gc_metrics_new()
    gcm_inc_swept(reg, "med", 5)
    ce_eq("swept += 5", gcm_swept_total(reg, "med"), 5)
    gcm_inc_swept(reg, "med", 3)
    ce_eq("swept += 3 more -> 8", gcm_swept_total(reg, "med"), 8)
    // n=0 or n<0 is a no-op.
    gcm_inc_swept(reg, "med", 0)
    ce_eq("n=0 no-op", gcm_swept_total(reg, "med"), 8)
    gcm_inc_swept(reg, "med", 0 - 4)
    ce_eq("negative n no-op", gcm_swept_total(reg, "med"), 8)
    // Episodic swept is independent.
    gcm_inc_swept_episodic(reg, "med", 2)
    ce_eq("swept_episodic += 2", gcm_swept_episodic_total(reg, "med"), 2)
    ce_eq("swept unaffected", gcm_swept_total(reg, "med"), 8)
}

// Each protection counter increments its own slot; per-KG isolation preserved.
fn test_protection_counters_isolated() {
    let reg = gc_metrics_new()
    gcm_inc_protected_operator_premise(reg, "med")
    gcm_inc_protected_operator_premise(reg, "med")
    gcm_inc_protected_operator_conclusion(reg, "med")
    gcm_inc_protected_episodic_member(reg, "med")
    gcm_inc_protected_alias(reg, "med")
    ce_eq("prot_op_premise = 2", gcm_protected_operator_premise(reg, "med"), 2)
    ce_eq("prot_op_conclusion = 1", gcm_protected_operator_conclusion(reg, "med"), 1)
    ce_eq("prot_ep_member = 1", gcm_protected_episodic_member(reg, "med"), 1)
    ce_eq("prot_alias = 1", gcm_protected_alias(reg, "med"), 1)
    // Second KG: all counters start at 0, no leak.
    gcm_ensure_kg(reg, "law")
    ce_eq("law prot_op_premise = 0", gcm_protected_operator_premise(reg, "law"), 0)
    ce_eq("law prot_op_conclusion = 0", gcm_protected_operator_conclusion(reg, "law"), 0)
    ce_eq("law prot_ep_member = 0", gcm_protected_episodic_member(reg, "law"), 0)
    ce_eq("law prot_alias = 0", gcm_protected_alias(reg, "law"), 0)
}

// gcm_record_compact: bumps runs by 1, adds atoms_removed, sets last_tick.
fn test_record_compact() {
    let reg = gc_metrics_new()
    gcm_record_compact(reg, "med", 7, 100)
    ce_eq("compact_runs = 1", gcm_compact_runs_total(reg, "med"), 1)
    ce_eq("atoms_removed = 7", gcm_compact_atoms_removed_total(reg, "med"), 7)
    ce_eq("last_tick = 100", gcm_compact_last_tick(reg, "med"), 100)
    gcm_record_compact(reg, "med", 4, 200)
    ce_eq("compact_runs = 2", gcm_compact_runs_total(reg, "med"), 2)
    ce_eq("atoms_removed accumulates -> 11", gcm_compact_atoms_removed_total(reg, "med"), 11)
    ce_eq("last_tick overwritten -> 200", gcm_compact_last_tick(reg, "med"), 200)
    // A compact with 0 atoms_removed still bumps runs; the removed counter
    // stays put (it's a delta, and delta 0 is a no-op).
    gcm_record_compact(reg, "med", 0, 300)
    ce_eq("compact_runs = 3", gcm_compact_runs_total(reg, "med"), 3)
    ce_eq("atoms_removed unchanged", gcm_compact_atoms_removed_total(reg, "med"), 11)
    ce_eq("last_tick = 300", gcm_compact_last_tick(reg, "med"), 300)
}

// gcm_sample_freelist: OVERWRITES (not accumulates) -- always the latest sample.
fn test_sample_freelist_overwrites() {
    let reg = gc_metrics_new()
    gcm_sample_freelist(reg, "med", 50, 250)
    ce_eq("freelist_size = 50", gcm_freelist_size_sampled(reg, "med"), 50)
    ce_eq("freelist_ratio = 250", gcm_freelist_ratio_permille_sampled(reg, "med"), 250)
    // Second sample OVERWRITES, does not accumulate.
    gcm_sample_freelist(reg, "med", 30, 150)
    ce_eq("freelist_size overwritten -> 30", gcm_freelist_size_sampled(reg, "med"), 30)
    ce_eq("freelist_ratio overwritten -> 150", gcm_freelist_ratio_permille_sampled(reg, "med"), 150)
    // Third sample -- 0 is a valid value (post-compact) and should overwrite too.
    gcm_sample_freelist(reg, "med", 0, 0)
    ce_eq("freelist_size overwritten -> 0", gcm_freelist_size_sampled(reg, "med"), 0)
    ce_eq("freelist_ratio overwritten -> 0", gcm_freelist_ratio_permille_sampled(reg, "med"), 0)
}

// gcm_snapshot: one row per KG, stable ordering, all fields present, and
// idempotent (calling twice gives the same values -- it's a read, not a
// clear).
fn test_snapshot_shape_and_idempotence() {
    let reg = gc_metrics_new()
    gcm_inc_reclaimed(reg, "med")
    gcm_inc_swept(reg, "med", 4)
    gcm_inc_protected_alias(reg, "med")
    gcm_record_compact(reg, "med", 2, 500)
    gcm_sample_freelist(reg, "med", 10, 100)
    gcm_inc_reclaimed(reg, "law")
    let snap1 = gcm_snapshot(reg)
    ce_eq("snapshot has 2 rows", len(snap1), 2)
    let row_med = snap1[0]
    ce_eq("snapshot row width", len(row_med), GCM_SNAP_FIELDS)
    ce_str_eq("row_med label", row_med[GCM_SNAP_KG], "med")
    ce_eq("row_med reclaimed", row_med[GCM_SNAP_RECLAIMED], 1)
    ce_eq("row_med swept", row_med[GCM_SNAP_SWEPT], 4)
    ce_eq("row_med prot_alias", row_med[GCM_SNAP_PROT_ALIAS], 1)
    ce_eq("row_med compact_runs", row_med[GCM_SNAP_COMPACT_RUNS], 1)
    ce_eq("row_med compact_atoms_removed", row_med[GCM_SNAP_COMPACT_ATOMS_REMOVED], 2)
    ce_eq("row_med compact_last_tick", row_med[GCM_SNAP_COMPACT_LAST_TICK], 500)
    ce_eq("row_med freelist_size", row_med[GCM_SNAP_FREELIST_SIZE], 10)
    ce_eq("row_med freelist_ratio", row_med[GCM_SNAP_FREELIST_RATIO_PERMILLE], 100)
    // Second snapshot -- same values (idempotent read).
    let snap2 = gcm_snapshot(reg)
    ce_eq("snap2 rows count", len(snap2), 2)
    ce_eq("snap2 row_med reclaimed", snap2[0][GCM_SNAP_RECLAIMED], 1)
    ce_eq("snap2 row_med swept", snap2[0][GCM_SNAP_SWEPT], 4)
    ce_eq("snap2 row_law reclaimed", snap2[1][GCM_SNAP_RECLAIMED], 1)
}

// A 0 metrics_reg (the "no metrics" back-compat default) is a no-op on every
// public counter -- the sentinel by which existing callers stay unchanged.
fn test_zero_reg_is_noop() {
    // All counters take reg==0 without crashing and return 0.
    ce_eq("inc_reclaimed on 0", gcm_inc_reclaimed(0, "med"), 0)
    ce_eq("inc_swept on 0", gcm_inc_swept(0, "med", 5), 0)
    ce_eq("inc_swept_ep on 0", gcm_inc_swept_episodic(0, "med", 5), 0)
    ce_eq("inc_prot_op_prem on 0", gcm_inc_protected_operator_premise(0, "med"), 0)
    ce_eq("inc_prot_op_conc on 0", gcm_inc_protected_operator_conclusion(0, "med"), 0)
    ce_eq("inc_prot_ep on 0", gcm_inc_protected_episodic_member(0, "med"), 0)
    ce_eq("inc_prot_alias on 0", gcm_inc_protected_alias(0, "med"), 0)
    ce_eq("record_compact on 0", gcm_record_compact(0, "med", 3, 100), 0)
    ce_eq("sample_freelist on 0", gcm_sample_freelist(0, "med", 10, 100), 0)
    // Reads on 0 return 0 without crashing.
    ce_eq("read on 0 reclaimed", gcm_reclaimed_total(0, "med"), 0)
    ce_eq("kg_count on 0", gcm_kg_count(0), 0)
    ce_eq("kg_names on 0", len(gcm_kg_names(0)), 0)
    ce_eq("snapshot on 0", len(gcm_snapshot(0)), 0)
}

// The module-level default: lazy-init on first read, gc_metrics_set_default
// installs a specific registry, gc_metrics_reset_default clears back to
// lazy-init state.
fn test_default_registry_lifecycle() {
    gc_metrics_reset_default()
    let d1 = gc_metrics_default()
    ce_check("lazy-init default", d1 != 0)
    ce_eq("default is empty", gcm_kg_count(d1), 0)
    let d2 = gc_metrics_default()
    ce_check("same default returned", d1 == d2)
    // Install a fresh, distinct registry as default; the accessor returns it.
    let alt = gc_metrics_new()
    gcm_inc_reclaimed(alt, "custom")
    gc_metrics_set_default(alt)
    let d3 = gc_metrics_default()
    ce_check("set_default swapped", d3 == alt)
    ce_eq("d3 has custom KG", gcm_reclaimed_total(d3, "custom"), 1)
    // Reset clears -- next read lazy-mints again.
    gc_metrics_reset_default()
    let d4 = gc_metrics_default()
    ce_check("reset lazily mints again", d4 != 0)
    ce_check("post-reset is distinct from alt", d4 != alt)
    ce_eq("post-reset is empty", gcm_kg_count(d4), 0)
}

// Independence proof: incrementing counters on KG X does NOT leak into KG Y's
// slots for the SAME counter type. Regressions here would mean the parallel-
// array invariant is broken (e.g. a shared slot instead of a per-KG one).
fn test_independence_across_kgs() {
    let reg = gc_metrics_new()
    let n_bumps = 5
    let i = 0
    while i < n_bumps {
        gcm_inc_reclaimed(reg, "med")
        gcm_inc_protected_operator_premise(reg, "law")
        i = i + 1
    }
    ce_eq("med reclaimed = 5", gcm_reclaimed_total(reg, "med"), 5)
    ce_eq("med prot_op_prem = 0 (not law)", gcm_protected_operator_premise(reg, "med"), 0)
    ce_eq("law reclaimed = 0 (not med)", gcm_reclaimed_total(reg, "law"), 0)
    ce_eq("law prot_op_prem = 5", gcm_protected_operator_premise(reg, "law"), 5)
}

fn main() {
    test_fresh_registry_is_empty()
    test_ensure_kg_idempotent()
    test_reclaim_per_kg_isolation()
    test_swept_accumulates_by_n()
    test_protection_counters_isolated()
    test_record_compact()
    test_sample_freelist_overwrites()
    test_snapshot_shape_and_idempotence()
    test_zero_reg_is_noop()
    test_default_registry_lifecycle()
    test_independence_across_kgs()
    ce_summary("gc_metrics")
}

main()
