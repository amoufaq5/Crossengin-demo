// Unit tests for src/ingest/importers/nt_triples.nova.

import "../ce_test.nova"
import "../../src/ingest/importers/nt_triples.nova"

fn test_uri_local() {
    ce_eq("http path", nt_uri_local("http://example.com/foo/bar"), "bar")
    ce_eq("fragment", nt_uri_local("http://example.com/x#name"), "name")
    ce_eq("no path", nt_uri_local("plain"), "plain")
    ce_eq("trailing slash", nt_uri_local("http://a/b/"), "")
}

fn test_safe_label() {
    ce_eq("clean stays", nt_safe_label("Q1234"), "Q1234")
    ce_eq("punct replaced", nt_safe_label("hello world!"), "hello_world_")
    ce_eq("dots kept", nt_safe_label("foo.bar"), "foo.bar")
}

fn test_parse_line_uri_uri() {
    let t = nt_parse_line("<http://s/1> <http://p/2> <http://o/3> .")
    ce_check("not null", t != 0)
    ce_eq("subj", t[0], "http://s/1")
    ce_eq("pred", t[1], "http://p/2")
    ce_eq("obj_kind uri", t[2], NT_TOK_URI)
    ce_eq("obj_val", t[3], "http://o/3")
}

fn test_parse_line_literal() {
    let t = nt_parse_line("<http://s/1> <http://p/2> \"hello\" .")
    ce_check("not null", t != 0)
    ce_eq("obj_kind lit", t[2], NT_TOK_LITERAL)
    ce_eq("obj_val", t[3], "hello")
}

fn test_parse_line_literal_with_lang() {
    let t = nt_parse_line("<http://s/1> <http://p/2> \"bonjour\"@fr .")
    ce_check("not null", t != 0)
    ce_eq("obj_val", t[3], "bonjour")
}

fn test_parse_line_literal_with_datatype() {
    let t = nt_parse_line("<http://s/1> <http://p/2> \"42\"^^<http://www.w3.org/2001/XMLSchema#int> .")
    ce_check("not null", t != 0)
    ce_eq("obj_val", t[3], "42")
}

fn test_parse_line_escaped_quote() {
    let t = nt_parse_line("<http://s> <http://p> \"a\\\"b\" .")
    ce_check("not null", t != 0)
    ce_eq("obj has quote", t[3], "a\"b")
}

fn test_parse_line_blank_returns_zero() {
    ce_check("blank", nt_parse_line("") == 0)
    ce_check("comment", nt_parse_line("# hi") == 0)
    ce_check("whitespace", nt_parse_line("   \t  ") == 0)
}

fn test_full_document() {
    let text = "<http://ex/Cat> <http://ex/isA> <http://ex/Animal> .\n"
             + "<http://ex/Dog> <http://ex/isA> <http://ex/Animal> .\n"
             + "<http://ex/Cat> <http://ex/name> \"Cat\" .\n"
    let r = nt_parse_text(text, "biology", "src:nt:test")
    let recs = nt_records(r)
    ce_eq("one record", len(recs), 1)
    let rec = recs[0]
    // atoms: Cat, isA, Animal, Dog, name, Cat-name (fact) -> 6
    ce_eq("6 atoms", len(cur_atoms(rec)), 6)
    // imps: Cat->Animal, Dog->Animal, Cat->Cat-name -> 3
    ce_eq("3 imps", len(cur_imps(rec)), 3)
    ce_eq("validator ok", cur_validate(rec), CUR_OK)
}

fn test_bad_lines_ignored() {
    let text = "not a triple\n"
             + "<http://s> <http://p> <http://o> .\n"
             + "<http://s2> <http://p2>\n"    // missing object + dot
    let r = nt_parse_text(text, "k", "src:x")
    ce_eq("one record", len(nt_records(r)), 1)
    // Only the middle line parsed.
    ce_check("one imp", len(cur_imps(nt_records(r)[0])) == 1)
}

fn main() {
    test_uri_local()
    test_safe_label()
    test_parse_line_uri_uri()
    test_parse_line_literal()
    test_parse_line_literal_with_lang()
    test_parse_line_literal_with_datatype()
    test_parse_line_escaped_quote()
    test_parse_line_blank_returns_zero()
    test_full_document()
    test_bad_lines_ignored()
    ce_summary("ingest_nt")
}

main()
