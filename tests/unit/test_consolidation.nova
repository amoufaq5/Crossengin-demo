// Unit tests for src/parts/episodic/consolidation.nova
// Verifies trace-signature canonicalization, recurrence tallying, candidate
// extraction at the stability threshold, and marking contributing episodes
// CONSOLIDATED. ADR-0022, ADR-0025 (stability gate).

import "../ce_test.nova"
import "../../src/parts/episodic/consolidation.nova"

// Build a moment with a given trace, and an episode referencing it.
fn record_with_trace(stream, em, trace, now) {
    let m = ms_capture(stream, now, MODALITY_TEXT, "x", 500, 0)
    let i = 0
    while i < len(trace) { moment_add_trace(m, trace[i]); i = i + 1 }
    em_record(em, moment_id(m), 500, now)
}

fn tr(a, b, c) { let l = list_new(); push(l, a); push(l, b); push(l, c); return l }

fn test_signature() {
    // Order-independent: {3,1,2} and {1,2,3} share a signature.
    ce_str_eq("sorted signature", consol_signature(tr(3, 1, 2)), "1,2,3")
    ce_str_eq("same set same sig", consol_signature(tr(2, 3, 1)), "1,2,3")
}

fn test_recurrence_and_candidates() {
    let stream = ms_new()
    let em = em_new()
    // Pattern {1,2,3} recurs 3 times; {9,..} once.
    record_with_trace(stream, em, tr(1, 2, 3), 0)
    record_with_trace(stream, em, tr(3, 2, 1), 1)
    record_with_trace(stream, em, tr(2, 1, 3), 2)
    record_with_trace(stream, em, tr(9, 8, 7), 3)

    let tally = consol_tally(em, stream)
    ce_eq("two distinct signatures", len(tally), 2)

    // At the stability threshold (3), only the recurring pattern qualifies.
    let cands = consol_scan(em, stream, CONSOLIDATE_MIN_RECUR)
    ce_eq("one candidate", len(cands), 1)
    ce_str_eq("candidate signature", cand_signature(cands[0]), "1,2,3")
    ce_eq("candidate count", cand_count(cands[0]), 3)

    // A higher threshold yields none.
    ce_eq("threshold 4 -> none", len(consol_scan(em, stream, 4)), 0)
}

fn test_mark_consolidated() {
    let stream = ms_new()
    let em = em_new()
    record_with_trace(stream, em, tr(1, 2, 3), 0)
    record_with_trace(stream, em, tr(1, 2, 3), 1)
    record_with_trace(stream, em, tr(1, 2, 3), 2)
    record_with_trace(stream, em, tr(5, 6, 7), 3)
    let cands = consol_scan(em, stream, CONSOLIDATE_MIN_RECUR)
    let marked = consol_mark(em, stream, cands)
    ce_eq("three episodes consolidated", marked, 3)
    ce_eq("matching episode consolidated", episode_tier(em_get(em, 0)), EP_CONSOLIDATED)
    ce_eq("non-matching episode untouched", episode_tier(em_get(em, 3)), EP_RECENT)
}

fn main() {
    test_signature()
    test_recurrence_and_candidates()
    test_mark_consolidated()
    ce_summary("consolidation")
}

main()
