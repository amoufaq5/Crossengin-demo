// Unit tests for src/federation/snapshot_broadcast_hook.nova (R5.1 /
// ADR-0111). Pure-logic subtests -- no sockets, no sandbox writes.
//
// Coverage:
//   test_hook_skips_empty_root        -- shape guard: zero / "".
//   test_hook_skips_none_sentinel     -- shape guard: SNAP_META_MERKLE_ROOT_NONE.
//   test_hook_rejects_malformed_hex   -- shape guard: short / non-hex.
//   test_hook_broadcasts_on_fresh_root -- happy path: att_store grows by 1.
//   test_hook_dedups_identical_root   -- replay: second call returns 0,
//                                        att_store size unchanged.
//   test_hook_broadcasts_on_new_root  -- att_store grows by 2 after two
//                                        distinct roots.
//
// Mirrors `tests/unit/test_snapshot_attestation.nova` fixture style.
//
// CrossEngin dependencies: src/federation/snapshot_broadcast_hook.nova,
// src/federation/snapshot_attestation.nova, src/federation/gossip.nova,
// src/safety/ed25519.nova, src/persistence/snapshot_writer.nova,
// src/util/str_safe.nova.

import "../ce_test.nova"
import "../../src/federation/snapshot_broadcast_hook.nova"
import "../../src/federation/snapshot_attestation.nova"
import "../../src/federation/gossip.nova"
import "../../src/safety/ed25519.nova"
import "../../src/persistence/snapshot_writer.nova"
import "../../src/util/str_safe.nova"

// RFC 8032 test-vector #1 seed (same as test_snapshot_attestation).
let _H_SK_HEX   = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
// Two distinct 32-byte roots in canonical lc-hex form.
let _H_ROOT_A   = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
let _H_ROOT_B   = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

fn _h_keypair_from_hex(sk_hex) {
    let seed = ed25519_hex_to_bytes(sk_hex)
    let parts = _ed_derive_a_and_prefix(seed)
    let pk = _ed_pk_from_a(parts[0])
    let r = list_new()
    push(r, seed)
    push(r, pk)
    return r
}

// A gossip state with zero peers. gossip_broadcast_attestation iterates
// gossip_alive_peers which returns [], so the broadcast returns 0 but
// the local att_store side-effect still happens -- exactly what we want
// to assert on.
fn _h_gs_empty() {
    return gossip_init("127.0.0.1:0", list_new())
}

// ---- shape guards --------------------------------------------------------

fn test_hook_skips_empty_root() {
    let kp = _h_keypair_from_hex(_H_SK_HEX)
    let gs = _h_gs_empty()
    let store = att_store_new()
    let rc = snapshot_broadcast_hook(gs, store, kp[0], kp[1], 42, "", 1700000000000000000)
    ce_eq("empty root -> 0", rc, 0)
    ce_eq("empty root leaves store empty", att_store_count(store), 0)
}

fn test_hook_skips_none_sentinel() {
    let kp = _h_keypair_from_hex(_H_SK_HEX)
    let gs = _h_gs_empty()
    let store = att_store_new()
    let rc = snapshot_broadcast_hook(gs, store, kp[0], kp[1], 42,
                                     SNAP_META_MERKLE_ROOT_NONE,
                                     1700000000000000000)
    ce_eq("sentinel root -> 0", rc, 0)
    ce_eq("sentinel leaves store empty", att_store_count(store), 0)
}

fn test_hook_rejects_malformed_hex() {
    let kp = _h_keypair_from_hex(_H_SK_HEX)
    let gs = _h_gs_empty()
    let store = att_store_new()
    // Too short.
    let rc1 = snapshot_broadcast_hook(gs, store, kp[0], kp[1], 42, "abcd",
                                      1700000000000000000)
    ce_eq("short-hex -> 0", rc1, 0)
    // Right length, non-hex char ('g').
    let bad64 = "g3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    let rc2 = snapshot_broadcast_hook(gs, store, kp[0], kp[1], 42, bad64,
                                      1700000000000000000)
    ce_eq("non-hex -> 0", rc2, 0)
    ce_eq("malformed hex leaves store empty", att_store_count(store), 0)
}

// ---- happy path ----------------------------------------------------------

fn test_hook_broadcasts_on_fresh_root() {
    let kp = _h_keypair_from_hex(_H_SK_HEX)
    let gs = _h_gs_empty()  // zero alive peers
    let store = att_store_new()
    let rc = snapshot_broadcast_hook(gs, store, kp[0], kp[1], 7, _H_ROOT_A,
                                     1700000000000000000)
    // No alive peers: broadcast delivery count is 0 by design.
    ce_eq("fresh root with 0 peers -> rc=0", rc, 0)
    // But the local store MUST have grown by one.
    ce_eq("fresh root grows store to 1", att_store_count(store), 1)
    let latest = att_store_latest(store, 7)
    ce_check("latest non-zero", latest != 0)
    ce_eq("latest root matches input",
          str_eq_bytes(att_root_hex(latest), _H_ROOT_A), 1)
    ce_eq("latest soul_id=7", att_soul_id(latest), 7)
    ce_eq("latest ts matches input", att_ts_ns(latest), 1700000000000000000)
}

// ---- dedup ---------------------------------------------------------------

fn test_hook_dedups_identical_root() {
    let kp = _h_keypair_from_hex(_H_SK_HEX)
    let gs = _h_gs_empty()
    let store = att_store_new()
    // First call: fresh root, inserts.
    snapshot_broadcast_hook(gs, store, kp[0], kp[1], 11, _H_ROOT_A,
                            1700000000000000000)
    ce_eq("after first call, store size=1", att_store_count(store), 1)
    // Second call with the SAME root (but a later ts) MUST short-circuit.
    let rc2 = snapshot_broadcast_hook(gs, store, kp[0], kp[1], 11, _H_ROOT_A,
                                      1700000001000000000)
    ce_eq("dedup hit returns 0", rc2, 0)
    ce_eq("store size unchanged after dedup", att_store_count(store), 1)
}

fn test_hook_broadcasts_on_new_root() {
    let kp = _h_keypair_from_hex(_H_SK_HEX)
    let gs = _h_gs_empty()
    let store = att_store_new()
    snapshot_broadcast_hook(gs, store, kp[0], kp[1], 13, _H_ROOT_A,
                            1700000000000000000)
    snapshot_broadcast_hook(gs, store, kp[0], kp[1], 13, _H_ROOT_B,
                            1700000001000000000)
    ce_eq("two distinct roots grow store to 2", att_store_count(store), 2)
    let latest = att_store_latest(store, 13)
    // att_store_latest returns the entry with the highest ts, which
    // is the B entry.
    ce_eq("latest after new root is root_B",
          str_eq_bytes(att_root_hex(latest), _H_ROOT_B), 1)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_hook_skips_empty_root()
    test_hook_skips_none_sentinel()
    test_hook_rejects_malformed_hex()
    test_hook_broadcasts_on_fresh_root()
    test_hook_dedups_identical_root()
    test_hook_broadcasts_on_new_root()
    ce_summary("test_snapshot_broadcast_hook")
}

main()
