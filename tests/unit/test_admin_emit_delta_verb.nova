// Unit tests for the admin.emit_delta wire verb (R102, Phase D part 3).
//
// The happy-path (signer keys loaded from env) is exercised by
// test_update_delta.nova end-to-end; wire tests here focus on the
// cap gate, arg validation, dispatch bookkeeping, and refusal shape.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/factory/child_mode.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_bare_ctx() {
    return rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
}

// ---- verb registration + count ----------------------------------------

fn test_verb_count_43() {
    ce_eq("verb count 43 (R102 added 2)",
          len(rpc_verb_names()), 43)
}

fn test_admin_emit_delta_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.emit_delta") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.emit_delta present", saw, 1)
}

// ---- capability wiring -------------------------------------------------

fn test_verb_requires_admin_emit_delta_cap() {
    let need = capability_verb_required("admin.emit_delta")
    ce_str_eq("emit_delta requires admin:emit-delta", need, CAP_ADMIN_EMIT_DELTA)
}

fn test_admin_role_carries_emit_delta_cap() {
    let caps = capability_role_expand("admin")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_EMIT_DELTA) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin role has admin:emit-delta", saw, 1)
}

fn test_reader_lacks_emit_delta_cap() {
    let caps = capability_role_expand("reader")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_EMIT_DELTA) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("reader lacks admin:emit-delta", saw, 0)
}

fn test_curator_lacks_emit_delta_cap() {
    let caps = capability_role_expand("curator")
    let saw = 0
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], CAP_ADMIN_EMIT_DELTA) == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("curator lacks admin:emit-delta", saw, 0)
}

fn test_emit_delta_cap_is_known() {
    ce_eq("admin:emit-delta is known cap",
          capability_is_known_cap(CAP_ADMIN_EMIT_DELTA), 1)
}

// ---- child-mode gate ---------------------------------------------------

fn test_refused_in_child_mode() {
    let ctx = _mk_bare_ctx()
    rpc_ctx_set_child_mode_bits(ctx, CHILD_MODE_ACTIVE)
    let out = rpc_dispatch("admin.emit_delta", list_new(), ctx)
    ce_check("ok:false",     _has(out, "\"ok\":false"))
    ce_check("child-mode",   _has(out, "child-mode runtime"))
    ce_check("names verb",   _has(out, "admin.emit_delta"))
}

fn test_disable_table_includes_emit_delta() {
    ce_eq("emit_delta in disable table",
          child_mode_verb_disabled("admin.emit_delta"), 1)
}

// ---- arg validation ----------------------------------------------------

fn test_missing_source_bundle_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("manifest_text",
        "BAKE-MANIFEST v1\nNAME t\nVERSION 1\nDOMAIN d\n"))
    push(args, rpc_arg_kv("since", "0"))
    let out = rpc_dispatch("admin.emit_delta", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions source_bundle",
        _has(out, "source_bundle_path") == 1
     || _has(out, "source_bundle_text") == 1)
}

fn test_missing_manifest_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("source_bundle_text", "any"))
    push(args, rpc_arg_kv("since", "0"))
    let out = rpc_dispatch("admin.emit_delta", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions manifest",
        _has(out, "manifest_text") == 1 || _has(out, "manifest_path") == 1)
}

fn test_missing_since_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("source_bundle_text", "x"))
    push(args, rpc_arg_kv("manifest_text",
        "BAKE-MANIFEST v1\nNAME t\nVERSION 1\nDOMAIN d\n"))
    let out = rpc_dispatch("admin.emit_delta", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    // Signer-keys or since guard fires first — either is acceptable
    // (both are pre-conditions and either shape is a valid refusal).
    ce_check("some refusal",
        _has(out, "since") == 1 || _has(out, "signer") == 1)
}

fn test_malformed_manifest_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("source_bundle_text", "x"))
    push(args, rpc_arg_kv("manifest_text", "not a valid manifest\n"))
    push(args, rpc_arg_kv("since", "0"))
    let out = rpc_dispatch("admin.emit_delta", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions parse", _has(out, "parse"))
}

fn test_missing_signer_keys_refused() {
    // With no CROSSENGIN_MOTHER_SIGNER_* env vars set (the test env),
    // a valid arg set still fails at the signer-load step.
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("source_bundle_text", "x"))
    push(args, rpc_arg_kv("manifest_text",
        "BAKE-MANIFEST v1\nNAME t\nVERSION 1\nDOMAIN d\n"))
    push(args, rpc_arg_kv("since", "0"))
    let out = rpc_dispatch("admin.emit_delta", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions signer",
        _has(out, "signer") == 1 || _has(out, "SIGNER") == 1)
}

fn test_source_path_unreadable_refused() {
    let ctx = _mk_bare_ctx()
    let args = list_new()
    push(args, rpc_arg_kv("source_bundle_path",
        "/nonexistent/absolute/nope.bundle"))
    push(args, rpc_arg_kv("manifest_text",
        "BAKE-MANIFEST v1\nNAME t\nVERSION 1\nDOMAIN d\n"))
    push(args, rpc_arg_kv("since", "0"))
    let out = rpc_dispatch("admin.emit_delta", args, ctx)
    ce_check("ok:false", _has(out, "\"ok\":false"))
    ce_check("mentions unreadable",
        _has(out, "unreadable") == 1 || _has(out, "empty") == 1)
}

fn test_dispatch_unknown_variant_refused() {
    let ctx = _mk_bare_ctx()
    let out = rpc_dispatch("admin.emit_deltas", list_new(), ctx)
    ce_check("unknown variant", _has(out, "unknown verb"))
}

fn main() {
    test_verb_count_43()
    test_admin_emit_delta_registered()
    test_verb_requires_admin_emit_delta_cap()
    test_admin_role_carries_emit_delta_cap()
    test_reader_lacks_emit_delta_cap()
    test_curator_lacks_emit_delta_cap()
    test_emit_delta_cap_is_known()
    test_refused_in_child_mode()
    test_disable_table_includes_emit_delta()
    test_missing_source_bundle_refused()
    test_missing_manifest_refused()
    test_missing_since_refused()
    test_malformed_manifest_refused()
    test_missing_signer_keys_refused()
    test_source_path_unreadable_refused()
    test_dispatch_unknown_variant_refused()
    ce_summary("admin_emit_delta_verb")
}

main()
