// Unit tests for src/persona/persona_project.nova (ADR-0102).
// The advise-only contract: projection returns factors but NEVER blocks.

import "../ce_test.nova"
import "../../src/persona/persona_project.nova"

fn test_project_no_persona_neutral() {
    let proj = persona_project(0, "install medicine capsule")
    ce_eq("valence 0", proj_valence_shift(proj), 0)
    ce_eq("arousal 0", proj_arousal_shift(proj), 0)
    ce_eq("risk 0", proj_risk_score(proj), 0)
    ce_eq("no similar", proj_similar_count(proj), 0)
    ce_eq("no pref match", proj_pref_match_count(proj), 0)
    ce_check("trace non-empty", len(proj_trace(proj)) >= 1)
}

fn test_project_empty_proposal_neutral() {
    let p = persona_new("u", "U", "", 100)
    let proj = persona_project(p, "")
    ce_eq("valence 0", proj_valence_shift(proj), 0)
    ce_eq("no similar", proj_similar_count(proj), 0)
    ce_check("trace mentions empty", len(proj_trace(proj)) >= 1)
}

fn test_project_cold_history_returns_zero_shift() {
    // Persona has no history + no preferences -> projection returns
    // 0 valence + risk-score-only from tolerance.
    let p = persona_new("u", "U", "", 100)
    let proj = persona_project(p, "install a new package")
    ce_eq("no similar", proj_similar_count(proj), 0)
    ce_eq("no pref match", proj_pref_match_count(proj), 0)
    ce_eq("valence shift 0", proj_valence_shift(proj), 0)
    // Risk still has a base = 1000 - tolerance(500) = 500.
    ce_eq("risk score = 500 (base from tolerance)", proj_risk_score(proj), 500)
}

fn test_project_with_similar_past_decision() {
    let p = persona_new("u", "U", "", 100)
    // Past decision: install medicine (positive outcome).
    let d = persona_add_decision(p, "install medicine capsule", "yes",
                                 600, "src:user:u", 200)
    persona_update_decision_outcome(p, d, 700, 900, 210)
    // New proposal shares the word "install" and "medicine".
    let proj = persona_project(p, "install medicine v2")
    ce_eq("1 similar decision", proj_similar_count(proj), 1)
    // Valence shift ~ actual outcome (700).
    ce_eq("valence shift ~ 700", proj_valence_shift(proj), 700)
    // Arousal shift = min(500, 700/2) = 350 (arousal cap logic).
    ce_check("arousal shift > 0", proj_arousal_shift(proj) > 0)
}

fn test_project_uses_predicted_when_no_actual() {
    let p = persona_new("u", "U", "", 100)
    // Decision with predicted valence but no actual outcome yet.
    persona_add_decision(p, "install medicine", "yes", 500, "src:user:u", 200)
    let proj = persona_project(p, "install medicine again")
    ce_eq("1 similar", proj_similar_count(proj), 1)
    ce_eq("valence uses predicted (500)", proj_valence_shift(proj), 500)
}

fn test_project_ignores_retracted_decisions() {
    let p = persona_new("u", "U", "", 100)
    let d = persona_add_decision(p, "install cursed_capsule", "yes",
                                 600, "src:user:u", 200)
    persona_retract_decision(p, d, 210)
    let proj = persona_project(p, "install cursed_capsule new_version")
    ce_eq("retracted excluded", proj_similar_count(proj), 0)
    ce_eq("valence 0 (no live similar)", proj_valence_shift(proj), 0)
}

fn test_project_matching_preferences_shift_valence() {
    let p = persona_new("u", "U", "", 100)
    persona_add_preference(p, "concise_answers", 700, "src:user:u", 200)
    let proj = persona_project(p, "give me a concise_answers summary")
    ce_eq("1 pref matched", proj_pref_match_count(proj), 1)
    // Pref valence weighted at half; matched pref weight 700 -> 350.
    ce_eq("valence shift = 350 (pref/2)", proj_valence_shift(proj), 350)
}

fn test_project_history_and_preferences_combine() {
    let p = persona_new("u", "U", "", 100)
    persona_add_preference(p, "concise", 800, "src:user:u", 100)
    let d = persona_add_decision(p, "produce concise summary", "yes",
                                 500, "src:user:u", 200)
    persona_update_decision_outcome(p, d, 600, 700, 210)
    let proj = persona_project(p, "produce concise report")
    // History similar: 1 with actual=600. Pref match: 1 with weight 800.
    // valence = 600 (history) + 400 (pref 800/2) = 1000 (clamped max).
    ce_eq("valence shift 1000", proj_valence_shift(proj), 1000)
    ce_eq("1 similar", proj_similar_count(proj), 1)
    ce_eq("1 pref match", proj_pref_match_count(proj), 1)
}

fn test_project_risk_score_reflects_tolerance() {
    // Cautious user (tolerance 200) -> higher risk base (800).
    let p1 = persona_new("cautious", "C", "", 100)
    persona_set_risk(p1, 200, 500, 500, 110)
    let proj1 = persona_project(p1, "run a simple query")
    ce_eq("cautious base 800", proj_risk_score(proj1), 800)
    // Adventurous user (tolerance 900) -> lower risk (100).
    let p2 = persona_new("bold", "B", "", 100)
    persona_set_risk(p2, 900, 500, 500, 110)
    let proj2 = persona_project(p2, "run a simple query")
    ce_eq("bold base 100", proj_risk_score(proj2), 100)
}

fn test_project_risk_bumped_by_destructive_words() {
    let p = persona_new("u", "U", "", 100)
    // Neutral tolerance 500 -> base 500.
    // Proposal with "delete" +100, "permanent" +100 = 700.
    let proj = persona_project(p, "delete the permanent audit log")
    ce_eq("risk = 500 + 100 + 100", proj_risk_score(proj), 700)
    // Irreversible bumps 200 -> 500 + 100 + 100 + 200 = 900.
    let proj2 = persona_project(p, "delete permanent irreversible thing")
    ce_eq("risk = 900", proj_risk_score(proj2), 900)
}

fn test_project_valence_clamped_within_range() {
    let p = persona_new("u", "U", "", 100)
    // Stack many high-valence decisions on the same topic to try to push
    // the aggregate past the +1000 clamp.
    let i = 0
    while i < 5 {
        let d = persona_add_decision(p, "install medicine", "yes",
                                     900, "src:user:u", 200 + i)
        persona_update_decision_outcome(p, d, 900, 900, 210 + i)
        i = i + 1
    }
    let proj = persona_project(p, "install medicine")
    // Average is 900; not exceeding 1000. Then add high pref.
    persona_add_preference(p, "medicine", 1000, "src:user:u", 300)
    let proj2 = persona_project(p, "install medicine")
    // history contributes 900; pref contributes 500 (weight/2) -> 1400 -> clamped 1000.
    ce_eq("valence clamped at 1000", proj_valence_shift(proj2), 1000)
}

fn test_project_never_blocks_returns_projection_always() {
    // Even for a heavily-negative proposal touching a strongly-disliked
    // preference on a cautious persona, the function returns a projection
    // -- it does not error, refuse, or return 0. Advise-only.
    let p = persona_new("u", "U", "", 100)
    persona_set_risk(p, 100, 900, 900, 110)   // very cautious
    persona_add_preference(p, "explosion", 0 - 900, "src:user:u", 120)
    let proj = persona_project(p, "trigger a permanent irreversible explosion delete")
    ce_check("projection returned (non-zero)", proj != 0)
    ce_check("valence shift is a number (may be negative)",
             proj_valence_shift(proj) >= (0 - 1000))
    ce_check("risk score bounded 0..1000", proj_risk_score(proj) >= 0)
    ce_check("risk score not > 1000", proj_risk_score(proj) <= 1000)
    // The projection includes reasoning trace for the user to inspect.
    ce_check("trace non-empty", len(proj_trace(proj)) >= 1)
}

fn test_project_trace_lists_reasoning_steps() {
    let p = persona_new("u", "U", "", 100)
    let proj = persona_project(p, "some proposal")
    let trace = proj_trace(proj)
    ce_check("at least 3 trace entries", len(trace) >= 3)
    // trace[0] mentions tokenization; last mentions risk.
    ce_check("first mentions tokens", len(trace[0]) > 0)
}

fn main() {
    test_project_no_persona_neutral()
    test_project_empty_proposal_neutral()
    test_project_cold_history_returns_zero_shift()
    test_project_with_similar_past_decision()
    test_project_uses_predicted_when_no_actual()
    test_project_ignores_retracted_decisions()
    test_project_matching_preferences_shift_valence()
    test_project_history_and_preferences_combine()
    test_project_risk_score_reflects_tolerance()
    test_project_risk_bumped_by_destructive_words()
    test_project_valence_clamped_within_range()
    test_project_never_blocks_returns_projection_always()
    test_project_trace_lists_reasoning_steps()
    ce_summary("persona_project")
}

main()
