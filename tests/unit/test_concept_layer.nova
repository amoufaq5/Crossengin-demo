// Unit tests for src/kg/concept_layer.nova
// Verifies concept promotion (coherent/incoherent/cross-domain), DAG linking
// with cycle prevention, schema slots (add/fill/ratio/gaps), and facet vectors.
// ADR-0018.

import "../ce_test.nova"
import "../../src/kg/concept_layer.nova"

fn v2(a, b) {
    let v = vec_new(ATOM_EMBED_DIMS)
    vec_set(v, 0, a); vec_set(v, 1, b)
    return v
}

fn mk(kg, label, e) {
    let a = atom_new(kg, 0, ATOM_FACT, label, 0)
    atom_set_embed(a, e)
    return a
}

fn test_promotion() {
    let layer = concept_layer_new()
    // Coherent cluster (similar embeddings) -> promoted.
    let cluster = list_new()
    push(cluster, mk("medicine", "aspirin", v2(100, 50)))
    push(cluster, mk("medicine", "ibuprofen", v2(95, 55)))
    let cid = concept_promote(layer, cluster)
    ce_check("coherent cluster promoted", cid >= 0)
    ce_eq("two members", len(concept_members(layer, cid)), 2)
    ce_eq("single domain span", len(concept_kg_span(layer, cid)), 1)
    ce_eq("not cross-domain", concept_is_cross_domain(layer, cid), 0)
    ce_eq("concept count", concept_count(layer), 1)

    // Incoherent cluster -> not promoted.
    let bad = list_new()
    push(bad, mk("medicine", "x", v2(100, 0)))
    push(bad, mk("medicine", "y", v2(0, 100)))
    ce_eq("incoherent not promoted", concept_promote(layer, bad), -1)
    ce_eq("empty not promoted", concept_promote(layer, list_new()), -1)
}

fn test_cross_domain() {
    let layer = concept_layer_new()
    let cluster = list_new()
    push(cluster, mk("medicine", "fever", v2(100, 50)))
    push(cluster, mk("folk", "fever", v2(100, 50)))   // similar across KGs
    let cid = concept_promote(layer, cluster)
    ce_check("promoted", cid >= 0)
    ce_eq("kg_span 2", len(concept_kg_span(layer, cid)), 2)
    ce_eq("cross-domain", concept_is_cross_domain(layer, cid), 1)
}

fn test_dag_links() {
    let layer = concept_layer_new()
    let c0 = concept_new(layer)
    let c1 = concept_new(layer)
    let c2 = concept_new(layer)
    ce_eq("link c0->c1", concept_link(layer, c0, c1), 1)
    ce_eq("link c1->c2", concept_link(layer, c1, c2), 1)
    ce_eq("self-link refused", concept_link(layer, c0, c0), 0)
    // c2 -> c0 would create a cycle (c0 ->* c2 already).
    ce_eq("cycle refused", concept_link(layer, c2, c0), 0)
    ce_eq("c0 has child c1", contains(concept_children(layer, c0), c1), 1)
    ce_eq("c1 has parent c0", contains(concept_parents(layer, c1), c0), 1)
    // Re-linking is idempotent.
    concept_link(layer, c0, c1)
    ce_eq("no duplicate child", len(concept_children(layer, c0)), 1)
}

fn test_slots() {
    let layer = concept_layer_new()
    let c = concept_new(layer)
    concept_add_slot(layer, c, "mechanism", 3)
    concept_add_slot(layer, c, "dose_range", 3)
    ce_eq("two slots", concept_slot_count(layer, c), 2)
    ce_eq("nothing filled -> ratio 0", concept_fill_ratio(layer, c), 0)
    ce_eq("two gaps", len(concept_gaps(layer, c)), 2)
    concept_fill_slot(layer, c, "mechanism", "COX inhibition")
    ce_eq("half filled -> 0.5", concept_fill_ratio(layer, c), 500)
    ce_eq("one gap left", len(concept_gaps(layer, c)), 1)
    ce_str_eq("slot value", concept_slot_value(layer, c, "mechanism"), "COX inhibition")
    ce_eq("fill unknown slot -> 0", concept_fill_slot(layer, c, "nope", "x"), 0)
    // Adding an existing slot does not duplicate.
    concept_add_slot(layer, c, "mechanism", 3)
    ce_eq("no duplicate slot", concept_slot_count(layer, c), 2)
}

fn test_facets() {
    let layer = concept_layer_new()
    let c1 = concept_new(layer)
    let c2 = concept_new(layer)
    ce_eq("missing facet sim 0", concept_facet_similarity(layer, c1, c2, VEC_LEXICAL), 0)
    concept_set_vector(layer, c1, VEC_LEXICAL, v2(100, 50))
    concept_set_vector(layer, c2, VEC_LEXICAL, v2(100, 50))
    ce_eq("identical lexical facet", concept_facet_similarity(layer, c1, c2, VEC_LEXICAL), 1000)
    concept_set_salience(layer, c1, 800)
    ce_eq("salience set", concept_salience(layer, c1), 800)
}

// ADR-0051: in HDC mode the semantic facet must be the bundle of the member
// hypervectors (D=10000), not the 8-dim arithmetic-mean centroid (a mean of
// +/-1 integer-divides to ~0 and destroys the vector). Mode is set + reset
// here so every other test in this file runs in the default LEGACY mode.
fn _ed(rel, nbr) {
    let p = list_new()
    push(p, rel); push(p, nbr)
    return p
}

fn _vehicle_edges() {
    let e = list_new()
    push(e, _ed("is_a", "vehicle"))
    push(e, _ed("has", "wheels"))
    push(e, _ed("has", "engine"))
    push(e, _ed("used_for", "transport"))
    push(e, _ed("needs", "fuel"))
    return e
}

fn test_hdc_promotion() {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let layer = concept_layer_new()
    // two atoms described by the same neighbourhood -> identical HDC embeds ->
    // perfectly coherent -> promoted.
    let a = atom_new("auto", 0, ATOM_CONCEPT, "car", 0)
    atom_set_embed(a, hdc_encode_atom("car", _vehicle_edges()))
    let b = atom_new("auto", 1, ATOM_CONCEPT, "automobile", 0)
    atom_set_embed(b, hdc_encode_atom("automobile", _vehicle_edges()))
    let cluster = list_new()
    push(cluster, a); push(cluster, b)
    let cid = concept_promote(layer, cluster)
    ce_check("hdc coherent cluster promoted", cid >= 0)
    if cid >= 0 {
        let facet = concept_get(layer, cid)[C_VECTORS][VEC_SEMANTIC]
        ce_eq("hdc facet is a D=10000 bundle (not the 8-dim mean)", len(facet), hdc_dims())
        ce_check("facet resembles member a", hdc_cosine(facet, atom_embed(a)) > 300)
        ce_check("facet resembles member b", hdc_cosine(facet, atom_embed(b)) > 300)
    }

    // ADR-0051 signed coherence path: a cluster of anti-correlated hypervectors
    // (one is the negation of the other) has hdc_cosine = -1000 between members.
    // The mode-aware coherence gate must see that NEGATIVE value (vec_cosine
    // would clamp it to 0) and refuse to promote. Either way it is < 700, so the
    // refusal is robust -- this asserts the signed path is wired without error.
    let p = atom_new("auto", 2, ATOM_CONCEPT, "pos", 0)
    atom_set_embed(p, hdc_symbol("anti_correlated_seed"))
    let q = atom_new("auto", 3, ATOM_CONCEPT, "neg", 0)
    atom_set_embed(q, _neg_hv(atom_embed(p)))
    ce_eq("members are anti-correlated (cos -1000)",
          hdc_cosine(atom_embed(p), atom_embed(q)), 0 - 1000)
    let anti = list_new()
    push(anti, p); push(anti, q)
    ce_eq("anti-correlated cluster not promoted (signed coherence < 700)",
          concept_promote(layer, anti), -1)
    atom_set_embed_mode(ATOM_EMBED_MODE_LEGACY)
}

// Element-wise negation of a bipolar hypervector (each +/-1 flips sign), giving
// the exact anti-pole used by the signed-coherence check above.
fn _neg_hv(v) {
    let out = list_new()
    let i = 0
    while i < len(v) {
        push(out, 0 - v[i])
        i = i + 1
    }
    return out
}

fn main() {
    test_promotion()
    test_cross_domain()
    test_dag_links()
    test_slots()
    test_facets()
    test_hdc_promotion()
    ce_summary("concept_layer")
}

main()
