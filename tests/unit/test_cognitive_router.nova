// Unit tests for src/agent/cognitive_router.nova (ADR-0055).
// Builds a tiny reasoning KG (morning->breakfast->energy->work) + a lang KG,
// then checks that each category routes to its own strategy and that the
// /good//bad feedback path re-weights the operators a reply leaned on.

import "../ce_test.nova"
import "../../src/agent/cognitive_router.nova"

// morning(0) -> breakfast(1) -> energy(2) -> work(3), all causal.
fn build_kg() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    kg_add_atom(rkg, ATOM_CONCEPT, "morning", 0)     // 0
    kg_add_atom(rkg, ATOM_CONCEPT, "breakfast", 0)   // 1
    kg_add_atom(rkg, ATOM_CONCEPT, "energy", 0)      // 2
    kg_add_atom(rkg, ATOM_CONCEPT, "work", 0)        // 3
    rop_new(rkg, ROP_CAUSAL, 0, 1, "morning->breakfast", 0)
    rop_new(rkg, ROP_CAUSAL, 1, 2, "breakfast->energy", 0)
    rop_new(rkg, ROP_CAUSAL, 2, 3, "energy->work", 0)
    return rkg
}

fn build_lang() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_intern(lang, "morning", 0)
    return lang
}

// percept entry shape mirrors the chat: [_, concept_id].
fn percept_of(cid) {
    let p = list_new()
    let e = list_new() push(e, "tok") push(e, cid)
    push(p, e)
    return p
}

fn _has(hay, needle) {
    if str_find(hay, needle) >= 0 { return 1 }
    return 0
}

fn test_academic_forward_chain() {
    let kg = build_kg()
    let lang = build_lang()
    let r = router_reply(CAT_ACADEMIC, "why morning", kg, lang, percept_of(0), 0)
    ce_check("academic reaches work", _has(rr_reply(r), "work") == 1)
    ce_check("academic shows chain",  _has(rr_trace(r), "morning->breakfast->energy->work") == 1)
    ce_check("academic records ops",  len(rr_ops(r)) > 0)
}

fn test_categories_differ() {
    let kg = build_kg()
    let lang = build_lang()
    let empty_p = list_new()

    let g = router_reply(CAT_GREETING, "hello", kg, lang, empty_p, 0)
    ce_check("greeting is warm", _has(rr_reply(g), "hello") == 1)

    let p = router_reply(CAT_PERSONAL, "i feel sad", kg, lang, empty_p, 0)
    ce_check("personal is empathic", _has(rr_reply(p), "sorry") == 1)
    ce_check("personal names feeling", _has(rr_reply(p), "sad") == 1)

    let a = router_reply(CAT_ARITHMETIC, "2 + 2", kg, lang, empty_p, 0)
    ce_check("arithmetic computes", _has(rr_reply(a), "4") == 1)

    let d = router_reply(CAT_DEBATABLE, "cats or dogs", kg, lang, empty_p, 0)
    ce_check("debatable hedges", _has(rr_reply(d), "judgement") == 1)
    ce_check("debatable names options", _has(rr_reply(d), "cats") == 1)

    let s = router_reply(CAT_SOCIAL, "how are you", kg, lang, empty_p, 0)
    ce_check("social smalltalk", _has(rr_reply(s), "how are you") == 1)
}

fn test_unknown_skips_stopwords() {
    let kg = build_kg()
    let lang = build_lang()
    // "the sky is blue" -> first content unknown is "sky", NOT "the".
    let r = router_reply(CAT_FACTUAL, "the sky is blue", kg, lang, list_new(), 0)
    ce_check("skips stopword 'the'", _has(rr_reply(r), "'sky'") == 1)
    ce_check("does not pick 'the'",  _has(rr_reply(r), "'the'") == 0)
}

fn test_feedback_reweights() {
    let kg = build_kg()
    let lang = build_lang()
    let r = router_reply(CAT_ACADEMIC, "why morning", kg, lang, percept_of(0), 0)
    let ops = rr_ops(r)
    // Reinforce, then weaken -- both should report a non-zero adjusted count.
    ce_check("feedback +1 adjusts", router_apply_feedback(kg, ops, 1) > 0)
    ce_check("feedback -1 adjusts", router_apply_feedback(kg, ops, 0 - 1) > 0)
    ce_eq("empty ops adjusts none", router_apply_feedback(kg, "", 1), 0)
}

// R48: the content-unknown check recognises a learned compound bigram.
fn test_bigram_aware_unknown() {
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    word_intern(lang, "lung_cancer", 0)
    ce_str_eq("known compound is not a gap", _cr_first_content_unknown(lang, "lung cancer"), "")
    ce_str_eq("unknown compound flags first word", _cr_first_content_unknown(lang, "lung disease"), "lung")
}

// R60: a known word with a dictionary gloss but no reasoning chain answers
// "X means: <gloss>" instead of a knowledge gap.
fn test_dictionary_gloss() {
    let kg = build_kg()
    let reg = kg_registry_new()
    let lang = lang_kg_init(reg)
    let w = word_intern(lang, "serendipity", 0)
    word_set_gloss(w, "a happy accident")
    // Known word, empty percept (no chain) -> surface the gloss.
    let r = router_reply(CAT_ACADEMIC, "what is serendipity", kg, lang, list_new(), 0)
    ce_check("academic surfaces the gloss", _has(rr_reply(r), "means: a happy accident") == 1)
    ce_check("gloss trace recorded", _has(rr_trace(r), "dictionary gloss") == 1)
    // The unknown catch-all path surfaces it too (stopword "about" + the word).
    let u = router_reply(CAT_UNKNOWN, "about serendipity", kg, lang, list_new(), 0)
    ce_check("unknown path surfaces the gloss", _has(rr_reply(u), "means: a happy accident") == 1)
    // A known word WITHOUT a gloss does not produce a "means:" reply.
    word_intern(lang, "plain", 0)
    let r2 = router_reply(CAT_ACADEMIC, "what is plain", kg, lang, list_new(), 0)
    ce_check("no gloss -> no means reply", _has(rr_reply(r2), "means:") == 0)
}

// R66/R67: a synonym (analogy) edge is PREFERRED ("X is like Y"); the antonym
// (opposite) edge present alongside it is not surfaced.
fn test_analogy_synonym() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)
    kg_add_atom(rkg, ATOM_CONCEPT, "decision", 0)   // 0
    kg_add_atom(rkg, ATOM_CONCEPT, "choice", 0)     // 1
    kg_add_atom(rkg, ATOM_CONCEPT, "indecision", 0) // 2
    rop_new(rkg, ROP_ANALOGY, 0, 1, "src:dict:decision:syn->choice", 0)
    rop_new(rkg, ROP_OPPOSITE, 0, 2, "src:dict:decision:ant->indecision", 0)
    word_intern(lang, "decision", 0)
    let r = router_reply(CAT_ACADEMIC, "what is decision", rkg, lang, percept_of(0), 0)
    ce_check("surfaces synonym analogy", _has(rr_reply(r), "decision is like choice") == 1)
    ce_check("analogy trace", _has(rr_trace(r), "analogy (synonym)") == 1)
    ce_check("does not surface the antonym", _has(rr_reply(r), "indecision") == 0)
    ce_check("records the analogy op", len(rr_ops(r)) > 0)
}

// R67: an antonym OPPOSITE edge surfaces as "X is the opposite of Y" when there
// is no synonym to prefer.
fn test_opposite_antonym() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)
    kg_add_atom(rkg, ATOM_CONCEPT, "happy", 0)    // 0
    kg_add_atom(rkg, ATOM_CONCEPT, "sad", 0)      // 1
    rop_new(rkg, ROP_OPPOSITE, 0, 1, "src:dict:happy:ant->sad", 0)
    word_intern(lang, "happy", 0)
    let r = router_reply(CAT_ACADEMIC, "what is happy", rkg, lang, percept_of(0), 0)
    ce_check("surfaces antonym opposite", _has(rr_reply(r), "happy is the opposite of sad") == 1)
    ce_check("opposite trace", _has(rr_trace(r), "opposite (antonym)") == 1)
    ce_check("records the opposite op", len(rr_ops(r)) > 0)
    // The kind name is first-class.
    ce_str_eq("ROP_OPPOSITE name", rop_kind_name(ROP_OPPOSITE), "oppositional")
}

// R71: the forward-chain weights edge confidence by source authority, so it
// prefers an authoritative-source edge over an equal-confidence low-authority one.
fn test_source_weighted_chain() {
    ce_eq("wikipedia weight", _cr_src_weight("src:url:en.wikipedia.org:a-causes-b"), 1000)
    ce_eq("dictionary weight", _cr_src_weight("src:dict:happy:a-b-c"), 850)
    ce_eq("seed/curated weight (no src)", _cr_src_weight("alpha->cheap"), 1000)

    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)
    kg_add_atom(rkg, ATOM_CONCEPT, "alpha", 0)    // 0
    kg_add_atom(rkg, ATOM_CONCEPT, "cheap", 0)    // 1
    kg_add_atom(rkg, ATOM_CONCEPT, "trusted", 0)  // 2
    // Both edges equal (default) confidence; cheap is FIRST (so a confidence-only
    // pick takes it), from a low-authority dictionary source; trusted is from
    // Wikipedia. Source authority must break the tie toward Wikipedia.
    rop_new(rkg, ROP_CAUSAL, 0, 1, "src:dict:alpha:alpha-causes-cheap", 0)
    rop_new(rkg, ROP_CAUSAL, 0, 2, "src:url:en.wikipedia.org:alpha-causes-trusted", 0)
    word_intern(lang, "alpha", 0)
    let r = router_reply(CAT_ACADEMIC, "what is alpha", rkg, lang, percept_of(0), 0)
    ce_check("prefers the authoritative (wikipedia) edge", _has(rr_reply(r), "trusted") == 1)
    ce_check("does not take the low-authority edge", _has(rr_reply(r), "cheap") == 0)
}

// R72: a forward-chain answer is opposite-aware -- if the subject has an antonym,
// the reply contrasts ("..., as opposed to Y").
fn test_opposite_aware_contrast() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    let lang = lang_kg_init(reg)
    kg_add_atom(rkg, ATOM_CONCEPT, "happy", 0)   // 0
    kg_add_atom(rkg, ATOM_CONCEPT, "joy", 0)     // 1
    kg_add_atom(rkg, ATOM_CONCEPT, "sad", 0)     // 2
    rop_new(rkg, ROP_CAUSAL, 0, 1, "happy->joy", 0)
    rop_new(rkg, ROP_OPPOSITE, 0, 2, "src:dict:happy:ant->sad", 0)
    word_intern(lang, "happy", 0)
    let r = router_reply(CAT_ACADEMIC, "what is happy", rkg, lang, percept_of(0), 0)
    ce_check("still forward-chains", _has(rr_reply(r), "happy leads to joy") == 1)
    ce_check("contrasts with the opposite", _has(rr_reply(r), "as opposed to sad") == 1)
    ce_check("contrast recorded in trace", _has(rr_trace(r), "(vs sad)") == 1)
    // No antonym -> no contrast clause.
    let reg2 = kg_registry_new()
    let rkg2 = reasoning_kg_init(reg2)
    let lang2 = lang_kg_init(reg2)
    kg_add_atom(rkg2, ATOM_CONCEPT, "happy", 0)
    kg_add_atom(rkg2, ATOM_CONCEPT, "joy", 0)
    rop_new(rkg2, ROP_CAUSAL, 0, 1, "happy->joy", 0)
    word_intern(lang2, "happy", 0)
    let r2 = router_reply(CAT_ACADEMIC, "what is happy", rkg2, lang2, percept_of(0), 0)
    ce_check("no antonym -> no contrast", _has(rr_reply(r2), "as opposed to") == 0)
}

fn main() {
    test_academic_forward_chain()
    test_categories_differ()
    test_unknown_skips_stopwords()
    test_feedback_reweights()
    test_bigram_aware_unknown()
    test_dictionary_gloss()
    test_analogy_synonym()
    test_opposite_antonym()
    test_source_weighted_chain()
    test_opposite_aware_contrast()
    ce_summary("cognitive_router")
}

main()
