// Unit tests for src/net/tls/tls_keyshare.nova (R89 x25519 TLS glue).
//
// Coverage
//   * tls_keyshare_x25519_public produces the RFC 7748 §6.1 Alice/Bob
//     public keys from their respective secret scalars (also exercised
//     via test_x25519, but replicated here so the TLS-facing wrapper
//     itself is pinned).
//   * tls_keyshare_x25519_shared computes the RFC 7748 §6.1 shared
//     secret in both directions and returns ok=1.
//   * All-zero secret rejection: u=0 (a low-order point) returns ok=0
//     from tls_keyshare_x25519_shared and produces a zeroed output.
//   * tls_keyshare_derive_handshake_secret is well-shaped: returns a
//     [buf, 32] pair, buf is not the zero buffer, and re-running the
//     same computation is deterministic.
//   * The keyshare-length constants match RFC 7748 (32 for scalar /
//     public / shared).
//
// References
//   RFC 7748 §6.1 -- X25519 DH example.
//   RFC 8446 §7.1 -- TLS 1.3 key schedule, handshake_secret step.
//
// NOVA dependencies: ce_test harness, tls_keyshare, x25519, field25519.

import "../ce_test.nova"
import "../../src/safety/field25519.nova"
import "../../src/safety/x25519.nova"
import "../../src/net/tls/tls_keyshare.nova"

// ---- helpers --------------------------------------------------------------

fn _tks_nibble_hex(n) {
    if n < 10 { return 48 + n }
    return 87 + n
}
fn _tks_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        s = s + chr(_tks_nibble_hex(int_and(int_shr(b, 4), 15)))
        s = s + chr(_tks_nibble_hex(int_and(b, 15)))
        i = i + 1
    }
    return s
}
fn _tks_hex_nibble(c) {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    return 0 - 1
}
fn _tks_hex_to_buf(hex) {
    let n = len(hex)
    let half = int_shr(n, 1)
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _tks_hex_nibble(char_at(hex, i * 2))
        let lo = _tks_hex_nibble(char_at(hex, i * 2 + 1))
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    return buf
}
fn _tks_bufs_eq(a, na, b, nb) {
    if na != nb { return 0 }
    let i = 0
    while i < na {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---- constants -----------------------------------------------------------

fn test_constants() {
    ce_eq("TLS_X25519_SCALAR_LEN = 32", TLS_X25519_SCALAR_LEN, 32)
    ce_eq("TLS_X25519_PUBLIC_LEN = 32", TLS_X25519_PUBLIC_LEN, 32)
    ce_eq("TLS_X25519_SHARED_LEN = 32", TLS_X25519_SHARED_LEN, 32)
}

// ---- pubkey generation ---------------------------------------------------

fn test_public_alice() {
    let sk = _tks_hex_to_buf(
        "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let pk = alloc(32)
    tls_keyshare_x25519_public(pk, sk)
    ce_str_eq("Alice pk (RFC 7748 §6.1)",
              _tks_hex_encode_buf(pk, 32),
              "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a")
}

fn test_public_bob() {
    let sk = _tks_hex_to_buf(
        "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
    let pk = alloc(32)
    tls_keyshare_x25519_public(pk, sk)
    ce_str_eq("Bob pk (RFC 7748 §6.1)",
              _tks_hex_encode_buf(pk, 32),
              "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")
}

// ---- shared secret -------------------------------------------------------

fn test_shared_both_directions() {
    let alice_sk = _tks_hex_to_buf(
        "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let bob_sk   = _tks_hex_to_buf(
        "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
    let alice_pk = alloc(32); tls_keyshare_x25519_public(alice_pk, alice_sk)
    let bob_pk   = alloc(32); tls_keyshare_x25519_public(bob_pk,   bob_sk)
    let expected = "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"
    let s_ab = alloc(32)
    let ok_ab = tls_keyshare_x25519_shared(s_ab, alice_sk, bob_pk)
    ce_eq("alice*bob keyshare ok=1", ok_ab, 1)
    ce_str_eq("alice*bob shared secret", _tks_hex_encode_buf(s_ab, 32), expected)
    let s_ba = alloc(32)
    let ok_ba = tls_keyshare_x25519_shared(s_ba, bob_sk, alice_pk)
    ce_eq("bob*alice keyshare ok=1", ok_ba, 1)
    ce_str_eq("bob*alice shared secret", _tks_hex_encode_buf(s_ba, 32), expected)
}

// ---- all-zero rejection --------------------------------------------------

fn test_reject_low_order_u_zero() {
    // Peer public = 0 (low-order point). Shared secret would be zero;
    // must be rejected per RFC 7748 §6.1.
    let sk = _tks_hex_to_buf(
        "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let peer = alloc(32)
    let i = 0; while i < 32 { store8(peer + i, 0); i = i + 1 }
    let out = alloc(32)
    let ok = tls_keyshare_x25519_shared(out, sk, peer)
    ce_eq("shared secret with peer=0 rejected", ok, 0)
}

// ---- handshake-secret derivation ----------------------------------------

fn test_derive_handshake_secret_shape() {
    // No RFC vector is a byte-exact reference for the combined
    // (Derive-Secret(early, "derived", "") -> HKDF-Extract) step with
    // an arbitrary shared secret, but we can verify the shape and
    // determinism, and that the value depends on inputs.
    let shared = _tks_hex_to_buf(
        "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    let early = alloc(33)
    let i = 0; while i < 33 { store8(early + i, 0); i = i + 1 }
    // Use an actual early_secret from a zero-PSK path:
    //   early_secret = HKDF-Extract(0, 0) with hkdf-imported semantics
    //   -> a specific 32-byte value.
    // Here we just supply an arbitrary 32-byte early_secret (all zeros);
    // determinism + shape is what we're pinning.
    let hs1 = tls_keyshare_derive_handshake_secret(shared, 32, early, 32)
    ce_eq("handshake_secret is 32 bytes", hs1[1], 32)
    // Not the all-zero buffer.
    let acc = 0
    let j = 0
    while j < 32 { acc = int_or(acc, load8(hs1[0] + j)); j = j + 1 }
    ce_check("handshake_secret is non-zero", acc != 0)
    // Deterministic: recompute with identical inputs.
    let hs2 = tls_keyshare_derive_handshake_secret(shared, 32, early, 32)
    ce_eq("handshake_secret is deterministic",
          _tks_bufs_eq(hs1[0], 32, hs2[0], 32), 1)
    // Sensitive to shared input: flip one bit -> different result.
    let shared_mod = alloc(33)
    let k = 0; while k < 32 { store8(shared_mod + k, load8(shared + k)); k = k + 1 }
    store8(shared_mod + 0, int_xor(load8(shared_mod + 0), 1))
    let hs3 = tls_keyshare_derive_handshake_secret(shared_mod, 32, early, 32)
    ce_check("handshake_secret depends on shared",
             _tks_bufs_eq(hs1[0], 32, hs3[0], 32) == 0)
}

// ---- run ------------------------------------------------------------------

fn main() {
    test_constants()
    test_public_alice()
    test_public_bob()
    test_shared_both_directions()
    test_reject_low_order_u_zero()
    test_derive_handshake_secret_shape()
    ce_summary("tls_keyshare")
}

main()
