// Unit tests for src/agent/ingestion_agent.nova.

import "../ce_test.nova"
import "../../src/agent/ingestion_agent.nova"

// Write a temp .cerec text file and return its path.
fn _write_temp(name, content) {
    let path = "/tmp/_ing_" + name
    write_file(path, content)
    return path
}

fn test_agent_new_defaults() {
    let a = ing_agent_new()
    ce_check("kgreg attached", ing_kgreg(a) != 0)
    ce_check("mo attached", ing_mo(a) != 0)
    ce_check("sources catalogue installed", len(ing_sources(a)) >= 8)
    ce_eq("queue empty", rq_size(ing_queue(a)), 0)
    let trusted = ing_agent_trusted_prefixes(a)
    ce_check("has pack prefix", len(trusted) >= 3)
}

fn test_trust_prefix_add_idempotent() {
    let a = ing_agent_new()
    let n_before = len(ing_agent_trusted_prefixes(a))
    ing_agent_trust_prefix(a, "src:wikidata:")
    ce_eq("added one", len(ing_agent_trusted_prefixes(a)), n_before + 1)
    ing_agent_trust_prefix(a, "src:wikidata:")
    ce_eq("still one added", len(ing_agent_trusted_prefixes(a)), n_before + 1)
}

fn test_dispatch_unknown_format() {
    let a = ing_agent_new()
    let s = ing_agent_run(a, "not-a-real-format", "/nowhere", "k", "src:x", "", 0)
    ce_eq("no ok", ing_sum_ok(s), 0)
    ce_check("errors >= 1", ing_sum_errors(s) >= 1)
}

fn test_cerec_trusted_ingests_directly() {
    let a = ing_agent_new()
    let path = _write_temp("cerec_ok.cerec",
        "KG demo\nSRC src:cerec:manual\nATOM alpha 1 800\nATOM beta 1 700\nIMP alpha beta EMPIRICAL\n")
    let s = ing_agent_run(a, "cerec", path, "demo", "src:cerec:manual", "", 0)
    ce_eq("one ok record", ing_sum_ok(s), 1)
    ce_eq("no queued", ing_sum_queued(s), 0)
    ce_eq("2 atoms added", ing_sum_atoms(s), 2)
    ce_eq("queue empty", rq_size(ing_queue(a)), 0)
    ce_eq("kgreg has one kg", kg_count(ing_kgreg(a)), 1)
}

fn test_cerec_untrusted_queues() {
    let a = ing_agent_new()
    let path = _write_temp("cerec_untrusted.cerec",
        "KG demo\nSRC src:web:notepad\nATOM foo 1 800\n")
    let s = ing_agent_run(a, "cerec", path, "demo", "src:web:notepad", "", 0)
    ce_eq("no ok record", ing_sum_ok(s), 0)
    ce_eq("one queued", ing_sum_queued(s), 1)
    ce_eq("queue holds one", rq_size(ing_queue(a)), 1)
    ce_eq("kgreg empty", kg_count(ing_kgreg(a)), 0)
}

fn test_llm_extracted_always_queues() {
    let a = ing_agent_new()
    // src:cerec: prefix is trusted, but the LLM format forces queue anyway.
    let path = _write_temp("llm.cerec",
        "KG demo\nSRC src:cerec:manual\nATOM foo 1 800\n")
    let s = ing_agent_run(a, "llm", path, "demo", "src:extractor:llm:opus5:run1", "", 0)
    ce_eq("queued not ingested", ing_sum_queued(s), 1)
    ce_eq("no direct ingest", ing_sum_ok(s), 0)
}

fn test_csv_queues_untrusted() {
    let a = ing_agent_new()
    let path = _write_temp("data.csv", "name,species\nalice,dog\nbob,cat\n")
    let s = ing_agent_run(a, "csv", path, "animals", "src:csv:pets", "", 0)
    ce_eq("one queued", ing_sum_queued(s), 1)
    ce_eq("queue holds one", rq_size(ing_queue(a)), 1)
    // The queued entry has 4 atoms (alice, dog, bob, cat).
    let e = rq_entries(ing_queue(a))[0]
    ce_eq("record has 4 atoms", len(cur_atoms(rq_record(e))), 4)
}

fn test_csv_trusted_ingests() {
    let a = ing_agent_new()
    ing_agent_trust_prefix(a, "src:csv:")
    let path = _write_temp("data.csv", "name,species\nalice,dog\nbob,cat\n")
    let s = ing_agent_run(a, "csv", path, "animals", "src:csv:pets", "", 0)
    ce_eq("one ok", ing_sum_ok(s), 1)
    ce_eq("0 queued", ing_sum_queued(s), 0)
    ce_eq("4 atoms", ing_sum_atoms(s), 4)
}

fn test_nt_queues() {
    let a = ing_agent_new()
    let path = _write_temp("t.nt",
        "<http://ex/Cat> <http://ex/isA> <http://ex/Animal> .\n")
    let s = ing_agent_run(a, "ntriples", path, "bio", "src:nt:test", "", 0)
    ce_eq("one queued", ing_sum_queued(s), 1)
}

fn test_meta_observer_attributes_on_ingest() {
    let a = ing_agent_new()
    let path = _write_temp("attr.cerec",
        "KG demo\nSRC src:cerec:attrtest\nATOM a 1 800\nATOM b 1 800\n")
    ing_agent_run(a, "cerec", path, "demo", "src:cerec:attrtest", "", 0)
    let report = mo_report(ing_mo(a))
    let found = 0
    let i = 0
    while i < len(report) {
        if str_eq_bytes(report[i][0], "src:cerec:attrtest") == 1 { found = 1 }
        i = i + 1
    }
    ce_eq("source attributed in mo", found, 1)
}

fn main() {
    test_agent_new_defaults()
    test_trust_prefix_add_idempotent()
    test_dispatch_unknown_format()
    test_cerec_trusted_ingests_directly()
    test_cerec_untrusted_queues()
    test_llm_extracted_always_queues()
    test_csv_queues_untrusted()
    test_csv_trusted_ingests()
    test_nt_queues()
    test_meta_observer_attributes_on_ingest()
    ce_summary("ingestion_agent")
}

main()
