// Unit tests for src/bench/calibration.nova: Brier score, ECE, accuracy. The
// key property is that ECE isolates CALIBRATION from accuracy -- an honestly
// uncertain engine scores ECE ~0 even at 50% accuracy.

import "../ce_test.nova"
import "../../src/bench/calibration.nova"

fn _samples(items) { return items }

// Perfect predictions: high confidence on true, low on false -> Brier near 0,
// accuracy 1000.
fn test_perfect() {
    let s = list_new()
    push(s, cal_sample(1000, 1)) push(s, cal_sample(1000, 1))
    push(s, cal_sample(0, 0))    push(s, cal_sample(0, 0))
    ce_eq("perfect Brier 0", cal_brier(s), 0)
    ce_eq("perfect ECE 0", cal_ece(s), 0)
    ce_eq("perfect accuracy 1000", cal_accuracy(s), 1000)
}

// Maximally overconfident + wrong: conf 1000 but outcome 0 -> Brier 1000 (1.0),
// accuracy 0, ECE 1000 (the bin predicts 1.0, actual 0.0).
fn test_overconfident_wrong() {
    let s = list_new()
    push(s, cal_sample(1000, 0)) push(s, cal_sample(1000, 0))
    ce_eq("overconfident Brier 1000", cal_brier(s), 1000)
    ce_eq("overconfident accuracy 0", cal_accuracy(s), 0)
    ce_eq("overconfident ECE 1000", cal_ece(s), 1000)
}

// THE distinguishing case: honestly uncertain. Two 0.5 predictions, one true one
// false. Accuracy is only 50%, BUT the engine is perfectly CALIBRATED -- a 0.5
// claim is right half the time -> ECE 0. Brier is 0.25 (the irreducible cost of
// genuine uncertainty), not a calibration failure.
fn test_honest_uncertainty_is_calibrated() {
    let s = list_new()
    push(s, cal_sample(500, 1)) push(s, cal_sample(500, 0))
    ce_eq("uncertain Brier 250", cal_brier(s), 250)   // (0.5)^2 = 0.25
    ce_eq("uncertain ECE 0 (calibrated!)", cal_ece(s), 0)
    // accuracy at the 0.5 threshold: conf 500 >= 500 predicts true; one hit.
    ce_eq("uncertain accuracy 500", cal_accuracy(s), 500)
}

// A single mid prediction: Brier reflects the squared error exactly.
fn test_brier_value() {
    // conf 700 on a TRUE outcome: err = 700-1000 = -300; (0.3)^2 = 0.09 -> 90.
    let s = list_new() push(s, cal_sample(700, 1))
    ce_eq("Brier 90 for 0.7-on-true", cal_brier(s), 90)
    // conf 700 on a FALSE outcome: err = 700; (0.7)^2 = 0.49 -> 490.
    let s2 = list_new() push(s2, cal_sample(700, 0))
    ce_eq("Brier 490 for 0.7-on-false", cal_brier(s2), 490)
}

// ECE catches systematic overconfidence across bins: predictions of 0.9 that are
// only right 50% of the time -> a ~0.4 gap.
fn test_ece_catches_overconfidence() {
    let s = list_new()
    // four 0.9 predictions, two true two false -> bin-9 mean_pred 900, actual 500.
    push(s, cal_sample(900, 1)) push(s, cal_sample(900, 1))
    push(s, cal_sample(900, 0)) push(s, cal_sample(900, 0))
    ce_eq("ECE ~400 for overconfident bin", cal_ece(s), 400)
}

// Empty input is safe.
fn test_empty() {
    let s = list_new()
    ce_eq("empty Brier 0", cal_brier(s), 0)
    ce_eq("empty ECE 0", cal_ece(s), 0)
    ce_eq("empty accuracy 0", cal_accuracy(s), 0)
}

// cal_from_atoms reads each atom's current belief as the prediction.
fn test_from_atoms() {
    // a corroborated atom (many positives -> high conf) with a TRUE outcome,
    // and a refuted atom (negatives -> low conf) with a FALSE outcome: well
    // calibrated.
    let a = atom_new(0, 1, ATOM_CONCEPT, "hi", 0)
    let i = 0
    while i < 30 { atom_observe(a, 1) i = i + 1 }
    let b = atom_new(0, 2, ATOM_CONCEPT, "lo", 0)
    let j = 0
    while j < 30 { atom_observe(b, 0 - 1) j = j + 1 }
    let pairs = list_new()
    let p1 = list_new() push(p1, a) push(p1, 1) push(pairs, p1)
    let p2 = list_new() push(p2, b) push(p2, 0) push(pairs, p2)
    let s = cal_from_atoms(pairs)
    ce_eq("two samples from atoms", len(s), 2)
    ce_check("well-calibrated atoms: low Brier", cal_brier(s) < 100)
    ce_check("report non-empty", len(cal_render(s)) > 0)
}

fn main() {
    test_perfect()
    test_overconfident_wrong()
    test_honest_uncertainty_is_calibrated()
    test_brier_value()
    test_ece_catches_overconfidence()
    test_empty()
    test_from_atoms()
    ce_summary("calibration")
}

main()
