// Unit tests for the TLS 1.3 key schedule in src/io/transducers/tls13_client.nova,
// pinned to the RFC 8448 "Simple 1-RTT Handshake" reference trace. The key
// schedule is the part of TLS that fails silently, so it is validated against
// known vectors before any socket opens. (RFC 8448 uses AES-128-GCM, but the
// secret ladder + HKDF-Expand-Label are SHA-256 and cipher-independent, so the
// secrets/iv match exactly and the key is checked at the RFC's 16-byte length.)

import "../ce_test.nova"
import "../../src/io/transducers/tls13_client.nova"

fn _hxv(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70  { return c - 55 } }
    return 0
}

// Parse a spaced hex string -> [buf, n].
fn hexbuf(s) {
    let digits = 0
    let i = 0
    while i < len(s) {
        if char_at(s, i) != 32 { digits = digits + 1 }
        i = i + 1
    }
    let n = digits / 2
    let buf = alloc(n + 1)
    let bi = 0
    let hi = 0 - 1
    i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c != 32 {
            let v = _hxv(c)
            if hi < 0 { hi = v }
            else { store8(buf + bi, hi * 16 + v) bi = bi + 1 hi = 0 - 1 }
        }
        i = i + 1
    }
    let r = list_new() push(r, buf) push(r, n)
    return r
}

fn eqhex(label, got, gotn, hexstr) {
    let h = hexbuf(hexstr)
    ce_eq(label + " len", gotn, h[1])
    ce_check(label, _tls_buf_eq(got, h[0], h[1]) == 1)
}

fn test_rfc8448_key_schedule() {
    // 1. early secret = HKDF-Extract(0, 0)
    let early = tls_early_secret()
    eqhex("early secret", early, 32,
        "33 ad 0a 1c 60 7e c0 3b 09 e6 cd 98 93 68 0c e2 10 ad f3 00 aa 1f 26 60 e1 b2 2e 10 f1 70 f9 2a")

    // 2. derived = Derive-Secret(early, "derived", Hash(""))
    let derived = tls_derived(early)
    eqhex("derived(early)", derived, 32,
        "6f 26 15 a1 08 c7 02 c5 67 8f 54 fc 9d ba b6 97 16 c0 76 18 9c 48 25 0c eb ea c3 57 6c 36 11 ba")

    // 3. handshake secret = HKDF-Extract(derived, ECDHE)
    let ecdhe = hexbuf("8b d4 05 4f b5 5b 9d 63 fd fb ac f9 f0 4b 9f 0d 35 e6 d6 3f 53 75 63 ef d4 62 72 90 0f 89 49 2d")
    let hs = tls_handshake_secret(derived, ecdhe[0], 32)
    eqhex("handshake secret", hs, 32,
        "1d c8 26 e9 36 06 aa 6f dc 0a ad c1 2f 74 1b 01 04 6a a6 b9 9f 69 1e d2 21 a9 f0 ca 04 3f be ac")

    // transcript hash ClientHello..ServerHello
    let th = hexbuf("86 0c 06 ed c0 78 58 ee 8e 78 f0 e7 42 8c 58 ed d6 b4 3f 2c a3 e6 e9 5f 02 ed 06 3c f0 e1 ca d8")

    // 4 + 5. client/server handshake traffic secrets
    let chs = _tls_derive_secret(hs, "c hs traffic", th[0])
    eqhex("c hs traffic", chs, 32,
        "b3 ed db 12 6e 06 7f 35 a7 80 b3 ab f4 5e 2d 8f 3b 1a 95 07 38 f5 2e 96 00 74 6a 0e 27 a5 5a 21")
    let shs = _tls_derive_secret(hs, "s hs traffic", th[0])
    eqhex("s hs traffic", shs, 32,
        "b6 7b 7d 69 0c c1 6c 4e 75 e5 42 13 cb 2d 37 b4 e9 c9 12 bc de d9 10 5d 42 be fd 59 d3 91 ad 38")

    // 6. write key at the RFC's 16-byte (AES) length -> validates Expand-Label("key")
    let k16 = _tls_expand_label(shs, "key", _tls_zeros(0), 0, 16)
    eqhex("hs key (16)", k16, 16, "3f ce 51 60 09 c2 17 27 d0 f2 e4 e8 6e e4 03 bc")
    // 7. iv (12 bytes; cipher-independent)
    let iv = tls_traffic_iv(shs)
    eqhex("hs iv (12)", iv, 12, "5d 31 3e b2 67 12 76 ee 13 00 0b 30")

    // 8 + 9. master ladder
    let dhs = tls_derived(hs)
    eqhex("derived(handshake)", dhs, 32,
        "43 de 77 e0 c7 77 13 85 9a 94 4d b9 db 25 90 b5 31 90 a6 5b 3e e2 e4 f1 2d d7 a0 bb 7c e2 54 b4")
    let master = tls_master_secret(dhs)
    eqhex("master secret", master, 32,
        "18 df 06 84 3d 13 a0 8b f2 a4 49 84 4c 5f 8a 47 80 01 bc 4d 4c 62 79 84 d5 a4 1d a8 d0 40 29 19")
}

fn test_rfc8439_aead() {
    let key = hexbuf("80 81 82 83 84 85 86 87 88 89 8a 8b 8c 8d 8e 8f 90 91 92 93 94 95 96 97 98 99 9a 9b 9c 9d 9e 9f")
    let nonce = hexbuf("07 00 00 00 40 41 42 43 44 45 46 47")
    let aad = hexbuf("50 51 52 53 c0 c1 c2 c3 c4 c5 c6 c7")
    let pt = hexbuf("4c 61 64 69 65 73 20 61 6e 64 20 47 65 6e 74 6c 65 6d 65 6e 20 6f 66 20 74 68 65 20 63 6c 61 73 73 20 6f 66 20 27 39 39 3a 20 49 66 20 49 20 63 6f 75 6c 64 20 6f 66 66 65 72 20 79 6f 75 20 6f 6e 6c 79 20 6f 6e 65 20 74 69 70 20 66 6f 72 20 74 68 65 20 66 75 74 75 72 65 2c 20 73 75 6e 73 63 72 65 65 6e 20 77 6f 75 6c 64 20 62 65 20 69 74 2e")

    let sealed = tls_aead_seal(key[0], nonce[0], aad[0], aad[1], pt[0], pt[1])
    eqhex("aead ciphertext", sealed[0], 114,
        "d3 1a 8d 34 64 8e 60 db 7b 86 af bc 53 ef 7e c2 a4 ad ed 51 29 6e 08 fe a9 e2 b5 a7 36 ee 62 d6 3d be a4 5e 8c a9 67 12 82 fa fb 69 da 92 72 8b 1a 71 de 0a 9e 06 0b 29 05 d6 a5 b6 7e cd 3b 36 92 dd bd 7f 2d 77 8b 8c 98 03 ae e3 28 09 1b 58 fa b3 24 e4 fa d6 75 94 55 85 80 8b 48 31 d7 bc 3f f4 de f0 8e 4b 7a 9d e5 76 d2 65 86 ce c6 4b 61 16")
    eqhex("aead tag", sealed[1], 16, "1a e1 0b 59 4f 09 e2 6a 7e 90 2e cb d0 60 06 91")

    // Open round-trips and authenticates.
    let opened = tls_aead_open(key[0], nonce[0], aad[0], aad[1], sealed[0], 114, sealed[1])
    ce_eq("aead open ok", opened[0], 1)
    ce_check("aead open recovers plaintext", _tls_buf_eq(opened[1], pt[0], 114) == 1)

    // Tamper the tag -> open must reject.
    store8(sealed[1], int_xor(load8(sealed[1]), 1))
    let bad = tls_aead_open(key[0], nonce[0], aad[0], aad[1], sealed[0], 114, sealed[1])
    ce_eq("aead rejects tampered tag", bad[0], 0)
}

fn test_record_nonce() {
    let iv = hexbuf("5d 31 3e b2 67 12 76 ee 13 00 0b 30")
    // seq 0 -> nonce == iv
    let n0 = tls_record_nonce(iv[0], 0)
    ce_check("nonce seq0 == iv", _tls_buf_eq(n0, iv[0], 12) == 1)
    // seq 1 -> last byte XOR 1
    let n1 = tls_record_nonce(iv[0], 1)
    eqhex("nonce seq1", n1, 12, "5d 31 3e b2 67 12 76 ee 13 00 0b 31")
}

fn main() {
    test_rfc8448_key_schedule()
    test_rfc8439_aead()
    test_record_nonce()
    ce_summary("tls13_keyschedule")
}

main()
