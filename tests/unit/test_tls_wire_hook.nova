// Unit tests for src/net/tls/tls_wire_hook.nova R94 flip.
//
// Crown jewel: pair a server-role and client-role tls_conn under the
// wire hook's MOCK transport, pump handshake bytes between them via
// wire_conn_mock_pump_pair, and verify:
//   1. Both wire_conn_is_established() report 1.
//   2. wire_connection_write on the server, followed by shuttle +
//      wire_connection_read on the client, recovers the plaintext.
//   3. Same in the reverse direction.
//   4. wire_connection_close sends close_notify; the peer sees a
//      clean-EOF read.
// Plus backwards-compat: with tls_config == 0, wire_connection_wrap
// returns a RAW-tag null-op conn that stores the fd unchanged.

import "../ce_test.nova"
import "../../src/net/tls/tls_config.nova"
import "../../src/net/tls/tls_wire_hook.nova"
import "../../src/safety/rng.nova"
import "../../src/safety/ed25519.nova"
import "./fixtures/x509_test_certs.nova"

let _TW_NOW = 1718452800

fn _tw_rng(seed_str) {
    let ctx = list_new()
    let n = len(seed_str)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(seed_str, i))
        i = i + 1
    }
    store8(buf + n, 0)
    rng_test_new(ctx, buf, n)
    return ctx
}

let _TW_ROOT_CACHE = list_new()
let _TW_LEAF_CACHE = list_new()

fn _tw_root() {
    if len(_TW_ROOT_CACHE) == 0 {
        let pk = fx_ed25519_test1_pub()
        let sk = fx_ed25519_test1_seed()
        let c = x509_build_test_cert("TW_Root", "TW_Root", 1,
                                     "200101000000Z", "490101000000Z",
                                     pk, sk, pk)
        let i = 0
        while i < len(c) { push(_TW_ROOT_CACHE, c[i]); i = i + 1 }
    }
    return _TW_ROOT_CACHE
}

fn _tw_leaf() {
    if len(_TW_LEAF_CACHE) == 0 {
        let leaf_pk = fx_ed25519_test2_pub()
        let root_sk = fx_ed25519_test1_seed()
        let root_pk = fx_ed25519_test1_pub()
        let c = x509_build_test_cert("TW_Leaf", "TW_Root", 2,
                                     "200101000000Z", "490101000000Z",
                                     leaf_pk, root_sk, root_pk)
        let i = 0
        while i < len(c) { push(_TW_LEAF_CACHE, c[i]); i = i + 1 }
    }
    return _TW_LEAF_CACHE
}

fn _tw_make_server_cfg() {
    let leaf = _tw_leaf()
    let root = _tw_root()
    let priv = fx_ed25519_test2_seed()
    let cfg = list_new()
    tls_config_new_server(cfg, leaf, len(leaf), priv, root, len(root))
    return cfg
}

fn _tw_make_client_cfg() {
    let root = _tw_root()
    let cfg = list_new()
    tls_config_new_client(cfg, root, len(root))
    return cfg
}

fn _tw_bytes_to_buf(bytes) {
    let n = len(bytes)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, bytes[i])
        i = i + 1
    }
    store8(buf + n, 0)
    return buf
}

fn _tw_str_to_buf(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    return buf
}

fn _tw_buf_eq_str(buf, n, s) {
    if n != len(s) { return 0 }
    let i = 0
    while i < n {
        if load8(buf + i) != char_at(s, i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---- backwards-compat: null tls_config ---------------------------------

fn test_null_config_returns_raw_conn() {
    let out = list_new()
    ce_eq("null cfg ok",       wire_connection_wrap(42, 0, 0, out), 1)
    ce_eq("null cfg tag RAW",  wire_conn_tag(out), TLS_WIRE_CONN_TAG_RAW)
    ce_eq("null cfg fd",       wire_conn_fd(out), 42)
    ce_eq("null cfg est",      wire_conn_is_established(out), 1)
    ce_eq("null cfg session",  wire_conn_session(out), 0)
}

fn test_null_config_client_returns_raw_conn() {
    let out = list_new()
    ce_eq("null client ok",    wire_connection_wrap_client(7, 0, 0, 0, out), 1)
    ce_eq("null client tag",   wire_conn_tag(out), TLS_WIRE_CONN_TAG_RAW)
    ce_eq("null client fd",    wire_conn_fd(out), 7)
}

// ---- mock TLS wrap constructors ----------------------------------------

fn test_mock_wrap_server_ok() {
    let cfg = _tw_make_server_cfg()
    let rng = _tw_rng("wrap-s-seed")
    let out = list_new()
    ce_eq("mock server ok",
          wire_conn_new_mock_server(cfg, rng, _TW_NOW, out), 1)
    ce_eq("tag = TLS",         wire_conn_tag(out), TLS_WIRE_CONN_TAG_TLS)
    ce_eq("transport MOCK",    wire_conn_transport(out), WC_TRANSPORT_MOCK)
    ce_eq("fd = -1",           wire_conn_fd(out), 0 - 1)
    ce_eq("not established",   wire_conn_is_established(out), 0)
}

fn test_mock_wrap_client_ok() {
    let cfg = _tw_make_client_cfg()
    let rng = _tw_rng("wrap-c-seed")
    let out = list_new()
    ce_eq("mock client ok",
          wire_conn_new_mock_client(cfg, rng, _TW_NOW, out), 1)
    ce_eq("client tag = TLS",  wire_conn_tag(out), TLS_WIRE_CONN_TAG_TLS)
    ce_eq("client transport",  wire_conn_transport(out), WC_TRANSPORT_MOCK)
    ce_eq("client not est",    wire_conn_is_established(out), 0)
}

fn test_wrap_server_wrong_role_refused() {
    let client_cfg = _tw_make_client_cfg()
    let rng = _tw_rng("role-mixup")
    let out = list_new()
    // wire_connection_wrap is server-role; feeding a client-role
    // config must refuse.
    ce_eq("client cfg on server hook",
          wire_connection_wrap(0 - 1, client_cfg, rng, out), 0)
}

// ---- handshake pump + app data both ways -------------------------------

fn _tw_setup_pair() {
    let scfg = _tw_make_server_cfg()
    let ccfg = _tw_make_client_cfg()
    let srng = _tw_rng("pair-server-A")
    let crng = _tw_rng("pair-client-B")
    let server = list_new()
    let client = list_new()
    wire_conn_new_mock_server(scfg, srng, _TW_NOW, server)
    wire_conn_new_mock_client(ccfg, crng, _TW_NOW, client)
    wire_conn_mock_pump_pair(client, server, 40)
    let pair = list_new()
    push(pair, client)
    push(pair, server)
    return pair
}

fn test_handshake_converges() {
    let pair = _tw_setup_pair()
    let client = pair[0]
    let server = pair[1]
    ce_eq("client established", wire_conn_is_established(client), 1)
    ce_eq("server established", wire_conn_is_established(server), 1)
}

fn test_write_server_read_client() {
    let pair = _tw_setup_pair()
    let client = pair[0]
    let server = pair[1]
    let plain = "hello"
    let n = len(plain)
    let sbuf = _tw_str_to_buf(plain)
    ce_eq("server write ok", wire_connection_write(server, sbuf, n), 1)
    // Mock transport: shuttle server outbound to client inbound.
    let shuttled = wire_conn_mock_shuttle(server, client)
    ce_check("shuttled bytes > 0", shuttled > 0)
    let cbuf = alloc(64)
    let out_len = list_new()
    push(out_len, 0)
    ce_eq("client read ok",  wire_connection_read(client, cbuf, 64, out_len), 1)
    ce_eq("client read len", out_len[0], n)
    ce_eq("client read bytes", _tw_buf_eq_str(cbuf, out_len[0], plain), 1)
}

fn test_write_client_read_server() {
    let pair = _tw_setup_pair()
    let client = pair[0]
    let server = pair[1]
    let plain = "world!"
    let n = len(plain)
    let cbuf = _tw_str_to_buf(plain)
    ce_eq("client write ok", wire_connection_write(client, cbuf, n), 1)
    let shuttled = wire_conn_mock_shuttle(client, server)
    ce_check("shuttled bytes > 0", shuttled > 0)
    let sbuf = alloc(64)
    let out_len = list_new()
    push(out_len, 0)
    ce_eq("server read ok",  wire_connection_read(server, sbuf, 64, out_len), 1)
    ce_eq("server read len", out_len[0], n)
    ce_eq("server read bytes", _tw_buf_eq_str(sbuf, out_len[0], plain), 1)
}

fn test_read_before_data_returns_zero() {
    // Post-handshake but no ciphertext queued: read returns 0 bytes,
    // ok = 0 (nothing to serve).
    let pair = _tw_setup_pair()
    let client = pair[0]
    let buf = alloc(32)
    let out_len = list_new()
    push(out_len, 0)
    let ok = wire_connection_read(client, buf, 32, out_len)
    ce_eq("empty read ok = 0",  ok, 0)
    ce_eq("empty read len = 0", out_len[0], 0)
}

fn test_close_sends_close_notify() {
    let pair = _tw_setup_pair()
    let client = pair[0]
    let server = pair[1]
    ce_eq("server close ok",  wire_connection_close(server), 1)
    ce_eq("server closed",    wire_conn_is_closed(server), 1)
    // Shuttle close_notify to client, then a read on the client should
    // detect a clean close.
    let shuttled = wire_conn_mock_shuttle(server, client)
    ce_check("close_notify shuttled", shuttled > 0)
    let buf = alloc(16)
    let out_len = list_new()
    push(out_len, 0)
    let ok = wire_connection_read(client, buf, 16, out_len)
    ce_eq("client sees close ok = 0", ok, 0)
    ce_eq("client sees len = 0",       out_len[0], 0)
    ce_eq("client marked closed",      wire_conn_is_closed(client), 1)
}

fn test_close_idempotent() {
    let pair = _tw_setup_pair()
    let client = pair[0]
    wire_connection_close(client)
    ce_eq("second close ok",   wire_connection_close(client), 1)
    ce_eq("still closed",      wire_conn_is_closed(client), 1)
}

fn main() {
    test_null_config_returns_raw_conn()
    test_null_config_client_returns_raw_conn()
    test_mock_wrap_server_ok()
    test_mock_wrap_client_ok()
    test_wrap_server_wrong_role_refused()
    test_handshake_converges()
    test_write_server_read_client()
    test_write_client_read_server()
    test_read_before_data_returns_zero()
    test_close_sends_close_notify()
    test_close_idempotent()
    ce_summary("tls_wire_hook")
}

main()
