// R109 (Phase J): agent registry lifecycle + install/retire dep-check.

import "../ce_test.nova"
import "../../src/agents/agent_manifest.nova"
import "../../src/agents/agent_registry.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/util/str_safe.nova"

fn _mk_manifest(name) {
    let m = agent_manifest_new(name, "1.0.0", "desc-" + name)
    agent_manifest_add_skill_dep(m, "echo")
    return m
}

fn _mk_skill_reg() {
    let sr = skill_registry_new()
    let m = skill_manifest_new("echo", "1.0.0", "echo skill", 1)
    skill_registry_register(sr, m)
    return sr
}

fn test_new_empty() {
    let r = agent_registry_new()
    ce_eq("count 0", agent_registry_count(r), 0)
    ce_eq("names 0", len(agent_registry_names(r)), 0)
    ce_eq("installed 0", len(agent_registry_installed_names(r)), 0)
    ce_eq("lookup missing", agent_registry_lookup(r, "x"), 0)
    ce_eq("manifest missing", agent_registry_manifest(r, "x"), 0)
    ce_eq("is_installed missing", agent_registry_is_installed(r, "x"), 0)
    ce_eq("is_retired missing",   agent_registry_is_retired(r, "x"), 0)
}

fn test_register_idempotent() {
    let r = agent_registry_new()
    ce_eq("register 1st", agent_registry_register(r, _mk_manifest("a")), 1)
    ce_eq("register dupe", agent_registry_register(r, _mk_manifest("a")), 0)
    ce_eq("count 1", agent_registry_count(r), 1)
    ce_eq("register 2nd", agent_registry_register(r, _mk_manifest("b")), 1)
    ce_eq("count 2", agent_registry_count(r), 2)
    let names = agent_registry_names(r)
    ce_str_eq("names[0] a", names[0], "a")
    ce_str_eq("names[1] b", names[1], "b")
}

fn test_register_null_refused() {
    let r = agent_registry_new()
    ce_eq("null reg", agent_registry_register(0, _mk_manifest("a")), 0)
    ce_eq("null manifest", agent_registry_register(r, 0), 0)
    // Empty-name manifest refused.
    let m = agent_manifest_new("", "1", "")
    ce_eq("empty name", agent_registry_register(r, m), 0)
}

fn test_install_ok_and_states() {
    let r = agent_registry_new()
    agent_registry_register(r, _mk_manifest("a"))
    let sr = _mk_skill_reg()
    ce_eq("install ok", agent_registry_install(r, "a", sr, 100),
          AGENT_INSTALL_OK)
    ce_eq("installed", agent_registry_is_installed(r, "a"), 1)
    ce_eq("installed_at 100", agent_registry_installed_at(r, "a"), 100)
    ce_eq("not retired", agent_registry_is_retired(r, "a"), 0)
    ce_eq("retired_at 0", agent_registry_retired_at(r, "a"), 0)
}

fn test_install_unknown() {
    let r = agent_registry_new()
    ce_eq("unknown", agent_registry_install(r, "nope", 0, 100),
          AGENT_INSTALL_UNKNOWN)
}

fn test_install_already() {
    let r = agent_registry_new()
    agent_registry_register(r, _mk_manifest("a"))
    agent_registry_install(r, "a", 0, 100)
    ce_eq("already", agent_registry_install(r, "a", 0, 200),
          AGENT_INSTALL_ALREADY)
}

fn test_install_no_skill_deps() {
    let r = agent_registry_new()
    let m = agent_manifest_new("x", "1", "")
    agent_registry_register(r, m)
    ce_eq("no skill deps", agent_registry_install(r, "x", 0, 100),
          AGENT_INSTALL_NO_SKILL_DEPS)
}

fn test_install_missing_skill_dep() {
    let r = agent_registry_new()
    let m = agent_manifest_new("z", "1", "")
    agent_manifest_add_skill_dep(m, "nosuch_skill")
    agent_registry_register(r, m)
    let sr = _mk_skill_reg()   // has only echo
    ce_eq("missing skill", agent_registry_install(r, "z", sr, 100),
          AGENT_INSTALL_SKILL_MISSING)
    ce_eq("not installed", agent_registry_is_installed(r, "z"), 0)
}

fn test_install_skip_reg_check() {
    let r = agent_registry_new()
    let m = agent_manifest_new("z", "1", "")
    agent_manifest_add_skill_dep(m, "nosuch_skill")
    agent_registry_register(r, m)
    // skill_reg=0 -> skip check; still installs.
    ce_eq("install ok (no reg)", agent_registry_install(r, "z", 0, 100),
          AGENT_INSTALL_OK)
}

fn test_retire_lifecycle() {
    let r = agent_registry_new()
    agent_registry_register(r, _mk_manifest("a"))
    agent_registry_install(r, "a", 0, 100)
    ce_eq("retire", agent_registry_retire(r, "a", 200), 1)
    ce_eq("is_retired", agent_registry_is_retired(r, "a"), 1)
    ce_eq("retired_at", agent_registry_retired_at(r, "a"), 200)
    ce_eq("cleared installed", agent_registry_is_installed(r, "a"), 0)
    // Idempotent.
    ce_eq("retire dupe", agent_registry_retire(r, "a", 300), 0)
    // Cannot re-install retired.
    ce_eq("re-install refused",
          agent_registry_install(r, "a", 0, 400),
          AGENT_INSTALL_RETIRED)
    // Retire unknown.
    ce_eq("retire unknown", agent_registry_retire(r, "nope", 500), 0)
}

fn test_installed_names_excludes_retired() {
    let r = agent_registry_new()
    agent_registry_register(r, _mk_manifest("a"))
    agent_registry_register(r, _mk_manifest("b"))
    agent_registry_register(r, _mk_manifest("c"))
    agent_registry_install(r, "a", 0, 100)
    agent_registry_install(r, "b", 0, 100)
    agent_registry_retire(r, "b", 200)
    let names = agent_registry_installed_names(r)
    ce_eq("1 installed non-retired", len(names), 1)
    ce_str_eq("only a", names[0], "a")
}

fn test_remove() {
    let r = agent_registry_new()
    agent_registry_register(r, _mk_manifest("a"))
    agent_registry_register(r, _mk_manifest("b"))
    ce_eq("remove a", agent_registry_remove(r, "a"), 1)
    ce_eq("count 1", agent_registry_count(r), 1)
    ce_eq("remove missing", agent_registry_remove(r, "nope"), 0)
    let names = agent_registry_names(r)
    ce_str_eq("kept b", names[0], "b")
}

fn test_install_name_codes() {
    ce_str_eq("ok",       agent_install_name(AGENT_INSTALL_OK),             "ok")
    ce_str_eq("unknown",  agent_install_name(AGENT_INSTALL_UNKNOWN),        "unknown-agent")
    ce_str_eq("already",  agent_install_name(AGENT_INSTALL_ALREADY),        "already-installed")
    ce_str_eq("skill",    agent_install_name(AGENT_INSTALL_SKILL_MISSING),  "required-skill-missing")
    ce_str_eq("retired",  agent_install_name(AGENT_INSTALL_RETIRED),        "agent-retired")
    ce_str_eq("no-deps",  agent_install_name(AGENT_INSTALL_NO_SKILL_DEPS),  "no-skill-deps")
    ce_str_eq("bogus",    agent_install_name(999),                          "unknown-code")
}

fn test_lookup_returns_entry_after_state_changes() {
    let r = agent_registry_new()
    agent_registry_register(r, _mk_manifest("a"))
    let e1 = agent_registry_lookup(r, "a")
    ce_check("e1 non-null", e1 != 0)
    agent_registry_install(r, "a", 0, 100)
    let e2 = agent_registry_lookup(r, "a")
    ce_check("e2 non-null", e2 != 0)
    ce_eq("same entry", e1[AR_INSTALLED], 1)   // in-place mutation
}

fn main() {
    test_new_empty()
    test_register_idempotent()
    test_register_null_refused()
    test_install_ok_and_states()
    test_install_unknown()
    test_install_already()
    test_install_no_skill_deps()
    test_install_missing_skill_dep()
    test_install_skip_reg_check()
    test_retire_lifecycle()
    test_installed_names_excludes_retired()
    test_remove()
    test_install_name_codes()
    test_lookup_returns_entry_after_state_changes()
    ce_summary("agent_registry")
}

main()
