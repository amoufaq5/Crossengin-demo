// Unit tests for the R111 `self.override` wire verb.
//
// Exercises the six actions (belief_edit / goal_veto / hard_stop / resume
// / kill_switch / undo), cap-gate refusals, rate-budget refusal, and
// malformed-args refusals.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/sandbox/capability.nova"
import "../../src/parts/meta/override_wire.nova"
import "../../src/safety/override_mechanism.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/parts/goals/goal_engine.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}
fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}
fn _args5(k1,v1,k2,v2,k3,v3,k4,v4,k5,v5) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    push(a, rpc_arg_kv(k3, v3))
    push(a, rpc_arg_kv(k4, v4))
    push(a, rpc_arg_kv(k5, v5))
    return a
}

// Build a ctx with a KG registry (one atom labeled "mars" @ alpha/beta 3000/2000)
// and an OverrideRegistry attached. Returns [ctx, ovw_reg].
fn _mk_ctx_seeded() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let kreg = kg_registry_new()
    let kg = kg_spawn(kreg, "world")
    let a = kg_add_atom(kg, ATOM_FACT, "mars", 0)
    let b = atom_belief(a)
    list_set(b, 0, 3000)
    list_set(b, 1, 2000)
    list_set(ctx, RCTX_KGREG, kreg)
    let ovr = ovw_new()
    rpc_ctx_set_override_reg(ctx, ovr)
    let out = list_new()
    push(out, ctx)
    push(out, ovr)
    return out
}

// ---- no registry configured ---------------------------------------------

fn test_no_registry_refuses() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("ok:false",       _has(out, "\"ok\":false"))
    ce_check("names missing",  _has(out, "no override registry"))
}

// ---- action arg validation ----------------------------------------------

fn test_missing_action_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override", list_new(), ctx)
    ce_check("ok:false",       _has(out, "\"ok\":false"))
    ce_check("names action",   _has(out, "missing arg: action"))
}

fn test_unknown_action_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args1("action", "detonate"), ctx)
    ce_check("ok:false",     _has(out, "\"ok\":false"))
    ce_check("names bad",    _has(out, "detonate"))
}

// ---- hard_stop / resume / kill_switch happy path -----------------------

fn test_hard_stop_wired() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let ovr = seeded[1]
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("ok",                       _has(out, "\"ok\":true"))
    ce_check("action=hard_stop",         _has(out, "\"action\":\"hard_stop\""))
    ce_check("snap_captured false",      _has(out, "\"snapshot_captured\":false"))
    ce_check("override_id present",      _has(out, "\"override_id\":"))
    // Underlying safety state flipped.
    ce_eq("safety halted", safety_is_halted(ovw_safety(ovr)), 1)
}

fn test_resume_wired() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let ovr = seeded[1]
    rpc_dispatch("self.override", _args1("action", "hard_stop"), ctx)
    ce_eq("halted first", safety_is_halted(ovw_safety(ovr)), 1)
    let out = rpc_dispatch("self.override",
        _args1("action", "resume"), ctx)
    ce_check("ok",              _has(out, "\"ok\":true"))
    ce_check("action=resume",   _has(out, "\"action\":\"resume\""))
    ce_eq("safety not halted",  safety_is_halted(ovw_safety(ovr)), 0)
}

fn test_kill_switch_clean_wired() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let ovr = seeded[1]
    let out = rpc_dispatch("self.override",
        _args2("action", "kill_switch", "clean", "1"), ctx)
    ce_check("ok",                     _has(out, "\"ok\":true"))
    ce_check("action=kill_switch",     _has(out, "\"action\":\"kill_switch\""))
    ce_eq("safety killed", safety_is_killed(ovw_safety(ovr)), 1)
    ce_eq("not panic",     safety_kill_was_panic(ovw_safety(ovr)), 0)
}

fn test_kill_switch_missing_clean_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args1("action", "kill_switch"), ctx)
    ce_check("ok:false",  _has(out, "\"ok\":false"))
    ce_check("names clean", _has(out, "missing arg: clean"))
}

fn test_kill_switch_clean_zero_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let ovr = seeded[1]
    let out = rpc_dispatch("self.override",
        _args2("action", "kill_switch", "clean", "0"), ctx)
    ce_check("ok:false",       _has(out, "\"ok\":false"))
    ce_check("names must be 1", _has(out, "clean must be 1"))
    // Safety state untouched.
    ce_eq("not killed", safety_is_killed(ovw_safety(ovr)), 0)
}

// ---- belief_edit happy path + refusals ---------------------------------

fn test_belief_edit_happy() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args5("action", "belief_edit",
               "atom_label", "mars",
               "alpha", "999",
               "beta", "1",
               "pin", "1"), ctx)
    ce_check("ok",                   _has(out, "\"ok\":true"))
    ce_check("action=belief_edit",   _has(out, "\"action\":\"belief_edit\""))
    ce_check("snap_captured true",   _has(out, "\"snapshot_captured\":true"))
    // Underlying atom state.
    let kreg = rpc_ctx_kgreg(ctx)
    let kg = kg_get(kreg, 0)
    let a = kg_find_atom(kg, "mars")
    let b = atom_belief(a)
    ce_eq("alpha=999", b[0], 999)
    ce_eq("beta=1",    b[1], 1)
    ce_eq("pinned=1",  override_belief_is_pinned(a), 1)
}

fn test_belief_edit_missing_atom_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args5("action", "belief_edit",
               "atom_label", "pluto",
               "alpha", "50",
               "beta", "50",
               "pin", "0"), ctx)
    ce_check("ok:false",       _has(out, "\"ok\":false"))
    ce_check("names not found", _has(out, "atom not found"))
}

fn test_belief_edit_missing_alpha_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    // Only atom_label + beta (missing alpha).
    let args = list_new()
    push(args, rpc_arg_kv("action", "belief_edit"))
    push(args, rpc_arg_kv("atom_label", "mars"))
    push(args, rpc_arg_kv("beta", "1"))
    let out = rpc_dispatch("self.override", args, ctx)
    ce_check("ok:false",      _has(out, "\"ok\":false"))
    ce_check("names alpha",   _has(out, "missing arg: alpha"))
}

fn test_belief_edit_neg_alpha_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args5("action", "belief_edit",
               "atom_label", "mars",
               "alpha", "-5",
               "beta", "1",
               "pin", "0"), ctx)
    ce_check("ok:false",  _has(out, "\"ok\":false"))
    ce_check("names >=0", _has(out, "alpha must be >= 0"))
}

// ---- undo path ---------------------------------------------------------

fn test_undo_restores_belief() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    // 1. belief_edit -> alpha=999,beta=1,pin=1
    let e1 = rpc_dispatch("self.override",
        _args5("action", "belief_edit",
               "atom_label", "mars",
               "alpha", "999",
               "beta", "1",
               "pin", "1"), ctx)
    ce_check("edit ok", _has(e1, "\"ok\":true"))
    // Pull override_id 1 out of the response.
    ce_check("edit override_id=1", _has(e1, "\"override_id\":1"))
    // 2. undo it.
    let e2 = rpc_dispatch("self.override",
        _args2("action", "undo", "override_id", "1"), ctx)
    ce_check("undo ok",             _has(e2, "\"ok\":true"))
    ce_check("undo action=undo",    _has(e2, "\"action\":\"undo\""))
    // Atom restored to prior (3000 / 2000).
    let kreg = rpc_ctx_kgreg(ctx)
    let a = kg_find_atom(kg_get(kreg, 0), "mars")
    let b = atom_belief(a)
    ce_eq("restored alpha=3000", b[0], 3000)
    ce_eq("restored beta=2000",  b[1], 2000)
}

fn test_undo_missing_id_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args1("action", "undo"), ctx)
    ce_check("ok:false",           _has(out, "\"ok\":false"))
    ce_check("names override_id",  _has(out, "missing arg: override_id"))
}

fn test_undo_unknown_id_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args2("action", "undo", "override_id", "42"), ctx)
    ce_check("ok:false",   _has(out, "\"ok\":false"))
    ce_check("names 42",   _has(out, "not found: 42"))
}

fn test_undo_non_belief_edit_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    // Record a hard_stop (override_id=1), then try to undo it.
    rpc_dispatch("self.override", _args1("action", "hard_stop"), ctx)
    let out = rpc_dispatch("self.override",
        _args2("action", "undo", "override_id", "1"), ctx)
    ce_check("ok:false",              _has(out, "\"ok\":false"))
    ce_check("names supported",       _has(out, "undo only supported"))
}

fn test_undo_twice_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    rpc_dispatch("self.override",
        _args5("action", "belief_edit",
               "atom_label", "mars",
               "alpha", "999",
               "beta", "1",
               "pin", "0"), ctx)
    rpc_dispatch("self.override",
        _args2("action", "undo", "override_id", "1"), ctx)
    let out = rpc_dispatch("self.override",
        _args2("action", "undo", "override_id", "1"), ctx)
    ce_check("ok:false",         _has(out, "\"ok\":false"))
    ce_check("names already",    _has(out, "already undone"))
}

// ---- goal_veto happy path ----------------------------------------------

fn test_goal_veto_wired() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let ovr = seeded[1]
    let gid = goal_new(ovw_engine(ovr), "learn-plotting", 500, 0, 1, 0)
    let out = rpc_dispatch("self.override",
        _args2("action", "goal_veto", "goal_id", int_to_str(gid)), ctx)
    ce_check("ok",                  _has(out, "\"ok\":true"))
    ce_check("action=goal_veto",    _has(out, "\"action\":\"goal_veto\""))
    ce_eq("goal is VETOED", goal_status(ovw_engine(ovr), gid), GOAL_VETOED)
}

fn test_goal_veto_missing_goal_refuses() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args2("action", "goal_veto", "goal_id", "42"), ctx)
    ce_check("ok:false",     _has(out, "\"ok\":false"))
    ce_check("names not fnd", _has(out, "goal not found"))
}

// ---- rate budget refusal -----------------------------------------------

fn test_rate_limit_refuses_at_cap() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    // Fire 5 hard_stops (default cap=5).
    let i = 0
    while i < 5 {
        rpc_dispatch("self.override", _args1("action", "hard_stop"), ctx)
        i = i + 1
    }
    // 6th call refused.
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("ok:false",     _has(out, "\"ok\":false"))
    ce_check("names limit",  _has(out, "rate limit exceeded"))
}

// ---- response shape includes remaining_budget --------------------------

fn test_response_shape_carries_remaining_budget() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("remaining_budget field", _has(out, "\"remaining_budget\":"))
    // First call consumes 1 of 5 -> remaining=4.
    ce_check("remaining=4", _has(out, "\"remaining_budget\":4"))
}

// ---- cap gate ---------------------------------------------------------

fn test_cap_required_is_admin_self_override() {
    ce_check("self.override requires admin:self-override",
        str_eq_bytes(capability_verb_required("self.override"),
                     CAP_ADMIN_SELF_OVERRIDE) == 1)
}

fn test_admin_role_can_call() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "admin")
    let t = capability_token_new_roles("admin_tok", "admin", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "admin_tok")
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("admin ok", _has(out, "\"ok\":true"))
}

fn test_reader_role_refused() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    let roles = list_new()
    push(roles, "reader")
    let t = capability_token_new_roles("reader_tok", "carol", roles, 100, 0)
    capability_registry_add(cap_reg, t)
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    rpc_ctx_set_presented_token(ctx, "reader_tok")
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("reader:false",           _has(out, "\"ok\":false"))
    ce_check("reader names cap",       _has(out, "capability required"))
}

fn test_anonymous_refused_when_enforced() {
    let seeded = _mk_ctx_seeded()
    let ctx = seeded[0]
    let cap_reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, cap_reg, 1)
    let out = rpc_dispatch("self.override",
        _args1("action", "hard_stop"), ctx)
    ce_check("anon:false",   _has(out, "\"ok\":false"))
    ce_check("anon needs cap", _has(out, "capability required"))
}

// ---- verb registered in names -----------------------------------------

fn test_verb_in_names() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "self.override") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("self.override registered", saw, 1)
}

// ---- main --------------------------------------------------------------

fn main() {
    test_no_registry_refuses()
    test_missing_action_refuses()
    test_unknown_action_refuses()

    test_hard_stop_wired()
    test_resume_wired()
    test_kill_switch_clean_wired()
    test_kill_switch_missing_clean_refuses()
    test_kill_switch_clean_zero_refuses()

    test_belief_edit_happy()
    test_belief_edit_missing_atom_refuses()
    test_belief_edit_missing_alpha_refuses()
    test_belief_edit_neg_alpha_refuses()

    test_undo_restores_belief()
    test_undo_missing_id_refuses()
    test_undo_unknown_id_refuses()
    test_undo_non_belief_edit_refuses()
    test_undo_twice_refuses()

    test_goal_veto_wired()
    test_goal_veto_missing_goal_refuses()

    test_rate_limit_refuses_at_cap()
    test_response_shape_carries_remaining_budget()

    test_cap_required_is_admin_self_override()
    test_admin_role_can_call()
    test_reader_role_refused()
    test_anonymous_refused_when_enforced()

    test_verb_in_names()

    ce_summary("self_override_verb")
    return 0
}

main()
