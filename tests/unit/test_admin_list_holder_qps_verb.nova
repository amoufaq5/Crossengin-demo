// R113 (Phase K part 4) unit tests for admin.list_holder_qps.
//
// Covers:
//   * verb registered in rpc_verb_names()
//   * verb-cap map declares CAP_ADMIN_SANDBOX
//   * no holder-rate registry in context refuses cleanly
//   * empty registry response shape (default_qps + empty holders + next_after)
//   * populated registry lists rows with explicit + resolved fields
//   * R107 pagination: limit + after work uniformly

import "../ce_test.nova"
import "../../src/sandbox/capability.nova"
import "../../src/sandbox/holder_rate.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/util/str_safe.nova"

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_ctx() {
    return rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
}

fn _mk_arg(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

fn _mk_args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// ---- verb registration + cap ------------------------------------

fn test_verb_registered() {
    let names = rpc_verb_names()
    let saw = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "admin.list_holder_qps") == 1 { saw = 1 }
        i = i + 1
    }
    ce_eq("admin.list_holder_qps in verb list", saw, 1)
}

fn test_verb_cap_is_admin_sandbox() {
    ce_str_eq("cap is admin:sandbox",
              capability_verb_required("admin.list_holder_qps"),
              CAP_ADMIN_SANDBOX)
}

// ---- refusals ---------------------------------------------------

fn test_no_registry_in_context_refuses() {
    let ctx = _mk_ctx()
    let out = rpc_dispatch("admin.list_holder_qps", list_new(), ctx)
    ce_check("ok:false",  _has(out, "\"ok\":false"))
    ce_check("names it",  _has(out, "no holder-rate registry in context"))
}

// ---- empty registry ---------------------------------------------

fn test_empty_registry_response() {
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(15)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    let out = rpc_dispatch("admin.list_holder_qps", list_new(), ctx)
    ce_check("ok:true",           _has(out, "\"ok\":true"))
    ce_check("has default_qps 15", _has(out, "\"default_qps\":15"))
    ce_check("has empty holders",  _has(out, "\"holders\":[]"))
    ce_check("empty next_after",   _has(out, "\"next_after\":\"\""))
}

// ---- populated registry ------------------------------------------

fn test_populated_registry_lists_rows() {
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    holder_rate_set(reg, "alice", 42)
    holder_rate_set(reg, "bob",   0)     // unlimited-per-holder
    let out = rpc_dispatch("admin.list_holder_qps", list_new(), ctx)
    ce_check("ok:true",              _has(out, "\"ok\":true"))
    ce_check("default_qps 10",       _has(out, "\"default_qps\":10"))
    ce_check("row alice appears",    _has(out, "\"holder\":\"alice\""))
    ce_check("row bob appears",      _has(out, "\"holder\":\"bob\""))
    ce_check("alice qps 42",         _has(out, "\"qps_max\":42"))
    ce_check("explicit true",        _has(out, "\"explicit\":true"))
    ce_check("current_count field",  _has(out, "\"current_count\":"))
    ce_check("window_age field",     _has(out, "\"window_age_seconds\":"))
    ce_check("next_after empty tail",_has(out, "\"next_after\":\"\""))
}

// ---- pagination -------------------------------------------------

fn test_pagination_limit_and_after() {
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    // Set 5 explicit holders in known order: h001..h005.
    holder_rate_set(reg, "h001", 11)
    holder_rate_set(reg, "h002", 22)
    holder_rate_set(reg, "h003", 33)
    holder_rate_set(reg, "h004", 44)
    holder_rate_set(reg, "h005", 55)
    // Page 1: limit=2 -> h001, h002; next_after="h002".
    let p1 = rpc_dispatch("admin.list_holder_qps",
        _mk_arg("limit", "2"), ctx)
    ce_check("p1 has h001",     _has(p1, "\"holder\":\"h001\""))
    ce_check("p1 has h002",     _has(p1, "\"holder\":\"h002\""))
    ce_check("p1 stops @h003",  _has(p1, "\"holder\":\"h003\"") == 0)
    ce_check("p1 next=h002",    _has(p1, "\"next_after\":\"h002\""))
    // Page 2: after=h002, limit=2 -> h003, h004; next_after="h004".
    let p2 = rpc_dispatch("admin.list_holder_qps",
        _mk_args2("limit", "2", "after", "h002"), ctx)
    ce_check("p2 has h003",     _has(p2, "\"holder\":\"h003\""))
    ce_check("p2 has h004",     _has(p2, "\"holder\":\"h004\""))
    ce_check("p2 stops @h005",  _has(p2, "\"holder\":\"h005\"") == 0)
    ce_check("p2 next=h004",    _has(p2, "\"next_after\":\"h004\""))
    // Page 3: after=h004, limit=2 -> only h005; next_after="" (tail).
    let p3 = rpc_dispatch("admin.list_holder_qps",
        _mk_args2("limit", "2", "after", "h004"), ctx)
    ce_check("p3 has h005",     _has(p3, "\"holder\":\"h005\""))
    ce_check("p3 tail",         _has(p3, "\"next_after\":\"\""))
}

fn test_pagination_unknown_after_starts_from_head() {
    let ctx = _mk_ctx()
    let reg = holder_rate_registry_new(10)
    rpc_ctx_set_holder_rate_reg(ctx, reg)
    holder_rate_set(reg, "h001", 11)
    holder_rate_set(reg, "h002", 22)
    let out = rpc_dispatch("admin.list_holder_qps",
        _mk_args2("limit", "50", "after", "ghost"), ctx)
    ce_check("has h001", _has(out, "\"holder\":\"h001\""))
    ce_check("has h002", _has(out, "\"holder\":\"h002\""))
    ce_check("tail",     _has(out, "\"next_after\":\"\""))
}

// ---- main --------------------------------------------------------

fn main() {
    test_verb_registered()
    test_verb_cap_is_admin_sandbox()
    test_no_registry_in_context_refuses()
    test_empty_registry_response()
    test_populated_registry_lists_rows()
    test_pagination_limit_and_after()
    test_pagination_unknown_after_starts_from_head()
    ce_summary("admin_list_holder_qps_verb")
    return 0
}

main()
