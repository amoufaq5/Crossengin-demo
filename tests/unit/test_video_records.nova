// Unit tests for src/ingest/importers/video_records.nova (R105 -- Phase G).
//
// Covers:
//   * Empty input refused
//   * Non-Y4M magic refused (magic is "YUV4MPEG2")
//   * Missing newline terminator refused
//   * Missing W (width) refused
//   * Missing H (height) refused
//   * Well-formed minimal Y4M header (W2 H2 F30:1) produces the
//     perceptual root + 7 metadata siblings, each linked to root
//     via EMPIRICAL implication
//   * Metadata labels reflect W / H / fps values
//   * Source_tag defaults to src:video:<hash>
//   * Unknown tag payload after the mandatory tags is tolerated
//   * cur_validate acceptance
//   * Perceptual-prefix guard passes on root

import "../ce_test.nova"
import "../../src/ingest/importers/video_records.nova"
import "../../src/ingest/perceptual_capsule.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

fn _push_str(bl, s) {
    let n = len(s)
    let i = 0
    while i < n {
        push(bl, char_at(s, i))
        i = i + 1
    }
}

// Build a minimal Y4M header line: "YUV4MPEG2 W<w> H<h> F<fn>:<fd>\n"
fn _mk_y4m_header(w, h, fn_num, fn_den) {
    let bl = list_new()
    _push_str(bl, "YUV4MPEG2 W")
    _push_str(bl, int_to_str(w))
    _push_str(bl, " H")
    _push_str(bl, int_to_str(h))
    _push_str(bl, " F")
    _push_str(bl, int_to_str(fn_num))
    _push_str(bl, ":")
    _push_str(bl, int_to_str(fn_den))
    push(bl, 10)   // newline
    return bl
}

fn test_empty_input_refused() {
    let bl = list_new()
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("no records on empty", len(vidr_records(r)), 0)
    ce_eq("one error on empty",  len(vidr_errors(r)), 1)
    ce_check("error mentions empty",
             find_bytes(vidr_errors(r)[0][1], "empty") >= 0)
}

fn test_bad_magic_refused() {
    let bl = list_new()
    _push_str(bl, "NOTMAGIC W2 H2 F30:1\n")
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("no records on bad magic", len(vidr_records(r)), 0)
    ce_eq("one error on bad magic",  len(vidr_errors(r)), 1)
    ce_check("error mentions YUV4MPEG2",
             find_bytes(vidr_errors(r)[0][1], "YUV4MPEG2") >= 0)
}

fn test_missing_newline_refused() {
    let bl = list_new()
    _push_str(bl, "YUV4MPEG2 W2 H2 F30:1")   // no \n
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("no records on missing newline", len(vidr_records(r)), 0)
    ce_eq("one error on missing newline",  len(vidr_errors(r)), 1)
}

fn test_missing_width_refused() {
    let bl = list_new()
    _push_str(bl, "YUV4MPEG2 H2 F30:1\n")   // no W
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("no records on missing W", len(vidr_records(r)), 0)
    ce_eq("one error on missing W",  len(vidr_errors(r)), 1)
    ce_check("error mentions width",
             find_bytes(vidr_errors(r)[0][1], "width") >= 0)
}

fn test_missing_height_refused() {
    let bl = list_new()
    _push_str(bl, "YUV4MPEG2 W2 F30:1\n")   // no H
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("no records on missing H", len(vidr_records(r)), 0)
    ce_eq("one error on missing H",  len(vidr_errors(r)), 1)
    ce_check("error mentions height",
             find_bytes(vidr_errors(r)[0][1], "height") >= 0)
}

fn test_minimal_header_record_shape() {
    let bl = _mk_y4m_header(2, 2, 30, 1)
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("one record", len(vidr_records(r)), 1)
    ce_eq("no errors",  len(vidr_errors(r)), 0)
    let rec = vidr_records(r)[0]
    ce_str_eq("kg name", cur_kg(rec), "visual")
    ce_str_eq("source tag", cur_source(rec), "src:video:test:v1")
    // Root + 7 metadata atoms.
    ce_eq("8 atoms total", len(cur_atoms(rec)), 8)
    ce_eq("7 metadata implications", len(cur_imps(rec)), 7)
    let root = cur_atoms(rec)[0]
    ce_eq("root prefix valid",
          perc_label_prefix_valid(root[CUR_ATOM_LABEL]), 1)
    ce_eq("root kind FACT", root[CUR_ATOM_KIND], ATOM_FACT)
    ce_eq("root seed 900",  root[CUR_ATOM_BELIEF], 900)
    let all_ok = 1
    let i = 0
    while i < len(cur_imps(rec)) {
        let imp = cur_imps(rec)[i]
        if str_eq_bytes(imp[CUR_IMP_CONSEQ], root[CUR_ATOM_LABEL]) == 0 { all_ok = 0 }
        if str_eq_bytes(imp[CUR_IMP_STR], "EMPIRICAL") == 0 { all_ok = 0 }
        i = i + 1
    }
    ce_eq("all imps EMPIRICAL -> root", all_ok, 1)
    ce_eq("cur_validate ok", cur_validate(rec), CUR_OK)
}

fn test_metadata_labels_reflect_dims_and_fps() {
    let bl = _mk_y4m_header(640, 480, 24000, 1001)
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    let rec = vidr_records(r)[0]
    let saw_w = 0
    let saw_h = 0
    let saw_fn = 0
    let saw_fd = 0
    let saw_fmt = 0
    let i = 0
    while i < len(cur_atoms(rec)) {
        let lab = cur_atoms(rec)[i][CUR_ATOM_LABEL]
        if find_bytes(lab, ":width=640")    >= 0 { saw_w   = 1 }
        if find_bytes(lab, ":height=480")   >= 0 { saw_h   = 1 }
        if find_bytes(lab, ":fps_num=24000") >= 0 { saw_fn  = 1 }
        if find_bytes(lab, ":fps_den=1001") >= 0 { saw_fd  = 1 }
        if find_bytes(lab, ":format=y4m")   >= 0 { saw_fmt = 1 }
        i = i + 1
    }
    ce_eq("saw width=640",     saw_w,   1)
    ce_eq("saw height=480",    saw_h,   1)
    ce_eq("saw fps_num=24000", saw_fn,  1)
    ce_eq("saw fps_den=1001",  saw_fd,  1)
    ce_eq("saw format=y4m",    saw_fmt, 1)
}

fn test_source_default() {
    let bl = _mk_y4m_header(2, 2, 30, 1)
    let r = vidr_parse_bytes(bl, "", "")
    let rec = vidr_records(r)[0]
    ce_str_eq("kg default", cur_kg(rec), "visual")
    ce_check("source starts with src:video:",
             find_bytes(cur_source(rec), "src:video:") == 0)
}

fn test_unknown_tag_tolerated() {
    // "YUV4MPEG2 W16 H8 F25:1 Ip A1:1 C420\n"
    // Ip (interlace), A1:1 (aspect), C420 (colorspace) are common
    // extra tags; the importer must tolerate them.
    let bl = list_new()
    _push_str(bl, "YUV4MPEG2 W16 H8 F25:1 Ip A1:1 C420\n")
    let r = vidr_parse_bytes(bl, "visual", "src:video:test:v1")
    ce_eq("one record with extra tags", len(vidr_records(r)), 1)
    ce_eq("no errors with extra tags",  len(vidr_errors(r)), 0)
    let rec = vidr_records(r)[0]
    let saw_w = 0
    let i = 0
    while i < len(cur_atoms(rec)) {
        if find_bytes(cur_atoms(rec)[i][CUR_ATOM_LABEL], ":width=16") >= 0 { saw_w = 1 }
        i = i + 1
    }
    ce_eq("width=16 survived unknown tags", saw_w, 1)
}

fn main() {
    test_empty_input_refused()
    test_bad_magic_refused()
    test_missing_newline_refused()
    test_missing_width_refused()
    test_missing_height_refused()
    test_minimal_header_record_shape()
    test_metadata_labels_reflect_dims_and_fps()
    test_source_default()
    test_unknown_tag_tolerated()
    ce_summary("video_records")
}

main()
