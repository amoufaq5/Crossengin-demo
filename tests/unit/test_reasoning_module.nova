// Unit tests for src/parts/reasoning/reasoning_module.nova
// Verifies forward chaining, abduction, analogical transfer, means-ends
// decomposition, and evidential combination (chain vs support). ADR-0031.

import "../ce_test.nova"
import "../../src/parts/reasoning/reasoning_module.nova"

// rain(0) -> wet(1) -> slippery(2); rain =>(imply) slippery; rain ~analogy~> ice(3).
fn build() {
    let reg = kg_registry_new()
    let rkg = reasoning_kg_init(reg)
    kg_add_atom(rkg, ATOM_FACT, "rain", 0)        // 0
    kg_add_atom(rkg, ATOM_FACT, "wet", 0)         // 1
    kg_add_atom(rkg, ATOM_FACT, "slippery", 0)    // 2
    kg_add_atom(rkg, ATOM_FACT, "ice", 0)         // 3
    rop_new(rkg, ROP_CAUSAL, 0, 1, "rain->wet", 0)
    rop_new(rkg, ROP_CAUSAL, 1, 2, "wet->slip", 0)
    rop_new(rkg, ROP_IMPLY, 0, 2, "rain=>slip", 0)
    let an = rop_new(rkg, ROP_ANALOGY, 0, 3, "rain~ice", 0)
    rop_observe(an, 1)   // make analogy more confident
    return rkg
}

fn test_forward_chain() {
    let rkg = build()
    let trace = reason_forward_chain(rkg, 0, 3)
    // rain reaches wet, slippery (direct imply + via wet).
    let concl = reason_conclusions(trace)
    ce_check("reaches wet", contains(concl, 1) == 1)
    ce_check("reaches slippery", contains(concl, 2) == 1)
    ce_check("trace records steps", len(trace) >= 2)
    // A single bounded step does not reach the 2-hop conclusion via wet.
    let shallow = reason_forward_chain(rkg, 0, 1)
    ce_check("shallow still reaches direct", contains(reason_conclusions(shallow), 2) == 1)
}

fn test_abduction_analogy_meansends() {
    let rkg = build()
    // Best explanation for 'wet' is 'rain' (causal premise).
    ce_eq("abduce cause of wet", reason_abductive(rkg, 1), 0)
    // No causal explanation for 'rain' itself.
    ce_eq("no cause of rain", reason_abductive(rkg, 0), -1)
    // Analogical transfer from rain -> ice.
    ce_eq("analogy rain->ice", reason_analogical_transfer(rkg, 0), 3)
    // Means-ends: 'slippery' is implied by 'rain' -> subgoal rain.
    let subs = reason_means_ends(rkg, 2)
    ce_check("subgoal includes rain", contains(subs, 0) == 1)
}

fn test_evidential() {
    // Chain: 0.9 * 0.8 = 0.72.
    let chain = list_new(); push(chain, 900); push(chain, 800)
    ce_eq("chain multiplies", reason_evidential_chain(chain), 720)
    // Support (noisy-OR): 0.9, 0.8 -> 0.98.
    let sup = list_new(); push(sup, 900); push(sup, 800)
    ce_eq("support raises", reason_evidential_support(sup), 980)
    // Empty chain -> 1.0; empty support -> 0.
    ce_eq("empty chain", reason_evidential_chain(list_new()), 1000)
    ce_eq("empty support", reason_evidential_support(list_new()), 0)
}

fn main() {
    test_forward_chain()
    test_abduction_analogy_meansends()
    test_evidential()
    ce_summary("reasoning_module")
}

main()
