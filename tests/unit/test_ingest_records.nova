// Unit tests for src/ingest/importers/records.nova (.cerec parser).

import "../ce_test.nova"
import "../../src/ingest/importers/records.nova"

fn test_empty_text() {
    let r = cerec_parse_text("")
    ce_eq("no records", len(cerec_records(r)), 0)
    ce_eq("no errors", len(cerec_errors(r)), 0)
}

fn test_only_comments() {
    let r = cerec_parse_text("# a comment\n# another\n")
    ce_eq("no records", len(cerec_records(r)), 0)
    ce_eq("no errors", len(cerec_errors(r)), 0)
}

fn test_single_record_all_directives() {
    let text = "KG history\n"
             + "SRC src:pack:history\n"
             + "ATOM hastings_1066 1 950\n"
             + "ATOM harold_died 1 800\n"
             + "IMP hastings_1066 harold_died EMPIRICAL\n"
             + "OBS hastings_1066 +1 1000\n"
             + "CITE src:pack:history src:paper:doi:xxx supports\n"
    let r = cerec_parse_text(text)
    let recs = cerec_records(r)
    ce_eq("one record", len(recs), 1)
    ce_eq("no errors", len(cerec_errors(r)), 0)
    let rec = recs[0]
    ce_eq("kg", cur_kg(rec), "history")
    ce_eq("src", cur_source(rec), "src:pack:history")
    ce_eq("2 atoms", len(cur_atoms(rec)), 2)
    ce_eq("1 imp", len(cur_imps(rec)), 1)
    ce_eq("1 obs", len(cur_obs(rec)), 1)
    ce_eq("1 cite", len(cur_cites(rec)), 1)
    ce_eq("validator ok", cur_validate(rec), CUR_OK)
}

fn test_multiple_records_blank_separated() {
    let text = "KG a\nSRC src:one\nATOM x 1 500\n"
             + "\n"
             + "KG b\nSRC src:two\nATOM y 1 700\n"
    let r = cerec_parse_text(text)
    let recs = cerec_records(r)
    ce_eq("two records", len(recs), 2)
    ce_eq("first kg a", cur_kg(recs[0]), "a")
    ce_eq("second kg b", cur_kg(recs[1]), "b")
}

fn test_new_kg_closes_previous() {
    let text = "KG a\nSRC src:one\nATOM x 1 500\n"
             + "KG b\nSRC src:two\nATOM y 1 700\n"
    let r = cerec_parse_text(text)
    ce_eq("two records", len(cerec_records(r)), 2)
}

fn test_trailing_no_newline() {
    let text = "KG a\nSRC src:x\nATOM y 1 500"
    let r = cerec_parse_text(text)
    ce_eq("one record", len(cerec_records(r)), 1)
    ce_eq("atom counted", len(cur_atoms(cerec_records(r)[0])), 1)
}

fn test_bad_directive_logged() {
    let text = "KG a\nSRC src:x\nBOGUS foo bar\nATOM y 1 500\n"
    let r = cerec_parse_text(text)
    ce_eq("one record", len(cerec_records(r)), 1)
    ce_eq("one error", len(cerec_errors(r)), 1)
    ce_eq("atom still counted", len(cur_atoms(cerec_records(r)[0])), 1)
}

fn test_directive_before_kg_errors() {
    let r = cerec_parse_text("ATOM x 1 500\nKG a\nSRC src:x\n")
    ce_eq("one error", len(cerec_errors(r)), 1)
    ce_eq("one record still", len(cerec_records(r)), 1)
}

fn test_atom_bad_belief_type() {
    let text = "KG a\nSRC src:x\nATOM y 1 hello\n"
    let r = cerec_parse_text(text)
    ce_check("has error", len(cerec_errors(r)) >= 1)
    ce_eq("atom skipped", len(cur_atoms(cerec_records(r)[0])), 0)
}

fn test_imp_bad_strength() {
    let text = "KG a\nSRC src:x\nATOM p 1 500\nATOM q 1 500\nIMP p q MAYBE\n"
    let r = cerec_parse_text(text)
    ce_check("has error", len(cerec_errors(r)) >= 1)
    ce_eq("imp skipped", len(cur_imps(cerec_records(r)[0])), 0)
}

fn test_obs_bad_sign() {
    let text = "KG a\nSRC src:x\nATOM p 1 500\nOBS p 3 100\n"
    let r = cerec_parse_text(text)
    ce_check("has error", len(cerec_errors(r)) >= 1)
    ce_eq("obs skipped", len(cur_obs(cerec_records(r)[0])), 0)
}

fn test_comments_interleaved() {
    let text = "# top comment\n"
             + "KG a\n"
             + "SRC src:x\n"
             + "# an atom below\n"
             + "ATOM y 1 500\n"
    let r = cerec_parse_text(text)
    ce_eq("one record", len(cerec_records(r)), 1)
    ce_eq("no errors", len(cerec_errors(r)), 0)
    ce_eq("atom present", len(cur_atoms(cerec_records(r)[0])), 1)
}

fn test_tabs_as_separator() {
    let text = "KG\ta\nSRC\tsrc:x\nATOM\ty\t1\t500\n"
    let r = cerec_parse_text(text)
    ce_eq("one record", len(cerec_records(r)), 1)
    ce_eq("kg parsed", cur_kg(cerec_records(r)[0]), "a")
    ce_eq("atom parsed", len(cur_atoms(cerec_records(r)[0])), 1)
}

fn test_end_to_end_pipeline_over_parsed() {
    import_dummy()
}

fn import_dummy() { return 0 }

fn main() {
    test_empty_text()
    test_only_comments()
    test_single_record_all_directives()
    test_multiple_records_blank_separated()
    test_new_kg_closes_previous()
    test_trailing_no_newline()
    test_bad_directive_logged()
    test_directive_before_kg_errors()
    test_atom_bad_belief_type()
    test_imp_bad_strength()
    test_obs_bad_sign()
    test_comments_interleaved()
    test_tabs_as_separator()
    ce_summary("ingest_records")
}

main()
