// Unit tests for src/ingest/perceptual_capsule.nova (R105).
//
// Covers:
//   * modality enum <-> name / prefix round-trip
//   * source_prefix per modality
//   * hash: byte-list + string paths agree; deterministic; distinct
//     inputs yield distinct 16-char prefixes
//   * full-hash 64-char length
//   * root / meta / derived label shape
//   * perc_label_prefix_valid recognizes all four prefixes and rejects
//     non-perceptual labels
//   * perc_add_root: record atoms grow by one, atom label is the root
//   * perc_add_meta: adds atom + implication linking meta -> root
//   * perc_add_derived_text: empty text is a no-op; non-empty text
//     adds text_root + text_atom + two implications

import "../ce_test.nova"
import "../../src/ingest/perceptual_capsule.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

fn test_modality_enum_shape() {
    ce_str_eq("name image", perc_modality_name(PERC_MOD_IMAGE), "image")
    ce_str_eq("name audio", perc_modality_name(PERC_MOD_AUDIO), "audio")
    ce_str_eq("name video", perc_modality_name(PERC_MOD_VIDEO), "video")
    ce_str_eq("name text",  perc_modality_name(PERC_MOD_TEXT_DERIVED), "text")
    ce_str_eq("name unknown", perc_modality_name(PERC_MOD_UNKNOWN), "unknown")
    ce_str_eq("prefix image", perc_modality_prefix(PERC_MOD_IMAGE), "perc:image:")
    ce_str_eq("prefix audio", perc_modality_prefix(PERC_MOD_AUDIO), "perc:audio:")
    ce_str_eq("prefix video", perc_modality_prefix(PERC_MOD_VIDEO), "perc:video:")
    ce_str_eq("prefix text",  perc_modality_prefix(PERC_MOD_TEXT_DERIVED), "perc:text:")
}

fn test_source_prefix() {
    ce_str_eq("src image", perc_source_prefix(PERC_MOD_IMAGE), "src:image:")
    ce_str_eq("src audio", perc_source_prefix(PERC_MOD_AUDIO), "src:audio:")
    ce_str_eq("src video", perc_source_prefix(PERC_MOD_VIDEO), "src:video:")
    ce_str_eq("src text",  perc_source_prefix(PERC_MOD_TEXT_DERIVED), "src:text:derived:")
}

fn test_hash_shape_and_determinism() {
    // Byte list of "PNG" (three bytes).
    let bl = list_new()
    push(bl, 80) push(bl, 78) push(bl, 71)
    let h1 = perc_hash_from_bytes(bl)
    let h2 = perc_hash_from_bytes(bl)
    ce_eq("hash prefix length 16", len(h1), 16)
    ce_check("hash deterministic (byte list)", str_eq_bytes(h1, h2) == 1)
    let h_str = perc_hash_from_string("PNG")
    ce_check("byte-list and string hash agree", str_eq_bytes(h1, h_str) == 1)
    // Different input -> different hash prefix (with sky-high probability).
    let bl2 = list_new()
    push(bl2, 80) push(bl2, 78) push(bl2, 72)     // PNH
    let h3 = perc_hash_from_bytes(bl2)
    ce_check("distinct inputs distinct hashes", str_eq_bytes(h1, h3) == 0)
    // Full-hash length + consistency between string / list.
    let full_bl = perc_hash_full_from_bytes(bl)
    let full_s  = perc_hash_full_from_string("PNG")
    ce_eq("full-hash length 64", len(full_bl), 64)
    ce_check("full-hash byte/string agree", str_eq_bytes(full_bl, full_s) == 1)
    // Empty-input hash still deterministic (empty list, empty string).
    let empty = list_new()
    let he_l = perc_hash_from_bytes(empty)
    let he_s = perc_hash_from_string("")
    ce_eq("empty hash length 16", len(he_l), 16)
    ce_check("empty hash byte/string agree", str_eq_bytes(he_l, he_s) == 1)
}

fn test_label_builders() {
    let h = "abcd1234abcd1234"
    ce_str_eq("root image",  perc_root_label(PERC_MOD_IMAGE, h), "perc:image:abcd1234abcd1234")
    ce_str_eq("root audio",  perc_root_label(PERC_MOD_AUDIO, h), "perc:audio:abcd1234abcd1234")
    ce_str_eq("root video",  perc_root_label(PERC_MOD_VIDEO, h), "perc:video:abcd1234abcd1234")
    ce_str_eq("meta width",  perc_meta_label(PERC_MOD_IMAGE, h, "width", "800"),
              "perc:image:abcd1234abcd1234:width=800")
    ce_str_eq("meta rate",   perc_meta_label(PERC_MOD_AUDIO, h, "rate", "16000"),
              "perc:audio:abcd1234abcd1234:rate=16000")
    ce_str_eq("derived root", perc_derived_root_label(PERC_MOD_IMAGE, h),
              "perc:image:abcd1234abcd1234:text")
}

fn test_prefix_valid() {
    ce_eq("image valid",       perc_label_prefix_valid("perc:image:aaaa"), 1)
    ce_eq("audio valid",       perc_label_prefix_valid("perc:audio:aaaa"), 1)
    ce_eq("video valid",       perc_label_prefix_valid("perc:video:aaaa"), 1)
    ce_eq("text  valid",       perc_label_prefix_valid("perc:text:aaaa"),  1)
    ce_eq("plain 'foo' rej",   perc_label_prefix_valid("foo"),             0)
    ce_eq("perc: bare rej",    perc_label_prefix_valid("perc:"),           0)
    ce_eq("hologram rej",      perc_label_prefix_valid("perc:hologram:aa"), 0)
    ce_eq("close-miss rej",    perc_label_prefix_valid("perci:image:aa"),  0)
    ce_eq("empty rej",         perc_label_prefix_valid(""),                0)
    ce_eq("src: rej",          perc_label_prefix_valid("src:image:aa"),    0)
}

fn test_add_root_grows_atoms() {
    let r = cur_new("visual", "src:image:test:v1")
    let n0 = len(cur_atoms(r))
    let lab = perc_add_root(r, PERC_MOD_IMAGE, "deadbeefdeadbeef", 900)
    let n1 = len(cur_atoms(r))
    ce_eq("one atom added", n1 - n0, 1)
    ce_str_eq("root label matches", lab, "perc:image:deadbeefdeadbeef")
    ce_eq("perceptual valid", perc_label_prefix_valid(lab), 1)
    // Underlying atom shape: label / kind / seed_belief.
    let a = cur_atoms(r)[n0]
    ce_str_eq("atom label", a[CUR_ATOM_LABEL], "perc:image:deadbeefdeadbeef")
    ce_eq("atom kind FACT", a[CUR_ATOM_KIND], ATOM_FACT)
    ce_eq("atom seed 900",  a[CUR_ATOM_BELIEF], 900)
}

fn test_add_meta_links_to_root() {
    let r = cur_new("visual", "src:image:test:v1")
    perc_add_root(r, PERC_MOD_IMAGE, "cafe1234cafe1234", 800)
    let a0 = len(cur_atoms(r))
    let i0 = len(cur_imps(r))
    let m = perc_add_meta(r, PERC_MOD_IMAGE, "cafe1234cafe1234", "width", "800")
    let m2 = perc_add_meta(r, PERC_MOD_IMAGE, "cafe1234cafe1234", "height", "600")
    ce_eq("two meta atoms added", len(cur_atoms(r)) - a0, 2)
    ce_eq("two meta implications added", len(cur_imps(r)) - i0, 2)
    ce_str_eq("meta label", m, "perc:image:cafe1234cafe1234:width=800")
    ce_str_eq("meta label 2", m2, "perc:image:cafe1234cafe1234:height=600")
    // The implication should point meta -> root.
    let imp = cur_imps(r)[i0]
    ce_str_eq("imp ante is meta", imp[CUR_IMP_ANTE], m)
    ce_str_eq("imp conseq is root", imp[CUR_IMP_CONSEQ], "perc:image:cafe1234cafe1234")
    ce_str_eq("imp strength EMPIRICAL", imp[CUR_IMP_STR], "EMPIRICAL")
}

fn test_add_derived_text() {
    let r = cur_new("visual", "src:image:test:v1")
    perc_add_root(r, PERC_MOD_IMAGE, "1111222233334444", 900)
    let a0 = len(cur_atoms(r))
    let i0 = len(cur_imps(r))
    // Empty text -> no-op.
    let empty_ret = perc_add_derived_text(r, PERC_MOD_IMAGE, "1111222233334444", "")
    ce_str_eq("empty text returns empty", empty_ret, "")
    ce_eq("no atoms added for empty text", len(cur_atoms(r)) - a0, 0)
    ce_eq("no imps added for empty text",  len(cur_imps(r))  - i0, 0)
    // Non-empty text -> text_root + text_atom + two imps.
    let tr = perc_add_derived_text(r, PERC_MOD_IMAGE, "1111222233334444", "Hello world.")
    ce_str_eq("text_root label", tr, "perc:image:1111222233334444:text")
    ce_eq("two atoms added (text_root + text)", len(cur_atoms(r)) - a0, 2)
    ce_eq("two imps added (text_root->root, text->text_root)",
          len(cur_imps(r)) - i0, 2)
    // The last-added atom is the text itself; its label carries the OCR content.
    let last_atom = cur_atoms(r)[len(cur_atoms(r)) - 1]
    ce_str_eq("text atom label is content", last_atom[CUR_ATOM_LABEL], "Hello world.")
}

fn test_record_still_validates() {
    // End-to-end sanity: an image record built entirely from perc_*
    // helpers passes the cur_validate structural checker so the
    // pipeline layer can apply it without a per-format special case.
    let r = cur_new("visual", "src:image:test:v1")
    let h = "aaaabbbbccccdddd"
    perc_add_root(r, PERC_MOD_IMAGE, h, 900)
    perc_add_meta(r, PERC_MOD_IMAGE, h, "width",  "128")
    perc_add_meta(r, PERC_MOD_IMAGE, h, "height", "128")
    perc_add_meta(r, PERC_MOD_IMAGE, h, "format", "png")
    perc_add_derived_text(r, PERC_MOD_IMAGE, h, "test caption")
    ce_eq("cur_validate accepts perceptual record", cur_validate(r), CUR_OK)
    ce_eq("record size (atoms + imps + obs + cites) = 7 + 4 + 0 + 0 = 11",
          cur_size(r), 4 + 2 + 4 + 1)
    // (atoms=5: root + 3 meta + text_root + text_atom = 6 wait)
    // atoms = root + 3 meta + text_root + text_atom = 6
    // imps  = 3 meta_imps + text_root_imp + text_atom_imp = 5
    ce_eq("atoms count", len(cur_atoms(r)), 6)
    ce_eq("imps count",  len(cur_imps(r)),  5)
}

fn main() {
    test_modality_enum_shape()
    test_source_prefix()
    test_hash_shape_and_determinism()
    test_label_builders()
    test_prefix_valid()
    test_add_root_grows_atoms()
    test_add_meta_links_to_root()
    test_add_derived_text()
    test_record_still_validates()
    ce_summary("perceptual_capsule")
}

main()
