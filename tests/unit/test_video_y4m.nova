// Unit tests for src/io/transducers/video_y4m.nova (P3.2).
//
// Hermetic coverage of the minimum-viable Y4M (YUV4MPEG2) raw video
// decoder + the motion / scene-change helpers the video_perception
// seam leans on. Every fixture is built in-memory (alloc + store8) so
// the suite never depends on an on-disk video file. The y4m_open
// (file-reading) path is exercised by the integration test
// (scenario_s_video_play.sh) which builds a fixture in /tmp via
// printf -- separating in-memory from on-disk coverage keeps this
// suite tied only to the decoder's in-buffer logic.
//
// Assertion targets (~20 the brief asks for):
//   * y4m_open_bytes header happy path: 4x4 YCbCr 4:2:0 fixture --
//     width=4, height=4, fps_num/den match, state_ok=1.
//   * Bad magic ("XYZ4MPEG2") sets a non-empty error_msg and
//     state_ok=0.
//   * Missing 'W' tag triggers "missing W (width)".
//   * Oversized width > Y4M_MAX_W rejected with a clear error.
//   * y4m_next_frame on the 2-frame fixture: first frame returns
//     index=0 with non-zero Y pointer; second frame returns index=1.
//   * Third call yields the end-of-stream error.
//   * Y plane bytes round-trip exactly through load8(y_ptr + i).
//   * Cb / Cr planes are addressable (1x1 = 1 byte at 4x4 4:2:0).
//   * y4m_frame_to_pgm returns the y_ptr unchanged (identity wrapper
//     -- the Y plane IS a PGM image so callers can feed it directly
//     into pgm_histogram / pgm_mean_intensity).
//   * y4m_mean_abs_diff on two identical buffers returns 0;
//     on a delta of +50 across every pixel returns 50.
//   * Dimensions tuple round-trip via y4m_dimensions(state).

import "../ce_test.nova"
import "../../src/io/transducers/video_y4m.nova"

// ---- fixture builder ------------------------------------------------------
// Build a Y4M buffer in raw bytes: header followed by `frame_count`
// frames of known Y/Cb/Cr data. Returns [buffer_ptr, total_len].
//
// For a 4x4 4:2:0 fixture each frame is:
//   "FRAME\n" + 16 Y bytes + 4 Cb bytes + 4 Cr bytes = 30 bytes.
//
// `y_value_fn` and `chroma_value_fn` are integer-valued knobs the
// caller passes per-frame so we can test multiple frames with
// distinct values.
fn _build_y4m_2frame(width, height, fps_num, fps_den, y_a, c_a, y_b, c_b) {
    let w_str = int_to_str(width)
    let h_str = int_to_str(height)
    let fn_str = int_to_str(fps_num)
    let fd_str = int_to_str(fps_den)
    let header = "YUV4MPEG2 W" + w_str + " H" + h_str
        + " F" + fn_str + ":" + fd_str + " Ip A1:1 C420\n"
    let hlen = len(header)
    let y_area = width * height
    let chroma_w = width / 2
    let chroma_h = height / 2
    let chroma_area = chroma_w * chroma_h
    let frame_marker = "FRAME\n"
    let mlen = len(frame_marker)
    let frame_size = mlen + y_area + 2 * chroma_area
    let total = hlen + 2 * frame_size
    let buf = alloc(total + 1)
    // header
    let i = 0
    while i < hlen {
        store8(buf + i, char_at(header, i))
        i = i + 1
    }
    let off = hlen
    // frame A
    let k = 0
    while k < mlen {
        store8(buf + off + k, char_at(frame_marker, k))
        k = k + 1
    }
    off = off + mlen
    let p = 0
    while p < y_area {
        store8(buf + off + p, y_a)
        p = p + 1
    }
    off = off + y_area
    let q = 0
    while q < chroma_area {
        store8(buf + off + q, c_a)
        q = q + 1
    }
    off = off + chroma_area
    let q2 = 0
    while q2 < chroma_area {
        store8(buf + off + q2, c_a)
        q2 = q2 + 1
    }
    off = off + chroma_area
    // frame B
    let k2 = 0
    while k2 < mlen {
        store8(buf + off + k2, char_at(frame_marker, k2))
        k2 = k2 + 1
    }
    off = off + mlen
    let p2 = 0
    while p2 < y_area {
        store8(buf + off + p2, y_b)
        p2 = p2 + 1
    }
    off = off + y_area
    let r2 = 0
    while r2 < chroma_area {
        store8(buf + off + r2, c_b)
        r2 = r2 + 1
    }
    off = off + chroma_area
    let r3 = 0
    while r3 < chroma_area {
        store8(buf + off + r3, c_b)
        r3 = r3 + 1
    }
    off = off + chroma_area
    let pair = list_new()
    push(pair, buf)
    push(pair, total)
    return pair
}

// ---- happy path -----------------------------------------------------------

fn test_open_4x4_header_dims() {
    let fix = _build_y4m_2frame(4, 4, 30, 1, 100, 128, 200, 128)
    let s = y4m_open_bytes(fix[0], fix[1])
    ce_str_eq("error empty on valid 4x4 Y4M", y4m_state_error(s), "")
    ce_eq("width=4",   y4m_state_width(s),  4)
    ce_eq("height=4",  y4m_state_height(s), 4)
    ce_eq("fps_num=30", y4m_state_fps_num(s), 30)
    ce_eq("fps_den=1",  y4m_state_fps_den(s), 1)
    ce_eq("state_ok=1 on valid Y4M", y4m_state_ok(s), 1)
    let dims = y4m_dimensions(s)
    ce_eq("dims[0]=4",   dims[0], 4)
    ce_eq("dims[1]=4",   dims[1], 4)
    ce_eq("dims[2]=30",  dims[2], 30)
    ce_eq("dims[3]=1",   dims[3], 1)
}

fn test_next_frame_yields_index_and_pixels() {
    let fix = _build_y4m_2frame(4, 4, 30, 1, 100, 128, 200, 128)
    let s = y4m_open_bytes(fix[0], fix[1])
    let f0 = y4m_next_frame(s)
    ce_str_eq("frame 0 no error", y4m_frame_error(f0), "")
    ce_eq("frame 0 index=0", y4m_frame_index(f0), 0)
    let yp0 = y4m_frame_y(f0)
    ce_eq("frame 0 Y[0]=100",  load8(yp0 + 0),  100)
    ce_eq("frame 0 Y[15]=100", load8(yp0 + 15), 100)
    let cb0 = y4m_frame_cb(f0)
    ce_eq("frame 0 Cb[0]=128", load8(cb0 + 0), 128)
    let cr0 = y4m_frame_cr(f0)
    ce_eq("frame 0 Cr[0]=128", load8(cr0 + 0), 128)
    let f1 = y4m_next_frame(s)
    ce_str_eq("frame 1 no error", y4m_frame_error(f1), "")
    ce_eq("frame 1 index=1", y4m_frame_index(f1), 1)
    let yp1 = y4m_frame_y(f1)
    ce_eq("frame 1 Y[0]=200",  load8(yp1 + 0),  200)
    ce_eq("frame 1 Y[15]=200", load8(yp1 + 15), 200)
    ce_eq("state frame_count=2 after two frames", y4m_state_frame_count(s), 2)
}

fn test_next_frame_end_of_stream() {
    let fix = _build_y4m_2frame(4, 4, 30, 1, 100, 128, 200, 128)
    let s = y4m_open_bytes(fix[0], fix[1])
    let f0 = y4m_next_frame(s)
    let f1 = y4m_next_frame(s)
    let f2 = y4m_next_frame(s)
    let err = y4m_frame_error(f2)
    ce_check("third frame -> non-empty error", len(err) > 0)
    ce_eq("third frame ok=0", y4m_frame_ok(f2), 0)
}

// ---- y4m_frame_to_pgm bridge ---------------------------------------------

fn test_frame_to_pgm_identity() {
    let fix = _build_y4m_2frame(4, 4, 30, 1, 100, 128, 200, 128)
    let s = y4m_open_bytes(fix[0], fix[1])
    let f0 = y4m_next_frame(s)
    let yp = y4m_frame_y(f0)
    let pgm_ptr = y4m_frame_to_pgm(yp, 4, 4)
    // Identity wrapper: the same pointer comes back so we can pass it
    // straight into pgm_* helpers. We check at the byte level rather
    // than pointer-comparison because NOVA's int / pointer comparison
    // is the source of the codegen gotcha #11 already documented.
    ce_eq("frame_to_pgm preserves Y[0]",  load8(pgm_ptr + 0),  100)
    ce_eq("frame_to_pgm preserves Y[8]",  load8(pgm_ptr + 8),  100)
    ce_eq("frame_to_pgm preserves Y[15]", load8(pgm_ptr + 15), 100)
}

// ---- malformed inputs ----------------------------------------------------

fn test_malformed_bad_magic() {
    let bad = "XYZ4MPEG2 W4 H4 F30:1 C420\nFRAME\n"
    let blen = len(bad)
    let buf = alloc(blen + 16)
    let i = 0
    while i < blen {
        store8(buf + i, char_at(bad, i))
        i = i + 1
    }
    let s = y4m_open_bytes(buf, blen)
    let err = y4m_state_error(s)
    ce_check("bad magic -> non-empty error", len(err) > 0)
    ce_eq("bad magic -> state_ok=0", y4m_state_ok(s), 0)
}

fn test_malformed_missing_width() {
    let bad = "YUV4MPEG2 H4 F30:1 C420\nFRAME\n"
    let blen = len(bad)
    let buf = alloc(blen + 16)
    let i = 0
    while i < blen {
        store8(buf + i, char_at(bad, i))
        i = i + 1
    }
    let s = y4m_open_bytes(buf, blen)
    let err = y4m_state_error(s)
    ce_check("missing W -> non-empty error", len(err) > 0)
}

fn test_dimension_cap_rejects_huge() {
    let bad = "YUV4MPEG2 W4096 H4 F30:1 C420\n"
    let blen = len(bad)
    let buf = alloc(blen + 16)
    let i = 0
    while i < blen {
        store8(buf + i, char_at(bad, i))
        i = i + 1
    }
    let s = y4m_open_bytes(buf, blen)
    let err = y4m_state_error(s)
    ce_check("width > 768 -> non-empty error", len(err) > 0)
    ce_eq("oversized -> state_ok=0", y4m_state_ok(s), 0)
}

// ---- motion proxy --------------------------------------------------------

fn test_mean_abs_diff_identical_zero() {
    let a = alloc(16)
    let b = alloc(16)
    let i = 0
    while i < 16 {
        store8(a + i, 80)
        store8(b + i, 80)
        i = i + 1
    }
    ce_eq("mean |a-b| on identical 4x4 == 0",
          y4m_mean_abs_diff(a, b, 4, 4), 0)
}

fn test_mean_abs_diff_constant_50() {
    let a = alloc(16)
    let b = alloc(16)
    let i = 0
    while i < 16 {
        store8(a + i, 100)
        store8(b + i, 150)
        i = i + 1
    }
    ce_eq("mean |a-b| with +50 across all pixels == 50",
          y4m_mean_abs_diff(a, b, 4, 4), 50)
    // Symmetric: a vs b == b vs a.
    ce_eq("mean |a-b| symmetric",
          y4m_mean_abs_diff(b, a, 4, 4), 50)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_open_4x4_header_dims()
    test_next_frame_yields_index_and_pixels()
    test_next_frame_end_of_stream()
    test_frame_to_pgm_identity()
    test_malformed_bad_magic()
    test_malformed_missing_width()
    test_dimension_cap_rejects_huge()
    test_mean_abs_diff_identical_zero()
    test_mean_abs_diff_constant_50()
    ce_summary("video_y4m")
}

main()
