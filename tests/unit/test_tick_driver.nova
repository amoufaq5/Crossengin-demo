// Unit tests for src/substrate/tick_driver.nova
// Verifies the four-phase tick: a stimulated node fires and enters refractory;
// activation propagates along a synapse across ticks; an inhibitory synapse
// vetoes a target's firing; plasticity runs within a tick over the tick-start
// snapshot; and the logical clock advances. ADR-0006, ADR-0001, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/tick_driver.nova"

fn one_part(preset, cap, first_count) {
    let reg = part_registry_new()
    registry_add(reg, "t", preset, cap, first_count)
    return reg
}

fn test_single_node_fire() {
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    npm_node_input(pool, 0, 700)
    let fired = td_tick_part(reg, 0, 1, TD_MOD_NEUTRAL, 0)
    ce_eq("one node fired", fired, 1)
    ce_eq("node 0 fired at tick 1", npm_last_fired(pool, 0), 1)
    ce_eq("refractory reset", npm_activation(pool, 0), 0)
    ce_eq("quiet node never fired", npm_last_fired(pool, 1), -1)
}

fn test_chain_propagation() {
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)
    syn_new(g, 0, 1, 900, 0)
    npm_node_input(pool, 0, 700)

    // Tick 1: node 0 fires, spike lands in node 1's inbox.
    ce_eq("tick1 fires one", td_tick_part(reg, 0, 1, TD_MOD_NEUTRAL, 0), 1)
    ce_eq("node 0 fired", npm_last_fired(pool, 0), 1)
    ce_eq("node 1 not yet", npm_last_fired(pool, 1), -1)
    ce_eq("spike delivered to node 1 inbox", npm_inbox(pool, 1), 900)

    // Tick 2: node 1 integrates the delivered spike and fires.
    ce_eq("tick2 fires one", td_tick_part(reg, 0, 2, TD_MOD_NEUTRAL, 0), 1)
    ce_eq("node 1 fired at tick 2", npm_last_fired(pool, 1), 2)
}

fn test_inhibition_vetoes() {
    // Inhibitory synapse 0 -> 2; node 0 fires, suppressing node 2.
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)
    syn_new(g, 0, 2, -800, 0)
    npm_node_input(pool, 0, 700)
    td_tick_part(reg, 0, 1, TD_MOD_NEUTRAL, 0)
    ce_eq("inhibition delivered", npm_inbox(pool, 2), -800)
    npm_node_input(pool, 2, 600)   // excitation that would otherwise fire it
    td_tick_part(reg, 0, 2, TD_MOD_NEUTRAL, 0)
    ce_eq("node 2 vetoed", npm_last_fired(pool, 2), -1)

    // Control: same excitation without the inhibitory synapse -> fires.
    let reg2 = one_part(FN_PRESET_REASONING, 16, 4)
    let pool2 = part_pool(registry_get(reg2, 0))
    npm_node_input(pool2, 2, 600)
    td_tick_part(reg2, 0, 1, TD_MOD_NEUTRAL, 0)
    ce_eq("control fires", npm_last_fired(pool2, 2), 1)
}

fn test_plasticity_within_tick() {
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)
    let s = syn_new(g, 0, 1, 100, 0)
    // Both endpoints co-active at tick start (snapshot 600,600).
    npm_set_activation(pool, 0, 600)
    npm_set_activation(pool, 1, 600)
    let fired = td_tick_part(reg, 0, 1, TD_MOD_NEUTRAL, 0)
    ce_eq("both co-active fire", fired, 2)
    // dw = mod * eta_h * pre * post = 1.0 * 0.02 * 0.6 * 0.6 = 0.007 -> +7.
    ce_eq("synapse potentiated within tick", syn_weight(g, s), 107)
}

fn test_engine_clock() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 32, 4)
    let perception = registry_find(reg, "perception")
    let pool = part_pool(registry_get(reg, perception))
    npm_node_input(pool, 0, 700)
    let e = td_engine_new(reg)
    ce_eq("clock starts at 0", td_now(e), 0)
    let fired = td_step(e, TD_MOD_NEUTRAL, 0)
    ce_eq("clock advanced to 1", td_now(e), 1)
    ce_check("at least the stimulated node fired", fired >= 1)
    td_step(e, TD_MOD_NEUTRAL, 0)
    ce_eq("clock advanced to 2", td_now(e), 2)
}

fn test_bad_part_graceful() {
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    ce_eq("unknown part ticks nothing", td_tick_part(reg, 999, 1, TD_MOD_NEUTRAL, 0), 0)
}

// ---- opt-in three-factor pass (ADR-0052) ----------------------------------
// These exercise the additive three-factor wiring. The cases above already
// proved the DEFAULT path (td_tick_part / td_step) is unchanged; these add the
// new opt-in path and must not affect those.

// The three-factor pass defaults OFF on a new engine, and td_step_3f with the
// flag off behaves exactly like td_step (default path, no extra learning).
fn test_three_factor_off_by_default() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 32, 4)
    let perception = registry_find(reg, "perception")
    let pool = part_pool(registry_get(reg, perception))
    npm_node_input(pool, 0, 700)
    let e = td_engine_new(reg)
    ce_eq("three-factor off on a fresh engine", td_three_factor_enabled(e), 0)
    // With the flag off, td_step_3f falls back to the plain tick: the stimulated
    // node still fires and the clock still advances (same contract as td_step).
    let fired = td_step_3f(e, TD_MOD_NEUTRAL, 0, 1000, 0, 0)
    ce_eq("clock advanced under disabled 3f step", td_now(e), 1)
    ce_check("disabled 3f step still ticks the substrate", fired >= 1)
}

// The standalone seam: a rewarded co-firing measurably moves a weight while an
// unrewarded one (reward 0) does not. Mirrors the synapse-graph acceptance but
// driven through the tick driver's tick_three_factor_pass entry point.
fn test_three_factor_rewarded_vs_unrewarded() {
    // Rewarded: nodes 0 and 1 co-fire at tick 5; a +reward pass potentiates 0->1.
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 0, 0)
    let ft = list_new(); push(ft, 5); push(ft, 5)   // both fired this tick
    let nm = tick_three_factor_pass(g, ft, 1000, 0, 0)
    ce_check("reward yields a positive neuromodulator", nm > 0)
    ce_check("rewarded co-firing potentiated the synapse", syn_weight(g, s) > 0)

    // Unrewarded: identical co-firing, reward 0 -> neuromod 0 -> no weight move.
    let g2 = syn_graph_new()
    let s2 = syn_new(g2, 0, 1, 0, 0)
    let ft2 = list_new(); push(ft2, 5); push(ft2, 5)
    let nm2 = tick_three_factor_pass(g2, ft2, 0, 0, 0)
    ce_eq("no reward yields a zero neuromodulator", nm2, 0)
    ce_eq("unrewarded co-firing left the weight unchanged", syn_weight(g2, s2), 0)

    // Yet the eligibility trace WAS deposited in the unrewarded case -- a later
    // reward could still credit it (delayed credit assignment). The difference
    // is purely the broadcast third factor, not the trace.
    ce_check("unrewarded pass still deposited an eligibility trace", syn_elig(g2, s2) > 0)
}

// Punishment: a negative reward depresses an already-excitatory weight via the
// same pass (the third factor's sign drives the direction of learning).
fn test_three_factor_punishment() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 500, 0)   // start excitatory (0.5)
    let ft = list_new(); push(ft, 3); push(ft, 3)
    let w0 = syn_weight(g, s)
    let nm = tick_three_factor_pass(g, ft, -1000, 0, 0)
    ce_check("punishment yields a negative neuromodulator", nm < 0)
    ce_check("punished co-firing depressed the weight", syn_weight(g, s) < w0)
}

// In-loop wiring end-to-end: drive the three-factor pass THROUGH the tick path
// (td_tick_part_3f). Two identical parts co-fire two nodes in a tick; the one
// ticked with a reward ends with a strictly larger synapse weight than the one
// ticked with no reward. Any difference is attributable to the neuromodulator,
// since the default fused-rule contribution is identical in both.
fn test_three_factor_in_loop() {
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)
    let s = syn_new(g, 0, 1, 100, 0)
    npm_set_activation(pool, 0, 600)
    npm_set_activation(pool, 1, 600)
    let fired = td_tick_part_3f(reg, 0, 1, TD_MOD_NEUTRAL, 0, 1000, 0, 0)
    ce_eq("both co-active fire under 3f tick", fired, 2)

    // Control with the SAME setup but no reward (reward 0 -> inert third factor).
    let reg2 = one_part(FN_PRESET_REASONING, 16, 4)
    let part2 = registry_get(reg2, 0)
    let pool2 = part_pool(part2)
    let g2 = part_syn(part2)
    let s2 = syn_new(g2, 0, 1, 100, 0)
    npm_set_activation(pool2, 0, 600)
    npm_set_activation(pool2, 1, 600)
    td_tick_part_3f(reg2, 0, 1, TD_MOD_NEUTRAL, 0, 0, 0, 0)

    ce_check("rewarded in-loop tick wired more weight than unrewarded",
             syn_weight(g, s) > syn_weight(g2, s2))
    // The unrewarded 3f tick must match the plain tick exactly (no extra move
    // beyond the fused Hebbian +7 seen in test_plasticity_within_tick).
    let reg3 = one_part(FN_PRESET_REASONING, 16, 4)
    let part3 = registry_get(reg3, 0)
    let pool3 = part_pool(part3)
    let g3 = part_syn(part3)
    let s3 = syn_new(g3, 0, 1, 100, 0)
    npm_set_activation(pool3, 0, 600)
    npm_set_activation(pool3, 1, 600)
    td_tick_part(reg3, 0, 1, TD_MOD_NEUTRAL, 0)
    ce_eq("unrewarded 3f tick equals the plain tick weight",
          syn_weight(g2, s2), syn_weight(g3, s3))
}

// Delayed credit assignment through the loop: co-fire at tick 1 (deposit
// eligibility, no reward), let the trace persist while quiet ticks pass, then a
// reward arrives later and still credits the synapse that co-fired earlier.
fn test_three_factor_delayed_reward_in_loop() {
    let reg = one_part(FN_PRESET_REASONING, 16, 4)
    let part = registry_get(reg, 0)
    let pool = part_pool(part)
    let g = part_syn(part)
    let s = syn_new(g, 0, 1, 0, 0)
    npm_set_activation(pool, 0, 600)
    npm_set_activation(pool, 1, 600)
    // Tick 1: co-fire, no reward -> eligibility deposited, weight ~unchanged by 3f.
    td_tick_part_3f(reg, 0, 1, TD_MOD_NEUTRAL, 0, 0, 0, 0)
    let w_after_cofire = syn_weight(g, s)
    ce_check("eligibility persisted after the unrewarded co-fire", syn_elig(g, s) > 0)

    // A few quiet ticks pass (nothing co-fires; trace decays but survives).
    let t = 2
    while t < 5 {
        td_tick_part_3f(reg, 0, t, TD_MOD_NEUTRAL, 0, 0, 0, 0)
        t = t + 1
    }
    ce_check("trace still present across the delay", syn_elig(g, s) > 0)

    // Reward arrives at tick 5 (nodes quiet now): it credits the lingering trace.
    td_tick_part_3f(reg, 0, 5, TD_MOD_NEUTRAL, 0, 1000, 0, 0)
    ce_check("delayed reward potentiated the earlier co-firing", syn_weight(g, s) > w_after_cofire)
}

// The appraisal convenience: a desirable moment (positive valence) potentiates,
// confirming the appraisal -> valence -> reward -> three-factor wiring path.
fn test_three_factor_appraised() {
    let g = syn_graph_new()
    let s = syn_new(g, 0, 1, 0, 0)
    let ft = list_new(); push(ft, 2); push(ft, 2)
    // Strongly desirable outcome -> positive signed reward.
    let nm = tick_three_factor_appraised(g, ft, 800, 0, 0)
    ce_check("desirable appraisal yields a positive neuromodulator", nm > 0)
    ce_check("desirable appraisal potentiated the synapse", syn_weight(g, s) > 0)
}

fn main() {
    test_single_node_fire()
    test_chain_propagation()
    test_inhibition_vetoes()
    test_plasticity_within_tick()
    test_engine_clock()
    test_bad_part_graceful()
    test_three_factor_off_by_default()
    test_three_factor_rewarded_vs_unrewarded()
    test_three_factor_punishment()
    test_three_factor_in_loop()
    test_three_factor_delayed_reward_in_loop()
    test_three_factor_appraised()
    ce_summary("tick_driver")
}

main()
