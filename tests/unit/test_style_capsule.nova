// Unit tests for src/capsules/style_capsule.nova + templater integration
// (R52, ADR-0108).
//
// Covers: 3 built-in styles ship with matching names, knob accessors
// return sensible non-empty strings for each, the registry lookup path
// (known name / empty ref / unknown name -> default), template
// integration renders differently per style, presence flags respect
// SHOW_* knobs, refusal-hdr swap, byte-identical output on repeat.

import "../ce_test.nova"
import "../../src/capsules/style_capsule.nova"
import "../../src/nl/templater.nova"
import "../../src/skills/skill_supervisor.nova"
import "../../src/persona/persona.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

// ---- test helpers --------------------------------------------------------

// Build an atom on `kg_label` with a specific belief mean, expressed
// as alpha/beta pseudo-counts.
fn _mk_atom(kg_label, id, label, alpha, beta) {
    let a = atom_new(kg_label, id, ATOM_FACT, label, 0)
    list_set(a[A_BELIEF], 0, alpha)
    list_set(a[A_BELIEF], 1, beta)
    return a
}

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _mk_persona_with_style(style_name) {
    let p = persona_new("u", "Alice", "test", 0)
    if len(style_name) > 0 { persona_set_style_capsule(p, style_name, 0) }
    return p
}

// A PR with two disagreeing atoms on 'mars' + one effector call +
// a non-neutral projection.
fn _mk_full_pr() {
    let pr = skill_pr_new()
    skill_pr_set_proposal(pr, "answer body about mars")
    skill_pr_set_confidence(pr, 800)
    skill_pr_set_ok(pr)
    skill_pr_add_atom(pr, _mk_atom("solar_system", 0, "mars", 8000, 2000))
    skill_pr_add_atom(pr, _mk_atom("folk_astronomy", 0, "mars", 2000, 8000))
    let args = list_new() push(args, "alice")
    skill_pr_add_effector_call(pr, "send", args)
    let proj = list_new()
    push(proj, 425)  push(proj, 200)  push(proj, 500)
    push(proj, list_new())  push(proj, list_new())  push(proj, list_new())
    list_set(pr, PR_PROJECTION, proj)
    return pr
}

// ---- built-in registry ---------------------------------------------------

fn test_registry_ships_three_builtins() {
    ce_check("at least 3 registered", style_registry_count() >= 3)
    let names = style_registry_names()
    let has_default = 0
    let has_terse = 0
    let has_formal = 0
    let i = 0
    while i < len(names) {
        if str_eq_bytes(names[i], "default") == 1 { has_default = 1 }
        if str_eq_bytes(names[i], "terse")   == 1 { has_terse = 1 }
        if str_eq_bytes(names[i], "formal")  == 1 { has_formal = 1 }
        i = i + 1
    }
    ce_eq("default present", has_default, 1)
    ce_eq("terse present",   has_terse, 1)
    ce_eq("formal present",  has_formal, 1)
}

fn test_lookup_default_by_empty_and_by_name() {
    let byname = style_registry_lookup("default")
    let empty  = style_registry_lookup("")
    ce_eq("both are 'default'", str_eq_bytes(style_name(byname), "default"), 1)
    ce_eq("empty falls back to default",
          str_eq_bytes(style_name(empty), "default"), 1)
}

fn test_unknown_falls_back_to_default() {
    let s = style_registry_lookup("no-such-style-anywhere")
    ce_eq("fallback name", str_eq_bytes(style_name(s), "default"), 1)
}

fn test_is_known_flag() {
    ce_eq("default known",   style_registry_is_known("default"), 1)
    ce_eq("terse known",     style_registry_is_known("terse"),   1)
    ce_eq("empty is known (means default)",
          style_registry_is_known(""), 1)
    ce_eq("bogus not known", style_registry_is_known("bogus"),   0)
}

fn test_register_replaces_by_name() {
    // Register a synthetic style, then look it up.
    let s = style_default()
    list_set(s, STYLE_NAME, "test-only-x1")
    list_set(s, STYLE_REFUSAL_HDR, "custom-refuse-marker: ")
    style_registry_register(s)
    let got = style_registry_lookup("test-only-x1")
    ce_check("registered", _has(style_refusal_hdr(got), "custom-refuse-marker"))
    // Re-register with different content -> replaces.
    let s2 = style_default()
    list_set(s2, STYLE_NAME, "test-only-x1")
    list_set(s2, STYLE_REFUSAL_HDR, "REPLACED: ")
    style_registry_register(s2)
    let got2 = style_registry_lookup("test-only-x1")
    ce_check("replaced not duplicated",
             _has(style_refusal_hdr(got2), "REPLACED"))
}

// ---- knob shape sanity ---------------------------------------------------
//
// Each built-in must have every knob populated (empty string is fine,
// but every accessor must return a string, not 0, since the templater
// concatenates them). This catches "I forgot to set slot X" bugs.

fn _knob_is_string(s, idx) {
    // Empty is fine; non-string would be an int (0) and len() on 0 fails.
    let v = s[idx]
    // A NOVA int does not have a len; treat 0 as "unset" here.
    if v == 0 { return 0 }
    return 1
}

fn test_default_populated() {
    let s = style_registry_lookup("default")
    let i = 0
    while i < STYLE_SLOT_COUNT {
        // Flags are ints (0/1); skip those.
        if i < STYLE_SHOW_SOURCES {
            ce_eq("default slot " + int_to_str(i) + " is a string",
                  _knob_is_string(s, i), 1)
        }
        i = i + 1
    }
}

fn test_terse_populated() {
    let s = style_registry_lookup("terse")
    let i = 0
    while i < STYLE_SLOT_COUNT {
        if i < STYLE_SHOW_SOURCES {
            ce_eq("terse slot " + int_to_str(i) + " is a string",
                  _knob_is_string(s, i), 1)
        }
        i = i + 1
    }
}

fn test_formal_populated() {
    let s = style_registry_lookup("formal")
    let i = 0
    while i < STYLE_SLOT_COUNT {
        if i < STYLE_SHOW_SOURCES {
            ce_eq("formal slot " + int_to_str(i) + " is a string",
                  _knob_is_string(s, i), 1)
        }
        i = i + 1
    }
}

// ---- templater integration: default (regression) ------------------------

fn test_default_style_produces_current_shape() {
    // Persona with empty style_capsule -> "default". Same output any
    // R48p4 caller expects.
    let p = _mk_persona_with_style("")
    let pr = _mk_full_pr()
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("default: Sources cited",   _has(out, "Sources cited"))
    ce_check("default: warn glyph",      _has(out, "⚠"))
    ce_check("default: Persona projection", _has(out, "Persona projection"))
    ce_check("default: Would perform",   _has(out, "Would perform (described, not executed)"))
    ce_check("default: Confidence",      _has(out, "Confidence:"))
    ce_check("default: style: default",  _has(out, "style: default"))
}

// ---- templater integration: terse ---------------------------------------

fn test_terse_style_hides_projection_effectors_trailer() {
    let p = _mk_persona_with_style("terse")
    let pr = _mk_full_pr()
    let out = templater_render_proposal(pr, "grammar", p)
    // Wording differences
    ce_check("terse: 'Sources ('",   _has(out, "Sources ("))
    ce_check("terse: '!' conflict",  _has(out, "! Conflict on 'mars'"))
    ce_check("terse: ascii bullet",  _has(out, "- "))
    // Hidden sections
    ce_eq("no projection line",  _has(out, "Persona projection"),  0)
    ce_eq("no projection alt",   _has(out, "projection:"),         0)
    ce_eq("no would-perform",    _has(out, "would:"),              0)
    ce_eq("no trailer",          _has(out, "Confidence"),          0)
    ce_eq("no default trailer",  _has(out, "style:"),              0)
}

// ---- templater integration: formal --------------------------------------

fn test_formal_style_uses_academic_wording() {
    let p = _mk_persona_with_style("formal")
    let pr = _mk_full_pr()
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("formal: consulted",     _has(out, "Sources consulted"))
    ce_check("formal: posterior",     _has(out, "posterior"))
    ce_check("formal: Note: differ",  _has(out, "Note: the consulted sources differ on 'mars'"))
    ce_check("formal: Advisory",      _has(out, "Advisory factors"))
    ce_check("formal: Proposed actions", _has(out, "Proposed actions (described, awaiting the effector gate)"))
    ce_check("formal: trailer",       _has(out, "-- confidence"))
    ce_check("formal: style name",    _has(out, "style formal"))
}

// ---- refusal wording swaps ---------------------------------------------

fn test_refusal_wording_default() {
    let p = _mk_persona_with_style("")
    let pr = skill_pr_new()
    skill_pr_refuse(pr, "min-confidence: too low")
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("default warn glyph refusal", _has(out, "⚠ Refused: min-confidence"))
}

fn test_refusal_wording_formal() {
    let p = _mk_persona_with_style("formal")
    let pr = skill_pr_new()
    skill_pr_refuse(pr, "min-confidence: too low")
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("formal refusal wording",
             _has(out, "The system declined to answer: min-confidence"))
}

fn test_refusal_wording_terse() {
    let p = _mk_persona_with_style("terse")
    let pr = skill_pr_new()
    skill_pr_refuse(pr, "boom")
    let out = templater_render_proposal(pr, "grammar", p)
    ce_check("terse refusal wording", _has(out, "! refused: boom"))
    // Terse hides the trailer even on refusals.
    ce_eq("no trailer on terse refusal", _has(out, "confidence"), 0)
}

// ---- style-name shows on trailer regardless of source -------------------

fn test_trailer_names_default_even_without_persona() {
    let pr = _mk_full_pr()
    let out = templater_render_proposal(pr, "grammar", 0)
    ce_check("names default", _has(out, "style: default"))
}

fn test_trailer_names_unknown_falls_back_to_default() {
    // Persona names a style that isn't registered. Templater still
    // renders, falling back to default knobs. The trailer name should
    // reflect the WHAT-THE-USER-ASKED-FOR value; the FALLBACK is a
    // runtime detail.
    let p = _mk_persona_with_style("no-such-style")
    let pr = _mk_full_pr()
    let out = templater_render_proposal(pr, "grammar", p)
    // The name in the trailer echoes what the persona said.
    ce_check("trailer names requested style", _has(out, "style: no-such-style"))
    // But the KNOBS came from default -- so we see "Sources cited"
    // (default), not "Sources (" (terse), etc.
    ce_check("default knobs used", _has(out, "Sources cited ("))
}

// ---- determinism --------------------------------------------------------

fn test_terse_deterministic() {
    let p = _mk_persona_with_style("terse")
    let pr = _mk_full_pr()
    let a = templater_render_proposal(pr, "grammar", p)
    let b = templater_render_proposal(pr, "grammar", p)
    ce_check("byte-identical repeat", str_eq_bytes(a, b) == 1)
}

fn test_formal_deterministic() {
    let p = _mk_persona_with_style("formal")
    let pr = _mk_full_pr()
    let a = templater_render_proposal(pr, "grammar", p)
    let b = templater_render_proposal(pr, "grammar", p)
    ce_check("byte-identical repeat", str_eq_bytes(a, b) == 1)
}

fn test_styles_differ_from_each_other() {
    let pr = _mk_full_pr()
    let d = templater_render_proposal(pr, "grammar", _mk_persona_with_style(""))
    let t = templater_render_proposal(pr, "grammar", _mk_persona_with_style("terse"))
    let f = templater_render_proposal(pr, "grammar", _mk_persona_with_style("formal"))
    ce_check("default != terse",  str_eq_bytes(d, t) == 0)
    ce_check("default != formal", str_eq_bytes(d, f) == 0)
    ce_check("terse != formal",   str_eq_bytes(t, f) == 0)
}

// ---- flags respected ---------------------------------------------------

fn test_show_flags_toggle_visibility() {
    // Register a custom style that hides sources only.
    let s = style_default()
    list_set(s, STYLE_NAME, "test-hide-sources")
    list_set(s, STYLE_SHOW_SOURCES, 0)
    style_registry_register(s)
    let p = _mk_persona_with_style("test-hide-sources")
    let pr = _mk_full_pr()
    let out = templater_render_proposal(pr, "grammar", p)
    ce_eq("sources hidden",       _has(out, "Sources cited"), 0)
    ce_check("projection visible", _has(out, "Persona projection"))
    ce_check("trailer visible",    _has(out, "Confidence"))
}

// ---- main --------------------------------------------------------------

fn main() {
    test_registry_ships_three_builtins()
    test_lookup_default_by_empty_and_by_name()
    test_unknown_falls_back_to_default()
    test_is_known_flag()
    test_register_replaces_by_name()
    test_default_populated()
    test_terse_populated()
    test_formal_populated()
    test_default_style_produces_current_shape()
    test_terse_style_hides_projection_effectors_trailer()
    test_formal_style_uses_academic_wording()
    test_refusal_wording_default()
    test_refusal_wording_formal()
    test_refusal_wording_terse()
    test_trailer_names_default_even_without_persona()
    test_trailer_names_unknown_falls_back_to_default()
    test_terse_deterministic()
    test_formal_deterministic()
    test_styles_differ_from_each_other()
    test_show_flags_toggle_visibility()
    ce_summary("style_capsule")
}

main()
