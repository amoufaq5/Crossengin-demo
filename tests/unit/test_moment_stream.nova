// Unit tests for src/parts/episodic/moment_stream.nova
// Verifies moment capture with id assignment, accessors, the status lifecycle
// and post-SETTLED immutability, timestamp monotonicity, recent-window
// retrieval, and settle-by-age. ADR-0021.

import "../ce_test.nova"
import "../../src/parts/episodic/moment_stream.nova"

fn test_capture_and_access() {
    let s = ms_new()
    ce_eq("empty", ms_count(s), 0)
    let m = ms_capture(s, 5, MODALITY_TEXT, "hello", 700, 3)
    ce_eq("id 0", moment_id(m), 0)
    ce_eq("timestamp", moment_timestamp(m), 5)
    ce_eq("modality", moment_modality(m), MODALITY_TEXT)
    ce_str_eq("raw", moment_raw(m), "hello")
    ce_eq("salience", moment_salience(m), 700)
    ce_eq("origin", moment_origin(m), 3)
    ce_eq("starts perceived", moment_status(m), MSTAT_PERCEIVED)
    let m2 = ms_capture(s, 6, MODALITY_INTERNAL, "x", 100, 0)
    ce_eq("second id", moment_id(m2), 1)
    ce_eq("count 2", ms_count(s), 2)
    ce_str_eq("get by id", moment_raw(ms_get(s, 0)), "hello")
    ce_eq("get bad id -> 0", ms_get(s, 99), 0)
}

fn test_status_and_immutability() {
    let s = ms_new()
    let m = ms_capture(s, 1, MODALITY_TEXT, "x", 500, 0)
    ce_eq("trace while perceived", moment_add_trace(m, 42), 1)
    ce_eq("settle advances", moment_settle(m), 1)
    ce_eq("now settled", moment_status(m), MSTAT_SETTLED)
    ce_eq("immutable after settle", moment_is_immutable(m), 1)
    // Post-SETTLED writes are rejected.
    ce_eq("no trace after settle", moment_add_trace(m, 7), 0)
    ce_eq("cannot regress status", moment_set_status(m, MSTAT_PERCEIVED), 0)
    ce_eq("consolidate advances", moment_consolidate(m), 1)
    ce_eq("consolidated", moment_status(m), MSTAT_CONSOLIDATED)
    ce_eq("trace preserved", len(moment_trace(m)), 1)
}

fn test_monotonic_and_recent() {
    let s = ms_new()
    ms_capture(s, 10, MODALITY_TEXT, "a", 0, 0)
    // A backwards timestamp is clamped to maintain monotonicity.
    let m = ms_capture(s, 4, MODALITY_TEXT, "b", 0, 0)
    ce_eq("timestamp clamped monotonic", moment_timestamp(m), 10)
    ms_capture(s, 12, MODALITY_TEXT, "c", 0, 0)
    let recent = ms_recent(s, 2)
    ce_eq("recent window size", len(recent), 2)
    ce_str_eq("recent oldest-first", moment_raw(recent[0]), "b")
    ce_str_eq("recent newest", moment_raw(recent[1]), "c")
    ce_eq("recent more than total", len(ms_recent(s, 99)), 3)
}

fn test_settle_old() {
    let s = ms_new()
    ms_capture(s, 0, MODALITY_TEXT, "old", 0, 0)
    ms_capture(s, 0, MODALITY_TEXT, "old2", 0, 0)
    // At now=25, both are older than the 20-tick settle window.
    ce_eq("settled two old", ms_settle_old(s, 25), 2)
    ce_eq("first settled", moment_status(ms_get(s, 0)), MSTAT_SETTLED)
    // A fresh moment within the window is not settled.
    ms_capture(s, 25, MODALITY_TEXT, "fresh", 0, 0)
    ce_eq("fresh not settled", ms_settle_old(s, 30), 0)
}

fn main() {
    test_capture_and_access()
    test_status_and_immutability()
    test_monotonic_and_recent()
    test_settle_old()
    ce_summary("moment_stream")
}

main()
