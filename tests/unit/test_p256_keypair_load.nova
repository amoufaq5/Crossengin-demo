// Unit tests for src/safety/p256_keypair.nova (Phase O R3, ADR-0096).
//
// Coverage (~25 checks):
//   * Missing .priv / .pub -> load returns 0.
//   * Null / empty base_path -> load returns 0.
//   * Wrong-size .priv (31 or 33 bytes) -> load returns 0.
//   * Wrong-size .pub (64 or 66 bytes) -> load returns 0.
//   * Bad SEC1 tag byte (compressed 0x02 in a 65-byte pub) -> load returns 0.
//   * Round-trip: save + load returns bit-identical priv scalar + on-curve pub.
//   * Deterministic generator -> same seed produces same priv/pub across calls.
//   * Different seeds produce different priv scalars.
//   * `p256_keypair_valid` accepts a fresh-generated pair.
//   * `p256_keypair_valid` rejects a null pair / wrong-arity pair.
//
// Fixtures live under $HOME (or ./_p256k_test_o_r3 when HOME is unset)
// with a per-test filename prefix so no mkdir is required.

import "../ce_test.nova"
import "../../src/safety/p256_keypair.nova"
import "std/syscall"
import "std/string"
import "std/io"

fn _base() {
    let home = getenv("HOME")
    if home != 0 {
        if len(home) > 0 { return home }
    }
    return "."
}

// Per-test base path. Prefixed so grep cleanup is trivial.
fn _tpath(name) {
    return _base() + "/.crossengin_ph_o_r3_p256k_" + name
}

// Build a 32-byte deterministic seed (byte i = start + i mod 256).
fn _mk_seed_32(start) {
    let buf = alloc(33)
    let i = 0
    while i < 32 {
        store8(buf + i, int_and(start + i, 255))
        i = i + 1
    }
    store8(buf + 32, 0)
    return buf
}

// Write a raw byte buffer of length n to `path`. Uses NOVA's write_file
// helper (same one test_truststore_dir uses). write_file takes a string
// so we build one via char concatenation. Only used for the negative
// tests that need wrong-size files; the round-trip test uses
// p256_keypair_save.
fn _write_raw(path, n, seed_byte) {
    let s = ""
    let i = 0
    while i < n {
        s = s + chr(int_and(seed_byte + i, 255))
        i = i + 1
    }
    write_file(path, s)
    return 1
}

// ---- negative loader paths -----------------------------------------------

fn test_load_null_base() {
    ce_eq("null base -> 0", p256_keypair_load(0), 0)
}

fn test_load_empty_base() {
    ce_eq("empty base -> 0", p256_keypair_load(""), 0)
}

fn test_load_missing_files() {
    let base = _tpath("missing")
    // No files exist under this path.
    ce_eq("missing .priv+.pub -> 0", p256_keypair_load(base), 0)
}

fn test_load_wrong_size_priv_31b() {
    let base = _tpath("badpriv31")
    _write_raw(base + ".priv", 31, 7)
    _write_raw(base + ".pub", 65, 9)  // content is wrong but size right
    ce_eq("priv 31 bytes -> 0", p256_keypair_load(base), 0)
}

fn test_load_wrong_size_priv_33b() {
    let base = _tpath("badpriv33")
    _write_raw(base + ".priv", 33, 7)
    _write_raw(base + ".pub", 65, 9)
    ce_eq("priv 33 bytes -> 0", p256_keypair_load(base), 0)
}

fn test_load_wrong_size_pub_64b() {
    let base = _tpath("badpub64")
    _write_raw(base + ".priv", 32, 7)
    _write_raw(base + ".pub", 64, 9)
    ce_eq("pub 64 bytes -> 0", p256_keypair_load(base), 0)
}

fn test_load_wrong_size_pub_66b() {
    let base = _tpath("badpub66")
    _write_raw(base + ".priv", 32, 7)
    _write_raw(base + ".pub", 66, 9)
    ce_eq("pub 66 bytes -> 0", p256_keypair_load(base), 0)
}

fn test_load_bad_sec1_tag() {
    // 65-byte pub file whose first byte is 0x02 (compressed tag; wrong
    // for a 65-byte buffer -- compressed points are 33 bytes). The
    // decoder must reject.
    let base = _tpath("badtag")
    _write_raw(base + ".priv", 32, 1)
    // First byte 0x02, then 64 filler bytes.
    let s = chr(2)
    let i = 0
    while i < 64 {
        s = s + chr(int_and(i + 3, 255))
        i = i + 1
    }
    write_file(base + ".pub", s)
    ce_eq("bad SEC1 tag byte -> 0", p256_keypair_load(base), 0)
}

// ---- deterministic generator + save/load round trip ---------------------

fn test_deterministic_generate_same_seed() {
    let seed = _mk_seed_32(1)
    let a = p256_keypair_generate_deterministic(seed)
    let b = p256_keypair_generate_deterministic(seed)
    ce_check("gen a non-zero", a != 0)
    ce_check("gen b non-zero", b != 0)
    // Both pairs have the same priv scalar (bn256 array equality).
    ce_eq("same seed -> same priv[0]", a[0][0], b[0][0])
    ce_eq("same seed -> same priv[7]", a[0][7], b[0][7])
    // And the same pub X coordinate.
    ce_eq("same seed -> same pub X[0]", a[1][0][0], b[1][0][0])
}

fn test_deterministic_generate_different_seeds() {
    let a = p256_keypair_generate_deterministic(_mk_seed_32(1))
    let b = p256_keypair_generate_deterministic(_mk_seed_32(200))
    ce_check("gen a non-zero", a != 0)
    ce_check("gen b non-zero", b != 0)
    // Different seeds should produce different priv scalars (with
    // overwhelming probability; SHA-256 differ + mod n-1 preserves the
    // difference for these two obviously-distinct inputs).
    let same = 1
    if a[0][0] != b[0][0] { same = 0 }
    if a[0][7] != b[0][7] { same = 0 }
    ce_eq("different seed -> different priv (bytewise)", same, 0)
}

fn test_save_load_roundtrip() {
    let base = _tpath("roundtrip")
    let seed = _mk_seed_32(42)
    let pair_in = p256_keypair_generate_deterministic(seed)
    ce_check("gen non-zero", pair_in != 0)
    let saved = p256_keypair_save(base, pair_in[0], pair_in[1])
    ce_eq("save returns 1", saved, 1)
    let pair_out = p256_keypair_load(base)
    ce_check("load non-zero", pair_out != 0)
    // priv scalar limbs identical.
    let i = 0
    let same_priv = 1
    while i < 8 {
        if pair_in[0][i] != pair_out[0][i] { same_priv = 0 }
        i = i + 1
    }
    ce_eq("priv scalar round-trips", same_priv, 1)
    // pub X coordinate limb-0 identical (full 8-limb equality is
    // implicit -- the SEC1 encoding encodes the whole point).
    ce_eq("pub X[0] round-trips",
          pair_in[1][0][0], pair_out[1][0][0])
    ce_eq("pub Y[0] round-trips",
          pair_in[1][1][0], pair_out[1][1][0])
}

// ---- p256_keypair_valid ---------------------------------------------------

fn test_valid_accepts_fresh_pair() {
    let pair = p256_keypair_generate_deterministic(_mk_seed_32(99))
    ce_check("fresh pair non-zero", pair != 0)
    ce_eq("valid accepts fresh pair", p256_keypair_valid(pair), 1)
}

fn test_valid_rejects_null() {
    ce_eq("valid(0) -> 0", p256_keypair_valid(0), 0)
}

fn test_valid_rejects_wrong_arity() {
    // A list of length 1 is not a keypair.
    let bad = list_new()
    push(bad, 0)
    ce_eq("valid on 1-element list -> 0", p256_keypair_valid(bad), 0)
}

fn test_save_null_priv() {
    let base = _tpath("save_null_priv")
    let pair = p256_keypair_generate_deterministic(_mk_seed_32(3))
    ce_eq("save with null priv -> 0",
          p256_keypair_save(base, 0, pair[1]), 0)
}

fn test_save_null_pub() {
    let base = _tpath("save_null_pub")
    let pair = p256_keypair_generate_deterministic(_mk_seed_32(4))
    ce_eq("save with null pub -> 0",
          p256_keypair_save(base, pair[0], 0), 0)
}

fn test_save_empty_base() {
    let pair = p256_keypair_generate_deterministic(_mk_seed_32(5))
    ce_eq("save with empty base -> 0",
          p256_keypair_save("", pair[0], pair[1]), 0)
}

fn test_load_null_pair_on_missing_pub_after_priv() {
    let base = _tpath("halfpair")
    _write_raw(base + ".priv", 32, 5)
    // No .pub file written. Load must not crash.
    ce_eq("half-pair (priv only) -> 0", p256_keypair_load(base), 0)
}

fn test_gen_null_seed() {
    ce_eq("generate_deterministic(0) -> 0",
          p256_keypair_generate_deterministic(0), 0)
}

fn main() {
    test_load_null_base()
    test_load_empty_base()
    test_load_missing_files()
    test_load_wrong_size_priv_31b()
    test_load_wrong_size_priv_33b()
    test_load_wrong_size_pub_64b()
    test_load_wrong_size_pub_66b()
    test_load_bad_sec1_tag()
    test_deterministic_generate_same_seed()
    test_deterministic_generate_different_seeds()
    test_save_load_roundtrip()
    test_valid_accepts_fresh_pair()
    test_valid_rejects_null()
    test_valid_rejects_wrong_arity()
    test_save_null_priv()
    test_save_null_pub()
    test_save_empty_base()
    test_load_null_pair_on_missing_pub_after_priv()
    test_gen_null_seed()
    ce_summary("p256_keypair_load")
}

main()
