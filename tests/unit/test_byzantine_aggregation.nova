// Unit tests for src/learning/byzantine_aggregation.nova (P3.10 / ADR-0056).
//
// Coverage:
//   - byz_trimmed_mean with trim_k=0 reduces to plain mean.
//   - byz_trimmed_mean with trim_k=1 drops one outlier from each end.
//   - byz_trimmed_mean is robust to a single 100x poisoning outlier.
//   - byz_coordinate_median picks the middle value (odd n) or the
//     average of two middle (even n).
//   - byz_coordinate_median is robust to a single 100x poisoning
//     outlier (median is unaffected when honest count > n/2).
//   - Multi-dim updates aggregate coordinate-wise.
//   - Edge cases: 0 participants -> empty vector; 1 participant ->
//     passthrough; 2 participants -> mean (trimmed) / average
//     (median).
//   - byz_strategy_from_env / byz_trim_k_from_env env parsers.
//   - byz_aggregate dispatch routes BYZ_NONE / TRIMMED / MEDIAN
//     correctly and produces bit-identical results to the direct
//     calls.
//   - fed_acc_byz_* integration with the federated accumulator.

import "../ce_test.nova"
import "../../src/learning/byzantine_aggregation.nova"
import "../../src/learning/federated_aggregator.nova"

// ---- helpers --------------------------------------------------------------

// Build a list of single-coord updates from a comma-style int sequence.
// We don't have varargs; instead callers build lists explicitly.
fn _vec1(a) {
    let v = list_new()
    push(v, a)
    return v
}

fn _vec3(a, b, c) {
    let v = list_new()
    push(v, a)
    push(v, b)
    push(v, c)
    return v
}

// ---- byz_trimmed_mean tests ----------------------------------------------

fn test_trimmed_mean_k0_plain_mean() {
    // [10, 11, 12, 9, 11] with trim_k = 0 -> (10+11+12+9+11)/5 = 53/5 = 10
    // (integer division -- 53/5 = 10 in NOVA).
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(11))
    let agg = byz_trimmed_mean(ups, 0)
    ce_eq("trimmed_mean k=0 len", len(agg), 1)
    ce_eq("trimmed_mean k=0 value", agg[0], 10)
}

fn test_trimmed_mean_k1_drops_extremes() {
    // [10, 11, 12, 9, 11] sorted -> [9, 10, 11, 11, 12]
    // trim_k=1 drops 9 and 12 -> mean of [10, 11, 11] = 32 / 3 = 10
    // (NOVA int div: 32/3 = 10).
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(11))
    let agg = byz_trimmed_mean(ups, 1)
    ce_eq("trimmed_mean k=1 len", len(agg), 1)
    ce_eq("trimmed_mean k=1 drops extremes", agg[0], 10)
}

fn test_trimmed_mean_robust_to_poisoning() {
    // [10, 11, 12, 9, 1000] with trim_k=1.
    // Sorted: [9, 10, 11, 12, 1000].
    // Drop 9 and 1000 -> mean of [10, 11, 12] = 33/3 = 11.
    // With BYZ_NONE the poisoned mean would be (10+11+12+9+1000)/5 = 208,
    // so the test asserts BOTH the robust value AND the unrobust
    // pollution to make the contrast load-bearing.
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(1000))
    let agg_byz = byz_trimmed_mean(ups, 1)
    ce_eq("trimmed_mean robust to 100x outlier", agg_byz[0], 11)
    // For contrast: plain mean (BYZ_NONE) is heavily skewed.
    let agg_none = byz_aggregate(ups, BYZ_NONE, 0)
    ce_eq("plain mean is poisoned by outlier", agg_none[0], 208)
}

fn test_trimmed_mean_robust_to_negative_poisoning() {
    // [10, 11, 12, 9, 0 - 1000]. Sorted: [-1000, 9, 10, 11, 12].
    // trim_k=1 drops -1000 and 12 -> mean of [9, 10, 11] = 30/3 = 10.
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(0 - 1000))
    let agg = byz_trimmed_mean(ups, 1)
    ce_eq("trimmed_mean robust to negative outlier", agg[0], 10)
}

fn test_trimmed_mean_multidim() {
    // 5 participants, 3-coord vectors. Coord 0: same as the 1d test.
    // Coord 1: [20, 21, 22, 19, 21] -> sorted [19, 20, 21, 21, 22];
    //   trim_k=1 drops 19, 22 -> mean of [20, 21, 21] = 62/3 = 20.
    // Coord 2 contains a poisoning on participant 4: [30, 31, 32, 29, 9999];
    //   trim_k=1 drops 29, 9999 -> mean of [30, 31, 32] = 93/3 = 31.
    let ups = list_new()
    push(ups, _vec3(10, 20, 30))
    push(ups, _vec3(11, 21, 31))
    push(ups, _vec3(12, 22, 32))
    push(ups, _vec3(9,  19, 29))
    push(ups, _vec3(11, 21, 9999))
    let agg = byz_trimmed_mean(ups, 1)
    ce_eq("multidim len = 3", len(agg), 3)
    ce_eq("multidim coord 0", agg[0], 10)
    ce_eq("multidim coord 1", agg[1], 20)
    ce_eq("multidim coord 2 robust to poison", agg[2], 31)
}

// ---- byz_coordinate_median tests ----------------------------------------

fn test_median_odd_n() {
    // [10, 11, 12, 9, 11] sorted -> [9, 10, 11, 11, 12], median = idx 2 = 11.
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(11))
    let agg = byz_coordinate_median(ups)
    ce_eq("median odd n", agg[0], 11)
}

fn test_median_robust_to_poisoning() {
    // [10, 11, 12, 9, 1000] sorted -> [9, 10, 11, 12, 1000], median = 11.
    // The 100x outlier moves to the right end -- median unaffected.
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(1000))
    let agg = byz_coordinate_median(ups)
    ce_eq("median robust to 100x outlier", agg[0], 11)
}

fn test_median_robust_to_two_poisonings() {
    // [10, 11, 12, 1000, 2000] sorted -> [10, 11, 12, 1000, 2000].
    // Median = idx 2 = 12. Even with 2 poisonings out of 5, the
    // median sits on the honest cluster.
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(1000))
    push(ups, _vec1(2000))
    let agg = byz_coordinate_median(ups)
    ce_eq("median robust to 2-of-5 poisoning", agg[0], 12)
}

fn test_median_even_n_averages_middle_two() {
    // [10, 12, 14, 16] sorted -> [10, 12, 14, 16], middle two = 12 + 14
    // average = 26 / 2 = 13.
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(12))
    push(ups, _vec1(14))
    push(ups, _vec1(16))
    let agg = byz_coordinate_median(ups)
    ce_eq("median even n", agg[0], 13)
}

fn test_median_multidim() {
    // Per-coord median across 5 participants.
    // Coord 0: median of [10, 11, 12, 9, 11] = 11.
    // Coord 1: median of [20, 21, 22, 19, 21] = 21.
    // Coord 2: median of [30, 31, 32, 29, 9999] = 31 (poison ignored).
    let ups = list_new()
    push(ups, _vec3(10, 20, 30))
    push(ups, _vec3(11, 21, 31))
    push(ups, _vec3(12, 22, 32))
    push(ups, _vec3(9,  19, 29))
    push(ups, _vec3(11, 21, 9999))
    let agg = byz_coordinate_median(ups)
    ce_eq("median multidim len", len(agg), 3)
    ce_eq("median coord 0", agg[0], 11)
    ce_eq("median coord 1", agg[1], 21)
    ce_eq("median coord 2 robust to poison", agg[2], 31)
}

// ---- edge cases ----------------------------------------------------------

fn test_trimmed_mean_empty() {
    let ups = list_new()
    let agg = byz_trimmed_mean(ups, 1)
    ce_eq("trimmed_mean empty -> empty", len(agg), 0)
}

fn test_median_empty() {
    let ups = list_new()
    let agg = byz_coordinate_median(ups)
    ce_eq("median empty -> empty", len(agg), 0)
}

fn test_trimmed_mean_single_participant() {
    let ups = list_new()
    push(ups, _vec3(42, 43, 44))
    let agg = byz_trimmed_mean(ups, 1)
    ce_eq("single len = 3", len(agg), 3)
    ce_eq("single passthrough coord 0", agg[0], 42)
    ce_eq("single passthrough coord 1", agg[1], 43)
    ce_eq("single passthrough coord 2", agg[2], 44)
}

fn test_median_single_participant() {
    let ups = list_new()
    push(ups, _vec1(42))
    let agg = byz_coordinate_median(ups)
    ce_eq("median single len", len(agg), 1)
    ce_eq("median single value", agg[0], 42)
}

fn test_trimmed_mean_two_participants_k0() {
    // trim_k = 0 -> plain mean (10 + 14)/2 = 12
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(14))
    let agg = byz_trimmed_mean(ups, 0)
    ce_eq("two k0 mean", agg[0], 12)
}

fn test_trimmed_mean_degenerate_trim_k() {
    // trim_k=1 with n=2 would drop everything -> we return zeros of the
    // right shape rather than crash.
    let ups = list_new()
    push(ups, _vec3(10, 20, 30))
    push(ups, _vec3(14, 24, 34))
    let agg = byz_trimmed_mean(ups, 1)
    ce_eq("degenerate trim len", len(agg), 3)
    ce_eq("degenerate trim 0s coord 0", agg[0], 0)
    ce_eq("degenerate trim 0s coord 1", agg[1], 0)
    ce_eq("degenerate trim 0s coord 2", agg[2], 0)
}

fn test_median_two_participants() {
    // n=2 -> average of the two = (10+14)/2 = 12
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(14))
    let agg = byz_coordinate_median(ups)
    ce_eq("two median", agg[0], 12)
}

// ---- env helpers ---------------------------------------------------------

fn test_strategy_from_env_default() {
    ce_eq("env unset -> BYZ_NONE", byz_strategy_from_env(), BYZ_NONE)
}

fn test_strategy_name() {
    ce_str_eq("name BYZ_NONE",
        byz_strategy_name(BYZ_NONE), "none")
    ce_str_eq("name BYZ_TRIMMED_MEAN",
        byz_strategy_name(BYZ_TRIMMED_MEAN), "trimmed")
    ce_str_eq("name BYZ_MEDIAN",
        byz_strategy_name(BYZ_MEDIAN), "median")
    ce_str_eq("name unknown -> none",
        byz_strategy_name(999), "none")
}

fn test_trim_k_from_env_default() {
    // Env unset -> caller default.
    ce_eq("trim_k default 1", byz_trim_k_from_env(1), 1)
    ce_eq("trim_k default 2", byz_trim_k_from_env(2), 2)
}

// ---- dispatch ------------------------------------------------------------

fn test_dispatch_none_equals_plain_mean() {
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(11))
    // BYZ_NONE -> plain mean = 53/5 = 10
    let agg = byz_aggregate(ups, BYZ_NONE, 1)
    ce_eq("dispatch NONE = plain mean", agg[0], 10)
}

fn test_dispatch_trimmed_routes_correctly() {
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(1000))
    let via_dispatch = byz_aggregate(ups, BYZ_TRIMMED_MEAN, 1)
    let via_direct = byz_trimmed_mean(ups, 1)
    ce_eq("dispatch TRIMMED = direct call",
        via_dispatch[0], via_direct[0])
    ce_eq("dispatch TRIMMED yields 11", via_dispatch[0], 11)
}

fn test_dispatch_median_routes_correctly() {
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(11))
    push(ups, _vec1(12))
    push(ups, _vec1(9))
    push(ups, _vec1(1000))
    let via_dispatch = byz_aggregate(ups, BYZ_MEDIAN, 0)
    let via_direct = byz_coordinate_median(ups)
    ce_eq("dispatch MEDIAN = direct call",
        via_dispatch[0], via_direct[0])
    ce_eq("dispatch MEDIAN yields 11", via_dispatch[0], 11)
}

fn test_dispatch_unknown_strategy_safe() {
    let ups = list_new()
    push(ups, _vec1(10))
    push(ups, _vec1(20))
    // Unknown strategy falls back to plain mean = 15.
    let agg = byz_aggregate(ups, 999, 1)
    ce_eq("unknown strategy -> plain mean", agg[0], 15)
}

// ---- constants -----------------------------------------------------------

fn test_strategy_constants_distinct() {
    ce_check("NONE != TRIMMED",   BYZ_NONE != BYZ_TRIMMED_MEAN)
    ce_check("NONE != MEDIAN",    BYZ_NONE != BYZ_MEDIAN)
    ce_check("TRIMMED != MEDIAN", BYZ_TRIMMED_MEAN != BYZ_MEDIAN)
    ce_eq("BYZ_DEFAULT_TRIM_K", BYZ_DEFAULT_TRIM_K, 1)
}

// ---- fed_acc_byz_* integration (P3.10) -----------------------------------

fn test_fed_acc_byz_new_empty() {
    let a = fed_acc_byz_new(7)
    ce_check("fed_acc_byz_new non-zero", a != 0)
    ce_eq("fed_acc_byz round_id wired", fed_acc_byz_round_id(a), 7)
    ce_eq("fed_acc_byz count starts at 0", fed_acc_byz_count(a), 0)
}

fn test_fed_acc_byz_add_stat_groups_by_tag() {
    let a = fed_acc_byz_new(1)
    // Two souls contribute to topic:fever; one soul contributes to topic:headache.
    fed_acc_byz_add_stat(a, "topic:fever",   700, 200)
    fed_acc_byz_add_stat(a, "topic:fever",   720, 210)
    fed_acc_byz_add_stat(a, "topic:headache", 300, 600)
    ce_eq("two distinct tags", fed_acc_byz_count(a), 2)
    ce_eq("fever has 2 participants", fed_acc_byz_part_count(a, "topic:fever"), 2)
    ce_eq("headache has 1 participant", fed_acc_byz_part_count(a, "topic:headache"), 1)
    ce_eq("unknown tag = 0", fed_acc_byz_part_count(a, "topic:bogus"), 0)
}

fn test_fed_acc_byz_aggregate_none_matches_plain_mean() {
    let a = fed_acc_byz_new(1)
    fed_acc_byz_add_stat(a, "topic:fever", 700, 200)
    fed_acc_byz_add_stat(a, "topic:fever", 720, 210)
    fed_acc_byz_add_stat(a, "topic:fever", 710, 205)
    let agg = fed_acc_byz_aggregate(a, BYZ_NONE, 0)
    ce_eq("1 source", len(agg), 1)
    ce_str_eq("source tag", agg[0][0], "topic:fever")
    // Plain mean: promo = (700+720+710)/3 = 2130/3 = 710
    // Plain mean: atr   = (200+210+205)/3 = 615/3 = 205
    ce_eq("plain mean promo", agg[0][1], 710)
    ce_eq("plain mean atr", agg[0][2], 205)
    ce_eq("plain mean n_part", agg[0][3], 3)
}

fn test_fed_acc_byz_aggregate_trimmed_filters_outlier() {
    let a = fed_acc_byz_new(1)
    // 5 souls; one poisoned with 100x value.
    fed_acc_byz_add_stat(a, "topic:fever", 700, 200)
    fed_acc_byz_add_stat(a, "topic:fever", 710, 210)
    fed_acc_byz_add_stat(a, "topic:fever", 720, 220)
    fed_acc_byz_add_stat(a, "topic:fever", 690, 190)
    fed_acc_byz_add_stat(a, "topic:fever", 9999, 9999)
    let agg = fed_acc_byz_aggregate(a, BYZ_TRIMMED_MEAN, 1)
    // promo sorted [690, 700, 710, 720, 9999]; trim_k=1 -> mean of
    // [700, 710, 720] = 2130/3 = 710.
    // atr   sorted [190, 200, 210, 220, 9999]; trim_k=1 -> mean of
    // [200, 210, 220] = 630/3 = 210.
    ce_eq("trimmed promo filters poison", agg[0][1], 710)
    ce_eq("trimmed atr filters poison", agg[0][2], 210)
    ce_eq("trimmed n_part (raw, not post-trim)", agg[0][3], 5)
}

fn test_fed_acc_byz_aggregate_median_filters_outlier() {
    let a = fed_acc_byz_new(1)
    fed_acc_byz_add_stat(a, "topic:fever", 700, 200)
    fed_acc_byz_add_stat(a, "topic:fever", 710, 210)
    fed_acc_byz_add_stat(a, "topic:fever", 720, 220)
    fed_acc_byz_add_stat(a, "topic:fever", 690, 190)
    fed_acc_byz_add_stat(a, "topic:fever", 9999, 9999)
    let agg = fed_acc_byz_aggregate(a, BYZ_MEDIAN, 0)
    // promo sorted [690, 700, 710, 720, 9999]; median = 710.
    // atr   sorted [190, 200, 210, 220, 9999]; median = 210.
    ce_eq("median promo filters poison", agg[0][1], 710)
    ce_eq("median atr filters poison", agg[0][2], 210)
}

fn test_fed_acc_byz_aggregate_multi_source() {
    let a = fed_acc_byz_new(1)
    // Three souls; one source per soul with different poisoning.
    fed_acc_byz_add_stat(a, "src:a", 100, 50)
    fed_acc_byz_add_stat(a, "src:a", 110, 60)
    fed_acc_byz_add_stat(a, "src:a", 9999, 9999)
    fed_acc_byz_add_stat(a, "src:b", 800, 400)
    fed_acc_byz_add_stat(a, "src:b", 820, 410)
    fed_acc_byz_add_stat(a, "src:b", 9999, 9999)
    let agg = fed_acc_byz_aggregate(a, BYZ_MEDIAN, 0)
    ce_eq("two sources reduced", len(agg), 2)
    // Per-source median (odd n=3): a -> [100, 110, 9999] median 110;
    // b -> [800, 820, 9999] median 820.
    let i = 0
    let found_a = 0
    let found_b = 0
    while i < len(agg) {
        let row = agg[i]
        if str_eq(row[0], "src:a") == 1 {
            ce_eq("src:a median promo", row[1], 110)
            ce_eq("src:a median atr", row[2], 60)
            found_a = 1
        }
        if str_eq(row[0], "src:b") == 1 {
            ce_eq("src:b median promo", row[1], 820)
            ce_eq("src:b median atr", row[2], 410)
            found_b = 1
        }
        i = i + 1
    }
    ce_check("src:a found in agg", found_a == 1)
    ce_check("src:b found in agg", found_b == 1)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_trimmed_mean_k0_plain_mean()
    test_trimmed_mean_k1_drops_extremes()
    test_trimmed_mean_robust_to_poisoning()
    test_trimmed_mean_robust_to_negative_poisoning()
    test_trimmed_mean_multidim()
    test_median_odd_n()
    test_median_robust_to_poisoning()
    test_median_robust_to_two_poisonings()
    test_median_even_n_averages_middle_two()
    test_median_multidim()
    test_trimmed_mean_empty()
    test_median_empty()
    test_trimmed_mean_single_participant()
    test_median_single_participant()
    test_trimmed_mean_two_participants_k0()
    test_trimmed_mean_degenerate_trim_k()
    test_median_two_participants()
    test_strategy_from_env_default()
    test_strategy_name()
    test_trim_k_from_env_default()
    test_dispatch_none_equals_plain_mean()
    test_dispatch_trimmed_routes_correctly()
    test_dispatch_median_routes_correctly()
    test_dispatch_unknown_strategy_safe()
    test_strategy_constants_distinct()
    test_fed_acc_byz_new_empty()
    test_fed_acc_byz_add_stat_groups_by_tag()
    test_fed_acc_byz_aggregate_none_matches_plain_mean()
    test_fed_acc_byz_aggregate_trimmed_filters_outlier()
    test_fed_acc_byz_aggregate_median_filters_outlier()
    test_fed_acc_byz_aggregate_multi_source()
    ce_summary("byzantine_aggregation")
}
main()
