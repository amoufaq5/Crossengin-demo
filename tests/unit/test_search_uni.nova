// Unit tests for src/mind/search_uni.nova: unification-driven backward search
// that DISCOVERS instantiations. Every "found" result is kernel-confirmed via
// su_solve_ok; the soundness property is that an unprovable goal yields 0.

import "../ce_test.nova"
import "../../src/mind/search_uni.nova"

fn _prem2(a, b) { let l = list_new() push(l, a) push(l, b) return l }

// The headline: Socrates, with NO hint about the witness. The search unifies
// mortal(x) with mortal(socrates), discovers x:=socrates, instantiates the law,
// and proves it -- kernel-confirmed.
fn test_socrates_discovered() {
    let reg = proof_registry_new()
    let law = term_forall("x", term_imp(term_pred("human", term_var("x")),
                                        term_pred("mortal", term_var("x"))))
    let fact = term_pred("human", term_atom("socrates"))
    let goal = term_pred("mortal", term_atom("socrates"))
    let premises = _prem2(law, fact)
    ce_eq("discovers x:=socrates and proves mortal(socrates)",
        su_solve_ok(reg, premises, goal, 5), 1)
}

// Direct universal instantiation: forall x.P(x) |- P(a), discovered.
fn test_direct_universal() {
    let reg = proof_registry_new()
    let law = term_forall("x", term_pred("P", term_var("x")))
    let goal = term_pred("P", term_atom("a"))
    let premises = list_new() push(premises, law)
    ce_eq("forall x.P(x) |- P(a) discovered",
        su_solve_ok(reg, premises, goal, 3), 1)
}

// A two-step chain of universal laws, both instantiations discovered:
// forall x.(a(x)->b(x)), forall x.(b(x)->c(x)), a(s) |- c(s).
fn test_chained_discovery() {
    let reg = proof_registry_new()
    let law1 = term_forall("x", term_imp(term_pred("a", term_var("x")),
                                         term_pred("b", term_var("x"))))
    let law2 = term_forall("x", term_imp(term_pred("b", term_var("x")),
                                         term_pred("c", term_var("x"))))
    let fact = term_pred("a", term_atom("s"))
    let goal = term_pred("c", term_atom("s"))
    let premises = list_new()
    push(premises, law1) push(premises, law2) push(premises, fact)
    ce_eq("a(s) + two laws |- c(s)", su_solve_ok(reg, premises, goal, 5), 1)
}

// Soundness: an unprovable goal yields no proof. mortal(plato) has no human
// fact, so it cannot be derived.
fn test_unprovable() {
    let reg = proof_registry_new()
    let law = term_forall("x", term_imp(term_pred("human", term_var("x")),
                                        term_pred("mortal", term_var("x"))))
    let fact = term_pred("human", term_atom("socrates"))
    let premises = _prem2(law, fact)
    let goal = term_pred("mortal", term_atom("plato"))   // no human(plato)
    ce_eq("mortal(plato) not derivable", su_solve(premises, goal, 5), 0)
    ce_eq("...and su_solve_ok agrees", su_solve_ok(reg, premises, goal, 5), 0)
}

// A goal whose predicate matches no law/fact yields 0 (no false proof).
fn test_no_matching_predicate() {
    let reg = proof_registry_new()
    let law = term_forall("x", term_pred("P", term_var("x")))
    let premises = list_new() push(premises, law)
    let goal = term_pred("Q", term_atom("a"))   // Q, not P
    ce_eq("Q(a) not derivable from forall x.P(x)",
        su_solve_ok(reg, premises, goal, 3), 0)
}

fn main() {
    test_socrates_discovered()
    test_direct_universal()
    test_chained_discovery()
    test_unprovable()
    test_no_matching_predicate()
    ce_summary("search_uni")
}

main()
