// Unit tests for the R111 override_wire volitional-layer wrapper.
//
// Coverage focus is the wrapper's contract in isolation from the wire
// (the wire verbs get their own test file). Direct calls to override
// mechanism fns confirm the underlying primitives still fire; wrapper
// state (entries + snapshot slots + rate budget) is inspected via the
// public accessors.

import "../ce_test.nova"
import "../../src/parts/meta/override_wire.nova"
import "../../src/safety/override_mechanism.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/parts/goals/goal_engine.nova"
import "../../src/util/str_safe.nova"

// ---- action-name bijection ------------------------------------------------

fn test_action_name_roundtrip() {
    ce_eq("belief_edit int",   OVW_ACT_BELIEF_EDIT, 1)
    ce_eq("goal_veto int",     OVW_ACT_GOAL_VETO,   2)
    ce_eq("hard_stop int",     OVW_ACT_HARD_STOP,   3)
    ce_eq("resume int",        OVW_ACT_RESUME,      4)
    ce_eq("kill_switch int",   OVW_ACT_KILL_SWITCH, 5)
    ce_eq("undo int",          OVW_ACT_UNDO,        6)
    // Names -> ints.
    ce_eq("name belief_edit",  ovw_action_from_name("belief_edit"), OVW_ACT_BELIEF_EDIT)
    ce_eq("name goal_veto",    ovw_action_from_name("goal_veto"),   OVW_ACT_GOAL_VETO)
    ce_eq("name hard_stop",    ovw_action_from_name("hard_stop"),   OVW_ACT_HARD_STOP)
    ce_eq("name resume",       ovw_action_from_name("resume"),      OVW_ACT_RESUME)
    ce_eq("name kill_switch",  ovw_action_from_name("kill_switch"), OVW_ACT_KILL_SWITCH)
    ce_eq("name undo",         ovw_action_from_name("undo"),        OVW_ACT_UNDO)
    ce_eq("name unknown -> 0", ovw_action_from_name("wat"),         0)
    ce_eq("name empty -> 0",   ovw_action_from_name(""),            0)
    // Ints -> names.
    ce_check("name belief_edit str",  str_eq_bytes(ovw_action_name(OVW_ACT_BELIEF_EDIT), "belief_edit") == 1)
    ce_check("name goal_veto str",    str_eq_bytes(ovw_action_name(OVW_ACT_GOAL_VETO),   "goal_veto")   == 1)
    ce_check("name hard_stop str",    str_eq_bytes(ovw_action_name(OVW_ACT_HARD_STOP),   "hard_stop")   == 1)
    ce_check("name resume str",       str_eq_bytes(ovw_action_name(OVW_ACT_RESUME),      "resume")      == 1)
    ce_check("name kill_switch str",  str_eq_bytes(ovw_action_name(OVW_ACT_KILL_SWITCH), "kill_switch") == 1)
    ce_check("name undo str",         str_eq_bytes(ovw_action_name(OVW_ACT_UNDO),        "undo")        == 1)
    ce_check("name unknown -> ''",    str_eq_bytes(ovw_action_name(99), "") == 1)
}

// ---- fresh registry shape -------------------------------------------------

fn test_new_reg_shape() {
    let r = ovw_new()
    ce_eq("fresh entries len 0",     len(ovw_entries(r)), 0)
    ce_check("log present",          ovw_log(r)     != 0)
    ce_check("engine present",       ovw_engine(r)  != 0)
    ce_check("veto reg present",     ovw_veto_reg(r) != 0)
    ce_check("safety present",       ovw_safety(r)  != 0)
    // next_id starts at 1; the first record returns 1.
    let id = ovw_next_id(r)
    ce_eq("first id is 1", id, 1)
    // Second call increments.
    let id2 = ovw_next_id(r)
    ce_eq("second id is 2", id2, 2)
}

// ---- record + lookup + filters -------------------------------------------

fn test_record_and_get() {
    let r = ovw_new()
    let oid = ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice",
                         0, 0, 0, "", 1000)
    ce_check("oid > 0", oid > 0)
    let e = ovw_get(r, oid)
    ce_check("entry found", e != 0)
    ce_eq("entry id",        ovw_entry_id(e),        oid)
    ce_eq("entry timestamp", ovw_entry_timestamp(e), 1000)
    ce_check("entry holder", str_eq_bytes(ovw_entry_holder(e), "alice") == 1)
    ce_eq("entry action",    ovw_entry_action(e),    OVW_ACT_HARD_STOP)
    ce_eq("entry undone=0",  ovw_entry_undone(e),    0)
    // Unknown id -> 0.
    ce_check("get miss -> 0", ovw_get(r, 999) == 0)
}

fn test_entries_for_holder_isolation() {
    let r = ovw_new()
    ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 100)
    ovw_record(r, OVW_ACT_RESUME,    "{}", "alice", 0, 0, 0, "", 200)
    ovw_record(r, OVW_ACT_HARD_STOP, "{}", "bob",   0, 0, 0, "", 300)
    let a_only = ovw_entries_for_holder(r, "alice")
    ce_eq("alice sees 2", len(a_only), 2)
    let b_only = ovw_entries_for_holder(r, "bob")
    ce_eq("bob sees 1",   len(b_only), 1)
    let noone = ovw_entries_for_holder(r, "carol")
    ce_eq("carol sees 0", len(noone), 0)
}

fn test_entries_by_action_filter() {
    let r = ovw_new()
    ovw_record(r, OVW_ACT_HARD_STOP, "{}", "a", 0, 0, 0, "", 100)
    ovw_record(r, OVW_ACT_RESUME,    "{}", "a", 0, 0, 0, "", 200)
    ovw_record(r, OVW_ACT_HARD_STOP, "{}", "b", 0, 0, 0, "", 300)
    ovw_record(r, OVW_ACT_KILL_SWITCH, "{}", "a", 0, 0, 0, "", 400)
    let stops = ovw_entries_by_action(r, OVW_ACT_HARD_STOP)
    ce_eq("2 hard_stops", len(stops), 2)
    let resumes = ovw_entries_by_action(r, OVW_ACT_RESUME)
    ce_eq("1 resume",     len(resumes), 1)
    let kills = ovw_entries_by_action(r, OVW_ACT_KILL_SWITCH)
    ce_eq("1 kill",       len(kills), 1)
    let vetoes = ovw_entries_by_action(r, OVW_ACT_GOAL_VETO)
    ce_eq("0 vetoes",     len(vetoes), 0)
}

// ---- belief_edit snapshot capture + underlying fire ----------------------

fn _mk_kg_with_atom(label) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "world")
    let a = kg_add_atom(kg, ATOM_FACT, label, 0)
    // Give it prior alpha/beta so an override changes something visible.
    let b = atom_belief(a)
    list_set(b, 0, 3000)
    list_set(b, 1, 2000)
    let out = list_new()
    push(out, reg)
    push(out, kg)
    push(out, a)
    return out
}

fn test_belief_edit_and_snapshot_flow() {
    let stuff = _mk_kg_with_atom("mars")
    let a = stuff[2]
    let r = ovw_new()
    // Capture snapshot BEFORE calling override_belief_edit.
    let bel = atom_belief(a)
    let prior_alpha = bel[0]
    let prior_beta  = bel[1]
    let prior_pin   = override_belief_is_pinned(a)
    override_belief_edit(ovw_log(r), a, 999, 1, 1, 500)
    let oid = ovw_record(r, OVW_ACT_BELIEF_EDIT,
        "{\"atom_label\":\"mars\",\"alpha\":999,\"beta\":1,\"pin\":1}",
        "alice", prior_alpha, prior_beta, prior_pin, "mars", 500)
    ce_check("belief_edit applied",  bel[0] == 999)
    ce_check("belief_edit applied2", bel[1] == 1)
    ce_check("now pinned",           override_belief_is_pinned(a) == 1)
    let e = ovw_get(r, oid)
    ce_check("entry captured",           e != 0)
    ce_eq("snapshot alpha=3000",         ovw_entry_snapshot_alpha(e), 3000)
    ce_eq("snapshot beta=2000",          ovw_entry_snapshot_beta(e),  2000)
    ce_eq("snapshot pin=0",              ovw_entry_snapshot_pin(e),   0)
    ce_check("snapshot label=mars",      str_eq_bytes(ovw_entry_snapshot_atom_label(e), "mars") == 1)
    ce_eq("snapshot_captured=1",         ovw_entry_snapshot_captured(e), 1)
}

fn test_undo_restores_prior_belief() {
    let stuff = _mk_kg_with_atom("earth")
    let a = stuff[2]
    let r = ovw_new()
    // Record + apply belief_edit.
    let bel = atom_belief(a)
    let prior_alpha = bel[0]
    let prior_beta  = bel[1]
    override_belief_edit(ovw_log(r), a, 500, 500, 0, 100)
    let oid = ovw_record(r, OVW_ACT_BELIEF_EDIT,
        "{\"atom_label\":\"earth\",\"alpha\":500,\"beta\":500,\"pin\":0}",
        "alice", prior_alpha, prior_beta, 0, "earth", 100)
    ce_eq("post-edit alpha=500", bel[0], 500)
    ce_eq("post-edit beta=500",  bel[1], 500)
    // Undo: re-call override_belief_edit with snapshot, mark undone.
    let e = ovw_get(r, oid)
    override_belief_edit(ovw_log(r), a,
                         ovw_entry_snapshot_alpha(e),
                         ovw_entry_snapshot_beta(e),
                         ovw_entry_snapshot_pin(e), 200)
    ce_eq("mark_undone flipped", ovw_mark_undone(r, oid), 1)
    ce_eq("post-undo alpha=3000", bel[0], 3000)
    ce_eq("post-undo beta=2000",  bel[1], 2000)
    // Original entry now shows undone=1.
    ce_eq("entry undone=1", ovw_entry_undone(ovw_get(r, oid)), 1)
    // Re-undoing is a no-op (returns 0).
    ce_eq("second mark_undone no-op", ovw_mark_undone(r, oid), 0)
}

fn test_mark_undone_missing_id() {
    let r = ovw_new()
    ce_eq("mark_undone missing -> 0", ovw_mark_undone(r, 42), 0)
}

// ---- goal_veto: underlying primitive fires + entry recorded --------------

fn test_goal_veto_flow() {
    let r = ovw_new()
    let engine = ovw_engine(r)
    let gid = goal_new(engine, "explore-mars", 500, 0, 1, 0)
    ce_check("goal active", goal_status(engine, gid) != GOAL_VETOED)
    override_goal_veto(ovw_log(r), engine, ovw_veto_reg(r), gid, 1, 100)
    ce_eq("goal vetoed", goal_status(engine, gid), GOAL_VETOED)
    let vreg = ovw_veto_reg(r)
    // Standing veto grew: exact-name match uses str_eq (module owner's
    // choice) which is NOVA-flaky on short literals; just assert the
    // registry gained an entry.
    ce_check("standing veto reg grew", len(vreg) > 0)
    let oid = ovw_record(r, OVW_ACT_GOAL_VETO,
        "{\"goal_id\":" + int_to_str(gid) + "}", "alice", 0, 0, 0, "", 100)
    let e = ovw_get(r, oid)
    ce_eq("action goal_veto", ovw_entry_action(e), OVW_ACT_GOAL_VETO)
    ce_eq("no snapshot",      ovw_entry_snapshot_captured(e), 0)
}

// ---- hard_stop / resume / kill_switch: safety-state deltas ---------------

fn test_hard_stop_resume_kill_flow() {
    let r = ovw_new()
    let ss = ovw_safety(r)
    ce_eq("start not halted", safety_is_halted(ss), 0)
    override_hard_stop(ovw_log(r), ss, 100)
    ce_eq("halted",  safety_is_halted(ss), 1)
    override_resume(ss)
    ce_eq("resumed", safety_is_halted(ss), 0)
    // Clean kill (panic=0) sets killed + returns 1 for snapshot request.
    ce_eq("kill returns 1", override_kill(ovw_log(r), ss, 0, 200), 1)
    ce_eq("killed", safety_is_killed(ss), 1)
    ce_eq("not panic", safety_kill_was_panic(ss), 0)
}

// ---- rate budget ---------------------------------------------------------

fn test_can_afford_default_shape() {
    let r = ovw_new()
    // Empty registry -> can afford.
    ce_eq("empty can_afford", ovw_can_afford(r, "alice", 100, 5), 1)
    // 4 recorded within the last hour, cap=5 -> still allowed.
    let i = 0
    while i < 4 {
        ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 100 + i)
        i = i + 1
    }
    ce_eq("4/5 within hour still allowed", ovw_can_afford(r, "alice", 200, 5), 1)
    ce_eq("remaining=1", ovw_remaining_budget(r, "alice", 200, 5), 1)
    // 5th record -> next call refused.
    ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 200)
    ce_eq("5/5 refused", ovw_can_afford(r, "alice", 300, 5), 0)
    ce_eq("remaining=0", ovw_remaining_budget(r, "alice", 300, 5), 0)
}

fn test_can_afford_per_holder_isolation() {
    let r = ovw_new()
    let i = 0
    while i < 5 {
        ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 100)
        i = i + 1
    }
    // Alice exhausted; bob untouched.
    ce_eq("alice refused", ovw_can_afford(r, "alice", 200, 5), 0)
    ce_eq("bob allowed",   ovw_can_afford(r, "bob",   200, 5), 1)
    ce_eq("bob remaining=5", ovw_remaining_budget(r, "bob", 200, 5), 5)
}

fn test_can_afford_window_rolls_off() {
    let r = ovw_new()
    // Record 5 in the distant past (timestamp 100 nanos).
    let i = 0
    while i < 5 {
        ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 100)
        i = i + 1
    }
    // At timestamp 200 (well within the hour) -> refused.
    ce_eq("refused inside window", ovw_can_afford(r, "alice", 200, 5), 0)
    // At `100 + 1 hour + 1` -> old entries fell out of the window.
    let after = 100 + 3600000000001
    ce_eq("allowed past window", ovw_can_afford(r, "alice", after, 5), 1)
    ce_eq("remaining=5 past window",
          ovw_remaining_budget(r, "alice", after, 5), 5)
}

fn test_can_afford_unlimited_when_zero() {
    let r = ovw_new()
    let i = 0
    while i < 100 {
        ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 100)
        i = i + 1
    }
    // max_per_hour <= 0 -> unlimited.
    ce_eq("unlimited allow 0",  ovw_can_afford(r, "alice", 200, 0), 1)
    ce_eq("unlimited allow -1", ovw_can_afford(r, "alice", 200, -1), 1)
    ce_eq("remaining=-1 sentinel", ovw_remaining_budget(r, "alice", 200, 0), -1)
}

fn test_env_default_is_five() {
    ce_eq("default 5 per hour", ovw_max_per_hour_default(), 5)
}

// ---- entry helpers on non-belief_edit action ----------------------------

fn test_snapshot_captured_only_on_belief_edit() {
    let r = ovw_new()
    let oid = ovw_record(r, OVW_ACT_HARD_STOP, "{}", "alice", 0, 0, 0, "", 100)
    let e = ovw_get(r, oid)
    ce_eq("hard_stop snap=0", ovw_entry_snapshot_captured(e), 0)
    let oid2 = ovw_record(r, OVW_ACT_BELIEF_EDIT,
        "{\"atom_label\":\"x\"}", "alice", 100, 100, 0, "x", 100)
    let e2 = ovw_get(r, oid2)
    ce_eq("belief_edit snap=1", ovw_entry_snapshot_captured(e2), 1)
    // Empty atom_label on a belief_edit still counts as no snapshot.
    let oid3 = ovw_record(r, OVW_ACT_BELIEF_EDIT,
        "{}", "alice", 0, 0, 0, "", 100)
    let e3 = ovw_get(r, oid3)
    ce_eq("belief_edit empty label -> snap=0", ovw_entry_snapshot_captured(e3), 0)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_action_name_roundtrip()
    test_new_reg_shape()
    test_record_and_get()
    test_entries_for_holder_isolation()
    test_entries_by_action_filter()
    test_belief_edit_and_snapshot_flow()
    test_undo_restores_prior_belief()
    test_mark_undone_missing_id()
    test_goal_veto_flow()
    test_hard_stop_resume_kill_flow()
    test_can_afford_default_shape()
    test_can_afford_per_holder_isolation()
    test_can_afford_window_rolls_off()
    test_can_afford_unlimited_when_zero()
    test_env_default_is_five()
    test_snapshot_captured_only_on_belief_edit()
    ce_summary("override_wire")
    return 0
}

main()
