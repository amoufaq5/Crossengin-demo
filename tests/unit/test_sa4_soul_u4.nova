// CE_TEST_TIMEOUT: 240
// Unit tests for src/learning/sa4_soul.nova (A2.2a): a round where a soul
// is in U3 but sends no consistency signature (U4 = U3 minus that soul).
// The reveal decision comes from the U3 each soul signed, not from U4, so
// the other souls must reveal that soul's b-share (never its s-share), and
// the aggregate over U3 must still equal the sum of the U3 inputs.
// Also pins T3 at the call site: a soul's SIG3 must verify over a T3
// recomputed from the public lines (H1 over the U1 ADV keys, U2, U3).

import "../ce_test.nova"
import "../sa4_harness.nova"

fn main() {
    let vc = list_new()
    let roster = sa4h_roster(5)
    let r = 13
    let souls = sa4h_souls(roster, 5, r, vc, 0)
    let res = sa4h_run3(roster, souls, r, 0 - 1, 0 - 1, 4)
    ce_eq("round with a silent U3 member completes", res[0], 1)
    if res[0] != 1 { println("  reason: " + res[1]) }
    ce_eq("aggregate over U3 (all five) equals the sum of inputs", res[2], 1)
    let rv = res[6]
    ce_eq("4 revealers x 5 souls", len(rv), 20)
    ce_eq("b-shares revealed about the silent soul", len(sa4h_filter(rv, "SA4_REVEAL 13 7 4294967295 b")) + len(sa4h_filter(rv, "SA4_REVEAL 13 300 4294967295 b")) + len(sa4h_filter(rv, "SA4_REVEAL 13 65536 4294967295 b")) + len(sa4h_filter(rv, "SA4_REVEAL 13 70000 4294967295 b")), 4)
    ce_eq("no s-share revealed about anyone", len(sa4h_filter(rv, "SA4_REVEAL 13 7 4294967295 s")) + len(sa4h_filter(rv, "SA4_REVEAL 13 300 7 s")), 0)
    ce_eq("silent soul stays SIGNED", sa4s_state(souls[4]), SA4S_ST_SIGNED)
    // T3 pinned at the call site.
    let all5 = [1, 2, 3, 4, 5]
    let t3 = sa4h_t3(roster, r, res[4], all5, all5, all5)
    ce_eq("T3 is 162 bytes", len(t3), 162)
    let s0 = sa4w_parse(res[7][0])
    ce_eq("first SIG3 is soul 7's", s0[2], 7)
    ce_eq("SIG3 verifies over the recomputed T3", ed25519_verify(t3, s0[3], ed25519_hex_to_bytes(SA4H_PKS[0])), 1)
    // Secrets wiped: c/s/b and the mask seeds after R2, everything at DONE.
    let w = 0
    let i = 0
    while i < 5 {
        w = w + sa4h_wiped(souls[i])
        i = i + 1
    }
    ce_eq("round secrets wiped in all five souls", w, 5)
    ce_eq("held shares wiped at DONE", souls[0][19], 0)
    ce_summary("sa4_soul_u4")
}

main()
