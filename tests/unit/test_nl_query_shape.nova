// Unit tests for src/nl/query_shape.nova (ADR-0104 R48p1).

import "../ce_test.nova"
import "../../src/nl/query_shape.nova"

// ---- kind constants -------------------------------------------------------

fn test_kind_constants_distinct() {
    // Sanity: distinct integer constants so the executor can switch cleanly.
    ce_check("NONE != RESEARCH",       NLK_NONE != NLK_RESEARCH)
    ce_check("RESEARCH != RELATE",     NLK_RESEARCH != NLK_RELATE)
    ce_check("RELATE != CONTRADICT",   NLK_RELATE != NLK_CONTRADICT_SCAN)
    ce_check("SKILL_RUN != UNPARSED",  NLK_SKILL_RUN != NLK_UNPARSED)
    ce_check("UNPARSED is a sentinel", NLK_UNPARSED >= 90)
}

// ---- basic constructor + accessors ----------------------------------------

fn test_sq_new_shape() {
    let q = sq_new(NLK_RESEARCH, "what is X", "grammar")
    ce_eq("kind", sq_kind(q), NLK_RESEARCH)
    ce_eq("raw text", sq_raw_text(q), "what is X")
    ce_eq("parser used", sq_parser_used(q), "grammar")
    ce_eq("empty args", sq_arg_count(q), 0)
}

fn test_sq_arg_out_of_range_returns_empty() {
    let q = sq_research("mars", "what is mars", "grammar")
    ce_eq("arg 0 present", sq_arg(q, 0), "mars")
    ce_eq("arg 1 empty (past end)", sq_arg(q, 1), "")
    ce_eq("negative arg empty", sq_arg(q, 0 - 1), "")
}

// ---- convenience constructors ---------------------------------------------

fn test_sq_none() {
    let q = sq_none("", "grammar")
    ce_eq("kind NONE", sq_kind(q), NLK_NONE)
    ce_eq("no args", sq_arg_count(q), 0)
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_sq_unparsed() {
    let q = sq_unparsed("some nonsense that grammar could not parse")
    ce_eq("kind UNPARSED", sq_kind(q), NLK_UNPARSED)
    ce_eq("parser was grammar", sq_parser_used(q), "grammar")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_sq_research_basic() {
    let q = sq_research("photosynthesis", "what is photosynthesis", "grammar")
    ce_eq("kind RESEARCH", sq_kind(q), NLK_RESEARCH)
    ce_eq("1 arg", sq_arg_count(q), 1)
    ce_eq("topic accessor", sq_research_topic(q), "photosynthesis")
    ce_eq("kind filter empty", sq_research_kind_filter(q), "")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_sq_research_filtered() {
    let q = sq_research_filtered("einstein", "person", "who is einstein", "grammar")
    ce_eq("2 args", sq_arg_count(q), 2)
    ce_eq("topic", sq_research_topic(q), "einstein")
    ce_eq("filter", sq_research_kind_filter(q), "person")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_sq_relate() {
    let q = sq_relate("mitochondria", "cell", "does mitochondria relate to cell", "grammar")
    ce_eq("2 args", sq_arg_count(q), 2)
    ce_eq("a", sq_relate_a(q), "mitochondria")
    ce_eq("b", sq_relate_b(q), "cell")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

fn test_sq_contradict_scan() {
    let q = sq_contradict_scan("sun", "moon", "does sun contradict moon", "grammar")
    ce_eq("kind CONTRADICT", sq_kind(q), NLK_CONTRADICT_SCAN)
    ce_eq("a", sq_contradict_a(q), "sun")
    ce_eq("b", sq_contradict_b(q), "moon")
}

fn test_sq_is_a() {
    let q = sq_is_a("earth", "planet", "is earth a planet", "grammar")
    ce_eq("kind IS_A", sq_kind(q), NLK_IS_A)
    ce_eq("x", sq_is_a_x(q), "earth")
    ce_eq("y", sq_is_a_y(q), "planet")
}

fn test_sq_retract() {
    let q = sq_retract("bad_claim", "retract bad_claim", "grammar")
    ce_eq("kind RETRACT", sq_kind(q), NLK_RETRACT)
    ce_eq("label", sq_retract_label(q), "bad_claim")
}

fn test_sq_capsule_install() {
    let q = sq_capsule_install("medicine", "install capsule medicine", "grammar")
    ce_eq("kind CAP INSTALL", sq_kind(q), NLK_CAPSULE_INSTALL)
    ce_eq("name", sq_capsule_install_name(q), "medicine")
}

fn test_sq_skill_install() {
    let q = sq_skill_install("coding_helper", "install skill coding_helper", "grammar")
    ce_eq("kind SK INSTALL", sq_kind(q), NLK_SKILL_INSTALL)
    ce_eq("name", sq_skill_install_name(q), "coding_helper")
}

fn test_sq_lists() {
    let q1 = sq_capsule_list("list capsules", "grammar")
    ce_eq("cap list kind", sq_kind(q1), NLK_CAPSULE_LIST)
    ce_eq("cap list no args", sq_arg_count(q1), 0)
    ce_eq("valid", sq_validate(q1), SQ_OK)
    let q2 = sq_skill_list("list skills", "grammar")
    ce_eq("sk list kind", sq_kind(q2), NLK_SKILL_LIST)
    ce_eq("sk list no args", sq_arg_count(q2), 0)
}

fn test_sq_skill_run() {
    let q = sq_skill_run("research", "the sun", "run skill research on the sun", "grammar")
    ce_eq("kind SKILL_RUN", sq_kind(q), NLK_SKILL_RUN)
    ce_eq("skill", sq_skill_run_skill(q), "research")
    ce_eq("arg", sq_skill_run_arg(q), "the sun")
    ce_eq("valid", sq_validate(q), SQ_OK)
}

// ---- validation -----------------------------------------------------------

fn test_validate_unknown_kind() {
    let q = sq_new(999, "x", "grammar")
    ce_eq("unknown kind rejected", sq_validate(q), SQ_ERR_UNKNOWN_KIND)
}

fn test_validate_wrong_arity() {
    // RELATE needs 2 args; give 1.
    let q = sq_new(NLK_RELATE, "does X relate to Y", "grammar")
    push(q[SQ_ARGS], "X")
    ce_eq("relate with 1 arg fails", sq_validate(q), SQ_ERR_ARITY)
    // IS_A with 3 args also fails.
    let q2 = sq_new(NLK_IS_A, "is X a Y and Z", "grammar")
    push(q2[SQ_ARGS], "X") push(q2[SQ_ARGS], "Y") push(q2[SQ_ARGS], "Z")
    ce_eq("is_a with 3 args fails", sq_validate(q2), SQ_ERR_ARITY)
}

fn test_validate_research_allows_1_or_2() {
    let q1 = sq_research("topic", "raw", "grammar")
    ce_eq("1 arg ok", sq_validate(q1), SQ_OK)
    let q2 = sq_research_filtered("topic", "person", "raw", "grammar")
    ce_eq("2 args ok", sq_validate(q2), SQ_OK)
    // 3 args fails
    let q3 = sq_new(NLK_RESEARCH, "raw", "grammar")
    push(q3[SQ_ARGS], "a") push(q3[SQ_ARGS], "b") push(q3[SQ_ARGS], "c")
    ce_eq("3 args fails", sq_validate(q3), SQ_ERR_ARITY)
    // 0 args fails
    let q4 = sq_new(NLK_RESEARCH, "raw", "grammar")
    ce_eq("0 args fails", sq_validate(q4), SQ_ERR_ARITY)
}

fn test_validate_empty_arg_rejected() {
    let q = sq_new(NLK_RESEARCH, "raw", "grammar")
    push(q[SQ_ARGS], "")
    ce_eq("empty topic rejected", sq_validate(q), SQ_ERR_EMPTY_ARG)
}

fn test_validate_parser_name() {
    let q = sq_research("topic", "raw", "grammar")
    ce_eq("grammar ok", sq_validate(q), SQ_OK)
    let q2 = sq_research("topic", "raw", "llm")
    ce_eq("llm ok", sq_validate(q2), SQ_OK)
    let q3 = sq_research("topic", "raw", "none")
    ce_eq("none ok", sq_validate(q3), SQ_OK)
    let q4 = sq_research("topic", "raw", "voice")
    ce_eq("voice rejected (unknown parser)",
          sq_validate(q4), SQ_ERR_PARSER_NAME)
}

fn test_validate_none_and_unparsed() {
    let q1 = sq_none("", "grammar")
    ce_eq("none valid with empty raw",  sq_validate(q1), SQ_OK)
    let q2 = sq_unparsed("some text")
    ce_eq("unparsed valid",             sq_validate(q2), SQ_OK)
}

// ---- error + kind names ---------------------------------------------------

fn test_err_names() {
    ce_check("ok",         len(sq_err_name(SQ_OK)) > 0)
    ce_check("unknown",    len(sq_err_name(SQ_ERR_UNKNOWN_KIND)) > 0)
    ce_check("arity",      len(sq_err_name(SQ_ERR_ARITY)) > 0)
    ce_check("empty",      len(sq_err_name(SQ_ERR_EMPTY_ARG)) > 0)
    ce_check("parser",     len(sq_err_name(SQ_ERR_PARSER_NAME)) > 0)
    ce_check("missing",    len(sq_err_name(SQ_ERR_MISSING_RAW)) > 0)
    ce_check("bogus code", len(sq_err_name(0 - 999)) > 0)
}

fn test_kind_names() {
    ce_eq("none",     sq_kind_name(NLK_NONE), "none")
    ce_eq("research", sq_kind_name(NLK_RESEARCH), "research")
    ce_eq("relate",   sq_kind_name(NLK_RELATE), "relate")
    ce_eq("contra",   sq_kind_name(NLK_CONTRADICT_SCAN), "contradict-scan")
    ce_eq("is-a",     sq_kind_name(NLK_IS_A), "is-a")
    ce_eq("retract",  sq_kind_name(NLK_RETRACT), "retract")
    ce_eq("cap-i",    sq_kind_name(NLK_CAPSULE_INSTALL), "capsule-install")
    ce_eq("sk-i",     sq_kind_name(NLK_SKILL_INSTALL), "skill-install")
    ce_eq("cap-l",    sq_kind_name(NLK_CAPSULE_LIST), "capsule-list")
    ce_eq("sk-l",     sq_kind_name(NLK_SKILL_LIST), "skill-list")
    ce_eq("sk-run",   sq_kind_name(NLK_SKILL_RUN), "skill-run")
    ce_eq("unpar",    sq_kind_name(NLK_UNPARSED), "unparsed")
    ce_eq("unknown",  sq_kind_name(999), "unknown")
}

fn main() {
    test_kind_constants_distinct()
    test_sq_new_shape()
    test_sq_arg_out_of_range_returns_empty()
    test_sq_none()
    test_sq_unparsed()
    test_sq_research_basic()
    test_sq_research_filtered()
    test_sq_relate()
    test_sq_contradict_scan()
    test_sq_is_a()
    test_sq_retract()
    test_sq_capsule_install()
    test_sq_skill_install()
    test_sq_lists()
    test_sq_skill_run()
    test_validate_unknown_kind()
    test_validate_wrong_arity()
    test_validate_research_allows_1_or_2()
    test_validate_empty_arg_rejected()
    test_validate_parser_name()
    test_validate_none_and_unparsed()
    test_err_names()
    test_kind_names()
    ce_summary("nl_query_shape")
}

main()
