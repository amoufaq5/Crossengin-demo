// Unit tests for src/seed/first_atoms.nova
// Verifies the foundational + demo seed installs into a fresh KG / language KG
// / imagination KG: CORE self-knowledge concepts and reasoning operators are
// present, the seed vocabulary anchors to those concepts, the gated-output
// syntax patterns are registered, and the medical-demo chain (fever ->
// infection => treat) is in place with bidirectional cross-refs. ADR-0010 +
// ADR-0015 + ADR-0031 + ADR-0032.

import "../ce_test.nova"
import "../../src/seed/first_atoms.nova"

fn _setup() {
    let reg = kg_registry_new()
    let env = list_new()
    push(env, reasoning_kg_init(reg))
    push(env, lang_kg_init(reg))
    push(env, imagination_kg_init(reg))
    return env
}

fn test_core_concepts_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]
    let total = seed_apply(kg, lang, ikg, 0)
    ce_check("kg grew (core + demo = 9 concepts)", total >= 9)
    ce_check("self concept seeded", kg_find_atom(kg, "self") != 0)
    ce_check("user concept seeded", kg_find_atom(kg, "user") != 0)
    ce_check("query concept seeded", kg_find_atom(kg, "query") != 0)
    ce_check("response concept seeded", kg_find_atom(kg, "response") != 0)
    ce_check("help concept seeded", kg_find_atom(kg, "help") != 0)
}

fn test_demo_chain_present() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]
    seed_apply(kg, lang, ikg, 0)
    ce_check("fever concept seeded", kg_find_atom(kg, "fever") != 0)
    ce_check("infection concept seeded", kg_find_atom(kg, "infection") != 0)
    ce_check("treat concept seeded", kg_find_atom(kg, "treat") != 0)
    // The cross-ref between fever and infection makes spreading activation
    // expand a fever percept (length > 0 means the xref was attached).
    let fever = kg_find_atom(kg, "fever")
    ce_check("fever has cross-refs", len(atom_xrefs(fever)) >= 1)
}

fn test_vocabulary_anchors() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]
    seed_apply(kg, lang, ikg, 0)
    // Words exist in the language KG and resolve to their concepts.
    ce_check("hello interned", word_find(lang, "hello") != 0)
    ce_check("help interned", word_find(lang, "help") != 0)
    ce_check("fever interned", word_find(lang, "fever") != 0)
    let w_fever = word_find(lang, "fever")
    let c_fever = kg_find_atom(kg, "fever")
    let dom = word_dominant_sense(w_fever)
    ce_eq("fever's dominant sense is the fever concept", dom[1], atom_id(c_fever))
}

fn test_syntax_patterns_registered() {
    let env = _setup()
    let kg = env[0]; let lang = env[1]; let ikg = env[2]
    seed_apply(kg, lang, ikg, 0)
    let ack = syntax_find(lang, "ack")
    let see_topic = syntax_find(lang, "see_topic")
    ce_check("ack syntax present", ack != 0)
    ce_check("see_topic syntax present", see_topic != 0)
    ce_eq("ack is 1-slot", syntax_slot_count(ack), 1)
    ce_eq("see_topic is 2-slot", syntax_slot_count(see_topic), 2)
}

fn main() {
    test_core_concepts_present()
    test_demo_chain_present()
    test_vocabulary_anchors()
    test_syntax_patterns_registered()
    ce_summary("first_atoms")
}
main()
