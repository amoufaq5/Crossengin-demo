// Unit tests for src/substrate/first_nodes.nova
// Verifies first-node block reservation at the stable front range [0,count),
// preset taxonomy (affinity + expected signal types), block membership, and
// broadcast/direct injection. ADR-0010, ADR-0006, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/first_nodes.nova"

fn test_reserve_block_is_front_range() {
    let pool = npm_pool_new(64)
    let block = fn_reserve_block(pool, 8, NTYPE_PERCEIVER)
    ce_eq("block size", len(block), 8)
    // Fresh pool: ids are exactly 0..7 (stable front range, ADR-0010).
    ce_eq("first id 0", block[0], 0)
    ce_eq("last id 7", block[7], 7)
    ce_eq("pool used", npm_live_count(pool), 8)
    ce_eq("ntype applied", npm_ntype(pool, block[3]), NTYPE_PERCEIVER)
    // Interior nodes claimed after the block start above the block.
    let interior = npm_node_create_default(pool, NTYPE_KNOWER)
    ce_eq("interior above block", interior, 8)
}

fn test_reserve_truncates_when_full() {
    let pool = npm_pool_new(4)
    let block = fn_reserve_block(pool, 10, NTYPE_KNOWER)
    ce_eq("truncated to capacity", len(block), 4)
    ce_eq("pool exhausted", npm_available(pool), 0)
}

fn test_preset_taxonomy() {
    ce_eq("perception ntype", fn_preset_ntype(FN_PRESET_PERCEPTION), NTYPE_PERCEIVER)
    ce_eq("episodic ntype", fn_preset_ntype(FN_PRESET_EPISODIC), NTYPE_REMEMBERER)
    ce_eq("action ntype", fn_preset_ntype(FN_PRESET_ACTION), NTYPE_ACTOR)
    ce_eq("kg ntype", fn_preset_ntype(FN_PRESET_KG), NTYPE_KNOWER)
    ce_str_eq("preset name", fn_preset_name(FN_PRESET_SOUL), "soul")

    // Perception first nodes expect SENSORY (ADR-0010).
    let pin = fn_preset_input_types(FN_PRESET_PERCEPTION)
    ce_eq("perception expects 1 type", len(pin), 1)
    ce_eq("perception expects SENSORY", pin[0], XSIG_SENSORY)

    // Reasoning expects GOAL/CAUSAL/IMPLY.
    let rin = fn_preset_input_types(FN_PRESET_REASONING)
    ce_eq("reasoning expects 3 types", len(rin), 3)
    ce_check("reasoning expects GOAL", contains(rin, XSIG_GOAL) == 1)

    // Soul/meta first nodes expect the constitutional channel.
    let sin = fn_preset_input_types(FN_PRESET_SOUL)
    ce_check("soul expects CONST", contains(sin, XSIG_CONST) == 1)
}

fn test_membership_helpers() {
    ce_eq("block ids list", len(fn_block_ids(5)), 5)
    ce_eq("id 0 is first", fn_is_first_node(0, 16), 1)
    ce_eq("id 15 is first", fn_is_first_node(15, 16), 1)
    ce_eq("id 16 not first", fn_is_first_node(16, 16), 0)
    ce_eq("negative not first", fn_is_first_node(-1, 16), 0)
}

fn test_injection() {
    let pool = npm_pool_new(32)
    let block = fn_reserve_block(pool, 4, NTYPE_PERCEIVER)
    let n = fn_inject(pool, block, 300)
    ce_eq("broadcast delivered to all", n, 4)
    ce_eq("node 0 inbox", npm_inbox(pool, block[0]), 300)
    ce_eq("node 3 inbox", npm_inbox(pool, block[3]), 300)
    // Direct injection into one slot adds to that node only.
    fn_inject_one(pool, block, 1, 200)
    ce_eq("slot 1 accumulated", npm_inbox(pool, block[1]), 500)
    ce_eq("slot 0 unchanged", npm_inbox(pool, block[0]), 300)
    // Out-of-range slot is inert.
    ce_eq("bad slot inert", fn_inject_one(pool, block, 99, 100), 0)
}

fn main() {
    test_reserve_block_is_front_range()
    test_reserve_truncates_when_full()
    test_preset_taxonomy()
    test_membership_helpers()
    test_injection()
    ce_summary("first_nodes")
}

main()
