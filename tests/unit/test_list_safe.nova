// Unit tests for src/util/list_safe.nova: the workaround for NOVA's
// list_remove tagging quirk. Every removal actually removes the requested
// index; the tail shifts down; OOB returns 0.

import "../ce_test.nova"
import "../../src/util/list_safe.nova"

fn _mk4() {
    let l = list_new()
    push(l, "a") push(l, "b") push(l, "c") push(l, "d")
    return l
}

// Remove head (idx 0): the previously-broken case.
fn test_remove_head() {
    let l = _mk4()
    ce_eq("returns 1", list_remove_at(l, 0), 1)
    ce_eq("len -> 3", len(l), 3)
    ce_eq("[0]=b", char_at(l[0], 0), 98)
    ce_eq("[1]=c", char_at(l[1], 0), 99)
    ce_eq("[2]=d", char_at(l[2], 0), 100)
}

fn test_remove_middle() {
    let l = _mk4()
    ce_eq("returns 1", list_remove_at(l, 1), 1)
    ce_eq("len -> 3", len(l), 3)
    ce_eq("[0]=a", char_at(l[0], 0), 97)
    ce_eq("[1]=c", char_at(l[1], 0), 99)
    ce_eq("[2]=d", char_at(l[2], 0), 100)
}

fn test_remove_tail() {
    let l = _mk4()
    ce_eq("returns 1", list_remove_at(l, 3), 1)
    ce_eq("len -> 3", len(l), 3)
    ce_eq("[0]=a", char_at(l[0], 0), 97)
    ce_eq("[1]=b", char_at(l[1], 0), 98)
    ce_eq("[2]=c", char_at(l[2], 0), 99)
}

// Successive removes work (the case that exposed the original bug).
fn test_successive_removes() {
    let l = _mk4()
    list_remove_at(l, 0)  // -> [b,c,d]
    list_remove_at(l, 0)  // -> [c,d]
    ce_eq("len -> 2", len(l), 2)
    ce_eq("[0]=c", char_at(l[0], 0), 99)
    ce_eq("[1]=d", char_at(l[1], 0), 100)
}

// Remove from a length-1 list -> empty.
fn test_remove_singleton() {
    let l = list_new() push(l, "x")
    ce_eq("returns 1", list_remove_at(l, 0), 1)
    ce_eq("empty", len(l), 0)
}

// OOB returns 0 without mutating.
fn test_oob_returns_zero() {
    let l = _mk4()
    ce_eq("negative -> 0", list_remove_at(l, 0 - 1), 0)
    ce_eq("past end -> 0", list_remove_at(l, 4), 0)
    ce_eq("len unchanged", len(l), 4)
}

fn main() {
    test_remove_head()
    test_remove_middle()
    test_remove_tail()
    test_successive_removes()
    test_remove_singleton()
    test_oob_returns_zero()
    ce_summary("list_safe")
}

main()
