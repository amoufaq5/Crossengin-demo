// Unit tests for src/ingest/importers/audio_records.nova (R105 -- Phase G).
//
// Covers:
//   * Empty input refused with a clean per-record error
//   * Non-RIFF magic refused
//   * RIFF + non-WAVE form refused
//   * WAVE + non-'fmt ' chunk refused
//   * Non-PCM audio_format refused (only PCM in R105)
//   * Well-formed 44-byte silent WAV: 8 atoms (root + 7 meta), each
//     metadata implication points at root with strength EMPIRICAL;
//     source_tag defaults to src:audio:<hash>
//   * Sample rate / channels / bits reach the atom labels
//   * duration_ms computed from data_len + frame size
//   * With CROSSENGIN_STT_ENABLED unset (default), NO derived-text
//     cluster is emitted -- opt-in is required
//   * cur_validate acceptance
//   * perceptual-prefix guard passes on the root

import "../ce_test.nova"
import "../../src/ingest/importers/audio_records.nova"
import "../../src/ingest/perceptual_capsule.nova"
import "../../src/ingest/curriculum.nova"
import "../../src/kg/atom_store.nova"
import "../../src/util/str_safe.nova"

fn _pu16_le(bl, v) {
    push(bl, int_and(v, 255))
    push(bl, int_and(int_shr(v, 8), 255))
}

fn _pu32_le(bl, v) {
    push(bl, int_and(v, 255))
    push(bl, int_and(int_shr(v,  8), 255))
    push(bl, int_and(int_shr(v, 16), 255))
    push(bl, int_and(int_shr(v, 24), 255))
}

// Canonical 44-byte PCM WAV header + `data_bytes` bytes of silence.
fn _mk_wav_pcm(sample_rate, channels, bits, data_bytes) {
    let bl = list_new()
    // RIFF header
    push(bl, 82) push(bl, 73) push(bl, 70) push(bl, 70)   // "RIFF"
    _pu32_le(bl, 36 + data_bytes)                          // file size - 8
    push(bl, 87) push(bl, 65) push(bl, 86) push(bl, 69)   // "WAVE"
    // fmt  chunk
    push(bl, 102) push(bl, 109) push(bl, 116) push(bl, 32) // "fmt "
    _pu32_le(bl, 16)                                       // fmt size = 16
    _pu16_le(bl, 1)                                        // PCM
    _pu16_le(bl, channels)
    _pu32_le(bl, sample_rate)
    let bytes_per_sample = int_shr(bits + 7, 3)
    let byte_rate = sample_rate * channels * bytes_per_sample
    _pu32_le(bl, byte_rate)
    _pu16_le(bl, channels * bytes_per_sample)              // block align
    _pu16_le(bl, bits)
    // data chunk
    push(bl, 100) push(bl, 97) push(bl, 116) push(bl, 97)  // "data"
    _pu32_le(bl, data_bytes)
    let i = 0
    while i < data_bytes { push(bl, 0)  i = i + 1 }
    return bl
}

fn test_empty_input_refused() {
    let bl = list_new()
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    ce_eq("no records on empty", len(audr_records(r)), 0)
    ce_eq("one error on empty",  len(audr_errors(r)), 1)
    ce_check("error mentions empty",
             find_bytes(audr_errors(r)[0][1], "empty") >= 0)
}

fn test_non_riff_refused() {
    let bl = list_new()
    let i = 0
    while i < 60 { push(bl, i)  i = i + 1 }
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    ce_eq("no records on non-RIFF", len(audr_records(r)), 0)
    ce_eq("one error on non-RIFF",  len(audr_errors(r)), 1)
    ce_check("error mentions RIFF",
             find_bytes(audr_errors(r)[0][1], "RIFF") >= 0)
}

fn test_riff_non_wave_refused() {
    let bl = list_new()
    // RIFF + "AVI " form -> refused
    push(bl, 82) push(bl, 73) push(bl, 70) push(bl, 70)
    let i = 0
    while i < 4 { push(bl, 0)  i = i + 1 }
    push(bl, 65) push(bl, 86) push(bl, 73) push(bl, 32)
    while i < 44 { push(bl, 0)  i = i + 1 }
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    ce_eq("no records on non-WAVE", len(audr_records(r)), 0)
    ce_eq("one error on non-WAVE",  len(audr_errors(r)), 1)
    ce_check("error mentions WAVE",
             find_bytes(audr_errors(r)[0][1], "WAVE") >= 0)
}

fn test_non_pcm_refused() {
    // PCM = 1; use 3 (IEEE float) instead.
    let bl = _mk_wav_pcm(16000, 1, 16, 4)
    // Patch audio_format at offset 20.
    list_set(bl, 20, 3)
    list_set(bl, 21, 0)
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    ce_eq("no records on non-PCM", len(audr_records(r)), 0)
    ce_eq("one error on non-PCM",  len(audr_errors(r)), 1)
    ce_check("error mentions PCM",
             find_bytes(audr_errors(r)[0][1], "PCM") >= 0)
}

fn test_wav_44_byte_silence_record_shape() {
    // 4 silent samples at 16 kHz mono 16-bit -> data_len = 8 bytes.
    let bl = _mk_wav_pcm(16000, 1, 16, 8)
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    ce_eq("one record", len(audr_records(r)), 1)
    ce_eq("no errors",  len(audr_errors(r)), 0)
    let rec = audr_records(r)[0]
    ce_str_eq("kg name", cur_kg(rec), "auditory")
    ce_str_eq("source tag", cur_source(rec), "src:audio:test:v1")
    // Root + 7 metadata atoms.
    ce_eq("8 atoms total", len(cur_atoms(rec)), 8)
    ce_eq("7 metadata implications", len(cur_imps(rec)), 7)
    let root = cur_atoms(rec)[0]
    ce_eq("root prefix valid",
          perc_label_prefix_valid(root[CUR_ATOM_LABEL]), 1)
    ce_eq("root kind FACT", root[CUR_ATOM_KIND], ATOM_FACT)
    ce_eq("root seed 900",  root[CUR_ATOM_BELIEF], 900)
    // All imps point at root.
    let all_ok = 1
    let i = 0
    while i < len(cur_imps(rec)) {
        let imp = cur_imps(rec)[i]
        if str_eq_bytes(imp[CUR_IMP_CONSEQ], root[CUR_ATOM_LABEL]) == 0 {
            all_ok = 0
        }
        if str_eq_bytes(imp[CUR_IMP_STR], "EMPIRICAL") == 0 { all_ok = 0 }
        i = i + 1
    }
    ce_eq("all imps EMPIRICAL -> root", all_ok, 1)
    ce_eq("cur_validate ok", cur_validate(rec), CUR_OK)
}

fn test_source_default_when_empty() {
    let bl = _mk_wav_pcm(16000, 1, 16, 8)
    let r = audr_parse_bytes(bl, "", "")
    let rec = audr_records(r)[0]
    ce_str_eq("kg default", cur_kg(rec), "auditory")
    ce_check("source starts with src:audio:",
             find_bytes(cur_source(rec), "src:audio:") == 0)
}

fn test_metadata_labels_reflect_fmt() {
    let bl = _mk_wav_pcm(22050, 2, 16, 16)   // stereo 22.05 kHz 16-bit
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    let rec = audr_records(r)[0]
    let saw_rate = 0
    let saw_ch = 0
    let saw_bits = 0
    let saw_fmt = 0
    let i = 0
    while i < len(cur_atoms(rec)) {
        let lab = cur_atoms(rec)[i][CUR_ATOM_LABEL]
        if find_bytes(lab, ":rate=22050")  >= 0 { saw_rate = 1 }
        if find_bytes(lab, ":channels=2")  >= 0 { saw_ch   = 1 }
        if find_bytes(lab, ":bits=16")     >= 0 { saw_bits = 1 }
        if find_bytes(lab, ":format=wav")  >= 0 { saw_fmt  = 1 }
        i = i + 1
    }
    ce_eq("saw rate=22050",   saw_rate, 1)
    ce_eq("saw channels=2",   saw_ch,   1)
    ce_eq("saw bits=16",      saw_bits, 1)
    ce_eq("saw format=wav",   saw_fmt,  1)
}

fn test_duration_computed() {
    // 8000 Hz mono 16-bit, data_len = 16000 bytes -> 8000 samples ->
    // 1000 ms.
    let bl = _mk_wav_pcm(8000, 1, 16, 16000)
    let r = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    let rec = audr_records(r)[0]
    let saw = 0
    let i = 0
    while i < len(cur_atoms(rec)) {
        let lab = cur_atoms(rec)[i][CUR_ATOM_LABEL]
        if find_bytes(lab, ":duration_ms=1000") >= 0 { saw = 1 }
        i = i + 1
    }
    ce_eq("saw duration_ms=1000", saw, 1)
}

fn test_stt_default_off_no_derived_text() {
    let bl = _mk_wav_pcm(16000, 1, 16, 8)
    let r  = audr_parse_bytes(bl, "auditory", "src:audio:test:v1")
    let rec = audr_records(r)[0]
    let saw = 0
    let i = 0
    while i < len(cur_atoms(rec)) {
        let lab = cur_atoms(rec)[i][CUR_ATOM_LABEL]
        if find_bytes(lab, ":text") >= 0 { saw = 1 }
        i = i + 1
    }
    ce_eq("no derived-text cluster by default (STT opt-in)", saw, 0)
}

fn main() {
    test_empty_input_refused()
    test_non_riff_refused()
    test_riff_non_wave_refused()
    test_non_pcm_refused()
    test_wav_44_byte_silence_record_shape()
    test_source_default_when_empty()
    test_metadata_labels_reflect_fmt()
    test_duration_computed()
    test_stt_default_off_no_derived_text()
    ce_summary("audio_records")
}

main()
