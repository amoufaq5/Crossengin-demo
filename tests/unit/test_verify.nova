// Unit tests for src/mind/verify.nova: the proof-checker kernel (ADR-0088).
// The kernel is the only writer of the FORMAL grade, so these tests cover both
// what it MUST accept (valid Hilbert-style derivations against a registered
// axiom + currently-VERIFIED hypothesis context) and what it MUST reject
// (every shape of tampered or unsound proof). On VERIFIED it pins the atom
// FORMAL; on FAILED it leaves the atom untouched; a re-check that fails after
// an earlier success unpins the atom.

import "../ce_test.nova"
import "../../src/mind/verify.nova"

fn _ax(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

// ---- term equality (the foundation; if this breaks every rule is unsound) ---
fn test_term_eq() {
    ce_eq("atom == atom (same label)",
        term_eq(term_atom("p"), term_atom("p")), 1)
    ce_eq("atom != atom (diff label)",
        term_eq(term_atom("p"), term_atom("q")), 0)
    ce_eq("atom != AND",
        term_eq(term_atom("p"), term_and(term_atom("p"), term_atom("q"))), 0)
    ce_eq("AND structural",
        term_eq(term_and(term_atom("p"), term_atom("q")),
                term_and(term_atom("p"), term_atom("q"))), 1)
    ce_eq("AND not symmetric",
        term_eq(term_and(term_atom("p"), term_atom("q")),
                term_and(term_atom("q"), term_atom("p"))), 0)
    ce_eq("IMP and AND distinct kinds",
        term_eq(term_imp(term_atom("p"), term_atom("q")),
                term_and(term_atom("p"), term_atom("q"))), 0)
}

// ---- AXIOM rule ------------------------------------------------------------
fn test_axiom_accepts_registered() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    ce_eq("registered axiom verifies",
        verify_check(reg, _ax(p), hyp_new(), pf_axiom(p), p), 1)
}

fn test_axiom_rejects_unregistered() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    ce_eq("unregistered axiom rejected",
        verify_check(reg, _ax(p), hyp_new(), pf_axiom(q), q), 0)
}

// ---- AND_I + AND_EL + AND_ER -----------------------------------------------
fn test_and_intro_and_elim() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_and(p, q)
    let axs = axiom_table_new()
    axiom_table_add(axs, p) axiom_table_add(axs, q)
    // (axiom p, axiom q) |- p AND q
    let intro = pf_and_i(pq, pf_axiom(p), pf_axiom(q))
    ce_eq("AND_I verifies", verify_check(reg, axs, hyp_new(), intro, pq), 1)
    // From (p AND q), elim_l |- p
    let elim_l = pf_and_el(p, intro)
    ce_eq("AND_EL verifies", verify_check(reg, axs, hyp_new(), elim_l, p), 1)
    let elim_r = pf_and_er(q, intro)
    ce_eq("AND_ER verifies", verify_check(reg, axs, hyp_new(), elim_r, q), 1)
    // Sanity: AND_EL claiming the WRONG side must fail.
    let wrong = pf_and_el(q, intro)
    ce_eq("AND_EL with wrong projection rejected",
        verify_check(reg, axs, hyp_new(), wrong, q), 0)
}

// ---- modus ponens ----------------------------------------------------------
fn test_modus_ponens() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_imp(p, q)
    let axs = axiom_table_new()
    axiom_table_add(axs, pq) axiom_table_add(axs, p)
    // From (p -> q) and p, MP |- q
    let mp = pf_mp(q, pf_axiom(pq), pf_axiom(p))
    ce_eq("MP verifies", verify_check(reg, axs, hyp_new(), mp, q), 1)
    // Wrong consequent: claim conclusion r instead of q -- root mismatch.
    let r = term_atom("r")
    ce_eq("MP wrong conclusion rejected",
        verify_check(reg, axs, hyp_new(), mp, r), 0)
}

// MP whose antecedent proof concludes the wrong atom is unsound: the kernel
// must reject it even though every node is "well-typed".
fn test_modus_ponens_antecedent_mismatch() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let r = term_atom("r")
    let pq = term_imp(p, q)
    let axs = axiom_table_new()
    axiom_table_add(axs, pq) axiom_table_add(axs, r)
    // Try: from (p -> q) and r, claim q. The MP step demands p, but we hand
    // it a proof of r -- antecedent mismatch.
    let bogus = pf_mp(q, pf_axiom(pq), pf_axiom(r))
    ce_eq("MP rejects antecedent mismatch",
        verify_check(reg, axs, hyp_new(), bogus, q), 0)
}

// ---- HYP: cascading re-check honesty ---------------------------------------
fn test_hyp_lemma_verified() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    // Pre-register a VERIFIED proof for "p" -- it stands in for an already-
    // FORMAL atom whose proof_ref points here.
    let code = proof_register(reg, "p", list_new(), "")
    proof_set_status(reg, code, PROOF_VERIFIED)
    let hyps = hyp_new()
    hyp_add(hyps, "p", p, code)
    let pr = pf_hyp(p, "p")
    ce_eq("HYP w/ VERIFIED lemma accepted",
        verify_check(reg, axiom_table_new(), hyps, pr, p), 1)
}

fn test_hyp_lemma_unverified() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    // Lemma stays UNCHECKED -- the kernel must NOT use it (no resting on
    // unproven peers, ADR-0088 cascading re-check honesty).
    let code = proof_register(reg, "p", list_new(), "")
    let hyps = hyp_new()
    hyp_add(hyps, "p", p, code)
    let pr = pf_hyp(p, "p")
    ce_eq("HYP w/ UNCHECKED lemma rejected",
        verify_check(reg, axiom_table_new(), hyps, pr, p), 0)
}

fn test_hyp_lemma_label_mismatch() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let code = proof_register(reg, "p", list_new(), "")
    proof_set_status(reg, code, PROOF_VERIFIED)
    let hyps = hyp_new()
    hyp_add(hyps, "p", p, code)
    // The HYP entry says label "p" asserts term p; but we claim conclusion q.
    let bogus = pf_hyp(q, "p")
    ce_eq("HYP rejects term mismatch",
        verify_check(reg, axiom_table_new(), hyps, bogus, q), 0)
}

// ---- the FORMAL-grade gate -------------------------------------------------
//
// verify_pin_atom is the only legitimate writer of GRADE_FORMAL. On VERIFIED
// it pins the atom; on FAILED the atom is untouched (no silent grade grant).
fn test_pin_atom_on_success() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let atom = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    let code = verify_pin_atom(reg, atom, pkt)
    ce_check("got a proof code", code > 0)
    ce_eq("status VERIFIED", proof_status(reg, code), PROOF_VERIFIED)
    ce_eq("grade is FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
    ce_eq("proof_ref stamped", atom_proof_ref(atom), code)
    ce_check("belief pinned high", atom_confidence(atom) > 990)
}

fn test_pin_atom_on_failure() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let atom = atom_new(0, 1, ATOM_CONCEPT, "q", 0)
    // Hand the kernel a bogus proof: an axiom of p, claiming q.
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), q, "q", "bogus")
    let code = verify_pin_atom(reg, atom, pkt)
    ce_eq("returns 0 on failure", code, 0)
    // The atom is left untouched -- no grade upgrade.
    ce_eq("grade NOT FORMAL", atom_evidence_grade(atom), GRADE_UNKNOWN)
}

// ---- re-check / unpin (ADR-0088 dependency-change triggers) ----------------
fn test_recheck_unpins_on_failure() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let atom = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    // First pin succeeds.
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    verify_pin_atom(reg, atom, pkt)
    ce_eq("pinned FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
    // Re-check with a now-bogus packet (axiom q claiming p) -> kernel rejects,
    // atom is unpinned: grade dropped, belief reset.
    let bad = verify_packet(_ax(q), hyp_new(), pf_axiom(q), p, "p", "tampered")
    let ok = verify_recheck_atom(reg, atom, bad)
    ce_eq("recheck returned failure", ok, 0)
    ce_eq("grade dropped to UNKNOWN", atom_evidence_grade(atom), GRADE_UNKNOWN)
    ce_eq("belief reset to prior", atom_confidence(atom), 500)
}

fn test_recheck_on_passing_proof_keeps_pin() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let atom = atom_new(0, 1, ATOM_CONCEPT, "p", 0)
    let pkt = verify_packet(_ax(p), hyp_new(), pf_axiom(p), p, "p", "axiom-p")
    verify_pin_atom(reg, atom, pkt)
    let ok = verify_recheck_atom(reg, atom, pkt)
    ce_eq("recheck reaffirms", ok, 1)
    ce_eq("grade still FORMAL", atom_evidence_grade(atom), GRADE_FORMAL)
}

// ---- increment 12: wider rules ---------------------------------------------

// term_eq distinguishes OR / IFF from AND / IMP (the kind check).
fn test_term_eq_new_kinds() {
    let p = term_atom("p")
    let q = term_atom("q")
    ce_eq("OR structural eq",
        term_eq(term_or(p, q), term_or(term_atom("p"), term_atom("q"))), 1)
    ce_eq("IFF structural eq",
        term_eq(term_iff(p, q), term_iff(term_atom("p"), term_atom("q"))), 1)
    ce_eq("OR != AND (same children)",
        term_eq(term_or(p, q), term_and(p, q)), 0)
    ce_eq("IFF != IMP (same children)",
        term_eq(term_iff(p, q), term_imp(p, q)), 0)
}

// Disjunction introduction: from axiom p, derive (p or q) for any q.
fn test_or_introduction() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_or(p, q)
    // OR_IL: (p or q) from p.
    let il = pf_or_il(pq, pf_axiom(p))
    ce_eq("OR_IL verifies", verify_check(reg, _ax(p), hyp_new(), il, pq), 1)
    // OR_IR: (q or p) from p (p on the right).
    let qp = term_or(q, p)
    let ir = pf_or_ir(qp, pf_axiom(p))
    ce_eq("OR_IR verifies", verify_check(reg, _ax(p), hyp_new(), ir, qp), 1)
    // Unsound: claim (q or r) from a proof of p -- p is neither disjunct.
    let r = term_atom("r")
    let bogus = pf_or_il(term_or(q, r), pf_axiom(p))
    ce_eq("OR_IL with mismatched disjunct rejected",
        verify_check(reg, _ax(p), hyp_new(), bogus, term_or(q, r)), 0)
}

// Biconditional intro + elim.
fn test_biconditional() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let ab = term_imp(a, b)
    let ba = term_imp(b, a)
    let iff = term_iff(a, b)
    let axs = axiom_table_new()
    axiom_table_add(axs, ab) axiom_table_add(axs, ba)
    // IFF_I: (a iff b) from (a->b) and (b->a).
    let intro = pf_iff_i(iff, pf_axiom(ab), pf_axiom(ba))
    ce_eq("IFF_I verifies", verify_check(reg, axs, hyp_new(), intro, iff), 1)
    // IFF_EL: (a->b) from (a iff b).
    let el = pf_iff_el(ab, intro)
    ce_eq("IFF_EL verifies", verify_check(reg, axs, hyp_new(), el, ab), 1)
    // IFF_ER: (b->a) from (a iff b).
    let er = pf_iff_er(ba, intro)
    ce_eq("IFF_ER verifies", verify_check(reg, axs, hyp_new(), er, ba), 1)
    // Unsound: IFF_I where the second proof isn't (b->a).
    let c = term_atom("c")
    let bad = pf_iff_i(iff, pf_axiom(ab), pf_axiom(term_imp(b, c)))
    let axs2 = axiom_table_new()
    axiom_table_add(axs2, ab) axiom_table_add(axs2, term_imp(b, c))
    ce_eq("IFF_I with wrong reverse direction rejected",
        verify_check(reg, axs2, hyp_new(), bad, iff), 0)
}

// Hypothetical syllogism: (a->b),(b->c) |- (a->c).
fn test_hypothetical_syllogism() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let ab = term_imp(a, b)
    let bc = term_imp(b, c)
    let ac = term_imp(a, c)
    let axs = axiom_table_new()
    axiom_table_add(axs, ab) axiom_table_add(axs, bc)
    let hs = pf_hs(ac, pf_axiom(ab), pf_axiom(bc))
    ce_eq("HS verifies", verify_check(reg, axs, hyp_new(), hs, ac), 1)
    // Unsound: middle term mismatch -- (a->b),(d->c) cannot chain.
    let d = term_atom("d")
    let dc = term_imp(d, c)
    let axs2 = axiom_table_new()
    axiom_table_add(axs2, ab) axiom_table_add(axs2, dc)
    let bad = pf_hs(ac, pf_axiom(ab), pf_axiom(dc))
    ce_eq("HS with broken middle term rejected",
        verify_check(reg, axs2, hyp_new(), bad, ac), 0)
    // Unsound: claiming the wrong endpoints (a->d) from (a->b),(b->c).
    let bad2 = pf_hs(term_imp(a, d), pf_axiom(ab), pf_axiom(bc))
    ce_eq("HS with wrong conclusion rejected",
        verify_check(reg, axs, hyp_new(), bad2, term_imp(a, d)), 0)
}

// ---- increment 15: ground arithmetic (EVAL) --------------------------------
fn test_arith_eval_accepts_true_equality() {
    let reg = proof_registry_new()
    // 2 + 2 = 4
    let claim = term_equals(term_add(term_num(2), term_num(2)), term_num(4))
    ce_eq("2+2=4 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(claim), claim), 1)
    // 2 * 3 = 6
    let claim2 = term_equals(term_mul(term_num(2), term_num(3)), term_num(6))
    ce_eq("2*3=6 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(claim2), claim2), 1)
    // nested: (2 + 3) * 4 = 20
    let claim3 = term_equals(
        term_mul(term_add(term_num(2), term_num(3)), term_num(4)), term_num(20))
    ce_eq("(2+3)*4=20 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(claim3), claim3), 1)
}

fn test_arith_eval_rejects_false_equality() {
    let reg = proof_registry_new()
    // 3 + 3 = 7  (false: 6 != 7) -- the decision procedure recomputes and refuses.
    let bad = term_equals(term_add(term_num(3), term_num(3)), term_num(7))
    ce_eq("3+3=7 rejected",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(bad), bad), 0)
}

fn test_arith_eval_rejects_nonarithmetic() {
    let reg = proof_registry_new()
    // EVAL on a non-equality (an atom) -> rejected.
    let p = term_atom("p")
    ce_eq("EVAL of an atom rejected",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(p), p), 0)
    // EVAL of an equality whose side is a logical atom (not arithmetic) -> reject.
    let mixed = term_equals(term_num(2), term_atom("x"))
    ce_eq("EVAL with a non-arithmetic side rejected",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(mixed), mixed), 0)
}

fn test_arith_sub_and_div() {
    let reg = proof_registry_new()
    // 10 - 4 = 6
    let sub = term_equals(term_sub(term_num(10), term_num(4)), term_num(6))
    ce_eq("10-4=6 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(sub), sub), 1)
    // 5 - 8 = -3 (negatives are fine)
    let neg = term_equals(term_sub(term_num(5), term_num(8)), term_num(0 - 3))
    ce_eq("5-8=-3 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(neg), neg), 1)
    // 6 / 2 = 3 (exact)
    let div = term_equals(term_div(term_num(6), term_num(2)), term_num(3))
    ce_eq("6/2=3 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(div), div), 1)
    // 7 / 2 = 3 -> REFUSED (inexact: the engine won't round 3.5 to 3)
    let inexact = term_equals(term_div(term_num(7), term_num(2)), term_num(3))
    ce_eq("7/2=3 refused (inexact)",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(inexact), inexact), 0)
    // division by zero -> REFUSED (undefined, not a false equality)
    let dz = term_equals(term_div(term_num(4), term_num(0)), term_num(0))
    ce_eq("4/0=0 refused (div by zero)",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(dz), dz), 0)
}

// ---- increment 17: quantifiers (UI / EI) -----------------------------------

// Universal instantiation: from (forall x. P(x)) derive P(a).
fn test_universal_instantiation() {
    let reg = proof_registry_new()
    // forall x. P(x)
    let body = term_pred("P", term_var("x"))
    let univ = term_forall("x", body)
    // P(a)  -- a is a closed constant (an atom).
    let pa = term_pred("P", term_atom("a"))
    let proof = pf_ui(pa, pf_axiom(univ), term_atom("a"))
    ce_eq("UI: forall x.P(x) |- P(a)",
        verify_check(reg, _ax(univ), hyp_new(), proof, pa), 1)
    // Unsound: claim P(b) from the same proof instantiated at a.
    let pb = term_pred("P", term_atom("b"))
    let bogus = pf_ui(pb, pf_axiom(univ), term_atom("a"))
    ce_eq("UI: wrong conclusion (P(b) from inst a) rejected",
        verify_check(reg, _ax(univ), hyp_new(), bogus, pb), 0)
}

// UI works on a quantified IMPLICATION: forall x.(human(x) -> mortal(x)),
// instantiated at socrates, yields (human(socrates) -> mortal(socrates)).
fn test_ui_on_implication() {
    let reg = proof_registry_new()
    let body = term_imp(term_pred("human", term_var("x")),
                        term_pred("mortal", term_var("x")))
    let univ = term_forall("x", body)
    let inst = term_imp(term_pred("human", term_atom("socrates")),
                        term_pred("mortal", term_atom("socrates")))
    let proof = pf_ui(inst, pf_axiom(univ), term_atom("socrates"))
    ce_eq("UI on (human->mortal) at socrates",
        verify_check(reg, _ax(univ), hyp_new(), proof, inst), 1)
}

// UI must reject a non-closed instantiation term (capture-avoidance bound).
fn test_ui_rejects_open_instantiation() {
    let reg = proof_registry_new()
    let univ = term_forall("x", term_pred("P", term_var("x")))
    // instantiate at a VARIABLE y (not closed) -> rejected.
    let openi = term_pred("P", term_var("y"))
    let proof = pf_ui(openi, pf_axiom(univ), term_var("y"))
    ce_eq("UI rejects open (non-closed) instantiation",
        verify_check(reg, _ax(univ), hyp_new(), proof, openi), 0)
}

// UI requires the sub-proof to actually conclude a FORALL.
fn test_ui_requires_forall() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    // sub-proof concludes an atom, not a forall -> UI rejects.
    let bogus = pf_ui(p, pf_axiom(p), term_atom("a"))
    ce_eq("UI on a non-forall rejected",
        verify_check(reg, _ax(p), hyp_new(), bogus, p), 0)
}

// Existential introduction: from P(a) derive (exists x. P(x)).
fn test_existential_introduction() {
    let reg = proof_registry_new()
    let pa = term_pred("P", term_atom("a"))
    let ex = term_exists("x", term_pred("P", term_var("x")))
    let proof = pf_ei(ex, pf_axiom(pa), term_atom("a"))
    ce_eq("EI: P(a) |- exists x.P(x)",
        verify_check(reg, _ax(pa), hyp_new(), proof, ex), 1)
    // Unsound: witness mismatch -- claim exists x.P(x) from a proof of Q(a).
    let qa = term_pred("Q", term_atom("a"))
    let bogus = pf_ei(ex, pf_axiom(qa), term_atom("a"))
    ce_eq("EI: witness/body mismatch rejected",
        verify_check(reg, _ax(qa), hyp_new(), bogus, ex), 0)
}

// UI then EI compose: forall x.P(x) |- P(a) |- exists y.P(y).
fn test_ui_then_ei_compose() {
    let reg = proof_registry_new()
    let univ = term_forall("x", term_pred("P", term_var("x")))
    let pa = term_pred("P", term_atom("a"))
    let ui = pf_ui(pa, pf_axiom(univ), term_atom("a"))
    let ex = term_exists("y", term_pred("P", term_var("y")))
    let ei = pf_ei(ex, ui, term_atom("a"))
    ce_eq("UI then EI compose",
        verify_check(reg, _ax(univ), hyp_new(), ei, ex), 1)
}

// The classic end-to-end: forall x.(human(x)->mortal(x)), human(socrates)
// |- mortal(socrates), via UI then MP. The whole first-order syllogism, machine-
// checked.
fn test_socrates_syllogism() {
    let reg = proof_registry_new()
    let law = term_forall("x", term_imp(term_pred("human", term_var("x")),
                                        term_pred("mortal", term_var("x"))))
    let human_soc = term_pred("human", term_atom("socrates"))
    let inst = term_imp(term_pred("human", term_atom("socrates")),
                        term_pred("mortal", term_atom("socrates")))
    let mortal_soc = term_pred("mortal", term_atom("socrates"))
    let axs = axiom_table_new()
    axiom_table_add(axs, law) axiom_table_add(axs, human_soc)
    // UI on the law at socrates, then MP with the fact.
    let ui = pf_ui(inst, pf_axiom(law), term_atom("socrates"))
    let mp = pf_mp(mortal_soc, ui, pf_axiom(human_soc))
    ce_eq("Socrates is mortal (UI then MP)",
        verify_check(reg, axs, hyp_new(), mp, mortal_soc), 1)
}

// ---- increment 19: universal generalization (UG) ---------------------------

// THE soundness test: you must NOT be able to generalize a single instance.
// From an axiom P(c), claiming forall x.P(x) must be REJECTED, because c occurs
// in the axiom the proof depends on (the eigenvariable condition fails).
fn test_ug_rejects_instance_generalization() {
    let reg = proof_registry_new()
    let pc = term_pred("P", term_atom("c"))
    let univ = term_forall("x", term_pred("P", term_var("x")))
    // proof of P(c) is just the axiom P(c); generalizing it is unsound.
    let bogus = pf_ug(univ, pf_axiom(pc), term_atom("c"))
    ce_eq("UG from a single instance REJECTED (eigenvariable)",
        verify_check(reg, _ax(pc), hyp_new(), bogus, univ), 0)
}

// The valid use: forall x.(P(x)->Q(x)), forall x.P(x) |- forall x.Q(x).
// Proof: UI both universals at a FRESH c (c is in neither axiom), MP to get
// Q(c), then UG -- c is arbitrary, so generalize.
fn test_ug_valid_derivation() {
    let reg = proof_registry_new()
    let allPQ = term_forall("x", term_imp(term_pred("P", term_var("x")),
                                          term_pred("Q", term_var("x"))))
    let allP = term_forall("x", term_pred("P", term_var("x")))
    let axs = axiom_table_new()
    axiom_table_add(axs, allPQ) axiom_table_add(axs, allP)
    let c = term_atom("c")
    // UI: P(c)->Q(c) ; P(c).
    let pcqc = term_imp(term_pred("P", c), term_pred("Q", c))
    let ui1 = pf_ui(pcqc, pf_axiom(allPQ), c)
    let pc = term_pred("P", c)
    let ui2 = pf_ui(pc, pf_axiom(allP), c)
    // MP: Q(c).
    let qc = term_pred("Q", c)
    let mp = pf_mp(qc, ui1, ui2)
    // UG: forall x.Q(x)  (c occurs in neither axiom -> arbitrary).
    let allQ = term_forall("x", term_pred("Q", term_var("x")))
    let ug = pf_ug(allQ, mp, c)
    ce_eq("UG: all-P-are-Q + all-P |- all-Q",
        verify_check(reg, axs, hyp_new(), ug, allQ), 1)
}

// UG must reject if the generalized constant still occurs in the body B (partial
// generalization is not allowed).
fn test_ug_rejects_const_in_body() {
    let reg = proof_registry_new()
    // sub proves P(c) ; try to conclude forall x. P(c) (body still mentions c).
    let pc = term_pred("P", term_atom("c"))
    let weird = term_forall("x", term_pred("P", term_atom("c")))  // x unused, c present
    let bogus = pf_ug(weird, pf_axiom(pc), term_atom("c"))
    ce_eq("UG with const still in body REJECTED",
        verify_check(reg, _ax(pc), hyp_new(), bogus, weird), 0)
}

// UG via a HYP whose lemma mentions c also fails the eigenvariable check.
fn test_ug_eigenvariable_through_hyp() {
    let reg = proof_registry_new()
    let pc = term_pred("P", term_atom("c"))
    let code = proof_register(reg, "pc", list_new(), "")
    proof_set_status(reg, code, PROOF_VERIFIED)
    let hyps = hyp_new() hyp_add(hyps, "pc", pc, code)
    let univ = term_forall("x", term_pred("P", term_var("x")))
    let bogus = pf_ug(univ, pf_hyp(pc, "pc"), term_atom("c"))
    ce_eq("UG over a HYP mentioning c REJECTED",
        verify_check(reg, axiom_table_new(), hyps, bogus, univ), 0)
}

// ---- increment 20: overflow safety (a soundness guard) ---------------------
fn test_arith_overflow_refused() {
    let reg = proof_registry_new()
    // A safe large product still verifies: 1000000 * 1000000 = 1000000000000.
    let big = term_equals(term_mul(term_num(1000000), term_num(1000000)),
                          term_num(1000000000000))
    ce_eq("1e6 * 1e6 = 1e12 verifies (in range)",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(big), big), 1)
    // A product that overflows 63-bit: 2^32 * 2^32 = 2^64. Whatever the claimed
    // RHS, the kernel must REFUSE (the exactness check fails on the wrapped
    // product) -- never silently accept a wrong value.
    let huge = term_mul(term_num(4294967296), term_num(4294967296))
    let claim = term_equals(huge, term_num(0))   // 2^64 wraps to 0 in 64-bit
    ce_eq("2^32 * 2^32 = 0 (wrap) REFUSED",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(claim), claim), 0)
    // And refused for ANY claimed product, including a plausible-looking one.
    let claim2 = term_equals(huge, term_num(123456789))
    ce_eq("overflowing product refused for any RHS",
        verify_check(reg, axiom_table_new(), hyp_new(), pf_eval(claim2), claim2), 0)
}

// term_eq on quantifier terms.
fn test_term_eq_quantifiers() {
    ce_eq("var eq by name", term_eq(term_var("x"), term_var("x")), 1)
    ce_eq("var neq by name", term_eq(term_var("x"), term_var("y")), 0)
    ce_eq("pred eq", term_eq(term_pred("P", term_atom("a")),
                            term_pred("P", term_atom("a"))), 1)
    ce_eq("pred neq by name", term_eq(term_pred("P", term_atom("a")),
                                     term_pred("Q", term_atom("a"))), 0)
    ce_eq("forall structural",
        term_eq(term_forall("x", term_pred("P", term_var("x"))),
                term_forall("x", term_pred("P", term_var("x")))), 1)
    ce_eq("forall != exists",
        term_eq(term_forall("x", term_pred("P", term_var("x"))),
                term_exists("x", term_pred("P", term_var("x")))), 0)
}

// term_eq distinguishes numeric literals by value and arithmetic kinds.
fn test_term_eq_arith() {
    ce_eq("num eq by value", term_eq(term_num(4), term_num(4)), 1)
    ce_eq("num neq by value", term_eq(term_num(4), term_num(5)), 0)
    ce_eq("add structural",
        term_eq(term_add(term_num(1), term_num(2)),
                term_add(term_num(1), term_num(2))), 1)
    ce_eq("add != mul (same children)",
        term_eq(term_add(term_num(1), term_num(2)),
                term_mul(term_num(1), term_num(2))), 0)
}

fn main() {
    test_term_eq()
    test_axiom_accepts_registered()
    test_axiom_rejects_unregistered()
    test_and_intro_and_elim()
    test_modus_ponens()
    test_modus_ponens_antecedent_mismatch()
    test_hyp_lemma_verified()
    test_hyp_lemma_unverified()
    test_hyp_lemma_label_mismatch()
    test_pin_atom_on_success()
    test_pin_atom_on_failure()
    test_recheck_unpins_on_failure()
    test_recheck_on_passing_proof_keeps_pin()
    test_term_eq_new_kinds()
    test_or_introduction()
    test_biconditional()
    test_hypothetical_syllogism()
    test_arith_eval_accepts_true_equality()
    test_arith_eval_rejects_false_equality()
    test_arith_eval_rejects_nonarithmetic()
    test_arith_sub_and_div()
    test_term_eq_arith()
    test_universal_instantiation()
    test_ui_on_implication()
    test_ui_rejects_open_instantiation()
    test_ui_requires_forall()
    test_existential_introduction()
    test_ui_then_ei_compose()
    test_socrates_syllogism()
    test_ug_rejects_instance_generalization()
    test_ug_valid_derivation()
    test_ug_rejects_const_in_body()
    test_ug_eigenvariable_through_hyp()
    test_arith_overflow_refused()
    test_term_eq_quantifiers()
    ce_summary("verify")
}

main()
