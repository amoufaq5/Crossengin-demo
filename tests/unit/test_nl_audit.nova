// Unit tests for nl_audit.nova: contested answers leave a decision-log entry.
//
// The KG-driven path (nlq_respond_audited(kg, aliases, text, log, moment)) hits
// the bootstrap launcher's KG-construct-at-scale limit -- the same constraint
// test_steelman / test_debate / test_decision_record's KG cases hit -- so the
// audit semantics are exercised by:
//   (a) the answer carries its claim id out (nlq_claim), confirmed at the
//       synthetic-dargs layer; and
//   (b) the recorder's behaviour on a precomputed debate trace, confirmed
//       directly against the decision log.
// The two halves the wrapper composes are each green here; the wrapper itself
// is compile-verified.

import "../ce_test.nova"
import "../../src/language/nl_audit.nova"

fn _ds2(a, b) {
    let l = list_new()
    push(l, a) push(l, b)
    return l
}

// The contested-answerer must carry the claim id out so the wrapper can rebuild
// the trace for the log without recomputing.
fn test_claim_id_carried() {
    let ds = _ds2(darg_new(42, 1, 800, 0, 0 - 1, 0 - 1),
                  darg_new(42, 0 - 1, 600, 0, 0 - 1, 0 - 1))
    let a = _nlq_contested_from_dargs(ds, 42, "policy_X")
    ce_check("answer returned", a != 0)
    ce_eq("CONTESTED form", nlq_aform(a), NLQ_CONTESTED)
    ce_eq("claim id carried", nlq_claim(a), 42)
}

// A non-contested answer carries no claim id (default -1), so the wrapper
// short-circuits without writing a log entry.
fn test_no_claim_when_not_contested() {
    let a = _nlq_no(NLQ_WHAT, "i don't know x yet")
    ce_eq("claim is -1 by default", nlq_claim(a), 0 - 1)
}

// The recorder side: given a precomputed contested debate trace, one
// DLK_DECISION entry lands in the log with the expected payload. (This is the
// same shape nlq_respond_audited would write, just bypassing the broken
// construct_arguments-from-KG step under this launcher.)
fn test_records_contested_debate() {
    let ds = _ds2(darg_new(42, 1, 800, 0, 0 - 1, 0 - 1),
                  darg_new(42, 0 - 1, 600, 0, 0 - 1, 0 - 1))
    let log = dl_new()
    let tr = debate_trace_build(ds, 42)
    dlog_record_debate(log, tr, 7777)
    ce_eq("one entry", dl_count(log), 1)
    let e = dl_get(log, 0)
    ce_eq("kind decision", dl_kind(e), DLK_DECISION)
    ce_eq("subtype debate", drec_subtype(e), DREC_DEBATE)
    ce_eq("claim id on entry", drec_claim(e), 42)
    ce_eq("contested flag set", drec_flag(e), 1)
    ce_eq("contested -> VETOED", dl_outcome(e), OUT_VETOED)
    ce_eq("chain intact", dl_verify(log), 1)
}

// A non-contested decided answer takes the normal path -- if the wrapper is
// called with a log, no DLK_DECISION entry is written (the per-effector audit
// path is the right substrate for non-reasoning actions).
fn test_no_write_when_uncontested() {
    let log = dl_new()
    // Simulate nlq_respond_audited's short-circuit: a non-CONTESTED answer
    // never reaches dlog_record_atom_debate, so the log stays empty.
    let a = _nlq_no(NLQ_WHAT, "no fact")
    if nlq_aform(a) == NLQ_CONTESTED {
        // unreachable here; this is the wrapper's gate.
        ce_check("wrapper would record", 1 == 1)
    }
    ce_eq("log stays empty", dl_count(log), 0)
}

fn main() {
    test_claim_id_carried()
    test_no_claim_when_not_contested()
    test_records_contested_debate()
    test_no_write_when_uncontested()
    ce_summary("nl_audit")
}

main()
