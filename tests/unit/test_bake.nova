// Unit tests for src/factory/bake.nova (R99).
//
// End-to-end: build a mini fixture (personas + capsules + skills +
// patterns + policies + a small KG), craft a manifest, call
// bake_child, verify bundle shape + signature + section contents.

import "../ce_test.nova"
import "../../src/factory/bake.nova"
import "../../src/factory/bake_manifest.nova"
import "../../src/persistence/bundle_signing.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/persona/persona.nova"
import "../../src/persona/persona_registry.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/ingest/policy.nova"
import "../../src/safety/ed25519.nova"
import "../../src/util/str_safe.nova"

// Shared keypair (generated once per test process).
let _kp = 0
fn _kp_seed() {
    if _kp == 0 { _kp = ed25519_keygen() }
    return _kp[0]
}
fn _kp_pk() {
    if _kp == 0 { _kp = ed25519_keygen() }
    return _kp[1]
}

fn _mk_kgreg() {
    let r = kg_registry_new()
    let kg1 = kg_spawn(r, "solar_system")
    let a1 = kg_add_atom(kg1, ATOM_FACT, "mars", 0)
    atom_set_license(a1, LICENSE_OPEN)
    let a2 = kg_add_atom(kg1, ATOM_FACT, "phobos", 0)
    atom_set_license(a2, LICENSE_OPEN)
    let a3 = kg_add_atom(kg1, ATOM_FACT, "deimos", 0)
    return r
}

fn _mk_capreg() {
    let r = capreg_new()
    let c1 = capsule_new("solar_system", "1.0.0", "system", "OPEN")
    capreg_register(r, c1)
    let c2 = capsule_new("physics", "0.1.0", "physics", "OPEN")
    capreg_register(r, c2)
    let c3 = capsule_new("private_notes", "0.1.0", "private", "PROPRIETARY")
    capreg_register(r, c3)
    return r
}

fn _mk_persona_reg() {
    let r = persona_registry_new()
    persona_registry_ensure(r, "alice", 100)
    persona_registry_ensure(r, "bob", 100)
    persona_registry_ensure(r, "carol", 100)
    return r
}

fn _mk_skill_reg() {
    let r = skill_registry_new()
    let m1 = skill_manifest_new("echo_skill", "1.0", "echo", 1)
    skill_registry_register(r, m1)
    let m2 = skill_manifest_new("research_skill", "1.0", "research", 2)
    skill_registry_register(r, m2)
    let m3 = skill_manifest_new("private_skill", "1.0", "private", 3)
    skill_registry_register(r, m3)
    return r
}

fn _mk_policy_reg() {
    let r = policy_registry_new()
    let p1 = policy_new("auto_open", 0)
    policy_registry_register(r, p1)
    let p2 = policy_new("auto_wiki", 0)
    policy_registry_register(r, p2)
    return r
}

fn _mk_overlay() {
    let r = ownership_registry_new()
    ownership_set_capsule(r, "solar_system", "alice")
    ownership_set_capsule(r, "private_notes", "bob")
    ownership_set_skill(r, "echo_skill", "alice")
    return r
}

fn _mk_manifest_full() {
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "solar-child")
    bake_manifest_set_version(m, "0.1.0")
    bake_manifest_set_domain(m, "astronomy")
    bake_manifest_add_capsule(m, "solar_system")
    bake_manifest_add_capsule(m, "physics")
    bake_manifest_add_skill(m, "echo_skill")
    bake_manifest_add_persona(m, "alice")
    bake_manifest_add_persona(m, "bob")
    bake_manifest_add_policy(m, "auto_open")
    bake_manifest_add_kg_prefix(m, "solar_")
    return m
}

fn _has(s, needle) {
    if find_bytes(s, needle) >= 0 { return 1 }
    return 0
}

fn test_bake_success_shape() {
    let m = _mk_manifest_full()
    let br = bake_child(m,
        _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
        _kp_seed(), _kp_pk(), 12345)
    ce_eq("bake ok", bake_result_ok(br), 1)
    let bundle = bake_result_bundle(br)
    ce_check("has header", _has(bundle, "#CROSSENGIN-CHILD-BUNDLE v1"))
    ce_check("has name",    _has(bundle, "#name solar-child"))
    ce_check("has version", _has(bundle, "#version 0.1.0"))
    ce_check("has domain",  _has(bundle, "#domain astronomy"))
    ce_check("has baked-at", _has(bundle, "#baked-at 12345"))
    ce_check("has fingerprint", _has(bundle, "#mother-fingerprint "))
    ce_check("has PERSONA v1",   _has(bundle, "#PERSONA v1"))
    ce_check("has OWNERSHIP v1", _has(bundle, "#OWNERSHIP v1"))
    ce_check("has POLICY v1",    _has(bundle, "#POLICY v1"))
    ce_check("has SKILL v1",     _has(bundle, "#SKILL v1"))
    ce_check("has KG v1",        _has(bundle, "#KG v1"))
    ce_check("has CAPSULE v1",   _has(bundle, "#CAPSULE v1"))
    ce_check("has SIGNATURE",    _has(bundle, "#SIGNATURE "))
    ce_check("has SIGNER-PK",    _has(bundle, "#SIGNER-PK "))
    // The plan REQUIRES NO CAPS v1 (bearer tokens) and NO TRUST v1
    // (mother trust anchors) in the child bundle.
    ce_eq("no CAPS v1", _has(bundle, "#CAPS v1"), 0)
    ce_eq("no TRUST v1", _has(bundle, "#TRUST v1"), 0)
}

fn test_bake_counts() {
    let m = _mk_manifest_full()
    let br = bake_child(m,
        _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
        _kp_seed(), _kp_pk(), 100)
    ce_eq("2 personas (alice+bob)",  bake_result_personas(br), 2)
    ce_eq("2 capsules",              bake_result_capsules(br), 2)
    ce_eq("1 skill (echo)",          bake_result_skills(br), 1)
    ce_eq("1 policy (auto_open)",    bake_result_policies(br), 1)
    // Ownership entries that survive: solar_system(cap), echo_skill(skill)
    // (private_notes is not in cap allowlist).
    ce_eq("2 ownership entries", bake_result_ownership(br), 2)
    // KG atoms: solar_ prefix matches all 3 in solar_system.
    ce_eq("3 KG atoms via solar_ prefix", bake_result_kg_atoms(br), 3)
    ce_eq("sig 64B", bake_result_sig_len(br), 64)
}

fn test_bake_signature_verifies() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    ce_eq("bake ok", bake_result_ok(br), 1)
    let bundle = bake_result_bundle(br)
    let v = bake_verify_bundle(bundle, _kp_pk())
    ce_eq("verify ok", v[0], 1)
    ce_str_eq("no err", v[1], "")
}

fn test_bake_tampered_bundle_refused() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    let bundle = bake_result_bundle(br)
    // Flip a byte early in the bundle (after the header).
    let flipped = ""
    let i = 0
    while i < len(bundle) {
        if i == 100 {
            let c = char_at(bundle, i)
            let nc = c + 1
            if nc > 122 { nc = c - 1 }
            flipped = flipped + chr(nc)
        } else {
            flipped = flipped + substr(bundle, i, 1)
        }
        i = i + 1
    }
    let v = bake_verify_bundle(flipped, _kp_pk())
    ce_eq("tampered refused", v[0], 0)
}

fn test_bake_wrong_signer_refused() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    let bundle = bake_result_bundle(br)
    // Verify under a DIFFERENT pk (flip a byte in the real pk).
    let real_pk = _kp_pk()
    let bad_pk = list_new()
    let i = 0
    while i < len(real_pk) { push(bad_pk, real_pk[i]) i = i + 1 }
    bad_pk[0] = bad_pk[0] + 1
    let v = bake_verify_bundle(bundle, bad_pk)
    ce_eq("wrong signer refused", v[0], 0)
}

fn test_bake_empty_manifest_allowlists() {
    // Manifest with 0 personas / 0 capsules / etc. -- still validates
    // + still bakes; the bundle carries empty-of-that-kind sections.
    let m = bake_manifest_new()
    bake_manifest_set_name(m, "empty")
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "x")
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    ce_eq("bake ok", bake_result_ok(br), 1)
    ce_eq("0 personas",  bake_result_personas(br), 0)
    ce_eq("0 capsules",  bake_result_capsules(br), 0)
    ce_eq("0 skills",    bake_result_skills(br), 0)
    ce_eq("0 policies",  bake_result_policies(br), 0)
    ce_eq("0 kg atoms",  bake_result_kg_atoms(br), 0)
    ce_eq("0 ownership", bake_result_ownership(br), 0)
    let bundle = bake_result_bundle(br)
    // Header + signature footer still present.
    ce_check("header",    _has(bundle, "#CROSSENGIN-CHILD-BUNDLE v1"))
    ce_check("signature", _has(bundle, "#SIGNATURE "))
    // Verifiable.
    let v = bake_verify_bundle(bundle, _kp_pk())
    ce_eq("verify ok", v[0], 1)
}

fn test_bake_missing_signer_seed_refused() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        0, _kp_pk(), 5)
    ce_eq("null seed refused", bake_result_ok(br), 0)
}

fn test_bake_null_manifest() {
    let br = bake_child(0, 0, 0, 0, 0, 0, 0, _kp_seed(), _kp_pk(), 5)
    ce_eq("null manifest refused", bake_result_ok(br), 0)
}

fn test_bake_invalid_manifest_refused() {
    let m = bake_manifest_new()
    // No NAME set -> validate fails.
    bake_manifest_set_version(m, "1")
    bake_manifest_set_domain(m, "x")
    let br = bake_child(m, 0, 0, 0, 0, 0, 0, _kp_seed(), _kp_pk(), 5)
    ce_eq("invalid refused", bake_result_ok(br), 0)
    ce_check("err mentions NAME", find_bytes(bake_result_err(br), "NAME") >= 0)
}

fn test_bake_persona_content_correct() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    let bundle = bake_result_bundle(br)
    ce_check("alice in bundle", _has(bundle, "USER alice"))
    ce_check("bob in bundle",   _has(bundle, "USER bob"))
    ce_eq("carol NOT in bundle", _has(bundle, "USER carol"), 0)
}

fn test_bake_kg_atom_content() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    let bundle = bake_result_bundle(br)
    ce_check("ATOM mars",   _has(bundle, "ATOM solar_system 0 "))
    ce_check("label mars",  _has(bundle, " mars\n"))
    ce_check("label phobos", _has(bundle, " phobos\n"))
    ce_check("label deimos", _has(bundle, " deimos\n"))
}

fn test_bake_ownership_filtered() {
    let m = _mk_manifest_full()
    let br = bake_child(m, _mk_persona_reg(), _mk_kgreg(), _mk_capreg(),
                        _mk_skill_reg(), _mk_policy_reg(), _mk_overlay(),
                        _kp_seed(), _kp_pk(), 5)
    let bundle = bake_result_bundle(br)
    // Allowed: capsule/solar_system + skill/echo_skill
    ce_check("owns solar_system", _has(bundle, "capsule solar_system alice"))
    ce_check("owns echo_skill",   _has(bundle, "skill echo_skill alice"))
    // NOT allowed: capsule/private_notes (not in cap allowlist)
    ce_eq("no private_notes owner", _has(bundle, "private_notes"), 0)
}

fn main() {
    test_bake_success_shape()
    test_bake_counts()
    test_bake_signature_verifies()
    test_bake_tampered_bundle_refused()
    test_bake_wrong_signer_refused()
    test_bake_empty_manifest_allowlists()
    test_bake_missing_signer_seed_refused()
    test_bake_null_manifest()
    test_bake_invalid_manifest_refused()
    test_bake_persona_content_correct()
    test_bake_kg_atom_content()
    test_bake_ownership_filtered()
    ce_summary("bake")
}

main()
