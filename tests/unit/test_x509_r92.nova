// Unit tests for src/net/tls/x509.nova (R92 X.509 subset parser +
// chain verifier). Complements the older DTLS-1.2-facing
// tests/unit/test_x509.nova, which covers src/safety/x509.nova
// (ECDSA-P-256 profile). This file covers the Ed25519 profile the
// R86 TLS 1.3 suite chose.
//
// Coverage plan
//   * Time parsing
//       - UTCTime YY < 50 -> 2000+YY (e.g. 490101 -> 2049).
//       - UTCTime YY >= 50 -> 1900+YY (e.g. 500101 -> 1950).
//       - UTCTime malformed length / non-Z suffix rejected.
//       - GeneralizedTime "20200229120000Z" (leap year) correct.
//       - GeneralizedTime "19700101000000Z" -> unix 0.
//       - GeneralizedTime non-Z suffix rejected.
//   * Round-trip via x509_build_test_cert:
//       - Parse OK; all extracted fields correct.
//       - SPKI Ed25519 OID recognized; sig-alg Ed25519 recognized.
//       - x509_verify_self_signed on the root -> 1.
//       - x509_verify_signed_by leaf-by-root -> 1.
//       - x509_check_validity: inside window -> 1; before -> 0;
//         after -> 0; exactly at notBefore -> 1; at notAfter -> 1.
//       - x509_check_issuer matching -> 1; mismatched -> 0.
//       - x509_chain_verify happy path -> 1.
//   * Tamper cases
//       - Flip a sig bit -> chain_verify 0.
//       - Flip a TBS bit -> chain_verify 0.
//       - Swap in a wrong root -> chain_verify 0.
//       - Expired cert -> chain_verify 0.
//       - Self-signed leaf (leaf == root byte-equal) -> chain_verify 0.
//   * Format rejections
//       - Non-Ed25519 sig alg (RSA-shaped OID) -> parse fails.
//       - Critical unknown extension -> parse fails.
//       - Non-critical unknown extension -> parse OK.
//       - Non-Z GeneralizedTime notBefore -> parse fails.

import "../ce_test.nova"
import "../../src/net/tls/der.nova"
import "../../src/net/tls/x509.nova"
import "./fixtures/x509_test_certs.nova"

// ---- helpers -------------------------------------------------------------

// Byte-list mutation copy with a single bit flipped at bit index
// `bit` of byte `off`.
fn _tx_flip(bytes, off, bit) {
    let out = list_new()
    let i = 0
    let n = len(bytes)
    while i < n {
        push(out, bytes[i])
        i = i + 1
    }
    list_set(out, off, int_xor(out[off], int_shl(1, bit)))
    return out
}

// ---- time parsing --------------------------------------------------------

fn test_utctime_2049() {
    // "490101000000Z"
    let buf = list_new()
    push(buf, 52); push(buf, 57); push(buf, 48); push(buf, 49)
    push(buf, 48); push(buf, 49); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 48); push(buf, 48)
    push(buf, 90)
    let out = list_new(); push(out, 0)
    ce_eq("UTCTime YY=49 parse OK",
          x509_parse_utctime(buf, 0, 13, out), DER_OK)
    // 2049-01-01 00:00:00 UTC:
    //   Hinnant days_from_civil(2049, 1, 1):
    //     yy = 2048 (m<=2 so y-=1)
    //     era = int_div(2048, 400) = 5
    //     yoe = 2048 - 2000 = 48
    //     mm = 1 + 9 = 10 (Mar-based month index for pre-March dates)
    //     doy = int_div(153*10 + 2, 5) + 1 - 1 = 306
    //     doe = 48*365 + 12 - 0 + 306 = 17838
    //     days = 5*146097 + 17838 - 719468 = 28855
    //     seconds = 28855 * 86400 = 2493072000.
    ce_eq("UTCTime YY=49 -> 2049-01-01 unix", out[0], 2493072000)
}

fn test_utctime_1950() {
    // "500101000000Z"
    let buf = list_new()
    push(buf, 53); push(buf, 48); push(buf, 48); push(buf, 49)
    push(buf, 48); push(buf, 49); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 48); push(buf, 48)
    push(buf, 90)
    let out = list_new(); push(out, 0)
    ce_eq("UTCTime YY=50 parse OK",
          x509_parse_utctime(buf, 0, 13, out), DER_OK)
    // 1950-01-01 UTC. days = -7305, seconds = -631152000.
    ce_eq("UTCTime YY=50 -> 1950-01-01 unix",
          out[0], 0 - 631152000)
}

fn test_utctime_non_z_rejected() {
    // Replace Z with '+' -> reject.
    let buf = list_new()
    push(buf, 50); push(buf, 51); push(buf, 48); push(buf, 49)
    push(buf, 48); push(buf, 49); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 48); push(buf, 48)
    push(buf, 43)   // '+'
    let out = list_new(); push(out, 0)
    ce_eq("UTCTime non-Z suffix rejected",
          x509_parse_utctime(buf, 0, 13, out), DER_ERR)
}

fn test_utctime_bad_length_rejected() {
    let buf = list_new()
    push(buf, 50); push(buf, 51); push(buf, 48); push(buf, 49)
    let out = list_new(); push(out, 0)
    ce_eq("UTCTime too-short rejected",
          x509_parse_utctime(buf, 0, 4, out), DER_ERR)
}

fn test_utctime_bad_digit_rejected() {
    // Insert a non-digit in the year slot.
    let buf = list_new()
    push(buf, 65); push(buf, 51); push(buf, 48); push(buf, 49)  // 'A' 3 0 1
    push(buf, 48); push(buf, 49); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 48); push(buf, 48)
    push(buf, 90)
    let out = list_new(); push(out, 0)
    ce_eq("UTCTime non-digit rejected",
          x509_parse_utctime(buf, 0, 13, out), DER_ERR)
}

fn test_generalizedtime_1970() {
    // "19700101000000Z"
    let buf = list_new()
    push(buf, 49); push(buf, 57); push(buf, 55); push(buf, 48)
    push(buf, 48); push(buf, 49); push(buf, 48); push(buf, 49)
    push(buf, 48); push(buf, 48); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 90)
    let out = list_new(); push(out, 0)
    ce_eq("GeneralizedTime 1970-01-01 parse OK",
          x509_parse_generalizedtime(buf, 0, 15, out), DER_OK)
    ce_eq("GeneralizedTime 1970-01-01 -> unix 0", out[0], 0)
}

fn test_generalizedtime_leap_year() {
    // "20200229120000Z"
    let buf = list_new()
    push(buf, 50); push(buf, 48); push(buf, 50); push(buf, 48)
    push(buf, 48); push(buf, 50); push(buf, 50); push(buf, 57)
    push(buf, 49); push(buf, 50); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 90)
    let out = list_new(); push(out, 0)
    ce_eq("GeneralizedTime 2020-02-29 12:00 parse OK",
          x509_parse_generalizedtime(buf, 0, 15, out), DER_OK)
    // Expected unix seconds for 2020-02-29 12:00:00 UTC = 1582977600.
    ce_eq("GeneralizedTime 2020-02-29 12:00 -> unix",
          out[0], 1582977600)
}

fn test_generalizedtime_non_z_rejected() {
    // "20200229120000+" (14 bytes + '+') -> length mismatch and
    // non-Z; the length gate fires first, both are rejections.
    let buf = list_new()
    push(buf, 50); push(buf, 48); push(buf, 50); push(buf, 48)
    push(buf, 48); push(buf, 50); push(buf, 50); push(buf, 57)
    push(buf, 49); push(buf, 50); push(buf, 48); push(buf, 48)
    push(buf, 48); push(buf, 48); push(buf, 43)
    let out = list_new(); push(out, 0)
    ce_eq("GeneralizedTime non-Z suffix rejected",
          x509_parse_generalizedtime(buf, 0, 15, out), DER_ERR)
}

// ---- round-trip: parse + verify -----------------------------------------
//
// Build a self-signed ROOT using RFC 8032 TEST 1 keys, and a LEAF signed
// by that root using RFC 8032 TEST 2 keys. Then run every check.
//
// Validity window: 2020-01-01 .. 2049-01-01 (spans "now" for the test
// runner). "now" is a hardcoded 2024-06-15 12:00:00 UTC (sandbox
// cannot call nanotime; R91 confirmed nanotime segfaults).

// Constants: hardcoded unix timestamps used by the tests. Container
// cannot query system time (R91 caveat), so these are baked in.
let _TX_NOW_2024_06_15 = 1718452800   // 2024-06-15 12:00:00 UTC
let _TX_NB_2020_01_01  = 1577836800   // 2020-01-01 00:00:00 UTC
let _TX_NA_2049_01_01  = 2493072000   // 2049-01-01 00:00:00 UTC
let _TX_BEFORE_2020    = 1546300800   // 2019-01-01 00:00:00 UTC
let _TX_AFTER_2049     = 2524608000   // 2050-01-01 00:00:00 UTC

// Build the module-level root/leaf pair via lazy init.
let _TX_ROOT_CACHE = list_new()
let _TX_LEAF_CACHE = list_new()

fn _tx_root_cert() {
    if len(_TX_ROOT_CACHE) == 0 {
        let root_pk = fx_ed25519_test1_pub()
        let root_sk = fx_ed25519_test1_seed()
        let c = x509_build_test_cert("TestRoot", "TestRoot", 1,
                                     "200101000000Z", "490101000000Z",
                                     root_pk, root_sk, root_pk)
        let i = 0
        let n = len(c)
        while i < n { push(_TX_ROOT_CACHE, c[i]); i = i + 1 }
    }
    return _TX_ROOT_CACHE
}

fn _tx_leaf_cert() {
    if len(_TX_LEAF_CACHE) == 0 {
        let leaf_pk = fx_ed25519_test2_pub()
        let root_sk = fx_ed25519_test1_seed()
        let root_pk = fx_ed25519_test1_pub()
        let c = x509_build_test_cert("TestLeaf", "TestRoot", 2,
                                     "200101000000Z", "490101000000Z",
                                     leaf_pk, root_sk, root_pk)
        let i = 0
        let n = len(c)
        while i < n { push(_TX_LEAF_CACHE, c[i]); i = i + 1 }
    }
    return _TX_LEAF_CACHE
}

fn test_root_parse_fields() {
    let root = _tx_root_cert()
    let p = x509_parsed_new()
    ce_eq("root parse OK", x509_parse(root, len(root), p), DER_OK)
    ce_eq("root SPKI alg is Ed25519", x509_parsed_spki_alg_ok(p), 1)
    ce_eq("root sig alg is Ed25519", x509_parsed_sig_alg_ok(p), 1)
    ce_eq("root not_before = 2020-01-01",
          x509_parsed_not_before(p), _TX_NB_2020_01_01)
    ce_eq("root not_after = 2049-01-01",
          x509_parsed_not_after(p), _TX_NA_2049_01_01)
    ce_eq("root serial length 1", p[X509_IDX_SERIAL_LEN], 1)
    ce_eq("root serial byte", root[p[X509_IDX_SERIAL_OFF]], 1)
    ce_eq("root subject_cn length", p[X509_IDX_SUBJECT_CN_LEN], 8)
    ce_eq("root issuer_cn length", p[X509_IDX_ISSUER_CN_LEN], 8)
    // Check the CN bytes literally.
    ce_eq("root subject_cn byte 0 = 'T'",
          root[p[X509_IDX_SUBJECT_CN_OFF]], 84)
    ce_eq("root subject_cn byte 7 = 't'",
          root[p[X509_IDX_SUBJECT_CN_OFF] + 7], 116)
    ce_eq("root SPKI pubkey byte 0 matches TEST 1 pub",
          root[x509_parsed_pub_off(p)], 215)   // 0xd7 == 215
    ce_eq("root SPKI pubkey byte 31 matches TEST 1 pub",
          root[x509_parsed_pub_off(p) + 31], 26)   // 0x1a == 26
}

fn test_leaf_parse_fields() {
    let leaf = _tx_leaf_cert()
    let p = x509_parsed_new()
    ce_eq("leaf parse OK", x509_parse(leaf, len(leaf), p), DER_OK)
    ce_eq("leaf SPKI alg is Ed25519", x509_parsed_spki_alg_ok(p), 1)
    ce_eq("leaf sig alg is Ed25519", x509_parsed_sig_alg_ok(p), 1)
    ce_eq("leaf issuer_cn length", p[X509_IDX_ISSUER_CN_LEN], 8)
    ce_eq("leaf subject_cn length", p[X509_IDX_SUBJECT_CN_LEN], 8)
    ce_eq("leaf issuer_cn byte 4 = 'R'",
          leaf[p[X509_IDX_ISSUER_CN_OFF] + 4], 82)
    ce_eq("leaf subject_cn byte 4 = 'L'",
          leaf[p[X509_IDX_SUBJECT_CN_OFF] + 4], 76)
    // SPKI pubkey should equal RFC 8032 TEST 2 pub (first byte 0x3D=61,
    // last byte 0x0C=12).
    ce_eq("leaf SPKI pubkey byte 0 matches TEST 2 pub",
          leaf[x509_parsed_pub_off(p)], 61)
    ce_eq("leaf SPKI pubkey byte 31 matches TEST 2 pub",
          leaf[x509_parsed_pub_off(p) + 31], 12)
}

fn test_root_self_signature() {
    let root = _tx_root_cert()
    let p = x509_parsed_new()
    ce_eq("root parse OK (self-sig test)",
          x509_parse(root, len(root), p), DER_OK)
    ce_eq("root self-signature verifies",
          x509_verify_self_signed(root, p), 1)
}

fn test_leaf_signed_by_root() {
    let root = _tx_root_cert()
    let leaf = _tx_leaf_cert()
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    x509_parse(root, len(root), rp)
    x509_parse(leaf, len(leaf), lp)
    ce_eq("leaf signature verifies under root pubkey",
          x509_verify_signed_by(leaf, lp, root, rp[X509_IDX_SPKI_PUB_OFF]),
          1)
}

fn test_validity_window() {
    let root = _tx_root_cert()
    let p = x509_parsed_new()
    x509_parse(root, len(root), p)
    ce_eq("validity NOW inside window",
          x509_check_validity(p, _TX_NOW_2024_06_15), 1)
    ce_eq("validity 2019 before window",
          x509_check_validity(p, _TX_BEFORE_2020), 0)
    ce_eq("validity 2050 after window",
          x509_check_validity(p, _TX_AFTER_2049), 0)
    ce_eq("validity exactly at notBefore -> 1 (inclusive)",
          x509_check_validity(p, _TX_NB_2020_01_01), 1)
    ce_eq("validity exactly at notAfter -> 1 (inclusive)",
          x509_check_validity(p, _TX_NA_2049_01_01), 1)
    ce_eq("validity notBefore - 1 -> 0",
          x509_check_validity(p, _TX_NB_2020_01_01 - 1), 0)
    ce_eq("validity notAfter + 1 -> 0",
          x509_check_validity(p, _TX_NA_2049_01_01 + 1), 0)
}

fn test_issuer_check() {
    let root = _tx_root_cert()
    let leaf = _tx_leaf_cert()
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    x509_parse(root, len(root), rp)
    x509_parse(leaf, len(leaf), lp)
    ce_eq("leaf.issuer == root.subject", x509_check_issuer(lp, rp, leaf, root), 1)
    // Build a second root with a different CN; the check must fail.
    let other_pk = fx_ed25519_test1_pub()
    let other_sk = fx_ed25519_test1_seed()
    let other = x509_build_test_cert("OtherRoot", "OtherRoot", 1,
                                     "200101000000Z", "490101000000Z",
                                     other_pk, other_sk, other_pk)
    let op = x509_parsed_new()
    x509_parse(other, len(other), op)
    ce_eq("leaf.issuer != other-root.subject",
          x509_check_issuer(lp, op, leaf, other), 0)
}

fn test_chain_verify_happy() {
    let root = _tx_root_cert()
    let leaf = _tx_leaf_cert()
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    ce_eq("chain verify happy path",
          x509_chain_verify(leaf, len(leaf), root, len(root),
                            _TX_NOW_2024_06_15, lp, rp), 1)
}

// ---- tamper -------------------------------------------------------------

fn test_tamper_leaf_sig() {
    let root = _tx_root_cert()
    let leaf = _tx_leaf_cert()
    // Flip the last byte of the leaf cert (inside the sig BIT STRING).
    let tampered = _tx_flip(leaf, len(leaf) - 1, 0)
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    ce_eq("tampered leaf sig -> chain fails",
          x509_chain_verify(tampered, len(tampered), root, len(root),
                            _TX_NOW_2024_06_15, lp, rp), 0)
}

fn test_tamper_leaf_tbs() {
    let root = _tx_root_cert()
    let leaf = _tx_leaf_cert()
    // Parse to find TBS bounds, then flip a byte inside TBS.
    let p = x509_parsed_new()
    x509_parse(leaf, len(leaf), p)
    let tbs_mid = x509_parsed_tbs_off(p) + int_div(x509_parsed_tbs_len(p), 2)
    let tampered = _tx_flip(leaf, tbs_mid, 3)
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    ce_eq("tampered leaf TBS -> chain fails",
          x509_chain_verify(tampered, len(tampered), root, len(root),
                            _TX_NOW_2024_06_15, lp, rp), 0)
}

fn test_wrong_root() {
    let leaf = _tx_leaf_cert()
    // Build a different root (different keypair, same subject CN).
    // The signature check must still fail: root sig verifies under
    // its own pubkey, but leaf sig no longer matches this root's key.
    // Use TEST 2's keys as the "wrong root" -- distinct from real root.
    let wrong_pk = fx_ed25519_test2_pub()
    let wrong_sk = fx_ed25519_test2_seed()
    let wrong_root = x509_build_test_cert("TestRoot", "TestRoot", 3,
                                          "200101000000Z", "490101000000Z",
                                          wrong_pk, wrong_sk, wrong_pk)
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    ce_eq("wrong root -> chain fails (leaf sig doesn't match root pubkey)",
          x509_chain_verify(leaf, len(leaf), wrong_root, len(wrong_root),
                            _TX_NOW_2024_06_15, lp, rp), 0)
}

fn test_expired_cert() {
    let root = _tx_root_cert()
    let leaf = _tx_leaf_cert()
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    ce_eq("chain verify at 2019 (before window) -> fails",
          x509_chain_verify(leaf, len(leaf), root, len(root),
                            _TX_BEFORE_2020, lp, rp), 0)
    ce_eq("chain verify at 2050 (after window) -> fails",
          x509_chain_verify(leaf, len(leaf), root, len(root),
                            _TX_AFTER_2049, lp, rp), 0)
}

fn test_self_signed_leaf_refused() {
    // Use the same cert as both leaf and root -- chain verify must
    // refuse a byte-identical pair.
    let root = _tx_root_cert()
    let rp = x509_parsed_new()
    let lp = x509_parsed_new()
    ce_eq("byte-identical leaf/root (self-signed leaf) -> fails",
          x509_chain_verify(root, len(root), root, len(root),
                            _TX_NOW_2024_06_15, lp, rp), 0)
}

// ---- format rejections --------------------------------------------------

fn test_reject_non_ed25519_alg() {
    let pk = fx_ed25519_test1_pub()
    let bad = x509_build_test_cert_bad_alg("TestBad", "TestBad", 1,
                                           "200101000000Z", "490101000000Z",
                                           pk)
    let p = x509_parsed_new()
    ce_eq("non-Ed25519 alg -> parse fails",
          x509_parse(bad, len(bad), p), 0)
}

fn test_reject_critical_extension() {
    let pk = fx_ed25519_test1_pub()
    let sk = fx_ed25519_test1_seed()
    let c = x509_build_test_cert_with_ext("TestCrit", "TestCrit", 1,
                                          "200101000000Z", "490101000000Z",
                                          pk, sk, pk, 1)
    let p = x509_parsed_new()
    ce_eq("critical unknown extension -> parse fails",
          x509_parse(c, len(c), p), 0)
}

fn test_tolerate_noncritical_extension() {
    let pk = fx_ed25519_test1_pub()
    let sk = fx_ed25519_test1_seed()
    let c = x509_build_test_cert_with_ext("TestNC", "TestNC", 1,
                                          "200101000000Z", "490101000000Z",
                                          pk, sk, pk, 0)
    let p = x509_parsed_new()
    ce_eq("non-critical unknown extension -> parse OK",
          x509_parse(c, len(c), p), 1)
    ce_eq("noncrit-ext cert still self-signs",
          x509_verify_self_signed(c, p), 1)
}

fn test_reject_non_z_time_in_cert() {
    let pk = fx_ed25519_test1_pub()
    let sk = fx_ed25519_test1_seed()
    let c = x509_build_test_cert_non_z_time("TestT", "TestT", 1, pk, sk, pk)
    let p = x509_parsed_new()
    ce_eq("cert with non-Z time -> parse fails",
          x509_parse(c, len(c), p), 0)
}

fn test_reject_trailing_bytes() {
    // A well-formed cert with one extra byte at the tail -> parse fails.
    let root = _tx_root_cert()
    let tampered = list_new()
    let i = 0
    let n = len(root)
    while i < n { push(tampered, root[i]); i = i + 1 }
    push(tampered, 0)
    let p = x509_parsed_new()
    ce_eq("trailing byte past outer SEQUENCE -> parse fails",
          x509_parse(tampered, len(tampered), p), 0)
}

fn test_reject_cert_len_zero() {
    let p = x509_parsed_new()
    let empty = list_new()
    ce_eq("empty cert buf -> parse fails",
          x509_parse(empty, 0, p), 0)
}

// ---- main ---------------------------------------------------------------

fn main() {
    test_utctime_2049()
    test_utctime_1950()
    test_utctime_non_z_rejected()
    test_utctime_bad_length_rejected()
    test_utctime_bad_digit_rejected()
    test_generalizedtime_1970()
    test_generalizedtime_leap_year()
    test_generalizedtime_non_z_rejected()
    test_root_parse_fields()
    test_leaf_parse_fields()
    test_root_self_signature()
    test_leaf_signed_by_root()
    test_validity_window()
    test_issuer_check()
    test_chain_verify_happy()
    test_tamper_leaf_sig()
    test_tamper_leaf_tbs()
    test_wrong_root()
    test_expired_cert()
    test_self_signed_leaf_refused()
    test_reject_non_ed25519_alg()
    test_reject_critical_extension()
    test_tolerate_noncritical_extension()
    test_reject_non_z_time_in_cert()
    test_reject_trailing_bytes()
    test_reject_cert_len_zero()
    ce_summary("x509_r92")
}

main()
