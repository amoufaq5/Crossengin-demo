// Unit tests for src/safety/gf256.nova (GF(2^8), poly 0x11B).
//
// Expected values come from FIPS-197 4.2 and from an independent Python
// reference (carry-less multiply then reduce; plan A2.0 vectors). The whole
// 64 KiB multiplication table and the 256-byte inverse table are checked
// through their SHA-256 digests.

import "../ce_test.nova"
import "../../src/safety/gf256.nova"
import "../../src/safety/sha256.nova"
import "../../src/safety/chacha20.nova"

fn _g_mul(label, a, b, want) {
    ce_eq("mul " + label, gf256_mul(a, b), want)
}

fn _g_inv(label, a, want) {
    ce_eq("inv " + label, gf256_inv(a), want)
}

fn test_fips_products() {
    _g_mul("57*83", 87, 131, 193)      // 0x57*0x83 = 0xc1 (FIPS-197 4.2)
    _g_mul("57*13", 87, 19, 254)       // = 0xfe (FIPS-197 4.2.1)
    _g_mul("02*80", 2, 128, 27)        // = 0x1b
    _g_mul("80*80", 128, 128, 154)     // = 0x9a
    _g_mul("ff*ff", 255, 255, 19)      // = 0x13
    _g_mul("03*f6", 3, 246, 1)
    _g_mul("ca*53", 202, 83, 1)
    _g_mul("00*a5", 0, 165, 0)
    _g_mul("01*a5", 1, 165, 165)
    _g_mul("1b*1b", 27, 27, 94)        // = 0x5e
    _g_mul("b6*53", 182, 83, 54)       // = 0x36
    ce_eq("add is xor", gf256_add(87, 131), 212)
    ce_eq("inputs reduced to 8 bits", gf256_mul(87 + 256, 131 + 512), 193)
}

fn test_inverses() {
    _g_inv("00", 0, 0)
    _g_inv("01", 1, 1)
    _g_inv("02", 2, 141)      // 8d
    _g_inv("03", 3, 246)      // f6
    _g_inv("04", 4, 203)      // cb
    _g_inv("05", 5, 82)       // 52
    _g_inv("09", 9, 79)       // 4f
    _g_inv("10", 16, 116)     // 74
    _g_inv("53", 83, 202)     // ca
    _g_inv("80", 128, 131)    // 83
    _g_inv("8d", 141, 2)
    _g_inv("ca", 202, 83)
    _g_inv("f6", 246, 3)
    _g_inv("fe", 254, 65)     // 41
    _g_inv("ff", 255, 28)     // 1c
    let bad = 0
    let a = 1
    while a < 256 {
        if gf256_mul(a, gf256_inv(a)) != 1 { bad = bad + 1 }
        if gf256_div(a, a) != 1 { bad = bad + 1 }
        a = a + 1
    }
    ce_eq("a*inv(a)=1 and a/a=1 for all nonzero a", bad, 0)
    ce_eq("div by zero gives 0", gf256_div(7, 0), 0)
}

fn test_powers_of_3() {
    // 0x03 generates the multiplicative group: 01 03 05 0f 11 33 55 ff ...
    let want = [1, 3, 5, 15, 17, 51, 85, 255, 26, 46, 114, 150, 161, 248, 19, 53]
    let p = 1
    let i = 0
    let bad = 0
    while i < 16 {
        if p != want[i] { bad = bad + 1 }
        p = gf256_mul(p, 3)
        i = i + 1
    }
    ce_eq("exp3[0..15]", bad, 0)
    // order of 3 is 255: 3^255 = 1 and no smaller power is 1
    p = 3
    let first_one = 0
    i = 1
    while i <= 255 {
        if p == 1 {
            if first_one == 0 { first_one = i }
        }
        p = gf256_mul(p, 3)
        i = i + 1
    }
    ce_eq("order of 3 is 255", first_one, 255)
}

fn test_tables() {
    let inv = alloc(257)
    let a = 0
    while a < 256 {
        store8(inv + a, gf256_inv(a))
        a = a + 1
    }
    ce_str_eq("sha256(INV table)", cc_hex_encode_buf(sha256_oneshot(inv, 256), 32),
        "a0b6126fef317bb998059c2fca3dddb40f2422e049866c3df87f1fde4e70a132")
    let mul = alloc(65537)
    let sum = 0
    let comm_bad = 0
    a = 0
    while a < 256 {
        let b = 0
        while b < 256 {
            let p = gf256_mul(a, b)
            store8(mul + int_or(int_shl(a, 8), b), p)
            sum = sum + p
            if b < a {
                if load8(mul + int_or(int_shl(b, 8), a)) != p { comm_bad = comm_bad + 1 }
            }
            b = b + 1
        }
        a = a + 1
    }
    ce_eq("sum of all products", sum, 8323200)
    ce_eq("mul commutes", comm_bad, 0)
    ce_str_eq("sha256(MUL table)", cc_hex_encode_buf(sha256_oneshot(mul, 65536), 32),
        "14a1e7e77ca8a30b5bb53e6310748ce0498eb9e04ab78a44dbefb6ebfac8a84b")
}

fn test_distributive_sample() {
    let bad = 0
    let a = 0
    while a < 256 {
        let b = int_and(a * 37 + 11, 255)
        let c = int_and(a * 101 + 7, 255)
        let lhs = gf256_mul(a, gf256_add(b, c))
        let rhs = gf256_add(gf256_mul(a, b), gf256_mul(a, c))
        if lhs != rhs { bad = bad + 1 }
        a = a + 1
    }
    ce_eq("a(b+c) = ab + ac (256 samples)", bad, 0)
}

fn main() {
    test_fips_products()
    test_inverses()
    test_powers_of_3()
    test_tables()
    test_distributive_sample()
    ce_summary("gf256")
}

main()
