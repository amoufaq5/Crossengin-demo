// Unit tests for src/parts/soul/themes.nova
// Verifies theme add/update, reinforcement (capped), and dominant theme.
// ADR-0034.

import "../ce_test.nova"
import "../../src/parts/soul/themes.nova"

fn test_themes() {
    let s = soul_new("A")
    soul_add_theme(s, "helper", 600)
    soul_add_theme(s, "scholar", 400)
    ce_eq("two themes", soul_theme_count(s), 2)
    ce_eq("strength", soul_theme_strength(s, "helper"), 600)
    ce_str_eq("dominant", soul_dominant_theme(s), "helper")
    // Reinforce scholar past helper.
    soul_reinforce_theme(s, "scholar", 300)
    ce_eq("reinforced", soul_theme_strength(s, "scholar"), 700)
    ce_str_eq("new dominant", soul_dominant_theme(s), "scholar")
    // Reinforcement caps at 1.0.
    soul_reinforce_theme(s, "scholar", 500)
    ce_eq("capped", soul_theme_strength(s, "scholar"), 1000)
    // Reinforce unknown theme.
    ce_eq("unknown reinforce -> 0", soul_reinforce_theme(s, "ghost", 100), 0)
}

fn main() {
    test_themes()
    ce_summary("themes")
}

main()
