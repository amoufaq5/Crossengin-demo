fn test_status_line_shape() {
    let agent = ice_init(1)
    let st = ice_turn_init(agent, "203.0.113.10", 3478)
    let line = ice_turn_status_line(st)
    ce_check("status line non-empty", len(line) > 0)
    ce_check("status line begins with 'ice_turn:'",
             str_eq(substr(line, 0, 9), "ice_turn:") == 1)
}

fn test_status_line_after_success() {
    let agent = ice_init(1)
    let st = ice_turn_init(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    let relayed_buf = turn_ipv4_str_to_buf("198.51.100.50")
    let mapped_buf  = turn_ipv4_str_to_buf("192.0.2.77")
    let resp = turn_emit_allocate_success_response(txn, relayed_buf, 50001,
                                                   600, mapped_buf, 33445)
    ice_turn_handle_allocate_response(st, resp[0], resp[1])
    let line = ice_turn_status_line(st)
    ce_check("status line non-empty after success",
             len(line) > 0)
}

fn test_state_name_shim() {
    ce_str_eq("state idle name",
              _ice_turn_test_state_name(ICE_TURN_STATE_IDLE), "idle")
    ce_str_eq("state escalating name",
              _ice_turn_test_state_name(ICE_TURN_STATE_ESCALATING),
              "escalating")
    ce_str_eq("state allocated name",
              _ice_turn_test_state_name(ICE_TURN_STATE_ALLOCATED),
              "allocated")
    ce_str_eq("state failed name",
              _ice_turn_test_state_name(ICE_TURN_STATE_FAILED), "failed")
}

// ============================================================================
// ============================================================================
//        R36A -- 401 auto-retry with long-term credentials (R35D.2)
// ============================================================================
// ============================================================================

// Build a 401 Allocate Error response with REALM + NONCE attributes.
// Mirrors the test_turn helper but keeps this suite self-contained.
fn _itt_emit_401_with_attrs(txn, realm, nonce) {
    let reason = "Unauthorized"
    let reason_n = len(reason)
    let err_val_n = 4 + reason_n
    let rn = len(realm)
    let nn = len(nonce)
    let body = _turn_test_attr_size(err_val_n)
              + _turn_test_attr_size(rn)
              + _turn_test_attr_size(nn)
    let total = TURN_HDR_LEN + body
    let buf = alloc(total + 1)
    let i = 0
    while i < total { store8(buf + i, 0); i = i + 1 }
    store8(buf + total, 0)
    let mtype = turn_msg_type_pack(TURN_METHOD_ALLOCATE,
                                   TURN_CLASS_ERROR_RESP)
    _turn_test_put_u16(buf, 0, mtype)
    _turn_test_put_u16(buf, 2, body)
    _turn_test_put_u32(buf, 4, 554869826)
    i = 0
    while i < 12 { store8(buf + 8 + i, load8(txn + i)); i = i + 1 }
    let off = TURN_HDR_LEN
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_ERROR_CODE)
    _turn_test_put_u16(buf, off + 2, err_val_n)
    store8(buf + off + 4, 0)
    store8(buf + off + 5, 0)
    store8(buf + off + 6, 4)        // class
    store8(buf + off + 7, 1)        // number
    let k = 0
    while k < reason_n {
        store8(buf + off + 8 + k, char_at(reason, k))
        k = k + 1
    }
    off = off + _turn_test_attr_size(err_val_n)
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_REALM)
    _turn_test_put_u16(buf, off + 2, rn)
    k = 0
    while k < rn { store8(buf + off + 4 + k, char_at(realm, k)); k = k + 1 }
    off = off + _turn_test_attr_size(rn)
    _turn_test_put_u16(buf, off + 0, TURN_ATTR_NONCE)
    _turn_test_put_u16(buf, off + 2, nn)
    k = 0
    while k < nn { store8(buf + off + 4 + k, char_at(nonce, k)); k = k + 1 }
    off = off + _turn_test_attr_size(nn)
    let out = list_new()
    push(out, buf)
    push(out, total)
    return out
}

fn test_init_authed_state_shape() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    ce_check("init_authed state built", st != 0)
    ce_check("authed state has 23 slots", len(st) >= 23)
    ce_eq("auth_state = NONE at init",
          ice_turn_auth_state(st), ICE_TURN_AUTH_NONE)
    ce_eq("stats_auth_retries = 0 at init",
          ice_turn_stats_auth_retries(st), 0)
    ce_eq("auth_realm_buf = 0 at init",
          ice_turn_auth_realm_buf(st), 0)
    ce_eq("auth_nonce_buf = 0 at init",
          ice_turn_auth_nonce_buf(st), 0)
    ce_eq("auth_realm_n = 0 at init",
          ice_turn_auth_realm_n(st), 0)
    ce_eq("auth_nonce_n = 0 at init",
          ice_turn_auth_nonce_n(st), 0)
}

fn test_401_transitions_to_auth_pending() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    let resp = _itt_emit_401_with_attrs(txn, "ce-realm", "n01ce")
    let rc = ice_turn_handle_allocate_response_authed(st, resp[0], resp[1])
    ce_eq("401 -> AUTH_PENDING return tag",
          rc, ICE_TURN_RELAY_AUTH_PENDING)
    ce_eq("auth_state -> PENDING",
          ice_turn_auth_state(st), ICE_TURN_AUTH_PENDING)
    ce_eq("last_state -> AUTH_PENDING",
          ice_turn_last_state(st), ICE_TURN_STATE_AUTH_PENDING)
    ce_eq("last_event -> AUTH_PENDING",
          ice_turn_last_event(st), ICE_TURN_EVT_AUTH_PENDING)
    ce_eq("realm_n stashed = 8",
          ice_turn_auth_realm_n(st), 8)
    ce_eq("nonce_n stashed = 5",
          ice_turn_auth_nonce_n(st), 5)
    ce_check("realm_buf stashed (non-zero)",
             ice_turn_auth_realm_buf(st) != 0)
    ce_check("nonce_buf stashed (non-zero)",
             ice_turn_auth_nonce_buf(st) != 0)
    // The stash is a freshly-alloc'd copy, not a pointer into recv_buf.
    ce_eq("realm byte 0 = 'c'",
          load8(ice_turn_auth_realm_buf(st) + 0), 99)
    ce_eq("nonce byte 0 = 'n'",
          load8(ice_turn_auth_nonce_buf(st) + 0), 110)
    // Failed counter NOT bumped on auth-pending (it's not a failure).
    ce_eq("failed counter NOT bumped on 401-auth-pending",
          ice_turn_escalations_failed(st), 0)
}

fn test_credentialed_reemit_emits_authed_allocate() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    let resp = _itt_emit_401_with_attrs(txn, "ce-realm", "n01ce")
    ice_turn_handle_allocate_response_authed(st, resp[0], resp[1])
    let req2 = ice_turn_credentials(st, "alice", "secret")
    ce_check("ice_turn_credentials returned tuple",
             len(req2) == 2)
    ce_check("retry req size > 36 (auth attrs add bytes)",
             req2[1] > 36)
    ce_eq("stats_auth_retries bumped to 1",
          ice_turn_stats_auth_retries(st), 1)
    // Classify the retried packet to confirm it's a real Allocate Request.
    let cls = turn_classify_message(req2[0], req2[1])
    ce_eq("retry packet method = ALLOCATE",
          cls[0], TURN_METHOD_ALLOCATE)
    ce_eq("retry packet class = REQUEST",
          cls[1], TURN_CLASS_REQUEST)
    // The MI attr should be present at the tail.
    let walk = _turn_test_walk_attrs(req2[0], req2[1])
    let attrs = walk[1]
    ce_eq("retry packet attr count = 6",
          len(attrs), 6)
    ce_eq("retry attr[5] is MESSAGE-INTEGRITY",
          attrs[5][0], TURN_ATTR_MESSAGE_INTEGRITY)
    ce_eq("retry last_event = AUTH_RETRY",
          ice_turn_last_event(st), ICE_TURN_EVT_AUTH_RETRY)
}

fn test_credentialed_reemit_success_to_active() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    let resp1 = _itt_emit_401_with_attrs(txn, "ce-realm", "n01ce")
    ice_turn_handle_allocate_response_authed(st, resp1[0], resp1[1])
    ice_turn_credentials(st, "alice", "secret")
    // Server replies with a SUCCESS to the credentialed retry. Use the
    // SAME txn id (R36A uses the original txn for the retry to keep
    // correlation simple).
    let relayed_buf = turn_ipv4_str_to_buf("198.51.100.50")
    let mapped_buf  = turn_ipv4_str_to_buf("192.0.2.77")
    let resp2 = turn_emit_allocate_success_response(txn,
                                                    relayed_buf, 50001,
                                                    600,
                                                    mapped_buf, 33445)
    let rc = ice_turn_handle_allocate_response_authed(st,
                                                      resp2[0], resp2[1])
    ce_eq("post-credentials success -> RELAY_READY",
          rc, ICE_TURN_RELAY_READY)
    ce_eq("auth_state -> OK",
          ice_turn_auth_state(st), ICE_TURN_AUTH_OK)
    ce_eq("last_state -> ALLOCATED",
          ice_turn_last_state(st), ICE_TURN_STATE_ALLOCATED)
    ce_str_eq("relayed ip extracted",
              ice_turn_relayed_ip(st), "198.51.100.50")
    ce_eq("escalations_succeeded = 1",
          ice_turn_escalations_succeeded(st), 1)
    ce_eq("stats_auth_retries stays at 1",
          ice_turn_stats_auth_retries(st), 1)
}

fn test_second_401_classifies_relay_failed() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    let resp1 = _itt_emit_401_with_attrs(txn, "ce-realm", "n01ce")
    ice_turn_handle_allocate_response_authed(st, resp1[0], resp1[1])
    ice_turn_credentials(st, "alice", "WRONG-PASSWORD")
    // Server replies with ANOTHER 401 -- wrong creds.
    let resp2 = _itt_emit_401_with_attrs(txn, "ce-realm", "n01ce")
    let rc = ice_turn_handle_allocate_response_authed(st,
                                                      resp2[0], resp2[1])
    ce_eq("second 401 -> RELAY_FAILED",
          rc, ICE_TURN_RELAY_FAILED)
    ce_eq("auth_state -> FAILED",
          ice_turn_auth_state(st), ICE_TURN_AUTH_FAILED)
    ce_eq("last_state -> FAILED",
          ice_turn_last_state(st), ICE_TURN_STATE_FAILED)
    ce_eq("failed counter bumped",
          ice_turn_escalations_failed(st), 1)
    ce_eq("err code = 401",
          ice_turn_last_error_code(st), 401)
}

fn test_non_401_error_falls_through_to_r35d_handler() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    // Non-401 -- 437 Allocation Mismatch.
    let resp = turn_emit_allocate_error_response(txn, 4, 37,
                                                 "Allocation Mismatch")
    let rc = ice_turn_handle_allocate_response_authed(st, resp[0], resp[1])
    ce_eq("437 -> RELAY_FAILED via fall-through",
          rc, ICE_TURN_RELAY_FAILED)
    ce_eq("err code = 437",
          ice_turn_last_error_code(st), 437)
    ce_eq("auth_state remains NONE",
          ice_turn_auth_state(st), ICE_TURN_AUTH_NONE)
    ce_eq("stats_auth_retries = 0",
          ice_turn_stats_auth_retries(st), 0)
}

fn test_credentials_rejected_when_not_pending() {
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    // No 401 received yet -- auth_state is NONE. credentials() must
    // refuse to emit.
    let r = ice_turn_credentials(st, "alice", "secret")
    ce_eq("credentials when not PENDING -> 0", r, 0)
    ce_eq("stats_auth_retries NOT bumped",
          ice_turn_stats_auth_retries(st), 0)
}

fn test_success_first_try_skips_auth_path() {
    // The handler must still ACCEPT a successful Allocate response on
    // the first try (no 401 ever sent).
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    let relayed_buf = turn_ipv4_str_to_buf("198.51.100.50")
    let mapped_buf  = turn_ipv4_str_to_buf("192.0.2.77")
    let resp = turn_emit_allocate_success_response(txn,
                                                   relayed_buf, 50001,
                                                   600,
                                                   mapped_buf, 33445)
    let rc = ice_turn_handle_allocate_response_authed(st, resp[0], resp[1])
    ce_eq("first-try success -> RELAY_READY",
          rc, ICE_TURN_RELAY_READY)
    ce_eq("auth_state -> OK on first-try success",
          ice_turn_auth_state(st), ICE_TURN_AUTH_OK)
    ce_eq("stats_auth_retries = 0",
          ice_turn_stats_auth_retries(st), 0)
}

fn test_full_auth_retry_flow() {
    // End-to-end: ICE exhausts -> ESCALATE -> begin_allocate -> 401 ->
    // AUTH_PENDING -> credentials -> credentialed Allocate -> success
    // -> ACTIVE / relay candidate injected.
    let agent = ice_init(1)
    ice_add_local_candidate(agent, ICE_TYPE_HOST,
                            "10.0.0.1", 50000, ICE_FAMILY_IPV4, 1)
    ice_add_remote_candidate(agent, ICE_TYPE_HOST,
                             "10.0.0.2", 50100, ICE_FAMILY_IPV4, 1)
    ice_form_pairs(agent)
    _itt_drive_all_failed(agent)
    let st = ice_turn_init_authed(agent, "198.51.100.1", 3478)
    ce_eq("ESCALATE detected",
          ice_turn_check_escalation(st), ICE_TURN_ESCALATE)
    let txn = _itt_fixed_txn()
    ice_turn_begin_allocate(st, txn)
    // First reply: 401 Unauthorized with REALM + NONCE.
    let resp1 = _itt_emit_401_with_attrs(txn, "ce-realm", "abc123")
    let r1 = ice_turn_handle_allocate_response_authed(st,
                                                      resp1[0], resp1[1])
    ce_eq("step 1: 401 -> AUTH_PENDING",
          r1, ICE_TURN_RELAY_AUTH_PENDING)
    // Caller supplies credentials.
    let req2 = ice_turn_credentials(st, "alice", "secret")
    ce_check("step 2: credentialed Allocate emitted",
             len(req2) == 2)
    // Second reply: success.
    let relayed_buf = turn_ipv4_str_to_buf("198.51.100.50")
    let mapped_buf  = turn_ipv4_str_to_buf("192.0.2.77")
    let resp2 = turn_emit_allocate_success_response(txn,
                                                    relayed_buf, 60000,
                                                    600,
                                                    mapped_buf, 51000)
    let r2 = ice_turn_handle_allocate_response_authed(st,
                                                      resp2[0], resp2[1])
    ce_eq("step 3: post-creds success -> RELAY_READY",
          r2, ICE_TURN_RELAY_READY)
    ce_eq("step 4: relay candidate injected (locals now 2)",
          ice_n_local_candidates(agent), 2)
}

fn test_auth_retries_counter_does_not_bump_on_unrelated_emit() {
    // ice_turn_credentials must ONLY bump stats_auth_retries when
    // it actually emits.
    let agent = ice_init(1)
    let st = ice_turn_init_authed(agent, "203.0.113.10", 3478)
    let r = ice_turn_credentials(st, "alice", "secret")
    ce_eq("credentials() in NONE returns 0", r, 0)
    ce_eq("counter still 0 after refused call",
          ice_turn_stats_auth_retries(st), 0)
}

// ============================================================================
//                         main
// ============================================================================

fn main() {
    test_init_state_shape()
    test_relay_priority_rfc_formula()
    test_relay_priority_matches_r30c()
    test_check_escalation_empty_pairs_no_escalate()
    test_check_escalation_some_succeed_no_escalate()
    test_check_escalation_some_in_progress_no_escalate()
    test_check_escalation_all_failed_escalates()
    test_check_escalation_already_active_no_escalate()
    test_begin_allocate_emits_valid_turn_packet()
    test_begin_allocate_txn_id_persisted()
    test_handle_response_success_relay_ready()
    test_handle_response_401_failed()
    test_handle_response_437_failed()
    test_handle_response_malformed_short_buffer()
    test_end_to_end_escalation_flow()
    test_all_pairs_failed_helper_empty()
    test_all_pairs_failed_helper_one_failed()
    test_all_pairs_failed_helper_mixed()
    test_is_parse_err_sentinels()
    test_status_line_shape()
    test_status_line_after_success()
    test_state_name_shim()
    // ---- R36A 401 auto-retry with long-term credentials (R35D.2) ----
    test_init_authed_state_shape()
    test_401_transitions_to_auth_pending()
    test_credentialed_reemit_emits_authed_allocate()
    test_credentialed_reemit_success_to_active()
    test_second_401_classifies_relay_failed()
    test_non_401_error_falls_through_to_r35d_handler()
    test_credentials_rejected_when_not_pending()
    test_success_first_try_skips_auth_path()
    test_full_auth_retry_flow()
    test_auth_retries_counter_does_not_bump_on_unrelated_emit()
    ce_summary("ice_turn")
}

main()
