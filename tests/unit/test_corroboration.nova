// Unit tests for src/learning/corroboration.nova
// Verifies the in-memory corroboration tracker (ADR-0092): distinct-source
// counting, source dedup, the strong threshold (>= 2 sources), independent
// tracking of separate claims, unknown-claim handling, and source audit.

import "../ce_test.nova"
import "../../src/learning/corroboration.nova"

// Char-by-char label equality for asserting on returned source lists.
fn label_eq(a, b) {
    let n = len(a)
    if n != len(b) { return 0 }
    let i = 0
    while i < n {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Does a source list contain a given label?
fn sources_have(sources, label) {
    let i = 0
    while i < len(sources) {
        if label_eq(sources[i], label) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn test_single_source() {
    let reg = corr_new()
    let r = corr_record(reg, "earth_round", "wikipedia")
    ce_eq("first record is new", r, 1)
    ce_eq("count one source", corr_count(reg, "earth_round"), 1)
    ce_eq("one source not strong", corr_is_strong(reg, "earth_round"), 0)
}

fn test_second_distinct_source_strong() {
    let reg = corr_new()
    corr_record(reg, "earth_round", "wikipedia")
    let r = corr_record(reg, "earth_round", "nasa")
    ce_eq("second distinct source is new", r, 1)
    ce_eq("count two sources", corr_count(reg, "earth_round"), 2)
    ce_eq("two sources strong", corr_is_strong(reg, "earth_round"), 1)
}

fn test_dedup_same_source() {
    let reg = corr_new()
    corr_record(reg, "earth_round", "wikipedia")
    let r = corr_record(reg, "earth_round", "wikipedia")
    ce_eq("re-record same source is duplicate", r, 0)
    ce_eq("count still one after dup", corr_count(reg, "earth_round"), 1)
    ce_eq("still not strong after dup", corr_is_strong(reg, "earth_round"), 0)
}

fn test_independent_claims() {
    let reg = corr_new()
    corr_record(reg, "earth_round", "wikipedia")
    corr_record(reg, "earth_round", "nasa")
    corr_record(reg, "sky_blue", "wikipedia")
    ce_eq("claim A count", corr_count(reg, "earth_round"), 2)
    ce_eq("claim B count", corr_count(reg, "sky_blue"), 1)
    ce_eq("claim A strong", corr_is_strong(reg, "earth_round"), 1)
    ce_eq("claim B not strong", corr_is_strong(reg, "sky_blue"), 0)
}

fn test_unknown_claim() {
    let reg = corr_new()
    corr_record(reg, "earth_round", "wikipedia")
    ce_eq("unknown claim count 0", corr_count(reg, "moon_cheese"), 0)
    ce_eq("unknown claim not strong", corr_is_strong(reg, "moon_cheese"), 0)
    ce_eq("unknown claim no sources", len(corr_sources(reg, "moon_cheese")), 0)
}

fn test_sources_audit() {
    let reg = corr_new()
    corr_record(reg, "earth_round", "wikipedia")
    corr_record(reg, "earth_round", "nasa")
    corr_record(reg, "earth_round", "wikipedia")
    let srcs = corr_sources(reg, "earth_round")
    ce_eq("two distinct sources listed", len(srcs), 2)
    ce_eq("wikipedia present", sources_have(srcs, "wikipedia"), 1)
    ce_eq("nasa present", sources_have(srcs, "nasa"), 1)
    ce_eq("absent source not present", sources_have(srcs, "esa"), 0)
}

fn main() {
    test_single_source()
    test_second_distinct_source_strong()
    test_dedup_same_source()
    test_independent_claims()
    test_unknown_claim()
    test_sources_audit()
    ce_summary("corroboration")
}

main()
