// Unit tests for src/scheduler/realtime_pacer.nova
// Verifies the wall-clock pacer (P0.6): construction defaults, no-op when
// disabled, sleep + counts when enabled, overrun detection, and the slow-mo
// factor. Wall-clock measurements use two raw nanotime() reads outside the
// pacer to confirm the sleep actually happened; the tolerance is ~5ms to
// absorb scheduler jitter.

import "std/io"
import "../ce_test.nova"
import "../../src/scheduler/realtime_pacer.nova"

// Returns the absolute value (NOVA has no abs builtin).
fn _abs(x) {
    if x < 0 { return 0 - x }
    return x
}

// Construction defaults: a fresh pacer has zero counts and is enabled.
fn test_new_defaults() {
    let p = pacer_new()
    ce_eq("new tick count", pacer_tick_count(p), 0)
    ce_eq("new overruns", pacer_overruns(p), 0)
    ce_eq("new max overrun ns", pacer_max_overrun_ns(p), 0)
    ce_eq("new factor", pacer_factor(p), 1)
    ce_eq("enabled by default", pacer_enabled(p), 1)
}

// Disable: pacer_begin / pacer_end are no-ops; counters never advance and
// no time is consumed. This is the path the daemon takes when CE_REALTIME
// is unset (the unit-test default).
fn test_disabled_is_no_op() {
    let p = pacer_new()
    pacer_set_enabled(p, 0)
    ce_eq("disabled flag", pacer_enabled(p), 0)
    let before = nanotime()
    pacer_begin(p)
    let r = pacer_end(p, 100000000)            // 100ms budget
    let after = nanotime()
    let elapsed_ms = (after - before) / 1000000
    ce_eq("end returns 0 on no-op", r, 0)
    ce_eq("counts stayed at 0", pacer_tick_count(p), 0)
    // The no-op path must NOT sleep -- the call should be ~immediate.
    ce_check("no sleep on no-op (<10ms)", elapsed_ms < 10)
}

// Enabled with no tick work + 50ms budget: pacer_end sleeps the full budget,
// reports no overrun, and the tick count advances. The wall-clock delta is
// measured outside the pacer to confirm a real sleep happened.
fn test_pacer_actually_sleeps() {
    let p = pacer_new()
    let before = nanotime()
    pacer_begin(p)
    let overran = pacer_end(p, 50000000)       // 50ms budget
    let after = nanotime()
    let elapsed_ms = (after - before) / 1000000
    ce_eq("no overrun on idle tick", overran, 0)
    ce_eq("tick count advanced", pacer_tick_count(p), 1)
    // Slept ~50ms; tolerate +/- 15ms for scheduler jitter on a busy CI box.
    let delta = _abs(elapsed_ms - 50)
    ce_check("wall-clock ~50ms (delta < 15)", delta < 15)
}

// Deliberate overrun: sleep 30ms inside the tick body with a 10ms budget.
// Pacer must report overran > 0, NOT sleep, and bump the overrun counter.
fn test_overrun_is_counted() {
    let p = pacer_new()
    pacer_begin(p)
    sleep_ms(30)                               // tick "work" >> budget
    let overran = pacer_end(p, 10000000)       // 10ms budget
    ce_check("overran reported (ns > 0)", overran > 0)
    ce_eq("overruns counter", pacer_overruns(p), 1)
    // Max overrun is roughly (30ms - 10ms) = 20ms = 20_000_000 ns.
    let max_ms = pacer_max_overrun_ns(p) / 1000000
    ce_check("max overrun ~15ms+ (tracked)", max_ms >= 15)
}

// Slow-mo: factor 3 with a 20ms budget yields ~60ms wall-clock per tick.
// Confirms the factor multiplies the effective budget.
fn test_slow_mo_factor() {
    let p = pacer_new()
    let factor_set = pacer_set_factor(p, 3)
    ce_eq("factor set to 3", factor_set, 3)
    ce_eq("factor stored", pacer_factor(p), 3)
    let before = nanotime()
    pacer_begin(p)
    pacer_end(p, 20000000)                     // 20ms budget * 3 = 60ms
    let after = nanotime()
    let elapsed_ms = (after - before) / 1000000
    let delta = _abs(elapsed_ms - 60)
    ce_check("slow-mo ~60ms (delta < 20)", delta < 20)
    ce_eq("slow-mo tick advanced", pacer_tick_count(p), 1)
}

// Factor floor: pacer_set_factor with k <= 0 clamps to 1, so a divide-by-zero
// (or negative budget) can't happen in pacer_end.
fn test_factor_floor() {
    let p = pacer_new()
    pacer_set_factor(p, 0)
    ce_eq("factor 0 clamped", pacer_factor(p), 1)
    let neg = pacer_set_factor(p, 0 - 5)
    ce_eq("negative factor clamped", neg, 1)
    ce_eq("factor still 1", pacer_factor(p), 1)
}

// Multi-tick accumulation: 3 idle ticks under a tiny budget each.
fn test_multi_tick_count() {
    let p = pacer_new()
    let i = 0
    while i < 3 {
        pacer_begin(p)
        pacer_end(p, 5000000)                  // 5ms budget each
        i = i + 1
    }
    ce_eq("count three ticks", pacer_tick_count(p), 3)
    ce_eq("no overruns on idle ticks", pacer_overruns(p), 0)
}

// Summary line format: matches the daemon shutdown banner contract.
fn test_summary_format() {
    let p = pacer_new()
    pacer_begin(p)
    pacer_end(p, 5000000)
    let s = pacer_summary(p)
    ce_check("summary starts with 'pacer:'",
        str_eq(substr(s, 0, 6), "pacer:") == 1)
    ce_check("summary contains 'ticks'", str_find(s, "ticks") >= 0)
    ce_check("summary contains 'overruns'", str_find(s, "overruns") >= 0)
}

fn main() {
    test_new_defaults()
    test_disabled_is_no_op()
    test_pacer_actually_sleeps()
    test_overrun_is_counted()
    test_slow_mo_factor()
    test_factor_floor()
    test_multi_tick_count()
    test_summary_format()
    ce_summary("realtime_pacer")
}
main()
