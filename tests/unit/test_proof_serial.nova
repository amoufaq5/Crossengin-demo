// Unit tests for src/mind/proof_serial.nova: term + proof serialization round-
// trips, and -- the load-bearing property -- a PARSED proof still verifies under
// the kernel (so persistence preserves re-checkability, ADR-0088).

import "../ce_test.nova"
import "../../src/mind/proof_serial.nova"

fn _ax(t) { let tbl = axiom_table_new() axiom_table_add(tbl, t) return tbl }
fn _ax2(a, b) { let tbl = axiom_table_new() axiom_table_add(tbl, a) axiom_table_add(tbl, b) return tbl }

// ---- term round-trips ------------------------------------------------------
fn test_term_roundtrip() {
    let p = term_atom("p")
    ce_eq("atom round-trips", term_eq(term_from_str(term_to_str(p)), p), 1)
    let nested = term_iff(term_and(term_atom("a"), term_atom("b")),
                          term_imp(term_atom("c"), term_or(term_atom("d"), term_atom("e"))))
    ce_eq("deeply nested term round-trips",
        term_eq(term_from_str(term_to_str(nested)), nested), 1)
    // a label that collides with a tag char ("a","n","i","o","f") is read
    // positionally, not as a tag.
    let tricky = term_and(term_atom("n"), term_atom("i"))
    ce_eq("tag-colliding labels survive",
        term_eq(term_from_str(term_to_str(tricky)), tricky), 1)
}

// ---- proof round-trips + re-verification -----------------------------------
fn test_axiom_proof_roundtrip_verifies() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let proof = pf_axiom(p)
    let restored = proof_from_str(proof_to_str(proof))
    ce_eq("parsed axiom proof verifies",
        verify_check(reg, _ax(p), hyp_new(), restored, p), 1)
}

fn test_mp_proof_roundtrip_verifies() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let pq = term_imp(p, q)
    let proof = pf_mp(q, pf_axiom(pq), pf_axiom(p))
    let restored = proof_from_str(proof_to_str(proof))
    ce_eq("parsed MP proof verifies",
        verify_check(reg, _ax2(pq, p), hyp_new(), restored, q), 1)
}

fn test_hs_proof_roundtrip_verifies() {
    let reg = proof_registry_new()
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    let ac = term_imp(a, c)
    let proof = pf_hs(ac, pf_axiom(term_imp(a, b)), pf_axiom(term_imp(b, c)))
    let restored = proof_from_str(proof_to_str(proof))
    ce_eq("parsed HS proof verifies",
        verify_check(reg, _ax2(term_imp(a, b), term_imp(b, c)), hyp_new(), restored, ac), 1)
}

// A HYP proof round-trips with its label; re-verification against a VERIFIED
// lemma succeeds (the persisted derivation preserves its dependency).
fn test_hyp_proof_roundtrip_verifies() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let code = proof_register(reg, "p", list_new(), "")
    proof_set_status(reg, code, PROOF_VERIFIED)
    let hyps = hyp_new() hyp_add(hyps, "p", p, code)
    let proof = pf_hyp(p, "p")
    let restored = proof_from_str(proof_to_str(proof))
    ce_eq("parsed HYP proof verifies",
        verify_check(reg, axiom_table_new(), hyps, restored, p), 1)
}

// A parsed proof of a NON-theorem still fails (serialization doesn't launder a
// bad proof): an axiom-of-p proof, restored, must not verify as q.
fn test_roundtrip_preserves_unsoundness() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let restored = proof_from_str(proof_to_str(pf_axiom(p)))
    ce_eq("restored bogus proof still rejected",
        verify_check(reg, _ax(p), hyp_new(), restored, q), 0)
}

// ---- term list (axiom table) round-trip ------------------------------------
fn test_term_list_roundtrip() {
    let terms = list_new()
    push(terms, term_atom("p"))
    push(terms, term_imp(term_atom("p"), term_atom("q")))
    let o = list_new() term_list_ser(o, terms)
    let parsed = term_list_parse(ps_cursor(_ps_join(o)))
    ce_eq("list length preserved", len(parsed), 2)
    ce_eq("first term", term_eq(parsed[0], terms[0]), 1)
    ce_eq("second term", term_eq(parsed[1], terms[1]), 1)
}

// Arithmetic terms + an EVAL proof round-trip, and the restored proof still
// decides the equality (the recomputation survives serialization).
fn test_arith_roundtrip_verifies() {
    let reg = proof_registry_new()
    let claim = term_equals(term_mul(term_add(term_num(2), term_num(3)),
                                     term_num(4)), term_num(20))
    // term round-trips by value + structure.
    ce_eq("arith term round-trips",
        term_eq(term_from_str(term_to_str(claim)), claim), 1)
    // proof round-trips and still verifies.
    let proof = pf_eval(claim)
    let restored = proof_from_str(proof_to_str(proof))
    ce_eq("restored EVAL proof verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), restored, claim), 1)
    // a restored EVAL of a FALSE equality still fails.
    let bad = term_equals(term_add(term_num(2), term_num(2)), term_num(5))
    let rbad = proof_from_str(proof_to_str(pf_eval(bad)))
    ce_eq("restored false EVAL still rejected",
        verify_check(reg, axiom_table_new(), hyp_new(), rbad, bad), 0)
    // sub + div terms round-trip and the exact-division guard survives.
    let div = term_equals(term_div(term_sub(term_num(10), term_num(4)),
                                   term_num(2)), term_num(3))   // (10-4)/2 = 3
    let rdiv = proof_from_str(proof_to_str(pf_eval(div)))
    ce_eq("restored (10-4)/2=3 verifies",
        verify_check(reg, axiom_table_new(), hyp_new(), rdiv, div), 1)
}

// Quantifier terms + a UI proof round-trip and the restored proof still
// verifies (substitution survives serialization).
fn test_quantifier_roundtrip_verifies() {
    let reg = proof_registry_new()
    // forall x.(human(x) -> mortal(x)) terms round-trip.
    let univ = term_forall("x", term_imp(term_pred("human", term_var("x")),
                                         term_pred("mortal", term_var("x"))))
    ce_eq("quantified term round-trips",
        term_eq(term_from_str(term_to_str(univ)), univ), 1)
    // UI proof: instantiate at socrates -> the implication for socrates.
    let inst = term_imp(term_pred("human", term_atom("socrates")),
                        term_pred("mortal", term_atom("socrates")))
    let proof = pf_ui(inst, pf_axiom(univ), term_atom("socrates"))
    let restored = proof_from_str(proof_to_str(proof))
    ce_eq("restored UI proof verifies",
        verify_check(reg, _ax(univ), hyp_new(), restored, inst), 1)
    // EI proof round-trips + verifies.
    let pa = term_pred("P", term_atom("a"))
    let ex = term_exists("x", term_pred("P", term_var("x")))
    let ei = proof_from_str(proof_to_str(pf_ei(ex, pf_axiom(pa), term_atom("a"))))
    ce_eq("restored EI proof verifies",
        verify_check(reg, _ax(pa), hyp_new(), ei, ex), 1)
    // UG proof round-trips and the eigenvariable check survives: all-P-are-Q +
    // all-P |- all-Q, restored, still verifies.
    let allPQ = term_forall("x", term_imp(term_pred("P", term_var("x")),
                                          term_pred("Q", term_var("x"))))
    let allP = term_forall("x", term_pred("P", term_var("x")))
    let axs = axiom_table_new()
    axiom_table_add(axs, allPQ) axiom_table_add(axs, allP)
    let c = term_atom("c")
    let mp = pf_mp(term_pred("Q", c),
                   pf_ui(term_imp(term_pred("P", c), term_pred("Q", c)), pf_axiom(allPQ), c),
                   pf_ui(term_pred("P", c), pf_axiom(allP), c))
    let allQ = term_forall("x", term_pred("Q", term_var("x")))
    let ug = proof_from_str(proof_to_str(pf_ug(allQ, mp, c)))
    ce_eq("restored UG proof verifies",
        verify_check(reg, axs, hyp_new(), ug, allQ), 1)
    // EE proof (with its discharged-assumption label) round-trips + re-verifies.
    let exP = term_exists("x", term_pred("P", term_var("x")))
    let law = term_forall("x", term_imp(term_pred("P", term_var("x")), term_atom("q")))
    let eeAxs = axiom_table_new()
    axiom_table_add(eeAxs, exP) axiom_table_add(eeAxs, law)
    let cc = term_atom("c")
    let pc = term_pred("P", cc)
    let eeSub = pf_mp(term_atom("q"),
                      pf_ui(term_imp(pc, term_atom("q")), pf_axiom(law), cc),
                      pf_hyp(pc, "w"))
    let ee = proof_from_str(proof_to_str(pf_ee(term_atom("q"), pf_axiom(exP), cc, "w", eeSub)))
    ce_eq("restored EE proof verifies",
        verify_check(reg, eeAxs, hyp_new(), ee, term_atom("q")), 1)
}

fn main() {
    test_term_roundtrip()
    test_axiom_proof_roundtrip_verifies()
    test_mp_proof_roundtrip_verifies()
    test_hs_proof_roundtrip_verifies()
    test_hyp_proof_roundtrip_verifies()
    test_roundtrip_preserves_unsoundness()
    test_term_list_roundtrip()
    test_arith_roundtrip_verifies()
    test_quantifier_roundtrip_verifies()
    ce_summary("proof_serial")
}

main()
