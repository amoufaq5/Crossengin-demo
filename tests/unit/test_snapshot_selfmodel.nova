// Unit tests for the SELFMODEL section in src/persistence/snapshot_disk.nova
// (Phase 11 P0.1 follow-up).
//
// Verifies the per-domain competence round-trip (know/do/understand +
// derived tier survive). Empty round-trip, populated round-trip, legacy
// presence-only stub, REPLACE-on-apply policy, idempotent re-apply.
//
// ADR-0020 (self-model competence), ADR-0048 (snapshot container).

import "../ce_test.nova"
import "../../src/persistence/snapshot_disk.nova"

// ---- helpers --------------------------------------------------------------

fn _wrap_for_text(blob) {
    let s = snap_new(1, 100)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    let kb = list_new()
    push(kb, 0)
    push(kb, list_new())
    snap_put_section(s, SEC_KGS, kb)
    snap_put_section(s, SEC_SELFMODEL, blob)
    return s
}

// Build a competence record directly (avoids needing live KGs in the test).
fn _make_record(domain, kind, reliability, evidence) {
    let r = _comp_build(domain, kind)
    list_set(r, CMP_GROUNDING, 1)
    list_set(r, CMP_REL, reliability)
    list_set(r, CMP_EVID, evidence)
    return r
}

// ---- empty round-trip -----------------------------------------------------

fn test_empty_round_trip() {
    let sm = self_model_new()
    let blob = selfmodel_section_build(sm)
    ce_eq("empty blob has 0 records", len(blob[0]), 0)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    ce_check("encoded non-empty", len(text) > 0)
    let s2 = snap_from_text(text)
    ce_check("decoded valid", snap_valid(s2) == 1)
    ce_check("selfmodel section present", snap_has_section(s2, SEC_SELFMODEL) == 1)
    let blob2 = snap_section(s2, SEC_SELFMODEL)
    ce_eq("decoded record count", len(blob2[0]), 0)

    let sm2 = self_model_new()
    let n = selfmodel_section_apply(sm2, blob2)
    ce_eq("apply returned 0", n, 0)
    ce_eq("post-apply self_model is empty", self_model_count(sm2), 0)
}

// ---- populated round-trip -------------------------------------------------

fn test_populated_round_trip() {
    let sm = self_model_new()
    // 6 records across 3 domains x 2-3 kinds each. Use kg-free synthetic
    // records via _comp_build so the test doesn't pull the whole assessment
    // pipeline; the snapshot format only persists rel + evid + tier-derived.
    self_model_set(sm, _make_record("medicine", COMP_KNOW,       800, 25))
    self_model_set(sm, _make_record("medicine", COMP_DO,         600, 12))
    self_model_set(sm, _make_record("medicine", COMP_UNDERSTAND, 400, 5))
    self_model_set(sm, _make_record("law",      COMP_KNOW,       300, 3))
    self_model_set(sm, _make_record("art",      COMP_KNOW,       550, 8))
    self_model_set(sm, _make_record("art",      COMP_DO,         200, 2))
    ce_eq("source self_model has 6 records", self_model_count(sm), 6)

    let blob = selfmodel_section_build(sm)
    ce_eq("blob has 6 records", len(blob[0]), 6)

    let s = _wrap_for_text(blob)
    let text = snap_to_text(s)
    let s2 = snap_from_text(text)
    let blob2 = snap_section(s2, SEC_SELFMODEL)
    ce_eq("decoded record count", len(blob2[0]), 6)

    let sm2 = self_model_new()
    let n = selfmodel_section_apply(sm2, blob2)
    ce_eq("apply returned 6", n, 6)
    ce_eq("post-apply self_model has 6", self_model_count(sm2), 6)

    // Per-record survival.
    let r1 = self_model_get(sm2, "medicine", COMP_KNOW)
    ce_check("medicine KNOW survived",     r1 != 0)
    ce_eq("medicine KNOW reliability",     competence_reliability(r1), 800)
    ce_eq("medicine KNOW evidence",        competence_evidence(r1), 25)
    // 800 >= 750 AND evidence 25 >= 20 -> CAPABLE.
    ce_eq("medicine KNOW tier CAPABLE",    competence_tier(r1), TIER_CAPABLE)

    let r2 = self_model_get(sm2, "medicine", COMP_DO)
    ce_check("medicine DO survived",       r2 != 0)
    ce_eq("medicine DO reliability",       competence_reliability(r2), 600)
    // 600 >= 500 -> PARTIAL.
    ce_eq("medicine DO tier PARTIAL",      competence_tier(r2), TIER_PARTIAL)

    let r3 = self_model_get(sm2, "medicine", COMP_UNDERSTAND)
    ce_check("medicine UNDERSTAND survived", r3 != 0)
    ce_eq("medicine UNDERSTAND reliability", competence_reliability(r3), 400)
    // 400 < 500 but grounded -> AWARE.
    ce_eq("medicine UNDERSTAND tier AWARE", competence_tier(r3), TIER_AWARE)

    let r4 = self_model_get(sm2, "law", COMP_KNOW)
    ce_check("law KNOW survived", r4 != 0)
    ce_eq("law KNOW reliability", competence_reliability(r4), 300)

    let r5 = self_model_get(sm2, "art", COMP_KNOW)
    ce_check("art KNOW survived",         r5 != 0)
    ce_eq("art KNOW reliability",         competence_reliability(r5), 550)
    ce_eq("art KNOW tier PARTIAL",        competence_tier(r5), TIER_PARTIAL)
}

// ---- backwards compat: presence-only stub ---------------------------------

fn test_legacy_presence_only_parses_empty() {
    let old = ""
        + "crossengin-snapshot v1\n"
        + "tag " + int_to_str(SNAP_TAG) + "\n"
        + "ver " + int_to_str(SNAP_FORMAT_VERSION) + "\n"
        + "instance 1\n"
        + "timestamp 1\n"
        + "sections 5\n"
        + "soul.present 1\n"
        + "soul.name Aurora\n"
        + "soul.constcount 0\n"
        + "kgs.present 1\n"
        + "kgs.atoms 0\n"
        + "kgs.atoms.count 0\n"
        + "episodic.present 0\n"
        + "synapses.present 0\n"
        + "selfmodel.present 1\n"
        + "end\n"
    let s = snap_from_text(old)
    ce_check("legacy snapshot parses", s != 0)
    ce_check("selfmodel section present", snap_has_section(s, SEC_SELFMODEL) == 1)
    let blob = snap_section(s, SEC_SELFMODEL)
    ce_eq("legacy blob record list empty", len(blob[0]), 0)

    let sm = self_model_new()
    let n = selfmodel_section_apply(sm, blob)
    ce_eq("legacy apply installs 0 records", n, 0)
}

// ---- REPLACE on apply -----------------------------------------------------

fn test_apply_replaces_existing_state() {
    let sm = self_model_new()
    self_model_set(sm, _make_record("preexisting1", COMP_KNOW, 100, 1))
    self_model_set(sm, _make_record("preexisting2", COMP_DO,   200, 2))
    self_model_set(sm, _make_record("preexisting3", COMP_UNDERSTAND, 300, 3))
    ce_eq("live sm pre-apply", self_model_count(sm), 3)

    let sm_snap = self_model_new()
    self_model_set(sm_snap, _make_record("medicine", COMP_KNOW, 800, 20))
    let blob = selfmodel_section_build(sm_snap)
    selfmodel_section_apply(sm, blob)
    ce_eq("post-apply replaces count (1, not 4)", self_model_count(sm), 1)
    ce_eq("pre-existing dropped",
        self_model_get(sm, "preexisting1", COMP_KNOW), 0)
    let r = self_model_get(sm, "medicine", COMP_KNOW)
    ce_check("snapshot record applied", r != 0)
    ce_eq("snapshot reliability",       competence_reliability(r), 800)
}

// ---- apply is idempotent --------------------------------------------------

fn test_apply_is_idempotent() {
    let sm_snap = self_model_new()
    self_model_set(sm_snap, _make_record("art", COMP_DO, 500, 10))
    let blob = selfmodel_section_build(sm_snap)
    let sm = self_model_new()
    selfmodel_section_apply(sm, blob)
    let after_first = self_model_count(sm)
    selfmodel_section_apply(sm, blob)
    let after_second = self_model_count(sm)
    ce_eq("first apply -> 1", after_first, 1)
    ce_eq("second apply still 1",  after_second, 1)
}

fn main() {
    test_empty_round_trip()
    test_populated_round_trip()
    test_legacy_presence_only_parses_empty()
    test_apply_replaces_existing_state()
    test_apply_is_idempotent()
    ce_summary("snapshot_selfmodel")
}
main()
