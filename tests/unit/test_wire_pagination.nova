// ---- pattern.list ----------------------------------------------------
//
// The pattern registry is a process-wide singleton with lazy built-in
// load; call once to trigger the load, then just verify the field
// shape. No crafted-N test here -- the singleton is shared with other
// tests in this suite's binary and adding 200 pattern-capsules would
// cross-contaminate.

fn test_pattern_list_shape() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("pattern.list", _args1("limit", "1"), ctx)
    ce_check("pattern.list ok",             _has(out, "\"ok\":true"))
    ce_check("pattern.list has patterns",   _has(out, "\"patterns\":["))
    ce_check("pattern.list has next_after", _has(out, "\"next_after\":"))
}

// ---- ownership.list --------------------------------------------------

fn _mk_ctx_with_ownership(n) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let overlay = ownership_registry_new()
    let i = 0
    while i < n {
        ownership_set_kg(overlay, "kg_" + _pad3(i), "alice")
        i = i + 1
    }
    rpc_ctx_set_ownership(ctx, overlay)
    return ctx
}

fn test_ownership_list_paginates() {
    let ctx = _mk_ctx_with_ownership(9)
    let out = rpc_dispatch("ownership.list", _args1("limit", "4"), ctx)
    ce_check("own.list ok",           _has(out, "\"ok\":true"))
    ce_check("own.list has entries",  _has(out, "\"entries\":["))
    ce_check("own.list has kg_000",   _has(out, "\"name\":\"kg_000\""))
    ce_check("own.list has kg_003",   _has(out, "\"name\":\"kg_003\""))
    ce_check("own.list stops @004",   _has(out, "\"name\":\"kg_004\"") == 0)
    // Composite cursor "kind:name".
    ce_check("own.list next=kg:kg_003",
             _has(out, "\"next_after\":\"kg:kg_003\""))
}

fn test_ownership_list_after_composite() {
    let ctx = _mk_ctx_with_ownership(6)
    let out = rpc_dispatch("ownership.list",
                _args2("limit", "2", "after", "kg:kg_002"), ctx)
    ce_check("own.list after ok",     _has(out, "\"ok\":true"))
    ce_check("own.list after has 003", _has(out, "\"name\":\"kg_003\""))
    ce_check("own.list after has 004", _has(out, "\"name\":\"kg_004\""))
    ce_check("own.list after skips 002",
             _has(out, "\"name\":\"kg_002\"") == 0)
}

fn test_ownership_list_empty() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_ownership(ctx, ownership_registry_new())
    let out = rpc_dispatch("ownership.list", list_new(), ctx)
    ce_check("own.list empty entries=[]", _has(out, "\"entries\":[]"))
    ce_check("own.list empty next=''",    _has(out, "\"next_after\":\"\""))
}

// ---- capability.list -------------------------------------------------

fn _mk_ctx_with_caps(n) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = capability_registry_new()
    let i = 0
    while i < n {
        let roles = list_new()
        push(roles, "reader")
        let t = capability_token_new_roles("tk_" + _pad3(i),
                                            "user_" + _pad3(i),
                                            roles, 100, 0)
        capability_registry_add(reg, t)
        i = i + 1
    }
    rpc_ctx_set_sandbox(ctx, reg, 0)
    return ctx
}

fn test_capability_list_paginates() {
    let ctx = _mk_ctx_with_caps(7)
    let out = rpc_dispatch("capability.list", _args1("limit", "3"), ctx)
    ce_check("cap.list ok",             _has(out, "\"ok\":true"))
    ce_check("cap.list has tokens",     _has(out, "\"tokens\":["))
    ce_check("cap.list has user_000",   _has(out, "user_000"))
    ce_check("cap.list has user_002",   _has(out, "user_002"))
    ce_check("cap.list stops @003",     _has(out, "user_003") == 0)
    // Cursor is token_id (opaque; not leaked as a field).
    ce_check("cap.list next=tk_002",
             _has(out, "\"next_after\":\"tk_002\""))
}

fn test_capability_list_empty() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = capability_registry_new()
    rpc_ctx_set_sandbox(ctx, reg, 0)
    let out = rpc_dispatch("capability.list", list_new(), ctx)
    ce_check("cap.list empty tokens=[]", _has(out, "\"tokens\":[]"))
    ce_check("cap.list empty next=''",   _has(out, "\"next_after\":\"\""))
}

