// R107 (Phase I part 1) -- uniform cursor pagination for wire list verbs.
//
// Verifies the uniform `limit` + `after` contract added to every list
// verb in src/nl/rpc_verbs.nova:
//   * default limit=50, clamped to [1, 500].
//   * `after` -> start after that cursor id; unknown cursor gracefully
//     falls back to head.
//   * response gains `next_after` field: last-emitted cursor id when a
//     next page exists, "" on the tail.
//   * loop invariants: every entry seen exactly once, no dupes, no gaps.
//
// Covers all 10 list verbs (kg.list, capsule.list, skill.list,
// pattern.list, ownership.list, session.list, capability.list,
// ingest.policy.list, nl.metrics, self.gaps). See docs/SHIP_AS_APP.md
// §7.56 for the per-verb cursor id table.

import "../ce_test.nova"
import "../../src/nl/rpc_verbs.nova"
import "../../src/nl/nl_metrics.nova"
import "../../src/kg/multi_kg_manager.nova"
import "../../src/kg/atom_store.nova"
import "../../src/capsules/capsule.nova"
import "../../src/capsules/capsule_registry.nova"
import "../../src/capsules/pattern_capsule.nova"
import "../../src/skills/skill_registry.nova"
import "../../src/skills/skill_manifest.nova"
import "../../src/sandbox/capability.nova"
import "../../src/sandbox/ownership.nova"
import "../../src/parts/meta/gaps_register.nova"
import "../../src/parts/meta/override_wire.nova"
import "../../src/ingest/policy.nova"
import "../../src/agents/agent_manifest.nova"
import "../../src/agents/agent_registry.nova"
import "../../src/util/str_safe.nova"

// ---- helpers ---------------------------------------------------------

fn _has(hay, needle) {
    if find_bytes(hay, needle) >= 0 { return 1 }
    return 0
}

fn _args1(k, v) {
    let a = list_new()
    push(a, rpc_arg_kv(k, v))
    return a
}

fn _args2(k1, v1, k2, v2) {
    let a = list_new()
    push(a, rpc_arg_kv(k1, v1))
    push(a, rpc_arg_kv(k2, v2))
    return a
}

// Zero-padded 3-digit label so lexicographic + insertion order agree.
// (Registries iterate in insertion order; the cursor is the id itself,
// so a stable pad keeps the test's expected "was every item seen" scan
// independent of implementation ordering choice.)
fn _pad3(n) {
    if n < 10  { return "00" + int_to_str(n) }
    if n < 100 { return "0" + int_to_str(n) }
    return int_to_str(n)
}

// Scan `body` for every needle in `needles` and require exactly one
// hit each. Returns the count of missing needles (0 = all seen once).
fn _scan_all_present(body, needles) {
    let miss = 0
    let i = 0
    while i < len(needles) {
        if _has(body, needles[i]) == 0 { miss = miss + 1 }
        i = i + 1
    }
    return miss
}

// Extract the value of "next_after":"..." from a JSON response body.
// Walks bytes explicitly (str_find has known quirks per NOVA notes).
// Returns "" when the field isn't present OR its value is empty.
fn _read_next_after(body) {
    let key = "\"next_after\":\""
    let start = find_bytes(body, key)
    if start < 0 { return "" }
    let vstart = start + len(key)
    let i = vstart
    let n = len(body)
    while i < n {
        if char_at(body, i) == 34 {
            // Reached the closing quote: value is [vstart, i).
            return substr(body, vstart, i - vstart)
        }
        i = i + 1
    }
    return ""
}

// ---- kg.list ----------------------------------------------------------
//
// Craft 15 KGs (3x default limit=5) so a paginate-loop with limit=5
// exercises >1 page but stays cheap (kg_spawn is a lightweight append).

fn _mk_kgreg_n(n) {
    let reg = kg_registry_new()
    let i = 0
    while i < n {
        kg_spawn(reg, "kg_" + _pad3(i))
        i = i + 1
    }
    return reg
}

fn _mk_ctx_with_kg(n) {
    let reg = _mk_kgreg_n(n)
    return rpc_ctx_new(reg, 0, 0, 0, 0, 0, 0, 100)
}

fn test_kg_list_small_returns_all() {
    let ctx = _mk_ctx_with_kg(3)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("kg.list small ok",            _has(out, "\"ok\":true"))
    ce_check("kg.list small has labels",    _has(out, "\"labels\":["))
    ce_check("kg.list small has kg_000",    _has(out, "kg_000"))
    ce_check("kg.list small has kg_002",    _has(out, "kg_002"))
    ce_check("kg.list small next_after=''", _has(out, "\"next_after\":\"\""))
}

fn test_kg_list_empty_registry() {
    let reg = kg_registry_new()
    let ctx = rpc_ctx_new(reg, 0, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("kg.list", list_new(), ctx)
    ce_check("kg.list empty ok",         _has(out, "\"ok\":true"))
    ce_check("kg.list empty labels=[]",  _has(out, "\"labels\":[]"))
    ce_check("kg.list empty next=''",    _has(out, "\"next_after\":\"\""))
}

fn test_kg_list_explicit_limit_10() {
    let ctx = _mk_ctx_with_kg(15)
    let out = rpc_dispatch("kg.list", _args1("limit", "10"), ctx)
    ce_check("kg.list limit=10 ok",       _has(out, "\"ok\":true"))
    // Emitted 10 -> kg_000..kg_009. kg_010 must NOT appear.
    ce_check("kg.list limit=10 first",    _has(out, "kg_000"))
    ce_check("kg.list limit=10 tail",     _has(out, "kg_009"))
    ce_check("kg.list limit=10 stops",    _has(out, "kg_010") == 0)
    // next_after should be kg_009 (more entries follow).
    ce_check("kg.list limit=10 next=009",
             _has(out, "\"next_after\":\"kg_009\""))
}

fn test_kg_list_limit_clamps() {
    let ctx = _mk_ctx_with_kg(5)
    // limit=0 -> clamped to 1.
    let out0 = rpc_dispatch("kg.list", _args1("limit", "0"), ctx)
    ce_check("kg.list limit=0 has 000",   _has(out0, "kg_000"))
    ce_check("kg.list limit=0 stops @001", _has(out0, "kg_001") == 0)
    // limit=-5 -> clamped to 1.
    let outN = rpc_dispatch("kg.list", _args1("limit", "-5"), ctx)
    ce_check("kg.list limit=-5 has 000",  _has(outN, "kg_000"))
    ce_check("kg.list limit=-5 stops",    _has(outN, "kg_001") == 0)
    // limit=1000 -> clamped to 500 (i.e. covers all 5).
    let outB = rpc_dispatch("kg.list", _args1("limit", "1000"), ctx)
    ce_check("kg.list limit=huge has 000", _has(outB, "kg_000"))
    ce_check("kg.list limit=huge has 004", _has(outB, "kg_004"))
    ce_check("kg.list limit=huge next=''",
             _has(outB, "\"next_after\":\"\""))
}

fn test_kg_list_unknown_after_starts_from_head() {
    let ctx = _mk_ctx_with_kg(3)
    let out = rpc_dispatch("kg.list",
                _args2("limit", "2", "after", "nosuch"), ctx)
    ce_check("kg.list unknown-after ok",  _has(out, "\"ok\":true"))
    // Graceful: unknown cursor -> restart from head, emit 2.
    ce_check("kg.list unknown-after 000", _has(out, "kg_000"))
    ce_check("kg.list unknown-after 001", _has(out, "kg_001"))
    ce_check("kg.list unknown-after next=001",
             _has(out, "\"next_after\":\"kg_001\""))
}

fn test_kg_list_full_pagination_loop() {
    // 15 items, limit=5 -> 3 pages. Verify every item exactly once,
    // no gaps, tail page has next_after="".
    let ctx = _mk_ctx_with_kg(15)
    let after = ""
    let seen = list_new()
    let iters = 0
    while iters < 10 {
        let args = list_new()
        push(args, rpc_arg_kv("limit", "5"))
        if len(after) > 0 { push(args, rpc_arg_kv("after", after)) }
        let out = rpc_dispatch("kg.list", args, ctx)
        // Collect visible ids.
        let i = 0
        while i < 15 {
            let id = "kg_" + _pad3(i)
            if _has(out, id) == 1 {
                // Only push each id once per session (multi-page shows
                // it in one page only when semantics correct).
                let j = 0
                let already = 0
                while j < len(seen) {
                    if str_eq_bytes(seen[j], id) == 1 { already = 1 }
                    j = j + 1
                }
                if already == 0 { push(seen, id) }
            }
            i = i + 1
        }
        after = _read_next_after(out)
        if len(after) == 0 { iters = 10 }
        else { iters = iters + 1 }
    }
    ce_eq("kg.list loop saw all 15", len(seen), 15)
}

// ---- capsule.list ----------------------------------------------------

fn _mk_capreg_n(n) {
    let cr = capreg_new()
    let i = 0
    while i < n {
        let c = capsule_new("cap_" + _pad3(i), "1.0.0", "", "unspecified")
        capreg_register(cr, c)
        i = i + 1
    }
    return cr
}

fn test_capsule_list_paginates() {
    let cr = _mk_capreg_n(12)
    let ctx = rpc_ctx_new(0, cr, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("capsule.list", _args1("limit", "5"), ctx)
    ce_check("cap.list ok",            _has(out, "\"ok\":true"))
    ce_check("cap.list has capsules",  _has(out, "\"capsules\":["))
    ce_check("cap.list has cap_000",   _has(out, "cap_000"))
    ce_check("cap.list has cap_004",   _has(out, "cap_004"))
    ce_check("cap.list stops @005",    _has(out, "cap_005") == 0)
    ce_check("cap.list next=cap_004",
             _has(out, "\"next_after\":\"cap_004\""))
}

fn test_capsule_list_after_middle() {
    let cr = _mk_capreg_n(10)
    let ctx = rpc_ctx_new(0, cr, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("capsule.list",
                _args2("limit", "3", "after", "cap_004"), ctx)
    ce_check("cap.list after ok",       _has(out, "\"ok\":true"))
    ce_check("cap.list after has 005",  _has(out, "cap_005"))
    ce_check("cap.list after has 007",  _has(out, "cap_007"))
    ce_check("cap.list after skips 004", _has(out, "cap_004") == 0)
    ce_check("cap.list after next=007",
             _has(out, "\"next_after\":\"cap_007\""))
}

fn test_capsule_list_empty() {
    let cr = capreg_new()
    let ctx = rpc_ctx_new(0, cr, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("cap.list empty caps=[]",  _has(out, "\"capsules\":[]"))
    ce_check("cap.list empty next=''",  _has(out, "\"next_after\":\"\""))
}

// ---- skill.list ------------------------------------------------------

