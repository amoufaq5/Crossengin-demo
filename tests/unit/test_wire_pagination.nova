// ---- nl.metrics ------------------------------------------------------

fn _mk_ctx_with_metrics(n_holders) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = nl_metrics_new()
    let i = 0
    while i < n_holders {
        nl_metrics_inc_total(reg, "h_" + _pad3(i))
        i = i + 1
    }
    rpc_ctx_set_nl_metrics(ctx, reg)
    return ctx
}

fn test_nl_metrics_paginates() {
    let ctx = _mk_ctx_with_metrics(5)
    let out = rpc_dispatch("nl.metrics", _args1("limit", "2"), ctx)
    ce_check("nl.metrics ok",              _has(out, "\"ok\":true"))
    ce_check("nl.metrics has holders",     _has(out, "\"holders\":"))
    // First-page holders present.
    ce_check("nl.metrics has h_000",       _has(out, "\"h_000\":"))
    ce_check("nl.metrics has h_001",       _has(out, "\"h_001\":"))
    ce_check("nl.metrics stops @h_002",    _has(out, "\"h_002\":") == 0)
    // Aggregate always present, independent of page.
    ce_check("nl.metrics has aggregate",   _has(out, "_total_all_holders"))
    ce_check("nl.metrics next=h_001",
             _has(out, "\"next_after\":\"h_001\""))
}

fn test_nl_metrics_empty_holders() {
    let ctx = _mk_ctx_with_metrics(0)
    let out = rpc_dispatch("nl.metrics", list_new(), ctx)
    ce_check("nl.metrics empty ok",       _has(out, "\"ok\":true"))
    ce_check("nl.metrics empty aggregate",
             _has(out, "_total_all_holders"))
    ce_check("nl.metrics empty next=''",
             _has(out, "\"next_after\":\"\""))
}

// ---- self.gaps -------------------------------------------------------

fn _mk_ctx_with_gaps(n) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = gaps_register_new(0)
    let i = 0
    while i < n {
        // Distinct timestamps so cursor "<ts>:0" is unique.
        gaps_record(reg, "", "topic_" + _pad3(i),
                    GAP_NO_MATCH, "detail " + int_to_str(i), 1000 + i)
        i = i + 1
    }
    rpc_ctx_set_gaps_reg(ctx, reg)
    return ctx
}

fn test_self_gaps_paginates() {
    let ctx = _mk_ctx_with_gaps(6)
    let out = rpc_dispatch("self.gaps", _args1("limit", "3"), ctx)
    ce_check("self.gaps ok",             _has(out, "\"ok\":true"))
    ce_check("self.gaps has entries",    _has(out, "\"entries\":["))
    ce_check("self.gaps has topic_000",  _has(out, "topic_000"))
    ce_check("self.gaps has topic_002",  _has(out, "topic_002"))
    ce_check("self.gaps stops @003",     _has(out, "topic_003") == 0)
    // Cursor is "<ts_nanos>:<idx>"; ts starts at 1000, idx=0.
    ce_check("self.gaps next=1002:0",
             _has(out, "\"next_after\":\"1002:0\""))
}

fn test_self_gaps_after_cursor() {
    let ctx = _mk_ctx_with_gaps(6)
    let out = rpc_dispatch("self.gaps",
                _args2("limit", "2", "after", "1002:0"), ctx)
    ce_check("self.gaps after ok",       _has(out, "\"ok\":true"))
    ce_check("self.gaps after has 003",  _has(out, "topic_003"))
    ce_check("self.gaps after has 004",  _has(out, "topic_004"))
    ce_check("self.gaps after skips 002", _has(out, "topic_002") == 0)
}

fn test_self_gaps_tail_next_after_empty() {
    let ctx = _mk_ctx_with_gaps(3)
    let out = rpc_dispatch("self.gaps", _args1("limit", "10"), ctx)
    ce_check("self.gaps tail all present",
             _has(out, "topic_002"))
    ce_check("self.gaps tail next=''",
             _has(out, "\"next_after\":\"\""))
}

fn test_self_gaps_empty_register() {
    let ctx = _mk_ctx_with_gaps(0)
    let out = rpc_dispatch("self.gaps", list_new(), ctx)
    ce_check("self.gaps empty ok",       _has(out, "\"ok\":true"))
    ce_check("self.gaps empty entries=[]", _has(out, "\"entries\":[]"))
    ce_check("self.gaps empty next=''",  _has(out, "\"next_after\":\"\""))
}

// ---- session.list ----------------------------------------------------
//
// session.list needs a snapshot dir to run. When none is configured
// it refuses with a well-known message; when the dir exists but the
// index file is absent the response is a paginated empty envelope.
// Use CE_RPC_SNAPSHOT_DIR-less path: hand session.list a bogus dir --
// _rpc_snap_read on a missing file returns "" -> 0 entries -> the
// paginated empty envelope.

// ---- R109 agent.list -----------------------------------------------

fn _mk_agentreg_n(n) {
    let ar = agent_registry_new()
    let i = 0
    while i < n {
        let m = agent_manifest_new("ag_" + _pad3(i), "1", "")
        agent_manifest_add_skill_dep(m, "echo")
        agent_registry_register(ar, m)
        i = i + 1
    }
    return ar
}

fn test_agent_list_paginates() {
    let ar = _mk_agentreg_n(7)
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_agent_reg(ctx, ar)
    let out = rpc_dispatch("agent.list", _args1("limit", "3"), ctx)
    ce_check("agent.list ok",           _has(out, "\"ok\":true"))
    ce_check("agent.list has agents",   _has(out, "\"agents\":["))
    ce_check("agent.list has ag_000",   _has(out, "ag_000"))
    ce_check("agent.list has ag_002",   _has(out, "ag_002"))
    ce_check("agent.list stops @003",   _has(out, "ag_003") == 0)
    ce_check("agent.list next=ag_002",
             _has(out, "\"next_after\":\"ag_002\""))
    // 2nd page after ag_002.
    let out2 = rpc_dispatch("agent.list", _args2("limit", "10", "after", "ag_002"), ctx)
    ce_check("agent.list p2 has ag_003", _has(out2, "ag_003"))
    ce_check("agent.list p2 tail",       _has(out2, "\"next_after\":\"\""))
}

fn test_agent_list_empty() {
    let ar = agent_registry_new()
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    rpc_ctx_set_agent_reg(ctx, ar)
    let out = rpc_dispatch("agent.list", list_new(), ctx)
    ce_check("agent.list empty agents=[]", _has(out, "\"agents\":[]"))
    ce_check("agent.list empty next=''",   _has(out, "\"next_after\":\"\""))
}

// ---- R111 self.override.list ---------------------------------------

// Fabricate a ctx + override registry with n hard_stops all under "".
// override_ids are 1..n; cursor id is int_to_str(id).
fn _mk_ctx_with_overrides(n) {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    let reg = ovw_new()
    let i = 0
    while i < n {
        ovw_record(reg, OVW_ACT_HARD_STOP, "{}", "", 0, 0, 0, "", 1000 + i)
        i = i + 1
    }
    rpc_ctx_set_override_reg(ctx, reg)
    return ctx
}

fn test_self_override_list_paginates() {
    let ctx = _mk_ctx_with_overrides(6)
    let out = rpc_dispatch("self.override.list", _args1("limit", "3"), ctx)
    ce_check("self.override.list ok",           _has(out, "\"ok\":true"))
    ce_check("self.override.list entries",      _has(out, "\"entries\":["))
    ce_check("self.override.list has id=1",     _has(out, "\"override_id\":1"))
    ce_check("self.override.list has id=3",     _has(out, "\"override_id\":3"))
    ce_check("self.override.list stops @4",     _has(out, "\"override_id\":4") == 0)
    ce_check("self.override.list next=3",       _has(out, "\"next_after\":\"3\""))
    // Second page after cursor "3".
    let out2 = rpc_dispatch("self.override.list",
        _args2("limit", "10", "after", "3"), ctx)
    ce_check("self.override.list p2 has id=4",  _has(out2, "\"override_id\":4"))
    ce_check("self.override.list p2 tail",      _has(out2, "\"next_after\":\"\""))
}

fn test_self_override_list_empty() {
    let ctx = _mk_ctx_with_overrides(0)
    let out = rpc_dispatch("self.override.list", list_new(), ctx)
    ce_check("empty ok",           _has(out, "\"ok\":true"))
    ce_check("empty entries=[]",   _has(out, "\"entries\":[]"))
    ce_check("empty next=''",      _has(out, "\"next_after\":\"\""))
}

fn test_session_list_empty_shape() {
    let ctx = rpc_ctx_new(0, 0, 0, 0, 0, 0, 0, 100)
    // No cap enforcement + a real path so _rpc_snap_read returns "".
    rpc_ctx_set_snapshot_dir(ctx, "/tmp/ce-r107-nonexistent")
    let out = rpc_dispatch("session.list", list_new(), ctx)
    ce_check("session.list ok",           _has(out, "\"ok\":true"))
    ce_check("session.list has sessions", _has(out, "\"sessions\":"))
    ce_check("session.list empty next=''", _has(out, "\"next_after\":\"\""))
}

// ---- cross-verb invariants -------------------------------------------
//
// R107 helper contract: `_rpc_page_args` clamps identically across
// every verb. We already checked kg.list; smoke a couple others to
// confirm the helper is shared, not copy-pasted per verb.

fn test_clamp_applies_to_capsule_list() {
    let cr = _mk_capreg_n(3)
    let ctx = rpc_ctx_new(0, cr, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("capsule.list", _args1("limit", "0"), ctx)
    // Clamped to 1: only cap_000 visible.
    ce_check("cap.list clamp 0->1 has 000", _has(out, "cap_000"))
    ce_check("cap.list clamp 0->1 stops",   _has(out, "cap_001") == 0)
    ce_check("cap.list clamp next=cap_000",
             _has(out, "\"next_after\":\"cap_000\""))
}

fn test_clamp_applies_to_skill_list() {
    let sr = _mk_skillreg_n(2)
    let ctx = rpc_ctx_new(0, 0, 0, sr, 0, 0, 0, 100)
    let out = rpc_dispatch("skill.list", _args1("limit", "-99"), ctx)
    ce_check("skill.list clamp -99->1 has 000", _has(out, "sk_000"))
    ce_check("skill.list clamp -99->1 stops",   _has(out, "sk_001") == 0)
}

// ---- backwards compat -----------------------------------------------
//
// A caller that ignores next_after still gets a valid capped page.
// The response ALWAYS carries next_after; the caller may drop it.
// Verified transitively by every test above; do a positive spot
// check that a no-arg call on a >50-item registry does NOT crash and
// respects the default cap.

fn test_default_cap_is_50() {
    let cr = _mk_capreg_n(60)
    let ctx = rpc_ctx_new(0, cr, 0, 0, 0, 0, 0, 100)
    let out = rpc_dispatch("capsule.list", list_new(), ctx)
    ce_check("cap.list default ok",       _has(out, "\"ok\":true"))
    // 50 emitted -> cap_000..cap_049. cap_050 must NOT appear.
    ce_check("cap.list default has 000",  _has(out, "cap_000"))
    ce_check("cap.list default has 049",  _has(out, "cap_049"))
    ce_check("cap.list default stops 050", _has(out, "cap_050") == 0)
    ce_check("cap.list default next=cap_049",
             _has(out, "\"next_after\":\"cap_049\""))
}

// ---- main ------------------------------------------------------------

fn main() {
    // kg.list (6 tests, ~26 checks)
    test_kg_list_small_returns_all()
    test_kg_list_empty_registry()
    test_kg_list_explicit_limit_10()
    test_kg_list_limit_clamps()
    test_kg_list_unknown_after_starts_from_head()
    test_kg_list_full_pagination_loop()

    // capsule.list (3 tests, ~11 checks)
    test_capsule_list_paginates()
    test_capsule_list_after_middle()
    test_capsule_list_empty()

    // skill.list (2 tests, ~8 checks)
    test_skill_list_paginates()
    test_skill_list_empty()

    // pattern.list (1 test, 3 checks)
    test_pattern_list_shape()

    // ownership.list (3 tests, ~11 checks)
    test_ownership_list_paginates()
    test_ownership_list_after_composite()
    test_ownership_list_empty()

    // capability.list (2 tests, ~8 checks)
    test_capability_list_paginates()
    test_capability_list_empty()

    // ingest.policy.list (2 tests, ~7 checks)
    test_ingest_policy_list_paginates()
    test_ingest_policy_list_empty()

    // nl.metrics (2 tests, ~10 checks)
    test_nl_metrics_paginates()
    test_nl_metrics_empty_holders()

    // self.gaps (4 tests, ~13 checks)
    test_self_gaps_paginates()
    test_self_gaps_after_cursor()
    test_self_gaps_tail_next_after_empty()
    test_self_gaps_empty_register()

    // R111 self.override.list (2 tests, ~9 checks)
    test_self_override_list_paginates()
    test_self_override_list_empty()

    // session.list (1 test, 3 checks)
    test_session_list_empty_shape()

    // R109 agent.list (2 tests, ~10 checks)
    test_agent_list_paginates()
    test_agent_list_empty()

    // cross-verb helper invariants (3 tests, ~9 checks)
    test_clamp_applies_to_capsule_list()
    test_clamp_applies_to_skill_list()
    test_default_cap_is_50()

    ce_summary("wire_pagination")
    return 0
}

main()
