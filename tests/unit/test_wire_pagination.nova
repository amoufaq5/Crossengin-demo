fn test_ingest_policy_list_paginates() {
    let ctx = _mk_ctx_with_policies(6)
    let out = rpc_dispatch("ingest.policy.list", _args1("limit", "2"), ctx)
    ce_check("policy.list ok",           _has(out, "\"ok\":true"))
    ce_check("policy.list has policies", _has(out, "\"policies\":["))
    ce_check("policy.list has pol_000",  _has(out, "pol_000"))
    ce_check("policy.list has pol_001",  _has(out, "pol_001"))
    ce_check("policy.list stops @002",   _has(out, "pol_002") == 0)
    ce_check("policy.list next=pol_001",
             _has(out, "\"next_after\":\"pol_001\""))
}

fn test_ingest_policy_list_empty() {
