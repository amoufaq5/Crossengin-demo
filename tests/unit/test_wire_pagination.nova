    ce_check("skill.list has skills",   _has(out, "\"skills\":["))
    ce_check("skill.list has sk_000",   _has(out, "sk_000"))
    ce_check("skill.list has sk_002",   _has(out, "sk_002"))
    ce_check("skill.list stops @003",   _has(out, "sk_003") == 0)
    ce_check("skill.list next=sk_002",
             _has(out, "\"next_after\":\"sk_002\""))
}

fn test_skill_list_empty() {
