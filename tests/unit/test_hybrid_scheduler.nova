// Unit tests for src/scheduler/hybrid_scheduler.nova
// Verifies event draining, active/idle regime switching by idle detection, and
// rate throttling. ADR-0037, ADR-0036.

import "../ce_test.nova"
import "../../src/scheduler/hybrid_scheduler.nova"

fn test_scheduler() {
    let reg = part_registry_new()
    registry_spawn_fixed(reg, 32, 4)
    let hs = hs_new(reg)
    ce_eq("starts not idle", hs_is_idle(hs), 0)
    ce_eq("clock 0", hs_now(hs), 0)
    // Post an event; a step drains it, stays active, advances the tick.
    hs_post_event(hs, EV_MESSAGE, 42)
    ce_eq("one pending", hs_pending(hs), 1)
    let ev = hs_step(hs, TD_MOD_NEUTRAL, 0)
    ce_eq("drained the event", event_payload(ev), 42)
    ce_eq("tick advanced", hs_now(hs), 1)
    ce_eq("active rate", hs_rate(hs), TICK_RATE_ACTIVE)
    ce_eq("idle counter reset", hs_idle_ticks(hs), 0)
    // Run empty steps until idle detection trips.
    let i = 0
    while i < HS_IDLE_THRESHOLD { hs_step(hs, TD_MOD_NEUTRAL, 0); i = i + 1 }
    ce_eq("now idle", hs_is_idle(hs), 1)
    ce_eq("throttled to idle rate", hs_rate(hs), TICK_RATE_IDLE)
    // A new event wakes it back to active.
    hs_post_event(hs, EV_MOMENT, 7)
    hs_step(hs, TD_MOD_NEUTRAL, 0)
    ce_eq("woke active", hs_rate(hs), TICK_RATE_ACTIVE)
    ce_eq("not idle again", hs_is_idle(hs), 0)
}

fn main() { test_scheduler() ce_summary("hybrid_scheduler") }
main()
