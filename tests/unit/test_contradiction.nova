// Unit tests for src/parts/reasoning/contradiction.nova: detecting that a believed
// set of facts entails FALSE, with a kernel-CHECKED witness (not a heuristic).
// not P == P -> FALSE; a contradiction is holding both P and not P, and one
// modus-ponens step the trusted kernel verifies proves FALSE.

import "../ce_test.nova"
import "../../src/parts/reasoning/contradiction.nova"

// The negation pattern round-trips and is recognized.
fn test_negation_pattern() {
    let rain = term_atom("rain")
    let nrain = con_not(rain)
    ce_eq("not P is an implication into FALSE", con_is_negation(nrain), 1)
    ce_eq("inner recovers P", term_eq(con_negated_of(nrain), rain), 1)
    ce_eq("FALSE recognized", con_is_false(con_false()), 1)
    ce_eq("a plain atom is not a negation", con_is_negation(rain), 0)
    // an ordinary implication P -> Q (Q != FALSE) is not a negation.
    ce_eq("P->Q is not a negation", con_is_negation(term_imp(rain, term_atom("wet"))), 0)
}

// A direct contradiction {P, not P} is found AND the witness verifies in the
// kernel, concluding FALSE.
fn test_direct_contradiction_certified() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let r = con_scan_axioms(reg, axs, hyp_new())
    ce_eq("contradiction found", con_found(r), 1)
    // the returned witness is a REAL kernel proof of FALSE under these axioms.
    ce_eq("witness independently verifies as FALSE",
        verify_check(reg, axs, hyp_new(), con_proof(r), con_false()), 1)
    ce_eq("set reported inconsistent", con_is_consistent(reg, axs, hyp_new()), 0)
}

// A consistent set yields no contradiction.
fn test_consistent_set() {
    let reg = proof_registry_new()
    let axs = axiom_table_new()
    axiom_table_add(axs, term_atom("rain"))
    axiom_table_add(axs, term_atom("wet"))
    ce_eq("no contradiction", con_found(con_scan_axioms(reg, axs, hyp_new())), 0)
    ce_eq("set reported consistent", con_is_consistent(reg, axs, hyp_new()), 1)
}

// Holding only not P (without P) is NOT a contradiction -- FALSE is not derivable.
fn test_negation_alone_is_consistent() {
    let reg = proof_registry_new()
    let axs = axiom_table_new()
    axiom_table_add(axs, con_not(term_atom("p")))
    ce_eq("not P alone is consistent", con_is_consistent(reg, axs, hyp_new()), 1)
}

// The contradiction machinery works for COMPOUND propositions too:
// {(a and b), not (a and b)}.
fn test_compound_contradiction() {
    let reg = proof_registry_new()
    let conj = term_and(term_atom("a"), term_atom("b"))
    let axs = axiom_table_new()
    axiom_table_add(axs, conj)
    axiom_table_add(axs, con_not(conj))
    let r = con_scan_axioms(reg, axs, hyp_new())
    ce_eq("compound contradiction found", con_found(r), 1)
    ce_eq("compound witness verifies",
        verify_check(reg, axs, hyp_new(), con_proof(r), con_false()), 1)
}

// Soundness guard: the witness proves FALSE and ONLY FALSE -- it must not verify
// against some unrelated claim.
fn test_witness_is_sound() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let r = con_scan_axioms(reg, axs, hyp_new())
    ce_eq("witness does NOT prove an unrelated atom",
        verify_check(reg, axs, hyp_new(), con_proof(r), term_atom("q")), 0)
}

// The direct con_certify API: hand it the two sub-proofs, it confirms FALSE.
fn test_certify_api() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let np = con_not(p)
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, np)
    ce_eq("certify confirms the contradiction",
        con_certify(reg, axs, hyp_new(), pf_axiom(p), pf_axiom(np)), 1)
}

// ---- transitive scan: derived contradictions -------------------------------
// {P, P->Q, not Q}: no direct pair, but MP derives Q -> contradicts not Q. The
// direct scan misses it; the transitive scan finds it via sb_prove + verifies
// through the kernel.
fn test_transitive_via_mp() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, term_imp(p, q))
    axiom_table_add(axs, con_not(q))
    // Direct scan misses it (no literal P + not P pair).
    ce_eq("direct scan misses derived contradiction",
        con_found(con_scan_axioms(reg, axs, hyp_new())), 0)
    // Transitive scan finds it AND the kernel verifies.
    let r = con_scan_transitive(reg, axs, hyp_new(), 8)
    ce_eq("transitive scan finds it", con_found(r), 1)
    ce_eq("witness verifies as FALSE",
        verify_check(reg, axs, hyp_new(), con_proof(r), con_false()), 1)
    ce_eq("reported inconsistent", con_is_consistent_transitive(reg, axs, hyp_new(), 8), 0)
}

// A longer chain {A, A->B, B->C, not C}: HS-style derivation via two MPs;
// budget must be large enough for the depth.
fn test_transitive_chain() {
    let reg = proof_registry_new()
    let axs = axiom_table_new()
    axiom_table_add(axs, term_atom("a"))
    axiom_table_add(axs, term_imp(term_atom("a"), term_atom("b")))
    axiom_table_add(axs, term_imp(term_atom("b"), term_atom("c")))
    axiom_table_add(axs, con_not(term_atom("c")))
    let r = con_scan_transitive(reg, axs, hyp_new(), 16)
    ce_eq("chain contradiction found", con_found(r), 1)
    ce_eq("chain witness verifies",
        verify_check(reg, axs, hyp_new(), con_proof(r), con_false()), 1)
}

// A consistent set stays consistent under the transitive scan: {P, P->Q, not R}
// -- Q derives, but nothing derives R, so no FALSE.
fn test_transitive_consistent_set() {
    let reg = proof_registry_new()
    let axs = axiom_table_new()
    axiom_table_add(axs, term_atom("p"))
    axiom_table_add(axs, term_imp(term_atom("p"), term_atom("q")))
    axiom_table_add(axs, con_not(term_atom("r")))
    ce_eq("no derivable contradiction",
        con_is_consistent_transitive(reg, axs, hyp_new(), 12), 1)
}

// The transitive scan should still catch DIRECT contradictions too (a
// zero-step "derivation"): {P, not P} works with a small budget.
fn test_transitive_catches_direct() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let r = con_scan_transitive(reg, axs, hyp_new(), 4)
    ce_eq("transitive also catches direct", con_found(r), 1)
}

// ---- conflict-set extraction -----------------------------------------------
// Direct contradiction: the used-premises list is exactly {P, not P}.
fn test_conflict_set_direct() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let cs = con_conflict_set(reg, axs, hyp_new(), 4)
    ce_eq("conflict found", con_cs_found(cs), 1)
    let used = con_cs_premises(cs)
    ce_eq("exactly two premises in the conflict", len(used), 2)
    ce_eq("witness verifies as FALSE",
        verify_check(reg, axs, hyp_new(), con_cs_proof(cs), con_false()), 1)
}

// Transitive contradiction: {P, P->Q, not Q, R (irrelevant)}. The conflict set
// pins down P, P->Q, not Q -- and does NOT include R (minimal in the sense
// "only what the proof actually uses").
fn test_conflict_set_transitive_excludes_unrelated() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let r = term_atom("r")                  // irrelevant to the conflict
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, term_imp(p, q))
    axiom_table_add(axs, con_not(q))
    axiom_table_add(axs, r)
    let cs = con_conflict_set(reg, axs, hyp_new(), 12)
    ce_eq("derived conflict found", con_cs_found(cs), 1)
    let used = con_cs_premises(cs)
    // The three used premises: P, P->Q, not Q -- R is not touched.
    ce_eq("three premises used", len(used), 3)
    let has_r = 0
    let i = 0
    while i < len(used) {
        if term_eq(used[i], r) == 1 { has_r = 1 }
        i = i + 1
    }
    ce_eq("unrelated R not in conflict set", has_r, 0)
}

// A CONSISTENT set produces an empty conflict set (nothing found).
fn test_conflict_set_consistent_returns_empty() {
    let reg = proof_registry_new()
    let axs = axiom_table_new()
    axiom_table_add(axs, term_atom("a"))
    axiom_table_add(axs, term_atom("b"))
    let cs = con_conflict_set(reg, axs, hyp_new(), 8)
    ce_eq("no conflict found", con_cs_found(cs), 0)
    ce_eq("empty conflict set", len(con_cs_premises(cs)), 0)
}

// Dedup: if a premise appears twice in the proof tree (unlikely but possible
// when a term is reused), it is listed once in the used-premises list.
fn test_conflict_set_dedups() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    // handcrafted: MP(not P, AND_EL of (P and P)) reuses P via a different route
    // -- easier to just assert the direct case and check the list is a SET.
    let cs = con_conflict_set(reg, axs, hyp_new(), 4)
    let used = con_cs_premises(cs)
    let i = 0
    let dupes = 0
    while i < len(used) {
        let j = i + 1
        while j < len(used) {
            if term_eq(used[i], used[j]) == 1 { dupes = dupes + 1 }
            j = j + 1
        }
        i = i + 1
    }
    ce_eq("no duplicate premises in the set", dupes, 0)
}

// ---- proof pretty-printing --------------------------------------------------
// Term rendering: atoms, negations, conjunctions, and FALSE all read cleanly.
fn test_render_term() {
    ce_check("atom renders as its label",
        str_find(con_render_term(term_atom("rain")), "rain") != (0 - 1))
    ce_check("FALSE renders as FALSE",
        str_find(con_render_term(con_false()), "FALSE") != (0 - 1))
    ce_check("negation renders as 'not X'",
        str_find(con_render_term(con_not(term_atom("q"))), "not") != (0 - 1))
    ce_check("plain implication renders as A -> B",
        str_find(con_render_term(term_imp(term_atom("a"), term_atom("b"))), "->") != (0 - 1))
    ce_check("and renders as (X and Y)",
        str_find(con_render_term(term_and(term_atom("a"), term_atom("b"))), "and") != (0 - 1))
}

// The direct contradiction proof renders as a 3-step derivation.
fn test_render_direct_contradiction() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let r = con_scan_axioms(reg, axs, hyp_new())
    let text = con_render_proof(con_proof(r))
    // Three steps: assume not-P, assume P, MP -> FALSE.
    ce_check("mentions FALSE",  str_find(text, "FALSE") != (0 - 1))
    ce_check("mentions MP",     str_find(text, "MP") != (0 - 1))
    ce_check("mentions 'not p'", str_find(text, "not p") != (0 - 1))
    ce_check("has three numbered steps",
        str_find(text, "3.") != (0 - 1))
}

// The transitive proof renders every intermediate step (the MP derivation of q).
fn test_render_transitive_contradiction() {
    let reg = proof_registry_new()
    let axs = axiom_table_new()
    axiom_table_add(axs, term_atom("p"))
    axiom_table_add(axs, term_imp(term_atom("p"), term_atom("q")))
    axiom_table_add(axs, con_not(term_atom("q")))
    let cs = con_conflict_set(reg, axs, hyp_new(), 12)
    let text = con_render_proof(con_cs_proof(cs))
    ce_check("cites MP (twice: derive q, then FALSE)", str_find(text, "MP") != (0 - 1))
    ce_check("mentions q", str_find(text, "q") != (0 - 1))
    ce_check("mentions FALSE at the end", str_find(text, "FALSE") != (0 - 1))
    // At least 5 lines (assume p; assume p->q; derive q; assume not q; derive FALSE).
    ce_check("has at least 5 steps", str_find(text, "5.") != (0 - 1))
}

// Annotated rendering: passing an empty annotations list is EXACTLY the same
// output as the plain con_render_proof (backwards-compat: existing callers
// unaffected).
fn test_render_annotations_backwards_compat() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let r = con_scan_axioms(reg, axs, hyp_new())
    let bare = con_render_proof(con_proof(r))
    let empty = con_render_proof_annotated(con_proof(r), list_new())
    ce_check("empty annotations == plain",
        str_find(bare, "MP") != (0 - 1))
    ce_check("empty annotations also mentions MP",
        str_find(empty, "MP") != (0 - 1))
    // No annotation brackets in either.
    ce_eq("no [ in bare", str_find(bare, "["), 0 - 1)
    ce_eq("no [ in empty-ann", str_find(empty, "["), 0 - 1)
}

// With annotations: each AXIOM leaf whose term matches gets its label appended.
fn test_render_annotations_appear() {
    let reg = proof_registry_new()
    let p = term_atom("p")
    let axs = axiom_table_new()
    axiom_table_add(axs, p)
    axiom_table_add(axs, con_not(p))
    let r = con_scan_axioms(reg, axs, hyp_new())
    // Build annotations: p -> "user-taught", not p -> "wikipedia".
    let ann = list_new()
    let ap = list_new() push(ap, p) push(ap, "user-taught") push(ann, ap)
    let anp = list_new() push(anp, con_not(p)) push(anp, "wikipedia") push(ann, anp)
    let text = con_render_proof_annotated(con_proof(r), ann)
    ce_check("user-taught annotation appears",
        str_find(text, "user-taught") != (0 - 1))
    ce_check("wikipedia annotation appears",
        str_find(text, "wikipedia") != (0 - 1))
    ce_check("annotation is bracketed",
        str_find(text, "[") != (0 - 1))
}

fn main() {
    test_negation_pattern()
    test_direct_contradiction_certified()
    test_consistent_set()
    test_negation_alone_is_consistent()
    test_compound_contradiction()
    test_witness_is_sound()
    test_certify_api()
    test_transitive_via_mp()
    test_transitive_chain()
    test_transitive_consistent_set()
    test_transitive_catches_direct()
    test_conflict_set_direct()
    test_conflict_set_transitive_excludes_unrelated()
    test_conflict_set_consistent_returns_empty()
    test_conflict_set_dedups()
    test_render_term()
    test_render_direct_contradiction()
    test_render_transitive_contradiction()
    test_render_annotations_backwards_compat()
    test_render_annotations_appear()
    ce_summary("contradiction")
}

main()
