// Unit tests for the CAPSULE / VERSION / DESCRIPTION / LICENSE / DEPS
// directives added to src/ingest/importers/records.nova per ADR-0106.

import "../ce_test.nova"
import "../../src/ingest/importers/records.nova"

fn test_plain_record_has_no_capsule() {
    let text = "KG astronomy\nSRC src:pack:solar\nATOM sun 1 1000\n"
    let r = cerec_parse_text(text)
    let rec = cerec_records(r)[0]
    ce_eq("record has 0 capsule meta", cur_has_capsule(rec), 0)
    ce_eq("no errors", len(cerec_errors(r)), 0)
}

fn test_capsule_directive_populates_metadata() {
    let text = "CAPSULE medicine\n"
             + "VERSION 1.0.0\n"
             + "DESCRIPTION Reference clinical medicine at Merck Manual level\n"
             + "LICENSE CC-BY-4.0\n"
             + "KG medicine\n"
             + "SRC src:pack:medicine\n"
             + "ATOM infection 1 950\n"
    let r = cerec_parse_text(text)
    ce_eq("no errors", len(cerec_errors(r)), 0)
    let rec = cerec_records(r)[0]
    ce_eq("has capsule", cur_has_capsule(rec), 1)
    ce_eq("capsule name", cur_capsule_name(rec), "medicine")
    ce_eq("capsule version", cur_capsule_version(rec), "1.0.0")
    ce_eq("capsule description",
          cur_capsule_description(rec),
          "Reference clinical medicine at Merck Manual level")
    ce_eq("capsule license", cur_capsule_license(rec), "CC-BY-4.0")
    ce_eq("no deps", len(cur_capsule_deps(rec)), 0)
    ce_eq("atom present", len(cur_atoms(rec)), 1)
}

fn test_deps_directive_parses_comma_list() {
    let text = "CAPSULE medicine\n"
             + "VERSION 1.0.0\n"
             + "DEPS biology:1.0.0, human_anatomy:1.0.0, chemistry:0.9.0\n"
             + "KG medicine\n"
             + "SRC src:pack:medicine\n"
    let r = cerec_parse_text(text)
    ce_eq("no errors", len(cerec_errors(r)), 0)
    let rec = cerec_records(r)[0]
    let deps = cur_capsule_deps(rec)
    ce_eq("3 deps", len(deps), 3)
    ce_eq("dep 0 name", deps[0][0], "biology")
    ce_eq("dep 0 version", deps[0][1], "1.0.0")
    ce_eq("dep 1 name", deps[1][0], "human_anatomy")
    ce_eq("dep 2 name", deps[2][0], "chemistry")
    ce_eq("dep 2 version", deps[2][1], "0.9.0")
}

fn test_deps_malformed_entry_logged() {
    let text = "CAPSULE med\n"
             + "VERSION 1.0.0\n"
             + "DEPS good:1.0.0, no_colon_here, ok:1.0.0\n"
             + "KG med\nSRC src:x\n"
    let r = cerec_parse_text(text)
    ce_check("has parse error for bad dep", len(cerec_errors(r)) >= 1)
    let rec = cerec_records(r)[0]
    // The two valid entries still land.
    ce_eq("2 valid deps kept", len(cur_capsule_deps(rec)), 2)
}

fn test_directives_out_of_order_ok() {
    // VERSION arriving before CAPSULE is tolerated -- the parser
    // creates a pending capsule-meta slot; CAPSULE fills in the name.
    let text = "VERSION 2.1.0\n"
             + "LICENSE MIT\n"
             + "CAPSULE payments\n"
             + "KG payments\nSRC src:x\n"
    let r = cerec_parse_text(text)
    ce_eq("no errors", len(cerec_errors(r)), 0)
    let rec = cerec_records(r)[0]
    ce_eq("has capsule", cur_has_capsule(rec), 1)
    ce_eq("name landed", cur_capsule_name(rec), "payments")
    ce_eq("version landed", cur_capsule_version(rec), "2.1.0")
    ce_eq("license landed", cur_capsule_license(rec), "MIT")
}

fn test_multi_record_each_has_own_capsule() {
    let text = "CAPSULE a\nVERSION 1.0.0\nKG ak\nSRC src:a\nATOM x 1 500\n"
             + "CAPSULE b\nVERSION 2.0.0\nKG bk\nSRC src:b\nATOM y 1 500\n"
    let r = cerec_parse_text(text)
    let recs = cerec_records(r)
    ce_eq("2 records", len(recs), 2)
    ce_eq("first is capsule a", cur_capsule_name(recs[0]), "a")
    ce_eq("second is capsule b", cur_capsule_name(recs[1]), "b")
    ce_eq("first version", cur_capsule_version(recs[0]), "1.0.0")
    ce_eq("second version", cur_capsule_version(recs[1]), "2.0.0")
}

fn test_description_preserves_spaces_and_punctuation() {
    let text = "CAPSULE k\n"
             + "VERSION 1.0.0\n"
             + "DESCRIPTION A one-line, spaces + punctuation description.\n"
             + "KG k\nSRC src:x\n"
    let r = cerec_parse_text(text)
    let rec = cerec_records(r)[0]
    ce_eq("description exact",
          cur_capsule_description(rec),
          "A one-line, spaces + punctuation description.")
}

fn test_capsule_directives_are_backward_compatible() {
    // Existing tests (test_ingest_records.nova) already prove pure-KG
    // records still parse. This test confirms a record MIXING pure KG
    // sections with a capsule section is fine.
    let text = "KG plain\nSRC src:plain\nATOM p 1 500\n"
             + "CAPSULE c1\nVERSION 1.0.0\nKG cap\nSRC src:c\nATOM q 1 500\n"
    let r = cerec_parse_text(text)
    let recs = cerec_records(r)
    ce_eq("2 records", len(recs), 2)
    ce_eq("first has NO capsule", cur_has_capsule(recs[0]), 0)
    ce_eq("second HAS capsule", cur_has_capsule(recs[1]), 1)
}

fn main() {
    test_plain_record_has_no_capsule()
    test_capsule_directive_populates_metadata()
    test_deps_directive_parses_comma_list()
    test_deps_malformed_entry_logged()
    test_directives_out_of_order_ok()
    test_multi_record_each_has_own_capsule()
    test_description_preserves_spaces_and_punctuation()
    test_capsule_directives_are_backward_compatible()
    ce_summary("ingest_records_capsule")
}

main()
