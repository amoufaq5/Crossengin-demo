// CE_TEST_TIMEOUT: 240
// End-to-end tests of src/learning/sa4_coord.nova (A2.2b), part 2: one bad
// or silent soul is left out and the round still completes for the rest
// (N = 5, t = 4), with the unmasked sum equal to the sum over U3.
//   - a soul reveals the wrong kind of share: its reveals are ignored and
//     the other four suffice.

import "../ce_test.nova"
import "../sa4_harness.nova"

let C2_R = 35

fn c2_run(vc, stops, tampers) {
    let roster = sa4h_roster(5)
    let souls = sa4h_souls(roster, 5, C2_R, vc, 0)
    let c = sa4e_coord(roster, C2_R, vc)
    let res = sa4e_round(roster, souls, c, stops, tampers)
    if res[0] != 1 { println("  reason: " + res[1]) }
    return res
}

fn main() {
    let vc = list_new()
    let e = c2_run(vc, list_new(), [[0, 4, 3]])
    ce_eq("wrong reveal kind: unmasks from the other four", e[0], 1)
    ce_check("wrong reveal kind: reason recorded", find_bytes(sa4c_why(e[3], 7), "wrong share kind") >= 0)
    ce_eq("wrong reveal kind: revealers = 4", len(sa4c_set(e[3], 5)), 4)
    ce_eq("wrong reveal kind: sum correct", sa4h_same(e[2], sa4h_expected([1, 2, 3, 4, 5])), 1)
    ce_summary("sa4_coord4")
}

main()
