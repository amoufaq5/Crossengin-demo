// Unit tests for src/safety/sha256.nova (R33A canonical SHA-256 + HMAC).
//
// Coverage
//   * FIPS 180-4 SHA-256 known-answer vectors:
//       - SHA-256("abc") = ba7816bf...0015ad
//       - SHA-256("") = e3b0c442...2b855
//       - SHA-256(56-char Appendix B.2 input) = 248d6a61...db06c1
//       - SHA-256("A" * 55) -- one-block boundary case
//       - SHA-256("a" * 1000) -- 15-block long input
//   * Streaming (sha256_init / update / final) equivalence vs oneshot:
//       - empty input
//       - small input
//       - large input split across multiple update() calls
//       - update sizes that straddle 64-byte block boundaries
//   * Byte-list wrapper round-trip (sha256_oneshot_bytes).
//   * HMAC-SHA256 RFC 4231 test vectors:
//       - TC1: key=0x0b*20, data="Hi There"
//       - TC2: key="Jefe", data="what do ya want for nothing?"
//       - TC4: key=0x01..0x19, data=0xcd*50
//       - long-key path (>64-byte key gets pre-hashed)
//
// References
//   FIPS 180-4 §5.3.3, §6.2 -- SHA-256 IV, K table, compression function.
//   FIPS 180-4 Appendix B   -- worked examples for "abc" + 56-char input.
//   RFC 4231 §4.1-4.5       -- HMAC-SHA256 test vectors.
//
// NOVA dependencies: ce_test harness, sha256.nova (R33A canonical).

import "../ce_test.nova"
import "../../src/safety/sha256.nova"

// ---- helpers --------------------------------------------------------------

fn _t_buf_from_str(s) {
    let n = len(s)
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, char_at(s, i))
        i = i + 1
    }
    store8(buf + n, 0)
    let r = list_new()
    push(r, buf)
    push(r, n)
    return r
}

fn _t_nibble_hex(n) {
    if n < 10 { return 48 + n }      // '0'..'9'
    return 87 + n                    // 'a'..'f'
}

fn _t_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        let hi = _t_nibble_hex(int_and(int_shr(b, 4), 15))
        let lo = _t_nibble_hex(int_and(b, 15))
        s = s + chr(hi) + chr(lo)
        i = i + 1
    }
    return s
}

fn _t_hex_nibble(c) {
    if c >= 48 {
        if c <= 57 { return c - 48 }
    }
    if c >= 97 {
        if c <= 102 { return c - 87 }
    }
    if c >= 65 {
        if c <= 70 { return c - 55 }
    }
    return 0 - 1
}

fn _t_hex_to_buf(hex) {
    let n = len(hex)
    let half = int_shr(n, 1)
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _t_hex_nibble(char_at(hex, i * 2))
        let lo = _t_hex_nibble(char_at(hex, i * 2 + 1))
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    let r = list_new()
    push(r, buf)
    push(r, half)
    return r
}

// ---- FIPS 180-4 SHA-256 vectors ------------------------------------------

fn test_sha256_abc() {
    // FIPS 180-4 Appendix B.1: SHA-256("abc")
    let p = _t_buf_from_str("abc")
    let h = sha256_oneshot(p[0], p[1])
    ce_str_eq("SHA-256('abc')",
        _t_hex_encode_buf(h, 32),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

fn test_sha256_empty() {
    // SHA-256("") (NIST reference)
    let buf = alloc(1)
    store8(buf, 0)
    let h = sha256_oneshot(buf, 0)
    ce_str_eq("SHA-256('')",
        _t_hex_encode_buf(h, 32),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}

fn test_sha256_fips_appendix_b2() {
    // FIPS 180-4 Appendix B.2: 56-char input (forces a 2-block padding).
    let p = _t_buf_from_str(
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    let h = sha256_oneshot(p[0], p[1])
    ce_str_eq("SHA-256(FIPS Appendix B.2 56-char input)",
        _t_hex_encode_buf(h, 32),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
}

fn test_sha256_one_block_boundary() {
    // 55-byte input: exactly fits in one block including the 0x80 + 8B
    // length tail (rem = 55 -> need_two = 0).
    let n = 55
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 65); i = i + 1 }   // 'A' * 55
    store8(buf + n, 0)
    let h = sha256_oneshot(buf, n)
    ce_str_eq("SHA-256('A' * 55) one-block boundary",
        _t_hex_encode_buf(h, 32),
        "8963cc0afd622cc7574ac2011f93a3059b3d65548a77542a1559e3d202e6ab00")
}

fn test_sha256_long_input() {
    // 1000 bytes = 15 full blocks + 40-byte tail. Exercises the
    // multi-block path with a non-trivial residue. Reference computed
    // by Python hashlib + openssl: same digest.
    let n = 1000
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 97); i = i + 1 }   // 'a' * 1000
    store8(buf + n, 0)
    let h = sha256_oneshot(buf, n)
    ce_str_eq("SHA-256('a' * 1000)",
        _t_hex_encode_buf(h, 32),
        "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")
}

// ---- One-shot bytes wrapper ----------------------------------------------

fn test_sha256_oneshot_bytes() {
    let bl = list_new()
    push(bl, 97)   // 'a'
    push(bl, 98)   // 'b'
    push(bl, 99)   // 'c'
    let digest = sha256_oneshot_bytes(bl)
    ce_eq("sha256_oneshot_bytes length is 32", len(digest), 32)
    // Byte 0 of SHA-256('abc') is 0xba = 186.
    ce_eq("sha256_oneshot_bytes[0] = 0xba", digest[0], 186)
    // Byte 31 of SHA-256('abc') is 0xad = 173.
    ce_eq("sha256_oneshot_bytes[31] = 0xad", digest[31], 173)
}

// ---- Streaming equivalence -----------------------------------------------

fn test_sha256_streaming_empty() {
    // sha256_init + final (no update) = SHA-256("")
    let st = sha256_init()
    let h = sha256_final(st)
    ce_str_eq("streaming empty input matches oneshot",
        _t_hex_encode_buf(h, 32),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}

fn test_sha256_streaming_abc_single_update() {
    // Single update of 'abc'.
    let p = _t_buf_from_str("abc")
    let st = sha256_init()
    sha256_update(st, p[0], p[1])
    let h = sha256_final(st)
    ce_str_eq("streaming 'abc' single-update",
        _t_hex_encode_buf(h, 32),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

fn test_sha256_streaming_abc_byte_at_a_time() {
    // Same vector, but feed each byte through a separate update() call.
    // Tests the partial-buffer accumulation path.
    let p = _t_buf_from_str("abc")
    let st = sha256_init()
    let i = 0
    while i < p[1] {
        sha256_update(st, p[0] + i, 1)
        i = i + 1
    }
    let h = sha256_final(st)
    ce_str_eq("streaming 'abc' byte-at-a-time matches oneshot",
        _t_hex_encode_buf(h, 32),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

fn test_sha256_streaming_block_aligned() {
    // 128-byte input (two full 64-byte blocks) fed as a single update.
    let n = 128
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, int_and(i, 255)); i = i + 1 }
    store8(buf + n, 0)
    let h_one = sha256_oneshot(buf, n)
    let st = sha256_init()
    sha256_update(st, buf, n)
    let h_stream = sha256_final(st)
    ce_str_eq("streaming matches oneshot on 128-byte block-aligned input",
        _t_hex_encode_buf(h_stream, 32),
        _t_hex_encode_buf(h_one, 32))
}

fn test_sha256_streaming_straddle_block() {
    // 1000-byte input fed in two updates that cross a block boundary.
    // Split point chosen so the first update ends mid-block (37 bytes)
    // and the second update both finishes that block and contributes
    // additional full blocks + a tail.
    let n = 1000
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 97); i = i + 1 }   // 'a' * 1000
    store8(buf + n, 0)
    let h_one = sha256_oneshot(buf, n)
    let st = sha256_init()
    sha256_update(st, buf, 37)
    sha256_update(st, buf + 37, n - 37)
    let h_stream = sha256_final(st)
    ce_str_eq("streaming matches oneshot when updates straddle block boundary",
        _t_hex_encode_buf(h_stream, 32),
        _t_hex_encode_buf(h_one, 32))
}

fn test_sha256_streaming_many_splits() {
    // Same 1000-byte input fed across 7 distinct update() calls of
    // varying sizes (some smaller than a block, some larger). Tests
    // the partial-buffer top-up path repeatedly.
    let n = 1000
    let buf = alloc(n + 1)
    let i = 0
    while i < n { store8(buf + i, 97); i = i + 1 }
    store8(buf + n, 0)
    let h_one = sha256_oneshot(buf, n)
    let st = sha256_init()
    sha256_update(st, buf, 13)         // small
    sha256_update(st, buf + 13, 64)    // bigger than block
    sha256_update(st, buf + 77, 1)     // tiny
    sha256_update(st, buf + 78, 200)   // multi-block
    sha256_update(st, buf + 278, 0)    // empty (no-op)
    sha256_update(st, buf + 278, 511)  // big
    sha256_update(st, buf + 789, 211)  // tail
    let h_stream = sha256_final(st)
    ce_str_eq("streaming matches oneshot with 7 mixed-size updates",
        _t_hex_encode_buf(h_stream, 32),
        _t_hex_encode_buf(h_one, 32))
}

// ---- HMAC-SHA256 RFC 4231 vectors ----------------------------------------

fn test_hmac_sha256_rfc4231_tc1() {
    // RFC 4231 §4.2 Test Case 1:
    //   key  = 0x0b * 20
    //   data = "Hi There"
    //   expected = b0344c61d8db38535ca8afceaf0bf12b
    //              881dc200c9833da726e9376c2e32cff7
    let key = _t_hex_to_buf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let msg = _t_buf_from_str("Hi There")
    let mac = hmac_sha256(key[0], key[1], msg[0], msg[1])
    ce_str_eq("HMAC-SHA256 RFC 4231 TC1",
        _t_hex_encode_buf(mac, 32),
        "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
}

fn test_hmac_sha256_rfc4231_tc2() {
    // RFC 4231 §4.3 Test Case 2:
    //   key  = "Jefe"
    //   data = "what do ya want for nothing?"
    //   expected = 5bdcc146bf60754e6a042426089575c7
    //              5a003f089d2739839dec58b964ec3843
    let key = _t_buf_from_str("Jefe")
    let msg = _t_buf_from_str("what do ya want for nothing?")
    let mac = hmac_sha256(key[0], key[1], msg[0], msg[1])
    ce_str_eq("HMAC-SHA256 RFC 4231 TC2",
        _t_hex_encode_buf(mac, 32),
        "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
}

fn test_hmac_sha256_rfc4231_tc4() {
    // RFC 4231 §4.5 Test Case 4:
    //   key  = 0x01 0x02 0x03 ... 0x19 (25 bytes)
    //   data = 0xcd * 50
    //   expected = 82558a389a443c0ea4cc819899f2083a
    //              85f0faa3e578f8077a2e3ff46729665b
    let key = _t_hex_to_buf("0102030405060708090a0b0c0d0e0f10111213141516171819")
    let msg_n = 50
    let msg_buf = alloc(msg_n + 1)
    let i = 0
    while i < msg_n { store8(msg_buf + i, 205); i = i + 1 }   // 0xcd
    store8(msg_buf + msg_n, 0)
    let mac = hmac_sha256(key[0], key[1], msg_buf, msg_n)
    ce_str_eq("HMAC-SHA256 RFC 4231 TC4",
        _t_hex_encode_buf(mac, 32),
        "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
}

fn test_hmac_sha256_long_key() {
    // RFC 4231 §4.6 Test Case 5 partial check: a > 64-byte key gets
    // pre-hashed inside HMAC. Verify the long-key normalization
    // branch by comparing HMAC-SHA256(long_key, msg) against
    // HMAC-SHA256(SHA-256(long_key), msg). Both should produce the
    // same MAC; that's exactly what RFC 2104 §2 specifies.
    let key_n = 80
    let key_buf = alloc(key_n + 1)
    let i = 0
    while i < key_n { store8(key_buf + i, 170); i = i + 1 }   // 0xaa * 80
    store8(key_buf + key_n, 0)
    let msg = _t_buf_from_str("Test Using Larger Than Block-Size Key - Hash Key First")
    let mac_long = hmac_sha256(key_buf, key_n, msg[0], msg[1])
    // Pre-hash the key, pad it to 64 bytes with zeros, and HMAC again.
    let key_hash = sha256_oneshot(key_buf, key_n)
    let mac_prehash = hmac_sha256(key_hash, 32, msg[0], msg[1])
    ce_str_eq("HMAC long-key matches HMAC(SHA-256(key)) normalization",
        _t_hex_encode_buf(mac_long, 32),
        _t_hex_encode_buf(mac_prehash, 32))
}

// ---- Sanity: SHA256_HASH_LEN / SHA256_BLOCK_LEN constants ----------------

fn test_constants() {
    ce_eq("SHA256_HASH_LEN = 32", SHA256_HASH_LEN, 32)
    ce_eq("SHA256_BLOCK_LEN = 64", SHA256_BLOCK_LEN, 64)
}

// ---- Run ----------------------------------------------------------------

fn main() {
    test_sha256_abc()
    test_sha256_empty()
    test_sha256_fips_appendix_b2()
    test_sha256_one_block_boundary()
    test_sha256_long_input()
    test_sha256_oneshot_bytes()
    test_sha256_streaming_empty()
    test_sha256_streaming_abc_single_update()
    test_sha256_streaming_abc_byte_at_a_time()
    test_sha256_streaming_block_aligned()
    test_sha256_streaming_straddle_block()
    test_sha256_streaming_many_splits()
    test_hmac_sha256_rfc4231_tc1()
    test_hmac_sha256_rfc4231_tc2()
    test_hmac_sha256_rfc4231_tc4()
    test_hmac_sha256_long_key()
    test_constants()
    ce_summary("sha256")
}

main()
