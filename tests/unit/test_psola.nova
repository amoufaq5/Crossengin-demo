// Unit tests for src/io/transducers/audio_psola.nova (R12D).

import "../ce_test.nova"
import "../../src/io/transducers/audio_psola.nova"
import "../../src/io/transducers/audio_pitch.nova"
import "../../src/io/effectors/audio_synth.nova"

fn _zero_buf(n) {
    let b = list_new()
    let i = 0
    while i < n {
        push(b, 0)
        i = i + 1
    }
    return b
}

fn _max_abs_diff(a, b) {
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n { n = nb }
    let i = 0
    let m = 0
    while i < n {
        let d = a[i] - b[i]
        if d < 0 { d = 0 - d }
        if d > m { m = d }
        i = i + 1
    }
    return m
}

fn _yin_f0_centi(samples, sr) {
    if len(samples) < (sr * 30) / 1000 { return 0 }
    let view = list_new()
    let i = 0
    let end = (sr * 30) / 1000
    while i < end {
        push(view, samples[i])
        i = i + 1
    }
    let res = pitch_estimate_frame_yin(view, sr, 0, 0, 0)
    return pitch_result_f0_centihz(res)
}

fn _yin_mean_f0_centi(samples, sr) {
    let contour = pitch_track_yin(samples, sr)
    return pitch_mean_voiced(contour)
}

fn test_psola_constants() {
    ce_eq("identity factor = 1000", psola_factor_identity(), 1000)
    ce_eq("factor_min = 250",       psola_factor_min(), 250)
    ce_eq("factor_max = 4000",      psola_factor_max(), 4000)
    ce_eq("max_samples = 480000",   psola_max_samples(), 480000)
    ce_eq("fallback period ms = 10", psola_fallback_period_ms(), 10)
}

fn test_hann_window_endpoints_zero() {
    let h0 = psola_hann_window(0, 160)
    let hN = psola_hann_window(160, 160)
    ce_eq("hann(0, 160) = 0", h0, 0)
    ce_eq("hann(160, 160) = 0", hN, 0)
}

fn test_hann_window_centre_peak() {
    let h_mid = psola_hann_window(80, 160)
    ce_check("hann(80, 160) ~ 1000 (peak): in [990..1010]",
             h_mid >= 990 && h_mid <= 1010)
}

fn test_hann_window_symmetric() {
    let h_a = psola_hann_window(20, 160)
    let h_b = psola_hann_window(140, 160)
    let d = h_a - h_b
    if d < 0 { d = 0 - d }
    ce_check("hann symmetric: |h(20)-h(140)| <= 10", d <= 10)
}

fn test_pitch_marks_on_sine() {
    let s = synth_sine(200, 4800, 16000)
    let marks = psola_pitch_marks(s, 16000)
    let m = len(marks)
    ce_check("200 Hz sine: pitch marks >= 30", m >= 30)
    ce_check("200 Hz sine: pitch marks <= 70", m <= 70)
}

fn test_pitch_marks_spacing() {
    let s = synth_sine(200, 4800, 16000)
    let marks = psola_pitch_marks(s, 16000)
    let m = len(marks)
    let avg = 80
    if m > 1 {
        avg = (marks[m - 1] - marks[0]) / (m - 1)
    }
    ce_check("avg mark spacing in [65..95] for 200 Hz sine",
             avg >= 65 && avg <= 95)
}

fn test_identity_transform_preserves_length() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_transform(s, 16000, 1000, 1000)
    ce_eq("identity transform: output length == input length",
          len(out), len(s))
}

fn test_identity_transform_close_to_input() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_transform(s, 16000, 1000, 1000)
    let mid_in = list_new()
    let mid_out = list_new()
    let i = 800
    while i < 4000 {
        push(mid_in, s[i])
        push(mid_out, out[i])
        i = i + 1
    }
    let m = _max_abs_diff(mid_in, mid_out)
    ce_check("identity transform: max sample diff <= 6000 (PSOLA artifact band)",
             m <= 6000)
    let f_in  = _yin_f0_centi(s, 16000)
    let f_out = _yin_f0_centi(out, 16000)
    let df = f_in - f_out
    if df < 0 { df = 0 - df }
    ce_check("identity: F0 in/out match within 200 centi-Hz",
             df <= 200)
}

fn test_pitch_shift_up_doubles_f0() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_pitch_shift(s, 16000, 2000)
    let f_out = _yin_mean_f0_centi(out, 16000)
    ce_check("pitch_shift up 2x: F0 in [30000..50000] centi-Hz (~400 Hz)",
             f_out >= 30000 && f_out <= 50000)
    ce_eq("pitch_shift up: output length == input length",
          len(out), len(s))
}

fn test_pitch_shift_up_increases_f0() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_pitch_shift(s, 16000, 1500)
    let f_in  = _yin_mean_f0_centi(s, 16000)
    let f_out = _yin_mean_f0_centi(out, 16000)
    ce_check("pitch_shift 1.5x: F0 increases vs input",
             f_out > f_in)
}

fn test_pitch_shift_down_halves_f0() {
    let s = synth_sine(200, 9600, 16000)
    let out = psola_pitch_shift(s, 16000, 500)
    let f_out = _yin_mean_f0_centi(out, 16000)
    ce_check("pitch_shift down 0.5x: F0 in [5000..15000] centi-Hz (~100 Hz)",
             f_out >= 5000 && f_out <= 15000)
}

fn test_pitch_shift_down_decreases_f0() {
    let s = synth_sine(300, 4800, 16000)
    let out = psola_pitch_shift(s, 16000, 700)
    let f_in  = _yin_mean_f0_centi(s, 16000)
    let f_out = _yin_mean_f0_centi(out, 16000)
    ce_check("pitch_shift 0.7x: F0 decreases vs input",
             f_out < f_in)
}

fn test_time_stretch_2x_doubles_duration() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_time_stretch(s, 16000, 2000)
    let in_len = len(s)
    let out_len = len(out)
    let lo = (in_len * 18) / 10
    let hi = (in_len * 22) / 10
    ce_check("time_stretch 2x: output length in [1.8*in..2.2*in]",
             out_len >= lo && out_len <= hi)
    let f_in  = _yin_mean_f0_centi(s, 16000)
    let f_out = _yin_mean_f0_centi(out, 16000)
    let df = f_in - f_out
    if df < 0 { df = 0 - df }
    ce_check("time_stretch 2x: F0 preserved within 1500 centi-Hz",
             df <= 1500)
}

fn test_time_stretch_half_halves_duration() {
    let s = synth_sine(200, 9600, 16000)
    let out = psola_time_stretch(s, 16000, 500)
    let in_len = len(s)
    let out_len = len(out)
    let lo = (in_len * 4) / 10
    let hi = (in_len * 6) / 10
    ce_check("time_stretch 0.5x: output length in [0.4*in..0.6*in]",
             out_len >= lo && out_len <= hi)
}

fn test_combined_pitch_up_time_slower() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_transform(s, 16000, 2000, 2000)
    let in_len = len(s)
    let out_len = len(out)
    let lo = (in_len * 18) / 10
    let hi = (in_len * 22) / 10
    ce_check("combined 2x/2x: output length in [1.8*in..2.2*in]",
             out_len >= lo && out_len <= hi)
    let f_out = _yin_mean_f0_centi(out, 16000)
    ce_check("combined 2x/2x: output F0 in [30000..50000] centi-Hz (~400 Hz)",
             f_out >= 30000 && f_out <= 50000)
}

fn test_pitch_shift_klatt_vowel_voiced() {
    let v = synth_phoneme("ae")
    let out = psola_pitch_shift(v, 8000, 1500)
    let out_marks = psola_pitch_marks(out, 8000)
    ce_check("Klatt /ae/ pitch_shift: output has energy (marks present)",
             len(out_marks) > 0)
    ce_eq("Klatt /ae/ pitch_shift: output length preserved",
          len(out), len(v))
}

fn test_silence_in_silence_out() {
    let s = _zero_buf(4800)
    let out = psola_pitch_shift(s, 16000, 2000)
    let i = 0
    let m = 0
    while i < len(out) {
        let v = out[i]
        if v < 0 { v = 0 - v }
        if v > m { m = v }
        i = i + 1
    }
    ce_eq("silence input: output max abs sample = 0", m, 0)
}

fn test_very_short_input_unchanged() {
    let s = synth_sine(200, 100, 16000)
    let out = psola_pitch_shift(s, 16000, 2000)
    ce_eq("very short input: output length == input length",
          len(out), len(s))
    let m = _max_abs_diff(s, out)
    ce_eq("very short input: output == input (bit-exact)", m, 0)
}

fn test_factor_clamped_to_range() {
    let s = synth_sine(200, 4800, 16000)
    let out_lo = psola_pitch_shift(s, 16000, 100)
    let out_hi = psola_pitch_shift(s, 16000, 10000)
    ce_check("clamp low factor: output non-empty",
             len(out_lo) > 0)
    ce_check("clamp high factor: output non-empty",
             len(out_hi) > 0)
}

fn test_pitch_marks_silence_empty_or_midpoint() {
    let s = _zero_buf(4800)
    let marks = psola_pitch_marks(s, 16000)
    ce_check("silence: pitch marks >= 1 (fallback grid defined)",
             len(marks) >= 1)
}

fn test_time_stretch_identity() {
    let s = synth_sine(200, 4800, 16000)
    let out = psola_time_stretch(s, 16000, 1000)
    let in_len = len(s)
    let out_len = len(out)
    let lo = (in_len * 95) / 100
    let hi = (in_len * 105) / 100
    ce_check("time_stretch 1.0x identity: output length ~ input length",
             out_len >= lo && out_len <= hi)
}

fn main() {
    test_psola_constants()
    test_hann_window_endpoints_zero()
    test_hann_window_centre_peak()
    test_hann_window_symmetric()
    test_pitch_marks_on_sine()
    test_pitch_marks_spacing()
    test_identity_transform_preserves_length()
    test_identity_transform_close_to_input()
    test_pitch_shift_up_doubles_f0()
    test_pitch_shift_up_increases_f0()
    test_pitch_shift_down_halves_f0()
    test_pitch_shift_down_decreases_f0()
    test_time_stretch_2x_doubles_duration()
    test_time_stretch_half_halves_duration()
    test_combined_pitch_up_time_slower()
    test_pitch_shift_klatt_vowel_voiced()
    test_silence_in_silence_out()
    test_very_short_input_unchanged()
    test_factor_clamped_to_range()
    test_pitch_marks_silence_empty_or_midpoint()
    test_time_stretch_identity()
    ce_summary("audio_psola")
}

main()
