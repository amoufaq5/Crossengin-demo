// Unit tests for src/substrate/signal_dispatch.nova
// Verifies the 18-type taxonomy and exact priorities, signal construction and
// accessors, inhibition sign convention, attention boosting (with the
// constitutional ceiling), and priority-then-FIFO dispatch ordering.
// ADR-0008, ADR-0002, ADR-0049.

import "../ce_test.nova"
import "../../src/substrate/signal_dispatch.nova"

fn test_taxonomy_priorities() {
    // Exactly 18 types, ids 1..18.
    ce_eq("XSIG_EXCITE id", XSIG_EXCITE, 1)
    ce_eq("XSIG_CONST id", XSIG_CONST, 18)
    ce_eq("type count", XSIG_MAX - XSIG_MIN + 1, 18)
    // Priorities per ADR-0008.
    ce_eq("CONST pri 9", xsig_priority(XSIG_CONST), 9)
    ce_eq("ERROR pri 7", xsig_priority(XSIG_ERROR), 7)
    ce_eq("INHIBIT pri 6", xsig_priority(XSIG_INHIBIT), 6)
    ce_eq("GOAL pri 6", xsig_priority(XSIG_GOAL), 6)
    ce_eq("REWARD pri 6", xsig_priority(XSIG_REWARD), 6)
    ce_eq("ATTEND pri 6", xsig_priority(XSIG_ATTEND), 6)
    ce_eq("SENSORY pri 5", xsig_priority(XSIG_SENSORY), 5)
    ce_eq("PREDICT pri 5", xsig_priority(XSIG_PREDICT), 5)
    ce_eq("EVIDENCE pri 5", xsig_priority(XSIG_EVIDENCE), 5)
    ce_eq("EXCITE pri 4", xsig_priority(XSIG_EXCITE), 4)
    ce_eq("RECALL pri 4", xsig_priority(XSIG_RECALL), 4)
    ce_eq("ANALOGY pri 3", xsig_priority(XSIG_ANALOGY), 3)
    ce_eq("CURIOSITY pri 3", xsig_priority(XSIG_CURIOSITY), 3)
    // Safety ordering invariant.
    ce_check("CONST>ERROR", xsig_priority(XSIG_CONST) > xsig_priority(XSIG_ERROR))
    ce_check("ERROR>INHIBIT", xsig_priority(XSIG_ERROR) > xsig_priority(XSIG_INHIBIT))
    ce_check("INHIBIT>EXCITE", xsig_priority(XSIG_INHIBIT) > xsig_priority(XSIG_EXCITE))
    ce_check("CONST is constitutional", xsig_is_constitutional(XSIG_CONST) == 1)
    ce_check("EXCITE not constitutional", xsig_is_constitutional(XSIG_EXCITE) == 0)
    ce_str_eq("name CONST", xsig_name(XSIG_CONST), "CONST")
}

fn test_signal_build_and_access() {
    let s = sig_new(XSIG_SENSORY, 3, 9, 750, 1, 42)
    ce_eq("type", sig_type(s), XSIG_SENSORY)
    ce_eq("priority seeded", sig_priority(s), 5)
    ce_eq("src", sig_src(s), 3)
    ce_eq("dst", sig_dst(s), 9)
    ce_eq("strength", sig_strength(s), 750)
    ce_eq("trace", sig_trace(s), 1)
    ce_eq("meta", sig_meta(s), 42)

    let e = sig_excite(1, 2, 300)
    ce_eq("excite delta positive", sig_inbox_delta(e), 300)
    let inh = sig_inhibit(1, 2, 300)
    ce_eq("inhibit delta negative", sig_inbox_delta(inh), -300)

    sig_set_dst(e, 5)
    ce_eq("set dst", sig_dst(e), 5)
}

fn test_attention_boost_ceiling() {
    let e = sig_excite(0, 1, 100)        // priority 4
    ce_eq("boost +3 -> 7", sig_boost_priority(e, 3), 7)
    ce_eq("boost again caps at 8", sig_boost_priority(e, 5), 8)
    // Constitutional signals stay pinned at 9 and never move.
    let c = sig_new(XSIG_CONST, 0, 1, 100, 0, 0)
    ce_eq("const stays 9", sig_boost_priority(c, 5), 9)
}

fn test_invalid_type_graceful() {
    let bad = sig_new(99, 0, 1, 100, 0, 0)
    ce_eq("invalid -> type 0", sig_type(bad), 0)
    ce_eq("invalid -> priority 0", sig_priority(bad), 0)
    ce_eq("xsig_valid(99)", xsig_valid(99), 0)
    ce_eq("xsig_valid(0)", xsig_valid(0), 0)
    ce_eq("xsig_valid(EXCITE)", xsig_valid(XSIG_EXCITE), 1)
    ce_str_eq("invalid name", xsig_name(99), "INVALID")
}

fn test_priority_queue_ordering() {
    let q = sigq_new()
    ce_eq("empty size", sigq_size(q), 0)
    ce_eq("pop empty -> 0", sigq_pop(q), 0)

    // Use meta as a tag to track pop order.
    sigq_push(q, sig_new(XSIG_EXCITE, 0, 0, 0, 0, 100))   // pri 4, tag 100
    sigq_push(q, sig_new(XSIG_CONST,  0, 0, 0, 0, 200))   // pri 9, tag 200
    sigq_push(q, sig_new(XSIG_ERROR,  0, 0, 0, 0, 300))   // pri 7, tag 300
    sigq_push(q, sig_new(XSIG_EXCITE, 0, 0, 0, 0, 101))   // pri 4, tag 101 (after 100)
    ce_eq("queue size 4", sigq_size(q), 4)

    // Highest priority first; FIFO within a priority level.
    ce_eq("pop CONST first", sig_meta(sigq_pop(q)), 200)
    ce_eq("pop ERROR second", sig_meta(sigq_pop(q)), 300)
    ce_eq("pop EXCITE#1 third", sig_meta(sigq_pop(q)), 100)
    ce_eq("pop EXCITE#2 fourth", sig_meta(sigq_pop(q)), 101)
    ce_eq("drained", sigq_is_empty(q), 1)
}

fn main() {
    test_taxonomy_priorities()
    test_signal_build_and_access()
    test_attention_boost_ceiling()
    test_invalid_type_graceful()
    test_priority_queue_ordering()
    ce_summary("signal_dispatch")
}

main()
