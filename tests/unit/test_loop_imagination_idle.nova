// Unit tests for src/agent/loop_imagination_idle.nova
// Verifies imagination runs only when idle and rolls active concepts forward.
// ADR-0036.

import "../ce_test.nova"
import "../../src/agent/loop_imagination_idle.nova"

fn handle(kg, id) { let h = list_new(); push(h, kg); push(h, id); return h }
fn one(a) { let l = list_new(); push(l, a); return l }

fn test_imagination() {
    let reg = kg_registry_new()
    let ikg = imagination_kg_init(reg)
    pattern_new(ikg, "p1", one(1), one(2), 0)
    pattern_new(ikg, "p2", one(2), one(3), 0)
    let ctx = ctx_new()
    let active = list_new(); push(active, handle("med", 1))
    ctx_set_active(ctx, active)
    // Not idle -> no imagination.
    ce_eq("inactive skips", loop_imagination_step(ctx, ikg), 0)
    // Idle -> rolls forward (1 -> 2 -> 3), growing the imagined state.
    ctx_set_idle(ctx, 1)
    ce_check("idle imagines forward", loop_imagination_step(ctx, ikg) >= 2)
}

fn main() { test_imagination() ce_summary("loop_imagination_idle") }
main()
