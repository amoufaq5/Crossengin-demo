// Unit tests for src/parts/meta/gaps_register.nova (R103, Phase F part 1).
//
// Ring-buffer append + overflow at cap; per-holder + per-reason filter;
// oldest-first ordering; summary rollup; clear returns count; reason-
// name mapping.

import "../ce_test.nova"
import "../../src/parts/meta/gaps_register.nova"

// ---- constructor + defaults ----------------------------------------------

fn test_register_new_defaults() {
    let r = gaps_register_new(0)
    ce_eq("default cap = GAPS_DEFAULT_CAP",
          gaps_cap(r), GAPS_DEFAULT_CAP)
    ce_eq("empty on construction",   gaps_count(r), 0)
    ce_eq("total starts at 0",       gaps_total(r), 0)
}

fn test_register_new_negative_cap_falls_back_default() {
    let r = gaps_register_new(0 - 5)
    ce_eq("negative cap -> default",
          gaps_cap(r), GAPS_DEFAULT_CAP)
}

fn test_register_new_explicit_small_cap() {
    let r = gaps_register_new(3)
    ce_eq("explicit cap honored", gaps_cap(r), 3)
    ce_eq("empty",                gaps_count(r), 0)
}

// ---- record + count ------------------------------------------------------

fn test_record_appends_and_bumps_count() {
    let r = gaps_register_new(10)
    ce_eq("record ok=1",
          gaps_record(r, "alice", "einstein", GAP_NO_MATCH, "0 atoms", 100), 1)
    ce_eq("count=1",  gaps_count(r), 1)
    ce_eq("total=1",  gaps_total(r), 1)
    gaps_record(r, "alice", "quantum", GAP_LOW_CONFIDENCE, "conf 200/1000", 200)
    ce_eq("count=2",  gaps_count(r), 2)
    ce_eq("total=2",  gaps_total(r), 2)
}

fn test_record_on_zero_reg_is_noop() {
    // reg=0 is the "not wired" sentinel; must never crash and must
    // return 0 so callers know the record didn't land.
    ce_eq("noop on reg=0",
          gaps_record(0, "alice", "topic", GAP_REFUSED, "d", 100), 0)
}

fn test_recorded_event_shape() {
    let r = gaps_register_new(10)
    gaps_record(r, "bob", "photon", GAP_UNPARSED, "grammar failed", 42)
    let e = gaps_entries(r)[0]
    ce_eq("timestamp",  gap_event_timestamp(e), 42)
    ce_str_eq("holder", gap_event_holder(e), "bob")
    ce_str_eq("topic",  gap_event_topic(e), "photon")
    ce_eq("reason",     gap_event_reason(e), GAP_UNPARSED)
    ce_str_eq("detail", gap_event_detail(e), "grammar failed")
}

// ---- ring-buffer trim + oldest-first ordering ----------------------------

fn test_ring_buffer_overflow_trims_oldest() {
    let r = gaps_register_new(3)
    gaps_record(r, "a", "t1", GAP_REFUSED, "d1", 1)
    gaps_record(r, "a", "t2", GAP_REFUSED, "d2", 2)
    gaps_record(r, "a", "t3", GAP_REFUSED, "d3", 3)
    ce_eq("cap reached: count=3", gaps_count(r), 3)
    gaps_record(r, "a", "t4", GAP_REFUSED, "d4", 4)
    ce_eq("still count=3 after overflow", gaps_count(r), 3)
    ce_eq("total tracks lifetime = 4",     gaps_total(r), 4)
    // Oldest (t1) trimmed; oldest-first ordering => index 0 is t2.
    let entries = gaps_entries(r)
    ce_str_eq("index 0 is t2", gap_event_topic(entries[0]), "t2")
    ce_str_eq("index 1 is t3", gap_event_topic(entries[1]), "t3")
    ce_str_eq("index 2 is t4", gap_event_topic(entries[2]), "t4")
    // Another overflow: t2 gone; head is t3.
    gaps_record(r, "a", "t5", GAP_REFUSED, "d5", 5)
    let e2 = gaps_entries(r)
    ce_str_eq("index 0 is now t3", gap_event_topic(e2[0]), "t3")
    ce_str_eq("index 2 is now t5", gap_event_topic(e2[2]), "t5")
    ce_eq("total=5 lifetime",       gaps_total(r), 5)
}

fn test_entries_ordering_is_insertion_order() {
    let r = gaps_register_new(10)
    gaps_record(r, "a", "first",  GAP_REFUSED, "", 1)
    gaps_record(r, "a", "second", GAP_REFUSED, "", 2)
    gaps_record(r, "a", "third",  GAP_REFUSED, "", 3)
    let entries = gaps_entries(r)
    ce_str_eq("0", gap_event_topic(entries[0]), "first")
    ce_str_eq("1", gap_event_topic(entries[1]), "second")
    ce_str_eq("2", gap_event_topic(entries[2]), "third")
}

// ---- filter by holder ----------------------------------------------------

fn test_entries_for_holder_filters_exact_match() {
    let r = gaps_register_new(10)
    gaps_record(r, "alice", "t1", GAP_REFUSED, "", 1)
    gaps_record(r, "bob",   "t2", GAP_REFUSED, "", 2)
    gaps_record(r, "alice", "t3", GAP_REFUSED, "", 3)
    gaps_record(r, "",      "t4", GAP_REFUSED, "", 4)
    let a = gaps_entries_for_holder(r, "alice")
    ce_eq("alice count = 2", len(a), 2)
    ce_str_eq("alice[0]", gap_event_topic(a[0]), "t1")
    ce_str_eq("alice[1]", gap_event_topic(a[1]), "t3")
    let b = gaps_entries_for_holder(r, "bob")
    ce_eq("bob count = 1", len(b), 1)
    let anon = gaps_entries_for_holder(r, "")
    ce_eq("anon count = 1", len(anon), 1)
    ce_str_eq("anon[0]", gap_event_topic(anon[0]), "t4")
    let missing = gaps_entries_for_holder(r, "carol")
    ce_eq("unknown holder = 0", len(missing), 0)
}

fn test_entries_for_holder_returns_fresh_list() {
    // Mutating the returned list must not mutate the register.
    let r = gaps_register_new(10)
    gaps_record(r, "alice", "t1", GAP_REFUSED, "", 1)
    let out = gaps_entries_for_holder(r, "alice")
    push(out, 0)  // append a bogus entry to the RETURNED list
    ce_eq("register untouched", gaps_count(r), 1)
}

fn test_entries_on_zero_reg_returns_empty() {
    let a = gaps_entries_for_holder(0, "alice")
    ce_eq("empty", len(a), 0)
}

// ---- filter by reason ----------------------------------------------------

fn test_entries_by_reason_filters() {
    let r = gaps_register_new(10)
    gaps_record(r, "a", "t1", GAP_NO_MATCH,        "", 1)
    gaps_record(r, "a", "t2", GAP_LOW_CONFIDENCE,  "", 2)
    gaps_record(r, "a", "t3", GAP_REFUSED,         "", 3)
    gaps_record(r, "a", "t4", GAP_UNPARSED,        "", 4)
    gaps_record(r, "a", "t5", GAP_SKILL_REFUSED,   "", 5)
    gaps_record(r, "a", "t6", GAP_NO_MATCH,        "", 6)
    ce_eq("no_match count = 2",
          len(gaps_entries_by_reason(r, GAP_NO_MATCH)), 2)
    ce_eq("low_confidence count = 1",
          len(gaps_entries_by_reason(r, GAP_LOW_CONFIDENCE)), 1)
    ce_eq("refused count = 1",
          len(gaps_entries_by_reason(r, GAP_REFUSED)), 1)
    ce_eq("unparsed count = 1",
          len(gaps_entries_by_reason(r, GAP_UNPARSED)), 1)
    ce_eq("skill_refused count = 1",
          len(gaps_entries_by_reason(r, GAP_SKILL_REFUSED)), 1)
    ce_eq("unknown reason count = 0",
          len(gaps_entries_by_reason(r, 999)), 0)
}

// ---- summary rollup ------------------------------------------------------

fn test_summary_empty_register() {
    let r = gaps_register_new(10)
    let s = gaps_summary(r)
    ce_eq("total = 0",           gaps_summary_total(s), 0)
    ce_eq("by_reason empty",     len(gaps_summary_by_reason(s)), 0)
    ce_eq("by_holder empty",     len(gaps_summary_by_holder(s)), 0)
}

fn test_summary_counts_reasons() {
    let r = gaps_register_new(10)
    gaps_record(r, "a", "t1", GAP_REFUSED, "", 1)
    gaps_record(r, "b", "t2", GAP_REFUSED, "", 2)
    gaps_record(r, "a", "t3", GAP_UNPARSED, "", 3)
    gaps_record(r, "a", "t4", GAP_NO_MATCH, "", 4)
    let s = gaps_summary(r)
    ce_eq("total = 4",           gaps_summary_total(s), 4)
    let br = gaps_summary_by_reason(s)
    ce_eq("3 reason buckets",    len(br), 3)
    // Order = first-occurrence.
    ce_eq("[0] reason=REFUSED",     br[0][0], GAP_REFUSED)
    ce_eq("[0] count=2",            br[0][1], 2)
    ce_eq("[1] reason=UNPARSED",    br[1][0], GAP_UNPARSED)
    ce_eq("[1] count=1",            br[1][1], 1)
    ce_eq("[2] reason=NO_MATCH",    br[2][0], GAP_NO_MATCH)
    ce_eq("[2] count=1",            br[2][1], 1)
    let bh = gaps_summary_by_holder(s)
    ce_eq("2 holder buckets",       len(bh), 2)
    ce_str_eq("[0] holder=a",       bh[0][0], "a")
    ce_eq("[0] count=3",            bh[0][1], 3)
    ce_str_eq("[1] holder=b",       bh[1][0], "b")
    ce_eq("[1] count=1",            bh[1][1], 1)
}

fn test_summary_on_zero_reg() {
    let s = gaps_summary(0)
    ce_eq("total=0",           gaps_summary_total(s), 0)
    ce_eq("by_reason empty",   len(gaps_summary_by_reason(s)), 0)
}

// ---- clear ---------------------------------------------------------------

fn test_clear_returns_count_and_empties() {
    let r = gaps_register_new(10)
    gaps_record(r, "a", "t1", GAP_REFUSED, "", 1)
    gaps_record(r, "a", "t2", GAP_REFUSED, "", 2)
    gaps_record(r, "a", "t3", GAP_REFUSED, "", 3)
    ce_eq("cleared 3", gaps_clear(r), 3)
    ce_eq("count=0 after clear", gaps_count(r), 0)
    // Lifetime total NOT reset (audit aid).
    ce_eq("total still 3",       gaps_total(r), 3)
    // A subsequent record works fine.
    gaps_record(r, "a", "t4", GAP_REFUSED, "", 4)
    ce_eq("count=1 post-record", gaps_count(r), 1)
    ce_eq("total=4",             gaps_total(r), 4)
}

fn test_clear_on_zero_reg_returns_zero() {
    ce_eq("noop", gaps_clear(0), 0)
}

// ---- reason-name mapping -------------------------------------------------

fn test_reason_name_forward() {
    ce_str_eq("1", gaps_reason_name(GAP_NO_MATCH),       "no_match")
    ce_str_eq("2", gaps_reason_name(GAP_LOW_CONFIDENCE), "low_confidence")
    ce_str_eq("3", gaps_reason_name(GAP_REFUSED),        "refused")
    ce_str_eq("4", gaps_reason_name(GAP_UNPARSED),       "unparsed")
    ce_str_eq("5", gaps_reason_name(GAP_SKILL_REFUSED),  "skill_refused")
    ce_str_eq("unknown ->", gaps_reason_name(999),        "unknown")
    ce_str_eq("0 ->",       gaps_reason_name(0),          "unknown")
}

fn test_reason_from_name_reverse() {
    ce_eq("no_match",       gaps_reason_from_name("no_match"),       GAP_NO_MATCH)
    ce_eq("low_confidence", gaps_reason_from_name("low_confidence"), GAP_LOW_CONFIDENCE)
    ce_eq("refused",        gaps_reason_from_name("refused"),        GAP_REFUSED)
    ce_eq("unparsed",       gaps_reason_from_name("unparsed"),       GAP_UNPARSED)
    ce_eq("skill_refused",  gaps_reason_from_name("skill_refused"),  GAP_SKILL_REFUSED)
    ce_eq("unknown -> 0",   gaps_reason_from_name("wat"),            0)
    ce_eq("empty -> 0",     gaps_reason_from_name(""),               0)
}

fn test_reason_name_bijection_stable() {
    // Roundtrip every value.
    let i = 1
    while i < 6 {
        ce_eq("roundtrip " + int_to_str(i),
              gaps_reason_from_name(gaps_reason_name(i)), i)
        i = i + 1
    }
}

// ---- main -----------------------------------------------------------------

fn main() {
    test_register_new_defaults()
    test_register_new_negative_cap_falls_back_default()
    test_register_new_explicit_small_cap()

    test_record_appends_and_bumps_count()
    test_record_on_zero_reg_is_noop()
    test_recorded_event_shape()

    test_ring_buffer_overflow_trims_oldest()
    test_entries_ordering_is_insertion_order()

    test_entries_for_holder_filters_exact_match()
    test_entries_for_holder_returns_fresh_list()
    test_entries_on_zero_reg_returns_empty()

    test_entries_by_reason_filters()

    test_summary_empty_register()
    test_summary_counts_reasons()
    test_summary_on_zero_reg()

    test_clear_returns_count_and_empties()
    test_clear_on_zero_reg_returns_zero()

    test_reason_name_forward()
    test_reason_from_name_reverse()
    test_reason_name_bijection_stable()

    ce_summary("gaps_register")
    return 0
}

main()
