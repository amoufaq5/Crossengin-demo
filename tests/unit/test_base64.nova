// Unit tests for src/net/tls/base64.nova (R94).
//
// Vectors from RFC 4648 §10 plus a handful of shape-rejection cases.
// The decoder is used by the daemon's TLS bootstrap to unwrap DER-
// encoded cert / private-key / root material from three env vars, so
// the surface tested here is exactly what a mis-configured deployment
// might hand to `daemon_load_tls_config_from_sidecar`.

import "../ce_test.nova"
import "../../src/net/tls/base64.nova"

fn _b64_bytes_eq_str(bytes, s) {
    let n = len(s)
    if len(bytes) != n { return 0 }
    let i = 0
    while i < n {
        if bytes[i] != char_at(s, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn test_rfc4648_vectors() {
    // empty
    let r = base64_decode("")
    ce_eq("empty ok",   r[0], 1)
    ce_eq("empty len",  len(r[1]), 0)
    // "f" -> "Zg=="
    let rf = base64_decode("Zg==")
    ce_eq("f ok",       rf[0], 1)
    ce_eq("f bytes",    _b64_bytes_eq_str(rf[1], "f"), 1)
    // "fo" -> "Zm8="
    let rfo = base64_decode("Zm8=")
    ce_eq("fo ok",      rfo[0], 1)
    ce_eq("fo bytes",   _b64_bytes_eq_str(rfo[1], "fo"), 1)
    // "foo" -> "Zm9v"
    let rfoo = base64_decode("Zm9v")
    ce_eq("foo ok",     rfoo[0], 1)
    ce_eq("foo bytes",  _b64_bytes_eq_str(rfoo[1], "foo"), 1)
    // "foob" -> "Zm9vYg=="
    let rfoob = base64_decode("Zm9vYg==")
    ce_eq("foob ok",    rfoob[0], 1)
    ce_eq("foob bytes", _b64_bytes_eq_str(rfoob[1], "foob"), 1)
    // "fooba" -> "Zm9vYmE="
    let rfooba = base64_decode("Zm9vYmE=")
    ce_eq("fooba ok",     rfooba[0], 1)
    ce_eq("fooba bytes",  _b64_bytes_eq_str(rfooba[1], "fooba"), 1)
    // "foobar" -> "Zm9vYmFy"
    let rfoobar = base64_decode("Zm9vYmFy")
    ce_eq("foobar ok",    rfoobar[0], 1)
    ce_eq("foobar bytes", _b64_bytes_eq_str(rfoobar[1], "foobar"), 1)
}

fn test_trailing_newline_tolerated() {
    // Shells often append \n when piping through `base64 -w0` and
    // heredocs; a single trailing \n is tolerated.
    let r = base64_decode("Zm9vYmFy\n")
    ce_eq("trailing \\n ok",    r[0], 1)
    ce_eq("trailing \\n bytes", _b64_bytes_eq_str(r[1], "foobar"), 1)
    // A trailing space is likewise tolerated.
    let r2 = base64_decode("Zm9vYmFy ")
    ce_eq("trailing space ok",  r2[0], 1)
}

fn test_length_not_multiple_of_4_refused() {
    let r = base64_decode("Zg=")     // 3 chars
    ce_eq("short len refuse",   r[0], 0)
    let r2 = base64_decode("Zm")     // 2 chars
    ce_eq("shorter len refuse", r2[0], 0)
    let r3 = base64_decode("Zm9vYg") // missing padding
    ce_eq("no-pad refuse",      r3[0], 0)
}

fn test_bad_chars_refused() {
    // '.' is not in the standard alphabet.
    let r = base64_decode("Zg.=")
    ce_eq("dot refused",        r[0], 0)
    // '-' is url-safe alphabet, refused here.
    let r2 = base64_decode("Zg-=")
    ce_eq("dash refused",       r2[0], 0)
    // '_' is url-safe alphabet, refused here.
    let r3 = base64_decode("Zg_=")
    ce_eq("underscore refused", r3[0], 0)
}

fn test_padding_only_in_last_quad() {
    // pad in a non-terminal quad -> refuse.
    let r = base64_decode("Zg==Zg==")
    ce_eq("mid-pad refused",    r[0], 0)
}

fn test_pad_position_valid() {
    // "==" in last quad is legal, "= " in position 3 alone is not.
    let r = base64_decode("Zg=g")     // '=' in position 3 with non-'=' in position 4
    ce_eq("stray = refused",    r[0], 0)
}

fn test_binary_roundtrip_with_zeros() {
    // "AAAA" -> three 0x00 bytes; ensures NULs in output don't
    // truncate the byte-list.
    let r = base64_decode("AAAA")
    ce_eq("zeros ok",           r[0], 1)
    ce_eq("zeros len",          len(r[1]), 3)
    ce_eq("zero byte 0",        r[1][0], 0)
    ce_eq("zero byte 1",        r[1][1], 0)
    ce_eq("zero byte 2",        r[1][2], 0)
}

fn test_high_bytes() {
    // "////" -> 0xff 0xff 0xff.
    let r = base64_decode("////")
    ce_eq("all-ones ok",        r[0], 1)
    ce_eq("all-ones len",       len(r[1]), 3)
    ce_eq("byte0 = 0xff",       r[1][0], 255)
    ce_eq("byte1 = 0xff",       r[1][1], 255)
    ce_eq("byte2 = 0xff",       r[1][2], 255)
}

fn main() {
    test_rfc4648_vectors()
    test_trailing_newline_tolerated()
    test_length_not_multiple_of_4_refused()
    test_bad_chars_refused()
    test_padding_only_in_last_quad()
    test_pad_position_valid()
    test_binary_roundtrip_with_zeros()
    test_high_bytes()
    ce_summary("base64")
}

main()
