// Unit tests for src/nl/llm_parser.nova (R48p6, ADR-0104).
//
// Covers wire-format parsing for all 12 kinds, refusal modes (malformed
// wire, missing KIND, arity mismatch, empty args), comment / blank-line
// handling, the audit source-tag helper, and downstream sq_validate
// integration (parser_used="llm" propagates through).

import "../ce_test.nova"
import "../../src/nl/llm_parser.nova"
import "../../src/nl/query_shape.nova"
import "../../src/util/str_safe.nova"

// ---- happy path -- one kind per test -------------------------------------

fn test_parse_research() {
    let wire = "KIND research\nARG photosynthesis\n"
    let q = llm_parse_wire(wire, "what is photosynthesis")
    ce_eq("kind RESEARCH",       sq_kind(q), NLK_RESEARCH)
    ce_eq("topic",               str_eq_bytes(sq_research_topic(q), "photosynthesis"), 1)
    ce_eq("parser=llm",          str_eq_bytes(sq_parser_used(q), "llm"), 1)
    ce_eq("raw preserved",       str_eq_bytes(sq_raw_text(q), "what is photosynthesis"), 1)
    ce_eq("validates",           sq_validate(q), SQ_OK)
}

fn test_parse_research_filtered() {
    let wire = "KIND research_filtered\nARG einstein\nARG person\n"
    let q = llm_parse_wire(wire, "who is einstein")
    ce_eq("kind RESEARCH",       sq_kind(q), NLK_RESEARCH)
    ce_eq("topic",               str_eq_bytes(sq_research_topic(q), "einstein"), 1)
    ce_eq("filter person",       str_eq_bytes(sq_research_kind_filter(q), "person"), 1)
}

fn test_parse_relate() {
    let wire = "KIND relate\nARG mitochondria\nARG cell\n"
    let q = llm_parse_wire(wire, "does mitochondria relate to cell")
    ce_eq("kind RELATE",         sq_kind(q), NLK_RELATE)
    ce_eq("a",                   str_eq_bytes(sq_relate_a(q), "mitochondria"), 1)
    ce_eq("b",                   str_eq_bytes(sq_relate_b(q), "cell"), 1)
}

fn test_parse_contradict() {
    let wire = "KIND contradict_scan\nARG astronomy\nARG folk astronomy\n"
    let q = llm_parse_wire(wire, "does astronomy contradict folk astronomy")
    ce_eq("kind CONTRADICT",     sq_kind(q), NLK_CONTRADICT_SCAN)
    ce_eq("a",                   str_eq_bytes(sq_contradict_a(q), "astronomy"), 1)
    ce_eq("b multi-word",        str_eq_bytes(sq_contradict_b(q), "folk astronomy"), 1)
}

fn test_parse_is_a() {
    let wire = "KIND is_a\nARG earth\nARG planet\n"
    let q = llm_parse_wire(wire, "is earth a planet")
    ce_eq("kind IS_A",           sq_kind(q), NLK_IS_A)
    ce_eq("x",                   str_eq_bytes(sq_is_a_x(q), "earth"), 1)
    ce_eq("y",                   str_eq_bytes(sq_is_a_y(q), "planet"), 1)
}

fn test_parse_retract() {
    let wire = "KIND retract\nARG old_claim\n"
    let q = llm_parse_wire(wire, "retract old_claim")
    ce_eq("kind RETRACT",        sq_kind(q), NLK_RETRACT)
    ce_eq("label",               str_eq_bytes(sq_retract_label(q), "old_claim"), 1)
}

fn test_parse_capsule_install() {
    let wire = "KIND capsule_install\nARG medicine\n"
    let q = llm_parse_wire(wire, "please install the medicine capsule")
    ce_eq("kind CAP_INSTALL",    sq_kind(q), NLK_CAPSULE_INSTALL)
    ce_eq("name",                str_eq_bytes(sq_capsule_install_name(q), "medicine"), 1)
}

fn test_parse_skill_install() {
    let wire = "KIND skill_install\nARG coding_helper\n"
    let q = llm_parse_wire(wire, "install skill coding_helper")
    ce_eq("kind SK_INSTALL",     sq_kind(q), NLK_SKILL_INSTALL)
    ce_eq("name",                str_eq_bytes(sq_skill_install_name(q), "coding_helper"), 1)
}

fn test_parse_capsule_list() {
    let wire = "KIND capsule_list\n"
    let q = llm_parse_wire(wire, "list capsules")
    ce_eq("kind CAP_LIST",       sq_kind(q), NLK_CAPSULE_LIST)
    ce_eq("no args",             sq_arg_count(q), 0)
}

fn test_parse_skill_list() {
    let wire = "KIND skill_list\n"
    let q = llm_parse_wire(wire, "what skills do you have")
    ce_eq("kind SK_LIST",        sq_kind(q), NLK_SKILL_LIST)
    ce_eq("no args",             sq_arg_count(q), 0)
}

fn test_parse_skill_run() {
    let wire = "KIND skill_run\nARG research\nARG the sun\n"
    let q = llm_parse_wire(wire, "run research on the sun")
    ce_eq("kind SKILL_RUN",      sq_kind(q), NLK_SKILL_RUN)
    ce_eq("skill",               str_eq_bytes(sq_skill_run_skill(q), "research"), 1)
    ce_eq("arg multi-word",      str_eq_bytes(sq_skill_run_arg(q), "the sun"), 1)
}

fn test_parse_unparsed_explicit() {
    let wire = "KIND unparsed\n"
    let q = llm_parse_wire(wire, "gibberish")
    ce_eq("kind UNPARSED",       sq_kind(q), NLK_UNPARSED)
    ce_eq("parser=llm",          str_eq_bytes(sq_parser_used(q), "llm"), 1)
}

// ---- comment + blank-line tolerance --------------------------------------

fn test_audit_header_skipped() {
    let wire = "# nl_parse_llm.sh: model=llama3.1 run=r-001 backend=ollama\n"
             + "# input: what is mars\n"
             + "\n"
             + "KIND research\n"
             + "ARG mars\n"
    let q = llm_parse_wire(wire, "what is mars")
    ce_eq("kind RESEARCH",       sq_kind(q), NLK_RESEARCH)
    ce_eq("topic",               str_eq_bytes(sq_research_topic(q), "mars"), 1)
}

fn test_blank_lines_between_directives() {
    let wire = "KIND relate\n\n\nARG a\n\nARG b\n\n"
    let q = llm_parse_wire(wire, "does a relate to b")
    ce_eq("kind RELATE",         sq_kind(q), NLK_RELATE)
    ce_eq("a",                   str_eq_bytes(sq_relate_a(q), "a"), 1)
    ce_eq("b",                   str_eq_bytes(sq_relate_b(q), "b"), 1)
}

fn test_leading_ws_in_directives() {
    // A model that adds indentation should still parse (we trim per line).
    let wire = "  KIND research\n\tARG mars\n"
    let q = llm_parse_wire(wire, "what is mars")
    ce_eq("kind after ws trim",  sq_kind(q), NLK_RESEARCH)
    ce_eq("topic",               str_eq_bytes(sq_research_topic(q), "mars"), 1)
}

fn test_second_kind_ignored() {
    // Only the first KIND record is honored -- concatenated wires or a
    // hallucinated second block does not corrupt the first parse.
    let wire = "KIND research\nARG mars\nKIND relate\nARG a\nARG b\n"
    let q = llm_parse_wire(wire, "concat")
    ce_eq("first kind wins",     sq_kind(q), NLK_RESEARCH)
    ce_eq("first topic",         str_eq_bytes(sq_research_topic(q), "mars"), 1)
}

// ---- refusal modes -------------------------------------------------------

fn test_empty_wire_refused() {
    let out = llm_parse_wire_verbose("", "raw")
    ce_eq("ok=0",                llmp_ok(out), 0)
    ce_eq("query is UNPARSED",   sq_kind(llmp_query(out)), NLK_UNPARSED)
    ce_check("has diagnostic",   len(llmp_error(out)) > 0)
}

fn test_no_kind_refused() {
    let out = llm_parse_wire_verbose("ARG mars\nARG phobos\n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
    ce_eq("query UNPARSED",      sq_kind(llmp_query(out)), NLK_UNPARSED)
    ce_check("names ARG-before-KIND",
             find_bytes(llmp_error(out), "ARG before KIND") >= 0)
}

fn test_only_comments_refused() {
    let out = llm_parse_wire_verbose("# comment only\n# another\n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
    ce_check("names missing KIND",
             find_bytes(llmp_error(out), "no KIND line found") >= 0)
}

fn test_unknown_kind_refused() {
    let out = llm_parse_wire_verbose("KIND bogus_kind\n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
    ce_check("names bad kind",
             find_bytes(llmp_error(out), "bogus_kind") >= 0)
}

fn test_arity_too_few_refused() {
    let out = llm_parse_wire_verbose("KIND relate\nARG a\n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
    ce_check("names arity mismatch",
             find_bytes(llmp_error(out), "expects 2 arg") >= 0)
}

fn test_arity_too_many_refused() {
    let out = llm_parse_wire_verbose("KIND research\nARG a\nARG b\n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
    ce_check("names arity mismatch",
             find_bytes(llmp_error(out), "got 2") >= 0)
}

fn test_empty_arg_rejected_by_sq_validate() {
    // ARG with only whitespace after trim => empty arg => sq_validate
    // yields SQ_ERR_EMPTY_ARG => llm parser demotes to UNPARSED.
    let out = llm_parse_wire_verbose("KIND research\nARG    \n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
    // Actually our _llmp_directive_value returns "" for whitespace-only,
    // so this hits the "arity too few" path -- 0 args when 1 expected.
    ce_check("has diagnostic",   len(llmp_error(out)) > 0)
}

// ---- unknown-directive tolerance -----------------------------------------

fn test_unknown_directive_ignored() {
    // A model that adds an extra directive (say "META foo=bar") must
    // not crash the parse. Unknown lines are silently dropped.
    let wire = "KIND research\nMETA source=web\nARG mars\nCONFIDENCE 900\n"
    let q = llm_parse_wire(wire, "what is mars")
    ce_eq("still RESEARCH",      sq_kind(q), NLK_RESEARCH)
    ce_eq("topic",               str_eq_bytes(sq_research_topic(q), "mars"), 1)
}

// ---- case sensitivity ----------------------------------------------------

fn test_lowercase_directive_ignored() {
    // Wire directives are UPPERCASE by contract. A model emitting
    // "kind" or "arg" is treated as noise -> no KIND found -> refuse.
    let out = llm_parse_wire_verbose("kind research\narg mars\n", "?")
    ce_eq("ok=0",                llmp_ok(out), 0)
}

// ---- source tag helper (audit) -------------------------------------------

fn test_source_tag_shape() {
    let t = llm_parser_source_tag("llama3.1:8b", "r-2026-08-15-01")
    ce_check("prefix",   find_bytes(t, "src:parser:llm:") == 0)
    ce_check("model",    find_bytes(t, "llama3.1:8b") >= 0)
    ce_check("run",      find_bytes(t, "r-2026-08-15-01") >= 0)
}

// ---- verbose accessor coverage -------------------------------------------

fn test_verbose_success_ok_flag_and_empty_error() {
    let out = llm_parse_wire_verbose("KIND research\nARG mars\n", "raw")
    ce_eq("ok=1",                llmp_ok(out), 1)
    ce_eq("error empty",         len(llmp_error(out)), 0)
    ce_eq("query is RESEARCH",   sq_kind(llmp_query(out)), NLK_RESEARCH)
}

// ---- main ----------------------------------------------------------------

fn main() {
    test_parse_research()
    test_parse_research_filtered()
    test_parse_relate()
    test_parse_contradict()
    test_parse_is_a()
    test_parse_retract()
    test_parse_capsule_install()
    test_parse_skill_install()
    test_parse_capsule_list()
    test_parse_skill_list()
    test_parse_skill_run()
    test_parse_unparsed_explicit()
    test_audit_header_skipped()
    test_blank_lines_between_directives()
    test_leading_ws_in_directives()
    test_second_kind_ignored()
    test_empty_wire_refused()
    test_no_kind_refused()
    test_only_comments_refused()
    test_unknown_kind_refused()
    test_arity_too_few_refused()
    test_arity_too_many_refused()
    test_empty_arg_rejected_by_sq_validate()
    test_unknown_directive_ignored()
    test_lowercase_directive_ignored()
    test_source_tag_shape()
    test_verbose_success_ok_flag_and_empty_error()
    ce_summary("nl_llm_parser")
}

main()
