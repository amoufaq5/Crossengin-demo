// Unit tests for src/skills/skill_manifest.nova (ADR-0103).

import "../ce_test.nova"
import "../../src/skills/skill_manifest.nova"

fn test_new_shape_defaults() {
    let m = skill_manifest_new("echo", "1.0.0", "trivial reference skill", 1)
    ce_eq("name", skill_manifest_name(m), "echo")
    ce_eq("version", skill_manifest_version(m), "1.0.0")
    ce_eq("description", skill_manifest_description(m),
          "trivial reference skill")
    ce_eq("policy_id", skill_manifest_policy_id(m), 1)
    ce_eq("default tier USER",
          skill_manifest_capability_tier(m), SKILL_TIER_USER)
    ce_eq("no deps", skill_manifest_dep_count(m), 0)
    ce_eq("no effectors", skill_manifest_effector_count(m), 0)
    ce_eq("no refusals", skill_manifest_refusal_count(m), 0)
    ce_eq("attribution auto",
          skill_manifest_attribution(m), "src:skill:echo:v1.0.0")
    ce_eq("license default", skill_manifest_license(m), "unspecified")
}

fn test_add_capsule_dep() {
    let m = skill_manifest_new("coding_helper", "1.0.0", "d", 42)
    ce_eq("new dep", skill_manifest_add_capsule_dep(m, "coding", "1.0.0"), 1)
    ce_eq("second dep",
          skill_manifest_add_capsule_dep(m, "debug_pattern", "1.0.0"), 1)
    ce_eq("2 deps", skill_manifest_dep_count(m), 2)
    // Re-adding same capsule updates version-min (returns 0 = updated).
    ce_eq("update dep", skill_manifest_add_capsule_dep(m, "coding", "1.1.0"), 0)
    ce_eq("still 2 deps", skill_manifest_dep_count(m), 2)
    let deps = skill_manifest_required_capsules(m)
    ce_eq("dep 0 name", deps[0][0], "coding")
    ce_eq("dep 0 updated version", deps[0][1], "1.1.0")
    ce_eq("dep 1 name", deps[1][0], "debug_pattern")
}

fn test_set_tier_clamps() {
    let m = skill_manifest_new("s", "1.0.0", "d", 1)
    skill_manifest_set_tier(m, SKILL_TIER_ELEVATED)
    ce_eq("elevated", skill_manifest_capability_tier(m), SKILL_TIER_ELEVATED)
    skill_manifest_set_tier(m, 99)
    ce_eq("clamped to ROOT", skill_manifest_capability_tier(m), SKILL_TIER_ROOT)
    skill_manifest_set_tier(m, 0 - 5)
    ce_eq("clamped to USER", skill_manifest_capability_tier(m), SKILL_TIER_USER)
}

fn test_add_effector_idempotent() {
    let m = skill_manifest_new("s", "1.0.0", "d", 1)
    ce_eq("add code_exec", skill_manifest_add_effector(m, "effector_code_exec"), 1)
    ce_eq("dup code_exec", skill_manifest_add_effector(m, "effector_code_exec"), 0)
    ce_eq("add file_ops", skill_manifest_add_effector(m, "effector_file_ops"), 1)
    ce_eq("2 effectors", skill_manifest_effector_count(m), 2)
}

fn test_add_refusal_condition() {
    let m = skill_manifest_new("s", "1.0.0", "d", 1)
    skill_manifest_add_refusal(m, COND_MIN_CONFIDENCE, 700)
    skill_manifest_add_refusal(m, COND_KG_EMPTY, "medicine")
    skill_manifest_add_refusal(m, COND_CAPSULE_UNINSTALLED, "biology")
    skill_manifest_add_refusal(m, COND_PERSONA_MISSING, 0)
    ce_eq("4 refusal conds", skill_manifest_refusal_count(m), 4)
    let conds = skill_manifest_refusal_conds(m)
    ce_eq("cond 0 kind", conds[0][0], COND_MIN_CONFIDENCE)
    ce_eq("cond 0 arg", conds[0][1], 700)
    ce_eq("cond 1 arg", conds[1][1], "medicine")
    ce_eq("cond 2 arg", conds[2][1], "biology")
}

fn test_set_license() {
    let m = skill_manifest_new("s", "1.0.0", "d", 1)
    skill_manifest_set_license(m, "CC-BY-4.0")
    ce_eq("license set", skill_manifest_license(m), "CC-BY-4.0")
}

fn test_cond_kind_names() {
    ce_eq("min-conf",    skill_cond_kind_name(COND_MIN_CONFIDENCE), "min-confidence")
    ce_eq("kg-empty",    skill_cond_kind_name(COND_KG_EMPTY), "kg-empty")
    ce_eq("cap-uninst",  skill_cond_kind_name(COND_CAPSULE_UNINSTALLED), "capsule-uninstalled")
    ce_eq("per-missing", skill_cond_kind_name(COND_PERSONA_MISSING), "persona-missing")
    ce_eq("unknown",     skill_cond_kind_name(999), "unknown")
}

fn main() {
    test_new_shape_defaults()
    test_add_capsule_dep()
    test_set_tier_clamps()
    test_add_effector_idempotent()
    test_add_refusal_condition()
    test_set_license()
    test_cond_kind_names()
    ce_summary("skill_manifest")
}

main()
