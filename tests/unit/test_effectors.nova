// Unit tests for the P4 effector backends (ADR-0054):
//   code_exec (safe arithmetic), file_ops (sandboxed read/write), http_action
//   (simulated outbound call), mcp (service connector). Each returns the shared
//   tool-result shape.
//
// ADR-0054.

import "../ce_test.nova"
import "../../src/io/effectors/effector_code_exec.nova"
import "../../src/io/effectors/effector_file_ops.nova"
import "../../src/io/effectors/effector_http_action.nova"
import "../../src/io/effectors/effector_mcp.nova"

fn test_code_exec() {
    let r = code_exec_run("6 * 7")
    ce_eq("compute ok", tr_ok(r), 1)
    ce_str_eq("compute renders 42", tr_text(r), "42")
    ce_eq("bad expression fails", tr_ok(code_exec_run("not an expression")), 0)
}

fn test_file_ops_sandbox() {
    ce_eq("write outside sandbox refused", tr_ok(file_ops_write("/etc/passwd", "x")), 0)
    ce_eq("read outside sandbox refused", tr_ok(file_ops_read("/etc/passwd")), 0)
    let path = "/tmp/ce_tool_test_eff.txt"
    ce_eq("sandbox write ok", tr_ok(file_ops_write(path, "hello-effector")), 1)
    let rd = file_ops_read(path)
    ce_eq("sandbox read ok", tr_ok(rd), 1)
    ce_str_eq("write/read roundtrip", tr_text(rd), "hello-effector")
}

fn test_http_action() {
    let r = http_action_run("http://x/y", 1, "canned-body")
    ce_eq("simulated call ok", tr_ok(r), 1)
    ce_str_eq("returns the canned body", tr_text(r), "canned-body")
    ce_eq("empty url fails", tr_ok(http_action_run("", 1, "x")), 0)
    ce_eq("live mode not wired", tr_ok(http_action_run("http://x", 0, "x")), 0)
}

fn test_mcp() {
    let reg = mcp_registry_new()
    mcp_register(reg, "weather", "sunny")
    let r = mcp_call(reg, "weather", "get", "today")
    ce_eq("registered service ok", tr_ok(r), 1)
    ce_str_eq("service response", tr_text(r), "sunny")
    ce_eq("unknown service fails", tr_ok(mcp_call(reg, "stocks", "get", "")), 0)
    ce_str_eq("direct call returns canned", tr_text(mcp_call_direct("svc", "req", "direct-resp")), "direct-resp")
}

fn main() {
    test_code_exec()
    test_file_ops_sandbox()
    test_http_action()
    test_mcp()
    ce_summary("effectors")
}

main()
