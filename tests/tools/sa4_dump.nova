// Prints the byte-exact transcript of deterministic SecAgg v4 harness rounds
// (tests/sa4_harness.nova), for comparison with scripts/sa4_ref.py (A2.3b).
// SA4DUMP=A..E selects a soul-only scenario (A-D rounds, E refusal cases);
// SA4DUMP=F|G|H|I|J|P a v4-sa3 round with the NOVA coordinator (SPEC A2.4c
// section 15): header, every soul line in delivery order, BLAME and
// EVIDENCE lines, the sum hash. See scenario_sa4_pyref.sh.
import "../sa4_harness.nova"

// SHA-256 hex of a word list as concatenated u32be words.
fn _sum_hex(words) {
    let b = list_new()
    let i = 0
    while i < len(words) {
        let w = words[i]
        push(b, int_and(w / 16777216, 255))
        push(b, int_and(w / 65536, 255))
        push(b, int_and(w / 256, 255))
        push(b, int_and(w, 255))
        i = i + 1
    }
    return sa4w_hex(sa4w_sha256(b))
}

fn _dump_round(tag, vc) {
    let res = sa4e_named_round(tag, vc)
    let c = res[3]
    let log = res[4]
    let ro = res[5]
    let sum_ok = 0
    if res[0] == 1 {
        let u3 = sa4c_set(c, 3)
        sum_ok = sa4h_same(res[2], sa4h_expected(sa4h_xs_of_ids(ro, u3)))
    }
    println("#" + tag + " ok=" + int_to_str(res[0]) + " sum_ok=" + int_to_str(sum_ok) + " state=" + int_to_str(sa4c_state(c)) + " u2=" + sa4e_ids_str(sa4c_set(c, 2)) + " counters=" + sa4e_ids_str(sa4c_counters(c)) + " err=" + res[1])
    let i = 0
    while i < len(log) {
        let ln = log[i][1]
        if sa4h_starts(ln, "SA4_ADV ") == 1 {
            println("ADV " + ln)
        } else {
            println("OUT " + ln)
        }
        i = i + 1
    }
    let ents = sroster_entries(ro)
    i = 0
    while i < len(ents) {
        let id = ents[i][0]
        let code = sa4c_blamed(c, id)
        if code != 0 { println("BLAME " + int_to_str(id) + " " + int_to_str(code) + " " + sa4c_why(c, id)) }
        i = i + 1
    }
    i = 0
    while i < len(ents) {
        let id = ents[i][0]
        let ev = sa4c_evidence(c, id)
        if len(ev) > 0 {
            println("EVIDENCE " + int_to_str(id) + " " + int_to_str(len(ev)) + " " + sa4w_hex(sa4w_sha256(sa4e_bytes(ev))))
            // SA4EVDIR=<dir>: also write the evidence text and the roster
            // (for sa4_ref.py --judge in scenario_sa4_pyref.sh).
            let evd = getenv("SA4EVDIR")
            if evd != 0 {
                if len(evd) > 0 {
                    write_file(evd + "/evidence_" + tag + "_" + int_to_str(id) + ".txt", ev)
                    write_file(evd + "/roster.txt", sroster_canonical(ro))
                }
            }
        }
        i = i + 1
    }
    if res[0] == 1 { println("#SUM " + _sum_hex(res[2])) }
    return 0
}

fn _dump(tag, res) {
    println("#" + tag + " ok=" + int_to_str(res[0]) + " sum_ok=" + int_to_str(res[2]) + " err=" + res[1])
    let i = 0
    while i < len(res[4]) {
        println("ADV " + res[4][i])
        i = i + 1
    }
    i = 0
    while i < len(res[5]) {
        println("OUT " + res[5][i])
        i = i + 1
    }
    return 0
}

fn main() {
    let vc = list_new()
    let which = getenv("SA4DUMP")
    if str_eq_bytes(which, "A") == 1 {
        let ra = sa4h_roster(3)
        println("#FP " + sroster_fingerprint(ra))
        let sa = sa4h_souls(ra, 3, 5, vc, 4)
        _dump("A", sa4h_run3(ra, sa, 5, 0 - 1, 0 - 1, 0 - 1))
    }
    if str_eq_bytes(which, "B") == 1 {
        let rb = sa4h_roster(5)
        let sb = sa4h_souls(rb, 5, 9, vc, 0)
        _dump("B", sa4h_run3(rb, sb, 9, 0 - 1, 2, 0 - 1))
    }
    if str_eq_bytes(which, "C") == 1 {
        let rc = sa4h_roster(4)
        let sc = sa4h_souls(rc, 4, 11, vc, 0)
        _dump("C", sa4h_run3(rc, sc, 11, 0, 0 - 1, 0 - 1))
    }
    if str_eq_bytes(which, "D") == 1 {
        let rd = sa4h_roster(5)
        let sd = sa4h_souls(rd, 5, 13, vc, 0)
        _dump("D", sa4h_run3(rd, sd, 13, 0 - 1, 0 - 1, 1))
    }
    if str_eq_bytes(which, "E") == 1 {
        let re = sa4h_roster(3)
        let rl = sa4h_round_line(re, 5)
        let base = sa4h_souls(re, 3, 5, vc, 4)
        let advs = list_new()
        let i = 0
        while i < 3 {
            advs = sa4h_cat(advs, sa4h_feed(base[i], sa4h_one(rl))[1])
            i = i + 1
        }
        let cases = list_new()
        let fpx = sa4w_unhex(sroster_fingerprint(re), 32)
        list_set(fpx, 0, int_xor(fpx[0], 1))
        push(cases, sa4h_one(sa4w_fmt_round(5, fpx, SA4H_L, sa4h_layout())))
        push(cases, sa4h_one(sa4h_round_line(re, 4)))
        push(cases, sa4h_one(sa4w_fmt_round(5, sa4w_unhex(sroster_fingerprint(re), 32), SA4H_L + 1, sa4h_layout())))
        push(cases, sa4h_one(sa4w_fmt_round(5, sa4w_unhex(sroster_fingerprint(re), 32), SA4H_L, fpx)))
        push(cases, sa4h_one("SA4_ROUND 05 x"))
        push(cases, [rl, sa4w_fmt_set(5, 2, sa4w_bitmap([1, 2, 3]))])
        push(cases, [rl, sa4w_fmt_set(6, 1, sa4w_bitmap([1, 2, 3]))])
        let a1 = sa4w_parse(advs[1])
        let g = a1[5]
        list_set(g, 5, int_xor(g[5], 1))
        push(cases, [rl, advs[0], sa4w_fmt_adv(5, a1[2], a1[3], a1[4], g, a1[6], a1[7]), advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        push(cases, [rl, advs[0], advs[1], advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3, 4]))])
        push(cases, [rl, advs[0], advs[1], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        push(cases, [rl, advs[0], advs[1], advs[2], advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        // v4-sa2: own ADV relayed back with B (then M) altered, a peer ADV
        // with M altered under its original signature, and a v1 (6-token) ADV.
        let a0b = sa4w_parse(advs[0])
        let bcm = a0b[6]
        list_set(bcm, 0, int_xor(bcm[0], 1))
        push(cases, [rl, sa4w_fmt_adv(5, a0b[2], a0b[3], a0b[4], a0b[5], bcm, a0b[7]), advs[1], advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        let a0m = sa4w_parse(advs[0])
        let mr0 = a0m[7]
        list_set(mr0, 31, int_xor(mr0[31], 128))
        push(cases, [rl, sa4w_fmt_adv(5, a0m[2], a0m[3], a0m[4], a0m[5], a0m[6], mr0), advs[1], advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        let a1m = sa4w_parse(advs[1])
        let mr1 = a1m[7]
        list_set(mr1, 0, int_xor(mr1[0], 1))
        push(cases, [rl, advs[0], sa4w_fmt_adv(5, a1m[2], a1m[3], a1m[4], a1m[5], a1m[6], mr1), advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        let a1v = sa4w_parse(advs[1])
        push(cases, [rl, advs[0], "SA4_ADV 5 " + int_to_str(a1v[2]) + " " + sa4w_hex(a1v[3]) + " " + sa4w_hex(a1v[4]) + " " + sa4w_hex(a1v[5]), advs[2], sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))])
        // v4-sa3 (cases 15..20): SET 2 in SHARED, a 5-token (v4-sa2)
        // SHARE, ACCUSE naming the receiver, two complaints from one soul,
        // a final U2 containing a complained-about soul, ACCUSE twice.
        let set1 = sa4w_fmt_set(5, 1, sa4w_bitmap([1, 2, 3]))
        let set5 = sa4w_fmt_set(5, 5, sa4w_bitmap([1, 2, 3]))
        let set2 = sa4w_fmt_set(5, 2, sa4w_bitmap([1, 2, 3]))
        let pre1 = sa4h_cat(sa4h_cat(sa4h_one(rl), advs), sa4h_one(set1))
        let sh2 = sa4e_shares_to(sa4h_feed(sa4h_souls(re, 2, 5, vc, 4)[1], pre1)[1], 7)[0]
        let sh3 = sa4e_shares_to(sa4h_feed(sa4h_souls(re, 3, 5, vc, 4)[2], pre1)[1], 7)[0]
        let p2 = sa4w_parse(sh2)
        let cz = list_new()
        let q = 0
        while q < 64 {
            push(cz, 0)
            q = q + 1
        }
        let c11 = list_new()
        q = 0
        while q < 32 {
            push(c11, 11)
            q = q + 1
        }
        let cpl = sa4w_fmt_complaint(5, 300, 7, c11, cz)
        let pre = sa4h_cat(pre1, [sh2, sh3, set5])
        push(cases, sa4h_cat(pre1, [sh2, sh3, set2]))
        push(cases, sa4h_cat(pre1, sa4h_one("SA4_SHARE 5 300 7 " + sa4w_hex(p2[4]))))
        push(cases, sa4h_cat(pre, sa4h_one(sa4w_fmt_accuse(5, sa4w_bitmap([1])))))
        push(cases, sa4h_cat(pre, [cpl, cpl, sa4w_fmt_accuse(5, sa4w_bitmap([2, 3]))]))
        push(cases, sa4h_cat(pre1, [sa4w_fmt_share(5, 300, 7, sa4e_garbage(p2[4]), p2[5]), sh3, set5, set2]))
        push(cases, sa4h_cat(pre, [cpl, sa4w_fmt_accuse(5, sa4w_bitmap([2])), sa4w_fmt_accuse(5, sa4w_bitmap([2]))]))
        let k = 0
        while k < len(cases) {
            let s0 = sa4h_souls(re, 1, 5, vc, 4)[0]
            let f = sa4h_feed(s0, cases[k])
            let outs = f[1]
            let last = "(none)"
            if len(outs) > 0 { last = outs[len(outs) - 1] }
            println("CASE " + int_to_str(k) + " ok=" + int_to_str(f[0]) + " last=" + last + " err=" + f[2])
            k = k + 1
        }
    }
    if str_eq_bytes(which, "F") == 1 { _dump_round("F", vc) }
    if str_eq_bytes(which, "G") == 1 { _dump_round("G", vc) }
    if str_eq_bytes(which, "H") == 1 { _dump_round("H", vc) }
    if str_eq_bytes(which, "I") == 1 { _dump_round("I", vc) }
    if str_eq_bytes(which, "J") == 1 { _dump_round("J", vc) }
    if str_eq_bytes(which, "P") == 1 { _dump_round("P", vc) }
    return 0
}

main()
