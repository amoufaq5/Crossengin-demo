// SecAgg v4 soul differential driver (A2.3b): runs a case script from
// tests/tools/sa4_cases.py gen through the NOVA soul (sa4s_handle) and prints
// the per-step results in the format of sa4_cases.py run. SA4SCRIPT names the
// script file. See tests/integration/scenario_sa4_pyref.sh.

import "../sa4_harness.nova"

fn _split_nl(txt) {
    let out = list_new()
    let n = len(txt)
    let start = 0
    let i = 0
    while i < n {
        if char_at(txt, i) == 10 {
            push(out, substr(txt, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if start < n { push(out, substr(txt, start, n - start)) }
    return out
}

fn _words(s) {
    let out = list_new()
    let n = len(s)
    let start = 0
    let i = 0
    while i < n {
        if char_at(s, i) == 32 {
            push(out, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(s, start, n - start))
    return out
}

fn main() {
    let vc = list_new()
    let txt = read_file(getenv("SA4SCRIPT"))
    let lines = _split_nl(txt)
    let so = 0
    let cro = 0
    let cidx = 0
    let cr = 0
    let clast = 0
    let k = 0
    let i = 0
    while i < len(lines) {
        let ln = lines[i]
        if sa4h_starts(ln, "CASE ") == 1 {
            let f = _words(ln)
            let n = sa4w_dec_u32(f[2])
            let idx = sa4w_dec_u32(f[3])
            let r = sa4w_dec_u32(f[4])
            let last = sa4w_dec_u32(f[5])
            let ro = sa4h_roster(n)
            so = sa4h_souls(ro, idx + 1, r, vc, last)[idx]
            cro = ro
            cidx = idx
            cr = r
            clast = last
            println("C " + f[1])
            k = 0
        }
        if sa4h_starts(ln, "I ") == 1 {
            let spec = substr(ln, 2, len(ln) - 2)
            let lay = sa4h_layout()
            let w = sa4h_input(cidx, SA4H_L)
            let okv = "-"
            let rs = 0
            if str_eq_bytes(spec, "reset") == 1 {
                let e = sroster_entries(cro)[cidx]
                so = sa4s_new(cro, e, ed25519_hex_to_bytes(SA4H_SEEDS[cidx]), sa4h_rng(e[0], cr), vc, clast)
            }
            if str_eq_bytes(spec, "empty") == 1 { rs = sa4s_set_input(so, list_new(), lay) }
            if str_eq_bytes(spec, "big") == 1 {
                let bg = list_new()
                let q = 0
                while q < 16777217 {
                    push(bg, 0)
                    q = q + 1
                }
                rs = sa4s_set_input(so, bg, lay)
            }
            if str_eq_bytes(spec, "word_2p32") == 1 {
                list_set(w, 5, 4294967296)
                rs = sa4s_set_input(so, w, lay)
            }
            if str_eq_bytes(spec, "word_neg") == 1 {
                list_set(w, 5, 0 - 1)
                rs = sa4s_set_input(so, w, lay)
            }
            if str_eq_bytes(spec, "lay31") == 1 {
                let l31 = list_new()
                let q = 0
                while q < 31 {
                    push(l31, lay[q])
                    q = q + 1
                }
                rs = sa4s_set_input(so, w, l31)
            }
            if str_eq_bytes(spec, "lay33") == 1 {
                push(lay, 0)
                rs = sa4s_set_input(so, w, lay)
            }
            if str_eq_bytes(spec, "len1") == 1 { rs = sa4s_set_input(so, [5], lay) }
            if str_eq_bytes(spec, "maxword") == 1 {
                list_set(w, 3, 4294967295)
                rs = sa4s_set_input(so, w, lay)
            }
            if str_eq_bytes(spec, "after_round") == 1 {
                sa4s_handle(so, sa4h_round_line(cro, cr))
                rs = sa4s_set_input(so, w, lay)
            }
            if rs != 0 { okv = int_to_str(rs[0]) }
            println("I " + spec + " ok=" + okv + " st=" + int_to_str(sa4s_state(so)))
        }
        if sa4h_starts(ln, "L ") == 1 {
            let res = sa4s_handle(so, substr(ln, 2, len(ln) - 2))
            println("S " + int_to_str(k) + " ok=" + int_to_str(res[0]) + " st=" + int_to_str(sa4s_state(so)) + " r=" + int_to_str(sa4s_round(so)) + " dr=" + int_to_str(sa4s_done_round(so)) + " n=" + int_to_str(len(res[2])))
            let j = 0
            while j < len(res[2]) {
                println("O " + res[2][j])
                j = j + 1
            }
            println("E " + res[1])
            k = k + 1
        }
        i = i + 1
    }
    return 0
}

main()
