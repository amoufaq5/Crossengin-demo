// Scenario ttt -- in-process driver for link prediction (R18B).
//
// Builds the brief's fixtures and prints DRIVER lines for the shell
// scenario to parse:
//   - triangle-with-missing-edge (3 atoms, only 2 edges; CN/J/AA
//     correctly predict the missing 0--2 edge via shared neighbour 1);
//   - 4-clique-minus-one (CN ranks the missing-edge endpoints highest);
//   - disjoint subgraphs (random cross-subgraph pair scores 0);
//   - hub down-weight fixture (AA differs from J in ordering --
//     concrete demonstration that the two methods produce different
//     rankings on the same query, which the brief requires).
// It also invokes lp_predict_cmd directly so the shell can assert on
// the PREDICT emit-line shape.

import "std/syscall"
import "std/string"
import "std/io"
import "../../../src/kg/atom_store.nova"
import "../../../src/kg/multi_kg_manager.nova"
import "../../../src/kg/cross_kg_references.nova"
import "../../../src/kg/link_prediction.nova"

fn _add_atom(kg, label) {
    kg_add_atom(kg, ATOM_FACT, label, 0)
    return 1
}

fn _link(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    let y = xref_new(b, a, XREF_SIMILAR, 900, 0)
    atom_add_xref(b, y)
    return 1
}

// triangle-minus-one-edge: {0,1,2} with edges 0--1 and 1--2 only.
// Atom 1 is the shared neighbour predicting the missing 0--2 edge.
fn _build_triangle_missing(reg) {
    let kg = kg_spawn(reg, "triangle_missing_ttt")
    let i = 0
    while i < 3 {
        _add_atom(kg, "t_" + int_to_str(i))
        i = i + 1
    }
    _link(kg, 0, 1)
    _link(kg, 1, 2)
    return kg
}

// 4-clique-minus-one: {0,1,2,3} with every edge EXCEPT 0--3.
// CN(0, 3) = 2 (shared neighbours 1, 2) -- highest score in the graph.
fn _build_k4_minus_one(reg) {
    let kg = kg_spawn(reg, "k4_minus_one_ttt")
    let i = 0
    while i < 4 {
        _add_atom(kg, "q_" + int_to_str(i))
        i = i + 1
    }
    _link(kg, 0, 1)
    _link(kg, 0, 2)
    _link(kg, 1, 2)
    _link(kg, 1, 3)
    _link(kg, 2, 3)
    return kg
}

// Two disjoint triangles: cross-subgraph pair (0, 3) scores 0.
fn _build_disjoint(reg) {
    let kg = kg_spawn(reg, "disjoint_ttt")
    let i = 0
    while i < 6 {
        _add_atom(kg, "d_" + int_to_str(i))
        i = i + 1
    }
    _link(kg, 0, 1)
    _link(kg, 0, 2)
    _link(kg, 1, 2)
    _link(kg, 3, 4)
    _link(kg, 3, 5)
    _link(kg, 4, 5)
    return kg
}

// Hub-vs-rare fixture: u=0, candidates 1 and 2. Both share exactly one
// neighbour with 0:
//   - candidate 1 shares neighbour 3 (deg(3) is HIGH -- 3 is a hub)
//   - candidate 2 shares neighbour 4 (deg(4) is LOW -- only u and v=2)
// Under Jaccard both have the same overlap ratio (each candidate has
// |N|=1 sharing 1 of 1 with 0 if we leave 0 with only that neighbour).
// To make Jaccard equal we ensure 0 has BOTH 3 and 4 as neighbours,
// while candidate 1 only connects to 3 and candidate 2 only connects
// to 4. Then:
//   N(0) = {3, 4}; N(1) = {3, ...}; N(2) = {4}.
// J(0, 1) = |{3}| / |{3, 4, hub_extras}| vs J(0, 2) = |{4}| / |{3, 4}|.
// To make the two pairs ranking-different under AA vs J we want:
//   AA: candidate 2 ranks ABOVE candidate 1 (rare neighbour 4 wins).
//   J : candidate 1 ranks ABOVE or equal to candidate 2 (the hub 3
//       has many neighbours, but for J we only count the OVERLAP, not
//       deg, so the difference is in the union size; the hub
//       contributes extra atoms only to candidate 1's neighbours not
//       0's, so the union grows on the candidate-1 side and J drops).
// Realistically: structuring N(0) and N(1) cleanly so J(0,1) > J(0,2)
// AND AA(0,1) < AA(0,2) is what produces the divergence.
//
// Concrete layout (7 atoms total):
//   0 links {3, 4}
//   1 links {3}        -- N(1) = {0 via 0's xref to 1? NO -- 1 doesn't link to 0}
// Actually 1 doesn't link to 0; that's fine -- the candidate edge is
// what we're predicting. Then:
//   3 links {0, 1, 5, 6, 7}   -- HUB: deg(3) = 5
//   4 links {0, 2}            -- RARE: deg(4) = 2
//   2 links {4}
// Now:
//   N(0) = {3, 4}    deg(0) = 2
//   N(1) = {3}       deg(1) = 1
//   N(2) = {4}       deg(2) = 1
//   N(3) = {0, 1, 5, 6, 7}    deg(3) = 5
//   N(4) = {0, 2}             deg(4) = 2
// CN(0, 1) = |{3}| = 1; CN(0, 2) = |{4}| = 1 (tied on raw count).
// J(0, 1) = |{3}| / |{3, 4}| = 1/2 = 500 milli.
// J(0, 2) = |{4}| / |{3, 4}| = 1/2 = 500 milli (tied on Jaccard too).
// AA(0, 1) = 1000 / log2(5) = 1000 / 2 = 500 milli.
// AA(0, 2) = 1000 / log2(2) = 1000 / 1 = 1000 milli.
// So AA strictly prefers candidate 2 over candidate 1 (rare neighbour
// is more informative), while CN/Jaccard tie. The DIFFERENCE in
// ranking is what the brief asks for -- under CN/J the tie-break
// (ASCENDING id) would put candidate 1 first; under AA candidate 2
// strictly wins. Two different orderings on the same query.
fn _build_hub_vs_rare(reg) {
    let kg = kg_spawn(reg, "hub_vs_rare_ttt")
    let i = 0
    while i < 8 {
        _add_atom(kg, "h_" + int_to_str(i))
        i = i + 1
    }
    _link(kg, 0, 3)
    _link(kg, 0, 4)
    _link(kg, 1, 3)
    _link(kg, 2, 4)
    // Make 3 a hub by linking to extras 5, 6, 7.
    _link(kg, 3, 5)
    _link(kg, 3, 6)
    _link(kg, 3, 7)
    return kg
}

fn main() {
    let reg = kg_registry_new()

    // --- triangle-with-missing-edge ----------------------------------
    let kg_t = _build_triangle_missing(reg)
    let cn_t = lp_common_neighbors(kg_t, 0, 2)
    let j_t = lp_jaccard(kg_t, 0, 2)
    let aa_t = lp_adamic_adar(kg_t, 0, 2)
    io_println("DRIVER triangle_cn_02=" + int_to_str(cn_t))
    io_println("DRIVER triangle_j_02=" + int_to_str(j_t))
    io_println("DRIVER triangle_aa_02=" + int_to_str(aa_t))
    let top_t = lp_predict_top_k(kg_t, 0, 5, LP_JACCARD)
    io_println("DRIVER triangle_top_hits=" + int_to_str(len(top_t)))
    if len(top_t) > 0 {
        io_println("DRIVER triangle_top0_id=" + int_to_str(top_t[0][0]))
        io_println("DRIVER triangle_top0_score=" + int_to_str(top_t[0][1]))
    }

    // --- 4-clique minus the 0--3 edge --------------------------------
    let kg_q = _build_k4_minus_one(reg)
    io_println("DRIVER k4_cn_03=" + int_to_str(lp_common_neighbors(kg_q, 0, 3)))
    io_println("DRIVER k4_j_03=" + int_to_str(lp_jaccard(kg_q, 0, 3)))
    io_println("DRIVER k4_aa_03=" + int_to_str(lp_adamic_adar(kg_q, 0, 3)))
    let top_q = lp_predict_top_k(kg_q, 0, 3, LP_CN)
    io_println("DRIVER k4_top_hits=" + int_to_str(len(top_q)))
    if len(top_q) > 0 {
        io_println("DRIVER k4_top0_id=" + int_to_str(top_q[0][0]))
        io_println("DRIVER k4_top0_score=" + int_to_str(top_q[0][1]))
    }

    // --- disjoint subgraphs -----------------------------------------
    let kg_d = _build_disjoint(reg)
    io_println("DRIVER disjoint_cn_03=" + int_to_str(lp_common_neighbors(kg_d, 0, 3)))
    io_println("DRIVER disjoint_j_03=" + int_to_str(lp_jaccard(kg_d, 0, 3)))
    io_println("DRIVER disjoint_aa_03=" + int_to_str(lp_adamic_adar(kg_d, 0, 3)))

    // --- AA vs J ranking divergence ---------------------------------
    let kg_h = _build_hub_vs_rare(reg)
    // Per the fixture comment:
    //   J: candidate 1 and 2 tied at 500 milli -> ASCENDING tiebreak
    //     puts 1 first.
    //   AA: candidate 2 has weight 1000, candidate 1 has weight 500
    //     -> candidate 2 strictly first.
    let top_j = lp_predict_top_k(kg_h, 0, 2, LP_JACCARD)
    let top_aa = lp_predict_top_k(kg_h, 0, 2, LP_AA)
    io_println("DRIVER hub_j_top0_id=" + int_to_str(top_j[0][0]))
    io_println("DRIVER hub_j_top0_score=" + int_to_str(top_j[0][1]))
    io_println("DRIVER hub_aa_top0_id=" + int_to_str(top_aa[0][0]))
    io_println("DRIVER hub_aa_top0_score=" + int_to_str(top_aa[0][1]))
    // Pairwise scores for the divergence:
    io_println("DRIVER hub_j_01=" + int_to_str(lp_jaccard(kg_h, 0, 1)))
    io_println("DRIVER hub_j_02=" + int_to_str(lp_jaccard(kg_h, 0, 2)))
    io_println("DRIVER hub_aa_01=" + int_to_str(lp_adamic_adar(kg_h, 0, 1)))
    io_println("DRIVER hub_aa_02=" + int_to_str(lp_adamic_adar(kg_h, 0, 2)))

    // --- emit the PREDICT line shape via the chat-dispatch helper ----
    lp_predict_cmd(kg_q, "0 3 jaccard")
    lp_predict_cmd(kg_q, "0 3 aa")

    // Graceful handling of missing source.
    lp_predict_cmd(kg_q, "9999")

    return 0
}
main()
