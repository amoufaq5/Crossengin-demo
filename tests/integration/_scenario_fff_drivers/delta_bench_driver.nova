// Scenario FFF -- in-process driver for snapshot delta-write benchmarking.
//
// Builds a 1000-atom KG, writes a full snapshot, then mutates 10 atoms
// and writes a delta. Reports the wall-time of each operation in
// nanoseconds so the bash side can assert delta-write is at least 3x
// faster than full-snapshot write on the same KG.
//
// We also exercise the compaction path: pre-populate 5 deltas, then
// run snap_delta_compact and assert the deltas are pruned.
//
// Output format (one key=value per line; bash side greps for the
// individual keys):
//
//   atoms=<N>                       -- the population the bench ran against
//   full_write_ns=<int>             -- ns to write the full snapshot
//   full_write_bytes=<int>          -- size of the full snapshot on disk
//   delta_write_ns=<int>            -- ns to write a 10-op delta
//   delta_write_bytes=<int>         -- size of the delta on disk
//   delta_count_before=<int>        -- # deltas pre-compact (== 5 in the bench)
//   compact_removed=<int>           -- # deltas pruned by snap_delta_compact
//   delta_count_after=<int>         -- # deltas post-compact (== 0)
//   reload_ok=<0|1>                 -- did reload + delta-apply produce the right state
//   reload_atom_count=<int>         -- atom count after reload + delta apply
//   episodic_preserved=<0|1>        -- was the parent's episodic blob intact post-reload
//
// Paths via env: CE_FFF_PARENT (the full-snapshot path).

import "std/syscall"
import "std/io"
import "../../../src/persistence/snapshot_disk.nova"
import "../../../src/persistence/snapshot_delta.nova"
import "../../../src/kg/multi_kg_manager.nova"
import "../../../src/kg/atom_store.nova"

fn _build_kg(n_atoms) {
    let reg = kg_registry_new()
    let kg = kg_spawn(reg, "reasoning")
    let i = 0
    while i < n_atoms {
        let label = "atom_" + int_to_str(i)
        let a = kg_add_atom(kg, ATOM_FACT, label, 0)
        let b = atom_belief(a)
        // Mix beliefs so the snapshot isn't trivially compressible.
        list_set(b, 0, 1000 + i)
        list_set(b, 1, 1500 + (i & 7) * 50)
        i = i + 1
    }
    return reg
}

fn _build_1000_atom_kg() { return _build_kg(1000) }

fn _wrap_snap(kg, ts) {
    let s = snap_new(1, ts)
    let sb = list_new()
    push(sb, "Aurora")
    push(sb, 0)
    snap_put_section(s, SEC_SOUL, sb)
    snap_put_section(s, SEC_KGS, kg_section_build(kg))
    // Episodic stub for the preservation check.
    let ep_blob = list_new()
    let moments = list_new()
    let mom = list_new()
    push(mom, 1234)
    push(mom, 1)
    push(mom, 600)
    push(mom, list_new())
    push(moments, mom)
    push(ep_blob, moments)
    push(ep_blob, list_new())
    snap_put_section(s, SEC_EPISODIC, ep_blob)
    return s
}

fn _cleanup_deltas(path) {
    let i = 0
    while i < 200 {
        sys_unlink(delta_path_for(path, i))
        i = i + 1
    }
}

fn _print_kv_int(key, val) {
    io_println(key + "=" + int_to_str(val))
}

fn main() {
    let parent = getenv("CE_FFF_PARENT")
    if parent == 0 {
        io_println("driver: missing CE_FFF_PARENT")
        exit(2)
    }
    if len(parent) == 0 {
        io_println("driver: empty CE_FFF_PARENT")
        exit(2)
    }
    // Clean any stale state.
    sys_unlink(parent)
    _cleanup_deltas(parent)

    let reg = _build_1000_atom_kg()
    let kg = kg_find(reg, "reasoning")
    let snap = _wrap_snap(kg, 100000)

    // ---- bench 1: full-snapshot write ------------------------------------
    //
    // Same warm-up pattern as the delta-write bench: prime caches with a
    // throwaway write, then time the second write. Both passes write to
    // the same file so the disk state at the end of the bench is exactly
    // one full snapshot.
    snap_save(snap, parent + ".warm_tmp")
    sys_unlink(parent + ".warm_tmp")
    let t0 = nanotime()
    let ok_full = snap_save(snap, parent)
    let t1 = nanotime()
    if ok_full == 0 {
        io_println("driver: full snapshot save failed")
        exit(2)
    }
    let full_text = snap_read_text(parent)
    let full_bytes = 0
    if full_text != 0 { full_bytes = len(full_text) }
    _print_kv_int("atoms", 1000)
    _print_kv_int("full_write_ns", t1 - t0)
    _print_kv_int("full_write_bytes", full_bytes)

    // ---- bench 2: delta write with 10 ADDs -------------------------------
    //
    // We time the SECOND of two identical writes -- the first run primes
    // any one-off syscall caches / page-fault paths the NOVA runtime
    // touches on its very first fsync; the second is a fair steady-state
    // measurement of the hot path. The warm-up writer is constructed
    // against a THROW-AWAY KG so the bench's KG state stays at exactly
    // 1000 atoms; otherwise the warmup's `kg_add_atom` would advance
    // the bench's atom-id counter and pollute the post-delta count.
    let warm_path = parent + ".warm_tmp"
    let warm_reg = kg_registry_new()
    let warm_kg = kg_spawn(warm_reg, "reasoning")
    let warm_a = kg_add_atom(warm_kg, ATOM_FACT, "warmup_atom", 0)
    let warm_w = snap_make_delta_writer(snap, 199000)
    delta_writer_record_add(warm_w, warm_a, "reasoning")
    delta_writer_flush(warm_w, warm_path)
    sys_unlink(warm_path)

    let w = snap_make_delta_writer(snap, 200000)
    let i = 0
    while i < 10 {
        let a = kg_add_atom(kg, ATOM_FACT, "delta_atom_" + int_to_str(i), 0)
        let b = atom_belief(a)
        list_set(b, 0, 2500)
        list_set(b, 1, 500)
        delta_writer_record_add(w, a, "reasoning")
        i = i + 1
    }
    let d_path = delta_path_for(parent, 0)
    // Pre-serialize so the bench measures only write+fsync, not text format
    // (the build is amortised across many deltas the daemon would batch).
    let ts0 = nanotime()
    let dtxt = delta_writer_to_text(w)
    let ts1 = nanotime()
    let t2 = nanotime()
    let ok_delta = delta_write_durable(dtxt, d_path)
    let t3 = nanotime()
    _print_kv_int("delta_serialize_ns", ts1 - ts0)
    if ok_delta == 0 {
        io_println("driver: delta save failed")
        exit(2)
    }
    let d_text = snap_read_text(d_path)
    let d_bytes = 0
    if d_text != 0 { d_bytes = len(d_text) }
    _print_kv_int("delta_write_ns", t3 - t2)
    _print_kv_int("delta_write_bytes", d_bytes)

    // ---- compaction: pre-populate 4 MORE deltas, then compact -----------
    let j = 1
    while j < 5 {
        let w2 = snap_make_delta_writer(snap, 200000 + j)
        let a2 = kg_add_atom(kg, ATOM_FACT, "compact_atom_" + int_to_str(j), 0)
        delta_writer_record_add(w2, a2, "reasoning")
        let dp = delta_path_for(parent, j)
        delta_writer_flush(w2, dp)
        j = j + 1
    }
    _print_kv_int("delta_count_before", snap_delta_count_for(parent))
    // Rebuild a fresh full snapshot reflecting the post-delta state.
    let new_snap = _wrap_snap(kg, 300000)
    let removed = snap_delta_compact(parent, new_snap, 1)
    _print_kv_int("compact_removed", removed)
    _print_kv_int("delta_count_after", snap_delta_count_for(parent))

    // ---- reload check: load compacted, verify all atoms present ----------
    let reg2 = kg_registry_new()
    kg_spawn(reg2, "reasoning")
    let loaded = snap_load(parent)
    let reload_ok = 0
    let reload_atoms = 0
    let ep_ok = 0
    if loaded != 0 {
        kg_section_apply(reg2, snap_section(loaded, SEC_KGS), 0)
        let kg2 = kg_find(reg2, "reasoning")
        reload_atoms = kg_atom_count(kg2)
        // 1000 + 10 (first delta) + 4 (compact deltas) = 1014.
        if reload_atoms == 1014 { reload_ok = 1 }
        // Episodic preservation: parent's moment with ts=1234 must survive.
        if snap_has_section(loaded, SEC_EPISODIC) == 1 {
            let ep_blob = snap_section(loaded, SEC_EPISODIC)
            if len(ep_blob) >= 1 {
                if len(ep_blob[0]) >= 1 {
                    if ep_blob[0][0][0] == 1234 { ep_ok = 1 }
                }
            }
        }
    }
    _print_kv_int("reload_ok", reload_ok)
    _print_kv_int("reload_atom_count", reload_atoms)
    _print_kv_int("episodic_preserved", ep_ok)

    // Clean up.
    sys_unlink(parent)
    _cleanup_deltas(parent)

    // ---- bench 3: 5000-atom KG so serialize + write dominate fsync ------
    // On a busy server the fsync floor (~2 ms here) becomes invisible
    // relative to serialize+write of a multi-MB blob. Demonstrate the
    // architecture's scalability by reporting the ratio at a 5x larger
    // KG, where the delta is still 10 ops (== 523 bytes) but the full
    // write has to pump ~750KB through.
    let reg5k = _build_kg(5000)
    let kg5k = kg_find(reg5k, "reasoning")
    let snap5k = _wrap_snap(kg5k, 400000)
    let big_path = parent + ".big"
    snap_save(snap5k, big_path + ".warm_tmp")
    sys_unlink(big_path + ".warm_tmp")
    let tb0 = nanotime()
    snap_save(snap5k, big_path)
    let tb1 = nanotime()
    let big_text = snap_read_text(big_path)
    let big_bytes = 0
    if big_text != 0 { big_bytes = len(big_text) }
    _print_kv_int("big_full_write_ns", tb1 - tb0)
    _print_kv_int("big_full_write_bytes", big_bytes)
    // Delta against the big KG.
    let wb = snap_make_delta_writer(snap5k, 500000)
    let bi = 0
    while bi < 10 {
        let ab = kg_add_atom(kg5k, ATOM_FACT, "big_delta_" + int_to_str(bi), 0)
        delta_writer_record_add(wb, ab, "reasoning")
        bi = bi + 1
    }
    let bd_path = delta_path_for(big_path, 0)
    let wbtxt = delta_writer_to_text(wb)
    let tb2 = nanotime()
    delta_write_durable(wbtxt, bd_path)
    let tb3 = nanotime()
    _print_kv_int("big_delta_write_ns", tb3 - tb2)
    sys_unlink(big_path)
    sys_unlink(bd_path)

    exit(0)
}
main()
