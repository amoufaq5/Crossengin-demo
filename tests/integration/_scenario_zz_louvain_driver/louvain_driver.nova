// Scenario zz -- in-process driver for Louvain community detection.
//
// Builds three fixtures the brief calls out -- a barbell (two 4-cliques
// + bridge), three disjoint triangles, and the Zachary 1977 karate-
// club graph -- and prints DRIVER lines so the shell scenario can
// assert on them. The driver also runs R11F's gc_label_propagation on
// the SAME fixtures so the shell can compare Louvain >= LPA on
// modularity.
//
// The `louvain_communities_cmd` call at the bottom emits the same
// LOUVAIN line the chat /louvain admin prints, so the shell can
// assert on the line shape too.

import "std/syscall"
import "std/string"
import "std/io"
import "../../../src/kg/atom_store.nova"
import "../../../src/kg/multi_kg_manager.nova"
import "../../../src/kg/cross_kg_references.nova"
import "../../../src/kg/louvain.nova"
import "../../../src/kg/graph_clustering.nova"

fn _add_atom(kg, label) {
    kg_add_atom(kg, ATOM_FACT, label, 0)
    return 1
}

fn _link(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    let y = xref_new(b, a, XREF_SIMILAR, 900, 0)
    atom_add_xref(b, y)
    return 1
}

fn _clique(kg, start, size) {
    let i = 0
    while i < size {
        let j = i + 1
        while j < size {
            _link(kg, start + i, start + j)
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

fn _build_barbell(reg) {
    let kg = kg_spawn(reg, "barbell_zz")
    let i = 0
    while i < 8 {
        _add_atom(kg, "b_" + int_to_str(i))
        i = i + 1
    }
    _clique(kg, 0, 4)
    _clique(kg, 4, 4)
    _link(kg, 3, 4)
    return kg
}

fn _build_three_triangles(reg) {
    let kg = kg_spawn(reg, "tri_zz")
    let i = 0
    while i < 9 {
        _add_atom(kg, "t_" + int_to_str(i))
        i = i + 1
    }
    _clique(kg, 0, 3)
    _clique(kg, 3, 3)
    _clique(kg, 6, 3)
    return kg
}

fn _build_karate(reg) {
    let kg = kg_spawn(reg, "karate_zz")
    let i = 0
    while i < 34 {
        _add_atom(kg, "k_" + int_to_str(i))
        i = i + 1
    }
    _link(kg, 0, 1)   _link(kg, 0, 2)   _link(kg, 0, 3)   _link(kg, 0, 4)
    _link(kg, 0, 5)   _link(kg, 0, 6)   _link(kg, 0, 7)   _link(kg, 0, 8)
    _link(kg, 0, 10)  _link(kg, 0, 11)  _link(kg, 0, 12)  _link(kg, 0, 13)
    _link(kg, 0, 17)  _link(kg, 0, 19)  _link(kg, 0, 21)  _link(kg, 0, 31)
    _link(kg, 1, 2)   _link(kg, 1, 3)   _link(kg, 1, 7)   _link(kg, 1, 13)
    _link(kg, 1, 17)  _link(kg, 1, 19)  _link(kg, 1, 21)  _link(kg, 1, 30)
    _link(kg, 2, 3)   _link(kg, 2, 7)   _link(kg, 2, 8)   _link(kg, 2, 9)
    _link(kg, 2, 13)  _link(kg, 2, 27)  _link(kg, 2, 28)  _link(kg, 2, 32)
    _link(kg, 3, 7)   _link(kg, 3, 12)  _link(kg, 3, 13)
    _link(kg, 4, 6)   _link(kg, 4, 10)
    _link(kg, 5, 6)   _link(kg, 5, 10)  _link(kg, 5, 16)
    _link(kg, 6, 16)
    _link(kg, 8, 30)  _link(kg, 8, 32)  _link(kg, 8, 33)
    _link(kg, 9, 33)
    _link(kg, 13, 33)
    _link(kg, 14, 32) _link(kg, 14, 33)
    _link(kg, 15, 32) _link(kg, 15, 33)
    _link(kg, 18, 32) _link(kg, 18, 33)
    _link(kg, 19, 33)
    _link(kg, 20, 32) _link(kg, 20, 33)
    _link(kg, 22, 32) _link(kg, 22, 33)
    _link(kg, 23, 25) _link(kg, 23, 27) _link(kg, 23, 29) _link(kg, 23, 32) _link(kg, 23, 33)
    _link(kg, 24, 25) _link(kg, 24, 27) _link(kg, 24, 31)
    _link(kg, 25, 31)
    _link(kg, 26, 29) _link(kg, 26, 33)
    _link(kg, 27, 33)
    _link(kg, 28, 31) _link(kg, 28, 33)
    _link(kg, 29, 32) _link(kg, 29, 33)
    _link(kg, 30, 32) _link(kg, 30, 33)
    _link(kg, 31, 32) _link(kg, 31, 33)
    _link(kg, 32, 33)
    return kg
}

fn main() {
    let reg = kg_registry_new()

    // --- barbell ------------------------------------------------------
    let kg_b = _build_barbell(reg)
    let r_lv_b = louvain_communities(kg_b, 10)
    let r_gc_b = gc_label_propagation(kg_b, 20)
    io_println("DRIVER barbell_lv_n=" + int_to_str(louvain_community_count(r_lv_b)))
    io_println("DRIVER barbell_lv_q=" + int_to_str(louvain_modularity(kg_b, r_lv_b)))
    io_println("DRIVER barbell_gc_n=" + int_to_str(gc_community_count(r_gc_b)))
    io_println("DRIVER barbell_gc_q=" + int_to_str(gc_modularity(kg_b, r_gc_b)))
    io_println("DRIVER barbell_lv_edges=" + int_to_str(louvain_total_edges(r_lv_b)))
    io_println("DRIVER barbell_lv_depth=" + int_to_str(louvain_levels(r_lv_b)))

    // --- 3 triangles --------------------------------------------------
    let kg_t = _build_three_triangles(reg)
    let r_lv_t = louvain_communities(kg_t, 10)
    let r_gc_t = gc_label_propagation(kg_t, 20)
    io_println("DRIVER tri_lv_n=" + int_to_str(louvain_community_count(r_lv_t)))
    io_println("DRIVER tri_lv_q=" + int_to_str(louvain_modularity(kg_t, r_lv_t)))
    io_println("DRIVER tri_gc_q=" + int_to_str(gc_modularity(kg_t, r_gc_t)))
    io_println("DRIVER tri_lv_edges=" + int_to_str(louvain_total_edges(r_lv_t)))

    // --- karate club --------------------------------------------------
    let kg_k = _build_karate(reg)
    let r_lv_k = louvain_communities(kg_k, 10)
    let r_gc_k = gc_label_propagation(kg_k, 20)
    io_println("DRIVER karate_lv_n=" + int_to_str(louvain_community_count(r_lv_k)))
    io_println("DRIVER karate_lv_q=" + int_to_str(louvain_modularity(kg_k, r_lv_k)))
    io_println("DRIVER karate_gc_q=" + int_to_str(gc_modularity(kg_k, r_gc_k)))
    io_println("DRIVER karate_lv_edges=" + int_to_str(louvain_total_edges(r_lv_k)))
    io_println("DRIVER karate_lv_depth=" + int_to_str(louvain_levels(r_lv_k)))

    // --- emit the LOUVAIN line shape via the chat-dispatch helper ----
    louvain_communities_cmd(kg_b)

    return 0
}
main()
