// Scenario eee -- in-process driver for PageRank centrality (R13E).
//
// Builds two fixtures the brief calls out:
//   - a barbell (two 4-cliques + bridge) where the bridge atoms own
//     the highest centrality (every cross-clique walk goes through them);
//   - the Zachary 1977 karate-club graph where Mr Hi (atom 0) and
//     Officer (atom 33) MUST be the top-2 by PageRank score per the
//     classic centrality analysis;
// and prints DRIVER lines for the shell scenario to parse. It also
// invokes pagerank_cmd directly so the shell can assert on the
// PAGERANK emit-line shape.

import "std/syscall"
import "std/string"
import "std/io"
import "../../../src/kg/atom_store.nova"
import "../../../src/kg/multi_kg_manager.nova"
import "../../../src/kg/cross_kg_references.nova"
import "../../../src/kg/pagerank.nova"

fn _add_atom(kg, label) {
    kg_add_atom(kg, ATOM_FACT, label, 0)
    return 1
}

fn _link(kg, a_id, b_id) {
    let a = kg_atom(kg, a_id)
    let b = kg_atom(kg, b_id)
    let x = xref_new(a, b, XREF_SIMILAR, 900, 0)
    atom_add_xref(a, x)
    let y = xref_new(b, a, XREF_SIMILAR, 900, 0)
    atom_add_xref(b, y)
    return 1
}

fn _clique(kg, start, size) {
    let i = 0
    while i < size {
        let j = i + 1
        while j < size {
            _link(kg, start + i, start + j)
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

fn _build_barbell(reg) {
    let kg = kg_spawn(reg, "barbell_eee")
    let i = 0
    while i < 8 {
        _add_atom(kg, "b_" + int_to_str(i))
        i = i + 1
    }
    _clique(kg, 0, 4)
    _clique(kg, 4, 4)
    _link(kg, 3, 4)
    return kg
}

fn _build_karate(reg) {
    let kg = kg_spawn(reg, "karate_eee")
    let i = 0
    while i < 34 {
        _add_atom(kg, "k_" + int_to_str(i))
        i = i + 1
    }
    _link(kg, 0, 1)   _link(kg, 0, 2)   _link(kg, 0, 3)   _link(kg, 0, 4)
    _link(kg, 0, 5)   _link(kg, 0, 6)   _link(kg, 0, 7)   _link(kg, 0, 8)
    _link(kg, 0, 10)  _link(kg, 0, 11)  _link(kg, 0, 12)  _link(kg, 0, 13)
    _link(kg, 0, 17)  _link(kg, 0, 19)  _link(kg, 0, 21)  _link(kg, 0, 31)
    _link(kg, 1, 2)   _link(kg, 1, 3)   _link(kg, 1, 7)   _link(kg, 1, 13)
    _link(kg, 1, 17)  _link(kg, 1, 19)  _link(kg, 1, 21)  _link(kg, 1, 30)
    _link(kg, 2, 3)   _link(kg, 2, 7)   _link(kg, 2, 8)   _link(kg, 2, 9)
    _link(kg, 2, 13)  _link(kg, 2, 27)  _link(kg, 2, 28)  _link(kg, 2, 32)
    _link(kg, 3, 7)   _link(kg, 3, 12)  _link(kg, 3, 13)
    _link(kg, 4, 6)   _link(kg, 4, 10)
    _link(kg, 5, 6)   _link(kg, 5, 10)  _link(kg, 5, 16)
    _link(kg, 6, 16)
    _link(kg, 8, 30)  _link(kg, 8, 32)  _link(kg, 8, 33)
    _link(kg, 9, 33)
    _link(kg, 13, 33)
    _link(kg, 14, 32) _link(kg, 14, 33)
    _link(kg, 15, 32) _link(kg, 15, 33)
    _link(kg, 18, 32) _link(kg, 18, 33)
    _link(kg, 19, 33)
    _link(kg, 20, 32) _link(kg, 20, 33)
    _link(kg, 22, 32) _link(kg, 22, 33)
    _link(kg, 23, 25) _link(kg, 23, 27) _link(kg, 23, 29) _link(kg, 23, 32) _link(kg, 23, 33)
    _link(kg, 24, 25) _link(kg, 24, 27) _link(kg, 24, 31)
    _link(kg, 25, 31)
    _link(kg, 26, 29) _link(kg, 26, 33)
    _link(kg, 27, 33)
    _link(kg, 28, 31) _link(kg, 28, 33)
    _link(kg, 29, 32) _link(kg, 29, 33)
    _link(kg, 30, 32) _link(kg, 30, 33)
    _link(kg, 31, 32) _link(kg, 31, 33)
    _link(kg, 32, 33)
    return kg
}

fn _build_empty(reg) {
    let kg = kg_spawn(reg, "empty_eee")
    return kg
}

fn main() {
    let reg = kg_registry_new()

    // --- empty KG -----------------------------------------------------
    let kg_e = _build_empty(reg)
    let r_e = pagerank_default(kg_e)
    io_println("DRIVER empty_n=" + int_to_str(pagerank_n_atoms(r_e)))
    io_println("DRIVER empty_iters=" + int_to_str(pagerank_iterations(r_e)))
    io_println("DRIVER empty_converged=" + int_to_str(pagerank_converged(r_e)))

    // --- barbell ------------------------------------------------------
    // 8 atoms, two 4-cliques joined by a 3<->4 bridge. Bridge nodes
    // (atoms 3 and 4) are by far the highest-degree (3 + 1 = 4 each)
    // -- atoms 0-2 and 5-7 are each linked only inside their clique
    // (degree 3 each). PageRank should put atoms 3 and 4 at the top
    // and treat the rest symmetrically.
    let kg_b = _build_barbell(reg)
    let r_b = pagerank_default(kg_b)
    io_println("DRIVER barbell_n=" + int_to_str(pagerank_n_atoms(r_b)))
    io_println("DRIVER barbell_iters=" + int_to_str(pagerank_iterations(r_b)))
    io_println("DRIVER barbell_converged=" + int_to_str(pagerank_converged(r_b)))
    io_println("DRIVER barbell_total_mass=" + int_to_str(pagerank_total_mass(r_b)))
    let top_b = pagerank_top_k(r_b, 5)
    let bi = 0
    while bi < len(top_b) {
        io_println("DRIVER barbell_top_" + int_to_str(bi)
            + "_id=" + int_to_str(top_b[bi][0])
            + " barbell_top_" + int_to_str(bi)
            + "_pr=" + int_to_str(top_b[bi][1]))
        bi = bi + 1
    }
    // Check bridge atoms (3 and 4) win.
    io_println("DRIVER barbell_top0=" + int_to_str(top_b[0][0]))
    io_println("DRIVER barbell_top1=" + int_to_str(top_b[1][0]))
    io_println("DRIVER barbell_pr_atom3=" + int_to_str(pagerank_at(r_b, 3)))
    io_println("DRIVER barbell_pr_atom4=" + int_to_str(pagerank_at(r_b, 4)))
    io_println("DRIVER barbell_pr_atom0=" + int_to_str(pagerank_at(r_b, 0)))

    // --- karate club --------------------------------------------------
    let kg_k = _build_karate(reg)
    let r_k = pagerank_default(kg_k)
    io_println("DRIVER karate_n=" + int_to_str(pagerank_n_atoms(r_k)))
    io_println("DRIVER karate_iters=" + int_to_str(pagerank_iterations(r_k)))
    io_println("DRIVER karate_converged=" + int_to_str(pagerank_converged(r_k)))
    io_println("DRIVER karate_total_mass=" + int_to_str(pagerank_total_mass(r_k)))
    io_println("DRIVER karate_pr_0=" + int_to_str(pagerank_at(r_k, 0)))
    io_println("DRIVER karate_pr_33=" + int_to_str(pagerank_at(r_k, 33)))
    let top_k = pagerank_top_k(r_k, 5)
    io_println("DRIVER karate_top0=" + int_to_str(top_k[0][0]))
    io_println("DRIVER karate_top1=" + int_to_str(top_k[1][0]))

    // --- emit the PAGERANK line shape via the chat-dispatch helper ---
    pagerank_cmd(kg_b)

    return 0
}
main()
