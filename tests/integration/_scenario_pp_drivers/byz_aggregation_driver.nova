// Scenario pp -- in-process driver for Byzantine-resilient federated aggregation.
//
// Simulates 5 federated souls submitting a per-source (promo, atr) rate
// for "topic:fever". 4 souls are honest (rates near 700/200 milli); 1
// soul is Byzantine (poisoned 100x value 9999/9999). The driver runs
// the federated accumulator under THREE strategies on the EXACT same
// input set and prints the aggregate so the bash side can assert on
// the values:
//
//   NONE     -> heavily skewed by the poisoning
//   TRIMMED  -> drops the outlier; close to honest mean
//   MEDIAN   -> picks the honest cluster's middle value
//
// Also exercises the env-driven strategy/trim_k overrides so
// scenario_pp can flip behaviour via CE_FL_BYZ_STRATEGY without
// changing any code path here.

import "../../../src/learning/byzantine_aggregation.nova"
import "../../../src/learning/federated_aggregator.nova"

fn _populate(a) {
    // 4 honest souls + 1 Byzantine. Same source tag across all.
    fed_acc_byz_add_stat(a, "topic:fever", 700, 200)
    fed_acc_byz_add_stat(a, "topic:fever", 710, 210)
    fed_acc_byz_add_stat(a, "topic:fever", 720, 220)
    fed_acc_byz_add_stat(a, "topic:fever", 690, 190)
    fed_acc_byz_add_stat(a, "topic:fever", 9999, 9999)
}

fn _emit(label, agg) {
    let i = 0
    while i < len(agg) {
        let row = agg[i]
        println(label + " tag=" + row[0]
            + " promo=" + int_to_str(row[1])
            + " atr=" + int_to_str(row[2])
            + " n_part=" + int_to_str(row[3]))
        i = i + 1
    }
}

fn main() {
    // Strategy: BYZ_NONE -- baseline plain mean, expected to be poisoned.
    let a_none = fed_acc_byz_new(1)
    _populate(a_none)
    let agg_none = fed_acc_byz_aggregate(a_none, BYZ_NONE, 0)
    _emit("NONE", agg_none)

    // Strategy: BYZ_TRIMMED_MEAN with trim_k=1 -- drops one outlier each end.
    let a_trim = fed_acc_byz_new(1)
    _populate(a_trim)
    let agg_trim = fed_acc_byz_aggregate(a_trim, BYZ_TRIMMED_MEAN, 1)
    _emit("TRIMMED", agg_trim)

    // Strategy: BYZ_MEDIAN -- picks middle value of each sorted coord.
    let a_med = fed_acc_byz_new(1)
    _populate(a_med)
    let agg_med = fed_acc_byz_aggregate(a_med, BYZ_MEDIAN, 0)
    _emit("MEDIAN", agg_med)

    // Env-driven dispatch. The bash side toggles CE_FL_BYZ_STRATEGY
    // before invoking the driver; we read it and dispatch on it. This
    // proves the env var actually flips behaviour without code edits.
    let a_env = fed_acc_byz_new(1)
    _populate(a_env)
    let strat = byz_strategy_from_env()
    let trim_k = byz_trim_k_from_env(BYZ_DEFAULT_TRIM_K)
    let agg_env = fed_acc_byz_aggregate(a_env, strat, trim_k)
    println("ENV strategy=" + byz_strategy_name(strat)
        + " trim_k=" + int_to_str(trim_k))
    _emit("ENV", agg_env)

    // Print module-side sanity diagnostics so the bash side can also
    // verify the constants are wired the way the spec describes.
    println("CONST BYZ_NONE=" + int_to_str(BYZ_NONE)
        + " BYZ_TRIMMED_MEAN=" + int_to_str(BYZ_TRIMMED_MEAN)
        + " BYZ_MEDIAN=" + int_to_str(BYZ_MEDIAN))
}

main()
