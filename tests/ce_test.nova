// CrossEngin shared test helpers.
//
// Purpose: a tiny assertion harness used by every unit test under tests/unit/.
//   Lives one directory above tests/unit/ on purpose: the test runner
//   (scripts/test.sh) globs tests/unit/*.nova, so this file is never executed
//   as a standalone test. Unit tests import it with: import "../ce_test.nova".
//
// Contract honored by scripts/test.sh: a test program passes iff it exits 0 and
// prints no line containing "FAIL". ce_summary() enforces both: it prints a
// per-suite tally and calls exit(1) when any check failed.
//
// ADRs: ADR-0049 (testing and benchmarks).
// NOVA dependencies: builtins only (print, println, int_to_str, str_eq, exit).
// CrossEngin dependencies: none.

let ce_pass = 0
let ce_fail = 0

// Assert a boolean condition.
fn ce_check(label, cond) {
    if cond {
        ce_pass = ce_pass + 1
    } else {
        ce_fail = ce_fail + 1
        println("FAIL: " + label)
    }
}

// Assert integer equality, reporting both operands on mismatch.
fn ce_eq(label, got, expected) {
    if got == expected {
        ce_pass = ce_pass + 1
    } else {
        ce_fail = ce_fail + 1
        println("FAIL: " + label + " expected=" + int_to_str(expected) + " got=" + int_to_str(got))
    }
}

// Char-by-char string comparison. Avoids NOVA's `str_eq` builtin, which
// gives WRONG results on a family of specific string literals (see the
// standing-constraints note in NEXT_SESSION.md -- "str_eq environmentally
// flaky on specific literals"). Concretely, ce_str_eq was reporting false
// FAILs like `expected='CONST' got='CONST'` (byte-identical strings). This
// walks bytes via char_at, which is unaffected.
fn _ce_str_eq_bytes(a, b) {
    let na = len(a)
    if na != len(b) { return 0 }
    let i = 0
    while i < na {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Assert string equality.
fn ce_str_eq(label, got, expected) {
    if _ce_str_eq_bytes(got, expected) == 1 {
        ce_pass = ce_pass + 1
    } else {
        ce_fail = ce_fail + 1
        println("FAIL: " + label + " expected='" + expected + "' got='" + got + "'")
    }
}

// Assert that got is within +/- tol of expected (for fixed-point arithmetic).
fn ce_near(label, got, expected, tol) {
    let d = got - expected
    if d < 0 { d = 0 - d }
    if d <= tol {
        ce_pass = ce_pass + 1
    } else {
        ce_fail = ce_fail + 1
        println("FAIL: " + label + " expected~=" + int_to_str(expected) + " got=" + int_to_str(got) + " tol=" + int_to_str(tol))
    }
}

// Print the suite tally and fail the process if any check failed.
// IMPORTANT: scripts/test.sh marks a test failed if its output contains the
// token "FAIL" (case-insensitive, after start-of-line or a space). So the
// success path must never emit that token -- only the failure path does.
fn ce_summary(suite) {
    if ce_fail > 0 {
        println(suite + ": " + int_to_str(ce_pass) + " passed, " + int_to_str(ce_fail) + " FAILED")
        exit(1)
    }
    println(suite + ": OK (" + int_to_str(ce_pass) + " checks)")
}
