// CrossEngin in-process TLS: certificate-authentication wire seam
// (R90, ADR r86-in-process-tls-scaffolding.md).
//
// Purpose
//   RFC 8446 §4.4.3 defines TLS 1.3 CertificateVerify: the server (or
//   client, in mutual-auth) proves ownership of the public key in its
//   certificate by signing a canonical serialization of the current
//   handshake transcript. Under our chosen suite (see R86 ADR) the
//   signature scheme is Ed25519, so the CertificateVerify signature is
//   an Ed25519 signature over the 130-byte-header + transcript-hash
//   blob described below.
//
//   R90 lands the two functions the handshake state machine (R93) will
//   call once it exists:
//
//     * tls_cert_verify_input_build(transcript_hash, transcript_hash_len,
//                                    is_server) -> signed_data (byte list)
//         Assemble the exact byte string RFC 8446 §4.4.3 specifies for
//         the signature input. Deterministic; no crypto; no allocation
//         outside the returned list.
//
//     * tls_cert_verify_ed25519(cert_pubkey, transcript_hash,
//                                transcript_hash_len, is_server,
//                                signature) -> 0 | 1
//         One-call convenience wrapping build + ed25519_verify. Returns
//         1 iff the signature is a valid Ed25519 signature over the
//         signed_data under cert_pubkey.
//
//     * tls_cert_verify(cert_pubkey, signed_data, signed_data_len,
//                       signature) -> 0 | 1
//         Thin adapter for callers that already have signed_data in
//         hand (e.g. the R93 handshake will build it once and reuse
//         it for the transcript hash extend step). signed_data may be
//         a byte list or a [buf, len] pair -- this function accepts a
//         byte list; the *_len parameter is redundant and is kept in
//         the signature so a future switch to a raw buffer + length
//         representation doesn't change the wire.
//
//   R90 does NOT parse X.509: the caller passes the 32-byte raw
//   Ed25519 public key. The X.509 subset parser is a separate later
//   phase (see §12 in docs/SHIP_AS_APP.md -- currently sketched for
//   R92 candidate). Making the primitive callable BEFORE the parser
//   exists lets the handshake state machine (R93 candidate) be
//   plumbed against a stubbed cert-pubkey source with the crypto
//   already validated.
//
// TLS 1.3 signed-content format (RFC 8446 §4.4.3)
//
//   The bytes that get signed are:
//
//     1. 64 octets of 0x20 (ASCII SPACE).
//     2. Context string: "TLS 1.3, server CertificateVerify" (server-
//        side) or "TLS 1.3, client CertificateVerify" (client-side).
//        UTF-8; 33 octets in both cases (only one word differs).
//     3. One octet 0x00 (separator).
//     4. Transcript-hash bytes (32 for SHA-256, the R86-chosen suite).
//
//   Total length for the R86 suite: 64 + 33 + 1 + 32 = 130 octets.
//
// Non-goals for R90 (deliberately)
//   * X.509 DER parsing (raw pubkey passed in; parser lands later).
//   * Signing on the TLS path (verify only; the server-side signer
//     needs an RNG-derived nonce chain that Ed25519 nominally
//     derives deterministically from the private-key prefix, so
//     ed25519_sign works with a stored seed -- but the TLS server
//     signing wrapper is deferred until the handshake exists to
//     consume it).
//   * Cert chain validation (single leaf; trust-anchor comparison
//     is a later ADR-driven phase).
//   * Touching the handshake state machine (tls_handshake.nova
//     stubs stay stubbed until R93).
//   * Flipping the wire hook (still cleartext until R94).
//
// NOVA quirks
//   * NOVA strings are C-style NUL-terminated. Crypto payloads
//     (transcript hashes, signatures, pubkeys) contain NULs -- we
//     represent them as byte LISTS (each entry an int in [0, 255]).
//     Every function takes byte lists; every returned buffer is also
//     a byte list.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/safety/ed25519.nova   -- ed25519_verify.
//   src/net/tls/x509.nova     -- R92 X.509 subset parser + chain verify
//                                (imported for tls_cert_verify_chain_and_signature).

import "../../safety/ed25519.nova"
import "./x509.nova"

// ---- constants -----------------------------------------------------------

// Length of the ASCII SPACE-padding prefix, per RFC 8446 §4.4.3.
let TLS_CERT_PAD_LEN = 64

// Context string is 33 octets in both server / client forms:
//   "TLS 1.3, server CertificateVerify"   (33 chars, incl. the space
//                                          after the comma and before
//                                          the role word)
//   "TLS 1.3, client CertificateVerify"
let TLS_CERT_CONTEXT_LEN = 33

// One-byte separator between the context string and the transcript hash.
let TLS_CERT_SEP_LEN = 1

// Ed25519 pubkey / signature sizes, mirrored from RFC 8032.
let TLS_CERT_PUBKEY_LEN     = 32
let TLS_CERT_SIGNATURE_LEN  = 64

// Server / client role sentinels for tls_cert_verify_input_build and
// tls_cert_verify_ed25519.
let TLS_CERT_ROLE_CLIENT = 0
let TLS_CERT_ROLE_SERVER = 1

// ---- context-string builders --------------------------------------------
//
// Emit the 33-byte context string into a fresh byte list. Two builders,
// one per role, so callers pick the shape statically. Both return byte
// lists of length exactly TLS_CERT_CONTEXT_LEN.

fn _tls_cert_context_server() {
    // "TLS 1.3, server CertificateVerify"
    //  T  L  S     1  .  3  ,     s  e  r  v  e  r     C  e  r  t  i  f  i  c  a  t  e  V  e  r  i  f  y
    //  84 76 83 32 49 46 51 44 32 115 101 114 118 101 114 32 67 101 114 116 105 102 105 99 97 116 101 86 101 114 105 102 121
    let s = list_new()
    push(s, 84)   // 'T'
    push(s, 76)   // 'L'
    push(s, 83)   // 'S'
    push(s, 32)   // ' '
    push(s, 49)   // '1'
    push(s, 46)   // '.'
    push(s, 51)   // '3'
    push(s, 44)   // ','
    push(s, 32)   // ' '
    push(s, 115)  // 's'
    push(s, 101)  // 'e'
    push(s, 114)  // 'r'
    push(s, 118)  // 'v'
    push(s, 101)  // 'e'
    push(s, 114)  // 'r'
    push(s, 32)   // ' '
    push(s, 67)   // 'C'
    push(s, 101)  // 'e'
    push(s, 114)  // 'r'
    push(s, 116)  // 't'
    push(s, 105)  // 'i'
    push(s, 102)  // 'f'
    push(s, 105)  // 'i'
    push(s, 99)   // 'c'
    push(s, 97)   // 'a'
    push(s, 116)  // 't'
    push(s, 101)  // 'e'
    push(s, 86)   // 'V'
    push(s, 101)  // 'e'
    push(s, 114)  // 'r'
    push(s, 105)  // 'i'
    push(s, 102)  // 'f'
    push(s, 121)  // 'y'
    return s
}

fn _tls_cert_context_client() {
    // "TLS 1.3, client CertificateVerify" -- differs from the server
    // form in the role word only: 'client' (99 108 105 101 110 116)
    // instead of 'server' (115 101 114 118 101 114). Both are 6 chars,
    // preserving the 33-byte total length.
    let s = list_new()
    push(s, 84)   // 'T'
    push(s, 76)   // 'L'
    push(s, 83)   // 'S'
    push(s, 32)   // ' '
    push(s, 49)   // '1'
    push(s, 46)   // '.'
    push(s, 51)   // '3'
    push(s, 44)   // ','
    push(s, 32)   // ' '
    push(s, 99)   // 'c'
    push(s, 108)  // 'l'
    push(s, 105)  // 'i'
    push(s, 101)  // 'e'
    push(s, 110)  // 'n'
    push(s, 116)  // 't'
    push(s, 32)   // ' '
    push(s, 67)   // 'C'
    push(s, 101)  // 'e'
    push(s, 114)  // 'r'
    push(s, 116)  // 't'
    push(s, 105)  // 'i'
    push(s, 102)  // 'f'
    push(s, 105)  // 'i'
    push(s, 99)   // 'c'
    push(s, 97)   // 'a'
    push(s, 116)  // 't'
    push(s, 101)  // 'e'
    push(s, 86)   // 'V'
    push(s, 101)  // 'e'
    push(s, 114)  // 'r'
    push(s, 105)  // 'i'
    push(s, 102)  // 'f'
    push(s, 121)  // 'y'
    return s
}

// ---- input-string assembly ----------------------------------------------
//
// Build the RFC 8446 §4.4.3 signed content:
//   [64 x 0x20] || context_string || 0x00 || transcript_hash
//
// The returned byte list is freshly allocated. `transcript_hash` is a
// byte list; `transcript_hash_len` is the number of leading bytes to
// consume (allowing the caller to pass a longer buffer with a
// canonicalised length, mirroring the pattern used by tls_kdf_*).
// `is_server` picks the role word.

fn tls_cert_verify_input_build(transcript_hash, transcript_hash_len,
                               is_server) {
    let out = list_new()
    // 1. 64 SPACE octets (0x20).
    let i = 0
    while i < TLS_CERT_PAD_LEN {
        push(out, 32)
        i = i + 1
    }
    // 2. Context string. Server vs client selected by role sentinel.
    let ctx = _tls_cert_context_client()
    if is_server == TLS_CERT_ROLE_SERVER { ctx = _tls_cert_context_server() }
    let ci = 0
    while ci < TLS_CERT_CONTEXT_LEN {
        push(out, ctx[ci])
        ci = ci + 1
    }
    // 3. One-byte separator 0x00.
    push(out, 0)
    // 4. Transcript-hash bytes.
    let ti = 0
    while ti < transcript_hash_len {
        push(out, transcript_hash[ti])
        ti = ti + 1
    }
    return out
}

// ---- verify primitives --------------------------------------------------

// Thin adapter: verify an Ed25519 signature over the already-assembled
// signed_data. cert_pubkey MUST be exactly 32 bytes; signature MUST be
// exactly 64 bytes; ed25519_verify enforces both. Returns 1 on valid
// signature, 0 otherwise (including all shape / decoding failures).
//
// signed_data_len is currently ignored because signed_data is a byte
// list whose true length is len(signed_data). The parameter is kept
// in the signature so a future switch to a raw buffer representation
// wouldn't ripple through the R93 handshake glue.
fn tls_cert_verify(cert_pubkey, signed_data, signed_data_len, signature) {
    if len(cert_pubkey) != TLS_CERT_PUBKEY_LEN { return 0 }
    if len(signature) != TLS_CERT_SIGNATURE_LEN { return 0 }
    // If the caller declared a length shorter than the byte list,
    // slice down; if longer, refuse (shape mismatch). Same treatment
    // as tls_record's [buf, len] pairs.
    let n = len(signed_data)
    if signed_data_len < 0 { return 0 }
    if signed_data_len > n { return 0 }
    if signed_data_len == n {
        return ed25519_verify(signed_data, signature, cert_pubkey)
    }
    // Materialize a truncated view. Rare in practice; the R93 handshake
    // will pass the exact-length list built by tls_cert_verify_input_build.
    let trimmed = list_new()
    let i = 0
    while i < signed_data_len {
        push(trimmed, signed_data[i])
        i = i + 1
    }
    return ed25519_verify(trimmed, signature, cert_pubkey)
}

// One-call convenience: assemble the signed data from a transcript hash
// and verify.
fn tls_cert_verify_ed25519(cert_pubkey, transcript_hash, transcript_hash_len,
                           is_server, signature) {
    let signed = tls_cert_verify_input_build(transcript_hash,
                                             transcript_hash_len,
                                             is_server)
    return tls_cert_verify(cert_pubkey, signed, len(signed), signature)
}

// ---- R92: full chain + TLS CertificateVerify wrap -----------------------
//
// End-to-end path a TLS 1.3 handshake will call (once R93 exists) to
// validate the peer's leaf certificate AND its CertificateVerify signature
// in one shot:
//
//   1. `x509_chain_verify(leaf_buf, leaf_len, root_buf, root_len,
//                          now_unix, leaf_parsed, root_parsed)`
//      -- chain-length-2 verification (leaf signed by self-signed root,
//         both Ed25519, both inside validity window, leaf.issuer ==
//         root.subject on CN).
//   2. `tls_cert_verify_input_build(transcript_hash, transcript_hash_len,
//                                    is_server)` -- assemble the RFC 8446
//      §4.4.3 signed-content blob.
//   3. `ed25519_verify(signed_blob, tls_signature, leaf_spki_pubkey)`
//      -- verify the peer's Ed25519 CertificateVerify signature over
//         the assembled input, using the leaf cert's SPKI pubkey.
//
// Returns 1 iff all three pass. 0 on any failure (invalid chain,
// expired cert, wrong Ed25519 alg, tampered TLS signature, or a
// shape mismatch on tls_signature).
//
// `tls_signature` MUST be 64 bytes (Ed25519). The leaf's SPKI pubkey
// is 32 bytes -- extracted from the parsed leaf, no need for the
// caller to pass it separately.
//
// This function does NOT touch the handshake state machine and does
// NOT write to the wire; both remain R93 / R94 territory.
fn tls_cert_verify_chain_and_signature(leaf_cert_buf, leaf_len,
                                        root_cert_buf, root_len,
                                        now_unix,
                                        transcript_hash, transcript_hash_len,
                                        is_server, tls_signature) {
    // Shape gates first: cheap, and their failure mode is unambiguous.
    if len(tls_signature) != TLS_CERT_SIGNATURE_LEN { return 0 }
    if transcript_hash_len < 0 { return 0 }
    if transcript_hash_len > len(transcript_hash) { return 0 }
    // (1) Chain verify.
    let leaf_parsed = x509_parsed_new()
    let root_parsed = x509_parsed_new()
    let chain_ok = x509_chain_verify(leaf_cert_buf, leaf_len,
                                     root_cert_buf, root_len,
                                     now_unix, leaf_parsed, root_parsed)
    if chain_ok == 0 { return 0 }
    // (2) Materialize the leaf's SPKI pubkey (32 bytes) for step (3).
    let pk = list_new()
    let pk_off = leaf_parsed[X509_IDX_SPKI_PUB_OFF]
    let pi = 0
    while pi < TLS_CERT_PUBKEY_LEN {
        push(pk, leaf_cert_buf[pk_off + pi])
        pi = pi + 1
    }
    // (3) Verify the TLS CertificateVerify signature via the R90 seam.
    return tls_cert_verify_ed25519(pk, transcript_hash, transcript_hash_len,
                                   is_server, tls_signature)
}
