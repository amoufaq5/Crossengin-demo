// CrossEngin TLS base64 decoder (R94, ADR r86-in-process-tls-scaffolding.md).
//
// The daemon boot path (R94) reads DER-encoded cert / private-key /
// root material from three environment variables:
//
//   CROSSENGIN_TLS_LEAF_DER      base64(leaf.der)
//   CROSSENGIN_TLS_LEAF_PRIV     base64(leaf-priv-seed-32-bytes)
//   CROSSENGIN_TLS_ROOT_DER      base64(root.der)
//
// This module is a minimal RFC 4648 §4 base64 decoder that turns those
// strings into byte lists tls_config_new_server / tls_config_new_client
// can consume directly. Not a PEM parser -- inputs are plain base64,
// no ``-----BEGIN CERTIFICATE-----'' armor.
//
// Design notes
//   - Decoder is length-tolerant of one \n or space at the very end
//     (shells often append a newline when piping through `base64 -w0`
//     and heredocs). Any other non-alphabet byte fails hard.
//   - Padding is REQUIRED. The decoder rejects unpadded input; every
//     `base64` implementation on POSIX emits padding by default. This
//     is a deliberate strictness choice; we prefer refusing garbled
//     env-vars loudly to silently accepting misalignment.
//   - Output is a byte list, matching the shape tls_config /
//     tls_session already speak.
//
// NOVA dependencies: builtins (list_new, push, len, char_at,
//   int_and, int_shl, int_shr, int_or).
// CrossEngin dependencies: none.

// ---- alphabet map -------------------------------------------------------
//
// RFC 4648 §4 alphabet indexed by ASCII byte. Non-alphabet slots hold
// -1 sentinel (0xFF); the pad char '=' is a special case handled
// separately, not looked up through this table.

let _B64_PAD_CHAR = 61   // '='

// Return 0..63 for a base64-alphabet byte, -1 for anything else.
fn _b64_char_value(c) {
    // 'A' .. 'Z' -> 0 .. 25
    if c >= 65 { if c <= 90 { return c - 65 } }
    // 'a' .. 'z' -> 26 .. 51
    if c >= 97 { if c <= 122 { return (c - 97) + 26 } }
    // '0' .. '9' -> 52 .. 61
    if c >= 48 { if c <= 57 { return (c - 48) + 52 } }
    if c == 43 { return 62 }   // '+'
    if c == 47 { return 63 }   // '/'
    return 0 - 1
}

// Strip a single trailing '\n' or space (env-var quirks) but nothing
// else. Returns the trimmed string.
fn _b64_rtrim_one(s) {
    let n = len(s)
    if n == 0 { return s }
    let c = char_at(s, n - 1)
    if c == 10 { return substr(s, 0, n - 1) }
    if c == 32 { return substr(s, 0, n - 1) }
    return s
}

// Decode a base64 string into a byte list. Returns [ok, byte_list]:
//   ok = 1 on success, byte_list is the decoded bytes.
//   ok = 0 on any shape error, byte_list is empty.
//
// Padding is REQUIRED. Alphabet is strict (RFC 4648 §4); '-' and '_'
// (url-safe alphabet) are refused.
fn base64_decode(s) {
    let trimmed = _b64_rtrim_one(s)
    let n = len(trimmed)
    let out = list_new()
    let ret = list_new()
    if n == 0 {
        push(ret, 1)
        push(ret, out)
        return ret
    }
    // Length must be a multiple of 4 (padded).
    let quad_count = n / 4
    if quad_count * 4 != n {
        push(ret, 0)
        push(ret, out)
        return ret
    }
    let qi = 0
    while qi < quad_count {
        let base_i = qi * 4
        let c0 = char_at(trimmed, base_i + 0)
        let c1 = char_at(trimmed, base_i + 1)
        let c2 = char_at(trimmed, base_i + 2)
        let c3 = char_at(trimmed, base_i + 3)
        // Padding is only legal in the LAST quad.
        let is_last = 0
        if qi == quad_count - 1 { is_last = 1 }
        // First two chars must always be alphabet.
        let v0 = _b64_char_value(c0)
        let v1 = _b64_char_value(c1)
        if v0 < 0 {
            push(ret, 0); push(ret, list_new()); return ret
        }
        if v1 < 0 {
            push(ret, 0); push(ret, list_new()); return ret
        }
        // Third char: alphabet, or '=' iff is_last AND fourth is '='.
        let v2 = 0 - 1
        let v3 = 0 - 1
        if c2 == _B64_PAD_CHAR {
            if is_last == 0 {
                push(ret, 0); push(ret, list_new()); return ret
            }
            if c3 != _B64_PAD_CHAR {
                push(ret, 0); push(ret, list_new()); return ret
            }
            // one output byte from this quad.
            let b0 = int_or(int_shl(v0, 2), int_shr(v1, 4))
            push(out, int_and(b0, 255))
        } else {
            v2 = _b64_char_value(c2)
            if v2 < 0 {
                push(ret, 0); push(ret, list_new()); return ret
            }
            if c3 == _B64_PAD_CHAR {
                if is_last == 0 {
                    push(ret, 0); push(ret, list_new()); return ret
                }
                // two output bytes from this quad.
                let b0 = int_or(int_shl(v0, 2), int_shr(v1, 4))
                let b1 = int_or(int_shl(int_and(v1, 15), 4), int_shr(v2, 2))
                push(out, int_and(b0, 255))
                push(out, int_and(b1, 255))
            } else {
                v3 = _b64_char_value(c3)
                if v3 < 0 {
                    push(ret, 0); push(ret, list_new()); return ret
                }
                let b0 = int_or(int_shl(v0, 2), int_shr(v1, 4))
                let b1 = int_or(int_shl(int_and(v1, 15), 4), int_shr(v2, 2))
                let b2 = int_or(int_shl(int_and(v2, 3), 6), v3)
                push(out, int_and(b0, 255))
                push(out, int_and(b1, 255))
                push(out, int_and(b2, 255))
            }
        }
        qi = qi + 1
    }
    push(ret, 1)
    push(ret, out)
    return ret
}
