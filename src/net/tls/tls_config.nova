// CrossEngin in-process TLS: server-side config holder
// (R86, ADR r86-in-process-tls-scaffolding).
//
// A tls_config holds the material a server presents on the wire:
//   - cert_der       -- server certificate, DER-encoded X.509 subset
//                       bytes. Empty string for the R86 scaffold.
//   - key_der        -- server private key, ed25519 seed as raw bytes
//                       (32-byte string). Empty string for R86.
//   - cipher_pref    -- ordered list of cipher-suite codes the server
//                       is willing to negotiate. Default:
//                       [TLS_CIPHER_CHACHA20_POLY1305_SHA256].
//   - session_cache_size -- number of session tickets the record layer
//                       is willing to cache (R96 wires this; R86
//                       stores the number and does nothing with it).
//
// A null tls_config (integer 0) means "TLS is not configured; the
// wire hook returns the raw fd unchanged". The daemon boots with a
// null tls_config today and will keep booting with one until R94 is
// merged AND an operator explicitly configures cert/key material.
//
// All symbols are prefixed `tls_config_` to avoid NOVA symbol collisions.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies (R94):
//   src/safety/ed25519.nova  -- derive Ed25519 leaf-cert pubkey from the
//                               32-byte seed the operator passes in as
//                               the private key.
//   src/net/tls/x509.nova    -- validate cert DER shape at config-build
//                               time so a garbled env-var fails on boot
//                               instead of on the first handshake.

import "../../safety/ed25519.nova"
import "./x509.nova"

// ---- cipher suite codes (RFC 8446 §B.4) ---------------------------------

// R86 supports ONE suite by design (see ADR §"Chosen algorithm suite").
// AES-GCM slots are enumerated so future rounds can widen without a
// header change, but they are NOT in the default preference list.
let TLS_CIPHER_AES_128_GCM_SHA256       = 4865
let TLS_CIPHER_AES_256_GCM_SHA384       = 4866
let TLS_CIPHER_CHACHA20_POLY1305_SHA256 = 4867

// ---- struct offsets ------------------------------------------------------

let TC_CERT_DER    = 0
let TC_KEY_DER     = 1
let TC_CIPHER_PREF = 2
let TC_CACHE_SIZE  = 3
// R94 additions -- role (client vs server), the derived Ed25519 leaf
// pubkey (needed by session_new_server; derived from seed at config-
// build time), and the trust anchor DER (needed by session_new_client
// AND kept on the server side too, so operator tooling has one struct
// that holds everything).
let TC_CERT_PUB    = 4
let TC_ROOT_DER    = 5
let TC_ROLE        = 6

let TLS_CONFIG_ROLE_NONE   = 0
let TLS_CONFIG_ROLE_SERVER = 1
let TLS_CONFIG_ROLE_CLIENT = 2

// ---- default preferences -------------------------------------------------

let TLS_DEFAULT_SESSION_CACHE_SIZE = 256

fn _tls_default_cipher_pref() {
    let l = list_new()
    push(l, TLS_CIPHER_CHACHA20_POLY1305_SHA256)
    return l
}

// ---- constructors --------------------------------------------------------

// Empty config: no cert, no key, default cipher pref, default cache.
// Kept around for tests / scaffold smoke; production paths will use
// tls_config_new_from_material() (below) once R91 lands cert parsing.
fn tls_config_new_empty() {
    let c = list_new()
    push(c, "")
    push(c, "")
    push(c, _tls_default_cipher_pref())
    push(c, TLS_DEFAULT_SESSION_CACHE_SIZE)
    push(c, "")                          // TC_CERT_PUB
    push(c, "")                          // TC_ROOT_DER
    push(c, TLS_CONFIG_ROLE_NONE)        // TC_ROLE
    return c
}

fn tls_config_new_from_material(cert_der, key_der) {
    let c = list_new()
    push(c, cert_der)
    push(c, key_der)
    push(c, _tls_default_cipher_pref())
    push(c, TLS_DEFAULT_SESSION_CACHE_SIZE)
    push(c, "")                          // TC_CERT_PUB
    push(c, "")                          // TC_ROOT_DER
    push(c, TLS_CONFIG_ROLE_NONE)        // TC_ROLE
    return c
}

// ---- R94 constructors (production shape) ---------------------------------
//
// cert material is caller-provided; there is no PEM loader in R94 --
// pass DER bytes directly. A sidecar or launcher is responsible for
// reading files off disk and passing to the daemon (see
// docs/SHIP_AS_APP.md §7.44 for the recipe). All buffer parameters are
// byte lists (NOVA does not encode a length in a raw buffer; the _len
// arguments are validated against len(buf) for shape-safety).
//
// tls_config_new_server(cfg_out, leaf_cert_buf, leaf_cert_len,
//                        leaf_priv_buf, root_cert_buf, root_cert_len) -> ok
//
//   Populates `cfg_out` (an empty caller-owned list) with a full
//   server-role config. Returns 1 on success, 0 on any shape error
//   (mis-matched length, unparseable leaf DER, unparseable root DER,
//   wrong leaf-priv seed length). On failure `cfg_out` is left as-is
//   (partially populated is acceptable; callers check the return value
//   and discard on 0).
//
// leaf_priv_buf: a byte list holding the 32-byte Ed25519 seed for the
//   leaf. R94 does NOT parse PKCS#8 wrappers; the operator (or their
//   sidecar) unwraps the raw seed before calling. RFC 8410 §7 gives the
//   wrapper shape; `openssl pkey -in leaf.pem -outform DER -text_pub`
//   or a purpose-built extractor script belongs in the launcher, not
//   in the daemon.
//
// The leaf Ed25519 public key is DERIVED from `leaf_priv_buf` via
// `ed25519_pk_from_a` so we do not need a separate parameter; a
// mismatch between leaf_cert's SPKI and the derived pubkey is a bad-
// material condition the caller will discover on the first handshake
// (session_new_server does not cross-check them either; the ADR notes
// this as an R95+ improvement).
fn tls_config_new_server(cfg_out, leaf_cert_buf, leaf_cert_len,
                          leaf_priv_buf, root_cert_buf, root_cert_len) {
    if leaf_cert_buf == 0 { return 0 }
    if leaf_priv_buf == 0 { return 0 }
    if root_cert_buf == 0 { return 0 }
    if len(leaf_cert_buf) != leaf_cert_len { return 0 }
    if len(root_cert_buf) != root_cert_len { return 0 }
    if len(leaf_priv_buf) != 32 { return 0 }
    if leaf_cert_len <= 0 { return 0 }
    if root_cert_len <= 0 { return 0 }
    // Validate DER shape now so a garbled env-var fails on boot.
    let leaf_parsed = x509_parsed_new()
    if x509_parse(leaf_cert_buf, leaf_cert_len, leaf_parsed) != 1 { return 0 }
    let root_parsed = x509_parsed_new()
    if x509_parse(root_cert_buf, root_cert_len, root_parsed) != 1 { return 0 }
    // Derive leaf pubkey from the 32-byte seed.
    let parts = _ed_derive_a_and_prefix(leaf_priv_buf)
    let a = parts[0]
    let leaf_pub = _ed_pk_from_a(a)
    push(cfg_out, leaf_cert_buf)                 // TC_CERT_DER
    push(cfg_out, leaf_priv_buf)                 // TC_KEY_DER (raw 32-byte seed)
    push(cfg_out, _tls_default_cipher_pref())    // TC_CIPHER_PREF
    push(cfg_out, TLS_DEFAULT_SESSION_CACHE_SIZE) // TC_CACHE_SIZE
    push(cfg_out, leaf_pub)                      // TC_CERT_PUB
    push(cfg_out, root_cert_buf)                 // TC_ROOT_DER
    push(cfg_out, TLS_CONFIG_ROLE_SERVER)        // TC_ROLE
    return 1
}

// tls_config_new_client(cfg_out, root_cert_buf, root_cert_len) -> ok
//
// Populates `cfg_out` with a client-role config: the caller supplies
// only the trust anchor's DER. Client cert (mutual TLS) is out of
// scope for R94.
fn tls_config_new_client(cfg_out, root_cert_buf, root_cert_len) {
    if root_cert_buf == 0 { return 0 }
    if len(root_cert_buf) != root_cert_len { return 0 }
    if root_cert_len <= 0 { return 0 }
    let root_parsed = x509_parsed_new()
    if x509_parse(root_cert_buf, root_cert_len, root_parsed) != 1 { return 0 }
    push(cfg_out, "")                            // TC_CERT_DER
    push(cfg_out, "")                            // TC_KEY_DER
    push(cfg_out, _tls_default_cipher_pref())    // TC_CIPHER_PREF
    push(cfg_out, TLS_DEFAULT_SESSION_CACHE_SIZE) // TC_CACHE_SIZE
    push(cfg_out, "")                            // TC_CERT_PUB
    push(cfg_out, root_cert_buf)                 // TC_ROOT_DER
    push(cfg_out, TLS_CONFIG_ROLE_CLIENT)        // TC_ROLE
    return 1
}

// ---- accessors -----------------------------------------------------------

fn tls_config_cert_der(c) {
    return c[TC_CERT_DER]
}

fn tls_config_key_der(c) {
    return c[TC_KEY_DER]
}

fn tls_config_cipher_pref(c) {
    return c[TC_CIPHER_PREF]
}

fn tls_config_cache_size(c) {
    return c[TC_CACHE_SIZE]
}

fn tls_config_has_material(c) {
    if len(c[TC_CERT_DER]) == 0 { return 0 }
    if len(c[TC_KEY_DER]) == 0  { return 0 }
    return 1
}

// R94 accessors for the new fields.
fn tls_config_cert_pub(c) { return c[TC_CERT_PUB] }
fn tls_config_root_der(c) { return c[TC_ROOT_DER] }
fn tls_config_role(c)     { return c[TC_ROLE] }

// ---- mutators (opt-in; scaffold has no callers yet) ---------------------

fn tls_config_set_cipher_pref(c, prefs) {
    list_set(c, TC_CIPHER_PREF, prefs)
}

fn tls_config_set_cache_size(c, n) {
    if n < 0 { n = 0 }
    list_set(c, TC_CACHE_SIZE, n)
}

// Add a cipher suite to the END of the preference list. Duplicates are
// no-ops (the existing position wins).
fn tls_config_add_cipher(c, code) {
    let prefs = c[TC_CIPHER_PREF]
    let i = 0
    while i < len(prefs) {
        if prefs[i] == code { return 0 }
        i = i + 1
    }
    push(prefs, code)
    return 1
}

// ---- cipher-suite name (for logs / audit) -------------------------------

fn tls_cipher_name(code) {
    if code == TLS_CIPHER_AES_128_GCM_SHA256       { return "TLS_AES_128_GCM_SHA256" }
    if code == TLS_CIPHER_AES_256_GCM_SHA384       { return "TLS_AES_256_GCM_SHA384" }
    if code == TLS_CIPHER_CHACHA20_POLY1305_SHA256 { return "TLS_CHACHA20_POLY1305_SHA256" }
    return "unknown_cipher(" + int_to_str(code) + ")"
}
