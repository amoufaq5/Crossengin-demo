// CrossEngin in-process TLS: server-side config holder
// (R86, ADR r86-in-process-tls-scaffolding).
//
// A tls_config holds the material a server presents on the wire:
//   - cert_der       -- server certificate, DER-encoded X.509 subset
//                       bytes. Empty string for the R86 scaffold.
//   - key_der        -- server private key, ed25519 seed as raw bytes
//                       (32-byte string). Empty string for R86.
//   - cipher_pref    -- ordered list of cipher-suite codes the server
//                       is willing to negotiate. Default:
//                       [TLS_CIPHER_CHACHA20_POLY1305_SHA256].
//   - session_cache_size -- number of session tickets the record layer
//                       is willing to cache (R96 wires this; R86
//                       stores the number and does nothing with it).
//
// A null tls_config (integer 0) means "TLS is not configured; the
// wire hook returns the raw fd unchanged". The daemon boots with a
// null tls_config today and will keep booting with one until R94 is
// merged AND an operator explicitly configures cert/key material.
//
// All symbols are prefixed `tls_config_` to avoid NOVA symbol collisions.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- cipher suite codes (RFC 8446 §B.4) ---------------------------------

// R86 supports ONE suite by design (see ADR §"Chosen algorithm suite").
// AES-GCM slots are enumerated so future rounds can widen without a
// header change, but they are NOT in the default preference list.
let TLS_CIPHER_AES_128_GCM_SHA256       = 4865
let TLS_CIPHER_AES_256_GCM_SHA384       = 4866
let TLS_CIPHER_CHACHA20_POLY1305_SHA256 = 4867

// ---- struct offsets ------------------------------------------------------

let TC_CERT_DER    = 0
let TC_KEY_DER     = 1
let TC_CIPHER_PREF = 2
let TC_CACHE_SIZE  = 3

// ---- default preferences -------------------------------------------------

let TLS_DEFAULT_SESSION_CACHE_SIZE = 256

fn _tls_default_cipher_pref() {
    let l = list_new()
    push(l, TLS_CIPHER_CHACHA20_POLY1305_SHA256)
    return l
}

// ---- constructors --------------------------------------------------------

// Empty config: no cert, no key, default cipher pref, default cache.
// Kept around for tests / scaffold smoke; production paths will use
// tls_config_new_from_material() (below) once R91 lands cert parsing.
fn tls_config_new_empty() {
    let c = list_new()
    push(c, "")
    push(c, "")
    push(c, _tls_default_cipher_pref())
    push(c, TLS_DEFAULT_SESSION_CACHE_SIZE)
    return c
}

fn tls_config_new_from_material(cert_der, key_der) {
    let c = list_new()
    push(c, cert_der)
    push(c, key_der)
    push(c, _tls_default_cipher_pref())
    push(c, TLS_DEFAULT_SESSION_CACHE_SIZE)
    return c
}

// ---- accessors -----------------------------------------------------------

fn tls_config_cert_der(c) {
    return c[TC_CERT_DER]
}

fn tls_config_key_der(c) {
    return c[TC_KEY_DER]
}

fn tls_config_cipher_pref(c) {
    return c[TC_CIPHER_PREF]
}

fn tls_config_cache_size(c) {
    return c[TC_CACHE_SIZE]
}

fn tls_config_has_material(c) {
    if len(c[TC_CERT_DER]) == 0 { return 0 }
    if len(c[TC_KEY_DER]) == 0  { return 0 }
    return 1
}

// ---- mutators (opt-in; scaffold has no callers yet) ---------------------

fn tls_config_set_cipher_pref(c, prefs) {
    list_set(c, TC_CIPHER_PREF, prefs)
}

fn tls_config_set_cache_size(c, n) {
    if n < 0 { n = 0 }
    list_set(c, TC_CACHE_SIZE, n)
}

// Add a cipher suite to the END of the preference list. Duplicates are
// no-ops (the existing position wins).
fn tls_config_add_cipher(c, code) {
    let prefs = c[TC_CIPHER_PREF]
    let i = 0
    while i < len(prefs) {
        if prefs[i] == code { return 0 }
        i = i + 1
    }
    push(prefs, code)
    return 1
}

// ---- cipher-suite name (for logs / audit) -------------------------------

fn tls_cipher_name(code) {
    if code == TLS_CIPHER_AES_128_GCM_SHA256       { return "TLS_AES_128_GCM_SHA256" }
    if code == TLS_CIPHER_AES_256_GCM_SHA384       { return "TLS_AES_256_GCM_SHA384" }
    if code == TLS_CIPHER_CHACHA20_POLY1305_SHA256 { return "TLS_CHACHA20_POLY1305_SHA256" }
    return "unknown_cipher(" + int_to_str(code) + ")"
}
