// CrossEngin in-process TLS: alert enum + serialize/parse
// (R86, ADR r86-in-process-tls-scaffolding).
//
// TLS 1.3 alerts (RFC 8446 §6) are two bytes on the wire wrapped in a
// record whose content type is 21 (alert). This module owns the alert
// codes, an alert struct, and the byte-round-trip serializers. It is
// the ONE piece of the TLS module tree that is fully implemented in
// R86: no crypto is involved, only a byte enum and a fixed pair.
//
// A TLS alert struct is [level, description]:
//   level        -- 1 (warning) or 2 (fatal). RFC 8446 §6 collapses
//                   the level distinction (alerts are effectively
//                   fatal in TLS 1.3), but the byte position is kept
//                   so the wire framing matches every deployed peer.
//   description  -- one-byte code from the enum below.
//
// All symbols are prefixed `tls_alert_` to avoid symbol collisions
// with the other tls_* modules (a NOVA runtime quirk).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- alert levels ---------------------------------------------------------

let TLS_ALERT_LEVEL_WARNING = 1
let TLS_ALERT_LEVEL_FATAL   = 2

// ---- alert descriptions (RFC 8446 §6, complete) --------------------------

let TLS_ALERT_CLOSE_NOTIFY                    = 0
let TLS_ALERT_UNEXPECTED_MESSAGE              = 10
let TLS_ALERT_BAD_RECORD_MAC                  = 20
let TLS_ALERT_RECORD_OVERFLOW                 = 22
let TLS_ALERT_HANDSHAKE_FAILURE               = 40
let TLS_ALERT_BAD_CERTIFICATE                 = 42
let TLS_ALERT_UNSUPPORTED_CERTIFICATE         = 43
let TLS_ALERT_CERTIFICATE_REVOKED             = 44
let TLS_ALERT_CERTIFICATE_EXPIRED             = 45
let TLS_ALERT_CERTIFICATE_UNKNOWN             = 46
let TLS_ALERT_ILLEGAL_PARAMETER               = 47
let TLS_ALERT_UNKNOWN_CA                      = 48
let TLS_ALERT_ACCESS_DENIED                   = 49
let TLS_ALERT_DECODE_ERROR                    = 50
let TLS_ALERT_DECRYPT_ERROR                   = 51
let TLS_ALERT_PROTOCOL_VERSION                = 70
let TLS_ALERT_INSUFFICIENT_SECURITY           = 71
let TLS_ALERT_INTERNAL_ERROR                  = 80
let TLS_ALERT_INAPPROPRIATE_FALLBACK          = 86
let TLS_ALERT_USER_CANCELED                   = 90
let TLS_ALERT_MISSING_EXTENSION               = 109
let TLS_ALERT_UNSUPPORTED_EXTENSION           = 110
let TLS_ALERT_UNRECOGNIZED_NAME               = 112
let TLS_ALERT_BAD_CERTIFICATE_STATUS_RESPONSE = 113
let TLS_ALERT_UNKNOWN_PSK_IDENTITY            = 115
let TLS_ALERT_CERTIFICATE_REQUIRED            = 116
let TLS_ALERT_NO_APPLICATION_PROTOCOL         = 120

// ---- alert struct --------------------------------------------------------
//
// A tls_alert is a two-element list [level, description]. Kept small so
// callers can construct on the stack of a wire failure path without any
// allocation ceremony.

let TA_LEVEL = 0
let TA_DESC  = 1

fn tls_alert_new(level, description) {
    let a = list_new()
    push(a, level)
    push(a, description)
    return a
}

fn tls_alert_level(a) {
    return a[TA_LEVEL]
}

fn tls_alert_description(a) {
    return a[TA_DESC]
}

// A closed-notify (level=warning, description=close_notify) is the one
// alert TLS 1.3 formally sends warning-level; the shorthand exists so
// the wire close path is one call.
fn tls_alert_close_notify() {
    return tls_alert_new(TLS_ALERT_LEVEL_WARNING,
                         TLS_ALERT_CLOSE_NOTIFY)
}

// ---- description validity ------------------------------------------------
//
// Every RFC 8446 §6 code is enumerated above. A description outside
// that set is either an alert from an unknown extension (which TLS 1.3
// says the peer MUST ignore) or a wire corruption. `tls_alert_known()`
// returns 1 for a valid code, 0 otherwise. The parser accepts unknown
// codes (per RFC) but callers can filter with this.

fn tls_alert_known(desc) {
    if desc == TLS_ALERT_CLOSE_NOTIFY                    { return 1 }
    if desc == TLS_ALERT_UNEXPECTED_MESSAGE              { return 1 }
    if desc == TLS_ALERT_BAD_RECORD_MAC                  { return 1 }
    if desc == TLS_ALERT_RECORD_OVERFLOW                 { return 1 }
    if desc == TLS_ALERT_HANDSHAKE_FAILURE               { return 1 }
    if desc == TLS_ALERT_BAD_CERTIFICATE                 { return 1 }
    if desc == TLS_ALERT_UNSUPPORTED_CERTIFICATE         { return 1 }
    if desc == TLS_ALERT_CERTIFICATE_REVOKED             { return 1 }
    if desc == TLS_ALERT_CERTIFICATE_EXPIRED             { return 1 }
    if desc == TLS_ALERT_CERTIFICATE_UNKNOWN             { return 1 }
    if desc == TLS_ALERT_ILLEGAL_PARAMETER               { return 1 }
    if desc == TLS_ALERT_UNKNOWN_CA                      { return 1 }
    if desc == TLS_ALERT_ACCESS_DENIED                   { return 1 }
    if desc == TLS_ALERT_DECODE_ERROR                    { return 1 }
    if desc == TLS_ALERT_DECRYPT_ERROR                   { return 1 }
    if desc == TLS_ALERT_PROTOCOL_VERSION                { return 1 }
    if desc == TLS_ALERT_INSUFFICIENT_SECURITY           { return 1 }
    if desc == TLS_ALERT_INTERNAL_ERROR                  { return 1 }
    if desc == TLS_ALERT_INAPPROPRIATE_FALLBACK          { return 1 }
    if desc == TLS_ALERT_USER_CANCELED                   { return 1 }
    if desc == TLS_ALERT_MISSING_EXTENSION               { return 1 }
    if desc == TLS_ALERT_UNSUPPORTED_EXTENSION           { return 1 }
    if desc == TLS_ALERT_UNRECOGNIZED_NAME               { return 1 }
    if desc == TLS_ALERT_BAD_CERTIFICATE_STATUS_RESPONSE { return 1 }
    if desc == TLS_ALERT_UNKNOWN_PSK_IDENTITY            { return 1 }
    if desc == TLS_ALERT_CERTIFICATE_REQUIRED            { return 1 }
    if desc == TLS_ALERT_NO_APPLICATION_PROTOCOL         { return 1 }
    return 0
}

// ---- serialize / parse ---------------------------------------------------
//
// Wire form is exactly two bytes: level, description. The close_notify
// alert has description=0, so we cannot use NOVA strings for the wire
// form (NOVA strings are C-style NUL-terminated -- see
// src/safety/chacha20.nova on the same issue). Instead the byte
// serializers return / accept `[buf, len]` byte-buffer pairs the same
// way chacha20.nova does. The buf is alloc()'d and stays live until
// the caller drops the reference.

// Result offsets for the [buf, len] pair the byte functions return.
let TLS_ALERT_BUF_PTR = 0
let TLS_ALERT_BUF_LEN = 1

fn tls_alert_bytes_buf(a) {
    let buf = alloc(2)
    store8(buf + 0, a[TA_LEVEL])
    store8(buf + 1, a[TA_DESC])
    let out = list_new()
    push(out, buf)
    push(out, 2)
    return out
}

fn tls_alert_parse_buf(buf, buf_len) {
    if buf_len != 2 { return 0 }
    let lvl  = load8(buf + 0)
    let desc = load8(buf + 1)
    return tls_alert_new(lvl, desc)
}

// ---- human-readable name -------------------------------------------------
//
// For log lines and audit trails. Unknown codes stringify as
// "unknown_alert(<code>)" so operators can grep for the numeric value
// even when the enum lookup misses.

fn tls_alert_desc_name(desc) {
    if desc == TLS_ALERT_CLOSE_NOTIFY                    { return "close_notify" }
    if desc == TLS_ALERT_UNEXPECTED_MESSAGE              { return "unexpected_message" }
    if desc == TLS_ALERT_BAD_RECORD_MAC                  { return "bad_record_mac" }
    if desc == TLS_ALERT_RECORD_OVERFLOW                 { return "record_overflow" }
    if desc == TLS_ALERT_HANDSHAKE_FAILURE               { return "handshake_failure" }
    if desc == TLS_ALERT_BAD_CERTIFICATE                 { return "bad_certificate" }
    if desc == TLS_ALERT_UNSUPPORTED_CERTIFICATE         { return "unsupported_certificate" }
    if desc == TLS_ALERT_CERTIFICATE_REVOKED             { return "certificate_revoked" }
    if desc == TLS_ALERT_CERTIFICATE_EXPIRED             { return "certificate_expired" }
    if desc == TLS_ALERT_CERTIFICATE_UNKNOWN             { return "certificate_unknown" }
    if desc == TLS_ALERT_ILLEGAL_PARAMETER               { return "illegal_parameter" }
    if desc == TLS_ALERT_UNKNOWN_CA                      { return "unknown_ca" }
    if desc == TLS_ALERT_ACCESS_DENIED                   { return "access_denied" }
    if desc == TLS_ALERT_DECODE_ERROR                    { return "decode_error" }
    if desc == TLS_ALERT_DECRYPT_ERROR                   { return "decrypt_error" }
    if desc == TLS_ALERT_PROTOCOL_VERSION                { return "protocol_version" }
    if desc == TLS_ALERT_INSUFFICIENT_SECURITY           { return "insufficient_security" }
    if desc == TLS_ALERT_INTERNAL_ERROR                  { return "internal_error" }
    if desc == TLS_ALERT_INAPPROPRIATE_FALLBACK          { return "inappropriate_fallback" }
    if desc == TLS_ALERT_USER_CANCELED                   { return "user_canceled" }
    if desc == TLS_ALERT_MISSING_EXTENSION               { return "missing_extension" }
    if desc == TLS_ALERT_UNSUPPORTED_EXTENSION           { return "unsupported_extension" }
    if desc == TLS_ALERT_UNRECOGNIZED_NAME               { return "unrecognized_name" }
    if desc == TLS_ALERT_BAD_CERTIFICATE_STATUS_RESPONSE { return "bad_certificate_status_response" }
    if desc == TLS_ALERT_UNKNOWN_PSK_IDENTITY            { return "unknown_psk_identity" }
    if desc == TLS_ALERT_CERTIFICATE_REQUIRED            { return "certificate_required" }
    if desc == TLS_ALERT_NO_APPLICATION_PROTOCOL         { return "no_application_protocol" }
    return "unknown_alert(" + int_to_str(desc) + ")"
}

fn tls_alert_level_name(level) {
    if level == TLS_ALERT_LEVEL_WARNING { return "warning" }
    if level == TLS_ALERT_LEVEL_FATAL   { return "fatal" }
    return "unknown_level(" + int_to_str(level) + ")"
}
