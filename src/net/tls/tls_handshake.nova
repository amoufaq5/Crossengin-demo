// CrossEngin in-process TLS: handshake message stubs
// (R86, ADR r86-in-process-tls-scaffolding).
//
// TLS 1.3 handshake messages (RFC 8446 §4) all share the same 4-byte
// header:
//   +--------+--------+--------+--------+
//   |  type  |     length (3 bytes)     |
//   +--------+--------+--------+--------+
//
// R86 ships the type enum + a message-struct stub. R93 fills in the
// per-type parsers/serializers. R94 wires them into the record layer.
//
// All symbols are prefixed `tls_handshake_` to avoid NOVA symbol collisions.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/net/tls/tls_record.nova (for the shared
//     TLS_NOT_IMPLEMENTED sentinel).

import "./tls_record.nova"

// ---- handshake types (RFC 8446 §4, appendix B.3) ------------------------

let TLS_HS_CLIENT_HELLO            = 1
let TLS_HS_SERVER_HELLO            = 2
let TLS_HS_NEW_SESSION_TICKET      = 4
let TLS_HS_END_OF_EARLY_DATA       = 5
let TLS_HS_ENCRYPTED_EXTENSIONS    = 8
let TLS_HS_CERTIFICATE             = 11
let TLS_HS_CERTIFICATE_REQUEST     = 13
let TLS_HS_CERTIFICATE_VERIFY      = 15
let TLS_HS_FINISHED                = 20
let TLS_HS_KEY_UPDATE              = 24
let TLS_HS_MESSAGE_HASH            = 254

// ---- message-header + body limits ---------------------------------------

let TLS_HS_HEADER_LEN = 4
// RFC 8446 §4: handshake message body length is a uint24, capped
// implicitly by the record-layer plaintext limit.
let TLS_HS_MAX_BODY_LEN = 16777215

// ---- handshake-message struct -------------------------------------------
//
// A tls_handshake_message is [type, body_bytes]. R93 replaces
// body_bytes with a per-type struct once parsers land; R86 keeps it as
// raw bytes so the scaffold can round-trip a fixed message shape in
// unit tests.

let THM_TYPE = 0
let THM_BODY = 1

fn tls_handshake_message_new(hs_type, body) {
    let m = list_new()
    push(m, hs_type)
    push(m, body)
    return m
}

fn tls_handshake_message_type(m) { return m[THM_TYPE] }
fn tls_handshake_message_body(m) { return m[THM_BODY] }

// ---- type-name (for logs) -----------------------------------------------

fn tls_handshake_type_name(t) {
    if t == TLS_HS_CLIENT_HELLO         { return "client_hello" }
    if t == TLS_HS_SERVER_HELLO         { return "server_hello" }
    if t == TLS_HS_NEW_SESSION_TICKET   { return "new_session_ticket" }
    if t == TLS_HS_END_OF_EARLY_DATA    { return "end_of_early_data" }
    if t == TLS_HS_ENCRYPTED_EXTENSIONS { return "encrypted_extensions" }
    if t == TLS_HS_CERTIFICATE          { return "certificate" }
    if t == TLS_HS_CERTIFICATE_REQUEST  { return "certificate_request" }
    if t == TLS_HS_CERTIFICATE_VERIFY   { return "certificate_verify" }
    if t == TLS_HS_FINISHED             { return "finished" }
    if t == TLS_HS_KEY_UPDATE           { return "key_update" }
    if t == TLS_HS_MESSAGE_HASH         { return "message_hash" }
    return "unknown_handshake(" + int_to_str(t) + ")"
}

fn tls_handshake_type_known(t) {
    if t == TLS_HS_CLIENT_HELLO         { return 1 }
    if t == TLS_HS_SERVER_HELLO         { return 1 }
    if t == TLS_HS_NEW_SESSION_TICKET   { return 1 }
    if t == TLS_HS_END_OF_EARLY_DATA    { return 1 }
    if t == TLS_HS_ENCRYPTED_EXTENSIONS { return 1 }
    if t == TLS_HS_CERTIFICATE          { return 1 }
    if t == TLS_HS_CERTIFICATE_REQUEST  { return 1 }
    if t == TLS_HS_CERTIFICATE_VERIFY   { return 1 }
    if t == TLS_HS_FINISHED             { return 1 }
    if t == TLS_HS_KEY_UPDATE           { return 1 }
    if t == TLS_HS_MESSAGE_HASH         { return 1 }
    return 0
}

// ---- per-type parse / serialize (STUB; R93 fills in) --------------------
//
// Every one of these returns TLS_NOT_IMPLEMENTED for R86. Callers must
// treat that as a wire failure and close (fatal internal_error alert).
// The signatures are chosen to match what R93 will need so R93 doesn't
// have to touch any call site.

fn tls_handshake_parse_client_hello(body) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_serialize_client_hello(msg) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_parse_server_hello(body) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_serialize_server_hello(msg) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_parse_certificate(body) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_serialize_certificate(msg) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_parse_certificate_verify(body) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_serialize_certificate_verify(msg) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_parse_finished(body) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_handshake_serialize_finished(msg) {
    return TLS_NOT_IMPLEMENTED
}
