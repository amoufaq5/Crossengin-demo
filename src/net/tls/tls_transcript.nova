// CrossEngin in-process TLS: handshake-transcript hash rolling (R93).
//
// RFC 8446 §4.4.1: the handshake transcript is the SHA-256 hash of the
// concatenation of every handshake message's wire bytes (with its
// 4-byte type+length header) seen so far. The transcript hash is what
// the CertificateVerify signature is computed over (§4.4.3) and what
// the Finished HMAC is computed over (§4.4.4). The R93 handshake
// state machine (`tls_session.nova`) drives this module: for each
// handshake message it hands the header+body bytes to
// `transcript_absorb`, and at each derivation step it calls
// `transcript_get` to obtain the current 32-byte digest without
// disturbing the streaming state (i.e. more messages can still be
// absorbed after a `get`).
//
// The suite is pinned by the R86 ADR:
//     TLS_CHACHA20_POLY1305_SHA256   -> transcript hash = SHA-256.
//
// Snapshot mechanics
//   `sha256_final` MUTATES the streaming state (compresses the padded
//   tail). We need a snapshot for `transcript_get`: build a shallow
//   copy of the streaming struct, deep-copy the working H[0..7] list
//   and the 64-byte partial buffer, then finalize the copy. The live
//   state is unaffected and further `transcript_absorb` calls compose
//   correctly.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/safety/sha256.nova.

import "../../safety/sha256.nova"

let TLS_TRANSCRIPT_HASH_LEN = 32

// Streaming state layout (mirrors sha256_init's list):
//   [0] working H[0..7]  (list of 8 ints)
//   [1] partial-block buffer (alloc(65))
//   [2] partial_n  (int, bytes in partial buffer)
//   [3] total_n    (int, total bytes absorbed)

// Construct a fresh transcript context. Empty transcript -- until any
// absorb() -- gets a `get()` value equal to SHA-256("").
fn transcript_new() {
    return sha256_init()
}

// Initialize an existing single-element list caller-supplied placeholder.
// Not typical in NOVA style (callers usually just call transcript_new),
// but exposed to mirror the RFC-style API surface names.
fn transcript_init(ctx_out) {
    // ctx_out is a caller-owned empty list; we install the four fields.
    let fresh = sha256_init()
    push(ctx_out, fresh[0])
    push(ctx_out, fresh[1])
    push(ctx_out, fresh[2])
    push(ctx_out, fresh[3])
    return 1
}

// Absorb a byte list into the transcript. Byte lists are what all of
// the handshake serializers produce (see hs_*_serialize in
// tls_handshake.nova). Handles arbitrary length; safe for empty input.
fn transcript_absorb(ctx, byte_list, byte_list_len) {
    if byte_list_len <= 0 { return 1 }
    // Copy the byte list into a raw buffer so sha256_update can walk it.
    // sha256_update accepts a raw pointer + count, which is the shape
    // sha256_init's partial buffer already carries. Alloc a scratch
    // buffer sized for the input.
    let buf = alloc(byte_list_len + 1)
    let i = 0
    while i < byte_list_len {
        store8(buf + i, byte_list[i])
        i = i + 1
    }
    store8(buf + byte_list_len, 0)
    sha256_update(ctx, buf, byte_list_len)
    return 1
}

// Absorb raw bytes (already in a buffer, e.g. the output of
// tls_record_open_buf's plaintext buffer) without copying.
fn transcript_absorb_buf(ctx, buf, n) {
    if n <= 0 { return 1 }
    sha256_update(ctx, buf, n)
    return 1
}

// Deep-copy the H-list (list of 8 ints).
fn _transcript_copy_h(h_src) {
    let h = list_new()
    let i = 0
    while i < 8 {
        push(h, h_src[i])
        i = i + 1
    }
    return h
}

// Deep-copy the streaming state so we can finalize the copy without
// disturbing the live ctx. SHA-256 streaming state layout is fixed
// (see sha256_init); we duplicate every mutable field.
fn _transcript_snapshot(ctx) {
    // Fresh list matching sha256_init shape.
    let snap = list_new()
    // H[0..7] deep copy.
    push(snap, _transcript_copy_h(ctx[0]))
    // Partial buffer: allocate a fresh 65-byte block and copy contents.
    let partial = alloc(65)
    let i = 0
    while i < 64 {
        store8(partial + i, load8(ctx[1] + i))
        i = i + 1
    }
    store8(partial + 64, 0)
    push(snap, partial)
    push(snap, ctx[2])   // partial_n
    push(snap, ctx[3])   // total_n
    return snap
}

// Non-mutating finalize: returns a fresh 32-byte byte list holding
// the current transcript-hash SHA-256 digest. Subsequent absorb()
// calls on ctx continue to compose correctly.
fn transcript_get(ctx) {
    let snap = _transcript_snapshot(ctx)
    let digest_buf = sha256_final(snap)
    let out = list_new()
    let i = 0
    while i < TLS_TRANSCRIPT_HASH_LEN {
        push(out, load8(digest_buf + i))
        i = i + 1
    }
    return out
}

// Convenience: fill a caller-owned buffer with the current digest.
// Useful when the caller wants to hand the digest to a routine that
// wants a raw pointer + length (e.g. tls_kdf_hkdf_expand_label).
// out_buf must be at least TLS_TRANSCRIPT_HASH_LEN bytes.
fn transcript_get_into(ctx, out_buf) {
    let snap = _transcript_snapshot(ctx)
    let digest_buf = sha256_final(snap)
    let i = 0
    while i < TLS_TRANSCRIPT_HASH_LEN {
        store8(out_buf + i, load8(digest_buf + i))
        i = i + 1
    }
    return 1
}

// Total bytes absorbed so far. Diagnostic; RFC 8446 doesn't need it.
fn transcript_total(ctx) {
    return ctx[3]
}
