// CrossEngin in-process TLS: record-layer framing stubs
// (R86, ADR r86-in-process-tls-scaffolding).
//
// The TLS 1.3 record layer wraps a stream of plaintext fragments into
// a stream of "records": {content-type, version, length, fragment}. R86
// ships the header enum (content types) and header-shape stubs. R94
// fills in the AEAD wrap/unwrap under the header.
//
// A record header is EXACTLY 5 bytes on the wire (RFC 8446 §5.1):
//   +--------+--------+--------+--------+--------+
//   | type   | ver_hi | ver_lo |   length (BE)   |
//   +--------+--------+--------+--------+--------+
//
// TLS 1.3 always writes ver = 0x0303 (legacy_record_version) even
// though the negotiated version is 0x0304; the real version rides in
// the ClientHello's supported_versions extension. The scaffold uses
// 0x0303 too.
//
// All symbols are prefixed `tls_record_` to avoid NOVA symbol collisions.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- content types (RFC 8446 §5.1) ---------------------------------------

let TLS_CONTENT_INVALID          = 0
let TLS_CONTENT_CHANGE_CIPHER_SPEC = 20
let TLS_CONTENT_ALERT            = 21
let TLS_CONTENT_HANDSHAKE        = 22
let TLS_CONTENT_APPLICATION_DATA = 23

// ---- version bytes -------------------------------------------------------

let TLS_RECORD_LEGACY_VERSION_HI = 3
let TLS_RECORD_LEGACY_VERSION_LO = 3

// ---- record-header size + limits ----------------------------------------

let TLS_RECORD_HEADER_LEN = 5
// TLSPlaintext.fragment is capped at 2^14 (RFC 8446 §5.1). AEAD-
// encrypted records add at most 256 bytes of overhead + tag; we cap
// the header-reported length at 2^14 + 256 as a defensive ceiling.
let TLS_RECORD_MAX_PLAINTEXT_LEN = 16384
let TLS_RECORD_MAX_CIPHERTEXT_LEN = 16640

// ---- NOT_IMPLEMENTED sentinel -------------------------------------------
//
// Every stub in this module returns this string in place of the real
// bytes/struct it will one day return. Callers pattern-match on it to
// hard-close a connection cleanly instead of proceeding on empty data.
let TLS_NOT_IMPLEMENTED = "TLS_NOT_IMPLEMENTED"

// ---- record-header struct -----------------------------------------------
//
// A tls_record_header is [content_type, version_hi, version_lo, length].
// Fully implementable in R86 because it's a fixed-shape 5-byte parse.

let TRH_TYPE   = 0
let TRH_VER_HI = 1
let TRH_VER_LO = 2
let TRH_LEN    = 3

fn tls_record_header_new(content_type, length) {
    let h = list_new()
    push(h, content_type)
    push(h, TLS_RECORD_LEGACY_VERSION_HI)
    push(h, TLS_RECORD_LEGACY_VERSION_LO)
    push(h, length)
    return h
}

fn tls_record_header_type(h)  { return h[TRH_TYPE] }
fn tls_record_header_ver_hi(h) { return h[TRH_VER_HI] }
fn tls_record_header_ver_lo(h) { return h[TRH_VER_LO] }
fn tls_record_header_length(h) { return h[TRH_LEN] }

// ---- header serialize / parse (fully implemented; no crypto) -----------
//
// Wire form is the 5 bytes documented at the top of this file. The
// header can carry NUL bytes (a length of e.g. 0 or 256 has a NUL in
// either the high or low byte, and content-type 0 -- "invalid" -- is
// itself a NUL byte). So the byte functions use `[buf, len]` pairs the
// same way src/safety/chacha20.nova does. NOVA strings are C-style
// NUL-terminated and cannot round-trip arbitrary 8-bit data.
//
// tls_record_header_bytes_buf(h) -> [buf, len]
// tls_record_header_parse_buf(buf, len) -> hdr or 0

let TLS_RECORD_BUF_PTR = 0
let TLS_RECORD_BUF_LEN = 1

fn tls_record_header_bytes_buf(h) {
    let len_be_hi = h[TRH_LEN] / 256
    let len_be_lo = h[TRH_LEN] - len_be_hi * 256
    let buf = alloc(TLS_RECORD_HEADER_LEN)
    store8(buf + 0, h[TRH_TYPE])
    store8(buf + 1, h[TRH_VER_HI])
    store8(buf + 2, h[TRH_VER_LO])
    store8(buf + 3, len_be_hi)
    store8(buf + 4, len_be_lo)
    let out = list_new()
    push(out, buf)
    push(out, TLS_RECORD_HEADER_LEN)
    return out
}

fn tls_record_content_type_known(t) {
    if t == TLS_CONTENT_CHANGE_CIPHER_SPEC { return 1 }
    if t == TLS_CONTENT_ALERT              { return 1 }
    if t == TLS_CONTENT_HANDSHAKE          { return 1 }
    if t == TLS_CONTENT_APPLICATION_DATA   { return 1 }
    return 0
}

fn tls_record_header_parse_buf(buf, buf_len) {
    if buf_len < TLS_RECORD_HEADER_LEN { return 0 }
    let t  = load8(buf + 0)
    let vh = load8(buf + 1)
    let vl = load8(buf + 2)
    let lh = load8(buf + 3)
    let ll = load8(buf + 4)
    if tls_record_content_type_known(t) == 0 { return 0 }
    let hdr = list_new()
    push(hdr, t)
    push(hdr, vh)
    push(hdr, vl)
    push(hdr, lh * 256 + ll)
    return hdr
}

// ---- content-type name (for logs) ---------------------------------------

fn tls_record_content_name(t) {
    if t == TLS_CONTENT_INVALID          { return "invalid" }
    if t == TLS_CONTENT_CHANGE_CIPHER_SPEC { return "change_cipher_spec" }
    if t == TLS_CONTENT_ALERT            { return "alert" }
    if t == TLS_CONTENT_HANDSHAKE        { return "handshake" }
    if t == TLS_CONTENT_APPLICATION_DATA { return "application_data" }
    return "unknown_content(" + int_to_str(t) + ")"
}

// ---- record-body wrap / unwrap (R94 fills in) ---------------------------
//
// TODO(R94): AEAD encrypt(header, fragment, key_schedule) -> ciphertext.
// Until then callers cannot pass real bytes through the record layer.
fn tls_record_wrap(content_type, fragment, key_schedule) {
    return TLS_NOT_IMPLEMENTED
}

fn tls_record_unwrap(record_bytes, key_schedule) {
    return TLS_NOT_IMPLEMENTED
}
