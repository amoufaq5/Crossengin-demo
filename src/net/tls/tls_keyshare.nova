// CrossEngin in-process TLS: x25519 key-share glue (R89, ADR
// r86-in-process-tls-scaffolding.md).
//
// Purpose
//   RFC 8446 §4.2.8 defines the TLS 1.3 KeyShare extension. Each peer
//   contributes an ephemeral public key for the negotiated group; the
//   shared secret from ECDH becomes the `IKM` fed into HKDF-Extract at
//   the "handshake secret" step of the RFC 8446 §7.1 key schedule.
//
//   R86 pinned x25519 as the only supported group (see the ADR's
//   "Chosen algorithm suite"). R89 lands the primitive; this file
//   is the seam R92 (handshake wire-up) and R93 (wire-hook flip) plug
//   into so neither of those rounds has to touch the field-arithmetic
//   or the ladder.
//
// API
//   tls_keyshare_x25519_public(pub_out, local_scalar)
//     Compute the 32-byte public key = local_scalar * BasePoint.
//     Wraps `x25519_base`. Returns 1.
//
//   tls_keyshare_x25519_shared(shared_out, local_scalar, peer_public)
//     Compute the 32-byte shared secret = local_scalar * peer_public.
//     Applies the RFC 7748 §6.1 all-zero-secret rejection: on a
//     degenerate peer_public (low-order point yielding zero) returns
//     ok = 0 and zeros shared_out; on success returns ok = 1.
//
//   tls_keyshare_derive_handshake_ikm(shared_buf, shared_len,
//                                     early_secret_buf, early_secret_len)
//     Fold the shared secret into the TLS 1.3 handshake IKM per RFC
//     8446 §7.1. The IKM is:
//
//         handshake_secret = HKDF-Extract(
//             Derive-Secret(early_secret, "derived", ""),
//             shared_secret)
//
//     Returns [prk_buf, 32]. This is exactly the input R92's handshake
//     state machine will pass into subsequent Derive-Secret calls
//     ("c hs traffic", "s hs traffic", ..).
//
// RNG dependency (R91 update)
//   The caller-supplied-scalar API below (`tls_keyshare_x25519_public`
//   / `tls_keyshare_x25519_shared`) is kept for tests and for the
//   RFC 7748 §6.1 vector. The wire path takes an `rng_ctx` (from
//   `src/safety/rng.nova`) and pulls the 32-byte private scalar
//   through it -- see `tls_keyshare_generate` and
//   `tls_random_generate` below. R91 landed the RNG interface with
//   three pluggable backends (OS via `secure_random`, TEST-ONLY
//   deterministic ChaCha20-CTR, and caller-supplied callback);
//   which backend is live at handshake time is a deployment choice.
//
// Non-goals for R89
//   - Not producing the TLS 1.3 KeyShareEntry wire bytes (that's R92,
//     which needs the full HandshakeMessage serializer).
//   - Not touching the handshake state machine (`tls_handshake.nova`
//     stubs stay stubbed).
//   - Not flipping `wire_connection_wrap` (that's R93).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/safety/x25519.nova         -- x25519_base / x25519.
//   src/net/tls/tls_kdf.nova       -- tls_kdf_derive_secret.
//   src/safety/hkdf_sha256.nova    -- hkdf_extract.

import "../../safety/x25519.nova"
import "../../safety/hkdf_sha256.nova"
import "../../safety/rng.nova"
import "./tls_kdf.nova"

// ---- key-share size constants -------------------------------------------

let TLS_X25519_SCALAR_LEN = 32
let TLS_X25519_PUBLIC_LEN = 32
let TLS_X25519_SHARED_LEN = 32

// ---- keyshare primitives ------------------------------------------------

// Compute a 32-byte X25519 public key from a 32-byte private scalar.
// Wraps x25519_base (which internally clamps the scalar per RFC 7748).
fn tls_keyshare_x25519_public(pub_out, local_scalar) {
    return x25519_base(pub_out, local_scalar)
}

// Compute the 32-byte X25519 shared secret from local_scalar and the
// peer's 32-byte public key. Returns ok = 1 on success; ok = 0 and a
// zeroed output on the RFC 7748 §6.1 all-zero rejection (peer sent a
// low-order point).
fn tls_keyshare_x25519_shared(shared_out, local_scalar, peer_public) {
    return x25519(shared_out, local_scalar, peer_public)
}

// ---- TLS 1.3 handshake-secret derivation --------------------------------
//
// RFC 8446 §7.1 key schedule, at the transition from "early" to
// "handshake":
//
//     handshake_secret = HKDF-Extract(
//         salt = Derive-Secret(early_secret, "derived", ""),
//         IKM  = shared_secret)
//
// The `Derive-Secret` output is a 32-byte pseudorandom salt. The
// shared_secret is the 32-byte X25519 output. The returned
// handshake_secret is 32 bytes.
//
// Callers provide the early_secret from the previous key-schedule step
// (HKDF-Extract of a zero salt and a PSK -- 32 zero bytes when no PSK
// is in use).

// ---- wire-path: RNG-backed keyshare generation (R91) --------------------
//
// Pull the 32-byte private scalar from an RNG context, then compute
// the public key. This is the entry point the handshake (R93) will
// call at ClientHello / ServerHello time: `rng_ctx` is deployment-
// chosen (OS entropy where available, callback where a sidecar
// supplies bytes, deterministic test RNG only in tests).
//
// On success: writes 32 bytes of private scalar to `priv_out`, writes
// 32 bytes of public key to `pub_out`, returns ok = 1.
// On RNG failure: returns 0. On `x25519_base` all-zero rejection
// (astronomically unlikely from a real RNG but possible with a rigged
// scalar): returns 0 and zeros `pub_out`.
fn tls_keyshare_generate(rng_ctx, priv_out, pub_out) {
    let rok = rng_read(rng_ctx, priv_out, TLS_X25519_SCALAR_LEN)
    if rok != 1 { return 0 }
    let ok = x25519_base(pub_out, priv_out)
    if ok != 1 { return 0 }
    // Defensive all-zero check on the public key. x25519_base doesn't
    // do this itself (only x25519() does, per RFC 7748 §6.1); an all-
    // zero pubkey out of a base multiplication would indicate either a
    // low-order scalar reduced to zero or a primitive bug -- either
    // way, refuse.
    let acc = 0
    let i = 0
    while i < TLS_X25519_PUBLIC_LEN {
        acc = int_or(acc, load8(pub_out + i))
        i = i + 1
    }
    if acc == 0 { return 0 }
    return 1
}

// Generic random-bytes helper for handshake nonces (ClientHello.random,
// ServerHello.random, session-ticket nonces, ...). Thin wrapper around
// `rng_read` with a shape sanity check (out_len must be > 0 and within
// TLS_RANDOM_MAX so a caller confused about a signed length can't hang
// the process). Returns 1 on success, 0 on RNG failure or bad length.
let TLS_RANDOM_MAX = 1024

fn tls_random_generate(rng_ctx, out_buf, out_len) {
    if out_len <= 0 { return 0 }
    if out_len > TLS_RANDOM_MAX { return 0 }
    return rng_read(rng_ctx, out_buf, out_len)
}

fn tls_keyshare_derive_handshake_secret(shared_buf, shared_len,
                                        early_secret_buf, early_secret_len) {
    // salt = Derive-Secret(early_secret, "derived", "")
    let derived_label = alloc(8)
    store8(derived_label + 0, 100)   // 'd'
    store8(derived_label + 1, 101)   // 'e'
    store8(derived_label + 2, 114)   // 'r'
    store8(derived_label + 3, 105)   // 'i'
    store8(derived_label + 4, 118)   // 'v'
    store8(derived_label + 5, 101)   // 'e'
    store8(derived_label + 6, 100)   // 'd'
    store8(derived_label + 7, 0)
    // "" transcript -> SHA-256("") is the empty-message hash; the
    // Derive-Secret wrapper handles that path (messages_len == 0).
    let salt_pair = tls_kdf_derive_secret(early_secret_buf, early_secret_len,
                                          derived_label, 7,
                                          0, 0)
    // handshake_secret = HKDF-Extract(salt, shared_secret). hkdf_extract
    // returns a raw 33-byte buffer (32B hash + NUL); wrap it in the
    // [buf, len] shape callers expect for uniform TLS-KDF plumbing.
    let prk = hkdf_extract(salt_pair[0], salt_pair[1],
                           shared_buf, shared_len)
    let out = list_new()
    push(out, prk)
    push(out, 32)
    return out
}
