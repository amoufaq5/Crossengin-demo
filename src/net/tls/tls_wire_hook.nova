// CrossEngin in-process TLS: wire integration seam
// (R86, ADR r86-in-process-tls-scaffolding).
//
// The ONE call site the daemon's accept loop needs to know about. Given
// a raw fd from accept_conn() and a tls_config (or 0 for "not
// configured"), returns a "wrapped connection" the daemon can read /
// write / close through.
//
// R86 behavior (all that ships today):
//   * tls_config == 0                       -> return raw fd unchanged.
//   * tls_config != 0                       -> return raw fd unchanged
//                                              AND print a warning
//                                              (never happens today
//                                              because nothing passes a
//                                              non-null tls_config).
//
// R87..R94 behavior (planned, DOES NOT ship in R86):
//   * tls_config == 0                       -> return raw fd unchanged.
//   * tls_config != 0                       -> perform TLS 1.3
//                                              handshake, return a
//                                              wrapped_conn struct that
//                                              encrypts on write and
//                                              decrypts on read. R94 is
//                                              the first round where
//                                              this branch does real
//                                              work.
//
// The wrapped_conn abstraction is deliberately thin: the daemon only
// needs read / write / close, so R94 will introduce three thin
// wrappers: wire_conn_read / wire_conn_write / wire_conn_close that
// dispatch on whether the underlying handle is a raw fd (int) or a
// TLS-wrapped connection (struct). Today the daemon still calls
// recv_data / send_data / close_fd directly on the raw fd because the
// hook returns the fd unchanged.
//
// Symbols prefixed `tls_wire_` to avoid NOVA symbol collisions.
//
// NOVA dependencies: builtins (println).
// CrossEngin dependencies: src/net/tls/tls_config.nova.

import "./tls_config.nova"

// A sentinel struct so R94's wrapped_conn cannot be confused with a raw
// fd (which is a plain integer). R86 does not construct this; it exists
// to nail down the shape R87..R94 will fill.
//
// Layout: [WIRE_CONN_TAG_TLS, fd, tls_config, state_ctx].
let TLS_WIRE_CONN_TAG_RAW = 0
let TLS_WIRE_CONN_TAG_TLS = 1

// wire_connection_wrap: given a raw fd from accept_conn and a
// tls_config (0 for "no TLS"), return the handle the daemon should
// read/write/close through.
//
// TODAY:  returns fd unchanged (a plain int). The daemon's existing
//         recv_data(fd, ...) / send_data(fd, ...) / close_fd(fd)
//         calls keep working byte-identically.
// R94+:   returns a wrapped_conn struct when tls_config is non-null;
//         the daemon MUST switch to wire_conn_read / wire_conn_write /
//         wire_conn_close (also in this module) to dispatch. Until
//         R94 lands, this hook is a pass-through.
//
// Passing a non-null tls_config today emits a one-line stderr warning
// and STILL returns the raw fd (fail-open in the direction of "no
// crypto happened"). Once R94 ships the flip is: non-null config
// engages TLS, null config keeps pass-through.
fn wire_connection_wrap(fd, tls_config) {
    if tls_config == 0 { return fd }
    // Non-null config: R86 does NOT know how to negotiate TLS. Warn
    // loudly and return the raw fd so the caller doesn't send
    // ciphertext-shaped bytes over a still-cleartext socket. Once R94
    // lands this branch actually engages the handshake and returns a
    // wrapped_conn struct.
    println("WARN tls: wire_connection_wrap called with a non-null"
        + " tls_config; R86 scaffolding does not perform TLS."
        + " Returning raw fd. See ADR r86-in-process-tls-scaffolding.")
    return fd
}

// Convenience: is this handle a raw fd or a TLS-wrapped conn? R86 only
// ever gets raw fds so this always returns TLS_WIRE_CONN_TAG_RAW; R94
// will start returning TLS_WIRE_CONN_TAG_TLS for TLS-wrapped handles.
fn wire_conn_tag(handle) {
    // A raw fd is a plain integer; NOVA does not distinguish that from
    // a struct at the type level, but a wrapped_conn is a list whose
    // first element is TLS_WIRE_CONN_TAG_TLS. We detect that shape.
    // For R86, no wrapped_conn is ever constructed, so this always
    // returns RAW.
    return TLS_WIRE_CONN_TAG_RAW
}
