// CrossEngin substrate: part registry.
//
// Purpose
//   A "part" is a named region of the substrate that owns its own node pool,
//   synapse graph, and first-node block (ADR-0001). v1 has seven fixed parts --
//   perception, episodic, soul, reasoning, imagination, action, meta -- plus
//   knowledge-graph parts spawned per domain at runtime (part_lifecycle.nova).
//   The registry assigns each part a stable integer id and indexes parts by id
//   and by name. Part ids are stable for the lifetime of the process and are
//   the anchor for cross-part routing (gates) and persistence (ADR-0048).
//
// ADRs implemented: ADR-0001 (parts as substrate regions, the v1 part set),
//   ADR-0002 (a KG part is a domain-organized knowledge store atop a part).
//   Depends-on note: 1M nodes per part is NOVA enhancement #1; the registry is
//   correct at any per-part capacity now.
// NOVA dependencies: builtins (lists, maps).
// CrossEngin dependencies: src/substrate/node_pool_manager.nova,
//   src/substrate/synapse_graph.nova, src/substrate/first_nodes.nova.

import "synapse_graph.nova"
import "first_nodes.nova"

// ---- part layout ----------------------------------------------------------
let PART_TAG    = 0
let PART_ID     = 1
let PART_NAME   = 2
let PART_PRESET = 3   // one of FN_PRESET_* (the part's kind/modality)
let PART_POOL   = 4
let PART_SYN    = 5
let PART_FIRST  = 6   // first-node block: list of node ids
let PART_CAP    = 7
let PART_ALIVE  = 8
let PART_OBJ_TAG = 880

// ---- registry layout ------------------------------------------------------
// Parts are stored in a list indexed by part id. Name lookup is a linear scan
// (part counts are modest, and NOVA's builtin map has a hard 16-key cap -- see
// NEXT_SESSION.md NOVA blockers), so there is no separate name index.
let REG_TAG     = 0
let REG_PARTS   = 1   // list of parts, indexed by part id
let REG_NEXT_ID = 2
let REG_OBJ_TAG = 881

fn part_registry_new() {
    let reg = list_new()
    push(reg, REG_OBJ_TAG)
    push(reg, list_new())
    push(reg, 0)
    return reg
}

fn _part_build(id, name, preset, node_capacity, first_count) {
    let pool = npm_pool_new(node_capacity)
    let syn = syn_graph_new()
    let block = fn_reserve_block_for_preset(pool, first_count, preset)
    let p = list_new()
    push(p, PART_OBJ_TAG)
    push(p, id)
    push(p, name)
    push(p, preset)
    push(p, pool)
    push(p, syn)
    push(p, block)
    push(p, node_capacity)
    push(p, 1)
    return p
}

// Add a part. Names are unique: adding an existing name returns its id without
// creating a duplicate (idempotent). Returns the part id.
fn registry_add(reg, name, preset, node_capacity, first_count) {
    let existing = registry_find(reg, name)
    if existing != -1 {
        return existing
    }
    let id = reg[REG_NEXT_ID]
    let p = _part_build(id, name, preset, node_capacity, first_count)
    push(reg[REG_PARTS], p)
    list_set(reg, REG_NEXT_ID, id + 1)
    return id
}

// Spawn the seven fixed v1 parts in stable order (ids 0..6). Returns the count.
fn registry_spawn_fixed(reg, node_capacity, first_count) {
    registry_add(reg, "perception",  FN_PRESET_PERCEPTION,  node_capacity, first_count)
    registry_add(reg, "episodic",    FN_PRESET_EPISODIC,    node_capacity, first_count)
    registry_add(reg, "soul",        FN_PRESET_SOUL,        node_capacity, first_count)
    registry_add(reg, "reasoning",   FN_PRESET_REASONING,   node_capacity, first_count)
    registry_add(reg, "imagination", FN_PRESET_IMAGINATION, node_capacity, first_count)
    registry_add(reg, "action",      FN_PRESET_ACTION,      node_capacity, first_count)
    registry_add(reg, "meta",        FN_PRESET_META,        node_capacity, first_count)
    return 7
}

fn registry_count(reg) { return len(reg[REG_PARTS]) }

fn registry_find(reg, name) {
    let parts = reg[REG_PARTS]
    let i = 0
    while i < len(parts) {
        if str_eq(parts[i][PART_NAME], name) == 1 {
            return parts[i][PART_ID]
        }
        i = i + 1
    }
    return -1
}

fn _reg_valid_id(reg, id) {
    if id < 0 { return 0 }
    if id >= len(reg[REG_PARTS]) { return 0 }
    return 1
}

// Returns the part with the given id, or 0 if none.
fn registry_get(reg, id) {
    if _reg_valid_id(reg, id) == 0 { return 0 }
    return reg[REG_PARTS][id]
}

fn registry_ids(reg) {
    let ids = list_new()
    let i = 0
    while i < len(reg[REG_PARTS]) {
        push(ids, i)
        i = i + 1
    }
    return ids
}

fn registry_live_count(reg) {
    let n = 0
    let i = 0
    while i < len(reg[REG_PARTS]) {
        if reg[REG_PARTS][i][PART_ALIVE] == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}

// ---- part accessors -------------------------------------------------------
fn part_id(p)        { return p[PART_ID] }
fn part_name(p)      { return p[PART_NAME] }
fn part_preset(p)    { return p[PART_PRESET] }
fn part_pool(p)      { return p[PART_POOL] }
fn part_syn(p)       { return p[PART_SYN] }
fn part_first(p)     { return p[PART_FIRST] }
fn part_capacity(p)  { return p[PART_CAP] }
fn part_is_alive(p)  { return p[PART_ALIVE] }
fn part_first_count(p) { return len(p[PART_FIRST]) }

// Live (claimed) node count within a part.
fn part_node_count(p) { return npm_live_count(p[PART_POOL]) }

// Inject (broadcast) a stimulus across a part's first-node block (ADR-0010).
fn part_inject(reg, id, strength) {
    let p = registry_get(reg, id)
    if p == 0 { return 0 }
    return fn_inject(p[PART_POOL], p[PART_FIRST], strength)
}
