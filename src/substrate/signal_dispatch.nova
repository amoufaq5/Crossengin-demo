// CrossEngin substrate: signal taxonomy and priority dispatch.
//
// Purpose
//   Defines the 18 signal types that flow through the substrate and a
//   priority-ordered dispatch queue. Signals are ephemeral typed messages
//   (ADR-0002); the type space and priorities are fixed by ADR-0008.
//
// Signal layout (list). The ADR-0008 core is [type, priority, trace, metadata];
//   the substrate adds the carrier fields needed to actually propagate a signal
//   between nodes (source, destination, strength):
//     [0] SIG_TYPE      one of the 18 XSIG_* ids (1..18)
//     [1] SIG_PRIORITY  0..9; seeded from the type, may be boosted by XSIG_ATTEND
//     [2] SIG_SRC       source node id (-1 if exogenous, e.g. a moment)
//     [3] SIG_DST       destination node id (-1 if unrouted / to be gated)
//     [4] SIG_STRENGTH  milli-fixed-point payload (activation carried)
//     [5] SIG_TRACE     provenance tag (originating part id; 0 if none)
//     [6] SIG_META      type-specific metadata (error magnitude, bind group, ...)
//
// Dispatch ordering (ADR-0008): higher priority is processed first, so safety
//   and surprise outrun routine excitation:
//     XSIG_CONST(9) > XSIG_ERROR(7) > XSIG_INHIBIT/ATTEND/GOAL/REWARD(6) > ...
//   Within a priority level, delivery is FIFO. The bucketed queue makes this an
//   O(10) pop, modelling the typed fast-dispatch table of NOVA enhancement #6.
//
// ADRs implemented: ADR-0002 (SIGNAL primitive), ADR-0008 (18-type taxonomy and
//   priority ordering). Depends-on note: NOVA enhancement #6 (typed
//   fast-dispatch at 1B signals/part) is a scale optimization; the semantics
//   here are complete now.
// NOVA dependencies: builtins only (lists, len, list_set) + the shared
//   list_safe workaround for NOVA's list_remove tagging quirk (see
//   src/util/list_safe.nova). The direct list_remove call in sigq_pop was
//   silently broken for buckets holding >=2 signals -- removed index 1
//   instead of index 0, so FIFO order within a priority was violated.
// CrossEngin dependencies: src/util/list_safe.nova.

import "../util/list_safe.nova"

// ---- the 18 signal types (ADR-0008) --------------------------------------
let XSIG_EXCITE    = 1
let XSIG_INHIBIT   = 2
let XSIG_SENSORY   = 3
let XSIG_PREDICT   = 4
let XSIG_ERROR     = 5
let XSIG_CAUSAL    = 6
let XSIG_IMPLY     = 7
let XSIG_ANALOGY   = 8
let XSIG_EVIDENCE  = 9
let XSIG_ATTEND    = 10
let XSIG_BIND      = 11
let XSIG_VALENCE   = 12
let XSIG_AROUSAL   = 13
let XSIG_CURIOSITY = 14
let XSIG_GOAL      = 15
let XSIG_REWARD    = 16
let XSIG_RECALL    = 17
let XSIG_CONST     = 18

let XSIG_MIN = 1
let XSIG_MAX = 18

// ---- signal field offsets -------------------------------------------------
let SIG_TYPE     = 0
let SIG_PRIORITY = 1
let SIG_SRC      = 2
let SIG_DST      = 3
let SIG_STRENGTH = 4
let SIG_TRACE    = 5
let SIG_META     = 6
let SIG_FIELDS   = 7

// Priority of each signal type (0 lowest .. 9 highest), per ADR-0008.
fn xsig_priority(stype) {
    if stype == XSIG_CONST     { return 9 }
    if stype == XSIG_ERROR     { return 7 }
    if stype == XSIG_INHIBIT   { return 6 }
    if stype == XSIG_ATTEND    { return 6 }
    if stype == XSIG_GOAL      { return 6 }
    if stype == XSIG_REWARD    { return 6 }
    if stype == XSIG_SENSORY   { return 5 }
    if stype == XSIG_PREDICT   { return 5 }
    if stype == XSIG_EVIDENCE  { return 5 }
    if stype == XSIG_BIND      { return 5 }
    if stype == XSIG_AROUSAL   { return 5 }
    if stype == XSIG_EXCITE    { return 4 }
    if stype == XSIG_CAUSAL    { return 4 }
    if stype == XSIG_IMPLY     { return 4 }
    if stype == XSIG_VALENCE   { return 4 }
    if stype == XSIG_RECALL    { return 4 }
    if stype == XSIG_ANALOGY   { return 3 }
    if stype == XSIG_CURIOSITY { return 3 }
    return 0
}

fn xsig_valid(stype) {
    if stype < XSIG_MIN { return 0 }
    if stype > XSIG_MAX { return 0 }
    return 1
}

// Constitutional signals (ADR-0045) are privileged: highest priority, and the
// gate router must never down-weight or prune their routes.
fn xsig_is_constitutional(stype) {
    if stype == XSIG_CONST { return 1 }
    return 0
}

fn xsig_name(stype) {
    if stype == XSIG_EXCITE    { return "EXCITE" }
    if stype == XSIG_INHIBIT   { return "INHIBIT" }
    if stype == XSIG_SENSORY   { return "SENSORY" }
    if stype == XSIG_PREDICT   { return "PREDICT" }
    if stype == XSIG_ERROR     { return "ERROR" }
    if stype == XSIG_CAUSAL    { return "CAUSAL" }
    if stype == XSIG_IMPLY     { return "IMPLY" }
    if stype == XSIG_ANALOGY   { return "ANALOGY" }
    if stype == XSIG_EVIDENCE  { return "EVIDENCE" }
    if stype == XSIG_ATTEND    { return "ATTEND" }
    if stype == XSIG_BIND      { return "BIND" }
    if stype == XSIG_VALENCE   { return "VALENCE" }
    if stype == XSIG_AROUSAL   { return "AROUSAL" }
    if stype == XSIG_CURIOSITY { return "CURIOSITY" }
    if stype == XSIG_GOAL      { return "GOAL" }
    if stype == XSIG_REWARD    { return "REWARD" }
    if stype == XSIG_RECALL    { return "RECALL" }
    if stype == XSIG_CONST     { return "CONST" }
    return "INVALID"
}

// Construct a signal. Priority is seeded from the type. An invalid type yields
// a type-0 signal at priority 0 (callers can detect via xsig_valid / sig_type).
fn sig_new(stype, src, dst, strength, trace, meta) {
    let s = list_new()
    let t = stype
    if xsig_valid(t) == 0 { t = 0 }
    push(s, t)
    if t == 0 { push(s, 0) } else { push(s, xsig_priority(t)) }
    push(s, src)
    push(s, dst)
    push(s, strength)
    push(s, trace)
    push(s, meta)
    return s
}

// Common excitation/inhibition carriers between two nodes.
fn sig_excite(src, dst, strength)  { return sig_new(XSIG_EXCITE, src, dst, strength, 0, 0) }
fn sig_inhibit(src, dst, strength) { return sig_new(XSIG_INHIBIT, src, dst, strength, 0, 0) }

// Accessors.
fn sig_type(s)     { return s[SIG_TYPE] }
fn sig_priority(s) { return s[SIG_PRIORITY] }
fn sig_src(s)      { return s[SIG_SRC] }
fn sig_dst(s)      { return s[SIG_DST] }
fn sig_strength(s) { return s[SIG_STRENGTH] }
fn sig_trace(s)    { return s[SIG_TRACE] }
fn sig_meta(s)     { return s[SIG_META] }

fn sig_set_dst(s, dst)         { list_set(s, SIG_DST, dst) }
fn sig_set_strength(s, v)      { list_set(s, SIG_STRENGTH, v) }

// XSIG_ATTEND raises the salience (priority) of a signal, but never above the
// constitutional ceiling (8): a non-constitutional signal cannot reach 9.
fn sig_boost_priority(s, amount) {
    if sig_type(s) == XSIG_CONST { return 9 }
    let p = s[SIG_PRIORITY] + amount
    if p > 8 { p = 8 }
    if p < 0 { p = 0 }
    list_set(s, SIG_PRIORITY, p)
    return p
}

// Signed contribution this signal makes to a destination node's inbox:
// inhibition subtracts, everything else adds.
fn sig_inbox_delta(s) {
    if sig_type(s) == XSIG_INHIBIT { return 0 - sig_strength(s) }
    return sig_strength(s)
}

// ---- priority dispatch queue ---------------------------------------------
// Ten FIFO buckets indexed by priority 0..9.
let SIGQ_LEVELS = 10

fn sigq_new() {
    let q = list_new()
    let i = 0
    while i < SIGQ_LEVELS {
        push(q, list_new())
        i = i + 1
    }
    return q
}

fn sigq_push(q, s) {
    let p = sig_priority(s)
    if p < 0 { p = 0 }
    if p > 9 { p = 9 }
    let bucket = q[p]
    push(bucket, s)
    return 1
}

fn sigq_size(q) {
    let total = 0
    let i = 0
    while i < SIGQ_LEVELS {
        total = total + len(q[i])
        i = i + 1
    }
    return total
}

fn sigq_is_empty(q) {
    if sigq_size(q) == 0 { return 1 }
    return 0
}

// Remove and return the highest-priority, oldest signal. Returns 0 if empty.
fn sigq_pop(q) {
    let p = 9
    while p >= 0 {
        let bucket = q[p]
        if len(bucket) > 0 {
            let s = bucket[0]
            list_remove_at(bucket, 0)
            return s
        }
        p = p - 1
    }
    return 0
}
