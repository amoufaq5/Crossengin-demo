// CrossEngin substrate: first nodes.
//
// Purpose
//   Each part reserves a stable block of nodes at the front of its pool -- the
//   first-node block (ADR-0010). These are ordinary nodes running the identical
//   kernel (ADR-0006); they are "first" only by (a) a stable, well-known index
//   range [0, count), (b) a per-part modality preset (affinity hint + the
//   signal types they expect), and (c) richer initial fan-out into the part.
//   They are the canonical bottom of the predictive-coding hierarchy and the
//   delivery point for gate-routed input (part_inject via broadcast).
//
//   Because the node pool hands out ids 0,1,2,... in order, reserving the block
//   on a fresh pool yields exactly indices [0, count) -- the range that must
//   stay stable across restarts for persistence (ADR-0048).
//
//   This module also owns the part-kind / modality preset taxonomy, so that
//   part_registry can depend on it without a cycle.
//
// ADRs implemented: ADR-0010 (first nodes), ADR-0006 (same uniform kernel).
//   Depends-on note: a 1024-wide block per 1M-node part is NOVA enhancement #1
//   (arena scale); the mechanism here is correct at any configured width.
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/substrate/node_pool_manager.nova,
//   src/substrate/signal_dispatch.nova.

import "node_pool_manager.nova"
import "signal_dispatch.nova"

// Functional default; production parts use ~1024 (ADR-0010), bounded by pool
// capacity and NOVA enhancement #1.
let FN_DEFAULT_FIRST_COUNT = 16

// Part-kind / modality presets (also used as part "kind" by part_registry).
let FN_PRESET_PERCEPTION  = 1
let FN_PRESET_EPISODIC    = 2
let FN_PRESET_SOUL        = 3
let FN_PRESET_REASONING   = 4
let FN_PRESET_IMAGINATION = 5
let FN_PRESET_ACTION      = 6
let FN_PRESET_META        = 7
let FN_PRESET_KG          = 8

// The NTYPE affinity hint for a preset's first nodes (ADR-0006: hint only).
fn fn_preset_ntype(preset) {
    if preset == FN_PRESET_PERCEPTION  { return NTYPE_PERCEIVER }
    if preset == FN_PRESET_EPISODIC    { return NTYPE_REMEMBERER }
    if preset == FN_PRESET_SOUL        { return NTYPE_FEELER }
    if preset == FN_PRESET_REASONING   { return NTYPE_REASONER }
    if preset == FN_PRESET_IMAGINATION { return NTYPE_REASONER }
    if preset == FN_PRESET_ACTION      { return NTYPE_ACTOR }
    if preset == FN_PRESET_META        { return NTYPE_REASONER }
    if preset == FN_PRESET_KG          { return NTYPE_KNOWER }
    return NTYPE_KNOWER
}

// The signal types a preset's first nodes expect, used to seed gate routes and
// initial fan-out (ADR-0010 input table).
fn fn_preset_input_types(preset) {
    let types = list_new()
    if preset == FN_PRESET_PERCEPTION {
        push(types, XSIG_SENSORY)
    } else if preset == FN_PRESET_REASONING {
        push(types, XSIG_GOAL)
        push(types, XSIG_CAUSAL)
        push(types, XSIG_IMPLY)
    } else if preset == FN_PRESET_EPISODIC {
        push(types, XSIG_RECALL)
    } else if preset == FN_PRESET_SOUL {
        push(types, XSIG_VALENCE)
        push(types, XSIG_AROUSAL)
        push(types, XSIG_CONST)
    } else if preset == FN_PRESET_META {
        push(types, XSIG_VALENCE)
        push(types, XSIG_AROUSAL)
        push(types, XSIG_CONST)
    } else if preset == FN_PRESET_IMAGINATION {
        push(types, XSIG_PREDICT)
    } else if preset == FN_PRESET_ACTION {
        push(types, XSIG_GOAL)
    } else {
        // KG parts: knowledge relation signals.
        push(types, XSIG_CAUSAL)
        push(types, XSIG_IMPLY)
        push(types, XSIG_EVIDENCE)
    }
    return types
}

fn fn_preset_name(preset) {
    if preset == FN_PRESET_PERCEPTION  { return "perception" }
    if preset == FN_PRESET_EPISODIC    { return "episodic" }
    if preset == FN_PRESET_SOUL        { return "soul" }
    if preset == FN_PRESET_REASONING   { return "reasoning" }
    if preset == FN_PRESET_IMAGINATION { return "imagination" }
    if preset == FN_PRESET_ACTION      { return "action" }
    if preset == FN_PRESET_META        { return "meta" }
    if preset == FN_PRESET_KG          { return "kg" }
    return "unknown"
}

// Reserve a first-node block of `count` nodes with affinity `ntype` on a fresh
// pool. Returns the list of reserved ids; on a fresh pool that is [0, count).
// Stops early (returning a shorter block) if the pool runs out of capacity.
fn fn_reserve_block(pool, count, ntype) {
    let block = list_new()
    let i = 0
    while i < count {
        let id = npm_node_create_default(pool, ntype)
        if id == -1 {
            return block
        }
        push(block, id)
        i = i + 1
    }
    return block
}

// Reserve a first-node block configured for a part preset.
fn fn_reserve_block_for_preset(pool, count, preset) {
    return fn_reserve_block(pool, count, fn_preset_ntype(preset))
}

// The canonical id range of a block of the given width: [0, count).
fn fn_block_ids(count) {
    let ids = list_new()
    let i = 0
    while i < count {
        push(ids, i)
        i = i + 1
    }
    return ids
}

fn fn_is_first_node(id, count) {
    if id < 0 { return 0 }
    if id < count { return 1 }
    return 0
}

// Inject (broadcast) an input strength across every node in a block. Models
// part_inject over CHAN_BROADCAST (ADR-0010). Returns how many nodes received.
fn fn_inject(pool, block, strength) {
    let delivered = 0
    let i = 0
    while i < len(block) {
        if npm_node_input(pool, block[i], strength) == 1 {
            delivered = delivered + 1
        }
        i = i + 1
    }
    return delivered
}

// Inject into a single first node (direct delivery).
fn fn_inject_one(pool, block, slot, strength) {
    if slot < 0 { return 0 }
    if slot >= len(block) { return 0 }
    return npm_node_input(pool, block[slot], strength)
}
