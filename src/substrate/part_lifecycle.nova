// CrossEngin substrate: part lifecycle.
//
// Purpose
//   Manages the dynamic knowledge-graph parts that CrossEngin spawns per domain
//   at runtime (ADR-0001). The seven fixed parts are permanent; KG parts are
//   created on demand (e.g. "kg-medicine"), can be retired to an inactive state
//   when a domain falls dormant, and revived later with their substrate intact.
//   Retirement is reversible and preserves the part's nodes and synapses so they
//   can be snapshotted (ADR-0048) or revived; physical memory reclaim of a
//   permanently removed part is NOVA enhancement #10.
//
// ADRs implemented: ADR-0001 (dynamic KG parts spawned per domain).
// NOVA dependencies: builtins (strings: substr, len, starts_with).
// CrossEngin dependencies: src/substrate/part_registry.nova.

import "part_registry.nova"

// Canonical name of the KG part for a domain.
fn pl_kg_name(domain) {
    return "kg-" + domain
}

fn pl_is_kg(part) {
    if part == 0 { return 0 }
    if part_preset(part) == FN_PRESET_KG { return 1 }
    return 0
}

// Domain string for a KG part ("kg-medicine" -> "medicine"); "" if not a KG part.
fn pl_kg_domain(part) {
    if pl_is_kg(part) == 0 { return "" }
    let name = part_name(part)
    if starts_with(name, "kg-") == 0 { return name }
    return substr(name, 3, len(name) - 3)
}

// Spawn (or revive, or return) the KG part for a domain. Returns its part id.
//   - new domain: creates a KG part.
//   - dormant (retired) domain: revives it, preserving its substrate.
//   - already-active domain: returns the existing id unchanged.
fn pl_spawn_kg(reg, domain, node_capacity, first_count) {
    let name = pl_kg_name(domain)
    let existing = registry_find(reg, name)
    if existing != -1 {
        let part = registry_get(reg, existing)
        if part_is_alive(part) == 0 {
            list_set(part, PART_ALIVE, 1)
        }
        return existing
    }
    return registry_add(reg, name, FN_PRESET_KG, node_capacity, first_count)
}

// Retire a KG part to the inactive state. Fixed parts cannot be retired.
// Returns 1 if retired, 0 otherwise (unknown id or fixed part).
fn pl_retire(reg, part_id) {
    let part = registry_get(reg, part_id)
    if part == 0 { return 0 }
    if pl_is_kg(part) == 0 { return 0 }
    if part_is_alive(part) == 0 { return 0 }
    list_set(part, PART_ALIVE, 0)
    return 1
}

fn pl_is_active(reg, part_id) {
    let part = registry_get(reg, part_id)
    if part == 0 { return 0 }
    return part_is_alive(part)
}

// Active KG part ids.
fn pl_list_active_kg(reg) {
    let result = list_new()
    let ids = registry_ids(reg)
    let i = 0
    while i < len(ids) {
        let part = registry_get(reg, ids[i])
        if pl_is_kg(part) == 1 {
            if part_is_alive(part) == 1 {
                push(result, ids[i])
            }
        }
        i = i + 1
    }
    return result
}

fn pl_active_count(reg) {
    return registry_live_count(reg)
}
