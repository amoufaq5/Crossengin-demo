// CrossEngin substrate: synapse graph.
//
// Purpose
//   Persistent weighted connections between nodes, stored as the parallel typed
//   arrays of ADR-0007 (pre, post, weight, eligibility, last_active_tick,
//   sig_type_mask, alive), with a source-keyed adjacency index modelling the
//   CSR-by-source layout. Implements the fused Hebbian + error-driven plasticity
//   rule, eligibility decay, synapse growth, and idle pruning with slot reclaim.
//
// Plasticity (ADR-0007): per active synapse,
//     dw_hebb = eta_h * pre_act * post_act
//     dw_err  = eta_e * pre_act * error_signal
//     dw      = modulator * (dw_hebb + dw_err)      (modulator from ADR-0035)
//     weight  = clamp(weight + dw, W_MIN, W_MAX)
//   Weight sign carries excitatory (+) vs inhibitory (-) intent (ADR-0008).
//   Eligibility is a co-activation trace that decays each step; a synapse whose
//   |weight| and eligibility both stay below the death thresholds is pruned and
//   its slot reclaimed via a free list.
//
//   Growth: the substrate exposes the mechanism (grow a pre->post synapse if
//   absent). The policy that triggers it -- N ticks of unconnected
//   co-activation -- lives in the learning fabric (ADR-0025, a later phase).
//
// ADRs implemented: ADR-0002 (SYNAPSE primitive), ADR-0007 (synapse design).
//   Depends-on notes: NOVA enhancement #2 (true CSR sparse adjacency with O(1)
//   reclaim at 1M-node scale) and #12 (batched plasticity kernels) are scale /
//   performance upgrades; the semantics here are complete now.
// NOVA dependencies: builtins (lists, maps, len, list_remove, int_to_str).
// CrossEngin dependencies: src/substrate/node_pool_manager.nova (FP_SCALE,
//   fp_mul, fp_clamp, milli-fixed-point convention).

import "node_pool_manager.nova"
import "../util/list_safe.nova"

// ---- weight bounds and plasticity tuning (milli units) --------------------
let W_MIN = -1000   // -1.0  (fully inhibitory)
let W_MAX = 1000    //  1.0  (fully excitatory)
let SYN_ETA_H = 20      // 0.02 Hebbian learning rate
let SYN_ETA_E = 30      // 0.03 error-driven learning rate
let SYN_ELIG_DECAY = 900    // 0.9 eligibility retention per step
let SYN_ELIG_CEIL = 1000    // 1.0 eligibility ceiling
let SYN_DEATH_W = 20    // |weight| below 0.02 ...
let SYN_DEATH_ELIG = 10 // ... and eligibility below 0.01 -> prunable

// ---- graph layout ---------------------------------------------------------
let SG_TAG   = 0
let SG_PRE   = 1
let SG_POST  = 2
let SG_W     = 3
let SG_ELIG  = 4
let SG_LAST  = 5
let SG_MASK  = 6
let SG_ALIVE = 7
let SG_ADJ   = 8    // adjacency: list indexed by src node id -> list of syn idx
let SG_LIVE  = 9    // live synapse count
let SG_FREE  = 10   // free list of reclaimed (dead) indices
let SG_GRAPH_TAG = 770

// Adjacency is a CSR-by-source index (ADR-0007): a list indexed by source node
// id, each slot holding the list of that node's outgoing synapse indices. We
// index by id rather than hashing because (a) it matches the ADR's contiguous
// per-source layout and (b) NOVA's builtin map has a hard 16-key capacity --
// see NEXT_SESSION.md (NOVA blockers).

fn syn_graph_new() {
    let g = list_new()
    push(g, SG_GRAPH_TAG)
    push(g, list_new())   // pre
    push(g, list_new())   // post
    push(g, list_new())   // weight
    push(g, list_new())   // elig
    push(g, list_new())   // last
    push(g, list_new())   // mask
    push(g, list_new())   // alive
    push(g, list_new())   // adjacency (indexed by src id)
    push(g, 0)            // live
    push(g, list_new())   // free
    return g
}

// ---- signal-type masks ----------------------------------------------------
// A synapse carries a subset of the 18 signal types; bit (stype-1) marks type.
fn syn_mask_bit(stype) {
    if stype < 1 { return 0 }
    let bit = 1
    let i = 1
    while i < stype {
        bit = bit * 2
        i = i + 1
    }
    return bit
}

fn syn_mask_add(mask, stype) { return mask | syn_mask_bit(stype) }
fn syn_mask_has(mask, stype) {
    if (mask & syn_mask_bit(stype)) != 0 { return 1 }
    return 0
}

// Return the (mutable) outgoing-index list for src, growing the adjacency
// index with empty slots as needed.
fn _syn_adj_get(g, src) {
    let adj = g[SG_ADJ]
    while len(adj) <= src {
        push(adj, 0)
    }
    if adj[src] == 0 {
        list_set(adj, src, list_new())
    }
    return adj[src]
}

// Create a synapse pre->post with the given weight (clamped) and type mask.
// Reuses a reclaimed slot when one is available, else appends. Returns index.
fn syn_new(g, pre, post, weight, mask) {
    let w = fp_clamp(weight, W_MIN, W_MAX)
    let free = g[SG_FREE]
    let idx = -1
    if len(free) > 0 {
        idx = free[len(free) - 1]
        list_remove(free, len(free) - 1)
        list_set(g[SG_PRE], idx, pre)
        list_set(g[SG_POST], idx, post)
        list_set(g[SG_W], idx, w)
        list_set(g[SG_ELIG], idx, 0)
        list_set(g[SG_LAST], idx, -1)
        list_set(g[SG_MASK], idx, mask)
        list_set(g[SG_ALIVE], idx, 1)
    } else {
        push(g[SG_PRE], pre)
        push(g[SG_POST], post)
        push(g[SG_W], w)
        push(g[SG_ELIG], 0)
        push(g[SG_LAST], -1)
        push(g[SG_MASK], mask)
        push(g[SG_ALIVE], 1)
        idx = len(g[SG_PRE]) - 1
    }
    push(_syn_adj_get(g, pre), idx)
    list_set(g, SG_LIVE, g[SG_LIVE] + 1)
    return idx
}

fn syn_total(g) { return len(g[SG_PRE]) }   // includes dead slots
fn syn_live(g)  { return g[SG_LIVE] }

fn _syn_valid(g, idx) {
    if idx < 0 { return 0 }
    if idx >= len(g[SG_PRE]) { return 0 }
    return 1
}

fn syn_alive(g, idx) {
    if _syn_valid(g, idx) == 0 { return 0 }
    return g[SG_ALIVE][idx]
}
fn syn_pre(g, idx)    { if _syn_valid(g, idx) == 0 { return -1 } return g[SG_PRE][idx] }
fn syn_post(g, idx)   { if _syn_valid(g, idx) == 0 { return -1 } return g[SG_POST][idx] }
fn syn_weight(g, idx) { if _syn_valid(g, idx) == 0 { return 0 } return g[SG_W][idx] }
fn syn_elig(g, idx)   { if _syn_valid(g, idx) == 0 { return 0 } return g[SG_ELIG][idx] }
fn syn_last(g, idx)   { if _syn_valid(g, idx) == 0 { return -1 } return g[SG_LAST][idx] }
fn syn_mask(g, idx)   { if _syn_valid(g, idx) == 0 { return 0 } return g[SG_MASK][idx] }

fn syn_set_weight(g, idx, w) {
    if _syn_valid(g, idx) == 0 { return 0 }
    list_set(g[SG_W], idx, fp_clamp(w, W_MIN, W_MAX))
    return 1
}

fn syn_carries(g, idx, stype) {
    if _syn_valid(g, idx) == 0 { return 0 }
    return syn_mask_has(g[SG_MASK][idx], stype)
}

// Live outgoing synapse indices from a source node.
fn syn_out(g, src) {
    let result = list_new()
    if src < 0 { return result }
    let adj = g[SG_ADJ]
    if src >= len(adj) { return result }
    let idxs = adj[src]
    if idxs == 0 { return result }
    let i = 0
    while i < len(idxs) {
        let idx = idxs[i]
        if g[SG_ALIVE][idx] == 1 { push(result, idx) }
        i = i + 1
    }
    return result
}

// Find a live synapse pre->post, or -1.
fn syn_find(g, pre, post) {
    let outs = syn_out(g, pre)
    let i = 0
    while i < len(outs) {
        let idx = outs[i]
        if g[SG_POST][idx] == post { return idx }
        i = i + 1
    }
    return -1
}

// Growth mechanism: ensure a pre->post synapse exists; create it if absent.
fn syn_grow_if_absent(g, pre, post, init_weight, mask) {
    let existing = syn_find(g, pre, post)
    if existing != -1 { return existing }
    return syn_new(g, pre, post, init_weight, mask)
}

// Transmit a presynaptic activation along synapse idx for the given tick.
// Returns the signed contribution (fp_mul(weight, pre_act)); negative weights
// inhibit. Records co-activation eligibility and last-active tick.
fn syn_transmit(g, idx, pre_act, tick) {
    if _syn_valid(g, idx) == 0 { return 0 }
    if g[SG_ALIVE][idx] == 0 { return 0 }
    let contribution = fp_mul(g[SG_W][idx], pre_act)
    if pre_act > 0 {
        list_set(g[SG_LAST], idx, tick)
    }
    return contribution
}

// Apply the fused plasticity rule to one synapse given pre/post activations,
// a bottom-up error term, and a global modulator (1000 == neutral 1.0).
fn syn_learn_one(g, idx, pre_act, post_act, error, modulator) {
    if _syn_valid(g, idx) == 0 { return 0 }
    if g[SG_ALIVE][idx] == 0 { return 0 }
    let dw_hebb = fp_mul(SYN_ETA_H, fp_mul(pre_act, post_act))
    let dw_err  = fp_mul(SYN_ETA_E, fp_mul(pre_act, error))
    let dw = fp_mul(modulator, dw_hebb + dw_err)
    list_set(g[SG_W], idx, fp_clamp(g[SG_W][idx] + dw, W_MIN, W_MAX))
    if pre_act > 0 {
        if post_act > 0 {
            let e = g[SG_ELIG][idx] + fp_mul(pre_act, post_act)
            list_set(g[SG_ELIG], idx, fp_clamp(e, 0, SYN_ELIG_CEIL))
        }
    }
    return 1
}

fn syn_decay_eligibility(g) {
    let n = len(g[SG_PRE])
    let i = 0
    while i < n {
        if g[SG_ALIVE][i] == 1 {
            list_set(g[SG_ELIG], i, fp_mul(g[SG_ELIG][i], SYN_ELIG_DECAY))
        }
        i = i + 1
    }
}

// The ADR-0007 fused plasticity pass over all live synapses. `act_snapshot` is
// a list indexed by node id giving each node's activation (milli) at
// propagation time -- using a snapshot avoids reading post-refractory zeros.
// Returns the number of synapses updated.
fn syn_plasticity_step(g, act_snapshot, error, modulator, tick) {
    let n = len(g[SG_PRE])
    let updated = 0
    let i = 0
    while i < n {
        if g[SG_ALIVE][i] == 1 {
            let pre = g[SG_PRE][i]
            let post = g[SG_POST][i]
            let pre_act = 0
            let post_act = 0
            if pre >= 0 { if pre < len(act_snapshot) { pre_act = act_snapshot[pre] } }
            if post >= 0 { if post < len(act_snapshot) { post_act = act_snapshot[post] } }
            syn_learn_one(g, i, pre_act, post_act, error, modulator)
            if pre_act > 0 { if post_act > 0 { list_set(g[SG_LAST], i, tick) } }
            updated = updated + 1
        }
        i = i + 1
    }
    syn_decay_eligibility(g)
    return updated
}

// ===========================================================================
// Three-factor / neuromodulated plasticity + STDP asymmetry (P2, ADR-0052).
//
// The fused rule above changes a weight the instant pre and post co-fire. That
// is two-factor Hebbian (plus an immediate error term) and cannot do temporal
// credit assignment: a reward that arrives a few ticks AFTER the moment that
// earned it has nothing left to act on. The three-factor rule (Frémaux &
// Gerstner 2016) splits learning into two phases:
//
//   1. a slow, unsupervised ELIGIBILITY trace accumulates from co-firing and
//      decays (it remembers "this synapse was recently active"), and
//   2. a single broadcast NEUROMODULATOR scalar (reward / prediction-error /
//      surprise) multiplies that trace to actually move the weight:
//          dw_ij = eta_3f * neuromod * eligibility_ij
//
// Because the trace persists, a reward at t+k still credits the synapses that
// co-fired at t -- the delayed-reward association pure Hebbian cannot learn.
//
// STDP asymmetry: the eligibility a co-firing deposits depends on spike order.
// "pre before post" (causal -- pre may have helped cause post) deposits a large
// trace; "post before pre" (acausal) deposits a much smaller one, so under the
// same reward an A->B synapse wires forward more strongly than B->A. The trace
// stays non-negative (the existing prune/decay logic is unchanged); the SIGN of
// learning comes from the neuromodulator, not the trace.
// ---------------------------------------------------------------------------
let SYN_ETA_3F    = 40    // 0.04 three-factor learning rate (neuromod x trace)
let STDP_TAU      = 20    // ticks: the spike-timing window
let STDP_A_PLUS   = 1000  // 1.0  causal  (pre-before-post) eligibility gain
let STDP_A_MINUS  = 250   // 0.25 acausal (post-before-pre) gain -> forward >> back

// STDP eligibility increment (milli, non-negative) for a pre/post spike pair
// separated by dt = post_tick - pre_tick. Linearly decays across the window;
// causal pairings (dt >= 0) gain A_PLUS, acausal (dt < 0) the smaller A_MINUS.
fn syn_stdp_kernel(dt) {
    let adt = dt
    if adt < 0 { adt = 0 - adt }
    if adt >= STDP_TAU { return 0 }
    let decay = (STDP_TAU - adt) * FP_SCALE / STDP_TAU   // (0, 1000]
    if dt >= 0 { return fp_mul(STDP_A_PLUS, decay) }
    return fp_mul(STDP_A_MINUS, decay)
}

// Deposit an STDP-shaped eligibility trace on one synapse from a co-firing,
// given the most-recent fire ticks of its pre and post nodes (-1 == never
// fired -> no deposit). Refreshes last-active so a freshly-credited synapse is
// not pruned. Returns 1 if a trace was deposited.
fn syn_coactivate(g, idx, pre_tick, post_tick) {
    if _syn_valid(g, idx) == 0 { return 0 }
    if g[SG_ALIVE][idx] == 0 { return 0 }
    if pre_tick < 0 { return 0 }
    if post_tick < 0 { return 0 }
    let inc = syn_stdp_kernel(post_tick - pre_tick)
    if inc <= 0 { return 0 }
    let e = g[SG_ELIG][idx] + inc
    list_set(g[SG_ELIG], idx, fp_clamp(e, 0, SYN_ELIG_CEIL))
    if post_tick > g[SG_LAST][idx] { list_set(g[SG_LAST], idx, post_tick) }
    return 1
}

// Deposit eligibility across every live synapse from a per-node fire-tick
// snapshot (`fire_tick[node]` = that node's most recent fire tick, or -1).
// This is the unsupervised first phase of three-factor learning. Returns the
// number of synapses that received a trace.
fn syn_eligibility_step(g, fire_tick) {
    let n = len(g[SG_PRE])
    let deposited = 0
    let i = 0
    while i < n {
        if g[SG_ALIVE][i] == 1 {
            let pre = g[SG_PRE][i]
            let post = g[SG_POST][i]
            let pt = -1
            let qt = -1
            if pre >= 0 { if pre < len(fire_tick) { pt = fire_tick[pre] } }
            if post >= 0 { if post < len(fire_tick) { qt = fire_tick[post] } }
            deposited = deposited + syn_coactivate(g, i, pt, qt)
        }
        i = i + 1
    }
    return deposited
}

// The second phase: a broadcast neuromodulator (signed milli -- reward minus
// expectation, optionally amplified by surprise) moves every weight in
// proportion to its current eligibility. This is where a delayed reward is
// finally applied. Returns the number of live synapses touched.
fn syn_neuromodulate(g, neuromod) {
    let n = len(g[SG_PRE])
    let updated = 0
    let i = 0
    while i < n {
        if g[SG_ALIVE][i] == 1 {
            let dw = fp_mul(SYN_ETA_3F, fp_mul(neuromod, g[SG_ELIG][i]))
            if dw != 0 {
                list_set(g[SG_W], i, fp_clamp(g[SG_W][i] + dw, W_MIN, W_MAX))
            }
            updated = updated + 1
        }
        i = i + 1
    }
    return updated
}

fn _syn_remove_from_adj(g, idx) {
    let src = g[SG_PRE][idx]
    let adj = g[SG_ADJ]
    if src < 0 { return 0 }
    if src >= len(adj) { return 0 }
    let outs = adj[src]
    if outs == 0 { return 0 }
    let j = 0
    while j < len(outs) {
        if outs[j] == idx {
            list_remove_at(outs, j)
            return 1
        }
        j = j + 1
    }
    return 0
}

// Prune idle, near-zero synapses (ADR-0007 death rule). Returns count pruned.
fn syn_prune(g) {
    let n = len(g[SG_PRE])
    let pruned = 0
    let i = 0
    while i < n {
        if g[SG_ALIVE][i] == 1 {
            let w = g[SG_W][i]
            let aw = w
            if aw < 0 { aw = 0 - aw }
            if aw < SYN_DEATH_W {
                if g[SG_ELIG][i] < SYN_DEATH_ELIG {
                    _syn_remove_from_adj(g, i)
                    list_set(g[SG_ALIVE], i, 0)
                    push(g[SG_FREE], i)
                    list_set(g, SG_LIVE, g[SG_LIVE] - 1)
                    pruned = pruned + 1
                }
            }
        }
        i = i + 1
    }
    return pruned
}

// ---- persistence (ADR-0048): iteration + restore --------------------------
//
// Snapshot_disk needs to walk every LIVE synapse to write the section, and
// re-install (pre, post, weight, eligibility) tuples on /load. Iteration is
// already covered by syn_total + syn_alive + syn_pre/post/weight/elig; we
// add a tiny restore wrapper that fuses syn_new() with an explicit eligibility
// set so a re-loaded substrate boots with the same co-fire trace it had on
// /save (otherwise eligibility decays to 0 on first idle and the synapse can
// get pruned before any post-restart traffic arrives).
//
// Note: the existing syn_new() already covers (pre, post, weight, mask)
// install; we just need to follow up with an eligibility write. We don't
// need a syn_clear() because /load replaces the part_registry's synapse
// graph by rebuilding from scratch -- see snapshot_disk.nova.
fn syn_set_eligibility(g, idx, e) {
    if _syn_valid(g, idx) == 0 { return 0 }
    let v = e
    if v < 0 { v = 0 }
    if v > SYN_ELIG_CEIL { v = SYN_ELIG_CEIL }
    list_set(g[SG_ELIG], idx, v)
    return 1
}

// Install a synapse with explicit weight + eligibility, defaulting mask to 0.
// Returns the new synapse index (or the existing one if pre->post is already
// connected, with its weight/eligibility overwritten). Idempotent on a second
// /load of the same snapshot.
fn syn_restore(g, pre, post, weight, eligibility) {
    let existing = syn_find(g, pre, post)
    let idx = existing
    if existing == -1 {
        idx = syn_new(g, pre, post, weight, 0)
    } else {
        syn_set_weight(g, idx, weight)
    }
    syn_set_eligibility(g, idx, eligibility)
    return idx
}
