// CrossEngin substrate: resonance engine.
//
// Purpose
//   Resonance is the substrate dynamic by which reciprocally connected,
//   co-active nodes reinforce one another into stable assemblies -- the
//   bidirectional synchronization the language writes as `a <=> b`. Where the
//   Hebbian rule (ADR-0007) strengthens a single directed synapse on
//   co-activation, resonance acts on a *reciprocal pair* (a->b and b->a): when
//   both endpoints are co-active it potentiates both directions, deepening an
//   attractor. Bound percepts (XSIG_BIND, ADR-0008) and stable concepts emerge
//   from resonant assemblies rather than from any controller.
//
//   Co-activation is read from an activation snapshot (a list indexed by node
//   id), the same convention as the synapse plasticity pass, so resonance and
//   plasticity see a consistent view within a tick.
//
// ADRs implemented: ADR-0001 (intelligence emerges from substrate dynamics),
//   ADR-0007 (reuses synapse weights/eligibility), ADR-0008 (resonant assemblies
//   underpin XSIG_BIND grouping). Depends-on note: NOVA's resonance kernel (N19)
//   and enhancement #4 (SIMD fan-out) accelerate this at scale; the dynamics
//   here are complete now.
// NOVA dependencies: builtins (lists, min).
// CrossEngin dependencies: src/substrate/synapse_graph.nova (and transitively
//   node_pool_manager for fixed-point helpers).

import "synapse_graph.nova"

let RES_COACT_THRESH = 400   // 0.4 minimum activation to count as co-active
let RES_DELTA        = 50    // 0.05 potentiation applied per resonant step
let RES_SEED_W       = 200   // 0.2 initial weight when establishing a pair

// Snapshot activation of node id (0 if out of range / absent).
fn _res_act(snapshot, id) {
    if id < 0 { return 0 }
    if id >= len(snapshot) { return 0 }
    return snapshot[id]
}

// Reciprocal coupling strength of the pair {a,b}: min of the two directed
// weights, or 0 if either direction is missing (resonance needs a loop).
fn res_pair_strength(g, a, b) {
    let fwd = syn_find(g, a, b)
    let rev = syn_find(g, b, a)
    if fwd == -1 { return 0 }
    if rev == -1 { return 0 }
    return min(syn_weight(g, fwd), syn_weight(g, rev))
}

// A pair is resonant when both endpoints are co-active and reciprocally linked.
fn res_is_resonant(g, snapshot, a, b, coact_threshold) {
    if _res_act(snapshot, a) < coact_threshold { return 0 }
    if _res_act(snapshot, b) < coact_threshold { return 0 }
    if res_pair_strength(g, a, b) <= 0 { return 0 }
    return 1
}

// Potentiate both directions of the {a,b} pair by delta, establishing the links
// (at RES_SEED_W) if absent. Returns the resulting reciprocal strength.
fn res_reinforce_pair(g, a, b, delta) {
    let fwd = syn_grow_if_absent(g, a, b, RES_SEED_W, 0)
    let rev = syn_grow_if_absent(g, b, a, RES_SEED_W, 0)
    syn_set_weight(g, fwd, syn_weight(g, fwd) + delta)
    syn_set_weight(g, rev, syn_weight(g, rev) + delta)
    return res_pair_strength(g, a, b)
}

// One resonance pass: reinforce every reciprocal, co-active pair. Each pair is
// processed once (guarded by a<b). Returns the number of pairs reinforced.
fn res_step(g, snapshot, coact_threshold, delta) {
    let n = syn_total(g)
    let reinforced = 0
    let i = 0
    while i < n {
        if syn_alive(g, i) == 1 {
            let a = syn_pre(g, i)
            let b = syn_post(g, i)
            if a < b {
                if syn_find(g, b, a) != -1 {
                    if _res_act(snapshot, a) >= coact_threshold {
                        if _res_act(snapshot, b) >= coact_threshold {
                            syn_set_weight(g, i, syn_weight(g, i) + delta)
                            let rev = syn_find(g, b, a)
                            syn_set_weight(g, rev, syn_weight(g, rev) + delta)
                            reinforced = reinforced + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return reinforced
}

// The resonant assembly around a seed node: its co-active, reciprocally linked
// one-hop neighbors (the bound group for XSIG_BIND). Empty if the seed is not
// itself co-active.
fn res_assembly(g, snapshot, seed, coact_threshold) {
    let assembly = list_new()
    if _res_act(snapshot, seed) < coact_threshold { return assembly }
    let outs = syn_out(g, seed)
    let i = 0
    while i < len(outs) {
        let b = syn_post(g, outs[i])
        if _res_act(snapshot, b) >= coact_threshold {
            if syn_find(g, b, seed) != -1 {
                push(assembly, b)
            }
        }
        i = i + 1
    }
    return assembly
}
