// CrossEngin substrate: tick driver.
//
// Purpose
//   Executes one substrate tick over a part, running the uniform node kernel
//   across the part and propagating the result along synapses (ADR-0006). A
//   tick has four phases, ordered so that learning sees a consistent within-tick
//   view:
//     1. snapshot   record each live node's activation at tick start
//     2. integrate  run the node kernel on every live node; collect those that
//                   fired this tick
//     3. propagate  each fired node emits a spike down its outgoing synapses;
//                   the weighted contribution lands in the destination's inbox
//                   for the next tick (negative weights inhibit)
//     4. learn      apply the fused plasticity pass over the snapshot
//   The driver exposes a logical clock (td_engine). Wall-clock 100Hz pacing of
//   that clock is the scheduler's job (ADR-0037, a later phase) and rests on
//   NOVA enhancement #5; the substrate's per-tick semantics are complete here.
//
// ADRs implemented: ADR-0006 (xnode_tick orchestration), ADR-0001 (tick-driven
//   substrate). Depends-on note: SIMD-batched propagation across millions of
//   synapses is enhancement #4; this scalar pass is correct now.
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/substrate/part_registry.nova,
//   src/substrate/synapse_graph.nova, src/substrate/node_pool_manager.nova.

import "part_registry.nova"
import "synapse_graph.nova"
import "node_pool_manager.nova"

let TD_SPIKE       = 1000   // 1.0 spike output of a fired node (FP_ONE)
let TD_MOD_NEUTRAL = 1000   // 1.0 neutral plasticity modulator
let TD_ENG_TAG     = 1010

// Execute one tick over a single part object. Returns the number of nodes that
// fired this tick.
fn _td_exec(part, tick, modulator, error) {
    let pool = part_pool(part)
    let g = part_syn(part)
    let cap = part_capacity(part)

    // Phase 1: snapshot activations at tick start (length == capacity).
    let snapshot = list_new()
    let i = 0
    while i < cap {
        if npm_node_is_live(pool, i) == 1 {
            push(snapshot, npm_activation(pool, i))
        } else {
            push(snapshot, 0)
        }
        i = i + 1
    }

    // Phase 2: integrate every live node; collect those that fired.
    let fired = list_new()
    i = 0
    while i < cap {
        if npm_node_is_live(pool, i) == 1 {
            if npm_node_integrate(pool, i, tick) == 1 {
                push(fired, i)
            }
        }
        i = i + 1
    }

    // Phase 3: propagate spikes from fired nodes to destination inboxes.
    let f = 0
    while f < len(fired) {
        let src = fired[f]
        let outs = syn_out(g, src)
        let j = 0
        while j < len(outs) {
            let syn = outs[j]
            let contribution = syn_transmit(g, syn, TD_SPIKE, tick)
            let dst = syn_post(g, syn)
            if npm_node_is_live(pool, dst) == 1 {
                npm_node_input(pool, dst, contribution)
            }
            j = j + 1
        }
        f = f + 1
    }

    // Phase 4: learn over the tick-start snapshot.
    syn_plasticity_step(g, snapshot, error, modulator, tick)

    return len(fired)
}

// Tick a single part by id at an explicit tick number. Inactive or unknown
// parts are skipped (return 0).
fn td_tick_part(reg, part_id, tick, modulator, error) {
    let part = registry_get(reg, part_id)
    if part == 0 { return 0 }
    if part_is_alive(part) == 0 { return 0 }
    return _td_exec(part, tick, modulator, error)
}

// Tick every active part at the given tick number. Returns total nodes fired.
fn td_tick_all(reg, tick, modulator, error) {
    let total = 0
    let ids = registry_ids(reg)
    let i = 0
    while i < len(ids) {
        let part = registry_get(reg, ids[i])
        if part_is_alive(part) == 1 {
            total = total + _td_exec(part, tick, modulator, error)
        }
        i = i + 1
    }
    return total
}

// ---- logical clock --------------------------------------------------------
fn td_engine_new(reg) {
    let e = list_new()
    push(e, TD_ENG_TAG)
    push(e, reg)
    push(e, 0)
    return e
}

fn td_now(e) { return e[2] }

// Advance the clock by one and tick all active parts. Returns nodes fired.
fn td_step(e, modulator, error) {
    let t = e[2] + 1
    list_set(e, 2, t)
    return td_tick_all(e[1], t, modulator, error)
}

// Advance the clock by one and tick a single part. Returns nodes fired.
fn td_step_part(e, part_id, modulator, error) {
    let t = e[2] + 1
    list_set(e, 2, t)
    return td_tick_part(e[1], part_id, t, modulator, error)
}

// Run n steps over all active parts; returns total nodes fired across them.
fn td_run(e, n, modulator, error) {
    let total = 0
    let k = 0
    while k < n {
        total = total + td_step(e, modulator, error)
        k = k + 1
    }
    return total
}
