// CrossEngin seed pack registry.
//
// Purpose
//   A tiny dispatch layer over the per-domain seed packs in src/seed/packs/.
//   Exposes:
//
//     pack_list() -> list of [name, description, atom_count_estimate]
//     pack_install(name, lang_kg, reasoning_kg, ikg, mo, now)
//                 -> [atoms_installed, ops_installed, status_or_error]
//
//   The `/seed <pack>` admin command in examples/crossengin_chat.nova drives
//   both: `/seed` with no arg formats `pack_list()`; `/seed <name>` runs
//   `pack_install` and prints the returned counts.
//
//   Idempotency
//     `pack_already_installed(reasoning_kg, name)` is a label-presence check
//     against a per-pack canary atom (the first atom each pack always
//     ingests). If the canary is present, the pack is considered installed.
//     `pack_install` checks this and short-circuits with status "already".
//     The `/seed --reset` flag bypasses the check and forces re-ingest -- the
//     underlying au_ingest is idempotent (re-ingesting an existing label adds
//     a Tier-A evidence increment instead of birthing a duplicate atom).
//
//   The registry holds zero per-call state; it's a pure function that
//   dispatches on `name`. Adding a new pack is one entry in `pack_list()` +
//   one branch in `pack_install`.
//
// ADRs implemented: ADR-0010 (boot state extension).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/seed/packs/medical_pack.nova,
//   src/seed/packs/ops_runbook_pack.nova,
//   src/seed/packs/code_review_pack.nova,
//   src/kg/multi_kg_manager.nova (kg_find_atom for the canary check),
//   src/parts/meta/meta_observer.nova (mo_attribute for the active session's
//     observer so installed atoms surface in /meta).

import "./packs/medical_pack.nova"
import "./packs/ops_runbook_pack.nova"
import "./packs/code_review_pack.nova"

// ---- pack listing --------------------------------------------------------
// Each entry: [name, description, approx_atom_count]. Description is short
// (one line); count is a static estimate matching what the install function
// adds to a fresh KG (~55 / ~45 / ~40 today).

fn pack_list() {
    let out = list_new()
    let med = list_new()
    push(med, "medical")
    push(med, "anatomy + symptoms + drugs + common-condition operators")
    push(med, 60)
    push(out, med)
    let ops = list_new()
    push(ops, "ops_runbook")
    push(ops, "service / alert / metric concepts + common-incident operators")
    push(ops, 45)
    push(out, ops)
    let cr = list_new()
    push(cr, "code_review")
    push(cr, "review vocabulary + smells + review-rule operators")
    push(cr, 40)
    push(out, cr)
    return out
}

// Each pack's canary label: a stable atom the pack always ingests AND that
// is NOT present in src/seed/first_atoms.nova so its presence is a clean
// signal that the pack has been installed (not just that the seed shares a
// body-part or generic noun). Reviewed against first_atoms.nova line-by-line.
fn _pack_canary_label(name) {
    if str_eq(name, "medical") == 1 { return "antibiotic" }
    if str_eq(name, "ops_runbook") == 1 { return "service" }
    if str_eq(name, "code_review") == 1 { return "refactor" }
    return ""
}

// Idempotency check: is the canary label already in the reasoning KG?
// Returns 1 if so, 0 otherwise. Unknown packs return 0 so the install
// path can produce a clean "unknown pack" error.
fn pack_already_installed(reasoning_kg, name) {
    let canary = _pack_canary_label(name)
    if len(canary) == 0 { return 0 }
    if kg_find_atom(reasoning_kg, canary) != 0 { return 1 }
    return 0
}

// Dispatch a single pack-install call. `mo` is the active session's
// meta-observer so installed atoms surface in /meta under
// `src:pack:<name>`. If the pack is already installed and `force` is 0,
// returns [0, 0, "already"] without touching the KGs. Unknown packs
// return [0, 0, "unknown"].
fn pack_install_with_force(name, lang_kg, reasoning_kg, ikg, mo, force, now) {
    let out = list_new()
    if pack_already_installed(reasoning_kg, name) == 1 {
        if force == 0 {
            push(out, 0)
            push(out, 0)
            push(out, "already")
            return out
        }
    }
    if str_eq(name, "medical") == 1 {
        let r = pack_install_medical_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
        push(out, r[0])
        push(out, r[1])
        push(out, "ok")
        return out
    }
    if str_eq(name, "ops_runbook") == 1 {
        let r = pack_install_ops_runbook_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
        push(out, r[0])
        push(out, r[1])
        push(out, "ok")
        return out
    }
    if str_eq(name, "code_review") == 1 {
        let r = pack_install_code_review_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
        push(out, r[0])
        push(out, r[1])
        push(out, "ok")
        return out
    }
    push(out, 0)
    push(out, 0)
    push(out, "unknown")
    return out
}

// Convenience wrapper matching the brief's signature: dispatch a single
// pack-install call with force=0 (honour idempotency).
fn pack_install(name, lang_kg, reasoning_kg, ikg, mo, now) {
    return pack_install_with_force(name, lang_kg, reasoning_kg, ikg, mo, 0, now)
}

// Pack-list helpers (slot accessors so callers don't hard-code list indices).
fn pack_entry_name(e)        { return e[0] }
fn pack_entry_description(e) { return e[1] }
fn pack_entry_atom_count(e)  { return e[2] }
