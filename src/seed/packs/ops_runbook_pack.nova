// CrossEngin seed pack: ops runbook.
//
// Purpose
//   A domain-specific knowledge bundle installable above first_atoms via the
//   `/seed ops_runbook` admin command (P1.9). Adds production-ops vocabulary
//   (service, alert, log, metric, latency, error_rate, restart, rollback,
//   deploy) and common-incident reasoning operators (e.g.
//   `high_latency -> check_database`, `error_rate_spike -> check_recent_deploy`,
//   `oom -> restart`).
//
//   All ingested atoms are tagged `src:pack:ops_runbook` via the au_ingest
//   `answer_text` argument so the meta-observer can attribute promotion /
//   atrophy of pack-supplied vs seed-supplied vs user-taught knowledge.
//   Operator labels carry the same prefix.
//
//   ~45 atoms + 9 operators. Idempotent: re-installing finds existing atoms
//   by label and simply refreshes their belief via au_ingest's Tier-A path.
//
// ADRs implemented: ADR-0010 (boot state extension), ADR-0029 (source tagging),
//   ADR-0031 (reasoning operators), ADR-0050 (meta-observer attribution).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/learning/ask_user_to_teach.nova (au_ingest),
//   src/parts/reasoning/reasoning_atoms.nova (rop_new, ROP_* kinds),
//   src/parts/meta/meta_observer.nova (mo_attribute).

import "../../learning/ask_user_to_teach.nova"
import "../../parts/reasoning/reasoning_atoms.nova"
import "../../parts/meta/meta_observer.nova"

let PACK_OPS_SRC = "src:pack:ops_runbook"

// Core ops concepts: services, signals, observability primitives.
fn _pack_ops_concepts(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "service")    push(names, "alert")     push(names, "log")
    push(names, "metric")     push(names, "latency")   push(names, "error_rate")
    push(names, "throughput") push(names, "uptime")    push(names, "downtime")
    push(names, "incident")   push(names, "outage")    push(names, "saturation")
    push(names, "queue")      push(names, "backlog")   push(names, "dashboard")
    push(names, "trace")      push(names, "span")      push(names, "monitor")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_OPS_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_OPS_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Failure modes the runbook reasons over.
fn _pack_ops_failures(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "oom")               push(names, "high_latency")     push(names, "error_rate_spike")
    push(names, "disk_full")         push(names, "network_partition") push(names, "timeout")
    push(names, "crash")             push(names, "deadlock_runtime")  push(names, "throttle")
    push(names, "memory_leak")       push(names, "cpu_saturation")    push(names, "tls_handshake_fail")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_OPS_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_OPS_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Remediation actions the runbook prescribes.
fn _pack_ops_actions(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "restart")       push(names, "rollback")          push(names, "deploy")
    push(names, "scale_out")     push(names, "scale_in")          push(names, "failover")
    push(names, "drain")         push(names, "isolate")           push(names, "patch")
    push(names, "check_database") push(names, "check_recent_deploy") push(names, "check_disk")
    push(names, "check_network") push(names, "page_oncall")       push(names, "open_runbook")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_OPS_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_OPS_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn _pack_ops_op(kg, premise_name, conclusion_name, kind, now) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let label = PACK_OPS_SRC + ":" + premise_name + "->" + conclusion_name
    rop_new(kg, kind, atom_id(p), atom_id(c), label, now)
    return 1
}

fn pack_install_ops_runbook(lang_kg, reasoning_kg, ikg, now) {
    let mo = mo_new()
    return pack_install_ops_runbook_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
}

fn pack_install_ops_runbook_with_mo(lang_kg, reasoning_kg, ikg, mo, now) {
    let a1 = _pack_ops_concepts(lang_kg, reasoning_kg, mo, now)
    let a2 = _pack_ops_failures(lang_kg, reasoning_kg, mo, now)
    let a3 = _pack_ops_actions(lang_kg, reasoning_kg, mo, now)
    // ---- operators (common-incident reasoning edges) --------------------
    let ops = 0
    if _pack_ops_op(reasoning_kg, "high_latency", "check_database", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "error_rate_spike", "check_recent_deploy", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "oom", "restart", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "memory_leak", "restart", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "disk_full", "check_disk", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "network_partition", "check_network", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "crash", "rollback", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "cpu_saturation", "scale_out", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_ops_op(reasoning_kg, "incident", "page_oncall", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    let result = list_new()
    push(result, a1 + a2 + a3)
    push(result, ops)
    return result
}
