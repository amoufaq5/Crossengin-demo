// CrossEngin seed pack: medical.
//
// Purpose
//   A domain-specific knowledge bundle installable above first_atoms via the
//   `/seed medical` admin command (P1.9). Adds anatomy basics (head, chest,
//   abdomen, limbs), common symptoms (cough, nausea, dizziness, rash, pain),
//   drug classes (antibiotic, analgesic, antihistamine), and common-condition
//   reasoning operators (e.g. `headache -> dehydration`, `cough -> bronchitis`,
//   `rash -> allergy`).
//
//   All ingested atoms are tagged `src:pack:medical` via the au_ingest
//   `answer_text` argument so the meta-observer can attribute promotion /
//   atrophy of pack-supplied vs seed-supplied vs user-taught knowledge.
//   Operator labels carry the same prefix.
//
//   ~55 atoms + 11 operators. Idempotent: re-installing finds existing atoms
//   by label and simply refreshes their belief via au_ingest's Tier-A path.
//
// ADRs implemented: ADR-0010 (boot state extension), ADR-0029 (source tagging),
//   ADR-0031 (reasoning operators), ADR-0050 (meta-observer attribution).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/learning/ask_user_to_teach.nova (au_ingest),
//   src/parts/reasoning/reasoning_atoms.nova (rop_new, ROP_* kinds),
//   src/parts/meta/meta_observer.nova (mo_attribute).

import "../../learning/ask_user_to_teach.nova"
import "../../parts/reasoning/reasoning_atoms.nova"
import "../../parts/meta/meta_observer.nova"

// Source-attribution prefix shared by atoms + operators in this pack.
let PACK_MEDICAL_SRC = "src:pack:medical"

// Anatomy: head + body regions + organ systems.
fn _pack_medical_anatomy(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "head")       push(names, "chest")     push(names, "abdomen")
    push(names, "limb")       push(names, "spine")     push(names, "throat")
    push(names, "joint")      push(names, "kidney")    push(names, "liver")
    push(names, "intestine")  push(names, "nerve")     push(names, "tendon")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_MEDICAL_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_MEDICAL_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Common symptoms beyond the foundational fever / pain set. Includes the
// seed-side symptom names (cough, pain, headache, fever) so the pack works
// against a bare KG without first_atoms; au_ingest is a Tier-A no-op on
// re-ingest if the name was already seeded.
fn _pack_medical_symptoms(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "nausea")      push(names, "dizziness")  push(names, "rash")
    push(names, "fatigue")     push(names, "swelling")   push(names, "vomiting")
    push(names, "diarrhea")    push(names, "congestion") push(names, "sneeze")
    push(names, "chills")      push(names, "sweating")   push(names, "wheeze")
    push(names, "bleeding")    push(names, "bruise")     push(names, "cramp")
    push(names, "cough")       push(names, "pain")       push(names, "headache")
    push(names, "fever")       push(names, "infection")  push(names, "allergy")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_MEDICAL_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_MEDICAL_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Drug classes + common-condition vocabulary.
fn _pack_medical_drugs_conditions(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "antibiotic")    push(names, "analgesic")   push(names, "antihistamine")
    push(names, "antiviral")     push(names, "sedative")    push(names, "stimulant")
    push(names, "vaccine_dose")  push(names, "ointment")    push(names, "syrup")
    push(names, "tablet")        push(names, "capsule")     push(names, "injection")
    push(names, "bronchitis")    push(names, "dehydration") push(names, "asthma")
    push(names, "flu")           push(names, "cold")        push(names, "pneumonia")
    push(names, "migraine")      push(names, "diabetes")    push(names, "hypertension")
    push(names, "anemia")        push(names, "arthritis")   push(names, "fracture")
    push(names, "hydration")     push(names, "antipyretic") push(names, "antiseptic")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_MEDICAL_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_MEDICAL_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Add a reasoning operator atom by looking up two label-named concepts.
// Returns 1 on success, 0 if either endpoint is missing.
fn _pack_medical_op(kg, premise_name, conclusion_name, kind, now) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let label = PACK_MEDICAL_SRC + ":" + premise_name + "->" + conclusion_name
    rop_new(kg, kind, atom_id(p), atom_id(c), label, now)
    return 1
}

// Install the medical pack into the active session's KGs. Returns a 2-element
// list [atoms_installed, operators_installed]. Idempotent on re-call.
fn pack_install_medical(lang_kg, reasoning_kg, ikg, now) {
    let mo = mo_new()
    return pack_install_medical_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
}

// Same as pack_install_medical but accepts an external meta-observer so the
// installed atoms surface in the session's existing /meta table under the
// `src:pack:medical` tag.
fn pack_install_medical_with_mo(lang_kg, reasoning_kg, ikg, mo, now) {
    let before = kg_atom_count(reasoning_kg)
    let a1 = _pack_medical_anatomy(lang_kg, reasoning_kg, mo, now)
    let a2 = _pack_medical_symptoms(lang_kg, reasoning_kg, mo, now)
    let a3 = _pack_medical_drugs_conditions(lang_kg, reasoning_kg, mo, now)
    // ---- operators (common-condition reasoning edges) -------------------
    let ops = 0
    if _pack_medical_op(reasoning_kg, "headache", "dehydration", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "cough", "bronchitis", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "rash", "allergy", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "fever", "flu", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "wheeze", "asthma", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "nausea", "dehydration", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "infection", "antibiotic", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "pain", "analgesic", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "allergy", "antihistamine", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "dehydration", "hydration", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_medical_op(reasoning_kg, "fever", "antipyretic", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    let result = list_new()
    push(result, a1 + a2 + a3)
    push(result, ops)
    return result
}
