// CrossEngin seed pack: logic.
//
// Purpose
//   A domain-general knowledge bundle covering the vocabulary of
//   formal reasoning: logical primitives (implies, and, or, ...),
//   named inference rules (modus ponens, syllogism, DeMorgan, ...),
//   and the meta-vocabulary the rules compose through (antecedent,
//   consequent, premise, conclusion, ...). Plus operator atoms that
//   let the forward-chainer traverse rule -> primitive and
//   premise -> rule -> conclusion schemas.
//
//   All ingested atoms are tagged `src:pack:logic` via the au_ingest
//   `answer_text` argument so the meta-observer attributes promotion
//   / atrophy of pack-supplied vs seed-supplied vs user-taught
//   knowledge. Operator labels carry the same prefix.
//
//   ~50 atoms + ~45 operators. Idempotent: re-installing finds
//   existing atoms by label and refreshes their belief via
//   au_ingest's Tier-A path.
//
// ADRs implemented: ADR-0010 (boot state extension), ADR-0029
//   (source tagging), ADR-0031 (reasoning operators), ADR-0050
//   (meta-observer attribution).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/learning/ask_user_to_teach.nova (au_ingest),
//   src/parts/reasoning/reasoning_atoms.nova (rop_new, ROP_* kinds),
//   src/parts/meta/meta_observer.nova (mo_attribute).

import "std/io"
import "std/string"
import "std/syscall"
import "../../learning/ask_user_to_teach.nova"
import "../../parts/reasoning/reasoning_atoms.nova"
import "../../parts/meta/meta_observer.nova"

// Source-attribution prefix shared by atoms + operators in this pack.
let PACK_LOGIC_SRC = "src:pack:logic"

// Logical primitives: connectives, quantifiers, truth values, and
// the structural roles a logical statement plays.
fn _pack_logic_primitives(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "implies")     push(names, "and")         push(names, "or")
    push(names, "not")         push(names, "equiv")       push(names, "forall")
    push(names, "exists")      push(names, "true")        push(names, "false")
    push(names, "premise")     push(names, "conclusion")  push(names, "axiom")
    push(names, "theorem")     push(names, "proof")       push(names, "contradiction")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_LOGIC_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_LOGIC_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Named inference rules: the deductive, inductive, and probabilistic
// patterns the reasoning engine chains over.
fn _pack_logic_rules(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "modus_ponens")            push(names, "modus_tollens")
    push(names, "syllogism")               push(names, "hypothetical_syllogism")
    push(names, "disjunctive_syllogism")   push(names, "transitivity")
    push(names, "contraposition")          push(names, "demorgan_and")
    push(names, "demorgan_or")             push(names, "double_negation")
    push(names, "conjunction_intro")       push(names, "conjunction_elim")
    push(names, "disjunction_intro")       push(names, "disjunction_elim")
    push(names, "implication_intro")       push(names, "universal_instantiation")
    push(names, "existential_generalization") push(names, "mathematical_induction")
    push(names, "bayes_rule")              push(names, "probability_update")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_LOGIC_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_LOGIC_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Meta-logic concepts the rules compose through: the parts of a
// logical argument + the kinds of inference.
fn _pack_logic_meta(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "antecedent")     push(names, "consequent")
    push(names, "hypothesis")     push(names, "assumption")
    push(names, "inference")      push(names, "deduction")
    push(names, "induction")      push(names, "abduction")
    push(names, "generalization") push(names, "specialization")
    push(names, "universal")      push(names, "particular")
    push(names, "necessary")      push(names, "sufficient")
    push(names, "conditional")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_LOGIC_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_LOGIC_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Add a reasoning operator atom by looking up two label-named
// concepts. Returns 1 on success, 0 if either endpoint is missing.
fn _pack_logic_op(kg, premise_name, conclusion_name, kind, now) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let label = PACK_LOGIC_SRC + ":" + premise_name + "->" + conclusion_name
    rop_new(kg, kind, atom_id(p), atom_id(c), label, now)
    return 1
}

// Install the logic pack into the active session's KGs. Returns a
// 2-element list [atoms_installed, operators_installed]. Idempotent
// on re-call.
fn pack_install_logic(lang_kg, reasoning_kg, ikg, now) {
    let mo = mo_new()
    return pack_install_logic_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
}

// Same as pack_install_logic but accepts an external meta-observer so
// the installed atoms surface in the session's existing /meta table
// under the `src:pack:logic` tag.
fn pack_install_logic_with_mo(lang_kg, reasoning_kg, ikg, mo, now) {
    let a1 = _pack_logic_primitives(lang_kg, reasoning_kg, mo, now)
    let a2 = _pack_logic_rules(lang_kg, reasoning_kg, mo, now)
    let a3 = _pack_logic_meta(lang_kg, reasoning_kg, mo, now)

    // Operators: rule -> structural dependency. Mostly ROP_IMPLY
    // because the connection is definitional ("modus_ponens
    // implicates implies"), not causal.
    let ops = 0
    // Modus-ponens family: p, p->q, so q. Depends on implies +
    // conclusion.
    if _pack_logic_op(reasoning_kg, "modus_ponens", "implies", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "modus_ponens", "conclusion", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "modus_tollens", "implies", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "modus_tollens", "not", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Syllogism family.
    if _pack_logic_op(reasoning_kg, "syllogism", "transitivity", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "hypothetical_syllogism", "implies", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "disjunctive_syllogism", "or", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // DeMorgan: not(a and b) == (not a) or (not b).
    if _pack_logic_op(reasoning_kg, "demorgan_and", "not", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "demorgan_and", "and", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "demorgan_or", "not", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "demorgan_or", "or", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Contraposition: (p -> q) iff (not q -> not p).
    if _pack_logic_op(reasoning_kg, "contraposition", "implies", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "contraposition", "not", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Negation.
    if _pack_logic_op(reasoning_kg, "double_negation", "not", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Conjunction + disjunction intro/elim.
    if _pack_logic_op(reasoning_kg, "conjunction_intro", "and", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "conjunction_elim",  "and", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "disjunction_intro", "or", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "disjunction_elim",  "or", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "implication_intro", "implies", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Quantifier rules.
    if _pack_logic_op(reasoning_kg, "universal_instantiation", "forall", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "existential_generalization", "exists", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Induction + probability.
    if _pack_logic_op(reasoning_kg, "mathematical_induction", "generalization", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "bayes_rule", "probability_update", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Meta-vocabulary -> inference kind.
    if _pack_logic_op(reasoning_kg, "deduction",      "inference", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "induction",      "inference", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "abduction",      "inference", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "generalization", "universal",  ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "specialization", "particular", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    // Antecedent/consequent are the structural roles.
    if _pack_logic_op(reasoning_kg, "antecedent", "premise",     ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "consequent", "conclusion",  ROP_IMPLY, now) == 1 { ops = ops + 1 }

    // Example inference chains: premise -> rule -> conclusion so the
    // forward chainer has something to traverse when a user asks
    // about "modus_ponens" or "syllogism". ROP_CAUSAL here because
    // the chain reads as "using the premise through this rule leads
    // to the conclusion."
    if _pack_logic_op(reasoning_kg, "premise",       "modus_ponens", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "modus_ponens",  "conclusion",   ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "assumption",    "hypothesis",   ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "hypothesis",    "theorem",      ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "theorem",       "proof",        ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "axiom",         "theorem",      ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "contradiction", "false",        ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    if _pack_logic_op(reasoning_kg, "assumption",    "contradiction", ROP_CAUSAL, now) == 1 { ops = ops + 1 }

    let result = list_new()
    push(result, a1 + a2 + a3)
    push(result, ops)
    return result
}
