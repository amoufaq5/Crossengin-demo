// CrossEngin seed pack: code review.
//
// Purpose
//   A domain-specific knowledge bundle installable above first_atoms via the
//   `/seed code_review` admin command (P1.9). Adds code-review vocabulary
//   (function, class, variable, test, refactor, mock, race, leak, deadlock,
//   regression) and review-rule reasoning operators (e.g. `race -> add_lock`,
//   `leak -> add_cleanup`, `missing_test -> request_coverage`).
//
//   All ingested atoms are tagged `src:pack:code_review` via the au_ingest
//   `answer_text` argument so the meta-observer can attribute promotion /
//   atrophy of pack-supplied vs seed-supplied vs user-taught knowledge.
//   Operator labels carry the same prefix.
//
//   ~40 atoms + 7 operators. Idempotent: re-installing finds existing atoms
//   by label and simply refreshes their belief via au_ingest's Tier-A path.
//
// ADRs implemented: ADR-0010 (boot state extension), ADR-0029 (source tagging),
//   ADR-0031 (reasoning operators), ADR-0050 (meta-observer attribution).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/learning/ask_user_to_teach.nova (au_ingest),
//   src/parts/reasoning/reasoning_atoms.nova (rop_new, ROP_* kinds),
//   src/parts/meta/meta_observer.nova (mo_attribute).

import "../../learning/ask_user_to_teach.nova"
import "../../parts/reasoning/reasoning_atoms.nova"
import "../../parts/meta/meta_observer.nova"

let PACK_CODE_REVIEW_SRC = "src:pack:code_review"

// Core code-review vocabulary: program elements + activities.
fn _pack_code_review_vocab(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "function")    push(names, "class")        push(names, "variable")
    push(names, "test")        push(names, "refactor")     push(names, "mock")
    push(names, "stub")        push(names, "fixture")      push(names, "assertion")
    push(names, "patch")       push(names, "diff")         push(names, "commit")
    push(names, "branch")      push(names, "review")       push(names, "approver")
    push(names, "comment")     push(names, "merge_conflict") push(names, "coverage")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_CODE_REVIEW_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_CODE_REVIEW_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Code-smells / defect categories.
fn _pack_code_review_smells(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "race")          push(names, "leak")        push(names, "deadlock")
    push(names, "regression")    push(names, "off_by_one")  push(names, "null_deref")
    push(names, "dead_code")     push(names, "duplication") push(names, "shadowed_var")
    push(names, "missing_test")  push(names, "magic_number") push(names, "tight_coupling")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_CODE_REVIEW_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_CODE_REVIEW_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Review-action vocabulary the operators produce.
fn _pack_code_review_actions(lang_kg, kg, mo, now) {
    let names = list_new()
    push(names, "add_lock")        push(names, "add_cleanup")    push(names, "request_coverage")
    push(names, "extract_const")   push(names, "request_changes") push(names, "add_assertion")
    push(names, "split_function")  push(names, "rename_symbol")  push(names, "guard_clause")
    push(names, "request_revert")
    let i = 0
    let n = 0
    while i < len(names) {
        let a = au_ingest(lang_kg, kg, names[i], PACK_CODE_REVIEW_SRC, now)
        if a != 0 {
            mo_attribute(mo, PACK_CODE_REVIEW_SRC, atom_id(a))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn _pack_code_review_op(kg, premise_name, conclusion_name, kind, now) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    let label = PACK_CODE_REVIEW_SRC + ":" + premise_name + "->" + conclusion_name
    rop_new(kg, kind, atom_id(p), atom_id(c), label, now)
    return 1
}

fn pack_install_code_review(lang_kg, reasoning_kg, ikg, now) {
    let mo = mo_new()
    return pack_install_code_review_with_mo(lang_kg, reasoning_kg, ikg, mo, now)
}

fn pack_install_code_review_with_mo(lang_kg, reasoning_kg, ikg, mo, now) {
    let a1 = _pack_code_review_vocab(lang_kg, reasoning_kg, mo, now)
    let a2 = _pack_code_review_smells(lang_kg, reasoning_kg, mo, now)
    let a3 = _pack_code_review_actions(lang_kg, reasoning_kg, mo, now)
    // ---- operators (review-rule reasoning edges) ------------------------
    let ops = 0
    if _pack_code_review_op(reasoning_kg, "race", "add_lock", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_code_review_op(reasoning_kg, "leak", "add_cleanup", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_code_review_op(reasoning_kg, "missing_test", "request_coverage", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_code_review_op(reasoning_kg, "regression", "request_revert", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_code_review_op(reasoning_kg, "magic_number", "extract_const", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_code_review_op(reasoning_kg, "null_deref", "guard_clause", ROP_IMPLY, now) == 1 { ops = ops + 1 }
    if _pack_code_review_op(reasoning_kg, "deadlock", "request_changes", ROP_CAUSAL, now) == 1 { ops = ops + 1 }
    let result = list_new()
    push(result, a1 + a2 + a3)
    push(result, ops)
    return result
}
