// CrossEngin seed: first atoms.
//
// Purpose
//   The atoms a fresh CrossEngin instance boots with -- the minimum knowledge,
//   vocabulary, reasoning operators, syntax patterns, and imagination patterns
//   the daemon needs before it can do anything useful. This is BOOTSTRAPPING
//   knowledge, not learned knowledge: everything seeded here can later be
//   strengthened, corrected (ADR-0044 override), or grown by the learning
//   loops (ADR-0026..0030), but a cold agent must have a starting point.
//
//   `seed_apply` installs everything into a SHARED concept KG plus the language
//   KG and an imagination KG, in two layers:
//     1. CORE -- the agent's basic self-knowledge and interaction vocabulary
//        (self, user, query, response, help, ok), the two operators connecting
//        them (query -> response causally, help => response by implication),
//        and the two output syntax patterns the gated effector uses (ack,
//        see-topic). These are general-purpose: any CrossEngin boot wants them.
//     2. DEMO DOMAIN -- a tiny medical seed (fever -> infection => treat) so
//        the daemon's reasoning chain has something to traverse out of the
//        box; the learning loops grow domain knowledge from real input.
//
//   The function returns the total concept-atom count after seeding so the
//   daemon can report it; callers re-find specific atoms via `kg_find_atom`,
//   `word_find`, or `syntax_find` -- there's no privileged handle to remember.
//
// ADRs implemented: ADR-0010 (first nodes / boot state), ADR-0015 (language
//   atoms), ADR-0016/0017 (atoms + cross-refs), ADR-0031 (reasoning operators),
//   ADR-0032 (imagination patterns), ADR-0034 (identity bootstrap). NOVA
//   dependencies: builtins. CrossEngin dependencies:
//   src/language/syntax_atoms.nova (transitively the kg subtree),
//   src/parts/reasoning/reasoning_atoms.nova,
//   src/parts/imagination/imagination_engine.nova.

import "../language/syntax_atoms.nova"
import "../parts/reasoning/reasoning_atoms.nova"
import "../parts/imagination/imagination_engine.nova"

fn _one(a) { let l = list_new() push(l, a) return l }

// Bind a word atom to a concept atom: intern the surface form and attach the
// weighted sense (cross-KG reference). Used for the seed vocabulary.
fn _bind(lang, form, concept, weight, moment) {
    let w = word_intern(lang, form, moment)
    word_add_sense(w, concept, weight)
    return w
}

// Install the foundational + demo seed into the shared concept KG, the language
// KG, and the imagination KG. Returns the total atom count in the concept KG
// after seeding so the caller can report progress.
fn seed_apply(kg, lang, ikg, moment) {
    // ---- (1) CORE concepts: self-knowledge + interaction vocabulary ---------
    let c_self  = kg_add_atom(kg, ATOM_CONCEPT, "self",     moment)
    let c_user  = kg_add_atom(kg, ATOM_CONCEPT, "user",     moment)
    let c_query = kg_add_atom(kg, ATOM_CONCEPT, "query",    moment)
    let c_resp  = kg_add_atom(kg, ATOM_CONCEPT, "response", moment)
    let c_help  = kg_add_atom(kg, ATOM_CONCEPT, "help",     moment)
    let c_ok    = kg_add_atom(kg, ATOM_CONCEPT, "ok",       moment)

    // The two foundational reasoning operators that let the agent chain from
    // an input towards an outgoing response. These tie the CORE concepts into
    // a minimal causal/implicative scaffold the reader's spreading activation
    // and the reasoning loop can traverse.
    rop_new(kg, ROP_CAUSAL, atom_id(c_query), atom_id(c_resp), "query->response", moment)
    rop_new(kg, ROP_IMPLY,  atom_id(c_help),  atom_id(c_resp), "help=>response",  moment)

    // CORE vocabulary -- the words the reader can anchor immediately.
    _bind(lang, "self",  c_self, 950, moment)
    _bind(lang, "user",  c_user, 950, moment)
    _bind(lang, "hello", c_help, 700, moment)
    _bind(lang, "help",  c_help, 950, moment)
    _bind(lang, "ok",    c_ok,   950, moment)
    _bind(lang, "yes",   c_ok,   700, moment)

    // CORE output syntax patterns -- the gated effector picks between them: a
    // 1-slot ACK for fallback acknowledgements, and SEE + TOPIC for speaking a
    // reasoning conclusion (ADR-0013).
    syntax_atom_new(lang, "ack",       ["ACK"],          moment)
    syntax_atom_new(lang, "see_topic", ["SEE", "TOPIC"], moment)

    // ---- (2) DEMO DOMAIN: a tiny medical seed -------------------------------
    // Just enough for the reasoning chain to reach a non-trivial conclusion on
    // a cold boot (fever -> infection => treat); the learning loops grow from
    // here at runtime.
    let c_fever = kg_add_atom(kg, ATOM_CONCEPT, "fever",     moment)
    let c_inf   = kg_add_atom(kg, ATOM_CONCEPT, "infection", moment)
    let c_treat = kg_add_atom(kg, ATOM_CONCEPT, "treat",     moment)

    // Bidirectional cross-KG edges so the reader's spreading activation can
    // expand a percept of "fever" to include "infection".
    atom_add_xref(c_fever, xref_new(c_fever, c_inf,   XREF_CAUSAL, 800, moment))
    atom_add_xref(c_inf,   xref_new(c_inf,   c_fever, XREF_CAUSAL, 800, moment))

    // Causal + implicative operators for the reasoning loop's forward chaining.
    rop_new(kg, ROP_CAUSAL, atom_id(c_fever), atom_id(c_inf),   "fever->infection", moment)
    rop_new(kg, ROP_IMPLY,  atom_id(c_inf),   atom_id(c_treat), "infection=>treat", moment)

    // Vocabulary for the medical seed.
    _bind(lang, "fever",     c_fever, 900, moment)
    _bind(lang, "infection", c_inf,   900, moment)
    _bind(lang, "treat",     c_treat, 900, moment)

    // Imagination patterns that mirror the operators, so on idle the
    // imagination loop can roll an active set forward through the same chain.
    pattern_new(ikg, "spread", _one(atom_id(c_fever)), _one(atom_id(c_inf)),   moment)
    pattern_new(ikg, "treat",  _one(atom_id(c_inf)),   _one(atom_id(c_treat)), moment)

    return kg_atom_count(kg)
}
