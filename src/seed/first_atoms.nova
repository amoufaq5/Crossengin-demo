// CrossEngin seed: first atoms (expanded productive vocabulary).
//
// Purpose
//   What a fresh CrossEngin instance knows on cold boot. Organized as a
//   sequence of category lists so the structure stays legible even at ~700
//   atoms; each call to `_seed_words_set` adds (concept atom in `kg`) + (word
//   atom in `lang`) + (weighted sense from the word to the concept). The whole
//   set is dedup-safe -- if a name appears in two categories, only the first
//   add takes effect and later seeds skip it.
//
//   Layers:
//     1. CORE -- abstract interaction concepts the agent uses to reason about
//        itself (self, user, query, response, idea, fact, ...).
//     2. CORE VOCABULARY -- ~250 of the highest-frequency English lemmas
//        (pronouns, question words, common verbs, adjectives, nouns, body parts,
//        emotions, time/days/months, numbers, colors, places, connectives) so
//        the reader anchors most of a typical English sentence.
//     3. DOMAIN: health -- expanded from fever/infection/treat to cover virus,
//        symptom, doctor, prescription, medicine, recover, ...
//     4. DOMAIN: daily life -- morning -> breakfast -> work -> evening -> dinner
//        -> night -> sleep -> dream chain.
//     5. OUTPUT SYNTAX patterns -- ack, see_topic, ask, describe, narrate,
//        negate -- the gated effector picks among them per intent.
//     6. OPERATORS -- causal and implicative edges connecting the above so
//        forward-chaining produces non-trivial conclusions on real input.
//     7. IMAGINATION PATTERNS -- narrative successors used by the idle
//        imagination loop.
//
//   Everything beyond this seed is learned at runtime via the learning loops
//   (ADR-0026..0030) or admin commands (/teach, /learn).
//
// ADRs implemented: ADR-0010 (boot state), ADR-0015 (language atoms), ADR-0016/
//   0017 (atoms + cross-refs), ADR-0031 (reasoning operators), ADR-0032
//   (imagination patterns), ADR-0034 (identity bootstrap). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/language/syntax_atoms.nova,
//   src/parts/reasoning/reasoning_atoms.nova,
//   src/parts/imagination/imagination_engine.nova.

import "../language/syntax_atoms.nova"
import "../parts/reasoning/reasoning_atoms.nova"
import "../parts/imagination/imagination_engine.nova"

fn _one(a) { let l = list_new() push(l, a) return l }

// Bind a word atom (interned) to a concept atom with a weighted sense.
fn _bind(lang, form, concept, weight, moment) {
    let w = word_intern(lang, form, moment)
    word_add_sense(w, concept, weight)
    return w
}

// Idempotent bulk add: for each name, ensure a concept atom in kg AND a word
// atom in lang with a sense pointing to that concept. Skips names already in
// kg, so categories may overlap safely.
fn _seed_words_set(kg, lang, names, w_weight, moment) {
    let i = 0
    let n = 0
    while i < len(names) {
        let name = names[i]
        let existing = kg_find_atom(kg, name)
        let c = existing
        if existing == 0 {
            c = kg_add_atom(kg, ATOM_CONCEPT, name, moment)
            n = n + 1
        }
        _bind(lang, name, c, w_weight, moment)
        i = i + 1
    }
    return n
}

// Add an extra word-form binding to an EXISTING concept (synonym / greeting).
// Used so e.g. "hello" anchors to the `help` concept without creating its own.
fn _alias(kg, lang, alias, target_name, weight, moment) {
    let c = kg_find_atom(kg, target_name)
    if c == 0 { return 0 }
    _bind(lang, alias, c, weight, moment)
    return 1
}

// Add a reasoning operator atom that connects two named concepts.
fn _add_op(kg, premise_name, conclusion_name, kind, label, moment) {
    let p = kg_find_atom(kg, premise_name)
    if p == 0 { return 0 }
    let c = kg_find_atom(kg, conclusion_name)
    if c == 0 { return 0 }
    rop_new(kg, kind, atom_id(p), atom_id(c), label, moment)
    return 1
}

// Bidirectional cross-KG reference between two named concepts so the reader's
// spreading activation expands a percept containing one to also activate the
// other (ADR-0017).
fn _add_xref(kg, name_a, name_b, weight, moment) {
    let a = kg_find_atom(kg, name_a)
    if a == 0 { return 0 }
    let b = kg_find_atom(kg, name_b)
    if b == 0 { return 0 }
    atom_add_xref(a, xref_new(a, b, XREF_CAUSAL, weight, moment))
    atom_add_xref(b, xref_new(b, a, XREF_CAUSAL, weight, moment))
    return 1
}

// Add an imagination pattern atom in ikg that rolls forward from one concept
// to its successor (ADR-0032).
fn _add_pat(ikg, kg, label, from_name, to_name, moment) {
    let f = kg_find_atom(kg, from_name)
    if f == 0 { return 0 }
    let t = kg_find_atom(kg, to_name)
    if t == 0 { return 0 }
    pattern_new(ikg, label, _one(atom_id(f)), _one(atom_id(t)), moment)
    return 1
}

fn seed_apply(kg, lang, ikg, moment) {
    // ---- (1) CORE INTERACTION CONCEPTS -----------------------------------
    _seed_words_set(kg, lang,
        ["self", "user", "query", "response", "help", "ok",
         "thought", "opinion", "fact", "reason", "question", "answer",
         "time", "place", "person", "way", "kind", "idea", "meaning", "purpose"],
        950, moment)

    // ---- (2) PRONOUNS + DETERMINERS --------------------------------------
    _seed_words_set(kg, lang,
        ["i", "you", "we", "they", "he", "she", "it",
         "this", "that", "these", "those", "here", "there", "now", "then"],
        900, moment)

    // ---- (3) QUESTION WORDS ----------------------------------------------
    _seed_words_set(kg, lang,
        ["what", "why", "how", "when", "where", "who", "which", "whose"],
        900, moment)

    // ---- (4) COMMON VERBS (modal + action) -------------------------------
    _seed_words_set(kg, lang,
        ["is", "are", "was", "were", "be", "been",
         "do", "does", "did", "done",
         "can", "could", "will", "would", "shall", "should", "may", "might", "must",
         "have", "has", "had",
         "want", "need", "like", "love", "hate", "wish",
         "know", "think", "feel", "believe", "understand", "remember", "forget",
         "see", "hear", "watch", "look", "listen", "say", "tell", "ask", "speak", "talk",
         "give", "take", "make", "get", "put", "find", "lose", "keep", "hold", "show",
         "go", "come", "move", "stop", "start", "begin", "end", "finish", "stay", "leave",
         "work", "use", "try", "play", "rest",
         "learn", "teach", "study", "read", "write",
         "mean", "change", "open", "close", "build", "break", "fix",
         "eat", "drink", "sleep", "wake", "walk", "run", "drive", "swim", "fly",
         "dance", "sing", "smile", "laugh", "cry"],
        900, moment)

    // ---- (5) ADJECTIVES + QUANTIFIERS ------------------------------------
    _seed_words_set(kg, lang,
        ["good", "bad", "big", "small", "large", "tiny",
         "new", "old", "young", "high", "low", "fast", "slow",
         "hot", "cold", "warm", "cool",
         "true", "false", "real", "fake",
         "many", "few", "all", "some", "any", "more", "less", "much",
         "full", "empty", "free", "busy",
         "happy", "sad", "tired", "fresh", "weak", "strong",
         "easy", "hard", "simple", "complex", "important", "right", "wrong",
         "long", "short", "deep", "shallow", "near", "far",
         "first", "last", "next", "best", "worst", "early", "late"],
        850, moment)

    // ---- (6) CORE NOUNS - general ----------------------------------------
    _seed_words_set(kg, lang,
        ["day", "year", "week", "month", "hour", "life", "world",
         "home", "family", "friend", "child", "parent",
         "water", "food", "money", "book", "music", "room",
         "problem", "name", "word", "thing", "language",
         "school", "house", "city", "country", "town", "village",
         "computer", "phone", "screen", "machine",
         "mind", "spirit", "soul", "voice",
         "story", "image", "picture", "video",
         "group", "team", "company"],
        850, moment)

    // ---- (7) BODY PARTS --------------------------------------------------
    _seed_words_set(kg, lang,
        ["body", "head", "hair", "face", "eye", "ear", "nose", "mouth", "tooth",
         "neck", "shoulder", "arm", "hand", "finger",
         "leg", "knee", "foot", "toe",
         "chest", "back", "stomach", "skin", "bone", "muscle",
         "heart", "brain", "lung", "blood"],
        850, moment)

    // ---- (8) FAMILY + PEOPLE ---------------------------------------------
    _seed_words_set(kg, lang,
        ["mother", "father", "sister", "brother", "son", "daughter",
         "uncle", "aunt", "cousin", "grandparent", "baby",
         "boy", "girl", "man", "woman",
         "neighbor", "stranger", "guest", "host", "leader", "teacher", "student"],
        800, moment)

    // ---- (9) EMOTIONS ----------------------------------------------------
    _seed_words_set(kg, lang,
        ["happiness", "sadness", "anger", "fear", "surprise",
         "calm", "worry", "excitement", "pride", "shame",
         "joy", "grief", "love", "trust"],
        850, moment)

    // ---- (10) TIME -------------------------------------------------------
    _seed_words_set(kg, lang,
        ["minute", "second", "today", "tomorrow", "yesterday",
         "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday",
         "january", "february", "march", "april", "may", "june",
         "july", "august", "september", "october", "november", "december",
         "morning", "afternoon", "evening", "night", "noon", "midnight",
         "weekend", "weekday", "holiday", "season",
         "spring", "summer", "autumn", "winter"],
        850, moment)

    // ---- (11) NUMBERS ----------------------------------------------------
    _seed_words_set(kg, lang,
        ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
         "eleven", "twelve", "twenty", "thirty", "forty", "fifty",
         "hundred", "thousand", "million", "billion",
         "half", "double", "single"],
        800, moment)

    // ---- (12) COLORS -----------------------------------------------------
    _seed_words_set(kg, lang,
        ["red", "blue", "green", "yellow", "black", "white",
         "gray", "brown", "orange", "purple", "pink", "silver", "gold"],
        800, moment)

    // ---- (13) PLACES + STRUCTURES ---------------------------------------
    _seed_words_set(kg, lang,
        ["garden", "park", "beach", "river", "lake", "mountain", "forest",
         "sea", "ocean", "island", "valley", "field", "desert",
         "road", "street", "bridge", "building", "tower",
         "church", "library", "museum", "store", "market", "shop",
         "hotel", "restaurant", "cafe", "cinema", "theater", "stadium",
         "airport", "station", "harbor",
         "kitchen", "bedroom", "bathroom", "office", "garage"],
        800, moment)

    // ---- (14) CONNECTIVES + PREPOSITIONS --------------------------------
    _seed_words_set(kg, lang,
        ["and", "but", "or", "so", "because", "if", "then", "while", "until",
         "with", "without", "from", "to", "into", "onto",
         "in", "out", "of", "off", "for", "by", "at", "on", "under", "over",
         "before", "after", "during", "since"],
        750, moment)

    // ---- (15) HEALTH DOMAIN ---------------------------------------------
    _seed_words_set(kg, lang,
        ["pain", "ache", "cough", "virus", "bacteria",
         "doctor", "nurse", "medicine", "drug", "hospital", "clinic",
         "prescription", "treatment", "vaccine",
         "symptom", "diagnosis", "disease", "illness", "headache", "allergy",
         "vitamin", "breath", "pulse", "exercise", "diet", "fitness",
         "healthy", "sick", "wounded", "recover", "heal", "dose"],
        850, moment)

    // ---- (16) DAILY ROUTINE ---------------------------------------------
    _seed_words_set(kg, lang,
        ["breakfast", "lunch", "dinner", "snack", "meal",
         "coffee", "tea", "juice", "bread", "rice", "fruit", "vegetable",
         "dream", "shower", "bath",
         "train", "plane", "bus", "car", "ticket", "journey",
         "meeting", "task", "project", "deadline",
         "hobby", "game", "party", "song", "dance"],
        800, moment)

    // ---- (17) ABSTRACTIONS the agent reasons about ----------------------
    _seed_words_set(kg, lang,
        ["energy", "power", "force", "speed", "weight", "size",
         "system", "structure", "process", "result", "cause", "effect",
         "goal", "plan", "step", "rule", "law", "right", "duty",
         "value", "cost", "price", "profit",
         "truth", "lie", "secret", "story", "history", "future", "past"],
        800, moment)

    // ---- ALIASES (extra word forms for existing concepts) --------------
    _alias(kg, lang, "hello", "help", 700, moment)   // greeting -> help concept
    _alias(kg, lang, "yes",   "ok",   700, moment)   // affirmation -> ok
    _alias(kg, lang, "no",    "false", 700, moment)  // negation -> false

    // ---- (18) ORIGINAL DEMO SEED preserved ------------------------------
    // fever/infection/treat were the v0 seed; keep them and their xrefs so the
    // daemon's "see treat" demo on a "fever" input still works out of the box.
    _seed_words_set(kg, lang, ["fever", "infection", "treat"], 900, moment)

    // ---- (19) CROSS-KG REFERENCES (spreading activation) ----------------
    _add_xref(kg, "fever", "infection", 800, moment)
    _add_xref(kg, "infection", "treat", 700, moment)
    _add_xref(kg, "doctor", "medicine", 800, moment)
    _add_xref(kg, "medicine", "treat", 700, moment)
    _add_xref(kg, "morning", "breakfast", 700, moment)
    _add_xref(kg, "night", "sleep", 800, moment)
    _add_xref(kg, "sleep", "dream", 700, moment)
    _add_xref(kg, "i", "self", 900, moment)
    _add_xref(kg, "you", "user", 900, moment)
    _add_xref(kg, "question", "answer", 800, moment)
    _add_xref(kg, "want", "need", 700, moment)
    _add_xref(kg, "help", "response", 700, moment)
    _add_xref(kg, "learn", "know", 800, moment)
    _add_xref(kg, "happy", "happiness", 700, moment)
    _add_xref(kg, "sad", "sadness", 700, moment)

    // ---- (20) REASONING OPERATORS (forward-chaining edges) --------------
    // health chain
    _add_op(kg, "virus",        "infection", ROP_CAUSAL, "virus->infection", moment)
    _add_op(kg, "infection",    "symptom",   ROP_CAUSAL, "infection->symptom", moment)
    _add_op(kg, "symptom",      "fever",     ROP_CAUSAL, "symptom->fever", moment)
    _add_op(kg, "fever",        "infection", ROP_CAUSAL, "fever->infection", moment)
    _add_op(kg, "fever",        "headache",  ROP_CAUSAL, "fever->headache", moment)
    _add_op(kg, "headache",     "pain",      ROP_CAUSAL, "headache->pain", moment)
    _add_op(kg, "doctor",       "prescription", ROP_CAUSAL, "doctor->prescription", moment)
    _add_op(kg, "prescription", "medicine",  ROP_CAUSAL, "prescription->medicine", moment)
    _add_op(kg, "medicine",     "recover",   ROP_CAUSAL, "medicine->recover", moment)
    _add_op(kg, "rest",         "recover",   ROP_CAUSAL, "rest->recover", moment)
    _add_op(kg, "exercise",     "healthy",   ROP_CAUSAL, "exercise->healthy", moment)
    _add_op(kg, "diet",         "healthy",   ROP_CAUSAL, "diet->healthy", moment)
    _add_op(kg, "vitamin",      "healthy",   ROP_CAUSAL, "vitamin->healthy", moment)
    _add_op(kg, "sick",         "rest",      ROP_IMPLY,  "sick=>rest", moment)
    _add_op(kg, "infection",    "treat",     ROP_IMPLY,  "infection=>treat", moment)

    // daily chain
    _add_op(kg, "morning",  "breakfast", ROP_CAUSAL, "morning->breakfast", moment)
    _add_op(kg, "breakfast", "energy",   ROP_CAUSAL, "breakfast->energy", moment)
    _add_op(kg, "energy",   "work",      ROP_CAUSAL, "energy->work", moment)
    _add_op(kg, "evening",  "dinner",    ROP_CAUSAL, "evening->dinner", moment)
    _add_op(kg, "dinner",   "rest",      ROP_CAUSAL, "dinner->rest", moment)
    _add_op(kg, "night",    "sleep",     ROP_CAUSAL, "night->sleep", moment)
    _add_op(kg, "sleep",    "dream",     ROP_CAUSAL, "sleep->dream", moment)
    _add_op(kg, "wake",     "morning",   ROP_CAUSAL, "wake->morning", moment)
    _add_op(kg, "work",     "tired",     ROP_CAUSAL, "work->tired", moment)

    // abstract / interaction chain
    _add_op(kg, "learn",    "know",     ROP_CAUSAL, "learn->know", moment)
    _add_op(kg, "know",     "teach",    ROP_IMPLY,  "know=>teach", moment)
    _add_op(kg, "question", "answer",   ROP_CAUSAL, "question->answer", moment)
    _add_op(kg, "need",     "help",     ROP_CAUSAL, "need->help", moment)
    _add_op(kg, "help",     "response", ROP_CAUSAL, "help->response", moment)
    _add_op(kg, "ask",      "answer",   ROP_CAUSAL, "ask->answer", moment)
    _add_op(kg, "see",      "know",     ROP_CAUSAL, "see->know", moment)
    _add_op(kg, "i",        "self",     ROP_IMPLY,  "i=>self", moment)
    _add_op(kg, "you",      "user",     ROP_IMPLY,  "you=>user", moment)
    _add_op(kg, "happy",    "happiness", ROP_IMPLY, "happy=>happiness", moment)
    _add_op(kg, "sad",      "sadness",   ROP_IMPLY, "sad=>sadness", moment)

    // ---- (21) IMAGINATION PATTERNS (narrative successors) ---------------
    _add_pat(ikg, kg, "spread_fever",     "fever",        "infection",   moment)
    _add_pat(ikg, kg, "spread_infection", "infection",    "treat",       moment)
    _add_pat(ikg, kg, "spread_doctor",    "doctor",       "prescription", moment)
    _add_pat(ikg, kg, "spread_medicine",  "medicine",     "recover",     moment)
    _add_pat(ikg, kg, "spread_morning",   "morning",      "breakfast",   moment)
    _add_pat(ikg, kg, "spread_breakfast", "breakfast",    "energy",      moment)
    _add_pat(ikg, kg, "spread_night",     "night",        "sleep",       moment)
    _add_pat(ikg, kg, "spread_sleep",     "sleep",        "dream",       moment)
    _add_pat(ikg, kg, "spread_question",  "question",     "answer",      moment)
    _add_pat(ikg, kg, "spread_learn",     "learn",        "know",        moment)
    _add_pat(ikg, kg, "spread_need",      "need",         "help",        moment)
    _add_pat(ikg, kg, "spread_help",      "help",         "response",    moment)

    // ---- (22) OUTPUT SYNTAX PATTERNS ------------------------------------
    // The gated effector picks among these based on the intent's role names.
    // ack covers fallback acknowledgements; see_topic speaks a reasoning
    // conclusion; ask/describe/narrate/negate provide more conversational
    // shapes for future intent builders.
    syntax_atom_new(lang, "ack",       ["ACK"],                   moment)
    syntax_atom_new(lang, "see_topic", ["SEE", "TOPIC"],          moment)
    syntax_atom_new(lang, "ask",       ["QUERY", "TOPIC"],        moment)
    syntax_atom_new(lang, "describe",  ["TOPIC", "IS", "ADJ"],    moment)
    syntax_atom_new(lang, "narrate",   ["SUBJECT", "VERB", "OBJECT"], moment)
    syntax_atom_new(lang, "negate",    ["NOT", "TOPIC"],          moment)

    return kg_atom_count(kg)
}
