// Chat federation slash-command helpers (Phase M R1, ADR-0089).
//
// Purpose
//   The four gossip / kg-sync / distributed-query slash commands the
//   REPL grew in R1 -- `/gossip_start`, `/gossip_peer add <addr>`,
//   `/gossip_peers`, `/gossip_dq <query>` -- have a small pure core
//   (arg parsing, output formatting) that used to be tangled inside
//   `_try_admin` in `examples/crossengin_chat.nova`. This module lifts
//   the pure surface so unit tests can call it directly without spinning
//   up the whole chat process.
//
//   Each helper takes the OPAQUE gossip / dq state as an argument and
//   returns a formatted output string; the caller (`crossengin_chat.nova`)
//   is responsible for println'ing that string, allocating the state on
//   the first `/gossip_start`, and threading it through subsequent
//   commands via a module-level singleton.
//
// ADRs implemented: ADR-0049 (testing and benchmarks; the pure surface
//   is what the unit tests target), ADR-0089 (federation daemon MVP;
//   this file is one of R1's two entry points into the mesh).

import "../federation/gossip.nova"
import "../federation/distributed_query.nova"

// ---- /gossip_start [addr] ------------------------------------------------
//
// Parse the optional address argument (falls back to the R1 default
// `127.0.0.1:8790` when arg is empty, matching the fed daemon's
// CE_FED_LISTEN_ADDR default). Callers hold the "already started"
// bit and dispatch on it -- this helper only formats the two possible
// output lines and returns the effective listen addr so the caller
// can hand it to gossip_init.

let CE_CHAT_FED_DEFAULT_ADDR = "127.0.0.1:8790"

// Return the effective listen address given the slash-command arg.
// Empty arg -> default; non-empty arg -> arg (trimmed).
fn chat_fed_pick_listen_addr(arg) {
    if arg == 0 { return CE_CHAT_FED_DEFAULT_ADDR }
    let t = str_trim(arg)
    if len(t) == 0 { return CE_CHAT_FED_DEFAULT_ADDR }
    return t
}

// Format the "already running" line (used when /gossip_start runs a
// second time in the same session).
fn chat_fed_gossip_already_running_line(addr) {
    return "gossip: already running on " + addr
}

// Format the boot-success line (used after gossip_init + gossip_listen
// return non-null).
fn chat_fed_gossip_started_line(addr, fd) {
    let base = "gossip: started on " + addr
    if fd < 0 {
        return base + " (WARN: listen bind failed; client-only mode)"
    }
    return base + " fd=" + int_to_str(fd)
}

// ---- /gossip_peer add <addr> ---------------------------------------------
//
// Parse the sub-command out of the arg string. R1 recognises only
// `add <addr>`; the plan sketches `remove` / `list` for future rounds.
// Returns a list [action, addr]; action is one of "add", "unknown".
// A missing addr yields action="add", addr="".

fn chat_fed_parse_peer_command(arg) {
    let out = list_new()
    if arg == 0 {
        push(out, "unknown")
        push(out, "")
        return out
    }
    let t = str_trim(arg)
    if len(t) == 0 {
        push(out, "unknown")
        push(out, "")
        return out
    }
    // Split on first space.
    let sp = 0 - 1
    let i = 0
    while i < len(t) {
        if char_at(t, i) == 32 { sp = i i = len(t) }
        i = i + 1
    }
    let head = t
    let rest = ""
    if sp >= 0 {
        head = substr(t, 0, sp)
        if sp + 1 < len(t) {
            rest = str_trim(substr(t, sp + 1, len(t) - sp - 1))
        }
    }
    if str_eq_bytes(head, "add") == 1 {
        push(out, "add")
        push(out, rest)
        return out
    }
    push(out, "unknown")
    push(out, rest)
    return out
}

// "gossip: no state; /gossip_start first" -- unified "state missing" line.
fn chat_fed_gossip_no_state_line() {
    return "gossip: no state; run /gossip_start first"
}

// After a successful gossip_add_peer, format the confirmation line.
fn chat_fed_peer_added_line(addr, peer_count) {
    return "gossip_peer: add " + addr
        + " (peers=" + int_to_str(peer_count) + ")"
}

// When the sub-command is unrecognised.
fn chat_fed_peer_unknown_op_line() {
    return "gossip_peer: usage -- /gossip_peer add <addr>"
}

// ---- /gossip_peers -------------------------------------------------------
//
// Render the peer table as one line per entry:
//   "<addr> <status> last_seen=<ns>"
// Status is the numeric enum -- ALIVE=0, SUSPECT=1, DEAD=2 -- rendered
// as its symbolic name for readability. The caller prepends a header
// line ("gossip_peers: N entries") and prints each row via println.

fn chat_fed_status_label(status) {
    if status == GOSSIP_STATUS_ALIVE   { return "ALIVE" }
    if status == GOSSIP_STATUS_SUSPECT { return "SUSPECT" }
    if status == GOSSIP_STATUS_DEAD    { return "DEAD" }
    return "?"
}

// One row of the peer-listing output. Kept pure so tests can validate
// the exact wire shape without walking the peer table.
fn chat_fed_peer_row_line(addr, status, last_seen_ns) {
    return "  " + addr
        + " " + chat_fed_status_label(status)
        + " last_seen=" + int_to_str(last_seen_ns)
}

fn chat_fed_peers_header_line(count) {
    return "gossip_peers: " + int_to_str(count) + " entries"
}

// Render the full peer-table output as a list of lines, in-order,
// starting with the header. Pure -- callers println each element.
fn chat_fed_peers_render(gs) {
    let out = list_new()
    let peers = gossip_peer_table(gs)
    push(out, chat_fed_peers_header_line(len(peers)))
    let i = 0
    while i < len(peers) {
        let p = peers[i]
        push(out, chat_fed_peer_row_line(gossip_peer_addr(p),
                                         gossip_peer_status(p),
                                         gossip_peer_last_seen(p)))
        i = i + 1
    }
    return out
}

// ---- /gossip_dq <query> --------------------------------------------------
//
// Parse the query text (arg after the slash command). Empty arg -> ""
// (caller prints usage). Non-empty arg -> trimmed query text ready
// for dq_query.

fn chat_fed_pick_query_text(arg) {
    if arg == 0 { return "" }
    return str_trim(arg)
}

fn chat_fed_dq_usage_line() {
    return "gossip_dq: usage -- /gossip_dq <query-text>"
}

fn chat_fed_dq_no_state_line() {
    return "gossip_dq: no state; run /gossip_start first"
}

fn chat_fed_dq_result_header(row_count) {
    return "gossip_dq: " + int_to_str(row_count) + " row(s)"
}
