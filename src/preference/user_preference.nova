// CrossEngin: per-user preference registry (R101, ADR-0205 Mode 2 --
// "per-user selective load").
//
// A PREFERENCE REGISTRY maps `(holder, kind, name) -> enabled` where
// `enabled` is 0 (soft-hide) or 1 (soft-show). Absence of a preference
// entry means DEFAULT-VISIBLE -- the check falls through to whatever
// the ownership overlay says (see visibility_visible in ownership.nova).
//
// The registry is a SOFT FILTER layered ON TOP of R55.2 ownership.
// Ownership is the hard boundary (operator-set, admin-only mutation);
// preferences are the caller's own opt-in list within what ownership
// already allows.
//
// Semantics
// ---------
//
//   composed_visible(H, kind, name) =
//       ownership_visible(overlay, kind, name, H)
//   AND preference_visible(pref_reg, H, kind, name)
//
// * ownership decides "is H allowed to see this at all?"
// * preference decides "does H currently want to see it?"
//
// Kinds match the R55.2 ownership kinds so a single verb/wire caller
// can talk about capsule / skill / pattern / kg with one identifier
// scheme. New kinds get added in one place (both here and in
// ownership.nova).
//
// Wildcards
// ---------
//
// A preference entry with the LITERAL name "*" applies to EVERY name of
// that kind for that holder. Only kind-wide disable makes practical
// sense today (a user saying "hide all pattern packs from me"); a
// wildcard ENABLE also stores but is a no-op in the visibility check
// (a not-present entry is already treated as visible). Only the literal
// single-char "*" triggers wildcard behavior -- no glob matching.
//
// NOVA quirks respected: str_eq_bytes for all string equality; no
// nested lookups on possibly-null lists; explicit len() >= 0 checks.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- kind constants -----------------------------------------------------
//
// Bytewise identical to the OWN_KIND_* strings in
// src/sandbox/ownership.nova so the two registries agree on names.
// (Kept as separate constants to avoid a hard import cycle -- ownership
// itself imports nothing from preference; the composed helper lives in
// ownership.nova and reaches back here.)

let PREF_KIND_CAPSULE = "capsule"
let PREF_KIND_SKILL   = "skill"
let PREF_KIND_PATTERN = "pattern"
let PREF_KIND_KG      = "kg"

fn preference_is_known_kind(kind) {
    if str_eq_bytes(kind, PREF_KIND_CAPSULE) == 1 { return 1 }
    if str_eq_bytes(kind, PREF_KIND_SKILL)   == 1 { return 1 }
    if str_eq_bytes(kind, PREF_KIND_PATTERN) == 1 { return 1 }
    if str_eq_bytes(kind, PREF_KIND_KG)      == 1 { return 1 }
    return 0
}

fn preference_kinds() {
    let out = list_new()
    push(out, PREF_KIND_CAPSULE)
    push(out, PREF_KIND_SKILL)
    push(out, PREF_KIND_PATTERN)
    push(out, PREF_KIND_KG)
    return out
}

// ---- entry slot layout --------------------------------------------------
//
// [holder, kind, name, enabled]. Flat list, small; scan-based lookup
// suffices (users typically toggle only a handful of items).

let PREF_ENTRY_HOLDER  = 0
let PREF_ENTRY_KIND    = 1
let PREF_ENTRY_NAME    = 2
let PREF_ENTRY_ENABLED = 3

// ---- registry constructor + accessors ----------------------------------

fn preference_registry_new() {
    let r = list_new()
    push(r, list_new())     // entries
    return r
}

fn _pref_entries(reg) { return reg[0] }

fn preference_registry_count_all(reg) {
    if reg == 0 { return 0 }
    return len(reg[0])
}

// Look up a (holder, kind, name) entry. Returns the entry (list) or 0.
fn _pref_find(reg, holder, kind, name) {
    if reg == 0 { return 0 }
    let es = _pref_entries(reg)
    let i = 0
    while i < len(es) {
        let e = es[i]
        if str_eq_bytes(e[PREF_ENTRY_HOLDER], holder) == 1 {
            if str_eq_bytes(e[PREF_ENTRY_KIND], kind) == 1 {
                if str_eq_bytes(e[PREF_ENTRY_NAME], name) == 1 {
                    return e
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ---- public API ---------------------------------------------------------

// Set (or overwrite) a preference. `enabled` must be 0 or 1.
// Returns 1 on success, 0 on rejected input (unknown kind / empty
// name / invalid enabled).
fn preference_set(reg, holder, kind, name, enabled) {
    if reg == 0 { return 0 }
    if preference_is_known_kind(kind) == 0 { return 0 }
    if len(name) == 0 { return 0 }
    if enabled != 0 { if enabled != 1 { return 0 } }
    let existing = _pref_find(reg, holder, kind, name)
    if existing != 0 {
        list_set(existing, PREF_ENTRY_ENABLED, enabled)
        return 1
    }
    let e = list_new()
    push(e, holder)
    push(e, kind)
    push(e, name)
    push(e, enabled)
    push(_pref_entries(reg), e)
    return 1
}

// Remove a single (holder, kind, name) preference. Returns 1 if an
// entry was removed, 0 otherwise.
fn preference_clear(reg, holder, kind, name) {
    if reg == 0 { return 0 }
    let es = _pref_entries(reg)
    let out = list_new()
    let removed = 0
    let i = 0
    while i < len(es) {
        let e = es[i]
        let hit = 0
        if str_eq_bytes(e[PREF_ENTRY_HOLDER], holder) == 1 {
            if str_eq_bytes(e[PREF_ENTRY_KIND], kind) == 1 {
                if str_eq_bytes(e[PREF_ENTRY_NAME], name) == 1 {
                    hit = 1
                }
            }
        }
        if hit == 1 { removed = 1 }
        else        { push(out, e) }
        i = i + 1
    }
    list_set(reg, 0, out)
    return removed
}

// Remove EVERY preference for `holder`. Returns the number of entries
// removed (may be 0). Used by "user.preference.clear all=1".
fn preference_clear_all(reg, holder) {
    if reg == 0 { return 0 }
    let es = _pref_entries(reg)
    let out = list_new()
    let removed = 0
    let i = 0
    while i < len(es) {
        let e = es[i]
        if str_eq_bytes(e[PREF_ENTRY_HOLDER], holder) == 1 {
            removed = removed + 1
        } else {
            push(out, e)
        }
        i = i + 1
    }
    list_set(reg, 0, out)
    return removed
}

// Read a preference: returns 1 = explicitly enabled, 0 = explicitly
// disabled, -1 = unset.
fn preference_get(reg, holder, kind, name) {
    let e = _pref_find(reg, holder, kind, name)
    if e == 0 { return 0 - 1 }
    return e[PREF_ENTRY_ENABLED]
}

// The composed-visibility check. Returns 0 (hidden) or 1 (visible).
//
// Rules (composed with ownership by visibility_visible in
// ownership.nova):
//   * reg == 0 (no preference registry wired) -> 1 (fall through)
//   * explicit entry for (holder, kind, name) -> its `enabled` bit
//   * wildcard entry for (holder, kind, "*") disabled -> 0
//   * otherwise -> 1 (default visible)
//
// A wildcard-ENABLE has no effect: absence-means-visible already, so
// storing a "*"=1 entry is a no-op in the check (still respects an
// explicit per-name disable if one exists; wildcard is checked LAST).
fn preference_visible(reg, holder, kind, name) {
    if reg == 0 { return 1 }
    // Explicit per-name entry wins.
    let e = _pref_find(reg, holder, kind, name)
    if e != 0 {
        if e[PREF_ENTRY_ENABLED] == 0 { return 0 }
        return 1
    }
    // Kind-wide wildcard disable.
    let w = _pref_find(reg, holder, kind, "*")
    if w != 0 {
        if w[PREF_ENTRY_ENABLED] == 0 { return 0 }
    }
    return 1
}

// Enumerate every entry as [holder, kind, name, enabled] triples.
// For admin audit surfaces + the wire user.preference.list verb.
fn preference_entries(reg) {
    if reg == 0 { return list_new() }
    return _pref_entries(reg)
}

// List preferences owned by one holder as [kind, name, enabled] rows.
fn preference_list_for_holder(reg, holder) {
    let out = list_new()
    if reg == 0 { return out }
    let es = _pref_entries(reg)
    let i = 0
    while i < len(es) {
        let e = es[i]
        if str_eq_bytes(e[PREF_ENTRY_HOLDER], holder) == 1 {
            let row = list_new()
            push(row, e[PREF_ENTRY_KIND])
            push(row, e[PREF_ENTRY_NAME])
            push(row, e[PREF_ENTRY_ENABLED])
            push(out, row)
        }
        i = i + 1
    }
    return out
}

// Count preferences owned by one holder.
fn preference_count(reg, holder) {
    if reg == 0 { return 0 }
    let es = _pref_entries(reg)
    let n = 0
    let i = 0
    while i < len(es) {
        let e = es[i]
        if str_eq_bytes(e[PREF_ENTRY_HOLDER], holder) == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
