// CrossEngin agents: per-session AgentRegistry (R109, ADR-0210 tier 2).
//
// Mirrors src/skills/skill_registry.nova shape:
//   * one registry per Session (like SkillRegistry / PersonaRegistry)
//   * registered vs installed vs retired -- a manifest can live in the
//     registry (audit) without being installable; install checks that
//     every capsule/skill dep is registered + visible; retire flips a
//     terminal flag so subsequent agent.run refuses cleanly but the
//     entry stays for audit.
//
// The `supervisor` slot is a cached-per-agent handle -- currently unused
// (agent_run builds a per-call supervisor because style-pin needs a
// per-run persona clone). Slot preserved so a future round can memoize
// a common configuration.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/agents/agent_manifest.nova
//   src/skills/skill_registry.nova (dep existence checks)
//   src/util/str_safe.nova.

import "./agent_manifest.nova"
import "../skills/skill_registry.nova"
import "../util/str_safe.nova"

// ---- registry entry slots ----------------------------------------------
let AR_MANIFEST     = 0
let AR_INSTALLED    = 1   // 0/1
let AR_INSTALLED_AT = 2   // moment; 0 when not installed
let AR_RETIRED_AT   = 3   // moment; 0 when not retired
let AR_SUPERVISOR   = 4   // reserved; 0 today
let AR_SLOT_COUNT   = 5

// ---- registry slot layout ----------------------------------------------
let AGREG_ENTRIES = 0

// ---- install-result codes ----------------------------------------------
let AGENT_INSTALL_OK              = 0
let AGENT_INSTALL_UNKNOWN         = -1  // agent not registered
let AGENT_INSTALL_ALREADY         = -2  // already installed
let AGENT_INSTALL_SKILL_MISSING   = -3  // a SKILL_DEP is not registered
let AGENT_INSTALL_RETIRED         = -4  // agent was retired
let AGENT_INSTALL_NO_SKILL_DEPS   = -5  // manifest has no skill deps

// ---- constructor + queries ---------------------------------------------

fn agent_registry_new() {
    let r = list_new()
    push(r, list_new())         // ENTRIES
    return r
}

fn agent_registry_count(reg)   { return len(reg[AGREG_ENTRIES]) }
fn agent_registry_entries(reg) { return reg[AGREG_ENTRIES] }

// Look up a registry entry by agent name. Returns the entry (5-list),
// or 0 if absent.
fn agent_registry_lookup(reg, name) {
    if reg == 0 { return 0 }
    let entries = reg[AGREG_ENTRIES]
    let i = 0
    while i < len(entries) {
        let m = entries[i][AR_MANIFEST]
        if str_eq_bytes(agent_manifest_name(m), name) == 1 { return entries[i] }
        i = i + 1
    }
    return 0
}

// Convenience: manifest by name (0 if absent).
fn agent_registry_manifest(reg, name) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[AR_MANIFEST]
}

fn agent_registry_is_installed(reg, name) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[AR_INSTALLED]
}

fn agent_registry_is_retired(reg, name) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    if e[AR_RETIRED_AT] > 0 { return 1 }
    return 0
}

fn agent_registry_installed_at(reg, name) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[AR_INSTALLED_AT]
}

fn agent_registry_retired_at(reg, name) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[AR_RETIRED_AT]
}

fn agent_registry_supervisor(reg, name) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[AR_SUPERVISOR]
}

// ---- register ----------------------------------------------------------

// Register a manifest under its own name. Returns 1 on insert; 0 if a
// name collision. Idempotent by name.
fn agent_registry_register(reg, manifest) {
    if reg == 0 { return 0 }
    if manifest == 0 { return 0 }
    let name = agent_manifest_name(manifest)
    if len(name) == 0 { return 0 }
    if agent_registry_lookup(reg, name) != 0 { return 0 }
    let e = list_new()
    push(e, manifest)         // MANIFEST
    push(e, 0)                 // INSTALLED
    push(e, 0)                 // INSTALLED_AT
    push(e, 0)                 // RETIRED_AT
    push(e, 0)                 // SUPERVISOR
    push(reg[AGREG_ENTRIES], e)
    return 1
}

// ---- install ----------------------------------------------------------

// Install a registered agent. Verifies every SKILL_DEP is registered in
// `skill_reg` (skills must exist for dispatch to make sense). Pass
// `skill_reg = 0` to skip the check (test convenience). Returns an
// AGENT_INSTALL_* code.
fn agent_registry_install(reg, name, skill_reg, now) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return AGENT_INSTALL_UNKNOWN }
    if e[AR_RETIRED_AT] > 0 { return AGENT_INSTALL_RETIRED }
    if e[AR_INSTALLED] == 1 { return AGENT_INSTALL_ALREADY }
    let manifest = e[AR_MANIFEST]
    let sdeps = agent_manifest_skill_deps(manifest)
    if len(sdeps) == 0 { return AGENT_INSTALL_NO_SKILL_DEPS }
    if skill_reg != 0 {
        let i = 0
        while i < len(sdeps) {
            if skill_registry_manifest(skill_reg, sdeps[i]) == 0 {
                return AGENT_INSTALL_SKILL_MISSING
            }
            i = i + 1
        }
    }
    list_set(e, AR_INSTALLED, 1)
    list_set(e, AR_INSTALLED_AT, now)
    return AGENT_INSTALL_OK
}

// Human-readable label for an install-result code.
fn agent_install_name(code) {
    if code == AGENT_INSTALL_OK             { return "ok" }
    if code == AGENT_INSTALL_UNKNOWN        { return "unknown-agent" }
    if code == AGENT_INSTALL_ALREADY        { return "already-installed" }
    if code == AGENT_INSTALL_SKILL_MISSING  { return "required-skill-missing" }
    if code == AGENT_INSTALL_RETIRED        { return "agent-retired" }
    if code == AGENT_INSTALL_NO_SKILL_DEPS  { return "no-skill-deps" }
    return "unknown-code"
}

// ---- retire -----------------------------------------------------------

// Mark an agent retired. Idempotent -- retiring an already-retired
// agent returns 0 (no state change). Retired agents cannot be
// re-installed (returns AGENT_INSTALL_RETIRED). Returns 1 on the state
// change, 0 otherwise.
fn agent_registry_retire(reg, name, now) {
    let e = agent_registry_lookup(reg, name)
    if e == 0 { return 0 }
    if e[AR_RETIRED_AT] > 0 { return 0 }
    list_set(e, AR_RETIRED_AT, now)
    // Retire clears the installed flag too -- an operator can't invoke
    // a retired agent. INSTALLED_AT is preserved for audit.
    list_set(e, AR_INSTALLED, 0)
    return 1
}

// ---- listing helpers ---------------------------------------------------

// Names of every registered agent.
fn agent_registry_names(reg) {
    if reg == 0 { return list_new() }
    let out = list_new()
    let entries = reg[AGREG_ENTRIES]
    let i = 0
    while i < len(entries) {
        push(out, agent_manifest_name(entries[i][AR_MANIFEST]))
        i = i + 1
    }
    return out
}

// Names of currently-installed (non-retired) agents.
fn agent_registry_installed_names(reg) {
    if reg == 0 { return list_new() }
    let out = list_new()
    let entries = reg[AGREG_ENTRIES]
    let i = 0
    while i < len(entries) {
        if entries[i][AR_INSTALLED] == 1 {
            if entries[i][AR_RETIRED_AT] == 0 {
                push(out, agent_manifest_name(entries[i][AR_MANIFEST]))
            }
        }
        i = i + 1
    }
    return out
}

// Remove an agent entirely (audit-erasing; use retire instead unless
// you're clearing test fixtures). Returns 1 on remove, 0 if not found.
fn agent_registry_remove(reg, name) {
    if reg == 0 { return 0 }
    let entries = reg[AGREG_ENTRIES]
    let idx = 0 - 1
    let i = 0
    while i < len(entries) {
        let m = entries[i][AR_MANIFEST]
        if str_eq_bytes(agent_manifest_name(m), name) == 1 {
            idx = i
            i = len(entries)
        }
        i = i + 1
    }
    if idx < 0 { return 0 }
    let kept = list_new()
    let j = 0
    while j < len(entries) {
        if j != idx { push(kept, entries[j]) }
        j = j + 1
    }
    list_set(reg, AGREG_ENTRIES, kept)
    return 1
}
