// CrossEngin agents: pattern-driven agent manifest (R109, ADR-0210 tier 2).
//
// An AgentManifest is the DECLARATIVE contract for a pattern-driven agent
// composed from `capsule + pattern + skill` triples. Runtime `agent.run`
// resolves the manifest at dispatch time -- picks a supervisor per
// skill_dep in listed order, filters pattern matches through
// pattern_deps, applies a per-run persona style-pin, and returns the
// first non-refused ProposalResult whose confidence >= min_confidence.
//
// This module is DATA + PARSER only -- registry lifecycle lives in
// src/agents/agent_registry.nova, dispatch in src/agents/agent_run.nova.
//
// File format (line-oriented text; comments start with '#'):
//
//   AGENT-MANIFEST v1
//   NAME <name>
//   VERSION <ver>
//   DESCRIPTION <text>
//   CAPSULE_DEP <name>          # repeatable
//   SKILL_DEP <name>            # repeatable, in-order
//   PATTERN_DEP <name>          # repeatable; empty list = every pattern
//   STYLE_PIN <capsule_name>    # optional
//   PERSONA_PIN <user_id>       # optional
//   MIN_CONFIDENCE_MILLI <int>
//   ATTRIBUTION_PREF <tag>      # optional; default src:agent:<name>:v<ver>
//   LICENSE <license>
//
// Validation:
//   * NAME + VERSION required and non-empty.
//   * SKILL_DEP list must be non-empty (an agent with no skills has
//     nothing to dispatch to).
//   * Unknown directives cause parse to refuse citing the head token.
//   * Blank + comment lines ignored.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- version banner ----------------------------------------------------

let AGENT_MANIFEST_VERSION_LINE = "AGENT-MANIFEST v1"

// ---- AgentManifest slot layout -----------------------------------------
let AM_NAME                 = 0
let AM_VERSION              = 1
let AM_DESCRIPTION          = 2
let AM_CAPSULE_DEPS         = 3   // list<string>
let AM_SKILL_DEPS           = 4   // list<string>
let AM_PATTERN_DEPS         = 5   // list<string>
let AM_STYLE_PIN            = 6   // string ("" = none)
let AM_PERSONA_PIN          = 7   // string ("" = caller's persona)
let AM_MIN_CONFIDENCE_MILLI = 8   // int
let AM_ATTRIBUTION_PREF     = 9   // string
let AM_LICENSE              = 10  // string
let AM_SLOT_COUNT           = 11

// ---- constructor -------------------------------------------------------

fn agent_manifest_new(name, version, description) {
    let m = list_new()
    push(m, name)                         // NAME
    push(m, version)                      // VERSION
    push(m, description)                  // DESCRIPTION
    push(m, list_new())                   // CAPSULE_DEPS
    push(m, list_new())                   // SKILL_DEPS
    push(m, list_new())                   // PATTERN_DEPS
    push(m, "")                           // STYLE_PIN
    push(m, "")                           // PERSONA_PIN
    push(m, 0)                            // MIN_CONFIDENCE_MILLI
    push(m, "src:agent:" + name + ":v" + version)  // ATTRIBUTION_PREF
    push(m, "unspecified")                // LICENSE
    return m
}

// ---- accessors ---------------------------------------------------------

fn agent_manifest_name(m)                 { return m[AM_NAME] }
fn agent_manifest_version(m)              { return m[AM_VERSION] }
fn agent_manifest_description(m)          { return m[AM_DESCRIPTION] }
fn agent_manifest_capsule_deps(m)         { return m[AM_CAPSULE_DEPS] }
fn agent_manifest_skill_deps(m)           { return m[AM_SKILL_DEPS] }
fn agent_manifest_pattern_deps(m)         { return m[AM_PATTERN_DEPS] }
fn agent_manifest_style_pin(m)            { return m[AM_STYLE_PIN] }
fn agent_manifest_persona_pin(m)          { return m[AM_PERSONA_PIN] }
fn agent_manifest_min_confidence_milli(m) { return m[AM_MIN_CONFIDENCE_MILLI] }
fn agent_manifest_attribution(m)          { return m[AM_ATTRIBUTION_PREF] }
fn agent_manifest_license(m)              { return m[AM_LICENSE] }

fn agent_manifest_capsule_dep_count(m)    { return len(m[AM_CAPSULE_DEPS]) }
fn agent_manifest_skill_dep_count(m)      { return len(m[AM_SKILL_DEPS]) }
fn agent_manifest_pattern_dep_count(m)    { return len(m[AM_PATTERN_DEPS]) }

// ---- mutators (idempotent by exact byte match) -------------------------

fn _am_list_has(lst, needle) {
    let i = 0
    while i < len(lst) {
        if str_eq_bytes(lst[i], needle) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn agent_manifest_add_capsule_dep(m, name) {
    if _am_list_has(m[AM_CAPSULE_DEPS], name) == 1 { return 0 }
    push(m[AM_CAPSULE_DEPS], name)
    return 1
}

fn agent_manifest_add_skill_dep(m, name) {
    if _am_list_has(m[AM_SKILL_DEPS], name) == 1 { return 0 }
    push(m[AM_SKILL_DEPS], name)
    return 1
}

fn agent_manifest_add_pattern_dep(m, name) {
    if _am_list_has(m[AM_PATTERN_DEPS], name) == 1 { return 0 }
    push(m[AM_PATTERN_DEPS], name)
    return 1
}

fn agent_manifest_set_style_pin(m, name)     { list_set(m, AM_STYLE_PIN, name) return 1 }
fn agent_manifest_set_persona_pin(m, uid)    { list_set(m, AM_PERSONA_PIN, uid) return 1 }
fn agent_manifest_set_min_confidence(m, milli) {
    let v = milli
    if v < 0    { v = 0 }
    if v > 1000 { v = 1000 }
    list_set(m, AM_MIN_CONFIDENCE_MILLI, v)
    return 1
}
fn agent_manifest_set_attribution(m, tag) {
    if len(tag) > 0 { list_set(m, AM_ATTRIBUTION_PREF, tag) }
    return 1
}
fn agent_manifest_set_license(m, lic)        { list_set(m, AM_LICENSE, lic) return 1 }

// ---- parser -------------------------------------------------------------

// Return [head, rest] where rest may be empty ("").
fn _am_split_head(line) {
    let n = len(line)
    let sp = find_char(line, 32)
    if sp <= 0 {
        let out = list_new() push(out, line) push(out, "") return out
    }
    let head = substr(line, 0, sp)
    let rest = substr(line, sp + 1, n - sp - 1)
    let out = list_new()
    push(out, head) push(out, rest)
    return out
}

fn _am_known_directive(head) {
    if str_eq_bytes(head, "NAME")                 == 1 { return 1 }
    if str_eq_bytes(head, "VERSION")              == 1 { return 1 }
    if str_eq_bytes(head, "DESCRIPTION")          == 1 { return 1 }
    if str_eq_bytes(head, "CAPSULE_DEP")          == 1 { return 1 }
    if str_eq_bytes(head, "SKILL_DEP")            == 1 { return 1 }
    if str_eq_bytes(head, "PATTERN_DEP")          == 1 { return 1 }
    if str_eq_bytes(head, "STYLE_PIN")            == 1 { return 1 }
    if str_eq_bytes(head, "PERSONA_PIN")          == 1 { return 1 }
    if str_eq_bytes(head, "MIN_CONFIDENCE_MILLI") == 1 { return 1 }
    if str_eq_bytes(head, "ATTRIBUTION_PREF")     == 1 { return 1 }
    if str_eq_bytes(head, "LICENSE")              == 1 { return 1 }
    return 0
}

// Left-trim spaces + tabs.
fn _am_ltrim(s) {
    let n = len(s)
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c != 32 { if c != 9 { return substr(s, i, n - i) } }
        i = i + 1
    }
    return ""
}

// Parse a manifest text. Returns [ok, manifest_or_0, err_str].
fn agent_manifest_parse(text) {
    let ret = list_new()
    if len(text) == 0 {
        push(ret, 0) push(ret, 0) push(ret, "empty manifest text")
        return ret
    }
    // Build with placeholder name/version; set as we parse.
    let m = agent_manifest_new("", "", "")
    let n = len(text)
    let start = 0
    let i = 0
    let saw_banner = 0
    while i <= n {
        let boundary = 0
        if i == n { boundary = 1 }
        else { if char_at(text, i) == 10 { boundary = 1 } }
        if boundary == 1 {
            let raw = substr(text, start, i - start)
            let ln = len(raw)
            if ln > 0 { if char_at(raw, ln - 1) == 13 {
                raw = substr(raw, 0, ln - 1)
            } }
            let trimmed = _am_ltrim(raw)
            if len(trimmed) > 0 { if char_at(trimmed, 0) != 35 {
                if saw_banner == 0 {
                    if str_eq_bytes(trimmed, AGENT_MANIFEST_VERSION_LINE) == 1 {
                        saw_banner = 1
                    } else {
                        push(ret, 0) push(ret, 0)
                        push(ret, "manifest must begin with '" + AGENT_MANIFEST_VERSION_LINE + "'")
                        return ret
                    }
                } else {
                    let hr = _am_split_head(trimmed)
                    let head = hr[0]
                    let rest = hr[1]
                    if _am_known_directive(head) == 0 {
                        push(ret, 0) push(ret, 0)
                        push(ret, "unknown directive: " + head)
                        return ret
                    }
                    if str_eq_bytes(head, "NAME") == 1 {
                        if len(rest) == 0 {
                            push(ret, 0) push(ret, 0)
                            push(ret, "NAME directive missing value") return ret
                        }
                        list_set(m, AM_NAME, rest)
                        // Refresh attribution default if it was still auto.
                        list_set(m, AM_ATTRIBUTION_PREF,
                                 "src:agent:" + rest + ":v" + m[AM_VERSION])
                    } else { if str_eq_bytes(head, "VERSION") == 1 {
                        if len(rest) == 0 {
                            push(ret, 0) push(ret, 0)
                            push(ret, "VERSION directive missing value") return ret
                        }
                        list_set(m, AM_VERSION, rest)
                        list_set(m, AM_ATTRIBUTION_PREF,
                                 "src:agent:" + m[AM_NAME] + ":v" + rest)
                    } else { if str_eq_bytes(head, "DESCRIPTION") == 1 {
                        list_set(m, AM_DESCRIPTION, rest)
                    } else { if str_eq_bytes(head, "CAPSULE_DEP") == 1 {
                        if len(rest) > 0 { agent_manifest_add_capsule_dep(m, rest) }
                    } else { if str_eq_bytes(head, "SKILL_DEP") == 1 {
                        if len(rest) > 0 { agent_manifest_add_skill_dep(m, rest) }
                    } else { if str_eq_bytes(head, "PATTERN_DEP") == 1 {
                        if len(rest) > 0 { agent_manifest_add_pattern_dep(m, rest) }
                    } else { if str_eq_bytes(head, "STYLE_PIN") == 1 {
                        list_set(m, AM_STYLE_PIN, rest)
                    } else { if str_eq_bytes(head, "PERSONA_PIN") == 1 {
                        list_set(m, AM_PERSONA_PIN, rest)
                    } else { if str_eq_bytes(head, "MIN_CONFIDENCE_MILLI") == 1 {
                        let v = str_to_int(rest)
                        agent_manifest_set_min_confidence(m, v)
                    } else { if str_eq_bytes(head, "ATTRIBUTION_PREF") == 1 {
                        agent_manifest_set_attribution(m, rest)
                    } else { if str_eq_bytes(head, "LICENSE") == 1 {
                        if len(rest) > 0 { list_set(m, AM_LICENSE, rest) }
                    } } } } } } } } } } }
                }
            } }
            start = i + 1
        }
        i = i + 1
    }
    if saw_banner == 0 {
        push(ret, 0) push(ret, 0)
        push(ret, "no version banner in manifest")
        return ret
    }
    push(ret, 1) push(ret, m) push(ret, "")
    return ret
}

// ---- validator ---------------------------------------------------------
//
// Semantic gate: NAME + VERSION non-empty; at least one SKILL_DEP.
// Called at agent.compose to refuse manifest-shaped-but-useless input.
// Returns [ok, err].
fn agent_manifest_validate(m) {
    let ret = list_new()
    if m == 0 {
        push(ret, 0) push(ret, "manifest is null") return ret
    }
    if len(agent_manifest_name(m)) == 0 {
        push(ret, 0) push(ret, "manifest missing NAME") return ret
    }
    if len(agent_manifest_version(m)) == 0 {
        push(ret, 0) push(ret, "manifest missing VERSION") return ret
    }
    if agent_manifest_skill_dep_count(m) == 0 {
        push(ret, 0) push(ret, "manifest has no SKILL_DEP entries") return ret
    }
    push(ret, 1) push(ret, "") return ret
}

// ---- serializer --------------------------------------------------------

fn _am_emit_list(head, items) {
    let s = ""
    let i = 0
    while i < len(items) {
        s = s + head + " " + items[i] + "\n"
        i = i + 1
    }
    return s
}

fn agent_manifest_serialize(m) {
    if m == 0 { return "" }
    let s = AGENT_MANIFEST_VERSION_LINE + "\n"
    s = s + "NAME " + agent_manifest_name(m) + "\n"
    s = s + "VERSION " + agent_manifest_version(m) + "\n"
    if len(agent_manifest_description(m)) > 0 {
        s = s + "DESCRIPTION " + agent_manifest_description(m) + "\n"
    }
    s = s + _am_emit_list("CAPSULE_DEP", agent_manifest_capsule_deps(m))
    s = s + _am_emit_list("SKILL_DEP",   agent_manifest_skill_deps(m))
    s = s + _am_emit_list("PATTERN_DEP", agent_manifest_pattern_deps(m))
    if len(agent_manifest_style_pin(m)) > 0 {
        s = s + "STYLE_PIN " + agent_manifest_style_pin(m) + "\n"
    }
    if len(agent_manifest_persona_pin(m)) > 0 {
        s = s + "PERSONA_PIN " + agent_manifest_persona_pin(m) + "\n"
    }
    s = s + "MIN_CONFIDENCE_MILLI " + int_to_str(agent_manifest_min_confidence_milli(m)) + "\n"
    if len(agent_manifest_attribution(m)) > 0 {
        s = s + "ATTRIBUTION_PREF " + agent_manifest_attribution(m) + "\n"
    }
    if len(agent_manifest_license(m)) > 0 {
        s = s + "LICENSE " + agent_manifest_license(m) + "\n"
    }
    return s
}
