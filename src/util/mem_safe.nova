// Safe memory operations working around a NOVA codegen bug.
//
// See docs/adr/0103-memcpy-raw-tagged-ptr-workarounds.md and ADR-0102.
//
// The NOVA `memcpy_raw` builtin is a bare `rep movsb` label that does
// not untag its (rdi, rsi, rdx) arguments: calling it with NOVA
// pointer/int values -- which the runtime stores in tagged (2x + 1)
// form -- causes a SIGSEGV at `rep movsb` because the pointers are
// left tagged. The same path is reached indirectly through
// `substr(raw_buf, 0, n)` and some `+` concatenations on strings
// built from raw buffers, so three related wrappers are needed:
//
//   byte_copy(dst, src, n)  -- replaces direct `memcpy_raw`
//   buf_to_str(buf, n)      -- replaces `substr(raw_buf, 0, n)`
//
// `load8` / `store8` DO untag their args (confirmed by R3c disasm),
// so a tiny byte loop over them is both correct and still inside the
// uop-fused chunk `rep movsb` would have used for small `n`.
//
// Prior art inlined here: `_lk_byte_copy` body from
// `src/io/transducers/image_optical_flow.nova` (R3c) and
// `srl_buf_to_str` from `src/federation/gossip_relay_secure.nova`.
//
// CrossEngin dependencies: none (builtins only).

fn byte_copy(dst, src, n) {
    let i = 0
    while i < n {
        store8(int_add(dst, i), load8(int_add(src, i)))
        i = int_add(i, 1)
    }
}

// Convert `n` bytes of a raw alloc'd buffer into a tagged NOVA string.
// Walks the buffer byte-by-byte via `load8` (which untags) and appends
// each byte with `chr`, so no path through `memcpy_raw` is taken.
fn buf_to_str(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        s = s + chr(load8(buf + i))
        i = i + 1
    }
    return s
}
