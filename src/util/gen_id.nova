// Generation-id util for singleton rebuild guards (ADR-0105 R3f.5).
//
// Context
//   The module-level singletons in `src/parts/perception/perception_module.nova`
//   (around line 304) and `src/parts/action/action_module.nova` (lines 337,
//   343) decide whether to rebuild on `(renv)` / `(dl, ge)` changes by
//   comparing the cached inputs against the new ones with `!=`. Because
//   those inputs are LIST VALUES (renv, dl, ge are all `list_new()`-built
//   objects), the comparison exercises the NOVA bug-#11 family: two
//   tagged pointers whose high bits are set reach the sentinel-equality
//   path in codegen (ADR-0105) and the compare returns a stale answer
//   or crashes. The guards therefore DEAD-CODED in practice: tests that
//   build a fresh renv/dl/ge never rebuilt, so the singleton silently
//   leaked the first-call bindings.
//
//   The behavioral tests (`test_perception_module`, `test_action_module`)
//   use fresh module handles directly (not the singleton), so this
//   leakage never surfaced -- but the DEAD guards are a trap waiting for
//   a future loop test that routes through the singleton.
//
// Solution
//   Stamp every renv / dl / ge with a per-process monotonic generation
//   id at construction. Rebuild guards compare ints, which the bug-#11
//   codegen path handles correctly (small ints are untagged).
//
// Usage
//   let obj = list_new()
//   push(obj, OBJ_TAG)
//   ... other slots ...
//   push(obj, gen_id_new())        // last slot (OBJ_GEN)
//
//   // In a rebuild guard:
//   if gen_id_matches(cached, incoming, OBJ_GEN) == 0 { rebuild }
//
// CrossEngin dependencies: none (NOVA builtins only).

let _GEN_ID_COUNTER = 0

// Return a fresh generation id. Monotonic within a process; starts at 1
// (0 is reserved for "no id stamped" so a bare `list_new()` without the
// stamp slot is distinguishable from a stamped object).
fn gen_id_new() {
    _GEN_ID_COUNTER = _GEN_ID_COUNTER + 1
    return _GEN_ID_COUNTER
}

// Stamp a fresh id into obj[slot] via list_set. Returns the stamped id
// for callers that want to track it separately.
fn gen_id_stamp(obj, slot) {
    let id = gen_id_new()
    list_set(obj, slot, id)
    return id
}

// Compare two objects by their stamped generation ids. Returns 1 iff
// both are non-nil and their ids are equal. A nil operand or a slot
// holding the 0 sentinel compares not-equal (safer default for the
// rebuild-guard idiom).
fn gen_id_matches(obj1, obj2, slot) {
    if obj1 == 0 { return 0 }
    if obj2 == 0 { return 0 }
    let id1 = obj1[slot]
    let id2 = obj2[slot]
    if id1 == 0 { return 0 }
    if id2 == 0 { return 0 }
    if id1 == id2 { return 1 }
    return 0
}
