// Safe runtime-type probes working around the NOVA `type_of` regression.
//
// Historical NOVA mapping (used by code throughout src/kg and src/federation):
//   type_of(int)    == 1
//   type_of(string) == 2
//   type_of(list)   == 3
//   type_of(map)    == 4
//
// Current (regressed) NOVA codegen -- empirically pinned by
// `tests/unit/test_type_of_probe.nova`:
//   type_of(int)    returns 0 (plain int, compares equal to 0)
//   type_of(list)   returns 1 (plain int, compares equal to 1)
//   type_of(string) returns a TAGGED value: int_to_str renders "1", but
//     the value is NEITHER == 1 NOR == any integer. Only <, >, + and
//     the printing path agree with its display.
//
// This asymmetry is what makes the regression tractable at user level:
// a bare `type_of(x) == 1` is TRUE for lists but FALSE for strings and
// ints, so the three categories remain distinguishable without a
// codegen fix. See ADR-0104.
//
// The runtime fix lives in `/home/user/NOVA/src/compiler/codegen.nova`
// and is explicitly out-of-scope for CrossEngin (standing constraint,
// ADR-0100 non-goals). These user-level predicates let the KG and the
// federation layer keep running until the upstream regression is
// resolved; after that, this module can be deleted in one sweep.
//
// CrossEngin dependencies: none (NOVA builtins only).

// Return 1 iff `x` is a plain integer value (type_of returns 0 under
// the regression). Nil (value 0) is also considered an int for this
// probe, matching the historical `type_of(0) == 1` behavior; call
// sites that need "non-nil" should test `x != 0` separately.
fn is_int_val(x) {
    if type_of(x) == 0 { return 1 }
    return 0
}

// Return 1 iff `x` is a list value (type_of returns a plain-int 1 under
// the regression, which crucially DOES compare equal to the literal 1,
// unlike the string case). This is the primary workaround for the
// idiom `type_of(x) != 3 { return 0 }` guarding downstream `x[0]`
// indexing in the KG and federation layer.
fn is_list_val(x) {
    if x == 0 { return 0 }
    // Ints return type_of == 0; a non-zero int would still fail here.
    // Strings return a tagged value whose == 1 is FALSE; only lists
    // match this exact equality, so the probe is sound in both
    // directions.
    if type_of(x) == 1 { return 1 }
    return 0
}

// Return 1 iff `x` is a string value. Under the regression, strings
// are the ONLY category whose `type_of(x)` is simultaneously `!= 0`
// (not an int), `!= 1` (not a list), and non-nil. The pivot is the
// tagged "1" that strings produce.
fn is_str_val(x) {
    if x == 0 { return 0 }
    let t = type_of(x)
    if t == 0 { return 0 }   // int
    if t == 1 { return 0 }   // list (plain-int 1)
    return 1                 // string (tagged "1") -- the only remaining branch
}

// Return 1 iff `x` is a list whose head slot (index 0) holds `tag`.
// This is the generic form of the `_qry_is_error` / `_rule_is_error`
// / `dr_is_state` / `proof_is_tree` / `rule_is_parsed` /
// `rule_engine_is` idiom: those predicates all gate on
// `type_of(x) != 3 { return 0 }` then test `x[0] == TAG`. The nil
// and non-list guards protect `len(x)` and `x[0]` from the known
// NOVA crash on non-indexable values.
fn is_tagged_list(x, tag) {
    if is_list_val(x) == 0 { return 0 }
    if len(x) < 1 { return 0 }
    if x[0] == tag { return 1 }
    return 0
}
