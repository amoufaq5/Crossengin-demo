// Safe runtime-type probes. Historical NOVA mapping (restored upstream by
// NOVA commit 651a507 — tagged `_nova_type_of` return + match-arm cmp):
//   type_of(null)   == 0
//   type_of(int)    == 1
//   type_of(string) == 2
//   type_of(list)   == 3
//   type_of(map)    == 4
//
// This module is retained as a thin stable-API wrapper in case the KG and
// federation layers want to continue going through `is_*_val` predicates;
// a future round can inline-remove it by migrating all callers to raw
// `type_of(x) == N`. See ADR-0104 (Superseded) for the regression history
// that previously forced the asymmetry-pivot workaround here.
//
// CrossEngin dependencies: none (NOVA builtins only).

// Return 1 iff `x` is a plain integer value.
fn is_int_val(x) {
    if type_of(x) == 1 { return 1 }
    return 0
}

// Return 1 iff `x` is a list value. This is the primary predicate for
// the `type_of(x) != 3 { return 0 }` idiom guarding `x[0]` indexing in
// the KG and federation layer.
fn is_list_val(x) {
    if x == 0 { return 0 }
    if type_of(x) == 3 { return 1 }
    return 0
}

// Return 1 iff `x` is a string value.
fn is_str_val(x) {
    if x == 0 { return 0 }
    if type_of(x) == 2 { return 1 }
    return 0
}

// Return 1 iff `x` is a list whose head slot (index 0) holds `tag`.
// This is the generic form of the `_qry_is_error` / `_rule_is_error`
// / `dr_is_state` / `proof_is_tree` / `rule_is_parsed` /
// `rule_engine_is` idiom: those predicates all gate on
// `type_of(x) != 3 { return 0 }` then test `x[0] == TAG`. The nil
// and non-list guards protect `len(x)` and `x[0]` from the known
// NOVA crash on non-indexable values.
fn is_tagged_list(x, tag) {
    if is_list_val(x) == 0 { return 0 }
    if len(x) < 1 { return 0 }
    if x[0] == tag { return 1 }
    return 0
}
