// Safe list-index operations working around NOVA runtime quirks.
//
// The NOVA builtin `list_remove(l, i)` does NOT untag its tagged-int index --
// the tagged value 2i+1 reaches the impl as a raw index, so `list_remove(l, 0)`
// on a 2+ element list removes index 1 (not 0), and only the OOB fallback
// ("remove last") is reliable. This was uncovered by the /retract audit-log
// tests in formal_chat.nova, but the pattern affects every caller doing
// arbitrary-index removes -- see NEXT_SESSION.md for the systemic list.
//
// This module provides `list_remove_at(l, i)` -- a drop-in that actually
// removes the element at index `i` regardless of the underlying bug, by
// shifting the tail down via list_set and then dropping the (now-duplicate)
// last slot using the *reliable* OOB fallback.
//
// CrossEngin dependencies: none (builtins only).

// Remove the element at index `idx` from `lst`, shifting subsequent elements
// down by one. Returns 1 if the removal happened, 0 if `idx` was out of range.
// Correct regardless of NOVA's list_remove tagging quirk: writes each surviving
// element into its new position via list_set (which handles tagging correctly),
// then drops the trailing slot with a deliberately-OOB index (the fallback that
// IS reliable).
fn list_remove_at(lst, idx) {
    let n = len(lst)
    if idx < 0 { return 0 }
    if idx >= n { return 0 }
    let j = idx
    while j < n - 1 {
        list_set(lst, j, lst[j + 1])
        j = j + 1
    }
    // Drop the last slot: any index larger than the storage falls back to
    // "remove last", which is the ONE case list_remove handles reliably.
    list_remove(lst, n + 100)
    return 1
}
