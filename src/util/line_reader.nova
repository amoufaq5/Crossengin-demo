// line_reader.nova -- NUL-safe, whole-line stdin reader (audit F-25).
//
// NOVA's read_line() reads stdin one byte at a time, stops at '\n' or after
// 1023 bytes, and returns a NUL-terminated string. Two things follow:
//
//   * A line longer than 1023 bytes comes back in pieces, so a caller that
//     reads "one line" with read_line() leaves the rest of the physical line
//     for the next reader. 1023 x "n" + "/status" typed at an approval
//     prompt answered "no" and then ran /status.
//   * A NUL byte inside a chunk makes len() stop early, so a caller cannot
//     tell "this chunk ended at a newline" (len < 1023) from "this chunk was
//     full but contains a NUL". "x\0" + 1021 x "A" + "/status" ran /status.
//
// lr_read_chunk() is read_line() with every NUL byte replaced by a space, so
// len(chunk) is exactly the number of bytes consumed (newline excluded) and
// len(chunk) < 1023 reliably means the line ended (or EOF). lr_read_line()
// joins chunks into the whole physical line.
//
// Linux x86-64 only (raw read(2) syscall), like the rest of the chat binary.

// One chunk of at most 1023 bytes, newline stripped, NUL -> space.
// Returns "" on EOF / read error or on an empty line (as read_line()).
fn lr_read_chunk() {
    asm {
        "push r12"
        "push r13"
        "mov rdi, 1024"
        "call _nova_alloc"
        "mov r12, rax"
        "xor r13d, r13d"
        ".celr_loop:"
        "xor edi, edi"
        "lea rsi, [r12 + r13]"
        "mov rdx, 1"
        "mov rax, 0"
        "syscall"
        "cmp rax, 0"
        "jle .celr_done"
        "movzx eax, byte ptr [r12 + r13]"
        "cmp al, 10"
        "je .celr_done"
        "test al, al"
        "jnz .celr_keep"
        "mov byte ptr [r12 + r13], 32"
        ".celr_keep:"
        "inc r13"
        "cmp r13, 1023"
        "jl .celr_loop"
        ".celr_done:"
        "mov byte ptr [r12 + r13], 0"
        "mov rax, r12"
        "pop r13"
        "pop r12"
    }
}

// The whole physical line (newline stripped). Chunks are appended without
// rescanning, so the cost is linear in the line length. Once the line passes
// `limit` bytes only its last `keep` bytes are retained (keep < limit), so
// an over-long line still comes back longer than `keep`.
fn lr_read_line_tail(keep, limit) {
    let acc = ""
    while 1 == 1 {
        let chunk = lr_read_chunk()
        let cl = len(chunk)
        if cl == 0 { return acc }                 // end of line (or EOF)
        if cl < 1023 { return acc + chunk }       // last piece of the line
        acc = acc + chunk                          // full chunk: line continues
        let al = len(acc)
        if al > limit { acc = substr(acc, al - keep, keep) }
    }
    return acc
}

// The whole physical line, keeping only its first `keep` bytes. The rest of
// the line is consumed and discarded, so nothing leaks to the next reader.
fn lr_read_line_head(keep) {
    let acc = ""
    while 1 == 1 {
        let chunk = lr_read_chunk()
        let cl = len(chunk)
        if len(acc) < keep { acc = acc + chunk }
        if cl < 1023 {
            if len(acc) > keep { acc = substr(acc, 0, keep) }
            return acc
        }
    }
    return acc
}
