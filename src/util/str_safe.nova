// Safe string operations working around NOVA runtime quirks.
//
// The NOVA `str_eq` builtin is environmentally flaky on some string literals:
// two byte-identical strings can compare unequal. Empirically confirmed
// 2026-08: `str_eq("op", "op")` returns 0 (FALSE); same for "num", "CONST",
// "INVALID", and other short literal pairs. This has been quietly breaking
// production code -- e.g., `arithmetic.nova` couldn't recognize any operator
// token because its `str_eq(t[0], "op")` check always returned false, so
// every arithmetic query returned an empty result. 1465 str_eq call sites
// exist across src/; the migration is incremental (module by module).
//
// This module provides `str_eq_bytes(a, b)` -- length check + char-by-char
// via `char_at`, which is unaffected by the underlying flakiness. See also
// `tests/ce_test.nova::_ce_str_eq_bytes` (same shape, used by the harness).
//
// CrossEngin dependencies: none (builtins only).

fn str_eq_bytes(a, b) {
    let n = len(a)
    if n != len(b) { return 0 }
    let i = 0
    while i < n {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Safe single-character split (delim must be one character). Works around
// NOVA's `split` builtin, which is empirically broken:
// - `split("abcdefghij klmnopqrst", " ")` returns `["abcde", "fghij"]`
//   (half of each word, delimiter position wrong)
// - `split("a b c d", " ")` returns 4 empty strings
// Walks bytes via char_at/substr (both of which work correctly) and
// accumulates parts. Trailing empty part is preserved so callers can
// distinguish "a," from "a".
fn split_char(s, delim_char) {
    let out = list_new()
    let n = len(s)
    let start = 0
    let i = 0
    while i < n {
        if char_at(s, i) == delim_char {
            push(out, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(s, start, n - start))
    return out
}

// Convenience for the common "split on ASCII space" case.
fn split_space(s) { return split_char(s, 32) }

// Safe substring search returning the correct 0-based byte position, or -1 if
// not found. Works around NOVA's `str_find` builtin, which is empirically
// broken -- for a single-character needle it returns FLOOR(position / 2)
// instead of the actual position. E.g. `str_find("en.wikipedia.org/x", "/")`
// returns 8 instead of 16, so any caller doing
//   substr(s, 0, str_find(s, "/"))
// silently truncates. `str_find(...) != -1` checks (used elsewhere in
// str_safe for "contains") were unaffected because -1 is returned unchanged
// when the needle is absent -- only POSITION-dependent callers hit it.
fn find_char(hay, needle_char) {
    let n = len(hay)
    let i = 0
    while i < n {
        if char_at(hay, i) == needle_char { return i }
        i = i + 1
    }
    return 0 - 1
}

// Multi-byte needle variant; walks bytes and checks each candidate start.
fn find_bytes(hay, needle) {
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0 { return 0 }
    if nn > hn { return 0 - 1 }
    let limit = hn - nn
    let i = 0
    while i <= limit {
        let match_ok = 1
        let j = 0
        while j < nn {
            if char_at(hay, i + j) != char_at(needle, j) { match_ok = 0 j = nn }
            else { j = j + 1 }
        }
        if match_ok == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}
