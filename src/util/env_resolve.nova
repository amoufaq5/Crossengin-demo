// Shared environment-variable resolvers for CrossEngin daemons.
//
// Phase M R6 (ADR-0111 close-out) duplicated six env-reading helpers
// from `examples/crossengin_fed_daemon.nova` into
// `examples/crossengin_daemon.nova` with a `_cd_` prefix (verbatim-
// semantic copy of the `_fed_*` originals). This module consolidates
// those duplicates so both daemons share one set of resolvers:
//
//   env_str(name, fallback)                    -- getenv with non-empty fallback.
//   env_int(name, fallback)                    -- same, decoding via str_to_int;
//                                                 non-positive values fall back.
//   env_bool(v, default_on)                    -- "0" => off, anything else => on.
//                                                 Takes an already-fetched env
//                                                 value (caller passes getenv(name)),
//                                                 since NOVA has no setenv so the
//                                                 pure-resolver pattern treats the
//                                                 raw env value as the input.
//   env_peers(primary_name, fallback_name)     -- comma-split peer list; falls back
//                                                 to the secondary env var name if
//                                                 the primary is unset or empty.
//   env_soul_id(listen_addr)                   -- `CE_FED_SOUL_ID` or `"soul:"+addr`.
//   soul_id_to_int(s)                          -- djb2-mixed 24-bit positive int,
//                                                 stable across runs; non-empty
//                                                 strings never hash to 0.
//   env_soul_id_as_int(listen_addr)            -- `soul_id_to_int(env_soul_id(addr))`.
//   env_attest_key_base()                      -- CE_FED_ATTEST_KEY_DIR | $HOME-rel |
//                                                 container-safe fallback.
//
// Env-var names and precedence match the pre-extraction `_fed_*` /
// `_cd_*` helpers byte-for-byte. The `ER_` prefix on the shared mask
// const dodges the NOVA §10 module-level-constant collision class
// that would otherwise fire when both daemons link into one `main()`.
//
// CrossEngin dependencies: `str_safe.nova` (for `str_eq_bytes`).

import "./str_safe.nova"

fn env_str(name, fallback) {
    let v = getenv(name)
    if v == 0 { return fallback }
    if len(v) == 0 { return fallback }
    return v
}

fn env_int(name, fallback) {
    let v = getenv(name)
    if v == 0 { return fallback }
    if len(v) == 0 { return fallback }
    let n = str_to_int(v)
    if n <= 0 { return fallback }
    return n
}

fn env_bool(v, default_on) {
    if v == 0 { return default_on }
    if len(v) == 0 { return default_on }
    // Only literal "0" disables. Everything else enables.
    if str_eq_bytes(v, "0") == 1 { return 0 }
    return 1
}

fn env_peers(primary_name, fallback_name) {
    let out = list_new()
    let env = getenv(primary_name)
    if env == 0 { env = getenv(fallback_name) }
    if env == 0 { return out }
    if len(env) == 0 { return out }
    let i = 0
    let start = 0
    while i < len(env) {
        if char_at(env, i) == 44 {   // ','
            if i > start { push(out, substr(env, start, i - start)) }
            start = i + 1
        }
        i = i + 1
    }
    if i > start { push(out, substr(env, start, i - start)) }
    return out
}

fn env_soul_id(listen_addr) {
    let v = getenv("CE_FED_SOUL_ID")
    if v != 0 {
        if len(v) > 0 { return v }
    }
    return "soul:" + listen_addr
}

// Derive a small non-negative int from a soul-id string, stable across
// runs of the same soul_id. djb2-style rolling multiply on the string
// bytes, masked to a 24-bit positive range so the shutdown-summary
// line stays readable and there is no chance of a large-literal
// codegen (bug #11) drift in downstream arithmetic. Empty input -> 0
// (the sentinel; a non-empty string never produces 0).
let ER_SOUL_ID_MASK = 16777215   // (1 << 24) - 1; fits well under Bug-#11 limits
fn soul_id_to_int(s) {
    if s == 0 { return 0 }
    let n = len(s)
    if n == 0 { return 0 }
    let h = 5381
    let i = 0
    while i < n {
        // h * 33 + byte, masked each step so h stays bounded.
        h = ((h * 33) + char_at(s, i)) & ER_SOUL_ID_MASK
        i = i + 1
    }
    // Ensure a non-empty string never produces 0 (0 is our "unset"
    // sentinel in the /leader status line).
    if h == 0 { return 1 }
    return h
}

fn env_soul_id_as_int(listen_addr) {
    return soul_id_to_int(env_soul_id(listen_addr))
}

// Signer-key directory resolution. CE_FED_ATTEST_KEY_DIR wins; else
// $HOME/.crossengin/fed_keys; else ./crossengin_fed_keys (used when
// HOME is unset, e.g. inside a container). The returned string is the
// BASE PATH merkle_signing_keypair_load expects (it appends ".priv" +
// ".pub"), so we return the base path WITHOUT trailing "/" plus the
// filename stem "signer". The full on-disk layout is:
//   <dir>/signer.priv  (32 bytes, mode 0600)
//   <dir>/signer.pub   (32 bytes, mode 0644)
fn env_attest_key_base() {
    let v = getenv("CE_FED_ATTEST_KEY_DIR")
    if v != 0 {
        if len(v) > 0 { return v + "/signer" }
    }
    let home = getenv("HOME")
    if home != 0 {
        if len(home) > 0 { return home + "/.crossengin/fed_keys/signer" }
    }
    // NOVA has no `~` expansion; the container HOME can also be unset.
    // Fall back to a project-relative default so the daemon still boots
    // (the load then fails cleanly and attestation is disabled with
    // a warn, per the boot contract -- we never crash for a missing
    // key file).
    return "./crossengin_fed_keys/signer"
}
