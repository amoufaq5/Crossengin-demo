// Tagged syscall wrappers for read / write.
//
// NOVA's `sys_read` / `sys_write` wrappers currently pass arguments
// to the kernel verbatim and return the kernel's raw rax. Two problems:
//   - `count` arrives at the kernel TAGGED (= 2n+1), so the kernel
//     reads/writes 2x+1 the intended bytes.
//   - The raw byte-count return breaks caller compares like
//     `if written != n` where n = len(text) is NOVA-tagged.
// See docs/UPSTREAM_NOVA_BUGS.md §12.
//
// These wrappers bypass the NOVA sys_* layer and emit the raw
// syscall inline with the full tag dance:
//   - `buf` is tag-polymorphic (raw literal OR tagged alloc).
//   - `count` is unconditionally untagged (NOVA ints are always tagged).
//   - Return is sign-aware tagged (non-neg count -> tagged; -errno raw).
//
// Frame layout: 3 NOVA params fill `[rbp-8]`, `[rbp-16]`, `[rbp-24]`.
//
// Scope: use for class-B callers (compare return to tagged NOVA value).
// Class-A callers (discard return) can keep using raw sys_read / sys_write.
//
// CrossEngin dependencies: std/syscall (for the _read_file_tagged
// helper's sys_open/sys_close/O_RDONLY uses); the tagged read/write
// wrappers themselves remain self-contained inline asm.

import "std/syscall"

fn _sys_read_tagged(fd, buf, count) {
    asm {
        "mov rax, 0"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .srt_u"
        "sar rsi, 1"
        ".srt_u:"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
        "test rax, rax"
        "js .srt_ret"
        "lea rax, [rax+rax+1]"
        ".srt_ret:"
    }
}

fn _sys_write_tagged(fd, buf, count) {
    asm {
        "mov rax, 1"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .swt_u"
        "sar rsi, 1"
        ".swt_u:"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
        "test rax, rax"
        "js .swt_ret"
        "lea rax, [rax+rax+1]"
        ".swt_ret:"
    }
}

// R25: shared byte-copy read loop for Bug #12 class-B / S2'
// workaround. Replaces six per-file duplicates (R12d snap_read_text,
// R20 _spk_read_text, R24 _wake_read_text, plus delta_read_text,
// _dl_read_text, _cs_read_text). The raw `sys_read -> acc + buf`
// pattern SEGVs in _nova_concat under tagged pointer arith (buf is
// a tagged alloc'd buffer, not a proper NOVA string); this helper
// byte-copies via chr(load8(buf+i)) in piece-chunk batches. One
// _nova_concat per 4KB chunk, not per byte. Returns 0 on open
// failure (callers route that to "load FAILED"), otherwise the
// full file as a NOVA string. See docs/UPSTREAM_NOVA_BUGS.md §12.
fn _read_file_tagged(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return 0 }
    let chunk = 4096
    let buf = alloc(chunk + 1)
    let acc = ""
    let done = 0
    while done == 0 {
        let m = _sys_read_tagged(fd, buf, chunk)
        if m <= 0 {
            done = 1
        } else {
            let piece = ""
            let i = 0
            while i < m {
                piece = piece + chr(load8(buf + i))
                i = i + 1
            }
            acc = acc + piece
            if m < chunk { done = 1 }
        }
    }
    sys_close(fd)
    return acc
}
