// CrossEngin sandbox: capability model + token registry + verb-cap
// gate (R54, ADR-0105).
//
// A Capability is a namespaced permission string ("nl:ask", "kg:read",
// "skill:run", ...). A Token is a bearer credential holding a set of
// capabilities, a holder identity, and an expiry. A TokenRegistry
// stores minted tokens in-memory (process-wide singleton). The
// rpc_dispatch path consults `capability_verb_required(verb)` +
// `token_has_cap(token, cap)` before running any verb -- but ONLY
// when the daemon is in enforced mode (CE_RPC_REQUIRE_TOKEN=1); by
// default the module is inert so existing R49/R50 deployments run
// byte-identically.
//
// This module ships NO storage, NO persistence, NO wire semantics --
// those are the rpc_server/daemon's concern. This is the pure
// capability primitive.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- capability strings (well-known) -------------------------------------
//
// Kept as string constants so callers avoid typos + code-search finds
// every callsite of a given capability. New capabilities added here
// are the ONLY place a verb can request enforcement -- no dynamic
// strings from the wire.

let CAP_NL_ASK             = "nl:ask"
let CAP_KG_READ            = "kg:read"
let CAP_CAPSULE_READ       = "capsule:read"
let CAP_CAPSULE_INSTALL    = "capsule:install"
let CAP_SKILL_READ         = "skill:read"
let CAP_SKILL_RUN          = "skill:run"
let CAP_SKILL_INSTALL      = "skill:install"
let CAP_PERSONA_READ       = "persona:read"
let CAP_PERSONA_WRITE      = "persona:write"
let CAP_INGEST_REVIEW      = "ingest:review"
let CAP_INGEST_DECIDE      = "ingest:decide"
// R55: sandbox lifecycle capability. Required for the
// capability.issue / .revoke / .list wire verbs. Admin role
// carries it by default; NO other built-in role does.
let CAP_ADMIN_SANDBOX      = "admin:sandbox"
// R55.3: session persistence capability. Required for
// session.save / session.load. Same admin-only shape.
let CAP_ADMIN_SESSION      = "admin:session"

// ---- verb -> required capability -----------------------------------------
//
// Every wire verb declares its required capability. Verbs not in the
// table return "" (no capability required) -- enforcement mode still
// admits them so they never lock a caller out of an unknown-to-sandbox
// endpoint. Unknown verbs are refused elsewhere (rpc_dispatch).

fn capability_verb_required(verb) {
    if str_eq_bytes(verb, "nl.ask")          == 1 { return CAP_NL_ASK }
    if str_eq_bytes(verb, "nl.parse_only")   == 1 { return CAP_NL_ASK }
    if str_eq_bytes(verb, "kg.list")         == 1 { return CAP_KG_READ }
    if str_eq_bytes(verb, "capsule.list")    == 1 { return CAP_CAPSULE_READ }
    if str_eq_bytes(verb, "capsule.install") == 1 { return CAP_CAPSULE_INSTALL }
    if str_eq_bytes(verb, "skill.list")      == 1 { return CAP_SKILL_READ }
    if str_eq_bytes(verb, "skill.run")       == 1 { return CAP_SKILL_RUN }
    if str_eq_bytes(verb, "skill.install")   == 1 { return CAP_SKILL_INSTALL }
    if str_eq_bytes(verb, "persona.show")    == 1 { return CAP_PERSONA_READ }
    if str_eq_bytes(verb, "persona.project") == 1 { return CAP_PERSONA_READ }
    if str_eq_bytes(verb, "ingest.review")   == 1 { return CAP_INGEST_REVIEW }
    if str_eq_bytes(verb, "ingest.approve")  == 1 { return CAP_INGEST_DECIDE }
    if str_eq_bytes(verb, "ingest.deny")     == 1 { return CAP_INGEST_DECIDE }
    if str_eq_bytes(verb, "ingest.auto_approve") == 1 { return CAP_INGEST_DECIDE }
    // R59 policy management. Reads gated by review; mutations by decide.
    if str_eq_bytes(verb, "ingest.policy.list")   == 1 { return CAP_INGEST_REVIEW }
    if str_eq_bytes(verb, "ingest.policy.add")    == 1 { return CAP_INGEST_DECIDE }
    if str_eq_bytes(verb, "ingest.policy.remove") == 1 { return CAP_INGEST_DECIDE }
    // R62 pattern-pack management (patterns are a capsule subtype).
    if str_eq_bytes(verb, "pattern.list")         == 1 { return CAP_CAPSULE_READ }
    if str_eq_bytes(verb, "pattern.install")      == 1 { return CAP_CAPSULE_INSTALL }
    // R66 ingest.file: cap-matches the direct-decide gate (records may
    // land straight in the KG for trusted sources).
    if str_eq_bytes(verb, "ingest.file")          == 1 { return CAP_INGEST_DECIDE }
    // R72 ownership audit + transfer: admin-only, matches R55.
    if str_eq_bytes(verb, "ownership.list")       == 1 { return CAP_ADMIN_SANDBOX }
    if str_eq_bytes(verb, "ownership.transfer")   == 1 { return CAP_ADMIN_SANDBOX }
    // R55 lifecycle verbs.
    if str_eq_bytes(verb, "capability.issue")  == 1 { return CAP_ADMIN_SANDBOX }
    if str_eq_bytes(verb, "capability.revoke") == 1 { return CAP_ADMIN_SANDBOX }
    if str_eq_bytes(verb, "capability.list")   == 1 { return CAP_ADMIN_SANDBOX }
    // R78 admin.rotate_token: rotate a live token's bearer id.
    if str_eq_bytes(verb, "admin.rotate_token") == 1 { return CAP_ADMIN_SANDBOX }
    // R79 admin.set_qps: change a live token's rate-limit ceiling.
    if str_eq_bytes(verb, "admin.set_qps")      == 1 { return CAP_ADMIN_SANDBOX }
    // R81 admin.set_expires: change a live token's expiry.
    if str_eq_bytes(verb, "admin.set_expires")  == 1 { return CAP_ADMIN_SANDBOX }
    // R55.3 session persistence.
    if str_eq_bytes(verb, "session.save")      == 1 { return CAP_ADMIN_SESSION }
    if str_eq_bytes(verb, "session.load")      == 1 { return CAP_ADMIN_SESSION }
    // R76 session.list -- enumerate snapshots via the R76 index.
    if str_eq_bytes(verb, "session.list")      == 1 { return CAP_ADMIN_SESSION }
    if str_eq_bytes(verb, "session.delete")    == 1 { return CAP_ADMIN_SESSION }
    return ""
}

// ---- role -> capability set ---------------------------------------------
//
// A role is a convenience bundle expanded to its capability list at
// token-mint time. Tokens store capabilities (not role names), so
// re-defining a role does NOT silently downgrade already-issued tokens
// (audit + revocation stays predictable).

fn _cap_role_admin() {
    let out = list_new()
    push(out, CAP_NL_ASK)
    push(out, CAP_KG_READ)
    push(out, CAP_CAPSULE_READ)
    push(out, CAP_CAPSULE_INSTALL)
    push(out, CAP_SKILL_READ)
    push(out, CAP_SKILL_RUN)
    push(out, CAP_SKILL_INSTALL)
    push(out, CAP_PERSONA_READ)
    push(out, CAP_PERSONA_WRITE)
    push(out, CAP_INGEST_REVIEW)
    push(out, CAP_INGEST_DECIDE)
    push(out, CAP_ADMIN_SANDBOX)
    push(out, CAP_ADMIN_SESSION)
    return out
}

fn _cap_role_reader() {
    let out = list_new()
    push(out, CAP_NL_ASK)
    push(out, CAP_KG_READ)
    push(out, CAP_CAPSULE_READ)
    push(out, CAP_SKILL_READ)
    push(out, CAP_PERSONA_READ)
    return out
}

fn _cap_role_skill_user() {
    let out = _cap_role_reader()
    push(out, CAP_SKILL_RUN)
    return out
}

fn _cap_role_curator() {
    let out = _cap_role_reader()
    push(out, CAP_CAPSULE_INSTALL)
    push(out, CAP_INGEST_REVIEW)
    push(out, CAP_INGEST_DECIDE)
    return out
}

fn _cap_role_service() {
    let out = list_new()
    push(out, CAP_NL_ASK)
    push(out, CAP_SKILL_RUN)
    return out
}

// Expand a role name to a capability list. Unknown role -> empty list
// (caller may combine with an explicit cap list; a token with an empty
// cap list is a valid "no permissions" token).
fn capability_role_expand(role_name) {
    if str_eq_bytes(role_name, "admin")      == 1 { return _cap_role_admin() }
    if str_eq_bytes(role_name, "reader")     == 1 { return _cap_role_reader() }
    if str_eq_bytes(role_name, "skill_user") == 1 { return _cap_role_skill_user() }
    if str_eq_bytes(role_name, "curator")    == 1 { return _cap_role_curator() }
    if str_eq_bytes(role_name, "service")    == 1 { return _cap_role_service() }
    return list_new()
}

fn capability_role_names() {
    let out = list_new()
    push(out, "admin") push(out, "reader") push(out, "skill_user")
    push(out, "curator") push(out, "service")
    return out
}

// ---- Token slot layout ---------------------------------------------------

let TOK_ID           = 0    // opaque bearer string
let TOK_HOLDER       = 1    // user_id / service name (free-form)
let TOK_CAPS         = 2    // list<string>
let TOK_ISSUED_AT    = 3    // moment
let TOK_EXPIRES_AT   = 4    // moment; 0 = never expires
let TOK_REVOKED      = 5    // 0/1
// R56 rate-limit slots. qps_max=0 means unlimited (backward-compat
// with every R54/R55 token). Window is 1 second of wall-clock time
// tracked via nanotime(); WINDOW_START_NANOS holds the epoch
// nanosecond count when the current window began.
let TOK_QPS_MAX             = 6    // requests-per-second cap; 0 = unlimited
let TOK_WINDOW_START_NANOS  = 7    // nanotime() when the current window opened
let TOK_WINDOW_COUNT        = 8    // requests observed in the current window
let TOK_SLOTS        = 9

// De-dupe a cap list so a token holding "admin+reader" doesn't carry
// nl:ask twice. Cheap linear scan -- caps are short lists.
fn _tok_dedupe_caps(caps) {
    let out = list_new()
    let i = 0
    while i < len(caps) {
        let seen = 0
        let j = 0
        while j < len(out) {
            if str_eq_bytes(out[j], caps[i]) == 1 { seen = 1 }
            j = j + 1
        }
        if seen == 0 { push(out, caps[i]) }
        i = i + 1
    }
    return out
}

// Build a token. `token_id` is the opaque bearer string the client
// presents on requests; the caller is responsible for generating a
// hard-to-guess value (128-bit random, hex-encoded is the recommended
// pattern; test code can use short readable strings for clarity).
// `capabilities` is the ALREADY-EXPANDED cap list; use
// `capability_token_new_roles` if you want role expansion at mint time.
fn capability_token_new(token_id, holder, capabilities,
                        issued_at, expires_at) {
    let t = list_new()
    push(t, token_id)                               // ID
    push(t, holder)                                 // HOLDER
    push(t, _tok_dedupe_caps(capabilities))         // CAPS
    push(t, issued_at)                              // ISSUED_AT
    push(t, expires_at)                             // EXPIRES_AT
    push(t, 0)                                      // REVOKED
    push(t, 0)                                      // QPS_MAX (0 = unlimited)
    push(t, 0)                                      // WINDOW_START_NANOS
    push(t, 0)                                      // WINDOW_COUNT
    return t
}

// Convenience: mint a token by naming roles rather than caps.
fn capability_token_new_roles(token_id, holder, role_names,
                              issued_at, expires_at) {
    let caps = list_new()
    let i = 0
    while i < len(role_names) {
        let expanded = capability_role_expand(role_names[i])
        let j = 0
        while j < len(expanded) { push(caps, expanded[j]) j = j + 1 }
        i = i + 1
    }
    return capability_token_new(token_id, holder, caps, issued_at, expires_at)
}

fn token_id(t)          { return t[TOK_ID] }
fn token_holder(t)      { return t[TOK_HOLDER] }
fn token_caps(t)        { return t[TOK_CAPS] }
fn token_issued_at(t)   { return t[TOK_ISSUED_AT] }
fn token_expires_at(t)  { return t[TOK_EXPIRES_AT] }
fn token_revoked(t)     { return t[TOK_REVOKED] }
fn token_qps_max(t)     { return t[TOK_QPS_MAX] }
fn token_window_start(t) { return t[TOK_WINDOW_START_NANOS] }
fn token_window_count(t) { return t[TOK_WINDOW_COUNT] }

// R56: set a rate-limit on the token in-place. qps_max=0 disables the
// limit (unlimited); positive values cap requests-per-second in a
// wall-clock fixed window (via nanotime). Resets the current window
// so a change takes effect immediately.
fn token_set_qps_max(t, qps) {
    if qps < 0 { return 0 }
    list_set(t, TOK_QPS_MAX, qps)
    list_set(t, TOK_WINDOW_START_NANOS, 0)
    list_set(t, TOK_WINDOW_COUNT, 0)
    return 1
}

// R81: extend / shorten a live token's expiry in place. Accepts
// expires_at as a logical-clock moment (same units as issued_at).
// A value of 0 means "never expires" (the R54 semantics); a value
// LESS than the current `now` at check time will make the token
// immediately non-live via token_is_live's `now < expires_at`
// clause -- that's intentional so an operator can effectively
// "expire this token right now" without going through
// capability.revoke. Returns 1 on success, 0 if expires_at is
// negative (invalid).
fn token_set_expires_at(t, expires_at) {
    if expires_at < 0 { return 0 }
    list_set(t, TOK_EXPIRES_AT, expires_at)
    return 1
}

fn token_has_cap(t, cap) {
    let caps = token_caps(t)
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(caps[i], cap) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Is `t` a live, usable token AT `now`? A token is live iff:
//   - not revoked
//   - expires_at == 0 (never expires) OR now < expires_at
// Returns 0 for a null token so callers can compose without null-guards.
fn token_is_live(t, now) {
    if t == 0 { return 0 }
    if token_revoked(t) != 0 { return 0 }
    let exp = token_expires_at(t)
    if exp == 0 { return 1 }
    if now < exp { return 1 }
    return 0
}

// ---- registry ------------------------------------------------------------
//
// In-memory list of minted tokens. The daemon owns the registry and
// makes it available to rpc_server via a context slot. There is no
// process-wide singleton for tokens -- unlike style/pattern capsules,
// tokens are per-daemon-instance and NOT lazy-shared; that keeps
// enforcement decisions localized (a test using a fresh registry
// cannot accidentally see another test's tokens).

fn capability_registry_new() {
    let r = list_new()
    push(r, list_new())       // tokens
    return r
}

fn capability_registry_tokens(reg) { return reg[0] }
fn capability_registry_count(reg) { return len(reg[0]) }

// Insert a token. Returns the token id for chaining. Does NOT check
// for id-collisions -- the caller is responsible for generating unique
// ids; a duplicate id makes the older token unlookable.
fn capability_registry_add(reg, token) {
    push(reg[0], token)
    return token_id(token)
}

// Look up by id; returns the token or 0.
fn capability_registry_lookup(reg, token_id_str) {
    if reg == 0 { return 0 }
    let ts = reg[0]
    let i = 0
    while i < len(ts) {
        if str_eq_bytes(token_id(ts[i]), token_id_str) == 1 { return ts[i] }
        i = i + 1
    }
    return 0
}

// Revoke by id. Returns 1 on success, 0 if the id was unknown.
fn capability_registry_revoke(reg, token_id_str) {
    let t = capability_registry_lookup(reg, token_id_str)
    if t == 0 { return 0 }
    list_set(t, TOK_REVOKED, 1)
    return 1
}

// ---- rate limiting (R56) -----------------------------------------------
//
// Fixed 1-second wall-clock window per token. When qps_max > 0 the
// authorize gate consults token_check_rate; when qps_max == 0 the
// helper is a no-op (backward compat for every R54/R55 token).
//
// The window is per-TOKEN, not per-holder: two tokens for the same
// holder each carry their own bucket. That matches operational
// intuition -- a service account issued a high-QPS token should
// not have its budget consumed by the holder's ordinary tokens.

let _TOK_WINDOW_NS = 1000000000       // 1 second in nanoseconds

// Check + record one request against `t`'s rate limit. `now_nanos` is
// wall-clock nanotime (callers grab it via nanotime()). Returns ""
// on OK; on refusal returns a human-readable message. Mutates the
// token's window slots in place so the count carries forward.
fn token_check_rate(t, now_nanos) {
    if t == 0 { return "" }
    let qps = token_qps_max(t)
    if qps <= 0 { return "" }                // unlimited -> no check
    let ws = token_window_start(t)
    let wc = token_window_count(t)
    if ws == 0 {
        // First observation.
        list_set(t, TOK_WINDOW_START_NANOS, now_nanos)
        list_set(t, TOK_WINDOW_COUNT, 1)
        return ""
    }
    if now_nanos - ws >= _TOK_WINDOW_NS {
        // Window rolled -- reset.
        list_set(t, TOK_WINDOW_START_NANOS, now_nanos)
        list_set(t, TOK_WINDOW_COUNT, 1)
        return ""
    }
    if wc >= qps {
        return "rate limit exceeded: max " + int_to_str(qps)
             + " req/s for this token"
    }
    list_set(t, TOK_WINDOW_COUNT, wc + 1)
    return ""
}

// ---- authorization gate --------------------------------------------------
//
// The core check the RPC daemon runs BEFORE dispatching a verb. Given
// the registry, presented token id, verb name, and current moment,
// returns "" for AUTHORIZED (dispatch may proceed) or a
// human-readable refusal string. Empty-string signals "OK" so callers
// can uniformly `if len(cap_err) > 0` without a null-guard for the
// happy path.
//
// Enforcement is OPT-IN: pass `enforced = 0` to bypass entirely
// (returns "", always). This is what CE_RPC_REQUIRE_TOKEN=0 boils
// down to and keeps R49/R50 wire behavior byte-identical.
//
// R56: rate limits are checked LAST -- after the cap check passes.
// The clock reading uses nanotime() (wall-clock); the `now` arg is
// still the logical clock used elsewhere (token expiry). A token
// with qps_max=0 bypasses the rate check entirely.

fn capability_authorize(enforced, reg, presented_token_id, verb, now) {
    if enforced == 0 { return "" }
    if reg == 0 {
        return "sandbox misconfigured: no capability registry"
    }
    if len(presented_token_id) == 0 {
        return "capability required: request missing 'token' field"
    }
    let t = capability_registry_lookup(reg, presented_token_id)
    if t == 0 {
        return "capability required: unknown token"
    }
    if token_is_live(t, now) == 0 {
        if token_revoked(t) != 0 { return "capability required: token revoked" }
        return "capability required: token expired"
    }
    let need = capability_verb_required(verb)
    if len(need) > 0 {
        if token_has_cap(t, need) == 0 {
            return "capability required: " + need
        }
    }
    return token_check_rate(t, nanotime())
}

// ---- token id minter (R55) ----------------------------------------------
//
// Produce a hard-to-guess 128-bit hex-encoded token id from the runtime
// CSPRNG. Falls back to a nanotime-mixed LCG if secure_random is
// unavailable (same fallback merkle_signing / ed25519 use). Callers
// (capability.issue wire verb) pass this to `capability_token_new`.

fn _cap_nibble_hex(n) {
    if n < 10 { return chr(48 + n) }
    return chr(87 + n)
}

fn capability_token_id_mint() {
    let raw = alloc(17)
    let got = secure_random(raw, 16)
    let bytes = list_new()
    if got == 16 {
        let i = 0
        while i < 16 { push(bytes, load8(raw + i)) i = i + 1 }
    } else {
        // Fallback: nanotime + LCG stretch. Not cryptographic; hedge
        // for a container where /dev/urandom isn't accessible.
        let seed = int_and(nanotime(), 32767)
        if seed == 0 { seed = 1 }
        let i = 0
        while i < 16 {
            seed = int_and(int_add(int_mul(seed, 1103), 12345), 32767)
            push(bytes, int_and(int_shr(seed, 7), 255))
            i = i + 1
        }
    }
    let out = ""
    let j = 0
    while j < 16 {
        let b = bytes[j]
        out = out + _cap_nibble_hex(b / 16) + _cap_nibble_hex(b - (b / 16) * 16)
        j = j + 1
    }
    return out
}

// ---- audit-tag helper ---------------------------------------------------
//
// Any observation created by a request (mediated by meta_observer) can
// carry the token's holder as an ADDITIONAL parser-side tag, distinct
// from src:skill:* / src:pattern:*. Callers thread this through to
// `mo_attribute` calls where relevant.

fn capability_holder_source_tag(t) {
    if t == 0 { return "src:token:anonymous" }
    return "src:token:" + token_holder(t)
}
