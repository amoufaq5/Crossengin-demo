// CrossEngin sandbox: per-holder resource ownership overlay (R55.2,
// ADR-0105 §Multi-user).
//
// An OWNERSHIP OVERLAY maps (resource_kind, resource_name) -> owner
// holder string. It's a SIDE registry: kg_manager + capsule_registry
// stay untouched, and every existing test / call site keeps working
// unchanged. The RPC verbs (kg.list, capsule.list) consult the
// overlay when it's wired into the RpcContext and filter their
// output; without an overlay every list is fully-visible (backward
// compat with R49/R50/R54).
//
// The visibility rule is deliberately narrow:
//
//   ownership_visible(reg, kind, name, holder) = 1 if
//     - the name has no owner set in the overlay (public/unset), OR
//     - the name's owner is exactly `holder` (case-sensitive)
//   otherwise 0.
//
// Anonymous callers (holder = "") can see ONLY unset/public
// resources. That's the intended behavior for sandbox-ON, sandbox-OFF
// still works: without an overlay wired, filtering is skipped entirely
// so anonymous callers see everything (which matches "there's no
// enforcement configured").
//
// Resource KINDS ship today: "kg" and "capsule". Adding a new kind
// (skill? persona?) is a one-line change in ownership_kinds(). The
// overlay is DATA -- it doesn't know how to enumerate resources; the
// verb layer walks the underlying registry and asks the overlay per
// name.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- resource kinds -----------------------------------------------------

let OWN_KIND_KG      = "kg"
let OWN_KIND_CAPSULE = "capsule"
// R57: skills can be owned too. Unlike kg/capsule which govern LIST
// visibility, skill ownership governs EXECUTION -- skill.run refuses
// when the presented holder can't see the skill under the overlay.
let OWN_KIND_SKILL   = "skill"
// R63: pattern capsules (R53 / R61 / R62) can be owned too. Governs
// LIST visibility (pattern.list filters like kg.list) AND scoped
// match results (pattern_registry_match_scoped). Auto-assigned by
// pattern.install to the presented holder when an overlay is wired;
// absent an overlay the process-wide singleton registry stays fully
// visible (R53/R61/R62 backward compat).
let OWN_KIND_PATTERN = "pattern"

// The kinds this module knows about. Extending is one-line here plus
// wiring in the RPC verb.
fn ownership_kinds() {
    let out = list_new()
    push(out, OWN_KIND_KG)
    push(out, OWN_KIND_CAPSULE)
    push(out, OWN_KIND_SKILL)
    push(out, OWN_KIND_PATTERN)
    return out
}

fn ownership_is_known_kind(kind) {
    if str_eq_bytes(kind, OWN_KIND_KG)      == 1 { return 1 }
    if str_eq_bytes(kind, OWN_KIND_CAPSULE) == 1 { return 1 }
    if str_eq_bytes(kind, OWN_KIND_SKILL)   == 1 { return 1 }
    if str_eq_bytes(kind, OWN_KIND_PATTERN) == 1 { return 1 }
    return 0
}

// ---- Entry slot layout --------------------------------------------------
//
// Each overlay entry is [kind, name, owner]. Flat list keeps enumeration
// cheap; expected max size is small (dozens of resources per daemon).

let OWN_ENTRY_KIND  = 0
let OWN_ENTRY_NAME  = 1
let OWN_ENTRY_OWNER = 2

// ---- registry constructor + accessors ----------------------------------

fn ownership_registry_new() {
    let r = list_new()
    push(r, list_new())     // ENTRIES
    return r
}

fn _own_entries(reg) { return reg[0] }
fn ownership_registry_count(reg) { return len(reg[0]) }

// Look up the (kind, name) entry; returns the entry (list) or 0.
fn _own_find(reg, kind, name) {
    let es = _own_entries(reg)
    let i = 0
    while i < len(es) {
        let e = es[i]
        if str_eq_bytes(e[OWN_ENTRY_KIND], kind) == 1 {
            if str_eq_bytes(e[OWN_ENTRY_NAME], name) == 1 { return e }
        }
        i = i + 1
    }
    return 0
}

// Set (or update) an ownership record. An empty `owner` string CLEARS
// the entry (name becomes public/unset). Idempotent.
// Returns 1 on set/update, 0 on clear (whether or not present),
// -1 on unknown kind.
fn ownership_set(reg, kind, name, owner) {
    if ownership_is_known_kind(kind) == 0 { return 0 - 1 }
    if len(name) == 0 { return 0 - 1 }
    if len(owner) == 0 {
        // Clear: remove any existing entry.
        let es = _own_entries(reg)
        let out = list_new()
        let i = 0
        while i < len(es) {
            let e = es[i]
            let keep = 1
            if str_eq_bytes(e[OWN_ENTRY_KIND], kind) == 1 {
                if str_eq_bytes(e[OWN_ENTRY_NAME], name) == 1 { keep = 0 }
            }
            if keep == 1 { push(out, e) }
            i = i + 1
        }
        list_set(reg, 0, out)
        return 0
    }
    let existing = _own_find(reg, kind, name)
    if existing != 0 {
        list_set(existing, OWN_ENTRY_OWNER, owner)
        return 1
    }
    let e = list_new()
    push(e, kind) push(e, name) push(e, owner)
    push(_own_entries(reg), e)
    return 1
}

// Return the owner string for (kind, name); "" if unset/public.
fn ownership_owner(reg, kind, name) {
    if reg == 0 { return "" }
    let e = _own_find(reg, kind, name)
    if e == 0 { return "" }
    return e[OWN_ENTRY_OWNER]
}

// Is (kind, name) visible to `holder`? Rules:
//   - No overlay wired (reg == 0): always 1 (backward compat)
//   - Name not in overlay: 1 (public / unset)
//   - Name has owner: 1 iff owner == holder (case-sensitive)
fn ownership_visible(reg, kind, name, holder) {
    if reg == 0 { return 1 }
    let owner = ownership_owner(reg, kind, name)
    if len(owner) == 0 { return 1 }                        // unset = public
    if str_eq_bytes(owner, holder) == 1 { return 1 }       // exact match
    return 0
}

// Filter a list of resource names to only those visible to `holder`
// under (kind). Preserves input order (audit-friendly). Callers pass
// the FULL enumeration (from kg_count/kg_get, or capreg_capsules)
// and get the visible subset back.
fn ownership_filter(reg, kind, names, holder) {
    if reg == 0 { return names }
    let out = list_new()
    let i = 0
    while i < len(names) {
        if ownership_visible(reg, kind, names[i], holder) == 1 {
            push(out, names[i])
        }
        i = i + 1
    }
    return out
}

// Enumerate every entry as a list of [kind, name, owner] triples.
// For admin audit surfaces (a future ownership.list wire verb).
fn ownership_entries(reg) {
    if reg == 0 { return list_new() }
    return _own_entries(reg)
}

// ---- convenience wrappers for the two ship-today kinds -----------------

fn ownership_set_kg(reg, kg_label, owner) {
    return ownership_set(reg, OWN_KIND_KG, kg_label, owner)
}

fn ownership_kg_visible(reg, kg_label, holder) {
    return ownership_visible(reg, OWN_KIND_KG, kg_label, holder)
}

fn ownership_set_capsule(reg, capsule_name, owner) {
    return ownership_set(reg, OWN_KIND_CAPSULE, capsule_name, owner)
}

fn ownership_capsule_visible(reg, capsule_name, holder) {
    return ownership_visible(reg, OWN_KIND_CAPSULE, capsule_name, holder)
}

fn ownership_set_skill(reg, skill_name, owner) {
    return ownership_set(reg, OWN_KIND_SKILL, skill_name, owner)
}

// R57: unlike kg/capsule, this gate governs EXECUTION -- the
// skill.run wire verb consults it before dispatching. An unset skill
// (no owner in the overlay) is callable by everyone (backward compat);
// an owned skill is callable only by its exact holder. Anonymous
// callers (no valid token) cannot invoke owned skills.
fn ownership_skill_visible(reg, skill_name, holder) {
    return ownership_visible(reg, OWN_KIND_SKILL, skill_name, holder)
}

// R63: pattern-capsule ownership. pattern.list filters by this;
// pattern.install auto-assigns ownership when the overlay is wired.
// A future R64+ can gate skill-time pattern_registry_match by the
// same rule (holder-scoped advice pool).
fn ownership_set_pattern(reg, pattern_name, owner) {
    return ownership_set(reg, OWN_KIND_PATTERN, pattern_name, owner)
}

fn ownership_pattern_visible(reg, pattern_name, holder) {
    return ownership_visible(reg, OWN_KIND_PATTERN, pattern_name, holder)
}
