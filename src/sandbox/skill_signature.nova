// CrossEngin sandbox: signed skill install (R54.2, ADR-0105 §Signed
// skill install).
//
// A SkillPackage is a signed wrapper around a SkillManifest. Before
// the daemon accepts a skill.install request from the wire, the
// package's signature is checked against the caller's trust anchors.
// Refuses unsigned or untrusted-signed installs; passes cleanly for
// pre-anchored built-ins (echo, research, coding_helper are compiled
// into the daemon binary and never travel over the wire).
//
// What R54.2 signs: the CANONICAL manifest (name / version /
// description / policy_id / tier / effectors / capsule deps /
// refusal conditions). NOT the policy body / bytecode -- that waits
// on a NOVA-side policy-loading story. So a signed manifest limits
// WHAT a skill can do (declared effectors + refusal conditions +
// dep list) without proving HOW the code implements it. A shop's
// trust-anchor list decides which signer they extend that limited
// trust to.
//
// The signature covers:
//   sha256(canonical_manifest_string)
// signed with ed25519 under (seed, signer_pk). This is deliberate:
// ed25519_sign gives its strongest guarantees on a 32-byte digest
// input (same shape merkle_signing uses); the pre-hash also lets
// callers avoid materializing arbitrarily-long buffers for wire-
// serialized manifests.
//
// The 5 ADR-0103 guarantees are preserved end-to-end -- signed
// skill install is a NEW refusal class layered on top of
// skill_registry_install, never a relaxation of any existing
// guarantee.
//
// NOVA dependencies: builtins (ed25519_sign, ed25519_verify).
// CrossEngin dependencies:
//   src/skills/skill_manifest.nova
//   src/safety/sha256.nova
//   src/util/str_safe.nova.

import "../skills/skill_manifest.nova"
import "../safety/ed25519.nova"
import "../safety/sha256.nova"
import "../util/str_safe.nova"

// ed25519 shape constants.
let SKPKG_PK_LEN   = 32
let SKPKG_SEED_LEN = 32
let SKPKG_SIG_LEN  = 64
let SKPKG_HASH_LEN = 32

// ---- SkillPackage slot layout -------------------------------------------

let SKPKG_MANIFEST      = 0    // SkillManifest (the actual runtime object)
let SKPKG_SIGNER_PK     = 1    // list<int> length 32 (ed25519 public key)
let SKPKG_SIGNATURE     = 2    // list<int> length 64 (ed25519 signature)
let SKPKG_CANONICAL     = 3    // string (the pre-hash canonical form,
                                //         kept for audit + re-verify)
let SKPKG_SLOTS         = 4

// ---- canonical serialization --------------------------------------------
//
// Deterministic textual form the signer + verifier both compute
// identically. Field order is FIXED (not a for-loop over a hash map
// -- NOVA doesn't guarantee map key order and skill_manifest_effectors
// is already order-sensitive by manifest_add order). Every field is
// on its own line with a "key=value" shape. Values with an ASCII '='
// are still safe because the FIRST '=' per line delimits the value.

fn _sig_lines_join(prefix, xs) {
    let out = ""
    let i = 0
    while i < len(xs) {
        out = out + prefix + xs[i] + "\n"
        i = i + 1
    }
    return out
}

// A refusal condition is [kind_int, arg_string]. Serialize as
// "refusal=<int>:<arg>".
fn _sig_refusals_lines(conds) {
    let out = ""
    let i = 0
    while i < len(conds) {
        let c = conds[i]
        out = out + "refusal=" + int_to_str(c[0]) + ":" + c[1] + "\n"
        i = i + 1
    }
    return out
}

// A capsule dep is [name, min_version]. Serialize as "capsule=<n>:<v>".
fn _sig_capsule_deps_lines(deps) {
    let out = ""
    let i = 0
    while i < len(deps) {
        let d = deps[i]
        out = out + "capsule=" + d[0] + ":" + d[1] + "\n"
        i = i + 1
    }
    return out
}

// Canonicalize a manifest. Same string for the same manifest, any
// process, any time. Field order fixed here; adding fields in the
// future MUST append (not insert) so existing signatures remain
// valid until callers explicitly re-sign.
fn skill_pkg_canonicalize(manifest) {
    if manifest == 0 { return "" }
    let out = "crossengin-skill-manifest-v1\n"
    out = out + "name="        + skill_manifest_name(manifest)        + "\n"
    out = out + "version="     + skill_manifest_version(manifest)     + "\n"
    out = out + "policy_id="   + int_to_str(skill_manifest_policy_id(manifest)) + "\n"
    out = out + "tier="        + int_to_str(skill_manifest_capability_tier(manifest)) + "\n"
    out = out + "description=" + skill_manifest_description(manifest) + "\n"
    out = out + _sig_lines_join("effector=", skill_manifest_effectors(manifest))
    out = out + _sig_capsule_deps_lines(skill_manifest_required_capsules(manifest))
    out = out + _sig_refusals_lines(skill_manifest_refusal_conds(manifest))
    return out
}

// String -> byte list (each char is a 0..255 int).
fn _sig_str_to_bytes(s) {
    let out = list_new()
    let n = len(s)
    let i = 0
    while i < n { push(out, char_at(s, i)) i = i + 1 }
    return out
}

// Hash the canonical form (32-byte byte list). Ships as the pre-image
// ed25519_sign/verify consume.
fn skill_pkg_hash_manifest(manifest) {
    let canon = skill_pkg_canonicalize(manifest)
    return sha256_oneshot_bytes(_sig_str_to_bytes(canon))
}

// ---- constructors + accessors ------------------------------------------

fn skill_pkg_new(manifest, signer_pk, signature) {
    let p = list_new()
    push(p, manifest)                              // MANIFEST
    push(p, signer_pk)                              // SIGNER_PK
    push(p, signature)                              // SIGNATURE
    push(p, skill_pkg_canonicalize(manifest))       // CANONICAL
    return p
}

fn skill_pkg_manifest(p)   { return p[SKPKG_MANIFEST] }
fn skill_pkg_signer_pk(p)  { return p[SKPKG_SIGNER_PK] }
fn skill_pkg_signature(p)  { return p[SKPKG_SIGNATURE] }
fn skill_pkg_canonical(p)  { return p[SKPKG_CANONICAL] }

// ---- sign / verify ------------------------------------------------------

// Sign a manifest under (seed, signer_pk). Both must be 32-byte byte
// lists. Returns a 64-byte signature list, or 0 on shape error.
fn skill_pkg_sign(manifest, signer_seed, signer_pk) {
    if manifest == 0 { return 0 }
    if signer_seed == 0 { return 0 }
    if signer_pk == 0 { return 0 }
    if len(signer_seed) != SKPKG_SEED_LEN { return 0 }
    if len(signer_pk)   != SKPKG_PK_LEN   { return 0 }
    let hash = skill_pkg_hash_manifest(manifest)
    return ed25519_sign(hash, signer_seed, signer_pk)
}

// Verify the package's signature. Returns 1 on valid, 0 on any
// mismatch (tampered manifest, tampered signature, wrong pubkey,
// wrong shape).
fn skill_pkg_verify(pkg) {
    if pkg == 0 { return 0 }
    let m  = skill_pkg_manifest(pkg)
    let pk = skill_pkg_signer_pk(pkg)
    let sg = skill_pkg_signature(pkg)
    if m == 0  { return 0 }
    if pk == 0 { return 0 }
    if sg == 0 { return 0 }
    if len(pk) != SKPKG_PK_LEN  { return 0 }
    if len(sg) != SKPKG_SIG_LEN { return 0 }
    let hash = skill_pkg_hash_manifest(m)
    return ed25519_verify(hash, sg, pk)
}

// ---- trust anchor registry ---------------------------------------------
//
// A trust anchor is a signer pubkey the operator has decided to trust.
// The registry stores byte-list pubkeys directly (no cert chain / no
// intermediate CAs -- R54.2 is direct trust). External skills whose
// signature verifies AND whose signer_pk is in the anchor list are
// accepted. Everything else is refused.
//
// R55+ could add chained trust (an anchor CA signing shorter-lived
// author keys). For R54.2 the direct-trust list is the primitive.

fn trust_anchor_registry_new() {
    let r = list_new()
    push(r, list_new())        // ANCHORS
    return r
}

fn trust_anchor_registry_anchors(reg) { return reg[0] }
fn trust_anchor_registry_count(reg)   { return len(reg[0]) }

// Byte-list equality.
fn _sig_bytes_eq(a, b) {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    if len(a) != len(b) { return 0 }
    let i = 0
    while i < len(a) {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// Add a signer pubkey to the trust list. Idempotent (a repeat add is
// a no-op). Returns 1 if newly added, 0 if already present, -1 on shape.
fn trust_anchor_add(reg, pubkey) {
    if pubkey == 0 { return 0 - 1 }
    if len(pubkey) != SKPKG_PK_LEN { return 0 - 1 }
    let anchors = reg[0]
    let i = 0
    while i < len(anchors) {
        if _sig_bytes_eq(anchors[i], pubkey) == 1 { return 0 }
        i = i + 1
    }
    push(anchors, pubkey)
    return 1
}

fn trust_anchor_trusts(reg, pubkey) {
    if reg == 0 { return 0 }
    if pubkey == 0 { return 0 }
    let anchors = reg[0]
    let i = 0
    while i < len(anchors) {
        if _sig_bytes_eq(anchors[i], pubkey) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn trust_anchor_remove(reg, pubkey) {
    if reg == 0 { return 0 }
    if pubkey == 0 { return 0 }
    let anchors = reg[0]
    let i = 0
    let out = list_new()
    let removed = 0
    while i < len(anchors) {
        if _sig_bytes_eq(anchors[i], pubkey) == 1 {
            removed = 1
        } else {
            push(out, anchors[i])
        }
        i = i + 1
    }
    list_set(reg, 0, out)
    return removed
}

// ---- authorization gate -------------------------------------------------
//
// The core check the RPC daemon runs when skill.install arrives from
// the wire under signing-enforced mode. Returns "" (empty) on
// authorized; a human-readable refusal string otherwise. Mirrors
// capability_authorize's shape so the daemon can compose the two
// gates uniformly (skill.install goes through both: capability check
// for the "skill:install" cap AND signature check via this function).
//
// Enforcement is OPT-IN: pass `enforced = 0` and this returns ""
// unconditionally (backward-compat pass-through for R49/R50/R54
// deployments that don't want signature enforcement).

fn skill_pkg_authorize(enforced, trust_reg, pkg) {
    if enforced == 0 { return "" }
    if pkg == 0 {
        return "signed skill required: no SkillPackage supplied"
    }
    if trust_reg == 0 {
        return "signed skill required: no trust-anchor registry configured"
    }
    if skill_pkg_verify(pkg) == 0 {
        return "signed skill refused: signature does not verify against declared signer_pk"
    }
    if trust_anchor_trusts(trust_reg, skill_pkg_signer_pk(pkg)) == 0 {
        return "signed skill refused: signer_pk not in trust-anchor list"
    }
    return ""
}

// ---- audit source-tag helper -------------------------------------------

// A signed install's provenance stamp for meta_observer + trace. The
// pubkey is rendered as its short (first-8-bytes) hex fingerprint so
// audit output stays compact. Full pubkey is still on the package.

fn _sig_nibble_hex(n) {
    if n < 10 { return chr(48 + n) }         // 0..9
    return chr(87 + n)                        // a..f
}

fn _sig_pk_short_hex(pk) {
    if pk == 0 { return "unknown" }
    let n = 8
    if len(pk) < n { n = len(pk) }
    let out = ""
    let i = 0
    while i < n {
        let b = pk[i]
        out = out + _sig_nibble_hex(b / 16) + _sig_nibble_hex(b - (b / 16) * 16)
        i = i + 1
    }
    return out
}

fn skill_pkg_source_tag(pkg) {
    if pkg == 0 { return "src:skill:unsigned" }
    return "src:skill:signed:" + _sig_pk_short_hex(skill_pkg_signer_pk(pkg))
}
