// CrossEngin ingestion: source-format registry.
//
// A tiny dispatch table mapping short format names ("jsonl", "csv",
// "ntriples", "wikidata", "conceptnet", "papermeta", "wordnet", ...) to
// {parse_fn, source_prefix} pairs. The ingestion agent looks up the format,
// gets the parse function, calls it on the input path, and gets back a
// list of curriculum records ready for the pipeline or review queue.
//
// Parse-fn contract
//   fn parse(path, extra_arg) -> list of curriculum records
//   The parser reads its input via the standard read_file, walks the text
//   with str_safe helpers, and emits records via cur_new/cur_add_*. Extra
//   arg is format-specific (e.g. Wikidata's labels file). Parsers MUST NOT
//   touch the KG registry themselves -- they produce records; the pipeline
//   applies them. This keeps the pipeline the single point where atoms
//   actually move.
//
// Registration
//   Callers register with reg_source_add(reg, name, prefix, parse_fn). At
//   dispatch time reg_source_get(reg, name) returns [name, prefix, fn] or
//   0 if the name is unregistered. Because NOVA does not expose function
//   references as first-class values in every build, the registry stores
//   an INTEGER TAG per format that the driver switches on -- this file
//   defines the canonical tags, and reg_source_dispatch does the switch.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/util/str_safe.nova (str_eq_bytes for name lookup).

import "../util/str_safe.nova"

// ---- canonical format tags ------------------------------------------------
let FMT_UNKNOWN     = 0
let FMT_CEREC       = 1    // CrossEngin native line-based records (.cerec)
let FMT_CSV         = 2
let FMT_NTRIPLES    = 3
let FMT_WIKIDATA    = 4
let FMT_CONCEPTNET  = 5
let FMT_PAPERMETA   = 6
let FMT_WORDNET     = 7
let FMT_LLM_EXTRACT = 8    // LLM-emitted .cerec (routes through review queue by default)
let FMT_JSON        = 9    // R65: structured JSON records
let FMT_YAML        = 10   // R85: structured YAML records (config-shaped packs)
// R105 (Phase G, ADR-0202): perceptual formats. Each carries binary
// content decoded to a unified perceptual atom (perc:<mod>:<hash16>)
// plus per-modality metadata siblings. Wire dispatch reads the body
// as a NOVA string; char_at handles embedded NULs. Text-derived
// atoms (OCR / STT) are opt-in via CROSSENGIN_OCR_ENABLED /
// CROSSENGIN_STT_ENABLED, disabled by default in R105.
let FMT_IMAGE       = 11   // PNG signature + JPEG SOI; IHDR / SOFn dims
let FMT_AUDIO       = 12   // WAV RIFF PCM; sample_rate / channels / bits
let FMT_VIDEO       = 13   // Y4M YUV4MPEG2 header; W / H / F

// ---- registry entry slots -------------------------------------------------
let SR_NAME    = 0
let SR_TAG     = 1
let SR_PREFIX  = 2    // suggested source-tag prefix (e.g. "src:wikidata:")

// ---- registry -------------------------------------------------------------

fn reg_source_new() { return list_new() }

fn reg_source_add(reg, name, tag, prefix) {
    let e = list_new()
    push(e, name) push(e, tag) push(e, prefix)
    push(reg, e)
    return e
}

// Look up an entry by name. Returns the entry list or 0.
fn reg_source_get(reg, name) {
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(reg[i][SR_NAME], name) == 1 { return reg[i] }
        i = i + 1
    }
    return 0
}

// Convenience: lookup returning just the tag (or FMT_UNKNOWN).
fn reg_source_tag(reg, name) {
    let e = reg_source_get(reg, name)
    if e == 0 { return FMT_UNKNOWN }
    return e[SR_TAG]
}

// Install the CrossEngin default catalogue. Idempotent: re-installing on a
// fresh registry is fine, but calling twice on the same registry will
// duplicate entries (the lookup returns the first match, so behavior is
// unchanged, but rq_size will grow). Callers wanting idempotency should
// use a fresh reg_source_new() per session.
fn reg_source_install_defaults(reg) {
    reg_source_add(reg, "cerec",      FMT_CEREC,       "src:cerec:")
    reg_source_add(reg, "csv",        FMT_CSV,         "src:csv:")
    reg_source_add(reg, "ntriples",   FMT_NTRIPLES,    "src:nt:")
    reg_source_add(reg, "wikidata",   FMT_WIKIDATA,    "src:wikidata:")
    reg_source_add(reg, "conceptnet", FMT_CONCEPTNET,  "src:conceptnet:")
    reg_source_add(reg, "papermeta",  FMT_PAPERMETA,   "src:paper:")
    reg_source_add(reg, "wordnet",    FMT_WORDNET,     "src:wordnet:")
    reg_source_add(reg, "llm",        FMT_LLM_EXTRACT, "src:extractor:llm:")
    reg_source_add(reg, "json",       FMT_JSON,        "src:json:")
    reg_source_add(reg, "yaml",       FMT_YAML,        "src:yaml:")
    // R105 -- Phase G perceptual formats (ADR-0202).
    reg_source_add(reg, "image",      FMT_IMAGE,       "src:image:")
    reg_source_add(reg, "audio",      FMT_AUDIO,       "src:audio:")
    reg_source_add(reg, "video",      FMT_VIDEO,       "src:video:")
    return len(reg)
}

fn reg_source_name(tag) {
    if tag == FMT_CEREC       { return "cerec" }
    if tag == FMT_CSV         { return "csv" }
    if tag == FMT_NTRIPLES    { return "ntriples" }
    if tag == FMT_WIKIDATA    { return "wikidata" }
    if tag == FMT_CONCEPTNET  { return "conceptnet" }
    if tag == FMT_PAPERMETA   { return "papermeta" }
    if tag == FMT_WORDNET     { return "wordnet" }
    if tag == FMT_LLM_EXTRACT { return "llm" }
    if tag == FMT_JSON        { return "json" }
    if tag == FMT_YAML        { return "yaml" }
    if tag == FMT_IMAGE       { return "image" }
    if tag == FMT_AUDIO       { return "audio" }
    if tag == FMT_VIDEO       { return "video" }
    return "unknown"
}
