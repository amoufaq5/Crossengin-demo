// CrossEngin ingestion: curriculum-record schema and validator.
//
// A curriculum record is the canonical shape ALL ingest paths converge on --
// the JSONL importer, the CSV importer, the N-Triples importer, the paper
// extractor, and the LLM-preprocessor bridge all produce records in this
// shape before the pipeline (src/ingest/pipeline.nova) turns them into KG
// state. Keeping one shape (not one-per-format) is what makes cross-source
// atrophy attribution + cross-KG consistency scans work uniformly: two
// atoms with the same label are the same atom whether they came from
// Wikidata, a PDF, or a user's /assert -- source diverges, identity does not.
//
// Record layout (all fields are lists; NOVA has no JSON):
//   record = [
//     kg_name,                         (string; target KG in the registry)
//     source_tag,                      (string; the src:... tag)
//     atoms,                           (list of atom records)
//     implications,                    (list of implication records)
//     observations,                    (list of observation records)
//     citations                        (list of citation records)
//   ]
//
//   atom_rec  = [label, kind, seed_belief]      (kind: ATOM_FACT|CONCEPT|...
//                                                seed_belief in milli 0..1000)
//   imp_rec   = [antecedent, consequent, strength]
//                                                strength: "FORMAL" | "EMPIRICAL"
//   obs_rec   = [atom_label, sign, weight]      (sign +/-1; weight in milli)
//   cite_rec  = [from_source, to_source, relation]
//                                                relation: "supports"|"contradicts"|"extends"
//
// The validator (cur_validate) checks structural well-formedness only. It
// does NOT reason about content -- a record naming a nonexistent atom in an
// implication is caught at pipeline time (that's where the KG state lives),
// not here.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova (str_eq_bytes).

import "../util/str_safe.nova"

// ---- slot indices (record) ------------------------------------------------
let CUR_KG          = 0
let CUR_SOURCE      = 1
let CUR_ATOMS       = 2
let CUR_IMPS        = 3
let CUR_OBS         = 4
let CUR_CITES       = 5
let CUR_FIELDS      = 6

// ---- slot indices (sub-records) -------------------------------------------
let CUR_ATOM_LABEL  = 0
let CUR_ATOM_KIND   = 1
let CUR_ATOM_BELIEF = 2

let CUR_IMP_ANTE    = 0
let CUR_IMP_CONSEQ  = 1
let CUR_IMP_STR     = 2

let CUR_OBS_LABEL   = 0
let CUR_OBS_SIGN    = 1
let CUR_OBS_WEIGHT  = 2

let CUR_CITE_FROM   = 0
let CUR_CITE_TO     = 1
let CUR_CITE_REL    = 2

// ---- validator return codes -----------------------------------------------
let CUR_OK              = 0
let CUR_ERR_SHAPE       = -1  // top-level not a 6-list
let CUR_ERR_KG          = -2  // kg name empty or not a string
let CUR_ERR_SOURCE      = -3  // source tag missing or not "src:..."-shaped
let CUR_ERR_ATOM        = -4  // atom sub-record malformed
let CUR_ERR_IMP         = -5  // implication sub-record malformed
let CUR_ERR_OBS         = -6  // observation sub-record malformed
let CUR_ERR_CITE        = -7  // citation sub-record malformed
let CUR_ERR_BELIEF_RANGE= -8  // seed belief outside [0,1000]
let CUR_ERR_SIGN        = -9  // observation sign not +1 / -1

// ---- constructors ---------------------------------------------------------

// New empty record for `kg_name` attributed to `source_tag`.
fn cur_new(kg_name, source_tag) {
    let r = list_new()
    push(r, kg_name)                    // CUR_KG
    push(r, source_tag)                 // CUR_SOURCE
    push(r, list_new())                 // CUR_ATOMS
    push(r, list_new())                 // CUR_IMPS
    push(r, list_new())                 // CUR_OBS
    push(r, list_new())                 // CUR_CITES
    return r
}

fn cur_add_atom(r, label, kind, seed_belief) {
    let a = list_new()
    push(a, label) push(a, kind) push(a, seed_belief)
    push(r[CUR_ATOMS], a)
    return a
}

fn cur_add_imp(r, ante_label, conseq_label, strength) {
    let i = list_new()
    push(i, ante_label) push(i, conseq_label) push(i, strength)
    push(r[CUR_IMPS], i)
    return i
}

fn cur_add_obs(r, label, sign, weight) {
    let o = list_new()
    push(o, label) push(o, sign) push(o, weight)
    push(r[CUR_OBS], o)
    return o
}

fn cur_add_cite(r, from_src, to_src, rel) {
    let c = list_new()
    push(c, from_src) push(c, to_src) push(c, rel)
    push(r[CUR_CITES], c)
    return c
}

// ---- accessors ------------------------------------------------------------

fn cur_kg(r)          { return r[CUR_KG] }
fn cur_source(r)      { return r[CUR_SOURCE] }
fn cur_atoms(r)       { return r[CUR_ATOMS] }
fn cur_imps(r)        { return r[CUR_IMPS] }
fn cur_obs(r)         { return r[CUR_OBS] }
fn cur_cites(r)       { return r[CUR_CITES] }

fn cur_size(r) {
    return len(r[CUR_ATOMS]) + len(r[CUR_IMPS])
         + len(r[CUR_OBS])   + len(r[CUR_CITES])
}

// ---- validator ------------------------------------------------------------

// Source tag must be non-empty and start with the four-byte prefix "src:"
// so downstream attribution and meta-observer atrophy tracking can trust
// the shape without a per-format special case.
fn _cur_source_ok(s) {
    if len(s) < 5 { return 0 }
    if char_at(s, 0) != 115 { return 0 }   // 's'
    if char_at(s, 1) != 114 { return 0 }   // 'r'
    if char_at(s, 2) != 99  { return 0 }   // 'c'
    if char_at(s, 3) != 58  { return 0 }   // ':'
    return 1
}

// Validate a curriculum record. Returns CUR_OK (0) on success, negative
// CUR_ERR_* code on failure. Structural only -- content-level integrity
// (dangling implication targets, KG existence) is checked at pipeline
// time where the state to check against actually lives.
fn cur_validate(r) {
    if r == 0 { return CUR_ERR_SHAPE }
    if len(r) < CUR_FIELDS { return CUR_ERR_SHAPE }
    if len(r[CUR_KG]) == 0 { return CUR_ERR_KG }
    if _cur_source_ok(r[CUR_SOURCE]) == 0 { return CUR_ERR_SOURCE }
    // atoms
    let atoms = r[CUR_ATOMS]
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if len(a) < 3 { return CUR_ERR_ATOM }
        if len(a[CUR_ATOM_LABEL]) == 0 { return CUR_ERR_ATOM }
        let bel = a[CUR_ATOM_BELIEF]
        if bel < 0 { return CUR_ERR_BELIEF_RANGE }
        if bel > 1000 { return CUR_ERR_BELIEF_RANGE }
        i = i + 1
    }
    // implications
    let imps = r[CUR_IMPS]
    let j = 0
    while j < len(imps) {
        let ii = imps[j]
        if len(ii) < 3 { return CUR_ERR_IMP }
        if len(ii[CUR_IMP_ANTE]) == 0 { return CUR_ERR_IMP }
        if len(ii[CUR_IMP_CONSEQ]) == 0 { return CUR_ERR_IMP }
        j = j + 1
    }
    // observations
    let obs = r[CUR_OBS]
    let k = 0
    while k < len(obs) {
        let o = obs[k]
        if len(o) < 3 { return CUR_ERR_OBS }
        if len(o[CUR_OBS_LABEL]) == 0 { return CUR_ERR_OBS }
        let sgn = o[CUR_OBS_SIGN]
        if sgn != 1 { if sgn != (0 - 1) { return CUR_ERR_SIGN } }
        k = k + 1
    }
    // citations
    let cites = r[CUR_CITES]
    let m = 0
    while m < len(cites) {
        let c = cites[m]
        if len(c) < 3 { return CUR_ERR_CITE }
        if _cur_source_ok(c[CUR_CITE_FROM]) == 0 { return CUR_ERR_CITE }
        if _cur_source_ok(c[CUR_CITE_TO])   == 0 { return CUR_ERR_CITE }
        m = m + 1
    }
    return CUR_OK
}

// Human-readable label for a validator return code.
fn cur_err_name(code) {
    if code == CUR_OK               { return "ok" }
    if code == CUR_ERR_SHAPE        { return "malformed-record-shape" }
    if code == CUR_ERR_KG           { return "missing-or-empty-kg-name" }
    if code == CUR_ERR_SOURCE       { return "missing-or-malformed-source-tag" }
    if code == CUR_ERR_ATOM         { return "malformed-atom-entry" }
    if code == CUR_ERR_IMP          { return "malformed-implication-entry" }
    if code == CUR_ERR_OBS          { return "malformed-observation-entry" }
    if code == CUR_ERR_CITE         { return "malformed-citation-entry" }
    if code == CUR_ERR_BELIEF_RANGE { return "seed-belief-out-of-range-0..1000" }
    if code == CUR_ERR_SIGN         { return "observation-sign-must-be-plus-or-minus-1" }
    return "unknown"
}
