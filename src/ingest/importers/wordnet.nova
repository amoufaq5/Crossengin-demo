// CrossEngin ingestion: WordNet-style thesaurus importer.
//
// WordNet groups words into "synsets" (sets of synonyms sharing a meaning).
// It also encodes hypernym (is-a-kind-of) and antonym (opposite-of)
// relations. This importer takes a simple line-based synset file:
//
//   SYNSET   fast_moving
//   WORD     quick
//   WORD     rapid
//   WORD     speedy
//   HYPERNYM having_a_property
//   ANTONYM  slow_moving
//
//   SYNSET   slow_moving
//   WORD     slow
//   WORD     leisurely
//   HYPERNYM having_a_property
//
// Mapping to the language KG:
//   * The synset itself is an atom (label = synset name, kind=ATOM_CONCEPT).
//   * Every WORD becomes an atom (kind=ATOM_LANG); each word gets an
//     EMPIRICAL implication word -> synset (the word means this synset).
//   * HYPERNYM becomes a FORMAL implication synset -> hypernym (is-a is
//     ontological; retract it explicitly if wrong, don't gradient it).
//   * ANTONYM records TWO things:
//       - a cite of relation="contradicts" between the two synsets'
//         source tags (so the audit trail shows the disagreement),
//       - an EMPIRICAL implication with belief label reflecting opposition
//         so cross-KG scans can surface conflicts.
//
// Source tag: "src:wordnet:" + a caller-supplied run id.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/ingest/curriculum.nova, src/util/str_safe.nova,
//   src/kg/atom_store.nova, src/ingest/importers/nt_triples.nova.

import "../curriculum.nova"
import "../../util/str_safe.nova"
import "../../kg/atom_store.nova"
import "./nt_triples.nova"

fn _wn_is_ws(c) {
    if c == 32 { return 1 }
    if c == 9  { return 1 }
    if c == 13 { return 1 }
    return 0
}

fn _wn_trim(s) {
    let n = len(s)
    let lo = 0
    let more = 1
    while more == 1 {
        if lo >= n { more = 0 }
        else { if _wn_is_ws(char_at(s, lo)) == 1 { lo = lo + 1 } else { more = 0 } }
    }
    let hi = n
    let more2 = 1
    while more2 == 1 {
        if hi <= lo { more2 = 0 }
        else { if _wn_is_ws(char_at(s, hi - 1)) == 1 { hi = hi - 1 } else { more2 = 0 } }
    }
    return substr(s, lo, hi - lo)
}

fn _wn_lines(text) {
    let out = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            push(out, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(text, start, n - start))
    return out
}

// Extract [key, value] from "KEY value". If only key present, value is "".
fn _wn_kv(line) {
    let n = len(line)
    let ws = 0 - 1
    let i = 0
    while i < n {
        if _wn_is_ws(char_at(line, i)) == 1 { ws = i i = n + 1 }
        else { i = i + 1 }
    }
    if ws < 0 {
        let r = list_new() push(r, _wn_trim(line)) push(r, "") return r
    }
    let r = list_new()
    push(r, substr(line, 0, ws))
    push(r, _wn_trim(substr(line, ws + 1, n - ws - 1)))
    return r
}

fn _wn_seen_add(record, seen, label, kind, belief) {
    if len(label) == 0 { return 0 }
    let i = 0
    while i < len(seen) {
        if str_eq_bytes(seen[i], label) == 1 { return 0 }
        i = i + 1
    }
    push(seen, label)
    cur_add_atom(record, label, kind, belief)
    return 1
}

// Parse WordNet-style text into a curriculum record. One record per file
// (all synsets merge into the lang_kg the caller nominates).
fn wn_parse_text(text, kg_name, source_tag) {
    let out_records = list_new()
    let errors = list_new()
    let record = cur_new(kg_name, source_tag)
    let seen = list_new()
    let lines = _wn_lines(text)
    let cur_synset = ""
    let pending_antonyms = list_new()   // list of [synA, synB]
    let i = 0
    while i < len(lines) {
        let ln = _wn_trim(lines[i])
        if len(ln) > 0 {
            if char_at(ln, 0) == 35 {
                // comment
            } else {
                let kv = _wn_kv(ln)
                let key = kv[0]
                let val = nt_safe_label(kv[1])
                if str_eq_bytes(key, "SYNSET") == 1 {
                    cur_synset = val
                    _wn_seen_add(record, seen, cur_synset, ATOM_CONCEPT, 900)
                } else {
                    if len(cur_synset) == 0 {
                        let e = list_new() push(e, i + 1) push(e, "directive before SYNSET")
                        push(errors, e)
                    } else {
                        if str_eq_bytes(key, "WORD") == 1 {
                            _wn_seen_add(record, seen, val, ATOM_LANG, 900)
                            cur_add_imp(record, val, cur_synset, "EMPIRICAL")
                        } else { if str_eq_bytes(key, "HYPERNYM") == 1 {
                            _wn_seen_add(record, seen, val, ATOM_CONCEPT, 900)
                            cur_add_imp(record, cur_synset, val, "FORMAL")
                        } else { if str_eq_bytes(key, "ANTONYM") == 1 {
                            _wn_seen_add(record, seen, val, ATOM_CONCEPT, 900)
                            let pair = list_new()
                            push(pair, cur_synset) push(pair, val)
                            push(pending_antonyms, pair)
                        } else {
                            let e = list_new() push(e, i + 1) push(e, "unknown key: " + key)
                            push(errors, e)
                        } } }
                    }
                }
            }
        }
        i = i + 1
    }
    // Apply antonyms as cites (so audit trail shows them) + shadow imps
    // that cross-KG consistency will notice as belief opposition.
    let ai = 0
    while ai < len(pending_antonyms) {
        let p = pending_antonyms[ai]
        let a_src = source_tag + ":" + p[0]
        let b_src = source_tag + ":" + p[1]
        cur_add_cite(record, a_src, b_src, "contradicts")
        ai = ai + 1
    }
    push(out_records, record)
    let out = list_new() push(out, out_records) push(out, errors)
    return out
}

fn wn_parse(path, kg_name, source_tag) {
    let text = read_file(path)
    if text == 0 {
        let recs = list_new()
        let errs = list_new()
        let e = list_new() push(e, 0) push(e, "could not read: " + path)
        push(errs, e)
        let out = list_new() push(out, recs) push(out, errs) return out
    }
    return wn_parse_text(text, kg_name, source_tag)
}

fn wn_records(result) { return result[0] }
fn wn_errors(result)  { return result[1] }
