// CrossEngin ingestion: paper-metadata importer.
//
// Papers (arXiv, OpenAlex, DOI-referenced PDFs) are naturally structured:
// title, authors, year, abstract, DOI, citations. This importer takes a
// simple tab-separated paper-metadata file and produces a curriculum record
// per paper.
//
// Line format (one field per line, blank-line-separated records):
//
//   DOI      10.1038/nature12373
//   TITLE    Cerebral Cortex ...
//   AUTHOR   Smith J
//   AUTHOR   Doe A
//   YEAR     2013
//   ABSTRACT-KEY   memory
//   ABSTRACT-KEY   hippocampus
//   CITES    10.1038/nature10102 supports
//   CITES    10.1126/science.1181662 contradicts
//
// Mapping:
//   * The paper becomes an atom (label = paper_doi_10.1038_nature12373;
//     kind = ATOM_FACT; belief 800).
//   * Each ABSTRACT-KEY becomes an atom + EMPIRICAL implication
//     paper -> key. This is how a paper "declares its topic" -- the meta-
//     observer can then compute "papers under topic K" as an atrophy scan.
//   * Each CITES <doi> <relation> becomes a citation record. If relation
//     is "contradicts", the paper also emits an EMPIRICAL implication
//     to the cited paper's atom with a negative-flavored label so
//     kg_consistency scans can surface the disagreement.
//   * Authors and year become fact atoms + implications from paper.
//
// Source tag pattern: "src:paper:doi:<doi>".
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/ingest/curriculum.nova, src/util/str_safe.nova,
//   src/kg/atom_store.nova, src/ingest/importers/nt_triples.nova
//   (nt_safe_label).

import "../curriculum.nova"
import "../../util/str_safe.nova"
import "../../kg/atom_store.nova"
import "./nt_triples.nova"

// ---- shared line iterator + trim + tokens ---------------------------------

fn _pm_lines(text) {
    let out = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            push(out, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(text, start, n - start))
    return out
}

fn _pm_is_ws(c) {
    if c == 32 { return 1 }
    if c == 9  { return 1 }
    if c == 13 { return 1 }
    return 0
}

fn _pm_trim(s) {
    let n = len(s)
    let lo = 0
    let more = 1
    while more == 1 {
        if lo >= n { more = 0 }
        else { if _pm_is_ws(char_at(s, lo)) == 1 { lo = lo + 1 } else { more = 0 } }
    }
    let hi = n
    let more2 = 1
    while more2 == 1 {
        if hi <= lo { more2 = 0 }
        else { if _pm_is_ws(char_at(s, hi - 1)) == 1 { hi = hi - 1 } else { more2 = 0 } }
    }
    return substr(s, lo, hi - lo)
}

// Split "KEY value..." into [key, rest_trimmed]; returns 0 if no key.
fn _pm_kv(line) {
    let n = len(line)
    let i = 0
    // Find first whitespace.
    let ws = 0 - 1
    while i < n {
        if _pm_is_ws(char_at(line, i)) == 1 { ws = i i = n + 1 }
        else { i = i + 1 }
    }
    if ws < 0 {
        // No value; key-only.
        let r = list_new() push(r, _pm_trim(line)) push(r, "") return r
    }
    let key = substr(line, 0, ws)
    let rest = substr(line, ws + 1, n - ws - 1)
    let r = list_new() push(r, key) push(r, _pm_trim(rest)) return r
}

fn _pm_split_two(s) {
    let n = len(s)
    let ws = 0 - 1
    let i = 0
    while i < n {
        if _pm_is_ws(char_at(s, i)) == 1 { ws = i i = n + 1 }
        else { i = i + 1 }
    }
    if ws < 0 {
        let r = list_new() push(r, s) push(r, "") return r
    }
    let r = list_new()
    push(r, substr(s, 0, ws))
    push(r, _pm_trim(substr(s, ws + 1, n - ws - 1)))
    return r
}

fn _pm_seen_add(record, seen, label, kind, belief) {
    if len(label) == 0 { return 0 }
    let i = 0
    while i < len(seen) {
        if str_eq_bytes(seen[i], label) == 1 { return 0 }
        i = i + 1
    }
    push(seen, label)
    cur_add_atom(record, label, kind, belief)
    return 1
}

// ---- parser ---------------------------------------------------------------

// One paper record. Returns 0 if the block had no DOI (records without a
// stable identifier are rejected; caller can decide to log).
fn _pm_finalize_paper(kg_name, doi, title, authors, year, keys, cites) {
    if len(doi) == 0 { return 0 }
    let source_tag = "src:paper:doi:" + doi
    let record = cur_new(kg_name, source_tag)
    let seen = list_new()
    let paper_label = "paper_doi_" + nt_safe_label(doi)
    _pm_seen_add(record, seen, paper_label, ATOM_FACT, 900)
    // Title as a keyed fact.
    if len(title) > 0 {
        let title_lab = paper_label + "-title"
        _pm_seen_add(record, seen, title_lab, ATOM_FACT, 900)
        cur_add_imp(record, paper_label, title_lab, "EMPIRICAL")
    }
    // Year.
    if len(year) > 0 {
        let year_lab = "year_" + nt_safe_label(year)
        _pm_seen_add(record, seen, year_lab, ATOM_FACT, 950)
        cur_add_imp(record, paper_label, year_lab, "EMPIRICAL")
    }
    // Authors.
    let ai = 0
    while ai < len(authors) {
        let a_lab = "author_" + nt_safe_label(authors[ai])
        _pm_seen_add(record, seen, a_lab, ATOM_CONCEPT, 900)
        cur_add_imp(record, paper_label, a_lab, "EMPIRICAL")
        ai = ai + 1
    }
    // Abstract keys.
    let ki = 0
    while ki < len(keys) {
        let k_lab = nt_safe_label(keys[ki])
        _pm_seen_add(record, seen, k_lab, ATOM_CONCEPT, 700)
        cur_add_imp(record, paper_label, k_lab, "EMPIRICAL")
        ki = ki + 1
    }
    // Citations.
    let ci = 0
    while ci < len(cites) {
        let c = cites[ci]
        let cited_doi = c[0]
        let rel = c[1]
        if len(cited_doi) > 0 {
            let cited_lab = "paper_doi_" + nt_safe_label(cited_doi)
            _pm_seen_add(record, seen, cited_lab, ATOM_FACT, 700)
            cur_add_cite(record, source_tag, "src:paper:doi:" + cited_doi,
                         _pm_default_rel(rel))
            // Contradicts links get a shadow implication so the
            // /kg_consistency scan can surface papers that disagree.
            if str_eq_bytes(_pm_default_rel(rel), "contradicts") == 1 {
                cur_add_imp(record, paper_label, cited_lab, "EMPIRICAL")
            }
        }
        ci = ci + 1
    }
    return record
}

fn _pm_default_rel(rel) {
    if len(rel) == 0 { return "supports" }
    if str_eq_bytes(rel, "supports")   == 1 { return "supports" }
    if str_eq_bytes(rel, "contradicts") == 1 { return "contradicts" }
    if str_eq_bytes(rel, "extends")     == 1 { return "extends" }
    return "supports"
}

// Parse the whole document.
fn pm_parse_text(text, kg_name) {
    let out_records = list_new()
    let errors = list_new()
    let lines = _pm_lines(text)
    let doi = ""
    let title = ""
    let year = ""
    let authors = list_new()
    let keys = list_new()
    let cites = list_new()
    let in_block = 0
    let i = 0
    while i < len(lines) {
        let raw = lines[i]
        let ln = _pm_trim(raw)
        if len(ln) == 0 {
            if in_block == 1 {
                let rec = _pm_finalize_paper(kg_name, doi, title, authors, year, keys, cites)
                if rec != 0 { push(out_records, rec) }
                else {
                    let e = list_new() push(e, i + 1) push(e, "paper block has no DOI; skipped")
                    push(errors, e)
                }
                doi = "" title = "" year = ""
                authors = list_new() keys = list_new() cites = list_new()
                in_block = 0
            }
        } else {
            if char_at(ln, 0) == 35 {
                // comment
            } else {
                let kv = _pm_kv(ln)
                let key = kv[0]
                let val = kv[1]
                in_block = 1
                if str_eq_bytes(key, "DOI") == 1 { doi = val }
                else { if str_eq_bytes(key, "TITLE") == 1 { title = val }
                else { if str_eq_bytes(key, "YEAR")  == 1 { year = val }
                else { if str_eq_bytes(key, "AUTHOR") == 1 { push(authors, val) }
                else { if str_eq_bytes(key, "ABSTRACT-KEY") == 1 { push(keys, val) }
                else { if str_eq_bytes(key, "CITES") == 1 {
                    let two = _pm_split_two(val)
                    let entry = list_new() push(entry, two[0]) push(entry, two[1])
                    push(cites, entry)
                }
                else {
                    let e = list_new() push(e, i + 1) push(e, "unknown key: " + key)
                    push(errors, e)
                } } } } } }
            }
        }
        i = i + 1
    }
    if in_block == 1 {
        let rec = _pm_finalize_paper(kg_name, doi, title, authors, year, keys, cites)
        if rec != 0 { push(out_records, rec) }
        else {
            let e = list_new() push(e, len(lines)) push(e, "paper block has no DOI; skipped")
            push(errors, e)
        }
    }
    let out = list_new() push(out, out_records) push(out, errors)
    return out
}

fn pm_parse(path, kg_name) {
    let text = read_file(path)
    if text == 0 {
        let recs = list_new()
        let errs = list_new()
        let e = list_new() push(e, 0) push(e, "could not read: " + path)
        push(errs, e)
        let out = list_new() push(out, recs) push(out, errs) return out
    }
    return pm_parse_text(text, kg_name)
}

fn pm_records(result) { return result[0] }
fn pm_errors(result)  { return result[1] }
