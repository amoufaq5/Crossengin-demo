// CrossEngin ingestion: .cerec (CrossEngin Records) importer.
//
// Line-based canonical import format. One or more records per file,
// separated by blank lines (or a new KG directive). Each record is a
// sequence of directives:
//
//   KG      <kg_name>                    (exactly one; opens a record)
//   SRC     <src:tag>                    (exactly one)
//   ATOM    <label> <kind> <belief>      (0+; kind is an integer ATOM_*, belief 0..1000)
//   IMP     <ante> <conseq> <STRENGTH>   (0+; STRENGTH = FORMAL | EMPIRICAL)
//   OBS     <label> <sign> <weight>      (0+; sign = +1 | -1, weight in milli)
//   CITE    <src:from> <src:to> <rel>    (0+; rel = supports | contradicts | extends)
//
// Rules:
//   * Lines starting with '#' are comments; discarded.
//   * Whitespace-only lines close the current record. A new KG directive
//     also closes the previous record and opens a new one.
//   * Labels and src-tags may contain letters, digits, and : _ - / . ~
//     (basically URL-safe + colon). Spaces in labels are NOT supported --
//     use underscore. Enforcement is by field tokenization (space-split).
//   * Kind is an INTEGER matching src/kg/atom_store.nova constants (1=FACT,
//     2=RELATION, 3=CONCEPT, 4=SKILL, 5=LANG, 6=RULE).
//
// Return shape
//   cerec_parse(path) -> [records_list, parse_errors_list]
//     records_list is a list of curriculum records (may be validated
//     empty if parse_errors is non-empty). parse_errors is a list of
//     [line_number, message] pairs for lines that couldn't be handled.
//     The parser is lenient: one bad line does not abort a file; it's
//     logged and skipped.
//
// NOVA dependencies: builtins (read_file, char_at, len, substr).
// CrossEngin dependencies:
//   src/ingest/curriculum.nova, src/util/str_safe.nova.

import "../curriculum.nova"
import "../../util/str_safe.nova"

// ---- helpers --------------------------------------------------------------

// Split a line into whitespace-separated tokens. Handles spaces AND tabs.
// Returns a list of non-empty strings.
fn _cerec_tokens(line) {
    let out = list_new()
    let n = len(line)
    let i = 0
    let start = 0 - 1
    while i < n {
        let c = char_at(line, i)
        let is_ws = 0
        if c == 32 { is_ws = 1 }         // space
        if c == 9  { is_ws = 1 }         // tab
        if is_ws == 1 {
            if start >= 0 {
                push(out, substr(line, start, i - start))
                start = 0 - 1
            }
        } else {
            if start < 0 { start = i }
        }
        i = i + 1
    }
    if start >= 0 { push(out, substr(line, start, n - start)) }
    return out
}

// Parse an unsigned integer from a token; returns -1 on any failure (any
// non-digit character or empty token).
fn _cerec_uint(tok) {
    let n = len(tok)
    if n == 0 { return 0 - 1 }
    let i = 0
    let v = 0
    while i < n {
        let c = char_at(tok, i)
        if c < 48 { return 0 - 1 }
        if c > 57 { return 0 - 1 }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

// Parse a signed integer supporting "+N", "-N", or plain "N". Returns
// -999999 as an out-of-band failure sentinel (real signs are +1 / -1).
fn _cerec_signed(tok) {
    let n = len(tok)
    if n == 0 { return 0 - 999999 }
    let c0 = char_at(tok, 0)
    if c0 == 43 {           // '+'
        let v = _cerec_uint(substr(tok, 1, n - 1))
        if v < 0 { return 0 - 999999 }
        return v
    }
    if c0 == 45 {           // '-'
        let v = _cerec_uint(substr(tok, 1, n - 1))
        if v < 0 { return 0 - 999999 }
        return 0 - v
    }
    return _cerec_uint(tok)
}

// Line iterator: split `text` at '\n' (byte 10). Trailing empty line kept
// so callers can distinguish "final line no newline" from "trailing blank
// line closes final record". Both are treated the same downstream.
fn _cerec_lines(text) {
    let out = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            push(out, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(text, start, n - start))
    return out
}

fn _cerec_is_ws(c) {
    if c == 32 { return 1 }         // space
    if c == 9  { return 1 }         // tab
    if c == 13 { return 1 }         // \r
    return 0
}

// Trim ASCII whitespace from both ends.
fn _cerec_trim(s) {
    let n = len(s)
    let lo = 0
    let more = 1
    while more == 1 {
        if lo >= n { more = 0 }
        else {
            if _cerec_is_ws(char_at(s, lo)) == 0 { more = 0 }
            else { lo = lo + 1 }
        }
    }
    let hi = n
    let more2 = 1
    while more2 == 1 {
        if hi <= lo { more2 = 0 }
        else {
            if _cerec_is_ws(char_at(s, hi - 1)) == 0 { more2 = 0 }
            else { hi = hi - 1 }
        }
    }
    return substr(s, lo, hi - lo)
}

// Is a line effectively empty (whitespace-only or empty)?
fn _cerec_is_blank(line) {
    let n = len(line)
    let i = 0
    while i < n {
        let c = char_at(line, i)
        if c != 32 { if c != 9 { if c != 13 { return 0 } } }
        i = i + 1
    }
    return 1
}

fn _cerec_is_comment(line) {
    let trimmed = _cerec_trim(line)
    if len(trimmed) == 0 { return 0 }
    if char_at(trimmed, 0) == 35 { return 1 }   // '#'
    return 0
}

// ---- parser ---------------------------------------------------------------

fn _cerec_err(errors, line_no, msg) {
    let e = list_new() push(e, line_no) push(e, msg)
    push(errors, e)
}

// Handle one directive line, mutating `current` (or replacing it via the
// KG directive) and appending to `records` when a record closes. Returns
// the new `current` (may be same, may be replaced, may be 0 if just closed).
//
// pending_cap is a 5-element list [name, version, description, license,
// deps_list] used to BUFFER capsule directives that arrive BEFORE the
// KG opener (natural authoring order: metadata header, then content).
// When KG arrives, the buffer is copied onto the fresh record and cleared.
// This lets authors write:
//     CAPSULE medicine
//     VERSION 1.0.0
//     LICENSE CC-BY-4.0
//     KG medicine
//     SRC src:pack:medicine
//     ATOM ...
fn _cerec_apply_directive(records, errors, current, pending_cap, line, line_no) {
    let toks = _cerec_tokens(line)
    if len(toks) == 0 { return current }
    let head = toks[0]
    // KG opens a new record (implicit close of any previous).
    if str_eq_bytes(head, "KG") == 1 {
        if current != 0 { push(records, current) }
        if len(toks) < 2 {
            _cerec_err(errors, line_no, "KG directive needs a kg name")
            return 0
        }
        let rec = cur_new(toks[1], "src:cerec:unknown")
        // Apply any buffered capsule directives to the fresh record.
        if len(pending_cap[0]) > 0 {
            cur_set_capsule(rec, pending_cap[0], pending_cap[1],
                            pending_cap[2], pending_cap[3])
            let dd = pending_cap[4]
            let di = 0
            while di < len(dd) {
                cur_add_capsule_dep(rec, dd[di][0], dd[di][1])
                di = di + 1
            }
        }
        // Clear pending_cap so the next record starts fresh.
        list_set(pending_cap, 0, "")
        list_set(pending_cap, 1, "")
        list_set(pending_cap, 2, "")
        list_set(pending_cap, 3, "")
        list_set(pending_cap, 4, list_new())
        return rec
    }
    // Capsule directives always land in the pending buffer, regardless of
    // whether a KG record is currently open. Mid-record CAPSULE means
    // "the NEXT KG record is a capsule"; the current record keeps whatever
    // capsule metadata (if any) it was created with.
    if str_eq_bytes(head, "CAPSULE") == 1 {
        if len(toks) < 2 { _cerec_err(errors, line_no, "CAPSULE needs a name") return current }
        list_set(pending_cap, 0, toks[1])
        return current
    }
    if str_eq_bytes(head, "VERSION") == 1 {
        if len(toks) < 2 { _cerec_err(errors, line_no, "VERSION needs a semver value") return current }
        list_set(pending_cap, 1, toks[1])
        return current
    }
    if str_eq_bytes(head, "DESCRIPTION") == 1 {
        list_set(pending_cap, 2, _cerec_rest_after_first_token(line))
        return current
    }
    if str_eq_bytes(head, "LICENSE") == 1 {
        if len(toks) < 2 { _cerec_err(errors, line_no, "LICENSE needs an identifier") return current }
        list_set(pending_cap, 3, toks[1])
        return current
    }
    if str_eq_bytes(head, "DEPS") == 1 {
        if len(toks) < 2 { _cerec_err(errors, line_no, "DEPS needs a name:version list") return current }
        let tail = _cerec_rest_after_first_token(line)
        let entries = _cerec_split_commas(tail)
        let i = 0
        while i < len(entries) {
            let e = _cerec_trim_wrap(entries[i])
            if len(e) > 0 {
                let colon = _cerec_find_char(e, 58)
                if colon > 0 {
                    let n = substr(e, 0, colon)
                    let v = substr(e, colon + 1, len(e) - colon - 1)
                    let d = list_new()
                    push(d, _cerec_trim_wrap(n))
                    push(d, _cerec_trim_wrap(v))
                    push(pending_cap[4], d)
                } else {
                    _cerec_err(errors, line_no, "DEPS entry needs name:version, got: " + e)
                }
            }
            i = i + 1
        }
        return current
    }
    if current == 0 {
        _cerec_err(errors, line_no, "directive before any KG opener")
        return 0
    }
    if str_eq_bytes(head, "SRC") == 1 {
        if len(toks) < 2 { _cerec_err(errors, line_no, "SRC needs a tag") return current }
        list_set(current, CUR_SOURCE, toks[1])
        return current
    }
    if str_eq_bytes(head, "ATOM") == 1 {
        if len(toks) < 4 { _cerec_err(errors, line_no, "ATOM needs label kind belief") return current }
        let kind = _cerec_uint(toks[2])
        let bel  = _cerec_uint(toks[3])
        if kind < 0 { _cerec_err(errors, line_no, "ATOM kind not an unsigned int") return current }
        if bel  < 0 { _cerec_err(errors, line_no, "ATOM belief not an unsigned int") return current }
        cur_add_atom(current, toks[1], kind, bel)
        return current
    }
    if str_eq_bytes(head, "IMP") == 1 {
        if len(toks) < 4 { _cerec_err(errors, line_no, "IMP needs ante conseq strength") return current }
        let str_ok = 0
        if str_eq_bytes(toks[3], "FORMAL")    == 1 { str_ok = 1 }
        if str_eq_bytes(toks[3], "EMPIRICAL") == 1 { str_ok = 1 }
        if str_ok == 0 {
            _cerec_err(errors, line_no, "IMP strength must be FORMAL or EMPIRICAL")
            return current
        }
        cur_add_imp(current, toks[1], toks[2], toks[3])
        return current
    }
    if str_eq_bytes(head, "OBS") == 1 {
        if len(toks) < 4 { _cerec_err(errors, line_no, "OBS needs label sign weight") return current }
        let sign = _cerec_signed(toks[2])
        if sign != 1 { if sign != (0 - 1) {
            _cerec_err(errors, line_no, "OBS sign must be +1 or -1")
            return current
        } }
        let w = _cerec_uint(toks[3])
        if w < 0 { _cerec_err(errors, line_no, "OBS weight not an unsigned int") return current }
        cur_add_obs(current, toks[1], sign, w)
        return current
    }
    if str_eq_bytes(head, "CITE") == 1 {
        if len(toks) < 4 { _cerec_err(errors, line_no, "CITE needs from to relation") return current }
        cur_add_cite(current, toks[1], toks[2], toks[3])
        return current
    }
    // (CAPSULE / VERSION / DESCRIPTION / LICENSE / DEPS handled above,
    // always land in the pending buffer regardless of `current` state.)
    _cerec_err(errors, line_no, "unknown directive")
    return current
}

// Ensure the record's capsule metadata slot is populated (with an empty
// name if none was set yet). Kept for legacy callers; new parser routes
// capsule directives through the pending buffer.
fn _cerec_ensure_capsule_meta(current) {
    if cur_has_capsule(current) == 1 { return 0 }
    cur_set_capsule(current, "_pending_", "", "", "")
    // Clear the placeholder name back to empty until CAPSULE arrives -- but
    // keep the slot list populated so VERSION etc. can write into it.
    list_set(cur_capsule_meta(current), CUR_CAP_NAME, "")
    return 1
}

// Return everything after the first whitespace-separated token on `line`.
// Trimmed of leading/trailing whitespace.
fn _cerec_rest_after_first_token(line) {
    let n = len(line)
    let i = 0
    // skip leading whitespace
    let more = 1
    while more == 1 {
        if i >= n { more = 0 }
        else { if _cerec_is_ws(char_at(line, i)) == 1 { i = i + 1 } else { more = 0 } }
    }
    // skip the token
    let more2 = 1
    while more2 == 1 {
        if i >= n { more2 = 0 }
        else { if _cerec_is_ws(char_at(line, i)) == 1 { more2 = 0 } else { i = i + 1 } }
    }
    // skip whitespace after
    let more3 = 1
    while more3 == 1 {
        if i >= n { more3 = 0 }
        else { if _cerec_is_ws(char_at(line, i)) == 1 { i = i + 1 } else { more3 = 0 } }
    }
    if i >= n { return "" }
    let sub = substr(line, i, n - i)
    return _cerec_trim(sub)
}

// Split a string on commas. Returns a list of pieces (may include empties).
fn _cerec_split_commas(s) {
    let out = list_new()
    let n = len(s)
    let start = 0
    let i = 0
    while i < n {
        if char_at(s, i) == 44 {                    // ','
            push(out, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(s, start, n - start))
    return out
}

// Find first index of char `c` in `s`; -1 if absent. (Local to avoid
// pulling in find_char's byte-safety wrapping when we only need one call.)
fn _cerec_find_char(s, c) {
    let n = len(s)
    let i = 0
    while i < n {
        if char_at(s, i) == c { return i }
        i = i + 1
    }
    return 0 - 1
}

fn _cerec_trim_wrap(s) { return _cerec_trim(s) }

// Parse `text` as a .cerec document. Returns [records, errors].
fn cerec_parse_text(text) {
    let records = list_new()
    let errors  = list_new()
    let lines = _cerec_lines(text)
    let current = 0
    // Buffer for capsule directives arriving before a KG opener.
    // Slots: [name, version, description, license, deps_list].
    let pending_cap = list_new()
    push(pending_cap, "") push(pending_cap, "") push(pending_cap, "")
    push(pending_cap, "") push(pending_cap, list_new())
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        let line_no = i + 1
        // Blank lines and comment lines are ignored (they are whitespace
        // within a record). Records are separated by new KG directives
        // or by end-of-file -- authoring a multi-section pack with blank
        // separators between conceptual groups is expected.
        if _cerec_is_comment(line) == 1 {
            // discard
        } else {
            if _cerec_is_blank(line) == 1 {
                // discard -- record continues
            } else {
                current = _cerec_apply_directive(records, errors, current,
                                                 pending_cap, line, line_no)
            }
        }
        i = i + 1
    }
    if current != 0 { push(records, current) }
    let out = list_new() push(out, records) push(out, errors)
    return out
}

// Parse a file at `path`. Returns [records, errors] as above. If the file
// cannot be read, records is empty and errors contains one entry.
fn cerec_parse(path) {
    let text = read_file(path)
    if text == 0 {
        let records = list_new()
        let errors = list_new()
        let e = list_new() push(e, 0) push(e, "could not read file: " + path)
        push(errors, e)
        let out = list_new() push(out, records) push(out, errors)
        return out
    }
    return cerec_parse_text(text)
}

fn cerec_records(result) { return result[0] }
fn cerec_errors(result)  { return result[1] }
