// CrossEngin ingestion: JSON structured-record importer (R65 shape,
// R69 refactored onto src/data/json.nova).
//
// Turns a JSON array of record objects into curriculum records that
// slot into the same pipeline / review-queue / policy engine every
// other importer already feeds. This lets an operator ingest a
// one-off JSON dataset (a scraper output, an internal admin dump,
// an LLM-emitted JSON structure) without hand-authoring .cerec
// syntax or writing a format-specific importer.
//
// R69 refactor: the R65 recursive-descent parser (~350 lines of
// jsonr_parse_value + _jr_* helpers) was deleted in favor of the
// pre-existing tagged JV_* parser at src/data/json.nova. Two wins:
//
//   * one JSON parser in the codebase (was two; the R66 silent-crash
//     bug was a symptom of the duplication)
//   * data/json.nova accepts floats/exponents where R65 explicitly
//     rejected them at the parser layer. R69 moves float rejection to
//     the schema layer -- a float that lands in an int-typed slot
//     (belief / weight / sign) records a per-record error and skips
//     that field, matching the "lenient parser" contract every other
//     importer already provides.
//
// Wire format (top-level MUST be a JSON array of record objects):
//
//   [
//     {
//       "kg":     "solar_system",           (string; target KG name)
//       "source": "src:json:sample:v1",     (string; src:... tag)
//       "capsule": {                        (optional; capsule metadata
//                                            per ADR-0106)
//         "name":        "solar_system_json",
//         "version":     "1.0.0",
//         "description": "sample pack",
//         "license":     "CC-BY-4.0",
//         "deps": [{"name":"physics","version":"1.0.0"}]
//       },
//       "atoms": [
//         {"label":"mercury", "kind":"fact",    "belief":900},
//         {"label":"hot",     "kind":"concept", "belief":800}
//       ],
//       "implications": [
//         {"ante":"mercury","conseq":"hot","strength":"EMPIRICAL"}
//       ],
//       "observations": [
//         {"label":"mercury","sign":1,"weight":500}
//       ],
//       "citations": [
//         {"from":"src:json:sample:v1","to":"src:paper:doi:X","rel":"supports"}
//       ]
//     },
//     { ... second record ... }
//   ]
//
// `kind` accepts the string names from atom_kind_name ("fact",
// "relation", "concept", "skill", "lang", "rule") OR the raw
// integer constant. `strength` accepts "FORMAL" | "EMPIRICAL".
// `sign` is +1 or -1 (integer). Every field except `kg` and
// `source` is optional -- a record with only `atoms` is fine.
//
// Return shape (matches every other importer):
//   json_records_parse(path, kg_hint, source_tag)
//     -> [records_list, errors_list]
//
// `kg_hint` and `source_tag` are DEFAULTS for records that omit
// the corresponding top-level field. If a record has both defaults
// AND its own value, the record's value wins. When BOTH are missing
// (record has no `kg` + no `kg_hint` supplied), the record is
// dropped with a parse error.
//
// Lenient parser: a single malformed record is logged as an error
// (with the array index in the "line" slot -- JSON isn't line-
// oriented so index is what's meaningful) and skipped; other
// records still land.
//
// NOVA dependencies: builtins (read_file, char_at, len, substr).
// CrossEngin dependencies:
//   src/ingest/curriculum.nova
//   src/kg/atom_store.nova (ATOM_* constants)
//   src/data/json.nova (json_parse + JV_* accessors)
//   src/util/str_safe.nova.

import "../curriculum.nova"
import "../../kg/atom_store.nova"
import "../../data/json.nova"
import "../../util/str_safe.nova"

// ---- helpers -----------------------------------------------------------

fn _jr_err_rec(errors, idx, msg) {
    let e = list_new()
    push(e, idx)           // array-index in the input (not a line no)
    push(e, msg)
    push(errors, e)
}

// Extract an int-typed field from a JV value. Returns [ok, value]:
// ok = 1 when the value is a JV_NUM whose raw token has no '.', 'e',
// or 'E' (a strict integer). Floats and other types yield ok = 0.
// This lets the schema layer reject a float slid into a belief /
// weight / sign slot with a clean per-record error rather than
// silently truncating.
fn _jr_int_field(v) {
    let out = list_new()
    if json_type(v) != JV_NUM {
        push(out, 0) push(out, 0) return out
    }
    // v is [JV_NUM, intval, raw]. Reject if raw contains float chars.
    let raw = v[2]
    let n = len(raw)
    let i = 0
    while i < n {
        let c = char_at(raw, i)
        if c == 46  { push(out, 0) push(out, 0) return out }   // '.'
        if c == 101 { push(out, 0) push(out, 0) return out }   // 'e'
        if c == 69  { push(out, 0) push(out, 0) return out }   // 'E'
        i = i + 1
    }
    push(out, 1)
    push(out, json_num(v))
    return out
}

// Get a string field (empty string if absent or wrong type).
fn _jr_str_field(obj, key) {
    if json_has(obj, key) == 0 { return "" }
    let v = json_get(obj, key)
    if json_type(v) != JV_STR { return "" }
    return json_str(v)
}

// Map a kind spec (JV_STR name or JV_NUM constant) to the atom_store
// constant. Returns -1 on unknown / wrong-type.
fn _jr_resolve_kind(v) {
    if json_type(v) == JV_NUM {
        let n = json_num(v)
        if atom_kind_valid(n) == 1 { return n }
        return 0 - 1
    }
    if json_type(v) != JV_STR { return 0 - 1 }
    let s = json_str(v)
    if str_eq_bytes(s, "fact")     == 1 { return ATOM_FACT }
    if str_eq_bytes(s, "relation") == 1 { return ATOM_RELATION }
    if str_eq_bytes(s, "concept")  == 1 { return ATOM_CONCEPT }
    if str_eq_bytes(s, "skill")    == 1 { return ATOM_SKILL }
    if str_eq_bytes(s, "lang")     == 1 { return ATOM_LANG }
    if str_eq_bytes(s, "rule")     == 1 { return ATOM_RULE }
    return 0 - 1
}

// ---- schema layer ------------------------------------------------------

fn jsonr_parse_text(text, kg_hint, source_tag) {
    let records = list_new()
    let errors  = list_new()
    let top = json_parse(text)
    if json_is_valid(top) == 0 {
        _jr_err_rec(errors, 0, "json: malformed JSON at top level")
        let out = list_new() push(out, records) push(out, errors) return out
    }
    if json_type(top) != JV_ARR {
        _jr_err_rec(errors, 0,
            "json: top level must be a JSON array of record objects")
        let out = list_new() push(out, records) push(out, errors) return out
    }
    let n_records = json_arr_len(top)
    let idx = 0
    while idx < n_records {
        let obj = json_arr_get(top, idx)
        if json_type(obj) != JV_OBJ {
            _jr_err_rec(errors, idx, "record at index "
                + int_to_str(idx) + " must be an object")
            idx = idx + 1
            continue
        }
        // kg
        let kg_name = kg_hint
        if json_has(obj, "kg") == 1 {
            let kv_v = json_get(obj, "kg")
            if json_type(kv_v) == JV_STR { kg_name = json_str(kv_v) }
        }
        if len(kg_name) == 0 {
            _jr_err_rec(errors, idx,
                "record missing 'kg' and no kg_hint supplied")
            idx = idx + 1
            continue
        }
        // source
        let src = source_tag
        if json_has(obj, "source") == 1 {
            let sv = json_get(obj, "source")
            if json_type(sv) == JV_STR { src = json_str(sv) }
        }
        if len(src) == 0 {
            _jr_err_rec(errors, idx,
                "record missing 'source' and no source_tag supplied")
            idx = idx + 1
            continue
        }
        let rec = cur_new(kg_name, src)
        // capsule (optional)
        if json_has(obj, "capsule") == 1 {
            let cap = json_get(obj, "capsule")
            if json_type(cap) == JV_OBJ {
                let cn = _jr_str_field(cap, "name")
                let cv = _jr_str_field(cap, "version")
                let cd = _jr_str_field(cap, "description")
                let cl = _jr_str_field(cap, "license")
                if len(cn) > 0 {
                    cur_set_capsule(rec, cn, cv, cd, cl)
                    if json_has(cap, "deps") == 1 {
                        let deps = json_get(cap, "deps")
                        if json_type(deps) == JV_ARR {
                            let dn_count = json_arr_len(deps)
                            let di = 0
                            while di < dn_count {
                                let d = json_arr_get(deps, di)
                                if json_type(d) == JV_OBJ {
                                    let dn = _jr_str_field(d, "name")
                                    let dv = _jr_str_field(d, "version")
                                    if len(dn) > 0 {
                                        cur_add_capsule_dep(rec, dn, dv)
                                    }
                                }
                                di = di + 1
                            }
                        }
                    }
                }
            }
        }
        // atoms
        if json_has(obj, "atoms") == 1 {
            let atoms = json_get(obj, "atoms")
            if json_type(atoms) == JV_ARR {
                let a_count = json_arr_len(atoms)
                let ai = 0
                while ai < a_count {
                    let a = json_arr_get(atoms, ai)
                    if json_type(a) != JV_OBJ {
                        _jr_err_rec(errors, idx,
                            "atom at atoms[" + int_to_str(ai) + "] must be an object")
                    } else {
                        let lab = _jr_str_field(a, "label")
                        if len(lab) == 0 {
                            _jr_err_rec(errors, idx,
                                "atom missing 'label' at atoms[" + int_to_str(ai) + "]")
                        } else {
                            let k = 0 - 1
                            if json_has(a, "kind") == 1 {
                                k = _jr_resolve_kind(json_get(a, "kind"))
                            }
                            if k < 0 {
                                _jr_err_rec(errors, idx,
                                    "atom has unknown 'kind' at atoms[" + int_to_str(ai) + "]")
                            } else {
                                // belief must be a strict int (no floats).
                                let bel = 0
                                let bad = 0
                                if json_has(a, "belief") == 1 {
                                    let bpair = _jr_int_field(json_get(a, "belief"))
                                    if bpair[0] == 0 {
                                        _jr_err_rec(errors, idx,
                                            "atom 'belief' must be an integer at atoms["
                                            + int_to_str(ai) + "]")
                                        bad = 1
                                    } else {
                                        bel = bpair[1]
                                    }
                                }
                                if bad == 0 { cur_add_atom(rec, lab, k, bel) }
                            }
                        }
                    }
                    ai = ai + 1
                }
            }
        }
        // implications
        if json_has(obj, "implications") == 1 {
            let imps = json_get(obj, "implications")
            if json_type(imps) == JV_ARR {
                let i_count = json_arr_len(imps)
                let ii = 0
                while ii < i_count {
                    let m = json_arr_get(imps, ii)
                    if json_type(m) == JV_OBJ {
                        let a1 = _jr_str_field(m, "ante")
                        let a2 = _jr_str_field(m, "conseq")
                        let st = _jr_str_field(m, "strength")
                        if len(a1) == 0 { _jr_err_rec(errors, idx,
                            "implication missing 'ante' at implications[" + int_to_str(ii) + "]") }
                        else { if len(a2) == 0 { _jr_err_rec(errors, idx,
                            "implication missing 'conseq' at implications[" + int_to_str(ii) + "]") }
                        else {
                            let ok = 0
                            if str_eq_bytes(st, "FORMAL")    == 1 { ok = 1 }
                            if str_eq_bytes(st, "EMPIRICAL") == 1 { ok = 1 }
                            if ok == 0 {
                                _jr_err_rec(errors, idx,
                                    "implication 'strength' must be FORMAL or EMPIRICAL at implications["
                                    + int_to_str(ii) + "]")
                            } else {
                                cur_add_imp(rec, a1, a2, st)
                            }
                        } }
                    }
                    ii = ii + 1
                }
            }
        }
        // observations
        if json_has(obj, "observations") == 1 {
            let obs = json_get(obj, "observations")
            if json_type(obs) == JV_ARR {
                let o_count = json_arr_len(obs)
                let oi = 0
                while oi < o_count {
                    let o = json_arr_get(obs, oi)
                    if json_type(o) == JV_OBJ {
                        let ol = _jr_str_field(o, "label")
                        if len(ol) == 0 {
                            _jr_err_rec(errors, idx,
                                "observation missing 'label' at observations["
                                + int_to_str(oi) + "]")
                        } else {
                            let os = 0
                            let ok = 0
                            if json_has(o, "sign") == 1 {
                                let sp = _jr_int_field(json_get(o, "sign"))
                                if sp[0] == 1 {
                                    if sp[1] == 1        { os = 1  ok = 1 }
                                    if sp[1] == (0 - 1)  { os = 0 - 1 ok = 1 }
                                }
                            }
                            if ok == 0 {
                                _jr_err_rec(errors, idx,
                                    "observation 'sign' must be +1 or -1 at observations["
                                    + int_to_str(oi) + "]")
                            } else {
                                let ow = 0
                                let wbad = 0
                                if json_has(o, "weight") == 1 {
                                    let wp = _jr_int_field(json_get(o, "weight"))
                                    if wp[0] == 0 {
                                        _jr_err_rec(errors, idx,
                                            "observation 'weight' must be an integer at observations["
                                            + int_to_str(oi) + "]")
                                        wbad = 1
                                    } else { ow = wp[1] }
                                }
                                if wbad == 0 { cur_add_obs(rec, ol, os, ow) }
                            }
                        }
                    }
                    oi = oi + 1
                }
            }
        }
        // citations
        if json_has(obj, "citations") == 1 {
            let cites = json_get(obj, "citations")
            if json_type(cites) == JV_ARR {
                let c_count = json_arr_len(cites)
                let ci = 0
                while ci < c_count {
                    let c = json_arr_get(cites, ci)
                    if json_type(c) == JV_OBJ {
                        let f  = _jr_str_field(c, "from")
                        let t  = _jr_str_field(c, "to")
                        let rl = _jr_str_field(c, "rel")
                        if len(f) == 0 { _jr_err_rec(errors, idx,
                            "citation missing 'from' at citations[" + int_to_str(ci) + "]") }
                        else { if len(t) == 0 { _jr_err_rec(errors, idx,
                            "citation missing 'to' at citations[" + int_to_str(ci) + "]") }
                        else { if len(rl) == 0 { _jr_err_rec(errors, idx,
                            "citation missing 'rel' at citations[" + int_to_str(ci) + "]") }
                        else { cur_add_cite(rec, f, t, rl) } } }
                    }
                    ci = ci + 1
                }
            }
        }
        push(records, rec)
        idx = idx + 1
    }
    let out = list_new()
    push(out, records)
    push(out, errors)
    return out
}

// File entry point. Signature matches every other importer.
fn jsonr_parse(path, kg_hint, source_tag) {
    let text = read_file(path)
    if text == 0 {
        let records = list_new()
        let errors  = list_new()
        let e = list_new() push(e, 0) push(e, "could not read file: " + path)
        push(errors, e)
        let out = list_new() push(out, records) push(out, errors) return out
    }
    return jsonr_parse_text(text, kg_hint, source_tag)
}

fn jsonr_records(result) { return result[0] }
fn jsonr_errors(result)  { return result[1] }
