// CrossEngin ingestion: Wikidata-flavored N-Triples importer.
//
// Wikidata's RDF dumps are N-Triples where subjects are Qxxxxx entity URIs
// and predicates are Pxxx property URIs. Bare Qxxx/Pxxx identifiers make
// terrible atom labels for humans -- so this importer accepts an optional
// labels lookup (Q1 -> "universe", P31 -> "instance-of") and swaps in the
// label whenever possible.
//
// Predicate-to-strength mapping
//   The core Wikidata "structural" predicates get FORMAL strength -- they
//   are the ontological backbone (an instance-of edge is not up for
//   Bayesian debate; if it turns out wrong the fix is to retract the
//   triple, not to gradient-descend it). Everything else stays EMPIRICAL.
//   The FORMAL set is conservative on purpose; new predicates can be
//   added by callers via wd_promote_predicate.
//
//   FORMAL by default:
//     P31  instance-of
//     P279 subclass-of
//     P361 part-of
//     P527 has-part
//     P171 parent-taxon
//     P105 taxon-rank
//     P17  country-of-origin
//
// Labels file format
//   Two-column TSV: "<Qxxxx>\t<label>\n". Empty lines and lines starting
//   with '#' are ignored. Missing labels fall back to the bare identifier.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/ingest/curriculum.nova, src/ingest/importers/nt_triples.nova,
//   src/util/str_safe.nova, src/kg/atom_store.nova.

import "../curriculum.nova"
import "./nt_triples.nova"
import "../../util/str_safe.nova"
import "../../kg/atom_store.nova"

// ---- labels table ---------------------------------------------------------
// Table = list of [id, label] pairs. Look-up is linear (O(n)); a
// production-scale dump would want a hash-index (deferred to the storage
// layer's Q-index work; this is the shape the importer would call into).

fn wd_labels_new() { return list_new() }

fn wd_labels_add(table, id, label) {
    let e = list_new() push(e, id) push(e, label)
    push(table, e)
    return e
}

fn wd_labels_lookup(table, id) {
    let i = 0
    while i < len(table) {
        if str_eq_bytes(table[i][0], id) == 1 { return table[i][1] }
        i = i + 1
    }
    return ""
}

// Parse a TSV labels text: "Q1<TAB>universe\nQ2<TAB>life\n#comment\n".
fn wd_labels_parse_text(text) {
    let table = wd_labels_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            let line = substr(text, start, i - start)
            wd_labels_add_line(table, line)
            start = i + 1
        }
        i = i + 1
    }
    if start < n { wd_labels_add_line(table, substr(text, start, n - start)) }
    return table
}

fn wd_labels_add_line(table, line) {
    let n = len(line)
    if n == 0 { return 0 }
    if char_at(line, 0) == 35 { return 0 }
    // Find first tab.
    let i = 0
    let tab = 0 - 1
    while i < n {
        if char_at(line, i) == 9 { tab = i i = n + 1 }
        else { i = i + 1 }
    }
    if tab < 1 { return 0 }
    let id = substr(line, 0, tab)
    let lab = substr(line, tab + 1, n - tab - 1)
    if len(id) == 0 { return 0 }
    if len(lab) == 0 { return 0 }
    wd_labels_add(table, id, lab)
    return 1
}

fn wd_labels_parse_file(path) {
    let text = read_file(path)
    if text == 0 { return wd_labels_new() }
    return wd_labels_parse_text(text)
}

// ---- FORMAL predicate set ------------------------------------------------

fn wd_default_formal_preds() {
    let s = list_new()
    push(s, "P31")   push(s, "P279")  push(s, "P361")  push(s, "P527")
    push(s, "P171")  push(s, "P105")  push(s, "P17")
    return s
}

fn wd_promote_predicate(set, pred_id) {
    let i = 0
    while i < len(set) {
        if str_eq_bytes(set[i], pred_id) == 1 { return 0 }
        i = i + 1
    }
    push(set, pred_id)
    return 1
}

fn wd_is_formal_pred(set, pred_id) {
    let i = 0
    while i < len(set) {
        if str_eq_bytes(set[i], pred_id) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- utility: resolve a Wikidata id to a display label -------------------

fn wd_display(labels, id) {
    if len(id) == 0 { return id }
    let l = wd_labels_lookup(labels, id)
    if len(l) > 0 { return nt_safe_label(l) }
    return nt_safe_label(id)
}

// ---- parser ---------------------------------------------------------------

// Parse an N-Triples text as Wikidata. `labels` is the (possibly empty)
// labels table; `formal_preds` is the FORMAL-strength predicate set.
// source_tag defaults to "src:wikidata:" concatenated with a run-id
// suffix supplied by the caller.
fn wd_parse_text(text, kg_name, source_tag, labels, formal_preds) {
    let out_records = list_new()
    let errors = list_new()
    let record = cur_new(kg_name, source_tag)
    let seen = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            let line = substr(text, start, i - start)
            _wd_apply_line(record, seen, labels, formal_preds, line)
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        _wd_apply_line(record, seen, labels, formal_preds, substr(text, start, n - start))
    }
    push(out_records, record)
    let out = list_new() push(out, out_records) push(out, errors)
    return out
}

fn _wd_apply_line(record, seen, labels, formal_preds, line) {
    let t = nt_parse_line(line)
    if t == 0 { return 0 }
    let s_id = nt_uri_local(t[0])
    let p_id = nt_uri_local(t[1])
    if len(s_id) == 0 { return 0 }
    if len(p_id) == 0 { return 0 }
    let s_lab = wd_display(labels, s_id)
    _wd_seen_add(record, seen, s_lab, ATOM_CONCEPT, 800)
    let strength = "EMPIRICAL"
    if wd_is_formal_pred(formal_preds, p_id) == 1 { strength = "FORMAL" }
    if t[2] == NT_TOK_URI {
        let o_id = nt_uri_local(t[3])
        if len(o_id) == 0 { return 0 }
        let o_lab = wd_display(labels, o_id)
        _wd_seen_add(record, seen, o_lab, ATOM_CONCEPT, 800)
        cur_add_imp(record, s_lab, o_lab, strength)
    } else {
        if t[2] == NT_TOK_LITERAL {
            let fact_lab = s_lab + "-" + nt_safe_label(p_id)
            _wd_seen_add(record, seen, fact_lab, ATOM_FACT, 800)
            cur_add_imp(record, s_lab, fact_lab, "EMPIRICAL")
        }
    }
    return 1
}

fn _wd_seen_add(record, seen, label, kind, belief) {
    if len(label) == 0 { return 0 }
    let i = 0
    while i < len(seen) {
        if str_eq_bytes(seen[i], label) == 1 { return 0 }
        i = i + 1
    }
    push(seen, label)
    cur_add_atom(record, label, kind, belief)
    return 1
}

// File-based entry with defaults for labels/formal_preds.
fn wd_parse(path, kg_name, source_tag, labels_path) {
    let text = read_file(path)
    if text == 0 {
        let recs = list_new()
        let errs = list_new()
        let e = list_new() push(e, 0) push(e, "could not read: " + path)
        push(errs, e)
        let out = list_new() push(out, recs) push(out, errs) return out
    }
    let labels = wd_labels_new()
    if len(labels_path) > 0 { labels = wd_labels_parse_file(labels_path) }
    let formal_preds = wd_default_formal_preds()
    return wd_parse_text(text, kg_name, source_tag, labels, formal_preds)
}

fn wd_records(result) { return result[0] }
fn wd_errors(result)  { return result[1] }
