// CrossEngin ingestion: video importer (R105 -- Phase G).
//
// Recognizes Y4M (YUV4MPEG2) headers, the canonical uncompressed
// video container used by every YUV-domain transducer in
// src/io/transducers/*. Produces one perceptual curriculum record
// per input carrying the shared perceptual-atom shape from
// src/ingest/perceptual_capsule.nova:
//
//   root atom: perc:video:<hash16>            (kind=FACT, seed=900)
//   meta atoms:
//     perc:video:<hash16>:format=y4m
//     perc:video:<hash16>:width=<pixels>
//     perc:video:<hash16>:height=<pixels>
//     perc:video:<hash16>:fps_num=<n>
//     perc:video:<hash16>:fps_den=<d>
//     perc:video:<hash16>:bytes=<len>
//     perc:video:<hash16>:sha256=<hash64>
//
// R105 keeps the video importer header-only: it validates the
// "YUV4MPEG2 " magic and extracts width / height / fps from the
// header line without walking the frame payload. Per-keyframe atom
// decomposition (as ADR-0202 flags in the "IMAGE + AUDIO composition"
// note) is deferred; when it lands, video_records will fan out into
// image_records for each sampled frame and audio_records for the
// audio track (Y4M itself has no audio track; the sibling stream is
// handled at the container level).
//
// Public API
//   vidr_parse_bytes(byte_list, kg_hint, source_tag) -> [records, errors]
//   vidr_parse_text (body_str,  kg_hint, source_tag) -> [records, errors]
//
// Refusals (produce zero records, one error each):
//   * empty input
//   * first 9 bytes != "YUV4MPEG2"
//   * width / height missing from header
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/ingest/curriculum.nova
//   src/ingest/perceptual_capsule.nova
//   src/util/str_safe.nova

import "../curriculum.nova"
import "../perceptual_capsule.nova"
import "../../util/str_safe.nova"

// ---- header constants ------------------------------------------------------

let _VIDR_MAGIC_LEN = 9

fn _vidr_is_y4m_magic(bl, n) {
    if n < _VIDR_MAGIC_LEN { return 0 }
    // "YUV4MPEG2" = 89 85 86 52 77 80 69 71 50
    if bl[0] != 89 { return 0 }
    if bl[1] != 85 { return 0 }
    if bl[2] != 86 { return 0 }
    if bl[3] != 52 { return 0 }
    if bl[4] != 77 { return 0 }
    if bl[5] != 80 { return 0 }
    if bl[6] != 69 { return 0 }
    if bl[7] != 71 { return 0 }
    if bl[8] != 50 { return 0 }
    return 1
}

// ---- header parser (byte-list, mirrors _y4m_parse_header) ------------------
//
// Y4M header line format:
//   "YUV4MPEG2 W<width> H<height> F<num>:<den> I<interlace>...\n"
// Space-separated tag+value tokens; only 'W', 'H', 'F' matter for
// the perceptual atom. Header terminates at ASCII newline (0x0A).

fn _vidr_is_space(c) {
    if c == 32 { return 1 }
    if c == 9  { return 1 }
    return 0
}

fn _vidr_parse_dec(bl, n, off) {
    let out = list_new()
    let val = 0
    let saw = 0
    let i = off
    let done = 0
    while done == 0 {
        if i >= n { done = 1 } else {
            let c = bl[i]
            if c < 48        { done = 1 }
            else { if c > 57 { done = 1 }
            else {
                val = val * 10 + (c - 48)
                saw = 1
                i = i + 1
            } }
        }
    }
    if saw == 0 { push(out, -1)  push(out, off)  return out }
    push(out, val)  push(out, i)  return out
}

// Advance past an unknown-tag payload up to the next space, tab, or
// newline. Returns the new offset.
fn _vidr_skip_field(bl, n, off) {
    let i = off
    while i < n {
        let c = bl[i]
        if _vidr_is_space(c) == 1 { return i }
        if c == 10 { return i }
        i = i + 1
    }
    return i
}

// Slot layout for _vidr_parse_header result.
let _VIDR_H_W       = 0
let _VIDR_H_H       = 1
let _VIDR_H_FN      = 2
let _VIDR_H_FD      = 3
let _VIDR_H_ERR     = 4

fn _vidr_parse_header(bl, n) {
    let out = list_new()
    push(out, 0) push(out, 0) push(out, 0) push(out, 0) push(out, "")
    if _vidr_is_y4m_magic(bl, n) == 0 {
        list_set(out, _VIDR_H_ERR, "video: not a YUV4MPEG2 stream")
        return out
    }
    let off = _VIDR_MAGIC_LEN
    let saw_end = 0
    let stop = 0
    while stop == 0 {
        if off >= n { stop = 1 } else {
            let c = bl[off]
            if c == 10 {
                saw_end = 1
                stop = 1
            } else { if _vidr_is_space(c) == 1 {
                off = off + 1
            } else {
                let tag = c
                off = off + 1
                if tag == 87 {          // 'W' width
                    let r = _vidr_parse_dec(bl, n, off)
                    if r[0] < 0 { list_set(out, _VIDR_H_ERR, "video: Y4M bad W")  return out }
                    list_set(out, _VIDR_H_W, r[0])
                    off = r[1]
                } else { if tag == 72 { // 'H' height
                    let r = _vidr_parse_dec(bl, n, off)
                    if r[0] < 0 { list_set(out, _VIDR_H_ERR, "video: Y4M bad H")  return out }
                    list_set(out, _VIDR_H_H, r[0])
                    off = r[1]
                } else { if tag == 70 { // 'F' fps num:den
                    let rn = _vidr_parse_dec(bl, n, off)
                    if rn[0] < 0 { list_set(out, _VIDR_H_ERR, "video: Y4M bad F numerator")  return out }
                    list_set(out, _VIDR_H_FN, rn[0])
                    off = rn[1]
                    if off < n {
                        if bl[off] == 58 {        // ':'
                            off = off + 1
                            let rd = _vidr_parse_dec(bl, n, off)
                            if rd[0] < 0 { list_set(out, _VIDR_H_ERR, "video: Y4M bad F denominator")  return out }
                            list_set(out, _VIDR_H_FD, rd[0])
                            off = rd[1]
                        }
                    }
                } else {
                    // Skip unknown tag payload until next space / newline.
                    off = _vidr_skip_field(bl, n, off)
                } } }
            } }
        }
    }
    if saw_end == 0 {
        list_set(out, _VIDR_H_ERR, "video: Y4M header missing newline terminator")
        return out
    }
    if out[_VIDR_H_W] <= 0 { list_set(out, _VIDR_H_ERR, "video: Y4M missing width")  return out }
    if out[_VIDR_H_H] <= 0 { list_set(out, _VIDR_H_ERR, "video: Y4M missing height") return out }
    return out
}

// ---- record builder --------------------------------------------------------

fn _vidr_err_rec(errors, idx, msg) {
    let e = list_new()
    push(e, idx)
    push(e, msg)
    push(errors, e)
}

fn _vidr_int_to_str(n) { return int_to_str(n) }

fn _vidr_build_record(kg_hint, source_tag,
                       width, height, fps_num, fps_den, byte_count,
                       hash_prefix, hash_full) {
    let src = source_tag
    if len(src) == 0 { src = perc_source_prefix(PERC_MOD_VIDEO) + hash_prefix }
    let kg = kg_hint
    if len(kg) == 0 { kg = "visual" }
    let r = cur_new(kg, src)
    perc_add_root(r, PERC_MOD_VIDEO, hash_prefix, 900)
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "format",  "y4m")
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "width",   _vidr_int_to_str(width))
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "height",  _vidr_int_to_str(height))
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "fps_num", _vidr_int_to_str(fps_num))
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "fps_den", _vidr_int_to_str(fps_den))
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "bytes",   _vidr_int_to_str(byte_count))
    perc_add_meta(r, PERC_MOD_VIDEO, hash_prefix, "sha256",  hash_full)
    return r
}

// ---- public entry points ---------------------------------------------------

fn vidr_parse_bytes(byte_list, kg_hint, source_tag) {
    let records = list_new()
    let errors  = list_new()
    let n = len(byte_list)
    if n == 0 {
        _vidr_err_rec(errors, 0, "video: empty input")
        let out = list_new() push(out, records) push(out, errors) return out
    }
    let hd = _vidr_parse_header(byte_list, n)
    if len(hd[_VIDR_H_ERR]) > 0 {
        _vidr_err_rec(errors, 0, hd[_VIDR_H_ERR])
        let out = list_new() push(out, records) push(out, errors) return out
    }
    let hash_prefix = perc_hash_from_bytes(byte_list)
    let hash_full   = perc_hash_full_from_bytes(byte_list)
    let rec = _vidr_build_record(kg_hint, source_tag,
                                  hd[_VIDR_H_W], hd[_VIDR_H_H],
                                  hd[_VIDR_H_FN], hd[_VIDR_H_FD],
                                  n, hash_prefix, hash_full)
    push(records, rec)
    let out = list_new()
    push(out, records)
    push(out, errors)
    return out
}

fn vidr_parse_text(body_str, kg_hint, source_tag) {
    let bl = list_new()
    let n = len(body_str)
    let i = 0
    while i < n {
        push(bl, char_at(body_str, i))
        i = i + 1
    }
    return vidr_parse_bytes(bl, kg_hint, source_tag)
}

fn vidr_records(result) { return result[0] }
fn vidr_errors(result)  { return result[1] }
