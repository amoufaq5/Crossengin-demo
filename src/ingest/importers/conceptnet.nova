// CrossEngin ingestion: ConceptNet 5 assertion importer.
//
// ConceptNet 5 exports assertions as tab-separated rows:
//   uri  relation  start  end  json_metadata
// e.g.:
//   /a/[/r/IsA/,/c/en/dog/,/c/en/animal/]  /r/IsA  /c/en/dog  /c/en/animal  {"weight": 2.828, ...}
//
// This importer walks the file, extracts (start_concept, relation,
// end_concept, weight) from each row, and produces a curriculum record
// where each concept is an atom and each assertion is an EMPIRICAL
// implication with belief scaled from the ConceptNet weight.
//
// Weight mapping: ConceptNet weights typically range 1..10 (log-space
// evidence). Map to belief milli by bel = 500 + min(300, 100*floor(w)),
// so a weight-1 assertion is belief 600 and a weight-3+ assertion is 800.
// The mapping stays inside the confident-but-not-formal band; a caller
// who trusts ConceptNet more can post-process with a scanner that
// promotes high-weight assertions to FORMAL.
//
// Concept URIs like /c/en/dog become atom label "dog" (language stripped
// by default; multi-lingual runs pass keep_lang=1 to preserve).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/ingest/curriculum.nova, src/util/str_safe.nova,
//   src/kg/atom_store.nova, src/ingest/importers/nt_triples.nova
//   (nt_safe_label reused).

import "../curriculum.nova"
import "../../util/str_safe.nova"
import "../../kg/atom_store.nova"
import "./nt_triples.nova"

// ---- URI parsing ----------------------------------------------------------

// Concept URI is "/c/<lang>/<term>" or "/c/<lang>/<term>/<sense>". Return
// the term (or lang:term if keep_lang=1).
fn cn_concept_local(uri, keep_lang) {
    let n = len(uri)
    if n < 4 { return "" }
    // Expect the "/c/" prefix.
    if char_at(uri, 0) != 47 { return "" }
    if char_at(uri, 1) != 99 { return "" }
    if char_at(uri, 2) != 47 { return "" }
    // Find lang / term boundaries.
    let lang_start = 3
    let lang_end = 3
    while lang_end < n {
        if char_at(uri, lang_end) == 47 { lang_end = lang_end + 100000 }
        else { lang_end = lang_end + 1 }
    }
    if lang_end > n { lang_end = lang_end - 100000 }
    let lang = substr(uri, lang_start, lang_end - lang_start)
    let term_start = lang_end + 1
    if term_start >= n { return "" }
    let term_end = term_start
    while term_end < n {
        if char_at(uri, term_end) == 47 { term_end = term_end + 100000 }
        else { term_end = term_end + 1 }
    }
    if term_end > n { term_end = term_end - 100000 }
    let term = substr(uri, term_start, term_end - term_start)
    if keep_lang == 1 { return lang + ":" + term }
    return term
}

// Relation URI is "/r/IsA" -> "IsA". Trim leading "/r/".
fn cn_relation_local(uri) {
    let n = len(uri)
    if n < 3 { return uri }
    if char_at(uri, 0) != 47 { return uri }
    if char_at(uri, 1) != 114 { return uri }
    if char_at(uri, 2) != 47 { return uri }
    return substr(uri, 3, n - 3)
}

// ---- weight extractor -----------------------------------------------------

// The metadata is a JSON object; we only need the "weight" field. Rather
// than parse JSON, do a substring scan for `"weight":` and read the
// number that follows. Returns weight in milli * 1000 units (a 2.828
// weight yields 2828 milli), or 0 if not found / unparseable.
fn cn_weight(meta) {
    let n = len(meta)
    let needle = "\"weight\":"
    let nn = len(needle)
    let start = 0 - 1
    let i = 0
    while i <= n - nn {
        let match_ok = 1
        let j = 0
        while j < nn {
            if char_at(meta, i + j) != char_at(needle, j) { match_ok = 0 j = nn }
            else { j = j + 1 }
        }
        if match_ok == 1 { start = i + nn i = n + 1 }
        else { i = i + 1 }
    }
    if start < 0 { return 0 }
    // Skip whitespace.
    let ws_more = 1
    while ws_more == 1 {
        if start >= n { ws_more = 0 }
        else {
            let c = char_at(meta, start)
            if c == 32 { start = start + 1 }
            else { if c == 9 { start = start + 1 } else { ws_more = 0 } }
        }
    }
    // Parse integer.decimal.
    let intpart = 0
    let frac = 0
    let frac_div = 1
    let sign = 1
    if start < n { if char_at(meta, start) == 45 { sign = 0 - 1 start = start + 1 } }
    let int_more = 1
    while int_more == 1 {
        if start >= n { int_more = 0 }
        else {
            let c = char_at(meta, start)
            if c >= 48 { if c <= 57 { intpart = intpart * 10 + (c - 48) start = start + 1 }
                         else { int_more = 0 } }
            else { int_more = 0 }
        }
    }
    if start < n { if char_at(meta, start) == 46 {
        start = start + 1
        let frac_more = 1
        while frac_more == 1 {
            if start >= n { frac_more = 0 }
            else {
                let c = char_at(meta, start)
                if c >= 48 { if c <= 57 {
                    frac = frac * 10 + (c - 48)
                    frac_div = frac_div * 10
                    start = start + 1
                } else { frac_more = 0 } }
                else { frac_more = 0 }
            }
        }
    } }
    // Scale to milli: intpart*1000 + frac*1000/frac_div.
    let milli = intpart * 1000
    if frac_div > 1 { milli = milli + (frac * 1000 / frac_div) }
    return sign * milli
}

// Weight -> seed belief in milli (0..1000).
fn cn_belief_for_weight(w_milli) {
    let base = 500
    let w = w_milli
    if w < 0 { w = 0 }
    // Every 1.0 of weight adds 100 milli belief, capped at +300.
    let bonus = w / 10                 // w_milli/1000 * 100 == w_milli/10
    if bonus > 300 { bonus = 300 }
    return base + bonus
}

// ---- parser ---------------------------------------------------------------

// Split a line into up-to-5 tab-separated fields.
fn _cn_fields(line) {
    let out = list_new()
    let n = len(line)
    let start = 0
    let i = 0
    while i < n {
        if char_at(line, i) == 9 {
            push(out, substr(line, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(line, start, n - start))
    return out
}

fn _cn_lines(text) {
    let out = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            push(out, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(text, start, n - start))
    return out
}

// Parse ConceptNet 5 TSV text. Only /c/en/... concepts are kept by default;
// keep_lang=1 prepends the language code so cross-lingual atoms coexist.
fn cn_parse_text(text, kg_name, source_tag, keep_lang) {
    let out_records = list_new()
    let errors = list_new()
    let record = cur_new(kg_name, source_tag)
    let seen = list_new()
    let lines = _cn_lines(text)
    let i = 0
    while i < len(lines) {
        let ln = lines[i]
        if len(ln) > 0 {
            let fields = _cn_fields(ln)
            if len(fields) >= 4 {
                let rel = cn_relation_local(fields[1])
                let s = cn_concept_local(fields[2], keep_lang)
                let o = cn_concept_local(fields[3], keep_lang)
                if len(s) > 0 {
                    if len(o) > 0 {
                        let s_lab = nt_safe_label(s)
                        let o_lab = nt_safe_label(o)
                        let w = 1000
                        if len(fields) >= 5 { w = cn_weight(fields[4]) }
                        if w <= 0 { w = 1000 }
                        let bel = cn_belief_for_weight(w)
                        _cn_seen_add(record, seen, s_lab, bel)
                        _cn_seen_add(record, seen, o_lab, bel)
                        cur_add_imp(record, s_lab, o_lab, "EMPIRICAL")
                    }
                }
            }
        }
        i = i + 1
    }
    push(out_records, record)
    let out = list_new() push(out, out_records) push(out, errors)
    return out
}

fn _cn_seen_add(record, seen, label, belief) {
    if len(label) == 0 { return 0 }
    let i = 0
    while i < len(seen) {
        if str_eq_bytes(seen[i], label) == 1 { return 0 }
        i = i + 1
    }
    push(seen, label)
    cur_add_atom(record, label, ATOM_CONCEPT, belief)
    return 1
}

fn cn_parse(path, kg_name, source_tag) {
    let text = read_file(path)
    if text == 0 {
        let recs = list_new()
        let errs = list_new()
        let e = list_new() push(e, 0) push(e, "could not read: " + path)
        push(errs, e)
        let out = list_new() push(out, recs) push(out, errs) return out
    }
    return cn_parse_text(text, kg_name, source_tag, 0)
}

fn cn_records(result) { return result[0] }
fn cn_errors(result)  { return result[1] }
