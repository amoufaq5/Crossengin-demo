// CrossEngin language: natural-language generation (N4, ADR-0062).
//
// Purpose
//   The agent KNOWS facts as (subject, relation, object) operator atoms and
//   reasons in chains over them, but it spoke them as terse template fragments
//   ("rain->flood", "rain leads to flood") with underscored labels, no articles,
//   and no subject-verb agreement. This module renders the same facts and
//   reasoning chains as FLUENT clauses -- "Rain leads to flood.", "A dog is an
//   animal.", "Dogs are animals." -- so the chat surface reads like English
//   rather than a graph dump.
//
//   Scope is deliberately shallow + deterministic (the project's no-LLM
//   invariant): article selection (a/an by vowel), naive number agreement
//   (plural subject -> "are"/"lead to", a pluralised object), underscore->space,
//   sentence capitalisation, Oxford-comma object lists, and multi-hop chain
//   rendering ("A leads to B, which leads to C."). It keeps the SAME relation
//   spellings the cognitive router uses, so replies are consistent.
//
// ADRs implemented: ADR-0062 (NL generation). NOVA dependencies: builtins
//   (len, char_at, substr, chr, str_eq, str_replace, str_lower). CrossEngin
//   dependencies: src/parts/reasoning/reasoning_atoms.nova (the ROP_* relation
//   kind constants only).

import "../parts/reasoning/reasoning_atoms.nova"

// ---- word-level helpers ----------------------------------------------------
fn _nlg_is_vowel(c) {
    if c == 97  { return 1 }   // a
    if c == 101 { return 1 }   // e
    if c == 105 { return 1 }   // i
    if c == 111 { return 1 }   // o
    if c == 117 { return 1 }   // u
    if c == 65  { return 1 }
    if c == 69  { return 1 }
    if c == 73  { return 1 }
    if c == 79  { return 1 }
    if c == 85  { return 1 }
    return 0
}

// Underscored KG label -> spaced surface form ("the_sun" -> "the sun").
fn nlg_phrase(label) {
    return str_replace(label, "_", " ")
}

// Capitalise the first character (ASCII a-z -> A-Z); other text untouched.
fn nlg_cap(s) {
    if len(s) == 0 { return s }
    let c = char_at(s, 0)
    if c >= 97 { if c <= 122 {
        return chr(c - 32) + substr(s, 1, len(s) - 1)
    } }
    return s
}

// Indefinite article for a following word: "an" before a vowel sound, else "a"
// ("" for an empty word). Heuristic -- spelling, not phonetics (so "hour"/"x-ray"
// edge cases are a documented gap).
fn nlg_indef_article(word) {
    if len(word) == 0 { return "" }
    if _nlg_is_vowel(char_at(word, 0)) == 1 { return "an" }
    return "a"
}

// Rough plural detector: ends in a single 's' that isn't part of "ss"/"us"/"is".
// Good enough to choose is/are; documented as heuristic.
fn nlg_is_plural(word) {
    let n = len(word)
    if n < 3 { return 0 }
    if char_at(word, n - 1) != 115 { return 0 }   // not ending 's'
    let prev = char_at(word, n - 2)
    if prev == 115 { return 0 }   // "ss" (grass)
    if prev == 117 { return 0 }   // "us" (bonus)
    if prev == 105 { return 0 }   // "is" (basis)
    return 1
}

// Naive pluralisation for object agreement (-y->-ies, sibilant->-es, else -s);
// already-plural words are left alone.
fn nlg_pluralize(word) {
    let n = len(word)
    if n == 0 { return word }
    let last = char_at(word, n - 1)
    if last == 115 { return word }   // already ends in 's'
    if last == 121 {                 // ...y
        if n >= 2 {
            if _nlg_is_vowel(char_at(word, n - 2)) == 0 {
                return substr(word, 0, n - 1) + "ies"
            }
        }
        return word + "s"
    }
    if last == 120 { return word + "es" }   // x
    if last == 122 { return word + "es" }   // z
    if n >= 2 {
        let two = substr(word, n - 2, 2)
        if str_eq(two, "ch") == 1 { return word + "es" }
        if str_eq(two, "sh") == 1 { return word + "es" }
    }
    return word + "s"
}

// ---- single-fact clauses ---------------------------------------------------
// Render (subject, relation-kind, object) as a fluent clause -- no leading
// capital, no terminal period (so it composes). Articles + number agreement are
// applied; is_a pluralises the object for a plural subject ("dogs are animals").
fn nlg_clause(subject, kind, object) {
    let s = nlg_phrase(subject)
    let o = nlg_phrase(object)
    let pl = nlg_is_plural(subject)
    if kind == ROP_IMPLY {
        if pl == 1 { return s + " are " + nlg_pluralize(o) }
        let art = nlg_indef_article(o)
        if len(art) == 0 { return s + " is " + o }
        return s + " is " + art + " " + o
    }
    if kind == ROP_CAUSAL {
        if pl == 1 { return s + " lead to " + o }
        return s + " leads to " + o
    }
    if kind == ROP_ANALOGY {
        if pl == 1 { return s + " are like " + o }
        return s + " is like " + o
    }
    if kind == ROP_OPPOSITE {
        if pl == 1 { return s + " are the opposite of " + o }
        return s + " is the opposite of " + o
    }
    if pl == 1 { return s + " relate to " + o }
    return s + " relates to " + o
}

// Capitalised, period-terminated sentence from a clause.
fn nlg_sentence_of(clause) {
    if len(clause) == 0 { return "" }
    let t = nlg_cap(clause)
    let last = char_at(t, len(t) - 1)
    if last == 46 { return t }   // .
    if last == 63 { return t }   // ?
    if last == 33 { return t }   // !
    return t + "."
}

// (subject, kind, object) -> a full sentence.
fn nlg_fact_sentence(subject, kind, object) {
    return nlg_sentence_of(nlg_clause(subject, kind, object))
}

// ---- object lists (coordination) -------------------------------------------
// Oxford-comma list of (deunderscored) labels: "a"; "a and b"; "a, b, and c".
fn nlg_object_list(labels) {
    let n = len(labels)
    if n == 0 { return "" }
    if n == 1 { return nlg_phrase(labels[0]) }
    if n == 2 { return nlg_phrase(labels[0]) + " and " + nlg_phrase(labels[1]) }
    let s = ""
    let i = 0
    while i < n - 1 {
        s = s + nlg_phrase(labels[i]) + ", "
        i = i + 1
    }
    return s + "and " + nlg_phrase(labels[n - 1])
}

// (subject, kind, [objects]) -> one clause with a coordinated object list
// ("rain leads to flooding and erosion"). One object delegates to nlg_clause
// (so the article/agreement path is preserved for the singular is_a case).
fn nlg_clause_multi(subject, kind, objects) {
    let n = len(objects)
    if n == 0 { return nlg_phrase(subject) }
    if n == 1 { return nlg_clause(subject, kind, objects[0]) }
    let s = nlg_phrase(subject)
    let pl = nlg_is_plural(subject)
    let lst = nlg_object_list(objects)
    if kind == ROP_CAUSAL {
        if pl == 1 { return s + " lead to " + lst }
        return s + " leads to " + lst
    }
    if kind == ROP_ANALOGY {
        if pl == 1 { return s + " are like " + lst }
        return s + " is like " + lst
    }
    if kind == ROP_OPPOSITE {
        if pl == 1 { return s + " are the opposite of " + lst }
        return s + " is the opposite of " + lst
    }
    if kind == ROP_IMPLY {
        if pl == 1 { return s + " are " + lst }
        return s + " is " + lst
    }
    if pl == 1 { return s + " relate to " + lst }
    return s + " relates to " + lst
}

// ---- reasoning chains ------------------------------------------------------
// A forward chain of concept labels (all causal hops) as a fluent clause:
//   [a]           -> "a"
//   [a, b]        -> "a leads to b"
//   [a, b, c]     -> "a leads to b, which leads to c"
fn nlg_chain(labels) {
    let n = len(labels)
    if n == 0 { return "" }
    if n == 1 { return nlg_phrase(labels[0]) }
    let s = nlg_phrase(labels[0]) + " leads to " + nlg_phrase(labels[1])
    let i = 2
    while i < n {
        s = s + ", which leads to " + nlg_phrase(labels[i])
        i = i + 1
    }
    return s
}

// A forward chain as a full sentence.
fn nlg_chain_sentence(labels) {
    return nlg_sentence_of(nlg_chain(labels))
}
