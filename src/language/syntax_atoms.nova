// CrossEngin language: syntax-pattern atoms.
//
// Purpose
//   Syntax-pattern atoms (ADR-0015) hold an ordered slot pattern over concept
//   roles (e.g. [AGENT, ACTION, PATIENT]) as ATOM_LANG atoms with payload
//   ltype = LSYNTAX. They sequence word atoms during generation (ADR-0013) and
//   group atoms during the reader's coherence/binding stage (ADR-0012 stage 4).
//   They are learned and strengthen via plasticity when phrasings succeed
//   (ADR-0007/0023); reliability is the atom's Bayesian belief.
//
// ADRs implemented: ADR-0015 (language atoms - syntax), ADR-0013 (ordering for
//   generation), ADR-0023 (belief updates with success).
// NOVA dependencies: builtins (lists, str_eq).
// CrossEngin dependencies: src/language/word_atoms.nova.

import "word_atoms.nova"

// Create a syntax-pattern atom named `name` with an ordered list of role names.
fn syntax_atom_new(lang_kg, name, slot_pattern, moment) {
    let a = kg_add_atom(lang_kg, ATOM_LANG, name, moment)
    atom_payload_set(a, "ltype", LSYNTAX)
    atom_payload_set(a, "pattern", slot_pattern)
    return a
}

fn is_syntax_atom(a) {
    if a == 0 { return 0 }
    if atom_kind(a) != ATOM_LANG { return 0 }
    if lang_type(a) == LSYNTAX { return 1 }
    return 0
}

fn syntax_pattern(a) {
    if atom_payload_has(a, "pattern") == 0 { return list_new() }
    return atom_payload_get(a, "pattern")
}

fn syntax_slot_count(a) { return len(syntax_pattern(a)) }

fn syntax_find(lang_kg, name) {
    let a = kg_find_atom(lang_kg, name)
    if is_syntax_atom(a) == 0 { return 0 }
    return a
}

// Look up the filler bound to a role in a [role, filler] assignment list.
fn _filler_for(role, fillers) {
    let i = 0
    while i < len(fillers) {
        if str_eq(fillers[i][0], role) == 1 { return fillers[i][1] }
        i = i + 1
    }
    return 0
}

// Apply the pattern to a set of role->filler assignments, producing the ordered
// list of fillers (ADR-0013 word ordering for generation). Roles with no filler
// are skipped.
fn syntax_apply(syntax_atom, fillers) {
    let out = list_new()
    let pattern = syntax_pattern(syntax_atom)
    let i = 0
    while i < len(pattern) {
        let f = _filler_for(pattern[i], fillers)
        if f != 0 { push(out, f) }
        i = i + 1
    }
    return out
}

// Does an assignment supply every role the pattern requires?
fn syntax_complete(syntax_atom, fillers) {
    let pattern = syntax_pattern(syntax_atom)
    let i = 0
    while i < len(pattern) {
        if _filler_for(pattern[i], fillers) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Reliability updates as phrasings succeed/fail (ADR-0007/0023).
fn syntax_observe(a, sign)   { return atom_observe(a, sign) }
fn syntax_confidence(a)      { return atom_confidence(a) }
