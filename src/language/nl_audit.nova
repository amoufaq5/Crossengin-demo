// Audited natural-language responder (ADR-0043 x ADR-0089/0090): wraps
// nlq_respond so every CONTESTED answer leaves an immutable, hash-chained,
// crash-safe record in the decision log alongside the steelmanned reply the
// user sees.
//
// The loop the engine just closed:
//   user question -> nlq_respond -> (claim contested?) -> steelman in the reply
//                                                     -> dlog_record_atom_debate
//                                                        into the ADR-0043 log
// So every time the user is told "this is contested", an auditor can later read
// drec_render on that entry and reconstruct exactly which arguments were
// weighed and what verdict the debate engine returned. Non-contested answers
// don't write to the log: the per-effector audit (audit_writer) already covers
// the action surface, and the reasoning log is reserved for adjudications.
//
// ADRs implemented: ADR-0043 (decision log) x ADR-0089 (debate) x ADR-0090
// (steelman). CrossEngin dependencies:
//   src/language/nl_query.nova (the answerer + the carried claim id),
//   src/parts/reasoning/decision_record.nova (DLK_DECISION recorder).

import "nl_query.nova"
import "../parts/reasoning/decision_record.nova"

// Audited variant of nlq_respond. Delegates to the normal answerer; if the
// answer came back CONTESTED (the debate engine reported a multi-extension
// contention, ADR-0090's empirical-defeat-vs-value-disagreement line) and a log
// is wired, persist the debate trace for the same claim atom as a DLK_DECISION
// entry. `log` may be 0 (no log wired) -- the answerer's reply is returned
// either way; only the audit side-effect is skipped.
fn nlq_respond_audited(kg, aliases, text, log, moment) {
    let a = nlq_respond(kg, aliases, text)
    if log == 0 { return a }
    if nlq_found(a) == 0 { return a }
    if nlq_aform(a) != NLQ_CONTESTED { return a }
    let claim_id = nlq_claim(a)
    if claim_id < 0 { return a }
    dlog_record_atom_debate(log, kg, claim_id, moment)
    return a
}
