// CrossEngin language: number-words & units -> value (N2, ADR-0060).
//
// Purpose
//   arithmetic.nova evaluates DIGIT expressions ("2 + 2"), but a great deal of
//   quantity in natural language is spelled out -- "three hundred", "a dozen",
//   "two thousand five hundred" -- or carries a unit -- "2.5 kg". Table/measure
//   ingestion and the arithmetic router both want a numeric value out of those.
//   This module is a small, deterministic English-number reader: it turns a
//   number phrase into a MILLI value (x1000 fixed point, the convention the rest
//   of CrossEngin's milli math uses) and, optionally, a recognised measurement
//   unit. No parser, no learning -- a curated word table and the classic
//   accumulate-on-scale algorithm.
//
//   Supported, by design (bounded + testable):
//     - ones/teens (zero..nineteen), tens (twenty..ninety)
//     - multipliers: hundred, dozen (=12), score (=20)
//     - scales: thousand, million, billion
//     - "and" / "a" / "an" filler ("one hundred and five" = 105, "a dozen" = 12)
//     - hyphenated compounds ("twenty-one" = 21)
//     - decimal digit numbers ("2.5" -> 2500 milli)
//     - an optional trailing recognised unit ("2.5 kg" -> milli 2500, unit "kg")
//
//   CODEGEN NOTE: scaled values readily exceed NOVA codegen bug #11's 0x100000
//   threshold (e.g. "two million" = 2,000,000,000 milli), so ALL value
//   arithmetic here uses the int_* escape-hatch builtins (int_mul/int_add),
//   never the smart-op `*`/`+`. Loop indices and small literals stay on `+`/`<`.
//
// ADRs implemented: ADR-0060 (number-words). NOVA dependencies: builtins only
//   (len, char_at, substr, str_eq, str_lower, int_to_str, push, list_new,
//   int_mul, int_add). CrossEngin dependencies: NONE.

// ---- token classes ---------------------------------------------------------
let NUMW_NONE  = 0   // not a number word
let NUMW_ADD   = 1   // ones / teens / tens -- added into the running group
let NUMW_MULT  = 2   // hundred / dozen / score -- multiplies the running group
let NUMW_SCALE = 3   // thousand / million / billion -- flushes the group * scale

// Classify a single lowercased word -> [class, value]. value is the integer the
// word denotes (or the multiplier/scale factor). [NUMW_NONE, 0] if not numeric.
fn _numw_lookup(w) {
    let r = list_new()
    // ones / teens
    if str_eq(w, "zero") == 1     { push(r, NUMW_ADD); push(r, 0); return r }
    if str_eq(w, "one") == 1      { push(r, NUMW_ADD); push(r, 1); return r }
    if str_eq(w, "two") == 1      { push(r, NUMW_ADD); push(r, 2); return r }
    if str_eq(w, "three") == 1    { push(r, NUMW_ADD); push(r, 3); return r }
    if str_eq(w, "four") == 1     { push(r, NUMW_ADD); push(r, 4); return r }
    if str_eq(w, "five") == 1     { push(r, NUMW_ADD); push(r, 5); return r }
    if str_eq(w, "six") == 1      { push(r, NUMW_ADD); push(r, 6); return r }
    if str_eq(w, "seven") == 1    { push(r, NUMW_ADD); push(r, 7); return r }
    if str_eq(w, "eight") == 1    { push(r, NUMW_ADD); push(r, 8); return r }
    if str_eq(w, "nine") == 1     { push(r, NUMW_ADD); push(r, 9); return r }
    if str_eq(w, "ten") == 1      { push(r, NUMW_ADD); push(r, 10); return r }
    if str_eq(w, "eleven") == 1   { push(r, NUMW_ADD); push(r, 11); return r }
    if str_eq(w, "twelve") == 1   { push(r, NUMW_ADD); push(r, 12); return r }
    if str_eq(w, "thirteen") == 1 { push(r, NUMW_ADD); push(r, 13); return r }
    if str_eq(w, "fourteen") == 1 { push(r, NUMW_ADD); push(r, 14); return r }
    if str_eq(w, "fifteen") == 1  { push(r, NUMW_ADD); push(r, 15); return r }
    if str_eq(w, "sixteen") == 1  { push(r, NUMW_ADD); push(r, 16); return r }
    if str_eq(w, "seventeen") == 1{ push(r, NUMW_ADD); push(r, 17); return r }
    if str_eq(w, "eighteen") == 1 { push(r, NUMW_ADD); push(r, 18); return r }
    if str_eq(w, "nineteen") == 1 { push(r, NUMW_ADD); push(r, 19); return r }
    // tens
    if str_eq(w, "twenty") == 1   { push(r, NUMW_ADD); push(r, 20); return r }
    if str_eq(w, "thirty") == 1   { push(r, NUMW_ADD); push(r, 30); return r }
    if str_eq(w, "forty") == 1    { push(r, NUMW_ADD); push(r, 40); return r }
    if str_eq(w, "fifty") == 1    { push(r, NUMW_ADD); push(r, 50); return r }
    if str_eq(w, "sixty") == 1    { push(r, NUMW_ADD); push(r, 60); return r }
    if str_eq(w, "seventy") == 1  { push(r, NUMW_ADD); push(r, 70); return r }
    if str_eq(w, "eighty") == 1   { push(r, NUMW_ADD); push(r, 80); return r }
    if str_eq(w, "ninety") == 1   { push(r, NUMW_ADD); push(r, 90); return r }
    // small additive idioms
    if str_eq(w, "couple") == 1   { push(r, NUMW_ADD); push(r, 2); return r }
    if str_eq(w, "pair") == 1     { push(r, NUMW_ADD); push(r, 2); return r }
    // multipliers (act on the running group; a bare one means 1x)
    if str_eq(w, "hundred") == 1  { push(r, NUMW_MULT); push(r, 100); return r }
    if str_eq(w, "dozen") == 1    { push(r, NUMW_MULT); push(r, 12); return r }
    if str_eq(w, "dozens") == 1   { push(r, NUMW_MULT); push(r, 12); return r }
    if str_eq(w, "score") == 1    { push(r, NUMW_MULT); push(r, 20); return r }
    // scales (flush the group)
    if str_eq(w, "thousand") == 1 { push(r, NUMW_SCALE); push(r, 1000); return r }
    if str_eq(w, "million") == 1  { push(r, NUMW_SCALE); push(r, 1000000); return r }
    if str_eq(w, "billion") == 1  { push(r, NUMW_SCALE); push(r, 1000000000); return r }
    push(r, NUMW_NONE); push(r, 0)
    return r
}

fn numw_is_number_word(w) {
    return _numw_lookup(w)[0] != NUMW_NONE
}

// "a"/"an"/"and" are number-phrase filler, not numbers themselves.
fn _numw_is_filler(w) {
    if str_eq(w, "a") == 1   { return 1 }
    if str_eq(w, "an") == 1  { return 1 }
    if str_eq(w, "and") == 1 { return 1 }
    return 0
}

// ---- tokenisation ----------------------------------------------------------
// Split on whitespace and hyphens; lowercase. Digit tokens (containing a digit)
// are kept whole so "2.5" survives; word tokens are alpha runs.
fn _numw_tokens(s) {
    let out = list_new()
    let lo = str_lower(s)
    let n = len(lo)
    let start = 0 - 1
    let i = 0
    while i < n {
        let c = char_at(lo, i)
        let keep = 0
        if c >= 97 { if c <= 122 { keep = 1 } }   // a-z
        if c >= 48 { if c <= 57 { keep = 1 } }    // 0-9
        if c == 46 { keep = 1 }                   // '.' inside a decimal
        if keep == 1 {
            if start < 0 { start = i }
        } else {
            if start >= 0 { push(out, substr(lo, start, i - start)) start = 0 - 1 }
        }
        i = i + 1
    }
    if start >= 0 { push(out, substr(lo, start, n - start)) }
    return out
}

fn _numw_tok_has_digit(t) {
    let i = 0
    while i < len(t) {
        let c = char_at(t, i)
        if c >= 48 { if c <= 57 { return 1 } }
        i = i + 1
    }
    return 0
}

// ---- digit token -> milli --------------------------------------------------
fn _numw_is_digit(c) {
    if c >= 48 { if c <= 57 { return 1 } }
    return 0
}

// Parse a digit token ("12", "2.5", "1000000") -> milli (int_* safe for big
// integer parts). Non-digit characters end the parse.
fn _numw_digit_milli(t) {
    let n = len(t)
    let dot = 0 - 1
    let i = 0
    // locate the (first) decimal point
    while i < n {
        if char_at(t, i) == 46 { dot = i i = n } else { i = i + 1 }
    }
    let ip_end = dot
    if dot < 0 { ip_end = n }
    // integer part
    let ipart = 0
    let j = 0
    while j < ip_end {
        let c = char_at(t, j)
        if _numw_is_digit(c) == 1 { ipart = int_add(int_mul(ipart, 10), c - 48) }
        j = j + 1
    }
    let milli = int_mul(ipart, 1000)
    if dot >= 0 {
        // up to 3 fractional digits -> milli (e.g. ".5"->500, ".025"->25)
        let scale = 100
        let k = dot + 1
        while k < n {
            if scale >= 1 {
                let c = char_at(t, k)
                if _numw_is_digit(c) == 1 { milli = int_add(milli, int_mul(c - 48, scale)) }
                scale = scale / 10
            }
            k = k + 1
        }
    }
    return milli
}

// ---- word run -> value -----------------------------------------------------
// Accumulate a maximal run of number words starting at `from`, returning
// [value, next_index, consumed_count]. Classic algorithm: ADD words grow the
// running group; a MULT word multiplies the group (a bare multiplier = 1x); a
// SCALE word flushes group*scale into the total. int_* throughout.
fn _numw_run(toks, from) {
    let n = len(toks)
    let total = 0
    let group = 0
    let consumed = 0
    let i = from
    let go = 1
    while go == 1 {
        if i >= n { go = 0 }
        else {
            let w = toks[i]
            if _numw_is_filler(w) == 1 {
                // filler only continues a run that has already started.
                if consumed == 0 { go = 0 } else { i = i + 1 }
            } else {
                let cv = _numw_lookup(w)
                let cls = cv[0]
                let val = cv[1]
                if cls == NUMW_NONE { go = 0 }
                else {
                    if cls == NUMW_ADD { group = int_add(group, val) }
                    else { if cls == NUMW_MULT {
                        let g = group
                        if g == 0 { g = 1 }
                        group = int_mul(g, val)
                    } else {
                        // SCALE
                        let g = group
                        if g == 0 { g = 1 }
                        total = int_add(total, int_mul(g, val))
                        group = 0
                    } }
                    consumed = consumed + 1
                    i = i + 1
                }
            }
        }
    }
    let out = list_new()
    push(out, int_add(total, group))
    push(out, i)
    push(out, consumed)
    return out
}

// numw_words_to_value(text) -> [ok, value]. Scans for the first run of number
// words anywhere in the text. ok=0 (value 0) when no number word is present.
fn numw_words_to_value(text) {
    let toks = _numw_tokens(text)
    let n = len(toks)
    let i = 0
    while i < n {
        if numw_is_number_word(toks[i]) == 1 {
            let run = _numw_run(toks, i)
            let r = list_new() push(r, 1) push(r, run[0]) return r
        }
        i = i + 1
    }
    let r = list_new() push(r, 0) push(r, 0) return r
}

// ---- units -----------------------------------------------------------------
// Recognised measurement unit -> canonical abbreviation ("" if not a unit).
// Curated + bounded; singular/plural and common spellings fold together.
fn numw_unit_canon(w) {
    if str_eq(w, "kg") == 1         { return "kg" }
    if str_eq(w, "kilogram") == 1   { return "kg" }
    if str_eq(w, "kilograms") == 1  { return "kg" }
    if str_eq(w, "g") == 1          { return "g" }
    if str_eq(w, "gram") == 1       { return "g" }
    if str_eq(w, "grams") == 1      { return "g" }
    if str_eq(w, "mg") == 1         { return "mg" }
    if str_eq(w, "lb") == 1         { return "lb" }
    if str_eq(w, "lbs") == 1        { return "lb" }
    if str_eq(w, "pound") == 1      { return "lb" }
    if str_eq(w, "pounds") == 1     { return "lb" }
    if str_eq(w, "m") == 1          { return "m" }
    if str_eq(w, "meter") == 1      { return "m" }
    if str_eq(w, "meters") == 1     { return "m" }
    if str_eq(w, "metre") == 1      { return "m" }
    if str_eq(w, "metres") == 1     { return "m" }
    if str_eq(w, "cm") == 1         { return "cm" }
    if str_eq(w, "mm") == 1         { return "mm" }
    if str_eq(w, "km") == 1         { return "km" }
    if str_eq(w, "s") == 1          { return "s" }
    if str_eq(w, "sec") == 1        { return "s" }
    if str_eq(w, "second") == 1     { return "s" }
    if str_eq(w, "seconds") == 1    { return "s" }
    if str_eq(w, "min") == 1        { return "min" }
    if str_eq(w, "minute") == 1     { return "min" }
    if str_eq(w, "minutes") == 1    { return "min" }
    if str_eq(w, "h") == 1          { return "h" }
    if str_eq(w, "hour") == 1       { return "h" }
    if str_eq(w, "hours") == 1      { return "h" }
    if str_eq(w, "l") == 1          { return "l" }
    if str_eq(w, "liter") == 1      { return "l" }
    if str_eq(w, "liters") == 1     { return "l" }
    if str_eq(w, "litre") == 1      { return "l" }
    if str_eq(w, "litres") == 1     { return "l" }
    if str_eq(w, "ml") == 1         { return "ml" }
    if str_eq(w, "percent") == 1    { return "%" }
    return ""
}

fn numw_is_unit(w) {
    return len(numw_unit_canon(w)) > 0
}

// ---- full parse ------------------------------------------------------------
// numw_parse(text) -> [ok, milli, unit].
//   - the first number in the text (a digit token OR a word run) -> milli
//   - the first recognised unit AFTER that number -> canonical unit (else "")
// ok=0 (milli 0, unit "") when no number is present.
fn _numw_result(ok, milli, unit) {
    let r = list_new()
    push(r, ok); push(r, milli); push(r, unit)
    return r
}
fn numw_ok(r)    { return r[0] }
fn numw_milli(r) { return r[1] }
fn numw_unit(r)  { return r[2] }

// integer value of a parse (milli / 1000, truncated). Safe: /1000 is smart-op
// against a small literal, so it never trips the threshold.
fn numw_value(r) { return r[1] / 1000 }

fn numw_parse(text) {
    let toks = _numw_tokens(text)
    let n = len(toks)
    let i = 0
    let milli = 0
    let found = 0
    let next = n
    while i < n {
        if found == 0 {
            let t = toks[i]
            if _numw_tok_has_digit(t) == 1 {
                milli = _numw_digit_milli(t)
                found = 1
                next = i + 1
            } else { if numw_is_number_word(t) == 1 {
                let run = _numw_run(toks, i)
                milli = int_mul(run[0], 1000)
                found = 1
                next = run[1]
            } }
        }
        i = i + 1
    }
    if found == 0 { return _numw_result(0, 0, "") }
    // first recognised unit at/after the number.
    let unit = ""
    let k = next
    while k < n {
        let u = numw_unit_canon(toks[k])
        if len(u) > 0 { unit = u k = n } else { k = k + 1 }
    }
    return _numw_result(1, milli, unit)
}
