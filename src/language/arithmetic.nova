// CrossEngin language: arithmetic evaluator (ADR-0055).
//
// Purpose
//   The financial / arithmetic categories of the input classifier need a REAL
//   numeric answer, not an atom lookup -- "what is 2 + 2" returning "okay" (or
//   "I don't know 2 yet") was a flagship symptom of the pre-R40 single path.
//   This is a small, dependency-free fixed-point evaluator: it scans a natural
//   utterance for a computable expression and returns the value, or signals
//   "not arithmetic" so the router falls back to another strategy.
//
//   Supported, by design (kept bounded + testable, not a CAS):
//     - infix + - * / over integers and decimals, with * / binding tighter
//       than + - ("2 + 3 * 4" = 14)
//     - word operators: plus / minus / times / multiplied [by] / divided [by]
//       / over
//     - percentage:  "P% of N"  and  "P percent of N"  ->  P*N/100
//   Non-numeric words (what / is / the / ...) are skipped, so the evaluator
//   reads straight out of a sentence. Division by zero -> not-ok.
//
//   Values are carried in MILLI fixed point (x1000) so "10 / 4" renders 2.5
//   rather than truncating to 2 -- consistent with the rest of CrossEngin's
//   milli confidences.
//
//   N2 follow-up (ADR-0060): a normalisation pass rewrites spelled-out number
//   runs to digits before scanning ("two hundred plus fifty" -> "200 plus 50"),
//   so word numbers flow through the same evaluator. Digit-only inputs are
//   untouched (no number word -> the text passes through unchanged).
//
// ADRs implemented: ADR-0055, ADR-0060 (word-number intake). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/language/number_words.nova.

import "number_words.nova"
import "../util/str_safe.nova"

let AR_ADD = 1
let AR_SUB = 2
let AR_MUL = 3
let AR_DIV = 4
let AR_PCT = 6   // '%' or the word "percent", trailing a number
let AR_OF  = 7   // the word "of", introducing a percentage base

// ---- scanning -------------------------------------------------------------
fn _ar_is_digit(c) {
    if c >= 48 { if c <= 57 { return 1 } }
    return 0
}

fn _ar_is_alpha(c) {
    if c >= 97 { if c <= 122 { return 1 } }
    if c >= 65 { if c <= 90  { return 1 } }
    return 0
}

// Parse a number starting at pos (digits, optional single '.'), returning
// [milli_value, new_pos]. Caller guarantees char_at(s,pos) is a digit or '.'.
fn _ar_number(s, pos) {
    let n = len(s)
    let i = pos
    let dot = 0 - 1
    let scanning = 1
    while scanning == 1 {
        if i >= n { scanning = 0 }
        else {
            let c = char_at(s, i)
            if _ar_is_digit(c) == 1 { i = i + 1 }
            else if c == 46 {
                if dot < 0 { dot = i i = i + 1 }
                else { scanning = 0 }
            } else { scanning = 0 }
        }
    }
    let end = i
    let milli = 0
    if dot < 0 {
        milli = _ar_digits_to_int(s, pos, end) * 1000
    } else {
        let ipart = _ar_digits_to_int(s, pos, dot)
        let fmilli = _ar_frac_to_milli(s, dot + 1, end)
        milli = ipart * 1000 + fmilli
    }
    let out = list_new()
    push(out, milli)
    push(out, end)
    return out
}

fn _ar_digits_to_int(s, a, b) {
    let v = 0
    let i = a
    while i < b {
        let c = char_at(s, i)
        if _ar_is_digit(c) == 1 { v = v * 10 + (c - 48) }
        i = i + 1
    }
    return v
}

// First up-to-3 fractional digits -> milli (e.g. "5"->500, "25"->250,
// "025"->025=25, "1234"->123).
fn _ar_frac_to_milli(s, a, b) {
    let scale = 100
    let v = 0
    let i = a
    while i < b {
        if scale >= 1 {
            let c = char_at(s, i)
            if _ar_is_digit(c) == 1 { v = v + (c - 48) * scale }
            scale = scale / 10
        }
        i = i + 1
    }
    return v
}

// Read an alpha word starting at pos -> [word, new_pos].
fn _ar_word(s, pos) {
    let n = len(s)
    let i = pos
    let scanning = 1
    while scanning == 1 {
        if i >= n { scanning = 0 }
        else if _ar_is_alpha(char_at(s, i)) == 1 { i = i + 1 }
        else { scanning = 0 }
    }
    let out = list_new()
    push(out, substr(s, pos, i - pos))
    push(out, i)
    return out
}

fn _ar_word_op(w) {
    if str_eq_bytes(w, "plus") == 1 { return AR_ADD }
    if str_eq_bytes(w, "minus") == 1 { return AR_SUB }
    if str_eq_bytes(w, "times") == 1 { return AR_MUL }
    if str_eq_bytes(w, "multiplied") == 1 { return AR_MUL }
    if str_eq_bytes(w, "divided") == 1 { return AR_DIV }
    if str_eq_bytes(w, "over") == 1 { return AR_DIV }
    if str_eq_bytes(w, "percent") == 1 { return AR_PCT }
    if str_eq_bytes(w, "of") == 1 { return AR_OF }
    return 0
}

// Scan an utterance into a token list. Each token is ["num", milli] or
// ["op", code]. Unknown words / filler ("by", "what", "is") are skipped.
fn _ar_scan(s) {
    let toks = list_new()
    let n = len(s)
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c == 32 { i = i + 1 }
        else if _ar_is_digit(c) == 1 {
            let r = _ar_number(s, i)
            let t = list_new() push(t, "num") push(t, r[0])
            push(toks, t)
            i = r[1]
        } else if c == 46 {
            let r = _ar_number(s, i)
            let t = list_new() push(t, "num") push(t, r[0])
            push(toks, t)
            i = r[1]
        } else if c == 43 { _ar_push_op(toks, AR_ADD) i = i + 1 }
        else if c == 45 { _ar_push_op(toks, AR_SUB) i = i + 1 }
        else if c == 42 { _ar_push_op(toks, AR_MUL) i = i + 1 }
        else if c == 47 { _ar_push_op(toks, AR_DIV) i = i + 1 }
        else if c == 37 { _ar_push_op(toks, AR_PCT) i = i + 1 }
        else if _ar_is_alpha(c) == 1 {
            let r = _ar_word(s, i)
            let op = _ar_word_op(r[0])
            if op != 0 { _ar_push_op(toks, op) }
            i = r[1]
        } else { i = i + 1 }
    }
    return toks
}

fn _ar_push_op(toks, code) {
    let t = list_new() push(t, "op") push(t, code)
    push(toks, t)
    return 1
}

fn _ar_is_num(t)  { return str_eq_bytes(t[0], "num") }
fn _ar_tok_val(t) { return t[1] }

// ---- fixed-point ops ------------------------------------------------------
fn _ar_mul(a, b) { return a * b / 1000 }
fn _ar_div(a, b) { return a * 1000 / b }   // caller guards b != 0

// Render milli -> decimal string, trimming trailing fractional zeros.
fn _ar_render(m) {
    let neg = 0
    let v = m
    if v < 0 { neg = 1 v = 0 - v }
    let ip = v / 1000
    let fp = v - ip * 1000
    let s = int_to_str(ip)
    if fp != 0 {
        let frac = ""
        if fp < 100 { frac = "0" }
        if fp < 10 { frac = "00" }
        frac = frac + int_to_str(fp)
        // strip trailing zeros
        let end = len(frac)
        let stop = 0
        while stop == 0 {
            if end <= 1 { stop = 1 }
            else if char_at(frac, end - 1) == 48 { end = end - 1 }
            else { stop = 1 }
        }
        s = s + "." + substr(frac, 0, end)
    }
    if neg == 1 { s = "-" + s }
    return s
}

// ---- public evaluator -----------------------------------------------------
fn _ar_result(ok, milli, text) {
    let r = list_new()
    push(r, ok)
    push(r, milli)
    push(r, text)
    return r
}

// Split text on ASCII spaces into whitespace-free tokens (punctuation/symbols
// kept attached, so "2+2" stays one token and is left alone).
fn _ar_ws_split(s) {
    let out = list_new()
    let n = len(s)
    let start = 0 - 1
    let i = 0
    while i < n {
        if char_at(s, i) == 32 {
            if start >= 0 { push(out, substr(s, start, i - start)) start = 0 - 1 }
        } else { if start < 0 { start = i } }
        i = i + 1
    }
    if start >= 0 { push(out, substr(s, start, n - start)) }
    return out
}

// N2 (ADR-0060): rewrite maximal runs of spelled-out number words to their
// digit value ("two hundred plus fifty" -> "200 plus 50"), leaving every other
// token (operators, filler, digits) verbatim. A text with no number word comes
// back unchanged, so digit-only inputs are byte-for-byte arithmetic-equivalent.
fn _ar_normalize_numbers(text) {
    let toks = _ar_ws_split(text)
    let n = len(toks)
    let out = ""
    let i = 0
    while i < n {
        if numw_is_number_word(toks[i]) == 1 {
            let run = _numw_run(toks, i)   // [value, next_index, consumed]
            if len(out) > 0 { out = out + " " }
            out = out + int_to_str(run[0])
            i = run[1]
        } else {
            if len(out) > 0 { out = out + " " }
            out = out + toks[i]
            i = i + 1
        }
    }
    return out
}

// arith_eval(text) -> [ok, milli, rendered]. ok=0 means "not a computable
// expression" (no operator, or division by zero); the router then routes the
// input elsewhere instead of forcing a number.
fn arith_eval(text) {
    let toks = _ar_scan(_ar_normalize_numbers(text))
    // ---- percentage form: NUM (PCT) (OF) NUM ------------------------------
    let pi = 0
    while pi < len(toks) {
        if str_eq_bytes(toks[pi][0], "op") == 1 {
            if toks[pi][1] == AR_PCT {
                // need a number immediately before, and a number after an OF.
                if pi >= 1 {
                    if _ar_is_num(toks[pi - 1]) == 1 {
                        let p = _ar_tok_val(toks[pi - 1])
                        let bj = pi + 1
                        // optional OF
                        if bj < len(toks) { if str_eq_bytes(toks[bj][0], "op") == 1 { if toks[bj][1] == AR_OF { bj = bj + 1 } } }
                        if bj < len(toks) {
                            if _ar_is_num(toks[bj]) == 1 {
                                let base = _ar_tok_val(toks[bj])
                                let res = p * base / 100 / 1000
                                return _ar_result(1, res, _ar_render(res))
                            }
                        }
                    }
                }
            }
        }
        pi = pi + 1
    }

    // ---- infix form -------------------------------------------------------
    let vals = list_new()
    let ops = list_new()
    let i = 0
    while i < len(toks) {
        let t = toks[i]
        if _ar_is_num(t) == 1 {
            push(vals, _ar_tok_val(t))
        } else if str_eq_bytes(t[0], "op") == 1 {
            let code = t[1]
            // a bare % / "of" outside the percent-of form carries no binary
            // operator -- drop it; everything else is a real operator.
            if code != AR_PCT {
                if code != AR_OF { push(ops, code) }
            }
        }
        i = i + 1
    }
    if len(vals) < 2 { return _ar_result(0, 0, "") }
    if len(ops) < 1 { return _ar_result(0, 0, "") }
    if len(ops) >= len(vals) { return _ar_result(0, 0, "") }

    // pass 1: collapse * and /
    let v2 = list_new()
    let o2 = list_new()
    push(v2, vals[0])
    let k = 0
    while k < len(ops) {
        let op = ops[k]
        let rhs = vals[k + 1]
        if op == AR_MUL {
            let last = v2[len(v2) - 1]
            list_set(v2, len(v2) - 1, _ar_mul(last, rhs))
        } else if op == AR_DIV {
            if rhs == 0 { return _ar_result(0, 0, "") }
            let last = v2[len(v2) - 1]
            list_set(v2, len(v2) - 1, _ar_div(last, rhs))
        } else {
            push(o2, op)
            push(v2, rhs)
        }
        k = k + 1
    }

    // pass 2: left-to-right + and -
    let acc = v2[0]
    let m = 0
    while m < len(o2) {
        if o2[m] == AR_ADD { acc = acc + v2[m + 1] }
        else if o2[m] == AR_SUB { acc = acc - v2[m + 1] }
        m = m + 1
    }
    return _ar_result(1, acc, _ar_render(acc))
}

fn arith_ok(r)    { return r[0] }
fn arith_value(r) { return r[1] }
fn arith_text(r)  { return r[2] }
