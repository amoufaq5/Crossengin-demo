// CrossEngin language: word atoms.
//
// Purpose
//   Word atoms are the lexical layer of knowledge (ADR-0015): each is a learned,
//   mutable atom (kind ATOM_LANG) in a standing "language" KG, keyed by its
//   normalized surface form. A word carries a lexical facet vector (for fuzzy
//   matching) and weighted cross-KG references to concept atoms in domain KGs --
//   its senses. Polysemy is just multiple sense references; the reader's context
//   bias stage selects among them (ADR-0012 stage 2). Confidence is the atom's
//   Bayesian belief, updated with use (ADR-0023); weak stale words decay and are
//   GC'd (ADR-0025).
//
//   ADR-0016 defines a single language atom kind, ATOM_LANG. ADR-0015's word /
//   phoneme / syntax distinction is recorded in the atom payload under "ltype"
//   (LWORD / LPHONEME / LSYNTAX); the constants live here and are shared by the
//   phoneme and syntax modules.
//
// ADRs implemented: ADR-0015 (language atoms - word), ADR-0016/0023 (atom +
//   belief), ADR-0017 (sense references are cross-KG edges).
// NOVA dependencies: builtins (split/str_lower/str_trim/char_at/len/str_eq).
// CrossEngin dependencies: src/kg/cross_kg_references.nova (and multi_kg,
//   atom_store).

import "../kg/cross_kg_references.nova"

// Language-atom sub-kinds (stored in payload "ltype").
let LWORD    = 1
let LPHONEME = 2
let LSYNTAX  = 3

// Spawn (or fetch) the standing language KG in a registry.
fn lang_kg_init(reg) {
    return kg_spawn(reg, "language")
}

// Normalize a surface form: trim + lowercase (the lexical key).
fn lang_normalize(form) {
    return str_lower(str_trim(form))
}

// A crude deterministic lexical embedding: each character contributes to one
// dimension, so forms sharing characters get similar vectors (fuzzy matching).
fn word_lexical_vec(form) {
    let v = vec_new(ATOM_EMBED_DIMS)
    let i = 0
    while i < len(form) {
        let d = char_at(form, i) % ATOM_EMBED_DIMS
        vec_set(v, d, vec_get(v, d) + 40)
        i = i + 1
    }
    return v
}

fn _lang_set_type(a, ltype) {
    atom_payload_set(a, "ltype", ltype)
    return a
}

fn lang_type(a) {
    if atom_kind(a) != ATOM_LANG { return 0 }
    return atom_payload_get(a, "ltype")
}

// Create a word atom (normalizing the form). Sets the lexical facet vector.
fn word_atom_new(lang_kg, form, moment) {
    let norm = lang_normalize(form)
    let a = kg_add_atom(lang_kg, ATOM_LANG, norm, moment)
    _lang_set_type(a, LWORD)
    atom_set_embed(a, word_lexical_vec(norm))
    return a
}

fn is_word_atom(a) {
    if a == 0 { return 0 }
    if atom_kind(a) != ATOM_LANG { return 0 }
    if lang_type(a) == LWORD { return 1 }
    return 0
}

fn word_form(a) { return atom_label(a) }

// Exact lookup by surface form (normalized). Returns the word atom or 0.
fn word_find(lang_kg, form) {
    let a = kg_find_atom(lang_kg, lang_normalize(form))
    if a == 0 { return 0 }
    if is_word_atom(a) == 0 { return 0 }
    return a
}

// R54: irregular lemma table -- maps a known irregular inflection to its base
// form (mice -> mouse, ran -> run, leaves -> leaf). Returns "" when `form` is
// not a listed irregular. This is exactly the data the regular suffix rules in
// word_find_morph can't derive; like those rules, the caller accepts the lemma
// ONLY if it is itself a known atom, so a listed mapping never invents a concept
// -- it reaches an existing one through an irregular inflection. Curated to the
// common English irregulars plus the Latin/Greek plurals frequent in academic
// text (not a full lemma dictionary); `form` is expected normalized (lowercase).
fn irregular_lemma(form) {
    // ---- irregular plurals (form -> singular) ----
    if str_eq(form, "mice")     == 1 { return "mouse" }
    if str_eq(form, "men")      == 1 { return "man" }
    if str_eq(form, "women")    == 1 { return "woman" }
    if str_eq(form, "children") == 1 { return "child" }
    if str_eq(form, "feet")     == 1 { return "foot" }
    if str_eq(form, "teeth")    == 1 { return "tooth" }
    if str_eq(form, "geese")    == 1 { return "goose" }
    if str_eq(form, "people")   == 1 { return "person" }
    if str_eq(form, "oxen")     == 1 { return "ox" }
    if str_eq(form, "leaves")   == 1 { return "leaf" }
    if str_eq(form, "lives")    == 1 { return "life" }
    if str_eq(form, "knives")   == 1 { return "knife" }
    if str_eq(form, "wives")    == 1 { return "wife" }
    if str_eq(form, "wolves")   == 1 { return "wolf" }
    if str_eq(form, "halves")   == 1 { return "half" }
    if str_eq(form, "calves")   == 1 { return "calf" }
    if str_eq(form, "shelves")  == 1 { return "shelf" }
    if str_eq(form, "selves")   == 1 { return "self" }
    // Latin/Greek scientific plurals (common in academic text).
    if str_eq(form, "cacti")      == 1 { return "cactus" }
    if str_eq(form, "fungi")      == 1 { return "fungus" }
    if str_eq(form, "nuclei")     == 1 { return "nucleus" }
    if str_eq(form, "radii")      == 1 { return "radius" }
    if str_eq(form, "data")       == 1 { return "datum" }
    if str_eq(form, "bacteria")   == 1 { return "bacterium" }
    if str_eq(form, "criteria")   == 1 { return "criterion" }
    if str_eq(form, "phenomena")  == 1 { return "phenomenon" }
    if str_eq(form, "indices")    == 1 { return "index" }
    if str_eq(form, "matrices")   == 1 { return "matrix" }
    if str_eq(form, "vertices")   == 1 { return "vertex" }
    if str_eq(form, "analyses")   == 1 { return "analysis" }
    if str_eq(form, "diagnoses")  == 1 { return "diagnosis" }
    if str_eq(form, "hypotheses") == 1 { return "hypothesis" }
    if str_eq(form, "theses")     == 1 { return "thesis" }
    if str_eq(form, "crises")     == 1 { return "crisis" }
    if str_eq(form, "species")    == 1 { return "species" }
    // ---- irregular verbs (past tense / past participle -> base) ----
    if str_eq(form, "ran")        == 1 { return "run" }
    if str_eq(form, "ate")        == 1 { return "eat" }
    if str_eq(form, "eaten")      == 1 { return "eat" }
    if str_eq(form, "went")       == 1 { return "go" }
    if str_eq(form, "gone")       == 1 { return "go" }
    if str_eq(form, "came")       == 1 { return "come" }
    if str_eq(form, "saw")        == 1 { return "see" }
    if str_eq(form, "seen")       == 1 { return "see" }
    if str_eq(form, "took")       == 1 { return "take" }
    if str_eq(form, "taken")      == 1 { return "take" }
    if str_eq(form, "got")        == 1 { return "get" }
    if str_eq(form, "gotten")     == 1 { return "get" }
    if str_eq(form, "gave")       == 1 { return "give" }
    if str_eq(form, "given")      == 1 { return "give" }
    if str_eq(form, "found")      == 1 { return "find" }
    if str_eq(form, "thought")    == 1 { return "think" }
    if str_eq(form, "brought")    == 1 { return "bring" }
    if str_eq(form, "bought")     == 1 { return "buy" }
    if str_eq(form, "caught")     == 1 { return "catch" }
    if str_eq(form, "taught")     == 1 { return "teach" }
    if str_eq(form, "knew")       == 1 { return "know" }
    if str_eq(form, "known")      == 1 { return "know" }
    if str_eq(form, "grew")       == 1 { return "grow" }
    if str_eq(form, "grown")      == 1 { return "grow" }
    if str_eq(form, "threw")      == 1 { return "throw" }
    if str_eq(form, "thrown")     == 1 { return "throw" }
    if str_eq(form, "drew")       == 1 { return "draw" }
    if str_eq(form, "drawn")      == 1 { return "draw" }
    if str_eq(form, "flew")       == 1 { return "fly" }
    if str_eq(form, "flown")      == 1 { return "fly" }
    if str_eq(form, "drove")      == 1 { return "drive" }
    if str_eq(form, "driven")     == 1 { return "drive" }
    if str_eq(form, "wrote")      == 1 { return "write" }
    if str_eq(form, "written")    == 1 { return "write" }
    if str_eq(form, "rose")       == 1 { return "rise" }
    if str_eq(form, "risen")      == 1 { return "rise" }
    if str_eq(form, "chose")      == 1 { return "choose" }
    if str_eq(form, "chosen")     == 1 { return "choose" }
    if str_eq(form, "spoke")      == 1 { return "speak" }
    if str_eq(form, "spoken")     == 1 { return "speak" }
    if str_eq(form, "broke")      == 1 { return "break" }
    if str_eq(form, "broken")     == 1 { return "break" }
    if str_eq(form, "froze")      == 1 { return "freeze" }
    if str_eq(form, "frozen")     == 1 { return "freeze" }
    if str_eq(form, "began")      == 1 { return "begin" }
    if str_eq(form, "begun")      == 1 { return "begin" }
    if str_eq(form, "drank")      == 1 { return "drink" }
    if str_eq(form, "drunk")      == 1 { return "drink" }
    if str_eq(form, "sang")       == 1 { return "sing" }
    if str_eq(form, "sung")       == 1 { return "sing" }
    if str_eq(form, "swam")       == 1 { return "swim" }
    if str_eq(form, "rang")       == 1 { return "ring" }
    if str_eq(form, "rung")       == 1 { return "ring" }
    if str_eq(form, "fell")       == 1 { return "fall" }
    if str_eq(form, "fallen")     == 1 { return "fall" }
    if str_eq(form, "felt")       == 1 { return "feel" }
    if str_eq(form, "kept")       == 1 { return "keep" }
    if str_eq(form, "met")        == 1 { return "meet" }
    if str_eq(form, "paid")       == 1 { return "pay" }
    if str_eq(form, "said")       == 1 { return "say" }
    if str_eq(form, "sat")        == 1 { return "sit" }
    if str_eq(form, "stood")      == 1 { return "stand" }
    if str_eq(form, "understood") == 1 { return "understand" }
    if str_eq(form, "won")        == 1 { return "win" }
    if str_eq(form, "held")       == 1 { return "hold" }
    if str_eq(form, "heard")      == 1 { return "hear" }
    if str_eq(form, "led")        == 1 { return "lead" }
    if str_eq(form, "lost")       == 1 { return "lose" }
    if str_eq(form, "sent")       == 1 { return "send" }
    if str_eq(form, "spent")      == 1 { return "spend" }
    if str_eq(form, "built")      == 1 { return "build" }
    if str_eq(form, "told")       == 1 { return "tell" }
    if str_eq(form, "sold")       == 1 { return "sell" }
    if str_eq(form, "became")     == 1 { return "become" }
    return ""
}

// R57: derivational morphology -- part-of-speech-changing suffixes, the layer
// past inflection. Given a normalized form, return the candidate base strings a
// derivation could have come from (national -> nation, biological -> biology,
// happiness -> happy, quickly -> quick). PURE: it only proposes strings; the
// caller (word_find_morph) accepts one ONLY if it is itself a known atom, so a
// noisy strip never invents a concept. Length guards keep short stems (final ->
// fin, topic -> top) from being proposed at all -- those are where over-stemming
// bites. Derivation is approximate by nature (business -> busy is etymological,
// not semantic), so it is tried LAST, after exact + inflection.
fn derive_candidates(form) {
    let n = len(form)
    let out = list_new()
    // -ical -> -y / strip  (biological -> biology / biologic; musical -> music)
    if n > 5 { if ends_with(form, "ical") == 1 {
        push(out, substr(form, 0, n - 4) + "y")
        push(out, substr(form, 0, n - 2))
    } }
    // -al -> strip / +e  (national -> nation, cultural -> culture)
    if n > 5 { if ends_with(form, "al") == 1 {
        push(out, substr(form, 0, n - 2))
        push(out, substr(form, 0, n - 2) + "e")
    } }
    // -ly / -ily  (quickly -> quick, really -> real, happily -> happy)
    if n > 4 { if ends_with(form, "ly") == 1 {
        if ends_with(form, "ily") == 1 { push(out, substr(form, 0, n - 3) + "y") }
        push(out, substr(form, 0, n - 2))
    } }
    // -ness / -iness  (darkness -> dark, happiness -> happy)
    if n > 4 { if ends_with(form, "ness") == 1 {
        if ends_with(form, "iness") == 1 { push(out, substr(form, 0, n - 5) + "y") }
        push(out, substr(form, 0, n - 4))
    } }
    // -ment  (government -> govern, movement -> move, agreement -> agree)
    if n > 5 { if ends_with(form, "ment") == 1 {
        push(out, substr(form, 0, n - 4))
    } }
    // -ful / -iful  (helpful -> help, useful -> use, beautiful -> beauty)
    if n > 4 { if ends_with(form, "ful") == 1 {
        if ends_with(form, "iful") == 1 { push(out, substr(form, 0, n - 4) + "y") }
        push(out, substr(form, 0, n - 3))
    } }
    // -ous  (dangerous -> danger, famous -> fame, nervous -> nerve)
    if n > 4 { if ends_with(form, "ous") == 1 {
        push(out, substr(form, 0, n - 3))
        push(out, substr(form, 0, n - 3) + "e")
    } }
    // -ic -> strip / -y  (atomic -> atom, historic -> history)
    if n > 5 { if ends_with(form, "ic") == 1 {
        push(out, substr(form, 0, n - 2))
        push(out, substr(form, 0, n - 2) + "y")
    } }
    // -ist -> strip / -y  (artist -> art, biologist -> biology)
    if n > 4 { if ends_with(form, "ist") == 1 {
        push(out, substr(form, 0, n - 3))
        push(out, substr(form, 0, n - 3) + "y")
    } }
    // -ility -> -le  (ability -> able, visibility -> visible)
    if n > 5 { if ends_with(form, "ility") == 1 {
        push(out, substr(form, 0, n - 5) + "le")
    } }
    // -ity -> strip / +e  (complexity -> complex, activity -> active)
    if n > 4 { if ends_with(form, "ity") == 1 {
        push(out, substr(form, 0, n - 3))
        push(out, substr(form, 0, n - 3) + "e")
    } }
    return out
}

// R62: deverbal-noun lemma table -- the -tion / -sion / -ation family R57 left
// out because its stem changes are too irregular to strip safely (creation ->
// create, decision -> decide, production -> produce, admission -> admit). A
// curated table maps each noun to its base verb/adjective explicitly, returning
// "" when the form isn't listed. Like the other tables, the caller accepts the
// base ONLY if it is itself a known atom, so a listed mapping never invents a
// concept. Non-deverbal -tion/-sion words (station, nation, condition, mission)
// are deliberately absent, so they never map. `form` is expected normalized.
fn deverbal_lemma(form) {
    // ---- -ation / -ication ----
    if str_eq(form, "creation")        == 1 { return "create" }
    if str_eq(form, "donation")        == 1 { return "donate" }
    if str_eq(form, "location")        == 1 { return "locate" }
    if str_eq(form, "education")       == 1 { return "educate" }
    if str_eq(form, "operation")       == 1 { return "operate" }
    if str_eq(form, "population")      == 1 { return "populate" }
    if str_eq(form, "relation")        == 1 { return "relate" }
    if str_eq(form, "calculation")     == 1 { return "calculate" }
    if str_eq(form, "celebration")     == 1 { return "celebrate" }
    if str_eq(form, "combination")     == 1 { return "combine" }
    if str_eq(form, "communication")   == 1 { return "communicate" }
    if str_eq(form, "concentration")   == 1 { return "concentrate" }
    if str_eq(form, "consideration")   == 1 { return "consider" }
    if str_eq(form, "declaration")     == 1 { return "declare" }
    if str_eq(form, "determination")   == 1 { return "determine" }
    if str_eq(form, "evaluation")      == 1 { return "evaluate" }
    if str_eq(form, "examination")     == 1 { return "examine" }
    if str_eq(form, "exploration")     == 1 { return "explore" }
    if str_eq(form, "explanation")     == 1 { return "explain" }
    if str_eq(form, "formation")       == 1 { return "form" }
    if str_eq(form, "generation")      == 1 { return "generate" }
    if str_eq(form, "imagination")     == 1 { return "imagine" }
    if str_eq(form, "information")     == 1 { return "inform" }
    if str_eq(form, "inspiration")     == 1 { return "inspire" }
    if str_eq(form, "interpretation")  == 1 { return "interpret" }
    if str_eq(form, "investigation")   == 1 { return "investigate" }
    if str_eq(form, "limitation")      == 1 { return "limit" }
    if str_eq(form, "motivation")      == 1 { return "motivate" }
    if str_eq(form, "observation")     == 1 { return "observe" }
    if str_eq(form, "organization")    == 1 { return "organize" }
    if str_eq(form, "participation")   == 1 { return "participate" }
    if str_eq(form, "preparation")     == 1 { return "prepare" }
    if str_eq(form, "presentation")    == 1 { return "present" }
    if str_eq(form, "realization")     == 1 { return "realize" }
    if str_eq(form, "recommendation")  == 1 { return "recommend" }
    if str_eq(form, "registration")    == 1 { return "register" }
    if str_eq(form, "regulation")      == 1 { return "regulate" }
    if str_eq(form, "reservation")     == 1 { return "reserve" }
    if str_eq(form, "separation")      == 1 { return "separate" }
    if str_eq(form, "transformation")  == 1 { return "transform" }
    if str_eq(form, "translation")     == 1 { return "translate" }
    // ---- -ction ----
    if str_eq(form, "action")          == 1 { return "act" }
    if str_eq(form, "production")      == 1 { return "produce" }
    if str_eq(form, "reduction")       == 1 { return "reduce" }
    if str_eq(form, "introduction")    == 1 { return "introduce" }
    if str_eq(form, "construction")    == 1 { return "construct" }
    if str_eq(form, "destruction")     == 1 { return "destroy" }
    if str_eq(form, "instruction")     == 1 { return "instruct" }
    if str_eq(form, "prediction")      == 1 { return "predict" }
    if str_eq(form, "protection")      == 1 { return "protect" }
    if str_eq(form, "selection")       == 1 { return "select" }
