    if str_eq(form, "adoption")        == 1 { return "adopt" }
    if str_eq(form, "assumption")      == 1 { return "assume" }
    if str_eq(form, "consumption")     == 1 { return "consume" }
    if str_eq(form, "solution")        == 1 { return "solve" }
