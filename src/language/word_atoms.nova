    if str_eq(form, "pollution")       == 1 { return "pollute" }
    if str_eq(form, "evolution")       == 1 { return "evolve" }
    if str_eq(form, "distribution")    == 1 { return "distribute" }
    if str_eq(form, "contribution")    == 1 { return "contribute" }
    if str_eq(form, "execution")       == 1 { return "execute" }
    // ---- -sion ----
    if str_eq(form, "decision")        == 1 { return "decide" }
    if str_eq(form, "division")        == 1 { return "divide" }
    if str_eq(form, "conclusion")      == 1 { return "conclude" }
    if str_eq(form, "exclusion")       == 1 { return "exclude" }
    if str_eq(form, "inclusion")       == 1 { return "include" }
    if str_eq(form, "collision")       == 1 { return "collide" }
    if str_eq(form, "explosion")       == 1 { return "explode" }
    if str_eq(form, "erosion")         == 1 { return "erode" }
    if str_eq(form, "invasion")        == 1 { return "invade" }
    if str_eq(form, "persuasion")      == 1 { return "persuade" }
    if str_eq(form, "confusion")       == 1 { return "confuse" }
    if str_eq(form, "conversion")      == 1 { return "convert" }
    if str_eq(form, "expansion")       == 1 { return "expand" }
    if str_eq(form, "extension")       == 1 { return "extend" }
    if str_eq(form, "comprehension")   == 1 { return "comprehend" }
    if str_eq(form, "suspension")      == 1 { return "suspend" }
    if str_eq(form, "admission")       == 1 { return "admit" }
    if str_eq(form, "permission")      == 1 { return "permit" }
    if str_eq(form, "transmission")    == 1 { return "transmit" }
    if str_eq(form, "emission")        == 1 { return "emit" }
    if str_eq(form, "omission")        == 1 { return "omit" }
    if str_eq(form, "submission")      == 1 { return "submit" }
    if str_eq(form, "impression")      == 1 { return "impress" }
    if str_eq(form, "expression")      == 1 { return "express" }
