    if str_eq(form, "infection")       == 1 { return "infect" }
    if str_eq(form, "objection")       == 1 { return "object" }
    if str_eq(form, "reflection")      == 1 { return "reflect" }
    if str_eq(form, "rejection")       == 1 { return "reject" }
    if str_eq(form, "attraction")      == 1 { return "attract" }
    if str_eq(form, "reaction")        == 1 { return "react" }
    // ---- -tion (misc stem changes) ----
    if str_eq(form, "completion")      == 1 { return "complete" }
