// CrossEngin language: phoneme atoms.
//
// Purpose
//   Phoneme atoms (ADR-0015) hold a sound symbol and live in the language KG as
//   ATOM_LANG atoms with payload ltype = LPHONEME. They are referenced by word
//   atoms to record pronunciation; they exist for the modality boundary only
//   (the STT/TTS adapters per ADR-0014) and never participate in cognition.
//   Phoneme symbols are case-significant (e.g. ARPABET), so unlike words they
//   are not lowercased -- only trimmed.
//
// ADRs implemented: ADR-0015 (language atoms - phoneme), ADR-0014 (phonemes are
//   modality-only).
// NOVA dependencies: builtins (str_trim, lists).
// CrossEngin dependencies: src/language/word_atoms.nova (lang KG, LPHONEME,
//   ATOM_LANG, atom payload helpers).

import "word_atoms.nova"

// Create a phoneme atom for a sound symbol (trimmed, not lowercased).
fn phoneme_atom_new(lang_kg, symbol, moment) {
    let sym = str_trim(symbol)
    let a = kg_add_atom(lang_kg, ATOM_LANG, sym, moment)
    atom_payload_set(a, "ltype", LPHONEME)
    return a
}

fn is_phoneme_atom(a) {
    if a == 0 { return 0 }
    if atom_kind(a) != ATOM_LANG { return 0 }
    if lang_type(a) == LPHONEME { return 1 }
    return 0
}

fn phoneme_symbol(a) { return atom_label(a) }

fn phoneme_find(lang_kg, symbol) {
    let a = kg_find_atom(lang_kg, str_trim(symbol))
    if is_phoneme_atom(a) == 0 { return 0 }
    return a
}

fn phoneme_intern(lang_kg, symbol, moment) {
    let existing = phoneme_find(lang_kg, symbol)
    if existing != 0 { return existing }
    return phoneme_atom_new(lang_kg, symbol, moment)
}

// Record a word's pronunciation: intern each phoneme symbol and store the
// resulting phoneme-atom id sequence in the word's payload.
fn word_set_phonemes(lang_kg, word, symbols, moment) {
    let ids = list_new()
    let i = 0
    while i < len(symbols) {
        let p = phoneme_intern(lang_kg, symbols[i], moment)
        push(ids, atom_id(p))
        i = i + 1
    }
    atom_payload_set(word, "phonemes", ids)
    return ids
}

// The phoneme-atom id sequence for a word (empty if none recorded).
fn word_phonemes(word) {
    if atom_payload_has(word, "phonemes") == 0 { return list_new() }
    return atom_payload_get(word, "phonemes")
}
