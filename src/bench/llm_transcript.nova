// Recorded LLM transcript ingestion (ADR-0086 Phase 7 support).
//
// The head-to-head benchmark (src/bench/reasoning_bench.nova) scores the engine
// against RECORDED LLM verdicts -- transcripts captured offline, never a live
// call (Rule 1 forbids calling a third-party LLM from the engine). Until now the
// comparison fed hardcoded illustrative verdicts (bench_default_pairs). This
// module lets a REAL recorded transcript, stored as a text data file, feed the
// same harness instead: one verdict per bench item id.
//
// On-disk format (data/llm_baseline_sample.txt): one record per line,
//   "<item_id> <verdict>"
// where <verdict> is the word "affirm" or "deny". Blank lines and lines whose
// first non-space character is '#' are comments and ignored. The verdict words
// map to the harness constants LLM_AFFIRM (1) / LLM_DENY (0).
//
// The file is read with the same sys_open/sys_read/sys_close whole-file pattern
// the audit decision log uses (_dl_read_text); see src/audit/decision_log.nova.
//
// NOVA dependencies: builtins + sys_open/sys_read/sys_close/O_RDONLY/alloc/store8.
// CrossEngin dependencies: none (the verdict constants 1/0 match LLM_AFFIRM /
//   LLM_DENY in reasoning_bench.nova). The only import is std/syscall, for the
//   whole-file read primitives (same as src/audit/decision_log.nova).

import "std/syscall"

// A parsed transcript is a list of [item_id, verdict] pairs. Field offsets:
let LT_ID      = 0
let LT_VERDICT = 1

// Verdict values -- deliberately equal to reasoning_bench's LLM_DENY / LLM_AFFIRM.
let LT_DENY   = 0
let LT_AFFIRM = 1

fn _lt_pair(item_id, verdict) {
    let p = list_new()
    push(p, item_id)
    push(p, verdict)
    return p
}

// Index of the first non-space character in line[start..n), or n if the line is
// all spaces. Treats space (32) and tab (9) as leading whitespace.
fn _lt_first_nonspace(line, n) {
    let i = 0
    while i < n {
        let c = char_at(line, i)
        if c == 32 {
        } else {
            if c == 9 {
            } else {
                return i
            }
        }
        i = i + 1
    }
    return n
}

// Split a line into whitespace-separated tokens (adapted from arithmetic.nova's
// _ar_ws_split; also breaks on tab so transcripts can be tab- or space-aligned).
fn _lt_ws_split(s) {
    let out = list_new()
    let n = len(s)
    let start = 0 - 1
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c == 32 {
            if start >= 0 { push(out, substr(s, start, i - start)) start = 0 - 1 }
        } else {
            if c == 9 {
                if start >= 0 { push(out, substr(s, start, i - start)) start = 0 - 1 }
            } else {
                if start < 0 { start = i }
            }
        }
        i = i + 1
    }
    if start >= 0 { push(out, substr(s, start, n - start)) }
    return out
}

// Map a verdict word to LT_AFFIRM / LT_DENY by its first character only (avoids
// str_eq): 'a' (97) -> affirm/1, anything else -> deny/0.
fn _lt_verdict_of(word) {
    if len(word) == 0 { return LT_DENY }
    if char_at(word, 0) == 97 { return LT_AFFIRM }
    return LT_DENY
}

// Parse one already-extracted line into the transcript, if it is a data line.
// Comments (first non-space char '#' = 35) and blank lines are skipped. A data
// line needs at least two whitespace tokens: id and verdict.
fn _lt_parse_line(transcript, line) {
    let n = len(line)
    let fns = _lt_first_nonspace(line, n)
    if fns >= n { return 0 }                      // blank / all-space
    if char_at(line, fns) == 35 { return 0 }      // comment '#'
    let toks = _lt_ws_split(line)
    if len(toks) < 2 { return 0 }                 // malformed -> ignore
    let item_id = str_to_int(toks[0])
    let verdict = _lt_verdict_of(toks[1])
    push(transcript, _lt_pair(item_id, verdict))
    return 1
}

// Parse a whole transcript text (newline char 10 separates lines) into a list of
// [item_id, verdict] pairs. Blank lines and '#' comment lines are skipped.
fn llm_transcript_parse(text) {
    let transcript = list_new()
    if text == 0 { return transcript }
    let n = len(text)
    let line_start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {               // newline
            _lt_parse_line(transcript, substr(text, line_start, i - line_start))
            line_start = i + 1
        }
        i = i + 1
    }
    // Trailing line with no terminating newline.
    if line_start < n {
        _lt_parse_line(transcript, substr(text, line_start, n - line_start))
    }
    return transcript
}

// Number of records (data lines) in the parsed transcript.
fn llm_transcript_count(transcript) {
    return len(transcript)
}

// The recorded verdict for item_id, or default_verdict if no record exists. Ids
// are compared with int equality via int_sub (== would structurally deref large
// values; int_sub(a,b)==0 is the safe idiom).
fn llm_verdict_for(transcript, item_id, default_verdict) {
    let i = 0
    while i < len(transcript) {
        let rec = transcript[i]
        if int_sub(rec[LT_ID], item_id) == 0 {
            return rec[LT_VERDICT]
        }
        i = i + 1
    }
    return default_verdict
}

// Read the entire file at path (whole-file sys_open/sys_read/sys_close pattern,
// mirrors _dl_read_text in src/audit/decision_log.nova) and parse it. Returns 0
// if the file cannot be read.
fn _lt_read_text(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return 0 }
    let chunk = 4096
    let buf = alloc(chunk + 1)
    let acc = ""
    let done = 0
    while done == 0 {
        let m = sys_read(fd, buf, chunk)
        if m <= 0 {
            done = 1
        } else {
            store8(buf + m, 0)
            acc = acc + buf
            if m < chunk { done = 1 }
        }
    }
    sys_close(fd)
    return acc
}

// Read + parse a transcript file. Returns 0 if the file cannot be read.
fn llm_transcript_from_file(path) {
    let text = _lt_read_text(path)
    if text == 0 { return 0 }
    return llm_transcript_parse(text)
}
