// Reasoning benchmark harness (ADR-0086 Phase 7, ADR-0093 slice 1). The thesis
// of ADR-0086 -- that the engine OUT-REASONS LLMs on objectively-checkable
// questions -- is only credible if it is measured, not asserted. This harness
// measures it on the math/logic proving ground, where "a proof is a proof".
//
// Rule 1 forbids calling a third-party LLM, so this does not run one. Instead it
// measures the property the ADR-0086 claim rests on and that next-token
// prediction CANNOT structurally guarantee:
//
//   SOUNDNESS ON CHECKABLE QUESTIONS. Presented with a mix of provable and
//   UNPROVABLE claims, the engine produces a machine-checked proof for the
//   provable ones (a checkable artifact, not a guess) and REFUSES the
//   unprovable ones -- it never manufactures a proof of a falsehood. The
//   load-bearing metric is `false_proofs`: it must be 0. An LLM asked the same
//   bank will confidently "answer" the unprovable items (its false-confident
//   rate is bounded only by its training, not by a soundness guarantee), which
//   is exactly the gap this benchmark exists to expose.
//
// A benchmark item is a question the kernel can adjudicate:
//   [id, axioms, hyps, proof, claim_term, expected]
//     proof == 0      -> the engine has no derivation; it must REFUSE.
//     expected        -> BENCH_PROVABLE / BENCH_UNPROVABLE (ground truth).
// The engine's verdict on an item is PROVEN iff verify_check accepts its proof,
// else REFUSED. The harness scores verdict vs expected.
//
// ADRs implemented: ADR-0086 (Phase 7 measurement), ADR-0093 (slice 1 bench).
// CrossEngin dependencies: src/mind/verify.nova (the kernel under test).

import "../mind/verify.nova"

let BENCH_UNPROVABLE = 0
let BENCH_PROVABLE   = 1

// One benchmark item. `proof` may be 0 (no derivation supplied -> the engine
// must refuse). `axioms` / `hyps` are the kernel inputs; `claim` is the term the
// item asserts the proof establishes; `expected` is the ground truth.
fn bench_item(id, axioms, hyps, proof, claim, expected) {
    let it = list_new()
    push(it, id)
    push(it, axioms)
    push(it, hyps)
    push(it, proof)
    push(it, claim)
    push(it, expected)
    return it
}

let BI_ID       = 0
let BI_AXIOMS   = 1
let BI_HYPS     = 2
let BI_PROOF    = 3
let BI_CLAIM    = 4
let BI_EXPECTED = 5

// The engine's verdict on one item: 1 (PROVEN) iff it supplied a derivation the
// kernel accepts, else 0 (REFUSED). A refusal is the honest answer when no proof
// is supplied OR a supplied proof fails to check -- never a guess.
fn bench_verdict(reg, item) {
    let proof = item[BI_PROOF]
    if proof == 0 { return 0 }   // no derivation -> refuse
    return verify_check(reg, item[BI_AXIOMS], item[BI_HYPS], proof, item[BI_CLAIM])
}

// ---- scorecard -------------------------------------------------------------
let SC_TOTAL       = 0   // items in the bank
let SC_PROVEN      = 1   // items the engine produced a verified proof for
let SC_REFUSED     = 2   // items the engine declined (no/failed proof)
let SC_CORRECT     = 3   // verdict matched ground truth
let SC_FALSE_PROOF = 4   // PROVEN an UNPROVABLE claim -- MUST be 0 (soundness)
let SC_MISSED      = 5   // REFUSED a PROVABLE claim (incompleteness, not unsound)

fn _bench_score_new() {
    let s = list_new()
    let i = 0
    while i < 6 { push(s, 0) i = i + 1 }
    return s
}

fn bench_total(s)       { return s[SC_TOTAL] }
fn bench_proven(s)      { return s[SC_PROVEN] }
fn bench_refused(s)     { return s[SC_REFUSED] }
fn bench_correct(s)     { return s[SC_CORRECT] }
fn bench_false_proofs(s){ return s[SC_FALSE_PROOF] }
fn bench_missed(s)      { return s[SC_MISSED] }

// Accuracy in milli (0..1000): correct / total.
fn bench_accuracy(s) {
    if s[SC_TOTAL] == 0 { return 0 }
    return s[SC_CORRECT] * 1000 / s[SC_TOTAL]
}

// Run the bank and tally the scorecard.
fn bench_run(reg, items) {
    let s = _bench_score_new()
    let i = 0
    while i < len(items) {
        let it = items[i]
        let verdict = bench_verdict(reg, it)
        let expected = it[BI_EXPECTED]
        list_set(s, SC_TOTAL, s[SC_TOTAL] + 1)
        if verdict == 1 {
            list_set(s, SC_PROVEN, s[SC_PROVEN] + 1)
            if expected == BENCH_PROVABLE {
                list_set(s, SC_CORRECT, s[SC_CORRECT] + 1)
            } else {
                // proved something that is NOT a theorem -- a soundness breach.
                list_set(s, SC_FALSE_PROOF, s[SC_FALSE_PROOF] + 1)
            }
        } else {
            list_set(s, SC_REFUSED, s[SC_REFUSED] + 1)
            if expected == BENCH_UNPROVABLE {
                list_set(s, SC_CORRECT, s[SC_CORRECT] + 1)
            } else {
                // refused a real theorem -- incompleteness (honest, still sound).
                list_set(s, SC_MISSED, s[SC_MISSED] + 1)
            }
        }
        i = i + 1
    }
    return s
}

// Render the scorecard as a plain-language report (no LLM, ADR-0013). The
// headline is the soundness line: false proofs must be zero.
fn bench_render(s) {
    let out = "reasoning benchmark (math/logic, ADR-0086 Phase 7):\n"
    out = out + "  items:        " + int_to_str(s[SC_TOTAL]) + "\n"
    out = out + "  proven:       " + int_to_str(s[SC_PROVEN])
        + " (with machine-checked proofs)\n"
    out = out + "  refused:      " + int_to_str(s[SC_REFUSED])
        + " (honest abstention)\n"
    out = out + "  correct:      " + int_to_str(s[SC_CORRECT])
        + " / " + int_to_str(s[SC_TOTAL])
        + " (accuracy " + int_to_str(bench_accuracy(s)) + " milli)\n"
    out = out + "  missed:       " + int_to_str(s[SC_MISSED])
        + " (incompleteness -- refused a true theorem)\n"
    out = out + "  FALSE PROOFS: " + int_to_str(s[SC_FALSE_PROOF])
    if s[SC_FALSE_PROOF] == 0 {
        out = out + "  <- SOUND: never proved a non-theorem\n"
    } else {
        out = out + "  <- UNSOUND: kernel bug!\n"
    }
    return out
}

// The soundness gate: 1 iff the engine produced zero false proofs over the bank.
// This is the property an LLM cannot guarantee and the benchmark's reason to
// exist; a regression here is the worst-possible failure (ADR-0088).
fn bench_is_sound(s) {
    if s[SC_FALSE_PROOF] == 0 { return 1 }
    return 0
}

// ---- a built-in bank (so /bench and a smoke test need no fixtures) ----------
//
// A representative mix across the kernel's rules: provable theorems (axiom, MP,
// AND-intro, hypothetical syllogism, biconditional) each with a valid proof, and
// UNPROVABLE claims (no proof; a bogus proof) the engine must refuse. The
// expected outcome is a perfect, SOUND scorecard.
fn _bench_ax1(t) {
    let tbl = axiom_table_new() axiom_table_add(tbl, t) return tbl
}
fn _bench_ax2(t1, t2) {
    let tbl = axiom_table_new() axiom_table_add(tbl, t1) axiom_table_add(tbl, t2)
    return tbl
}

fn bench_default_bank() {
    let items = list_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")
    // axiom.
    push(items, bench_item(1, _bench_ax1(p), hyp_new(), pf_axiom(p), p,
        BENCH_PROVABLE))
    // modus ponens.
    let pq = term_imp(p, q)
    push(items, bench_item(2, _bench_ax2(pq, p), hyp_new(),
        pf_mp(q, pf_axiom(pq), pf_axiom(p)), q, BENCH_PROVABLE))
    // and-introduction.
    let pandq = term_and(p, q)
    push(items, bench_item(3, _bench_ax2(p, q), hyp_new(),
        pf_and_i(pandq, pf_axiom(p), pf_axiom(q)), pandq, BENCH_PROVABLE))
    // hypothetical syllogism.
    let ac = term_imp(a, c)
    push(items, bench_item(4, _bench_ax2(term_imp(a, b), term_imp(b, c)),
        hyp_new(), pf_hs(ac, pf_axiom(term_imp(a, b)), pf_axiom(term_imp(b, c))),
        ac, BENCH_PROVABLE))
    // biconditional introduction.
    let ab = term_imp(a, b)
    let ba = term_imp(b, a)
    let iff = term_iff(a, b)
    push(items, bench_item(5, _bench_ax2(ab, ba), hyp_new(),
        pf_iff_i(iff, pf_axiom(ab), pf_axiom(ba)), iff, BENCH_PROVABLE))
    // unprovable: no derivation -> refuse.
    push(items, bench_item(6, axiom_table_new(), hyp_new(), 0, term_atom("z"),
        BENCH_UNPROVABLE))
    // unprovable: bogus proof (axiom p claiming q) -> kernel rejects -> refuse.
    push(items, bench_item(7, _bench_ax1(p), hyp_new(), pf_axiom(p), q,
        BENCH_UNPROVABLE))
    return items
}

// Build the bank, run it, and return the rendered scorecard string -- the
// one-call entry the chat /bench command and a smoke test share.
fn bench_default_report() {
    let reg = proof_registry_new()
    return bench_render(bench_run(reg, bench_default_bank()))
}
