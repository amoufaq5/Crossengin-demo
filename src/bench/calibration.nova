// Calibration measurement (ADR-0086). Soundness (reasoning_bench) proves the
// engine never asserts a FALSE proof. Calibration asks the complementary
// question about its GRADED beliefs: when it says "0.7", are such claims true
// ~70% of the time? An engine whose stated confidences track reality is
// trustworthy in exactly the way ADR-0086 promises ("every claim it emits is
// traceable to evidence with a stated confidence" -- and that confidence must be
// HONEST, not just present).
//
// Two standard metrics, integer-milli throughout (1.0 == 1000):
//   - Brier score: mean squared error between predicted probability and the
//     0/1 outcome. Lower is better; 0 = perfect, 1000 = maximally wrong.
//   - Expected Calibration Error (ECE): bin predictions, compare each bin's
//     mean confidence to its actual hit-rate; the count-weighted average gap.
//     ECE isolates CALIBRATION from accuracy -- an honestly-uncertain engine
//     (lots of 0.5 predictions that are right half the time) has ECE ~0 even
//     though its accuracy is only 0.5.
//
// Pure measurement -- it asserts nothing, computes over supplied [confidence,
// outcome] samples (which can be drawn from real atoms via cal_from_atoms).
//
// ADRs implemented: ADR-0086 (calibrated, measurable truth-seeking). CrossEngin
// dependencies: src/kg/atom_store.nova (atom_confidence, for cal_from_atoms).

import "../kg/atom_store.nova"

// A sample: [predicted_confidence_milli (0..1000), outcome (0 or 1)].
fn cal_sample(conf, outcome) {
    let s = list_new()
    push(s, conf)
    push(s, outcome)
    return s
}

fn _cal_conf(s)    { return s[0] }
fn _cal_outcome(s) { return s[1] }

// Brier score in milli: mean over samples of (p - o)^2, where p is the milli
// confidence and o is 0 or 1000. Scaled back to the 0..1000 range. 0 is perfect.
fn cal_brier(samples) {
    let n = len(samples)
    if n == 0 { return 0 }
    let sum = 0
    let i = 0
    while i < n {
        let p = _cal_conf(samples[i])
        let o = _cal_outcome(samples[i]) * 1000          // 0 or 1000
        let err = p - o
        sum = sum + err * err                             // <= 1e6 per sample
        i = i + 1
    }
    // mean(err^2) is in milli^2; divide by 1000 to return milli-scale Brier.
    return sum / n / 1000
}

// 10 reliability bins of width 100 milli. Returns [count, sum_conf, sum_hits]
// triples per bin so ECE / a reliability table can be derived.
fn _cal_bins(samples) {
    let cnt = list_new()
    let sump = list_new()
    let sumo = list_new()
    let b = 0
    while b < 10 { push(cnt, 0) push(sump, 0) push(sumo, 0) b = b + 1 }
    let i = 0
    while i < len(samples) {
        let p = _cal_conf(samples[i])
        let bin = p / 100
        if bin > 9 { bin = 9 }
        list_set(cnt, bin, cnt[bin] + 1)
        list_set(sump, bin, sump[bin] + p)
        list_set(sumo, bin, sumo[bin] + _cal_outcome(samples[i]))
        i = i + 1
    }
    let out = list_new()
    push(out, cnt) push(out, sump) push(out, sumo)
    return out
}

// Expected Calibration Error in milli: count-weighted mean over non-empty bins
// of |mean_confidence - actual_hit_rate|.
fn cal_ece(samples) {
    let n = len(samples)
    if n == 0 { return 0 }
    let bins = _cal_bins(samples)
    let cnt = bins[0]
    let sump = bins[1]
    let sumo = bins[2]
    let ece = 0
    let b = 0
    while b < 10 {
        let c = cnt[b]
        if c > 0 {
            let mean_pred = sump[b] / c                   // milli
            let mean_act = sumo[b] * 1000 / c             // hit-rate in milli
            let diff = mean_pred - mean_act
            if diff < 0 { diff = 0 - diff }
            ece = ece + diff * c / n
        }
        b = b + 1
    }
    return ece
}

// Accuracy in milli: fraction of samples whose thresholded prediction (conf >=
// 500 means "predict true") matches the outcome.
fn cal_accuracy(samples) {
    let n = len(samples)
    if n == 0 { return 0 }
    let correct = 0
    let i = 0
    while i < n {
        let predict_true = 0
        if _cal_conf(samples[i]) >= 500 { predict_true = 1 }
        if predict_true == _cal_outcome(samples[i]) { correct = correct + 1 }
        i = i + 1
    }
    return correct * 1000 / n
}

// Build samples from real atoms: `pairs` is a list of [atom, outcome] where
// outcome is the ground-truth 0/1; the prediction is the atom's current belief
// (atom_confidence). Lets calibration be measured over the engine's actual
// graded knowledge, not just synthetic numbers.
fn cal_from_atoms(pairs) {
    let out = list_new()
    let i = 0
    while i < len(pairs) {
        let atom = pairs[i][0]
        let outcome = pairs[i][1]
        push(out, cal_sample(atom_confidence(atom), outcome))
        i = i + 1
    }
    return out
}

// Plain-language report (no LLM, ADR-0013): Brier, ECE, accuracy, and the
// headline reading. Lower Brier/ECE = better; ECE near 0 means the stated
// confidences are honest.
fn cal_render(samples) {
    let out = "calibration over " + int_to_str(len(samples)) + " sample(s):\n"
    out = out + "  Brier:    " + int_to_str(cal_brier(samples))
        + " milli (0 = perfect, lower better)\n"
    out = out + "  ECE:      " + int_to_str(cal_ece(samples))
        + " milli (calibration gap; ~0 = honest confidences)\n"
    out = out + "  accuracy: " + int_to_str(cal_accuracy(samples)) + " milli\n"
    return out
}
