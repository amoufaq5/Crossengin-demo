// Extended reasoning benchmark bank (ADR-0086 Phase 7, ADR-0093). A LARGER, more
// diverse companion to reasoning_bench.nova's bench_default_bank(): ~24 items
// spanning ground arithmetic, propositional logic, and first-order quantifiers,
// each adjudicable by the kernel (src/mind/verify.nova). The point is unchanged
// from the default bank -- a SOUND scorecard with ZERO false proofs -- but the
// wider coverage exercises every kernel rule on a more representative sample.
//
// Each PROVABLE item carries a real, kernel-valid proof object (verify_check
// accepts it). Each UNPROVABLE item carries either no proof (0, the engine must
// refuse) or a bogus proof the kernel rejects. Ground truth (expected) is the
// mathematical/logical fact; the bench scores the engine's verdict against it.
//
// ADRs implemented: ADR-0086 (Phase 7 measurement), ADR-0093 (math/logic bank).
// CrossEngin dependencies: src/bench/reasoning_bench.nova (the harness +
//   bench_item shape) and, transitively, src/mind/verify.nova (the kernel).

import "reasoning_bench.nova"

// Single-axiom table (mirrors reasoning_bench's _bench_ax1; redefined locally so
// this module imports only public bench/kernel constructors).
fn _ext_ax1(t) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t)
    return tbl
}

fn _ext_ax2(t1, t2) {
    let tbl = axiom_table_new()
    axiom_table_add(tbl, t1)
    axiom_table_add(tbl, t2)
    return tbl
}

// The extended bank. Distinct integer ids 101.. so they never collide with the
// default bank's 1..12 (a transcript can carry both banks unambiguously).
fn bench_ext_bank() {
    let items = list_new()
    let p = term_atom("p")
    let q = term_atom("q")
    let r = term_atom("r")
    let a = term_atom("a")
    let b = term_atom("b")
    let c = term_atom("c")

    // ---- ground arithmetic (decided by EVAL) -------------------------------
    // 101: 12 + 30 = 42  -> PROVABLE.
    let add1 = term_equals(term_add(term_num(12), term_num(30)), term_num(42))
    push(items, bench_item(101, axiom_table_new(), hyp_new(), pf_eval(add1), add1,
        BENCH_PROVABLE))
    // 102: 100 - 58 = 42 -> PROVABLE.
    let sub1 = term_equals(term_sub(term_num(100), term_num(58)), term_num(42))
    push(items, bench_item(102, axiom_table_new(), hyp_new(), pf_eval(sub1), sub1,
        BENCH_PROVABLE))
    // 103: 6 * 7 = 42 -> PROVABLE.
    let mul1 = term_equals(term_mul(term_num(6), term_num(7)), term_num(42))
    push(items, bench_item(103, axiom_table_new(), hyp_new(), pf_eval(mul1), mul1,
        BENCH_PROVABLE))
    // 104: 84 / 2 = 42 (exact) -> PROVABLE.
    let div1 = term_equals(term_div(term_num(84), term_num(2)), term_num(42))
    push(items, bench_item(104, axiom_table_new(), hyp_new(), pf_eval(div1), div1,
        BENCH_PROVABLE))
    // 105: nested (2 + 3) * 4 = 20 -> PROVABLE.
    let nest1 = term_equals(
        term_mul(term_add(term_num(2), term_num(3)), term_num(4)), term_num(20))
    push(items, bench_item(105, axiom_table_new(), hyp_new(), pf_eval(nest1), nest1,
        BENCH_PROVABLE))
    // 106: FALSE equality 6 * 7 = 41 -> UNPROVABLE (EVAL recomputes, refuses).
    let mulbad = term_equals(term_mul(term_num(6), term_num(7)), term_num(41))
    push(items, bench_item(106, axiom_table_new(), hyp_new(), pf_eval(mulbad), mulbad,
        BENCH_UNPROVABLE))
    // 107: INEXACT division 7 / 2 = 3 -> UNPROVABLE (engine refuses to round).
    let divbad = term_equals(term_div(term_num(7), term_num(2)), term_num(3))
    push(items, bench_item(107, axiom_table_new(), hyp_new(), pf_eval(divbad), divbad,
        BENCH_UNPROVABLE))
    // 108: FALSE subtraction 10 - 3 = 6 -> UNPROVABLE.
    let subbad = term_equals(term_sub(term_num(10), term_num(3)), term_num(6))
    push(items, bench_item(108, axiom_table_new(), hyp_new(), pf_eval(subbad), subbad,
        BENCH_UNPROVABLE))

    // ---- propositional logic -----------------------------------------------
    // 109: AXIOM p -> PROVABLE.
    push(items, bench_item(109, _ext_ax1(p), hyp_new(), pf_axiom(p), p,
        BENCH_PROVABLE))
    // 110: MP, (p->q), p |- q -> PROVABLE.
    let pq = term_imp(p, q)
    push(items, bench_item(110, _ext_ax2(pq, p), hyp_new(),
        pf_mp(q, pf_axiom(pq), pf_axiom(p)), q, BENCH_PROVABLE))
    // 111: AND-intro, p, q |- (p and q) -> PROVABLE.
    let pandq = term_and(p, q)
    push(items, bench_item(111, _ext_ax2(p, q), hyp_new(),
        pf_and_i(pandq, pf_axiom(p), pf_axiom(q)), pandq, BENCH_PROVABLE))
    // 112: AND-elim left, (p and q) |- p -> PROVABLE.
    push(items, bench_item(112, _ext_ax1(pandq), hyp_new(),
        pf_and_el(p, pf_axiom(pandq)), p, BENCH_PROVABLE))
    // 113: AND-elim right, (p and q) |- q -> PROVABLE.
    push(items, bench_item(113, _ext_ax1(pandq), hyp_new(),
        pf_and_er(q, pf_axiom(pandq)), q, BENCH_PROVABLE))
    // 114: OR-intro left, p |- (p or q) -> PROVABLE.
    let porq = term_or(p, q)
    push(items, bench_item(114, _ext_ax1(p), hyp_new(),
        pf_or_il(porq, pf_axiom(p)), porq, BENCH_PROVABLE))
    // 115: OR-intro right, q |- (p or q) -> PROVABLE.
    push(items, bench_item(115, _ext_ax1(q), hyp_new(),
        pf_or_ir(porq, pf_axiom(q)), porq, BENCH_PROVABLE))
    // 116: IFF-intro, (a->b),(b->a) |- (a iff b) -> PROVABLE.
    let ab = term_imp(a, b)
    let ba = term_imp(b, a)
    let iff = term_iff(a, b)
    push(items, bench_item(116, _ext_ax2(ab, ba), hyp_new(),
        pf_iff_i(iff, pf_axiom(ab), pf_axiom(ba)), iff, BENCH_PROVABLE))
    // 117: IFF-elim left, (a iff b) |- (a->b) -> PROVABLE.
    push(items, bench_item(117, _ext_ax1(iff), hyp_new(),
        pf_iff_el(ab, pf_axiom(iff)), ab, BENCH_PROVABLE))
    // 118: HS chain, (a->b),(b->c) |- (a->c) -> PROVABLE.
    let ac = term_imp(a, c)
    push(items, bench_item(118, _ext_ax2(term_imp(a, b), term_imp(b, c)),
        hyp_new(), pf_hs(ac, pf_axiom(term_imp(a, b)), pf_axiom(term_imp(b, c))),
        ac, BENCH_PROVABLE))
    // 119: NON-entailed goal, no derivation supplied -> UNPROVABLE (refuse).
    push(items, bench_item(119, _ext_ax1(p), hyp_new(), 0, r, BENCH_UNPROVABLE))
    // 120: BOGUS proof, axiom-of-p claiming q -> kernel rejects -> UNPROVABLE.
    push(items, bench_item(120, _ext_ax1(p), hyp_new(), pf_axiom(p), q,
        BENCH_UNPROVABLE))

    // ---- first-order quantifiers -------------------------------------------
    // 121: UI, forall x.P(x) |- P(a) -> PROVABLE.
    let allP = term_forall("x", term_pred("P", term_var("x")))
    let pa = term_pred("P", term_atom("a"))
    push(items, bench_item(121, _ext_ax1(allP), hyp_new(),
        pf_ui(pa, pf_axiom(allP), term_atom("a")), pa, BENCH_PROVABLE))
    // 122: syllogism (UI then MP): forall x.(human(x)->mortal(x)),
    //      human(socrates) |- mortal(socrates) -> PROVABLE.
    let law = term_forall("x", term_imp(term_pred("human", term_var("x")),
                                        term_pred("mortal", term_var("x"))))
    let human_soc = term_pred("human", term_atom("socrates"))
    let inst = term_imp(term_pred("human", term_atom("socrates")),
                        term_pred("mortal", term_atom("socrates")))
    let mortal_soc = term_pred("mortal", term_atom("socrates"))
    let ui_soc = pf_ui(inst, pf_axiom(law), term_atom("socrates"))
    let mp_soc = pf_mp(mortal_soc, ui_soc, pf_axiom(human_soc))
    push(items, bench_item(122, _ext_ax2(law, human_soc), hyp_new(),
        mp_soc, mortal_soc, BENCH_PROVABLE))
    // 123: EI, P(a) |- exists x.P(x) -> PROVABLE.
    let exP = term_exists("x", term_pred("P", term_var("x")))
    push(items, bench_item(123, _ext_ax1(pa), hyp_new(),
        pf_ei(exP, pf_axiom(pa), term_atom("a")), exP, BENCH_PROVABLE))
    // 124: UG derivation, forall x.(P(x)->Q(x)), forall x.P(x) |- forall x.Q(x).
    //      UI both at fresh c, MP for Q(c), then UG -> PROVABLE.
    let allPQ = term_forall("x", term_imp(term_pred("P", term_var("x")),
                                          term_pred("Q", term_var("x"))))
    let cc = term_atom("c")
    let pcqc = term_imp(term_pred("P", cc), term_pred("Q", cc))
    let ui1 = pf_ui(pcqc, pf_axiom(allPQ), cc)
    let pc = term_pred("P", cc)
    let ui2 = pf_ui(pc, pf_axiom(allP), cc)
    let qc = term_pred("Q", cc)
    let mp_ug = pf_mp(qc, ui1, ui2)
    let allQ = term_forall("x", term_pred("Q", term_var("x")))
    let ug = pf_ug(allQ, mp_ug, cc)
    push(items, bench_item(124, _ext_ax2(allPQ, allP), hyp_new(), ug, allQ,
        BENCH_PROVABLE))
    // 125: WRONG instantiation goal, forall x.P(x) |- Q(a) with a bogus EI/UI:
    //      claim P(b) but the only fact is forall x.P(x); supply no proof ->
    //      UNPROVABLE (refuse). (Q(a) is simply not entailed.)
    let qa = term_pred("Q", term_atom("a"))
    push(items, bench_item(125, _ext_ax1(allP), hyp_new(), 0, qa, BENCH_UNPROVABLE))
    // 126: NO fact, claim exists x.P(x) with a BOGUS EI whose witness proof is an
    //      axiom Q(a) (kernel: witness's conclusion must be P(a)) -> rejected ->
    //      UNPROVABLE.
    let qa2 = term_pred("Q", term_atom("a"))
    let bogus_ei = pf_ei(exP, pf_axiom(qa2), term_atom("a"))
    push(items, bench_item(126, _ext_ax1(qa2), hyp_new(), bogus_ei, exP,
        BENCH_UNPROVABLE))

    return items
}

// Build the extended bank, run it, return the rendered scorecard string (reuses
// reasoning_bench's bench_run / bench_render verbatim).
fn bench_ext_report() {
    let reg = proof_registry_new()
    return bench_render(bench_run(reg, bench_ext_bank()))
}
