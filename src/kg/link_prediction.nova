// CrossEngin knowledge: link prediction over KG xref structure (R18B).
//
// Purpose
//   The KG read story already covers retrieval (exact lookup, episodic
//   recall R6F/R8F, TF-IDF R10C, LSH ANN P3.4), clustering (LPA R11F,
//   Louvain R12C), centrality (PageRank R13E), and declarative queries
//   (mini-SPARQL R15D + OPTIONAL/UNION/ORDER BY R16F + COUNT/SUM/AVG
//   GROUP BY R17E). The missing piece is LINK PREDICTION: given two
//   atoms u, v that are NOT currently linked, score how likely they
//   SHOULD be linked based on the neighbourhood structure of the link
//   graph. This is the canonical "edge completion" question -- analogous
//   to "people you may know" on a social graph or "missing edges" on a
//   citation graph.
//
//   Link prediction LIVES BESIDE clustering + centrality -- they answer
//   complementary questions:
//     - Clustering -> "which atoms hang together as a group?"
//     - PageRank   -> "which atoms are individually most important?"
//     - LinkPred   -> "which UNFORMED edges should exist?"
//
// Algorithms (Liben-Nowell + Kleinberg 2003, "The Link Prediction
//   Problem for Social Networks"; Adamic + Adar 2003 "Friends and
//   neighbors on the Web"). All three are integer-friendly neighbourhood
//   overlap scores; all run in O(deg_u * deg_v) per pair.
//
//   1. Common Neighbors (CN):
//        CN(u, v) = |N(u) intersect N(v)|
//      Simple count of shared neighbours. Returns an integer.
//
//   2. Jaccard (J):
//        J(u, v) = |N(u) intersect N(v)| / |N(u) union N(v)|
//      Proportion of shared neighbours, in milli units (0..1000).
//      Identical neighbour sets give 1000; disjoint give 0.
//
//   3. Adamic-Adar (AA):
//        AA(u, v) = SUM over w in N(u) intersect N(v) of 1 / log(deg(w))
//      Weighted by inverse log-degree of the shared neighbour. A rare
//      neighbour (low degree) carries more signal than a hub (high
//      degree) -- a celebrity following 10,000 people is a much weaker
//      indicator of similarity than a colleague following 5 people who
//      both happen to be u and v. Returned in milli units (scaled by
//      1000) and accumulated as int_milli. log is integer log2 (cheap,
//      monotone, monotone-equivalent to natural log for ranking
//      purposes -- the ranking under log2 matches the ranking under ln
//      exactly).
//
//   All three operate on the UNDIRECTED link graph: an xref u -> v means
//   {u, v} are neighbours regardless of direction. This matches every
//   classical formulation. Cross-KG edges are dropped (link prediction
//   is intra-KG only here, like R11F/R12C/R13E).
//
// Determinism
//   No randomness. Same KG snapshot -> bit-identical scores. The
//   neighbour-extraction walks atoms in id-ascending order; ties in
//   top-K are broken by ASCENDING atom_id (matches PR's discipline).
//
// Edge cases
//   - Disconnected atoms (no shared neighbours): CN = 0, J = 0, AA = 0.
//   - u == v: skipped (a self-pair is not a candidate edge).
//   - Atom already linked to candidate: returned with its score (caller
//     filters if "missing edges only" is desired; top_k DOES filter
//     existing-edges out by default since the call's purpose is to
//     surface unformed edges).
//   - Adamic-Adar shared neighbour with degree <= 1: log2(1) == 0 would
//     divide by zero; we clamp the log term to >= 1 so a degree-1
//     neighbour still contributes 1000 milli (its inverse-log weight is
//     maximally informative -- the only person it knows is u, so its
//     vote for v is very strong).
//
// Result layout (lp_top_k output entry):
//   [target_atom_id, score_milli]
//   Sorted by score DESCENDING, ties broken by ASCENDING target_atom_id.
//   For CN, "score_milli" carries the raw integer count (not multiplied
//   by 1000) -- callers should treat the field as "raw score" whose
//   units depend on the method. lp_predict_top_k documents this.
//
// ADRs implemented: ADR-0016 (atom xrefs are the link graph), ADR-0049
//   (testing). Companion to R11F (LPA), R12C (Louvain), R13E (PageRank).
// NOVA dependencies: builtins (lists, push, list_set, len, int_mul,
//   int_div, int_add); std/io + std/string for the chat dispatch.
// CrossEngin dependencies: src/kg/atom_store.nova (atom_id, atom_xrefs),
//   src/kg/multi_kg_manager.nova (kg_atoms, kg_label, kg_atom),
//   src/kg/cross_kg_references.nova (xref_*).

import "std/io"
import "std/string"
import "atom_store.nova"
import "multi_kg_manager.nova"
import "cross_kg_references.nova"

// ---- method codes ---------------------------------------------------------
let LP_CN      = 1   // Common Neighbors (raw count)
let LP_JACCARD = 2   // Jaccard similarity (milli)
let LP_AA      = 3   // Adamic-Adar (milli)

// ---- tuning ---------------------------------------------------------------
let LP_DEFAULT_TOP_K = 5

// ---- result-tag (distinct from PR_OBJ_TAG=2201, LV=2101, GC=2001) ---------
let LP_OBJ_TAG = 2301

// ---- integer log2 (floor) -------------------------------------------------
//
// floor(log2(n)) via bit-walk. We only need log2 for the Adamic-Adar
// inverse weight; the relative ranking under log2 is identical to the
// ranking under any other base, and AA is used for ORDERING candidates,
// not absolute physics. The ceiling is 30 -- a NOVA-side integer is
// safely 32-bit signed, so deg > 2^30 never appears in practice. We
// clamp the result to >= 1 so the divide-by-log in adamic_adar's inner
// loop never hits zero on a degree-1 neighbour (the inverse weight
// becomes maximally informative, which is the intended semantics).
//
// Examples:
//   _lp_int_log2(1)   = 0 (clamped up to 1 by callers)
//   _lp_int_log2(2)   = 1
//   _lp_int_log2(3)   = 1 (floor)
//   _lp_int_log2(4)   = 2
//   _lp_int_log2(8)   = 3
//   _lp_int_log2(100) = 6
fn _lp_int_log2(n) {
    if n <= 1 { return 0 }
    let r = 0
    let x = n
    while x > 1 {
        x = int_div(x, 2)
        r = r + 1
    }
    return r
}

// log2 clamped to >= 1; suitable as the divisor in AA's inverse weight.
fn _lp_log2_clamped(deg) {
    let lg = _lp_int_log2(deg)
    if lg < 1 { return 1 }
    return lg
}

// ---- adjacency extraction -------------------------------------------------
//
// Build an UNDIRECTED neighbour table indexed by atom_id (dense slot
// order, like R11F/R12C). For each live atom slot i, neighbours[i] is
// the sorted-ascending deduped list of atom_ids j that share an xref
// with i in either direction. Cross-KG xrefs are dropped.
//
// We don't deduplicate the in-memory slot list against the KG's live
// atoms list -- atom_id is dense (slot index by construction in
// kg_add_atom), so atom_id IS the slot. Dead slots (zeroed by
// kg_remove_atom) yield an empty neighbour list at that index.
//
// Returns a list-of-lists of length n_raw (len(kg_atoms)). Callers
// must validate atom_id < n_raw before indexing.
fn _lp_extract_neighbors(kg) {
    let atoms = kg_atoms(kg)
    let my_kg_label = kg_label(kg)
    let n_raw = len(atoms)

    // Allocate empty neighbour list per slot.
    let nbrs = list_new()
    let i = 0
    while i < n_raw {
        push(nbrs, list_new())
        i = i + 1
    }

    // Walk every live atom's xrefs and populate BOTH endpoints.
    // Dedupe via _lp_nbr_add so a duplicate xref or a back-edge in
    // the same KG doesn't double-count.
    let k = 0
    while k < n_raw {
        let a = atoms[k]
        if a != 0 {
            let src_id = atom_id(a)
            if src_id == k {
                let xs = atom_xrefs(a)
                let xi = 0
                while xi < len(xs) {
                    let x = xs[xi]
                    let dst_kg = xref_dst_kg(x)
                    let dst_id = xref_dst_atom(x)
                    if str_eq(dst_kg, my_kg_label) == 1 {
                        if dst_id >= 0 {
                            if dst_id < n_raw {
                                let dst_a = atoms[dst_id]
                                if dst_a != 0 {
                                    if dst_id != src_id {
                                        _lp_nbr_add(nbrs[src_id], dst_id)
                                        _lp_nbr_add(nbrs[dst_id], src_id)
                                    }
                                }
                            }
                        }
                    }
                    xi = xi + 1
                }
            }
        }
        k = k + 1
    }
    return nbrs
}

// Idempotent neighbour-list append: returns 1 if newly added, 0 if
// already present. Same pattern as R11F's _gc_neighbour_add and R13E's
// _pr_nbr_dedup -- duplicated here so link_prediction stays a leaf and
// doesn't pull its R11F/R13E siblings as imports.
fn _lp_nbr_add(nbrs, idx) {
    let i = 0
    while i < len(nbrs) {
        if nbrs[i] == idx { return 0 }
        i = i + 1
    }
    push(nbrs, idx)
    return 1
}

// Validate atom_id and return its neighbour list; 0 (the falsy sentinel)
// if the id is out of range or the slot is dead. Internal helper.
fn _lp_get_nbrs(nbrs_table, atom_id_in) {
    if atom_id_in < 0 { return 0 }
    if atom_id_in >= len(nbrs_table) { return 0 }
    return nbrs_table[atom_id_in]
}

// Count |A intersect B| via two-list scan. Lists are NOT sorted (we
// dedupe at insert but never sort), so we do an O(|A| * |B|) scan.
// Typical degrees in KGs are < 50; this is microseconds. Mirrors the
// _gc_neighbour_add idiom -- simpler than maintaining a separate sort.
fn _lp_intersect_size(a, b) {
    let count = 0
    let i = 0
    while i < len(a) {
        let av = a[i]
        let j = 0
        let found = 0
        while j < len(b) {
            if found == 0 {
                if b[j] == av { found = 1 }
            }
            j = j + 1
        }
        if found == 1 { count = count + 1 }
        i = i + 1
    }
    return count
}

// Count |A union B| = |A| + |B| - |A intersect B|. We pass the
// intersection size in to save the second scan when the caller already
// computed it (Jaccard always wants both numbers).
fn _lp_union_size(a, b, intersect_n) {
    return len(a) + len(b) - intersect_n
}

// Visit each w in (A intersect B) and call back with w. Returns the
// number of visits made. Used by Adamic-Adar's accumulation loop --
// inlined here because NOVA has no closures.
fn _lp_aa_score(a, b, nbrs_table) {
    let acc_milli = 0
    let i = 0
    while i < len(a) {
        let w = a[i]
        let j = 0
        let found = 0
        while j < len(b) {
            if found == 0 {
                if b[j] == w { found = 1 }
            }
            j = j + 1
        }
        if found == 1 {
            // deg(w) is len(nbrs_table[w]); fall back to 0 if w is
            // somehow out of range (shouldn't happen since w came from
            // A which IS nbrs_table[u]).
            let deg_w = 0
            if w >= 0 {
                if w < len(nbrs_table) {
                    deg_w = len(nbrs_table[w])
                }
            }
            // Inverse log2 weight in milli: 1000 / max(log2(deg_w), 1).
            let denom = _lp_log2_clamped(deg_w)
            let weight = int_div(1000, denom)
            acc_milli = int_add(acc_milli, weight)
        }
        i = i + 1
    }
    return acc_milli
}

// ---- public API: pairwise scores -----------------------------------------

// Common Neighbors: |N(u) intersect N(v)|. Returns a raw integer count
// (NOT scaled to milli). Returns 0 for any invalid/missing atom.
fn lp_common_neighbors(kg, u_id, v_id) {
    if u_id == v_id { return 0 }
    let nbrs = _lp_extract_neighbors(kg)
    let nu = _lp_get_nbrs(nbrs, u_id)
    let nv = _lp_get_nbrs(nbrs, v_id)
    if nu == 0 { return 0 }
    if nv == 0 { return 0 }
    return _lp_intersect_size(nu, nv)
}

// Jaccard: |N(u) intersect N(v)| / |N(u) union N(v)|, in milli (0..1000).
// Identical neighbour sets -> 1000; disjoint -> 0; empty u or v -> 0.
fn lp_jaccard(kg, u_id, v_id) {
    if u_id == v_id { return 0 }
    let nbrs = _lp_extract_neighbors(kg)
    let nu = _lp_get_nbrs(nbrs, u_id)
    let nv = _lp_get_nbrs(nbrs, v_id)
    if nu == 0 { return 0 }
    if nv == 0 { return 0 }
    let inter = _lp_intersect_size(nu, nv)
    let uni = _lp_union_size(nu, nv, inter)
    if uni <= 0 { return 0 }
    // Scale numerator to milli BEFORE the divide so integer truncation
    // doesn't collapse small ratios to 0. int_mul / int_div route past
    // the codegen smart-op threshold safely (inter <= max degree <= ~1k,
    // so inter * 1000 stays below 2^20).
    return int_div(int_mul(inter, 1000), uni)
}

// Adamic-Adar: SUM over w in N(u) intersect N(v) of 1 / log2(deg(w)),
// in milli units (the per-term weight is 1000 / max(log2(deg(w)), 1) so
// each contribution is bounded by 1000 milli; accumulation is bounded
// by 1000 * |intersect|). Returns 0 for any invalid/missing atom or no
// shared neighbours.
fn lp_adamic_adar(kg, u_id, v_id) {
    if u_id == v_id { return 0 }
    let nbrs = _lp_extract_neighbors(kg)
    let nu = _lp_get_nbrs(nbrs, u_id)
    let nv = _lp_get_nbrs(nbrs, v_id)
    if nu == 0 { return 0 }
    if nv == 0 { return 0 }
    return _lp_aa_score(nu, nv, nbrs)
}

// ---- public API: top-K candidate edges -----------------------------------

// Whether u_id and v_id are already linked in the neighbour table.
// O(deg) lookup; used by lp_predict_top_k to filter existing edges out.
fn _lp_is_linked(nbrs_table, u_id, v_id) {
    if u_id < 0 { return 0 }
    if u_id >= len(nbrs_table) { return 0 }
    let nu = nbrs_table[u_id]
    let i = 0
    while i < len(nu) {
        if nu[i] == v_id { return 1 }
        i = i + 1
    }
    return 0
}

// Compute one score for the (source, target) pair under the requested
// method, given precomputed neighbour lists. Internal helper that
// avoids re-running _lp_extract_neighbors for every candidate.
fn _lp_score_pair(nbrs_table, source_id, target_id, method) {
    let nu = _lp_get_nbrs(nbrs_table, source_id)
    let nv = _lp_get_nbrs(nbrs_table, target_id)
    if nu == 0 { return 0 }
    if nv == 0 { return 0 }
    if method == LP_CN {
        return _lp_intersect_size(nu, nv)
    }
    if method == LP_JACCARD {
        let inter = _lp_intersect_size(nu, nv)
        let uni = _lp_union_size(nu, nv, inter)
        if uni <= 0 { return 0 }
        return int_div(int_mul(inter, 1000), uni)
    }
    if method == LP_AA {
        return _lp_aa_score(nu, nv, nbrs_table)
    }
    return 0
}

// Top-K candidate edges from `source_atom_id` ranked by the chosen
// scoring method. Excludes:
//   - source_atom_id itself,
//   - atoms already linked to source (so the output is candidates for
//     NEW edges, the canonical link-prediction question),
//   - dead atoms (zeroed slots in kg_atoms),
//   - atoms with score = 0 (no neighbourhood overlap).
//
// Returns a list of [target_atom_id, score] pairs, sorted by score
// DESCENDING, ties broken by ASCENDING target_atom_id. K <= 0 returns
// empty.
fn lp_predict_top_k(kg, source_atom_id, k, score_fn) {
    let out = list_new()
    if k <= 0 { return out }

    let nbrs = _lp_extract_neighbors(kg)
    let n_raw = len(nbrs)
    if source_atom_id < 0 { return out }
    if source_atom_id >= n_raw { return out }
    // Source slot must be live.
    let atoms = kg_atoms(kg)
    if atoms[source_atom_id] == 0 { return out }

    // Score every candidate target. Accumulate [score, target_id]
    // pairs (score first so it lines up with the insertion-sort key).
    let pairs = list_new()
    let t = 0
    while t < n_raw {
        if t != source_atom_id {
            if atoms[t] != 0 {
                if _lp_is_linked(nbrs, source_atom_id, t) == 0 {
                    let s = _lp_score_pair(nbrs, source_atom_id, t, score_fn)
                    if s > 0 {
                        let pair = list_new()
                        push(pair, s)
                        push(pair, t)
                        push(pairs, pair)
                    }
                }
            }
        }
        t = t + 1
    }

    // Insertion sort descending by score; ties break by ASCENDING
    // target_id (same pattern as PR's pagerank_top_k).
    let m = len(pairs)
    let j = 1
    while j < m {
        let cur = pairs[j]
        let p = j - 1
        let placed = 0
        while p >= 0 {
            if placed == 0 {
                let prev = pairs[p]
                let take = 0
                if prev[0] < cur[0] {
                    take = 1
                } else {
                    if prev[0] == cur[0] {
                        if prev[1] > cur[1] { take = 1 }
                    }
                }
                if take == 1 {
                    list_set(pairs, p + 1, prev)
                    p = p - 1
                } else {
                    list_set(pairs, p + 1, cur)
                    placed = 1
                    p = 0 - 1
                }
            }
        }
        if placed == 0 { list_set(pairs, 0, cur) }
        j = j + 1
    }

    // Emit top-min(k, m) as [target_id, score] pairs (canonical order
    // mirrors PR's emit shape: id first, then score).
    let kk = k
    if kk > m { kk = m }
    let r = 0
    while r < kk {
        let entry = list_new()
        push(entry, pairs[r][1])
        push(entry, pairs[r][0])
        push(out, entry)
        r = r + 1
    }
    return out
}

// ---- introspection helpers -----------------------------------------------

// Translate a method code into a short name for the emit-line.
fn lp_method_name(method) {
    if method == LP_CN      { return "cn" }
    if method == LP_JACCARD { return "jaccard" }
    if method == LP_AA      { return "aa" }
    return "?"
}

// Translate a method-name string from the chat arg into a method code.
// Returns 0 (invalid) on unknown names; callers map that back to the
// default. Accepted names: "cn", "common", "jaccard", "j", "aa",
// "adamic", "adamic_adar".
fn lp_method_parse(name) {
    if str_eq(name, "cn") == 1       { return LP_CN }
    if str_eq(name, "common") == 1   { return LP_CN }
    if str_eq(name, "jaccard") == 1  { return LP_JACCARD }
    if str_eq(name, "j") == 1        { return LP_JACCARD }
    if str_eq(name, "aa") == 1       { return LP_AA }
    if str_eq(name, "adamic") == 1   { return LP_AA }
    if str_eq(name, "adamic_adar") == 1 { return LP_AA }
    return 0
}

// ---- chat dispatch -------------------------------------------------------
//
// `/predict <atom_id> [top_k] [method]` admin: runs lp_predict_top_k
// for the requested source atom and emits a single PREDICT line. Same
// emit-line discipline as /pagerank.
//
// Arg parsing mirrors /recall's _episodic_recall_split idiom -- single
// ASCII-space split, allocates pairs on the fly. Missing args fall
// through to defaults: top_k = LP_DEFAULT_TOP_K, method = "jaccard".

// Single-space split: returns [first_token, rest]. Duplicated from
// episodic.nova's _episodic_recall_split per the same "kg/ is a leaf"
// discipline -- link_prediction.nova must not import episodic.nova.
fn _lp_split(arg) {
    let i = 0
    while i < len(arg) {
        if char_at(arg, i) == 32 {
            let pair = list_new()
            push(pair, substr(arg, 0, i))
            push(pair, str_trim(substr(arg, i + 1, len(arg) - i - 1)))
            return pair
        }
        i = i + 1
    }
    let pair = list_new()
    push(pair, arg)
    push(pair, "")
    return pair
}

fn lp_predict_cmd(kg, arg) {
    if len(arg) == 0 {
        io_println("usage: /predict <atom_id> [top_k] [method]"
            + "  -- method in {cn, jaccard, aa}; default jaccard top_k="
            + int_to_str(LP_DEFAULT_TOP_K))
        io_println("PREDICT store_size=" + int_to_str(kg_atom_count(kg)))
        return 1
    }

    // Tokenize: <id> <top_k?> <method?>.
    let parts1 = _lp_split(arg)
    let id_str = parts1[0]
    let rest1 = parts1[1]
    let source_id = rt_str_to_int(id_str)
    let top_k = LP_DEFAULT_TOP_K
    let method = LP_JACCARD

    if len(rest1) > 0 {
        let parts2 = _lp_split(rest1)
        let k_str = parts2[0]
        let rest2 = parts2[1]
        let k_val = rt_str_to_int(k_str)
        if k_val > 0 {
            top_k = k_val
        } else {
            // The first extra token wasn't a number -- treat it as a
            // method name and keep the default K. Mirrors the
            // /recall member <id> "permissive parse" precedent.
            let m_try = lp_method_parse(k_str)
            if m_try != 0 { method = m_try }
        }
        if len(rest2) > 0 {
            let m_try2 = lp_method_parse(rest2)
            if m_try2 != 0 { method = m_try2 }
        }
    }

    // Validate the source atom exists.
    let src = kg_atom(kg, source_id)
    if src == 0 {
        io_println("PREDICT error=missing source atom_id=" + int_to_str(source_id))
        return 1
    }

    let preds = lp_predict_top_k(kg, source_id, top_k, method)
    let n = len(preds)
    let buf = "PREDICT source=" + int_to_str(source_id)
        + " method=" + lp_method_name(method)
        + " top_k=" + int_to_str(top_k)
        + " hits=" + int_to_str(n)
        + " edges=["
    let i = 0
    while i < n {
        if i > 0 { buf = buf + " " }
        buf = buf + "id=" + int_to_str(preds[i][0])
            + ",score=" + int_to_str(preds[i][1])
        i = i + 1
    }
    buf = buf + "]"
    io_println(buf)
    return 1
}
