// CrossEngin Phase 0 pt4: KG routing table.
//
// Purpose
//   A tiny per-session index keyed by (topic_hash, shape_hash). Each row
//   records which KG serves this query shape, how many times it has been
//   served (hits), and the running mean latency in ticks. Updated on
//   every answered query. Surfaced via the /__routing__ chat command.
//
//   Today only one KG (the reasoning KG) is threaded into router_reply,
//   so every row records kg_label="reasoning". The field exists so the
//   routing surface is live before Phase 4's domain-sharded KGs arrive;
//   once multi-KG dispatch comes online, the same table drives the
//   per-topic KG preference without any schema change.
//
//   topic_hash  = label_hash(first_content_token(utterance))
//   shape_hash  = label_hash(cat_name(category) + ":" + (len_tokens/4))
//   latency     = hs_now(hs) delta around router_reply
//
// NOVA dependencies: builtins (list_new, push, len, list_set,
//   int_to_str, str_eq_bytes).
// CrossEngin dependencies: none at module level; callers pass precomputed
//   hashes + latency. (label_hash from atom_store.nova is called by the
//   chat example, not here, so this module stays dependency-light.)

import "std/io"
import "std/string"
import "std/syscall"

// Row slots (parallel arrays, same NOVA idiom as synapse_graph).
let KGR_TAG    = 0
let KGR_TOPIC  = 1   // list<int>: topic_hash per row
let KGR_SHAPE  = 2   // list<int>: shape_hash per row
let KGR_KG     = 3   // list<str>: kg_label per row
let KGR_HITS   = 4   // list<int>: hit count per row
let KGR_LATSUM = 5   // list<int>: total latency ticks per row
let KGR_LAT    = 6   // list<int>: mean latency ticks per row (cached)
let KGR_ROUTER_TAG = 771

fn kgr_new() {
    let r = list_new()
    push(r, KGR_ROUTER_TAG)
    push(r, list_new())   // topic
    push(r, list_new())   // shape
    push(r, list_new())   // kg
    push(r, list_new())   // hits
    push(r, list_new())   // latsum
    push(r, list_new())   // lat
    return r
}

fn kgr_count(r) { return len(r[KGR_TOPIC]) }

fn _kgr_find(r, topic_hash, shape_hash) {
    let t = r[KGR_TOPIC]
    let s = r[KGR_SHAPE]
    let n = len(t)
    let i = 0
    while i < n {
        if t[i] == topic_hash {
            if s[i] == shape_hash {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// Insert-or-update. Latency is milli-tick-count (hs_now delta).
// Returns the row index touched.
fn kgr_observe(r, topic_hash, shape_hash, kg_label, latency_ticks) {
    let idx = _kgr_find(r, topic_hash, shape_hash)
    if idx == -1 {
        push(r[KGR_TOPIC],  topic_hash)
        push(r[KGR_SHAPE],  shape_hash)
        push(r[KGR_KG],     kg_label)
        push(r[KGR_HITS],   1)
        push(r[KGR_LATSUM], latency_ticks)
        push(r[KGR_LAT],    latency_ticks)
        return len(r[KGR_TOPIC]) - 1
    }
    let h = r[KGR_HITS][idx] + 1
    let s = r[KGR_LATSUM][idx] + latency_ticks
    list_set(r[KGR_HITS],   idx, h)
    list_set(r[KGR_LATSUM], idx, s)
    list_set(r[KGR_LAT],    idx, s / h)
    return idx
}

// Returns [kg_label, mean_latency_ticks, hits] or 0.
fn kgr_lookup(r, topic_hash, shape_hash) {
    let idx = _kgr_find(r, topic_hash, shape_hash)
    if idx == -1 { return 0 }
    let out = list_new()
    push(out, r[KGR_KG][idx])
    push(out, r[KGR_LAT][idx])
    push(out, r[KGR_HITS][idx])
    return out
}

// Row accessors by index (for /__routing__ enumeration).
fn kgr_row_topic(r, i) { return r[KGR_TOPIC][i] }
fn kgr_row_shape(r, i) { return r[KGR_SHAPE][i] }
fn kgr_row_kg(r, i)    { return r[KGR_KG][i] }
fn kgr_row_hits(r, i)  { return r[KGR_HITS][i] }
fn kgr_row_lat(r, i)   { return r[KGR_LAT][i] }

// Return row indices sorted by hits desc, up to n. O(count^2) selection
// sort — the row count stays small enough (dozens, maybe low hundreds)
// that this is fine; worth revisiting only after Phase 4 shard rollout.
fn kgr_top(r, n) {
    let hits = r[KGR_HITS]
    let total = len(hits)
    let out = list_new()
    let taken = list_new()
    let want = n
    if total < want { want = total }
    let k = 0
    while k < want {
        let best = -1
        let best_h = -1
        let i = 0
        while i < total {
            let already = 0
            let j = 0
            while j < len(taken) {
                if taken[j] == i { already = 1 }
                j = j + 1
            }
            if already == 0 {
                if hits[i] > best_h {
                    best_h = hits[i]
                    best = i
                }
            }
            i = i + 1
        }
        if best == -1 { k = want }
        else {
            push(out, best)
            push(taken, best)
            k = k + 1
        }
    }
    return out
}
