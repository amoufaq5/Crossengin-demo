// CrossEngin knowledge: atom store (the persistent knowledge unit).
//
// Purpose
//   An atom is the persistent, mutable unit of knowledge produced by the
//   substrate and stored in a domain KG (ADR-0016). Its belief is Bayesian
//   (alpha/beta pseudo-counts), never a scalar confidence. Atom identity
//   (kg_id, id) is immutable so synapses and cross-KG references stay valid
//   across mutations; every mutation bumps `version`.
//
//   This module also provides the knowledge layer's shared numeric helpers,
//   implemented in CrossEngin (integer milli-fixed-point, scale 1000) rather
//   than via NOVA's core/runtime knowledge modules:
//     - belief (alpha/beta): mirrors core/belief.nova semantics. NOVA's
//       core/belief.nova is not cleanly std-importable in v0.x.
//     - vector cosine similarity: NOVA's std/embed does not link cleanly
//       (duplicate symbols), so a small integer cosine is provided here.
//   See NEXT_SESSION.md (NOVA blockers) for the import failures this avoids.
//
// Atom layout (ADR-0016):
//   [TAG, id, kg_id, kind, label, payload, belief, embed, xrefs, provenance,
//    created_moment, updated_moment, version]
//   - payload:    list of [key, value] pairs (kind-specific; a map would hit
//                 NOVA's 16-key builtin-map cap, so we use a scanned list)
//   - belief:     [alpha, beta] milli pseudo-counts; uniform prior (1.0, 1.0)
//   - embed:      facet vector (semantic embedding) for similarity
//   - xrefs:      list of cross-KG reference edges (ADR-0017)
//   - provenance: [source_tier, producing_part] (ADR-0029)
//
// ADRs implemented: ADR-0016 (atom design), ADR-0023 (Bayesian belief, the
//   alpha/beta model atoms use). Depends-on note: NOVA enhancement #8 (multi-KG
//   namespacing) backs the kg_id/xref fields; semantics are complete now.
// NOVA dependencies: builtins (lists, str_eq, int math).
// CrossEngin dependencies: src/substrate/node_pool_manager.nova (FP_SCALE,
//   fp_clamp, milli-fixed-point convention).

import "../substrate/node_pool_manager.nova"

// ---- belief: alpha/beta in milli (1.0 == 1000) ---------------------------
let BEL_PRIOR = 1000   // uniform prior alpha0 = beta0 = 1.0

fn bel_new(alpha, beta) {
    let b = list_new()
    push(b, alpha)
    push(b, beta)
    return b
}

fn bel_uniform() { return bel_new(BEL_PRIOR, BEL_PRIOR) }

// Posterior mean alpha/(alpha+beta), in milli (0..1000).
fn bel_mean(b) {
    let total = b[0] + b[1]
    if total <= 0 { return 500 }
    return b[0] * FP_SCALE / total
}

// Total evidence mass (alpha+beta), milli.
fn bel_strength(b) { return b[0] + b[1] }

// Number of observations accumulated beyond the uniform (1,1) prior.
fn bel_evidence(b) {
    let beyond = (b[0] + b[1]) - (2 * BEL_PRIOR)
    if beyond < 0 { return 0 }
    return beyond / FP_SCALE
}

// One observation: sign > 0 increments alpha (support), else beta (contradict).
fn bel_observe(b, sign) {
    if sign > 0 {
        list_set(b, 0, b[0] + FP_SCALE)
    } else {
        list_set(b, 1, b[1] + FP_SCALE)
    }
    return 1
}

// ---- integer vectors + cosine similarity (milli) -------------------------
let ATOM_EMBED_DIMS = 8

fn isqrt(n) {
    if n <= 0 { return 0 }
    let x = n
    let y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

fn vec_new(dims) {
    let v = list_new()
    let i = 0
    while i < dims { push(v, 0); i = i + 1 }
    return v
}

fn vec_set(v, i, x) {
    if i < 0 { return 0 }
    if i >= len(v) { return 0 }
    list_set(v, i, x)
    return 1
}

fn vec_get(v, i) {
    if i < 0 { return 0 }
    if i >= len(v) { return 0 }
    return v[i]
}

fn vec_dims(v) { return len(v) }

// Cosine similarity of two equal-length non-negative vectors, in milli (0..1000).
fn vec_cosine(a, b) {
    let n = len(a)
    if n > len(b) { n = len(b) }
    let dot = 0
    let na = 0
    let nb = 0
    let i = 0
    while i < n {
        dot = dot + a[i] * b[i]
        na = na + a[i] * a[i]
        nb = nb + b[i] * b[i]
        i = i + 1
    }
    if na == 0 { return 0 }
    if nb == 0 { return 0 }
    let denom = isqrt(na) * isqrt(nb)
    if denom == 0 { return 0 }
    let c = dot * FP_SCALE / denom
    return fp_clamp(c, 0, FP_SCALE)
}

// ---- atom kinds (ADR-0016) -----------------------------------------------
let ATOM_FACT     = 1
let ATOM_RELATION = 2
let ATOM_CONCEPT  = 3
let ATOM_SKILL    = 4
let ATOM_LANG     = 5
let ATOM_RULE     = 6

// ---- atom layout ----------------------------------------------------------
let ATOM_TAG = 0
let A_ID      = 1
let A_KG      = 2
let A_KIND    = 3
let A_LABEL   = 4
let A_PAYLOAD = 5
let A_BELIEF  = 6
let A_EMBED   = 7
let A_XREFS   = 8
let A_PROV    = 9
let A_CREATED = 10
let A_UPDATED = 11
let A_VERSION = 12
let ATOM_OBJ_TAG = 1601

fn atom_kind_valid(kind) {
    if kind < ATOM_FACT { return 0 }
    if kind > ATOM_RULE { return 0 }
    return 1
}

fn atom_kind_name(kind) {
    if kind == ATOM_FACT     { return "fact" }
    if kind == ATOM_RELATION { return "relation" }
    if kind == ATOM_CONCEPT  { return "concept" }
    if kind == ATOM_SKILL    { return "skill" }
    if kind == ATOM_LANG     { return "lang" }
    if kind == ATOM_RULE     { return "rule" }
    return "invalid"
}

// Construct an atom. id is assigned by its owning KG (multi_kg_manager). The
// belief starts uniform, version 0, with an empty embedding and no xrefs.
fn atom_new(kg_id, id, kind, label, moment) {
    let a = list_new()
    push(a, ATOM_OBJ_TAG)
    push(a, id)
    push(a, kg_id)
    push(a, kind)
    push(a, label)
    push(a, list_new())          // payload
    push(a, bel_uniform())       // belief
    push(a, vec_new(ATOM_EMBED_DIMS))  // embed
    push(a, list_new())          // xrefs
    push(a, [0, -1])             // provenance [source_tier, producing_part]
    push(a, moment)              // created
    push(a, moment)              // updated
    push(a, 0)                   // version
    return a
}

// Accessors.
fn atom_id(a)      { return a[A_ID] }
fn atom_kg(a)      { return a[A_KG] }
fn atom_kind(a)    { return a[A_KIND] }
fn atom_label(a)   { return a[A_LABEL] }
fn atom_belief(a)  { return a[A_BELIEF] }
fn atom_embed(a)   { return a[A_EMBED] }
fn atom_xrefs(a)   { return a[A_XREFS] }
fn atom_version(a) { return a[A_VERSION] }
fn atom_created(a) { return a[A_CREATED] }
fn atom_updated(a) { return a[A_UPDATED] }
fn atom_confidence(a) { return bel_mean(a[A_BELIEF]) }
fn atom_evidence(a)   { return bel_evidence(a[A_BELIEF]) }

// Payload is a scanned list of [key, value] pairs.
fn atom_payload_set(a, key, value) {
    let pl = a[A_PAYLOAD]
    let i = 0
    while i < len(pl) {
        if str_eq(pl[i][0], key) == 1 {
            list_set(pl[i], 1, value)
            return 1
        }
        i = i + 1
    }
    let entry = list_new()
    push(entry, key)
    push(entry, value)
    push(pl, entry)
    return 1
}

fn atom_payload_get(a, key) {
    let pl = a[A_PAYLOAD]
    let i = 0
    while i < len(pl) {
        if str_eq(pl[i][0], key) == 1 { return pl[i][1] }
        i = i + 1
    }
    return 0
}

fn atom_payload_has(a, key) {
    let pl = a[A_PAYLOAD]
    let i = 0
    while i < len(pl) {
        if str_eq(pl[i][0], key) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Record a mutation: bump version and update the modified timestamp. Identity
// (id, kg_id) is preserved.
fn atom_touch(a, moment) {
    list_set(a, A_VERSION, a[A_VERSION] + 1)
    list_set(a, A_UPDATED, moment)
    return a[A_VERSION]
}

// Update a payload field and record the mutation in one step.
fn atom_update(a, key, value, moment) {
    atom_payload_set(a, key, value)
    return atom_touch(a, moment)
}

// Bayesian evidence: +1 supports the atom, -1 contradicts it (ADR-0016).
fn atom_observe(a, sign) {
    return bel_observe(a[A_BELIEF], sign)
}

fn atom_set_embed(a, vec) {
    list_set(a, A_EMBED, vec)
    return 1
}

fn atom_add_xref(a, xref) {
    push(a[A_XREFS], xref)
    return len(a[A_XREFS])
}

// (kg_id, atom_id) handle helpers -- the stable cross-graph reference.
fn handle_new(kg_id, atom_id) {
    let h = list_new()
    push(h, kg_id)
    push(h, atom_id)
    return h
}
fn handle_kg(h)   { return h[0] }
fn handle_atom(h) { return h[1] }
fn handle_eq(h1, h2) {
    if str_eq(h1[0], h2[0]) == 0 { return 0 }
    if h1[1] != h2[1] { return 0 }
    return 1
}
