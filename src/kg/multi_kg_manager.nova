// CrossEngin knowledge: multi-KG manager.
//
// Purpose
//   Knowledge is organized into per-domain knowledge graphs (ADR-0004): each KG
//   is a namespace owning its own atoms, addressed by a stable (kg_id, atom_id)
//   handle. A KG is spawned per domain (the spawn heuristic that decides *when*
//   lives in cross_kg_references.nova, ADR-0017); this module is the registry
//   and atom store underneath it. Each KG also exposes an embedding centroid,
//   the mean of its atoms' embeddings, used for routing and spawn decisions.
//
//   Atoms are stored in a list indexed by atom_id (O(1) by handle); label
//   lookup is a linear scan (a hash map would hit NOVA's 16-key builtin-map
//   cap -- see NEXT_SESSION.md). KG eviction/rehydration to disk is part of the
//   ADR-0048 persistence work (Phase 10) and is deliberately not implemented
//   here.
//
// ADRs implemented: ADR-0004 (multi-KG organization), ADR-0016 (atoms live in
//   KGs). Depends-on note: NOVA enhancement #8 (multi-KG namespacing) is the
//   scale backing; the semantics are complete now.
// NOVA dependencies: builtins (lists, str_eq).
// CrossEngin dependencies: src/kg/atom_store.nova.

import "atom_store.nova"

// ---- KG layout ------------------------------------------------------------
let KG_TAG    = 0
let KG_LABEL  = 1   // kg_id: human-readable domain name (the atom's kg_id)
let KG_NUMID  = 2   // registry-local numeric id
let KG_ATOMS  = 3   // list indexed by atom_id -> atom
let KG_NEXTID = 4
let KG_ALIVE  = 5
let KG_OBJ_TAG = 1701

// ---- registry layout ------------------------------------------------------
let KREG_TAG  = 0
let KREG_KGS  = 1   // list indexed by numeric kg id
let KREG_NEXT = 2
let KREG_OBJ_TAG = 1702

fn kg_registry_new() {
    let reg = list_new()
    push(reg, KREG_OBJ_TAG)
    push(reg, list_new())
    push(reg, 0)
    return reg
}

fn _kg_build(label, num_id) {
    let kg = list_new()
    push(kg, KG_OBJ_TAG)
    push(kg, label)
    push(kg, num_id)
    push(kg, list_new())
    push(kg, 0)
    push(kg, 1)
    return kg
}

// Find a KG by label (linear scan); returns the KG object or 0.
fn kg_find(reg, label) {
    let kgs = reg[KREG_KGS]
    let i = 0
    while i < len(kgs) {
        if str_eq(kgs[i][KG_LABEL], label) == 1 { return kgs[i] }
        i = i + 1
    }
    return 0
}

// Spawn (or return existing) the KG for a domain label. Idempotent.
fn kg_spawn(reg, label) {
    let existing = kg_find(reg, label)
    if existing != 0 { return existing }
    let num_id = reg[KREG_NEXT]
    let kg = _kg_build(label, num_id)
    push(reg[KREG_KGS], kg)
    list_set(reg, KREG_NEXT, num_id + 1)
    return kg
}

fn kg_get(reg, num_id) {
    let kgs = reg[KREG_KGS]
    if num_id < 0 { return 0 }
    if num_id >= len(kgs) { return 0 }
    return kgs[num_id]
}

fn kg_count(reg) { return len(reg[KREG_KGS]) }

fn kg_label(kg)    { return kg[KG_LABEL] }
fn kg_num_id(kg)   { return kg[KG_NUMID] }
fn kg_is_alive(kg) { return kg[KG_ALIVE] }
fn kg_atom_count(kg) { return len(kg[KG_ATOMS]) }
fn kg_atoms(kg)    { return kg[KG_ATOMS] }

// Create and store a new atom in the KG; assigns the next atom id. Returns the
// atom. Identity (kg label, atom id) is stable for the atom's lifetime.
fn kg_add_atom(kg, kind, label, moment) {
    let id = kg[KG_NEXTID]
    let a = atom_new(kg[KG_LABEL], id, kind, label, moment)
    push(kg[KG_ATOMS], a)
    list_set(kg, KG_NEXTID, id + 1)
    return a
}

// Retrieve an atom by id; 0 if out of range.
fn kg_atom(kg, atom_id) {
    let atoms = kg[KG_ATOMS]
    if atom_id < 0 { return 0 }
    if atom_id >= len(atoms) { return 0 }
    return atoms[atom_id]
}

// First atom with the given label (linear scan); 0 if none.
fn kg_find_atom(kg, label) {
    let atoms = kg[KG_ATOMS]
    let i = 0
    while i < len(atoms) {
        if str_eq(atom_label(atoms[i]), label) == 1 { return atoms[i] }
        i = i + 1
    }
    return 0
}

// The KG's embedding centroid: the per-dimension mean of its atoms' embeddings.
// Returns a zero vector when the KG is empty.
fn kg_centroid(kg) {
    let dims = ATOM_EMBED_DIMS
    let c = vec_new(dims)
    let atoms = kg[KG_ATOMS]
    let n = len(atoms)
    if n == 0 { return c }
    let i = 0
    while i < n {
        let e = atom_embed(atoms[i])
        let d = 0
        while d < dims {
            vec_set(c, d, vec_get(c, d) + vec_get(e, d))
            d = d + 1
        }
        i = i + 1
    }
    let d2 = 0
    while d2 < dims {
        vec_set(c, d2, vec_get(c, d2) / n)
        d2 = d2 + 1
    }
    return c
}
