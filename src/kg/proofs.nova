// KG-proofs: the proof table (ADR-0088 storage layer; the table an atom's
// provenance `proof_ref` interns into, per ADR-0087).
//
// A FORMAL-graded atom (a theorem, a type-check, a terminating computation)
// carries a `proof_ref` into this table. Each entry records the claim, the
// checker's verdict, the axioms/premises used, and an opaque derivation blob.
// THIS module is only the store; the checking itself is the ADR-0088 proof
// checker kernel (`mind/verify.nova`, future), which calls `proof_set_status`
// with its verdict. Keeping the store separate lets the rest of the engine
// reason about "is this atom's proof verified?" without depending on the kernel.
//
// A proof record is a fixed list:
//   [claim_label, checker_status, axioms_used, derivation_blob]
// claim/axioms are serialized BY LABEL (atom ids are not stable across load,
// mirroring the snapshot xref convention).

import "atom_store.nova"

let PRF_CLAIM   = 0   // claim atom label (string)
let PRF_STATUS  = 1   // checker verdict (below)
let PRF_AXIOMS  = 2   // list of axiom / premise labels the derivation uses
let PRF_BLOB    = 3   // opaque derivation blob (string)

// Checker verdicts.
let PROOF_UNCHECKED = 0   // registered, not yet checked
let PROOF_VERIFIED  = 1   // the kernel checked it and it holds
let PROOF_FAILED    = 2   // the kernel checked it and it does NOT hold

fn proof_record(claim, status, axioms, blob) {
    let r = list_new()
    push(r, claim)
    push(r, status)
    push(r, axioms)
    push(r, blob)
    return r
}

// New proof registry. Slot 0 is a reserved "no proof" placeholder so that a
// PROV_NONE (-1) or out-of-range proof_ref resolves to an UNCHECKED record
// rather than faulting (fail safe: an unresolved proof is never VERIFIED).
fn proof_registry_new() {
    let reg = list_new()
    push(reg, proof_record("", PROOF_UNCHECKED, list_new(), ""))
    return reg
}

// Register a proof obligation; returns its code (>= 1) to store as an atom's
// proof_ref. Starts UNCHECKED until the kernel verifies it.
fn proof_register(reg, claim, axioms, blob) {
    let code = len(reg)
    push(reg, proof_record(claim, PROOF_UNCHECKED, axioms, blob))
    return code
}

fn proof_get(reg, code) {
    if code < 0 { return reg[0] }
    if code >= len(reg) { return reg[0] }
    return reg[code]
}

fn proof_status(reg, code) { return proof_get(reg, code)[PRF_STATUS] }
fn proof_claim(reg, code)  { return proof_get(reg, code)[PRF_CLAIM] }
fn proof_axioms(reg, code) { return proof_get(reg, code)[PRF_AXIOMS] }

// Record the kernel's verdict for a proof (ADR-0088). Refuses to touch the
// reserved slot 0 or an out-of-range code. Returns 1 on success.
fn proof_set_status(reg, code, status) {
    if code <= 0 { return 0 }
    if code >= len(reg) { return 0 }
    list_set(proof_get(reg, code), PRF_STATUS, status)
    return 1
}

// ADR-0087/0088 consistency: a FORMAL atom is only legitimate if its proof_ref
// resolves to a VERIFIED proof. Non-FORMAL atoms are vacuously consistent.
// This supersedes atom_store's `atom_grade_consistent` (which only checked that
// a proof_ref was present) by requiring the proof to actually have passed.
fn atom_proof_verified(reg, a) {
    if atom_evidence_grade(a) != GRADE_FORMAL { return 1 }
    let pref = atom_proof_ref(a)
    if pref == PROV_NONE { return 0 }
    if proof_status(reg, pref) == PROOF_VERIFIED { return 1 }
    return 0
}
