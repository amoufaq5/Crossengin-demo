// CrossEngin knowledge: procedural memory (KG-skills).
//
// Purpose
//   Skills are procedural knowledge stored as atoms in a standing "skills" KG
//   (ADR-0019). A skill atom (kind ATOM_SKILL) carries a trigger, an ordered
//   list of step rules (each an ATOM_RULE atom: condition -> action_signal),
//   preconditions, and effects. Its reliability is the atom's own Bayesian
//   belief, updated on every execution outcome. Skills are activated by the
//   substrate when their trigger and preconditions hold -- they emit ordered
//   action signals (the actual emission is the action part's job, a later
//   phase); here, activation returns the ordered signal list. Unreliable skills
//   are flagged for retirement, never silently deleted.
//
//   action_signal is an ADR-0008 XSIG_* signal-type id (an int); this module
//   stays in the knowledge layer and does not import the substrate.
//
// ADRs implemented: ADR-0019 (procedural memory and KG-skills), ADR-0016/0023
//   (skill reliability is the atom's alpha/beta belief).
// NOVA dependencies: builtins (lists, str_eq, contains).
// CrossEngin dependencies: src/kg/multi_kg_manager.nova (and atom_store).

import "multi_kg_manager.nova"

let SKILL_RETIRE = 400   // 0.4 reliability posterior-mean retire threshold
let RETIRE_N     = 8     // executions before retirement can be judged

// Rule-atom payload keys.
let RULE_COND   = "condition"
let RULE_ACTION = "action"

// Spawn (or fetch) the standing skills KG in a registry.
fn skills_kg_init(reg) {
    return kg_spawn(reg, "skills")
}

// Create a skill with a trigger and empty steps/preconditions/effects. Its
// reliability is the atom's uniform belief.
fn skill_new(skills_kg, label, trigger, moment) {
    let s = kg_add_atom(skills_kg, ATOM_SKILL, label, moment)
    atom_payload_set(s, "trigger", trigger)
    atom_payload_set(s, "steps", list_new())
    atom_payload_set(s, "pre", list_new())
    atom_payload_set(s, "eff", list_new())
    return s
}

fn skill_trigger(s)       { return atom_payload_get(s, "trigger") }
fn skill_steps(s)         { return atom_payload_get(s, "steps") }   // rule atom ids
fn skill_preconditions(s) { return atom_payload_get(s, "pre") }
fn skill_effects(s)       { return atom_payload_get(s, "eff") }
fn skill_step_count(s)    { return len(skill_steps(s)) }

// Append a step: create an ATOM_RULE atom (condition -> action_signal) in the
// skills KG and record its id in the skill's step list. Returns the rule atom.
fn skill_add_step(skills_kg, s, condition, action_signal, moment) {
    let rule = kg_add_atom(skills_kg, ATOM_RULE, condition, moment)
    atom_payload_set(rule, RULE_COND, condition)
    atom_payload_set(rule, RULE_ACTION, action_signal)
    push(skill_steps(s), atom_id(rule))
    return rule
}

fn skill_add_precondition(s, cond) { push(skill_preconditions(s), cond); return 1 }
fn skill_add_effect(s, eff)        { push(skill_effects(s), eff); return 1 }

// Do all of a skill's preconditions hold in the given context (a list of
// condition strings currently true)?
fn skill_preconditions_hold(s, context) {
    let pre = skill_preconditions(s)
    let i = 0
    while i < len(pre) {
        if contains(context, pre[i]) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Activate a skill in a context: if its preconditions hold, return the ordered
// list of action signals for steps whose condition is satisfied (an empty
// condition is unconditional). Returns an empty list if preconditions fail.
fn skill_activate(skills_kg, s, context) {
    let out = list_new()
    if skill_preconditions_hold(s, context) == 0 { return out }
    let steps = skill_steps(s)
    let i = 0
    while i < len(steps) {
        let rule = kg_atom(skills_kg, steps[i])
        if rule != 0 {
            let cond = atom_payload_get(rule, RULE_COND)
            let fire = 0
            if str_eq(cond, "") == 1 { fire = 1 }
            else { if contains(context, cond) == 1 { fire = 1 } }
            if fire == 1 { push(out, atom_payload_get(rule, RULE_ACTION)) }
        }
        i = i + 1
    }
    return out
}

// Outcome feedback: > 0 success (alpha), else failure (beta).
fn skill_observe(s, outcome) {
    return atom_observe(s, outcome)
}

// Reliability posterior mean (milli) and the number of executions observed.
fn skill_reliability(s) { return atom_confidence(s) }
fn skill_executions(s)  { return atom_evidence(s) }

// Flag for retirement: low reliability after enough executions (ADR-0019).
fn skill_should_retire(s) {
    if skill_executions(s) < RETIRE_N { return 0 }
    if skill_reliability(s) < SKILL_RETIRE { return 1 }
    return 0
}

// Compose two skills into a new one whose steps are s1's then s2's, with s1's
// preconditions and s2's effects (ADR-0019/0033). Reuses the existing rule
// atoms by id. Returns the new skill.
fn skill_compose(skills_kg, s1, s2, label, moment) {
    let composed = skill_new(skills_kg, label, skill_trigger(s1), moment)
    let steps = skill_steps(composed)
    let st1 = skill_steps(s1)
    let i = 0
    while i < len(st1) { push(steps, st1[i]); i = i + 1 }
    let st2 = skill_steps(s2)
    let j = 0
    while j < len(st2) { push(steps, st2[j]); j = j + 1 }
    let pre1 = skill_preconditions(s1)
    let k = 0
    while k < len(pre1) { skill_add_precondition(composed, pre1[k]); k = k + 1 }
    let eff2 = skill_effects(s2)
    let m = 0
    while m < len(eff2) { skill_add_effect(composed, eff2[m]); m = m + 1 }
    return composed
}
