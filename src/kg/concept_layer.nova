// CrossEngin knowledge: concept layer.
//
// Purpose
//   Concepts sit above the KG layer (ADR-0018): each is a node in a
//   multiple-inheritance DAG that groups member atoms (by (kg_id, atom_id)
//   handle), carries typed schema slots, facet vectors, a kg_span (the KGs its
//   members come from -- cross-domain iff > 1), and a salience. Concepts are
//   promoted from tightly clustered atoms (mean pairwise cosine > CONCEPT_PROMOTE)
//   and grow schema slots as members independently exhibit shared properties; an
//   unfilled high-salience slot is an actionable knowledge gap (feeds ADR-0026).
//
//   Similarities are integer cosine in milli; CONCEPT_PROMOTE = 0.7 -> 700.
//
// ADRs implemented: ADR-0018 (concept layer, promotion, schema slots, facets).
//   Depends-on note: NOVA enhancement #8 (multi-KG/cross-refs the concepts index
//   over); semantics complete now.
// NOVA dependencies: builtins (lists, str_eq, contains).
// CrossEngin dependencies: src/kg/atom_store.nova (vectors, atom handles).

import "atom_store.nova"
import "hdc_embed.nova"

// ---- facet vector ids (ADR-0018) ------------------------------------------
let VEC_LEXICAL    = 1
let VEC_SEMANTIC   = 2
let VEC_RELATIONAL = 3
let VEC_AFFECTIVE  = 4
let VEC_FACET_MAX  = 4

let CONCEPT_PROMOTE = 700   // 0.7 mean pairwise similarity to promote
let SCHEMA_K        = 3     // independent confirmations before a slot is added

// ---- concept layout -------------------------------------------------------
let C_TAG      = 0
let C_ID       = 1
let C_PARENTS  = 2   // list of parent concept ids
let C_CHILDREN = 3   // list of child concept ids
let C_SLOTS    = 4   // list of [name, type, filled(0/1), value]
let C_VECTORS  = 5   // list indexed by facet id (1..4) -> vector (or 0)
let C_MEMBERS  = 6   // list of (kg_id, atom_id) handles
let C_KGSPAN   = 7   // list of distinct kg_id strings
let C_SAL      = 8   // salience (milli)
let CONCEPT_OBJ_TAG = 1881

let CS_NAME   = 0
let CS_TYPE   = 1
let CS_FILLED = 2
let CS_VALUE  = 3

// ---- layer (registry) -----------------------------------------------------
let CL_TAG      = 0
let CL_CONCEPTS = 1   // list indexed by concept id
let CL_NEXT     = 2

fn concept_layer_new() {
    let layer = list_new()
    push(layer, CL_TAG)
    push(layer, list_new())
    push(layer, 0)
    return layer
}

fn _concept_build(id) {
    let c = list_new()
    push(c, CONCEPT_OBJ_TAG)
    push(c, id)
    push(c, list_new())   // parents
    push(c, list_new())   // children
    push(c, list_new())   // slots
    let vecs = list_new()
    let i = 0
    while i <= VEC_FACET_MAX { push(vecs, 0); i = i + 1 }
    push(c, vecs)         // vectors
    push(c, list_new())   // members
    push(c, list_new())   // kg_span
    push(c, 0)            // salience
    return c
}

fn concept_new(layer) {
    let id = layer[CL_NEXT]
    let c = _concept_build(id)
    push(layer[CL_CONCEPTS], c)
    list_set(layer, CL_NEXT, id + 1)
    return id
}

fn concept_count(layer) { return len(layer[CL_CONCEPTS]) }

fn concept_get(layer, id) {
    let cs = layer[CL_CONCEPTS]
    if id < 0 { return 0 }
    if id >= len(cs) { return 0 }
    return cs[id]
}

fn concept_members(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return list_new() }
    return c[C_MEMBERS]
}
fn concept_kg_span(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return list_new() }
    return c[C_KGSPAN]
}
fn concept_is_cross_domain(layer, id) {
    if len(concept_kg_span(layer, id)) > 1 { return 1 }
    return 0
}
fn concept_parents(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return list_new() }
    return c[C_PARENTS]
}
fn concept_children(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return list_new() }
    return c[C_CHILDREN]
}
fn concept_salience(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    return c[C_SAL]
}
fn concept_set_salience(layer, id, v) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    list_set(c, C_SAL, v)
    return 1
}

// Pairwise embedding similarity (milli), mode-aware (ADR-0051 "ann_index and
// coherence still use vec_cosine"). In HDC mode the embeds are bipolar
// hypervectors, so we use the signed hdc_cosine: it reduces to dot/D on the
// positive range (where vec_cosine and hdc_cosine agree) but, unlike vec_cosine
// -- which clamps negatives to 0 for the non-negative lexical vectors -- it
// carries anti-correlation as a negative score. That makes the mean-pairwise
// coherence gate below penalise clusters whose members actively disagree,
// rather than treating "opposite" and "orthogonal" as equally non-coherent.
// In LEGACY mode the embeds are the non-negative lexical vectors, so vec_cosine
// (clamped at 0) is exactly right and the prior behaviour is unchanged.
fn _embed_similarity(a, b) {
    if atom_embed_is_hdc() == 1 { return hdc_cosine(a, b) }
    return vec_cosine(a, b)
}

// Mean pairwise cosine of a set of atoms' embeddings (milli). One atom -> 1.0.
fn _atoms_coherence(atoms) {
    let n = len(atoms)
    if n < 2 { return FP_SCALE }
    let total = 0
    let pairs = 0
    let i = 0
    while i < n {
        let j = i + 1
        while j < n {
            total = total + _embed_similarity(atom_embed(atoms[i]), atom_embed(atoms[j]))
            pairs = pairs + 1
            j = j + 1
        }
        i = i + 1
    }
    if pairs == 0 { return FP_SCALE }
    return total / pairs
}

// The semantic facet that represents a cluster of member atoms (ADR-0051).
//   LEGACY -> the arithmetic-mean centroid over the 8-dim lexical vectors.
//   HDC    -> the bundle (sign of sum) of the member hypervectors. A plain
//             mean is wrong for bipolar vectors: averaging +/-1 and integer-
//             dividing collapses almost every coordinate to 0, destroying the
//             vector; bundling is the VSA-correct "centroid".
fn _concept_semantic_facet(atoms) {
    if atom_embed_is_hdc() == 1 {
        let vs = list_new()
        let i = 0
        while i < len(atoms) { push(vs, atom_embed(atoms[i])); i = i + 1 }
        return hdc_bundle(vs)
    }
    let dims = ATOM_EMBED_DIMS
    let centroid = vec_new(dims)
    let i2 = 0
    while i2 < len(atoms) {
        let e = atom_embed(atoms[i2])
        let d = 0
        while d < dims {
            vec_set(centroid, d, vec_get(centroid, d) + vec_get(e, d))
            d = d + 1
        }
        i2 = i2 + 1
    }
    let d2 = 0
    while d2 < dims {
        vec_set(centroid, d2, vec_get(centroid, d2) / len(atoms))
        d2 = d2 + 1
    }
    return centroid
}

// Promote a tight cluster of atoms into a concept. Returns the new concept id,
// or -1 if the cluster's mean pairwise similarity does not exceed
// CONCEPT_PROMOTE. The concept records member handles, its kg_span, and a
// semantic facet vector (the member-embedding centroid / bundle).
fn concept_promote(layer, atoms) {
    if len(atoms) == 0 { return -1 }
    if _atoms_coherence(atoms) <= CONCEPT_PROMOTE { return -1 }
    let id = concept_new(layer)
    let c = concept_get(layer, id)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        push(c[C_MEMBERS], handle_new(atom_kg(a), atom_id(a)))
        if contains(c[C_KGSPAN], atom_kg(a)) == 0 {
            push(c[C_KGSPAN], atom_kg(a))
        }
        i = i + 1
    }
    list_set(c[C_VECTORS], VEC_SEMANTIC, _concept_semantic_facet(atoms))
    return id
}

// Establish a parent -> child DAG edge. Refuses (returns 0) if it would create
// a cycle (child is already an ancestor of parent) or is a self-link.
fn _descendants(layer, start) {
    let seen = list_new()
    let frontier = list_new()
    push(frontier, start)
    while len(frontier) > 0 {
        let cur = frontier[len(frontier) - 1]
        list_remove(frontier, len(frontier) - 1)
        let kids = concept_children(layer, cur)
        let i = 0
        while i < len(kids) {
            if contains(seen, kids[i]) == 0 {
                push(seen, kids[i])
                push(frontier, kids[i])
            }
            i = i + 1
        }
    }
    return seen
}

fn concept_link(layer, parent_id, child_id) {
    if parent_id == child_id { return 0 }
    let parent = concept_get(layer, parent_id)
    let child = concept_get(layer, child_id)
    if parent == 0 { return 0 }
    if child == 0 { return 0 }
    // Cycle guard: parent must not already be a descendant of child.
    if contains(_descendants(layer, child_id), parent_id) == 1 { return 0 }
    if contains(parent[C_CHILDREN], child_id) == 0 {
        push(parent[C_CHILDREN], child_id)
    }
    if contains(child[C_PARENTS], parent_id) == 0 {
        push(child[C_PARENTS], parent_id)
    }
    return 1
}

// ---- schema slots ---------------------------------------------------------
fn _concept_slot(c, name) {
    let slots = c[C_SLOTS]
    let i = 0
    while i < len(slots) {
        if str_eq(slots[i][CS_NAME], name) == 1 { return slots[i] }
        i = i + 1
    }
    return 0
}

fn concept_add_slot(layer, id, name, ftype) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    if _concept_slot(c, name) != 0 { return 1 }
    let slot = list_new()
    push(slot, name)
    push(slot, ftype)
    push(slot, 0)
    push(slot, 0)
    push(c[C_SLOTS], slot)
    return 1
}

fn concept_slot_count(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    return len(c[C_SLOTS])
}

// Fill an existing slot with a value. Returns 0 if the concept/slot is unknown.
fn concept_fill_slot(layer, id, name, value) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    let slot = _concept_slot(c, name)
    if slot == 0 { return 0 }
    list_set(slot, CS_FILLED, 1)
    list_set(slot, CS_VALUE, value)
    return 1
}

fn concept_slot_value(layer, id, name) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    let slot = _concept_slot(c, name)
    if slot == 0 { return 0 }
    return slot[CS_VALUE]
}

// Schema fill ratio in milli (filled slots / total slots); 0 if no slots. This
// is the COMP_UNDERSTAND grounding for the competence tracker (ADR-0020).
fn concept_fill_ratio(layer, id) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    let slots = c[C_SLOTS]
    let total = len(slots)
    if total == 0 { return 0 }
    let filled = 0
    let i = 0
    while i < total {
        if slots[i][CS_FILLED] == 1 { filled = filled + 1 }
        i = i + 1
    }
    return filled * FP_SCALE / total
}

// Names of unfilled slots -- the concept's knowledge gaps (ADR-0018/0026).
fn concept_gaps(layer, id) {
    let gaps = list_new()
    let c = concept_get(layer, id)
    if c == 0 { return gaps }
    let slots = c[C_SLOTS]
    let i = 0
    while i < len(slots) {
        if slots[i][CS_FILLED] == 0 { push(gaps, slots[i][CS_NAME]) }
        i = i + 1
    }
    return gaps
}

// ---- facet vectors --------------------------------------------------------
fn concept_set_vector(layer, id, facet, vec) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    if facet < 1 { return 0 }
    if facet > VEC_FACET_MAX { return 0 }
    list_set(c[C_VECTORS], facet, vec)
    return 1
}

fn concept_vector(layer, id, facet) {
    let c = concept_get(layer, id)
    if c == 0 { return 0 }
    if facet < 1 { return 0 }
    if facet > VEC_FACET_MAX { return 0 }
    return c[C_VECTORS][facet]
}

// Similarity of two concepts on a facet (milli); 0 if either lacks the facet.
fn concept_facet_similarity(layer, id1, id2, facet) {
    let v1 = concept_vector(layer, id1, facet)
    let v2 = concept_vector(layer, id2, facet)
    if v1 == 0 { return 0 }
    if v2 == 0 { return 0 }
    return vec_cosine(v1, v2)
}
