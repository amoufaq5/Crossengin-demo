// CrossEngin Phase 0 pt3: chain compiler.
//
// Purpose
//   Compile hot two-hop forward-chain segments into direct derived
//   operator atoms. When a chain A -> B -> C has both legs' Hebbian
//   synapse weights at or above a threshold, mint a derived rop_* atom
//   A -> C labeled with its via-B provenance. The original chain stays
//   intact in the KG so /why can still trace it.
//
//   Rationale: once a two-hop chain is reinforced strongly, we want next
//   traversal to pick A -> C directly instead of re-exploring A -> B
//   then B -> C. The derived operator plugs into the same scoring code
//   (confidence * source_authority * synapse_weight) used by _cr_chain,
//   so the router picks it automatically on next matching query.
//
//   Trigger: router_apply_feedback (chat /good) invokes
//   chain_compile_from_ops_csv after bumping the per-leg synapse
//   weights. The compile pass is O(len(ops)) in bookkeeping and never
//   runs on the inference hot path -- only on explicit user
//   reinforcement.
//
// NOVA dependencies: builtins (lists, strings, split_char, str_to_int,
//   str_trim, int_to_str, push, len, list_set, list_new).
// CrossEngin dependencies:
//   src/substrate/synapse_graph.nova (syn_find + syn_weight),
//   src/parts/reasoning/reasoning_atoms.nova (rop_new + rop_* getters +
//     ROP_IMPLY), src/kg/multi_kg_manager.nova (kg_atom),
//   src/kg/atom_store.nova (atom_id + atom_label).

import "std/io"
import "std/string"
import "std/syscall"
import "../substrate/synapse_graph.nova"
import "../parts/reasoning/reasoning_atoms.nova"
import "./multi_kg_manager.nova"
import "./atom_store.nova"

// Threshold (milli): a leg is "hot" at or above this. Default 500 =
// half of W_MAX; typical paths reach it after ~5 /good reinforcements
// (each /good adds 100 milli in router_apply_feedback, pre-saturation).
let CHAIN_COMPILE_THRESHOLD = 500
let CHAIN_COMPILE_LABEL_TAG = "cc:"

// Session-scoped registry of minted operator atom ids. /__compiled__
// in the chat example reads this via chain_compile_count +
// chain_compile_registry.
let _cc_registry = list_new()

fn chain_compile_registry() { return _cc_registry }
fn chain_compile_count() { return len(_cc_registry) }

fn chain_compile_reset() {
    _cc_registry = list_new()
    return 1
}

fn chain_compile_threshold() { return CHAIN_COMPILE_THRESHOLD }

// Compile from a chain's operator ids (CSV, in traversal order, as
// produced by _cr_ops_csv). kg = reasoning KG, syn_g = synapse graph
// bound in cognitive_router. Returns the count newly minted. A no-op
// when syn_g is unwired, when ops_csv has fewer than 2 ops, or when
// no consecutive pair clears the threshold.
fn chain_compile_from_ops_csv(kg, syn_g, ops_csv) {
    if syn_g == 0 { return 0 }
    if len(ops_csv) == 0 { return 0 }
    let ids = split_char(ops_csv, 44)
    let n = len(ids)
    if n < 2 { return 0 }
    let minted = 0
    let i = 0
    while i < n - 1 {
        let t1 = str_trim(ids[i])
        let t2 = str_trim(ids[i + 1])
        if len(t1) > 0 { if len(t2) > 0 {
            let id1 = str_to_int(t1)
            let id2 = str_to_int(t2)
            let o1 = kg_atom(kg, id1)
            let o2 = kg_atom(kg, id2)
            if o1 != 0 { if o2 != 0 {
                let a = rop_premise(o1)
                let b = rop_conclusion(o1)
                let b2 = rop_premise(o2)
                let c = rop_conclusion(o2)
                // Only compile if the two hops share the middle node.
                if b == b2 {
                    let s1 = syn_find(syn_g, a, b)
                    let s2 = syn_find(syn_g, b, c)
                    if s1 >= 0 { if s2 >= 0 {
                        let w1 = syn_weight(syn_g, s1)
                        let w2 = syn_weight(syn_g, s2)
                        if w1 >= CHAIN_COMPILE_THRESHOLD {
                            if w2 >= CHAIN_COMPILE_THRESHOLD {
                                if _cc_already_compiled(kg, a, c) == 0 {
                                    let lbl = _cc_label(kg, a, b, c)
                                    let new_op = rop_new(kg, ROP_IMPLY, a, c, lbl, 0)
                                    push(_cc_registry, atom_id(new_op))
                                    minted = minted + 1
                                }
                            }
                        }
                    } }
                }
            } }
        } }
        i = i + 1
    }
    return minted
}

// Dedup: has a derived A -> C already been compiled in this session?
fn _cc_already_compiled(kg, a, c) {
    let i = 0
    while i < len(_cc_registry) {
        let op = kg_atom(kg, _cc_registry[i])
        if op != 0 {
            if rop_premise(op) == a {
                if rop_conclusion(op) == c {
                    return 1
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn _cc_label_of(kg, cid) {
    let a = kg_atom(kg, cid)
    if a == 0 { return "" }
    return atom_label(a)
}

fn _cc_label(kg, a, b, c) {
    return CHAIN_COMPILE_LABEL_TAG + _cc_label_of(kg, a) + "->" + _cc_label_of(kg, c)
         + " [via " + _cc_label_of(kg, b) + "]"
}

// Pretty-print a single compiled op: "A -> C [via B]  w1=..  w2=.."
// Caller supplies the kg (for labels) and syn_g (for current leg
// weights at render time). Returns "" if the atom id is stale.
fn chain_compile_render(kg, syn_g, op_id) {
    let op = kg_atom(kg, op_id)
    if op == 0 { return "" }
    let a = rop_premise(op)
    let c = rop_conclusion(op)
    let lbl = atom_label(op)
    let la = _cc_label_of(kg, a)
    let lc = _cc_label_of(kg, c)
    let s = lbl + " (" + la + " -> " + lc + ")"
    return s
}
