// KG-licenses: the license-terms table (ADR-0087, Rule 3 commercial cleanliness).
//
// An atom's provenance carries an interned `license` CODE (atom_store.nova's
// LICENSE_* constants). This module is the table those codes intern INTO: it
// maps each code to the license's terms, so the engine can prove a knowledge
// base is commercially clean and honor attribution / share-alike obligations.
// Per ADR-0091, an atom whose license is not commercial-clean belongs in the
// quarantine partition that the Edge and Enterprise editions exclude.
//
// A license record is a fixed list:
//   [spdx_or_name, commercial_use, attribution_required, share_alike, url]
// commercial_use / attribution_required / share_alike are 1/0 flags.

import "atom_store.nova"

let LIC_NAME        = 0   // SPDX id or human name (string)
let LIC_COMMERCIAL  = 1   // 1 = derived facts may be used commercially
let LIC_ATTRIBUTION = 2   // 1 = attribution required
let LIC_SHARE_ALIKE = 3   // 1 = derivatives must keep the same license
let LIC_URL         = 4   // canonical license URL (string)

fn lic_record(name, commercial, attribution, share_alike, url) {
    let r = list_new()
    push(r, name)
    push(r, commercial)
    push(r, attribution)
    push(r, share_alike)
    push(r, url)
    return r
}

// Build the default license registry, indexed by license code so that
// `reg[code]` is the record for that code (codes are atom_store.nova's
// LICENSE_* constants, assigned 0..4 in declaration order).
fn lic_registry_new() {
    let reg = list_new()
    // LICENSE_UNKNOWN (0): unresolved -> NOT commercial-clean (quarantine).
    push(reg, lic_record("unknown", 0, 0, 0, ""))
    // LICENSE_OWNER (1): user-taught (ADR-0027) -> clean, owned.
    push(reg, lic_record("owner", 1, 0, 0, ""))
    // LICENSE_OPEN (2): public-domain / permissive -> clean, no obligations.
    push(reg, lic_record("public-domain", 1, 0, 0, ""))
    // LICENSE_CC_BY_SA (3): commercial ok, attribution + share-alike required.
    push(reg, lic_record("CC-BY-SA-4.0", 1, 1, 1,
        "https://creativecommons.org/licenses/by-sa/4.0/"))
    // LICENSE_PROPRIETARY (4): encumbered -> NOT commercial-clean (quarantine).
    push(reg, lic_record("proprietary", 0, 0, 0, ""))
    return reg
}

// Look up a code's record; an out-of-range / negative code resolves to UNKNOWN
// (fail safe: unknown licenses are treated as not-clean).
fn lic_get(reg, code) {
    if code < 0 { return reg[LICENSE_UNKNOWN] }
    if code >= len(reg) { return reg[LICENSE_UNKNOWN] }
    return reg[code]
}

fn lic_name(reg, code)                { return lic_get(reg, code)[LIC_NAME] }
fn lic_commercial_ok(reg, code)       { return lic_get(reg, code)[LIC_COMMERCIAL] }
fn lic_attribution_required(reg, code){ return lic_get(reg, code)[LIC_ATTRIBUTION] }
fn lic_share_alike(reg, code)         { return lic_get(reg, code)[LIC_SHARE_ALIKE] }

// Registry-free commercial-cleanliness for the BUILT-IN codes. The live learning
// loop has no registry threaded through, so this mirrors lic_registry_new's
// commercial_use flags for the built-ins. UNKNOWN/PROPRIETARY (and anything
// unrecognized) are not clean.
fn lic_code_clean(code) {
    if code == LICENSE_OWNER { return 1 }
    if code == LICENSE_OPEN { return 1 }
    if code == LICENSE_CC_BY_SA { return 1 }
    return 0
}

// Register a new license code at the next index (returns the assigned code).
// Lets ingestion add licenses beyond the built-ins.
fn lic_register(reg, name, commercial, attribution, share_alike, url) {
    let code = len(reg)
    push(reg, lic_record(name, commercial, attribution, share_alike, url))
    return code
}

// ---- atom-level cleanliness gate (ADR-0087 / ADR-0091) --------------------

// Is this atom commercial-clean given the license registry? True iff its
// license code maps to a commercial_use=1 record. This is the build-time
// gate the Edge/Enterprise editions use to exclude the quarantine partition;
// it supersedes atom_store's coarse `atom_is_clean` (license != UNKNOWN) by
// checking the actual license terms.
fn atom_license_clean(reg, a) {
    return lic_commercial_ok(reg, atom_license(a))
}

// Does using this atom commercially require attribution / share-alike?
fn atom_requires_attribution(reg, a) {
    return lic_attribution_required(reg, atom_license(a))
}

fn atom_requires_share_alike(reg, a) {
    return lic_share_alike(reg, atom_license(a))
}

// ---- ingestion-time license resolution (ADR-0087) -------------------------
// "Resolve a license for every fetched source before any atom is minted."
// Maps a source string (a fetch URL or a provenance tag like "rss:<url>") to a
// license code, so the ingestion pipeline can stamp atoms with real terms and
// route unresolved ones to the quarantine partition (LICENSE_UNKNOWN).

// Substring test (no global helper exists). Returns 1 if `needle` occurs in `s`.
fn _lic_contains(s, needle) {
    if s == 0 { return 0 }
    let sl = len(s)
    let nl = len(needle)
    if nl == 0 { return 1 }
    if nl > sl { return 0 }
    let last = sl - nl
    let i = 0
    while i <= last {
        let j = 0
        let matched = 1
        while j < nl {
            if char_at(s, i + j) != char_at(needle, j) {
                matched = 0
                j = nl
            } else {
                j = j + 1
            }
        }
        if matched == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Resolve a fetched source to a license code. Known open sources map to their
// real terms; anything unrecognized resolves to UNKNOWN (-> quarantine), so the
// pipeline fails safe rather than minting commercially-unclean atoms.
fn lic_resolve_source(source) {
    if source == 0 { return LICENSE_UNKNOWN }
    if _lic_contains(source, "wikipedia") == 1 { return LICENSE_CC_BY_SA }
    if _lic_contains(source, "user-taught") == 1 { return LICENSE_OWNER }
    if _lic_contains(source, "owner") == 1 { return LICENSE_OWNER }
    return LICENSE_UNKNOWN
}

// Stamp an atom's license from its source string (call at mint time). Returns
// the resolved license code.
fn atom_resolve_license(a, source) {
    let code = lic_resolve_source(source)
    atom_set_license(a, code)
    return code
}
