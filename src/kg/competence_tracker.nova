// CrossEngin knowledge: self-model competence tracking.
//
// Purpose
//   The self-model tracks, per domain, what the system can do and how reliably
//   -- computed from the substrate's own state, never asserted (ADR-0020).
//   Three kinds of competence are grounded in three places:
//     COMP_KNOW       mean atom confidence in the domain KG (ADR-0016 beliefs)
//     COMP_DO         mean reliability of skills tied to the domain (ADR-0019)
//     COMP_UNDERSTAND mean schema-slot fill ratio of concepts spanning the
//                     domain (ADR-0018)
//   Each assessment yields a tier -- CAPABLE / PARTIAL / AWARE / UNKNOWN -- so
//   the system can answer "what can you do?" honestly and never overstate
//   (TIER_AWARE means "I know of it but can't reliably do it").
//
//   All reliabilities are milli (0..1000). Thresholds per ADR-0020:
//   CAPABLE = mean>=0.75 AND evidence>=20; PARTIAL = mean>=0.5; AWARE = grounded
//   but below 0.5; UNKNOWN = no grounding.
//
// ADRs implemented: ADR-0020 (self-model competence). Grounds in ADR-0016
//   (atom belief), ADR-0018 (concept schema), ADR-0019 (skill reliability).
// NOVA dependencies: builtins (lists, str_eq, contains).
// CrossEngin dependencies: src/kg/multi_kg_manager.nova,
//   src/kg/cross_kg_references.nova, src/kg/skills_kg.nova,
//   src/kg/concept_layer.nova.

import "cross_kg_references.nova"
import "skills_kg.nova"
import "concept_layer.nova"

// ---- competence kinds and tiers (ADR-0020) --------------------------------
let COMP_KNOW       = 1
let COMP_DO         = 2
let COMP_UNDERSTAND = 3

let TIER_UNKNOWN = 0
let TIER_AWARE   = 1
let TIER_PARTIAL = 2
let TIER_CAPABLE = 3

let TIER_CAPABLE_MEAN = 750
let TIER_CAPABLE_EVID = 20
let TIER_PARTIAL_MEAN = 500

// ---- record layout --------------------------------------------------------
let CMP_TAG      = 0
let CMP_DOMAIN   = 1
let CMP_KIND     = 2
let CMP_GROUNDING= 3   // number of grounding atoms/skills/concepts
let CMP_REL      = 4   // aggregated posterior mean (milli)
let CMP_EVID     = 5   // summed evidence count
let CMP_LASTUSED = 6
let CMP_GAPS     = 7   // list of gap descriptions
let CMP_OBJ_TAG  = 2001

fn _comp_build(domain, kind) {
    let r = list_new()
    push(r, CMP_OBJ_TAG)
    push(r, domain)
    push(r, kind)
    push(r, 0)
    push(r, 0)
    push(r, 0)
    push(r, 0)
    push(r, list_new())
    return r
}

fn competence_domain(r)         { return r[CMP_DOMAIN] }
fn competence_kind(r)           { return r[CMP_KIND] }
fn competence_grounding_count(r){ return r[CMP_GROUNDING] }
fn competence_reliability(r)    { return r[CMP_REL] }
fn competence_evidence(r)       { return r[CMP_EVID] }
fn competence_last_used(r)      { return r[CMP_LASTUSED] }
fn competence_gaps(r)           { return r[CMP_GAPS] }

fn competence_tier(r) {
    if r[CMP_GROUNDING] == 0 { return TIER_UNKNOWN }
    let mean = r[CMP_REL]
    if mean >= TIER_CAPABLE_MEAN {
        if r[CMP_EVID] >= TIER_CAPABLE_EVID { return TIER_CAPABLE }
    }
    if mean >= TIER_PARTIAL_MEAN { return TIER_PARTIAL }
    return TIER_AWARE
}

fn competence_tier_name(t) {
    if t == TIER_CAPABLE { return "capable" }
    if t == TIER_PARTIAL { return "partial" }
    if t == TIER_AWARE   { return "aware" }
    return "unknown"
}

// COMP_KNOW: mean atom confidence and total evidence over a domain KG.
fn competence_assess_know(kg, moment) {
    let r = _comp_build(kg_label(kg), COMP_KNOW)
    let atoms = kg_atoms(kg)
    let n = len(atoms)
    if n == 0 { return r }
    let sum_conf = 0
    let sum_evid = 0
    let i = 0
    while i < n {
        let a = atoms[i]
        if a != 0 { // reclamation: skip freed (0) slots
            sum_conf = sum_conf + atom_confidence(a)
            sum_evid = sum_evid + atom_evidence(a)
        }
        i = i + 1
    }
    list_set(r, CMP_GROUNDING, n)
    list_set(r, CMP_REL, sum_conf / n)
    list_set(r, CMP_EVID, sum_evid)
    list_set(r, CMP_LASTUSED, moment)
    return r
}

// Is a skill tied to a domain (has a cross-ref into it)?
fn _skill_tied(skill, domain) {
    let xr = atom_xrefs(skill)
    let i = 0
    while i < len(xr) {
        if str_eq(xref_dst_kg(xr[i]), domain) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// COMP_DO: mean reliability and total executions over skills tied to the
// domain. If domain is the skills KG itself, every skill counts. Retired
// skills are recorded as gaps.
fn competence_assess_do(skills_kg, domain, moment) {
    let r = _comp_build(domain, COMP_DO)
    let include_all = str_eq(kg_label(skills_kg), domain)
    let atoms = kg_atoms(skills_kg)
    let sum_rel = 0
    let sum_exec = 0
    let count = 0
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 { // reclamation: skip freed (0) slots
            if atom_kind(a) == ATOM_SKILL {
                let tied = include_all
                if tied == 0 { tied = _skill_tied(a, domain) }
                if tied == 1 {
                    sum_rel = sum_rel + skill_reliability(a)
                    sum_exec = sum_exec + skill_executions(a)
                    count = count + 1
                    if skill_should_retire(a) == 1 {
                        push(r[CMP_GAPS], atom_label(a))
                    }
                }
            }
        }
        i = i + 1
    }
    if count == 0 { return r }
    list_set(r, CMP_GROUNDING, count)
    list_set(r, CMP_REL, sum_rel / count)
    list_set(r, CMP_EVID, sum_exec)
    list_set(r, CMP_LASTUSED, moment)
    return r
}

// COMP_UNDERSTAND: mean schema fill ratio over concepts spanning the domain.
// Evidence is the total number of filled slots; unfilled slots become gaps.
fn competence_assess_understand(layer, domain, moment) {
    let r = _comp_build(domain, COMP_UNDERSTAND)
    let n = concept_count(layer)
    let sum_ratio = 0
    let filled_total = 0
    let count = 0
    let id = 0
    while id < n {
        if contains(concept_kg_span(layer, id), domain) == 1 {
            sum_ratio = sum_ratio + concept_fill_ratio(layer, id)
            let gaps = concept_gaps(layer, id)
            filled_total = filled_total + (concept_slot_count(layer, id) - len(gaps))
            let g = 0
            while g < len(gaps) { push(r[CMP_GAPS], gaps[g]); g = g + 1 }
            count = count + 1
        }
        id = id + 1
    }
    if count == 0 { return r }
    list_set(r, CMP_GROUNDING, count)
    list_set(r, CMP_REL, sum_ratio / count)
    list_set(r, CMP_EVID, filled_total)
    list_set(r, CMP_LASTUSED, moment)
    return r
}

// ---- self-model: a registry of competence records ------------------------
let SM_TAG     = 0
let SM_RECORDS = 1

fn self_model_new() {
    let sm = list_new()
    push(sm, SM_TAG)
    push(sm, list_new())
    return sm
}

// Store (replacing any existing record for the same domain+kind).
fn self_model_set(sm, record) {
    let recs = sm[SM_RECORDS]
    let i = 0
    while i < len(recs) {
        if str_eq(recs[i][CMP_DOMAIN], record[CMP_DOMAIN]) == 1 {
            if recs[i][CMP_KIND] == record[CMP_KIND] {
                list_set(recs, i, record)
                return 1
            }
        }
        i = i + 1
    }
    push(recs, record)
    return 1
}

fn self_model_get(sm, domain, kind) {
    let recs = sm[SM_RECORDS]
    let i = 0
    while i < len(recs) {
        if str_eq(recs[i][CMP_DOMAIN], domain) == 1 {
            if recs[i][CMP_KIND] == kind { return recs[i] }
        }
        i = i + 1
    }
    return 0
}

fn self_model_count(sm) { return len(sm[SM_RECORDS]) }

// Serializable snapshot (the records list) for persistence (ADR-0048).
fn self_model_snapshot(sm) { return sm[SM_RECORDS] }

// ---- persistence (ADR-0048): restore helpers ------------------------------
//
// snapshot_disk needs to walk every recorded competence (iteration covered by
// self_model_snapshot) and re-install (domain, kind, know/do/understand,
// tier-derived state) on /load. Build a record directly from primitive values
// rather than re-running the assessment over the live KGs (which the snapshot
// boot order can't guarantee yet -- the self-model section is applied AFTER
// KGS, but the synapses + episodic state above it may not be live yet).

// Wipe the self-model back to empty. /load policy is REPLACE.
fn self_model_clear(sm) {
    list_set(sm, SM_RECORDS, list_new())
    return 1
}

// Build a competence record directly from snapshot fields. Grounding and
// evidence are NOT in the wire format -- the tier-defining numbers are
// reliability (CMP_REL) and evidence counts, but the wire intentionally only
// captures rel/tier-relevant aggregates per the brief's spec. We set
// grounding=1 so competence_tier()'s "TIER_UNKNOWN if grounding==0" gate is
// not tripped; evidence is encoded so the TIER_CAPABLE gate is preserved.
fn self_model_restore(sm, domain, kind, reliability, evidence) {
    let r = _comp_build(domain, kind)
    list_set(r, CMP_GROUNDING, 1)
    list_set(r, CMP_REL, reliability)
    list_set(r, CMP_EVID, evidence)
    self_model_set(sm, r)
    return r
}
