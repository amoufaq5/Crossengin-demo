// CrossEngin knowledge: schemas (entity-type validation).
//
// Purpose
//   A schema declares the typed slots an entity of some kind is expected to
//   have (ADR-0018): required fields, optional fields with defaults, and
//   min/max constraints on integer-valued fields. Schemas validate atom
//   payloads and concept instances, and supply defaults when instantiating.
//   This is the validation machinery the concept layer's per-concept schemas
//   build on; it is standalone so it can also validate raw entity property sets.
//
//   Property sets are scanned lists of [key, value] pairs (a builtin map would
//   hit NOVA's 16-key cap; see NEXT_SESSION.md).
//
// ADRs implemented: ADR-0018 (schema system for entity-type validation).
// NOVA dependencies: builtins (lists, type_of, int_to_str) + shared
//   str_eq_bytes workaround for NOVA's flaky str_eq (see
//   src/util/str_safe.nova).
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// Field types.
let FTYPE_INT = 1
let FTYPE_STR = 2
let FTYPE_ANY = 3

// Field layout.
let SF_NAME    = 0
let SF_TYPE    = 1
let SF_REQ     = 2   // 1 = required, 0 = optional
let SF_DEFAULT = 3
let SF_HASMIN  = 4
let SF_MIN     = 5
let SF_HASMAX  = 6
let SF_MAX     = 7

// Schema layout.
let SCH_TAG    = 0
let SCH_NAME   = 1
let SCH_FIELDS = 2
let SCHEMA_OBJ_TAG = 1851

fn schema_new(name) {
    let s = list_new()
    push(s, SCHEMA_OBJ_TAG)
    push(s, name)
    push(s, list_new())
    return s
}

fn schema_name(s) { return s[SCH_NAME] }
fn schema_field_count(s) { return len(s[SCH_FIELDS]) }

fn _schema_field(s, name) {
    let fields = s[SCH_FIELDS]
    let i = 0
    while i < len(fields) {
        if str_eq_bytes(fields[i][SF_NAME], name) == 1 { return fields[i] }
        i = i + 1
    }
    return 0
}

fn _schema_add(s, name, ftype, required, default_val) {
    let existing = _schema_field(s, name)
    if existing != 0 { return existing }
    let f = list_new()
    push(f, name)
    push(f, ftype)
    push(f, required)
    push(f, default_val)
    push(f, 0)   // has_min
    push(f, 0)   // min
    push(f, 0)   // has_max
    push(f, 0)   // max
    push(s[SCH_FIELDS], f)
    return f
}

fn schema_add_required(s, name, ftype) {
    return _schema_add(s, name, ftype, 1, 0)
}

fn schema_add_optional(s, name, ftype, default_val) {
    return _schema_add(s, name, ftype, 0, default_val)
}

fn schema_required_count(s) {
    let fields = s[SCH_FIELDS]
    let n = 0
    let i = 0
    while i < len(fields) {
        if fields[i][SF_REQ] == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Add a min or max constraint to an existing field. kind is "min" or "max".
// Returns 1 on success, 0 if the field is unknown.
fn schema_add_constraint(s, name, kind, value) {
    let f = _schema_field(s, name)
    if f == 0 { return 0 }
    if str_eq_bytes(kind, "min") == 1 {
        list_set(f, SF_HASMIN, 1)
        list_set(f, SF_MIN, value)
        return 1
    }
    if str_eq_bytes(kind, "max") == 1 {
        list_set(f, SF_HASMAX, 1)
        list_set(f, SF_MAX, value)
        return 1
    }
    return 0
}

fn _props_has(props, key) {
    let i = 0
    while i < len(props) {
        if str_eq_bytes(props[i][0], key) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _props_get(props, key) {
    let i = 0
    while i < len(props) {
        if str_eq_bytes(props[i][0], key) == 1 { return props[i][1] }
        i = i + 1
    }
    return 0
}

fn _type_ok(ftype, value) {
    if ftype == FTYPE_ANY { return 1 }
    let t = type_of(value)
    if ftype == FTYPE_INT {
        if t == 1 { return 1 }
        return 0
    }
    if ftype == FTYPE_STR {
        if t == 2 { return 1 }
        return 0
    }
    return 1
}

// Validate a property set (list of [key, value]) against the schema. Returns a
// list of human-readable error strings; an empty list means valid.
fn schema_validate(s, props) {
    let errors = list_new()
    let fields = s[SCH_FIELDS]
    let i = 0
    while i < len(fields) {
        let f = fields[i]
        let name = f[SF_NAME]
        let present = _props_has(props, name)
        if present == 0 {
            if f[SF_REQ] == 1 {
                push(errors, "missing required field: " + name)
            }
        } else {
            let value = _props_get(props, name)
            if _type_ok(f[SF_TYPE], value) == 0 {
                push(errors, "wrong type for field: " + name)
            } else {
                if type_of(value) == 1 {
                    if f[SF_HASMIN] == 1 {
                        if value < f[SF_MIN] {
                            push(errors, "below min for field: " + name)
                        }
                    }
                    if f[SF_HASMAX] == 1 {
                        if value > f[SF_MAX] {
                            push(errors, "above max for field: " + name)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return errors
}

fn schema_is_valid(s, props) {
    if len(schema_validate(s, props)) == 0 { return 1 }
    return 0
}

// Instantiate: copy provided values and fill optional defaults for any missing
// optional field. Returns a new property list of [key, value].
fn schema_instantiate(s, values) {
    let inst = list_new()
    let i = 0
    while i < len(values) {
        let pair = list_new()
        push(pair, values[i][0])
        push(pair, values[i][1])
        push(inst, pair)
        i = i + 1
    }
    let fields = s[SCH_FIELDS]
    let j = 0
    while j < len(fields) {
        let f = fields[j]
        if f[SF_REQ] == 0 {
            if _props_has(inst, f[SF_NAME]) == 0 {
                let pair = list_new()
                push(pair, f[SF_NAME])
                push(pair, f[SF_DEFAULT])
                push(inst, pair)
            }
        }
        j = j + 1
    }
    return inst
}
