// CrossEngin federation: distributed rule inference -- mini-Datalog
// rules running across the gossip mesh (R21B).
//
// Purpose
//   R20B (`src/kg/rule_inference.nova`) ships forward-chaining mini-
//   Datalog rule inference on a SINGLE local KG: rules look like
//   `RULE ancestor(?a, ?c) <- ancestor(?a, ?b) AND parent(?b, ?c)`,
//   facts live as RELATION-kind atoms labelled "pred|arg1|arg2", and
//   the engine iterates to fixpoint. R20E
//   (`src/federation/distributed_query.nova`) ships distributed SPARQL
//   query: fan-out across the R18E gossip mesh, each peer evaluates
//   locally against its own KG, the originator merges per-row
//   provenance back. R21B is the bridge: declarative INFERENCE that
//   ALSO crosses the mesh.
//
//   The classical motivating case: peer A has `parent(alice, bob)`,
//   peer B has `parent(bob, carol)`, neither alone can derive
//   `ancestor(alice, carol)` because each is missing one premise.
//   With R21B, the ancestor rule's premise patterns are evaluated
//   against the FEDERATED fact set -- premise 1 (`ancestor(?a, ?b)`)
//   may come from peer A while premise 2 (`parent(?b, ?c)`) may come
//   from peer B; the cross-soul join produces the conclusion. The
//   derivation is then broadcast as a DERIVATION line so peer C (with
//   no relevant local facts) also sees `ancestor(alice, carol)` in
//   its KG.
//
// Protocol (additive on top of R18E gossip)
//
//   1. RULE broadcast -- `dr_add_rule(dr, rule_string)`:
//        - parse + append into the LOCAL rule engine (R20B engine, no
//          modifications)
//        - send `RULE <rule_string>\n` to every alive peer
//      Peers receive RULE via the gossip handler (gossip.nova R21B
//      branch); the line is enqueued on dr_state's inbound-rule
//      queue and drained on the next `dr_run_round`. The queue avoids
//      a gossip <-> distributed_rules import cycle.
//
//   2. DRFETCH fan-out -- for each rule premise predicate, the
//      originator pulls the full set of relation atoms for that
//      predicate from every alive peer. `gossip_dr_fetch_from(state,
//      addr, pred)` does the TCP round trip:
//          DRFETCH <pred>\n  ->
//          DRFACT <peer_addr> <pred> <arg1> <arg2> <atom_id>\n  (n times)
//          DREND\n
//      Local facts are read directly from the KG (no wire trip).
//      Every returned fact carries an annotation: the originating
//      peer_addr. That annotation feeds provenance.
//
//   3. Cross-peer cross-join -- the originator joins the federated
//      fact set just like a local Datalog evaluator joins facts. The
//      premise matcher emits one binding per fact match; multi-premise
//      rules cartesian-product against the previous premise's
//      bindings. Each emitted binding carries a "contributors" set:
//      which peer addresses provided which premise atoms.
//
//   4. Conclusion -- for each satisfied binding, the originator:
//        - constructs the canonical "pred|arg1|arg2" label
//        - kg_find_atom(kg, label) -> if already present, skip (dedupe)
//        - kg_add_atom(kg, ATOM_RELATION, label, 0) -> new atom
//        - records provenance: [atom_id, rule_idx, [contributor_addrs]]
//        - broadcasts DERIVATION so peers can cache the fact
//
//   5. Fixpoint -- `dr_run_to_fixpoint(dr, max_rounds)` repeats step
//      2-4 until no new atoms are derived in a round or the cap fires.
//
// Provenance shape
//
//   `dr_derivation_provenance(dr, atom_id)` returns
//       [rule_name_or_idx, peer_addr_1, peer_addr_2, ...]
//   where rule_name_or_idx is the head predicate name of the rule
//   that produced the atom (per the brief's "(which rule)" spec) and
//   the peer_addrs are the unique addresses that supplied any premise
//   atom for the firing (the "(which peers contributed which
//   premises)" spec, in the order they were used by the cross-join).
//   The originator's own self_addr is included if any premise came
//   from the local KG.
//
// Trust model
//
//   The gossip mesh is the SAME shape R18E ships -- assume mutually
//   non-malicious peers (or pair with the R7C Noise XK auth + R20F
//   attestation surface for adversarial settings). The R21B substrate
//   adds no new cryptographic guarantees beyond what gossip provides;
//   provenance is informational, not a signed receipt. A malicious
//   peer can fabricate DRFACT or DERIVATION lines -- defense for that
//   threat lives one layer up (e.g. signed-fact attestations, similar
//   shape to R20F).
//
// Public API
//
//   dr_init(gossip_state, rule_engine)        -> dr_state
//   dr_add_rule(dr, rule_string)              -> 1 | error
//   dr_run_round(dr, kg)                      -> int (atoms derived
//                                                this round)
//   dr_run_to_fixpoint(dr, kg, max_rounds)    -> [total_derived,
//                                                 rounds]
//   dr_derivation_provenance(dr, atom_id)     -> [rule_name, peer1,
//                                                 peer2, ...]
//
//   Plus helpers exercised by unit tests:
//
//   dr_engine(dr)                             -> the wrapped R20B
//                                                engine (rule_engine_t)
//   dr_rule_count(dr)                         -> int
//   dr_stats_line(dr)                         -> one-line summary
//   dr_inbound_rule_count(dr)                 -> # pending RULE lines
//   dr_inbound_deriv_count(dr)                -> # pending DERIVATION
//                                                lines
//
// ADRs: registers ADR-0081 (distributed Datalog over gossip). NOVA
// dependencies: nanotime, str_eq, push, len, list_set, int_to_str.
// CrossEngin dependencies: src/federation/gossip.nova (the R21B
// extension provides RULE/DRFETCH/DERIVATION wire format + state
// slots; we read GOSSIP_DR_INBOUND_RULES + _DERIVS for the dispatch
// queues), src/kg/rule_inference.nova (read-only -- we re-use the
// R20B engine for local rule storage, premise matcher logic
// borrowed inline to handle federated fact set), src/kg/atom_store.nova
// (ATOM_RELATION, atom_id, atom_label, atom_kind), src/kg/
// multi_kg_manager.nova (kg_atoms, kg_add_atom, kg_find_atom,
// kg_atom_count).

import "std/io"
import "./gossip.nova"
import "../kg/atom_store.nova"
import "../kg/multi_kg_manager.nova"
import "../kg/rule_inference.nova"

// ---- tuning -------------------------------------------------------------
let DR_DEFAULT_MAX_ROUNDS  = 50
let DR_DEFAULT_MAX_DERIVED = 5000
let DR_OBJ_TAG             = 2601    // distinct from RULE_OBJ_TAG (2401),
                                     // ENG_OBJ_TAG (2402)

// ---- dr_state layout ----------------------------------------------------
//
// Pinned slot indices 3 and 4 are the inbound queues the gossip handler
// pushes onto (GOSSIP_DR_INBOUND_RULES / GOSSIP_DR_INBOUND_DERIVS at
// 3 and 4 respectively).
let DR_S_TAG               = 0   // DR_OBJ_TAG
let DR_S_GOSSIP            = 1   // gossip_state_t (back-reference)
let DR_S_ENGINE            = 2   // R20B rule_engine_t
let DR_S_INBOUND_RULES     = 3   // queue of inbound rule strings (pinned)
let DR_S_INBOUND_DERIVS    = 4   // queue of inbound derivation records (pinned)
let DR_S_PROVENANCE        = 5   // list of [atom_id, rule_name, [peer_addrs]]
let DR_S_RULE_NAMES        = 6   // parallel to engine rules: head preds
let DR_S_STATS_DERIVED     = 7   // total atoms derived across all rounds
let DR_S_STATS_ROUNDS      = 8   // total rounds run
let DR_S_STATS_RULES_TX    = 9   // RULE lines broadcast (originator side)
let DR_S_STATS_DERIVS_TX   = 10  // DERIVATION lines broadcast
let DR_S_STATS_FETCHES_TX  = 11  // DRFETCH requests sent
let DR_S_LAST_DERIVED      = 12  // # atoms derived in the most recent round
let DR_S_LAST_ROUNDS       = 13  // rounds taken in last to_fixpoint call

// ---- provenance record layout ------------------------------------------
let DR_P_ATOM_ID  = 0
let DR_P_RULE     = 1   // rule head pred (string)
let DR_P_PEERS    = 2   // list of peer_addr strings (unique)

// ---- inbound derivation record layout ----------------------------------
// Mirrors gossip.nova's enqueue shape:
//   [rule_idx, pred, arg1, arg2, origin_addr, contrib_csv]
let DR_D_RULE_IDX = 0
let DR_D_PRED     = 1
let DR_D_ARG1     = 2
let DR_D_ARG2     = 3
let DR_D_ORIGIN   = 4
let DR_D_CONTRIBS = 5

// ---- state constructor --------------------------------------------------

// dr_init wires a gossip state + a R20B rule engine into a federated
// inference state. The engine may be empty or already populated; either
// way it's treated as the LOCAL store -- rules added subsequently via
// dr_add_rule are appended into it AND broadcast.
//
// As a side effect, dr_init installs `dr_state` on the gossip state via
// gossip_set_dr_state so inbound RULE / DRFETCH / DERIVATION lines are
// routed correctly. A daemon that wants to listen for these without
// driving its own inference loop can still wire a dr_state and call
// `dr_run_round` periodically to drain the queues.
fn dr_init(gossip_state, engine) {
    let st = list_new()
    push(st, DR_OBJ_TAG)             // S_TAG
    push(st, gossip_state)           // S_GOSSIP
    push(st, engine)                 // S_ENGINE
    push(st, list_new())             // S_INBOUND_RULES (pinned slot 3)
    push(st, list_new())             // S_INBOUND_DERIVS (pinned slot 4)
    push(st, list_new())             // S_PROVENANCE
    push(st, list_new())             // S_RULE_NAMES
    push(st, 0)                      // S_STATS_DERIVED
    push(st, 0)                      // S_STATS_ROUNDS
    push(st, 0)                      // S_STATS_RULES_TX
    push(st, 0)                      // S_STATS_DERIVS_TX
    push(st, 0)                      // S_STATS_FETCHES_TX
    push(st, 0)                      // S_LAST_DERIVED
    push(st, 0)                      // S_LAST_ROUNDS

    // Backfill rule names from any pre-existing rules in the engine.
    // The R20B engine may have been populated before wrapping -- we
    // mirror the head preds so dr_derivation_provenance can return them
    // by-name even after the engine adds more.
    if rule_engine_is(engine) == 1 {
        let rules = engine[RE_RULES]
        let i = 0
        while i < len(rules) {
            push(st[DR_S_RULE_NAMES], rule_head_pred(rules[i]))
            i = i + 1
        }
    }

    // Register dr_state on the gossip back-reference so the inbound
    // dispatcher knows where to enqueue.
    gossip_set_dr_state(gossip_state, st)

    return st
}

// ---- predicates ---------------------------------------------------------

fn dr_is_state(x) {
    if x == 0 { return 0 }
    if type_of(x) != 3 { return 0 }
    if len(x) < 14 { return 0 }
    if x[DR_S_TAG] == DR_OBJ_TAG { return 1 }
    return 0
}

fn dr_engine(dr)             { return dr[DR_S_ENGINE] }
fn dr_rule_count(dr)         { return rule_engine_size(dr[DR_S_ENGINE]) }
fn dr_inbound_rule_count(dr) { return len(dr[DR_S_INBOUND_RULES]) }
fn dr_inbound_deriv_count(dr) { return len(dr[DR_S_INBOUND_DERIVS]) }
fn dr_stats_derived(dr)      { return dr[DR_S_STATS_DERIVED] }
fn dr_stats_rounds(dr)       { return dr[DR_S_STATS_ROUNDS] }
fn dr_stats_rules_tx(dr)     { return dr[DR_S_STATS_RULES_TX] }
fn dr_stats_derivs_tx(dr)    { return dr[DR_S_STATS_DERIVS_TX] }
fn dr_stats_fetches_tx(dr)   { return dr[DR_S_STATS_FETCHES_TX] }
fn dr_last_derived(dr)       { return dr[DR_S_LAST_DERIVED] }
fn dr_last_rounds(dr)        { return dr[DR_S_LAST_ROUNDS] }

// ---- rule management ----------------------------------------------------

// dr_add_rule parses the rule string locally, appends into the engine,
// records the rule's head predicate name for provenance, and broadcasts
// to every alive peer. Returns 1 on success; an error tuple on local
// parse failure (the broadcast is suppressed in that case).
fn dr_add_rule(dr, rule_string) {
    if dr_is_state(dr) == 0 { return _rule_error("dr_add_rule: bad dr_state") }
    let engine = dr[DR_S_ENGINE]
    let r = rule_engine_add(engine, rule_string)
    if _rule_is_error(r) == 1 { return r }
    // Track the head pred for this rule's index. The engine appends, so
    // its len after the add equals the new rule's idx + 1.
    let rules = engine[RE_RULES]
    let last = rules[len(rules) - 1]
    push(dr[DR_S_RULE_NAMES], rule_head_pred(last))
    // Broadcast to peers. Best-effort: ignore the return count
    // (gossip_broadcast_rule already records timeouts on the gossip
    // stats counters).
    let gs = dr[DR_S_GOSSIP]
    gossip_broadcast_rule(gs, rule_string)
    dr[DR_S_STATS_RULES_TX] = dr[DR_S_STATS_RULES_TX] + 1
    return 1
}

// dr_drain_inbound_rules drains the inbound RULE queue: parses each
// queued rule string locally, adds to the engine (without re-
// broadcasting, to avoid gossip storms). Called at the top of every
// dr_run_round so peers naturally converge on the same rule set. Idempotent
// on duplicate rules: the R20B engine's parser will accept duplicates
// but the rule firing remains dedupe-safe via kg_find_atom.
fn _dr_drain_inbound_rules(dr) {
    let q = dr[DR_S_INBOUND_RULES]
    let engine = dr[DR_S_ENGINE]
    let n_added = 0
    while len(q) > 0 {
        let rule_str = q[0]
        // Pop front: shift left then trim.
        let i = 0
        while i < len(q) - 1 {
            q[i] = q[i + 1]
            i = i + 1
        }
        pop(q)
        let r = rule_engine_add(engine, rule_str)
        if _rule_is_error(r) == 0 {
            let rules = engine[RE_RULES]
            let last = rules[len(rules) - 1]
            push(dr[DR_S_RULE_NAMES], rule_head_pred(last))
            n_added = n_added + 1
        }
    }
    return n_added
}

// ---- federated fact gathering -------------------------------------------
//
// _dr_local_facts_for(kg, pred) -- mirrors R20B's _rule_kg_facts_for but
// also tags each fact with the local self_addr so the cross-join can
// attribute provenance. Returns a list of [peer_addr, arg1, arg2,
// atom_id] records.
fn _dr_local_facts_for(kg, pred, self_addr) {
    let out = list_new()
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 {
            if atom_kind(a) == ATOM_RELATION {
                let label = atom_label(a)
                let parts = _dr_split_label(label)
                if len(parts) == 3 {
                    if str_eq(parts[0], pred) == 1 {
                        let row = list_new()
                        push(row, self_addr)
                        push(row, parts[1])
                        push(row, parts[2])
                        push(row, atom_id(a))
                        push(out, row)
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

// Split a "pred|arg1|arg2" label on the pipe (ASCII 124). The same
// split rule_inference.nova uses; duplicated here so we don't expose
// the R20B private helper.
fn _dr_split_label(label) {
    let parts = list_new()
    let n = len(label)
    let start = 0
    let i = 0
    while i < n {
        if char_at(label, i) == 124 {
            push(parts, substr(label, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(parts, substr(label, start, n - start))
    return parts
}

// _dr_federated_facts_for(dr, kg, pred) -- gather the FULL federated
// set of relation facts for the named predicate. Pulls local facts
// directly from kg + DRFETCHes from every alive peer. Returns a list
// of [peer_addr, arg1, arg2, atom_id] records (each row tagged with
// the originating peer's self_addr for provenance attribution).
fn _dr_federated_facts_for(dr, kg, pred) {
    let gs = dr[DR_S_GOSSIP]
    let self_addr = gossip_self_addr(gs)
    let out = _dr_local_facts_for(kg, pred, self_addr)
    let alive = gossip_alive_peers(gs)
    let i = 0
    while i < len(alive) {
        let p_addr = alive[i]
        if str_eq(p_addr, self_addr) == 0 {
            let peer_rows = gossip_dr_fetch_from(gs, p_addr, pred)
            dr[DR_S_STATS_FETCHES_TX] = dr[DR_S_STATS_FETCHES_TX] + 1
            // peer_rows: list of [peer_addr, pred, arg1, arg2, atom_id].
            // Re-shape to our [peer_addr, arg1, arg2, atom_id] form.
            let j = 0
            while j < len(peer_rows) {
                let r = peer_rows[j]
                if len(r) >= 5 {
                    let rec = list_new()
                    push(rec, r[0])    // peer_addr
                    push(rec, r[2])    // arg1
                    push(rec, r[3])    // arg2
                    push(rec, r[4])    // atom_id (remote)
                    push(out, rec)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

// ---- distributed binding evaluator --------------------------------------
//
// Pure string-valued binding model (mirroring R20B's _rb_new). We
// augment each binding with a __peers__ list (set of unique peer_addrs)
// so multi-premise rules accumulate the contributors set across the
// cross-join. A premise atom contributes its peer_addr to the set.

fn _drb_new() {
    let b = list_new()
    push(b, list_new())   // [0] = list of [name, value] pairs
    push(b, list_new())   // [1] = list of peer_addrs (unique)
    return b
}

fn _drb_vars(b)  { return b[0] }
fn _drb_peers(b) { return b[1] }

fn _drb_has(b, name) {
    let v = b[0]
    let i = 0
    while i < len(v) {
        if str_eq(v[i][0], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _drb_get(b, name) {
    let v = b[0]
    let i = 0
    while i < len(v) {
        if str_eq(v[i][0], name) == 1 { return v[i][1] }
        i = i + 1
    }
    return ""
}

fn _drb_set(b, name, value) {
    let v = b[0]
    let i = 0
    while i < len(v) {
        if str_eq(v[i][0], name) == 1 {
            list_set(v[i], 1, value)
            return 1
        }
        i = i + 1
    }
    let entry = list_new()
    push(entry, name)
    push(entry, value)
    push(v, entry)
    return 1
}

fn _drb_add_peer(b, peer_addr) {
    let p = b[1]
    let i = 0
    while i < len(p) {
        if str_eq(p[i], peer_addr) == 1 { return 0 }
        i = i + 1
    }
    push(p, peer_addr)
    return 1
}

fn _drb_copy(b) {
    let out = _drb_new()
    let v = b[0]
    let i = 0
    while i < len(v) {
        let e = list_new()
        push(e, v[i][0])
        push(e, v[i][1])
        push(out[0], e)
        i = i + 1
    }
    let p = b[1]
    let j = 0
    while j < len(p) {
        push(out[1], p[j])
        j = j + 1
    }
    return out
}

// _dr_match_premise(facts, premise, bindings) -- for every binding in
// `bindings`, try to extend it with each fact in `facts`. A premise's
// args are either bound (we filter facts whose value at that position
// matches the binding) or free (we bind the free var to the fact's
// value at that position). A fact's peer_addr is added to the binding's
// peers set on every successful extension.
fn _dr_match_premise(facts, premise, bindings) {
    let p_args = premise[1]
    let out = list_new()
    let bi = 0
    while bi < len(bindings) {
        let b = bindings[bi]
        let fi = 0
        while fi < len(facts) {
            let f = facts[fi]    // [peer_addr, arg1, arg2, atom_id]
            let cand = _drb_copy(b)
            let ok = 1
            let ai = 0
            while ai < len(p_args) {
                if ok == 1 {
                    let pa = p_args[ai]
                    let fact_val = f[ai + 1]   // skip peer_addr at [0]
                    if pa[0] == RULE_TERM_VAR {
                        let vname = pa[1]
                        if _drb_has(cand, vname) == 1 {
                            if str_eq(_drb_get(cand, vname), fact_val) == 0 {
                                ok = 0
                            }
                        } else {
                            _drb_set(cand, vname, fact_val)
                        }
                    } else {
                        if str_eq(pa[1], fact_val) == 0 {
                            ok = 0
                        }
                    }
                }
                ai = ai + 1
            }
            if ok == 1 {
                _drb_add_peer(cand, f[0])
                push(out, cand)
            }
            fi = fi + 1
        }
        bi = bi + 1
    }
    return out
}

// ---- one round of distributed forward chaining --------------------------
//
// _dr_apply_one(dr, rule, rule_idx, kg) -- apply ONE rule against the
// federated fact set. For each rule premise, build the federated fact
// list (local + DRFETCH from peers), join the bindings, then for each
// satisfied binding instantiate the head and try to add. Returns the
// count of NEW atoms added locally; broadcasts DERIVATION for each.
fn _dr_apply_one(dr, rule, rule_idx, kg) {
    let head_pred = rule_head_pred(rule)
    let head_args = rule_head_args(rule)
    let body = rule_body(rule)
    let gs = dr[DR_S_GOSSIP]
    let self_addr = gossip_self_addr(gs)
    // Seed with one empty binding.
    let bindings = list_new()
    push(bindings, _drb_new())
    let pi = 0
    while pi < len(body) {
        let premise = body[pi]
        let pred = premise[0]
        let facts = _dr_federated_facts_for(dr, kg, pred)
        bindings = _dr_match_premise(facts, premise, bindings)
        pi = pi + 1
    }
    let new_count = 0
    let bi = 0
    while bi < len(bindings) {
        let b = bindings[bi]
        // Substitute head args.
        let head_arg_strs = list_new()
        let ok = 1
        let ai = 0
        while ai < len(head_args) {
            if ok == 1 {
                let ha = head_args[ai]
                if ha[0] == RULE_TERM_VAR {
                    if _drb_has(b, ha[1]) == 0 {
                        ok = 0
                    } else {
                        push(head_arg_strs, _drb_get(b, ha[1]))
                    }
                } else {
                    push(head_arg_strs, ha[1])
                }
            }
            ai = ai + 1
        }
        if ok == 1 {
            let canonical = _dr_canonical_label(head_pred, head_arg_strs)
            let existing = kg_find_atom(kg, canonical)
            if existing == 0 {
                let derived = kg_add_atom(kg, ATOM_RELATION, canonical, 0)
                new_count = new_count + 1
                // Record provenance.
                let peers = _drb_peers(b)
                _dr_record_provenance(dr, atom_id(derived), head_pred, peers)
                // Broadcast derivation.
                let arg1 = head_arg_strs[0]
                let arg2 = ""
                if len(head_arg_strs) > 1 { arg2 = head_arg_strs[1] }
                let csv = _dr_join_csv(peers)
                gossip_broadcast_derivation(gs, rule_idx, head_pred, arg1, arg2, csv)
                dr[DR_S_STATS_DERIVS_TX] = dr[DR_S_STATS_DERIVS_TX] + 1
            }
        }
        bi = bi + 1
    }
    return new_count
}

fn _dr_canonical_label(pred, arg_strs) {
    let s = pred
    let i = 0
    while i < len(arg_strs) {
        s = s + "|" + arg_strs[i]
        i = i + 1
    }
    return s
}

fn _dr_join_csv(items) {
    let s = ""
    let i = 0
    while i < len(items) {
        if i > 0 { s = s + "," }
        s = s + items[i]
        i = i + 1
    }
    if len(s) == 0 { s = "(none)" }
    return s
}

fn _dr_split_csv(s) {
    let out = list_new()
    if str_eq(s, "(none)") == 1 { return out }
    let n = len(s)
    let start = 0
    let i = 0
    while i < n {
        if char_at(s, i) == 44 {
            push(out, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if start < n { push(out, substr(s, start, n - start)) }
    return out
}

// _dr_record_provenance appends a provenance entry. peers is the list
// of contributor peer_addrs.
fn _dr_record_provenance(dr, atom_id_in, rule_name, peers) {
    let rec = list_new()
    push(rec, atom_id_in)
    push(rec, rule_name)
    let plist = list_new()
    let i = 0
    while i < len(peers) {
        push(plist, peers[i])
        i = i + 1
    }
    push(rec, plist)
    push(dr[DR_S_PROVENANCE], rec)
    return rec
}

// ---- inbound DERIVATION drain -------------------------------------------
//
// _dr_drain_inbound_derivs(dr, kg) caches each peer-broadcast
// DERIVATION into the local KG (dedupe via kg_find_atom) and records
// provenance with the contributors decoded from the CSV. Called at the
// top of every dr_run_round so peers converge on the federation's
// derived-fact set.
fn _dr_drain_inbound_derivs(dr, kg) {
    let q = dr[DR_S_INBOUND_DERIVS]
    let n_cached = 0
    while len(q) > 0 {
        let rec = q[0]
        // Pop front.
        let i = 0
        while i < len(q) - 1 {
            q[i] = q[i + 1]
            i = i + 1
        }
        pop(q)
        let rule_idx = rec[DR_D_RULE_IDX]
        let pred = rec[DR_D_PRED]
        let arg1 = rec[DR_D_ARG1]
        let arg2 = rec[DR_D_ARG2]
        let origin = rec[DR_D_ORIGIN]
        let csv = rec[DR_D_CONTRIBS]
        let canonical = pred + "|" + arg1 + "|" + arg2
        let existing = kg_find_atom(kg, canonical)
        if existing == 0 {
            let derived = kg_add_atom(kg, ATOM_RELATION, canonical, 0)
            // Build the provenance peer list: contributors CSV + the
            // origin peer (the originator may have included itself in
            // the CSV; dedupe is handled by _drb_add_peer-style scan).
            let peers = _dr_split_csv(csv)
            let has_origin = 0
            let pi = 0
            while pi < len(peers) {
                if str_eq(peers[pi], origin) == 1 { has_origin = 1 }
                pi = pi + 1
            }
            if has_origin == 0 { push(peers, origin) }
            // Rule name: prefer the local engine's name at rule_idx if
            // present, else fall back to the predicate name (peers may
            // disagree on rule index ordering).
            let rule_name = pred
            let names = dr[DR_S_RULE_NAMES]
            if rule_idx >= 0 {
                if rule_idx < len(names) {
                    rule_name = names[rule_idx]
                }
            }
            _dr_record_provenance(dr, atom_id(derived), rule_name, peers)
            n_cached = n_cached + 1
        }
    }
    return n_cached
}

// ---- top-level rounds + fixpoint ---------------------------------------

// dr_run_round runs ONE round of distributed forward chaining over the
// federated mesh. The order:
//   1. Drain inbound RULE queue (peers may have broadcast new rules).
//   2. Drain inbound DERIVATION queue (peers may have broadcast new facts).
//   3. For each rule in the engine, evaluate against the federated fact
//      set; for each satisfied binding that isn't already in the KG, add
//      the conclusion + broadcast DERIVATION + record provenance.
// Returns the count of NEW atoms derived locally during step 3 (the
// step-2 cache count is separate -- visible via dr_stats_derived in
// the cumulative view).
fn dr_run_round(dr, kg) {
    if dr_is_state(dr) == 0 { return 0 }
    _dr_drain_inbound_rules(dr)
    _dr_drain_inbound_derivs(dr, kg)
    let engine = dr[DR_S_ENGINE]
    let rules = engine[RE_RULES]
    let total = 0
    let ri = 0
    while ri < len(rules) {
        let n = _dr_apply_one(dr, rules[ri], ri, kg)
        total = total + n
        ri = ri + 1
    }
    dr[DR_S_LAST_DERIVED] = total
    dr[DR_S_STATS_DERIVED] = dr[DR_S_STATS_DERIVED] + total
    dr[DR_S_STATS_ROUNDS] = dr[DR_S_STATS_ROUNDS] + 1
    return total
}

// dr_run_to_fixpoint iterates dr_run_round until a round produces 0
// new local derivations OR max_rounds fires. Returns [total_derived,
// rounds]. max_rounds=0 falls back to DR_DEFAULT_MAX_ROUNDS.
fn dr_run_to_fixpoint(dr, kg, max_rounds) {
    if dr_is_state(dr) == 0 {
        let r = list_new()
        push(r, 0)
        push(r, 0)
        return r
    }
    let cap = max_rounds
    if cap <= 0 { cap = DR_DEFAULT_MAX_ROUNDS }
    let total = 0
    let rounds = 0
    let done = 0
    while done == 0 {
        if rounds >= cap {
            done = 1
        } else {
            let n = dr_run_round(dr, kg)
            rounds = rounds + 1
            total = total + n
            if n == 0 { done = 1 }
        }
    }
    dr[DR_S_LAST_ROUNDS] = rounds
    let r = list_new()
    push(r, total)
    push(r, rounds)
    return r
}

// dr_derivation_provenance returns [rule_name, peer1, peer2, ...] for
// the given derived atom_id. The first element is the rule's head pred
// name; subsequent elements are the peer addresses that contributed.
// Returns an empty list if the atom was not derived by this dr_state.
fn dr_derivation_provenance(dr, atom_id_in) {
    let out = list_new()
    if dr_is_state(dr) == 0 { return out }
    let prov = dr[DR_S_PROVENANCE]
    let i = 0
    while i < len(prov) {
        if prov[i][DR_P_ATOM_ID] == atom_id_in {
            push(out, prov[i][DR_P_RULE])
            let peers = prov[i][DR_P_PEERS]
            let j = 0
            while j < len(peers) {
                push(out, peers[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return out
}

// dr_provenance_count returns the number of provenance entries
// recorded so far (one entry per LOCAL derivation, multi-counted if
// the same atom_id is derived by multiple rules).
fn dr_provenance_count(dr) {
    if dr_is_state(dr) == 0 { return 0 }
    return len(dr[DR_S_PROVENANCE])
}

// ---- chat-side conveniences ---------------------------------------------

fn dr_stats_line(dr) {
    if dr_is_state(dr) == 0 { return "drule: bad state" }
    let gs = dr[DR_S_GOSSIP]
    return "drule: self=" + gossip_self_addr(gs)
        + " rules=" + int_to_str(rule_engine_size(dr[DR_S_ENGINE]))
        + " derived=" + int_to_str(dr[DR_S_STATS_DERIVED])
        + " rounds=" + int_to_str(dr[DR_S_STATS_ROUNDS])
        + " rules_tx=" + int_to_str(dr[DR_S_STATS_RULES_TX])
        + " derivs_tx=" + int_to_str(dr[DR_S_STATS_DERIVS_TX])
        + " fetches_tx=" + int_to_str(dr[DR_S_STATS_FETCHES_TX])
        + " inbound_rules=" + int_to_str(len(dr[DR_S_INBOUND_RULES]))
        + " inbound_derivs=" + int_to_str(len(dr[DR_S_INBOUND_DERIVS]))
}

// ---- chat dispatch ------------------------------------------------------
//
// The chat REPL has no in-process gossip mesh (gossip is daemon-only),
// so `/drule_add` and `/drule_run` are surfaced as INFORMATIONAL
// commands that point operators at the federation scenario. This
// mirrors how /gossip + /leader + /attest_log are wired into the
// chat (no live state).
fn drule_chat_add_cmd(arg) {
    if len(arg) == 0 {
        io_println("usage: /drule_add <rule>  -- e.g. /drule_add RULE ancestor(?a, ?c) <- ancestor(?a, ?b) AND parent(?b, ?c)")
        io_println("DRULE_ADD info=R21B distributed rule inference runs on the federation mesh; this REPL has no gossip daemon (see tests/integration/scenario_eeee_distributed_rules.sh for the 3-soul cross-soul derivation walkthrough)")
        return 1
    }
    // Parse locally as a sanity check so operators get immediate
    // feedback on rule syntax errors.
    let parsed = rule_parse(arg)
    if _rule_is_error(parsed) == 1 {
        io_println("DRULE_ADD error=" + rule_error_message(parsed))
        return 1
    }
    io_println("DRULE_ADD parsed=ok head=" + rule_head_pred(parsed)
        + " premises=" + int_to_str(rule_body_size(parsed))
        + " info=R21B distributed rule (broadcast over gossip mesh; see scenario_eeee for the live walkthrough)")
    return 1
}

fn drule_chat_run_cmd(arg) {
    io_println("DRULE_RUN info=R21B distributed rule inference module ships in src/federation/distributed_rules.nova; this REPL has no gossip daemon (see tests/integration/scenario_eeee_distributed_rules.sh for the 3-soul cross-soul derivation walkthrough that drives dr_run_to_fixpoint over a partitioned parent-fact set)")
    return 1
}
