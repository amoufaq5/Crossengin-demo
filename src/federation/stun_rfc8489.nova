fn _stun_test_get_u16(buf, off)    { return _stun_get_u16(buf, off) }
fn _stun_test_put_u32(buf, off, v) { return _stun_put_u32(buf, off, v) }
fn _stun_test_get_u32(buf, off)    { return _stun_get_u32(buf, off) }
fn _stun_test_pad4(n)              { return _stun_pad4(n) }
fn _stun_test_attr_size(value_len) { return _stun_attr_size(value_len) }
fn _stun_test_str_to_buf(s, n)     { return _stun_str_to_buf(s, n) }
fn _stun_test_alloc_txn(state)     { return _stun_txn_alloc_counter(state) }
