// CrossEngin federation: kg_sync delta-compression (R29F).
//
// Purpose
//   Closes the "small gap, big cost" hole in the federation stack.
//   `src/io/transducers/kg_sync.nova` (P20 / v2) is the live-update
//   transducer -- a publisher pushes atom-birth / promote / atrophy
//   / delete events to subscribers in real time, and a stale subscriber
//   either resumes via the SUB FROM cursor (which only works for events
//   the publisher is still holding) or pulls the full R23C snapshot
//   (expensive: O(KG_size) bytes regardless of how many changes the
//   subscriber actually missed).
//
//   R29F adds a THIRD path: a peer that is behind by a handful of
//   atom-mutations can request a DELTA covering only the revisions it
//   missed. Each KG carries a monotonic `kg_rev` counter that bumps on
//   every insert / update / retract; the peer reports its last-known
//   rev with `KG_DELTA_REQ <since>` and the source returns
//   `KG_DELTA_RESP <from> <to> <n>\n[changes]`. Each change line is
//   `INS|UPD|RETR <atom_id> <rev> <payload_or_empty>`. A cap (256 KB
//   default) bounds the response size; if the requested delta would
//   exceed the cap, the source replies with
//   `KG_DELTA_FULL_SNAPSHOT_REQUIRED <current_rev>` and the caller
//   falls back to R23C's snapshot-replication path.
//
// Wire protocol (text, one line per record, '\n'-terminated)
//
//   Request (peer -> source):
//     KG_DELTA_REQ <since_rev>\n
//
//   Response (source -> peer):
//     KG_DELTA_RESP <from_rev> <to_rev> <n_changes>\n
//     <change_1>\n
//     <change_2>\n
//     ...
//     <change_n>\n
//
//   Each change line is one of:
//     INS  <atom_id> <rev> <kind>:<alpha>:<beta>:<label>
//     UPD  <atom_id> <rev> <alpha>:<beta>
//     RETR <atom_id> <rev>
//
//   Fallback (delta too large or other error):
//     KG_DELTA_FULL_SNAPSHOT_REQUIRED <current_rev>\n
//
//   Empty-delta (peer up to date): the source still emits a RESP, but
//   with `<n_changes>` = 0 and no following change lines:
//     KG_DELTA_RESP <since> <since> 0\n
//
// Idempotent application
//
//   Each change carries its own `rev`. The applier keeps a per-KG
//   monotonic `applied_rev`; a change whose rev is <= applied_rev is
//   silently dropped (already there) so receiving the same delta twice
//   is a no-op. Changes within a delta are emitted in revision-order
//   so the applier never sees an out-of-order rev.
//
// Tamper rejection
//
//   The on-wire body is parsed strictly: malformed shape, missing
//   tokens, non-digit revs / ids, or a change whose claimed rev falls
//   OUTSIDE the response's [from_rev+1, to_rev] window is rejected
//   (the whole delta is discarded; applied_rev is NOT advanced). This
//   gives a peer two layers of defence against a malicious source:
//     1. wire-shape validation (parser refuses garbage);
//     2. revision-window validation (a change can't pretend to be from
//        a different window than the one negotiated).
//   Authentication / confidentiality of the wire bytes themselves is
//   inherited from the transport (kg_sync v3 Noise XK when enabled);
//   R29F's tamper checks are belt-and-braces on top of that.
//
// ADRs: registers ADR-0090 (federation kg-sync delta-compression
//   over R23C snapshot replication).
// CrossEngin dependencies: none (deliberately self-contained -- the
//   module exposes pure-function state + codec helpers that the higher
//   layers compose with the live socket transducer at the call site).
//   The wire format is documented above so a peer in a different
//   language can speak it.

import "std/io"

// ---- protocol constants --------------------------------------------------

let KGD_REQ_PREFIX   = "KG_DELTA_REQ "
let KGD_RESP_PREFIX  = "KG_DELTA_RESP "
let KGD_FULL_PREFIX  = "KG_DELTA_FULL_SNAPSHOT_REQUIRED "
let KGD_INS_PREFIX   = "INS "
let KGD_UPD_PREFIX   = "UPD "
let KGD_RETR_PREFIX  = "RETR "

// Maximum response size (bytes). When a candidate delta would
// serialise to more than this, the source replies with the
// FULL_SNAPSHOT_REQUIRED sentinel instead and the peer falls back to
// R23C. 256 KiB is the default; callers can override via
// `kgd_cap_from_env()` reading CE_KGSYNC_DELTA_CAP.
let KGD_DEFAULT_CAP_BYTES = 262144      // 256 * 1024

// Change-kind tags (slot 0 of every change record).
let KGD_CH_INS  = 1
let KGD_CH_UPD  = 2
let KGD_CH_RETR = 3

// Change record slot layout. Slot 0 is the kind tag; the rest depend
// on the kind:
//   INS  : [tag, atom_id, rev, kind, alpha, beta, label]
//   UPD  : [tag, atom_id, rev, 0,    alpha, beta, ""]
//   RETR : [tag, atom_id, rev, 0,    0,     0,    ""]
// We use a uniform 7-slot record so callers can switch on slot 0 and
// index into the rest without per-kind dispatch.
let KGD_C_TAG   = 0
let KGD_C_ID    = 1
let KGD_C_REV   = 2
let KGD_C_KIND  = 3
let KGD_C_ALPHA = 4
let KGD_C_BETA  = 5
let KGD_C_LABEL = 6

// Response record slot layout (the structured form of one KG_DELTA_RESP).
//   [from_rev, to_rev, n_changes, changes_list, total_bytes]
let KGD_R_FROM   = 0
let KGD_R_TO     = 1
let KGD_R_N      = 2
let KGD_R_CHANGES= 3
let KGD_R_BYTES  = 4

// Result-code tag for the FALLBACK sentinel.
let KGD_R_FALLBACK = 5     // [-1, current_rev, 0, 0, 0] uses slot 1 as cur

// ---- helpers (digit / label predicates) ----------------------------------

fn _kgd_is_digit(c) {
    if c < 48 { return 0 }
    if c > 57 { return 0 }
    return 1
}

fn _kgd_is_digits(s) {
    if len(s) == 0 { return 0 }
    let i = 0
    while i < len(s) {
        if _kgd_is_digit(char_at(s, i)) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Label / KG-name alphabet: [A-Za-z0-9_-]. Same shape kg_sync v2 uses
// so the two layers agree on label validity.
fn _kgd_is_label_char(c) {
    if c >= 48 { if c <= 57  { return 1 } }   // 0..9
    if c >= 65 { if c <= 90  { return 1 } }   // A..Z
    if c >= 97 { if c <= 122 { return 1 } }   // a..z
    if c == 95 { return 1 }                   // '_'
    if c == 45 { return 1 }                   // '-'
    return 0
}

fn _kgd_is_label(s) {
    if len(s) == 0 { return 0 }
    let i = 0
    while i < len(s) {
        if _kgd_is_label_char(char_at(s, i)) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn _kgd_starts_with(s, prefix) {
    let pn = len(prefix)
    if len(s) < pn { return 0 }
    let i = 0
    while i < pn {
        if char_at(s, i) != char_at(prefix, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn _kgd_strip_eol(s) {
    let n = len(s)
    let done = 0
    while done == 0 {
        if n <= 0 { done = 1 }
        if done == 0 {
            let c = char_at(s, n - 1)
            if c == 10 { n = n - 1 }
            else { if c == 13 { n = n - 1 } else { done = 1 } }
        }
    }
    return substr(s, 0, n)
}

// Split on a single space character.
fn _kgd_split_spaces(s) {
    let out = list_new()
    let i = 0
    let start = 0
    while i < len(s) {
        if char_at(s, i) == 32 {
            push(out, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(s, start, len(s) - start))
    return out
}

// Split on ':' (the payload internal delimiter).
fn _kgd_split_colons(s, expected) {
    let out = list_new()
    let i = 0
    let start = 0
    let parts_so_far = 0
    while i < len(s) {
        // Stop splitting once we've collected `expected-1` separators;
        // the label tail (which can contain '_' and '-' but NOT ':')
        // is kept as the final segment intact.
        if parts_so_far >= expected - 1 {
            i = len(s)
        } else {
            if char_at(s, i) == 58 {
                push(out, substr(s, start, i - start))
                start = i + 1
                parts_so_far = parts_so_far + 1
            }
            i = i + 1
        }
    }
    push(out, substr(s, start, len(s) - start))
    return out
}

// ---- env / config helpers ------------------------------------------------

fn kgd_cap_from_env() {
    let env = getenv("CE_KGSYNC_DELTA_CAP")
    if env != 0 {
        if len(env) > 0 {
            if _kgd_is_digits(env) == 1 {
                let v = str_to_int(env)
                if v > 0 { return v }
            }
        }
    }
    return KGD_DEFAULT_CAP_BYTES
}

// ---- per-atom revision state --------------------------------------------
//
// kg_rev tracks the monotonic revision number for one KG. Each
// insert / update / retract bumps it; the resulting revision is
// stamped onto the change so the applier can dedupe / order. The
// state is independent of the underlying atom store so this module
// can be exercised purely without a live KG -- the higher layer
// drives `kgd_state_bump_*` on every local mutation and pushes the
// resulting change onto the local log via `kgd_state_record_change`.

let KGD_S_REV     = 0     // current monotonic rev
let KGD_S_LOG     = 1     // list of change records, in rev order
let KGD_S_APPLIED = 2     // highest rev applied via kgd_apply_response

fn kgd_state_new() {
    let st = list_new()
    push(st, 0)               // rev = 0 (no changes yet)
    push(st, list_new())      // empty log
    push(st, 0)               // applied_rev = 0
    return st
}

fn kgd_state_rev(st)         { return st[KGD_S_REV] }
fn kgd_state_log(st)         { return st[KGD_S_LOG] }
fn kgd_state_applied(st)     { return st[KGD_S_APPLIED] }
fn kgd_state_log_size(st)    { return len(st[KGD_S_LOG]) }

// Internal: build one change record. Caller supplies an already-
// allocated rev so the record carries its slot in history.
fn _kgd_make_change(tag, atom_id, rev, kind, alpha, beta, label) {
    let c = list_new()
    push(c, tag)
    push(c, atom_id)
    push(c, rev)
    push(c, kind)
    push(c, alpha)
    push(c, beta)
    push(c, label)
    return c
}

// Bump the revision counter and append an INS change. Returns the
// new revision number. Callers running on the publisher side call
// this AS THEY mutate the local KG, so the log faithfully mirrors
// local insert ordering.
fn kgd_state_bump_ins(st, atom_id, kind, alpha, beta, label) {
    let r = st[KGD_S_REV] + 1
    list_set(st, KGD_S_REV, r)
    push(st[KGD_S_LOG], _kgd_make_change(KGD_CH_INS, atom_id, r, kind, alpha, beta, label))
    return r
}

fn kgd_state_bump_upd(st, atom_id, alpha, beta) {
    let r = st[KGD_S_REV] + 1
    list_set(st, KGD_S_REV, r)
    push(st[KGD_S_LOG], _kgd_make_change(KGD_CH_UPD, atom_id, r, 0, alpha, beta, ""))
    return r
}

fn kgd_state_bump_retr(st, atom_id) {
    let r = st[KGD_S_REV] + 1
    list_set(st, KGD_S_REV, r)
    push(st[KGD_S_LOG], _kgd_make_change(KGD_CH_RETR, atom_id, r, 0, 0, 0, ""))
    return r
}

// ---- wire format helpers (request side) ---------------------------------

fn kgd_format_req(since_rev) {
    return KGD_REQ_PREFIX + int_to_str(since_rev) + "\n"
}

fn kgd_parse_req(text) {
    let line = _kgd_strip_eol(text)
    if _kgd_starts_with(line, KGD_REQ_PREFIX) == 0 { return -1 }
    let tail = substr(line, len(KGD_REQ_PREFIX), len(line) - len(KGD_REQ_PREFIX))
    if _kgd_is_digits(tail) == 0 { return -1 }
    return str_to_int(tail)
}

// ---- wire format helpers (per-change line) ------------------------------

fn _kgd_format_change(c) {
    let tag = c[KGD_C_TAG]
    let aid = int_to_str(c[KGD_C_ID])
    let rev = int_to_str(c[KGD_C_REV])
    if tag == KGD_CH_INS {
        let payload = int_to_str(c[KGD_C_KIND]) + ":"
                     + int_to_str(c[KGD_C_ALPHA]) + ":"
                     + int_to_str(c[KGD_C_BETA]) + ":"
                     + c[KGD_C_LABEL]
        return KGD_INS_PREFIX + aid + " " + rev + " " + payload + "\n"
    }
    if tag == KGD_CH_UPD {
        let payload = int_to_str(c[KGD_C_ALPHA]) + ":" + int_to_str(c[KGD_C_BETA])
        return KGD_UPD_PREFIX + aid + " " + rev + " " + payload + "\n"
    }
    if tag == KGD_CH_RETR {
        return KGD_RETR_PREFIX + aid + " " + rev + "\n"
    }
    return ""
}

// Parse a change line. Returns the 7-slot change record on success,
// or 0 on any malformation.
fn _kgd_parse_change(text) {
    let line = _kgd_strip_eol(text)
    if len(line) == 0 { return 0 }
    if _kgd_starts_with(line, KGD_INS_PREFIX) == 1 {
        let toks = _kgd_split_spaces(line)
        if len(toks) != 4 { return 0 }
        if str_eq(toks[0], "INS") == 0 { return 0 }
        if _kgd_is_digits(toks[1]) == 0 { return 0 }
        if _kgd_is_digits(toks[2]) == 0 { return 0 }
        let parts = _kgd_split_colons(toks[3], 4)
        if len(parts) != 4 { return 0 }
        if _kgd_is_digits(parts[0]) == 0 { return 0 }
        if _kgd_is_digits(parts[1]) == 0 { return 0 }
        if _kgd_is_digits(parts[2]) == 0 { return 0 }
        if _kgd_is_label(parts[3]) == 0 { return 0 }
        return _kgd_make_change(KGD_CH_INS,
                                str_to_int(toks[1]),
                                str_to_int(toks[2]),
                                str_to_int(parts[0]),
                                str_to_int(parts[1]),
                                str_to_int(parts[2]),
                                parts[3])
    }
    if _kgd_starts_with(line, KGD_UPD_PREFIX) == 1 {
        let toks = _kgd_split_spaces(line)
        if len(toks) != 4 { return 0 }
        if str_eq(toks[0], "UPD") == 0 { return 0 }
        if _kgd_is_digits(toks[1]) == 0 { return 0 }
        if _kgd_is_digits(toks[2]) == 0 { return 0 }
        let parts = _kgd_split_colons(toks[3], 2)
        if len(parts) != 2 { return 0 }
        if _kgd_is_digits(parts[0]) == 0 { return 0 }
        if _kgd_is_digits(parts[1]) == 0 { return 0 }
        return _kgd_make_change(KGD_CH_UPD,
                                str_to_int(toks[1]),
                                str_to_int(toks[2]),
                                0,
                                str_to_int(parts[0]),
                                str_to_int(parts[1]),
                                "")
    }
    if _kgd_starts_with(line, KGD_RETR_PREFIX) == 1 {
        let toks = _kgd_split_spaces(line)
        if len(toks) != 3 { return 0 }
        if str_eq(toks[0], "RETR") == 0 { return 0 }
        if _kgd_is_digits(toks[1]) == 0 { return 0 }
        if _kgd_is_digits(toks[2]) == 0 { return 0 }
        return _kgd_make_change(KGD_CH_RETR,
                                str_to_int(toks[1]),
                                str_to_int(toks[2]),
                                0, 0, 0, "")
    }
    return 0
}

// ---- delta build / serialise (publisher side) ---------------------------

// Build a delta covering changes with rev in (since_rev, st.rev].
// Returns the structured response record, with one of three shapes:
//   1. normal delta: [from, to, n, changes_list, total_bytes]
//   2. empty delta:  [from, from, 0, [], header_bytes]
//   3. fallback:     [KGD_R_FALLBACK, current_rev, 0, 0, 0]
//      (cap exceeded -- caller should switch to snapshot replication).
fn kgd_build_response(st, since_rev, cap_bytes) {
    let cur = st[KGD_S_REV]
    // Empty-delta fast path (peer is current OR ahead).
    if since_rev >= cur {
        let header = KGD_RESP_PREFIX + int_to_str(since_rev) + " "
                   + int_to_str(since_rev) + " 0\n"
        let r = list_new()
        push(r, since_rev)
        push(r, since_rev)
        push(r, 0)
        push(r, list_new())
        push(r, len(header))
        return r
    }
    // Walk the log, collect changes with rev > since_rev. The log is
    // monotonic so this is a single linear scan; we don't need to
    // sort. The cap check happens INCREMENTALLY -- we sum the
    // serialised size of every line before appending it, and bail
    // (returning the fallback sentinel) as soon as the projected
    // total would exceed cap_bytes.
    let log = st[KGD_S_LOG]
    let header = KGD_RESP_PREFIX + int_to_str(since_rev) + " "
               + int_to_str(cur) + " "
    // We don't know n yet, so reserve the rough size of n's digits.
    // Build the changes-list first, then compute final n_changes and
    // re-emit header bytes properly. We bound size by counting bytes
    // of every change PLUS a conservative ceiling on the header.
    let changes = list_new()
    let bytes_so_far = 0
    // Reserve up to 10 digits + "\n" for n_changes (handles up to
    // 9.99B changes -- well above any realistic KG).
    let header_reserve = len(header) + 11
    bytes_so_far = header_reserve
    let i = 0
    while i < len(log) {
        let c = log[i]
        if c[KGD_C_REV] > since_rev {
            let line = _kgd_format_change(c)
            let new_bytes = bytes_so_far + len(line)
            if new_bytes > cap_bytes {
                // Fallback sentinel: caller should snapshot-sync.
                let f = list_new()
                push(f, KGD_R_FALLBACK)
                push(f, cur)
                push(f, 0)
                push(f, 0)
                push(f, 0)
                return f
            }
            push(changes, c)
            bytes_so_far = new_bytes
        }
        i = i + 1
    }
    let r = list_new()
    push(r, since_rev)
    push(r, cur)
    push(r, len(changes))
    push(r, changes)
    push(r, bytes_so_far)
    return r
}

// Serialise a built response to the wire format. The result already
// includes the header line + all change lines, terminated by '\n'.
// Returns "" for a fallback record (caller should call
// kgd_format_fallback instead).
fn kgd_format_response(resp) {
    if resp[KGD_R_FROM] == KGD_R_FALLBACK { return "" }
    let from = resp[KGD_R_FROM]
    let to = resp[KGD_R_TO]
    let n = resp[KGD_R_N]
    let out = KGD_RESP_PREFIX + int_to_str(from) + " "
            + int_to_str(to) + " " + int_to_str(n) + "\n"
    let changes = resp[KGD_R_CHANGES]
    let i = 0
    while i < len(changes) {
        out = out + _kgd_format_change(changes[i])
        i = i + 1
    }
    return out
}

// Build the FALLBACK sentinel line for a peer whose request exceeded
// the cap. Caller obtains `current_rev` from kgd_state_rev.
fn kgd_format_fallback(current_rev) {
    return KGD_FULL_PREFIX + int_to_str(current_rev) + "\n"
}

// True if `line` is the fallback sentinel; if so, returns the
// current_rev value. Returns -1 if not a fallback line.
fn kgd_parse_fallback(text) {
    let line = _kgd_strip_eol(text)
    if _kgd_starts_with(line, KGD_FULL_PREFIX) == 0 { return -1 }
    let tail = substr(line, len(KGD_FULL_PREFIX), len(line) - len(KGD_FULL_PREFIX))
    if _kgd_is_digits(tail) == 0 { return -1 }
    return str_to_int(tail)
}

// ---- delta parse + apply (subscriber side) ------------------------------

// Parse a serialised response. Returns the same shape kgd_build_response
// builds, or 0 on any malformation (tampered shape, non-digit revs,
// claimed n doesn't match number of change lines, claimed rev outside
// the [from+1, to] window, etc.).
fn kgd_parse_response(text) {
    if len(text) == 0 { return 0 }
    // Locate the first newline -- end of header.
    let nl = -1
    let i = 0
    while i < len(text) {
        if char_at(text, i) == 10 { nl = i i = len(text) }
        else { i = i + 1 }
    }
    if nl < 0 { return 0 }
    let header = substr(text, 0, nl)
    if _kgd_starts_with(header, KGD_RESP_PREFIX) == 0 { return 0 }
    let body_part = substr(header, len(KGD_RESP_PREFIX),
                           len(header) - len(KGD_RESP_PREFIX))
    let toks = _kgd_split_spaces(body_part)
    if len(toks) != 3 { return 0 }
    if _kgd_is_digits(toks[0]) == 0 { return 0 }
    if _kgd_is_digits(toks[1]) == 0 { return 0 }
    if _kgd_is_digits(toks[2]) == 0 { return 0 }
    let from = str_to_int(toks[0])
    let to = str_to_int(toks[1])
    let n = str_to_int(toks[2])
    if to < from { return 0 }
    // Walk the remaining text, line-by-line, parsing each change.
    let changes = list_new()
    let pos = nl + 1
    while pos < len(text) {
        let next_nl = -1
        let j = pos
        while j < len(text) {
            if char_at(text, j) == 10 { next_nl = j j = len(text) }
            else { j = j + 1 }
        }
        if next_nl < 0 {
            // Final line without trailing '\n': accept it.
            next_nl = len(text)
        }
        if next_nl > pos {
            let line = substr(text, pos, next_nl - pos)
            let c = _kgd_parse_change(line)
            if c == 0 { return 0 }
            // Window check: claimed rev must be in (from, to].
            let cr = c[KGD_C_REV]
            if cr <= from { return 0 }
            if cr > to { return 0 }
            push(changes, c)
        }
        pos = next_nl + 1
    }
    if len(changes) != n { return 0 }
    // Monotonic-rev check: changes within a response must be strictly
    // increasing by rev (the publisher emits in log order; a tampered
    // body might shuffle).
    let last = from
    let k = 0
    while k < len(changes) {
        let r = changes[k][KGD_C_REV]
        if r <= last { return 0 }
        last = r
        k = k + 1
    }
    let out = list_new()
    push(out, from)
    push(out, to)
    push(out, n)
    push(out, changes)
    push(out, len(text))
    return out
}

// Apply a parsed response to the local state. Each change is
// dispatched to the caller's per-kind apply function via the
// `cb_*` callbacks; here we just bump the local applied_rev counter
// and skip any change whose rev is <= applied_rev (idempotency).
//
// The caller supplies a *single* `applier` record carrying three
// functions:
//   applier[0] = fn(atom_id, kind, alpha, beta, label) -- INS
//   applier[1] = fn(atom_id, alpha, beta)              -- UPD
//   applier[2] = fn(atom_id)                           -- RETR
// Each callback returns 1 on success, 0 on failure. A failed
// callback DOES NOT advance applied_rev (the change is treated as
// not-applied so a future redelivery will retry).
//
// Returns the number of changes actually applied (skipped duplicates
// don't count).
fn kgd_apply_response(st, resp, applier) {
    if resp == 0 { return 0 }
    if resp[KGD_R_FROM] == KGD_R_FALLBACK { return 0 }
    let changes = resp[KGD_R_CHANGES]
    let applied = 0
    let i = 0
    while i < len(changes) {
        let c = changes[i]
        let cr = c[KGD_C_REV]
        if cr <= st[KGD_S_APPLIED] {
            // Already applied -- idempotent skip.
            i = i + 1
        } else {
            let tag = c[KGD_C_TAG]
            let ok = 0
            if tag == KGD_CH_INS {
                let f = applier[0]
                ok = f(c[KGD_C_ID], c[KGD_C_KIND], c[KGD_C_ALPHA],
                       c[KGD_C_BETA], c[KGD_C_LABEL])
            }
            if tag == KGD_CH_UPD {
                let f = applier[1]
                ok = f(c[KGD_C_ID], c[KGD_C_ALPHA], c[KGD_C_BETA])
            }
            if tag == KGD_CH_RETR {
                let f = applier[2]
                ok = f(c[KGD_C_ID])
            }
            if ok == 1 {
                list_set(st, KGD_S_APPLIED, cr)
                // Mirror the change into the local log so a later
                // peer asking US for a delta gets the same history.
                push(st[KGD_S_LOG], c)
                if cr > st[KGD_S_REV] {
                    list_set(st, KGD_S_REV, cr)
                }
                applied = applied + 1
            }
            i = i + 1
        }
    }
    return applied
}

// ---- request dispatch (publisher side wire-loop helper) ------------------

// Top-level: given a request line text, decide what to reply.
// Returns the bytes to send back (one or more '\n'-terminated lines).
// Returns "" if the line is not a recognised request.
fn kgd_dispatch_request(st, req_line, cap_bytes) {
    let since = kgd_parse_req(req_line)
    if since < 0 { return "" }
    let resp = kgd_build_response(st, since, cap_bytes)
    if resp[KGD_R_FROM] == KGD_R_FALLBACK {
        return kgd_format_fallback(resp[KGD_R_TO])
    }
    return kgd_format_response(resp)
}

// ---- applier-record constructor (subscriber side) -----------------------

fn kgd_applier_new(ins_fn, upd_fn, retr_fn) {
    let a = list_new()
    push(a, ins_fn)
    push(a, upd_fn)
    push(a, retr_fn)
    return a
}
