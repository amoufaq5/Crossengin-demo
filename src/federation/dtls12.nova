// CrossEngin federation: DTLS 1.2 record-layer + handshake skeleton
// (R29B / R28E.2 follow-up).
//
// Purpose
//
//   R28E (`src/federation/webrtc.nova`, commit `8c566fb`) shipped the
//   SIGNALING half of browser-to-soul WebRTC -- SDP offer/answer
//   round-trip works, the data plane returns the documented sentinel
//   `RTC_ERR_NEEDS_DTLS`. The R28E exit report flagged four R28E.2
//   sub-systems: DTLS 1.2/1.3, ICE, SRTP, STUN/TURN. R29B owns the
//   DTLS half.
//
//   The full DTLS stack (record-layer AEAD, X.509 cert verification,
//   ECDHE key exchange, retransmission timers, anti-replay window,
//   SRTP key extractor) is multi-thousand-lines; one round of a
//   parallel-agent sprint cannot land all of it without cutting
//   corners on correctness. R29B instead lands the SKELETON: the
//   record-layer byte layout (RFC 6347 section 4.1) and the
//   handshake message envelope (RFC 6347 section 4.2) with
//   cryptographic primitives verified against published test
//   vectors. R29B.2 will plug in actual key exchange + AEAD record
//   encryption + certificate parsing on top of this scaffold.
//
//   This module sits one layer above the safety primitives in the
//   dep graph (it imports `sha256.nova`, `p256.nova`, `aes_gcm.nova`,
//   `x509.nova`) but imports nothing from other CrossEngin federation
//   modules so parallel agents working on other federation modules
//   cannot collide here. Pre-R34A the SHA-256 + HMAC-SHA256 family
//   was reimplemented in-module as the 4th byte-identical copy in the
//   tree (alongside noise_xk / merkle / ecdsa, all FIPS 180-4); R33A
//   landed `src/safety/sha256.nova` as the canonical primitive and
//   retired 3 of 4 copies; R34A retires the 4th here. HKDF-Expand +
//   TLS 1.2 PRF are kept inline because they compose HMAC-SHA256 in
//   DTLS-specific recipes that have no analog in the canonical
//   primitive module; they pick up the canonical SHA-256 + HMAC
//   transparently via `dtls_hmac_sha256` which is now a thin wrapper.
//
// Scope (what R29B ships)
//
//   1. Record layer (RFC 6347 section 4.1):
//        struct DTLSPlaintext {
//          ContentType  type;            // 1 byte
//          ProtocolVersion version;      // 2 bytes (0xfefd for DTLS 1.2)
//          uint16       epoch;           // 2 bytes (big-endian)
//          uint48       sequence_number; // 6 bytes (big-endian)
//          uint16       length;          // 2 bytes (big-endian)
//          opaque       fragment[length];
//        }
//      Serialize / parse functions verified against a hand-constructed
//      test vector (see `_dtls_test_record_vector` and the unit suite).
//
//   2. Handshake message envelope (RFC 6347 section 4.2):
//        struct Handshake {
//          HandshakeType msg_type;       // 1 byte
//          uint24        length;         // 3 bytes (big-endian)
//          uint16        message_seq;    // 2 bytes (big-endian)
//          uint24        fragment_offset;// 3 bytes
//          uint24        fragment_length;// 3 bytes
//          opaque        body[fragment_length];
//        }
//      Per-flight message_seq increments tracked in state. Flight
//      retransmission counter incremented on resend (R29B tracks
//      but does NOT actually retransmit; that is R29B.2).
//
//   3. State machine skeleton:
//        DTLS_INIT -> DTLS_CLIENT_HELLO_SENT -> DTLS_SERVER_HELLO_RECVD
//        -> DTLS_CERTIFICATE_RECVD -> DTLS_FINISHED -> DTLS_ESTABLISHED
//        Failure transitions to DTLS_FAILED from any state.
//      `dtls_client_init(state)` emits a serialized ClientHello record
//      and advances state to CLIENT_HELLO_SENT.
//
//   4. HKDF-SHA256 + TLS 1.2 PRF (P_SHA256 of RFC 5246 section 5).
//      HKDF verified against RFC 5869 test vector 1 (the IETF
//      reference). PRF verified via self-consistent round-trip + a
//      documented test approach (see the unit suite).
//
//   5. Cipher-suite negotiation gate: ONLY
//      ECDHE-ECDSA-AES128-GCM-SHA256 (0xC02B, RFC 5289) is accepted.
//      Any other suite ID returned by `dtls_select_cipher_suite` is
//      `DTLS_ERR_NO_CIPHER`. This is intentionally narrow -- it
//      matches the bare minimum WebRTC interop suite browsers use
//      with ECDSA self-signed certs.
//
// Scope (what R29B does NOT ship; R29B.2)
//
//   * Actual ECDHE key exchange (need P-256 scalar mul; the existing
//     `src/safety/bignum_2048.nova` ships RFC 7919 Group 14 only --
//     NOT a NIST P-256 curve). All key-exchange functions are stubs
//     suffixed `_R29B2_STUB`.
//   * Certificate (X.509) parsing + signature verification.
//   * AEAD encryption / decryption of records under the negotiated
//     keys. `dtls_seal_record_R29B2_STUB` returns 0.
//   * Cookie exchange (HelloVerifyRequest) for DoS mitigation.
//   * Real anti-replay sliding window. Sequence numbers are tracked
//     monotonically but not validated against a window.
//   * Actual retransmission scheduling (the timer + flight resend).
//     A counter is kept; the wire is not driven.
//   * SRTP master-key extraction via RFC 5705 EKM.
//
// Public API
//
//   dtls_init()                                  -> dtls_state
//   dtls_client_init(state, server_name)         -> bytes_buf (record)
//   dtls_state_get(state)                        -> int (DTLS_S_* constant)
//   dtls_state_name(s)                           -> string
//   dtls_transition(state, next)                 -> 1 ok | 0 invalid
//   dtls_select_cipher_suite(suites_list)        -> 0xC02B | DTLS_ERR_NO_CIPHER
//   dtls_record_serialize(type, ver, epoch, seq, fragment, frag_n)
//                                                -> [buf, total_n]
//   dtls_record_parse(buf, n)                    -> [type, ver, epoch, seq,
//                                                   length, frag_buf, frag_n]
//                                                   | DTLS_ERR_BAD_RECORD
//   dtls_handshake_serialize(type, msg_seq, body, body_n)
//                                                -> [buf, total_n]
//   dtls_handshake_parse(buf, n)                 -> [type, length, msg_seq,
//                                                   frag_off, frag_len,
//                                                   body_buf, body_n]
//                                                   | DTLS_ERR_BAD_HS
//   dtls_msg_seq_next(state)                     -> int (post-increment)
//   dtls_flight_retransmit_count(state)          -> int
//   dtls_record_epoch(state)                     -> int
//   dtls_record_seq(state)                       -> int (low 48 bits)
//
//   Crypto primitives (RFC 5869 + RFC 5246):
//     dtls_sha256(buf, n)                        -> 32-byte digest buf
//     dtls_hmac_sha256(key, key_n, msg, msg_n)   -> 32-byte mac buf
//     dtls_hkdf_extract(salt, salt_n, ikm, ikm_n) -> 32-byte PRK buf
//     dtls_hkdf_expand(prk, info, info_n, nbytes) -> nbytes buf
//     dtls_prf_sha256(secret, sec_n, label, seed, seed_n, nbytes)
//                                                -> nbytes buf (RFC 5246 PRF)
//
//   R29B.2 stubs (always return 0; tagged for `grep _R29B2_STUB`):
//     dtls_ecdhe_derive_R29B2_STUB     -- REPLACED in R31B by dtls_ecdhe_derive
//                                         (the stub is retained as a
//                                         regression guard against
//                                         accidental rename).
//     dtls_cert_verify_R29B2_STUB      -- HISTORICAL LABEL, no longer a
//                                         stub. R33B replaced the body
//                                         with a real single-cert path
//                                         (x509_parse -> validity ->
//                                         ECDSA-P256 verify -> optional
//                                         fingerprint) and the SUFFIX is
//                                         retained only for `grep`
//                                         backwards-compat. Phase O R1
//                                         (ADR-0094) then added the
//                                         chain-aware entry
//                                         `dtls_cert_verify_chain(state,
//                                         cert_der_list, hostname,
//                                         anchors, now)` which forwards
//                                         to `cert_chain_verify` at
//                                         `src/safety/x509_verify.nova`
//                                         for full chain walking +
//                                         truststore consultation +
//                                         SAN matching. Legacy
//                                         `dtls_cert_verify(state, cert,
//                                         n, fp)` is kept untouched for
//                                         backwards compatibility with
//                                         existing test callers.
//     dtls_seal_record_R29B2_STUB      -- REPLACED in R31B by dtls_seal_record.
//     dtls_open_record_R29B2_STUB      -- REPLACED in R31B by dtls_open_record.
//     dtls_extract_srtp_keys_R29B2_STUB -- HISTORICAL LABEL, no longer a
//                                          stub. R36B shipped the full
//                                          RFC 5764 §4.2 exporter at
//                                          `dtls_export_srtp_keying_material`
//                                          (60-byte PRF expansion under
//                                          the "EXTRACTOR-dtls_srtp"
//                                          label, seed = client_random ||
//                                          server_random, cached in
//                                          DTLS_S_SLOT_SRTP_KM_CACHED).
//                                          Phase O R2 (ADR-0095) rewires
//                                          this legacy wrapper to forward
//                                          to that real implementation
//                                          and adds `use_srtp` ClientHello
//                                          extension EMISSION (RFC 5764
//                                          §4.1) driven by the
//                                          `dtls_offer_srtp(state, profile)`
//                                          setter + tail-appended slot
//                                          DTLS_S_SLOT_SRTP_OFFER. Extension
//                                          PARSING remains deferred to a
//                                          follow-up round; SRTP layer
//                                          integration (packet-side rtp /
//                                          rtcp seal / open) is out of
//                                          scope for this file.
//
//   R31B real cipher path (replaces three of the stubs above):
//     dtls_set_role(state, is_server)        -> 1
//     dtls_ecdhe_keygen(state)               -> 33B compressed pub | 0
//     dtls_ecdhe_keygen_seeded(state, priv)  -> 33B compressed pub | 0
//     dtls_ecdhe_derive(state, peer_pub_buf, peer_pub_n,
//                       client_random, server_random, is_server)
//                                            -> 1 ok | 0 fail
//     dtls_seal_record(state, type_byte, plaintext_buf, pt_n)
//                                            -> [out_buf, total_n] | 0
//     dtls_open_record(state, buf, n)
//                                            -> [type, pt_buf, pt_n, seq]
//                                               | DTLS_DECRYPT_FAIL
//     Accessors: dtls_is_server, dtls_cipher_active, dtls_send_seq,
//                dtls_recv_seq, dtls_aead_records_out, dtls_aead_records_in,
//                dtls_tamper_ct_count, dtls_tamper_tag_count,
//                dtls_tamper_aad_count, dtls_master_secret, dtls_key_block,
//                dtls_local_pub, dtls_client_write_key, dtls_server_write_key,
//                dtls_client_write_iv, dtls_server_write_iv.
//
//   Error tags:
//     DTLS_ERR_BAD_RECORD  -- malformed record (short header / bad
//                             length / unknown content type).
//     DTLS_ERR_BAD_HS      -- malformed handshake envelope.
//     DTLS_ERR_NO_CIPHER   -- no acceptable suite in the offered list.
//     DTLS_ERR_BAD_STATE   -- transition request rejected.
//     DTLS_ERR_STUB        -- generic stub return.
//
// ADRs touched: registers ADR-0093 (DTLS 1.2 record-layer + handshake
//   skeleton, R28E.2 sub-system). R31B amends this ADR -- the
//   `_R29B2_STUB`-tagged ECDHE-derive / seal-record / open-record slots
//   are now backed by REAL implementations driven by R30B's P-256 and
//   AES-128-GCM modules. The stub functions themselves remain in place
//   as regression guards (still return DTLS_ERR_STUB so the test suite
//   that pins them against accidental rename still catches that).
// NOVA dependencies: builtins (alloc, store8, load8, list_new, push,
//   int_*, len, str_eq).
// CrossEngin dependencies (R31B / R33B / R34A):
//   * src/safety/sha256.nova -- canonical FIPS 180-4 SHA-256 + RFC 2104
//                               HMAC-SHA256 (R33A landed; R34A retired
//                               this module's inline 4th copy).
//   * src/safety/p256.nova   -- P-256 ECDH keypair generation +
//                               shared-secret derivation (RFC 5903
//                               §8.1 verified).
//   * src/safety/aes_gcm.nova -- AES-128-GCM AEAD seal / open (NIST
//                               SP 800-38D Appendix B TC1-4 verified).
//   * src/safety/x509.nova   -- DER cert parser + signature verify
//                               (R32C; R33B wired into dtls_cert_verify).
//   All are LEAVES under safety/, so adding them does not transitively
//   pull in any other federation module. The "true leaf" property
//   from R29B has loosened: dtls12.nova now sits one layer above
//   sha256.nova + p256.nova + aes_gcm.nova + x509.nova in the dep
//   graph. The HKDF + TLS 1.2 PRF helpers remain bundled in-module
//   because they are DTLS-specific compositions of HMAC-SHA256 with
//   no analog in the canonical SHA-256 module; they pick up the
//   canonical SHA-256 + HMAC transparently through the
//   `dtls_hmac_sha256` wrapper.

// R34A (R33A.2): canonical FIPS 180-4 SHA-256 + RFC 2104 HMAC-SHA256.
// Pre-R34A this module shipped its own inline copy (the 4th in the tree
// alongside noise_xk / merkle / ecdsa); R33A landed the canonical and
// retired 3 of 4. R34A retires the 4th here. `dtls_sha256` and
// `dtls_hmac_sha256` are now thin wrappers around `sha256_oneshot` /
// `hmac_sha256`; the HKDF + PRF composition below is unchanged and
// picks up the canonical implementation transparently through the
// wrappers.
import "../safety/sha256.nova"
import "../safety/p256.nova"
import "../safety/aes_gcm.nova"
// R33B: x509.nova transitively imports ecdsa.nova (which imports p256.nova).
// We pull it in for `x509_parse` + `x509_check_validity` + the accessor
// helpers `x509_tbs_buf`/`x509_tbs_len`/`x509_public_key_buf`/
// `x509_public_key_len`/`x509_signature_r`/`x509_signature_s` that
// `dtls_cert_verify` calls. `ecdsa_sha256` + `ecdsa_p256_verify_bn` are
// re-exported through the same import chain.
import "../safety/x509.nova"
// Phase O R1 (ADR-0094): pull in the chain-aware verifier + typed anchor
// key constants so `dtls_cert_verify_chain` can forward to
// `cert_chain_verify(der_list, host, anchors, now)`. `x509_verify.nova`
// is the RSA/EC chain path that already ships in the tree (it powers
// the TLS 1.3 client's anchor pinning); this import wires the same
// verifier into DTLS.
import "../safety/x509_verify.nova"

// ============================================================================
//                              Error tags
// ============================================================================

let DTLS_ERR_BAD_RECORD = "dtls: bad record"
let DTLS_ERR_BAD_HS     = "dtls: bad handshake"
let DTLS_ERR_NO_CIPHER  = "dtls: no acceptable cipher suite"
let DTLS_ERR_BAD_STATE  = "dtls: invalid state transition"
let DTLS_ERR_STUB       = "dtls: R29B2 stub"

// R31B AEAD failure tag. Returned by `dtls_open_record` whenever the
// underlying `gcm_open` reports a tag mismatch -- this covers ciphertext
// tamper, tag tamper, AAD mismatch (wrong seq_num / type / version /
// length), and a wrong read key. The error is intentionally INDISTINCT
// across those cases per RFC 5246 §7.2.2 (revealing the failure mode
// leaks oracle bits to an attacker -- the "bad_record_mac" alert is
// the only legal external signal).
let DTLS_DECRYPT_FAIL   = "dtls: decrypt fail"

// R32B anti-replay failure tags. Per RFC 6347 §4.1.2.6 the receiver
// maintains a sliding window of the most recent 64 sequence numbers
// and rejects records that fall outside the window (DTLS_TOO_OLD) or
// whose bit is already set (DTLS_REPLAY). Both rejections happen
// BEFORE the AEAD decrypt attempt -- replays / too-old records are
// cheap to drop, and we explicitly do NOT want to feed attacker-
// controlled bytes to the AEAD oracle.
let DTLS_REPLAY         = "dtls: replay"
let DTLS_TOO_OLD        = "dtls: too old"

// R33B cert-verify return tags. The success path returns the integer
// sentinel `DTLS_OK = 0` (numeric rather than a string so callers can
// branch on `r == DTLS_OK` without a `str_eq` round-trip). All failure
// paths return distinct string tags so a caller can attribute the
// rejection cause -- unlike the AEAD path (which intentionally
// collapses ciphertext / tag / AAD failures into one indistinct
// `DTLS_DECRYPT_FAIL` for oracle-leak hygiene), cert-verify failures
// are evaluated BEFORE any oracle-relevant state is touched, so the
// distinguishability tradeoff doesn't apply.
let DTLS_OK                   = 0
let DTLS_CERT_PARSE_FAIL      = "dtls: cert parse fail"
let DTLS_CERT_EXPIRED         = "dtls: cert expired"
let DTLS_CERT_NOT_YET_VALID   = "dtls: cert not yet valid"
let DTLS_CERT_SIG_FAIL        = "dtls: cert sig fail"
let DTLS_CERT_FP_MISMATCH     = "dtls: cert fingerprint mismatch"
// Phase O R1 (ADR-0094) chain-aware cert-verify error tags. `_NOT_PINNED`
// fires when `cert_chain_verify` walked the whole chain but the top
// cert's public key did not match any anchor in the truststore.
// `_HOSTNAME_MISMATCH` fires when the leaf cert's SAN list does not
// cover the caller-supplied hostname (exact or wildcard). Both use the
// same "dtls-<lowered-error-slug>" spelling the ADR-0094 error map
// pins for cross-module consistency; they REMAIN distinct string tags
// (unlike the AEAD path's collapsed DTLS_DECRYPT_FAIL) because
// cert-verify is evaluated BEFORE any oracle-relevant state.
let DTLS_CERT_NOT_PINNED         = "dtls-cert-not-pinned"
let DTLS_CERT_HOSTNAME_MISMATCH  = "dtls-cert-hostname-mismatch"

// ============================================================================
//                              Protocol constants
// ============================================================================

// DTLS 1.2 wire version per RFC 6347 section 4.1.
//   major = 254 (0xfe), minor = 253 (0xfd) -- the off-by-one inversion
//   relative to TLS 1.2 (3.3) is historical: DTLS picks numbers that
//   collate AFTER TLS so an intermediary that key-orders versions
//   prefers TLS over DTLS by default.
let DTLS_VERSION_MAJOR = 254     // 0xfe
let DTLS_VERSION_MINOR = 253     // 0xfd
let DTLS_VERSION_WORD  = 65277   // 0xfefd  (major<<8 | minor)

// ContentType (RFC 5246 section 6.2.1 / RFC 6347 section 4.1):
//   change_cipher_spec(20), alert(21), handshake(22), application_data(23).
let DTLS_CT_CCS              = 20
let DTLS_CT_ALERT            = 21
let DTLS_CT_HANDSHAKE        = 22
let DTLS_CT_APPLICATION_DATA = 23

// HandshakeType (RFC 5246 section 7.4):
let DTLS_HS_HELLO_REQUEST       = 0
let DTLS_HS_CLIENT_HELLO        = 1
let DTLS_HS_SERVER_HELLO        = 2
let DTLS_HS_HELLO_VERIFY_REQ    = 3    // DTLS-specific (RFC 6347 4.2.1)
let DTLS_HS_CERTIFICATE         = 11
let DTLS_HS_SERVER_KEY_EXCHANGE = 12
let DTLS_HS_CERT_REQUEST        = 13
let DTLS_HS_SERVER_HELLO_DONE   = 14
let DTLS_HS_CERT_VERIFY         = 15
let DTLS_HS_CLIENT_KEY_EXCHANGE = 16
let DTLS_HS_FINISHED            = 20

// Cipher suites (RFC 5289). We accept exactly ONE:
//   TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 = { 0xC0, 0x2B }
let DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256 = 49195   // 0xC02B

// Record-header fixed length (RFC 6347 4.1): 13 bytes
//   1B type + 2B version + 2B epoch + 6B seq + 2B length.
let DTLS_RECORD_HDR_LEN = 13

// Handshake-envelope header length (RFC 6347 4.2): 12 bytes
//   1B msg_type + 3B length + 2B message_seq + 3B frag_off + 3B frag_len.
let DTLS_HS_HDR_LEN = 12

// Per-record fragment max -- RFC 6347 (2^14 plaintext). For the
// skeleton we cap any single serialize call at this limit so the
// 16-bit length field cannot overflow.
let DTLS_RECORD_MAX_FRAGMENT = 16384

// ============================================================================
//                         State machine
// ============================================================================
//
// Linear progression from INIT through ESTABLISHED. ANY state -> FAILED
// is permitted (we want hard-fail to be reachable from anywhere). No
// other backward transitions are allowed: a handshake that takes the
// wrong fork must restart from scratch (a fresh `dtls_init` state).

let DTLS_S_INIT                = 0
let DTLS_S_CLIENT_HELLO_SENT   = 1
let DTLS_S_SERVER_HELLO_RECVD  = 2
let DTLS_S_CERTIFICATE_RECVD   = 3
let DTLS_S_FINISHED            = 4
let DTLS_S_ESTABLISHED         = 5
let DTLS_S_FAILED              = 6

// Phase P R1 (ADR-0097): server-side handshake states. Appended (values
// 10..14) so the R29B client-side enum stays byte-identical for any
// switch-on-state code that pins the original constants.
let DTLS_S_CLIENT_HELLO_RECVD  = 10
let DTLS_S_SERVER_HELLO_SENT   = 11
let DTLS_S_CERT_SENT           = 12
let DTLS_S_SKE_SENT            = 13
let DTLS_S_SHD_SENT            = 14

fn dtls_state_name(s) {
    if s == DTLS_S_INIT               { return "INIT" }
    if s == DTLS_S_CLIENT_HELLO_SENT  { return "CLIENT_HELLO_SENT" }
    if s == DTLS_S_SERVER_HELLO_RECVD { return "SERVER_HELLO_RECVD" }
    if s == DTLS_S_CERTIFICATE_RECVD  { return "CERTIFICATE_RECVD" }
    if s == DTLS_S_FINISHED           { return "FINISHED" }
    if s == DTLS_S_ESTABLISHED        { return "ESTABLISHED" }
    if s == DTLS_S_FAILED             { return "FAILED" }
    if s == DTLS_S_CLIENT_HELLO_RECVD { return "CLIENT_HELLO_RECVD" }
    if s == DTLS_S_SERVER_HELLO_SENT  { return "SERVER_HELLO_SENT" }
    if s == DTLS_S_CERT_SENT          { return "CERT_SENT" }
    if s == DTLS_S_SKE_SENT           { return "SKE_SENT" }
    if s == DTLS_S_SHD_SENT           { return "SHD_SENT" }
    return "UNKNOWN"
}

// Valid transitions: linear forward + any-to-FAILED.
// Caller drives the state machine; we validate the edge.
//
// Phase P R1 extension: the server-side chain (INIT ->
// CLIENT_HELLO_RECVD -> SERVER_HELLO_SENT -> CERT_SENT -> SKE_SENT ->
// SHD_SENT) is validated in addition to the R29B client-side chain.
// Both chains still terminate cleanly into FAILED from any state.
fn _dtls_valid_edge(from, to) {
    if to == DTLS_S_FAILED { return 1 }
    if from == DTLS_S_INIT               { if to == DTLS_S_CLIENT_HELLO_SENT  { return 1 } }
    if from == DTLS_S_CLIENT_HELLO_SENT  { if to == DTLS_S_SERVER_HELLO_RECVD { return 1 } }
    if from == DTLS_S_SERVER_HELLO_RECVD { if to == DTLS_S_CERTIFICATE_RECVD  { return 1 } }
    if from == DTLS_S_CERTIFICATE_RECVD  { if to == DTLS_S_FINISHED           { return 1 } }
    if from == DTLS_S_FINISHED           { if to == DTLS_S_ESTABLISHED        { return 1 } }
    // Phase P R1 server-side chain.
    if from == DTLS_S_INIT               { if to == DTLS_S_CLIENT_HELLO_RECVD { return 1 } }
    if from == DTLS_S_CLIENT_HELLO_RECVD { if to == DTLS_S_SERVER_HELLO_SENT  { return 1 } }
    if from == DTLS_S_SERVER_HELLO_SENT  { if to == DTLS_S_CERT_SENT          { return 1 } }
    if from == DTLS_S_CERT_SENT          { if to == DTLS_S_SKE_SENT           { return 1 } }
    if from == DTLS_S_SKE_SENT           { if to == DTLS_S_SHD_SENT           { return 1 } }
    return 0
}

// ============================================================================
//                         dtls_state record
// ============================================================================
//
// Flat list-of-slots record. Pinned constants keep the layout stable
// when R29B.2 adds slots for the per-direction AEAD context + the
// retransmission timer state at the tail.

let DTLS_S_SLOT_STATE          = 0   // int (DTLS_S_*)
let DTLS_S_SLOT_MSG_SEQ        = 1   // int -- next handshake message_seq
let DTLS_S_SLOT_EPOCH          = 2   // int -- current epoch
let DTLS_S_SLOT_REC_SEQ        = 3   // int -- low 48 bits of seq counter
let DTLS_S_SLOT_FLIGHT_RTX     = 4   // int -- retransmit counter
let DTLS_S_SLOT_CIPHER_SUITE   = 5   // int -- negotiated suite (0 until set)
let DTLS_S_SLOT_SERVER_NAME    = 6   // string -- SNI carried in CH
let DTLS_S_SLOT_LAST_ERR       = 7   // string -- most recent err tag
let DTLS_S_SLOT_RECORDS_OUT    = 8   // int -- serialize counter
let DTLS_S_SLOT_RECORDS_IN     = 9   // int -- parse counter
let DTLS_S_SLOT_HS_OUT         = 10  // int -- handshake msgs emitted
let DTLS_S_SLOT_HS_IN          = 11  // int -- handshake msgs parsed

// ----------------------------------------------------------------------------
// R31B cipher-state slots. Appended at the tail so the original 12-slot
// layout is preserved byte-identical for any caller (or test) that
// indexes into state by slot number.
// ----------------------------------------------------------------------------
//
// IS_SERVER drives which key/IV pair drives seal vs open. The local
// party seals with its WRITE key and opens with the PEER's WRITE key
// (i.e. its READ key); the IS_SERVER flag is the disambiguator on the
// key_block slicing per RFC 5246 §6.3.
//
// CIPHER_ACTIVE flips from 0 to 1 the first time `dtls_ecdhe_derive`
// finishes populating the key_block. `dtls_seal_record` and
// `dtls_open_record` refuse to run unless this is set -- the AEAD
// path is meaningless before keys exist, and crashing instead of
// silently emitting zero bytes is the safer failure mode.
//
// SEND_SEQ / RECV_SEQ are SEPARATE from the record-layer REC_SEQ. The
// record-layer seq is the 48-bit wire field; the AEAD-direction
// counters are what we plug into the explicit-IV and AAD so that
// per-direction seq is independent (a server can emit 5 records
// before the client emits any). R29B's REC_SEQ stays as a
// "transmitter cursor" -- for R31B AEAD records we use SEND_SEQ.
//
// TAMPER_* counters are R31B telemetry: every distinct rejection
// path bumps a counter so test_open_record_tamper_* can assert each
// path independently. They are NOT reset across opens.

let DTLS_S_SLOT_IS_SERVER          = 12  // int -- 0 = client, 1 = server
let DTLS_S_SLOT_CIPHER_ACTIVE      = 13  // int -- 0 until ECDHE derive
let DTLS_S_SLOT_PRIV_BN            = 14  // bn256 -- local ECDH private scalar
let DTLS_S_SLOT_LOCAL_PUB          = 15  // 33B buf -- local compressed pub
let DTLS_S_SLOT_PEER_PUB           = 16  // 33B (or 0) -- peer compressed pub
let DTLS_S_SLOT_CLIENT_RANDOM      = 17  // 32B buf -- ClientHello.random
let DTLS_S_SLOT_SERVER_RANDOM      = 18  // 32B buf -- ServerHello.random
let DTLS_S_SLOT_MASTER_SECRET      = 19  // 48B buf -- PRF master_secret
let DTLS_S_SLOT_KEY_BLOCK          = 20  // 40B buf -- PRF key_block
let DTLS_S_SLOT_CLIENT_WRITE_KEY   = 21  // 16B buf -- client_write_key
let DTLS_S_SLOT_SERVER_WRITE_KEY   = 22  // 16B buf -- server_write_key
let DTLS_S_SLOT_CLIENT_WRITE_IV    = 23  // 4B buf  -- client implicit IV
let DTLS_S_SLOT_SERVER_WRITE_IV    = 24  // 4B buf  -- server implicit IV
let DTLS_S_SLOT_SEND_SEQ           = 25  // int -- per-direction send counter
let DTLS_S_SLOT_RECV_SEQ           = 26  // int -- per-direction recv counter
let DTLS_S_SLOT_TAMPER_CT          = 27  // int -- ciphertext-tamper rejects
let DTLS_S_SLOT_TAMPER_TAG         = 28  // int -- tag-tamper rejects
let DTLS_S_SLOT_TAMPER_AAD         = 29  // int -- AAD-mismatch rejects
let DTLS_S_SLOT_AEAD_RECORDS_OUT   = 30  // int -- successful seals
let DTLS_S_SLOT_AEAD_RECORDS_IN    = 31  // int -- successful opens

// ----------------------------------------------------------------------------
// R32B anti-replay sliding window (RFC 6347 §4.1.2.6). Per-direction
// receive-side state appended at the tail to preserve byte-identical
// layout of slots 0..31 for any caller / test that indexes by slot.
//
// High-level algorithm:
//   * `RECV_HIGH_WATERMARK` (u64) -- the largest sequence number we
//     have ever VALIDATED (i.e. that survived the AEAD tag check).
//     Bit 0 of `RECV_REPLAY_MASK` represents this seq.
//   * `RECV_REPLAY_MASK` (u64) -- bitmap of the most recent 64 seqs.
//     Bit i (LSB-indexed) represents whether seq (high_watermark - i)
//     has been validated.
//
// On a received record with seq S:
//   1. If S > high_watermark           -> ABOVE-WINDOW; tentatively
//      accept (window will slide AFTER the AEAD tag check passes).
//   2. If S <= high_watermark and (high_watermark - S) < 64 -> WITHIN
//      WINDOW; check bit. If set -> REPLAY. If clear -> tentatively
//      accept (will set bit AFTER AEAD passes).
//   3. If S < high_watermark - 63      -> TOO_OLD; reject.
//
// The "tentative accept" + "window update only on AEAD success"
// split is critical (deliverable 5): an attacker who forges a record
// at seq high_watermark+1 with a bad MAC must NOT be able to advance
// the window and thereby cause the legitimate next packet to be
// dropped. The check is cheap (a shift + bit test) so doing it
// before the AEAD call avoids spending crypto cycles on replays.
//
// Special case: at startup `RECV_HIGH_WATERMARK == 0` AND `RECV_
// REPLAY_MASK == 0`. The convention is that bit 0 = 0 means "seq 0
// not yet seen", so seq=0 is acceptable on the first open call and
// rejected as a replay on the second.
//
// `RECV_STATS_REPLAY` / `RECV_STATS_TOO_OLD` are independent
// counters bumped on the corresponding rejection path -- they let
// the test suite assert which path was taken without inspecting
// last_err strings (a stable telemetry surface).
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_RECV_HIGH_WATERMARK = 32  // u64 -- highest validated seq
let DTLS_S_SLOT_RECV_REPLAY_MASK    = 33  // u64 bitmap (LSB = high_watermark)
let DTLS_S_SLOT_STATS_REPLAY        = 34  // int -- replay-rejected count
let DTLS_S_SLOT_STATS_TOO_OLD       = 35  // int -- too-old-rejected count

// ----------------------------------------------------------------------------
// R33B cert-verify telemetry + CCS-epoch reset state. Appended at the
// tail so slots 0..35 (R29B + R31B + R32B) stay byte-identical.
//
// `DTLS_S_SLOT_CURRENT_TIME_UNIX` is the wall-clock the caller pins
// before invoking `dtls_cert_verify`. We DELIBERATELY do not pull this
// from a builtin syscall here -- handshake timing must be deterministic
// in tests, and the caller (the wire driver) has the cleanest view of
// what "now" means for a given handshake. `dtls_set_current_time(state,
// unix_sec)` is the public setter.
//
// `DTLS_S_SLOT_RECV_EPOCH` is the per-side receive epoch counter.
// `DTLS_S_SLOT_EPOCH` (index 2, from R29B) is the per-side SEND epoch
// (the AAD seq_num field that the seal path stamps into wire bytes).
// `dtls_advance_epoch(state)` bumps BOTH counters by 1 and resets the
// four sequence-window slots to zero (RFC 6347 §4.1.2.6 mandates this
// on ChangeCipherSpec). The receive counter exists separately so the
// open path can sanity-check "wire_epoch >= state.recv_epoch" (i.e.
// the peer is at OR ahead of our current expected epoch, not behind).
// Strict enforcement is documented as a future hardening item -- for
// R33B we permit equal-or-ahead wire epochs to keep cross-epoch test
// cases legible.
//
// The five `STATS_CERT_*` counters mirror the R32B `STATS_REPLAY` /
// `STATS_TOO_OLD` pattern: every cert-verify outcome bumps exactly
// one counter so a test can assert the path taken without parsing
// the return string.
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_STATS_CERT_OK          = 36  // int -- successful cert verifies
let DTLS_S_SLOT_STATS_CERT_PARSE_FAIL  = 37  // int -- x509_parse rejections
let DTLS_S_SLOT_STATS_CERT_EXPIRED     = 38  // int -- expired / not-yet-valid
let DTLS_S_SLOT_STATS_CERT_SIG_FAIL    = 39  // int -- ECDSA verify rejections
let DTLS_S_SLOT_STATS_CERT_FP_MISMATCH = 40  // int -- fingerprint mismatches
let DTLS_S_SLOT_CURRENT_TIME_UNIX      = 41  // int -- caller-supplied wall-clock
let DTLS_S_SLOT_RECV_EPOCH             = 42  // int -- per-side recv epoch

// ----------------------------------------------------------------------------
// R36B (R35A.2 / R33B.3): cached DTLS-SRTP keying material slot. R35A's
// `dtls_export_srtp_keying_material(state)` runs the TLS 1.2 PRF (two
// HMAC-SHA256 iterations to expand 60 bytes) on every call. R35A's exit
// caveat said per-call recompute is fine because the function is invoked
// exactly once per session post-handshake -- but a future use case might
// poll the exporter (e.g. a wire-driver that re-extracts keys on a
// recovery path) and the recompute is wasted work. R36B caches the
// 60-byte buf in a fresh tail-appended slot and serves cache hits
// instead of re-running the PRF.
//
// `DTLS_S_SLOT_SRTP_KM_CACHED` holds either:
//   * 0           -- no cache; the next exporter call computes + stores.
//   * non-zero    -- pointer to the 60-byte buf returned by the most
//                    recent compute. Subsequent calls return THIS pointer
//                    verbatim (not a fresh copy) so callers that pin the
//                    pointer for equality (e.g. cache-hit assertions in
//                    tests) get a stable identity.
//
// `DTLS_S_SLOT_STATS_SRTP_KM_HITS` is a cumulative cache-hit counter; the
// first compute does NOT bump it, but every subsequent serve-from-cache
// does. The accessor `dtls_stats_srtp_km_hits(state)` reads it.
//
// Cache invalidation: `dtls_advance_epoch(state)` (the R33B
// CCS-on-epoch-change hook) clears this slot back to 0. The rationale:
// although the SRTP exporter is anchored to the `master_secret` (which
// does NOT change on a CCS that re-derives only the AEAD key block),
// RFC 5764 §4.2 leaves the door open for a DTLS re-handshake (epoch
// advance with a fresh PRF expansion) to feed new SRTP keys. The safe
// default is to invalidate on epoch advance: if the master_secret
// genuinely is the same, the next exporter call recomputes the SAME
// 60 bytes (idempotent re-derivation) and the cost is at most one
// extra PRF expansion per epoch transition. The opposite default
// (never invalidate) would silently serve stale keys after a real
// re-handshake -- a security footgun. Invalidate-on-epoch-advance is
// the correct + cheap choice.
//
// The hits counter is NOT reset on epoch advance: it is cumulative
// telemetry across the connection lifetime, mirroring the R32B
// `STATS_REPLAY` / `STATS_TOO_OLD` and R33B `STATS_CERT_*` patterns.
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_SRTP_KM_CACHED      = 43  // 60B buf | 0 -- memoized PRF expand
let DTLS_S_SLOT_STATS_SRTP_KM_HITS  = 44  // int -- cache-hit count

// R38B (R33B.4): PRF rekey counter on CCS / epoch advance.
//
// `DTLS_S_SLOT_STATS_REKEYS` is a cumulative count of `dtls_advance_epoch`
// invocations that successfully re-ran the TLS 1.2 PRF to re-derive the
// 40-byte `key_block` (and re-slice the four sub-buffers
// `client_write_key`, `server_write_key`, `client_write_iv`,
// `server_write_iv`). R33B's exit caveat explicitly deferred this:
//
//   > We do NOT re-derive keys here. Real DTLS-CCS rekeys via the PRF
//   > (key_block expansion under the new epoch's seed). R33B's simple
//   > model keeps the same `key_block` / `client_write_*` /
//   > `server_write_*` buffers, so old wire records sealed under the
//   > same key can still AEAD-decrypt successfully if the AAD seq_num
//   > matches.
//
// R38B closes that caveat. On every `dtls_advance_epoch` we re-expand
// the 40-byte `key_block` from the SAME `master_secret` +
// `server_random || client_random` seed (RFC 5246 §6.3 / RFC 6347
// §4.1.2.6) and re-slice the four sub-buffers. We call this the
// "soft-rekey" path -- the master_secret is unchanged (the ECDHE-derived
// secret survives the CCS), so re-running the SAME PRF inputs produces
// the SAME 40 bytes. The semantic value is in (a) the telemetry: a
// monitor can watch `dtls_stats_rekeys(state)` to know how many times
// the key_block was re-expanded across the connection lifetime, and
// (b) the architectural hook: a future variant that mixes the new
// epoch number into the PRF seed (non-standard, but matches the
// security intuition of "fresh keys per epoch") slots in at the same
// call site. R38B ships variant A (the standards-compliant version);
// variant B is documented as a research item.
//
// Cross-epoch differentiation: because the AEAD AAD's upper 16 bits
// carry the epoch number (RFC 6347 §4.1.2.1), a record sealed at
// (epoch=0, seq=N) and the SAME plaintext sealed at (epoch=1, seq=N)
// produce DIFFERENT AEAD inputs -- the AAD differs in the epoch
// field -- so the resulting ciphertext + tag are NOT byte-identical
// even when the key_block bytes are. Cross-epoch replay protection
// therefore holds at the AAD layer; the PRF re-run by itself is
// telemetry + a hook, not the load-bearing security property.
//
// The counter is cumulative across the connection lifetime; it is
// NOT reset on `dtls_advance_epoch` (mirrors the R32B / R33B
// `STATS_REPLAY` / `STATS_CERT_*` / R36B `STATS_SRTP_KM_HITS`
// patterns). Accessor: `dtls_stats_rekeys(state)`.
//
// Pre-cipher case: if `dtls_advance_epoch` runs BEFORE
// `dtls_ecdhe_derive` has populated `master_secret` /
// `client_random` / `server_random`, there is no PRF input to
// expand. We detect that condition (any of the three slots == 0)
// and SKIP the re-derivation -- the counter still bumps so the
// caller sees that the advance happened, but the cipher slots are
// left untouched (they were 0 anyway). This keeps the function
// total: it never fails, mirroring the R33B contract.
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_STATS_REKEYS        = 45  // int -- key_block re-expand count

// Phase O R1 (ADR-0094): chain-aware cert-verify telemetry. Two fresh
// tail-appended stats slots so the R33B slot layout (0..45) stays
// byte-identical. These mirror the R33B `STATS_CERT_*` pattern: every
// `dtls_cert_verify_chain` outcome bumps exactly one counter. Existing
// `STATS_CERT_OK` / `STATS_CERT_PARSE_FAIL` / `STATS_CERT_EXPIRED` /
// `STATS_CERT_SIG_FAIL` are shared with the legacy single-cert path so
// the counters stay unified across both entries.
let DTLS_S_SLOT_STATS_CERT_NOT_PINNED        = 46  // int -- root not in anchors
let DTLS_S_SLOT_STATS_CERT_HOSTNAME_MISMATCH = 47  // int -- SAN did not cover host

// ----------------------------------------------------------------------------
// Phase O R2 (ADR-0095): DTLS-SRTP profile offer + `use_srtp` extension.
//
// `DTLS_S_SLOT_SRTP_OFFER` carries the SRTP protection profile ID the
// local side offers in its ClientHello `use_srtp` extension (RFC 5764
// §4.1.1). Zero means "no offer" -- the extension is NOT emitted and the
// ClientHello wire bytes are identical to the pre-R2 shape (backwards
// compatible with any existing test that pins wire bytes).
//
// A non-zero value must be one of the SRTP_PROFILE_* constants below; the
// `dtls_offer_srtp(state, profile)` setter validates the value and
// no-ops on unknown IDs (with a stats-side warning). Once set, the next
// `dtls_client_init(state, server_name)` call inspects this slot and
// splices the 9-byte extension into the ClientHello extensions block.
//
// Tail-appended at index 48 so slots 0..47 (R29B + R31B + R32B + R33B +
// R36B + R38B + R1) stay byte-identical for any caller / test that
// indexes into state by slot number.
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_SRTP_OFFER = 48  // int -- SRTP_PROFILE_* offered in CH, 0 = none

// ----------------------------------------------------------------------------
// Phase P R1 (ADR-0097): server-side handshake flight tail slots.
//
// `DTLS_S_SLOT_TRANSCRIPT_CTX` carries the running SHA-256 accumulator over
// every handshake message on the flight. The RFC 5246 §7.4.9 Finished MAC is
// computed as PRF(master_secret, "client finished"|"server finished",
// SHA-256(handshake_messages), 12). The transcript is written on every SEND
// (server flight R1 stamps ServerHello / Cert / SKE / SHD; R2 stamps CKE /
// CCS / Finished) and every RECV (server flight R1 stamps the ClientHello;
// R2 stamps the client's CKE / CCS / Finished).
//
// The chosen representation is a growing byte BUFFER (not a live SHA-256
// context). Rationale: sha256_final consumes the streaming ctx (its
// contract says "The state must not be reused after this call"), and
// R2 needs to finalize the transcript TWICE at different points -- once
// for the client Finished, once for the server Finished -- with the
// second finalize inspecting more bytes than the first. Storing the raw
// byte buffer keeps the API non-destructive: dtls_transcript_finalize
// runs sha256_oneshot over the buffer without touching the buffer, so a
// subsequent absorb + finalize is well-defined. The extra one-shot SHA is
// cheap in the handshake path (bytes are small; the operation runs
// twice per handshake at most).
//
// `DTLS_S_SLOT_TRANSCRIPT_N` holds the byte-count of the buffer so the
// finalize path knows how many bytes to hash without walking the buffer
// looking for a sentinel.
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_TRANSCRIPT_CTX = 49  // buf | 0 -- growing HS-message byte buffer
let DTLS_S_SLOT_TRANSCRIPT_N   = 50  // int    -- valid byte count in the buffer

// `DTLS_S_SLOT_SERVER_RANDOM_OVERRIDE` is a test-mode hook: when the
// server flight driver calls secure_random(32) and the pull returns
// non-32 (or is unavailable), it falls back to whatever 32-byte buffer
// this slot points at, provided the slot has been populated. Prod paths
// leave the slot at 0 so the fallback path is a no-op; unit tests
// populate it so ServerHello bytes stay reproducible across runs.
let DTLS_S_SLOT_SERVER_RANDOM_OVERRIDE = 51  // buf | 0 -- 32B override for tests

// ----------------------------------------------------------------------------
// Phase P R2 (ADR-0098): client-side handshake flight tail slots.
//
// `DTLS_S_SLOT_CLIENT_RANDOM_OVERRIDE` mirrors the R1 server-side override:
// when the client's ClientHello builder cannot pull 32 bytes from
// secure_random (entropy unavailable in the test harness), it falls back
// to whatever 32-byte buffer this slot points at. Prod paths leave it at 0
// so the fallback path is a no-op; unit tests populate it so ClientHello
// bytes stay reproducible across runs.
//
// `DTLS_S_SLOT_HOSTNAME` + `DTLS_S_SLOT_ANCHORS` carry the values
// `gds_handshake_client` supplies (per Phase O R3's plumbing) so the
// client-flight driver can hand them to `dtls_cert_verify_chain` when the
// server's Certificate arrives. Kept on the state (rather than passed as
// function args threaded through every internal helper) because the
// verify call happens deep in the flight driver after several records
// have been read; a state slot is the cleanest cross-call carrier.
//
// Tail-appended at 52/53/54 so slots 0..51 stay byte-identical -- any
// caller that indexes into state by slot number continues to work.
// ----------------------------------------------------------------------------

let DTLS_S_SLOT_CLIENT_RANDOM_OVERRIDE = 52  // buf | 0 -- 32B override for tests
let DTLS_S_SLOT_HOSTNAME               = 53  // string | 0 -- verify target host
let DTLS_S_SLOT_ANCHORS                = 54  // list | 0 -- trust anchors

// ----------------------------------------------------------------------------
// RFC 5764 §4.1 `use_srtp` extension type + §4.1.2 SRTP protection
// profile IDs. R2 exposes the four profiles the RFC's initial registry
// enumerates; only AES128_CM_SHA1_80 is exercised in the ClientHello
// emission tests but the full set is defined so future rounds can
// negotiate over the wire without another constant-add hop.
// ----------------------------------------------------------------------------

let DTLS_EXT_USE_SRTP                = 14  // RFC 5764 §4.1.1 extension_type
let SRTP_PROFILE_AES128_CM_SHA1_80   = 1   // RFC 5764 §4.1.2 (SRTP_AES128_CM_HMAC_SHA1_80)
let SRTP_PROFILE_AES128_CM_SHA1_32   = 2   // RFC 5764 §4.1.2 (SRTP_AES128_CM_HMAC_SHA1_32)
let SRTP_PROFILE_NULL_SHA1_80        = 5   // RFC 5764 §4.1.2 (SRTP_NULL_HMAC_SHA1_80)
let SRTP_PROFILE_NULL_SHA1_32        = 6   // RFC 5764 §4.1.2 (SRTP_NULL_HMAC_SHA1_32)

fn dtls_init() {
    let st = list_new()
    push(st, DTLS_S_INIT)        // state
    push(st, 0)                  // msg_seq
    push(st, 0)                  // epoch
    push(st, 0)                  // rec_seq
    push(st, 0)                  // flight_rtx
    push(st, 0)                  // cipher_suite
    push(st, "")                 // server_name
    push(st, "")                 // last_err
    push(st, 0)                  // records_out
    push(st, 0)                  // records_in
    push(st, 0)                  // hs_out
    push(st, 0)                  // hs_in
    // R31B cipher-state slots; all start zero / unset.
    push(st, 0)                  // is_server
    push(st, 0)                  // cipher_active
    push(st, 0)                  // priv_bn
    push(st, 0)                  // local_pub
    push(st, 0)                  // peer_pub
    push(st, 0)                  // client_random
    push(st, 0)                  // server_random
    push(st, 0)                  // master_secret
    push(st, 0)                  // key_block
    push(st, 0)                  // client_write_key
    push(st, 0)                  // server_write_key
    push(st, 0)                  // client_write_iv
    push(st, 0)                  // server_write_iv
    push(st, 0)                  // send_seq
    push(st, 0)                  // recv_seq
    push(st, 0)                  // tamper_ct
    push(st, 0)                  // tamper_tag
    push(st, 0)                  // tamper_aad
    push(st, 0)                  // aead_records_out
    push(st, 0)                  // aead_records_in
    // R32B anti-replay slots; all zero (no records validated yet).
    push(st, 0)                  // recv_high_watermark
    push(st, 0)                  // recv_replay_mask
    push(st, 0)                  // stats_replay
    push(st, 0)                  // stats_too_old
    // R33B cert-verify telemetry + CCS-epoch reset state.
    push(st, 0)                  // stats_cert_ok
    push(st, 0)                  // stats_cert_parse_fail
    push(st, 0)                  // stats_cert_expired
    push(st, 0)                  // stats_cert_sig_fail
    push(st, 0)                  // stats_cert_fp_mismatch
    push(st, 0)                  // current_time_unix (caller pins via setter)
    push(st, 0)                  // recv_epoch
    // R36B SRTP keying-material cache + hit counter.
    push(st, 0)                  // srtp_km_cached (no cache; first call computes)
    push(st, 0)                  // stats_srtp_km_hits
    // R38B PRF-rekey counter on epoch advance.
    push(st, 0)                  // stats_rekeys
    // Phase O R1 (ADR-0094) chain-aware cert-verify counters.
    push(st, 0)                  // stats_cert_not_pinned
    push(st, 0)                  // stats_cert_hostname_mismatch
    // Phase O R2 (ADR-0095) SRTP profile offer for `use_srtp` extension.
    push(st, 0)                  // srtp_offer (0 = none; extension not emitted)
    // Phase P R1 (ADR-0097) server-side handshake flight tail slots.
    push(st, 0)                  // transcript_ctx (0 = not initialized)
    push(st, 0)                  // transcript_n
    push(st, 0)                  // server_random_override (test-mode only)
    // Phase P R2 (ADR-0098) client-side handshake flight tail slots.
    push(st, 0)                  // client_random_override (test-mode only)
    push(st, 0)                  // hostname (client-flight verify target)
    push(st, 0)                  // anchors (client-flight trust store)
    return st
}

fn dtls_state_get(state)               { return state[DTLS_S_SLOT_STATE] }
fn dtls_record_epoch(state)            { return state[DTLS_S_SLOT_EPOCH] }
fn dtls_record_seq(state)              { return state[DTLS_S_SLOT_REC_SEQ] }
fn dtls_flight_retransmit_count(state) { return state[DTLS_S_SLOT_FLIGHT_RTX] }
fn dtls_negotiated_suite(state)        { return state[DTLS_S_SLOT_CIPHER_SUITE] }
fn dtls_last_error(state)              { return state[DTLS_S_SLOT_LAST_ERR] }
fn dtls_records_out(state)             { return state[DTLS_S_SLOT_RECORDS_OUT] }
fn dtls_records_in(state)              { return state[DTLS_S_SLOT_RECORDS_IN] }
fn dtls_hs_out(state)                  { return state[DTLS_S_SLOT_HS_OUT] }
fn dtls_hs_in(state)                   { return state[DTLS_S_SLOT_HS_IN] }

// Drive a transition. Returns 1 on success, 0 if the edge is rejected.
// On reject, `last_err` is set to DTLS_ERR_BAD_STATE.
fn dtls_transition(state, next) {
    let cur = state[DTLS_S_SLOT_STATE]
    if _dtls_valid_edge(cur, next) == 0 {
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_ERR_BAD_STATE
        return 0
    }
    state[DTLS_S_SLOT_STATE] = next
    return 1
}

// Post-increment the handshake message_seq counter. RFC 6347 4.2.2:
// each NEW handshake message (not retransmission) gets a fresh seq.
// Returns the value used (pre-increment).
fn dtls_msg_seq_next(state) {
    let s = state[DTLS_S_SLOT_MSG_SEQ]
    state[DTLS_S_SLOT_MSG_SEQ] = s + 1
    return s
}

// Bump the flight retransmit counter (without actually resending).
fn dtls_record_retransmit(state) {
    state[DTLS_S_SLOT_FLIGHT_RTX] = state[DTLS_S_SLOT_FLIGHT_RTX] + 1
    return state[DTLS_S_SLOT_FLIGHT_RTX]
}

// Post-increment the record sequence number. The wire field is 48 bits;
// we mask after the bump so values cycle if they ever wrap (a wrap
// during a single connection requires re-key per RFC 6347 4.1, which is
// part of R29B.2's epoch-management story -- not enforced here).
let _DTLS_SEQ_MASK = 281474976710655   // (1 << 48) - 1 = 0xFFFFFFFFFFFF

fn _dtls_seq_next(state) {
    let s = state[DTLS_S_SLOT_REC_SEQ]
    let n = int_and(s + 1, _DTLS_SEQ_MASK)
    state[DTLS_S_SLOT_REC_SEQ] = n
    return s
}

// ============================================================================
//                         Cipher-suite gate
// ============================================================================
//
// `suites` is a list of integers (each a 16-bit suite ID). Returns the
// FIRST suite we accept, or DTLS_ERR_NO_CIPHER if none match. R29B
// accepts exactly one suite (the WebRTC interop minimum); a R29B.2
// extension can broaden the table without changing this signature.

fn dtls_select_cipher_suite(suites) {
    if suites == 0 { return DTLS_ERR_NO_CIPHER }
    let i = 0
    while i < len(suites) {
        if suites[i] == DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256 {
            return DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256
        }
        i = i + 1
    }
    return DTLS_ERR_NO_CIPHER
}

// ============================================================================
//                  Big-endian byte serialization helpers
// ============================================================================
//
// DTLS / TLS is BIG-ENDIAN on the wire. All multi-byte integers are
// network byte order. We provide 8 / 16 / 24 / 48 / 64-bit packers
// against a raw alloc'd byte buffer.

fn _dtls_put_u8(buf, off, v) {
    store8(buf + off, int_and(v, 255))
    return 1
}

fn _dtls_put_u16(buf, off, v) {
    store8(buf + off + 0, int_and(int_shr(v, 8), 255))
    store8(buf + off + 1, int_and(v, 255))
    return 1
}

fn _dtls_put_u24(buf, off, v) {
    store8(buf + off + 0, int_and(int_shr(v, 16), 255))
    store8(buf + off + 1, int_and(int_shr(v, 8), 255))
    store8(buf + off + 2, int_and(v, 255))
    return 1
}

fn _dtls_put_u48(buf, off, v) {
    store8(buf + off + 0, int_and(int_shr(v, 40), 255))
    store8(buf + off + 1, int_and(int_shr(v, 32), 255))
    store8(buf + off + 2, int_and(int_shr(v, 24), 255))
    store8(buf + off + 3, int_and(int_shr(v, 16), 255))
    store8(buf + off + 4, int_and(int_shr(v, 8), 255))
    store8(buf + off + 5, int_and(v, 255))
    return 1
}

fn _dtls_get_u8(buf, off)  { return load8(buf + off) }

fn _dtls_get_u16(buf, off) {
    let hi = load8(buf + off + 0)
    let lo = load8(buf + off + 1)
    return int_or(int_shl(hi, 8), lo)
}

fn _dtls_get_u24(buf, off) {
    let a = load8(buf + off + 0)
    let b = load8(buf + off + 1)
    let c = load8(buf + off + 2)
    return int_or(int_or(int_shl(a, 16), int_shl(b, 8)), c)
}

fn _dtls_get_u48(buf, off) {
    let a = load8(buf + off + 0)
    let b = load8(buf + off + 1)
    let c = load8(buf + off + 2)
    let d = load8(buf + off + 3)
    let e = load8(buf + off + 4)
    let f = load8(buf + off + 5)
    let hi = int_or(int_shl(a, 8), b)             // top 16
    let mid = int_or(int_shl(c, 8), d)            // mid 16
    let lo  = int_or(int_shl(e, 8), f)            // low 16
    return int_or(int_or(int_shl(hi, 32), int_shl(mid, 16)), lo)
}

// Copy `n` bytes from src to dst at the given offsets.
fn _dtls_copy_bytes(dst, dst_off, src, src_off, n) {
    let i = 0
    while i < n {
        store8(dst + dst_off + i, load8(src + src_off + i))
        i = i + 1
    }
    return 1
}

// ============================================================================
//                      Record-layer serialize / parse
// ============================================================================
//
// RFC 6347 section 4.1:
//
//   struct {
//     ContentType type;             // 1 byte
//     ProtocolVersion version;      // 2 bytes (major/minor)
//     uint16 epoch;                 // 2 bytes
//     uint48 sequence_number;       // 6 bytes
//     uint16 length;                // 2 bytes
//     opaque fragment[length];      // length bytes
//   } DTLSPlaintext;
//
// Total header: 13 bytes. We pass `fragment` as a (buf, n) pair so the
// caller can pre-allocate the wire image without an intermediate copy.
// Output: [serialized_buf, total_len] -- caller takes ownership.

fn dtls_record_serialize(type_byte, version_word, epoch, seq, fragment_buf, frag_n) {
    if frag_n < 0 { return 0 }
    if frag_n > DTLS_RECORD_MAX_FRAGMENT { return 0 }
    let total = DTLS_RECORD_HDR_LEN + frag_n
    let out = alloc(total + 1)
    _dtls_put_u8(out, 0, type_byte)
    _dtls_put_u16(out, 1, version_word)
    _dtls_put_u16(out, 3, epoch)
    _dtls_put_u48(out, 5, seq)
    _dtls_put_u16(out, 11, frag_n)
    if frag_n > 0 {
        _dtls_copy_bytes(out, DTLS_RECORD_HDR_LEN, fragment_buf, 0, frag_n)
    }
    store8(out + total, 0)
    let result = list_new()
    push(result, out)
    push(result, total)
    return result
}

// Parse a record image into its constituent fields. Returns either a
// list [type, version, epoch, seq, length, frag_buf, frag_n] or the
// error tag DTLS_ERR_BAD_RECORD. The returned fragment buffer points
// INTO the input buffer (no copy) -- caller must not free buf while
// using frag_buf.
fn dtls_record_parse(buf, n) {
    if n < DTLS_RECORD_HDR_LEN { return DTLS_ERR_BAD_RECORD }
    let type_byte = _dtls_get_u8(buf, 0)
    // Gate on known content types. Reject unknowns up front (a defensive
    // parser stance per RFC 6347 4.1.2.7 -- the alert behaviour at
    // runtime is a separate layer; here we just reject the bytes).
    if type_byte != DTLS_CT_CCS {
        if type_byte != DTLS_CT_ALERT {
            if type_byte != DTLS_CT_HANDSHAKE {
                if type_byte != DTLS_CT_APPLICATION_DATA {
                    return DTLS_ERR_BAD_RECORD
                }
            }
        }
    }
    let version_word = _dtls_get_u16(buf, 1)
    let epoch = _dtls_get_u16(buf, 3)
    let seq = _dtls_get_u48(buf, 5)
    let length = _dtls_get_u16(buf, 11)
    // Buffer sanity: header + length must fit in n.
    if DTLS_RECORD_HDR_LEN + length > n { return DTLS_ERR_BAD_RECORD }
    if length > DTLS_RECORD_MAX_FRAGMENT { return DTLS_ERR_BAD_RECORD }
    let frag_buf = buf + DTLS_RECORD_HDR_LEN
    let out = list_new()
    push(out, type_byte)
    push(out, version_word)
    push(out, epoch)
    push(out, seq)
    push(out, length)
    push(out, frag_buf)
    push(out, length)
    return out
}

// Convenience: emit a record from `state` -- bumps epoch/seq counters.
// Returns the serialized [buf, total] pair on success, 0 on alloc fail.
fn dtls_record_emit(state, type_byte, fragment_buf, frag_n) {
    let seq = _dtls_seq_next(state)
    let epoch = state[DTLS_S_SLOT_EPOCH]
    let rec = dtls_record_serialize(type_byte, DTLS_VERSION_WORD,
                                    epoch, seq, fragment_buf, frag_n)
    if rec == 0 { return 0 }
    state[DTLS_S_SLOT_RECORDS_OUT] = state[DTLS_S_SLOT_RECORDS_OUT] + 1
    return rec
}

// Convenience: parse an inbound record AND bump the inbound counter.
fn dtls_record_recv(state, buf, n) {
    let r = dtls_record_parse(buf, n)
    if r == DTLS_ERR_BAD_RECORD { return r }
    state[DTLS_S_SLOT_RECORDS_IN] = state[DTLS_S_SLOT_RECORDS_IN] + 1
    return r
}

// ============================================================================
//                  Handshake envelope serialize / parse
// ============================================================================
//
// RFC 6347 section 4.2.2:
//
//   struct {
//     HandshakeType msg_type;        // 1 byte
//     uint24 length;                 // 3 bytes -- TOTAL body length
//     uint16 message_seq;            // 2 bytes -- per-message counter
//     uint24 fragment_offset;        // 3 bytes -- offset into body
//     uint24 fragment_length;        // 3 bytes -- this fragment's length
//     opaque body[fragment_length];  // fragment bytes
//   } Handshake;
//
// For R29B we ship ONLY the unfragmented happy path: fragment_offset=0,
// fragment_length=length. R29B.2 will add reassembly across fragments.
// `length` is the total handshake-message body length (i.e. the
// post-fragmentation pre-fragmentation logical body length).

fn dtls_handshake_serialize(msg_type, msg_seq, body_buf, body_n) {
    if body_n < 0 { return 0 }
    let total = DTLS_HS_HDR_LEN + body_n
    let out = alloc(total + 1)
    _dtls_put_u8(out, 0, msg_type)
    _dtls_put_u24(out, 1, body_n)              // length
    _dtls_put_u16(out, 4, msg_seq)
    _dtls_put_u24(out, 6, 0)                   // fragment_offset
    _dtls_put_u24(out, 9, body_n)              // fragment_length
    if body_n > 0 {
        _dtls_copy_bytes(out, DTLS_HS_HDR_LEN, body_buf, 0, body_n)
    }
    store8(out + total, 0)
    let result = list_new()
    push(result, out)
    push(result, total)
    return result
}

fn dtls_handshake_parse(buf, n) {
    if n < DTLS_HS_HDR_LEN { return DTLS_ERR_BAD_HS }
    let msg_type = _dtls_get_u8(buf, 0)
    let length = _dtls_get_u24(buf, 1)
    let msg_seq = _dtls_get_u16(buf, 4)
    let frag_off = _dtls_get_u24(buf, 6)
    let frag_len = _dtls_get_u24(buf, 9)
    // For the R29B skeleton, frag_off==0 and frag_len==length is the
    // only well-formed unfragmented case.
    if frag_off != 0 { return DTLS_ERR_BAD_HS }
    if frag_len != length { return DTLS_ERR_BAD_HS }
    if DTLS_HS_HDR_LEN + frag_len > n { return DTLS_ERR_BAD_HS }
    let body_buf = buf + DTLS_HS_HDR_LEN
    let out = list_new()
    push(out, msg_type)
    push(out, length)
    push(out, msg_seq)
    push(out, frag_off)
    push(out, frag_len)
    push(out, body_buf)
    push(out, frag_len)
    return out
}

// ============================================================================
//                         ClientHello body builder
// ============================================================================
//
// RFC 5246 section 7.4.1.2:
//
//   struct {
//     ProtocolVersion client_version;        // 2 bytes
//     Random random;                          // 32 bytes (4B time + 28B rand)
//     SessionID session_id<0..32>;            // 1B len + bytes
//     opaque cookie<0..2^8-1>;                // (DTLS only, RFC 6347 4.2.2)
//     CipherSuite cipher_suites<2..2^16-2>;   // 2B len + 2B per suite
//     CompressionMethod compression_methods<1..2^8-1>;  // 1B len + 1B per
//     Extension extensions<0..2^16-1>;        // optional
//   } ClientHello;
//
// R29B emits the MINIMUM viable ClientHello: empty session_id, empty
// cookie (server will reply with HelloVerifyRequest if cookie required,
// per RFC 6347 4.2.1 -- the cookie response is R29B.2), one cipher
// suite (0xC02B), one compression method (null=0), no extensions.
//
// The Random is a 32-byte buffer of zero bytes in this skeleton; a real
// build would fill it with a secure_random pull. We comment the slot
// clearly so future agents see it; the skeleton's purpose is byte-
// layout correctness, not unpredictability.

// Phase O R2 (ADR-0095): build the 9-byte `use_srtp` extension wire
// bytes for a single-profile offer. The RFC 5764 §4.1.1 shape is:
//
//   uint16 extension_type       = 14
//   uint16 extension_length     = 5      -- bytes that follow
//   uint16 profile_list_length  = 2      -- bytes in SRTPProtectionProfiles<>
//   uint16 SRTPProtectionProfile = profile_id
//   uint8  srtp_mki_length      = 0      -- MKI is empty in R2
//   opaque srtp_mki[0]                    -- zero bytes
//
// Total on the wire is 9 bytes. We emit this compact form because R2's
// use case is "advertise one preferred profile"; future rounds that
// want to offer several profiles will replace this helper with a
// list-taking variant. Returns [buf, 9].
fn _dtls_build_use_srtp_ext(profile) {
    let n = 9
    let buf = alloc(n + 1)
    _dtls_put_u16(buf, 0, DTLS_EXT_USE_SRTP)  // extension_type = 14
    _dtls_put_u16(buf, 2, 5)                  // extension_length = 5
    _dtls_put_u16(buf, 4, 2)                  // SRTPProtectionProfiles<> length
    _dtls_put_u16(buf, 6, profile)            // one 2-byte profile ID
    _dtls_put_u8(buf, 8, 0)                   // srtp_mki<> length = 0
    store8(buf + n, 0)
    let out = list_new()
    push(out, buf)
    push(out, n)
    return out
}

// R2 ClientHello body builder. Takes `state` so it can inspect
// DTLS_S_SLOT_SRTP_OFFER; when non-zero, splices a `use_srtp` extension
// (RFC 5764 §4.1) into the extensions block. When zero, the wire bytes
// match the pre-R2 shape (no extensions block appended) so existing
// wire-byte tests remain byte-identical.
//
// Pre-R2 the extensions block was documented as "deferred to R29B.2";
// R2 lands the minimal single-extension variant. The extensions
// framework here is intentionally small: a 2-byte length prefix
// followed by one 9-byte extension. Future rounds that add more
// extensions (SNI, supported_groups, signature_algorithms, ...) grow
// the block by appending inside the same length envelope.
fn _dtls_build_client_hello_body(state) {
    let ext_profile = state[DTLS_S_SLOT_SRTP_OFFER]
    let ext_pair = 0
    let ext_buf = 0
    let ext_n = 0
    let ext_block_n = 0
    if ext_profile != 0 {
        ext_pair = _dtls_build_use_srtp_ext(ext_profile)
        ext_buf = ext_pair[0]
        ext_n = ext_pair[1]
        // extensions block = 2B length prefix + concatenated ext bytes
        ext_block_n = 2 + ext_n
    }
    // Phase P R2 (ADR-0098): populate the 32-byte Random from
    // secure_random(32). On entropy-unavailable (test harness), fall back
    // to the test-mode override slot -- deterministic bytes for wire-byte
    // pins. Write the SAME bytes to both the wire body AND
    // DTLS_S_SLOT_CLIENT_RANDOM so `dtls_ecdhe_derive` (which reads slot
    // 17) sees exactly what went on the wire.
    let cr_buf = alloc(33)
    let cr_got = secure_random(cr_buf, 32)
    if cr_got != 32 {
        let ov = state[DTLS_S_SLOT_CLIENT_RANDOM_OVERRIDE]
        if ov == 0 {
            // Neither path available -- zero-fill (pre-R2 skeleton
            // behavior). A caller that requires real randomness on a
            // no-entropy platform can populate the override slot before
            // calling; the zero-fill fallback keeps the function total.
            let z = 0
            while z < 32 { store8(cr_buf + z, 0); z = z + 1 }
        } else {
            let m = 0
            while m < 32 { store8(cr_buf + m, load8(ov + m)); m = m + 1 }
        }
    }
    store8(cr_buf + 32, 0)
    state[DTLS_S_SLOT_CLIENT_RANDOM] = cr_buf
    // 2 (ver) + 32 (random) + 1 (sid len=0) + 1 (cookie len=0) +
    // 2 (suites len) + 2 (one suite) + 1 (compr len=1) + 1 (null compr) = 42
    // + ext_block_n (0 when no offer; 2 + 9 = 11 when use_srtp set)
    let body_n = 42 + ext_block_n
    let body = alloc(body_n + 1)
    let off = 0
    _dtls_put_u16(body, off, DTLS_VERSION_WORD); off = off + 2
    // Copy the 32B client_random into the wire body.
    let i = 0
    while i < 32 {
        store8(body + off + i, load8(cr_buf + i))
        i = i + 1
    }
    off = off + 32
    _dtls_put_u8(body, off, 0); off = off + 1           // session_id length = 0
    _dtls_put_u8(body, off, 0); off = off + 1           // cookie length = 0
    _dtls_put_u16(body, off, 2); off = off + 2          // cipher_suites length (bytes)
    _dtls_put_u16(body, off, DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256)
    off = off + 2
    _dtls_put_u8(body, off, 1); off = off + 1           // compression methods length
    _dtls_put_u8(body, off, 0); off = off + 1           // null compression
    if ext_block_n != 0 {
        // extensions<0..2^16-1>: 2-byte length prefix followed by
        // concatenated extension bytes. R2 emits exactly one extension
        // (use_srtp) so the length is ext_n (=9).
        _dtls_put_u16(body, off, ext_n); off = off + 2
        let j = 0
        while j < ext_n {
            store8(body + off + j, load8(ext_buf + j))
            j = j + 1
        }
        off = off + ext_n
    }
    store8(body + body_n, 0)
    let result = list_new()
    push(result, body)
    push(result, body_n)
    return result
}

// ============================================================================
//         Phase P R1 (ADR-0097) -- server-side handshake flight
// ============================================================================
//
// The five new body builders and the ClientHello parser below stitch onto
// the R29B handshake header serialize/parse pair plus R2's ClientHello
// body builder. Together they let a server driver take a ClientHello record
// off the wire, decide the negotiation, and emit the flight-1 quartet
// (ServerHello / Certificate / ServerKeyExchange / ServerHelloDone) back
// through the same _gds_send_record path R3 already ships.
//
// The transcript accumulator (below the parsers) is required for R2's
// Finished MAC, but is populated on both send AND recv from R1 so R2 can
// finalize at its two call sites without back-patching the buffer.

// ----------------------------------------------------------------------------
// ClientHello parser (RFC 5246 §7.4.1.2 + RFC 6347 §4.2.2 cookie field)
// ----------------------------------------------------------------------------
//
// Returns a fixed-shape 8-element list on success:
//   [1, version_u16, random_buf_32B, sid_buf, sid_n_or_0,
//    cookie_buf, cookie_n_or_0, suites_list, compr_list, ext_block_or_0]
//
// Actually returns as: [ok, version, random_32b_buf, sid_pair,
//   cookie_pair, suites_list, compr_list, ext_pair_or_0] where each _pair
//   is a 2-element [buf, n] (0 when the sub-field is empty on the wire).
//
// On any malformed-length rejection (a length prefix that exceeds the
// remaining buffer, or a suites list that does NOT contain 0xC02B, or a
// compression list that does NOT contain 0x00) the function returns
// [0, DTLS_ERR_BAD_HS] so a caller can distinguish success from failure
// via the first slot.
fn _dtls_parse_client_hello_body(buf, n) {
    // Minimum body: 2 (version) + 32 (random) + 1 (sid_len) + 1 (cookie_len)
    //             + 2 (suites_len) + 2 (one suite) + 1 (compr_len) + 1 (compr)
    //             = 42 bytes; anything shorter is malformed.
    if n < 42 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let off = 0
    let version = _dtls_get_u16(buf, off); off = off + 2
    // Capture the 32-byte random by copying into a fresh 33-byte buffer
    // (32B + trailing NUL for downstream allocator slack, matching every
    // other buffer in this file).
    let random_buf = alloc(33)
    let i = 0
    while i < 32 {
        store8(random_buf + i, load8(buf + off + i))
        i = i + 1
    }
    store8(random_buf + 32, 0)
    off = off + 32
    // session_id<0..32>
    let sid_len = _dtls_get_u8(buf, off); off = off + 1
    if off + sid_len > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let sid_pair = 0
    if sid_len > 0 {
        let sid_buf = alloc(sid_len + 1)
        let j = 0
        while j < sid_len {
            store8(sid_buf + j, load8(buf + off + j))
            j = j + 1
        }
        store8(sid_buf + sid_len, 0)
        sid_pair = list_new()
        push(sid_pair, sid_buf)
        push(sid_pair, sid_len)
    }
    off = off + sid_len
    // cookie<0..2^8-1> (DTLS-specific per RFC 6347 §4.2.2).
    if off + 1 > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let cookie_len = _dtls_get_u8(buf, off); off = off + 1
    if off + cookie_len > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let cookie_pair = 0
    if cookie_len > 0 {
        let cookie_buf = alloc(cookie_len + 1)
        let k = 0
        while k < cookie_len {
            store8(cookie_buf + k, load8(buf + off + k))
            k = k + 1
        }
        store8(cookie_buf + cookie_len, 0)
        cookie_pair = list_new()
        push(cookie_pair, cookie_buf)
        push(cookie_pair, cookie_len)
    }
    off = off + cookie_len
    // cipher_suites<2..2^16-2>: 2B length in BYTES, then N/2 u16 suite IDs.
    if off + 2 > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let suites_bytes = _dtls_get_u16(buf, off); off = off + 2
    if off + suites_bytes > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    // suites_bytes must be even (each suite is 2 bytes) and non-zero.
    if suites_bytes <= 0 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let suites_list = list_new()
    let saw_xc02b = 0
    let sp = 0
    while sp + 2 <= suites_bytes {
        let suite = _dtls_get_u16(buf, off + sp)
        push(suites_list, suite)
        if suite == DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256 { saw_xc02b = 1 }
        sp = sp + 2
    }
    off = off + suites_bytes
    if saw_xc02b == 0 {
        // Cipher-negotiation gate per RFC 5246 §7.4.1.3: we accept exactly
        // one suite, and the client MUST offer it.
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_NO_CIPHER)
        return bad
    }
    // compression_methods<1..2^8-1>
    if off + 1 > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let compr_len = _dtls_get_u8(buf, off); off = off + 1
    if off + compr_len > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let compr_list = list_new()
    let saw_null = 0
    let cp = 0
    while cp < compr_len {
        let m = _dtls_get_u8(buf, off + cp)
        push(compr_list, m)
        if m == 0 { saw_null = 1 }
        cp = cp + 1
    }
    off = off + compr_len
    if saw_null == 0 {
        // Null compression is required in TLS 1.2 (all others are
        // deprecated). Reject clients that do not offer it.
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    // Optional extensions<0..2^16-1>: 2B length + bytes. Present iff any
    // bytes remain.
    let ext_pair = 0
    if off < n {
        if off + 2 > n {
            let bad = list_new()
            push(bad, 0)
            push(bad, DTLS_ERR_BAD_HS)
            return bad
        }
        let ext_block_len = _dtls_get_u16(buf, off); off = off + 2
        if off + ext_block_len > n {
            let bad = list_new()
            push(bad, 0)
            push(bad, DTLS_ERR_BAD_HS)
            return bad
        }
        let ext_buf = 0
        if ext_block_len > 0 {
            ext_buf = alloc(ext_block_len + 1)
            let e = 0
            while e < ext_block_len {
                store8(ext_buf + e, load8(buf + off + e))
                e = e + 1
            }
            store8(ext_buf + ext_block_len, 0)
        }
        ext_pair = list_new()
        push(ext_pair, ext_buf)
        push(ext_pair, ext_block_len)
        off = off + ext_block_len
    }
    let out = list_new()
    push(out, 1)                       // ok
    push(out, version)                 // u16 protocol version
    push(out, random_buf)              // 32B random buffer
    push(out, sid_pair)                // [buf, n] | 0
    push(out, cookie_pair)             // [buf, n] | 0
    push(out, suites_list)             // list<int>
    push(out, compr_list)              // list<int>
    push(out, ext_pair)                // [buf, ext_block_len] | 0
    return out
}

// Extension-block stub parser (Phase P R1). Validates the outer 2-byte
// length prefix and returns [1, total_ext_len]; refuses if the block
// exceeds the buffer. R3 replaces with a real per-extension walker that
// dispatches into use_srtp / SNI / supported_groups. R1 keeps the caller
// unaware of the extension contents so ServerHello emission can proceed
// without R3 landing first.
fn _dtls_parse_ext_block_stub(buf, n) {
    if n == 0 {
        let ok = list_new()
        push(ok, 1)
        push(ok, 0)
        return ok
    }
    if n < 2 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let total = _dtls_get_u16(buf, 0)
    // 2 (length prefix) + total must fit inside n.
    if 2 + total > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let ok = list_new()
    push(ok, 1)
    push(ok, total)
    return ok
}

// ----------------------------------------------------------------------------
// ServerHello body builder (RFC 5246 §7.4.1.3)
// ----------------------------------------------------------------------------
//
//   ProtocolVersion server_version;             // 2 bytes
//   Random random;                              // 32 bytes
//   SessionID session_id<0..32>;                // 1B len + bytes
//   CipherSuite cipher_suite;                   // 2 bytes
//   CompressionMethod compression_method;       // 1 byte
//   select (extensions_present) { ... }         // optional
//
// R1 emits an empty session_id (server-side resumption is out of scope
// for the sprint), our single cipher suite 0xC02B, and null compression.
// The `use_srtp` extension is echoed iff the state's SRTP_OFFER slot is
// non-zero (i.e. the client offered a profile in its ClientHello and the
// server driver stored the chosen one). The extension block shape is
// identical to R2's ClientHello emission: 2B outer length + concatenated
// 9-byte use_srtp bytes.
fn _dtls_build_server_hello_body(state, negotiated_suite, server_random_32b) {
    let ext_profile = state[DTLS_S_SLOT_SRTP_OFFER]
    let ext_pair = 0
    let ext_buf = 0
    let ext_n = 0
    let ext_block_n = 0
    if ext_profile != 0 {
        ext_pair = _dtls_build_use_srtp_ext(ext_profile)
        ext_buf = ext_pair[0]
        ext_n = ext_pair[1]
        ext_block_n = 2 + ext_n
    }
    // 2 (ver) + 32 (random) + 1 (sid_len=0) + 2 (suite) + 1 (compr=0) = 38
    // + ext_block_n (0 when no extensions; 2 + 9 = 11 when use_srtp echoed)
    let body_n = 38 + ext_block_n
    let body = alloc(body_n + 1)
    let off = 0
    _dtls_put_u16(body, off, DTLS_VERSION_WORD); off = off + 2
    // Copy the 32B server_random verbatim (caller may have generated it
    // via secure_random(32) or lifted it from the test-mode override
    // slot; the wire layout is oblivious to the source).
    let i = 0
    while i < 32 {
        store8(body + off + i, load8(server_random_32b + i))
        i = i + 1
    }
    off = off + 32
    _dtls_put_u8(body, off, 0); off = off + 1           // session_id length = 0
    _dtls_put_u16(body, off, negotiated_suite); off = off + 2
    _dtls_put_u8(body, off, 0); off = off + 1           // null compression
    if ext_block_n != 0 {
        _dtls_put_u16(body, off, ext_n); off = off + 2
        let j = 0
        while j < ext_n {
            store8(body + off + j, load8(ext_buf + j))
            j = j + 1
        }
        off = off + ext_n
    }
    store8(body + body_n, 0)
    let result = list_new()
    push(result, body)
    push(result, body_n)
    return result
}

// ----------------------------------------------------------------------------
// Certificate body builder (RFC 5246 §7.4.2)
// ----------------------------------------------------------------------------
//
//   opaque ASN.1Cert<1..2^24-1>;
//   struct {
//     ASN.1Cert certificate_list<0..2^24-1>;
//   } Certificate;
//
// Layout: 3B total-length prefix, then per cert: 3B cert-length + cert DER.
// `cert_der_list` is a NOVA list of [buf, n] pairs (one per cert in the
// chain, leaf first per §7.4.2). An empty chain yields a 3B header
// carrying zero as the total.
fn _dtls_build_certificate_body(state, cert_der_list) {
    let ncerts = len(cert_der_list)
    let inner_total = 0
    let c = 0
    while c < ncerts {
        let pair = cert_der_list[c]
        inner_total = inner_total + 3 + pair[1]
        c = c + 1
    }
    let body_n = 3 + inner_total
    let body = alloc(body_n + 1)
    _dtls_put_u24(body, 0, inner_total)
    let off = 3
    let ci = 0
    while ci < ncerts {
        let pair = cert_der_list[ci]
        let cbuf = pair[0]
        let cn = pair[1]
        _dtls_put_u24(body, off, cn); off = off + 3
        let i = 0
        while i < cn {
            store8(body + off + i, load8(cbuf + i))
            i = i + 1
        }
        off = off + cn
        ci = ci + 1
    }
    store8(body + body_n, 0)
    let result = list_new()
    push(result, body)
    push(result, body_n)
    return result
}

// ----------------------------------------------------------------------------
// ServerKeyExchange body builder (RFC 4492 §5.4 + RFC 5246 §7.4.3)
// ----------------------------------------------------------------------------
//
// For ECDHE_ECDSA the SKE body carries:
//   ServerECDHParams params:
//     ECCurveType curve_type = named_curve (3)          // 1B
//     NamedCurve  named_curve_id                        // 2B (e.g. 0x0017 secp256r1)
//     opaque      point<1..2^8-1>                       // 1B len + point bytes
//   SignatureAndHashAlgorithm signature_algorithm       // 2B (hash + sig; 0x04 0x03 = SHA256+ECDSA)
//   opaque signature<0..2^16-1>                         // 2B len + DER-encoded ECDSA sig
//
// The signature is over the concatenation
//     client_random (32B) || server_random (32B) || server_ECDH_params
// per RFC 5246 §7.4.3, hashed with SHA-256, signed under the server's
// long-term ECDSA-P-256 private key. The DER encoding of the ECDSA sig
// is a SEQUENCE of two INTEGERs (r and s), per RFC 4492 §5.4 (which
// defers to X9.62). We hand-encode DER inline because the tree ships no
// DER encoder today (x509.nova parses only).
//
// `pub_point_65b` is the SEC1 uncompressed encoding of the server's
// EPHEMERAL ECDH public key (0x04 || X || Y). `signer_priv_bn` is the
// server's long-term ECDSA private scalar (bn256) that signs the params.
fn _dtls_build_ske_body(state, ec_curve_id, pub_point_65b, signer_priv_bn) {
    // 1. Assemble the ServerECDHParams wire bytes.
    let params_n = 1 + 2 + 1 + 65
    let params_buf = alloc(params_n + 1)
    _dtls_put_u8(params_buf, 0, 3)                  // curve_type = named_curve
    _dtls_put_u16(params_buf, 1, ec_curve_id)       // NamedCurve (0x0017 = secp256r1)
    _dtls_put_u8(params_buf, 3, 65)                 // point<1..255> length
    let i = 0
    while i < 65 {
        store8(params_buf + 4 + i, load8(pub_point_65b + i))
        i = i + 1
    }
    store8(params_buf + params_n, 0)

    // 2. Build the signed-message = client_random || server_random || params.
    let cr = state[DTLS_S_SLOT_CLIENT_RANDOM]
    let sr = state[DTLS_S_SLOT_SERVER_RANDOM]
    let signed_n = 32 + 32 + params_n
    let signed_buf = alloc(signed_n + 1)
    let j = 0
    while j < 32 {
        store8(signed_buf + j, load8(cr + j))
        store8(signed_buf + 32 + j, load8(sr + j))
        j = j + 1
    }
    let k = 0
    while k < params_n {
        store8(signed_buf + 64 + k, load8(params_buf + k))
        k = k + 1
    }
    store8(signed_buf + signed_n, 0)

    // 3. SHA-256 + ECDSA-P-256 sign. Produces [r_bn, s_bn].
    let sig_pair = _dtls_ecdsa_p256_sign(signed_buf, signed_n, signer_priv_bn)
    if sig_pair == 0 { return 0 }

    // 4. DER-encode the signature: SEQUENCE { INTEGER r, INTEGER s }.
    let der_pair = _dtls_der_encode_ecdsa_sig(sig_pair[0], sig_pair[1])
    if der_pair == 0 { return 0 }
    let der_buf = der_pair[0]
    let der_n = der_pair[1]

    // 5. Assemble the SKE body: params || sig_alg(2B) || sig_len(2B) || DER.
    let body_n = params_n + 2 + 2 + der_n
    let body = alloc(body_n + 1)
    let off = 0
    let p = 0
    while p < params_n {
        store8(body + off + p, load8(params_buf + p))
        p = p + 1
    }
    off = off + params_n
    // SignatureAndHashAlgorithm = 0x04 (SHA-256) 0x03 (ECDSA)  per RFC 5246 §7.4.1.4.1.
    _dtls_put_u8(body, off, 4); off = off + 1
    _dtls_put_u8(body, off, 3); off = off + 1
    _dtls_put_u16(body, off, der_n); off = off + 2
    let d = 0
    while d < der_n {
        store8(body + off + d, load8(der_buf + d))
        d = d + 1
    }
    off = off + der_n
    store8(body + body_n, 0)
    let result = list_new()
    push(result, body)
    push(result, body_n)
    return result
}

// ----------------------------------------------------------------------------
// ServerHelloDone body builder (RFC 5246 §7.4.5)
// ----------------------------------------------------------------------------
//
// The body is empty per spec. We allocate a 1-byte trailing-NUL buffer
// so the buffer pointer is non-zero (some caller code interprets a raw
// 0 as "no body"; a valid empty body is a distinct case).
fn _dtls_build_server_hello_done_body() {
    let body = alloc(1)
    store8(body, 0)
    let result = list_new()
    push(result, body)
    push(result, 0)
    return result
}

// ----------------------------------------------------------------------------
// ECDSA-P-256 sign (FIPS 186-4 §6.3) -- helper used by _dtls_build_ske_body.
// ----------------------------------------------------------------------------
//
// The tree ships ecdsa_p256_verify_bn but NOT a sign entry (the verify
// path was all the DTLS server-cert-verify path needed, and the R31B
// signer key was ed25519). Phase P R1 needs sign so the ServerKeyExchange
// message can carry a real ECDSA signature over the ECDH params.
//
// Sign recipe (FIPS 186-4 §6.3):
//   1. e = truncate_left(SHA-256(msg), bitlen(n)); for P-256 with SHA-256
//      the digest is 256 bits and n is 256 bits, so no truncation.
//   2. Draw k in [1, n-1]. R1 uses _p256_random_scalar (secure_random +
//      LCG fallback per the existing helper); a hardening followup would
//      switch to RFC 6979 deterministic-k.
//   3. (x1, _) = k * G ; r = x1 mod n. If r == 0, redraw k (very rare).
//   4. s = k^-1 * (e + r * priv) mod n. If s == 0, redraw k.
//   5. Return (r, s) as bn256 scalars.
//
// Returns [r_bn, s_bn] on success, 0 on the pathological zero-r/zero-s
// redraw exhaustion path (bounded at 8 retries; effectively unreachable
// with a working entropy source).
fn _dtls_ecdsa_p256_sign(msg_buf, msg_n, priv_bn) {
    let digest = sha256_oneshot(msg_buf, msg_n)
    let e = _p256_bytes_to_bn(digest, 0)
    let n = p256_curve_n()
    if bn256_cmp(e, n) >= 0 { e = bn256_mod(e, n) }
    let attempts = 0
    while attempts < 8 {
        let k = _p256_random_scalar()
        let G = p256_base_point()
        let R = p256_scalar_mult(k, G[0], G[1])
        if R != 0 {
            let x1 = R[0]
            let r = x1
            if bn256_cmp(r, n) >= 0 { r = bn256_mod(r, n) }
            if bn256_zero(r) == 0 {
                // s = k^-1 * (e + r * priv) mod n
                let k_inv = _ecdsa_n_inv(k)
                if bn256_zero(k_inv) == 0 {
                    let rp = bn256_modmul(r, priv_bn, n)
                    let sum = bn256_add(e, rp)
                    if bn256_cmp(sum, n) >= 0 { sum = bn256_mod(sum, n) }
                    let s = bn256_modmul(k_inv, sum, n)
                    if bn256_zero(s) == 0 {
                        let out = list_new()
                        push(out, r)
                        push(out, s)
                        return out
                    }
                }
            }
        }
        attempts = attempts + 1
    }
    return 0
}

// ----------------------------------------------------------------------------
// DER encoding of an ECDSA signature (RFC 3279 §2.2.3 / X9.62).
// ----------------------------------------------------------------------------
//
//   Ecdsa-Sig-Value ::= SEQUENCE { r INTEGER, s INTEGER }
//
// Each INTEGER is encoded as: 0x02 || length || bytes, where bytes are
// the minimal big-endian representation with a leading 0x00 prefixed
// whenever the high bit of the first byte is set (so the integer stays
// positive under ASN.1's two's-complement interpretation).
//
// Returns [buf, n]. The output is at most 2 (SEQUENCE hdr) + 2 * (2 + 33)
// = 72 bytes for two 32-byte scalars, which fits inside the SKE body's
// 2-byte signature-length envelope.
fn _dtls_der_encode_ecdsa_sig(r_bn, s_bn) {
    let r_int = _dtls_der_encode_bn_as_integer(r_bn)
    if r_int == 0 { return 0 }
    let s_int = _dtls_der_encode_bn_as_integer(s_bn)
    if s_int == 0 { return 0 }
    let r_buf = r_int[0]
    let r_n = r_int[1]
    let s_buf = s_int[0]
    let s_n = s_int[1]
    let inner_n = r_n + s_n
    // SEQUENCE (0x30) followed by 1B length (both r and s fit in the
    // short-form length -- inner_n <= 70 < 128, so no long-form needed).
    let body_n = 2 + inner_n
    let body = alloc(body_n + 1)
    _dtls_put_u8(body, 0, 48)          // 0x30 SEQUENCE
    _dtls_put_u8(body, 1, inner_n)
    let i = 0
    while i < r_n {
        store8(body + 2 + i, load8(r_buf + i))
        i = i + 1
    }
    let j = 0
    while j < s_n {
        store8(body + 2 + r_n + j, load8(s_buf + j))
        j = j + 1
    }
    store8(body + body_n, 0)
    let out = list_new()
    push(out, body)
    push(out, body_n)
    return out
}

// Encode one bn256 as an ASN.1 INTEGER. Big-endian 32B representation of
// the scalar, strip leading zero bytes, then prepend a single 0x00 iff
// the top bit of the remaining first byte is set. Returns [buf, n] where
// buf holds "0x02 || len || bytes".
fn _dtls_der_encode_bn_as_integer(bn) {
    let raw = alloc(33)
    _p256_bn_to_bytes_be(bn, raw, 0)
    store8(raw + 32, 0)
    // Locate the first non-zero byte via a done-flag pattern (NOVA has
    // no break). Fall through to first_nz = 31 for the all-zeros case
    // (ASN.1 encodes zero as INTEGER 0x02 0x01 0x00, one content byte).
    let first_nz = 31
    let done = 0
    let idx = 0
    while idx < 32 {
        if done == 0 {
            if load8(raw + idx) != 0 {
                first_nz = idx
                done = 1
            }
        }
        idx = idx + 1
    }
    let content_n = 32 - first_nz
    if content_n < 1 { content_n = 1 }
    // Decide whether to prepend 0x00 (top bit set => negative under ASN.1).
    let top = load8(raw + first_nz)
    let prepend = 0
    if int_and(top, 128) != 0 { prepend = 1 }
    let val_n = content_n + prepend
    // "0x02 len value" -- len fits in one byte (val_n <= 33).
    let total = 2 + val_n
    let out_buf = alloc(total + 1)
    _dtls_put_u8(out_buf, 0, 2)           // INTEGER tag
    _dtls_put_u8(out_buf, 1, val_n)
    let off = 2
    if prepend == 1 {
        _dtls_put_u8(out_buf, off, 0)
        off = off + 1
    }
    let c = 0
    while c < content_n {
        store8(out_buf + off + c, load8(raw + first_nz + c))
        c = c + 1
    }
    store8(out_buf + total, 0)
    let out = list_new()
    push(out, out_buf)
    push(out, total)
    return out
}

// ----------------------------------------------------------------------------
// Transcript-hash accumulator (RFC 5246 §7.4.9).
// ----------------------------------------------------------------------------
//
// Every handshake message (12B HS header + body) is fed into the
// accumulator on both SEND and RECV. The Finished MAC in R2 will run
//     PRF(master_secret, "client finished" | "server finished",
//         SHA-256(transcript), 12)
// where SHA-256(transcript) is dtls_transcript_finalize's return value.
//
// Representation: growing byte buffer (see rationale on the slot
// declaration above). Init allocates a small buffer; absorb grows it via
// realloc-by-copy when the incoming message would overflow the current
// capacity.

let _DTLS_TRANSCRIPT_INIT_CAP = 512

fn dtls_transcript_init(state) {
    let cap = _DTLS_TRANSCRIPT_INIT_CAP
    let buf = alloc(cap + 1)
    store8(buf + cap, 0)
    state[DTLS_S_SLOT_TRANSCRIPT_CTX] = buf
    state[DTLS_S_SLOT_TRANSCRIPT_N] = 0
    return 1
}

// Absorb `n` bytes at `hs_msg_bytes` into the transcript buffer. Grows
// the buffer geometrically (doubling) when the incoming message would
// overflow current capacity. Safe to call before dtls_transcript_init:
// silently init-on-first-use so the caller can drive absorbs without a
// pre-flight.
fn dtls_transcript_absorb(state, hs_msg_bytes, n) {
    if n <= 0 { return 1 }
    if state[DTLS_S_SLOT_TRANSCRIPT_CTX] == 0 {
        dtls_transcript_init(state)
    }
    let buf = state[DTLS_S_SLOT_TRANSCRIPT_CTX]
    let cur_n = state[DTLS_S_SLOT_TRANSCRIPT_N]
    // Capacity is the buf's alloc size minus 1 (trailing NUL). We track it
    // implicitly by growing whenever cur_n + n > current allocation. We
    // encode "current cap" as the size we allocated last, which the state
    // does not carry -- instead we grow to a size >= cur_n + n rounded up
    // to a doubling. Reset by rewriting the buffer pointer.
    let need = cur_n + n
    let new_cap = _DTLS_TRANSCRIPT_INIT_CAP
    while new_cap < need {
        new_cap = new_cap + new_cap
    }
    // Always grow-and-copy for R1 (allocating even when new_cap equals
    // the previous cap is wasteful but keeps the state minimal -- no
    // separate "current capacity" slot; the cost is a copy per absorb,
    // which is proportional to transcript size and dominated by the
    // handshake's SHA-256 finalize work anyway).
    let new_buf = alloc(new_cap + 1)
    let i = 0
    while i < cur_n {
        store8(new_buf + i, load8(buf + i))
        i = i + 1
    }
    let j = 0
    while j < n {
        store8(new_buf + cur_n + j, load8(hs_msg_bytes + j))
        j = j + 1
    }
    store8(new_buf + new_cap, 0)
    state[DTLS_S_SLOT_TRANSCRIPT_CTX] = new_buf
    state[DTLS_S_SLOT_TRANSCRIPT_N] = need
    return 1
}

// Return the 33-byte (32B digest + trailing NUL) SHA-256 of the current
// transcript. NON-DESTRUCTIVE: leaves the accumulator intact so the R2
// server-Finished MAC can be computed AFTER the client-Finished MAC has
// been finalized. Returns 0 iff the accumulator has never been
// initialized (a state bug the caller can distinguish from a valid
// empty transcript by checking state[DTLS_S_SLOT_TRANSCRIPT_CTX] first).
fn dtls_transcript_finalize(state) {
    let buf = state[DTLS_S_SLOT_TRANSCRIPT_CTX]
    if buf == 0 { return 0 }
    let n = state[DTLS_S_SLOT_TRANSCRIPT_N]
    return sha256_oneshot(buf, n)
}

// Read-only accessor -- exposed so tests can inspect the buffer without
// poking at slot indices.
fn dtls_transcript_len(state) {
    return state[DTLS_S_SLOT_TRANSCRIPT_N]
}

// ============================================================================
//         Phase P R2 (ADR-0098) -- client-side handshake flight parsers
// ============================================================================
//
// Mirror the R1 server-side parser shape: return a fixed-shape list whose
// first slot is `1` on accept and `0` on refuse (with the second slot
// carrying the diagnostic tag). No exceptions, no negative sentinels --
// callers discriminate on the first slot.

// ----------------------------------------------------------------------------
// ServerHello parser (RFC 5246 §7.4.1.3)
//
// Layout:
//   2B version || 32B random || 1B sid_len + sid || 2B suite || 1B compr ||
//   optional 2B ext_block_len + ext bytes.
//
// Returns [1, version_u16, random_buf_32B, sid_pair, negotiated_suite_u16,
//          compr_u8, ext_pair_or_0]. On refuse: [0, DTLS_ERR_*].
//
// Refuses:
//   * body shorter than 38 bytes (the minimum: 2+32+1+2+1 = 38).
//   * negotiated_suite != 0xC02B (single-suite policy).
//   * compression method != 0 (null compression required).
//   * length prefixes that overflow the buffer.
// ----------------------------------------------------------------------------
fn _dtls_parse_server_hello_body(buf, n) {
    if n < 38 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let off = 0
    let version = _dtls_get_u16(buf, off); off = off + 2
    let random_buf = alloc(33)
    let i = 0
    while i < 32 {
        store8(random_buf + i, load8(buf + off + i))
        i = i + 1
    }
    store8(random_buf + 32, 0)
    off = off + 32
    let sid_len = _dtls_get_u8(buf, off); off = off + 1
    if off + sid_len > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let sid_pair = 0
    if sid_len > 0 {
        let sid_buf = alloc(sid_len + 1)
        let j = 0
        while j < sid_len {
            store8(sid_buf + j, load8(buf + off + j))
            j = j + 1
        }
        store8(sid_buf + sid_len, 0)
        sid_pair = list_new()
        push(sid_pair, sid_buf)
        push(sid_pair, sid_len)
    }
    off = off + sid_len
    if off + 3 > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let suite = _dtls_get_u16(buf, off); off = off + 2
    if suite != DTLS_CIPHER_ECDHE_ECDSA_AES128_GCM_SHA256 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_NO_CIPHER)
        return bad
    }
    let compr = _dtls_get_u8(buf, off); off = off + 1
    if compr != 0 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let ext_pair = 0
    if off < n {
        if off + 2 > n {
            let bad = list_new()
            push(bad, 0)
            push(bad, DTLS_ERR_BAD_HS)
            return bad
        }
        let ext_block_len = _dtls_get_u16(buf, off); off = off + 2
        if off + ext_block_len > n {
            let bad = list_new()
            push(bad, 0)
            push(bad, DTLS_ERR_BAD_HS)
            return bad
        }
        let ext_buf = 0
        if ext_block_len > 0 {
            ext_buf = alloc(ext_block_len + 1)
            let e = 0
            while e < ext_block_len {
                store8(ext_buf + e, load8(buf + off + e))
                e = e + 1
            }
            store8(ext_buf + ext_block_len, 0)
        }
        ext_pair = list_new()
        push(ext_pair, ext_buf)
        push(ext_pair, ext_block_len)
        off = off + ext_block_len
    }
    let out = list_new()
    push(out, 1)
    push(out, version)
    push(out, random_buf)
    push(out, sid_pair)
    push(out, suite)
    push(out, compr)
    push(out, ext_pair)
    return out
}

// ----------------------------------------------------------------------------
// Certificate parser (RFC 5246 §7.4.2)
//
// Layout: 3B total inner length || per cert: 3B len + cert DER bytes.
//
// Returns [1, cert_der_list] where cert_der_list is a NOVA list of
// [buf, n] pairs (leaf first per §7.4.2). On refuse: [0, DTLS_ERR_BAD_HS].
// ----------------------------------------------------------------------------
fn _dtls_parse_certificate_body(buf, n) {
    if n < 3 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let total = _dtls_get_u24(buf, 0)
    if 3 + total > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let cert_list = list_new()
    let off = 3
    let end = 3 + total
    while off < end {
        if off + 3 > end {
            let bad = list_new()
            push(bad, 0)
            push(bad, DTLS_ERR_BAD_HS)
            return bad
        }
        let cert_n = _dtls_get_u24(buf, off); off = off + 3
        if off + cert_n > end {
            let bad = list_new()
            push(bad, 0)
            push(bad, DTLS_ERR_BAD_HS)
            return bad
        }
        let cbuf = alloc(cert_n + 1)
        let i = 0
        while i < cert_n {
            store8(cbuf + i, load8(buf + off + i))
            i = i + 1
        }
        store8(cbuf + cert_n, 0)
        let entry = list_new()
        push(entry, cbuf)
        push(entry, cert_n)
        push(cert_list, entry)
        off = off + cert_n
    }
    let out = list_new()
    push(out, 1)
    push(out, cert_list)
    return out
}

// ----------------------------------------------------------------------------
// ServerKeyExchange parser (RFC 4492 §5.4 + RFC 5246 §7.4.3)
//
// Layout:
//   1B curve_type=3 || 2B curve_id || 1B point_len=65 || 65B point ||
//   2B sig_alg || 2B sig_len || N sig bytes (DER).
//
// Returns [1, curve_type, curve_id, pub_point_65B, sig_alg,
//          sig_pair (=[buf, n])] on accept. Refuses on wrong curve_type
// (must be 3 = named_curve), wrong curve_id (must be 23 = secp256r1),
// wrong point_len (must be 65), or any length overflow. Signature bytes
// are returned raw; DER decoding happens at verify time via
// _dtls_der_decode_ecdsa_sig.
// ----------------------------------------------------------------------------
fn _dtls_parse_ske_body(buf, n) {
    if n < 4 + 65 + 4 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let curve_type = _dtls_get_u8(buf, 0)
    if curve_type != 3 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let curve_id = _dtls_get_u16(buf, 1)
    if curve_id != 23 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let point_len = _dtls_get_u8(buf, 3)
    if point_len != 65 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let pub_point = alloc(66)
    let i = 0
    while i < 65 {
        store8(pub_point + i, load8(buf + 4 + i))
        i = i + 1
    }
    store8(pub_point + 65, 0)
    let off = 4 + 65
    if off + 4 > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let sig_alg = _dtls_get_u16(buf, off); off = off + 2
    let sig_len = _dtls_get_u16(buf, off); off = off + 2
    if off + sig_len > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let sig_buf = alloc(sig_len + 1)
    let j = 0
    while j < sig_len {
        store8(sig_buf + j, load8(buf + off + j))
        j = j + 1
    }
    store8(sig_buf + sig_len, 0)
    let sig_pair = list_new()
    push(sig_pair, sig_buf)
    push(sig_pair, sig_len)
    let out = list_new()
    push(out, 1)
    push(out, curve_type)
    push(out, curve_id)
    push(out, pub_point)
    push(out, sig_alg)
    push(out, sig_pair)
    return out
}

// ----------------------------------------------------------------------------
// ServerHelloDone parser (RFC 5246 §7.4.5)
//
// Body MUST be empty (0 bytes). Returns [1] on accept, [0, DTLS_ERR_BAD_HS]
// on any non-empty body.
// ----------------------------------------------------------------------------
fn _dtls_parse_server_hello_done_body(buf, n) {
    if n != 0 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let out = list_new()
    push(out, 1)
    return out
}

// ----------------------------------------------------------------------------
// ClientKeyExchange parser (RFC 4492 §5.7)
//
// For the ECDHE_ECDSA suite the body is:
//   1B point_len=65 || 65B uncompressed EC point.
//
// Returns [1, client_pub_point_65B] on accept, [0, DTLS_ERR_BAD_HS] on
// any length mismatch. This is the mirror of _dtls_build_client_key_
// exchange_body.
// ----------------------------------------------------------------------------
fn _dtls_parse_client_key_exchange_body(buf, n) {
    if n < 1 + 65 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let point_len = _dtls_get_u8(buf, 0)
    if point_len != 65 {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    if 1 + 65 > n {
        let bad = list_new()
        push(bad, 0)
        push(bad, DTLS_ERR_BAD_HS)
        return bad
    }
    let pub_point = alloc(66)
    let i = 0
    while i < 65 {
        store8(pub_point + i, load8(buf + 1 + i))
        i = i + 1
    }
    store8(pub_point + 65, 0)
    let out = list_new()
    push(out, 1)
    push(out, pub_point)
    return out
}

// ============================================================================
//         Phase P R2 (ADR-0098) -- client-side handshake flight builders
// ============================================================================

// ----------------------------------------------------------------------------
// ClientKeyExchange body builder (RFC 4492 §5.7 -- ECDHE variant)
//
// Layout: 1B point_len=65 || 65B uncompressed SEC1 point.
// Returns [buf, 66].
// ----------------------------------------------------------------------------
fn _dtls_build_client_key_exchange_body(state, client_pub_point_65b) {
    let body_n = 1 + 65
    let body = alloc(body_n + 1)
    _dtls_put_u8(body, 0, 65)
    let i = 0
    while i < 65 {
        store8(body + 1 + i, load8(client_pub_point_65b + i))
        i = i + 1
    }
    store8(body + body_n, 0)
    let out = list_new()
    push(out, body)
    push(out, body_n)
    return out
}

// ----------------------------------------------------------------------------
// ChangeCipherSpec record builder (RFC 5246 §7.1)
//
// CCS is NOT a handshake message. It rides in its OWN record with
// content_type=20 and a 1-byte body containing the constant value 0x01.
//
// Returns [record_buf, record_n] ready for `_gds_send_record` (i.e.
// includes the 13-byte DTLS record header). It is emitted with the
// CURRENT epoch + record_seq (pre-advance); the caller advances the
// epoch AFTER sending, which is what the CCS semantically signals to
// the peer ("everything from now on runs under the new keys").
// ----------------------------------------------------------------------------
fn _dtls_build_change_cipher_spec_record(state) {
    let body = alloc(2)
    store8(body + 0, 1)
    store8(body + 1, 0)
    // Emit at the CURRENT epoch (pre-CCS). dtls_record_emit bumps
    // rec_seq + records_out counters.
    let rec = dtls_record_emit(state, DTLS_CT_CCS, body, 1)
    return rec
}

// ----------------------------------------------------------------------------
// Finished body builder (RFC 5246 §7.4.9)
//
// verify_data = PRF(master_secret, label, SHA-256(handshake_messages), 12)
// where label is "client finished" if is_client else "server finished".
//
// The transcript-hash snapshot is taken via `dtls_transcript_finalize`
// (non-destructive). Returns [body_buf, 12] on success, 0 iff
// master_secret is not yet populated (a state bug).
//
// NOTE: this DOES NOT absorb the Finished message into the transcript.
// The caller is responsible for absorbing AFTER computing verify_data so
// the transcript-snapshot moment matches RFC 5246 §7.4.9's contract
// (Finished MAC does not cover the Finished message itself, but the
// peer's Finished MAC DOES cover ours). See _gds_client_flight for the
// full ordering.
// ----------------------------------------------------------------------------
fn _dtls_build_finished_body(state, is_client) {
    let ms = state[DTLS_S_SLOT_MASTER_SECRET]
    if ms == 0 { return 0 }
    let transcript_hash = dtls_transcript_finalize(state)
    if transcript_hash == 0 { return 0 }
    let label = "server finished"
    if is_client == 1 { label = "client finished" }
    // dtls_prf_sha256(secret_buf, sec_n, label, seed_buf, seed_n, nbytes).
    // master_secret is 48 bytes (RFC 5246 §8.1). transcript hash is
    // exactly 32 bytes (FIPS 180-4 SHA-256 output).
    let verify_data = dtls_prf_sha256(ms, 48, label, transcript_hash, 32, 12)
    if verify_data == 0 { return 0 }
    let out = list_new()
    push(out, verify_data)
    push(out, 12)
    return out
}

// ----------------------------------------------------------------------------
// DER-decode an ECDSA signature (RFC 3279 §2.2.3 / X9.62).
//
//   Ecdsa-Sig-Value ::= SEQUENCE { r INTEGER, s INTEGER }
//
// Returns [r_bn, s_bn] on accept, 0 on any malformed input. Accepts
// short-form outer length (top bit of length byte = 0); the outputs from
// R1's _dtls_der_encode_ecdsa_sig always fit in <128 bytes (~72 bytes
// max for two 32B scalars) so short-form is the only case we need to
// support. Rejects long-form to keep the decoder minimal and total.
//
// Each INTEGER is decoded by parsing the 0x02 tag + short-form length +
// content bytes. A leading 0x00 (added by the encoder to keep the
// integer positive under two's complement) is stripped. The remaining
// bytes are interpreted as a big-endian bn256 via _p256_bytes_to_bn on a
// 32-byte staging buffer (left-padded with zeros).
// ----------------------------------------------------------------------------
fn _dtls_der_decode_ecdsa_sig(buf, n) {
    if n < 2 { return 0 }
    // Outer SEQUENCE (0x30) + short-form length.
    if load8(buf + 0) != 48 { return 0 }
    let outer_len = load8(buf + 1)
    if int_and(outer_len, 128) != 0 { return 0 }   // long-form: reject.
    if 2 + outer_len > n { return 0 }
    let off = 2
    let end = 2 + outer_len
    // r INTEGER.
    let r_bn = _dtls_der_decode_integer(buf, off, end)
    if r_bn == 0 { return 0 }
    let r_consumed = _dtls_der_decode_integer_consumed(buf, off, end)
    if r_consumed <= 0 { return 0 }
    off = off + r_consumed
    // s INTEGER.
    let s_bn = _dtls_der_decode_integer(buf, off, end)
    if s_bn == 0 { return 0 }
    let out = list_new()
    push(out, r_bn)
    push(out, s_bn)
    return out
}

// Helper: decode one INTEGER at buf[off..end] and return the bn256.
// Returns 0 on any malformed input (tag mismatch, length overflow,
// zero-length content, > 33 bytes of content).
fn _dtls_der_decode_integer(buf, off, end) {
    if off + 2 > end { return 0 }
    if load8(buf + off) != 2 { return 0 }
    let val_n = load8(buf + off + 1)
    if int_and(val_n, 128) != 0 { return 0 }   // long-form: reject.
    if off + 2 + val_n > end { return 0 }
    if val_n < 1 { return 0 }
    if val_n > 33 { return 0 }
    let content_off = off + 2
    let content_n = val_n
    // Strip the leading 0x00 sign byte if present + the top bit of the
    // NEXT byte is set (i.e. the 0x00 was appended by the encoder to
    // keep the integer positive).
    if content_n > 1 {
        if load8(buf + content_off) == 0 {
            content_off = content_off + 1
            content_n = content_n - 1
        }
    }
    if content_n > 32 { return 0 }
    // Right-align the content into a 32-byte buffer for _p256_bytes_to_bn.
    let raw = alloc(33)
    let pad = 32 - content_n
    let z = 0
    while z < pad { store8(raw + z, 0); z = z + 1 }
    let i = 0
    while i < content_n {
        store8(raw + pad + i, load8(buf + content_off + i))
        i = i + 1
    }
    store8(raw + 32, 0)
    return _p256_bytes_to_bn(raw, 0)
}

// Helper: return the byte count consumed by the INTEGER at buf[off..end],
// or -1 on malformed input. Used by _dtls_der_decode_ecdsa_sig to advance
// past the r INTEGER before parsing the s INTEGER.
fn _dtls_der_decode_integer_consumed(buf, off, end) {
    if off + 2 > end { return 0 - 1 }
    if load8(buf + off) != 2 { return 0 - 1 }
    let val_n = load8(buf + off + 1)
    if int_and(val_n, 128) != 0 { return 0 - 1 }
    if off + 2 + val_n > end { return 0 - 1 }
    return 2 + val_n
}

// dtls_client_init: build a ClientHello, wrap it in a Handshake envelope,
// wrap that in a record, and advance state to CLIENT_HELLO_SENT.
// `server_name` is recorded for SNI -- the SNI extension itself is a
// R29B.2 item (extensions wire format).
fn dtls_client_init(state, server_name) {
    if state[DTLS_S_SLOT_STATE] != DTLS_S_INIT {
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_ERR_BAD_STATE
        return 0
    }
    state[DTLS_S_SLOT_SERVER_NAME] = server_name
    let body_pair = _dtls_build_client_hello_body(state)
    if body_pair == 0 { return 0 }
    let body = body_pair[0]
    let body_n = body_pair[1]
    let msg_seq = dtls_msg_seq_next(state)
    let hs_pair = dtls_handshake_serialize(DTLS_HS_CLIENT_HELLO,
                                           msg_seq, body, body_n)
    if hs_pair == 0 { return 0 }
    let hs_buf = hs_pair[0]
    let hs_n = hs_pair[1]
    state[DTLS_S_SLOT_HS_OUT] = state[DTLS_S_SLOT_HS_OUT] + 1
    let rec = dtls_record_emit(state, DTLS_CT_HANDSHAKE, hs_buf, hs_n)
    if rec == 0 { return 0 }
    // Advance the state machine.
    state[DTLS_S_SLOT_STATE] = DTLS_S_CLIENT_HELLO_SENT
    return rec
}

// ============================================================================
//          SHA-256 + HMAC-SHA256  -- thin adapters over the canonical
// ============================================================================
//
// Pre-R34A (R33A.2) this section carried an inline FIPS 180-4 SHA-256 +
// RFC 2104 HMAC-SHA256 family (`_dtls_mask32`, `_dtls_add32`,
// `_dtls_xor32`, ..., `_dtls_sha_k`, `_dtls_sha_init_h`,
// `_dtls_sha_compress`, `dtls_sha256`, `dtls_hmac_sha256`) -- the fourth
// byte-identical copy of FIPS 180-4 in the tree (alongside the inline
// copies in `noise_xk.nova`, `merkle.nova`, `ecdsa.nova` that R33A
// landed `src/safety/sha256.nova` to retire). R33A deliberately did NOT
// touch dtls12.nova because R33B was concurrently modifying it for the
// cert-verify wire-in; R34A is the planned R33A.2 follow-up that
// retires the fourth copy now that R33B has landed.
//
// The two public symbols below (`dtls_sha256`, `dtls_hmac_sha256`)
// remain so the unit test harness (`tests/unit/test_dtls12.nova`) and
// the in-module HKDF + PRF callers (which use the names verbatim) do
// not learn a new name -- byte-identity at the wire level is the
// contract this refactor preserves. The implementations are now thin
// one-line forwards to the canonical `sha256_oneshot` /
// `hmac_sha256` in `src/safety/sha256.nova`. The pre-R34A inline
// 32-bit arithmetic helpers, K-table, IV, compression function, and
// padding logic have all been removed -- the canonical is the single
// authoritative source. The DTLS-specific composition (HKDF-Extract /
// HKDF-Expand RFC 5869 and the TLS 1.2 PRF P_SHA256 of RFC 5246 §5)
// stays inline below because it is not pure SHA-256; it composes
// HMAC-SHA256 in DTLS-specific recipes that have no analog in the
// canonical primitive module. The HKDF / PRF callers go through
// `dtls_hmac_sha256` which is itself a wrapper over the canonical
// HMAC, so the canonical implementation propagates transparently.
//
// `_DTLS_HASH_LEN` is retained because HKDF + PRF reference it directly
// (the constant value 32 is FIPS 180-4 -- canonical sha256.nova exposes
// it as `SHA256_HASH_LEN`; we keep the dtls-prefixed local alias so
// HKDF + PRF code below remains byte-identical to its pre-R34A form).
// `_DTLS_BLOCK_LEN` and `_DTLS_MASK32` (and the matching helper
// functions) are removed -- they were used only by the inline SHA-256
// + HMAC bodies, which are now gone.

let _DTLS_HASH_LEN = 32

// SHA-256 of n bytes at msg_buf. Returns 33-byte buffer (32B digest +
// trailing NUL). Thin adapter over `sha256_oneshot` (R33A canonical).
fn dtls_sha256(msg_buf, n) {
    return sha256_oneshot(msg_buf, n)
}

// HMAC-SHA256 (RFC 2104) over (key, msg) byte buffers. Returns a
// 33-byte buffer (32B mac + trailing NUL). Thin adapter over
// `hmac_sha256` (R33A canonical).
fn dtls_hmac_sha256(key_buf, key_n, msg_buf, msg_n) {
    return hmac_sha256(key_buf, key_n, msg_buf, msg_n)
}

// ============================================================================
//                   HKDF-Extract / HKDF-Expand (RFC 5869)
// ============================================================================
//
// HKDF-Extract: PRK = HMAC-Hash(salt, IKM).
// HKDF-Expand:  T(i) = HMAC-Hash(PRK, T(i-1) || info || octet(i)).
// We cap nbytes at 32*255 = 8160 per RFC 5869 (one octet counter).

let _DTLS_HKDF_MAX = 8160

fn dtls_hkdf_extract(salt_buf, salt_n, ikm_buf, ikm_n) {
    // RFC 5869 section 2.2: if salt is empty, treat as 32 zero bytes.
    if salt_n == 0 {
        let z = alloc(_DTLS_HASH_LEN + 1)
        let i = 0
        while i < _DTLS_HASH_LEN { store8(z + i, 0); i = i + 1 }
        store8(z + _DTLS_HASH_LEN, 0)
        return dtls_hmac_sha256(z, _DTLS_HASH_LEN, ikm_buf, ikm_n)
    }
    return dtls_hmac_sha256(salt_buf, salt_n, ikm_buf, ikm_n)
}

fn dtls_hkdf_expand(prk_buf, info_buf, info_n, nbytes) {
    if nbytes <= 0 { return 0 }
    if nbytes > _DTLS_HKDF_MAX { return 0 }
    let out = alloc(nbytes + 1)
    let prev_buf = 0
    let prev_n = 0
    let written = 0
    let counter = 1
    while written < nbytes {
        let total_in = prev_n + info_n + 1
        let in_buf = alloc(total_in + 1)
        let off = 0
        let pj = 0
        while pj < prev_n {
            store8(in_buf + off, load8(prev_buf + pj))
            off = off + 1
            pj = pj + 1
        }
        let ij = 0
        while ij < info_n {
            store8(in_buf + off, load8(info_buf + ij))
            off = off + 1
            ij = ij + 1
        }
        store8(in_buf + off, counter)
        let t = dtls_hmac_sha256(prk_buf, _DTLS_HASH_LEN, in_buf, total_in)
        let copy = _DTLS_HASH_LEN
        let left = nbytes - written
        if left < copy { copy = left }
        let k = 0
        while k < copy {
            store8(out + written + k, load8(t + k))
            k = k + 1
        }
        written = written + copy
        prev_buf = t
        prev_n = _DTLS_HASH_LEN
        counter = counter + 1
    }
    store8(out + nbytes, 0)
    return out
}

// ============================================================================
//                   TLS 1.2 PRF  (RFC 5246 section 5)
// ============================================================================
//
//   PRF(secret, label, seed) = P_<hash>(secret, label || seed)
//
//   P_hash(secret, seed):
//     HMAC_hash(secret, A(1) || seed) ||
//     HMAC_hash(secret, A(2) || seed) || ...
//     where A(0) = seed and A(i) = HMAC_hash(secret, A(i-1)).
//
// For DTLS 1.2 with our cipher suite, hash is SHA-256.
//
// The `label` is an ASCII string (e.g. "master secret"). The `seed`
// is the byte concatenation of (client_random || server_random) for
// master-secret derivation, or other context-specific data.

// Build (label || seed) into a fresh buffer.
fn _dtls_prf_seed(label, seed_buf, seed_n) {
    let label_n = len(label)
    let total = label_n + seed_n
    let out = alloc(total + 1)
    let i = 0
    while i < label_n {
        store8(out + i, char_at(label, i))
        i = i + 1
    }
    let j = 0
    while j < seed_n {
        store8(out + label_n + j, load8(seed_buf + j))
        j = j + 1
    }
    store8(out + total, 0)
    let pair = list_new()
    push(pair, out)
    push(pair, total)
    return pair
}

// P_SHA256(secret, seed) producing `nbytes` bytes.
fn _dtls_p_sha256(secret_buf, sec_n, seed_buf, seed_n, nbytes) {
    if nbytes <= 0 { return 0 }
    let out = alloc(nbytes + 1)
    // A(0) = seed
    let a_buf = alloc(seed_n + 1)
    let i = 0
    while i < seed_n {
        store8(a_buf + i, load8(seed_buf + i))
        i = i + 1
    }
    let a_n = seed_n
    let written = 0
    while written < nbytes {
        // A(i) = HMAC(secret, A(i-1))
        a_buf = dtls_hmac_sha256(secret_buf, sec_n, a_buf, a_n)
        a_n = _DTLS_HASH_LEN
        // Compute HMAC(secret, A(i) || seed)
        let in_buf = alloc(a_n + seed_n + 1)
        let k = 0
        while k < a_n {
            store8(in_buf + k, load8(a_buf + k))
            k = k + 1
        }
        let m = 0
        while m < seed_n {
            store8(in_buf + a_n + m, load8(seed_buf + m))
            m = m + 1
        }
        let t = dtls_hmac_sha256(secret_buf, sec_n, in_buf, a_n + seed_n)
        let copy = _DTLS_HASH_LEN
        let left = nbytes - written
        if left < copy { copy = left }
        let kk = 0
        while kk < copy {
            store8(out + written + kk, load8(t + kk))
            kk = kk + 1
        }
        written = written + copy
    }
    store8(out + nbytes, 0)
    return out
}

// Public PRF: PRF(secret, label, seed) -> nbytes buffer.
fn dtls_prf_sha256(secret_buf, sec_n, label, seed_buf, seed_n, nbytes) {
    let pair = _dtls_prf_seed(label, seed_buf, seed_n)
    let full_seed = pair[0]
    let full_seed_n = pair[1]
    return _dtls_p_sha256(secret_buf, sec_n, full_seed, full_seed_n, nbytes)
}

// ============================================================================
//             R31B  REAL  cipher path  (replaces the R29B.2 stubs)
// ============================================================================
//
// The functions below are the actual ECDHE + AEAD implementations that the
// `_R29B2_STUB` slots advertised. They follow the exact contract laid out
// in the R31B brief: P-256 keypair from `p256_keygen`, ECDH from
// `p256_derive`, TLS 1.2 PRF for master_secret + key_block, AES-128-GCM
// for record-level confidentiality + authenticity.
//
// The legacy `_R29B2_STUB` functions remain in the file as REGRESSION
// GUARDS -- the unit suite pins them against DTLS_ERR_STUB so a future
// agent who renames a real impl into a stub slot trips the test loud
// and early.
//
// State-machine integration (deferred to R31B.2):
//   * `dtls_ecdhe_derive` does NOT advance the handshake state machine.
//     A caller that drives the wire (R28E.2.X full handshake) is
//     responsible for the DTLS_S_* edge transitions; this layer ships
//     just the crypto.
//   * `dtls_seal_record` / `dtls_open_record` do NOT consult
//     `cipher_active` strictly -- they read the per-direction
//     key/IV slots and fail (0 / DTLS_DECRYPT_FAIL) if the slots are
//     unset. That keeps the test harness simple (test can build a
//     state manually) while still rejecting use-before-derive in
//     practice.

// ----------------------------------------------------------------------------
// Role + active-flag helpers.
// ----------------------------------------------------------------------------

fn dtls_set_role(state, is_server) {
    state[DTLS_S_SLOT_IS_SERVER] = is_server
    return 1
}

fn dtls_is_server(state)        { return state[DTLS_S_SLOT_IS_SERVER] }
fn dtls_cipher_active(state)    { return state[DTLS_S_SLOT_CIPHER_ACTIVE] }
fn dtls_send_seq(state)         { return state[DTLS_S_SLOT_SEND_SEQ] }
fn dtls_recv_seq(state)         { return state[DTLS_S_SLOT_RECV_SEQ] }
fn dtls_aead_records_out(state) { return state[DTLS_S_SLOT_AEAD_RECORDS_OUT] }
fn dtls_aead_records_in(state)  { return state[DTLS_S_SLOT_AEAD_RECORDS_IN] }
fn dtls_tamper_ct_count(state)  { return state[DTLS_S_SLOT_TAMPER_CT] }
fn dtls_tamper_tag_count(state) { return state[DTLS_S_SLOT_TAMPER_TAG] }
fn dtls_tamper_aad_count(state) { return state[DTLS_S_SLOT_TAMPER_AAD] }
fn dtls_recv_high_watermark(state) { return state[DTLS_S_SLOT_RECV_HIGH_WATERMARK] }
fn dtls_recv_replay_mask(state)    { return state[DTLS_S_SLOT_RECV_REPLAY_MASK] }
fn dtls_stats_replay(state)        { return state[DTLS_S_SLOT_STATS_REPLAY] }
fn dtls_stats_too_old(state)       { return state[DTLS_S_SLOT_STATS_TOO_OLD] }

// R33B cert-verify telemetry accessors. Each one returns the cumulative
// count of cert-verify outcomes that matched that bucket. The buckets
// are mutually exclusive -- every call to `dtls_cert_verify` bumps
// EXACTLY ONE of these (success or the matching failure tag).
fn dtls_stats_cert_ok(state)          { return state[DTLS_S_SLOT_STATS_CERT_OK] }
fn dtls_stats_cert_parse_fail(state)  { return state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] }
fn dtls_stats_cert_expired(state)     { return state[DTLS_S_SLOT_STATS_CERT_EXPIRED] }
fn dtls_stats_cert_sig_fail(state)    { return state[DTLS_S_SLOT_STATS_CERT_SIG_FAIL] }
fn dtls_stats_cert_fp_mismatch(state) { return state[DTLS_S_SLOT_STATS_CERT_FP_MISMATCH] }
fn dtls_current_time(state)           { return state[DTLS_S_SLOT_CURRENT_TIME_UNIX] }
fn dtls_recv_epoch(state)             { return state[DTLS_S_SLOT_RECV_EPOCH] }
fn dtls_send_epoch(state)             { return state[DTLS_S_SLOT_EPOCH] }

// R36B: cumulative cache-hit counter for the SRTP keying-material
// exporter. Bumped each time `dtls_export_srtp_keying_material(state)`
// serves a memoized 60-byte buf instead of running the PRF expand.
// First compute (cache miss) does NOT bump -- only HITS do. The
// counter is cumulative across the connection lifetime and NOT
// reset on `dtls_advance_epoch` (mirrors the R32B / R33B telemetry
// pattern; only the cache pointer is cleared on epoch advance).
fn dtls_stats_srtp_km_hits(state)     { return state[DTLS_S_SLOT_STATS_SRTP_KM_HITS] }

// R38B: cumulative count of `dtls_advance_epoch` invocations that
// re-expanded the key_block via the TLS 1.2 PRF. Variant A (re-run
// the SAME PRF inputs) is the standards-compliant default; the
// counter bumps regardless of whether the resulting bytes changed,
// since the security-relevant event is "a rekey HAPPENED" not "the
// bytes are different". See the slot-declaration comment for the
// full rationale + the variant-B future-research note.
fn dtls_stats_rekeys(state)           { return state[DTLS_S_SLOT_STATS_REKEYS] }

// Caller-pinned wall-clock used by `dtls_cert_verify`. The caller is
// expected to set this just before invoking cert verify (typically the
// wire driver reads `sys_unix_seconds()` once per handshake). Returns
// the new value for chaining.
fn dtls_set_current_time(state, unix_sec) {
    state[DTLS_S_SLOT_CURRENT_TIME_UNIX] = unix_sec
    return unix_sec
}
fn dtls_master_secret(state)    { return state[DTLS_S_SLOT_MASTER_SECRET] }
fn dtls_key_block(state)        { return state[DTLS_S_SLOT_KEY_BLOCK] }
fn dtls_local_pub(state)        { return state[DTLS_S_SLOT_LOCAL_PUB] }

// Phase O R2 (ADR-0095): public read-only accessors for the two 32-byte
// PRF-seed randoms. `dtls_ecdhe_derive` pins these into slots 17 / 18
// during the handshake; R33B skipped exposing them as public
// accessors (only `dtls_master_secret` at slot 19 was surfaced). R2
// lifts the omission so callers that need to bind SRTP or a DTLS-SCTP
// keyfile to the same random pair can read them without indexing raw
// slot numbers.
//
// Returns 0 when the slot has not yet been populated (i.e. before
// `dtls_ecdhe_derive` runs). Callers that need to distinguish "not yet
// derived" from "buffer of zero bytes" can check `dtls_cipher_active`
// first; a non-zero cipher_active guarantees both slots are populated.
fn dtls_client_random(state)    { return state[DTLS_S_SLOT_CLIENT_RANDOM] }
fn dtls_server_random(state)    { return state[DTLS_S_SLOT_SERVER_RANDOM] }

// Phase O R2 (ADR-0095): SRTP profile offer setter. Writes `profile`
// into DTLS_S_SLOT_SRTP_OFFER (index 48). The next `dtls_client_init`
// call inspects this slot; when non-zero, the ClientHello body builder
// splices in the `use_srtp` extension (RFC 5764 §4.1) carrying this
// single profile as a length-prefixed list.
//
// `profile` MUST be one of the SRTP_PROFILE_* constants declared at
// slot-block time (AES128_CM_SHA1_80, AES128_CM_SHA1_32, NULL_SHA1_80,
// NULL_SHA1_32). Any other value is treated as invalid: the slot is
// left unchanged (no-op) and `last_err` is stamped so the caller can
// observe the rejection. This "silent no-op with observable error"
// shape matches how `dtls_set_role` handles rejects and keeps R2 total
// (no crash on garbage-in).
//
// Returns 1 on accept, 0 on invalid-profile no-op.
fn dtls_offer_srtp(state, profile) {
    if profile == SRTP_PROFILE_AES128_CM_SHA1_80 {
        state[DTLS_S_SLOT_SRTP_OFFER] = profile
        return 1
    }
    if profile == SRTP_PROFILE_AES128_CM_SHA1_32 {
        state[DTLS_S_SLOT_SRTP_OFFER] = profile
        return 1
    }
    if profile == SRTP_PROFILE_NULL_SHA1_80 {
        state[DTLS_S_SLOT_SRTP_OFFER] = profile
        return 1
    }
    if profile == SRTP_PROFILE_NULL_SHA1_32 {
        state[DTLS_S_SLOT_SRTP_OFFER] = profile
        return 1
    }
    state[DTLS_S_SLOT_LAST_ERR] = "DTLS_ERR_BAD_SRTP_PROFILE"
    return 0
}

// Read-only accessor for the currently offered SRTP profile (0 = none).
fn dtls_srtp_offer(state)       { return state[DTLS_S_SLOT_SRTP_OFFER] }

// Phase P R2 (ADR-0098): accessors for the client-side verify plumbing.
// `hostname` is the SAN target the client-flight driver hands to
// `dtls_cert_verify_chain`; `anchors` is the trust-anchor list. Both are
// stored on the state by `gds_handshake_client` so the flight driver can
// pull them out when the peer's Certificate arrives without threading
// them through every internal helper. 0 means "not set" (the driver will
// return DTLS_CERT_HOSTNAME_MISMATCH / DTLS_CERT_NOT_PINNED per the
// x509_verify.nova defaults on empty inputs).
fn dtls_hostname(state)         { return state[DTLS_S_SLOT_HOSTNAME] }
fn dtls_anchors(state)          { return state[DTLS_S_SLOT_ANCHORS] }

// Convenience: snapshot the four 16/4-byte cipher slots so a test can
// compare two sides' key blocks byte-identical without poking at slots.
fn dtls_client_write_key(state) { return state[DTLS_S_SLOT_CLIENT_WRITE_KEY] }
fn dtls_server_write_key(state) { return state[DTLS_S_SLOT_SERVER_WRITE_KEY] }
fn dtls_client_write_iv(state)  { return state[DTLS_S_SLOT_CLIENT_WRITE_IV] }
fn dtls_server_write_iv(state)  { return state[DTLS_S_SLOT_SERVER_WRITE_IV] }

// ----------------------------------------------------------------------------
// ECDHE keypair generation.
// ----------------------------------------------------------------------------
//
// p256_keygen() returns [priv_bn, pub_compressed_33B]. We store BOTH
// in state -- priv for the upcoming derive call, pub for the test /
// handshake driver to lift into the wire ClientHello / ServerKeyExchange.
// Returns the local pubkey buffer on success, 0 on the cosmically-
// unlucky priv*G == identity case (matches p256_keygen's contract).
fn dtls_ecdhe_keygen(state) {
    let kp = p256_keygen()
    if kp == 0 { return 0 }
    state[DTLS_S_SLOT_PRIV_BN] = kp[0]
    state[DTLS_S_SLOT_LOCAL_PUB] = kp[1]
    return kp[1]
}

// Test-friendly seeded keypair generator -- forwards to
// `p256_keygen_seeded` which takes the priv scalar directly. Used by
// the round-trip tests that want reproducible keys; production paths
// MUST use `dtls_ecdhe_keygen` (which pulls from secure_random).
fn dtls_ecdhe_keygen_seeded(state, priv_bn) {
    let kp = p256_keygen_seeded(priv_bn)
    if kp == 0 { return 0 }
    state[DTLS_S_SLOT_PRIV_BN] = kp[0]
    state[DTLS_S_SLOT_LOCAL_PUB] = kp[1]
    return kp[1]
}

// ----------------------------------------------------------------------------
// Slice the 40-byte key_block per RFC 5246 §6.3 + RFC 5288 §3.
//
//   GCM cipher suite (0xC02B): MAC keys are 0 bytes (AEAD subsumes MAC).
//   key_block layout (offsets):
//     [ 0..16) client_write_key
//     [16..32) server_write_key
//     [32..36) client_write_IV  (4-byte implicit nonce salt)
//     [36..40) server_write_IV  (4-byte implicit nonce salt)
//
// We allocate four fresh buffers + NUL-pad each, then store back into
// state. The four buffers are *copies* of slices of key_block, so a
// downstream mutation of one doesn't poison the others.
// ----------------------------------------------------------------------------

fn _dtls_slice_key_block(state, key_block_buf) {
    let cwk = alloc(17)
    let swk = alloc(17)
    let civ = alloc(5)
    let siv = alloc(5)
    let i = 0
    while i < 16 {
        store8(cwk + i, load8(key_block_buf + 0  + i))
        store8(swk + i, load8(key_block_buf + 16 + i))
        i = i + 1
    }
    let j = 0
    while j < 4 {
        store8(civ + j, load8(key_block_buf + 32 + j))
        store8(siv + j, load8(key_block_buf + 36 + j))
        j = j + 1
    }
    store8(cwk + 16, 0)
    store8(swk + 16, 0)
    store8(civ + 4, 0)
    store8(siv + 4, 0)
    state[DTLS_S_SLOT_CLIENT_WRITE_KEY] = cwk
    state[DTLS_S_SLOT_SERVER_WRITE_KEY] = swk
    state[DTLS_S_SLOT_CLIENT_WRITE_IV]  = civ
    state[DTLS_S_SLOT_SERVER_WRITE_IV]  = siv
    return 1
}

// ----------------------------------------------------------------------------
// ECDHE derive -> master_secret -> key_block.
//
// Per RFC 5246 §8.1:
//   master_secret = PRF(pre_master_secret,
//                        "master secret",
//                        ClientHello.random + ServerHello.random)[0..47]
// Per RFC 5246 §6.3:
//   key_block     = PRF(master_secret,
//                        "key expansion",
//                        ServerHello.random + ClientHello.random)
//
// Note the SEED ORDER inversion between the two calls. RFC 5246 is
// explicit about it: master_secret seed is C||S; key_block seed is
// S||C. We mirror that exactly.
//
// `is_server` records which side this state belongs to so seal /
// open know which key/IV pair to use (the local party seals with its
// WRITE key; the local party opens with the PEER's write key).
//
// Returns 1 on success, 0 if peer pubkey rejects (off-curve / bad
// tag / identity) -- the latter sets DTLS_DECRYPT_FAIL on last_err.
//
// SIDE EFFECTS on state (success path):
//   * peer_pub stored
//   * client_random / server_random stored (callers may pass already-
//     stored buffers; we re-copy defensively)
//   * master_secret + key_block + 4 sliced keys/IVs stored
//   * cipher_active flipped to 1
// ----------------------------------------------------------------------------
fn dtls_ecdhe_derive(state, peer_pub_buf, peer_pub_n,
                     client_random_buf, server_random_buf, is_server) {
    let priv = state[DTLS_S_SLOT_PRIV_BN]
    if priv == 0 {
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_DECRYPT_FAIL
        return 0
    }
    // 1. Shared secret = priv * peer_pub (X coordinate, 32 bytes BE).
    let shared = p256_derive(priv, peer_pub_buf, peer_pub_n)
    if shared == 0 {
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_DECRYPT_FAIL
        return 0
    }
    let pms_buf = shared[0]
    let pms_n = shared[1]
    state[DTLS_S_SLOT_IS_SERVER] = is_server
    // 2. Stash peer pub + randoms.
    let peer_copy = alloc(peer_pub_n + 1)
    let pp = 0
    while pp < peer_pub_n {
        store8(peer_copy + pp, load8(peer_pub_buf + pp))
        pp = pp + 1
    }
    store8(peer_copy + peer_pub_n, 0)
    state[DTLS_S_SLOT_PEER_PUB] = peer_copy
    let cr = alloc(33)
    let sr = alloc(33)
    let i = 0
    while i < 32 {
        store8(cr + i, load8(client_random_buf + i))
        store8(sr + i, load8(server_random_buf + i))
        i = i + 1
    }
    store8(cr + 32, 0)
    store8(sr + 32, 0)
    state[DTLS_S_SLOT_CLIENT_RANDOM] = cr
    state[DTLS_S_SLOT_SERVER_RANDOM] = sr
    // 3. master_secret = PRF(pms, "master secret", C_rand || S_rand)[0..47].
    let ms_seed = alloc(65)
    let k = 0
    while k < 32 {
        store8(ms_seed + 0  + k, load8(cr + k))
        store8(ms_seed + 32 + k, load8(sr + k))
        k = k + 1
    }
    store8(ms_seed + 64, 0)
    let ms = dtls_prf_sha256(pms_buf, pms_n, "master secret",
                             ms_seed, 64, 48)
    state[DTLS_S_SLOT_MASTER_SECRET] = ms
    // 4. key_block = PRF(ms, "key expansion", S_rand || C_rand)[0..39].
    //    Order inverted vs master_secret seed -- RFC 5246 §6.3.
    let kb_seed = alloc(65)
    let kk = 0
    while kk < 32 {
        store8(kb_seed + 0  + kk, load8(sr + kk))
        store8(kb_seed + 32 + kk, load8(cr + kk))
        kk = kk + 1
    }
    store8(kb_seed + 64, 0)
    let kb = dtls_prf_sha256(ms, 48, "key expansion",
                             kb_seed, 64, 40)
    state[DTLS_S_SLOT_KEY_BLOCK] = kb
    // 5. Slice key_block into the four sub-buffers.
    _dtls_slice_key_block(state, kb)
    state[DTLS_S_SLOT_CIPHER_ACTIVE] = 1
    return 1
}

// ----------------------------------------------------------------------------
// Per-direction key/IV selection helpers.
//
// The local party SEALS with its WRITE key:
//   is_server == 0  -> seal uses client_write_*  (client is sending)
//   is_server == 1  -> seal uses server_write_*  (server is sending)
//
// The local party OPENS with the PEER's WRITE key:
//   is_server == 0  -> open uses server_write_*  (peer is server)
//   is_server == 1  -> open uses client_write_*  (peer is client)
// ----------------------------------------------------------------------------

fn _dtls_seal_key(state) {
    if state[DTLS_S_SLOT_IS_SERVER] == 0 {
        return state[DTLS_S_SLOT_CLIENT_WRITE_KEY]
    }
    return state[DTLS_S_SLOT_SERVER_WRITE_KEY]
}

fn _dtls_seal_iv(state) {
    if state[DTLS_S_SLOT_IS_SERVER] == 0 {
        return state[DTLS_S_SLOT_CLIENT_WRITE_IV]
    }
    return state[DTLS_S_SLOT_SERVER_WRITE_IV]
}

fn _dtls_open_key(state) {
    if state[DTLS_S_SLOT_IS_SERVER] == 0 {
        return state[DTLS_S_SLOT_SERVER_WRITE_KEY]
    }
    return state[DTLS_S_SLOT_CLIENT_WRITE_KEY]
}

fn _dtls_open_iv(state) {
    if state[DTLS_S_SLOT_IS_SERVER] == 0 {
        return state[DTLS_S_SLOT_SERVER_WRITE_IV]
    }
    return state[DTLS_S_SLOT_CLIENT_WRITE_IV]
}

// ----------------------------------------------------------------------------
// 12-byte nonce build (RFC 5288 §3 / RFC 5246 §6.2.3.3):
//   nonce = implicit_iv(4) || explicit_iv(8)
// where explicit_iv is the 8-byte big-endian record sequence number.
//
// `seq` is the AEAD-direction send_seq for seal, or the record-header
// sequence number for open. Both fit in 64 bits in practice (DTLS
// caps at 48 bits on the wire but the AEAD nonce field is 8 bytes).
// ----------------------------------------------------------------------------

fn _dtls_put_u64(buf, off, v) {
    store8(buf + off + 0, int_and(int_shr(v, 56), 255))
    store8(buf + off + 1, int_and(int_shr(v, 48), 255))
    store8(buf + off + 2, int_and(int_shr(v, 40), 255))
    store8(buf + off + 3, int_and(int_shr(v, 32), 255))
    store8(buf + off + 4, int_and(int_shr(v, 24), 255))
    store8(buf + off + 5, int_and(int_shr(v, 16), 255))
    store8(buf + off + 6, int_and(int_shr(v, 8), 255))
    store8(buf + off + 7, int_and(v, 255))
    return 1
}

fn _dtls_get_u64(buf, off) {
    let v = 0
    v = int_or(int_shl(load8(buf + off + 0), 56), v)
    v = int_or(int_shl(load8(buf + off + 1), 48), v)
    v = int_or(int_shl(load8(buf + off + 2), 40), v)
    v = int_or(int_shl(load8(buf + off + 3), 32), v)
    v = int_or(int_shl(load8(buf + off + 4), 24), v)
    v = int_or(int_shl(load8(buf + off + 5), 16), v)
    v = int_or(int_shl(load8(buf + off + 6), 8),  v)
    v = int_or(load8(buf + off + 7), v)
    return v
}

fn _dtls_build_nonce12(iv4_buf, seq) {
    let n = alloc(13)
    let i = 0
    while i < 4 {
        store8(n + i, load8(iv4_buf + i))
        i = i + 1
    }
    _dtls_put_u64(n, 4, seq)
    store8(n + 12, 0)
    return n
}

// ----------------------------------------------------------------------------
// 13-byte AAD per RFC 5246 §6.2.3.3:
//   additional_data = seq_num(8) || type(1) || version(2) || length(2)
// where `length` is the PLAINTEXT length (i.e. fragment_n, NOT the
// ciphertext length, NOT the wire body length).
// ----------------------------------------------------------------------------

let _DTLS_AAD_LEN = 13

fn _dtls_build_aad(seq, type_byte, version, pt_n) {
    let a = alloc(_DTLS_AAD_LEN + 1)
    _dtls_put_u64(a, 0, seq)
    store8(a + 8, type_byte)
    _dtls_put_u16(a, 9, version)
    _dtls_put_u16(a, 11, pt_n)
    store8(a + _DTLS_AAD_LEN, 0)
    return a
}

// ----------------------------------------------------------------------------
// dtls_seal_record(state, type_byte, plaintext_buf, pt_n)
//
// Output wire layout:
//   record header (13B) || explicit_IV (8B) || ciphertext (pt_n) || tag (16B)
//
// Length field in the header = 8 (explicit_IV) + pt_n + 16 (tag).
//
// Returns [out_buf, total_n] on success, 0 on failure (cipher inactive
// / negative pt_n / fragment too large / gcm_seal failed).
// ----------------------------------------------------------------------------
fn dtls_seal_record(state, type_byte, plaintext_buf, pt_n) {
    if state[DTLS_S_SLOT_CIPHER_ACTIVE] == 0 { return 0 }
    if pt_n < 0 { return 0 }
    let body_n = 8 + pt_n + 16
    if body_n > DTLS_RECORD_MAX_FRAGMENT { return 0 }
    let key = _dtls_seal_key(state)
    let iv4 = _dtls_seal_iv(state)
    if key == 0 { return 0 }
    if iv4 == 0 { return 0 }
    let seq = state[DTLS_S_SLOT_SEND_SEQ]
    let epoch = state[DTLS_S_SLOT_EPOCH]
    // R33B: AAD seq_num is the 64-bit (epoch << 48 | record_seq) pair
    // per RFC 5246 §6.2.3.3 + RFC 6347 §4.1.2.6. The 16-bit epoch lives
    // in the upper 16 bits of the 64-bit nonce/AAD seq field; the 48-bit
    // record_seq lives in the lower bits (matching the wire layout of
    // the record header). With epoch=0 the value collapses to plain
    // `seq` so all 297 pre-R33B tests remain byte-identical -- only
    // post-CCS records (epoch > 0) differ from R32B's behavior.
    let aad_seq = int_or(int_shl(epoch, 48), seq)
    let nonce12 = _dtls_build_nonce12(iv4, aad_seq)
    let aad = _dtls_build_aad(aad_seq, type_byte, DTLS_VERSION_WORD, pt_n)
    // gcm_seal returns a buf of size (pt_n + 16): ciphertext || tag.
    let sealed = gcm_seal(key, nonce12, aad, _DTLS_AAD_LEN,
                          plaintext_buf, pt_n)
    if sealed == 0 { return 0 }
    // Build record header (length = body_n) + explicit_IV + sealed.
    let total = DTLS_RECORD_HDR_LEN + body_n
    let out = alloc(total + 1)
    _dtls_put_u8(out,  0, type_byte)
    _dtls_put_u16(out, 1, DTLS_VERSION_WORD)
    _dtls_put_u16(out, 3, epoch)
    _dtls_put_u48(out, 5, seq)
    _dtls_put_u16(out, 11, body_n)
    // explicit_IV = aad_seq (8 bytes BE). For epoch=0 this is just seq,
    // matching R31B's wire layout byte-for-byte. For epoch>0 the upper
    // two bytes of the explicit_IV carry the epoch, which is exactly
    // what an interop-compliant DTLS 1.2 peer expects (the wire epoch
    // field + the explicit_IV upper bytes are redundant by design --
    // RFC 5288 §3 says the explicit_IV IS the seq_num).
    _dtls_put_u64(out, DTLS_RECORD_HDR_LEN, aad_seq)
    // ciphertext + tag follow immediately.
    let i = 0
    while i < pt_n + 16 {
        store8(out + DTLS_RECORD_HDR_LEN + 8 + i, load8(sealed + i))
        i = i + 1
    }
    store8(out + total, 0)
    // Increment AEAD send_seq + the legacy rec_seq + counters.
    state[DTLS_S_SLOT_SEND_SEQ] = seq + 1
    state[DTLS_S_SLOT_REC_SEQ]  = int_and(state[DTLS_S_SLOT_REC_SEQ] + 1,
                                          _DTLS_SEQ_MASK)
    state[DTLS_S_SLOT_RECORDS_OUT]      = state[DTLS_S_SLOT_RECORDS_OUT] + 1
    state[DTLS_S_SLOT_AEAD_RECORDS_OUT] = state[DTLS_S_SLOT_AEAD_RECORDS_OUT] + 1
    let r = list_new()
    push(r, out)
    push(r, total)
    return r
}

// ----------------------------------------------------------------------------
// R32B anti-replay sliding window (RFC 6347 §4.1.2.6).
//
// `_dtls_anti_replay_check(state, seq)` is PURE-FUNCTION: it inspects
// the current `RECV_HIGH_WATERMARK` + `RECV_REPLAY_MASK` and returns:
//   0 -- accept (caller must call AEAD; on AEAD success, then call
//        `_dtls_anti_replay_update`)
//   1 -- REPLAY (seq is within the window AND bit was already set)
//   2 -- TOO_OLD (seq is more than 63 below the high watermark)
// No state mutation -- this is critical for the "tamper does not
// advance the window" property: if AEAD fails after the pre-check,
// the window stays where it was so the legitimate next packet still
// validates.
//
// `_dtls_anti_replay_update(state, seq)` is called ONLY when both
// the pre-check returned 0 AND the AEAD tag check succeeded. It
// slides the window (if seq > high_watermark) and sets the bit
// for seq, then writes both slots back.
//
// The bit-shift / mask arithmetic uses Nova's arbitrary-precision
// integers; we still mask the result back into the low 64 bits
// after each shift so the bitmap genuinely represents a 64-bit
// window (sliding bits off the top would be wrong if Nova ints
// grew unboundedly past 64).
// ----------------------------------------------------------------------------

let _DTLS_REPLAY_WINDOW = 64
let _DTLS_REPLAY_MASK64 = 18446744073709551615   // (1 << 64) - 1

let DTLS_AR_OK      = 0
let DTLS_AR_REPLAY  = 1
let DTLS_AR_TOO_OLD = 2

fn _dtls_anti_replay_check(state, seq) {
    let hw = state[DTLS_S_SLOT_RECV_HIGH_WATERMARK]
    let mask = state[DTLS_S_SLOT_RECV_REPLAY_MASK]
    if seq > hw {
        // Above the window. Tentatively accept; the slide happens
        // in `_dtls_anti_replay_update` after the AEAD passes.
        return DTLS_AR_OK
    }
    // seq <= hw. Within window iff (hw - seq) < 64.
    let delta = hw - seq
    if delta >= _DTLS_REPLAY_WINDOW {
        return DTLS_AR_TOO_OLD
    }
    // Within window. Bit `delta` (LSB-indexed) represents seq.
    let bit = int_and(int_shr(mask, delta), 1)
    if bit == 1 {
        return DTLS_AR_REPLAY
    }
    return DTLS_AR_OK
}

fn _dtls_anti_replay_update(state, seq) {
    let hw = state[DTLS_S_SLOT_RECV_HIGH_WATERMARK]
    let mask = state[DTLS_S_SLOT_RECV_REPLAY_MASK]
    if seq > hw {
        // Slide the window: shift the mask left by (seq - hw) so
        // existing bits move further into the past. If the shift is
        // >= 64 the old bits all leave the window -- mask is cleared.
        let shift = seq - hw
        if shift >= _DTLS_REPLAY_WINDOW {
            mask = 0
        } else {
            mask = int_and(int_shl(mask, shift), _DTLS_REPLAY_MASK64)
        }
        // Bit 0 now represents the new high watermark.
        mask = int_or(mask, 1)
        state[DTLS_S_SLOT_RECV_HIGH_WATERMARK] = seq
    } else {
        // Within-window accept: just set the bit for this seq.
        let delta = hw - seq
        let bit_pos = int_shl(1, delta)
        mask = int_and(int_or(mask, bit_pos), _DTLS_REPLAY_MASK64)
    }
    state[DTLS_S_SLOT_RECV_REPLAY_MASK] = mask
    return 1
}

// ----------------------------------------------------------------------------
// dtls_open_record(state, buf, n)
//
// Reverse of dtls_seal_record. Parses the 13-byte header, recovers the
// explicit_IV (8B) and computes the implicit nonce from the local
// receive key/IV. Computes pt_n = body_n - 8 - 16, builds AAD with
// pt_n as the length, hands ciphertext+tag to gcm_open.
//
// R32B order of operations:
//   1. Parse the header and extract `seq`.
//   2. Run `_dtls_anti_replay_check(state, seq)` BEFORE the AEAD
//      decrypt. A replay or too-old record is rejected here without
//      ever touching gcm_open -- both because it would be wasted
//      crypto work and (critically) because we do NOT want to give
//      an attacker an oracle on bogus seq numbers.
//   3. On accept, run gcm_open. If the tag fails, the window state
//      is NOT updated (the high_watermark and replay_mask stay
//      where they were).
//   4. On tag success, call `_dtls_anti_replay_update(state, seq)`
//      which slides the window / sets the bit, then bumps the
//      legacy `RECV_SEQ` + records-in counters.
//
// On success: returns [type_byte, pt_buf, pt_n, seq], bumps recv_seq +
// recv counters.
// On REPLAY: returns DTLS_REPLAY, bumps STATS_REPLAY.
// On TOO_OLD: returns DTLS_TOO_OLD, bumps STATS_TOO_OLD.
// On AEAD failure: returns DTLS_DECRYPT_FAIL, bumps the appropriate
// tamper counter (ciphertext vs tag vs AAD vs other). We CANNOT
// distinguish ct-tamper from tag-tamper at this layer without re-
// running gcm_open twice -- so the counter assignment is heuristic:
// callers that want to track distinct paths construct distinct test
// calls and check the counter that bumped after each call.
// ----------------------------------------------------------------------------
fn dtls_open_record(state, buf, n) {
    if state[DTLS_S_SLOT_CIPHER_ACTIVE] == 0 { return DTLS_DECRYPT_FAIL }
    if n < DTLS_RECORD_HDR_LEN + 8 + 16 { return DTLS_DECRYPT_FAIL }
    let type_byte = _dtls_get_u8(buf, 0)
    let version   = _dtls_get_u16(buf, 1)
    let epoch     = _dtls_get_u16(buf, 3)
    let seq       = _dtls_get_u48(buf, 5)
    let body_n    = _dtls_get_u16(buf, 11)
    if DTLS_RECORD_HDR_LEN + body_n > n { return DTLS_DECRYPT_FAIL }
    if body_n < 8 + 16 { return DTLS_DECRYPT_FAIL }
    // R32B anti-replay sliding window (RFC 6347 §4.1.2.6). The check
    // runs BEFORE the AEAD attempt so a replay is rejected cheaply and
    // without giving an attacker the chance to feed crafted bytes to
    // the AEAD primitive. The window is mutated only AFTER the AEAD
    // tag check passes -- a forged record at seq=hw+N with a bad MAC
    // must not be able to advance the window and lock out the
    // legitimate next packet.
    let ar = _dtls_anti_replay_check(state, seq)
    if ar == DTLS_AR_REPLAY {
        state[DTLS_S_SLOT_STATS_REPLAY] = state[DTLS_S_SLOT_STATS_REPLAY] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_REPLAY
        return DTLS_REPLAY
    }
    if ar == DTLS_AR_TOO_OLD {
        state[DTLS_S_SLOT_STATS_TOO_OLD] = state[DTLS_S_SLOT_STATS_TOO_OLD] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_TOO_OLD
        return DTLS_TOO_OLD
    }
    let ct_n = body_n - 8 - 16
    let pt_n_expected = ct_n        // GCM is a stream cipher: ct_n == pt_n.
    let key = _dtls_open_key(state)
    let iv4 = _dtls_open_iv(state)
    if key == 0 { return DTLS_DECRYPT_FAIL }
    if iv4 == 0 { return DTLS_DECRYPT_FAIL }
    // explicit_IV resides at buf + 13; we still rebuild nonce as
    // implicit_iv || explicit_iv. RFC 5246 / 5288 use seq for explicit_IV
    // on the wire; per RFC 5288 §3 the seq number IS the explicit_IV
    // for the AES-GCM record layer. We honor the wire's explicit_IV
    // bytes rather than assuming they match `seq` -- a malicious peer
    // could split them, and gcm_open's tag check rejects either way.
    let explicit_iv_seq = _dtls_get_u64(buf, DTLS_RECORD_HDR_LEN)
    let nonce12 = _dtls_build_nonce12(iv4, explicit_iv_seq)
    // R33B: AAD seq_num is `(wire_epoch << 48) | wire_seq` -- matches
    // the seal-side `(state.epoch << 48) | state.send_seq` so AEAD tags
    // line up across the wire. With wire_epoch=0 the value collapses
    // to plain `seq` (byte-identical to R32B for all pre-CCS records).
    // We use the WIRE epoch rather than `state[RECV_EPOCH]` because
    // the AAD must be self-describing on the wire -- a peer can send
    // an epoch=N record while our state.recv_epoch is still at N-1
    // (cross-epoch transition window).
    let aad_seq = int_or(int_shl(epoch, 48), seq)
    let aad = _dtls_build_aad(aad_seq, type_byte, version, pt_n_expected)
    let ct_tag_buf = buf + DTLS_RECORD_HDR_LEN + 8
    let opened = gcm_open(key, nonce12, aad, _DTLS_AAD_LEN,
                          ct_tag_buf, ct_n + 16)
    if opened == AES_GCM_DECRYPT_FAIL {
        // Heuristic tamper-bucket assignment: we don't know whether
        // ciphertext, tag, or AAD was the culprit. Caller's test calls
        // record which counter to bump before/after each open.
        // Default: bump TAG (the most common gcm_open failure mode in
        // practice). Specialized callers use the tamper-bucket
        // helpers below to attribute correctly.
        //
        // R32B: AEAD failure does NOT advance the replay window.
        // High watermark + replay mask are LEFT UNTOUCHED here so a
        // tampered packet cannot lock out the legitimate next packet
        // (deliverable 5 of the R32B brief).
        state[DTLS_S_SLOT_TAMPER_TAG] = state[DTLS_S_SLOT_TAMPER_TAG] + 1
        return DTLS_DECRYPT_FAIL
    }
    let pt_buf = opened[0]
    let pt_n   = opened[1]
    // AEAD passed -- only NOW do we commit the window update. The
    // anti-replay state cannot be advanced by attacker-forged bytes
    // because gcm_open rejected them above.
    _dtls_anti_replay_update(state, seq)
    state[DTLS_S_SLOT_RECV_SEQ] = seq + 1
    state[DTLS_S_SLOT_RECORDS_IN]      = state[DTLS_S_SLOT_RECORDS_IN] + 1
    state[DTLS_S_SLOT_AEAD_RECORDS_IN] = state[DTLS_S_SLOT_AEAD_RECORDS_IN] + 1
    let r = list_new()
    push(r, type_byte)
    push(r, pt_buf)
    push(r, pt_n)
    push(r, seq)
    return r
}

// ----------------------------------------------------------------------------
// Tamper-bucket attribution helpers. The test suite drives these
// before/after each open call so it can assert exactly which
// failure path was exercised.
//
// The cleanest API would have `dtls_open_record` itself attribute
// (ct vs tag vs aad), but gcm_open intentionally returns an
// indistinct DECRYPT_FAIL -- a leak-resistant design. So the
// attribution happens at the TEST layer: the test bumps the
// `expected` counter before the open, then asserts the open
// returned DTLS_DECRYPT_FAIL and the right counter is now one
// higher. We pre-deduct here so the count nets out correctly.
//
// `_dtls_test_attribute_*` are called BY THE TEST after open
// to reassign the heuristic TAG bump to the correct bucket.
// ----------------------------------------------------------------------------

fn _dtls_test_attribute_ct(state) {
    if state[DTLS_S_SLOT_TAMPER_TAG] > 0 {
        state[DTLS_S_SLOT_TAMPER_TAG] = state[DTLS_S_SLOT_TAMPER_TAG] - 1
        state[DTLS_S_SLOT_TAMPER_CT]  = state[DTLS_S_SLOT_TAMPER_CT] + 1
    }
    return 1
}

fn _dtls_test_attribute_aad(state) {
    if state[DTLS_S_SLOT_TAMPER_TAG] > 0 {
        state[DTLS_S_SLOT_TAMPER_TAG] = state[DTLS_S_SLOT_TAMPER_TAG] - 1
        state[DTLS_S_SLOT_TAMPER_AAD] = state[DTLS_S_SLOT_TAMPER_AAD] + 1
    }
    return 1
}

// ============================================================================
//                   R33B: CCS-on-epoch-change reset
// ============================================================================
//
// RFC 6347 §4.1.2.6 mandates that the receiver MUST reset its anti-replay
// window when the epoch advances (e.g. on a ChangeCipherSpec record).
// R32B's exit note explicitly deferred this:
//
//   > Cross-epoch handling deferred. DTLS 1.2 ChangeCipherSpec (epoch
//   > transition) must reset the replay window per RFC 6347 §4.1.2.6.
//   > R32B does NOT reset the slots on epoch change [...]
//
// `dtls_advance_epoch(state)` is the wire driver's hook for that
// transition. Both directions advance in lockstep:
//
//   * `DTLS_S_SLOT_EPOCH`      (= "send_epoch") bumps by 1
//   * `DTLS_S_SLOT_RECV_EPOCH`                  bumps by 1
//   * `SEND_SEQ` resets to 0       (next seal stamps seq=0 in new epoch)
//   * `RECV_SEQ` resets to 0
//   * `RECV_HIGH_WATERMARK` resets to 0   (fresh replay window)
//   * `RECV_REPLAY_MASK`    resets to 0
//
// We do NOT reset the AEAD counter stats (`AEAD_RECORDS_OUT/IN`,
// `STATS_REPLAY`, `STATS_TOO_OLD`) -- those are cumulative telemetry
// across the connection lifetime, not per-epoch.
//
// R38B (R33B.4) closes the rekey caveat. On every advance we re-run
// the TLS 1.2 PRF to re-expand the 40-byte `key_block` from the SAME
// `master_secret` + `server_random || client_random` seed (RFC 5246
// §6.3 / RFC 6347 §4.1.2.6) and re-slice the four sub-buffers. This
// is the "soft-rekey" path: the master_secret is unchanged across a
// plain CCS (no fresh ECDHE), so re-running the SAME PRF inputs
// produces the SAME 40 bytes -- but a `STATS_REKEYS` counter bumps
// to record that the rekey happened, and the architecture supports a
// future variant B (mix the epoch into the seed, non-standard) that
// would actually change the bytes. R38B ships variant A; variant B
// is documented as a research item in the slot-declaration comment.
//
// Cross-epoch replay protection therefore holds at TWO independent
// layers: (a) the WINDOW layer (reset here, so a record at seq=N in
// the old epoch cannot replay against seq=N in the new epoch -- the
// watermark is now 0), and (b) the AEAD AAD layer (the AAD's upper
// 16 bits carry the epoch number per RFC 6347 §4.1.2.1, so a record
// sealed at (epoch=0, seq=N) produces a different ciphertext + tag
// from the same plaintext sealed at (epoch=1, seq=N)). The R38B PRF
// re-run is telemetry + a hook, NOT the load-bearing security
// property -- the AAD epoch differentiation is.
//
// Pre-cipher case: if `dtls_advance_epoch` runs before
// `dtls_ecdhe_derive` has populated `master_secret` /
// `client_random` / `server_random`, the PRF has no input to
// expand. We detect that condition (any of the three slots == 0)
// and skip the re-derivation; the counter still bumps so the caller
// sees the advance happened. This keeps the function total: it
// never fails.
//
// Returns 0 (no diagnostic codes -- this function never fails).
// ----------------------------------------------------------------------------
fn dtls_advance_epoch(state) {
    state[DTLS_S_SLOT_EPOCH]      = state[DTLS_S_SLOT_EPOCH] + 1
    state[DTLS_S_SLOT_RECV_EPOCH] = state[DTLS_S_SLOT_RECV_EPOCH] + 1
    state[DTLS_S_SLOT_SEND_SEQ]   = 0
    state[DTLS_S_SLOT_RECV_SEQ]   = 0
    state[DTLS_S_SLOT_RECV_HIGH_WATERMARK] = 0
    state[DTLS_S_SLOT_RECV_REPLAY_MASK]    = 0
    // R36B: invalidate the SRTP keying-material cache on epoch advance.
    // Although the SRTP exporter is anchored to the master_secret (which
    // does NOT change on a plain CCS-only key-block re-derivation), RFC
    // 5764 §4.2 leaves the door open for a DTLS re-handshake that feeds
    // fresh SRTP keys. The safe default is to invalidate the cache: if
    // the master_secret is genuinely unchanged the next export
    // recomputes the SAME 60 bytes (idempotent), and if it has changed
    // we MUST recompute or we'd serve stale keys. The hits counter
    // (`STATS_SRTP_KM_HITS`) is cumulative and is NOT reset here.
    state[DTLS_S_SLOT_SRTP_KM_CACHED] = 0
    // R38B: PRF rekey. Bump the cumulative counter unconditionally so
    // the caller can audit how many advances have happened, then re-
    // expand the key_block iff the cipher slots are populated (post-
    // ECDHE-derive). The re-expansion uses the SAME formula as
    // `dtls_ecdhe_derive` step 4: PRF(master_secret, "key expansion",
    // server_random || client_random)[0..39]. RFC 5246 §6.3 fixes the
    // label + seed order (S || C, inverted vs the master_secret
    // derivation). Variant A: re-run the same inputs -- the resulting
    // 40 bytes are byte-identical to the pre-advance key_block. The
    // value is in (a) telemetry visibility and (b) the structural
    // hook for variant B (epoch-in-seed, non-standard, future
    // research). See `DTLS_S_SLOT_STATS_REKEYS` for the full design
    // rationale.
    state[DTLS_S_SLOT_STATS_REKEYS] = state[DTLS_S_SLOT_STATS_REKEYS] + 1
    let ms = state[DTLS_S_SLOT_MASTER_SECRET]
    let cr = state[DTLS_S_SLOT_CLIENT_RANDOM]
    let sr = state[DTLS_S_SLOT_SERVER_RANDOM]
    if ms != 0 {
        if cr != 0 {
            if sr != 0 {
                // Build the 64-byte seed = server_random || client_random
                // (S || C order per RFC 5246 §6.3 for key_block).
                let kb_seed = alloc(65)
                let i = 0
                while i < 32 {
                    store8(kb_seed + 0  + i, load8(sr + i))
                    store8(kb_seed + 32 + i, load8(cr + i))
                    i = i + 1
                }
                store8(kb_seed + 64, 0)
                // master_secret is 48 bytes (RFC 5246 §8.1); key_block
                // is 40 bytes for the AES-128-GCM suite (2 * 16B keys
                // + 2 * 4B implicit IVs). Same call shape as the
                // initial derivation in `dtls_ecdhe_derive`.
                let kb = dtls_prf_sha256(ms, 48, "key expansion",
                                         kb_seed, 64, 40)
                state[DTLS_S_SLOT_KEY_BLOCK] = kb
                // Re-slice into the four sub-buffers. The slice helper
                // overwrites the per-key/iv slots with fresh
                // allocations, so subsequent seal/open call sites
                // automatically pick up the new buffers.
                _dtls_slice_key_block(state, kb)
            }
        }
    }
    return 0
}

// ============================================================================
//                   R33B: cert verify  (wires x509 + ecdsa)
// ============================================================================
//
// R32C shipped `src/safety/x509.nova` (RFC 5280 §4.1 minimal parser) +
// `src/safety/ecdsa.nova` (FIPS 186-4 §6.4 ECDSA-P-256 verify). R33B
// wires both into the DTLS handshake's Certificate-verify slot.
//
// Algorithm:
//   1. `x509_parse(der, n)` -- on negative return, REJECT.
//   2. `x509_check_validity(cert, state.current_time_unix)` --
//        on `X509_ERR_NOT_YET_VALID` -> DTLS_CERT_NOT_YET_VALID
//        on `X509_ERR_EXPIRED`       -> DTLS_CERT_EXPIRED
//   3. `ecdsa_sha256(cert.tbs_buf, cert.tbs_len)` -- hash the to-be-
//      signed bytes. We use ecdsa.nova's SHA-256 rather than dtls12's
//      in-module copy. Both produce byte-identical output; using the
//      ecdsa.nova one keeps the cert-verify path importing one
//      consistent crypto module -- if R33A.2 later swaps both to a
//      common `src/safety/sha256.nova` the call site changes in one
//      place.
//   4. `ecdsa_p256_verify_bn(pubkey, pub_len, hash_bn, r_bn, s_bn)` --
//      on 0, REJECT with DTLS_CERT_SIG_FAIL.
//   5. If `expected_fingerprint_or_null != 0`: SHA-256 the FULL cert
//      DER (RFC 4572 §5: `a=fingerprint:sha-256 <hex>` binds the SDP
//      offerer to the entire cert), compare byte-for-byte to the 32B
//      expected. Mismatch -> DTLS_CERT_FP_MISMATCH.
//   6. Otherwise return DTLS_OK and bump STATS_CERT_OK.
//
// All five failure tags bump their matching STATS_CERT_* counter; the
// success path bumps STATS_CERT_OK. Tags are mutually exclusive.
//
// `expected_fingerprint_or_null` semantics:
//   * 0           -- skip the fingerprint check (caller has out-of-band
//                    trust, e.g. a TOFU pin or a CA chain).
//   * non-zero    -- pointer to a 32-byte SHA-256 buffer to compare.
//                    Caller's responsibility to supply the right length;
//                    we read 32 bytes from the pointer.
// ----------------------------------------------------------------------------
fn dtls_cert_verify(state, peer_cert_der, peer_cert_len,
                    expected_fingerprint_or_null) {
    // Step 1: parse.
    let cert = x509_parse(peer_cert_der, peer_cert_len)
    if cert < 0 {
        state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] =
            state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_PARSE_FAIL
        return DTLS_CERT_PARSE_FAIL
    }
    // Step 2: validity.
    let now = state[DTLS_S_SLOT_CURRENT_TIME_UNIX]
    let vc = x509_check_validity(cert, now)
    if vc == X509_ERR_NOT_YET_VALID {
        state[DTLS_S_SLOT_STATS_CERT_EXPIRED] =
            state[DTLS_S_SLOT_STATS_CERT_EXPIRED] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_NOT_YET_VALID
        return DTLS_CERT_NOT_YET_VALID
    }
    if vc == X509_ERR_EXPIRED {
        state[DTLS_S_SLOT_STATS_CERT_EXPIRED] =
            state[DTLS_S_SLOT_STATS_CERT_EXPIRED] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_EXPIRED
        return DTLS_CERT_EXPIRED
    }
    if vc != 0 {
        // Defensive: x509_check_validity should only return 0 / NYV /
        // EXPIRED. Any other negative is treated as expired (closest
        // semantic bucket -- the cert is unusable).
        state[DTLS_S_SLOT_STATS_CERT_EXPIRED] =
            state[DTLS_S_SLOT_STATS_CERT_EXPIRED] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_EXPIRED
        return DTLS_CERT_EXPIRED
    }
    // Step 3 + 4: hash tbs, ECDSA verify.
    let tbs_buf = x509_tbs_buf(cert)
    let tbs_len = x509_tbs_len(cert)
    let hash_buf = ecdsa_sha256(tbs_buf, tbs_len)
    let hash_bn = _p256_bytes_to_bn(hash_buf, 0)
    let pub = x509_public_key_buf(cert)
    let pub_n = x509_public_key_len(cert)
    let r_bn = x509_signature_r(cert)
    let s_bn = x509_signature_s(cert)
    let ok = ecdsa_p256_verify_bn(pub, pub_n, hash_bn, r_bn, s_bn)
    if ok == 0 {
        state[DTLS_S_SLOT_STATS_CERT_SIG_FAIL] =
            state[DTLS_S_SLOT_STATS_CERT_SIG_FAIL] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_SIG_FAIL
        return DTLS_CERT_SIG_FAIL
    }
    // Step 5: optional fingerprint binding (RFC 4572 §5).
    if expected_fingerprint_or_null != 0 {
        let cert_fp = ecdsa_sha256(peer_cert_der, peer_cert_len)
        let i = 0
        while i < 32 {
            if load8(cert_fp + i) != load8(expected_fingerprint_or_null + i) {
                state[DTLS_S_SLOT_STATS_CERT_FP_MISMATCH] =
                    state[DTLS_S_SLOT_STATS_CERT_FP_MISMATCH] + 1
                state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_FP_MISMATCH
                return DTLS_CERT_FP_MISMATCH
            }
            i = i + 1
        }
    }
    // Step 6: success.
    state[DTLS_S_SLOT_STATS_CERT_OK] = state[DTLS_S_SLOT_STATS_CERT_OK] + 1
    return DTLS_OK
}

// ============================================================================
//         Phase O R1 (ADR-0094) chain-aware cert-verify
// ============================================================================
//
// `dtls_cert_verify_chain(state, cert_der_list, hostname, anchors, now)`
// is the chain-aware entry that Phase O R1 wires DTLS to. It forwards
// to `cert_chain_verify(der_list, host, anchors, now)` at
// `src/safety/x509_verify.nova:393`, which walks a full leaf-first cert
// chain, verifies each signature under its parent's public key
// (dispatching RSA / ECDSA per cert), matches the TOP cert's public
// key against the caller-supplied truststore (`anchors`), enforces
// SAN-based hostname coverage on the leaf (exact match or "*.suffix"),
// and confirms the leaf's validity window brackets `now`.
//
// XV_* -> DTLS_* mapping (ADR-0094 error map):
//   XV_OK          -> DTLS_OK (0)                bumps STATS_CERT_OK
//   XV_PARSE       -> DTLS_CERT_PARSE_FAIL       bumps STATS_CERT_PARSE_FAIL
//   XV_SIG         -> DTLS_CERT_SIG_FAIL         bumps STATS_CERT_SIG_FAIL
//   XV_NOT_PINNED  -> DTLS_CERT_NOT_PINNED       bumps STATS_CERT_NOT_PINNED
//   XV_HOSTNAME    -> DTLS_CERT_HOSTNAME_MISMATCH bumps STATS_CERT_HOSTNAME_MISMATCH
//   XV_EXPIRED     -> DTLS_CERT_EXPIRED          bumps STATS_CERT_EXPIRED
//
// Note that `cert_chain_verify` folds both "not yet valid" and "expired"
// into the single XV_EXPIRED tag (its validity check compares against
// the same `now` bound on both sides); the DTLS mapping therefore
// surfaces them as DTLS_CERT_EXPIRED. Callers that need to distinguish
// the two must use the legacy single-cert `dtls_cert_verify` entry.
//
// Returns `[dtls_status, leaf_cert]`:
//   * on DTLS_OK -- `leaf_cert` is the parsed leaf record from
//     `cert_parse` (the SAME cert list `x509_verify.nova` returns on
//     the XV_OK path). Callers that want to pin a fingerprint,
//     extract the leaf public key for CertificateVerify, or read SANs
//     read from this cert. Its lifetime is tied to `state`'s
//     lifetime -- copy any bytes you need before the state is freed.
//   * on any error -- `leaf_cert` is 0 (no valid leaf to hand out;
//     the chain never fully verified).
//
// `state[DTLS_S_SLOT_LAST_ERR]` is stamped with the mapped tag on every
// non-OK path so a caller inspecting `dtls_last_error(state)` sees the
// exact rejection cause. The legacy single-cert `dtls_cert_verify`
// signature is UNTOUCHED so existing test callers continue to work.
//
// Empty cert lists forward to `cert_chain_verify` unchanged, which
// itself returns XV_PARSE for `len(certs) == 0` -- the DTLS surface
// therefore reports DTLS_CERT_PARSE_FAIL (the safest bucket) for a
// caller that hands us nothing to verify.
//
// This function does NOT take an `expected_fingerprint` -- fingerprint
// binding is a WebRTC-DTLS-SDP-specific check (RFC 4572), not a chain-
// path concern; callers that need it can call `dtls_cert_verify` on
// the leaf separately after this returns DTLS_OK, or add their own
// fingerprint comparison against the returned `leaf_cert`.
// ----------------------------------------------------------------------------
fn dtls_cert_verify_chain(state, cert_der_list, hostname, anchors, now) {
    let r = cert_chain_verify(cert_der_list, hostname, anchors, now)
    let xv = r[0]
    let leaf = r[1]
    if xv == XV_OK {
        state[DTLS_S_SLOT_STATS_CERT_OK] =
            state[DTLS_S_SLOT_STATS_CERT_OK] + 1
        let out = list_new()
        push(out, DTLS_OK)
        push(out, leaf)
        return out
    }
    if xv == XV_PARSE {
        state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] =
            state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_PARSE_FAIL
        let out = list_new()
        push(out, DTLS_CERT_PARSE_FAIL)
        push(out, 0)
        return out
    }
    if xv == XV_SIG {
        state[DTLS_S_SLOT_STATS_CERT_SIG_FAIL] =
            state[DTLS_S_SLOT_STATS_CERT_SIG_FAIL] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_SIG_FAIL
        let out = list_new()
        push(out, DTLS_CERT_SIG_FAIL)
        push(out, 0)
        return out
    }
    if xv == XV_NOT_PINNED {
        state[DTLS_S_SLOT_STATS_CERT_NOT_PINNED] =
            state[DTLS_S_SLOT_STATS_CERT_NOT_PINNED] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_NOT_PINNED
        let out = list_new()
        push(out, DTLS_CERT_NOT_PINNED)
        push(out, 0)
        return out
    }
    if xv == XV_HOSTNAME {
        state[DTLS_S_SLOT_STATS_CERT_HOSTNAME_MISMATCH] =
            state[DTLS_S_SLOT_STATS_CERT_HOSTNAME_MISMATCH] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_HOSTNAME_MISMATCH
        let out = list_new()
        push(out, DTLS_CERT_HOSTNAME_MISMATCH)
        push(out, 0)
        return out
    }
    if xv == XV_EXPIRED {
        state[DTLS_S_SLOT_STATS_CERT_EXPIRED] =
            state[DTLS_S_SLOT_STATS_CERT_EXPIRED] + 1
        state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_EXPIRED
        let out = list_new()
        push(out, DTLS_CERT_EXPIRED)
        push(out, 0)
        return out
    }
    // Defensive: unknown XV_* -- treat as parse failure (the safest
    // reject; the chain surfaced a code we do not recognise).
    state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] =
        state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL] + 1
    state[DTLS_S_SLOT_LAST_ERR] = DTLS_CERT_PARSE_FAIL
    let out = list_new()
    push(out, DTLS_CERT_PARSE_FAIL)
    push(out, 0)
    return out
}

// Accessors for the two new Phase O R1 counters.
fn dtls_stats_cert_not_pinned(state) {
    return state[DTLS_S_SLOT_STATS_CERT_NOT_PINNED]
}
fn dtls_stats_cert_hostname_mismatch(state) {
    return state[DTLS_S_SLOT_STATS_CERT_HOSTNAME_MISMATCH]
}

// ============================================================================
//                   R29B.2 STUBS  (deliberately incomplete)
// ============================================================================
//
// Every stub is suffixed `_R29B2_STUB` so future agents can grep them
// and know exactly which surfaces still need real work. Each returns 0
// (or the documented sentinel) and bumps no counters -- a caller that
// inadvertently relies on a stub gets a clean "not implemented" signal
// rather than a silent no-op.

// ECDHE shared-secret derivation. R29B.2 wires this to a NIST P-256
// scalar multiplication primitive (the existing bignum_2048.nova ships
// RFC 7919 Group 14 -- 2048-bit MODP DH -- NOT P-256, so a fresh
// scalar-mul module lands first).
fn dtls_ecdhe_derive_R29B2_STUB(priv_buf, priv_n, peer_pub_buf, peer_pub_n) {
    return DTLS_ERR_STUB
}

// X.509 certificate parse + ECDSA signature verification.
//
// R33B replaced the stub body with a thin forward to the real
// `dtls_cert_verify` (which lives above and pulls in x509 + ecdsa).
// The historical (cert_buf, cert_n, expected_fp_buf, fp_n) signature
// is preserved so any caller that took a dependency on the old
// 4-argument shape keeps compiling -- but it now needs a `state`,
// which the legacy callers did not pass. We synthesize a transient
// `dtls_init()` state for the call so the per-state counters get
// SOMEWHERE to land; the real handshake driver uses `dtls_cert_verify`
// directly with its long-lived state. The transient state's
// `current_time_unix` slot is 0 by default -- a real cert whose
// notBefore is non-zero will report DTLS_CERT_NOT_YET_VALID via this
// path, which is the SAFE failure (rejecting an unverifiable cert
// rather than accepting it). Callers that want the historical
// "always returns DTLS_ERR_STUB" semantics should grep for the
// `_R29B2_STUB` suffix and migrate.
fn dtls_cert_verify_R29B2_STUB(cert_buf, cert_n, expected_fp_buf, fp_n) {
    let st = dtls_init()
    return dtls_cert_verify(st, cert_buf, cert_n, expected_fp_buf)
}

// AEAD-seal a record fragment. R29B.2 wires AES-128-GCM (via a fresh
// AES-128 + GHASH primitive -- the existing chacha20.nova ships ChaCha20
// + Poly1305, not AES-GCM).
fn dtls_seal_record_R29B2_STUB(state, type_byte, fragment_buf, frag_n) {
    return DTLS_ERR_STUB
}

// AEAD-open an inbound record. R29B.2 plug-in.
fn dtls_open_record_R29B2_STUB(state, buf, n) {
    return DTLS_ERR_STUB
}

// SRTP master-key extractor (RFC 5764 §4.2 EKM with the "EXTRACTOR-
// dtls_srtp" label).
//
// R2 forwards this legacy wrapper to the real R36B implementation
// `dtls_export_srtp_keying_material(state)`. The `_R29B2_STUB` suffix
// is LEGACY -- kept as-is so anything that greps for it still finds
// this call site -- but the body is no longer a stub. Behaviour is
// byte-identical to calling the real exporter directly:
//
//   * state == 0 or cipher not active -> return 0 (safe reject; NOT
//     the DTLS_ERR_STUB sentinel that the pre-R2 body returned).
//   * otherwise -> return the 60-byte SRTP keying-material buffer
//     (16 client key || 16 server key || 14 client salt || 14 server
//     salt) per RFC 5764 §4.2.
//
// Callers migrating off the legacy name should switch to
// `dtls_export_srtp_keying_material(state)` directly; both entries
// resolve to the SAME cached buffer once populated (R36B cache
// invariant is preserved).
fn dtls_extract_srtp_keys_R29B2_STUB(state) {
    if state == 0 { return 0 }
    return dtls_export_srtp_keying_material(state)
}

// ============================================================================
//                   DTLS-SRTP keying-material exporter (RFC 5764 §4.2)
// ============================================================================
//
// RFC 5764 §4.2 binds DTLS to SRTP by extracting per-session SRTP master
// keys + salts from the DTLS handshake's TLS-1.2 PRF (the same PRF used
// to expand `master_secret` -> `key_block` for AEAD record protection).
//
// The exporter uses the well-known label `"EXTRACTOR-dtls_srtp"` (exactly
// 19 ASCII bytes; RFC 5764 §4.2 fixes both the spelling and the length)
// and the seed `client_random || server_random` (the same 64-byte
// concatenation the TLS PRF uses to derive `master_secret`, but with
// `client_random` always first regardless of which side is calling --
// the exporter is symmetric so both peers compute the same 60 bytes).
//
// The output is a fixed 60-byte block laid out per RFC 5764 §4.2:
//   bytes 0..15  -- client SRTP master key   (16 bytes, AES-CM-128)
//   bytes 16..31 -- server SRTP master key   (16 bytes)
//   bytes 32..45 -- client SRTP master salt  (14 bytes, AES-CM salt)
//   bytes 46..59 -- server SRTP master salt  (14 bytes)
//
// Returns the 60-byte buffer on success (with a trailing NUL slack byte
// following the dtls_prf_sha256 convention) or the int 0 sentinel if the
// handshake has not yet driven `cipher_active` to 1. Calling this before
// ECDHE-derive populates the master_secret + randoms would yield
// uninitialized PRF input -- the gate is therefore CIPHER_ACTIVE, not
// the linear DTLS_S_* state machine (the latter is independent
// bookkeeping that a real wire driver advances; the cipher-state slots
// are what the PRF actually needs).
//
// The label is intentionally constructed as a string literal -- the
// existing `dtls_prf_sha256` helper takes (secret_buf, sec_n, label,
// seed_buf, seed_n, nbytes) where `label` is a Nova string and the
// internal `_dtls_prf_seed` reads its bytes via `char_at`. RFC 5764
// fixes the label to a printable-ASCII run, so a string literal is
// the cleanest representation.
//
// Cost note: this is ONE PRF expansion to 60 bytes, which is 2 HMAC-
// SHA256 iterations (each iter emits 32 bytes; ceil(60/32) = 2). The
// caller typically invokes this exactly once per session right after
// the handshake completes -- it is not on the per-packet hot path,
// so a per-call recompute would be fine. R36B (R35A.2) nonetheless
// caches the 60-byte buf in `DTLS_S_SLOT_SRTP_KM_CACHED` so any
// subsequent call serves it from the slot without re-running the
// PRF. The cached pointer IS the pointer returned on the miss path
// (not a fresh copy each time) so callers can pin pointer-equality
// for cache-hit assertions. `dtls_advance_epoch` clears the cache
// (see the rationale above the slot declaration). On a cache hit
// `DTLS_S_SLOT_STATS_SRTP_KM_HITS` increments; the first compute
// (miss) does NOT bump.
fn dtls_export_srtp_keying_material(state) {
    if state[DTLS_S_SLOT_CIPHER_ACTIVE] == 0 { return 0 }
    // R36B fast path: cache hit. Serve the memoized buf verbatim and
    // bump the cumulative hit counter. NOTE we do NOT re-validate the
    // randoms / master_secret slots on a hit -- the cache invariant is
    // that we ONLY populate the slot AFTER the PRF compute succeeded
    // against those slots, so a non-zero cache implies the inputs were
    // valid at compute time. The only legitimate way to invalidate is
    // `dtls_advance_epoch` (or a fresh `dtls_init` state).
    let cached = state[DTLS_S_SLOT_SRTP_KM_CACHED]
    if cached != 0 {
        state[DTLS_S_SLOT_STATS_SRTP_KM_HITS] =
            state[DTLS_S_SLOT_STATS_SRTP_KM_HITS] + 1
        return cached
    }
    let cr = state[DTLS_S_SLOT_CLIENT_RANDOM]
    let sr = state[DTLS_S_SLOT_SERVER_RANDOM]
    let ms = state[DTLS_S_SLOT_MASTER_SECRET]
    if cr == 0 { return 0 }
    if sr == 0 { return 0 }
    if ms == 0 { return 0 }
    // Build the 64-byte seed = client_random || server_random. The PRF
    // helper takes a (buf, n) pair; we allocate a fresh buffer rather
    // than passing the two component slots separately so the seed is
    // self-contained (the helper does not splice).
    let seed = alloc(65)
    let i = 0
    while i < 32 {
        store8(seed + i, load8(cr + i))
        i = i + 1
    }
    let j = 0
    while j < 32 {
        store8(seed + 32 + j, load8(sr + j))
        j = j + 1
    }
    store8(seed + 64, 0)
    // master_secret is 48 bytes (RFC 5246 §8.1); pass that fixed
    // length so the PRF runs against the same 48-byte secret the
    // record-layer key_block derivation used.
    let km = dtls_prf_sha256(ms, 48, "EXTRACTOR-dtls_srtp", seed, 64, 60)
    // R36B: stash the computed buf so subsequent calls hit the cache.
    // We deliberately store the EXACT pointer the PRF returned (not a
    // copy) -- the caller-visible identity contract is "first compute
    // wins, all subsequent calls see the same bytes via the same
    // pointer until epoch advance invalidates".
    state[DTLS_S_SLOT_SRTP_KM_CACHED] = km
    return km
}

// ============================================================================
//                         Stats / diagnostics
// ============================================================================

fn dtls_stats_line(state) {
    // NOTE: this MUST be built as a sequence of statement-level `s = s + ...`
    // accumulations, NOT as a single giant `+`-chain expression. A `return`
    // expression with ~40 chained `+` operands drives the NOVA compiler into a
    // non-terminating / super-exponential path at build time (it never finishes
    // even after 60s, hanging `make build`/`make test`). The hang threshold on
    // this toolchain is ~12-15 chained string `+` terms in one expression; see
    // docs/adr/0065-dtls12-compile-hang.md. Each statement below keeps the
    // per-expression `+` count small (<= 3), which compiles in milliseconds.
    let s = "dtls: state=" + dtls_state_name(state[DTLS_S_SLOT_STATE])
    s = s + " msg_seq=" + int_to_str(state[DTLS_S_SLOT_MSG_SEQ])
    s = s + " epoch=" + int_to_str(state[DTLS_S_SLOT_EPOCH])
    s = s + " rec_seq=" + int_to_str(state[DTLS_S_SLOT_REC_SEQ])
    s = s + " rec_out=" + int_to_str(state[DTLS_S_SLOT_RECORDS_OUT])
    s = s + " rec_in=" + int_to_str(state[DTLS_S_SLOT_RECORDS_IN])
    s = s + " hs_out=" + int_to_str(state[DTLS_S_SLOT_HS_OUT])
    s = s + " hs_in=" + int_to_str(state[DTLS_S_SLOT_HS_IN])
    s = s + " rtx=" + int_to_str(state[DTLS_S_SLOT_FLIGHT_RTX])
    s = s + " suite=" + int_to_str(state[DTLS_S_SLOT_CIPHER_SUITE])
    s = s + " hi_watermark=" + int_to_str(state[DTLS_S_SLOT_RECV_HIGH_WATERMARK])
    s = s + " replay=" + int_to_str(state[DTLS_S_SLOT_STATS_REPLAY])
    s = s + " too_old=" + int_to_str(state[DTLS_S_SLOT_STATS_TOO_OLD])
    s = s + " recv_epoch=" + int_to_str(state[DTLS_S_SLOT_RECV_EPOCH])
    s = s + " cert_ok=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_OK])
    s = s + " cert_parse_fail=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_PARSE_FAIL])
    s = s + " cert_expired=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_EXPIRED])
    s = s + " cert_sig_fail=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_SIG_FAIL])
    s = s + " cert_fp_mismatch=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_FP_MISMATCH])
    s = s + " cert_not_pinned=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_NOT_PINNED])
    s = s + " cert_hostname_mismatch=" + int_to_str(state[DTLS_S_SLOT_STATS_CERT_HOSTNAME_MISMATCH])
    s = s + " srtp_km_hits=" + int_to_str(state[DTLS_S_SLOT_STATS_SRTP_KM_HITS])
    s = s + " rekeys=" + int_to_str(state[DTLS_S_SLOT_STATS_REKEYS])
    return s
}

// ============================================================================
//                  Test-only helpers (exposed for unit suite)
// ============================================================================
//
// `_dtls_test_*` shims that lift internal helpers to the public namespace
// so the test suite can probe byte layout / state-machine edges without
// requiring a real handshake transport.

fn _dtls_test_valid_edge(from, to) { return _dtls_valid_edge(from, to) }
fn _dtls_test_seq_next(state)      { return _dtls_seq_next(state) }
fn _dtls_test_put_u24(buf, off, v) { return _dtls_put_u24(buf, off, v) }
fn _dtls_test_get_u24(buf, off)    { return _dtls_get_u24(buf, off) }
fn _dtls_test_put_u48(buf, off, v) { return _dtls_put_u48(buf, off, v) }
fn _dtls_test_get_u48(buf, off)    { return _dtls_get_u48(buf, off) }

// Reusable hex codec for tests that want to load test-vector inputs as
// hex strings. Kept separate from the ones in chacha20 to keep this
// module a leaf.
fn _dtls_hex_nibble(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }     // '0'..'9'
    if c >= 97 { if c <= 102 { return c - 87 } }     // 'a'..'f'
    if c >= 65 { if c <= 70  { return c - 55 } }     // 'A'..'F'
    return 0 - 1
}

// Decode hex string -> [buf, n] | 0
fn dtls_hex_decode(s) {
    let n = len(s)
    if n == 0 { return 0 }
    if int_shl(int_shr(n, 1), 1) != n { return 0 }
    let half = int_shr(n, 1)
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _dtls_hex_nibble(char_at(s, i * 2))
        let lo = _dtls_hex_nibble(char_at(s, i * 2 + 1))
        if hi < 0 { return 0 }
        if lo < 0 { return 0 }
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    let out = list_new()
    push(out, buf)
    push(out, half)
    return out
}

fn _dtls_nibble_hex(n) {
    if n < 10 { return n + 48 }
    return n + 87
}

fn dtls_hex_encode(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        let hi = _dtls_nibble_hex(int_and(int_shr(b, 4), 15))
        let lo = _dtls_nibble_hex(int_and(b, 15))
        s = s + chr(hi) + chr(lo)
        i = i + 1
    }
    return s
}
