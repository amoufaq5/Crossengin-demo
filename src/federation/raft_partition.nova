// Raft partition simulator (NOVA-0008, ADR-0086 Phase 5): drives the cluster
// harness under a NETWORK PARTITION to demonstrate Raft's headline safety
// guarantee -- no split-brain. A partition is a set of node indices that can
// reach each other; RPCs are delivered only within the set. The decisive rule:
// majorities are counted against the WHOLE cluster, never the partition, so a
// minority side can neither win an election nor commit an entry, and on heal the
// surviving majority's committed log wins.
//
// This is the most important thing a consensus protocol must get right, and it
// is pure and deterministic here -- no real network needed to prove it.
//
// NOVA gotchas: ids/terms/indexes are small counters (== is safe); no function
// exceeds 6 params; no str_eq. CrossEngin dependencies: raft_cluster.nova
// (which imports raft_core.nova) only.

import "raft_cluster.nova"

// Is node id in the reachable partition set?
fn _rp_in(members, id) {
    let i = 0
    while i < len(members) {
        if members[i] == id { return 1 }
        i = i + 1
    }
    return 0
}

// All node indices 0..len-1 (the trivial "fully connected" partition, used after
// a heal).
fn rp_all(c) {
    let m = list_new()
    let i = 0
    while i < len(c) {
        push(m, i)
        i = i + 1
    }
    return m
}

// Run an election where `cand` can only reach `members`. The candidate bumps its
// term and self-votes, then collects votes ONLY from reachable peers -- but the
// majority threshold is of the FULL cluster (len(c)/2+1). That single fact is
// what stops a minority partition from electing a leader. Returns 1 if it won.
fn rp_election(c, cand, members) {
    let me = c[cand]
    rf_become_candidate(me)
    let term = rf_term(me)
    let li = rf_last_index(me)
    let lt = rf_last_term(me)
    let votes = 1                         // self-vote
    let i = 0
    while i < len(members) {
        let id = members[i]
        if id != cand {
            let r = rf_request_vote(c[id], term, cand, li, lt)
            if r[0] == 1 { votes = votes + 1 }
        }
        i = i + 1
    }
    if votes >= (len(c) / 2 + 1) {
        rf_become_leader(me)
        return 1
    }
    return 0
}

// Replicate the leader's log to its reachable followers and try to commit. Only
// members receive the entries, but the commit decision counts match-indexes over
// the WHOLE cluster -- so a leader stranded in a minority cannot advance commit
// no matter how many local acks it gets. Commits only a current-term entry
// (5.4.2). Returns the committed index.
fn rp_replicate(c, leader, members) {
    let me = c[leader]
    let term = rf_term(me)
    let entries = _rc_tail(me[RF_LOG])
    let i = 0
    while i < len(members) {
        let id = members[i]
        if id != leader {
            rf_append_entries(c[id], term, 0, 0, entries, 0)
        }
        i = i + 1
    }
    // match-index over the ENTIRE cluster (unreachable nodes keep their old, lower
    // index -- exactly why a minority leader can't reach a majority here).
    let matches = list_new()
    let j = 0
    while j < len(c) {
        push(matches, rf_last_index(c[j]))
        j = j + 1
    }
    let target = rf_majority_index(matches)
    if target > rf_commit(me) {
        if rf_log_term(me, target) == term {
            list_set(me, RF_COMMIT, target)
        }
    }
    // heartbeat the (possibly unchanged) commit to reachable followers.
    let commit = rf_commit(me)
    let k = 0
    while k < len(members) {
        let id = members[k]
        if id != leader {
            rf_append_entries(c[id], term, rf_last_index(me), rf_last_term(me), list_new(), commit)
        }
        k = k + 1
    }
    return commit
}

// Convenience: build a two-element partition set.
fn rp_pair(a, b) { let m = list_new() push(m, a) push(m, b) return m }
// Convenience: build a three-element partition set.
fn rp_trio(a, b, x) { let m = list_new() push(m, a) push(m, b) push(m, x) return m }
