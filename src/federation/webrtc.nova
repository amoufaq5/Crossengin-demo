// CrossEngin federation: WebRTC data-channel signaling for browser-to-soul
// federation (R28E -- signaling half + DTLS stub).
//
// Purpose
//
//   CrossEngin's federation today (R18E gossip, R19E leader, R20E
//   distributed query, R21B distributed rule inference, R21E Noise-XK
//   gossip transport, R23E NAT traversal, R23C snapshot replication,
//   R26E gossip relay, R26E.2 / R27B / R27C relay ranking + secure
//   wrap) is native-only: every transport is a raw TCP socket (or
//   stubbed UDP). That excludes browser participants entirely --
//   browsers cannot open arbitrary AF_INET sockets; the only
//   federation-eligible transport from a browser tab is WebRTC.
//
//   WebRTC's data channel rides DTLS over ICE-negotiated UDP (or TCP
//   fallback). The control plane is plain HTTP/WebSocket: each peer
//   constructs a Session Description Protocol (SDP) document
//   describing its capabilities (codecs, addresses, fingerprints) and
//   exchanges offer/answer pairs over an out-of-band signaling channel
//   to bootstrap the encrypted media path. Once the SDP exchange
//   completes, the DTLS-SRTP handshake runs INSIDE the negotiated UDP
//   tunnel; from that point on the data channel sends SCTP-framed
//   bytes E2E-encrypted between the two peers.
//
//   Honest R28E scope: a full WebRTC stack -- SDP grammar parser, ICE
//   candidate gathering, STUN/TURN client, DTLS 1.2 / 1.3 client +
//   server, SRTP key derivation, SCTP-over-DTLS framing, congestion
//   control -- is several thousand lines per layer and out of reach
//   for one round of a parallel-agent sprint. R28E ships the SIGNALING
//   half: SDP offer / answer generation + parsing, the HTTP signaling
//   endpoint contract, and an EXPLICIT STUB for the data-channel
//   send/recv path that returns the documented sentinel error
//   `RTC_ERR_NEEDS_DTLS`. The integration path for R28E.2 (the
//   follow-up that wires real DTLS) is documented in FEDERATED_AUDIT.md.
//
// Protocol
//
//   1. Offerer (the soul -- or the browser -- that initiates):
//        a. `rtc_create_offer(state)` -> SDP offer string.
//           The offer carries a session id, version, origin (`o=`),
//           session name (`s=-`), connection info (`c=IN IP4 0.0.0.0`
//           -- the actual ICE candidate is filled in later by the
//           ICE gathering step which R28E stubs), and ONE media line
//           `m=application <port> DTLS/SCTP webrtc-datachannel`. Port
//           is 0 in the offer because we have no UDP socket yet;
//           browsers also emit `m=application 9` (the discard port
//           per RFC 8839) as a convention for "no ICE yet".
//        b. The offer is shipped to the answerer via the HTTP
//           signaling endpoint (`POST /rtc/offer`, body = SDP).
//
//   2. Answerer:
//        a. `rtc_receive_offer(state, sdp_offer)` parses the offer
//           (rejecting malformed SDP with `RTC_ERR_BAD_SDP`), records
//           the remote session id + fingerprint slots (stubbed -- no
//           DTLS yet), and generates an SDP answer with its own
//           session id + the matched media line.
//        b. The answer is returned in the HTTP response body.
//
//   3. Offerer receives the answer via `rtc_receive_answer(state,
//      sdp_answer)`; both ends now know the peer's session
//      identifier. (In a real stack, DTLS handshake fires next.)
//
//   4. R28E STUB: `rtc_send(channel, payload)` and `rtc_recv(channel)`
//      both return the sentinel `RTC_ERR_NEEDS_DTLS` -- the data
//      plane is not yet wired. The error tag is checked by callers
//      to surface a clear "WebRTC signaling complete but DTLS layer
//      not implemented" message rather than dropping bytes silently.
//
// SDP shape (the bare minimum we emit + accept)
//
//   v=0
//   o=- <session_id> <session_version> IN IP4 <ip>
//   s=-
//   t=0 0
//   m=application 9 DTLS/SCTP webrtc-datachannel
//   c=IN IP4 0.0.0.0
//   a=ice-ufrag:<placeholder>
//   a=ice-pwd:<placeholder>
//   a=fingerprint:sha-256 <placeholder>
//   a=setup:<actpass|active|passive>
//   a=mid:0
//   a=sctp-port:5000
//   a=max-message-size:262144
//
//   The fingerprint / ice-ufrag / ice-pwd slots are PLACEHOLDERS in
//   R28E -- the real values require the DTLS / ICE stacks that R28E.2
//   will add. They are emitted as well-formed lines so the SDP passes
//   a syntax check; callers attempting to actually negotiate a DTLS
//   session against an R28E peer would see the handshake fail at the
//   DTLS layer (which is what we want for the stub).
//
// Public API
//
//   rtc_init() -> rtc_state
//   rtc_create_offer(state) -> sdp_offer_string
//   rtc_receive_offer(state, sdp_offer) -> sdp_answer_string |
//                                          RTC_ERR_BAD_SDP
//   rtc_receive_answer(state, sdp_answer) -> 1 ok |
//                                            RTC_ERR_BAD_SDP
//   rtc_send(channel, payload) -> RTC_ERR_NEEDS_DTLS
//   rtc_recv(channel) -> RTC_ERR_NEEDS_DTLS
//   rtc_signaling_register(http_state, rtc_state) -> 1 ok | 0 stub
//   rtc_session_count(state) -> int
//   rtc_stats_offers_created(state) -> int
//   rtc_stats_offers_received(state) -> int
//   rtc_stats_answers_received(state) -> int
//   rtc_stats_bad_sdp(state) -> int
//   rtc_stats_send_attempts(state) -> int (data-plane stub bumps)
//   rtc_stats_recv_attempts(state) -> int (data-plane stub bumps)
//   rtc_stats_line(state) -> one-line summary
//
//   Plus parser helpers exercised by unit tests:
//     rtc_parse_sdp(sdp) -> dict-like list of [key, value] pairs |
//                           0 on malformed
//     rtc_sdp_field(parsed, key) -> string value or ""
//     rtc_sdp_has_media_app(parsed) -> 1 if `m=application` present
//     rtc_format_sdp(lines) -> string with CRLF line endings
//     rtc_alloc_session_id(state) -> monotonic uint string
//     rtc_channel_open(state, session_id) -> channel
//     rtc_channel_session(channel) -> session_id
//
//   Error tags (returned where the API doc says "error"):
//     RTC_ERR_BAD_SDP     -- malformed SDP (missing v=0, no
//                            m=application application line, etc.)
//     RTC_ERR_NEEDS_DTLS  -- the documented R28E stub; data-plane is
//                            not yet implemented.
//     RTC_ERR_NO_CHANNEL  -- caller passed a null channel.
//
// Honest scope (R28E)
//
//   * NO DTLS. R28E.2 must add a DTLS 1.2 client + server above the
//     ICE-negotiated UDP socket. This is the bulk of the missing
//     work: certificate fingerprint verification, the full DTLS
//     record layer + handshake state machine, SRTP key derivation
//     via SRTP-DTLS extractor.
//   * NO ICE. R28E.2 must add an ICE agent: STUN binding requests
//     against a configured STUN server, candidate gathering
//     (host / srflx / relay), connectivity checks, candidate pair
//     prioritization. R23E ships STUN-LIKE binding (`nat_query_stun`)
//     but it's NOT the RFC 8489 wire; an ICE-grade STUN client is a
//     separate module.
//   * NO SRTP. Even after DTLS, the actual data-channel rides SCTP
//     framed over DTLS records. R28E.2 must add SCTP framing or
//     re-use a simpler framing if browsers will tolerate it.
//   * NO STUN SERVER. R28E.2 must either ship a built-in STUN/TURN
//     server or document configuring an external one. The SDP we
//     emit assumes external STUN/TURN.
//   * SIGNALING ENDPOINT IS A STUB. `rtc_signaling_register` exists
//     only as an integration hook -- R28E does NOT wire it into
//     `src/io/transducers/stream_http.nova` because that module
//     accepts only `/api/event` for the chat seam. R28E.2 should
//     either extend stream_http to dispatch by path or ship a
//     dedicated `/rtc/*` listener.
//
// ADRs touched: registers ADR-0092 (WebRTC signaling, federation gap
//   closer for browser participants -- R28E ships signaling, R28E.2
//   will close the data plane).
// NOVA dependencies: builtins (str_eq, len, push, list_new, substr,
//   char_at, int_to_str, str_to_int).
// CrossEngin dependencies: NONE. This module is a leaf -- it does
//   not import other federation modules so R28 agents working in
//   parallel on different federation modules cannot collide.

// ---- error tags ---------------------------------------------------------

import "../util/str_safe.nova"
let RTC_ERR_BAD_SDP     = "rtc: bad sdp"
let RTC_ERR_NEEDS_DTLS  = "rtc: needs DTLS (R28E.2 stub)"
let RTC_ERR_NO_CHANNEL  = "rtc: no channel"

// ---- session direction tags ---------------------------------------------

let RTC_DIR_OFFER       = "offer"
let RTC_DIR_ANSWER      = "answer"

// ---- DTLS setup attribute (RFC 5763 + RFC 8842) ------------------------
//
// `actpass` is what an offerer sends to leave both options open; the
// answerer responds with `active` or `passive` depending on which side
// dialed the underlying transport. R28E always emits `actpass` in
// offers and `active` in answers as a placeholder convention.

let RTC_SETUP_ACTPASS   = "actpass"
let RTC_SETUP_ACTIVE    = "active"
let RTC_SETUP_PASSIVE   = "passive"

// ---- state record slots --------------------------------------------------
//
// rtc_state is a flat list of slots; pinned constants keep the layout
// stable when new stats land at the tail.

let RTC_S_NEXT_SID            = 0   // monotonic session-id counter
let RTC_S_SESSIONS            = 1   // list of session records
let RTC_S_STATS_OFFER_CREATED = 2
let RTC_S_STATS_OFFER_RX      = 3
let RTC_S_STATS_ANSWER_RX     = 4
let RTC_S_STATS_BAD_SDP       = 5
let RTC_S_STATS_SEND_ATTEMPT  = 6
let RTC_S_STATS_RECV_ATTEMPT  = 7

// Session record slot indices.
let RTC_SESS_ID               = 0
let RTC_SESS_DIRECTION        = 1
let RTC_SESS_REMOTE_ID        = 2   // "" until offer/answer received

// Channel record slot indices.
let RTC_CH_SESSION            = 0
let RTC_CH_STATE              = 1

// ---- state constructor ---------------------------------------------------

fn rtc_init() {
    let st = list_new()
    push(st, 0)               // S_NEXT_SID
    push(st, list_new())      // S_SESSIONS
    push(st, 0)               // S_STATS_OFFER_CREATED
    push(st, 0)               // S_STATS_OFFER_RX
    push(st, 0)               // S_STATS_ANSWER_RX
    push(st, 0)               // S_STATS_BAD_SDP
    push(st, 0)               // S_STATS_SEND_ATTEMPT
    push(st, 0)               // S_STATS_RECV_ATTEMPT
    return st
}

// ---- accessors ----------------------------------------------------------

fn rtc_session_count(state)         { return len(state[RTC_S_SESSIONS]) }
fn rtc_stats_offers_created(state)  { return state[RTC_S_STATS_OFFER_CREATED] }
fn rtc_stats_offers_received(state) { return state[RTC_S_STATS_OFFER_RX] }
fn rtc_stats_answers_received(state){ return state[RTC_S_STATS_ANSWER_RX] }
fn rtc_stats_bad_sdp(state)         { return state[RTC_S_STATS_BAD_SDP] }
fn rtc_stats_send_attempts(state)   { return state[RTC_S_STATS_SEND_ATTEMPT] }
fn rtc_stats_recv_attempts(state)   { return state[RTC_S_STATS_RECV_ATTEMPT] }

// ---- helpers: monotonic session id --------------------------------------

fn rtc_alloc_session_id(state) {
    let n = state[RTC_S_NEXT_SID] + 1
    state[RTC_S_NEXT_SID] = n
    return int_to_str(n)
}

// ---- string helpers (kept private) --------------------------------------
//
// A handful of tiny utilities so we don't pull in another module. SDP
// is a line-oriented text format; CRLF is the RFC line ending and
// LF-only is widely accepted.

fn _rtc_starts_with(s, prefix) {
    let pn = len(prefix)
    if len(s) < pn { return 0 }
    let i = 0
    while i < pn {
        if char_at(s, i) != char_at(prefix, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Split `s` on a single delimiter byte. Empty trailing field is kept.
// LF (10) is the canonical line ending; CR (13) is stripped if present.
fn _rtc_split_lines(s) {
    let out = list_new()
    let i = 0
    let start = 0
    let n = len(s)
    while i < n {
        let c = char_at(s, i)
        if c == 10 {
            let line_len = i - start
            // Trim a trailing CR if present.
            if line_len > 0 {
                if char_at(s, start + line_len - 1) == 13 {
                    line_len = line_len - 1
                }
            }
            push(out, substr(s, start, line_len))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        let line_len = n - start
        if line_len > 0 {
            if char_at(s, start + line_len - 1) == 13 {
                line_len = line_len - 1
            }
        }
        push(out, substr(s, start, line_len))
    }
    return out
}

// Find the value after the `<key>=` prefix. Returns the substring of
// `line` after the first `=` byte, or "" if no `=` present. SDP lines
// always have the shape `<one-letter>=<value>`.
fn _rtc_value_after_eq(line) {
    let i = 0
    while i < len(line) {
        if char_at(line, i) == 61 {
            return substr(line, i + 1, len(line) - i - 1)
        }
        i = i + 1
    }
    return ""
}

// Returns the single-letter SDP key for a line (the byte before '=').
// "" if the line does not match the `<letter>=...` shape.
fn _rtc_key_of(line) {
    if len(line) < 2 { return "" }
    if char_at(line, 1) != 61 { return "" }
    return substr(line, 0, 1)
}

// ---- SDP parser ----------------------------------------------------------
//
// We do NOT parse SDP into a typed AST -- the goal is just to verify
// the document is well-formed enough to round-trip and to expose the
// few fields the answer-generation step needs. The parser returns a
// flat list of [key, value] pairs (lines that look like `k=v`) and
// drops anything else. The caller asks `rtc_sdp_field(parsed, key)`
// for a value; multiple `a=` lines all collapse to "a" key, so
// callers needing per-attribute access use `rtc_sdp_attrs`.

fn rtc_parse_sdp(sdp) {
    if len(sdp) == 0 { return 0 }
    let lines = _rtc_split_lines(sdp)
    if len(lines) == 0 { return 0 }
    // SDP MUST start with `v=0`. Strict in the parser; that's the
    // headline malformed-input gate.
    let first = lines[0]
    if str_eq_bytes(first, "v=0") == 0 { return 0 }
    let out = list_new()
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if len(line) >= 2 {
            let k = _rtc_key_of(line)
            if len(k) > 0 {
                let v = _rtc_value_after_eq(line)
                let pair = list_new()
                push(pair, k)
                push(pair, v)
                push(out, pair)
            }
        }
        i = i + 1
    }
    // Validate we saw at least an origin (`o=`) and a session name (`s=`).
    // These are mandatory per RFC 4566.
    let saw_o = 0
    let saw_s = 0
    let j = 0
    while j < len(out) {
        if str_eq_bytes(out[j][0], "o") == 1 { saw_o = 1 }
        if str_eq_bytes(out[j][0], "s") == 1 { saw_s = 1 }
        j = j + 1
    }
    if saw_o == 0 { return 0 }
    if saw_s == 0 { return 0 }
    return out
}

// Return the FIRST value with the given key, or "".
fn rtc_sdp_field(parsed, key) {
    if parsed == 0 { return "" }
    let i = 0
    while i < len(parsed) {
        if str_eq_bytes(parsed[i][0], key) == 1 {
            return parsed[i][1]
        }
        i = i + 1
    }
    return ""
}

// 1 iff a media line of shape `m=application ...` is present.
fn rtc_sdp_has_media_app(parsed) {
    if parsed == 0 { return 0 }
    let i = 0
    while i < len(parsed) {
        if str_eq_bytes(parsed[i][0], "m") == 1 {
            if _rtc_starts_with(parsed[i][1], "application") == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// Collect all `a=...` attribute values (multiple are normal). Returns a
// list of strings (the part after `a=`).
fn rtc_sdp_attrs(parsed) {
    let out = list_new()
    if parsed == 0 { return out }
    let i = 0
    while i < len(parsed) {
        if str_eq_bytes(parsed[i][0], "a") == 1 {
            push(out, parsed[i][1])
        }
        i = i + 1
    }
    return out
}

// 1 iff there's at least one `a=<starts_with>...` attribute.
fn rtc_sdp_has_attr_prefix(parsed, prefix) {
    let attrs = rtc_sdp_attrs(parsed)
    let i = 0
    while i < len(attrs) {
        if _rtc_starts_with(attrs[i], prefix) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- SDP formatter -------------------------------------------------------
//
// Join a list of `k=v` lines with CRLF. The trailing CRLF is required by
// RFC 4566; we emit it so the wire is byte-identical to a browser-
// generated SDP.

fn rtc_format_sdp(lines) {
    let out = ""
    let i = 0
    while i < len(lines) {
        out = out + lines[i] + chr(13) + chr(10)
        i = i + 1
    }
    return out
}

// Build the minimum-viable SDP lines for a session. `direction` selects
// the DTLS setup attribute (offer -> actpass, answer -> active). The
// fingerprint / ice-ufrag / ice-pwd values are placeholders (the
// DTLS / ICE work belongs to R28E.2 -- see file header).

fn _rtc_build_sdp_lines(session_id, direction) {
    let lines = list_new()
    push(lines, "v=0")
    push(lines, "o=- " + session_id + " 1 IN IP4 0.0.0.0")
    push(lines, "s=-")
    push(lines, "t=0 0")
    push(lines, "m=application 9 DTLS/SCTP webrtc-datachannel")
    push(lines, "c=IN IP4 0.0.0.0")
    push(lines, "a=ice-ufrag:CExx" + session_id)
    push(lines, "a=ice-pwd:CExxPLACEHOLDERR28E" + session_id)
    push(lines, "a=fingerprint:sha-256 00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00")
    let setup = RTC_SETUP_ACTPASS
    if str_eq_bytes(direction, RTC_DIR_ANSWER) == 1 {
        setup = RTC_SETUP_ACTIVE
    }
    push(lines, "a=setup:" + setup)
    push(lines, "a=mid:0")
    push(lines, "a=sctp-port:5000")
    push(lines, "a=max-message-size:262144")
    return lines
}

// ---- session records ----------------------------------------------------

fn _rtc_new_session(session_id, direction, remote_id) {
    let rec = list_new()
    push(rec, session_id)
    push(rec, direction)
    push(rec, remote_id)
    return rec
}

fn _rtc_register_session(state, session_id, direction, remote_id) {
    let rec = _rtc_new_session(session_id, direction, remote_id)
    push(state[RTC_S_SESSIONS], rec)
    return rec
}

fn _rtc_find_session(state, session_id) {
    let sessions = state[RTC_S_SESSIONS]
    let i = 0
    while i < len(sessions) {
        if str_eq_bytes(sessions[i][RTC_SESS_ID], session_id) == 1 {
            return sessions[i]
        }
        i = i + 1
    }
    return 0
}

// ---- public API: rtc_create_offer --------------------------------------

fn rtc_create_offer(state) {
    let sid = rtc_alloc_session_id(state)
    let lines = _rtc_build_sdp_lines(sid, RTC_DIR_OFFER)
    let sdp = rtc_format_sdp(lines)
    _rtc_register_session(state, sid, RTC_DIR_OFFER, "")
    state[RTC_S_STATS_OFFER_CREATED] = state[RTC_S_STATS_OFFER_CREATED] + 1
    return sdp
}

// ---- public API: rtc_receive_offer -> sdp answer or error -------------

fn rtc_receive_offer(state, sdp_offer) {
    let parsed = rtc_parse_sdp(sdp_offer)
    if parsed == 0 {
        state[RTC_S_STATS_BAD_SDP] = state[RTC_S_STATS_BAD_SDP] + 1
        return RTC_ERR_BAD_SDP
    }
    if rtc_sdp_has_media_app(parsed) == 0 {
        state[RTC_S_STATS_BAD_SDP] = state[RTC_S_STATS_BAD_SDP] + 1
        return RTC_ERR_BAD_SDP
    }
    // Extract the remote session id from `o=` (token at index 1):
    //   o=- <session_id> <session_version> IN IP4 <ip>
    let o_val = rtc_sdp_field(parsed, "o")
    let remote_id = _rtc_token_at(o_val, 1)
    // Allocate our own session id + build the answer.
    let sid = rtc_alloc_session_id(state)
    let lines = _rtc_build_sdp_lines(sid, RTC_DIR_ANSWER)
    let answer_sdp = rtc_format_sdp(lines)
    _rtc_register_session(state, sid, RTC_DIR_ANSWER, remote_id)
    state[RTC_S_STATS_OFFER_RX] = state[RTC_S_STATS_OFFER_RX] + 1
    return answer_sdp
}

// ---- public API: rtc_receive_answer -> 1 ok or error -----------------

fn rtc_receive_answer(state, sdp_answer) {
    let parsed = rtc_parse_sdp(sdp_answer)
    if parsed == 0 {
        state[RTC_S_STATS_BAD_SDP] = state[RTC_S_STATS_BAD_SDP] + 1
        return RTC_ERR_BAD_SDP
    }
    if rtc_sdp_has_media_app(parsed) == 0 {
        state[RTC_S_STATS_BAD_SDP] = state[RTC_S_STATS_BAD_SDP] + 1
        return RTC_ERR_BAD_SDP
    }
    let o_val = rtc_sdp_field(parsed, "o")
    let remote_id = _rtc_token_at(o_val, 1)
    // Find the most recent outbound offer (DIRECTION = "offer") whose
    // remote_id is empty (waiting for the answer); patch its remote_id.
    // If none found, register a free-standing remote-id record so the
    // caller can still see the session count update.
    let sessions = state[RTC_S_SESSIONS]
    let i = len(sessions) - 1
    let patched = 0
    while i >= 0 {
        let rec = sessions[i]
        if str_eq_bytes(rec[RTC_SESS_DIRECTION], RTC_DIR_OFFER) == 1 {
            if len(rec[RTC_SESS_REMOTE_ID]) == 0 {
                rec[RTC_SESS_REMOTE_ID] = remote_id
                patched = 1
                i = -1
            } else { i = i - 1 }
        } else { i = i - 1 }
    }
    state[RTC_S_STATS_ANSWER_RX] = state[RTC_S_STATS_ANSWER_RX] + 1
    return 1
}

// Tokenize an SDP field value on space, returning the n-th token (0-
// indexed) or "" if out of range.
fn _rtc_token_at(value, n) {
    let i = 0
    let start = 0
    let tok = 0
    while i < len(value) {
        if char_at(value, i) == 32 {
            if tok == n {
                return substr(value, start, i - start)
            }
            tok = tok + 1
            start = i + 1
        }
        i = i + 1
    }
    if tok == n {
        return substr(value, start, len(value) - start)
    }
    return ""
}

// ---- public API: channel + data-plane stub ------------------------------
//
// rtc_send / rtc_recv return the documented sentinel error tag. A
// caller integrating R28E.2 will replace these with the real DTLS-SRTP
// send / receive primitives once that layer lands; the contract for
// callers in R28E is to detect the sentinel and surface a clear
// "needs DTLS" message (see /webrtc REPL command in
// examples/crossengin_chat.nova).

fn rtc_channel_open(state, session_id) {
    let sess = _rtc_find_session(state, session_id)
    if sess == 0 { return 0 }
    let ch = list_new()
    push(ch, session_id)      // RTC_CH_SESSION
    push(ch, "ready")         // RTC_CH_STATE (placeholder)
    return ch
}

fn rtc_channel_session(channel) {
    if channel == 0 { return "" }
    return channel[RTC_CH_SESSION]
}

fn rtc_send(state, channel, payload) {
    state[RTC_S_STATS_SEND_ATTEMPT] = state[RTC_S_STATS_SEND_ATTEMPT] + 1
    if channel == 0 { return RTC_ERR_NO_CHANNEL }
    return RTC_ERR_NEEDS_DTLS
}

fn rtc_recv(state, channel) {
    state[RTC_S_STATS_RECV_ATTEMPT] = state[RTC_S_STATS_RECV_ATTEMPT] + 1
    if channel == 0 { return RTC_ERR_NO_CHANNEL }
    return RTC_ERR_NEEDS_DTLS
}

// ---- public API: signaling endpoint registration (stub) ----------------
//
// `src/io/transducers/stream_http.nova` accepts a SINGLE path
// (`/api/event`) and was not designed for path-routing. Wiring R28E
// signaling into that listener properly requires either extending its
// dispatch table or shipping a dedicated `/rtc/*` server -- both belong
// to R28E.2. For now this hook records the intent (so a caller can
// say "I want signaling on this HTTP state") and returns 0 to signal
// the integration is a stub. Callers that have their own HTTP server
// shim can drive `rtc_create_offer` / `rtc_receive_offer` /
// `rtc_receive_answer` directly without going through this hook.

fn rtc_signaling_register(http_state, rtc_state) {
    if http_state == 0 { return 0 }
    if rtc_state == 0 { return 0 }
    // Integration is documented but not wired in R28E. The follow-up
    // (R28E.2) extends stream_http with a path-routing table or
    // ships a dedicated listener.
    return 0
}

// ---- diagnostics --------------------------------------------------------

fn rtc_stats_line(state) {
    return "rtc: sessions=" + int_to_str(rtc_session_count(state))
        + " offers_created=" + int_to_str(state[RTC_S_STATS_OFFER_CREATED])
        + " offers_rx=" + int_to_str(state[RTC_S_STATS_OFFER_RX])
        + " answers_rx=" + int_to_str(state[RTC_S_STATS_ANSWER_RX])
        + " bad_sdp=" + int_to_str(state[RTC_S_STATS_BAD_SDP])
        + " send_stub=" + int_to_str(state[RTC_S_STATS_SEND_ATTEMPT])
        + " recv_stub=" + int_to_str(state[RTC_S_STATS_RECV_ATTEMPT])
}
