// Raft membership change via joint consensus (NOVA-0008, ADR-0086 Phase 5):
// raft_core deliberately left "membership change" to the I/O shell, but the
// SAFETY of reconfiguration is a pure state-machine concern -- and it is the other
// classic place a consensus implementation lets in split-brain. The naive
// approach (switch directly from old config C_old to new config C_new) can, during
// the switchover, allow TWO disjoint majorities -- one in C_old, one in C_new --
// to each elect a leader. Raft's fix is the JOINT configuration C_{old,new}: while
// transitioning, every decision (elections AND commits) needs a majority in BOTH
// C_old and C_new simultaneously. Two disjoint majorities of the same C_old cannot
// exist, so a single leader is preserved across the change.
//
// This module encodes that rule and nothing else: no log, no RPC. It composes with
// raft_core/raft_cluster (a config is just a set of node ids) but does not touch
// the trusted log/index math.
//
// NOVA gotchas: node ids are small counters (== is safe); no function exceeds 6
// params; no str_eq. CrossEngin dependencies: none (builtins only).

// ---- configurations (a config is a list of node ids) -----------------------
fn _rm_in(cfg, id) {
    let i = 0
    while i < len(cfg) {
        if cfg[i] == id { return 1 }
        i = i + 1
    }
    return 0
}

fn rm_size(cfg)     { return len(cfg) }
fn rm_majority(cfg) { return len(cfg) / 2 + 1 }

// How many of the granted votes (a list of node ids) are members of `cfg`. Votes
// from nodes not in a config don't count toward that config's majority.
fn rm_count_votes(cfg, votes) {
    let c = 0
    let i = 0
    while i < len(votes) {
        if _rm_in(cfg, votes[i]) == 1 { c = c + 1 }
        i = i + 1
    }
    return c
}

// Does `votes` constitute a majority of a single config?
fn rm_has_majority(cfg, votes) {
    if rm_count_votes(cfg, votes) >= rm_majority(cfg) { return 1 }
    return 0
}

// The joint-consensus rule: a decision is authorized only with a majority in BOTH
// the old AND the new config. This is the heart of safe reconfiguration.
fn rm_has_joint_majority(c_old, c_new, votes) {
    if rm_has_majority(c_old, votes) == 0 { return 0 }
    if rm_has_majority(c_new, votes) == 0 { return 0 }
    return 1
}

// ---- the transition state machine ------------------------------------------
let RM_STABLE = 0   // operating under a single configuration
let RM_JOINT  = 1   // C_{old,new}: both configurations active

// State layout [phase, c_old, c_new]. In STABLE, c_old is the live config and
// c_new is ignored.
let RM_PHASE = 0
let RM_COLD  = 1
let RM_CNEW  = 2

fn rm_state(cfg) {
    let s = list_new()
    push(s, RM_STABLE)
    push(s, cfg)
    push(s, cfg)
    return s
}

fn rm_phase(s) { return s[RM_PHASE] }

// Begin a configuration change: enter the joint phase C_{old,new}. From here,
// decisions require a joint majority. (Raft replicates the joint config as a log
// entry; here we just flip the phase.)
fn rm_begin_change(s, c_new) {
    list_set(s, RM_CNEW, c_new)
    list_set(s, RM_PHASE, RM_JOINT)
    return 1
}

// Complete the change: once the joint config is committed, leave the joint phase
// and operate solely under C_new.
fn rm_commit_change(s) {
    list_set(s, RM_COLD, s[RM_CNEW])
    list_set(s, RM_PHASE, RM_STABLE)
    return 1
}

// The config that single-majority decisions use when STABLE.
fn rm_current_config(s) { return s[RM_COLD] }

// Is a decision authorized given the granted votes, in the current phase? STABLE
// uses a simple majority; JOINT requires a majority of BOTH configs. This is the
// single rule that elections and commits both consult during reconfiguration.
fn rm_can_decide(s, votes) {
    if s[RM_PHASE] == RM_JOINT {
        return rm_has_joint_majority(s[RM_COLD], s[RM_CNEW], votes)
    }
    return rm_has_majority(s[RM_COLD], votes)
}
