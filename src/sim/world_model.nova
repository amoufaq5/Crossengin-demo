// CrossEngin simulation: a deterministic, tickable grid micro-world (P5,
// ADR-0055).
//
// Purpose
//   A sandbox the agent can act in -- and, via world_peek, IMAGINE acting in
//   before committing (the forward_sim seam). A position on a W x H grid is the
//   state ("a moment"); an action (up/down/left/right) is an effector call;
//   reaching the goal cell pays a reward, every other step pays a small penalty
//   so shorter paths score higher. Fully deterministic, so a learner's progress
//   is reproducible and a bench can measure it.
//
//   Start small (grid); the same [reward, done, next_state] contract extends to
//   text / API / tool sandboxes later.
//
// ADRs implemented: ADR-0055 (simulation + self-improvement), ADR-0032
//   (forward simulation: world_peek predicts without acting). NOVA deps:
//   builtins. CrossEngin deps: none.

// ---- actions ---------------------------------------------------------------
let SIM_UP    = 0
let SIM_DOWN  = 1
let SIM_LEFT  = 2
let SIM_RIGHT = 3
let SIM_N_ACTIONS = 4

// ---- rewards ---------------------------------------------------------------
let SIM_STEP_REWARD = 0 - 1   // small penalty per move -> prefer short paths
let SIM_GOAL_REWARD = 100

// ---- world layout ----------------------------------------------------------
let WORLD_OBJ_TAG = 2440
let W_TAG   = 0
let W_W     = 1
let W_H     = 2
let W_X     = 3
let W_Y     = 4
let W_GX    = 5
let W_GY    = 6
let W_SX    = 7
let W_SY    = 8
let W_STEPS = 9
let W_DONE  = 10

fn world_new(width, height, start_x, start_y, goal_x, goal_y) {
    let w = list_new()
    push(w, WORLD_OBJ_TAG)
    push(w, width); push(w, height)
    push(w, start_x); push(w, start_y)
    push(w, goal_x); push(w, goal_y)
    push(w, start_x); push(w, start_y)
    push(w, 0); push(w, 0)
    return w
}

fn world_reset(world) {
    list_set(world, W_X, world[W_SX])
    list_set(world, W_Y, world[W_SY])
    list_set(world, W_STEPS, 0)
    list_set(world, W_DONE, 0)
    return 1
}

fn world_width(world)  { return world[W_W] }
fn world_height(world) { return world[W_H] }
fn world_x(world)      { return world[W_X] }
fn world_y(world)      { return world[W_Y] }
fn world_steps(world)  { return world[W_STEPS] }
fn world_done(world)   { return world[W_DONE] }
fn world_actions()     { return SIM_N_ACTIONS }
fn world_n_states(world) { return world[W_W] * world[W_H] }

// State identity: a single integer id for the cell (the "moment id").
fn world_state_id(world) { return world[W_Y] * world[W_W] + world[W_X] }
fn world_state_of(x, y, width) { return y * width + x }

fn _abs(v) { if v < 0 { return 0 - v } return v }

// Fewest steps from start to goal (manhattan; no obstacles) -- the optimal
// baseline the metric is judged against.
fn world_optimal_steps(world) {
    return _abs(world[W_GX] - world[W_SX]) + _abs(world[W_GY] - world[W_SY])
}

// Resulting (nx, ny) of an action from (x, y), clamped to the grid (a move into
// a wall leaves the agent in place). Returns [nx, ny].
fn _world_move(world, x, y, action) {
    let nx = x
    let ny = y
    if action == SIM_UP    { if y > 0 { ny = y - 1 } }
    if action == SIM_DOWN  { if y < world[W_H] - 1 { ny = y + 1 } }
    if action == SIM_LEFT  { if x > 0 { nx = x - 1 } }
    if action == SIM_RIGHT { if x < world[W_W] - 1 { nx = x + 1 } }
    let r = list_new(); push(r, nx); push(r, ny)
    return r
}

// Take an action: move, accrue reward, set done on reaching the goal. Mutates
// the world. Returns [reward, done].
fn world_step(world, action) {
    if world[W_DONE] == 1 {
        let z = list_new(); push(z, 0); push(z, 1); return z
    }
    let mv = _world_move(world, world[W_X], world[W_Y], action)
    let nx = mv[0]
    let ny = mv[1]
    list_set(world, W_X, nx)
    list_set(world, W_Y, ny)
    list_set(world, W_STEPS, world[W_STEPS] + 1)
    let reward = SIM_STEP_REWARD
    let done = 0
    if nx == world[W_GX] { if ny == world[W_GY] {
        reward = SIM_GOAL_REWARD
        done = 1
        list_set(world, W_DONE, 1)
    } }
    let r = list_new(); push(r, reward); push(r, done)
    return r
}

// Predict the outcome of an action WITHOUT acting (the forward_sim seam):
// returns [reward, done, next_state_id]. Pure -- the world is unchanged.
fn world_peek(world, action) {
    let mv = _world_move(world, world[W_X], world[W_Y], action)
    let nx = mv[0]
    let ny = mv[1]
    let reward = SIM_STEP_REWARD
    let done = 0
    if nx == world[W_GX] { if ny == world[W_GY] { reward = SIM_GOAL_REWARD done = 1 } }
    let r = list_new()
    push(r, reward); push(r, done); push(r, world_state_of(nx, ny, world[W_W]))
    return r
}
