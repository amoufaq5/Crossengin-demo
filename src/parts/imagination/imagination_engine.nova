// CrossEngin imagination: engine (pattern atoms + states).
//
// Purpose
//   Imagination operates over learned pattern atoms (ADR-0032): a pattern maps a
//   situation (a cluster of active atoms) to a successor cluster via a transform,
//   carrying a Bayesian confidence that rises as its predictions verify against
//   reality (ADR-0024). The engine bootstraps ~10 seed patterns and abstracts
//   new ones from recurring episodic deltas (ADR-0022). This module defines the
//   pattern atom (in the imagination KG), the state representation (a set of
//   atom ids), and the match/apply primitives the four imagination modes use.
//
//   Confidence is the atom's alpha/beta mean (milli). Self-contained over the kg
//   layer (single import prefix; NOVA blocker #10).
//
// ADRs implemented: ADR-0032 (imagination patterns). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/kg/multi_kg_manager.nova.

import "../../kg/multi_kg_manager.nova"

let IMG_SEED_COUNT = 10

fn imagination_kg_init(reg) {
    return kg_spawn(reg, "imagination")
}

// ---- state: a set of active atom ids --------------------------------------
fn img_state_new() { return list_new() }
fn img_state_has(state, id) { return contains(state, id) }
fn img_state_size(state) { return len(state) }
fn img_state_add(state, id) {
    if contains(state, id) == 0 { push(state, id) }
    return state
}
fn _img_copy(src) {
    let d = list_new()
    let i = 0
    while i < len(src) { push(d, src[i]); i = i + 1 }
    return d
}
fn img_state_of(ids) { return _img_copy(ids) }

// ---- pattern atoms --------------------------------------------------------
fn pattern_new(ikg, label, situation, successor, moment) {
    let a = kg_add_atom(ikg, ATOM_CONCEPT, label, moment)
    atom_payload_set(a, "situation", _img_copy(situation))
    atom_payload_set(a, "successor", _img_copy(successor))
    return a
}

fn is_pattern(a) {
    if a == 0 { return 0 }
    if atom_kind(a) != ATOM_CONCEPT { return 0 }
    if atom_payload_has(a, "situation") == 1 { return 1 }
    return 0
}

fn pattern_situation(p) { return atom_payload_get(p, "situation") }
fn pattern_successor(p) { return atom_payload_get(p, "successor") }
fn pattern_confidence(p) { return atom_confidence(p) }
fn pattern_observe(p, sign) { return atom_observe(p, sign) }

// Does a pattern's situation hold in a state (all situation atoms present)?
fn pattern_matches(p, state) {
    let sit = pattern_situation(p)
    let i = 0
    while i < len(sit) {
        if contains(state, sit[i]) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Apply a pattern: the state plus the pattern's successor atoms (union).
fn pattern_apply(p, state) {
    let out = _img_copy(state)
    let suc = pattern_successor(p)
    let i = 0
    while i < len(suc) {
        img_state_add(out, suc[i])
        i = i + 1
    }
    return out
}

// All pattern atoms in the imagination KG.
fn img_patterns(ikg) {
    let atoms = kg_atoms(ikg)
    let out = list_new()
    let i = 0
    while i < len(atoms) {
        if is_pattern(atoms[i]) == 1 { push(out, atoms[i]) }
        i = i + 1
    }
    return out
}

// Bootstrap seed patterns (ADR-0032: ~10). Generic situation->successor seeds.
fn seed_patterns(ikg, moment) {
    let i = 0
    while i < IMG_SEED_COUNT {
        let sit = list_new(); push(sit, i)
        let suc = list_new(); push(suc, 100 + i)
        pattern_new(ikg, "seed_" + int_to_str(i), sit, suc, moment)
        i = i + 1
    }
    return IMG_SEED_COUNT
}

// Abstract a new pattern from a recurring (situation -> successor) delta
// (episodic replay, ADR-0022).
fn pattern_abstract(ikg, situation, successor, moment) {
    return pattern_new(ikg, "learned", situation, successor, moment)
}
