// CrossEngin imagination: scenario planner.
//
// Purpose
//   Multi-step branching forward simulations with explicit decision points, for
//   long-horizon goal evaluation (ADR-0032 mode 4). Each decision (an action
//   atom added to the current state) is rolled forward; the resulting scenario
//   is scored by how many goal atoms it reaches. The best/worst scenarios guide
//   planning (ADR-0033).
//
// ADRs implemented: ADR-0032 (scenarios). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/imagination/forward_sim.nova.

import "forward_sim.nova"

let SC_DECISION = 0
let SC_OUTCOME  = 1
let SC_SCORE    = 2

// How many goal atoms a state reaches.
fn _sc_goal_score(state, goal_atoms) {
    let n = 0
    let i = 0
    while i < len(goal_atoms) {
        if contains(state, goal_atoms[i]) == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Expand each decision into a scenario: add the decision atom to the state, roll
// forward, and score by goals reached. Returns a list of
// [decision, outcome_state, score].
fn scenario_expand(ikg, state, decisions, goal_atoms, steps, min_confidence) {
    let scenarios = list_new()
    let i = 0
    while i < len(decisions) {
        let branch = img_state_of(state)
        img_state_add(branch, decisions[i])
        let outcome = forward_simulate(ikg, branch, steps, min_confidence)
        let sc = list_new()
        push(sc, decisions[i])
        push(sc, outcome)
        push(sc, _sc_goal_score(outcome, goal_atoms))
        push(scenarios, sc)
        i = i + 1
    }
    return scenarios
}

fn scenario_decision(s) { return s[SC_DECISION] }
fn scenario_outcome(s)  { return s[SC_OUTCOME] }
fn scenario_score(s)    { return s[SC_SCORE] }

// The highest-scoring scenario (0 if none).
fn scenario_best(scenarios) {
    if len(scenarios) == 0 { return 0 }
    let best = scenarios[0]
    let i = 1
    while i < len(scenarios) {
        if scenarios[i][SC_SCORE] > best[SC_SCORE] { best = scenarios[i] }
        i = i + 1
    }
    return best
}

// The lowest-scoring scenario (0 if none).
fn scenario_worst(scenarios) {
    if len(scenarios) == 0 { return 0 }
    let worst = scenarios[0]
    let i = 1
    while i < len(scenarios) {
        if scenarios[i][SC_SCORE] < worst[SC_SCORE] { worst = scenarios[i] }
        i = i + 1
    }
    return worst
}
