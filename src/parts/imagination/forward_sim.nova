// CrossEngin imagination: forward simulation.
//
// Purpose
//   Roll the substrate forward from the current situation using high-confidence
//   patterns to predict near-future states (ADR-0032 mode 1). Each step applies
//   the highest-confidence matching pattern above a confidence floor; the rolled
//   state feeds planning (ADR-0033) and predictions (ADR-0024). Bounded by a
//   step budget.
//
// ADRs implemented: ADR-0032 (forward simulation). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/imagination/imagination_engine.nova.

import "imagination_engine.nova"

// Would applying this pattern add at least one new atom to the state?
fn _fwd_productive(p, state) {
    let suc = pattern_successor(p)
    let i = 0
    while i < len(suc) {
        if contains(state, suc[i]) == 0 { return 1 }
        i = i + 1
    }
    return 0
}

// The highest-confidence matching, productive pattern at or above
// min_confidence (0 if none). Requiring productivity avoids re-firing an
// already-satisfied pattern on a confidence tie (which would stall the rollout).
fn fwd_best_pattern(ikg, state, min_confidence) {
    let pats = img_patterns(ikg)
    let best = 0
    let best_conf = 0 - 1
    let i = 0
    while i < len(pats) {
        if pattern_matches(pats[i], state) == 1 {
            if _fwd_productive(pats[i], state) == 1 {
                let conf = pattern_confidence(pats[i])
                if conf >= min_confidence {
                    if conf > best_conf {
                        best_conf = conf
                        best = pats[i]
                    }
                }
            }
        }
        i = i + 1
    }
    return best
}

// One forward step: apply the best matching pattern, or return the state
// unchanged if none applies.
fn forward_step(ikg, state, min_confidence) {
    let p = fwd_best_pattern(ikg, state, min_confidence)
    if p == 0 { return img_state_of(state) }
    return pattern_apply(p, state)
}

// Roll forward up to `steps` (stops early if a step changes nothing). Returns
// the final predicted state.
fn forward_simulate(ikg, state, steps, min_confidence) {
    let cur = img_state_of(state)
    let k = 0
    while k < steps {
        let nxt = forward_step(ikg, cur, min_confidence)
        if img_state_size(nxt) == img_state_size(cur) { k = steps }
        else { cur = nxt; k = k + 1 }
    }
    return cur
}
