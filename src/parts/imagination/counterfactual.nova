// CrossEngin imagination: counterfactual reasoning.
//
// Purpose
//   Clamp atoms to alternative values, re-simulate, and compare to the factual
//   trace for causal attribution (ADR-0032 mode 2). Given a state, a factual
//   forward simulation is compared against a counterfactual one in which an atom
//   is removed and/or another added; the divergence (symmetric difference of the
//   two outcomes) measures how much that change mattered.
//
// ADRs implemented: ADR-0032 (counterfactual). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/imagination/forward_sim.nova.

import "forward_sim.nova"

// A copy of state with remove_id removed (if present) and add_id added (if >= 0).
fn cf_clamp(state, remove_id, add_id) {
    let out = list_new()
    let i = 0
    while i < len(state) {
        if state[i] != remove_id { push(out, state[i]) }
        i = i + 1
    }
    if add_id >= 0 { img_state_add(out, add_id) }
    return out
}

// Symmetric-difference size between two states.
fn cf_divergence(a, b) {
    let d = 0
    let i = 0
    while i < len(a) {
        if contains(b, a[i]) == 0 { d = d + 1 }
        i = i + 1
    }
    let j = 0
    while j < len(b) {
        if contains(a, b[j]) == 0 { d = d + 1 }
        j = j + 1
    }
    return d
}

// Run factual vs counterfactual simulations and compare. Returns
// [factual_outcome, cf_outcome, divergence].
fn counterfactual(ikg, state, remove_id, add_id, steps, min_confidence) {
    let factual = forward_simulate(ikg, state, steps, min_confidence)
    let cf_state = cf_clamp(state, remove_id, add_id)
    let cf = forward_simulate(ikg, cf_state, steps, min_confidence)
    let out = list_new()
    push(out, factual)
    push(out, cf)
    push(out, cf_divergence(factual, cf))
    return out
}

fn cf_factual(r)    { return r[0] }
fn cf_outcome(r)    { return r[1] }
fn cf_divergence_of(r) { return r[2] }
