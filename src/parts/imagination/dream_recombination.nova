// CrossEngin imagination: dream recombination.
//
// Purpose
//   Low-constraint recombination of episodic fragments during deep idle
//   (ADR-0032 mode 3) -- the primary source of novel pattern atoms. Fragments
//   (each a set of atom ids from an episode) are blended into a new state, with
//   a creativity parameter controlling how much is pulled in; a discovered
//   (situation -> successor) recombination can be abstracted into a new pattern.
//   Deterministic given a seed (random_seed) so behavior is reproducible.
//
//   creativity is milli (0..1000): the per-atom inclusion probability when
//   recombining.
//
// ADRs implemented: ADR-0032 (dream recombination). NOVA dependencies: builtins
//   (random, random_seed). CrossEngin dependencies:
//   src/parts/imagination/imagination_engine.nova.

import "imagination_engine.nova"

// Recombine fragments (a list of states) into a new state: each atom of each
// fragment is included with probability `creativity`. Seeded for determinism.
fn dream_recombine(fragments, creativity, seed) {
    random_seed(seed)
    let out = img_state_new()
    let i = 0
    while i < len(fragments) {
        let frag = fragments[i]
        let j = 0
        while j < len(frag) {
            if random(1000) < creativity { img_state_add(out, frag[j]) }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Discover a novel pattern by taking the situation from one fragment and the
// successor from another, and abstracting it into the imagination KG. Returns
// the new pattern atom.
fn dream_discover(ikg, situation_fragment, successor_fragment, moment) {
    return pattern_abstract(ikg, situation_fragment, successor_fragment, moment)
}
