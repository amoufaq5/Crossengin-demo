// CrossEngin action: operand-tuple synthesizer for motor_map hits.
//
// Purpose
//   Phase R2 (ADR-0108) shipped `_with_payload` constructors for each
//   non-SPEAK intent kind (FILE, HTTP, CODE, MCP, AUDIO) but
//   `action_derive_intent` still minted verb-token-only intents via the
//   5-arg constructors -- motor_map hits were visible in the decision
//   log but fell through to `[EFF_SUSPENDED, -1]` because the required
//   operand slot was empty. Phase R3 (ADR-0109) closes the loop: on a
//   motor_map hit `action_derive_intent` calls
//   `operand_builder_build(eff_class, ctx, goal_id, sig, goal_name)` and
//   feeds the returned tuple into the matching `_with_payload`
//   constructor.
//
//   The operand sources are deliberately synthesized -- neither the
//   goal_engine atom (name + priority/deadline/progress only) nor the
//   loop_coordination ctx (AC_INPUT string + AC_ACTIVE int handles)
//   carries structured operands today. A real planner that materializes
//   operands from goal metadata / context inference is Phase R4+ work
//   (needs its own ADR; likely a goal-atom schema extension). The
//   placeholders below are good enough to drive each effector primitive
//   end-to-end so the Phase R arc is executable, not just a stub.
//
//   Conventions (ADR-0109 §Decision):
//     FILE  -> ["/tmp/ce_goal_<id>.txt", goal_name]
//     HTTP  -> ["http://localhost/goal_<id>", "goal:" + goal_name]
//     CODE  -> ["1 + <id>"]
//     MCP   -> ["goal_svc", "req:" + goal_name]
//     AUDIO -> ["/tmp/ce_speech_goal_<id>.wav"]
//     TOOL  -> []  (meta-dispatch -- action_submit resolves via in_effector_class)
//     INTERNAL -> [] (no operands)
//
// ADRs implemented: ADR-0109 (operand materialization, Phase R3).
// NOVA dependencies: builtins (int_to_str, string concat with `+`).
// CrossEngin dependencies: action_atoms.nova (EFF_CLASS_* constants).

import "action_atoms.nova"

// Build the operand tuple for `eff_class` using the module's sandbox-
// safe conventions. Returns a fresh `list_new()` populated with 0 to 2
// strings (one per positional operand slot of the matching
// `_with_payload` constructor). An empty return means the caller mints
// via the pre-R2 5-arg constructor (TOOL meta-dispatch and INTERNAL fall
// into this bucket -- `action_submit` resolves TOOL via
// `in_effector_class` and INTERNAL is a no-op).
//
// Parameters:
//   eff_class  int    -- EFF_CLASS_* from `motor_map_lookup`.
//   ctx        AgentContext or 0 -- unused by this round's synthesizer
//                        but passed in so the Phase R4 planner can
//                        read AC_ACTIVE / AC_CONCLUSIONS without a
//                        signature change.
//   goal_id    int    -- id attached to the intent (0 when no goal).
//   sig        string -- activation signature (handle-sig or
//                        semantic-sig). Not currently consumed; see
//                        ctx note.
//   goal_name  string -- the goal's name as the goal engine reports
//                        it; "" when no goal engine is wired or the
//                        id is unknown.
//
// NOVA quirks dodged:
//   * No raw `str_eq` on short literals -- string concat with `+` is
//     the pre-R2 trace-ref pattern (proven safe in
//     action_module.nova:301 and motor_map.nova:223).
//   * `int_to_str` on arbitrary ints is runtime-safe (R3d confirmed).
//   * No `type_of`, no `memcpy_raw`, no high-bit sentinel equality.
//   * `len(0)` dodged: callers pass `""` for `goal_name` (never 0)
//     when the goal lookup misses.
fn operand_builder_build(eff_class, ctx, goal_id, sig, goal_name) {
    let ops = list_new()
    let name = goal_name
    if name == 0 { name = "" }
    if eff_class == EFF_CLASS_FILE {
        push(ops, "/tmp/ce_goal_" + int_to_str(goal_id) + ".txt")
        push(ops, name)
        return ops
    }
    if eff_class == EFF_CLASS_HTTP {
        push(ops, "http://localhost/goal_" + int_to_str(goal_id))
        push(ops, "goal:" + name)
        return ops
    }
    if eff_class == EFF_CLASS_CODE {
        push(ops, "1 + " + int_to_str(goal_id))
        return ops
    }
    if eff_class == EFF_CLASS_MCP {
        push(ops, "goal_svc")
        push(ops, "req:" + name)
        return ops
    }
    if eff_class == EFF_CLASS_AUDIO {
        push(ops, "/tmp/ce_speech_goal_" + int_to_str(goal_id) + ".wav")
        return ops
    }
    // TOOL + INTERNAL + SPEAK: no synthesized operands. TOOL meta-dispatch
    // resolves via `in_effector_class` in `action_submit`; INTERNAL is a
    // no-op; SPEAK takes its text from the pre-R2 decision tree.
    return ops
}
