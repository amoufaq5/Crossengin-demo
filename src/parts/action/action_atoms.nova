// CrossEngin action: Intent record atom.
//
// Purpose
//   The Intent is the substrate-level exit surface for outgoing action
//   (ADR-0013, ADR-0041). Historically `src/agent/loop_action.nova`
//   inlined a three-branch template (writes one of "understood",
//   "i do not fully understand that yet", or "i have nothing to say"
//   straight to `ctx_output`) and never routed through
//   `src/io/effectors/effector_gate.nova` -- the README explicitly says
//   actions must pass the safety gate (ADR-0041), so that was a real
//   audit-trail gap. ADR-0093 (this round) introduces the `Intent`
//   record: a list-of-slots atom that captures kind (SPEAK / TOOL_CALL
//   / FILE_OP / HTTP_ACTION / CODE_EXEC / MCP / AUDIO / INTERNAL),
//   the phrase or payload text, the derived goal id (from the goal
//   engine), a confidence, the effector class the intent maps to, and
//   the source Percept id it was derived from -- one handle that the
//   downstream effector-gate submit can consume without a whole-ctx
//   scan.
//
//   The atom is deliberately dumb -- construction + accessors only.
//   The orchestration layer is `action_module.nova`; the effector
//   primitives remain at `src/io/effectors/*` (this file does NOT
//   re-implement any of them). Matches the atoms + module shape of
//   `src/parts/perception/perception_atoms.nova` (R1) and
//   `src/parts/reasoning/reasoning_atoms.nova`.
//
// ADRs implemented: ADR-0093 (action module, Phase N R2).
//   Governed by ADR-0013, ADR-0041, ADR-0043.
// NOVA dependencies: builtins.
// CrossEngin dependencies: none (Intent is a pure record;
//   the effector-class integers below are duplicated as small ints so
//   the atom module has no coupling to effector_gate at construction
//   time).

// ---- intent kind tag ------------------------------------------------------
//
// An Intent's `IN_KIND` field. Small integer enum so the substrate can
// branch on it in constant time without string comparison
// (`str_eq` is unreliable on short literals per ADR-0082 quirks).

let IN_KIND_SPEAK       = 1
let IN_KIND_TOOL_CALL   = 2
let IN_KIND_FILE_OP     = 3
let IN_KIND_HTTP_ACTION = 4
let IN_KIND_CODE_EXEC   = 5
let IN_KIND_MCP         = 6
let IN_KIND_AUDIO       = 7
let IN_KIND_INTERNAL    = 8

// Human-readable kind names, used by the trace + chat formatters.
// A missing / invalid kind returns "unknown"; never "" (a caller running
// `len(name)` on the empty string is fine, but preserving the perception
// module's convention keeps the two atoms visually parallel).
fn in_kind_name(k) {
    if k == IN_KIND_SPEAK       { return "speak" }
    if k == IN_KIND_TOOL_CALL   { return "tool_call" }
    if k == IN_KIND_FILE_OP     { return "file_op" }
    if k == IN_KIND_HTTP_ACTION { return "http_action" }
    if k == IN_KIND_CODE_EXEC   { return "code_exec" }
    if k == IN_KIND_MCP         { return "mcp" }
    if k == IN_KIND_AUDIO       { return "audio" }
    if k == IN_KIND_INTERNAL    { return "internal" }
    return "unknown"
}

// ---- effector class tag ---------------------------------------------------
//
// Effector classes are the coarse routing labels the module uses to pick
// an effector-gate submission path. They are intentionally distinct
// integers from `IN_KIND_*` so the two enums cannot be confused; the
// mapping is `in_kind_to_effector_class`.

let EFF_CLASS_INTERNAL = 0
let EFF_CLASS_SPEAK    = 1
let EFF_CLASS_TOOL     = 2
let EFF_CLASS_FILE     = 3
let EFF_CLASS_HTTP     = 4
let EFF_CLASS_CODE     = 5
let EFF_CLASS_MCP      = 6
let EFF_CLASS_AUDIO    = 7

fn in_effector_class_name(c) {
    if c == EFF_CLASS_SPEAK    { return "speak" }
    if c == EFF_CLASS_TOOL     { return "tool" }
    if c == EFF_CLASS_FILE     { return "file" }
    if c == EFF_CLASS_HTTP     { return "http" }
    if c == EFF_CLASS_CODE     { return "code" }
    if c == EFF_CLASS_MCP      { return "mcp" }
    if c == EFF_CLASS_AUDIO    { return "audio" }
    if c == EFF_CLASS_INTERNAL { return "internal" }
    return "unknown"
}

// Static mapping from an Intent kind to the effector class the gate
// should route it to. INTERNAL is a no-op action (used for the "nothing
// to say" branch) and maps to EFF_CLASS_INTERNAL so the module submit
// path short-circuits before touching the decision log.
fn in_kind_to_effector_class(k) {
    if k == IN_KIND_SPEAK       { return EFF_CLASS_SPEAK }
    if k == IN_KIND_TOOL_CALL   { return EFF_CLASS_TOOL }
    if k == IN_KIND_FILE_OP     { return EFF_CLASS_FILE }
    if k == IN_KIND_HTTP_ACTION { return EFF_CLASS_HTTP }
    if k == IN_KIND_CODE_EXEC   { return EFF_CLASS_CODE }
    if k == IN_KIND_MCP         { return EFF_CLASS_MCP }
    if k == IN_KIND_AUDIO       { return EFF_CLASS_AUDIO }
    if k == IN_KIND_INTERNAL    { return EFF_CLASS_INTERNAL }
    return EFF_CLASS_INTERNAL
}

// ---- Intent record layout -------------------------------------------------
//
// Shape (12 slots). The `IN_OBJ_TAG` sentinel lets a runtime type-check
// distinguish a real Intent from an ambient list; downstream code that
// receives an Intent as `0` (no intent produced) short-circuits before
// any accessor call.
//
//   [0]  IN_TAG              (IN_OBJ_TAG sentinel)
//   [1]  IN_TIMESTAMP_NS     (int; caller-supplied moment nanoseconds)
//   [2]  IN_KIND             (int; IN_KIND_*)
//   [3]  IN_TEXT             (string; the phrase or command payload; ""
//                                when unset)
//   [4]  IN_ROLE             (string; grammatical role or effector role,
//                                may be "")
//   [5]  IN_GOAL_ID          (int; from goal_arbitrate, 0 if no goal
//                                attached)
//   [6]  IN_CONFIDENCE_MILLI (int; 0..1000)
//   [7]  IN_SOURCE_PERCEPT_ID (int; the Percept the intent derived from,
//                                or 0 if none)
//   [8]  IN_EFFECTOR_CLASS   (int; EFF_CLASS_*, derived from IN_KIND at
//                                construction)
//   [9]  IN_LINKED_PERCEPT   (Percept or 0; cross-ref slot for R3
//                                reasoning tie-back)
//   [10] IN_TRACE_REF        (string; audit trail hint the effector_gate
//                                stores on the intent record)
//   [11] IN_REASON           (string; internal-intent reason payload,
//                                e.g. "nothing" for INTERNAL intents;
//                                reserved for tool-call arg summaries)
//
// Phase R2 payload-shim additions (ADR-0108). TAIL-APPENDED after
// IN_REASON to preserve the ADR-0093/ADR-0107 byte-identity contract
// on slots [0..11]. Each new slot defaults to "" (so the pre-R2 5-arg
// constructors still work; a R2-era `_with_payload` constructor
// populates the operands the matching effector primitive needs).
//
//   [12] IN_FILE_PATH        (string; sandboxed path for file_ops)
//   [13] IN_FILE_CONTENT     (string; file_ops_write body)
//   [14] IN_HTTP_URL         (string; outbound URL)
//   [15] IN_HTTP_CANNED      (string; pre-canned body for simulated=1)
//   [16] IN_CODE_EXPR        (string; arithmetic expression)
//   [17] IN_MCP_SERVICE      (string; MCP service name)
//   [18] IN_MCP_REQUEST      (string; MCP request body)
//   [19] IN_AUDIO_OUT_PATH   (string; wav output path for audio_speak)

let IN_OBJ_TAG = 9301

let IN_TAG               = 0
let IN_TIMESTAMP_NS      = 1
let IN_KIND              = 2
let IN_TEXT              = 3
let IN_ROLE              = 4
let IN_GOAL_ID           = 5
let IN_CONFIDENCE_MILLI  = 6
let IN_SOURCE_PERCEPT_ID = 7
let IN_EFFECTOR_CLASS    = 8
let IN_LINKED_PERCEPT    = 9
let IN_TRACE_REF         = 10
let IN_REASON            = 11
// Phase R2 payload slots (tail-appended; ADR-0108).
let IN_FILE_PATH         = 12
let IN_FILE_CONTENT      = 13
let IN_HTTP_URL          = 14
let IN_HTTP_CANNED       = 15
let IN_CODE_EXPR         = 16
let IN_MCP_SERVICE       = 17
let IN_MCP_REQUEST       = 18
let IN_AUDIO_OUT_PATH    = 19

let IN_SLOT_COUNT        = 20

fn _in_shell() {
    let i = list_new()
    push(i, IN_OBJ_TAG)     // [0]  tag
    push(i, 0)              // [1]  ts
    push(i, 0)              // [2]  kind
    push(i, "")             // [3]  text
    push(i, "")             // [4]  role
    push(i, 0)              // [5]  goal id
    push(i, 0)              // [6]  confidence
    push(i, 0)              // [7]  source percept id
    push(i, EFF_CLASS_INTERNAL)  // [8]  effector class
    push(i, 0)              // [9]  linked percept
    push(i, "")             // [10] trace ref
    push(i, "")             // [11] reason
    // Phase R2 payload-shim slots (ADR-0108). All default to "".
    push(i, "")             // [12] file path
    push(i, "")             // [13] file content
    push(i, "")             // [14] http url
    push(i, "")             // [15] http canned
    push(i, "")             // [16] code expr
    push(i, "")             // [17] mcp service
    push(i, "")             // [18] mcp request
    push(i, "")             // [19] audio out path
    return i
}

// ---- constructors ---------------------------------------------------------

// A SPEAK intent: the workhorse. `text` is the phrase to emit; `goal_id`
// is 0 when no goal is attached (the derive path passes 0 for the
// unknown / percept-only cases); `confidence_milli` is the caller's
// certainty; `source_percept_id` is the id of the Percept the intent
// was derived from (0 when there was no Percept, e.g. the ctx-only
// unknown path).
fn intent_speak_new(ts_ns, text, goal_id, confidence_milli, source_percept_id) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_SPEAK)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_SPEAK)
    return i
}

// An INTERNAL intent: no-op action, used for the pre-R2 "i have nothing
// to say" branch. Nothing is submitted to the effector gate for these;
// the decision log is untouched. `reason` is captured on IN_REASON for
// the trace; it is ALSO stored on IN_TEXT so a loop that emits
// `in_text(intent)` unconditionally reproduces the pre-R2 ctx_output
// text verbatim (byte-identity of the three loop_action fixtures is
// the R2 backwards-compat contract; see ADR-0093).
fn intent_internal_new(ts_ns, reason) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_INTERNAL)
    if reason != 0 { list_set(i, IN_REASON, reason) }
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_INTERNAL)
    // Emit-text mapping for INTERNAL: preserve the pre-R2 loop_action
    // template for the "nothing" branch so the R2 loop_action shim can
    // unconditionally write `in_text(intent)` and still produce
    // byte-identical output. Any other reason is written verbatim.
    if reason != 0 {
        if _in_reason_is_nothing(reason) == 1 {
            list_set(i, IN_TEXT, "i have nothing to say")
        } else {
            list_set(i, IN_TEXT, reason)
        }
    } else {
        list_set(i, IN_TEXT, "i have nothing to say")
    }
    return i
}

// Bytewise "nothing" check -- str_eq is unreliable on short literals so
// walk the bytes. Local to this module (unit-tested via the round-trip
// on the INTERNAL intent's IN_TEXT slot).
fn _in_reason_is_nothing(s) {
    if s == 0 { return 0 }
    if len(s) != 7 { return 0 }
    if char_at(s, 0) != char_at("nothing", 0) { return 0 }
    if char_at(s, 1) != char_at("nothing", 1) { return 0 }
    if char_at(s, 2) != char_at("nothing", 2) { return 0 }
    if char_at(s, 3) != char_at("nothing", 3) { return 0 }
    if char_at(s, 4) != char_at("nothing", 4) { return 0 }
    if char_at(s, 5) != char_at("nothing", 5) { return 0 }
    if char_at(s, 6) != char_at("nothing", 6) { return 0 }
    return 1
}

// A TOOL_CALL intent: placeholder for future rounds. `effector_class`
// lets the caller override the default mapping (e.g. a tool that
// resolves to a file_op through motor_map). The MVP module's submit
// path treats non-SPEAK non-INTERNAL kinds as EFF_SUSPENDED (see
// action_module.nova); this constructor is here so the record schema
// is fixed and the R3+ round can populate the motor map without
// changing the atom.
fn intent_tool_new(ts_ns, text, goal_id, confidence_milli, source_percept_id, effector_class) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_TOOL_CALL)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    if effector_class == 0 {
        list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_TOOL)
    } else {
        list_set(i, IN_EFFECTOR_CLASS, effector_class)
    }
    return i
}

// ---- Phase R1 placeholder constructors ------------------------------------
//
// FILE_OP / HTTP_ACTION / CODE_EXEC / AUDIO / MCP intents parallel
// `intent_tool_new` shape -- carry a text payload + goal_id. The MVP
// `action_submit` still routes non-SPEAK non-INTERNAL kinds to
// EFF_SUSPENDED (motor_map hits mint the intent in the decision log but
// do NOT execute). Phase R2 ships `src/io/effectors/{file,http,code,
// audio,mcp}.nova` and rewires `action_submit` to dispatch per class.
// See ADR-0107.
fn intent_file_new(ts_ns, text, goal_id, confidence_milli, source_percept_id) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_FILE_OP)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_FILE)
    return i
}

fn intent_http_new(ts_ns, text, goal_id, confidence_milli, source_percept_id) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_HTTP_ACTION)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_HTTP)
    return i
}

fn intent_code_new(ts_ns, text, goal_id, confidence_milli, source_percept_id) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_CODE_EXEC)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_CODE)
    return i
}

fn intent_audio_new(ts_ns, text, goal_id, confidence_milli, source_percept_id) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_AUDIO)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_AUDIO)
    return i
}

fn intent_mcp_new(ts_ns, text, goal_id, confidence_milli, source_percept_id) {
    let i = _in_shell()
    list_set(i, IN_TIMESTAMP_NS, ts_ns)
    list_set(i, IN_KIND, IN_KIND_MCP)
    if text != 0 { list_set(i, IN_TEXT, text) }
    list_set(i, IN_GOAL_ID, goal_id)
    list_set(i, IN_CONFIDENCE_MILLI, confidence_milli)
    list_set(i, IN_SOURCE_PERCEPT_ID, source_percept_id)
    list_set(i, IN_EFFECTOR_CLASS, EFF_CLASS_MCP)
    return i
}

// ---- Phase R2 payload-shim constructors (ADR-0108) -----------------------
//
// Parallel `_with_payload` constructors that populate the new operand
// slots. The 5-arg form continues to work (payload slots default to
// "" so operand-missing intents cleanly fall through to EFF_SUSPENDED
// in `action_submit`'s per-class dispatch). These exist so a dispatch-
// aware caller (planner / goal-engine, Phase R3) can mint executable
// intents without reaching inside the atom layout.

fn intent_file_new_with_payload(ts_ns, text, goal_id, confidence_milli, source_percept_id,
                                 path, content) {
    let i = intent_file_new(ts_ns, text, goal_id, confidence_milli, source_percept_id)
    if path != 0 { list_set(i, IN_FILE_PATH, path) }
    if content != 0 { list_set(i, IN_FILE_CONTENT, content) }
    return i
}

fn intent_http_new_with_payload(ts_ns, text, goal_id, confidence_milli, source_percept_id,
                                 url, canned) {
    let i = intent_http_new(ts_ns, text, goal_id, confidence_milli, source_percept_id)
    if url != 0 { list_set(i, IN_HTTP_URL, url) }
    if canned != 0 { list_set(i, IN_HTTP_CANNED, canned) }
    return i
}

fn intent_code_new_with_payload(ts_ns, text, goal_id, confidence_milli, source_percept_id,
                                 expr) {
    let i = intent_code_new(ts_ns, text, goal_id, confidence_milli, source_percept_id)
    if expr != 0 { list_set(i, IN_CODE_EXPR, expr) }
    return i
}

fn intent_mcp_new_with_payload(ts_ns, text, goal_id, confidence_milli, source_percept_id,
                                service, request) {
    let i = intent_mcp_new(ts_ns, text, goal_id, confidence_milli, source_percept_id)
    if service != 0 { list_set(i, IN_MCP_SERVICE, service) }
    if request != 0 { list_set(i, IN_MCP_REQUEST, request) }
    return i
}

fn intent_audio_new_with_payload(ts_ns, text, goal_id, confidence_milli, source_percept_id,
                                  out_path) {
    let i = intent_audio_new(ts_ns, text, goal_id, confidence_milli, source_percept_id)
    if out_path != 0 { list_set(i, IN_AUDIO_OUT_PATH, out_path) }
    return i
}

// ---- accessors ------------------------------------------------------------

fn in_is_intent(i) {
    if i == 0 { return 0 }
    if len(i) < 12 { return 0 }
    if i[IN_TAG] != IN_OBJ_TAG { return 0 }
    return 1
}

fn in_timestamp_ns(i)        { return i[IN_TIMESTAMP_NS] }
fn in_kind(i)                { return i[IN_KIND] }
fn in_text(i)                { return i[IN_TEXT] }
fn in_role(i)                { return i[IN_ROLE] }
fn in_goal_id(i)             { return i[IN_GOAL_ID] }
fn in_confidence(i)          { return i[IN_CONFIDENCE_MILLI] }
fn in_source_percept_id(i)   { return i[IN_SOURCE_PERCEPT_ID] }
fn in_effector_class(i)      { return i[IN_EFFECTOR_CLASS] }
fn in_linked_percept(i)      { return i[IN_LINKED_PERCEPT] }
fn in_trace_ref(i)           { return i[IN_TRACE_REF] }
fn in_reason(i)              { return i[IN_REASON] }

// ---- Phase R2 payload accessors (ADR-0108) -------------------------------
//
// Defensive length guards: a pre-R2 Intent (constructed via the 5-arg
// form before this ADR landed, or via a snapshot restore from an
// older-schema store) can have `len(i) < IN_SLOT_COUNT`. Return "" in
// that case rather than indexing past the tail.

fn in_file_path(i) {
    if i == 0 { return "" }
    if len(i) <= IN_FILE_PATH { return "" }
    return i[IN_FILE_PATH]
}

fn in_file_content(i) {
    if i == 0 { return "" }
    if len(i) <= IN_FILE_CONTENT { return "" }
    return i[IN_FILE_CONTENT]
}

fn in_http_url(i) {
    if i == 0 { return "" }
    if len(i) <= IN_HTTP_URL { return "" }
    return i[IN_HTTP_URL]
}

fn in_http_canned(i) {
    if i == 0 { return "" }
    if len(i) <= IN_HTTP_CANNED { return "" }
    return i[IN_HTTP_CANNED]
}

fn in_code_expr(i) {
    if i == 0 { return "" }
    if len(i) <= IN_CODE_EXPR { return "" }
    return i[IN_CODE_EXPR]
}

fn in_mcp_service(i) {
    if i == 0 { return "" }
    if len(i) <= IN_MCP_SERVICE { return "" }
    return i[IN_MCP_SERVICE]
}

fn in_mcp_request(i) {
    if i == 0 { return "" }
    if len(i) <= IN_MCP_REQUEST { return "" }
    return i[IN_MCP_REQUEST]
}

fn in_audio_out_path(i) {
    if i == 0 { return "" }
    if len(i) <= IN_AUDIO_OUT_PATH { return "" }
    return i[IN_AUDIO_OUT_PATH]
}

fn in_is_speak(i) {
    if i == 0 { return 0 }
    if i[IN_KIND] == IN_KIND_SPEAK { return 1 }
    return 0
}

fn in_is_internal(i) {
    if i == 0 { return 0 }
    if i[IN_KIND] == IN_KIND_INTERNAL { return 1 }
    return 0
}

// ---- setters (module-scope helpers) --------------------------------------
//
// The action module writes the trace ref + linked percept after
// construction (it needs the intent's own count-based trace string).
// The setters return 1 on success, 0 on a 0 handle -- same convention
// as `pc_set_*` in perception_atoms.

fn in_set_role(i, role) {
    if i == 0 { return 0 }
    if role == 0 { return 0 }
    list_set(i, IN_ROLE, role)
    return 1
}

fn in_set_linked_percept(i, p) {
    if i == 0 { return 0 }
    list_set(i, IN_LINKED_PERCEPT, p)
    return 1
}

fn in_set_trace_ref(i, s) {
    if i == 0 { return 0 }
    if s == 0 { return 0 }
    list_set(i, IN_TRACE_REF, s)
    return 1
}

// Convenience: human-readable one-liner. Used by the chat REPL /debug
// dump and the trace formatter. NOT a stable format -- callers that
// need structure should read the slots directly.
fn in_summary(i) {
    if in_is_intent(i) == 0 { return "<no intent>" }
    let kn = in_kind_name(in_kind(i))
    return "intent(kind=" + kn +
        ", conf=" + int_to_str(in_confidence(i)) +
        ", goal=" + int_to_str(in_goal_id(i)) + ")"
}
