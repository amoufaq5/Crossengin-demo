// CrossEngin action: substrate-activation -> effector-class registry.
//
// Purpose
//   The `motor_map` is the substrate's routing table between concept
//   activation patterns and effector classes. Today `action_module`'s
//   derive path only ever produces SPEAK or INTERNAL intents; the
//   README + ADR-0093 promise that future rounds will populate this
//   map so activation signatures matching, say, "search-then-fetch" or
//   "write-a-file" resolve to TOOL / FILE / HTTP effector classes and
//   the effector-gate submit path routes them through the appropriate
//   primitive.
//
//   The MVP ships the shell empty: a `motor_map_new()` returns a fresh
//   registry that reports size 0 and returns EFF_CLASS_INTERNAL on any
//   lookup. `motor_map_register(mm, activation_pattern_key, effector_class)`
//   grows the registry (a linear list of `[key, class]` pairs -- the
//   registry is expected to stay small; the map form would hit NOVA's
//   16-key builtin-map cap and adds no value here). `motor_map_lookup(mm,
//   activation_signature)` does an exact-string-match scan and returns
//   the registered class on hit, EFF_CLASS_INTERNAL on miss.
//
//   The action_module does NOT currently call `motor_map_lookup` --
//   the MVP's `action_derive_intent` picks a kind directly from ctx
//   state, and `action_submit` short-circuits non-SPEAK non-INTERNAL
//   kinds to EFF_SUSPENDED. A follow-up round wires the map into the
//   derive path (compute an activation signature from ctx.active +
//   goal, look up the effector class, mint the corresponding intent).
//
// ADRs implemented: ADR-0093 (action module, Phase N R2).
// NOVA dependencies: builtins.
// CrossEngin dependencies: action_atoms.nova (for EFF_CLASS_INTERNAL).

import "action_atoms.nova"

// ---- registry layout ------------------------------------------------------
//
// Shape (2 slots). The `MM_OBJ_TAG` sentinel lets a runtime type-check
// distinguish a real motor_map from an ambient list; downstream code
// that receives a 0 handle short-circuits before any accessor call.
//
//   [0]  MM_TAG      (MM_OBJ_TAG sentinel)
//   [1]  MM_ENTRIES  (list of [key_string, effector_class_int] pairs)

let MM_OBJ_TAG = 9302

let MM_TAG     = 0
let MM_ENTRIES = 1

fn motor_map_new() {
    let mm = list_new()
    push(mm, MM_OBJ_TAG)
    push(mm, list_new())
    return mm
}

fn mm_is_map(mm) {
    if mm == 0 { return 0 }
    if len(mm) < 2 { return 0 }
    if mm[MM_TAG] != MM_OBJ_TAG { return 0 }
    return 1
}

fn motor_map_size(mm) {
    if mm_is_map(mm) == 0 { return 0 }
    return len(mm[MM_ENTRIES])
}

// Bytewise string equality -- str_eq is unreliable on short literals
// (ADR-0082 quirks), so we walk char_at like ce_test does. Local so
// the registry has no test-framework dependency.
fn _mm_key_eq(a, b) {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    let na = len(a)
    if na != len(b) { return 0 }
    let i = 0
    while i < na {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Register an activation-pattern -> effector-class mapping. Duplicate
// keys OVERWRITE the previous class -- the registry is intended to be
// authoritative (a single canonical class per activation signature).
// Returns 1 on success, 0 on a bad handle.
fn motor_map_register(mm, activation_pattern_key, effector_class) {
    if mm_is_map(mm) == 0 { return 0 }
    if activation_pattern_key == 0 { return 0 }
    let entries = mm[MM_ENTRIES]
    let i = 0
    while i < len(entries) {
        if _mm_key_eq(entries[i][0], activation_pattern_key) == 1 {
            list_set(entries[i], 1, effector_class)
            return 1
        }
        i = i + 1
    }
    let entry = list_new()
    push(entry, activation_pattern_key)
    push(entry, effector_class)
    push(entries, entry)
    return 1
}

// Look up an activation signature. Returns the registered
// effector-class on exact-match hit, EFF_CLASS_INTERNAL on miss (the
// action_module's submit path treats EFF_CLASS_INTERNAL as a no-op,
// so an unregistered activation defaults to "do nothing" -- safer
// than defaulting to an arbitrary effector).
fn motor_map_lookup(mm, activation_signature) {
    if mm_is_map(mm) == 0 { return EFF_CLASS_INTERNAL }
    if activation_signature == 0 { return EFF_CLASS_INTERNAL }
    let entries = mm[MM_ENTRIES]
    let i = 0
    while i < len(entries) {
        if _mm_key_eq(entries[i][0], activation_signature) == 1 {
            return entries[i][1]
        }
        i = i + 1
    }
    return EFF_CLASS_INTERNAL
}

// Enumerate keys -- returned as a fresh list of strings. Used by the
// R3+ diagnostic dump and by tests. Order is insertion order (the
// list is walked front-to-back).
fn motor_map_keys(mm) {
    let out = list_new()
    if mm_is_map(mm) == 0 { return out }
    let entries = mm[MM_ENTRIES]
    let i = 0
    while i < len(entries) {
        push(out, entries[i][0])
        i = i + 1
    }
    return out
}

// Enumerate `[key, class]` pairs -- fresh list of fresh pairs (so a
// mutation on the returned list does not corrupt the registry).
fn motor_map_entries(mm) {
    let out = list_new()
    if mm_is_map(mm) == 0 { return out }
    let entries = mm[MM_ENTRIES]
    let i = 0
    while i < len(entries) {
        let pair = list_new()
        push(pair, entries[i][0])
        push(pair, entries[i][1])
        push(out, pair)
        i = i + 1
    }
    return out
}

// Remove a registration by key. Returns 1 if a key was removed, 0
// otherwise. Used by tests / future admin commands.
fn motor_map_unregister(mm, key) {
    if mm_is_map(mm) == 0 { return 0 }
    if key == 0 { return 0 }
    let entries = mm[MM_ENTRIES]
    let rebuilt = list_new()
    let removed = 0
    let i = 0
    while i < len(entries) {
        if _mm_key_eq(entries[i][0], key) == 1 {
            removed = 1
        } else {
            push(rebuilt, entries[i])
        }
        i = i + 1
    }
    if removed == 1 { list_set(mm, MM_ENTRIES, rebuilt) }
    return removed
}

// ---- Phase R1 additions --------------------------------------------------
//
// `motor_map_default` returns a `motor_map_new()` pre-registered with the
// canonical pre-R2 vocabulary. These strings are the activation-signature
// keys the derive path produces via `mm_activation_signature` -- see
// ADR-0107. Keep this list in sync with the EFF_CLASS_* vocabulary in
// `action_atoms.nova`; new effector classes get a representative key here
// as part of landing their primitive.
//
// Non-goal (R1): the mapping is NOT exhaustive and not meant to be --
// Phase R2 ships the effector primitives and expands the vocabulary.
fn motor_map_default() {
    let mm = motor_map_new()
    motor_map_register(mm, "search_the_web",  EFF_CLASS_HTTP)
    motor_map_register(mm, "fetch_url",       EFF_CLASS_HTTP)
    motor_map_register(mm, "write_a_note",    EFF_CLASS_FILE)
    motor_map_register(mm, "read_file",       EFF_CLASS_FILE)
    motor_map_register(mm, "call_tool",       EFF_CLASS_TOOL)
    motor_map_register(mm, "run_code",        EFF_CLASS_CODE)
    motor_map_register(mm, "play_audio",      EFF_CLASS_AUDIO)
    motor_map_register(mm, "synth_audio",     EFF_CLASS_AUDIO)
    motor_map_register(mm, "invoke_mcp",      EFF_CLASS_MCP)
    return mm
}

// `mm_activation_signature` canonicalizes a (ctx, goal_id) pair into a
// deterministic lookup key for `motor_map_lookup`. Starting shape is
// deliberately simple: a goal-id prefix joined with the active-concept
// token list (if any). The derive path emits the same bytes a seeded
// `motor_map_default` entry would, so a matching ctx hits the registry.
//
// Shape: "g<goal_id>:a<active0>:a<active1>:..." when ctx carries active
// concept handles (ints). When ctx is 0 or carries no active list, the
// signature degrades to "g<goal_id>" (empty-ctx fall-through). This is
// NOT a hashed signature -- a hashed variant is deferred (see ADR-0107
// Follow-up).
//
// NOVA quirks dodged:
//   * `len(0)` segfaults -- guard with explicit 0-check before `len`.
//   * `str_eq` on short literals is flaky -- not used here (int_to_str
//     + `+` is the pre-R2 trace pattern, already proven safe in
//     action_module.nova:249).
//   * No raw `type_of` on dynamic values.
fn mm_activation_signature(ctx, goal_id) {
    let sig = "g" + int_to_str(goal_id)
    if ctx == 0 { return sig }
    // ctx carries active-concept handles at AC_ACTIVE (slot 5 per
    // loop_coordination.nova). Read positionally rather than importing
    // the AC_* constants here -- motor_map is a leaf module and must
    // not depend on the coordination atom's import surface.
    if len(ctx) < 6 { return sig }
    let active = ctx[5]
    if active == 0 { return sig }
    let n = len(active)
    let i = 0
    while i < n {
        sig = sig + ":a" + int_to_str(active[i])
        i = i + 1
    }
    return sig
}

// `mm_activation_signature_by_name` is the Phase R3 (ADR-0109) parallel
// signature path: it returns the goal name verbatim as the lookup key,
// so a goal named "write_a_note" hits `motor_map_default`'s FILE entry
// directly. The ctx-driven `mm_activation_signature` builds a handle-
// sig ("g<id>:a<h0>:...") which never overlaps the semantic strings in
// `motor_map_default` -- hits are only reachable through this bridge
// until Phase R4+ ships a planner that normalizes the two namespaces.
//
// Dumb and deterministic: exact-string match handoff. If the caller
// wants lowercase-normalization or stemming, that is a planner-layer
// concern -- the registry's keys are canonical here.
fn mm_activation_signature_by_name(goal_name) {
    if goal_name == 0 { return "" }
    return goal_name
}
