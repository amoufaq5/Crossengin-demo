// CrossEngin action: per-goal operand-template registry.
//
// Purpose
//   Phase R3 (ADR-0109) shipped `operand_builder.nova` which synthesizes
//   per-class operand tuples via sandbox-safe conventions:
//     FILE  -> ["/tmp/ce_goal_<id>.txt", goal_name]
//     CODE  -> ["1 + <id>"]
//     ...
//   These placeholders execute end-to-end but have no semantic content --
//   every FILE intent writes to the same conventional path, every CODE
//   intent runs the same trivial arithmetic. Phase R4 (ADR-0112) replaces
//   that convention with a `goal_templates` registry: a map keyed by
//   goal_name whose values are per-goal operand templates (with `%ID%` /
//   `%NAME%` placeholders expanded at derive time).
//
//   The registry mirrors `motor_map.nova:35-124`'s pattern byte-for-byte:
//   a 2-slot handle `[GT_OBJ_TAG, list_new()]`; entries are
//   `[goal_name_key, template_list]` pairs; a linear-scan lookup / upsert
//   / unregister trio with the sandbox-safe `_gt_key_eq` byte-walker
//   (dodges UPSTREAM §1 short-literal `str_eq` flakiness). Templates are
//   list-of-strings; the first slot is the eff_class tag ("file" /
//   "code" / ...) so `operand_builder_build` can confirm the registry
//   entry matches the dispatched class before expansion.
//
//   `goal_templates_expand(template, goal_id, goal_name)` returns a
//   fresh `list_new()` rebuilt with `%ID%` -> `int_to_str(goal_id)` and
//   `%NAME%` -> `goal_name`. The caller strips the eff_class tag before
//   expansion so the returned tuple matches `operand_builder`'s R3
//   convention shapes.
//
//   `goal_templates_default()` seeds two entries for Phase R4 (FILE +
//   CODE):
//     "write_a_note" -> ["file", "/tmp/ce_note_%ID%.txt", "%NAME%"]
//     "run_code"     -> ["code", "1 + %ID%"]
//   HTTP / MCP / AUDIO keep the R3 convention fallback until a later
//   round picks a `%URL%` / `%SERVICE%` placeholder vocabulary.
//
//   On a registry miss (or when the caller passes `0` for the templates
//   handle), `operand_builder_build` falls through to the R3 convention
//   -- byte-identity preserved for every existing caller.
//
// ADRs implemented: ADR-0112 (goal-template registry, Phase R4).
// NOVA dependencies: builtins (int_to_str, string concat, char_at).
// CrossEngin dependencies: none (leaf module; constants are local).

// ---- registry layout ------------------------------------------------------
//
// Shape (2 slots). `GT_OBJ_TAG` is the next free sentinel in the 930x
// family after motor_map's 9302 and action_module's 9303. The constant
// name is `GT_`-prefixed to dodge the UPSTREAM §9/§10 collision class
// (duplicate module-level `let` symbol names across the import graph).
//
//   [0]  GT_TAG      (GT_OBJ_TAG sentinel)
//   [1]  GT_ENTRIES  (list of [goal_name_key, template_list] pairs)

let GT_OBJ_TAG = 9304

let GT_TAG     = 0
let GT_ENTRIES = 1

fn goal_templates_new() {
    let gt = list_new()
    push(gt, GT_OBJ_TAG)
    push(gt, list_new())
    return gt
}

fn gt_is_map(gt) {
    if gt == 0 { return 0 }
    if len(gt) < 2 { return 0 }
    if gt[GT_TAG] != GT_OBJ_TAG { return 0 }
    return 1
}

fn goal_templates_size(gt) {
    if gt_is_map(gt) == 0 { return 0 }
    return len(gt[GT_ENTRIES])
}

// Bytewise string equality -- verbatim copy of `motor_map.nova:71-82`.
// Local so the registry has no test-framework dependency and dodges
// UPSTREAM §1 (`str_eq` on short literals is unreliable).
fn _gt_key_eq(a, b) {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    let na = len(a)
    if na != len(b) { return 0 }
    let i = 0
    while i < na {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Register a goal_name -> operand_template mapping. Duplicate keys
// OVERWRITE the previous template (parallels `motor_map_register`'s
// upsert semantics). Returns 1 on success, 0 on a bad handle / null key.
fn goal_templates_register(gt, goal_name_key, template) {
    if gt_is_map(gt) == 0 { return 0 }
    if goal_name_key == 0 { return 0 }
    let entries = gt[GT_ENTRIES]
    let i = 0
    while i < len(entries) {
        if _gt_key_eq(entries[i][0], goal_name_key) == 1 {
            list_set(entries[i], 1, template)
            return 1
        }
        i = i + 1
    }
    let entry = list_new()
    push(entry, goal_name_key)
    push(entry, template)
    push(entries, entry)
    return 1
}

// Look up a goal_name. Returns the stored template list on exact match,
// `0` on miss. Callers inspect the first slot's eff_class tag to
// disambiguate (the registry is cross-class; a `"write_a_note"` entry
// is tagged `"file"`).
fn goal_templates_lookup(gt, goal_name) {
    if gt_is_map(gt) == 0 { return 0 }
    if goal_name == 0 { return 0 }
    let entries = gt[GT_ENTRIES]
    let i = 0
    while i < len(entries) {
        if _gt_key_eq(entries[i][0], goal_name) == 1 {
            return entries[i][1]
        }
        i = i + 1
    }
    return 0
}

// Expand `%ID%` and `%NAME%` placeholders in each template slot.
// Returns a fresh `list_new()` with the substituted strings; the
// caller passes `template` already stripped of its eff_class tag
// (slice `[1..]`) so the shape matches `operand_builder`'s R3
// convention tuples. `goal_name == 0` degrades to the empty string.
//
// Substitution is literal: a template slot `"/tmp/ce_note_%ID%.txt"`
// becomes `"/tmp/ce_note_7.txt"` with `goal_id=7`; a template slot
// `"%NAME%"` becomes `goal_name` verbatim. Slots without a placeholder
// are copied through unchanged.
//
// NOVA quirks dodged:
//   * `len(0)` guarded with `== 0` first.
//   * No `str_eq` on short literals; char-at walker + concat-build.
//   * `int_to_str` is runtime-safe (R3d confirmed; see
//     operand_builder.nova:66).
fn goal_templates_expand(template, goal_id, goal_name) {
    let out = list_new()
    if template == 0 { return out }
    let name = goal_name
    if name == 0 { name = "" }
    let id_str = int_to_str(goal_id)
    let n = len(template)
    let i = 0
    while i < n {
        let slot = template[i]
        let built = _gt_substitute(slot, id_str, name)
        push(out, built)
        i = i + 1
    }
    return out
}

// Walk one template string and emit a fresh string with `%ID%` and
// `%NAME%` substrings replaced by `id_str` / `name` respectively.
// Pure byte-walk; no `str_eq`.
fn _gt_substitute(slot, id_str, name) {
    if slot == 0 { return "" }
    let m = len(slot)
    let out = ""
    let i = 0
    while i < m {
        // Check for "%ID%" at position i (4 chars).
        if i + 4 <= m {
            if char_at(slot, i) == 37 {
                if char_at(slot, i + 1) == 73 {
                    if char_at(slot, i + 2) == 68 {
                        if char_at(slot, i + 3) == 37 {
                            out = out + id_str
                            i = i + 4
                            continue
                        }
                    }
                }
            }
        }
        // Check for "%NAME%" at position i (6 chars).
        if i + 6 <= m {
            if char_at(slot, i) == 37 {
                if char_at(slot, i + 1) == 78 {
                    if char_at(slot, i + 2) == 65 {
                        if char_at(slot, i + 3) == 77 {
                            if char_at(slot, i + 4) == 69 {
                                if char_at(slot, i + 5) == 37 {
                                    out = out + name
                                    i = i + 6
                                    continue
                                }
                            }
                        }
                    }
                }
            }
        }
        // Plain char: copy one byte through via substr (safe byte-walker).
        out = out + substr(slot, i, 1)
        i = i + 1
    }
    return out
}

// `goal_templates_default` returns a `goal_templates_new()` pre-registered
// with the Phase R4 seed vocabulary. Covers FILE + CODE; HTTP/MCP/AUDIO
// stay on R3 convention fallback until a `%URL%` / `%SERVICE%`
// placeholder vocabulary ADR lands. Templates: first slot is the
// eff_class tag so `operand_builder` can match-and-skip in one pass.
fn goal_templates_default() {
    let gt = goal_templates_new()

    let t_file = list_new()
    push(t_file, "file")
    push(t_file, "/tmp/ce_note_%ID%.txt")
    push(t_file, "%NAME%")
    goal_templates_register(gt, "write_a_note", t_file)

    let t_code = list_new()
    push(t_code, "code")
    push(t_code, "1 + %ID%")
    goal_templates_register(gt, "run_code", t_code)

    return gt
}
