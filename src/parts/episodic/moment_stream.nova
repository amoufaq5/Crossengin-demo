// CrossEngin episodic: moments and the moment stream.
//
// Purpose
//   A moment is a timestamped perception record -- the entry point for every
//   input (ADR-0021). Moments are captured at the gate boundary before any node
//   sees them, accumulate a signal trace as they propagate, and advance through
//   a status lifecycle PERCEIVED -> SETTLED -> CONSOLIDATED. They are
//   append-only and immutable once SETTLED; corrections arrive as new INTERNAL
//   moments rather than mutations. The moment stream is the append-only log the
//   episodic memory (ADR-0022) and learning fabric (ADR-0025) build on.
//
//   Timestamps are logical tick indices supplied by the caller (the 100Hz
//   wall-clock pacer is NOVA enhancement #5); the stream enforces monotonicity.
//
// ADRs implemented: ADR-0021 (moments). ADR-0014: a modality bridge fills only
//   the raw field; no cognition here.
// NOVA dependencies: builtins (lists, str ops). CrossEngin dependencies: none.

// ---- modality (ADR-0021) --------------------------------------------------
let MODALITY_TEXT     = 1
let MODALITY_AUDIO_STT= 2
let MODALITY_SENSOR   = 3
let MODALITY_CLOCK    = 4
let MODALITY_FETCH    = 5
let MODALITY_INTERNAL = 6

// ---- status lifecycle -----------------------------------------------------
let MSTAT_PERCEIVED    = 1
let MSTAT_SETTLED      = 2
let MSTAT_CONSOLIDATED = 3

// ---- moment layout --------------------------------------------------------
let M_TAG     = 0
let M_ID      = 1
let M_TS      = 2
let M_MODAL   = 3
let M_RAW     = 4
let M_SAL     = 5
let M_ORIGIN  = 6
let M_TRACE   = 7   // list of node ids the input reached
let M_SOULREF = 8
let M_STATUS  = 9
let MOMENT_OBJ_TAG = 2201

fn _moment_new(id, ts, modality, raw, salience, origin_part) {
    let m = list_new()
    push(m, MOMENT_OBJ_TAG)
    push(m, id)
    push(m, ts)
    push(m, modality)
    push(m, raw)
    push(m, salience)
    push(m, origin_part)
    push(m, list_new())   // trace
    push(m, 0)            // soul_ref
    push(m, MSTAT_PERCEIVED)
    return m
}

fn moment_id(m)        { return m[M_ID] }
fn moment_timestamp(m) { return m[M_TS] }
fn moment_modality(m)  { return m[M_MODAL] }
fn moment_raw(m)       { return m[M_RAW] }
fn moment_salience(m)  { return m[M_SAL] }
fn moment_origin(m)    { return m[M_ORIGIN] }
fn moment_trace(m)     { return m[M_TRACE] }
fn moment_status(m)    { return m[M_STATUS] }
fn moment_is_immutable(m) {
    if m[M_STATUS] >= MSTAT_SETTLED { return 1 }
    return 0
}

// Append a node id to the signal trace -- only while still PERCEIVED.
fn moment_add_trace(m, node_id) {
    if moment_is_immutable(m) == 1 { return 0 }
    push(m[M_TRACE], node_id)
    return 1
}

fn moment_set_soul_ref(m, ref) {
    if moment_is_immutable(m) == 1 { return 0 }
    list_set(m, M_SOULREF, ref)
    return 1
}

// Status may only advance (PERCEIVED -> SETTLED -> CONSOLIDATED). Returns 1 on a
// valid advance, 0 otherwise.
fn moment_set_status(m, status) {
    if status <= m[M_STATUS] { return 0 }
    list_set(m, M_STATUS, status)
    return 1
}

fn moment_settle(m)      { return moment_set_status(m, MSTAT_SETTLED) }
fn moment_consolidate(m) { return moment_set_status(m, MSTAT_CONSOLIDATED) }

// ---- the append-only moment stream ----------------------------------------
let MS_TAG    = 0
let MS_LIST   = 1   // moments indexed by id
let MS_NEXT   = 2
let MS_LASTTS = 3   // last timestamp, for monotonicity
let MS_OBJ_TAG = 2202

fn ms_new() {
    let s = list_new()
    push(s, MS_OBJ_TAG)
    push(s, list_new())
    push(s, 0)
    push(s, -1)
    return s
}

// Capture a new moment at logical timestamp `ts` (clamped to be monotonic).
// Assigns the next id and appends. Returns the moment.
fn ms_capture(stream, ts, modality, raw, salience, origin_part) {
    let t = ts
    if t < stream[MS_LASTTS] { t = stream[MS_LASTTS] }
    let id = stream[MS_NEXT]
    let m = _moment_new(id, t, modality, raw, salience, origin_part)
    push(stream[MS_LIST], m)
    list_set(stream, MS_NEXT, id + 1)
    list_set(stream, MS_LASTTS, t)
    return m
}

fn ms_count(stream) { return len(stream[MS_LIST]) }

fn ms_get(stream, id) {
    let l = stream[MS_LIST]
    if id < 0 { return 0 }
    if id >= len(l) { return 0 }
    return l[id]
}

// The most recent n moments (fewer if the stream is shorter), oldest-first.
fn ms_recent(stream, n) {
    let l = stream[MS_LIST]
    let total = len(l)
    let start = total - n
    if start < 0 { start = 0 }
    let out = list_new()
    let i = start
    while i < total { push(out, l[i]); i = i + 1 }
    return out
}

// Settle every moment older than the settle window (ADR-0021: 20 ticks @100Hz).
let MS_SETTLE_WINDOW = 20

fn ms_settle_old(stream, now) {
    let l = stream[MS_LIST]
    let settled = 0
    let i = 0
    while i < len(l) {
        let m = l[i]
        if moment_status(m) == MSTAT_PERCEIVED {
            if now - moment_timestamp(m) >= MS_SETTLE_WINDOW {
                moment_settle(m)
                settled = settled + 1
            }
        }
        i = i + 1
    }
    return settled
}
