// CrossEngin Phase 0 pt4: moment cache.
//
// Purpose
//   A fixed-capacity LRU cache keyed by an HDC hypervector of the
//   current moment (the percept-derived bundle). On a chat turn, if the
//   moment's HDC vector is near-identical (cosine >= threshold milli,
//   default 900) to a cached entry, we short-circuit and return that
//   entry's (reply, trace, ops_csv). Otherwise router_reply runs and
//   its result is stored.
//
//   Why: the frequency-adaptive-latency property pt1+pt2 proved on
//   synapse weights is a per-edge speed-up inside the forward chain.
//   The moment cache is a per-utterance jump-to-attractor: a question
//   the user asked a second ago doesn't need to walk any chain.
//   /good / /bad still fire against the surviving ops_csv so the
//   underlying synapse graph still reinforces on cache-hit turns.
//
// NOVA dependencies: builtins (list_new, push, len, list_set,
//   list_remove_at).
// CrossEngin dependencies: src/kg/hdc_embed.nova (hdc_cosine).

import "std/io"
import "std/string"
import "std/syscall"
import "../../kg/hdc_embed.nova"
import "../../util/list_safe.nova"

let MC_TAG    = 0
let MC_CAP    = 1
let MC_VECS   = 2   // list<hdc_vec>
let MC_REPLY  = 3   // list<str>
let MC_TRACE  = 4   // list<str>
let MC_OPS    = 5   // list<str>  (CSV)
let MC_HITS   = 6   // int
let MC_MISS   = 7   // int
let MC_CACHE_TAG = 772

let MC_DEFAULT_CAP = 1024
let MC_DEFAULT_THRESHOLD = 900   // milli: tight match only

fn mc_new(cap) {
    let c = list_new()
    push(c, MC_CACHE_TAG)
    let want = cap
    if want <= 0 { want = MC_DEFAULT_CAP }
    push(c, want)
    push(c, list_new())
    push(c, list_new())
    push(c, list_new())
    push(c, list_new())
    push(c, 0)
    push(c, 0)
    return c
}

fn mc_count(c)  { return len(c[MC_VECS]) }
fn mc_cap(c)    { return c[MC_CAP] }
fn mc_hits(c)   { return c[MC_HITS] }
fn mc_misses(c) { return c[MC_MISS] }

// Returns the default threshold so callers can parametrise with a stable
// name.
fn mc_default_threshold() { return MC_DEFAULT_THRESHOLD }

// Lookup. On a cosine match >= threshold, bumps that entry to the
// front (recency) and returns [reply, trace, ops]. On miss, bumps the
// miss counter and returns 0.
fn mc_lookup(c, mv, threshold_milli) {
    let vecs = c[MC_VECS]
    let n = len(vecs)
    let i = 0
    let hit_idx = -1
    while i < n {
        let cos = hdc_cosine(vecs[i], mv)
        if cos >= threshold_milli {
            hit_idx = i
            i = n
        } else {
            i = i + 1
        }
    }
    if hit_idx == -1 {
        list_set(c, MC_MISS, c[MC_MISS] + 1)
        return 0
    }
    let out = list_new()
    push(out, c[MC_REPLY][hit_idx])
    push(out, c[MC_TRACE][hit_idx])
    push(out, c[MC_OPS][hit_idx])
    _mc_bump_front(c, hit_idx)
    list_set(c, MC_HITS, c[MC_HITS] + 1)
    return out
}

// Store a fresh entry at the front. Evicts the tail (least recent) if
// the cache is at cap. No dedup against existing entries — the lookup
// path already short-circuits near-identical queries, so a store here
// means we did miss, and keeping distinct entries is desirable.
fn mc_store(c, mv, reply, trace, ops) {
    let n = len(c[MC_VECS])
    if n >= c[MC_CAP] { _mc_evict_tail(c) }
    // Insert at position 0 (front = most-recent).
    _mc_insert_front(c, mv, reply, trace, ops)
    return 1
}

fn _mc_insert_front(c, mv, reply, trace, ops) {
    // Push to tail then rotate the tail to the front. NOVA lists don't
    // have an O(1) list_prepend; the slow path is fine at MC_CAP=1024.
    push(c[MC_VECS],  mv)
    push(c[MC_REPLY], reply)
    push(c[MC_TRACE], trace)
    push(c[MC_OPS],   ops)
    let n = len(c[MC_VECS])
    if n > 1 {
        _mc_bump_front(c, n - 1)
    }
    return 1
}

fn _mc_bump_front(c, idx) {
    if idx <= 0 { return 1 }
    let v  = c[MC_VECS][idx]
    let r  = c[MC_REPLY][idx]
    let t  = c[MC_TRACE][idx]
    let o  = c[MC_OPS][idx]
    list_remove_at(c[MC_VECS],  idx)
    list_remove_at(c[MC_REPLY], idx)
    list_remove_at(c[MC_TRACE], idx)
    list_remove_at(c[MC_OPS],   idx)
    // Re-insert at head by shifting right.
    push(c[MC_VECS],  0)
    push(c[MC_REPLY], "")
    push(c[MC_TRACE], "")
    push(c[MC_OPS],   "")
    let n = len(c[MC_VECS])
    let i = n - 1
    while i > 0 {
        list_set(c[MC_VECS],  i, c[MC_VECS][i - 1])
        list_set(c[MC_REPLY], i, c[MC_REPLY][i - 1])
        list_set(c[MC_TRACE], i, c[MC_TRACE][i - 1])
        list_set(c[MC_OPS],   i, c[MC_OPS][i - 1])
        i = i - 1
    }
    list_set(c[MC_VECS],  0, v)
    list_set(c[MC_REPLY], 0, r)
    list_set(c[MC_TRACE], 0, t)
    list_set(c[MC_OPS],   0, o)
    return 1
}

fn _mc_evict_tail(c) {
    let n = len(c[MC_VECS])
    if n == 0 { return 0 }
    list_remove_at(c[MC_VECS],  n - 1)
    list_remove_at(c[MC_REPLY], n - 1)
    list_remove_at(c[MC_TRACE], n - 1)
    list_remove_at(c[MC_OPS],   n - 1)
    return 1
}
