// CrossEngin episodic: episode storage.
//
// Purpose
//   Episodic memory over the moment stream (ADR-0022). Each episode references
//   an immutable moment (ADR-0021) and carries a decaying strength. Episodes
//   live in three tiers -- recent (in-memory ring), archived, consolidated --
//   decay geometrically, are reinforced on successful recall, and are dropped
//   when their strength falls below a floor (unless consolidated). Replay
//   sampling favors strong, salient episodes.
//
//   Strength is integer milli (1.0 == 1000); decay is the geometric
//   discretization of ADR-0022's exp(-dt/tau) (caller passes a per-step
//   retention factor derived from dt/tau; emotionally-tagged episodes use a
//   higher retention).
//
// ADRs implemented: ADR-0022 (episodic memory). ADR-0021: references moments by
//   id. Replay during idle is NOVA enhancement #13.
// NOVA dependencies: builtins. CrossEngin dependencies: none (moments referenced
//   by id).

// ---- tiers ----------------------------------------------------------------
let EP_DROPPED      = 0
let EP_RECENT       = 1
let EP_ARCHIVED     = 2
let EP_CONSOLIDATED = 3

// ---- tuning (milli) -------------------------------------------------------
let EP_SCALE         = 1000
let EP_STRENGTH_INIT = 1000   // 1.0 on creation
let EP_REINFORCE     = 300    // +0.3 on recall
let EP_DROP          = 50     // drop below 0.05
let EM_RECENT_CAP    = 4096   // recent ring capacity (oldest archived past this)

// ---- episode layout -------------------------------------------------------
let E_TAG     = 0
let E_ID      = 1
let E_MOMENT  = 2   // moment id (ADR-0021)
let E_SAL     = 3
let E_LASTACC = 4
let E_STRENGTH= 5
let E_TIER    = 6
let EP_OBJ_TAG = 2401

fn _episode_new(id, moment_ref, salience, now) {
    let e = list_new()
    push(e, EP_OBJ_TAG)
    push(e, id)
    push(e, moment_ref)
    push(e, salience)
    push(e, now)
    push(e, EP_STRENGTH_INIT)
    push(e, EP_RECENT)
    return e
}

fn episode_id(e)          { return e[E_ID] }
fn episode_moment(e)      { return e[E_MOMENT] }
fn episode_salience(e)    { return e[E_SAL] }
fn episode_last_access(e) { return e[E_LASTACC] }
fn episode_strength(e)    { return e[E_STRENGTH] }
fn episode_tier(e)        { return e[E_TIER] }

// Geometric decay: strength *= retain (one step).
fn episode_decay(e, retain_milli) {
    list_set(e, E_STRENGTH, e[E_STRENGTH] * retain_milli / EP_SCALE)
    return e[E_STRENGTH]
}

// Reinforce on recall: +0.3 capped at 1.0; refresh last-access.
fn episode_reinforce(e, now) {
    let s = e[E_STRENGTH] + EP_REINFORCE
    if s > EP_SCALE { s = EP_SCALE }
    list_set(e, E_STRENGTH, s)
    list_set(e, E_LASTACC, now)
    return s
}

// Drop candidate: weak and not consolidated.
fn episode_should_drop(e) {
    if e[E_TIER] == EP_CONSOLIDATED { return 0 }
    if e[E_TIER] == EP_DROPPED { return 0 }
    if e[E_STRENGTH] < EP_DROP { return 1 }
    return 0
}

// ---- episodic memory store ------------------------------------------------
let EM_TAG  = 0
let EM_EPS  = 1   // episodes indexed by id
let EM_NEXT = 2
let EM_OBJ_TAG = 2402

fn em_new() {
    let em = list_new()
    push(em, EM_OBJ_TAG)
    push(em, list_new())
    push(em, 0)
    return em
}

// Record a new recent episode for a moment. If the recent ring is over
// capacity, the oldest recent episode is archived.
fn em_record(em, moment_ref, salience, now) {
    let id = em[EM_NEXT]
    let e = _episode_new(id, moment_ref, salience, now)
    push(em[EM_EPS], e)
    list_set(em, EM_NEXT, id + 1)
    _em_enforce_cap(em)
    return e
}

fn em_get(em, id) {
    let eps = em[EM_EPS]
    if id < 0 { return 0 }
    if id >= len(eps) { return 0 }
    return eps[id]
}

fn em_count(em) { return len(em[EM_EPS]) }

fn em_count_recent(em) {
    let eps = em[EM_EPS]
    let n = 0
    let i = 0
    while i < len(eps) {
        if eps[i][E_TIER] == EP_RECENT { n = n + 1 }
        i = i + 1
    }
    return n
}

fn _em_enforce_cap(em) {
    if em_count_recent(em) <= EM_RECENT_CAP { return 0 }
    // Archive the oldest recent episode.
    let eps = em[EM_EPS]
    let i = 0
    while i < len(eps) {
        if eps[i][E_TIER] == EP_RECENT {
            list_set(eps[i], E_TIER, EP_ARCHIVED)
            return 1
        }
        i = i + 1
    }
    return 0
}

fn em_archive(em, id)     { let e = em_get(em, id); if e == 0 { return 0 } list_set(e, E_TIER, EP_ARCHIVED); return 1 }
fn em_consolidate(em, id) { let e = em_get(em, id); if e == 0 { return 0 } list_set(e, E_TIER, EP_CONSOLIDATED); return 1 }

// Decay every live episode one step.
fn em_decay_all(em, retain_milli) {
    let eps = em[EM_EPS]
    let i = 0
    while i < len(eps) {
        if eps[i][E_TIER] != EP_DROPPED { episode_decay(eps[i], retain_milli) }
        i = i + 1
    }
}

// Drop weak, non-consolidated episodes. Returns the count dropped.
fn em_drop_sweep(em) {
    let eps = em[EM_EPS]
    let dropped = 0
    let i = 0
    while i < len(eps) {
        if episode_should_drop(eps[i]) == 1 {
            list_set(eps[i], E_TIER, EP_DROPPED)
            dropped = dropped + 1
        }
        i = i + 1
    }
    return dropped
}

// Recall the (first) episode referencing a moment; reinforces it on hit.
fn em_recall(em, moment_ref, now) {
    let eps = em[EM_EPS]
    let i = 0
    while i < len(eps) {
        if eps[i][E_TIER] != EP_DROPPED {
            if eps[i][E_MOMENT] == moment_ref {
                episode_reinforce(eps[i], now)
                return eps[i]
            }
        }
        i = i + 1
    }
    return 0
}

// Replay priority of an episode: strength * salience (milli).
fn episode_replay_priority(e) {
    return e[E_STRENGTH] * e[E_SAL] / EP_SCALE
}

// The single highest replay-priority live episode (0 if none).
fn em_top_replay(em) {
    let eps = em[EM_EPS]
    let best = 0
    let best_pri = 0 - 1
    let i = 0
    while i < len(eps) {
        if eps[i][E_TIER] != EP_DROPPED {
            let pri = episode_replay_priority(eps[i])
            if pri > best_pri { best_pri = pri; best = eps[i] }
        }
        i = i + 1
    }
    return best
}
