// CrossEngin episodic: consolidation.
//
// Purpose
//   Consolidation scans episodic memory for recurring co-activated node clusters
//   and hands them to the atom-birth detector (ADR-0022 -> ADR-0025). A moment's
//   signal trace (the node set the input reached, ADR-0021) is reduced to a
//   canonical signature; a signature recurring across enough distinct episodes
//   is a stable pattern worth crystallizing into a semantic atom. Consolidation
//   produces candidate descriptors; atom_birth_monitor applies the frequency and
//   novelty gates and actually mints the atom. Episodes contributing to a
//   crystallized pattern are marked CONSOLIDATED so they survive episodic drop.
//
//   Pattern frequencies are tallied in a scanned list (not a builtin map, which
//   caps at 16 keys -- NEXT_SESSION.md). This runs during idle (NOVA enhancement
//   #13).
//
// ADRs implemented: ADR-0022 (consolidation), ADR-0025 (stability gate, >=3
//   distinct episodes).
// NOVA dependencies: builtins (sort, join, int_to_str). CrossEngin dependencies:
//   src/parts/episodic/episode_storage.nova, src/parts/episodic/moment_stream.nova.

import "episode_storage.nova"
import "moment_stream.nova"

// ADR-0025 stability gate: a pattern must recur across >= 3 distinct episodes.
let CONSOLIDATE_MIN_RECUR = 3

// ---- candidate descriptor -------------------------------------------------
let CAND_SIG     = 0
let CAND_COUNT   = 1
let CAND_EXAMPLE = 2   // an example moment id carrying the pattern

fn cand_signature(c) { return c[CAND_SIG] }
fn cand_count(c)     { return c[CAND_COUNT] }
fn cand_example(c)   { return c[CAND_EXAMPLE] }

// Canonical signature of a node-trace: sorted ids joined by commas.
fn consol_signature(trace) {
    let copy = list_new()
    let i = 0
    while i < len(trace) { push(copy, trace[i]); i = i + 1 }
    sort(copy)
    let parts = list_new()
    let j = 0
    while j < len(copy) { push(parts, int_to_str(copy[j])); j = j + 1 }
    return join(parts, ",")
}

fn _tally_index(tally, sig) {
    let i = 0
    while i < len(tally) {
        if str_eq(tally[i][CAND_SIG], sig) == 1 { return i }
        i = i + 1
    }
    return -1
}

fn _tally_add(tally, sig, example_ref) {
    let idx = _tally_index(tally, sig)
    if idx == -1 {
        let entry = list_new()
        push(entry, sig)
        push(entry, 1)
        push(entry, example_ref)
        push(tally, entry)
    } else {
        list_set(tally[idx], CAND_COUNT, tally[idx][CAND_COUNT] + 1)
    }
}

// Tally trace signatures over all live episodes. Returns the full tally
// (each entry [signature, count, example_moment_id]).
fn consol_tally(em, stream) {
    let tally = list_new()
    let n = em_count(em)
    let i = 0
    while i < n {
        let ep = em_get(em, i)
        if episode_tier(ep) != EP_DROPPED {
            let m = ms_get(stream, episode_moment(ep))
            if m != 0 {
                let trace = moment_trace(m)
                if len(trace) > 0 {
                    _tally_add(tally, consol_signature(trace), episode_moment(ep))
                }
            }
        }
        i = i + 1
    }
    return tally
}

// Candidates: signatures recurring at least min_recur times.
fn consol_scan(em, stream, min_recur) {
    let tally = consol_tally(em, stream)
    let candidates = list_new()
    let i = 0
    while i < len(tally) {
        if tally[i][CAND_COUNT] >= min_recur {
            push(candidates, tally[i])
        }
        i = i + 1
    }
    return candidates
}

// Mark every live episode whose moment matches a candidate signature as
// CONSOLIDATED (so it survives drop). Returns the number of episodes marked.
fn consol_mark(em, stream, candidates) {
    let marked = 0
    let n = em_count(em)
    let i = 0
    while i < n {
        let ep = em_get(em, i)
        if episode_tier(ep) != EP_DROPPED {
            if episode_tier(ep) != EP_CONSOLIDATED {
                let m = ms_get(stream, episode_moment(ep))
                if m != 0 {
                    let sig = consol_signature(moment_trace(m))
                    let c = 0
                    while c < len(candidates) {
                        if str_eq(candidates[c][CAND_SIG], sig) == 1 {
                            em_consolidate(em, episode_id(ep))
                            marked = marked + 1
                            c = len(candidates)
                        } else {
                            c = c + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return marked
}
