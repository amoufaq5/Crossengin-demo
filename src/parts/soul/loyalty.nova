// CrossEngin soul: loyalty hierarchy.
//
// Purpose
//   The soul's prioritized loyalties (ADR-0034): named entities (e.g. user,
//   tenant, constitution) with a level; higher level = higher priority. The
//   hierarchy resolves whose constraints win when they conflict (ADR-0045/0047).
//   Cross-cutting invariant tier.
//
// ADRs implemented: ADR-0034 (loyalty hierarchy). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/soul/identity.nova.

import "identity.nova"

let LY_ENTITY = 0
let LY_LEVEL  = 1

fn _loyalty_index(s, entity) {
    let ly = s[S_LOYALTY]
    let i = 0
    while i < len(ly) {
        if str_eq(ly[i][LY_ENTITY], entity) == 1 { return i }
        i = i + 1
    }
    return -1
}

fn soul_add_loyalty(s, entity, level) {
    let idx = _loyalty_index(s, entity)
    if idx != -1 {
        list_set(s[S_LOYALTY][idx], LY_LEVEL, level)
        return 1
    }
    let e = list_new(); push(e, entity); push(e, level)
    push(s[S_LOYALTY], e)
    return 1
}

fn soul_loyalty_count(s) { return len(s[S_LOYALTY]) }

fn soul_loyalty_level(s, entity) {
    let idx = _loyalty_index(s, entity)
    if idx == -1 { return 0 }
    return s[S_LOYALTY][idx][LY_LEVEL]
}

// Rank by descending level (1 = highest). 0 if the entity is unknown.
fn soul_loyalty_rank(s, entity) {
    let idx = _loyalty_index(s, entity)
    if idx == -1 { return 0 }
    let my = s[S_LOYALTY][idx][LY_LEVEL]
    let ly = s[S_LOYALTY]
    let rank = 1
    let i = 0
    while i < len(ly) {
        if ly[i][LY_LEVEL] > my { rank = rank + 1 }
        i = i + 1
    }
    return rank
}

// The higher-loyalty entity of two ("" if both unknown). Ties favor the first.
fn soul_loyalty_dominant(s, entity_a, entity_b) {
    let la = soul_loyalty_level(s, entity_a)
    let lb = soul_loyalty_level(s, entity_b)
    if la == 0 { if lb == 0 { return "" } }
    if lb > la { return entity_b }
    return entity_a
}
