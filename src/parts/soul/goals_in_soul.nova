// CrossEngin soul: goals in soul (medium tier).
//
// Purpose
//   A medium-timescale summary of the active goal tree inside the soul
//   (ADR-0034). soul_sync_goals refreshes it from the goal engine (ADR-0033) on
//   goal events -- not every tick. The summary is a lightweight list of
//   [name, priority, status] entries so any subsystem can read "what am I
//   working on" without touching the goal engine, and so the soul snapshot
//   (ADR-0048) carries goal context.
//
// ADRs implemented: ADR-0034 (goals tier). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/soul/identity.nova. (Goal summaries are
//   passed in as plain [name, priority, status] lists, so this stays decoupled
//   from the goal engine module.)

import "identity.nova"

let GS_NAME     = 0
let GS_PRIORITY = 1
let GS_STATUS   = 2

// Replace the soul's goal summary with a fresh list of [name, priority, status]
// entries (medium-timescale sync).
fn soul_sync_goals(s, summaries) {
    let g = list_new()
    let i = 0
    while i < len(summaries) {
        let e = list_new()
        push(e, summaries[i][0])
        push(e, summaries[i][1])
        push(e, summaries[i][2])
        push(g, e)
        i = i + 1
    }
    list_set(s, S_GOALS, g)
    return len(g)
}

fn soul_goal_count(s) { return len(s[S_GOALS]) }

fn soul_goal_name(s, idx)     { return s[S_GOALS][idx][GS_NAME] }
fn soul_goal_priority(s, idx) { return s[S_GOALS][idx][GS_PRIORITY] }

// The name of the highest-priority summarized goal ("" if none).
fn soul_top_goal(s) {
    let g = s[S_GOALS]
    if len(g) == 0 { return "" }
    let best = 0
    let i = 1
    while i < len(g) {
        if g[i][GS_PRIORITY] > g[best][GS_PRIORITY] { best = i }
        i = i + 1
    }
    return g[best][GS_NAME]
}
