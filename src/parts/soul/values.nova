// CrossEngin soul: values.
//
// Purpose
//   The ethical values the soul upholds (ADR-0034) -- the standards emotion
//   appraises actions against (praiseworthiness, ADR-0035). A value is a named
//   principle (e.g. truth -> "never fabricate"). Cross-cutting invariant tier.
//
// ADRs implemented: ADR-0034 (soul values). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/soul/identity.nova.

import "identity.nova"

// Set (or update) a value's principle.
fn soul_add_value(s, name, principle) {
    let vals = s[S_VALUES]
    let i = 0
    while i < len(vals) {
        if str_eq(vals[i][0], name) == 1 {
            list_set(vals[i], 1, principle)
            return 1
        }
        i = i + 1
    }
    let e = list_new(); push(e, name); push(e, principle)
    push(vals, e)
    return 1
}

fn soul_value_count(s) { return len(s[S_VALUES]) }

fn soul_has_value(s, name) {
    let vals = s[S_VALUES]
    let i = 0
    while i < len(vals) {
        if str_eq(vals[i][0], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// The principle for a named value ("" if absent).
fn soul_value(s, name) {
    let vals = s[S_VALUES]
    let i = 0
    while i < len(vals) {
        if str_eq(vals[i][0], name) == 1 { return vals[i][1] }
        i = i + 1
    }
    return ""
}
