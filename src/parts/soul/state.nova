// CrossEngin soul: state (fast tier).
//
// Purpose
//   The soul's fast-changing state (ADR-0034): current mood (valence/arousal
//   aggregates from emotion, ADR-0035), attention, and energy/load. Updated
//   every tick via soul_update_state -- cheap and unrestricted. By construction
//   this writes only the state sub-structure and never the identity fields, so
//   fast churn cannot corrupt slow identity (the ADR-0034 timescale guarantee).
//
//   All values are integer milli (0..1000). State is volatile and not persisted
//   in detail (ADR-0048).
//
// ADRs implemented: ADR-0034 (soul state tier). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/soul/identity.nova.

import "identity.nova"

let ST_VALENCE   = 0
let ST_AROUSAL   = 1
let ST_ATTENTION = 2
let ST_ENERGY    = 3

// Fast update of mood/attention/energy (fed by emotion + loops each tick).
fn soul_update_state(s, valence, arousal, attention, energy) {
    let st = s[S_STATE]
    list_set(st, ST_VALENCE, valence)
    list_set(st, ST_AROUSAL, arousal)
    list_set(st, ST_ATTENTION, attention)
    list_set(st, ST_ENERGY, energy)
    return 1
}

// Update only mood (the common case from emotion appraisal).
fn soul_update_mood(s, valence, arousal) {
    let st = s[S_STATE]
    list_set(st, ST_VALENCE, valence)
    list_set(st, ST_AROUSAL, arousal)
    return 1
}

fn soul_mood_valence(s) { return s[S_STATE][ST_VALENCE] }
fn soul_mood_arousal(s) { return s[S_STATE][ST_AROUSAL] }
fn soul_attention(s)    { return s[S_STATE][ST_ATTENTION] }
fn soul_energy(s)       { return s[S_STATE][ST_ENERGY] }
