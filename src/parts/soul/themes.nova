// CrossEngin soul: identity themes.
//
// Purpose
//   Persistent thematic elements of the soul's character (ADR-0034): named
//   themes with a strength (milli) that can be reinforced (capped at 1.0). The
//   dominant theme is the strongest. Themes are part of the slow identity tier.
//
// ADRs implemented: ADR-0034 (identity themes). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/soul/identity.nova.

import "identity.nova"

let TH_NAME     = 0
let TH_STRENGTH = 1

fn _theme_index(s, name) {
    let th = s[S_THEMES]
    let i = 0
    while i < len(th) {
        if str_eq(th[i][TH_NAME], name) == 1 { return i }
        i = i + 1
    }
    return -1
}

fn soul_add_theme(s, name, strength) {
    let idx = _theme_index(s, name)
    if idx != -1 {
        list_set(s[S_THEMES][idx], TH_STRENGTH, strength)
        return 1
    }
    let e = list_new(); push(e, name); push(e, strength)
    push(s[S_THEMES], e)
    return 1
}

fn soul_theme_count(s) { return len(s[S_THEMES]) }

fn soul_theme_strength(s, name) {
    let idx = _theme_index(s, name)
    if idx == -1 { return 0 }
    return s[S_THEMES][idx][TH_STRENGTH]
}

// Reinforce a theme (capped at 1.0). Returns the new strength (0 if unknown).
fn soul_reinforce_theme(s, name, amount) {
    let idx = _theme_index(s, name)
    if idx == -1 { return 0 }
    let v = s[S_THEMES][idx][TH_STRENGTH] + amount
    if v > 1000 { v = 1000 }
    list_set(s[S_THEMES][idx], TH_STRENGTH, v)
    return v
}

// Name of the strongest theme ("" if none).
fn soul_dominant_theme(s) {
    let th = s[S_THEMES]
    if len(th) == 0 { return "" }
    let best = 0
    let i = 1
    while i < len(th) {
        if th[i][TH_STRENGTH] > th[best][TH_STRENGTH] { best = i }
        i = i + 1
    }
    return th[best][TH_NAME]
}
