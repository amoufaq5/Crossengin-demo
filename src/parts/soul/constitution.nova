// CrossEngin soul: constitution.
//
// Purpose
//   The soul's hard behavioral rules (ADR-0034) -- constitutional constraints
//   emitted as privileged, non-negotiable inhibitory XSIG_CONST signals
//   (ADR-0008/0045). Each rule has a text (or canonical concept label) and a
//   severity: warn (1), block (2), or override-only (3). soul_check_constitution
//   tests an action against every TEXT rule and returns whether it is
//   permitted; blocking/override TEXT rules whose forbidden substring appears
//   in the action veto it. CONCEPT rules are evaluated via
//   soul_check_constitution_concepts, which walks the perceived concept handles
//   and matches a forbidden concept directly OR through the structural
//   neighborhood (P14, find_neighbors -- operator + xref + word-sense edges) so
//   that synonyms / paraphrases that route to a neighbor of the forbidden
//   concept are vetoed even when the literal keyword is absent. A
//   constitutional signal rides the privileged broadcast route the gate router
//   already enforces (never learnable, never pruned).
//
//   Today's KNOWN scope: the concept-veto catches percepts whose handle equals
//   the forbidden concept OR appears as an operator / xref neighbor of it
//   (configured by first_atoms.nova's exfiltrate->{leak,smuggle,send_external,
//   share_secret} synonym edges). A paraphrase that activates a percept with
//   no operator / xref path to the forbidden concept still slips through; the
//   set of synonym edges defines the catchment radius.
//
// ADRs implemented: ADR-0034 (constitution), ADR-0045 (constitutional veto +
//   semantic-intent extension), ADR-0008 (XSIG_CONST). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/parts/soul/identity.nova,
//   src/substrate/signal_dispatch.nova, src/reader/neighborhood.nova (concept
//   variant only -- find_neighbors / handle_eq for the percept walk).

import "identity.nova"
import "../../substrate/signal_dispatch.nova"
import "../../reader/neighborhood.nova"

// Severities (match the soul-declaration convention).
let CONST_WARN     = 1
let CONST_BLOCK    = 2
let CONST_OVERRIDE = 3

// Rule kinds. TEXT is the original substring-match rule (snapshot-persisted).
// CONCEPT is the semantic-intent rule, evaluated against the perceived concept
// handles via the P14 neighborhood (operator + xref + word-sense edges).
let RULE_KIND_TEXT    = 0
let RULE_KIND_CONCEPT = 1

let CR_TEXT     = 0
let CR_SEVERITY = 1
let CR_KIND     = 2

// Concept-veto neighborhood walk parameters. 2 hops (the P14 ceiling) so a
// forbidden concept's direct synonyms AND their one-hop neighbors veto, but
// the walk cost stays bounded. NEIGH_MATCH_THRESHOLD is the minimum strength
// at which a neighbor counts as a match -- well above the spreading-activation
// floor so two-hop curiosities do not become accidental vetoes.
let CV_MAX_HOPS         = 2
let CV_MAX_RESULTS      = 32
let NEIGH_MATCH_THRESHOLD = 200

fn _rule_kind(r) {
    if len(r) > CR_KIND { return r[CR_KIND] }
    return RULE_KIND_TEXT
}

fn soul_add_constitution(s, rule_text, severity) {
    let e = list_new()
    push(e, rule_text)
    push(e, severity)
    push(e, RULE_KIND_TEXT)
    push(s[S_CONSTITUTION], e)
    return len(s[S_CONSTITUTION])
}

// Concept-keyed variant: the rule's text is a canonical concept label. The
// veto fires when perception activates a concept handle whose label equals
// the rule, OR whose handle is a structural neighbor (P14) of the rule's
// concept handle. Severity semantics match the text rule -- warn does not
// veto; block / override do.
fn soul_add_constitution_concept(s, concept_label, severity) {
    let e = list_new()
    push(e, concept_label)
    push(e, severity)
    push(e, RULE_KIND_CONCEPT)
    push(s[S_CONSTITUTION], e)
    return len(s[S_CONSTITUTION])
}

fn soul_constitution_count(s) { return len(s[S_CONSTITUTION]) }
fn soul_constitution_rule(s, idx) { return s[S_CONSTITUTION][idx] }
fn soul_constitution_rule_kind(s, idx) { return _rule_kind(s[S_CONSTITUTION][idx]) }

// Is an action permitted by the TEXT rules? A rule with severity >= BLOCK
// whose forbidden substring occurs in the action vetoes it (returns 0).
// CONCEPT rules are skipped here -- they need the perceived concept set,
// which only soul_check_constitution_concepts has access to. Warn-only rules
// do not veto.
fn soul_check_constitution(s, action_text) {
    let rules = s[S_CONSTITUTION]
    let i = 0
    while i < len(rules) {
        if _rule_kind(rules[i]) == RULE_KIND_TEXT {
            if rules[i][CR_SEVERITY] >= CONST_BLOCK {
                if str_find(action_text, rules[i][CR_TEXT]) >= 0 { return 0 }
            }
        }
        i = i + 1
    }
    return 1
}

// Which rule index vetoes an action (-1 if permitted). Scans only TEXT rules
// -- concept rules need the perceived set; soul_constitution_concept_violated_by
// does that walk.
fn soul_constitution_violated_by(s, action_text) {
    let rules = s[S_CONSTITUTION]
    let i = 0
    while i < len(rules) {
        if _rule_kind(rules[i]) == RULE_KIND_TEXT {
            if rules[i][CR_SEVERITY] >= CONST_BLOCK {
                if str_find(action_text, rules[i][CR_TEXT]) >= 0 { return i }
            }
        }
        i = i + 1
    }
    return -1
}

// Is a single percept handle (kg_label/atom_id pair) a structural neighbor of
// the rule's concept handle? Wraps find_neighbors with the concept-veto walk
// parameters and treats strength >= NEIGH_MATCH_THRESHOLD as a hit.
fn _percept_neighbor_of(kg_reg, percept_handle, rule_handle) {
    if handle_eq(percept_handle, rule_handle) == 1 { return 1 }
    let nbrs = find_neighbors(kg_reg, rule_handle, CV_MAX_HOPS, CV_MAX_RESULTS)
    let strength = neighbor_strength(nbrs, percept_handle)
    if strength >= NEIGH_MATCH_THRESHOLD { return 1 }
    return 0
}

// Resolve a concept rule's label to a (kg_label, atom_id) handle by scanning
// every KG in the registry. Returns 0 if the rule's label has no atom yet.
fn _rule_concept_handle(kg_reg, label) {
    let nk = kg_count(kg_reg)
    let i = 0
    while i < nk {
        let kg = kg_get(kg_reg, i)
        if kg != 0 {
            let a = kg_find_atom(kg, label)
            if a != 0 { return handle_new(atom_kg(a), atom_id(a)) }
        }
        i = i + 1
    }
    return 0
}

// Is the perception permitted by the CONCEPT rules? Walks every blocking
// concept rule, resolves its label to a handle, and tests whether any
// perceived handle matches -- exactly OR via the P14 neighborhood -- the
// forbidden concept. Returns 0 if any concept rule vetoes; 1 otherwise.
// percept_handles is a list of (kg_label, atom_id) handles -- the same shape
// rctx_active / ctx_percept produce.
fn soul_check_constitution_concepts(s, kg_reg, percept_handles) {
    if kg_reg == 0 { return 1 }
    if percept_handles == 0 { return 1 }
    let rules = s[S_CONSTITUTION]
    let i = 0
    while i < len(rules) {
        if _rule_kind(rules[i]) == RULE_KIND_CONCEPT {
            if rules[i][CR_SEVERITY] >= CONST_BLOCK {
                let rh = _rule_concept_handle(kg_reg, rules[i][CR_TEXT])
                if rh != 0 {
                    let p = 0
                    while p < len(percept_handles) {
                        if _percept_neighbor_of(kg_reg, percept_handles[p], rh) == 1 {
                            return 0
                        }
                        p = p + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return 1
}

// Which CONCEPT rule index vetoes the perception (-1 if permitted). Mirrors
// soul_check_constitution_concepts but returns the rule index of the first
// matching concept rule.
fn soul_constitution_concept_violated_by(s, kg_reg, percept_handles) {
    if kg_reg == 0 { return 0 - 1 }
    if percept_handles == 0 { return 0 - 1 }
    let rules = s[S_CONSTITUTION]
    let i = 0
    while i < len(rules) {
        if _rule_kind(rules[i]) == RULE_KIND_CONCEPT {
            if rules[i][CR_SEVERITY] >= CONST_BLOCK {
                let rh = _rule_concept_handle(kg_reg, rules[i][CR_TEXT])
                if rh != 0 {
                    let p = 0
                    while p < len(percept_handles) {
                        if _percept_neighbor_of(kg_reg, percept_handles[p], rh) == 1 {
                            return i
                        }
                        p = p + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Build the privileged constitutional signal for a rule: XSIG_CONST (priority 9,
// inhibitory veto, broadcast to all parts, never learnable). meta carries the
// rule index. Returns the signal.
fn soul_constitution_signal(s, rule_index) {
    return sig_new(XSIG_CONST, -1, -1, 1000, 0, rule_index)
}
