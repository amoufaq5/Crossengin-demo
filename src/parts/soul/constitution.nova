// CrossEngin soul: constitution.
//
// Purpose
//   The soul's hard behavioral rules (ADR-0034) -- constitutional constraints
//   emitted as privileged, non-negotiable inhibitory XSIG_CONST signals
//   (ADR-0008/0045). Each rule has text and a severity: warn (1), block (2), or
//   override-only (3). soul_check_constitution tests an action against every
//   rule and returns whether it is permitted; blocking/override rules whose
//   forbidden text appears in the action veto it. A constitutional signal rides
//   the privileged broadcast route the gate router already enforces (never
//   learnable, never pruned).
//
// ADRs implemented: ADR-0034 (constitution), ADR-0045 (constitutional veto),
//   ADR-0008 (XSIG_CONST). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/parts/soul/identity.nova, src/substrate/signal_dispatch.nova.

import "identity.nova"
import "../../substrate/signal_dispatch.nova"

// Severities (match the soul-declaration convention).
let CONST_WARN     = 1
let CONST_BLOCK    = 2
let CONST_OVERRIDE = 3

let CR_TEXT     = 0
let CR_SEVERITY = 1

fn soul_add_constitution(s, rule_text, severity) {
    let e = list_new()
    push(e, rule_text)
    push(e, severity)
    push(s[S_CONSTITUTION], e)
    return len(s[S_CONSTITUTION])
}

fn soul_constitution_count(s) { return len(s[S_CONSTITUTION]) }
fn soul_constitution_rule(s, idx) { return s[S_CONSTITUTION][idx] }

// Is an action permitted? A rule with severity >= BLOCK whose forbidden text
// occurs in the action vetoes it (returns 0). Warn-only rules do not veto.
fn soul_check_constitution(s, action_text) {
    let rules = s[S_CONSTITUTION]
    let i = 0
    while i < len(rules) {
        if rules[i][CR_SEVERITY] >= CONST_BLOCK {
            if str_find(action_text, rules[i][CR_TEXT]) >= 0 { return 0 }
        }
        i = i + 1
    }
    return 1
}

// Which rule index vetoes an action (-1 if permitted).
fn soul_constitution_violated_by(s, action_text) {
    let rules = s[S_CONSTITUTION]
    let i = 0
    while i < len(rules) {
        if rules[i][CR_SEVERITY] >= CONST_BLOCK {
            if str_find(action_text, rules[i][CR_TEXT]) >= 0 { return i }
        }
        i = i + 1
    }
    return -1
}

// Build the privileged constitutional signal for a rule: XSIG_CONST (priority 9,
// inhibitory veto, broadcast to all parts, never learnable). meta carries the
// rule index. Returns the signal.
fn soul_constitution_signal(s, rule_index) {
    return sig_new(XSIG_CONST, -1, -1, 1000, 0, rule_index)
}
