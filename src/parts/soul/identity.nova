// CrossEngin soul: identity (and the soul object).
//
// Purpose
//   The soul is CrossEngin's persistent behavioral identity (ADR-0034), a
//   structured state with four content kinds at different timescales: identity
//   (slow), state (fast), goals (medium), and cross-cutting invariants (values,
//   constitution, themes, loyalty). This module defines the soul object that
//   the other soul modules operate on, plus the identity component itself:
//   purpose, nature, and OCEAN personality.
//
//   Identity is the slow tier: it is mutated ONLY via soul_revise_identity,
//   which requires an explicit justification (recorded for the decision log,
//   ADR-0043) -- emotion/perception loops must never write it. OCEAN traits and
//   personality levels are integer milli (0..1000); the neutral default is 500.
//
// ADRs implemented: ADR-0034 (soul wrapper, identity tier). The soul is the
//   FIRST component rehydrated (ADR-0048); persistence is Phase 10.
// NOVA dependencies: builtins. CrossEngin dependencies: none.

// ---- soul object layout ---------------------------------------------------
let SOUL_TAG       = 0
let S_NAME         = 1
let S_IDENTITY     = 2
let S_STATE        = 3
let S_VALUES       = 4
let S_CONSTITUTION = 5
let S_THEMES       = 6
let S_LOYALTY      = 7
let S_GOALS        = 8
let SOUL_OBJ_TAG = 3401

// ---- identity sub-structure ----------------------------------------------
let ID_PURPOSE   = 0
let ID_NATURE    = 1
let ID_O         = 2   // openness
let ID_C         = 3   // conscientiousness
let ID_E         = 4   // extraversion
let ID_A         = 5   // agreeableness
let ID_N         = 6   // neuroticism
let ID_REVISIONS = 7   // list of justification strings (audit)

fn soul_new(name) {
    let identity = list_new()
    push(identity, "")          // purpose
    push(identity, "")          // nature
    push(identity, 500)         // O
    push(identity, 500)         // C
    push(identity, 500)         // E
    push(identity, 500)         // A
    push(identity, 500)         // N
    push(identity, list_new()) // revisions

    let state = list_new()
    push(state, 500)            // valence (neutral)
    push(state, 300)            // arousal (calm)
    push(state, 500)            // attention
    push(state, 1000)           // energy

    let s = list_new()
    push(s, SOUL_OBJ_TAG)
    push(s, name)
    push(s, identity)
    push(s, state)
    push(s, list_new())   // values
    push(s, list_new())   // constitution
    push(s, list_new())   // themes
    push(s, list_new())   // loyalty
    push(s, list_new())   // goals summary
    return s
}

fn soul_name(s)    { return s[S_NAME] }
fn soul_purpose(s) { return s[S_IDENTITY][ID_PURPOSE] }
fn soul_nature(s)  { return s[S_IDENTITY][ID_NATURE] }

// Initial identity setup (bootstrap, ADR-0048 seed). Use soul_revise_identity
// thereafter.
fn soul_set_identity(s, purpose, nature) {
    let id = s[S_IDENTITY]
    list_set(id, ID_PURPOSE, purpose)
    list_set(id, ID_NATURE, nature)
    return 1
}

// OCEAN personality (slow tier).
fn soul_set_ocean(s, o, c, e, a, n) {
    let id = s[S_IDENTITY]
    list_set(id, ID_O, o)
    list_set(id, ID_C, c)
    list_set(id, ID_E, e)
    list_set(id, ID_A, a)
    list_set(id, ID_N, n)
    return 1
}

fn soul_ocean(s) {
    let id = s[S_IDENTITY]
    let v = list_new()
    push(v, id[ID_O]); push(v, id[ID_C]); push(v, id[ID_E]); push(v, id[ID_A]); push(v, id[ID_N])
    return v
}
fn soul_openness(s)          { return s[S_IDENTITY][ID_O] }
fn soul_conscientiousness(s) { return s[S_IDENTITY][ID_C] }
fn soul_extraversion(s)      { return s[S_IDENTITY][ID_E] }
fn soul_agreeableness(s)     { return s[S_IDENTITY][ID_A] }
fn soul_neuroticism(s)       { return s[S_IDENTITY][ID_N] }

// Slow-tier identity revision: requires a non-empty justification (recorded for
// the decision log). Returns 1 if revised, 0 if rejected (no justification).
fn soul_revise_identity(s, purpose, nature, justification) {
    if str_eq(justification, "") == 1 { return 0 }
    let id = s[S_IDENTITY]
    list_set(id, ID_PURPOSE, purpose)
    list_set(id, ID_NATURE, nature)
    push(id[ID_REVISIONS], justification)
    return 1
}

fn soul_revision_count(s) { return len(s[S_IDENTITY][ID_REVISIONS]) }
