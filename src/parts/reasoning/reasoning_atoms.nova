// CrossEngin reasoning: operator atoms.
//
// Purpose
//   Reasoning is hybrid (ADR-0031): thin strategy functions operate over
//   first-class operator atoms, never hard-coded facts. An operator atom is an
//   ATOM_RELATION in the reasoning KG that links a premise atom to a conclusion
//   atom under one of four kinds -- causal, implicative, analogical, evidential
//   -- and carries the inference's Bayesian confidence as its belief. Co-firing
//   strengthens the operator (ADR-0007); confidence composes across chains.
//
//   Premise/conclusion are atom ids; confidence is the atom's alpha/beta mean
//   (milli). Operators are stored/scanned in the reasoning KG.
//
// ADRs implemented: ADR-0031 (reasoning operator atoms), ADR-0016/0023 (atoms +
//   belief). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/kg/multi_kg_manager.nova (and atom_store).

import "../../kg/multi_kg_manager.nova"
import "../../learning/promotion.nova"

// ---- operator kinds (map to the ADR-0008 reasoning signal types) ----------
let ROP_CAUSAL   = 1
let ROP_IMPLY    = 2
let ROP_ANALOGY  = 3
let ROP_EVIDENCE = 4
let ROP_OPPOSITE = 5   // R67: antonymy -- "X is the opposite of Y"

fn rop_kind_name(k) {
    if k == ROP_CAUSAL   { return "causal" }
    if k == ROP_IMPLY    { return "implicative" }
    if k == ROP_ANALOGY  { return "analogical" }
    if k == ROP_EVIDENCE { return "evidential" }
    if k == ROP_OPPOSITE { return "oppositional" }
    return "invalid"
}

// Spawn the standing reasoning KG.
fn reasoning_kg_init(reg) {
    return kg_spawn(reg, "reasoning")
}

// Create an operator atom linking premise -> conclusion under op_kind.
fn rop_new(rkg, op_kind, premise_id, conclusion_id, label, moment) {
    let a = kg_add_atom(rkg, ATOM_RELATION, label, moment)
    atom_payload_set(a, "op", op_kind)
    atom_payload_set(a, "premise", premise_id)
    atom_payload_set(a, "conclusion", conclusion_id)
    // P1.5: keep the edge adjacency index current. If it isn't built yet (fresh
    // KG, or just reset after a snapshot load), build it from all operators --
    // which now includes this fully-formed one, so no separate add is needed.
    if kg_edge_index_built(rkg) == 0 { _rk_build_edges(rkg) }
    else { kg_edge_add(rkg, atom_id(a), premise_id, conclusion_id) }
    return a
}

// P1.5: (re)build the edge index for `rkg` from every live operator, in atom-id
// order, then mark it built. One O(atoms) pass; thereafter rop_new maintains it
// incrementally. Used lazily after a snapshot load (operators are restored by
// re-attaching payloads, bypassing rop_new) and on the first operator lookup.
fn _rk_build_edges(rkg) {
    let atoms = kg_atoms(rkg)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if is_operator(a) == 1 {
            kg_edge_add(rkg, atom_id(a), rop_premise(a), rop_conclusion(a))
        }
        i = i + 1
    }
    kg_edge_index_mark_built(rkg)
    return 1
}

fn _rk_ensure_edges(rkg) {
    if kg_edge_index_built(rkg) == 0 { _rk_build_edges(rkg) }
    return 1
}

fn is_operator(a) {
    if a == 0 { return 0 }
    if atom_kind(a) != ATOM_RELATION { return 0 }
    if atom_payload_has(a, "op") == 1 { return 1 }
    return 0
}

fn rop_kind(a)       { return atom_payload_get(a, "op") }
fn rop_premise(a)    { return atom_payload_get(a, "premise") }
fn rop_conclusion(a) { return atom_payload_get(a, "conclusion") }
fn rop_confidence(a) { return atom_confidence(a) }

// Strengthen/weaken an operator on inference success/failure (co-firing).
fn rop_observe(a, sign) { return atom_observe(a, sign) }

// Live operators leaving a premise atom. P1.5: O(out-degree) via the edge index
// instead of O(atoms). Each candidate is re-validated (the atom may have been
// tombstoned, or its slot reset by a load) so the result is identical to the
// old full scan -- same operators, same atom-id order.
fn rk_operators_from(rkg, premise_id) {
    _rk_ensure_edges(rkg)
    let cand = kg_edges_from(rkg, premise_id)
    let out = list_new()
    let i = 0
    while i < len(cand) {
        let a = kg_atom(rkg, cand[i])
        if is_operator(a) == 1 {
            if rop_premise(a) == premise_id {
                // ADR-0092 answer-path exclusion: do not follow an operator into
                // a governed-but-not-promoted conclusion (CANDIDATE / QUARANTINED
                // / CONTESTED). Ungoverned (base) and PROMOTED conclusions pass;
                // a conclusion that does not resolve in this kg is kept (cross-KG
                // operators are unaffected -- their usability is checked where
                // they resolve).
                let concl = kg_atom(rkg, rop_conclusion(a))
                if concl == 0 {
                    push(out, a)
                } else {
                    if cand_is_usable(concl) == 1 { push(out, a) }
                }
            }
        }
        i = i + 1
    }
    return out
}

// Live operators entering a conclusion atom (O(in-degree) via the edge index).
fn rk_operators_to(rkg, conclusion_id) {
    _rk_ensure_edges(rkg)
    let cand = kg_edges_to(rkg, conclusion_id)
    let out = list_new()
    let i = 0
    while i < len(cand) {
        let a = kg_atom(rkg, cand[i])
        if is_operator(a) == 1 {
            if rop_conclusion(a) == conclusion_id { push(out, a) }
        }
        i = i + 1
    }
    return out
}
