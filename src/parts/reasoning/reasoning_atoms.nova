// CrossEngin reasoning: operator atoms.
//
// Purpose
//   Reasoning is hybrid (ADR-0031): thin strategy functions operate over
//   first-class operator atoms, never hard-coded facts. An operator atom is an
//   ATOM_RELATION in the reasoning KG that links a premise atom to a conclusion
//   atom under one of four kinds -- causal, implicative, analogical, evidential
//   -- and carries the inference's Bayesian confidence as its belief. Co-firing
//   strengthens the operator (ADR-0007); confidence composes across chains.
//
//   Premise/conclusion are atom ids; confidence is the atom's alpha/beta mean
//   (milli). Operators are stored/scanned in the reasoning KG.
//
// ADRs implemented: ADR-0031 (reasoning operator atoms), ADR-0016/0023 (atoms +
//   belief). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/kg/multi_kg_manager.nova (and atom_store).

import "../../kg/multi_kg_manager.nova"

// ---- operator kinds (map to the ADR-0008 reasoning signal types) ----------
let ROP_CAUSAL   = 1
let ROP_IMPLY    = 2
let ROP_ANALOGY  = 3
let ROP_EVIDENCE = 4

fn rop_kind_name(k) {
    if k == ROP_CAUSAL   { return "causal" }
    if k == ROP_IMPLY    { return "implicative" }
    if k == ROP_ANALOGY  { return "analogical" }
    if k == ROP_EVIDENCE { return "evidential" }
    return "invalid"
}

// Spawn the standing reasoning KG.
fn reasoning_kg_init(reg) {
    return kg_spawn(reg, "reasoning")
}

// Create an operator atom linking premise -> conclusion under op_kind.
fn rop_new(rkg, op_kind, premise_id, conclusion_id, label, moment) {
    let a = kg_add_atom(rkg, ATOM_RELATION, label, moment)
    atom_payload_set(a, "op", op_kind)
    atom_payload_set(a, "premise", premise_id)
    atom_payload_set(a, "conclusion", conclusion_id)
    return a
}

fn is_operator(a) {
    if a == 0 { return 0 }
    if atom_kind(a) != ATOM_RELATION { return 0 }
    if atom_payload_has(a, "op") == 1 { return 1 }
    return 0
}

fn rop_kind(a)       { return atom_payload_get(a, "op") }
fn rop_premise(a)    { return atom_payload_get(a, "premise") }
fn rop_conclusion(a) { return atom_payload_get(a, "conclusion") }
fn rop_confidence(a) { return atom_confidence(a) }

// Strengthen/weaken an operator on inference success/failure (co-firing).
fn rop_observe(a, sign) { return atom_observe(a, sign) }

// Live operators leaving a premise atom.
fn rk_operators_from(rkg, premise_id) {
    let atoms = kg_atoms(rkg)
    let out = list_new()
    let i = 0
    while i < len(atoms) {
        if is_operator(atoms[i]) == 1 {
            if rop_premise(atoms[i]) == premise_id { push(out, atoms[i]) }
        }
        i = i + 1
    }
    return out
}

// Live operators entering a conclusion atom.
fn rk_operators_to(rkg, conclusion_id) {
    let atoms = kg_atoms(rkg)
    let out = list_new()
    let i = 0
    while i < len(atoms) {
        if is_operator(atoms[i]) == 1 {
            if rop_conclusion(atoms[i]) == conclusion_id { push(out, atoms[i]) }
        }
        i = i + 1
    }
    return out
}
