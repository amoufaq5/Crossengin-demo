// Multi-KG empirical consistency scan (ADR-0016 / ADR-0023).
//
// The FORMAL env (src/agent/formal_chat.nova) is global across KGs and its
// consistency is scanned via src/parts/reasoning/contradiction.nova
// (kernel-checked FALSE witnesses). But *empirical* beliefs -- atoms with
// belief (alpha/beta) below the FORMAL grade -- live per-KG. Two KGs can
// happily hold the same-labeled atom with contradicting beliefs (physics_kg's
// "electron_charge" believed at 0.95; folk_kg's at 0.05) and nothing detects
// it. This module closes that gap: a scan of the multi-KG registry that
// surfaces same-label atoms whose belief means land on opposite sides of the
// uniform prior (500 milli) with a spread beyond a caller-provided threshold.
//
// The verdict is heuristic (not a kernel proof) because empirical beliefs
// are graded confidences, not theorems -- there is no "proof of FALSE" to
// exhibit. What IS load-bearing: the scan is deterministic, the threshold is
// explicit, and the report names both KGs + both mean values so users can
// judge for themselves. Contrast with FORMAL contradiction detection, which
// returns a kernel-checked witness.
//
// NOVA dependencies: builtins + str_safe (str_eq_bytes for label comparison).
// CrossEngin dependencies: src/kg/atom_store.nova (atom_confidence,
// atom_label), src/kg/multi_kg_manager.nova (kg_count, kg_get, kg_atoms,
// kg_label), src/util/str_safe.nova.

import "../../kg/atom_store.nova"
import "../../kg/multi_kg_manager.nova"
import "../../util/str_safe.nova"

// Default belief-mean spread that qualifies as a cross-KG conflict: 500
// milli = 0.5. Anything smaller is likely just different corroboration
// strength around the same central estimate.
let MKGC_DEFAULT_SPREAD = 500

// Scan for cross-KG label matches whose belief means differ by at least
// `spread_threshold`. Returns a list of conflict records:
//   [label, kg_a_label, kg_b_label, mean_a_milli, mean_b_milli].
// The scan is O(kgs^2 * atoms^2) -- fine for the demo scale (~7 KGs, tens of
// atoms each); a hash-indexed pass is a future optimization.
fn mkgc_scan_conflicts(kgreg, spread_threshold) {
    let out = list_new()
    if kgreg == 0 { return out }
    let n = kg_count(kgreg)
    let i = 0
    while i < n {
        let kg_a = kg_get(kgreg, i)
        if kg_a != 0 {
            let atoms_a = kg_atoms(kg_a)
            let label_a = kg_label(kg_a)
            let j = i + 1
            while j < n {
                let kg_b = kg_get(kgreg, j)
                if kg_b != 0 {
                    let atoms_b = kg_atoms(kg_b)
                    let label_b = kg_label(kg_b)
                    let k = 0
                    while k < len(atoms_a) {
                        let a = atoms_a[k]
                        if a != 0 {
                            let l = 0
                            while l < len(atoms_b) {
                                let b = atoms_b[l]
                                if b != 0 {
                                    if str_eq_bytes(atom_label(a), atom_label(b)) == 1 {
                                        let ma = atom_confidence(a)
                                        let mb = atom_confidence(b)
                                        let spread = ma - mb
                                        if spread < 0 { spread = 0 - spread }
                                        if spread >= spread_threshold {
                                            let entry = list_new()
                                            push(entry, atom_label(a))
                                            push(entry, label_a)
                                            push(entry, label_b)
                                            push(entry, ma)
                                            push(entry, mb)
                                            push(out, entry)
                                        }
                                    }
                                }
                                l = l + 1
                            }
                        }
                        k = k + 1
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn mkgc_conflict_label(e)  { return e[0] }
fn mkgc_conflict_kg_a(e)   { return e[1] }
fn mkgc_conflict_kg_b(e)   { return e[2] }
fn mkgc_conflict_mean_a(e) { return e[3] }
fn mkgc_conflict_mean_b(e) { return e[4] }

// True if the registry is empirically consistent (no cross-KG conflicts at
// or above the threshold).
fn mkgc_is_consistent(kgreg, spread_threshold) {
    if len(mkgc_scan_conflicts(kgreg, spread_threshold)) == 0 { return 1 }
    return 0
}
