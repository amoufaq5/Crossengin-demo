// Contested-domain steelman (ADR-0090): consumes the debate engine's output to
// present a contested claim as every evidenced, *surviving* position at its
// strongest -- never a false verdict, never false balance.
//
// The key ADR-0090 line (empirical defeat vs value disagreement) falls out of
// the debate engine's PREFERRED semantics (ADR-0089 increment 6): a position
// defeated on the facts -- e.g. by a strict proof -- is in NO preferred extension
// (it is simply OUT, reported as refuted, not steelmanned as a peer), whereas two
// genuinely defensible sides each survive as their own preferred extension. So a
// claim is steelmanned only when distinct stances actually survive.

import "debate.nova"

// A position summary: [stance, strength, nargs] over a claim.
//   stance   : net +1 supports the claim, -1 opposes, 0 neutral
//   strength : combined evidence weight of this position's claim-arguments
//   nargs    : how many of its arguments bear on the claim
let POS_STANCE   = 0
let POS_STRENGTH = 1
let POS_NARGS    = 2
let POS_ARGS     = 3   // indices of this position's claim-bearing arguments

fn _pos_new(stance, strength, args) {
    let p = list_new()
    push(p, stance)
    push(p, strength)
    push(p, len(args))
    push(p, args)
    return p
}

fn pos_stance(p)   { return p[POS_STANCE] }
fn pos_strength(p) { return p[POS_STRENGTH] }
fn pos_nargs(p)    { return p[POS_NARGS] }
fn pos_args(p)     { return p[POS_ARGS] }

// Summarize one preferred extension's stance on the claim, keeping the indices of
// the claim-bearing arguments so the render can attach their provenance.
fn _summarize_extension(dargs, ext, claim_id) {
    let stance = 0
    let strength = 0
    let args = list_new()
    let k = 0
    while k < len(ext) {
        let idx = ext[k]
        let d = dargs[idx]
        if d[DARG_CONCL] == claim_id {
            stance = stance + d[DARG_SIGN]
            strength = strength + d[DARG_WEIGHT]
            push(args, idx)
        }
        k = k + 1
    }
    return _pos_new(stance, strength, args)
}

// The steelman positions of a claim: one summary per preferred extension that
// takes a (non-neutral) stance on it. A factually-refuted side is absent (it is
// in no preferred extension), so it is never presented as a peer.
fn steelman_positions(dargs, claim_id) {
    let exts = af_preferred_extensions(debate_build_af(dargs))
    let positions = list_new()
    let i = 0
    while i < len(exts) {
        let pos = _summarize_extension(dargs, exts[i], claim_id)
        if pos[POS_STANCE] != 0 { push(positions, pos) }
        i = i + 1
    }
    return positions
}

// Is the claim genuinely contested -- both a supporting and an opposing position
// survive (steelman all sides) -- as opposed to settled (one surviving stance;
// the other was defeated on the merits, ADR-0090's empirical-defeat line)?
fn steelman_is_contested(dargs, claim_id) {
    let positions = steelman_positions(dargs, claim_id)
    let has_for = 0
    let has_against = 0
    let i = 0
    while i < len(positions) {
        let s = positions[i][POS_STANCE]
        if s > 0 { has_for = 1 }
        if s < 0 { has_against = 1 }
        i = i + 1
    }
    if has_for == 1 {
        if has_against == 1 { return 1 }
    }
    return 0
}

fn _max_strength(positions) {
    let m = 0
    let i = 0
    while i < len(positions) {
        if positions[i][POS_STRENGTH] > m { m = positions[i][POS_STRENGTH] }
        i = i + 1
    }
    return m
}

// Render the steelman as user-facing text: for a contested claim, every surviving
// position at its strength, labelled consensus (strongest evidence) vs minority
// to resist false balance (ADR-0090). For a settled claim, the supported side.
fn steelman_render(dargs, claim_id) {
    let positions = steelman_positions(dargs, claim_id)
    if len(positions) == 0 {
        return "Claim #" + int_to_str(claim_id) + ": no evidenced position.\n"
    }
    let maxs = _max_strength(positions)
    let out = "Claim #" + int_to_str(claim_id) + " -- "
    if steelman_is_contested(dargs, claim_id) == 1 {
        out = out + "CONTESTED; evidenced positions (steelmanned):\n"
    } else {
        out = out + "supported position:\n"
    }
    let j = 0
    while j < len(positions) {
        let p = positions[j]
        let stance = "SUPPORTS"
        if p[POS_STANCE] < 0 { stance = "OPPOSES" }
        let label = "minority"
        if p[POS_STRENGTH] == maxs { label = "consensus" }
        out = out + "  - " + stance + " the claim (evidence strength "
            + int_to_str(p[POS_STRENGTH]) + ", " + label + ")\n"
        j = j + 1
    }
    return out
}

// Steelman a claim atom directly from the reasoning KG (construct -> debate ->
// steelman).
fn steelman_atom_render(rkg, claim_id) {
    return steelman_render(construct_arguments(rkg, claim_id), claim_id)
}

fn steelman_atom_positions(rkg, claim_id) {
    return steelman_positions(construct_arguments(rkg, claim_id), claim_id)
}

// Render the steelman WITH each position's provenance chain (ADR-0090/0087):
// every surviving position, its stance and strength, consensus/minority label,
// and -- for each of its arguments -- the premise atom + evidence grade and the
// source it rests on (via debate.nova's _darg_prov_str). Needs the KG to resolve
// the premise/rule atom ids.
fn steelman_render_prov(rkg, dargs, claim_id) {
    let positions = steelman_positions(dargs, claim_id)
    if len(positions) == 0 {
        return "Claim #" + int_to_str(claim_id) + ": no evidenced position.\n"
    }
    let maxs = _max_strength(positions)
    let out = "Claim #" + int_to_str(claim_id) + " -- "
    if steelman_is_contested(dargs, claim_id) == 1 {
        out = out + "CONTESTED; evidenced positions (steelmanned):\n"
    } else {
        out = out + "supported position:\n"
    }
    let j = 0
    while j < len(positions) {
        let p = positions[j]
        let stance = "SUPPORTS"
        if p[POS_STANCE] < 0 { stance = "OPPOSES" }
        let label = "minority"
        if p[POS_STRENGTH] == maxs { label = "consensus" }
        out = out + "  - " + stance + " (strength " + int_to_str(p[POS_STRENGTH])
            + ", " + label + "):\n"
        let pargs = p[POS_ARGS]
        let k = 0
        while k < len(pargs) {
            out = out + "      from " + _darg_prov_str(rkg, dargs[pargs[k]]) + "\n"
            k = k + 1
        }
        j = j + 1
    }
    return out
}

fn steelman_atom_render_prov(rkg, claim_id) {
    return steelman_render_prov(rkg, construct_arguments(rkg, claim_id), claim_id)
}
