// Full governed-promotion pass (ADR-0092): the complete gate ladder that
// govern_fetched_atom (the extraction-time license-only gate) was the down-
// payment on. Where govern_fetched_atom enforces only Rule 3 (license) at mint
// time, this pass runs ALL of ADR-0092's ordered gates on a candidate:
//   (4) governance freeze, (a) license, (e) protected-conflict, (b/c/d) grade
//   assignment (proof / corroboration), (f) debate adjudication.
//
// The pass has two layers, split so the substance is runtime-verifiable:
//   - promo_apply: the gate-runner + audit. Given a fully-formed claim
//     descriptor + the registries + the debate verdict, it calls cand_promote
//     (the real gate ladder) and records the outcome to the decision log. This
//     is unit-tested directly across every gate outcome.
//   - the KG-input gatherers (promo_corroboration / promo_find_conflict) and
//     the full promo_run wrapper that calls debate_verdict_for: these read the
//     reasoning KG via the operator walk (rk_operators_to). Under the current
//     bootstrap launcher that walk depends on atom_payload_get -> str_eq, which
//     mis-compiles, so they are compile-verified and logic-reviewed (the same
//     scope cut every KG-construct path in this tree carries).
//
// The recorder lives at THIS layer, not in promotion.nova, because it needs the
// debate engine (debate_verdict_for) + decision_record, and decision_record
// imports the debate engine which imports promotion -- recording from inside
// promotion would cycle.
//
// ADRs implemented: ADR-0092 (full promotion pass), ADR-0089 (gate f verdict),
// ADR-0043 (audit). CrossEngin dependencies: src/parts/reasoning/debate.nova
// (debate_verdict_for + the operator walk), src/parts/reasoning/
// decision_record.nova (DREC_PROMOTION audit), src/learning/promotion.nova
// (cand_promote + claim_new + pctx_new, via the imports above).

import "debate.nova"
import "decision_record.nova"

// ---- audit handle (same wired-or-not idiom as cr_/lp_set_audit_log) --------
let _promo_audit_handle = list_new()

fn promo_set_audit_log(log) {
    if len(_promo_audit_handle) == 0 { push(_promo_audit_handle, log) }
    else { list_set(_promo_audit_handle, 0, log) }
}

fn _promo_audit_log() {
    if len(_promo_audit_handle) == 0 { return 0 }
    return _promo_audit_handle[0]
}

// ---- the gate-runner (runtime-tested) --------------------------------------
//
// Run the full ADR-0092 ladder on `atom` given a prepared claim descriptor
// (claim_new), the registries (pctx_new), and the gate-(f) debate verdict
// (DEBATE_PASSED / FAILED / NONE). Records the terminal state to the decision
// log when one is wired. Returns the state. `now` stamps the audit entry.
fn promo_apply(atom, claim, pctx, debate_verdict, now) {
    let state = cand_promote(atom, claim, pctx, debate_verdict)
    let log = _promo_audit_log()
    if log != 0 {
        dlog_record_promotion(log, atom, atom_id(atom), state, now)
    }
    return state
}

// ---- KG-input gatherers (compile-verified; see header) ---------------------

// Source-label equality without str_eq (launcher-flaky): char-by-char, with a
// length short-circuit. Used to dedup corroborating sources.
fn _promo_src_eq(a, b) {
    let n = len(a)
    if n != len(b) { return 0 }
    let i = 0
    while i < n {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn _promo_seen(seen, label) {
    let i = 0
    while i < len(seen) {
        if _promo_src_eq(seen[i], label) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Corroboration = the number of DISTINCT sources among the (non-oppositional)
// operators concluding `claim_id`. Each operator's source is its atom label
// (the src-prefixed string rop_new stamped). Two operators from the same page
// count once; two from different pages count as independent corroboration --
// the ADR-0092 (d) signal that lifts a lone fetch (EMPIRICAL_WEAK) to
// EMPIRICAL_STRONG once CAND_STRONG_CORROBORATION distinct sources agree.
fn promo_corroboration(rkg, claim_id) {
    let ops = rk_operators_to(rkg, claim_id)
    let seen = list_new()
    let i = 0
    while i < len(ops) {
        let op = ops[i]
        if rop_kind(op) != ROP_OPPOSITE {
            let src = atom_label(op)
            if _promo_seen(seen, src) == 0 { push(seen, src) }
        }
        i = i + 1
    }
    return len(seen)
}

// Find an existing atom the candidate contradicts (ADR-0092 gate e): the
// premise of an oppositional operator concluding `claim_id`. Returns the atom
// (so cand_promote can check cand_is_protected on it) or 0 if none.
fn promo_find_conflict(rkg, claim_id) {
    let ops = rk_operators_to(rkg, claim_id)
    let i = 0
    while i < len(ops) {
        let op = ops[i]
        if rop_kind(op) == ROP_OPPOSITE {
            let prem = kg_atom(rkg, rop_premise(op))
            if prem != 0 { return prem }
        }
        i = i + 1
    }
    return 0
}

// ---- the full pass (compile-verified; see header) --------------------------
//
// Bundle the formal hint so promo_run stays within NOVA's 6-arg passing limit.
let PROMO_HINT_FORMAL = 0   // 1 if the claim is formally tractable
let PROMO_HINT_PROOF  = 1   // KG-proofs ref for a formal claim, or PROV_NONE

fn promo_hint_new(formally_tractable, proof_code) {
    let h = list_new()
    push(h, formally_tractable); push(h, proof_code)
    return h
}

// The complete pass on a candidate atom already living in the reasoning KG:
// gather corroboration + conflict from the KG, compute the gate-(f) debate
// verdict (construct arguments -> grounded acceptability -> Bayesian
// adjudication), build the claim descriptor, and run the gate ladder + audit.
// Returns the terminal CAND_* state.
fn promo_run(pctx, rkg, atom, src_label, hint, now) {
    let corrob = promo_corroboration(rkg, atom_id(atom))
    let conflict = promo_find_conflict(rkg, atom_id(atom))
    let claim = claim_new(src_label, corrob,
        hint[PROMO_HINT_FORMAL], hint[PROMO_HINT_PROOF], conflict)
    let verdict = debate_verdict_for(rkg, atom_id(atom))
    return promo_apply(atom, claim, pctx, verdict, now)
}
