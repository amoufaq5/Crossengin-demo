// CrossEngin reasoning: strategy functions.
//
// Purpose
//   The five thin reasoning strategies of ADR-0031, operating over operator
//   atoms (reasoning_atoms) and producing atom-grounded conclusions plus an
//   auditable trace -- never text (ADR-0014):
//     - forward chaining: follow causal/implicative operators from a seed,
//       harvesting reachable conclusions and recording each step.
//     - abductive: best explanation -- the highest-confidence causal premise of
//       an observation.
//     - analogical transfer: the conclusion of the strongest analogical operator
//       from a source.
//     - evidential combine: Bayesian confidence composition -- multiplicative
//       along a chain, noisy-OR across independent support.
//     - means-ends: decompose a goal into the premises that imply it (subgoals
//       feeding ADR-0033).
//
//   Confidences are milli. A trace step is [operator_id, premise, conclusion,
//   confidence].
//
// ADRs implemented: ADR-0031 (reasoning strategies). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/parts/reasoning/reasoning_atoms.nova.

import "reasoning_atoms.nova"

fn _rm_visited(visited, id) {
    let i = 0
    while i < len(visited) {
        if visited[i] == id { return 1 }
        i = i + 1
    }
    return 0
}

fn _rm_is_chaining(kind) {
    if kind == ROP_CAUSAL { return 1 }
    if kind == ROP_IMPLY { return 1 }
    return 0
}

// Forward chaining: bounded propagation from a seed along causal/implicative
// operators. Returns a trace (list of [op_id, premise, conclusion, confidence]).
fn reason_forward_chain(rkg, seed_id, max_steps) {
    let trace = list_new()
    let visited = list_new()
    push(visited, seed_id)
    let frontier = list_new()
    push(frontier, seed_id)
    let step = 0
    while step < max_steps {
        if len(frontier) == 0 { step = max_steps }
        else {
            let next = list_new()
            let f = 0
            while f < len(frontier) {
                let ops = rk_operators_from(rkg, frontier[f])
                let j = 0
                while j < len(ops) {
                    if _rm_is_chaining(rop_kind(ops[j])) == 1 {
                        let c = rop_conclusion(ops[j])
                        let entry = list_new()
                        push(entry, atom_id(ops[j]))
                        push(entry, frontier[f])
                        push(entry, c)
                        push(entry, rop_confidence(ops[j]))
                        push(trace, entry)
                        if _rm_visited(visited, c) == 0 {
                            push(visited, c)
                            push(next, c)
                        }
                    }
                    j = j + 1
                }
                f = f + 1
            }
            frontier = next
            step = step + 1
        }
    }
    return trace
}

// Distinct conclusion ids derived in a trace.
fn reason_conclusions(trace) {
    let out = list_new()
    let i = 0
    while i < len(trace) {
        if _rm_visited(out, trace[i][2]) == 0 { push(out, trace[i][2]) }
        i = i + 1
    }
    return out
}

// Abductive: the highest-confidence causal premise that explains an observation
// (-1 if none).
fn reason_abductive(rkg, observation_id) {
    let ops = rk_operators_to(rkg, observation_id)
    let best = -1
    let best_conf = 0 - 1
    let i = 0
    while i < len(ops) {
        if rop_kind(ops[i]) == ROP_CAUSAL {
            if rop_confidence(ops[i]) > best_conf {
                best_conf = rop_confidence(ops[i])
                best = rop_premise(ops[i])
            }
        }
        i = i + 1
    }
    return best
}

// Analogical transfer: the conclusion of the strongest analogical operator from
// a source (-1 if none).
fn reason_analogical_transfer(rkg, source_id) {
    let ops = rk_operators_from(rkg, source_id)
    let best = -1
    let best_conf = 0 - 1
    let i = 0
    while i < len(ops) {
        if rop_kind(ops[i]) == ROP_ANALOGY {
            if rop_confidence(ops[i]) > best_conf {
                best_conf = rop_confidence(ops[i])
                best = rop_conclusion(ops[i])
            }
        }
        i = i + 1
    }
    return best
}

// Means-ends: the premises of implicative operators concluding the goal -- the
// subgoals whose satisfaction implies it.
fn reason_means_ends(rkg, goal_id) {
    let ops = rk_operators_to(rkg, goal_id)
    let out = list_new()
    let i = 0
    while i < len(ops) {
        if rop_kind(ops[i]) == ROP_IMPLY { push(out, rop_premise(ops[i])) }
        i = i + 1
    }
    return out
}

// Evidential composition along a chain: confidences multiply (each uncertain
// link weakens the whole). Milli; empty chain -> 1.0.
fn reason_evidential_chain(confidences) {
    let result = 1000
    let i = 0
    while i < len(confidences) {
        result = result * confidences[i] / 1000
        i = i + 1
    }
    return result
}

// Evidential composition across independent support: noisy-OR (each source
// raises confidence). Milli.
fn reason_evidential_support(confidences) {
    let result = 0
    let i = 0
    while i < len(confidences) {
        result = result + confidences[i] - result * confidences[i] / 1000
        i = i + 1
    }
    return result
}
