// Contradiction detection for the proof kernel (ADR-0088 / ADR-0086): a
// truth-seeking engine must be able to notice when its OWN believed facts entail
// a contradiction -- and, in keeping with the kernel discipline, it should PROVE
// the inconsistency rather than merely assert it.
//
// The kernel has implication (TERM_IMP) and modus ponens but no primitive
// negation. We don't need one: classically, negation is
//     not P  ==  P -> FALSE
// where FALSE is a reserved absurdity atom (bottom). Then a contradiction is just
// holding both P and (P -> FALSE), and a single modus-ponens step derives FALSE:
//     MP( (P -> FALSE), P )  |-  FALSE.
// That proof is checked by the EXISTING trusted kernel (verify_check) -- this
// module adds NO new inference rule and does not touch verify.nova. It only
// recognizes the negation pattern and assembles the kernel-checkable witness.
//
// The reserved bottom label is "_FALSE_"; do not use it as an ordinary KB atom.
//
// NOVA gotchas: term-kind tags are small ints (== / != safe); term_eq is the
// trusted structural compare; no function exceeds 6 params. CrossEngin
// dependencies: src/mind/verify.nova only.

import "../../mind/verify.nova"
import "../../mind/search_back.nova"

// ---- the bottom atom and negation pattern ----------------------------------
// FALSE / bottom -- a reserved atom no true belief should ever equal.
fn con_false() { return term_atom("_FALSE_") }

// not P  ==  P -> FALSE.
fn con_not(p) { return term_imp(p, con_false()) }

fn con_is_false(t) { return term_eq(t, con_false()) }

// Is `t` a negation, i.e. of the form (X -> FALSE)?
fn con_is_negation(t) {
    if t_kind_safe(t) != TERM_IMP { return 0 }
    return con_is_false(t[2])
}

// The X inside a negation (X -> FALSE). Precondition: con_is_negation(t) == 1.
fn con_negated_of(t) { return t[1] }

// ---- the contradiction witness ---------------------------------------------
// Given a proof of P and a proof of (P -> FALSE), assemble the one modus-ponens
// step that derives FALSE. (No verification here -- just construction.)
fn con_contradiction_proof(proof_p, proof_notp) {
    return pf_mp(con_false(), proof_notp, proof_p)
}

// Assemble AND certify: returns 1 iff the kernel verifies that proof_p (|- P) and
// proof_notp (|- P -> FALSE) together prove FALSE under (axioms, hyps).
fn con_certify(reg, axioms, hyps, proof_p, proof_notp) {
    let mp = con_contradiction_proof(proof_p, proof_notp)
    return verify_check(reg, axioms, hyps, mp, con_false())
}

// ---- scanning a belief set for inconsistency -------------------------------
// Scan an axiom table for a P together with its negation (P -> FALSE). On the
// first contradictory pair, build the FALSE proof and CONFIRM it through the
// trusted kernel; return [found(1), proof]. Otherwise [0, 0]. Because the witness
// is kernel-checked, a "found" verdict is a proof of inconsistency, not a guess.
fn con_scan_axioms(reg, axioms, hyps) {
    let i = 0
    while i < len(axioms) {
        let neg = axioms[i]
        if con_is_negation(neg) == 1 {
            let inner = con_negated_of(neg)        // the P in (P -> FALSE)
            let j = 0
            while j < len(axioms) {
                if term_eq(axioms[j], inner) == 1 {
                    let proof_p = pf_axiom(axioms[j])
                    let proof_notp = pf_axiom(neg)
                    let mp = con_contradiction_proof(proof_p, proof_notp)
                    if verify_check(reg, axioms, hyps, mp, con_false()) == 1 {
                        let r = list_new() push(r, 1) push(r, mp) return r
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    let r = list_new() push(r, 0) push(r, 0) return r
}

fn con_found(r) { return r[0] }
fn con_proof(r) { return r[1] }

// A belief set is CONSISTENT if no kernel-certified contradiction is found.
fn con_is_consistent(reg, axioms, hyps) {
    if con_found(con_scan_axioms(reg, axioms, hyps)) == 1 { return 0 }
    return 1
}

// ---- transitive scan: catch DERIVED contradictions --------------------------
// A belief set may be inconsistent WITHOUT a literal P + not-P pair. For
// example {P, P -> Q, not Q}: no direct pair, but modus ponens gives Q, which
// contradicts not Q. con_scan_axioms alone misses this. con_scan_transitive
// uses the untrusted backward search (sb_prove) to try to derive the inner X
// of every not X in the belief set. On success, it composes the derived proof
// of X with pf_axiom(not X) via MP, then the trusted kernel verifies it -- a
// found verdict remains a kernel-checked proof of FALSE, never a heuristic.
// `budget` bounds the search depth (typical values 8-16); larger budgets find
// deeper chains at proportionally more work.
fn con_scan_transitive(reg, axioms, hyps, budget) {
    let premises = list_new()
    let i = 0
    while i < len(axioms) {
        push(premises, axioms[i])
        i = i + 1
    }
    let j = 0
    while j < len(axioms) {
        let neg = axioms[j]
        if con_is_negation(neg) == 1 {
            let inner = con_negated_of(neg)
            let proof_inner = sb_prove(premises, inner, budget)
            if proof_inner != 0 {
                let mp = pf_mp(con_false(), pf_axiom(neg), proof_inner)
                if verify_check(reg, axioms, hyps, mp, con_false()) == 1 {
                    let r = list_new() push(r, 1) push(r, mp) return r
                }
            }
        }
        j = j + 1
    }
    let r = list_new() push(r, 0) push(r, 0) return r
}

// A belief set is TRANSITIVELY consistent up to `budget`: no contradiction is
// exhibitable within a proof search of that depth. Bounded, not decidable --
// but every "inconsistent" verdict is a real kernel-checked witness.
fn con_is_consistent_transitive(reg, axioms, hyps, budget) {
    if con_found(con_scan_transitive(reg, axioms, hyps, budget)) == 1 { return 0 }
    return 1
}

// ---- conflict-set extraction -----------------------------------------------
// "Inconsistent" by itself is a weak answer -- for debugging or belief revision
// the load-bearing question is WHICH premises entail the contradiction. Walk the
// kernel-verified FALSE witness and collect its AXIOM-leaf terms: those are the
// premises the proof actually depends on. Deduplicated by structural term_eq.
// Handles the proof shapes the transitive scan can produce (AXIOM / AND_I /
// AND_EL / AND_ER / MP) plus HYP defensively (returned unchanged -- no leaf).
fn _con_has_term(seen, t) {
    let i = 0
    while i < len(seen) {
        if term_eq(seen[i], t) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _con_collect_axioms(p, out) {
    if p == 0 { return 0 }
    if len(p) < 2 { return 0 }
    let rule = proof_rule(p)
    if rule == PROOF_AXIOM {
        let concl = proof_conclusion(p)
        if _con_has_term(out, concl) == 0 { push(out, concl) }
        return 0
    }
    // MP / AND_I: two sub-proofs at positions 2, 3.
    if rule == PROOF_MP {
        if len(p) >= 4 { _con_collect_axioms(p[2], out) _con_collect_axioms(p[3], out) }
        return 0
    }
    if rule == PROOF_AND_I {
        if len(p) >= 4 { _con_collect_axioms(p[2], out) _con_collect_axioms(p[3], out) }
        return 0
    }
    // AND_EL / AND_ER: one sub-proof at position 2.
    if rule == PROOF_AND_EL {
        if len(p) >= 3 { _con_collect_axioms(p[2], out) }
        return 0
    }
    if rule == PROOF_AND_ER {
        if len(p) >= 3 { _con_collect_axioms(p[2], out) }
        return 0
    }
    // PROOF_HYP: not a search product; treat as leaf, no axiom to add.
    return 0
}

fn con_used_premises(proof) {
    let out = list_new()
    _con_collect_axioms(proof, out)
    return out
}

// The one-call convenience: scan for an inconsistency (transitive) and return
// the CONFLICT SET -- the premises the FALSE witness rests on. Returns
// [found(0/1), proof, conflict_set]. Callers can render the set for debugging
// (e.g., print the labels of the offending axioms).
fn con_conflict_set(reg, axioms, hyps, budget) {
    let r = con_scan_transitive(reg, axioms, hyps, budget)
    let out = list_new()
    if con_found(r) == 1 {
        push(out, 1)
        push(out, con_proof(r))
        push(out, con_used_premises(con_proof(r)))
        return out
    }
    push(out, 0) push(out, 0) push(out, list_new())
    return out
}

fn con_cs_found(r)    { return r[0] }
fn con_cs_proof(r)    { return r[1] }
fn con_cs_premises(r) { return r[2] }

// ---- proof pretty-printing --------------------------------------------------
// Render a term as a human-readable string. Recognizes the negation shape
// (X -> FALSE) as "not X" and FALSE itself as "FALSE". Falls back to "?" for
// term kinds this renderer doesn't handle (predicates, quantifiers, arith),
// which don't appear in the FALSE witnesses produced by the transitive scan.
fn con_render_term(t) {
    if t == 0 { return "?" }
    if con_is_false(t) == 1 { return "FALSE" }
    let k = term_kind(t)
    if k == TERM_ATOM { return t[1] }
    if k == TERM_IMP {
        if con_is_false(t[2]) == 1 { return "not " + con_render_term(t[1]) }
        return "(" + con_render_term(t[1]) + " -> " + con_render_term(t[2]) + ")"
    }
    if k == TERM_AND {
        return "(" + con_render_term(t[1]) + " and " + con_render_term(t[2]) + ")"
    }
    return "?"
}

// Look up a term's annotation in a parallel [term, string] pair list. Returns
// "" if not present (or if annotations is an empty list). Used to append
// per-axiom-leaf provenance ("[user-taught]") to a rendered derivation.
fn _con_annotation_for(t, annotations) {
    if annotations == 0 { return "" }
    let i = 0
    while i < len(annotations) {
        let pair = annotations[i]
        if term_eq(pair[0], t) == 1 { return pair[1] }
        i = i + 1
    }
    return ""
}

// Post-order walker: emit lines describing each proof step and return the
// 1-based step number of the step just pushed (so parents can reference their
// children by number). Handles the shapes that appear in transitive-scan
// FALSE witnesses (AXIOM / MP / AND_I / AND_EL / AND_ER). PROOF_HYP is treated
// defensively as a bare fact citation. `annotations` is a list of [term, str]
// pairs -- when non-empty, each AXIOM / HYP leaf that matches gets its string
// appended in brackets ("assume p [user-taught]"). Pass an empty list to
// suppress annotations.
fn _con_render_walk(p, lines, annotations) {
    if p == 0 { return 0 }
    let rule = proof_rule(p)
    let concl = proof_conclusion(p)
    if rule == PROOF_AXIOM {
        let line = "assume " + con_render_term(concl)
        let a = _con_annotation_for(concl, annotations)
        if len(a) > 0 { line = line + " [" + a + "]" }
        push(lines, line)
        return len(lines)
    }
    if rule == PROOF_HYP {
        let line = "given " + con_render_term(concl)
        let a = _con_annotation_for(concl, annotations)
        if len(a) > 0 { line = line + " [" + a + "]" }
        push(lines, line)
        return len(lines)
    }
    if rule == PROOF_MP {
        let ip = _con_render_walk(p[2], lines, annotations)
        let ap = _con_render_walk(p[3], lines, annotations)
        push(lines, "by MP from step " + int_to_str(ip) + " and step "
            + int_to_str(ap) + ": " + con_render_term(concl))
        return len(lines)
    }
    if rule == PROOF_AND_I {
        let lp = _con_render_walk(p[2], lines, annotations)
        let rp = _con_render_walk(p[3], lines, annotations)
        push(lines, "combine step " + int_to_str(lp) + " and step "
            + int_to_str(rp) + ": " + con_render_term(concl))
        return len(lines)
    }
    if rule == PROOF_AND_EL {
        let cp = _con_render_walk(p[2], lines, annotations)
        push(lines, "from step " + int_to_str(cp) + " take left: "
            + con_render_term(concl))
        return len(lines)
    }
    if rule == PROOF_AND_ER {
        let cp = _con_render_walk(p[2], lines, annotations)
        push(lines, "from step " + int_to_str(cp) + " take right: "
            + con_render_term(concl))
        return len(lines)
    }
    // Unknown / unhandled rule: emit the conclusion as a bare step.
    push(lines, "step: " + con_render_term(concl))
    return len(lines)
}

// Pretty-print a proof as a numbered derivation, one step per line. The output
// reads bottom-up (leaves first, conclusion last), matching how a human would
// read a derivation.
fn con_render_proof(p) {
    return con_render_proof_annotated(p, list_new())
}

// Same as con_render_proof, but each AXIOM / HYP leaf whose term appears in
// `annotations` (a list of [term, string] pairs) gets its string appended in
// brackets -- e.g. "assume p [user-taught]". Turns a bare derivation into an
// audit trail: users see WHO / WHERE each premise came from, not just its shape.
fn con_render_proof_annotated(p, annotations) {
    let lines = list_new()
    _con_render_walk(p, lines, annotations)
    let out = ""
    let i = 0
    while i < len(lines) {
        if len(out) > 0 { out = out + "\n" }
        out = out + int_to_str(i + 1) + ". " + lines[i]
        i = i + 1
    }
    return out
}
