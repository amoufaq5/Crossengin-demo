// Debate adjudication (ADR-0089, stage 5 + the rebut wiring of stage 3): binds
// abstract arguments to claims and turns "which arguments survive" (the grounded
// extension, argumentation.nova) into "how confident are we" (a Beta posterior
// over the surviving arguments' evidence, ADR-0023/0087).
//
// A debate argument (darg) is the bridge from the abstract AF to beliefs:
//   [conclusion_id, sign, weight, strict]
//     conclusion_id : the claim this argument concludes (an integer key)
//     sign          : +1 supports the claim, -1 attacks it (rebut)
//     weight        : evidence mass it contributes (milli), derived upstream from
//                     its premises' belief strength x evidence grade (ADR-0087)
//     strict        : 1 if a proof/strict argument (FORMAL, ADR-0088), else 0
//
// Stage 1-2 (constructing dargs from atoms + strict/defeasible rules) and the
// undercut/undermine attacks are later increments; this layer takes dargs as
// given and does the rebut attacks + acceptability + adjudication.

import "argumentation.nova"
import "reasoning_atoms.nova"
import "../../kg/atom_store.nova"

let DARG_CONCL  = 0
let DARG_SIGN   = 1
let DARG_WEIGHT = 2
let DARG_STRICT = 3

fn darg_new(conclusion_id, sign, weight, strict) {
    let d = list_new()
    push(d, conclusion_id)
    push(d, sign)
    push(d, weight)
    push(d, strict)
    return d
}

fn darg_conclusion(d) { return d[DARG_CONCL] }
fn darg_sign(d)       { return d[DARG_SIGN] }
fn darg_weight(d)     { return d[DARG_WEIGHT] }
fn darg_strict(d)     { return d[DARG_STRICT] }

// Build the rebut attack relation over a list of dargs: two arguments with the
// same conclusion and OPPOSITE sign attack each other. ASPIC+ asymmetry: a
// strict argument (a proof) defeats a defeasible opponent but is not rebutted
// back; two arguments of the same strictness attack each other (mutual).
fn debate_build_af(dargs) {
    let n = len(dargs)
    let af = af_new(n)
    let i = 0
    while i < n {
        let j = i + 1
        while j < n {
            let a = dargs[i]
            let b = dargs[j]
            if a[DARG_CONCL] == b[DARG_CONCL] {
                if a[DARG_SIGN] != b[DARG_SIGN] {
                    let as = a[DARG_STRICT]
                    let bs = b[DARG_STRICT]
                    if as == bs {
                        // equal strictness -> mutual rebut
                        af_attack(af, i, j)
                        af_attack(af, j, i)
                    } else {
                        if as == 1 {
                            af_attack(af, i, j)   // strict a defeats defeasible b
                        } else {
                            af_attack(af, j, i)   // strict b defeats defeasible a
                        }
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return af
}

// Adjudicate a claim's confidence (milli, 0..1000) from the SURVIVING (grounded-
// IN) arguments only: each IN argument supporting the claim adds to alpha, each
// IN argument against it adds to beta; confidence is the Beta mean over the
// uniform prior. A claim with no surviving argument either way returns the prior
// 500 (genuinely undecided -- e.g. an unresolved rebut cycle), which is the
// contested signal that ADR-0090 steelmans rather than collapsing.
fn debate_adjudicate(dargs, label, claim_id) {
    let alpha = BEL_PRIOR
    let beta = BEL_PRIOR
    let i = 0
    while i < len(dargs) {
        if label[i] == ARG_IN {
            let d = dargs[i]
            if d[DARG_CONCL] == claim_id {
                if d[DARG_SIGN] > 0 {
                    alpha = alpha + d[DARG_WEIGHT]
                } else {
                    beta = beta + d[DARG_WEIGHT]
                }
            }
        }
        i = i + 1
    }
    return alpha * FP_SCALE / (alpha + beta)
}

// Full stages 3-5 for one claim: build the rebut AF, compute grounded
// acceptability, adjudicate the claim's confidence.
fn debate_decide(dargs, claim_id) {
    let af = debate_build_af(dargs)
    let label = af_grounded(af)
    return debate_adjudicate(dargs, label, claim_id)
}

// ---- stages 1-2: construct arguments from real atoms (ADR-0089) -----------

// Derive an argument's evidence weight (milli) from its premise atom: the
// premise's confidence (belief mean, ADR-0023) scaled by its evidence grade
// (grade_weight, ADR-0087 increment 3). A FORMAL (proof-backed) premise gets a
// heavy fixed mass so a surviving strict argument adjudicates near-certain.
fn arg_weight_from_atom(premise) {
    let g = atom_evidence_grade(premise)
    if g == GRADE_FORMAL { return 99000 }
    return atom_confidence(premise) * grade_weight(g) / 1000
}

// A premise is a strict basis iff it is FORMAL (machine-checked proof, ADR-0088).
fn arg_strict_from_atom(premise) {
    if atom_evidence_grade(premise) == GRADE_FORMAL { return 1 }
    return 0
}

// Construct the debate arguments for/against `target_id` from the reasoning KG
// (ADR-0089 stages 1-2). Each operator concluding the target is an argument FOR
// it; an oppositional operator (ROP_OPPOSITE, "X is the opposite of Y") is an
// argument AGAINST. Each argument's weight and strictness come from the
// operator's PREMISE atom (its belief x grade), so the debate is grounded in the
// actual knowledge base rather than synthetic inputs.
fn construct_arguments(rkg, target_id) {
    let dargs = list_new()
    let ops = rk_operators_to(rkg, target_id)
    let i = 0
    while i < len(ops) {
        let op = ops[i]
        let premise = kg_atom(rkg, rop_premise(op))
        if premise != 0 {
            let sign = 1
            if rop_kind(op) == ROP_OPPOSITE { sign = 0 - 1 }
            push(dargs, darg_new(target_id, sign,
                arg_weight_from_atom(premise), arg_strict_from_atom(premise)))
        }
        i = i + 1
    }
    return dargs
}

// Full debate over a KG atom (stages 1-5): construct arguments from the KG, then
// decide the claim's confidence via grounded acceptability + Bayesian adjudication.
fn debate_atom(rkg, target_id) {
    return debate_decide(construct_arguments(rkg, target_id), target_id)
}

fn debate_atom_contested(rkg, target_id) {
    return debate_is_contested(construct_arguments(rkg, target_id), target_id)
}

// ---- ADR-0092 gate (f): promotion as a debate the candidate must win --------

let DEBATE_PROMOTE_THRESHOLD = 600   // milli (0.6): min adjudicated confidence

// Does a candidate's argument win? Promote only if the claim is grounded-accepted
// with confidence >= threshold and is not contested (an unresolved rebut).
fn debate_gate_passes(dargs, claim_id) {
    if debate_is_contested(dargs, claim_id) == 1 { return 0 }
    if debate_decide(dargs, claim_id) >= DEBATE_PROMOTE_THRESHOLD { return 1 }
    return 0
}

// Compute the gate-(f) verdict for a candidate claim atom in the reasoning KG,
// to feed cand_promote: construct arguments (stages 1-2), adjudicate (3-5), and
// return DEBATE_PASSED / DEBATE_FAILED, or DEBATE_NONE when there is nothing to
// debate (no arguments). The DEBATE_* constants come from promotion.nova (imported
// transitively via reasoning_atoms), which is the gate's consumer.
fn debate_verdict_for(rkg, claim_id) {
    let dargs = construct_arguments(rkg, claim_id)
    if len(dargs) == 0 { return DEBATE_NONE }
    if debate_gate_passes(dargs, claim_id) == 1 { return DEBATE_PASSED }
    return DEBATE_FAILED
}

// Is a claim genuinely contested (a surviving argument on neither side, because
// its rebut survived as an unresolved cycle)? True when both a supporting and an
// opposing argument exist for the claim but neither is grounded-IN.
fn debate_is_contested(dargs, claim_id) {
    let af = debate_build_af(dargs)
    let label = af_grounded(af)
    let for_undec = 0
    let against_undec = 0
    let i = 0
    while i < len(dargs) {
        let d = dargs[i]
        if d[DARG_CONCL] == claim_id {
            if label[i] != ARG_IN {
                if d[DARG_SIGN] > 0 { for_undec = 1 } else { against_undec = 1 }
            }
        }
        i = i + 1
    }
    if for_undec == 1 {
        if against_undec == 1 { return 1 }
    }
    return 0
}
