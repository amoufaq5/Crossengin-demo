// Abstract argumentation (ADR-0089, stages 3-4): the symbolic core of the debate
// engine. An argumentation framework is a set of arguments and a binary attack
// relation between them (Dung 1995); acceptability semantics decide which
// arguments survive. This module is the abstract layer -- arguments are opaque
// indices 0..n-1 -- so it is pure (builtins only) and exactly testable. Later
// increments bind arguments to atoms/beliefs (construction + Bayesian
// adjudication, stages 1/2/5) and attach the provenance trace (ADR-0087/0043).
//
// We compute the GROUNDED labelling: the unique, skeptical, least-committed
// position. Each argument is labelled IN (accepted), OUT (rejected -- attacked by
// an accepted argument), or UNDEC (undecided -- e.g. in an attack cycle). It is
// the least fixed point of: an argument is IN iff every attacker is OUT; an
// argument is OUT iff some attacker is IN.

// An AF: [n_args, attacks] where attacks is a list of [attacker, target] pairs.
let AF_N       = 0
let AF_ATTACKS = 1

fn af_new(n_args) {
    let af = list_new()
    push(af, n_args)
    push(af, list_new())
    return af
}

// Record that argument `attacker` attacks argument `target`.
fn af_attack(af, attacker, target) {
    let e = list_new()
    push(e, attacker)
    push(e, target)
    push(af[AF_ATTACKS], e)
    return 1
}

fn af_num_args(af) { return af[AF_N] }
fn af_attacks(af)  { return af[AF_ATTACKS] }

// argument labels
let ARG_UNDEC = 0
let ARG_IN    = 1
let ARG_OUT   = 2

fn arg_label_name(l) {
    if l == ARG_IN  { return "IN" }
    if l == ARG_OUT { return "OUT" }
    return "UNDEC"
}

fn _af_labels_init(n) {
    let v = list_new()
    let i = 0
    while i < n {
        push(v, ARG_UNDEC)
        i = i + 1
    }
    return v
}

// Are ALL attackers of `t` labelled OUT? Vacuously true when `t` has no attacker.
fn _af_all_attackers_out(attacks, t, label) {
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if e[1] == t {
            if label[e[0]] != ARG_OUT { return 0 }
        }
        k = k + 1
    }
    return 1
}

// Is SOME attacker of `t` labelled IN?
fn _af_attacked_by_in(attacks, t, label) {
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if e[1] == t {
            if label[e[0]] == ARG_IN { return 1 }
        }
        k = k + 1
    }
    return 0
}

// Compute the grounded labelling. Returns a list of n labels.
fn af_grounded(af) {
    let n = af_num_args(af)
    let attacks = af_attacks(af)
    let label = _af_labels_init(n)
    let changed = 1
    while changed == 1 {
        changed = 0
        // Promote to IN: every attacker is OUT (or there are none).
        let i = 0
        while i < n {
            if label[i] == ARG_UNDEC {
                if _af_all_attackers_out(attacks, i, label) == 1 {
                    list_set(label, i, ARG_IN)
                    changed = 1
                }
            }
            i = i + 1
        }
        // Demote to OUT: attacked by an IN argument.
        let j = 0
        while j < n {
            if label[j] == ARG_UNDEC {
                if _af_attacked_by_in(attacks, j, label) == 1 {
                    list_set(label, j, ARG_OUT)
                    changed = 1
                }
            }
            j = j + 1
        }
    }
    return label
}

fn arg_is_in(label, i)  { return label[i] == ARG_IN }
fn arg_is_out(label, i) { return label[i] == ARG_OUT }

// The grounded extension: the list of accepted (IN) argument indices.
fn af_grounded_extension(af) {
    let label = af_grounded(af)
    let ext = list_new()
    let i = 0
    while i < af_num_args(af) {
        if label[i] == ARG_IN { push(ext, i) }
        i = i + 1
    }
    return ext
}

// ---- preferred semantics (ADR-0089 stage 4) -------------------------------
//
// Grounded is the unique skeptical position; it leaves an even attack cycle
// UNDECIDED (e.g. A<->B -> empty grounded extension). PREFERRED extensions are
// the maximal admissible sets -- the distinct *coherent positions* a credulous
// reasoner can hold (A<->B -> {A} and {B}). This is what a contested claim needs
// for ADR-0090 steelmanning: each preferred extension is one defensible side.
//
// Enumerating maximal admissible sets is exponential, so this is BOUNDED: above
// PREF_MAX_ARGS arguments it falls back to the (polynomial) grounded extension as
// a single position, per the ADR's "bounded preferred fallback".

let PREF_MAX_ARGS = 16

fn _in_set(mask, i) { return (mask >> i) & 1 }

// Conflict-free: no member of `mask` attacks another member.
fn _af_conflict_free(af, mask) {
    let attacks = af_attacks(af)
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if _in_set(mask, e[0]) == 1 {
            if _in_set(mask, e[1]) == 1 { return 0 }
        }
        k = k + 1
    }
    return 1
}

// Does some member of `mask` attack argument `t`?
fn _af_set_attacks(af, mask, t) {
    let attacks = af_attacks(af)
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if e[1] == t {
            if _in_set(mask, e[0]) == 1 { return 1 }
        }
        k = k + 1
    }
    return 0
}

// Admissible: conflict-free AND every member is defended (each attacker of a
// member is itself attacked by the set).
fn _af_admissible(af, mask) {
    if _af_conflict_free(af, mask) == 0 { return 0 }
    let attacks = af_attacks(af)
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if _in_set(mask, e[1]) == 1 {
            if _af_set_attacks(af, mask, e[0]) == 0 { return 0 }
        }
        k = k + 1
    }
    return 1
}

fn _mask_to_ext(mask, n) {
    let ext = list_new()
    let b = 0
    while b < n {
        if _in_set(mask, b) == 1 { push(ext, b) }
        b = b + 1
    }
    return ext
}

// Preferred extensions: the maximal admissible sets, each a list of arg indices.
fn af_preferred_extensions(af) {
    let n = af_num_args(af)
    let out = list_new()
    if n > PREF_MAX_ARGS {
        push(out, af_grounded_extension(af))
        return out
    }
    let total = 1 << n
    let adm = list_new()
    let mask = 0
    while mask < total {
        if _af_admissible(af, mask) == 1 { push(adm, mask) }
        mask = mask + 1
    }
    // Keep the maximal ones: m is preferred iff no other admissible m2 is a
    // strict superset of m (i.e. (m & m2) == m and m != m2).
    let i = 0
    while i < len(adm) {
        let m = adm[i]
        let maximal = 1
        let j = 0
        while j < len(adm) {
            if j != i {
                let m2 = adm[j]
                if (m & m2) == m {
                    if m != m2 { maximal = 0 }
                }
            }
            j = j + 1
        }
        if maximal == 1 { push(out, _mask_to_ext(m, n)) }
        i = i + 1
    }
    return out
}

// Convenience: how many distinct coherent positions does the framework admit?
fn af_num_positions(af) { return len(af_preferred_extensions(af)) }
