// Abstract argumentation (ADR-0089, stages 3-4): the symbolic core of the debate
// engine. An argumentation framework is a set of arguments and a binary attack
// relation between them (Dung 1995); acceptability semantics decide which
// arguments survive. This module is the abstract layer -- arguments are opaque
// indices 0..n-1 -- so it is pure (builtins only) and exactly testable. Later
// increments bind arguments to atoms/beliefs (construction + Bayesian
// adjudication, stages 1/2/5) and attach the provenance trace (ADR-0087/0043).
//
// We compute the GROUNDED labelling: the unique, skeptical, least-committed
// position. Each argument is labelled IN (accepted), OUT (rejected -- attacked by
// an accepted argument), or UNDEC (undecided -- e.g. in an attack cycle). It is
// the least fixed point of: an argument is IN iff every attacker is OUT; an
// argument is OUT iff some attacker is IN.

// An AF: [n_args, attacks] where attacks is a list of [attacker, target] pairs.
let AF_N       = 0
let AF_ATTACKS = 1

fn af_new(n_args) {
    let af = list_new()
    push(af, n_args)
    push(af, list_new())
    return af
}

// Record that argument `attacker` attacks argument `target`.
fn af_attack(af, attacker, target) {
    let e = list_new()
    push(e, attacker)
    push(e, target)
    push(af[AF_ATTACKS], e)
    return 1
}

fn af_num_args(af) { return af[AF_N] }
fn af_attacks(af)  { return af[AF_ATTACKS] }

// argument labels
let ARG_UNDEC = 0
let ARG_IN    = 1
let ARG_OUT   = 2

fn arg_label_name(l) {
    if l == ARG_IN  { return "IN" }
    if l == ARG_OUT { return "OUT" }
    return "UNDEC"
}

fn _af_labels_init(n) {
    let v = list_new()
    let i = 0
    while i < n {
        push(v, ARG_UNDEC)
        i = i + 1
    }
    return v
}

// Are ALL attackers of `t` labelled OUT? Vacuously true when `t` has no attacker.
fn _af_all_attackers_out(attacks, t, label) {
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if e[1] == t {
            if label[e[0]] != ARG_OUT { return 0 }
        }
        k = k + 1
    }
    return 1
}

// Is SOME attacker of `t` labelled IN?
fn _af_attacked_by_in(attacks, t, label) {
    let k = 0
    while k < len(attacks) {
        let e = attacks[k]
        if e[1] == t {
            if label[e[0]] == ARG_IN { return 1 }
        }
        k = k + 1
    }
    return 0
}

// Compute the grounded labelling. Returns a list of n labels.
fn af_grounded(af) {
    let n = af_num_args(af)
    let attacks = af_attacks(af)
    let label = _af_labels_init(n)
    let changed = 1
    while changed == 1 {
        changed = 0
        // Promote to IN: every attacker is OUT (or there are none).
        let i = 0
        while i < n {
            if label[i] == ARG_UNDEC {
                if _af_all_attackers_out(attacks, i, label) == 1 {
                    list_set(label, i, ARG_IN)
                    changed = 1
                }
            }
            i = i + 1
        }
        // Demote to OUT: attacked by an IN argument.
        let j = 0
        while j < n {
            if label[j] == ARG_UNDEC {
                if _af_attacked_by_in(attacks, j, label) == 1 {
                    list_set(label, j, ARG_OUT)
                    changed = 1
                }
            }
            j = j + 1
        }
    }
    return label
}

fn arg_is_in(label, i)  { return label[i] == ARG_IN }
fn arg_is_out(label, i) { return label[i] == ARG_OUT }

// The grounded extension: the list of accepted (IN) argument indices.
fn af_grounded_extension(af) {
    let label = af_grounded(af)
    let ext = list_new()
    let i = 0
    while i < af_num_args(af) {
        if label[i] == ARG_IN { push(ext, i) }
        i = i + 1
    }
    return ext
}
