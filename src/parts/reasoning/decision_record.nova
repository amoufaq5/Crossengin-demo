// Persist reasoning adjudications to the decision log (ADR-0043 + ADR-0089/0090/
// 0092). The debate engine, steelman, and governed promotion all produce a
// verdict the system must be able to JUSTIFY after the fact -- "why is this
// claim promoted / contested / refuted". The authoritative, tamper-evident,
// durable record of "what the system did and why" is the decision log
// (decision_log.nova): hash-chained, crash-safe, never mutated. This module is
// the bridge: it turns a debate trace / steelman position set / promotion
// outcome into ONE immutable DLK_DECISION entry, so every governance decision
// lands in the same audit substrate as effector actions and survives a restart.
//
// The decision log's fields are generic ints; this module owns their reasoning
// semantics (decision_log.nova stays domain-free, the way audit_writer owns the
// effector semantics). A DLK_DECISION entry is laid out as:
//   kind    = DLK_DECISION
//   ref     = -1 (a decision references no prior intent)
//   goal    = the claim atom id the decision is about
//   desc    = [ACLASS_REASONING, subtype, scalar, flag]
//               subtype : DREC_DEBATE / DREC_PROMOTION / DREC_STEELMAN
//               scalar  : debate->adjudicated confidence (milli);
//                         promotion->assigned evidence grade;
//                         steelman->number of surviving positions
//               flag    : debate/steelman->contested (0/1);
//                         promotion->terminal cand_state
//   trace   = the argument records (debate/steelman; see _dargs_to_dlog_trace),
//             the "show your work" the audit reader can re-walk
//   outcome = OUT_OK if the claim was decided/promoted, OUT_VETOED if it was
//             contested / failed the gate
//
// As decision_log.nova documents, the trace list is NOT serialized to disk (it
// is bulky + reconstructible from the snapshot); the entry's HASH is computed
// over it, so a durable round-trip keeps the same hash with an empty trace --
// the scalar/flag/goal that matter for audit ARE on the wire.
//
// ADRs implemented: ADR-0043 (decision log) x ADR-0089/0090/0092. CrossEngin
// dependencies: src/parts/reasoning/debate.nova (-> steelman/argumentation/
// reasoning_atoms/promotion/atom_store) and src/audit/decision_log.nova.

import "steelman.nova"
import "../../audit/decision_log.nova"

// Reasoning lives in its own action-class lane so the audit reader never feeds a
// DLK_DECISION entry's subtype through the effector act_name() table.
let ACLASS_REASONING = 4350

// Decision subtypes (the desc[E_ATYPE] slot for a DLK_DECISION entry).
let DREC_DEBATE    = 1
let DREC_PROMOTION = 2
let DREC_STEELMAN  = 3

fn drec_subtype_name(t) {
    if t == DREC_DEBATE    { return "debate" }
    if t == DREC_PROMOTION { return "promotion" }
    if t == DREC_STEELMAN  { return "steelman" }
    return "unknown"
}

// Build the decision descriptor [aclass, atype, scalar, flag] for dl_append.
fn _drec_desc(subtype, scalar, flag) {
    let d = list_new()
    push(d, ACLASS_REASONING)
    push(d, subtype)
    push(d, scalar)
    push(d, flag)
    return d
}

// Adapt a debate's arguments into the decision log's trace field. That field's
// contract is a flat list of INTEGER node ids (decision_log.nova hashes each
// element arithmetically, so nested records are not permitted); here it is the
// premise atom id each argument rested on -- the "which premises were weighed"
// record. The full per-argument structure (sign/weight/grounded label) lives in
// the debate trace object and is reconstructible from the snapshot (the module
// header documents the trace as bulky-but-reconstructible, not on the wire).
fn _dargs_to_dlog_trace(dargs) {
    let out = list_new()
    let i = 0
    while i < len(dargs) {
        push(out, dargs[i][DARG_PREMISE])
        i = i + 1
    }
    return out
}

// Persist a debate trace (debate_trace_build / debate_atom_trace) as one
// immutable DLK_DECISION entry. Returns its seq. Outcome is OK unless the claim
// came out CONTESTED (an unresolved rebut), which records as VETOED -- the claim
// was not decided in either direction.
fn dlog_record_debate(log, tr, moment) {
    let contested = tr[TR_CONTESTED]
    let outcome = OUT_OK
    if contested == 1 { outcome = OUT_VETOED }
    let trace = _dargs_to_dlog_trace(tr[TR_DARGS])
    return dl_append(log, DLK_DECISION, 0 - 1, moment,
        _drec_desc(DREC_DEBATE, tr[TR_CONFIDENCE], contested),
        tr[TR_CLAIM], trace, 0, outcome)
}

// Construct -> debate -> persist, for a claim atom in the reasoning KG.
fn dlog_record_atom_debate(log, rkg, claim_id, moment) {
    return dlog_record_debate(log, debate_atom_trace(rkg, claim_id), moment)
}

// Persist the outcome of a governed promotion (ADR-0092) on `atom` -- the
// terminal cand_state and the evidence grade it was stamped with. PROMOTED
// records OK; any non-promoted terminal (QUARANTINED/CONTESTED/REJECTED) records
// VETOED. No argument trace (promotion's debate gate, when present, is recorded
// by dlog_record_debate); the grade + state + claim id are the audit payload.
fn dlog_record_promotion(log, atom, claim_id, state, moment) {
    let outcome = OUT_VETOED
    if state == CAND_PROMOTED { outcome = OUT_OK }
    return dl_append(log, DLK_DECISION, 0 - 1, moment,
        _drec_desc(DREC_PROMOTION, atom_evidence_grade(atom), state),
        claim_id, list_new(), 0, outcome)
}

// Persist a steelman summary (ADR-0090): how many evidenced positions survived
// and whether the claim is genuinely contested. The per-argument trace is the
// union of all surviving positions' arguments, so the audit record shows every
// premise that was steelmanned, not just a verdict.
fn dlog_record_steelman(log, dargs, claim_id, moment) {
    let positions = steelman_positions(dargs, claim_id)
    let contested = steelman_is_contested(dargs, claim_id)
    let outcome = OUT_OK
    if contested == 1 { outcome = OUT_VETOED }
    let trace = _dargs_to_dlog_trace(dargs)
    return dl_append(log, DLK_DECISION, 0 - 1, moment,
        _drec_desc(DREC_STEELMAN, len(positions), contested),
        claim_id, trace, 0, outcome)
}

fn dlog_record_atom_steelman(log, rkg, claim_id, moment) {
    return dlog_record_steelman(log, construct_arguments(rkg, claim_id), claim_id, moment)
}

// ---- read side: interpret a DLK_DECISION entry ----------------------------
fn drec_is_decision(e) {
    if e == 0 { return 0 }
    if dl_kind(e) == DLK_DECISION { return 1 }
    return 0
}

fn drec_subtype(e) { return dl_action_type(e) }
fn drec_claim(e)   { return dl_goal(e) }
fn drec_scalar(e)  { return dl_perm_tier(e) }   // confidence | grade | npositions
fn drec_flag(e)    { return dl_rev_class(e) }   // contested | terminal state

// Render one DLK_DECISION entry as plain language (no LLM, ADR-0014), purely
// from stored fields. Mirrors audit_render but in the reasoning lane so the
// scalar/flag read with their reasoning meaning.
fn drec_render(log, i) {
    let e = dl_get(log, i)
    if drec_is_decision(e) == 0 { return "not a decision entry" }
    let t = drec_subtype(e)
    let s = "#" + int_to_str(dl_seq(e)) + " decision/" + drec_subtype_name(t)
        + " claim #" + int_to_str(drec_claim(e))
    if t == DREC_DEBATE {
        s = s + " confidence " + int_to_str(drec_scalar(e))
        if drec_flag(e) == 1 { s = s + " [CONTESTED]" }
    }
    if t == DREC_PROMOTION {
        s = s + " grade " + atom_grade_name(drec_scalar(e))
            + " -> " + cand_state_name(drec_flag(e))
    }
    if t == DREC_STEELMAN {
        s = s + " " + int_to_str(drec_scalar(e)) + " surviving position(s)"
        if drec_flag(e) == 1 { s = s + " [CONTESTED]" }
    }
    s = s + " (" + out_name(dl_outcome(e)) + ", "
        + int_to_str(len(dl_trace(e))) + " arg trace node(s))"
    return s
}
