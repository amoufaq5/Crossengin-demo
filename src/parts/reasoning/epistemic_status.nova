// Epistemic status -- "how do I know this?" (the truth-seeking capstone).
//
// The whole engine exists to answer not just WHAT it thinks but HOW it knows it,
// on a calibrated, honest ladder. This module synthesizes the signals every
// other layer produces into ONE principled classification per atom:
//
//   EP_PROVEN       a machine-checked proof backs it (ADR-0088 FORMAL grade +
//                   a VERIFIED proof). The strongest, re-checkable certainty.
//   EP_CORROBORATED strong converging evidence (high belief, grounded).
//   EP_BELIEVED     more likely than not, but not strongly (moderate belief).
//   EP_CONTESTED    evidence stands on more than one side (ADR-0090; the grade
//                   was frozen CONTESTED) -- never collapse to a false verdict.
//   EP_REFUTED      the grounded evidence is AGAINST it (low belief, grounded).
//   EP_UNKNOWN      no grounding -- the engine honestly has no basis (at/near
//                   the uniform prior with no observations).
//
// This is the legible face of epistemic humility: a FORMAL theorem and a barely-
// believed rumor are never reported with the same confidence, and "I don't know"
// is a first-class answer. It is pure synthesis over existing state (atom belief
// + grade + proof status) -- it asserts nothing the substrate did not already
// compute (ADR-0020 self-model-from-state, ADR-0014 no LLM).
//
// ADRs implemented: ADR-0086 (calibrated truth-seeking output), grounding in
// ADR-0088 (proof grade), ADR-0023 (belief), ADR-0090 (contested). CrossEngin
// dependencies: src/kg/proofs.nova (-> atom_store: grade, belief, proof status).

import "../../kg/proofs.nova"

let EP_PROVEN       = 0
let EP_CORROBORATED = 1
let EP_BELIEVED     = 2
let EP_CONTESTED    = 3
let EP_REFUTED      = 4
let EP_UNKNOWN      = 5

// Calibration (milli confidence). Deliberately conservative so the engine never
// overstates: CORROBORATED needs clear majority support, REFUTED clear majority
// against; the band between is BELIEVED (if leaning yes) or treated as
// ungrounded otherwise.
let _EP_HIGH = 750   // >= this with grounding -> corroborated
let _EP_LOW  = 250   // <= this with grounding -> refuted
let _EP_LEAN = 550   // >= this (and grounded) but < HIGH -> believed

// Classify the epistemic stance toward atom `a`, given the KG-proofs registry
// `reg` (to confirm a FORMAL grade is actually proof-backed). Returns an EP_*.
fn epistemic_status(reg, a) {
    // A FORMAL grade only counts as PROVEN if its proof currently VERIFIES
    // (atom_proof_verified re-checks the registry). A FORMAL grade whose proof
    // has lapsed falls through to the belief-based ladder below.
    if atom_evidence_grade(a) == GRADE_FORMAL {
        if atom_proof_verified(reg, a) == 1 { return EP_PROVEN }
    }
    // A grade frozen CONTESTED by the debate engine (ADR-0090) is reported as
    // contested regardless of the raw mean -- the mean is meaningless mid-cycle.
    if atom_evidence_grade(a) == GRADE_CONTESTED { return EP_CONTESTED }

    // Belief-based ladder. atom_evidence is observations BEYOND the uniform
    // prior, so 0 means "never grounded" -> honest UNKNOWN.
    if atom_evidence(a) <= 0 { return EP_UNKNOWN }
    let conf = atom_confidence(a)
    if conf >= _EP_HIGH { return EP_CORROBORATED }
    if conf <= _EP_LOW  { return EP_REFUTED }
    if conf >= _EP_LEAN { return EP_BELIEVED }
    // Grounded but genuinely middling (neither clearly for nor against): the
    // honest answer is still "I can't say" -> UNKNOWN.
    return EP_UNKNOWN
}

fn epistemic_status_name(s) {
    if s == EP_PROVEN       { return "proven" }
    if s == EP_CORROBORATED { return "corroborated" }
    if s == EP_BELIEVED     { return "believed" }
    if s == EP_CONTESTED    { return "contested" }
    if s == EP_REFUTED      { return "refuted" }
    return "unknown"
}

// A plain-language "how do I know this?" line (no LLM, ADR-0013/0014).
fn epistemic_render(reg, a) {
    let s = epistemic_status(reg, a)
    if s == EP_PROVEN {
        return atom_label(a) + ": PROVEN -- backed by a machine-checked proof."
    }
    if s == EP_CORROBORATED {
        return atom_label(a) + ": CORROBORATED -- strong converging evidence ("
            + int_to_str(atom_confidence(a)) + " milli)."
    }
    if s == EP_BELIEVED {
        return atom_label(a) + ": BELIEVED -- more likely than not ("
            + int_to_str(atom_confidence(a)) + " milli), not yet strong."
    }
    if s == EP_CONTESTED {
        return atom_label(a) + ": CONTESTED -- evidence stands on more than one "
            + "side; I won't collapse it to a single verdict."
    }
    if s == EP_REFUTED {
        return atom_label(a) + ": REFUTED -- the evidence I have is against it ("
            + int_to_str(atom_confidence(a)) + " milli)."
    }
    return atom_label(a) + ": UNKNOWN -- I have no grounding for this yet.";
}

// Convenience: is the engine entitled to ASSERT `a` as something it knows?
// Only PROVEN or CORROBORATED clear that bar -- everything else is hedged,
// contested, or unknown. Useful as an answer-path gate (ADR-0086/0090).
fn epistemic_is_assertable(reg, a) {
    let s = epistemic_status(reg, a)
    if s == EP_PROVEN { return 1 }
    if s == EP_CORROBORATED { return 1 }
    return 0
}
