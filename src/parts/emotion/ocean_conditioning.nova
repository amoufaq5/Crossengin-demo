// CrossEngin emotion: OCEAN conditioning.
//
// Purpose
//   The soul's OCEAN personality (ADR-0034) is a slow-changing gain on the fast
//   emotion stream (ADR-0035). This conditions raw appraisal valence/arousal by
//   personality: high neuroticism amplifies arousal and shifts valence negative;
//   high extraversion (and agreeableness) raises baseline positive valence; high
//   openness raises arousal/engagement. Traits and emotions are integer milli
//   (0..1000; trait neutral 500). The result is clamped.
//
//   Takes the five traits as scalars, so it does not import the soul module
//   (decoupled, and clean under NOVA blocker #10).
//
// ADRs implemented: ADR-0035 (OCEAN conditioning of emotion). NOVA dependencies:
//   builtins. CrossEngin dependencies: none.

let OCEAN_N_AROUSAL_GAIN = 400   // neuroticism -> arousal
let OCEAN_N_VALENCE_GAIN = 300   // neuroticism -> negative valence
let OCEAN_E_VALENCE_GAIN = 300   // extraversion -> positive valence
let OCEAN_A_VALENCE_GAIN = 100   // agreeableness -> positive valence
let OCEAN_O_AROUSAL_GAIN = 100   // openness -> arousal

fn _oc_clamp(v) { if v < 0 { return 0 } if v > 1000 { return 1000 } return v }

// Condition raw (valence, arousal) by OCEAN traits. Returns [valence, arousal].
fn emotion_condition(o, c, e, a, n, valence, arousal) {
    let nd = n - 500
    let ed = e - 500
    let ad = a - 500
    let od = o - 500
    let v = valence
    v = v - nd * OCEAN_N_VALENCE_GAIN / 1000
    v = v + ed * OCEAN_E_VALENCE_GAIN / 1000
    v = v + ad * OCEAN_A_VALENCE_GAIN / 1000
    let ar = arousal
    ar = ar + nd * OCEAN_N_AROUSAL_GAIN / 1000
    ar = ar + od * OCEAN_O_AROUSAL_GAIN / 1000
    let out = list_new()
    push(out, _oc_clamp(v))
    push(out, _oc_clamp(ar))
    return out
}

fn conditioned_valence(r) { return r[0] }
fn conditioned_arousal(r) { return r[1] }
