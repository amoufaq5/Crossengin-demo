// CrossEngin emotion: OCC appraisal.
//
// Purpose
//   Appraises a moment along the OCC dimensions (ADR-0035) and produces valence,
//   arousal, and an emotion type. The three appraisal inputs are signed
//   (-1000..1000): desirability (does the outcome advance or thwart the active
//   goal tree, ADR-0033), praiseworthiness (does the action conform to or
//   violate soul values, ADR-0034), and appealingness (does the object match
//   preferences). Valence is their mean mapped to 0..1000 (500 neutral); arousal
//   is the mean magnitude (0..1000); the emotion type comes from the dominant
//   dimension's sign (joy/distress, pride/shame, liking/disliking).
//
//   Appraisal rules are substrate operators -- no text generation (ADR-0014).
//   Self-contained integer math.
//
// ADRs implemented: ADR-0035 (OCC appraisal). NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- emotion types --------------------------------------------------------
let EMO_NEUTRAL   = 0
let EMO_JOY       = 1
let EMO_DISTRESS  = 2
let EMO_PRIDE     = 3
let EMO_SHAME     = 4
let EMO_LIKING    = 5
let EMO_DISLIKING = 6

let EMO_THRESHOLD = 100   // below this magnitude appraisal is neutral

fn _emo_abs(x) { if x < 0 { return 0 - x } return x }
fn _emo_clamp(v) { if v < 0 { return 0 } if v > 1000 { return 1000 } return v }

fn emotion_type_name(t) {
    if t == EMO_JOY       { return "joy" }
    if t == EMO_DISTRESS  { return "distress" }
    if t == EMO_PRIDE     { return "pride" }
    if t == EMO_SHAME     { return "shame" }
    if t == EMO_LIKING    { return "liking" }
    if t == EMO_DISLIKING { return "disliking" }
    return "neutral"
}

// Pick the emotion type from the dominant (largest-magnitude) dimension.
fn _dominant_emotion(desirability, praise, appeal) {
    let ad = _emo_abs(desirability)
    let ap = _emo_abs(praise)
    let al = _emo_abs(appeal)
    let mx = ad
    if ap > mx { mx = ap }
    if al > mx { mx = al }
    if mx < EMO_THRESHOLD { return EMO_NEUTRAL }
    if mx == ad {
        if desirability >= 0 { return EMO_JOY }
        return EMO_DISTRESS
    }
    if mx == ap {
        if praise >= 0 { return EMO_PRIDE }
        return EMO_SHAME
    }
    if appeal >= 0 { return EMO_LIKING }
    return EMO_DISLIKING
}

// Appraise: returns [valence (0..1000), arousal (0..1000), emotion_type].
fn emotion_appraise(desirability, praise, appeal) {
    let combo = (desirability + praise + appeal) / 3
    let valence = _emo_clamp(500 + combo / 2)
    let arousal = _emo_clamp((_emo_abs(desirability) + _emo_abs(praise) + _emo_abs(appeal)) / 3)
    let etype = _dominant_emotion(desirability, praise, appeal)
    let out = list_new()
    push(out, valence)
    push(out, arousal)
    push(out, etype)
    return out
}

fn appraisal_valence(r) { return r[0] }
fn appraisal_arousal(r) { return r[1] }
fn appraisal_type(r)    { return r[2] }

// Map a 0..1000 valence to a signed -1000..1000 value (for plasticity/reward).
fn emotion_valence_signed(valence_0to1000) {
    return (valence_0to1000 - 500) * 2
}
