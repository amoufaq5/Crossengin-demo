// CrossEngin emotion: emotion-modulated plasticity.
//
// Purpose
//   Connects emotion to learning (ADR-0035): arousal scales synaptic learning
//   rates and episodic encoding strength so emotionally significant events are
//   learned faster and remembered longer, while valence/reward bias the
//   modulator. This is the emotion-side wiring that produces the global
//   modulator the substrate's plasticity pass consumes -- it delegates to
//   learning/plasticity_modulation (the modulator math) and converts the
//   emotion stream's 0..1000 valence into the signed form that module expects.
//
//   Modulator and encoding factors are integer milli (1.0 == 1000). Imports only
//   the standalone plasticity_modulation module (clean under NOVA blocker #10).
//
// ADRs implemented: ADR-0035 (emotion-modulated plasticity), ADR-0007 (eta
//   scaling), ADR-0022 (episodic encoding strength). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/learning/plasticity_modulation.nova,
//   src/parts/emotion/appraisal.nova.

import "../../learning/plasticity_modulation.nova"
import "appraisal.nova"

// The plasticity modulator from the emotion stream. valence is 0..1000 (from
// appraisal); arousal 0..1000; reward 0..1000 (500 neutral). Delegates to
// pm_modulator with the signed conventions it expects.
fn emotion_modulate_plasticity(valence_0to1000, arousal_0to1000, reward_0to1000) {
    let v = emotion_valence_signed(valence_0to1000)
    let r = emotion_valence_signed(reward_0to1000)
    return pm_modulator(v, arousal_0to1000, r)
}

// Episodic encoding strength factor (milli): higher arousal encodes more
// strongly (ADR-0022). 1.0 at no arousal, up to 2.0 at full arousal.
fn emotion_episodic_encoding(arousal_0to1000) {
    return 1000 + arousal_0to1000
}
