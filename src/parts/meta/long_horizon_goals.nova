// CrossEngin meta: long-horizon goals.
//
// Purpose
//   Long-horizon goals (ADR-0040) are durable goals pursued across sessions:
//   progress accrues cumulatively (never reset by restart) and a revisit scan
//   reactivates stale-but-important goals at idle. Built on the goal engine
//   (ADR-0033) -- a long-horizon goal is a goal whose deadline is its horizon and
//   whose last-touched timestamp drives staleness; revisit salience combines
//   base priority, staleness, and horizon proximity. Cross-session durability is
//   the ADR-0048 snapshot + goal_persistence (Phase 10); this provides the
//   in-memory accrual and revisit logic.
//
//   Times/priorities are integer milli where relevant. Builds on the standalone
//   goal engine (NOVA blocker #10: single import).
//
// ADRs implemented: ADR-0040 (long-horizon goals). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/goals/goal_engine.nova.

import "../goals/goal_engine.nova"

let LH_STALE_GAIN    = 1   // priority added per unit of staleness
let LH_HORIZON_GAIN  = 2   // priority added per unit of horizon proximity

// Create a long-horizon goal (deadline == horizon). Returns the goal id.
fn lh_new(engine, name, priority, horizon, now) {
    return goal_new(engine, name, priority, horizon, 0, now)
}

// Advance a goal's progress cumulatively (never resets) and mark it attended.
fn goal_advance(engine, id, delta, now) {
    let p = goal_progress(engine, id) + delta
    if p > 1000 { p = 1000 }
    goal_set_progress(engine, id, p)
    goal_touch(engine, id, now)
    return p
}

// Mark a subgoal satisfied and roll its parent's progress up.
fn goal_subgoal_complete(engine, sub_id, now) {
    goal_set_progress(engine, sub_id, 1000)
    goal_touch(engine, sub_id, now)
    let parent = goal_parent(engine, sub_id)
    if parent != -1 { goal_rollup_progress(engine, parent) }
    return parent
}

// Revisit salience: base priority + staleness (time since attended) + horizon
// proximity (closer deadline -> higher). Higher = more urgent to revisit.
fn lh_revisit_salience(engine, id, now) {
    if goal_status(engine, id) != GOAL_ACTIVE { return 0 }
    let sal = goal_priority(engine, id)
    let staleness = now - goal_last_touched(engine, id)
    if staleness > 0 { sal = sal + staleness * LH_STALE_GAIN }
    let deadline = goal_deadline(engine, id)
    if deadline > 0 {
        let proximity = deadline - now
        if proximity < 0 { proximity = 0 }
        // Closer deadlines (smaller proximity) are more urgent: invert within a
        // bounded window.
        if proximity < 1000 {
            sal = sal + (1000 - proximity) * LH_HORIZON_GAIN
        }
    }
    return sal
}

// Goals whose revisit salience meets the threshold -- to re-enter the active
// set at startup or idle (ADR-0040 revisit scan).
fn goal_revisit_scan(engine, now, threshold) {
    let out = list_new()
    let n = goal_count(engine)
    let id = 0
    while id < n {
        if goal_status(engine, id) == GOAL_ACTIVE {
            if lh_revisit_salience(engine, id, now) >= threshold {
                push(out, id)
            }
        }
        id = id + 1
    }
    return out
}
