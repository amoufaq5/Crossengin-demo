// CrossEngin meta: theory of mind (user-as-concept).
//
// Purpose
//   Models another agent (the user) as a concept whose properties are Bayesian
//   atoms in a dedicated KG (ADR-0039). Properties fall in three categories:
//   stable traits, slow-changing context, and fast-changing inferred state.
//   Every user-originated observation updates the relevant property's alpha/beta
//   (confidence rises with corroboration, falls with mismatch). The model is
//   user-inspectable (export) and user-deletable (full clear), per ADR-0044.
//
// ADRs implemented: ADR-0039 (theory of mind), ADR-0023 (Bayesian properties),
//   ADR-0044 (export/delete). NOVA dependencies: builtins. CrossEngin
//   dependencies: src/kg/multi_kg_manager.nova (and atom_store).

import "../../kg/multi_kg_manager.nova"

// Property categories (ADR-0039).
let UM_STABLE = 1   // preferences, style, expertise, relationships
let UM_SLOW   = 2   // current projects, routines
let UM_FAST   = 3   // inferred mood, energy, attention

// Spawn (or fetch) the user model KG.
fn usermodel_init(reg) {
    return kg_spawn(reg, "user")
}

// Set/replace a property (a fact atom carrying its category and value).
fn um_set_property(umkg, name, category, value, moment) {
    let existing = kg_find_atom(umkg, name)
    if existing != 0 {
        atom_payload_set(existing, "value", value)
        atom_payload_set(existing, "category", category)
        atom_touch(existing, moment)
        return existing
    }
    let a = kg_add_atom(umkg, ATOM_FACT, name, moment)
    atom_payload_set(a, "category", category)
    atom_payload_set(a, "value", value)
    return a
}

fn um_property(umkg, name) { return kg_find_atom(umkg, name) }
fn um_count(umkg) { return kg_atom_count(umkg) }

fn um_category(umkg, name) {
    let a = kg_find_atom(umkg, name)
    if a == 0 { return 0 }
    return atom_payload_get(a, "category")
}

fn um_value(umkg, name) {
    let a = kg_find_atom(umkg, name)
    if a == 0 { return "" }
    return atom_payload_get(a, "value")
}

// Confidence in a property (milli; 0 if unknown).
fn um_confidence(umkg, name) {
    let a = kg_find_atom(umkg, name)
    if a == 0 { return 0 }
    return atom_confidence(a)
}

// Evidence about a property: supports raises confidence, a mismatch lowers it.
fn um_observe(umkg, name, supports) {
    let a = kg_find_atom(umkg, name)
    if a == 0 { return 0 }
    atom_observe(a, supports)
    return atom_confidence(a)
}

// Flat, inspectable projection: a list of [name, category, value, confidence].
fn usermodel_export(umkg) {
    let out = list_new()
    let atoms = kg_atoms(umkg)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        let rec = list_new()
        push(rec, atom_label(a))
        push(rec, atom_payload_get(a, "category"))
        push(rec, atom_payload_get(a, "value"))
        push(rec, atom_confidence(a))
        push(out, rec)
        i = i + 1
    }
    return out
}

// Fully delete the user model (ADR-0044): clears every property atom.
fn usermodel_delete(umkg) {
    list_set(umkg, KG_ATOMS, list_new())
    list_set(umkg, KG_NEXTID, 0)
    return 1
}
