// CrossEngin meta: reflection sandbox.
//
// Purpose
//   A "what could I think next?" cycle the agent can run without acting --
//   forward-simulate from current reasoning conclusions in the imagination KG,
//   collect the NEW atom ids the rollout reaches, and record them as TENTATIVE
//   atoms (Beta(2,1) weak prior) in a separate reflection KG. Operates on a
//   SHADOW seed state so the live blackboard's percept / active / conclusion
//   lists are untouched; the only persistent side effect is refl_kg growth.
//
//   This is the GENERATION half of self-reflection: the agent speculates about
//   what might also be true, given what it's just reasoned. The corroboration
//   half -- when a subsequent percept anchors to a label already in refl_kg,
//   atom_observe strengthens it; over a threshold, the tentative atom is
//   promoted to the main concept kg as a real belief -- is the natural next
//   step but not in this MVP.
//
//   The reflection KG is just a domain KG spawned alongside the others, so it
//   inherits Bayesian belief, decay, and querying for free. Every reflective
//   inference is tagged via the Beta(2,1) prior: visibly weak compared to
//   user-taught Tier-A (Beta(4,1)) or seeded knowledge.
//
// ADRs implemented: ADR-0032 (imagination as substrate-native reflection),
//   ADR-0023 (Bayesian belief). NOVA dependencies: builtins. CrossEngin
//   dependencies: src/parts/imagination/forward_sim.nova.

import "../imagination/forward_sim.nova"
import "../../language/word_atoms.nova"

// Look an atom up in kg by its id. O(n) but kg has a few hundred atoms; this
// is only called per derived inference per /reflect, so the cost is bounded.
fn _refl_label_for_id(kg, id) {
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 { // reclamation: skip freed (0) slots
            if atom_id(a) == id {
                return atom_label(a)
            }
        }
        i = i + 1
    }
    return ""
}

// Spawn the reflection KG in the supplied registry (a peer of the concept /
// language / imagination KGs).
fn refl_kg_init(reg) {
    return kg_spawn(reg, "reflection")
}

// Build an img_state seed from a list of atom ids.
fn refl_seed_from_ids(ids) {
    let s = img_state_new()
    let i = 0
    while i < len(ids) {
        img_state_add(s, ids[i])
        i = i + 1
    }
    return s
}

// Run one reflection cycle. Returns a list of labels that were either freshly
// added to refl_kg (as Beta(2,1) tentative atoms) OR observed (existing
// tentative belief strengthened).
fn refl_run(kg, ikg, refl_kg, seed_state, depth, min_conf, moment) {
    let added = list_new()
    if img_state_size(seed_state) == 0 { return added }
    let rolled = forward_simulate(ikg, seed_state, depth, min_conf)
    let i = 0
    let n = img_state_size(rolled)
    while i < n {
        let id = rolled[i]
        if img_state_has(seed_state, id) == 0 {
            let label = _refl_label_for_id(kg, id)
            if len(label) > 0 {
                let existing = kg_find_atom(refl_kg, label)
                if existing == 0 {
                    let a = kg_add_atom(refl_kg, ATOM_FACT, label, moment)
                    let b = atom_belief(a)
                    list_set(b, 0, 2000)   // Beta(2,1) -- weak hypothesis
                    list_set(b, 1, 1000)
                    atom_payload_set(a, "provenance", "reflection")
                } else {
                    atom_observe(existing, 1)   // corroborate prior speculation
                }
                push(added, label)
            }
        }
        i = i + 1
    }
    return added
}

// How many tentative atoms is the agent currently entertaining?
fn refl_size(refl_kg) {
    return kg_atom_count(refl_kg)
}

// Promotion threshold (posterior mean, in milli): once a reflective atom's
// confidence crosses this it's eligible to be promoted to a real concept in
// the main KG. Beta(2,1) starts at 667; one corroboration brings it to 750.
let REFL_PROMOTE_THRESH = 750

// ---- corroboration -------------------------------------------------------
// When perception anchors a concept whose LABEL also exists in refl_kg, the
// agent's prior speculation has been corroborated. atom_observe(+1) raises the
// refl atom's belief; over the promotion threshold it becomes eligible to
// graduate from "tentative" to "real".

// Walk a percept (a list of [kg_id, atom_id] handles) and observe matching
// labels in refl_kg. Returns the count corroborated this call.
fn refl_corroborate_percept(kg, refl_kg, percept) {
    let n = 0
    let i = 0
    while i < len(percept) {
        let id = percept[i][1]
        let label = _refl_label_for_id(kg, id)
        if len(label) > 0 {
            let existing = kg_find_atom(refl_kg, label)
            if existing != 0 {
                if atom_payload_has(existing, "promoted") == 0 {
                    atom_observe(existing, 1)
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    return n
}

// ---- promotion -----------------------------------------------------------
// A refl atom whose confidence has crossed REFL_PROMOTE_THRESH and that isn't
// already promoted is ready to be admitted as a regular concept. The promote
// step copies the label into the main concept KG (or strengthens an existing
// match) and binds a word in the language KG.

// Labels in refl_kg whose confidence is at or above the promotion threshold
// AND that have not yet been promoted. The list is the queue the chat / a
// scheduled hook drains via refl_promote.
fn refl_promote_ready(refl_kg) {
    let atoms = kg_atoms(refl_kg)
    let out = list_new()
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 { // reclamation: skip freed (0) slots
            if atom_confidence(a) >= REFL_PROMOTE_THRESH {
                if atom_payload_has(a, "promoted") == 0 {
                    push(out, atom_label(a))
                }
            }
        }
        i = i + 1
    }
    return out
}

// Promote one label: create a concept atom in `kg` with the label (or
// strengthen an existing match by observation), bind the word in `lang`, and
// mark the refl_kg entry as promoted so it won't be promoted twice. The new
// concept's provenance is recorded as "reflection_promoted" so callers /
// audits can tell it from seeded knowledge.
fn refl_promote(kg, lang, refl_kg, label, moment) {
    let r = kg_find_atom(refl_kg, label)
    if r == 0 { return 0 }
    let target = kg_find_atom(kg, label)
    if target == 0 {
        target = kg_add_atom(kg, ATOM_CONCEPT, label, moment)
        atom_payload_set(target, "provenance", "reflection_promoted")
    } else {
        atom_observe(target, 1)
    }
    // Always ensure a word binding so the reader can anchor the promoted label
    // on the next turn (whether the concept was just born or already existed).
    let w = word_intern(lang, label, moment)
    word_add_sense(w, target, 700)
    atom_payload_set(r, "promoted", 1)
    return 1
}

// Drain the promote-ready queue in one pass. Returns the list of labels that
// were actually promoted (helpful for the chat's "(promoted X, Y, Z)" line).
fn refl_drain_promotions(kg, lang, refl_kg, moment) {
    let ready = refl_promote_ready(refl_kg)
    let i = 0
    while i < len(ready) {
        refl_promote(kg, lang, refl_kg, ready[i], moment)
        i = i + 1
    }
    return ready
}
