// CrossEngin meta: reflection sandbox.
//
// Purpose
//   A "what could I think next?" cycle the agent can run without acting --
//   forward-simulate from current reasoning conclusions in the imagination KG,
//   collect the NEW atom ids the rollout reaches, and record them as TENTATIVE
//   atoms (Beta(2,1) weak prior) in a separate reflection KG. Operates on a
//   SHADOW seed state so the live blackboard's percept / active / conclusion
//   lists are untouched; the only persistent side effect is refl_kg growth.
//
//   This is the GENERATION half of self-reflection: the agent speculates about
//   what might also be true, given what it's just reasoned. The corroboration
//   half -- when a subsequent percept anchors to a label already in refl_kg,
//   atom_observe strengthens it; over a threshold, the tentative atom is
//   promoted to the main concept kg as a real belief -- is the natural next
//   step but not in this MVP.
//
//   The reflection KG is just a domain KG spawned alongside the others, so it
//   inherits Bayesian belief, decay, and querying for free. Every reflective
//   inference is tagged via the Beta(2,1) prior: visibly weak compared to
//   user-taught Tier-A (Beta(4,1)) or seeded knowledge.
//
// ADRs implemented: ADR-0032 (imagination as substrate-native reflection),
//   ADR-0023 (Bayesian belief). NOVA dependencies: builtins. CrossEngin
//   dependencies: src/parts/imagination/forward_sim.nova.

import "../imagination/forward_sim.nova"

// Look an atom up in kg by its id. O(n) but kg has a few hundred atoms; this
// is only called per derived inference per /reflect, so the cost is bounded.
fn _refl_label_for_id(kg, id) {
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        if atom_id(atoms[i]) == id {
            return atom_label(atoms[i])
        }
        i = i + 1
    }
    return ""
}

// Spawn the reflection KG in the supplied registry (a peer of the concept /
// language / imagination KGs).
fn refl_kg_init(reg) {
    return kg_spawn(reg, "reflection")
}

// Build an img_state seed from a list of atom ids.
fn refl_seed_from_ids(ids) {
    let s = img_state_new()
    let i = 0
    while i < len(ids) {
        img_state_add(s, ids[i])
        i = i + 1
    }
    return s
}

// Run one reflection cycle. Returns a list of labels that were either freshly
// added to refl_kg (as Beta(2,1) tentative atoms) OR observed (existing
// tentative belief strengthened).
fn refl_run(kg, ikg, refl_kg, seed_state, depth, min_conf, moment) {
    let added = list_new()
    if img_state_size(seed_state) == 0 { return added }
    let rolled = forward_simulate(ikg, seed_state, depth, min_conf)
    let i = 0
    let n = img_state_size(rolled)
    while i < n {
        let id = rolled[i]
        if img_state_has(seed_state, id) == 0 {
            let label = _refl_label_for_id(kg, id)
            if len(label) > 0 {
                let existing = kg_find_atom(refl_kg, label)
                if existing == 0 {
                    let a = kg_add_atom(refl_kg, ATOM_FACT, label, moment)
                    let b = atom_belief(a)
                    list_set(b, 0, 2000)   // Beta(2,1) -- weak hypothesis
                    list_set(b, 1, 1000)
                    atom_payload_set(a, "provenance", "reflection")
                } else {
                    atom_observe(existing, 1)   // corroborate prior speculation
                }
                push(added, label)
            }
        }
        i = i + 1
    }
    return added
}

// How many tentative atoms is the agent currently entertaining?
fn refl_size(refl_kg) {
    return kg_atom_count(refl_kg)
}
