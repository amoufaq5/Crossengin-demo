// CrossEngin meta: self-model query API.
//
// Purpose
//   Answers "what are you / what is your state / what are your goals / what can
//   you do / what are you doing" (ADR-0038) by reading the real subsystems --
//   the soul (identity/state, ADR-0034), the goal engine (ADR-0033), and the
//   competence tracker (ADR-0020) -- and rendering a calibrated answer that
//   reflects current state including Bayesian-derived uncertainty. There is no
//   duplicate self-model and NO LLM (ADR-0014): answers are templated from real
//   state.
//
// ADRs implemented: ADR-0038 (self-model query). NOVA dependencies: builtins.
// CrossEngin dependencies: src/parts/soul/themes.nova (-> soul state/identity),
//   src/parts/goals/goal_engine.nova, src/kg/competence_tracker.nova.

import "../soul/themes.nova"
import "../soul/state.nova"
import "../goals/goal_engine.nova"
import "../../kg/competence_tracker.nova"

// Query subtypes (SELFQ_*).
let SELFQ_IDENTITY   = 1
let SELFQ_STATE      = 2
let SELFQ_GOALS      = 3
let SELFQ_COMPETENCE = 4
let SELFQ_ACTIVITY   = 5

// Identity answer from the soul (purpose, nature, dominant theme).
fn selfmodel_identity(sl) {
    if str_eq(soul_purpose(sl), "") == 1 { return "I am still forming my identity." }
    let ans = "I am " + soul_purpose(sl) + "; my nature is " + soul_nature(sl) + "."
    let theme = soul_dominant_theme(sl)
    if str_eq(theme, "") == 0 { ans = ans + " My strongest theme is " + theme + "." }
    return ans
}

// Affect/state answer from the soul's fast state.
fn selfmodel_state(sl) {
    return "My state: valence " + int_to_str(soul_mood_valence(sl))
        + ", arousal " + int_to_str(soul_mood_arousal(sl))
        + ", energy " + int_to_str(soul_energy(sl)) + " (milli)."
}

// Goals answer: the highest-priority active goal.
fn selfmodel_goals(engine) {
    let g = goal_arbitrate(engine)
    if g == -1 { return "I have no active goals right now." }
    return "I am pursuing: " + goal_name(engine, g) + "."
}

// Competence answer for a domain+kind, with the honest tier (never overstated).
fn selfmodel_competence(sm, domain, kind) {
    let r = self_model_get(sm, domain, kind)
    if r == 0 { return "I have no grounding in " + domain + " yet." }
    return "In " + domain + " I am " + competence_tier_name(competence_tier(r))
        + " (reliability " + int_to_str(competence_reliability(r)) + " milli)."
}

// Activity answer: how many loops are currently running.
fn selfmodel_activity(active_loop_count) {
    return "I am running " + int_to_str(active_loop_count) + " cognitive loop(s)."
}

// Dispatch identity/state/goals queries (competence/activity take extra args).
fn selfmodel_answer(kind, sl, engine) {
    if kind == SELFQ_IDENTITY { return selfmodel_identity(sl) }
    if kind == SELFQ_STATE    { return selfmodel_state(sl) }
    if kind == SELFQ_GOALS    { return selfmodel_goals(engine) }
    return "I cannot answer that self-query directly."
}
