// CrossEngin perception: Percept record atom.
//
// Purpose
//   The percept is the substrate-level entry surface for external input
//   (ADR-0010, ADR-0021). Historically `src/agent/loop_perception.nova`
//   delegated straight into `src/reader/reader.nova` and wrote four
//   context slots (`percept`, `active`, `routes`, `unknown`); the
//   category / confidence / signals produced by the primary classifier
//   (`src/perception/input_classifier.nova`) and the identity / labels
//   from the cross-modal fusion primitive (`src/perception/sensor_fusion.nova`)
//   were never captured in a first-class record. ADR-0092 (this round)
//   introduces the `Percept` record: a list-of-slots atom that binds
//   modality, category, confidence, labels, signals, source provenance
//   and (for A/V) a cross-modally-agreed identity into one handle
//   downstream loops can consume.
//
//   The atom is deliberately dumb -- construction + accessors only. The
//   orchestration layer is `perception_module.nova`; the primitives
//   remain at `src/perception/*` (this file does NOT re-implement any
//   of them). Matches the atoms + module shape of
//   `src/parts/reasoning/reasoning_atoms.nova`.
//
// ADRs implemented: ADR-0092 (perception module, Phase N R1).
//   Governed by ADR-0010 / ADR-0021.
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/perception/input_classifier.nova
//   (for cat_name delegation only -- no run-time coupling).

import "../../perception/input_classifier.nova"

// ---- modality tag ---------------------------------------------------------
//
// A Percept's `PC_MODALITY` field. Small integer enum so the substrate
// can branch on it in constant time without string comparison
// (str_eq is unreliable on short literals -- ADR-0082 quirks note).

let PC_MODALITY_TEXT       = 1
let PC_MODALITY_IMAGE      = 2
let PC_MODALITY_AUDIO      = 3
let PC_MODALITY_VIDEO      = 4
let PC_MODALITY_MULTIMODAL = 5

// Human-readable modality names, used by the trace + chat formatters.
// A missing / invalid modality returns "unknown"; never "" (len("") would
// segfault an unprepared caller by NOVA's len(0) quirk if the caller
// mistakenly passed a 0 handle -- so the fallback is a real string).
fn pc_modality_name(m) {
    if m == PC_MODALITY_TEXT       { return "text" }
    if m == PC_MODALITY_IMAGE      { return "image" }
    if m == PC_MODALITY_AUDIO      { return "audio" }
    if m == PC_MODALITY_VIDEO      { return "video" }
    if m == PC_MODALITY_MULTIMODAL { return "multimodal" }
    return "unknown"
}

// ---- Percept record layout ------------------------------------------------
//
// Shape (14 slots). The `PC_OBJ_TAG` sentinel lets a runtime type-check
// distinguish a real Percept from an ambient list; loops that receive
// a Percept as `0` (no percept produced) short-circuit before any
// accessor call.
//
//   [0]  PC_TAG               (PC_OBJ_TAG sentinel)
//   [1]  PC_TIMESTAMP_NS      (int; caller-supplied moment nanoseconds)
//   [2]  PC_MODALITY          (int; PC_MODALITY_*)
//   [3]  PC_CATEGORY          (int; input_classifier CAT_* enum, or 0
//                                for non-TEXT modalities)
//   [4]  PC_CONFIDENCE_MILLI  (int; 0..1000)
//   [5]  PC_LABELS            (list of strings; fusion labels for image /
//                                audio; empty list for text)
//   [6]  PC_SIGNALS           (list of strings; classify_input signals
//                                for text; empty list for A/V/M)
//   [7]  PC_SOURCE_ATOM_ID    (int; the kg atom id the percept was minted
//                                from, or 0 if pre-birth)
//   [8]  PC_IDENTITY_LABEL    (string; the cross-modally agreed identity
//                                from sensor_fusion, or "" when unset)
//   [9]  PC_LINKED_IMAGE      (Percept or 0; the image half of a
//                                multimodal Percept)
//   [10] PC_LINKED_AUDIO      (Percept or 0; the audio half of a
//                                multimodal Percept)
//   [11] PC_CORR_MILLI        (int; multimodal correlation / lipsync
//                                score in milli, 0..1000; 0 when unset)
//   [12] PC_ROUTES            (list; symbolic route targets from reader,
//                                populated only by the text path)
//   [13] PC_UNKNOWN           (int; unknown-token count from the reader,
//                                populated only by the text path)

let PC_OBJ_TAG = 9201

let PC_TAG              = 0
let PC_TIMESTAMP_NS     = 1
let PC_MODALITY         = 2
let PC_CATEGORY         = 3
let PC_CONFIDENCE_MILLI = 4
let PC_LABELS           = 5
let PC_SIGNALS          = 6
let PC_SOURCE_ATOM_ID   = 7
let PC_IDENTITY_LABEL   = 8
let PC_LINKED_IMAGE     = 9
let PC_LINKED_AUDIO     = 10
let PC_CORR_MILLI       = 11
let PC_ROUTES           = 12
let PC_UNKNOWN          = 13

fn _pc_shell() {
    let p = list_new()
    push(p, PC_OBJ_TAG)     // [0]
    push(p, 0)              // [1]  ts
    push(p, 0)              // [2]  modality
    push(p, 0)              // [3]  category
    push(p, 0)              // [4]  confidence
    push(p, list_new())     // [5]  labels
    push(p, list_new())     // [6]  signals
    push(p, 0)              // [7]  source atom id
    push(p, "")             // [8]  identity label
    push(p, 0)              // [9]  linked image
    push(p, 0)              // [10] linked audio
    push(p, 0)              // [11] corr_milli
    push(p, list_new())     // [12] routes
    push(p, 0)              // [13] unknown
    return p
}

// ---- constructors ---------------------------------------------------------

// A text percept: category / confidence / signals from classify_input,
// source_atom_id from the caller (0 if the reader has not birthed one).
// `labels` is empty by convention for text -- the label channel is
// reserved for A/V observation labels.
fn percept_text_new(ts_ns, category, confidence_milli, signals, source_atom_id) {
    let p = _pc_shell()
    list_set(p, PC_TIMESTAMP_NS, ts_ns)
    list_set(p, PC_MODALITY, PC_MODALITY_TEXT)
    list_set(p, PC_CATEGORY, category)
    list_set(p, PC_CONFIDENCE_MILLI, confidence_milli)
    if signals != 0 { list_set(p, PC_SIGNALS, signals) }
    list_set(p, PC_SOURCE_ATOM_ID, source_atom_id)
    return p
}

// An image percept: labels + identity from `fuse_image_observation`; the
// category slot is left at 0 (input_classifier is text-only).
fn percept_image_new(ts_ns, labels, identity_label, source_atom_id, confidence_milli) {
    let p = _pc_shell()
    list_set(p, PC_TIMESTAMP_NS, ts_ns)
    list_set(p, PC_MODALITY, PC_MODALITY_IMAGE)
    list_set(p, PC_CONFIDENCE_MILLI, confidence_milli)
    if labels != 0 { list_set(p, PC_LABELS, labels) }
    if identity_label != 0 {
        if len(identity_label) > 0 { list_set(p, PC_IDENTITY_LABEL, identity_label) }
    }
    list_set(p, PC_SOURCE_ATOM_ID, source_atom_id)
    return p
}

// An audio percept: labels + identity from `fuse_audio_observation`.
fn percept_audio_new(ts_ns, labels, identity_label, source_atom_id, confidence_milli) {
    let p = _pc_shell()
    list_set(p, PC_TIMESTAMP_NS, ts_ns)
    list_set(p, PC_MODALITY, PC_MODALITY_AUDIO)
    list_set(p, PC_CONFIDENCE_MILLI, confidence_milli)
    if labels != 0 { list_set(p, PC_LABELS, labels) }
    if identity_label != 0 {
        if len(identity_label) > 0 { list_set(p, PC_IDENTITY_LABEL, identity_label) }
    }
    list_set(p, PC_SOURCE_ATOM_ID, source_atom_id)
    return p
}

// A multimodal percept: cross-links two per-modality percepts under one
// handle. Timestamp is copied from the image half (or, if only audio
// is present, from the audio half). `correlation_milli` is the fusion
// / lipsync agreement score (0..1000); pass 0 when unset.
// Either half may be 0 -- the record still constructs, and downstream
// callers can inspect `pc_linked_image` / `pc_linked_audio` for
// presence.
fn percept_multimodal_new(image_percept, audio_percept, correlation_milli) {
    let p = _pc_shell()
    list_set(p, PC_MODALITY, PC_MODALITY_MULTIMODAL)
    let ts = 0
    if image_percept != 0 {
        ts = image_percept[PC_TIMESTAMP_NS]
    } else {
        if audio_percept != 0 { ts = audio_percept[PC_TIMESTAMP_NS] }
    }
    list_set(p, PC_TIMESTAMP_NS, ts)
    // Confidence: min(image, audio) when both present; else the single side.
    let conf = 0
    if image_percept != 0 {
        conf = image_percept[PC_CONFIDENCE_MILLI]
        if audio_percept != 0 {
            let ac = audio_percept[PC_CONFIDENCE_MILLI]
            if ac < conf { conf = ac }
        }
    } else {
        if audio_percept != 0 { conf = audio_percept[PC_CONFIDENCE_MILLI] }
    }
    list_set(p, PC_CONFIDENCE_MILLI, conf)
    // Cross-modal identity: image side wins if both agree; else propagate
    // whichever side names one. Mirrors the sensor_fusion policy without
    // re-implementing it (fusion has already run when the caller reaches
    // percept_multimodal_new -- this is just the identity readback).
    let identity = ""
    if image_percept != 0 {
        let img_id = image_percept[PC_IDENTITY_LABEL]
        if img_id != 0 {
            if len(img_id) > 0 { identity = img_id }
        }
    }
    if len(identity) == 0 {
        if audio_percept != 0 {
            let aud_id = audio_percept[PC_IDENTITY_LABEL]
            if aud_id != 0 {
                if len(aud_id) > 0 { identity = aud_id }
            }
        }
    }
    list_set(p, PC_IDENTITY_LABEL, identity)
    list_set(p, PC_LINKED_IMAGE, image_percept)
    list_set(p, PC_LINKED_AUDIO, audio_percept)
    list_set(p, PC_CORR_MILLI, correlation_milli)
    // Merge labels: image labels first, then audio labels (mirrors
    // fuse_observation's fused_labels order so a caller reading a
    // multimodal Percept sees the same ordering as the underlying
    // fused atom).
    let merged = list_new()
    if image_percept != 0 {
        let il = image_percept[PC_LABELS]
        let i = 0
        while i < len(il) { push(merged, il[i]) i = i + 1 }
    }
    if audio_percept != 0 {
        let al = audio_percept[PC_LABELS]
        let j = 0
        while j < len(al) { push(merged, al[j]) j = j + 1 }
    }
    list_set(p, PC_LABELS, merged)
    return p
}

// ---- accessors ------------------------------------------------------------

fn pc_is_percept(p) {
    if p == 0 { return 0 }
    if len(p) < 14 { return 0 }
    if p[PC_TAG] != PC_OBJ_TAG { return 0 }
    return 1
}

fn pc_timestamp_ns(p)   { return p[PC_TIMESTAMP_NS] }
fn pc_modality(p)       { return p[PC_MODALITY] }
fn pc_category(p)       { return p[PC_CATEGORY] }
fn pc_confidence(p)     { return p[PC_CONFIDENCE_MILLI] }
fn pc_labels(p)         { return p[PC_LABELS] }
fn pc_signals(p)        { return p[PC_SIGNALS] }
fn pc_source_atom_id(p) { return p[PC_SOURCE_ATOM_ID] }
fn pc_identity_label(p) { return p[PC_IDENTITY_LABEL] }
fn pc_linked_image(p)   { return p[PC_LINKED_IMAGE] }
fn pc_linked_audio(p)   { return p[PC_LINKED_AUDIO] }
fn pc_corr_milli(p)     { return p[PC_CORR_MILLI] }
fn pc_routes(p)         { return p[PC_ROUTES] }
fn pc_unknown(p)        { return p[PC_UNKNOWN] }

fn pc_is_multimodal(p) {
    if p == 0 { return 0 }
    if p[PC_MODALITY] == PC_MODALITY_MULTIMODAL { return 1 }
    return 0
}

// Setters for the reader-side slots. Kept internal-shaped (double
// underscore) because the perception module is the only writer; the
// name is unadorned so a plain Percept + a small helper suffice for
// unit tests that want to check the round-trip.
fn pc_set_routes(p, routes) {
    if p == 0 { return 0 }
    if routes == 0 { return 0 }
    list_set(p, PC_ROUTES, routes)
    return 1
}

fn pc_set_unknown(p, n) {
    if p == 0 { return 0 }
    list_set(p, PC_UNKNOWN, n)
    return 1
}

fn pc_set_source_atom_id(p, id) {
    if p == 0 { return 0 }
    list_set(p, PC_SOURCE_ATOM_ID, id)
    return 1
}

// ---- category delegation --------------------------------------------------
//
// `pc_category_name` proxies to `cat_name` from input_classifier so the
// text percept's category slot renders using the same taxonomy the
// classifier uses. For non-TEXT modalities (image / audio / multimodal)
// the category slot is 0; we return "n/a" so a trace formatter can
// print something meaningful without a branch at every callsite.

fn pc_category_name(c) {
    if c == 0 { return "n/a" }
    return cat_name(c)
}

// Convenience: human-readable one-liner. Used by the chat REPL /debug
// dump and the trace formatter. NOT a stable format -- callers that
// need structure should read the slots directly.
fn pc_summary(p) {
    if pc_is_percept(p) == 0 { return "<no percept>" }
    let mod_name = pc_modality_name(pc_modality(p))
    let cat = pc_category_name(pc_category(p))
    return "percept(mod=" + mod_name + ", cat=" + cat +
        ", conf=" + int_to_str(pc_confidence(p)) + ")"
}
