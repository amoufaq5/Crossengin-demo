// CrossEngin goals: goal persistence.
//
// Purpose
//   Serializes goal trees to a flat, snapshot-friendly representation and
//   rehydrates them, with validation on load (ADR-0033/0048). Goal trees are
//   part of the ordered snapshot set (rehydrated after the soul, before
//   episodic); on load, validation drops dangling references so a corrupt or
//   mis-ordered snapshot cannot resurrect contradictory goals. The on-disk
//   format is the ADR-0048 work (Phase 10); this module produces/consumes the
//   in-memory serializable form (a list of flat goal records).
//
// ADRs implemented: ADR-0033 (goal persistence + validation). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/parts/goals/goal_engine.nova.

import "goal_engine.nova"

// A serialized record mirrors the goal fields except children (rebuilt from
// parent on load): [id, name, parent, status, priority, deadline, progress,
// provenance, last_touched].
fn goal_serialize(engine) {
    let out = list_new()
    let l = engine[GE_LIST]
    let i = 0
    while i < len(l) {
        let g = l[i]
        let rec = list_new()
        push(rec, g[G_ID])
        push(rec, g[G_NAME])
        push(rec, g[G_PARENT])
        push(rec, g[G_STATUS])
        push(rec, g[G_PRIORITY])
        push(rec, g[G_DEADLINE])
        push(rec, g[G_PROGRESS])
        push(rec, g[G_PROV])
        push(rec, g[G_TOUCHED])
        push(out, rec)
        i = i + 1
    }
    return out
}

// Rebuild an engine from serialized records (ids preserved), re-linking children
// from each record's parent. Records are assumed dense by id (as produced by
// goal_serialize).
fn goal_deserialize(data) {
    let engine = goal_engine_new()
    let l = engine[GE_LIST]
    // Recreate goals in id order.
    let i = 0
    while i < len(data) {
        let r = data[i]
        let g = list_new()
        push(g, GOAL_OBJ_TAG)
        push(g, r[0])         // id
        push(g, r[1])         // name
        push(g, r[2])         // parent
        push(g, list_new())  // children (rebuilt below)
        push(g, r[3])         // status
        push(g, r[4])         // priority
        push(g, r[5])         // deadline
        push(g, r[6])         // progress
        push(g, r[7])         // provenance
        push(g, r[8])         // last_touched
        push(l, g)
        i = i + 1
    }
    list_set(engine, GE_NEXT, len(data))
    // Re-link children from valid parents.
    let j = 0
    while j < len(l) {
        let parent = l[j][G_PARENT]
        if parent >= 0 {
            if parent < len(l) {
                push(l[parent][G_CHILDREN], l[j][G_ID])
            }
        }
        j = j + 1
    }
    return engine
}

// Validate a rehydrated engine: a goal whose parent id is out of range is an
// orphan -- detach it (parent = -1). Returns the number of issues fixed.
fn goal_validate(engine) {
    let l = engine[GE_LIST]
    let fixed = 0
    let i = 0
    while i < len(l) {
        let parent = l[i][G_PARENT]
        if parent >= 0 {
            if parent >= len(l) {
                list_set(l[i], G_PARENT, -1)
                fixed = fixed + 1
            } else {
                // Parent must actually list this goal as a child.
                if contains(l[parent][G_CHILDREN], l[i][G_ID]) == 0 {
                    list_set(l[i], G_PARENT, -1)
                    fixed = fixed + 1
                }
            }
        }
        i = i + 1
    }
    return fixed
}
