// CrossEngin goals: goal engine.
//
// Purpose
//   Priority-sorted goal trees (ADR-0033). A goal has a parent, children, a
//   status (active/blocked/satisfied/abandoned), priority, deadline, progress,
//   provenance (the spawning moment/drive), and a last-touched timestamp for
//   decay. Parent progress rolls up from children; blocking propagates upward;
//   arbitration returns the highest-priority unblocked leaf to work on; and
//   stale goals lose priority gracefully so long-horizon objectives survive
//   intermittent attention without clogging the queue.
//
//   Priority/progress are integer milli (progress 1.0 == 1000 == satisfied).
//   This module is self-contained; cross-session persistence is goal_persistence
//   + the ADR-0048 snapshot (Phase 10).
//
// ADRs implemented: ADR-0033 (goal engine). NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- status ---------------------------------------------------------------
let GOAL_ACTIVE    = 1
let GOAL_BLOCKED   = 2
let GOAL_SATISFIED = 3
let GOAL_ABANDONED = 4

// ---- goal layout ----------------------------------------------------------
let G_TAG      = 0
let G_ID       = 1
let G_NAME     = 2
let G_PARENT   = 3
let G_CHILDREN = 4
let G_STATUS   = 5
let G_PRIORITY = 6
let G_DEADLINE = 7
let G_PROGRESS = 8
let G_PROV     = 9
let G_TOUCHED  = 10
let GOAL_OBJ_TAG = 3301

// ---- engine ---------------------------------------------------------------
let GE_TAG  = 0
let GE_LIST = 1
let GE_NEXT = 2

fn goal_engine_new() {
    let e = list_new()
    push(e, GE_TAG)
    push(e, list_new())
    push(e, 0)
    return e
}

fn goal_new(engine, name, priority, deadline, provenance, now) {
    let id = engine[GE_NEXT]
    let g = list_new()
    push(g, GOAL_OBJ_TAG)
    push(g, id)
    push(g, name)
    push(g, -1)            // parent
    push(g, list_new())   // children
    push(g, GOAL_ACTIVE)
    push(g, priority)
    push(g, deadline)
    push(g, 0)            // progress
    push(g, provenance)
    push(g, now)          // last_touched
    push(engine[GE_LIST], g)
    list_set(engine, GE_NEXT, id + 1)
    return id
}

fn goal_get(engine, id) {
    let l = engine[GE_LIST]
    if id < 0 { return 0 }
    if id >= len(l) { return 0 }
    return l[id]
}

fn goal_count(engine) { return len(engine[GE_LIST]) }

fn goal_name(engine, id)     { let g = goal_get(engine, id); if g == 0 { return "" } return g[G_NAME] }
fn goal_status(engine, id)   { let g = goal_get(engine, id); if g == 0 { return 0 } return g[G_STATUS] }
fn goal_priority(engine, id) { let g = goal_get(engine, id); if g == 0 { return 0 } return g[G_PRIORITY] }
fn goal_progress(engine, id) { let g = goal_get(engine, id); if g == 0 { return 0 } return g[G_PROGRESS] }
fn goal_parent(engine, id)   { let g = goal_get(engine, id); if g == 0 { return -1 } return g[G_PARENT] }
fn goal_children(engine, id) { let g = goal_get(engine, id); if g == 0 { return list_new() } return g[G_CHILDREN] }
fn goal_deadline(engine, id) { let g = goal_get(engine, id); if g == 0 { return 0 } return g[G_DEADLINE] }
fn goal_last_touched(engine, id) { let g = goal_get(engine, id); if g == 0 { return 0 } return g[G_TOUCHED] }
fn goal_is_leaf(engine, id)  { if len(goal_children(engine, id)) == 0 { return 1 } return 0 }

fn goal_touch(engine, id, now) {
    let g = goal_get(engine, id)
    if g == 0 { return 0 }
    list_set(g, G_TOUCHED, now)
    return 1
}

fn goal_set_priority(engine, id, p) {
    let g = goal_get(engine, id)
    if g == 0 { return 0 }
    list_set(g, G_PRIORITY, p)
    return 1
}

// Attach child under parent (means-ends decomposition, ADR-0031/0033).
fn goal_add_subgoal(engine, parent_id, child_id) {
    let p = goal_get(engine, parent_id)
    let c = goal_get(engine, child_id)
    if p == 0 { return 0 }
    if c == 0 { return 0 }
    list_set(c, G_PARENT, parent_id)
    if contains(p[G_CHILDREN], child_id) == 0 { push(p[G_CHILDREN], child_id) }
    return 1
}

// Set progress (milli); auto-satisfies at 1.0.
fn goal_set_progress(engine, id, pct) {
    let g = goal_get(engine, id)
    if g == 0 { return 0 }
    let p = pct
    if p >= 1000 {
        p = 1000
        list_set(g, G_STATUS, GOAL_SATISFIED)
    }
    list_set(g, G_PROGRESS, p)
    return 1
}

fn goal_set_status(engine, id, status) {
    let g = goal_get(engine, id)
    if g == 0 { return 0 }
    list_set(g, G_STATUS, status)
    return 1
}

// Parent progress = mean of children's (recursive) progress; leaves keep their
// own progress. Returns the rolled-up progress for id.
fn goal_rollup_progress(engine, id) {
    let g = goal_get(engine, id)
    if g == 0 { return 0 }
    let kids = g[G_CHILDREN]
    if len(kids) == 0 { return g[G_PROGRESS] }
    let total = 0
    let i = 0
    while i < len(kids) {
        total = total + goal_rollup_progress(engine, kids[i])
        i = i + 1
    }
    let avg = total / len(kids)
    list_set(g, G_PROGRESS, avg)
    if avg >= 1000 { list_set(g, G_STATUS, GOAL_SATISFIED) }
    return avg
}

fn _goal_all_children_stuck(engine, id) {
    let kids = goal_children(engine, id)
    if len(kids) == 0 { return 0 }
    let i = 0
    while i < len(kids) {
        let s = goal_status(engine, kids[i])
        if s == GOAL_ACTIVE { return 0 }
        if s == GOAL_SATISFIED { return 0 }
        i = i + 1
    }
    return 1
}

// Block a goal and propagate upward: a parent becomes blocked when all its
// children are blocked/abandoned (no active path remains).
fn goal_propagate_block(engine, id) {
    goal_set_status(engine, id, GOAL_BLOCKED)
    let p = goal_parent(engine, id)
    while p != -1 {
        if _goal_all_children_stuck(engine, p) == 1 {
            goal_set_status(engine, p, GOAL_BLOCKED)
            p = goal_parent(engine, p)
        } else {
            p = -1
        }
    }
    return 1
}

// Highest-priority active, unblocked leaf goal to work on (-1 if none).
fn goal_arbitrate(engine) {
    let l = engine[GE_LIST]
    let best = -1
    let best_pri = 0 - 1
    let i = 0
    while i < len(l) {
        if l[i][G_STATUS] == GOAL_ACTIVE {
            if goal_is_leaf(engine, l[i][G_ID]) == 1 {
                if l[i][G_PRIORITY] > best_pri {
                    best_pri = l[i][G_PRIORITY]
                    best = l[i][G_ID]
                }
            }
        }
        i = i + 1
    }
    return best
}

fn goal_active_count(engine) {
    let l = engine[GE_LIST]
    let n = 0
    let i = 0
    while i < len(l) {
        if l[i][G_STATUS] == GOAL_ACTIVE { n = n + 1 }
        i = i + 1
    }
    return n
}

// Decay the priority of active goals not touched within stale_threshold, by the
// retention factor (milli). Long-horizon goals lose priority gracefully.
fn goal_decay_stale(engine, now, stale_threshold, retain_milli) {
    let l = engine[GE_LIST]
    let decayed = 0
    let i = 0
    while i < len(l) {
        if l[i][G_STATUS] == GOAL_ACTIVE {
            if now - l[i][G_TOUCHED] >= stale_threshold {
                list_set(l[i], G_PRIORITY, l[i][G_PRIORITY] * retain_milli / 1000)
                decayed = decayed + 1
            }
        }
        i = i + 1
    }
    return decayed
}
