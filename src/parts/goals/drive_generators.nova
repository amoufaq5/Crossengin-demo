// CrossEngin goals: drive generators.
//
// Purpose
//   The four intrinsic drives that spawn goals (ADR-0033): curiosity (knowledge
//   gaps), social (time since interaction), task (pending requests), and
//   homeostasis (low valence or high memory load). Each drive is a thresholded
//   generator: when its input crosses the trigger it spawns a goal in the engine
//   tagged with the drive as provenance, at a priority derived from the input.
//   Conceptually each emits SIG_GOAL_DRIVE; the spawned goal is the artifact.
//
//   Inputs and priorities are integer milli. Self-contained (inline fixed-point).
//
// ADRs implemented: ADR-0033 (four drives). Inputs from ADR-0020 (competence
//   gap), ADR-0035 (valence), ADR-0025 (memory load). NOVA dependencies:
//   builtins. CrossEngin dependencies: src/parts/goals/goal_engine.nova.

import "goal_engine.nova"

// Drive ids (also used as goal provenance).
let DRIVE_CURIOSITY    = 1
let DRIVE_SOCIAL       = 2
let DRIVE_TASK         = 3
let DRIVE_HOMEOSTASIS  = 4

// Trigger thresholds (milli / time units).
let DRIVE_CURIOSITY_MIN = 300   // knowledge gap > 0.3
let DRIVE_SOCIAL_MIN_GAP= 500   // time since interaction
let DRIVE_HOMEO_VALENCE = 300   // valence below 0.3 -> distress
let DRIVE_HOMEO_LOAD    = 800   // memory load above 0.8

// Curiosity: a sufficiently large, novel knowledge gap spawns an exploration
// goal at priority gap*novelty. Returns goal id or -1.
fn drive_curiosity(engine, knowledge_gap, novelty, now) {
    if knowledge_gap < DRIVE_CURIOSITY_MIN { return -1 }
    let pri = knowledge_gap * novelty / 1000
    return goal_new(engine, "explore gap", pri, 0, DRIVE_CURIOSITY, now)
}

// Social: a long gap since the last interaction spawns an engagement goal
// (priority grows with the wait, capped). Returns goal id or -1.
fn drive_social(engine, time_since_interaction, now) {
    if time_since_interaction < DRIVE_SOCIAL_MIN_GAP { return -1 }
    let pri = time_since_interaction
    if pri > 1000 { pri = 1000 }
    return goal_new(engine, "engage user", pri, 0, DRIVE_SOCIAL, now)
}

// Task: pending requests spawn a high-priority handling goal. Returns id or -1.
fn drive_task(engine, pending_requests, now) {
    if pending_requests <= 0 { return -1 }
    return goal_new(engine, "handle request", 900, 0, DRIVE_TASK, now)
}

// Homeostasis: low valence or high memory load spawns a restorative goal.
// Returns goal id or -1.
fn drive_homeostasis(engine, valence, memory_load, now) {
    if valence < DRIVE_HOMEO_VALENCE {
        return goal_new(engine, "restore wellbeing", 600, 0, DRIVE_HOMEOSTASIS, now)
    }
    if memory_load > DRIVE_HOMEO_LOAD {
        return goal_new(engine, "consolidate memory", 500, 0, DRIVE_HOMEOSTASIS, now)
    }
    return -1
}

// Run all four drives; returns the number of goals spawned this cycle.
fn drive_generate_all(engine, knowledge_gap, novelty, time_since_interaction, pending_requests, valence, memory_load, now) {
    let n = 0
    if drive_curiosity(engine, knowledge_gap, novelty, now) != -1 { n = n + 1 }
    if drive_social(engine, time_since_interaction, now) != -1 { n = n + 1 }
    if drive_task(engine, pending_requests, now) != -1 { n = n + 1 }
    if drive_homeostasis(engine, valence, memory_load, now) != -1 { n = n + 1 }
    return n
}
