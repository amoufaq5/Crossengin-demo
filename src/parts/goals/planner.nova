// CrossEngin goals: keyword-heuristic planner for operand materialization.
//
// Purpose
//   Phase R4 (ADR-0112) shipped the goal-template registry: on a
//   motor_map hit `operand_builder_build` first probes the per-goal
//   template registry for exact-match on `goal_name`, falling through
//   to the R3 convention (ADR-0109) on a miss. Phase R5 (ADR-0113)
//   layers a middle-tier between the two: a planner that extracts
//   operands from natural-language-ish `goal_name` strings via
//   keyword heuristics (option (b) from ADR-0112's phase-1 explore).
//
//   Three-layer precedence after R5 (highest first):
//     1. R4 template registry  (exact-match on `goal_name`)
//     2. R5 planner heuristics (THIS MODULE -- trailing-space prefix)
//     3. R3 convention switch  (synthesized placeholders)
//
//   The planner exposes a single public function:
//     `planner_materialize(goal_name, eff_class, goal_id) -> list`
//   returning a populated operand tuple on hit, or `list_new()`
//   (empty) on miss. The caller interprets an empty return as "no
//   planner hit -- continue to R3 fallback".
//
//   Four heuristics ship in this round, one per payload-bearing
//   effector class (FILE / HTTP / CODE / AUDIO). Each heuristic
//   matches a prefix that ENDS WITH A SPACE -- so motor_map's default
//   vocabulary (`"write_a_note"`, `"run_code"`, ...) with underscores
//   cannot match. That trailing-space-prefix invariant is the
//   byte-identity contract between R5 and the pre-R5 R3+R4 behavior:
//   every existing R3 fallback and R4 template test exercises
//   underscore vocabulary, so the planner is strictly a new fallback
//   layer activated by new natural-language goal names.
//
//   Heuristic table:
//     FILE  :: "write note <tail>"   -> ["/tmp/ce_note_<id>.txt", <tail>]
//     HTTP  :: "fetch <url>"         -> [<url>, ""]
//     CODE  :: "run <expr>"          -> [<expr>]
//     AUDIO :: "say <text>"          -> ["/tmp/ce_speech.wav"]
//
//   MCP / TOOL / INTERNAL have NO planner heuristic this round --
//   the module always returns the empty list for those classes so the
//   caller falls through to R3 convention (MCP) or the pre-R2 5-arg
//   path (TOOL / INTERNAL).
//
// ADRs implemented: ADR-0113 (planner keyword heuristics, Phase R5).
// NOVA dependencies: builtins (len, char_at, substr, +, int_to_str,
//   list_new, push).
// CrossEngin dependencies: ../action/action_atoms.nova for the
//   `EFF_CLASS_*` constants.

import "../action/action_atoms.nova"

// ---- heuristic prefixes --------------------------------------------------
//
// Each prefix ends with a SPACE -- motor_map's default vocabulary uses
// UNDERSCORES, so a planner trigger is byte-impossible on the pre-R5
// goal name set. `PL_` prefix dodges the UPSTREAM §9/§10 module-level
// `let` collision class.

let PL_FILE_PREFIX  = "write note "
let PL_HTTP_PREFIX  = "fetch "
let PL_CODE_PREFIX  = "run "
let PL_AUDIO_PREFIX = "say "

// Bytewise prefix check -- walks `prefix` against the leading bytes
// of `s`. Verbatim shape of `motor_map.nova:71-82`'s `_mm_key_eq`
// byte-walker, tweaked for "starts-with" semantics (allow `s` longer
// than `prefix`). Dodges UPSTREAM §1 (`str_eq` on short literals is
// unreliable) and avoids any dependency on a shared helper.
//
// Returns 1 on prefix match, 0 otherwise. Null / 0 inputs return 0.
fn _pl_starts_with(s, prefix) {
    if s == 0 { return 0 }
    if prefix == 0 { return 0 }
    let ns = len(s)
    let np = len(prefix)
    if ns < np { return 0 }
    let i = 0
    while i < np {
        if char_at(s, i) != char_at(prefix, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Extract the tail of `s` starting at byte offset `n`. Returns the
// empty string when `s` is null / zero-length / `n` is past the end.
// Guards `len(0)` with an explicit `== 0` check first (SEGV
// avoidance per the standing NOVA quirks note).
fn _pl_tail_after(s, n) {
    if s == 0 { return "" }
    let m = len(s)
    if m == 0 { return "" }
    if n > m { return "" }
    if n == m { return "" }
    return substr(s, n, m - n)
}

// Public entry point. Returns a populated operand tuple on a planner
// hit (`[path, content]`, `[url, canned]`, `[expr]`, or `[out_path]`
// depending on class) or `list_new()` (empty) on miss. Callers
// interpret empty as "no planner hit -- fall through to R3".
//
// Parameters:
//   goal_name  string -- the goal's name as the goal engine reports
//                        it; may be "" (never 0 on real caller paths,
//                        but guarded for defense).
//   eff_class  int    -- EFF_CLASS_* from `motor_map_lookup`.
//   goal_id    int    -- id attached to the intent (used for the
//                        FILE path's `<id>` slot).
//
// Trailing-space-prefix invariant: every heuristic matches a prefix
// that ends with a space. Motor_map's default vocabulary uses
// underscores, so no R3+R4 call path exercises these prefixes --
// byte-identity for every pre-R5 caller is preserved.
//
// NOVA quirks dodged:
//   * `len(0)` guarded in `_pl_tail_after` with explicit `== 0`.
//   * No `str_eq` on short literals; byte-walker only.
//   * `int_to_str` is runtime-safe (R3d confirmed; see
//     operand_builder.nova:66).
//   * No `type_of`, no `memcpy_raw`, no high-bit sentinel equality.
fn planner_materialize(goal_name, eff_class, goal_id) {
    let ops = list_new()
    let name = goal_name
    if name == 0 { name = "" }
    // Empty goal name cannot match any trailing-space prefix (prefix
    // is at least 4 bytes long for `"say "`; the shortest). Short-
    // circuit before the per-class switch.
    if len(name) == 0 { return ops }

    if eff_class == EFF_CLASS_FILE {
        if _pl_starts_with(name, PL_FILE_PREFIX) == 1 {
            let tail = _pl_tail_after(name, len(PL_FILE_PREFIX))
            push(ops, "/tmp/ce_note_" + int_to_str(goal_id) + ".txt")
            push(ops, tail)
            return ops
        }
        return ops
    }
    if eff_class == EFF_CLASS_HTTP {
        if _pl_starts_with(name, PL_HTTP_PREFIX) == 1 {
            let tail = _pl_tail_after(name, len(PL_HTTP_PREFIX))
            push(ops, tail)
            push(ops, "")
            return ops
        }
        return ops
    }
    if eff_class == EFF_CLASS_CODE {
        if _pl_starts_with(name, PL_CODE_PREFIX) == 1 {
            let tail = _pl_tail_after(name, len(PL_CODE_PREFIX))
            push(ops, tail)
            return ops
        }
        return ops
    }
    if eff_class == EFF_CLASS_AUDIO {
        if _pl_starts_with(name, PL_AUDIO_PREFIX) == 1 {
            push(ops, "/tmp/ce_speech.wav")
            return ops
        }
        return ops
    }
    // MCP / TOOL / INTERNAL / SPEAK: no planner heuristic this round.
    // Returning the empty `list_new()` lets `operand_builder_build`
    // fall through to its R3 convention switch (MCP) or the pre-R2
    // 5-arg path (TOOL / INTERNAL / SPEAK).
    return ops
}
