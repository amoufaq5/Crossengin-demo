// CrossEngin perception: input classifier (ADR-0055).
//
// Purpose
//   The missing front door of comprehension. Before R40 every utterance ran
//   the identical perceive -> forward-chain -> ACK path, so a greeting, a
//   maths question, a moral debate and a confession all collapsed into the
//   same "okay" fallback (the user-reported "it is all okay" / "no signs of
//   reasoning"). This module assigns each input a CATEGORY so the cognitive
//   router (src/agent/cognitive_router.nova) can pick a DIFFERENT atom
//   extraction + reasoning pattern + learning policy + response shape per
//   category -- the "different approaches for different input" requirement.
//
//   Taxonomy (the five requested categories plus four operational ones that
//   stop the generic fallback and are documented in docs/adr/ADR-0055-*.md):
//     academic    -- definitional / explanatory knowledge seeking
//                    ("what is X", "why does Y", "explain Z")
//     personal    -- the speaker's own state / life ("I feel ...", "my ...")
//     social      -- interpersonal smalltalk directed at the agent
//     debatable   -- opinion / normative / comparative ("is X better than Y",
//                    "should we ...", "in your opinion")
//     financial   -- money / value laden ("price", "profit", "$", "invest")
//     -- operational additions (proposed in this pass, see the ADR) --
//     arithmetic  -- a computable numeric expression ("2 + 2", "15% of 200")
//     procedural  -- how-to / steps ("how do I ...", "how to ...")
//     greeting    -- hello / thanks / bye (a social subtype worth its own
//                    minimal, KG-non-polluting handling)
//     factual     -- a declarative assertion the user is teaching the agent
//                    ("the sky is blue") -- distinct from a question
//     unknown     -- nothing matched; the router falls back gracefully
//
//   Mechanism: cheap lexical + shape signals score every category; the
//   highest score wins, with a fixed priority order breaking ties. This is
//   deliberately heuristic and self-contained (builtins only, no KG) so it is
//   trivially unit-testable and cannot regress cognition. The ADR documents
//   the migration path to a LEARNED classifier (category atoms whose senses
//   the reader strengthens on confirmed routes), which slots in behind the
//   same classify_input() contract without touching the router.
//
// ADRs implemented: ADR-0055 (input classification + per-category routing).
// NOVA dependencies: builtins only (len, char_at, chr, substr, split, str_eq,
//   str_trim, str_find, push, list_new).
// CrossEngin dependencies: NONE (kept pure for testability, mirroring the
//   src/chat/helpers.nova contract).

// ---- category codes -------------------------------------------------------
let CAT_UNKNOWN    = 0
let CAT_GREETING   = 1
let CAT_SOCIAL     = 2
let CAT_PERSONAL   = 3
let CAT_ACADEMIC   = 4
let CAT_DEBATABLE  = 5
let CAT_FINANCIAL  = 6
let CAT_ARITHMETIC = 7
let CAT_PROCEDURAL = 8
let CAT_FACTUAL    = 9
let CAT_COUNT      = 10

fn cat_name(c) {
    if c == CAT_GREETING   { return "greeting" }
    if c == CAT_SOCIAL     { return "social" }
    if c == CAT_PERSONAL   { return "personal" }
    if c == CAT_ACADEMIC   { return "academic" }
    if c == CAT_DEBATABLE  { return "debatable" }
    if c == CAT_FINANCIAL  { return "financial" }
    if c == CAT_ARITHMETIC { return "arithmetic" }
    if c == CAT_PROCEDURAL { return "procedural" }
    if c == CAT_FACTUAL    { return "factual" }
    return "unknown"
}

// ---- low-level string helpers (pure) --------------------------------------
fn _ic_lower_char(ch) {
    if ch >= 65 {
        if ch <= 90 { return ch + 32 }
    }
    return ch
}

fn _ic_lower(s) {
    let out = ""
    let i = 0
    while i < len(s) {
        out = out + chr(_ic_lower_char(char_at(s, i)))
        i = i + 1
    }
    return out
}

// a-z (post-lower) or 0-9
fn _ic_is_alnum(ch) {
    if ch >= 97 { if ch <= 122 { return 1 } }
    if ch >= 48 { if ch <= 57  { return 1 } }
    return 0
}

// Strip leading/trailing non-alnum so "blue." -> "blue", "you?" -> "you".
// Internal apostrophes survive so "i'm" / "don't" stay intact.
fn _ic_strip_edges(tok) {
    let n = len(tok)
    let a = 0
    let stop = 0
    while stop == 0 {
        if a >= n { stop = 1 }
        else if _ic_is_alnum(char_at(tok, a)) == 1 { stop = 1 }
        else { a = a + 1 }
    }
    let b = n
    stop = 0
    while stop == 0 {
        if b <= a { stop = 1 }
        else if _ic_is_alnum(char_at(tok, b - 1)) == 1 { stop = 1 }
        else { b = b - 1 }
    }
    if b <= a { return "" }
    return substr(tok, a, b - a)
}

// Tokenize already-lowercased text into punctuation-trimmed words.
fn _ic_tokens(norm) {
    let raw = split(norm, " ")
    let out = list_new()
    let i = 0
    while i < len(raw) {
        let t = _ic_strip_edges(raw[i])
        if len(t) > 0 { push(out, t) }
        i = i + 1
    }
    return out
}

fn _ic_in(w, words) {
    let i = 0
    while i < len(words) {
        if str_eq(w, words[i]) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _ic_has(toks, w) {
    let i = 0
    while i < len(toks) {
        if str_eq(toks[i], w) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _ic_has_any(toks, words) {
    let i = 0
    while i < len(words) {
        if _ic_has(toks, words[i]) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _ic_count_any(toks, words) {
    let n = 0
    let i = 0
    while i < len(words) {
        if _ic_has(toks, words[i]) == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Substring test on the raw normalized string (for multi-word phrases).
fn _ic_sub(hay, needle) {
    if str_find(hay, needle) != (0 - 1) { return 1 }
    return 0
}

fn _ic_has_digit(s) {
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c >= 48 { if c <= 57 { return 1 } }
        i = i + 1
    }
    return 0
}

// A pure number token: digits with at most one '.' (e.g. "12", "3.5").
fn _ic_is_number_tok(tok) {
    if len(tok) == 0 { return 0 }
    let i = 0
    let dots = 0
    let digs = 0
    while i < len(tok) {
        let c = char_at(tok, i)
        if c >= 48 {
            if c <= 57 { digs = digs + 1 }
            else { return 0 }
        } else if c == 46 {
            dots = dots + 1
        } else {
            return 0
        }
        i = i + 1
    }
    if digs == 0 { return 0 }
    if dots > 1 { return 0 }
    return 1
}

// '+', '*', '/', '=' anywhere -> arithmetic operator present.
fn _ic_has_arith_char(s) {
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 43 { return 1 }
        if c == 42 { return 1 }
        if c == 47 { return 1 }
        if c == 61 { return 1 }
        i = i + 1
    }
    return 0
}

fn _ic_has_char(s, target) {
    let i = 0
    while i < len(s) {
        if char_at(s, i) == target { return 1 }
        i = i + 1
    }
    return 0
}

// ---- word banks (inline literals; proven to compile as call args) ---------
fn _ic_greet_words()  { return ["hi", "hello", "hey", "yo", "hiya", "howdy", "greetings", "sup", "heya", "hello!", "thanks", "thank", "thx", "bye", "goodbye", "cya", "welcome"] }
fn _ic_qword()        { return ["what", "why", "how", "when", "where", "who", "which", "whose", "is", "are", "do", "does", "can", "could", "should", "would", "will"] }
fn _ic_money_words()  { return ["price", "cost", "costs", "profit", "salary", "invest", "investment", "investing", "budget", "tax", "taxes", "loan", "interest", "revenue", "money", "afford", "mortgage", "rent", "wage", "wages", "income", "expense", "expenses", "dollar", "dollars", "euro", "euros", "pound", "pounds", "cash", "payment", "pay", "cheaper", "expensive", "discount", "savings", "debt", "finance", "financial"] }
fn _ic_arith_words()  { return ["plus", "minus", "times", "multiplied", "divided", "divide", "sum", "square", "sqrt", "modulo", "percent"] }
fn _ic_debate_words() { return ["better", "worse", "best", "worst", "versus", "vs", "should", "ought", "prefer", "agree", "disagree", "opinion", "moral", "ethical", "ethics", "fair", "unfair", "justified", "overrated", "underrated"] }
fn _ic_academic_words() { return ["because", "theory", "science", "scientific", "definition", "concept", "cause", "causes", "hypothesis", "evidence", "physics", "chemistry", "biology", "mathematics", "history", "philosophy", "photosynthesis", "gravity", "evolution"] }
fn _ic_affect_words() { return ["feel", "feeling", "felt", "happy", "sad", "tired", "angry", "anxious", "scared", "afraid", "lonely", "excited", "bored", "sick", "love", "hate", "wish", "hope", "worried", "stressed", "depressed", "nervous", "proud", "ashamed", "grateful"] }
fn _ic_first_person() { return ["i", "i'm", "im", "my", "me", "mine", "myself", "i've", "i'd", "i'll"] }
fn _ic_social_words() { return ["lol", "haha", "cool", "awesome", "nice", "wow", "ok", "okay", "sup"] }

// ---- classification --------------------------------------------------------
fn _ic_result(cat, conf, signals) {
    let r = list_new()
    push(r, cat)
    push(r, conf)
    push(r, signals)
    return r
}

fn _ic_clamp(v) {
    if v > 1000 { return 1000 }
    if v < 0 { return 0 }
    return v
}

// classify_input(text) -> [category, confidence_milli, signals_list].
// confidence is the winning category's score clamped to 0..1000; signals is a
// short list of human-readable tags describing what fired (for the trace).
fn classify_input(text) {
    let norm = _ic_lower(str_trim(text))
    let toks = _ic_tokens(norm)
    let nt = len(toks)
    if nt == 0 { return _ic_result(CAT_UNKNOWN, 0, list_new()) }

    let first = toks[0]
    let has_q = _ic_has_char(norm, 63)          // '?'
    let q_lead = _ic_in(first, _ic_qword())
    let has_digit = _ic_has_digit(norm)
    let has_arith_char = _ic_has_arith_char(norm)
    let has_percent = _ic_has_char(norm, 37)    // '%'
    let has_dollar = _ic_has_char(norm, 36)     // '$'
    let n_money = _ic_count_any(toks, _ic_money_words())
    let n_arith_w = _ic_count_any(toks, _ic_arith_words())
    let n_debate = _ic_count_any(toks, _ic_debate_words())
    let n_acad = _ic_count_any(toks, _ic_academic_words())
    let n_affect = _ic_count_any(toks, _ic_affect_words())
    let has_first = _ic_has_any(toks, _ic_first_person())
    let has_copula = _ic_has_any(toks, ["is", "are", "was", "were", "has", "have", "means", "causes", "equals"])

    let signals = list_new()

    // ---- ARITHMETIC: digits + an operator (char or word), money-free -------
    let s_arith = 0
    if has_digit == 1 {
        if has_arith_char == 1 { s_arith = 1000 }
        else if n_arith_w > 0 { s_arith = 900 }
        else if has_percent == 1 { if _ic_sub(norm, "of") == 1 { s_arith = 850 } }
    }
    // A money context demotes pure arithmetic toward financial.
    if n_money > 0 { if s_arith > 0 { s_arith = s_arith - 500 } }
    if has_dollar == 1 { if s_arith > 0 { s_arith = s_arith - 500 } }

    // ---- FINANCIAL: currency / money vocabulary ----------------------------
    let s_fin = 0
    if has_dollar == 1 { s_fin = 900 }
    if n_money > 0 {
        let m = 800 + 60 * n_money
        if m > s_fin { s_fin = m }
    }

    // ---- GREETING ----------------------------------------------------------
    let s_greet = 0
    if _ic_in(first, _ic_greet_words()) == 1 { s_greet = 1000 }
    else if str_eq(first, "good") == 1 {
        if _ic_has_any(toks, ["morning", "afternoon", "evening", "night"]) == 1 { s_greet = 900 }
    }
    if _ic_has_any(toks, ["thanks", "thank", "thx", "bye", "goodbye"]) == 1 {
        if nt <= 4 { if s_greet < 850 { s_greet = 850 } }
    }

    // ---- PROCEDURAL: how-to / steps ----------------------------------------
    let s_proc = 0
    if _ic_sub(norm, "how do i") == 1 { s_proc = 950 }
    else if _ic_sub(norm, "how to") == 1 { s_proc = 950 }
    else if _ic_sub(norm, "how can i") == 1 { s_proc = 920 }
    else if _ic_sub(norm, "how should i") == 1 { s_proc = 900 }
    else if _ic_sub(norm, "steps to") == 1 { s_proc = 880 }
    if _ic_has_any(toks, ["steps", "tutorial", "guide", "instructions", "procedure", "recipe"]) == 1 {
        if s_proc < 600 { s_proc = 600 }
    }

    // ---- DEBATABLE: comparative / normative / opinion ----------------------
    let s_debate = 0
    if n_debate > 0 { s_debate = 500 + 130 * n_debate }
    if _ic_sub(norm, "better than") == 1 { if s_debate < 850 { s_debate = 850 } }
    if _ic_sub(norm, "worse than") == 1 { if s_debate < 850 { s_debate = 850 } }
    if _ic_sub(norm, "do you think") == 1 { s_debate = s_debate + 300 }
    if _ic_sub(norm, "what do you think") == 1 { s_debate = s_debate + 300 }
    if _ic_sub(norm, "in your opinion") == 1 { s_debate = s_debate + 300 }
    if _ic_sub(norm, "should i") == 1 { if s_debate < 700 { s_debate = 700 } }
    if _ic_sub(norm, "should we") == 1 { if s_debate < 700 { s_debate = 700 } }
    // "X or Y?" comparison: an explicit 'or' inside a question.
    if has_q == 1 { if _ic_has(toks, "or") == 1 { s_debate = s_debate + 200 } }

    // ---- ACADEMIC: definitional / explanatory ------------------------------
    let s_acad = 0
    if _ic_sub(norm, "what is") == 1 { s_acad = 800 }
    else if _ic_sub(norm, "what are") == 1 { s_acad = 800 }
    else if _ic_sub(norm, "what was") == 1 { s_acad = 760 }
    else if str_eq(first, "why") == 1 { s_acad = 800 }
    else if _ic_sub(norm, "how does") == 1 { s_acad = 760 }
    else if _ic_sub(norm, "how do ") == 1 { s_acad = 600 }
    else if _ic_in(first, ["define", "explain", "describe"]) == 1 { s_acad = 820 }
    if n_acad > 0 { s_acad = s_acad + 150 * n_acad }
    // A bare question word with no other strong signal still leans academic.
    if s_acad == 0 { if q_lead == 1 { if has_q == 1 { s_acad = 400 } } }

    // ---- PERSONAL: speaker's own state / life ------------------------------
    let s_personal = 0
    if has_first == 1 {
        if n_affect > 0 { s_personal = 800 + 40 * n_affect }
        else { s_personal = 450 }
    }
    if _ic_sub(norm, "i feel") == 1 { if s_personal < 850 { s_personal = 850 } }
    if _ic_sub(norm, "i am ") == 1 { if n_affect > 0 { if s_personal < 820 { s_personal = 820 } } }
    if _ic_sub(norm, "i'm ") == 1 { if n_affect > 0 { if s_personal < 820 { s_personal = 820 } } }

    // ---- SOCIAL: smalltalk directed at the agent ---------------------------
    let s_social = 0
    if _ic_sub(norm, "how are you") == 1 { s_social = 800 }
    else if _ic_sub(norm, "how's it going") == 1 { s_social = 780 }
    else if _ic_sub(norm, "what's up") == 1 { s_social = 760 }
    else if _ic_sub(norm, "whats up") == 1 { s_social = 760 }
    else if _ic_sub(norm, "tell me about yourself") == 1 { s_social = 760 }
    if _ic_has_any(toks, _ic_social_words()) == 1 { if s_social < 450 { s_social = 450 } }
    // "do you ..." / "are you ..." about the agent (not a comparison) leans social.
    if s_social == 0 {
        if _ic_sub(norm, "do you ") == 1 { if n_debate == 0 { s_social = 450 } }
        if _ic_sub(norm, "are you ") == 1 { if n_debate == 0 { s_social = 450 } }
    }

    // ---- FACTUAL: a declarative assertion (no question, has a copula) ------
    let s_fact = 0
    if has_q == 0 {
        if q_lead == 0 {
            if has_copula == 1 {
                if nt >= 3 { s_fact = 600 }
            }
        }
    }

    // ---- selection: highest score wins; priority order breaks ties ---------
    let best_cat = CAT_UNKNOWN
    let best = 0
    // Order is the tie-break priority (first listed wins an exact tie).
    if s_arith    > best { best = s_arith    best_cat = CAT_ARITHMETIC }
    if s_fin      > best { best = s_fin      best_cat = CAT_FINANCIAL }
    if s_greet    > best { best = s_greet    best_cat = CAT_GREETING }
    if s_proc     > best { best = s_proc     best_cat = CAT_PROCEDURAL }
    if s_debate   > best { best = s_debate   best_cat = CAT_DEBATABLE }
    if s_acad     > best { best = s_acad     best_cat = CAT_ACADEMIC }
    if s_personal > best { best = s_personal best_cat = CAT_PERSONAL }
    if s_social   > best { best = s_social   best_cat = CAT_SOCIAL }
    if s_fact     > best { best = s_fact     best_cat = CAT_FACTUAL }

    if best == 0 { return _ic_result(CAT_UNKNOWN, 0, signals) }
    push(signals, cat_name(best_cat))
    return _ic_result(best_cat, _ic_clamp(best), signals)
}

// Convenience accessors for the classify_input triple.
fn ci_category(r)   { return r[0] }
fn ci_confidence(r) { return r[1] }
fn ci_signals(r)    { return r[2] }
