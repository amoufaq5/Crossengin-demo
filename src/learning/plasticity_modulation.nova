// CrossEngin learning: plasticity modulation.
//
// Purpose
//   Computes the global modulator that scales synaptic learning rates
//   (ADR-0007's eta_h/eta_e) from emotional state and reward (ADR-0035). This is
//   exactly the modulator the tick driver currently passes as the neutral 1.0
//   (TD_MOD_NEUTRAL): emotional arousal raises plasticity (intense moments are
//   learned faster), reward raises it (rewarded synapses consolidate) while
//   punishment lowers it, and strong valence of either sign raises it
//   (emotionally charged events are memorable).
//
//   All inputs are milli on [-1,1] (valence, reward) or [0,1] (arousal); the
//   output is a milli factor around 1.0, clamped to a safe band. Self-contained
//   (no imports) so it never drags shared modules into a compile unit (NOVA
//   blocker #10); the emotion system (Phase 6) supplies the inputs and the agent
//   loop passes the result to tick_driver.
//
// ADRs implemented: ADR-0035 (emotion modulates plasticity), ADR-0007 (eta
//   scaling). NOVA dependencies: builtins. CrossEngin dependencies: none.

let PM_SCALE   = 1000
let PM_NEUTRAL = 1000   // 1.0 modulator (no modulation)

let PM_AROUSAL_GAIN  = 1000   // full arousal doubles plasticity
let PM_REWARD_GAIN   = 500    // full reward adds 0.5; punishment subtracts
let PM_VALENCE_GAIN  = 300    // strong valence (either sign) adds up to 0.3
let PM_MOD_MIN       = 200    // 0.2 floor
let PM_MOD_MAX       = 2500   // 2.5 ceiling

fn _pm_abs(x) {
    if x < 0 { return 0 - x }
    return x
}

fn _pm_clamp(v) {
    if v < PM_MOD_MIN { return PM_MOD_MIN }
    if v > PM_MOD_MAX { return PM_MOD_MAX }
    return v
}

fn pm_neutral() { return PM_NEUTRAL }

// The plasticity modulator from emotional valence/arousal and reward (all
// milli). Returns a milli factor in [PM_MOD_MIN, PM_MOD_MAX].
fn pm_modulator(valence, arousal, reward) {
    let arousal_term = arousal * PM_AROUSAL_GAIN / PM_SCALE
    let reward_term  = reward * PM_REWARD_GAIN / PM_SCALE
    let valence_term = _pm_abs(valence) * PM_VALENCE_GAIN / PM_SCALE
    return _pm_clamp(PM_NEUTRAL + arousal_term + reward_term + valence_term)
}

// Emotion only (no reward).
fn pm_from_emotion(valence, arousal) {
    return pm_modulator(valence, arousal, 0)
}
