// CrossEngin learning: source authority weighting and conflict resolution.
//
// Purpose
//   Weights evidence by source authority and resolves conflicts between claims
//   (ADR-0029). Three tiers carry evidence weights (and alpha/beta increments
//   3x the weight): Tier A (user / primary references) 1.0, Tier B (established
//   encyclopedias) 0.5, Tier C (everything else) 0.2. Within a tier, a recency
//   policy decides same-tier conflicts: normative domains use newest-wins,
//   classical domains oldest-wins, neutral domains combine. User-taught claims
//   (Tier A) outrank any fetched claim. Hard conflicts (two Tier-A disagree,
//   fetched vs user-taught, or a high-confidence atom overturned) freeze the
//   atom and surface to the user.
//
//   Weights/increments are integer milli. A source URL maps to a tier via a
//   small domain registry (default Tier C for unknown hosts).
//
// ADRs implemented: ADR-0029 (source authority, conflict resolution). Feeds
//   ADR-0023 (alpha/beta increments) and ADR-0030 (combined source weight).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/learning/source_whitelist.nova (host extraction).

import "source_whitelist.nova"

// ---- tiers and recency policies -------------------------------------------
let SA_TIER_A = 1
let SA_TIER_B = 2
let SA_TIER_C = 3

let SA_NEUTRAL   = 0   // combine both claims
let SA_NORMATIVE = 1   // newest-wins (guidelines, prices, current events)
let SA_CLASSICAL = 2   // oldest-wins (mathematics, anatomy, settled science)

// Evidence weight (milli) by tier (ADR-0029).
fn sa_weight(tier) {
    if tier == SA_TIER_A { return 1000 }
    if tier == SA_TIER_B { return 500 }
    return 200
}

// Alpha/beta increment (milli) applied to the winning side (= weight x 3).
fn sa_increment(tier) {
    if tier == SA_TIER_A { return 3000 }
    if tier == SA_TIER_B { return 1500 }
    return 600
}

// ---- domain registry ------------------------------------------------------
let SAR_TAG  = 0
let SAR_LIST = 1   // list of [domain, tier, policy]

fn sa_new() {
    let sa = list_new()
    push(sa, SAR_TAG)
    push(sa, list_new())
    return sa
}

fn sa_register(sa, domain, tier, policy) {
    let d = str_lower(str_trim(domain))
    let l = sa[SAR_LIST]
    let i = 0
    while i < len(l) {
        if str_eq(l[i][0], d) == 1 {
            list_set(l[i], 1, tier)
            list_set(l[i], 2, policy)
            return 1
        }
        i = i + 1
    }
    let e = list_new(); push(e, d); push(e, tier); push(e, policy)
    push(l, e)
    return 1
}

// Host-keyed tier accessor for meta-observer feedback (P1.1, ADR-0050).
// Sets a tier for a bare host string (no URL parsing). If the host is
// unknown, registers it with a neutral policy at the requested tier so the
// next sa_tier_for_host hit returns the new value. Returns 1 on success.
//
// The meta-observer uses this to promote / demote sources after sustained
// promotion / atrophy is observed. See `mo_apply_feedback` in
// `src/parts/meta/meta_observer.nova` for the synthetic-host mapping that
// bridges P15 source tags (`src:topic:fever`) into this host registry as
// `learned:topic:fever`.
fn sa_host_set_tier(sa, host, tier) {
    let d = str_lower(str_trim(host))
    let l = sa[SAR_LIST]
    let i = 0
    while i < len(l) {
        if str_eq(l[i][0], d) == 1 {
            list_set(l[i], 1, tier)
            return 1
        }
        i = i + 1
    }
    let e = list_new(); push(e, d); push(e, tier); push(e, SA_NEUTRAL)
    push(l, e)
    return 1
}

// Tier for a bare host string (no URL parsing). Default Tier C when unknown.
// Companion to sa_host_set_tier; used by meta-observer feedback to read the
// current tier before deciding to promote / demote a source.
fn sa_tier_for_host(sa, host) {
    let d = str_lower(str_trim(host))
    let l = sa[SAR_LIST]
    let i = 0
    while i < len(l) {
        if str_eq(l[i][0], d) == 1 { return l[i][1] }
        i = i + 1
    }
    return SA_TIER_C
}

fn _sa_lookup(sa, url) {
    let host = sw_host(url)
    let l = sa[SAR_LIST]
    let i = 0
    while i < len(l) {
        if str_eq(l[i][0], host) == 1 { return l[i] }
        i = i + 1
    }
    return 0
}

// Tier for a URL (default Tier C for unknown hosts).
fn sa_tier(sa, url) {
    let e = _sa_lookup(sa, url)
    if e == 0 { return SA_TIER_C }
    return e[1]
}

fn sa_policy(sa, url) {
    let e = _sa_lookup(sa, url)
    if e == 0 { return SA_NEUTRAL }
    return e[2]
}

fn sa_url_weight(sa, url)    { return sa_weight(sa_tier(sa, url)) }
fn sa_url_increment(sa, url) { return sa_increment(sa_tier(sa, url)) }

// ---- conflict resolution --------------------------------------------------
// Winner of a same-/cross-tier conflict by tier then recency policy.
// Returns 1 (a wins), 2 (b wins), or 0 (combine/neutral).
fn sa_resolve(tier_a, ts_a, tier_b, ts_b, policy) {
    if tier_a < tier_b { return 1 }
    if tier_b < tier_a { return 2 }
    if policy == SA_NORMATIVE {
        if ts_a >= ts_b { return 1 }
        return 2
    }
    if policy == SA_CLASSICAL {
        if ts_a <= ts_b { return 1 }
        return 2
    }
    return 0
}

// As above, but a user-taught claim outranks a non-user claim within a tier.
fn sa_resolve_sourced(tier_a, a_user, ts_a, tier_b, b_user, ts_b, policy) {
    if tier_a < tier_b { return 1 }
    if tier_b < tier_a { return 2 }
    if a_user != b_user {
        if a_user != 0 { return 1 }
        return 2
    }
    return sa_resolve(tier_a, ts_a, tier_b, ts_b, policy)
}

// Hard conflict: two Tier-A disagree, fetched contradicts user-taught, or a
// high-confidence atom (alpha+beta >= 20000, mean > 800) would be overturned.
fn sa_is_hard_conflict(tier_a, a_user, tier_b, b_user, loser_strength, loser_mean) {
    if tier_a == SA_TIER_A {
        if tier_b == SA_TIER_A { return 1 }
    }
    if a_user != b_user { return 1 }
    if loser_strength >= 20000 {
        if loser_mean > 800 { return 1 }
    }
    return 0
}

// A representative default authority registry.
fn sa_default() {
    let sa = sa_new()
    sa_register(sa, "www.who.int", SA_TIER_A, SA_NORMATIVE)
    sa_register(sa, "pubmed.ncbi.nlm.nih.gov", SA_TIER_A, SA_NEUTRAL)
    sa_register(sa, "docs.python.org", SA_TIER_A, SA_NORMATIVE)
    sa_register(sa, "en.wikipedia.org", SA_TIER_B, SA_NEUTRAL)
    sa_register(sa, "developer.mozilla.org", SA_TIER_B, SA_NORMATIVE)
    return sa
}
