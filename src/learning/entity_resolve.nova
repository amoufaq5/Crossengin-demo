// CrossEngin learning: entity resolution (P3, ADR-0053).
//
// Purpose
//   Resolve a surface mention ("car" / "automobile" / "the vehicle") to a single
//   CANONICAL atom *before* it is inserted, so the KG does not fragment into a
//   pile of near-duplicate concepts. Without this, "one atom answers many
//   phrasings" breaks: a query about "automobile" misses everything learned
//   under "car". This is the first real consumer of the P1 HDC layer -- meaning
//   lives in an atom's neighbourhood, so two mentions with the same neighbours
//   resolve together even when their spellings are unrelated.
//
//   Resolution order (cheapest / most certain first):
//     1. EXACT   -- a same-label atom already exists.
//     2. ALIAS   -- an explicit alias table maps the mention to a canonical
//                   label (curated synonyms, abbreviations, redirects).
//     3. HDC     -- the mention's neighbourhood hypervector is close (cosine >=
//                   threshold) to an existing atom's embed.
//     4. NEW     -- nothing matched; the caller mints a fresh atom.
//
//   HDC matching only compares same-dimension hypervectors, so it is inert
//   unless the substrate is in HDC embed mode (ADR-0051) and the candidate
//   atoms carry neighbourhood encodings; in LEGACY mode resolution falls back to
//   exact + alias, exactly as before.
//
// ADRs implemented: ADR-0053 (ingestion + entity resolution), ADR-0051 (HDC),
//   ADR-0016 (atoms). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/kg/multi_kg_manager.nova (transitively atom_store), src/kg/hdc_embed.nova.

import "../kg/multi_kg_manager.nova"
import "../kg/hdc_embed.nova"

// Default cosine (milli) above which an HDC match is accepted as the same
// entity. P1 measured shared-neighbourhood synonyms at ~700-1000 and unrelated
// concepts near 0, so 600 admits synonyms with margin and rejects the rest.
let ER_HDC_THRESHOLD = 600

// resolution provenance codes (how a mention was resolved).
let ER_VIA_NONE  = 0
let ER_VIA_EXACT = 1
let ER_VIA_ALIAS = 2
let ER_VIA_HDC   = 3
let ER_VIA_NEW   = 4

fn er_via_name(v) {
    if v == ER_VIA_EXACT { return "exact" }
    if v == ER_VIA_ALIAS { return "alias" }
    if v == ER_VIA_HDC   { return "hdc" }
    if v == ER_VIA_NEW   { return "new" }
    return "none"
}

// ---- alias table ----------------------------------------------------------
// A scanned list of [alias_label, canonical_label]. Small and curated; a hash
// index can replace the scan if it ever grows large.
fn er_aliases_new() { return list_new() }

fn er_alias_add(table, alias, canonical) {
    let i = 0
    while i < len(table) {
        if str_eq(table[i][0], alias) == 1 {
            list_set(table[i], 1, canonical)
            return 1
        }
        i = i + 1
    }
    let e = list_new()
    push(e, alias); push(e, canonical)
    push(table, e)
    return 1
}

// Canonical label for an alias, following one hop ("" if not aliased).
fn er_alias_lookup(table, mention) {
    let i = 0
    while i < len(table) {
        if str_eq(table[i][0], mention) == 1 { return table[i][1] }
        i = i + 1
    }
    return ""
}

// ADR-0082: is `label` the canonical target of any alias entry? The table is a
// `[alias_label, canonical_label]` list, and a mention resolves via
// kg_find_atom(canonical), so the atom whose label == some entry's canonical is
// that alias's resolution target -- an id-holder the death gate must respect
// (reclaiming it would dangle the alias, and its mention would then re-mint a
// fresh atom). Pure string scan; mirrors er_alias_lookup's iteration.
fn er_aliases_has_canonical(aliases, label) {
    if aliases == 0 { return 0 }
    let i = 0
    while i < len(aliases) {
        if str_eq(aliases[i][1], label) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- HDC nearest-atom match -----------------------------------------------
// The candidate atom whose embed is most similar to `query_vec`, if that
// similarity reaches `threshold`; else 0. Only same-dimension embeds are
// compared, so legacy 8-dim atoms never spuriously match a 10k mention vector.
fn er_best_hdc_match(atoms, query_vec, threshold) {
    let qd = len(query_vec)
    if qd == 0 { return 0 }
    let best = 0
    let best_sim = threshold - 1
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 {
            let e = atom_embed(a)
            if len(e) == qd {
                let sim = hdc_cosine(query_vec, e)
                if sim > best_sim {
                    best_sim = sim
                    best = a
                }
            }
        }
        i = i + 1
    }
    if best_sim < threshold { return 0 }
    return best
}

// ---- resolution -----------------------------------------------------------
// Resolve a mention to an existing atom in `kg`, or 0 if none. `mention_vec` is
// the mention's neighbourhood hypervector (or an empty list to skip the HDC
// step). `aliases` may be 0 to skip the alias step. Returns [atom, via].
fn er_resolve(kg, aliases, mention, mention_vec, threshold) {
    // 1. exact label.
    let exact = kg_find_atom(kg, mention)
    if exact != 0 {
        let r = list_new(); push(r, exact); push(r, ER_VIA_EXACT); return r
    }
    // 2. alias -> canonical label.
    if aliases != 0 {
        let canon = er_alias_lookup(aliases, mention)
        if len(canon) > 0 {
            let ca = kg_find_atom(kg, canon)
            if ca != 0 {
                let r = list_new(); push(r, ca); push(r, ER_VIA_ALIAS); return r
            }
        }
    }
    // 3. HDC neighbourhood similarity.
    if len(mention_vec) > 0 {
        let m = er_best_hdc_match(kg_atoms(kg), mention_vec, threshold)
        if m != 0 {
            let r = list_new(); push(r, m); push(r, ER_VIA_HDC); return r
        }
    }
    let r = list_new(); push(r, 0); push(r, ER_VIA_NONE); return r
}

// Resolve, or mint a fresh CONCEPT atom when nothing matches. Returns
// [atom, via, created_flag]. The new atom is given the mention's hypervector as
// its embed so the NEXT mention can resolve against it by HDC. `mention_vec`
// may be empty (then no embed is set and only exact/alias resolution applies).
//
// ADR-0084 (GAP A): when the mention resolves to an EXISTING atom by HDC
// similarity (a GENUINE synonym -- the surface form differs from the resolved
// atom's canonical label), record `mention -> canonical_label` in the alias
// table. This (1) caches the resolution so the NEXT occurrence of `mention`
// takes the cheap alias path instead of recomputing HDC, and (2) makes the
// atom an alias resolution target, so the ADR-0082 alias death-gate
// (_adm_is_alias_referenced) protects it from collection. Only HDC hits are
// recorded -- NOT new mints (nothing to alias to yet), NOT exact/alias hits
// (already canonical or already recorded) -- and never a no-op self-alias
// (mention == canonical label). The record is the ONLY side effect beyond the
// existing mint; it touches the caller-owned `aliases` table only.
fn er_resolve_or_create(kg, aliases, mention, mention_vec, threshold, now) {
    let res = er_resolve(kg, aliases, mention, mention_vec, threshold)
    if res[0] != 0 {
        // ADR-0084: cache a genuine synonym (HDC hit to a differently-labelled
        // atom) as an alias. er_alias_add dedups, so re-recording is harmless.
        if res[1] == ER_VIA_HDC {
            if aliases != 0 {
                let canon = atom_label(res[0])
                if str_eq(mention, canon) == 0 {
                    er_alias_add(aliases, mention, canon)
                }
            }
        }
        let r = list_new(); push(r, res[0]); push(r, res[1]); push(r, 0); return r
    }
    let a = kg_add_atom(kg, ATOM_CONCEPT, mention, now)
    if len(mention_vec) > 0 { atom_set_embed(a, mention_vec) }
    let r = list_new(); push(r, a); push(r, ER_VIA_NEW); push(r, 1); return r
}
