// CrossEngin learning: research source candidates.
//
// Purpose
//   Autonomous research (R50) and /research turn an unknown topic into a URL to
//   fetch + learn. R50 used a SINGLE guess -- the English-Wikipedia article at
//   the capitalized title -- which misses two common cases:
//     * acronyms: "dna" -> "Dna", a 301 the no-redirect TLS client can't
//       follow, instead of the real title "DNA";
//     * topics whose en.wikipedia page is a disambiguation stub (few real
//       sentences, so almost no reasoning operators are learned).
//   This module builds an ORDERED list of (source, url) candidates spanning
//   title-casings and multiple hosts, so the fetch loop can fall through to the
//   next source when one yields nothing real -- multi-source, disambiguation-
//   aware research (R53). The candidate list is PURE (no IO); the chat's
//   _research_topic does the fetching and keeps the strongest result, and since
//   each learn_from_url ingest is idempotent by label, fetching several sources
//   reinforces + extends knowledge rather than duplicating it.
//
// ADRs: extends ADR-0026 (self-learning triggers) + ADR-0028 (learn pipeline).
// NOVA dependencies: builtins (len, char_at, chr, substr, str_eq, str_upper,
//   str_replace, list_new, push). CrossEngin dependencies: none.

// A research candidate is [source_label, url].
fn research_cand(label, url) {
    let c = list_new()
    push(c, label)
    push(c, url)
    return c
}
fn research_cand_label(c) { return c[0] }
fn research_cand_url(c)   { return c[1] }

// Capitalize the first letter (ASCII), preserve the rest. "photosynthesis" ->
// "Photosynthesis". Wikipedia titles are first-letter-capital by convention, so
// this hits the canonical article directly instead of a lowercase redirect.
fn research_cap_first(topic) {
    if len(topic) == 0 { return "" }
    let first = char_at(topic, 0)
    if first >= 97 { if first <= 122 { first = first - 32 } }
    return chr(first) + substr(topic, 1, len(topic) - 1)
}

// Wiki path form: spaces -> underscores (Wikipedia's title separator). Topics
// from the lexer are single tokens, but a multi-word topic should still form a
// valid title rather than a URL with raw spaces.
fn research_wiki_path(title) {
    return str_replace(title, " ", "_")
}

// Ordered (source, url) candidates for a topic. Tried in order by the fetch
// loop; the first that yields a real article wins, and weak/failed candidates
// fall through to the next SOURCE -- so a disambiguation stub or an acronym
// redirect on one host doesn't end the search.
fn research_candidates(topic) {
    let out = list_new()
    if len(topic) == 0 { return out }
    let cap = research_wiki_path(research_cap_first(topic))
    // 1. English Wikipedia at the canonical capitalized title.
    push(out, research_cand("en.wikipedia",
        "https://en.wikipedia.org/wiki/" + cap))
    // 2. Acronym disambiguation: a short all-lower token is usually an
    //    initialism whose title is upper-case (dna -> DNA). The capitalized
    //    guess only 301-redirects, which the no-redirect client can't follow,
    //    so try the upper-case title before giving up on Wikipedia.
    if len(topic) <= 5 {
        let up = research_wiki_path(str_upper(topic))
        if str_eq(up, cap) == 0 {
            push(out, research_cand("en.wikipedia/acronym",
                "https://en.wikipedia.org/wiki/" + up))
        }
    }
    // 3. Simple English Wikipedia: a genuinely different host whose articles are
    //    shorter and far less likely to be disambiguation pages -- a good second
    //    opinion when the main article was a stub or missing.
    push(out, research_cand("simple.wikipedia",
        "https://simple.wikipedia.org/wiki/" + cap))
    return out
}

// A fetched candidate is "strong" (a real article -- the search can stop) when
// it learned at least `min_ops` reasoning operators. A disambiguation page,
// redirect stub, or 404 yields ~none, so the loop falls through to the next
// source. Centralized here so the threshold is a single knob.
fn research_is_strong(ops, min_ops) {
    if ops >= min_ops { return 1 }
    return 0
}
