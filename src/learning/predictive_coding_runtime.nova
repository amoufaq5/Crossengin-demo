// CrossEngin learning: predictive coding runtime.
//
// Purpose
//   Predictive coding (ADR-0024): top-down predictions meet bottom-up
//   observations at the first nodes, and the residual -- precision-weighted by
//   the prediction's confidence -- is the error. Well-predicted input is
//   suppressed (no upward signal); error above threshold emits a high-priority
//   XSIG_ERROR upward; sustained large error is surprise. The error term is what
//   the tick driver currently passes as 0; it drives synapse plasticity
//   (ADR-0007), belief updates as contradicting evidence (ADR-0023), and
//   self-learning triggers (ADR-0026).
//
//   Activations/errors are integer milli on a normalized [0,1] scale.
//   Precision is a milli weight (e.g. a belief confidence). Fixed-point multiply
//   is inlined here so this module imports only the standalone signal taxonomy
//   (avoids NOVA blocker #10).
//
// ADRs implemented: ADR-0024 (predictive coding), ADR-0008 (XSIG_ERROR is high
//   priority). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/substrate/signal_dispatch.nova.

import "../substrate/signal_dispatch.nova"

let PC_SCALE         = 1000
let PC_THETA_ERR     = 150   // 0.15 suppression threshold (ADR-0024)
let PC_THETA_SURPRISE= 300   // 0.30 surprise threshold

fn pc_abs(x) {
    if x < 0 { return 0 - x }
    return x
}

// Raw residual = actual - predicted (signed milli).
fn pc_residual(actual, predicted) {
    return actual - predicted
}

// Precision-weighted error: residual scaled by precision (sign preserved).
fn pc_precision_error(actual, predicted, precision) {
    return (actual - predicted) * precision / PC_SCALE
}

// Emit upward only when the error clears the suppression threshold.
fn pc_should_emit(error) {
    if pc_abs(error) > PC_THETA_ERR { return 1 }
    return 0
}

// Surprise: error large enough to preempt routine processing.
fn pc_is_surprise(error) {
    if pc_abs(error) > PC_THETA_SURPRISE { return 1 }
    return 0
}

// Build the upward error signal (XSIG_ERROR, priority 7 by taxonomy). Strength
// is the magnitude; meta carries the signed error.
fn pc_emit_error(src, dst, error) {
    return sig_new(XSIG_ERROR, src, dst, pc_abs(error), 0, error)
}

// ---- prediction buffer (top-down predictions awaiting observation) --------
let PC_BUF_TAG = 0
let PC_BUF_LIST= 1   // list of [node_id, predicted_activation]

fn pc_buffer_new() {
    let b = list_new()
    push(b, 0)
    push(b, list_new())
    return b
}

fn _pc_buf_index(buf, node) {
    let l = buf[PC_BUF_LIST]
    let i = 0
    while i < len(l) {
        if l[i][0] == node { return i }
        i = i + 1
    }
    return -1
}

// Set (or replace) the predicted activation for a node.
fn pc_buffer_set(buf, node, predicted) {
    let l = buf[PC_BUF_LIST]
    let idx = _pc_buf_index(buf, node)
    if idx == -1 {
        let e = list_new(); push(e, node); push(e, predicted); push(l, e)
    } else {
        list_set(l[idx], 1, predicted)
    }
    return 1
}

// Predicted activation for a node (0 if none).
fn pc_buffer_get(buf, node) {
    let idx = _pc_buf_index(buf, node)
    if idx == -1 { return 0 }
    return buf[PC_BUF_LIST][idx][1]
}

// Unrefreshed predictions decay each tick (prevents self-confirming loops).
fn pc_buffer_decay(buf, retain_milli) {
    let l = buf[PC_BUF_LIST]
    let i = 0
    while i < len(l) {
        list_set(l[i], 1, l[i][1] * retain_milli / PC_SCALE)
        i = i + 1
    }
}

// Process an observation against the buffered prediction: returns the
// precision-weighted error (the caller decides emission / consumers).
fn pc_process(buf, node, actual, precision) {
    return pc_precision_error(actual, pc_buffer_get(buf, node), precision)
}

// ---- adaptive sequence predictor (P2, ADR-0052) ---------------------------
// A gradient-free, delta-rule predictor of next-moment signals. It maps a
// CONTEXT key (e.g. a signature of the previous moment) to a learned per-node
// expected value. Each observation nudges the stored estimate toward what was
// actually seen; on a repeating sequence the estimates converge to the
// observed values, so prediction error falls toward zero. This is the
// predict -> error -> learn loop closing locally, with no gradient and no
// offline training run.
//
// Layout: [tag, contexts] where contexts is a scanned list of
// [context_key, predictions], predictions indexed by node id -> milli value.
let PCP_TAG = 0
let PCP_CTX = 1

fn pc_pred_new() {
    let p = list_new()
    push(p, 0)
    push(p, list_new())
    return p
}

fn _pcp_ctx_index(p, ctx) {
    let l = p[PCP_CTX]
    let i = 0
    while i < len(l) {
        if l[i][0] == ctx { return i }
        i = i + 1
    }
    return -1
}

fn _pcp_ctx_preds(p, ctx) {
    let idx = _pcp_ctx_index(p, ctx)
    if idx != -1 { return p[PCP_CTX][idx][1] }
    let preds = list_new()
    let entry = list_new()
    push(entry, ctx)
    push(entry, preds)
    push(p[PCP_CTX], entry)
    return preds
}

// Predicted activation for `node` under context `ctx` (0 if never learned).
fn pc_pred_predict(p, ctx, node) {
    let idx = _pcp_ctx_index(p, ctx)
    if idx == -1 { return 0 }
    let preds = p[PCP_CTX][idx][1]
    if node < 0 { return 0 }
    if node >= len(preds) { return 0 }
    return preds[node]
}

// Delta-rule update: prediction += lr * (actual - prediction). Returns the new
// prediction. Grows the per-context vector to cover `node` as needed.
fn pc_pred_learn(p, ctx, node, actual, lr) {
    let preds = _pcp_ctx_preds(p, ctx)
    while len(preds) <= node { push(preds, 0) }
    let cur = preds[node]
    let updated = cur + (actual - cur) * lr / PC_SCALE
    list_set(preds, node, updated)
    return updated
}

// Precision-weighted error of the current prediction for (ctx, node) against an
// observation -- the quantity the loop drives toward zero.
fn pc_pred_error(p, ctx, node, actual, precision) {
    return pc_precision_error(actual, pc_pred_predict(p, ctx, node), precision)
}

// ---- neuromodulator scalar (P2, ADR-0052) ---------------------------------
// Collapse reward / prediction-error / surprise into the single signed scalar
// (milli, -1000..1000) broadcast to synapse plasticity (syn_neuromodulate).
// Reward sets the sign and base; surprise and |prediction error| AMPLIFY how
// strongly the moment is learned -- surprising, high-error outcomes are more
// salient. Reward is sourced from XSIG_REWARD, or from valence via
// emotion_valence_signed (appraisal.nova); error/surprise come from the
// predictive-coding pass above. Kept in this module (not synapse_graph) so the
// substrate stays free of any reward/emotion dependency.
let PC_NM_MAX = 1000

fn pc_neuromod_scalar(reward, pred_error, surprise) {
    // amp >= 1.0; operands stay well under NOVA's large-multiply threshold.
    let amp = PC_SCALE + (surprise / 2) + (pc_abs(pred_error) / 2)
    let nm = reward * amp / PC_SCALE
    if nm > PC_NM_MAX { return PC_NM_MAX }
    if nm < (0 - PC_NM_MAX) { return 0 - PC_NM_MAX }
    return nm
}
