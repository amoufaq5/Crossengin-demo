// CrossEngin learning: predictive coding runtime.
//
// Purpose
//   Predictive coding (ADR-0024): top-down predictions meet bottom-up
//   observations at the first nodes, and the residual -- precision-weighted by
//   the prediction's confidence -- is the error. Well-predicted input is
//   suppressed (no upward signal); error above threshold emits a high-priority
//   XSIG_ERROR upward; sustained large error is surprise. The error term is what
//   the tick driver currently passes as 0; it drives synapse plasticity
//   (ADR-0007), belief updates as contradicting evidence (ADR-0023), and
//   self-learning triggers (ADR-0026).
//
//   Activations/errors are integer milli on a normalized [0,1] scale.
//   Precision is a milli weight (e.g. a belief confidence). Fixed-point multiply
//   is inlined here so this module imports only the standalone signal taxonomy
//   (avoids NOVA blocker #10).
//
// ADRs implemented: ADR-0024 (predictive coding), ADR-0008 (XSIG_ERROR is high
//   priority). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/substrate/signal_dispatch.nova.

import "../substrate/signal_dispatch.nova"

let PC_SCALE         = 1000
let PC_THETA_ERR     = 150   // 0.15 suppression threshold (ADR-0024)
let PC_THETA_SURPRISE= 300   // 0.30 surprise threshold

fn pc_abs(x) {
    if x < 0 { return 0 - x }
    return x
}

// Raw residual = actual - predicted (signed milli).
fn pc_residual(actual, predicted) {
    return actual - predicted
}

// Precision-weighted error: residual scaled by precision (sign preserved).
fn pc_precision_error(actual, predicted, precision) {
    return (actual - predicted) * precision / PC_SCALE
}

// Emit upward only when the error clears the suppression threshold.
fn pc_should_emit(error) {
    if pc_abs(error) > PC_THETA_ERR { return 1 }
    return 0
}

// Surprise: error large enough to preempt routine processing.
fn pc_is_surprise(error) {
    if pc_abs(error) > PC_THETA_SURPRISE { return 1 }
    return 0
}

// Build the upward error signal (XSIG_ERROR, priority 7 by taxonomy). Strength
// is the magnitude; meta carries the signed error.
fn pc_emit_error(src, dst, error) {
    return sig_new(XSIG_ERROR, src, dst, pc_abs(error), 0, error)
}

// ---- prediction buffer (top-down predictions awaiting observation) --------
let PC_BUF_TAG = 0
let PC_BUF_LIST= 1   // list of [node_id, predicted_activation]

fn pc_buffer_new() {
    let b = list_new()
    push(b, 0)
    push(b, list_new())
    return b
}

fn _pc_buf_index(buf, node) {
    let l = buf[PC_BUF_LIST]
    let i = 0
    while i < len(l) {
        if l[i][0] == node { return i }
        i = i + 1
    }
    return -1
}

// Set (or replace) the predicted activation for a node.
fn pc_buffer_set(buf, node, predicted) {
    let l = buf[PC_BUF_LIST]
    let idx = _pc_buf_index(buf, node)
    if idx == -1 {
        let e = list_new(); push(e, node); push(e, predicted); push(l, e)
    } else {
        list_set(l[idx], 1, predicted)
    }
    return 1
}

// Predicted activation for a node (0 if none).
fn pc_buffer_get(buf, node) {
    let idx = _pc_buf_index(buf, node)
    if idx == -1 { return 0 }
    return buf[PC_BUF_LIST][idx][1]
}

// Unrefreshed predictions decay each tick (prevents self-confirming loops).
fn pc_buffer_decay(buf, retain_milli) {
    let l = buf[PC_BUF_LIST]
    let i = 0
    while i < len(l) {
        list_set(l[i], 1, l[i][1] * retain_milli / PC_SCALE)
        i = i + 1
    }
}

// Process an observation against the buffered prediction: returns the
// precision-weighted error (the caller decides emission / consumers).
fn pc_process(buf, node, actual, precision) {
    return pc_precision_error(actual, pc_buffer_get(buf, node), precision)
}
