// CrossEngin learning: atom death monitor (idle GC).
//
// Purpose
//   Bounds long-term storage by collecting cold, weakly-evidenced atoms
//   (ADR-0025). An atom is collectable only when ALL hold: activation strength
//   below 0.02, belief strength below 4 (well-evidenced atoms are never GC'd),
//   not in a protected class (constitutional / self-model / classical), and not
//   referenced by a cross-KG edge. Death is two-phase: a collectable atom is
//   tombstoned (soft-deleted) first; if it is still collectable on the next
//   sweep it is hard-removed, but reactivation during the tombstone window
//   rescues it.
//
//   Activation strength, last access, protection and tombstone/dead flags live
//   in the atom payload (the base atom has no such fields). Strength is milli.
//   Decay is geometric (tau_atom ~ 30 days; caller passes the retention factor).
//
//   P1.6 (this revision) wires the optional meta-observer hook: the
//   tombstone-then-hard-remove transition calls `mo_record_death(mo, atom_id)`
//   so a source-attributed atom that dies outright lands in the observer's
//   atrophy counter immediately (today the observer only sees atrophy as
//   "tentative -> sub-threshold" via the rolling poll; this hook is the
//   "durable atom dies outright" path). The observer reference is OPTIONAL
//   -- pass 0 to keep the original behavior (callers that have not yet been
//   threaded). `adm_sweep` is the legacy entry that just passes 0; new
//   callers use `adm_sweep_attributed(reg, kg, mo)`.
//
// ADRs implemented: ADR-0025 (atom death / GC + P1.6 observer hook), ADR-0017
//   (cross-ref protection).
//   Idle GC sweep cadence is NOVA enhancement #13.
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/kg/cross_kg_references.nova (xref accessors; and multi_kg, atom_store),
//   src/parts/meta/meta_observer.nova (via the caller's `mo_record_death`
//   pointer-shaped param; no import here).

import "../kg/cross_kg_references.nova"
import "../parts/meta/meta_observer.nova"
import "../kg/episodic.nova"
import "./entity_resolve.nova"   // ADR-0082: alias-table id-holder (er_aliases_has_canonical). entity_resolve does NOT import this file, so no cycle.

let DEATH_STRENGTH  = 20    // 0.02 activation floor
let DEATH_BELIEF    = 4000  // 4.0 evidence units (alpha+beta) below which GC-able
let DEATH_REINFORCE = 200   // +0.2 on read/co-activation

// Initialize an atom's lifecycle fields (active on creation).
fn adm_init(atom, now) {
    atom_payload_set(atom, "act", 1000)
    atom_payload_set(atom, "last_access", now)
    atom_payload_set(atom, "tomb", 0)
    atom_payload_set(atom, "dead", 0)
    return 1
}

fn adm_act(atom)          { return atom_payload_get(atom, "act") }
fn adm_is_protected(atom) { if atom_payload_get(atom, "prot") == 1 { return 1 } return 0 }
fn adm_is_tombstoned(atom){ if atom_payload_get(atom, "tomb") == 1 { return 1 } return 0 }
fn adm_is_dead(atom)      { if atom_payload_get(atom, "dead") == 1 { return 1 } return 0 }

fn adm_set_protected(atom) { atom_payload_set(atom, "prot", 1); return 1 }

// Reinforce on read/co-activation: +0.2 capped at 1.0; refresh last access.
fn adm_reinforce(atom, now) {
    let a = adm_act(atom) + DEATH_REINFORCE
    if a > 1000 { a = 1000 }
    atom_payload_set(atom, "act", a)
    atom_payload_set(atom, "last_access", now)
    return a
}

// Geometric activation decay (one step).
fn adm_decay(atom, retain_milli) {
    atom_payload_set(atom, "act", fp_mul(adm_act(atom), retain_milli))
    return adm_act(atom)
}

// Is `atom` (in any KG of `reg`) the destination of some cross-KG edge?
fn adm_is_referenced(reg, atom) {
    let target_kg = atom_kg(atom)
    let target_id = atom_id(atom)
    let n = kg_count(reg)
    let k = 0
    while k < n {
        let kg = kg_get(reg, k)
        let atoms = kg_atoms(kg)
        let i = 0
        while i < len(atoms) {
            let a = atoms[i]
            if a != 0 {   // reclamation: skip freed (0) slots
                let xr = atom_xrefs(a)
                let j = 0
                while j < len(xr) {
                    if xref_dst_atom(xr[j]) == target_id {
                        if str_eq(xref_dst_kg(xr[j]), target_kg) == 1 { return 1 }
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        k = k + 1
    }
    return 0
}

// An atom is "operator-referenced" if some live operator in its KG names it as
// a premise or conclusion. These references live in atom PAYLOADS (set by
// rop_new), not in xrefs, so adm_is_referenced (which only walks xrefs) misses
// them. Without this gate the sweep could reclaim a premise/conclusion fact out
// from under a live operator, leaving a dangling reasoning edge (P1.7 Phase B
// made reclamation real, so this became a live hazard). O(atoms) like
// adm_is_referenced; a future optimisation can use the P1.5 edge index.
fn _adm_is_operator_referenced(reg, atom) {
    let kg = kg_find(reg, atom_kg(atom))
    if kg == 0 { return 0 }
    let target = atom_id(atom)
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 {   // reclamation: skip freed (0) slots
            if atom_payload_has(a, "premise") == 1 {
                if atom_payload_get(a, "premise") == target { return 1 }
                if atom_payload_get(a, "conclusion") == target { return 1 }
            }
        }
        i = i + 1
    }
    return 0
}

// All death gates (ADR-0025, ADR-0076). Protected, well-evidenced, or referenced
// atoms (by xref OR by an operator premise/conclusion) are never collectable.
fn adm_is_collectable(reg, atom) {
    if adm_is_protected(atom) == 1 { return 0 }
    if adm_act(atom) >= DEATH_STRENGTH { return 0 }
    if bel_strength(atom_belief(atom)) >= DEATH_BELIEF { return 0 }
    if adm_is_referenced(reg, atom) == 1 { return 0 }
    if _adm_is_operator_referenced(reg, atom) == 1 { return 0 }
    return 1
}

// Is `atom` a member of any episodic cluster in `eas`? Episodic clusters store
// BARE atom ids (no KG qualifier), so this matches by id across the whole store
// -- a deliberately conservative (over-protective) check: it can spare an atom
// in a different KG that happens to share an id with a member. That is safe
// (errs toward keeping atoms) and acceptable for a protection gate.
//
// NOTE (ADR-0080): under today's semantics episodic membership is HARMLESS to
// reclaim -- clusters use member ids only for set-overlap (signature matching),
// never dereferencing them into atoms, and ids are never reused. This gate is
// FUTURE-PROOFING: it becomes load-bearing once id reuse is implemented (a
// reclaimed-then-reused id would otherwise cause a false episodic overlap).
fn _adm_is_episodic_member(eas, atom) {
    if eas == 0 { return 0 }
    let target = atom_id(atom)
    let l = eas[EAS_LIST]
    let i = 0
    while i < len(l) {
        let members = episodic_atom_members(l[i])
        let j = 0
        while j < len(members) {
            if members[j] == target { return 1 }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

// ADR-0082: is `atom` the resolution target of any entity-resolution alias?
// The alias table is `[alias_label, canonical_label]` and a mention resolves via
// kg_find_atom(canonical), so the atom is a target iff its LABEL equals some
// entry's canonical label. Reclaiming such an atom would dangle the alias (its
// mention would then re-mint a fresh atom -- the fragmentation ADR-0081 hit).
// Mirrors _adm_is_episodic_member: `aliases == 0` disables the check. Delegates
// the scan to er_aliases_has_canonical (pure; entity_resolve owns the layout).
fn _adm_is_alias_referenced(aliases, atom) {
    if aliases == 0 { return 0 }
    if er_aliases_has_canonical(aliases, atom_label(atom)) == 1 { return 1 }
    return 0
}

// ---- protection context (ADR-0084, GAP B) ---------------------------------
// ADR-0082 grew adm_is_collectable_ep / adm_sweep_ep a positional tail of
// id-holder params (eas, aliases). Bundle them into one small record so the
// signatures stay flat as more id-holders are added. A `0` ctx means "no
// protection beyond the base gate" (back-compat with the adm_sweep delegators).
let ADM_PROT_TAG     = 2700
let ADM_PROT_EAS     = 1
let ADM_PROT_ALIASES = 2

// Construct a protection context bundling the episodic store and alias table.
fn adm_prot_new(eas, aliases) {
    let p = list_new()
    push(p, ADM_PROT_TAG)
    push(p, eas)
    push(p, aliases)
    return p
}

// Accessors: `p == 0` (no context) yields 0 for every id-holder, so the gate
// applies no episodic/alias protection (identical to passing 0,0 pre-ADR-0084).
fn _adm_prot_eas(p)     { if p == 0 { return 0 } return p[ADM_PROT_EAS] }
fn _adm_prot_aliases(p) { if p == 0 { return 0 } return p[ADM_PROT_ALIASES] }

// Collectability gate WITH an optional protection context (`prot`, ADR-0084).
// `prot == 0` disables the episodic and alias checks, making this identical to
// adm_is_collectable (back-compat via the adm_sweep delegators). Both id-holders
// in the context are checked: an atom that is an episodic cluster member OR an
// alias resolution target is never collectable.
fn adm_is_collectable_ep(reg, atom, prot) {
    if adm_is_collectable(reg, atom) == 0 { return 0 }
    if _adm_is_episodic_member(_adm_prot_eas(prot), atom) == 1 { return 0 }
    if _adm_is_alias_referenced(_adm_prot_aliases(prot), atom) == 1 { return 0 }
    return 1
}

// One GC sweep over a KG with optional meta-observer attribution (P1.6).
// Tombstones newly-collectable atoms; hard-removes ones still collectable from
// a prior tombstone; rescues reactivated tombstoned ones. Returns
// [tombstoned, removed, rescued].
//
// `mo` is the meta-observer reference (or 0 to disable attribution). When an
// atom transitions tombstone -> dead AND `mo != 0`, calls
// `mo_record_death(mo, atom_id(a))` so the source-attribution counter is
// bumped at the moment of death (rather than waiting for the next mo_poll to
// notice the atom "vanished" -- which the GC may already have removed by
// then). Keeps the API surface tiny: one extra param, one extra call.
// The sweep core, with optional meta-observer attribution (`mo`) and an
// optional protection context (`prot`, ADR-0084: bundles episodic store +
// alias table). Pass `adm_prot_new(eas, 0)` to spare episodic cluster members
// (ADR-0080); `adm_prot_new(0, aliases)` to spare alias resolution targets
// (ADR-0082); `0` for no protection beyond the base gate.
fn adm_sweep_ep(reg, kg, mo, prot) {
    let atoms = kg_atoms(kg)
    let tombstoned = 0
    let removed = 0
    let rescued = 0
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 {   // reclamation: skip freed (0) slots
            if adm_is_dead(a) == 0 {
                if adm_is_tombstoned(a) == 1 {
                    if adm_is_collectable_ep(reg, a, prot) == 1 {
                        atom_payload_set(a, "dead", 1)
                        removed = removed + 1
                        // P1.6: observer attribution at the death-decision call site.
                        if mo != 0 { mo_record_death(mo, atom_id(a)) }
                        // P1.7 Phase B (ADR-0075): a dead atom is now actually
                        // reclaimed -- slot nulled, unindexed, edge index reset.
                        // The `dead` payload stays set on the (still-referenced)
                        // object, so observers reading `a` directly are unaffected.
                        kg_reclaim_atom(kg, atom_id(a))
                    } else {
                        atom_payload_set(a, "tomb", 0)
                        rescued = rescued + 1
                    }
                } else {
                    if adm_is_collectable_ep(reg, a, prot) == 1 {
                        atom_payload_set(a, "tomb", 1)
                        tombstoned = tombstoned + 1
                    }
                }
            }
        }
        i = i + 1
    }
    let out = list_new()
    push(out, tombstoned)
    push(out, removed)
    push(out, rescued)
    return out
}

// One GC sweep over a KG with optional meta-observer attribution (P1.6).
// Tombstones newly-collectable atoms; hard-removes ones still collectable from
// a prior tombstone; rescues reactivated tombstoned ones. Returns
// [tombstoned, removed, rescued]. (Episodic protection disabled; see
// `adm_sweep_ep` to enable it.)
//
// `mo` is the meta-observer reference (or 0 to disable attribution). When an
// atom transitions tombstone -> dead AND `mo != 0`, calls
// `mo_record_death(mo, atom_id(a))` so the source-attribution counter is
// bumped at the moment of death.
fn adm_sweep_attributed(reg, kg, mo) {
    return adm_sweep_ep(reg, kg, mo, 0)
}

// Legacy entry point: same sweep, no observer attribution, no episodic
// protection. Equivalent to `adm_sweep_attributed(reg, kg, 0)`. Preserved so
// existing callers (and tests) continue to work unchanged.
fn adm_sweep(reg, kg) {
    return adm_sweep_ep(reg, kg, 0, 0)
}
