// Periodic belief-decay sweep (ADR-0023 hook, the runtime side of the
// ADR-0088 increment 4 decay exemption). Walks a KG (or every KG in a
// registry) and applies one geometric decay step to each atom's belief --
// EXCEPT for verified FORMAL atoms, which `atom_decay_belief` short-circuits
// (a theorem does not become less true while unobserved). Reclaimed (null)
// slots, tombstoned atoms, and dead atoms are skipped: the GC owns their
// lifecycle, and decaying rotten state would just thrash heap.
//
// Cadence is the caller's decision (same as `adm_sweep`): the scheduler decides
// how often the sweep fires; the retention factor encodes the per-step decay
// rate (milli, 1000 = no decay, 0 = collapse straight to prior). Typical
// values come from the ADR-0023 fixtures: a half-life of ~180 days under a
// daily sweep maps to retain_milli ~ 996.
//
// ADRs implemented: ADR-0023 (periodic belief decay), ADR-0088 (the exemption
// hook this sweep honors). CrossEngin dependencies: src/kg/atom_store.nova
// (atom_decay_belief, atom_decay_exempt), src/kg/multi_kg_manager.nova
// (kg walk + kg_count/kg_get).

import "../kg/atom_store.nova"
import "../kg/multi_kg_manager.nova"
import "atom_death_monitor.nova"

// Stats record returned by every sweep:
//   scanned  : non-null atoms visited
//   decayed  : atoms whose belief actually moved (non-exempt, non-skipped)
//   exempted : atoms whose grade is FORMAL (skipped, decay-exempt)
//   skipped  : atoms skipped for lifecycle reasons (tombstoned/dead)
let DECAY_SCANNED  = 0
let DECAY_DECAYED  = 1
let DECAY_EXEMPTED = 2
let DECAY_SKIPPED  = 3

fn _decay_stats() {
    let s = list_new()
    push(s, 0); push(s, 0); push(s, 0); push(s, 0)
    return s
}

fn decay_scanned(s)  { return s[DECAY_SCANNED] }
fn decay_decayed(s)  { return s[DECAY_DECAYED] }
fn decay_exempted(s) { return s[DECAY_EXEMPTED] }
fn decay_skipped(s)  { return s[DECAY_SKIPPED] }

// One belief-decay sweep over a single KG. Returns a stats record.
fn belief_decay_sweep(kg, retain_milli) {
    let s = _decay_stats()
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if a != 0 {
            list_set(s, DECAY_SCANNED, s[DECAY_SCANNED] + 1)
            // GC-managed atoms (tombstoned/dead) are skipped -- the death
            // monitor owns their lifecycle, and decaying them would be a no-op
            // at best (their belief is already weak) and CPU waste at worst.
            if adm_is_tombstoned(a) == 1 {
                list_set(s, DECAY_SKIPPED, s[DECAY_SKIPPED] + 1)
            } else { if adm_is_dead(a) == 1 {
                list_set(s, DECAY_SKIPPED, s[DECAY_SKIPPED] + 1)
            } else {
                if atom_decay_exempt(a) == 1 {
                    list_set(s, DECAY_EXEMPTED, s[DECAY_EXEMPTED] + 1)
                } else {
                    atom_decay_belief(a, retain_milli)
                    list_set(s, DECAY_DECAYED, s[DECAY_DECAYED] + 1)
                }
            } }
        }
        i = i + 1
    }
    return s
}

// Multi-KG variant: fold the sweep across every KG in the registry. Useful
// from the substrate scheduler, which doesn't need to know KG identities.
fn belief_decay_sweep_all(reg, retain_milli) {
    let total = _decay_stats()
    let n = kg_count(reg)
    let k = 0
    while k < n {
        let s = belief_decay_sweep(kg_get(reg, k), retain_milli)
        list_set(total, DECAY_SCANNED,  total[DECAY_SCANNED]  + s[DECAY_SCANNED])
        list_set(total, DECAY_DECAYED,  total[DECAY_DECAYED]  + s[DECAY_DECAYED])
        list_set(total, DECAY_EXEMPTED, total[DECAY_EXEMPTED] + s[DECAY_EXEMPTED])
        list_set(total, DECAY_SKIPPED,  total[DECAY_SKIPPED]  + s[DECAY_SKIPPED])
        k = k + 1
    }
    return total
}
