// CrossEngin learning: Bayesian belief tracking.
//
// Purpose
//   Formalizes the alpha/beta evidence updates that atoms and skills already use
//   (ADR-0023), adding the parts ADR-0023 specifies beyond a bare [alpha,beta]:
//   time decay toward the Beta(1,1) prior, source-tier evidence weighting,
//   conflict tracking, and a CONTESTED flag so contradicted beliefs are never
//   silently collapsed to a confident mean. A "tracked belief" (tb) wraps an
//   atom_store belief in place, so updating it updates the underlying atom.
//
//   All quantities are integer milli (1.0 == 1000); the underlying belief is the
//   same [alpha,beta] used everywhere (atom_store bel_*). Time decay is the
//   standard geometric discretization (per-step retention factor) rather than a
//   true exp(); the caller derives the retention factor from dt/tau.
//
// ADRs implemented: ADR-0023 (Bayesian belief tracking), ADR-0029 (source-tier
//   evidence weights), ADR-0027 (user-teaching weight).
// NOVA dependencies: builtins. CrossEngin dependencies: src/kg/atom_store.nova.

import "../kg/atom_store.nova"

// ---- source tiers and evidence weights (ADR-0023/0029, milli) -------------
let SRC_A    = 1   // authoritative
let SRC_B    = 2
let SRC_C    = 3
let SRC_USER = 4   // direct user teaching (ADR-0027)

fn bayes_weight(tier) {
    if tier == SRC_A    { return 1000 }   // 1.0
    if tier == SRC_B    { return 600 }    // 0.6
    if tier == SRC_C    { return 300 }    // 0.3
    if tier == SRC_USER { return 1500 }   // 1.5
    return 1000
}

let BAYES_REC_DECAY   = 900    // 0.9 EWMA decay of recent support/contradiction
let CONTESTED_CONFLICT= 400    // 0.4 conflict
let CONTESTED_STRENGTH= 8000   // 8.0 evidence units (alpha+beta)

// ---- tracked belief: belief + last-update + recent support/contradiction --
let TB_TAG    = 0
let TB_BELIEF = 1
let TB_LASTUP = 2
let TB_RECSUP = 3
let TB_RECCON = 4
let TB_OBJ_TAG = 2301

// Wrap an existing belief (e.g. an atom's) so updates flow through to it.
fn tb_wrap(belief, now) {
    let tb = list_new()
    push(tb, TB_OBJ_TAG)
    push(tb, belief)
    push(tb, now)
    push(tb, 0)
    push(tb, 0)
    return tb
}

fn tb_new(alpha, beta, now) {
    return tb_wrap(bel_new(alpha, beta), now)
}

fn tb_belief(tb)     { return tb[TB_BELIEF] }
fn tb_confidence(tb) { return bel_mean(tb[TB_BELIEF]) }
fn tb_strength(tb)   { return bel_strength(tb[TB_BELIEF]) }
fn tb_last_update(tb){ return tb[TB_LASTUP] }

// Fraction of recent evidence that is contradicting (milli).
fn tb_conflict(tb) {
    let total = tb[TB_RECSUP] + tb[TB_RECCON]
    if total <= 0 { return 0 }
    return tb[TB_RECCON] * FP_SCALE / total
}

// Contested = enough contradiction AND enough total evidence (not noisy early
// data). Such beliefs must be reported with their contested marker.
fn tb_is_contested(tb) {
    if tb_conflict(tb) <= CONTESTED_CONFLICT { return 0 }
    if tb_strength(tb) <= CONTESTED_STRENGTH { return 0 }
    return 1
}

// Decay one step toward the Beta(1,1) prior: x = 1 + (x-1)*retain. Delegates to
// atom_store's bel_decay (the single source of the decay math; the FORMAL
// decay-exemption guard is atom_decay_belief, which a per-atom sweep uses).
fn tb_decay(tb, retain_milli) {
    return bel_decay(tb[TB_BELIEF], retain_milli)
}

// Add weighted evidence and refresh the conflict EWMA. supports != 0 adds to
// alpha (and recent-support), else to beta (and recent-contradiction).
fn tb_observe(tb, weight, supports, now) {
    let rec_sup = fp_mul(tb[TB_RECSUP], BAYES_REC_DECAY)
    let rec_con = fp_mul(tb[TB_RECCON], BAYES_REC_DECAY)
    let b = tb[TB_BELIEF]
    if supports != 0 {
        list_set(b, 0, b[0] + weight)
        rec_sup = rec_sup + weight
    } else {
        list_set(b, 1, b[1] + weight)
        rec_con = rec_con + weight
    }
    list_set(tb, TB_RECSUP, rec_sup)
    list_set(tb, TB_RECCON, rec_con)
    list_set(tb, TB_LASTUP, now)
    return bel_mean(b)
}

// The ADR-0023 full update: decay-then-update-then-conflict. Pass retain=1000
// (1.0) for no decay.
fn tb_update(tb, weight, supports, now, retain_milli) {
    tb_decay(tb, retain_milli)
    return tb_observe(tb, weight, supports, now)
}

// Convenience: observe one unit of tiered evidence at `now` without decay.
fn tb_observe_tier(tb, tier, supports, now) {
    return tb_observe(tb, bayes_weight(tier), supports, now)
}
