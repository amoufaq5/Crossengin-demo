// Corroboration tracker (ADR-0092): counts how many INDEPENDENT sources assert a
// claim, so the governed-promotion pass can grade evidence. The promotion gate
// (cand_assign_grade in src/learning/promotion.nova) takes a `corroboration`
// count: >= CAND_STRONG_CORROBORATION (2) distinct sources -> EMPIRICAL_STRONG,
// 1 -> EMPIRICAL_WEAK, 0 -> TESTIMONIAL. Nothing else in the substrate tracks
// distinct sources across ingests; this pure in-memory tracker is that missing
// building block. Wiring it into the live lp_ingest pass is a separate step.
//
// Structure: the registry is a list of entries, each entry a list
//   [claim_label, [source_label, ...]]
// Dedup is by char-by-char label compare (NOT str_eq, which is flaky in the
// NOVA bootstrap): a source re-asserting a claim it already asserts must not
// inflate the count.
//
// NOVA dependencies: builtins only (list_new, push, len, char_at).
// CrossEngin dependencies: none.

// Number of distinct sources required to consider a claim strongly corroborated.
// Mirrors CAND_STRONG_CORROBORATION in src/learning/promotion.nova.
let CORR_STRONG = 2

// Entry layout.
let CORR_E_CLAIM   = 0   // the claim label string
let CORR_E_SOURCES = 1   // list of distinct source label strings

// Char-by-char label equality. char_at/len return small integers (< 0x100000),
// so != on them is safe; we deliberately avoid str_eq (flaky in bootstrap).
fn _corr_label_eq(a, b) {
    let n = len(a)
    if n != len(b) { return 0 }
    let i = 0
    while i < n {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// An empty registry.
fn corr_new() {
    return list_new()
}

// Find the entry for claim_label, or 0 if none exists.
fn _corr_find(reg, claim_label) {
    let i = 0
    while i < len(reg) {
        let e = reg[i]
        if _corr_label_eq(e[CORR_E_CLAIM], claim_label) == 1 {
            return e
        }
        i = i + 1
    }
    return 0
}

// Is source_label already among this entry's sources?
fn _corr_has_source(sources, source_label) {
    let i = 0
    while i < len(sources) {
        if _corr_label_eq(sources[i], source_label) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Record that source_label asserts claim_label. Returns 1 if this was a NEW
// (claim, source) pair, 0 if a duplicate (same source re-asserting the same
// claim does NOT inflate the count).
fn corr_record(reg, claim_label, source_label) {
    let e = _corr_find(reg, claim_label)
    if e == 0 {
        // First time we see this claim: create its entry with one source.
        let sources = list_new()
        push(sources, source_label)
        let entry = list_new()
        push(entry, claim_label)
        push(entry, sources)
        push(reg, entry)
        return 1
    }
    let sources = e[CORR_E_SOURCES]
    if _corr_has_source(sources, source_label) == 1 {
        return 0
    }
    push(sources, source_label)
    return 1
}

// Number of DISTINCT sources that have asserted claim_label (0 if unknown).
fn corr_count(reg, claim_label) {
    let e = _corr_find(reg, claim_label)
    if e == 0 { return 0 }
    return len(e[CORR_E_SOURCES])
}

// 1 iff claim_label has >= CORR_STRONG distinct sources.
fn corr_is_strong(reg, claim_label) {
    if corr_count(reg, claim_label) >= CORR_STRONG { return 1 }
    return 0
}

// The list of distinct source labels for claim_label (an empty list if unknown).
fn corr_sources(reg, claim_label) {
    let e = _corr_find(reg, claim_label)
    if e == 0 { return list_new() }
    return e[CORR_E_SOURCES]
}
