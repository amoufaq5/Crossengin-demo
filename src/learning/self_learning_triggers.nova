// CrossEngin learning: self-learning triggers.
//
// Purpose
//   Decides when, and about what, to learn on its own initiative (ADR-0026).
//   Gaps surface from several sources -- a user request, sustained prediction
//   error (ADR-0024), an unknown query, an imagination gap (thin belief), or the
//   curiosity drive -- each with a source weight. A learning signal scores
//   priority = source_weight * competence_gap * goal_alignment. An arbitration
//   queue (max depth 8) deduplicates by target concept, evicts the
//   lowest-priority signal when full, runs at most one external episode at a
//   time, and lets user requests always pre-empt autonomous ones.
//
//   All quantities are integer milli. Fixed-point multiply is inlined so this
//   module is self-contained (NOVA blocker #10); the surprise/curiosity/gap
//   inputs are supplied by the learning fabric and goal engine as parameters.
//
// ADRs implemented: ADR-0026 (self-learning triggers). Inputs from ADR-0024
//   (prediction error), ADR-0023 (belief strength), ADR-0020 (competence gap).
// NOVA dependencies: builtins + the shared list_safe workaround for NOVA's
// list_remove tagging quirk (see src/util/list_safe.nova).
// CrossEngin dependencies: src/util/list_safe.nova.

import "../util/list_safe.nova"

let SLT_SCALE = 1000

// ---- trigger sources and weights (ADR-0026, milli) ------------------------
let SLT_USER_REQUEST     = 1
let SLT_PREDICTION_ERROR = 2
let SLT_UNKNOWN_QUERY    = 3
let SLT_IMAGINATION_GAP  = 4
let SLT_CURIOSITY        = 5

fn slt_source_weight(src) {
    if src == SLT_USER_REQUEST     { return 1000 }   // 1.0
    if src == SLT_PREDICTION_ERROR { return 700 }    // 0.7
    if src == SLT_UNKNOWN_QUERY    { return 600 }    // 0.6
    if src == SLT_IMAGINATION_GAP  { return 400 }    // 0.4
    if src == SLT_CURIOSITY        { return 300 }    // 0.3
    return 0
}

// ---- activation thresholds (ADR-0026) -------------------------------------
let SLT_CURIOSITY_THRESH = 600    // curiosity drive > 0.6
let SLT_IMAG_GAP_STRENGTH= 8000   // belief alpha+beta < 8
let SLT_ERROR_THRESH     = 400    // running prediction error > 0.4
let SLT_ERROR_SUSTAIN    = 5      // sustained for >= 5 ticks
let SLT_QUEUE_MAX        = 8

fn slt_curiosity_fires(curiosity_drive)      { if curiosity_drive > SLT_CURIOSITY_THRESH { return 1 } return 0 }
fn slt_imagination_gap_fires(belief_strength){ if belief_strength < SLT_IMAG_GAP_STRENGTH { return 1 } return 0 }
fn slt_error_fires(running_error, sustained_ticks) {
    if running_error <= SLT_ERROR_THRESH { return 0 }
    if sustained_ticks < SLT_ERROR_SUSTAIN { return 0 }
    return 1
}

// ---- learning signal ------------------------------------------------------
let SL_OBJTAG = 0
let SL_SRCTAG = 1
let SL_TARGET = 2
let SL_GAP    = 3
let SL_GOAL   = 4
let SL_PRI    = 5
let SL_OBJ_TAG = 2601

// Create a learning signal; priority = source_weight * gap_score * goal_alignment.
fn trigger_new(src, target_concept, gap_score, goal_alignment) {
    let w = slt_source_weight(src)
    let pri = (w * gap_score / SLT_SCALE) * goal_alignment / SLT_SCALE
    let s = list_new()
    push(s, SL_OBJ_TAG)
    push(s, src)
    push(s, target_concept)
    push(s, gap_score)
    push(s, goal_alignment)
    push(s, pri)
    return s
}

fn slt_src_tag(s)  { return s[SL_SRCTAG] }
fn slt_target(s)   { return s[SL_TARGET] }
fn slt_gap(s)      { return s[SL_GAP] }
fn slt_goal(s)     { return s[SL_GOAL] }
fn slt_priority(s) { return s[SL_PRI] }

// ---- arbitration queue ----------------------------------------------------
let ARB_TAG    = 0
let ARB_QUEUE  = 1
let ARB_ACTIVE = 2
let ARB_OBJ_TAG = 2602

fn slt_arbiter_new() {
    let a = list_new()
    push(a, ARB_OBJ_TAG)
    push(a, list_new())
    push(a, 0)
    return a
}

fn slt_queue_size(arb) { return len(arb[ARB_QUEUE]) }
fn slt_active(arb)     { return arb[ARB_ACTIVE] }
fn slt_clear_active(arb) { list_set(arb, ARB_ACTIVE, 0); return 1 }

fn _arb_min_pri_index(queue) {
    let idx = 0
    let i = 1
    while i < len(queue) {
        if slt_priority(queue[i]) < slt_priority(queue[idx]) { idx = i }
        i = i + 1
    }
    return idx
}

// Submit a signal. Deduplicates by target concept (keeping the higher priority);
// when full, evicts the lowest-priority signal if the newcomer outranks it.
// Returns 1 if queued, 0 if dropped.
fn slt_submit(arb, sig) {
    let q = arb[ARB_QUEUE]
    let i = 0
    while i < len(q) {
        if slt_target(q[i]) == slt_target(sig) {
            if slt_priority(sig) > slt_priority(q[i]) { list_set(q, i, sig) }
            return 1
        }
        i = i + 1
    }
    if len(q) >= SLT_QUEUE_MAX {
        let mi = _arb_min_pri_index(q)
        if slt_priority(sig) > slt_priority(q[mi]) {
            list_set(q, mi, sig)
            return 1
        }
        return 0
    }
    push(q, sig)
    return 1
}

// Select (without mutating) the signal that should be active: any user request
// pre-empts; otherwise the highest priority. Returns 0 if the queue is empty.
fn slt_select(arb) {
    let q = arb[ARB_QUEUE]
    if len(q) == 0 { return 0 }
    let best = 0
    let i = 0
    while i < len(q) {
        if slt_src_tag(q[i]) == SLT_USER_REQUEST {
            if best == 0 { best = q[i] }
            else { if slt_src_tag(best) != SLT_USER_REQUEST { best = q[i] }
                   else { if slt_priority(q[i]) > slt_priority(best) { best = q[i] } } }
        } else {
            if best == 0 { best = q[i] }
            else { if slt_src_tag(best) != SLT_USER_REQUEST {
                       if slt_priority(q[i]) > slt_priority(best) { best = q[i] } } }
        }
        i = i + 1
    }
    return best
}

fn _arb_remove(arb, sig) {
    let q = arb[ARB_QUEUE]
    let i = 0
    while i < len(q) {
        if q[i] == sig { list_remove_at(q, i); return 1 }
        i = i + 1
    }
    return 0
}

// Activate the next episode. Honors at-most-one-external: if an external episode
// is already active it stays active unless a user request pre-empts it. Returns
// the active signal (or 0).
fn slt_arbiter_step(arb) {
    let active = arb[ARB_ACTIVE]
    let pick = slt_select(arb)
    if active != 0 {
        if pick != 0 {
            if slt_src_tag(pick) == SLT_USER_REQUEST {
                if slt_src_tag(active) != SLT_USER_REQUEST {
                    _arb_remove(arb, pick)
                    list_set(arb, ARB_ACTIVE, pick)
                    return pick
                }
            }
        }
        return active
    }
    if pick == 0 { return 0 }
    _arb_remove(arb, pick)
    list_set(arb, ARB_ACTIVE, pick)
    return pick
}
