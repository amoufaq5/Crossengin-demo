// CrossEngin learning: Forward-Forward representation learner (P2, ADR-0052).
//
// Purpose
//   Hinton's Forward-Forward (2022) replaces backpropagation with a per-layer
//   GOODNESS objective: each layer is trained to make its goodness HIGH on
//   positive (real) data and LOW on negative (corrupted / imagined) data. There
//   is no backward pass and no gradient flowing between layers -- every layer
//   learns locally from its own input and its own goodness. That makes the rule
//   gradient-free and online, matching the substrate's design invariant (no
//   global backprop, no offline training run).
//
//   Goodness here is the sum of squared (relu) unit activations. The local,
//   gradient-free weight update is Hebbian on positive data (strengthen the
//   features that fired -> raise goodness) and anti-Hebbian on negative data
//   (weaken them -> lower goodness). Negatives are supplied by the caller -- in
//   the agent, corrupted/imagined moments from imagination/dream_recombination.
//
//   A stack is just layers chained through `ff_forward` + `ff_normalize`; each
//   layer is trained independently on the (detached) output of the one below,
//   so no error signal ever crosses a layer boundary.
//
//   All values are integer milli (scale 1000). Self-contained integer math so
//   this module imports nothing (mirrors predictive_coding_runtime's policy of
//   avoiding NOVA cross-module link blockers).
//
// ADRs implemented: ADR-0052 (P2: predictive coding + three-factor + FF).
// NOVA dependencies: builtins (lists, int_mul/int_add/int_mod/int_div).
// CrossEngin dependencies: none.

let FF_SCALE = 1000

// ---- layer layout ---------------------------------------------------------
let FFL_TAG    = 0
let FFL_UNITS  = 1   // number of units
let FFL_INPUTS = 2   // input dimension
let FFL_W      = 3   // list of unit weight-vectors (each length INPUTS, milli)
let FFL_THRESH = 4   // goodness threshold separating positive from negative
let FFL_OBJ_TAG = 880

fn ff_abs(x) { if x < 0 { return 0 - x } return x }
fn ff_relu(x) { if x < 0 { return 0 } return x }
fn _ff_clamp(x, lo, hi) { if x < lo { return lo } if x > hi { return hi } return x }

// Deterministic small pseudo-random weight in milli ~[-300, 300] from a seed.
// Uses the overflow-safe int_* builtins (NOVA large-multiply codegen bug #11).
fn _ff_rand_w(seed) {
    let s = int_mod(int_add(int_mul(seed, 1103515245), 12345), 2147483648)
    return int_mod(int_div(s, 65536), 601) - 300
}

// Create a layer of `units` units over `inputs` dims, weights seeded
// deterministically from `seed`, with goodness threshold `thresh`.
fn ff_layer_new(units, inputs, thresh, seed) {
    let l = list_new()
    push(l, FFL_OBJ_TAG)
    push(l, units)
    push(l, inputs)
    let w = list_new()
    let sd = seed
    let u = 0
    while u < units {
        let wu = list_new()
        let i = 0
        while i < inputs {
            sd = sd + 1
            push(wu, _ff_rand_w(sd))
            i = i + 1
        }
        push(w, wu)
        u = u + 1
    }
    push(l, w)
    push(l, thresh)
    return l
}

fn ff_units(layer)  { return layer[FFL_UNITS] }
fn ff_inputs(layer) { return layer[FFL_INPUTS] }
fn ff_threshold(layer) { return layer[FFL_THRESH] }
fn ff_set_threshold(layer, t) { list_set(layer, FFL_THRESH, t); return t }

// Forward pass: the layer's output is relu(W x) per unit (milli). This is the
// representation handed to the next layer; it is the only thing that crosses a
// layer boundary -- never an error/gradient.
fn ff_forward(layer, x) {
    let units = layer[FFL_UNITS]
    let inputs = layer[FFL_INPUTS]
    let w = layer[FFL_W]
    let out = list_new()
    let u = 0
    while u < units {
        let wu = w[u]
        let dot = 0
        let i = 0
        while i < inputs {
            let xi = 0
            if i < len(x) { xi = x[i] }
            dot = dot + (wu[i] * xi) / FF_SCALE
            i = i + 1
        }
        push(out, ff_relu(dot))
        u = u + 1
    }
    return out
}

// Goodness = sum of squared unit outputs (scaled to milli). Higher == "more
// like positive data". This is the per-layer quantity FF pushes up on positives
// and down on negatives.
fn ff_goodness(layer, x) {
    let out = ff_forward(layer, x)
    let g = 0
    let u = 0
    while u < len(out) {
        let a = out[u]
        g = g + (a * a) / FF_SCALE
        u = u + 1
    }
    return g
}

// Classify by the layer's own threshold (1 == looks positive).
fn ff_is_positive(layer, x) {
    if ff_goodness(layer, x) > layer[FFL_THRESH] { return 1 }
    return 0
}

// Local, gradient-free weight update. On positive data, Hebbian: strengthen the
// weights of units that fired, raising goodness. On negative data, anti-
// Hebbian: weaken them, lowering goodness. The update reads only this layer's
// own input and activations -- no gradient crosses layers.
fn ff_learn(layer, x, is_positive, lr) {
    let units = layer[FFL_UNITS]
    let inputs = layer[FFL_INPUTS]
    let w = layer[FFL_W]
    let out = ff_forward(layer, x)
    let u = 0
    while u < units {
        let post = out[u]
        if post > 0 {
            let wu = w[u]
            let i = 0
            while i < inputs {
                let xi = 0
                if i < len(x) { xi = x[i] }
                // delta = lr * post * xi  (all milli), sign set by polarity.
                let delta = ((lr * post) / FF_SCALE) * xi / FF_SCALE
                if is_positive == 0 { delta = 0 - delta }
                list_set(wu, i, _ff_clamp(wu[i] + delta, 0 - FF_SCALE, FF_SCALE))
                i = i + 1
            }
        }
        u = u + 1
    }
    return 1
}

// One training step over a positive/negative pair (the canonical FF step).
fn ff_train_pair(layer, pos_x, neg_x, lr) {
    ff_learn(layer, pos_x, 1, lr)
    ff_learn(layer, neg_x, 0, lr)
    return 1
}

// L1-normalize a layer output to total magnitude `target` (milli) so the next
// layer sees comparable activity regardless of the layer below's gain. FF
// normalizes between layers precisely so a layer cannot cheat by passing its
// own goodness (raw magnitude) upward.
fn ff_normalize(out, target) {
    let total = 0
    let i = 0
    while i < len(out) {
        total = total + ff_abs(out[i])
        i = i + 1
    }
    let r = list_new()
    if total == 0 {
        let j = 0
        while j < len(out) { push(r, 0); j = j + 1 }
        return r
    }
    let k = 0
    while k < len(out) {
        push(r, out[k] * target / total)
        k = k + 1
    }
    return r
}

// Convenience: set the layer's threshold to the midpoint between the LOWEST
// positive goodness and the HIGHEST negative goodness. When the two groups are
// separable by goodness (the FF success condition), this threshold provably
// classifies every sample correctly -- more robust on a small calibration set
// than a midpoint-of-means, which a single high-goodness positive can skew.
// `positives` / `negatives` are lists of input vectors.
fn ff_calibrate_threshold(layer, positives, negatives) {
    let min_pos = -1
    let i = 0
    while i < len(positives) {
        let g = ff_goodness(layer, positives[i])
        if min_pos < 0 { min_pos = g } else { if g < min_pos { min_pos = g } }
        i = i + 1
    }
    let max_neg = 0
    let j = 0
    while j < len(negatives) {
        let g = ff_goodness(layer, negatives[j])
        if g > max_neg { max_neg = g }
        j = j + 1
    }
    if min_pos < 0 { min_pos = max_neg }
    let t = (min_pos + max_neg) / 2
    list_set(layer, FFL_THRESH, t)
    return t
}
