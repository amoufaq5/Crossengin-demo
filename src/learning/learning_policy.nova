// Machine-learning policy gate (ADR-0096). ADR-0014 ("no LLM cognition") is
// chronically over-read as "no ML at all" -- which is false and self-defeating:
// the substrate's Bayesian beliefs, synaptic plasticity, Forward-Forward, and
// HDC/VSA ARE learning. ADR-0096 fixes the boundary precisely; this module makes
// it an ENFORCEABLE gate rather than a prose principle, so "is this technique
// allowed?" has one authoritative, testable answer.
//
// The litmus (ADR-0096): a technique is PERMITTED only if it is
//   (1) ONLINE      -- learns continuously from experience, not by an offline
//                      batch run that bakes knowledge into a frozen artifact;
//   (2) LOCAL       -- local update rules, NOT end-to-end global backprop over a
//                      monolithic network as the cognition mechanism;
//   (3) AUDITABLE   -- transparent / inspectable, not an opaque black box;
//   (4) FROZEN-FREE -- not dependent on a frozen external model substituted for a
//                      cognitive capability.
// Anything opaque, unlearnable-online, or frozen-artifact-dependent is FORBIDDEN,
// no matter how powerful. Unknown techniques fail CLOSED to FORBIDDEN (a new
// technique must be vetted, not assumed safe).
//
// (Prefix mlp_ -- "machine-learning policy" -- to stay clear of learn_pipeline's
// lp_* namespace.) CrossEngin dependencies: none (builtins only).

let MLP_PERMITTED = 1
let MLP_FORBIDDEN = 0

// ---- the litmus ------------------------------------------------------------
// Decide from the four criteria (each 0/1). PERMITTED iff online AND local AND
// auditable AND NOT frozen-artifact-dependent.
fn mlp_litmus(online, local, auditable, frozen_artifact) {
    if online == 0 { return MLP_FORBIDDEN }
    if local == 0 { return MLP_FORBIDDEN }
    if auditable == 0 { return MLP_FORBIDDEN }
    if frozen_artifact == 1 { return MLP_FORBIDDEN }
    return MLP_PERMITTED
}

// ---- the known technique family --------------------------------------------
// Permitted (the current substrate family, ADR-0096):
let LT_BAYESIAN          = 1   // ADR-0023 belief updating
let LT_HEBBIAN           = 2   // synaptic plasticity (ADR-0003)
let LT_THREE_FACTOR      = 3   // neuromodulated plasticity (ADR-0052)
let LT_FORWARD_FORWARD   = 4   // backprop-free representation learning (P2)
let LT_HDC_VSA           = 5   // hyperdimensional embeddings (ADR-0051)
let LT_PREDICTIVE_CODING = 6   // local prediction-error updates
// Forbidden (each fails a specific litmus criterion):
let LT_LLM_COGNITION     = 7   // ADR-0014: opaque + frozen + not online/local
let LT_FROZEN_DEEP_MODEL = 8   // an offline-trained frozen model as cognition
let LT_GLOBAL_BACKPROP   = 9   // end-to-end global gradient as the mechanism
let LT_OFFLINE_BATCH     = 10  // offline batch optimization baking a frozen artifact

fn mlp_technique_name(k) {
    if k == LT_BAYESIAN          { return "bayesian-belief-update" }
    if k == LT_HEBBIAN           { return "hebbian-plasticity" }
    if k == LT_THREE_FACTOR      { return "three-factor-plasticity" }
    if k == LT_FORWARD_FORWARD   { return "forward-forward" }
    if k == LT_HDC_VSA           { return "hdc-vsa-embedding" }
    if k == LT_PREDICTIVE_CODING { return "predictive-coding" }
    if k == LT_LLM_COGNITION     { return "llm-cognition" }
    if k == LT_FROZEN_DEEP_MODEL { return "frozen-deep-model" }
    if k == LT_GLOBAL_BACKPROP   { return "global-backprop-cognition" }
    if k == LT_OFFLINE_BATCH     { return "offline-batch-training" }
    return "unknown-technique"
}

// The litmus PROFILE [online, local, auditable, frozen_artifact] of a known
// technique. An unknown technique returns 0 (the caller fails it closed).
fn _mlp_profile(k) {
    let p = list_new()
    // the permitted family: online + local + auditable + frozen-free.
    if k == LT_BAYESIAN          { push(p, 1) push(p, 1) push(p, 1) push(p, 0) return p }
    if k == LT_HEBBIAN           { push(p, 1) push(p, 1) push(p, 1) push(p, 0) return p }
    if k == LT_THREE_FACTOR      { push(p, 1) push(p, 1) push(p, 1) push(p, 0) return p }
    if k == LT_FORWARD_FORWARD   { push(p, 1) push(p, 1) push(p, 1) push(p, 0) return p }
    if k == LT_HDC_VSA           { push(p, 1) push(p, 1) push(p, 1) push(p, 0) return p }
    if k == LT_PREDICTIVE_CODING { push(p, 1) push(p, 1) push(p, 1) push(p, 0) return p }
    // forbidden, each failing a DIFFERENT criterion (so the litmus does the work):
    if k == LT_LLM_COGNITION     { push(p, 0) push(p, 0) push(p, 0) push(p, 1) return p } // opaque+frozen+offline+global
    if k == LT_FROZEN_DEEP_MODEL { push(p, 0) push(p, 1) push(p, 0) push(p, 1) return p } // frozen + opaque + offline
    if k == LT_GLOBAL_BACKPROP   { push(p, 1) push(p, 0) push(p, 1) push(p, 0) return p } // NOT local
    if k == LT_OFFLINE_BATCH     { push(p, 0) push(p, 1) push(p, 1) push(p, 0) return p } // NOT online
    return 0
}

// Decide a known technique by code. Unknown -> FORBIDDEN (fail closed).
fn mlp_technique_decide(k) {
    let p = _mlp_profile(k)
    if p == 0 { return MLP_FORBIDDEN }
    return mlp_litmus(p[0], p[1], p[2], p[3])
}

fn mlp_is_permitted(k) {
    if mlp_technique_decide(k) == MLP_PERMITTED { return 1 }
    return 0
}

fn mlp_decision_name(d) {
    if d == MLP_PERMITTED { return "permitted" }
    return "forbidden"
}

// Plain-language ruling (no LLM, ADR-0013): names the technique, the verdict,
// and -- for a forbidden one -- which litmus criterion it fails.
fn mlp_ruling(k) {
    let d = mlp_technique_decide(k)
    if d == MLP_PERMITTED {
        return mlp_technique_name(k) + ": PERMITTED -- online, local, auditable, "
            + "frozen-free (the ADR-0096 family).";
    }
    let p = _mlp_profile(k)
    let why = "not in the vetted family"
    if p != 0 {
        // Cite the most distinctive violation first: a frozen artifact is the
        // headline breach (ADR-0014), then online / local / auditable.
        if p[3] == 1 { why = "depends on a FROZEN external model" }
        else { if p[0] == 0 { why = "not ONLINE (offline batch / frozen artifact)" }
        else { if p[1] == 0 { why = "not LOCAL (global backprop as cognition)" }
        else { if p[2] == 0 { why = "not AUDITABLE (opaque black box)" } } } }
    }
    return mlp_technique_name(k) + ": FORBIDDEN -- " + why + " (ADR-0096/0014).";
}
