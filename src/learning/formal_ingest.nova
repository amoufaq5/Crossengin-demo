// Ingest a formally-tractable claim FROM A SOURCE THAT SUPPLIED A DERIVATION
// (ADR-0088 path (a)). The trusted kernel re-checks the derivation; on
// VERIFIED, the atom is FORMAL-pinned, licensed, and PROMOTED in one atomic
// step. So a source's say-so is never enough to land a FORMAL grade -- the
// kernel must actually accept the proof.
//
// This sits beside govern_fetched_atom (promotion.nova) as a parallel
// ingestion path for the formal track. The empirical/web track uses
// govern_fetched_atom; this one uses lp_ingest_formal. The two never compete
// on the same atom (an atom is either supplied with a derivation or it isn't).
//
// Gate order (load-bearing):
//   1. License gate (Rule 3 / ADR-0087) -- an unclean source CANNOT drive a
//      FORMAL pin even if the derivation is valid. A lawful proof from an
//      encumbered source is still encumbered -- the engine cannot redistribute
//      conclusions it has no right to repackage. So an unclean source ->
//      QUARANTINED before the kernel even runs.
//   2. Trusted kernel (verify_pin_atom, ADR-0088) -- on VERIFIED the atom is
//      pinned in-place: grade = FORMAL, belief = BEL_FORMAL_PIN, proof_ref =
//      the registered code. The only legitimate path to a FORMAL grade in
//      the entire engine, by construction (the kernel is the only writer of
//      GRADE_FORMAL).
//   3. On kernel FAILED, the atom is left at the uniform prior. The caller
//      may then route it through ordinary empirical promotion (cand_promote)
//      as a TESTIMONIAL claim -- the source asserted a theorem, the kernel
//      could not check it, so it falls back to source weighting.
//
// ADRs implemented: ADR-0088 (kernel-gated FORMAL grade at ingest), ADR-0087
// (license gate), ADR-0092 (state machine: PROMOTED / QUARANTINED / CANDIDATE).
// CrossEngin dependencies: src/kg/licenses.nova, src/kg/proofs.nova,
// src/mind/verify.nova, src/learning/promotion.nova.

import "../kg/licenses.nova"
import "../kg/proofs.nova"
import "../mind/verify.nova"
import "../mind/recheck.nova"
import "promotion.nova"

// Optional re-check registry (ADR-0088 periodic sweep). When wired via
// fi_set_recheck_registry, every atom this path pins FORMAL is also registered
// for periodic re-verification, so a later proof-blob tamper or silent
// dependency change is caught by rcks_on_tick. Wired-or-not, the same idiom as
// the audit handles; unwired leaves the ingest path unchanged.
let _fi_recheck_handle = list_new()

fn fi_set_recheck_registry(rck) {
    if len(_fi_recheck_handle) == 0 { push(_fi_recheck_handle, rck) }
    else { list_set(_fi_recheck_handle, 0, rck) }
}

fn _fi_recheck_registry() {
    if len(_fi_recheck_handle) == 0 { return 0 }
    return _fi_recheck_handle[0]
}

// Ingest a formal claim. `atom` is a freshly-minted candidate the caller has
// built (we don't import multi_kg_manager to stay lean). `pkt` is a
// verify_packet(axioms, hyps, proof_tree, claim_term, claim_label, blob) --
// see src/mind/verify.nova for its shape and contract. Returns the resulting
// CAND_* state so the caller can branch (PROMOTED on a verified proof,
// QUARANTINED on an unclean source, CANDIDATE on a failed kernel check).
fn lp_ingest_formal(atom, proofs_reg, src_label, pkt) {
    // (1) License gate FIRST. atom_resolve_license stamps the atom's license
    // slot AND returns the resolved code; lic_code_clean is registry-free.
    let lcode = atom_resolve_license(atom, src_label)
    if lic_code_clean(lcode) == 0 {
        atom_set_evidence_grade(atom, GRADE_EMPIRICAL_WEAK)
        atom_payload_set(atom, "cand_state", CAND_QUARANTINED)
        return CAND_QUARANTINED
    }
    // (2) Run the trusted kernel. verify_pin_atom is the only writer of
    // GRADE_FORMAL; on VERIFIED it pins the belief and stamps proof_ref. On
    // FAILED it returns 0 and leaves the atom untouched.
    let code = verify_pin_atom(proofs_reg, atom, pkt)
    if code > 0 {
        atom_payload_set(atom, "cand_state", CAND_PROMOTED)
        // Register the freshly-pinned proof for periodic re-checking, so a
        // later silent corruption is caught by the ADR-0088 sweep.
        let rck = _fi_recheck_registry()
        if rck != 0 { rck_register(rck, atom, pkt) }
        return CAND_PROMOTED
    }
    // (3) Kernel rejected the derivation. The atom is left at the uniform
    // prior; the caller may route it through cand_promote as an empirical
    // (most likely TESTIMONIAL) claim.
    return CAND_CANDIDATE
}
