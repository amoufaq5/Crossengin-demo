// CrossEngin learning: source whitelist.
//
// Purpose
//   Outbound fetching is restricted to a vetted set of domains (ADR-0028): only
//   hosts on the whitelist may be retrieved. This module extracts the host from
//   a URL and checks it against the list. v1 ships ~15-30 vetted domains; a
//   small representative default set is provided here.
//
// ADRs implemented: ADR-0028 (whitelisted fetch). NOVA dependencies: builtins
//   (string ops). CrossEngin dependencies: none.

import "../util/str_safe.nova"
let SW_TAG  = 0
let SW_LIST = 1

fn sw_new() {
    let wl = list_new()
    push(wl, SW_TAG)
    push(wl, list_new())
    return wl
}

// Extract the lowercase host from a URL ("https://en.wikipedia.org/wiki/X" ->
// "en.wikipedia.org").
fn sw_host(url) {
    let u = str_lower(str_trim(url))
    if starts_with(u, "https://") == 1 { u = substr(u, 8, len(u) - 8) }
    else { if starts_with(u, "http://") == 1 { u = substr(u, 7, len(u) - 7) } }
    let slash = find_char(u, 47)
    if slash >= 0 { u = substr(u, 0, slash) }
    return u
}

fn sw_add(wl, domain) {
    let d = str_lower(str_trim(domain))
    if contains(wl[SW_LIST], d) == 0 { push(wl[SW_LIST], d) }
    return len(wl[SW_LIST])
}

fn sw_count(wl) { return len(wl[SW_LIST]) }

fn sw_has_domain(wl, domain) {
    if contains(wl[SW_LIST], str_lower(str_trim(domain))) == 1 { return 1 }
    return 0
}

// Is the URL's host on the whitelist? (the ADR-0028 host allow/deny gate.)
fn sw_check(wl, url) {
    if contains(wl[SW_LIST], sw_host(url)) == 1 { return 1 }
    return 0
}

// A small default whitelist of vetted reference domains.
fn sw_default() {
    let wl = sw_new()
    sw_add(wl, "en.wikipedia.org")
    sw_add(wl, "docs.python.org")
    sw_add(wl, "developer.mozilla.org")
    sw_add(wl, "www.who.int")
    sw_add(wl, "pubmed.ncbi.nlm.nih.gov")
    return wl
}
