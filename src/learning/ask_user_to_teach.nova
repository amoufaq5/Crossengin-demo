// CrossEngin learning: ask the user to teach.
//
// Purpose
//   Turns a knowledge gap into a question for the user and ingests the reply
//   (ADR-0027). An explicit teach prompt is raised only when the gap is
//   non-fetchable, it blocks the current response (or competence is very low in
//   an actively-used domain), and the ask budget is not exhausted (at most one
//   unsolicited teaching question per ~10 minutes; inline clarifications are
//   unmetered). The user's answer is ingested as high-trust, user-taught
//   evidence: a fact atom seeded at Beta(4,1) with provenance user_taught, plus
//   a language word linked to it. User-taught atoms outrank fetched claims
//   (ADR-0029).
//
//   Times are logical units; belief is integer milli (alpha=4 -> 4000).
//
// ADRs implemented: ADR-0027 (ask-user-to-teach). Feeds ADR-0023 (Beta(4,1)
//   prior), ADR-0029 (Tier-A precedence), ADR-0015 (word birth).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/language/word_atoms.nova (words + atoms + KGs).

import "../language/word_atoms.nova"

let TEACH_INLINE   = 1
let TEACH_EXPLICIT = 2

let AU_WINDOW          = 600    // ~10 minutes of active conversation (logical)
let AU_MAX_PER_WINDOW  = 1      // <= 1 unsolicited teaching question per window
let AU_USER_ALPHA      = 4000   // Beta(4,1) user-taught prior
let AU_USER_BETA       = 1000
let AU_USER_EVIDENCE   = 3000   // Tier-A increment when re-teaching an existing atom
let AU_COMPETENCE_BAR  = 200    // competence < 0.2 in an active domain

// ---- ask budget -----------------------------------------------------------
let AB_TAG    = 0
let AB_WSTART = 1
let AB_COUNT  = 2

fn au_budget_new() {
    let b = list_new()
    push(b, AB_TAG)
    push(b, -100000)   // window start in the distant past -> fresh
    push(b, 0)
    return b
}

// May an unsolicited teaching question be asked now?
fn au_can_ask(budget, now) {
    if now - budget[AB_WSTART] >= AU_WINDOW { return 1 }
    if budget[AB_COUNT] < AU_MAX_PER_WINDOW { return 1 }
    return 0
}

// Record an unsolicited ask (rolling the window if it has elapsed).
fn au_record_ask(budget, now) {
    if now - budget[AB_WSTART] >= AU_WINDOW {
        list_set(budget, AB_WSTART, now)
        list_set(budget, AB_COUNT, 1)
    } else {
        list_set(budget, AB_COUNT, budget[AB_COUNT] + 1)
    }
    return budget[AB_COUNT]
}

// Gating (all must pass): not fetchable, and (blocks the response OR competence
// is below the bar), and the budget allows it.
fn au_should_ask(fetchable, blocks_response, competence, budget, now) {
    if fetchable != 0 { return 0 }
    if au_can_ask(budget, now) == 0 { return 0 }
    if blocks_response != 0 { return 1 }
    if competence < AU_COMPETENCE_BAR { return 1 }
    return 0
}

// ---- teach request --------------------------------------------------------
let TR_TAG    = 0
let TR_TARGET = 1
let TR_MODE   = 2

fn teach_request_new(target_concept, mode) {
    let r = list_new()
    push(r, TR_TAG)
    push(r, target_concept)
    push(r, mode)
    return r
}
fn teach_target(r) { return r[TR_TARGET] }
fn teach_mode(r)   { return r[TR_MODE] }

// The question text (a template fill -- no LLM, ADR-0014).
fn au_question(target_label, mode) {
    if mode == TEACH_EXPLICIT {
        return "I don't have anything on " + target_label + " yet. Can you tell me about it?"
    }
    return "I answered based on " + target_label + ". Is that what you meant?"
}

// Ingest the user's reply as user-taught knowledge in `domain_kg`, interning a
// word in `lang_kg` linked to it. New facts seed Beta(4,1); re-teaching adds a
// Tier-A evidence increment. Returns the (new or existing) atom.
fn au_ingest(lang_kg, domain_kg, target_label, answer_text, moment) {
    let existing = kg_find_atom(domain_kg, target_label)
    if existing != 0 {
        let b = atom_belief(existing)
        list_set(b, 0, b[0] + AU_USER_EVIDENCE)
        atom_payload_set(existing, "provenance", "user_taught")
        atom_touch(existing, moment)
        return existing
    }
    let a = kg_add_atom(domain_kg, ATOM_FACT, target_label, moment)
    atom_payload_set(a, "taught", answer_text)
    atom_payload_set(a, "provenance", "user_taught")
    let b = atom_belief(a)
    list_set(b, 0, AU_USER_ALPHA)
    list_set(b, 1, AU_USER_BETA)
    let w = word_intern(lang_kg, target_label, moment)
    word_add_sense(w, a, 900)
    return a
}

fn au_is_user_taught(atom) {
    if str_eq(atom_payload_get(atom, "provenance"), "user_taught") == 1 { return 1 }
    return 0
}
