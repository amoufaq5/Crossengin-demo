// CrossEngin learning: atom birth monitor.
//
// Purpose
//   Atoms are born only on novel, recurring, stable patterns (ADR-0025, ADR-0006
//   "atoms only on novel patterns"). This monitor accumulates candidate
//   co-activation patterns (from consolidation, ADR-0022) and mints a new atom
//   when all three gates hold:
//     1. frequency : the pattern recurred >= 5 times (>= 3 under high prediction
//        error -- surprise lowers the bar, ADR-0024),
//     2. novelty   : no existing atom in the target KG is within cosine 0.9,
//     3. stability : the pattern spanned >= 3 distinct moments/episodes.
//   The new atom seeds its belief at alpha = 1 + evidence_weight, beta = 1.
//
//   Similarity is integer cosine in milli (0.9 -> 900). Candidates are tracked
//   in a scanned list (not a builtin map -- NEXT_SESSION.md).
//
// ADRs implemented: ADR-0025 (atom birth), ADR-0023 (seeded belief), ADR-0024
//   (surprise lowers the frequency gate).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/kg/multi_kg_manager.nova (and atom_store).

import "../kg/multi_kg_manager.nova"

let BIRTH_FREQ_NORMAL   = 5    // recurrences required (normal)
let BIRTH_FREQ_SURPRISE = 3    // recurrences required under high error
let BIRTH_NOVELTY       = 900  // 0.9 max similarity to an existing atom
let BIRTH_STABILITY     = 3    // distinct moments/episodes required

// ---- candidate layout -----------------------------------------------------
let CB_SIG     = 0
let CB_FREQ    = 1
let CB_MOMENTS = 2   // list of distinct moment ids
let CB_EMBED   = 3
let CB_LABEL   = 4

fn cb_signature(c) { return c[CB_SIG] }
fn cb_freq(c)      { return c[CB_FREQ] }
fn cb_stability(c) { return len(c[CB_MOMENTS]) }
fn cb_embed(c)     { return c[CB_EMBED] }
fn cb_label(c)     { return c[CB_LABEL] }

// ---- monitor --------------------------------------------------------------
let ABM_TAG  = 0
let ABM_CAND = 1
let ABM_OBJ_TAG = 2501

fn abm_new() {
    let m = list_new()
    push(m, ABM_OBJ_TAG)
    push(m, list_new())
    return m
}

fn _abm_find(monitor, sig) {
    let c = monitor[ABM_CAND]
    let i = 0
    while i < len(c) {
        if str_eq(c[i][CB_SIG], sig) == 1 { return c[i] }
        i = i + 1
    }
    return 0
}

fn abm_candidate(monitor, sig) { return _abm_find(monitor, sig) }
fn abm_candidate_count(monitor) { return len(monitor[ABM_CAND]) }

// Observe one occurrence of a pattern (signature, embedding) in a moment.
// Bumps frequency, records the distinct moment, and refreshes the embedding.
fn abm_observe(monitor, sig, embedding, moment_ref, label) {
    let cand = _abm_find(monitor, sig)
    if cand == 0 {
        cand = list_new()
        push(cand, sig)
        push(cand, 0)
        push(cand, list_new())
        push(cand, embedding)
        push(cand, label)
        push(monitor[ABM_CAND], cand)
    }
    list_set(cand, CB_FREQ, cand[CB_FREQ] + 1)
    list_set(cand, CB_EMBED, embedding)
    if contains(cand[CB_MOMENTS], moment_ref) == 0 {
        push(cand[CB_MOMENTS], moment_ref)
    }
    return cand
}

// Novelty gate: no existing atom in kg is within BIRTH_NOVELTY similarity.
fn abm_novelty_ok(kg, embedding) {
    let atoms = kg_atoms(kg)
    let i = 0
    while i < len(atoms) {
        if vec_cosine(embedding, atom_embed(atoms[i])) >= BIRTH_NOVELTY { return 0 }
        i = i + 1
    }
    return 1
}

// All three birth gates. `high_error` lowers the frequency bar.
fn abm_should_birth(cand, kg, high_error) {
    let freq_gate = BIRTH_FREQ_NORMAL
    if high_error != 0 { freq_gate = BIRTH_FREQ_SURPRISE }
    if cand[CB_FREQ] < freq_gate { return 0 }
    if cb_stability(cand) < BIRTH_STABILITY { return 0 }
    if abm_novelty_ok(kg, cand[CB_EMBED]) == 0 { return 0 }
    return 1
}

// Mint the atom if the gates hold: an ATOM_CONCEPT in kg with the candidate's
// embedding and a belief seeded at alpha = 1 + evidence_weight. Returns the new
// atom, or 0 if no birth.
fn abm_birth(cand, kg, evidence_weight, high_error, moment) {
    if abm_should_birth(cand, kg, high_error) == 0 { return 0 }
    let a = kg_add_atom(kg, ATOM_CONCEPT, cand[CB_LABEL], moment)
    atom_set_embed(a, cand[CB_EMBED])
    list_set(atom_belief(a), 0, BEL_PRIOR + evidence_weight)
    return a
}
