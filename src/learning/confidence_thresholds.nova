// CrossEngin learning: confidence thresholds ("learned enough").
//
// Purpose
//   Decides when a self-directed learning episode (ADR-0026) may close (ADR-0030)
//   so loops always terminate. Low-stakes episodes need a confidence check plus
//   a multi-source check; high-stakes episodes (safety, actions, overturning a
//   prior) additionally require explicit user confirmation. Hard caps force a
//   close with `provisional` atoms (kept but not credited to competence) when
//   fetching or asking has been exhausted.
//
//   All quantities are integer milli: belief strength alpha+beta (12.0 -> 12000),
//   posterior mean (0.75 -> 750), self-test resolution fraction (0.8 -> 800),
//   combined source weight (1.0 -> 1000).
//
// ADRs implemented: ADR-0030 (confidence thresholds). Feeds ADR-0020 (competence
//   credit only for durable atoms) and ADR-0043 (closure logged).
// NOVA dependencies: builtins. CrossEngin dependencies: none.

// ---- stakes ---------------------------------------------------------------
let CT_LOW  = 1
let CT_HIGH = 2

// ---- closure reasons ------------------------------------------------------
let CT_REASON_NONE      = 0
let CT_REASON_LEARNED   = 1
let CT_REASON_FORCE_CAP = 2

// ---- thresholds (milli) ---------------------------------------------------
let CT_LOW_STRENGTH   = 12000   // alpha+beta >= 12
let CT_LOW_MEAN       = 750     // posterior mean >= 0.75
let CT_HIGH_STRENGTH  = 20000   // alpha+beta >= 20
let CT_HIGH_MEAN      = 850     // posterior mean >= 0.85
let CT_SELFTEST       = 800     // >= 80% self-test probe resolution
let CT_MIN_SOURCES    = 2       // >= 2 independent sources
let CT_MIN_COMBINED_W = 1000    // combined source weight >= 1.0
let CT_MAX_FETCH      = 5       // fetch attempts hard cap (ADR-0028)
let CT_MAX_TEACH_UNSAT= 1       // unsatisfied teach-requests hard cap (ADR-0027)

// Check 1 (confidence + self-test), low-stakes bar.
fn ct_check_confidence_low(strength, mean, selftest) {
    if strength < CT_LOW_STRENGTH { return 0 }
    if mean < CT_LOW_MEAN { return 0 }
    if selftest < CT_SELFTEST { return 0 }
    return 1
}

// Check 1, high-stakes bar.
fn ct_check_confidence_high(strength, mean, selftest) {
    if strength < CT_HIGH_STRENGTH { return 0 }
    if mean < CT_HIGH_MEAN { return 0 }
    if selftest < CT_SELFTEST { return 0 }
    return 1
}

// Check 2 (multi-source corroboration, no unresolved conflict).
fn ct_check_multisource(num_sources, combined_weight, contested) {
    if num_sources < CT_MIN_SOURCES { return 0 }
    if combined_weight < CT_MIN_COMBINED_W { return 0 }
    if contested != 0 { return 0 }
    return 1
}

// ---- closure result [done, reason, provisional] ---------------------------
fn _ct_result(done, reason, provisional) {
    let r = list_new()
    push(r, done)
    push(r, reason)
    push(r, provisional)
    return r
}
fn ct_done(r)        { return r[0] }
fn ct_reason(r)      { return r[1] }
fn ct_provisional(r) { return r[2] }

// Decide whether an episode may close. Hard caps force a provisional close;
// otherwise the stakes-appropriate checks must all pass for a durable close.
fn ct_episode_done(stakes, strength, mean, selftest, num_sources, combined_weight, contested, user_confirmed, fetch_attempts, teach_unsatisfied) {
    if fetch_attempts >= CT_MAX_FETCH { return _ct_result(1, CT_REASON_FORCE_CAP, 1) }
    if teach_unsatisfied >= CT_MAX_TEACH_UNSAT { return _ct_result(1, CT_REASON_FORCE_CAP, 1) }

    if stakes == CT_HIGH {
        if ct_check_confidence_high(strength, mean, selftest) == 1 {
            if ct_check_multisource(num_sources, combined_weight, contested) == 1 {
                if user_confirmed != 0 {
                    return _ct_result(1, CT_REASON_LEARNED, 0)
                }
            }
        }
        return _ct_result(0, CT_REASON_NONE, 0)
    }

    if ct_check_confidence_low(strength, mean, selftest) == 1 {
        if ct_check_multisource(num_sources, combined_weight, contested) == 1 {
            return _ct_result(1, CT_REASON_LEARNED, 0)
        }
    }
    return _ct_result(0, CT_REASON_NONE, 0)
}
