// CrossEngin learning: the SecAgg v4 coordinator (A2.2b; v4-sa2 verifiable
// shares and a robust rebuild, A2.4b; protocol v4-sa3 with the complaint
// round, verdicts and evidence, A2.4c).
//
// Purpose
//   The coordinator's side of one SecAgg v4 round (Bonawitz et al. 2017
//   double masking, actively secure variant), over the wire format in
//   sa4_wire.nova and against souls running sa4_soul.nova. Transport-free:
//   the caller passes every line it receives together with the roster id of
//   the connection it came from, closes each phase (normally on a deadline),
//   and sends the [to_id, line] messages it gets back. The fed coordinator
//   drives it over the network in v4 mode (A2.3c).
//
// Phases (state numbers; run order 0, 1, 8, 9, 2, 3, 4, 5 -- compare
// states only through sa4c_phase_order)
//   0  collect SA4_ADV            close -> U1 and H1; to every u in U1:
//                                 every ADV of U1 (ascending x) + SET 1
//   1  collect SA4_SHARE, SA4_SHSIG + END 1
//                                 close -> U2' (U1 souls with a complete
//                                 batch); to every v in U2': the shares
//                                 addressed to v from U2' + SA4_SET 5
//   8  collect SA4_COMPLAINT + END 4 (v4-sa3)
//                                 close -> nobody accused: the final SET 2;
//                                 else to each accused u: the complaints
//                                 about u (verbatim) + SA4_ACCUSE <its
//                                 complainers>
//   9  collect SA4_OPEN + END 5 from the accused (v4-sa3)
//                                 close -> verdicts, then the final SET 2
//                                 (U2 = U2' souls not left out)
//   2  collect SA4_Y + END 2      close -> U3; SA4_SET 3 to every u in U3
//   3  collect SA4_SIG3           close -> U4; to every u in U4: every SIG3
//                                 of U4 + SA4_SET 4
//   4  collect SA4_REVEAL + END 3 close -> revealers R
//   5  ready: sa4c_unmask once -> sum over U3 of the inputs, mod 2^32
//   A phase whose set falls below t cancels the round (state CANCELLED):
//   nothing is unmasked and the caller closes the connections.
//
// Leaving souls out
//   A line that does not parse, speaks for another id, arrives in the wrong
//   phase or breaks a rule below marks that soul bad: it is left out of
//   every later set, and its lines are ignored. For every rule the
//   coordinator can check itself, one bad soul is left out instead of
//   cancelling the round. Checks:
//   - ADV: signature over the ADV transcript (which covers the share
//     commitments B and M) verified against the roster key (souls would
//     refuse a round containing a bad one); c_pk != s_pk; no key shared
//     with another soul (both left out); no low-order key.
//   - shares: one per receiver in U1 \ {sender}, each 98 + 32 D(N) bytes;
//     the END count matches.
//   - y: the chunks assemble to exactly L words; the END count matches.
//   - SIG3: verifies over the T3 the coordinator computes from its own U1
//     keys, U2 and U3. A soul that signed another T3 is left out of U4.
//   - reveals: exactly one per soul in U2, a b-share for every soul in U3
//     and an s-share for every soul in U2 \ U3, each with a proof of
//     32 (D(N) + 1) bytes; the END count matches.
//   - shares (v4-sa3): e_pk structurally valid (sa4w_epk_ok, byte
//     compares), one SA4_SHSIG, no share after it, END 1 only after it. No
//     signature or X25519 work while collecting shares, complaints or
//     openings: complaints are stored verbatim, openings unchecked.
//   A soul that sent SA4_ABORT is recorded separately (sa4c_aborted) and its
//   reason says so: an abort is not evidence that the aborting soul
//   misbehaved, and must not be used to penalise it.
//
// Verdicts (v4-sa3, at the open close; the only place blame crypto runs)
//   A share's contents only its receiver (or, after the reveal of e_uv,
//   anyone) can check. A receiver whose share fails the content check
//   (sa4w_share_check) signs a SA4_COMPLAINT; the accused reveals e_uv for
//   a valid complaint. For every pair (complainer v, accused u), ascending
//   (x_v, x_u), while |U2' souls not left out| >= t (early stop: the round
//   is lost after |U2'| - t + 1 removals) and neither is out yet:
//   1. the complaint's leaf must be the leaf of the line routed u -> v,
//      else v is out, code 5; 2. v's signature over T_c(v, u, H1, lh), else
//      v out, code 5; 3. u's OPEN e with X25519_base(e) == e_pk, else u
//      out, code 3; 4. the judge's content check with sac_enc_key(e,
//      c_v^PK) and M_u from the ADVs; 5. it passes: v out, code 2 (proven,
//      evidence); 6. it fails and u's SHSIG verifies over the root of the
//      lines the coordinator holds from u: u out, code 1 (proven,
//      evidence), else u out, code 4. Every judged pair removes one soul;
//      the share root is computed only for a code 1/4 decision, once per
//      sender. Codes (sa4c_blamed): 0 not blamed, 1 sent a bad share
//      (proven), 2 false complaint (proven), 3 did not open, 4 share
//      signature does not verify, 5 complaint not routed or not verifying.
//      Codes 3..5 are not proof (a faulty link or coordinator can cause
//      them), exactly like sa4c_aborted. sa4c_evidence gives the evidence
//      text of codes 1 and 2 (SPEC A2.4c 8.8), which a standalone judge
//      (scripts/sa4_ref.py --judge) checks against the roster alone.
//
// Unmasking (sa4c_unmask, at most once)
//   total = sum_{u in U3} y_u - sum_{u in U3} PRG(b_u)
//           + correction for every d in U2 \ U3: for each v in U3, y_v
//             carried +PRG(s_vd) if d > v, else -PRG(s_vd); undo it.
//   b_u (u in U3) and s_d^SK (d in U2 \ U3) are rebuilt robustly and
//   lazily, each against its public check: H(bcommit .. b_u) == B_u from
//   u's signed ADV, X25519_base(s_d) == s_pk_d.
//   1. candidates = the revealers that revealed that share about the
//      dealer, ascending x, minus the revealers already excluded (for any
//      dealer: exclusion is global). Fewer than t: refuse.
//   2. combine the first t; if the check holds, use it (no proof work).
//   3. else verify the candidates' proofs (sa4w_proof_ok against the
//      dealer's M) in ascending x until t verify. A revealer whose proof
//      fails is excluded for every later secret; sa4c_why says "reveal
//      about soul <u> does not match its commitment" (not an abort).
//   4. fewer than t verified: refuse.
//   5. combine the t verified shares; if the check still fails, the dealer
//      committed to shares of another secret: refuse, and sa4c_why of the
//      dealer says "soul <u> dealt shares that do not match its
//      commitment".
//   An honest revealer's proof always verifies (its soul checked the share
//   against the commitment in R2), so while t honest revealers remain the
//   sum is right and the liars are named (sa4c_bad_revealers). An s-share
//   error confined to the bits X25519 clamps gives the same s_pk and the
//   same DH: it is accepted, with no exclusion. Liars outside the first t
//   are not looked for. Rebuilt secrets are wiped after use. A second
//   sa4c_unmask is refused.
//
// API
//   sa4c_new(roster, round, L, layout, vcache) -> coordinator
//   v4-sa3: sa4c_blamed(c, id) -> 0..5, sa4c_evidence(c, id) -> text or "",
//   sa4c_u2p(c), sa4c_accused(c) -> ids, sa4c_expect(c) -> ids the current
//   state reads from, sa4c_keep(c) -> ids still in the round,
//   sa4c_counters(c) -> [judged, skipped, roots, verifies],
//   sa4c_phase_order(st) -> position of st in the run order
//   sa4c_round_line(c)                -> the SA4_ROUND line for every soul
//   sa4c_recv(c, from_id, line)       -> [ok, err]
//   sa4c_close(c)                     -> [ok, err, msgs]; msgs = [to, line]
//   sa4c_unmask(c)                    -> [ok, err, words]
//   sa4c_state(c), sa4c_set(c, k) (k = 1..4 ids, 2 = the final U2;
//                                  5 = revealers; U2' is sa4c_u2p)
//   sa4c_why(c, id)                   -> why the soul was left out, or ""
//   sa4c_aborted(c, id)               -> 1 if it was left out because it
//                                        sent SA4_ABORT (possibly a victim)
//   sa4c_bad_revealers(c)             -> ascending ids of the revealers
//                                        excluded at unmasking (a reveal
//                                        that does not match its dealer's
//                                        commitment)
//   vcache: 0, or the verify/sign cache shared with souls in one process
//   (tests only; see sa4_soul.nova).
//
// The caller chooses the round id and must keep it increasing (souls
// refuse a round that is not after their last). The fed coordinator
// persists it per roster fingerprint (crossengin_fed_sa4_round_<fp16>,
// A2.3c), like v3n-sa's crossengin_fed_secagg_round.
//
// CrossEngin dependencies: sa4_wire, sa_crypto, sa_roster, shamir, saprg,
//   ed25519, x25519.

import "./sa4_wire.nova"
import "./sa_crypto.nova"
import "./sa_roster.nova"
import "../safety/shamir.nova"
import "../safety/saprg.nova"
import "../safety/ed25519.nova"

let SA4C_OBJ_TAG = 7511

let SA4C_ST_ADV = 0
let SA4C_ST_SHARES = 1
let SA4C_ST_Y = 2
let SA4C_ST_SIG3 = 3
let SA4C_ST_REVEAL = 4
let SA4C_ST_READY = 5
let SA4C_ST_DONE = 6
let SA4C_ST_CANCELLED = 7
let SA4C_ST_CHECK = 8      // v4-sa3: collect COMPLAINT + END 4 from U2'
let SA4C_ST_OPEN = 9       // v4-sa3: collect OPEN + END 5 from the accused

// Per-soul record slots (index x-1).
let SA4C_P_ADV = 0       // parsed ADV record or 0
let SA4C_P_BAD = 1       // 1 if left out
let SA4C_P_SHARES = 2    // list of parsed SHARE records
let SA4C_P_SEND = 3      // END 1 count, or -1
let SA4C_P_Y = 4         // list of parsed Y records
let SA4C_P_YEND = 5      // END 2 count, or -1
let SA4C_P_YV = 6        // assembled words or 0
let SA4C_P_SIG = 7       // SIG3 line or 0
let SA4C_P_REV = 8       // list of parsed REVEAL records
let SA4C_P_REND = 9      // END 3 count, or -1
let SA4C_P_SHARE_LINES = 10
let SA4C_P_WHY = 11      // reason it was left out
let SA4C_P_ABORTED = 12  // 1 if left out because it aborted
let SA4C_P_YSEEN = 13    // per chunk index: 1 once received
let SA4C_P_SHSIG = 14    // v4-sa3: SHSIG signature or 0
let SA4C_P_CMPL = 15     // list of [about_x, raw COMPLAINT line]
let SA4C_P_CEND = 16     // END 4 count, or -1
let SA4C_P_OPENS = 17    // list of [complainer_x, e]
let SA4C_P_OEND = 18     // END 5 count, or -1
let SA4C_P_CODE = 19     // blame code 0..5

fn _sa4c_list(n, v) {
    let out = list_new()
    let i = 0
    while i < n {
        push(out, v)
        i = i + 1
    }
    return out
}

fn _sa4c_res(ok, err, v) {
    let r = list_new()
    push(r, ok)
    push(r, err)
    push(r, v)
    return r
}

fn _sa4c_peer() {
    let p = list_new()
    push(p, 0)
    push(p, 0)
    push(p, list_new())
    push(p, 0 - 1)
    push(p, list_new())
    push(p, 0 - 1)
    push(p, 0)
    push(p, 0)
    push(p, list_new())
    push(p, 0 - 1)
    push(p, list_new())
    push(p, "")
    push(p, 0)
    push(p, list_new())
    push(p, 0)
    push(p, list_new())
    push(p, 0 - 1)
    push(p, list_new())
    push(p, 0 - 1)
    push(p, 0)
    return p
}

// Slots: 0 tag, 1 roster, 2 round, 3 L, 4 layout, 5 vcache, 6 state,
// 7 peers, 8 U1 xs, 9 U2 xs, 10 U3 xs, 11 U4 xs, 12 R xs, 13 fp, 14 T3,
// 15 cancel reason, 16 excluded revealer xs, 17 D(N); v4-sa3: 18 U2' xs,
// 19 H1, 20 accused (per roster x: ascending complainer xs, or 0),
// 21 share-root cache (per x: 0 or [ok, levels]), 22 counters [judged,
// skipped, roots, verifies], 23 evidence text per x ("" if none).
fn sa4c_new(roster, r, lw, layout, vcache) {
    let c = list_new()
    push(c, 7511)
    push(c, roster)
    push(c, r)
    push(c, lw)
    push(c, layout)
    push(c, vcache)
    push(c, 0)
    let peers = list_new()
    let i = 0
    while i < sroster_n(roster) {
        push(peers, _sa4c_peer())
        i = i + 1
    }
    push(c, peers)
    push(c, list_new())
    push(c, list_new())
    push(c, list_new())
    push(c, list_new())
    push(c, list_new())
    push(c, sa4w_unhex(sroster_fingerprint(roster), 32))
    push(c, 0)
    push(c, "")
    push(c, list_new())
    push(c, sa4w_depth(sroster_n(roster)))
    push(c, list_new())
    push(c, 0)
    push(c, _sa4c_list(sroster_n(roster), 0))
    push(c, _sa4c_list(sroster_n(roster), 0))
    push(c, _sa4c_list(4, 0))
    push(c, _sa4c_list(sroster_n(roster), ""))
    return c
}

fn sa4c_state(c) { return c[6] }

fn sa4c_set(c, k) {
    let xs = c[7 + k]
    let out = list_new()
    let i = 0
    while i < len(xs) {
        push(out, sroster_entries(c[1])[xs[i] - 1][0])
        i = i + 1
    }
    return out
}

fn sa4c_aborted(c, id) {
    let x = sroster_x(c[1], id)
    if x == 0 { return 0 }
    return c[7][x - 1][12]
}

fn sa4c_why(c, id) {
    let x = sroster_x(c[1], id)
    if x == 0 { return "" }
    return c[7][x - 1][11]
}

fn sa4c_bad_revealers(c) {
    let xs = c[16]
    let out = list_new()
    let x = 1
    while x <= sroster_n(c[1]) {
        if _sa4c_contains(xs, x) == 1 { push(out, _sa4c_id_at(c, x)) }
        x = x + 1
    }
    return out
}

// v4-sa3 blame: 0 not blamed (dropout, structural leave-out, abort);
// 1 sent a share that fails its receiver's check (proven, evidence);
// 2 false complaint (proven, evidence); 3 did not answer a valid complaint
// with a matching one-time key; 4 its share signature does not verify over
// the lines the coordinator received; 5 its complaint names a share it was
// not routed, or does not verify. Codes 3..5 are not proof (as
// sa4c_aborted); operators must not treat them as evidence.
fn sa4c_blamed(c, id) {
    let x = sroster_x(c[1], id)
    if x == 0 { return 0 }
    return c[7][x - 1][19]
}

// The evidence text against a soul with code 1 or 2, else "".
fn sa4c_evidence(c, id) {
    let x = sroster_x(c[1], id)
    if x == 0 { return "" }
    return c[23][x - 1]
}

fn _sa4c_ids(c, xs) {
    let out = list_new()
    let i = 0
    while i < len(xs) {
        push(out, _sa4c_id_at(c, xs[i]))
        i = i + 1
    }
    return out
}

fn _sa4c_live_ids(c, xs) {
    let out = list_new()
    let i = 0
    while i < len(xs) {
        if c[7][xs[i] - 1][1] == 0 { push(out, _sa4c_id_at(c, xs[i])) }
        i = i + 1
    }
    return out
}

fn _sa4c_accused_xs(c) {
    let out = list_new()
    let x = 1
    while x <= sroster_n(c[1]) {
        if c[20][x - 1] != 0 { push(out, x) }
        x = x + 1
    }
    return out
}

fn _sa4c_all_xs(c) {
    let out = list_new()
    let x = 1
    while x <= sroster_n(c[1]) {
        push(out, x)
        x = x + 1
    }
    return out
}

// U2' (the souls whose shares were routed), as ids.
fn sa4c_u2p(c) { return _sa4c_ids(c, c[18]) }

// The accused souls of the check phase (a forwarded complaint), as ids.
fn sa4c_accused(c) { return _sa4c_ids(c, _sa4c_accused_xs(c)) }

// [judged, skipped, roots, verifies] of the verdict loop (tests).
fn sa4c_counters(c) { return c[22] }

// Position of state st in the run order 0, 1, 8, 9, 2, 3, 4, 5, 6, 7.
// Compare states only through this (or an explicit list).
fn sa4c_phase_order(st) {
    let order = [0, 1, 4, 5, 6, 7, 8, 9, 2, 3]
    if st < 0 { return 0 - 1 }
    if st > 9 { return 0 - 1 }
    return order[st]
}

// Ids the current state reads lines from (left-out souls excluded):
// 0 every roster soul, 1 U1, 8 U2', 9 the accused, 2 U2, 3 U3, 4 U4;
// other states none.
fn sa4c_expect(c) {
    let st = c[6]
    if st == 0 { return _sa4c_live_ids(c, _sa4c_all_xs(c)) }
    if st == 1 { return _sa4c_live_ids(c, c[8]) }
    if st == 8 { return _sa4c_live_ids(c, c[18]) }
    if st == 9 { return _sa4c_live_ids(c, _sa4c_accused_xs(c)) }
    if st == 2 { return _sa4c_live_ids(c, c[9]) }
    if st == 3 { return _sa4c_live_ids(c, c[10]) }
    if st == 4 { return _sa4c_live_ids(c, c[11]) }
    return list_new()
}

// Ids still in the round after the last close: state 1 U1, 8 U2',
// 9 U2' not left out (accused or not), 2 U2, 3 U3, 4 U4; any other state
// every roster id (nobody is dropped).
fn sa4c_keep(c) {
    let st = c[6]
    if st == 1 { return _sa4c_ids(c, c[8]) }
    if st == 8 { return _sa4c_ids(c, c[18]) }
    if st == 9 { return _sa4c_live_ids(c, c[18]) }
    if st == 2 { return _sa4c_ids(c, c[9]) }
    if st == 3 { return _sa4c_ids(c, c[10]) }
    if st == 4 { return _sa4c_ids(c, c[11]) }
    return _sa4c_ids(c, _sa4c_all_xs(c))
}

fn sa4c_round_line(c) {
    return sa4w_fmt_round(c[2], c[13], c[3], c[4])
}

fn _sa4c_id_at(c, x) { return sroster_entries(c[1])[x - 1][0] }

fn _sa4c_contains(xs, x) {
    let i = 0
    while i < len(xs) {
        if xs[i] == x { return 1 }
        i = i + 1
    }
    return 0
}

fn _sa4c_eq(a, b) {
    if len(a) != len(b) { return 0 }
    let acc = 0
    let i = 0
    while i < len(a) {
        acc = int_or(acc, int_xor(a[i], b[i]))
        i = i + 1
    }
    if acc == 0 { return 1 }
    return 0
}

fn _sa4c_bad(c, x, why) {
    let p = c[7][x - 1]
    list_set(p, 1, 1)
    if len(p[11]) == 0 { list_set(p, 11, why) }
    return _sa4c_res(0, "left out soul " + int_to_str(_sa4c_id_at(c, x)) + ": " + why, 0)
}

fn _sa4c_ok() { return _sa4c_res(1, "", 0) }

// Leave soul x out with blame code k (set only if it has none yet).
fn _sa4c_out(c, x, k, why) {
    let p = c[7][x - 1]
    if p[19] == 0 { list_set(p, 19, k) }
    return _sa4c_bad(c, x, why)
}

// Signature check through the shared cache (see sa4_soul.nova).
fn _sa4c_verify(c, msg, sig, pk) {
    let key = "v" + sa4w_hex(pk) + sa4w_hex(sig) + sa4w_hex(sa4w_sha256(msg))
    let vc = c[5]
    if vc != 0 {
        let i = 0
        while i < len(vc) {
            if str_eq_bytes(vc[i][0], key) == 1 { return 1 }
            i = i + 1
        }
    }
    let ok = ed25519_verify(msg, sig, pk)
    if ok == 1 {
        if vc != 0 {
            let e = list_new()
            push(e, key)
            push(e, 1)
            push(vc, e)
        }
    }
    return ok
}

// 1 if X25519 with a fixed scalar gives an all-zero result (low order).
fn _sa4c_low_order(pk) {
    let sk = alloc(33)
    let i = 0
    while i < 32 {
        store8(sk + i, 7)
        i = i + 1
    }
    let out = alloc(33)
    let ok = x25519(out, sk, sac_list_to_buf(pk))
    if ok == 1 { return 0 }
    return 1
}

// ---- receiving -----------------------------------------------------------

fn sa4c_recv(c, from_id, line) {
    let st = c[6]
    let accepts = 0
    if st <= 4 { accepts = 1 }
    if st == 8 { accepts = 1 }
    if st == 9 { accepts = 1 }
    if st < 0 { accepts = 0 }
    if accepts == 0 { return _sa4c_res(0, "round no longer accepts lines", 0) }
    let x = sroster_x(c[1], from_id)
    if x == 0 { return _sa4c_res(0, "connection id not in the roster", 0) }
    let p = c[7][x - 1]
    if p[1] == 1 { return _sa4c_res(0, "soul already left out", 0) }
    let rec = sa4w_parse(line)
    if rec == 0 { return _sa4c_bad(c, x, "malformed line") }
    if rec[1] != c[2] { return _sa4c_bad(c, x, "line for another round") }
    let ev = rec[0]
    if ev == 48 {
        list_set(p, 12, 1)
        return _sa4c_bad(c, x, "aborted the round (" + rec[3] + "); possibly a victim, not evidence of misbehaviour")
    }
    if st == 0 {
        if ev != 41 { return _sa4c_bad(c, x, "expected SA4_ADV") }
        if rec[2] != from_id { return _sa4c_bad(c, x, "ADV for another id") }
        if p[0] != 0 { return _sa4c_bad(c, x, "second ADV") }
        if _sa4c_eq(rec[3], rec[4]) == 1 { return _sa4c_bad(c, x, "c_pk == s_pk") }
        if _sa4c_low_order(rec[3]) == 1 { return _sa4c_bad(c, x, "low-order c_pk") }
        if _sa4c_low_order(rec[4]) == 1 { return _sa4c_bad(c, x, "low-order s_pk") }
        let msg = sa4w_adv_transcript(c[13], c[2], from_id, c[3], c[4], rec[3], rec[4], rec[6], rec[7])
        let pk = sroster_entries(c[1])[x - 1][2]
        if _sa4c_verify(c, msg, rec[5], pk) != 1 { return _sa4c_bad(c, x, "ADV signature does not verify") }
        list_set(p, 0, rec)
        return _sa4c_ok()
    }
    // Membership of the state's sender set (state 4 checks U4 below).
    let member = 1
    if st == 1 { member = _sa4c_contains(c[8], x) }
    if st == 8 { member = _sa4c_contains(c[18], x) }
    if st == 9 {
        member = 0
        if c[20][x - 1] != 0 { member = 1 }
    }
    if st == 2 { member = _sa4c_contains(c[9], x) }
    if st == 3 { member = _sa4c_contains(c[10], x) }
    if member == 0 { return _sa4c_bad(c, x, "soul not in the current set") }
    if st == 1 {
        // No signature or X25519 work in this state.
        if p[3] >= 0 { return _sa4c_bad(c, x, "line after END") }
        if ev == 43 {
            if rec[2] != from_id { return _sa4c_bad(c, x, "share for another sender") }
            if p[14] != 0 { return _sa4c_bad(c, x, "share after the share signature") }
            let tx = sroster_x(c[1], rec[3])
            if tx == 0 { return _sa4c_bad(c, x, "share to an id not in the roster") }
            if tx == x { return _sa4c_bad(c, x, "share to itself") }
            if _sa4c_contains(c[8], tx) == 0 { return _sa4c_bad(c, x, "share to a soul outside U1") }
            if len(rec[4]) != sa4w_share_wire_len(c[17]) { return _sa4c_bad(c, x, "share ciphertext length does not match the roster's tree depth") }
            if sa4w_epk_ok(rec[5]) != 1 { return _sa4c_bad(c, x, "share one-time key is not a valid X25519 key") }
            let i = 0
            while i < len(p[2]) {
                if p[2][i][3] == rec[3] { return _sa4c_bad(c, x, "two shares to one soul") }
                i = i + 1
            }
            push(p[2], rec)
            push(p[10], line)
            return _sa4c_ok()
        }
        if ev == 49 {
            if rec[2] != from_id { return _sa4c_bad(c, x, "share signature for another id") }
            if p[14] != 0 { return _sa4c_bad(c, x, "second share signature") }
            list_set(p, 14, rec[3])
            return _sa4c_ok()
        }
        if ev == 47 {
            if rec[2] != 1 { return _sa4c_bad(c, x, "wrong END phase") }
            if rec[3] != from_id { return _sa4c_bad(c, x, "END for another id") }
            if rec[4] != len(p[2]) { return _sa4c_bad(c, x, "END count differs") }
            if rec[4] != len(c[8]) - 1 { return _sa4c_bad(c, x, "not one share per soul in U1") }
            if p[14] == 0 { return _sa4c_bad(c, x, "no share signature") }
            list_set(p, 3, rec[4])
            return _sa4c_ok()
        }
        return _sa4c_bad(c, x, "unexpected line while collecting shares")
    }
    if st == 8 {
        // Complaints are kept verbatim; no crypto here.
        if p[16] >= 0 { return _sa4c_bad(c, x, "line after END") }
        if ev == 50 {
            if rec[2] != from_id { return _sa4c_bad(c, x, "complaint for another id") }
            let ax = sroster_x(c[1], rec[3])
            if ax == 0 { return _sa4c_bad(c, x, "complaint about an id not in the roster") }
            if ax == x { return _sa4c_bad(c, x, "complaint about itself") }
            if _sa4c_contains(c[18], ax) == 0 { return _sa4c_bad(c, x, "complaint about a soul outside U2'") }
            let ci = 0
            while ci < len(p[15]) {
                if p[15][ci][0] == ax { return _sa4c_bad(c, x, "two complaints about one soul") }
                ci = ci + 1
            }
            let cp = list_new()
            push(cp, ax)
            push(cp, line)
            push(p[15], cp)
            return _sa4c_ok()
        }
        if ev == 47 {
            if rec[2] != 4 { return _sa4c_bad(c, x, "wrong END phase") }
            if rec[3] != from_id { return _sa4c_bad(c, x, "END for another id") }
            if rec[4] != len(p[15]) { return _sa4c_bad(c, x, "END count differs") }
            list_set(p, 16, rec[4])
            return _sa4c_ok()
        }
        return _sa4c_bad(c, x, "unexpected line while collecting complaints")
    }
    if st == 9 {
        // Openings are stored unchecked; they count once END 5 arrived.
        if p[18] >= 0 { return _sa4c_bad(c, x, "line after END") }
        if ev == 52 {
            if rec[2] != from_id { return _sa4c_bad(c, x, "opening for another id") }
            let vx = sroster_x(c[1], rec[3])
            let fwd = 0
            if vx != 0 { fwd = _sa4c_contains(c[20][x - 1], vx) }
            if fwd == 0 { return _sa4c_bad(c, x, "opening for a complaint that was not forwarded") }
            let oi = 0
            while oi < len(p[17]) {
                if p[17][oi][0] == vx { return _sa4c_bad(c, x, "two openings for one complaint") }
                oi = oi + 1
            }
            let op = list_new()
            push(op, vx)
            push(op, rec[4])
            push(p[17], op)
            return _sa4c_ok()
        }
        if ev == 47 {
            if rec[2] != 5 { return _sa4c_bad(c, x, "wrong END phase") }
            if rec[3] != from_id { return _sa4c_bad(c, x, "END for another id") }
            if rec[4] != len(p[17]) { return _sa4c_bad(c, x, "END count differs") }
            list_set(p, 18, rec[4])
            return _sa4c_ok()
        }
        return _sa4c_bad(c, x, "unexpected line while collecting openings")
    }
    if st == 2 {
        if p[5] >= 0 { return _sa4c_bad(c, x, "line after END") }
        if ev == 44 {
            if rec[2] != from_id { return _sa4c_bad(c, x, "Y for another id") }
            // Bound what one soul can make us store by this round's L:
            // n must be ceil(L/100), each index once, each chunk its size.
            let cn = (c[3] + 99) / 100
            if rec[4] != cn { return _sa4c_bad(c, x, "Y chunk count differs from L") }
            if len(p[13]) == 0 {
                let z = 0
                while z < cn {
                    push(p[13], 0)
                    z = z + 1
                }
            }
            let yci = rec[3]
            if p[13][yci] != 0 { return _sa4c_bad(c, x, "Y chunk sent twice") }
            let want_len = 100
            if yci == cn - 1 { want_len = c[3] - (cn - 1) * 100 }
            if len(rec[5]) != want_len { return _sa4c_bad(c, x, "Y chunk has the wrong length") }
            list_set(p[13], yci, 1)
            push(p[4], rec)
            return _sa4c_ok()
        }
        if ev == 47 {
            if rec[2] != 2 { return _sa4c_bad(c, x, "wrong END phase") }
            if rec[3] != from_id { return _sa4c_bad(c, x, "END for another id") }
            if rec[4] != len(p[4]) { return _sa4c_bad(c, x, "END count differs") }
            let yv = sa4w_y_assemble(p[4], c[3])
            if yv == 0 { return _sa4c_bad(c, x, "Y chunks do not assemble to L words") }
            list_set(p, 6, yv)
            list_set(p, 5, rec[4])
            return _sa4c_ok()
        }
        return _sa4c_bad(c, x, "unexpected line while collecting y")
    }
    if st == 3 {
        if ev != 45 { return _sa4c_bad(c, x, "expected SA4_SIG3") }
        if rec[2] != from_id { return _sa4c_bad(c, x, "SIG3 for another id") }
        if p[7] != 0 { return _sa4c_bad(c, x, "second SIG3") }
        let pk3 = sroster_entries(c[1])[x - 1][2]
        if _sa4c_verify(c, c[14], rec[3], pk3) != 1 { return _sa4c_bad(c, x, "SIG3 does not verify over this round's T3") }
        list_set(p, 7, line)
        return _sa4c_ok()
    }
    // st == 4: reveals from U4 only.
    if _sa4c_contains(c[11], x) == 0 { return _sa4c_bad(c, x, "soul not in U4") }
    if p[9] >= 0 { return _sa4c_bad(c, x, "line after END") }
    if ev == 46 {
        if rec[2] != from_id { return _sa4c_bad(c, x, "reveal for another id") }
        let rax = sroster_x(c[1], rec[3])
        if rax == 0 { return _sa4c_bad(c, x, "reveal about an id not in the roster") }
        if _sa4c_contains(c[9], rax) == 0 { return _sa4c_bad(c, x, "reveal about a soul outside U2") }
        let want = 1
        if _sa4c_contains(c[10], rax) == 1 { want = 0 }
        if rec[4] != want { return _sa4c_bad(c, x, "wrong share kind for that soul") }
        if len(rec[6]) != 32 * (c[17] + 1) { return _sa4c_bad(c, x, "reveal proof length does not match the roster's tree depth") }
        let j = 0
        while j < len(p[8]) {
            if p[8][j][3] == rec[3] { return _sa4c_bad(c, x, "two reveals about one soul") }
            j = j + 1
        }
        push(p[8], rec)
        return _sa4c_ok()
    }
    if ev == 47 {
        if rec[2] != 3 { return _sa4c_bad(c, x, "wrong END phase") }
        if rec[3] != from_id { return _sa4c_bad(c, x, "END for another id") }
        if rec[4] != len(p[8]) { return _sa4c_bad(c, x, "END count differs") }
        if rec[4] != len(c[9]) { return _sa4c_bad(c, x, "not one reveal per soul in U2") }
        list_set(p, 9, rec[4])
        return _sa4c_ok()
    }
    return _sa4c_bad(c, x, "unexpected line while collecting reveals")
}

// ---- closing phases -----------------------------------------------------------

fn _sa4c_cancel(c, why) {
    list_set(c, 6, 7)
    list_set(c, 15, why)
    return _sa4c_res(0, "cancelled: " + why, list_new())
}

fn _sa4c_msg(out, to, line) {
    let m = list_new()
    push(m, to)
    push(m, line)
    push(out, m)
    return 0
}

fn _sa4c_close_adv(c) {
    let n = sroster_n(c[1])
    let peers = c[7]
    // Keys shared between souls: leave every such soul out.
    let i = 0
    while i < n {
        let a = peers[i]
        if a[0] != 0 {
            if a[1] == 0 {
                let j = 0
                while j < n {
                    if j != i {
                        let b = peers[j]
                        if b[0] != 0 {
                            let clash = 0
                            if _sa4c_eq(a[0][3], b[0][3]) == 1 { clash = 1 }
                            if _sa4c_eq(a[0][3], b[0][4]) == 1 { clash = 1 }
                            if _sa4c_eq(a[0][4], b[0][3]) == 1 { clash = 1 }
                            if _sa4c_eq(a[0][4], b[0][4]) == 1 { clash = 1 }
                            if clash == 1 {
                                _sa4c_bad(c, i + 1, "advertised a key another soul also advertised")
                            }
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    let u1 = list_new()
    i = 0
    while i < n {
        if peers[i][0] != 0 {
            if peers[i][1] == 0 { push(u1, i + 1) }
        }
        i = i + 1
    }
    list_set(c, 8, u1)
    if len(u1) < sroster_t(c[1]) { return _sa4c_cancel(c, "|U1| " + int_to_str(len(u1)) + " below t") }
    list_set(c, 19, _sa4c_h1(c))
    let advs = list_new()
    i = 0
    while i < len(u1) {
        let rec = peers[u1[i] - 1][0]
        push(advs, sa4w_fmt_adv(c[2], rec[2], rec[3], rec[4], rec[5], rec[6], rec[7]))
        i = i + 1
    }
    let set1 = sa4w_fmt_set(c[2], 1, sa4w_bitmap(u1))
    let out = list_new()
    i = 0
    while i < len(u1) {
        let to = _sa4c_id_at(c, u1[i])
        let k = 0
        while k < len(advs) {
            _sa4c_msg(out, to, advs[k])
            k = k + 1
        }
        _sa4c_msg(out, to, set1)
        i = i + 1
    }
    list_set(c, 6, 1)
    return _sa4c_res(1, "", out)
}

// H1 over U1 (ascending x) from the coordinator's ADVs.
fn _sa4c_h1(c) {
    let keys = list_new()
    let i = 0
    while i < len(c[8]) {
        let a = c[7][c[8][i] - 1][0]
        let kp = list_new()
        push(kp, a[3])
        push(kp, a[4])
        push(kp, a[6])
        push(kp, a[7])
        push(keys, kp)
        i = i + 1
    }
    return sa4w_advset_hash(sa4w_bitmap(c[8]), keys)
}

fn _sa4c_live_count(c, xs) {
    let k = 0
    let i = 0
    while i < len(xs) {
        if c[7][xs[i] - 1][1] == 0 { k = k + 1 }
        i = i + 1
    }
    return k
}

// Shares close: U2' = the U1 souls not left out (a missing END 1 leaves a
// soul out); route every share line among U2', then SET 5.
fn _sa4c_close_shares(c) {
    let u1 = c[8]
    let i = 0
    while i < len(u1) {
        let p = c[7][u1[i] - 1]
        if p[1] == 0 {
            if p[3] < 0 { _sa4c_bad(c, u1[i], "share batch incomplete") }
        }
        i = i + 1
    }
    let u2p = list_new()
    i = 0
    while i < len(u1) {
        if c[7][u1[i] - 1][1] == 0 { push(u2p, u1[i]) }
        i = i + 1
    }
    list_set(c, 18, u2p)
    if len(u2p) < sroster_t(c[1]) { return _sa4c_cancel(c, "|U2'| " + int_to_str(len(u2p)) + " below t") }
    let set5 = sa4w_fmt_set(c[2], 5, sa4w_bitmap(u2p))
    let out = list_new()
    i = 0
    while i < len(u2p) {
        let to = _sa4c_id_at(c, u2p[i])
        let j = 0
        while j < len(u2p) {
            if j != i {
                let sp = c[7][u2p[j] - 1]
                let k = 0
                while k < len(sp[2]) {
                    if sp[2][k][3] == to { _sa4c_msg(out, to, sp[10][k]) }
                    k = k + 1
                }
            }
            j = j + 1
        }
        _sa4c_msg(out, to, set5)
        i = i + 1
    }
    list_set(c, 6, 8)
    return _sa4c_res(1, "", out)
}

// Final SET 2: U2 = the U2' souls not left out.
fn _sa4c_final_set2(c) {
    let u2 = list_new()
    let i = 0
    while i < len(c[18]) {
        if c[7][c[18][i] - 1][1] == 0 { push(u2, c[18][i]) }
        i = i + 1
    }
    list_set(c, 9, u2)
    if len(u2) < sroster_t(c[1]) { return _sa4c_cancel(c, "|U2| " + int_to_str(len(u2)) + " below t") }
    let set2 = sa4w_fmt_set(c[2], 2, sa4w_bitmap(u2))
    let out = list_new()
    i = 0
    while i < len(u2) {
        _sa4c_msg(out, _sa4c_id_at(c, u2[i]), set2)
        i = i + 1
    }
    list_set(c, 6, 2)
    return _sa4c_res(1, "", out)
}

// Check close: forward every complaint (verbatim) to its accused with
// SA4_ACCUSE, or go straight to the final SET 2 when nobody is accused.
fn _sa4c_close_check(c) {
    let u2p = c[18]
    let n = sroster_n(c[1])
    let i = 0
    while i < len(u2p) {
        let p = c[7][u2p[i] - 1]
        if p[1] == 0 {
            if p[16] < 0 { _sa4c_bad(c, u2p[i], "did not finish the check phase") }
        }
        i = i + 1
    }
    let acc = _sa4c_list(n, 0)
    let any = 0
    i = 0
    while i < len(u2p) {
        let vx = u2p[i]
        let pv = c[7][vx - 1]
        if pv[1] == 0 {
            let k = 0
            while k < len(pv[15]) {
                let ax = pv[15][k][0]
                if c[7][ax - 1][1] == 0 {
                    if acc[ax - 1] == 0 { list_set(acc, ax - 1, list_new()) }
                    push(acc[ax - 1], vx)
                    any = 1
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    list_set(c, 20, acc)
    if any == 0 { return _sa4c_final_set2(c) }
    let out = list_new()
    let ux = 1
    while ux <= n {
        let vs = acc[ux - 1]
        if vs != 0 {
            let to = _sa4c_id_at(c, ux)
            let j = 0
            while j < len(vs) {
                let pc = c[7][vs[j] - 1][15]
                let k2 = 0
                while k2 < len(pc) {
                    if pc[k2][0] == ux { _sa4c_msg(out, to, pc[k2][1]) }
                    k2 = k2 + 1
                }
                j = j + 1
            }
            _sa4c_msg(out, to, sa4w_fmt_accuse(c[2], sa4w_bitmap(vs)))
        }
        ux = ux + 1
    }
    list_set(c, 6, 9)
    return _sa4c_res(1, "", out)
}

// Open close: verdicts, then accused souls without END 5 are left out,
// then the final SET 2.
fn _sa4c_close_open(c) {
    _sa4c_verdicts(c)
    let ux = 1
    while ux <= sroster_n(c[1]) {
        if c[20][ux - 1] != 0 {
            let p = c[7][ux - 1]
            if p[1] == 0 {
                if p[18] < 0 { _sa4c_bad(c, ux, "did not finish the open phase") }
            }
        }
        ux = ux + 1
    }
    return _sa4c_final_set2(c)
}

// ---- verdicts (v4-sa3; the only place blame crypto runs) ------------------------

// Index in u's share records of its line to v (roster x vx), or -1.
fn _sa4c_share_idx(c, ux, vx) {
    let v = _sa4c_id_at(c, vx)
    let sh = c[7][ux - 1][2]
    let k = 0
    while k < len(sh) {
        if sh[k][3] == v { return k }
        k = k + 1
    }
    return 0 - 1
}

// root_ok(u), cached in c[21]: the sender's signature over the root of the
// share lines the coordinator holds from it.
fn _sa4c_root_ok(c, ux) {
    let cache = c[21]
    if cache[ux - 1] != 0 { return cache[ux - 1][0] }
    let cnt = c[22]
    list_set(cnt, 2, cnt[2] + 1)
    list_set(cnt, 3, cnt[3] + 1)
    let n = sroster_n(c[1])
    let u = _sa4c_id_at(c, ux)
    let leaves = _sa4c_list(n, 0)
    let sh = c[7][ux - 1][2]
    let k = 0
    while k < len(sh) {
        let rec = sh[k]
        let tx = sroster_x(c[1], rec[3])
        list_set(leaves, tx - 1, sa4w_sleaf(c[13], c[2], u, tx, rec[3], rec[5], rec[4]))
        k = k + 1
    }
    let levels = sa4w_share_tree(leaves, c[17])
    let msg = sa4w_shares_transcript(c[13], c[2], u, c[19], sa4w_tree_root(levels))
    let ok = 0
    let sig = c[7][ux - 1][14]
    if sig != 0 { ok = _sa4c_verify(c, msg, sig, sroster_entries(c[1])[ux - 1][2]) }
    let ent = list_new()
    push(ent, ok)
    push(ent, levels)
    list_set(cache, ux - 1, ent)
    return ok
}

fn _sa4c_verdicts(c) {
    let n = sroster_n(c[1])
    let t = sroster_t(c[1])
    let cnt = c[22]
    let fp = c[13]
    let r = c[2]
    let dd = c[17]
    // Pairs (x_v, x_u) ascending: complainer first.
    let vx = 1
    while vx <= n {
        let ux = 1
        while ux <= n {
            let vs = c[20][ux - 1]
            if vs != 0 {
                if _sa4c_contains(vs, vx) == 1 {
                    if _sa4c_live_count(c, c[18]) >= t {
                        _sa4c_judge(c, vx, ux, fp, r, dd, cnt)
                    }
                }
            }
            ux = ux + 1
        }
        vx = vx + 1
    }
    return 0
}

fn _sa4c_judge(c, vx, ux, fp, r, dd, cnt) {
    let pv = c[7][vx - 1]
    let pu = c[7][ux - 1]
    if pv[1] == 1 {
        list_set(cnt, 1, cnt[1] + 1)
        return 0
    }
    if pu[1] == 1 {
        list_set(cnt, 1, cnt[1] + 1)
        return 0
    }
    list_set(cnt, 0, cnt[0] + 1)
    let v = _sa4c_id_at(c, vx)
    let u = _sa4c_id_at(c, ux)
    let li = _sa4c_share_idx(c, ux, vx)
    let line = pu[2][li]
    // v's complaint about u, re-parsed from the raw line.
    let craw = ""
    let k = 0
    while k < len(pv[15]) {
        if pv[15][k][0] == ux { craw = pv[15][k][1] }
        k = k + 1
    }
    let cp = sa4w_parse(craw)
    // 1. the complaint names the line the coordinator routed.
    let lh = sa4w_sleaf(fp, r, u, vx, v, line[5], line[4])
    if _sa4c_eq(cp[4], lh) == 0 {
        _sa4c_out(c, vx, 5, "complaint about soul " + int_to_str(u) + " names a share it was not sent (not proven)")
        return 0
    }
    // 2. v signed it over H1.
    list_set(cnt, 3, cnt[3] + 1)
    let cmsg = sa4w_complaint_transcript(fp, r, v, u, c[19], lh)
    if _sa4c_verify(c, cmsg, cp[5], sroster_entries(c[1])[vx - 1][2]) != 1 {
        _sa4c_out(c, vx, 5, "complaint about soul " + int_to_str(u) + " does not verify (not proven)")
        return 0
    }
    // 3. u opened it with the one-time key behind e_pk.
    let e = 0
    if pu[18] >= 0 {
        let oi = 0
        while oi < len(pu[17]) {
            if pu[17][oi][0] == vx { e = pu[17][oi][1] }
            oi = oi + 1
        }
    }
    let epk_match = 0
    let eb = 0
    if e != 0 {
        eb = sac_list_to_buf(e)
        let pkb = alloc(33)
        x25519_base(pkb, eb)
        epk_match = _sa4c_eq(sac_buf_to_list(pkb, 32), line[5])
    }
    if epk_match == 0 {
        if eb != 0 { sac_zero_buf(eb, 32) }
        _sa4c_out(c, ux, 3, "did not open its share to soul " + int_to_str(v) + " with its one-time key (not proven)")
        return 0
    }
    // 4. the judge's content check with c_v^PK and M_u from the ADVs.
    let ek = sac_enc_key(eb, sac_list_to_buf(pv[0][3]), r, u, v)
    sac_zero_buf(eb, 32)
    let key = 0
    if ek[1] == 1 { key = ek[0] }
    let chk = sa4w_share_check(fp, r, u, v, vx, dd, key, line[4], pu[0][7])
    if len(chk[0]) == 0 {
        _sa4c_zero_list(chk[1])
        _sa4c_zero_list(chk[2])
        _sa4c_out(c, vx, 2, "proven: false complaint about soul " + int_to_str(u) + " (the share opens and matches)")
        list_set(c[23], vx - 1, _sa4c_evidence_text(c, ux, vx, 2, e))
        return 0
    }
    if _sa4c_root_ok(c, ux) == 1 {
        _sa4c_out(c, ux, 1, "proven: sent soul " + int_to_str(v) + " a share that fails the " + chk[0] + " check")
        list_set(c[23], ux - 1, _sa4c_evidence_text(c, ux, vx, 1, e))
        return 0
    }
    _sa4c_out(c, ux, 4, "share signature does not verify over the shares it sent (not proven)")
    return 0
}

fn _sa4c_zero_list(l) {
    if l == 0 { return 0 }
    let i = 0
    while i < len(l) {
        list_set(l, i, 0)
        i = i + 1
    }
    return 0
}

// Concatenate strings with one allocation (each part followed by "\n").
fn _sa4c_join_lines(parts) {
    let n = 0
    let i = 0
    while i < len(parts) {
        n = n + len(parts[i]) + 1
        i = i + 1
    }
    let buf = alloc(n + 1)
    let off = 0
    i = 0
    while i < len(parts) {
        let s = parts[i]
        let j = 0
        while j < len(s) {
            store8(buf + off + j, char_at(s, j))
            j = j + 1
        }
        off = off + len(s)
        store8(buf + off, 10)
        off = off + 1
        i = i + 1
    }
    store8(buf + n, 0)
    return substr(buf, 0, n)
}

// The evidence text (SPEC A2.4c 8.8) against sender u (code 1) or
// complainer v (code 2): every line ends with "\n".
fn _sa4c_evidence_text(c, ux, vx, code, e) {
    let parts = list_new()
    push(parts, "crossengin-sa4-evidence v1")
    push(parts, "fp " + sa4w_hex(c[13]))
    push(parts, "round " + int_to_str(c[2]))
    push(parts, "code " + int_to_str(code))
    push(parts, "sender " + int_to_str(_sa4c_id_at(c, ux)))
    push(parts, "complainer " + int_to_str(_sa4c_id_at(c, vx)))
    push(parts, "u1 " + sa4w_hex(sa4w_bitmap(c[8])))
    let i = 0
    while i < len(c[8]) {
        let a = c[7][c[8][i] - 1][0]
        push(parts, "key " + int_to_str(a[2]) + " " + sa4w_hex(a[3]) + " " + sa4w_hex(a[4]) + " " + sa4w_hex(a[6]) + " " + sa4w_hex(a[7]))
        i = i + 1
    }
    let pu = c[7][ux - 1]
    push(parts, "share " + pu[10][_sa4c_share_idx(c, ux, vx)])
    if code == 1 {
        let path = sa4w_path(c[21][ux - 1][1], vx - 1)
        let flat = list_new()
        let k = 0
        while k < len(path) {
            let j = 0
            while j < 32 {
                push(flat, path[k][j])
                j = j + 1
            }
            k = k + 1
        }
        push(parts, "path " + sa4w_hex(flat))
        push(parts, "shsig " + sa4w_hex(pu[14]))
    } else {
        push(parts, "path -")
        push(parts, "shsig -")
    }
    let pv = c[7][vx - 1]
    let craw = ""
    let q = 0
    while q < len(pv[15]) {
        if pv[15][q][0] == ux { craw = pv[15][q][1] }
        q = q + 1
    }
    push(parts, "complaint " + craw)
    push(parts, "open " + sa4w_hex(e))
    return _sa4c_join_lines(parts)
}

fn _sa4c_close_y(c) {
    let u2 = c[9]
    let u3 = list_new()
    let i = 0
    while i < len(u2) {
        let p = c[7][u2[i] - 1]
        if p[1] == 0 {
            if p[5] >= 0 { push(u3, u2[i]) }
        }
        i = i + 1
    }
    list_set(c, 10, u3)
    if len(u3) < sroster_t(c[1]) { return _sa4c_cancel(c, "|U3| " + int_to_str(len(u3)) + " below t") }
    // T3 the souls in U3 are expected to sign (H1 from the ADV close).
    list_set(c, 14, sa4w_t3_transcript(c[13], c[2], c[19], sa4w_bitmap(u2), sa4w_bitmap(u3)))
    let set3 = sa4w_fmt_set(c[2], 3, sa4w_bitmap(u3))
    let out = list_new()
    i = 0
    while i < len(u3) {
        _sa4c_msg(out, _sa4c_id_at(c, u3[i]), set3)
        i = i + 1
    }
    list_set(c, 6, 3)
    return _sa4c_res(1, "", out)
}

fn _sa4c_close_sig3(c) {
    let u3 = c[10]
    let u4 = list_new()
    let i = 0
    while i < len(u3) {
        let p = c[7][u3[i] - 1]
        if p[1] == 0 {
            if p[7] != 0 { push(u4, u3[i]) }
        }
        i = i + 1
    }
    list_set(c, 11, u4)
    if len(u4) < sroster_t(c[1]) { return _sa4c_cancel(c, "|U4| " + int_to_str(len(u4)) + " below t") }
    let set4 = sa4w_fmt_set(c[2], 4, sa4w_bitmap(u4))
    let out = list_new()
    i = 0
    while i < len(u4) {
        let to = _sa4c_id_at(c, u4[i])
        let j = 0
        while j < len(u4) {
            _sa4c_msg(out, to, c[7][u4[j] - 1][7])
            j = j + 1
        }
        _sa4c_msg(out, to, set4)
        i = i + 1
    }
    list_set(c, 6, 4)
    return _sa4c_res(1, "", out)
}

fn _sa4c_close_reveal(c) {
    let u4 = c[11]
    let rv = list_new()
    let i = 0
    while i < len(u4) {
        let p = c[7][u4[i] - 1]
        if p[1] == 0 {
            if p[9] >= 0 { push(rv, u4[i]) }
        }
        i = i + 1
    }
    list_set(c, 12, rv)
    if len(rv) < sroster_t(c[1]) { return _sa4c_cancel(c, int_to_str(len(rv)) + " complete reveal batches, below t") }
    list_set(c, 6, 5)
    return _sa4c_res(1, "", list_new())
}

fn sa4c_close(c) {
    let st = c[6]
    if st == 0 { return _sa4c_close_adv(c) }
    if st == 1 { return _sa4c_close_shares(c) }
    if st == 8 { return _sa4c_close_check(c) }
    if st == 9 { return _sa4c_close_open(c) }
    if st == 2 { return _sa4c_close_y(c) }
    if st == 3 { return _sa4c_close_sig3(c) }
    if st == 4 { return _sa4c_close_reveal(c) }
    return _sa4c_res(0, "refused: no phase to close", list_new())
}

// ---- unmasking -------------------------------------------------------------------

// Set the reason of soul x if it has none (after the round: no effect on
// the sets).
fn _sa4c_note(c, x, why) {
    let p = c[7][x - 1]
    if len(p[11]) == 0 { list_set(p, 11, why) }
    return 0
}

// Combine the shares of the given [x, rec] candidates; a fresh buffer or 0.
fn _sa4c_combine(cands) {
    let shares = list_new()
    let i = 0
    while i < len(cands) {
        push(shares, shamir_share(cands[i][0], sac_list_to_buf(cands[i][1][5]), 32))
        i = i + 1
    }
    let sec = shamir_combine(shares, 32)
    i = 0
    while i < len(shares) {
        sac_zero_buf(shares[i][1], 32)
        i = i + 1
    }
    return sec
}

// 1 if sec is dealer ax's committed secret: kind 0 (b_u) against B_u,
// kind 1 (s_u^SK) against s_pk_u.
fn _sa4c_check(c, ax, kind, sec) {
    if sec == 0 { return 0 }
    let adv = c[7][ax - 1][0]
    if kind == 0 {
        let bl = sac_buf_to_list(sec, 32)
        let bc = sa4w_bcommit(c[13], c[2], _sa4c_id_at(c, ax), bl)
        let i = 0
        while i < 32 {
            list_set(bl, i, 0)
            i = i + 1
        }
        return _sa4c_eq(bc, adv[6])
    }
    let chk = alloc(33)
    let okp = sac_x25519_pub(chk, sec)
    if okp != 1 { return 0 }
    return _sa4c_eq(sac_buf_to_list(chk, 32), adv[4])
}

// Rebuild the secret of kind `kind` (0 b_u, 1 s_u^SK) about soul ax:
// [buffer, ""] or [0, reason]. See "Unmasking" above.
fn _sa4c_rebuild(c, ax, kind) {
    let about = _sa4c_id_at(c, ax)
    let t = sroster_t(c[1])
    let rv = c[12]
    let excl = c[16]
    let cands = list_new()
    let i = 0
    while i < len(rv) {
        if _sa4c_contains(excl, rv[i]) == 0 {
            let p = c[7][rv[i] - 1]
            let j = 0
            while j < len(p[8]) {
                let rr = p[8][j]
                if rr[3] == about {
                    if rr[4] == kind {
                        let cd = list_new()
                        push(cd, rv[i])
                        push(cd, rr)
                        push(cands, cd)
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    let few = "fewer than t good shares about soul " + int_to_str(about)
    if len(cands) < t { return [0, few] }
    let first = list_new()
    i = 0
    while i < t {
        push(first, cands[i])
        i = i + 1
    }
    let sec = _sa4c_combine(first)
    if _sa4c_check(c, ax, kind, sec) == 1 { return [sec, ""] }
    if sec != 0 { sac_zero_buf(sec, 32) }
    // Verify proofs in ascending x until t verify.
    let dd = c[17]
    let mroot = c[7][ax - 1][0][7]
    let good = list_new()
    i = 0
    while i < len(cands) {
        if len(good) < t {
            let cx = cands[i][0]
            let rr2 = cands[i][1]
            if sa4w_proof_ok(c[13], c[2], about, cx, kind, rr2[5], rr2[6], dd, mroot) == 1 {
                push(good, cands[i])
            } else {
                push(excl, cx)
                _sa4c_note(c, cx, "reveal about soul " + int_to_str(about) + " does not match its commitment")
            }
        }
        i = i + 1
    }
    if len(good) < t { return [0, few] }
    let sec2 = _sa4c_combine(good)
    if _sa4c_check(c, ax, kind, sec2) == 1 { return [sec2, ""] }
    if sec2 != 0 { sac_zero_buf(sec2, 32) }
    let blame = "soul " + int_to_str(about) + " dealt shares that do not match its commitment"
    _sa4c_note(c, ax, blame)
    return [0, blame]
}

fn sa4c_unmask(c) {
    if c[6] == 6 { return _sa4c_res(0, "refused: this round was already unmasked", 0) }
    if c[6] != 5 { return _sa4c_res(0, "refused: the round is not ready to unmask", 0) }
    list_set(c, 6, 6)
    let r = c[2]
    let u2 = c[9]
    let u3 = c[10]
    let total = _sa4c_list(c[3], 0)
    let i = 0
    while i < len(u3) {
        total = saprg_vec_add(total, c[7][u3[i] - 1][6])
        i = i + 1
    }
    i = 0
    while i < len(u2) {
        let ax = u2[i]
        let kind = 1
        if _sa4c_contains(u3, ax) == 1 { kind = 0 }
        let rb = _sa4c_rebuild(c, ax, kind)
        if rb[0] == 0 { return _sa4c_res(0, "refused: " + rb[1], 0) }
        let sec = rb[0]
        if kind == 0 {
            total = saprg_mask(total, sec, 0 - 1)
        } else {
            let d = _sa4c_id_at(c, ax)
            let k = 0
            while k < len(u3) {
                let vx = u3[k]
                let v = _sa4c_id_at(c, vx)
                let ms = sac_mask_seed(sec, sac_list_to_buf(c[7][vx - 1][0][4]), r, d, v)
                if ms[1] != 1 {
                    sac_zero_buf(sec, 32)
                    return _sa4c_res(0, "refused: mask key agreement refused", 0)
                }
                if d > v {
                    total = saprg_mask(total, ms[0], 0 - 1)
                } else {
                    total = saprg_mask(total, ms[0], 1)
                }
                sac_zero_buf(ms[0], 32)
                k = k + 1
            }
        }
        sac_zero_buf(sec, 32)
        i = i + 1
    }
    return _sa4c_res(1, "", total)
}
