// Experiment flags (Batch 3, B2): ablation switches and a per-turn trace for
// the E1 ablation study (experiments/e1). EVERY flag is OFF by default, and
// with all of them off the chat's output is unchanged byte for byte.
//
// A flag is ON only when its environment variable is exactly "1":
//
//   CE_ABL_SUBSTRATE  substrate ticks become clock-only: the logical clock
//                     still advances (timestamps, decay, `tick=` stay
//                     meaningful) but no part integrates, fires, propagates
//                     or learns (tick_driver TD_ENG_CLOCK_ONLY).
//   CE_ABL_FF         /good and /bad do not train the Forward-Forward layer.
//   CE_ABL_PC         predictive coding off: prediction error held at 0, the
//                     predictor is neither trained nor queried.
//   CE_ABL_CACHE      moment cache neither looked up nor filled (every turn
//                     runs the router).
//   CE_ABL_IA         adaptive intent prototypes neither override the
//                     category nor get reinforced on /good.
//   CE_ABL_SYNW       router-table weights change no behaviour: the router
//                     ignores them when scoring candidate operators, and /good
//                     no longer compiles weight-gated A->C shortcuts (edges
//                     are still grown and /good still writes the weights, so
//                     the table stays observable).
//   CE_ABL_BETA       /good and /bad do not update operator confidence
//                     (rop_observe is skipped in router_apply_feedback).
//
//   CE_HEBB           not an ablation: turns ON the router-table Hebbian
//                     step after every routed reply (B3, audit F-03).
//
//   CE_EXP_TRACE      print one `EXP {json}` line per conversational turn
//                     (see the chat's _exp_trace_line). Not an ablation.
//
// Read once at startup by exp_flags_init_from_env(). Tests set flags
// directly with exp_set_abl / exp_set_trace and clear them with
// exp_flags_reset().

import "std/syscall"
import "std/string"
import "../util/str_safe.nova"

let ABL_SUBSTRATE = 0
let ABL_FF        = 1
let ABL_PC        = 2
let ABL_CACHE     = 3
let ABL_IA        = 4
let ABL_SYNW      = 5
let ABL_BETA      = 6
let ABL_COUNT     = 7

let _exp_abl = 0       // list of ABL_COUNT ints (0/1); 0 == not initialised
let _exp_trace = 0
let _exp_hebb = 0

// Short lower-case name of a flag, used in the EXP line and the banner.
// The environment variable is "CE_ABL_" + upper-case name.
fn abl_name(idx) {
    if idx == ABL_SUBSTRATE { return "substrate" }
    if idx == ABL_FF        { return "ff" }
    if idx == ABL_PC        { return "pc" }
    if idx == ABL_CACHE     { return "cache" }
    if idx == ABL_IA        { return "ia" }
    if idx == ABL_SYNW      { return "synw" }
    if idx == ABL_BETA      { return "beta" }
    return ""
}

fn abl_env_name(idx) {
    if idx == ABL_SUBSTRATE { return "CE_ABL_SUBSTRATE" }
    if idx == ABL_FF        { return "CE_ABL_FF" }
    if idx == ABL_PC        { return "CE_ABL_PC" }
    if idx == ABL_CACHE     { return "CE_ABL_CACHE" }
    if idx == ABL_IA        { return "CE_ABL_IA" }
    if idx == ABL_SYNW      { return "CE_ABL_SYNW" }
    if idx == ABL_BETA      { return "CE_ABL_BETA" }
    return ""
}

// All flags off (the default).
fn exp_flags_reset() {
    let l = list_new()
    let i = 0
    while i < ABL_COUNT { push(l, 0); i = i + 1 }
    _exp_abl = l
    _exp_trace = 0
    _exp_hebb = 0
    return 1
}

// 1 iff the environment value turns a flag on. Only "1" does; "", "0" and
// anything else leave it off.
fn exp_env_value_on(v) {
    if v == 0 { return 0 }            // getenv: 0 when unset
    if len(v) != 1 { return 0 }
    if str_eq_bytes(v, "1") == 1 { return 1 }
    return 0
}

// Read every flag from the environment. Returns the number of ablations on.
fn exp_flags_init_from_env() {
    exp_flags_reset()
    let n = 0
    let i = 0
    while i < ABL_COUNT {
        if exp_env_value_on(getenv(abl_env_name(i))) == 1 {
            list_set(_exp_abl, i, 1)
            n = n + 1
        }
        i = i + 1
    }
    _exp_trace = exp_env_value_on(getenv("CE_EXP_TRACE"))
    _exp_hebb = exp_env_value_on(getenv("CE_HEBB"))
    return n
}

fn exp_set_abl(idx, on) {
    if _exp_abl == 0 { exp_flags_reset() }
    if idx < 0 { return 0 }
    if idx >= ABL_COUNT { return 0 }
    let v = 0
    if on != 0 { v = 1 }
    list_set(_exp_abl, idx, v)
    return v
}

// 1 when ablation `idx` is on. Safe before init (everything off).
fn abl_on(idx) {
    if _exp_abl == 0 { return 0 }
    if idx < 0 { return 0 }
    if idx >= ABL_COUNT { return 0 }
    return _exp_abl[idx]
}

fn exp_set_trace(on) {
    _exp_trace = 0
    if on != 0 { _exp_trace = 1 }
    return _exp_trace
}

fn exp_trace_on() { return _exp_trace }

// B3 (audit F-03): CE_HEBB=1 turns on the router-table Hebbian step after
// every routed reply (cr_hebb_step). Not an ablation: it adds learning, so
// it is reported separately from exp_flags_csv().
fn exp_set_hebb(on) {
    _exp_hebb = 0
    if on != 0 { _exp_hebb = 1 }
    return _exp_hebb
}

fn exp_hebb_on() { return _exp_hebb }

// Flags for the EXP trace: the ablations, then "hebb" when CE_HEBB is on.
fn exp_trace_flags_csv() {
    let out = exp_flags_csv()
    if _exp_hebb == 1 {
        if len(out) > 0 { out = out + "," }
        out = out + "hebb"
    }
    return out
}

// Comma-separated names of the ablations that are on ("" when none).
fn exp_flags_csv() {
    let out = ""
    let i = 0
    while i < ABL_COUNT {
        if abl_on(i) == 1 {
            if len(out) > 0 { out = out + "," }
            out = out + abl_name(i)
        }
        i = i + 1
    }
    return out
}
