// CrossEngin audit: decision-log reader / inspection.
//
// Purpose
//   The read side of the decision log (ADR-0043): chain verification plus
//   plain-language rendering of entries for user inspection (ADR-0038), built
//   purely from stored state -- NO LLM (ADR-0014). audit_why reconstructs the
//   causal account of an action ("driven by goal G via N nodes, gated <tier>
//   because it is <reversibility>") directly from the recorded trace and
//   originating goal, without re-running the substrate.
//
// ADRs implemented: ADR-0043 (decision log inspection), ADR-0038 (self-model
//   query surface). NOVA dependencies: builtins. CrossEngin dependencies:
//   src/audit/decision_log.nova, src/safety/permission_tiers.nova
//   (-> reversibility_classifier.nova, for the name tables).

import "decision_log.nova"
import "../safety/permission_tiers.nova"

// Re-check the hash chain (mutation / truncation / reorder all fail).
fn audit_verify(log) { return dl_verify(log) }

fn audit_outcome_name(o) { return out_name(o) }

// Render one entry as plain language.
fn audit_render(log, i) {
    let e = dl_get(log, i)
    if e == 0 { return "no such entry" }
    return "#" + int_to_str(dl_seq(e)) + " " + dlk_name(dl_kind(e)) + " "
        + act_name(dl_action_type(e)) + " (" + rev_class_name(dl_rev_class(e)) + ")"
        + " tier=" + perm_tier_name(dl_perm_tier(e))
        + " outcome=" + out_name(dl_outcome(e))
}

// "Why did you do X?" -- reconstruct the causal account from the stored trace
// and originating goal (no LLM, no re-run).
fn audit_why(log, i) {
    let e = dl_get(log, i)
    if e == 0 { return "no such entry" }
    let s = "I performed " + act_name(dl_action_type(e))
    let g = dl_goal(e)
    if g >= 0 { s = s + " driven by goal #" + int_to_str(g) }
    s = s + " via " + int_to_str(len(dl_trace(e))) + " node(s); it is "
        + rev_class_name(dl_rev_class(e)) + " so it was gated "
        + perm_tier_name(dl_perm_tier(e)) + "."
    return s
}

// Count entries with a given outcome (e.g. how many actions failed).
fn audit_count_outcome(log, outcome) {
    let n = dl_count(log)
    let c = 0
    let i = 0
    while i < n {
        if dl_outcome(dl_get(log, i)) == outcome { c = c + 1 }
        i = i + 1
    }
    return c
}

// Seq of the most recent entry for an action type (-1 if none).
fn audit_last_for_action(log, action_type) {
    let i = dl_count(log) - 1
    while i >= 0 {
        if dl_action_type(dl_get(log, i)) == action_type { return i }
        i = i - 1
    }
    return -1
}
