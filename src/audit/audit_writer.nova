// CrossEngin audit: decision-log writer.
//
// Purpose
//   The write side of the decision log (ADR-0043). Implements the mandated
//   ordering: append an INTENT entry BEFORE the effector runs, then an OUTCOME
//   entry after; for irreversible actions (ADR-0042) the intent must be durably
//   synced first (audit_needs_sync flags this; the fsync itself is the
//   runtime/db seam, NOVA enhancement #9). Corrections and overrides (ADR-0044)
//   append their own entries. The action descriptor [class, type, perm_tier,
//   rev_class] is derived from the live permission/reversibility logic, so the
//   log records the tier that actually gated the action.
//
// ADRs implemented: ADR-0043 (decision log). NOVA dependencies: builtins.
// CrossEngin dependencies: src/audit/decision_log.nova,
//   src/safety/permission_tiers.nova (-> reversibility_classifier.nova).

import "decision_log.nova"
import "../safety/permission_tiers.nova"

// Build the action descriptor. In v1 the action class and action type share the
// ACT_* space (see permission_tiers), so they coincide here.
fn _audit_desc(action_type) {
    let d = list_new()
    push(d, action_type)
    push(d, action_type)
    push(d, perm_effective_tier(action_type))
    push(d, reversibility_class(action_type))
    return d
}

fn audit_open() { return dl_new() }

// ADR-0043 write-ordering: the intent for an irreversible action must be synced
// to durable storage before the effector runs. This predicate marks which
// appends require that hard sync (the sync primitive is the runtime/db seam).
fn audit_needs_sync(action_type) { return is_irreversible(action_type) }

// Append the INTENT entry (outcome PENDING) before the effector runs. trace is
// the signal's visited-node list; soul_ref points at the decision-time soul
// state. Returns the intent's seq for later correlation.
fn audit_intent(log, action_type, goal, trace, soul_ref, now) {
    return dl_append(log, DLK_INTENT, -1, now, _audit_desc(action_type), goal, trace, soul_ref, OUT_PENDING)
}

// Append the OUTCOME entry after the effector runs, referencing the intent and
// copying its descriptor/goal/trace so the completion record is self-describing.
fn audit_outcome(log, intent_seq, outcome, now) {
    let it = dl_get(log, intent_seq)
    let d = list_new()
    if it == 0 {
        push(d, 0)
        push(d, 0)
        push(d, 0)
        push(d, 0)
        return dl_append(log, DLK_OUTCOME, intent_seq, now, d, -1, list_new(), 0, outcome)
    }
    push(d, dl_action_class(it))
    push(d, dl_action_type(it))
    push(d, dl_perm_tier(it))
    push(d, dl_rev_class(it))
    return dl_append(log, DLK_OUTCOME, intent_seq, now, d, dl_goal(it), dl_trace(it), dl_soul_ref(it), outcome)
}

// Append a SIG_CORRECTION-tagged entry (ADR-0044 belief edit). ref is the
// corrected atom id.
fn audit_correction(log, action_type, ref, now) {
    return dl_append(log, DLK_CORRECTION, ref, now, _audit_desc(action_type), -1, list_new(), 0, OUT_OK)
}

// Append an OVERRIDE entry (ADR-0044 goal veto / hard stop / clean kill). ref is
// the affected goal id (or -1 for process-level overrides).
fn audit_override(log, action_type, ref, now) {
    return dl_append(log, DLK_OVERRIDE, ref, now, _audit_desc(action_type), -1, list_new(), 0, OUT_OK)
}
