// CrossEngin audit: decision log (append-only, hash-chained).
//
// Purpose
//   The authoritative, non-decaying record of what the system did and why
//   (ADR-0043). Every gated action (ADR-0041) appends one immutable INTENT entry
//   before its effector runs and an OUTCOME entry after; corrections and
//   overrides (ADR-0044) append their own entries. Entries are never mutated or
//   deleted -- corrections are themselves appended. Each entry is content-hash
//   chained to its predecessor, so mutation, reordering, mid-chain cuts, and
//   tail truncation are all detectable by dl_verify.
//
//   The on-disk, fsync-backed segment store is NOVA enhancement #9 (deferred to
//   the runtime seam); this module is the in-memory append-only chain and the
//   tamper-evidence logic that storage layer will persist verbatim. The hash is a
//   deterministic integer rolling hash (not cryptographic; runtime/crypto is the
//   future hardening per ADR-0043).
//
// ADRs implemented: ADR-0043 (decision log). NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- entry kinds ----------------------------------------------------------
let DLK_INTENT     = 1   // recorded before an effector runs
let DLK_OUTCOME    = 2   // completion/undo record, references an intent
let DLK_CORRECTION = 3   // SIG_CORRECTION (belief edit, ADR-0044)
let DLK_OVERRIDE   = 4   // goal veto / hard stop / clean kill (ADR-0044)

fn dlk_name(k) {
    if k == DLK_INTENT     { return "intent" }
    if k == DLK_OUTCOME    { return "outcome" }
    if k == DLK_CORRECTION { return "correction" }
    if k == DLK_OVERRIDE   { return "override" }
    return "unknown"
}

// ---- outcomes -------------------------------------------------------------
let OUT_PENDING = 0   // intent written, effector not yet completed
let OUT_OK      = 1
let OUT_FAILED  = 2
let OUT_UNDONE  = 3
let OUT_VETOED  = 4

fn out_name(o) {
    if o == OUT_PENDING { return "pending" }
    if o == OUT_OK      { return "ok" }
    if o == OUT_FAILED  { return "failed" }
    if o == OUT_UNDONE  { return "undone" }
    if o == OUT_VETOED  { return "vetoed" }
    return "unknown"
}

// ---- log header object ----------------------------------------------------
let DLOG_TAG   = 4301
let DL_TAGOFF  = 0
let DL_ENTRIES = 1
let DL_HEAD    = 2   // running hash of the last entry (0 for an empty chain)

fn dl_new() {
    let g = list_new()
    push(g, DLOG_TAG)
    push(g, list_new())
    push(g, 0)
    return g
}

fn dl_count(log)     { return len(log[DL_ENTRIES]) }
fn dl_head_hash(log) { return log[DL_HEAD] }

fn dl_get(log, i) {
    if i < 0 { return 0 }
    if i >= len(log[DL_ENTRIES]) { return 0 }
    return log[DL_ENTRIES][i]
}

// ---- entry layout ---------------------------------------------------------
let LOG_ENTRY = 4310
let E_TAG     = 0
let E_SEQ     = 1
let E_KIND    = 2
let E_REF     = 3    // referenced intent seq (-1 if none)
let E_TS      = 4
let E_ACLASS  = 5
let E_ATYPE   = 6
let E_PTIER   = 7
let E_RCLASS  = 8
let E_GOAL    = 9    // originating goal id (-1 if none)
let E_TRACE   = 10   // signal trace: list of visited node ids
let E_SOUL    = 11   // soul-state snapshot reference
let E_OUTCOME = 12
let E_PREV    = 13   // hash of the prior entry
let E_HASH    = 14   // this entry's content hash

// ---- content hash chain (deterministic, integer) --------------------------
// A polynomial rolling hash over every field of a partially-built entry (its
// tag/prev/own-hash slots are not yet present and so are not folded). The
// multiplier (131) and modulus (1000003, prime) are deliberately small: every
// intermediate product stays well bounded, which the current NOVA backend
// requires (it miscompiles large-magnitude multiplies inside a loop). This is a
// tamper-evidence hash, not a cryptographic one (runtime/crypto hardening is the
// ADR-0043 future work). Negative fields are zig-zag mapped so e.g. ref=-1 and
// ref=1 hash distinctly.
fn dl_hash_entry(prev, e) {
    let acc = list_new()
    push(acc, e[E_SEQ])
    push(acc, e[E_KIND])
    push(acc, e[E_REF])
    push(acc, e[E_TS])
    push(acc, e[E_ACLASS])
    push(acc, e[E_ATYPE])
    push(acc, e[E_PTIER])
    push(acc, e[E_RCLASS])
    push(acc, e[E_GOAL])
    push(acc, e[E_SOUL])
    push(acc, e[E_OUTCOME])
    let tr = e[E_TRACE]
    push(acc, len(tr))
    let j = 0
    while j < len(tr) {
        push(acc, tr[j])
        j = j + 1
    }
    let h = prev
    let i = 0
    while i < len(acc) {
        let x = acc[i]
        let z = x * 2
        if x < 0 { z = (0 - x) * 2 - 1 }
        h = (h * 131 + z) % 1000003
        i = i + 1
    }
    return h
}

// Append an immutable entry. desc must have 4 elements. Returns the new seq.
fn dl_append(log, kind, ref, ts, desc, goal, trace, sref, outcome) {
    let seq = len(log[DL_ENTRIES])
    let prev = log[DL_HEAD]
    let e = list_new()
    push(e, LOG_ENTRY)
    push(e, seq)
    push(e, kind)
    push(e, ref)
    push(e, ts)
    push(e, desc[0])
    push(e, desc[1])
    push(e, desc[2])
    push(e, desc[3])
    push(e, goal)
    push(e, trace)
    push(e, sref)
    push(e, outcome)
    let h = dl_hash_entry(prev, e)
    push(e, prev)
    push(e, h)
    push(log[DL_ENTRIES], e)
    list_set(log, DL_HEAD, h)
    return seq
}

// ---- entry accessors ------------------------------------------------------
fn dl_seq(e)          { return e[E_SEQ] }
fn dl_kind(e)         { return e[E_KIND] }
fn dl_ref(e)          { return e[E_REF] }
fn dl_timestamp(e)    { return e[E_TS] }
fn dl_action_class(e) { return e[E_ACLASS] }
fn dl_action_type(e)  { return e[E_ATYPE] }
fn dl_perm_tier(e)    { return e[E_PTIER] }
fn dl_rev_class(e)    { return e[E_RCLASS] }
fn dl_goal(e)         { return e[E_GOAL] }
fn dl_trace(e)        { return e[E_TRACE] }
fn dl_soul_ref(e)     { return e[E_SOUL] }
fn dl_outcome(e)      { return e[E_OUTCOME] }
fn dl_prev_hash(e)    { return e[E_PREV] }
fn dl_hash(e)         { return e[E_HASH] }

// Re-walk the chain. Returns 1 if intact, 0 on any tamper: a mutated field
// (recomputed hash mismatch), a non-monotonic seq, a broken prev linkage
// (mid-chain cut/reorder), or a head mismatch (tail truncation).
fn dl_verify(log) {
    let entries = log[DL_ENTRIES]
    let prev = 0
    let i = 0
    while i < len(entries) {
        let e = entries[i]
        if e[E_SEQ] != i    { return 0 }
        if e[E_PREV] != prev { return 0 }
        let h = dl_hash_entry(prev, e)
        if e[E_HASH] != h { return 0 }
        prev = h
        i = i + 1
    }
    if prev != log[DL_HEAD] { return 0 }
    return 1
}
