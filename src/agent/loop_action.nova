// CrossEngin agent: action loop.
//
// Purpose
//   The action loop (ADR-0036): produce the agent's output utterance from the
//   blackboard state via pure substrate-derived templating (ADR-0013) -- never
//   an LLM (ADR-0014). The output reflects real state: an acknowledgment when
//   the input was comprehended, a not-understood utterance (with the
//   learning-trigger implication) when there were unknown tokens, and a
//   silence template when neither. Output words are interned into the
//   language KG so produced vocabulary is real language atoms.
//
//   Since Phase N R2 (ADR-0093), the inline three-branch template body has
//   moved into `src/parts/action/action_module.nova` -- the module composes
//   an `Intent` record (`action_atoms.nova`) with the effector-gated submit
//   chain (`src/io/effectors/effector_gate.nova`), so every SPEAK writes an
//   INTENT record BEFORE the emit and an OUTCOME record AFTER (closing the
//   README-called-out audit-trail gap under ADR-0041). This file keeps the
//   2-arg `loop_action_step(ctx, lang_kg)` signature so the two examples
//   binaries and the existing unit test are byte-untouched; internally it
//   routes through the action module's module-level singleton, and the
//   perception module's singleton (R1) supplies the last Percept via
//   `pm_last_percept`.
//
//   Behavior-preservation contract (asserted in
//   `tests/unit/test_action_module.nova` + the extended
//   `tests/unit/test_loop_action.nova`): for the three existing loop_action
//   fixtures the emitted `ctx_output` text is BYTE-IDENTICAL to pre-R2
//   ("i do not fully understand that yet" / "understood" /
//   "i have nothing to say"). What CHANGES is the decision log now carries
//   INTENT + OUTCOME records for the SPEAK intents when a decision log has
//   been wired in (chat REPL / unit tests pass no log, and the module's
//   submit path short-circuits silently in that case).
//
// ADRs implemented: ADR-0036 (action loop), ADR-0013 (output generation),
//   ADR-0041 (safety gate integration), ADR-0093 (action module).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/agent/loop_coordination.nova, src/language/word_atoms.nova,
//   src/parts/action/action_module.nova,
//   src/parts/perception/perception_module.nova.

import "loop_coordination.nova"
import "../language/word_atoms.nova"
import "../parts/action/action_module.nova"
import "../parts/perception/perception_module.nova"

// Intern each space-separated token of an utterance into the language KG (the
// substrate "speaks" in real word atoms).
fn _action_intern(lang_kg, text, moment) {
    if lang_kg == 0 { return 0 }
    if text == 0 { return 0 }
    if len(text) == 0 { return 0 }
    let toks = split_space(text)
    let i = 0
    while i < len(toks) {
        if len(str_trim(toks[i])) > 0 { word_intern(lang_kg, toks[i], moment) }
        i = i + 1
    }
    return 1
}

// Produce the output utterance from the context and intern its words. Writes
// the output onto the blackboard and returns it.
//
// Post-Phase-N-R2: delegates to `action_run` on the action-module singleton.
// The action module derives an Intent (SPEAK or INTERNAL) from ctx state
// + the perception module's cached Percept, submits SPEAK intents through
// `effector_gate.effector_submit` + `effector_speak` (writing INTENT +
// OUTCOME to the decision log when one is wired), and returns the Intent.
// The shim then writes `in_text(intent)` to ctx_output -- this preserves
// byte-identity of the pre-R2 three-branch template on the three existing
// fixtures.
fn loop_action_step(ctx, lang_kg) {
    let now = ctx_tick(ctx)
    // Reach for the daemon-wired decision log / goal engine if they exist.
    // In the current chat REPL + unit-test callers, these helpers return 0
    // (no daemon threaded in), and the action_module's submit path
    // short-circuits silently -- byte-identical to pre-R2 in that case.
    let dl = _la_get_dl_or_null()
    let ge = _la_get_goal_engine_or_null()
    let am = action_module_singleton_for(dl, ge)
    // Perception module's last Percept -- R1 caches it on the module-level
    // singleton. When perception has not run this tick (e.g. an action-only
    // unit-test fixture), `pm_last_percept` returns 0 and the derive path
    // treats source_percept_id as 0.
    let pm = perception_module_singleton_for(0)
    let percept = pm_last_percept(pm)
    let halted = _la_halted_or_zero()
    // The pre-R2 body did not distinguish approved vs unapproved -- treat
    // every loop_action call as user-approved so a NOTIFY/APPROVE tier
    // SPEAK still runs (SPEAK is REV_RECOVERABLE -> NOTIFY per
    // permission_tiers, so this is a safety-neutral default).
    let user_approved = 1
    let soul_ref = 0
    let intent = action_run(am, ctx, percept, halted, user_approved, soul_ref, now)
    let out = in_text(intent)
    // Emit the intent's text to the blackboard. The intent's IN_TEXT slot
    // carries the pre-R2 template text for each branch (see the derive
    // path in action_module.nova + the INTERNAL constructor in
    // action_atoms.nova), so ctx_output is byte-identical to pre-R2.
    _action_intern(lang_kg, out, now)
    ctx_set_output(ctx, out)
    return out
}

// ---- daemon-wire helpers -------------------------------------------------
//
// These helpers reach for the daemon-wired decision log + goal engine when
// they are available, and safely return 0 when they are not. The chat REPL
// and every existing loop_action unit test call `loop_action_step` without
// any daemon plumbing, so the helpers must never fault when the wiring is
// absent. Today the wiring is not exposed through a global registry; the
// helpers return 0 unconditionally, and a future round can flip them to
// read a module-level slot the daemon populates (mirrors ADR-0086's
// `_ac_config_load` module-cached-config pattern).

fn _la_get_dl_or_null() {
    return _la_dl_slot
}

fn _la_get_goal_engine_or_null() {
    return _la_ge_slot
}

fn _la_halted_or_zero() {
    return _la_halted_slot
}

// Module-level slots the daemon (or a unit test) can populate to thread a
// decision log / goal engine into `loop_action_step` without changing the
// 2-arg signature. All default to 0 -- the R2 submit path treats a 0
// decision log as "no daemon wired" and short-circuits without writing to
// the log; a test that DOES want to observe the INTENT + OUTCOME writes
// installs its own log via `_la_set_dl(dl)`.
let _la_dl_slot = 0
let _la_ge_slot = 0
let _la_halted_slot = 0

fn _la_set_dl(dl)     { _la_dl_slot = dl; return 1 }
fn _la_set_ge(ge)     { _la_ge_slot = ge; return 1 }
fn _la_set_halted(h)  { _la_halted_slot = h; return 1 }

// Test-only: clear the module-level wiring slots. Not invoked by
// production paths.
fn _la_wiring_reset() {
    _la_dl_slot = 0
    _la_ge_slot = 0
    _la_halted_slot = 0
    return 1
}
