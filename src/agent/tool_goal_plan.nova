// CrossEngin agent: goal -> tool-plan bridge (P4 -> P5, ADR-0054 follow-up).
//
// Purpose
//   Closes the ADR-0054 "Honest gap" -- "Plans are built by hand, not
//   decomposed by goal_engine". This module turns a DECOMPOSED GOAL (a goal in
//   src/parts/goals/goal_engine.nova with ordered leaf sub-goals) into a
//   tool_use PLAN that plan_execute can run end to end.
//
//   How the bridge works. goal_engine models a goal as a priority-sorted TREE:
//   a parent goal with child sub-goals (means-ends decomposition, ADR-0033).
//   That gives the SHAPE of the plan -- the ordered leaf sub-goals are the
//   steps to perform, in order. What a goal-engine leaf does NOT carry is the
//   tool binding: which capability satisfies the step, and how that step's
//   argument is built from the previous step's result. So the bridge pairs the
//   goal's ordered leaves with an ordered TOOL-BINDING SPEC (one binding per
//   leaf): each binding is [capability, arg_source, literal] -- exactly the
//   triple plan_step takes. goal_to_plan walks the goal's children IN ORDER and
//   emits one plan step per leaf, drawing capability/arg from the matching
//   binding. The result is a plan_* plan; plan_execute then selects a tool by
//   competence, gates it, invokes it, threads the result forward, and learns --
//   unchanged.
//
//   Why a spec rather than reading the tool off the goal: goal_engine is a
//   self-contained tree with no tool/capability fields, and this module must
//   not edit it. Rather than smuggle tool metadata into the goal name (brittle
//   string parsing), the caller supplies a clean parallel spec. The
//   decomposition itself -- the order and the leaf set -- still comes from the
//   goal tree, so this is a genuine goal->plan bridge, not a relabelling: change
//   the goal's children (add/block/reorder) and the emitted plan changes with
//   it. A convenience builder (goal_plan_build) creates the goal tree and the
//   spec together for the common case.
//
// ADRs: ADR-0054 (agentic tooling), ADR-0033 (goal engine / decomposition).
// CrossEngin deps: src/agent/tool_use.nova (plan model + execution),
//   src/parts/goals/goal_engine.nova (the goal tree we decompose).

import "tool_use.nova"
import "../parts/goals/goal_engine.nova"

// ---- tool-binding spec -----------------------------------------------------
// A binding is the tool side of one leaf sub-goal: which capability satisfies
// it and how the step argument is built (the same triple plan_step takes).
let GB_CAP = 0
let GB_SRC = 1
let GB_LIT = 2

fn goal_binding(capability, arg_source, literal) {
    let b = list_new()
    push(b, capability); push(b, arg_source); push(b, literal)
    return b
}

// A spec is an ordered list of bindings, one per leaf sub-goal in tree order.
fn goal_spec_new() { return list_new() }
fn goal_spec_add(spec, binding) { push(spec, binding); return len(spec) }

// Convenience: append a binding by its three fields (no separate goal_binding).
fn goal_spec_step(spec, capability, arg_source, literal) {
    push(spec, goal_binding(capability, arg_source, literal))
    return len(spec)
}

// ---- collect a goal's ordered leaves ---------------------------------------
// The plan steps are the goal's leaf sub-goals, in decomposition order: a
// depth-first, children-in-order walk, skipping blocked/abandoned leaves (no
// active path -> not a step to attempt). A goal that is itself a leaf (no
// children) decomposes to a single step (itself). Returns a list of goal ids.
fn _gp_leaf_active(engine, id) {
    let s = goal_status(engine, id)
    if s == GOAL_BLOCKED   { return 0 }
    if s == GOAL_ABANDONED { return 0 }
    return 1
}

fn _gp_collect_leaves(engine, id, out) {
    let kids = goal_children(engine, id)
    if len(kids) == 0 {
        if _gp_leaf_active(engine, id) == 1 { push(out, id) }
        return out
    }
    let i = 0
    while i < len(kids) {
        _gp_collect_leaves(engine, kids[i], out)
        i = i + 1
    }
    return out
}

// The ordered active leaf-goal ids under `root_id` (the steps of the plan).
fn goal_leaves(engine, root_id) {
    let out = list_new()
    _gp_collect_leaves(engine, root_id, out)
    return out
}

// ---- the bridge ------------------------------------------------------------
// Decompose `root_id` into its ordered active leaves and emit one plan step per
// leaf, pairing leaf k with binding k of `spec`. Returns a plan_* plan ready
// for plan_execute. If a leaf has no matching binding (spec shorter than the
// leaf set), that leaf is skipped (it has no tool binding to attempt); a spec
// longer than the leaf set ignores the surplus. The COUNT of steps therefore
// reflects the goal's active decomposition, not the spec length.
fn goal_to_plan(engine, root_id, spec) {
    let leaves = goal_leaves(engine, root_id)
    let plan = plan_new()
    let i = 0
    while i < len(leaves) {
        if i < len(spec) {
            let b = spec[i]
            plan_add(plan, plan_step(b[GB_CAP], b[GB_SRC], b[GB_LIT]))
        }
        i = i + 1
    }
    return plan
}

// Number of steps the goal currently decomposes into (active leaves that have a
// matching binding). Lets a caller check the plan shape before executing.
fn goal_plan_step_count(engine, root_id, spec) {
    let leaves = goal_leaves(engine, root_id)
    let n = len(leaves)
    if len(spec) < n { n = len(spec) }
    return n
}

// ---- convenience builder ---------------------------------------------------
// The common case: build a goal tree (a root with one child per step) AND the
// parallel binding spec from a single list of step descriptors, then return
// both so the caller can decompose-and-run. A step descriptor is
// [goal_name, capability, arg_source, literal]. Returns [engine, root_id, spec].
//
// This is the "decomposed by goal_engine" path end to end: the steps become
// real sub-goals in a real goal_engine (so arbitration / progress / blocking
// all apply), and goal_to_plan reads the plan back off that decomposition.
let GPD_NAME = 0
let GPD_CAP  = 1
let GPD_SRC  = 2
let GPD_LIT  = 3

fn goal_plan_build(goal_name, step_descriptors, priority, now) {
    let engine = goal_engine_new()
    let root = goal_new(engine, goal_name, priority, 0, 1, now)
    let spec = goal_spec_new()
    let i = 0
    while i < len(step_descriptors) {
        let d = step_descriptors[i]
        let child = goal_new(engine, d[GPD_NAME], priority, 0, 1, now)
        goal_add_subgoal(engine, root, child)
        goal_spec_add(spec, goal_binding(d[GPD_CAP], d[GPD_SRC], d[GPD_LIT]))
        i = i + 1
    }
    let out = list_new()
    push(out, engine); push(out, root); push(out, spec)
    return out
}

fn goal_plan_engine(built) { return built[0] }
fn goal_plan_root(built)   { return built[1] }
fn goal_plan_spec(built)   { return built[2] }

// One-shot helper for the common case: build the goal + spec, bridge to a plan,
// execute it against `registry` with `approved`, and -- so the goal tree
// reflects the outcome -- mark each satisfied step's sub-goal complete and roll
// the root's progress up. Returns the plan_execute output [final, trace, ok].
//
// Progress wiring: plan_execute stops at the first failure, completing exactly
// ok_count steps; we set those leaves to satisfied (progress 1.0) and roll up,
// so a fully-successful plan satisfies the root goal (goal closes the loop).
fn goal_run(registry, goal_name, step_descriptors, priority, approved, now) {
    let built = goal_plan_build(goal_name, step_descriptors, priority, now)
    let engine = goal_plan_engine(built)
    let root = goal_plan_root(built)
    let plan = goal_to_plan(engine, root, goal_plan_spec(built))
    let out = plan_execute(registry, plan, approved)
    let done = plan_ok_count(out)
    let leaves = goal_leaves(engine, root)
    let i = 0
    while i < len(leaves) {
        if i < done { goal_set_progress(engine, leaves[i], 1000) }
        i = i + 1
    }
    goal_rollup_progress(engine, root)
    // Stash the engine/root on the output so the caller can inspect goal state.
    push(out, engine); push(out, root)
    return out
}

fn goal_run_engine(out) { return out[3] }
fn goal_run_root(out)   { return out[4] }
