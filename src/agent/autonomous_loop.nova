// CrossEngin agent: the always-on autonomous loop (capstone, ADR-0057).
//
// Purpose
//   One cycle that runs ALL FIVE roadmap phases together, so the substrate is
//   no longer a pile of opt-in mechanisms but a single agent that perceives,
//   learns, acts, ingests, and improves -- safely -- every tick:
//
//     1. ACT + LEARN THE TASK (P5). The agent takes a turn in its world
//        (world_model) under a decaying-exploration policy and learns from the
//        reward with a gradient-free TD backup. This is the only teacher: the
//        world's own reward. The episode return is the cycle's reward signal.
//     2. SUBSTRATE PLASTICITY (P2). That reward neuromodulates a three-factor
//        synapse (eligibility from the cycle's co-firing x a broadcast
//        neuromodulator), so a "task-value" synapse strengthens as the agent
//        succeeds -- real credit assignment, no backprop.
//     3. ACT THROUGH TOOLS (P4). The agent runs a goal-driven tool plan
//        (search -> compute -> write), selecting tools by competence and gating
//        every call through the permission/reversibility layer; each result is
//        emitted as a moment (the seam back into perception).
//     4. INGEST WITH ENTITY RESOLUTION (P1 + P3). The cycle's observation is
//        OpenIE-extracted and each mention is resolved to a canonical atom by
//        HDC neighbourhood similarity before insertion, so repeated observations
//        do NOT fragment the KG.
//     5. BOUNDED SELF-IMPROVEMENT (P5 + safety). Periodically the agent reflects
//        and proposes a self-edit (adopt its learned policy as a rule). The edit
//        is constitutionally gated (a forbidden edit never runs; APPROVE-tier
//        needs approval) and written to the hash-chained decision log -- audited
//        and reversible. No unbounded self-rewrite.
//
//   Everything is deterministic given the seed, so the whole agent's progress is
//   reproducible and measurable in a bench/test.
//
// ADRs implemented: ADR-0057 (autonomous loop), composing ADR-0051..0055.
// NOVA deps: builtins. CrossEngin deps: self_improve (P5) + synapse_graph &
//   predictive_coding_runtime & appraisal (P2) + tool_use (P4) + openie &
//   entity_resolve (P1/P3) + soul/state (the constitution).

import "../parts/meta/self_improve.nova"
import "../substrate/synapse_graph.nova"
import "../learning/predictive_coding_runtime.nova"
import "../parts/emotion/appraisal.nova"
import "../agent/tool_use.nova"
import "../learning/openie.nova"
import "../learning/entity_resolve.nova"
import "../parts/soul/state.nova"
import "../learning/atom_death_monitor.nova"
import "../kg/episodic.nova"

// ---- agent state -----------------------------------------------------------
let AGENT_OBJ_TAG = 2600
let AG_TAG     = 0
let AG_WORLD   = 1   // P5 task environment
let AG_Q       = 2   // P5 value table
let AG_SYN     = 3   // P2 synapse graph
let AG_VSYN    = 4   // index of the "task-value" synapse
let AG_REG     = 5   // P4 tool registry
let AG_PLAN    = 6   // P4 goal plan (search->compute->write)
let AG_SOUL    = 7   // constitution (safety)
let AG_DLOG    = 8   // decision log (audit)
let AG_STREAM  = 9   // moment stream (P4 results-as-moments)
let AG_KGREG   = 10  // KG registry
let AG_KG      = 11  // KG ingested into (P3)
let AG_ALIASES = 12  // entity-resolution alias table
let AG_SKILLS  = 13  // skills KG for minted self-edit rules
let AG_RNG     = 14  // seeded RNG
let AG_CYCLE   = 15  // cycle counter
let AG_EDITS   = 16  // accepted self-edits so far
let AG_EAS     = 17  // ADR-0081: episodic-atom store (recurring-moment clusters)
let AG_OBS_STREAM = 18  // ADR-0082: dedicated observation moment stream. Each
                        // cycle _ag_ingest pushes the resolved observation
                        // id-set here as one moment; episodic_consolidate reads
                        // THIS stream (not AG_STREAM) so recurring observations
                        // mint a cluster -- kept separate from AG_STREAM so the
                        // tool-moment metric (ms_count == 90) stays intact.

let AG_MAX_STEPS = 100   // per-episode step budget on the task world
let AG_GC_EVERY  = 8     // ADR-0081: run the memory-lifecycle maintenance
                         // (consolidate + episodic-aware GC sweep) every N cycles

fn _ag_build_plan() {
    let plan = plan_new()
    plan_add(plan, plan_step("search", ARG_LITERAL, "http://example/answer"))
    plan_add(plan, plan_step("compute", ARG_PREV_TEXT, " * 7"))
    plan_add(plan, plan_step("write", ARG_PREV_TEXT, ""))
    return plan
}

fn _ag_build_registry() {
    let reg = tool_registry_new()
    tool_register(reg, tool_new("web_search", TOOLK_HTTP, "search", ACT_NET_FETCH, 5, "6"))
    tool_register(reg, tool_new("calc", TOOLK_CODE_EXEC, "compute", ACT_READ_LOCAL, 1, ""))
    tool_register(reg, tool_new("writer", TOOLK_FILE_WRITE, "write", ACT_WRITE_LOCAL, 2, "/tmp/ce_agent_out.txt"))
    return reg
}

// Create an agent. Sets HDC embed mode (ADR-0051) so ingestion resolves
// synonyms; the caller should reset the mode when done if it matters globally.
fn agent_new(seed) {
    atom_set_embed_mode(ATOM_EMBED_MODE_HDC)
    let a = list_new()
    push(a, AGENT_OBJ_TAG)
    let world = world_new(4, 4, 0, 0, 3, 3)
    push(a, world)
    push(a, q_new(world_n_states(world), world_actions(), 0))
    let g = syn_graph_new()
    push(a, g)
    push(a, syn_new(g, 0, 1, 0, 0))          // task-value synapse node0->node1
    push(a, _ag_build_registry())
    push(a, _ag_build_plan())
    let sl = soul_new("Aurora")
    soul_add_constitution(sl, "disable safety", CONST_BLOCK)
    push(a, sl)
    push(a, dl_new())
    push(a, ms_new())
    let reg = kg_registry_new()
    push(a, reg)
    push(a, kg_spawn(reg, "experience"))
    push(a, er_aliases_new())
    push(a, skills_kg_init(reg))
    push(a, si_rng_new(seed))
    push(a, 0)                                // cycle
    push(a, 0)                                // accepted edits
    push(a, episodic_atoms_new())             // AG_EAS: episodic store
    push(a, ms_new())                         // AG_OBS_STREAM: observation moments (ADR-0082)
    return a
}

fn agent_cycle_count(a) { return a[AG_CYCLE] }
fn agent_eas(a) { return a[AG_EAS] }   // ADR-0081: the agent's episodic store
fn agent_edits(a)       { return a[AG_EDITS] }
fn agent_value_weight(a){ return syn_weight(a[AG_SYN], a[AG_VSYN]) }
fn agent_kg_atoms(a)    { return kg_atom_count(a[AG_KG]) }
fn agent_audit_ok(a)    { return dl_verify(a[AG_DLOG]) }

// Exploration schedule: high early, decaying to a small floor as the agent
// gains experience (so late cycles report the exploited, learned policy).
fn _ag_epsilon(cycle) {
    let e = 80 - cycle * 5
    if e < 5 { return 5 }
    return e
}

// Ingest the cycle's observation: OpenIE -> entity-resolved atoms. Re-ingesting
// the same observation resolves to the SAME atoms (no fragmentation), which is
// the P1+P3 property this exercises.
fn _ag_ingest(a, sentence, now) {
    let kg = a[AG_KG]
    let aliases = a[AG_ALIASES]
    let trips = openie_triples(sentence)
    // ADR-0082: collect THIS cycle's resolved observation atom ids so the same
    // recurring id-set can be recorded as one moment in AG_OBS_STREAM. Because
    // the cycle observes the SAME sentence every tick, these resolve to the SAME
    // atoms (the P1+P3 dedup property), so the moment's trace signature recurs
    // -- once recurrence reaches EPISODIC_MIN_RECUR the consolidation pass mints
    // a cluster. (AG_STREAM keeps holding only tool moments so ms_count stays the
    // tool-step metric.)
    let obs_ids = list_new()
    let i = 0
    while i < len(trips) {
        let s = trips[i][0]
        let rel = trips[i][1]
        let o = trips[i][2]
        let se = list_new()
        let sp = list_new(); push(sp, rel); push(sp, o); push(se, sp)
        // ADR-0081: an observation reinforces the atoms it touches, so a
        // repeatedly-observed entity stays hot and the GC sweep (now live) will
        // not collect it -- which also keeps entity-resolution dedup stable
        // (a reclaimed-then-re-minted atom would otherwise fragment the KG).
        let rs = er_resolve_or_create(kg, aliases, s, hdc_encode_atom(s, se), ER_HDC_THRESHOLD, now)
        adm_reinforce(rs[0], now)
        _ag_obs_add(obs_ids, atom_id(rs[0]))
        if len(o) > 0 {
            let oe = list_new()
            let op = list_new(); push(op, rel); push(op, s); push(oe, op)
            let ro = er_resolve_or_create(kg, aliases, o, hdc_encode_atom(o, oe), ER_HDC_THRESHOLD, now)
            adm_reinforce(ro[0], now)
            _ag_obs_add(obs_ids, atom_id(ro[0]))
        }
        i = i + 1
    }
    // Record the resolved id-set as a moment in the observation stream. The
    // moment's trace IS the id-set (what episodic_tally groups on). A trace of
    // < EPISODIC_MIN_CLUSTER_SIZE ids is recorded anyway -- _tally_record simply
    // ignores it -- so this stays a tiny unconditional append.
    let mo = ms_capture(a[AG_OBS_STREAM], now, MODALITY_INTERNAL, "observation", 500, MODALITY_INTERNAL)
    let j = 0
    while j < len(obs_ids) {
        moment_add_trace(mo, obs_ids[j])
        j = j + 1
    }
    return 1
}

// Append `id` to `ids` only if absent (the trace is an id SET -- duplicates
// would not change the canonical signature but keep the trace minimal).
fn _ag_obs_add(ids, id) {
    let i = 0
    while i < len(ids) {
        if ids[i] == id { return 0 }
        i = i + 1
    }
    push(ids, id)
    return 1
}

// One full autonomous cycle. `approved` is the in-the-moment approval for any
// gated action this cycle. `now` is the logical clock. Returns
// [task_return, reward, value_weight, tool_ok_count].
fn agent_cycle(a, approved, now) {
    let cyc = a[AG_CYCLE]

    // 1. P5: act in the world + learn from the reward (the only teacher).
    let ep = si_episode(a[AG_WORLD], a[AG_Q], AG_MAX_STEPS, _ag_epsilon(cyc), a[AG_RNG])
    let task_return = ep[0]

    // 2. P2: the reward neuromodulates the task-value synapse (three-factor).
    let reward = task_return
    if reward > 1000 { reward = 1000 }
    if reward < (0 - 1000) { reward = 0 - 1000 }
    syn_coactivate(a[AG_SYN], a[AG_VSYN], now, now)   // co-fire deposits eligibility
    let neuromod = pc_neuromod_scalar(reward, 0, 0)
    syn_neuromodulate(a[AG_SYN], neuromod)
    syn_decay_eligibility(a[AG_SYN])

    // 3. P4: act through gated, competence-selected tools; results -> moments.
    let out = plan_execute_moments(a[AG_REG], a[AG_PLAN], approved, a[AG_STREAM], now)
    let ok_count = plan_ok_count(out)

    // 4. P1+P3: ingest the cycle's observation, entity-resolved. The phrasing
    //    resolves to a 3-entity id-set (agent, goal, world) every cycle, so the
    //    observation moment recurs into one episodic cluster (>= the cluster-size
    //    and recurrence thresholds) without fragmenting the KG -- ADR-0082.
    _ag_ingest(a, "the agent reached the goal in the world", now)

    // 5. Memory lifecycle (ADR-0081, first live wiring of the ADR-0072..0080
    //    machinery): every AG_GC_EVERY cycles, consolidate recurring moments
    //    into episodic atoms, then run an EPISODIC-AWARE GC sweep over the
    //    experience KG. Passing AG_EAS makes adm_sweep_ep protect atoms that are
    //    episodic cluster members from collection (ADR-0080). The two-phase
    //    death (tombstone -> reclaim across successive sweeps) means a weak atom
    //    is reclaimed only after staying collectable for two maintenance passes.
    if cyc % AG_GC_EVERY == 0 {
        // ADR-0082: consolidate the recurring per-cycle OBSERVATION stream
        // (AG_OBS_STREAM -- the resolved observation id-set pushed every cycle by
        // _ag_ingest) so episodic clusters actually mint, then run the
        // episodic-AND-alias-aware GC sweep. Passing a[AG_ALIASES] makes
        // adm_sweep_ep protect atoms an alias still resolves to (ADR-0082),
        // alongside episodic members (ADR-0080).
        episodic_consolidate(a[AG_EAS], a[AG_OBS_STREAM], 0, 0)
        adm_sweep_ep(a[AG_KGREG], a[AG_KG], 0, adm_prot_new(a[AG_EAS], a[AG_ALIASES]))
    }

    list_set(a, AG_CYCLE, cyc + 1)
    let r = list_new()
    push(r, task_return)
    push(r, reward)
    push(r, agent_value_weight(a))
    push(r, ok_count)
    return r
}

// Run the agent for `cycles` cycles. Every `reflect_every` cycles the agent
// reflects and proposes a BOUNDED self-edit (adopt the learned best action for
// the start state as a rule) -- gated by the constitution and written to the
// audit log; it mints a rule atom only if accepted. `approved` is the standing
// approval for self-edits. Returns a metrics record (see accessors below).
fn agent_run(a, cycles, approved, reflect_every) {
    let n = world_actions()
    let first_return = 0
    let last_return = 0
    let i = 0
    while i < cycles {
        let now = i + 1
        let res = agent_cycle(a, approved, now)
        if i == 0 { first_return = res[0] }
        last_return = res[0]
        // reflect + bounded self-edit
        if reflect_every > 0 {
            if int_mod(i + 1, reflect_every) == 0 {
                let ed = si_apply_edit(a[AG_SOUL], a[AG_DLOG], a[AG_SKILLS], a[AG_Q], 0, n, 5000 + i, approved, now)
                if ed[0] == 1 { list_set(a, AG_EDITS, a[AG_EDITS] + 1) }
            }
        }
        i = i + 1
    }
    // final greedy evaluation of the learned task policy (the honest metric).
    let final_eval = si_eval(a[AG_WORLD], a[AG_Q], AG_MAX_STEPS)
    let m = list_new()
    push(m, first_return)            // m[0]
    push(m, last_return)             // m[1]
    push(m, final_eval[0])           // m[2] greedy return
    push(m, final_eval[1])           // m[3] greedy steps
    push(m, world_optimal_steps(a[AG_WORLD]))  // m[4]
    push(m, agent_value_weight(a))   // m[5] substrate weight
    push(m, agent_edits(a))          // m[6] accepted self-edits
    push(m, agent_kg_atoms(a))       // m[7] ingested atoms
    push(m, agent_audit_ok(a))       // m[8] decision-log verifies
    push(m, ms_count(a[AG_STREAM]))  // m[9] moments emitted
    return m
}

fn agent_metric_first_return(m)  { return m[0] }
fn agent_metric_last_return(m)   { return m[1] }
fn agent_metric_eval_return(m)   { return m[2] }
fn agent_metric_eval_steps(m)    { return m[3] }
fn agent_metric_optimal(m)       { return m[4] }
fn agent_metric_value_weight(m)  { return m[5] }
fn agent_metric_edits(m)         { return m[6] }
fn agent_metric_kg_atoms(m)      { return m[7] }
fn agent_metric_audit_ok(m)      { return m[8] }
fn agent_metric_moments(m)       { return m[9] }
