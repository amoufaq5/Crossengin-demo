// CrossEngin agent: perception loop.
//
// Purpose
//   The perception loop (ADR-0036): consume an input utterance, run it through
//   the five-stage reader (ADR-0011/0012), and write the resulting percept --
//   the settled active concept handles, the symbolic route targets, and the
//   count of unknown tokens (a learning signal) -- onto the shared blackboard
//   for the downstream loops. No LLM (ADR-0014).
//
// ADRs implemented: ADR-0036 (perception loop). NOVA dependencies: builtins.
// CrossEngin dependencies: src/agent/loop_coordination.nova, src/reader/reader.nova.

import "loop_coordination.nova"
import "../reader/reader.nova"

// Run one perception step over ctx.input using the reader environment `renv`.
// Writes percept / active / routes / unknown into the context. Returns the
// number of matched tokens.
fn loop_perception_step(ctx, renv) {
    let c = reader_read(renv, ctx_input(ctx), list_new())
    ctx_set_percept(ctx, rctx_active(c))
    ctx_set_active(ctx, rctx_active(c))
    ctx_set_routes(ctx, rctx_routes(c))
    ctx_set_unknown(ctx, reader_unknown(c))
    return reader_matched(c)
}
