// CrossEngin agent: perception loop.
//
// Purpose
//   The perception loop (ADR-0036): consume an input utterance, run it through
//   the five-stage reader (ADR-0011/0012), and write the resulting percept --
//   the settled active concept handles, the symbolic route targets, and the
//   count of unknown tokens (a learning signal) -- onto the shared blackboard
//   for the downstream loops. No LLM (ADR-0014).
//
//   Since Phase N R1 (ADR-0092), the inline reader delegation has moved into
//   `src/parts/perception/perception_module.nova` -- the module composes
//   `classify_input` + `reader_read` + optional sensor fusion into a
//   first-class `Percept` record. This file keeps the 2-arg
//   `loop_perception_step(ctx, renv)` signature so the two examples binaries
//   (`crossengin_chat.nova`, `crossengin_daemon.nova`) and the existing
//   `test_loop_perception.nova` unit test are byte-untouched; internally it
//   routes through a module-level singleton that lazy-inits from the passed
//   `renv`. Behavior-preservation contract (asserted in
//   `tests/unit/test_perception_module.nova`): the four ctx slots
//   (`percept`, `active`, `routes`, `unknown`) end up byte-identical to the
//   pre-Phase-N reader-only path.
//
// ADRs implemented: ADR-0036 (perception loop), ADR-0092 (perception module).
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/agent/loop_coordination.nova,
//   src/reader/reader.nova, src/parts/perception/perception_module.nova.

import "loop_coordination.nova"
import "../reader/reader.nova"
import "../parts/perception/perception_module.nova"

// Run one perception step over ctx.input using the reader environment `renv`.
// Writes percept / active / routes / unknown into the context. Returns the
// number of matched tokens.
//
// Post-Phase-N-R1: delegates to `perception_step_text` via a module-level
// singleton keyed on `renv`. The reader still runs once per call (inside
// `perception_step_text`), so the return value continues to be the
// reader's own matched-token count. The Percept minted alongside is
// cached on the singleton for R2 (parts/action) to consume via
// `pm_last_percept`.
fn loop_perception_step(ctx, renv) {
    let pm = perception_module_singleton_for(renv)
    // `perception_step_text` runs the reader ONCE, writes the four ctx
    // slots byte-identically to the pre-Phase-N inline path, caches
    // the Percept for R2 (parts/action) via `pm_last_percept`, AND
    // caches the reader's `matched` scalar via `PM_LAST_MATCHED` so
    // this shim can return it without a second reader_read. See
    // ADR-0092 for the behavior-preservation contract.
    let _percept = perception_step_text(pm, ctx, ctx_input(ctx), ctx_tick(ctx))
    return pm_last_matched(pm)
}
