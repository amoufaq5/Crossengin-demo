// CrossEngin agent: emotion loop.
//
// Purpose
//   The emotion loop (ADR-0036): appraise the cycle's OCC inputs (desirability
//   vs goals, praiseworthiness vs values, appealingness), condition the result
//   by the soul's OCEAN personality (ADR-0035), and write the resulting mood
//   onto the blackboard and into the soul's fast state. The arousal it produces
//   is the plasticity modulator the substrate tick should use.
//
// ADRs implemented: ADR-0036 (emotion loop), ADR-0035 (appraisal/conditioning).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/agent/loop_coordination.nova, src/parts/emotion/appraisal.nova,
//   src/parts/emotion/ocean_conditioning.nova, src/parts/soul/state.nova.

import "loop_coordination.nova"
import "../parts/emotion/appraisal.nova"
import "../parts/emotion/ocean_conditioning.nova"
import "../parts/soul/state.nova"

// Appraise + condition + write mood. Returns the conditioned valence.
fn loop_emotion_step(ctx, sl, desirability, praise, appeal) {
    let r = emotion_appraise(desirability, praise, appeal)
    let cond = emotion_condition(soul_openness(sl), soul_conscientiousness(sl),
        soul_extraversion(sl), soul_agreeableness(sl), soul_neuroticism(sl),
        appraisal_valence(r), appraisal_arousal(r))
    ctx_set_mood(ctx, conditioned_valence(cond), conditioned_arousal(cond))
    soul_update_mood(sl, conditioned_valence(cond), conditioned_arousal(cond))
    return conditioned_valence(cond)
}
