// Formal-axiom ingest from the chat turn loop (ADR-0088 path (a), the live
// seam). A fetched web page cannot supply a derivation, so the empirical track
// (govern_fetched_atom) handles those. But an AXIOM is itself a valid leaf
// proof, and a user (or a curated math source) asserting a foundational axiom
// is exactly the "source supplied a derivation we re-check" path: the kernel
// checks that the asserted claim is a legal AXIOM leaf, and on success pins it
// FORMAL, registers it for periodic re-checking, and audits the promotion.
//
// This is the producer that makes the full FORMAL machinery LIVE in the chat:
//   /axiom <label>  -> fc_assert_axiom -> lp_ingest_formal
//                        -> license gate (user-taught = OWNER, clean)
//                        -> verify_pin_atom (the kernel; only writer of FORMAL)
//                        -> fi auto-registers it for the periodic re-check sweep
//                        -> promo/lp audit records the promotion
// Theorems DERIVED from those axioms (MP / AND over them) are the next seam;
// this lands the foundational leaves so the cadence sweeps + cascade have real
// FORMAL atoms to protect.
//
// The registries are held in module handles (the wired-or-not idiom of the
// audit hooks) so the admin command -- which already has the active KG in
// scope -- does not have to thread proofs_reg / rck through the big _try_admin
// signature. fc_boot wires them once.
//
// ADRs implemented: ADR-0088 (formal ingest live seam). CrossEngin
// dependencies: src/learning/formal_ingest.nova (the gated FORMAL pin +
// re-check auto-register), src/kg/multi_kg_manager.nova (atom mint/find).

import "../learning/formal_ingest.nova"
import "../kg/multi_kg_manager.nova"
import "../mind/proof_serial.nova"
import "../mind/search.nova"

// ---- module handles --------------------------------------------------------
let _fc_proofs_handle = list_new()

// The formal environment: a list of [label, term, proof_code, atom] entries,
// one per asserted-or-derived FORMAL proposition. This is what lets DERIVED
// theorems reference their premises -- /prove looks a premise up by label to
// get its term + proof code, then builds a HYP step that rests on it. Held in a
// handle so the boot reset (fc_boot) clears it.
let _fc_env_handle = list_new()

// ADR-0043 audit honesty for belief revision: every fc_retract_with call
// appends a record here so the session has a permanent history of what got
// dropped. Retracting a FORMAL belief is a big deal; leaving no trace would be
// an audit gap. Session-scoped (fc_boot resets it); persistence across sessions
// is a separate concern.
let _fc_retraction_log_handle = list_new()

// Wire the proof registry + re-check registry once at chat boot. Also wires the
// re-check registry into the ingest path (fi_set_recheck_registry) so a pinned
// axiom is auto-registered for the periodic sweep, and resets the environment
// and the retraction log.
fn fc_boot(proofs_reg, rck) {
    if len(_fc_proofs_handle) == 0 { push(_fc_proofs_handle, proofs_reg) }
    else { list_set(_fc_proofs_handle, 0, proofs_reg) }
    if len(_fc_env_handle) == 0 { push(_fc_env_handle, list_new()) }
    else { list_set(_fc_env_handle, 0, list_new()) }
    if len(_fc_retraction_log_handle) == 0 { push(_fc_retraction_log_handle, list_new()) }
    else { list_set(_fc_retraction_log_handle, 0, list_new()) }
    fi_set_recheck_registry(rck)
    return 1
}

fn _fc_proofs() {
    if len(_fc_proofs_handle) == 0 { return 0 }
    return _fc_proofs_handle[0]
}

fn _fc_env() {
    if len(_fc_env_handle) == 0 { return 0 }
    return _fc_env_handle[0]
}

// Label equality without str_eq (launcher-flaky): char-by-char.
fn _fc_label_eq(a, b) {
    let n = len(a)
    if n != len(b) { return 0 }
    let i = 0
    while i < n {
        if char_at(a, i) != char_at(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Record (or replace) a FORMAL proposition in the environment. The entry also
// carries the verification packet (pkt) and the source label so the derivation
// can be re-serialized for cross-session persistence (fc_snapshot) and re-run on
// restore. (6 params -- at NOVA's passing limit; the pkt already bundles the
// axioms/proof/claim, so we don't exceed it.)
fn _fc_env_put(label, term, proof_code, atom, pkt, src) {
    let env = _fc_env()
    if env == 0 { return 0 }
    let i = 0
    while i < len(env) {
        if _fc_label_eq(env[i][0], label) == 1 {
            list_set(env[i], 1, term)
            list_set(env[i], 2, proof_code)
            list_set(env[i], 3, atom)
            list_set(env[i], 4, pkt)
            list_set(env[i], 5, src)
            return 1
        }
        i = i + 1
    }
    let e = list_new()
    push(e, label) push(e, term) push(e, proof_code) push(e, atom)
    push(e, pkt) push(e, src)
    push(env, e)
    return 1
}

// Look up a FORMAL proposition by label -> [label, term, proof_code, atom], or
// 0 if absent.
fn _fc_env_get(label) {
    let env = _fc_env()
    if env == 0 { return 0 }
    let i = 0
    while i < len(env) {
        if _fc_label_eq(env[i][0], label) == 1 { return env[i] }
        i = i + 1
    }
    return 0
}

fn _fc_env_term(e)  { return e[1] }
fn _fc_env_code(e)  { return e[2] }
fn _fc_env_atom(e)  { return e[3] }
fn _fc_env_pkt(e)   { return e[4] }
fn _fc_env_src(e)   { return e[5] }

fn fc_is_booted() {
    if _fc_proofs() == 0 { return 0 }
    return 1
}

// ---- the axiom-ingest helper (runtime-tested) ------------------------------
//
// Assert `label` as a FORMAL axiom in `kg`. Mints the atom if absent. Builds the
// trivial leaf proof (AXIOM rule against a one-term axiom table) and runs it
// through lp_ingest_formal -- so the license gate (src_label) and the kernel
// both apply, and the pin auto-registers for re-check. Returns [state, atom];
// state is CAND_PROMOTED on success, CAND_QUARANTINED if the source is unclean,
// CAND_CANDIDATE if the kernel somehow rejects (cannot happen for a well-formed
// axiom leaf, but handled for completeness). Requires fc_boot first; returns
// [CAND_CANDIDATE, 0] if not booted.
fn fc_assert_axiom(kg, label, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0)
        return r
    }
    let atom = kg_find_atom(kg, label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, label, 0) }
    let p = term_atom(label)
    let axioms = axiom_table_new()
    axiom_table_add(axioms, p)
    let pkt = verify_packet(axioms, hyp_new(), pf_axiom(p), p, label,
                            "axiom:" + label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(label, p, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new()
    push(r, state) push(r, atom)
    return r
}

fn fc_state(r) { return r[0] }
fn fc_atom(r)  { return r[1] }

// ---- first-order quantifiers at the seam (increment 17) --------------------
//
// A "universal law" axiom: forall x.(P1(x) -> P2(x)) -- the classic major
// premise (e.g. "all humans are mortal"). Asserted FORMAL via the kernel like
// any axiom; stored in the env so a syllogism can instantiate it.
fn fc_assert_forall_imp(kg, label, pred1, pred2) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let body = term_imp(term_pred(pred1, term_var("x")),
                        term_pred(pred2, term_var("x")))
    let law = term_forall("x", body)
    let atom = kg_find_atom(kg, label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, label, 0) }
    let axs = axiom_table_new()
    axiom_table_add(axs, law)
    let pkt = verify_packet(axs, hyp_new(), pf_axiom(law), law, label,
                            "forall:" + label)
    let state = lp_ingest_formal(atom, proofs, "user-taught", pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(label, law, atom_proof_ref(atom), atom, pkt, "user-taught")
    }
    let r = list_new() push(r, state) push(r, atom) return r
}

// A ground predicate fact: P(const), e.g. human(socrates). Asserted FORMAL.
fn fc_assert_pred(kg, label, pred, const_name) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let fact = term_pred(pred, term_atom(const_name))
    let atom = kg_find_atom(kg, label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, label, 0) }
    let axs = axiom_table_new()
    axiom_table_add(axs, fact)
    let pkt = verify_packet(axs, hyp_new(), pf_axiom(fact), fact, label,
                            "fact:" + label)
    let state = lp_ingest_formal(atom, proofs, "user-taught", pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(label, fact, atom_proof_ref(atom), atom, pkt, "user-taught")
    }
    let r = list_new() push(r, state) push(r, atom) return r
}

// The full syllogism in one step: from a FORMAL universal law `forall_label`
// (forall x.(P(x)->Q(x))) and a FORMAL fact `fact_label` (P(c)), derive
// `concl_label` = Q(c) -- universal instantiation at c, then modus ponens.
// REJECTED if the law isn't a universal implication, the fact isn't a closed
// predicate, or the fact doesn't match the law's antecedent at c. Returns
// [state, atom].
fn fc_prove_syllogism(kg, concl_label, forall_label, fact_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let fe = _fc_env_get(forall_label)
    let facte = _fc_env_get(fact_label)
    if fe == 0    { let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r }
    if facte == 0 { let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r }
    let law = _fc_env_term(fe)
    let fact = _fc_env_term(facte)
    if term_kind(law) != TERM_FORALL {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_kind(fact) != TERM_PRED {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let var = law[1]
    let body = law[2]                 // P(x) -> Q(x)
    let const_term = fact[2]          // the constant the fact is about
    // instantiate the law at the fact's constant.
    let inst = _subst(body, var, const_term)   // P(c) -> Q(c)
    if term_kind(inst) != TERM_IMP {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    // the law's instantiated antecedent must be exactly the fact.
    if term_eq(inst[1], fact) == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let result = inst[2]              // Q(c)
    // proof: MP( UI(law @ c) , fact ).
    let hyps = hyp_new()
    hyp_add(hyps, forall_label, law, _fc_env_code(fe))
    hyp_add(hyps, fact_label, fact, _fc_env_code(facte))
    let ui = pf_ui(inst, pf_hyp(law, forall_label), const_term)
    let proof = pf_mp(result, ui, pf_hyp(fact, fact_label))
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyps, proof, result, concl_label,
                            "syllogism:" + forall_label + "," + fact_label)
    let state = lp_ingest_formal(atom, proofs, "user-taught", pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, result, atom_proof_ref(atom), atom, pkt, "user-taught")
    }
    let r = list_new() push(r, state) push(r, atom) return r
}

// Arithmetic operator selector for fc_prove_arith.
let FC_OP_ADD = 0
let FC_OP_MUL = 1
let FC_OP_SUB = 2
let FC_OP_DIV = 3

// ---- bounded proof search over the formal env (increment 18) ----------------
// Collect the constant atoms appearing as predicate arguments in the env, so the
// search can instantiate universal laws at them. Deduped by label.
fn _fc_collect_consts(extra_label) {
    let consts = list_new()
    push(consts, term_atom(extra_label))   // always include the goal's subject
    let env = _fc_env()
    if env == 0 { return consts }
    let i = 0
    while i < len(env) {
        let t = _fc_env_term(env[i])
        if term_kind(t) == TERM_PRED {
            let arg = t[2]
            if term_kind(arg) == TERM_ATOM {
                let seen = 0
                let j = 0
                while j < len(consts) {
                    if _fc_label_eq(consts[j][1], arg[1]) == 1 { seen = 1 }
                    j = j + 1
                }
                if seen == 0 { push(consts, arg) }
            }
        }
        i = i + 1
    }
    return consts
}

// Can the engine DERIVE goal_pred(goal_const) from everything currently in the
// formal env? Runs bounded proof search over the env's FORMAL propositions as
// premises and kernel-verifies whatever it finds. Returns 1 iff a kernel-checked
// derivation exists within budget -- the auto-prover answer to "does this
// follow from what I know?". Sound: a 0 is "not found within budget", never a
// false claim (search.search_prove_ok gates on the kernel).
fn fc_can_derive(goal_pred, goal_const) {
    let env = _fc_env()
    if env == 0 { return 0 }
    let premises = list_new()
    let i = 0
    while i < len(env) {
        push(premises, _fc_env_term(env[i]))
        i = i + 1
    }
    let consts = _fc_collect_consts(goal_const)
    let goal = term_pred(goal_pred, term_atom(goal_const))
    let reg = proof_registry_new()
    return search_prove_ok(reg, premises, consts, goal, 8)
}

// Prove a ground arithmetic equality and pin it FORMAL: `a op b = c`. The kernel
// DECIDES it by recomputation (EVAL), so a false equality (e.g. 3+3=7) is
// refused -- fc_prove_arith returns the kernel's CAND_CANDIDATE for it, not
// PROMOTED. `concl_label` names the resulting theorem atom. Returns [state,atom].
// This is the "2+2=4 with a checkable proof" of ADR-0093 at the chat seam.
fn fc_prove_arith(kg, concl_label, a, op, b, c) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let lhs = term_add(term_num(a), term_num(b))
    if op == FC_OP_MUL { lhs = term_mul(term_num(a), term_num(b)) }
    if op == FC_OP_SUB { lhs = term_sub(term_num(a), term_num(b)) }
    if op == FC_OP_DIV { lhs = term_div(term_num(a), term_num(b)) }
    let claim = term_equals(lhs, term_num(c))
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyp_new(), pf_eval(claim), claim,
                            concl_label, "calc:" + concl_label)
    let state = lp_ingest_formal(atom, proofs, "user-taught", pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, claim, atom_proof_ref(atom), atom, pkt, "user-taught")
    }
    let r = list_new() push(r, state) push(r, atom)
    return r
}

// Side selector for conjunction elimination.
let FC_AND_LEFT  = 0
let FC_AND_RIGHT = 1

// Derive a CONJUNCTION by and-introduction: from FORMAL `left_label` and FORMAL
// `right_label`, derive `concl_label` asserting (left AND right). The new
// theorem's term is the conjunction (so it can later be eliminated); its name
// is user-chosen (a conjunction has no canonical atom label). Dep edges run
// from BOTH conjuncts to the conjunction, so withdrawing either withdraws it.
// Returns [state, atom]; REJECTED if a conjunct is unknown.
fn fc_prove_and(kg, concl_label, left_label, right_label, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let le = _fc_env_get(left_label)
    let re = _fc_env_get(right_label)
    if le == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if re == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let lt = _fc_env_term(le)
    let rt = _fc_env_term(re)
    let concl_term = term_and(lt, rt)
    let hyps = hyp_new()
    hyp_add(hyps, left_label, lt, _fc_env_code(le))
    hyp_add(hyps, right_label, rt, _fc_env_code(re))
    let proof = pf_and_i(concl_term, pf_hyp(lt, left_label),
                         pf_hyp(rt, right_label))
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyps, proof, concl_term,
                            concl_label, "and:" + left_label + "," + right_label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, concl_term, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new() push(r, state) push(r, atom)
    return r
}

// Derive a conjunct by and-elimination: from a FORMAL conjunction `conj_label`
// (= L AND R), derive its left (FC_AND_LEFT) or right (FC_AND_RIGHT) part as
// `concl_label`. v1 eliminates to a NAMED ATOM, so concl_label must match the
// eliminated part (term_atom(concl_label) == that conjunct); a compound conjunct
// is REJECTED here (its own name would be needed). The dep edge runs from the
// conjunction to the recovered conjunct. Returns [state, atom].
fn fc_prove_and_elim(kg, concl_label, conj_label, side, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let ce = _fc_env_get(conj_label)
    if ce == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let conj_term = _fc_env_term(ce)
    if term_kind(conj_term) != TERM_AND {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let target = conj_term[1]
    if side == FC_AND_RIGHT { target = conj_term[2] }
    let concl_term = term_atom(concl_label)
    if term_eq(target, concl_term) == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let hyps = hyp_new()
    hyp_add(hyps, conj_label, conj_term, _fc_env_code(ce))
    let proof = 0
    if side == FC_AND_RIGHT {
        proof = pf_and_er(concl_term, pf_hyp(conj_term, conj_label))
    } else {
        proof = pf_and_el(concl_term, pf_hyp(conj_term, conj_label))
    }
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyps, proof, concl_term,
                            concl_label, "andE:" + conj_label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, concl_term, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new() push(r, state) push(r, atom)
    return r
}

// Assert an IMPLICATION axiom: `label` asserts the proposition
// (ante_label -> conseq_label). Like fc_assert_axiom but the proposition is an
// IMP term, so it can serve as the major premise of a /prove MP step. Returns
// [state, atom].
fn fc_assert_imp(kg, label, ante_label, conseq_label, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let imp = term_imp(term_atom(ante_label), term_atom(conseq_label))
    let atom = kg_find_atom(kg, label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, label, 0) }
    let axioms = axiom_table_new()
    axiom_table_add(axioms, imp)
    let pkt = verify_packet(axioms, hyp_new(), pf_axiom(imp), imp, label,
                            "imp:" + label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(label, imp, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new()
    push(r, state) push(r, atom)
    return r
}

// Derive a THEOREM by modus ponens: from a FORMAL implication `imp_label`
// (asserting ante -> concl) and a FORMAL `ante_label` (asserting ante), derive
// `concl_label`. The proof rests on two HYP steps -- one per premise -- so the
// kernel records dependency edges from BOTH premises to the new theorem; later
// invalidating either premise cascades a withdrawal of the theorem, and the
// periodic sweep re-checks it. Returns [state, atom]:
//   CAND_PROMOTED on a verified derivation,
//   CAND_REJECTED if a premise is unknown or the implication's shape does not
//                 match ante -> concl (an ill-formed request, not a license/
//                 kernel failure),
//   the lp_ingest_formal state otherwise (e.g. QUARANTINED on an unclean src).
fn fc_prove_mp(kg, concl_label, imp_label, ante_label, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let imp_e = _fc_env_get(imp_label)
    let ante_e = _fc_env_get(ante_label)
    if imp_e == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if ante_e == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let imp_term = _fc_env_term(imp_e)
    let ante_term = _fc_env_term(ante_e)
    let concl_term = term_atom(concl_label)
    // Shape guard: the implication must literally be (ante -> concl). The kernel
    // would reject a mismatch anyway, but checking here lets us report REJECTED
    // (ill-formed request) distinctly from a kernel failure.
    if term_kind(imp_term) != TERM_IMP {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_eq(imp_term[1], ante_term) == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_eq(imp_term[2], concl_term) == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    // Build the MP derivation: HYP on the implication, HYP on the antecedent.
    let hyps = hyp_new()
    hyp_add(hyps, imp_label, imp_term, _fc_env_code(imp_e))
    hyp_add(hyps, ante_label, ante_term, _fc_env_code(ante_e))
    let proof = pf_mp(concl_term, pf_hyp(imp_term, imp_label),
                      pf_hyp(ante_term, ante_label))
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyps, proof, concl_term,
                            concl_label, "mp:" + imp_label + "," + ante_label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, concl_term, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new()
    push(r, state) push(r, atom)
    return r
}

// Hypothetical syllogism: from FORMAL implications `ab_label` (= A -> B) and
// `bc_label` (= B -> C), derive `concl_label` asserting (A -> C). Composes two
// implications into one; dep edges from both. REJECTED if a premise is unknown,
// not an implication, or the middle terms don't match. Returns [state, atom].
fn fc_prove_hs(kg, concl_label, ab_label, bc_label, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let abe = _fc_env_get(ab_label)
    let bce = _fc_env_get(bc_label)
    if abe == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if bce == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let ab = _fc_env_term(abe)
    let bc = _fc_env_term(bce)
    if term_kind(ab) != TERM_IMP {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_kind(bc) != TERM_IMP {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_eq(ab[2], bc[1]) == 0 {     // middle term B must match
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let concl_term = term_imp(ab[1], bc[2])
    let hyps = hyp_new()
    hyp_add(hyps, ab_label, ab, _fc_env_code(abe))
    hyp_add(hyps, bc_label, bc, _fc_env_code(bce))
    let proof = pf_hs(concl_term, pf_hyp(ab, ab_label), pf_hyp(bc, bc_label))
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyps, proof, concl_term,
                            concl_label, "hs:" + ab_label + "," + bc_label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, concl_term, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new() push(r, state) push(r, atom)
    return r
}

// Biconditional introduction: from FORMAL implications `ab_label` (= A -> B) and
// `ba_label` (= B -> A), derive `concl_label` asserting (A iff B). dep edges
// from both. REJECTED if a premise is unknown, not an implication, or the two
// directions don't mirror (ab = A->B requires ba = B->A). Returns [state, atom].
fn fc_prove_iff(kg, concl_label, ab_label, ba_label, src_label) {
    let proofs = _fc_proofs()
    if proofs == 0 {
        let r = list_new() push(r, CAND_CANDIDATE) push(r, 0) return r
    }
    let abe = _fc_env_get(ab_label)
    let bae = _fc_env_get(ba_label)
    if abe == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if bae == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let ab = _fc_env_term(abe)
    let ba = _fc_env_term(bae)
    if term_kind(ab) != TERM_IMP {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_kind(ba) != TERM_IMP {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    // ab = A->B, ba must be B->A: ab[1]==ba[2] and ab[2]==ba[1].
    if term_eq(ab[1], ba[2]) == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    if term_eq(ab[2], ba[1]) == 0 {
        let r = list_new() push(r, CAND_REJECTED) push(r, 0) return r
    }
    let concl_term = term_iff(ab[1], ab[2])
    let hyps = hyp_new()
    hyp_add(hyps, ab_label, ab, _fc_env_code(abe))
    hyp_add(hyps, ba_label, ba, _fc_env_code(bae))
    let proof = pf_iff_i(concl_term, pf_hyp(ab, ab_label), pf_hyp(ba, ba_label))
    let atom = kg_find_atom(kg, concl_label)
    if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, concl_label, 0) }
    let pkt = verify_packet(axiom_table_new(), hyps, proof, concl_term,
                            concl_label, "iff:" + ab_label + "," + ba_label)
    let state = lp_ingest_formal(atom, proofs, src_label, pkt)
    if state == CAND_PROMOTED {
        _fc_env_put(concl_label, concl_term, atom_proof_ref(atom), atom, pkt, src_label)
    }
    let r = list_new() push(r, state) push(r, atom)
    return r
}

// ---- cross-session persistence (ADR-0088 durability) -----------------------
//
// fc_snapshot serializes the whole formal environment -- every asserted axiom
// and derived theorem, in assertion order -- as the DERIVATIONS that produced
// them (label, source, claim term, axiom table, proof tree). fc_restore parses
// that back and RE-RUNS THE KERNEL on each in order, re-earning every FORMAL
// grade from verified ground (a tampered persisted proof simply fails to
// re-verify and is not re-pinned). Restoring in assertion order means a derived
// theorem's HYP premises are already back in the env when its turn comes; we
// hand each restore the full env-so-far as available hypotheses.

// Build a hyp context from every proposition currently in the env, so a
// restored proof's HYP(label) steps resolve (extra entries are harmless --
// _hyp_lookup is by label).
fn _fc_all_hyps() {
    let hyps = hyp_new()
    let env = _fc_env()
    if env == 0 { return hyps }
    let i = 0
    while i < len(env) {
        let e = env[i]
        hyp_add(hyps, e[0], _fc_env_term(e), _fc_env_code(e))
        i = i + 1
    }
    return hyps
}

// Serialize the formal environment to a string (label, src, claim, axioms,
// proof per entry, preceded by the count). Empty if nothing was asserted.
fn fc_snapshot() {
    let env = _fc_env()
    let out = list_new()
    if env == 0 { push(out, "0") return _ps_join(out) }
    push(out, int_to_str(len(env)))
    let i = 0
    while i < len(env) {
        let e = env[i]
        let pkt = _fc_env_pkt(e)
        push(out, e[0])                       // label
        push(out, _fc_env_src(e))             // source label
        term_ser(out, pkt[VPKT_TERM])         // claim term
        term_list_ser(out, pkt[VPKT_AXIOMS])  // axiom table
        proof_ser(out, pkt[VPKT_PROOF])       // proof tree
        i = i + 1
    }
    return _ps_join(out)
}

// Restore a formal environment from an fc_snapshot string into `kg`. Re-runs the
// kernel on each derivation in order (re-verifying, not trusting). Returns the
// count re-pinned. Requires fc_boot first (a fresh proofs + rck registry); a
// caller typically fc_boots, then fc_restores. Entries that fail to re-verify
// (tampered, or a premise that itself failed) are skipped, not pinned.
fn fc_restore(kg, snap) {
    let proofs = _fc_proofs()
    if proofs == 0 { return 0 }
    let cur = ps_cursor(snap)
    let n = str_to_int(_cur_next(cur))
    let restored = 0
    let i = 0
    while i < n {
        let label = _cur_next(cur)
        let src = _cur_next(cur)
        let claim = term_parse(cur)
        let axiom_terms = term_list_parse(cur)
        let proof = proof_parse(cur)
        let axioms = axiom_table_new()
        let k = 0
        while k < len(axiom_terms) {
            axiom_table_add(axioms, axiom_terms[k])
            k = k + 1
        }
        let hyps = _fc_all_hyps()
        let atom = kg_find_atom(kg, label)
        if atom == 0 { atom = kg_add_atom(kg, ATOM_CONCEPT, label, 0) }
        let pkt = verify_packet(axioms, hyps, proof, claim, label,
                                "restored:" + label)
        let state = lp_ingest_formal(atom, proofs, src, pkt)
        if state == CAND_PROMOTED {
            _fc_env_put(label, claim, atom_proof_ref(atom), atom, pkt, src)
            restored = restored + 1
        }
        i = i + 1
    }
    return restored
}

fn fc_env_count() {
    let env = _fc_env()
    if env == 0 { return 0 }
    return len(env)
}

// Snapshot every FORMAL proposition's term into an axiom table -- the engine's
// believed formal facts, for a consistency / contradiction scan (see
// reasoning/contradiction.nova). Verified-only: each term is in the env because
// the kernel pinned it FORMAL, so a contradiction among them is a real inconsistency
// in what the engine asserts as theorem-grade.
fn fc_env_axioms() {
    let axs = axiom_table_new()
    let env = _fc_env()
    if env == 0 { return axs }
    let i = 0
    while i < len(env) {
        axiom_table_add(axs, env[i][1])
        i = i + 1
    }
    return axs
}

// Reverse lookup: given a term (structurally, via term_eq), find its user-visible
// label in the FORMAL env. Returns "" if not found. Used by /consistency to name
// the members of a conflict set.
fn fc_env_label_for(term) {
    let env = _fc_env()
    if env == 0 { return "" }
    let i = 0
    while i < len(env) {
        if term_eq(env[i][1], term) == 1 { return env[i][0] }
        i = i + 1
    }
    return ""
}

// Fetch the kernel-checked proof tree for a FORMAL proposition by label -- the
// derivation the kernel VERIFIED at ingest time, ready for pretty-printing via
// con_render_proof. Returns 0 if the label is unknown. Every FORMAL entry in
// the env carries its verification packet; the proof lives at VPKT_PROOF.
fn fc_env_proof_for(label) {
    let e = _fc_env_get(label)
    if e == 0 { return 0 }
    let pkt = _fc_env_pkt(e)
    if pkt == 0 { return 0 }
    return pkt[VPKT_PROOF]
}

// Reverse lookup: given a term, find its source label ("user-taught",
// "wikipedia:...", etc.) as recorded in the FORMAL env at ingest. Returns ""
// if not found. Used to annotate proof derivations with provenance.
fn fc_env_source_for(term) {
    let env = _fc_env()
    if env == 0 { return "" }
    let i = 0
    while i < len(env) {
        if term_eq(env[i][1], term) == 1 { return env[i][5] }
        i = i + 1
    }
    return ""
}

// Build the annotations list [[term, source], ...] over EVERY current env
// entry -- ready to hand to con_render_proof_annotated so each AXIOM leaf in
// the rendered derivation is tagged with WHO taught it. This is what turns a
// bare proof into an audit trail.
fn fc_derivation_annotations() {
    let out = list_new()
    let env = _fc_env()
    if env == 0 { return out }
    let i = 0
    while i < len(env) {
        let pair = list_new()
        push(pair, env[i][1])   // term
        push(pair, env[i][5])   // src
        push(out, pair)
        i = i + 1
    }
    return out
}

// Reverse lookup by term -> INSERTION index in the env (0-based), or -1 if
// absent. The env is append-only, so a larger index means "asserted more
// recently" -- the canonical age signal.
fn fc_env_index_for(term) {
    let env = _fc_env()
    if env == 0 { return 0 - 1 }
    let i = 0
    while i < len(env) {
        if term_eq(env[i][1], term) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// Retract a FORMAL proposition by label: invalidate its proof (cascading
// through the kernel's dep edges so every downstream theorem is unpinned too)
// and remove its env entry so the label is unknown afterward. Returns [status,
// unpinned_count]:
//   status = 1  -> retracted; unpinned_count is atoms affected (>= 1 including
//                  this atom, plus any downstream FORMAL theorems that depended
//                  on it via HYP).
//   status = 0  -> label unknown; nothing to do.
// This is the second half of the truth-seeking loop: /consistency detects +
// localizes + suggests, and retract lets the user (or a policy) actually drop
// the newest challenger to restore consistency.
fn fc_retract(label) {
    let e = _fc_env_get(label)
    if e == 0 {
        let r = list_new() push(r, 0) push(r, 0) return r
    }
    let proofs = _fc_proofs()
    let code = _fc_env_code(e)
    // Cascade via the kernel: invalidate root proof + unpin every FORMAL atom
    // whose proof_ref no longer resolves VERIFIED. Needs the KG registry so the
    // atom-level cascade can walk KGs. We can reach it via the atom in the entry
    // (atom_kg) -> the reasoning KG's registry via the maintained kgreg on the
    // engine side. Simpler: expose the caller-provided kgreg through the
    // atom-registry pattern. Here the entry knows its atom, and kg->registry is
    // a walk we cannot do without kgreg. So take the kgreg as an explicit param
    // via a companion below.
    let r = list_new() push(r, 0) push(r, code) return r
}

// The cascade needs the KG registry to walk every atom; expose the full
// retract via an explicit kgreg parameter (the chat has it in scope per turn).
// Returns [status, unpinned_atoms, flipped_proofs]:
//   status = 1 -> retracted; unpinned and flipped counts from the kernel cascade.
//   status = 0 -> label unknown.
fn fc_retract_with(kgreg, label) {
    let e = _fc_env_get(label)
    if e == 0 {
        let r = list_new() push(r, 0) push(r, 0) push(r, 0) return r
    }
    let proofs = _fc_proofs()
    let code = _fc_env_code(e)
    let src = _fc_env_src(e)
    let casc = verify_cascade_invalidate(proofs, kgreg, code)
    // Remove the env entry so subsequent lookups say "unknown". NOVA's
    // list_remove(l, i) doesn't untag its index (2i+1 reaches the impl as a raw
    // index; OOB falls back to "remove last"), so we shift the tail down by one
    // via list_set and then drop the last slot using the OOB fallback.
    let env = _fc_env()
    let i = 0
    let target = 0 - 1
    while i < len(env) {
        if _fc_label_eq(env[i][0], label) == 1 {
            target = i
            i = len(env)
        } else {
            i = i + 1
        }
    }
    if target >= 0 {
        let n = len(env)
        let j = target
        while j < n - 1 {
            list_set(env, j, env[j + 1])
            j = j + 1
        }
        list_remove(env, n + 100)   // OOB -> drops the (now-duplicate) last slot
    }
    // Append to the audit log: [label, source, unpinned, flipped].
    let log = _fc_retraction_log_handle
    if len(log) > 0 {
        let entry = list_new()
        push(entry, label) push(entry, src)
        push(entry, cascade_unpinned(casc)) push(entry, cascade_flipped(casc))
        push(log[0], entry)
    }
    let r = list_new()
    push(r, 1) push(r, cascade_unpinned(casc)) push(r, cascade_flipped(casc))
    return r
}

fn fc_ret_status(r)   { return r[0] }
fn fc_ret_unpinned(r) { return r[1] }
fn fc_ret_flipped(r)  { return r[2] }

// ---- retraction audit log (ADR-0043) ---------------------------------------
// The session's history of belief-revision events. Each entry is a list
// [label, source, unpinned_atoms, flipped_proofs] recorded at the moment
// fc_retract_with fires.
fn fc_retraction_log() {
    if len(_fc_retraction_log_handle) == 0 { return list_new() }
    return _fc_retraction_log_handle[0]
}

fn fc_retraction_count() { return len(fc_retraction_log()) }

// Entry accessors.
fn fc_rle_label(e)    { return e[0] }
fn fc_rle_source(e)   { return e[1] }
fn fc_rle_unpinned(e) { return e[2] }
fn fc_rle_flipped(e)  { return e[3] }

// Given a conflict set (a list of terms known to entail FALSE together),
// return the LABEL of the newest premise -- the one with the largest insertion
// index. This is the principled minimal-revision suggestion: if the store was
// consistent before this premise was added, it is the prima facie challenger to
// retract. Returns "" if no member of the conflict is in the env (shouldn't
// happen for a conflict extracted from fc_env_axioms). Ties: last one wins
// (>=), so among synchronously-asserted premises we still pick a unique newest.
fn fc_newest_in_conflict(conflict_terms) {
    let best_idx = 0 - 1
    let best_label = ""
    let i = 0
    while i < len(conflict_terms) {
        let idx = fc_env_index_for(conflict_terms[i])
        if idx >= best_idx {
            best_idx = idx
            best_label = fc_env_label_for(conflict_terms[i])
        }
        i = i + 1
    }
    return best_label
}

// Render a one-line result for the chat (no LLM; pure substrate, ADR-0013).
fn fc_render(r, label) {
    let state = fc_state(r)
    if state == CAND_PROMOTED {
        return "axiom '" + label + "' verified and pinned FORMAL (theorem-grade, "
            + "decay-exempt, periodically re-checked)."
    }
    if state == CAND_QUARANTINED {
        return "axiom '" + label + "' quarantined: the source is not "
            + "commercially clean (Rule 3); not admitted to the formal KB."
    }
    return "axiom '" + label + "' not admitted (the kernel did not verify it).";
}

// Render a /prove (derived-theorem) result.
fn fc_render_proof(r, concl_label) {
    let state = fc_state(r)
    if state == CAND_PROMOTED {
        return "theorem '" + concl_label + "' DERIVED and pinned FORMAL by modus "
            + "ponens over its premises (now decay-exempt, cascades if a premise "
            + "is withdrawn, periodically re-checked)."
    }
    if state == CAND_REJECTED {
        return "cannot derive '" + concl_label + "': a premise is unknown or the "
            + "implication does not match (premise -> " + concl_label + ").";
    }
    if state == CAND_QUARANTINED {
        return "theorem '" + concl_label + "' quarantined (Rule 3).";
    }
    return "theorem '" + concl_label + "' not admitted (the kernel rejected the "
        + "derivation).";
}
