// CrossEngin Phase 7 pt1: cowork planner (pure, print-only).
//
// Purpose
//   Match a natural-language task description to a DAG of sub-tasks
//   routed by domain to installed agent bundles. pt1 is the PLANNER
//   only -- no federation fan-out, no execution. The output is a
//   human-readable plan an operator inspects before any real dispatch
//   infrastructure gets wired.
//
//   Why print-only: the real fan-out path needs the existing
//   federation layer (distributed_query / gossip / Noise XK), which
//   is an "outbound" surface and so far unexercised from the chat.
//   The planner keeps the task shape honest: each sub-task knows
//   WHICH agent would receive it, so pt2's work is routing bytes,
//   not negotiating semantics.
//
// Heuristic domain triggers (pt1):
//   legal / law / contract / GDPR / compliance   -> "legal"
//   clinical / patient / medical / drug / symptom -> "clinical"
//   code / review / PR / bug / lint / refactor   -> "code"
//   finance / cost / budget / accounting / money -> "finance"
//   research / study / paper / arxiv             -> "research"
//   procurement / vendor / purchase / contract    -> "procurement"
//                                                   (contract hits
//                                                    both legal AND
//                                                    procurement --
//                                                    both land in the
//                                                    DAG)
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "std/io"
import "std/string"
import "std/syscall"
import "../util/str_safe.nova"

// Subtask record slots.
let CWT_TAG        = 0
let CWT_DOMAIN     = 1   // string: "legal" / "clinical" / "code" / ...
let CWT_TRIGGER    = 2   // the word in the input that matched
let CWT_AGENT      = 3   // string: name of the installed agent, or "" if none
let CWT_DEPENDS_ON = 4   // list<int>: task indices this one depends on
let CWT_PLANNER_TAG = 777

// Return 1 if token `t` appears in `text` as a substring (case-insensitive
// via str_lower on both). t is expected already lowercase.
fn _cw_contains(text, t) {
    let lt = str_lower(text)
    if str_find(lt, t) == (0 - 1) { return 0 }
    return 1
}

// Push a subtask row onto out if the trigger word appears in `desc`.
// depends_on is populated in a second pass over the full list; initially empty.
fn _cw_check(out, desc, trigger, domain) {
    if _cw_contains(desc, trigger) == 1 {
        let row = list_new()
        push(row, CWT_PLANNER_TAG)
        push(row, domain)
        push(row, trigger)
        push(row, "")             // agent name -- caller fills from registry
        push(row, list_new())     // depends_on -- populated by _cw_compute_deps
        push(out, row)
    }
    return 1
}

// Public planner: split a description into subtasks via keyword triggers.
// Returns a list of subtask rows. Row slots: [tag, domain, trigger, agent=""].
// Caller resolves `agent` against the installed-bundles index.
fn cw_plan(desc) {
    let out = list_new()
    if len(desc) == 0 { return out }

    // Legal / compliance.
    _cw_check(out, desc, "legal", "legal")
    _cw_check(out, desc, "law", "legal")
    _cw_check(out, desc, "contract", "legal")
    _cw_check(out, desc, "gdpr", "legal")
    _cw_check(out, desc, "compliance", "legal")

    // Clinical / medical.
    _cw_check(out, desc, "clinical", "clinical")
    _cw_check(out, desc, "patient", "clinical")
    _cw_check(out, desc, "medical", "clinical")
    _cw_check(out, desc, "drug", "clinical")
    _cw_check(out, desc, "symptom", "clinical")

    // Code review.
    _cw_check(out, desc, "code", "code")
    _cw_check(out, desc, "review", "code")
    _cw_check(out, desc, "bug", "code")
    _cw_check(out, desc, "lint", "code")
    _cw_check(out, desc, "refactor", "code")

    // Finance / accounting.
    _cw_check(out, desc, "finance", "finance")
    _cw_check(out, desc, "cost", "finance")
    _cw_check(out, desc, "budget", "finance")
    _cw_check(out, desc, "accounting", "finance")
    _cw_check(out, desc, "money", "finance")

    // Research.
    _cw_check(out, desc, "research", "research")
    _cw_check(out, desc, "study", "research")
    _cw_check(out, desc, "paper", "research")
    _cw_check(out, desc, "arxiv", "research")

    // Procurement.
    _cw_check(out, desc, "procurement", "procurement")
    _cw_check(out, desc, "vendor", "procurement")
    _cw_check(out, desc, "purchase", "procurement")

    _cw_compute_deps(out)
    return out
}

// pt2-lite dependency heuristic. Info-gathering tasks
// (research / clinical) have no deps. Legal / procurement / finance
// tasks depend on all info-gathering tasks present (you want the
// facts in hand before reviewing contracts or cost).  Code tasks
// stay parallel -- they don't need the info-gathering context.
// All deps are task indices into `out` itself; empty list means
// "can start immediately".
fn _cw_compute_deps(out) {
    let info_idxs = list_new()
    let i = 0
    while i < len(out) {
        let dom = out[i][CWT_DOMAIN]
        if str_eq_bytes(dom, "research") == 1 { push(info_idxs, i) }
        if str_eq_bytes(dom, "clinical") == 1 { push(info_idxs, i) }
        i = i + 1
    }
    if len(info_idxs) == 0 { return 1 }
    let j = 0
    while j < len(out) {
        let dom = out[j][CWT_DOMAIN]
        let gates = 0
        if str_eq_bytes(dom, "legal") == 1       { gates = 1 }
        if str_eq_bytes(dom, "procurement") == 1 { gates = 1 }
        if str_eq_bytes(dom, "finance") == 1     { gates = 1 }
        if gates == 1 {
            let deps = out[j][CWT_DEPENDS_ON]
            let k = 0
            while k < len(info_idxs) {
                push(deps, info_idxs[k])
                k = k + 1
            }
        }
        j = j + 1
    }
    return 1
}

// Topologically sort the tasks: return a list of task indices in an
// order where every dep index comes before the index that depends on it.
// Simple Kahn-style: pick a task with no unseen deps, repeat.
fn cw_topo_sort(tasks) {
    let n = len(tasks)
    let out = list_new()
    let seen = list_new()
    let i = 0
    while i < n { push(seen, 0); i = i + 1 }
    let left = n
    let progress = 1
    while left > 0 {
        if progress == 0 { left = 0 }
        else {
            progress = 0
            let j = 0
            while j < n {
                if seen[j] == 0 {
                    let deps = tasks[j][CWT_DEPENDS_ON]
                    let all_ready = 1
                    let k = 0
                    while k < len(deps) {
                        if seen[deps[k]] == 0 { all_ready = 0 }
                        k = k + 1
                    }
                    if all_ready == 1 {
                        push(out, j)
                        list_set(seen, j, 1)
                        left = left - 1
                        progress = 1
                    }
                }
                j = j + 1
            }
        }
    }
    return out
}

// Row accessors.
fn cwt_domain(r)     { return r[CWT_DOMAIN] }
fn cwt_trigger(r)    { return r[CWT_TRIGGER] }
fn cwt_agent(r)      { return r[CWT_AGENT] }
fn cwt_depends_on(r) { return r[CWT_DEPENDS_ON] }
fn cwt_set_agent(r, agent_name) {
    list_set(r, CWT_AGENT, agent_name)
    return 1
}
