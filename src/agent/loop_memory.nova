// CrossEngin agent: memory loop.
//
// Purpose
//   The memory loop (ADR-0036): record each input as a moment (ADR-0021) and an
//   episode (ADR-0022), tag the moment's trace with the percept's atom ids, and
//   apply ordinary episodic decay. Reads the percept from the shared blackboard.
//
//   Memory also owns the episodic-memory consolidation sub-task
//   (ADR-0022 cycle, src/kg/episodic.nova): periodically scan the recent
//   moment stream for clusters of atoms that co-occur >=5 times within a
//   small temporal window, and promote each into a durable compound atom
//   with Beta(alpha,beta) belief. The sub-task runs every
//   LOOP_MEM_CONSOL_EVERY memory steps so a chatty perception cycle does
//   not block memory's primary record path. ADR-0036 leaves no room for
//   a new loop -- the substrate is six loops + imagination idle -- so we
//   land the consolidation cycle as a memory sub-task instead.
//
// ADRs implemented: ADR-0036 (memory loop), ADR-0022 (consolidation cycle),
//   ADR-0023 (Bayesian belief tracking for the promoted atoms). NOVA
//   dependencies: builtins. CrossEngin dependencies:
//   src/agent/loop_coordination.nova, src/parts/episodic/moment_stream.nova,
//   src/parts/episodic/episode_storage.nova, src/kg/episodic.nova.

import "loop_coordination.nova"
import "../parts/episodic/moment_stream.nova"
import "../parts/episodic/episode_storage.nova"
import "../kg/episodic.nova"

let LOOP_MEM_DECAY        = 990   // gentle per-step episodic decay (0.99)
let LOOP_MEM_CONSOL_EVERY = 100   // run the consolidation sub-task every N steps

// Record the current input as a moment + episode, tracing the percept atoms.
// Returns the new moment id.
fn loop_memory_step(ctx, stream, em) {
    let m = ms_capture(stream, ctx_tick(ctx), MODALITY_TEXT, ctx_input(ctx), 600, LOOP_PERCEPTION)
    // Trace the percept's atom ids (handle = [kg_id, atom_id]).
    let percept = ctx_percept(ctx)
    let i = 0
    while i < len(percept) {
        moment_add_trace(m, percept[i][1])
        i = i + 1
    }
    em_record(em, moment_id(m), 600, ctx_tick(ctx))
    em_decay_all(em, LOOP_MEM_DECAY)
    return moment_id(m)
}

// Extended memory step: records the input AND -- if `eas` is non-zero --
// runs the episodic consolidation sub-task. The sub-task is rate-limited:
// it fires only when (moment_count % LOOP_MEM_CONSOL_EVERY) == 0, so a
// chatty cycle still mostly records-and-returns. Plus, on EVERY step (not
// just the consolidation cadence) we feed the current percept's atom-id
// list to episodic_observe so existing episodic atoms see each matching
// observation in real time -- the Beta belief tracks live activity, not
// just the once-per-100-steps consolidation pass.
//
// Returns the new moment id.
fn loop_memory_step_with_episodic(ctx, stream, em, eas) {
    let mid = loop_memory_step(ctx, stream, em)
    if eas == 0 { return mid }
    // Live belief update: every memory step where existing episodic atoms
    // see the same cluster again increments alpha (matched=1). Build a
    // bare atom-id list from the current percept (skip the [kg_id, ...]
    // handle wrapper so episodic_match_observation sees raw atom ids).
    let percept = ctx_percept(ctx)
    let obs_ids = list_new()
    let p = 0
    while p < len(percept) {
        push(obs_ids, percept[p][1])
        p = p + 1
    }
    if len(obs_ids) > 0 {
        episodic_observe(eas, obs_ids, ctx_tick(ctx))
    }
    // Rate-limited consolidation sweep over the moment stream.
    let n = ms_count(stream)
    if n > 0 {
        if (n - 1) % LOOP_MEM_CONSOL_EVERY == 0 {
            episodic_consolidate(eas, stream, 0, 0)
        }
    }
    return mid
}
