// CrossEngin agent: imagination idle loop.
//
// Purpose
//   The idle-gated imagination loop (ADR-0036): only when the agent is idle, roll
//   the current active concepts forward with high-confidence patterns (ADR-0032)
//   to anticipate near-future states for planning. It writes only to imagination
//   scratch -- never to live action -- and runs nothing while the agent is active.
//
//   R39D extends this with a sibling idle step: the autonomous-research drain.
//   When the chat REPL is between user inputs, the substrate's idle loop should
//   also drain the self-learning-trigger queue (ADR-0026), fire the gated
//   internet-fetch pipeline (ADR-0028), and ingest the results into the KG. The
//   imagination step is unchanged; `loop_research_step` is the new entry point.
//   The chat-REPL / daemon integration that threads `ar_state` + `slt_queue`
//   into both calls per cycle is deferred to R40 -- this module just exposes the
//   hook so R39D's autonomous_research module is reachable from one place.
//
// ADRs implemented: ADR-0036 (imagination idle loop), ADR-0032 (forward sim).
//   ADR-0026 + ADR-0028 wiring (R39D) lives in `loop_research_step` below.
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/agent/loop_coordination.nova, src/parts/imagination/forward_sim.nova,
//   src/learning/autonomous_research.nova (R39D).

import "loop_coordination.nova"
import "../parts/imagination/forward_sim.nova"
import "../learning/autonomous_research.nova"

let LOOP_IMG_STEPS    = 3
let LOOP_IMG_MIN_CONF = 0

// Run an imagination step iff the agent is idle. Builds a state from the active
// concept atom ids and forward-simulates. Returns the imagined state size (0 if
// not idle).
fn loop_imagination_step(ctx, ikg) {
    if ctx_idle(ctx) == 0 { return 0 }
    let state = img_state_new()
    let active = ctx_active(ctx)
    let i = 0
    while i < len(active) {
        img_state_add(state, active[i][1])
        i = i + 1
    }
    let imagined = forward_simulate(ikg, state, LOOP_IMG_STEPS, LOOP_IMG_MIN_CONF)
    return img_state_size(imagined)
}

// R39D: drain one step of the autonomous-research pipeline iff the agent is
// idle. Wraps `ar_tick` (see src/learning/autonomous_research.nova) so the
// chat-REPL / daemon doesn't need to import internet_fetch directly. Returns
// the AR_TICK_* tag that `ar_tick` produced (or AR_TICK_IDLE when the agent
// is active so the caller cannot accidentally fetch under user load).
//
// Integration contract (R40 will thread this):
//   * The chat REPL holds an `ar_state_t` alongside its other long-lived
//     state (slt_queue, kg registry, ...).
//   * After the imagination step, the REPL calls
//       `let tag = loop_research_step(ctx, ar_state, slt_queue, kg, now_ms)`.
//   * If `tag == AR_TICK_BUSY` the REPL should skip the remaining idle steps
//     this iteration (an HTTP transport is pending or the orchestrator is
//     rate-limited; running other CPU-heavy idle work would compete for the
//     same wall-clock window).
//   * If `tag == AR_TICK_OK` or `AR_TICK_IDLE`, other idle steps may run.
//
// R40 will own the actual threading; this module's job is to expose the
// hook so the substrate's idle-loop integrator has ONE place to call.
fn loop_research_step(ctx, ar_state, slt_queue, kg, current_time_ms) {
    if ctx_idle(ctx) == 0 { return AR_TICK_IDLE }
    return ar_tick(ar_state, slt_queue, kg, current_time_ms)
}
