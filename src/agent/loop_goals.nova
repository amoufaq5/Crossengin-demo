// CrossEngin agent: goals loop.
//
// Purpose
//   The goals loop (ADR-0036): run the four intrinsic drives (ADR-0033) from the
//   cycle's inputs (knowledge gap, time since interaction, pending requests, and
//   the blackboard's current mood/memory load), then arbitrate the
//   highest-priority unblocked leaf goal and write it onto the blackboard.
//
// ADRs implemented: ADR-0036 (goals loop), ADR-0033 (drives + arbitration).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/agent/loop_coordination.nova, src/parts/goals/drive_generators.nova.

import "loop_coordination.nova"
import "../parts/goals/drive_generators.nova"

// Generate drive goals and arbitrate. Writes the active goal id into the
// context. Returns the chosen goal id (-1 if none).
fn loop_goals_step(ctx, engine, knowledge_gap, time_since_interaction, pending_requests, memory_load) {
    drive_generate_all(engine, knowledge_gap, 1000, time_since_interaction,
        pending_requests, ctx_valence(ctx), memory_load, ctx_tick(ctx))
    let best = goal_arbitrate(engine)
    ctx_set_goal(ctx, best)
    return best
}
