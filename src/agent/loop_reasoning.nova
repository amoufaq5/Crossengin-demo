// CrossEngin agent: reasoning loop.
//
// Purpose
//   The reasoning loop (ADR-0036): forward-chain from the percept's concepts over
//   the reasoning operators (ADR-0031) and write the derived conclusions onto the
//   shared blackboard for the goals and action loops. Bounded depth per cycle.
//
// ADRs implemented: ADR-0036 (reasoning loop). NOVA dependencies: builtins.
// CrossEngin dependencies: src/agent/loop_coordination.nova,
//   src/parts/reasoning/reasoning_module.nova.

import "loop_coordination.nova"
import "../parts/reasoning/reasoning_module.nova"

let LOOP_REASON_DEPTH = 3

// Forward-chain from each percept concept and collect the distinct conclusions
// into the context. Returns the number of conclusions derived.
fn loop_reasoning_step(ctx, rkg) {
    let percept = ctx_percept(ctx)
    let conclusions = list_new()
    let i = 0
    while i < len(percept) {
        let trace = reason_forward_chain(rkg, percept[i][1], LOOP_REASON_DEPTH)
        let concl = reason_conclusions(trace)
        let j = 0
        while j < len(concl) {
            if contains(conclusions, concl[j]) == 0 { push(conclusions, concl[j]) }
            j = j + 1
        }
        i = i + 1
    }
    ctx_set_conclusions(ctx, conclusions)
    return len(conclusions)
}
