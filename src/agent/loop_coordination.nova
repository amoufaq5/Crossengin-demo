// CrossEngin agent: loop coordination (the shared blackboard + run order).
//
// Purpose
//   Coordinates the six cognitive loops plus the imagination idle loop
//   (ADR-0036). It owns the AgentContext -- the shared working state the loops
//   read and write (current input, percept, active concepts, reasoning
//   conclusions, mood, active goal, output, idle flag) -- and the run-order /
//   idle-gating logic: the six loops run under active cognition; imagination
//   runs only when idle.
//
//   ADR-0036 specifies typed channels across true concurrent fibers (NOVA
//   enhancement #3, not available); at functional scale the coordinator
//   sequences the loops over this shared blackboard, which preserves the
//   data-flow semantics (perception -> reasoning -> action) without true
//   parallelism. This module is standalone (no subsystem imports): each loop
//   imports it for the context type, so the loops never import one another
//   (NOVA blocker #10). The actual dispatch wiring is the agent top level
//   (Phase 10).
//
// ADRs implemented: ADR-0036 (six loops + imagination idle, coordination).
// NOVA dependencies: builtins. CrossEngin dependencies: none.

// ---- loop ids (ADR-0036) --------------------------------------------------
let LOOP_PERCEPTION  = 1
let LOOP_MEMORY      = 2
let LOOP_REASONING   = 3
let LOOP_EMOTION     = 4
let LOOP_ACTION      = 5
let LOOP_GOALS       = 6
let LOOP_IMAGINATION = 7

fn loop_name(id) {
    if id == LOOP_PERCEPTION  { return "perception" }
    if id == LOOP_MEMORY      { return "memory" }
    if id == LOOP_REASONING   { return "reasoning" }
    if id == LOOP_EMOTION     { return "emotion" }
    if id == LOOP_ACTION      { return "action" }
    if id == LOOP_GOALS       { return "goals" }
    if id == LOOP_IMAGINATION { return "imagination" }
    return "unknown"
}

// ---- AgentContext (shared blackboard) -------------------------------------
let AC_TAG         = 0
let AC_TICK        = 1
let AC_INPUT       = 2
let AC_PERCEPT     = 3   // percept concept handles (perception)
let AC_ROUTES      = 4   // symbolic route targets (perception)
let AC_ACTIVE      = 5   // active concept handles (reasoning/spread)
let AC_CONCLUSIONS = 6   // reasoning conclusions
let AC_VALENCE     = 7   // mood valence (emotion)
let AC_AROUSAL     = 8   // mood arousal (emotion)
let AC_GOAL        = 9   // active goal id (goals)
let AC_OUTPUT      = 10  // produced output text (action)
let AC_UNKNOWN     = 11  // unknown-token count (drives learning)
let AC_IDLE        = 12
let AC_OBJ_TAG = 3601

fn ctx_new() {
    let c = list_new()
    push(c, AC_OBJ_TAG)
    push(c, 0)            // tick
    push(c, "")           // input
    push(c, list_new())   // percept
    push(c, list_new())   // routes
    push(c, list_new())   // active
    push(c, list_new())   // conclusions
    push(c, 500)          // valence
    push(c, 300)          // arousal
    push(c, -1)           // goal
    push(c, "")           // output
    push(c, 0)            // unknown
    push(c, 0)            // idle
    return c
}

fn ctx_tick(c)        { return c[AC_TICK] }
fn ctx_set_tick(c, t) { list_set(c, AC_TICK, t); return 1 }
fn ctx_input(c)       { return c[AC_INPUT] }
fn ctx_set_input(c, s){ list_set(c, AC_INPUT, s); return 1 }
fn ctx_percept(c)     { return c[AC_PERCEPT] }
fn ctx_set_percept(c, p) { list_set(c, AC_PERCEPT, p); return 1 }
fn ctx_routes(c)      { return c[AC_ROUTES] }
fn ctx_set_routes(c, r) { list_set(c, AC_ROUTES, r); return 1 }
fn ctx_active(c)      { return c[AC_ACTIVE] }
fn ctx_set_active(c, a) { list_set(c, AC_ACTIVE, a); return 1 }
fn ctx_conclusions(c) { return c[AC_CONCLUSIONS] }
fn ctx_set_conclusions(c, x) { list_set(c, AC_CONCLUSIONS, x); return 1 }
fn ctx_valence(c)     { return c[AC_VALENCE] }
fn ctx_arousal(c)     { return c[AC_AROUSAL] }
fn ctx_set_mood(c, v, a) { list_set(c, AC_VALENCE, v); list_set(c, AC_AROUSAL, a); return 1 }
fn ctx_goal(c)        { return c[AC_GOAL] }
fn ctx_set_goal(c, g) { list_set(c, AC_GOAL, g); return 1 }
fn ctx_output(c)      { return c[AC_OUTPUT] }
fn ctx_set_output(c, s) { list_set(c, AC_OUTPUT, s); return 1 }
fn ctx_unknown(c)     { return c[AC_UNKNOWN] }
fn ctx_set_unknown(c, n) { list_set(c, AC_UNKNOWN, n); return 1 }
fn ctx_idle(c)        { return c[AC_IDLE] }
fn ctx_set_idle(c, i) { list_set(c, AC_IDLE, i); return 1 }

// ---- coordination logic ---------------------------------------------------
// The active cognitive cycle order (the six loops). Imagination is separate.
fn coord_run_order() {
    let o = list_new()
    push(o, LOOP_PERCEPTION)
    push(o, LOOP_MEMORY)
    push(o, LOOP_REASONING)
    push(o, LOOP_EMOTION)
    push(o, LOOP_GOALS)
    push(o, LOOP_ACTION)
    return o
}

// Should a loop run given the idle state? The six run on activity; imagination
// runs only when idle (ADR-0036).
fn coord_should_run(loop_id, is_idle) {
    if loop_id == LOOP_IMAGINATION { return is_idle }
    if is_idle == 0 { return 1 }
    return 0
}

// The loops to run this cycle given the idle state.
fn coord_active_loops(is_idle) {
    if is_idle == 1 {
        let o = list_new()
        push(o, LOOP_IMAGINATION)
        return o
    }
    return coord_run_order()
}
