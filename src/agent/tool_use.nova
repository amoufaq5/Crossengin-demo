// CrossEngin agent: tool-use planning + execution (P4, ADR-0054).
//
// Purpose
//   Turn a goal-decomposed PLAN (a sequence of capability steps) into action.
//   For each step the planner SELECTS the highest-competence tool for that
//   capability, GATES it through the permission/reversibility safety layer,
//   INVOKES the matching effector, THREADS the result into the next step, and
//   LEARNS from the outcome (success/failure updates the tool's competence, so
//   a failing tool is selected less next time). Each result is also surfaced as
//   a lightweight moment in the trace, the seam by which an effector's outcome
//   re-enters perception / ingestion for deeper learning.
//
//   A step can optionally be PRE-SIMULATED first (predict the result before
//   acting) -- the forward_sim hook; for the deterministic code-exec backend the
//   prediction is just a dry run.
//
// ADRs: ADR-0054 (agentic tooling), ADR-0033 (goal -> plan), ADR-0032
//   (forward simulation). CrossEngin deps: tool.nova + the four effectors.

import "../io/effectors/tool.nova"
import "../io/effectors/effector_code_exec.nova"
import "../io/effectors/effector_file_ops.nova"
import "../io/effectors/effector_http_action.nova"
import "../io/effectors/effector_mcp.nova"

// ---- plan model ------------------------------------------------------------
// A step names a capability and how to build its argument from the prior step.
let ARG_LITERAL    = 0   // use the literal
let ARG_PREV_TEXT  = 1   // prior result text, then append the literal suffix
let ARG_PREV_VALUE = 2   // prior result integer value, then the literal suffix

let STEP_CAP = 0
let STEP_SRC = 1
let STEP_LIT = 2

fn plan_step(capability, arg_source, literal) {
    let s = list_new()
    push(s, capability); push(s, arg_source); push(s, literal)
    return s
}
fn plan_new() { return list_new() }
fn plan_add(plan, step) { push(plan, step); return len(plan) }

// Build a step's argument text from the previous result.
fn _arg_text(step, prev) {
    let src = step[STEP_SRC]
    let lit = step[STEP_LIT]
    if src == ARG_LITERAL { return lit }
    if prev == 0 { return lit }
    if src == ARG_PREV_TEXT { return tr_text(prev) + lit }
    return int_to_str(tr_value(prev)) + lit
}

// ---- invocation ------------------------------------------------------------
// Dispatch a gated tool call to its effector backend.
fn tool_invoke(tool, arg_text, approved) {
    let g = tool_gate(tool, approved)
    if g == TGATE_DENY { return tr_denied() }
    let k = tool_kind(tool)
    if k == TOOLK_CODE_EXEC  { return code_exec_run(arg_text) }
    if k == TOOLK_FILE_WRITE { return file_ops_write(tool_config(tool), arg_text) }
    if k == TOOLK_FILE_READ  { return file_ops_read(tool_config(tool)) }
    if k == TOOLK_HTTP       { return http_action_run(arg_text, 1, tool_config(tool)) }
    if k == TOOLK_MCP        { return mcp_call_direct(tool_config(tool), arg_text, tool_config(tool)) }
    return tr_new(0, 0, "unknown-tool-kind")
}

// Pre-simulate a tool call (predict before acting). Deterministic backends
// (code exec) dry-run; others return an "unknown prediction" marker so the
// planner can decide whether to proceed. (forward_sim integration point.)
fn tool_presimulate(tool, arg_text) {
    if tool_kind(tool) == TOOLK_CODE_EXEC { return code_exec_run(arg_text) }
    return tr_new(0, 0, "no-prediction")
}

// Surface a result as a lightweight moment [label, ok, text] for the trace /
// re-ingestion. (Full moment_stream wiring is the integration point.)
fn _tool_moment(capability, tr) {
    let m = list_new()
    push(m, "tool:" + capability)
    push(m, tr_ok(tr))
    push(m, tr_text(tr))
    return m
}

// ---- execution -------------------------------------------------------------
// Execute a plan against a registry. `approved` is the in-the-moment approval
// for gated actions. Returns [final_result, trace, ok_count]. Stops at the
// first failed/denied step (the trace records it). Every attempt updates the
// chosen tool's competence.
fn plan_execute(registry, plan, approved) {
    let prev = 0
    let trace = list_new()
    let ok_count = 0
    let i = 0
    let aborted = 0
    while i < len(plan) {
        if aborted == 0 {
            let step = plan[i]
            let cap = step[STEP_CAP]
            let tool = tool_select(registry, cap)
            if tool == 0 {
                push(trace, _tool_moment(cap, tr_new(0, 0, "no-tool-for-capability")))
                aborted = 1
            } else {
                let arg = _arg_text(step, prev)
                let tr = tool_invoke(tool, arg, approved)
                tool_observe(tool, tr_ok(tr))          // learn from the outcome
                push(trace, _tool_moment(cap, tr))
                if tr_ok(tr) == 1 { ok_count = ok_count + 1 prev = tr }
                else { aborted = 1 }
            }
        }
        i = i + 1
    }
    let final_tr = prev
    if final_tr == 0 { final_tr = tr_new(0, 0, "no-result") }
    let out = list_new()
    push(out, final_tr); push(out, trace); push(out, ok_count)
    return out
}

fn plan_result(out)  { return out[0] }
fn plan_trace(out)   { return out[1] }
fn plan_ok_count(out){ return out[2] }
