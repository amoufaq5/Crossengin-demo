// CrossEngin data: a small recursive-descent JSON parser.
//
// Purpose
//   R55's OpenSearch handling scanned for the first "https://" by hand; richer
//   JSON sources (the dictionaryapi.dev definitions API) need real structure.
//   This parses a JSON document into a tagged value tree in one O(n) pass with a
//   mutable position cursor. Malformed input yields a JV_ERR value rather than
//   crashing or looping forever -- every step either advances the cursor or
//   stops. Object/array nesting recurses (inputs here are shallow).
//
//   A value is [tag, payload]:
//     JV_NULL  payload 0
//     JV_BOOL  payload 0/1
//     JV_NUM   payload int (truncated), raw token in [2]
//     JV_STR   payload string  (\" \\ \/ \b \f \n \r \t and \uXXXX BMP decoded;
//                               raw UTF-8 bytes pass through untouched)
//     JV_ARR   payload list of values
//     JV_OBJ   payload list of [key_string, value]
//     JV_ERR   payload 0  (parse error / wrong-type access -- propagates)
//
// NOVA dependencies: builtins (len, char_at, chr, substr, str_to_int, list_new,
//   push, list_set) + shared str_eq_bytes workaround for NOVA's flaky str_eq
//   (see src/util/str_safe.nova).
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

let JV_NULL = 0
let JV_BOOL = 1
let JV_NUM  = 2
let JV_STR  = 3
let JV_ARR  = 4
let JV_OBJ  = 5
let JV_ERR  = 6

fn _jv(tag, payload) {
    let v = list_new()
    push(v, tag)
    push(v, payload)
    return v
}
fn _jv_num(intval, raw) {
    let v = list_new()
    push(v, JV_NUM)
    push(v, intval)
    push(v, raw)
    return v
}

// ---- accessors -------------------------------------------------------------
fn json_type(v)     { return v[0] }
fn json_is_valid(v) { if v[0] == JV_ERR { return 0 } return 1 }
fn json_is_null(v)  { if v[0] == JV_NULL { return 1 } return 0 }
fn json_str(v)      { if v[0] == JV_STR { return v[1] } return "" }
fn json_num(v)      { if v[0] == JV_NUM { return v[1] } return 0 }
fn json_bool(v)     { if v[0] == JV_BOOL { return v[1] } return 0 }

fn json_arr_len(v)  { if v[0] == JV_ARR { return len(v[1]) } return 0 }
fn json_arr_get(v, i) {
    if v[0] == JV_ARR {
        if i >= 0 { if i < len(v[1]) { return v[1][i] } }
    }
    return _jv(JV_ERR, 0)
}
fn json_has(v, key) {
    if v[0] != JV_OBJ { return 0 }
    let pairs = v[1]
    let i = 0
    while i < len(pairs) {
        if str_eq_bytes(pairs[i][0], key) == 1 { return 1 }
        i = i + 1
    }
    return 0
}
// Object lookup by key -> value, or JV_ERR if absent / not an object.
fn json_get(v, key) {
    if v[0] != JV_OBJ { return _jv(JV_ERR, 0) }
    let pairs = v[1]
    let i = 0
    while i < len(pairs) {
        if str_eq_bytes(pairs[i][0], key) == 1 { return pairs[i][1] }
        i = i + 1
    }
    return _jv(JV_ERR, 0)
}

// ---- cursor + lexer helpers ------------------------------------------------
fn _j_at(text, p) {
    if p < 0 { return 0 - 1 }
    if p >= len(text) { return 0 - 1 }
    return char_at(text, p)
}
fn _j_peek(text, pc) { return _j_at(text, pc[0]) }
fn _j_adv(pc) { list_set(pc, 0, pc[0] + 1) return 1 }
fn _j_ws(text, pc) {
    let go = 1
    while go == 1 {
        let c = _j_peek(text, pc)
        if c == 32 { _j_adv(pc) }
        else if c == 9 { _j_adv(pc) }
        else if c == 10 { _j_adv(pc) }
        else if c == 13 { _j_adv(pc) }
        else { go = 0 }
    }
    return 1
}

// hex nibble value, or -1.
fn _j_hex(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }   // 0-9
    if c >= 97 { if c <= 102 { return c - 87 } }   // a-f
    if c >= 65 { if c <= 70  { return c - 55 } }   // A-F
    return 0 - 1
}
// 4 hex digits at p -> codepoint, or -1.
fn _j_hex4(text, p, end) {
    if p + 4 > end { return 0 - 1 }
    let h0 = _j_hex(char_at(text, p))
    let h1 = _j_hex(char_at(text, p + 1))
    let h2 = _j_hex(char_at(text, p + 2))
    let h3 = _j_hex(char_at(text, p + 3))
    if h0 < 0 { return 0 - 1 }
    if h1 < 0 { return 0 - 1 }
    if h2 < 0 { return 0 - 1 }
    if h3 < 0 { return 0 - 1 }
    return h0 * 4096 + h1 * 256 + h2 * 16 + h3
}
// UTF-8 encode a BMP codepoint (surrogate halves -> '?').
fn _j_utf8(cp) {
    if cp < 128 { return chr(cp) }
    if cp < 2048 {
        return chr(192 + (cp / 64)) + chr(128 + (cp % 64))
    }
    if cp >= 55296 { if cp <= 57343 { return "?" } }
    return chr(224 + (cp / 4096)) + chr(128 + ((cp / 64) % 64)) + chr(128 + (cp % 64))
}
fn _j_simple_escape(e) {
    if e == 34  { return chr(34) }   // \"
    if e == 92  { return chr(92) }   // backslash
    if e == 47  { return chr(47) }   // \/
    if e == 110 { return chr(10) }   // \n
    if e == 116 { return chr(9) }    // \t
    if e == 114 { return chr(13) }   // \r
    if e == 98  { return chr(8) }    // \b
    if e == 102 { return chr(12) }   // \f
    return chr(e)                    // unknown -> literal char
}

// Decode a string span [start, end) that contains at least one backslash.
fn _j_decode(text, start, end) {
    let out = ""
    let p = start
    while p < end {
        let c = char_at(text, p)
        if c == 92 {
            p = p + 1
            if p >= end { return out }
            let e = char_at(text, p)
            if e == 117 {                        // \uXXXX
                let cp = _j_hex4(text, p + 1, end)
                if cp >= 0 {
                    out = out + _j_utf8(cp)
                    p = p + 5
                } else {
                    out = out + "u"
                    p = p + 1
                }
            } else {
                out = out + _j_simple_escape(e)
                p = p + 1
            }
        } else {
            out = out + chr(c)
            p = p + 1
        }
    }
    return out
}

// ---- value parsers (share the cursor `pc` = [pos]) -------------------------
fn _j_string(text, pc) {
    if _j_peek(text, pc) != 34 { return _jv(JV_ERR, 0) }
    _j_adv(pc)
    let start = pc[0]
    let n = len(text)
    let has_esc = 0
    let p = start
    let go = 1
    while go == 1 {
        if p >= n { return _jv(JV_ERR, 0) }     // unterminated
        let c = char_at(text, p)
        if c == 92 { has_esc = 1 p = p + 2 }    // skip the escaped char
        else if c == 34 { go = 0 }              // closing quote
        else { p = p + 1 }
    }
    let s = ""
    if has_esc == 0 { s = substr(text, start, p - start) }
    else { s = _j_decode(text, start, p) }
    list_set(pc, 0, p + 1)
    return _jv(JV_STR, s)
}

fn _j_number(text, pc) {
    let start = pc[0]
    let n = len(text)
    let p = start
    let go = 1
    while go == 1 {
        if p >= n { go = 0 }
        else {
            let c = char_at(text, p)
            let ok = 0
            if c >= 48 { if c <= 57 { ok = 1 } }   // 0-9
            if c == 45 { ok = 1 }                  // -
            if c == 43 { ok = 1 }                  // +
            if c == 46 { ok = 1 }                  // .
            if c == 101 { ok = 1 }                 // e
            if c == 69 { ok = 1 }                  // E
            if ok == 1 { p = p + 1 } else { go = 0 }
        }
    }
    if p == start { return _jv(JV_ERR, 0) }
    let raw = substr(text, start, p - start)
    list_set(pc, 0, p)
    return _jv_num(str_to_int(raw), raw)
}

fn _j_lit(text, pc, word, val) {
    let p = pc[0]
    let i = 0
    while i < len(word) {
        if _j_at(text, p + i) != char_at(word, i) { return _jv(JV_ERR, 0) }
        i = i + 1
    }
    list_set(pc, 0, p + len(word))
    return val
}

fn _j_array(text, pc) {
    _j_adv(pc)                                   // consume [
    let items = list_new()
    _j_ws(text, pc)
    if _j_peek(text, pc) == 93 { _j_adv(pc) return _jv(JV_ARR, items) }
    let go = 1
    while go == 1 {
        let v = _j_value(text, pc)
        if json_type(v) == JV_ERR { return v }   // propagate
        push(items, v)
        _j_ws(text, pc)
        let c = _j_peek(text, pc)
        if c == 44 { _j_adv(pc) }                // , -> next
        else if c == 93 { _j_adv(pc) go = 0 }    // ] -> done
        else { return _jv(JV_ERR, 0) }
    }
    return _jv(JV_ARR, items)
}

fn _j_object(text, pc) {
    _j_adv(pc)                                   // consume {
    let pairs = list_new()
    _j_ws(text, pc)
    if _j_peek(text, pc) == 125 { _j_adv(pc) return _jv(JV_OBJ, pairs) }
    let go = 1
    while go == 1 {
        _j_ws(text, pc)
        if _j_peek(text, pc) != 34 { return _jv(JV_ERR, 0) }  // key is a string
        let k = _j_string(text, pc)
        if json_type(k) == JV_ERR { return k }
        _j_ws(text, pc)
        if _j_peek(text, pc) != 58 { return _jv(JV_ERR, 0) }  // :
        _j_adv(pc)
        let v = _j_value(text, pc)
        if json_type(v) == JV_ERR { return v }
        let pair = list_new()
        push(pair, json_str(k))
        push(pair, v)
        push(pairs, pair)
        _j_ws(text, pc)
        let c = _j_peek(text, pc)
        if c == 44 { _j_adv(pc) }                // , -> next member
        else if c == 125 { _j_adv(pc) go = 0 }   // } -> done
        else { return _jv(JV_ERR, 0) }
    }
    return _jv(JV_OBJ, pairs)
}

fn _j_value(text, pc) {
    _j_ws(text, pc)
    let c = _j_peek(text, pc)
    if c == 34 { return _j_string(text, pc) }
    if c == 91 { return _j_array(text, pc) }
    if c == 123 { return _j_object(text, pc) }
    if c == 116 { return _j_lit(text, pc, "true", _jv(JV_BOOL, 1)) }
    if c == 102 { return _j_lit(text, pc, "false", _jv(JV_BOOL, 0)) }
    if c == 110 { return _j_lit(text, pc, "null", _jv(JV_NULL, 0)) }
    if c == 45 { return _j_number(text, pc) }
    if c >= 48 { if c <= 57 { return _j_number(text, pc) } }
    return _jv(JV_ERR, 0)
}

// Parse a whole JSON document; returns the top value (JV_ERR on malformed
// input). Trailing whitespace is tolerated; trailing non-whitespace is ignored.
fn json_parse(text) {
    let pc = list_new()
    push(pc, 0)
    return _j_value(text, pc)
}
