// CrossEngin data: PDF text extraction (P3, ADR-0053).
//
// Purpose
//   Pull readable text out of a PDF so a paper or book can be ingested. PDF
//   shows text with content-stream operators inside BT ... ET (text object)
//   blocks: a literal string `(...)` followed by `Tj`, or an array `[...]` of
//   strings + kerning numbers followed by `TJ`. We scan the BT/ET regions and
//   collect every literal string, decoding PDF's backslash escapes (\(, \), \\,
//   \n, \t, octal \ddd, line-continuation), and join fragments into text. The
//   kerning numbers in TJ arrays sit OUTSIDE the parentheses, so they are
//   naturally ignored.
//
//   Scope (the roadmap's "start with text streams"): this reads the visible
//   strings from UNCOMPRESSED content streams. Many real papers FlateDecode
//   their streams; `pdf_has_flate` reports that, and wiring the existing
//   deflate decoder in front of this is the documented next step.
//
// ADRs implemented: ADR-0053 (ingestion / formats). NOVA dependencies: builtins
//   (chr, char_at, len, substr). CrossEngin dependencies: none.

// ---- byte helpers ----------------------------------------------------------
fn _pdf_match2(b, i, c0, c1) {
    if i + 1 >= len(b) { return 0 }
    if char_at(b, i) != c0 { return 0 }
    if char_at(b, i + 1) != c1 { return 0 }
    return 1
}

fn _pdf_is_octal(c) {
    if c < 48 { return 0 }   // '0'
    if c > 55 { return 0 }   // '7'
    return 1
}

// Decode the escape that begins at b[j] (j points at the char AFTER '\'); push
// the decoded char(s) onto `acc` and return the index just past the escape.
// Handles \n \r \t \b \f \( \) \\ , octal \ddd, and \<eol> line continuation.
fn _pdf_escape(b, n, j, acc_holder) {
    let e = char_at(b, j)
    if e == 110 { list_set(acc_holder, 0, acc_holder[0] + chr(10)) return j + 1 }   // \n
    if e == 114 { list_set(acc_holder, 0, acc_holder[0] + chr(13)) return j + 1 }   // \r
    if e == 116 { list_set(acc_holder, 0, acc_holder[0] + chr(9))  return j + 1 }   // \t
    if e == 98  { list_set(acc_holder, 0, acc_holder[0] + chr(8))  return j + 1 }   // \b
    if e == 102 { list_set(acc_holder, 0, acc_holder[0] + chr(12)) return j + 1 }   // \f
    if e == 40  { list_set(acc_holder, 0, acc_holder[0] + chr(40)) return j + 1 }   // \(
    if e == 41  { list_set(acc_holder, 0, acc_holder[0] + chr(41)) return j + 1 }   // \)
    if e == 92  { list_set(acc_holder, 0, acc_holder[0] + chr(92)) return j + 1 }   // backslash
    if e == 10  { return j + 1 }   // line continuation (LF)
    if e == 13  { if j + 1 < n { if char_at(b, j + 1) == 10 { return j + 2 } } return j + 1 }
    if _pdf_is_octal(e) == 1 {
        let val = e - 48
        let k = j + 1
        let cnt = 1
        while cnt < 3 {
            if k < n { if _pdf_is_octal(char_at(b, k)) == 1 {
                val = val * 8 + (char_at(b, k) - 48)
                k = k + 1
                cnt = cnt + 1
            } else { cnt = 3 } } else { cnt = 3 }
        }
        list_set(acc_holder, 0, acc_holder[0] + chr(val & 255))
        return k
    }
    list_set(acc_holder, 0, acc_holder[0] + chr(e))   // unknown -> literal
    return j + 1
}

// Parse a literal string starting at b[i] == '(' ; returns [decoded, next_index].
// Honors nested balanced parentheses (legal unescaped in PDF strings).
fn _pdf_literal(b, n, i) {
    let acc = list_new()
    push(acc, "")                 // mutable holder so _pdf_escape can append
    let depth = 1
    let j = i + 1
    let go = 1
    while go == 1 {
        if j >= n { go = 0 } else {
            let c = char_at(b, j)
            if c == 92 {                          // backslash escape
                if j + 1 < n { j = _pdf_escape(b, n, j + 1, acc) } else { j = n }
            } else { if c == 40 {                 // nested '('
                depth = depth + 1
                list_set(acc, 0, acc[0] + chr(40))
                j = j + 1
            } else { if c == 41 {                 // ')'
                depth = depth - 1
                if depth == 0 { go = 0 j = j + 1 } else { list_set(acc, 0, acc[0] + chr(41)) j = j + 1 }
            } else {
                list_set(acc, 0, acc[0] + chr(c))
                j = j + 1
            } } }
        }
    }
    let r = list_new()
    push(r, acc[0]); push(r, j)
    return r
}

// Extract the visible text from a PDF's uncompressed content streams. Joins
// string fragments within a text object with spaces and separates text objects
// with newlines.
fn pdf_extract_text(bytes) {
    let n = len(bytes)
    let out = ""
    let in_text = 0
    let i = 0
    while i < n {
        if in_text == 0 {
            if _pdf_match2(bytes, i, 66, 84) == 1 {       // "BT"
                in_text = 1
                i = i + 2
            } else { i = i + 1 }
        } else {
            if _pdf_match2(bytes, i, 69, 84) == 1 {       // "ET"
                in_text = 0
                out = out + "\n"
                i = i + 2
            } else { if char_at(bytes, i) == 40 {         // '(' literal string
                let lit = _pdf_literal(bytes, n, i)
                out = out + lit[0] + " "
                i = lit[1]
            } else {
                i = i + 1
            } }
        }
    }
    return out
}

// True if the PDF declares a FlateDecode filter (its content streams are
// compressed, so pdf_extract_text alone will miss them -- inflate first).
fn pdf_has_flate(bytes) {
    let n = len(bytes)
    let needle = "FlateDecode"
    let m = len(needle)
    let i = 0
    while i + m <= n {
        let k = 0
        let ok = 1
        while k < m {
            if char_at(bytes, i + k) != char_at(needle, k) { ok = 0 k = m } else { k = k + 1 }
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}
