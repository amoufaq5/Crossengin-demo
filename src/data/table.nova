// CrossEngin data: tabular decoder (CSV / Markdown table) (P3, ADR-0053).
//
// Purpose
//   Turn delimited tables into knowledge: parse CSV or Markdown-pipe tables into
//   a small tagged model (mirrors the shape of src/data/json.nova), then project
//   each row into one atom with the column header -> value mapping in its
//   payload. So a research dataset or a spec table becomes queryable atoms
//   instead of opaque text.
//
//   To make imported data flow into the existing analytical-query path
//   (query.nova GROUP BY / SUM / AVG, which read an atom's integer fields), the
//   row projection can OPTIONALLY map a numeric MEASURE column into belief.alpha
//   and a categorical GROUP column into belief.beta (each distinct value gets a
//   small integer code via a returned dictionary). This is a deliberate, scoped
//   reuse of the belief fields as data columns for analytical CSV KGs -- the
//   full row is always preserved in the payload regardless.
//
// ADRs implemented: ADR-0053 (ingestion / formats). NOVA dependencies: builtins
//   (chr, char_at, substr, str_trim, rt_str_to_int, lists). CrossEngin
//   dependencies: src/kg/multi_kg_manager.nova (transitively atom_store).

import "../kg/multi_kg_manager.nova"

// ---- tagged table model ----------------------------------------------------
let TBL_OBJ_TAG = 1990
let TBL_TAG  = 0
let TBL_HEAD = 1   // list of header strings
let TBL_ROWS = 2   // list of rows; each row is a list of cell strings

fn _tbl_new(headers, rows) {
    let t = list_new()
    push(t, TBL_OBJ_TAG)
    push(t, headers)
    push(t, rows)
    return t
}

fn table_headers(t) { return t[TBL_HEAD] }
fn table_rows(t)    { return t[TBL_ROWS] }
fn table_nrows(t)   { return len(t[TBL_ROWS]) }
fn table_ncols(t)   { return len(t[TBL_HEAD]) }

// index of a header (-1 if absent or "").
fn table_col_index(t, header) {
    if len(header) == 0 { return 0 - 1 }
    let h = t[TBL_HEAD]
    let i = 0
    while i < len(h) {
        if str_eq(h[i], header) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

fn table_cell(t, row, col) {
    if row < 0 { return "" }
    if row >= len(t[TBL_ROWS]) { return "" }
    let r = t[TBL_ROWS][row]
    if col < 0 { return "" }
    if col >= len(r) { return "" }
    return r[col]
}

fn table_cell_by(t, row, header) {
    return table_cell(t, row, table_col_index(t, header))
}

// True if `s` is a (signed) integer literal.
fn table_is_int(s) {
    let n = len(s)
    if n == 0 { return 0 }
    let i = 0
    if char_at(s, 0) == 45 { if n == 1 { return 0 } i = 1 }   // leading '-'
    while i < n {
        let c = char_at(s, i)
        if c < 48 { return 0 }
        if c > 57 { return 0 }
        i = i + 1
    }
    return 1
}

fn table_cell_int(t, row, col) {
    let s = table_cell(t, row, col)
    if table_is_int(s) == 1 { return rt_str_to_int(s) }
    return 0
}

// ---- CSV parsing -----------------------------------------------------------
// Split text into lines on '\n', dropping a trailing '\r' (CRLF) and any final
// empty line. Returns a list of line strings.
fn _tbl_lines(text) {
    let out = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {            // '\n'
            let end = i
            if end > start { if char_at(text, end - 1) == 13 { end = end - 1 } }  // '\r'
            push(out, substr(text, start, end - start))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        let end = n
        if char_at(text, end - 1) == 13 { end = end - 1 }
        push(out, substr(text, start, end - start))
    }
    return out
}

// Split one CSV line into fields, honoring "quoted, fields" and "" escapes.
fn _csv_fields(line) {
    let fields = list_new()
    let n = len(line)
    let cur = ""
    let inq = 0
    let i = 0
    while i < n {
        let c = char_at(line, i)
        if inq == 1 {
            if c == 34 {                         // '"'
                if i + 1 < n { if char_at(line, i + 1) == 34 {
                    cur = cur + chr(34)
                    i = i + 2
                } else {
                    inq = 0
                    i = i + 1
                } } else {
                    inq = 0
                    i = i + 1
                }
            } else {
                cur = cur + chr(c)
                i = i + 1
            }
        } else {
            if c == 34 {                         // opening quote
                inq = 1
                i = i + 1
            } else { if c == 44 {                // ','
                push(fields, str_trim(cur))
                cur = ""
                i = i + 1
            } else {
                cur = cur + chr(c)
                i = i + 1
            } }
        }
    }
    push(fields, str_trim(cur))
    return fields
}

// Parse CSV text: the first non-empty line is the header row.
fn table_parse_csv(text) {
    let lines = _tbl_lines(text)
    let headers = list_new()
    let rows = list_new()
    let seen_header = 0
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if len(str_trim(line)) > 0 {
            let fields = _csv_fields(line)
            if seen_header == 0 {
                headers = fields
                seen_header = 1
            } else {
                push(rows, fields)
            }
        }
        i = i + 1
    }
    return _tbl_new(headers, rows)
}

// ---- Markdown-pipe table parsing ------------------------------------------
// Split a "| a | b |" row into trimmed cells, dropping the empty edges.
fn _md_cells(line) {
    let raw = list_new()
    let n = len(line)
    let start = 0
    let i = 0
    while i < n {
        if char_at(line, i) == 124 {           // '|'
            push(raw, substr(line, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(raw, substr(line, start, n - start))
    // trim cells; drop the leading/trailing empties created by the edge pipes.
    let cells = list_new()
    let j = 0
    while j < len(raw) {
        let cell = str_trim(raw[j])
        let edge = 0
        if j == 0 { if len(cell) == 0 { edge = 1 } }
        if j == len(raw) - 1 { if len(cell) == 0 { edge = 1 } }
        if edge == 0 { push(cells, cell) }
        j = j + 1
    }
    return cells
}

// True if a markdown row is the header/body separator ("|---|:--:|").
fn _md_is_separator(cells) {
    if len(cells) == 0 { return 0 }
    let i = 0
    while i < len(cells) {
        let c = cells[i]
        let k = 0
        let dashes = 0
        let ok = 1
        while k < len(c) {
            let ch = char_at(c, k)
            if ch == 45 { dashes = dashes + 1 }       // '-'
            else { if ch != 58 { if ch != 32 { ok = 0 } } }  // ':' or space allowed
            k = k + 1
        }
        if ok == 0 { return 0 }
        if dashes == 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn table_parse_markdown(text) {
    let lines = _tbl_lines(text)
    let headers = list_new()
    let rows = list_new()
    let seen_header = 0
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        let has_pipe = 0
        let p = 0
        while p < len(line) { if char_at(line, p) == 124 { has_pipe = 1 p = len(line) } p = p + 1 }
        if has_pipe == 1 {
            let cells = _md_cells(line)
            if _md_is_separator(cells) == 0 {
                if seen_header == 0 {
                    headers = cells
                    seen_header = 1
                } else {
                    push(rows, cells)
                }
            }
        }
        i = i + 1
    }
    return _tbl_new(headers, rows)
}

// ---- row -> atom projection ------------------------------------------------
// Stable small-int code for a categorical value (assigns the next code on first
// sight). `dict` is a list of [value, code].
fn _tbl_dict_code(dict, value) {
    let i = 0
    while i < len(dict) {
        if str_eq(dict[i][0], value) == 1 { return dict[i][1] }
        i = i + 1
    }
    let code = len(dict)
    let e = list_new(); push(e, value); push(e, code)
    push(dict, e)
    return code
}

// decode a group code back to its categorical value ("" if unknown).
fn table_group_value(dict, code) {
    let i = 0
    while i < len(dict) {
        if dict[i][1] == code { return dict[i][0] }
        i = i + 1
    }
    return ""
}

// Project each row into a FACT atom in `kg`: the full row goes into the payload
// (header -> cell). When `group_header` / `measure_header` name real columns,
// the measure (an integer column) is projected into belief.alpha and the group
// value into belief.beta (via a value->code dictionary), so the rows are
// aggregatable with `SELECT ?g (SUM(?a alpha) AS ?t) WHERE { ?a beta ?g } GROUP
// BY ?g`. Pass "" for either to skip that projection. Returns [atoms, dict].
fn table_to_atoms(kg, t, label_prefix, group_header, measure_header, now) {
    let gcol = table_col_index(t, group_header)
    let mcol = table_col_index(t, measure_header)
    let dict = list_new()
    let atoms = list_new()
    let ncols = table_ncols(t)
    let r = 0
    while r < table_nrows(t) {
        let a = kg_add_atom(kg, ATOM_FACT, label_prefix + "_" + int_to_str(r), now)
        let c = 0
        while c < ncols {
            atom_payload_set(a, t[TBL_HEAD][c], table_cell(t, r, c))
            c = c + 1
        }
        let b = atom_belief(a)
        if mcol >= 0 { list_set(b, 0, table_cell_int(t, r, mcol)) }   // alpha = measure
        if gcol >= 0 {
            list_set(b, 1, _tbl_dict_code(dict, table_cell(t, r, gcol)))  // beta = group code
        }
        push(atoms, a)
        r = r + 1
    }
    let out = list_new()
    push(out, atoms); push(out, dict)
    return out
}
