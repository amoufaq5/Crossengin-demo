// CrossEngin data: knowledge-base bulk-import core (NL_AND_COVERAGE C1).
//
// Purpose
//   Shared helpers for the bulk KB importers (WordNet / ConceptNet / Wikidata)
//   described in NL_AND_COVERAGE.md Section C1. The roadmap's thesis: do not
//   scrape breadth one triple at a time -- import breadth that already exists
//   in curated, structured form, then grow it. This module is the common
//   substrate every importer reuses: a delimiter splitter, dedup-by-label
//   concept interning, curated-KB provenance tagging + belief seeding, and a
//   small stats record so callers get a truthful count of what landed.
//
//   Design (mirrors the existing ingest discipline):
//     * Every imported atom carries provenance "kb:<name>" (ADR-0029 source
//       tagging) so the meta-observer can attribute promotion/atrophy of
//       KB-supplied vs seed vs pack vs user-taught knowledge.
//     * Curated KBs are high-trust: imported atoms seed Beta(KBI_ALPHA,
//       KBI_BETA) -- stronger than fetched evidence, weaker than user-taught,
//       matching the source-authority tiering intent.
//     * Idempotent by label: re-importing finds the existing atom and refreshes
//       its belief instead of duplicating (same contract as au_ingest / packs).
//
//   Transport boundary (honest scope): this module parses a NORMALIZED feed
//   (line records) -- it does NOT read raw WordNet/ConceptNet/Wikidata dumps.
//   An ops-layer converter turns a raw dump into the normalized feed (the same
//   separation `internet_fetch` uses: the module gates+ingests, the transport
//   supplies bytes). Keeps the NOVA side pure and unit-testable.
//
// ADRs: ADR-0029 (source tagging + authority), ADR-0010 (boot-state extension),
//   ADR-0049 (every module has a matching unit test).
// NOVA dependencies: builtins (len, char_at, substr, str_eq, str_trim,
//   list_new, push, list_set). CrossEngin dependencies:
//   src/kg/multi_kg_manager.nova (kg_add_atom, kg_find_atom, atom_*).

import "../kg/multi_kg_manager.nova"

// ---- curated-KB belief prior (high trust, below user-taught) ---------------
let KBI_ALPHA = 3   // Beta(3,1): strong positive prior for a curated source
let KBI_BETA  = 1
let KBI_REOBSERVE = 1   // re-import evidence increment

// ---- import stats record ---------------------------------------------------
//   [concepts_added, concepts_refreshed, words_interned, edges_added,
//    lines_seen, lines_skipped]
let KBI_C_ADDED     = 0
let KBI_C_REFRESHED = 1
let KBI_WORDS       = 2
let KBI_EDGES       = 3
let KBI_LINES       = 4
let KBI_SKIPPED     = 5
let KBI_STAT_FIELDS = 6

fn kbi_new_stats() {
    let s = list_new()
    let i = 0
    while i < KBI_STAT_FIELDS {
        push(s, 0)
        i = i + 1
    }
    return s
}
fn kbi_bump(stats, field) { list_set(stats, field, stats[field] + 1) }

fn kbi_stat_concepts_added(s)     { return s[KBI_C_ADDED] }
fn kbi_stat_concepts_refreshed(s) { return s[KBI_C_REFRESHED] }
fn kbi_stat_words(s)              { return s[KBI_WORDS] }
fn kbi_stat_edges(s)              { return s[KBI_EDGES] }
fn kbi_stat_lines(s)              { return s[KBI_LINES] }
fn kbi_stat_skipped(s)            { return s[KBI_SKIPPED] }

// ---- delimiter split -------------------------------------------------------
// Split `s` on a single ASCII delimiter char code into a list of field strings.
// Empty input -> single empty field. Trailing delimiter -> trailing empty field.
fn kbi_split(s, delim) {
    let fields = list_new()
    let n = len(s)
    let start = 0
    let i = 0
    while i < n {
        if char_at(s, i) == delim {
            push(fields, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(fields, substr(s, start, n - start))
    return fields
}

// Split a feed (LF-separated) into a list of non-empty, trimmed lines.
fn kbi_lines(feed) {
    let raw = kbi_split(feed, 10)   // '\n'
    let out = list_new()
    let i = 0
    while i < len(raw) {
        let ln = str_trim(raw[i])
        if len(ln) > 0 { push(out, ln) }
        i = i + 1
    }
    return out
}

// ---- provenance + belief ---------------------------------------------------
// Tag an atom as KB-sourced and seed its curated-KB belief. New atom only.
fn kbi_mark_new(atom, src_name) {
    atom_payload_set(atom, "provenance", "kb")
    atom_payload_set(atom, "kb_source", src_name)
    let b = atom_belief(atom)
    list_set(b, 0, KBI_ALPHA)
    list_set(b, 1, KBI_BETA)
}

// Refresh an existing atom's belief on re-import (idempotent reinforcement).
fn kbi_mark_refresh(atom) {
    let b = atom_belief(atom)
    list_set(b, 0, b[0] + KBI_REOBSERVE)
}

// Get-or-add a concept atom by label, dedup-safe. Returns the atom; records the
// add/refresh in `stats`. `kind` is one of the ATOM_* kinds from atom_store.
fn kbi_concept(kg, kind, label, src_name, moment, stats) {
    let existing = kg_find_atom(kg, label)
    if existing != 0 {
        kbi_mark_refresh(existing)
        atom_touch(existing, moment)
        kbi_bump(stats, KBI_C_REFRESHED)
        return existing
    }
    let a = kg_add_atom(kg, kind, label, moment)
    kbi_mark_new(a, src_name)
    kbi_bump(stats, KBI_C_ADDED)
    return a
}
