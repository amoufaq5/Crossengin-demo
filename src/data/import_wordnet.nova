// CrossEngin data: WordNet importer (NL_AND_COVERAGE C1, first KB track).
//
// Purpose
//   Bulk-import WordNet into the KG: synsets become CONCEPT atoms, member words
//   intern as language atoms with senses (so SYNONYMY emerges -- many words ->
//   one concept -- and POLYSEMY is preserved -- one word -> many sense
//   concepts), hypernym edges become IS-A operators, antonym edges become
//   OPPOSITE operators. This is the simplest clean KB to import and directly
//   fixes the synonym + word-sense gap the 6-pattern text extractor cannot.
//
//   Normalized feed (one record per line, '|' delimited). An ops converter
//   produces this from a raw WordNet dump (data.noun / index.noun / Prolog
//   files); this module parses the normalized form so it stays pure + testable:
//
//     S|<synset_id>|<primary_word>|<gloss>   define a synset (concept)
//     W|<synset_id>|<word>                   add a member word (synonym)
//     H|<synset_id>|<hypernym_synset_id>     hyponym IS-A hypernym
//     A|<synset_id>|<antonym_synset_id>      synset is the OPPOSITE of antonym
//
//   Concept label = "wn:" + synset_id (NOT the word) so distinct senses of the
//   same word stay distinct atoms (polysemy) and cross-record edges resolve by
//   a stable key. The human-readable primary word + gloss live in the payload;
//   every member word interns a weighted sense to the concept.
//
//   Two passes: pass 1 materializes concepts + words (S, W); pass 2 wires edges
//   (H, A) so a hypernym referenced before its own S record still resolves.
//   Idempotent: re-import refreshes belief + reuses operators by deterministic
//   label rather than duplicating (same contract as the seed packs).
//
// ADRs: ADR-0029 (source tagging), ADR-0031 (reasoning operators), ADR-0015
//   (language atoms), ADR-0049 (matching unit test).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/data/kb_import_core.nova, src/language/word_atoms.nova,
//   src/parts/reasoning/reasoning_atoms.nova.

import "kb_import_core.nova"
import "../language/word_atoms.nova"
import "../parts/reasoning/reasoning_atoms.nova"

let WN_SRC          = "wordnet"
let WN_SENSE_WEIGHT = 800   // curated; just below the seed default (900)

// Stable concept key for a synset id.
fn _wn_concept_label(synset_id) { return "wn:" + synset_id }

// Bind a word form to a concept atom with a weighted sense (the first_atoms
// `_bind` pattern), counting the intern in stats.
fn _wn_bind_word(lang_kg, form, concept, moment, stats) {
    let w = word_intern(lang_kg, form, moment)
    word_add_sense(w, concept, WN_SENSE_WEIGHT)
    kbi_bump(stats, KBI_WORDS)
}

// Get-or-add a reasoning operator by deterministic label (idempotent edges).
// premise/conclusion are atom ids. Returns nothing; bumps KBI_EDGES on add.
fn _wn_edge(rkg, op_kind, premise_id, conclusion_id, label, moment, stats) {
    let existing = kg_find_atom(rkg, label)
    if existing != 0 {
        kbi_mark_refresh(existing)
        return 0
    }
    let op = rop_new(rkg, op_kind, premise_id, conclusion_id, label, moment)
    atom_payload_set(op, "provenance", "kb")
    atom_payload_set(op, "kb_source", WN_SRC)
    kbi_bump(stats, KBI_EDGES)
    return 0
}

// ---- per-record handlers ---------------------------------------------------

// S|synset_id|primary_word|gloss
fn _wn_rec_synset(kg, lang_kg, fields, moment, stats) {
    if len(fields) < 3 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let synset_id = str_trim(fields[1])
    let primary   = str_trim(fields[2])
    if len(synset_id) == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let label = _wn_concept_label(synset_id)
    let c = kbi_concept(kg, ATOM_CONCEPT, label, WN_SRC, moment, stats)
    if len(primary) > 0 {
        atom_payload_set(c, "primary", primary)
        _wn_bind_word(lang_kg, primary, c, moment, stats)
    }
    if len(fields) >= 4 {
        let gloss = str_trim(fields[3])
        if len(gloss) > 0 { atom_payload_set(c, "gloss", gloss) }
    }
    return 0
}

// W|synset_id|word  (member word -> existing concept; synonymy)
fn _wn_rec_word(kg, lang_kg, fields, moment, stats) {
    if len(fields) < 3 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let synset_id = str_trim(fields[1])
    let word      = str_trim(fields[2])
    if len(word) == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let c = kg_find_atom(kg, _wn_concept_label(synset_id))
    if c == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    _wn_bind_word(lang_kg, word, c, moment, stats)
    return 0
}

// H|synset_id|hypernym_synset_id  (hyponym IS-A hypernym -> ROP_IMPLY)
fn _wn_rec_hyper(kg, rkg, fields, moment, stats) {
    if len(fields) < 3 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let hypo  = kg_find_atom(kg, _wn_concept_label(str_trim(fields[1])))
    let hyper = kg_find_atom(kg, _wn_concept_label(str_trim(fields[2])))
    if hypo == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    if hyper == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let label = "wn_isa:" + str_trim(fields[1]) + ">" + str_trim(fields[2])
    _wn_edge(rkg, ROP_IMPLY, atom_id(hypo), atom_id(hyper), label, moment, stats)
    return 0
}

// A|synset_id|antonym_synset_id  (-> ROP_OPPOSITE)
fn _wn_rec_anto(kg, rkg, fields, moment, stats) {
    if len(fields) < 3 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let a1 = kg_find_atom(kg, _wn_concept_label(str_trim(fields[1])))
    let a2 = kg_find_atom(kg, _wn_concept_label(str_trim(fields[2])))
    if a1 == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    if a2 == 0 { kbi_bump(stats, KBI_SKIPPED) return 0 }
    let label = "wn_opp:" + str_trim(fields[1]) + ">" + str_trim(fields[2])
    _wn_edge(rkg, ROP_OPPOSITE, atom_id(a1), atom_id(a2), label, moment, stats)
    return 0
}

// ---- driver ----------------------------------------------------------------
// Import a normalized WordNet feed. `kg` = domain/concept KG, `lang_kg` =
// language KG (words), `rkg` = reasoning KG (operators). Returns stats.
fn wn_import(kg, lang_kg, rkg, feed, moment) {
    let stats = kbi_new_stats()
    let lines = kbi_lines(feed)
    let n = len(lines)

    // Pass 1: concepts + words (S, W).
    let i = 0
    while i < n {
        let ln = lines[i]
        kbi_bump(stats, KBI_LINES)
        let tag = char_at(ln, 0)
        let fields = kbi_split(ln, 124)   // '|'
        if tag == 83 {           // 'S'
            _wn_rec_synset(kg, lang_kg, fields, moment, stats)
        } else {
            if tag == 87 {       // 'W'
                _wn_rec_word(kg, lang_kg, fields, moment, stats)
            }
        }
        i = i + 1
    }

    // Pass 2: edges (H, A) -- concepts now all exist.
    let j = 0
    while j < n {
        let ln = lines[j]
        let tag = char_at(ln, 0)
        let fields = kbi_split(ln, 124)
        if tag == 72 {           // 'H'
            _wn_rec_hyper(kg, rkg, fields, moment, stats)
        } else {
            if tag == 65 {       // 'A'
                _wn_rec_anto(kg, rkg, fields, moment, stats)
            }
        }
        j = j + 1
    }

    return stats
}
