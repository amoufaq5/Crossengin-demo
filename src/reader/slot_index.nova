// CrossEngin reader: syntactic-slot similarity side-index (P2.2).
//
// Purpose
//   Two atoms that have filled the SAME role inside the SAME syntax pattern
//   (ADR-0015) are functionally substitutable -- they pattern-fit the same
//   grammatical "slot" the agent has actually used. This is a second
//   substrate-native similarity signal, complementary to operator edges
//   (semantic causality), cross-KG xrefs (declared similarity), word-sense
//   overlap (lexical polysemy), and co-fire (temporal co-activation).
//
//   The index is keyed by (pattern_atom_id, role_name) and stores a histogram
//   of atom-ids that have FILLED that slot. Two atoms are role-neighbors iff
//   they appear in the same (pattern, role) histogram; the similarity is
//   normalized by the slot's most-frequent filler (so a rare filler can
//   still register full similarity with another rare filler in the same
//   slot, as long as both are equally rare).
//
//   The wiring side -- when si_record_fill fires -- lives in
//   `src/io/effectors/output_generation.nova`'s `gen_resolve` hook: each
//   resolved [role, word_atom] pair records that the slot was filled by
//   that word atom (so over time, every word the agent has used in role
//   "AGENT" of pattern "see_topic" appears in that slot's histogram).
//
//   Storage: a list of [pattern_id, role_name, fills] entries, where `fills`
//   is a list of [atom_id, count] pairs. The pattern id is the syntax atom's
//   numeric atom_id (the pattern atom's identity inside its owning KG); the
//   role is the role-name string from the pattern's slot list. Linear scan
//   for both keys is fine -- patterns are few (<<100 in practice) and roles
//   per pattern even fewer. A hash index is deferred until N hurts.
//
//   si_strength(si, a, b) returns 0..1000 milli for two atom-ids; the math
//   keeps intermediates small (count * 1000 / max_count) so we avoid NOVA's
//   pointer-threshold for large literal multiplies (NEXT_SESSION.md blocker
//   #11). Returns 0 if either atom never filled any slot, or if no slot has
//   them both.
//
//   The slot_index is KG-agnostic -- syntax patterns are normally in the
//   language KG and their fillers are word atoms (also language KG), so we
//   index by raw atom_id. Callers spanning multiple language KGs can include
//   a kg_label in the role string (e.g. "lang:AGENT") to namespace.
//
// ADRs touched: ADR-0015 (syntax atoms + roles), ADR-0013 (output generation
//   fills patterns), ADR-0012 (reader similarity surface).
// NOVA dependencies: builtins (lists). CrossEngin dependencies:
//   src/kg/atom_store.nova (handle_new), src/substrate/node_pool_manager.nova
//   (fp_mul) -- transitively via atom_store.

import "../kg/atom_store.nova"

// ---- index layout --------------------------------------------------------
// Each slot row: [pattern_id, role, fills, max_count] where fills is a list
// of [atom_id, count] entries and max_count is the most-frequent filler in
// THIS slot. Per-slot max is the normalizer for si_strength queries on this
// slot. A small per-slot max keeps the math contained: a single (pattern,
// role) cell is bounded by the run's total gen_resolve calls into that slot.
let SLOT_PAT  = 0
let SLOT_ROLE = 1
let SLOT_FILL = 2
let SLOT_MAX  = 3

// Each fill entry: [atom_id, count].
let SF_ATOM  = 0
let SF_COUNT = 1

// Index header: [SI_TAG, slots]. A "slot" is one [pattern, role] cell with
// its filler histogram.
let SI_TAG     = 0
let SI_SLOTS   = 1
let SI_OBJ_TAG = 2402

fn si_new() {
    let si = list_new()
    push(si, SI_OBJ_TAG)
    push(si, list_new())
    return si
}

fn si_size(si) { return len(si[SI_SLOTS]) }

// Find a slot row by (pattern_id, role). Returns -1 if missing.
fn _si_slot_index(si, pattern_id, role) {
    let slots = si[SI_SLOTS]
    let i = 0
    while i < len(slots) {
        let s = slots[i]
        if s[SLOT_PAT] == pattern_id {
            if str_eq(s[SLOT_ROLE], role) == 1 { return i }
        }
        i = i + 1
    }
    return -1
}

// Find the fill entry for `atom_id` in a slot's histogram. Returns -1 if absent.
fn _si_fill_index(fills, atom_id) {
    let i = 0
    while i < len(fills) {
        if fills[i][SF_ATOM] == atom_id { return i }
        i = i + 1
    }
    return -1
}

// Record that `atom_id` filled `role` in `pattern_id`. Bumps the slot's
// filler count for that atom and updates the slot's max. Returns the new
// count. A 0 pattern_id is silently ignored (caller passed an invalid handle).
fn si_record_fill(si, pattern_id, role, atom_id) {
    if si == 0 { return 0 }
    // pattern_id 0 is rejected as a sentinel: the kg_id-namespaced numeric
    // identity of a syntax pattern atom is unlikely to be 0 in practice, but
    // even if it is the caller meant something specific -- we treat 0 as
    // "no pattern selected" so the hook is a no-op rather than a crash.
    if pattern_id == 0 { return 0 }
    if role == 0 { return 0 }
    if len(role) == 0 { return 0 }
    // Note: atom_id == 0 IS a valid filler. atom-ids start at 0 in every KG
    // (kg[KG_NEXTID] init = 0), so guarding against atom_id == 0 would
    // silently drop the FIRST-born atom of each KG. The caller is
    // responsible for not passing a stale handle.
    let idx = _si_slot_index(si, pattern_id, role)
    if idx == -1 {
        // New slot: install with a single-entry histogram.
        let slot = list_new()
        push(slot, pattern_id)
        push(slot, role)
        let fills = list_new()
        let entry = list_new()
        push(entry, atom_id)
        push(entry, 1)
        push(fills, entry)
        push(slot, fills)
        push(slot, 1)
        push(si[SI_SLOTS], slot)
        return 1
    }
    let slot = si[SI_SLOTS][idx]
    let fills = slot[SLOT_FILL]
    let fi = _si_fill_index(fills, atom_id)
    if fi == -1 {
        let entry = list_new()
        push(entry, atom_id)
        push(entry, 1)
        push(fills, entry)
        // First-time filler with count=1 cannot increase the slot's max above
        // its current value (>= 1 already), so leave SLOT_MAX alone.
        return 1
    }
    let cur = fills[fi][SF_COUNT] + 1
    list_set(fills[fi], SF_COUNT, cur)
    if cur > slot[SLOT_MAX] { list_set(slot, SLOT_MAX, cur) }
    return cur
}

// Raw fill count for (pattern, role, atom). 0 if absent.
fn si_fill_count(si, pattern_id, role, atom_id) {
    if si == 0 { return 0 }
    let idx = _si_slot_index(si, pattern_id, role)
    if idx == -1 { return 0 }
    let fills = si[SI_SLOTS][idx][SLOT_FILL]
    let fi = _si_fill_index(fills, atom_id)
    if fi == -1 { return 0 }
    return fills[fi][SF_COUNT]
}

// Strength of (a, b) at a specific (pattern, role). Returns 0 unless BOTH
// atoms have filled this slot at least once. The combined milli is
//   min(count_a, count_b) * 1000 / slot_max
// so both atoms need slot presence; the rarer one bounds the similarity. The
// product stays small (<< 2^20) for any sane run -- a single slot won't
// see millions of fills.
fn _si_slot_strength(slot, a, b) {
    let fills = slot[SLOT_FILL]
    let ai = _si_fill_index(fills, a)
    if ai == -1 { return 0 }
    let bi = _si_fill_index(fills, b)
    if bi == -1 { return 0 }
    let ca = fills[ai][SF_COUNT]
    let cb = fills[bi][SF_COUNT]
    let lo = ca
    if cb < lo { lo = cb }
    let m = slot[SLOT_MAX]
    if m == 0 { return 0 }
    if lo >= m { return 1000 }
    let scaled = lo * 1000
    let s = scaled / m
    if s < 0 { return 0 }
    if s > 1000 { return 1000 }
    return s
}

// Combined strength across ALL slots: sum the per-slot strengths and clamp
// to 1000. Two atoms that co-fill many slots are stronger neighbors than two
// that share one. (find_neighbors_full further sums this with operator,
// xref, sense, and cofire evidence and clamps at 1000 once more -- the
// double-clamp is intentional, it bounds the result regardless of how many
// sources fire.)
fn si_strength(si, a, b) {
    if si == 0 { return 0 }
    if a == b { return 0 }
    // Note: a == 0 / b == 0 are VALID atom ids (first-born atom of each KG),
    // not sentinels. We rely on `a != b` plus the "atom must appear in some
    // slot" check inside _si_slot_strength to filter genuinely-uninvolved
    // ids -- if neither has filled any slot, total stays 0.
    let total = 0
    let slots = si[SI_SLOTS]
    let i = 0
    while i < len(slots) {
        let s = _si_slot_strength(slots[i], a, b)
        total = total + s
        if total >= 1000 { return 1000 }
        i = i + 1
    }
    if total < 0 { return 0 }
    if total > 1000 { return 1000 }
    return total
}

// Convenience: handle-form. Note slot_index is keyed by atom_id only -- the
// kg label is ignored for the lookup (callers should ensure their syntax KG
// is consistent). A future enhancement could namespace by kg_label, but the
// language KG is singular per session today.
fn si_strength_h(si, ha, hb) {
    if ha == 0 { return 0 }
    if hb == 0 { return 0 }
    return si_strength(si, ha[1], hb[1])
}

// Enumerate role-neighbors of `atom_id`: all OTHER atoms that share at least
// one (pattern, role) cell with it, with their combined slot-strength. The
// returned handles use `kg_label` for all entries (callers pass the KG label
// of the source). `weight_scale` is the hop-decay scale (FP_SCALE = no decay).
fn si_neighbors(si, kg_label, atom_id, weight_scale) {
    let out = list_new()
    if si == 0 { return out }
    // Note: atom_id == 0 is a valid filler (first-born atom of the KG). If
    // it has never filled any slot, the inner loops produce an empty `seen`
    // list and we still return an empty `out` -- no special-case needed.
    // Collect candidate atom-ids that share a slot with `atom_id`.
    let seen = list_new()
    let slots = si[SI_SLOTS]
    let i = 0
    while i < len(slots) {
        let s = slots[i]
        let fills = s[SLOT_FILL]
        let my = _si_fill_index(fills, atom_id)
        if my != -1 {
            let j = 0
            while j < len(fills) {
                let other = fills[j][SF_ATOM]
                if other != atom_id {
                    // Has this candidate already been added?
                    let k = 0
                    let known = 0
                    while k < len(seen) {
                        if seen[k] == other { known = 1 }
                        k = k + 1
                    }
                    if known == 0 { push(seen, other) }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    // For every distinct candidate, compute the aggregated strength.
    let n = 0
    while n < len(seen) {
        let other_id = seen[n]
        let raw = si_strength(si, atom_id, other_id)
        if raw > 0 {
            let scaled = fp_mul(raw, weight_scale)
            if scaled > 0 {
                let nh = handle_new(kg_label, other_id)
                let entry = list_new()
                push(entry, nh)
                push(entry, scaled)
                push(out, entry)
            }
        }
        n = n + 1
    }
    return out
}
