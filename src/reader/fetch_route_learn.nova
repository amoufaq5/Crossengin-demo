// CrossEngin reader: stage 5 -- fetch / route / learn.
//
// Purpose
//   Resolution or learning (ADR-0012 stage 5). On an accepted (coherent) read,
//   the percept is marked for routing toward the relevant parts (by symbolic
//   target name, e.g. "reasoning") and the contributing word anchors are
//   strengthened (Hebbian/use, ADR-0012/0023). On an escalated (low-coherence or
//   out-of-vocabulary) read, a learning trigger is raised: ask-the-user
//   (ADR-0027) for unknown tokens, or whitelisted fetch (ADR-0028) when the
//   words are known but the reading did not cohere. The fetch/ask mechanisms are
//   Phase 5; this stage produces the trigger.
//
//   Layering note: the reader deliberately does NOT import the substrate gate
//   router. Converting these symbolic route targets into gate-routed part
//   signals is the agent layer's job (Phase 7). This also sidesteps a NOVA
//   import-dedup limitation -- pulling both the kg subtree and a substrate
//   sibling module into one compile unit double-includes shared modules (see
//   NEXT_SESSION.md NOVA blockers).
//
// ADRs implemented: ADR-0012 (stage 5), ADR-0023 (anchor strengthening on
//   success). Hooks ADR-0027/0028 (learning triggers), ADR-0009 (routing, at the
//   agent layer).
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/reader/lexical_anchor.nova (renv/rctx, word
//   atoms; signal_dispatch transitively).

import "lexical_anchor.nova"

// Symbolic route target for a comprehended percept (mapped to a part by the
// agent layer). A request/event drives reasoning.
let ROUTE_REASONING = "reasoning"

// Stage 5. Returns the learn trigger (LEARN_NONE / LEARN_ASK_USER / LEARN_FETCH).
fn reader_route(e, c) {
    if rctx_accepted(c) == 1 {
        // Mark the bound percept for routing toward reasoning.
        push(rctx_routes(c), ROUTE_REASONING)
        // Learn: strengthen the matched anchors (success reinforces lexicon).
        let anchors = rctx_anchors(c)
        let j = 0
        while j < len(anchors) {
            if anchor_matched(anchors[j]) == 1 {
                word_observe(anchor_word(anchors[j]), 1)
            }
            j = j + 1
        }
        list_set(c, RC_LEARN, LEARN_NONE)
        return LEARN_NONE
    }

    // Escalation: unknown tokens -> ask the user; otherwise -> fetch.
    let trigger = LEARN_FETCH
    if len(rctx_curiosity(c)) > 0 { trigger = LEARN_ASK_USER }
    list_set(c, RC_LEARN, trigger)
    return trigger
}

fn reader_learn(c) { return rctx_learn(c) }
