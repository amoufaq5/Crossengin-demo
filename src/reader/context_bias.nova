// CrossEngin reader: stage 2 -- context bias.
//
// Purpose
//   Top-down disambiguation (ADR-0012 stage 2). Given the active context (recent
//   concepts, soul/goal state -- here, a list of context concept atoms), bias
//   pre-weights the likely sense of each polysemous word anchored in stage 1.
//   For each matched anchor, it picks the word sense whose concept embedding is
//   most similar to the context bias vector (the centroid of the context
//   concepts), and emits an XSIG_PREDICT signal pre-weighting that sense. With
//   no context it falls back to the dominant (highest-weighted) sense. This is
//   the top-down half of the hybrid reader (ADR-0011).
//
// ADRs implemented: ADR-0012 (stage 2, context bias), ADR-0011 (predictive
//   top-down component).
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/reader/lexical_anchor.nova (renv/rctx, resolve),
//   transitively word_atoms / cross_kg_references / atom_store / signal_dispatch.

import "lexical_anchor.nova"

// Centroid of a list of context concept atoms' embeddings (zero vec if empty).
fn _bias_centroid(concepts) {
    let dims = ATOM_EMBED_DIMS
    let v = vec_new(dims)
    let n = len(concepts)
    if n == 0 { return v }
    let i = 0
    while i < n {
        let e = atom_embed(concepts[i])
        let d = 0
        while d < dims {
            vec_set(v, d, vec_get(v, d) + vec_get(e, d))
            d = d + 1
        }
        i = i + 1
    }
    let d2 = 0
    while d2 < dims {
        vec_set(v, d2, vec_get(v, d2) / n)
        d2 = d2 + 1
    }
    return v
}

fn _sense_handle(s) { return handle_new(xref_dst_kg(s), xref_dst_atom(s)) }

// The highest-weighted sense reference.
fn _dominant_sense(senses) {
    let best = senses[0]
    let i = 1
    while i < len(senses) {
        if xref_weight(senses[i]) > xref_weight(best) { best = senses[i] }
        i = i + 1
    }
    return best
}

// Choose a sense: with context, the one whose concept embedding best matches the
// bias vector; without context (or all senses unresolvable), the dominant sense.
fn _choose_sense(e, senses, bias, has_ctx) {
    if len(senses) == 1 { return senses[0] }
    if has_ctx == 0 { return _dominant_sense(senses) }
    let best = senses[0]
    let best_sim = 0 - 1
    let found = 0
    let i = 0
    while i < len(senses) {
        let ca = renv_resolve(e, _sense_handle(senses[i]))
        if ca != 0 {
            let sim = vec_cosine(atom_embed(ca), bias)
            if sim > best_sim {
                best_sim = sim
                best = senses[i]
                found = 1
            }
        }
        i = i + 1
    }
    if found == 0 { return _dominant_sense(senses) }
    return best
}

// Stage 2: select a sense for each matched, sense-bearing anchor and record it
// on the anchor; emit an XSIG_PREDICT per resolution. Returns the number of
// anchors whose sense was set.
fn reader_bias(e, c, context_concepts) {
    let bias = _bias_centroid(context_concepts)
    let has_ctx = 0
    if len(context_concepts) > 0 { has_ctx = 1 }
    let predicts = rctx_predict(c)
    let anchors = rctx_anchors(c)
    let resolved = 0
    let i = 0
    while i < len(anchors) {
        let a = anchors[i]
        if anchor_matched(a) == 1 {
            let senses = word_senses(anchor_word(a))
            if len(senses) > 0 {
                let chosen = _choose_sense(e, senses, bias, has_ctx)
                list_set(a, AN_SENSE, _sense_handle(chosen))
                push(predicts, sig_new(XSIG_PREDICT, -1, -1, xref_weight(chosen), 0, xref_dst_atom(chosen)))
                resolved = resolved + 1
            }
        }
        i = i + 1
    }
    return resolved
}
