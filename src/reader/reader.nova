// CrossEngin reader: the five-stage hybrid input processor.
//
// Purpose
//   Composes the five reader stages into one pass over an input utterance
//   (ADR-0011/0012). The reader is a configuration of atoms and signals, not a
//   parser and not an LLM (ADR-0014): it anchors tokens to word atoms, biases
//   senses by context, spreads activation over the knowledge graph, checks
//   coherence, and either routes the comprehended percept or raises a learning
//   trigger. All cognition is substrate/KG activation; no LLM is touched.
//
//   reader_read returns the read context (rctx) with every stage's output:
//   anchors + signals (stage 1), chosen senses + predictions (stage 2), the
//   settled active concept set (stage 3), coherence + bindings (stage 4), and
//   route targets / learn trigger (stage 5).
//
// ADRs implemented: ADR-0011 (hybrid reader), ADR-0012 (five stages), ADR-0014
//   (no LLM in comprehension).
// NOVA dependencies: builtins.
// CrossEngin dependencies: all five reader stage modules under src/reader/.

import "lexical_anchor.nova"
import "context_bias.nova"
import "spreading_activation.nova"
import "coherence_check.nova"
import "fetch_route_learn.nova"

// Convenience constructor: a reader environment over the knowledge registry, the
// language KG, and the concept layer. Part registry / gate are supplied at the
// agent layer (Phase 7), so they default to none here.
fn reader_new(kg_reg, lang_kg, clayer) {
    return renv_new(kg_reg, lang_kg, clayer, 0, 0)
}

// Read an utterance with the given active-context concepts. Runs all five
// stages and returns the populated read context.
fn reader_read(e, text, context_concepts) {
    let c = rctx_new(text)
    reader_anchor(e, c)
    reader_bias(e, c, context_concepts)
    reader_spread(e, c)
    reader_cohere(e, c)
    reader_route(e, c)
    return c
}

// Read with no prior context.
fn reader_read_plain(e, text) {
    return reader_read(e, text, list_new())
}

// Summary accessors over a completed read.
fn reader_matched(c)      { return rctx_matched_count(c) }
fn reader_unknown(c)      { return len(rctx_curiosity(c)) }
fn reader_active_count(c) { return len(rctx_active(c)) }
fn reader_was_accepted(c) { return rctx_accepted(c) }
fn reader_coherence(c)    { return rctx_coherence(c) }
fn reader_trigger(c)      { return rctx_learn(c) }
