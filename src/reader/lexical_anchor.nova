// CrossEngin reader: stage 1 -- lexical anchor (and shared reader state).
//
// Purpose
//   The reader is a five-stage hybrid input processor (ADR-0011/0012): NOT a
//   parser, NOT an LLM. Stage 1 tokenizes surface text and matches each token to
//   a word atom in the language KG (ADR-0015), emitting an XSIG_SENSORY signal
//   (tagged with the matched atom id) per match and an XSIG_CURIOSITY signal per
//   unmatched (out-of-vocabulary) token -- the curiosity signal is what later
//   triggers learning (ADR-0012 stage 5).
//
//   This module also defines the shared reader environment (renv: the KGs,
//   concept layer, part registry, and gate the stages operate over) and the
//   per-read context (rctx) threaded through all five stages, so the later
//   stage modules depend on it without a cycle.
//
// ADRs implemented: ADR-0012 (stage 1, lexical anchor), ADR-0011 (reader is a
//   configuration of atoms/signals), ADR-0014 (text/STT tokens only; no LLM).
// NOVA dependencies: builtins (split, str_trim, len).
// CrossEngin dependencies: src/language/word_atoms.nova,
//   src/substrate/signal_dispatch.nova.

import "../language/word_atoms.nova"
import "../substrate/signal_dispatch.nova"
import "../util/str_safe.nova"

let ANCHOR_LOW_CONF = 100   // 0.1 confidence for an unmatched token

// ---- reader environment ---------------------------------------------------
let REN_TAG     = 0
let REN_KGREG   = 1   // multi-KG registry
let REN_LANG    = 2   // language KG
let REN_CLAYER  = 3   // concept layer (may be 0 in stage-1-only use)
let REN_PARTREG = 4   // substrate part registry (may be 0)
let REN_GATE    = 5   // gate router (may be 0)
let REN_OBJ_TAG = 2101

fn renv_new(kg_reg, lang_kg, clayer, part_reg, gate) {
    let e = list_new()
    push(e, REN_OBJ_TAG)
    push(e, kg_reg)
    push(e, lang_kg)
    push(e, clayer)
    push(e, part_reg)
    push(e, gate)
    return e
}

fn renv_kgreg(e)   { return e[REN_KGREG] }
fn renv_lang(e)    { return e[REN_LANG] }
fn renv_clayer(e)  { return e[REN_CLAYER] }
fn renv_partreg(e) { return e[REN_PARTREG] }
fn renv_gate(e)    { return e[REN_GATE] }

// Resolve a (kg_id, atom_id) handle to its atom, or 0.
fn renv_resolve(e, handle) {
    if handle == 0 { return 0 }
    let kg = kg_find(renv_kgreg(e), handle_kg(handle))
    if kg == 0 { return 0 }
    return kg_atom(kg, handle_atom(handle))
}

// ---- anchor record --------------------------------------------------------
let AN_TOKEN   = 0
let AN_WORD    = 1   // matched word atom, or 0
let AN_CONF    = 2
let AN_MATCHED = 3
let AN_SENSE   = 4   // chosen sense handle (filled by stage 2), or 0

fn anchor_token(a)   { return a[AN_TOKEN] }
fn anchor_word(a)    { return a[AN_WORD] }
fn anchor_conf(a)    { return a[AN_CONF] }
fn anchor_matched(a) { return a[AN_MATCHED] }
fn anchor_sense(a)   { return a[AN_SENSE] }

// ---- read context (threaded through the five stages) ----------------------
let RC_TAG       = 0
let RC_TEXT      = 1
let RC_TOKENS    = 2
let RC_ANCHORS   = 3
let RC_SENSORY   = 4   // XSIG_SENSORY / XSIG_CURIOSITY signals from stage 1
let RC_CURIOSITY = 5   // unmatched token strings
let RC_ACT       = 6   // activation: list of [handle, activation] (stage 3)
let RC_ACTIVE    = 7   // settled active concept handles (stage 3)
let RC_COHERENCE = 8   // coherence score, milli (stage 4)
let RC_BINDINGS  = 9   // bound atom groups (stage 4)
let RC_ACCEPTED  = 10  // 1 accept, 0 escalate (stage 4)
let RC_ROUTES    = 11  // destination part ids (stage 5)
let RC_LEARN     = 12  // learn trigger (stage 5)
let RC_PREDICT   = 13  // XSIG_PREDICT signals from context bias (stage 2)
let RC_OBJ_TAG   = 2102

// Learn triggers (stage 5).
let LEARN_NONE     = 0
let LEARN_ASK_USER = 1
let LEARN_FETCH    = 2

fn rctx_new(text) {
    let c = list_new()
    push(c, RC_OBJ_TAG)
    push(c, text)
    push(c, list_new())   // tokens
    push(c, list_new())   // anchors
    push(c, list_new())   // sensory signals
    push(c, list_new())   // curiosity
    push(c, list_new())   // activation
    push(c, list_new())   // active
    push(c, 0)            // coherence
    push(c, list_new())   // bindings
    push(c, 0)            // accepted
    push(c, list_new())   // routes
    push(c, LEARN_NONE)   // learn
    push(c, list_new())   // predict signals
    return c
}

fn rctx_text(c)      { return c[RC_TEXT] }
fn rctx_tokens(c)    { return c[RC_TOKENS] }
fn rctx_anchors(c)   { return c[RC_ANCHORS] }
fn rctx_sensory(c)   { return c[RC_SENSORY] }
fn rctx_curiosity(c) { return c[RC_CURIOSITY] }
fn rctx_activation(c){ return c[RC_ACT] }
fn rctx_active(c)    { return c[RC_ACTIVE] }
fn rctx_coherence(c) { return c[RC_COHERENCE] }
fn rctx_bindings(c)  { return c[RC_BINDINGS] }
fn rctx_accepted(c)  { return c[RC_ACCEPTED] }
fn rctx_routes(c)    { return c[RC_ROUTES] }
fn rctx_learn(c)     { return c[RC_LEARN] }
fn rctx_predict(c)   { return c[RC_PREDICT] }

fn rctx_matched_count(c) {
    let anchors = c[RC_ANCHORS]
    let n = 0
    let i = 0
    while i < len(anchors) {
        if anchor_matched(anchors[i]) == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Tokenize text: lowercase + trim the whole string, split on spaces, drop empty
// tokens. (Punctuation handling is intentionally minimal at this stage.)
fn reader_tokenize(text) {
    let raw = split_space(lang_normalize(text))
    let out = list_new()
    let i = 0
    while i < len(raw) {
        let t = str_trim(raw[i])
        if len(t) > 0 { push(out, t) }
        i = i + 1
    }
    return out
}

// Stage 1: anchor each token to a word atom. Fills tokens, anchors, sensory
// signals, and the curiosity list. Returns the number of matched tokens.
fn reader_anchor(e, c) {
    let tokens = reader_tokenize(rctx_text(c))
    list_set(c, RC_TOKENS, tokens)
    let anchors = c[RC_ANCHORS]
    let sensory = c[RC_SENSORY]
    let curiosity = c[RC_CURIOSITY]
    let i = 0
    while i < len(tokens) {
        let tok = tokens[i]
        let w = 0
        let span = 1
        // R48: prefer a learned bigram. The R45 extractor mints compound atoms
        // ("lung cancer" -> lung_cancer); without this, free-text "lung cancer"
        // tokenizes to lung + cancer and never anchors the compound concept.
        if i + 1 < len(tokens) {
            let bigram = tokens[i] + "_" + tokens[i + 1]
            let bw = word_find_morph(renv_lang(e), bigram)
            if bw != 0 {
                tok = bigram
                w = bw
                span = 2
            }
        }
        if w == 0 { w = word_find_morph(renv_lang(e), tok) }
        let anchor = list_new()
        push(anchor, tok)
        if w != 0 {
            push(anchor, w)
            push(anchor, word_confidence(w))
            push(anchor, 1)
            push(anchor, 0)
            push(sensory, sig_new(XSIG_SENSORY, -1, -1, word_confidence(w), 0, atom_id(w)))
        } else {
            push(anchor, 0)
            push(anchor, ANCHOR_LOW_CONF)
            push(anchor, 0)
            push(anchor, 0)
            push(curiosity, tok)
            push(sensory, sig_new(XSIG_CURIOSITY, -1, -1, ANCHOR_LOW_CONF, 0, 0))
        }
        push(anchors, anchor)
        i = i + span
    }
    return rctx_matched_count(c)
}
