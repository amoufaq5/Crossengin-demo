// CrossEngin reader: stage 3 -- spreading activation.
//
// Purpose
//   The bottom-up meaning engine (ADR-0012 stage 3). Activation seeded on the
//   sense concepts chosen in stage 2 spreads over cross-KG reference edges
//   (ADR-0017) for a bounded number of hops, with per-hop decay, accumulating in
//   an activation map. The substrate "settles" toward the most coherent concept
//   set: atoms whose accumulated activation clears a threshold are the active
//   interpretation. Conceptually this emits XSIG_EXCITE along edges; the settled
//   active set is the stage's product.
//
// ADRs implemented: ADR-0012 (stage 3, spreading activation), ADR-0011 (the
//   bottom-up half), ADR-0017 (spreads over cross-KG references).
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/reader/lexical_anchor.nova (renv/rctx, resolve;
//   transitively atom_store fp/vectors, cross_kg xref accessors, handles).

import "lexical_anchor.nova"

let SPREAD_SEED      = 1000   // 1.0 seed activation on a chosen sense
let SPREAD_DECAY     = 500    // 0.5 activation retained per hop
let SPREAD_THRESHOLD = 200    // 0.2 settle threshold to count as active
let SPREAD_HOPS      = 2      // bounded spread depth

// Activation accumulator: a list of [handle, activation] entries.
fn _act_index(acts, handle) {
    let i = 0
    while i < len(acts) {
        if handle_eq(acts[i][0], handle) == 1 { return i }
        i = i + 1
    }
    return -1
}

fn _act_add(acts, handle, delta) {
    let idx = _act_index(acts, handle)
    if idx == -1 {
        let entry = list_new()
        push(entry, handle)
        push(entry, delta)
        push(acts, entry)
    } else {
        list_set(acts[idx], 1, acts[idx][1] + delta)
    }
}

fn _act_get(acts, handle) {
    let idx = _act_index(acts, handle)
    if idx == -1 { return 0 }
    return acts[idx][1]
}

// Activation an atom reached after spreading (0 if none).
fn reader_activation(c, handle) {
    return _act_get(rctx_activation(c), handle)
}

// Is an atom in the settled active set?
fn reader_is_active(c, handle) {
    let active = rctx_active(c)
    let i = 0
    while i < len(active) {
        if handle_eq(active[i], handle) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Stage 3: seed from chosen senses, spread over cross-KG edges with decay, and
// settle. Fills rctx activation and active set. Returns the active-set size.
fn reader_spread(e, c) {
    let acts = rctx_activation(c)
    let frontier = list_new()
    let anchors = rctx_anchors(c)

    // Seed activation on each anchor's chosen sense.
    let i = 0
    while i < len(anchors) {
        let a = anchors[i]
        if anchor_matched(a) == 1 {
            let h = anchor_sense(a)
            if h != 0 {
                _act_add(acts, h, SPREAD_SEED)
                push(frontier, h)
            }
        }
        i = i + 1
    }

    // Spread over cross-KG references for a bounded number of hops.
    let hop = 0
    while hop < SPREAD_HOPS {
        let next = list_new()
        let f = 0
        while f < len(frontier) {
            let h = frontier[f]
            let atom = renv_resolve(e, h)
            if atom != 0 {
                let src = _act_get(acts, h)
                let xr = atom_xrefs(atom)
                let j = 0
                while j < len(xr) {
                    let nh = handle_new(xref_dst_kg(xr[j]), xref_dst_atom(xr[j]))
                    let delta = fp_mul(xref_weight(xr[j]), fp_mul(src, SPREAD_DECAY))
                    if delta > 0 {
                        _act_add(acts, nh, delta)
                        push(next, nh)
                    }
                    j = j + 1
                }
            }
            f = f + 1
        }
        frontier = next
        hop = hop + 1
    }

    // Settle: atoms above threshold form the active interpretation.
    let active = rctx_active(c)
    let k = 0
    while k < len(acts) {
        if acts[k][1] >= SPREAD_THRESHOLD {
            push(active, acts[k][0])
        }
        k = k + 1
    }
    return len(active)
}
