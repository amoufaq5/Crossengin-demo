// CrossEngin reader: stage 3 -- spreading activation.
//
// Purpose
//   The bottom-up meaning engine (ADR-0012 stage 3). Activation seeded on the
//   sense concepts chosen in stage 2 spreads over cross-KG reference edges
//   (ADR-0017) for a bounded number of hops, with per-hop decay, accumulating in
//   an activation map. The substrate "settles" toward the most coherent concept
//   set: atoms whose accumulated activation clears a threshold are the active
//   interpretation. Conceptually this emits XSIG_EXCITE along edges; the settled
//   active set is the stage's product.
//
//   Phase 14 / Tier 2 #2: structural-neighborhood activation. The classic
//   spreading path requires a matched anchor with a chosen sense. A paraphrase
//   that fails the lexical anchor (or anchors at a different surface form than
//   the operator-chain seeds) misses the target concept entirely. This stage now
//   ALSO feeds activations into the frontier from the neighborhood substrate:
//     - For an exact-match anchor's chosen sense, find_neighbors runs and its
//       similarity-weighted neighbors are added to the activation map (additive
//       to the SPREAD_SEED on the sense itself; exact match still dominates).
//     - For an unmatched token, lexical_fallback_candidates seeds activation on
//       concept handles named by lexically-similar known words, also at
//       similarity strength so spurious matches stay low.
//   The expanded frontier is then spread for SPREAD_HOPS as before, so a known
//   atom reached via neighborhood still benefits from cross-KG xref spreading.
//
// ADRs implemented: ADR-0012 (stage 3, spreading activation), ADR-0011 (the
//   bottom-up half), ADR-0017 (spreads over cross-KG references), ADR-0031
//   (operator-edge neighborhood via neighborhood.nova).
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/reader/neighborhood.nova (find_neighbors,
//   lexical_fallback_candidates; transitively lexical_anchor for renv/rctx).

import "neighborhood.nova"

let SPREAD_SEED      = 1000   // 1.0 seed activation on a chosen sense
let SPREAD_DECAY     = 500    // 0.5 activation retained per hop
let SPREAD_THRESHOLD = 200    // 0.2 settle threshold to count as active
let SPREAD_HOPS      = 2      // bounded spread depth

// Structural-neighborhood seeding budget. Neighborhood entries are added
// ADDITIONALLY to the activation map; their strength comes directly from the
// neighborhood similarity (so spurious matches stay low). The neighbor count
// caps and hop depth come from these constants. Exact matches still get full
// SPREAD_SEED -- the neighborhood contribution is on top of that.
let NEIGH_SEED_HOPS    = 2    // hops for find_neighbors inside the reader
let NEIGH_SEED_RESULTS = 8    // max neighbors seeded per anchor
let NEIGH_FALLBACK_TOP = 4    // max concept seeds from lexical fallback

// Activation accumulator: a list of [handle, activation] entries.
fn _act_index(acts, handle) {
    let i = 0
    while i < len(acts) {
        if handle_eq(acts[i][0], handle) == 1 { return i }
        i = i + 1
    }
    return -1
}

fn _act_add(acts, handle, delta) {
    let idx = _act_index(acts, handle)
    if idx == -1 {
        let entry = list_new()
        push(entry, handle)
        push(entry, delta)
        push(acts, entry)
    } else {
        list_set(acts[idx], 1, acts[idx][1] + delta)
    }
}

fn _act_get(acts, handle) {
    let idx = _act_index(acts, handle)
    if idx == -1 { return 0 }
    return acts[idx][1]
}

// Activation an atom reached after spreading (0 if none).
fn reader_activation(c, handle) {
    return _act_get(rctx_activation(c), handle)
}

// Is an atom in the settled active set?
fn reader_is_active(c, handle) {
    let active = rctx_active(c)
    let i = 0
    while i < len(active) {
        if handle_eq(active[i], handle) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Seed structural-neighborhood activations from a single chosen-sense handle.
// The exact-match anchor still gets full SPREAD_SEED; this adds its neighbors
// at their similarity strength so related concepts join the frontier too.
// Returns the number of neighbor handles pushed onto `frontier`.
fn _seed_neighborhood(e, acts, frontier, sense_handle) {
    let nbrs = find_neighbors(renv_kgreg(e), sense_handle, NEIGH_SEED_HOPS, NEIGH_SEED_RESULTS)
    let n = 0
    let i = 0
    while i < len(nbrs) {
        let nh = nbrs[i][0]
        let strength = nbrs[i][1]
        if strength > 0 {
            _act_add(acts, nh, strength)
            push(frontier, nh)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Seed activation from a lexical fallback: the token had no exact word atom,
// so look up lexically-similar known words and seed their senses at the
// fallback similarity strength (already milli, already similarity-weighted).
fn _seed_lexical_fallback(e, acts, frontier, token) {
    let cands = lexical_fallback_candidates(renv_kgreg(e), renv_lang(e), token, NEIGH_FALLBACK_TOP)
    let n = 0
    let i = 0
    while i < len(cands) {
        let ch = cands[i][0]
        let strength = cands[i][1]
        if strength > 0 {
            _act_add(acts, ch, strength)
            push(frontier, ch)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Stage 3: seed from chosen senses, spread over cross-KG edges with decay, and
// settle. Fills rctx activation and active set. Returns the active-set size.
fn reader_spread(e, c) {
    let acts = rctx_activation(c)
    let frontier = list_new()
    let anchors = rctx_anchors(c)

    // Seed activation on each anchor's chosen sense -- and on its structural
    // neighborhood (operator + xref + word-sense). Unmatched anchors fall
    // through to a lexical fallback over the language KG.
    let i = 0
    while i < len(anchors) {
        let a = anchors[i]
        if anchor_matched(a) == 1 {
            let h = anchor_sense(a)
            if h != 0 {
                _act_add(acts, h, SPREAD_SEED)
                push(frontier, h)
                _seed_neighborhood(e, acts, frontier, h)
            }
        } else {
            _seed_lexical_fallback(e, acts, frontier, anchor_token(a))
        }
        i = i + 1
    }

    // Spread over cross-KG references for a bounded number of hops.
    let hop = 0
    while hop < SPREAD_HOPS {
        let next = list_new()
        let f = 0
        while f < len(frontier) {
            let h = frontier[f]
            let atom = renv_resolve(e, h)
            if atom != 0 {
                let src = _act_get(acts, h)
                let xr = atom_xrefs(atom)
                let j = 0
                while j < len(xr) {
                    let nh = handle_new(xref_dst_kg(xr[j]), xref_dst_atom(xr[j]))
                    let delta = fp_mul(xref_weight(xr[j]), fp_mul(src, SPREAD_DECAY))
                    if delta > 0 {
                        _act_add(acts, nh, delta)
                        push(next, nh)
                    }
                    j = j + 1
                }
            }
            f = f + 1
        }
        frontier = next
        hop = hop + 1
    }

    // Settle: atoms above threshold form the active interpretation.
    let active = rctx_active(c)
    let k = 0
    while k < len(acts) {
        if acts[k][1] >= SPREAD_THRESHOLD {
            push(active, acts[k][0])
        }
        k = k + 1
    }
    return len(active)
}
