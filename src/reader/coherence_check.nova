// CrossEngin reader: stage 4 -- coherence check.
//
// Purpose
//   Validate the settled pattern (ADR-0012 stage 4): do the co-active atoms
//   mutually reference one another? Coherence is the density of cross-reference
//   edges *within* the active set (edges among active atoms per active atom, in
//   milli). High coherence with no unmatched tokens -> accept and bind the group
//   (conceptually XSIG_BIND); low coherence or any out-of-vocabulary token ->
//   escalate to stage 5 (conceptually residual XSIG_ERROR).
//
// ADRs implemented: ADR-0012 (stage 4, coherence/binding), ADR-0008 (binding of
//   co-active atoms).
// NOVA dependencies: builtins (lists).
// CrossEngin dependencies: src/reader/lexical_anchor.nova (renv/rctx, resolve,
//   handles; transitively atom_store, cross_kg xref accessors).

import "lexical_anchor.nova"

let COHERE_ACCEPT = 600   // 0.6 minimum coherence to accept (else escalate)

fn _in_active(active, handle) {
    let i = 0
    while i < len(active) {
        if handle_eq(active[i], handle) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Coherence (milli): cross-reference edges within the active set, per active
// atom (capped at 1.0). A single active atom is trivially coherent; an empty
// set is incoherent.
fn _coherence(e, active) {
    let n = len(active)
    if n == 0 { return 0 }
    if n == 1 { return 1000 }
    let edges = 0
    let i = 0
    while i < n {
        let atom = renv_resolve(e, active[i])
        if atom != 0 {
            let xr = atom_xrefs(atom)
            let j = 0
            while j < len(xr) {
                let dst = handle_new(xref_dst_kg(xr[j]), xref_dst_atom(xr[j]))
                if _in_active(active, dst) == 1 { edges = edges + 1 }
                j = j + 1
            }
        }
        i = i + 1
    }
    let coh = edges * 1000 / n
    if coh > 1000 { coh = 1000 }
    return coh
}

// Stage 4: compute coherence, decide accept vs escalate, and bind the active
// group on acceptance. Returns the coherence score (milli).
fn reader_cohere(e, c) {
    let active = rctx_active(c)
    let coh = _coherence(e, active)
    list_set(c, RC_COHERENCE, coh)

    let accepted = 0
    if len(rctx_curiosity(c)) == 0 {
        if len(active) > 0 {
            if coh >= COHERE_ACCEPT { accepted = 1 }
        }
    }
    list_set(c, RC_ACCEPTED, accepted)

    if accepted == 1 {
        // Bind the mutually-supporting group (a copy of the active handles).
        let binding = list_new()
        let i = 0
        while i < len(active) {
            push(binding, active[i])
            i = i + 1
        }
        push(rctx_bindings(c), binding)
    }
    return coh
}

fn reader_accepted(c) { return rctx_accepted(c) }
