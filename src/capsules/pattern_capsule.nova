// CrossEngin capsules: Pattern Capsule subtype + registry (R53, ADR-0107).
//
// A Pattern is a reusable (trigger, guidance) fragment a skill's
// policy consults at run time. A Pattern Capsule is a named,
// versioned bundle of patterns. Skills that lean on patterns pass
// a perception's tokens to `pattern_registry_match(...)` and get
// back the matches, sorted by confidence descending.
//
// Ships 2 built-in capsules:
//   - "debug_common"     v1.0.0   general debug heuristics
//                                 (null-deref, off-by-one, race, etc.)
//   - "research_hygiene" v1.0.0   research-flow reminders
//                                 (single-source, contradictions, etc.)
//
// External pattern capsules (from .cerec packs, R55+) register via
// the same API. Unknown names return 0 -- callers decide how to
// surface that (research_skill logs; coding_helper refuses cleanly).
//
// The pattern layer preserves ADR-0103's 5 guarantees end-to-end:
//   1. Refusals still short-circuit -- patterns only add guidance
//      TO a proposal; they don't flip refusals into approvals
//   2. Not persona-owned -- patterns are shared; source_tag is the
//      provenance stamp
//   3. Effectors stay described-not-executed -- patterns are text
//   4. Meta-observer attribution unchanged -- the skill's supervisor
//      still tags atoms; a pattern's source_tag is an ADDITIONAL
//      parser-side crumb, distinct from the skill's tag
//   5. Persona / atoms / KGs unchanged -- patterns are read-only
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"
import "../sandbox/ownership.nova"

// ---- Pattern slot layout -------------------------------------------------
let PATTERN_TRIGGER_TOKENS = 0    // list<string> (lowercased, non-stopword)
let PATTERN_GUIDANCE       = 1    // string (advice / step text)
let PATTERN_SOURCE_TAG     = 2    // e.g. "src:pattern:debug_common:v1"
let PATTERN_CONFIDENCE     = 3    // 0..1000 milli
let PATTERN_SLOTS          = 4

// ---- Pattern Capsule slot layout -----------------------------------------
let PCAPSULE_NAME     = 0
let PCAPSULE_VERSION  = 1
let PCAPSULE_PATTERNS = 2
let PCAPSULE_SLOTS    = 3

// ---- constructors --------------------------------------------------------

// Build a pattern from parallel-list triggers (all lowercased).
fn pcap_new(triggers, guidance, source_tag, confidence) {
    let p = list_new()
    push(p, triggers)       // TRIGGER_TOKENS
    push(p, guidance)       // GUIDANCE
    push(p, source_tag)     // SOURCE_TAG
    push(p, confidence)     // CONFIDENCE
    return p
}

// Convenience: build a pattern from a single trigger word.
fn pcap_new_1(t1, guidance, source_tag, confidence) {
    let ts = list_new() push(ts, t1)
    return pcap_new(ts, guidance, source_tag, confidence)
}

fn pcap_new_2(t1, t2, guidance, source_tag, confidence) {
    let ts = list_new() push(ts, t1) push(ts, t2)
    return pcap_new(ts, guidance, source_tag, confidence)
}

fn pcap_new_3(t1, t2, t3, guidance, source_tag, confidence) {
    let ts = list_new() push(ts, t1) push(ts, t2) push(ts, t3)
    return pcap_new(ts, guidance, source_tag, confidence)
}

// Build a pattern capsule.
fn pcapsule_new(name, version) {
    let c = list_new()
    push(c, name)               // NAME
    push(c, version)            // VERSION
    push(c, list_new())         // PATTERNS
    return c
}

fn pcapsule_add(cap, pattern) {
    push(cap[PCAPSULE_PATTERNS], pattern)
    return len(cap[PCAPSULE_PATTERNS])
}

// ---- accessors -----------------------------------------------------------

fn pcap_triggers(p)   { return p[PATTERN_TRIGGER_TOKENS] }
fn pcap_guidance(p)   { return p[PATTERN_GUIDANCE] }
fn pcap_source_tag(p) { return p[PATTERN_SOURCE_TAG] }
fn pcap_confidence(p) { return p[PATTERN_CONFIDENCE] }

fn pcapsule_name(c)     { return c[PCAPSULE_NAME] }
fn pcapsule_version(c)  { return c[PCAPSULE_VERSION] }
fn pcapsule_patterns(c) { return c[PCAPSULE_PATTERNS] }
fn pcapsule_count(c)    { return len(c[PCAPSULE_PATTERNS]) }

// ---- token helpers -------------------------------------------------------
//
// Grammar-parser-style tokenizer: ASCII wordchars only, lowercased,
// stopwords removed. Kept aligned with src/nl/grammar_parser.nova's
// tokenizer so a user's raw NL and a pattern's triggers share the
// same normalization rules.

fn _pat_is_wordchar(c) {
    if c >= 65  { if c <= 90  { return 1 } }   // A..Z
    if c >= 97  { if c <= 122 { return 1 } }   // a..z
    if c >= 48  { if c <= 57  { return 1 } }   // 0..9
    if c == 95  { return 1 }                    // '_'
    if c == 45  { return 1 }                    // '-'
    return 0
}

fn _pat_lower(c) {
    if c >= 65 { if c <= 90 { return c + 32 } }
    return c
}

fn _pat_lower_str(s) {
    let out = ""
    let n = len(s)
    let i = 0
    while i < n {
        out = out + chr(_pat_lower(char_at(s, i)))
        i = i + 1
    }
    return out
}

fn _pat_is_stopword(w) {
    if len(w) < 2 { return 1 }
    if str_eq_bytes(w, "the") == 1 { return 1 }
    if str_eq_bytes(w, "and") == 1 { return 1 }
    if str_eq_bytes(w, "for") == 1 { return 1 }
    if str_eq_bytes(w, "with") == 1 { return 1 }
    if str_eq_bytes(w, "from") == 1 { return 1 }
    if str_eq_bytes(w, "into") == 1 { return 1 }
    if str_eq_bytes(w, "onto") == 1 { return 1 }
    if str_eq_bytes(w, "that") == 1 { return 1 }
    if str_eq_bytes(w, "this") == 1 { return 1 }
    if str_eq_bytes(w, "will") == 1 { return 1 }
    if str_eq_bytes(w, "would") == 1 { return 1 }
    if str_eq_bytes(w, "should") == 1 { return 1 }
    if str_eq_bytes(w, "when") == 1 { return 1 }
    if str_eq_bytes(w, "then") == 1 { return 1 }
    return 0
}

// Split `s` into lowercase non-stopword tokens. Returns list<string>.
// The public entry point -- skills call this to tokenize a perception
// before handing it to pattern_registry_match.
fn pcap_tokenize(s) {
    let out = list_new()
    let n = len(s)
    let start = 0 - 1
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if _pat_is_wordchar(c) == 1 {
            if start < 0 { start = i }
        } else {
            if start >= 0 {
                let w = _pat_lower_str(substr(s, start, i - start))
                if _pat_is_stopword(w) == 0 { push(out, w) }
                start = 0 - 1
            }
        }
        i = i + 1
    }
    if start >= 0 {
        let w = _pat_lower_str(substr(s, start, n - start))
        if _pat_is_stopword(w) == 0 { push(out, w) }
    }
    return out
}

// Set-membership: is `token` in `token_list`?
fn _pat_has_token(token_list, token) {
    let i = 0
    while i < len(token_list) {
        if str_eq_bytes(token_list[i], token) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ALL-tokens-present match: every trigger of `pattern` must appear in
// `perception_tokens`. Returns 1 on match, 0 otherwise.
fn pcap_matches(pattern, perception_tokens) {
    let triggers = pcap_triggers(pattern)
    if len(triggers) == 0 { return 0 }     // empty-trigger pattern never fires
    let i = 0
    while i < len(triggers) {
        if _pat_has_token(perception_tokens, triggers[i]) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// ---- registry ------------------------------------------------------------
//
// Process-wide singleton of built-in + external pattern capsules,
// keyed by name. Lazy-init so importing this module has no side
// effect until a caller reaches for it.

let _pattern_reg = 0

fn _pattern_registry() {
    if _pattern_reg != 0 { return _pattern_reg }
    let reg = list_new()
    push(reg, _pat_capsule_debug_common())
    push(reg, _pat_capsule_research_hygiene())
    _pattern_reg = reg
    return _pattern_reg
}

// Register a pattern capsule at runtime. Duplicate names REPLACE the
// prior entry (last-write-wins), so a shop's local `debug_shop_x`
// pack can override a built-in without a name-collision error.
fn pattern_registry_register(cap) {
    let reg = _pattern_registry()
    let name = pcapsule_name(cap)
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(pcapsule_name(reg[i]), name) == 1 {
            list_set(reg, i, cap)
            return reg
        }
        i = i + 1
    }
    push(reg, cap)
    return reg
}

// Look up a capsule by name; 0 if absent.
fn pattern_registry_lookup(name) {
    let reg = _pattern_registry()
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(pcapsule_name(reg[i]), name) == 1 { return reg[i] }
        i = i + 1
    }
    return 0
}

fn pattern_registry_names() {
    let reg = _pattern_registry()
    let out = list_new()
    let i = 0
    while i < len(reg) { push(out, pcapsule_name(reg[i])) i = i + 1 }
    return out
}

fn pattern_registry_count() { return len(_pattern_registry()) }

fn pattern_registry_is_known(name) {
    if pattern_registry_lookup(name) != 0 { return 1 }
    return 0
}

// ---- matcher -------------------------------------------------------------
//
// Walk the registered capsules (all if `filter_names` empty; otherwise
// the named subset), test each pattern's triggers against
// `perception_tokens`, return the matching patterns sorted by
// confidence descending. Determined by insertion order within a
// confidence tier so the output is byte-identical across runs.

fn _pat_capsule_in_filter(name, filter_names) {
    if len(filter_names) == 0 { return 1 }
    let i = 0
    while i < len(filter_names) {
        if str_eq_bytes(filter_names[i], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Stable insertion sort by confidence DESC (higher first). Small
// input sizes (top-K matches) keep this fine; O(N^2) is not a
// concern here.
fn _pat_sort_desc_by_confidence(matches) {
    let n = len(matches)
    let out = list_new()
    let i = 0
    while i < n {
        let cur = matches[i]
        let curc = pcap_confidence(cur)
        let inserted = 0
        let j = 0
        while j < len(out) {
            if inserted == 0 {
                if pcap_confidence(out[j]) < curc {
                    // Rebuild `out` inserting cur before j.
                    let rebuilt = list_new()
                    let k = 0
                    while k < j { push(rebuilt, out[k]) k = k + 1 }
                    push(rebuilt, cur)
                    while k < len(out) { push(rebuilt, out[k]) k = k + 1 }
                    out = rebuilt
                    inserted = 1
                    j = len(out)   // exit loop
                }
            }
            j = j + 1
        }
        if inserted == 0 { push(out, cur) }
        i = i + 1
    }
    return out
}

// Match perception tokens against pattern capsules. `filter_names`
// may be an empty list to walk every registered capsule.
fn pattern_registry_match(perception_tokens, filter_names) {
    let reg = _pattern_registry()
    let matches = list_new()
    let ci = 0
    while ci < len(reg) {
        let cap = reg[ci]
        if _pat_capsule_in_filter(pcapsule_name(cap), filter_names) == 1 {
            let patterns = pcapsule_patterns(cap)
            let pi = 0
            while pi < len(patterns) {
                if pcap_matches(patterns[pi], perception_tokens) == 1 {
                    push(matches, patterns[pi])
                }
                pi = pi + 1
            }
        }
        ci = ci + 1
    }
    return _pat_sort_desc_by_confidence(matches)
}

// Convenience: match against ALL capsules (no filter).
fn pattern_registry_match_all(perception_tokens) {
    return pattern_registry_match(perception_tokens, list_new())
}

// R63: same as pattern_registry_match, but additionally skips
// capsules the presented holder cannot see under the ownership
// overlay. `overlay` may be 0 (no filter, backward-compat) and
// `holder` may be "" (anonymous). Filter is applied BEFORE the
// filter_names allowlist so a caller that asked for capsule X by
// name still gets 0 matches when they don't own X.
//
// Duplicated from pattern_registry_match to keep the R53 hot path
// unchanged for the built-in single-user case (no branch on
// overlay==0 inside the tight per-pattern loop).
fn pattern_registry_match_scoped(perception_tokens, filter_names,
                                  overlay, holder) {
    let reg = _pattern_registry()
    let matches = list_new()
    let ci = 0
    while ci < len(reg) {
        let cap = reg[ci]
        let name = pcapsule_name(cap)
        let visible = 1
        if overlay != 0 {
            visible = ownership_pattern_visible(overlay, name, holder)
        }
        if visible == 1 {
            if _pat_capsule_in_filter(name, filter_names) == 1 {
                let patterns = pcapsule_patterns(cap)
                let pi = 0
                while pi < len(patterns) {
                    if pcap_matches(patterns[pi], perception_tokens) == 1 {
                        push(matches, patterns[pi])
                    }
                    pi = pi + 1
                }
            }
        }
        ci = ci + 1
    }
    return _pat_sort_desc_by_confidence(matches)
}

// ---- built-in: debug_common v1.0.0 --------------------------------------
//
// General debug heuristics. Trigger tokens are what a user typing a
// bug report is likely to include. Guidance is short, actionable, and
// authored so it reads useful even in isolation.

let _PAT_TAG_DEBUG = "src:pattern:debug_common:v1"

fn _pat_capsule_debug_common() {
    let c = pcapsule_new("debug_common", "1.0.0")
    pcapsule_add(c, pcap_new_2("null", "pointer",
        "NULL deref: check whether the caller initialises the value only on a success branch, and add a defensive nil-check at the boundary.",
        _PAT_TAG_DEBUG, 800))
    pcapsule_add(c, pcap_new_2("null", "reference",
        "NULL reference: same as null deref -- track the value backwards to the assignment; is it optional / lazy-init?",
        _PAT_TAG_DEBUG, 750))
    pcapsule_add(c, pcap_new_3("off", "by", "one",
        "Off-by-one: check loop bounds (<= vs <) and slice ends (exclusive vs inclusive). Write a length-0 and length-1 test.",
        _PAT_TAG_DEBUG, 750))
    pcapsule_add(c, pcap_new_2("undefined", "variable",
        "Undefined variable: check scope + shadowing. Was the outer name masked by a same-named parameter? Is it defined only on a code path that didn't run?",
        _PAT_TAG_DEBUG, 700))
    pcapsule_add(c, pcap_new_2("hang", "loop",
        "Hang in a loop: instrument the exit condition variable; is it monotonically approaching termination? Add a max-iterations backstop.",
        _PAT_TAG_DEBUG, 700))
    pcapsule_add(c, pcap_new_2("stack", "overflow",
        "Stack overflow: check the recursion base case (does it fire on all inputs?) or convert to iteration if the depth is data-driven.",
        _PAT_TAG_DEBUG, 800))
    pcapsule_add(c, pcap_new_2("race", "condition",
        "Race condition: identify the shared state; check that every mutation is guarded by the same lock scope; look for missing barriers on the read side.",
        _PAT_TAG_DEBUG, 750))
    pcapsule_add(c, pcap_new_2("memory", "leak",
        "Memory leak: check ownership -- who's supposed to free? Trace the object's destructor path; is the code path that owns it always reached?",
        _PAT_TAG_DEBUG, 700))
    pcapsule_add(c, pcap_new_2("type", "error",
        "Type error: check the call site and any coercion / auto-cast. Log the actual type of the value at the boundary.",
        _PAT_TAG_DEBUG, 650))
    pcapsule_add(c, pcap_new_1("timeout",
        "Timeout: check the network / DB retry path. Is a single slow call cascading? Add a bounded retry + circuit-breaker.",
        _PAT_TAG_DEBUG, 600))
    pcapsule_add(c, pcap_new_2("permission", "denied",
        "Permission denied: check the running user (ps / whoami) and the file / socket ACL. Container? Check the mount options.",
        _PAT_TAG_DEBUG, 650))
    pcapsule_add(c, pcap_new_2("connection", "refused",
        "Connection refused: is the target listening on the address you dialed? ss / netstat / lsof to confirm the bind.",
        _PAT_TAG_DEBUG, 650))
    return c
}

// ---- built-in: research_hygiene v1.0.0 -----------------------------------

let _PAT_TAG_RESEARCH = "src:pattern:research_hygiene:v1"

fn _pat_capsule_research_hygiene() {
    let c = pcapsule_new("research_hygiene", "1.0.0")
    pcapsule_add(c, pcap_new_2("single", "source",
        "Single-source claim -- cross-check against at least one independent source; note the belief spread on the atom.",
        _PAT_TAG_RESEARCH, 700))
    pcapsule_add(c, pcap_new_1("contradiction",
        "Contradiction: name both KGs, compute the belief-mean spread, and report both sides rather than picking one.",
        _PAT_TAG_RESEARCH, 800))
    pcapsule_add(c, pcap_new_1("recent",
        "Recency: prefer sources with fresher provenance timestamps; call out staleness > 5 years for volatile domains.",
        _PAT_TAG_RESEARCH, 550))
    pcapsule_add(c, pcap_new_1("quote",
        "Quotation: prefer the primary source over the secondary quote; a paper citing a paper is one hop weaker.",
        _PAT_TAG_RESEARCH, 600))
    pcapsule_add(c, pcap_new_2("belief", "low",
        "Low belief: hedge the wording -- 'some evidence suggests' rather than 'X is true'. Confidence 400-600 = hedge; <400 = flag as speculative.",
        _PAT_TAG_RESEARCH, 700))
    return c
}
