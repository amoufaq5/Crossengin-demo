// CrossEngin capsules: semver compare + dependency graph (ADR-0106).
//
// A capsule declares zero or more dependencies as [name, version-min]
// pairs. On install, the registry (capsule_registry.nova) resolves
// dependencies in topological order and refuses cycles. This module
// implements the small primitives that resolution uses.
//
// Semver simplification: we support the three-tuple "MAJOR.MINOR.PATCH"
// plus an optional pre-release suffix ("-alpha", "-beta", "-rc.1"). Full
// SemVer 2.0 precedence rules are not required for v1 -- we treat
// pre-release as "less than the same MAJOR.MINOR.PATCH without a
// suffix", which is enough to answer "is 1.2.3 >= 1.2.0" correctly.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- semver parse ---------------------------------------------------------

// Parse "MAJOR.MINOR.PATCH" (ignoring any -suffix). Returns a 4-list
// [major, minor, patch, has_prerelease]. Returns [0,0,0,0] on malformed
// input (defensive default; caller can compare against sentinel).
fn semver_parse(s) {
    let n = len(s)
    let out = list_new()
    push(out, 0) push(out, 0) push(out, 0) push(out, 0)
    if n == 0 { return out }
    let major = 0
    let minor = 0
    let patch = 0
    let field = 0     // 0 = major, 1 = minor, 2 = patch
    let has_pre = 0
    let i = 0
    let more = 1
    while more == 1 {
        if i >= n { more = 0 }
        else {
            let c = char_at(s, i)
            if c == 45 { has_pre = 1 more = 0 }         // '-' -> prerelease
            else { if c == 46 {                          // '.'
                field = field + 1
                if field > 2 { more = 0 }
                else { i = i + 1 }
            } else { if c >= 48 {                        // digit?
                if c <= 57 {
                    let d = c - 48
                    if field == 0 { major = major * 10 + d }
                    if field == 1 { minor = minor * 10 + d }
                    if field == 2 { patch = patch * 10 + d }
                    i = i + 1
                } else { more = 0 }
            } else { more = 0 } } }
        }
    }
    list_set(out, 0, major)
    list_set(out, 1, minor)
    list_set(out, 2, patch)
    list_set(out, 3, has_pre)
    return out
}

// Compare parsed a and b. Returns -1 (a<b), 0 (a==b), 1 (a>b).
// Prerelease-of-same-tuple is less than non-prerelease of same tuple.
fn semver_cmp_parsed(a, b) {
    if a[0] < b[0] { return 0 - 1 }
    if a[0] > b[0] { return 1 }
    if a[1] < b[1] { return 0 - 1 }
    if a[1] > b[1] { return 1 }
    if a[2] < b[2] { return 0 - 1 }
    if a[2] > b[2] { return 1 }
    // same tuple -- prerelease loses to non-prerelease.
    if a[3] == 1 { if b[3] == 0 { return 0 - 1 } }
    if b[3] == 1 { if a[3] == 0 { return 1 } }
    return 0
}

// Compare version strings.
fn semver_cmp(a_str, b_str) {
    return semver_cmp_parsed(semver_parse(a_str), semver_parse(b_str))
}

// Is `have` >= `want`?
fn semver_ge(have, want) {
    if semver_cmp(have, want) >= 0 { return 1 }
    return 0
}

// ---- topological sort with cycle detection --------------------------------
//
// Input: `deps_of(name)` returns a list of dependency-name strings.
// This module doesn't call a function -- callers pass a pre-built
// adjacency list: list of [name, [dep_names...]].
//
// Returns [ordered_names, cycle_or_empty]. If cycle_or_empty is non-empty,
// it names a node that participates in a cycle and ordered_names is
// partial.

// Find node in adjacency by name; returns its entry or 0.
fn _capdep_lookup(adj, name) {
    let i = 0
    while i < len(adj) {
        if str_eq_bytes(adj[i][0], name) == 1 { return adj[i] }
        i = i + 1
    }
    return 0
}

// Find status index for `name` in a parallel [names[], statuses[]] pair.
// Returns the index if found; -1 otherwise.
fn _capdep_status_idx(status_names, name) {
    let i = 0
    while i < len(status_names) {
        if str_eq_bytes(status_names[i], name) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// Depth-first visit with tri-state status: 0=unvisited (implicit),
// 1=on-current-path (visiting), 2=done. If we hit a node with status
// 1, that's a back-edge -> cycle. Returns cycle-node-name on cycle,
// "" on success.
fn _capdep_dfs(name, adj, status_names, statuses, order) {
    let idx = _capdep_status_idx(status_names, name)
    if idx >= 0 {
        let st = statuses[idx]
        if st == 2 { return "" }        // already done
        if st == 1 { return name }      // cycle
    } else {
        push(status_names, name)
        push(statuses, 0)
        idx = len(status_names) - 1
    }
    list_set(statuses, idx, 1)          // mark visiting
    let node = _capdep_lookup(adj, name)
    if node != 0 {
        let deps = node[1]
        let d = 0
        while d < len(deps) {
            let cycle = _capdep_dfs(deps[d], adj, status_names, statuses, order)
            if len(cycle) > 0 { return cycle }
            d = d + 1
        }
    }
    list_set(statuses, idx, 2)          // mark done
    push(order, name)
    return ""
}

// Toposort from root_name. Returns [ordered_names, cycle_or_empty].
// If cycle non-empty, ordered_names is the partial order visited so far
// and cycle_or_empty names the node that closes the cycle.
fn capdep_toposort(adj, root_name) {
    let order = list_new()
    let status_names = list_new()
    let statuses = list_new()
    let cycle = _capdep_dfs(root_name, adj, status_names, statuses, order)
    let out = list_new()
    push(out, order)
    push(out, cycle)
    return out
}
