// CrossEngin capsules: per-session registry (ADR-0106).
//
// One CapsuleRegistry per Session (see ADR-0051). Registers capsules,
// tracks install state, resolves dependencies in topological order at
// install time, refuses cycles.
//
// Registered vs active is deliberate: a capsule can be registered
// (metadata present, atoms + imps ingested into the KGs) without being
// currently installed. Skills gating on "is capsule X installed?" get
// an accurate answer from `capreg_is_installed` without atoms
// disappearing when a capsule is uninstalled.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/capsules/capsule.nova, src/capsules/capsule_dep.nova,
//   src/util/str_safe.nova.

import "./capsule.nova"
import "./capsule_dep.nova"
import "../util/str_safe.nova"

// ---- registry slots -------------------------------------------------------
let CAPREG_CAPSULES = 0    // list<Capsule>
let CAPREG_COUNT    = 1

// ---- constructor + basic queries ------------------------------------------

fn capreg_new() {
    let r = list_new()
    push(r, list_new())        // CAPSULES
    return r
}

fn capreg_count(reg) { return len(reg[CAPREG_CAPSULES]) }
fn capreg_capsules(reg) { return reg[CAPREG_CAPSULES] }

// Look up a capsule by name. Returns the Capsule or 0.
fn capreg_lookup(reg, name) {
    let caps = reg[CAPREG_CAPSULES]
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(capsule_name(caps[i]), name) == 1 { return caps[i] }
        i = i + 1
    }
    return 0
}

// ---- register (idempotent by name) ----------------------------------------

// Insert a capsule into the registry under its own name. Returns 1 on
// insert; 0 if a capsule with that name already exists (caller may
// treat this as a version-conflict warning).
fn capreg_register(reg, capsule) {
    let name = capsule_name(capsule)
    if capreg_lookup(reg, name) != 0 { return 0 }
    push(reg[CAPREG_CAPSULES], capsule)
    return 1
}

// ---- remove (metadata only; atoms stay) -----------------------------------

fn capreg_remove(reg, name) {
    let caps = reg[CAPREG_CAPSULES]
    let idx = 0 - 1
    let i = 0
    while i < len(caps) {
        if str_eq_bytes(capsule_name(caps[i]), name) == 1 { idx = i i = len(caps) }
        i = i + 1
    }
    if idx < 0 { return 0 }
    // rebuild without the removed slot (no builtin remove/splice).
    let kept = list_new()
    let j = 0
    while j < len(caps) {
        if j != idx { push(kept, caps[j]) }
        j = j + 1
    }
    list_set(reg, CAPREG_CAPSULES, kept)
    return 1
}

// ---- install / uninstall / is_installed -----------------------------------

// True if a capsule with `name` is registered AND currently installed.
fn capreg_is_installed(reg, name) {
    let c = capreg_lookup(reg, name)
    if c == 0 { return 0 }
    return capsule_installed(c)
}

// Install a capsule, resolving deps first (topological order). Returns
// a status list [ok, installed_count, cycle_or_empty, missing_dep_or_empty].
//   ok=1 on success; ok=0 if a dep is unregistered or a cycle exists.
// Callers can register missing deps and retry.
fn capreg_install(reg, name, now) {
    let out = list_new()
    push(out, 0) push(out, 0) push(out, "") push(out, "")
    let root = capreg_lookup(reg, name)
    if root == 0 {
        list_set(out, 3, name)          // "missing" the requested capsule itself
        return out
    }
    // Build adjacency list for the dep graph.
    let adj = capreg_dep_adjacency(reg, name)
    // Toposort.
    let topo = capdep_toposort(adj, name)
    let order = topo[0]
    let cycle = topo[1]
    if len(cycle) > 0 {
        list_set(out, 2, cycle)
        return out
    }
    // Verify every named node in order is registered.
    let i = 0
    while i < len(order) {
        if capreg_lookup(reg, order[i]) == 0 {
            list_set(out, 3, order[i])
            return out
        }
        i = i + 1
    }
    // Walk in topological order (leaves first). Install each capsule that
    // is not yet installed.
    let installed_here = 0
    let j = 0
    while j < len(order) {
        let cap = capreg_lookup(reg, order[j])
        if capsule_install(cap, now) == 1 { installed_here = installed_here + 1 }
        j = j + 1
    }
    list_set(out, 0, 1)
    list_set(out, 1, installed_here)
    return out
}

// Uninstall the named capsule. Does NOT cascade to dependents (uninstall
// doesn't remove atoms; dependents can still read them). Returns 1 on
// applied, 0 on not-found or already-uninstalled.
fn capreg_uninstall(reg, name) {
    let c = capreg_lookup(reg, name)
    if c == 0 { return 0 }
    return capsule_uninstall(c)
}

// ---- dep adjacency helper -------------------------------------------------

// Build the [name, [dep_names...]] adjacency reachable from `root`.
// Only entries for registered capsules get a populated dep list;
// unregistered deps appear as names in a parent's dep list but not
// as adjacency entries of their own.
//
// Implementation: index-cursor BFS. Avoids mutating the queue in place
// (NOVA has no `pop`); a `head` cursor advances through it.
fn capreg_dep_adjacency(reg, root_name) {
    let adj = list_new()
    let queue = list_new()
    let seen = list_new()
    push(queue, root_name)
    push(seen, root_name)
    let head = 0
    while head < len(queue) {
        let name = queue[head]
        head = head + 1
        let cap = capreg_lookup(reg, name)
        let dep_names = list_new()
        if cap != 0 {
            let deps = capsule_deps(cap)
            let d = 0
            while d < len(deps) {
                let dep_name = deps[d][0]
                push(dep_names, dep_name)
                let seen_it = 0
                let s = 0
                while s < len(seen) {
                    if str_eq_bytes(seen[s], dep_name) == 1 { seen_it = 1 s = len(seen) }
                    s = s + 1
                }
                if seen_it == 0 {
                    push(queue, dep_name)
                    push(seen, dep_name)
                }
                d = d + 1
            }
        }
        let entry = list_new()
        push(entry, name)
        push(entry, dep_names)
        push(adj, entry)
    }
    return adj
}

// ---- filter helpers -------------------------------------------------------

// Return only installed capsules.
fn capreg_installed_capsules(reg) {
    let out = list_new()
    let caps = reg[CAPREG_CAPSULES]
    let i = 0
    while i < len(caps) {
        if capsule_installed(caps[i]) == 1 { push(out, caps[i]) }
        i = i + 1
    }
    return out
}

// Return every capsule that claims `atom_id` (regardless of install state).
fn capreg_capsules_owning_atom(reg, atom_id) {
    let out = list_new()
    let caps = reg[CAPREG_CAPSULES]
    let i = 0
    while i < len(caps) {
        if capsule_has_atom(caps[i], atom_id) == 1 { push(out, caps[i]) }
        i = i + 1
    }
    return out
}
