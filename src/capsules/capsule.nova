// CrossEngin capsules -- named shareable bundles on top of atoms (ADR-0106).
//
// A Capsule is a NAMED, VERSIONED, SHAREABLE membership set over atoms +
// implications + dependencies + license. Atoms remain the base MSC node
// (ADR-0100); capsules do NOT own atoms. Two capsules can claim the
// same atom simultaneously (shareable) -- the atom lives once in one KG,
// but multiple capsules can advertise it as part of their content.
//
// A capsule's LIFECYCLE:
//   * REGISTERED   -- known to the registry; metadata + atom refs present.
//   * ACTIVE       -- currently installed; skills gating on it can fire.
//   * UNINSTALLED  -- inactive but still registered; atoms stay.
//   * REMOVED      -- metadata gone; atoms MAY die if no other capsule
//                     claims them and no active KG-level implication
//                     references them.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- Capsule slot layout --------------------------------------------------
let CAP_NAME         = 0    // string, primary key within a registry
let CAP_VERSION      = 1    // string, semver-shaped ("1.0.0")
let CAP_DESCRIPTION  = 2    // string, one-line human-readable
let CAP_SOURCE_PREF  = 3    // string, "src:cap:<name>:v<version>"
let CAP_ATOM_REFS    = 4    // list<atom_id>
let CAP_IMP_REFS     = 5    // list<imp_id> (implication atom-ids)
let CAP_DEPS         = 6    // list<[name, version]>
let CAP_LICENSE      = 7    // string
let CAP_INSTALLED    = 8    // 0/1
let CAP_INSTALLED_AT = 9    // moment (integer)
let CAP_COUNT        = 10

// ---- constructors ---------------------------------------------------------

// Build a fresh capsule. atom_refs and imp_refs and deps start empty; the
// ingest pipeline populates them via capsule_claim_atom / capsule_claim_imp /
// capsule_add_dep. installed=0 by default.
fn capsule_new(name, version, description, license) {
    let c = list_new()
    push(c, name)                                     // NAME
    push(c, version)                                  // VERSION
    push(c, description)                              // DESCRIPTION
    push(c, "src:cap:" + name + ":v" + version)       // SOURCE_PREF
    push(c, list_new())                               // ATOM_REFS
    push(c, list_new())                               // IMP_REFS
    push(c, list_new())                               // DEPS
    push(c, license)                                  // LICENSE
    push(c, 0)                                        // INSTALLED
    push(c, 0)                                        // INSTALLED_AT
    return c
}

// ---- accessors ------------------------------------------------------------

fn capsule_name(c)          { return c[CAP_NAME] }
fn capsule_version(c)       { return c[CAP_VERSION] }
fn capsule_description(c)   { return c[CAP_DESCRIPTION] }
fn capsule_source_pref(c)   { return c[CAP_SOURCE_PREF] }
fn capsule_atom_refs(c)     { return c[CAP_ATOM_REFS] }
fn capsule_imp_refs(c)      { return c[CAP_IMP_REFS] }
fn capsule_deps(c)          { return c[CAP_DEPS] }
fn capsule_license(c)       { return c[CAP_LICENSE] }
fn capsule_installed(c)     { return c[CAP_INSTALLED] }
fn capsule_installed_at(c)  { return c[CAP_INSTALLED_AT] }

// ---- membership mutations -------------------------------------------------

// Claim an atom for this capsule. Idempotent -- re-claiming is a no-op.
// Returns 1 if newly claimed, 0 if already present.
fn capsule_claim_atom(c, atom_id) {
    let refs = c[CAP_ATOM_REFS]
    let i = 0
    while i < len(refs) {
        if refs[i] == atom_id { return 0 }
        i = i + 1
    }
    push(refs, atom_id)
    return 1
}

// Claim an implication (by its atom-id in the KG). Idempotent.
fn capsule_claim_imp(c, imp_id) {
    let refs = c[CAP_IMP_REFS]
    let i = 0
    while i < len(refs) {
        if refs[i] == imp_id { return 0 }
        i = i + 1
    }
    push(refs, imp_id)
    return 1
}

// Add a capsule dependency. dep = [name, version].
fn capsule_add_dep(c, dep_name, dep_version) {
    let deps = c[CAP_DEPS]
    let i = 0
    while i < len(deps) {
        if str_eq_bytes(deps[i][0], dep_name) == 1 { return 0 }
        i = i + 1
    }
    let d = list_new()
    push(d, dep_name)
    push(d, dep_version)
    push(deps, d)
    return 1
}

fn capsule_atom_count(c) { return len(c[CAP_ATOM_REFS]) }
fn capsule_imp_count(c)  { return len(c[CAP_IMP_REFS]) }
fn capsule_dep_count(c)  { return len(c[CAP_DEPS]) }

// ---- install / uninstall --------------------------------------------------

// Mark the capsule active. Records the install moment. Idempotent.
fn capsule_install(c, now) {
    if c[CAP_INSTALLED] == 1 { return 0 }
    list_set(c, CAP_INSTALLED, 1)
    list_set(c, CAP_INSTALLED_AT, now)
    return 1
}

// Mark inactive. Atoms stay; membership stays; other capsules unaffected.
fn capsule_uninstall(c) {
    if c[CAP_INSTALLED] == 0 { return 0 }
    list_set(c, CAP_INSTALLED, 0)
    return 1
}

// ---- membership query -----------------------------------------------------

// True (1) if atom_id is in this capsule's atom refs.
fn capsule_has_atom(c, atom_id) {
    let refs = c[CAP_ATOM_REFS]
    let i = 0
    while i < len(refs) {
        if refs[i] == atom_id { return 1 }
        i = i + 1
    }
    return 0
}

fn capsule_has_imp(c, imp_id) {
    let refs = c[CAP_IMP_REFS]
    let i = 0
    while i < len(refs) {
        if refs[i] == imp_id { return 1 }
        i = i + 1
    }
    return 0
}
