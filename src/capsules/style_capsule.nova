// CrossEngin capsules: Style Capsule subtype + registry (R52, ADR-0108).
//
// A Style Capsule is a data object holding rendering knobs the
// templater reads. Changes wording + section presence; NEVER changes
// the underlying ExecutionResult / ProposalResult. That preserves
// the templater's determinism guarantee (same PR + same style ->
// same string) and keeps client-side structured consumers (audit
// readers, UI source panels) reading the same shape regardless of
// which style rendered the text.
//
// Ships 3 built-in styles:
//   - "default"  matches R48p4's templater output byte-for-byte
//                (zero regression risk; every existing test passes)
//   - "terse"    ASCII bullets, hide projection / effectors /
//                trailer; useful for chat UIs that render the
//                structured data themselves
//   - "formal"   full-sentence academic phrasing, compact trailer
//
// External style capsules (from .cerec packs, R55+) register via
// the same API. Unknown style names fall back to "default" with a
// crumb in the returned lookup result so operators see the miss.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- Style knob slot layout ----------------------------------------------

let STYLE_NAME                  = 0
let STYLE_BULLET                = 1
let STYLE_ANSWER_HEADER         = 2

// Sources listing.
let STYLE_SOURCES_HDR_1         = 3   // "Sources cited ("
let STYLE_SOURCES_HDR_2_SING    = 4   // " atom):\n"
let STYLE_SOURCES_HDR_2_PLUR    = 5   // " atoms):\n"
let STYLE_SOURCE_KG_OPEN        = 6   // "["
let STYLE_SOURCE_KG_CLOSE       = 7   // "] "
let STYLE_SOURCE_BELIEF_PREFIX  = 8   // ": belief "
let STYLE_SOURCE_BELIEF_SUFFIX  = 9   // "/1000\n"

// Disagreements.
let STYLE_DISAGREE_HDR_1        = 10  // "\n⚠ Sources disagree on '"
let STYLE_DISAGREE_HDR_2        = 11  // "' (spread "
let STYLE_DISAGREE_HDR_3        = 12  // " milli, "
let STYLE_DISAGREE_HDR_4        = 13  // " sources).\n"
let STYLE_DISAGREE_ITEM_MID     = 14  // " believes "
let STYLE_DISAGREE_ITEM_INDENT  = 15  // "    "

// Persona projection.
let STYLE_PROJECTION_LABEL      = 16  // "\nPersona projection: valence "
let STYLE_PROJECTION_MID_1      = 17  // ", arousal "
let STYLE_PROJECTION_MID_2      = 18  // ", risk "
let STYLE_PROJECTION_SUFFIX     = 19  // "/1000.\n"

// Effector calls.
let STYLE_EFFECTOR_HDR          = 20  // "\nWould perform (described, not executed):\n"

// Trailer.
let STYLE_TRAILER_HDR_1         = 21  // "\nConfidence: "
let STYLE_TRAILER_HDR_2         = 22  // "/1000  |  parser: "
let STYLE_TRAILER_HDR_3         = 23  // "  |  style: "
let STYLE_TRAILER_SUFFIX        = 24  // "\n"

// Refusal.
let STYLE_REFUSAL_HDR           = 25  // "⚠ Refused: "

// Presence flags (0/1).
let STYLE_SHOW_SOURCES          = 26
let STYLE_SHOW_DISAGREEMENTS    = 27
let STYLE_SHOW_PROJECTION       = 28
let STYLE_SHOW_EFFECTORS        = 29
let STYLE_SHOW_TRAILER          = 30

let STYLE_SLOT_COUNT            = 31

// ---- constructor ---------------------------------------------------------

fn _style_new_empty(name) {
    let s = list_new()
    let i = 0
    while i < STYLE_SLOT_COUNT { push(s, "") i = i + 1 }
    list_set(s, STYLE_NAME, name)
    // Default presence flags: everything visible.
    list_set(s, STYLE_SHOW_SOURCES, 1)
    list_set(s, STYLE_SHOW_DISAGREEMENTS, 1)
    list_set(s, STYLE_SHOW_PROJECTION, 1)
    list_set(s, STYLE_SHOW_EFFECTORS, 1)
    list_set(s, STYLE_SHOW_TRAILER, 1)
    return s
}

// ---- accessors -----------------------------------------------------------

fn style_name(s)                   { return s[STYLE_NAME] }
fn style_bullet(s)                 { return s[STYLE_BULLET] }
fn style_answer_header(s)          { return s[STYLE_ANSWER_HEADER] }
fn style_sources_hdr_1(s)          { return s[STYLE_SOURCES_HDR_1] }
fn style_sources_hdr_2_sing(s)     { return s[STYLE_SOURCES_HDR_2_SING] }
fn style_sources_hdr_2_plur(s)     { return s[STYLE_SOURCES_HDR_2_PLUR] }
fn style_source_kg_open(s)         { return s[STYLE_SOURCE_KG_OPEN] }
fn style_source_kg_close(s)        { return s[STYLE_SOURCE_KG_CLOSE] }
fn style_source_belief_prefix(s)   { return s[STYLE_SOURCE_BELIEF_PREFIX] }
fn style_source_belief_suffix(s)   { return s[STYLE_SOURCE_BELIEF_SUFFIX] }
fn style_disagree_hdr_1(s)         { return s[STYLE_DISAGREE_HDR_1] }
fn style_disagree_hdr_2(s)         { return s[STYLE_DISAGREE_HDR_2] }
fn style_disagree_hdr_3(s)         { return s[STYLE_DISAGREE_HDR_3] }
fn style_disagree_hdr_4(s)         { return s[STYLE_DISAGREE_HDR_4] }
fn style_disagree_item_mid(s)      { return s[STYLE_DISAGREE_ITEM_MID] }
fn style_disagree_item_indent(s)   { return s[STYLE_DISAGREE_ITEM_INDENT] }
fn style_projection_label(s)       { return s[STYLE_PROJECTION_LABEL] }
fn style_projection_mid_1(s)       { return s[STYLE_PROJECTION_MID_1] }
fn style_projection_mid_2(s)       { return s[STYLE_PROJECTION_MID_2] }
fn style_projection_suffix(s)      { return s[STYLE_PROJECTION_SUFFIX] }
fn style_effector_hdr(s)           { return s[STYLE_EFFECTOR_HDR] }
fn style_trailer_hdr_1(s)          { return s[STYLE_TRAILER_HDR_1] }
fn style_trailer_hdr_2(s)          { return s[STYLE_TRAILER_HDR_2] }
fn style_trailer_hdr_3(s)          { return s[STYLE_TRAILER_HDR_3] }
fn style_trailer_suffix(s)         { return s[STYLE_TRAILER_SUFFIX] }
fn style_refusal_hdr(s)            { return s[STYLE_REFUSAL_HDR] }
fn style_show_sources(s)           { return s[STYLE_SHOW_SOURCES] }
fn style_show_disagreements(s)     { return s[STYLE_SHOW_DISAGREEMENTS] }
fn style_show_projection(s)        { return s[STYLE_SHOW_PROJECTION] }
fn style_show_effectors(s)         { return s[STYLE_SHOW_EFFECTORS] }
fn style_show_trailer(s)           { return s[STYLE_SHOW_TRAILER] }

// ---- built-in: "default" -------------------------------------------------
//
// Matches R48p4's inline templater output byte-for-byte. Existing
// 60 templater checks all rely on this shape.

fn style_default() {
    let s = _style_new_empty("default")
    list_set(s, STYLE_BULLET,               "  - ")
    list_set(s, STYLE_ANSWER_HEADER,        "")
    list_set(s, STYLE_SOURCES_HDR_1,        "Sources cited (")
    list_set(s, STYLE_SOURCES_HDR_2_SING,   " atom):\n")
    list_set(s, STYLE_SOURCES_HDR_2_PLUR,   " atoms):\n")
    list_set(s, STYLE_SOURCE_KG_OPEN,       "[")
    list_set(s, STYLE_SOURCE_KG_CLOSE,      "] ")
    list_set(s, STYLE_SOURCE_BELIEF_PREFIX, ": belief ")
    list_set(s, STYLE_SOURCE_BELIEF_SUFFIX, "/1000\n")
    list_set(s, STYLE_DISAGREE_HDR_1,       "\n⚠ Sources disagree on '")
    list_set(s, STYLE_DISAGREE_HDR_2,       "' (spread ")
    list_set(s, STYLE_DISAGREE_HDR_3,       " milli, ")
    list_set(s, STYLE_DISAGREE_HDR_4,       " sources).\n")
    list_set(s, STYLE_DISAGREE_ITEM_MID,    " believes ")
    list_set(s, STYLE_DISAGREE_ITEM_INDENT, "    ")
    list_set(s, STYLE_PROJECTION_LABEL,     "\nPersona projection: valence ")
    list_set(s, STYLE_PROJECTION_MID_1,     ", arousal ")
    list_set(s, STYLE_PROJECTION_MID_2,     ", risk ")
    list_set(s, STYLE_PROJECTION_SUFFIX,    "/1000.\n")
    list_set(s, STYLE_EFFECTOR_HDR,         "\nWould perform (described, not executed):\n")
    list_set(s, STYLE_TRAILER_HDR_1,        "\nConfidence: ")
    list_set(s, STYLE_TRAILER_HDR_2,        "/1000  |  parser: ")
    list_set(s, STYLE_TRAILER_HDR_3,        "  |  style: ")
    list_set(s, STYLE_TRAILER_SUFFIX,       "\n")
    list_set(s, STYLE_REFUSAL_HDR,          "⚠ Refused: ")
    return s
}

// ---- built-in: "terse" ---------------------------------------------------
//
// Minimal wording, ASCII bullets, hide advisory sections (chat UIs
// render structured advisory data themselves; the text stream stays
// short). Sources kept -- they're the core deliverable.

fn style_terse() {
    let s = _style_new_empty("terse")
    list_set(s, STYLE_BULLET,               "- ")
    list_set(s, STYLE_ANSWER_HEADER,        "")
    list_set(s, STYLE_SOURCES_HDR_1,        "Sources (")
    list_set(s, STYLE_SOURCES_HDR_2_SING,   "):\n")
    list_set(s, STYLE_SOURCES_HDR_2_PLUR,   "):\n")
    list_set(s, STYLE_SOURCE_KG_OPEN,       "")
    list_set(s, STYLE_SOURCE_KG_CLOSE,      "/")
    list_set(s, STYLE_SOURCE_BELIEF_PREFIX, " ")
    list_set(s, STYLE_SOURCE_BELIEF_SUFFIX, "\n")
    list_set(s, STYLE_DISAGREE_HDR_1,       "\n! Conflict on '")
    list_set(s, STYLE_DISAGREE_HDR_2,       "' spread=")
    list_set(s, STYLE_DISAGREE_HDR_3,       " (")
    list_set(s, STYLE_DISAGREE_HDR_4,       " sources)\n")
    list_set(s, STYLE_DISAGREE_ITEM_MID,    "=")
    list_set(s, STYLE_DISAGREE_ITEM_INDENT, "  ")
    list_set(s, STYLE_PROJECTION_LABEL,     "\nprojection: v=")
    list_set(s, STYLE_PROJECTION_MID_1,     " a=")
    list_set(s, STYLE_PROJECTION_MID_2,     " r=")
    list_set(s, STYLE_PROJECTION_SUFFIX,    "\n")
    list_set(s, STYLE_EFFECTOR_HDR,         "\nwould:\n")
    list_set(s, STYLE_TRAILER_HDR_1,        "\n[")
    list_set(s, STYLE_TRAILER_HDR_2,        "/1000 ")
    list_set(s, STYLE_TRAILER_HDR_3,        " · ")
    list_set(s, STYLE_TRAILER_SUFFIX,       "]\n")
    list_set(s, STYLE_REFUSAL_HDR,          "! refused: ")
    // Terse hides advisory sections + trailer -- chat UI reads the
    // structured wire payload separately.
    list_set(s, STYLE_SHOW_PROJECTION, 0)
    list_set(s, STYLE_SHOW_EFFECTORS, 0)
    list_set(s, STYLE_SHOW_TRAILER, 0)
    return s
}

// ---- built-in: "formal" --------------------------------------------------
//
// Long-form academic phrasing, indented bullets, "Note:" softer
// disagreement callout, "Advisory factors:" header.

fn style_formal() {
    let s = _style_new_empty("formal")
    list_set(s, STYLE_BULLET,               "    * ")
    list_set(s, STYLE_ANSWER_HEADER,        "")
    list_set(s, STYLE_SOURCES_HDR_1,        "\nSources consulted (")
    list_set(s, STYLE_SOURCES_HDR_2_SING,   " reference):\n")
    list_set(s, STYLE_SOURCES_HDR_2_PLUR,   " references):\n")
    list_set(s, STYLE_SOURCE_KG_OPEN,       "  * from ")
    list_set(s, STYLE_SOURCE_KG_CLOSE,      ": ")
    list_set(s, STYLE_SOURCE_BELIEF_PREFIX, " (posterior ")
    list_set(s, STYLE_SOURCE_BELIEF_SUFFIX, "/1000)\n")
    list_set(s, STYLE_DISAGREE_HDR_1,       "\nNote: the consulted sources differ on '")
    list_set(s, STYLE_DISAGREE_HDR_2,       "' (spread of ")
    list_set(s, STYLE_DISAGREE_HDR_3,       " milli across ")
    list_set(s, STYLE_DISAGREE_HDR_4,       " sources):\n")
    list_set(s, STYLE_DISAGREE_ITEM_MID,    " reports a posterior of ")
    list_set(s, STYLE_DISAGREE_ITEM_INDENT, "      ")
    list_set(s, STYLE_PROJECTION_LABEL,     "\nAdvisory factors (persona projection, non-binding): predicted valence shift ")
    list_set(s, STYLE_PROJECTION_MID_1,     "; arousal shift ")
    list_set(s, STYLE_PROJECTION_MID_2,     "; risk assessment ")
    list_set(s, STYLE_PROJECTION_SUFFIX,    "/1000.\n")
    list_set(s, STYLE_EFFECTOR_HDR,         "\nProposed actions (described, awaiting the effector gate):\n")
    list_set(s, STYLE_TRAILER_HDR_1,        "\n-- confidence ")
    list_set(s, STYLE_TRAILER_HDR_2,        "/1000; parsed via ")
    list_set(s, STYLE_TRAILER_HDR_3,        "; style ")
    list_set(s, STYLE_TRAILER_SUFFIX,       ".\n")
    list_set(s, STYLE_REFUSAL_HDR,          "The system declined to answer: ")
    return s
}

// ---- registry ------------------------------------------------------------
//
// Process-wide singleton of built-in + external style capsules,
// keyed by name. Lazy-init so importing this module has no side
// effect until a caller reaches for it.

let _style_reg = 0

fn _style_registry() {
    if _style_reg != 0 { return _style_reg }
    let reg = list_new()
    push(reg, style_default())
    push(reg, style_terse())
    push(reg, style_formal())
    _style_reg = reg
    return _style_reg
}

// Register a new style capsule at runtime. Duplicate names REPLACE the
// prior entry (last-write-wins), so a pack that ships a "default"
// override can install it without a name collision error. Returns the
// updated registry.
fn style_registry_register(style) {
    let reg = _style_registry()
    let name = style_name(style)
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(style_name(reg[i]), name) == 1 {
            list_set(reg, i, style)
            return reg
        }
        i = i + 1
    }
    push(reg, style)
    return reg
}

// Return the style capsule for `name`, or the "default" style if the
// name is unknown / empty. Never returns 0 -- the templater can call
// this with any string and get a usable knob set back.
fn style_registry_lookup(name) {
    let reg = _style_registry()
    if len(name) > 0 {
        let i = 0
        while i < len(reg) {
            if str_eq_bytes(style_name(reg[i]), name) == 1 { return reg[i] }
            i = i + 1
        }
    }
    // Fallback: the first entry is always the default (see _style_registry).
    return reg[0]
}

// Enumerate registered style names, for operator introspection / a
// future `style.list` RPC verb.
fn style_registry_names() {
    let reg = _style_registry()
    let out = list_new()
    let i = 0
    while i < len(reg) { push(out, style_name(reg[i])) i = i + 1 }
    return out
}

fn style_registry_count() { return len(_style_registry()) }

// Did the lookup fall back to the default because the name was unknown?
// Used by the templater to emit a one-time trace crumb so operators
// notice a persona pointing at a style capsule that isn't loaded.
fn style_registry_is_known(name) {
    if len(name) == 0 { return 1 }        // "" means "no ref set" -> default is the intended pick
    let reg = _style_registry()
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(style_name(reg[i]), name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}
