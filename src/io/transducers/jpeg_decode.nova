// CrossEngin io/transducers: JPEG (baseline sequential) decoder (P3.1.JPEG).
//
// Purpose
//   The next plank after PNG (P3.1.PNG) in the modality bridge -- a
//   pure-NOVA decoder for the BASELINE-SEQUENTIAL 8-bit-grayscale JPEG
//   format. JPEG is the dominant on-disk format for photographs and is
//   the format `IMAGE_AUDIT.md` calls out as "JPEG before PNG" for the
//   agent's perception path. The structural half (segment markers + DQT
//   + SOF0 + DHT tables) landed in the first P3.1.JPEG session; this
//   session ships the ENTROPY DECODE + IDCT pipeline that turns parsed
//   tables + scan data into real grayscale pixel data per ITU-T T.81
//   Annex F.
//
//   Scope of this MVP (deferred items are spelled out below):
//     * Segment marker iteration (SOI/APPn/COM/DQT/SOF0/DHT/SOS/EOI)
//                                            supported
//     * DQT parse (quantization table)        supported
//     * SOF0 parse (baseline dimensions)      supported
//     * DHT parse (Huffman table headers)     supported
//     * APPn / COM / unknown markers          skipped over by length
//     * SOF1/2/3/.. (extended / progressive / lossless / arithmetic)
//                                            DEFERRED (rejected at parse)
//     * SOS scan-data + Huffman entropy decode  supported (per Annex F.2.2)
//     * De-quantize + inverse zig-zag          supported
//     * 8x8 IDCT (DCT inverse)                  supported (integer fixed-point)
//     * Block-row assembly into pixel buffer    supported
//     * Level-shift (+128) + clamp to 0..255    supported
//     * YCbCr -> RGB color conversion          DEFERRED (grayscale-only MVP)
//     * 4:2:0 / 4:2:2 chroma subsampling       DEFERRED (grayscale-only MVP)
//
//   With this extension `jpeg_decode_grayscale(path)` returns real
//   pixel data for any baseline-sequential 8-bit grayscale JPEG with
//   one component (Y plane) and 1:1 sampling. The perception path
//   ingests a real JPEG the same way it ingests a PGM or PNG -- the
//   visual seam dispatches by file extension and feeds the resulting
//   pixel buffer to `vp_features_for_image`.
//
// Public API
//   jpeg_parse_segments(bytes_ptr, len) -> list of
//       [marker, offset, length] tuples (one per segment found)
//   jpeg_parse_dqt(bytes_ptr, segment_offset, segment_length) ->
//       list of [precision, table_id, list_of_64_ints] tuples (a DQT
//       segment may carry MORE than one quantization table)
//   jpeg_parse_sof0(bytes_ptr, segment_offset, segment_length) ->
//       [precision, height, width, n_components,
//        list_of_[id, h_samp, v_samp, q_table_id], error_msg]
//   jpeg_parse_dht(bytes_ptr, segment_offset, segment_length) ->
//       list of [table_class, table_id, list_of_16_length_counts,
//                list_of_symbols] tuples (a DHT segment may carry MORE
//       than one Huffman table)
//   jpeg_decode_grayscale(path) -> [width, height, pixel_data_ptr, error]
//       Decodes a baseline-sequential 8-bit single-component (grayscale)
//       JPEG end-to-end. On success: pixel_data_ptr is an alloc'd buffer
//       of width*height bytes, error is the empty string. On failure
//       (unsupported format, malformed file, decode error): pixel_data_ptr
//       is 0 and error carries a descriptive message. Width and height
//       come from SOF0 so the perception path can still surface them
//       even when pixel decode hits a deferred branch.
//   jpeg_decode_grayscale_bytes(buf, total) -> same shape; in-memory
//       variant useful for unit tests that build fixtures with alloc.
//
// JPEG marker layout (ITU-T T.81 Annex B):
//   Every segment begins with a 2-byte marker: 0xFF followed by a
//   marker code byte (0x00 = byte stuffing, 0xFF = filler, 0xD8 = SOI,
//   0xD9 = EOI, 0xC0 = SOF0 baseline, 0xC4 = DHT, 0xDB = DQT, 0xDA = SOS,
//   0xE0..0xEF = APPn, 0xFE = COM, ...). Most segments carry a 2-byte
//   big-endian length field (including the length bytes themselves)
//   right after the marker; SOI / EOI / TEM and the RST markers
//   (0xD0..0xD7) are length-less.
//
// DQT layout (ITU-T T.81 section B.2.4.1):
//   Each table in a DQT segment: 1 byte (Pq:4 | Tq:4) where Pq is
//   precision (0 = 8-bit, 1 = 16-bit) and Tq is table id (0..3), then
//   64 quantization values in zig-zag order. 8-bit table = 64 bytes;
//   16-bit table = 128 bytes (16-bit big-endian). A single DQT segment
//   can hold multiple tables back-to-back.
//
// SOF0 layout (ITU-T T.81 section B.2.2):
//   1 byte  precision (always 8 for baseline)
//   2 bytes height (big-endian)
//   2 bytes width  (big-endian)
//   1 byte  n_components (1 for grayscale, 3 for YCbCr)
//   per component:
//     1 byte  component id (1 = Y, 2 = Cb, 3 = Cr conventionally)
//     1 byte  (H_sampling:4 | V_sampling:4)
//     1 byte  quantization table id (0..3)
//
// DHT layout (ITU-T T.81 section B.2.4.2):
//   1 byte (Tc:4 | Th:4) where Tc is table class (0 = DC, 1 = AC) and
//     Th is table id (0..3 for baseline)
//   16 bytes: number of codes of each length (1..16)
//   N bytes: the actual code values, where N = sum of the 16 length
//     counts. A single DHT segment can hold multiple tables.
//
// File cap: JPEG dimensions are bounded at 1024x1024 (mirror of
// PGM_MAX_DIM / PNG_MAX_DIM) so the dimension product stays at or
// under NOVA's codegen pointer-threshold gotcha #11. File-read cap
// is 1 MiB (1048576 bytes); JPEG is heavily compressed so a 1024x1024
// grayscale photograph is typically 50-300 KB on disk.
//
// NOVA gotchas worked around:
//   - JPEG is BIG-ENDIAN throughout (markers, lengths, dimensions).
//     We use byte-by-byte int_mul-based reads same as `png_decode.nova`.
//   - Codegen pointer-threshold (gotcha #11): pixel dimension cap is
//     512x512 (262144 = 2^18) for the decoder pipeline (smaller than
//     the structural-parse 1024x1024 cap) so the IDCT multiplies do not
//     accumulate beyond NOVA's safe integer-range. ~32x32 = 1024 MCUs
//     for a 256x256 image; each MCU does ~500 multiplies (8x8 IDCT 1-D
//     passes + dequant), so a 512x512 image is ~4M multiplies total --
//     well under the 10M-op practical ceiling.
//   - All heavy IDCT arithmetic uses int_mul / int_add / int_sub / int_shr
//     (the Bug-A fix) so intermediate ~2^28 products stay in the pointer-
//     safe regime instead of dispatching to the slow tagged path.
//   - JPEG entropy stream is MSB-first within bytes (opposite of DEFLATE's
//     LSB-first); the bit reader handles the 0xFF 0x00 byte-stuffing
//     convention by transparently dropping the stuffed zero (per Annex B.1.1.5).
//   - Canonical Huffman codes are built from BITS + HUFFVAL using the
//     T.81 Annex C generate-size-table / generate-code-table algorithm.
//   - File cap 1 MiB matches `JPEG_MAX_FILE_BYTES` defined below; the
//     decoder rejects oversized files at read time.
//
// ADRs implemented: ADR-0014 (modality bridge, no cognition path).
// NOVA dependencies: builtins -- alloc, store8, load8, list_new, push,
//   list_set, len, int_to_str, int_add, int_mul, int_sub, int_and,
//   int_shr, int_shl, sys_open, sys_read, sys_close from std/syscall.
// CrossEngin dependencies: NONE (leaf module like deflate_decode.nova).

import "std/syscall"

// ---- marker constants -----------------------------------------------------
//
// JPEG marker bytes follow a 0xFF prefix. We name only the markers we
// care about; everything else falls through to the "skip by length"
// branch in the segment iterator.

let JPEG_MARKER_PREFIX = 255    // 0xFF
let JPEG_MARKER_SOI    = 216    // 0xD8: Start Of Image (no length)
let JPEG_MARKER_EOI    = 217    // 0xD9: End Of Image (no length)
let JPEG_MARKER_SOF0   = 192    // 0xC0: baseline DCT
let JPEG_MARKER_SOF1   = 193    // 0xC1: extended sequential (DEFERRED)
let JPEG_MARKER_SOF2   = 194    // 0xC2: progressive (DEFERRED)
let JPEG_MARKER_SOF3   = 195    // 0xC3: lossless (DEFERRED)
let JPEG_MARKER_DHT    = 196    // 0xC4: Define Huffman Table
let JPEG_MARKER_DAC    = 204    // 0xCC: arithmetic coding (DEFERRED)
let JPEG_MARKER_DQT    = 219    // 0xDB: Define Quantization Table
let JPEG_MARKER_DRI    = 221    // 0xDD: Define Restart Interval
let JPEG_MARKER_SOS    = 218    // 0xDA: Start Of Scan (entropy-coded data follows)
let JPEG_MARKER_COM    = 254    // 0xFE: Comment
let JPEG_MARKER_APP0   = 224    // 0xE0: JFIF / JFXX header
let JPEG_MARKER_APP1   = 225    // 0xE1: EXIF / XMP header
let JPEG_MARKER_APPF   = 239    // 0xEF: highest APPn (APP15)

// Restart markers 0xD0..0xD7 are inline within scan data and length-less.
let JPEG_MARKER_RST0   = 208
let JPEG_MARKER_RST7   = 215

// ---- caps / sentinels -----------------------------------------------------

let JPEG_MAX_DIM        = 1024
let JPEG_MAX_PIXEL_AREA = 1048576    // 1024 * 1024

// Pixel-decode cap is tighter than the structural-parse cap. Real entropy +
// IDCT decoding multiplies through 64 coefficients per 8x8 block; capping
// dimensions at 512 keeps total multiply count under ~10M for the entire
// image (32x32=1024 MCUs at 256x256; ~4096 MCUs at 512x512). Files larger
// than 512 on either axis are accepted by the structural parser (which
// caps at 1024) but the pixel decode path returns a clear "downsample
// first" diagnostic so the operator sees the cap before the decoder
// commits to a heavy compute load.
let JPEG_MAX_DECODE_DIM = 512
let JPEG_MAX_DECODE_AREA = 262144   // 512 * 512

// File cap. JPEG is heavily compressed so this gives plenty of headroom
// for the kind of photograph the perception path will encounter.
let JPEG_MAX_FILE_BYTES = 1048576    // 1 MiB

// A DQT segment with a single 8-bit table is exactly 64 entries.
let JPEG_DQT_ENTRIES = 64

// DHT length counts are always 16 (one per code length 1..16 bits).
let JPEG_DHT_LENGTHS = 16

// Baseline JPEG SOF0 precision is always 8 bits per sample.
let JPEG_BASELINE_PRECISION = 8

// Maximum components in SOF0 we care about: grayscale=1, YCbCr=3 (CMYK=4
// is out of scope for the MVP).
let JPEG_MAX_COMPONENTS = 4

// Result tuple indices for jpeg_decode_grayscale.
let JPEG_R_WIDTH  = 0
let JPEG_R_HEIGHT = 1
let JPEG_R_DATA   = 2
let JPEG_R_ERROR  = 3

// Segment tuple indices for jpeg_parse_segments entries.
let JPEG_S_MARKER = 0
let JPEG_S_OFFSET = 1
let JPEG_S_LENGTH = 2

// DQT-per-table tuple indices.
let JPEG_DQT_PRECISION = 0
let JPEG_DQT_TABLE_ID  = 1
let JPEG_DQT_ENTRIES_I = 2

// SOF0 result tuple indices.
let JPEG_SOF0_PRECISION  = 0
let JPEG_SOF0_HEIGHT     = 1
let JPEG_SOF0_WIDTH      = 2
let JPEG_SOF0_NCOMPS     = 3
let JPEG_SOF0_COMPONENTS = 4
let JPEG_SOF0_ERROR      = 5

// Per-component tuple indices inside SOF0_COMPONENTS.
let JPEG_COMP_ID         = 0
let JPEG_COMP_H_SAMP     = 1
let JPEG_COMP_V_SAMP     = 2
let JPEG_COMP_QTABLE_ID  = 3

// DHT-per-table tuple indices.
let JPEG_DHT_CLASS      = 0
let JPEG_DHT_TABLE_ID   = 1
let JPEG_DHT_LENGTHS_I  = 2
let JPEG_DHT_SYMBOLS_I  = 3

// ---- result helpers -------------------------------------------------------

fn _jpeg_decode_result(width, height, data, error_msg) {
    let r = list_new()
    push(r, width)
    push(r, height)
    push(r, data)
    push(r, error_msg)
    return r
}

fn _jpeg_decode_fail(error_msg) {
    return _jpeg_decode_result(0, 0, 0, error_msg)
}

fn _jpeg_segment(marker, offset, length) {
    let r = list_new()
    push(r, marker)
    push(r, offset)
    push(r, length)
    return r
}

fn _jpeg_dqt_table(precision, table_id, entries) {
    let r = list_new()
    push(r, precision)
    push(r, table_id)
    push(r, entries)
    return r
}

fn _jpeg_dht_table(table_class, table_id, lengths, symbols) {
    let r = list_new()
    push(r, table_class)
    push(r, table_id)
    push(r, lengths)
    push(r, symbols)
    return r
}

fn _jpeg_sof0_result(precision, height, width, n_comps, comps, error_msg) {
    let r = list_new()
    push(r, precision)
    push(r, height)
    push(r, width)
    push(r, n_comps)
    push(r, comps)
    push(r, error_msg)
    return r
}

fn _jpeg_sof0_fail(error_msg) {
    let empty = list_new()
    return _jpeg_sof0_result(0, 0, 0, 0, empty, error_msg)
}

fn _jpeg_comp(id, h_samp, v_samp, qtable_id) {
    let r = list_new()
    push(r, id)
    push(r, h_samp)
    push(r, v_samp)
    push(r, qtable_id)
    return r
}

// ---- result accessors -----------------------------------------------------

fn jpeg_result_width(r)  { return r[JPEG_R_WIDTH] }
fn jpeg_result_height(r) { return r[JPEG_R_HEIGHT] }
fn jpeg_result_data(r)   { return r[JPEG_R_DATA] }
fn jpeg_result_error(r)  { return r[JPEG_R_ERROR] }
fn jpeg_result_ok(r) {
    if len(r[JPEG_R_ERROR]) > 0 { return 0 }
    if r[JPEG_R_WIDTH] <= 0 { return 0 }
    if r[JPEG_R_DATA] == 0 { return 0 }
    return 1
}

fn jpeg_segment_marker(seg) { return seg[JPEG_S_MARKER] }
fn jpeg_segment_offset(seg) { return seg[JPEG_S_OFFSET] }
fn jpeg_segment_length(seg) { return seg[JPEG_S_LENGTH] }

fn jpeg_dqt_precision(t) { return t[JPEG_DQT_PRECISION] }
fn jpeg_dqt_table_id(t)  { return t[JPEG_DQT_TABLE_ID] }
fn jpeg_dqt_entries(t)   { return t[JPEG_DQT_ENTRIES_I] }

fn jpeg_dht_class(t)     { return t[JPEG_DHT_CLASS] }
fn jpeg_dht_table_id(t)  { return t[JPEG_DHT_TABLE_ID] }
fn jpeg_dht_lengths(t)   { return t[JPEG_DHT_LENGTHS_I] }
fn jpeg_dht_symbols(t)   { return t[JPEG_DHT_SYMBOLS_I] }

fn jpeg_sof0_precision(r)  { return r[JPEG_SOF0_PRECISION] }
fn jpeg_sof0_height(r)     { return r[JPEG_SOF0_HEIGHT] }
fn jpeg_sof0_width(r)      { return r[JPEG_SOF0_WIDTH] }
fn jpeg_sof0_n_comps(r)    { return r[JPEG_SOF0_NCOMPS] }
fn jpeg_sof0_components(r) { return r[JPEG_SOF0_COMPONENTS] }
fn jpeg_sof0_error(r)      { return r[JPEG_SOF0_ERROR] }

fn jpeg_comp_id(c)         { return c[JPEG_COMP_ID] }
fn jpeg_comp_h_samp(c)     { return c[JPEG_COMP_H_SAMP] }
fn jpeg_comp_v_samp(c)     { return c[JPEG_COMP_V_SAMP] }
fn jpeg_comp_qtable_id(c)  { return c[JPEG_COMP_QTABLE_ID] }

// ---- big-endian readers ---------------------------------------------------
//
// JPEG length / dimension fields are 2-byte big-endian. We do the multiply
// via int_mul so the result stays safe past NOVA's 1MB threshold (a 16-bit
// length never exceeds 65535, well under the ceiling, but consistency with
// `png_decode.nova` is worth it).

fn _jpeg_read_u16_be(bytes_ptr, off) {
    let b0 = load8(bytes_ptr + off)
    let b1 = load8(bytes_ptr + off + 1)
    return int_add(int_mul(b0, 256), b1)
}

// ---- segment iterator -----------------------------------------------------
//
// Walk a JPEG bytestream starting at offset 0, return a list of
// [marker, offset, length] tuples one per segment. The walk:
//   1. Expect 0xFF marker prefix; skip filler 0xFF bytes between segments.
//   2. Read the marker code byte. SOI/EOI/TEM/RSTn are length-less.
//   3. For every other marker, read the 2-byte big-endian length field
//      (which INCLUDES the length bytes themselves -- so the payload
//      size is `length - 2`).
//   4. The `offset` in the returned tuple points at the start of the
//      PAYLOAD (after the marker AND the length bytes); `length` is the
//      payload length (length_field - 2). For SOI/EOI/RSTn (no length)
//      offset points at the marker itself and length is 0.
//   5. SOS marks the start of entropy-coded data. Per ITU-T T.81 B.1.1.2
//      "the data following the SOS segment shall be the entropy-coded
//      data segment...". For our purposes we record the SOS segment
//      and stop iteration; the entropy data is parsed by the (deferred)
//      Huffman path. We do NOT scan past SOS for nested markers since
//      a 0xFF in entropy-coded data is escaped as 0xFF 0x00.
//
// Returns: a list (possibly empty) of segment tuples. Callers should
// look for SOI as the first tuple and EOI as the last; the SOF0 / DQT /
// DHT tuples in between are what the parser functions consume.

fn jpeg_parse_segments(bytes_ptr, total_len) {
    let out = list_new()
    if total_len < 2 { return out }
    let off = 0
    let keep = 1
    while keep == 1 {
        // Skip filler bytes between markers (per ITU-T T.81 B.1.1.2).
        // Multiple 0xFF bytes in a row before a non-zero marker code
        // are legal "filler"; we advance past them. We use a sentinel
        // variable rather than `break` so the loop stays portable to
        // every NOVA codegen path the rest of CrossEngin uses.
        let scanning = 1
        while scanning == 1 {
            if off >= total_len {
                scanning = 0
                keep = 0
                return out
            }
            if load8(bytes_ptr + off) == JPEG_MARKER_PREFIX {
                if off + 1 >= total_len {
                    scanning = 0
                    keep = 0
                    return out
                }
                let next = load8(bytes_ptr + off + 1)
                if next == JPEG_MARKER_PREFIX {
                    // Filler 0xFF 0xFF; advance one byte and re-check.
                    off = off + 1
                } else {
                    // Real marker found; stop scanning and fall through.
                    scanning = 0
                }
            } else {
                // No marker prefix here -- could be entropy data we
                // walked into; abort iteration.
                scanning = 0
                keep = 0
                return out
            }
        }
        if off >= total_len { keep = 0; return out }
        if off + 1 >= total_len { keep = 0; return out }
        if load8(bytes_ptr + off) != JPEG_MARKER_PREFIX {
            keep = 0
            return out
        }
        let marker = load8(bytes_ptr + off + 1)
        // SOI / EOI / TEM / RSTn / 0x00 padding: length-less.
        if _jpeg_marker_is_lengthless(marker) == 1 {
            push(out, _jpeg_segment(marker, off, 0))
            off = int_add(off, 2)
            if marker == JPEG_MARKER_EOI { keep = 0 }
        } else {
            // Standard length-prefixed segment. Read the 2-byte
            // big-endian length field that follows the marker.
            if off + 4 > total_len {
                // Truncated length field.
                push(out, _jpeg_segment(marker, off, 0))
                keep = 0
                return out
            }
            let length_field = _jpeg_read_u16_be(bytes_ptr, off + 2)
            // payload size = length_field - 2 (length field includes
            // its own two bytes per ITU-T T.81 B.1.1.4).
            let payload_len = 0
            if length_field >= 2 {
                payload_len = int_sub(length_field, 2)
            }
            let payload_off = int_add(off, 4)
            if int_add(payload_off, payload_len) > total_len {
                // Truncated payload.
                push(out, _jpeg_segment(marker, payload_off, 0))
                keep = 0
                return out
            }
            push(out, _jpeg_segment(marker, payload_off, payload_len))
            // SOS marks start of entropy-coded data; stop walking.
            if marker == JPEG_MARKER_SOS {
                keep = 0
                return out
            }
            off = int_add(payload_off, payload_len)
        }
    }
    return out
}

// Return 1 if `marker` is one of the length-less JPEG markers
// (SOI, EOI, TEM, RST0..RST7). All others carry a 2-byte length field.
fn _jpeg_marker_is_lengthless(marker) {
    if marker == JPEG_MARKER_SOI { return 1 }
    if marker == JPEG_MARKER_EOI { return 1 }
    // TEM = 0x01; RSTn = 0xD0..0xD7.
    if marker == 1 { return 1 }
    if marker >= JPEG_MARKER_RST0 {
        if marker <= JPEG_MARKER_RST7 { return 1 }
    }
    // 0x00 is byte-stuffing (used to escape 0xFF inside entropy data).
    if marker == 0 { return 1 }
    return 0
}

// ---- DQT parser -----------------------------------------------------------
//
// jpeg_parse_dqt(bytes_ptr, segment_offset, segment_length) -> list of
//   [precision, table_id, list_of_64_ints] tuples
//
// A single DQT segment can carry MORE than one quantization table; we
// walk the segment payload until exhausted. Each table is either 65 bytes
// (8-bit precision Pq=0, 1 + 64) or 129 bytes (16-bit precision Pq=1,
// 1 + 128). Baseline JPEG only uses 8-bit tables; we still PARSE 16-bit
// tables defensively so the iterator does not stall on a non-baseline
// fixture, but the values are stored as their raw 16-bit unsigned ints.

fn jpeg_parse_dqt(bytes_ptr, segment_off, segment_len) {
    let out = list_new()
    let pos = 0
    while pos < segment_len {
        if int_add(pos, 1) > segment_len {
            return out
        }
        let header = load8(bytes_ptr + segment_off + pos)
        let precision = int_shr(header, 4)         // Pq: upper 4 bits
        let table_id  = int_and(header, 15)        // Tq: lower 4 bits
        let entry_bytes = 64
        if precision == 1 {
            entry_bytes = 128
        }
        if int_add(pos + 1, entry_bytes) > segment_len {
            return out
        }
        let entries = list_new()
        let i = 0
        while i < JPEG_DQT_ENTRIES {
            if precision == 0 {
                let v = load8(bytes_ptr + segment_off + pos + 1 + i)
                push(entries, v)
            } else {
                // 16-bit big-endian entry.
                let hi = load8(bytes_ptr + segment_off + pos + 1 + i * 2)
                let lo = load8(bytes_ptr + segment_off + pos + 1 + i * 2 + 1)
                push(entries, int_add(int_mul(hi, 256), lo))
            }
            i = i + 1
        }
        push(out, _jpeg_dqt_table(precision, table_id, entries))
        pos = int_add(pos, int_add(1, entry_bytes))
    }
    return out
}

// ---- SOF0 parser ----------------------------------------------------------
//
// jpeg_parse_sof0(bytes_ptr, segment_offset, segment_length) ->
//   [precision, height, width, n_components, components, error_msg]
//
// SOF0 segment payload:
//   1 byte  P (sample precision, always 8 for baseline)
//   2 bytes Y (height, big-endian)
//   2 bytes X (width, big-endian)
//   1 byte  Nf (number of components, 1 or 3 typically)
//   per component:
//     1 byte Ci (component id)
//     1 byte (Hi:4 | Vi:4) sampling factors
//     1 byte Tqi (quantization table id, 0..3)
// Minimum payload = 6 + 3 * Nf bytes.

fn jpeg_parse_sof0(bytes_ptr, segment_off, segment_len) {
    if segment_len < 6 {
        return _jpeg_sof0_fail("jpeg: SOF0 segment too short for header")
    }
    let precision  = load8(bytes_ptr + segment_off + 0)
    let height     = _jpeg_read_u16_be(bytes_ptr, segment_off + 1)
    let width      = _jpeg_read_u16_be(bytes_ptr, segment_off + 3)
    let n_comps    = load8(bytes_ptr + segment_off + 5)
    if precision != JPEG_BASELINE_PRECISION {
        return _jpeg_sof0_fail("jpeg: SOF0 precision != 8 (only baseline 8-bit supported)")
    }
    if width <= 0 {
        return _jpeg_sof0_fail("jpeg: SOF0 width is zero")
    }
    if height <= 0 {
        return _jpeg_sof0_fail("jpeg: SOF0 height is zero")
    }
    if width > JPEG_MAX_DIM {
        return _jpeg_sof0_fail("jpeg: width exceeds 1024 (downsample first)")
    }
    if height > JPEG_MAX_DIM {
        return _jpeg_sof0_fail("jpeg: height exceeds 1024 (downsample first)")
    }
    if n_comps <= 0 {
        return _jpeg_sof0_fail("jpeg: SOF0 n_components is zero")
    }
    if n_comps > JPEG_MAX_COMPONENTS {
        return _jpeg_sof0_fail("jpeg: SOF0 n_components > 4 (unsupported)")
    }
    let needed = int_add(6, int_mul(n_comps, 3))
    if segment_len < needed {
        return _jpeg_sof0_fail("jpeg: SOF0 segment truncated for component table")
    }
    let comps = list_new()
    let i = 0
    while i < n_comps {
        let base = segment_off + 6 + i * 3
        let id     = load8(bytes_ptr + base + 0)
        let samp   = load8(bytes_ptr + base + 1)
        let h_samp = int_shr(samp, 4)
        let v_samp = int_and(samp, 15)
        let qid    = load8(bytes_ptr + base + 2)
        push(comps, _jpeg_comp(id, h_samp, v_samp, qid))
        i = i + 1
    }
    return _jpeg_sof0_result(precision, height, width, n_comps, comps, "")
}

// ---- DHT parser -----------------------------------------------------------
//
// jpeg_parse_dht(bytes_ptr, segment_offset, segment_length) -> list of
//   [table_class, table_id, list_of_16_length_counts, list_of_symbols]
//
// A single DHT segment can carry MULTIPLE Huffman tables back-to-back.
// Each table layout:
//   1 byte (Tc:4 | Th:4)
//   16 bytes BITS[1..16] (number of codes of each bit length)
//   N bytes HUFFVAL (the actual symbol values, length = sum of BITS)
// Total per table = 1 + 16 + N bytes.

fn jpeg_parse_dht(bytes_ptr, segment_off, segment_len) {
    let out = list_new()
    let pos = 0
    while pos < segment_len {
        if int_add(pos, 17) > segment_len {
            return out
        }
        let header = load8(bytes_ptr + segment_off + pos)
        let table_class = int_shr(header, 4)    // Tc: 0=DC, 1=AC
        let table_id    = int_and(header, 15)   // Th: 0..3 (baseline)
        // Read the 16 length counts.
        let lengths = list_new()
        let total_symbols = 0
        let i = 0
        while i < JPEG_DHT_LENGTHS {
            let c = load8(bytes_ptr + segment_off + pos + 1 + i)
            push(lengths, c)
            total_symbols = int_add(total_symbols, c)
            i = i + 1
        }
        // The symbol table follows immediately.
        if int_add(pos + 17, total_symbols) > segment_len {
            return out
        }
        let symbols = list_new()
        let k = 0
        while k < total_symbols {
            let s = load8(bytes_ptr + segment_off + pos + 17 + k)
            push(symbols, s)
            k = k + 1
        }
        push(out, _jpeg_dht_table(table_class, table_id, lengths, symbols))
        pos = int_add(pos, int_add(17, total_symbols))
    }
    return out
}

// ---- segment finders ------------------------------------------------------
//
// Convenience helpers for the dispatch path: walk a segment list returned
// by jpeg_parse_segments and find the first SOF0 / first SOS / first DQT
// segment by marker code. Returns the segment tuple or 0 if not found.

fn jpeg_find_segment(segments, marker) {
    let i = 0
    let n = len(segments)
    while i < n {
        let s = segments[i]
        if jpeg_segment_marker(s) == marker {
            return s
        }
        i = i + 1
    }
    return 0
}

fn jpeg_count_segments(segments, marker) {
    let count = 0
    let i = 0
    let n = len(segments)
    while i < n {
        let s = segments[i]
        if jpeg_segment_marker(s) == marker {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ---- zig-zag table --------------------------------------------------------
//
// JPEG stores DCT coefficients in zig-zag scan order (ITU-T T.81 Figure A.6):
// the (i,j) entry in the natural 8x8 row-major layout corresponds to the
// zz_to_natural[k] position in scan order. We build the table once on first
// use and cache it in a module-level list.

let _jpeg_zigzag_cache = 0

fn _jpeg_zigzag_table() {
    if _jpeg_zigzag_cache != 0 { return _jpeg_zigzag_cache }
    let zz = list_new()
    // The standard JPEG zig-zag scan order: zz_to_natural[k] = 8*row + col
    // for the k-th coefficient in scan order. Hand-coded from T.81 A.6.
    push(zz, 0)
    push(zz, 1)
    push(zz, 8)
    push(zz, 16)
    push(zz, 9)
    push(zz, 2)
    push(zz, 3)
    push(zz, 10)
    push(zz, 17)
    push(zz, 24)
    push(zz, 32)
    push(zz, 25)
    push(zz, 18)
    push(zz, 11)
    push(zz, 4)
    push(zz, 5)
    push(zz, 12)
    push(zz, 19)
    push(zz, 26)
    push(zz, 33)
    push(zz, 40)
    push(zz, 48)
    push(zz, 41)
    push(zz, 34)
    push(zz, 27)
    push(zz, 20)
    push(zz, 13)
    push(zz, 6)
    push(zz, 7)
    push(zz, 14)
    push(zz, 21)
    push(zz, 28)
    push(zz, 35)
    push(zz, 42)
    push(zz, 49)
    push(zz, 56)
    push(zz, 57)
    push(zz, 50)
    push(zz, 43)
    push(zz, 36)
    push(zz, 29)
    push(zz, 22)
    push(zz, 15)
    push(zz, 23)
    push(zz, 30)
    push(zz, 37)
    push(zz, 44)
    push(zz, 51)
    push(zz, 58)
    push(zz, 59)
    push(zz, 52)
    push(zz, 45)
    push(zz, 38)
    push(zz, 31)
    push(zz, 39)
    push(zz, 46)
    push(zz, 53)
    push(zz, 60)
    push(zz, 61)
    push(zz, 54)
    push(zz, 47)
    push(zz, 55)
    push(zz, 62)
    push(zz, 63)
    _jpeg_zigzag_cache = zz
    return zz
}

// ---- canonical Huffman table build ---------------------------------------
//
// JPEG canonical Huffman codes per ITU-T T.81 Annex C.
// Input: BITS[1..16] (number of codes of each bit length) and HUFFVAL[]
// (the symbol values in canonical order).
// Output: a decode table laid out as
//   slot 0: mincode[1..16] -- smallest code value at each bit length
//                             (index 0 unused; an entry of -1 means
//                              "no codes at this length")
//   slot 1: maxcode[1..16] -- largest code value at each bit length
//                             (an entry of -1 means "no codes at this length")
//   slot 2: valptr[1..16]  -- starting index in HUFFVAL for codes of
//                             each bit length
//   slot 3: huffval        -- the HUFFVAL symbol list (the original list)
//
// Decoding: accumulate `code` MSB-first; at each bit length L, if
// code <= maxcode[L], the symbol is huffval[valptr[L] + (code - mincode[L])].
//
// The output indices use 17-element lists (so we can index 1..16 directly
// with L without offsetting).

let JPEG_HT_MINCODE = 0
let JPEG_HT_MAXCODE = 1
let JPEG_HT_VALPTR  = 2
let JPEG_HT_HUFFVAL = 3

fn _jpeg_build_huffman(bits, huffval) {
    // Build HUFFSIZE[]: a list of bit-lengths, one per symbol, in canonical
    // order. HUFFSIZE[k] = L means the k-th symbol has bit length L.
    let huffsize = list_new()
    let L = 1
    while L <= 16 {
        let count = bits[L - 1]
        let c = 0
        while c < count {
            push(huffsize, L)
            c = c + 1
        }
        L = L + 1
    }
    let lastk = len(huffsize)
    // Build HUFFCODE[]: canonical codes per Annex C, Figure C.2.
    // SI = HUFFSIZE[0]; CODE = 0; K = 0.
    // While HUFFSIZE[K] == SI: HUFFCODE[K] = CODE; CODE = CODE+1; K = K+1.
    // CODE = CODE << 1; SI = SI + 1; until K == LASTK.
    let huffcode = list_new()
    let i = 0
    while i < lastk {
        push(huffcode, 0)
        i = i + 1
    }
    if lastk > 0 {
        // Generate HUFFCODE per T.81 Annex C, Figure C.2 (generate_code_table).
        // The loop walks all symbols in canonical order; whenever the size
        // increments, the running CODE shifts left to align to the new size.
        let code = 0
        let si = huffsize[0]
        let k = 0
        while k < lastk {
            if huffsize[k] == si {
                list_set(huffcode, k, code)
                code = int_add(code, 1)
                k = k + 1
            } else {
                code = int_shl(code, 1)
                si = si + 1
            }
        }
    }
    // Build mincode[L], maxcode[L], valptr[L] over L = 1..16. We allocate
    // 17-element lists so we can index by L directly.
    let mincode = list_new()
    let maxcode = list_new()
    let valptr  = list_new()
    let z = 0
    while z < 17 {
        push(mincode, -1)
        push(maxcode, -1)
        push(valptr,  0)
        z = z + 1
    }
    // For each bit-length L from 1..16, find the range of indices in
    // HUFFCODE / HUFFSIZE whose length == L. mincode = HUFFCODE[first];
    // maxcode = HUFFCODE[last]; valptr = first.
    let L2 = 1
    let cursor = 0
    while L2 <= 16 {
        let count = bits[L2 - 1]
        if count > 0 {
            list_set(mincode, L2, huffcode[cursor])
            list_set(valptr,  L2, cursor)
            list_set(maxcode, L2, huffcode[int_add(cursor, int_sub(count, 1))])
            cursor = int_add(cursor, count)
        }
        L2 = L2 + 1
    }
    let tbl = list_new()
    push(tbl, mincode)
    push(tbl, maxcode)
    push(tbl, valptr)
    push(tbl, huffval)
    return tbl
}

// ---- bit reader (MSB-first within bytes; honors 0xFF 0x00 stuffing) ------
//
// State layout for the JPEG bit reader:
//   [0] bytes_ptr        - raw buffer pointer
//   [1] total_len        - bytes available
//   [2] byte_pos         - current byte index
//   [3] bit_buffer       - accumulated bits (high bit = next bit to consume)
//   [4] bits_in_buffer   - how many valid bits in bit_buffer
//   [5] marker_seen      - 0 if no marker seen, else the marker code (e.g. EOI)
//
// Bits are read MSB-first per ITU-T T.81 F.2.2.4. Byte stuffing (Annex
// B.1.1.5): a literal 0xFF byte in the entropy data is followed by 0x00;
// we transparently drop the 0x00. If we see 0xFF followed by anything
// other than 0x00, that's an embedded marker (typically RSTn or EOI); we
// stash it in marker_seen and stop refilling the buffer.

let JPEG_BR_BYTES   = 0
let JPEG_BR_TOTAL   = 1
let JPEG_BR_POS     = 2
let JPEG_BR_BUF     = 3
let JPEG_BR_NBITS   = 4
let JPEG_BR_MARKER  = 5

fn _jpeg_bitreader_new(bytes_ptr, byte_off, total_len) {
    let s = list_new()
    push(s, bytes_ptr)
    push(s, total_len)
    push(s, byte_off)
    push(s, 0)
    push(s, 0)
    push(s, 0)
    return s
}

// Refill the bit buffer with one byte. Handles 0xFF 0x00 byte stuffing and
// sets marker_seen if we encounter a real marker. Returns 1 on success,
// 0 if we hit EOF or a marker (in which case caller should stop).
fn _jpeg_br_refill_byte(br) {
    if br[JPEG_BR_MARKER] != 0 { return 0 }
    let pos = br[JPEG_BR_POS]
    if pos >= br[JPEG_BR_TOTAL] { return 0 }
    let b = load8(br[JPEG_BR_BYTES] + pos)
    pos = pos + 1
    if b == 255 {
        // 0xFF: peek at the next byte. If 0x00, drop it (byte stuffing).
        // Otherwise it's a marker -- stash and stop.
        if pos >= br[JPEG_BR_TOTAL] {
            list_set(br, JPEG_BR_POS, pos)
            list_set(br, JPEG_BR_MARKER, 1)
            return 0
        }
        let nxt = load8(br[JPEG_BR_BYTES] + pos)
        pos = pos + 1
        if nxt == 0 {
            // Stuffed 0xFF -- the byte to add is the real 0xFF.
            list_set(br, JPEG_BR_POS, pos)
            let nb = int_add(br[JPEG_BR_NBITS], 8)
            list_set(br, JPEG_BR_BUF,
                     int_or(int_shl(br[JPEG_BR_BUF], 8), 255))
            list_set(br, JPEG_BR_NBITS, nb)
            return 1
        }
        // Marker encountered. Roll back POS to just before the 0xFF so
        // the segment iterator can re-find it if needed.
        list_set(br, JPEG_BR_POS, int_sub(pos, 2))
        list_set(br, JPEG_BR_MARKER, nxt)
        return 0
    }
    list_set(br, JPEG_BR_POS, pos)
    let nb2 = int_add(br[JPEG_BR_NBITS], 8)
    list_set(br, JPEG_BR_BUF, int_or(int_shl(br[JPEG_BR_BUF], 8), b))
    list_set(br, JPEG_BR_NBITS, nb2)
    return 1
}

// Read N bits (1..16 typical) from the bit reader, MSB-first. Returns the
// bit value as a non-negative int. Returns 0 if the stream is exhausted
// (caller should check marker_seen).
fn _jpeg_br_read_bits(br, n) {
    while br[JPEG_BR_NBITS] < n {
        if _jpeg_br_refill_byte(br) == 0 {
            // Stream ended; pad zero bits. Caller can detect via marker_seen.
            if br[JPEG_BR_NBITS] < n {
                // Pad with zeros to satisfy the read.
                let pad = int_sub(n, br[JPEG_BR_NBITS])
                list_set(br, JPEG_BR_BUF, int_shl(br[JPEG_BR_BUF], pad))
                list_set(br, JPEG_BR_NBITS, n)
            }
        }
    }
    let shift = int_sub(br[JPEG_BR_NBITS], n)
    let v = int_and(int_shr(br[JPEG_BR_BUF], shift), int_sub(int_shl(1, n), 1))
    list_set(br, JPEG_BR_NBITS, shift)
    // Mask the consumed bits out of the buffer to keep it bounded.
    list_set(br, JPEG_BR_BUF,
             int_and(br[JPEG_BR_BUF], int_sub(int_shl(1, shift), 1)))
    return v
}

// Decode one Huffman symbol from the bit reader against `tbl`. Returns the
// decoded symbol value, or -1 if no code matches within 16 bits (which is
// a corrupt stream).
fn _jpeg_br_decode_huffman(br, tbl) {
    let mincode = tbl[JPEG_HT_MINCODE]
    let maxcode = tbl[JPEG_HT_MAXCODE]
    let valptr  = tbl[JPEG_HT_VALPTR]
    let huffval = tbl[JPEG_HT_HUFFVAL]
    let code = _jpeg_br_read_bits(br, 1)
    let L = 1
    while L <= 16 {
        let mxc = maxcode[L]
        if mxc != -1 {
            if code <= mxc {
                let mnc = mincode[L]
                let offset = int_sub(code, mnc)
                let idx = int_add(valptr[L], offset)
                if idx >= 0 {
                    if idx < len(huffval) {
                        return huffval[idx]
                    }
                }
                return -1
            }
        }
        L = L + 1
        if L <= 16 {
            // Append one more bit (MSB-first: shift left, OR new bit).
            let nb = _jpeg_br_read_bits(br, 1)
            code = int_or(int_shl(code, 1), nb)
        }
    }
    return -1
}

// JPEG "EXTEND" procedure (ITU-T T.81 Figure F.12). Given a SSSS-bit
// magnitude S and a raw read value V in [0, 2^S - 1], return the signed
// representation: V >= 2^(S-1) means V is its own positive value; otherwise
// it's a negative value V - (2^S - 1).
fn _jpeg_extend(v, s) {
    if s == 0 { return 0 }
    let half = int_shl(1, int_sub(s, 1))
    if v >= half { return v }
    return int_add(int_sub(v, int_shl(1, s)), 1)
}

// ---- per-MCU entropy decode (DC + 63 AC) ---------------------------------
//
// Decode one 8x8 block of coefficients in zig-zag order. Mutates `prev_dc`
// implicitly: the caller passes in the previous block's DC and we return
// the new DC value alongside the coefficient list.
//
// Returns [coefficients_zigzag, new_prev_dc, error_msg]
//   coefficients_zigzag: 64-element list in zig-zag scan order
//   new_prev_dc: the absolute DC value to feed to the next block
//   error_msg: "" on success, non-empty on Huffman / RLE failure

let JPEG_BLK_COEFS = 0
let JPEG_BLK_DC    = 1
let JPEG_BLK_ERR   = 2

fn _jpeg_decode_block(br, dc_table, ac_table, prev_dc) {
    let coefs = list_new()
    let i = 0
    while i < 64 {
        push(coefs, 0)
        i = i + 1
    }
    // DC: read SSSS (size) via DC Huffman; then read SSSS bits as the
    // signed delta; new DC = prev_dc + delta.
    let s = _jpeg_br_decode_huffman(br, dc_table)
    if s < 0 {
        let r = list_new()
        push(r, coefs)
        push(r, prev_dc)
        push(r, "jpeg: DC Huffman decode failed")
        return r
    }
    let dc_delta = 0
    if s > 0 {
        let raw = _jpeg_br_read_bits(br, s)
        dc_delta = _jpeg_extend(raw, s)
    }
    let new_dc = int_add(prev_dc, dc_delta)
    list_set(coefs, 0, new_dc)
    // AC: 63 coefficients; loop until EOB or all read.
    let k = 1
    while k < 64 {
        let rs = _jpeg_br_decode_huffman(br, ac_table)
        if rs < 0 {
            let r2 = list_new()
            push(r2, coefs)
            push(r2, new_dc)
            push(r2, "jpeg: AC Huffman decode failed")
            return r2
        }
        let run  = int_shr(rs, 4)
        let size = int_and(rs, 15)
        if rs == 0 {
            // EOB: rest are zeros (already are).
            k = 64
        } else {
            if rs == 240 {
                // ZRL: 16 zeros, no coefficient written; advance k by 16.
                k = int_add(k, 16)
            } else {
                k = int_add(k, run)
                if k >= 64 {
                    let r3 = list_new()
                    push(r3, coefs)
                    push(r3, new_dc)
                    push(r3, "jpeg: AC RLE overflow (run drove index past 63)")
                    return r3
                }
                let raw_ac = _jpeg_br_read_bits(br, size)
                let v = _jpeg_extend(raw_ac, size)
                list_set(coefs, k, v)
                k = k + 1
            }
        }
    }
    let res = list_new()
    push(res, coefs)
    push(res, new_dc)
    push(res, "")
    return res
}

// ---- dequant + inverse zig-zag ------------------------------------------
//
// Given a 64-element coefficient list in zig-zag order and a 64-element
// quantization table (also in zig-zag order in the DQT segment), produce
// a 64-element list in row-major natural order containing
// coef[k] * qtable[k] placed at zz_to_natural[k].

fn _jpeg_dequant_and_unzigzag(zz_coefs, qtable) {
    let zz_table = _jpeg_zigzag_table()
    let natural = list_new()
    let i = 0
    while i < 64 {
        push(natural, 0)
        i = i + 1
    }
    let k = 0
    while k < 64 {
        let nat_idx = zz_table[k]
        let q = qtable[k]
        // int_mul keeps the (up to ~2^11 coef) * (up to ~2^16 q) product
        // safe past NOVA's pointer-threshold gotcha.
        let v = int_mul(zz_coefs[k], q)
        list_set(natural, nat_idx, v)
        k = k + 1
    }
    return natural
}

// ---- 1-D 8-point integer IDCT (Loeffler-style; fixed-point) -------------
//
// We use a straightforward integer IDCT with cosine coefficients scaled by
// 1024 (10-bit fixed point). This gives ample precision for the
// "first pixel matches Pillow +/- 1" tolerance.
//
// The eight 1-D output samples are:
//   y[n] = (1/2) * SUM_{u=0}^{7} C[u] * X[u] * cos((2n+1) u pi / 16)
// where C[0] = 1/sqrt(2), C[u>0] = 1.
//
// Pre-multiplied 10-bit fixed-point cosines:
//   T(u,n) = round(1024 * (1/2) * C[u] * cos((2n+1) u pi / 16))
// The matrix is 8x8; we accumulate Y[n] = SUM_{u=0}^{7} X[u] * T(u,n),
// then divide by 1024 for the unscaled result. For accuracy we add 512
// (half the divisor) before dividing.
//
// int_mul on each accumulator: per output sample we do 8 multiplies of
// magnitude <= 2^11 * 2^10 = 2^21, which sums to <= 2^24 -- safe under
// the pointer-threshold gotcha.

let _jpeg_idct_cos_cache = 0

fn _jpeg_idct_cos_table() {
    if _jpeg_idct_cos_cache != 0 { return _jpeg_idct_cos_cache }
    // Hand-computed T(u,n) = round(1024 * (C[u]/2) * cos((2n+1)*u*pi/16))
    // for u, n in 0..7. C[0] = 1/sqrt(2) ~= 0.7071068; C[u>0] = 1.
    // The table is row-indexed by u, column-indexed by n; we lay it out as
    // a flat 64-element list: tbl[u*8 + n].
    //
    // u=0 row: 1024*0.7071068/2 = 362 for every n.
    // u=1 row: 1024/2 * cos((2n+1)*pi/16) -- the standard IDCT basis.
    // ... etc.
    //
    // The values were generated offline with:
    //   import math
    //   for u in range(8):
    //       row = []
    //       Cu = 1/math.sqrt(2) if u == 0 else 1.0
    //       for n in range(8):
    //           v = 1024 * (Cu/2) * math.cos((2*n+1)*u*math.pi/16)
    //           row.append(round(v))
    //       print(row)
    // and pasted in. Each entry is an exact int.
    let tbl = list_new()
    // u=0: 362, 362, 362, 362, 362, 362, 362, 362
    push(tbl, 362); push(tbl, 362); push(tbl, 362); push(tbl, 362)
    push(tbl, 362); push(tbl, 362); push(tbl, 362); push(tbl, 362)
    // u=1: 502, 426, 284, 100, -100, -284, -426, -502
    push(tbl, 502); push(tbl, 426); push(tbl, 284); push(tbl, 100)
    push(tbl, -100); push(tbl, -284); push(tbl, -426); push(tbl, -502)
    // u=2: 473, 196, -196, -473, -473, -196, 196, 473
    push(tbl, 473); push(tbl, 196); push(tbl, -196); push(tbl, -473)
    push(tbl, -473); push(tbl, -196); push(tbl, 196); push(tbl, 473)
    // u=3: 426, -100, -502, -284, 284, 502, 100, -426
    push(tbl, 426); push(tbl, -100); push(tbl, -502); push(tbl, -284)
    push(tbl, 284); push(tbl, 502); push(tbl, 100); push(tbl, -426)
    // u=4: 362, -362, -362, 362, 362, -362, -362, 362
    push(tbl, 362); push(tbl, -362); push(tbl, -362); push(tbl, 362)
    push(tbl, 362); push(tbl, -362); push(tbl, -362); push(tbl, 362)
    // u=5: 284, -502, 100, 426, -426, -100, 502, -284
    push(tbl, 284); push(tbl, -502); push(tbl, 100); push(tbl, 426)
    push(tbl, -426); push(tbl, -100); push(tbl, 502); push(tbl, -284)
    // u=6: 196, -473, 473, -196, -196, 473, -473, 196
    push(tbl, 196); push(tbl, -473); push(tbl, 473); push(tbl, -196)
    push(tbl, -196); push(tbl, 473); push(tbl, -473); push(tbl, 196)
    // u=7: 100, -284, 426, -502, 502, -426, 284, -100
    push(tbl, 100); push(tbl, -284); push(tbl, 426); push(tbl, -502)
    push(tbl, 502); push(tbl, -426); push(tbl, 284); push(tbl, -100)
    _jpeg_idct_cos_cache = tbl
    return tbl
}

// Apply 1-D IDCT to one row: 8 input coefs X[u], produce 8 output samples
// Y[n] = sum_u X[u] * T(u,n). Returns a fresh 8-element list of ints
// (still scaled by 1024 -- caller divides at the end).
fn _jpeg_idct_1d(row_in) {
    let tbl = _jpeg_idct_cos_table()
    let out = list_new()
    let n = 0
    while n < 8 {
        let acc = 0
        let u = 0
        while u < 8 {
            // T(u,n) is at tbl[u*8 + n]. Multiply by X[u] and accumulate.
            // int_mul keeps the result in the pointer-safe regime.
            acc = int_add(acc, int_mul(row_in[u], tbl[int_add(int_mul(u, 8), n)]))
            u = u + 1
        }
        push(out, acc)
        n = n + 1
    }
    return out
}

// Apply the 2-D IDCT to one 8x8 block (input is a 64-element list in
// row-major natural order). Returns a 64-element list of pixel values
// in 0..255, after the +128 level shift and clamping.
//
// The separable algorithm: do an 8-point 1-D IDCT on each row, divide by
// 1024 with rounding, then do an 8-point 1-D IDCT on each column and
// divide by 1024 again. Each 1-D IDCT accumulator does at most 8 multiplies
// of magnitude ~2^11 * 2^10 = ~2^21 (~2 million), summing to ~2^24 (~16M)
// per output -- safely under NOVA's pointer-threshold ceiling when we use
// int_mul / int_add throughout. After the row pass we divide back to ~2^11
// so the column-pass intermediate stays bounded the same way.
fn _jpeg_idct_2d(block) {
    // First pass: 1-D IDCT on each row. Divide by 1024 with rounding so
    // the column-pass inputs stay bounded.
    let row_pass = list_new()
    let i = 0
    while i < 64 {
        push(row_pass, 0)
        i = i + 1
    }
    let r = 0
    while r < 8 {
        let row_in = list_new()
        let c = 0
        while c < 8 {
            push(row_in, block[int_add(int_mul(r, 8), c)])
            c = c + 1
        }
        let row_out = _jpeg_idct_1d(row_in)
        let c2 = 0
        while c2 < 8 {
            let v = row_out[c2]
            let rounded = _jpeg_div_round(v, 1024)
            list_set(row_pass, int_add(int_mul(r, 8), c2), rounded)
            c2 = c2 + 1
        }
        r = r + 1
    }
    // Second pass: 1-D IDCT on each column.
    let result = list_new()
    let z = 0
    while z < 64 {
        push(result, 0)
        z = z + 1
    }
    let cc = 0
    while cc < 8 {
        let col_in = list_new()
        let rr = 0
        while rr < 8 {
            push(col_in, row_pass[int_add(int_mul(rr, 8), cc)])
            rr = rr + 1
        }
        let col_out = _jpeg_idct_1d(col_in)
        let rr2 = 0
        while rr2 < 8 {
            let v = col_out[rr2]
            let rounded = _jpeg_div_round(v, 1024)
            let p = int_add(rounded, 128)
            if p < 0 { p = 0 }
            if p > 255 { p = 255 }
            list_set(result, int_add(int_mul(rr2, 8), cc), p)
            rr2 = rr2 + 1
        }
        cc = cc + 1
    }
    return result
}

// Round-to-nearest division for both positive and negative values. NOVA's
// int_shr does an arithmetic shift on positive ints; for negative we mirror
// the rounding direction by negating, adding half-divisor, dividing, and
// negating back. `divisor` MUST be positive.
fn _jpeg_div_round(v, divisor) {
    let half = int_shr(divisor, 1)
    if v >= 0 {
        return int_add(v, half) / divisor
    }
    return int_sub(0, int_add(int_sub(0, v), half) / divisor)
}

// ---- assemble decoded blocks into a pixel buffer -------------------------
//
// Walk the scan-data bytes block by block, decoding each 8x8 MCU and
// writing the resulting pixels at the correct position in `pixels`. For
// the grayscale baseline MVP each MCU is exactly one 8x8 block of the Y
// component; blocks are laid out left-to-right, top-to-bottom.
//
// Image dimensions need not be a multiple of 8: trailing partial blocks
// are decoded fully (the encoder padded them) but only the in-bounds
// pixels are written.
//
// Returns "" on success, an error message string on failure.

fn _jpeg_decode_scan(br, width, height, dc_table, ac_table, qtable, pixels) {
    let n_blocks_x = int_shr(int_add(width, 7), 3)
    let n_blocks_y = int_shr(int_add(height, 7), 3)
    let prev_dc = 0
    let by = 0
    while by < n_blocks_y {
        let bx = 0
        while bx < n_blocks_x {
            let blk = _jpeg_decode_block(br, dc_table, ac_table, prev_dc)
            let err = blk[JPEG_BLK_ERR]
            if len(err) > 0 { return err }
            prev_dc = blk[JPEG_BLK_DC]
            let zz_coefs = blk[JPEG_BLK_COEFS]
            let natural = _jpeg_dequant_and_unzigzag(zz_coefs, qtable)
            let samples = _jpeg_idct_2d(natural)
            // Write the 8x8 block into pixels at (bx*8, by*8). Clip to the
            // image dimensions for trailing partial blocks.
            let x0 = int_mul(bx, 8)
            let y0 = int_mul(by, 8)
            let py = 0
            while py < 8 {
                let yy = int_add(y0, py)
                if yy < height {
                    let row_off = int_mul(yy, width)
                    let px = 0
                    while px < 8 {
                        let xx = int_add(x0, px)
                        if xx < width {
                            let v = samples[int_add(int_mul(py, 8), px)]
                            store8(pixels + int_add(row_off, xx), v)
                        }
                        px = px + 1
                    }
                }
                py = py + 1
            }
            bx = bx + 1
        }
        by = by + 1
    }
    return ""
}

// ---- DHT / DQT lookup helpers --------------------------------------------
//
// The decoder needs a specific DC + AC Huffman table for the Y component
// (table ids encoded in SOS) and the Y-component quantization table (table
// id encoded in SOF0). These helpers walk the segment list, parse each
// DHT / DQT segment, and return the FIRST matching table by (class, id)
// for DHT or (id) for DQT. Returns 0 if no match.

fn _jpeg_find_huffman_table(buf, segments, table_class, table_id) {
    let i = 0
    let n = len(segments)
    while i < n {
        let s = segments[i]
        if jpeg_segment_marker(s) == JPEG_MARKER_DHT {
            let tables = jpeg_parse_dht(buf, jpeg_segment_offset(s),
                                        jpeg_segment_length(s))
            let j = 0
            while j < len(tables) {
                let t = tables[j]
                if jpeg_dht_class(t) == table_class {
                    if jpeg_dht_table_id(t) == table_id {
                        return t
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0
}

fn _jpeg_find_quant_table(buf, segments, table_id) {
    let i = 0
    let n = len(segments)
    while i < n {
        let s = segments[i]
        if jpeg_segment_marker(s) == JPEG_MARKER_DQT {
            let tables = jpeg_parse_dqt(buf, jpeg_segment_offset(s),
                                        jpeg_segment_length(s))
            let j = 0
            while j < len(tables) {
                let t = tables[j]
                if jpeg_dqt_table_id(t) == table_id {
                    return t
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0
}

// ---- SOS segment parser (minimal, single-component only) -----------------
//
// SOS payload layout (T.81 B.2.3):
//   1 byte Ns (number of components in scan)
//   per component:
//     1 byte Cs (component selector)
//     1 byte (Td:4 | Ta:4) DC + AC Huffman table ids
//   1 byte Ss (start of spectral selection, 0 for baseline)
//   1 byte Se (end of spectral selection, 63 for baseline)
//   1 byte (Ah:4 | Al:4) (0 for baseline)
//
// For the grayscale MVP we need Ns=1 and the (Td, Ta) pair for the Y
// component. We return [td, ta, error_msg].

let JPEG_SOS_TD  = 0
let JPEG_SOS_TA  = 1
let JPEG_SOS_ERR = 2

fn _jpeg_parse_sos(buf, segment_off, segment_len) {
    let r = list_new()
    push(r, 0)
    push(r, 0)
    push(r, "")
    if segment_len < 6 {
        list_set(r, JPEG_SOS_ERR, "jpeg: SOS segment too short")
        return r
    }
    let ns = load8(buf + segment_off + 0)
    if ns != 1 {
        list_set(r, JPEG_SOS_ERR, "jpeg: SOS Ns != 1 (only grayscale single-component supported)")
        return r
    }
    // Cs (component selector) at byte 1; Td/Ta at byte 2.
    let tdta = load8(buf + segment_off + 2)
    list_set(r, JPEG_SOS_TD, int_shr(tdta, 4))
    list_set(r, JPEG_SOS_TA, int_and(tdta, 15))
    return r
}

// ---- decoder entry point --------------------------------------------------
//
// jpeg_decode_grayscale(path) -- the full grayscale-baseline pipeline.
// Reads the file, parses structural segments, validates the JPEG is
// baseline grayscale, walks the entropy stream block by block,
// dequantizes + zig-zag-undoes + IDCT's each 8x8 block, and writes the
// resulting pixels into an alloc'd buffer of width*height bytes.
//
// On success: pixel_data is the buffer ptr, error is "".
// On failure: pixel_data is 0, error is a descriptive message.

fn jpeg_decode_grayscale(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 {
        return _jpeg_decode_fail("jpeg: cannot open file")
    }
    let buf = alloc(JPEG_MAX_FILE_BYTES + 1)
    let total = 0
    let keep = 1
    let chunk = 4096
    while keep == 1 {
        let space_left = int_sub(JPEG_MAX_FILE_BYTES, total)
        let want = chunk
        if want > space_left { want = space_left }
        if want <= 0 { keep = 0 }
        if keep == 1 {
            let n = sys_read(fd, buf + total, want)
            if n <= 0 {
                keep = 0
            } else {
                total = int_add(total, n)
                if total >= JPEG_MAX_FILE_BYTES { keep = 0 }
            }
        }
    }
    sys_close(fd)
    if total <= 0 {
        return _jpeg_decode_fail("jpeg: empty file")
    }
    return jpeg_decode_grayscale_bytes(buf, total)
}

// In-memory variant. Useful for unit tests that build a fixture in alloc'd
// memory rather than on disk.
fn jpeg_decode_grayscale_bytes(buf, total) {
    if total < 4 {
        return _jpeg_decode_fail("jpeg: file too short")
    }
    // Validate SOI: 0xFF 0xD8 at the start.
    if load8(buf + 0) != JPEG_MARKER_PREFIX {
        return _jpeg_decode_fail("jpeg: missing SOI marker (first byte != 0xFF)")
    }
    if load8(buf + 1) != JPEG_MARKER_SOI {
        return _jpeg_decode_fail("jpeg: missing SOI marker (second byte != 0xD8)")
    }
    let segments = jpeg_parse_segments(buf, total)
    let nseg = len(segments)
    if nseg == 0 {
        return _jpeg_decode_fail("jpeg: no segments parsed")
    }
    // Look for SOF0.
    let sof0_seg = jpeg_find_segment(segments, JPEG_MARKER_SOF0)
    if sof0_seg == 0 {
        // Check whether the file uses an unsupported SOF variant.
        if jpeg_find_segment(segments, JPEG_MARKER_SOF1) != 0 {
            return _jpeg_decode_fail("jpeg: SOF1 (extended sequential) not supported -- see JPEG_AUDIT.md")
        }
        if jpeg_find_segment(segments, JPEG_MARKER_SOF2) != 0 {
            return _jpeg_decode_fail("jpeg: SOF2 (progressive) not supported -- see JPEG_AUDIT.md")
        }
        if jpeg_find_segment(segments, JPEG_MARKER_SOF3) != 0 {
            return _jpeg_decode_fail("jpeg: SOF3 (lossless) not supported -- see JPEG_AUDIT.md")
        }
        return _jpeg_decode_fail("jpeg: no SOF0 (baseline) marker found")
    }
    let sof0 = jpeg_parse_sof0(buf, jpeg_segment_offset(sof0_seg),
                               jpeg_segment_length(sof0_seg))
    let sof0_err = jpeg_sof0_error(sof0)
    if len(sof0_err) > 0 {
        return _jpeg_decode_fail(sof0_err)
    }
    let width  = jpeg_sof0_width(sof0)
    let height = jpeg_sof0_height(sof0)
    let n_comps = jpeg_sof0_n_comps(sof0)
    // For grayscale, n_comps must be 1.
    if n_comps != 1 {
        // Return dimensions but a clear color-not-supported message so
        // the perception path can still surface the size.
        return _jpeg_decode_result(width, height, 0,
            "jpeg: n_components=" + int_to_str(n_comps)
            + " (only grayscale n_components=1 supported in MVP); see JPEG_AUDIT.md")
    }
    // Pixel-decode cap (smaller than the structural-parse cap). Surface a
    // clear "downsample first" diagnostic so the operator still sees the
    // parsed dimensions and knows the file just won't be entropy-decoded.
    if width > JPEG_MAX_DECODE_DIM {
        return _jpeg_decode_result(width, height, 0,
            "jpeg: width " + int_to_str(width)
            + " exceeds decode cap " + int_to_str(JPEG_MAX_DECODE_DIM)
            + " (downsample first); see JPEG_AUDIT.md")
    }
    if height > JPEG_MAX_DECODE_DIM {
        return _jpeg_decode_result(width, height, 0,
            "jpeg: height " + int_to_str(height)
            + " exceeds decode cap " + int_to_str(JPEG_MAX_DECODE_DIM)
            + " (downsample first); see JPEG_AUDIT.md")
    }
    // Look up SOS and pull out the (Td, Ta) Huffman table ids for Y.
    let sos_seg = jpeg_find_segment(segments, JPEG_MARKER_SOS)
    if sos_seg == 0 {
        return _jpeg_decode_result(width, height, 0,
            "jpeg: no SOS marker found; cannot locate entropy data")
    }
    let sos = _jpeg_parse_sos(buf, jpeg_segment_offset(sos_seg),
                              jpeg_segment_length(sos_seg))
    let sos_err = sos[JPEG_SOS_ERR]
    if len(sos_err) > 0 {
        return _jpeg_decode_result(width, height, 0, sos_err)
    }
    let td = sos[JPEG_SOS_TD]
    let ta = sos[JPEG_SOS_TA]
    // Quantization table id from SOF0 component descriptor.
    let comps = jpeg_sof0_components(sof0)
    let comp0 = comps[0]
    let q_id = jpeg_comp_qtable_id(comp0)
    // Resolve DC + AC Huffman tables and the quantization table.
    let dht_raw = _jpeg_find_huffman_table(buf, segments, 0, td)
    if dht_raw == 0 {
        return _jpeg_decode_result(width, height, 0,
            "jpeg: missing DC Huffman table id=" + int_to_str(td))
    }
    let aht_raw = _jpeg_find_huffman_table(buf, segments, 1, ta)
    if aht_raw == 0 {
        return _jpeg_decode_result(width, height, 0,
            "jpeg: missing AC Huffman table id=" + int_to_str(ta))
    }
    let qt_raw = _jpeg_find_quant_table(buf, segments, q_id)
    if qt_raw == 0 {
        return _jpeg_decode_result(width, height, 0,
            "jpeg: missing quantization table id=" + int_to_str(q_id))
    }
    let dc_table = _jpeg_build_huffman(jpeg_dht_lengths(dht_raw),
                                       jpeg_dht_symbols(dht_raw))
    let ac_table = _jpeg_build_huffman(jpeg_dht_lengths(aht_raw),
                                       jpeg_dht_symbols(aht_raw))
    let qtable   = jpeg_dqt_entries(qt_raw)
    // Allocate the output pixel buffer. width*height stays under 262144
    // for our 512x512 cap so the int_mul-protected product is safe.
    let area = int_mul(width, height)
    let pixels = alloc(int_add(area, 1))
    // Zero-fill so trailing partial-block pixels and any in-bounds gaps
    // start at 0.
    let zi = 0
    while zi < area {
        store8(pixels + zi, 0)
        zi = zi + 1
    }
    // Entropy data starts right after the SOS payload. payload_off +
    // payload_len is the byte right after the SOS header.
    let entropy_off = int_add(jpeg_segment_offset(sos_seg),
                              jpeg_segment_length(sos_seg))
    let br = _jpeg_bitreader_new(buf, entropy_off, total)
    let scan_err = _jpeg_decode_scan(br, width, height,
                                     dc_table, ac_table, qtable, pixels)
    if len(scan_err) > 0 {
        return _jpeg_decode_result(width, height, 0, scan_err)
    }
    // Decode OK -- return the pixel buffer.
    return _jpeg_decode_result(width, height, pixels, "")
}
