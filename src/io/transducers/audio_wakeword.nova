// CrossEngin io/transducers: integer-only wake-word detector via MFCC
// template matching + DTW (R18C).
//
// Purpose
//   R17B shipped the integer-only MFCC front end (Mel-Frequency Cepstral
//   Coefficients) built on R16E's STFT. The natural application is
//   wake-word detection ("Hey Nova", "Computer", etc.): extract MFCC
//   from a single reference utterance once at training time, then
//   continuously compare incoming audio against that template via
//   Dynamic Time Warping (DTW) so the matcher tolerates differences in
//   speech rate between the enrolled reference and a live utterance.
//
//   Stack:
//     1. Reference utterance -> MFCC sequence (template_t).
//     2. Incoming audio segment -> MFCC sequence.
//     3. DTW distance between the two MFCC sequences (path-length
//        normalized so different-length comparisons are commensurable).
//     4. If distance < threshold AND R7F VAD said the segment held
//        speech: wake-word detected.
//     5. Smooth a 5-frame moving average over consecutive detections to
//        suppress single-frame false positives.
//
//   None of the surface is LLM-shaped or floating-point. Everything
//   stays in milli (1000 = 1.0) and integer arithmetic, the same
//   conventions every other audio transducer in this repo uses
//   (audio_dsp / audio_spectrogram / audio_mfcc).
//
//   Algorithm -- Dynamic Time Warping on MFCC sequences:
//
//     D[i][j] = local_distance(input[i], reference[j])
//             + min(D[i-1][j], D[i][j-1], D[i-1][j-1])
//
//     with D[0][0] = local_distance(input[0], reference[0]).
//     The full lattice fills a [N x M] table where N = input frames and
//     M = reference frames. Final distance = D[N-1][M-1] / (N + M) so
//     the path-length-normalized value is comparable across utterances
//     of different durations.
//
//   Local distance: squared L2 between two 13-dim MFCC vectors. We
//   reuse R17B's mfcc_l2_distance_sq (skips coef 0, the energy term,
//   so loudness doesn't dominate the spectral-shape match). Output is
//   milli^2 internally; we keep the final DTW distance in milli^2 too
//   so the threshold knob the caller passes is "milli^2 cumulative L2
//   distance per matched-frame-pair".
//
//   Caps:
//     * max template frames: WAKE_TEMPLATE_MAX_FRAMES = 256 (3-4
//       seconds of MFCC at the R16E default hop, comfortably above any
//       single wake-word utterance).
//     * input frames also capped at 256 so the DTW lattice stays
//       <= 256 x 256 = 65536 cells (each int63), well under any sane
//       memory budget.
//
//   VAD interlock: wake_detect calls into R7F vad_process_pcm and
//   refuses to fire when the buffer holds no detected speech segment;
//   pure noise / silence then routes to detected=false even if the
//   MFCC distance happens to come out small (rare on noise; common on
//   exact-silence which projects all-MFCC to zero).
//
// ADRs: ADR-0014 (modality bridge, frequency-domain leg, classifier
//   layer).
// NOVA dependencies: builtins -- alloc, list_new, push, list_set, len,
//   int_mul / int_add / int_sub / int_div / int_shr / int_shl,
//   sys_open, sys_write, sys_read, sys_close, sys_fsync, int_to_str,
//   str_to_int, char_at, substr.
// CrossEngin dependencies: audio_mfcc (R17B -- MFCC sequence builder),
//   audio_capture (R6E -- WAV loader for the train/detect chat
//   helpers), audio_vad (R7F -- speech-presence gate so wake-words
//   only fire on actual voice).

import "std/syscall"
import "audio_capture.nova"
import "audio_mfcc.nova"
import "audio_vad.nova"

// ---- public caps + defaults ----------------------------------------------

// Maximum frames in a stored template. 256 frames at the R16E default
// hop_size=256 @ 16 kHz is 4.1 seconds -- well above any single
// wake-word utterance (typical "Hey Nova" is ~700 ms).
let WAKE_TEMPLATE_MAX_FRAMES = 256

// Maximum frames in a single detection segment. Same cap as templates
// so the DTW lattice stays bounded at 256 x 256.
let WAKE_INPUT_MAX_FRAMES = 256

// Default detection threshold (milli^2 cumulative L2 per matched-frame
// pair, path-normalized). Empirical default tuned against Klatt
// vowel-pair fixtures: same-vowel comparisons sit at < 10000; different
// vowel comparisons sit at > 50000. 30000 puts a comfortable margin
// between the two while still catching the same-utterance round-trip
// regardless of normal speech-rate variation.
let WAKE_DEFAULT_THRESHOLD = 30000

// Smoothing window: rolling 5-frame moving average over the per-segment
// detection booleans. Mirrors the brief; reduces single-frame chatter
// (which on integer MFCC math is rare, but the smoothing field is
// exposed in the detection record so a wrapper can do its own
// state-machine).
let WAKE_SMOOTH_WINDOW = 5

// Persistence magic. The save/load round-trip writes a one-line header
// "WAKE_TEMPLATE 1" so a stale file from another tool can be detected
// (load returns 0) without crashing.
let WAKE_TEMPLATE_MAGIC = "WAKE_TEMPLATE"
let WAKE_TEMPLATE_VERSION = 1

// File mode for saved templates (0644).
let _WAKE_FILE_MODE = 420

// ---- public constant accessors -------------------------------------------

fn wake_template_max_frames() { return WAKE_TEMPLATE_MAX_FRAMES }
fn wake_input_max_frames()    { return WAKE_INPUT_MAX_FRAMES }
fn wake_default_threshold()   { return WAKE_DEFAULT_THRESHOLD }
fn wake_smooth_window()       { return WAKE_SMOOTH_WINDOW }

// ---- comparison helpers --------------------------------------------------
//
// Same arithmetic-shift sign-bit pattern as audio_dsp / audio_mfcc --
// guards against NOVA's smart `<` / `>` dispatching to _nova_strcmp when
// both operands exceed the pointer threshold.

fn _wake_int_lt(a, b) {
    let d = int_sub(a, b)
    let sign = int_shr(d, 63)
    if sign == 0 { return 0 }
    return 1
}

fn _wake_int_gt(a, b) { return _wake_int_lt(b, a) }

fn _wake_int_min3(a, b, c) {
    let m = a
    if _wake_int_lt(b, m) == 1 { m = b }
    if _wake_int_lt(c, m) == 1 { m = c }
    return m
}

// ---- template struct layout ---------------------------------------------
//
// template_t is a 5-cell list:
//   [0] tag             (sentinel, currently always 1)
//   [1] frames          (list of MFCC coefficient lists; each length n_mfcc)
//   [2] sample_rate     (Hz; preserved so the loader can pin matching audio)
//   [3] frame_size      (FFT frame size used to build the MFCC)
//   [4] n_mfcc          (cepstral coefs per frame; 13 by R17B default)

let WAKE_TPL_TAG_VAL = 1

fn _wake_template_new(frames, sample_rate, frame_size, n_mfcc) {
    let t = list_new()
    push(t, WAKE_TPL_TAG_VAL)
    push(t, frames)
    push(t, sample_rate)
    push(t, frame_size)
    push(t, n_mfcc)
    return t
}

fn wake_template_frames(t)      { return t[1] }
fn wake_template_rate(t)        { return t[2] }
fn wake_template_frame_size(t)  { return t[3] }
fn wake_template_n_mfcc(t)      { return t[4] }
fn wake_template_frame_count(t) { return len(t[1]) }
fn wake_template_valid(t) {
    if t == 0 { return 0 }
    if len(t) < 5 { return 0 }
    if t[0] != WAKE_TPL_TAG_VAL { return 0 }
    return 1
}

// Extract a single frame's MFCC coefficient list from a template.
fn wake_template_frame_at(t, idx) {
    let frames = t[1]
    if idx < 0 { return list_new() }
    if idx >= len(frames) { return list_new() }
    return frames[idx]
}

// ---- detection-result struct --------------------------------------------
//
// A 3-cell list:
//   [0] detected_bool  (1 if dtw_distance_milli < threshold, else 0)
//   [1] dtw_distance_milli  (path-normalized DTW distance, milli^2)
//   [2] end_frame      (input-MFCC frame index of the best alignment; for
//                       a full-utterance match this is always the last
//                       input frame, but the field stays in the API for
//                       streaming wrappers that prefer the position info)
fn wake_result_detected(r) { return r[0] }
fn wake_result_distance(r) { return r[1] }
fn wake_result_end_frame(r) { return r[2] }

fn _wake_result_new(detected, distance_milli, end_frame) {
    let r = list_new()
    push(r, detected)
    push(r, distance_milli)
    push(r, end_frame)
    return r
}

// ---- DTW core ------------------------------------------------------------
//
// wake_dtw_distance(mfcc_a, mfcc_b) -> path-normalized DTW distance in
// milli^2. mfcc_a and mfcc_b are lists of MFCC frames (each frame a
// list of n_mfcc milli coefficients).
//
// The lattice D is realized as a list-of-lists [N][M] of int63. Per
// cell: D[i][j] = local_dist(a[i], b[j]) + min(D[i-1][j], D[i][j-1],
// D[i-1][j-1]). Boundary i=0 / j=0 cells take only the available
// neighbour (or just the local distance for the corner). Final return
// is D[N-1][M-1] / (N + M).
//
// Returns 0 if either input is empty. Empty / empty rounds to 0
// (defines "no work" as "no distance"; the detection wrapper still
// gates on the VAD interlock so empty input doesn't falsely match).

fn wake_dtw_distance(mfcc_a, mfcc_b) {
    let N = len(mfcc_a)
    let M = len(mfcc_b)
    if N == 0 { return 0 }
    if M == 0 { return 0 }
    // Clip to caps so the DTW table cannot exceed
    // WAKE_INPUT_MAX_FRAMES x WAKE_TEMPLATE_MAX_FRAMES cells.
    if N > WAKE_INPUT_MAX_FRAMES { N = WAKE_INPUT_MAX_FRAMES }
    if M > WAKE_TEMPLATE_MAX_FRAMES { M = WAKE_TEMPLATE_MAX_FRAMES }
    // Allocate the [N][M] lattice. Pre-fill with a sentinel that the
    // corner / edge code overwrites; per-cell init avoids tracking
    // "is this cell live yet?" inside the hot loop.
    let lattice = list_new()
    let i = 0
    while i < N {
        let row = list_new()
        let j = 0
        while j < M {
            push(row, 0)
            j = j + 1
        }
        push(lattice, row)
        i = i + 1
    }
    // Fill the lattice row-by-row.
    let ii = 0
    while ii < N {
        let row_i = lattice[ii]
        let jj = 0
        while jj < M {
            let local = mfcc_l2_distance_sq(mfcc_a[ii], mfcc_b[jj])
            let best = 0
            if ii == 0 {
                if jj == 0 {
                    // Corner: no neighbour.
                    best = 0
                } else {
                    // Top edge: only left.
                    best = row_i[jj - 1]
                }
            } else {
                let prev_row = lattice[ii - 1]
                if jj == 0 {
                    // Left edge: only up.
                    best = prev_row[0]
                } else {
                    // Interior: min of three.
                    best = _wake_int_min3(prev_row[jj], row_i[jj - 1], prev_row[jj - 1])
                }
            }
            let v = int_add(local, best)
            list_set(row_i, jj, v)
            jj = jj + 1
        }
        ii = ii + 1
    }
    // Final distance from corner cell, normalized by (N + M).
    let last_row = lattice[N - 1]
    let total = last_row[M - 1]
    let denom = N + M
    if denom <= 0 { denom = 1 }
    return int_div(total, denom)
}

// ---- template trainer ----------------------------------------------------
//
// Build a template from a wake-word WAV path. Reads via R6E, computes
// the MFCC via R17B, packs into a template_t. Returns 0 on parse
// failure / silence (so the chat helper can report a graceful error).

fn wake_train_template(wav_path) {
    let r = audio_capture_to_pcm(wav_path)
    let pcm = audio_capture_pcm_samples(r)
    let sr = audio_capture_pcm_rate(r)
    if len(pcm) == 0 { return 0 }
    if sr <= 0 { return 0 }
    // Pick frame_size / hop_size: same convention as /mfcc.
    let N = stft_frame_size_default()
    let H = stft_hop_size_default()
    if sr <= 8000 { N = 256; H = 128 }
    let m = mfcc_compute(pcm, sr, N, H, mfcc_n_mfcc_default())
    let frames = mfcc_frames(m)
    if len(frames) == 0 { return 0 }
    // Clip to the template cap (extremely long enrolment utterances
    // are degenerate -- a wake-word is by definition short).
    let kept = list_new()
    let f = 0
    let cap = WAKE_TEMPLATE_MAX_FRAMES
    while f < len(frames) {
        if f >= cap { f = len(frames) } else {
            push(kept, frames[f])
            f = f + 1
        }
    }
    let actual_sr = mfcc_rate(m)
    let actual_N = mfcc_frame_size(m)
    let actual_M = mfcc_n_mfcc(m)
    return _wake_template_new(kept, actual_sr, actual_N, actual_M)
}

// Train directly from an in-memory PCM list (for tests + caller code
// that already has audio in hand). Mirrors wake_train_template's
// post-MFCC packing so the two paths produce bit-identical templates
// from identical PCM.
fn wake_train_template_from_pcm(pcm, sample_rate) {
    if len(pcm) == 0 { return 0 }
    if sample_rate <= 0 { return 0 }
    let N = stft_frame_size_default()
    let H = stft_hop_size_default()
    if sample_rate <= 8000 { N = 256; H = 128 }
    let m = mfcc_compute(pcm, sample_rate, N, H, mfcc_n_mfcc_default())
    let frames = mfcc_frames(m)
    if len(frames) == 0 { return 0 }
    let kept = list_new()
    let f = 0
    let cap = WAKE_TEMPLATE_MAX_FRAMES
    while f < len(frames) {
        if f >= cap { f = len(frames) } else {
            push(kept, frames[f])
            f = f + 1
        }
    }
    let actual_sr = mfcc_rate(m)
    let actual_N = mfcc_frame_size(m)
    let actual_M = mfcc_n_mfcc(m)
    return _wake_template_new(kept, actual_sr, actual_N, actual_M)
}

// ---- template persistence ------------------------------------------------
//
// Text format:
//
//   WAKE_TEMPLATE <version>
//   sample_rate <int>
//   frame_size <int>
//   n_mfcc <int>
//   n_frames <int>
//   frame <c0> <c1> ... <c{n_mfcc-1}>
//   frame ...
//
// Round-trip yields a bit-identical template (same frames in same
// order, same metadata). The unit test asserts this invariant.

fn wake_template_save(template, path) {
    if wake_template_valid(template) == 0 { return 0 }
    let frames = template[1]
    let sr = template[2]
    let nfs = template[3]
    let M = template[4]
    let text = WAKE_TEMPLATE_MAGIC + " " + int_to_str(WAKE_TEMPLATE_VERSION) + "\n"
    text = text + "sample_rate " + int_to_str(sr) + "\n"
    text = text + "frame_size " + int_to_str(nfs) + "\n"
    text = text + "n_mfcc " + int_to_str(M) + "\n"
    let nframes = len(frames)
    text = text + "n_frames " + int_to_str(nframes) + "\n"
    let i = 0
    while i < nframes {
        let row = frames[i]
        let line = "frame"
        let j = 0
        while j < len(row) {
            line = line + " " + int_to_str(row[j])
            j = j + 1
        }
        line = line + "\n"
        text = text + line
        i = i + 1
    }
    let flags = O_WRONLY + O_CREAT + O_TRUNC
    let fd = sys_open(path, flags, _WAKE_FILE_MODE)
    if fd < 0 { return 0 }
    let n = len(text)
    let written = sys_write(fd, text, n)
    if written != n {
        sys_close(fd)
        return 0
    }
    sys_fsync(fd)
    sys_close(fd)
    return 1
}

// ---- text parsing helpers (local to this module) ------------------------

fn _wake_find_byte(s, start, byte) {
    let n = len(s)
    let i = start
    while i < n {
        if char_at(s, i) == byte { return i }
        i = i + 1
    }
    return 0 - 1
}

fn _wake_next_line(text, pos) {
    let nl = _wake_find_byte(text, pos, 10)
    let pair = list_new()
    if nl < 0 {
        push(pair, substr(text, pos, len(text) - pos))
        push(pair, len(text))
        return pair
    }
    push(pair, substr(text, pos, nl - pos))
    push(pair, nl + 1)
    return pair
}

// Split a line on single-space delimiters into a list of token strings.
// Suitable for short whitespace-delimited records (template "frame ..."
// lines have at most n_mfcc+1 tokens).
fn _wake_split_space(line) {
    let toks = list_new()
    let n = len(line)
    let start = 0
    let i = 0
    while i < n {
        if char_at(line, i) == 32 {
            if i > start { push(toks, substr(line, start, i - start)) }
            start = i + 1
        }
        i = i + 1
    }
    if n > start { push(toks, substr(line, start, n - start)) }
    return toks
}

fn _wake_line_key(line) {
    let sp = _wake_find_byte(line, 0, 32)
    if sp < 0 { return line }
    return substr(line, 0, sp)
}

fn _wake_line_val(line) {
    let sp = _wake_find_byte(line, 0, 32)
    if sp < 0 { return "" }
    return substr(line, sp + 1, len(line) - sp - 1)
}

fn _wake_line_val_int(line) {
    return str_to_int(_wake_line_val(line))
}

// Read the entire file at path into a NOVA string. Returns 0 (the int
// sentinel) on any syscall failure -- callers route that to a graceful
// "load FAILED" message.
fn _wake_read_text(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return 0 }
    let chunk = 4096
    let buf = alloc(chunk + 1)
    let acc = ""
    let done = 0
    while done == 0 {
        let m = sys_read(fd, buf, chunk)
        if m <= 0 {
            done = 1
        } else {
            store8(buf + m, 0)
            acc = acc + buf
            if m < chunk { done = 1 }
        }
    }
    sys_close(fd)
    return acc
}

fn wake_template_load(path) {
    let text = _wake_read_text(path)
    if text == 0 { return 0 }
    if len(text) == 0 { return 0 }
    let sr = 0
    let nfs = 0
    let M = 0
    let nframes = 0
    let frames = list_new()
    let pos = 0
    let header_seen = 0
    let total = len(text)
    while pos < total {
        let pair = _wake_next_line(text, pos)
        let line = pair[0]
        pos = pair[1]
        if len(line) == 0 {
            // skip blank lines (trailing newline produces an empty tail)
        } else {
            let key = _wake_line_key(line)
            if str_eq(key, WAKE_TEMPLATE_MAGIC) == 1 {
                let ver = _wake_line_val_int(line)
                if ver != WAKE_TEMPLATE_VERSION { return 0 }
                header_seen = 1
            } else {
                if header_seen == 0 { return 0 }
                if str_eq(key, "sample_rate") == 1 { sr = _wake_line_val_int(line) }
                if str_eq(key, "frame_size") == 1  { nfs = _wake_line_val_int(line) }
                if str_eq(key, "n_mfcc") == 1      { M = _wake_line_val_int(line) }
                if str_eq(key, "n_frames") == 1    { nframes = _wake_line_val_int(line) }
                if str_eq(key, "frame") == 1 {
                    let toks = _wake_split_space(line)
                    let row = list_new()
                    let k = 1
                    while k < len(toks) {
                        push(row, str_to_int(toks[k]))
                        k = k + 1
                    }
                    push(frames, row)
                }
            }
        }
    }
    if header_seen == 0 { return 0 }
    if sr <= 0 { return 0 }
    if M <= 0 { return 0 }
    if len(frames) != nframes { return 0 }
    return _wake_template_new(frames, sr, nfs, M)
}

// ---- wake-word detection -------------------------------------------------
//
// wake_detect(template, audio_buffer, sample_rate, threshold_milli)
//   -> [detected_bool, dtw_distance_milli, end_frame]
//
// Pipeline:
//   1. Reject empty audio outright (detected=false, distance=0, end=0).
//   2. R7F VAD: refuse to fire unless the buffer holds at least one
//      detected speech segment. Avoids matching wake-word templates
//      against pure noise / silence (a no-op for the integer pipeline
//      that produces detected=true on a pure-zero buffer via the
//      degenerate "0 < threshold" path).
//   3. MFCC the incoming audio (R17B), clip to WAKE_INPUT_MAX_FRAMES.
//   4. DTW against the template (wake_dtw_distance).
//   5. detected = (dtw_distance < threshold).

fn wake_detect(template, audio_buffer, sample_rate, threshold_milli) {
    if wake_template_valid(template) == 0 {
        return _wake_result_new(0, 0, 0)
    }
    if len(audio_buffer) == 0 {
        return _wake_result_new(0, 0, 0)
    }
    if sample_rate <= 0 {
        return _wake_result_new(0, 0, 0)
    }
    // VAD interlock. The buffer must hold at least one detected speech
    // segment to fire. Pure-zero / pure-noise buffers fail this gate.
    //
    // Adaptive noise-floor calibration is disabled for the wake-word path:
    // R9B's adaptive multiplier assumes a leading-silence calibration
    // window, but wake-words by definition lead with speech, not silence.
    // The fixed VAD_ENERGY_BASE_8K_scaled floor is more than adequate
    // for the "is this audible voice?" filter we need; the adaptive path
    // is only a refinement for real-mic recordings whose room-noise
    // baseline sits above zero, and would otherwise misclassify the
    // leading speech samples as the calibration noise floor and then
    // refuse to fire on the very signal we want to detect.
    let vad = vad_state_new(sample_rate)
    vad_set_adaptive(vad, 0)
    let segs = vad_process_pcm(vad, audio_buffer)
    if len(segs) == 0 {
        return _wake_result_new(0, 0, 0)
    }
    // MFCC of the incoming audio. Pick frame_size / hop_size matching
    // the trainer's so frames are commensurable.
    let N = stft_frame_size_default()
    let H = stft_hop_size_default()
    if sample_rate <= 8000 { N = 256; H = 128 }
    let m = mfcc_compute(audio_buffer, sample_rate, N, H, mfcc_n_mfcc_default())
    let in_frames = mfcc_frames(m)
    if len(in_frames) == 0 {
        return _wake_result_new(0, 0, 0)
    }
    // Clip to the input cap (mirrors the trainer's cap).
    let kept = list_new()
    let f = 0
    let cap = WAKE_INPUT_MAX_FRAMES
    while f < len(in_frames) {
        if f >= cap { f = len(in_frames) } else {
            push(kept, in_frames[f])
            f = f + 1
        }
    }
    let tpl_frames = template[1]
    let dtw = wake_dtw_distance(kept, tpl_frames)
    let detected = 0
    if _wake_int_lt(dtw, threshold_milli) == 1 { detected = 1 }
    let end_frame = len(kept) - 1
    if end_frame < 0 { end_frame = 0 }
    return _wake_result_new(detected, dtw, end_frame)
}

// ---- 5-frame moving-average smoothing -----------------------------------
//
// wake_smooth(detections) -> smoothed list of 0/1.
//
// Walks a per-segment detection list and emits 1 only where the rolling
// window of size WAKE_SMOOTH_WINDOW (centred conceptually but
// causally-implemented as the previous w samples + current) holds
// at least majority detected. Reduces single-segment false positives.
// Exposed publicly so a streaming wrapper can ensemble its own
// per-window detections.

fn wake_smooth(detections) {
    let out = list_new()
    let n = len(detections)
    let w = WAKE_SMOOTH_WINDOW
    let i = 0
    while i < n {
        let lo = i - w + 1
        if lo < 0 { lo = 0 }
        let sum = 0
        let span = 0
        let j = lo
        while j <= i {
            sum = sum + detections[j]
            span = span + 1
            j = j + 1
        }
        let majority = int_shr(span, 1) + 1
        let v = 0
        if sum >= majority { v = 1 }
        push(out, v)
        i = i + 1
    }
    return out
}

// ---- chat helpers --------------------------------------------------------
//
// Two admin one-liners wired into examples/crossengin_chat.nova:
//
//   /wake_train <wav>   train a template and save to /tmp/wakeword.template
//   /wake <wav>         load /tmp/wakeword.template, run wake_detect
//
// Output shape:
//
//   (wake_train /tmp/x.wav: frames=N, n_mfcc=13 -> saved to /tmp/wakeword.template)
//   (wake /tmp/y.wav: detected=true distance=12345 milli (threshold=30000), end=12)
//
// Error paths:
//   (/wake needs PATH ...)
//   (wake_train FAILED: could not parse WAV at PATH)
//   (wake FAILED: no template at /tmp/wakeword.template; train first)

// Default on-disk template location. Mirrors the convention every
// other "I want a single recallable wake-word" tool in the field uses.
let WAKE_DEFAULT_TEMPLATE_PATH = "/tmp/wakeword.template"

fn wake_default_template_path() { return WAKE_DEFAULT_TEMPLATE_PATH }

fn wake_run_train_command(arg) {
    if len(arg) == 0 {
        return "(/wake_train needs PATH -- usage: /wake_train /tmp/wakeword.wav)"
    }
    let path = str_trim(arg)
    if len(path) == 0 {
        return "(/wake_train needs PATH -- usage: /wake_train /tmp/wakeword.wav)"
    }
    let tpl = wake_train_template(path)
    if tpl == 0 {
        return "(wake_train FAILED: could not parse WAV at " + path + ")"
    }
    let nframes = wake_template_frame_count(tpl)
    let M = wake_template_n_mfcc(tpl)
    let sr = wake_template_rate(tpl)
    let ok = wake_template_save(tpl, WAKE_DEFAULT_TEMPLATE_PATH)
    if ok != 1 {
        return "(wake_train FAILED: could not write template to " + WAKE_DEFAULT_TEMPLATE_PATH + ")"
    }
    let line = "(wake_train " + path + ": frames=" + int_to_str(nframes)
        + ", n_mfcc=" + int_to_str(M)
        + ", sr=" + int_to_str(sr) + " Hz"
        + " -> saved to " + WAKE_DEFAULT_TEMPLATE_PATH + ")"
    return line
}

fn wake_run_detect_command(arg) {
    if len(arg) == 0 {
        return "(/wake needs PATH -- usage: /wake /tmp/input.wav)"
    }
    let path = str_trim(arg)
    if len(path) == 0 {
        return "(/wake needs PATH -- usage: /wake /tmp/input.wav)"
    }
    let tpl = wake_template_load(WAKE_DEFAULT_TEMPLATE_PATH)
    if tpl == 0 {
        return "(wake FAILED: no template at " + WAKE_DEFAULT_TEMPLATE_PATH + "; run /wake_train first)"
    }
    let r = audio_capture_to_pcm(path)
    let pcm = audio_capture_pcm_samples(r)
    let sr = audio_capture_pcm_rate(r)
    if len(pcm) == 0 {
        return "(wake FAILED: could not parse WAV at " + path + ")"
    }
    let thr = WAKE_DEFAULT_THRESHOLD
    let res = wake_detect(tpl, pcm, sr, thr)
    let detected = wake_result_detected(res)
    let dist = wake_result_distance(res)
    let end_f = wake_result_end_frame(res)
    let det_label = "false"
    if detected == 1 { det_label = "true" }
    let line = "(wake " + path + ": detected=" + det_label
        + " distance=" + int_to_str(dist) + " milli"
        + " (threshold=" + int_to_str(thr) + ")"
        + ", end_frame=" + int_to_str(end_f) + ")"
    return line
}
