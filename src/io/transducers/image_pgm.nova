// CrossEngin io/transducers: PGM (Portable Grey Map) binary decoder (P3.1).
//
// Purpose
//   The visual half of the modality bridge that text input (P15) and audio
//   (P19 / P2.6) already cover. Visual perception is otherwise entirely
//   missing from CrossEngin -- there is no eye, no edge detector, no SIFT,
//   no embedding. P3.1 lands the smallest possible plank: a pure-NOVA
//   decoder for the simplest standardized image format on Earth, the
//   Portable Grey Map (PGM, P5 binary variant), plus the matching
//   feature-extraction helpers a perception seam can lean on.
//
//   PGM was chosen over JPEG / PNG / WebP because every interesting
//   compressed format is structurally multi-stage: PNG = zlib(DEFLATE) +
//   filter prediction + interlace handling + 4-channel composition; JPEG
//   = Huffman + zig-zag + IDCT + YCbCr-to-RGB + 4:2:0 chroma upsampling.
//   Each is weeks of pure-NOVA work and a different binary-decoding
//   lift. PGM-P5 is a 3-line ASCII header (magic + dims + maxval)
//   followed by raw 8-bit grayscale bytes. The whole parser fits in
//   ~30 lines. A working PGM decoder PROVES the framework + the
//   `visual_perception.nova` seam + the chat /see admin command end-
//   to-end; JPEG / PNG / feature extraction is the long road
//   `IMAGE_AUDIT.md` lays out.
//
//   ASCII PGM (magic "P2") is a deferred follow-up -- the brief targets
//   binary PGM (magic "P5") and binary is the natural shape for piping
//   from `convert input.jpg output.pgm` (which writes P5 by default).
//
// Public API
//   pgm_parse_bytes(bytes_ptr, len) -> [width, height, maxval,
//                                       pixel_data_ptr, error_msg]
//   pgm_parse_file(path) -> [width, height, maxval, pixel_data_ptr,
//                            error_msg]
//   pgm_pixel(data_ptr, width, x, y) -> int (0..255)
//   pgm_histogram(data_ptr, width, height) -> list of 256 counts
//   pgm_resize_nn(src_data, src_w, src_h, dst_w, dst_h) -> dst_data
//   pgm_dominant_intensity(data, w, h) -> int (0..7 bucket)
//   pgm_mean_intensity(data, w, h) -> int (0..255)
//   pgm_histogram_entropy_milli(hist) -> int (0..8000)
//
// Pixel-count cap: PGM dimensions are bounded at 1024x1024 = ~1M pixels.
// NOVA's codegen pointer-threshold gotcha (#11 / NOVA #6+) misroutes any
// in-function multiply whose product exceeds ~2^20 into str_repeat (the
// pointer-vs-int dispatch matches on magnitude, not type). 1024*1024 ==
// 1048576 ~= 2^20 and is the empirical ceiling; we cap at exactly that
// product and refuse larger PGMs with a clear error. Real callers
// expected to downsample first (the `convert -resize 256x256` shape).
//
// ADRs implemented: ADR-0014 (modality bridge, no cognition path);
//   ADR-0036 (atom hygiene -- feature extraction lives in
//   visual_perception.nova, not here).
// NOVA dependencies: builtins -- alloc, store8, load8, list_new, push,
//   len, char_at, substr, str_to_int, getenv (none), sys_open, sys_read,
//   sys_close, file_size from std/syscall.
// CrossEngin dependencies: none (leaf module -- the visual_perception
//   seam imports this; we import nothing else from CrossEngin so the
//   compilation unit stays small and unit tests are hermetic).

import "std/syscall"

// ---- format constants -----------------------------------------------------

// PGM-P5 magic: bytes 'P' (80) '5' (53). The format is rare enough
// outside graphics contexts that we keep the constants explicit.
let PGM_MAGIC_P     = 80
let PGM_MAGIC_5     = 53

// Hard cap on pixel area to dodge NOVA's codegen pointer-threshold gotcha
// (#11 / NOVA #6+). 1024 * 1024 = 1048576 == 2^20, which is the empirical
// in-function-multiply ceiling. A PGM larger than this is refused at
// parse time with a clear error -- callers should downsample first.
let PGM_MAX_DIM        = 1024
let PGM_MAX_PIXEL_AREA = 1048576   // 1024 * 1024

// Default maxval the parser will accept. PGM nominally supports 1..65535
// (2-byte samples above 255), but the binary format becomes 2-byte big-
// endian above 255. We only accept 1..255 here -- the common case
// `convert input.jpg output.pgm` writes maxval 255 grayscale. A 16-bit
// path is left for a follow-up.
let PGM_MAX_MAXVAL = 255

// Buffer cap on pgm_parse_file. Mirrors the in-function ceiling: 1 MiB
// of raw pixel bytes + ~64 bytes of header is comfortably under NOVA's
// 524288-byte read_file builtin ceiling per call -- so we use direct
// sys_read in a loop instead.
let PGM_MAX_FILE_BYTES = 1048640   // PGM_MAX_PIXEL_AREA + 64

// Result tuple indices, exposed for callers that prefer named access.
let PGM_R_WIDTH    = 0
let PGM_R_HEIGHT   = 1
let PGM_R_MAXVAL   = 2
let PGM_R_DATA     = 3
let PGM_R_ERROR    = 4

// Dominant-intensity bucket count -- 8 evenly-spaced bins over [0..255].
// A 3-bit summary the substrate can perceive as a single atom: 0..31,
// 32..63, ..., 224..255.
let PGM_BUCKET_COUNT = 8

// Histogram length. 256 grayscale levels.
let PGM_HIST_BINS = 256

// ---- result helper --------------------------------------------------------

fn _pgm_result(width, height, maxval, data, error_msg) {
    let r = list_new()
    push(r, width)
    push(r, height)
    push(r, maxval)
    push(r, data)
    push(r, error_msg)
    return r
}

fn _pgm_fail(error_msg) {
    return _pgm_result(0, 0, 0, 0, error_msg)
}

// ---- whitespace + comment skipping ---------------------------------------
//
// PGM headers separate tokens by ASCII whitespace (space, tab, newline,
// carriage return) and may carry '#' comments that run to end-of-line.
// `convert` often writes a "# CREATOR: ImageMagick 6.x" comment between
// the magic and the dimensions, which the parser MUST tolerate.

fn _pgm_is_space(c) {
    if c == 32 { return 1 }    // ' '
    if c == 10 { return 1 }    // '\n'
    if c == 13 { return 1 }    // '\r'
    if c == 9  { return 1 }    // '\t'
    return 0
}

// Advance `off` past whitespace and # comments. Returns the new offset.
// Stops at the first non-whitespace, non-# byte (or end of buffer).
fn _pgm_skip_ws(bytes_ptr, total_len, off) {
    let i = off
    let keep = 1
    while keep == 1 {
        if i >= total_len { keep = 0 }
        if keep == 1 {
            let c = load8(bytes_ptr + i)
            if _pgm_is_space(c) == 1 {
                i = i + 1
            } else {
                if c == 35 {
                    // '#' comment: consume up to and including '\n'.
                    let cont = 1
                    while cont == 1 {
                        if i >= total_len { cont = 0 }
                        if cont == 1 {
                            let c2 = load8(bytes_ptr + i)
                            i = i + 1
                            if c2 == 10 { cont = 0 }
                        }
                    }
                } else {
                    keep = 0
                }
            }
        }
    }
    return i
}

// Parse a base-10 integer token starting at `off`. Returns [value,
// new_offset, ok]. Stops at the first non-digit byte. Empty token -> ok=0.
fn _pgm_parse_int(bytes_ptr, total_len, off) {
    let i = off
    let v = 0
    let count = 0
    let keep = 1
    while keep == 1 {
        if i >= total_len { keep = 0 }
        if keep == 1 {
            let c = load8(bytes_ptr + i)
            if c >= 48 {
                if c <= 57 {
                    v = v * 10 + (c - 48)
                    count = count + 1
                    i = i + 1
                } else {
                    keep = 0
                }
            } else {
                keep = 0
            }
        }
    }
    let r = list_new()
    push(r, v)
    push(r, i)
    if count > 0 { push(r, 1) } else { push(r, 0) }
    return r
}

// ---- core: parse a P5 buffer ---------------------------------------------
//
// Layout:
//   "P5" magic (2 bytes)
//   whitespace + optional '# comment' line(s)
//   <width> <height> <maxval>     -- whitespace-separated ASCII ints
//   ONE whitespace byte (typically '\n')
//   <width * height> raw 8-bit grayscale bytes
//
// The header MUST end with exactly one whitespace byte before the pixel
// payload -- per the netpbm spec. The parser tolerates the common
// `convert` output shape (LF after maxval, then raw bytes).

fn pgm_parse_bytes(bytes_ptr, total_len) {
    if total_len < 8 {
        return _pgm_fail("pgm: buffer too short")
    }
    let b0 = load8(bytes_ptr + 0)
    let b1 = load8(bytes_ptr + 1)
    if b0 != PGM_MAGIC_P {
        return _pgm_fail("pgm: not a PGM (bad magic byte 0)")
    }
    if b1 != PGM_MAGIC_5 {
        return _pgm_fail("pgm: not a P5 binary PGM (only 'P5' is supported)")
    }
    let off = 2
    off = _pgm_skip_ws(bytes_ptr, total_len, off)
    let w_tok = _pgm_parse_int(bytes_ptr, total_len, off)
    if w_tok[2] == 0 { return _pgm_fail("pgm: missing width") }
    let width = w_tok[0]
    off = w_tok[1]
    off = _pgm_skip_ws(bytes_ptr, total_len, off)
    let h_tok = _pgm_parse_int(bytes_ptr, total_len, off)
    if h_tok[2] == 0 { return _pgm_fail("pgm: missing height") }
    let height = h_tok[0]
    off = h_tok[1]
    off = _pgm_skip_ws(bytes_ptr, total_len, off)
    let m_tok = _pgm_parse_int(bytes_ptr, total_len, off)
    if m_tok[2] == 0 { return _pgm_fail("pgm: missing maxval") }
    let maxval = m_tok[0]
    off = m_tok[1]
    // Validate dimensions + maxval BEFORE multiplying width*height.
    // The dimension cap is per-axis so the product stays safely under
    // NOVA's codegen pointer-threshold (gotcha #11).
    if width <= 0   { return _pgm_fail("pgm: width must be > 0") }
    if height <= 0  { return _pgm_fail("pgm: height must be > 0") }
    if width > PGM_MAX_DIM {
        return _pgm_fail("pgm: width exceeds 1024 (downsample first)")
    }
    if height > PGM_MAX_DIM {
        return _pgm_fail("pgm: height exceeds 1024 (downsample first)")
    }
    if maxval < 1                { return _pgm_fail("pgm: maxval must be >= 1") }
    if maxval > PGM_MAX_MAXVAL   { return _pgm_fail("pgm: maxval > 255 (16-bit PGM is deferred)") }

    // After maxval the netpbm spec requires EXACTLY one whitespace byte
    // before pixel data. Consume it. Tolerate multiple whitespace bytes
    // (some encoders write CRLF); the spec is permissive in practice.
    let after_max = off
    if after_max >= total_len {
        return _pgm_fail("pgm: truncated after maxval (no whitespace before data)")
    }
    let sep_c = load8(bytes_ptr + after_max)
    if _pgm_is_space(sep_c) == 0 {
        return _pgm_fail("pgm: missing whitespace separator before pixel data")
    }
    let data_off = after_max + 1
    // Skip any additional whitespace (e.g. \r\n separator); we already
    // consumed one above so this only matters for the unusual CRLF case.
    // A pixel byte of value 0..8 is NOT considered whitespace -- only
    // SP/TAB/LF/CR are. Once we hit a non-whitespace byte (which is the
    // first pixel) we stop.
    let stop = 0
    while stop == 0 {
        if data_off >= total_len { stop = 1 }
        if stop == 0 {
            let c = load8(bytes_ptr + data_off)
            if _pgm_is_space(c) == 1 { data_off = data_off + 1 }
            else { stop = 1 }
        }
    }

    // Pixel area. We compute width * height in a guarded way -- since
    // both are <= 1024 and we already validated, the product is <=
    // 2^20 == PGM_MAX_PIXEL_AREA, safely under NOVA's in-function
    // pointer-threshold.
    let area = width * height
    if area > PGM_MAX_PIXEL_AREA {
        return _pgm_fail("pgm: pixel area exceeds 1024*1024 cap")
    }
    if data_off + area > total_len {
        return _pgm_fail("pgm: pixel data truncated (header says more pixels than buffer holds)")
    }
    // Copy the pixel bytes into a fresh, deterministically-sized
    // buffer. We could also return a pointer into the source buffer,
    // but a copy is safer: callers can free the source without
    // invalidating the parsed image, and the buffer is small enough
    // to copy in one loop.
    let dst = alloc(area + 1)
    let i = 0
    while i < area {
        store8(dst + i, load8(bytes_ptr + data_off + i))
        i = i + 1
    }
    store8(dst + area, 0)   // sentinel NUL so accidental string ops
                            // see a terminator (the byte itself is a
                            // valid grayscale value 0 so don't read it).
    return _pgm_result(width, height, maxval, dst, "")
}

// ---- file-path entry point -----------------------------------------------
//
// Reads the file at `path` directly via sys_open + sys_read so the
// implementation never goes through NOVA's `read_file` builtin (which
// is NUL-terminated but reports up to 524288 bytes via its private
// allocator -- fine for text but `len()` would stop at the first
// embedded NUL, and binary pixel data contains plenty of zero bytes).
// Returns the same 5-tuple as pgm_parse_bytes.

fn pgm_parse_file(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 {
        return _pgm_fail("pgm: cannot open file")
    }
    let buf = alloc(PGM_MAX_FILE_BYTES + 1)
    let total = 0
    let keep = 1
    let chunk = 4096
    while keep == 1 {
        let space_left = PGM_MAX_FILE_BYTES - total
        let want = chunk
        if want > space_left { want = space_left }
        if want <= 0 { keep = 0 }
        if keep == 1 {
            let n = sys_read(fd, buf + total, want)
            if n <= 0 {
                keep = 0
            } else {
                total = total + n
                if total >= PGM_MAX_FILE_BYTES { keep = 0 }
            }
        }
    }
    sys_close(fd)
    if total <= 0 {
        return _pgm_fail("pgm: empty file")
    }
    return pgm_parse_bytes(buf, total)
}

// ---- pixel accessor -------------------------------------------------------

// pgm_pixel(data, width, x, y) -> grayscale value (0..255). No bounds
// checking by design -- callers can trust width/height returned from
// the parser. Negative or out-of-range coords are caller error.
fn pgm_pixel(data_ptr, width, x, y) {
    return load8(data_ptr + y * width + x)
}

// ---- histogram ------------------------------------------------------------

// pgm_histogram(data, w, h) -> list of 256 ints, each entry counts the
// number of pixels at that intensity. The list is freshly allocated.
// O(w*h) over the pixel area; uses no multiplies in the hot loop.
fn pgm_histogram(data_ptr, width, height) {
    let hist = list_new()
    let i = 0
    while i < PGM_HIST_BINS {
        push(hist, 0)
        i = i + 1
    }
    let area = width * height
    if area > PGM_MAX_PIXEL_AREA { area = PGM_MAX_PIXEL_AREA }
    let p = 0
    while p < area {
        let v = load8(data_ptr + p)
        list_set(hist, v, hist[v] + 1)
        p = p + 1
    }
    return hist
}

// pgm_mean_intensity(data, w, h) -> int (0..255)
// Plain integer mean of all pixel values. Uses a 64-bit-safe accumulator
// (well, single int in NOVA -- the largest realistic sum is
// 1048576 * 255 == 267386880, comfortably under 2^31).
fn pgm_mean_intensity(data_ptr, width, height) {
    let area = width * height
    if area > PGM_MAX_PIXEL_AREA { area = PGM_MAX_PIXEL_AREA }
    if area <= 0 { return 0 }
    let sum = 0
    let p = 0
    while p < area {
        sum = sum + load8(data_ptr + p)
        p = p + 1
    }
    return sum / area
}

// ---- dominant-intensity bucket -------------------------------------------
//
// Bucketize the pixel histogram into PGM_BUCKET_COUNT (8) bins and return
// the index (0..7) of the bin with the most pixels. The intuition: a
// crude scene descriptor the substrate can perceive as a single atom
// without having to reason about each pixel.
//   bucket 0: 0..31    (very dark)
//   bucket 1: 32..63
//   ...
//   bucket 7: 224..255 (very bright)

fn pgm_dominant_intensity(data_ptr, width, height) {
    let buckets = list_new()
    let i = 0
    while i < PGM_BUCKET_COUNT {
        push(buckets, 0)
        i = i + 1
    }
    let area = width * height
    if area > PGM_MAX_PIXEL_AREA { area = PGM_MAX_PIXEL_AREA }
    let p = 0
    while p < area {
        let v = load8(data_ptr + p)
        let b = v / 32                  // 8 bins of 32 levels each
        if b > 7 { b = 7 }              // defensive clamp on 255
        list_set(buckets, b, buckets[b] + 1)
        p = p + 1
    }
    let best = 0
    let best_n = buckets[0]
    let k = 1
    while k < PGM_BUCKET_COUNT {
        if buckets[k] > best_n {
            best_n = buckets[k]
            best = k
        }
        k = k + 1
    }
    return best
}

// ---- histogram entropy ---------------------------------------------------
//
// Shannon entropy of the 256-bin histogram, returned in milli-bits (i.e.
// the true entropy multiplied by 1000). Range: 0 (single value, perfectly
// peaked) to ~8000 milli-bits (8.0 bits, uniform over 256 levels).
//
// We approximate log2 via a small integer table over the probability
// fraction (counts / total). No floating point. The shape is:
//   entropy_milli = sum_over_bins(p * (8 - log2_approx(p)))
//                 = sum(count * log2(total/count))
// Computed in milli-units by keeping the multiplication ordering safe
// for NOVA's pointer-threshold gotcha (#11).

fn _pgm_log2_milli(x) {
    // log2(x) in milli-units for x >= 1. Linear approximation between
    // exact powers of two. Good enough for "is this distribution
    // peaked or uniform?" -- not for quantitative entropy claims.
    if x <= 1 { return 0 }
    if x >= 1048576 { return 20000 }   // log2(2^20) == 20
    let v = x
    let p = 0
    while v >= 2 {
        v = v / 2
        p = p + 1
    }
    // After the loop: 2^p <= x < 2^(p+1). p is the integer log2.
    // Return p in milli with no fractional refinement -- accuracy is
    // not load-bearing for the "peaked vs uniform" gate downstream.
    return p * 1000
}

fn pgm_histogram_entropy_milli(hist) {
    let total = 0
    let n = len(hist)
    let i = 0
    while i < n {
        total = total + hist[i]
        i = i + 1
    }
    if total <= 0 { return 0 }
    // sum(count * log2(total/count)) / total, then * 1000.
    // We compute the sum in scaled milli-units directly so the final
    // divide is by `total` only.
    let sum_milli = 0
    let log_total = _pgm_log2_milli(total)
    let j = 0
    while j < n {
        let c = hist[j]
        if c > 0 {
            let log_c = _pgm_log2_milli(c)
            sum_milli = sum_milli + c * (log_total - log_c) / 1000
        }
        j = j + 1
    }
    // Convert to milli-bits per pixel.
    let entropy_milli = sum_milli * 1000 / total
    if entropy_milli < 0 { entropy_milli = 0 }
    if entropy_milli > 8000 { entropy_milli = 8000 }
    return entropy_milli
}

// ---- nearest-neighbor resize ---------------------------------------------
//
// pgm_resize_nn(src_data, src_w, src_h, dst_w, dst_h) -> new pixel buffer
// (caller frees it). Pure integer math; for each destination pixel (x, y)
// pull the nearest source pixel via (x * src_w / dst_w, y * src_h / dst_h).
// No interpolation -- nearest neighbour is the worst-quality resize but
// the simplest and the only one whose output is bit-deterministic across
// platforms. The dst dimensions still obey PGM_MAX_DIM so we never
// allocate beyond 1 MiB.

fn pgm_resize_nn(src_data, src_w, src_h, dst_w, dst_h) {
    if dst_w <= 0 { return 0 }
    if dst_h <= 0 { return 0 }
    if dst_w > PGM_MAX_DIM { dst_w = PGM_MAX_DIM }
    if dst_h > PGM_MAX_DIM { dst_h = PGM_MAX_DIM }
    let area = dst_w * dst_h
    if area > PGM_MAX_PIXEL_AREA { return 0 }
    let dst = alloc(area + 1)
    let y = 0
    while y < dst_h {
        let sy = y * src_h / dst_h
        if sy >= src_h { sy = src_h - 1 }
        let x = 0
        while x < dst_w {
            let sx = x * src_w / dst_w
            if sx >= src_w { sx = src_w - 1 }
            let v = load8(src_data + sy * src_w + sx)
            store8(dst + y * dst_w + x, v)
            x = x + 1
        }
        y = y + 1
    }
    store8(dst + area, 0)
    return dst
}

// ---- result-tuple accessors (mirror stt_result_*) ------------------------

fn pgm_result_width(r)   { return r[PGM_R_WIDTH] }
fn pgm_result_height(r)  { return r[PGM_R_HEIGHT] }
fn pgm_result_maxval(r)  { return r[PGM_R_MAXVAL] }
fn pgm_result_data(r)    { return r[PGM_R_DATA] }
fn pgm_result_error(r)   { return r[PGM_R_ERROR] }
fn pgm_result_ok(r) {
    if len(r[PGM_R_ERROR]) > 0 { return 0 }
    if r[PGM_R_WIDTH] <= 0 { return 0 }
    return 1
}
