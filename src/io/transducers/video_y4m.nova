// CrossEngin io/transducers: Y4M (YUV4MPEG2 raw video) decoder (P3.2).
//
// Purpose
//   The video half of the modality bridge that text (P15), audio
//   (P19 TTS / P2.6 / P2.5 STT framework), and images (P3.1 PGM)
//   already cover. Real video codecs -- H.264, H.265, AV1, VP9 -- are
//   each MONTHS of pure-NOVA effort: H.264 alone is ~10K lines (CABAC
//   entropy coding + 4x4/8x8 integer DCT + intra-prediction + inter-
//   prediction + deblocking). Y4M is the natural minimum-viable plank,
//   exactly the way PGM was for P3.1: an ASCII header followed by a
//   sequence of raw uncompressed YCbCr frames. No compression, no inter-
//   frame coding, no entropy decoder. The whole parser fits in ~200
//   lines including statistics. A working Y4M decoder PROVES the
//   framework (`video_perception.nova` seam + chat `/play` admin command
//   + per-frame feature extraction + scene-change detection); pure-NOVA
//   H.264 is the long road `VIDEO_AUDIT.md` lays out.
//
//   Y4M is a common test-fixture format: `ffmpeg -i in.mp4 -pix_fmt
//   yuv420p -f yuv4mpegpipe -` writes it directly to stdout, and
//   `scripts/video_to_y4m.sh` wraps that for the operator who has any
//   compressed video on disk. Today we cap at 4:2:0 chroma subsampling
//   (the overwhelmingly common case `ffmpeg` produces); other chroma
//   layouts are a deferred follow-up.
//
// Format
//   Header (single line, terminated by LF):
//     YUV4MPEG2 W<width> H<height> F<fps_num>:<fps_den> [Ip] [A<num>:<den>]
//                                                       [C420] [XYSCSS=420JPEG]
//   Then for each frame:
//     FRAME[ optional-params]\n
//     <width*height>            Y plane bytes (luma)
//     <(width/2)*(height/2)>    Cb plane bytes (chroma blue)
//     <(width/2)*(height/2)>    Cr plane bytes (chroma red)
//
//   The decoder reads the file ONCE into a single byte buffer (via
//   `sys_open` + `sys_read` -- the same NUL-safe pattern image_pgm.nova
//   uses) and exposes a per-frame iterator (`y4m_next_frame`) that
//   returns pointers into that buffer; the buffer outlives the
//   iterator, so callers can hold onto frames without copying.
//
// Public API
//   y4m_open(path) -> y4m_state          # opens + parses header (or sets err)
//   y4m_dimensions(state) -> [w, h, fps_num, fps_den]
//   y4m_next_frame(state) -> [y_ptr, cb_ptr, cr_ptr, frame_index, error_msg]
//                                        # error_msg empty on success;
//                                        # "y4m: end of stream" at EOF
//   y4m_close(state)                     # releases buffer + clears fd
//   y4m_frame_to_pgm(y_ptr, w, h)        # ALIAS for y_ptr -- the Y plane IS
//                                        # a PGM image, so we just return
//                                        # the same pointer (no copy)
//   y4m_state_error(state) -> string     # header / open error if any
//   y4m_state_frame_count(state) -> int  # frames yielded so far
//   y4m_state_ok(state) -> int           # 1 iff header parsed cleanly
//   y4m_state_width(state)  / _height / _fps_num / _fps_den
//
// Pixel-count cap: per-frame Y plane size = width * height. NOVA's
// codegen pointer-threshold gotcha (gotcha #11 / NOVA enhancement #6+)
// misroutes any in-function multiply whose product exceeds ~2^20 into
// `str_repeat`. We cap dimensions at 768 x 432 in practice (Y4M_MAX_W /
// Y4M_MAX_H) so width * height <= 331776 stays well under the threshold
// even with the chroma planes added on. Real callers expected to
// downsample first via `ffmpeg -vf scale=-1:432`.
//
// ADRs implemented: ADR-0014 (modality bridge, no cognition path);
//   ADR-0036 (atom hygiene -- feature extraction lives in
//   video_perception.nova, not here).
// NOVA dependencies: builtins -- alloc, store8, load8, list_new, push,
//   len, char_at, str_eq, int_to_str, sys_open, sys_read, sys_close.
// CrossEngin dependencies: image_pgm.nova (the Y plane IS a PGM image;
//   piggybacks on PGM_MAX_DIM so the same threshold applies).

import "std/syscall"
import "image_pgm.nova"

// ---- format constants -----------------------------------------------------

// Magic header prefix: "YUV4MPEG2". 9 bytes.
let Y4M_MAGIC_LEN = 9

// Hard caps on dimensions. width <= 768 / height <= 432 means
// width * height <= 331776 well under NOVA's empirical 2^20 ceiling.
// Total per-frame bytes for 4:2:0 = w*h + 2*(w/2)*(h/2) = w*h * 3/2 <=
// 497664, also comfortably under the threshold.
let Y4M_MAX_W = 768
let Y4M_MAX_H = 432

// Max file bytes we'll buffer in one shot. A single 5-frame 480p y4m
// is ~1.5 MB at most; the cap accommodates ~30 frames at 768x432
// (30 * 497664 + small headers ~= 15 MB).
let Y4M_MAX_FILE_BYTES = 16777216   // 16 MiB

// State tuple slot indices.
let Y4M_S_BUF         = 0
let Y4M_S_TOTAL       = 1
let Y4M_S_OFFSET      = 2
let Y4M_S_WIDTH       = 3
let Y4M_S_HEIGHT      = 4
let Y4M_S_FPS_NUM     = 5
let Y4M_S_FPS_DEN     = 6
let Y4M_S_FRAME_COUNT = 7
let Y4M_S_ERROR       = 8

// Frame tuple slot indices.
let Y4M_F_Y           = 0
let Y4M_F_CB          = 1
let Y4M_F_CR          = 2
let Y4M_F_INDEX       = 3
let Y4M_F_ERROR       = 4

// ---- whitespace helpers --------------------------------------------------

fn _y4m_is_space(c) {
    if c == 32 { return 1 }    // ' '
    if c == 10 { return 1 }    // '\n'
    if c == 13 { return 1 }    // '\r'
    if c == 9  { return 1 }    // '\t'
    return 0
}

// Parse a base-10 integer starting at byte `off`. Returns [value, new_off, ok].
// Stops at the first non-digit byte. Empty token -> ok=0.
fn _y4m_parse_int(buf, total, off) {
    let i = off
    let v = 0
    let count = 0
    let keep = 1
    while keep == 1 {
        if i >= total { keep = 0 }
        if keep == 1 {
            let c = load8(buf + i)
            if c >= 48 {
                if c <= 57 {
                    v = v * 10 + (c - 48)
                    count = count + 1
                    i = i + 1
                } else {
                    keep = 0
                }
            } else {
                keep = 0
            }
        }
    }
    let r = list_new()
    push(r, v)
    push(r, i)
    if count > 0 { push(r, 1) } else { push(r, 0) }
    return r
}

// Advance `off` past spaces / tabs (NOT LF -- the header is a single line
// terminated by LF, and we want to stop at it). Returns new offset.
fn _y4m_skip_inline_ws(buf, total, off) {
    let i = off
    let keep = 1
    while keep == 1 {
        if i >= total { keep = 0 }
        if keep == 1 {
            let c = load8(buf + i)
            if c == 32 { i = i + 1 }
            else {
                if c == 9 { i = i + 1 }
                else { keep = 0 }
            }
        }
    }
    return i
}

// Advance `off` to byte AFTER the next LF. Returns new offset (or total
// if no LF found). Used to skip per-frame "FRAME params\n" parameter
// strings whose contents we don't need to interpret.
fn _y4m_skip_to_eol(buf, total, off) {
    let i = off
    let keep = 1
    while keep == 1 {
        if i >= total { keep = 0 }
        if keep == 1 {
            let c = load8(buf + i)
            i = i + 1
            if c == 10 { keep = 0 }
        }
    }
    return i
}

// ---- state constructors --------------------------------------------------

fn _y4m_new_state() {
    let s = list_new()
    push(s, 0)        // [0] BUF
    push(s, 0)        // [1] TOTAL
    push(s, 0)        // [2] OFFSET
    push(s, 0)        // [3] WIDTH
    push(s, 0)        // [4] HEIGHT
    push(s, 0)        // [5] FPS_NUM
    push(s, 0)        // [6] FPS_DEN
    push(s, 0)        // [7] FRAME_COUNT
    push(s, "")       // [8] ERROR
    return s
}

fn _y4m_state_fail(s, msg) {
    list_set(s, Y4M_S_ERROR, msg)
    return s
}

// ---- frame tuple helpers -------------------------------------------------

fn _y4m_frame(y, cb, cr, idx, err) {
    let f = list_new()
    push(f, y)
    push(f, cb)
    push(f, cr)
    push(f, idx)
    push(f, err)
    return f
}

// ---- header parsing -------------------------------------------------------

// Parse the YUV4MPEG2 header starting at offset 0. On success, advances
// state OFFSET to the first byte of the first FRAME line and fills
// WIDTH, HEIGHT, FPS_NUM, FPS_DEN. On failure, sets ERROR and leaves
// OFFSET unchanged.
//
// Header shape:
//   YUV4MPEG2 W640 H480 F30:1 Ip A1:1 C420 ... \n
// Tokens are space-separated; W / H / F are required; everything else
// is optional and ignored today. We stop scanning at LF.
fn _y4m_parse_header(s) {
    let buf = s[Y4M_S_BUF]
    let total = s[Y4M_S_TOTAL]
    if total < Y4M_MAGIC_LEN {
        return _y4m_state_fail(s, "y4m: buffer too short for header")
    }
    // Check magic "YUV4MPEG2".
    let magic_str = "YUV4MPEG2"
    let i = 0
    while i < Y4M_MAGIC_LEN {
        if load8(buf + i) != char_at(magic_str, i) {
            return _y4m_state_fail(s, "y4m: bad magic (not YUV4MPEG2)")
        }
        i = i + 1
    }
    let off = Y4M_MAGIC_LEN
    let width = 0
    let height = 0
    let fps_num = 0
    let fps_den = 0
    // Walk the rest of the header line, token by token, until LF.
    let keep = 1
    while keep == 1 {
        if off >= total { keep = 0 }
        if keep == 1 {
            let c = load8(buf + off)
            if c == 10 {
                // End of header line. Consume the LF and stop.
                off = off + 1
                keep = 0
            } else {
                if c == 32 {
                    off = off + 1
                } else {
                    if c == 9 {
                        off = off + 1
                    } else {
                        // Token start: tag byte. W/H/F drive parsing;
                        // everything else (Ip, A, C, X, etc) is skipped
                        // by advancing to the next whitespace or LF.
                        let tag = c
                        off = off + 1
                        if tag == 87 {
                            // 'W' -- width follows
                            let t = _y4m_parse_int(buf, total, off)
                            if t[2] == 0 {
                                return _y4m_state_fail(s, "y4m: missing width after W")
                            }
                            width = t[0]
                            off = t[1]
                        } else {
                            if tag == 72 {
                                // 'H' -- height follows
                                let t = _y4m_parse_int(buf, total, off)
                                if t[2] == 0 {
                                    return _y4m_state_fail(s, "y4m: missing height after H")
                                }
                                height = t[0]
                                off = t[1]
                            } else {
                                if tag == 70 {
                                    // 'F' -- fps_num:fps_den follows
                                    let tn = _y4m_parse_int(buf, total, off)
                                    if tn[2] == 0 {
                                        return _y4m_state_fail(s, "y4m: missing fps numerator after F")
                                    }
                                    fps_num = tn[0]
                                    off = tn[1]
                                    if off < total {
                                        if load8(buf + off) == 58 {
                                            // ':' separator
                                            off = off + 1
                                            let td = _y4m_parse_int(buf, total, off)
                                            if td[2] == 0 {
                                                return _y4m_state_fail(s, "y4m: missing fps denominator after F<n>:")
                                            }
                                            fps_den = td[0]
                                            off = td[1]
                                        }
                                    }
                                } else {
                                    // Unknown / ignored tag: skip token.
                                    let go = 1
                                    while go == 1 {
                                        if off >= total { go = 0 }
                                        if go == 1 {
                                            let cc = load8(buf + off)
                                            if cc == 32 { go = 0 }
                                            else {
                                                if cc == 9 { go = 0 }
                                                else {
                                                    if cc == 10 { go = 0 }
                                                    else { off = off + 1 }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Validate.
    if width <= 0 {
        return _y4m_state_fail(s, "y4m: missing W (width)")
    }
    if height <= 0 {
        return _y4m_state_fail(s, "y4m: missing H (height)")
    }
    if width > Y4M_MAX_W {
        return _y4m_state_fail(s, "y4m: width exceeds 768 (downsample first)")
    }
    if height > Y4M_MAX_H {
        return _y4m_state_fail(s, "y4m: height exceeds 432 (downsample first)")
    }
    if fps_num <= 0 { fps_num = 30 }
    if fps_den <= 0 { fps_den = 1 }
    list_set(s, Y4M_S_OFFSET,  off)
    list_set(s, Y4M_S_WIDTH,   width)
    list_set(s, Y4M_S_HEIGHT,  height)
    list_set(s, Y4M_S_FPS_NUM, fps_num)
    list_set(s, Y4M_S_FPS_DEN, fps_den)
    return s
}

// ---- public open / close -------------------------------------------------

// y4m_open(path) -> state. Reads the file into a buffer (NUL-safe via
// sys_read), parses the header, returns the state. On failure ERROR is
// non-empty and y4m_next_frame will return the same error.
fn y4m_open(path) {
    let s = _y4m_new_state()
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 {
        return _y4m_state_fail(s, "y4m: cannot open file")
    }
    let buf = alloc(Y4M_MAX_FILE_BYTES + 1)
    let total = 0
    let keep = 1
    let chunk = 16384
    while keep == 1 {
        let space_left = Y4M_MAX_FILE_BYTES - total
        let want = chunk
        if want > space_left { want = space_left }
        if want <= 0 { keep = 0 }
        if keep == 1 {
            let n = sys_read(fd, buf + total, want)
            if n <= 0 {
                keep = 0
            } else {
                total = total + n
                if total >= Y4M_MAX_FILE_BYTES { keep = 0 }
            }
        }
    }
    sys_close(fd)
    if total <= 0 {
        return _y4m_state_fail(s, "y4m: empty file")
    }
    list_set(s, Y4M_S_BUF,   buf)
    list_set(s, Y4M_S_TOTAL, total)
    return _y4m_parse_header(s)
}

// Open from an in-memory buffer (for unit tests).
fn y4m_open_bytes(buf, total) {
    let s = _y4m_new_state()
    if total <= 0 {
        return _y4m_state_fail(s, "y4m: empty buffer")
    }
    list_set(s, Y4M_S_BUF,   buf)
    list_set(s, Y4M_S_TOTAL, total)
    return _y4m_parse_header(s)
}

// y4m_close clears the state's fd/buffer slots so a subsequent call to
// y4m_next_frame returns "end of stream". The underlying allocation is
// reclaimed by NOVA's allocator at process end -- no explicit free in
// pure NOVA today.
fn y4m_close(s) {
    list_set(s, Y4M_S_BUF, 0)
    list_set(s, Y4M_S_TOTAL, 0)
    list_set(s, Y4M_S_OFFSET, 0)
    return 1
}

// ---- public accessors ----------------------------------------------------

fn y4m_state_width(s)       { return s[Y4M_S_WIDTH] }
fn y4m_state_height(s)      { return s[Y4M_S_HEIGHT] }
fn y4m_state_fps_num(s)     { return s[Y4M_S_FPS_NUM] }
fn y4m_state_fps_den(s)     { return s[Y4M_S_FPS_DEN] }
fn y4m_state_frame_count(s) { return s[Y4M_S_FRAME_COUNT] }
fn y4m_state_error(s)       { return s[Y4M_S_ERROR] }

fn y4m_state_ok(s) {
    if len(s[Y4M_S_ERROR]) > 0 { return 0 }
    if s[Y4M_S_WIDTH] <= 0 { return 0 }
    if s[Y4M_S_HEIGHT] <= 0 { return 0 }
    return 1
}

fn y4m_dimensions(s) {
    let d = list_new()
    push(d, s[Y4M_S_WIDTH])
    push(d, s[Y4M_S_HEIGHT])
    push(d, s[Y4M_S_FPS_NUM])
    push(d, s[Y4M_S_FPS_DEN])
    return d
}

// ---- frame iterator ------------------------------------------------------

// y4m_next_frame(state) -> [y_ptr, cb_ptr, cr_ptr, frame_index, error_msg]
//
// On success returns POINTERS INTO the open file buffer (no copy);
// caller must not free them. Cb / Cr planes are (w/2) * (h/2) bytes
// each. Frame index starts at 0 and increments with every successful
// call.
//
// On the first error the same error tuple is returned for every
// subsequent call (the state's OFFSET stops advancing).
fn y4m_next_frame(s) {
    if len(s[Y4M_S_ERROR]) > 0 {
        return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], s[Y4M_S_ERROR])
    }
    let buf = s[Y4M_S_BUF]
    let total = s[Y4M_S_TOTAL]
    let off = s[Y4M_S_OFFSET]
    let w = s[Y4M_S_WIDTH]
    let h = s[Y4M_S_HEIGHT]
    if off >= total {
        return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], "y4m: end of stream")
    }
    // Expect "FRAME" (or "FRAME ..." with per-frame params).
    if off + 5 > total {
        return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], "y4m: truncated before FRAME marker")
    }
    let frame_str = "FRAME"
    let i = 0
    while i < 5 {
        if load8(buf + off + i) != char_at(frame_str, i) {
            return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], "y4m: expected FRAME marker")
        }
        i = i + 1
    }
    off = off + 5
    // Skip optional params + terminator LF.
    off = _y4m_skip_to_eol(buf, total, off)
    // Y plane: w * h bytes. Per the cap above this product is
    // <= 768 * 432 == 331776 well under 2^20.
    let y_area = w * h
    if off + y_area > total {
        return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], "y4m: truncated Y plane")
    }
    let y_ptr = buf + off
    off = off + y_area
    // Chroma planes: 4:2:0 -- each is (w/2) * (h/2). NOTE odd
    // dimensions would round down, but we cap at known even values
    // in tests.
    let chroma_w = w / 2
    let chroma_h = h / 2
    let chroma_area = chroma_w * chroma_h
    if off + chroma_area > total {
        return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], "y4m: truncated Cb plane")
    }
    let cb_ptr = buf + off
    off = off + chroma_area
    if off + chroma_area > total {
        return _y4m_frame(0, 0, 0, s[Y4M_S_FRAME_COUNT], "y4m: truncated Cr plane")
    }
    let cr_ptr = buf + off
    off = off + chroma_area
    let idx = s[Y4M_S_FRAME_COUNT]
    list_set(s, Y4M_S_OFFSET, off)
    list_set(s, Y4M_S_FRAME_COUNT, idx + 1)
    return _y4m_frame(y_ptr, cb_ptr, cr_ptr, idx, "")
}

// ---- Y plane -> PGM bridge -----------------------------------------------
//
// The Y (luma) plane of a Y4M frame IS a PGM image (raw 8-bit
// grayscale, row-major, no compression). For the perception path we
// already have pgm_mean_intensity / pgm_histogram / pgm_dominant_intensity
// / pgm_histogram_entropy_milli -- we expose `y4m_frame_to_pgm` as the
// trivial identity wrapper so the seam can clearly call out "this is the
// PGM-shaped accessor for a Y4M frame", without paying for a redundant
// copy.
fn y4m_frame_to_pgm(y_ptr, width, height) {
    return y_ptr
}

// ---- frame accessors (mirror shape of pgm_result_*) ----------------------

fn y4m_frame_y(f)      { return f[Y4M_F_Y] }
fn y4m_frame_cb(f)     { return f[Y4M_F_CB] }
fn y4m_frame_cr(f)     { return f[Y4M_F_CR] }
fn y4m_frame_index(f)  { return f[Y4M_F_INDEX] }
fn y4m_frame_error(f)  { return f[Y4M_F_ERROR] }
fn y4m_frame_ok(f) {
    if len(f[Y4M_F_ERROR]) > 0 { return 0 }
    if f[Y4M_F_Y] == 0 { return 0 }
    return 1
}

// ---- mean pixel difference (motion proxy) --------------------------------
//
// y4m_mean_abs_diff(prev_ptr, cur_ptr, width, height) -> int (0..255).
// Mean of |prev[i] - cur[i]| across the Y plane only. Chroma is ignored:
// motion is overwhelmingly visible in luma, and the chroma planes are
// only quarter-resolution so they'd skew the mean. Used by
// video_perception.nova to assign `motion_low / mid / high` and
// `scene_change` atoms.
//
// Computed with small intermediates (the sum cannot overflow even at
// the cap: 768 * 432 * 255 = 84_602_880 < 2^27, well within NOVA's
// int range).
fn y4m_mean_abs_diff(prev_ptr, cur_ptr, width, height) {
    if prev_ptr == 0 { return 0 }
    if cur_ptr == 0 { return 0 }
    let area = width * height
    if area <= 0 { return 0 }
    let sum = 0
    let p = 0
    while p < area {
        let a = load8(prev_ptr + p)
        let b = load8(cur_ptr + p)
        let d = a - b
        if d < 0 { d = 0 - d }
        sum = sum + d
        p = p + 1
    }
    return sum / area
}
