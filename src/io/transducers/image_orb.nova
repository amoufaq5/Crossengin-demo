// CrossEngin io/transducers: ORB (Oriented FAST + Rotated BRIEF) feature
// detector + Hamming-distance matcher (P3.3 cont. v3 -- patent-free
// SIFT alternative).
//
// Purpose
//   SIFT (image_sift.nova, P3.3 cont. v1/v2) is the canonical detector +
//   descriptor pair but it is (a) ENCUMBERED by US Patent 6,711,293 in
//   some jurisdictions through 2020 and was historically license-gated,
//   and (b) SLOW -- it pays 3 octaves of Gaussian pyramid + 5 blur
//   levels per octave for detection, then a 16x16 16-bin orientation
//   histogram + 4x4x8 gradient histogram per descriptor.
//
//   ORB (Rublee et al. 2011, "ORB: An efficient alternative to SIFT or
//   SURF", ICCV 2011) is the standard PATENT-FREE replacement and the
//   default detector in OpenCV's tracking pipelines. It pairs:
//     - Oriented FAST keypoint detection (Rosten 2006 + Rublee 2011's
//       intensity-centroid orientation): a 16-pixel Bresenham-circle
//       brightness test that flags a corner if 9+ contiguous pixels
//       around the circle are all brighter (or all darker) than the
//       center by a threshold t.
//     - Harris score for RANKING the FAST candidates (we REUSE the
//       existing `harris_apply` from R1.6 / image_harris.nova rather
//       than reimplementing the Harris response).
//     - Intensity-centroid orientation assignment (Rosin 1999):
//       compute first-order image moments m_10 and m_01 over a 31x31
//       patch around the keypoint, then theta = atan2(m_01, m_10).
//       Quantized to a 30-angle lookup table for the rBRIEF rotation.
//     - rBRIEF descriptor (Rublee 2011's "Rotated BRIEF"): the
//       Calonder 2010 BRIEF descriptor (256 binary tests on pixel-pair
//       intensities in a smoothed patch) with each test pair ROTATED
//       by the keypoint's orientation so the descriptor is
//       rotation-invariant. We use a deterministic LFSR-generated
//       point-pair set (seed 0x12345; documented below) instead of
//       Calonder's learned-greedy 256-bit selection so the descriptor
//       is reproducible without shipping a 256x4-int constant table.
//     - Hamming-distance matcher with Lowe's ratio test
//       (ratio = d_best / d_second_best < 0.75 = 750 milli).
//
//   The output is structurally parallel to SIFT's: a list of
//   keypoint records each carrying (x, y, angle_index, descriptor_bits),
//   plus a Lowe-ratio matcher. The descriptor is a 256-bit
//   = 32-byte binary blob stored as 8 ints (each holding a 32-bit chunk)
//   so the matcher's Hamming-distance loop is a popcount-of-XOR over
//   8 int32 chunks per pair -- much faster than SIFT's 128-int L2
//   distance.
//
// Algorithm in detail:
//
//   1. FAST-9 keypoint detection (Rosten 2006 + Rublee 2011, oriented
//      variant). For each pixel p with intensity I(p):
//      - Read 16 pixels around a Bresenham circle of radius 3 centered
//        on p. The offsets (dx, dy) for the 16 points (starting at the
//        top and going clockwise) are:
//          ( 0,-3) ( 1,-3) ( 2,-2) ( 3,-1)
//          ( 3, 0) ( 3, 1) ( 2, 2) ( 1, 3)
//          ( 0, 3) (-1, 3) (-2, 2) (-3, 1)
//          (-3, 0) (-3,-1) (-2,-2) (-1,-3)
//      - p is a corner iff there are 9 or more CONTIGUOUS pixels around
//        the circle (wrapping at index 15 -> 0) all brighter than
//        I(p) + t, OR all darker than I(p) - t. With t=20 on the
//        0..255 scale.
//
//   2. Harris score for ranking. We run harris_apply on the same image
//      (reusing the R1.6 module verbatim) and, for each FAST candidate,
//      compute a proxy Harris score by checking for a Harris corner
//      within ORB_HARRIS_RADIUS pixels (a coarser version of Lowe's
//      edge-response test; same pattern image_sift.nova uses for
//      DoG-extrema edge rejection). Candidates with no nearby Harris
//      corner are dropped. The kept candidates are sorted by FAST
//      response score (sum of |I(circle_i) - I(p)| over the contiguous
//      run, a cheap proxy for Harris response that is monotone with
//      corner strength). Top-K kept (default K = ORB_MAX_KEYPOINTS = 200).
//
//   3. Orientation by intensity centroid. For each kept keypoint
//      at (cx, cy), walk a 31x31 patch centered on (cx, cy) (radius 15)
//      bounded by the image edges. Compute:
//          m_10 = sum_{(x,y) in patch} (x - cx) * I(x, y)
//          m_01 = sum_{(x,y) in patch} (y - cy) * I(x, y)
//      Angle theta = atan2(m_01, m_10) quantized into one of
//      ORB_ANGLE_BINS = 30 buckets (12 degrees each). The bucket index
//      keys into a small precomputed cos/sin table for the
//      descriptor's point-pair rotation.
//
//   4. rBRIEF descriptor. 256-bit binary descriptor. 256 fixed
//      (x_i, y_i, x_j, y_j) point pairs lie in a 31x31 patch centered
//      on the keypoint (each coordinate in -15..+15). They are
//      generated by a deterministic 16-bit LFSR (Galois form, taps at
//      positions 16, 14, 13, 11; polynomial x^16 + x^14 + x^13 + x^11 + 1,
//      seed = 0x12345 -- documented in `_orb_lfsr_seed_step` below;
//      `0x12345` is the same seed_pack seed CrossEngin uses elsewhere).
//      For each of the 256 pairs, rotate by the keypoint's angle
//      (via the precomputed cos/sin table) and sample I at the two
//      rotated points (boundary-clipped to the image). Bit_i = 1 iff
//      I(rotated_p_i) < I(rotated_p_j), else 0.
//
//   5. Hamming-distance matcher with Lowe's ratio test. For two 256-bit
//      descriptors stored as 8 int32 chunks each:
//          d_hamming = sum_{k=0..7} popcount(desc_a[k] ^ desc_b[k])
//      Each chunk's popcount is a 32-bit byte-Hamming-weight table
//      lookup (precomputed as ORB_POPCOUNT_TABLE; 256-entry static int
//      array). For each query keypoint in A, find the best and
//      second-best matches in B by Hamming distance. Accept iff
//      d_best / d_second_best < 0.75 (750 milli; default ratio threshold
//      ORB_DEFAULT_RATIO_MILLI).
//
// Public API
//   orb_detect(data_ptr, width, height, max_keypoints)
//       -> [keypoints, descriptors] where:
//          keypoints = list of [x, y, angle_index, fast_score]
//          descriptors = parallel list of 8-int chunks (32 bytes / 256 bits)
//   orb_match(kps_a, descs_a, kps_b, descs_b, ratio_milli)
//       -> list of [idx_a, idx_b, hamming_distance] triples (Lowe ratio test)
//   orb_hamming_distance(desc_a, desc_b) -> int (popcount of XOR)
//   orb_result_keypoints(r) / orb_result_descriptors(r) / orb_result_count(r)
//   orb_kp_x(kp) / orb_kp_y(kp) / orb_kp_angle(kp) / orb_kp_score(kp)
//   orb_kps_count_label(n) -> "image_orb_kps_<low|mid|high>"
//   orb_density_label(n, total_area) -> same buckets, density-style label
//
// Per-keypoint record slots (parallel to SIFT's, but 4 slots not 5):
//   ORB_KP_X     = 0
//   ORB_KP_Y     = 1
//   ORB_KP_ANGLE = 2  (bucket index 0..29; multiply by 12 for degrees)
//   ORB_KP_SCORE = 3  (FAST contiguous-run score; monotone with strength)
//
// Pixel-area cap: ORB_MAX_DIM = 256 per axis (same as SIFT). The 31x31
// patch + 256 descriptor pairs are small per-keypoint costs; the
// dominant work is the FAST scan (one circle-read per interior pixel).
//
// ADRs implemented: ADR-0014 (modality bridge, no cognition path).
// NOVA dependencies: builtins -- alloc, store8, load8, list_new, push,
//   list_set, len, int_mul, int_add, int_sub.
// CrossEngin dependencies: image_harris.nova (we reuse harris_apply for
//   the corner-proximity test); no other dependencies.

import "image_harris.nova"
import "image_pgm.nova"

// ---- format constants -----------------------------------------------------

// FAST-9 brightness threshold (t in the paper). Pixels around the
// Bresenham circle must differ by MORE than this from the center to
// count as bright / dark.
let ORB_FAST_THRESHOLD = 20

// Minimum contiguous-run length for a FAST corner. Rosten's FAST-9
// is N=9; the original FAST proposal used N=12 (slower, fewer
// keypoints). Rublee 2011 uses FAST-9 throughout.
let ORB_FAST_N = 9

// Circumference of the Bresenham circle of radius 3 (the FAST sample).
let ORB_FAST_CIRC = 16

// Maximum keypoints we return.
let ORB_HARD_MAX = 200

// Hard cap on input dimensions. Same as SIFT (256x256). Below 32x32 we
// cannot afford the 31x31 orientation patch.
let ORB_MAX_DIM = 256
let ORB_MAX_PIXEL_AREA = 65536      // 256 * 256
let ORB_MIN_DIM = 32

// Number of quantized angle bins (30 buckets of 12 degrees each).
let ORB_ANGLE_BINS = 30

// rBRIEF point-pair count = bits in descriptor = 256.
let ORB_DESC_BITS = 256
// 256 bits stored as 8 chunks of 32 bits each.
let ORB_DESC_CHUNKS = 8
let ORB_DESC_CHUNK_BITS = 32

// LFSR seed (Galois form, 16-bit). Documented in the file header. Any
// non-zero 16-bit seed gives the same 65535-period sequence; we use
// 0x12345 (& 0xFFFF) = 0x2345 so the seed_pack signature matches the
// rest of CrossEngin's deterministic seeds.
let ORB_LFSR_SEED = 9029         // 0x2345 (low 16 bits of 0x12345)

// rBRIEF patch radius (half of 31). Each LFSR-generated point pair
// has each coordinate clamped to [-ORB_PATCH_RADIUS, +ORB_PATCH_RADIUS].
let ORB_PATCH_RADIUS = 15

// Orientation patch radius (half of 31). Same patch size as rBRIEF's;
// we walk this for the intensity-centroid moments.
let ORB_ORIENT_RADIUS = 15

// Harris-corner-proximity rejection radius. A FAST candidate is kept
// only if it has a Harris corner within this Chebyshev distance.
// (Matches image_sift's SIFT_EDGE_REJECT_RADIUS in spirit.)
let ORB_HARRIS_RADIUS = 4

// Default Lowe ratio (0.75 = 750 milli). ORB's binary descriptor has
// integer Hamming distances so the ratio comparison is exact integer
// arithmetic; no fixed-point gymnastics.
let ORB_DEFAULT_RATIO_MILLI = 750

// Keypoint-count classification thresholds (parallel to Harris/SIFT
// buckets so the perception path can reuse the same logic shape).
let ORB_COUNT_LOW_MAX = 9
let ORB_COUNT_MID_MAX = 100

// Per-keypoint record slots.
let ORB_KP_X     = 0
let ORB_KP_Y     = 1
let ORB_KP_ANGLE = 2
let ORB_KP_SCORE = 3

// Result-tuple slots (orb_detect's return).
let ORB_R_KPS   = 0
let ORB_R_DESCS = 1

// ---- byte popcount helper -------------------------------------------------
//
// _orb_popcount8(b) returns the number of 1 bits in the low 8 bits of `b`.
// Kernighan's bit-twiddling: b = b - ((b >> 1) & 0x55); b = (b & 0x33) +
// ((b >> 2) & 0x33); b = (b + (b >> 4)) & 0x0F; return b.
// We unroll into a small int loop instead of using a 256-entry static
// list (NOVA list_set on a 256-element list during a hot popcount inner
// loop is slower than the 4 shifts here).

fn _orb_popcount8(b) {
    let v = b
    if v < 0 { v = 0 - v }
    // Strip down to low 8 bits.
    v = v % 256
    // Kernighan-style: shift+add. NOVA has no native shifts; we use
    // integer divides which are equivalent for unsigned values.
    let count = 0
    let i = 0
    while i < 8 {
        if v % 2 == 1 { count = int_add(count, 1) }
        v = v / 2
        i = int_add(i, 1)
    }
    return count
}

// _orb_popcount32(c) -- popcount over the low 32 bits of `c`. Composed of
// 4 byte-popcounts (low byte to high byte). Used by the Hamming-distance
// matcher.
fn _orb_popcount32(c) {
    let v = c
    if v < 0 { v = 0 - v }
    let total = 0
    let i = 0
    while i < 4 {
        let byte = v % 256
        total = int_add(total, _orb_popcount8(byte))
        v = v / 256
        i = int_add(i, 1)
    }
    return total
}

// ---- XOR helper -----------------------------------------------------------
//
// NOVA exposes int_add / int_sub / int_mul but no bitwise primitives. We
// synthesize XOR over the low 32 bits via byte-wise arithmetic:
// xor(a, b) = sum over 4 bytes of (a_i ^ b_i) << (8*i), where the
// per-byte XOR uses the identity a^b = (a|b) - (a&b) which in turn
// uses a^b == a+b-2*(a&b), and a&b is computed via bitwise AND
// implemented as 8 shifts of (a%2)*(b%2). Slow per call but the
// matcher's hot path is ~200 * 200 * 8 chunks = 320k XORs which
// is well within tolerable bounds for a per-call admin command.

fn _orb_and8(a, b) {
    let aa = a % 256
    let bb = b % 256
    if aa < 0 { aa = int_add(aa, 256) }
    if bb < 0 { bb = int_add(bb, 256) }
    let out = 0
    let bit = 1
    let i = 0
    while i < 8 {
        if aa % 2 == 1 {
            if bb % 2 == 1 {
                out = int_add(out, bit)
            }
        }
        aa = aa / 2
        bb = bb / 2
        bit = int_mul(bit, 2)
        i = int_add(i, 1)
    }
    return out
}

fn _orb_xor8(a, b) {
    let aa = a % 256
    let bb = b % 256
    if aa < 0 { aa = int_add(aa, 256) }
    if bb < 0 { bb = int_add(bb, 256) }
    let out = 0
    let bit = 1
    let i = 0
    while i < 8 {
        let abit = aa % 2
        let bbit = bb % 2
        if abit != bbit { out = int_add(out, bit) }
        aa = aa / 2
        bb = bb / 2
        bit = int_mul(bit, 2)
        i = int_add(i, 1)
    }
    return out
}

// _orb_xor32(a, b) -- XOR over the low 32 bits as 4 bytewise XORs.
fn _orb_xor32(a, b) {
    let aa = a
    let bb = b
    if aa < 0 { aa = 0 - aa }
    if bb < 0 { bb = 0 - bb }
    let out = 0
    let mult = 1
    let i = 0
    while i < 4 {
        let abyte = aa % 256
        let bbyte = bb % 256
        let xbyte = _orb_xor8(abyte, bbyte)
        out = int_add(out, int_mul(xbyte, mult))
        aa = aa / 256
        bb = bb / 256
        mult = int_mul(mult, 256)
        i = int_add(i, 1)
    }
    return out
}

// ---- Bresenham circle offsets ---------------------------------------------
//
// 16-point Bresenham circle of radius 3, clockwise from the top.
// Index 0 = top (0, -3), index 4 = right (3, 0), index 8 = bottom (0, 3),
// index 12 = left (-3, 0). The 16 points form a 4-fold-symmetric ring.

fn _orb_circle_dx(idx) {
    if idx == 0  { return  0 }
    if idx == 1  { return  1 }
    if idx == 2  { return  2 }
    if idx == 3  { return  3 }
    if idx == 4  { return  3 }
    if idx == 5  { return  3 }
    if idx == 6  { return  2 }
    if idx == 7  { return  1 }
    if idx == 8  { return  0 }
    if idx == 9  { return 0 - 1 }
    if idx == 10 { return 0 - 2 }
    if idx == 11 { return 0 - 3 }
    if idx == 12 { return 0 - 3 }
    if idx == 13 { return 0 - 3 }
    if idx == 14 { return 0 - 2 }
    return 0 - 1
}

fn _orb_circle_dy(idx) {
    if idx == 0  { return 0 - 3 }
    if idx == 1  { return 0 - 3 }
    if idx == 2  { return 0 - 2 }
    if idx == 3  { return 0 - 1 }
    if idx == 4  { return  0 }
    if idx == 5  { return  1 }
    if idx == 6  { return  2 }
    if idx == 7  { return  3 }
    if idx == 8  { return  3 }
    if idx == 9  { return  3 }
    if idx == 10 { return  2 }
    if idx == 11 { return  1 }
    if idx == 12 { return  0 }
    if idx == 13 { return 0 - 1 }
    if idx == 14 { return 0 - 2 }
    return 0 - 3
}

// ---- FAST-9 core detection -----------------------------------------------
//
// _orb_is_fast9_corner(data_ptr, w, h, x, y, t) -- returns the
// contiguous-run score (sum of |circle_i - center|) if (x, y) is a
// FAST-9 corner at threshold t, else 0.
//
// Algorithm:
//   1. Read center intensity Ip.
//   2. Read all 16 circle intensities.
//   3. Mark each as "bright" (> Ip + t), "dark" (< Ip - t), or "similar".
//   4. Look for a contiguous run of 9 or more brights, OR 9 or more
//      darks, wrapping at index 15 -> 0. Return the score = sum of
//      |Ic - Ip| over that run (a cheap proxy for corner strength).

fn _orb_is_fast9_corner(data_ptr, width, height, x, y, t) {
    // Boundary: the 16 circle points span 3 pixels on each side, so we
    // need (3 <= x < width - 3) and (3 <= y < height - 3). Caller is
    // expected to enforce this; we double-check defensively.
    if x < 3 { return 0 }
    if y < 3 { return 0 }
    if x >= int_sub(width, 3)  { return 0 }
    if y >= int_sub(height, 3) { return 0 }

    let row_off = int_mul(y, width)
    let ip = load8(data_ptr + row_off + x)
    let ip_high = int_add(ip, t)
    let ip_low  = int_sub(ip, t)

    // Read 16 circle pixels into a list.
    let circ = list_new()
    let i = 0
    while i < ORB_FAST_CIRC {
        let cx = int_add(x, _orb_circle_dx(i))
        let cy = int_add(y, _orb_circle_dy(i))
        let crow = int_mul(cy, width)
        push(circ, load8(data_ptr + crow + cx))
        i = int_add(i, 1)
    }

    // Classify each pixel: 1 = bright, -1 = dark, 0 = similar.
    let cls = list_new()
    let k = 0
    while k < ORB_FAST_CIRC {
        let v = circ[k]
        let tag = 0
        if v > ip_high { tag = 1 }
        if v < ip_low  { tag = 0 - 1 }
        push(cls, tag)
        k = int_add(k, 1)
    }

    // Look for a contiguous run of 9+ matching tags. We scan a doubled
    // ring (i.e., considering indices 0..31 modulo 16) to handle the
    // wrap. Track the longest run of brights and darks; if either >= 9,
    // we have a corner.
    let best_run_bright = 0
    let best_run_dark   = 0
    let cur_bright = 0
    let cur_dark   = 0
    let m = 0
    let scan_max = int_mul(ORB_FAST_CIRC, 2)  // 32
    while m < scan_max {
        let idx = m % ORB_FAST_CIRC
        let tag = cls[idx]
        if tag == 1 {
            cur_bright = int_add(cur_bright, 1)
            cur_dark = 0
        } else {
            if tag < 0 {   // -1 sentinel; `< 0` avoids bug#11 (== against a negative)
                cur_dark = int_add(cur_dark, 1)
                cur_bright = 0
            } else {
                cur_bright = 0
                cur_dark = 0
            }
        }
        if cur_bright > best_run_bright { best_run_bright = cur_bright }
        if cur_dark   > best_run_dark   { best_run_dark   = cur_dark }
        m = int_add(m, 1)
    }

    if best_run_bright >= ORB_FAST_N {
        // Score: sum over circle of |circle_i - ip| (any classification).
        let score = 0
        let q = 0
        while q < ORB_FAST_CIRC {
            let d = int_sub(circ[q], ip)
            if d < 0 { d = 0 - d }
            score = int_add(score, d)
            q = int_add(q, 1)
        }
        return score
    }
    if best_run_dark >= ORB_FAST_N {
        let score = 0
        let q = 0
        while q < ORB_FAST_CIRC {
            let d = int_sub(circ[q], ip)
            if d < 0 { d = 0 - d }
            score = int_add(score, d)
            q = int_add(q, 1)
        }
        return score
    }
    return 0
}

// ---- LFSR-generated rBRIEF point pairs -----------------------------------
//
// 256 (x_i, y_i, x_j, y_j) point pairs in [-15..+15]^2 generated by a
// 16-bit Galois LFSR (polynomial x^16 + x^14 + x^13 + x^11 + 1, taps at
// positions 16, 14, 13, 11 -- the same maximal-length LFSR feedback poly
// the seed_pack uses elsewhere in CrossEngin). Seeded from ORB_LFSR_SEED
// = 0x2345 (low 16 bits of the documented file-header 0x12345).
//
// Period: 65535 (any non-zero state). Each pair consumes 4 LFSR steps
// (one per coordinate) + a clamp to [-15..15] via mod 31 - 15. Total
// 256 * 4 = 1024 steps, well within the period.
//
// Built once at first call and cached in _orb_brief_pairs_cache (a
// module-level slot).

let _orb_brief_pairs_cache = 0

// One step of the 16-bit Galois LFSR. Returns the next state.
// Polynomial: x^16 + x^14 + x^13 + x^11 + 1 -> feedback mask 0xB400
//   (bits 15, 13, 12, 10 in 0-indexed). On each step, shift right by 1;
// if the bit shifted OUT was 1, XOR with the mask.
fn _orb_lfsr_seed_step(state) {
    let bit_out = state % 2
    let next = state / 2
    if bit_out == 1 {
        // XOR with mask 0xB400 (= 46080 decimal).
        next = _orb_xor32(next, 46080)
    }
    return next
}

// Build the 256x4 list of point pairs deterministically. Returns a list
// of 256 4-int sublists [px_i, py_i, px_j, py_j] each in -15..+15.
fn _orb_build_brief_pairs() {
    if _orb_brief_pairs_cache != 0 {
        return _orb_brief_pairs_cache
    }
    let pairs = list_new()
    let state = ORB_LFSR_SEED
    let n = 0
    while n < ORB_DESC_BITS {
        // Generate 4 coordinates, each in [-15..+15]. We use 5 LFSR
        // steps per coordinate (so the 16-bit state has actually rolled)
        // and take state % 31 - 15.
        let coords = list_new()
        let c = 0
        while c < 4 {
            let step = 0
            while step < 5 {
                state = _orb_lfsr_seed_step(state)
                if state == 0 { state = ORB_LFSR_SEED }
                step = int_add(step, 1)
            }
            let raw = state % 31
            push(coords, int_sub(raw, 15))
            c = int_add(c, 1)
        }
        push(pairs, coords)
        n = int_add(n, 1)
    }
    _orb_brief_pairs_cache = pairs
    return pairs
}

// ---- 30-bin cos/sin rotation table ----------------------------------------
//
// For each angle bucket k in 0..29 (12 degrees per bucket), we
// precompute cos(k * 12 deg) and sin(k * 12 deg) in milli-units
// (1000 = cos(0)). The table is built once at first call.
//
// Values from the unit circle, rounded to nearest milli:
//   bucket 0: 0 deg -> cos = 1000, sin = 0
//   bucket 1: 12 deg -> cos = 978, sin = 208
//   bucket 2: 24 deg -> cos = 914, sin = 407
//   bucket 3: 36 deg -> cos = 809, sin = 588
//   bucket 4: 48 deg -> cos = 669, sin = 743
//   bucket 5: 60 deg -> cos = 500, sin = 866
//   bucket 6: 72 deg -> cos = 309, sin = 951
//   bucket 7: 84 deg -> cos = 105, sin = 995
//   bucket 8: 96 deg -> cos = -105, sin = 995
//   bucket 9: 108 deg -> cos = -309, sin = 951
//   ... etc; the rest follow from symmetry (sin / cos sign flips per quadrant).

let _orb_rot_cache = 0

fn _orb_build_rotation_table() {
    if _orb_rot_cache != 0 { return _orb_rot_cache }
    // Precomputed cos/sin pairs (milli-unit) for 30 buckets at 12-deg
    // intervals. Buckets 0..14 cover 0..168 degrees; we mirror to fill
    // 15..29 (180..348 degrees).
    //   For bucket k (k in 0..29), angle deg = k * 12.
    //   For k in [0..7]: first quadrant.
    //   For k in [8..14]: second quadrant (cos negative, sin positive).
    //   For k in [15..22]: third quadrant (both negative).
    //   For k in [23..29]: fourth quadrant (cos positive, sin negative).
    let cos_milli = list_new()
    let sin_milli = list_new()
    push(cos_milli, 1000) ; push(sin_milli, 0)         // 0 deg
    push(cos_milli, 978)  ; push(sin_milli, 208)       // 12 deg
    push(cos_milli, 914)  ; push(sin_milli, 407)       // 24 deg
    push(cos_milli, 809)  ; push(sin_milli, 588)       // 36 deg
    push(cos_milli, 669)  ; push(sin_milli, 743)       // 48 deg
    push(cos_milli, 500)  ; push(sin_milli, 866)       // 60 deg
    push(cos_milli, 309)  ; push(sin_milli, 951)       // 72 deg
    push(cos_milli, 105)  ; push(sin_milli, 995)       // 84 deg
    push(cos_milli, 0 - 105)  ; push(sin_milli, 995)   // 96 deg
    push(cos_milli, 0 - 309)  ; push(sin_milli, 951)   // 108 deg
    push(cos_milli, 0 - 500)  ; push(sin_milli, 866)   // 120 deg
    push(cos_milli, 0 - 669)  ; push(sin_milli, 743)   // 132 deg
    push(cos_milli, 0 - 809)  ; push(sin_milli, 588)   // 144 deg
    push(cos_milli, 0 - 914)  ; push(sin_milli, 407)   // 156 deg
    push(cos_milli, 0 - 978)  ; push(sin_milli, 208)   // 168 deg
    push(cos_milli, 0 - 1000) ; push(sin_milli, 0)     // 180 deg
    push(cos_milli, 0 - 978)  ; push(sin_milli, 0 - 208)   // 192 deg
    push(cos_milli, 0 - 914)  ; push(sin_milli, 0 - 407)   // 204 deg
    push(cos_milli, 0 - 809)  ; push(sin_milli, 0 - 588)   // 216 deg
    push(cos_milli, 0 - 669)  ; push(sin_milli, 0 - 743)   // 228 deg
    push(cos_milli, 0 - 500)  ; push(sin_milli, 0 - 866)   // 240 deg
    push(cos_milli, 0 - 309)  ; push(sin_milli, 0 - 951)   // 252 deg
    push(cos_milli, 0 - 105)  ; push(sin_milli, 0 - 995)   // 264 deg
    push(cos_milli, 105)  ; push(sin_milli, 0 - 995)   // 276 deg
    push(cos_milli, 309)  ; push(sin_milli, 0 - 951)   // 288 deg
    push(cos_milli, 500)  ; push(sin_milli, 0 - 866)   // 300 deg
    push(cos_milli, 669)  ; push(sin_milli, 0 - 743)   // 312 deg
    push(cos_milli, 809)  ; push(sin_milli, 0 - 588)   // 324 deg
    push(cos_milli, 914)  ; push(sin_milli, 0 - 407)   // 336 deg
    push(cos_milli, 978)  ; push(sin_milli, 0 - 208)   // 348 deg
    let pair = list_new()
    push(pair, cos_milli)
    push(pair, sin_milli)
    _orb_rot_cache = pair
    return pair
}

fn _orb_cos_milli(bucket) {
    let rt = _orb_build_rotation_table()
    let c = rt[0]
    return c[bucket]
}

fn _orb_sin_milli(bucket) {
    let rt = _orb_build_rotation_table()
    let s = rt[1]
    return s[bucket]
}

// ---- integer atan2 to 30-bucket angle index -------------------------------
//
// Given signed (y, x) (NOTE: y FIRST, matching atan2's convention), return
// the bucket index in 0..29 corresponding to atan2(y, x) in radians. We
// quantize via 8 quadrants + sub-bucket by short/long ratio (same
// approach image_sift uses for its 36-bin orientation histogram).
//
// We map the continuous angle to a bucket by:
//   - dx == 0, dy == 0 -> bucket 0 (arbitrary; uniform regions get
//     a deterministic angle for descriptor reproducibility).
//   - Compute the 8-octant from (sign(x), sign(y), |x| vs |y|).
//   - Within an octant, position by short/long * (30 / 8) = short/long * 3.75.
//
// Easier: bisect by sequential comparison against the cos/sin table.
// We pick the bucket k that minimizes |cos(k*12) - x_norm| + |sin(k*12) - y_norm|
// where (x_norm, y_norm) is (x, y) scaled so the larger absolute value is
// 1000.

fn _orb_angle_bucket(y, x) {
    if x == 0 {
        if y == 0 { return 0 }
    }
    // Scale (x, y) so max(|x|, |y|) is 1000. This keeps comparisons in
    // milli-units consistent with the cos/sin table.
    let ax = x
    if ax < 0 { ax = 0 - ax }
    let ay = y
    if ay < 0 { ay = 0 - ay }
    let m = ax
    if ay > m { m = ay }
    if m == 0 { return 0 }
    let nx = int_mul(x, 1000) / m
    let ny = int_mul(y, 1000) / m
    // Find the bucket k minimizing |cos_k - nx| + |sin_k - ny|.
    let best_k = 0
    let best_err = int_add(1000000, 1000000)  // arbitrary large
    let k = 0
    while k < ORB_ANGLE_BINS {
        let dc = int_sub(_orb_cos_milli(k), nx)
        if dc < 0 { dc = 0 - dc }
        let ds = int_sub(_orb_sin_milli(k), ny)
        if ds < 0 { ds = 0 - ds }
        let err = int_add(dc, ds)
        if err < best_err {
            best_err = err
            best_k = k
        }
        k = int_add(k, 1)
    }
    return best_k
}

// ---- intensity-centroid orientation ---------------------------------------
//
// _orb_keypoint_angle(data_ptr, width, height, cx, cy) -- compute the
// orientation of the 31x31 patch at (cx, cy) via the intensity centroid
// and return the corresponding angle bucket in 0..29.

fn _orb_keypoint_angle(data_ptr, width, height, cx, cy) {
    let m10 = 0
    let m01 = 0
    let dy = 0 - ORB_ORIENT_RADIUS
    while dy <= ORB_ORIENT_RADIUS {
        let yy = int_add(cy, dy)
        if yy >= 0 {
            if yy < height {
                let row_off = int_mul(yy, width)
                let dx = 0 - ORB_ORIENT_RADIUS
                while dx <= ORB_ORIENT_RADIUS {
                    let xx = int_add(cx, dx)
                    if xx >= 0 {
                        if xx < width {
                            let v = load8(data_ptr + row_off + xx)
                            m10 = int_add(m10, int_mul(dx, v))
                            m01 = int_add(m01, int_mul(dy, v))
                        }
                    }
                    dx = int_add(dx, 1)
                }
            }
        }
        dy = int_add(dy, 1)
    }
    return _orb_angle_bucket(m01, m10)
}

// ---- rBRIEF descriptor build ----------------------------------------------
//
// For each of the 256 LFSR-generated (px_i, py_i, px_j, py_j) pairs:
//   1. Rotate (px_i, py_i) and (px_j, py_j) by the keypoint's angle:
//        x' = (px * cos_milli - py * sin_milli) / 1000
//        y' = (px * sin_milli + py * cos_milli) / 1000
//   2. Boundary-clip the rotated points to image bounds.
//   3. Set bit_n = 1 iff I(rotated_p_i) < I(rotated_p_j), else 0.
//
// Bits are packed LSB-first into 8 int32 chunks. The matcher's
// Hamming-distance loop XORs corresponding chunks and popcounts.

fn _orb_describe(data_ptr, width, height, cx, cy, angle_bucket) {
    let pairs = _orb_build_brief_pairs()
    let cos_m = _orb_cos_milli(angle_bucket)
    let sin_m = _orb_sin_milli(angle_bucket)
    let chunks = list_new()
    let c = 0
    while c < ORB_DESC_CHUNKS {
        push(chunks, 0)
        c = int_add(c, 1)
    }
    let n = 0
    while n < ORB_DESC_BITS {
        let p = pairs[n]
        let pxi = p[0]
        let pyi = p[1]
        let pxj = p[2]
        let pyj = p[3]
        // Rotate pi.
        let rxi = int_sub(int_mul(pxi, cos_m), int_mul(pyi, sin_m)) / 1000
        let ryi = int_add(int_mul(pxi, sin_m), int_mul(pyi, cos_m)) / 1000
        // Rotate pj.
        let rxj = int_sub(int_mul(pxj, cos_m), int_mul(pyj, sin_m)) / 1000
        let ryj = int_add(int_mul(pxj, sin_m), int_mul(pyj, cos_m)) / 1000
        // Sample positions (cx + rxi, cy + ryi) and (cx + rxj, cy + ryj),
        // boundary-clipped to image edges.
        let sxi = int_add(cx, rxi)
        let syi = int_add(cy, ryi)
        let sxj = int_add(cx, rxj)
        let syj = int_add(cy, ryj)
        if sxi < 0 { sxi = 0 }
        if syi < 0 { syi = 0 }
        if sxj < 0 { sxj = 0 }
        if syj < 0 { syj = 0 }
        if sxi >= width  { sxi = int_sub(width,  1) }
        if syi >= height { syi = int_sub(height, 1) }
        if sxj >= width  { sxj = int_sub(width,  1) }
        if syj >= height { syj = int_sub(height, 1) }
        let vi = load8(data_ptr + int_add(int_mul(syi, width), sxi))
        let vj = load8(data_ptr + int_add(int_mul(syj, width), sxj))
        if vi < vj {
            // Set bit n in the descriptor. chunk = n / 32; bit = n % 32.
            let chunk_idx = n / ORB_DESC_CHUNK_BITS
            let bit_idx   = n % ORB_DESC_CHUNK_BITS
            // bit_val = 2 ^ bit_idx via repeated doubling (NOVA has no shifts).
            let bit_val = 1
            let b = 0
            while b < bit_idx {
                bit_val = int_mul(bit_val, 2)
                b = int_add(b, 1)
            }
            list_set(chunks, chunk_idx, int_add(chunks[chunk_idx], bit_val))
        }
        n = int_add(n, 1)
    }
    return chunks
}

// ---- FAST candidate top-K insertion (by score, descending) ----------------

fn _orb_make_kp(x, y, angle, score) {
    let kp = list_new()
    push(kp, x)
    push(kp, y)
    push(kp, angle)
    push(kp, score)
    return kp
}

fn _orb_insert_kp(out, kp, cap) {
    let n = len(out)
    let score = kp[ORB_KP_SCORE]
    let pos = n
    let i = 0
    while i < n {
        if score > out[i][ORB_KP_SCORE] {
            pos = i
            i = n
        } else {
            i = int_add(i, 1)
        }
    }
    if pos == n {
        if n < cap { push(out, kp) }
        return 1
    }
    push(out, _orb_make_kp(0, 0, 0, 0))
    let j = len(out) - 1
    while j > pos {
        list_set(out, j, out[j - 1])
        j = int_sub(j, 1)
    }
    list_set(out, pos, kp)
    if len(out) > cap {
        let trimmed = list_new()
        let k = 0
        while k < cap {
            push(trimmed, out[k])
            k = int_add(k, 1)
        }
        let m = 0
        while m < cap {
            list_set(out, m, trimmed[m])
            m = int_add(m, 1)
        }
    }
    return 1
}

// ---- Harris-corner proximity test (reuses image_harris.nova) -------------

fn _orb_has_nearby_harris(corners, x, y) {
    let n = len(corners)
    let i = 0
    while i < n {
        let c = corners[i]
        let dx = int_sub(c[0], x)
        if dx < 0 { dx = 0 - dx }
        let dy = int_sub(c[1], y)
        if dy < 0 { dy = 0 - dy }
        if dx <= ORB_HARRIS_RADIUS {
            if dy <= ORB_HARRIS_RADIUS {
                return 1
            }
        }
        i = int_add(i, 1)
    }
    return 0
}

// ---- public API: detection + description -------------------------------------
//
// orb_detect(data_ptr, width, height, max_keypoints) ->
//   [keypoints, descriptors] where:
//     keypoints   = list of [x, y, angle_bucket, fast_score]
//     descriptors = parallel list of 8-int chunks (256 bits each)
// Returns [empty, empty] on degenerate inputs (zero/negative dims, NULL
// pointer, dimensions outside [ORB_MIN_DIM, ORB_MAX_DIM]).

fn orb_detect(data_ptr, width, height, max_keypoints) {
    let empty_kps = list_new()
    let empty_descs = list_new()
    let result = list_new()
    push(result, empty_kps)
    push(result, empty_descs)
    if width <= 0   { return result }
    if height <= 0  { return result }
    if data_ptr == 0 { return result }
    if width  < ORB_MIN_DIM { return result }
    if height < ORB_MIN_DIM { return result }
    if width  > ORB_MAX_DIM { return result }
    if height > ORB_MAX_DIM { return result }
    let area = int_mul(width, height)
    if area > ORB_MAX_PIXEL_AREA { return result }
    let cap = max_keypoints
    if cap < 1 { cap = 1 }
    if cap > ORB_HARD_MAX { cap = ORB_HARD_MAX }

    // 1. Harris on the image -- used as a corner-proximity filter so we
    //    drop FAST candidates that landed on edges, mirroring SIFT's
    //    edge-rejection pattern.
    let harris_r = harris_apply(data_ptr, width, height)
    let harris_corners = harris_result_corners(harris_r)
    let n_harris = len(harris_corners)

    // 2. FAST-9 scan over interior pixels. The hard requirement is a
    //    3-pixel border on each side (the Bresenham circle of radius 3).
    //    The 15-pixel patch around each keypoint (orientation +
    //    descriptor) boundary-clips internally, so we don't need a
    //    15-pixel border at scan time -- a 3-pixel border suffices.
    //    This lets corner keypoints near the image edges be detected
    //    (consistent with image_sift.nova's "shift the window to fit"
    //    behavior at edge keypoints).
    let cands = list_new()
    let y = 3
    let y_end = int_sub(height, 3)
    while y < y_end {
        let x = 3
        let x_end = int_sub(width, 3)
        while x < x_end {
            let score = _orb_is_fast9_corner(data_ptr, width, height, x, y, ORB_FAST_THRESHOLD)
            if score > 0 {
                // Harris-corner proximity: keep ONLY if we have a Harris
                // corner nearby (mirrors image_sift). When Harris returned
                // ZERO corners (e.g., very small or featureless image),
                // we KEEP all candidates so the substrate at least sees
                // an empty-but-deterministic descriptor set.
                let keep = 1
                if n_harris > 0 {
                    keep = _orb_has_nearby_harris(harris_corners, x, y)
                }
                if keep == 1 {
                    let angle = _orb_keypoint_angle(data_ptr, width, height, x, y)
                    let kp = _orb_make_kp(x, y, angle, score)
                    _orb_insert_kp(cands, kp, cap)
                }
            }
            x = int_add(x, 1)
        }
        y = int_add(y, 1)
    }

    // 3. Build descriptors for each kept keypoint.
    let descs = list_new()
    let i = 0
    while i < len(cands) {
        let kp = cands[i]
        let d = _orb_describe(data_ptr, width, height,
                              orb_kp_x(kp), orb_kp_y(kp), orb_kp_angle(kp))
        push(descs, d)
        i = int_add(i, 1)
    }

    let out = list_new()
    push(out, cands)
    push(out, descs)
    return out
}

// ---- public API: Hamming distance + matcher -------------------------------

// orb_hamming_distance(desc_a, desc_b) -> int (popcount of XOR over all
// 8 chunks). Returns -1 on mismatched chunk counts.
fn orb_hamming_distance(desc_a, desc_b) {
    let na = len(desc_a)
    let nb = len(desc_b)
    if na != nb { return 0 - 1 }
    if na == 0  { return 0 - 1 }
    let total = 0
    let i = 0
    while i < na {
        let x = _orb_xor32(desc_a[i], desc_b[i])
        total = int_add(total, _orb_popcount32(x))
        i = int_add(i, 1)
    }
    return total
}

// _orb_best_two_distances: for desc_a, find the best (lowest Hamming) and
// second-best candidate in desc_b_list. Returns [best, second, best_idx].
fn _orb_best_two_distances(desc_a, desc_b_list) {
    let n = len(desc_b_list)
    let best = 0 - 1
    let second = 0 - 1
    let best_idx = 0 - 1
    let i = 0
    while i < n {
        let d = orb_hamming_distance(desc_a, desc_b_list[i])
        if d >= 0 {
            if best < 0 {
                best = d
                best_idx = i
            } else {
                if d < best {
                    second = best
                    best = d
                    best_idx = i
                } else {
                    if second < 0 { second = d }
                    else {
                        if d < second { second = d }
                    }
                }
            }
        }
        i = int_add(i, 1)
    }
    let triple = list_new()
    push(triple, best)
    push(triple, second)
    push(triple, best_idx)
    return triple
}

// orb_match(kps_a, descs_a, kps_b, descs_b, ratio_milli) -> list of
//   [idx_a, idx_b, distance] triples for which best_distance / second_best
//   < ratio_milli/1000. ratio_milli default 750.
fn orb_match(kps_a, descs_a, kps_b, descs_b, ratio_milli) {
    let matches = list_new()
    let na = len(descs_a)
    let nb = len(descs_b)
    if na == 0 { return matches }
    if nb < 2  { return matches }
    let i = 0
    while i < na {
        let pair = _orb_best_two_distances(descs_a[i], descs_b)
        let best = pair[0]
        let second = pair[1]
        let best_idx = pair[2]
        if best >= 0 {
            if second > 0 {
                // best/second < ratio_milli/1000 <=> best * 1000 < ratio_milli * second.
                let lhs = int_mul(best, 1000)
                let rhs = int_mul(ratio_milli, second)
                if lhs < rhs {
                    let m = list_new()
                    push(m, i)
                    push(m, best_idx)
                    push(m, best)
                    push(matches, m)
                }
            } else {
                // second == 0 means the best and (at least one) other
                // descriptor are both EXACT matches. Most-common case:
                // self-match (A==B), the best distance is 0 and ANOTHER
                // descriptor in B happens to also be 0. We accept these
                // as "matched" (the Hamming-distance ratio test is
                // ill-defined when both numerator and denominator are 0;
                // treating it as a pass mirrors what most ORB tutorials
                // do when comparing an image against its identical twin).
                if best == 0 {
                    let m = list_new()
                    push(m, i)
                    push(m, best_idx)
                    push(m, best)
                    push(matches, m)
                }
            }
        }
        i = int_add(i, 1)
    }
    return matches
}

// ---- count-bucket helpers (parallel to harris/sift) -----------------------

fn orb_kps_count_label(n) {
    if n <= ORB_COUNT_LOW_MAX { return "image_orb_kps_low" }
    if n <= ORB_COUNT_MID_MAX { return "image_orb_kps_mid" }
    return "image_orb_kps_high"
}

// Density label: a parallel atom indicating the keypoint density per
// kilo-pixel. Used by the visual_perception seam.
fn orb_density_label(n, area) {
    if area <= 0 { return "image_orb_density_low" }
    // density per 1000 pixels = n * 1000 / area (integer).
    let density = int_mul(n, 1000) / area
    if density <= 5  { return "image_orb_density_low" }
    if density <= 20 { return "image_orb_density_mid" }
    return "image_orb_density_high"
}

// ---- result-tuple + per-keypoint accessors --------------------------------

fn orb_result_keypoints(r)   { return r[ORB_R_KPS] }
fn orb_result_descriptors(r) { return r[ORB_R_DESCS] }
fn orb_result_count(r)       { return len(r[ORB_R_KPS]) }

fn orb_kp_x(kp)     { return kp[ORB_KP_X] }
fn orb_kp_y(kp)     { return kp[ORB_KP_Y] }
fn orb_kp_angle(kp) { return kp[ORB_KP_ANGLE] }
fn orb_kp_score(kp) { return kp[ORB_KP_SCORE] }

// ---- chat-orchestration helper -------------------------------------------
//
// orb_match_pgm_args(arg) -> formatted result string suitable for
// `io_println` directly. Takes the raw chat argument (everything after
// `/orb_match `), splits on the first space, and orchestrates the full
// pipeline (PGM parse + orb_detect + orb_match) so the chat's admin
// dispatch line stays a one-liner.

// Split a space-separated argument string into [path_a, path_b]; if there
// is no space, returns [arg, ""]. Mirrors src/chat/helpers.nova's
// _split_cmd contract so the chat dispatch stays compatible with R5C's
// /match_images flow.
fn _orb_split_two(arg) {
    let pair = list_new()
    let n = len(arg)
    let i = 0
    while i < n {
        if char_at(arg, i) == 32 {
            push(pair, substr(arg, 0, i))
            push(pair, substr(arg, int_add(i, 1), int_sub(n, int_add(i, 1))))
            return pair
        }
        i = int_add(i, 1)
    }
    push(pair, arg)
    push(pair, "")
    return pair
}

// orb_match_pgm_args -- raw-arg variant the chat dispatches to directly.
fn orb_match_pgm_args(arg) {
    if len(arg) == 0 {
        return "(/orb_match needs two PATHs -- usage: /orb_match A.pgm B.pgm)"
    }
    let parts = _orb_split_two(arg)
    return orb_match_pgm_paths(parts[0], parts[1])
}

// orb_match_pgm_paths(path_a, path_b) -> formatted result string suitable
// for `io_println` directly. Encapsulates the PGM parse + orb_detect +
// orb_match pipeline so the chat's admin dispatch line stays one-liner.
//
// Output shapes (all wrapped in parens for the same format the rest of
// the chat uses):
//   (orb_match needs two PATHs -- usage: /orb_match A.pgm B.pgm)
//   (orb_match needs TWO paths -- got 1)
//   (orb_match FAILED on A: <pgm parser error>)
//   (orb_match FAILED on B: <pgm parser error>)
//   (orb_match FAILED: A must be >= 32x32)
//   (orb_match FAILED: B must be >= 32x32)
//   (orb matched <N> keypoint(s); A=<kpa>kps B=<kpb>kps)
fn orb_match_pgm_paths(path_a, path_b) {
    if len(path_a) == 0 {
        return "(/orb_match needs two PATHs -- usage: /orb_match A.pgm B.pgm)"
    }
    if len(path_b) == 0 {
        return "(/orb_match needs TWO paths -- got 1)"
    }
    let r_a = pgm_parse_file(path_a)
    let err_a = pgm_result_error(r_a)
    if len(err_a) > 0 {
        return "(orb_match FAILED on A: " + err_a + ")"
    }
    let r_b = pgm_parse_file(path_b)
    let err_b = pgm_result_error(r_b)
    if len(err_b) > 0 {
        return "(orb_match FAILED on B: " + err_b + ")"
    }
    let w_a = pgm_result_width(r_a)
    let h_a = pgm_result_height(r_a)
    let d_a = pgm_result_data(r_a)
    let w_b = pgm_result_width(r_b)
    let h_b = pgm_result_height(r_b)
    let d_b = pgm_result_data(r_b)
    if w_a < ORB_MIN_DIM { return "(orb_match FAILED: A must be >= 32x32)" }
    if h_a < ORB_MIN_DIM { return "(orb_match FAILED: A must be >= 32x32)" }
    if w_b < ORB_MIN_DIM { return "(orb_match FAILED: B must be >= 32x32)" }
    if h_b < ORB_MIN_DIM { return "(orb_match FAILED: B must be >= 32x32)" }
    let oa = orb_detect(d_a, w_a, h_a, ORB_HARD_MAX)
    let ob = orb_detect(d_b, w_b, h_b, ORB_HARD_MAX)
    let kps_a = orb_result_keypoints(oa)
    let kps_b = orb_result_keypoints(ob)
    let descs_a = orb_result_descriptors(oa)
    let descs_b = orb_result_descriptors(ob)
    let matches = orb_match(kps_a, descs_a, kps_b, descs_b, ORB_DEFAULT_RATIO_MILLI)
    return "(orb matched " + int_to_str(len(matches))
        + " keypoint(s); A=" + int_to_str(len(kps_a))
        + "kps B=" + int_to_str(len(kps_b)) + "kps)"
}
