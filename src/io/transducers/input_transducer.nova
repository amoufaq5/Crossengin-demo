// CrossEngin io/transducers: input modality transducer.
//
// Purpose
//   Turns raw input modality into a normalized percept the reader can anchor
//   (ADR-0011/0012), keeping modality conversion strictly OUTSIDE cognition
//   (ADR-0014): this is pure string transduction, never interpretation. Text is
//   normalized (trim, lowercase, collapse internal whitespace) into the exact
//   form the reader's lexical anchor expects; a file is treated as text. Audio
//   (speech-to-text) is the NOVA modality-bridge seam (enhancement #14): the
//   transducer reports it as not-yet-ready and yields an empty percept for the
//   bridge to fill, rather than fabricating a transcription.
//
//   The output is a percept record [modality, normalized_text, token_count];
//   the caller hands normalized_text to the reader and/or captures it as a
//   moment (ADR-0021).
//
// ADRs implemented: ADR-0014 (modality bridge, no cognition path), ADR-0011/0012
//   (reader-ready normalization), ADR-0021 (percept for moment capture).
// NOVA dependencies: builtins (str_trim, str_lower, split, len). CrossEngin
//   dependencies: none.

// Input modality kinds.
import "../../util/str_safe.nova"
let IN_TEXT  = 1
let IN_AUDIO = 2
let IN_FILE  = 3

fn in_modality_name(m) {
    if m == IN_TEXT  { return "text" }
    if m == IN_AUDIO { return "audio" }
    if m == IN_FILE  { return "file" }
    return "unknown"
}

// Can this modality be transduced now? Text/file yes; audio is the deferred
// STT bridge seam (NOVA enhancement #14).
fn transducer_ready(modality) {
    if modality == IN_TEXT { return 1 }
    if modality == IN_FILE { return 1 }
    return 0
}

// Normalize raw text: trim, lowercase, and collapse internal whitespace runs to
// single spaces. Deterministic, no cognition.
fn transduce_text(raw) {
    let lowered = str_lower(str_trim(raw))
    let toks = split_space(lowered)
    let out = ""
    let first = 1
    let i = 0
    while i < len(toks) {
        let t = str_trim(toks[i])
        if len(t) > 0 {
            if first == 0 { out = out + " " }
            out = out + t
            first = 0
        }
        i = i + 1
    }
    return out
}

// ---- percept record [modality, normalized_text, token_count] --------------
let PCT_MODALITY = 0
let PCT_TEXT     = 1
let PCT_TOKENS   = 2

fn _count_tokens(text) {
    let toks = split_space(text)
    let n = 0
    let i = 0
    while i < len(toks) {
        if len(str_trim(toks[i])) > 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn percept_new(modality, text) {
    let p = list_new()
    push(p, modality)
    push(p, text)
    push(p, _count_tokens(text))
    return p
}

fn percept_modality(p) { return p[PCT_MODALITY] }
fn percept_text(p)     { return p[PCT_TEXT] }
fn percept_tokens(p)   { return p[PCT_TOKENS] }

// Transduce a raw input of a given modality into a normalized percept. Text/file
// are normalized to text; audio yields an empty audio-tagged percept (the STT
// bridge fills it) -- never a fabricated transcription.
fn transduce(modality, raw) {
    if transducer_ready(modality) == 1 {
        return percept_new(modality, transduce_text(raw))
    }
    return percept_new(modality, "")
}

// Did transduction yield usable text (a non-empty percept the reader can read)?
fn percept_has_text(p) {
    if len(percept_text(p)) > 0 { return 1 }
    return 0
}
