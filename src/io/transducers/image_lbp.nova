// CrossEngin io/transducers: LBP (Local Binary Patterns).
//
// Purpose
//   Ojala 1996's classic texture descriptor. While HOG (R14D)
//   summarizes gradient ORIENTATION in cells and SIFT/ORB describe
//   sparse keypoints, LBP describes the LOCAL TEXTURE around every
//   pixel by comparing it against its 8 immediate neighbors and
//   packing the comparison bits into a single byte. The byte itself
//   is the per-pixel "texture code"; the histogram of codes over a
//   region is the texture descriptor.
//
//   LBP is the workhorse of classical face RECOGNITION (vs HOG which
//   is the workhorse of classical face / pedestrian DETECTION, and
//   vs Viola-Jones (R16D) which is structural face DETECTION). The
//   canonical use is:
//     1. Divide a normalized face crop into N x M cells (typically
//        8 x 8 = 64 cells).
//     2. Compute the 256-bin LBP code histogram per cell.
//     3. Concatenate -> 64 * 256 = 16384-bin descriptor.
//     4. Compare two face descriptors with chi-squared distance.
//
//   This is the descriptor that powered Ahonen et al.'s 2006 face-
//   recognition paper ("Face Recognition with Local Binary Patterns")
//   which beat the prior eigenfaces / Fisherfaces baselines and
//   remained the dominant non-DL face-rec method for nearly a
//   decade. The descriptor is also broadly used in texture
//   classification, age / gender estimation, facial expression
//   recognition, and dynamic texture analysis -- any task where
//   "summarize a small image patch's texture" is the right
//   abstraction.
//
//   For CrossEngin's non-LLM substrate, the LBP descriptor is a
//   CLASSIFIER INPUT: a SVM / KNN / nearest-template matcher would
//   consume two descriptors and return a "match" / "no match". This
//   module ships the DESCRIPTOR + COMPARISON primitives; the
//   recognition pipeline (gallery of known faces + nearest-neighbor
//   lookup) can be built on top in a future round (the same shape
//   as the R15C HOG sliding-window detector).
//
// Algorithm (LBP, integer-only)
//   1. For each pixel (x, y) inspect its 3x3 neighborhood. The 8
//      neighbors are labeled clockwise from top-left:
//
//        P7 P0 P1
//        P6  C P2
//        P5 P4 P3
//
//      Center C is the pixel value; P_i are its neighbors at offsets
//      P0=(0,-1), P1=(1,-1), P2=(1,0), P3=(1,1), P4=(0,1), P5=(-1,1),
//      P6=(-1,0), P7=(-1,-1).
//
//   2. Threshold each neighbor against the center:
//        b_i = 1 if P_i >= C else 0
//      Equality maps to 1 (matching uniform-region semantics: an
//      all-128 image yields code 0xFF, every-neighbor-equal-to-center).
//
//   3. Pack 8 bits into a single byte (the LBP code, 0..255):
//        lbp(x, y) = b7*128 + b0*64 + b1*32 + b2*16
//                  + b3*8   + b4*4  + b5*2  + b6*1
//
//   4. Border pixels (any of (x, y) on the outermost ring) have no
//      complete 3x3 neighborhood. We assign code 0 (a sentinel
//      "uniform / unknown" code; the descriptor / histogram users
//      typically operate on interior regions so this is harmless).
//
//   5. Histogram: count code occurrences over a rectangular ROI.
//      256-bin output, one int per code.
//
//   6. Descriptor: tile the image into cells_x x cells_y cells; per
//      cell compute the histogram; concatenate cell histograms ->
//      cells_x * cells_y * 256 ints.
//
//   7. Compare: chi-squared distance between two descriptors of
//      equal length:
//        chi2(a, b) = sum_i (a_i - b_i)^2 / (a_i + b_i + 1)
//      We return the integer sum; smaller = more similar. The "+1"
//      term avoids divide-by-zero on empty bins.
//
// Rotation invariance: BASIC LBP IS NOT ROTATION-INVARIANT. Rotating
//   the input by 90 degrees permutes the neighbor labels (P0 -> P2,
//   P1 -> P3, etc.) so the packed code changes. The unit suite
//   demonstrates this explicitly. The standard rotation-invariant
//   variant LBP_ri remaps each code to its minimum rotation (a 256
//   -> 36 lookup) and the "uniform" LBP variant further reduces to
//   59 distinct patterns; both are documented follow-ups. SIFT (R5C)
//   and ORB (R6D) ARE rotation-invariant; HOG (R14D) is NOT, and
//   plain LBP shares that limitation. This is by design: in face
//   recognition the face IS pose-normalized first (e.g., eyes
//   aligned) so rotation invariance is not needed at the descriptor
//   layer.
//
// Public API
//   lbp_compute_image(image, width, height) -> lbp_image_t
//       Per-pixel LBP code buffer; same dimensions as input. Border
//       pixels are 0. Returns sentinel result on OOB / oversized.
//   lbp_image_width(img) / _height -- accessors.
//   lbp_at(lbp_img, x, y) -> int (LBP code or 0 if OOB)
//   lbp_histogram(lbp_img, x1, y1, x2, y2) -> list[256]
//       Histogram of codes within the [x1, x2) x [y1, y2) ROI.
//       Returns the all-zero 256-list if the ROI is invalid.
//   lbp_descriptor(image, w, h, cells_x, cells_y) -> list[int]
//       cells_x * cells_y * 256 concatenated cell histograms. The
//       canonical "face descriptor" interface.
//   lbp_compare(desc_a, desc_b) -> int (chi-squared distance)
//       -1 on length mismatch. 0 -> identical.
//   lbp_compare_intersection(desc_a, desc_b) -> int
//       Histogram-intersection distance (sum of mins). Alternative
//       to chi-squared for callers preferring a similarity score
//       (LARGER = more similar, capped at the total sample count).
//   lbp_dominant_code(image, w, h) -> int [0..255]
//       Argmax of the WHOLE-IMAGE histogram. Used by visual_perception
//       to mint the `image_lbp_dominant_code_*` atom.
//   lbp_texture_entropy_milli(image, w, h) -> int (0..8000 milli-bits)
//       Shannon entropy over the 256-bin histogram in milli-bits.
//       Uniform fields yield ~0; highly textured fields approach
//       8000 (log2(256) = 8 bits).
//   lbp_pgm_args(arg) -> chat /lbp admin formatted string.
//
// Caps:
//   Dimensions  <= LBP_MAX_DIM (256) per axis; total area capped
//                  too (LBP_MAX_AREA = 65536).
//   cells_x, cells_y in [LBP_CELLS_MIN, LBP_CELLS_MAX] = [2, 16].
//
// ADRs implemented: ADR-0014 (modality bridge, no cognition path).
// NOVA dependencies: builtins -- alloc, store8, load8, list_new,
//   push, list_set, len, int_add, int_sub, int_mul.
// CrossEngin dependencies: image_pgm.nova (only the chat helper
//   imports it; the core algorithm is a leaf).

import "image_pgm.nova"

// ---- caps + bin count ----------------------------------------------------

let LBP_MAX_DIM   = 256
let LBP_MAX_AREA  = 65536       // 256 * 256
let LBP_CELLS_MIN = 2
let LBP_CELLS_MAX = 16
let LBP_NUM_BINS  = 256         // 2^8 -- the LBP code range

// ---- lbp_image_t result-tuple layout -------------------------------------
//
// Slot indices:
//   [0] width
//   [1] height
//   [2] data_ptr  -- byte buffer of LBP codes (size w * h) or 0 on error
//   [3] error     -- empty string on success, diagnostic on failure

let LBP_R_WIDTH = 0
let LBP_R_HEIGHT = 1
let LBP_R_DATA = 2
let LBP_R_ERROR = 3

// ---- result helpers ------------------------------------------------------

fn _lbp_error(msg) {
    let r = list_new()
    push(r, 0)
    push(r, 0)
    push(r, 0)
    push(r, msg)
    return r
}

// ---- public: lbp_compute_image -------------------------------------------
//
// Walk every pixel and pack its 3x3 neighborhood comparison into the
// output byte buffer. Border pixels (outermost ring) get code 0.

fn lbp_compute_image(image, width, height) {
    if image == 0  { return _lbp_error("lbp: null image pointer") }
    if width <= 0  { return _lbp_error("lbp: invalid width") }
    if height <= 0 { return _lbp_error("lbp: invalid height") }
    if width > LBP_MAX_DIM  { return _lbp_error("lbp: width exceeds cap") }
    if height > LBP_MAX_DIM { return _lbp_error("lbp: height exceeds cap") }
    let area = int_mul(width, height)
    if area > LBP_MAX_AREA { return _lbp_error("lbp: area exceeds cap") }
    let out = alloc(int_add(area, 1))
    // Border ring -- store 0 across the outermost rows + columns.
    let i = 0
    while i < area {
        store8(out + i, 0)
        i = int_add(i, 1)
    }
    store8(out + area, 0)
    // Interior pass: 3x3 neighborhood comparison.
    let y = 1
    while y < int_sub(height, 1) {
        let row_above = int_mul(int_sub(y, 1), width)
        let row_mid   = int_mul(y, width)
        let row_below = int_mul(int_add(y, 1), width)
        let x = 1
        while x < int_sub(width, 1) {
            let c  = load8(image + row_mid + x)
            let p0 = load8(image + row_above + x)               // top
            let p1 = load8(image + row_above + int_add(x, 1))   // top-right
            let p2 = load8(image + row_mid   + int_add(x, 1))   // right
            let p3 = load8(image + row_below + int_add(x, 1))   // bot-right
            let p4 = load8(image + row_below + x)               // bottom
            let p5 = load8(image + row_below + int_sub(x, 1))   // bot-left
            let p6 = load8(image + row_mid   + int_sub(x, 1))   // left
            let p7 = load8(image + row_above + int_sub(x, 1))   // top-left
            // Pack bits per the brief's clockwise-from-top-left order:
            //   code = b7*128 + b0*64 + b1*32 + b2*16
            //        + b3*8   + b4*4  + b5*2  + b6*1
            let code = 0
            if p7 >= c { code = int_add(code, 128) }
            if p0 >= c { code = int_add(code, 64) }
            if p1 >= c { code = int_add(code, 32) }
            if p2 >= c { code = int_add(code, 16) }
            if p3 >= c { code = int_add(code, 8) }
            if p4 >= c { code = int_add(code, 4) }
            if p5 >= c { code = int_add(code, 2) }
            if p6 >= c { code = int_add(code, 1) }
            store8(out + row_mid + x, code)
            x = int_add(x, 1)
        }
        y = int_add(y, 1)
    }
    let r = list_new()
    push(r, width)
    push(r, height)
    push(r, out)
    push(r, "")
    return r
}

// ---- accessors -----------------------------------------------------------

fn lbp_image_width(img)  { return img[LBP_R_WIDTH] }
fn lbp_image_height(img) { return img[LBP_R_HEIGHT] }
fn lbp_image_data(img)   { return img[LBP_R_DATA] }
fn lbp_image_error(img)  { return img[LBP_R_ERROR] }

fn lbp_at(img, x, y) {
    let w = img[LBP_R_WIDTH]
    let h = img[LBP_R_HEIGHT]
    let data = img[LBP_R_DATA]
    if data == 0 { return 0 }
    if x < 0 { return 0 }
    if y < 0 { return 0 }
    if x >= w { return 0 }
    if y >= h { return 0 }
    return load8(data + int_add(int_mul(y, w), x))
}

// ---- public: lbp_histogram -----------------------------------------------
//
// Histogram of LBP codes within the half-open ROI [x1, x2) x [y1, y2).
// Returns a 256-bin int list; the all-zero list on invalid ROI.

fn _lbp_zero_hist() {
    let h = list_new()
    let i = 0
    while i < LBP_NUM_BINS {
        push(h, 0)
        i = int_add(i, 1)
    }
    return h
}

fn lbp_histogram(img, x1, y1, x2, y2) {
    let hist = _lbp_zero_hist()
    let w = img[LBP_R_WIDTH]
    let h = img[LBP_R_HEIGHT]
    let data = img[LBP_R_DATA]
    if data == 0 { return hist }
    if x1 < 0 { x1 = 0 }
    if y1 < 0 { y1 = 0 }
    if x2 > w { x2 = w }
    if y2 > h { y2 = h }
    if x1 >= x2 { return hist }
    if y1 >= y2 { return hist }
    let y = y1
    while y < y2 {
        let row = int_mul(y, w)
        let x = x1
        while x < x2 {
            let code = load8(data + int_add(row, x))
            list_set(hist, code, int_add(hist[code], 1))
            x = int_add(x, 1)
        }
        y = int_add(y, 1)
    }
    return hist
}

// ---- public: lbp_descriptor ----------------------------------------------
//
// Tile the image into cells_x x cells_y cells; concatenate the 256-bin
// histogram of each cell. Output length = cells_x * cells_y * 256.
//
// Cell boundaries use integer division: cell width = w / cells_x; any
// leftover columns at the right edge go into the last cell. Same for
// rows. This keeps total coverage at 100% even when dimensions aren't
// exact multiples of the cell count.
//
// Returns the empty list on cap violation / invalid input.

fn _lbp_cells_ok(c) {
    if c < LBP_CELLS_MIN { return 0 }
    if c > LBP_CELLS_MAX { return 0 }
    return 1
}

fn lbp_descriptor(image, width, height, cells_x, cells_y) {
    let empty = list_new()
    if _lbp_cells_ok(cells_x) == 0 { return empty }
    if _lbp_cells_ok(cells_y) == 0 { return empty }
    let lbp_img = lbp_compute_image(image, width, height)
    if len(lbp_image_error(lbp_img)) > 0 { return empty }
    let w = lbp_image_width(lbp_img)
    let h = lbp_image_height(lbp_img)
    if w < cells_x { return empty }
    if h < cells_y { return empty }
    let cell_w = w / cells_x
    let cell_h = h / cells_y
    let desc = list_new()
    let cy = 0
    while cy < cells_y {
        let y1 = int_mul(cy, cell_h)
        let y2 = int_mul(int_add(cy, 1), cell_h)
        if cy == int_sub(cells_y, 1) { y2 = h }
        let cx = 0
        while cx < cells_x {
            let x1 = int_mul(cx, cell_w)
            let x2 = int_mul(int_add(cx, 1), cell_w)
            if cx == int_sub(cells_x, 1) { x2 = w }
            let hist = lbp_histogram(lbp_img, x1, y1, x2, y2)
            let bi = 0
            while bi < LBP_NUM_BINS {
                push(desc, hist[bi])
                bi = int_add(bi, 1)
            }
            cx = int_add(cx, 1)
        }
        cy = int_add(cy, 1)
    }
    return desc
}

// ---- public: lbp_compare (chi-squared) -----------------------------------
//
// Chi-squared distance between two equal-length descriptors:
//   chi2 = sum_i (a_i - b_i)^2 / (a_i + b_i + 1)
//
// We return the integer-truncated sum. The +1 in the denominator
// avoids divide-by-zero on empty bins and is the standard Pearson's
// chi-squared adaptation used in the LBP face-recognition literature
// (Ahonen 2006). 0 = identical; larger = more dissimilar. Returns -1
// for length mismatch (incompatible inputs).
//
// The sum is bounded above by sum_i (a_i + b_i) (since (a-b)^2 <=
// (a+b)^2 and dividing by (a+b+1) gives ~= a+b for any non-trivial
// bin), so the distance has a natural ceiling near the total number
// of sampled pixels.

fn lbp_compare(desc_a, desc_b) {
    let na = len(desc_a)
    let nb = len(desc_b)
    if na != nb { return 0 - 1 }
    let sum = 0
    let i = 0
    while i < na {
        let a = desc_a[i]
        let b = desc_b[i]
        let diff = int_sub(a, b)
        let num  = int_mul(diff, diff)
        let den  = int_add(int_add(a, b), 1)
        sum = int_add(sum, num / den)
        i = int_add(i, 1)
    }
    return sum
}

// ---- public: lbp_compare_intersection -----------------------------------
//
// Histogram-intersection similarity. sum_i min(a_i, b_i). LARGER ->
// MORE SIMILAR; bounded above by the total sample count of either
// descriptor. The companion metric to chi-squared; callers preferring
// "similarity in [0, total]" use this.

fn lbp_compare_intersection(desc_a, desc_b) {
    let na = len(desc_a)
    let nb = len(desc_b)
    if na != nb { return 0 - 1 }
    let sum = 0
    let i = 0
    while i < na {
        let a = desc_a[i]
        let b = desc_b[i]
        let m = a
        if b < m { m = b }
        sum = int_add(sum, m)
        i = int_add(i, 1)
    }
    return sum
}

// ---- public: lbp_dominant_code -------------------------------------------
//
// The single most common LBP code over the WHOLE image. Border pixels
// (0-codes) are excluded from the argmax -- they aren't real texture
// codes, just the sentinel for "no neighborhood".

fn lbp_dominant_code(image, width, height) {
    let lbp_img = lbp_compute_image(image, width, height)
    if len(lbp_image_error(lbp_img)) > 0 { return 0 - 1 }
    let w = lbp_image_width(lbp_img)
    let h = lbp_image_height(lbp_img)
    // Interior-only histogram so the border 0s do not skew the argmax.
    let hist = lbp_histogram(lbp_img, 1, 1, int_sub(w, 1), int_sub(h, 1))
    let best_code = 0
    let best_count = 0 - 1
    let i = 0
    while i < LBP_NUM_BINS {
        if hist[i] > best_count {
            best_count = hist[i]
            best_code = i
        }
        i = int_add(i, 1)
    }
    return best_code
}

// ---- public: lbp_texture_entropy_milli ----------------------------------
//
// Shannon entropy of the per-image LBP histogram, in milli-bits. A
// uniform field (every code identical) yields ~0; a highly textured
// random field (every code roughly equiprobable) approaches
// log2(256) * 1000 = 8000.
//
// Implementation: same shape as pgm_histogram_entropy_milli but over
// 256 bins instead of 256 intensities. We use a small lookup table
// for log2(p) in milli rather than a runtime log. The table maps
// "probability bucket index" to milli-bits per pixel; the bucket
// index quantizes p in 1/64-ths so we get reasonable resolution
// without a divide loop.

fn _lbp_log2_milli(numerator, denominator) {
    if numerator <= 0 { return 0 }
    if denominator <= 0 { return 0 }
    // We compute floor(log2(denominator / numerator)) * 1000 plus a
    // small linear correction in the fractional part. Both operands
    // are integers so we use repeated doubling: count k such that
    // numerator * 2^k >= denominator, then -k is the integer
    // log2(p) and 1 / 2^k is the residual probability.
    let p = numerator
    let k = 0
    while p < denominator {
        p = int_mul(p, 2)
        k = int_add(k, 1)
        if k >= 30 { return int_mul(k, 1000) }
    }
    // Linear-interpolate between 2^-k and 2^-(k-1). The fractional
    // residual is (p - denominator) / denominator -> contribution
    // (in milli-bits) ~= 1000 * (p - denominator) / denominator.
    let frac = int_sub(p, denominator)
    let extra = 0
    if denominator > 0 { extra = int_mul(frac, 1000) / denominator }
    if extra > 1000 { extra = 1000 }
    let base = int_mul(k, 1000)
    let res  = int_sub(base, extra)
    if res < 0 { res = 0 }
    return res
}

fn lbp_texture_entropy_milli(image, width, height) {
    let lbp_img = lbp_compute_image(image, width, height)
    if len(lbp_image_error(lbp_img)) > 0 { return 0 }
    let w = lbp_image_width(lbp_img)
    let h = lbp_image_height(lbp_img)
    if w < 3 { return 0 }
    if h < 3 { return 0 }
    let hist = lbp_histogram(lbp_img, 1, 1, int_sub(w, 1), int_sub(h, 1))
    let total = 0
    let i = 0
    while i < LBP_NUM_BINS {
        total = int_add(total, hist[i])
        i = int_add(i, 1)
    }
    if total <= 0 { return 0 }
    let entropy_milli = 0
    let j = 0
    while j < LBP_NUM_BINS {
        let c = hist[j]
        if c > 0 {
            // contribution = p * log2(1/p) = (c/total) * log2(total/c)
            // in milli-bits: c * 1000 * log2(total/c) / total
            // We pull the log into _lbp_log2_milli which returns
            // log2(total/c) * 1000.
            let log_milli = _lbp_log2_milli(c, total)
            let term = int_mul(c, log_milli) / total
            entropy_milli = int_add(entropy_milli, term)
        }
        j = int_add(j, 1)
    }
    return entropy_milli
}

// ---- structural-feature labels for visual_perception --------------------
//
// Bucket the dominant LBP code into a small set of labels so the
// perception path emits a stable atom across multiple images with
// similar texture. The 256 codes split naturally into "uniform-bright"
// (high codes -- many neighbors >= center, including the all-0xFF
// uniform-field sentinel), "uniform-dark" (low codes), and "mixed
// texture" (mid-range codes with a balance of set / unset bits).

fn _lbp_popcount(code) {
    let n = 0
    let c = code
    let i = 0
    while i < 8 {
        if c >= 128 {
            n = int_add(n, 1)
            c = int_sub(c, 128)
        }
        c = int_mul(c, 2)
        i = int_add(i, 1)
    }
    return n
}

fn lbp_dominant_code_label(code) {
    if code < 0 { return "image_lbp_dominant_code_none" }
    let pop = _lbp_popcount(code)
    // pop == 8 (all bits set -- uniform-bright neighborhood, the
    // uniform-field sentinel).
    if pop == 8 { return "image_lbp_dominant_code_uniform_bright" }
    if pop == 0 { return "image_lbp_dominant_code_uniform_dark" }
    if pop >= 6 { return "image_lbp_dominant_code_bright" }
    if pop <= 2 { return "image_lbp_dominant_code_dark" }
    return "image_lbp_dominant_code_mixed"
}

// Texture-entropy bucket: peaked (most codes concentrated in a few
// bins -- low entropy), mid, or distributed (highly textured -- high
// entropy). Same shape as the pgm_histogram_entropy buckets so the
// perception path stays consistent.
fn lbp_texture_label(entropy_milli) {
    if entropy_milli < 3000 { return "image_lbp_texture_peaked" }
    if entropy_milli > 6000 { return "image_lbp_texture_distributed" }
    return "image_lbp_texture_mid"
}

// ---- chat-orchestration helper -------------------------------------------
//
// lbp_pgm_args(arg) -> formatted result string for the chat /lbp admin
// command. arg is everything after `/lbp ` (a single PGM path).
//
// Output shapes:
//   (/lbp needs a PATH -- usage: /lbp /tmp/test.pgm)
//   (lbp FAILED on PATH: <pgm parser error>)
//   (lbp FAILED: image too small -- need >= 8x8 for descriptor with cells=4)
//   (lbp WxH dominant_code=<C> entropy=<E_milli>)

let LBP_CHAT_MIN_DIM = 8         // 4-cell descriptor needs at least 1px/cell

fn lbp_pgm_args(arg) {
    if len(arg) == 0 {
        return "(/lbp needs a PATH -- usage: /lbp /tmp/test.pgm)"
    }
    let r_p = pgm_parse_file(arg)
    let err = pgm_result_error(r_p)
    if len(err) > 0 {
        return "(lbp FAILED on " + arg + ": " + err + ")"
    }
    let w = pgm_result_width(r_p)
    let h = pgm_result_height(r_p)
    let data = pgm_result_data(r_p)
    if w < LBP_CHAT_MIN_DIM {
        return "(lbp FAILED: image too small -- need >= 8x8)"
    }
    if h < LBP_CHAT_MIN_DIM {
        return "(lbp FAILED: image too small -- need >= 8x8)"
    }
    if w > LBP_MAX_DIM {
        return "(lbp FAILED: width " + int_to_str(w)
            + " > " + int_to_str(LBP_MAX_DIM) + " cap; downsample first)"
    }
    if h > LBP_MAX_DIM {
        return "(lbp FAILED: height " + int_to_str(h)
            + " > " + int_to_str(LBP_MAX_DIM) + " cap; downsample first)"
    }
    let dom = lbp_dominant_code(data, w, h)
    let ent = lbp_texture_entropy_milli(data, w, h)
    return "(lbp " + int_to_str(w) + "x" + int_to_str(h)
        + " dominant_code=" + int_to_str(dom)
        + " entropy=" + int_to_str(ent) + ")"
}
