// CrossEngin effectors: sandboxed code execution (P4, ADR-0054).
//
// The "compute" tool backend. Rather than shelling out (a huge attack surface),
// it evaluates a bounded arithmetic expression through the in-engine evaluator
// (src/language/arithmetic.nova) -- deterministic, side-effect-free, and safe to
// run at the AUTO permission tier (ACT_READ_LOCAL). A failed parse returns an
// unsuccessful result, which the planner records as a competence hit.
//
// ADRs: ADR-0054. CrossEngin deps: tool.nova, ../../language/arithmetic.nova.

import "tool.nova"
import "../../language/arithmetic.nova"

// Evaluate an arithmetic expression; tr.value is the milli result, tr.text its
// rendered form. ok=0 on a parse/eval failure.
fn code_exec_run(expr) {
    let r = arith_eval(expr)
    if arith_ok(r) == 1 { return tr_new(1, arith_value(r), arith_text(r)) }
    return tr_new(0, 0, "eval-error")
}
