// CrossEngin Phase 6 pt2a: minimal stdio MCP server loop.
//
// Speaks just enough JSON-RPC 2.0 to let a Claude Desktop / Cursor /
// Zed instance complete the MCP handshake and call a tool. No full
// JSON parser — we only extract two string fields (`method`, inner
// `name`) + one int (`id`) via substring search. Output is template-
// formatted JSON; no serializer needed.
//
// Supported methods:
//   initialize    -> protocolVersion 2024-11-05, capabilities.tools={}
//   tools/list    -> enumerate registered tools
//   tools/call    -> look up by name, return registered canned response
//   notifications/initialized -> accepted, no response (notification)
//   anything else -> error -32601 "Method not found"
//
// Phase 6 pt2b: hot-reloads a file registry at
// `$CE_MCP_REGISTRY` (default `$HOME/.crossengin/mcp-tools.registry`)
// so tools the chat REPL registers via `/mcp register <svc> <resp>`
// become visible to the external MCP client. The chat writes the
// file on every register; the server re-reads it on each
// `tools/list` and `tools/call` dispatch so no restart is needed.
//
// File format: one line per tool, `name|canned_response`. Description
// for file-sourced tools is the fixed string "Chat-registered MCP
// tool"; richer per-tool manifests are pt2d (deferred).
//
// Not shipped here (still deferred to pt2c-e):
//   - per-tool _gate_or_prompt capability bridging (pt2c)
//   - rich JSON tool manifests under ~/.crossengin/mcp-tools/*.json (pt2d)
//   - HTTP+SSE transport (pt2e)
//
// NOVA deps: builtins (read_line, print, println, len, str_find, substr,
//   char_at, int_to_str, str_eq_bytes, list_new, push, list_set,
//   getenv, sys_open, sys_close, alloc, load8).
// CrossEngin deps: src/util/str_safe.nova (str_eq_bytes),
//   src/util/sys_tagged.nova (_sys_read_tagged).

import "std/io"
import "std/string"
import "std/syscall"
import "../../util/str_safe.nova"
import "../../util/sys_tagged.nova"

// A tool row in the registry: [name, description, canned_response].
let MCPT_NAME     = 0
let MCPT_DESC     = 1
let MCPT_CANNED   = 2

fn mcp_srv_new() {
    // Return a list of tool rows. Empty by default.
    return list_new()
}

// Upsert a tool by name. If `name` already exists, overwrite its
// description + canned response. This makes hot-reload safe: re-adding
// a row doesn't create duplicates.
fn mcp_srv_register_tool(srv, name, description, canned_response) {
    let i = 0
    while i < len(srv) {
        if str_eq_bytes(srv[i][MCPT_NAME], name) == 1 {
            list_set(srv[i], MCPT_DESC, description)
            list_set(srv[i], MCPT_CANNED, canned_response)
            return 1
        }
        i = i + 1
    }
    let row = list_new()
    push(row, name)
    push(row, description)
    push(row, canned_response)
    push(srv, row)
    return 1
}

// Resolve the registry file path. Env override wins; otherwise fall
// back to $HOME/.crossengin/mcp-tools.registry. Returns "" if HOME
// is unset and no env override is given.
fn mcp_srv_registry_path() {
    let p = getenv("CE_MCP_REGISTRY")
    if len(p) > 0 { return p }
    let h = getenv("HOME")
    if len(h) == 0 { return "" }
    return h + "/.crossengin/mcp-tools.registry"
}

// Read the registry file and upsert each parsed row via
// mcp_srv_register_tool. Silent no-op if the file doesn't exist.
// Lines starting with '#' are comments; blank lines are skipped;
// malformed lines are silently ignored so a hand-edited file with
// a typo on one line doesn't take the whole registry down.
fn mcp_srv_load_file(srv, path) {
    if len(path) == 0 { return 0 }
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return 0 }
    let cap = 65536
    let buf = alloc(4097)
    let acc = ""
    let done = 0
    while done == 0 {
        if len(acc) >= cap { done = 1 }
        else {
            let m = _sys_read_tagged(fd, buf, 4096)
            if m <= 0 { done = 1 }
            else {
                let piece = ""
                let i = 0
                while i < m {
                    piece = piece + chr(load8(buf + i))
                    i = i + 1
                }
                acc = acc + piece
            }
        }
    }
    sys_close(fd)
    // Parse acc line-by-line.
    let n = len(acc)
    let i = 0
    let line_start = 0
    let loaded = 0
    while i <= n {
        let at_end = 0
        let ch = 0
        if i == n { at_end = 1 ch = 10 }
        if at_end == 0 { ch = char_at(acc, i) }
        if ch == 10 {
            let line = substr(acc, line_start, i - line_start)
            if len(line) > 0 {
                if char_at(line, 0) != 35 {
                    let pipe = str_find(line, "|")
                    if pipe > 0 {
                        let name = substr(line, 0, pipe)
                        let canned = substr(line, pipe + 1,
                                            len(line) - (pipe + 1))
                        if len(name) > 0 {
                            mcp_srv_register_tool(srv, name,
                                "Chat-registered MCP tool", canned)
                            loaded = loaded + 1
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    return loaded
}

// Extract the string value of `"<key>":"<value>"` from `line`.
// Returns "" if not found. Doesn't handle backslash escapes — our
// JSON-RPC methods are plain ASCII.
fn _mcp_find_str(line, key) {
    let needle = "\"" + key + "\":"
    let at = str_find(line, needle)
    if at < 0 { return "" }
    let i = at + len(needle)
    // NOVA has no `break`; use a flag loop. Skip whitespace after the colon.
    let done_ws = 0
    while done_ws == 0 {
        if i >= len(line) { done_ws = 1 }
        else {
            let c = char_at(line, i)
            if c == 32 { i = i + 1 }
            else {
                if c == 9 { i = i + 1 }
                else { done_ws = 1 }
            }
        }
    }
    if i >= len(line) { return "" }
    if char_at(line, i) != 34 { return "" }
    i = i + 1
    let start = i
    let scan = 0
    while scan == 0 {
        if i >= len(line) { return "" }
        if char_at(line, i) == 34 { scan = 1 }
        else { i = i + 1 }
    }
    return substr(line, start, i - start)
}

// Extract the integer value of `"<key>":<n>` from `line`. Returns -1
// on miss. Handles optional whitespace after the colon.
fn _mcp_find_int(line, key) {
    let needle = "\"" + key + "\":"
    let at = str_find(line, needle)
    if at < 0 { return 0 - 1 }
    let i = at + len(needle)
    let done_ws = 0
    while done_ws == 0 {
        if i >= len(line) { done_ws = 1 }
        else {
            let c = char_at(line, i)
            if c == 32 { i = i + 1 }
            else {
                if c == 9 { i = i + 1 }
                else { done_ws = 1 }
            }
        }
    }
    if i >= len(line) { return 0 - 1 }
    let c0 = char_at(line, i)
    if c0 < 48 { return 0 - 1 }
    if c0 > 57 { return 0 - 1 }
    let n = 0
    let digit = 0
    while digit == 0 {
        if i >= len(line) { digit = 1 }
        else {
            let cc = char_at(line, i)
            if cc < 48 { digit = 1 }
            else {
                if cc > 57 { digit = 1 }
                else {
                    n = n * 10 + (cc - 48)
                    i = i + 1
                }
            }
        }
    }
    return n
}

// Emit a single JSON-RPC response line. The caller precomputes the
// `result` or `error` sub-object as a string.
fn _mcp_emit_response(id, result_or_error_body) {
    // No-id: notification; don't respond.
    if id < 0 { return 1 }
    let line = "{\"jsonrpc\":\"2.0\",\"id\":" + int_to_str(id)
             + "," + result_or_error_body + "}"
    println(line)
    return 1
}

fn _mcp_initialize_result() {
    return "\"result\":{"
         + "\"protocolVersion\":\"2024-11-05\","
         + "\"capabilities\":{\"tools\":{}},"
         + "\"serverInfo\":{\"name\":\"crossengin-mcp\",\"version\":\"0.1\"}"
         + "}"
}

fn _mcp_tools_list_result(srv) {
    let s = "\"result\":{\"tools\":["
    let i = 0
    while i < len(srv) {
        if i > 0 { s = s + "," }
        let row = srv[i]
        s = s + "{"
          + "\"name\":\"" + row[MCPT_NAME] + "\","
          + "\"description\":\"" + row[MCPT_DESC] + "\","
          + "\"inputSchema\":{\"type\":\"object\",\"properties\":{}}"
          + "}"
        i = i + 1
    }
    s = s + "]}"
    return s
}

fn _mcp_tool_find(srv, name) {
    let i = 0
    while i < len(srv) {
        let row = srv[i]
        if str_eq_bytes(row[MCPT_NAME], name) == 1 { return row }
        i = i + 1
    }
    return 0
}

fn _mcp_tools_call_result(row) {
    return "\"result\":{\"content\":["
         + "{\"type\":\"text\",\"text\":\"" + row[MCPT_CANNED] + "\"}"
         + "],\"isError\":false}"
}

fn _mcp_error(code, message) {
    return "\"error\":{"
         + "\"code\":" + int_to_str(code) + ","
         + "\"message\":\"" + message + "\""
         + "}"
}

// Route one JSON-RPC line. Writes the response via println(), or
// nothing if the line was a notification. Returns 1 on continue, 0
// on protocol-level shutdown (currently never — EOF closes the loop).
fn _mcp_srv_dispatch(srv, line) {
    let method = _mcp_find_str(line, "method")
    if len(method) == 0 { return 1 }
    let id = _mcp_find_int(line, "id")
    if str_eq_bytes(method, "initialize") == 1 {
        return _mcp_emit_response(id, _mcp_initialize_result())
    }
    if str_eq_bytes(method, "notifications/initialized") == 1 {
        // notification, no response
        return 1
    }
    if str_eq_bytes(method, "tools/list") == 1 {
        mcp_srv_load_file(srv, mcp_srv_registry_path())
        return _mcp_emit_response(id, _mcp_tools_list_result(srv))
    }
    if str_eq_bytes(method, "tools/call") == 1 {
        mcp_srv_load_file(srv, mcp_srv_registry_path())
        let name = _mcp_find_str(line, "name")
        if len(name) == 0 {
            return _mcp_emit_response(id,
                _mcp_error(0 - 32602, "Missing tool name"))
        }
        let row = _mcp_tool_find(srv, name)
        if row == 0 {
            return _mcp_emit_response(id,
                _mcp_error(0 - 32602, "Unknown tool: " + name))
        }
        return _mcp_emit_response(id, _mcp_tools_call_result(row))
    }
    return _mcp_emit_response(id, _mcp_error(0 - 32601, "Method not found"))
}

// Main loop: read newline-delimited JSON-RPC frames from stdin until
// EOF. Loads the registry file once at entry so a cold start sees
// chat-registered tools without waiting for the first tools/list.
// For each line, route to _mcp_srv_dispatch which emits the response
// (or nothing for notifications). tools/list and tools/call reload
// the file inline so hot updates propagate without a restart.
fn mcp_srv_run(srv) {
    mcp_srv_load_file(srv, mcp_srv_registry_path())
    let done = 0
    while done == 0 {
        let line = read_line()
        if len(line) == 0 { done = 1 }
        else { _mcp_srv_dispatch(srv, line) }
    }
    return 1
}
