// CrossEngin effectors: MCP-style connector (P4, ADR-0054).
//
// A tool backend for reaching external services through an MCP-shaped
// request/response (service, method, request) -> response. A production
// connector speaks the MCP JSON protocol over a transport; here a service is
// bound to a canned response so the agent can be exercised end-to-end offline,
// and the transport is a documented seam. Treated as ACT_NET_FETCH by the gate.
//
// ADRs: ADR-0054. CrossEngin deps: tool.nova.

import "tool.nova"
import "../../util/str_safe.nova"

// ---- service registry (name -> canned response) ---------------------------
fn mcp_registry_new() { return list_new() }

fn mcp_register(reg, service, response) {
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(reg[i][0], service) == 1 { list_set(reg[i], 1, response) return 1 }
        i = i + 1
    }
    let e = list_new(); push(e, service); push(e, response)
    push(reg, e)
    return 1
}

fn _mcp_lookup(reg, service) {
    let i = 0
    while i < len(reg) {
        if str_eq_bytes(reg[i][0], service) == 1 { return reg[i][1] }
        i = i + 1
    }
    return ""
}

// Call a registered service. Unknown service -> unsuccessful result.
fn mcp_call(reg, service, method, request) {
    let resp = _mcp_lookup(reg, service)
    if len(resp) == 0 { return tr_new(0, 0, "unknown-service") }
    return tr_new(1, len(resp), resp)
}

// Single-shot call against a directly-supplied canned response (the form the
// tool dispatcher uses: the tool's config IS the bound response).
fn mcp_call_direct(service, request, canned) {
    if len(service) == 0 { return tr_new(0, 0, "no-service") }
    return tr_new(1, len(canned), canned)
}
