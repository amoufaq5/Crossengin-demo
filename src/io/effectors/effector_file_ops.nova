// CrossEngin effectors: sandboxed file read/write (P4, ADR-0054).
//
// The "write"/"read" tool backend. Writes are ACT_WRITE_LOCAL (NOTIFY tier).
// Every path is confined to a fixed sandbox prefix; anything outside it is
// refused before touching the filesystem, so a tool plan cannot escape into
// arbitrary paths. (The permission tier is enforced separately by tool_gate;
// this prefix check is defense in depth on the path itself.)
//
// ADRs: ADR-0054, ADR-0042 (reversibility). CrossEngin deps: tool.nova.
// NOVA deps: write_file / read_file builtins.

import "tool.nova"

// Only paths under this prefix may be touched.
let FO_SANDBOX_PREFIX = "/tmp/ce_tool_"

fn _fo_has_prefix(path, pre) {
    let n = len(pre)
    if len(path) < n { return 0 }
    let i = 0
    while i < n {
        if char_at(path, i) != char_at(pre, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn file_ops_in_sandbox(path) { return _fo_has_prefix(path, FO_SANDBOX_PREFIX) }

fn file_ops_write(path, content) {
    if file_ops_in_sandbox(path) == 0 { return tr_new(0, 0, "path-outside-sandbox") }
    write_file(path, content)
    return tr_new(1, len(content), "wrote " + int_to_str(len(content)) + " bytes")
}

fn file_ops_read(path) {
    if file_ops_in_sandbox(path) == 0 { return tr_new(0, 0, "path-outside-sandbox") }
    let data = read_file(path)
    return tr_new(1, len(data), data)
}
