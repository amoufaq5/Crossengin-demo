// CrossEngin io/effectors: pure-substrate output generation.
//
// Purpose
//   The mirror image of the reader (ADR-0013): produce language by the REVERSE
//   flow of comprehension, with NO LLM (ADR-0014). A communicative intent -- an
//   ordered set of role->concept assignments produced by the reasoning/goal
//   loops -- is resolved to real word atoms (ADR-0015), sequenced by a learned
//   syntax-pattern atom, and emitted as text. Fluency comes from the substrate,
//   not a model: (a) well-formed sequences are high-weight syntax atoms that win
//   pattern selection; (b) patterns that do not fit the intent are pruned; (c)
//   Hebbian/error plasticity (ADR-0007) strengthens phrasings that succeed and
//   weakens rejected ones, so phrasing is learned and personalized.
//
//   "Active concepts -> language nodes" is realized here over the language KG:
//   each intent filler is a lemma interned to its word atom, so produced
//   vocabulary is always real language atoms (same atoms the reader anchors to).
//   Phoneme/TTS rendering is the modality bridge seam (ADR-0014), never word
//   choice.
//
// ADRs implemented: ADR-0013 (output generation), ADR-0015 (word/syntax atoms),
//   ADR-0007/0023 (learned fluency via plasticity). NOVA dependencies: builtins.
// CrossEngin dependencies: src/language/syntax_atoms.nova (-> word_atoms -> kg),
//   src/reader/slot_index.nova (P2.2 -- optional role-fill hook for the
//   syntactic-slot similarity surface; callers without an index pass 0).

import "../../language/syntax_atoms.nova"
import "../../reader/slot_index.nova"

// Resolve a communicative intent to syntax fillers. intent is a list of
// [role, lemma]; each lemma is interned to a real word atom (so produced words
// are real language atoms). Returns a list of [role, word_atom] assignments.
fn gen_resolve(lang_kg, intent, moment) {
    return gen_resolve_with_slot(lang_kg, intent, moment, 0, 0)
}

// P2.2 additive overload: same as gen_resolve, but ALSO records each
// (pattern, role, word_atom) into the slot side-index `si` if both `si` and
// `pattern` are non-zero. Used by the daemon / chat to grow the slot
// similarity surface organically: every time the agent generates output, the
// words it placed into each role of the chosen pattern get a +1 in that
// (pattern, role) histogram. Two atoms that have co-filled the same role in
// the same pattern then surface as role-neighbors via find_neighbors_full.
//
// `pattern` is the syntax atom whose role-set is being filled. We pass it in
// AHEAD of gen_best_pattern's selection in callers that already know the
// pattern (e.g. the chat's intent->pattern dispatch); for the standard
// gen_from_intent path, the slot recording happens AFTER pattern selection
// via gen_record_slots() below. We support BOTH callsites without changing
// the public 3-arg gen_resolve.
fn gen_resolve_with_slot(lang_kg, intent, moment, si, pattern) {
    let fillers = list_new()
    let i = 0
    while i < len(intent) {
        let role = intent[i][0]
        let lemma = intent[i][1]
        let w = word_intern(lang_kg, lemma, moment)
        let pair = list_new()
        push(pair, role)
        push(pair, w)
        push(fillers, pair)
        if si != 0 {
            if pattern != 0 {
                if w != 0 {
                    si_record_fill(si, atom_id(pattern), role, atom_id(w))
                }
            }
        }
        i = i + 1
    }
    return fillers
}

// Record an already-resolved [role, word_atom] filler list against a chosen
// pattern in the slot side-index. Idempotent-friendly: each call bumps the
// per-(pattern, role) histogram by exactly one count per filler. Used by
// gen_from_intent_with_slot below so the slot recording fires AFTER the
// best-pattern selection (the path most callers take).
fn gen_record_slots(si, pattern, fillers) {
    if si == 0 { return 0 }
    if pattern == 0 { return 0 }
    if fillers == 0 { return 0 }
    let pid = atom_id(pattern)
    let i = 0
    let n = 0
    while i < len(fillers) {
        let role = fillers[i][0]
        let w = fillers[i][1]
        if w != 0 {
            si_record_fill(si, pid, role, atom_id(w))
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Choose the best syntax pattern for an intent's fillers. A pattern that the
// intent COMPLETES (supplies every role) wins outright; among the rest, the one
// that fills the most slots wins; reliability (the atom's belief) breaks ties.
// This is the substrate's "well-formed high-weight path wins, ill-formed
// pruned" (ADR-0013).
fn gen_best_pattern(candidates, fillers) {
    let best = 0
    let best_score = 0 - 1
    let i = 0
    while i < len(candidates) {
        let c = candidates[i]
        let fillable = len(syntax_apply(c, fillers))
        let score = fillable * 2000 + syntax_confidence(c)
        if syntax_complete(c, fillers) == 1 { score = score + 1000000 }
        if score > best_score {
            best_score = score
            best = c
        }
        i = i + 1
    }
    return best
}

// Order the fillers by a pattern, yielding the ordered list of word atoms.
fn gen_sequence(pattern, fillers) {
    return syntax_apply(pattern, fillers)
}

// Render an ordered list of word atoms to text (their real surface forms).
fn gen_emit(word_atoms) {
    let out = ""
    let i = 0
    while i < len(word_atoms) {
        if i > 0 { out = out + " " }
        out = out + word_form(word_atoms[i])
        i = i + 1
    }
    return out
}

// Cold-start fallback (ADR-0013): with no fitting syntax atom yet, emit the
// intent's lemmas in their given order (still interned to real word atoms). This
// is the template scaffolding the learned syntax layer replaces over time.
fn _gen_emit_intent(lang_kg, intent, moment) {
    let out = ""
    let i = 0
    while i < len(intent) {
        let w = word_intern(lang_kg, intent[i][1], moment)
        if i > 0 { out = out + " " }
        out = out + word_form(w)
        i = i + 1
    }
    return out
}

// Full downward generation: intent -> fillers -> best pattern -> ordered words
// -> text. On a successful pattern, strengthen it and the words it used
// (Hebbian, ADR-0007) so the phrasing is reinforced. Falls back to the
// cold-start ordering when no pattern fits.
fn gen_from_intent(lang_kg, candidates, intent, moment) {
    return gen_from_intent_with_slot(lang_kg, candidates, intent, moment, 0)
}

// P2.2 additive overload: same as gen_from_intent, but ALSO records each
// filler against the chosen pattern in the slot side-index `si`. Pass si=0
// for legacy behavior. Returns the same string the legacy form returns.
fn gen_from_intent_with_slot(lang_kg, candidates, intent, moment, si) {
    let fillers = gen_resolve(lang_kg, intent, moment)
    let pattern = gen_best_pattern(candidates, fillers)
    if pattern == 0 { return _gen_emit_intent(lang_kg, intent, moment) }
    let seq = gen_sequence(pattern, fillers)
    if len(seq) == 0 { return _gen_emit_intent(lang_kg, intent, moment) }
    syntax_observe(pattern, 1)
    let i = 0
    while i < len(seq) {
        word_observe(seq[i], 1)
        i = i + 1
    }
    // Slot recording fires AFTER pattern selection so the histogram only
    // accumulates fillers we ACTUALLY used (a candidate pattern we considered
    // but didn't pick contributes nothing).
    if si != 0 {
        gen_record_slots(si, pattern, fillers)
    }
    return gen_emit(seq)
}

// User-acceptance learning (ADR-0013 source c / ADR-0007): reinforce a phrasing
// the user accepted (accepted=1) or weaken one they rejected (accepted=0),
// adjusting both the syntax pattern and the words used.
fn gen_feedback(pattern, word_atoms, accepted) {
    let sign = 0 - 1
    if accepted == 1 { sign = 1 }
    syntax_observe(pattern, sign)
    let i = 0
    while i < len(word_atoms) {
        word_observe(word_atoms[i], sign)
        i = i + 1
    }
    return 1
}

// Convenience: number of words an intent would emit under a pattern (0 if the
// pattern does not apply) -- used to compare candidate phrasings.
fn gen_length_under(pattern, fillers) {
    return len(syntax_apply(pattern, fillers))
}

// Reverse sense lookup (ADR-0013 generation glue): given a concept atom in some
// domain KG, find the word atom in the language KG whose strongest sense names
// it. This is what lets output generation speak from cognition -- a reasoning
// conclusion is mapped back to a real word and then sequenced + emitted -- with
// no LLM picking the wording. When multiple words reference the same concept
// (polysemy backwards), the highest-weight sense wins. Returns 0 if no word in
// the language KG references the concept.
fn gen_word_for_concept(lang_kg, concept_kg_id, concept_atom_id) {
    let atoms = kg_atoms(lang_kg)
    let best = 0
    let best_w = 0 - 1
    let i = 0
    while i < len(atoms) {
        let a = atoms[i]
        if is_word_atom(a) == 1 {
            let xrefs = atom_xrefs(a)
            let j = 0
            while j < len(xrefs) {
                let x = xrefs[j]
                if xref_dst_kg(x) == concept_kg_id {
                    if xref_dst_atom(x) == concept_atom_id {
                        if xref_weight(x) > best_w {
                            best_w = xref_weight(x)
                            best = a
                        }
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return best
}
