// CrossEngin Phase 6 pt2e: MCP over HTTP (Streamable HTTP transport).
//
// Serves the same registry + JSON-RPC dispatch as the stdio server
// (mcp_server_stdio.nova) on http://127.0.0.1:PORT/mcp, in the simplest
// form the Streamable HTTP transport allows:
//   POST /mcp, JSON-RPC request       -> 200 application/json + response
//   POST /mcp, notification           -> 202 Accepted, empty body
//   GET  /mcp (or any other method)   -> 405, Allow: POST
//                                        (no server-initiated SSE stream)
//   any other path                    -> 404
//   Origin header not localhost       -> 403 (DNS-rebinding guard)
//
// Serial and blocking: one request per connection, Connection: close.
// Binds 127.0.0.1 only and has no auth; put a reverse proxy with auth in
// front of it before exposing it beyond the local machine.
//
// CrossEngin deps: mcp_server_stdio.nova (registry + _mcp_srv_dispatch),
//   ../transducers/stream_http.nova (_stream_http_read_request,
//   _stream_http_send_all, _stream_http_get_header, _stream_http_ip_to_int).

import "std/io"
import "std/string"
import "std/syscall"
import "../../util/str_safe.nova"
import "mcp_server_stdio.nova"
import "../transducers/stream_http.nova"

fn _mcp_http_send(fd, status_line, content_type, extra_headers, body) {
    let resp = "HTTP/1.1 " + status_line + "\r\n"
    if len(content_type) > 0 {
        resp = resp + "Content-Type: " + content_type + "\r\n"
    }
    resp = resp + extra_headers
        + "Content-Length: " + int_to_str(len(body)) + "\r\n"
        + "Connection: close\r\n\r\n"
        + body
    return _stream_http_send_all(fd, resp)
}

// 1 if `origin` is exactly `prefix` or `prefix` followed by ':' or '/'.
// The boundary check stops http://localhost.evil.example from matching.
fn _mcp_http_origin_is(origin, prefix) {
    if starts_with(origin, prefix) == 0 { return 0 }
    let n = len(prefix)
    if len(origin) == n { return 1 }
    let c = char_at(origin, n)
    if c == 58 { return 1 }
    if c == 47 { return 1 }
    return 0
}

// No Origin header (curl, native MCP clients) is allowed; a browser-sent
// Origin must point at this machine.
fn _mcp_http_origin_ok(headers) {
    let origin = _stream_http_get_header(headers, "Origin")
    if origin == 0 { return 1 }
    if _mcp_http_origin_is(origin, "http://localhost") == 1 { return 1 }
    if _mcp_http_origin_is(origin, "https://localhost") == 1 { return 1 }
    if _mcp_http_origin_is(origin, "http://127.0.0.1") == 1 { return 1 }
    if _mcp_http_origin_is(origin, "https://127.0.0.1") == 1 { return 1 }
    return 0
}

fn _mcp_http_handle(srv, conn) {
    let req = _stream_http_read_request(conn)
    if req == 0 {
        return _mcp_http_send(conn, "400 Bad Request", "text/plain", "",
                              "malformed request")
    }
    let method = req[0]
    let path = req[1]
    if str_eq_bytes(path, "/mcp") == 0 {
        return _mcp_http_send(conn, "404 Not Found", "text/plain", "",
                              "not found")
    }
    if _mcp_http_origin_ok(req[3]) == 0 {
        return _mcp_http_send(conn, "403 Forbidden", "text/plain", "",
                              "origin not allowed")
    }
    if str_eq_bytes(method, "POST") == 0 {
        return _mcp_http_send(conn, "405 Method Not Allowed", "text/plain",
                              "Allow: POST\r\n", "method not allowed")
    }
    let resp = _mcp_srv_dispatch(srv, req[2])
    if len(resp) == 0 {
        return _mcp_http_send(conn, "202 Accepted", "", "", "")
    }
    return _mcp_http_send(conn, "200 OK", "application/json", "", resp)
}

// Bind 127.0.0.1:port and serve forever. Returns 0 if the socket can't be
// set up (port in use, sockets denied), so the caller can report it.
fn mcp_http_run(srv, port) {
    mcp_srv_load_file(srv, mcp_srv_registry_path())
    let fd = socket(2, 1, 0)
    if fd < 0 { return 0 }
    sys_setsockopt_so_reuseaddr(fd)
    let addr = make_sockaddr_in(port, _stream_http_ip_to_int("127.0.0.1"))
    if bind_socket(fd, addr, 16) < 0 {
        close_fd(fd)
        return 0
    }
    if listen_socket(fd, 8) < 0 {
        close_fd(fd)
        return 0
    }
    println("crossengin-mcp: listening on http://127.0.0.1:"
            + int_to_str(port) + "/mcp")
    while 1 == 1 {
        let conn = accept_conn(fd, 0, 0)
        if conn >= 0 {
            _mcp_http_handle(srv, conn)
            close_fd(conn)
        }
    }
    return 1
}
