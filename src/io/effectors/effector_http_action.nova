// CrossEngin effectors: outbound HTTP action (P4, ADR-0054).
//
// The "search" / API-call tool backend (ACT_NET_FETCH, NOTIFY tier). A real
// call is the gated transport already in the tree (learn_pipeline.lp_fetch:
// DNS + whitelist + rate-limit + TLS). To keep tests hermetic/offline, the
// SIMULATED mode (the DEFAULT) returns a caller-supplied canned response, and
// the planner runs it simulated. The live path is now WIRED (ADR-0054 "Honest
// gaps" P4 follow-up): with simulated == 0, http_action_run goes through
// lp_fetch and returns the fetched body behind the same [ok, value, text]
// result shape. Errors (bad url, DNS, gate, transport) are guarded into an
// unsuccessful tr_new(0, ...) so a failing fetch lowers the tool's competence
// rather than crashing the plan.
//
//   Why importing learn_pipeline here is safe: nothing in its dependency tree
//   (DNS / TLS / internet_fetch / preprocess / multi_kg_manager) imports the
//   tool or effector layer, so there is no import cycle; and the simulated
//   default never calls lp_fetch, so the offline tests touch none of that
//   stack at runtime. A pure seam, http_action_run_live(url, fetched_body), is
//   also exposed for callers that want to do the gated fetch themselves (or in
//   a context where the TLS/DNS stack must not be linked) and hand the body in.
//
// ADRs: ADR-0054, ADR-0028 (gated fetch). CrossEngin deps: tool.nova,
//   learn_pipeline.nova (live transport).

import "tool.nova"
import "../../learning/learn_pipeline.nova"

// Run an outbound HTTP action and return the body as a tool result.
//   simulated == 1 (DEFAULT for the planner/tests): return the canned body
//     (offline, deterministic) -- no network, no learn_pipeline at runtime.
//   simulated == 0 (live): fetch the url through the gated lp_fetch transport
//     (DNS + whitelist + rate-limit + http/TLS) and return the raw body. Any
//     fetch failure is guarded into an unsuccessful result.
// `now` for the live path defaults to 0 here (callers needing a real clock /
// rate-limit window should use http_action_run_at).
fn http_action_run(url, simulated, canned) {
    return http_action_run_at(url, simulated, canned, 0)
}

// As http_action_run, but with an explicit logical clock `now` for the live
// fetch (lp_fetch's rate limiter is keyed on it).
fn http_action_run_at(url, simulated, canned, now) {
    if len(url) == 0 { return tr_new(0, 0, "no-url") }
    if simulated == 1 { return tr_new(1, len(canned), canned) }
    // Live: route through the gated transport. Guard every failure mode.
    let f = lp_fetch(url, now)
    if lp_fetch_status(f) != LP_OK {
        return tr_new(0, lp_fetch_http(f), "http-error:" + lp_fetch_message(f))
    }
    let body = lp_fetch_body(f)
    return tr_new(1, len(body), body)
}

// Pure seam: the caller has already performed the gated fetch (or is in a
// context that must not link the TLS/DNS stack) and supplies the fetched body.
// Returns it as a successful tool result; an empty body is an unsuccessful
// result so the planner does not thread a hollow value forward.
fn http_action_run_live(url, fetched_body) {
    if len(url) == 0 { return tr_new(0, 0, "no-url") }
    if len(fetched_body) == 0 { return tr_new(0, 0, "empty-body") }
    return tr_new(1, len(fetched_body), fetched_body)
}
