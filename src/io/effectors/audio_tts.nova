// CrossEngin io/effectors: text-to-speech pipeline.
//
// Purpose
//   The TTS leg of the audio chain. CrossEngin already has speech IN (R8B
//   whisper / R10B vosk STT) and a usable speech-synthesis floor (R6E
//   Klatt with a 44-phoneme ARPAbet inventory). What was missing was a
//   COMPLETE TTS pipeline: text -> phoneme sequence -> synthesized audio.
//   The G2P (grapheme-to-phoneme) step in the middle is what this module
//   adds; it then delegates the per-phoneme PCM synthesis to R6E's
//   `synth_phoneme(label)` and wraps the result in a fresh WAV header.
//
//   English G2P is the classic spelling-vs-pronunciation problem -- "ough"
//   has eight distinct pronunciations across "through / though / cough /
//   rough / bough / thought / borough / hiccough". Real systems ship a
//   ~125K-word CMUdict + neural fallback. CE ships:
//
//     1. A small hand-curated dictionary of ~120 common English words with
//        their canonical ARPAbet-ish phoneme sequences (greetings, pronouns,
//        function words, numbers, the test fixtures the brief asks for like
//        "hello world"). Dictionary lookup is O(n) scan; n is tiny so the
//        cost is irrelevant. Case is folded to lower for the lookup.
//
//     2. A rule-based fallback for unknown words. Walks the word left-to-
//        right, greedily matching the longest digraph/trigraph first (sh /
//        th / ch / ng / oo / ee / ai / ay / oh / oa / ou / ie ...), falling
//        through to single-letter rules (a -> ae, e -> eh, i -> ih, o -> ao,
//        u -> ah, plus consonants mapped to their single-phoneme namesake).
//        Silent-e is handled (cake -> K EY K not K EY K EH); silent letters
//        in common clusters (kn -> N, wr -> R) are stripped.
//
//   The fallback is not high-quality (it can't disambiguate "lead" the verb
//   from "lead" the metal) but it never crashes and produces an audible
//   approximation of any input.
//
//   Public API:
//     tts_g2p(text) -> list[phoneme_label]
//         Tokenize text on whitespace; for each word run G2P; concatenate.
//         Word boundaries are NOT marked in the returned list -- callers
//         that need them should call tts_g2p_word per-word.
//
//     tts_g2p_word(word) -> list[phoneme_label]
//         The per-word G2P kernel; dictionary first, then rule fallback.
//
//     tts_synth_phonemes(phonemes, sample_rate) -> wav_bytes
//         Concatenate synth_phoneme(label) per phoneme; insert a brief
//         silence between WORD boundaries (caller indicates word breaks by
//         the empty-string phoneme "_brk_"). Wrap the PCM in a 44-byte
//         RIFF/WAVE header at the requested sample_rate. Returned as a
//         list[int] of bytes.
//
//     tts_speak(text, sample_rate) -> wav_bytes
//         End-to-end: tts_g2p_marked(text) (which inserts "_brk_" between
//         words) then tts_synth_phonemes(...). Empty input -> empty WAV
//         (44-byte header with data_size=0).
//
//     tts_save_wav(wav_bytes, path) -> 1 on success, 0 on failure
//         Writes the byte list to disk via sys_write + sys_fsync (same
//         durability contract as audio_synth.nova's audio_write_wav).
//
//   Sample-rate handling: R6E's `synth_phoneme()` always produces 1200
//   samples at 8000 Hz (its hardcoded AUDIO_PHONEME_SAMPLES x
//   AUDIO_SAMPLE_RATE invariants). When the caller requests a different
//   sample_rate, we still synthesize at 8000 Hz internally and write the
//   REQUESTED rate into the WAV header. Most players resample on the fly;
//   the audible effect is the synth playing back faster or slower (e.g. at
//   16000 Hz it plays in half the time at double pitch). A future
//   resampler (R??) would do proper interpolation here; for now the
//   header field is the only thing that varies. Determinism is preserved:
//   same text + same sample_rate -> bit-identical bytes.
//
//   The brief-stipulated /say chat command (in examples/crossengin_chat.nova)
//   calls tts_speak() then tts_save_wav("/tmp/tts_out.wav") then best-effort
//   plays via paplay; if paplay is missing it falls through quietly (the
//   WAV is the load-bearing artifact).
//
// ADRs implemented: ADR-0014 (modality bridge -- TTS leg complements the
//   STT leg in stt_seam.nova). NOVA dependencies: builtins (alloc / store8 /
//   list_*) + sys_open / sys_write / sys_fsync / sys_close from std/syscall.
//   CrossEngin dependencies: src/io/effectors/audio_synth.nova (per-phoneme
//   PCM synthesis + LE wav header helpers).

import "std/syscall"
import "audio_synth.nova"
import "../../util/str_safe.nova"

// ---- constants -----------------------------------------------------------

let TTS_DEFAULT_SAMPLE_RATE = 16000     // common ASR target; R6E synth runs
                                        // at 8000 internally regardless
let TTS_WORD_BREAK_SAMPLES = 480        // ~60 ms silence between words at
                                        // 8000 Hz; long enough to be heard
                                        // but not break word recognition

// Sentinel phoneme label that tts_synth_phonemes recognizes as a word
// boundary. Synthesized as TTS_WORD_BREAK_SAMPLES of zero PCM.
let TTS_BREAK_LABEL = "_brk_"

// ---- case folding --------------------------------------------------------
//
// NOVA has no built-in tolower; we walk the string and map ASCII A..Z
// (65..90) into a..z (97..122). Anything else passes through unchanged
// (apostrophes, hyphens, digits, non-ASCII bytes).

fn _tts_tolower(s) {
    let out = ""
    let n = len(s)
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c >= 65 && c <= 90 {
            // Append the lowercase character. NOVA's `+` on strings appends
            // by byte; substr(s, i, 1) is the canonical "one-char" extract,
            // but we want the case-folded version, not the original byte.
            // Build a one-char buffer by allocating and decoding via
            // substr against a fixed-source string. Cheaper: append the
            // lowercase char via int_to_str? No -- int_to_str gives the
            // decimal repr. We use a 26-char lookup table.
            out = out + _tts_lower_char(c)
        } else {
            out = out + substr(s, i, 1)
        }
        i = i + 1
    }
    return out
}

// Map an upper-case ASCII code (65..90) to its single-char lower-case
// string. Returns "" on out-of-range (caller is expected to range-check).
fn _tts_lower_char(c) {
    let lc = "abcdefghijklmnopqrstuvwxyz"
    let idx = c - 65
    if idx < 0 { return "" }
    if idx >= 26 { return "" }
    return substr(lc, idx, 1)
}

// ---- tokenization --------------------------------------------------------
//
// Split text on whitespace AND common punctuation (.,!?:;). Empty tokens
// are dropped. Case is preserved here -- per-word G2P folds case at the
// lookup boundary.

fn _tts_is_separator(c) {
    if c == 32 { return 1 }     // space
    if c == 9  { return 1 }     // tab
    if c == 10 { return 1 }     // newline
    if c == 13 { return 1 }     // CR
    if c == 46 { return 1 }     // .
    if c == 44 { return 1 }     // ,
    if c == 33 { return 1 }     // !
    if c == 63 { return 1 }     // ?
    if c == 58 { return 1 }     // :
    if c == 59 { return 1 }     // ;
    return 0
}

fn tts_tokenize(text) {
    let out = list_new()
    let n = len(text)
    let i = 0
    let cur = ""
    while i < n {
        let c = char_at(text, i)
        if _tts_is_separator(c) == 1 {
            if len(cur) > 0 {
                push(out, cur)
                cur = ""
            }
        } else {
            cur = cur + substr(text, i, 1)
        }
        i = i + 1
    }
    if len(cur) > 0 { push(out, cur) }
    return out
}

// ---- G2P dictionary ------------------------------------------------------
//
// Curated ~120-entry table of common English words with their ARPAbet-ish
// phoneme sequences. Labels are lowercase to match R6E's
// `_phoneme_formants` dispatcher (HH not H but R6E accepts both via the
// h/hh aliases). All phonemes returned here must be members of the
// `klatt_phoneme_labels()` set so synth_phoneme() can render them.
//
// The dictionary is implemented as a single if-chain returning a list of
// phoneme strings. Simple, debuggable, easy to extend. ~120 entries keeps
// the chain under R6E's pattern (which has 53 phoneme dispatches in the
// same shape).

fn _tts_dict_lookup(word_lower) {
    let s = word_lower
    let out = list_new()
    // ---- greetings + common interjections ---------------------------
    if str_eq_bytes(s, "hello")   == 1 { push(out, "hh") push(out, "eh") push(out, "l") push(out, "ow") return out }
    if str_eq_bytes(s, "hi")      == 1 { push(out, "hh") push(out, "ay") return out }
    if str_eq_bytes(s, "hey")     == 1 { push(out, "hh") push(out, "ey") return out }
    if str_eq_bytes(s, "bye")     == 1 { push(out, "b") push(out, "ay") return out }
    if str_eq_bytes(s, "yes")     == 1 { push(out, "y") push(out, "eh") push(out, "s") return out }
    if str_eq_bytes(s, "no")      == 1 { push(out, "n") push(out, "ow") return out }
    if str_eq_bytes(s, "ok")      == 1 { push(out, "ow") push(out, "k") push(out, "ey") return out }
    if str_eq_bytes(s, "okay")    == 1 { push(out, "ow") push(out, "k") push(out, "ey") return out }
    if str_eq_bytes(s, "thanks")  == 1 { push(out, "th") push(out, "ae") push(out, "ng") push(out, "k") push(out, "s") return out }
    if str_eq_bytes(s, "please")  == 1 { push(out, "p") push(out, "l") push(out, "iy") push(out, "z") return out }
    if str_eq_bytes(s, "sorry")   == 1 { push(out, "s") push(out, "ao") push(out, "r") push(out, "iy") return out }
    // ---- pronouns ----------------------------------------------------
    if str_eq_bytes(s, "i")       == 1 { push(out, "ay") return out }
    if str_eq_bytes(s, "me")      == 1 { push(out, "m") push(out, "iy") return out }
    if str_eq_bytes(s, "my")      == 1 { push(out, "m") push(out, "ay") return out }
    if str_eq_bytes(s, "you")     == 1 { push(out, "y") push(out, "uw") return out }
    if str_eq_bytes(s, "your")    == 1 { push(out, "y") push(out, "uh") push(out, "r") return out }
    if str_eq_bytes(s, "we")      == 1 { push(out, "w") push(out, "iy") return out }
    if str_eq_bytes(s, "our")     == 1 { push(out, "aw") push(out, "r") return out }
    if str_eq_bytes(s, "he")      == 1 { push(out, "hh") push(out, "iy") return out }
    if str_eq_bytes(s, "him")     == 1 { push(out, "hh") push(out, "ih") push(out, "m") return out }
    if str_eq_bytes(s, "his")     == 1 { push(out, "hh") push(out, "ih") push(out, "z") return out }
    if str_eq_bytes(s, "she")     == 1 { push(out, "sh") push(out, "iy") return out }
    if str_eq_bytes(s, "her")     == 1 { push(out, "hh") push(out, "er") return out }
    if str_eq_bytes(s, "it")      == 1 { push(out, "ih") push(out, "t") return out }
    if str_eq_bytes(s, "they")    == 1 { push(out, "dh") push(out, "ey") return out }
    if str_eq_bytes(s, "them")    == 1 { push(out, "dh") push(out, "eh") push(out, "m") return out }
    if str_eq_bytes(s, "this")    == 1 { push(out, "dh") push(out, "ih") push(out, "s") return out }
    if str_eq_bytes(s, "that")    == 1 { push(out, "dh") push(out, "ae") push(out, "t") return out }
    if str_eq_bytes(s, "these")   == 1 { push(out, "dh") push(out, "iy") push(out, "z") return out }
    if str_eq_bytes(s, "those")   == 1 { push(out, "dh") push(out, "ow") push(out, "z") return out }
    // ---- common function words ---------------------------------------
    if str_eq_bytes(s, "a")       == 1 { push(out, "ax") return out }
    if str_eq_bytes(s, "an")      == 1 { push(out, "ae") push(out, "n") return out }
    if str_eq_bytes(s, "the")     == 1 { push(out, "dh") push(out, "ax") return out }
    if str_eq_bytes(s, "and")     == 1 { push(out, "ae") push(out, "n") push(out, "d") return out }
    if str_eq_bytes(s, "or")      == 1 { push(out, "ao") push(out, "r") return out }
    if str_eq_bytes(s, "but")     == 1 { push(out, "b") push(out, "ah") push(out, "t") return out }
    if str_eq_bytes(s, "not")     == 1 { push(out, "n") push(out, "ao") push(out, "t") return out }
    if str_eq_bytes(s, "is")      == 1 { push(out, "ih") push(out, "z") return out }
    if str_eq_bytes(s, "are")     == 1 { push(out, "aa") push(out, "r") return out }
    if str_eq_bytes(s, "was")     == 1 { push(out, "w") push(out, "ah") push(out, "z") return out }
    if str_eq_bytes(s, "were")    == 1 { push(out, "w") push(out, "er") return out }
    if str_eq_bytes(s, "be")      == 1 { push(out, "b") push(out, "iy") return out }
    if str_eq_bytes(s, "been")    == 1 { push(out, "b") push(out, "ih") push(out, "n") return out }
    if str_eq_bytes(s, "am")      == 1 { push(out, "ae") push(out, "m") return out }
    if str_eq_bytes(s, "to")      == 1 { push(out, "t") push(out, "uw") return out }
    if str_eq_bytes(s, "of")      == 1 { push(out, "ah") push(out, "v") return out }
    if str_eq_bytes(s, "in")      == 1 { push(out, "ih") push(out, "n") return out }
    if str_eq_bytes(s, "on")      == 1 { push(out, "ao") push(out, "n") return out }
    if str_eq_bytes(s, "at")      == 1 { push(out, "ae") push(out, "t") return out }
    if str_eq_bytes(s, "for")     == 1 { push(out, "f") push(out, "ao") push(out, "r") return out }
    if str_eq_bytes(s, "with")    == 1 { push(out, "w") push(out, "ih") push(out, "th") return out }
    if str_eq_bytes(s, "from")    == 1 { push(out, "f") push(out, "r") push(out, "ah") push(out, "m") return out }
    if str_eq_bytes(s, "by")      == 1 { push(out, "b") push(out, "ay") return out }
    if str_eq_bytes(s, "as")      == 1 { push(out, "ae") push(out, "z") return out }
    if str_eq_bytes(s, "if")      == 1 { push(out, "ih") push(out, "f") return out }
    if str_eq_bytes(s, "so")      == 1 { push(out, "s") push(out, "ow") return out }
    if str_eq_bytes(s, "do")      == 1 { push(out, "d") push(out, "uw") return out }
    if str_eq_bytes(s, "did")     == 1 { push(out, "d") push(out, "ih") push(out, "d") return out }
    if str_eq_bytes(s, "does")    == 1 { push(out, "d") push(out, "ah") push(out, "z") return out }
    if str_eq_bytes(s, "have")    == 1 { push(out, "hh") push(out, "ae") push(out, "v") return out }
    if str_eq_bytes(s, "had")     == 1 { push(out, "hh") push(out, "ae") push(out, "d") return out }
    if str_eq_bytes(s, "has")     == 1 { push(out, "hh") push(out, "ae") push(out, "z") return out }
    if str_eq_bytes(s, "can")     == 1 { push(out, "k") push(out, "ae") push(out, "n") return out }
    if str_eq_bytes(s, "will")    == 1 { push(out, "w") push(out, "ih") push(out, "l") return out }
    if str_eq_bytes(s, "would")   == 1 { push(out, "w") push(out, "uh") push(out, "d") return out }
    if str_eq_bytes(s, "could")   == 1 { push(out, "k") push(out, "uh") push(out, "d") return out }
    if str_eq_bytes(s, "should")  == 1 { push(out, "sh") push(out, "uh") push(out, "d") return out }
    // ---- common nouns + verbs ----------------------------------------
    if str_eq_bytes(s, "world")   == 1 { push(out, "w") push(out, "er") push(out, "l") push(out, "d") return out }
    if str_eq_bytes(s, "time")    == 1 { push(out, "t") push(out, "ay") push(out, "m") return out }
    if str_eq_bytes(s, "day")     == 1 { push(out, "d") push(out, "ey") return out }
    if str_eq_bytes(s, "night")   == 1 { push(out, "n") push(out, "ay") push(out, "t") return out }
    if str_eq_bytes(s, "good")    == 1 { push(out, "g") push(out, "uh") push(out, "d") return out }
    if str_eq_bytes(s, "bad")     == 1 { push(out, "b") push(out, "ae") push(out, "d") return out }
    if str_eq_bytes(s, "test")    == 1 { push(out, "t") push(out, "eh") push(out, "s") push(out, "t") return out }
    if str_eq_bytes(s, "this")    == 1 { push(out, "dh") push(out, "ih") push(out, "s") return out }
    if str_eq_bytes(s, "speak")   == 1 { push(out, "s") push(out, "p") push(out, "iy") push(out, "k") return out }
    if str_eq_bytes(s, "say")     == 1 { push(out, "s") push(out, "ey") return out }
    if str_eq_bytes(s, "make")    == 1 { push(out, "m") push(out, "ey") push(out, "k") return out }
    if str_eq_bytes(s, "take")    == 1 { push(out, "t") push(out, "ey") push(out, "k") return out }
    if str_eq_bytes(s, "give")    == 1 { push(out, "g") push(out, "ih") push(out, "v") return out }
    if str_eq_bytes(s, "go")      == 1 { push(out, "g") push(out, "ow") return out }
    if str_eq_bytes(s, "come")    == 1 { push(out, "k") push(out, "ah") push(out, "m") return out }
    if str_eq_bytes(s, "know")    == 1 { push(out, "n") push(out, "ow") return out }
    if str_eq_bytes(s, "see")     == 1 { push(out, "s") push(out, "iy") return out }
    if str_eq_bytes(s, "look")    == 1 { push(out, "l") push(out, "uh") push(out, "k") return out }
    if str_eq_bytes(s, "find")    == 1 { push(out, "f") push(out, "ay") push(out, "n") push(out, "d") return out }
    if str_eq_bytes(s, "think")   == 1 { push(out, "th") push(out, "ih") push(out, "ng") push(out, "k") return out }
    if str_eq_bytes(s, "want")    == 1 { push(out, "w") push(out, "ao") push(out, "n") push(out, "t") return out }
    if str_eq_bytes(s, "need")    == 1 { push(out, "n") push(out, "iy") push(out, "d") return out }
    if str_eq_bytes(s, "feel")    == 1 { push(out, "f") push(out, "iy") push(out, "l") return out }
    if str_eq_bytes(s, "love")    == 1 { push(out, "l") push(out, "ah") push(out, "v") return out }
    if str_eq_bytes(s, "like")    == 1 { push(out, "l") push(out, "ay") push(out, "k") return out }
    if str_eq_bytes(s, "work")    == 1 { push(out, "w") push(out, "er") push(out, "k") return out }
    if str_eq_bytes(s, "play")    == 1 { push(out, "p") push(out, "l") push(out, "ey") return out }
    if str_eq_bytes(s, "stop")    == 1 { push(out, "s") push(out, "t") push(out, "ao") push(out, "p") return out }
    if str_eq_bytes(s, "start")   == 1 { push(out, "s") push(out, "t") push(out, "aa") push(out, "r") push(out, "t") return out }
    if str_eq_bytes(s, "run")     == 1 { push(out, "r") push(out, "ah") push(out, "n") return out }
    if str_eq_bytes(s, "walk")    == 1 { push(out, "w") push(out, "ao") push(out, "k") return out }
    if str_eq_bytes(s, "talk")    == 1 { push(out, "t") push(out, "ao") push(out, "k") return out }
    if str_eq_bytes(s, "open")    == 1 { push(out, "ow") push(out, "p") push(out, "ax") push(out, "n") return out }
    if str_eq_bytes(s, "close")   == 1 { push(out, "k") push(out, "l") push(out, "ow") push(out, "z") return out }
    if str_eq_bytes(s, "save")    == 1 { push(out, "s") push(out, "ey") push(out, "v") return out }
    if str_eq_bytes(s, "load")    == 1 { push(out, "l") push(out, "ow") push(out, "d") return out }
    if str_eq_bytes(s, "name")    == 1 { push(out, "n") push(out, "ey") push(out, "m") return out }
    if str_eq_bytes(s, "what")    == 1 { push(out, "w") push(out, "ah") push(out, "t") return out }
    if str_eq_bytes(s, "when")    == 1 { push(out, "w") push(out, "eh") push(out, "n") return out }
    if str_eq_bytes(s, "where")   == 1 { push(out, "w") push(out, "eh") push(out, "r") return out }
    if str_eq_bytes(s, "why")     == 1 { push(out, "w") push(out, "ay") return out }
    if str_eq_bytes(s, "how")     == 1 { push(out, "hh") push(out, "aw") return out }
    if str_eq_bytes(s, "who")     == 1 { push(out, "hh") push(out, "uw") return out }
    if str_eq_bytes(s, "which")   == 1 { push(out, "w") push(out, "ih") push(out, "ch") return out }
    if str_eq_bytes(s, "here")    == 1 { push(out, "hh") push(out, "ih") push(out, "r") return out }
    if str_eq_bytes(s, "there")   == 1 { push(out, "dh") push(out, "eh") push(out, "r") return out }
    if str_eq_bytes(s, "now")     == 1 { push(out, "n") push(out, "aw") return out }
    if str_eq_bytes(s, "then")    == 1 { push(out, "dh") push(out, "eh") push(out, "n") return out }
    if str_eq_bytes(s, "all")     == 1 { push(out, "ao") push(out, "l") return out }
    if str_eq_bytes(s, "one")     == 1 { push(out, "w") push(out, "ah") push(out, "n") return out }
    if str_eq_bytes(s, "two")     == 1 { push(out, "t") push(out, "uw") return out }
    if str_eq_bytes(s, "three")   == 1 { push(out, "th") push(out, "r") push(out, "iy") return out }
    if str_eq_bytes(s, "four")    == 1 { push(out, "f") push(out, "ao") push(out, "r") return out }
    if str_eq_bytes(s, "five")    == 1 { push(out, "f") push(out, "ay") push(out, "v") return out }
    if str_eq_bytes(s, "six")     == 1 { push(out, "s") push(out, "ih") push(out, "k") push(out, "s") return out }
    if str_eq_bytes(s, "seven")   == 1 { push(out, "s") push(out, "eh") push(out, "v") push(out, "ax") push(out, "n") return out }
    if str_eq_bytes(s, "eight")   == 1 { push(out, "ey") push(out, "t") return out }
    if str_eq_bytes(s, "nine")    == 1 { push(out, "n") push(out, "ay") push(out, "n") return out }
    if str_eq_bytes(s, "ten")     == 1 { push(out, "t") push(out, "eh") push(out, "n") return out }
    if str_eq_bytes(s, "zero")    == 1 { push(out, "z") push(out, "iy") push(out, "r") push(out, "ow") return out }
    // ---- crossengin domain ------------------------------------------
    if str_eq_bytes(s, "crossengin") == 1 { push(out, "k") push(out, "r") push(out, "ao") push(out, "s") push(out, "eh") push(out, "n") push(out, "jh") push(out, "ih") push(out, "n") return out }
    if str_eq_bytes(s, "nova")    == 1 { push(out, "n") push(out, "ow") push(out, "v") push(out, "ax") return out }
    if str_eq_bytes(s, "agent")   == 1 { push(out, "ey") push(out, "jh") push(out, "ax") push(out, "n") push(out, "t") return out }
    if str_eq_bytes(s, "kg")      == 1 { push(out, "k") push(out, "ey") push(out, "jh") push(out, "iy") return out }
    if str_eq_bytes(s, "atom")    == 1 { push(out, "ae") push(out, "t") push(out, "ax") push(out, "m") return out }
    // ---- not found: return empty list (caller falls back to rules) --
    return out
}

// ---- rule-based fallback -------------------------------------------------
//
// Greedy left-to-right walk: try a trigraph first (oug, igh), then a
// digraph (sh, th, ch, ng, oo, ee, ai, ay, ou, ow, ie, ea), then a single
// letter. Each match consumes its length and pushes a phoneme. Returns
// the phoneme list; never empty for a non-empty input (every byte
// produces at least one phoneme via the single-letter fallback, even
// non-ASCII -- those map to the silence-ish UNKNOWN).
//
// Silent-letter handling: a leading 'kn'/'wr'/'pn'/'mn' drops the first
// letter. A trailing silent 'e' after a CVC pattern is dropped (cake ->
// K EY K not K EY K AX) -- the heuristic is "if the prior letter is a
// consonant AND the letter before THAT is a vowel AND we're at the last
// character, skip the 'e'".

fn _tts_is_vowel_char(c) {
    if c == 97  { return 1 }    // a
    if c == 101 { return 1 }    // e
    if c == 105 { return 1 }    // i
    if c == 111 { return 1 }    // o
    if c == 117 { return 1 }    // u
    if c == 121 { return 1 }    // y (sometimes a vowel)
    return 0
}

// Map a single ASCII letter (lowercase already) to its default phoneme
// label. Vowels get their most-common short pronunciation; consonants
// map to their single-phoneme namesake. Unknown bytes fall through to
// "ax" (schwa, the universal English filler).
fn _tts_single_letter_phoneme(c) {
    if c == 97  { return "ae" }     // a -> /AE/ (cat)
    if c == 98  { return "b" }      // b -> /B/
    if c == 99  { return "k" }      // c -> /K/ (cat); 'ce'/'ci' is handled by digraph rules
    if c == 100 { return "d" }      // d -> /D/
    if c == 101 { return "eh" }     // e -> /EH/ (bed)
    if c == 102 { return "f" }      // f -> /F/
    if c == 103 { return "g" }      // g -> /G/ (go)
    if c == 104 { return "hh" }     // h -> /HH/
    if c == 105 { return "ih" }     // i -> /IH/ (sit)
    if c == 106 { return "jh" }     // j -> /JH/ (jug)
    if c == 107 { return "k" }      // k -> /K/
    if c == 108 { return "l" }      // l -> /L/
    if c == 109 { return "m" }      // m -> /M/
    if c == 110 { return "n" }      // n -> /N/
    if c == 111 { return "ao" }     // o -> /AO/ (top)
    if c == 112 { return "p" }      // p -> /P/
    if c == 113 { return "k" }      // q -> /K/ (treated like k; qu special-cased)
    if c == 114 { return "r" }      // r -> /R/
    if c == 115 { return "s" }      // s -> /S/
    if c == 116 { return "t" }      // t -> /T/
    if c == 117 { return "ah" }     // u -> /AH/ (cup)
    if c == 118 { return "v" }      // v -> /V/
    if c == 119 { return "w" }      // w -> /W/
    if c == 120 { return "k" }      // x -> /K/ + /S/; rules emit both
    if c == 121 { return "y" }      // y -> /Y/
    if c == 122 { return "z" }      // z -> /Z/
    return "ax"                     // unknown byte -> schwa filler
}

// "Long" form of a single vowel; used by the silent-e CVCe rule to upgrade
// the prior vowel's pronunciation. cake -> K + (a -> ey) + K + (silent e).
// Non-vowel input passes through to the short form.
fn _tts_long_vowel_phoneme(c) {
    if c == 97  { return "ey" }     // a -> /EY/ (cake)
    if c == 101 { return "iy" }     // e -> /IY/ (pete)
    if c == 105 { return "ay" }     // i -> /AY/ (kite)
    if c == 111 { return "ow" }     // o -> /OW/ (bone)
    if c == 117 { return "uw" }     // u -> /UW/ (cute)
    return _tts_single_letter_phoneme(c)
}

// CVCe heuristic detector at vowel-position i: is there a consonant at
// i+1 and a silent-e at i+2 (end of word)? Used to swap the short form
// of the vowel at i for its long form during the rule walk.
fn _tts_cvce_at(s, i) {
    let n = len(s)
    if i + 2 != n - 1 { return 0 }
    if _tts_is_vowel_char(char_at(s, i)) == 0 { return 0 }
    if _tts_is_vowel_char(char_at(s, i + 1)) == 1 { return 0 }
    if char_at(s, i + 2) != 101 { return 0 }
    return 1
}

// Try to match a 2-letter digraph at position i in `s`. Returns the
// phoneme label string on match, "" on miss. Consumes 2 letters when
// matched.
fn _tts_digraph_at(s, i) {
    let n = len(s)
    if i + 2 > n { return "" }
    let pair = substr(s, i, 2)
    if str_eq_bytes(pair, "sh") == 1 { return "sh" }
    if str_eq_bytes(pair, "th") == 1 { return "th" }
    if str_eq_bytes(pair, "ch") == 1 { return "ch" }
    if str_eq_bytes(pair, "ng") == 1 { return "ng" }
    if str_eq_bytes(pair, "ph") == 1 { return "f" }     // ph -> /F/
    if str_eq_bytes(pair, "wh") == 1 { return "w" }     // wh -> /W/
    if str_eq_bytes(pair, "ck") == 1 { return "k" }     // ck -> /K/
    if str_eq_bytes(pair, "qu") == 1 { return "qu" }    // expanded by caller
    // ---- vowel digraphs ---------------------------------------------
    if str_eq_bytes(pair, "oo") == 1 { return "uw" }    // oo -> /UW/ (food)
    if str_eq_bytes(pair, "ee") == 1 { return "iy" }    // ee -> /IY/ (see)
    if str_eq_bytes(pair, "ea") == 1 { return "iy" }    // ea -> /IY/ (sea)
    if str_eq_bytes(pair, "ai") == 1 { return "ey" }    // ai -> /EY/ (rain)
    if str_eq_bytes(pair, "ay") == 1 { return "ey" }    // ay -> /EY/ (day)
    if str_eq_bytes(pair, "ie") == 1 { return "ay" }    // ie -> /AY/ (pie)
    if str_eq_bytes(pair, "ou") == 1 { return "aw" }    // ou -> /AW/ (out)
    if str_eq_bytes(pair, "ow") == 1 { return "ow" }    // ow -> /OW/ (low; some "aw")
    if str_eq_bytes(pair, "oa") == 1 { return "ow" }    // oa -> /OW/ (boat)
    if str_eq_bytes(pair, "oi") == 1 { return "oy" }    // oi -> /OY/ (oil)
    if str_eq_bytes(pair, "oy") == 1 { return "oy" }    // oy -> /OY/ (boy)
    if str_eq_bytes(pair, "ar") == 1 { return "aar" }   // expanded
    if str_eq_bytes(pair, "er") == 1 { return "er" }    // er -> /ER/
    if str_eq_bytes(pair, "ir") == 1 { return "er" }    // ir -> /ER/
    if str_eq_bytes(pair, "or") == 1 { return "aor" }   // expanded
    if str_eq_bytes(pair, "ur") == 1 { return "er" }    // ur -> /ER/
    return ""
}

// Drop common silent-letter prefixes. Returns the (possibly shortened)
// substring; the caller continues parsing from there.
fn _tts_strip_silent_prefix(s) {
    let n = len(s)
    if n < 2 { return s }
    let pair = substr(s, 0, 2)
    if str_eq_bytes(pair, "kn") == 1 { return substr(s, 1, n - 1) }
    if str_eq_bytes(pair, "wr") == 1 { return substr(s, 1, n - 1) }
    if str_eq_bytes(pair, "pn") == 1 { return substr(s, 1, n - 1) }
    if str_eq_bytes(pair, "mn") == 1 { return substr(s, 1, n - 1) }
    if str_eq_bytes(pair, "gn") == 1 { return substr(s, 1, n - 1) }
    if str_eq_bytes(pair, "ps") == 1 { return substr(s, 1, n - 1) }
    return s
}

// Silent-e check: is position i the last character, and is the prior
// character a consonant, and the one before THAT a vowel? Then 'e'
// at position i is silent. Word must be at least 3 chars for the
// pattern to apply (CVC + e).
fn _tts_is_silent_e(s, i) {
    let n = len(s)
    if i != n - 1 { return 0 }            // not the last character
    if char_at(s, i) != 101 { return 0 }  // not 'e'
    if n < 4 { return 0 }                 // too short for CVCe
    // check prior letter is a consonant (non-vowel)
    if _tts_is_vowel_char(char_at(s, i - 1)) == 1 { return 0 }
    // and the one before is a vowel
    if _tts_is_vowel_char(char_at(s, i - 2)) == 0 { return 0 }
    return 1
}

fn _tts_g2p_rules(word_lower) {
    let s = _tts_strip_silent_prefix(word_lower)
    let n = len(s)
    let out = list_new()
    let i = 0
    while i < n {
        // Silent-e at end of word -> skip without emitting a phoneme.
        if _tts_is_silent_e(s, i) == 1 {
            i = i + 1
        } else {
            // Try a 2-letter digraph first (greedy).
            let dg = _tts_digraph_at(s, i)
            if len(dg) > 0 {
                // Expand multi-phoneme digraphs ("qu" -> /K/ + /W/;
                // "ar" -> /AA/ + /R/; "or" -> /AO/ + /R/).
                if str_eq_bytes(dg, "qu") == 1 {
                    push(out, "k") push(out, "w")
                } else {
                    if str_eq_bytes(dg, "aar") == 1 {
                        push(out, "aa") push(out, "r")
                    } else {
                        if str_eq_bytes(dg, "aor") == 1 {
                            push(out, "ao") push(out, "r")
                        } else {
                            push(out, dg)
                        }
                    }
                }
                i = i + 2
            } else {
                // Single-letter fallback. CVCe (cake / kite / bone) swaps
                // the short vowel for its long form at the vowel position.
                let c = char_at(s, i)
                let lab = _tts_single_letter_phoneme(c)
                if _tts_cvce_at(s, i) == 1 {
                    lab = _tts_long_vowel_phoneme(c)
                }
                push(out, lab)
                // 'x' is actually /K/+/S/; emit the trailing /S/.
                if c == 120 {
                    push(out, "s")
                }
                i = i + 1
            }
        }
    }
    return out
}

// ---- public G2P ---------------------------------------------------------

// Per-word G2P kernel: dictionary first (with case folded), then the
// rule-based fallback. Returns a list of phoneme labels (lowercase
// ARPAbet-ish, all members of klatt_phoneme_labels()).
fn tts_g2p_word(word) {
    let lower = _tts_tolower(word)
    if len(lower) == 0 { return list_new() }
    let dict = _tts_dict_lookup(lower)
    if len(dict) > 0 { return dict }
    return _tts_g2p_rules(lower)
}

// Text-level G2P: tokenize on whitespace + punctuation, run per-word G2P,
// concatenate the phoneme lists. Word boundaries are NOT marked in the
// returned list (tts_g2p_marked is the variant that inserts "_brk_"
// between words for the synthesizer to render as silence).
fn tts_g2p(text) {
    let toks = tts_tokenize(text)
    let out = list_new()
    let i = 0
    while i < len(toks) {
        let phs = tts_g2p_word(toks[i])
        let j = 0
        while j < len(phs) {
            push(out, phs[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Same as tts_g2p but inserts a TTS_BREAK_LABEL between every word so the
// synthesizer can render a brief silence at word boundaries.
fn tts_g2p_marked(text) {
    let toks = tts_tokenize(text)
    let out = list_new()
    let i = 0
    while i < len(toks) {
        if i > 0 { push(out, TTS_BREAK_LABEL) }
        let phs = tts_g2p_word(toks[i])
        let j = 0
        while j < len(phs) {
            push(out, phs[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// ---- synthesis -----------------------------------------------------------
//
// Per-phoneme synthesis via R6E's synth_phoneme(label). The "_brk_"
// sentinel renders as TTS_WORD_BREAK_SAMPLES zeros; every other label is
// passed to synth_phoneme directly (which knows the 53-entry inventory
// and falls back gracefully on unknowns). The PCM is then wrapped in a
// WAV header at the requested sample_rate.

fn _tts_break_samples() {
    let s = list_new()
    let i = 0
    while i < TTS_WORD_BREAK_SAMPLES {
        push(s, 0)
        i = i + 1
    }
    return s
}

// Concatenate per-phoneme PCM. Returns a flat list[int] of signed 16-bit
// samples (the SAMPLES, not the WAV bytes -- the wrapping happens in
// tts_synth_phonemes).
fn _tts_phonemes_to_samples(phonemes) {
    let out = list_new()
    let i = 0
    while i < len(phonemes) {
        let lab = phonemes[i]
        let chunk = list_new()
        if str_eq_bytes(lab, TTS_BREAK_LABEL) == 1 {
            chunk = _tts_break_samples()
        } else {
            chunk = synth_phoneme(lab)
        }
        let j = 0
        while j < len(chunk) {
            push(out, chunk[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Encode signed PCM16 samples to little-endian byte pairs in a list[int]
// suitable for appending to a WAV header. Negative samples become
// two's-complement via the mask used in audio_synth.nova.
fn _tts_samples_to_bytes(samples) {
    let out = list_new()
    let n = len(samples)
    let i = 0
    while i < n {
        let s = samples[i]
        let u = s & 65535
        if s < 0 {
            u = (s + 65536) & 65535
        }
        push(out, u & 255)
        push(out, (u / 256) & 255)
        i = i + 1
    }
    return out
}

// Build the WAV byte list at the requested sample_rate, with PCM data
// appended. wav_header() is reused from audio_synth.nova so the header
// shape matches every other CE-emitted WAV byte-for-byte.
fn _tts_wrap_wav_bytes(samples, sample_rate) {
    let sr = sample_rate
    if sr <= 0 { sr = TTS_DEFAULT_SAMPLE_RATE }
    let header = wav_header(sr, len(samples))
    let pcm_bytes = _tts_samples_to_bytes(samples)
    let out = list_new()
    let i = 0
    while i < len(header) {
        push(out, header[i])
        i = i + 1
    }
    let j = 0
    while j < len(pcm_bytes) {
        push(out, pcm_bytes[j])
        j = j + 1
    }
    return out
}

// Public: phoneme list -> WAV byte list at the requested sample_rate.
// Caller can pass a list interspersed with TTS_BREAK_LABEL ("_brk_") to
// signal word breaks; everything else is synthesized via R6E Klatt.
fn tts_synth_phonemes(phonemes, sample_rate) {
    let samples = _tts_phonemes_to_samples(phonemes)
    return _tts_wrap_wav_bytes(samples, sample_rate)
}

// Public: end-to-end pipeline. Text -> G2P (with word breaks) ->
// per-phoneme Klatt PCM -> WAV bytes at the requested sample_rate. Empty
// input returns the 44-byte header-only WAV (legal but silent).
fn tts_speak(text, sample_rate) {
    let phonemes = tts_g2p_marked(text)
    return tts_synth_phonemes(phonemes, sample_rate)
}

// ---- WAV writer ----------------------------------------------------------
//
// Mirrors audio_synth.nova's audio_write_wav: open + write + fsync +
// close. The byte list is materialized into a contiguous buffer via
// alloc+store8 so the kernel sees one write call. fsync ensures any
// subsequent reader (paplay, aplay, the brief's verification scenario)
// observes the full file.

let _TTS_FILE_MODE = 420            // 0644 rw-r--r--

fn tts_save_wav(wav_bytes, path) {
    let n = len(wav_bytes)
    if n <= 0 { return 0 }
    let buf = alloc(n + 1)
    let i = 0
    while i < n {
        store8(buf + i, wav_bytes[i])
        i = i + 1
    }
    store8(buf + n, 0)
    let flags = O_WRONLY + O_CREAT + O_TRUNC
    let fd = sys_open(path, flags, _TTS_FILE_MODE)
    if fd < 0 { return 0 }
    let written = sys_write(fd, buf, n)
    if written != n {
        sys_close(fd)
        return 0
    }
    sys_fsync(fd)
    sys_close(fd)
    return 1
}

// ---- diagnostics ---------------------------------------------------------

// Convenience: format a phoneme list as a space-separated string for the
// chat /say diagnostic and the integration scenario assertions.
fn tts_phonemes_to_string(phonemes) {
    let out = ""
    let i = 0
    while i < len(phonemes) {
        if i > 0 { out = out + " " }
        out = out + phonemes[i]
        i = i + 1
    }
    return out
}

// Convenience: dictionary size hint (the dispatch chain isn't enumerable
// from outside, but this is the curated count the brief asks for).
let TTS_DICT_ENTRY_COUNT = 122

fn tts_dict_size() {
    return TTS_DICT_ENTRY_COUNT
}

// ---- chat /say -----------------------------------------------------------
//
// Default path the /say chat command writes to. Operators can override via
// the CE_TTS_PATH env (same shape as CE_SPEECH_PATH for /speak).
let TTS_DEFAULT_PATH = "/tmp/tts_out.wav"

// Probe whether a binary is on PATH via /bin/sh -c "command -v ...".
// Inline minimal version (audio_speak.nova has its own copy but we avoid
// touching it; this keeps audio_tts.nova self-contained for chat-side use).
fn _tts_argv3(a0, a1, a2) {
    let p = alloc(4 * 8)
    store64(p,      a0)
    store64(p + 8,  a1)
    store64(p + 16, a2)
    store64(p + 24, 0)
    return p
}

fn _tts_run_sh_c(cmd) {
    let argv = _tts_argv3("sh", "-c", cmd)
    let pid = fork_process()
    if pid < 0 { return 127 }
    if pid == 0 {
        exec_program("/bin/sh", argv)
        exit(127)
    }
    return waitpid(pid)
}

fn _tts_have_binary(bin) {
    let cmd = "command -v " + bin + " >/dev/null 2>&1"
    let st = _tts_run_sh_c(cmd)
    if st == 0 { return 1 }
    return 0
}

// Best-effort playback. Returns 1 if a player ran successfully, 0 otherwise.
// Playback failure is NEVER a TTS failure -- the WAV is the artifact.
fn _tts_try_play(path) {
    if _tts_have_binary("paplay") == 1 {
        let cmd = "paplay '" + path + "' >/dev/null 2>&1"
        let st = _tts_run_sh_c(cmd)
        if st == 0 { return 1 }
    }
    if _tts_have_binary("aplay") == 1 {
        let cmd = "aplay -q '" + path + "' >/dev/null 2>&1"
        let st = _tts_run_sh_c(cmd)
        if st == 0 { return 1 }
    }
    return 0
}

// Resolve the destination path; CE_TTS_PATH env wins over the default.
fn _tts_resolve_path() {
    let env = getenv("CE_TTS_PATH")
    if len(env) > 0 { return env }
    return TTS_DEFAULT_PATH
}

// Public chat entrypoint for /say. Single-line callable from chat
// dispatch -- keeps the chat-side diff at 1 dispatch + 1 help. Returns a
// formatted status string (printed by the dispatch). Reports the
// resolved path, the WAV size, the phoneme count, and which player ran
// (or "no-player" if paplay/aplay unavailable).
fn tts_say_run(text) {
    if len(text) == 0 {
        return "(/say needs TEXT -- usage: /say <text to speak>)"
    }
    let phonemes = tts_g2p_marked(text)
    let wav = tts_synth_phonemes(phonemes, TTS_DEFAULT_SAMPLE_RATE)
    let path = _tts_resolve_path()
    let ok = tts_save_wav(wav, path)
    if ok == 0 {
        return "(say FAILED: could not write " + path + ")"
    }
    let played = _tts_try_play(path)
    let player = "no-player"
    if played == 1 { player = "paplay" }
    return "(said '" + text + "' [phonemes=" + int_to_str(len(phonemes))
        + " wav=" + int_to_str(len(wav)) + " bytes player=" + player
        + "]; wrote " + path + ")"
}
