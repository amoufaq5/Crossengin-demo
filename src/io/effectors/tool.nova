// CrossEngin effectors: tool abstraction + registry (P4, ADR-0054).
//
// Purpose
//   An agent acts through TOOLS. A tool is modelled as a skill-atom-shaped
//   record: a capability label (what step it satisfies), a backend kind (which
//   effector runs it), an action type (its reversibility, for the safety gate),
//   a cost, and a Bayesian COMPETENCE (alpha/beta, the same posterior-mean
//   semantics skill atoms use, ADR-0019/0023). The agent reasons about tools as
//   knowledge: it SELECTS the highest-competence tool for a step, and every
//   outcome updates that competence, so a tool that starts failing is selected
//   less -- learning to use tools without any retraining.
//
//   Safety is the existing scaffolding (ADR-0041/0042): a tool's action type
//   drives permission_tiers + reversibility_classifier, so irreversible actions
//   (delete, spend, send) are gated to APPROVE and refused unless approval is
//   granted in the call context.
//
// ADRs implemented: ADR-0054 (agentic tooling), ADR-0019/0023 (competence as
//   Bayesian belief), ADR-0041/0042 (permission tiers + reversibility).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/safety/permission_tiers.nova (-> reversibility_classifier).

import "../../safety/permission_tiers.nova"

// ---- tool backend kinds ----------------------------------------------------
let TOOLK_CODE_EXEC  = 1
let TOOLK_HTTP       = 2
let TOOLK_FILE_WRITE = 3
let TOOLK_FILE_READ  = 4
let TOOLK_MCP        = 5

// ---- tool layout -----------------------------------------------------------
let TOOL_OBJ_TAG = 2310
let T_TAG    = 0
let T_NAME   = 1
let T_KIND   = 2
let T_CAP    = 3   // capability label (e.g. "search" / "compute" / "write")
let T_ACT    = 4   // action type (ACT_* from reversibility_classifier)
let T_COST   = 5
let T_BELIEF = 6   // [alpha, beta] competence, milli
let T_CONFIG = 7   // kind-specific config string (path / canned body / service)

// ---- Bayesian competence (mirrors atom_store belief, kept local) -----------
let TOOL_PRIOR = 1000   // uniform alpha0 = beta0 = 1.0

fn _tool_belief() {
    let b = list_new()
    push(b, TOOL_PRIOR); push(b, TOOL_PRIOR)
    return b
}
fn _tool_mean(b) {
    let total = b[0] + b[1]
    if total <= 0 { return 500 }
    return b[0] * 1000 / total
}
fn _tool_evidence(b) {
    let beyond = (b[0] + b[1]) - (2 * TOOL_PRIOR)
    if beyond < 0 { return 0 }
    return beyond / 1000
}
fn _tool_observe(b, success) {
    if success == 1 { list_set(b, 0, b[0] + 1000) } else { list_set(b, 1, b[1] + 1000) }
    return 1
}

fn tool_new(name, kind, capability, action_type, cost, config) {
    let t = list_new()
    push(t, TOOL_OBJ_TAG)
    push(t, name); push(t, kind); push(t, capability)
    push(t, action_type); push(t, cost)
    push(t, _tool_belief()); push(t, config)
    return t
}

fn tool_name(t)       { return t[T_NAME] }
fn tool_kind(t)       { return t[T_KIND] }
fn tool_capability(t) { return t[T_CAP] }
fn tool_action(t)     { return t[T_ACT] }
fn tool_cost(t)       { return t[T_COST] }
fn tool_config(t)     { return t[T_CONFIG] }
fn tool_competence(t) { return _tool_mean(t[T_BELIEF]) }
fn tool_executions(t) { return _tool_evidence(t[T_BELIEF]) }

// Record an outcome: success raises competence, failure lowers it.
fn tool_observe(t, success) { return _tool_observe(t[T_BELIEF], success) }

// ---- registry --------------------------------------------------------------
fn tool_registry_new() { return list_new() }
fn tool_register(reg, t) { push(reg, t); return len(reg) }
fn tool_count(reg) { return len(reg) }

// The highest-competence tool that satisfies `capability` (tie-break: lower
// cost, then earlier registration). 0 if none can do it.
fn tool_select(reg, capability) {
    let best = 0
    let best_comp = 0 - 1
    let best_cost = 0
    let i = 0
    while i < len(reg) {
        let t = reg[i]
        if str_eq(tool_capability(t), capability) == 1 {
            let c = tool_competence(t)
            let better = 0
            if best == 0 { better = 1 }
            else { if c > best_comp { better = 1 }
            else { if c == best_comp { if tool_cost(t) < best_cost { better = 1 } } } }
            if better == 1 { best = t best_comp = c best_cost = tool_cost(t) }
        }
        i = i + 1
    }
    return best
}

// ---- safety gate -----------------------------------------------------------
let TGATE_EXECUTE = 1   // AUTO: run
let TGATE_NOTIFY  = 2   // NOTIFY: run + log/notify
let TGATE_DENY    = 3   // APPROVE tier, approval not granted: refuse

fn tool_required_tier(t) { return perm_effective_tier(tool_action(t)) }

// Gate a tool given whether the caller holds approval. Irreversible / APPROVE
// actions are refused unless approved; AUTO runs; NOTIFY runs (with a log
// obligation the caller honours).
fn tool_gate(t, approved) {
    if perm_requires_approval(tool_action(t)) == 1 {
        if approved == 0 { return TGATE_DENY }
        return TGATE_EXECUTE
    }
    let d = perm_decision(tool_action(t))
    if d == PDEC_EXECUTE { return TGATE_EXECUTE }
    if d == PDEC_NOTIFY  { return TGATE_NOTIFY }
    if approved == 1 { return TGATE_EXECUTE }
    return TGATE_DENY
}

// ---- tool result -----------------------------------------------------------
let TR_OBJ_TAG = 2311
let TR_TAG = 0
let TR_OK  = 1
let TR_VAL = 2
let TR_TXT = 3

fn tr_new(ok, val, txt) {
    let r = list_new()
    push(r, TR_OBJ_TAG); push(r, ok); push(r, val); push(r, txt)
    return r
}
fn tr_ok(r)    { return r[TR_OK] }
fn tr_value(r) { return r[TR_VAL] }
fn tr_text(r)  { return r[TR_TXT] }
fn tr_denied() { return tr_new(0, 0, "denied-by-permission-gate") }
