// CrossEngin NL Surface: LLM-preprocessor parser (R48p6, ADR-0104).
//
// Reads a StructuredQuery wire record produced by scripts/nl_parse_llm.sh
// (an external LLM classified the user's NL question into ONE of the
// canonical kinds) and rehydrates it as a StructuredQuery this codebase
// can dispatch. The LLM is a PREPROCESSOR ONLY -- everything downstream
// (executor, skill runtime, templater) runs on the StructuredQuery we
// build here, never on LLM prose. ADR-0013 / ADR-0014 stay intact: the
// reasoning path is 100% NOVA-symbolic.
//
// Wire format (line-oriented, whitespace-tolerant, comments skipped):
//   KIND <name>          one of the sq_kind_name() strings, plus
//                        "research_filtered" for who/when/where
//   ARG  <string>        the kind's args in declared order
//   # ...                comment; ignored
//   (blank)              ignored
//
// Only the FIRST KIND record is honored -- subsequent ones are ignored.
// This makes it safe to concatenate wire files or leave audit headers
// in the buffer.
//
// Validation happens twice:
//   1. Here (llm_parse_wire) -- the wire must have a KIND line whose
//      name resolves, and the ARG count must match the kind's arity.
//      Anything off yields NLK_UNPARSED so the caller falls through to
//      the legacy cognition path (or surfaces a refusal via
//      templater_render -> "Cannot answer").
//   2. Downstream in sq_validate + nl_execute -- the same schema every
//      other query goes through. A malformed wire never reaches the
//      skill runtime with bogus args.
//
// This module is DATA-ONLY. It does NOT spawn subprocesses, invoke
// LLMs, read files, or reach the network. The chat / RPC layer is
// responsible for running the shell script and handing the wire text
// (or the file path) to this parser. That keeps the LLM-side blast
// radius small: everything network-facing lives in the shell script.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/nl/query_shape.nova, src/util/str_safe.nova.

import "./query_shape.nova"
import "../util/str_safe.nova"

// ---- parse-outcome slot layout (returned by llm_parse_wire_verbose) ------
let LLMP_QUERY  = 0    // StructuredQuery (always a valid SQ; UNPARSED on failure)
let LLMP_OK     = 1    // 0/1
let LLMP_ERROR  = 2    // human-readable diagnostic; "" on success
let LLMP_SLOTS  = 3

// ---- byte helpers --------------------------------------------------------

fn _llmp_is_ws(c) {
    if c == 32  { return 1 }        // space
    if c == 9   { return 1 }        // tab
    if c == 13  { return 1 }        // CR (Windows line endings)
    return 0
}

// Trim leading + trailing whitespace (space / tab / CR).
fn _llmp_trim(s) {
    let n = len(s)
    let start = 0
    let done = 0
    while done == 0 {
        if start >= n { done = 1 }
        else {
            if _llmp_is_ws(char_at(s, start)) == 0 { done = 1 }
            else                                     { start = start + 1 }
        }
    }
    if start >= n { return "" }        // pure whitespace
    let end = n
    let done2 = 0
    while done2 == 0 {
        if end <= start { done2 = 1 }
        else {
            if _llmp_is_ws(char_at(s, end - 1)) == 0 { done2 = 1 }
            else                                       { end = end - 1 }
        }
    }
    return substr(s, start, end - start)
}

// ---- wire kind names -----------------------------------------------------
//
// A single dispatch table keeps kind name <-> kind constant + arity in
// one place. Arity is an exact count; sq_validate below permits
// research with 1 or 2 args, but the WIRE distinguishes "research"
// (1 arg) from "research_filtered" (2 args) to make the LLM's job
// simpler (no "sometimes 2 args" ambiguity).

fn _llmp_arity(kind_name) {
    if str_eq_bytes(kind_name, "research")           == 1 { return 1 }
    if str_eq_bytes(kind_name, "research_filtered")  == 1 { return 2 }
    if str_eq_bytes(kind_name, "relate")             == 1 { return 2 }
    if str_eq_bytes(kind_name, "contradict_scan")    == 1 { return 2 }
    if str_eq_bytes(kind_name, "is_a")               == 1 { return 2 }
    if str_eq_bytes(kind_name, "retract")            == 1 { return 1 }
    if str_eq_bytes(kind_name, "capsule_install")    == 1 { return 1 }
    if str_eq_bytes(kind_name, "skill_install")      == 1 { return 1 }
    if str_eq_bytes(kind_name, "capsule_list")       == 1 { return 0 }
    if str_eq_bytes(kind_name, "skill_list")         == 1 { return 0 }
    if str_eq_bytes(kind_name, "skill_run")          == 1 { return 2 }
    if str_eq_bytes(kind_name, "unparsed")           == 1 { return 0 }
    return 0 - 1
}

// Build a StructuredQuery of the given kind_name + args + raw_text.
// Called AFTER arity was validated, so the args list is the exact
// length the kind expects. Sets parser_used="llm".
fn _llmp_build(kind_name, args, raw_text) {
    if str_eq_bytes(kind_name, "research")          == 1 {
        return sq_research(args[0], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "research_filtered") == 1 {
        return sq_research_filtered(args[0], args[1], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "relate")            == 1 {
        return sq_relate(args[0], args[1], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "contradict_scan")   == 1 {
        return sq_contradict_scan(args[0], args[1], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "is_a")              == 1 {
        return sq_is_a(args[0], args[1], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "retract")           == 1 {
        return sq_retract(args[0], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "capsule_install")   == 1 {
        return sq_capsule_install(args[0], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "skill_install")     == 1 {
        return sq_skill_install(args[0], raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "capsule_list")      == 1 {
        return sq_capsule_list(raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "skill_list")        == 1 {
        return sq_skill_list(raw_text, "llm")
    }
    if str_eq_bytes(kind_name, "skill_run")         == 1 {
        return sq_skill_run(args[0], args[1], raw_text, "llm")
    }
    // unparsed: the LLM classified but declined; produce a proper
    // UNPARSED shape (parser_used="llm" for audit) so downstream
    // handling matches grammar-side.
    return sq_new(NLK_UNPARSED, raw_text, "llm")
}

// ---- line walk -----------------------------------------------------------

// Split wire text into lines by ASCII newline (10). Empty trailing line
// is preserved so a wire ending in "\n" doesn't lose its last record's
// blank tail (harmless: we skip blanks).
fn _llmp_lines(text) {
    return split_char(text, 10)
}

// Match a "KIND <value>" or "ARG <value>" line. Returns the value with
// leading/trailing whitespace stripped, or "" if the line's directive
// doesn't match. Case-sensitive: the wire format is intentionally
// strict, so accidental casing errors from an LLM count as malformed.
fn _llmp_directive_value(line, directive) {
    let t = _llmp_trim(line)
    let dn = len(directive)
    if len(t) <= dn { return "" }
    // t must start with directive + at least one whitespace.
    let i = 0
    while i < dn {
        if char_at(t, i) != char_at(directive, i) { return "" }
        i = i + 1
    }
    if _llmp_is_ws(char_at(t, dn)) == 0 { return "" }
    // Rest is the value; trim ws.
    return _llmp_trim(substr(t, dn, len(t) - dn))
}

// Is this line a comment ("# ...") or blank after trimming?
fn _llmp_skip(line) {
    let t = _llmp_trim(line)
    if len(t) == 0 { return 1 }
    if char_at(t, 0) == 35 { return 1 }        // '#'
    return 0
}

// ---- entry points --------------------------------------------------------

// Parse `wire_text` into a StructuredQuery. `raw_text` is the original
// NL input the LLM was asked about; it's carried on the SQ for audit.
// A malformed wire yields NLK_UNPARSED (an OK-shaped query the caller
// can inspect; parser_used still reads "llm" so audit slices right).
fn llm_parse_wire(wire_text, raw_text) {
    let outcome = llm_parse_wire_verbose(wire_text, raw_text)
    return outcome[LLMP_QUERY]
}

// Full parse: returns a 3-slot outcome record (query, ok, error). The
// error string is empty on success and human-readable on failure so
// the chat / RPC layer can surface a "malformed LLM output: <why>" to
// the operator without swallowing the diagnostic.
fn llm_parse_wire_verbose(wire_text, raw_text) {
    let out = list_new()
    push(out, sq_new(NLK_UNPARSED, raw_text, "llm"))  // QUERY default
    push(out, 0)                            // OK
    push(out, "")                           // ERROR
    if len(wire_text) == 0 {
        list_set(out, LLMP_ERROR, "empty wire input")
        return out
    }
    let lines = _llmp_lines(wire_text)
    let kind_name = ""
    let args = list_new()
    let expected_arity = 0 - 1
    let i = 0
    while i < len(lines) {
        let ln = lines[i]
        if _llmp_skip(ln) == 0 {
            let v = _llmp_directive_value(ln, "KIND")
            if len(v) > 0 {
                // A second KIND -- the first record has been consumed;
                // stop reading so the audit-header + one wire record
                // shape stays canonical.
                if len(kind_name) > 0 { i = len(lines) }
                else {
                    kind_name = v
                    expected_arity = _llmp_arity(kind_name)
                    if expected_arity < 0 {
                        list_set(out, LLMP_ERROR,
                            "unknown KIND '" + kind_name + "'")
                        return out
                    }
                }
            } else {
                let av = _llmp_directive_value(ln, "ARG")
                if len(av) > 0 {
                    if len(kind_name) == 0 {
                        list_set(out, LLMP_ERROR, "ARG before KIND")
                        return out
                    }
                    push(args, av)
                }
                // Any other non-skip line: silently ignore. The wire
                // grammar is deliberately narrow; unknown directives
                // are treated as noise, not fatal, so an LLM that adds
                // extra fields does not crash the parse (but they are
                // dropped -- the reader keeps only KIND + ARG).
            }
        }
        i = i + 1
    }
    if len(kind_name) == 0 {
        list_set(out, LLMP_ERROR, "no KIND line found")
        return out
    }
    if len(args) != expected_arity {
        list_set(out, LLMP_ERROR,
            "kind '" + kind_name + "' expects "
            + int_to_str(expected_arity) + " arg(s), got "
            + int_to_str(len(args)))
        return out
    }
    // Build the SQ and validate against the same schema every query
    // passes through. sq_validate catches empty-arg / parser-name
    // issues; a validation failure demotes the outcome to UNPARSED.
    let q = _llmp_build(kind_name, args, raw_text)
    let vcode = sq_validate(q)
    if vcode != SQ_OK {
        list_set(out, LLMP_ERROR,
            "wire validated but SQ schema rejected: " + sq_err_name(vcode))
        return out
    }
    list_set(out, LLMP_QUERY, q)
    list_set(out, LLMP_OK, 1)
    return out
}

// ---- source-tag helper (ADR-0104 §Component 2) ---------------------------
//
// Any observation that a downstream skill run (from an LLM-parsed query)
// later creates should carry a tag distinguishing it from grammar-side
// parses. The meta_observer path (skill_supervisor._sup_attribute_atoms)
// tags atoms with the skill's manifest attribution -- this helper
// produces the ADDITIONAL parser-side tag chat / RPC prepend so audit
// can slice by parser + skill.

fn llm_parser_source_tag(model, run) {
    return "src:parser:llm:" + model + ":" + run
}

// ---- outcome accessors ---------------------------------------------------

fn llmp_query(outcome)  { return outcome[LLMP_QUERY] }
fn llmp_ok(outcome)     { return outcome[LLMP_OK] }
fn llmp_error(outcome)  { return outcome[LLMP_ERROR] }
