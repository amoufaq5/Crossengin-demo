// CrossEngin Phase 0 pt4: adaptive intent prototypes.
//
// Purpose
//   The input classifier (src/perception/input_classifier.nova) decides
//   a category from literal word banks. That works but doesn't learn:
//   a new idiomatic greeting the user favours never gets easier to
//   recognise.
//
//   Adaptive intent prototypes add a parallel per-category HDC vector
//   that /good reinforces. On every /good, the user's utterance is
//   bundled into the prototype of the just-dispatched category.
//   Future utterances score against each prototype via hdc_cosine; a
//   high score raises confidence in that category even when the word
//   banks miss.
//
//   HDC bundle (sign-preserving superposition) is self-regularising:
//   repeated reinforcement with the same tokens doesn't drift, and
//   cross-category contamination randomises out under bundle. Nothing
//   to tune, no gradient, no decay knob.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/kg/hdc_embed.nova (hdc_symbol, hdc_bundle, hdc_cosine, hdc_dims),
//   src/perception/input_classifier.nova (CAT_COUNT, _ic_tokens,
//     _ic_lower, _ic_in — for stopword skipping).

import "std/io"
import "std/string"
import "std/syscall"
import "../kg/hdc_embed.nova"
import "../perception/input_classifier.nova"

let IA_TAG       = 0
let IA_PROTOS    = 1   // list<hdc_vec>, length CAT_COUNT
let IA_STRENGTH  = 2   // list<int>, length CAT_COUNT -- reinforcement count
let IA_IA_TAG    = 773

// Stopwords skipped when building an utterance vector. Kept minimal
// (same intent as the classifier's own content-token selection) so a
// greeting like "hi" still has at least one symbol to bundle.
fn _ia_stopwords() {
    return ["the", "a", "an", "is", "are", "was", "were", "be", "been",
            "of", "to", "in", "on", "at", "for", "and", "or", "but",
            "i", "you", "we", "they", "it", "me", "my", "your",
            "this", "that", "these", "those",
            "what", "why", "how", "when", "where", "who",
            "can", "could", "will", "would", "should"]
}

fn _ia_zero_vec() {
    let v = list_new()
    let n = hdc_dims()
    let i = 0
    while i < n {
        push(v, 0)
        i = i + 1
    }
    return v
}

fn ia_new() {
    let ia = list_new()
    push(ia, IA_IA_TAG)
    let protos = list_new()
    let strengths = list_new()
    let i = 0
    while i < CAT_COUNT {
        push(protos, _ia_zero_vec())
        push(strengths, 0)
        i = i + 1
    }
    push(ia, protos)
    push(ia, strengths)
    return ia
}

fn ia_count() { return CAT_COUNT }
fn ia_prototype_strength(ia, cat) {
    if cat < 0 { return 0 }
    if cat >= CAT_COUNT { return 0 }
    return ia[IA_STRENGTH][cat]
}

// Build the content-token HDC vector of a free-text utterance.
// Returns a zero vec when every token is a stopword.
fn _ia_utterance_vec(text) {
    let toks = _ic_tokens(_ic_lower(str_trim(text)))
    let vecs = list_new()
    let i = 0
    while i < len(toks) {
        let t = toks[i]
        if _ic_in(t, _ia_stopwords()) == 0 {
            push(vecs, hdc_symbol(t))
        }
        i = i + 1
    }
    if len(vecs) == 0 { return _ia_zero_vec() }
    return hdc_bundle(vecs)
}

// Reinforce: bundle the utterance vec into cat's prototype.
// On /good only. Strength counter tracks observations for /__learning__.
fn ia_reinforce(ia, cat, text) {
    if cat < 0 { return 0 }
    if cat >= CAT_COUNT { return 0 }
    let uv = _ia_utterance_vec(text)
    let old = ia[IA_PROTOS][cat]
    let combo = list_new()
    push(combo, old)
    push(combo, uv)
    let fresh = hdc_bundle(combo)
    list_set(ia[IA_PROTOS], cat, fresh)
    list_set(ia[IA_STRENGTH], cat, ia[IA_STRENGTH][cat] + 1)
    return 1
}

// Score: return [best_category, confidence_milli]. Confidence is the
// cosine against the winning prototype, floored at 0 (negative cosines
// read as "no match" rather than "anti-match"; the classifier's own
// signals already arbitrate when ia confidence is low).
// Returns [CAT_UNKNOWN, 0] when every prototype is still zero.
fn ia_score(ia, text) {
    let uv = _ia_utterance_vec(text)
    let best_cat = CAT_UNKNOWN
    let best_cos = 0
    let any_seen = 0
    let c = 0
    while c < CAT_COUNT {
        if ia[IA_STRENGTH][c] > 0 {
            any_seen = 1
            let cos = hdc_cosine(ia[IA_PROTOS][c], uv)
            if cos > best_cos {
                best_cos = cos
                best_cat = c
            }
        }
        c = c + 1
    }
    let out = list_new()
    if any_seen == 0 {
        push(out, CAT_UNKNOWN)
        push(out, 0)
    } else {
        push(out, best_cat)
        push(out, best_cos)
    }
    return out
}

fn ia_score_cat(r)  { return r[0] }
fn ia_score_conf(r) { return r[1] }
