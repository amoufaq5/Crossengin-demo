// CrossEngin NL Surface: HDC prototype-vector intent classifier
// (R98, Phase C part 3).
//
// The third rung of the ADR-0211 pipeline
//   grammar -> HDC classifier -> sidecar LLM (fallback)
//
// When the deterministic grammar parser (src/nl/grammar_parser.nova)
// returns NLK_UNPARSED but the utterance is "close enough" to a known
// pattern, this module classifies it into an SQ_KIND by computing
// cosine similarity between an HDC bundle of the utterance's tokens
// and a per-kind PROTOTYPE VECTOR pre-bundled from hand-authored
// training examples. A hit skips the (expensive, network-touching)
// LLM sidecar entirely; a miss falls through unchanged.
//
// Public API
// ----------
//   nl_ic_init()
//       Idempotent + lazy. Compiles the embedded training corpus
//       (_NLIC_CORPUS) into a per-kind prototype registry. Called
//       automatically on the first nl_ic_try_classify. Returns the
//       registry (also cached in the module-level singleton).
//
//   nl_ic_try_classify(raw_text, metrics_reg, holder)
//     -> [ok, sq_out, similarity_bp]
//       Tokenize + strip preamble + bundle -> compare against every
//       prototype -> pick the winner IF similarity > threshold. On
//       hit: build the corresponding sq_* with slot-fill; validate;
//       return [1, sq, bp]. On miss (or on a validator failure after
//       slot-fill): [0, sq_unparsed(raw_text), 0]. Metrics: always
//       inc `classifier_attempt`; inc `classifier_hit` on 1, else
//       `classifier_miss`.
//
//   nl_ic_prototype_count() -> int
//       Number of KIND blocks the registry knows. Reads only.
//
//   nl_ic_threshold_bp() -> int
//       Threshold in basis points (0-10000; 5000 == 50% cosine).
//       Resolved once at init from CROSSENGIN_NL_IC_THRESHOLD_BP,
//       default 3000 bp (30%). Chosen empirically: HDC token-bundles
//       score ~2000-4000 bp for on-topic paraphrases when bundling
//       depths differ, so 3000 balances hit-rate vs mis-classification.
//
//   nl_ic_reset_cache()
//       Test-only: drop the singleton so the next call re-inits.
//
// Threshold math
// --------------
// src/kg/hdc_embed.nova::hdc_cosine returns milli (-1000..1000). We
// convert to basis points (bp = milli * 10; clamped to >=0 so a
// negative correlation is treated as a miss, not a hit).
//
// Slot fill
// ---------
// The classifier recognizes INTENT, not full structure. For kinds that
// need arguments:
//   * research / retract / capsule_install / skill_install:
//       arg = utterance minus preamble minus that kind's "signal words"
//       (the tokens that identify the intent), joined with spaces.
//   * capsule_list / skill_list: no args.
//   * relate / is_a / contradict_scan (2 topics): split on a known
//       connector ("and", "vs", "versus", "to", "between", ...).
//       When no clean split is found we DROP the classification and
//       return unparsed -- misclassifying is worse than letting the
//       sidecar try.
//   * skill_run (2 args, skill + arg): split on "on", "with",
//       "using", "to". Same fall-through if ambiguous.
//
// After slot-fill the constructed SQ is passed to sq_validate; any
// SQ_ERR_* aborts the classification and returns sq_unparsed. This
// keeps the executor's invariants intact even when the corpus grows
// to shapes the slot-filler under-supports.
//
// Determinism
// -----------
// * hdc_symbol(label) is a pure function of the label (FNV-1a seed +
//   bounded LCG). Same corpus -> byte-identical prototype vectors.
// * The registry is a plain list so tests can walk it deterministically.
// * The threshold read is env-cached; tests that toggle it must call
//   nl_ic_reset_cache between scenarios.
//
// Embedded corpus vs. on-disk file
// --------------------------------
// data/nl_intent/prototypes.txt ships the same corpus for operator
// inspection, but the CLASSIFIER embeds it as a string constant
// (_NLIC_CORPUS) so no file I/O is needed at daemon boot. sys_open on
// /tmp under the sandbox container aborts (docs/NOVA_RUNTIME_GAPS.md);
// reading a data file at every start would inherit the same risk.
// Keep the two in sync when adding utterances (a later round can
// unify the two).
//
// NOVA quirks handled
// -------------------
// * str_eq flaky on short literals -> use str_eq_bytes everywhere.
// * str_to_int returns 0 for garbage -> env-parse rejects non-digits
//   explicitly.
// * No floats -> similarity in integer basis points.
// * len(0) crashes -> null-guard every list read.
//
// Dependencies
// ------------
// NOVA builtins: getenv, list_new, push, list_set, str_eq_bytes,
//   char_at, chr, len, int_to_str, println, int_mul, int_div.
// CrossEngin: src/nl/query_shape.nova (SQ constructors + validator),
//   src/kg/hdc_embed.nova (hdc_symbol / hdc_bundle / hdc_cosine),
//   src/util/str_safe.nova (str_eq_bytes, find_bytes, find_char).

import "./query_shape.nova"
import "./nl_metrics.nova"
import "../kg/hdc_embed.nova"
import "../util/str_safe.nova"

// ---- embedded training corpus -----------------------------------------
//
// Semantics mirror data/nl_intent/prototypes.txt: a list of blocks,
// each block a [kind_name, utterances[]] pair; the classifier bundles
// each utterance's token-vectors, then bundles those utterance-vectors
// into a per-kind prototype. Names are the lowercase suffix of the
// NLK_* constants (see _nlic_name_to_kind).
//
// The corpus is built into a NOVA list at init time rather than a
// giant string literal so the compiler stays fast (a several-KB
// left-associative concat literal made the NOVA front-end quadratic
// on early R98 drafts). Keep this list and the .txt file in sync when
// adding utterances.
fn _nlic_utts_research() {
    let l = list_new()
    push(l, "what do you know about photosynthesis")
    push(l, "tell me about the cell cycle")
    push(l, "explain quantum entanglement")
    push(l, "describe the pancreas")
    push(l, "i want to know about black holes")
    push(l, "give me info on the roman empire")
    push(l, "facts about world war two")
    push(l, "history of the printing press")
    push(l, "overview of machine learning")
    push(l, "summary of the french revolution")
    push(l, "background on climate change")
    push(l, "key points about mitochondria")
    push(l, "information on newton laws")
    push(l, "details on the industrial revolution")
    push(l, "what is dna")
    push(l, "define enzyme")
    push(l, "origin of the universe")
    push(l, "how does gravity work")
    push(l, "why is the moon important")
    push(l, "what does osmosis mean")
    return l
}

