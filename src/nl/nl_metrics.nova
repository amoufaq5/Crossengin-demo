// CrossEngin NL Surface: per-holder metrics registry (R95, Phase B).
//
// A minimal counter registry scoped to the NL layer. Not the general
// observability layer (that's a later round); scoped narrowly to what
// the NL adapter needs to answer the question "how often does the
// LLM fallback fire?", which ADR-0211 mandates we drive toward zero.
//
// Slots per holder (each starts at 0):
//
//   total          -- every nl.ask (both wire + chat surface).
//   unparsed       -- grammar_parse returned NLK_UNPARSED.
//   fb_attempts    -- LLM sidecar was actually invoked (available AND
//                     the query was UNPARSED). Sidecar-unavailable
//                     does NOT count -- we only measure "we tried".
//   fb_successes   -- sidecar returned; llm_parse_wire produced a valid
//                     StructuredQuery (llmp_ok == 1).
//   fb_failures    -- attempt fired but returned malformed / kind-less
//                     wire (llmp_ok == 0). fb_attempts always equals
//                     fb_successes + fb_failures.
//
// Per-holder breakdown is important because a noisy holder (say, a
// specific user's IDE plugin issuing malformed queries) should not
// contaminate the aggregate fallback rate for tuning decisions.
// The empty-string holder "" represents anonymous / no-holder-presented
// callers -- kept as a first-class bucket so anonymous vs owned traffic
// stay comparable.
//
// Storage: a small hash-map keyed by holder string with parallel counter
// lists. R95 uses a linear scan (holder count is O(number of unique
// callers per daemon lifetime) and the metric surface is off the hot
// path -- accumulate is O(N) but N is tiny in practice). If a
// deployment grows enough holders that this matters, Phase C+ can
// swap in a proper hash without changing this file's public API.
//
// This module does NOT depend on llm_parser / sidecar / rpc_verbs so
// tests can import it in isolation.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova (str_eq_bytes).

import "../util/str_safe.nova"

// ---- registry slot layout -----------------------------------------------
let NLM_HOLDERS       = 0    // list of holder-id strings
let NLM_TOTAL         = 1    // list of int (parallel with HOLDERS)
let NLM_UNPARSED      = 2    // list of int
let NLM_ATTEMPTS      = 3    // list of int
let NLM_SUCCESSES     = 4    // list of int
let NLM_FAILURES      = 5    // list of int
let NLM_SLOTS         = 6

// ---- snapshot record slot layout (returned by nl_metrics_snapshot) ------
//
// A snapshot is a shallow copy of the registry -- callers get the
// counters as of the moment they read them and can compare across
// reads. The snapshot is a plain list-of-lists; each row is
// [holder, total, unparsed, attempts, successes, failures].
let NLMS_HOLDER       = 0
let NLMS_TOTAL        = 1
let NLMS_UNPARSED     = 2
let NLMS_ATTEMPTS     = 3
let NLMS_SUCCESSES    = 4
let NLMS_FAILURES     = 5
let NLMS_ROW_SLOTS    = 6

// ---- constructor --------------------------------------------------------

fn nl_metrics_new() {
    let r = list_new()
    push(r, list_new())     // HOLDERS
    push(r, list_new())     // TOTAL
    push(r, list_new())     // UNPARSED
    push(r, list_new())     // ATTEMPTS
    push(r, list_new())     // SUCCESSES
    push(r, list_new())     // FAILURES
    return r
}

// ---- internal: locate / create a holder row -----------------------------
//
// Returns the row index (0..len(holders)-1). If `holder` isn't present,
// appends a fresh row with all-zero counters. Empty-string "" is a
// valid key (anonymous bucket).
fn _nlm_row_for(reg, holder) {
    if reg == 0 { return 0 - 1 }
    let holders = reg[NLM_HOLDERS]
    let i = 0
    while i < len(holders) {
        if str_eq_bytes(holders[i], holder) == 1 { return i }
        i = i + 1
    }
    push(reg[NLM_HOLDERS], holder)
    push(reg[NLM_TOTAL], 0)
    push(reg[NLM_UNPARSED], 0)
    push(reg[NLM_ATTEMPTS], 0)
    push(reg[NLM_SUCCESSES], 0)
    push(reg[NLM_FAILURES], 0)
    return len(holders) - 1
}

fn _nlm_inc_slot(reg, slot, holder) {
    if reg == 0 { return 0 }
    let idx = _nlm_row_for(reg, holder)
    if idx < 0 { return 0 }
    let col = reg[slot]
    list_set(col, idx, col[idx] + 1)
    return 1
}

// ---- mutators (public) --------------------------------------------------
//
// Each returns 1 on success, 0 when reg == 0 (a no-op path so callers
// don't need to null-guard when metrics wiring is optional).

fn nl_metrics_inc_total(reg, holder) {
    return _nlm_inc_slot(reg, NLM_TOTAL, holder)
}

fn nl_metrics_inc_unparsed(reg, holder) {
    return _nlm_inc_slot(reg, NLM_UNPARSED, holder)
}

fn nl_metrics_inc_llm_fallback_attempt(reg, holder) {
    return _nlm_inc_slot(reg, NLM_ATTEMPTS, holder)
}

fn nl_metrics_inc_llm_fallback_success(reg, holder) {
    return _nlm_inc_slot(reg, NLM_SUCCESSES, holder)
}

fn nl_metrics_inc_llm_fallback_failure(reg, holder) {
    return _nlm_inc_slot(reg, NLM_FAILURES, holder)
}

// ---- readers (public) ---------------------------------------------------
//
// Direct per-holder reads. Returns 0 if the holder was never seen (no
// row allocated -- avoids side-effect-in-getter).
fn _nlm_read_slot(reg, slot, holder) {
    if reg == 0 { return 0 }
    let holders = reg[NLM_HOLDERS]
    let i = 0
    while i < len(holders) {
        if str_eq_bytes(holders[i], holder) == 1 {
            let col = reg[slot]
            return col[i]
        }
        i = i + 1
    }
    return 0
}

fn nl_metrics_total(reg, holder) {
    return _nlm_read_slot(reg, NLM_TOTAL, holder)
}

fn nl_metrics_unparsed(reg, holder) {
    return _nlm_read_slot(reg, NLM_UNPARSED, holder)
}

fn nl_metrics_llm_fallback_attempts(reg, holder) {
    return _nlm_read_slot(reg, NLM_ATTEMPTS, holder)
}

fn nl_metrics_llm_fallback_successes(reg, holder) {
    return _nlm_read_slot(reg, NLM_SUCCESSES, holder)
}

fn nl_metrics_llm_fallback_failures(reg, holder) {
    return _nlm_read_slot(reg, NLM_FAILURES, holder)
}

// nl_metrics_holder_count(reg) -- number of distinct holders (including
// the "" anonymous bucket if any anonymous traffic was recorded).
fn nl_metrics_holder_count(reg) {
    if reg == 0 { return 0 }
    return len(reg[NLM_HOLDERS])
}

// nl_metrics_snapshot(reg) -- returns a list of rows, each row a
// 6-slot record [holder, total, unparsed, attempts, successes,
// failures]. Reads only; does not mutate the registry (so successive
// calls without any intervening inc() return identical rows).
fn nl_metrics_snapshot(reg) {
    let out = list_new()
    if reg == 0 { return out }
    let holders = reg[NLM_HOLDERS]
    let i = 0
    while i < len(holders) {
        let row = list_new()
        push(row, holders[i])
        push(row, reg[NLM_TOTAL][i])
        push(row, reg[NLM_UNPARSED][i])
        push(row, reg[NLM_ATTEMPTS][i])
        push(row, reg[NLM_SUCCESSES][i])
        push(row, reg[NLM_FAILURES][i])
        push(out, row)
        i = i + 1
    }
    return out
}

// ---- snapshot-row accessors --------------------------------------------

fn nlms_holder(row)     { return row[NLMS_HOLDER] }
fn nlms_total(row)      { return row[NLMS_TOTAL] }
fn nlms_unparsed(row)   { return row[NLMS_UNPARSED] }
fn nlms_attempts(row)   { return row[NLMS_ATTEMPTS] }
fn nlms_successes(row)  { return row[NLMS_SUCCESSES] }
fn nlms_failures(row)   { return row[NLMS_FAILURES] }
