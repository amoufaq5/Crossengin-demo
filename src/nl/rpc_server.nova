// CrossEngin NL Surface: JSON-RPC request server (R49, ADR-0104 §Component 5).
//
// This module is the LINE-IN / LINE-OUT protocol adapter that turns an
// incoming JSON request into a rpc_verbs.rpc_dispatch call and its
// response back into a JSON line. It DOES NOT touch sockets, files, or
// the network -- that's the daemon's job (crossengin_rpc_daemon.nova),
// which reads a line off a socket, hands it here, and writes the
// returned line back. That split keeps the protocol logic testable
// entirely in unit tests (no port to bind, no fixture harness).
//
// Wire protocol (line-oriented; ONE JSON object per line):
//
//   REQUEST:
//     {"verb": "nl.ask", "args": {"text": "what is mars", "user_id": "owner"}}
//     {"verb": "kg.list"}                                (args omitted -> {})
//     {"verb": "nl.ask", "id": 42, "args": {...}}        (id echoed back)
//
//   RESPONSE (from rpc_verbs.rpc_dispatch, envelope threaded through):
//     {"ok": true|false, "result": <verb-specific>, "error": "..."}
//     {"ok": ..., "id": 42, "result": ..., "error": ...}  (if request had id)
//
// Malformed JSON -> {"ok":false, "error":"malformed JSON: ..."}
// Missing "verb"  -> {"ok":false, "error":"missing field: verb"}
// Unknown verb    -> {"ok":false, "error":"unknown verb: X"}  (from dispatch)
//
// Every args value the caller supplies is coerced to STRING for
// rpc_verbs consumption (that's the wire contract rpc_verbs.nova
// enforces on its side). Numbers become their str_to_int inverse
// (e.g. 42 -> "42"), booleans become "true"/"false", null becomes "",
// nested objects/arrays are re-serialized. This mirrors what a JSON
// client naturally builds -- callers do not have to quote numeric ids.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/nl/rpc_verbs.nova
//   src/data/json.nova
//   src/util/str_safe.nova.

import "./rpc_verbs.nova"
import "../data/json.nova"
import "../util/str_safe.nova"

// ---- JSON-value -> string coercion ---------------------------------------

// Coerce ANY JV_* value to a string for rpc_verbs arg consumption.
// Values are the args map's values; keys are always strings already
// (JSON contract). We flatten JV_ARR / JV_OBJ back to their JSON text
// form so a verb that wants a structured value (rare for the current
// 12 verbs) can re-parse via json_parse if it needs to.
fn _rpcs_val_to_str(v) {
    let t = json_type(v)
    if t == JV_STR  { return json_str(v) }
    if t == JV_NUM {
        // Prefer the raw token (preserves negatives, doesn't invent
        // a decimal) if json.nova recorded it; else fall back to the
        // truncated int.
        if len(v) >= 3 { return v[2] }
        return int_to_str(json_num(v))
    }
    if t == JV_BOOL {
        if json_bool(v) == 1 { return "true" }
        return "false"
    }
    if t == JV_NULL { return "" }
    if t == JV_ARR  { return _rpcs_encode(v) }
    if t == JV_OBJ  { return _rpcs_encode(v) }
    return ""
}

// Minimal re-encoder for nested values. We only need enough to turn
// an array/object back into a JSON text that a caller could re-parse.
// Escaping mirrors _rpc_esc in rpc_verbs.nova (same rules).
fn _rpcs_esc(s) {
    let out = ""
    let n = len(s)
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c == 34      { out = out + "\\\"" }
        else if c == 92 { out = out + "\\\\" }
        else if c == 10 { out = out + "\\n" }
        else if c == 13 { out = out + "\\r" }
        else if c == 9  { out = out + "\\t" }
        else if c < 32 {
            let hi = c / 16
            let lo = c - hi * 16
            let hexd = "0123456789abcdef"
            out = out + "\\u00"
                + substr(hexd, hi, 1) + substr(hexd, lo, 1)
        }
        else { out = out + substr(s, i, 1) }
        i = i + 1
    }
    return out
}

fn _rpcs_encode(v) {
    let t = json_type(v)
    if t == JV_NULL { return "null" }
    if t == JV_BOOL {
        if json_bool(v) == 1 { return "true" }
        return "false"
    }
    if t == JV_NUM {
        if len(v) >= 3 { return v[2] }
        return int_to_str(json_num(v))
    }
    if t == JV_STR { return "\"" + _rpcs_esc(json_str(v)) + "\"" }
    if t == JV_ARR {
        let out = "["
        let arr = v[1]
        let i = 0
        while i < len(arr) {
            if i > 0 { out = out + "," }
            out = out + _rpcs_encode(arr[i])
            i = i + 1
        }
        return out + "]"
    }
    if t == JV_OBJ {
        let out = "{"
        let pairs = v[1]
        let i = 0
        while i < len(pairs) {
            if i > 0 { out = out + "," }
            out = out + "\"" + _rpcs_esc(pairs[i][0]) + "\":"
                + _rpcs_encode(pairs[i][1])
            i = i + 1
        }
        return out + "}"
    }
    return "null"
}

// Convert a JSON object (JV_OBJ) into the list<[key, value_string]> shape
// rpc_verbs.rpc_dispatch expects. Non-objects yield an empty list --
// callers can omit args or pass "args": {} equivalently.
fn _rpcs_args_from_json(args_val) {
    let out = list_new()
    if json_type(args_val) != JV_OBJ { return out }
    let pairs = args_val[1]
    let i = 0
    while i < len(pairs) {
        let kv = list_new()
        push(kv, pairs[i][0])
        push(kv, _rpcs_val_to_str(pairs[i][1]))
        push(out, kv)
        i = i + 1
    }
    return out
}

// ---- envelope helpers ----------------------------------------------------

// A malformed-request response. Independent of rpc_verbs so we can
// return one before dispatch runs at all.
fn _rpcs_bad_request(reason) {
    return "{\"ok\":false,\"result\":null,\"error\":\""
        + _rpcs_esc(reason) + "\"}"
}

// Prepend an "id" field to a response if the caller included one.
// Format: rpc_verbs returns "{...}", we splice "id" right after the
// opening brace so the field order is (ok, id, result, error) --
// clients that key-walk see id early.
fn _rpcs_inject_id(response, id_text) {
    if len(id_text) == 0 { return response }
    if len(response) < 2 { return response }
    if char_at(response, 0) != 123 { return response }        // '{'
    // "{\"ok\":X," -> length varies. Simplest: emit id right after the
    // opening brace, before "ok". Client can key by name regardless.
    return "{\"id\":" + id_text + "," + substr(response, 1, len(response) - 1)
}

// ---- entry point ---------------------------------------------------------

// Parse `line` as a JSON RPC request, dispatch through rpc_verbs,
// return the JSON response line. The trailing "\n" is NOT included;
// the socket/stdio layer adds it when framing outbound.
//
// `ctx` is an RpcContext built via rpc_verbs.rpc_ctx_new.
fn rpc_server_handle_line(line, ctx) {
    // Trim ASCII whitespace so a stray "\r" or leading blank does not
    // reject an otherwise-well-formed request.
    let l = str_trim(line)
    if len(l) == 0 { return _rpcs_bad_request("empty request") }
    let jv = json_parse(l)
    if json_is_valid(jv) == 0 {
        return _rpcs_bad_request("malformed JSON")
    }
    if json_type(jv) != JV_OBJ {
        return _rpcs_bad_request("request must be a JSON object")
    }
    if json_has(jv, "verb") == 0 {
        return _rpcs_bad_request("missing field: verb")
    }
    let verb_val = json_get(jv, "verb")
    if json_type(verb_val) != JV_STR {
        return _rpcs_bad_request("field 'verb' must be a string")
    }
    let verb = json_str(verb_val)
    let args_list = list_new()
    if json_has(jv, "args") == 1 {
        args_list = _rpcs_args_from_json(json_get(jv, "args"))
    }
    // Optional client-supplied correlation id.
    let id_text = ""
    if json_has(jv, "id") == 1 {
        let id_val = json_get(jv, "id")
        // Echo the raw JSON encoding of whatever the caller sent (so
        // "id": 42 -> 42; "id": "abc" -> "abc"). Numbers, strings, and
        // null all round-trip; nested objects/arrays are unusual but
        // not rejected.
        id_text = _rpcs_encode(id_val)
    }
    // R54 sandbox: lift the request's "token" field (a bearer id
    // string) into the RpcContext so rpc_dispatch's capability_
    // authorize sees it. Absent field / non-string -> empty presented
    // token; enforcement (if on) refuses with a clear diagnostic.
    let presented = ""
    if json_has(jv, "token") == 1 {
        let tv = json_get(jv, "token")
        if json_type(tv) == JV_STR { presented = json_str(tv) }
    }
    rpc_ctx_set_presented_token(ctx, presented)
    let response = rpc_dispatch(verb, args_list, ctx)
    return _rpcs_inject_id(response, id_text)
}

// ---- server info ---------------------------------------------------------

// Human-readable protocol banner. Daemons print this on stderr at boot
// so operators know exactly what wire this is.
fn rpc_server_banner() {
    return "CrossEngin JSON-RPC (line-oriented; one JSON request per line; "
        + "12 verbs; envelope {ok, result, error}; ADR-0104)"
}
