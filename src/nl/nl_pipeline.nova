// CrossEngin NL Surface: shared three-rung NL pipeline (R98, Phase C part 3).
//
// The pipeline order (ADR-0211) is:
//
//   1. grammar_parse         -- deterministic pattern parser
//                               (src/nl/grammar_parser.nova, R48p2/R97).
//   2. nl_ic_try_classify    -- HDC prototype-vector intent classifier
//                               (src/nl/nl_intent_classifier.nova, R98).
//   3. nl_llm_try_fallback   -- small-LLM sidecar
//                               (src/nl/nl_llm_sidecar.nova, R95).
//
// Both call sites -- `_rpc_verb_nl_ask` in src/nl/rpc_verbs.nova and
// `_try_nl` in examples/crossengin_chat.nova -- funnel through this
// module so the ordering + metric-touch contract stays in ONE place.
// A future round that adds a fourth rung (e.g. KG-driven paraphrase)
// only edits this file.
//
// Metric semantics (see src/nl/nl_metrics.nova for the counters):
//
//   * `total` and `unparsed` are the CALLER's responsibility -- they
//     see the raw request and know whether the grammar returned
//     UNPARSED before we tried the fallback rungs. This function only
//     touches the classifier + sidecar counters.
//
//   * classifier attempt / hit / miss are touched inside
//     `nl_ic_try_classify` itself (already handled).
//
//   * sidecar attempt / success / failure are touched inside
//     `nl_llm_try_fallback` itself (already handled).
//
//   * A CLASSIFIER HIT SKIPS THE SIDECAR ENTIRELY. That is the whole
//     point of R98: reduce the fallback rate before spending a
//     round-trip on the LLM sidecar.
//
// Contract:
//   * If grammar returned a non-UNPARSED SQ, return it unchanged
//     (no classifier attempt, no sidecar attempt).
//   * Otherwise run the classifier; on hit, return its SQ.
//   * Otherwise run the sidecar (which itself no-ops when disabled).
//
// This module does NOT invoke grammar_parse; the caller has already
// done that and passed the result. That keeps the shared function
// free of a grammar_parser.nova import and avoids re-tokenizing the
// same text.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/nl/query_shape.nova
//   src/nl/nl_intent_classifier.nova
//   src/nl/nl_llm_sidecar.nova

import "./query_shape.nova"
import "./nl_intent_classifier.nova"
import "./nl_llm_sidecar.nova"

// Given a grammar-parsed StructuredQuery + raw text + metrics + holder,
// walk the remaining rungs. Returns the (possibly promoted) SQ.
fn nl_pipeline_try_fallback_rungs(q, raw_text, metrics_reg, holder) {
    if q == 0 { return q }
    if sq_kind(q) != NLK_UNPARSED { return q }
    // Rung 2: HDC classifier.
    let ic = nl_ic_try_classify(raw_text, metrics_reg, holder)
    if nl_ic_result_ok(ic) == 1 { return nl_ic_result_sq(ic) }
    // Rung 3: small-LLM sidecar.
    return nl_llm_try_fallback(q, raw_text, metrics_reg, holder)
}
