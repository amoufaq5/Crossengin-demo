// CrossEngin NL Surface: StructuredQuery shape (ADR-0104).
//
// The intermediate representation that BOTH the grammar parser and
// the LLM-fallback parser emit, and that the executor consumes.
// Keeping the shape simple + typed by `kind` is what lets the
// two parsers stay independent and lets a third (e.g. a voice
// parser) drop in later without touching the executor.
//
// A StructuredQuery is ONE user intent, resolved into (kind, args).
// The raw user text and the name of the parser that produced it
// travel alongside so the executor + templater can:
//   * quote the user's original phrasing back at them
//   * source-tag any observation the query records
//   * surface WHICH parser handled the input in the trace
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- kind constants (ADR-0104 §Grammar coverage) --------------------------
//
// Kinds are dense integers so the executor can switch on them cheaply.
// UNPARSED / NONE are sentinels the parsers use to signal "give up" and
// "empty input" without needing a separate error channel.
let NLK_NONE              = 0    // empty / whitespace-only input
let NLK_RESEARCH          = 1    // {topic, optional kind_filter}
let NLK_RELATE            = 2    // {a, b}
let NLK_CONTRADICT_SCAN   = 3    // {a, b}
let NLK_IS_A              = 4    // {x, y}
let NLK_RETRACT           = 5    // {label}
let NLK_CAPSULE_INSTALL   = 6    // {name}
let NLK_SKILL_INSTALL     = 7    // {name}
let NLK_CAPSULE_LIST      = 8    // {}
let NLK_SKILL_LIST        = 9    // {}
let NLK_SKILL_RUN         = 10   // {skill_name, arg}
let NLK_UNPARSED          = 99   // grammar couldn't parse; LLM should try

// ---- StructuredQuery slot layout ------------------------------------------
let SQ_KIND         = 0
let SQ_ARGS         = 1    // list of strings; kind-specific arity
let SQ_RAW_TEXT     = 2    // original user text (for audit + templating)
let SQ_PARSER_USED  = 3    // "grammar" | "llm" | "none"
let SQ_SLOT_COUNT   = 4

// ---- constructors ---------------------------------------------------------

// Empty query with a fresh args list.
fn sq_new(kind, raw_text, parser_used) {
    let q = list_new()
    push(q, kind)
    push(q, list_new())        // ARGS
    push(q, raw_text)
    push(q, parser_used)
    return q
}

// Convenience constructors for the common kinds. Each returns a
// fully-formed, validator-clean StructuredQuery.
fn sq_none(raw_text, parser_used) {
    return sq_new(NLK_NONE, raw_text, parser_used)
}

fn sq_unparsed(raw_text) {
    return sq_new(NLK_UNPARSED, raw_text, "grammar")
}

fn sq_research(topic, raw_text, parser_used) {
    let q = sq_new(NLK_RESEARCH, raw_text, parser_used)
    push(q[SQ_ARGS], topic)
    return q
}

fn sq_research_filtered(topic, kind_filter_name, raw_text, parser_used) {
    let q = sq_new(NLK_RESEARCH, raw_text, parser_used)
    push(q[SQ_ARGS], topic)
    push(q[SQ_ARGS], kind_filter_name)
    return q
}

fn sq_relate(a, b, raw_text, parser_used) {
    let q = sq_new(NLK_RELATE, raw_text, parser_used)
    push(q[SQ_ARGS], a) push(q[SQ_ARGS], b)
    return q
}

fn sq_contradict_scan(a, b, raw_text, parser_used) {
    let q = sq_new(NLK_CONTRADICT_SCAN, raw_text, parser_used)
    push(q[SQ_ARGS], a) push(q[SQ_ARGS], b)
    return q
}

fn sq_is_a(x, y, raw_text, parser_used) {
    let q = sq_new(NLK_IS_A, raw_text, parser_used)
    push(q[SQ_ARGS], x) push(q[SQ_ARGS], y)
    return q
}

fn sq_retract(label, raw_text, parser_used) {
    let q = sq_new(NLK_RETRACT, raw_text, parser_used)
    push(q[SQ_ARGS], label)
    return q
}

fn sq_capsule_install(name, raw_text, parser_used) {
    let q = sq_new(NLK_CAPSULE_INSTALL, raw_text, parser_used)
    push(q[SQ_ARGS], name)
    return q
}

fn sq_skill_install(name, raw_text, parser_used) {
    let q = sq_new(NLK_SKILL_INSTALL, raw_text, parser_used)
    push(q[SQ_ARGS], name)
    return q
}

fn sq_capsule_list(raw_text, parser_used) {
    return sq_new(NLK_CAPSULE_LIST, raw_text, parser_used)
}

fn sq_skill_list(raw_text, parser_used) {
    return sq_new(NLK_SKILL_LIST, raw_text, parser_used)
}

fn sq_skill_run(skill_name, arg, raw_text, parser_used) {
    let q = sq_new(NLK_SKILL_RUN, raw_text, parser_used)
    push(q[SQ_ARGS], skill_name) push(q[SQ_ARGS], arg)
    return q
}

// ---- accessors ------------------------------------------------------------

fn sq_kind(q)         { return q[SQ_KIND] }
fn sq_args(q)         { return q[SQ_ARGS] }
fn sq_raw_text(q)     { return q[SQ_RAW_TEXT] }
fn sq_parser_used(q)  { return q[SQ_PARSER_USED] }
fn sq_arg_count(q)    { return len(q[SQ_ARGS]) }

// Positional arg accessors. Return "" when the requested index is
// out of range so callers can safely `if len(sq_arg(q, 1)) > 0`
// without bounds-checking every call.
fn sq_arg(q, i) {
    let a = q[SQ_ARGS]
    if i < 0 { return "" }
    if i >= len(a) { return "" }
    return a[i]
}

// Named accessors per kind (thin wrappers over sq_arg). Callers that
// know they hold a specific kind get readable code; sq_arg() stays
// available for generic dispatchers.
fn sq_research_topic(q)          { return sq_arg(q, 0) }
fn sq_research_kind_filter(q)    { return sq_arg(q, 1) }
fn sq_relate_a(q)                { return sq_arg(q, 0) }
fn sq_relate_b(q)                { return sq_arg(q, 1) }
fn sq_contradict_a(q)            { return sq_arg(q, 0) }
fn sq_contradict_b(q)            { return sq_arg(q, 1) }
fn sq_is_a_x(q)                  { return sq_arg(q, 0) }
fn sq_is_a_y(q)                  { return sq_arg(q, 1) }
fn sq_retract_label(q)           { return sq_arg(q, 0) }
fn sq_capsule_install_name(q)    { return sq_arg(q, 0) }
fn sq_skill_install_name(q)      { return sq_arg(q, 0) }
fn sq_skill_run_skill(q)         { return sq_arg(q, 0) }
fn sq_skill_run_arg(q)           { return sq_arg(q, 1) }

// ---- validation -----------------------------------------------------------
//
// The validator returns a status code and (on error) a short message.
// It checks:
//   * the kind is one of the known constants
//   * the arg count matches the kind's declared arity
//   * every args[i] that is expected to be non-empty is non-empty
//   * parser_used is one of the known parser names
//   * raw_text is present (empty allowed for NONE / UNPARSED)
//
// Structural only -- content validity (does this atom exist? is this
// capsule registered?) is the executor's job.

let SQ_OK               = 0
let SQ_ERR_UNKNOWN_KIND = -1
let SQ_ERR_ARITY        = -2
let SQ_ERR_EMPTY_ARG    = -3
let SQ_ERR_PARSER_NAME  = -4
let SQ_ERR_MISSING_RAW  = -5

// Return the declared arg arity for a kind. NONE / UNPARSED accept 0
// args; RESEARCH accepts 1 (topic) or 2 (with kind_filter).
fn _sq_expected_arity(kind) {
    if kind == NLK_NONE            { return 0 }
    if kind == NLK_UNPARSED        { return 0 }
    if kind == NLK_RESEARCH        { return 1 }   // OR 2 with kind_filter
    if kind == NLK_RELATE          { return 2 }
    if kind == NLK_CONTRADICT_SCAN { return 2 }
    if kind == NLK_IS_A            { return 2 }
    if kind == NLK_RETRACT         { return 1 }
    if kind == NLK_CAPSULE_INSTALL { return 1 }
    if kind == NLK_SKILL_INSTALL   { return 1 }
    if kind == NLK_CAPSULE_LIST    { return 0 }
    if kind == NLK_SKILL_LIST      { return 0 }
    if kind == NLK_SKILL_RUN       { return 2 }
    return 0 - 1                                   // unknown -> sentinel
}

fn _sq_parser_name_ok(name) {
    if str_eq_bytes(name, "grammar") == 1 { return 1 }
    if str_eq_bytes(name, "llm")     == 1 { return 1 }
    if str_eq_bytes(name, "none")    == 1 { return 1 }
    return 0
}

// Validate. Returns SQ_OK on success, one of the SQ_ERR_* codes on
// failure. Kind-specific arity + empty-arg checks are enforced.
fn sq_validate(q) {
    if q == 0 { return SQ_ERR_UNKNOWN_KIND }
    let kind = q[SQ_KIND]
    let expected = _sq_expected_arity(kind)
    if expected < 0 { return SQ_ERR_UNKNOWN_KIND }
    if _sq_parser_name_ok(q[SQ_PARSER_USED]) == 0 {
        return SQ_ERR_PARSER_NAME
    }
    let args = q[SQ_ARGS]
    let got = len(args)
    // RESEARCH tolerates 1 or 2 args (optional kind_filter).
    if kind == NLK_RESEARCH {
        if got == 0 { return SQ_ERR_ARITY }
        if got > 2  { return SQ_ERR_ARITY }
    } else {
        if got != expected { return SQ_ERR_ARITY }
    }
    // Every arg present must be non-empty. (Empty topic is meaningless
    // for RESEARCH; empty a/b for RELATE etc.)
    let i = 0
    while i < got {
        if len(args[i]) == 0 { return SQ_ERR_EMPTY_ARG }
        i = i + 1
    }
    return SQ_OK
}

// Human-readable label for a validation code.
fn sq_err_name(code) {
    if code == SQ_OK               { return "ok" }
    if code == SQ_ERR_UNKNOWN_KIND { return "unknown-kind" }
    if code == SQ_ERR_ARITY        { return "wrong-arg-count-for-kind" }
    if code == SQ_ERR_EMPTY_ARG    { return "empty-arg-not-allowed" }
    if code == SQ_ERR_PARSER_NAME  { return "unknown-parser-name" }
    if code == SQ_ERR_MISSING_RAW  { return "raw-text-missing" }
    return "unknown"
}

// Human-readable label for a kind (used by templater + trace).
fn sq_kind_name(kind) {
    if kind == NLK_NONE            { return "none" }
    if kind == NLK_RESEARCH        { return "research" }
    if kind == NLK_RELATE          { return "relate" }
    if kind == NLK_CONTRADICT_SCAN { return "contradict-scan" }
    if kind == NLK_IS_A            { return "is-a" }
    if kind == NLK_RETRACT         { return "retract" }
    if kind == NLK_CAPSULE_INSTALL { return "capsule-install" }
    if kind == NLK_SKILL_INSTALL   { return "skill-install" }
    if kind == NLK_CAPSULE_LIST    { return "capsule-list" }
    if kind == NLK_SKILL_LIST      { return "skill-list" }
    if kind == NLK_SKILL_RUN       { return "skill-run" }
    if kind == NLK_UNPARSED        { return "unparsed" }
    return "unknown"
}
