// CrossEngin Phase 2 pt2: minimal fork+exec helper for Ollama sidecars.
//
// Purpose
//   `/ingest ollama <path>` shells out to scripts/llm_extract.sh and
//   only needs the child's exit status (the script writes the .cerec
//   file itself). We don't need the pipe/drain/stdout machinery
//   src/nl/reply_composer_ollama.nova carries. This module gives
//   callers a single primitive:
//
//       os_spawn_and_wait(script_path, argv_ptr) -> int status
//
//   fork() + exec() on the child, waitpid() on the parent. Returns the
//   raw waitpid status (0 = success, non-zero = child exit or signal).
//   Returns -1 on fork failure.
//
// NOVA dependencies: builtins (alloc, fork_process, exec_program,
//   waitpid, exit).
// CrossEngin dependencies: none.

import "std/io"
import "std/string"
import "std/syscall"

// Store a RAW 8-byte zero at the given tagged pointer. NOVA's
// `store64(ptr, 0)` stores raw 1, because integer literal `0`
// compiles to the tagged representation `(0<<1)|1 = 1`. Argv
// terminators (and any C ABI null pointer) must be raw 0, else
// execve walks past the array into garbage and fails EFAULT.
fn os_store_null_terminator(ptr) {
    asm {
        "mov rdi, [rbp-8]"
        "sar rdi, 1"
        "mov qword ptr [rdi], 0"
    }
}

// Returns waitpid status, or -1 on fork failure. Caller is responsible
// for building argv (null-terminated **char*). On exec failure in the
// child, the child exits 127 so the parent's waitpid sees a non-zero
// status.
//
// NOVA runtime quirk: `_nova_fork` returns the raw syscall rax without
// tag-wrapping, but every integer LITERAL in NOVA source is tagged
// `(N<<1)|1`. So `pid == 0` in the child -- where fork returns raw 0 --
// compares raw 0 against raw 1 (the tagged literal), is false, and the
// child falls through to run parent code. The resulting "zombie twin"
// re-enters the chat REPL (reproduced: both parent and child printed
// `bye.` after /quit, each with its own getpid() value).
//
// Workaround: differentiate parent from child via `getpid()`, which
// returns a properly-tagged value and compares correctly. Fork-failure
// detection still rides on `pid < 0` (works for the parent; the child
// never reaches that line).
fn os_spawn_and_wait(script_path, argv_ptr) {
    let parent_pid = getpid()
    let pid = fork_process()
    // CHILD branch: getpid() differs from pre-fork value.
    if getpid() != parent_pid {
        exec_program(script_path, argv_ptr)
        exit(127)
    }
    // PARENT branch: now safe to inspect `pid` for the fork-failure
    // sentinel; the child has already exec'd (or exit(127)'d) above.
    if pid < 0 { return 0 - 1 }
    return waitpid(pid)
}
