// CrossEngin NL Surface: grammar parser (ADR-0104 R48p2).
//
// LLM-free deterministic recognizer for the 15 canonical question
// shapes documented in ADR-0104. Handles ~80% of well-formed
// questions on the domains we ship. Fast, auditable, no network.
//
// PROTOCOL:
//   grammar_parse(text) -> StructuredQuery
//     - empty / whitespace-only    -> sq_none
//     - starts with '/'            -> sq_unparsed (slash-cmd path)
//     - matches a known pattern    -> the corresponding sq_*
//     - anything else              -> sq_unparsed (LLM fallback)
//
// Recognized patterns (v1, in match-priority order):
//   what is X / what are X / what's X            -> RESEARCH
//   what do you know about X                     -> RESEARCH
//   tell me about X                              -> RESEARCH
//   does X relate to Y                           -> RELATE
//   does X contradict Y                          -> CONTRADICT_SCAN
//   is X a Y / is X an Y                         -> IS_A
//   who is X / who are X                         -> RESEARCH (kind_filter="person")
//   when did X / when was X / when is X          -> RESEARCH (kind_filter="event")
//   where is X / where are X                     -> RESEARCH (kind_filter="place")
//   why X (as a fallback question form)          -> RESEARCH
//   retract X                                    -> RETRACT
//   install capsule X / install skill X          -> CAPSULE_INSTALL / SKILL_INSTALL
//   list capsules / list skills                  -> CAPSULE_LIST / SKILL_LIST
//   run skill X on Y / run X on Y                -> SKILL_RUN
//
// Multi-word slot values (X, Y) are joined with a single space so the
// downstream tokenizer (research_skill, persona_project) can split
// them again per its own rules. No underscoring here -- keeps the
// original user phrasing visible in traces.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/nl/query_shape.nova, src/util/str_safe.nova.

import "./query_shape.nova"
import "../util/str_safe.nova"

// ---- normalize + tokenize -------------------------------------------------

fn _gp_is_ws(c) {
    if c == 32 { return 1 }
    if c == 9  { return 1 }
    if c == 13 { return 1 }
    if c == 10 { return 1 }
    return 0
}

// Is `c` a "word" character we keep? ASCII letters + digits + '_' + '-'.
// Everything else (punctuation, apostrophes contracted) is skipped so
// the tokenizer produces clean per-word units.
fn _gp_is_wordchar(c) {
    if c >= 65 { if c <= 90  { return 1 } }
    if c >= 97 { if c <= 122 { return 1 } }
    if c >= 48 { if c <= 57  { return 1 } }
    if c == 95 { return 1 }         // '_'
    if c == 45 { return 1 }         // '-'
    return 0
}

fn _gp_lower_char(c) {
    if c >= 65 { if c <= 90 { return c + 32 } }
    return c
}

// Trim leading '/' + surrounding whitespace + trailing '?' or '.' from
// the raw text. The '/' check lets the caller re-run the slash-command
// dispatcher on inputs that start with one.
fn _gp_slash_prefixed(text) {
    let n = len(text)
    let i = 0
    while i < n {
        if _gp_is_ws(char_at(text, i)) == 1 { i = i + 1 }
        else { if char_at(text, i) == 47 { return 1 }
               else { return 0 } }
    }
    return 0
}

fn _gp_is_blank(text) {
    let n = len(text)
    let i = 0
    while i < n {
        if _gp_is_ws(char_at(text, i)) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Split `text` into lowercase whitespace-separated word tokens.
// Punctuation is stripped (each word runs while chars are wordchars).
// Apostrophes / question marks / commas etc. act as token boundaries.
fn _gp_tokenize(text) {
    let out = list_new()
    let n = len(text)
    let start = 0 - 1
    let i = 0
    while i < n {
        let c = char_at(text, i)
        if _gp_is_wordchar(c) == 1 {
            if start < 0 { start = i }
        } else {
            if start >= 0 {
                push(out, _gp_lower_slice(text, start, i))
                start = 0 - 1
            }
        }
        i = i + 1
    }
    if start >= 0 { push(out, _gp_lower_slice(text, start, n)) }
    return out
}

fn _gp_lower_slice(text, from, to) {
    let out = ""
    let i = from
    while i < to {
        out = out + chr(_gp_lower_char(char_at(text, i)))
        i = i + 1
    }
    return out
}

// ---- match helpers --------------------------------------------------------

// True if `tokens[start..start+n-1]` equals `words[0..n-1]`.
// (n = len(words). Out-of-range = mismatch.)
fn _gp_match_seq(tokens, start, words) {
    let n = len(words)
    if start + n > len(tokens) { return 0 }
    let i = 0
    while i < n {
        if str_eq_bytes(tokens[start + i], words[i]) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Find the first index of `word` in tokens at or after `from`; -1 if absent.
fn _gp_find_token(tokens, word, from) {
    let i = from
    while i < len(tokens) {
        if str_eq_bytes(tokens[i], word) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// Join tokens[from..to) with a single space. Returns "" if the range
// is empty or invalid.
fn _gp_join(tokens, from, to) {
    if from >= to { return "" }
    if from < 0 { return "" }
    if to > len(tokens) { return "" }
    let out = tokens[from]
    let i = from + 1
    while i < to {
        out = out + " " + tokens[i]
        i = i + 1
    }
    return out
}

// ---- word-list convenience: build a list<string> from up to 4 words -----
//
// NOVA doesn't have literal list syntax that plays nicely with function
// arguments, so give _gp_match_seq's callers small builders.

fn _gp_w1(w1) {
    let l = list_new() push(l, w1) return l
}

fn _gp_w2(w1, w2) {
    let l = list_new() push(l, w1) push(l, w2) return l
}

fn _gp_w3(w1, w2, w3) {
    let l = list_new() push(l, w1) push(l, w2) push(l, w3) return l
}

fn _gp_w5(w1, w2, w3, w4, w5) {
    let l = list_new()
    push(l, w1) push(l, w2) push(l, w3) push(l, w4) push(l, w5)
    return l
}

// ---- pattern matchers ----------------------------------------------------
//
// Each _try_* matcher returns a StructuredQuery on match, or 0 on
// mismatch. Grammar_parse walks them in priority order and returns
// the first hit.

// "what is X" / "what are X" / "what's X" (n >= 3, first 2 tokens fixed)
fn _try_what_is(tokens, raw) {
    if len(tokens) < 3 { return 0 }
    let t0 = tokens[0]
    if str_eq_bytes(t0, "what") == 0 { return 0 }
    let t1 = tokens[1]
    let is_form = 0
    if str_eq_bytes(t1, "is")  == 1 { is_form = 1 }
    if str_eq_bytes(t1, "are") == 1 { is_form = 1 }
    if str_eq_bytes(t1, "was") == 1 { is_form = 1 }
    if str_eq_bytes(t1, "were") == 1 { is_form = 1 }
    if is_form == 0 { return 0 }
    let topic = _gp_join(tokens, 2, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research(topic, raw, "grammar")
}

// "what do you know about X" (5 fixed tokens then topic)
fn _try_what_do_you_know_about(tokens, raw) {
    if len(tokens) < 6 { return 0 }
    let prefix = _gp_w5("what", "do", "you", "know", "about")
    if _gp_match_seq(tokens, 0, prefix) == 0 { return 0 }
    let topic = _gp_join(tokens, 5, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research(topic, raw, "grammar")
}

// "tell me about X" (3 fixed then topic)
fn _try_tell_me_about(tokens, raw) {
    if len(tokens) < 4 { return 0 }
    let prefix = _gp_w3("tell", "me", "about")
    if _gp_match_seq(tokens, 0, prefix) == 0 { return 0 }
    let topic = _gp_join(tokens, 3, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research(topic, raw, "grammar")
}

// "does X relate to Y" -- X is between "does" and "relate"; Y after "to".
// Also matches "does X contradict Y" via a different verb (no "to").
// Min length is 4 tokens (does + X + verb + Y); "does X relate to Y"
// requires 5 but the "to" is treated as optional and skipped inside
// the extractor.
fn _try_does_relate_or_contradict(tokens, raw) {
    if len(tokens) < 4 { return 0 }
    if str_eq_bytes(tokens[0], "does") == 0 { return 0 }
    let rel_idx = _gp_find_token(tokens, "relate", 1)
    let contra_idx = _gp_find_token(tokens, "contradict", 1)
    let verb_idx = 0 - 1
    let kind = NLK_RESEARCH  // placeholder
    if rel_idx >= 0 { verb_idx = rel_idx  kind = NLK_RELATE }
    if contra_idx >= 0 {
        // If BOTH present, use the earlier one.
        if verb_idx < 0 { verb_idx = contra_idx  kind = NLK_CONTRADICT_SCAN }
        else { if contra_idx < verb_idx { verb_idx = contra_idx  kind = NLK_CONTRADICT_SCAN } }
    }
    if verb_idx <= 1 { return 0 }
    // X = tokens[1..verb_idx)
    let x = _gp_join(tokens, 1, verb_idx)
    if len(x) == 0 { return 0 }
    // "to" is optional after "relate" (grammar accepts "relate Y" too).
    let y_start = verb_idx + 1
    if y_start < len(tokens) {
        if str_eq_bytes(tokens[y_start], "to") == 1 { y_start = y_start + 1 }
    }
    let y = _gp_join(tokens, y_start, len(tokens))
    if len(y) == 0 { return 0 }
    if kind == NLK_RELATE           { return sq_relate(x, y, raw, "grammar") }
    if kind == NLK_CONTRADICT_SCAN  { return sq_contradict_scan(x, y, raw, "grammar") }
    return 0
}

// "is X a Y" / "is X an Y"
fn _try_is_a(tokens, raw) {
    if len(tokens) < 4 { return 0 }
    if str_eq_bytes(tokens[0], "is") == 0 { return 0 }
    // Find "a" or "an" at position >= 2 (so X is at least 1 token).
    let a_idx = 0 - 1
    let i = 2
    while i < len(tokens) - 1 {
        if str_eq_bytes(tokens[i], "a")  == 1 { a_idx = i i = len(tokens) }
        else { if str_eq_bytes(tokens[i], "an") == 1 { a_idx = i i = len(tokens) }
               else { i = i + 1 } }
    }
    if a_idx < 2 { return 0 }
    let x = _gp_join(tokens, 1, a_idx)
    let y = _gp_join(tokens, a_idx + 1, len(tokens))
    if len(x) == 0 { return 0 }
    if len(y) == 0 { return 0 }
    return sq_is_a(x, y, raw, "grammar")
}

// "who is X" / "who are X" -> RESEARCH filtered to person-kind atoms
fn _try_who_is(tokens, raw) {
    if len(tokens) < 3 { return 0 }
    if str_eq_bytes(tokens[0], "who") == 0 { return 0 }
    let t1 = tokens[1]
    let ok = 0
    if str_eq_bytes(t1, "is")   == 1 { ok = 1 }
    if str_eq_bytes(t1, "are")  == 1 { ok = 1 }
    if str_eq_bytes(t1, "was")  == 1 { ok = 1 }
    if str_eq_bytes(t1, "were") == 1 { ok = 1 }
    if ok == 0 { return 0 }
    let topic = _gp_join(tokens, 2, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research_filtered(topic, "person", raw, "grammar")
}

// "when did X" / "when was X" / "when is X" -> RESEARCH filtered "event"
fn _try_when(tokens, raw) {
    if len(tokens) < 3 { return 0 }
    if str_eq_bytes(tokens[0], "when") == 0 { return 0 }
    let t1 = tokens[1]
    let ok = 0
    if str_eq_bytes(t1, "did")  == 1 { ok = 1 }
    if str_eq_bytes(t1, "was")  == 1 { ok = 1 }
    if str_eq_bytes(t1, "is")   == 1 { ok = 1 }
    if str_eq_bytes(t1, "were") == 1 { ok = 1 }
    if str_eq_bytes(t1, "are")  == 1 { ok = 1 }
    if ok == 0 { return 0 }
    let topic = _gp_join(tokens, 2, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research_filtered(topic, "event", raw, "grammar")
}

// "where is X" / "where are X" -> RESEARCH filtered "place"
fn _try_where_is(tokens, raw) {
    if len(tokens) < 3 { return 0 }
    if str_eq_bytes(tokens[0], "where") == 0 { return 0 }
    let t1 = tokens[1]
    let ok = 0
    if str_eq_bytes(t1, "is")   == 1 { ok = 1 }
    if str_eq_bytes(t1, "are")  == 1 { ok = 1 }
    if str_eq_bytes(t1, "was")  == 1 { ok = 1 }
    if str_eq_bytes(t1, "were") == 1 { ok = 1 }
    if ok == 0 { return 0 }
    let topic = _gp_join(tokens, 2, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research_filtered(topic, "place", raw, "grammar")
}

// "why X" (loose form -- RESEARCH fallback; the proof-search skill,
// when it lands, will overshadow this with a more specific pattern)
fn _try_why(tokens, raw) {
    if len(tokens) < 2 { return 0 }
    if str_eq_bytes(tokens[0], "why") == 0 { return 0 }
    let topic = _gp_join(tokens, 1, len(tokens))
    if len(topic) == 0 { return 0 }
    return sq_research(topic, raw, "grammar")
}

// "retract X"
fn _try_retract(tokens, raw) {
    if len(tokens) < 2 { return 0 }
    if str_eq_bytes(tokens[0], "retract") == 0 { return 0 }
    let label = _gp_join(tokens, 1, len(tokens))
    if len(label) == 0 { return 0 }
    return sq_retract(label, raw, "grammar")
}

// "install capsule X" / "install skill X"
fn _try_install(tokens, raw) {
    if len(tokens) < 3 { return 0 }
    if str_eq_bytes(tokens[0], "install") == 0 { return 0 }
    let t1 = tokens[1]
    let name = _gp_join(tokens, 2, len(tokens))
    if len(name) == 0 { return 0 }
    if str_eq_bytes(t1, "capsule") == 1 { return sq_capsule_install(name, raw, "grammar") }
    if str_eq_bytes(t1, "skill")   == 1 { return sq_skill_install(name, raw, "grammar") }
    return 0
}

// "list capsules" / "list skills"
fn _try_list(tokens, raw) {
    if len(tokens) < 2 { return 0 }
    if str_eq_bytes(tokens[0], "list") == 0 { return 0 }
    let t1 = tokens[1]
    if str_eq_bytes(t1, "capsules") == 1 { return sq_capsule_list(raw, "grammar") }
    if str_eq_bytes(t1, "capsule")  == 1 { return sq_capsule_list(raw, "grammar") }
    if str_eq_bytes(t1, "skills")   == 1 { return sq_skill_list(raw, "grammar") }
    if str_eq_bytes(t1, "skill")    == 1 { return sq_skill_list(raw, "grammar") }
    return 0
}

// "run skill X on Y" / "run X on Y" (2-word skill name allowed if ambiguity
// avoided; X is between "run"/"run skill" and "on", Y after "on")
fn _try_run_skill(tokens, raw) {
    if len(tokens) < 3 { return 0 }
    if str_eq_bytes(tokens[0], "run") == 0 { return 0 }
    let skill_start = 1
    if str_eq_bytes(tokens[1], "skill") == 1 { skill_start = 2 }
    if skill_start >= len(tokens) { return 0 }
    let on_idx = _gp_find_token(tokens, "on", skill_start)
    if on_idx < 0 {
        // "run skill NAME" with no argument -- allow, arg = empty.
        // But validator requires non-empty args; so require an "on Y".
        return 0
    }
    if on_idx == skill_start { return 0 }   // skill name missing
    let skill_name = _gp_join(tokens, skill_start, on_idx)
    let arg = _gp_join(tokens, on_idx + 1, len(tokens))
    if len(skill_name) == 0 { return 0 }
    if len(arg) == 0 { return 0 }
    return sq_skill_run(skill_name, arg, raw, "grammar")
}

// ---- entry point ----------------------------------------------------------

// Match patterns in priority order. First hit wins. Fall through to
// UNPARSED so the caller can escalate to the LLM fallback.
fn grammar_parse(text) {
    if _gp_is_blank(text) == 1 { return sq_none(text, "grammar") }
    // Slash-commands bypass the NL layer entirely.
    if _gp_slash_prefixed(text) == 1 { return sq_unparsed(text) }
    let tokens = _gp_tokenize(text)
    if len(tokens) == 0 { return sq_none(text, "grammar") }
    // ---- ordered pattern list (more-specific FIRST) ------------------
    let r = _try_what_do_you_know_about(tokens, text)
    if r != 0 { return r }
    r = _try_tell_me_about(tokens, text)
    if r != 0 { return r }
    r = _try_what_is(tokens, text)
    if r != 0 { return r }
    r = _try_does_relate_or_contradict(tokens, text)
    if r != 0 { return r }
    r = _try_is_a(tokens, text)
    if r != 0 { return r }
    r = _try_who_is(tokens, text)
    if r != 0 { return r }
    r = _try_when(tokens, text)
    if r != 0 { return r }
    r = _try_where_is(tokens, text)
    if r != 0 { return r }
    r = _try_retract(tokens, text)
    if r != 0 { return r }
    r = _try_install(tokens, text)
    if r != 0 { return r }
    r = _try_list(tokens, text)
    if r != 0 { return r }
    r = _try_run_skill(tokens, text)
    if r != 0 { return r }
    // WHY has the loosest pattern; try it last so it doesn't shadow
    // more specific matchers.
    r = _try_why(tokens, text)
    if r != 0 { return r }
    return sq_unparsed(text)
}
