// CrossEngin scheduler: event dispatch.
//
// Purpose
//   The event-driven half of the hybrid scheduler (ADR-0037). Events -- moments,
//   goal activations, emotion broadcasts, fetch completions, and inter-loop
//   messages -- are posted to a priority queue; draining wakes the relevant
//   coordination. Events decide *when* and *how fast* the substrate ticks; the
//   tick (tick_loop) decides *how* dynamics advance. Higher-priority events
//   (user input) are served before background ones, FIFO within a priority.
//
//   True typed channels across concurrent fibers are NOVA enhancement #3; this
//   is the functional event queue the single-threaded coordinator drains.
//
// ADRs implemented: ADR-0037 (event layer). NOVA dependencies: builtins.
// CrossEngin dependencies: none.

// ---- event kinds and priorities -------------------------------------------
let EV_MESSAGE = 1   // user/inter-loop message (highest)
let EV_MOMENT  = 2   // a new perception moment
let EV_FETCH   = 3   // a fetch completed
let EV_GOAL    = 4   // a goal activation
let EV_EMOTION = 5   // an emotion broadcast (lowest)

fn event_priority(kind) {
    if kind == EV_MESSAGE { return 9 }
    if kind == EV_MOMENT  { return 7 }
    if kind == EV_FETCH   { return 5 }
    if kind == EV_GOAL    { return 4 }
    if kind == EV_EMOTION { return 2 }
    return 0
}

// ---- event ----------------------------------------------------------------
let EVT_KIND    = 0
let EVT_PAYLOAD = 1
let EVT_PRI     = 2

fn event_kind(e)    { return e[EVT_KIND] }
fn event_payload(e) { return e[EVT_PAYLOAD] }
fn event_pri(e)     { return e[EVT_PRI] }

// ---- queue ----------------------------------------------------------------
let EQ_TAG  = 0
let EQ_LIST = 1

fn evq_new() {
    let q = list_new()
    push(q, EQ_TAG)
    push(q, list_new())
    return q
}

fn evq_post(q, kind, payload) {
    let e = list_new()
    push(e, kind)
    push(e, payload)
    push(e, event_priority(kind))
    push(q[EQ_LIST], e)
    return 1
}

fn evq_pending(q) { return len(q[EQ_LIST]) }
fn evq_is_empty(q) { if len(q[EQ_LIST]) == 0 { return 1 } return 0 }

// Remove and return the highest-priority, oldest event (0 if empty).
fn evq_drain(q) {
    let l = q[EQ_LIST]
    if len(l) == 0 { return 0 }
    let best = 0
    let i = 1
    while i < len(l) {
        if l[i][EVT_PRI] > l[best][EVT_PRI] { best = i }
        i = i + 1
    }
    let e = l[best]
    list_remove(l, best)
    return e
}
