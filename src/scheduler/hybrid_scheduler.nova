// CrossEngin scheduler: hybrid tick + event scheduler.
//
// Purpose
//   Fuses the deterministic substrate tick (tick_loop) with the event layer
//   (event_dispatch) into the ADR-0037 hybrid scheduler. Events wake the
//   scheduler and keep it in the active (100Hz) regime; a run of empty ticks is
//   idle detection, which throttles toward 10Hz and gates the imagination loop
//   (ADR-0036). One scheduler step drains a pending event (if any), advances the
//   substrate one tick, and updates the idle/active regime.
//
//   Substrate-subtree only (tick_loop -> tick_driver; event_dispatch is
//   standalone), so it composes without crossing into the kg subtree
//   (NOVA blocker #10). The cognitive loops are driven separately and wired to
//   this scheduler at the agent top level (Phase 10).
//
//   Wall-clock pacing (P0.6): hs_step accepts an optional pacer state (see
//   src/scheduler/realtime_pacer.nova). When the pacer is enabled via
//   CE_REALTIME=1, the step samples nanotime at entry and end, sleeps the
//   remainder of the current tick budget (10ms active, 100ms idle), and
//   counts overruns. The pacer functions are no-ops when disabled, so unit
//   tests that drive the scheduler at full speed are unaffected.
//
// ADRs implemented: ADR-0037 (hybrid scheduler), ADR-0036 (idle gating).
// NOVA dependencies: builtins. CrossEngin dependencies:
//   src/scheduler/tick_loop.nova, src/scheduler/event_dispatch.nova,
//   src/scheduler/realtime_pacer.nova (used through hs_step_paced).

import "tick_loop.nova"
import "event_dispatch.nova"
import "realtime_pacer.nova"

// Wall-clock budgets for the two regimes. 100Hz -> 10ms, 10Hz -> 100ms. Kept
// here (next to the rate constants in tick_loop) so that any future rate
// change has exactly one site to update.
let HS_BUDGET_ACTIVE_NS = 10000000
let HS_BUDGET_IDLE_NS   = 100000000

// Idle after this many consecutive ticks with no events.
let HS_IDLE_THRESHOLD = 20

let HS_TAG        = 0
let HS_TICK       = 1
let HS_EVENTS     = 2
let HS_IDLE_TICKS = 3

fn hs_new(reg) {
    let hs = list_new()
    push(hs, HS_TAG)
    push(hs, tick_loop_new(reg))
    push(hs, evq_new())
    push(hs, 0)
    return hs
}

fn hs_tick_loop(hs) { return hs[HS_TICK] }
fn hs_now(hs)       { return tl_now(hs[HS_TICK]) }
fn hs_rate(hs)      { return tl_rate(hs[HS_TICK]) }
fn hs_idle_ticks(hs){ return hs[HS_IDLE_TICKS] }
fn hs_pending(hs)   { return evq_pending(hs[HS_EVENTS]) }

// Post an event (wakes the scheduler to the active regime).
fn hs_post_event(hs, kind, payload) {
    evq_post(hs[HS_EVENTS], kind, payload)
    return 1
}

// Idle once the no-event run reaches the threshold.
fn hs_is_idle(hs) {
    if hs[HS_IDLE_TICKS] >= HS_IDLE_THRESHOLD { return 1 }
    return 0
}

// One scheduler step: drain at most one event, advance the substrate one tick,
// and update the idle/active regime. Returns the drained event (0 if none).
fn hs_step(hs, modulator, error) {
    let ev = evq_drain(hs[HS_EVENTS])
    if ev != 0 {
        list_set(hs, HS_IDLE_TICKS, 0)
        tl_go_active(hs[HS_TICK])
    } else {
        list_set(hs, HS_IDLE_TICKS, hs[HS_IDLE_TICKS] + 1)
        if hs_is_idle(hs) == 1 { tl_go_idle(hs[HS_TICK]) }
    }
    tl_tick(hs[HS_TICK], modulator, error)
    return ev
}

// Paced variant: wraps hs_step in pacer_begin / pacer_end so the regime's
// wall-clock budget is honored. The pacer's per-call no-op gate decides
// whether wall-clock pacing is in effect; if it's disabled (the default in
// unit tests and any deployment without CE_REALTIME=1), this is equivalent to
// hs_step. The budget is chosen by the CURRENT rate so a tick that just
// transitioned active->idle sleeps the new 100ms (the call-site can't tell
// from outside, which is the point: wall-clock pacing is transparent).
fn hs_step_paced(hs, modulator, error, pacer) {
    pacer_begin(pacer)
    let ev = hs_step(hs, modulator, error)
    let budget = HS_BUDGET_ACTIVE_NS
    if hs_rate(hs) == TICK_RATE_IDLE { budget = HS_BUDGET_IDLE_NS }
    pacer_end(pacer, budget)
    return ev
}
