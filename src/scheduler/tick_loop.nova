// CrossEngin scheduler: tick loop.
//
// Purpose
//   The deterministic substrate tick (ADR-0037), layered beneath the loops. It
//   advances node/synapse dynamics via the substrate tick driver and tracks the
//   target rate, which throttles between active (100Hz) and idle (~10Hz). The
//   five ADR-0037 tick phases (drain, propagate, plasticity, decay, predict) are
//   realized by tick_driver's four-phase tick (snapshot, integrate, propagate,
//   learn); plasticity commits only at the tick boundary, so the loops never see
//   half-updated synapses.
//
//   Wall-clock pacing of the rate is NOVA enhancement #5; this tracks the
//   *logical* tick and the chosen rate. Substrate-subtree only.
//
// ADRs implemented: ADR-0037 (tick layer). NOVA dependencies: builtins.
// CrossEngin dependencies: src/substrate/tick_driver.nova.

import "../substrate/tick_driver.nova"

let TICK_RATE_ACTIVE = 100   // Hz under active cognition
let TICK_RATE_IDLE   = 10    // Hz when idle

let TL_TAG    = 0
let TL_ENGINE = 1
let TL_RATE   = 2

fn tick_loop_new(reg) {
    let tl = list_new()
    push(tl, TL_TAG)
    push(tl, td_engine_new(reg))
    push(tl, TICK_RATE_ACTIVE)
    return tl
}

fn tl_rate(tl) { return tl[TL_RATE] }
fn tl_now(tl)  { return td_now(tl[TL_ENGINE]) }
fn tl_engine(tl) { return tl[TL_ENGINE] }

// Adaptive rate (ADR-0037 tick_set_rate); clamped to [idle, active].
fn tl_set_rate(tl, hz) {
    let r = hz
    if r < TICK_RATE_IDLE { r = TICK_RATE_IDLE }
    if r > TICK_RATE_ACTIVE { r = TICK_RATE_ACTIVE }
    list_set(tl, TL_RATE, r)
    return r
}

fn tl_go_active(tl) { return tl_set_rate(tl, TICK_RATE_ACTIVE) }
fn tl_go_idle(tl)   { return tl_set_rate(tl, TICK_RATE_IDLE) }

// Advance the substrate one tick (all active parts). Returns nodes fired.
fn tl_tick(tl, modulator, error) {
    return td_step(tl[TL_ENGINE], modulator, error)
}

// Advance n ticks; returns total nodes fired.
fn tl_run(tl, n, modulator, error) {
    return td_run(tl[TL_ENGINE], n, modulator, error)
}
