// CrossEngin factory: KG-atom predicate filter (R99, ADR-0203/0204).
//
// Given a KG registry + a BakeManifest + a capsule registry, walk every
// live atom in every KG and decide (per atom) whether it survives the
// bake filter. The atom passes iff ANY of:
//
//   1. It belongs to a capsule whose name appears in the manifest's
//      ALLOW_KG_CAPSULE list (via capreg_capsules_owning_atom).
//
//   2. Its KG's label starts with any of the manifest's
//      ALLOW_SOURCE_PREFIX strings. (In CrossEngin the KG label
//      identifies the source domain -- "solar_system", "wikidata",
//      etc. -- so a prefix filter over KG label is the practical
//      source-provenance filter.)
//
//   3. Its `atom_license` integer code matches a license string in
//      the manifest's ALLOW_LICENSE list (license names are the
//      well-known constants: UNKNOWN / OWNER / OPEN / CC_BY_SA /
//      PROPRIETARY -- matches src/kg/atom_store.nova).
//
// Wildcard behavior: a list containing the literal "*" means "any
// atom matches this predicate". Empty lists reject (predicate fails).
// Empty MANIFEST (no ALLOW_* directives at all) => NO atoms selected;
// that's the safe default for bake.
//
// Selected atoms are returned as a list of [kg_label, atom_id, atom]
// triples so the bake pipeline can serialize them without re-walking
// the registry.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/factory/bake_manifest.nova
//   src/kg/multi_kg_manager.nova       (kgreg walk, kg_atoms, kg_label)
//   src/kg/atom_store.nova              (atom_id, atom_license, LICENSE_*)
//   src/capsules/capsule_registry.nova  (capreg_capsules_owning_atom)
//   src/capsules/capsule.nova           (capsule_name)
//   src/util/str_safe.nova.

import "./bake_manifest.nova"
import "../kg/multi_kg_manager.nova"
import "../kg/atom_store.nova"
import "../capsules/capsule_registry.nova"
import "../capsules/capsule.nova"
import "../util/str_safe.nova"

// Test `list_has_star`: does `lst` contain the wildcard literal "*"?
fn _kgf_has_star(lst) {
    let i = 0
    while i < len(lst) {
        if str_eq_bytes(lst[i], "*") == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Prefix match: does `s` start with `prefix`?
fn _kgf_starts_with(s, prefix) {
    let pn = len(prefix)
    if pn == 0 { return 0 }              // empty prefix matches nothing (safe)
    if pn > len(s) { return 0 }
    let i = 0
    while i < pn {
        if char_at(s, i) != char_at(prefix, i) { return 0 }
        i = i + 1
    }
    return 1
}

// Map a license-name string (e.g. "OPEN") to the integer code from
// src/kg/atom_store.nova. Returns -1 for unknown names so the caller
// can drop that entry silently.
fn _kgf_license_code(name) {
    if str_eq_bytes(name, "UNKNOWN")     == 1 { return LICENSE_UNKNOWN }
    if str_eq_bytes(name, "OWNER")       == 1 { return LICENSE_OWNER }
    if str_eq_bytes(name, "OPEN")        == 1 { return LICENSE_OPEN }
    if str_eq_bytes(name, "CC_BY_SA")    == 1 { return LICENSE_CC_BY_SA }
    if str_eq_bytes(name, "PROPRIETARY") == 1 { return LICENSE_PROPRIETARY }
    return 0 - 1
}

// Predicate 1: is `atom_id` owned by any capsule in `allowed_names`?
// Returns 1 iff any capsule in the registry named in allowed_names
// claims the atom. Wildcard "*" in the list means "any capsule at all
// claims the atom" -- for uniformity we still require the atom be
// claimed by SOME capsule, so a wildcard entry equals "atoms with any
// capsule membership pass".
fn _kgf_capsule_membership_pass(atom_id, capreg, allowed_names) {
    if capreg == 0 { return 0 }
    if len(allowed_names) == 0 { return 0 }
    let owners = capreg_capsules_owning_atom(capreg, atom_id)
    if len(owners) == 0 { return 0 }
    if _kgf_has_star(allowed_names) == 1 { return 1 }
    let i = 0
    while i < len(owners) {
        let cname = capsule_name(owners[i])
        let j = 0
        while j < len(allowed_names) {
            if str_eq_bytes(cname, allowed_names[j]) == 1 { return 1 }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

// Predicate 2: does `kg_label` start with any prefix in the allowlist?
fn _kgf_source_prefix_pass(kg_label, prefixes) {
    if len(prefixes) == 0 { return 0 }
    if _kgf_has_star(prefixes) == 1 { return 1 }
    let i = 0
    while i < len(prefixes) {
        if _kgf_starts_with(kg_label, prefixes[i]) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Predicate 3: does `atom_license` (an int code) match any name in the
// allowlist?
fn _kgf_license_pass(license_code, license_names) {
    if len(license_names) == 0 { return 0 }
    if _kgf_has_star(license_names) == 1 { return 1 }
    let i = 0
    while i < len(license_names) {
        let want = _kgf_license_code(license_names[i])
        if want >= 0 { if want == license_code { return 1 } }
        i = i + 1
    }
    return 0
}

// Match one atom against the manifest. Returns 1 iff any predicate
// passes. Callers pass `kg_label` explicitly (walk-caller has it).
fn kg_filter_matches(atom, atom_id, kg_label, manifest, capreg) {
    if atom == 0 { return 0 }
    if manifest == 0 { return 0 }
    let caps = bake_manifest_kg_capsules(manifest)
    let prefixes = bake_manifest_kg_prefixes(manifest)
    let licenses = bake_manifest_kg_licenses(manifest)
    if _kgf_capsule_membership_pass(atom_id, capreg, caps) == 1 { return 1 }
    if _kgf_source_prefix_pass(kg_label, prefixes) == 1 { return 1 }
    if _kgf_license_pass(atom_license(atom), licenses) == 1 { return 1 }
    return 0
}

// Walk `kgreg` and return every [kg_label, atom_id, atom] triple that
// matches. Reclaimed (0) atom slots are skipped. Result preserves KG
// iteration order (audit-friendly).
fn kg_filter_selected_atoms(kgreg, manifest, capreg) {
    let out = list_new()
    if kgreg == 0 { return out }
    if manifest == 0 { return out }
    let n = kg_count(kgreg)
    let i = 0
    while i < n {
        let kg = kgreg[1][i]           // KREG_KGS = 1
        let lbl = kg_label(kg)
        let atoms = kg_atoms(kg)
        let j = 0
        while j < len(atoms) {
            let a = atoms[j]
            if a != 0 {
                let aid = atom_id(a)
                if kg_filter_matches(a, aid, lbl, manifest, capreg) == 1 {
                    let trip = list_new()
                    push(trip, lbl)
                    push(trip, aid)
                    push(trip, a)
                    push(out, trip)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Convenience: does an atom-id appear in a selected-atom triple list?
// (Used by the KG section scoped serializer.)
fn kg_filter_selected_has(selected, kg_label, atom_id) {
    let i = 0
    while i < len(selected) {
        let t = selected[i]
        if t[1] == atom_id {
            if str_eq_bytes(t[0], kg_label) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}
