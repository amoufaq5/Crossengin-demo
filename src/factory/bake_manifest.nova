// CrossEngin factory: BakeManifest parser + accessors (R99, ADR-0203/0204).
//
// A BakeManifest is the recipe a mother reads to bake a filtered child
// bundle: WHICH capsules, WHICH skills, WHICH patterns, WHICH personas,
// WHICH policies, WHICH KG atoms end up in the emitted bundle.
//
// File format (line-oriented text):
//
//   BAKE-MANIFEST v1
//   NAME <name>
//   VERSION <ver>
//   DOMAIN <domain>
//   ALLOW_CAPSULE <capsule_name>          # repeatable
//   ALLOW_SKILL <skill_name>              # repeatable
//   ALLOW_PATTERN <pattern_capsule_name>  # repeatable
//   PERSONA_USER <uid>                    # repeatable
//   ALLOW_POLICY <policy_name>            # repeatable
//   ALLOW_KG_CAPSULE <capsule_name>       # KG atoms owned by this capsule
//   ALLOW_SOURCE_PREFIX <prefix>          # atom KG-label starts with prefix
//   ALLOW_LICENSE <license_name>          # license constant name (e.g. OPEN)
//   STYLE <capsule_name>                  # optional single style pin
//
// Comment lines start with '#'; blank lines ignored. Duplicate ALLOW_*
// directives aggregate into their list. Any unknown directive causes
// parse to refuse with an error string naming the directive.
//
// The wildcard "*" is legal in any ALLOW_* list; the KG-filter module
// (src/factory/kg_filter.nova) uses it to short-circuit its predicate.
//
// Empty allowlists are LEGAL and mean "nothing of that kind" -- a bake
// with no ALLOW_CAPSULE lines emits a bundle with an empty capsule
// section. The single validation rule is: NAME, VERSION, DOMAIN are
// required.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- BakeManifest slot layout ------------------------------------------
let BM_NAME              = 0    // string
let BM_VERSION           = 1    // string
let BM_DOMAIN            = 2    // string
let BM_ALLOWED_CAPSULES  = 3    // list<string>
let BM_ALLOWED_SKILLS    = 4    // list<string>
let BM_ALLOWED_PATTERNS  = 5    // list<string>
let BM_PERSONA_USERS     = 6    // list<string>
let BM_POLICY_ALLOWLIST  = 7    // list<string>
let BM_KG_CAP_ALLOWLIST  = 8    // list<string> (capsule names for KG atoms)
let BM_KG_SRC_PREFIXES   = 9    // list<string>
let BM_KG_LICENSES       = 10   // list<string>
let BM_STYLE_PIN         = 11   // string (single, "" = none)
let BM_SLOTS             = 12

let BAKE_MANIFEST_VERSION_LINE = "BAKE-MANIFEST v1"

// ---- constructor + accessors --------------------------------------------

fn bake_manifest_new() {
    let m = list_new()
    push(m, "")                 // NAME
    push(m, "")                 // VERSION
    push(m, "")                 // DOMAIN
    push(m, list_new())         // ALLOWED_CAPSULES
    push(m, list_new())         // ALLOWED_SKILLS
    push(m, list_new())         // ALLOWED_PATTERNS
    push(m, list_new())         // PERSONA_USERS
    push(m, list_new())         // POLICY_ALLOWLIST
    push(m, list_new())         // KG_CAP_ALLOWLIST
    push(m, list_new())         // KG_SRC_PREFIXES
    push(m, list_new())         // KG_LICENSES
    push(m, "")                 // STYLE_PIN
    return m
}

fn bake_manifest_name(m)              { return m[BM_NAME] }
fn bake_manifest_version(m)           { return m[BM_VERSION] }
fn bake_manifest_domain(m)            { return m[BM_DOMAIN] }
fn bake_manifest_allowed_capsules(m)  { return m[BM_ALLOWED_CAPSULES] }
fn bake_manifest_allowed_skills(m)    { return m[BM_ALLOWED_SKILLS] }
fn bake_manifest_allowed_patterns(m)  { return m[BM_ALLOWED_PATTERNS] }
fn bake_manifest_persona_users(m)     { return m[BM_PERSONA_USERS] }
fn bake_manifest_policy_allowlist(m)  { return m[BM_POLICY_ALLOWLIST] }
fn bake_manifest_kg_capsules(m)       { return m[BM_KG_CAP_ALLOWLIST] }
fn bake_manifest_kg_prefixes(m)       { return m[BM_KG_SRC_PREFIXES] }
fn bake_manifest_kg_licenses(m)       { return m[BM_KG_LICENSES] }
fn bake_manifest_style_pin(m)         { return m[BM_STYLE_PIN] }

fn bake_manifest_set_name(m, v)    { list_set(m, BM_NAME, v)    return m }
fn bake_manifest_set_version(m, v) { list_set(m, BM_VERSION, v) return m }
fn bake_manifest_set_domain(m, v)  { list_set(m, BM_DOMAIN, v)  return m }
fn bake_manifest_set_style(m, v)   { list_set(m, BM_STYLE_PIN, v) return m }

fn bake_manifest_add_capsule(m, name) { push(m[BM_ALLOWED_CAPSULES], name) return m }
fn bake_manifest_add_skill(m, name)   { push(m[BM_ALLOWED_SKILLS], name)   return m }
fn bake_manifest_add_pattern(m, name) { push(m[BM_ALLOWED_PATTERNS], name) return m }
fn bake_manifest_add_persona(m, uid)  { push(m[BM_PERSONA_USERS], uid)     return m }
fn bake_manifest_add_policy(m, name)  { push(m[BM_POLICY_ALLOWLIST], name) return m }
fn bake_manifest_add_kg_capsule(m, name)  { push(m[BM_KG_CAP_ALLOWLIST], name) return m }
fn bake_manifest_add_kg_prefix(m, prefix) { push(m[BM_KG_SRC_PREFIXES], prefix) return m }
fn bake_manifest_add_kg_license(m, lic)   { push(m[BM_KG_LICENSES], lic)  return m }

// True if `name` is present in list (byte-exact match).
fn bake_manifest_list_has(lst, name) {
    let i = 0
    while i < len(lst) {
        if str_eq_bytes(lst[i], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- parser -------------------------------------------------------------

// Trim leading whitespace only (spaces + tabs). Line-oriented parser
// doesn't need full-trim.
fn _bm_ltrim(s) {
    let n = len(s)
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c != 32 { if c != 9 { i = n + 1 } else { i = i + 1 } }
        else { i = i + 1 }
    }
    if i > n { return substr(s, i - n - 1, n - (i - n - 1)) }
    return ""
}

// Extract "HEAD REST" from a line where HEAD is the first whitespace-
// delimited token and REST is everything after the first space. Returns
// [head, rest] where rest may be empty ("").
fn _bm_split_head(line) {
    let n = len(line)
    let sp = find_char(line, 32)
    if sp <= 0 {
        let out = list_new() push(out, line) push(out, "") return out
    }
    let head = substr(line, 0, sp)
    let rest = substr(line, sp + 1, n - sp - 1)
    let out = list_new()
    push(out, head) push(out, rest)
    return out
}

// Recognized single-arg directive names. Returns 1 if `head` names a
// directive this parser understands; 0 otherwise. NAME/VERSION/DOMAIN
// and STYLE are single-value; ALLOW_* + PERSONA_USER are repeatable.
fn _bm_known_directive(head) {
    if str_eq_bytes(head, "NAME")               == 1 { return 1 }
    if str_eq_bytes(head, "VERSION")            == 1 { return 1 }
    if str_eq_bytes(head, "DOMAIN")             == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_CAPSULE")      == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_SKILL")        == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_PATTERN")      == 1 { return 1 }
    if str_eq_bytes(head, "PERSONA_USER")       == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_POLICY")       == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_KG_CAPSULE")   == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_SOURCE_PREFIX") == 1 { return 1 }
    if str_eq_bytes(head, "ALLOW_LICENSE")      == 1 { return 1 }
    if str_eq_bytes(head, "STYLE")              == 1 { return 1 }
    return 0
}

// Parse a manifest text. Returns [ok, manifest, err_str].
// - ok=1 + manifest populated + err="" on success
// - ok=0 + manifest=0 + err naming the first problem on failure
//
// Parse errors: missing version banner; unknown directive; a required
// single-value directive with an empty payload (e.g. bare "NAME"
// with no arg).
fn bake_manifest_parse(text) {
    let ret = list_new()
    if len(text) == 0 {
        push(ret, 0) push(ret, 0)
        push(ret, "empty manifest text")
        return ret
    }
    // Version banner MUST be the first non-blank, non-comment line.
    let m = bake_manifest_new()
    let n = len(text)
    let start = 0
    let i = 0
    let saw_banner = 0
    while i <= n {
        let boundary = 0
        if i == n { boundary = 1 }
        else { if char_at(text, i) == 10 { boundary = 1 } }
        if boundary == 1 {
            let raw = substr(text, start, i - start)
            // Skip trailing '\r' (CRLF sources).
            let ln = len(raw)
            if ln > 0 { if char_at(raw, ln - 1) == 13 {
                raw = substr(raw, 0, ln - 1)
            } }
            // Strip leading whitespace to detect blank / comment lines
            // reliably (leading spaces or tabs are not part of the
            // directive syntax).
            let ln2 = len(raw)
            let first_nonws = ln2   // = ln2 means "line is all whitespace"
            let li = 0
            let scanning = 1
            while scanning == 1 {
                if li >= ln2 { scanning = 0 }
                else {
                    let cc = char_at(raw, li)
                    if cc == 32 { li = li + 1 }
                    else { if cc == 9 { li = li + 1 }
                    else { first_nonws = li  scanning = 0 } }
                }
            }
            let trimmed = ""
            if first_nonws < ln2 {
                trimmed = substr(raw, first_nonws, ln2 - first_nonws)
            }
            // Blank line?
            let bl = 0
            if len(trimmed) == 0 { bl = 1 }
            // Comment line?
            let is_comment = 0
            if bl == 0 { if char_at(trimmed, 0) == 35 { is_comment = 1 } }
            // Use `trimmed` for the rest of parse (banner check +
            // directive split) so leading whitespace is tolerated.
            raw = trimmed
            if bl == 0 { if is_comment == 0 {
                if saw_banner == 0 {
                    if str_eq_bytes(raw, BAKE_MANIFEST_VERSION_LINE) == 1 {
                        saw_banner = 1
                    } else {
                        push(ret, 0) push(ret, 0)
                        push(ret, "manifest must begin with '" + BAKE_MANIFEST_VERSION_LINE + "'")
                        return ret
                    }
                } else {
                    let hr = _bm_split_head(raw)
                    let head = hr[0]
                    let rest = hr[1]
                    if _bm_known_directive(head) == 0 {
                        push(ret, 0) push(ret, 0)
                        push(ret, "unknown directive: " + head)
                        return ret
                    }
                    // Single-value directives.
                    if str_eq_bytes(head, "NAME") == 1 {
                        if len(rest) == 0 {
                            push(ret, 0) push(ret, 0)
                            push(ret, "NAME directive missing value")
                            return ret
                        }
                        list_set(m, BM_NAME, rest)
                    } else { if str_eq_bytes(head, "VERSION") == 1 {
                        if len(rest) == 0 {
                            push(ret, 0) push(ret, 0)
                            push(ret, "VERSION directive missing value")
                            return ret
                        }
                        list_set(m, BM_VERSION, rest)
                    } else { if str_eq_bytes(head, "DOMAIN") == 1 {
                        if len(rest) == 0 {
                            push(ret, 0) push(ret, 0)
                            push(ret, "DOMAIN directive missing value")
                            return ret
                        }
                        list_set(m, BM_DOMAIN, rest)
                    } else { if str_eq_bytes(head, "STYLE") == 1 {
                        if len(rest) == 0 {
                            push(ret, 0) push(ret, 0)
                            push(ret, "STYLE directive missing value")
                            return ret
                        }
                        list_set(m, BM_STYLE_PIN, rest)
                    } else { if str_eq_bytes(head, "ALLOW_CAPSULE") == 1 {
                        if len(rest) > 0 { push(m[BM_ALLOWED_CAPSULES], rest) }
                    } else { if str_eq_bytes(head, "ALLOW_SKILL") == 1 {
                        if len(rest) > 0 { push(m[BM_ALLOWED_SKILLS], rest) }
                    } else { if str_eq_bytes(head, "ALLOW_PATTERN") == 1 {
                        if len(rest) > 0 { push(m[BM_ALLOWED_PATTERNS], rest) }
                    } else { if str_eq_bytes(head, "PERSONA_USER") == 1 {
                        if len(rest) > 0 { push(m[BM_PERSONA_USERS], rest) }
                    } else { if str_eq_bytes(head, "ALLOW_POLICY") == 1 {
                        if len(rest) > 0 { push(m[BM_POLICY_ALLOWLIST], rest) }
                    } else { if str_eq_bytes(head, "ALLOW_KG_CAPSULE") == 1 {
                        if len(rest) > 0 { push(m[BM_KG_CAP_ALLOWLIST], rest) }
                    } else { if str_eq_bytes(head, "ALLOW_SOURCE_PREFIX") == 1 {
                        if len(rest) > 0 { push(m[BM_KG_SRC_PREFIXES], rest) }
                    } else { if str_eq_bytes(head, "ALLOW_LICENSE") == 1 {
                        if len(rest) > 0 { push(m[BM_KG_LICENSES], rest) }
                    } } } } } } } } } } } }
                }
            } }
            start = i + 1
        }
        i = i + 1
    }
    if saw_banner == 0 {
        push(ret, 0) push(ret, 0)
        push(ret, "no version banner in manifest")
        return ret
    }
    push(ret, 1) push(ret, m) push(ret, "")
    return ret
}

// Validate the SEMANTIC shape of a manifest (NAME + VERSION + DOMAIN
// must all be non-empty). Returns [ok, err]. Empty allowlists are
// LEGAL and pass validation.
fn bake_manifest_validate(m) {
    let ret = list_new()
    if m == 0 {
        push(ret, 0) push(ret, "manifest is null")
        return ret
    }
    if len(bake_manifest_name(m)) == 0 {
        push(ret, 0) push(ret, "manifest missing NAME")
        return ret
    }
    if len(bake_manifest_version(m)) == 0 {
        push(ret, 0) push(ret, "manifest missing VERSION")
        return ret
    }
    if len(bake_manifest_domain(m)) == 0 {
        push(ret, 0) push(ret, "manifest missing DOMAIN")
        return ret
    }
    push(ret, 1) push(ret, "")
    return ret
}

// ---- serializer ---------------------------------------------------------
//
// Emit a canonical text form suitable for round-trip through
// bake_manifest_parse. Directives ordered NAME, VERSION, DOMAIN,
// STYLE (if set), then each ALLOW_* list in a stable order.
fn _bm_emit_list(head, items) {
    let s = ""
    let i = 0
    while i < len(items) {
        s = s + head + " " + items[i] + "\n"
        i = i + 1
    }
    return s
}

fn bake_manifest_serialize(m) {
    if m == 0 { return "" }
    let s = BAKE_MANIFEST_VERSION_LINE + "\n"
    if len(bake_manifest_name(m)) > 0 {
        s = s + "NAME " + bake_manifest_name(m) + "\n"
    }
    if len(bake_manifest_version(m)) > 0 {
        s = s + "VERSION " + bake_manifest_version(m) + "\n"
    }
    if len(bake_manifest_domain(m)) > 0 {
        s = s + "DOMAIN " + bake_manifest_domain(m) + "\n"
    }
    if len(bake_manifest_style_pin(m)) > 0 {
        s = s + "STYLE " + bake_manifest_style_pin(m) + "\n"
    }
    s = s + _bm_emit_list("ALLOW_CAPSULE", bake_manifest_allowed_capsules(m))
    s = s + _bm_emit_list("ALLOW_SKILL",   bake_manifest_allowed_skills(m))
    s = s + _bm_emit_list("ALLOW_PATTERN", bake_manifest_allowed_patterns(m))
    s = s + _bm_emit_list("PERSONA_USER",  bake_manifest_persona_users(m))
    s = s + _bm_emit_list("ALLOW_POLICY",  bake_manifest_policy_allowlist(m))
    s = s + _bm_emit_list("ALLOW_KG_CAPSULE",   bake_manifest_kg_capsules(m))
    s = s + _bm_emit_list("ALLOW_SOURCE_PREFIX", bake_manifest_kg_prefixes(m))
    s = s + _bm_emit_list("ALLOW_LICENSE",      bake_manifest_kg_licenses(m))
    return s
}
