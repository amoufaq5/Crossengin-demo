// CrossEngin persistence: snapshot reader + ordered rehydration.
//
// Purpose
//   Parse a serialized snapshot (ADR-0048) and enforce the load-bearing part of
//   the ADR: the MANDATORY rehydration order soul -> KGs -> episodic (with
//   synapses/self-model after KGs). Soul loads first so identity and the
//   constitution (ADR-0045) are live before any atom is admitted; KGs load
//   before episodic because moments reference atoms and would dangle otherwise.
//   A snapshot with a wrong tag or unsupported version is rejected (tamper /
//   incompatible); a snapshot whose section presence violates the dependency
//   order is refused.
//
//   The reader produces the ordered rehydration PLAN and validates dependencies;
//   the daemon executes the plan, calling each subsystem's deserialize in turn
//   (kept out of this module so it stays standalone and free of blocker #10).
//   The decision log (ADR-0043) is durable-but-separate and is NOT rolled back
//   by a snapshot restore.
//
// ADRs implemented: ADR-0048 (rehydration order + validation). NOVA
//   dependencies: builtins. CrossEngin dependencies:
//   src/persistence/snapshot_writer.nova.

import "snapshot_writer.nova"

// Parse a framed snapshot value back into a snapshot object. Returns 0 if the
// tag or format version is wrong (tamper / incompatible image).
//
// v2 migration: a v1-framed value is accepted and migrated up to v2 in-place
// via snap_migrate_v1_to_v2 before being returned. A v3+ framed value is
// REJECTED (a newer build's wire shape can't be safely downgraded into this
// version's blob shapes without dropping fields). The same policy as the
// text-format parser in snapshot_disk.nova.
fn snap_parse(ser) {
    if len(ser) < 5 { return 0 }
    if ser[0] != SNAP_TAG { return 0 }
    let ver = ser[1]
    if ver < SNAP_FORMAT_VERSION_MIN_SUPPORTED { return 0 }
    if ver > SNAP_FORMAT_VERSION { return 0 }
    let s = snap_new(ser[2], ser[3])
    // snap_new always stamps the current SNAP_FORMAT_VERSION. Roll the
    // version slot back to what the wire declared so the migration check
    // below dispatches correctly.
    list_set(s, SNAP_VER, ver)
    let count = ser[4]
    let i = 0
    while i < count {
        if i < SEC_COUNT {
            let cell = ser[5 + i]
            if cell[0] == 1 { snap_put_section(s, i, cell[1]) }
        }
        i = i + 1
    }
    if ver == 1 {
        snap_migrate_v1_to_v2(s)
    }
    return s
}

// Validate a snapshot. A snapshot is valid when its tag matches AND its
// version is the CURRENT format. After v1 -> v2 migration the version slot
// reads as 2, so a successfully-migrated v1 file passes the same valid check
// as a freshly-built v2 snapshot.
fn snap_valid(s) {
    if s == 0 { return 0 }
    if snap_tag(s) != SNAP_TAG { return 0 }
    if snap_version(s) != SNAP_FORMAT_VERSION { return 0 }
    return 1
}

// The mandatory rehydration order (ADR-0048).
fn snap_rehydrate_order() {
    let o = list_new()
    push(o, SEC_SOUL)
    push(o, SEC_KGS)
    push(o, SEC_EPISODIC)
    push(o, SEC_SYNAPSES)
    push(o, SEC_SELFMODEL)
    return o
}

// Structural dependency check: a present section requires its predecessor to be
// present too -- KGs need the soul, episodic needs KGs, synapses/self-model need
// KGs. Returns 1 iff the snapshot can be rehydrated without a dangling section.
fn snap_rehydrate_valid(s) {
    if snap_valid(s) == 0 { return 0 }
    if snap_has_section(s, SEC_KGS) == 1 {
        if snap_has_section(s, SEC_SOUL) == 0 { return 0 }
    }
    if snap_has_section(s, SEC_EPISODIC) == 1 {
        if snap_has_section(s, SEC_KGS) == 0 { return 0 }
    }
    if snap_has_section(s, SEC_SYNAPSES) == 1 {
        if snap_has_section(s, SEC_KGS) == 0 { return 0 }
    }
    if snap_has_section(s, SEC_SELFMODEL) == 1 {
        if snap_has_section(s, SEC_KGS) == 0 { return 0 }
    }
    return 1
}

// The ordered list of PRESENT section ids to apply, in mandatory order: the
// rehydration plan the daemon executes (calling each subsystem's deserialize).
fn snap_rehydrate_plan(s) {
    let plan = list_new()
    let order = snap_rehydrate_order()
    let i = 0
    while i < len(order) {
        if snap_has_section(s, order[i]) == 1 { push(plan, order[i]) }
        i = i + 1
    }
    return plan
}

// ---- apply-time order guard ------------------------------------------------
// A cursor the daemon advances as it applies sections; snap_can_apply refuses an
// out-of-order section even if a caller tries to load KGs before the soul.
fn snap_cursor_new() {
    let c = list_new()
    let i = 0
    while i < SEC_COUNT {
        push(c, 0)
        i = i + 1
    }
    return c
}

fn snap_is_applied(cursor, sec_id) {
    if sec_id < 0 { return 0 }
    if sec_id >= SEC_COUNT { return 0 }
    return cursor[sec_id]
}

fn snap_mark_applied(cursor, sec_id) {
    if sec_id >= 0 {
        if sec_id < SEC_COUNT { list_set(cursor, sec_id, 1) }
    }
    return 1
}

// May this section be applied now, given what is already applied? Soul anytime;
// KGs only after soul; episodic/synapses/self-model only after KGs.
fn snap_can_apply(cursor, sec_id) {
    if sec_id == SEC_SOUL      { return 1 }
    if sec_id == SEC_KGS       { return snap_is_applied(cursor, SEC_SOUL) }
    if sec_id == SEC_EPISODIC  { return snap_is_applied(cursor, SEC_KGS) }
    if sec_id == SEC_SYNAPSES  { return snap_is_applied(cursor, SEC_KGS) }
    if sec_id == SEC_SELFMODEL { return snap_is_applied(cursor, SEC_KGS) }
    return 0
}
