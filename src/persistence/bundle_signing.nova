// CrossEngin persistence: signed bundle helper (R99, ADR-0203/0204).
//
// Purpose
//   R99 introduces the bake_child pipeline, which emits a filtered
//   snapshot bundle for a child runtime to load. The mother must
//   sign the bundle so the child can verify the file wasn't tampered
//   with in transit.
//
//   The R16A merkle_sign / merkle_verify_signature primitives already
//   speak Ed25519 over a 32-byte digest. This module composes them
//   with the SHA-256 canonical helper so a caller can sign an
//   arbitrarily-long bundle in one call:
//
//     [ok, sig] = bundle_pkg_sign(bundle_bytes, seed_bytes, pk_bytes)
//     [ok, ""]  = bundle_pkg_verify(bundle_bytes, sig, pk_bytes)
//
//   Signing hashes the bundle to 32 bytes and calls merkle_sign; the
//   result is a 64-byte Ed25519 signature suitable for the bundle
//   footer.
//
//   Env-var loader:
//     bundle_signer_load_from_env() -> [ok, seed, pk, err]
//   reads two base64-encoded environment variables:
//     CROSSENGIN_MOTHER_SIGNER_SEED_B64  -- 32-byte Ed25519 seed
//     CROSSENGIN_MOTHER_SIGNER_PK_B64    -- 32-byte Ed25519 public key
//   The sidecar (a separate process outside this container) is
//   responsible for generating the keypair and exporting it into the
//   daemon's environment. secure_random is seccomp-blocked in this
//   sandbox so key material MUST come from outside; the module refuses
//   any bake with a clear error when either env var is missing.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/persistence/merkle_signing.nova  (Ed25519 sign/verify wrappers)
//   src/safety/sha256.nova                (SHA-256 oneshot)
//   src/net/tls/base64.nova                (env-var decode)

import "./merkle_signing.nova"
import "../safety/sha256.nova"
import "../net/tls/base64.nova"

let _BPS_DIGEST_LEN = 32
let _BPS_SEED_LEN   = 32
let _BPS_PK_LEN     = 32
let _BPS_SIG_LEN    = 64

// SHA-256 the bundle bytes and return the 32-element digest byte list.
// The bundle bytes are supplied either as a NOVA byte list OR as an
// (opaque) NOVA string. The digest is what merkle_sign takes.
fn _bps_sha256_bytes(bundle_bytes) {
    // If it's a byte list, use sha256_oneshot_bytes.
    if bundle_bytes == 0 {
        // Treat a null as empty bytes.
        let empty = list_new()
        return sha256_oneshot_bytes(empty)
    }
    return sha256_oneshot_bytes(bundle_bytes)
}

// Sign `bundle_bytes` (a byte list) with (seed, pk). Returns
// [ok, sig] where ok=1 on success + sig is a 64-byte byte list;
// ok=0 on any shape error + sig is an empty list.
fn bundle_pkg_sign(bundle_bytes, seed_bytes, pk_bytes) {
    let ret = list_new()
    if seed_bytes == 0 {
        push(ret, 0) push(ret, list_new()) return ret
    }
    if pk_bytes == 0 {
        push(ret, 0) push(ret, list_new()) return ret
    }
    if len(seed_bytes) != _BPS_SEED_LEN {
        push(ret, 0) push(ret, list_new()) return ret
    }
    if len(pk_bytes) != _BPS_PK_LEN {
        push(ret, 0) push(ret, list_new()) return ret
    }
    let digest = _bps_sha256_bytes(bundle_bytes)
    if digest == 0 {
        push(ret, 0) push(ret, list_new()) return ret
    }
    if len(digest) != _BPS_DIGEST_LEN {
        push(ret, 0) push(ret, list_new()) return ret
    }
    let sig = merkle_sign(digest, seed_bytes, pk_bytes)
    if sig == 0 {
        push(ret, 0) push(ret, list_new()) return ret
    }
    if len(sig) != _BPS_SIG_LEN {
        push(ret, 0) push(ret, list_new()) return ret
    }
    push(ret, 1) push(ret, sig) return ret
}

// Verify `sig_bytes` against `bundle_bytes` under `pk_bytes`. Returns
// [ok, err] where ok=1 on valid + err is ""; ok=0 on any mismatch and
// err carries a human-readable reason (tampered / wrong pk / wrong
// shape).
fn bundle_pkg_verify(bundle_bytes, sig_bytes, pk_bytes) {
    let ret = list_new()
    if sig_bytes == 0 {
        push(ret, 0) push(ret, "signature is null") return ret
    }
    if pk_bytes == 0 {
        push(ret, 0) push(ret, "signer public key is null") return ret
    }
    if len(sig_bytes) != _BPS_SIG_LEN {
        push(ret, 0) push(ret, "signature must be 64 bytes") return ret
    }
    if len(pk_bytes) != _BPS_PK_LEN {
        push(ret, 0) push(ret, "signer public key must be 32 bytes") return ret
    }
    let digest = _bps_sha256_bytes(bundle_bytes)
    if len(digest) != _BPS_DIGEST_LEN {
        push(ret, 0) push(ret, "SHA-256 digest wrong length") return ret
    }
    let v = merkle_verify_signature(digest, sig_bytes, pk_bytes)
    if v == 1 {
        push(ret, 1) push(ret, "") return ret
    }
    push(ret, 0) push(ret, "signature verification failed") return ret
}

// ---- hex helpers (used by the bundle footer) ---------------------------

fn _bps_nibble_hex(n) {
    if n < 10 { return chr(48 + n) }
    return chr(87 + n)
}

fn _bps_hex_nibble_val(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70  { return c - 55 } }
    return 0 - 1
}

// Byte list -> lowercase hex string.
fn bundle_hex_encode(bytes) {
    if bytes == 0 { return "" }
    let s = ""
    let i = 0
    let n = len(bytes)
    while i < n {
        let b = bytes[i]
        s = s + _bps_nibble_hex(b / 16) + _bps_nibble_hex(b - (b / 16) * 16)
        i = i + 1
    }
    return s
}

// Hex string -> byte list. Returns 0 on malformed input.
fn bundle_hex_decode(hex) {
    if hex == 0 { return 0 }
    let n = len(hex)
    if n == 0 { return list_new() }
    if (n / 2) * 2 != n { return 0 }
    let out = list_new()
    let i = 0
    while i < n {
        let hi = _bps_hex_nibble_val(char_at(hex, i))
        let lo = _bps_hex_nibble_val(char_at(hex, i + 1))
        if hi < 0 { return 0 }
        if lo < 0 { return 0 }
        push(out, hi * 16 + lo)
        i = i + 2
    }
    return out
}

// ---- env-var loader --------------------------------------------------

// Guard against NOVA's getenv quirk: unset yields 0 (address 0) which
// then segfaults on len(); we check both.
fn _bps_env(name) {
    let v = getenv(name)
    if v == 0 { return "" }
    if len(v) == 0 { return "" }
    return v
}

// Load the mother's signer keypair from env. Returns
// [ok, seed_bytes, pk_bytes, err_str]. ok=1 on success; ok=0 on any
// failure (missing env var, malformed base64, wrong key length).
fn bundle_signer_load_from_env() {
    let ret = list_new()
    let seed_b64 = _bps_env("CROSSENGIN_MOTHER_SIGNER_SEED_B64")
    let pk_b64   = _bps_env("CROSSENGIN_MOTHER_SIGNER_PK_B64")
    if len(seed_b64) == 0 {
        push(ret, 0) push(ret, 0) push(ret, 0)
        push(ret, "CROSSENGIN_MOTHER_SIGNER_SEED_B64 not set")
        return ret
    }
    if len(pk_b64) == 0 {
        push(ret, 0) push(ret, 0) push(ret, 0)
        push(ret, "CROSSENGIN_MOTHER_SIGNER_PK_B64 not set")
        return ret
    }
    let seed_dec = base64_decode(seed_b64)
    if seed_dec[0] == 0 {
        push(ret, 0) push(ret, 0) push(ret, 0)
        push(ret, "CROSSENGIN_MOTHER_SIGNER_SEED_B64 base64 malformed")
        return ret
    }
    let pk_dec = base64_decode(pk_b64)
    if pk_dec[0] == 0 {
        push(ret, 0) push(ret, 0) push(ret, 0)
        push(ret, "CROSSENGIN_MOTHER_SIGNER_PK_B64 base64 malformed")
        return ret
    }
    let seed = seed_dec[1]
    let pk   = pk_dec[1]
    if len(seed) != _BPS_SEED_LEN {
        push(ret, 0) push(ret, 0) push(ret, 0)
        push(ret, "signer seed must decode to 32 bytes")
        return ret
    }
    if len(pk) != _BPS_PK_LEN {
        push(ret, 0) push(ret, 0) push(ret, 0)
        push(ret, "signer public key must decode to 32 bytes")
        return ret
    }
    push(ret, 1) push(ret, seed) push(ret, pk) push(ret, "")
    return ret
}

// Fingerprint = SHA-256(signer_pk) rendered as hex. Used in bundle
// header so a child can quickly recognize which mother's bundle it's
// looking at even before verifying the signature.
fn bundle_signer_fingerprint(pk_bytes) {
    if pk_bytes == 0 { return "" }
    let d = sha256_oneshot_bytes(pk_bytes)
    return bundle_hex_encode(d)
}
