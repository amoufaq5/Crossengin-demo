// CrossEngin persistence: incremental delta-snapshot writer + reader (R13F).
//
// Purpose
//   The R5D / R6F / R8E persistence stack writes FULL snapshots on every
//   `snap_save`: every checkpoint serializes the entire KG state, even if
//   only a handful of atoms have moved. As the KG grows, the hot path
//   (write_tmp -> fsync -> atomic_rename -> parent fsync) grows linearly
//   with it, and a 1000-atom KG already takes several milliseconds per
//   save. The substrate's mutation rate is high (every observation
//   touches at least one atom), so the per-mutation fsync cost dominates.
//
//   This module adds an INCREMENTAL persistence path: rather than rewriting
//   the whole image, we append a tiny `delta` file that records only the
//   operations (ADD / MOD / DEL) since the parent full snapshot. A reader
//   recovers the full state by loading the parent full snapshot and then
//   applying each delta in sequence. Periodically, a compaction pass
//   collapses N deltas into a new full snapshot and prunes the deltas.
//
//   The result: a snapshot of a 1000-atom KG that previously cost ~5ms
//   on every save now costs ~5ms once per N saves, with each interleaved
//   delta-save costing <1ms (only the changed bytes are fsynced). The
//   crash-safety contract is unchanged -- every delta is written via the
//   same write_tmp -> fsync -> atomic_rename dance the full snapshot uses;
//   a crash during the delta write leaves the parent + earlier deltas
//   intact, and the partially-written delta is silently ignored.
//
//   Storage layout for snapshot path /tmp/foo.snap:
//     /tmp/foo.snap            -- parent full snapshot (R5D v2 + R8E format)
//     /tmp/foo.snap.delta.000  -- first delta after parent
//     /tmp/foo.snap.delta.001  -- second delta
//     ...
//     /tmp/foo.snap.delta.NNN  -- Nth delta (3-digit zero-padded so a glob
//                                 sorts lexically into apply order)
//
//   Delta wire format (text, line-oriented, mirrors the R5D snapshot style
//   so a human can `cat` a checkpoint and inspect it):
//
//     crossengin-delta v1
//     timestamp <int_ns>
//     parent_snapshot <fingerprint>
//     operations <N>
//     ADD\t<id>\t<kg>\t<kind>\t<label>\t<alpha>\t<beta>
//     MOD\t<id>\t<kg>\t<field>\t<value>
//     DEL\t<id>\t<kg>
//     ...
//     end_delta
//
//   The `parent_snapshot` field carries a short fingerprint derived from
//   the parent's wire bytes (currently: parent_timestamp + parent_byte_len,
//   joined by a colon). Applying a delta to a parent with a different
//   fingerprint fails loudly with a clear error -- a delta is meaningful
//   ONLY against the exact parent it was written against.
//
//   Compaction (`snap_delta_compact`): given a parent full snapshot path,
//   apply every sibling delta file to the in-memory KG, write a fresh
//   full snapshot in place via snap_save, then unlink every delta file.
//   Idempotent: a second run with zero deltas present is a no-op.
//
//   Schema-migration interop (R8E): a delta operates on atom OBJECTS, so
//   the parent's atoms_version stamp travels through unchanged; the
//   post-load migration hook (`snap_post_load_migrate`) runs after the
//   delta-apply pass and brings every atom -- including delta-applied
//   ones -- up to SCHEMA_CURRENT_VERSION.
//
//   R6F episodic preservation: episodic moments / episodes / promoted
//   atoms live in the EPISODIC section of the parent snapshot; deltas
//   record only KG-section mutations (ADD/MOD/DEL of atoms). Episodic
//   state survives the delta round-trip because the parent's EPISODIC
//   blob is reloaded verbatim before deltas are applied.
//
//   File-ownership note (R13F): this module is NEW. The reader hook
//   that detects sibling delta files lives in snapshot_disk.nova as
//   `snap_load_with_deltas`; the writer hook lives in
//   snapshot_writer.nova as `snap_delta_save`. The orchestration here
//   is deliberately runtime-only -- no module-state singletons -- so
//   multiple writers (chat / daemon) can coexist on the same snapshot
//   path without coordination.
//
// ADRs implemented: ADR-0048 (persistence container -- the delta is a
//   per-mutation sibling of the same container). NOVA dependencies:
//   builtins + sys_open/sys_write/sys_read/sys_close/sys_fsync/
//   sys_rename/sys_unlink from std/syscall. CrossEngin dependencies:
//     - src/persistence/snapshot_writer.nova  (frame + section ids)
//     - src/persistence/snapshot_reader.nova  (snap_parse / snap_valid)
//     - src/kg/atom_store.nova                (atom layout + accessors)
//     - src/kg/multi_kg_manager.nova          (KG registry walk + spawn)
//
// Public surface (referenced by snapshot_disk.nova):
//   delta_writer_new(parent_fingerprint, now_ns) -> writer
//   delta_writer_record_add(w, atom, kg_label)   -> writer
//   delta_writer_record_mod(w, atom_id, kg_label, field, value) -> writer
//   delta_writer_record_del(w, atom_id, kg_label) -> writer
//   delta_writer_op_count(w)                     -> int
//   delta_writer_to_text(w)                      -> string
//   delta_writer_flush(w, path)                  -> 1 on success, 0 on fail
//
//   delta_parse(text)                            -> reader (or 0 on bad)
//   delta_reader_parent_fingerprint(r)           -> string
//   delta_reader_timestamp(r)                    -> int_ns
//   delta_reader_op_count(r)                     -> int
//   delta_reader_op(r, idx)                      -> [op, id, kg, field, value]
//   delta_reader_apply(r, kg_reg, expected_fp)   -> [applied, skipped]
//                                                   or 0 on parent-fp mismatch
//
//   snap_parent_fingerprint(snap, byte_len)      -> string (timestamp:bytes)
//   delta_path_for(parent_path, idx)             -> string  (zero-padded suffix)
//   delta_path_glob_prefix(parent_path)          -> string  (for sibling scan)
//
// Operation tag constants (exported for callers that want to inspect ops):
let DELTA_OP_ADD = 1
let DELTA_OP_MOD = 2
let DELTA_OP_DEL = 3

// Format-version constants. We bump V1 to V2 the day the wire format
// becomes incompatible with V1 readers; today every delta is V1.
let DELTA_FORMAT_VERSION         = 1
let DELTA_FORMAT_VERSION_MIN_OK  = 1

// Wire-format tokens / banner.
let _DELTA_HEADER  = "crossengin-delta v1"
let _DELTA_TRAILER = "end_delta"

// Hot-path-default compaction threshold; the substrate calls
// `snap_delta_compact_threshold()` to decide when to fold deltas into a
// new full snapshot. Tunable via $CE_DELTA_COMPACT_THRESHOLD.
let DELTA_COMPACTION_THRESHOLD_DEFAULT = 100

// Cap the per-delta size we will format / parse at. A delta that grows
// beyond this is a sign the caller forgot to flush; we still write it
// (no truncation), but we log a warning at flush time. (50KB matches the
// hot-path target of <1ms per delta write.)
let DELTA_SIZE_WARN_BYTES = 50000

// Maximum digits in a delta-index suffix (.delta.NNN). Three is enough
// for ~1000 deltas between compactions; on the rare day we hit it the
// caller forces a compaction.
let DELTA_INDEX_DIGITS = 3

// ---- writer object layout -------------------------------------------------
//
// A writer is a list:
//   [parent_fp, timestamp_ns, ops]
// where each op is a list:
//   ADD: [OP_ADD, atom_id, kg_label, kind, label, alpha, beta]
//   MOD: [OP_MOD, atom_id, kg_label, field, value]
//   DEL: [OP_DEL, atom_id, kg_label]
//
// The slot layout never moves -- per-record fields are accessed by
// integer offset, not by name, so the wire-format printer can index
// directly into the op list.
let _DW_PARENT_FP = 0
let _DW_TIMESTAMP = 1
let _DW_OPS       = 2

fn delta_writer_new(parent_fingerprint, now_ns) {
    let w = list_new()
    push(w, parent_fingerprint)
    push(w, now_ns)
    push(w, list_new())
    return w
}

fn delta_writer_parent_fingerprint(w) { return w[_DW_PARENT_FP] }
fn delta_writer_timestamp(w)          { return w[_DW_TIMESTAMP] }
fn delta_writer_ops(w)                { return w[_DW_OPS] }
fn delta_writer_op_count(w)           { return len(w[_DW_OPS]) }

// Record an ADD: a brand-new atom landed in the KG since the parent
// snapshot. We capture just the wire-essential fields (kg label, id,
// kind, label, alpha, beta) -- the rest of the atom (payload, embed,
// xrefs) re-materializes via the same path snapshot_disk.nova uses,
// so we don't need to ship it. The xref / payload restoration is
// handled by the reader's kg_section_apply equivalent.
fn delta_writer_record_add(w, atom, kg_label) {
    if atom == 0 { return w }
    let op = list_new()
    push(op, DELTA_OP_ADD)
    push(op, atom_id(atom))
    push(op, kg_label)
    push(op, atom_kind(atom))
    push(op, atom_label(atom))
    let b = atom_belief(atom)
    push(op, b[0])    // alpha
    push(op, b[1])    // beta
    push(w[_DW_OPS], op)
    return w
}

// Record a MOD: an atom field changed. The `field` is a small set of
// well-known names (alpha, beta, label) that the reader knows how to
// patch back. Other fields are silently ignored on the read side.
fn delta_writer_record_mod(w, atom_id_in, kg_label, field, value) {
    let op = list_new()
    push(op, DELTA_OP_MOD)
    push(op, atom_id_in)
    push(op, kg_label)
    push(op, field)
    push(op, value)
    push(w[_DW_OPS], op)
    return w
}

// Record a DEL: an atom was removed from the KG.
fn delta_writer_record_del(w, atom_id_in, kg_label) {
    let op = list_new()
    push(op, DELTA_OP_DEL)
    push(op, atom_id_in)
    push(op, kg_label)
    push(w[_DW_OPS], op)
    return w
}

// ---- wire-format encoding -------------------------------------------------
//
// Lines are TAB-separated to avoid colliding with the R5D snapshot's
// space-separated key/value format. A reader that sees a tab knows it's
// looking at an op line, not a header line.

let _DELTA_TAB = "\t"
let _DELTA_NL  = "\n"

fn _dw_emit_header(lines, w, op_count) {
    push(lines, _DELTA_HEADER + _DELTA_NL)
    push(lines, "timestamp " + int_to_str(w[_DW_TIMESTAMP]) + _DELTA_NL)
    push(lines, "parent_snapshot " + w[_DW_PARENT_FP] + _DELTA_NL)
    push(lines, "operations " + int_to_str(op_count) + _DELTA_NL)
    return 1
}

fn _dw_emit_add(lines, op) {
    let s = "ADD"
    s = s + _DELTA_TAB + int_to_str(op[1])    // id
    s = s + _DELTA_TAB + op[2]                 // kg label
    s = s + _DELTA_TAB + int_to_str(op[3])    // kind
    s = s + _DELTA_TAB + op[4]                 // label
    s = s + _DELTA_TAB + int_to_str(op[5])    // alpha
    s = s + _DELTA_TAB + int_to_str(op[6])    // beta
    push(lines, s + _DELTA_NL)
    return 1
}

fn _dw_emit_mod(lines, op) {
    let s = "MOD"
    s = s + _DELTA_TAB + int_to_str(op[1])    // id
    s = s + _DELTA_TAB + op[2]                 // kg label
    s = s + _DELTA_TAB + op[3]                 // field name
    // value rendering: if the field is one of the known integer fields,
    // print as int; otherwise the value is already a string. The reader
    // does the inverse via the field whitelist.
    if _delta_field_is_int(op[3]) == 1 {
        s = s + _DELTA_TAB + int_to_str(op[4])
    } else {
        s = s + _DELTA_TAB + op[4]
    }
    push(lines, s + _DELTA_NL)
    return 1
}

fn _dw_emit_del(lines, op) {
    let s = "DEL"
    s = s + _DELTA_TAB + int_to_str(op[1])    // id
    s = s + _DELTA_TAB + op[2]                 // kg label
    push(lines, s + _DELTA_NL)
    return 1
}

// Field whitelist used by both writer (to decide int vs string format)
// and reader (to decide how to parse the value). Keep this small and
// stable -- adding a field is a no-op for old readers (they ignore
// unrecognised MOD lines), but renaming one breaks them.
fn _delta_field_is_int(field) {
    if str_eq(field, "alpha") == 1 { return 1 }
    if str_eq(field, "beta") == 1  { return 1 }
    if str_eq(field, "kind") == 1  { return 1 }
    return 0
}

// Serialize the entire writer state to a single textual delta blob.
fn delta_writer_to_text(w) {
    let lines = list_new()
    let ops = w[_DW_OPS]
    _dw_emit_header(lines, w, len(ops))
    let i = 0
    while i < len(ops) {
        let op = ops[i]
        let tag = op[0]
        if tag == DELTA_OP_ADD { _dw_emit_add(lines, op) }
        if tag == DELTA_OP_MOD { _dw_emit_mod(lines, op) }
        if tag == DELTA_OP_DEL { _dw_emit_del(lines, op) }
        i = i + 1
    }
    push(lines, _DELTA_TRAILER + _DELTA_NL)
    return join(lines, "")
}

// ---- reader object layout -------------------------------------------------
//
// A reader is a list:
//   [parent_fp, timestamp_ns, ops]
// where each op is decoded back into the same shape the writer
// produced: [OP_*, id, kg, ...]. Symmetric with the writer.
let _DR_PARENT_FP = 0
let _DR_TIMESTAMP = 1
let _DR_OPS       = 2

fn delta_reader_parent_fingerprint(r) {
    if r == 0 { return "" }
    return r[_DR_PARENT_FP]
}
fn delta_reader_timestamp(r) {
    if r == 0 { return 0 }
    return r[_DR_TIMESTAMP]
}
fn delta_reader_op_count(r) {
    if r == 0 { return 0 }
    return len(r[_DR_OPS])
}
fn delta_reader_op(r, idx) {
    if r == 0 { return 0 }
    if idx < 0 { return 0 }
    if idx >= len(r[_DR_OPS]) { return 0 }
    return r[_DR_OPS][idx]
}

// ---- text decoding --------------------------------------------------------
//
// We reuse the line-scan primitives the snapshot reader uses (_next_line,
// _find_byte) by reimplementing them locally so this module stays
// standalone -- snapshot_disk.nova imports US, not the other way around.

fn _d_find_byte(s, start, byte) {
    let n = len(s)
    let i = start
    while i < n {
        if char_at(s, i) == byte { return i }
        i = i + 1
    }
    return -1
}

fn _d_next_line(text, pos) {
    let nl = _d_find_byte(text, pos, 10)
    let pair = list_new()
    if nl < 0 {
        push(pair, substr(text, pos, len(text) - pos))
        push(pair, len(text))
        return pair
    }
    push(pair, substr(text, pos, nl - pos))
    push(pair, nl + 1)
    return pair
}

// Split a TAB-separated string into its fields. Returns a list of strings.
fn _d_split_tab(line) {
    let out = list_new()
    let n = len(line)
    let i = 0
    let start = 0
    while i < n {
        if char_at(line, i) == 9 {
            push(out, substr(line, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(out, substr(line, start, n - start))
    return out
}

// Pull out the value half of a `key SP value` header line.
fn _d_line_val(line) {
    let sp = _d_find_byte(line, 0, 32)
    if sp < 0 { return "" }
    return substr(line, sp + 1, len(line) - sp - 1)
}

// Parse a delta blob. Returns a reader on success, 0 on:
//   - missing / wrong header
//   - mismatched version
//   - missing trailer
// Unrecognised op lines are silently SKIPPED (forward-compat for a
// future writer that adds new op tags).
fn delta_parse(text) {
    if len(text) == 0 { return 0 }
    let first = _d_next_line(text, 0)
    if str_eq(first[0], _DELTA_HEADER) == 0 {
        // Future versions are rejected loudly elsewhere; here we just
        // refuse the file. A v1 header is the only one we accept today.
        return 0
    }
    let pos = first[1]
    let parent_fp = ""
    let ts = 0
    let ops = list_new()
    let saw_trailer = 0
    while pos < len(text) {
        let parsed = _d_next_line(text, pos)
        pos = parsed[1]
        let line = parsed[0]
        if len(line) == 0 {
            // Blank line, skip.
        } else {
            if str_eq(line, _DELTA_TRAILER) == 1 {
                saw_trailer = 1
                pos = len(text)
            } else {
                // Header lines (key SP value) come before any op line.
                if _d_starts_with(line, "timestamp ") == 1 {
                    ts = str_to_int(_d_line_val(line))
                } else {
                    if _d_starts_with(line, "parent_snapshot ") == 1 {
                        parent_fp = _d_line_val(line)
                    } else {
                        if _d_starts_with(line, "operations ") == 1 {
                            // No-op: we count from the ops list, not the
                            // declared count. The line is kept for human
                            // readability.
                        } else {
                            // Op line: TAB-separated.
                            let fields = _d_split_tab(line)
                            if len(fields) > 0 {
                                let tag = fields[0]
                                if str_eq(tag, "ADD") == 1 {
                                    if len(fields) >= 7 {
                                        let op = list_new()
                                        push(op, DELTA_OP_ADD)
                                        push(op, str_to_int(fields[1]))
                                        push(op, fields[2])
                                        push(op, str_to_int(fields[3]))
                                        push(op, fields[4])
                                        push(op, str_to_int(fields[5]))
                                        push(op, str_to_int(fields[6]))
                                        push(ops, op)
                                    }
                                }
                                if str_eq(tag, "MOD") == 1 {
                                    if len(fields) >= 5 {
                                        let op = list_new()
                                        push(op, DELTA_OP_MOD)
                                        push(op, str_to_int(fields[1]))
                                        push(op, fields[2])
                                        push(op, fields[3])
                                        // Value: int if the field is in
                                        // the int whitelist, else string.
                                        if _delta_field_is_int(fields[3]) == 1 {
                                            push(op, str_to_int(fields[4]))
                                        } else {
                                            push(op, fields[4])
                                        }
                                        push(ops, op)
                                    }
                                }
                                if str_eq(tag, "DEL") == 1 {
                                    if len(fields) >= 3 {
                                        let op = list_new()
                                        push(op, DELTA_OP_DEL)
                                        push(op, str_to_int(fields[1]))
                                        push(op, fields[2])
                                        push(ops, op)
                                    }
                                }
                                // Unknown op tags: silently skip (forward-
                                // compat). A future writer can introduce
                                // new tags without breaking us.
                            }
                        }
                    }
                }
            }
        }
    }
    if saw_trailer == 0 { return 0 }
    let r = list_new()
    push(r, parent_fp)
    push(r, ts)
    push(r, ops)
    return r
}

fn _d_starts_with(s, prefix) {
    let p = len(prefix)
    if p > len(s) { return 0 }
    let i = 0
    while i < p {
        if char_at(s, i) != char_at(prefix, i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---- parent-snapshot fingerprint -----------------------------------------
//
// A short stable identifier the delta carries to assert it's being applied
// to the parent it was written against. We use `<instance>:<timestamp>:
// <byte_len>` -- three integers that are unlikely to collide unless the
// snapshot is BIT-IDENTICAL, which is what we want (a re-save with no
// changes produces an identical fingerprint and any pending delta is
// still applicable).
//
// The byte_len is the parent's text-encoded length at write time; the
// caller computes it via `len(snap_to_text(parent))`. We accept it as a
// parameter so this module stays out of the snap_to_text dependency
// chain (snap_to_text lives in snapshot_disk.nova which imports US).
fn snap_parent_fingerprint(snap, parent_bytes) {
    if snap == 0 { return "" }
    let s = int_to_str(snap_instance(snap))
    s = s + ":" + int_to_str(snap_timestamp(snap))
    s = s + ":" + int_to_str(parent_bytes)
    return s
}

// ---- delta-file path layout ----------------------------------------------
//
// For a parent at /tmp/foo.snap, deltas live at
//   /tmp/foo.snap.delta.000, .001, .002, ...
// 3-digit zero-padded so a directory glob sorts in apply order.

fn _pad_index(idx) {
    let s = int_to_str(idx)
    while len(s) < DELTA_INDEX_DIGITS {
        s = "0" + s
    }
    return s
}

fn delta_path_for(parent_path, idx) {
    return parent_path + ".delta." + _pad_index(idx)
}

// The path prefix sibling-scanners look for. A caller iterates over
// candidate paths by enumerating idx 0, 1, 2, ... and stopping at the
// first missing file; this prefix is purely for documentation.
fn delta_path_glob_prefix(parent_path) {
    return parent_path + ".delta."
}

// Compaction threshold, env-overridable. The orchestrator
// (snap_delta_save in snapshot_disk.nova) calls this to decide whether
// to fold the accumulated deltas into a new full snapshot.
fn snap_delta_compact_threshold() {
    let env = getenv("CE_DELTA_COMPACT_THRESHOLD")
    if env != 0 {
        let v = str_to_int(env)
        if v > 0 { return v }
    }
    return DELTA_COMPACTION_THRESHOLD_DEFAULT
}

// ---- crash-safe disk I/O (parallel to snap_write_durable) ----------------
//
// Same five-step contract the R5D writer uses: write_tmp -> fsync ->
// close -> rename -> parent fsync. We duplicate the implementation here
// rather than re-export from snapshot_disk.nova because that module
// imports us; depending on it back would create a cycle.

let _DELTA_FILE_MODE = 420   // 0644: rw-r--r--

fn _delta_last_slash(path) {
    let i = len(path) - 1
    while i >= 0 {
        if char_at(path, i) == 47 { return i }
        i = i - 1
    }
    return -1
}

fn _delta_parent_dir(path) {
    let i = _delta_last_slash(path)
    if i < 0 { return "." }
    if i == 0 { return "/" }
    return substr(path, 0, i)
}

fn _delta_tmp_path(path) { return path + ".tmp" }

// Write `text` to `path` durably. Mirrors snap_write_durable: same five
// syscalls, same return semantics (1 on success, 0 on any failure).
fn delta_write_durable(text, path) {
    let tmp = _delta_tmp_path(path)
    let flags = O_WRONLY + O_CREAT + O_TRUNC
    let fd = sys_open(tmp, flags, _DELTA_FILE_MODE)
    if fd < 0 { return 0 }
    let n = len(text)
    let written = sys_write(fd, text, n)
    if written != n {
        sys_close(fd)
        sys_unlink(tmp)
        return 0
    }
    sys_fsync(fd)
    sys_close(fd)
    let rr = sys_rename(tmp, path)
    if rr != 0 {
        sys_unlink(tmp)
        return 0
    }
    let parent = _delta_parent_dir(path)
    let dfd = sys_open(parent, O_RDONLY, 0)
    if dfd >= 0 {
        sys_fsync(dfd)
        sys_close(dfd)
    }
    return 1
}

// Read the entire file at `path` as text. Returns 0 if missing.
// Identical contract to snap_read_text.
fn delta_read_text(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return 0 }
    let chunk = 4096
    let buf = alloc(chunk + 1)
    let acc = ""
    let done = 0
    while done == 0 {
        let m = sys_read(fd, buf, chunk)
        if m <= 0 {
            done = 1
        } else {
            store8(buf + m, 0)
            acc = acc + buf
            if m < chunk { done = 1 }
        }
    }
    sys_close(fd)
    return acc
}

// Test the existence of a file path. Returns 1 if openable for read,
// 0 otherwise. Used by the sibling-delta scanner to find the
// contiguous range of delta indices that exist on disk.
fn delta_file_exists(path) {
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 { return 0 }
    sys_close(fd)
    return 1
}

// Convenience: serialize the writer's ops and write them durably.
fn delta_writer_flush(w, path) {
    if w == 0 { return 0 }
    return delta_write_durable(delta_writer_to_text(w), path)
}

// Convenience: read + parse a delta file in one call.
fn delta_load(path) {
    let text = delta_read_text(path)
    if text == 0 { return 0 }
    if len(text) == 0 { return 0 }
    return delta_parse(text)
}

// ---- sibling-delta enumeration --------------------------------------------
//
// Given a parent path, return the list of existing delta paths in apply
// order (0, 1, 2, ...). The scan stops at the first missing index, so a
// gap in the sequence (caused by a partial unlink) terminates
// enumeration -- the substrate refuses to apply later deltas if an
// earlier one is missing.

fn delta_paths_for_parent(parent_path) {
    let out = list_new()
    let i = 0
    let done = 0
    while done == 0 {
        let p = delta_path_for(parent_path, i)
        if delta_file_exists(p) == 1 {
            push(out, p)
            i = i + 1
        } else {
            done = 1
        }
    }
    return out
}

// Next free index: the count of existing deltas. Callers use it to
// pick the path for the next delta_writer_flush.
fn delta_next_index_for_parent(parent_path) {
    return len(delta_paths_for_parent(parent_path))
}

// Remove every delta file sibling to `parent_path`. Called by the
// compactor after a successful new-full-snapshot write. Returns the
// number of files unlinked.
fn delta_prune_all(parent_path) {
    let removed = 0
    let i = 0
    let done = 0
    while done == 0 {
        let p = delta_path_for(parent_path, i)
        if delta_file_exists(p) == 1 {
            sys_unlink(p)
            removed = removed + 1
            i = i + 1
        } else {
            done = 1
        }
    }
    return removed
}

// ---- apply a parsed delta to a KG registry --------------------------------
//
// Returns [applied, skipped] on success, or 0 if the reader's
// parent fingerprint does not match `expected_fp` (loud failure).
//
// Per-op semantics:
//   ADD: kg_spawn(reg, kg_label); if no atom with that label exists,
//        create one; if it does, refresh its belief (replace-by-label,
//        matching kg_section_apply's R5D policy).
//   MOD: find the atom by id within the named KG; patch the field.
//   DEL: find the atom by id within the named KG; mark it removed via
//        kg_remove_atom (P2.4 tombstone semantics, same as the live
//        atom-death monitor).
//
// Atoms in an unknown KG are SKIPPED (matches R5D's snap_section_apply
// policy for unknown KGs -- friendlier for forward-compat).
fn delta_reader_apply(r, kg_reg, expected_fp) {
    if r == 0 { return 0 }
    if kg_reg == 0 { return 0 }
    // Parent-fingerprint check. An empty expected_fp is treated as
    // "accept any" (used by tests that don't have a fingerprint
    // handy). The runtime sweep always passes the real fp.
    if len(expected_fp) > 0 {
        if str_eq(r[_DR_PARENT_FP], expected_fp) == 0 {
            return 0
        }
    }
    let applied = 0
    let skipped = 0
    let ops = r[_DR_OPS]
    let i = 0
    while i < len(ops) {
        let op = ops[i]
        let tag = op[0]
        let kg_label = op[2]
        if kgreg_has_label(kg_reg, kg_label) == 0 {
            skipped = skipped + 1
        } else {
            let target = kg_spawn(kg_reg, kg_label)
            if tag == DELTA_OP_ADD {
                let label = op[4]
                let existing = kg_find_atom(target, label)
                let a = existing
                if existing == 0 {
                    a = kg_add_atom(target, op[3], label, 0)
                }
                let b = atom_belief(a)
                list_set(b, 0, op[5])
                list_set(b, 1, op[6])
                applied = applied + 1
            }
            if tag == DELTA_OP_MOD {
                let aid = op[1]
                let field = op[3]
                let value = op[4]
                let a = kg_atom(target, aid)
                if a == 0 {
                    skipped = skipped + 1
                } else {
                    if str_eq(field, "alpha") == 1 {
                        list_set(atom_belief(a), 0, value)
                        applied = applied + 1
                    } else {
                        if str_eq(field, "beta") == 1 {
                            list_set(atom_belief(a), 1, value)
                            applied = applied + 1
                        } else {
                            // Unknown field: silently skip. Forward-compat
                            // for a future writer.
                            skipped = skipped + 1
                        }
                    }
                }
            }
            if tag == DELTA_OP_DEL {
                let aid = op[1]
                let removed_ok = kg_remove_atom(target, aid)
                if removed_ok == 1 {
                    applied = applied + 1
                } else {
                    skipped = skipped + 1
                }
            }
        }
        i = i + 1
    }
    let out = list_new()
    push(out, applied)
    push(out, skipped)
    return out
}

// Apply every sibling delta of `parent_path`, in order, to `kg_reg`.
// `expected_fp` is the parent's fingerprint; a delta with a mismatched
// fingerprint aborts the apply and returns [applied_so_far,
// skipped_so_far, mismatch_idx]. On success returns [applied, skipped,
// -1].
fn delta_apply_all_for_parent(parent_path, kg_reg, expected_fp) {
    let paths = delta_paths_for_parent(parent_path)
    let applied = 0
    let skipped = 0
    let mismatch_at = 0 - 1
    let i = 0
    let aborted = 0
    while i < len(paths) {
        if aborted == 0 {
            let r = delta_load(paths[i])
            if r == 0 {
                // Unparseable delta: skip silently (could be a partial
                // write from a crashed process).
                skipped = skipped + 1
            } else {
                let res = delta_reader_apply(r, kg_reg, expected_fp)
                if res == 0 {
                    // Fingerprint mismatch: refuse to apply this OR any
                    // subsequent delta. The orphan deltas will get cleaned
                    // up by the next compaction pass.
                    aborted = 1
                    mismatch_at = i
                } else {
                    applied = applied + res[0]
                    skipped = skipped + res[1]
                }
            }
        }
        i = i + 1
    }
    let out = list_new()
    push(out, applied)
    push(out, skipped)
    push(out, mismatch_at)
    return out
}
