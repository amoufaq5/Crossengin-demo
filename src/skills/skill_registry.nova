// CrossEngin skills: per-session skill registry (ADR-0103).
//
// One registry per Session (following CapsuleRegistry / PersonaRegistry
// pattern). Registered vs installed is deliberate: a skill can be
// registered (manifest known to the registry) without being currently
// installed (supervisor spun up). Install checks required-capsule deps
// against a CapsuleRegistry -- refuses if any is missing OR not
// currently installed.
//
// Registry-only concerns live here. Supervisor lifecycle (start / tick
// / retire / snapshot) lives in src/skills/skill_supervisor.nova.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/skills/skill_manifest.nova
//   src/capsules/capsule_registry.nova (dep resolution on install)
//   src/util/str_safe.nova.

import "./skill_manifest.nova"
import "../capsules/capsule_registry.nova"
import "../util/str_safe.nova"

// ---- registry entry slots -------------------------------------------------
//
// Each registry entry pairs a manifest with an install-state flag. The
// supervisor state (once installed) is a SEPARATE structure managed by
// skill_supervisor.nova and referenced from here via SR_SUPERVISOR.
let SR_MANIFEST     = 0
let SR_INSTALLED    = 1   // 0/1 -- ready to run vs registered-only
let SR_INSTALLED_AT = 2   // moment; 0 while not installed
let SR_SUPERVISOR   = 3   // supervisor handle when installed, else 0
let SR_SLOT_COUNT   = 4

// ---- registry slot layout -------------------------------------------------
let SKREG_ENTRIES = 0    // list<SkillRegEntry>

// ---- install-result codes -------------------------------------------------
let SKILL_INSTALL_OK                  = 0
let SKILL_INSTALL_UNKNOWN             = -1  // skill name not registered
let SKILL_INSTALL_ALREADY             = -2  // already installed
let SKILL_INSTALL_DEP_MISSING         = -3  // required capsule not registered
let SKILL_INSTALL_DEP_NOT_INSTALLED   = -4  // required capsule not installed

// ---- constructor + queries ------------------------------------------------

fn skill_registry_new() {
    let r = list_new()
    push(r, list_new())         // ENTRIES
    return r
}

fn skill_registry_count(reg)   { return len(reg[SKREG_ENTRIES]) }
fn skill_registry_entries(reg) { return reg[SKREG_ENTRIES] }

// Look up a registry entry by skill name. Returns the entry (a 4-list),
// or 0 if absent. Prefer the accessors below for callers that only
// need the manifest / install state.
fn skill_registry_lookup(reg, name) {
    let entries = reg[SKREG_ENTRIES]
    let i = 0
    while i < len(entries) {
        let m = entries[i][SR_MANIFEST]
        if str_eq_bytes(skill_manifest_name(m), name) == 1 { return entries[i] }
        i = i + 1
    }
    return 0
}

// Convenience: manifest by name (0 if absent).
fn skill_registry_manifest(reg, name) {
    let e = skill_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[SR_MANIFEST]
}

// True/false: is a skill by this name installed right now?
fn skill_registry_is_installed(reg, name) {
    let e = skill_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[SR_INSTALLED]
}

// Supervisor handle for an installed skill; 0 if not installed OR unknown.
fn skill_registry_supervisor(reg, name) {
    let e = skill_registry_lookup(reg, name)
    if e == 0 { return 0 }
    return e[SR_SUPERVISOR]
}

// ---- register -------------------------------------------------------------

// Register a manifest under its own name. Returns 1 on insert; 0 if a
// skill with that name already exists (registry is a set keyed on name).
fn skill_registry_register(reg, manifest) {
    let name = skill_manifest_name(manifest)
    if skill_registry_lookup(reg, name) != 0 { return 0 }
    let e = list_new()
    push(e, manifest)                 // SR_MANIFEST
    push(e, 0)                         // SR_INSTALLED
    push(e, 0)                         // SR_INSTALLED_AT
    push(e, 0)                         // SR_SUPERVISOR
    push(reg[SKREG_ENTRIES], e)
    return 1
}

// ---- install / uninstall --------------------------------------------------

// Verify that every required capsule for `manifest` is registered AND
// currently installed in `capreg`. Returns [ok, first_missing_name,
// first_uninstalled_name]. ok=1 only if every dep passes both checks.
fn skill_check_capsule_deps(manifest, capreg) {
    let out = list_new()
    push(out, 1) push(out, "") push(out, "")
    if capreg == 0 { return out }        // no capreg -> trust
    let deps = skill_manifest_required_capsules(manifest)
    let i = 0
    while i < len(deps) {
        let name = deps[i][0]
        let cap = capreg_lookup(capreg, name)
        if cap == 0 {
            list_set(out, 0, 0)
            list_set(out, 1, name)
            return out
        }
        if capreg_is_installed(capreg, name) == 0 {
            list_set(out, 0, 0)
            list_set(out, 2, name)
            return out
        }
        i = i + 1
    }
    return out
}

// Install a registered skill. Verifies capsule deps via `capreg`
// (pass 0 to skip dep checking -- test convenience only; not for
// production). On success attaches `supervisor_handle` (the caller
// constructs it separately; the supervisor module owns the lifecycle
// mechanics). Returns SKILL_INSTALL_* code.
fn skill_registry_install(reg, name, capreg, supervisor_handle, now) {
    let e = skill_registry_lookup(reg, name)
    if e == 0 { return SKILL_INSTALL_UNKNOWN }
    if e[SR_INSTALLED] == 1 { return SKILL_INSTALL_ALREADY }
    let manifest = e[SR_MANIFEST]
    let check = skill_check_capsule_deps(manifest, capreg)
    if check[0] == 0 {
        if len(check[1]) > 0 { return SKILL_INSTALL_DEP_MISSING }
        if len(check[2]) > 0 { return SKILL_INSTALL_DEP_NOT_INSTALLED }
    }
    list_set(e, SR_INSTALLED, 1)
    list_set(e, SR_INSTALLED_AT, now)
    list_set(e, SR_SUPERVISOR, supervisor_handle)
    return SKILL_INSTALL_OK
}

// Human-readable label for an install-result code.
fn skill_install_name(code) {
    if code == SKILL_INSTALL_OK                { return "ok" }
    if code == SKILL_INSTALL_UNKNOWN           { return "unknown-skill" }
    if code == SKILL_INSTALL_ALREADY           { return "already-installed" }
    if code == SKILL_INSTALL_DEP_MISSING       { return "required-capsule-missing" }
    if code == SKILL_INSTALL_DEP_NOT_INSTALLED { return "required-capsule-not-installed" }
    return "unknown-code"
}

// Uninstall a currently-installed skill. Clears the supervisor handle.
// Returns 1 on applied, 0 on not-installed / unknown.
fn skill_registry_uninstall(reg, name) {
    let e = skill_registry_lookup(reg, name)
    if e == 0 { return 0 }
    if e[SR_INSTALLED] == 0 { return 0 }
    list_set(e, SR_INSTALLED, 0)
    list_set(e, SR_INSTALLED_AT, 0)
    list_set(e, SR_SUPERVISOR, 0)
    return 1
}

// Remove a skill entirely from the registry (manifest + install state
// both gone). Returns 1 if applied, 0 if not found.
fn skill_registry_remove(reg, name) {
    let entries = reg[SKREG_ENTRIES]
    let idx = 0 - 1
    let i = 0
    while i < len(entries) {
        let m = entries[i][SR_MANIFEST]
        if str_eq_bytes(skill_manifest_name(m), name) == 1 {
            idx = i
            i = len(entries)
        }
        i = i + 1
    }
    if idx < 0 { return 0 }
    let kept = list_new()
    let j = 0
    while j < len(entries) {
        if j != idx { push(kept, entries[j]) }
        j = j + 1
    }
    list_set(reg, SKREG_ENTRIES, kept)
    return 1
}

// ---- listing helpers ------------------------------------------------------

// Names of all installed skills (regardless of manifest).
fn skill_registry_installed_names(reg) {
    let out = list_new()
    let entries = reg[SKREG_ENTRIES]
    let i = 0
    while i < len(entries) {
        if entries[i][SR_INSTALLED] == 1 {
            push(out, skill_manifest_name(entries[i][SR_MANIFEST]))
        }
        i = i + 1
    }
    return out
}

// Names of every registered skill.
fn skill_registry_names(reg) {
    let out = list_new()
    let entries = reg[SKREG_ENTRIES]
    let i = 0
    while i < len(entries) {
        push(out, skill_manifest_name(entries[i][SR_MANIFEST]))
        i = i + 1
    }
    return out
}
