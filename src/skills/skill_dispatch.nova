// CrossEngin skills: policy dispatch + skill_run entry point (ADR-0103).
//
// This module composes the supervisor's helpers (refusal checks,
// projection, attribution) with policy dispatch by integer policy_id.
// Reference skills each register their own SKILL_POLICY_* constant +
// their policy fn; the switch below wires them.
//
// Consumers import THIS module (not skill_supervisor directly) when
// they want to invoke skills, because skill_run is the composed entry
// point that enforces the 5 hard guarantees from ADR-0103:
//
//   1. Refusal conditions checked BEFORE the policy runs (short-circuit).
//   2. Persona projection ALWAYS attached (even on refusal).
//   3. Effector calls are DESCRIBED (populated on the result); not
//      executed by the runtime.
//   4. Every atom the policy touched flows to the meta-observer under
//      the skill's attribution prefix.
//   5. The persona is READ-ONLY through this path.
//
// Adding a new reference skill = new file under src/skills/skills/,
// new SKILL_POLICY_* constant, one new case in the switch below.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/skills/skill_manifest.nova, src/skills/skill_supervisor.nova,
//   src/skills/skills/echo_skill.nova (and future reference skills).

import "./skill_manifest.nova"
import "./skill_supervisor.nova"
import "./skills/echo_skill.nova"
import "./skills/research_skill.nova"
import "./skills/coding_helper.nova"
import "../parts/meta/gaps_register.nova"

// ---- policy dispatch ------------------------------------------------------

// Route `perception` to the right policy by policy_id. Fills `result`
// in-place. On unknown policy_id, marks the result refused with a
// descriptive reason.
fn skill_dispatch_policy(supervisor, perception, result) {
    let m = skill_sup_manifest(supervisor)
    let pid = skill_manifest_policy_id(m)
    if pid == SKILL_POLICY_ECHO          { return echo_skill_policy(supervisor, perception, result) }
    if pid == SKILL_POLICY_RESEARCH      { return research_skill_policy(supervisor, perception, result) }
    if pid == SKILL_POLICY_CODING_HELPER { return coding_helper_policy(supervisor, perception, result) }
    skill_pr_refuse(result,
        "unknown policy_id " + int_to_str(pid)
        + " (no case in skill_dispatch_policy)")
    return 0
}

// R64: scoped dispatch. Only policies that CONSULT patterns thread
// (overlay, holder) through; every other policy gets the same
// unscoped call it received before R64 so its behavior stays
// byte-identical for existing callers. Adding a new pattern-aware
// skill is a one-line addition here plus a `_scoped` fn on the
// policy module.
fn skill_dispatch_policy_scoped(supervisor, perception,
                                 ownership_overlay, holder, result) {
    let m = skill_sup_manifest(supervisor)
    let pid = skill_manifest_policy_id(m)
    if pid == SKILL_POLICY_CODING_HELPER {
        return coding_helper_policy_scoped(supervisor, perception,
                                            ownership_overlay, holder, result)
    }
    // Every other policy is scope-agnostic today.
    return skill_dispatch_policy(supervisor, perception, result)
}

// ---- the composed entry point (skill_run) --------------------------------

// R47p2 signature preserved as a thin wrapper around skill_run_scoped
// so every existing caller (chat REPL, tests, executor's research
// path) compiles + behaves byte-identically. Only rpc_verbs.nova's
// `skill.run` verb upgraded to pass the wired overlay + presented
// holder through.
fn skill_run(supervisor, perception) {
    return skill_run_scoped(supervisor, perception, 0, "", 0, "")
}

// Run the skill, enforcing ADR-0103's 5 guarantees. See module header
// for the guarantee list. R64 adds two args:
//   ownership_overlay  -- may be 0 (no overlay wired; R47-R63 behavior)
//   holder             -- may be "" (anonymous)
// The scope is threaded to policies that consult patterns (currently
// coding_helper). Refusal semantics + attribution + projection are
// unchanged.
//
// R103 adds two trailing args for gap recording:
//   gaps_reg  -- may be 0 (no recording; existing test call sites)
//   topic     -- short label for the gap event (may be ""). The
//                supervisor cannot recover the raw perception text
//                shape (each policy defines its own), so the caller
//                supplies a topic string that names the ask; typically
//                the perception itself for scalar-perception policies
//                or the topic slice for structured perceptions.
// When the skill refuses (either pre-policy or post-policy) and
// gaps_reg is wired, one GAP_SKILL_REFUSED event is recorded with the
// refusal_reason as detail.
fn skill_run_scoped(supervisor, perception, ownership_overlay, holder,
                    gaps_reg, topic) {
    let result = skill_pr_new()
    skill_sup_bump_tick(supervisor)
    // 1. Pre-policy refusal short-circuit.
    let pre = skill_sup_check_pre_refusals(supervisor)
    if pre != 0 {
        skill_pr_refuse(result, pre)
        skill_pr_add_trace(result, "pre-policy refusal: " + pre)
        skill_sup_set_status(supervisor, SKILL_REFUSED)
        // Persona projection attached EVEN ON REFUSAL.
        skill_sup_attach_projection(supervisor, result)
        // R103: record the gap. supervisor holds no now-source; use 0.
        gaps_record(gaps_reg, holder, topic, GAP_SKILL_REFUSED, pre, 0)
        return result
    }
    // 2. Dispatch to the policy (scoped).
    skill_sup_set_status(supervisor, SKILL_RUNNING)
    skill_dispatch_policy_scoped(supervisor, perception,
                                  ownership_overlay, holder, result)
    // 3. Post-policy refusal check (MIN_CONFIDENCE).
    let post = skill_sup_check_post_refusals(supervisor, result)
    if post != 0 {
        skill_pr_refuse(result, post)
        skill_pr_add_trace(result, "post-policy refusal: " + post)
        skill_sup_set_status(supervisor, SKILL_REFUSED)
        // R103: record the min-confidence refusal (still a skill gap).
        gaps_record(gaps_reg, holder, topic, GAP_SKILL_REFUSED, post, 0)
    }
    // 4. Meta-observer attribution of touched atoms.
    skill_sup_attribute_atoms(supervisor, result)
    // 5. Persona projection (advise-only per ADR-0102; NEVER blocks).
    skill_sup_attach_projection(supervisor, result)
    return result
}
