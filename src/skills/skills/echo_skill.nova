// CrossEngin skills: echo_skill -- trivial reference (ADR-0103 §Reference).
//
// The simplest possible policy: given a text query, walk every KG in the
// supervisor's registry, collect atoms whose labels overlap the query
// tokens (per the same tokenizer persona_project uses -- ASCII words,
// stopwords removed), report each with belief + KG name, set confidence
// to the max atom mean encountered.
//
// No effectors. No side effects. Deterministic. Exists to prove the
// runtime end-to-end and serve as the template for future reference
// skills.
//
// Perception shape: a plain string (the query).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/skills/skill_manifest.nova (for the policy_id constant),
//   src/skills/skill_supervisor.nova (ProposalResult mutators + accessors),
//   src/kg/multi_kg_manager.nova, src/kg/atom_store.nova,
//   src/util/str_safe.nova.

import "../skill_manifest.nova"
import "../skill_supervisor.nova"
import "../../kg/multi_kg_manager.nova"
import "../../kg/atom_store.nova"
import "../../util/str_safe.nova"

// Canonical policy id for echo_skill. skill_dispatch.nova switches on this.
let SKILL_POLICY_ECHO = 1

// Build the standard manifest for this skill. Consumers register this
// (or a copy) into a SkillRegistry.
fn echo_skill_manifest() {
    return skill_manifest_new("echo", "1.0.0",
        "Walk every KG for query-token label matches; return atoms with beliefs.",
        SKILL_POLICY_ECHO)
}

// ---- tokenizer (local; identical shape to persona_project's) --------------

fn _echo_is_wordchar(c) {
    if c >= 65 { if c <= 90  { return 1 } }
    if c >= 97 { if c <= 122 { return 1 } }
    if c >= 48 { if c <= 57  { return 1 } }
    if c == 95 { return 1 }
    return 0
}

fn _echo_lower(c) {
    if c >= 65 { if c <= 90 { return c + 32 } }
    return c
}

fn _echo_is_stopword(w) {
    if len(w) < 3 { return 1 }
    if str_eq_bytes(w, "the") == 1 { return 1 }
    if str_eq_bytes(w, "and") == 1 { return 1 }
    if str_eq_bytes(w, "for") == 1 { return 1 }
    if str_eq_bytes(w, "with") == 1 { return 1 }
    if str_eq_bytes(w, "that") == 1 { return 1 }
    if str_eq_bytes(w, "this") == 1 { return 1 }
    return 0
}

fn _echo_lower_str(s) {
    let out = ""
    let n = len(s)
    let i = 0
    while i < n {
        out = out + chr(_echo_lower(char_at(s, i)))
        i = i + 1
    }
    return out
}

fn _echo_tokenize(s) {
    let out = list_new()
    let n = len(s)
    let start = 0 - 1
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if _echo_is_wordchar(c) == 1 {
            if start < 0 { start = i }
        } else {
            if start >= 0 {
                let w = _echo_lower_str(substr(s, start, i - start))
                if _echo_is_stopword(w) == 0 { push(out, w) }
                start = 0 - 1
            }
        }
        i = i + 1
    }
    if start >= 0 {
        let w = _echo_lower_str(substr(s, start, n - start))
        if _echo_is_stopword(w) == 0 { push(out, w) }
    }
    return out
}

// Is `token` a substring of the lowercased `label`? Used because atom
// labels may be multi-word snake_case ("moon_landing_1969") and the
// query token might be just one part ("moon").
fn _echo_label_contains_token(label, token) {
    let low = _echo_lower_str(label)
    let ln = len(low)
    let tn = len(token)
    if tn == 0 { return 0 }
    if tn > ln { return 0 }
    let limit = ln - tn
    let i = 0
    while i <= limit {
        let ok = 1
        let j = 0
        while j < tn {
            if char_at(low, i + j) != char_at(token, j) { ok = 0 j = tn }
            else { j = j + 1 }
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- the policy -----------------------------------------------------------

// Walk the supervisor's KG registry for atoms whose labels match any of
// the query tokens (case-insensitive substring). Populates the
// ProposalResult with:
//   proposal:    a human-readable string listing matches per KG
//   atoms:       every matched atom (for meta-observer attribution)
//   confidence:  the highest atom mean encountered (0 if nothing found)
//   trace:       per-KG count of matches
// Effector calls: NONE.
fn echo_skill_policy(supervisor, perception, result) {
    let kgreg = skill_sup_kg_registry(supervisor)
    if kgreg == 0 {
        skill_pr_add_trace(result, "no KG registry attached; nothing to walk")
        skill_pr_set_proposal(result, "(no KGs to search)")
        skill_pr_set_confidence(result, 0)
        skill_pr_set_ok(result)
        return 0
    }
    let query = perception
    if len(query) == 0 {
        skill_pr_add_trace(result, "empty query; returning noop proposal")
        skill_pr_set_proposal(result, "(empty query)")
        skill_pr_set_confidence(result, 0)
        skill_pr_set_ok(result)
        return 0
    }
    let tokens = _echo_tokenize(query)
    skill_pr_add_trace(result,
        "tokenized query to " + int_to_str(len(tokens)) + " content words")
    if len(tokens) == 0 {
        skill_pr_set_proposal(result,
            "(query had no content words after stopword filter)")
        skill_pr_set_confidence(result, 0)
        skill_pr_set_ok(result)
        return 0
    }
    let proposal = "matches for query '" + query + "':\n"
    let max_mean = 0
    let total_matches = 0
    let n_kgs = kg_count(kgreg)
    let ki = 0
    while ki < n_kgs {
        let kg = kg_get(kgreg, ki)
        if kg != 0 {
            let kg_lab = kg_label(kg)
            let atoms = kg_atoms(kg)
            let per_kg_hits = 0
            let ai = 0
            while ai < len(atoms) {
                let a = atoms[ai]
                if a != 0 {
                    let lab = atom_label(a)
                    // Match if any token appears in the label.
                    let matched = 0
                    let ti = 0
                    while ti < len(tokens) {
                        if _echo_label_contains_token(lab, tokens[ti]) == 1 {
                            matched = 1
                            ti = len(tokens)
                        }
                        ti = ti + 1
                    }
                    if matched == 1 {
                        let mean = bel_mean(atom_belief(a))
                        proposal = proposal + "  [" + kg_lab + "] " + lab
                                 + " belief=" + int_to_str(mean) + "\n"
                        skill_pr_add_atom(result, a)
                        if mean > max_mean { max_mean = mean }
                        per_kg_hits = per_kg_hits + 1
                        total_matches = total_matches + 1
                    }
                }
                ai = ai + 1
            }
            if per_kg_hits > 0 {
                skill_pr_add_trace(result, "KG " + kg_lab + ": "
                    + int_to_str(per_kg_hits) + " matches")
            }
        }
        ki = ki + 1
    }
    if total_matches == 0 {
        proposal = proposal + "  (no matches across " + int_to_str(n_kgs) + " KGs)\n"
    }
    skill_pr_set_proposal(result, proposal)
    skill_pr_set_confidence(result, max_mean)
    skill_pr_set_ok(result)
    return total_matches
}
