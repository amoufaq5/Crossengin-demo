// CrossEngin skills: coding_helper -- the vision's example skill
// (ADR-0103 §Reference, v2). R53 activates the policy body by consulting
// the `debug_common` pattern capsule (ADR-0107) so the skill produces
// real, source-tagged guidance the moment it's installed. No more stub.
//
// The user asks: "Help me debug this X" or "Write a Y function". The
// coding_helper:
//   1. Tokenizes the problem description via the shared pattern
//      tokenizer (ASCII wordchars, lowercased, stopwords out --
//      same rules the grammar parser uses).
//   2. Queries pattern_registry_match(tokens, ["debug_common"]) for
//      matching heuristics from the built-in debug capsule.
//   3. Ranks matches by confidence descending, weaves the top-N
//      (default 5) into the proposal body, tags each contributing
//      pattern's source in the trace so audit can attribute advice.
//   4. Sets proposal confidence to the max matched pattern's
//      confidence -- a strong match yields a strong proposal; no
//      matches yield confidence 0 + a "describe the problem in more
//      terms" hint.
//   5. Effector calls stay DESCRIBED, not executed (ADR-0103 #3):
//      the skill lists the shape of code_exec / file_ops calls it
//      WOULD make, but the effector gate stays external.
//
// The `debug_pattern` capsule dep is now satisfied by the built-in
// pattern registry -- the runtime always has `debug_common`
// available, so the skill can activate without an external pack
// install (though a shop can still register a `debug_pattern`
// override that takes precedence via the same
// pattern_registry_register API).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/skills/skill_manifest.nova, src/skills/skill_supervisor.nova,
//   src/capsules/pattern_capsule.nova, src/util/str_safe.nova.

import "../skill_manifest.nova"
import "../skill_supervisor.nova"
import "../../capsules/pattern_capsule.nova"
import "../../util/str_safe.nova"

let SKILL_POLICY_CODING_HELPER = 3

// Max patterns woven into the proposal body. Keeps proposals readable
// even on a query that trips a dozen heuristics; the trace still lists
// every match for audit.
let CODING_HELPER_MAX_MATCHES = 5

// ---- manifest -------------------------------------------------------------

// Build the canonical manifest for this skill. Declares:
//   * effectors: effector_code_exec + effector_file_ops
//   * capability tier: USER (no elevated ops -- code exec is user-scoped,
//     file ops are user-scoped; if a caller needs root work they'd
//     install a different skill).
//
// Note: R53 drops the COND_CAPSULE_UNINSTALLED refusal conditions the
// stub declared. Patterns come from the process-wide pattern registry
// (lazy-init built-ins), NOT from the capsule registry. A future
// R54+ pass could wire declared pattern-capsule deps here for
// finer-grained skill/pattern coupling; for R53 the built-in
// debug_common is always available so the skill can activate on
// install with zero extra setup.
fn coding_helper_manifest() {
    let m = skill_manifest_new("coding_helper", "1.0.0",
        "Debug a problem by matching it against a library of debug heuristics (debug_common pattern capsule, ADR-0107). Ranks matches by confidence; describes effector calls the runtime would make.",
        SKILL_POLICY_CODING_HELPER)
    skill_manifest_set_tier(m, SKILL_TIER_USER)
    // Declared effectors -- described, not executed by the supervisor.
    skill_manifest_add_effector(m, "effector_code_exec")
    skill_manifest_add_effector(m, "effector_file_ops")
    return m
}

// ---- policy ---------------------------------------------------------------

// Compose the "N patterns matched" line for the proposal body.
fn _ch_summary_line(n_matches) {
    if n_matches == 0 {
        return "  (no debug pattern matched your problem description)"
    }
    let s = "  matched " + int_to_str(n_matches) + " debug pattern"
    if n_matches != 1 { s = s + "s" }
    return s + " (top " + int_to_str(CODING_HELPER_MAX_MATCHES) + " below):"
}

// Return the smaller of a and b.
fn _ch_min(a, b) {
    if a < b { return a }
    return b
}

// R64: policy body split into a helper that accepts ownership overlay
// + holder so `pattern_registry_match_scoped` can filter out capsules
// the caller can't see. The R47p5-R63 entry point
// `coding_helper_policy` stays as a thin wrapper delegating with
// overlay=0, holder="" -- byte-identical behavior for every existing
// caller (single-user chat REPL, tests, skill.run without a wired
// overlay).
fn coding_helper_policy(supervisor, perception, result) {
    return coding_helper_policy_scoped(supervisor, perception, 0, "", result)
}

fn coding_helper_policy_scoped(supervisor, perception,
                                ownership_overlay, holder, result) {
    let problem = perception
    if len(problem) == 0 {
        skill_pr_add_trace(result, "empty problem description")
        skill_pr_set_proposal(result,
            "(no problem description supplied; usage: /skill run coding_helper DESCRIBE_YOUR_PROBLEM)")
        skill_pr_set_confidence(result, 0)
        skill_pr_set_ok(result)
        return 0
    }
    let tokens = pcap_tokenize(problem)
    skill_pr_add_trace(result,
        "tokenized problem to " + int_to_str(len(tokens))
        + " content word(s)")
    // Match against debug_common only. A future manifest field could
    // let a skill instance point at a different capsule name
    // ("debug_shop_x"), but the default -- and what the built-in
    // registry always makes available -- is debug_common.
    let filter = list_new()
    push(filter, "debug_common")
    // R64 ownership gate: when an overlay is wired, filter capsules
    // by presented holder BEFORE matching so a caller who can't see
    // debug_common (unusual but possible via ownership_set_pattern)
    // gets a zero-match result and the "add more concrete symptoms"
    // hint, not another holder's advice. Absent an overlay
    // (overlay=0), match_scoped == match unscoped (R63 guarantee).
    let matches = 0
    if ownership_overlay == 0 {
        matches = pattern_registry_match(tokens, filter)
    } else {
        skill_pr_add_trace(result,
            "ownership overlay wired -- filtering by holder '"
            + holder + "'")
        matches = pattern_registry_match_scoped(tokens, filter,
                                                 ownership_overlay, holder)
    }
    let n = len(matches)
    skill_pr_add_trace(result,
        "matched " + int_to_str(n) + " debug pattern(s)")
    // Compose the proposal body.
    let body = "coding_helper on your problem:\n  \"" + problem + "\"\n\n"
    body = body + _ch_summary_line(n) + "\n"
    let shown = _ch_min(n, CODING_HELPER_MAX_MATCHES)
    let max_conf = 0
    let i = 0
    while i < shown {
        let p = matches[i]
        body = body + "\n  " + int_to_str(i + 1) + ". "
             + pcap_guidance(p) + "\n"
        body = body + "     [confidence " + int_to_str(pcap_confidence(p))
             + "/1000; " + pcap_source_tag(p) + "]\n"
        // Record the SOURCE (not the atom -- patterns are advice, not
        // knowledge) as a trace crumb so /why can enumerate contributions.
        skill_pr_add_trace(result,
            "matched: " + pcap_source_tag(p)
            + " (confidence " + int_to_str(pcap_confidence(p)) + ")")
        if pcap_confidence(p) > max_conf { max_conf = pcap_confidence(p) }
        i = i + 1
    }
    if n > shown {
        body = body + "\n  (" + int_to_str(n - shown)
             + " more match(es) elided; audit trace lists all)\n"
    }
    // Describe (do not execute) the effector calls the skill would make
    // if the operator approves. Shape stays the same regardless of
    // match count -- these are the tools the skill has available.
    if n > 0 {
        body = body + "\nOn approval this skill would:\n"
        body = body + "  - effector_code_exec(<language>, <minimal-test>)\n"
        body = body + "    to reproduce the bug in isolation\n"
        body = body + "  - effector_file_ops(read, <source-path>)\n"
        body = body + "    to fetch the source context\n"
        let ec_args = list_new()
        push(ec_args, "<language>") push(ec_args, "<minimal-test-source>")
        skill_pr_add_effector_call(result, "effector_code_exec", ec_args)
        let fo_args = list_new()
        push(fo_args, "read") push(fo_args, "<source-path>")
        skill_pr_add_effector_call(result, "effector_file_ops", fo_args)
    } else {
        body = body + "\nHint: add more concrete symptoms (\"null pointer\", "
             + "\"race condition\", \"stack overflow\", \"timeout\") to your "
             + "description; the pattern matcher is token-based.\n"
    }
    skill_pr_set_proposal(result, body)
    skill_pr_set_confidence(result, max_conf)
    skill_pr_set_ok(result)
    return n
}
