// CrossEngin skills: coding_helper -- the vision's example skill
// (ADR-0103 §Reference, v2).
//
// The user asks: "Help me debug this X" or "Write a Y function". The
// coding_helper walks:
//   1. The `coding` capsule for language + concept atoms matching the
//      problem tokens (Python identifiers, JS syntax, null-pointer,
//      type-mismatch, etc.).
//   2. The `debug_pattern` PATTERN capsule (ADR-0107) for methodology
//      atoms in step order:
//        reproduce_bug -> isolate_change -> form_hypothesis ->
//        design_minimal_test -> verify_fix -> check_regressions
//   3. Composes a step-by-step proposal grounded in what those capsules
//      say, plus the persona's projection on the proposed steps.
//   4. On operator approval, dispatches effector_code_exec (for running
//      minimal test scripts) and effector_file_ops (for reading/writing
//      source snippets). Both effectors are declared here; execution is
//      external (ADR-0103 guarantee #3: runtime DESCRIBES calls, does
//      NOT execute).
//
// SHAPE ships now. POLICY BODY is an honest stub that names exactly
// what it WILL do once the required content lands:
//
//   * ADR-0107 (Pattern Capsules) draft -> adds the `debug_pattern`
//     shape as a subtype of Capsule
//   * data/packs/coding.cerec -> the language + concept atoms
//   * data/packs/debug_pattern.cerec -> the methodology atoms
//
// Until then, the runtime installs the skill (or refuses via the
// COND_CAPSULE_UNINSTALLED conditions) and the policy explains what
// it would do. This lets skills DECLARE their dependencies today so
// downstream layers (chat wiring, capsule marketplace, persona
// projection tuning) can compose over the shape immediately.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/skills/skill_manifest.nova, src/skills/skill_supervisor.nova,
//   src/util/str_safe.nova.

import "../skill_manifest.nova"
import "../skill_supervisor.nova"
import "../../util/str_safe.nova"

let SKILL_POLICY_CODING_HELPER = 3

// ---- manifest -------------------------------------------------------------

// Build the canonical manifest for this skill. Declares:
//   * required capsules: coding:1.0.0 + debug_pattern:1.0.0
//   * effectors: effector_code_exec + effector_file_ops
//   * refusal conditions:
//       - COND_CAPSULE_UNINSTALLED "coding"          (skill can't work
//                                                    without domain
//                                                    knowledge)
//       - COND_CAPSULE_UNINSTALLED "debug_pattern"   (can't work without
//                                                    the methodology)
//   * capability tier: USER (no elevated ops -- code exec is user-scoped,
//     file ops are user-scoped; if a caller needs root work they'd
//     install a different skill).
//   * license: unspecified (author will fill in with the real body).
fn coding_helper_manifest() {
    let m = skill_manifest_new("coding_helper", "1.0.0",
        "Debug + write code by walking a coding capsule + debug-pattern capsule; proposes steps, dispatches code/file effectors on approval.",
        SKILL_POLICY_CODING_HELPER)
    skill_manifest_set_tier(m, SKILL_TIER_USER)
    // Declared dependencies.
    skill_manifest_add_capsule_dep(m, "coding",        "1.0.0")
    skill_manifest_add_capsule_dep(m, "debug_pattern", "1.0.0")
    // Declared effectors.
    skill_manifest_add_effector(m, "effector_code_exec")
    skill_manifest_add_effector(m, "effector_file_ops")
    // Declared refusal conditions -- the supervisor short-circuits BEFORE
    // policy runs if either capsule isn't currently installed.
    skill_manifest_add_refusal(m, COND_CAPSULE_UNINSTALLED, "coding")
    skill_manifest_add_refusal(m, COND_CAPSULE_UNINSTALLED, "debug_pattern")
    return m
}

// ---- policy (honest stub) -------------------------------------------------

// The stub. If the caller manages to invoke the policy (i.e. bypassed
// the refusal conditions -- test convenience, or the deps ARE installed
// but empty), we return a proposal that says exactly what the skill
// WOULD do once the content lands.
//
// This preserves ADR-0103's shape contract (ProposalResult populated,
// confidence 0 so any COND_MIN_CONFIDENCE gate refuses cleanly, effector
// calls DESCRIBED not executed, trace explains the wait) without
// pretending to know things the runtime doesn't.
fn coding_helper_policy(supervisor, perception, result) {
    // Perception is expected to be the user's problem description.
    let problem = perception
    if len(problem) == 0 {
        skill_pr_add_trace(result, "empty problem description")
        skill_pr_set_proposal(result,
            "(no problem description supplied; usage: /skill run coding_helper DESCRIBE_YOUR_PROBLEM)")
        skill_pr_set_confidence(result, 0)
        skill_pr_set_ok(result)
        return 0
    }
    let msg = "coding_helper v1.0.0 shape ships; policy body pending.\n"
    msg = msg + "\nOnce the following land, this skill will fully activate:\n"
    msg = msg + "  * ADR-0107 (Pattern Capsules -- subtype for step-sequence capsules)\n"
    msg = msg + "  * data/packs/coding.cerec           (language + concept atoms)\n"
    msg = msg + "  * data/packs/debug_pattern.cerec    (reproduce -> isolate ->\n"
    msg = msg + "                                        hypothesize -> test ->\n"
    msg = msg + "                                        verify -> check_regressions)\n"
    msg = msg + "\nFor your problem:\n"
    msg = msg + "  \"" + problem + "\"\n"
    msg = msg + "\nthe activated policy will:\n"
    msg = msg + "  1. Walk the coding capsule for language + concept atoms whose\n"
    msg = msg + "     labels overlap the problem's tokens (via the same tokenizer\n"
    msg = msg + "     research_skill / persona_project use).\n"
    msg = msg + "  2. Walk the debug_pattern capsule in step order; for each step,\n"
    msg = msg + "     compose a sub-proposal grounded in the matched coding atoms.\n"
    msg = msg + "  3. Run the composite proposal through persona_project so you\n"
    msg = msg + "     see predicted valence / risk before approving.\n"
    msg = msg + "  4. On operator approval, dispatch effector_code_exec for any\n"
    msg = msg + "     minimal test scripts, and effector_file_ops for source I/O.\n"
    msg = msg + "     The runtime describes; approval is external.\n"
    skill_pr_add_trace(result, "policy body pending; deps not yet available")
    skill_pr_add_trace(result,
        "declared deps: coding v1.0.0, debug_pattern v1.0.0")
    skill_pr_add_trace(result,
        "declared effectors: effector_code_exec, effector_file_ops")
    // Illustrate the "described-not-executed" invariant even in the stub:
    // if we were going to run code_exec + file_ops, we would list them
    // here. For the stub we describe the SHAPE of the call.
    let ec_args = list_new()
    push(ec_args, "<language>") push(ec_args, "<minimal-test-source>")
    skill_pr_add_effector_call(result, "effector_code_exec", ec_args)
    let fo_args = list_new()
    push(fo_args, "read") push(fo_args, "<source-path>")
    skill_pr_add_effector_call(result, "effector_file_ops", fo_args)
    skill_pr_set_proposal(result, msg)
    skill_pr_set_confidence(result, 0)
    skill_pr_set_ok(result)
    return 0
}
