// CrossEngin skills: manifest shape (ADR-0103).
//
// A SkillManifest is the DECLARATIVE contract for what a skill IS --
// its name/version, the capsules it depends on, the effectors it may
// call, the refusal conditions the supervisor enforces BEFORE the
// policy runs. Combined with a policy function (dispatched by
// integer policy_id since NOVA doesn't uniformly expose first-class
// function refs), the manifest is everything the runtime needs to
// wire capsules + persona + effectors into a user-serving agent.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- capability tiers (mirror src/safety/permission_tiers.nova) -----------
let SKILL_TIER_USER      = 1
let SKILL_TIER_ELEVATED  = 2
let SKILL_TIER_ROOT      = 3

// ---- refusal condition kinds ----------------------------------------------
// Kinds enumerate the built-in refusal predicates. Each condition is a
// 2-list [kind, arg]. Semantics enforced by the supervisor BEFORE the
// policy runs (see src/skills/skill_supervisor.nova).
let COND_MIN_CONFIDENCE       = 1   // arg = int min mean belief (milli)
                                    // any answer atom with mean < arg -> refuse
let COND_KG_EMPTY             = 2   // arg = string kg_name; refuse if empty
let COND_CAPSULE_UNINSTALLED  = 3   // arg = string capsule_name; refuse if not
                                    // installed at run time
let COND_PERSONA_MISSING      = 4   // arg ignored; refuse if no persona attached

// ---- SkillManifest slot layout --------------------------------------------
let SM_NAME              = 0
let SM_VERSION           = 1
let SM_DESCRIPTION       = 2
let SM_REQUIRED_CAPSULES = 3   // list<[name, min_version]>
let SM_CAPABILITY_TIER   = 4   // SKILL_TIER_*
let SM_EFFECTORS         = 5   // list<string>
let SM_REFUSAL_CONDS     = 6   // list<[kind, arg]>
let SM_POLICY_ID         = 7   // int dispatch tag
let SM_ATTRIBUTION_PREF  = 8   // "src:skill:<name>:v<version>"
let SM_LICENSE           = 9
let SM_SLOT_COUNT        = 10

// ---- constructors ---------------------------------------------------------

// Build a fresh manifest with sensible defaults: tier=USER, no deps, no
// effectors, no refusal conditions, no policy_id yet. Caller supplies
// name/version/description/policy_id, adds deps + effectors + refusal
// conditions via the mutators below.
fn skill_manifest_new(name, version, description, policy_id) {
    let m = list_new()
    push(m, name)
    push(m, version)
    push(m, description)
    push(m, list_new())                                // REQUIRED_CAPSULES
    push(m, SKILL_TIER_USER)                          // CAPABILITY_TIER
    push(m, list_new())                                // EFFECTORS
    push(m, list_new())                                // REFUSAL_CONDS
    push(m, policy_id)
    push(m, "src:skill:" + name + ":v" + version)     // ATTRIBUTION_PREF
    push(m, "unspecified")                             // LICENSE
    return m
}

// ---- accessors ------------------------------------------------------------

fn skill_manifest_name(m)              { return m[SM_NAME] }
fn skill_manifest_version(m)           { return m[SM_VERSION] }
fn skill_manifest_description(m)       { return m[SM_DESCRIPTION] }
fn skill_manifest_required_capsules(m) { return m[SM_REQUIRED_CAPSULES] }
fn skill_manifest_capability_tier(m)   { return m[SM_CAPABILITY_TIER] }
fn skill_manifest_effectors(m)         { return m[SM_EFFECTORS] }
fn skill_manifest_refusal_conds(m)     { return m[SM_REFUSAL_CONDS] }
fn skill_manifest_policy_id(m)         { return m[SM_POLICY_ID] }
fn skill_manifest_attribution(m)       { return m[SM_ATTRIBUTION_PREF] }
fn skill_manifest_license(m)           { return m[SM_LICENSE] }

// ---- mutators (idempotent where sensible) ---------------------------------

// Add a required capsule dependency. Idempotent by capsule name (last
// version-min wins on re-add, matching the "authors update deps as
// they iterate" workflow).
fn skill_manifest_add_capsule_dep(m, capsule_name, min_version) {
    let deps = m[SM_REQUIRED_CAPSULES]
    let i = 0
    while i < len(deps) {
        if str_eq_bytes(deps[i][0], capsule_name) == 1 {
            list_set(deps[i], 1, min_version)
            return 0
        }
        i = i + 1
    }
    let d = list_new()
    push(d, capsule_name) push(d, min_version)
    push(deps, d)
    return 1
}

// Set the capability tier. Clamped to valid range.
fn skill_manifest_set_tier(m, tier) {
    let t = tier
    if t < SKILL_TIER_USER     { t = SKILL_TIER_USER }
    if t > SKILL_TIER_ROOT     { t = SKILL_TIER_ROOT }
    list_set(m, SM_CAPABILITY_TIER, t)
    return 1
}

// Add an effector name. Idempotent.
fn skill_manifest_add_effector(m, effector_name) {
    let es = m[SM_EFFECTORS]
    let i = 0
    while i < len(es) {
        if str_eq_bytes(es[i], effector_name) == 1 { return 0 }
        i = i + 1
    }
    push(es, effector_name)
    return 1
}

// Add a refusal condition. Append (multiple conditions of the same
// kind are allowed -- e.g. two COND_CAPSULE_UNINSTALLED for different
// capsules).
fn skill_manifest_add_refusal(m, kind, arg) {
    let c = list_new() push(c, kind) push(c, arg)
    push(m[SM_REFUSAL_CONDS], c)
    return 1
}

// Set license identifier ("CC-BY-4.0", "MIT", "proprietary", etc.).
fn skill_manifest_set_license(m, license) {
    list_set(m, SM_LICENSE, license)
    return 1
}

// ---- counters -------------------------------------------------------------

fn skill_manifest_dep_count(m)      { return len(m[SM_REQUIRED_CAPSULES]) }
fn skill_manifest_effector_count(m) { return len(m[SM_EFFECTORS]) }
fn skill_manifest_refusal_count(m)  { return len(m[SM_REFUSAL_CONDS]) }

// ---- refusal-condition kind names for human-readable output ---------------

fn skill_cond_kind_name(kind) {
    if kind == COND_MIN_CONFIDENCE      { return "min-confidence" }
    if kind == COND_KG_EMPTY            { return "kg-empty" }
    if kind == COND_CAPSULE_UNINSTALLED { return "capsule-uninstalled" }
    if kind == COND_PERSONA_MISSING     { return "persona-missing" }
    return "unknown"
}
