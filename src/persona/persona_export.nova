// CrossEngin persona: serialize / deserialize for portability (ADR-0102).
//
// Personas are a user's portable digital second-self. This module
// serializes a Persona to a self-describing UTF-8 string and reads it
// back into an equivalent Persona. Round-trip preserves every slot:
// identity + OCEAN + emotion + risk + full history + preferences +
// reflection + style_capsule_ref + timestamps.
//
// Wire format (line-based like .cerec, for human inspection):
//
//   #PERSONA v1
//   USER    <user_id>
//   NAME    <name>
//   PURPOSE <purpose>
//   VALUE   <one stated value>              (0..n lines)
//   OCEAN   <O> <C> <E> <A> <N>
//   EMOTION <valence> <arousal> <focus> <last_update>
//   RISK    <tolerance> <loss_aversion> <uncertainty_appetite>
//   STYLE   <style_capsule_ref_or_empty>
//   CREATED <moment>
//   UPDATED <moment>
//   DEC     <moment> <chosen> <pred_valence> <actual> <satisfaction> <src> <retracted> :: <proposal_desc>
//   PREF    <label> <weight> <src> <moment_first> <moment_last> <count>
//   REFL    <moment> <src> :: <text>
//
// The " :: " separator marks the boundary between structured fields
// and free-form text (proposal_desc / reflection_text) so free text
// can contain spaces without needing quoting. Blank lines + '#'
// comments are ignored on parse.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/persona/persona.nova, src/util/str_safe.nova.

import "./persona.nova"
import "../util/str_safe.nova"

// ---- helpers (small local versions to avoid cross-module tangling) --------

fn _pex_is_ws(c) {
    if c == 32 { return 1 }
    if c == 9  { return 1 }
    if c == 13 { return 1 }
    return 0
}

fn _pex_is_blank(line) {
    let n = len(line)
    let i = 0
    while i < n {
        if _pex_is_ws(char_at(line, i)) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn _pex_lines(text) {
    let out = list_new()
    let n = len(text)
    let start = 0
    let i = 0
    while i < n {
        if char_at(text, i) == 10 {
            push(out, substr(text, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if start < n { push(out, substr(text, start, n - start)) }
    return out
}

// Tokenize a directive line into whitespace-separated pieces. Stops at
// " :: " (which marks the free-text tail) -- returns (tokens_before_marker,
// text_after_marker_or_empty).
fn _pex_split_line(line) {
    let n = len(line)
    // Find " :: " marker.
    let marker_at = 0 - 1
    let i = 0
    while i <= n - 4 {
        if char_at(line, i) == 32 {
            if char_at(line, i + 1) == 58 {
                if char_at(line, i + 2) == 58 {
                    if char_at(line, i + 3) == 32 {
                        marker_at = i
                        i = n + 1
                    } else { i = i + 1 }
                } else { i = i + 1 }
            } else { i = i + 1 }
        } else { i = i + 1 }
    }
    let head = line
    let tail = ""
    if marker_at >= 0 {
        head = substr(line, 0, marker_at)
        tail = substr(line, marker_at + 4, n - marker_at - 4)
    }
    let toks = list_new()
    let hn = len(head)
    let s = 0 - 1
    let j = 0
    while j < hn {
        let c = char_at(head, j)
        if _pex_is_ws(c) == 1 {
            if s >= 0 { push(toks, substr(head, s, j - s)) s = 0 - 1 }
        } else {
            if s < 0 { s = j }
        }
        j = j + 1
    }
    if s >= 0 { push(toks, substr(head, s, hn - s)) }
    let out = list_new()
    push(out, toks) push(out, tail)
    return out
}

// Parse an unsigned int; -1 on failure.
fn _pex_uint(s) {
    let n = len(s)
    if n == 0 { return 0 - 1 }
    let v = 0
    let i = 0
    while i < n {
        let c = char_at(s, i)
        if c < 48 { return 0 - 1 }
        if c > 57 { return 0 - 1 }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

// Parse a signed int; -999999999 sentinel on failure.
fn _pex_sint(s) {
    let n = len(s)
    if n == 0 { return 0 - 999999999 }
    let c0 = char_at(s, 0)
    if c0 == 45 {
        let v = _pex_uint(substr(s, 1, n - 1))
        if v < 0 { return 0 - 999999999 }
        return 0 - v
    }
    if c0 == 43 {
        let v = _pex_uint(substr(s, 1, n - 1))
        if v < 0 { return 0 - 999999999 }
        return v
    }
    return _pex_uint(s)
}

// ---- serialize ------------------------------------------------------------

fn persona_export(p) {
    if p == 0 { return "" }
    let s = "#PERSONA v1\n"
    s = s + "USER " + persona_user_id(p) + "\n"
    s = s + "NAME " + persona_name(p) + "\n"
    s = s + "PURPOSE " + persona_purpose(p) + "\n"
    // Values
    let vals = persona_values(p)
    let i = 0
    while i < len(vals) {
        s = s + "VALUE " + vals[i] + "\n"
        i = i + 1
    }
    // OCEAN
    let o = persona_ocean(p)
    s = s + "OCEAN " + int_to_str(o[0]) + " " + int_to_str(o[1]) + " "
          + int_to_str(o[2]) + " " + int_to_str(o[3]) + " "
          + int_to_str(o[4]) + "\n"
    // Emotion. Focus may be empty; use " :: " separator so an empty focus
    // is unambiguous on parse (no dropped token).
    let em = persona_emotion(p)
    s = s + "EMOTION " + int_to_str(em[0]) + " " + int_to_str(em[1]) + " "
          + int_to_str(em[3]) + " :: " + em[2] + "\n"
    // Risk
    let rk = persona_risk(p)
    s = s + "RISK " + int_to_str(rk[0]) + " " + int_to_str(rk[1]) + " "
          + int_to_str(rk[2]) + "\n"
    // Style. Only emit a STYLE line when non-empty; on import an absent
    // STYLE line leaves the default empty string.
    let style = persona_style_capsule(p)
    if len(style) > 0 { s = s + "STYLE " + style + "\n" }
    s = s + "CREATED " + int_to_str(persona_created_at(p)) + "\n"
    s = s + "UPDATED " + int_to_str(persona_updated_at(p)) + "\n"
    // History
    let hist = persona_history(p)
    let h = 0
    while h < len(hist) {
        let d = hist[h]
        s = s + "DEC " + int_to_str(d[PER_DEC_MOMENT])
              + " " + d[PER_DEC_CHOSEN]
              + " " + int_to_str(d[PER_DEC_PRED_VALENCE])
              + " " + int_to_str(d[PER_DEC_ACTUAL])
              + " " + int_to_str(d[PER_DEC_SATISFACTION])
              + " " + d[PER_DEC_SOURCE]
              + " " + int_to_str(d[PER_DEC_RETRACTED])
              + " :: " + d[PER_DEC_PROPOSAL] + "\n"
        h = h + 1
    }
    // Preferences
    let prefs = persona_preferences(p)
    let q = 0
    while q < len(prefs) {
        let pr = prefs[q]
        s = s + "PREF " + pr[PER_PREF_LABEL]
              + " " + int_to_str(pr[PER_PREF_WEIGHT])
              + " " + pr[PER_PREF_SOURCE]
              + " " + int_to_str(pr[PER_PREF_MOMENT_1ST])
              + " " + int_to_str(pr[PER_PREF_MOMENT_LST])
              + " " + int_to_str(pr[PER_PREF_COUNT])
              + "\n"
        q = q + 1
    }
    // Reflection
    let refls = persona_reflection(p)
    let r = 0
    while r < len(refls) {
        let re = refls[r]
        s = s + "REFL " + int_to_str(re[PER_REFL_MOMENT])
              + " " + re[PER_REFL_SOURCE]
              + " :: " + re[PER_REFL_TEXT] + "\n"
        r = r + 1
    }
    return s
}

// ---- deserialize ----------------------------------------------------------

// Parse a serialized persona back into a live Persona. Returns 0 on empty
// or malformed input (no USER directive). Callers can validate more
// strictly by checking user_id / created_at after.
fn persona_import(text) {
    if len(text) == 0 { return 0 }
    let lines = _pex_lines(text)
    let user_id = ""
    let name = ""
    let purpose = ""
    let values = list_new()
    let ocean = list_new()
    push(ocean, 500) push(ocean, 500) push(ocean, 500) push(ocean, 500) push(ocean, 500)
    let em_v = 0
    let em_a = 300
    let em_f = ""
    let em_u = 0
    let rk_t = 500
    let rk_l = 500
    let rk_u = 500
    let style = ""
    let created = 0
    let updated = 0
    let decisions = list_new()
    let prefs = list_new()
    let refls = list_new()
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if _pex_is_blank(line) == 0 {
            if char_at(line, 0) == 35 {
                // comment / version marker
            } else {
                let parts = _pex_split_line(line)
                let toks = parts[0]
                let tail = parts[1]
                if len(toks) >= 1 {
                    let head = toks[0]
                    if str_eq_bytes(head, "USER") == 1 {
                        if len(toks) >= 2 { user_id = toks[1] }
                    }
                    else { if str_eq_bytes(head, "NAME") == 1 {
                        if len(toks) >= 2 { name = _pex_rest_after_first(line) }
                    }
                    else { if str_eq_bytes(head, "PURPOSE") == 1 {
                        purpose = _pex_rest_after_first(line)
                    }
                    else { if str_eq_bytes(head, "VALUE") == 1 {
                        push(values, _pex_rest_after_first(line))
                    }
                    else { if str_eq_bytes(head, "OCEAN") == 1 {
                        if len(toks) >= 6 {
                            list_set(ocean, 0, _pex_uint(toks[1]))
                            list_set(ocean, 1, _pex_uint(toks[2]))
                            list_set(ocean, 2, _pex_uint(toks[3]))
                            list_set(ocean, 3, _pex_uint(toks[4]))
                            list_set(ocean, 4, _pex_uint(toks[5]))
                        }
                    }
                    else { if str_eq_bytes(head, "EMOTION") == 1 {
                        // New shape (v1): EMOTION <val> <arousal> <last_update> :: <focus>
                        // Legacy 5-token shape also accepted for forward-compat.
                        if len(toks) >= 4 {
                            em_v = _pex_sint(toks[1])
                            em_a = _pex_uint(toks[2])
                            em_u = _pex_uint(toks[3])
                            em_f = tail
                        }
                        if len(toks) >= 5 {
                            // Legacy: EMOTION <val> <arousal> <focus> <last_update>
                            // toks[3] is focus, toks[4] is update. Only apply if
                            // toks[4] parses as int (heuristic: if the new-format
                            // 4-token parse produced a bogus em_u because the
                            // legacy line put focus in toks[3]).
                            let legacy_u = _pex_uint(toks[4])
                            if legacy_u >= 0 {
                                em_f = toks[3]
                                em_u = legacy_u
                            }
                        }
                    }
                    else { if str_eq_bytes(head, "RISK") == 1 {
                        if len(toks) >= 4 {
                            rk_t = _pex_uint(toks[1])
                            rk_l = _pex_uint(toks[2])
                            rk_u = _pex_uint(toks[3])
                        }
                    }
                    else { if str_eq_bytes(head, "STYLE") == 1 {
                        if len(toks) >= 2 { style = toks[1] } else { style = "" }
                    }
                    else { if str_eq_bytes(head, "CREATED") == 1 {
                        if len(toks) >= 2 { created = _pex_uint(toks[1]) }
                    }
                    else { if str_eq_bytes(head, "UPDATED") == 1 {
                        if len(toks) >= 2 { updated = _pex_uint(toks[1]) }
                    }
                    else { if str_eq_bytes(head, "DEC") == 1 {
                        // DEC <moment> <chosen> <pred_valence> <actual> <satisfaction>
                        //     <src> <retracted> :: <proposal>
                        if len(toks) >= 8 {
                            let d = list_new()
                            push(d, _pex_uint(toks[1]))          // moment
                            push(d, tail)                          // proposal_desc (tail)
                            push(d, toks[2])                       // chosen
                            push(d, _pex_sint(toks[3]))           // pred_valence
                            push(d, _pex_sint(toks[4]))           // actual
                            push(d, _pex_sint(toks[5]))           // satisfaction
                            push(d, toks[6])                       // source
                            push(d, _pex_uint(toks[7]))           // retracted
                            push(decisions, d)
                        }
                    }
                    else { if str_eq_bytes(head, "PREF") == 1 {
                        if len(toks) >= 7 {
                            let pr = list_new()
                            push(pr, toks[1])                      // label
                            push(pr, _pex_sint(toks[2]))          // weight
                            push(pr, toks[3])                      // source
                            push(pr, _pex_uint(toks[4]))          // moment_first
                            push(pr, _pex_uint(toks[5]))          // moment_last
                            push(pr, _pex_uint(toks[6]))          // count
                            push(prefs, pr)
                        }
                    }
                    else { if str_eq_bytes(head, "REFL") == 1 {
                        // REFL <moment> <src> :: <text>
                        if len(toks) >= 3 {
                            let re = list_new()
                            push(re, _pex_uint(toks[1]))
                            push(re, tail)                         // text
                            push(re, toks[2])                      // source
                            push(re, 0)                            // reserved slot -- ignored
                            // (Reflection sub-record layout is 3 slots: moment, text, source.)
                            // Trim to canonical 3-slot shape.
                            let re3 = list_new()
                            push(re3, re[0]) push(re3, re[1]) push(re3, re[2])
                            push(refls, re3)
                        }
                    }
                    // unknown directive -> ignored (forward-compat)
                    } } } } } } } } } } } }
                }
            }
        }
        i = i + 1
    }
    if len(user_id) == 0 { return 0 }
    // Build persona from parsed fields.
    let p = persona_new(user_id, name, purpose, created)
    let vi = 0
    while vi < len(values) {
        persona_add_value(p, values[vi], created)
        vi = vi + 1
    }
    persona_set_ocean(p, ocean[0], ocean[1], ocean[2], ocean[3], ocean[4])
    persona_set_emotion(p, em_v, em_a, em_f, em_u)
    persona_set_risk(p, rk_t, rk_l, rk_u, updated)
    persona_set_style_capsule(p, style, updated)
    // Splice history / prefs / reflection lists in DIRECTLY -- append via
    // the setters would re-timestamp them, losing original moments.
    list_set(p, PER_HISTORY, decisions)
    list_set(p, PER_PREFERENCES, prefs)
    list_set(p, PER_REFLECTION, refls)
    list_set(p, PER_UPDATED_AT, updated)
    // Restore created_at (persona_new + setters may have bumped it).
    list_set(p, PER_CREATED_AT, created)
    return p
}

// Return everything after the first whitespace-separated token on `line`.
// Trimmed of surrounding whitespace.
fn _pex_rest_after_first(line) {
    let n = len(line)
    let i = 0
    // skip leading ws
    let more = 1
    while more == 1 {
        if i >= n { more = 0 }
        else { if _pex_is_ws(char_at(line, i)) == 1 { i = i + 1 } else { more = 0 } }
    }
    // skip the token
    let more2 = 1
    while more2 == 1 {
        if i >= n { more2 = 0 }
        else { if _pex_is_ws(char_at(line, i)) == 1 { more2 = 0 } else { i = i + 1 } }
    }
    // skip whitespace after
    let more3 = 1
    while more3 == 1 {
        if i >= n { more3 = 0 }
        else { if _pex_is_ws(char_at(line, i)) == 1 { i = i + 1 } else { more3 = 0 } }
    }
    if i >= n { return "" }
    return substr(line, i, n - i)
}
