// CrossEngin persona -- per-user identity + emotion + risk + history
// + preferences + reflection (ADR-0102).
//
// A Persona is a first-class, per-user primitive. One per user_id (the
// registry enforces this). Portable second-self: history + preferences
// + reflection are what the agent knows about its user, source-tagged
// and retractable exactly like any belief in MSC (ADR-0100).
//
// The persona is ADVISE-ONLY. persona_project (separate module) reads
// this shape and returns a projection onto a proposed action. Nothing
// in the persona blocks or modifies the proposal -- the hard-gate layer
// (constitutional_filter, reversibility_classifier, capability_gate)
// keeps sole enforcement authority.
//
// Observation model: every completed decision appends to `history`;
// every stated preference add/updates a PrefRec; every self-reflection
// appends to `reflection`. Zero training step. Each observation is one
// shift, source-tagged, retractable (retract sets a marker in the
// record; the record stays for audit).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/util/str_safe.nova.

import "../util/str_safe.nova"

// ---- Persona slot layout --------------------------------------------------
let PER_USER_ID          = 0    // string, primary key in the registry
let PER_IDENTITY         = 1    // [name, purpose, stated_values_list]
let PER_OCEAN            = 2    // [openness, conscientiousness, extraversion,
                                //  agreeableness, neuroticism] (0..1000 milli)
let PER_EMOTION          = 3    // [valence(-1000..1000), arousal(0..1000),
                                //  dominant_focus, last_update_moment]
let PER_RISK             = 4    // [risk_tolerance, loss_aversion,
                                //  uncertainty_appetite] (0..1000 milli each)
let PER_HISTORY          = 5    // list<DecisionRec> append-only
let PER_PREFERENCES      = 6    // list<PrefRec>
let PER_REFLECTION       = 7    // list<ReflectionRec> append-only
let PER_STYLE_CAPSULE    = 8    // string; empty = no preferred style
let PER_CREATED_AT       = 9    // moment
let PER_UPDATED_AT       = 10   // moment
let PER_SLOT_COUNT       = 11

// ---- sub-record slot indices ---------------------------------------------

// Identity sub-record: [name, purpose, stated_values_list]
let PER_ID_NAME          = 0
let PER_ID_PURPOSE       = 1
let PER_ID_VALUES        = 2

// OCEAN sub-record: 5-element trait vector
let PER_OCEAN_O          = 0
let PER_OCEAN_C          = 1
let PER_OCEAN_E          = 2
let PER_OCEAN_A          = 3
let PER_OCEAN_N          = 4

// Emotion sub-record: [valence, arousal, dominant_focus, last_update]
let PER_EMO_VALENCE      = 0
let PER_EMO_AROUSAL      = 1
let PER_EMO_FOCUS        = 2
let PER_EMO_UPDATED_AT   = 3

// Risk sub-record
let PER_RISK_TOLERANCE   = 0
let PER_RISK_LOSS_AVERSN = 1
let PER_RISK_UNCERT_APP  = 2

// DecisionRec: [moment, proposal_desc, chosen_option, predicted_valence,
//               actual_outcome_or_0, satisfaction_or_0, source_tag,
//               retracted (0/1)]
let PER_DEC_MOMENT       = 0
let PER_DEC_PROPOSAL     = 1
let PER_DEC_CHOSEN       = 2
let PER_DEC_PRED_VALENCE = 3
let PER_DEC_ACTUAL       = 4
let PER_DEC_SATISFACTION = 5
let PER_DEC_SOURCE       = 6
let PER_DEC_RETRACTED    = 7

// PrefRec: [label, weight (-1000..+1000), source_tag,
//           moment_first, moment_last, observation_count]
let PER_PREF_LABEL       = 0
let PER_PREF_WEIGHT      = 1
let PER_PREF_SOURCE      = 2
let PER_PREF_MOMENT_1ST  = 3
let PER_PREF_MOMENT_LST  = 4
let PER_PREF_COUNT       = 5

// ReflectionRec: [moment, text, source_tag]
let PER_REFL_MOMENT      = 0
let PER_REFL_TEXT        = 1
let PER_REFL_SOURCE      = 2

// ---- helpers --------------------------------------------------------------

// Clamp x to [lo, hi] inclusive.
fn _per_clamp(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

// ---- constructors ---------------------------------------------------------

// New persona with sensible defaults: neutral OCEAN, neutral emotion,
// centred risk profile, empty history / prefs / reflection. Caller
// supplies user_id + display name + purpose + now(). Values list starts
// empty; add via persona_add_value.
fn persona_new(user_id, name, purpose, now) {
    let p = list_new()
    push(p, user_id)                                    // USER_ID
    // identity
    let id = list_new()
    push(id, name) push(id, purpose) push(id, list_new())
    push(p, id)                                          // IDENTITY
    // OCEAN neutral 500 across all five
    let o = list_new()
    push(o, 500) push(o, 500) push(o, 500) push(o, 500) push(o, 500)
    push(p, o)                                           // OCEAN
    // emotion neutral (valence=0, arousal=300, no focus, updated=now)
    let em = list_new()
    push(em, 0) push(em, 300) push(em, "") push(em, now)
    push(p, em)                                          // EMOTION
    // risk centred at 500 across all three dimensions
    let rk = list_new()
    push(rk, 500) push(rk, 500) push(rk, 500)
    push(p, rk)                                          // RISK
    push(p, list_new())                                  // HISTORY (empty)
    push(p, list_new())                                  // PREFERENCES
    push(p, list_new())                                  // REFLECTION
    push(p, "")                                          // STYLE_CAPSULE
    push(p, now)                                         // CREATED_AT
    push(p, now)                                         // UPDATED_AT
    return p
}

// Build from an existing soul handle (ADR-0102 migration path). Caller
// supplies the soul_name + purpose (via the soul module's accessors)
// so this module doesn't import soul directly and stay dependency-free.
fn persona_from_soul_fields(user_id, soul_name, soul_purpose,
                            ocean_o, ocean_c, ocean_e, ocean_a, ocean_n, now) {
    let p = persona_new(user_id, soul_name, soul_purpose, now)
    persona_set_ocean(p, ocean_o, ocean_c, ocean_e, ocean_a, ocean_n)
    return p
}

// ---- accessors ------------------------------------------------------------

fn persona_user_id(p)           { return p[PER_USER_ID] }
fn persona_identity(p)          { return p[PER_IDENTITY] }
fn persona_name(p)              { return p[PER_IDENTITY][PER_ID_NAME] }
fn persona_purpose(p)           { return p[PER_IDENTITY][PER_ID_PURPOSE] }
fn persona_values(p)            { return p[PER_IDENTITY][PER_ID_VALUES] }
fn persona_ocean(p)             { return p[PER_OCEAN] }
fn persona_emotion(p)           { return p[PER_EMOTION] }
fn persona_valence(p)           { return p[PER_EMOTION][PER_EMO_VALENCE] }
fn persona_arousal(p)           { return p[PER_EMOTION][PER_EMO_AROUSAL] }
fn persona_focus(p)             { return p[PER_EMOTION][PER_EMO_FOCUS] }
fn persona_risk(p)              { return p[PER_RISK] }
fn persona_risk_tolerance(p)    { return p[PER_RISK][PER_RISK_TOLERANCE] }
fn persona_history(p)           { return p[PER_HISTORY] }
fn persona_preferences(p)       { return p[PER_PREFERENCES] }
fn persona_reflection(p)        { return p[PER_REFLECTION] }
fn persona_style_capsule(p)     { return p[PER_STYLE_CAPSULE] }
fn persona_created_at(p)        { return p[PER_CREATED_AT] }
fn persona_updated_at(p)        { return p[PER_UPDATED_AT] }

fn persona_history_count(p)     { return len(p[PER_HISTORY]) }
fn persona_preferences_count(p) { return len(p[PER_PREFERENCES]) }
fn persona_reflection_count(p)  { return len(p[PER_REFLECTION]) }

// ---- identity mutators ----------------------------------------------------

fn persona_set_identity(p, name, purpose, now) {
    let id = p[PER_IDENTITY]
    list_set(id, PER_ID_NAME, name)
    list_set(id, PER_ID_PURPOSE, purpose)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// Append a stated value. Idempotent by exact string match.
fn persona_add_value(p, value, now) {
    let vals = p[PER_IDENTITY][PER_ID_VALUES]
    let i = 0
    while i < len(vals) {
        if str_eq_bytes(vals[i], value) == 1 { return 0 }
        i = i + 1
    }
    push(vals, value)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// ---- OCEAN mutator (all five at once; bounds enforced) --------------------

fn persona_set_ocean(p, o, c, e, a, n) {
    let vec = p[PER_OCEAN]
    list_set(vec, PER_OCEAN_O, _per_clamp(o, 0, 1000))
    list_set(vec, PER_OCEAN_C, _per_clamp(c, 0, 1000))
    list_set(vec, PER_OCEAN_E, _per_clamp(e, 0, 1000))
    list_set(vec, PER_OCEAN_A, _per_clamp(a, 0, 1000))
    list_set(vec, PER_OCEAN_N, _per_clamp(n, 0, 1000))
    return 1
}

// ---- emotion mutators -----------------------------------------------------

fn persona_set_emotion(p, valence, arousal, focus, now) {
    let em = p[PER_EMOTION]
    list_set(em, PER_EMO_VALENCE, _per_clamp(valence, 0 - 1000, 1000))
    list_set(em, PER_EMO_AROUSAL, _per_clamp(arousal, 0, 1000))
    list_set(em, PER_EMO_FOCUS, focus)
    list_set(em, PER_EMO_UPDATED_AT, now)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// ---- risk mutators --------------------------------------------------------

fn persona_set_risk(p, tolerance, loss_aversion, uncertainty_appetite, now) {
    let rk = p[PER_RISK]
    list_set(rk, PER_RISK_TOLERANCE, _per_clamp(tolerance, 0, 1000))
    list_set(rk, PER_RISK_LOSS_AVERSN, _per_clamp(loss_aversion, 0, 1000))
    list_set(rk, PER_RISK_UNCERT_APP, _per_clamp(uncertainty_appetite, 0, 1000))
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// ---- history (append-only decisions) --------------------------------------

// Append a decision record. Returns the record's index in history.
// actual_outcome and satisfaction default to 0 (unknown) at record time;
// caller fills them in later via persona_update_decision_outcome.
fn persona_add_decision(p, proposal_desc, chosen_option,
                        predicted_valence, source_tag, now) {
    let dec = list_new()
    push(dec, now)
    push(dec, proposal_desc)
    push(dec, chosen_option)
    push(dec, predicted_valence)
    push(dec, 0)                // actual_outcome
    push(dec, 0)                // satisfaction
    push(dec, source_tag)
    push(dec, 0)                // retracted (0 = live)
    push(p[PER_HISTORY], dec)
    list_set(p, PER_UPDATED_AT, now)
    return len(p[PER_HISTORY]) - 1
}

// Update the outcome fields on a prior decision. The record itself is
// never mutated in identity; only outcome / satisfaction fields.
fn persona_update_decision_outcome(p, dec_index, actual, satisfaction, now) {
    if dec_index < 0 { return 0 }
    if dec_index >= len(p[PER_HISTORY]) { return 0 }
    let dec = p[PER_HISTORY][dec_index]
    list_set(dec, PER_DEC_ACTUAL, actual)
    list_set(dec, PER_DEC_SATISFACTION, _per_clamp(satisfaction, 0 - 1000, 1000))
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// Retract a decision (marks it, does NOT remove it -- history is
// append-only for audit).
fn persona_retract_decision(p, dec_index, now) {
    if dec_index < 0 { return 0 }
    if dec_index >= len(p[PER_HISTORY]) { return 0 }
    list_set(p[PER_HISTORY][dec_index], PER_DEC_RETRACTED, 1)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// ---- preferences (add-or-update, not append) ------------------------------

// Add a preference or update it if a record with the same label already
// exists. Update semantics: weight is REPLACED with the new value (the
// most recent stated preference wins); moment_last + observation_count
// are bumped; moment_first + source (of first observation) preserved.
// Returns 1 if new, 2 if updated, 0 on empty label.
fn persona_add_preference(p, label, weight, source_tag, now) {
    if len(label) == 0 { return 0 }
    let w = _per_clamp(weight, 0 - 1000, 1000)
    let prefs = p[PER_PREFERENCES]
    let i = 0
    while i < len(prefs) {
        let pr = prefs[i]
        if str_eq_bytes(pr[PER_PREF_LABEL], label) == 1 {
            list_set(pr, PER_PREF_WEIGHT, w)
            list_set(pr, PER_PREF_MOMENT_LST, now)
            list_set(pr, PER_PREF_COUNT, pr[PER_PREF_COUNT] + 1)
            list_set(p, PER_UPDATED_AT, now)
            return 2
        }
        i = i + 1
    }
    let pr = list_new()
    push(pr, label)
    push(pr, w)
    push(pr, source_tag)
    push(pr, now)
    push(pr, now)
    push(pr, 1)
    push(prefs, pr)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// Look up a preference record by exact label match. Returns 0 if absent.
fn persona_find_preference(p, label) {
    let prefs = p[PER_PREFERENCES]
    let i = 0
    while i < len(prefs) {
        if str_eq_bytes(prefs[i][PER_PREF_LABEL], label) == 1 { return prefs[i] }
        i = i + 1
    }
    return 0
}

// ---- reflection (append-only) ---------------------------------------------

// Append a reflection record. Reflections are pure append -- retract
// support (if ever needed) will mirror the decision-retract marker.
fn persona_add_reflection(p, text, source_tag, now) {
    if len(text) == 0 { return 0 }
    let r = list_new()
    push(r, now) push(r, text) push(r, source_tag)
    push(p[PER_REFLECTION], r)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// ---- style capsule reference ----------------------------------------------

// Point the persona at a style capsule (by name; see ADR-0108). Empty
// string clears the reference.
fn persona_set_style_capsule(p, capsule_name, now) {
    list_set(p, PER_STYLE_CAPSULE, capsule_name)
    list_set(p, PER_UPDATED_AT, now)
    return 1
}

// R109 (ADR-0210 tier 2): shallow-clone a persona. Used by agent.run to
// bind an agent-scoped STYLE_PIN without mutating the caller's stored
// persona. The clone shares the sub-record lists (identity/ocean/
// emotion/risk/history/preferences/reflection) BY REFERENCE, so it is
// NOT safe to mutate any sub-list on the clone (mutations would leak
// back). Callers only overwrite the top-level PER_STYLE_CAPSULE slot,
// which is the whole point of the clone.
fn persona_clone(p) {
    if p == 0 { return 0 }
    let c = list_new()
    push(c, p[PER_USER_ID])
    push(c, p[PER_IDENTITY])
    push(c, p[PER_OCEAN])
    push(c, p[PER_EMOTION])
    push(c, p[PER_RISK])
    push(c, p[PER_HISTORY])
    push(c, p[PER_PREFERENCES])
    push(c, p[PER_REFLECTION])
    push(c, p[PER_STYLE_CAPSULE])
    push(c, p[PER_CREATED_AT])
    push(c, p[PER_UPDATED_AT])
    return c
}
