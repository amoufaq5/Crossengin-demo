// CrossEngin persona: per-host registry keyed on user_id (ADR-0102).
//
// One-per-user invariant. A host (single process, or multi-tenant
// daemon) can hold N personas -- one per unique user_id -- and each
// Session references its persona by user_id. Duplicate registration
// under the same user_id is rejected.
//
// Registry mirrors the CapsuleRegistry shape (ADR-0106) for
// consistency: register / lookup / remove / list / count / users.
// No install/uninstall lifecycle -- personas are always active for
// their user; presence in the registry IS the activation.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/persona/persona.nova, src/util/str_safe.nova.

import "./persona.nova"
import "../util/str_safe.nova"

// ---- registry slot layout -------------------------------------------------
let PREG_PERSONAS = 0    // list<Persona>

// ---- constructor + basic queries ------------------------------------------

fn persona_registry_new() {
    let r = list_new()
    push(r, list_new())        // PERSONAS
    return r
}

fn persona_registry_count(reg)    { return len(reg[PREG_PERSONAS]) }
fn persona_registry_personas(reg) { return reg[PREG_PERSONAS] }

// Look up a persona by user_id. Returns the Persona or 0.
fn persona_registry_lookup(reg, user_id) {
    let personas = reg[PREG_PERSONAS]
    let i = 0
    while i < len(personas) {
        if str_eq_bytes(persona_user_id(personas[i]), user_id) == 1 {
            return personas[i]
        }
        i = i + 1
    }
    return 0
}

// True if there is a persona registered for `user_id`.
fn persona_registry_has(reg, user_id) {
    if persona_registry_lookup(reg, user_id) != 0 { return 1 }
    return 0
}

// ---- register (idempotent by user_id) -------------------------------------

// Insert a persona under its own user_id. Returns 1 on insert; 0 if a
// persona for that user_id already exists (one-per-user invariant).
fn persona_registry_register(reg, persona) {
    let uid = persona_user_id(persona)
    if persona_registry_has(reg, uid) == 1 { return 0 }
    push(reg[PREG_PERSONAS], persona)
    return 1
}

// Convenience: register or return an existing persona for user_id.
// If absent, builds a fresh default persona (persona_new) with
// display_name = user_id and empty purpose, then registers it.
fn persona_registry_ensure(reg, user_id, now) {
    let existing = persona_registry_lookup(reg, user_id)
    if existing != 0 { return existing }
    let p = persona_new(user_id, user_id, "", now)
    push(reg[PREG_PERSONAS], p)
    return p
}

// ---- remove (metadata gone -- user's persona forgotten) -------------------

// Remove a persona from the registry entirely. Returns 1 on removed, 0
// on not-found. The persona list value itself is not zeroed -- callers
// holding a reference can still read from it (defensive).
fn persona_registry_remove(reg, user_id) {
    let personas = reg[PREG_PERSONAS]
    let idx = 0 - 1
    let i = 0
    while i < len(personas) {
        if str_eq_bytes(persona_user_id(personas[i]), user_id) == 1 {
            idx = i
            i = len(personas)
        }
        i = i + 1
    }
    if idx < 0 { return 0 }
    let kept = list_new()
    let j = 0
    while j < len(personas) {
        if j != idx { push(kept, personas[j]) }
        j = j + 1
    }
    list_set(reg, PREG_PERSONAS, kept)
    return 1
}

// ---- listing --------------------------------------------------------------

// Return the list of user_id strings currently registered.
fn persona_registry_user_ids(reg) {
    let out = list_new()
    let personas = reg[PREG_PERSONAS]
    let i = 0
    while i < len(personas) {
        push(out, persona_user_id(personas[i]))
        i = i + 1
    }
    return out
}
