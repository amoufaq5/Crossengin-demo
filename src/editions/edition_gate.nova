// CrossEngin editions: the tiered-edition capability gate.
//
// Purpose
//   ADR-0091 ships ONE shared cognitive core (ADR-0001 substrate + ADR-0089
//   debate engine + belief/provenance) as THREE editions -- Edge, Enterprise,
//   Research -- that differ only in *configuration*: which KG partitions load,
//   which loops run, and which introspection surfaces are exposed. This module
//   is the pure decision layer of that idea: a static capability matrix saying
//   which edition-gated feature is permitted in which edition. No I/O, no global
//   state, no LLM -- just the policy the build manifest must honor.
//
//   It does NOT do the distillation, the tenant isolation, or the consensus
//   itself; it answers the single question "is capability C available in
//   edition E?" so callers (manifest verifier, loop scheduler, surface gate)
//   can fail closed against a single source of truth.
//
// ADRs implemented: ADR-0091 (tiered editions / capability scoping). Grounded
//   in ADR-0087 (clean vs. quarantine -> domain breadth), ADR-0047 (Enterprise
//   multi-tenant), NOVA-0008 (Enterprise scale-out/federation), ADR-0092 (Edge
//   research-loop gating), ADR-0089/0043/0023 (Research introspection ->
//   proof/trace export), ADR-0093 (Research benchmark harness).
// NOVA dependencies: builtins only. CrossEngin dependencies: none.
//
// NOVA note: edition and capability codes are small ints (< 0x100000), so the
//   `==` operator is safe against them (no large-value dereference). All
//   comparisons here are on such small literals.

// ---- Edition codes -------------------------------------------------------
let ED_EDGE = 0        // distilled, offline, constrained-hardware native process
let ED_ENTERPRISE = 1  // full reasoning, multi-tenant cloud, scale-out
let ED_RESEARCH = 2    // full introspection / benchmark harness for the team

fn ed_name(e) {
    if e == ED_EDGE { return "Edge" }
    if e == ED_ENTERPRISE { return "Enterprise" }
    if e == ED_RESEARCH { return "Research" }
    return "unknown"
}

// ---- Capability codes (edition-gated features) ---------------------------
// These are the features ADR-0091 scopes differently per edition. Each is a
// small int so `== code` is dereference-safe.
let EDC_CORE_REASONING = 0      // ADR-0001 substrate + ADR-0089 debate engine
let EDC_AUDIT_LOG = 1           // ADR-0043 decision log (the trustworthy core)
let EDC_FULL_DOMAIN_BREADTH = 2 // full clean KB vs. Edge's distilled snapshot
let EDC_MULTI_TENANT = 3        // ADR-0047 one-tenant-per-process isolation
let EDC_FEDERATION = 4          // NOVA-0007/0008 scale-out / consensus
let EDC_AUTONOMOUS_RESEARCH = 5 // ADR-0092 outbound self-update / research loop
let EDC_PROOF_EXPORT = 6        // ADR-0089/0023 argument-graph + belief export
let EDC_BENCH_HARNESS = 7       // ADR-0093 experiment / LLM-benchmark harness

// Total number of defined capabilities (used for rendering / iteration).
fn edc_count() { return 8 }

fn edition_capability_name(c) {
    if c == EDC_CORE_REASONING { return "core reasoning" }
    if c == EDC_AUDIT_LOG { return "audit log" }
    if c == EDC_FULL_DOMAIN_BREADTH { return "full domain breadth" }
    if c == EDC_MULTI_TENANT { return "multi-tenant isolation" }
    if c == EDC_FEDERATION { return "federation / scale-out" }
    if c == EDC_AUTONOMOUS_RESEARCH { return "autonomous research" }
    if c == EDC_PROOF_EXPORT { return "proof / trace export" }
    if c == EDC_BENCH_HARNESS { return "benchmark harness" }
    return "unknown capability"
}

// ---- The capability matrix ----------------------------------------------
// edition_allows(edition, capability) -> 1 if permitted, else 0. Fails closed:
// an unknown capability (or unknown edition) returns 0.
//
// Rationale, one line per row (tied to ADR-0091):
//   CORE_REASONING      : all -- the single shared core ships in every edition.
//   AUDIT_LOG           : all -- ADR-0043 audit is part of the trustworthy core.
//   FULL_DOMAIN_BREADTH : Enterprise+Research -- Edge ships a distilled,
//                         commercially-clean snapshot (ADR-0087), not the full KB.
//   MULTI_TENANT        : Enterprise only -- ADR-0047 isolation; Edge is single
//                         process, Research is explicitly NOT multi-tenant.
//   FEDERATION          : Enterprise only -- NOVA-0007/0008 scale-out is the
//                         Enterprise scaling axis; Edge is single-process,
//                         Research is single-node.
//   AUTONOMOUS_RESEARCH : Enterprise+Research -- the ADR-0092 outbound loop is
//                         gated/off on Edge (offline, frozen brain).
//   PROOF_EXPORT        : Research only -- ADR-0089/0023 internals are exposed
//                         for Research; Edge/Enterprise deliberately hide them.
//   BENCH_HARNESS       : Research only -- ADR-0093 experiment harness ships in
//                         Research alone.
fn edition_allows(edition, capability) {
    // Shared trustworthy core: available in EVERY edition.
    if capability == EDC_CORE_REASONING { return 1 }
    if capability == EDC_AUDIT_LOG { return 1 }

    if capability == EDC_FULL_DOMAIN_BREADTH {
        if edition == ED_EDGE { return 0 }
        if edition == ED_ENTERPRISE { return 1 }
        if edition == ED_RESEARCH { return 1 }
        return 0
    }
    if capability == EDC_MULTI_TENANT {
        if edition == ED_ENTERPRISE { return 1 }
        return 0
    }
    if capability == EDC_FEDERATION {
        if edition == ED_ENTERPRISE { return 1 }
        return 0
    }
    if capability == EDC_AUTONOMOUS_RESEARCH {
        if edition == ED_ENTERPRISE { return 1 }
        if edition == ED_RESEARCH { return 1 }
        return 0
    }
    if capability == EDC_PROOF_EXPORT {
        if edition == ED_RESEARCH { return 1 }
        return 0
    }
    if capability == EDC_BENCH_HARNESS {
        if edition == ED_RESEARCH { return 1 }
        return 0
    }
    // Unknown capability -> fail closed.
    return 0
}

// Count of capabilities allowed in an edition (handy for "superset" checks).
fn edition_capability_count(edition) {
    let n = edc_count()
    let c = 0
    let i = 0
    while i < n {
        if edition_allows(edition, i) == 1 { c = c + 1 }
        i = i + 1
    }
    return c
}

// ---- Plain-language render (no LLM, ADR-0038-style introspection) --------
// Lists the edition's allowed capabilities. Always non-empty: every edition
// has at least the shared core.
fn edition_render(edition) {
    let s = ed_name(edition) + ": "
    let n = edc_count()
    let i = 0
    let first = 1
    while i < n {
        if edition_allows(edition, i) == 1 {
            if first == 1 {
                s = s + edition_capability_name(i)
                first = 0
            } else {
                s = s + ", " + edition_capability_name(i)
            }
        }
        i = i + 1
    }
    return s
}
