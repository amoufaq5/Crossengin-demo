// CrossEngin Phase 1 pt1: inline y/N approval prompt.
//
// Purpose
//   Blocking stdin prompt for CG_REQUIRE_APPROVAL decisions. One extra
//   read_line() on top of the chat REPL's existing input loop — no new
//   state machine. The caller gets back AP_YES / AP_NO / AP_WHY /
//   AP_HALT and decides what to do; this module stays pure stdio.
//
//   "why" is a one-shot: on the first why, print a one-line rationale
//   derived from the cap/reversibility labels and re-prompt. A second
//   why (or any non-y/n token) resolves as AP_NO.
//
// NOVA dependencies: builtins (print, println, read_line, str_trim,
//   str_eq_bytes, len).
// CrossEngin dependencies:
//   src/safety/capability_gate.nova (cg_capability_name),
//   src/safety/reversibility_classifier.nova (rev_class_name,
//     reversibility_class, act_name).

import "std/io"
import "std/string"
import "std/syscall"
import "./capability_gate.nova"
import "./reversibility_classifier.nova"
import "../util/str_safe.nova"

let AP_YES  = 1
let AP_NO   = 0
let AP_WHY  = 2
let AP_HALT = 0 - 1

fn ap_name(code) {
    if code == AP_YES  { return "yes" }
    if code == AP_NO   { return "no" }
    if code == AP_WHY  { return "why" }
    if code == AP_HALT { return "halt" }
    return "unknown"
}

fn _ap_classify(line) {
    let t = str_trim(line)
    if len(t) == 0 { return AP_NO }
    if str_eq_bytes(t, "y") == 1 { return AP_YES }
    if str_eq_bytes(t, "Y") == 1 { return AP_YES }
    if str_eq_bytes(t, "yes") == 1 { return AP_YES }
    if str_eq_bytes(t, "YES") == 1 { return AP_YES }
    if str_eq_bytes(t, "Yes") == 1 { return AP_YES }
    if str_eq_bytes(t, "n") == 1 { return AP_NO }
    if str_eq_bytes(t, "N") == 1 { return AP_NO }
    if str_eq_bytes(t, "no") == 1 { return AP_NO }
    if str_eq_bytes(t, "NO") == 1 { return AP_NO }
    if str_eq_bytes(t, "No") == 1 { return AP_NO }
    if str_eq_bytes(t, "why") == 1 { return AP_WHY }
    if str_eq_bytes(t, "Why") == 1 { return AP_WHY }
    if str_eq_bytes(t, "?") == 1 { return AP_WHY }
    return AP_NO
}

// Return the one-line rationale printed when the user types `why`.
// Caller supplies the capability code and action-class code (ACT_* from
// reversibility_classifier.nova) so the rationale cites both.
fn ap_rationale(cap, action_type) {
    let rev = reversibility_class(action_type)
    return "requires approval: " + cg_capability_name(cap)
         + " (" + rev_class_name(rev) + " " + act_name(action_type) + ")"
}

// Inline prompt. Prints the question, reads one line via read_line.
// On a `why` token, prints the rationale and re-prompts exactly once.
// Returns AP_YES / AP_NO / AP_HALT (AP_WHY is resolved internally).
fn prompt_approve(cap, action_type, action_label, action_detail) {
    let q = "agent> would like to " + action_label
    if len(action_detail) > 0 { q = q + ": " + action_detail }
    q = q + ". approve? [y/N/why]"
    println(q)
    let line = read_line()
    if len(line) == 0 { return AP_HALT }
    let d = _ap_classify(line)
    if d == AP_WHY {
        println("agent> " + ap_rationale(cap, action_type))
        println("agent> approve? [y/N]")
        let line2 = read_line()
        if len(line2) == 0 { return AP_HALT }
        let d2 = _ap_classify(line2)
        if d2 == AP_YES { return AP_YES }
        return AP_NO
    }
    return d
}
