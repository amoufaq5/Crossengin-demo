// CrossEngin safety: the SecAgg v4 mask generator (seed -> uint32 vector).
//
// Purpose
//   In SecAgg v4 (Bonawitz et al. 2017 double masking, plan item A2) every
//   soul hides its update vector x_u under two kinds of mask:
//     y_u = x_u + PRG(b_u) + sum_{v > u} PRG(s_uv) - sum_{v < u} PRG(s_uv)
//   all mod 2^32, where b_u is a fresh self-mask seed and s_uv a pairwise
//   seed agreed with soul v. This module is that PRG plus the mod-2^32
//   vector arithmetic. It replaces v3n-sa's one-SHA-256-per-element masks
//   (_sa_mask32 in src/learning/secure_aggregation.nova, left unchanged).
//
// Construction
//   ChaCha20 (RFC 8439, src/safety/chacha20.nova) keyed with the 32-byte
//   seed, a fixed all-zero 96-bit nonce and the block counter starting at 0.
//   Output word i is little-endian keystream word (i mod 16) of block
//   floor(i / 16), i.e. bytes 4i..4i+3 of the keystream. The seed must be
//   uniformly random and used for one purpose only: SecAgg derives it from
//   HKDF with the round, the pair and the purpose in the info string
//   (src/learning/sa_crypto.nova), or draws it fresh per round (b_u).
//   A fixed nonce is safe under that rule because no key is ever reused.
//   The 32-bit block counter limits a vector to 2^32 blocks; this module
//   caps it far lower, at SAPRG_MAX_WORDS.
//
// Public API
//   saprg_expand(seed_buf, n)   -> list of n uint32 values; an empty list
//                                  for n <= 0; 0 when n > SAPRG_MAX_WORDS
//                                  or seed_buf is 0.
//   saprg_vec_add(a, b)         -> (a + b) mod 2^32 elementwise; 0 if the
//                                  lengths differ or either input is 0.
//   saprg_vec_sub(a, b)         -> (a - b) mod 2^32 elementwise; 0 if the
//                                  lengths differ or either input is 0.
//   saprg_mask(x, seed_buf, sign)
//       -> x + PRG(seed) (sign >= 0) or x - PRG(seed) (sign < 0), mod 2^32.
//          0 when x is 0 or on any error from saprg_expand.
//
// Arithmetic: every value stays in [0, 2^32) after int_and(.., 0xFFFFFFFF),
// which is exact for negative intermediates too (two's complement). No
// multiplications, so no overflow.
//
// Test parity: tests/unit/test_saprg.nova (RFC 8439 A.1 #1 and Python
// reference vectors P1-P4).
//
// NOVA dependencies: builtins.
// CrossEngin dependencies: src/safety/chacha20.nova.

import "./chacha20.nova"

let SAPRG_MASK32 = 4294967295      // 0xFFFFFFFF
let SAPRG_MAX_WORDS = 16777216     // 2^24 words = 64 MiB of keystream

fn _saprg_le32(buf, off) {
    let v = load8(buf + off)
    v = int_or(v, int_shl(load8(buf + off + 1), 8))
    v = int_or(v, int_shl(load8(buf + off + 2), 16))
    v = int_or(v, int_shl(load8(buf + off + 3), 24))
    return int_and(v, 4294967295)
}

fn saprg_expand(seed_buf, n) {
    if seed_buf == 0 { return 0 }
    if n > 16777216 { return 0 }
    let out = list_new()
    if n <= 0 { return out }
    let nonce = alloc(13)
    let z = 0
    while z < 13 {
        store8(nonce + z, 0)
        z = z + 1
    }
    let ctr = 0
    let done = 0
    while done < n {
        let blk = chacha20_block_buf(seed_buf, nonce, ctr)
        let w = 0
        while w < 16 {
            if done < n {
                push(out, _saprg_le32(blk, int_shl(w, 2)))
                done = done + 1
            }
            w = w + 1
        }
        // Wipe the keystream block: it is mask material.
        let k = 0
        while k < 64 {
            store8(blk + k, 0)
            k = k + 1
        }
        ctr = ctr + 1
    }
    return out
}

fn saprg_vec_add(a, b) {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    let n = len(a)
    if len(b) != n { return 0 }
    let out = list_new()
    let i = 0
    while i < n {
        push(out, int_and(int_add(a[i], b[i]), 4294967295))
        i = i + 1
    }
    return out
}

fn saprg_vec_sub(a, b) {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    let n = len(a)
    if len(b) != n { return 0 }
    let out = list_new()
    let i = 0
    while i < n {
        push(out, int_and(int_sub(a[i], b[i]), 4294967295))
        i = i + 1
    }
    return out
}

fn saprg_mask(x, seed_buf, sign) {
    if x == 0 { return 0 }
    let m = saprg_expand(seed_buf, len(x))
    if m == 0 { return 0 }
    if sign < 0 { return saprg_vec_sub(x, m) }
    return saprg_vec_add(x, m)
}
