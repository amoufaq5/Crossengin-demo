// CrossEngin safety: arithmetic in GF(2^8) for Shamir secret sharing.
//
// Purpose
//   The field that src/safety/shamir.nova computes in. It is the AES field:
//   bytes are polynomials over GF(2) reduced modulo x^8 + x^4 + x^3 + x + 1
//   (0x11B). Addition is XOR. SecAgg v4 (Bonawitz et al. 2017 double
//   masking, plan item A2) splits 32-byte seeds byte by byte in this field.
//
// Side channels (best effort, as in field25519 / ed25519)
//   Share bytes and secret bytes are secret, so nothing here branches on a
//   value or indexes a table with one:
//   - gf256_mul runs a fixed 8 rounds of shift-and-xor. The two conditional
//     steps of the textbook version (add a when the low bit of b is set;
//     reduce when the high bit of a is set) use masks built as
//     int_and(int_sub(0, bit), 255), which is 0 or 255.
//   - gf256_inv is a^254 by a fixed chain of 7 squarings and 6
//     multiplications. It needs no log/exp tables, and inv(0) = 0 falls out
//     of the formula with no special case.
//   - Only int_* builtins are used on secret data; they compile to inline
//     instructions with no branches. NOVA gives no constant-time guarantee
//     beyond that (no barriers, no volatile), so this is best effort.
//
// Public API (inputs are reduced to their low 8 bits first)
//   gf256_add(a, b)  -> a XOR b
//   gf256_mul(a, b)  -> a * b mod 0x11B
//   gf256_sq(a)      -> a * a
//   gf256_inv(a)     -> a^254 (the inverse for a != 0; 0 for a = 0)
//   gf256_div(a, b)  -> a * inv(b) (0 when b = 0; callers must reject b = 0)
//
// Test parity: tests/unit/test_gf256.nova checks FIPS-197 examples and whole
// tables against an independent Python reference (carry-less multiply, then
// reduce).
//
// NOVA dependencies: builtins only.
// CrossEngin dependencies: none.

// The reduction constant: x^8 = x^4 + x^3 + x + 1, i.e. 0x1B.
let GF256_REDUCE = 27     // 0x1B
let GF256_BYTE = 255      // 0xFF

fn gf256_add(a, b) {
    return int_and(int_xor(a, b), 255)
}

// Russian-peasant multiply with masks instead of branches. Every round:
//   r ^= a & mask(low bit of b)
//   a  = (a << 1) & 0xFF ^ (0x1B & mask(high bit of a))
//   b >>= 1
fn gf256_mul(a, b) {
    let x = int_and(a, 255)
    let y = int_and(b, 255)
    let r = 0
    let i = 0
    while i < 8 {
        let m = int_and(int_sub(0, int_and(y, 1)), 255)
        r = int_xor(r, int_and(x, m))
        let hm = int_and(int_sub(0, int_and(int_shr(x, 7), 1)), 255)
        x = int_xor(int_and(int_shl(x, 1), 255), int_and(27, hm))
        y = int_shr(y, 1)
        i = i + 1
    }
    return r
}

fn gf256_sq(a) {
    return gf256_mul(a, a)
}

// a^254 = a^-1 for a != 0 (the multiplicative group has order 255).
// Chain: a2 a3 a6 a7 a14 a15 a30 a31 a62 a63 a126 a127 a254.
fn gf256_inv(a) {
    let x = int_and(a, 255)
    let t = gf256_sq(x)          // a^2
    t = gf256_mul(t, x)          // a^3
    t = gf256_sq(t)              // a^6
    t = gf256_mul(t, x)          // a^7
    t = gf256_sq(t)              // a^14
    t = gf256_mul(t, x)          // a^15
    t = gf256_sq(t)              // a^30
    t = gf256_mul(t, x)          // a^31
    t = gf256_sq(t)              // a^62
    t = gf256_mul(t, x)          // a^63
    t = gf256_sq(t)              // a^126
    t = gf256_mul(t, x)          // a^127
    t = gf256_sq(t)              // a^254
    return t
}

fn gf256_div(a, b) {
    return gf256_mul(a, gf256_inv(b))
}
