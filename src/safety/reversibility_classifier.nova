// CrossEngin safety: reversibility classifier.
//
// Purpose
//   Classifies an action's reversibility (ADR-0042) into one of three classes,
//   defaulting any unlisted action type to the safest (irreversible). The class
//   sets a permission floor (applied in permission_tiers): irreversible actions
//   are forced to require approval, recoverable to notify, reversible to none.
//
//   This module also defines the shared action-class constants used by the
//   permission tiers and the safety gate (it is the lowest layer of the safety
//   stack, so the constants live here to avoid a cycle).
//
// ADRs implemented: ADR-0042 (reversibility classifier). NOVA dependencies:
//   builtins. CrossEngin dependencies: none.

// ---- action classes (ADR-0041; shared across the safety stack) ------------
let ACT_READ_LOCAL  = 1
let ACT_WRITE_LOCAL = 2
let ACT_NET_FETCH   = 3
let ACT_SEND_MSG    = 4
let ACT_DELETE      = 5
let ACT_HARD_DELETE = 6
let ACT_SPEND       = 7
let ACT_SELF_MODIFY = 8
let ACT_SPEAK       = 9
let ACT_RECALL      = 10

fn act_name(a) {
    if a == ACT_READ_LOCAL  { return "read_local" }
    if a == ACT_WRITE_LOCAL { return "write_local" }
    if a == ACT_NET_FETCH   { return "net_fetch" }
    if a == ACT_SEND_MSG    { return "send_msg" }
    if a == ACT_DELETE      { return "delete" }
    if a == ACT_HARD_DELETE { return "hard_delete" }
    if a == ACT_SPEND       { return "spend" }
    if a == ACT_SELF_MODIFY { return "self_modify" }
    if a == ACT_SPEAK       { return "speak" }
    if a == ACT_RECALL      { return "recall" }
    return "unknown"
}

// ---- reversibility classes (ADR-0042) -------------------------------------
let REV_REVERSIBLE   = 1   // clean programmatic undo exists
let REV_RECOVERABLE  = 2   // undo possible but lossy/delayed
let REV_IRREVERSIBLE = 3   // no undo

fn rev_class_name(c) {
    if c == REV_REVERSIBLE   { return "reversible" }
    if c == REV_RECOVERABLE  { return "recoverable" }
    if c == REV_IRREVERSIBLE { return "irreversible" }
    return "unknown"
}

// Classify an action type. Unlisted types default to IRREVERSIBLE (fail-safe).
fn reversibility_class(action_type) {
    if action_type == ACT_READ_LOCAL  { return REV_REVERSIBLE }
    if action_type == ACT_NET_FETCH   { return REV_REVERSIBLE }
    if action_type == ACT_RECALL      { return REV_REVERSIBLE }
    if action_type == ACT_WRITE_LOCAL { return REV_RECOVERABLE }
    if action_type == ACT_DELETE      { return REV_RECOVERABLE }
    if action_type == ACT_SPEAK       { return REV_RECOVERABLE }
    if action_type == ACT_SEND_MSG    { return REV_IRREVERSIBLE }
    if action_type == ACT_HARD_DELETE { return REV_IRREVERSIBLE }
    if action_type == ACT_SPEND       { return REV_IRREVERSIBLE }
    if action_type == ACT_SELF_MODIFY { return REV_IRREVERSIBLE }
    return REV_IRREVERSIBLE
}

fn is_irreversible(action_type) {
    if reversibility_class(action_type) == REV_IRREVERSIBLE { return 1 }
    return 0
}
