// CrossEngin safety: pure-NOVA minimal X.509 v3 certificate parser.
//
// Purpose
//   The DTLS 1.2 record-layer + handshake skeleton in
//   `src/federation/dtls12.nova` (R29B) leaves `dtls_cert_verify_R29B2_STUB`
//   as the last unfilled cryptographic stub. The cipher suite negotiated
//   by R29B is ECDHE-ECDSA-AES128-GCM-SHA256 (0xC02B): the server-side
//   half of the DTLS handshake presents an X.509 certificate carrying
//   its long-term ECDSA-P-256 public key, the client verifies the
//   certificate's signature, then uses the embedded public key as the
//   peer's ECDSA verification key for the ServerKeyExchange signature
//   (the ephemeral ECDHE public key).
//
//   This module provides the MINIMAL parser the cert-verify path needs:
//   the v3 Certificate structure per RFC 5280 §4.1 with a single
//   supported signature algorithm (`ecdsa-with-SHA256`, OID
//   1.2.840.10045.4.3.2) and a single supported subject public-key
//   algorithm (`id-ecPublicKey` over `prime256v1`, OIDs
//   1.2.840.10045.2.1 + 1.2.840.10045.3.1.7). RSA, Ed25519, certificate
//   chains, extensions parsing (Subject Key Identifier etc.), and CRL/
//   OCSP revocation are all OUT OF SCOPE -- documented as future-work
//   in this module's caveats.
//
//   R32C ships the FOUNDATION (this module + `src/safety/ecdsa.nova`).
//   R32C.2 (future round) wires both into `dtls12.nova` to retire the
//   `dtls_cert_verify_R29B2_STUB` slot. R32C does NOT touch
//   `dtls12.nova` -- parallel-agent ownership rule.
//
// RFC 5280 Certificate structure (§4.1)
//   Certificate ::= SEQUENCE {
//       tbsCertificate       TBSCertificate,
//       signatureAlgorithm   AlgorithmIdentifier,
//       signatureValue       BIT STRING
//   }
//   TBSCertificate ::= SEQUENCE {
//       version              [0] EXPLICIT Version DEFAULT v1,    -- v3 = INTEGER 2
//       serialNumber         CertificateSerialNumber,            -- INTEGER
//       signature            AlgorithmIdentifier,
//       issuer               Name,                               -- SEQUENCE OF RDN
//       validity             Validity,
//       subject              Name,
//       subjectPublicKeyInfo SubjectPublicKeyInfo,
//       issuerUniqueID       [1] IMPLICIT BIT STRING OPTIONAL,
//       subjectUniqueID      [2] IMPLICIT BIT STRING OPTIONAL,
//       extensions           [3] EXPLICIT Extensions OPTIONAL    -- v3 only
//   }
//   AlgorithmIdentifier ::= SEQUENCE {
//       algorithm  OBJECT IDENTIFIER,
//       parameters ANY DEFINED BY algorithm OPTIONAL
//   }
//   Validity ::= SEQUENCE { notBefore Time, notAfter Time }
//   Time ::= CHOICE { utcTime UTCTime, generalTime GeneralizedTime }
//   SubjectPublicKeyInfo ::= SEQUENCE {
//       algorithm        AlgorithmIdentifier,
//       subjectPublicKey BIT STRING                              -- SEC1 point
//   }
//   For ecdsa-with-SHA256, the signatureValue BIT STRING wraps the
//   ECDSA-Sig-Value SEQUENCE { r INTEGER, s INTEGER } (RFC 5480 §2.1).
//
// ASN.1 DER (X.690) primitives shipped here
//   * Identifier octet decoder: extract class, primitive/constructed
//     bit, tag number. We only support tags 1..30 in the universal
//     class; "long form" tag encodings (multi-byte tag identifiers)
//     are reported as errors -- not needed for any X.509 field.
//   * Definite-length decoder: short form (single byte, len < 128)
//     OR long form (first byte 0x81/0x82/0x83/0x84 followed by 1..4
//     length bytes, big-endian). Indefinite length (0x80 with
//     end-of-contents marker) is BER, NOT DER -- we reject it.
//     This is RFC 5280 §4.1 prerequisite: certs MUST be DER.
//   * INTEGER: signed two's-complement big-endian; we hold the value
//     as a bn256 for unsigned big-integers (sufficient for serial
//     numbers + ECDSA r, s -- both bounded by 256 bits). A leading
//     0x00 padding byte is silently stripped (the canonical encoding
//     for unsigned values whose top bit is set).
//   * OBJECT IDENTIFIER: parsed into a NOVA list of numeric
//     components, then re-encoded into the dotted string for
//     comparison against the well-known OID constants.
//   * UTCTime: "YYMMDDHHMMSSZ" (RFC 5280 §4.1.2.5: years 50..99 ->
//     1950..1999; 00..49 -> 2000..2049). Parsed into a Unix timestamp.
//   * GeneralizedTime: "YYYYMMDDHHMMSSZ". Parsed into a Unix timestamp.
//   * SEQUENCE / SET: open-the-envelope wrappers; we never need
//     SET-canonicalization-aware parsing -- the inner items are read
//     in encoded order.
//   * BIT STRING: leading byte is the number of unused bits in the
//     final byte; for SEC1 keys + ECDSA signatures the unused count is
//     always 0 (we enforce this since both have byte-aligned content).
//   * BOOLEAN: single content byte (0x00 = false, anything else =
//     true per X.690 §11.1; for DER strictly 0x00 / 0xFF).
//   * OCTET STRING: pass-through.
//
// Field reach
//   For each parsed certificate we extract:
//     * serialNumber as a bn256 (uniquely identifies the cert within
//       the issuer's namespace; not used for signature verification but
//       exported so callers can log it).
//     * signatureAlgorithm OID (must be ecdsa-with-SHA256).
//     * issuer CN (the first CN found in the issuer DN; if no CN, the
//       empty string -- we never reject on missing CN since RFC 5280
//       only requires the DN to be non-empty).
//     * not_before and not_after as Unix timestamps.
//     * subject CN (same convention as issuer).
//     * subjectPublicKeyInfo: must be id-ecPublicKey over prime256v1,
//       with the inner BIT STRING decoding to a 65-byte SEC1
//       uncompressed point.
//     * signatureValue: the ECDSA-Sig-Value SEQUENCE { r, s } unwrapped
//       to bn256 r and s.
//     * tbsCertificate bytes: the BYTE-EXACT slice (including the
//       outer SEQUENCE header) so the signature can be verified by
//       hashing this slice and feeding through `ecdsa_p256_verify_bn`.
//
// Error codes
//   X509_ERR_BAD_TAG          unexpected ASN.1 tag at a slot
//   X509_ERR_BAD_LENGTH       indefinite length / overlong / truncated
//   X509_ERR_BAD_OID          unsupported algorithm OID
//   X509_ERR_BAD_TIME         malformed UTCTime / GeneralizedTime
//   X509_ERR_BAD_BITSTRING    BIT STRING with non-zero unused bits
//   X509_ERR_BAD_KEY          subjectPublicKey not a 65-byte SEC1
//                             uncompressed P-256 point
//   X509_ERR_BAD_SIG          signatureValue not a valid ECDSA-Sig-Value
//   X509_ERR_EXPIRED          current time > not_after
//   X509_ERR_NOT_YET_VALID    current time < not_before
//   X509_ERR_TRUNCATED        cert buffer ran out mid-field
//
// Out-of-scope (documented for future hardening rounds)
//   * Extension parsing -- only the Subject Public Key Info is used.
//     Basic Constraints / Key Usage / SAN are skipped. R32C.3 lands
//     extension parsing if/when a use case demands it.
//   * Certificate chain validation. R32C produces a single self-
//     standing parse + verify. R29B's `dtls_cert_verify_R29B2_STUB`
//     accepts a single peer cert (the R32C.2 wiring); chain support
//     awaits a CA store design.
//   * RSA, Ed25519, Ed448 keys. The cipher suite R29B negotiates is
//     ECDHE-ECDSA-* so the cert MUST carry a P-256 ECDSA key; other
//     algorithms can be added when the suite list expands.
//   * Certificate revocation (CRL, OCSP, OCSP-stapling). Same rationale.
//   * Subject Alternative Name (SAN) hostname matching. The CN-only
//     extraction matches the WebRTC profile's reliance on the
//     fingerprint match in the SDP; a future round can add SAN.
//   * Time-zone-aware comparison; we treat all times as UTC (RFC 5280
//     §4.1.2.5 mandates the trailing 'Z').
//
// Public API
//   x509_parse(der_buf, der_n)
//                                  -> parsed cert handle (a NOVA list with
//                                     positional slots, see X509_C_* below),
//                                     OR a negative X509_ERR_* code.
//   x509_check_validity(cert, current_unix_seconds)
//                                  -> 0 if valid at the given time,
//                                     X509_ERR_NOT_YET_VALID or
//                                     X509_ERR_EXPIRED otherwise.
//   x509_signature_alg_oid(cert)   -> the dotted OID string.
//   x509_subject_cn(cert)          -> the subject CN string (may be "").
//   x509_issuer_cn(cert)           -> the issuer CN string.
//   x509_public_key_buf(cert)      -> the 65-byte uncompressed P-256 point
//                                     buffer (can be fed directly into
//                                     ecdsa_p256_verify).
//   x509_public_key_len(cert)      -> 65.
//   x509_signature_r(cert)         -> bn256 r.
//   x509_signature_s(cert)         -> bn256 s.
//   x509_tbs_buf(cert)             -> raw pointer to the tbsCertificate
//                                     bytes (caller MUST NOT free; lifetime
//                                     bound to the cert buffer).
//   x509_tbs_len(cert)             -> integer byte count of the
//                                     tbsCertificate slice.
//   x509_not_before(cert)          -> Unix seconds.
//   x509_not_after(cert)           -> Unix seconds.
//   x509_serial_bn(cert)           -> bn256 serial number.
//   x509_signature_alg_oid_value() -> the canonical
//                                     "1.2.840.10045.4.3.2" OID dotted
//                                     string for ecdsa-with-SHA256
//                                     (exported for callers that want to
//                                     do their own comparison).
//
// ADRs touched: FEDERATED_AUDIT.md (R32C cert-verify foundation,
//   prepares R29B's dtls_cert_verify_R29B2_STUB for R32C.2 wiring).
// NOVA dependencies: builtins (alloc, store8, load8, len, push, list_new,
//   list_set, int_*, str_eq, chr, str_add, char_at).
// CrossEngin dependencies:
//   * src/safety/ecdsa.nova -- ECDSA-P-256 verify + SHA-256 (this module
//     does not call them, but exports tbs + r + s so callers can chain
//     into ecdsa_p256_verify_bn).
//   * Transitively via ecdsa.nova: src/safety/p256.nova,
//     src/safety/bignum_256.nova.

import "../safety/ecdsa.nova"
import "../util/str_safe.nova"

// ============================================================================
//                          Error codes
// ============================================================================
//
// All negative; callers check `if result < 0` to detect failure. The
// `0` sentinel is reserved for "ok" (parse handle is a list, so the
// non-zero check naturally separates ok-list from err-int).

let X509_ERR_BAD_TAG       = -1
let X509_ERR_BAD_LENGTH    = -2
let X509_ERR_BAD_OID       = -3
let X509_ERR_BAD_TIME      = -4
let X509_ERR_BAD_BITSTRING = -5
let X509_ERR_BAD_KEY       = -6
let X509_ERR_BAD_SIG       = -7
let X509_ERR_EXPIRED       = -8
let X509_ERR_NOT_YET_VALID = -9
let X509_ERR_TRUNCATED     = -10

// ============================================================================
//                          Cert handle layout
// ============================================================================
//
// The parse result is a NOVA list with fixed positional slots so callers
// can access fields by index without a hash map.

let X509_C_SLOT_SERIAL_BN       = 0
let X509_C_SLOT_SIG_OID         = 1
let X509_C_SLOT_ISSUER_CN       = 2
let X509_C_SLOT_NOT_BEFORE      = 3
let X509_C_SLOT_NOT_AFTER       = 4
let X509_C_SLOT_SUBJECT_CN      = 5
let X509_C_SLOT_PUB_KEY_BUF     = 6
let X509_C_SLOT_PUB_KEY_LEN     = 7
let X509_C_SLOT_SIG_R_BN        = 8
let X509_C_SLOT_SIG_S_BN        = 9
let X509_C_SLOT_TBS_BUF         = 10
let X509_C_SLOT_TBS_LEN         = 11
let X509_C_SLOT_COUNT           = 12

// ============================================================================
//                          ASN.1 DER tag constants
// ============================================================================

let X509_TAG_BOOLEAN          = 1
let X509_TAG_INTEGER          = 2
let X509_TAG_BIT_STRING       = 3
let X509_TAG_OCTET_STRING     = 4
let X509_TAG_NULL             = 5
let X509_TAG_OBJECT_ID        = 6
let X509_TAG_UTF8_STRING      = 12
let X509_TAG_PRINTABLE_STRING = 19
let X509_TAG_TELETEX_STRING   = 20
let X509_TAG_IA5_STRING       = 22
let X509_TAG_UTC_TIME         = 23
let X509_TAG_GENERALIZED_TIME = 24
let X509_TAG_SEQUENCE         = 48
let X509_TAG_SET              = 49

// Context-specific [0] EXPLICIT wrapper for the TBS version field. The
// X.690 identifier octet is 0xA0 = class=10 (context-specific),
// primitive/constructed=1 (constructed), tag=0.
let X509_TAG_CTX0_EXPLICIT    = 160

// Well-known OIDs (RFC 5480 + RFC 5280 + RFC 6090).
let X509_OID_ECDSA_WITH_SHA256 = "1.2.840.10045.4.3.2"
let X509_OID_EC_PUBLIC_KEY     = "1.2.840.10045.2.1"
let X509_OID_PRIME256V1        = "1.2.840.10045.3.1.7"
let X509_OID_COMMON_NAME       = "2.5.4.3"

fn x509_signature_alg_oid_value() {
    return X509_OID_ECDSA_WITH_SHA256
}

// ============================================================================
//                          ASN.1 DER primitives
// ============================================================================
//
// A "parse position" is an integer offset into the certificate buffer.
// Each helper takes (buf, pos, end_pos) where end_pos is one PAST the
// last valid byte (so the helper can detect truncation). Returns a
// 2-element list [next_pos, value] on success, or a negative error code
// on failure.

// Read the identifier octet at `pos`. Returns [next_pos, tag_byte] or
// X509_ERR_BAD_TAG / X509_ERR_TRUNCATED.
fn _x509_read_tag(buf, pos, end_pos) {
    if pos >= end_pos { return X509_ERR_TRUNCATED }
    let tag = load8(buf + pos)
    // Long-form tag identifiers (low 5 bits == 0x1F) are not used in
    // any X.509 field; reject defensively.
    if int_and(tag, 31) == 31 { return X509_ERR_BAD_TAG }
    let r = list_new()
    push(r, pos + 1)
    push(r, tag)
    return r
}

// Read a DER definite-length encoding at `pos`. Returns
// [next_pos, length] on success.
//
// Short form (single byte, top bit clear): the byte IS the length.
// Long form (first byte top bit set, low 7 bits = number-of-length-bytes
// 1..4): the next N bytes are the big-endian length.
// Indefinite-length (0x80) is BER, NOT DER; we reject it.
fn _x509_read_length(buf, pos, end_pos) {
    if pos >= end_pos { return X509_ERR_TRUNCATED }
    let b0 = load8(buf + pos)
    if int_and(b0, 128) == 0 {
        // Short form.
        let r = list_new()
        push(r, pos + 1)
        push(r, b0)
        return r
    }
    if b0 == 128 {
        // Indefinite length -- BER, not DER.
        return X509_ERR_BAD_LENGTH
    }
    let n_bytes = int_and(b0, 127)
    if n_bytes > 4 { return X509_ERR_BAD_LENGTH }
    if pos + 1 + n_bytes > end_pos { return X509_ERR_TRUNCATED }
    let len_val = 0
    let i = 0
    while i < n_bytes {
        len_val = int_or(int_shl(len_val, 8), load8(buf + pos + 1 + i))
        i = i + 1
    }
    let r = list_new()
    push(r, pos + 1 + n_bytes)
    push(r, len_val)
    return r
}

// Read tag + length and return [content_pos, content_end] where
// content_end = content_pos + length.
fn _x509_read_tlv(buf, pos, end_pos) {
    let t = _x509_read_tag(buf, pos, end_pos)
    if t < 0 { return t }
    let l = _x509_read_length(buf, t[0], end_pos)
    if l < 0 { return l }
    let content_pos = l[0]
    let content_end = l[0] + l[1]
    if content_end > end_pos { return X509_ERR_TRUNCATED }
    let r = list_new()
    push(r, t[1])              // tag
    push(r, content_pos)
    push(r, content_end)
    return r
}

// Read a TLV and assert its tag matches `expected_tag`. Returns
// [content_pos, content_end] or an error code.
fn _x509_expect_tag(buf, pos, end_pos, expected_tag) {
    let tlv = _x509_read_tlv(buf, pos, end_pos)
    if tlv < 0 { return tlv }
    if tlv[0] != expected_tag { return X509_ERR_BAD_TAG }
    let r = list_new()
    push(r, tlv[1])
    push(r, tlv[2])
    return r
}

// Read a DER INTEGER as a bn256. Handles the leading-0x00 padding for
// unsigned values whose top bit is set. Returns [next_pos, bn256].
fn _x509_read_integer_bn(buf, pos, end_pos) {
    let r = _x509_expect_tag(buf, pos, end_pos, X509_TAG_INTEGER)
    if r < 0 { return r }
    let content_pos = r[0]
    let content_end = r[1]
    let raw_len = content_end - content_pos
    // Strip a single leading 0x00 byte if present (canonical
    // representation of an unsigned big-int whose MSB is set).
    let start = content_pos
    if raw_len > 1 {
        if load8(buf + content_pos) == 0 {
            start = content_pos + 1
        }
    }
    let used = content_end - start
    if used > 32 { return X509_ERR_BAD_LENGTH }
    // Build a bn256: layout is little-endian limbs, value is big-endian.
    // Pad on the left with zeros into a fresh 32-byte buffer, then call
    // _p256_bytes_to_bn (which p256.nova re-exports under that helper).
    let scratch = alloc(33)
    let i = 0
    while i < 32 { store8(scratch + i, 0); i = i + 1 }
    store8(scratch + 32, 0)
    let pad = 32 - used
    let j = 0
    while j < used {
        store8(scratch + pad + j, load8(buf + start + j))
        j = j + 1
    }
    let bn = _p256_bytes_to_bn(scratch, 0)
    let out = list_new()
    push(out, content_end)
    push(out, bn)
    return out
}

// Read a DER OBJECT IDENTIFIER and return [next_pos, oid_string].
// X.690 §8.19 OID encoding:
//   * First subidentifier encodes the first TWO arc values:
//       v = 40 * arc0 + arc1
//   * Each subsequent subidentifier is a base-128 big-endian
//     variable-length unsigned int. The top bit of each byte is the
//     continuation flag (1 = more bytes follow, 0 = last byte).
fn _x509_read_oid(buf, pos, end_pos) {
    let r = _x509_expect_tag(buf, pos, end_pos, X509_TAG_OBJECT_ID)
    if r < 0 { return r }
    let content_pos = r[0]
    let content_end = r[1]
    if content_pos >= content_end { return X509_ERR_BAD_OID }
    // Single-pass decode: accumulate each subidentifier into `acc` until
    // the high bit of the current byte is 0 (= terminator). Emit the
    // string components as we go. The very first emitted subid splits
    // into (arc0, arc1) per X.690 §8.19.4.
    let s = ""
    let acc = 0
    let first_emitted = 0
    let i = content_pos
    while i < content_end {
        let b = load8(buf + i)
        acc = int_or(int_shl(acc, 7), int_and(b, 127))
        if int_and(b, 128) == 0 {
            if first_emitted == 0 {
                let arc0 = 0
                let arc1 = acc
                if acc >= 40 {
                    if acc < 80 {
                        arc0 = 1
                        arc1 = acc - 40
                    } else {
                        arc0 = 2
                        arc1 = acc - 80
                    }
                }
                s = int_to_str(arc0) + "." + int_to_str(arc1)
                first_emitted = 1
            } else {
                s = s + "." + int_to_str(acc)
            }
            acc = 0
        }
        i = i + 1
    }
    if first_emitted == 0 { return X509_ERR_BAD_OID }
    let out = list_new()
    push(out, content_end)
    push(out, s)
    return out
}

// Read a DER BIT STRING. Returns [next_pos, content_start, content_n]
// where content_start..content_start+content_n is the payload AFTER the
// leading "unused bits" byte (which must be 0 for byte-aligned content).
fn _x509_read_bit_string(buf, pos, end_pos) {
    let r = _x509_expect_tag(buf, pos, end_pos, X509_TAG_BIT_STRING)
    if r < 0 { return r }
    let content_pos = r[0]
    let content_end = r[1]
    if content_pos >= content_end { return X509_ERR_BAD_BITSTRING }
    let unused = load8(buf + content_pos)
    if unused != 0 { return X509_ERR_BAD_BITSTRING }
    let out = list_new()
    push(out, content_end)
    push(out, content_pos + 1)
    push(out, content_end - content_pos - 1)
    return out
}

// Read a DER OCTET STRING. Returns [next_pos, content_pos, content_n].
fn _x509_read_octet_string(buf, pos, end_pos) {
    let r = _x509_expect_tag(buf, pos, end_pos, X509_TAG_OCTET_STRING)
    if r < 0 { return r }
    let out = list_new()
    push(out, r[1])             // next_pos = content_end
    push(out, r[0])             // content_pos
    push(out, r[1] - r[0])      // content_n
    return out
}

// Read a DER BOOLEAN. Returns [next_pos, 0 or 1].
fn _x509_read_boolean(buf, pos, end_pos) {
    let r = _x509_expect_tag(buf, pos, end_pos, X509_TAG_BOOLEAN)
    if r < 0 { return r }
    if r[1] - r[0] != 1 { return X509_ERR_BAD_LENGTH }
    let b = load8(buf + r[0])
    let v = 0
    if b != 0 { v = 1 }
    let out = list_new()
    push(out, r[1])
    push(out, v)
    return out
}

// Skip over an unknown TLV. Returns next_pos.
fn _x509_skip_tlv(buf, pos, end_pos) {
    let tlv = _x509_read_tlv(buf, pos, end_pos)
    if tlv < 0 { return tlv }
    return tlv[2]
}

// ============================================================================
//                          Time parsing (UTCTime + GeneralizedTime)
// ============================================================================
//
// UTCTime payload: 12-byte string "YYMMDDHHMMSSZ" (RFC 5280 §4.1.2.5).
//   Year 50..99 -> 1950..1999; 00..49 -> 2000..2049.
// GeneralizedTime payload: "YYYYMMDDHHMMSSZ" (15 bytes).
// Both encode UTC ('Z' suffix required by RFC 5280).
//
// Output: Unix seconds since 1970-01-01 00:00:00 UTC. We compute this
// via the Howard Hinnant formula for days_from_civil:
//   y' = y - (m <= 2)
//   era = (y' >= 0 ? y' : y' - 399) / 400
//   yoe = y' - era * 400
//   doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1
//   doe = yoe * 365 + yoe/4 - yoe/100 + doy
//   days = era * 146097 + doe - 719468
// Then unix = days * 86400 + hh * 3600 + mm * 60 + ss.
// This is the same shape used by every "days since epoch" library and
// is integer-only (no float).

// Parse two ASCII digits at buf[off..off+1]. Returns the integer 0..99,
// or X509_ERR_BAD_TIME on non-digit.
fn _x509_two_digits(buf, off) {
    let d0 = load8(buf + off)
    let d1 = load8(buf + off + 1)
    if d0 < 48 { return X509_ERR_BAD_TIME }
    if d0 > 57 { return X509_ERR_BAD_TIME }
    if d1 < 48 { return X509_ERR_BAD_TIME }
    if d1 > 57 { return X509_ERR_BAD_TIME }
    return (d0 - 48) * 10 + (d1 - 48)
}

fn _x509_four_digits(buf, off) {
    let hi = _x509_two_digits(buf, off)
    if hi < 0 { return hi }
    let lo = _x509_two_digits(buf, off + 2)
    if lo < 0 { return lo }
    return hi * 100 + lo
}

// Howard Hinnant's days_from_civil formula. Returns days since
// 1970-01-01.
fn _x509_days_from_civil(y, m, d) {
    let yp = y
    if m <= 2 { yp = y - 1 }
    let era = 0
    if yp >= 0 {
        era = int_div(yp, 400)
    } else {
        era = int_div(yp - 399, 400)
    }
    let yoe = yp - era * 400
    let m_shift = m
    if m > 2 {
        m_shift = m - 3
    } else {
        m_shift = m + 9
    }
    let doy = int_div(153 * m_shift + 2, 5) + d - 1
    let doe = yoe * 365 + int_div(yoe, 4) - int_div(yoe, 100) + doy
    return era * 146097 + doe - 719468
}

// Parse the 6 numeric "MMDDHHMMSS" fields after a 2-digit-or-4-digit
// year. Returns [month, day, hour, minute, second] or X509_ERR_BAD_TIME.
fn _x509_parse_time_tail(buf, off) {
    let mm = _x509_two_digits(buf, off)
    if mm < 0 { return mm }
    let dd = _x509_two_digits(buf, off + 2)
    if dd < 0 { return dd }
    let hh = _x509_two_digits(buf, off + 4)
    if hh < 0 { return hh }
    let mi = _x509_two_digits(buf, off + 6)
    if mi < 0 { return mi }
    let ss = _x509_two_digits(buf, off + 8)
    if ss < 0 { return ss }
    let r = list_new()
    push(r, mm)
    push(r, dd)
    push(r, hh)
    push(r, mi)
    push(r, ss)
    return r
}

// Read a UTCTime or GeneralizedTime TLV and return [next_pos, unix_sec]
// on success. Both must end in 'Z' (UTC).
fn _x509_read_time(buf, pos, end_pos) {
    let tlv = _x509_read_tlv(buf, pos, end_pos)
    if tlv < 0 { return tlv }
    let tag = tlv[0]
    let cs = tlv[1]
    let ce = tlv[2]
    let n = ce - cs
    let year = 0
    let body_off = 0
    if tag == X509_TAG_UTC_TIME {
        if n != 13 { return X509_ERR_BAD_TIME }
        if load8(buf + ce - 1) != 90 { return X509_ERR_BAD_TIME }
        let yy = _x509_two_digits(buf, cs)
        if yy < 0 { return yy }
        if yy >= 50 {
            year = 1900 + yy
        } else {
            year = 2000 + yy
        }
        body_off = cs + 2
    } else {
        if tag != X509_TAG_GENERALIZED_TIME { return X509_ERR_BAD_TAG }
        if n != 15 { return X509_ERR_BAD_TIME }
        if load8(buf + ce - 1) != 90 { return X509_ERR_BAD_TIME }
        year = _x509_four_digits(buf, cs)
        if year < 0 { return year }
        body_off = cs + 4
    }
    let tail = _x509_parse_time_tail(buf, body_off)
    if tail < 0 { return tail }
    let month  = tail[0]
    let day    = tail[1]
    let hour   = tail[2]
    let minute = tail[3]
    let second = tail[4]
    // Defensive range checks.
    if month < 1  { return X509_ERR_BAD_TIME }
    if month > 12 { return X509_ERR_BAD_TIME }
    if day   < 1  { return X509_ERR_BAD_TIME }
    if day   > 31 { return X509_ERR_BAD_TIME }
    if hour  > 23 { return X509_ERR_BAD_TIME }
    if minute > 59 { return X509_ERR_BAD_TIME }
    if second > 60 { return X509_ERR_BAD_TIME }
    let days = _x509_days_from_civil(year, month, day)
    let secs = days * 86400 + hour * 3600 + minute * 60 + second
    let r = list_new()
    push(r, ce)
    push(r, secs)
    return r
}

// ============================================================================
//                          DN -> CN extraction
// ============================================================================
//
// Name ::= SEQUENCE OF RelativeDistinguishedName
// RDN  ::= SET OF AttributeTypeAndValue
// ATV  ::= SEQUENCE { type OID, value ANY }
//
// We walk the SEQUENCE OF; for each RDN we walk the SET OF; for each
// ATV we read the OID; if it equals "2.5.4.3" (commonName), we return
// the string value. If no CN found, return "".

fn _x509_extract_cn_from_dn(buf, dn_pos, dn_end) {
    let pos = dn_pos
    while pos < dn_end {
        // Each element is an RDN (SET OF).
        let rdn = _x509_expect_tag(buf, pos, dn_end, X509_TAG_SET)
        if rdn < 0 { return "" }
        let rdn_pos = rdn[0]
        let rdn_end = rdn[1]
        while rdn_pos < rdn_end {
            let atv = _x509_expect_tag(buf, rdn_pos, rdn_end,
                                       X509_TAG_SEQUENCE)
            if atv < 0 { return "" }
            let atv_pos = atv[0]
            let atv_end = atv[1]
            let oid_r = _x509_read_oid(buf, atv_pos, atv_end)
            if oid_r < 0 { return "" }
            let after_oid = oid_r[0]
            let oid_str = oid_r[1]
            if str_eq_bytes(oid_str, X509_OID_COMMON_NAME) == 1 {
                // Read the string value. It's a CHOICE among UTF8String,
                // PrintableString, TeletexString, IA5String. We accept
                // any tag and copy bytes through as the CN string.
                let val_tlv = _x509_read_tlv(buf, after_oid, atv_end)
                if val_tlv < 0 { return "" }
                let vp = val_tlv[1]
                let ve = val_tlv[2]
                let s = ""
                let i = vp
                while i < ve {
                    s = s + chr(load8(buf + i))
                    i = i + 1
                }
                return s
            }
            rdn_pos = atv_end
        }
        pos = rdn_end
    }
    return ""
}

// ============================================================================
//                          Public-key + signature unwrap
// ============================================================================
//
// SubjectPublicKeyInfo ::= SEQUENCE {
//     algorithm AlgorithmIdentifier,   -- {id-ecPublicKey, prime256v1}
//     subjectPublicKey BIT STRING      -- 04 || X(32B) || Y(32B)
// }
// Returns [pub_buf, pub_len] (a 65-byte alloc'd buffer copy + length 65)
// or a negative error code.

fn _x509_parse_subject_pubkey(buf, pki_pos, pki_end) {
    // Read the algorithm SEQUENCE.
    let alg = _x509_expect_tag(buf, pki_pos, pki_end, X509_TAG_SEQUENCE)
    if alg < 0 { return alg }
    let alg_pos = alg[0]
    let alg_end = alg[1]
    let alg_oid = _x509_read_oid(buf, alg_pos, alg_end)
    if alg_oid < 0 { return alg_oid }
    if str_eq_bytes(alg_oid[1], X509_OID_EC_PUBLIC_KEY) == 0 {
        return X509_ERR_BAD_OID
    }
    let param_oid = _x509_read_oid(buf, alg_oid[0], alg_end)
    if param_oid < 0 { return param_oid }
    if str_eq_bytes(param_oid[1], X509_OID_PRIME256V1) == 0 {
        return X509_ERR_BAD_OID
    }
    // Now the BIT STRING.
    let bs = _x509_read_bit_string(buf, alg_end, pki_end)
    if bs < 0 { return bs }
    let content_pos = bs[1]
    let content_n = bs[2]
    if content_n != 65 { return X509_ERR_BAD_KEY }
    if load8(buf + content_pos) != 4 { return X509_ERR_BAD_KEY }
    // Copy the 65 bytes out to a fresh buffer so the caller can outlive
    // the cert buffer.
    let out = alloc(66)
    let i = 0
    while i < 65 {
        store8(out + i, load8(buf + content_pos + i))
        i = i + 1
    }
    store8(out + 65, 0)
    let r = list_new()
    push(r, out)
    push(r, 65)
    return r
}

// Unwrap the signatureValue BIT STRING -> ECDSA-Sig-Value SEQUENCE.
// Returns [r_bn, s_bn] or a negative error code.
fn _x509_parse_signature_value(buf, sig_pos, sig_end) {
    let bs = _x509_read_bit_string(buf, sig_pos, sig_end)
    if bs < 0 { return bs }
    let inner_pos = bs[1]
    let inner_end = bs[1] + bs[2]
    let seq = _x509_expect_tag(buf, inner_pos, inner_end, X509_TAG_SEQUENCE)
    if seq < 0 { return X509_ERR_BAD_SIG }
    let sp = seq[0]
    let se = seq[1]
    let r_pair = _x509_read_integer_bn(buf, sp, se)
    if r_pair < 0 { return X509_ERR_BAD_SIG }
    let s_pair = _x509_read_integer_bn(buf, r_pair[0], se)
    if s_pair < 0 { return X509_ERR_BAD_SIG }
    let out = list_new()
    push(out, r_pair[1])
    push(out, s_pair[1])
    return out
}

// ============================================================================
//                          Top-level parser
// ============================================================================

// Parse a single DER-encoded X.509 v3 certificate. Returns a cert
// handle (NOVA list of X509_C_SLOT_COUNT positional slots) or a
// negative X509_ERR_* code.
fn x509_parse(der_buf, der_n) {
    if der_n < 4 { return X509_ERR_TRUNCATED }
    // Outer SEQUENCE.
    let outer = _x509_expect_tag(der_buf, 0, der_n, X509_TAG_SEQUENCE)
    if outer < 0 { return outer }
    let outer_pos = outer[0]
    let outer_end = outer[1]
    // tbsCertificate inner SEQUENCE -- record its byte span (header + content)
    // for the signature-verify hash.
    let tbs_header_pos = outer_pos
    let tbs = _x509_expect_tag(der_buf, outer_pos, outer_end, X509_TAG_SEQUENCE)
    if tbs < 0 { return tbs }
    let tbs_content_pos = tbs[0]
    let tbs_content_end = tbs[1]
    let tbs_len_bytes = tbs_content_end - tbs_header_pos
    // -- Walk the TBS fields --
    let pos = tbs_content_pos
    // version: [0] EXPLICIT INTEGER (defaulting to v1 if absent).
    // For v3 certs (RFC 5280 §4.1) the version IS present and equals 2.
    let version = 0
    let probe_tag = load8(der_buf + pos)
    if probe_tag == X509_TAG_CTX0_EXPLICIT {
        let cv = _x509_expect_tag(der_buf, pos, tbs_content_end,
                                  X509_TAG_CTX0_EXPLICIT)
        if cv < 0 { return cv }
        let ver_pair = _x509_read_integer_bn(der_buf, cv[0], cv[1])
        if ver_pair < 0 { return ver_pair }
        // We don't enforce ver == 2 here -- v1 + v2 certs parse fine if
        // they happen to omit the extensions block. Stash the value in
        // case a future hardening round wants it.
        version = ver_pair[1]
        pos = cv[1]
    }
    // serialNumber.
    let serial = _x509_read_integer_bn(der_buf, pos, tbs_content_end)
    if serial < 0 { return serial }
    pos = serial[0]
    let serial_bn = serial[1]
    // signature AlgorithmIdentifier (the inner copy; must match outer).
    let sig_alg = _x509_expect_tag(der_buf, pos, tbs_content_end,
                                   X509_TAG_SEQUENCE)
    if sig_alg < 0 { return sig_alg }
    let sig_alg_oid = _x509_read_oid(der_buf, sig_alg[0], sig_alg[1])
    if sig_alg_oid < 0 { return sig_alg_oid }
    if str_eq_bytes(sig_alg_oid[1], X509_OID_ECDSA_WITH_SHA256) == 0 {
        return X509_ERR_BAD_OID
    }
    pos = sig_alg[1]
    // issuer Name SEQUENCE.
    let issuer = _x509_expect_tag(der_buf, pos, tbs_content_end,
                                  X509_TAG_SEQUENCE)
    if issuer < 0 { return issuer }
    let issuer_cn = _x509_extract_cn_from_dn(der_buf, issuer[0], issuer[1])
    pos = issuer[1]
    // validity SEQUENCE { notBefore Time, notAfter Time }.
    let validity = _x509_expect_tag(der_buf, pos, tbs_content_end,
                                    X509_TAG_SEQUENCE)
    if validity < 0 { return validity }
    let nb_pair = _x509_read_time(der_buf, validity[0], validity[1])
    if nb_pair < 0 { return nb_pair }
    let na_pair = _x509_read_time(der_buf, nb_pair[0], validity[1])
    if na_pair < 0 { return na_pair }
    let not_before = nb_pair[1]
    let not_after = na_pair[1]
    pos = validity[1]
    // subject Name SEQUENCE.
    let subject = _x509_expect_tag(der_buf, pos, tbs_content_end,
                                   X509_TAG_SEQUENCE)
    if subject < 0 { return subject }
    let subject_cn = _x509_extract_cn_from_dn(der_buf, subject[0], subject[1])
    pos = subject[1]
    // subjectPublicKeyInfo SEQUENCE.
    let pki = _x509_expect_tag(der_buf, pos, tbs_content_end,
                               X509_TAG_SEQUENCE)
    if pki < 0 { return pki }
    let pub_pair = _x509_parse_subject_pubkey(der_buf, pki[0], pki[1])
    if pub_pair < 0 { return pub_pair }
    pos = pki[1]
    // -- Remainder of TBS is OPTIONAL UniqueIDs + Extensions. We skip
    //    them; the signature is computed over the ENTIRE tbs SEQUENCE
    //    (header + all contents), which we already captured.
    // -- After TBS, outer envelope has signatureAlgorithm + signatureValue.
    let outer_after_tbs = tbs_content_end
    let sig_alg2 = _x509_expect_tag(der_buf, outer_after_tbs, outer_end,
                                    X509_TAG_SEQUENCE)
    if sig_alg2 < 0 { return sig_alg2 }
    let sig_alg2_oid = _x509_read_oid(der_buf, sig_alg2[0], sig_alg2[1])
    if sig_alg2_oid < 0 { return sig_alg2_oid }
    if str_eq_bytes(sig_alg2_oid[1], X509_OID_ECDSA_WITH_SHA256) == 0 {
        return X509_ERR_BAD_OID
    }
    // signatureValue BIT STRING -> ECDSA-Sig-Value SEQUENCE.
    let rs = _x509_parse_signature_value(der_buf, sig_alg2[1], outer_end)
    if rs < 0 { return rs }
    // Build the cert handle.
    let cert = list_new()
    let i = 0
    while i < X509_C_SLOT_COUNT { push(cert, 0); i = i + 1 }
    list_set(cert, X509_C_SLOT_SERIAL_BN,   serial_bn)
    list_set(cert, X509_C_SLOT_SIG_OID,     X509_OID_ECDSA_WITH_SHA256)
    list_set(cert, X509_C_SLOT_ISSUER_CN,   issuer_cn)
    list_set(cert, X509_C_SLOT_NOT_BEFORE,  not_before)
    list_set(cert, X509_C_SLOT_NOT_AFTER,   not_after)
    list_set(cert, X509_C_SLOT_SUBJECT_CN,  subject_cn)
    list_set(cert, X509_C_SLOT_PUB_KEY_BUF, pub_pair[0])
    list_set(cert, X509_C_SLOT_PUB_KEY_LEN, pub_pair[1])
    list_set(cert, X509_C_SLOT_SIG_R_BN,    rs[0])
    list_set(cert, X509_C_SLOT_SIG_S_BN,    rs[1])
    list_set(cert, X509_C_SLOT_TBS_BUF,     der_buf + tbs_header_pos)
    list_set(cert, X509_C_SLOT_TBS_LEN,     tbs_len_bytes)
    return cert
}

// Return 0 if the cert is valid at `current_unix_seconds`, else
// X509_ERR_NOT_YET_VALID or X509_ERR_EXPIRED.
fn x509_check_validity(cert, current_unix_seconds) {
    let nb = cert[X509_C_SLOT_NOT_BEFORE]
    let na = cert[X509_C_SLOT_NOT_AFTER]
    if current_unix_seconds < nb { return X509_ERR_NOT_YET_VALID }
    if current_unix_seconds > na { return X509_ERR_EXPIRED }
    return 0
}

// ============================================================================
//                          Accessors
// ============================================================================
//
// Mirror the slot-based access pattern p256.nova / aes_gcm.nova use:
// callers should ALWAYS go through these functions rather than
// indexing the list directly so the slot layout can evolve.

fn x509_serial_bn(cert)        { return cert[X509_C_SLOT_SERIAL_BN] }
fn x509_signature_alg_oid(cert){ return cert[X509_C_SLOT_SIG_OID] }
fn x509_issuer_cn(cert)        { return cert[X509_C_SLOT_ISSUER_CN] }
fn x509_subject_cn(cert)       { return cert[X509_C_SLOT_SUBJECT_CN] }
fn x509_not_before(cert)       { return cert[X509_C_SLOT_NOT_BEFORE] }
fn x509_not_after(cert)        { return cert[X509_C_SLOT_NOT_AFTER] }
fn x509_public_key_buf(cert)   { return cert[X509_C_SLOT_PUB_KEY_BUF] }
fn x509_public_key_len(cert)   { return cert[X509_C_SLOT_PUB_KEY_LEN] }
fn x509_signature_r(cert)      { return cert[X509_C_SLOT_SIG_R_BN] }
fn x509_signature_s(cert)      { return cert[X509_C_SLOT_SIG_S_BN] }
fn x509_tbs_buf(cert)          { return cert[X509_C_SLOT_TBS_BUF] }
fn x509_tbs_len(cert)          { return cert[X509_C_SLOT_TBS_LEN] }
