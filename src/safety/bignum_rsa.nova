// Variable-width big integers for RSA signature VERIFICATION (PR 4b).
//
// bignum_2048 is a fixed 64-limb type whose only modpow is a constant-time
// Montgomery ladder over all 2048 exponent bits (about 4096 Montgomery
// multiplications, seconds per RSA verify) and whose parsers return 0 for
// wider values -- the root of audit F-17. RSA verification only uses
// public values (signature, modulus, exponent), so it needs neither the
// ladder nor constant time. This module provides:
//   - the same limb layout as bignum_2048 (a NOVA list of 32-bit limbs,
//     least significant first), with the width taken from len(list):
//     64 / 96 / 128 limbs for RSA-2048 / 3072 / 4096. A 64-limb value is
//     limb-for-limb identical to a bn2048, so existing 2048-bit anchors
//     and fixtures stay valid;
//   - big-endian byte import/export (no hex round trip);
//   - a CIOS Montgomery multiply (the bignum_2048 body with the limb count
//     read from the context);
//   - bnr_modpow_pub: left-to-right square-and-multiply over a small public
//     exponent (e=65537: 16 squarings + 1 multiply).
// Every function that takes two values requires equal widths; bnr_eq /
// bnr_cmp treat a width mismatch as "not equal" so a 2048-bit and a
// 4096-bit key can never compare equal on their low limbs.
// bignum_2048 stays unchanged for the constant-time DH users.

let _BNR_MASK32 = 4294967295
let _BNR_MASK16 = 65535
let _BNR_TWO_POW_32 = 4294967296

fn _bnr_mask32(x) { return int_and(x, _BNR_MASK32) }

fn _bnr_alloc_zero(nl) {
    let r = list_new()
    let i = 0
    while i < nl {
        push(r, 0)
        i = i + 1
    }
    return r
}

fn bnr_nlimbs(a) { return len(a) }

// n big-endian bytes at buf+off -> an nl-limb value (right-justified).
// Returns 0 if the bytes do not fit in nl limbs.
fn bnr_from_be_bytes_n(buf, off, n, nl) {
    if n > int_mul(nl, 4) { return 0 }
    let r = _bnr_alloc_zero(nl)
    let i = 0
    while i < n {
        // byte i (from the most significant end) has weight 8*(n-1-i)
        let pos = n - 1 - i
        let limb = int_shr(pos, 2)
        let sh = int_mul(int_and(pos, 3), 8)
        let v = load8(buf + off + i)
        list_set(r, limb, int_or(r[limb], int_shl(v, sh)))
        i = i + 1
    }
    return r
}

// n big-endian bytes -> a value of ceil(n/4) limbs.
fn bnr_from_be_bytes(buf, off, n) {
    return bnr_from_be_bytes_n(buf, off, n, int_shr(n + 3, 2))
}

// Low k bytes of `a` as a big-endian buffer (alloc(k+1), NUL-terminated).
fn bnr_to_be_bytes(a, k) {
    let out = alloc(k + 1)
    let nl = len(a)
    let i = 0
    while i < k {
        let pos = k - 1 - i
        let limb = int_shr(pos, 2)
        let v = 0
        if limb < nl { v = int_and(int_shr(a[limb], int_mul(int_and(pos, 3), 8)), 255) }
        store8(out + i, v)
        i = i + 1
    }
    store8(out + k, 0)
    return out
}

fn _bnr_hexv(c) {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    return -1
}

// Hex string (no prefix) -> value of ceil(len/8) limbs; 0 on a bad digit.
fn bnr_from_hex(hex) {
    let n = len(hex)
    if n == 0 { return 0 }
    let nl = int_shr(n + 7, 3)
    let r = _bnr_alloc_zero(nl)
    let i = 0
    while i < n {
        let v = _bnr_hexv(char_at(hex, i))
        if v < 0 { return 0 }
        let pos = n - 1 - i
        let limb = int_shr(pos, 3)
        let sh = int_mul(int_and(pos, 7), 4)
        list_set(r, limb, int_or(r[limb], int_shl(v, sh)))
        i = i + 1
    }
    return r
}

fn bnr_from_int(n, nl) {
    let r = _bnr_alloc_zero(nl)
    if n <= 0 { return r }
    list_set(r, 0, _bnr_mask32(n))
    if nl > 1 { list_set(r, 1, _bnr_mask32(int_shr(n, 32))) }
    return r
}

fn bnr_is_zero(a) {
    let i = 0
    while i < len(a) {
        if a[i] != 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn bnr_is_odd(a) {
    if len(a) == 0 { return 0 }
    return int_and(a[0], 1)
}

// -1 / 0 / 1 for equal widths; 2 (never "equal") when the widths differ.
fn bnr_cmp(a, b) {
    if len(a) != len(b) { return 2 }
    let i = len(a) - 1
    while i >= 0 {
        if a[i] > b[i] { return 1 }
        if a[i] < b[i] { return -1 }
        i = i - 1
    }
    return 0
}

fn bnr_eq(a, b) {
    if bnr_cmp(a, b) == 0 { return 1 }
    return 0
}

// Number of significant bits (0 for zero).
fn bnr_bitlen(a) {
    let i = len(a) - 1
    while i >= 0 {
        let v = a[i]
        if v != 0 {
            let b = 0
            while v != 0 {
                v = int_shr(v, 1)
                b = b + 1
            }
            return int_mul(i, 32) + b
        }
        i = i - 1
    }
    return 0
}

fn _bnr_shl1_inplace(a) {
    let carry = 0
    let i = 0
    while i < len(a) {
        let v = a[i]
        list_set(a, i, _bnr_mask32(int_or(int_shl(v, 1), carry)))
        carry = int_and(int_shr(v, 31), 1)
        i = i + 1
    }
    return carry
}

// dst = dst - src (mod 2^(32*len)); equal widths.
fn _bnr_sub_inplace(dst, src) {
    let borrow = 0
    let i = 0
    while i < len(dst) {
        let diff = int_sub(int_sub(dst[i], src[i]), borrow)
        if diff < 0 {
            diff = int_add(diff, _BNR_TWO_POW_32)
            borrow = 1
        } else {
            borrow = 0
        }
        list_set(dst, i, _bnr_mask32(diff))
        i = i + 1
    }
    return 1
}

fn _bnr_n_prime0(n0) {
    let n0_lo = int_and(n0, _BNR_MASK16)
    let n0_hi = int_and(int_shr(n0, 16), _BNR_MASK16)
    let x = 1
    let i = 0
    while i < 5 {
        // prod_lo = (n0 * x) mod 2^32 via 16-bit-half split.
        let x_lo = int_and(x, _BNR_MASK16)
        let x_hi = int_and(int_shr(x, 16), _BNR_MASK16)
        let p_ll = int_mul(n0_lo, x_lo)
        let p_lh = int_mul(n0_lo, x_hi)
        let p_hl = int_mul(n0_hi, x_lo)
        let p_mid = int_add(p_lh, p_hl)
        let p_low = int_and(p_ll, _BNR_MASK16)
        let p_high16_sum = int_add(int_shr(p_ll, 16), int_and(p_mid, _BNR_MASK16))
        let prod_lo = _bnr_mask32(int_or(p_low, int_shl(int_and(p_high16_sum, _BNR_MASK16), 16)))
        // two_minus = (2 - prod_lo) mod 2^32 (avoid negatives by adding 2^32).
        let two_minus = int_add(_BNR_TWO_POW_32, 2)
        two_minus = int_sub(two_minus, prod_lo)
        two_minus = _bnr_mask32(two_minus)
        // next_x = (x * two_minus) mod 2^32.
        let tm_lo = int_and(two_minus, _BNR_MASK16)
        let tm_hi = int_and(int_shr(two_minus, 16), _BNR_MASK16)
        let n_ll = int_mul(x_lo, tm_lo)
        let n_lh = int_mul(x_lo, tm_hi)
        let n_hl = int_mul(x_hi, tm_lo)
        let n_mid = int_add(n_lh, n_hl)
        let n_low = int_and(n_ll, _BNR_MASK16)
        let n_high16_sum = int_add(int_shr(n_ll, 16), int_and(n_mid, _BNR_MASK16))
        x = _bnr_mask32(int_or(n_low, int_shl(int_and(n_high16_sum, _BNR_MASK16), 16)))
        i = i + 1
    }
    let neg = int_sub(_BNR_TWO_POW_32, x)
    return _bnr_mask32(neg)
}


// R^2 mod N, R = 2^(32*nl), by repeated doubling with conditional subtract.
// Start from 2^(L-1) < N (L = bitlen(N); N odd and > 1, so N > 2^(L-1)),
// double (64*nl - L + 1) times. A shift carry-out means the true value is
// >= 2^(32*nl) > N, so the subtract is forced (the bignum_2048 fix noted
// at _bn2048_shl1_inplace).
fn _bnr_r2_mod_n(N) {
    let nl = len(N)
    let L = bnr_bitlen(N)
    let x = _bnr_alloc_zero(nl)
    let tb = L - 1
    list_set(x, int_shr(tb, 5), int_shl(1, int_and(tb, 31)))
    let steps = int_mul(nl, 64) - L + 1
    let i = 0
    while i < steps {
        let carry = _bnr_shl1_inplace(x)
        if carry == 1 {
            _bnr_sub_inplace(x, N)
        } else {
            if bnr_cmp(x, N) >= 0 { _bnr_sub_inplace(x, N) }
        }
        i = i + 1
    }
    return x
}

// Montgomery context [nprime0, r2, N, nl], or 0 for a zero, even or
// one-limb-too-small modulus (Montgomery needs N odd and > 1; there is
// deliberately no non-Montgomery fallback -- F-17 exploited one).
fn bnr_mont_ctx_new(N) {
    if N == 0 { return 0 }
    if len(N) == 0 { return 0 }
    if bnr_is_odd(N) == 0 { return 0 }
    if bnr_bitlen(N) < 2 { return 0 }
    let ctx = list_new()
    push(ctx, _bnr_n_prime0(N[0]))
    push(ctx, _bnr_r2_mod_n(N))
    push(ctx, N)
    push(ctx, len(N))
    return ctx
}

fn bnr_montmul(a, b, ctx) {
    let nl = ctx[3]
    let nprime0 = ctx[0]
    let N = ctx[2]
    let t = _bnr_alloc_zero(nl + 1)
    let i = 0
    while i < nl {
        let b_i = b[i]
        let b_i_lo = int_and(b_i, _BNR_MASK16)
        let b_i_hi = int_and(int_shr(b_i, 16), _BNR_MASK16)
        // Multiply step: t += a * b_i, propagating limb-wise carries.
        let carry = 0
        let j = 0
        while j < nl {
            let aj = a[j]
            let aj_lo = int_and(aj, _BNR_MASK16)
            let aj_hi = int_and(int_shr(aj, 16), _BNR_MASK16)
            let ll = int_mul(aj_lo, b_i_lo)
            let lh = int_mul(aj_lo, b_i_hi)
            let hl = int_mul(aj_hi, b_i_lo)
            let hh = int_mul(aj_hi, b_i_hi)
            let mid = int_add(lh, hl)
            let b1_sum = int_add(int_shr(ll, 16), int_and(mid, _BNR_MASK16))
            let plo = int_or(int_and(ll, _BNR_MASK16),
                             int_shl(int_and(b1_sum, _BNR_MASK16), 16))
            let phi = int_add(int_add(hh, int_shr(mid, 16)),
                              int_shr(b1_sum, 16))
            let s_lo = int_add(int_add(t[j], plo), carry)
            list_set(t, j, _bnr_mask32(s_lo))
            carry = int_add(phi, int_shr(s_lo, 32))
            j = j + 1
        }
        // Add final carry into t[N]; spillover beyond t[N] becomes t_overflow.
        let tn_sum = int_add(t[nl], carry)
        list_set(t, nl, _bnr_mask32(tn_sum))
        let t_overflow = int_shr(tn_sum, 32)

        // Reduction step: m = t[0] * nprime0 mod 2^32; t += m * N; t >>= 32.
        // Inlined 32x32 -> low-32 only (we only need m's low 32 bits).
        let np_lo = int_and(nprime0, _BNR_MASK16)
        let np_hi = int_and(int_shr(nprime0, 16), _BNR_MASK16)
        let t0 = t[0]
        let t0_lo = int_and(t0, _BNR_MASK16)
        let t0_hi = int_and(int_shr(t0, 16), _BNR_MASK16)
        let m_mid = int_add(int_mul(t0_lo, np_hi), int_mul(t0_hi, np_lo))
        let m = _bnr_mask32(int_add(int_mul(t0_lo, np_lo),
                                       int_shl(int_and(m_mid, _BNR_MASK16), 16)))
        let m_lo = int_and(m, _BNR_MASK16)
        let m_hi = int_and(int_shr(m, 16), _BNR_MASK16)
        // First inner: by Montgomery's construction the low 32 bits of
        // t[0] + m * N[0] are zero; discard the result and propagate
        // only the carry-into-hi. Inlined 32x32 (avoid per-iter alloc).
        let N0 = N[0]
        let N0_lo = int_and(N0, _BNR_MASK16)
        let N0_hi = int_and(int_shr(N0, 16), _BNR_MASK16)
        let ll0 = int_mul(m_lo, N0_lo)
        let lh0 = int_mul(m_lo, N0_hi)
        let hl0 = int_mul(m_hi, N0_lo)
        let hh0 = int_mul(m_hi, N0_hi)
        let mid0 = int_add(lh0, hl0)
        let b1_sum0 = int_add(int_shr(ll0, 16), int_and(mid0, _BNR_MASK16))
        let p0_lo = int_or(int_and(ll0, _BNR_MASK16),
                           int_shl(int_and(b1_sum0, _BNR_MASK16), 16))
        let p0_hi = int_add(int_add(hh0, int_shr(mid0, 16)),
                            int_shr(b1_sum0, 16))
        let s0 = int_add(t[0], p0_lo)
        let carry2 = int_add(p0_hi, int_shr(s0, 32))
        // Inner reduce loop: for j = 1..N-1, t[j-1] = t[j] + m*N[j] + carry2.
        let jj = 1
        while jj < nl {
            let Nj = N[jj]
            let Nj_lo = int_and(Nj, _BNR_MASK16)
            let Nj_hi = int_and(int_shr(Nj, 16), _BNR_MASK16)
            let llj = int_mul(m_lo, Nj_lo)
            let lhj = int_mul(m_lo, Nj_hi)
            let hlj = int_mul(m_hi, Nj_lo)
            let hhj = int_mul(m_hi, Nj_hi)
            let midj = int_add(lhj, hlj)
            let b1_sumj = int_add(int_shr(llj, 16), int_and(midj, _BNR_MASK16))
            let pj_lo = int_or(int_and(llj, _BNR_MASK16),
                               int_shl(int_and(b1_sumj, _BNR_MASK16), 16))
            let pj_hi = int_add(int_add(hhj, int_shr(midj, 16)),
                                int_shr(b1_sumj, 16))
            let s_lo = int_add(int_add(t[jj], pj_lo), carry2)
            list_set(t, jj - 1, _bnr_mask32(s_lo))
            carry2 = int_add(pj_hi, int_shr(s_lo, 32))
            jj = jj + 1
        }
        // Tail: t[N-1] = t[N] + carry2; new t[N] = t_overflow + spill.
        let tail = int_add(t[nl], carry2)
        list_set(t, nl - 1, _bnr_mask32(tail))
        let tail_carry = int_shr(tail, 32)
        list_set(t, nl, _bnr_mask32(int_add(t_overflow, tail_carry)))
        i = i + 1
    }
    // Result candidate: t[0..N-1]. Mathematically result < 2*N; one
    // conditional subtract of N produces the canonical [0, N) value.
    let result = _bnr_alloc_zero(nl)
    let k = 0
    while k < nl {
        list_set(result, k, t[k])
        k = k + 1
    }
    if t[nl] != 0 {
        _bnr_sub_inplace(result, N)
    } else {
        if bnr_cmp(result, N) >= 0 {
            _bnr_sub_inplace(result, N)
        }
    }
    return result
}

fn bnr_to_mont(x, ctx) { return bnr_montmul(x, ctx[1], ctx) }

fn bnr_from_mont(x, ctx) { return bnr_montmul(x, bnr_from_int(1, ctx[3]), ctx) }

// s^e mod N for a PUBLIC s < N and a small public exponent 1 <= e < 2^32
// (variable time: every input is public in signature verification).
// Returns 0 if s >= N, the widths differ or e is out of range.
fn bnr_modpow_pub(s, e, ctx) {
    if ctx == 0 { return 0 }
    let N = ctx[2]
    if len(s) != len(N) { return 0 }
    if bnr_cmp(s, N) >= 0 { return 0 }
    if e < 1 { return 0 }
    if e > 4294967295 { return 0 }
    let top = 31
    while int_and(int_shr(e, top), 1) == 0 { top = top - 1 }
    let x = bnr_to_mont(s, ctx)
    let acc = x
    let i = top - 1
    while i >= 0 {
        acc = bnr_montmul(acc, acc, ctx)
        if int_and(int_shr(e, i), 1) == 1 { acc = bnr_montmul(acc, x, ctx) }
        i = i - 1
    }
    return bnr_from_mont(acc, ctx)
}

// ---- generic modular helpers (PR 4c: P-384 field / scalar arithmetic) ----

// (a + b) mod m for a, b < m (equal widths). A carry out of the container
// means the true sum is >= 2^(32*nl) > m, so the subtract is forced.
fn bnr_addmod(a, b, m) {
    let nl = len(m)
    let r = _bnr_alloc_zero(nl)
    let carry = 0
    let i = 0
    while i < nl {
        let s = int_add(int_add(a[i], b[i]), carry)
        list_set(r, i, _bnr_mask32(s))
        carry = int_shr(s, 32)
        i = i + 1
    }
    if carry != 0 {
        _bnr_sub_inplace(r, m)
    } else {
        if bnr_cmp(r, m) >= 0 { _bnr_sub_inplace(r, m) }
    }
    return r
}

// (a - b) mod m for a, b < m (equal widths).
fn bnr_submod(a, b, m) {
    let nl = len(m)
    let r = _bnr_alloc_zero(nl)
    let i = 0
    while i < nl {
        list_set(r, i, a[i])
        i = i + 1
    }
    if bnr_cmp(a, b) < 0 {
        // r = a + (m - b): compute m - b first, then add (no overflow: < m).
        let t = _bnr_alloc_zero(nl)
        let j = 0
        while j < nl {
            list_set(t, j, m[j])
            j = j + 1
        }
        _bnr_sub_inplace(t, b)
        return bnr_addmod(a, t, m)
    }
    _bnr_sub_inplace(r, b)
    return r
}

// Bit i of a (0 = least significant).
fn bnr_bit(a, i) {
    let limb = int_shr(i, 5)
    if limb >= len(a) { return 0 }
    return int_and(int_shr(a[limb], int_and(i, 31)), 1)
}

// x^exp mod m (x < m, exp a big integer of any width), left-to-right
// square-and-multiply in the Montgomery domain. Variable time: only for
// public inputs (signature verification, Fermat inversion of public values).
fn bnr_modexp(x, exp, ctx) {
    if ctx == 0 { return 0 }
    let N = ctx[2]
    if len(x) != len(N) { return 0 }
    if bnr_cmp(x, N) >= 0 { return 0 }
    let top = bnr_bitlen(exp)
    if top == 0 { return bnr_from_int(1, len(N)) }
    let xm = bnr_to_mont(x, ctx)
    let acc = xm
    let i = top - 2
    while i >= 0 {
        acc = bnr_montmul(acc, acc, ctx)
        if bnr_bit(exp, i) == 1 { acc = bnr_montmul(acc, xm, ctx) }
        i = i - 1
    }
    return bnr_from_mont(acc, ctx)
}

// x^-1 mod m for a prime m (Fermat: x^(m-2)); 0 for x == 0.
fn bnr_inv_prime(x, ctx) {
    if bnr_is_zero(x) == 1 { return 0 }
    let N = ctx[2]
    let e = _bnr_alloc_zero(len(N))
    let i = 0
    while i < len(N) {
        list_set(e, i, N[i])
        i = i + 1
    }
    _bnr_sub_inplace(e, bnr_from_int(2, len(N)))
    return bnr_modexp(x, e, ctx)
}
