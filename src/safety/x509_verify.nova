// CrossEngin safety: X.509 chain verification for RSA certificates (R43).
//
// Purpose
//   Authenticates a TLS 1.3 server by validating the presented certificate
//   chain against a PINNED trust anchor. The existing `x509.nova` parses
//   ECDSA certs for the DTLS path; this module handles the RSA chains the
//   sandbox egress gateway presents (leaf <- SDS Issuing CA <- pinned root),
//   extracting the bits a chain check needs that `x509.nova` does not: the RSA
//   public key (modulus + exponent), the Subject Alternative Names, the exact
//   tbsCertificate byte range (what the signature covers), and the signature.
//
//   Checks performed by cert_chain_verify():
//     1. each cert's signature verifies under the next cert's public key:
//        sha{256,384,512}WithRSAEncryption (PKCS#1 v1.5; RSA-2048/3072/4096
//        since PR 4b) or ecdsa-with-SHA256/384/512 (P-256, P-384 since PR 4c);
//     2. the top cert's public key equals the pinned anchor key;
//     3. the leaf's SAN covers the requested host (exact or *.suffix);
//     4. the leaf is within its validity window.
//   The TLS 1.3 CertificateVerify (RSA-PSS) is checked separately by the
//   caller (tls13_client) using the leaf key this module returns.
//
// NOVA deps: alloc/load8/store8, substr (buffer slice), time. CrossEngin deps:
//   ../safety/rsa.nova (-> bignum_rsa + sha256 + sha512). Tested in
//   tests/unit/test_x509_verify.nova against the live gateway chain.

import "std/io"
import "std/string"
import "std/syscall"
import "rsa.nova"
import "ecdsa.nova"
import "p384.nova"
import "../util/str_safe.nova"

// key + signature algorithm kinds.
let KEY_RSA    = 1
let KEY_EC     = 2
let SIG_RSA    = 1   // sha256WithRSAEncryption (PKCS#1 v1.5)
let SIG_ECDSA  = 2   // ecdsa-with-SHA256
let SIG_RSA_SHA384 = 3   // sha384WithRSAEncryption (PKCS#1 v1.5)
let SIG_RSA_SHA512 = 4   // sha512WithRSAEncryption (PKCS#1 v1.5)
let SIG_ECDSA_SHA384 = 5 // ecdsa-with-SHA384
let SIG_ECDSA_SHA512 = 6 // ecdsa-with-SHA512
// Not supported (a cert signed this way fails cert_verify_under): RSASSA-PSS
// certificate signatures (none in the system bundle), sha1WithRSA, P-521.

// EC keys: the curve follows from the uncompressed point length.
let EC_P256_POINT_LEN = 65
let EC_P384_POINT_LEN = 97

// Hash id (RSA_H_*) any signature type uses, or 0 for an unknown type.
fn _x509v_sig_hash(st) {
    if st == SIG_RSA { return RSA_H_SHA256 }
    if st == SIG_ECDSA { return RSA_H_SHA256 }
    if st == SIG_RSA_SHA384 { return RSA_H_SHA384 }
    if st == SIG_ECDSA_SHA384 { return RSA_H_SHA384 }
    if st == SIG_RSA_SHA512 { return RSA_H_SHA512 }
    if st == SIG_ECDSA_SHA512 { return RSA_H_SHA512 }
    return 0
}

fn _x509v_is_ecdsa_sig(st) {
    if st == SIG_ECDSA { return 1 }
    if st == SIG_ECDSA_SHA384 { return 1 }
    if st == SIG_ECDSA_SHA512 { return 1 }
    return 0
}

// RSA_H_* hash id an RSA signature type uses, or 0 if not an RSA type.
fn _x509v_rsa_sig_hash(st) {
    if st == SIG_RSA { return RSA_H_SHA256 }
    if st == SIG_RSA_SHA384 { return RSA_H_SHA384 }
    if st == SIG_RSA_SHA512 { return RSA_H_SHA512 }
    return 0
}

// ---- minimal DER reader: [tag, content_off, content_len, next_off] --------
let _X509V_DER_TOO_LONG = 1099511627776   // 2^40: rejected by every bound check

fn _der(buf, pos) {
    let tag = load8(buf + pos)
    let p = pos + 1
    let b0 = load8(buf + p)
    let length = 0
    if b0 < 128 { length = b0 p = p + 1 }
    else {
        let num = b0 - 128
        p = p + 1
        // More than 4 length bytes used to overflow the 62-bit accumulator to
        // a negative length, so p + length pointed far before the buffer and
        // the next read segfaulted. No certificate or signature we accept is
        // anywhere near 4 GiB: report an absurd positive length instead, so
        // every "fits in the buffer" check downstream rejects it.
        if num > 4 {
            length = _X509V_DER_TOO_LONG
            p = p + num
        } else {
            let k = 0
            while k < num { length = length * 256 + load8(buf + p) p = p + 1 k = k + 1 }
        }
    }
    let r = list_new()
    push(r, tag) push(r, p) push(r, length) push(r, p + length)
    return r
}

fn _x509v_nib(v) { if v < 10 { return 48 + v } return 87 + v }
fn _x509v_bytes_to_hex(buf, off, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + off + i)
        s = s + chr(_x509v_nib(int_shr(b, 4))) + chr(_x509v_nib(int_and(b, 15)))
        i = i + 1
    }
    return s
}

// Extract [off,off+n) from a raw alloc'd buffer as a proper string. NOVA's
// `substr` builtin requires a string handle on the LHS; feeding it a raw
// pointer segfaults. Build the string byte-by-byte via chr/load8 instead.
fn _x509v_bytes_to_str(buf, off, n) {
    let s = ""
    let i = 0
    while i < n { s = s + chr(load8(buf + off + i)) i = i + 1 }
    return s
}

fn _x509v_two(buf, off) { return (load8(buf + off) - 48) * 10 + (load8(buf + off + 1) - 48) }
fn _x509v_four(buf, off) {
    return (load8(buf + off) - 48) * 1000 + (load8(buf + off + 1) - 48) * 100
         + (load8(buf + off + 2) - 48) * 10 + (load8(buf + off + 3) - 48)
}
// days since 1970-01-01 (Howard Hinnant's algorithm; years >= 2000 here).
fn _x509v_days(y, m, d) {
    let yy = y
    if m <= 2 { yy = yy - 1 }
    let era = yy / 400
    let yoe = yy - era * 400
    let mm = m + 9
    if m > 2 { mm = m - 3 }
    let doy = (153 * mm + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}
// Parse a UTCTime (0x17, YY...) or GeneralizedTime (0x18) TLV at pos -> unix.
fn _x509v_time(buf, pos) {
    let t = _der(buf, pos)
    let o = t[1]
    let year = 0
    let rest = o
    if t[0] == 23 {                       // UTCTime YYMMDDHHMMSSZ
        let yy = _x509v_two(buf, o)
        if yy < 50 { year = 2000 + yy } else { year = 1900 + yy }
        rest = o + 2
    } else {                              // GeneralizedTime YYYYMMDD...
        year = _x509v_four(buf, o)
        rest = o + 4
    }
    let mon = _x509v_two(buf, rest)
    let day = _x509v_two(buf, rest + 2)
    let hh = _x509v_two(buf, rest + 4)
    let mm2 = _x509v_two(buf, rest + 6)
    let ss = _x509v_two(buf, rest + 8)
    return _x509v_days(year, mon, day) * 86400 + hh * 3600 + mm2 * 60 + ss
}

fn _x509v_oid_at(buf, o, b) {
    let i = 0
    while i < len(b) {
        if load8(buf + o + i) != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// SPKI algorithm -> KEY_RSA (rsaEncryption) / KEY_EC (ecPublicKey) / 0.
fn _x509v_spki_key_type(buf, spki_off) {
    let spki = _der(buf, spki_off)
    let alg = _der(buf, spki[1])
    let oid = _der(buf, alg[1])
    let o = oid[1]
    if oid[2] == 9 {
        if _x509v_oid_at(buf, o, [42, 134, 72, 134, 247, 13, 1, 1, 1]) == 1 { return KEY_RSA }
    }
    if oid[2] == 7 {
        if _x509v_oid_at(buf, o, [42, 134, 72, 206, 61, 2, 1]) == 1 { return KEY_EC }
    }
    return 0
}

// signatureAlgorithm OID -> SIG_RSA / SIG_ECDSA / 0.
fn _x509v_sigalg_type(buf, sigalg_off) {
    let alg = _der(buf, sigalg_off)
    let oid = _der(buf, alg[1])
    let o = oid[1]
    if oid[2] == 9 {
        if _x509v_oid_at(buf, o, [42, 134, 72, 134, 247, 13, 1, 1, 11]) == 1 { return SIG_RSA }
        if _x509v_oid_at(buf, o, [42, 134, 72, 134, 247, 13, 1, 1, 12]) == 1 { return SIG_RSA_SHA384 }
        if _x509v_oid_at(buf, o, [42, 134, 72, 134, 247, 13, 1, 1, 13]) == 1 { return SIG_RSA_SHA512 }
    }
    if oid[2] == 8 {
        if _x509v_oid_at(buf, o, [42, 134, 72, 206, 61, 4, 3, 2]) == 1 { return SIG_ECDSA }
        if _x509v_oid_at(buf, o, [42, 134, 72, 206, 61, 4, 3, 3]) == 1 { return SIG_ECDSA_SHA384 }
        if _x509v_oid_at(buf, o, [42, 134, 72, 206, 61, 4, 3, 4]) == 1 { return SIG_ECDSA_SHA512 }
    }
    return 0
}

// Extract the 65-byte uncompressed EC point (0x04||X||Y) from an EC SPKI.
fn _x509v_ec_point(buf, spki_off) {
    let spki = _der(buf, spki_off)
    let alg = _der(buf, spki[1])
    // namedCurve must be prime256v1 (1.2.840.10045.3.1.7, 65-byte point) or
    // secp384r1 (1.3.132.0.34, 97-byte point, PR 4c), and the point length
    // must match the curve. Other curves (P-521, ...) are rejected, not
    // misread.
    let oid = _der(buf, alg[1])
    let params = _der(buf, oid[3])
    if params[0] != 6 { return 0 }
    let want = 0
    if params[2] == 8 {
        if _x509v_oid_at(buf, params[1], [42, 134, 72, 206, 61, 3, 1, 7]) == 1 { want = EC_P256_POINT_LEN }
    }
    if params[2] == 5 {
        if _x509v_oid_at(buf, params[1], [43, 129, 4, 0, 34]) == 1 { want = EC_P384_POINT_LEN }
    }
    if want == 0 { return 0 }
    let bs = _der(buf, alg[3])            // subjectPublicKey BIT STRING
    let pt_off = bs[1] + 1                // skip unused-bits byte
    let pt_n = bs[2] - 1
    if pt_n != want { return 0 }
    if load8(buf + pt_off) != 4 { return 0 }
    let out = alloc(pt_n + 1)
    let i = 0
    while i < pt_n { store8(out + i, load8(buf + pt_off + i)) i = i + 1 }
    let r = list_new() push(r, out) push(r, pt_n)
    return r
}

// Normalize a DER INTEGER (off,len) to a 32-byte big-endian buffer.
fn _x509v_int_to_32(buf, off, len) { return _x509v_int_to_w(buf, off, len, 32) }

fn _x509v_int_to_w(buf, off, len, w) {
    let o = off
    let l = len
    if l > 0 { if load8(buf + o) == 0 { o = o + 1 l = l - 1 } }   // strip sign byte
    // Audit F-17: r/s come from the peer; longer than w bytes used to write
    // past the buffer. Reject instead.
    if l < 1 { return 0 }
    if l > w { return 0 }
    let out = alloc(w + 1)
    let i = 0
    while i < w { store8(out + i, 0) i = i + 1 }
    let pad = w - l
    let k = 0
    while k < l { store8(out + pad + k, load8(buf + o + k)) k = k + 1 }
    return out
}

// Parse a DER ECDSA signature SEQUENCE{r,s} -> [r32, s32] or 0.
// ECDSA-Sig-Value -> [r, s] as w-byte big-endian buffers (w = 32 for P-256,
// 48 for P-384); 0 if malformed or an integer is wider than w.
fn _x509v_parse_ecdsa_sig(buf, n) { return _x509v_parse_ecdsa_sig_w(buf, n, 32) }

fn _x509v_parse_ecdsa_sig_w(buf, n, w) {
    // Strict DER (as openssl produces): SEQUENCE { INTEGER r, INTEGER s }
    // with short-form lengths only (every P-256/P-384 signature is < 128
    // bytes), nothing after the SEQUENCE or after s inside it, and minimal
    // non-negative INTEGERs. Anything else is rejected: it is not a forgery
    // risk (r and s must still verify) but it made signatures malleable.
    if n < 8 { return 0 }
    if load8(buf) != 48 { return 0 }
    let seq_len = load8(buf + 1)
    if seq_len >= 128 { return 0 }
    if seq_len + 2 != n { return 0 }
    let r_end = _x509v_der_uint_end(buf, 2, n)
    if r_end < 0 { return 0 }
    let s_end = _x509v_der_uint_end(buf, r_end, n)
    if s_end != n { return 0 }
    let r32 = _x509v_int_to_w(buf, 4, load8(buf + 3), w)
    let s32 = _x509v_int_to_w(buf, r_end + 2, load8(buf + r_end + 1), w)
    if r32 == 0 { return 0 }
    if s32 == 0 { return 0 }
    let out = list_new()
    push(out, r32)
    push(out, s32)
    return out
}

// A strict-DER non-negative INTEGER at buf[off..n): tag 0x02, short-form
// length >= 1, no negative value (top bit clear), no superfluous leading
// 0x00. Returns the offset just past it, or -1.
fn _x509v_der_uint_end(buf, off, n) {
    if off + 2 > n { return 0 - 1 }
    if load8(buf + off) != 2 { return 0 - 1 }
    let l = load8(buf + off + 1)
    if l >= 128 { return 0 - 1 }
    if l < 1 { return 0 - 1 }
    let end = off + 2 + l
    if end > n { return 0 - 1 }
    let b0 = load8(buf + off + 2)
    if int_and(b0, 128) != 0 { return 0 - 1 }                  // negative
    if b0 == 0 {
        if l == 1 { return end }                                 // the value 0
        if int_and(load8(buf + off + 3), 128) == 0 { return 0 - 1 }   // needless pad
    }
    return end
}

// ---- RSA SubjectPublicKeyInfo -> [N_bn, e_int] ----------------------------
fn _x509v_rsa_spki(buf, spki_off) {
    let spki = _der(buf, spki_off)
    let alg = _der(buf, spki[1])
    let bs = _der(buf, alg[3])            // subjectPublicKey BIT STRING
    let rsa_seq = _der(buf, bs[1] + 1)    // skip unused-bits byte (0x00)
    let modint = _der(buf, rsa_seq[1])    // INTEGER modulus
    let expint = _der(buf, modint[3])     // INTEGER exponent
    let moff = modint[1]
    let mlen = modint[2]
    if mlen <= 0 { return 0 }
    if load8(buf + moff) == 0 { moff = moff + 1 mlen = mlen - 1 }   // strip sign byte
    // Audit F-17: a modulus wider than bignum_2048 used to parse as N = 0,
    // two such keys "matched" each other in cert_anchor_match, and modpow
    // mod 0 returned the base, so any signature verified. Sizes are now an
    // explicit allowlist (2048 / 3072 / 4096 bits, PR 4b) parsed straight
    // from the bytes into a list of exactly mlen/4 limbs, N must be odd,
    // and anchor matching compares widths (bnr_eq).
    if rsa_key_bytes_ok(mlen) == 0 { return 0 }
    if load8(buf + moff) == 0 { return 0 }
    if int_and(load8(buf + moff + mlen - 1), 1) == 0 { return 0 }   // N odd
    let n = bnr_from_be_bytes(buf, moff, mlen)
    if n == 0 { return 0 }
    if bnr_is_zero(n) == 1 { return 0 }
    // Public exponent: odd, 3 .. 2^32-1 (1..4 bytes after the DER sign byte).
    let eoff = expint[1]
    let elen = expint[2]
    if elen > 1 { if load8(buf + eoff) == 0 { eoff = eoff + 1 elen = elen - 1 } }
    if elen < 1 { return 0 }
    if elen > 4 { return 0 }
    let e = 0
    let i = 0
    while i < elen { e = e * 256 + load8(buf + eoff + i) i = i + 1 }
    if e < 3 { return 0 }
    if int_and(e, 1) == 0 { return 0 }
    let r = list_new() push(r, n) push(r, e)
    return r
}

// Collect dNSName SANs from the extensions SEQUENCE [off,end).
fn _x509v_collect_san(buf, off, end, out) {
    let p = off
    while p < end {
        let ext = _der(buf, p)
        let oid = _der(buf, ext[1])
        let is_san = 0
        if oid[2] == 3 {
            if load8(buf + oid[1]) == 85 { if load8(buf + oid[1] + 1) == 29 { if load8(buf + oid[1] + 2) == 17 { is_san = 1 } } }
        }
        if is_san == 1 {
            let q = oid[3]
            if load8(buf + q) == 1 { let bo = _der(buf, q) q = bo[3] }   // optional critical BOOLEAN
            let octet = _der(buf, q)
            let gnseq = _der(buf, octet[1])
            let g = gnseq[1]
            while g < gnseq[3] {
                let gn = _der(buf, g)
                if gn[0] == 130 { push(out, _x509v_bytes_to_str(buf, gn[1], gn[2])) }   // [2] dNSName
                g = gn[3]
            }
        }
        p = ext[3]
    }
    return 1
}

// basicConstraints (2.5.29.19) and keyUsage (2.5.29.15) from the extensions
// SEQUENCE [off,end). Returns [is_ca, path_len (-1 = none), ku_present,
// ku_cert_sign]. A cert with no basicConstraints is not a CA (RFC 5280
// 4.2.1.9); keyCertSign is bit 5 of keyUsage.
fn _x509v_ca_info(buf, off, end) {
    let is_ca = 0
    let path_len = -1
    let ku_present = 0
    let ku_sign = 0
    let p = off
    while p < end {
        let ext = _der(buf, p)
        let oid = _der(buf, ext[1])
        let which = 0
        if oid[2] == 3 {
            if load8(buf + oid[1]) == 85 {
                if load8(buf + oid[1] + 1) == 29 {
                    let last = load8(buf + oid[1] + 2)
                    if last == 19 { which = 1 }        // basicConstraints
                    if last == 15 { which = 2 }        // keyUsage
                }
            }
        }
        if which > 0 {
            let q = oid[3]
            if load8(buf + q) == 1 { let bo = _der(buf, q) q = bo[3] }   // optional critical BOOLEAN
            let octet = _der(buf, q)
            if which == 1 {
                let seq = _der(buf, octet[1])
                let s = seq[1]
                if s < seq[3] {
                    if load8(buf + s) == 1 {               // cA BOOLEAN
                        let b = _der(buf, s)
                        if b[2] == 1 { if load8(buf + b[1]) != 0 { is_ca = 1 } }
                        s = b[3]
                    }
                }
                if s < seq[3] {
                    if load8(buf + s) == 2 {               // pathLenConstraint
                        let pl = _der(buf, s)
                        if pl[2] >= 1 { if pl[2] <= 2 {
                            path_len = 0
                            let k = 0
                            while k < pl[2] { path_len = path_len * 256 + load8(buf + pl[1] + k) k = k + 1 }
                        } }
                    }
                }
            } else {
                let bs = _der(buf, octet[1])               // BIT STRING
                ku_present = 1
                if bs[2] >= 2 {
                    if int_and(load8(buf + bs[1] + 1), 4) != 0 { ku_sign = 1 }
                }
            }
        }
        p = ext[3]
    }
    let r = list_new()
    push(r, is_ca) push(r, path_len) push(r, ku_present) push(r, ku_sign)
    return r
}

// ---- cert record ----------------------------------------------------------
// [ok, N_bn, e_int, der_buf, tbs_off, tbs_len, sig_off, sig_n, san_list, nb, na]
fn cert_parse(der, n) {
    let cert = _der(der, 0)
    let cpos = cert[1]
    let tbs = _der(der, cpos)
    let tbs_off = cpos
    let tbs_end = tbs[3]
    let tbs_len = tbs_end - cpos
    let p = tbs[1]
    if load8(der + p) == 160 { let v = _der(der, p) p = v[3] }   // version [0]
    let ser = _der(der, p) p = ser[3]                            // serialNumber
    let alg1 = _der(der, p) p = alg1[3]                          // signature alg
    let iss_off = p
    let issuer = _der(der, p) p = issuer[3]                      // issuer
    let val = _der(der, p)                                       // validity
    let nbt = _der(der, val[1])
    let nb = _x509v_time(der, val[1])
    let na = _x509v_time(der, nbt[3])
    p = val[3]
    let subj_off = p
    let subj = _der(der, p) p = subj[3]                          // subject
    // PR 4d: the issuer / subject Name TLVs are compared byte for byte when
    // building the path; they must lie inside the TBS.
    if issuer[3] > tbs_end { let bad_dn = list_new() push(bad_dn, 0) return bad_dn }
    if subj[3] > tbs_end { let bad_dn2 = list_new() push(bad_dn2, 0) return bad_dn2 }
    let spki = _der(der, p)                                      // SPKI
    let kt = _x509v_spki_key_type(der, p)
    if kt == 0 { let bad = list_new() push(bad, 0) return bad }   // unsupported key alg
    let N = 0
    let e = 0
    let ec_pt = 0
    let ec_n = 0
    if kt == KEY_RSA {
        let pk = _x509v_rsa_spki(der, p)
        if pk == 0 { let bad_rsa = list_new() push(bad_rsa, 0) return bad_rsa }   // unsupported size / bad key
        N = pk[0] e = pk[1]
    } else {
        let ec = _x509v_ec_point(der, p)
        if ec == 0 { let bad_ec = list_new() push(bad_ec, 0) return bad_ec }      // not an uncompressed P-256 point
        ec_pt = ec[0] ec_n = ec[1]
    }
    p = spki[3]
    let san = list_new()
    let ca = list_new() push(ca, 0) push(ca, -1) push(ca, 0) push(ca, 0)
    if p < tbs_end {
        if load8(der + p) == 163 {                              // extensions [3]
            let exts_exp = _der(der, p)
            let exts = _der(der, exts_exp[1])
            _x509v_collect_san(der, exts[1], exts[3], san)
            ca = _x509v_ca_info(der, exts[1], exts[3])
        }
    }
    let st = _x509v_sigalg_type(der, tbs_end)                   // how THIS cert is signed
    let sig_alg = _der(der, tbs_end)
    let sig_bs = _der(der, sig_alg[3])                          // signature BIT STRING
    let sig_off = sig_bs[1] + 1                                 // skip unused-bits byte
    let sig_n = sig_bs[2] - 1
    let r = list_new()
    push(r, 1) push(r, N) push(r, e) push(r, der)
    push(r, tbs_off) push(r, tbs_len) push(r, sig_off) push(r, sig_n)
    push(r, san) push(r, nb) push(r, na)
    push(r, kt) push(r, ec_pt) push(r, ec_n) push(r, st)
    push(r, ca[0]) push(r, ca[1]) push(r, ca[2]) push(r, ca[3])
    push(r, iss_off) push(r, issuer[3] - iss_off) push(r, subj_off) push(r, subj[3] - subj_off)
    return r
}
fn cert_ok(c)         { return c[0] }
fn cert_N(c)          { return c[1] }
fn cert_e(c)          { return c[2] }
fn cert_san(c)        { return c[8] }
fn cert_not_before(c) { return c[9] }
fn cert_not_after(c)  { return c[10] }
fn cert_key_type(c)   { return c[11] }
fn cert_ec_point(c)   { return c[12] }
fn cert_ec_point_n(c) { return c[13] }
fn cert_sig_type(c)   { return c[14] }
fn cert_is_ca(c)      { return c[15] }
fn cert_path_len(c)   { return c[16] }
fn cert_ku_present(c) { return c[17] }
fn cert_ku_cert_sign(c) { return c[18] }
// Issuer / subject Name TLVs (offset into the DER buffer c[3], length).
fn cert_issuer_off(c)  { return c[19] }
fn cert_issuer_len(c)  { return c[20] }
fn cert_subject_off(c) { return c[21] }
fn cert_subject_len(c) { return c[22] }

// 1 if `child`'s issuer Name equals `parent`'s subject Name byte for byte
// (RFC 5280 name chaining, without the full comparison rules -- CAs encode
// the issuer field by copying the issuing cert's subject).
fn cert_issued_name_by(child, parent) {
    let n = cert_issuer_len(child)
    if n != cert_subject_len(parent) { return 0 }
    if n <= 0 { return 0 }
    let a = child[3] + cert_issuer_off(child)
    let b = parent[3] + cert_subject_off(parent)
    let i = 0
    while i < n {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}
// Hash of the tbsCertificate bytes (what the signature covers), with the
// hash the cert's signature algorithm names.
fn cert_tbs_hash(c) {
    let h = _x509v_sig_hash(cert_sig_type(c))
    if h == RSA_H_SHA384 { return sha384_oneshot(c[3] + c[4], c[5]) }
    if h == RSA_H_SHA512 { return sha512_oneshot(c[3] + c[4], c[5]) }
    return sha256_oneshot(c[3] + c[4], c[5])
}
fn cert_sig_buf(c) { return c[3] + c[6] }
fn cert_sig_n(c)   { return c[7] }

// Verify `child`'s signature under `parent`'s public key, dispatching on the
// child's signature algorithm: RSA PKCS#1 v1.5 with SHA-256/384/512, or
// ECDSA-P256 with SHA-256.
fn cert_verify_under(child, parent) {
    let hash = cert_tbs_hash(child)
    let rh = _x509v_rsa_sig_hash(cert_sig_type(child))
    if rh != 0 {
        if cert_key_type(parent) != KEY_RSA { return 0 }
        return rsa_pkcs1_verify(cert_N(parent), cert_e(parent), rh, hash, cert_sig_buf(child), cert_sig_n(child))
    }
    if _x509v_is_ecdsa_sig(cert_sig_type(child)) == 1 {
        if cert_key_type(parent) != KEY_EC { return 0 }
        return ecdsa_verify_any(cert_ec_point(parent), cert_ec_point_n(parent), hash,
                                _rsa_hash_len(_x509v_sig_hash(cert_sig_type(child))),
                                cert_sig_buf(child), cert_sig_n(child))
    }
    return 0
}

// ECDSA verify for a P-256 or P-384 key (curve from the point length) over a
// digest of hash_n bytes; the DER signature is parsed at the curve's width.
// P-256 uses the leftmost 256 bits of a longer digest (FIPS 186-4 6.4).
fn ecdsa_verify_any(pub, pub_n, hash, hash_n, sig_der, sig_n) {
    if pub_n == EC_P256_POINT_LEN {
        if hash_n < 32 { return 0 }
        let rs = _x509v_parse_ecdsa_sig_w(sig_der, sig_n, 32)
        if rs == 0 { return 0 }
        return ecdsa_p256_verify(pub, pub_n, hash, rs[0], rs[1])
    }
    if pub_n == EC_P384_POINT_LEN {
        let rs4 = _x509v_parse_ecdsa_sig_w(sig_der, sig_n, 48)
        if rs4 == 0 { return 0 }
        return ecdsa_p384_verify(pub, pub_n, hash, hash_n, rs4[0], rs4[1])
    }
    return 0
}

// Does the chain's top cert match this trust anchor? anchor = [key_type, A, B]:
// RSA [KEY_RSA, N_bn, e]; EC [KEY_EC, point_buf, point_n].
fn cert_anchor_match(top, anchor) {
    if anchor[0] != cert_key_type(top) { return 0 }
    if anchor[0] == KEY_RSA {
        // Width-checked (a 2048-bit key never equals a 4096-bit one on its
        // low limbs -- the F-17 failure mode) and the exponent must match.
        if bnr_eq(cert_N(top), anchor[1]) == 0 { return 0 }
        if cert_e(top) != anchor[2] { return 0 }
        return 1
    }
    if anchor[0] == KEY_EC {
        if cert_ec_point_n(top) != anchor[2] { return 0 }
        let i = 0
        while i < anchor[2] {
            if load8(cert_ec_point(top) + i) != load8(anchor[1] + i) { return 0 }
            i = i + 1
        }
        return 1
    }
    return 0
}

// hostname vs one SAN pattern: exact, or "*.suffix".
fn _x509v_san_match(host, pat) {
    if str_eq_bytes(host, pat) == 1 { return 1 }
    if len(pat) >= 2 {
        if char_at(pat, 0) == 42 { if char_at(pat, 1) == 46 {     // "*."
            let suffix = substr(pat, 1, len(pat) - 1)             // ".rest"
            let hi = find_bytes(host, suffix)
            if hi > 0 { if hi + len(suffix) == len(host) {
                // wildcard matches exactly one leftmost label (no extra dot)
                if find_char(substr(host, 0, hi), 46) < 0 { return 1 }
            } }
        } }
    }
    return 0
}
fn _x509v_host_ok(host, san) {
    let i = 0
    while i < len(san) {
        if _x509v_san_match(host, san[i]) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---- chain verification ---------------------------------------------------
let XV_OK            = 1
let XV_PARSE         = 2
let XV_SIG           = 3
let XV_NOT_PINNED    = 4
let XV_HOSTNAME      = 5
let XV_EXPIRED       = 6
let XV_NOT_CA        = 7
let XV_NAME_CHAIN    = 8   // a cert's issuer is not the next cert's subject

fn xv_name(s) {
    if s == XV_OK         { return "ok" }
    if s == XV_PARSE      { return "parse-failed" }
    if s == XV_SIG        { return "bad-chain-signature" }
    if s == XV_NOT_PINNED { return "root-not-pinned" }
    if s == XV_HOSTNAME   { return "hostname-mismatch" }
    if s == XV_EXPIRED    { return "expired-or-not-yet-valid" }
    if s == XV_NOT_CA     { return "issuer-not-a-ca" }
    if s == XV_NAME_CHAIN { return "issuer-subject-mismatch" }
    return "unknown"
}

// der_list: list of [buf, len] leaf-first. Returns [status, leaf_cert]
// (leaf_cert valid only on XV_OK; used by the caller for the
// CertificateVerify check).
// anchors: a list of typed trust anchors (a single pin or a whole PEM trust
// store): [KEY_RSA, N (64/96/128 limbs), e] or [KEY_EC, point_buf, point_n],
// optionally followed by the anchor's parsed cert record (anchor[3], set by
// truststore_load). An RSA anchor key matches only if the width, N and e are
// all equal.
//
// Path (PR 4d): walking up from the leaf, the first cert that either IS an
// anchor (same key) or is ISSUED BY an anchor that carries its cert (issuer
// Name == anchor subject Name, the anchor is a CA allowed to sign certs at
// that depth and currently valid, and the signature verifies under its key)
// is the trust point; certs above it are ignored (servers usually omit the
// root and sometimes send cross-signed extras). When the trust point matched
// an anchor by key and that anchor carries its cert record, the record (not
// the presented copy) supplies the trust point's constraints, validity and,
// at depth 0, its names. Below the trust point every
// issuer must be a CA, names must chain, every signature must verify, the
// leaf must cover `host`, and every cert must be valid at `now`.
fn cert_chain_verify(der_list, host, anchors, now) {
    let certs = list_new()
    let i = 0
    while i < len(der_list) {
        let c = cert_parse(der_list[i][0], der_list[i][1])
        if cert_ok(c) == 0 { let r = list_new() push(r, XV_PARSE) push(r, 0) return r }
        push(certs, c)
        i = i + 1
    }
    if len(certs) == 0 { let r = list_new() push(r, XV_PARSE) push(r, 0) return r }

    // Find the trust point.
    let top_i = 0 - 1
    let k0 = 0
    while k0 < len(certs) {
        if top_i < 0 {
            let ai = 0
            while ai < len(anchors) {
                let how = _x509v_trusted_at(certs[k0], anchors[ai], k0, now)
                if how != 0 {
                    top_i = k0
                    // Key match with an anchor that carries its cert: use the
                    // TRUSTED record, not the presented copy, from here on.
                    // The copy's own signature is never checked (it is the
                    // trust point), so its basicConstraints / keyUsage /
                    // pathLen / validity / SAN could be anything the sender
                    // likes -- a forged cert with the root's public key would
                    // otherwise lift the root's real constraints.
                    if how == 1 {
                        let rec = anchor_cert_rec(anchors[ai])
                        if rec != 0 { if cert_ok(rec) == 1 { list_set(certs, k0, rec) } }
                    }
                    ai = len(anchors)
                } else {
                    ai = ai + 1
                }
            }
        }
        k0 = k0 + 1
    }
    if top_i < 0 { let r = list_new() push(r, XV_NOT_PINNED) push(r, 0) return r }

    // 0. every issuer below the trust point must be a CA allowed to sign
    //    certs (RFC 5280 6.1.4): basicConstraints cA=TRUE, keyCertSign if
    //    keyUsage is present, pathLenConstraint respected. Without this, any
    //    end-entity cert from a trusted CA could sign a cert for another host.
    let ci = 1
    while ci <= top_i {
        let iss = certs[ci]
        if cert_is_ca(iss) == 0 { let r = list_new() push(r, XV_NOT_CA) push(r, 0) return r }
        if cert_ku_present(iss) == 1 {
            if cert_ku_cert_sign(iss) == 0 { let r = list_new() push(r, XV_NOT_CA) push(r, 0) return r }
        }
        // certs below this issuer that are themselves CAs = ci - 1
        if cert_path_len(iss) >= 0 {
            if ci - 1 > cert_path_len(iss) { let r = list_new() push(r, XV_NOT_CA) push(r, 0) return r }
        }
        ci = ci + 1
    }

    // 1. names chain and each cert is signed by its parent (RSA or ECDSA).
    let k = 0
    while k < top_i {
        if cert_issued_name_by(certs[k], certs[k + 1]) == 0 {
            let r = list_new() push(r, XV_NAME_CHAIN) push(r, 0) return r
        }
        if cert_verify_under(certs[k], certs[k + 1]) == 0 {
            let r = list_new() push(r, XV_SIG) push(r, 0) return r
        }
        k = k + 1
    }

    // 2 + 3. leaf hostname + validity of every cert up to the trust point.
    let leaf = certs[0]
    if _x509v_host_ok(host, cert_san(leaf)) == 0 {
        let r = list_new() push(r, XV_HOSTNAME) push(r, 0) return r
    }
    let vi = 0
    while vi <= top_i {
        let vc = certs[vi]
        if now < cert_not_before(vc) { let r = list_new() push(r, XV_EXPIRED) push(r, 0) return r }
        if now > cert_not_after(vc)  { let r = list_new() push(r, XV_EXPIRED) push(r, 0) return r }
        vi = vi + 1
    }

    let r = list_new() push(r, XV_OK) push(r, leaf) return r
}

// The anchor's cert record, if the anchor carries one (PEM anchors do).
fn anchor_cert_rec(a) {
    if len(a) > 3 { return a[3] }
    return 0
}

// Is chain cert `c` (at index `depth`, 0 = leaf) a trust point under
// anchor `a`? 1: c's key IS the anchor key; 2: c is issued by the anchor's
// cert (see cert_chain_verify); 0: neither.
fn _x509v_trusted_at(c, a, depth, now) {
    if cert_anchor_match(c, a) == 1 { return 1 }
    let ac = anchor_cert_rec(a)
    if ac == 0 { return 0 }
    if cert_ok(ac) == 0 { return 0 }
    if cert_issued_name_by(c, ac) == 0 { return 0 }
    if cert_is_ca(ac) == 0 { return 0 }
    if cert_ku_present(ac) == 1 {
        if cert_ku_cert_sign(ac) == 0 { return 0 }
    }
    // CA certs below the anchor on this path = depth (certs 1..depth).
    if cert_path_len(ac) >= 0 {
        if depth > cert_path_len(ac) { return 0 }
    }
    if now < cert_not_before(ac) { return 0 }
    if now > cert_not_after(ac) { return 0 }
    if cert_verify_under(c, ac) == 1 { return 2 }
    return 0
}
