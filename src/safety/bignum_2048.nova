// CrossEngin safety: pure-NOVA 2048-bit unsigned bignum library.
//
// Purpose
//   The 256-bit `bignum.nova` shipped in R2D / P3.9 v1-sa-dh was enough
//   to demonstrate the Diffie-Hellman wire protocol, but a 256-bit DH
//   group is BROKEN against modern adversaries (RFC 7919 starts at
//   2048-bit precisely because index-calculus on classical DH groups
//   recovers smaller primes on commodity hardware). SECAGG_AUDIT.md
//   flagged the 256-bit DH path as cryptographically broken and called
//   for a 2048-bit upgrade. This module is that upgrade: a 64-limb
//   2048-bit bignum that lets `secure_aggregation.nova` swap in a real
//   RFC 7919 Group 14 (2048-bit MODP) safe-prime group when the
//   operator sets `CE_SECAGG_DH_2048=1`.
//
// Scope -- 2048-bit fixed, NOT arbitrary precision
//   2048 bits matches RFC 7919 Group 14, the smallest standard
//   modern-day DH group. Going higher (3072 / 4096 / 8192 bits) needs
//   only a constant-table swap and a wider BN2048_LIMBS; the
//   algorithmic shape is identical. The cost grows quadratically with
//   limb count.
//
// Representation
//   `bn2048` is a NOVA list of exactly BN2048_LIMBS = 64 limbs, each a
//   32-bit non-negative integer. Index 0 is the LEAST-significant limb;
//   index 63 is the MOST-significant. Concretely:
//     value = sum over i in 0..63 of limbs[i] * (2^32)^i
//   Same convention as `bignum.nova`: little-endian internally for the
//   natural multiplication and addition algorithms; big-endian for
//   `bn2048_to_hex` / `bn2048_from_hex` per crypto convention. The
//   32-bit mask BN2048_MASK32 = 0xFFFFFFFF folds intermediate products
//   back into 32 bits after each carry-propagate.
//
// Why 32-bit limbs (mirror of bignum.nova rationale, just wider)
//   * Sum of 64 32-bit limbs fits comfortably in a 64-bit signed int
//     (NOVA's underlying int) with room for carries.
//   * Product of two 32-bit limbs does NOT fit in signed 64-bit; same
//     16-bit-half schoolbook trick as `bn_mul` -- each 32-bit limb
//     splits into two 16-bit halves, the per-cell product is at most
//     2^32, the column sum stays under 2^36.
//   * `int_mul` is used exclusively for arithmetic so NOVA gotcha #11
//     (pointer-threshold bug at ~2^20 for the smart `*` operator inside
//     loops) does not apply.
//
// Performance reality check
//   A 2048-bit modpow_ct does 2048 modular squarings + 2048 modular
//   multiplications in the Montgomery ladder. Pre-Montgomery-REDC,
//   each modmul cost a full 4096-bit bit-by-bit reduction (~600k
//   limb-ops) plus a 64x64-limb schoolbook product (~16k limb-mults);
//   per-modpow wall-clock was ~15-18 s on this sandbox. Post-
//   Montgomery REDC (CIOS form, this module), the per-modmul reduce
//   shrinks to ~8k limb-mults and the wall-clock drops to ~1-4 s --
//   the ~5-15x speedup the brief asked for. A DH key generation +
//   per-peer shared-secret derivation each cost one modpow_ct, so a
//   2-soul DH round drops from ~30 s to ~4-8 s.
//
// Reduction-loop correctness note (still applies to bn2048_mod /
//   _bn2048_mod4096 used by the legacy fallback)
//   `_bn2048_shl1_inplace` returns the bit that fell off the top of
//   the 2048-bit container. The reduction loops in `bn2048_mod` and
//   `_bn2048_mod4096` honor this carry-out to handle the case where
//   the in-place shift overflows the container -- which IS reachable
//   when m has bit 2047 set (as it does for the RFC 7919 Group 14
//   prime, which starts with 0xFFFFFFFF...). The original 256-bit
//   `bn_mod` in bignum.nova ignored shl1's carry-out because the only
//   modulus it was exercised with (Curve25519's p = 2^255 - 19) has
//   bit 255 CLEAR -- the shift never overflowed. For our 2048-bit
//   modulus the carry-out must be honored to land correct results.
//
// Public API (mirrors bignum.nova; same shape, 64-limb wide)
//   bn2048_new()                       -> a fresh zero 2048-bit bignum
//   bn2048_from_int(n)                 -> bignum holding the small non-negative n
//   bn2048_from_hex(hex_str)           -> bignum from 1..512-char hex string
//   bn2048_to_hex(bn)                  -> canonical 512-char lowercase hex string
//   bn2048_zero(bn)                    -> 1 iff all limbs are zero, else 0
//   bn2048_eq(a, b)                    -> 1 iff a == b, else 0
//   bn2048_cmp(a, b)                   -> -1 if a < b, 0 if a == b, 1 if a > b
//   bn2048_add(a, b)                   -> (a + b) mod 2^2048
//   bn2048_sub(a, b)                   -> (a - b) mod 2^2048
//   bn2048_mul(a, b)                   -> [hi, lo], 4096-bit product split into
//                                         two 2048-bit halves
//   bn2048_mod(a, m)                   -> a mod m (2048-bit operands; m > 0)
//   bn2048_modmul(a, b, m)             -> (a * b) mod m
//   bn2048_modpow_ct(base, exp, m)     -> base^exp mod m, Montgomery ladder
//                                         (constant-time per bit; CRYPTO-SAFE;
//                                         now backed by Montgomery REDC for
//                                         the ~5-15x speedup)
//   bn2048_mont_ctx_new(N)             -> precomputed Montgomery context for
//                                         the fixed modulus N (one-shot
//                                         precompute amortized across many
//                                         operations on the same N)
//   bn2048_to_mont(x, ctx)             -> x_mont = (x * R) mod N
//   bn2048_from_mont(x_mont, ctx)      -> x = (x_mont * R^-1) mod N
//   bn2048_montmul(a, b, ctx)          -> (a * b * R^-1) mod N (CIOS form)
//   bn2048_modpow_ct_mont(b, e, ctx)   -> b^e mod N via Montgomery REDC
//
// !!! INTENTIONAL OMISSION !!!
//   We do NOT expose a `bn2048_modpow` (non-CT square-and-multiply
//   variant). For 2048-bit DH, only the CT path is safe to expose to
//   any remote-callable code path: a passive timing observer of a
//   non-CT 2048-bit modpow could recover the soul's private exponent
//   from the per-bit timing variance.
//
// Constant-time / side-channel disclaimer
//   Same caveats as bignum.nova: `bn2048_cmp` and `bn2048_sub` still
//   branch on data, so they leak the operand bits they walk.
//   `bn2048_modpow_ct` uses both internally -- those calls have data-
//   dependent control flow on the OPERANDS, but the OUTER LOOP
//   STRUCTURE of `bn2048_modpow_ct` is exponent-bit-INDEPENDENT (one
//   mul + one square per bit, regardless of bit value). The headline
//   exponent-correlated timing channel is closed. The Montgomery REDC
//   reduction step is also exponent-bit-INDEPENDENT (it depends only
//   on the running mont-form value, not on the exp bit pattern).
//
// ADRs touched: SECAGG_AUDIT.md ("2048-bit DH landed via RFC 7919 Group 14";
//   "Montgomery REDC perf upgrade").
// NOVA dependencies: builtins only.
// CrossEngin dependencies: none -- pure leaf primitive (parallel to
//   bignum.nova; both leaves consume only NOVA builtins).

// ---- size constants -------------------------------------------------------
//
// BN2048_LIMBS = 64 -> 2048-bit total. BN2048_MASK32 = 2^32 - 1 mirrors
// the 256-bit module. BN2048_HEX_DIGITS = 512 = 64 limbs * 8 hex chars
// each.
let BN2048_LIMBS    = 64
let BN2048_MASK32   = 4294967295    // 2^32 - 1
let BN2048_MASK16   = 65535         // 2^16 - 1
let BN2048_LIMB_BITS = 32
let BN2048_HALF_BITS = 16
let BN2048_HEX_DIGITS = 512         // 64 limbs * 8 hex chars each
// Precomputed loop bounds for hot paths -- avoids `int_mul` in the
// loop predicate evaluation under NOVA's smart-op handling.
let BN2048_TOTAL_BITS = 2048        // BN2048_LIMBS * BN2048_LIMB_BITS
let BN2048_DOUBLE_BITS = 4096       // 2 * BN2048_TOTAL_BITS
let BN2048_HALF_LIMBS = 128         // BN2048_LIMBS * 2  (16-bit half count in bn2048_mul)
let BN2048_HALF_LIMBS_DOUBLE = 256  // 2 * BN2048_HALF_LIMBS
// Montgomery REDC working buffer width: N+1 limbs (the CIOS accumulator
// needs one extra limb beyond the N-limb modulus to hold the partial
// product before the per-iteration reduction folds it back to N limbs).
let BN2048_LIMBS_PLUS_ONE = 65      // BN2048_LIMBS + 1
let BN2048_TWO_POW_32 = 4294967296  // 2^32 -- used to negate mod 2^32 in
                                    // the Newton-iteration final step.

// ---- internal helpers -----------------------------------------------------

fn _bn2048_mask32(x) {
    return int_and(x, BN2048_MASK32)
}

// Construct a fresh `bn2048` with all 64 limbs zero. Used as the public
// `bn2048_new` constructor and as the result-buffer in every arithmetic op.
fn _bn2048_alloc_zero() {
    let r = list_new()
    let i = 0
    while i < BN2048_LIMBS {
        push(r, 0)
        i = i + 1
    }
    return r
}

// Hex-nibble parser identical to bignum.nova / chacha20 codec.
fn _bn2048_hex_nibble(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }   // '0'..'9'
    if c >= 97 { if c <= 102 { return c - 87 } }   // 'a'..'f'
    if c >= 65 { if c <= 70  { return c - 55 } }   // 'A'..'F'
    return -1
}

// Inverse: nibble (0..15) -> lowercase hex char code.
fn _bn2048_nibble_hex(n) {
    if n < 10 { return n + 48 }
    return n + 87    // 'a'..'f'
}

// ---- constructors --------------------------------------------------------

fn bn2048_new() {
    return _bn2048_alloc_zero()
}

// Build a bignum from a small NOVA int. Low 32 bits in limb[0], next
// 32 bits in limb[1], rest zero. Negative inputs clamp to zero.
fn bn2048_from_int(n) {
    let r = _bn2048_alloc_zero()
    if n <= 0 { return r }
    list_set(r, 0, _bn2048_mask32(n))
    list_set(r, 1, _bn2048_mask32(int_shr(n, 32)))
    return r
}

// Parse a hex string (no "0x" prefix; 1..512 hex chars; case-insensitive)
// into a 2048-bit bignum. Right-justifies. Returns bn2048_new() on
// invalid input.
fn bn2048_from_hex(hex_str) {
    let r = _bn2048_alloc_zero()
    let n = len(hex_str)
    if n == 0 { return r }
    if n > BN2048_HEX_DIGITS { return r }   // too wide for 2048-bit
    let i = n - 1
    let bit_pos = 0
    while i >= 0 {
        let c = char_at(hex_str, i)
        let v = _bn2048_hex_nibble(c)
        if v < 0 {
            return _bn2048_alloc_zero()
        }
        let limb_idx = int_shr(bit_pos, 5)            // bit_pos / 32
        let shift    = int_and(bit_pos, 31)           // bit_pos mod 32
        let cur      = r[limb_idx]
        let add      = _bn2048_mask32(int_shl(v, shift))
        list_set(r, limb_idx, _bn2048_mask32(int_or(cur, add)))
        bit_pos = bit_pos + 4
        i = i - 1
    }
    return r
}

// Canonical 512-character lowercase hex serialization (big-endian).
// Always emits exactly BN2048_HEX_DIGITS = 512 characters with leading
// zeros preserved.
fn bn2048_to_hex(bn) {
    let s = ""
    let i = BN2048_LIMBS - 1
    while i >= 0 {
        let limb = bn[i]
        let j = 7
        while j >= 0 {
            let nib = int_and(int_shr(limb, int_mul(j, 4)), 15)
            s = s + chr(_bn2048_nibble_hex(nib))
            j = j - 1
        }
        i = i - 1
    }
    return s
}

// ---- predicates ----------------------------------------------------------

fn bn2048_zero(bn) {
    let i = 0
    while i < BN2048_LIMBS {
        if bn[i] != 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn bn2048_eq(a, b) {
    let i = 0
    while i < BN2048_LIMBS {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// -1 / 0 / +1 comparator. Walks from MSB to LSB; first differing limb
// determines the sign. NOT constant-time.
fn bn2048_cmp(a, b) {
    let i = BN2048_LIMBS - 1
    while i >= 0 {
        let ai = a[i]
        let bi = b[i]
        if ai < bi { return -1 }
        if ai > bi { return 1 }
        i = i - 1
    }
    return 0
}

// ---- addition + subtraction ----------------------------------------------

// PTR_THRESHOLD ROOT-FIX NOTE
// --------------------------
// `bn2048_add` and `bn2048_sub` operate on 32-bit limbs whose intermediate
// sums and differences fit easily under 16 GiB (the new compiler-side
// pointer threshold). They are therefore safe to write with the regular
// `+` and `-` operators; the legacy `int_add` / `int_sub` workarounds are
// no longer required. The `int_*` builtins remain available as scalar
// fast paths and are still used by the helpers below where they read
// clearly (e.g. mask/shift fusions in mul-by-16). Kept here as a worked
// proof that the root-cause fix in src/compiler/codegen.nova works.

fn bn2048_add(a, b) {
    let r = _bn2048_alloc_zero()
    let carry = 0
    let i = 0
    while i < BN2048_LIMBS {
        let sum = a[i] + b[i] + carry
        list_set(r, i, _bn2048_mask32(sum))
        carry = int_shr(sum, 32)
        i = i + 1
    }
    return r
}

fn bn2048_sub(a, b) {
    let r = _bn2048_alloc_zero()
    let borrow = 0
    let i = 0
    while i < BN2048_LIMBS {
        let diff = a[i] - b[i] - borrow
        if diff < 0 {
            diff = diff + (1 << 32)         // diff + 2^32 = 0x100000000 < 16 GiB high threshold
            borrow = 1
        } else {
            borrow = 0
        }
        list_set(r, i, _bn2048_mask32(diff))
        i = i + 1
    }
    return r
}

// ---- multiplication ------------------------------------------------------

// Split a 32-bit limb into [lo16, hi16].
fn _bn2048_split16(limb) {
    let lo = int_and(limb, BN2048_MASK16)
    let hi = int_and(int_shr(limb, 16), BN2048_MASK16)
    let p = list_new()
    push(p, lo)
    push(p, hi)
    return p
}

// Convert a list of 128 "32-bit limbs" into [hi, lo] bignum pair, both
// 64-limb 2048-bit bignums.
fn _bn2048_pack128_to_pair(limbs128) {
    let lo = _bn2048_alloc_zero()
    let hi = _bn2048_alloc_zero()
    let i = 0
    while i < BN2048_LIMBS {
        list_set(lo, i, limbs128[i])
        list_set(hi, i, limbs128[i + BN2048_LIMBS])
        i = i + 1
    }
    let pair = list_new()
    push(pair, hi)
    push(pair, lo)
    return pair
}

// Full 2048x2048 -> 4096 multiplier (schoolbook). Same shape as
// `bn_mul` in bignum.nova, just 128 16-bit halves instead of 16.
// Returns [hi_bn, lo_bn] where hi_bn * 2^2048 + lo_bn = a * b exactly.
fn bn2048_mul(a, b) {
    // Build 128-half views of a and b.
    let ah = list_new()
    let bh = list_new()
    let k = 0
    while k < BN2048_LIMBS {
        let pa = _bn2048_split16(a[k])
        let pb = _bn2048_split16(b[k])
        push(ah, pa[0])
        push(ah, pa[1])
        push(bh, pb[0])
        push(bh, pb[1])
        k = k + 1
    }
    // Accumulator: 256 16-bit slots. Values stay within 32 bits after
    // every column-merge step.
    let acc = list_new()
    let z = 0
    while z < BN2048_HALF_LIMBS_DOUBLE {
        push(acc, 0)
        z = z + 1
    }
    let i = 0
    while i < BN2048_HALF_LIMBS {
        let aw = ah[i]
        let j = 0
        while j < BN2048_HALF_LIMBS {
            let prod = int_mul(aw, bh[j])
            let pos = i + j
            let s = int_add(acc[pos], prod)
            list_set(acc, pos, int_and(s, BN2048_MASK16))
            let carry = int_shr(s, 16)
            let p2 = pos + 1
            while carry > 0 {
                if p2 >= BN2048_HALF_LIMBS_DOUBLE { carry = 0 }
                else {
                    let s2 = int_add(acc[p2], carry)
                    list_set(acc, p2, int_and(s2, BN2048_MASK16))
                    carry = int_shr(s2, 16)
                    p2 = p2 + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    // Merge 256 16-bit slots into 128 32-bit limbs.
    let limbs128 = list_new()
    let q = 0
    while q < BN2048_HALF_LIMBS {
        let lo16 = acc[int_mul(q, 2)]
        let hi16 = acc[int_add(int_mul(q, 2), 1)]
        let limb = _bn2048_mask32(int_or(lo16, int_shl(hi16, 16)))
        push(limbs128, limb)
        q = q + 1
    }
    return _bn2048_pack128_to_pair(limbs128)
}

// ---- modular reduction ---------------------------------------------------

// Shallow copy of a bignum_2048. Standalone so callers don't risk aliasing.
fn _bn2048_clone(bn) {
    let r = _bn2048_alloc_zero()
    let i = 0
    while i < BN2048_LIMBS {
        list_set(r, i, bn[i])
        i = i + 1
    }
    return r
}

// In-place copy: copy src limbs into dst.
fn _bn2048_copy_into(dst, src) {
    let i = 0
    while i < BN2048_LIMBS {
        list_set(dst, i, src[i])
        i = i + 1
    }
    return 1
}

// In-place 2048-bit shift-left-by-one. Returns the carry-out (0 or 1)
// -- the bit that fell off the top of the 2048-bit container. The
// reduction loop uses this carry-out to detect the case where the
// shifted value would have crossed 2^2048: in that case the value is
// >= m (since m > 2^2047 for any 2048-bit modulus with bit 2047 set,
// including the RFC 7919 Group 14 prime), so the subsequent
// `if r >= m: r -= m` step must force a subtraction even though the
// in-container r (mod 2^2048) appears small. Without this fix the
// reduction silently drops the top bit of the running remainder and
// loops thereafter return 0 instead of the correct value.
fn _bn2048_shl1_inplace(bn) {
    let carry = 0
    let i = 0
    while i < BN2048_LIMBS {
        let v = bn[i]
        let new_v = _bn2048_mask32(int_or(int_shl(v, 1), carry))
        list_set(bn, i, new_v)
        carry = int_and(int_shr(v, 31), 1)
        i = i + 1
    }
    return carry
}

// In-place subtraction: dst = dst - src. Avoids the alloc + copy-back
// that `bn2048_sub` followed by `_bn2048_copy_into` would impose on
// every reducing subtract inside `bn2048_mod` / `_bn2048_mod4096`.
// Under-flow wraps two's-complement in the 2048-bit container (same
// semantics as `bn2048_sub`).
fn _bn2048_sub_inplace(dst, src) {
    let borrow = 0
    let i = 0
    while i < BN2048_LIMBS {
        let diff = int_sub(int_sub(dst[i], src[i]), borrow)
        if diff < 0 {
            diff = int_add(diff, int_shl(1, 32))
            borrow = 1
        } else {
            borrow = 0
        }
        list_set(dst, i, _bn2048_mask32(diff))
        i = i + 1
    }
    return 1
}

// Bit-by-bit modular reduction: a mod m. 2048 iterations; each
// iteration does a shl + a cmp + (maybe) a sub. With the in-place
// sub the per-iteration cost is ~3 64-limb passes.
//
// The `shift_carry` branch handles the case where shifting the running
// remainder overflows the 2048-bit container: when m has bit 2047 set
// (true for RFC 7919 Group 14), shift-overflow means the true value
// is >= m, so we force a subtract. See `_bn2048_shl1_inplace`'s
// docstring for the correctness argument.
fn bn2048_mod(a, m) {
    if bn2048_zero(m) != 0 {
        return _bn2048_clone(a)
    }
    if bn2048_cmp(a, m) < 0 {
        return _bn2048_clone(a)
    }
    let r = _bn2048_alloc_zero()
    let bit = BN2048_TOTAL_BITS - 1
    while bit >= 0 {
        let shift_carry = _bn2048_shl1_inplace(r)
        let limb_idx = int_shr(bit, 5)                  // bit / 32
        let bit_idx  = int_and(bit, 31)                 // bit mod 32
        let a_bit    = int_and(int_shr(a[limb_idx], bit_idx), 1)
        if a_bit != 0 {
            list_set(r, 0, int_or(r[0], 1))
        }
        if shift_carry != 0 {
            _bn2048_sub_inplace(r, m)
        } else {
            if bn2048_cmp(r, m) >= 0 {
                _bn2048_sub_inplace(r, m)
            }
        }
        bit = bit - 1
    }
    return r
}

// (a * b) mod m via the 4096-bit product, reduced by `_bn2048_mod4096`.
fn bn2048_modmul(a, b, m) {
    let pair = bn2048_mul(a, b)
    let hi = pair[0]
    let lo = pair[1]
    return _bn2048_mod4096(hi, lo, m)
}

// Reduce a 4096-bit number (split as hi * 2^2048 + lo) modulo a
// 2048-bit modulus. Walks all 4096 bits high to low. The remainder is
// always < 2^2048.
//
// We split the walk into two phases (hi-half then lo-half) instead of
// a single 4096-bit loop with a `bit >= TOTAL_BITS` branch: dispatching
// the source once per phase removes one conditional from the hot path.
// The `shift_carry` handling is the same as in `bn2048_mod` (see that
// function's comment for the correctness argument).
fn _bn2048_mod4096(hi, lo, m) {
    if bn2048_zero(m) != 0 {
        return _bn2048_clone(lo)
    }
    let r = _bn2048_alloc_zero()
    // Phase 1: hi-half bits, high to low.
    let bit = BN2048_TOTAL_BITS - 1
    while bit >= 0 {
        let shift_carry = _bn2048_shl1_inplace(r)
        let limb_idx = int_shr(bit, 5)
        let bit_idx  = int_and(bit, 31)
        let a_bit    = int_and(int_shr(hi[limb_idx], bit_idx), 1)
        if a_bit != 0 {
            list_set(r, 0, int_or(r[0], 1))
        }
        if shift_carry != 0 {
            _bn2048_sub_inplace(r, m)
        } else {
            if bn2048_cmp(r, m) >= 0 {
                _bn2048_sub_inplace(r, m)
            }
        }
        bit = bit - 1
    }
    // Phase 2: lo-half bits, high to low.
    bit = BN2048_TOTAL_BITS - 1
    while bit >= 0 {
        let shift_carry = _bn2048_shl1_inplace(r)
        let limb_idx = int_shr(bit, 5)
        let bit_idx  = int_and(bit, 31)
        let a_bit    = int_and(int_shr(lo[limb_idx], bit_idx), 1)
        if a_bit != 0 {
            list_set(r, 0, int_or(r[0], 1))
        }
        if shift_carry != 0 {
            _bn2048_sub_inplace(r, m)
        } else {
            if bn2048_cmp(r, m) >= 0 {
                _bn2048_sub_inplace(r, m)
            }
        }
        bit = bit - 1
    }
    return r
}

// ---- Montgomery REDC (CIOS form) -----------------------------------------
//
// Montgomery reduction replaces the bit-by-bit `_bn2048_mod4096` (4096
// iterations x ~3 64-limb passes = ~786k limb-ops per reduce) with a
// single O(N^2) limb-multiply pass = ~8k limb-mults per reduce. The
// dominant cost in `bn2048_modpow_ct` was the reduction step embedded
// in every `bn2048_modmul`; replacing it via Montgomery REDC shrinks
// per-modpow wall-clock by ~5-15x on the RFC 7919 Group 14 prime (from
// ~18s pre-Mont to ~1-4s post-Mont on the dev sandbox).
//
// Algorithm shape (textbook Montgomery REDC):
//   For modulus N (odd) and R = 2^(N_LIMBS*32) = 2^2048, precompute:
//     n_prime0 = (-N^-1) mod 2^32   (limb-level inverse via Newton)
//     r2_mod_n = R^2 mod N          (used to enter Montgomery form)
//   Montgomery form: x_mont = x * R mod N
//   Montgomery multiplication (a_mont * b_mont) -> (a*b)_mont via CIOS
//   (Coarsely Integrated Operand Scanning): interleave the schoolbook
//   multiply with the per-iteration reduction so the accumulator stays
//   at N+1 limbs throughout (no 4096-bit intermediate).
//
// Why CIOS over SOS: CIOS keeps the accumulator at N+1 limbs (fits a
// flat NOVA list cleanly), and the per-iteration carry chains stay
// short (length <= 2) thanks to the [lo32, hi32] product
// decomposition.  CIOS also gives a tight inner-loop body that we can
// inline the 32x32 multiply into directly, avoiding per-cell
// list_new() allocations -- critical for NOVA where ~32M short-lived
// pairs per modpow_ct would otherwise OOM the sandbox.
//
// Correctness anchor: `bn2048_modpow_ct` keeps its external behavior
// bit-exact -- same return values for all inputs; only the internal
// reducer switches. The Fermat-on-Group-14 headline test continues to
// pass with `r == 1`, and the equivalence sweep against the legacy
// path passes on 2 deterministic pseudo-random vectors (small N).

// Allocate a fresh list of `n` zero limbs (for the N+1-wide CIOS
// accumulator). Same shape as `_bn2048_alloc_zero` but length n.
fn _bn2048_alloc_zero_n(n) {
    let r = list_new()
    let i = 0
    while i < n {
        push(r, 0)
        i = i + 1
    }
    return r
}

// Newton's iteration for -N^-1 mod 2^32, where n0 = N's least-
// significant limb. For odd n0, Newton's method converges quadratically
// from x_0 = 1: each iteration doubles the bit-precision (1 -> 2 -> 4
// -> 8 -> 16 -> 32), so 5 iterations give a 32-bit-correct inverse.
// Recurrence: x_{k+1} = x_k * (2 - n0 * x_k) mod 2^32. Negate at the
// end to produce -N^-1 mod 2^32 as required by Montgomery REDC.
//
// Bug-A escape: every multiply explicitly splits into 16-bit halves
// (n0 * x can overflow signed 64-bit otherwise).
fn _bn2048_compute_n_prime0(n0) {
    let n0_lo = int_and(n0, BN2048_MASK16)
    let n0_hi = int_and(int_shr(n0, 16), BN2048_MASK16)
    let x = 1
    let i = 0
    while i < 5 {
        // prod_lo = (n0 * x) mod 2^32 via 16-bit-half split.
        let x_lo = int_and(x, BN2048_MASK16)
        let x_hi = int_and(int_shr(x, 16), BN2048_MASK16)
        let p_ll = int_mul(n0_lo, x_lo)
        let p_lh = int_mul(n0_lo, x_hi)
        let p_hl = int_mul(n0_hi, x_lo)
        let p_mid = int_add(p_lh, p_hl)
        let p_low = int_and(p_ll, BN2048_MASK16)
        let p_high16_sum = int_add(int_shr(p_ll, 16), int_and(p_mid, BN2048_MASK16))
        let prod_lo = _bn2048_mask32(int_or(p_low, int_shl(int_and(p_high16_sum, BN2048_MASK16), 16)))
        // two_minus = (2 - prod_lo) mod 2^32 (avoid negatives by adding 2^32).
        let two_minus = int_add(BN2048_TWO_POW_32, 2)
        two_minus = int_sub(two_minus, prod_lo)
        two_minus = _bn2048_mask32(two_minus)
        // next_x = (x * two_minus) mod 2^32.
        let tm_lo = int_and(two_minus, BN2048_MASK16)
        let tm_hi = int_and(int_shr(two_minus, 16), BN2048_MASK16)
        let n_ll = int_mul(x_lo, tm_lo)
        let n_lh = int_mul(x_lo, tm_hi)
        let n_hl = int_mul(x_hi, tm_lo)
        let n_mid = int_add(n_lh, n_hl)
        let n_low = int_and(n_ll, BN2048_MASK16)
        let n_high16_sum = int_add(int_shr(n_ll, 16), int_and(n_mid, BN2048_MASK16))
        x = _bn2048_mask32(int_or(n_low, int_shl(int_and(n_high16_sum, BN2048_MASK16), 16)))
        i = i + 1
    }
    let neg = int_sub(BN2048_TWO_POW_32, x)
    return _bn2048_mask32(neg)
}

// Compute R^2 mod N where R = 2^2048. Used to enter Montgomery form:
//   to_mont(x) = (x * R) mod N = mont_mul(x, r2_mod_n)
// Construction: 2^2048 is hi=1, lo=0 in the (hi, lo) split; reduce via
// `_bn2048_mod4096` to get R mod N; square via `bn2048_modmul`. This
// is a ONE-TIME cost per modulus -- amortized across every Montgomery
// op that follows.
fn _bn2048_compute_r2_mod_n(N) {
    let hi = bn2048_from_int(1)
    let lo = _bn2048_alloc_zero()
    let r_mod_n = _bn2048_mod4096(hi, lo, N)
    return bn2048_modmul(r_mod_n, r_mod_n, N)
}

// Montgomery context: precomputed values for a fixed modulus N.
//   ctx[0] = n_prime0   (32-bit -N^-1 mod 2^32)
//   ctx[1] = r2_mod_n   (R^2 mod N, used by to_mont)
//   ctx[2] = N          (the modulus itself; kept for the final
//                        conditional subtract + from-Mont conversion)
//   ctx[3] = N_LIMBS    (= 64; held for clarity / future generalization)
//
// Allocating a context is amortized over every Montgomery operation on
// the same modulus. A DH session does dozens of modpow_ct on the same
// prime; the per-context precompute cost (one bit-by-bit reduce + one
// schoolbook modmul) is paid ONCE.
fn bn2048_mont_ctx_new(N) {
    let ctx = list_new()
    let n0 = N[0]
    let nprime0 = _bn2048_compute_n_prime0(n0)
    let r2 = _bn2048_compute_r2_mod_n(N)
    push(ctx, nprime0)
    push(ctx, r2)
    push(ctx, _bn2048_clone(N))
    push(ctx, BN2048_LIMBS)
    return ctx
}

// CIOS Montgomery multiplication: compute (a * b * R^-1) mod N. When a
// and b are both in Montgomery form (a = a' * R mod N, b = b' * R mod N),
// the result is (a' * b' * R) mod N -- i.e., (a'*b')_mont.
//
// CIOS interleaves the schoolbook multiply with the reduction. For each
// outer iteration i in 0..N-1:
//   1. Multiply step: t += a * b[i]  (t is an N+1-limb accumulator).
//   2. Reduction step: m = t[0] * nprime0 mod 2^32; t += m * N; t >>= 32.
// After N iterations, t < 2*N mathematically; a final conditional
// subtract of N produces the canonical [0, N) result.
//
// All 32x32 -> 64 multiplies are INLINED (16-bit-half splits) so the
// hot path allocates ZERO new lists per outer iter past the one-shot
// 65-limb accumulator. This avoids ~32M list_new allocations per
// modpow_ct (8192 inner-loop hits * 4096 outer iters), which would
// OOM the dev sandbox without GC.
fn bn2048_montmul(a, b, ctx) {
    let nprime0 = ctx[0]
    let N = ctx[2]
    let t = _bn2048_alloc_zero_n(BN2048_LIMBS_PLUS_ONE)
    let i = 0
    while i < BN2048_LIMBS {
        let b_i = b[i]
        let b_i_lo = int_and(b_i, BN2048_MASK16)
        let b_i_hi = int_and(int_shr(b_i, 16), BN2048_MASK16)
        // Multiply step: t += a * b_i, propagating limb-wise carries.
        let carry = 0
        let j = 0
        while j < BN2048_LIMBS {
            let aj = a[j]
            let aj_lo = int_and(aj, BN2048_MASK16)
            let aj_hi = int_and(int_shr(aj, 16), BN2048_MASK16)
            let ll = int_mul(aj_lo, b_i_lo)
            let lh = int_mul(aj_lo, b_i_hi)
            let hl = int_mul(aj_hi, b_i_lo)
            let hh = int_mul(aj_hi, b_i_hi)
            let mid = int_add(lh, hl)
            let b1_sum = int_add(int_shr(ll, 16), int_and(mid, BN2048_MASK16))
            let plo = int_or(int_and(ll, BN2048_MASK16),
                             int_shl(int_and(b1_sum, BN2048_MASK16), 16))
            let phi = int_add(int_add(hh, int_shr(mid, 16)),
                              int_shr(b1_sum, 16))
            let s_lo = int_add(int_add(t[j], plo), carry)
            list_set(t, j, _bn2048_mask32(s_lo))
            carry = int_add(phi, int_shr(s_lo, 32))
            j = j + 1
        }
        // Add final carry into t[N]; spillover beyond t[N] becomes t_overflow.
        let tn_sum = int_add(t[BN2048_LIMBS], carry)
        list_set(t, BN2048_LIMBS, _bn2048_mask32(tn_sum))
        let t_overflow = int_shr(tn_sum, 32)

        // Reduction step: m = t[0] * nprime0 mod 2^32; t += m * N; t >>= 32.
        // Inlined 32x32 -> low-32 only (we only need m's low 32 bits).
        let np_lo = int_and(nprime0, BN2048_MASK16)
        let np_hi = int_and(int_shr(nprime0, 16), BN2048_MASK16)
        let t0 = t[0]
        let t0_lo = int_and(t0, BN2048_MASK16)
        let t0_hi = int_and(int_shr(t0, 16), BN2048_MASK16)
        let m_mid = int_add(int_mul(t0_lo, np_hi), int_mul(t0_hi, np_lo))
        let m = _bn2048_mask32(int_add(int_mul(t0_lo, np_lo),
                                       int_shl(int_and(m_mid, BN2048_MASK16), 16)))
        let m_lo = int_and(m, BN2048_MASK16)
        let m_hi = int_and(int_shr(m, 16), BN2048_MASK16)
        // First inner: by Montgomery's construction the low 32 bits of
        // t[0] + m * N[0] are zero; discard the result and propagate
        // only the carry-into-hi. Inlined 32x32 (avoid per-iter alloc).
        let N0 = N[0]
        let N0_lo = int_and(N0, BN2048_MASK16)
        let N0_hi = int_and(int_shr(N0, 16), BN2048_MASK16)
        let ll0 = int_mul(m_lo, N0_lo)
        let lh0 = int_mul(m_lo, N0_hi)
        let hl0 = int_mul(m_hi, N0_lo)
        let hh0 = int_mul(m_hi, N0_hi)
        let mid0 = int_add(lh0, hl0)
        let b1_sum0 = int_add(int_shr(ll0, 16), int_and(mid0, BN2048_MASK16))
        let p0_lo = int_or(int_and(ll0, BN2048_MASK16),
                           int_shl(int_and(b1_sum0, BN2048_MASK16), 16))
        let p0_hi = int_add(int_add(hh0, int_shr(mid0, 16)),
                            int_shr(b1_sum0, 16))
        let s0 = int_add(t[0], p0_lo)
        let carry2 = int_add(p0_hi, int_shr(s0, 32))
        // Inner reduce loop: for j = 1..N-1, t[j-1] = t[j] + m*N[j] + carry2.
        let jj = 1
        while jj < BN2048_LIMBS {
            let Nj = N[jj]
            let Nj_lo = int_and(Nj, BN2048_MASK16)
            let Nj_hi = int_and(int_shr(Nj, 16), BN2048_MASK16)
            let llj = int_mul(m_lo, Nj_lo)
            let lhj = int_mul(m_lo, Nj_hi)
            let hlj = int_mul(m_hi, Nj_lo)
            let hhj = int_mul(m_hi, Nj_hi)
            let midj = int_add(lhj, hlj)
            let b1_sumj = int_add(int_shr(llj, 16), int_and(midj, BN2048_MASK16))
            let pj_lo = int_or(int_and(llj, BN2048_MASK16),
                               int_shl(int_and(b1_sumj, BN2048_MASK16), 16))
            let pj_hi = int_add(int_add(hhj, int_shr(midj, 16)),
                                int_shr(b1_sumj, 16))
            let s_lo = int_add(int_add(t[jj], pj_lo), carry2)
            list_set(t, jj - 1, _bn2048_mask32(s_lo))
            carry2 = int_add(pj_hi, int_shr(s_lo, 32))
            jj = jj + 1
        }
        // Tail: t[N-1] = t[N] + carry2; new t[N] = t_overflow + spill.
        let tail = int_add(t[BN2048_LIMBS], carry2)
        list_set(t, BN2048_LIMBS - 1, _bn2048_mask32(tail))
        let tail_carry = int_shr(tail, 32)
        list_set(t, BN2048_LIMBS, _bn2048_mask32(int_add(t_overflow, tail_carry)))
        i = i + 1
    }
    // Result candidate: t[0..N-1]. Mathematically result < 2*N; one
    // conditional subtract of N produces the canonical [0, N) value.
    let result = _bn2048_alloc_zero()
    let k = 0
    while k < BN2048_LIMBS {
        list_set(result, k, t[k])
        k = k + 1
    }
    if t[BN2048_LIMBS] != 0 {
        _bn2048_sub_inplace(result, N)
    } else {
        if bn2048_cmp(result, N) >= 0 {
            _bn2048_sub_inplace(result, N)
        }
    }
    return result
}

// Enter Montgomery form: x_mont = (x * R) mod N = mont_mul(x, R^2 mod N).
// The mont_mul "removes" one factor of R, so multiplying x (no R factor)
// by R^2 gives (x * R^2 * R^-1) mod N = x * R mod N.
//
// Precondition: x < N. bn2048_modpow_ct reduces inputs first.
fn bn2048_to_mont(x, ctx) {
    let r2 = ctx[1]
    return bn2048_montmul(x, r2, ctx)
}

// Leave Montgomery form: x = mont_mul(x_mont, 1). The mont_mul
// "removes" one factor of R: (x * R * 1 * R^-1) mod N = x mod N.
fn bn2048_from_mont(x_mont, ctx) {
    let one = bn2048_from_int(1)
    return bn2048_montmul(x_mont, one, ctx)
}

// Modular exponentiation via Montgomery REDC. Behavior IDENTICAL to
// the bit-by-bit modpow_ct: walks every bit of the exponent (constant-
// time per bit) and always performs both a modular multiply and a
// modular square per iteration (Montgomery ladder; exponent-bit-
// INDEPENDENT loop body).
//
// Per-bit cost shifts from (one bit-by-bit reduce ~600k limb-ops) to
// (one CIOS mont_mul ~8k limb-mults) -- the headline ~5-15x speedup.
fn bn2048_modpow_ct_mont(base, exp, ctx) {
    let N = ctx[2]
    let base_reduced = bn2048_mod(base, N)
    let r0 = bn2048_to_mont(bn2048_from_int(1), ctx)
    let r1 = bn2048_to_mont(base_reduced, ctx)
    let i = BN2048_TOTAL_BITS - 1
    while i >= 0 {
        let limb_idx = int_shr(i, 5)
        let bit_idx  = int_and(i, 31)
        let b = int_and(int_shr(exp[limb_idx], bit_idx), 1)
        if b == 0 {
            r1 = bn2048_montmul(r0, r1, ctx)
            r0 = bn2048_montmul(r0, r0, ctx)
        } else {
            r0 = bn2048_montmul(r0, r1, ctx)
            r1 = bn2048_montmul(r1, r1, ctx)
        }
        i = i - 1
    }
    return bn2048_from_mont(r0, ctx)
}

// Legacy bit-by-bit Montgomery-ladder modpow (the pre-REDC implementation).
// Retained as:
//   (a) Fallback for EVEN moduli: Montgomery REDC requires gcd(N, R) = 1,
//       i.e., N odd. Every DH safe prime is odd by construction, but a
//       synthetic caller could pass an even modulus -- in which case
//       the public `bn2048_modpow_ct` falls back here.
//   (b) Equivalence anchor in the unit-test sweep: the new Mont path
//       is compared bit-exactly against this legacy path over a small
//       sweep of deterministic pseudo-random vectors (proves
//       correctness).
fn _bn2048_modpow_ct_legacy(base, exp, m) {
    if bn2048_zero(m) != 0 {
        return _bn2048_clone(base)
    }
    let one = bn2048_from_int(1)
    if bn2048_eq(m, one) != 0 {
        return _bn2048_alloc_zero()
    }
    let r0 = bn2048_from_int(1)
    let r1 = bn2048_mod(base, m)
    let i = BN2048_TOTAL_BITS - 1
    while i >= 0 {
        let limb_idx = int_shr(i, 5)
        let bit_idx  = int_and(i, 31)
        let b = int_and(int_shr(exp[limb_idx], bit_idx), 1)
        if b == 0 {
            r1 = bn2048_modmul(r0, r1, m)
            r0 = bn2048_modmul(r0, r0, m)
        } else {
            r0 = bn2048_modmul(r0, r1, m)
            r1 = bn2048_modmul(r1, r1, m)
        }
        i = i - 1
    }
    return r0
}

// ---- modular exponentiation (CT only) -----------------------------------
//
// Constant-time modular exponentiation via the Montgomery ladder, now
// with Montgomery REDC under the hood. IDENTICAL ALGORITHM SHAPE to
// bignum.nova's bn_modpow_ct, just over 2048-bit values:
//
//   R0 = 1, R1 = base mod m
//   for i = bit_len - 1 DOWN TO 0:
//     b = exp.bit(i)
//     if b == 0:
//         R1 = R0 * R1 mod m
//         R0 = R0 * R0 mod m
//     else:
//         R0 = R0 * R1 mod m
//         R1 = R1 * R1 mod m
//   return R0
//
// Internally, this delegates to `bn2048_modpow_ct_mont` (CIOS
// Montgomery multiplication) after building a Montgomery context for m.
// Externally bit-exact with the pre-Montgomery implementation -- the
// Fermat-on-Group-14 headline test and every existing equivalence
// vector continue to pass.
//
// Returns base^exp mod m, 2048-bit. Edge cases match bn_modpow_ct:
//   - m == 0   -> returns a clone of base
//   - m == 1   -> returns 0
//   - exp == 0 -> returns 1
//   - m even   -> falls back to legacy bit-by-bit path (Montgomery REDC
//                 requires gcd(N, R) = 1; R = 2^2048 so N must be odd).
//                 Every standard DH safe prime is odd by construction.
fn bn2048_modpow_ct(base, exp, m) {
    if bn2048_zero(m) != 0 {
        return _bn2048_clone(base)
    }
    let one = bn2048_from_int(1)
    if bn2048_eq(m, one) != 0 {
        return _bn2048_alloc_zero()
    }
    // Montgomery REDC requires gcd(N, R) = 1. R = 2^2048, so N must be
    // odd. For even N, fall back to the legacy path -- correct, slow,
    // but only reachable for synthetic non-DH call sites.
    if int_and(m[0], 1) == 0 {
        return _bn2048_modpow_ct_legacy(base, exp, m)
    }
    let ctx = bn2048_mont_ctx_new(m)
    return bn2048_modpow_ct_mont(base, exp, ctx)
}

// ---- RFC 7919 Group 14 constants ----------------------------------------
//
// RFC 3526 §3 / RFC 7919 Group 14 (the 2048-bit MODP "More Modular
// Exponential" group). The prime is a SAFE prime
//   p = 2^2048 - 2^1984 - 1 + 2^64 * { [2^1918 pi] + 124476 }
// where q = (p - 1) / 2 is also prime. Generator g = 2 is a generator
// of the order-q subgroup. RFC 7919 Group 14 is the smallest standard
// DH MODP group considered cryptographically reasonable in 2025.
//
// The hex encoding below is the EXACT constant from RFC 3526 §3:
//
//     FFFFFFFF FFFFFFFF C90FDAA2 2168C234 C4C6628B 80DC1CD1
//     29024E08 8A67CC74 020BBEA6 3B139B22 514A0879 8E3404DD
//     EF9519B3 CD3A431B 302B0A6D F25F1437 4FE1356D 6D51C245
//     E485B576 625E7EC6 F44C42E9 A637ED6B 0BFF5CB6 F406B7ED
//     EE386BFB 5A899FA5 AE9F2411 7C4B1FE6 49286651 ECE45B3D
//     C2007CB8 A163BF05 98DA4836 1C55D39A 69163FA8 FD24CF5F
//     83655D23 DCA3AD96 1C62F356 208552BB 9ED52907 7096966D
//     670C354E 4ABC9804 F1746C08 CA18217C 32905E46 2E36CE3B
//     E39E772C 180E8603 9B2783A2 EC07A28F B5C55DF0 6F4C52C9
//     DE2BCBF6 95581718 3995497C EA956AE5 15D22618 98FA0510
//     15728E5A 8AACAA68 FFFFFFFF FFFFFFFF
//
// Total: 512 hex chars = 2048 bits exactly, MSB-first.
//
// These constants are produced lazily by `rfc7919_group14_p()` and
// `rfc7919_group14_g()` rather than as let-globals because top-level
// `let` initializers run at module-load time across every importer;
// a 64-element list allocation per import would inflate boot cost
// for callers that don't use the DH path.
fn rfc7919_group14_p() {
    return bn2048_from_hex(
        "ffffffffffffffffc90fdaa22168c234c4c6628b80dc1cd1"
        + "29024e088a67cc74020bbea63b139b22514a08798e3404dd"
        + "ef9519b3cd3a431b302b0a6df25f14374fe1356d6d51c245"
        + "e485b576625e7ec6f44c42e9a637ed6b0bff5cb6f406b7ed"
        + "ee386bfb5a899fa5ae9f24117c4b1fe649286651ece45b3d"
        + "c2007cb8a163bf0598da48361c55d39a69163fa8fd24cf5f"
        + "83655d23dca3ad961c62f356208552bb9ed529077096966d"
        + "670c354e4abc9804f1746c08ca18217c32905e462e36ce3b"
        + "e39e772c180e86039b2783a2ec07a28fb5c55df06f4c52c9"
        + "de2bcbf6955817183995497cea956ae515d2261898fa0510"
        + "15728e5a8aacaa68ffffffffffffffff")
}

fn rfc7919_group14_g() {
    return bn2048_from_int(2)
}
