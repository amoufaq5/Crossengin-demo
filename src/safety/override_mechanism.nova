// CrossEngin safety: override mechanism.
//
// Purpose
//   The four graded user interventions of ADR-0044, from surgical to total:
//     1. belief edit  -- privileged set of an atom's alpha/beta (+ optional pin
//                        so plasticity cannot drift it back); emits a correction.
//     2. goal veto    -- mark a goal VETOED and prune (veto) its whole sub-tree;
//                        a standing veto records the name so drives won't
//                        regenerate it.
//     3. hard stop    -- flip safety_halt: the gate drains actions without
//                        executing while the rest of the substrate keeps running.
//     4. kill switch  -- clean kill snapshots then exits; panic kill exits now.
//   Every override except panic-kill appends to the decision log (ADR-0043).
//   The actual process exit + ordered snapshot is the runtime seam (enhancement
//   #10 / ADR-0048); here we own the safety state and the snapshot-or-not
//   decision.
//
// ADRs implemented: ADR-0044 (override mechanism), ADR-0043 (logged), ADR-0023
//   (privileged belief write). NOVA dependencies: builtins. CrossEngin
//   dependencies: src/kg/atom_store.nova, src/parts/goals/goal_engine.nova,
//   src/audit/audit_writer.nova.

import "../kg/atom_store.nova"
import "../parts/goals/goal_engine.nova"
import "../audit/audit_writer.nova"

// New goal status introduced by ADR-0044 (extends goal_engine's GOAL_*).
let GOAL_VETOED = 5

// ---- safety state (hard stop / kill) --------------------------------------
// Slot-name prefix bumped to OMSS_* (Override-Mechanism Safety State) so
// the constants do not collide with the SS_TAG constants owned by
// unrelated modules (semantic_search, stream_stdin) once every graph
// pulls this module in.
let OMSS_TAG    = 4401
let OMSS_HALT   = 1
let OMSS_KILLED = 2
let OMSS_PANIC  = 3

fn safety_state_new() {
    let s = list_new()
    push(s, OMSS_TAG)
    push(s, 0)
    push(s, 0)
    push(s, 0)
    return s
}

fn safety_is_halted(ss)     { return ss[OMSS_HALT] }
fn safety_is_killed(ss)     { return ss[OMSS_KILLED] }
fn safety_kill_was_panic(ss) { return ss[OMSS_PANIC] }

// A clean kill must snapshot before exit (ADR-0048); a panic kill skips it.
fn safety_should_snapshot(ss) {
    if ss[OMSS_KILLED] == 1 {
        if ss[OMSS_PANIC] == 0 { return 1 }
    }
    return 0
}

// ---- 1. belief edit -------------------------------------------------------
// Privileged write of an atom's Bayesian counts (+ optional pin). Logs a
// correction. Returns the new posterior mean (milli).
fn override_belief_edit(log, atom, alpha, beta, pin, now) {
    let b = atom_belief(atom)
    list_set(b, 0, alpha)
    list_set(b, 1, beta)
    if pin == 1 { atom_payload_set(atom, "pinned", 1) }
    audit_correction(log, ACT_SELF_MODIFY, atom_id(atom), now)
    return atom_confidence(atom)
}

// A pinned belief is exempt from ordinary plasticity drift (ADR-0023). The
// plasticity path consults this flag.
fn override_belief_is_pinned(atom) {
    if atom_payload_has(atom, "pinned") == 1 { return atom_payload_get(atom, "pinned") }
    return 0
}

// ---- 2. goal veto ---------------------------------------------------------
fn _veto_subtree(engine, id) {
    goal_set_status(engine, id, GOAL_VETOED)
    let kids = goal_children(engine, id)
    let i = 0
    while i < len(kids) {
        _veto_subtree(engine, kids[i])
        i = i + 1
    }
    return 1
}

fn veto_registry_new() { return list_new() }

// Is a goal name under a standing veto (so the drive engine must not regenerate
// it)?
fn override_name_vetoed(reg, name) {
    let i = 0
    while i < len(reg) {
        if str_eq(reg[i], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Veto a goal and its whole sub-tree. A standing veto also records the name.
// Logs an override entry. reg is the standing-veto registry.
fn override_goal_veto(log, engine, reg, goal_id, standing, now) {
    _veto_subtree(engine, goal_id)
    if standing == 1 {
        if override_name_vetoed(reg, goal_name(engine, goal_id)) == 0 {
            push(reg, goal_name(engine, goal_id))
        }
    }
    audit_override(log, ACT_SELF_MODIFY, goal_id, now)
    return 1
}

// ---- 3. hard stop ---------------------------------------------------------
// Freeze action execution (substrate keeps running). Logged.
fn override_hard_stop(log, ss, now) {
    list_set(ss, OMSS_HALT, 1)
    audit_override(log, ACT_SELF_MODIFY, -1, now)
    return 1
}

// Lift a hard stop (resume executing actions).
fn override_resume(ss) {
    list_set(ss, OMSS_HALT, 0)
    return 1
}

// ---- 4. kill switch -------------------------------------------------------
// Set kill state. Clean kill (panic == 0) is logged and requests a snapshot;
// panic kill (panic == 1) is immediate and unlogged. Returns 1 if a snapshot
// should be taken before exit, else 0. The exit itself is the runtime seam.
fn override_kill(log, ss, panic, now) {
    list_set(ss, OMSS_KILLED, 1)
    list_set(ss, OMSS_PANIC, panic)
    if panic == 0 { audit_override(log, ACT_SELF_MODIFY, -1, now) }
    return safety_should_snapshot(ss)
}
