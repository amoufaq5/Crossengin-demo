// NIST P-384 (secp384r1) point decoding and ECDSA verification (PR 4c).
//
// Audit F-17 follow-up: 35 of the 122 roots in the system CA bundle are
// P-384 and most of them sign with ecdsa-with-SHA384; TLS 1.3 servers with
// P-384 keys answer with ecdsa_secp384r1_sha384 (0x0503). Verification only
// handles public values (key, signature, digest), so this is built on
// bignum_rsa's width-generic Montgomery arithmetic with 12 32-bit limbs and
// runs in variable time. There is no signing here.
//
// Field elements live in Montgomery form mod p; points are Jacobian
// [X, Y, Z] (Z == 0 is the point at infinity); the curve has a = -3, so
// doubling uses the dbl-2001-b formulas. Scalars are plain 12-limb values.
//
//   p384_decode_point(buf, n)        -> [X, Y] (plain, on the curve) or 0
//   ecdsa_p384_verify(pub, pub_n, hash, hash_n, r_buf, s_buf) -> 1 / 0
//       r_buf / s_buf: 48-byte big-endian; hash: any length (the leftmost
//       384 bits are used, FIPS 186-4 6.4).
// Curve constants from `openssl ecparam -name secp384r1 -param_enc explicit`.

import "bignum_rsa.nova"

let _P384_NL = 12
let _P384_P_HEX = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"
let _P384_N_HEX = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
let _P384_B_HEX = "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"
let _P384_GX_HEX = "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
let _P384_GY_HEX = "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"

let _p384_cache = 0

// [ctx_p, ctx_n, p, n, b_mont, G_jac, one_mont] -- built once.
fn _p384() {
    if _p384_cache != 0 { return _p384_cache }
    let p = bnr_from_hex(_P384_P_HEX)
    let n = bnr_from_hex(_P384_N_HEX)
    let cp = bnr_mont_ctx_new(p)
    let cn = bnr_mont_ctx_new(n)
    let one = bnr_to_mont(bnr_from_int(1, _P384_NL), cp)
    let G = list_new()
    push(G, bnr_to_mont(bnr_from_hex(_P384_GX_HEX), cp))
    push(G, bnr_to_mont(bnr_from_hex(_P384_GY_HEX), cp))
    push(G, one)
    let c = list_new()
    push(c, cp) push(c, cn) push(c, p) push(c, n)
    push(c, bnr_to_mont(bnr_from_hex(_P384_B_HEX), cp))
    push(c, G)
    push(c, one)
    _p384_cache = c
    return c
}

fn _p384_mul(a, b) { return bnr_montmul(a, b, _p384()[0]) }
fn _p384_add(a, b) { return bnr_addmod(a, b, _p384()[2]) }
fn _p384_sub(a, b) { return bnr_submod(a, b, _p384()[2]) }

fn _p384_inf() {
    let c = _p384()
    let P = list_new()
    push(P, c[6]) push(P, c[6]) push(P, bnr_from_int(0, _P384_NL))
    return P
}

// Jacobian doubling for a = -3 (dbl-2001-b).
fn _p384_dbl(P) {
    let X = P[0]
    let Y = P[1]
    let Z = P[2]
    if bnr_is_zero(Z) == 1 { return P }
    let delta = _p384_mul(Z, Z)
    let gamma = _p384_mul(Y, Y)
    let beta = _p384_mul(X, gamma)
    let t = _p384_mul(_p384_sub(X, delta), _p384_add(X, delta))
    let alpha = _p384_add(_p384_add(t, t), t)
    let beta4 = _p384_add(_p384_add(beta, beta), _p384_add(beta, beta))
    let beta8 = _p384_add(beta4, beta4)
    let X3 = _p384_sub(_p384_mul(alpha, alpha), beta8)
    let yz = _p384_add(Y, Z)
    let Z3 = _p384_sub(_p384_sub(_p384_mul(yz, yz), gamma), delta)
    let g2 = _p384_mul(gamma, gamma)
    let g4 = _p384_add(g2, g2)
    let g8 = _p384_add(g4, g4)
    let Y3 = _p384_sub(_p384_mul(alpha, _p384_sub(beta4, X3)), _p384_add(g8, g8))
    let R = list_new()
    push(R, X3) push(R, Y3) push(R, Z3)
    return R
}

// Jacobian addition (handles infinity, P == Q and P == -Q).
fn _p384_padd(P, Q) {
    if bnr_is_zero(P[2]) == 1 { return Q }
    if bnr_is_zero(Q[2]) == 1 { return P }
    let z1z1 = _p384_mul(P[2], P[2])
    let z2z2 = _p384_mul(Q[2], Q[2])
    let u1 = _p384_mul(P[0], z2z2)
    let u2 = _p384_mul(Q[0], z1z1)
    let s1 = _p384_mul(_p384_mul(P[1], Q[2]), z2z2)
    let s2 = _p384_mul(_p384_mul(Q[1], P[2]), z1z1)
    let h = _p384_sub(u2, u1)
    let r = _p384_sub(s2, s1)
    if bnr_is_zero(h) == 1 {
        if bnr_is_zero(r) == 1 { return _p384_dbl(P) }
        return _p384_inf()
    }
    let hh = _p384_mul(h, h)
    let hhh = _p384_mul(h, hh)
    let v = _p384_mul(u1, hh)
    let X3 = _p384_sub(_p384_sub(_p384_mul(r, r), hhh), _p384_add(v, v))
    let Y3 = _p384_sub(_p384_mul(r, _p384_sub(v, X3)), _p384_mul(s1, hhh))
    let Z3 = _p384_mul(_p384_mul(P[2], Q[2]), h)
    let R = list_new()
    push(R, X3) push(R, Y3) push(R, Z3)
    return R
}

// u1*G + u2*Q (Shamir's trick). u1, u2: plain 12-limb scalars.
fn _p384_mul2(u1, u2, Q) {
    let G = _p384()[5]
    let GQ = _p384_padd(G, Q)
    let R = _p384_inf()
    let i = 383
    while i >= 0 {
        R = _p384_dbl(R)
        let b1 = bnr_bit(u1, i)
        let b2 = bnr_bit(u2, i)
        if b1 == 1 {
            if b2 == 1 { R = _p384_padd(R, GQ) } else { R = _p384_padd(R, G) }
        } else {
            if b2 == 1 { R = _p384_padd(R, Q) }
        }
        i = i - 1
    }
    return R
}

// 0x04 || X || Y (97 bytes) -> [X, Y] plain, checked X, Y < p and
// y^2 = x^3 - 3x + b. Returns 0 otherwise (compressed points unsupported).
fn p384_decode_point(buf, n) {
    if n != 97 { return 0 }
    if load8(buf) != 4 { return 0 }
    let c = _p384()
    let p = c[2]
    let X = bnr_from_be_bytes_n(buf, 1, 48, _P384_NL)
    let Y = bnr_from_be_bytes_n(buf, 49, 48, _P384_NL)
    if bnr_cmp(X, p) >= 0 { return 0 }
    if bnr_cmp(Y, p) >= 0 { return 0 }
    let cp = c[0]
    let xm = bnr_to_mont(X, cp)
    let ym = bnr_to_mont(Y, cp)
    let rhs = _p384_mul(_p384_mul(xm, xm), xm)
    let x3 = _p384_add(_p384_add(xm, xm), xm)
    rhs = _p384_add(_p384_sub(rhs, x3), c[4])
    if bnr_eq(_p384_mul(ym, ym), rhs) == 0 { return 0 }
    let out = list_new()
    push(out, X) push(out, Y)
    return out
}

fn _p384_in_range_n(v) {
    if bnr_is_zero(v) == 1 { return 0 }
    if bnr_cmp(v, _p384()[3]) >= 0 { return 0 }
    return 1
}

// ECDSA-P384 verify (FIPS 186-4 6.4.2). See the header for the arguments.
fn ecdsa_p384_verify(pub_buf, pub_n, hash_buf, hash_n, r_buf, s_buf) {
    let pt = p384_decode_point(pub_buf, pub_n)
    if pt == 0 { return 0 }
    let c = _p384()
    let cp = c[0]
    let cn = c[1]
    let n = c[3]
    let r = bnr_from_be_bytes_n(r_buf, 0, 48, _P384_NL)
    let s = bnr_from_be_bytes_n(s_buf, 0, 48, _P384_NL)
    if _p384_in_range_n(r) == 0 { return 0 }
    if _p384_in_range_n(s) == 0 { return 0 }
    if hash_n < 1 { return 0 }
    let hk = hash_n
    if hk > 48 { hk = 48 }                       // leftmost 384 bits
    let e = bnr_from_be_bytes_n(hash_buf, 0, hk, _P384_NL)
    if bnr_cmp(e, n) >= 0 { _bnr_sub_inplace(e, n) }   // e < 2^384 < 2n
    let w = bnr_inv_prime(s, cn)
    if w == 0 { return 0 }
    let u1 = bnr_montmul(bnr_to_mont(e, cn), w, cn)    // e*w mod n
    let u2 = bnr_montmul(bnr_to_mont(r, cn), w, cn)    // r*w mod n
    let Q = list_new()
    push(Q, bnr_to_mont(pt[0], cp)) push(Q, bnr_to_mont(pt[1], cp)) push(Q, c[6])
    let R = _p384_mul2(u1, u2, Q)
    if bnr_is_zero(R[2]) == 1 { return 0 }
    // affine x = X / Z^2
    let zinv = bnr_inv_prime(bnr_from_mont(R[2], cp), cp)
    let zinv_m = bnr_to_mont(zinv, cp)
    let x = bnr_from_mont(_p384_mul(R[0], _p384_mul(zinv_m, zinv_m)), cp)
    if bnr_cmp(x, n) >= 0 { _bnr_sub_inplace(x, n) }
    return bnr_eq(x, r)
}
