// CrossEngin safety: GF(2^255 - 19) field arithmetic for Curve25519
//   (RFC 7748 Appendix A). Standalone leaf primitive used by
//   src/safety/x25519.nova (R89) and available for a future ed25519
//   rewrite (R90).
//
// Purpose
//   x25519 needs modular arithmetic in the prime field GF(2^255 - 19).
//   R89 delivers a fresh field25519 implementation in the standard
//   "Bernstein 10-limb" layout: ten unsigned 26/25-bit limbs, radix
//   2^25.5. This is the "curve25519-donna" / "ref10" layout, chosen
//   over 5x51-bit limbs because a 26/25 layout keeps every limb product
//   safely inside NOVA's 63-bit signed-positive integer range with
//   well-known reduction bounds, and matches the shape most existing
//   pure-integer Curve25519 reference implementations use.
//
// Representation
//   A field element is a 10-int list [h0, h1, ..., h9] representing:
//
//     h0 + 2^26*h1 + 2^51*h2 + 2^77*h3 + 2^102*h4 +
//     2^128*h5 + 2^153*h6 + 2^179*h7 + 2^204*h8 + 2^230*h9
//
//   Even limbs (h0, h2, h4, h6, h8) span 26-bit windows.
//   Odd  limbs (h1, h3, h5, h7, h9) span 25-bit windows.
//   After carry-propagation, each even limb is in [0, 2^26) and each
//   odd limb is in [0, 2^25). Intermediate values during add/sub/mul
//   grow above these bounds but are always brought back to canonical
//   form before returning.
//
// Byte encoding (RFC 7748 §5)
//   fe_frombytes decodes 32 little-endian bytes; per RFC 7748 §5 the
//   top bit of byte 31 is masked (u_coord high bit is ignored).
//   fe_tobytes emits the canonical 32-byte little-endian encoding of
//   `a mod (2^255 - 19)` -- the final reduction is constant-time.
//
// NOVA 63-bit-positive arithmetic safety
//   Multiplication worst case (ref10 bound): input limbs bounded by
//   1.13 * 2^26. Precomputed 19*g[i] < 22 * 2^26 ~ 2^30.5, doubled odd
//   f limbs < 2.3 * 2^26 ~ 2^27.2. One product 2.3*2^26 * 22*2^26 ~
//   2^58 (safely under 63). Ten-term sum ~ 10 * 2^58 ~ 2^61.3, still
//   under 2^62. NOVA integers stay well inside the 63-bit safe range.
//
//   fe_sub folds the operand through +4p offset limbs to keep every
//   intermediate non-negative (NOVA has no unsigned type; a "-1"
//   arithmetic value would silently become a very large positive
//   number, corrupting later operations). The 4p limb constants
//   (4 * (2^255 - 19) expressed in the 26/25 layout) are precomputed
//   as let-consts.
//
// Constant-time discipline
//   - No data-dependent branches inside fe_add / fe_sub / fe_mul /
//     fe_sq / fe_mul121666 / fe_neg / fe_copy / fe_zero / fe_one.
//   - fe_cswap uses XOR-with-mask (0 or 2^26-1 style masks); no branch
//     on the swap bit.
//   - fe_tobytes performs the final `if h >= p then h -= p` step in
//     constant time via a mask derived from the top-limb carry.
//   - fe_invert runs a fixed 254-square + 11-multiply chain (Bernstein
//     addition chain for the exponent p - 2 = 2^255 - 21); the sequence
//     is data-independent.
//
// Public API
//   fe_zero(out)                -- out := 0
//   fe_one(out)                 -- out := 1
//   fe_copy(out, a)             -- out := a
//   fe_add(out, a, b)           -- out := a + b       (mod p, canonical)
//   fe_sub(out, a, b)           -- out := a - b       (mod p, canonical)
//   fe_neg(out, a)              -- out := -a          (mod p, canonical)
//   fe_mul(out, a, b)           -- out := a * b       (mod p, canonical)
//   fe_sq(out, a)               -- out := a * a       (mod p, canonical)
//   fe_mul121666(out, a)        -- out := 121666 * a  (mod p, canonical)
//   fe_invert(out, a)           -- out := a^(p-2)     (mod p; a==0 -> 0)
//   fe_frombytes(out, bytes32)  -- decode 32 LE bytes; high bit masked
//   fe_tobytes(bytes32, a)      -- canonical 32-byte LE encoding
//   fe_cswap(a, b, swap)        -- CT swap iff swap == 1
//
// ADRs touched: r86-in-process-tls-scaffolding.md (R89 x25519 phase).
// NOVA dependencies: builtins only.
// CrossEngin dependencies: none -- pure leaf primitive.

// ---- limb-size constants ------------------------------------------------

// 2^26 - 1 = 67108863   (26-bit mask, for even limbs)
let FE_MASK_26 = 67108863
// 2^25 - 1 = 33554431   (25-bit mask, for odd limbs)
let FE_MASK_25 = 33554431
// 2^26 = 67108864       (carry-up divisor for even limbs)
let FE_2P26   = 67108864
// 2^25 = 33554432       (carry-up divisor for odd limbs)
let FE_2P25   = 33554432
// 19 -- the (2^255) mod p wrap factor
let FE_19     = 19
// 38 = 2 * 19 -- appears in mul when two odd-indexed limbs (of both
// operands) are multiplied AND the position wraps.
let FE_38     = 38
// 8-bit byte mask
let FE_MASK_8 = 255

// ---- 4p limbs (for keeping fe_sub non-negative) --------------------------
// p = 2^255 - 19
// 4p in 26/25 limbs (little-endian, index 0 = lowest):
//   4p[0] = 4*(2^26 - 19) = 2^28 - 76   = 268435380
//   4p[1] = 4*(2^25 - 1)  = 2^27 - 4    = 134217724
//   4p[2] = 4*(2^26 - 1)  = 2^28 - 4    = 268435452
//   4p[3] = 4*(2^25 - 1)  = 2^27 - 4    = 134217724
//   4p[4] = 4*(2^26 - 1)  = 2^28 - 4    = 268435452
//   4p[5] = 4*(2^25 - 1)  = 2^27 - 4    = 134217724
//   4p[6] = 4*(2^26 - 1)  = 2^28 - 4    = 268435452
//   4p[7] = 4*(2^25 - 1)  = 2^27 - 4    = 134217724
//   4p[8] = 4*(2^26 - 1)  = 2^28 - 4    = 268435452
//   4p[9] = 4*(2^25 - 1)  = 2^27 - 4    = 134217724
let FE_4P_0 = 268435380
let FE_4P_1 = 134217724
let FE_4P_2 = 268435452
let FE_4P_3 = 134217724
let FE_4P_4 = 268435452
let FE_4P_5 = 134217724
let FE_4P_6 = 268435452
let FE_4P_7 = 134217724
let FE_4P_8 = 268435452
let FE_4P_9 = 134217724

// ---- constructors --------------------------------------------------------

fn fe_new() {
    let h = list_new()
    push(h, 0); push(h, 0); push(h, 0); push(h, 0); push(h, 0)
    push(h, 0); push(h, 0); push(h, 0); push(h, 0); push(h, 0)
    return h
}

fn fe_zero(out) {
    list_set(out, 0, 0); list_set(out, 1, 0); list_set(out, 2, 0)
    list_set(out, 3, 0); list_set(out, 4, 0); list_set(out, 5, 0)
    list_set(out, 6, 0); list_set(out, 7, 0); list_set(out, 8, 0)
    list_set(out, 9, 0)
    return 1
}

fn fe_one(out) {
    list_set(out, 0, 1); list_set(out, 1, 0); list_set(out, 2, 0)
    list_set(out, 3, 0); list_set(out, 4, 0); list_set(out, 5, 0)
    list_set(out, 6, 0); list_set(out, 7, 0); list_set(out, 8, 0)
    list_set(out, 9, 0)
    return 1
}

fn fe_copy(out, a) {
    list_set(out, 0, a[0]); list_set(out, 1, a[1]); list_set(out, 2, a[2])
    list_set(out, 3, a[3]); list_set(out, 4, a[4]); list_set(out, 5, a[5])
    list_set(out, 6, a[6]); list_set(out, 7, a[7]); list_set(out, 8, a[8])
    list_set(out, 9, a[9])
    return 1
}

// ---- carry-propagation pass ---------------------------------------------
// Propagates carries through the 10-limb representation. After one pass
// each limb is in the canonical range EXCEPT possibly h0 whose top may
// briefly grow past 2^26 by the 19*carry9 wrap; a second reduction of
// h0->h1 finishes the job.
//
// Order (ref10 style):
//   carry from odd limbs first (h1->h2, h3->h4, h5->h6, h7->h8, h9->h0),
//   then from even limbs (h0->h1, h2->h3, h4->h5, h6->h7, h8->h9).
// The h9->h0 carry multiplies the overflow by 19 (the 2^255 mod p wrap).

fn _fe_carry_into(h) {
    let c = 0
    // First sequential cascade h[0] -> h[1] -> ... -> h[9] alternating
    // 26-bit and 25-bit windows.
    c = int_shr(h[0], 26); list_set(h, 1, int_add(h[1], c)); list_set(h, 0, int_and(h[0], FE_MASK_26))
    c = int_shr(h[1], 25); list_set(h, 2, int_add(h[2], c)); list_set(h, 1, int_and(h[1], FE_MASK_25))
    c = int_shr(h[2], 26); list_set(h, 3, int_add(h[3], c)); list_set(h, 2, int_and(h[2], FE_MASK_26))
    c = int_shr(h[3], 25); list_set(h, 4, int_add(h[4], c)); list_set(h, 3, int_and(h[3], FE_MASK_25))
    c = int_shr(h[4], 26); list_set(h, 5, int_add(h[5], c)); list_set(h, 4, int_and(h[4], FE_MASK_26))
    c = int_shr(h[5], 25); list_set(h, 6, int_add(h[6], c)); list_set(h, 5, int_and(h[5], FE_MASK_25))
    c = int_shr(h[6], 26); list_set(h, 7, int_add(h[7], c)); list_set(h, 6, int_and(h[6], FE_MASK_26))
    c = int_shr(h[7], 25); list_set(h, 8, int_add(h[8], c)); list_set(h, 7, int_and(h[7], FE_MASK_25))
    c = int_shr(h[8], 26); list_set(h, 9, int_add(h[9], c)); list_set(h, 8, int_and(h[8], FE_MASK_26))
    // Top-limb wrap: h[9] overflow re-enters h[0] with the * 19 factor
    // (2^255 mod p == 19).
    c = int_shr(h[9], 25); list_set(h, 0, int_add(h[0], int_mul(c, FE_19)))
    list_set(h, 9, int_and(h[9], FE_MASK_25))
    // Second full sequential cascade to absorb the 19*c wrap that just
    // grew h[0]. Without this, a large-limb input could leave h[i>0]
    // slightly over its canonical bound and quietly poison subsequent
    // fe_mul products / freeze steps.
    c = int_shr(h[0], 26); list_set(h, 1, int_add(h[1], c)); list_set(h, 0, int_and(h[0], FE_MASK_26))
    c = int_shr(h[1], 25); list_set(h, 2, int_add(h[2], c)); list_set(h, 1, int_and(h[1], FE_MASK_25))
    c = int_shr(h[2], 26); list_set(h, 3, int_add(h[3], c)); list_set(h, 2, int_and(h[2], FE_MASK_26))
    c = int_shr(h[3], 25); list_set(h, 4, int_add(h[4], c)); list_set(h, 3, int_and(h[3], FE_MASK_25))
    c = int_shr(h[4], 26); list_set(h, 5, int_add(h[5], c)); list_set(h, 4, int_and(h[4], FE_MASK_26))
    c = int_shr(h[5], 25); list_set(h, 6, int_add(h[6], c)); list_set(h, 5, int_and(h[5], FE_MASK_25))
    c = int_shr(h[6], 26); list_set(h, 7, int_add(h[7], c)); list_set(h, 6, int_and(h[6], FE_MASK_26))
    c = int_shr(h[7], 25); list_set(h, 8, int_add(h[8], c)); list_set(h, 7, int_and(h[7], FE_MASK_25))
    c = int_shr(h[8], 26); list_set(h, 9, int_add(h[9], c)); list_set(h, 8, int_and(h[8], FE_MASK_26))
    // Second top wrap (the second cascade may have grown h[9] by ~1).
    c = int_shr(h[9], 25); list_set(h, 0, int_add(h[0], int_mul(c, FE_19)))
    list_set(h, 9, int_and(h[9], FE_MASK_25))
    c = int_shr(h[0], 26); list_set(h, 1, int_add(h[1], c)); list_set(h, 0, int_and(h[0], FE_MASK_26))
    return 1
}

// ---- add / sub / neg ----------------------------------------------------

// out := a + b (limb-wise), then carry-propagate.
fn fe_add(out, a, b) {
    list_set(out, 0, int_add(a[0], b[0]))
    list_set(out, 1, int_add(a[1], b[1]))
    list_set(out, 2, int_add(a[2], b[2]))
    list_set(out, 3, int_add(a[3], b[3]))
    list_set(out, 4, int_add(a[4], b[4]))
    list_set(out, 5, int_add(a[5], b[5]))
    list_set(out, 6, int_add(a[6], b[6]))
    list_set(out, 7, int_add(a[7], b[7]))
    list_set(out, 8, int_add(a[8], b[8]))
    list_set(out, 9, int_add(a[9], b[9]))
    _fe_carry_into(out)
    return 1
}

// out := a - b (limb-wise, folded through +4p to keep every limb
// non-negative), then carry-propagate.
// Assumes b's limbs are canonically reduced (< 2^26 or < 2^25). Under
// that assumption 4p_limb > b_limb for every position, so the
// subtraction cannot underflow into negative NOVA-int territory.
fn fe_sub(out, a, b) {
    list_set(out, 0, int_add(a[0], FE_4P_0) - b[0])
    list_set(out, 1, int_add(a[1], FE_4P_1) - b[1])
    list_set(out, 2, int_add(a[2], FE_4P_2) - b[2])
    list_set(out, 3, int_add(a[3], FE_4P_3) - b[3])
    list_set(out, 4, int_add(a[4], FE_4P_4) - b[4])
    list_set(out, 5, int_add(a[5], FE_4P_5) - b[5])
    list_set(out, 6, int_add(a[6], FE_4P_6) - b[6])
    list_set(out, 7, int_add(a[7], FE_4P_7) - b[7])
    list_set(out, 8, int_add(a[8], FE_4P_8) - b[8])
    list_set(out, 9, int_add(a[9], FE_4P_9) - b[9])
    _fe_carry_into(out)
    return 1
}

fn fe_neg(out, a) {
    let z = fe_new()
    fe_sub(out, z, a)
    return 1
}

// ---- multiplication -----------------------------------------------------
//
// Ten-limb schoolbook multiply, wrapped by the 2^255 == 19 (mod p)
// identity. Odd-index-of-f limbs are doubled when they meet an
// odd-index-of-g limb because two 25-bit slots at positions 26k+25 and
// 26k'+25 sum to bit position 25.5*(k+k'+1) + 25 which the ref10 layout
// stores in the (k+k'+1)-th even limb at 26.5 bits -- the "*2" absorbs
// the missing half-limb of shift.
//
// The reduction pattern is the ref10 formula transcribed literally,
// giving each h[i] a fully-reduced-modulo-p contribution:
//
//   h0 = f0*g0 + 38 * (f1*g9 + f3*g7 + f5*g5 + f7*g3 + f9*g1)
//              + 19 * (f2*g8 + f4*g6 + f6*g4 + f8*g2)
//   h1 = f0*g1 + f1*g0 + 19*(f2*g9 + f3*g8 + f4*g7 + f5*g6 + f6*g5 + f7*g4 + f8*g3 + f9*g2)
//   h2 = f0*g2 + 2*f1*g1 + f2*g0 + 38*(f3*g9 + f5*g7 + f7*g5 + f9*g3)
//              + 19*(f4*g8 + f6*g6 + f8*g4)
//   h3 = f0*g3 + f1*g2 + f2*g1 + f3*g0 + 19*(f4*g9 + f5*g8 + f6*g7 + f7*g6 + f8*g5 + f9*g4)
//   h4 = f0*g4 + 2*f1*g3 + f2*g2 + 2*f3*g1 + f4*g0 + 38*(f5*g9 + f7*g7 + f9*g5) + 19*(f6*g8 + f8*g6)
//   h5 = f0*g5 + f1*g4 + f2*g3 + f3*g2 + f4*g1 + f5*g0 + 19*(f6*g9 + f7*g8 + f8*g7 + f9*g6)
//   h6 = f0*g6 + 2*f1*g5 + f2*g4 + 2*f3*g3 + f4*g2 + 2*f5*g1 + f6*g0 + 38*(f7*g9 + f9*g7) + 19*f8*g8
//   h7 = f0*g7 + f1*g6 + f2*g5 + f3*g4 + f4*g3 + f5*g2 + f6*g1 + f7*g0 + 19*(f8*g9 + f9*g8)
//   h8 = f0*g8 + 2*f1*g7 + f2*g6 + 2*f3*g5 + f4*g4 + 2*f5*g3 + f6*g2 + 2*f7*g1 + f8*g0 + 38*f9*g9
//   h9 = f0*g9 + f1*g8 + f2*g7 + f3*g6 + f4*g5 + f5*g4 + f6*g3 + f7*g2 + f8*g1 + f9*g0

fn fe_mul(out, a, b) {
    let f0 = a[0]; let f1 = a[1]; let f2 = a[2]; let f3 = a[3]; let f4 = a[4]
    let f5 = a[5]; let f6 = a[6]; let f7 = a[7]; let f8 = a[8]; let f9 = a[9]
    let g0 = b[0]; let g1 = b[1]; let g2 = b[2]; let g3 = b[3]; let g4 = b[4]
    let g5 = b[5]; let g6 = b[6]; let g7 = b[7]; let g8 = b[8]; let g9 = b[9]
    // Pre-scaled g values (19 * g[i] for i in 1..9)
    let g1_19 = int_mul(FE_19, g1)
    let g2_19 = int_mul(FE_19, g2)
    let g3_19 = int_mul(FE_19, g3)
    let g4_19 = int_mul(FE_19, g4)
    let g5_19 = int_mul(FE_19, g5)
    let g6_19 = int_mul(FE_19, g6)
    let g7_19 = int_mul(FE_19, g7)
    let g8_19 = int_mul(FE_19, g8)
    let g9_19 = int_mul(FE_19, g9)
    // Pre-doubled odd f values
    let f1_2 = int_add(f1, f1)
    let f3_2 = int_add(f3, f3)
    let f5_2 = int_add(f5, f5)
    let f7_2 = int_add(f7, f7)
    let f9_2 = int_add(f9, f9)
    // h0 = f0*g0 + f1_2*g9_19 + f2*g8_19 + f3_2*g7_19 + f4*g6_19
    //          + f5_2*g5_19 + f6*g4_19 + f7_2*g3_19 + f8*g2_19 + f9_2*g1_19
    let h0 = int_add(int_mul(f0, g0),
             int_add(int_mul(f1_2, g9_19),
             int_add(int_mul(f2,   g8_19),
             int_add(int_mul(f3_2, g7_19),
             int_add(int_mul(f4,   g6_19),
             int_add(int_mul(f5_2, g5_19),
             int_add(int_mul(f6,   g4_19),
             int_add(int_mul(f7_2, g3_19),
             int_add(int_mul(f8,   g2_19),
                     int_mul(f9_2, g1_19))))))))))
    let h1 = int_add(int_mul(f0, g1),
             int_add(int_mul(f1, g0),
             int_add(int_mul(f2, g9_19),
             int_add(int_mul(f3, g8_19),
             int_add(int_mul(f4, g7_19),
             int_add(int_mul(f5, g6_19),
             int_add(int_mul(f6, g5_19),
             int_add(int_mul(f7, g4_19),
             int_add(int_mul(f8, g3_19),
                     int_mul(f9, g2_19))))))))))
    let h2 = int_add(int_mul(f0,   g2),
             int_add(int_mul(f1_2, g1),
             int_add(int_mul(f2,   g0),
             int_add(int_mul(f3_2, g9_19),
             int_add(int_mul(f4,   g8_19),
             int_add(int_mul(f5_2, g7_19),
             int_add(int_mul(f6,   g6_19),
             int_add(int_mul(f7_2, g5_19),
             int_add(int_mul(f8,   g4_19),
                     int_mul(f9_2, g3_19))))))))))
    let h3 = int_add(int_mul(f0, g3),
             int_add(int_mul(f1, g2),
             int_add(int_mul(f2, g1),
             int_add(int_mul(f3, g0),
             int_add(int_mul(f4, g9_19),
             int_add(int_mul(f5, g8_19),
             int_add(int_mul(f6, g7_19),
             int_add(int_mul(f7, g6_19),
             int_add(int_mul(f8, g5_19),
                     int_mul(f9, g4_19))))))))))
    let h4 = int_add(int_mul(f0,   g4),
             int_add(int_mul(f1_2, g3),
             int_add(int_mul(f2,   g2),
             int_add(int_mul(f3_2, g1),
             int_add(int_mul(f4,   g0),
             int_add(int_mul(f5_2, g9_19),
             int_add(int_mul(f6,   g8_19),
             int_add(int_mul(f7_2, g7_19),
             int_add(int_mul(f8,   g6_19),
                     int_mul(f9_2, g5_19))))))))))
    let h5 = int_add(int_mul(f0, g5),
             int_add(int_mul(f1, g4),
             int_add(int_mul(f2, g3),
             int_add(int_mul(f3, g2),
             int_add(int_mul(f4, g1),
             int_add(int_mul(f5, g0),
             int_add(int_mul(f6, g9_19),
             int_add(int_mul(f7, g8_19),
             int_add(int_mul(f8, g7_19),
                     int_mul(f9, g6_19))))))))))
    let h6 = int_add(int_mul(f0,   g6),
             int_add(int_mul(f1_2, g5),
             int_add(int_mul(f2,   g4),
             int_add(int_mul(f3_2, g3),
             int_add(int_mul(f4,   g2),
             int_add(int_mul(f5_2, g1),
             int_add(int_mul(f6,   g0),
             int_add(int_mul(f7_2, g9_19),
             int_add(int_mul(f8,   g8_19),
                     int_mul(f9_2, g7_19))))))))))
    let h7 = int_add(int_mul(f0, g7),
             int_add(int_mul(f1, g6),
             int_add(int_mul(f2, g5),
             int_add(int_mul(f3, g4),
             int_add(int_mul(f4, g3),
             int_add(int_mul(f5, g2),
             int_add(int_mul(f6, g1),
             int_add(int_mul(f7, g0),
             int_add(int_mul(f8, g9_19),
                     int_mul(f9, g8_19))))))))))
    let h8 = int_add(int_mul(f0,   g8),
             int_add(int_mul(f1_2, g7),
             int_add(int_mul(f2,   g6),
             int_add(int_mul(f3_2, g5),
             int_add(int_mul(f4,   g4),
             int_add(int_mul(f5_2, g3),
             int_add(int_mul(f6,   g2),
             int_add(int_mul(f7_2, g1),
             int_add(int_mul(f8,   g0),
                     int_mul(f9_2, g9_19))))))))))
    let h9 = int_add(int_mul(f0, g9),
             int_add(int_mul(f1, g8),
             int_add(int_mul(f2, g7),
             int_add(int_mul(f3, g6),
             int_add(int_mul(f4, g5),
             int_add(int_mul(f5, g4),
             int_add(int_mul(f6, g3),
             int_add(int_mul(f7, g2),
             int_add(int_mul(f8, g1),
                     int_mul(f9, g0))))))))))
    list_set(out, 0, h0); list_set(out, 1, h1); list_set(out, 2, h2)
    list_set(out, 3, h3); list_set(out, 4, h4); list_set(out, 5, h5)
    list_set(out, 6, h6); list_set(out, 7, h7); list_set(out, 8, h8)
    list_set(out, 9, h9)
    _fe_carry_into(out)
    return 1
}

// ---- squaring shortcut ---------------------------------------------------
//
// A specialization of fe_mul(a, a) that exploits f[i]*g[j] == f[j]*g[i]
// to fold the schoolbook into ~55 limb-mul terms instead of 100. This is
// the ref10 fe_sq formula transcribed literally: precompute f_i*2, f_i*38,
// f_i*19; compute h0..h9 as sums of ~10 products each; carry.
//
// Correctness parity: tests/unit/test_field25519.nova pins
//   fe_sq(a) == fe_mul(a, a)
// for a batch of a values, so any deviation from the schoolbook is
// caught byte-for-byte.

fn fe_sq(out, a) {
    let f0 = a[0]; let f1 = a[1]; let f2 = a[2]; let f3 = a[3]; let f4 = a[4]
    let f5 = a[5]; let f6 = a[6]; let f7 = a[7]; let f8 = a[8]; let f9 = a[9]
    let f0_2  = int_add(f0, f0)
    let f1_2  = int_add(f1, f1)
    let f2_2  = int_add(f2, f2)
    let f3_2  = int_add(f3, f3)
    let f4_2  = int_add(f4, f4)
    let f5_2  = int_add(f5, f5)
    let f6_2  = int_add(f6, f6)
    let f7_2  = int_add(f7, f7)
    let f5_38 = int_mul(FE_38, f5)
    let f6_19 = int_mul(FE_19, f6)
    let f7_38 = int_mul(FE_38, f7)
    let f8_19 = int_mul(FE_19, f8)
    let f9_38 = int_mul(FE_38, f9)
    // ref10 fe_sq expansions:
    let h0 = int_add(int_mul(f0, f0),
             int_add(int_mul(f1_2, f9_38),
             int_add(int_mul(f2_2, f8_19),
             int_add(int_mul(f3_2, f7_38),
             int_add(int_mul(f4_2, f6_19),
                     int_mul(f5,   f5_38))))))
    let h1 = int_add(int_mul(f0_2, f1),
             int_add(int_mul(f2,   f9_38),
             int_add(int_mul(f3_2, f8_19),
             int_add(int_mul(f4,   f7_38),
                     int_mul(f5_2, f6_19)))))
    let h2 = int_add(int_mul(f0_2, f2),
             int_add(int_mul(f1_2, f1),
             int_add(int_mul(f3_2, f9_38),
             int_add(int_mul(f4_2, f8_19),
             int_add(int_mul(f5_2, f7_38),
                     int_mul(f6,   f6_19))))))
    let h3 = int_add(int_mul(f0_2, f3),
             int_add(int_mul(f1_2, f2),
             int_add(int_mul(f4,   f9_38),
             int_add(int_mul(f5_2, f8_19),
                     int_mul(f6,   f7_38)))))
    let h4 = int_add(int_mul(f0_2, f4),
             int_add(int_mul(f1_2, f3_2),
             int_add(int_mul(f2,   f2),
             int_add(int_mul(f5_2, f9_38),
             int_add(int_mul(f6_2, f8_19),
                     int_mul(f7,   f7_38))))))
    let h5 = int_add(int_mul(f0_2, f5),
             int_add(int_mul(f1_2, f4),
             int_add(int_mul(f2_2, f3),
             int_add(int_mul(f6,   f9_38),
                     int_mul(f7_2, f8_19)))))
    let h6 = int_add(int_mul(f0_2, f6),
             int_add(int_mul(f1_2, f5_2),
             int_add(int_mul(f2_2, f4),
             int_add(int_mul(f3_2, f3),
             int_add(int_mul(f7_2, f9_38),
                     int_mul(f8,   f8_19))))))
    let h7 = int_add(int_mul(f0_2, f7),
             int_add(int_mul(f1_2, f6),
             int_add(int_mul(f2_2, f5),
             int_add(int_mul(f3_2, f4),
                     int_mul(f8,   f9_38)))))
    let h8 = int_add(int_mul(f0_2, f8),
             int_add(int_mul(f1_2, f7_2),
             int_add(int_mul(f2_2, f6),
             int_add(int_mul(f3_2, f5_2),
             int_add(int_mul(f4,   f4),
                     int_mul(f9,   f9_38))))))
    let h9 = int_add(int_mul(f0_2, f9),
             int_add(int_mul(f1_2, f8),
             int_add(int_mul(f2_2, f7),
             int_add(int_mul(f3_2, f6),
                     int_mul(f4_2, f5)))))
    list_set(out, 0, h0); list_set(out, 1, h1); list_set(out, 2, h2)
    list_set(out, 3, h3); list_set(out, 4, h4); list_set(out, 5, h5)
    list_set(out, 6, h6); list_set(out, 7, h7); list_set(out, 8, h8)
    list_set(out, 9, h9)
    _fe_carry_into(out)
    return 1
}

// ---- multiplication by 121666 -------------------------------------------
//
// Used by the Montgomery ladder as `a24 = 121665`; ladder step needs
// (a24 + 1) * E, i.e. 121666 * E. This is a scalar multiplication so
// only one limb-per-limb pass + wrap is needed. 121666 < 2^17, so
// products stay well under 2^43.

fn fe_mul121666(out, a) {
    let k = 121666
    let h0 = int_mul(a[0], k)
    let h1 = int_mul(a[1], k)
    let h2 = int_mul(a[2], k)
    let h3 = int_mul(a[3], k)
    let h4 = int_mul(a[4], k)
    let h5 = int_mul(a[5], k)
    let h6 = int_mul(a[6], k)
    let h7 = int_mul(a[7], k)
    let h8 = int_mul(a[8], k)
    let h9 = int_mul(a[9], k)
    list_set(out, 0, h0); list_set(out, 1, h1); list_set(out, 2, h2)
    list_set(out, 3, h3); list_set(out, 4, h4); list_set(out, 5, h5)
    list_set(out, 6, h6); list_set(out, 7, h7); list_set(out, 8, h8)
    list_set(out, 9, h9)
    _fe_carry_into(out)
    return 1
}

// ---- modular inverse ----------------------------------------------------
//
// Fermat's little theorem: for prime p, a^(p-2) == a^(-1) (mod p).
//   p - 2 = 2^255 - 21
// Bernstein's addition-chain for this exponent uses 254 squarings and
// 11 multiplications; we transcribe it verbatim from the ref10 layout.
// The chain is data-independent (no branches over `a`); constant-time.

fn fe_invert(out, a) {
    let t0 = fe_new()
    let t1 = fe_new()
    let t2 = fe_new()
    let t3 = fe_new()
    // t0 = a^2
    fe_sq(t0, a)
    // t1 = a^8 = (a^2)^2^2
    fe_sq(t1, t0); fe_sq(t1, t1)
    // t1 = a^9 = t1 * a
    fe_mul(t1, t1, a)
    // t0 = a^11 = t0 * t1
    fe_mul(t0, t0, t1)
    // t2 = a^22 = t0^2
    fe_sq(t2, t0)
    // t1 = a^(2^5 - 1) = a^31 = t2 * t1
    fe_mul(t1, t2, t1)
    // t2 = a^(2^10 - 2^5) = t1^(2^5)
    fe_sq(t2, t1)
    let i = 1
    while i < 5 { fe_sq(t2, t2); i = i + 1 }
    // t1 = a^(2^10 - 1) = t2 * t1
    fe_mul(t1, t2, t1)
    // t2 = a^(2^20 - 2^10) = t1^(2^10)
    fe_sq(t2, t1)
    i = 1
    while i < 10 { fe_sq(t2, t2); i = i + 1 }
    // t2 = a^(2^20 - 1) = t2 * t1
    fe_mul(t2, t2, t1)
    // t3 = a^(2^40 - 2^20) = t2^(2^20)
    fe_sq(t3, t2)
    i = 1
    while i < 20 { fe_sq(t3, t3); i = i + 1 }
    // t2 = a^(2^40 - 1) = t3 * t2
    fe_mul(t2, t3, t2)
    // t2 = a^(2^50 - 2^10) = t2^(2^10)
    fe_sq(t2, t2)
    i = 1
    while i < 10 { fe_sq(t2, t2); i = i + 1 }
    // t1 = a^(2^50 - 1) = t2 * t1
    fe_mul(t1, t2, t1)
    // t2 = a^(2^100 - 2^50) = t1^(2^50)
    fe_sq(t2, t1)
    i = 1
    while i < 50 { fe_sq(t2, t2); i = i + 1 }
    // t2 = a^(2^100 - 1) = t2 * t1
    fe_mul(t2, t2, t1)
    // t3 = a^(2^200 - 2^100) = t2^(2^100)
    fe_sq(t3, t2)
    i = 1
    while i < 100 { fe_sq(t3, t3); i = i + 1 }
    // t2 = a^(2^200 - 1) = t3 * t2
    fe_mul(t2, t3, t2)
    // t2 = a^(2^250 - 2^50) = t2^(2^50)
    fe_sq(t2, t2)
    i = 1
    while i < 50 { fe_sq(t2, t2); i = i + 1 }
    // t1 = a^(2^250 - 1) = t2 * t1
    fe_mul(t1, t2, t1)
    // t1 = a^(2^255 - 2^5) = t1^(2^5)
    fe_sq(t1, t1)
    i = 1
    while i < 5 { fe_sq(t1, t1); i = i + 1 }
    // out = a^(2^255 - 21) = t1 * t0
    fe_mul(out, t1, t0)
    return 1
}

// ---- byte encoding: bytes -> limbs --------------------------------------
//
// Decode 32 little-endian bytes s[0..31] into 10 limbs. Per RFC 7748 §5
// the top bit of s[31] is masked ("MSB of the final byte MUST be
// masked before performing the multiplication"). The layout follows the
// ref10 fe_frombytes bit-extraction pattern.

fn _fe_load3(s, off) {
    let a = load8(s + off)
    let b = load8(s + off + 1)
    let c = load8(s + off + 2)
    return int_or(a, int_or(int_shl(b, 8), int_shl(c, 16)))
}

fn _fe_load4(s, off) {
    let a = load8(s + off)
    let b = load8(s + off + 1)
    let c = load8(s + off + 2)
    let d = load8(s + off + 3)
    return int_or(a,
           int_or(int_shl(b, 8),
           int_or(int_shl(c, 16),
                  int_shl(d, 24))))
}

fn fe_frombytes(out, s) {
    // Materialize a masked copy of s[31] so we don't mutate caller memory.
    let s31_masked = int_and(load8(s + 31), 127)
    // Reassemble a "virtual" 32-byte buffer by using the masked s31 for
    // the top byte. We compute the top windows carefully.
    // Load raw 24/32-bit windows first.
    let w0 = _fe_load4(s, 0)                  // bits   0..31
    let w1 = _fe_load3(s, 4)                  // bits  32..55
    let w2 = _fe_load3(s, 7)                  // bits  56..79
    let w3 = _fe_load3(s, 10)                 // bits  80..103
    let w4 = _fe_load3(s, 13)                 // bits 104..127
    let w5 = _fe_load4(s, 16)                 // bits 128..159
    let w6 = _fe_load3(s, 20)                 // bits 160..183
    let w7 = _fe_load3(s, 23)                 // bits 184..207
    let w8 = _fe_load3(s, 26)                 // bits 208..231
    // Top 32-bit window uses masked s31.
    // w9_raw covers bits 232..255 (bytes 29,30,31) then plus the 7 low
    // bits of the masked byte at position 31. Since we already know
    // it's the top window we compose directly.
    let w9_raw = int_or(load8(s + 29),
                 int_or(int_shl(load8(s + 30), 8),
                        int_shl(s31_masked, 16)))
    // Bit layout for each limb (see header).
    //   h0 = bits   0..25   (26 bits at offset 0)
    //   h1 = bits  26..50   (25 bits at offset 26)
    //   h2 = bits  51..76   (26 bits at offset 51)
    //   h3 = bits  77..101  (25 bits at offset 77)
    //   h4 = bits 102..127  (26 bits at offset 102)
    //   h5 = bits 128..152  (25 bits at offset 128)
    //   h6 = bits 153..178  (26 bits at offset 153)
    //   h7 = bits 179..203  (25 bits at offset 179)
    //   h8 = bits 204..229  (26 bits at offset 204)
    //   h9 = bits 230..254  (25 bits at offset 230)
    // Extractions:
    //   h0 = w0[0..26]
    //   h1 = (w0[26..32] | w1[0..19] shifted) then shift down 26
    //   ...but easier to compose from the 24-bit / 32-bit windows.
    // We compute each limb as a bit-position extraction.
    // Combine w0 (bits 0..31) and w1 (bits 32..55) for h0, h1:
    //   h0 = w0 & MASK26                                (26 bits at 0)
    //   h1 = ((w0 >> 26) | (w1 << 6)) & MASK25          (25 bits at 26)
    let h0 = int_and(w0, FE_MASK_26)
    let h1 = int_and(int_or(int_shr(w0, 26), int_shl(w1, 6)), FE_MASK_25)
    // For h2 need bits 51..76. bits 51..55 = (w1 >> 19) low 5,
    //                            bits 56..76 = w2 low 21.
    //   raw = (w1 >> 19) | (w2 << 5); take low 26.
    let h2 = int_and(int_or(int_shr(w1, 19), int_shl(w2, 5)), FE_MASK_26)
    // h3: bits 77..101.
    //   bit 77..79 = (w2 >> 21) low 3; bit 80..101 = w3 low 22.
    //   raw = (w2 >> 21) | (w3 << 3); low 25.
    let h3 = int_and(int_or(int_shr(w2, 21), int_shl(w3, 3)), FE_MASK_25)
    // h4: bits 102..127.
    //   bit 102..103 = (w3 >> 22) low 2; bit 104..127 = w4 low 24.
    //   raw = (w3 >> 22) | (w4 << 2); low 26.
    let h4 = int_and(int_or(int_shr(w3, 22), int_shl(w4, 2)), FE_MASK_26)
    // h5: bits 128..152.
    //   bit 128..152 = w5 low 25.
    let h5 = int_and(w5, FE_MASK_25)
    // h6: bits 153..178.
    //   bit 153..159 = (w5 >> 25) low 7; bit 160..178 = w6 low 19.
    //   raw = (w5 >> 25) | (w6 << 7); low 26.
    let h6 = int_and(int_or(int_shr(w5, 25), int_shl(w6, 7)), FE_MASK_26)
    // h7: bits 179..203.
    //   bit 179..183 = (w6 >> 19) low 5; bit 184..203 = w7 low 20.
    //   raw = (w6 >> 19) | (w7 << 5); low 25.
    let h7 = int_and(int_or(int_shr(w6, 19), int_shl(w7, 5)), FE_MASK_25)
    // h8: bits 204..229.
    //   bit 204..207 = (w7 >> 20) low 4; bit 208..229 = w8 low 22.
    //   raw = (w7 >> 20) | (w8 << 4); low 26.
    let h8 = int_and(int_or(int_shr(w7, 20), int_shl(w8, 4)), FE_MASK_26)
    // h9: bits 230..254.
    //   bit 230..231 = (w8 >> 22) low 2; bit 232..254 = w9_raw low 23.
    //   raw = (w8 >> 22) | (w9_raw << 2); low 25.
    let h9 = int_and(int_or(int_shr(w8, 22), int_shl(w9_raw, 2)), FE_MASK_25)
    list_set(out, 0, h0); list_set(out, 1, h1); list_set(out, 2, h2)
    list_set(out, 3, h3); list_set(out, 4, h4); list_set(out, 5, h5)
    list_set(out, 6, h6); list_set(out, 7, h7); list_set(out, 8, h8)
    list_set(out, 9, h9)
    return 1
}

// ---- byte encoding: limbs -> canonical 32 bytes -------------------------
//
// Encode a field element to canonical 32-byte little-endian form,
// reducing modulo p = 2^255 - 19 so the output represents a value in
// [0, p).
//
// Strategy (constant-time):
//   1. Carry-propagate to normal form.
//   2. Compute (h + 19) and observe the top-limb carry: it is 1 iff
//      h >= p (because h + 19 >= 2^255 iff h >= 2^255 - 19 = p).
//      In that case replacing h by (h + 19) mod 2^255 yields h - p.
//      The whole thing is done via arithmetic mask, not branching.
//   3. Pack ten limbs into 32 bytes.

fn fe_tobytes(out_bytes, a) {
    // Local canonical copy so we can freely reduce.
    let h = fe_new()
    fe_copy(h, a)
    _fe_carry_into(h)
    _fe_carry_into(h)   // extra pass to guarantee canonical bounds
    // Canonical freeze (constant-time):
    //   compute t = h + 19 with sequential carry UP TO h[9] (do NOT
    //   apply the wrap-around), then inspect bit 25 of t[9]. If set,
    //   h >= p (because h + 19 >= 2^255), and (t with t[9]'s bit 25
    //   cleared) equals h - p. If clear, h < p and we keep h.
    let t = fe_new()
    fe_copy(t, h)
    list_set(t, 0, int_add(t[0], FE_19))
    let c = 0
    c = int_shr(t[0], 26); list_set(t, 1, int_add(t[1], c)); list_set(t, 0, int_and(t[0], FE_MASK_26))
    c = int_shr(t[1], 25); list_set(t, 2, int_add(t[2], c)); list_set(t, 1, int_and(t[1], FE_MASK_25))
    c = int_shr(t[2], 26); list_set(t, 3, int_add(t[3], c)); list_set(t, 2, int_and(t[2], FE_MASK_26))
    c = int_shr(t[3], 25); list_set(t, 4, int_add(t[4], c)); list_set(t, 3, int_and(t[3], FE_MASK_25))
    c = int_shr(t[4], 26); list_set(t, 5, int_add(t[5], c)); list_set(t, 4, int_and(t[4], FE_MASK_26))
    c = int_shr(t[5], 25); list_set(t, 6, int_add(t[6], c)); list_set(t, 5, int_and(t[5], FE_MASK_25))
    c = int_shr(t[6], 26); list_set(t, 7, int_add(t[7], c)); list_set(t, 6, int_and(t[6], FE_MASK_26))
    c = int_shr(t[7], 25); list_set(t, 8, int_add(t[8], c)); list_set(t, 7, int_and(t[7], FE_MASK_25))
    c = int_shr(t[8], 26); list_set(t, 9, int_add(t[9], c)); list_set(t, 8, int_and(t[8], FE_MASK_26))
    // NOTE: intentionally do NOT wrap the top carry back into t[0].
    // The bit-25 of t[9] is our "did we overflow past 2^255" flag.
    let overflow = int_and(int_shr(t[9], 25), 1)
    // Constant-time select: h := (overflow==1) ? (t with top bit cleared) : h.
    // Use multiply-select (branch-free) instead of a mask, since NOVA
    // integers are 63-bit signed positive and a straight bit-mask via
    // subtraction (0 - 1) would go negative.
    //   h_i = h_i * (1 - overflow) + t_prime_i * overflow
    let one_minus = 1 - overflow
    // Clear the top bit of t (mask against 2^25 - 1 in h9)
    list_set(t, 9, int_and(t[9], FE_MASK_25))
    list_set(h, 0, int_add(int_mul(h[0], one_minus), int_mul(t[0], overflow)))
    list_set(h, 1, int_add(int_mul(h[1], one_minus), int_mul(t[1], overflow)))
    list_set(h, 2, int_add(int_mul(h[2], one_minus), int_mul(t[2], overflow)))
    list_set(h, 3, int_add(int_mul(h[3], one_minus), int_mul(t[3], overflow)))
    list_set(h, 4, int_add(int_mul(h[4], one_minus), int_mul(t[4], overflow)))
    list_set(h, 5, int_add(int_mul(h[5], one_minus), int_mul(t[5], overflow)))
    list_set(h, 6, int_add(int_mul(h[6], one_minus), int_mul(t[6], overflow)))
    list_set(h, 7, int_add(int_mul(h[7], one_minus), int_mul(t[7], overflow)))
    list_set(h, 8, int_add(int_mul(h[8], one_minus), int_mul(t[8], overflow)))
    list_set(h, 9, int_add(int_mul(h[9], one_minus), int_mul(t[9], overflow)))
    // Now h is in [0, p). Pack ten 26/25-bit limbs into 32 little-endian
    // bytes. We rebuild the raw 256-bit stream bit by bit.
    //
    // h0 (26 bits) at offset 0
    // h1 (25 bits) at offset 26
    // h2 (26 bits) at offset 51
    // h3 (25 bits) at offset 77
    // h4 (26 bits) at offset 102
    // h5 (25 bits) at offset 128
    // h6 (26 bits) at offset 153
    // h7 (25 bits) at offset 179
    // h8 (26 bits) at offset 204
    // h9 (25 bits) at offset 230  (top bit is guaranteed 0)
    //
    // Bytes are extracted by writing each limb into its correct bit-shift
    // position with OR-carry across neighboring bytes.
    // Initialize output to zero.
    let i = 0
    while i < 32 { store8(out_bytes + i, 0); i = i + 1 }
    _fe_or_bits(out_bytes, h[0], 0,   26)
    _fe_or_bits(out_bytes, h[1], 26,  25)
    _fe_or_bits(out_bytes, h[2], 51,  26)
    _fe_or_bits(out_bytes, h[3], 77,  25)
    _fe_or_bits(out_bytes, h[4], 102, 26)
    _fe_or_bits(out_bytes, h[5], 128, 25)
    _fe_or_bits(out_bytes, h[6], 153, 26)
    _fe_or_bits(out_bytes, h[7], 179, 25)
    _fe_or_bits(out_bytes, h[8], 204, 26)
    _fe_or_bits(out_bytes, h[9], 230, 25)
    return 1
}

// Write `nbits` bits of `value` into out_bytes starting at bit offset
// `bit_off`. OR-in (does not clear other bits). Value must fit in nbits.
fn _fe_or_bits(out_bytes, value, bit_off, nbits) {
    let byte_off = int_shr(bit_off, 3)
    let shift = bit_off - (byte_off * 8)
    // Byte 0
    let b = int_or(load8(out_bytes + byte_off),
                   int_and(int_shl(value, shift), 255))
    store8(out_bytes + byte_off, b)
    // Remaining shifted-down bytes
    let remaining = nbits - (8 - shift)
    let v = int_shr(value, 8 - shift)
    let off = byte_off + 1
    while remaining > 0 {
        let byte_v = int_and(v, 255)
        store8(out_bytes + off, int_or(load8(out_bytes + off), byte_v))
        v = int_shr(v, 8)
        remaining = remaining - 8
        off = off + 1
    }
    return 1
}

// ---- constant-time conditional swap -------------------------------------
//
// If swap == 1, exchange a[i] and b[i] for i in 0..9; if swap == 0,
// leave both untouched. Implementation uses XOR with an arithmetic mask
// (0 or (a[i] XOR b[i])), no data-dependent branching.

fn fe_cswap(a, b, swap) {
    // We need mask such that mask == 0 when swap==0 and mask == "all
    // ones over the limb width" when swap==1. But since limbs are
    // positive-only up to 63 bits, we compute the diff, multiply by
    // `swap` (0 or 1), and XOR each side with it.
    let i = 0
    while i < 10 {
        let ai = a[i]
        let bi = b[i]
        let diff = int_xor(ai, bi)
        let masked = int_mul(diff, swap)
        list_set(a, i, int_xor(ai, masked))
        list_set(b, i, int_xor(bi, masked))
        i = i + 1
    }
    return 1
}
