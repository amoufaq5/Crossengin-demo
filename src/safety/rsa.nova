// CrossEngin safety: RSA signature verification (PKCS#1 v1.5 + PSS), SHA-256.
//
// Purpose
//   X.509 certificate-chain verification (R43) needs RSA: the egress-gateway
//   certs this sandbox presents are RSA-2048. Cert signatures are
//   `sha256WithRSAEncryption` (PKCS#1 v1.5); the TLS 1.3 CertificateVerify an
//   RSA leaf produces is `rsa_pss_rsae_sha256` (PSS, since v1.5 is banned for
//   CertVerify in TLS 1.3). This module supplies both verifiers over the
//   existing `bignum_2048` modexp, plus MGF1.
//
//   Verify-only (no key generation / signing): the recovered EM = s^e mod N is
//   checked against the expected encoding. Constant-timeness is not claimed for
//   the EM comparison -- verification is over public data, so it is not a
//   side-channel target.
//
// NOVA deps: alloc/store8/load8. CrossEngin deps: ../safety/bignum_2048.nova,
//   ../safety/sha256.nova. Validated in tests/unit/test_rsa.nova against
//   openssl-generated PKCS#1 v1.5 and PSS signatures.

import "bignum_2048.nova"
import "sha256.nova"

let RSA_KEY_BYTES = 256        // 2048-bit
let RSA_HASH_LEN  = 32

fn _rsa_nib(v) {
    if v < 10 { return 48 + v }
    return 87 + v                // 'a'..'f'
}

// Byte buffer -> lowercase hex string.
fn _rsa_buf_to_hex(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        s = s + chr(_rsa_nib(int_shr(b, 4))) + chr(_rsa_nib(int_and(b, 15)))
        i = i + 1
    }
    return s
}

fn _rsa_hexv(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70  { return c - 55 } }
    return 0
}

// Hex string -> RSA_KEY_BYTES buffer, left-padded with zeros.
fn _rsa_hex_to_key_buf(hex_str) {
    let buf = alloc(RSA_KEY_BYTES + 1)
    let i = 0
    while i < RSA_KEY_BYTES { store8(buf + i, 0) i = i + 1 }
    let hn = len(hex_str)
    let nbytes = hn / 2
    let off = RSA_KEY_BYTES - nbytes
    let k = 0
    while k < nbytes {
        let hi = _rsa_hexv(char_at(hex_str, k * 2))
        let lo = _rsa_hexv(char_at(hex_str, k * 2 + 1))
        store8(buf + off + k, hi * 16 + lo)
        k = k + 1
    }
    return buf
}

// EM = s^e mod N, as a fixed 256-byte big-endian buffer. e is a small int
// (RSA public exponents are tiny, e.g. 65537) -- converted to a bn here so
// callers (incl. the cert parser, which stores e as an int) never pass the
// wrong type to bn2048_modpow_ct.
fn _rsa_recover_em(sig_buf, sig_n, n_bn, e_int) {
    let s_bn = bn2048_from_hex(_rsa_buf_to_hex(sig_buf, sig_n))
    let em_bn = bn2048_modpow_ct(s_bn, bn2048_from_int(e_int), n_bn)
    return _rsa_hex_to_key_buf(bn2048_to_hex(em_bn))   // bn2048_to_hex is fixed-width
}

fn _rsa_buf_eq(a, b, n) {
    let i = 0
    while i < n { if load8(a + i) != load8(b + i) { return 0 } i = i + 1 }
    return 1
}

// ---- PKCS#1 v1.5 (RFC 8017 EMSA-PKCS1-v1_5) for SHA-256 -------------------
// DigestInfo prefix for id-sha256.
fn _rsa_sha256_digestinfo(out) {
    let p = list_new()
    push(p, 48) push(p, 49) push(p, 48) push(p, 13) push(p, 6) push(p, 9)
    push(p, 96) push(p, 134) push(p, 72) push(p, 1) push(p, 101) push(p, 3)
    push(p, 4) push(p, 2) push(p, 1) push(p, 5) push(p, 0) push(p, 4) push(p, 32)
    let i = 0
    while i < len(p) { store8(out + i, p[i]) i = i + 1 }
    return len(p)
}

// Verify PKCS#1 v1.5 SHA-256 signature. msg_hash is SHA256(message) (32 bytes).
// e is the public exponent as a small int.
fn rsa_pkcs1_sha256_verify(n_bn, e_int, msg_hash, sig_buf, sig_n) {
    let em = _rsa_recover_em(sig_buf, sig_n, n_bn, e_int)
    if load8(em + 0) != 0 { return 0 }
    if load8(em + 1) != 1 { return 0 }
    // PS = 0xFF run (>= 8) terminated by 0x00; find the first non-0xFF byte.
    let i = 2
    let stop = 0
    while stop == 0 {
        if i >= RSA_KEY_BYTES { stop = 1 }
        else if load8(em + i) == 255 { i = i + 1 }
        else { stop = 1 }
    }
    if i < 10 { return 0 }                  // PS too short (< 8 0xFF)
    if load8(em + i) != 0 { return 0 }      // separator
    i = i + 1
    let di = alloc(20)
    let di_n = _rsa_sha256_digestinfo(di)
    if i + di_n + RSA_HASH_LEN != RSA_KEY_BYTES { return 0 }
    if _rsa_buf_eq(em + i, di, di_n) == 0 { return 0 }
    if _rsa_buf_eq(em + i + di_n, msg_hash, RSA_HASH_LEN) == 0 { return 0 }
    return 1
}

// ---- MGF1 (SHA-256) -------------------------------------------------------
fn _rsa_mgf1(seed, seed_n, mask_len) {
    let out = alloc(mask_len + 1)
    let counter = 0
    let written = 0
    while written < mask_len {
        let tin = alloc(seed_n + 4 + 1)
        let j = 0
        while j < seed_n { store8(tin + j, load8(seed + j)) j = j + 1 }
        store8(tin + seed_n + 0, int_and(int_shr(counter, 24), 255))
        store8(tin + seed_n + 1, int_and(int_shr(counter, 16), 255))
        store8(tin + seed_n + 2, int_and(int_shr(counter, 8), 255))
        store8(tin + seed_n + 3, int_and(counter, 255))
        let t = sha256_oneshot(tin, seed_n + 4)
        let copy = RSA_HASH_LEN
        if mask_len - written < copy { copy = mask_len - written }
        let k = 0
        while k < copy { store8(out + written + k, load8(t + k)) k = k + 1 }
        written = written + copy
        counter = counter + 1
    }
    return out
}

// ---- RSA-PSS (RFC 8017 EMSA-PSS-VERIFY), SHA-256, salt len 32 -------------
// 2048-bit modulus -> emBits 2047, emLen 256, hLen 32, sLen 32.
fn rsa_pss_sha256_verify(n_bn, e_int, msg_hash, sig_buf, sig_n) {
    let em = _rsa_recover_em(sig_buf, sig_n, n_bn, e_int)
    let emLen = RSA_KEY_BYTES
    let hLen = RSA_HASH_LEN
    let sLen = RSA_HASH_LEN
    if load8(em + emLen - 1) != 188 { return 0 }     // 0xbc trailer
    // 8*emLen - emBits = 1 leftmost bit of em[0] must be 0.
    if int_and(load8(em + 0), 128) != 0 { return 0 }
    let dbLen = emLen - hLen - 1                       // 223
    let H = em + dbLen
    let dbMask = _rsa_mgf1(H, hLen, dbLen)
    let db = alloc(dbLen + 1)
    let i = 0
    while i < dbLen { store8(db + i, int_xor(load8(em + i), load8(dbMask + i))) i = i + 1 }
    store8(db + 0, int_and(load8(db + 0), 127))        // clear leftmost bit
    // DB = 0x00*(emLen - sLen - hLen - 2) || 0x01 || salt
    let zlen = emLen - sLen - hLen - 2                  // 190
    let z = 0
    while z < zlen { if load8(db + z) != 0 { return 0 } z = z + 1 }
    if load8(db + zlen) != 1 { return 0 }
    let salt = db + zlen + 1
    // M' = (0x00 * 8) || msg_hash || salt ; H' = SHA256(M')
    let mp = alloc(8 + hLen + sLen + 1)
    let a = 0
    while a < 8 { store8(mp + a, 0) a = a + 1 }
    let b = 0
    while b < hLen { store8(mp + 8 + b, load8(msg_hash + b)) b = b + 1 }
    let c = 0
    while c < sLen { store8(mp + 8 + hLen + c, load8(salt + c)) c = c + 1 }
    let hp = sha256_oneshot(mp, 8 + hLen + sLen)
    return _rsa_buf_eq(hp, H, hLen)
}

// Build an RSA public key [N_bn, e_int] from a modulus hex string + exponent.
fn rsa_pubkey_from_hex(mod_hex, exp_int) {
    let k = list_new()
    push(k, bn2048_from_hex(mod_hex))
    push(k, exp_int)
    return k
}
fn rsa_pk_n(k) { return k[0] }
fn rsa_pk_e(k) { return k[1] }
