// CrossEngin safety: RSA signature verification (PKCS#1 v1.5 + PSS).
//
// Purpose
//   X.509 certificate-chain verification (R43) and the TLS 1.3
//   CertificateVerify need RSA. Certificate signatures are
//   sha{256,384,512}WithRSAEncryption (PKCS#1 v1.5); an RSA leaf's
//   CertificateVerify is rsa_pss_rsae_sha{256,384,512} (PSS -- v1.5 is banned
//   there in TLS 1.3).
//
//   PR 4b: moduli of 2048, 3072 and 4096 bits, hashes SHA-256/384/512, over
//   bignum_rsa (width-generic Montgomery, fast public-exponent modpow:
//   ~19 Montgomery multiplications for e=65537 instead of the 4096 of the
//   bignum_2048 constant-time ladder -- every input is public here).
//
//   Verify-only (no key generation / signing): the recovered EM = s^e mod N is
//   checked against the expected encoding. Constant time is not claimed --
//   verification is over public data.
//
//   A key is a modulus N (a list of 32-bit limbs, least significant first:
//   64 / 96 / 128 limbs for 2048 / 3072 / 4096 bits; a 64-limb bignum_2048
//   value is accepted as-is) plus a small int exponent e.
//
// NOVA deps: alloc/store8/load8. CrossEngin deps: bignum_rsa, bignum_2048
//   (kept: callers use bn2048_* through this import), sha256, sha512.
//   Validated in tests/unit/test_rsa.nova and tests/unit/test_rsa_wide.nova
//   against openssl-generated PKCS#1 v1.5 and PSS signatures.

import "std/io"
import "std/string"
import "std/syscall"
import "bignum_2048.nova"
import "bignum_rsa.nova"
import "sha256.nova"
import "sha512.nova"

let RSA_KEY_BYTES = 256        // legacy: RSA-2048 key size in bytes
let RSA_HASH_LEN  = 32         // legacy: SHA-256 digest length

let RSA_H_SHA256 = 1
let RSA_H_SHA384 = 2
let RSA_H_SHA512 = 3

fn _rsa_hash_len(h) {
    if h == RSA_H_SHA256 { return 32 }
    if h == RSA_H_SHA384 { return 48 }
    if h == RSA_H_SHA512 { return 64 }
    return 0
}

fn _rsa_hash(h, buf, n) {
    if h == RSA_H_SHA256 { return sha256_oneshot(buf, n) }
    if h == RSA_H_SHA384 { return sha384_oneshot(buf, n) }
    if h == RSA_H_SHA512 { return sha512_oneshot(buf, n) }
    return 0
}

// Modulus sizes accepted: 2048, 3072, 4096 bits.
fn rsa_key_bytes_ok(k) {
    if k == 256 { return 1 }
    if k == 384 { return 1 }
    if k == 512 { return 1 }
    return 0
}

// Byte length of the modulus (4 per 32-bit limb), or 0.
fn rsa_key_bytes(n_bn) {
    if n_bn == 0 { return 0 }
    return int_mul(len(n_bn), 4)
}

// EM = s^e mod N as a k-byte big-endian buffer, k = modulus byte length.
// RFC 8017 RSAVP1 preconditions (audit F-17): N nonzero, odd, an accepted
// size and filling its width; the signature exactly k bytes with s < N;
// e odd and >= 3. Anything else returns 0 -- there is no fallback path.
fn _rsa_recover_em(sig_buf, sig_n, n_bn, e_int) {
    if n_bn == 0 { return 0 }
    let k = rsa_key_bytes(n_bn)
    if rsa_key_bytes_ok(k) == 0 { return 0 }
    if sig_n != k { return 0 }
    if bnr_is_zero(n_bn) == 1 { return 0 }
    if bnr_is_odd(n_bn) == 0 { return 0 }
    if bnr_bitlen(n_bn) <= int_mul(k - 1, 8) { return 0 }   // top byte must be nonzero
    if e_int < 3 { return 0 }
    if int_and(e_int, 1) == 0 { return 0 }
    let s = bnr_from_be_bytes_n(sig_buf, 0, k, len(n_bn))
    if s == 0 { return 0 }
    if bnr_cmp(s, n_bn) >= 0 { return 0 }
    let ctx = bnr_mont_ctx_new(n_bn)
    if ctx == 0 { return 0 }
    let em = bnr_modpow_pub(s, e_int, ctx)
    if em == 0 { return 0 }
    return bnr_to_be_bytes(em, k)
}

fn _rsa_buf_eq(a, b, n) {
    let i = 0
    while i < n { if load8(a + i) != load8(b + i) { return 0 } i = i + 1 }
    return 1
}

// ---- PKCS#1 v1.5 (RFC 8017 EMSA-PKCS1-v1_5) --------------------------------
// DigestInfo prefixes (19 bytes each, NULL parameters) for SHA-256/384/512.
fn _rsa_digestinfo(h, out) {
    let p = list_new()
    push(p, 48)
    if h == RSA_H_SHA256 { push(p, 49) }
    if h == RSA_H_SHA384 { push(p, 65) }
    if h == RSA_H_SHA512 { push(p, 81) }
    push(p, 48) push(p, 13) push(p, 6) push(p, 9)
    push(p, 96) push(p, 134) push(p, 72) push(p, 1) push(p, 101) push(p, 3)
    push(p, 4) push(p, 2)
    if h == RSA_H_SHA256 { push(p, 1) }
    if h == RSA_H_SHA384 { push(p, 2) }
    if h == RSA_H_SHA512 { push(p, 3) }
    push(p, 5) push(p, 0) push(p, 4) push(p, _rsa_hash_len(h))
    let i = 0
    while i < len(p) { store8(out + i, p[i]) i = i + 1 }
    return len(p)
}

// Verify a PKCS#1 v1.5 signature. msg_hash is Hash(message) for the hash
// `h` (RSA_H_SHA256/384/512). Builds the one valid encoding
//   EM' = 00 01 FF..FF 00 || DigestInfo || H
// and compares all k bytes.
fn rsa_pkcs1_verify(n_bn, e_int, h, msg_hash, sig_buf, sig_n) {
    let hlen = _rsa_hash_len(h)
    if hlen == 0 { return 0 }
    let em = _rsa_recover_em(sig_buf, sig_n, n_bn, e_int)
    if em == 0 { return 0 }
    let k = sig_n
    let di = alloc(20)
    let di_n = _rsa_digestinfo(h, di)
    let ps = k - 3 - di_n - hlen
    if ps < 8 { return 0 }
    if load8(em + 0) != 0 { return 0 }
    if load8(em + 1) != 1 { return 0 }
    let i = 2
    while i < 2 + ps {
        if load8(em + i) != 255 { return 0 }
        i = i + 1
    }
    if load8(em + i) != 0 { return 0 }
    i = i + 1
    if _rsa_buf_eq(em + i, di, di_n) == 0 { return 0 }
    if _rsa_buf_eq(em + i + di_n, msg_hash, hlen) == 0 { return 0 }
    return 1
}

fn rsa_pkcs1_sha256_verify(n_bn, e_int, msg_hash, sig_buf, sig_n) {
    return rsa_pkcs1_verify(n_bn, e_int, RSA_H_SHA256, msg_hash, sig_buf, sig_n)
}

// ---- MGF1 ----------------------------------------------------------------
fn _rsa_mgf1(h, seed, seed_n, mask_len) {
    let hlen = _rsa_hash_len(h)
    let out = alloc(mask_len + 1)
    let counter = 0
    let written = 0
    while written < mask_len {
        let tin = alloc(seed_n + 4 + 1)
        let j = 0
        while j < seed_n { store8(tin + j, load8(seed + j)) j = j + 1 }
        store8(tin + seed_n + 0, int_and(int_shr(counter, 24), 255))
        store8(tin + seed_n + 1, int_and(int_shr(counter, 16), 255))
        store8(tin + seed_n + 2, int_and(int_shr(counter, 8), 255))
        store8(tin + seed_n + 3, int_and(counter, 255))
        let t = _rsa_hash(h, tin, seed_n + 4)
        let copy = hlen
        if mask_len - written < copy { copy = mask_len - written }
        let k = 0
        while k < copy { store8(out + written + k, load8(t + k)) k = k + 1 }
        written = written + copy
        counter = counter + 1
    }
    return out
}

// ---- RSA-PSS (RFC 8017 9.1.2 EMSA-PSS-VERIFY) ----------------------------
// Hash and MGF1 hash `h`, salt length s_len. modBits comes from N, so a
// modulus whose bit length is 8k-7..8k is handled (emLen = k or k-1).
fn rsa_pss_verify(n_bn, e_int, h, s_len, msg_hash, sig_buf, sig_n) {
    let hlen = _rsa_hash_len(h)
    if hlen == 0 { return 0 }
    if s_len < 0 { return 0 }
    let full = _rsa_recover_em(sig_buf, sig_n, n_bn, e_int)
    if full == 0 { return 0 }
    let k = sig_n
    let em_bits = bnr_bitlen(n_bn) - 1
    let em_len = int_shr(em_bits + 7, 3)
    let em = full
    if em_len == k - 1 {
        if load8(full) != 0 { return 0 }
        em = full + 1
    }
    if em_len < hlen + s_len + 2 { return 0 }
    if load8(em + em_len - 1) != 188 { return 0 }     // 0xbc trailer
    // The leftmost 8*emLen - emBits bits of EM must be zero.
    let zbits = int_mul(em_len, 8) - em_bits
    let keep = int_shr(255, zbits)
    if int_and(load8(em), int_xor(keep, 255)) != 0 { return 0 }
    let db_len = em_len - hlen - 1
    let H = em + db_len
    let mask = _rsa_mgf1(h, H, hlen, db_len)
    let db = alloc(db_len + 1)
    let i = 0
    while i < db_len { store8(db + i, int_xor(load8(em + i), load8(mask + i))) i = i + 1 }
    store8(db, int_and(load8(db), keep))
    // DB = 0x00 * (emLen - sLen - hLen - 2) || 0x01 || salt
    let zlen = em_len - s_len - hlen - 2
    let z = 0
    while z < zlen { if load8(db + z) != 0 { return 0 } z = z + 1 }
    if load8(db + zlen) != 1 { return 0 }
    let salt = db + zlen + 1
    // M' = 0x00 * 8 || mHash || salt ; H' = Hash(M')
    let mp = alloc(8 + hlen + s_len + 1)
    let a = 0
    while a < 8 { store8(mp + a, 0) a = a + 1 }
    let b = 0
    while b < hlen { store8(mp + 8 + b, load8(msg_hash + b)) b = b + 1 }
    let c = 0
    while c < s_len { store8(mp + 8 + hlen + c, load8(salt + c)) c = c + 1 }
    let hp = _rsa_hash(h, mp, 8 + hlen + s_len)
    return _rsa_buf_eq(hp, H, hlen)
}

// TLS 1.3 rsa_pss_rsae_* (RFC 8446 4.2.3): salt length = hash length.
fn rsa_pss_sha256_verify(n_bn, e_int, msg_hash, sig_buf, sig_n) {
    return rsa_pss_verify(n_bn, e_int, RSA_H_SHA256, 32, msg_hash, sig_buf, sig_n)
}
fn rsa_pss_sha384_verify(n_bn, e_int, msg_hash, sig_buf, sig_n) {
    return rsa_pss_verify(n_bn, e_int, RSA_H_SHA384, 48, msg_hash, sig_buf, sig_n)
}
fn rsa_pss_sha512_verify(n_bn, e_int, msg_hash, sig_buf, sig_n) {
    return rsa_pss_verify(n_bn, e_int, RSA_H_SHA512, 64, msg_hash, sig_buf, sig_n)
}

// Build an RSA public key [N, e_int] from a modulus hex string + exponent.
// The width follows the hex length (512 hex digits -> 64 limbs).
fn rsa_pubkey_from_hex(mod_hex, exp_int) {
    let k = list_new()
    push(k, bnr_from_hex(mod_hex))
    push(k, exp_int)
    return k
}
fn rsa_pk_n(k) { return k[0] }
fn rsa_pk_e(k) { return k[1] }
