// CrossEngin Phase 1 pt1: safety attestation log.
//
// Purpose
//   Thin wrapper around src/audit/decision_log.nova so every
//   capability-gate decision at the chat REPL writes a hash-chained,
//   append-only attestation record. Reuses the DLK_DECISION kind
//   under a new subtype DREC_ATTEST added in decision_record.nova.
//
//   The durable payload is:
//     subtype = DREC_ATTEST
//     scalar  = CAP_* code
//     flag    = CG_ALLOW / CG_REQUIRE_APPROVAL / CG_DENY
//     outcome = OUT_OK on allow/approve, OUT_VETOED on deny
//
//   Human-readable renderer provided for /__safety__ output; the full
//   history is already walked by the generic decision-log reader.
//
// NOVA dependencies: builtins.
// CrossEngin dependencies:
//   src/parts/reasoning/decision_record.nova (DREC_ATTEST, drec_*
//     getters, ACLASS_REASONING, _drec_desc_isomorph via dl_append),
//   src/audit/decision_log.nova (dl_append / dl_count / dl_get /
//     DLK_DECISION / OUT_OK / OUT_VETOED),
//   src/safety/capability_gate.nova (cg_capability_name,
//     cg_decision_name).

import "std/io"
import "std/string"
import "std/syscall"
import "../parts/reasoning/decision_record.nova"
import "../audit/decision_log.nova"
import "./capability_gate.nova"

// Append one attestation entry. Returns the entry's seq (per dl_append).
fn sl_attest(log, cap, decision, now) {
    if log == 0 { return 0 - 1 }
    let outcome = OUT_OK
    if decision == CG_DENY { outcome = OUT_VETOED }
    let desc = list_new()
    push(desc, ACLASS_REASONING)
    push(desc, DREC_ATTEST)
    push(desc, cap)
    push(desc, decision)
    return dl_append(log, DLK_DECISION, 0 - 1, now, desc, 0, list_new(), 0, outcome)
}

// Render an attestation entry at log index `i`. Returns "" for a
// non-attest row so callers can skip.
fn sl_render(log, i) {
    let e = dl_get(log, i)
    if drec_is_decision(e) == 0 { return "" }
    if drec_subtype(e) != DREC_ATTEST { return "" }
    let cap = drec_scalar(e)
    let dec = drec_flag(e)
    return "#" + int_to_str(dl_seq(e)) + " attest "
         + cg_capability_name(cap) + " -> " + cg_decision_name(dec)
}

// Walk the full log and copy out the last N attestation entry indices
// (most recent last). Caller passes `limit = 0` for all. Returns a
// list<int> of log indices suitable for sl_render.
fn sl_recent_indices(log, limit) {
    let out = list_new()
    if log == 0 { return out }
    let n = dl_count(log)
    let i = 0
    while i < n {
        let e = dl_get(log, i)
        if drec_is_decision(e) == 1 {
            if drec_subtype(e) == DREC_ATTEST {
                push(out, i)
            }
        }
        i = i + 1
    }
    if limit <= 0 { return out }
    let total = len(out)
    if total <= limit { return out }
    let trimmed = list_new()
    let j = total - limit
    while j < total {
        push(trimmed, out[j])
        j = j + 1
    }
    return trimmed
}
