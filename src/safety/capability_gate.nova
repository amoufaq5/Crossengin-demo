// CrossEngin safety: capability / authorization gate (ADR-0094).
//
// Purpose
//   The single enforcement point for the ADR-0094 threat model: a pure,
//   side-effect-free decision module that answers "may this sensitive operation
//   proceed?" with one of ALLOW / REQUIRE_APPROVAL / DENY. It complements the
//   permission tiers of ADR-0041 (which classify *how* an approved action runs)
//   and the governed promotion gates of ADR-0092 (which guard the KB), by
//   deciding *whether* a capability is exercised at all, given the request's
//   risk inputs. It holds no global state and performs no I/O, so it is trivially
//   auditable and re-orderable in the defense-in-depth stack.
//
//   Design stance (ADR-0094): fail CLOSED. An unrecognized capability, or a
//   capability whose risk inputs are not satisfied, denies rather than guesses.
//   Governance is never silently editable (surface 7); outward / irreversible
//   actions are never silently autonomous; unclean ingestion sources are
//   quarantined (surface 1, Rule 3).
//
// ADRs implemented: ADR-0094 (threat model enforcement point). Related:
//   ADR-0041 (permission tiers), ADR-0045/0092 (governance & self-update),
//   ADR-0044 (reversibility), ADR-0087 (provenance/source cleanliness).
// NOVA dependencies: builtins only. CrossEngin dependencies: none.

// ---- capability codes (the sensitive operations the threat model names) ----
// Small ints: safe to compare with == (well below the 0x100000 deref threshold).
let CAP_READ_KB          = 1   // read knowledge base (read-only)
let CAP_ANSWER           = 2   // emit an answer to the user (read-only egress of belief)
let CAP_AUTONOMOUS_FETCH = 3   // pull from the open web in the autonomous loop
let CAP_INGEST_ATOM      = 4   // mint a CANDIDATE atom from a source
let CAP_PROMOTE_ATOM     = 5   // move an atom CANDIDATE -> PROMOTED
let CAP_SELF_UPDATE      = 6   // modify the agent's own code / safety gates
let CAP_EDIT_GOVERNANCE  = 7   // edit constitution / soul / governance config
let CAP_NETWORK_SEND     = 8   // send data outward over the network
let CAP_DELETE           = 9   // delete / hard-remove data

fn cg_capability_name(c) {
    if c == CAP_READ_KB          { return "read_kb" }
    if c == CAP_ANSWER           { return "answer" }
    if c == CAP_AUTONOMOUS_FETCH { return "autonomous_fetch" }
    if c == CAP_INGEST_ATOM      { return "ingest_atom" }
    if c == CAP_PROMOTE_ATOM     { return "promote_atom" }
    if c == CAP_SELF_UPDATE      { return "self_update" }
    if c == CAP_EDIT_GOVERNANCE  { return "edit_governance" }
    if c == CAP_NETWORK_SEND     { return "network_send" }
    if c == CAP_DELETE           { return "delete" }
    return "unknown"
}

// ---- authorization decisions (least -> most restrictive) -------------------
let CG_ALLOW            = 1   // proceed silently
let CG_REQUIRE_APPROVAL = 2   // suspend, require explicit human approval (ADR-0041 APPROVE)
let CG_DENY             = 3   // refuse outright (and, by ADR-0092, log)

fn cg_decision_name(d) {
    if d == CG_ALLOW            { return "allow" }
    if d == CG_REQUIRE_APPROVAL { return "require_approval" }
    if d == CG_DENY             { return "deny" }
    return "unknown"
}

// ---- context bundle (the request's risk inputs) ----------------------------
// A list of <=6 flag fields, each 0/1:
//   authorized        - an explicit human/operator authorization is present
//   touches_governance- the op would alter constitution/soul/safety gates
//   reversible        - the op is recoverable (ADR-0044) if it turns out wrong
//   source_clean      - the source passed provenance/license screening (ADR-0087)
let CG_CTX_AUTHORIZED  = 0
let CG_CTX_GOVERNANCE  = 1
let CG_CTX_REVERSIBLE  = 2
let CG_CTX_SRC_CLEAN   = 3
let CG_CTX_FIELDS      = 4

fn cg_ctx_new(authorized, touches_governance, reversible, source_clean) {
    let ctx = list_new()
    push(ctx, authorized)
    push(ctx, touches_governance)
    push(ctx, reversible)
    push(ctx, source_clean)
    return ctx
}

fn _cg_ctx_get(ctx, idx) {
    if idx < 0 { return 0 }
    if idx >= len(ctx) { return 0 }
    return ctx[idx]
}

fn cg_ctx_authorized(ctx)         { return _cg_ctx_get(ctx, CG_CTX_AUTHORIZED) }
fn cg_ctx_touches_governance(ctx) { return _cg_ctx_get(ctx, CG_CTX_GOVERNANCE) }
fn cg_ctx_reversible(ctx)         { return _cg_ctx_get(ctx, CG_CTX_REVERSIBLE) }
fn cg_ctx_source_clean(ctx)       { return _cg_ctx_get(ctx, CG_CTX_SRC_CLEAN) }

// ---- the core decision -----------------------------------------------------
// cg_decide(capability, ctx) -> CG_ALLOW / CG_REQUIRE_APPROVAL / CG_DENY.
// Each rule carries a one-line rationale tied to the ADR-0094 surfaces.
fn cg_decide(capability, ctx) {
    let auth = cg_ctx_authorized(ctx)
    let gov  = cg_ctx_touches_governance(ctx)
    let rev  = cg_ctx_reversible(ctx)
    let clean = cg_ctx_source_clean(ctx)

    // READ_KB / ANSWER: read-only, no mutation, no egress of data the user did
    // not already entrust -> always safe (surface scope: none). ALLOW.
    if capability == CAP_READ_KB { return CG_ALLOW }
    if capability == CAP_ANSWER  { return CG_ALLOW }

    // AUTONOMOUS_FETCH / INGEST_ATOM: knowledge-poisoning surface (surface 1).
    // Rule 3 / quarantine: a source that failed provenance screening is never
    // ingested -> DENY; a clean source may be pulled/minted as CANDIDATE -> ALLOW
    // (promotion still gated separately by ADR-0092 / CAP_PROMOTE_ATOM).
    if capability == CAP_AUTONOMOUS_FETCH {
        if clean == 1 { return CG_ALLOW }
        return CG_DENY
    }
    if capability == CAP_INGEST_ATOM {
        if clean == 1 { return CG_ALLOW }
        return CG_DENY
    }

    // PROMOTE_ATOM: belief-change gate (surface 1). A promotion that would touch
    // governance is forbidden here (governance has its own path) -> DENY. An
    // irreversible promotion must be human-reviewed (ADR-0044) -> REQUIRE_APPROVAL.
    // Otherwise a reversible, non-governance promotion may proceed -> ALLOW.
    if capability == CAP_PROMOTE_ATOM {
        if gov == 1 { return CG_DENY }
        if rev == 0 { return CG_REQUIRE_APPROVAL }
        return CG_ALLOW
    }

    // EDIT_GOVERNANCE: surface 7 (constitution / soul / safety gates). Governance
    // is never silently editable. Without explicit authorization -> DENY; even
    // WITH authorization the most permissive outcome is REQUIRE_APPROVAL, never a
    // silent ALLOW (ties to ADR-0045 hard rules, ADR-0092 refuse-and-log).
    if capability == CAP_EDIT_GOVERNANCE {
        if auth == 1 { return CG_REQUIRE_APPROVAL }
        return CG_DENY
    }

    // SELF_UPDATE / DELETE / NETWORK_SEND: irreversible or outward-facing
    // (surfaces 7, 3/storage, 8 egress). If the op would touch governance it is a
    // self-modification of safety gates -> DENY outright. Without explicit
    // authorization -> REQUIRE_APPROVAL (never silently autonomous). With
    // authorization and no governance touch -> REQUIRE_APPROVAL is still the
    // ceiling for these high-blast-radius ops.
    if capability == CAP_SELF_UPDATE  { return _cg_irreversible_outward(auth, gov) }
    if capability == CAP_DELETE       { return _cg_irreversible_outward(auth, gov) }
    if capability == CAP_NETWORK_SEND { return _cg_irreversible_outward(auth, gov) }

    // Fail CLOSED: an unknown capability is denied (ADR-0094 default-deny).
    return CG_DENY
}

// Shared rule for irreversible / outward capabilities. Governance touch is fatal
// (self-editing safety gates); otherwise these always require human approval.
fn _cg_irreversible_outward(auth, gov) {
    if gov == 1 { return CG_DENY }
    return CG_REQUIRE_APPROVAL
}

// Convenience gate: 1 iff the operation is silently allowed, else 0.
fn cg_is_allowed(capability, ctx) {
    if cg_decide(capability, ctx) == CG_ALLOW { return 1 }
    return 0
}
