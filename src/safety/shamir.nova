// CrossEngin safety: t-of-n Shamir secret sharing over GF(2^8).
//
// Purpose
//   SecAgg v4 (Bonawitz et al. 2017 double masking, plan item A2) has each
//   soul split two 32-byte secrets per round: its self-mask seed b_u and its
//   X25519 mask private key s_u^SK. Any t shares recover a secret; t-1
//   shares reveal nothing about it (information-theoretically, per byte).
//
// Scheme
//   Each byte of the secret is shared independently. For byte j the dealer
//   picks a random polynomial of degree t-1 over GF(2^8) (src/safety/
//   gf256.nova) with constant term secret[j]:
//     f_j(x) = secret[j] + c_1[j] x + ... + c_{t-1}[j] x^{t-1}
//   Share i is (x_i, [f_0(x_i), ..., f_{len-1}(x_i)]) with x_i = i, i = 1..n.
//   Recovery is Lagrange interpolation at 0:
//     secret[j] = XOR_i  lambda_i * y_i[j],
//     lambda_i  = prod_{m != i} x_m / prod_{m != i} (x_m XOR x_i).
//   Any set of at least t distinct shares gives the secret. Fewer than t
//   shares give some other value with no error: the caller must know t.
//
// Representation
//   A share is a list [x, buf, len]: x in 1..255, buf an alloc'd byte
//   buffer and len its length in bytes (shamir_split sets it to the
//   secret's length). shamir_combine refuses a share whose len differs from
//   the slen it is asked for, so a short or foreign share can never make it
//   read past a buffer. A caller that builds a share from received bytes
//   (A2.3+) must set len to the number of bytes it actually received.
//   The 2-element form [x, buf] is refused.
//
// Side channels (best effort)
//   Secret bytes, coefficients and share bytes only pass through gf256_mul /
//   int_xor. The x coordinates and therefore the Lagrange coefficients are
//   public, so the interpolation set-up may branch on them.
//
// Public API
//   shamir_split(rng_ctx, secret_buf, slen, t, n)
//       -> list of n shares, or 0 on bad parameters or RNG failure.
//          rng_ctx is a src/safety/rng.nova context (rng_os_new in
//          production, rng_test_new in tests). Coefficients are wiped
//          after use.
//   shamir_split_coeffs(secret_buf, slen, t, n, coeff_buf)
//       -> list of n shares, using caller-supplied coefficients:
//          coeff_buf holds (t-1)*slen bytes, c_1 first, then c_2, ...
//          For test vectors only; production uses shamir_split.
//   shamir_combine(shares, slen)
//       -> a fresh slen-byte buffer, or 0 when shares is empty, has more
//          than 255 entries, has an x outside 1..255, repeats an x, or has
//          a share without a buffer or whose len is not slen.
//   shamir_share(x, buf, len) -> a share list (for callers that receive
//          share bytes over the wire)
//   shamir_lagrange0(xs) -> list of lambda_i (public helper, for tests)
//   shamir_share_x(share), shamir_share_buf(share), shamir_share_len(share)
//
// Parameters: 1 <= t <= n <= 255 and slen >= 1. t = 1 copies the secret
// into every share (no secrecy); callers choose t >= 2.
//
// Test parity: tests/unit/test_shamir.nova, against an independent Python
// reference (plan file A2.0 vectors S0-S3).
//
// NOVA dependencies: builtins (alloc, load8, store8, list_*).
// CrossEngin dependencies: src/safety/gf256.nova, src/safety/rng.nova.

import "./gf256.nova"
import "./rng.nova"

let SHAMIR_MAX_SHARES = 255
let SHAMIR_S_X = 0
let SHAMIR_S_BUF = 1
let SHAMIR_S_LEN = 2

fn shamir_share(x, buf, n) {
    let s = list_new()
    push(s, x)
    push(s, buf)
    push(s, n)
    return s
}

fn shamir_share_x(share) {
    return share[0]
}

fn shamir_share_buf(share) {
    return share[1]
}

fn shamir_share_len(share) {
    return share[2]
}

fn _shamir_params_ok(slen, t, n) {
    if slen < 1 { return 0 }
    if t < 1 { return 0 }
    if n < t { return 0 }
    if n > 255 { return 0 }
    return 1
}

fn _shamir_zero(buf, n) {
    let i = 0
    while i < n {
        store8(buf + i, 0)
        i = i + 1
    }
    return 1
}

// Evaluate every byte polynomial at x (Horner, highest coefficient first).
fn _shamir_eval(secret_buf, slen, t, coeff_buf, x) {
    let out = alloc(slen + 1)
    let j = 0
    while j < slen {
        let y = 0
        let k = t - 1
        while k >= 1 {
            let c = load8(coeff_buf + (k - 1) * slen + j)
            y = int_xor(gf256_mul(y, x), c)
            k = k - 1
        }
        y = int_xor(gf256_mul(y, x), load8(secret_buf + j))
        store8(out + j, y)
        j = j + 1
    }
    store8(out + slen, 0)
    return out
}

fn shamir_split_coeffs(secret_buf, slen, t, n, coeff_buf) {
    if _shamir_params_ok(slen, t, n) == 0 { return 0 }
    if secret_buf == 0 { return 0 }
    if t > 1 {
        if coeff_buf == 0 { return 0 }
    }
    let shares = list_new()
    let x = 1
    while x <= n {
        push(shares, shamir_share(x, _shamir_eval(secret_buf, slen, t, coeff_buf, x), slen))
        x = x + 1
    }
    return shares
}

fn shamir_split(rng_ctx, secret_buf, slen, t, n) {
    if _shamir_params_ok(slen, t, n) == 0 { return 0 }
    if secret_buf == 0 { return 0 }
    let clen = (t - 1) * slen
    let coeffs = alloc(clen + 1)
    // rng_read serves at most 65536 bytes per call.
    let off = 0
    while off < clen {
        let take = clen - off
        if take > 65536 { take = 65536 }
        if rng_read(rng_ctx, coeffs + off, take) != 1 {
            _shamir_zero(coeffs, clen)
            return 0
        }
        off = off + take
    }
    let shares = shamir_split_coeffs(secret_buf, slen, t, n, coeffs)
    _shamir_zero(coeffs, clen)
    return shares
}

// lambda_i = prod_{m != i} x_m / prod_{m != i} (x_m XOR x_i). Public data.
fn shamir_lagrange0(xs) {
    let k = len(xs)
    let out = list_new()
    let i = 0
    while i < k {
        let num = 1
        let den = 1
        let m = 0
        while m < k {
            if m != i {
                num = gf256_mul(num, xs[m])
                den = gf256_mul(den, int_xor(xs[m], xs[i]))
            }
            m = m + 1
        }
        push(out, gf256_div(num, den))
        i = i + 1
    }
    return out
}

fn _shamir_xs_ok(shares, slen) {
    let k = len(shares)
    if k < 1 { return 0 }
    if k > 255 { return 0 }
    let seen = alloc(257)
    _shamir_zero(seen, 256)
    let i = 0
    while i < k {
        let s = shares[i]
        if len(s) != 3 { return 0 }
        let x = s[0]
        if x < 1 { return 0 }
        if x > 255 { return 0 }
        if s[1] == 0 { return 0 }
        if s[2] != slen { return 0 }
        if load8(seen + x) != 0 { return 0 }
        store8(seen + x, 1)
        i = i + 1
    }
    return 1
}

fn shamir_combine(shares, slen) {
    if slen < 1 { return 0 }
    if _shamir_xs_ok(shares, slen) == 0 { return 0 }
    let k = len(shares)
    let xs = list_new()
    let i = 0
    while i < k {
        push(xs, shares[i][0])
        i = i + 1
    }
    let lam = shamir_lagrange0(xs)
    let out = alloc(slen + 1)
    let j = 0
    while j < slen {
        let acc = 0
        i = 0
        while i < k {
            let buf = shares[i][1]
            acc = int_xor(acc, gf256_mul(lam[i], load8(buf + j)))
            i = i + 1
        }
        store8(out + j, acc)
        j = j + 1
    }
    store8(out + slen, 0)
    return out
}
