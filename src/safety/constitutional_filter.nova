// CrossEngin safety: constitutional filter (the safety gate).
//
// Purpose
//   The single chokepoint every candidate action passes through (ADR-0045 +
//   ADR-0041 + ADR-0042). It composes, in order:
//     1. constitutional veto -- a hard inhibitory bit from the soul watcher
//        (ADR-0034/0045); TERMINAL, and no in-the-moment user approval can clear
//        it (only deliberate constitutional revision can).
//     2. hard stop -- the ADR-0044 safety_halt; actions drain without executing.
//     3. permission tier -- ADR-0041, which already folds the ADR-0042
//        reversibility floor; APPROVE suspends unless the user has approved.
//   Every gated decision must be logged (ADR-0043, wired by the action loop).
//   For enterprise-vs-user conflicts, loyalty_resolve reads the soul loyalty
//   hierarchy (ADR-0034/0047) with the constitution pinned above all. Enforcement
//   is pure substrate -- NO LLM (ADR-0014).
//
// ADRs implemented: ADR-0045 (constitutional rules + loyalty resolution),
//   ADR-0041 (permission gate), ADR-0042 (reversibility floor, via the tier).
//   NOVA dependencies: builtins. CrossEngin dependencies:
//   src/safety/permission_tiers.nova (-> reversibility_classifier.nova),
//   src/parts/soul/constitution.nova, src/parts/soul/loyalty.nova.

import "permission_tiers.nova"
import "../parts/soul/constitution.nova"
import "../parts/soul/loyalty.nova"

// ---- gate decisions -------------------------------------------------------
let GATE_EXECUTE = 1   // run now
let GATE_NOTIFY  = 2   // run + notify + log
let GATE_SUSPEND = 3   // hold for user approval
let GATE_VETOED  = 4   // constitutional veto -- terminal, never executes
let GATE_HALTED  = 5   // hard stop active -- drain, do not execute

fn gate_name(d) {
    if d == GATE_EXECUTE { return "execute" }
    if d == GATE_NOTIFY  { return "notify" }
    if d == GATE_SUSPEND { return "suspend" }
    if d == GATE_VETOED  { return "vetoed" }
    if d == GATE_HALTED  { return "halted" }
    return "unknown"
}

// The gate chain. const_veto and halted are bits the caller derives from the
// soul watcher (const_veto_for) and override state (safety_is_halted);
// user_approved is the in-the-moment approval. A constitutional veto is checked
// first and is terminal -- user_approved can clear an APPROVE tier but NEVER a
// veto.
fn safety_gate(action_type, const_veto, halted, user_approved) {
    if const_veto == 1 { return GATE_VETOED }
    if halted == 1     { return GATE_HALTED }
    let tier = perm_effective_tier(action_type)
    if tier == PERM_APPROVE {
        if user_approved == 1 { return GATE_EXECUTE }
        return GATE_SUSPEND
    }
    if tier == PERM_NOTIFY { return GATE_NOTIFY }
    return GATE_EXECUTE
}

// Every gated action is logged (ADR-0043): there is no silent path.
fn gate_must_log(decision) { return 1 }

// Does the decision permit the effector to run?
fn gate_executes(decision) {
    if decision == GATE_EXECUTE { return 1 }
    if decision == GATE_NOTIFY  { return 1 }
    return 0
}

// The constitutional veto bit for a candidate action, read from the soul
// watcher (ADR-0034/0045): 1 if any BLOCK/OVERRIDE rule's forbidden text occurs
// in the action. Text-only -- the legacy literal-substring path used by the
// effector-side governed-speak hook.
fn const_veto_for(sl, action_text) {
    if soul_check_constitution(sl, action_text) == 0 { return 1 }
    return 0
}

// Concept-keyed veto bit (ADR-0045, semantic-intent extension): 1 if any
// BLOCK/OVERRIDE concept rule's forbidden concept handle matches a perceived
// concept handle directly OR through the P14 neighborhood (operator + xref +
// word-sense). This is the input-side hook the action loop wires before it
// dispatches the speech effector -- it catches paraphrases that route to a
// neighbor of the forbidden concept even when the literal keyword is absent.
// percept_handles is the active concept handle list ctx_percept produces.
fn const_concept_veto_for(sl, kg_reg, percept_handles) {
    if soul_check_constitution_concepts(sl, kg_reg, percept_handles) == 0 { return 1 }
    return 0
}

// Composite input-side check: text veto on the raw input OR concept veto on
// the perceived handles. Either path triggers the constitutional gate; the
// text path is the original keyword filter (kept for backwards compat and as
// a defense-in-depth check), the concept path is the new semantic-intent
// gate. Returns 1 if vetoed.
fn const_input_veto_for(sl, action_text, kg_reg, percept_handles) {
    if const_veto_for(sl, action_text) == 1 { return 1 }
    if const_concept_veto_for(sl, kg_reg, percept_handles) == 1 { return 1 }
    return 0
}

// Loyalty resolution (ADR-0045/0047): the constitution outranks every
// stakeholder; below it, the higher soul loyalty wins. Returns the winning
// entity name.
fn loyalty_resolve(sl, entity_a, entity_b) {
    if str_eq(entity_a, "constitution") == 1 { return entity_a }
    if str_eq(entity_b, "constitution") == 1 { return entity_b }
    return soul_loyalty_dominant(sl, entity_a, entity_b)
}
