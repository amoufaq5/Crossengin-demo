// CrossEngin safety: permission tiers.
//
// Purpose
//   Three permission tiers (ADR-0041), least to most restrictive: AUTO (execute
//   immediately), NOTIFY (execute + notify + log), APPROVE (suspend and require
//   user approval). Each action class has a static default tier; the effective
//   tier is the MAX of that default and the reversibility floor (ADR-0042), so
//   irreversible actions are always forced to >= APPROVE. Unknown action classes
//   default to APPROVE (fail-safe). Guard predicates may only raise the tier.
//
// ADRs implemented: ADR-0041 (permission tiers). NOVA dependencies: builtins.
// CrossEngin dependencies: src/safety/reversibility_classifier.nova.

import "reversibility_classifier.nova"

// ---- tiers (least -> most restrictive) ------------------------------------
let PERM_AUTO    = 1
let PERM_NOTIFY  = 2
let PERM_APPROVE = 3

fn perm_tier_name(t) {
    if t == PERM_AUTO    { return "auto" }
    if t == PERM_NOTIFY  { return "notify" }
    if t == PERM_APPROVE { return "approve" }
    return "unknown"
}

// Static default tier per action class. Unknown -> APPROVE (fail-safe).
fn perm_default(action_class) {
    if action_class == ACT_READ_LOCAL  { return PERM_AUTO }
    if action_class == ACT_RECALL      { return PERM_AUTO }
    if action_class == ACT_SPEAK       { return PERM_AUTO }
    if action_class == ACT_NET_FETCH   { return PERM_NOTIFY }
    if action_class == ACT_WRITE_LOCAL { return PERM_NOTIFY }
    if action_class == ACT_DELETE      { return PERM_NOTIFY }
    if action_class == ACT_SEND_MSG    { return PERM_APPROVE }
    if action_class == ACT_HARD_DELETE { return PERM_APPROVE }
    if action_class == ACT_SPEND       { return PERM_APPROVE }
    if action_class == ACT_SELF_MODIFY { return PERM_APPROVE }
    return PERM_APPROVE
}

// The permission floor implied by an action's reversibility (ADR-0042 -> 0041).
fn reversibility_floor(action_type) {
    let c = reversibility_class(action_type)
    if c == REV_IRREVERSIBLE { return PERM_APPROVE }
    if c == REV_RECOVERABLE  { return PERM_NOTIFY }
    return PERM_AUTO
}

// The effective tier: MAX of static default and reversibility floor. (Same
// action class = action type here; the two share the ACT_* space.)
fn perm_effective_tier(action_class) {
    let d = perm_default(action_class)
    let f = reversibility_floor(action_class)
    if f > d { return f }
    return d
}

// A guard may only RAISE the tier (never lower it).
fn perm_apply_guard(tier, guard_tier) {
    if guard_tier > tier { return guard_tier }
    return tier
}

// ---- per-action decision (ADR-0041 dispatch) ------------------------------
let PDEC_EXECUTE = 1   // AUTO: run immediately
let PDEC_NOTIFY  = 2   // NOTIFY: run + notify + log
let PDEC_SUSPEND = 3   // APPROVE: suspend, require user approval

fn perm_dec_name(d) {
    if d == PDEC_EXECUTE { return "execute" }
    if d == PDEC_NOTIFY  { return "notify" }
    if d == PDEC_SUSPEND { return "suspend" }
    return "unknown"
}

// The gate decision for an action class, from its effective tier.
fn perm_decision(action_class) {
    let t = perm_effective_tier(action_class)
    if t == PERM_AUTO   { return PDEC_EXECUTE }
    if t == PERM_NOTIFY { return PDEC_NOTIFY }
    return PDEC_SUSPEND
}

// Does an action require explicit user approval before it may run?
fn perm_requires_approval(action_class) {
    if perm_effective_tier(action_class) == PERM_APPROVE { return 1 }
    return 0
}

