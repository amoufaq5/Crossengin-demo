// CrossEngin safety: pure-NOVA AES-128 block cipher + AES-128-GCM AEAD.
//
// Purpose
//   The DTLS 1.2 record-layer + handshake skeleton in
//   `src/federation/dtls12.nova` (R29B) negotiates the
//   ECDHE-ECDSA-AES128-GCM-SHA256 cipher suite (0xC02B) -- the WebRTC
//   interop minimum. Its `dtls_seal_record_R29B2_STUB` and
//   `dtls_open_record_R29B2_STUB` are tagged as R29B.2 follow-ups: they
//   need an AES-128-GCM AEAD primitive. The existing AEAD in the safety
//   tree, `src/safety/chacha20.nova` + `src/safety/poly1305.nova`, is
//   ChaCha20-Poly1305 (the OTHER modern AEAD); it does NOT provide
//   AES-128 nor GHASH. This module is the missing primitive that R29B.2
//   will eventually plug into the DTLS stack.
//
// Algorithm references
//   * FIPS 197 -- "Advanced Encryption Standard". AES-128 key schedule
//     (10 round keys from a 128-bit key) and the SubBytes / ShiftRows /
//     MixColumns / AddRoundKey round structure.
//   * NIST SP 800-38D -- "Recommendation for Block Cipher Modes of
//     Operation: Galois/Counter Mode (GCM)". GHASH over GF(2^128) with
//     the polynomial x^128 + x^7 + x^2 + x + 1 (canonical bit-reversed
//     representation per the spec). GCM combines CTR mode encryption +
//     GHASH-of-(AAD || CT || lengths) for the authentication tag.
//   * NIST CAVP gcmEncryptIntCount256.rsp / RFC 7714 -- published test
//     vectors that the unit suite uses for byte-identical verification.
//
// AES-128 (FIPS 197)
//   * 128-bit block size, 128-bit key, 10 rounds.
//   * State laid out as 16 bytes in column-major order: state[4*c + r]
//     where r is the row (0..3) and c is the column (0..3). This matches
//     the FIPS 197 "state" interpretation. We never explicitly transpose;
//     ShiftRows operates on the appropriate state byte indices directly.
//   * The S-box is the 256-byte forward substitution table from FIPS 197
//     Figure 7. Inlined as a NOVA list constructor; one allocation.
//   * MixColumns uses xtime (multiplication by x mod the AES polynomial
//     x^8 + x^4 + x^3 + x + 1) plus xors. Decryption is NOT needed for
//     GCM (which uses encrypt-only), so we ship encrypt-only.
//
// GCM (SP 800-38D)
//   * H = E_K(0^128) is the GHASH subkey; computed once per session.
//   * Counter block J_0 starts at IV || 0^31 || 1 (12-byte IV path); the
//     counter is the low 32 bits and increments per encrypted block.
//   * Tag = GHASH_H(AAD || CT || aad_len_bits || ct_len_bits) XOR E_K(J_0).
//   * The "compare in constant time" tag check is approximated here by a
//     fixed-length byte-by-byte XOR-fold; the OUTER loop iterates 16
//     iterations regardless of the first mismatch.
//
// GHASH over GF(2^128)
//   * Field elements are 16 bytes; multiplication is in GF(2)[x] mod
//     x^128 + x^7 + x^2 + x + 1. SP 800-38D uses the BIT-REVERSED
//     convention: bit 0 of byte 0 of a block is the COEFFICIENT of x^0
//     in GHASH but appears at the TOP of the conventional integer
//     polynomial representation. We follow the spec literally so the
//     test-vector bytes can be plugged in as-is.
//   * Multiplication implementation: 128-iteration shift-and-XOR. Not
//     the fastest possible (table-based Shoup, Karatsuba) but correct,
//     readable, and self-contained -- the same trade-off as the
//     ChaCha20 implementation in `chacha20.nova`.
//
// Byte buffer convention (mirrors chacha20.nova)
//   Crypto inputs and outputs are arbitrary 8-bit data and routinely
//   contain zero bytes. So this module operates on `(buf_ptr, len)`
//   byte buffer pairs throughout. Hex-encoded test vectors arrive via
//   `gcm_hex_decode` / `gcm_hex_encode_buf` so no raw zero bytes ever
//   land in a NOVA string (which truncates to length 1 on the first NUL).
//
// Public API
//   aes128_encrypt_block(key_buf, in_buf, out_buf)
//                    Single-block encrypt. key_buf is 16 bytes, in_buf is
//                    16 bytes, out_buf is 16-byte output. Returns 1 on
//                    success.
//   aes128_key_schedule(key_buf) -> round_keys_buf (11 * 16 = 176 bytes)
//                    Expands a 128-bit key into 11 round keys.
//   gcm_seal(key_buf, iv12_buf, aad_buf, aad_n, pt_buf, pt_n)
//                    -> alloc'd buffer (pt_n + 16) containing ciphertext
//                       (pt_n bytes) followed by 16-byte tag, OR 0 on
//                       bad input (key/iv length != 16/12).
//   gcm_open(key_buf, iv12_buf, aad_buf, aad_n, ct_tag_buf, ct_tag_n)
//                    -> [pt_buf, pt_n] on success;
//                       AES_GCM_DECRYPT_FAIL (= 0) on auth failure or
//                       bad input.
//   ghash_update(state_buf, h_buf, block_buf)
//                    XOR a 16-byte block into the GHASH state, multiply
//                    by H, store back. Test-helper export.
//   gcm_hex_decode(hex_str) / gcm_hex_encode_buf(buf, n)
//                    Same shape as the chacha20 hex codec.
//
// Constant-time / side-channel caveats (R30B.3 hardening followup)
//   * The AES S-box is a 256-entry NOVA list; lookups are data-dependent
//     and thus cache-line-side-channel exposed under realistic AES
//     contexts. A bitsliced implementation removes this exposure but
//     adds ~300 lines; tracked as R30B.3.
//   * GHASH multiplication walks 128 bits of one operand; the inner XOR
//     is data-dependent. Same general-purpose timing-channel exposure
//     as the AES S-box.
//   * `gcm_open` does compare the full 16-byte tag (no short-circuit
//     return on first mismatch), but the comparison is byte-by-byte
//     XOR-fold rather than a true constant-time `int_or` ladder; that
//     mostly matters under speculative side-channel attacks, which are
//     outside the threat model for an MVP DTLS stack.
//
// ADRs touched: FEDERATED_AUDIT.md (R30B P-256 + AES-128-GCM foundation
//   for DTLS R29B.2).
// NOVA dependencies: builtins (alloc, store8, load8, int_*, list_*,
//   len).
// CrossEngin dependencies: none -- pure leaf primitive (parallel to
//   chacha20.nova / poly1305.nova; all share only NOVA builtins).

// ============================================================================
//                          Public sentinels
// ============================================================================

let AES_GCM_DECRYPT_FAIL = 0    // gcm_open returns this on any failure
let AES_BLOCK_BYTES      = 16   // AES block size in bytes
let AES_KEY_BYTES        = 16   // AES-128 key size in bytes
let AES_ROUNDS           = 10   // Number of rounds for AES-128
let AES_EXP_KEY_BYTES    = 176  // (AES_ROUNDS + 1) * AES_BLOCK_BYTES
let GCM_IV_BYTES         = 12   // GCM standard IV length (96 bits)
let GCM_TAG_BYTES        = 16   // GCM tag length

// ============================================================================
//                          AES-128 S-box (FIPS 197)
// ============================================================================
//
// 256-byte forward S-box from FIPS 197 Figure 7. Hard-coded as a list
// returned by a singleton constructor (one alloc per session, then
// indexed in the round-function hot path).

let _AES_SBOX_CACHE = list_new()

fn _aes_build_sbox() {
    let s = list_new()
    push(s,  99); push(s, 124); push(s, 119); push(s, 123)
    push(s, 242); push(s, 107); push(s, 111); push(s, 197)
    push(s,  48); push(s,   1); push(s, 103); push(s,  43)
    push(s, 254); push(s, 215); push(s, 171); push(s, 118)
    push(s, 202); push(s, 130); push(s, 201); push(s, 125)
    push(s, 250); push(s,  89); push(s,  71); push(s, 240)
    push(s, 173); push(s, 212); push(s, 162); push(s, 175)
    push(s, 156); push(s, 164); push(s, 114); push(s, 192)
    push(s, 183); push(s, 253); push(s, 147); push(s,  38)
    push(s,  54); push(s,  63); push(s, 247); push(s, 204)
    push(s,  52); push(s, 165); push(s, 229); push(s, 241)
    push(s, 113); push(s, 216); push(s,  49); push(s,  21)
    push(s,   4); push(s, 199); push(s,  35); push(s, 195)
    push(s,  24); push(s, 150); push(s,   5); push(s, 154)
    push(s,   7); push(s,  18); push(s, 128); push(s, 226)
    push(s, 235); push(s,  39); push(s, 178); push(s, 117)
    push(s,   9); push(s, 131); push(s,  44); push(s,  26)
    push(s,  27); push(s, 110); push(s,  90); push(s, 160)
    push(s,  82); push(s,  59); push(s, 214); push(s, 179)
    push(s,  41); push(s, 227); push(s,  47); push(s, 132)
    push(s,  83); push(s, 209); push(s,   0); push(s, 237)
    push(s,  32); push(s, 252); push(s, 177); push(s,  91)
    push(s, 106); push(s, 203); push(s, 190); push(s,  57)
    push(s,  74); push(s,  76); push(s,  88); push(s, 207)
    push(s, 208); push(s, 239); push(s, 170); push(s, 251)
    push(s,  67); push(s,  77); push(s,  51); push(s, 133)
    push(s,  69); push(s, 249); push(s,   2); push(s, 127)
    push(s,  80); push(s,  60); push(s, 159); push(s, 168)
    push(s,  81); push(s, 163); push(s,  64); push(s, 143)
    push(s, 146); push(s, 157); push(s,  56); push(s, 245)
    push(s, 188); push(s, 182); push(s, 218); push(s,  33)
    push(s,  16); push(s, 255); push(s, 243); push(s, 210)
    push(s, 205); push(s,  12); push(s,  19); push(s, 236)
    push(s,  95); push(s, 151); push(s,  68); push(s,  23)
    push(s, 196); push(s, 167); push(s, 126); push(s,  61)
    push(s, 100); push(s,  93); push(s,  25); push(s, 115)
    push(s,  96); push(s, 129); push(s,  79); push(s, 220)
    push(s,  34); push(s,  42); push(s, 144); push(s, 136)
    push(s,  70); push(s, 238); push(s, 184); push(s,  20)
    push(s, 222); push(s,  94); push(s,  11); push(s, 219)
    push(s, 224); push(s,  50); push(s,  58); push(s,  10)
    push(s,  73); push(s,   6); push(s,  36); push(s,  92)
    push(s, 194); push(s, 211); push(s, 172); push(s,  98)
    push(s, 145); push(s, 149); push(s, 228); push(s, 121)
    push(s, 231); push(s, 200); push(s,  55); push(s, 109)
    push(s, 141); push(s, 213); push(s,  78); push(s, 169)
    push(s, 108); push(s,  86); push(s, 244); push(s, 234)
    push(s, 101); push(s, 122); push(s, 174); push(s,   8)
    push(s, 186); push(s, 120); push(s,  37); push(s,  46)
    push(s,  28); push(s, 166); push(s, 180); push(s, 198)
    push(s, 232); push(s, 221); push(s, 116); push(s,  31)
    push(s,  75); push(s, 189); push(s, 139); push(s, 138)
    push(s, 112); push(s,  62); push(s, 181); push(s, 102)
