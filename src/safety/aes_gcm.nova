    push(s, 191); push(s, 230); push(s,  66); push(s, 104)
    push(s,  65); push(s, 153); push(s,  45); push(s,  15)
    push(s, 176); push(s,  84); push(s, 187); push(s,  22)
    return s
}

fn _aes_sbox() {
    if len(_AES_SBOX_CACHE) == 0 {
        push(_AES_SBOX_CACHE, _aes_build_sbox())
    }
    return _AES_SBOX_CACHE[0]
}

// Lookup S[i] for a byte i (0..255).
fn _aes_sub(b) {
    let s = _aes_sbox()
    return s[b]
}

// ============================================================================
//                          AES key schedule (FIPS 197 5.2)
// ============================================================================
//
// Expand a 16-byte key into 11 round keys (176 bytes total). The output
// layout is bytewise concatenation of the 11 16-byte round keys:
//   round_keys[i*16 .. i*16 + 15] = round key for round i (i in 0..10).
// The Round 0 round key IS the input key.

// Round constants for AES-128 (Rcon[1..10]). Rcon[0] is unused.
fn _aes_rcon(i) {
    if i == 1  { return 1 }
    if i == 2  { return 2 }
    if i == 3  { return 4 }
    if i == 4  { return 8 }
    if i == 5  { return 16 }
    if i == 6  { return 32 }
    if i == 7  { return 64 }
    if i == 8  { return 128 }
    if i == 9  { return 27 }    // 0x1B
    if i == 10 { return 54 }    // 0x36
    return 0
}

// Expand a 128-bit key into 11 round keys; return a freshly alloc'd
// 177-byte buffer (NUL-trailing slack for allocator quirks). The
// 16-byte key is copied as round-0; subsequent words are derived per
// FIPS 197 5.2.
fn aes128_key_schedule(key_buf) {
    let exp = alloc(AES_EXP_KEY_BYTES + 1)
    // Round 0 = input key.
    let i = 0
    while i < AES_KEY_BYTES {
        store8(exp + i, load8(key_buf + i))
        i = i + 1
    }
    // Generate words 4..43 (each "word" = 4 bytes). After the input
    // key (words 0..3), each word w[i] = w[i-4] XOR temp, where
    // temp = w[i-1] with optional SubWord + RotWord + Rcon at every
    // multiple of 4.
    let word = 4
    while word < 44 {
        // temp_lo/temp_2/temp_3/temp_hi = w[word-1]
        let p = exp + (word - 1) * 4
        let t0 = load8(p + 0)
        let t1 = load8(p + 1)
        let t2 = load8(p + 2)
        let t3 = load8(p + 3)
        if int_and(word, 3) == 0 {
            // RotWord: [t0,t1,t2,t3] -> [t1,t2,t3,t0]
            let r0 = t1
            let r1 = t2
            let r2 = t3
            let r3 = t0
            // SubWord: each byte through S-box.
            t0 = int_xor(_aes_sub(r0), _aes_rcon(int_shr(word, 2)))
            t1 = _aes_sub(r1)
            t2 = _aes_sub(r2)
            t3 = _aes_sub(r3)
        }
        // w[word] = w[word - 4] XOR temp.
        let prev = exp + (word - 4) * 4
        let dst  = exp + word * 4
        store8(dst + 0, int_xor(load8(prev + 0), t0))
        store8(dst + 1, int_xor(load8(prev + 1), t1))
        store8(dst + 2, int_xor(load8(prev + 2), t2))
        store8(dst + 3, int_xor(load8(prev + 3), t3))
        word = word + 1
    }
    store8(exp + AES_EXP_KEY_BYTES, 0)
    return exp
}

// ============================================================================
//                          AES-128 round function (FIPS 197)
// ============================================================================

// AddRoundKey: XOR a 16-byte block in-place with a 16-byte round key
// segment at offset `roff` within the expanded round-keys buffer.
fn _aes_add_round_key(state, round_keys, roff) {
    let i = 0
    while i < 16 {
        store8(state + i, int_xor(load8(state + i),
                                  load8(round_keys + roff + i)))
        i = i + 1
    }
    return 1
}

// SubBytes: apply S-box to every byte of the 16-byte state.
fn _aes_sub_bytes(state) {
    let i = 0
    while i < 16 {
        store8(state + i, _aes_sub(load8(state + i)))
        i = i + 1
    }
    return 1
}

// ShiftRows: row r is left-rotated by r positions. The state is laid
// out column-major: state[4*c + r] is the (r, c) entry. So we touch
// (r, 0), (r, 1), (r, 2), (r, 3) for each row.
//
// Row 0: no shift.
// Row 1: 1-byte left shift -> (r,0)<-(r,1), (r,1)<-(r,2), (r,2)<-(r,3), (r,3)<-(r,0).
// Row 2: 2-byte left shift.
// Row 3: 3-byte left shift -> equiv 1-byte right shift.
fn _aes_shift_rows(state) {
    // Row 1
    let t = load8(state + 1)
    store8(state + 1,  load8(state + 5))
    store8(state + 5,  load8(state + 9))
    store8(state + 9,  load8(state + 13))
    store8(state + 13, t)
    // Row 2 (two-position swap pairs)
    let u0 = load8(state + 2)
    let u1 = load8(state + 6)
    store8(state + 2,  load8(state + 10))
    store8(state + 6,  load8(state + 14))
    store8(state + 10, u0)
    store8(state + 14, u1)
    // Row 3 (one-byte right shift)
    let v = load8(state + 15)
    store8(state + 15, load8(state + 11))
    store8(state + 11, load8(state + 7))
    store8(state + 7,  load8(state + 3))
    store8(state + 3, v)
    return 1
}

// xtime: multiply by x in GF(2^8) mod (x^8 + x^4 + x^3 + x + 1).
//   xtime(b) = (b << 1) XOR (0x1B if high bit was set else 0), all in 8 bits.
fn _aes_xtime(b) {
    let shifted = int_and(int_shl(b, 1), 255)
    if int_and(b, 128) != 0 {
        return int_xor(shifted, 27)    // 0x1B
    }
    return shifted
}

// MixColumns: each column [s0, s1, s2, s3] -> [
//   2*s0 + 3*s1 + s2 + s3,
//   s0 + 2*s1 + 3*s2 + s3,
//   s0 + s1 + 2*s2 + 3*s3,
//   3*s0 + s1 + s2 + 2*s3 ] in GF(2^8).
// 3*b = xtime(b) XOR b; 2*b = xtime(b). Per-column we precompute
// xtime of each byte; the XOR pattern collapses to:
//   new_s0 = s0 XOR (xtime(s0) XOR s1 XOR xtime(s1)) XOR s2 XOR s3
// Standard textbook form:
//   t = s0 ^ s1 ^ s2 ^ s3
//   u0 = s0; s0' = s0 ^ xtime(s0 ^ s1) ^ t
//   ... and analogously.
fn _aes_mix_columns(state) {
    let c = 0
    while c < 4 {
        let base = c * 4
        let s0 = load8(state + base + 0)
        let s1 = load8(state + base + 1)
        let s2 = load8(state + base + 2)
        let s3 = load8(state + base + 3)
        let t  = int_xor(int_xor(s0, s1), int_xor(s2, s3))
        store8(state + base + 0, int_xor(s0, int_xor(_aes_xtime(int_xor(s0, s1)), t)))
        store8(state + base + 1, int_xor(s1, int_xor(_aes_xtime(int_xor(s1, s2)), t)))
        store8(state + base + 2, int_xor(s2, int_xor(_aes_xtime(int_xor(s2, s3)), t)))
        store8(state + base + 3, int_xor(s3, int_xor(_aes_xtime(int_xor(s3, s0)), t)))
        c = c + 1
    }
    return 1
}

// Encrypt one 16-byte block. The state is loaded from in_buf, transformed
// in-place in a scratch 17-byte buffer, then written to out_buf. round_keys
// is the 176-byte expanded key from aes128_key_schedule.
fn aes128_encrypt_block_with_schedule(round_keys, in_buf, out_buf) {
    let state = alloc(17)
    let i = 0
    while i < 16 {
        store8(state + i, load8(in_buf + i))
        i = i + 1
    }
    store8(state + 16, 0)
    // Round 0: AddRoundKey only.
    _aes_add_round_key(state, round_keys, 0)
    // Rounds 1..9: SubBytes, ShiftRows, MixColumns, AddRoundKey.
    let r = 1
    while r < AES_ROUNDS {
        _aes_sub_bytes(state)
        _aes_shift_rows(state)
        _aes_mix_columns(state)
        _aes_add_round_key(state, round_keys, r * 16)
        r = r + 1
    }
    // Round 10: SubBytes, ShiftRows, AddRoundKey (no MixColumns).
    _aes_sub_bytes(state)
    _aes_shift_rows(state)
    _aes_add_round_key(state, round_keys, AES_ROUNDS * 16)
    // Copy state to out_buf.
    let k = 0
    while k < 16 {
        store8(out_buf + k, load8(state + k))
        k = k + 1
    }
    return 1
}

// Convenience: encrypt one block from a raw key. Internally expands the
// key schedule each call -- prefer the with_schedule variant in hot
// paths (CTR mode, GHASH-H derivation).
fn aes128_encrypt_block(key_buf, in_buf, out_buf) {
    let rk = aes128_key_schedule(key_buf)
    return aes128_encrypt_block_with_schedule(rk, in_buf, out_buf)
}

// ============================================================================
//                          GHASH over GF(2^128)
// ============================================================================
//
// 16-byte elements; multiplication mod x^128 + x^7 + x^2 + x + 1 with
// the bit-reversed (right-shift) convention of NIST SP 800-38D.
// Standard implementation: walk the 128 bits of one operand from
// HIGHEST to LOWEST, shift Z right by one bit each iteration, and
// XOR V into Z when the current bit is set. After each shift, if the
// LSB of V was set, XOR V with the reduction polynomial 0xe1000...000
// (bit-reversed of 0x87 = x^7 + x^2 + x + 1).
//
// We hold field elements as 16-byte buffers in the spec's natural
// memory order: byte 0 is the "leftmost" coefficient block. Bit
// numbering inside a byte: bit 7 is the LEFTMOST (highest-coefficient)
// bit. So _ghash_bit(buf, i) for i in 0..127 walks the bits in the
// spec's order.

// Read bit i (0..127) from a 16-byte field element. Bit numbering:
//   i = 8*byte_idx + (7 - bit_in_byte)
// So bit 0 is the high bit of byte 0; bit 127 is the low bit of byte 15.
fn _ghash_bit(buf, i) {
    let byte_idx = int_shr(i, 3)
    let bit_in_byte = int_and(i, 7)
    let mask = int_shl(1, 7 - bit_in_byte)
    return int_and(load8(buf + byte_idx), mask)
}

// Shift a 16-byte field element ONE bit RIGHT (toward higher bit index in
// the NIST SP 800-38D numbering). In memory terms: byte 0's memory-MSB
// shifts toward its memory-LSB; the across-byte propagation moves byte i's
// memory-LSB into byte (i+1)'s memory-MSB. The last byte's memory-LSB
// falls off the end and is returned as the LSB of the original word
// (used by the caller to decide whether to XOR in the reduction
// polynomial 0xe1 || 0...).
fn _ghash_shift_right_1(buf) {
    let i = 0
    let carry = 0
    while i < 16 {
        let b = load8(buf + i)
        let new_b = int_or(int_shr(b, 1), int_shl(carry, 7))
        carry = int_and(b, 1)
        store8(buf + i, int_and(new_b, 255))
        i = i + 1
    }
    return carry
}

// Z = Z XOR V (both 16-byte buffers).
fn _ghash_xor_inplace(Z, V) {
    let i = 0
    while i < 16 {
        store8(Z + i, int_xor(load8(Z + i), load8(V + i)))
        i = i + 1
    }
    return 1
}

// Reduction polynomial 0xe1 || 0x00 * 15: XOR'd into V whenever V's
// LSB was 1 after a right shift. Allocated once per call as a 16-byte
// constant.
fn _ghash_reduction_into(buf) {
    store8(buf + 0, 225)    // 0xe1
    let i = 1
    while i < 16 {
        store8(buf + i, 0)
        i = i + 1
    }
    return 1
}

// Multiply X * Y in GF(2^128), result in Z. All three are 16-byte
// buffers; X and Y are NOT modified; Z is overwritten.
fn ghash_mul(Z, X, Y) {
    // Initialize Z = 0.
    let i = 0
    while i < 16 {
        store8(Z + i, 0)
        i = i + 1
    }
    // V = X (working copy that we shift right each iteration).
    let V = alloc(17)
    let j = 0
    while j < 16 {
        store8(V + j, load8(X + j))
        j = j + 1
    }
    store8(V + 16, 0)
    // R = reduction constant 0xe1 || 0...
    let R = alloc(17)
    _ghash_reduction_into(R)
    store8(R + 16, 0)
    // For i = 0 .. 127 (bit i of Y):
    //   if Y_bit(i) == 1: Z ^= V
    //   if V[15] & 1 == 1: V = (V >> 1) ^ R
    //   else:              V = V >> 1
    let bit = 0
    while bit < 128 {
        if _ghash_bit(Y, bit) != 0 {
            _ghash_xor_inplace(Z, V)
        }
        let lsb = _ghash_shift_right_1(V)
        if lsb != 0 {
            _ghash_xor_inplace(V, R)
        }
        bit = bit + 1
    }
    return 1
}

// Update GHASH state with one 16-byte block: state = (state XOR block) * H.
// All three buffers are 16 bytes. The H buffer is computed once at session
// start (H = E_K(0^128)).
fn ghash_update(state, h, block) {
    _ghash_xor_inplace(state, block)
    let tmp = alloc(17)
    ghash_mul(tmp, state, h)
    let i = 0
    while i < 16 {
        store8(state + i, load8(tmp + i))
        i = i + 1
    }
    return 1
}

// ============================================================================
//                          GCM mode (SP 800-38D)
// ============================================================================
//
// Standard 12-byte-IV path (the only path browsers / DTLS actually use):
//   J_0 = IV || 0x00000001 (16 bytes total)
//   ICB = J_0; increment for CTR (encrypt every plaintext block).
//   Tag = GHASH_H(AAD pad + CT pad + len64(AAD bits) || len64(CT bits))
//         XOR E_K(J_0).
//
// We process AAD then CT then the length block; the lengths are 64-bit
// big-endian byte counts of bits (so byte_count * 8). The padded buffer
// concept is implicit: we feed full 16-byte blocks; for a partial last
// block we copy the bytes into a zeroed 16-byte scratch and feed that.

// Increment the low 32 bits of a 16-byte counter block.
fn _gcm_inc_counter(ctr) {
    let i = 15
    let carry = 1
    while i >= 12 {
        let b = int_add(load8(ctr + i), carry)
        store8(ctr + i, int_and(b, 255))
        carry = int_shr(b, 8)
        i = i - 1
    }
    return 1
}

// Build J_0 = IV[0..12] || 0x00000001 into the provided 16-byte buffer.
fn _gcm_build_j0(j0, iv12) {
    let i = 0
    while i < 12 {
        store8(j0 + i, load8(iv12 + i))
        i = i + 1
    }
    store8(j0 + 12, 0)
    store8(j0 + 13, 0)
    store8(j0 + 14, 0)
    store8(j0 + 15, 1)
    return 1
}

// Feed a buffer (full + partial blocks) into the GHASH stream. For each
// 16-byte chunk: XOR into state, multiply by H. Partial last block is
// zero-padded.
fn _gcm_ghash_feed(state, h, buf, n) {
    let blk = alloc(17)
    let off = 0
    while off + 16 <= n {
        let i = 0
        while i < 16 {
            store8(blk + i, load8(buf + off + i))
            i = i + 1
        }
        ghash_update(state, h, blk)
        off = off + 16
    }
    let rem = n - off
    if rem > 0 {
        let i = 0
        while i < 16 {
            store8(blk + i, 0)
            i = i + 1
        }
        let j = 0
        while j < rem {
            store8(blk + j, load8(buf + off + j))
            j = j + 1
        }
        ghash_update(state, h, blk)
    }
    return 1
}

// Write a 64-bit byte length, in bits, big-endian into buf[off..off+8].
// Caller passes byte counts; this multiplies by 8 to get bit counts.
fn _gcm_put_be64_bitlen(buf, off, bytecount) {
    // Multiply by 8 = shift left 3. Splitting into hi/lo 32 bits to avoid
    // overflow surprises (NOVA int is 64-bit signed so bytecount * 8 is
    // safe for our scales -- DTLS records are <=16KB).
    let bits = int_mul(bytecount, 8)
    let i = 0
    while i < 8 {
        let byte = int_and(int_shr(bits, 56 - 8 * i), 255)
        store8(buf + off + i, byte)
        i = i + 1
    }
    return 1
}

// Encrypt+authenticate: CTR-encrypt plaintext + GHASH over (AAD || CT ||
// lengths). Returns a freshly alloc'd buffer of size pt_n + 16 + 1:
//   [0 .. pt_n) = ciphertext
//   [pt_n .. pt_n + 16) = 16-byte tag
// Returns 0 on bad input (key_buf or iv12 invalid -- we cannot check
// lengths at the buffer level but treat negative pt_n / aad_n as fail).
fn gcm_seal(key_buf, iv12_buf, aad_buf, aad_n, pt_buf, pt_n) {
    if pt_n < 0 { return 0 }
    if aad_n < 0 { return 0 }
    // 1. Key schedule.
    let rk = aes128_key_schedule(key_buf)
    // 2. H = E_K(0^128).
    let zero = alloc(17)
    let i = 0
    while i < 16 {
        store8(zero + i, 0)
        i = i + 1
    }
    let H = alloc(17)
    aes128_encrypt_block_with_schedule(rk, zero, H)
    // 3. J_0 = IV || 0x00000001.
    let j0 = alloc(17)
    _gcm_build_j0(j0, iv12_buf)
    // 4. E_K(J_0): for tag XOR.
    let ekj0 = alloc(17)
    aes128_encrypt_block_with_schedule(rk, j0, ekj0)
    // 5. CTR encrypt: counter = J_0 with low-32 incremented per block.
    let out = alloc(pt_n + 17)
    let ctr = alloc(17)
    let k = 0
    while k < 16 {
        store8(ctr + k, load8(j0 + k))
        k = k + 1
    }
    let block = alloc(17)
    let off = 0
    while off < pt_n {
        _gcm_inc_counter(ctr)
        aes128_encrypt_block_with_schedule(rk, ctr, block)
        let remaining = pt_n - off
        let take = 16
        if remaining < 16 { take = remaining }
        let j = 0
        while j < take {
            store8(out + off + j,
                   int_xor(load8(pt_buf + off + j), load8(block + j)))
            j = j + 1
        }
        off = off + take
    }
    // 6. GHASH: feed AAD || CT || lens.
    let state = alloc(17)
    let z = 0
    while z < 16 {
        store8(state + z, 0)
        z = z + 1
    }
    _gcm_ghash_feed(state, H, aad_buf, aad_n)
    _gcm_ghash_feed(state, H, out, pt_n)
    let len_block = alloc(17)
    _gcm_put_be64_bitlen(len_block, 0, aad_n)
    _gcm_put_be64_bitlen(len_block, 8, pt_n)
    ghash_update(state, H, len_block)
    // 7. Tag = state XOR E_K(J_0).
    let i2 = 0
    while i2 < 16 {
        store8(out + pt_n + i2,
               int_xor(load8(state + i2), load8(ekj0 + i2)))
        i2 = i2 + 1
    }
    store8(out + pt_n + 16, 0)
    return out
}

// Decrypt+verify: ct_tag_buf is ciphertext (ct_tag_n - 16 bytes) followed
// by the 16-byte tag. On success returns [pt_buf, pt_n]. On failure
// (auth check fails, bad lengths) returns AES_GCM_DECRYPT_FAIL (= 0).
fn gcm_open(key_buf, iv12_buf, aad_buf, aad_n, ct_tag_buf, ct_tag_n) {
    if ct_tag_n < 16 { return AES_GCM_DECRYPT_FAIL }
    if aad_n < 0     { return AES_GCM_DECRYPT_FAIL }
    let ct_n = ct_tag_n - 16
    // 1. Key schedule + H + J_0 + E_K(J_0).
    let rk = aes128_key_schedule(key_buf)
    let zero = alloc(17)
    let i = 0
    while i < 16 {
        store8(zero + i, 0)
        i = i + 1
    }
    let H = alloc(17)
    aes128_encrypt_block_with_schedule(rk, zero, H)
    let j0 = alloc(17)
    _gcm_build_j0(j0, iv12_buf)
    let ekj0 = alloc(17)
    aes128_encrypt_block_with_schedule(rk, j0, ekj0)
    // 2. Recompute GHASH over (AAD || CT || lens) BEFORE decrypting --
    //    the tag check must happen first so a bad tag doesn't release
    //    plaintext to the caller.
    let state = alloc(17)
    let z = 0
    while z < 16 {
        store8(state + z, 0)
        z = z + 1
    }
    _gcm_ghash_feed(state, H, aad_buf, aad_n)
    _gcm_ghash_feed(state, H, ct_tag_buf, ct_n)
    let len_block = alloc(17)
    _gcm_put_be64_bitlen(len_block, 0, aad_n)
    _gcm_put_be64_bitlen(len_block, 8, ct_n)
    ghash_update(state, H, len_block)
    // 3. Expected tag = state XOR E_K(J_0); compare with the trailing
    //    16 bytes of ct_tag_buf. Byte-fold: any mismatched byte sets the
    //    diff accumulator. The loop runs all 16 iterations regardless.
    let diff = 0
    let t = 0
    while t < 16 {
        let exp_t = int_xor(load8(state + t), load8(ekj0 + t))
        let got_t = load8(ct_tag_buf + ct_n + t)
        diff = int_or(diff, int_xor(exp_t, got_t))
        t = t + 1
    }
    if diff != 0 { return AES_GCM_DECRYPT_FAIL }
    // 4. Tag OK: decrypt by CTR.
    let pt = alloc(ct_n + 1)
    let ctr = alloc(17)
    let k = 0
    while k < 16 {
        store8(ctr + k, load8(j0 + k))
        k = k + 1
    }
    let block = alloc(17)
    let off = 0
    while off < ct_n {
        _gcm_inc_counter(ctr)
        aes128_encrypt_block_with_schedule(rk, ctr, block)
        let remaining = ct_n - off
        let take = 16
        if remaining < 16 { take = remaining }
        let j = 0
        while j < take {
            store8(pt + off + j,
                   int_xor(load8(ct_tag_buf + off + j), load8(block + j)))
            j = j + 1
        }
        off = off + take
    }
    store8(pt + ct_n, 0)
    let r = list_new()
    push(r, pt)
    push(r, ct_n)
    return r
}

// ============================================================================
//                          Hex codec helpers
// ============================================================================
//
// Same shape as chacha20.nova's cc_hex_decode / cc_hex_encode_buf. Used
// by the unit suite to pump NIST CAVP test vectors as printable strings.

fn _gcm_hex_nibble(c) {
    if c >= 48 { if c <= 57  { return c - 48 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    if c >= 65 { if c <= 70  { return c - 55 } }
    return -1
}

fn _gcm_nibble_hex(n) {
    if n < 10 { return n + 48 }
    return n + 87
}

fn gcm_hex_decode(hex_str) {
    let n = len(hex_str)
    if n == 0 {
        // Empty input -> empty buffer.
        let buf = alloc(1)
        store8(buf, 0)
        let r = list_new()
        push(r, buf)
        push(r, 0)
        return r
    }
    let half = int_shr(n, 1)
    if int_shl(half, 1) != n { return 0 }
    let buf = alloc(half + 1)
    let i = 0
    while i < half {
        let hi = _gcm_hex_nibble(char_at(hex_str, i * 2))
        let lo = _gcm_hex_nibble(char_at(hex_str, i * 2 + 1))
        if hi < 0 { return 0 }
        if lo < 0 { return 0 }
        store8(buf + i, int_or(int_shl(hi, 4), lo))
        i = i + 1
    }
    store8(buf + half, 0)
    let r = list_new()
    push(r, buf)
    push(r, half)
    return r
}

fn gcm_hex_encode_buf(buf, n) {
    let s = ""
    let i = 0
    while i < n {
        let b = load8(buf + i)
        let hi = _gcm_nibble_hex(int_and(int_shr(b, 4), 15))
        let lo = _gcm_nibble_hex(int_and(b, 15))
        s = s + chr(hi) + chr(lo)
        i = i + 1
    }
    return s
}
