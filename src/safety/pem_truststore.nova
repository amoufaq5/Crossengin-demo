// CrossEngin safety: PEM trust store (R46).
//
// Purpose
//   Removes the hard-coded TLS anchor pins (R43) in favour of a pluggable
//   trust store loaded from a PEM CA bundle. A bundle is just concatenated
//   "-----BEGIN CERTIFICATE-----" base64 blocks; this module extracts each,
//   base64-decodes it to DER, and parses out the RSA public key so the chain
//   verifier can match a presented chain's root against any trusted anchor.
//   Point CE_TLS_CA_BUNDLE at /etc/ssl/certs/ca-certificates.crt (or any file)
//   and the TLS client trusts that environment's CAs instead of a baked-in pin.
//
//   RSA anchors only: ECDSA roots in a bundle are recognised and skipped
//   (cert_parse returns not-ok), and RSA moduli wider than 2048 bits don't fit
//   bignum_2048 and are skipped too. Documented, not silent surprises.
//
// NOVA deps: read_file, alloc/store8, substr. CrossEngin deps:
//   ../safety/x509_verify.nova (cert_parse), ../safety/scram.nova
//   (scram_base64_decode). Tested in tests/unit/test_pem_truststore.nova.

import "x509_verify.nova"
import "scram.nova"

let PEM_BEGIN = "-----BEGIN CERTIFICATE-----"
let PEM_END   = "-----END CERTIFICATE-----"

// First index of `needle` in `text` at or after `from`, or -1.
fn _pem_find(text, needle, from) {
    if from < 0 { return 0 - 1 }
    if from >= len(text) { return 0 - 1 }
    let sub = substr(text, from, len(text) - from)
    let idx = str_find(sub, needle)
    if idx < 0 { return 0 - 1 }
    return from + idx
}

// Collect the base64 alphabet bytes from text[start,end) into a clean string
// (whitespace/newlines removed), built in one O(n) buffer pass.
fn _pem_clean_b64(text, start, end) {
    let buf = alloc(end - start + 1)
    let o = 0
    let i = start
    while i < end {
        let c = char_at(text, i)
        let ok = 0
        if c >= 65 { if c <= 90 { ok = 1 } }      // A-Z
        if c >= 97 { if c <= 122 { ok = 1 } }     // a-z
        if c >= 48 { if c <= 57 { ok = 1 } }      // 0-9
        if c == 43 { ok = 1 }                     // +
        if c == 47 { ok = 1 }                     // /
        if c == 61 { ok = 1 }                     // =
        if ok == 1 { store8(buf + o, c) o = o + 1 }
        i = i + 1
    }
    return substr(buf, 0, o)
}

// anchor = [N_bn, e_int]
fn anchor_N(a) { return a[0] }
fn anchor_e(a) { return a[1] }

// Parse a PEM bundle string into a list of RSA anchors [N_bn, e_int].
// Non-RSA / unparseable / >2048-bit certs are skipped.
fn truststore_load(text) {
    let anchors = list_new()
    if len(text) == 0 { return anchors }
    let pos = 0
    let go = 1
    while go == 1 {
        let b = _pem_find(text, PEM_BEGIN, pos)
        if b < 0 { go = 0 }
        else {
            let body_start = b + len(PEM_BEGIN)
            let e = _pem_find(text, PEM_END, body_start)
            if e < 0 { go = 0 }
            else {
                let b64 = _pem_clean_b64(text, body_start, e)
                let dec = scram_base64_decode(b64)
                if dec != 0 {
                    if dec[1] > 0 {
                        let cert = cert_parse(dec[0], dec[1])
                        if cert_ok(cert) == 1 {
                            let a = list_new()
                            push(a, cert_N(cert))
                            push(a, cert_e(cert))
                            push(anchors, a)
                        }
                    }
                }
                pos = e + len(PEM_END)
            }
        }
    }
    return anchors
}

// Convenience: load anchors directly from a file path (or empty list on miss).
fn truststore_load_file(path) {
    let text = read_file(path)
    if text == 0 { return list_new() }
    return truststore_load(text)
}
