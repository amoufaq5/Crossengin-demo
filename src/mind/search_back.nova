// Backward (goal-directed) proof SEARCH -- a standalone complement to the
// forward, saturating search in search.nova (ADR-0088 v2: construct proofs,
// don't only check them). Where the forward search chains FROM the premises
// until the goal appears, this one works BACKWARD from the goal, decomposing it
// into sub-goals via the kernel's rules and recursing.
//
// Like the forward search this is UNTRUSTED: it builds candidate proof objects,
// and the kernel's verify_check remains the sole gate. So however heuristic or
// incomplete the search is, it can never produce a false theorem -- a returned
// proof is only believed once the kernel re-checks it (the LCF discipline: an
// untrusted tactic proposes, the trusted kernel disposes).
//
// Strategy for goal G, tried in order, each recursion spending one unit of
// budget (so cyclic premises like a->a bottom out instead of looping forever):
//   1. AXIOM    : G structurally matches a premise            -> pf_axiom(G).
//   2. AND_I    : G is (L and R); prove L and R               -> pf_and_i.
//   3. MP       : a premise (A -> G); prove A                 -> pf_mp.
//   4. AND_EL/ER: a premise (G and _) / (_ and G)             -> pf_and_el/er.
// Incomplete by design (no forward chaining, no unification beyond structural
// match); it finds the shallow, mechanical derivations ADR-0088 scopes for v1.
//
// ADRs implemented: ADR-0088 (bounded proof search). CrossEngin dependencies:
// src/mind/verify.nova (terms, rules, term_eq, verify_check).

import "verify.nova"

// Recursively search for a proof of `goal` from `premises` (a list of terms,
// each treated as an AXIOM). `budget` bounds the recursion depth: every
// recursive call spends one unit, and at 0 the search gives up (return 0). This
// is what makes cyclic premises safe -- a->a would otherwise recurse forever.
// Returns a proof object, or 0 if none found within budget. The proof is
// UNVERIFIED here -- the caller must verify_check it (sb_prove_ok does).
fn sb_prove(premises, goal, budget) {
    if budget <= 0 { return 0 }
    if goal == 0 { return 0 }

    // 1. AXIOM: goal already matches a premise.
    let i = 0
    while i < len(premises) {
        if term_eq(premises[i], goal) == 1 {
            return pf_axiom(goal)
        }
        i = i + 1
    }

    // 2. AND-intro: goal is (L and R); prove both halves.
    if term_kind(goal) == TERM_AND {
        let lp = sb_prove(premises, goal[1], budget - 1)
        if lp != 0 {
            let rp = sb_prove(premises, goal[2], budget - 1)
            if rp != 0 {
                return pf_and_i(goal, lp, rp)
            }
        }
    }

    // 3. MP: a premise (A -> goal); prove the antecedent A.
    let j = 0
    while j < len(premises) {
        let pr = premises[j]
        if term_kind(pr) == TERM_IMP {
            if term_eq(pr[2], goal) == 1 {
                let ap = sb_prove(premises, pr[1], budget - 1)
                if ap != 0 {
                    return pf_mp(goal, pf_axiom(pr), ap)
                }
            }
        }
        j = j + 1
    }

    // 4. AND-elim: a premise (goal and _) or (_ and goal).
    let k = 0
    while k < len(premises) {
        let pc = premises[k]
        if term_kind(pc) == TERM_AND {
            if term_eq(pc[1], goal) == 1 {
                return pf_and_el(goal, pf_axiom(pc))
            }
            if term_eq(pc[2], goal) == 1 {
                return pf_and_er(goal, pf_axiom(pc))
            }
        }
        k = k + 1
    }

    return 0
}

// Search AND confirm: build the axiom table from the premises, run the backward
// search, then run the kernel over whatever it returned. Returns 1 iff a
// kernel-verified proof of `goal` was found -- the soundness-gated answer to "is
// this provable from these premises?". The search is untrusted; only this
// verify_check confirms. A fresh proofs registry is passed (unused: search
// proofs are AXIOM-rooted, no HYP).
fn sb_prove_ok(reg, premises, goal, budget) {
    let proof = sb_prove(premises, goal, budget)
    if proof == 0 { return 0 }
    let axioms = axiom_table_new()
    let i = 0
    while i < len(premises) {
        axiom_table_add(axioms, premises[i])
        i = i + 1
    }
    return verify_check(reg, axioms, hyp_new(), proof, goal)
}
