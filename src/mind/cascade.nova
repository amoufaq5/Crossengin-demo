// Cascade re-check (ADR-0088 increment 7): when a lemma's proof flips to
// FAILED, every downstream proof that used it via HYP must also flip
// (proofs.nova proof_invalidate does that, walking the dep edges the kernel
// recorded at check time), AND every FORMAL atom whose proof_ref is no longer
// VERIFIED must be UNPINNED -- grade dropped, belief reset.
//
// The two-layer split (registry-level cascade in proofs.nova, atom-level
// cascade here) keeps the trusted kernel (verify.nova) free of multi_kg_manager
// while letting one entry point realise the full ADR-0088 "re-check trigger"
// contract: dependency atom changed grade, referenced lemma unpinned, proof
// object mutated -- all converge here.
//
// ADRs implemented: ADR-0088 (cascading re-check honesty). CrossEngin
// dependencies: src/mind/verify.nova (verify_unpin_atom + the dep table it
// fed at check time), src/kg/multi_kg_manager.nova (the atom walk).

import "verify.nova"
import "../kg/multi_kg_manager.nova"

// Walk every KG in `kgreg` and unpin every FORMAL atom whose proof is no
// longer VERIFIED. Returns the number of atoms unpinned. Idempotent: a second
// call after the cascade has settled finds nothing to do.
fn _verify_unpin_orphans(reg, kgreg) {
    let unpinned = 0
    let n = kg_count(kgreg)
    let k = 0
    while k < n {
        let kg = kg_get(kgreg, k)
        let atoms = kg_atoms(kg)
        let i = 0
        while i < len(atoms) {
            let a = atoms[i]
            if a != 0 {
                if atom_evidence_grade(a) == GRADE_FORMAL {
                    if atom_proof_verified(reg, a) == 0 {
                        verify_unpin_atom(reg, a)
                        unpinned = unpinned + 1
                    }
                }
            }
            i = i + 1
        }
        k = k + 1
    }
    return unpinned
}

// Invalidate `root_code` and cascade. Two-phase:
//   (1) proof_invalidate(reg, root_code) flips the root and every dependent
//       proof to FAILED via the dep edges.
//   (2) _verify_unpin_orphans walks the KG registry and drops the FORMAL
//       grade off every atom whose proof_ref now resolves to non-VERIFIED.
// Returns [proofs_flipped, atoms_unpinned] so the caller / audit can observe
// the blast radius of the failure.
fn verify_cascade_invalidate(reg, kgreg, root_code) {
    let flipped = proof_invalidate(reg, root_code)
    let unpinned = _verify_unpin_orphans(reg, kgreg)
    let out = list_new()
    push(out, flipped); push(out, unpinned)
    return out
}

fn cascade_flipped(r)  { return r[0] }
fn cascade_unpinned(r) { return r[1] }
