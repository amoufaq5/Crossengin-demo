// First-order unification (ADR-0088 search support). Standard syntactic
// unification over the kernel's term language: given two terms (with variables),
// find a substitution making them identical, or fail. This powers a smarter
// proof search -- it lets backward chaining DISCOVER how to instantiate a
// universal law (unify the law's consequent with the goal -> the binding for x)
// rather than being handed the constant.
//
// This is UNTRUSTED search machinery: nothing here grants a FORMAL grade. The
// proofs a unification-driven search constructs are still gated by the kernel's
// verify_check, so an unsound unification could at worst make the search fail to
// find or propose a bad proof the kernel then rejects -- never a false theorem.
//
// A substitution is a list of [varname, term] bindings. unify returns a result
// [ok, subst]: ok==1 with the extended substitution, or ok==0 (failure).
//
// CrossEngin dependencies: src/mind/verify.nova (term kinds + constructors +
// _label_eq + _term_binary + term_kind).

import "verify.nova"

fn _su_ok(subst)  { let r = list_new() push(r, 1) push(r, subst) return r }
fn _su_fail()     { let r = list_new() push(r, 0) push(r, 0) return r }
fn su_ok(r)       { return r[0] }
fn su_subst(r)    { return r[1] }

fn _su_lookup(subst, vname) {
    let i = 0
    while i < len(subst) {
        if _label_eq(subst[i][0], vname) == 1 { return subst[i][1] }
        i = i + 1
    }
    return 0
}

// Append a binding (copy the list so callers' substitutions are not mutated).
fn _su_bind(subst, vname, term) {
    let out = list_new()
    let i = 0
    while i < len(subst) {
        push(out, subst[i])
        i = i + 1
    }
    let e = list_new() push(e, vname) push(e, term)
    push(out, e)
    return out
}

// Apply a substitution to a term, chasing variable chains (x->y->a).
fn subst_apply(subst, t) {
    let k = term_kind(t)
    if k == TERM_QVAR {
        let b = _su_lookup(subst, t[1])
        if b == 0 { return t }
        return subst_apply(subst, b)
    }
    if k == TERM_ATOM { return t }
    if k == TERM_NUM  { return t }
    if k == TERM_PRED { return term_pred(t[1], subst_apply(subst, t[2])) }
    if k == TERM_FORALL { return term_forall(t[1], subst_apply(subst, t[2])) }
    if k == TERM_EXISTS { return term_exists(t[1], subst_apply(subst, t[2])) }
    return _term_binary(k, subst_apply(subst, t[1]), subst_apply(subst, t[2]))
}

// Occurs check: does variable `vname` occur in `t` (after applying subst)? Used
// to reject cyclic bindings like x = f(x).
fn _su_occurs(vname, t, subst) {
    let a = subst_apply(subst, t)
    return _su_occurs_raw(vname, a)
}

fn _su_occurs_raw(vname, t) {
    let k = term_kind(t)
    if k == TERM_QVAR { return _label_eq(t[1], vname) }
    if k == TERM_ATOM { return 0 }
    if k == TERM_NUM  { return 0 }
    if k == TERM_PRED { return _su_occurs_raw(vname, t[2]) }
    if k == TERM_FORALL { return _su_occurs_raw(vname, t[2]) }
    if k == TERM_EXISTS { return _su_occurs_raw(vname, t[2]) }
    if _su_occurs_raw(vname, t[1]) == 1 { return 1 }
    return _su_occurs_raw(vname, t[2])
}

// Unify `a` and `b` under `subst`. Returns [ok, subst'].
fn unify(a, b, subst) {
    let ta = subst_apply(subst, a)
    let tb = subst_apply(subst, b)
    let ka = term_kind(ta)
    let kb = term_kind(tb)
    if ka == TERM_QVAR {
        if kb == TERM_QVAR {
            if _label_eq(ta[1], tb[1]) == 1 { return _su_ok(subst) }
        }
        if _su_occurs(ta[1], tb, subst) == 1 { return _su_fail() }
        return _su_ok(_su_bind(subst, ta[1], tb))
    }
    if kb == TERM_QVAR {
        if _su_occurs(tb[1], ta, subst) == 1 { return _su_fail() }
        return _su_ok(_su_bind(subst, tb[1], ta))
    }
    if ka != kb { return _su_fail() }
    if ka == TERM_ATOM {
        if _label_eq(ta[1], tb[1]) == 1 { return _su_ok(subst) }
        return _su_fail()
    }
    if ka == TERM_NUM {
        if int_sub(ta[1], tb[1]) == 0 { return _su_ok(subst) }
        return _su_fail()
    }
    if ka == TERM_PRED {
        if _label_eq(ta[1], tb[1]) == 0 { return _su_fail() }
        return unify(ta[2], tb[2], subst)
    }
    if ka == TERM_FORALL {
        if _label_eq(ta[1], tb[1]) == 0 { return _su_fail() }
        return unify(ta[2], tb[2], subst)
    }
    if ka == TERM_EXISTS {
        if _label_eq(ta[1], tb[1]) == 0 { return _su_fail() }
        return unify(ta[2], tb[2], subst)
    }
    // binary connective / arithmetic: unify left, then right under the result.
    let r1 = unify(ta[1], tb[1], subst)
    if r1[0] == 0 { return r1 }
    return unify(ta[2], tb[2], r1[1])
}

// Convenience: try to unify `a` and `b` from scratch; return the substitution or
// 0 on failure.
fn unify_terms(a, b) {
    let r = unify(a, b, list_new())
    if r[0] == 0 { return 0 }
    return r[1]
}
