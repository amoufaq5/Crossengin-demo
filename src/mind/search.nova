// Bounded proof SEARCH (ADR-0088 v2: construct proofs, don't only check them).
// Everything so far checks a supplied derivation; this forward-chains over known
// premises to CONSTRUCT one for a goal. Crucially the search is UNTRUSTED -- it
// builds candidate proof objects, and the kernel's verify_check remains the sole
// gate. So however heuristic or incomplete the search is, it can never produce a
// false theorem: a returned proof is only believed once the kernel re-checks it.
// (This is the LCF discipline: an untrusted tactic proposes, the trusted kernel
// disposes.)
//
// The strategy is saturating forward chaining to a budget: seed the "known" set
// with each premise (proved by AXIOM), then repeatedly apply the kernel's rules
// -- MP, HS, AND-elim, and universal instantiation at supplied constants --
// adding any newly-derived [term, proof] pair (deduped by term_eq) until the
// goal appears, a fixpoint is reached, or the budget is spent. Incomplete by
// design (no backward search, no unification beyond ground instantiation); it
// finds the shallow, mechanical derivations ADR-0088 scopes for v1 search.
//
// ADRs implemented: ADR-0088 (bounded proof search). CrossEngin dependencies:
// src/mind/verify.nova (terms, rules, _subst, verify_check).

import "verify.nova"

// Cap on the known set so a pathological premise set can't blow up memory.
let _SEARCH_MAX_KNOWN = 256

// A known fact is [term, proof]. The proof verifies against an axiom table that
// contains every seed premise (each seed is proved by AXIOM; derived facts by
// composite proofs over those).
fn _k_term(k)  { return k[0] }
fn _k_proof(k) { return k[1] }

fn _known_find(known, goal) {
    let i = 0
    while i < len(known) {
        if term_eq(_k_term(known[i]), goal) == 1 { return _k_proof(known[i]) }
        i = i + 1
    }
    return 0
}

fn _known_has(known, term) {
    if _known_find(known, term) == 0 { return 0 }
    return 1
}

// Add [term, proof] to `known` if not already present and under the cap.
// Returns 1 if it was added.
fn _known_add(known, term, proof) {
    if len(known) >= _SEARCH_MAX_KNOWN { return 0 }
    if _known_has(known, term) == 1 { return 0 }
    let e = list_new()
    push(e, term) push(e, proof)
    push(known, e)
    return 1
}

// One saturation pass: try every rule over the current known set, appending new
// facts. Returns the count added this pass (0 == fixpoint). `consts` is the list
// of constant terms to instantiate universals at.
fn _search_step(known, consts) {
    let added = 0
    let n = len(known)
    // single-premise rules: AND-elim, UI.
    let i = 0
    while i < n {
        let k = known[i]
        let t = _k_term(k)
        let kind = term_kind(t)
        if kind == TERM_AND {
            if _known_add(known, t[1], pf_and_el(t[1], _k_proof(k))) == 1 { added = added + 1 }
            if _known_add(known, t[2], pf_and_er(t[2], _k_proof(k))) == 1 { added = added + 1 }
        }
        if kind == TERM_FORALL {
            let c = 0
            while c < len(consts) {
                let inst = _subst(t[2], t[1], consts[c])
                if _known_add(known, inst, pf_ui(inst, _k_proof(k), consts[c])) == 1 {
                    added = added + 1
                }
                c = c + 1
            }
        }
        i = i + 1
    }
    // two-premise rules: MP, HS. Re-read len each time so we pair over the
    // originals of this pass (newly-added facts get their turn next pass).
    let a = 0
    while a < n {
        let ka = known[a]
        let ta = _k_term(ka)
        if term_kind(ta) == TERM_IMP {
            let b = 0
            while b < n {
                let kb = known[b]
                let tb = _k_term(kb)
                // MP: (A -> B) and A  |- B
                if term_eq(ta[1], tb) == 1 {
                    if _known_add(known, ta[2], pf_mp(ta[2], _k_proof(ka), _k_proof(kb))) == 1 {
                        added = added + 1
                    }
                }
                // HS: (A -> B) and (B -> C)  |- (A -> C)
                if term_kind(tb) == TERM_IMP {
                    if term_eq(ta[2], tb[1]) == 1 {
                        let comp = term_imp(ta[1], tb[2])
                        if _known_add(known, comp, pf_hs(comp, _k_proof(ka), _k_proof(kb))) == 1 {
                            added = added + 1
                        }
                    }
                }
                b = b + 1
            }
        }
        a = a + 1
    }
    return added
}

// Search for a proof of `goal` from `premises` (a list of terms), instantiating
// universals at the constant terms in `consts`, up to `budget` saturation
// passes. Returns a proof object, or 0 if not found within budget. The proof is
// UNVERIFIED here -- the caller must verify_check it (search_prove_ok does).
fn search_prove(premises, consts, goal, budget) {
    let known = list_new()
    let i = 0
    while i < len(premises) {
        _known_add(known, premises[i], pf_axiom(premises[i]))
        i = i + 1
    }
    let found = _known_find(known, goal)
    if found != 0 { return found }
    let pass = 0
    while pass < budget {
        let added = _search_step(known, consts)
        found = _known_find(known, goal)
        if found != 0 { return found }
        if added == 0 { return 0 }       // fixpoint -- no proof exists at this depth
        pass = pass + 1
    }
    return _known_find(known, goal)
}

// Search AND confirm: build the axiom table from the premises, search, then run
// the kernel over whatever the search returned. Returns 1 iff a kernel-verified
// proof of `goal` was found -- the soundness-gated answer to "is this provable
// from these premises?". A fresh proofs registry is passed (unused: search
// proofs are AXIOM-rooted, no HYP).
fn search_prove_ok(reg, premises, consts, goal, budget) {
    let proof = search_prove(premises, consts, goal, budget)
    if proof == 0 { return 0 }
    let axioms = axiom_table_new()
    let i = 0
    while i < len(premises) {
        axiom_table_add(axioms, premises[i])
        i = i + 1
    }
    return verify_check(reg, axioms, hyp_new(), proof, goal)
}
