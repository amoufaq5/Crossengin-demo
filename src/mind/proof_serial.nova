// Proof serialization (ADR-0088 durability). Persisting a FORMAL atom's GRADE
// alone is unsound: on reload the atom would claim theorem-grade with no
// re-checkable derivation behind it, contradicting ADR-0088's "the pin is
// conditional on re-checkability". So we serialize the DERIVATIONS -- terms and
// proof trees -- and the restore path RE-RUNS THE KERNEL over them, re-earning
// every FORMAL grade from verified ground. A tampered persisted proof simply
// fails to re-verify and is not re-pinned.
//
// Format: a flat newline-separated token stream, parsed by recursive descent
// with a cursor. Every node emits a single-char tag, then its parts in pre-
// order. Atom labels are emitted verbatim on their own line and read
// positionally (so a label that happens to equal a tag char is harmless). No
// str_eq anywhere -- tags are single chars compared by code, lengths by int.
//
//   terms:  a <label>            atom
//           n <left> <right>     and
//           i <left> <right>     imp
//           o <left> <right>     or
//           f <left> <right>     iff
//   proofs: X <term>             axiom
//           H <term> <label>     hyp (rests on a FORMAL lemma by label)
//           1 <term> <lp> <rp>   and_i
//           2 <term> <cp>        and_el
//           3 <term> <cp>        and_er
//           4 <term> <ip> <ap>   mp
//           6 <term> <sp>        or_il
//           7 <term> <sp>        or_ir
//           8 <term> <ab> <ba>   iff_i
//           9 <term> <ip>        iff_el
//           E <term> <ip>        iff_er
//           S <term> <ab> <bc>   hs
//
// ADRs implemented: ADR-0088 (re-checkable persistence). CrossEngin
// dependencies: src/mind/verify.nova (term + proof constructors/kinds).

import "verify.nova"

// ---- token stream + cursor -------------------------------------------------
fn _ps_join(tokens) {
    let out = ""
    let i = 0
    while i < len(tokens) {
        if i > 0 { out = out + "\n" }
        out = out + tokens[i]
        i = i + 1
    }
    return out
}

fn _ps_split(s) {
    let lines = list_new()
    let n = len(s)
    let start = 0
    let i = 0
    while i < n {
        if char_at(s, i) == 10 {            // newline
            push(lines, substr(s, start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    push(lines, substr(s, start, n - start))
    return lines
}

// A cursor is [lines, idx_holder] where idx_holder is a 1-element list so the
// recursive parsers can advance a shared index.
fn ps_cursor(s) {
    let cur = list_new()
    push(cur, _ps_split(s))
    let idx = list_new() push(idx, 0)
    push(cur, idx)
    return cur
}

fn _cur_next(cur) {
    let lines = cur[0]
    let idx = cur[1]
    let i = idx[0]
    list_set(idx, 0, i + 1)
    return lines[i]
}

fn ps_cursor_done(cur) {
    if cur[1][0] >= len(cur[0]) { return 1 }
    return 0
}

// ---- term serialize / parse ------------------------------------------------
fn term_ser(out, t) {
    let k = term_kind(t)
    if k == TERM_ATOM {
        push(out, "a") push(out, t[1])
        return 1
    }
    if k == TERM_NUM {
        push(out, "m") push(out, int_to_str(t[1]))   // numeric literal
        return 1
    }
    if k == TERM_QVAR {
        push(out, "v") push(out, t[1])               // variable
        return 1
    }
    if k == TERM_PRED {
        push(out, "r") push(out, t[1]) term_ser(out, t[2])   // pred name + arg
        return 1
    }
    if k == TERM_FORALL {
        push(out, "u") push(out, t[1]) term_ser(out, t[2])   // varname + body
        return 1
    }
    if k == TERM_EXISTS {
        push(out, "e") push(out, t[1]) term_ser(out, t[2])
        return 1
    }
    if k == TERM_AND { push(out, "n") }
    else { if k == TERM_IMP { push(out, "i") }
    else { if k == TERM_OR  { push(out, "o") }
    else { if k == TERM_IFF { push(out, "f") }
    else { if k == TERM_ADD { push(out, "p") }       // plus
    else { if k == TERM_MUL { push(out, "x") }       // times
    else { if k == TERM_SUB { push(out, "s") }       // subtract
    else { if k == TERM_DIV { push(out, "d") }       // divide
    else {                    push(out, "q") } } } } } } } }  // TERM_EQ (equals)
    term_ser(out, t[1])
    term_ser(out, t[2])
    return 1
}

fn _ps_tag_eq(s, c) {
    if len(s) != 1 { return 0 }
    if char_at(s, 0) == c { return 1 }
    return 0
}

fn term_parse(cur) {
    let tag = _cur_next(cur)
    if _ps_tag_eq(tag, 97)  {            // 'a' atom
        return term_atom(_cur_next(cur))
    }
    if _ps_tag_eq(tag, 109) {            // 'm' numeric literal
        return term_num(str_to_int(_cur_next(cur)))
    }
    if _ps_tag_eq(tag, 118) {            // 'v' variable
        return term_var(_cur_next(cur))
    }
    if _ps_tag_eq(tag, 114) {            // 'r' predicate (name, arg)
        let name = _cur_next(cur)
        return term_pred(name, term_parse(cur))
    }
    if _ps_tag_eq(tag, 117) {            // 'u' forall (varname, body)
        let vn = _cur_next(cur)
        return term_forall(vn, term_parse(cur))
    }
    if _ps_tag_eq(tag, 101) {            // 'e' exists (varname, body)
        let vn = _cur_next(cur)
        return term_exists(vn, term_parse(cur))
    }
    let l = term_parse(cur)
    let r = term_parse(cur)
    if _ps_tag_eq(tag, 110) { return term_and(l, r) }    // 'n'
    if _ps_tag_eq(tag, 105) { return term_imp(l, r) }    // 'i'
    if _ps_tag_eq(tag, 111) { return term_or(l, r) }     // 'o'
    if _ps_tag_eq(tag, 102) { return term_iff(l, r) }    // 'f'
    if _ps_tag_eq(tag, 112) { return term_add(l, r) }    // 'p'
    if _ps_tag_eq(tag, 120) { return term_mul(l, r) }    // 'x'
    if _ps_tag_eq(tag, 115) { return term_sub(l, r) }    // 's'
    if _ps_tag_eq(tag, 100) { return term_div(l, r) }    // 'd'
    return term_equals(l, r)                             // 'q' equals
}

// ---- term list (axiom tables) ----------------------------------------------
fn term_list_ser(out, terms) {
    push(out, int_to_str(len(terms)))
    let i = 0
    while i < len(terms) {
        term_ser(out, terms[i])
        i = i + 1
    }
    return 1
}

fn term_list_parse(cur) {
    let n = str_to_int(_cur_next(cur))
    let out = list_new()
    let i = 0
    while i < n {
        push(out, term_parse(cur))
        i = i + 1
    }
    return out
}

// ---- proof serialize / parse -----------------------------------------------
fn proof_ser(out, p) {
    let rule = proof_rule(p)
    if rule == PROOF_AXIOM  { push(out, "X") term_ser(out, p[1]) return 1 }
    if rule == PROOF_HYP    { push(out, "H") term_ser(out, p[1]) push(out, p[2]) return 1 }
    if rule == PROOF_AND_I  { push(out, "1") term_ser(out, p[1]) proof_ser(out, p[2]) proof_ser(out, p[3]) return 1 }
    if rule == PROOF_AND_EL { push(out, "2") term_ser(out, p[1]) proof_ser(out, p[2]) return 1 }
    if rule == PROOF_AND_ER { push(out, "3") term_ser(out, p[1]) proof_ser(out, p[2]) return 1 }
    if rule == PROOF_MP     { push(out, "4") term_ser(out, p[1]) proof_ser(out, p[2]) proof_ser(out, p[3]) return 1 }
    if rule == PROOF_OR_IL  { push(out, "6") term_ser(out, p[1]) proof_ser(out, p[2]) return 1 }
    if rule == PROOF_OR_IR  { push(out, "7") term_ser(out, p[1]) proof_ser(out, p[2]) return 1 }
    if rule == PROOF_IFF_I  { push(out, "8") term_ser(out, p[1]) proof_ser(out, p[2]) proof_ser(out, p[3]) return 1 }
    if rule == PROOF_IFF_EL { push(out, "9") term_ser(out, p[1]) proof_ser(out, p[2]) return 1 }
    if rule == PROOF_IFF_ER { push(out, "E") term_ser(out, p[1]) proof_ser(out, p[2]) return 1 }
    if rule == PROOF_EVAL   { push(out, "V") term_ser(out, p[1]) return 1 }  // leaf
    if rule == PROOF_UI     { push(out, "U") term_ser(out, p[1]) proof_ser(out, p[2]) term_ser(out, p[3]) return 1 }
    if rule == PROOF_EI     { push(out, "Y") term_ser(out, p[1]) proof_ser(out, p[2]) term_ser(out, p[3]) return 1 }
    if rule == PROOF_UG     { push(out, "G") term_ser(out, p[1]) proof_ser(out, p[2]) term_ser(out, p[3]) return 1 }
    if rule == PROOF_EE     { push(out, "Z") term_ser(out, p[1]) proof_ser(out, p[2]) term_ser(out, p[3]) push(out, p[4]) proof_ser(out, p[5]) return 1 }
    // PROOF_HS
    push(out, "S") term_ser(out, p[1]) proof_ser(out, p[2]) proof_ser(out, p[3])
    return 1
}

fn proof_parse(cur) {
    let tag = _cur_next(cur)
    if _ps_tag_eq(tag, 88)  {            // 'X' axiom
        return pf_axiom(term_parse(cur))
    }
    if _ps_tag_eq(tag, 72)  {            // 'H' hyp
        let t = term_parse(cur)
        let label = _cur_next(cur)
        return pf_hyp(t, label)
    }
    if _ps_tag_eq(tag, 49)  {            // '1' and_i
        let t = term_parse(cur)
        let lp = proof_parse(cur)
        let rp = proof_parse(cur)
        return pf_and_i(t, lp, rp)
    }
    if _ps_tag_eq(tag, 50)  {            // '2' and_el
        let t = term_parse(cur) return pf_and_el(t, proof_parse(cur))
    }
    if _ps_tag_eq(tag, 51)  {            // '3' and_er
        let t = term_parse(cur) return pf_and_er(t, proof_parse(cur))
    }
    if _ps_tag_eq(tag, 52)  {            // '4' mp
        let t = term_parse(cur)
        let ip = proof_parse(cur)
        let ap = proof_parse(cur)
        return pf_mp(t, ip, ap)
    }
    if _ps_tag_eq(tag, 54)  {            // '6' or_il
        let t = term_parse(cur) return pf_or_il(t, proof_parse(cur))
    }
    if _ps_tag_eq(tag, 55)  {            // '7' or_ir
        let t = term_parse(cur) return pf_or_ir(t, proof_parse(cur))
    }
    if _ps_tag_eq(tag, 56)  {            // '8' iff_i
        let t = term_parse(cur)
        let ab = proof_parse(cur)
        let ba = proof_parse(cur)
        return pf_iff_i(t, ab, ba)
    }
    if _ps_tag_eq(tag, 57)  {            // '9' iff_el
        let t = term_parse(cur) return pf_iff_el(t, proof_parse(cur))
    }
    if _ps_tag_eq(tag, 69)  {            // 'E' iff_er
        let t = term_parse(cur) return pf_iff_er(t, proof_parse(cur))
    }
    if _ps_tag_eq(tag, 86)  {            // 'V' eval (leaf)
        return pf_eval(term_parse(cur))
    }
    if _ps_tag_eq(tag, 85)  {            // 'U' universal instantiation
        let t = term_parse(cur)
        let fp = proof_parse(cur)
        let inst = term_parse(cur)
        return pf_ui(t, fp, inst)
    }
    if _ps_tag_eq(tag, 89)  {            // 'Y' existential introduction
        let t = term_parse(cur)
        let wp = proof_parse(cur)
        let witness = term_parse(cur)
        return pf_ei(t, wp, witness)
    }
    if _ps_tag_eq(tag, 71)  {            // 'G' universal generalization
        let t = term_parse(cur)
        let sp = proof_parse(cur)
        let eigen = term_parse(cur)
        return pf_ug(t, sp, eigen)
    }
    if _ps_tag_eq(tag, 90)  {            // 'Z' existential elimination
        let t = term_parse(cur)
        let ep = proof_parse(cur)
        let eigen = term_parse(cur)
        let wlabel = _cur_next(cur)
        let sub = proof_parse(cur)
        return pf_ee(t, ep, eigen, wlabel, sub)
    }
    // 'S' hs
    let t = term_parse(cur)
    let ab = proof_parse(cur)
    let bc = proof_parse(cur)
    return pf_hs(t, ab, bc)
}

// Round-trip convenience for a single term / proof.
fn term_to_str(t)  { let o = list_new() term_ser(o, t)  return _ps_join(o) }
fn term_from_str(s){ return term_parse(ps_cursor(s)) }
fn proof_to_str(p) { let o = list_new() proof_ser(o, p) return _ps_join(o) }
fn proof_from_str(s){ return proof_parse(ps_cursor(s)) }
