// Unification-driven backward proof search (ADR-0088). The forward/backward
// searches so far instantiate universals only at constants they are TOLD; this
// one DISCOVERS the instantiation by unifying a universal law's consequent with
// the goal. So it proves mortal(socrates) from forall x.(human(x)->mortal(x))
// and human(socrates) with no hint about the witness -- it unifies mortal(x)
// with mortal(socrates), finds x:=socrates, instantiates, and recurses.
//
// UNTRUSTED, like all search: su_solve builds candidate proof objects;
// su_solve_ok gates them through the kernel's verify_check, which is the sole
// arbiter. A bad unification can only make the search fail or propose a proof
// the kernel rejects -- never a false theorem.
//
// CrossEngin dependencies: src/mind/unify.nova (-> verify.nova: terms, _subst,
// _term_is_closed, pf_*, verify_check).

import "unify.nova"

// Try to prove `goal` from `premises` (a list of terms), discovering universal
// instantiations by unification, up to `budget` recursion depth. Returns a proof
// object or 0. UNVERIFIED -- the caller must verify_check it (su_solve_ok does).
fn su_solve(premises, goal, budget) {
    if budget <= 0 { return 0 }
    // (1) direct: a premise equal to the goal.
    let i = 0
    while i < len(premises) {
        if term_eq(premises[i], goal) == 1 { return pf_axiom(premises[i]) }
        i = i + 1
    }
    // (2) universal laws: discover the instantiation by unifying with the goal.
    let j = 0
    while j < len(premises) {
        let law = premises[j]
        if term_kind(law) == TERM_FORALL {
            let x = law[1]
            let body = law[2]
            if term_kind(body) == TERM_IMP {
                // unify the consequent C with the goal -> x := t.
                let s = unify_terms(body[2], goal)
                if s != 0 {
                    let t = subst_apply(s, term_var(x))
                    if _term_is_closed(t) == 1 {
                        let inst = _subst(body, x, t)    // A[x:=t] -> C[x:=t]
                        if term_eq(inst[2], goal) == 1 {
                            // prove the antecedent A[x:=t], then MP.
                            let pa = su_solve(premises, inst[1], budget - 1)
                            if pa != 0 {
                                return pf_mp(goal, pf_ui(inst, pf_axiom(law), t), pa)
                            }
                        }
                    }
                }
            } else {
                // forall x. B (non-implication): instantiate B directly to goal.
                let s = unify_terms(body, goal)
                if s != 0 {
                    let t = subst_apply(s, term_var(x))
                    if _term_is_closed(t) == 1 {
                        let inst = _subst(body, x, t)
                        if term_eq(inst, goal) == 1 {
                            return pf_ui(goal, pf_axiom(law), t)
                        }
                    }
                }
            }
        }
        j = j + 1
    }
    return 0
}

// Search AND kernel-confirm. Builds the axiom table from the premises, runs the
// unification search, then verify_checks whatever it returns. Returns 1 iff a
// kernel-verified proof of `goal` was found.
fn su_solve_ok(reg, premises, goal, budget) {
    let proof = su_solve(premises, goal, budget)
    if proof == 0 { return 0 }
    let axioms = axiom_table_new()
    let i = 0
    while i < len(premises) {
        axiom_table_add(axioms, premises[i])
        i = i + 1
    }
    return verify_check(reg, axioms, hyp_new(), proof, goal)
}
