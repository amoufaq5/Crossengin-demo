// Arbitrary-precision (bignum) integer library for NOVA.
//
// Representation: a bignum is a NOVA list [sign, d0, d1, ...] where:
//   - sign is 1 (non-negative) or -1 (negative, written as `0 - 1`),
//   - d0,d1,... are base-10000 "digits", LITTLE-ENDIAN (least significant
//     first). Base 10000 keeps any digit*digit product <= ~1e8, safely within
//     NOVA's exact-integer range, and keeps schoolbook carries small.
//   - Zero is canonical: [1, 0] (sign 1, single zero digit). Normalization
//     strips leading zero-digits and forces zero's sign to 1.
//
// NOVA gotchas honored here:
//   - == / != structurally dereference operands >= 0x100000, so for integer
//     equality of possibly-large values we use `int_sub(a,b) == 0`. Comparing
//     against the literal 0 with == is safe. Digit values are < 10000, so
//     digit-level == is safe; accumulated sums are compared with < / >.
//   - No function exceeds 6 parameters.
//   - No str_eq: strings are built/compared via char_at / substr / `+`.
//
// CrossEngin dependencies: none (builtins only).

let BN_BASE = 10000

// ---- construction helpers --------------------------------------------------

// A fresh magnitude list (no sign) with a single zero digit.
fn _mbn_mag_zero() {
    let m = list_new()
    push(m, 0)
    return m
}

// Build a bignum from a sign and an already-built little-endian digit list,
// then normalize.
fn _mbn_make(sign, digits) {
    let b = list_new()
    push(b, sign)
    let i = 0
    while i < len(digits) {
        push(b, digits[i])
        i = i + 1
    }
    return _mbn_normalize(b)
}

// Strip leading (most-significant) zero digits and canonicalize zero's sign.
fn _mbn_normalize(b) {
    let sign = b[0]
    // number of digits = len(b) - 1; strip trailing entries (most significant)
    // that are zero, keeping at least one digit.
    let last = len(b) - 1          // index of most-significant digit
    while last > 1 {
        if b[last] == 0 {
            last = last - 1
        } else {
            last = 0 - last        // sentinel: stop (encode as negative)
        }
    }
    // recover real stop index
    if last < 0 { last = 0 - last }
    // rebuild
    let out = list_new()
    // zero detection: all digits zero?
    let allzero = 1
    let i = 1
    while i <= last {
        if b[i] == 0 {
            i = i + 1
        } else {
            allzero = 0
            i = last + 1
        }
    }
    if allzero == 1 {
        push(out, 1)
        push(out, 0)
        return out
    }
    push(out, sign)
    i = 1
    while i <= last {
        push(out, b[i])
        i = i + 1
    }
    return out
}

// Number of base-10000 digits in a bignum.
fn _mbn_ndigits(b) {
    return len(b) - 1
}

// ---- from_int --------------------------------------------------------------

fn mbn_from_int(n) {
    let sign = 1
    let v = n
    if v < 0 {
        sign = 0 - 1
        v = 0 - v
    }
    let digits = list_new()
    if v == 0 {
        push(digits, 0)
    } else {
        while v > 0 {
            push(digits, v - (v / BN_BASE) * BN_BASE)   // v % BASE
            v = v / BN_BASE
        }
    }
    return _mbn_make(sign, digits)
}

// ---- from_str --------------------------------------------------------------

// Parse a decimal string (optional leading '-') into a bignum.
fn mbn_from_str(s) {
    let n = len(s)
    let sign = 1
    let start = 0
    if n > 0 {
        if char_at(s, 0) == 45 {        // '-'
            sign = 0 - 1
            start = 1
        }
    }
    // Build base-10000 digits little-endian by scanning decimal text from the
    // least-significant end in groups of 4.
    let digits = list_new()
    let i = n                            // one past the end
    while i > start {
        let lo = i - 4
        if lo < start { lo = start }
        // value of substr(s, lo, i-lo)
        let val = 0
        let j = lo
        while j < i {
            val = val * 10 + (char_at(s, j) - 48)
            j = j + 1
        }
        push(digits, val)
        i = lo
    }
    if len(digits) == 0 {
        push(digits, 0)
    }
    return _mbn_make(sign, digits)
}

// ---- to_str ----------------------------------------------------------------

// Zero-pad an int in [0,9999] to exactly 4 chars.
fn _mbn_pad4(v) {
    let s = int_to_str(v)
    let l = len(s)
    let out = ""
    while l < 4 {
        out = out + "0"
        l = l + 1
    }
    return out + s
}

fn mbn_to_str(b) {
    if mbn_is_zero(b) == 1 {
        return "0"
    }
    let nd = _mbn_ndigits(b)
    // most significant digit (index nd) printed without padding; the rest padded.
    let out = ""
    if b[0] < 0 {
        out = "-"
    }
    out = out + int_to_str(b[nd])
    let i = nd - 1
    while i >= 1 {
        out = out + _mbn_pad4(b[i])
        i = i - 1
    }
    return out
}

// ---- predicates / comparison ----------------------------------------------

fn mbn_is_zero(b) {
    // canonical zero is exactly one digit equal to 0.
    if _mbn_ndigits(b) == 1 {
        if b[1] == 0 {
            return 1
        }
    }
    return 0
}

// Compare magnitudes only (ignore sign): returns -1/0/1.
fn _mbn_mag_cmp(a, b) {
    let na = _mbn_ndigits(a)
    let nb = _mbn_ndigits(b)
    if na < nb { return 0 - 1 }
    if na > nb { return 1 }
    let i = na
    while i >= 1 {
        if a[i] < b[i] { return 0 - 1 }
        if a[i] > b[i] { return 1 }
        i = i - 1
    }
    return 0
}

fn mbn_cmp(a, b) {
    let sa = a[0]
    let sb = b[0]
    let za = mbn_is_zero(a)
    let zb = mbn_is_zero(b)
    if za == 1 {
        if zb == 1 { return 0 }
        if sb < 0 { return 1 }
        return 0 - 1
    }
    if zb == 1 {
        if sa < 0 { return 0 - 1 }
        return 1
    }
    // both nonzero
    if sa < 0 {
        if sb > 0 { return 0 - 1 }
        // both negative: reverse magnitude comparison
        return 0 - _mbn_mag_cmp(a, b)
    }
    // sa > 0
    if sb < 0 { return 1 }
    return _mbn_mag_cmp(a, b)
}

fn mbn_eq(a, b) {
    if mbn_cmp(a, b) == 0 { return 1 }
    return 0
}

// ---- magnitude arithmetic --------------------------------------------------

// Add magnitudes of a and b, return a little-endian digit list (unnormalized
// trailing zeros possible but harmless; _mbn_make normalizes).
fn _mbn_mag_add(a, b) {
    let na = _mbn_ndigits(a)
    let nb = _mbn_ndigits(b)
    let nmax = na
    if nb > nmax { nmax = nb }
    let out = list_new()
    let carry = 0
    let i = 1
    while i <= nmax {
        let da = 0
        let db = 0
        if i <= na { da = a[i] }
        if i <= nb { db = b[i] }
        let s = da + db + carry
        carry = s / BN_BASE
        push(out, s - carry * BN_BASE)
        i = i + 1
    }
    if carry > 0 {
        push(out, carry)
    }
    return out
}

// Subtract magnitude of b from magnitude of a, REQUIRING mag(a) >= mag(b).
// Returns a little-endian digit list.
fn _mbn_mag_sub(a, b) {
    let na = _mbn_ndigits(a)
    let nb = _mbn_ndigits(b)
    let out = list_new()
    let borrow = 0
    let i = 1
    while i <= na {
        let da = a[i]
        let db = 0
        if i <= nb { db = b[i] }
        let s = da - db - borrow
        if s < 0 {
            s = s + BN_BASE
            borrow = 1
        } else {
            borrow = 0
        }
        push(out, s)
        i = i + 1
    }
    return out
}

// ---- sign-aware add / sub --------------------------------------------------

fn _mbn_negate(b) {
    if mbn_is_zero(b) == 1 {
        return _mbn_make(1, _mbn_mag_zero())
    }
    let digits = list_new()
    let i = 1
    while i <= _mbn_ndigits(b) {
        push(digits, b[i])
        i = i + 1
    }
    return _mbn_make(0 - b[0], digits)
}

fn mbn_add(a, b) {
    let sa = a[0]
    let sb = b[0]
    if mbn_is_zero(a) == 1 { return _mbn_make(b[0], _mbn_tail(b)) }
    if mbn_is_zero(b) == 1 { return _mbn_make(a[0], _mbn_tail(a)) }
    if int_sub(sa, sb) == 0 {
        // same sign: add magnitudes, keep sign
        return _mbn_make(sa, _mbn_mag_add(a, b))
    }
    // different signs: subtract smaller magnitude from larger; sign of larger.
    let c = _mbn_mag_cmp(a, b)
    if c == 0 {
        return _mbn_make(1, _mbn_mag_zero())
    }
    if c > 0 {
        return _mbn_make(sa, _mbn_mag_sub(a, b))
    }
    return _mbn_make(sb, _mbn_mag_sub(b, a))
}

fn mbn_sub(a, b) {
    return mbn_add(a, _mbn_negate(b))
}

// Copy the digit tail (little-endian digits) of a bignum.
fn _mbn_tail(b) {
    let digits = list_new()
    let i = 1
    while i <= _mbn_ndigits(b) {
        push(digits, b[i])
        i = i + 1
    }
    return digits
}

// ---- multiply (schoolbook) -------------------------------------------------

fn mbn_mul(a, b) {
    if mbn_is_zero(a) == 1 { return _mbn_make(1, _mbn_mag_zero()) }
    if mbn_is_zero(b) == 1 { return _mbn_make(1, _mbn_mag_zero()) }
    let na = _mbn_ndigits(a)
    let nb = _mbn_ndigits(b)
    // accumulator of na+nb digits, all zero.
    let acc = list_new()
    let k = 0
    while k < na + nb {
        push(acc, 0)
        k = k + 1
    }
    let i = 1
    while i <= na {
        let carry = 0
        let j = 1
        while j <= nb {
            // acc index (0-based) for place (i-1)+(j-1)
            let idx = (i - 1) + (j - 1)
            let cur = acc[idx]
            let prod = a[i] * b[j] + cur + carry
            carry = prod / BN_BASE
            list_set(acc, idx, prod - carry * BN_BASE)
            j = j + 1
        }
        // propagate remaining carry
        let idx2 = (i - 1) + nb
        while carry > 0 {
            let cur2 = acc[idx2]
            let s = cur2 + carry
            carry = s / BN_BASE
            list_set(acc, idx2, s - carry * BN_BASE)
            idx2 = idx2 + 1
        }
        i = i + 1
    }
    let sign = 1
    if int_sub(a[0], b[0]) != 0 {
        sign = 0 - 1
    }
    return _mbn_make(sign, acc)
}
