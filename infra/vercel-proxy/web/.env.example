# Vercel proxy environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for `next dev`, OR configure the same names in
# Vercel project settings (Settings -> Environment Variables) for production.
#
# Never commit a real .env.local -- the bearer token is the only auth between
# your Vercel function and the Linux backend; leaking it = remote chat access.

# Backend base URL (no trailing slash). For production this MUST be HTTPS; for
# local `vercel dev` against `docker-compose up` you can use http://localhost:8080.
CROSSENGIN_URL=https://crossengin.example.com

# Shared bearer token. Must match the CROSSENGIN_TOKEN value the backend's
# `server.py` reads at startup. Use `openssl rand -hex 32` to generate one.
# Rotation: change in both Vercel project env AND backend service env, then
# redeploy / restart -- there is no overlap window in v0.1 (see SECURITY.md
# for the JWT upgrade path that lifts that limitation).
CROSSENGIN_TOKEN=replace-me-with-openssl-rand-hex-32
