; CrossEngin TLS sidecar -- stunnel config (R54.1, ADR-0105 §Transport TLS)
;
; Puts stunnel in front of `crossengin-rpc-daemon` (loopback :9876) and
; exposes an encrypted endpoint on :9977. Copy to /etc/stunnel/, tweak
; the cert path + accept address, and start:
;
;   sudo stunnel /etc/stunnel/crossengin.conf
;
; Combined with `CE_RPC_REQUIRE_TOKEN=1` on the daemon, this covers the
; "LAN deployment" story: the wire is encrypted AND every request must
; carry a live capability token.
;
; Client side:
;   scripts/rpc.sh over HTTPS is out of scope; use curl or a real
;   TLS-capable client. Example:
;     curl --cacert ~/.crossengin/tls/server.pem \
;          -H 'Content-Type: application/json' \
;          -d '{"verb":"kg.list","token":"'"$CE_RPC_TOKEN"'"}' \
;          https://your.host:9977/
;   (nb: this stunnel config forwards RAW TCP -- the "https://" URL
;    doesn't imply HTTP framing on the far side; the daemon still
;    speaks its line-oriented JSON protocol post-TLS. Use `openssl
;    s_client` or a socket client that sends the request line + reads
;    the response line without adding HTTP headers.)
;
; ---- global -----------------------------------------------------------------

foreground = no
pid        = /run/stunnel-crossengin.pid
output     = /var/log/stunnel-crossengin.log
setuid     = stunnel
setgid     = stunnel

; Refuse everything below TLS 1.2. TLS 1.3 preferred where available.
sslVersionMin = TLSv1.2

; Disable weak / broken suites. stunnel's default is already sane on
; recent openssl; this line makes the choice explicit for audit.
ciphersuites  = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
ciphers       = ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!MD5:!DSS

; ---- crossengin RPC service ------------------------------------------------

[crossengin-rpc]

; Point at the cert + key bundle scripts/gen_tls_cert.sh produced (or
; a real CA-signed cert -- see docs/DEPLOY_TLS.md for the Let's Encrypt
; recipe). stunnel wants a single file containing cert first, key second.
cert   = /etc/stunnel/crossengin.pem

; Public-facing TLS endpoint. Change to your LAN interface / hostname.
; Leaving 0.0.0.0 is fine on a LAN; do NOT expose to the public internet
; without a mTLS story (R54.2 signed skill install won't save you here --
; the wire executes any skill installed on the daemon, which is arbitrary
; code inside the daemon process).
accept  = 0.0.0.0:9977

; Loopback target: the plain-TCP crossengin-rpc-daemon that
; scripts/rpc_daemon.sh boots. The daemon MUST be bound to loopback so
; the TLS termination is the only ingress path.
connect = 127.0.0.1:9876

; Half-close (SHUT_WR) semantics: the RPC daemon closes after writing
; each response; stunnel must forward that close cleanly.
delay = no

; No per-connection log spam (each request is one connection here).
verbose = no
