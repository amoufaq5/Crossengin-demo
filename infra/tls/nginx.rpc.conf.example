# CrossEngin TLS sidecar -- nginx `stream` config (R54.1, ADR-0105).
#
# Alternative to stunnel for operators already running nginx. Uses
# nginx's `stream` module (not `http`) because the RPC wire is raw
# line-oriented JSON, not HTTP. Copy into an nginx config that has
# `load_module modules/ngx_stream_module.so;` (usually already set on
# the debian/ubuntu nginx-full package) and reload.
#
# Combined with `CE_RPC_REQUIRE_TOKEN=1` on the daemon, this covers the
# "LAN deployment" story.
#
# ---- global (if this is your only nginx service, put in nginx.conf) --------

# stream {
#     include /etc/nginx/conf.d/crossengin-rpc.stream.conf;
# }

# ---- crossengin RPC service -----------------------------------------------

server {
    # Public-facing TLS endpoint.
    listen 9977 ssl;

    ssl_certificate     /etc/nginx/certs/crossengin.pem;
    ssl_certificate_key /etc/nginx/certs/crossengin.key;

    # Refuse below TLS 1.2. TLS 1.3 preferred.
    ssl_protocols         TLSv1.2 TLSv1.3;

    # Same shortlist stunnel.rpc.conf uses for audit parity.
    ssl_ciphers           "ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!MD5:!DSS";
    ssl_prefer_server_ciphers on;

    # 5-minute session cache is fine for a low-frequency wire.
    ssl_session_cache     shared:CrossEnginRPC:1m;
    ssl_session_timeout   5m;

    # Loopback target -- crossengin-rpc-daemon bound to :9876.
    proxy_pass 127.0.0.1:9876;

    # RPC connections are short-lived (one request per accept). Small
    # timeouts protect against a slow-loris style hold.
    proxy_connect_timeout 10s;
    proxy_timeout         60s;
}
